mage_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 366221, "client_id": 1569134, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/c94f9f8f/uploads/origins/08ae106a-a671-4ea0-bcb4-97ec60ab550d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=742b466fd50ba271f4594434fb07fc01", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/c94f9f8f/uploads/origins/08ae106a-a671-4ea0-bcb4-97ec60ab550d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=4e2d9a997b145647770cb9d1fefaa037", "src_set": ""}, "body": "Maks様\nお世話になっております。\n前回は素敵なポケモンの擬人化イラストを描いて下さりありがとうございました。\n\n今回はデカヌチャン(♀)の擬人化イラストを描いて頂きたいです。\n可能であれば、イメージはロリ巨乳キャラであざとい感じでお願いします。\n特に胸は大きめで、太ももやお尻もむちっと感があると嬉しいです。\n\n前回と同様にTwitterのアイコンとバーナーにしたいと考えてるので、お手数ですが擬人化イラストとバーナーイラストを別々にお願いします。\nバーナーイラストはデカヌチャンがメロンソーダを飲んでいるイラストでお願いします。\n\n長文失礼致しました。\n今回も依頼を受けて頂けたら大変嬉しいです。\n以上、ご検討よろしくお願いいたします。", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@makusu_210/works/59", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/1cfcb868/uploads/origins/d3ca72e1-36f8-4e25-b8d2-3164e0e11517?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=c2f06f279f993bcb03de6a6b80ac400a", "src_set": ""}, "private": true, "genre": "art", "tipped": true, "creator_id": 366221, "client_id": 0, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 16, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}], "similar_creators": [{"id": 271534, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "ぴろ", "screen_name": "EXP_66", "avatar_url": "https://pbs.twimg.com/profile_imag