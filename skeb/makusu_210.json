ceived_works": [{"path": "/@makusu_210/works/88", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 366221, "client_id": 181302, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/be641520/uploads/origins/dbcb613d-d222-488b-92e9-5460a158efef?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=48072caa132647f6b2090d8f9bd981e9", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/be641520/uploads/origins/dbcb613d-d222-488b-92e9-5460a158efef?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0ce5465cfc7bcb61645d3bff6fc56c67", "src_set": ""}, "body": "いつもほんっとにかわいいポケ擬達を公開してくださり、ありがとうございます。今年は昨年のようにひどい高温にはならない…と聞いたような気がしましたが、まだまだ暑い日が続きそうですね。\nそんな猛暑に清涼感のあるポケ擬ちゃんをリクエストします。キャラはズバリ、長いこと我が相棒としているグレイシアです。\nデザインはお任せしたいのですが、以下の設定だけは指定させてください。イラストに全て表示する必要はありません。\n・女の子です…\n・胸元は控えめ（壁）、気にしてます\n・お尻は魅力的\n暑がるマンダ先輩、ガブちゃん（は平気そう）、メガシンカに気を吐くカイリューも涼しくなれると思います。\n\n以上です。もしよろしければどうぞ、お願いいたします。", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@makusu_210/works/87", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/98c6584d/uploads/origins/c1c97fec-1a23-43d9-9acd-f5ea1060c9c9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=c0d519a4e39f6ad90228332610878cbd", "src_set": ""}, "private": true, "genre": "art", "tipped": true, "creator_id": 366221, "client_id": 0, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 128, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@makusu_210/works/86", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 366221, "client_id": 0, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/cabd6dc7/uploads/origins/d7c6ae82-df81-499b-9804-1f9745dfce20?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b2fd5691f3526f4665752a8c31cbf501", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/cabd6dc7/uploads/origins/d7c6ae82-df81-499b-9804-1f9745dfce20?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=48d7f466991f2c0b2e58694388d73f87", "src_set": ""}, "body": "サザン…次やったらこれ…\n\nグロスちゃんの「次やったらこれ」をリクエストします。内容は以下のとおりです。\n・片手、または両手を胸に添えて少し強調\n・相手はサザンを想定（画面外にいる状態\n・正面、斜め向きなど構図はお任せします\n・表情は恥ずかしがるのか割と無表情なのか、どちらもありそうなのでお任せします\n・何か嬉しいことをされて感謝したいだけ\n・行動の意味はきっと分かってません\n・バレパンのことではありません！\n\n昨日の泣かされるハバカミちゃんがかわいかったのと、その前のグロスちゃんがあまりにも美人で色気もすごかったので、衝動的にこのようなリクエストを送信させていただいております。グロスちゃんは自分の「武器」が何か分かっているように見えますので、喜んでもらおうとしてちょっとやらかしそうなので…", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@makusu_210/works/85", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 366221, "client_id": 0, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/7fae30b0/uploads/origins/2348f73e-8db9-476b-bcaa-e738747530ea?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7425057e98c6e9c6d0da8a21a893ca6e", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/7fae30b0/uploads/origins/2348f73e-8db9-476b-bcaa-e738747530ea?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=afecf2a68ca351a15af893d29361dc2b", "src_set": ""}, "body": "いつも素敵なイラストを楽しませていただいています！\n\n  自分の推しのクチート&メガクチートのイラストをお願いしたいです！  \n\nMaksさんの描く2体が見たいので、姿や構図などは全てお任せします！", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": 