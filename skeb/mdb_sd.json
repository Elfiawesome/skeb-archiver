t_client_visible": false, "total_appeals_count": 0, "received_works": [{"path": "/@mdb_sd/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3638002, "client_id": 3391705, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/2ba2ca9b/uploads/origins/d81321ed-3fe4-4900-83a5-1310fc6bf877?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2ea4f199580a42039c9a894e76490345", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/2ba2ca9b/uploads/origins/d81321ed-3fe4-4900-83a5-1310fc6bf877?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5a71a7becd99c2e1d12b2a498c844717", "src_set": ""}, "body": "こんにちは🩷。\n最近スケブのイラストを頂いて、本当に本当に大好きで\n壁紙に設定して、眺めて過ごしています🩷🎀 ちびちゃんも大好きなので、リクエストさせていただきました🩷 . .🩷 .\n\nキャラクターは吸血鬼の男の子で、アイドルでもあるコアラのぬいぐるみです。\n重要な要素は美容マークと目の下の赤みです。\n彼の血はピンク色で、太ももにはよく切り傷や包帯があります。\n衣装は写真のようなものでも、違うものでも構いません。♡\n\nありがとうございます、もし値段が安すぎたら、もっと高いものを送ってください。  \n\nhttps://drive.google.com/drive/folders/1YpT8_Yb5J291X7qWT3SDEjo3j7K_iW3S", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@mdb_sd/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3638002, "client_id": 0, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/ced03770/uploads/origins/388c325b-54eb-4375-95da-4236ed6fcd2d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8ebc81d2d434e779d097ad4829fb3584", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/ced03770/uploads/origins/388c325b-54eb-4375-95da-4236ed6fcd2d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=14e7cc7bc8f3702d4a4f75c757d2ad51", "src_set": ""}, "body": "初めまして。\nどりぃむぶる～様の最高にかわいいファンシーでドーリィな絵柄に一目惚れし、是非イラストを描き下ろしていただきたくリクエストを送らせていただきました。\n\nどりぃむぶる～様にこの度描いていただきたいのは、Vsingerとして活動されている『天狐てん』さんです。\nこちらのURLに3面図がございますので、もしお受けしてくださる際は資料としてご参照くださいませ。\nhttps://frontier.creatia.cc/fanclubs/2856/posts/51644 \n\n構図や表情などお任せ致しますが、もしも迷われた際は下記情報を参考にしていただければと思います。\n・メスガキではなくクソガキ\n・モチーフは妖狐だが、和風は避けている\n・✧マークをよくデザインに盛り込む\n・大きいインテークとハーフツインテールがお気に入りのチャームポイント\n・妖狐だが油揚げは苦手\n・フルーツなども苦手\n・地下アイドルっぽいアイテムが好き（シルバーアクセサリーやフリルなど）\n\n【想定される使用用途】\n描いていただいたイラストは、配信サムネイルや、クリエイティア（ファンコミュニティ）の投稿記事のサムネイルなどへの使用ができますと大変ありがたいです。（不可の場合は、こちらのリクエストを却下お願い致します。）\n\n是非ご検討いただけますと幸いです。どうぞよろしくお願い致します！", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@mdb_sd/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3638002, "client_id": 2588891, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/4d99e350/uploads/origins/6ba799fa-8ff0-40ac-8e46-484863dbffe0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8349353c6c03151187f83108dd57e9d1", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/4d99e350/uploads/origins/6ba799fa-8ff0-40ac-8e46-484863dbffe0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=cd90012090eb269b39c421d859e502de", "src_set": ""}, "body": "こんにちは、先生。\n私はvtuber Minneと申します。 \n宇宙を冒険する宇宙の羊です。 \n\n私の新しい衣装のイラストを描いていただけますか？ \n笑顔、黒目の真顔、ハートの瞳の3つのバリエーションがあるといいですね。\n検討お願いします。 \nありがとうございました！\n\nhttps://drive.google.com/drive/folders/1VgCoiLHCHHVOs3SXeqzWwrXE6c-1kHHN?usp=sharing", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@mdb_sd/works/2", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/a6a3da67/uploads/origins/72649ec2-ba73-410d-8393-cb1d22c99d22?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=c2c17e25c113276d9374cd17249be029", "src_set": ""}, "private": true, "genre": "art", "tipped": false, "creator_id": 3638002, "client_id": 0, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 129, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@mdb_sd/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3638002, "client_id": 0, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/b1101457/uploads/origins/949a7cde-e2d2-487e-9d80-d1b3b30dcf8f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0a1083b30db9a148841656244578828c", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/b1101457/uploads/origins/949a7cde-e2d2-487e-9d80-d1b3b30dcf8f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3dc7705e166b4666f0eef73927f254db", "src_set": ""}, "body": "初めまして。 Vライバーのフルパワーあざ美と申します。\nこの度はTLで絵柄を拝見し、是非ご依頼したくご連絡しました。\n\n⬛︎キャラ見た目\n・キャラ見た目&衣装参考資料(新衣装ラフ等含む)\nhttps://note.com/preview/n37e13fa1cd0e?prev_access_key=b5375f6080ca58628bad432a6b6111b5\n\nクリエイター様の横長でまつ毛の長い目が好きなので、是非そのような目でお願いしたいです！\n\n⬛︎イラストについての希望\n・できれば「夏服衣装」で描いていただきたいです。\n・資料にある銃も持っていると嬉しいです。\n・どこか昔のエロゲ―や深夜アニメのようなダークでかわいい、ややヤンデレっぽい空気感があると嬉しいです。\n\n・もし可能でしたらハイライトなし目やハート目(お任せします)の差分があるとすごく嬉しいです…。！\n\n⬛︎形式についての希望\n・背景や宛名を描いていただける場合は、PSDでレイヤーを分けた状態で納品していただくか、別途PNGで「前景/宛名のみ」「背景のみ」「人物のみ透過」をそれぞれいただきたい。\n・サイズはお任せいたしますが、1280×720のサムネイルに使用しても荒くならない画質を希望します。\n・サムネに使いやすいよう、「人物のみ透過」は頭の上や髪の先が全てキャンパス内に収まっている(見切れていない)状態を希望します。\n\n⬛︎利用用途\n→ 収益化済み配信サイトでの使用、Xでの使用、SNSアイコン、収益化予定の動画への使用、グッズ化(販売用のもの含む）、サブスクコミュニティへの投稿、ネットプリント、SHOWROOMでのアバター使用……などを想定しています。\n※NGなものがあれば作品内に記載お願いします。\n\n是非お願いしたいので、もし金額など不適切な点があれば再送依頼お願いいたします。\n\nもし宜しければご承認いただけましたら幸いです。\nご検討ください。よろしくお願いいたします。\n\nhttps://note.com/preview/n37e13fa1cd0e?prev_access_key=b5375f6080ca58628bad432a6b6111b5", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "similar_creators": [{"id": 760029, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "うえじ", "screen_name": "ueji_bun", "avatar_url": "https://pbs.twimg.com/profile_images/1926150147508948992/1AT_A5Sy.jpg", "header_url": "https://pbs.twimg.com/profile_banners/799050790862098432/1746047009/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 5, "skills": [{"genre": "art"}], "nc": 48}, {"id": 2017661, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "セリザワ4%(2)", "screen_name": "0u0_mgmgtime", "avatar_url": "https://pbs.twimg.com/profile_images/1647393638614437888/RPsZXMzy.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1521119675358228482/1703944659/1500x500", "appeal_receivable": true, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "skills": [{"genre": "art"}], "nc": 48}, {"id": 2406649, "creator": true, "nsfw_acceptable": false, "acceptable": false, "name": "小盛", "screen_name": "Kmr_okb", "avatar_url": "https://pbs.twimg.com/profile_images/1582265678597599232/YtelyI0H.jpg", "header_url": null, "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "skills": [{"genre": "art"}], "nc": 0}, {"id": 2841563, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "檜宮しょう2", "screen_name": "Hinomiya_sousak", "avatar_url": "https://pbs.twimg.com/profile_images/1949459536030453760/hIhtF9rL.jpg", "header_url": 