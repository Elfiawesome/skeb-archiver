0376d2addc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=3e9c38e998940162611255c6dce4b6c5 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/df6d1ccb/uploads/origins/d3fd1fc0-5ef2-4b91-80b2-bf0376d2addc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e692e854879210a23c74436e9bbfe525", "srcset": "https://si.imgix.net/df6d1ccb/uploads/origins/d3fd1fc0-5ef2-4b91-80b2-bf0376d2addc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e692e854879210a23c74436e9bbfe525, https://si.imgix.net/df6d1ccb/uploads/origins/d3fd1fc0-5ef2-4b91-80b2-bf0376d2addc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=08ebea483d2aedc0b3b5b36f82452aca 2x, https://si.imgix.net/df6d1ccb/uploads/origins/d3fd1fc0-5ef2-4b91-80b2-bf0376d2addc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=038730c901eb157e57b8d58b6688aac4 3x"}, "body": "こんにちは、みつなごです、\nにじさんじのヌイ・ソシエールが触手の怪物に犯され、奴隷にされているイラストを作ってください。\nヌイは裸で寝室にいる。突然、触手モンスターが彼女に飛びかかり、資料1のように彼女に巻きつく。ヌイは抵抗しようとするが、触手モンスターは2本の触手で彼女のアナルと膣穴に挿入する（挿入と触手の動きがわかるように、資料2のような前後同時ショットをお願いします）。ヌイは両方の穴に挿入されただけで発情し、オーガズムに達する。両方の触手が両方の穴の中にピンクの催眠精液を発射し（できればレントゲン写真をお願いします）、再びオーガズムを引き起こします。ヌイは心臓の瞳孔と子宮の紋章を獲得し、今や永久に発情し、触手モンスターに従順である。\nご清聴ありがとうございました！\n\nhttps://drive.google.com/drive/folders/1Pyr7cDymmElNK65cX-uDbU6KHDVnxEgV?usp=sharing", "nc": 57, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@uhyohyo_ecchida/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2899390, "client_id": 1537783, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/e66d0db1/uploads/origins/697a41d4-0ada-4174-8ec7-848bbbb7c972?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e265beadaaa9e0d118de0c0c2396052a", "srcse