t%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=6d4ec27a01034d5ce6c95f3fe5bbbe3f 2x, https://si.imgix.net/3f35261f/uploads/origins/a9f7783a-73bf-4056-a18a-b6b2c9e85494?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a9d8e50d9df90ac3ae5a51393beca18b 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/3f35261f/uploads/origins/a9f7783a-73bf-4056-a18a-b6b2c9e85494?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=81c5e097bfbe01ba5291075e34e77e93", "srcset": "https://si.imgix.net/3f35261f/uploads/origins/a9f7783a-73bf-4056-a18a-b6b2c9e85494?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=81c5e097bfbe01ba5291075e34e77e93, https://si.imgix.net/3f35261f/uploads/origins/a9f7783a-73bf-4056-a18a-b6b2c9e85494?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=da5978b3df1f81430b948696640f1640 2x, https://si.imgix.net/3f35261f/uploads/origins/a9f7783a-73bf-4056-a18a-b6b2c9e85494?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=4d4ce37c5dc2edc07fa3491c633ae1e5 3x"}, "body": "こんにちは。\nくるのさんの、幸せいっぱいのカップル絵が大好きです。特に先月描かれていたウェディング企画の主フロが印象的でした。\n是非ワーネバ(エルネア)の自キャラ夫婦をくるのさんに描いていただきたいと思い、リクエストさせていただきました。\n※『ワールド・ネバーランド』シリーズ二次創作ガイドライン\nhttp://nalulukingdom.gg-blog.com/Entry/7/\n\n■キャラクター情報\n\nジェローム・ヘイスタック(よく出来た性格)\n15歳(※ワーネバ年齢。以下同じ)。身長170cmの中肉中背。濃い褐色肌。ストレートの柔らかい黒髪をおかっぱにしています。青い瞳で若干タレ目。\n\n魔銃導師で龍騎士で元議長、という肩書きを持つ壮年。普段は朗らかで気遣いの出来る人物ですが、研究対象の事となると目の色が変わります。\n14歳の時に親友の娘であるカロリーナ(※当時4歳)からプロポーズされ、人生が一変。彼女の成人まで1年、悩んだ末に想いを受け入れ、交際に至りました。\n歳上の余裕を見せようと奮闘しているものの、彼女の真っ直ぐ愛情と、何より自身の恋心に振り回されてあっさり陥落している幸福な男です。\n\nカロリーナ・フォンタナ(のんびりさん)\n5歳。身長150cm。ゆるやかな曲線を描く女性らしい体型。胸は意外と大きめ。薄めの褐色肌。コシがあり緩やかに波うつ濃茶色の長い髪。ぱっちりとした大きな黒茶の瞳。\n\n国王の従妹に当たる娘。物心ついた頃から、父をはじめとした親族と交友のあったジェロームに恋していて、4歳の時に告白。成人と同時に交際を始めました。\n一見大人しそうですが、実際は愛情も独占欲もとても強い、恋人に一途な少女です。\n\n■服装\n\n可能であれば、ガルフィンの勇者装束(魔銃師勇者服)、国民の服を着せていただきたいです。カジュアルな服装(鎧や専門職服以外)であれば別の服装でも全く問題ありません。\n\n■イメージ\n\n恋人時代の二人のデートシーンを希望します。年齢を障害と感じさせない、甘く幸せな雰囲気だと嬉しいです。\n\n上記以外の構図、表情、ポーズ等はお任せします。\nご検討いただけましたら幸いです。\n\n■使用用途\n\n作者名明記の上で、web上での小説やコミッションでのキャラ紹介画像に使用させていただく予定です。\n\nhttps://www.evernote.com/shard/s578/sh/46d0ad6e-9e78-5d01-8d96-aa5ec44ca4b9/29b6186b21eff924a307df7203b2ce8d", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 201936, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "るりん｜みずきのりんご", "screen_name": "RuRingoM", "avatar_url": "https://pbs.twimg.com/profile_images/1591957874820915202/XbZQdVsA.jpg", "header_url": "https://pbs.twimg.com/profile_banners/781366494319947777/1743562026/1500x500", "appeal_receivable": true, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 120, "skills": [{"genre": "art"}, {"genre": "comic"}, {"genre": "correction"}], "banned": false, "nc": 145}, {"id": 639270, "creator": true, "nsfw_acceptable": false, "acceptable": false, "name": "こずみはと", "screen_name": "marumannma810", "avatar_url": "https://pbs.twimg.com/profile_images/1741761301234565120/_arD6AFl.png", "header_url": "https://pbs.twimg.com/profile_banners/89131456/1712410817/1500x500", "appeal_receivable": true, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 3, "complete_expiration_days": 30, "skills": [{"genre": "art"}, {"genre": "correction"}], "banned": false, "nc": 17}, {"id": 923331, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "叶井柚葉", "screen_name": "kanayuzu611", "avatar_url": "https://pbs.twimg.com/profile_images/2002006643366924289/BptPhGyP.jpg", "header_url": "https://pbs.twimg.com/profile_banners/134493387444751564