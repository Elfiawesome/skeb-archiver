-a1ec-f8a1ab6f7e5f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=2d8a8829a32c76409fbd1acacb533d58 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/64dd574a/uploads/origins/a7437382-77ec-4324-a1ec-f8a1ab6f7e5f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e961b98278b2d9a378f74c2c28d64e2a", "srcset": "https://si.imgix.net/64dd574a/uploads/origins/a7437382-77ec-4324-a1ec-f8a1ab6f7e5f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e961b98278b2d9a378f74c2c28d64e2a, https://si.imgix.net/64dd574a/uploads/origins/a7437382-77ec-4324-a1ec-f8a1ab6f7e5f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=3343e0646e9e4c769c173468df9af3a5 2x, https://si.imgix.net/64dd574a/uploads/origins/a7437382-77ec-4324-a1ec-f8a1ab6f7e5f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=ab27b5f6334ca232af08d620cbfe2334 3x"}, "body": "五臓ろっぽ様、いつもお世話になっております。\nとあるTRPGのモブ敵とそれを流用したのサンプルキャラの立ち絵をお願いいたします。\n\n\nシステム：Ventangle\n対象：グラップラー(カミマチP64)／デストラクション(基本P46)\n構図：膝から上が映る立ち絵姿（画像の下端は水平にカットで）\n概要：\n　退魔忍みたいなボディースーツの拳闘士。\n衣装はデストラクションのデザインでお願いします。\nモブ敵なのでバイザーやヘッドギアにより口元しか見えないのが似合うと思います。\n普通(にぃ…と口元が笑っている)／劣勢(歯を食いしばる)の２種の表情は欲しいです。\nエロールを考慮してフタナリが勃起中の差分と、大変でなければ中破もあると嬉しいです。\n（中破時に乳輪が見えてしまうとエッチだと思います）\n　デストラクションの表情に関しては普通と劣勢に加えて、唖然(口を開けて驚く)と蕩け(快楽で堕とされる)があると盛り上がりそうです。\n組合せ量が多くなりそうなので実装を希望する差分の優先順位は以下の通りです。\n①表情　②勃起　③スーツのカラバリ　④中破　⑤髪色や髪型\n　スーツの色ですが、濃紫、黒、深緑などが似合うと思います。\n髪色は黒髪、濃い赤色、暗い紺色などのイメージです。\n髪型はロングヘア、ポニーテール、ショートヘアあたりが別人感を出せそうでしょうか。\n全体的に硬派な色味を選んでますが、面白そうあるいはエロそうであれば絵師目線で似合いそうなカラーの追加は大歓迎です。\n\n【レイヤー構造とカラバリ提案】\n①前髪\n②バイザーやヘッドギア＆表情\n　┣┳仮面：普通\n　┃┗仮面：劣勢\n　┗┳素顔：普通\n　　┣素顔：劣勢\n　　┣素顔：唖然\n　　┗素顔：蕩け\n③胴体\n　┣紫色スーツ\n　┃┣勃起\n　┃┣中破　※破けて肌が露出の意\n　┃┗ベース\n　┣●色スーツ\n　┃┣中破\n（以下略）\n④後ろ髪\n⑤（背景レイヤー）\n\n\n細かく書き出しましたが、グラップラー数種とデストラクションの姿が拝めれば十分ですので、優先順位の低い差分は余裕があれば盛り込むという判断で構いません。\n\n以上、よろしくお願いいたします。", "nc": 161, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@sukebe5050/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2775129, "client_id": 25017, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/a721bc09/uploads/origins/fcbd73c8-4ea8-44d8-b0dd-c7ec30c22974?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ff8b30897c53abf513f5676a9f4633aa", "srcset": "https://si.imgix.net/a721bc09/uploads/origins/fcbd73c8-4ea8-44d8-b0dd-c7ec30c22974?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ff8b30897c53abf513f5676a9f4633aa, https://si.imgix.net/a721bc09/uploads/origins/fcbd73c8-4ea8-44d8-b0dd-c7ec30c22974?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=3062f680d90419c27aa7ac5588d498c1 2x, https://si.imgix.net/a721bc09/uploads/origins/fcbd73c8-4ea8-44d8-b0dd-c7ec30c22974?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=3b0ceac9bf03bd1bbf39965915e4f6eb 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/a721bc09/uploads/origins/fcbd73c8-4ea8-44d8-b0dd-c7ec30c22974?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=8c0711dcd852860a6f1a77e7712ac948", "srcset": "https://si.imgix.net/a721bc09/uploads/origins/fcbd73c8-4ea8-44d8-b0dd-c7ec30c22974?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=8c0711dcd852860a6f1a77e7712ac948, https://si.imgix.net/a721bc09/uploads/origins/fcbd73c8-4ea8-44d8-b0dd-c7ec30c22974?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=565796b5da3f5e2783b46f4377544d30 2x, https://si.imgix.net/a721bc09/uploads/origins/fcbd73c8-4ea8-44d8-b0dd-c7ec30c22974?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=71943a18d