洋折衷のスタイルを希望。\n（多少華やかでも問題ございません）\n可能であれば髪型、等お任せでお願いしたく思います。\n\n【希望の納品方法】\nキャラ単体のイラスト、またはキャラと背景がレイヤー分けされたPSDファイル形式\n\n【使用用途】\nSNSでの投稿、個人の所蔵用、友人への共有\n\n描きたくなければお断りしても構いません。\nもし金額が足りないようでしたら、お手数ですが指定の後再送要請を送っていただけると嬉しいです。\n\n長文となってしまい申し訳ございません！ご検討の程、よろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/1hP8KUoSmghAAqnEwPvF5c9vYAVI3sK6S?usp=sharing", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@Wa2_2watori/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3975874, "client_id": 2320476, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/2ea6f3be/uploads/origins/a0ed3c1d-2170-4702-bde7-c23ae5080afb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8baf2e2fdfb434ea9f7c29a1d429b82e", "srcset": "https://si.imgix.net/2ea6f3be/uploads/origins/a0ed3c1d-2170-4702-bde7-c23ae5080afb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8baf2e2fdfb434ea9f7c29a1d429b82e, https://si.imgix.net/2ea6f3be/uploads/origins/a0ed3c1d-2170-4702-bde7-c23ae5080afb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=1f0d039cbb33fde97f6a2ab743ad8098 2x, https://si.imgix.net/2ea6f3be/uploads/origins/a0ed3c1d-2170-4702-bde7-c23ae5080afb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=8640e4152cef75e990d55b63b0663534 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/2ea6f3be/uploads/origins/a0ed3c1d-2170-4702-bde7-c23ae5080afb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=90eb141d297f1c9487e86e5767fffdf8", "srcset": "https://si.imgix.net/2ea6f3be/uploads/origins/a0ed3c1d-2170-4702-bde7-c23ae5080afb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=90eb141d297f1c9487e86e5767fffdf8, https://si.imgix.net/2ea6f3be/uploads/origin