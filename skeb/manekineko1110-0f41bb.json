op&w=200&h=200&blur=200&s=f2fcd93239cf02d970733f33b1795e71 2x, https://si.imgix.net/26fde695/uploads/origins/b02880d6-e555-4d6b-b867-1a62988e7243?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=84693cb74de3e94e054a812cc75cd989 3x"}, "body": "こんにちは、いつもマネキさんの作品を楽しませて頂いてます\n投稿されていらっしゃるシリーズのすてあちゃんがとてもツボなので\n人生で初めての依頼をお願いさせていただきます。\n\nシチュエーション:すてあちゃんのアカウントにDMが届き、自分の痴態を晒した画像に射精している動画が送られて来る。\n興味本位でつい再生してしまい、今までの自分の行為が性欲の対象として見られた事を実際に目の当たりにして興奮してしまい\n自分自身も同じ行為をする事に。\n\n動画を表示しているタブレットに跨って、「今から私も同じことしますね？」的な言葉を発しながら自慰に励むすてあちゃん。\n動画の光景と共に気持ちが昂りついに絶頂し、愛液まみれになるタブレット。\n\n息を切らしながら定点撮影していたスマホを手に取り上記のタブレットの惨状も証拠に撮影「また私でしてくださいね？」的なメッセージを発しながら録画終了。\n\nその後抜き報告を送ってきた相手にその動画を送り返して、暫くお互いのオナニー報告がこっそりと続いている…\n\nこんな感じの作品を描いていただけるととても嬉しいです\n\nこれから寒い時期になりますので体調を崩されないように創作に励まれてください、いつも応援してます。", "nc": 33, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@manekineko1110/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 259033, "client_id": 59978, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/2fae1c3b/uploads/origins/4763c458-0562-43e8-ba9c-84909546d305?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=39c199ef058fc534d58e249f9d772008", "srcset": "https://si.imgix.net/2fae1c3b/uploads/origins/4763c458-0562-43e8-ba9c-84909546d305?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=39c199ef058fc534d58e249f9d772008, https://si.imgix.net/2fae1c3b/uploads/origins/4763c458-0562-43e8-ba9c-84909546d305?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=2c00dabb3b4c0441919f5d21c9af132a 2x, https://si.imgix.net/2fae1c3b/uploads/origins/4763c458-0562-43e8-ba9c-84909546d305?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=88e6dd0bcf9de063bf6d5ca76197a33f 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls