fa24f/uploads/origins/7fbea631-339a-4ff2-bc93-dd184b937454?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e278a443a14256bfad24a095af467dcf 3x"}, "duration": null, "nsfw": true, "hardcore": true, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/6aefa24f/uploads/origins/7fbea631-339a-4ff2-bc93-dd184b937454?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=18204a7b68b685db0463991f45d9ab5d", "srcset": "https://si.imgix.net/6aefa24f/uploads/origins/7fbea631-339a-4ff2-bc93-dd184b937454?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=18204a7b68b685db0463991f45d9ab5d, https://si.imgix.net/6aefa24f/uploads/origins/7fbea631-339a-4ff2-bc93-dd184b937454?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=5bf6a1b374bdd568023d86726f4272c5 2x, https://si.imgix.net/6aefa24f/uploads/origins/7fbea631-339a-4ff2-bc93-dd184b937454?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=717fe2057ccf2ac40f1f916fd34107ca 3x"}, "body": "連投失礼します。\nもんぺ姿の女性をリクエストさせていただいているものですが\nお世話になっております。\nまた、緊縛イラストをお願いしたいです。\n\nオリジナルキャラで、昔の農家の20代後半位、\n純朴そうな黒髪女性の緊縛イラストをリクエストしたいです。\n顔だち、髪型、体型等はお任せします。\n\n恰好\n野良着に、もんぺ、足袋履き、胸を出し、左右の腕と足がそれぞれに緊縛され\n表情は縛られて、泣いている感じにしてほしいです。\n頭から、爪先まで全身を描いてほしいです。\n\n服装\n野良着の色は紺色、模様は適当に、\nもんぺは、へその下辺りで紐を結ぶ袴式で長さは足首まで、色、模様は濃い紫系の縞、\n足袋は足首までで色は赤、足袋底は白にしてほしいです。\nもんぺイメージ\nhttps://www.dropbox.com/s/fpus5tbo1fn7t3l/simam.png?dl=0\n\nまた、\n股間部分を、破られ、陰部に極太の張型を挿入されて\n表情も痛さから苦しそうに涙を流して絶叫している状態もお願いします。\n\nつたない説明で恐縮ですが、説明不足な点、ポーズ、構図など\n自由に変更、アレンジしていただいて構いませんが、\n必ず、もんぺが破れていない状態と、破れた状態を描いていただきたいです。\n\n連投となり大変恐縮ですがご検討の程宜しくお願い致します。\n\nhttps://www.dropbox.com/s/6llkuwpc8nw8ae6/n01.png?dl=0", "nc": 171, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@yumemi_teer2/works/7", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/bf283375/uploads/origins/5a2354e1-2fea-4eeb-9cba-a