200&h=200&s=0e074f28f1511ffcbf4edc57bdeed77d, https://si.imgix.net/0b1dcf8d/uploads/origins/04e6cce4-d250-41e5-9c9b-5ffa47823e52?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c616817587d83834bc86ef648eb8105a 2x, https://si.imgix.net/0b1dcf8d/uploads/origins/04e6cce4-d250-41e5-9c9b-5ffa47823e52?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=aa0079db13a7acf323be433b248ab432 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/0b1dcf8d/uploads/origins/04e6cce4-d250-41e5-9c9b-5ffa47823e52?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0442ef251cd1da08aca62c8cb5080353", "srcset": "https://si.imgix.net/0b1dcf8d/uploads/origins/04e6cce4-d250-41e5-9c9b-5ffa47823e52?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0442ef251cd1da08aca62c8cb5080353, https://si.imgix.net/0b1dcf8d/uploads/origins/04e6cce4-d250-41e5-9c9b-5ffa47823e52?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=128ff4a9c3fbf126e0d9099a7f7295a9 2x, https://si.imgix.net/0b1dcf8d/uploads/origins/04e6cce4-d250-41e5-9c9b-5ffa47823e52?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=bb6e51649e6179cbf38a040e96d91647 3x"}, "body": "はじめまして！\n募集ポストの一枚目があまりにもかわいくてリクエストを送らせていただきました！\n\nもしよろしければ、TRPGの探索者2人を描いていただければ幸いです…！\n以下にキャラ概要記載させていただきますので、ご検討よろしくお願い致します…！\n\n＝＝＝＝＝\n\n【キャラ概要】\n■シナリオ名「傘月堂夜話」の二人組（女子高生）\n\n■千代田 知陽菜（三つ編み）\n好奇心が強く、楽しそうなことには積極的にノる。\n周りをを巻き込んでは楽しそうにしていることが多い。\nお菓子やかわいいものが好きだがどこか感性がずれているとよく言われる。\n動きやすい服が好き。\n\n■間中 風弥（ぱっつんロング）\n語尾に「ですわ」がつくパッションお嬢様口調（ガチお嬢様ではない）\n可愛いものが大好きで、将来は服飾デザイナー志望。自分で服も作る。\nロリータ風味の和洋折衷（和風寄り）な服が特に好き。\n\n■二人の関係\n当たり前のように一緒にいる幼馴染\n二人で周りを巻き込んでどんちゃん騒ぎを繰り広げる自由人コンビ\n行きついた先に何もなくても「何もないじゃん！次どこ行く？」と笑いあえる関係\n\n■服\nぐじゃ太さんの服のセンスがとても好きなのでおまかせいたします。\n指定した方が良い場合は制服でおねがいいたします。\n\n■キャライメージ\n和菓子や骨董品のイメージです\n\n（構図等は描きやすいイメージのもので構いません！）\n＝＝＝＝＝\n\n以上になります！資料URLに、キャラクター参考入れております。\n\n使用用途としてSNSのアイコンや、個人観賞用として使用します。\n可能であれば継続の立ち絵として使用したいのでキャラの透過画像をいただけるととても嬉しいです。\n\nhttps://drive.google.com/drive/folders/1QMs7sgLCdiA8fVQcgRQ1RojHsiknlSvN?usp=sharing", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@niku_cm/works/84", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3082474, "client_id": 523487, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/0a047194/uploads/origins/7ad278ce-f970-4e8e-b2eb-1f39427dc8f5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f223951d714f1e107f0b8fcc6ac056b0", "srcset": "https://si.imgix.net/0a047194/uploads/origins/7ad278ce-f970-4e8e-b2eb-1f39427dc8f5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f223951d714f1e107f0b8fcc6ac056b0, https://si.imgix.net/0a047194/uploads/origins/7ad278ce-f970-4e8e-b2eb-1f39427dc8f5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=478c639953fc76749ce251efd9e195e6 2x, https://si.imgix.net/0a047194/uploads/origins/7ad278ce-f970-4e8e-b2eb-1f39427dc8f5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=3097f34981600de96afe38a33e268fb3 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/0a047194/uploads/origins/7ad278ce-f970-4e8e-b2eb-1f39427dc8f5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e1d3c91aa5e96a83261ceadae0119753", "srcset": "https://si.imgix.net/0a047194/uploads/origins/7ad278ce-f970-4e8e-b2eb-1f39427dc8f5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e1d3c91aa5e96a83261ceadae0119753, https://si.imgix.net/0a047194/uploads/origins/7ad278ce-f970-4e8e-b2eb-1f39427dc8f5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=60bdbedd89fb442456beb8669829e737 2x, https://si.imgix.net/0a047194/uploads/origins/7ad278ce-f970-4e8e-b2eb-1f39427dc8f5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=d431de670d50425bdbd3f334d4484a7b 3x"}, "body": "鶏肉(子)様初めまして\n以前から鶏肉(子)さんのSkeb依頼絵を拝見し、ずっと惹かれておりました。\nこの度簡易にてリクエスト送らせていただきます。\n\n依頼したいのはTRPGのシナリオ「爛爛」の探索者2人です。\n以下、キャラの詳細を記載させていだたきます\n\n【キャラクター概要】\n①アルフェン（白い子）\n見た目年齢は16歳程度\n天真爛漫で純粋無垢。中身は見た目よりもかなり幼い少女。\n誰にでも愛想よく、距離感も近い。周りに希望と笑顔を振りまく。\nもともとは記憶を失っていたが、その無垢さゆえにスポンジのようにさまざまなことを吸収していく。\n爛爛と輝く赤い瞳がトレードマーク。\n\n②トリシャ・エーレンフロイント（黒い子）\nドイツのドレスデンで古美術鑑定業を営んでいる20代の女性\nあまり他人に深入りしないようにしてきたため友人と呼べる間柄は少ない。そのため基本的にはいつもため口である。仕事の時は敬語でしゃべる。\nクールながらも愛情深く、自身を好いてくれるものを拒絶することもない。\n片目に青の特殊な義眼を持つ。\n\n舞台は現代ドイツ\n少しファンタジーな要素もあります。\n共通イメージは青の球体、懐中時計です。\n\n【イラストについて】\n構図や表情等はおまかせします。NG等は全くございません。\n2人の距離感としては白い子が黒い子にべったりくっつくこともあり、それを邪見にすることもない感じです。\n衣装は資料のもの（デフォルト衣装）か舞台を観覧しに行くような少しフォーマルな衣装（黒い子は優雅でシンプルなイメージ、白い子は丈が短めのワンピースなど…おまかせします）のどちらかですととても嬉しいです。基本的に資料通りでなくとも、描きやすいように変えていただいて構いません。\n\n一番最初に惚れこんだイラストが白髪に水色のケープ、白髪に黒い服のオッドアイの二人組の絵（簡易Skeb履歴から）だったので、雰囲気はそちらの絵に近いと嬉しいです。\n使用用途は個人的な観賞用です。画像サイズによってはPCやタブレットの壁紙、Twitterのアイコンに使用させて頂きたいです。\n\nご検討いただければ幸いです。\n金額に不足等あれば再送ください。\n\nhttps://drive.google.com/drive/folders/1X354Mb3eZm3_QaORMmiox94LkhiFLG27?usp=sharing", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@tukimeguri/works/61", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2549654, "client_id": 523487, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/f9db92a4/uploads/origins/f6a1f8fb-eeb4-4232-8203-7ceb0a3fe951?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fd011097c154a38bdda0281bdcdfe25d", "srcset": "https://si.imgix.net/f9db92a4/uploads/origins/f6a1f8fb-eeb4-4232-8203-7ceb0a3fe951?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fd011097c154a38bdda0281bdcdfe25d, https://si.imgix.net/f9