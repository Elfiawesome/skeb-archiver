687ecdc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=eca54c9c011fcbfa10fadfb7696b6e4c 3x"}, "body": "こんにちは。\n\nもしよろしければ、私のVTuberのイラストを描いていただけないでしょうか。\n\n彼女の特徴は、目の下に赤い線があることと、異色眼です。可能であれば、これらのディテールをぜひ盛り込んでいただけると嬉しいです。\n\n彼女はいたずら好きですが、時々不器用なところもあります。また、屋外で様々な動物たちとよく仕事をしているため、おやつや道具、その他持ち歩く必要があるものを収納するためのポケットがたくさんあります。参考画像には、彼女が普段一緒に仕事をしている動物たち（彼女の小さなマスコットたち）をいくつか載せておきました。\nただし、室内で読書やゲームをしている時は、メガネをかける傾向があります。\n\nこれは私のVTuberですので、このイラストをSNS（X、Discordなど）で使用したり、サムネイル（YouTube、Twitchなど）として使用したりする可能性があります。\n\nご依頼をご検討いただき、ありがとうございます。\n\nhttps://drive.google.com/file/d/1DH5jrmGv5RAFsO9BTjVholsWMXnwu4aU/view?usp=sharing", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 100082, "creator": true, "nsfw_acceptable": false, "acceptable": false, "name": "s", "screen_name": "ebi_04", "avatar_url": "https://pbs.twimg.com/profile_images/1680922411984896001/o1NyN4mU.jpg", "header_url": "https://pbs.twimg.com/profile_banners/964581560568635392/1646628518/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "art"}], "banned": false, "nc": 32}, {"id": 1902160, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "ホニー&ナッツ", "screen_name": "hony_nuts", "avatar_url": "https://pbs.twimg.com/profile_images/2112872766303326208/9nZdmkX2.jpg", "header_url": "https://pbs.twimg.com/profile_banners/789539057504096256/1764169914/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "art"}, {"genre": "video"}], "banned": false, "nc": 33}, {"id": 2742776