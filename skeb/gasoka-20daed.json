c-4567-ba21-139752275858?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=fdde92d49d7f61417aea56e06b6129fe, https://si.imgix.net/8e45cee1/uploads/origins/3079c319-86cc-4567-ba21-139752275858?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=0ad36ee950a260c29496f812924570ad 2x, https://si.imgix.net/8e45cee1/uploads/origins/3079c319-86cc-4567-ba21-139752275858?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=52fe708ecdfa1b28852e7209c01bfcd5 3x"}, "body": "男の子同士のカップル\n\n一人は身長178cm\n職業はアーティスト\n個人主義者で神経質\n好きな場所は山の高原\n\nもう一人は身長165cm\n職業は車掌\n内向的でマイペース\n好きな場所は海の中\n\n二人は長く一緒に住んでいる。\n夜の公園を二人はよく散歩する。\nそこは街から離れた、山の麓にある大きな公園で、\n川や池、森につながる道や、広い芝生のエリアなど、起伏に富んでおり、\n時々、鹿やハクビシン、猫、蛇に出会ったりもする。\n小一時間ほど、あてもなくただ並んで歩き、家へと帰る二人。\n\nそんな二人の夜の散歩の絵をお願いします。", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@gasoka/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2033441, "client_id": 1470847, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/98bf0fb3/uploads/origins/236e726f-a3f0-4257-831b-fcd814799d41?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b526482da279d98dd482c571de6ba8c9", "srcset": "https://si.imgix.net/98bf0fb3/uploads/origins/236e726f-a3f0-4257-831b-fcd814799d41?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b526482da279d98dd482c571de6ba8c9, https://si.imgix.net/98bf0fb3/uploads/origins/236e726f-a3f0-4257-831b-fcd814799d41?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=3197a8ac012ee4ccc526dce840fb38c1 2x, https://si.imgix.net/98bf0fb3/uploads/origins/236e726f-a3f0-4257-831b-fcd814799d41?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=456619f27552be420ec4c09251676c0e 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/98bf0fb3/uploads/origins/236e726f-a3f0-4257-831b-fcd814799d41?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=03a600360fe2ee524890286c19ec81ed", "srcset": "https://si.imgix.net/98bf0fb3/uploads/origins/236e726f-a3f0-4257-831b-fcd814799d41?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=03a600360fe2ee524890286c19ec81ed, https://si.imgix.net/98bf0fb3/uploads/origins/236e726f-a3f0-4257-831b-fcd814799d41?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=de4b69ebb12fa3382332ac253212ab25 2x, https://si.imgix.net/98bf0fb3/uploads/origins/236e726f-a3f0-4257-831b-fcd814799d41?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=9f2d298016a6dced0086440b6eed4a2b 3x"}, "body": "こんにちは、あなたの絵はとてもきれいです。もしよろしければ、私の2人のキャラクターの絵が欲しいです。\nグンネ（https://drive.google.com/drive/folders/1ozNVvOKECzLOSjVXRDpaC8ZUSFe4PZ8_?usp=sharing）は186cmです。気弱で陰気な性格。金髪だが、たまに緑に染めている。首には傷跡があり、それを見せることもできます。素手の腕が見える場合は、包帯を巻いている。\nヴェン(https://drive.google.com/drive/folders/1OplbWAemi556P7ROiFPYHpP87oHiEGor?usp=sharing)は196cm。普段は真面目で眠そうな表情をしている。\n二人とも男の子で、付き合っています。シナリオはロマンチックで（手をつなぐとか）、風景は暗めにしてほしいです。\n本当にありがとうございました。", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@gasoka/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2033441, "client_id": 2133721, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/629a9b59/uploads/origins/76fc7252-b3fc-47cd-922d-60bf7e2d1bf8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5a55e9a8d11964400c0f5a05408b48b8", "srcset": "https://si.imgix.net/629a9b59/uploads/origins/76fc7252-b3fc-47cd-922d-60bf7e2d1bf8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5a55e9a8d11964400c0f5a05408b48b8, https://si.img