たいです。紫色の髪の子は飄々とした態度をとりがちで、茶色の髪の子をからかうのが大好きです。茶髪のほうは生意気で、ハイテンションに振る舞う。一緒にいるとバカップルです。紫の子は茶髪の子の望むことに何でも従います。2人は互いに愛し合っているので、他の世界に気がつかないことが多い。\n\nどんなポーズや表情でもOKです！\n\nもし、これだけでは物足りない場合は、再送をお願いします！\n\nhttps://sta.sh/2ncdhikpemq", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@gasoka/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2033441, "client_id": 2650020, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/3e365f94/uploads/origins/f1587ad5-ec42-4ee9-b10f-123879b410a7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c7b4c4c5115c9fb8fb78e9a2debe174b", "srcset": "https://si.imgix.net/3e365f94/uploads/origins/f1587ad5-ec42-4ee9-b10f-123879b410a7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c7b4c4c5115c9fb8fb78e9a2debe174b, https://si.imgix.net/3e365f94/uploads/origins/f1587ad5-ec42-4ee9-b10f-123879b410a7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=807141ab3d54ebdedeaf3cffba677d27 2x, https://si.imgix.net/3e365f94/uploads/origins/f1587ad5-ec42-4ee9-b10f-123879b410a7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=fa342f633c29a0f79dd9235c5f4fc339 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/3e365f94/uploads/origins/f1587ad5-ec42-4ee9-b10f-123879b410a7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e12f50273fdaa4f055924a40885bd5ab", "srcset": "https://si.imgix.net/3e365f94/uploads/origins/f1587ad5-ec42-4ee9-b10f-123879b410a7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e12f50273fdaa4f055924a40885bd5ab, https://si.imgix.net/3e365f94/uploads/origins/f1587ad5-ec42-4ee9-b10f-123879b410a7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=a8c580