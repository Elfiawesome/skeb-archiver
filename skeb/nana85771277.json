0&s=5f10f12c5593880e78d9d187d4d86267", "srcset": "https://si.imgix.net/b3682777/uploads/origins/154cab0f-59a8-4415-90f4-062376f7793e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5f10f12c5593880e78d9d187d4d86267, https://si.imgix.net/b3682777/uploads/origins/154cab0f-59a8-4415-90f4-062376f7793e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=faec967dd759ae3bf598f3ca3fa158ad 2x, https://si.imgix.net/b3682777/uploads/origins/154cab0f-59a8-4415-90f4-062376f7793e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=a804201cccb0f00d4854058a78d05fa6 3x"}, "body": "初めまして\nVtuberをしている空色るりと申します。\n\nTwitterでnana様の描かれたイラストを拝見させて頂きました。\nとても素晴らしいイラストでしたので是非自分を描いて頂きたく、この度リクエストを送らせて頂きました。\n\n【内容詳細】\n・資料のキャラクターの横にある青い行燈も可能でしたら描いて頂いたいです。\n・ポーズや構図、表情等はお任せします\n・配信のサムネイルで使うので頭やリボン、横の髪の毛など先が切れないように描いて頂けると助かります\n\n・Vtuber活動(サムネイル,収益化した配信,その他SNS等)で使用させて頂きたいので、お許し頂けると幸いです。\n・背景ありと背景透過されたもの２枚PNGデータでいただけると幸いです。（行燈も描いて頂ける場合は人物と行燈は別レイヤーで描いて頂けると幸いです。）\n　\n何卒よろしくお願い致します。\n\n●キャラクター資料\n　https://twitter.com/aoandon_ruri/status/1475848833775312898\n　https://twitter.com/aoandon_ruri/status/1469985383480012801\n\nhttps://twitter.com/aoandon_ruri", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 1581715, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "neru （3作公開中）", "screen_name": "VMEIN_46", "avatar_url": "https://pbs.twimg.com/profile_images/1738356555341565952/uEuHzOaC.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1161446781852344321/1703495481/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 120, "skills": [{"genre": "art"}, {"genre": "comic"}, {"genre": "correction"}], "nc": 145}, {