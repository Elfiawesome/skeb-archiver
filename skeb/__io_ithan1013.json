dc9ba", "src_set": ""}, "private": true, "genre": "art", "tipped": false, "creator_id": 275851, "client_id": 1783914, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 145, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@__io_ithan1013/works/239", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 275851, "client_id": 1791164, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/40486883/uploads/origins/f469dcb2-5a7d-4e6c-8695-237192fb3b73?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4a3b8fd5d9fd174b3ced286a14f66f4c", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/40486883/uploads/origins/f469dcb2-5a7d-4e6c-8695-237192fb3b73?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d11eea93bd153c98e442fb0e90c6369e", "src_set": ""}, "body": "こんにちは、イオ先生！あなたのアートスタイルが本当に大好きです！色使いもポージングも構図も素晴らしくて、もう長いこと先生の作品の大ファンです！\n\n私のキャラクター、シグムントをお願いしたいです。彼は高貴なエルフで、とてもプライドが高く、見栄っ張りで、カリスマ性があり、知的です。自分の病院を持ち、クリスタル（ダイヤモンド）を治療に使う魔術師です。闇犯罪にも手を染めている。\n\n彼には特定の渦巻きのマークがあり、それは下にあるドライブ・フォルダにあります。  体の模様は簡略化して構いませんが、顔の模様は残しておいてください。\n彼はまた、長いまつげのある、より女性的なかわいい顔をしています。\n最初の画像の服装と髪型も使ってください。\n\nポーズは自由にしてください！威厳のあるもの、上品なもの、遊び心のあるもの、威嚇するようなもの、背景のテーマとしてダイヤモンドがあるものが好ましいです。\n\nhttps://drive.google.com/drive/folders/1TAt9BM0tQ_FpQMY3XiFFXz0IjzP4LE_7?usp=sharing", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@__io_ithan1013/works/238", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/4bc1fb1a/uploads/origins/02580630-1feb-4c6b-b7c4-3b417ba8c4ee?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&tx