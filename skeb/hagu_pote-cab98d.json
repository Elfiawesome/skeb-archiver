200&h=200&blur=200&s=3654dd07d922947f3ce3725085366193 3x"}, "body": "はじめまして。匿名で失礼致します。\n少し前に描かれていたプリコネのサレンのふたなりイラストが良かったので、ふたなりサレンがゴム射してコンドームがパンパンに膨らんでいるイラストを希望です。\n竿と玉も同じくらいの大きさで、巨乳で竿を挟み込んでいる感じだと良いです。\n構図は（https://www.pixiv.net/artworks/55394278）や（https://www.pixiv.net/artworks/97166046）みたいな感じでお願いしたいです。\nよろしくお願い致します。", "nc": 176, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@hagu_pote/works/14", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/a3df5fac/uploads/origins/f1b0b3c5-c58f-4030-b71b-33e259f7baee?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=3bb265a42054deac85a2d9d9fb4305cd", "srcset": "https://si.imgix.net/a3df5fac/uploads/origins/f1b0b3c5-c58f-4030-b71b-33e259f7baee?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=3bb265a42054deac85a2d9d9fb4305cd, https://si.imgix.net/a3df5fac/uploads/origins/f1b0b3c5-c58f-4030-b71b-33e259f7baee?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=5b1c9b22afc61a8ef0423f0306ad671f 2x, https://si.imgix.net/a3df5fac/uploads/origins/f1b0b3c5-c58f-4030-b71b-33e259f7baee?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=dcc4cafe06dc87d650779f7a0defdaaf 3x"}, "private": true, "genre": "art", "tipped": true, "creator_id": 1097702, "client_id": 831342, "nc": 48}, {"path": "/@hagu_pote/works/13", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/884bca7e/uploads/origins/72460c07-2b66-479b-93c0-aee156d72d4a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=b