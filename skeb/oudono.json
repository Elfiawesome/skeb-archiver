.net/d327fa59/uploads/origins/4ecaea4b-5790-4281-b6f1-b0c48bf83049?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f9b5ab75a56b1ad36fd2ca117f8a07b3", "src_set": ""}, "body": "うどん様\n\nアピールありがとうございます。\n姿だけでなく声まで褒めていただき、うれしく存じます。\n\nうどん様の作品も拝見しましたが、けもの姿のキャラがとても愛らしく描かれていて、うどん様の好きがとても感じられました。\nよろしければ、私もケモノ化（猫化？）した姿で一枚仕上げていただければと思います。\n\n※使用用途※\n・snsでの宣伝活動やサムネイル、配信画面への設置\n\nそれでは、よろしくお願いいたします。", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@oudono/works/12", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2470075, "client_id": 2715594, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/0c7caa19/uploads/origins/51ecce29-2213-4085-9cd8-78b7f2632a5c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fb28406edb67c98cba14535a68973ecd", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/0c7caa19/uploads/origins/51ecce29-2213-4085-9cd8-78b7f2632a5c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=02419b7968f148e8dabf5c4c26c5f443", "src_set": ""}, "body": "はじめまして。\nアピールありがとうございます。\nVtuberとして活動している「雪乃うみ」です。\nモチーフはクリオネです。\n構図などお任せしますが、おはV等で使えるよう透過イラストをいただけると嬉しいです。\nよろしくお願いします。\n\nhttps://x.com/yukino_umi_21/status/1705900010196660535?s=20", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@oudono/works/11", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2470075, "client_id": 3260667, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/24dead37/uploads/origins/3aa1106a-882c-4b19-b2ab-b385888e11a1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6e1c29f5cf309b1d35dfbd1c0e5aa787", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/24dead37/uploads/origins/3aa1106a-882c-4b19-b2ab-b385888e11a1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6154a75baca4b037825719483c9dcdfd", "src_set": ""}, "body": "こんにちは うどん先生いつも素晴らしい作品を拝見させていただいております 。\n今回はうちの子葵ちゃんのケモ化をご依頼したく思います。\n ただ葵ちゃんの参考資料がとても少なく申し訳ございません 。\n【依頼内容】\n構図、シチュエーションはうどん先生にお任せします 。\nヘッダーやアイコンのノエルちゃんくらいのケモ度で描いていただけると嬉しいです\nうどん先生の描きやすい感じで大丈夫です\n服装は 夏を感じる服装だと嬉しいです。\n\n【使用用途】\n個人使用、Misskeyでの投稿に使わせていただきます。\nご検討お願いします", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@oudono/works/10", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2470075, "client_id": 3236237, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/3ffcb8f1/uploads/origins/afde9671-435a-449f-96d2-6f9648eb8990?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6be69968f4491e875de79c4a16a05b09", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/3ffcb8f1/uploads/origins/afde9671-435a-449f-96d2-6f9648eb8990?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2c60aa03bdb347b326387fd1f8f98ada", "src_set": ""}, "body": "こんにちは、うどん先生です。My OC https://drive.google.com/file/d/1AOp9t5THNs5A_FHG4rOc7jOjQFpqfuzA/view?usp=drivesdk で自作のウサギの設定イラストを依頼したいと思います。うどん先生 画風はうどん先生を参考にさせていただきました。", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@oudono/works/9", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2470075, "client_id": 2123729, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/481afe58/uploads/origins/b31a3d56-b149-4514-9b5b-58a53fee307a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bb20e10ec2b82f7e598463d46d6634dc", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/481afe58/uploads/origins/b31a3d56-b149-4514-9b5b-58a53fee307a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=fa8035168f73d7dcb0ad804313ced385", "src_set": ""}, "body": "こんにちは！いつも素晴らしいイラスト拝見させていただいています。\nステアーおじさんのイラストを描いていただけますか？\n内容はイラストレーター様にお任せいたします。\n\nミスキー内のイラストを参考にしていただければ幸いです。\nお忙しい中とはおもいますが、良いお返事お待ちしております。\n\n納品されたイラストはX（旧ツイッター）やMisskeyにて紹介させていただきます。", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@oudono/works/8", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2470075, "client_id": 3202259, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/3b22b132/uploads/origins/c1d9baed-01ba-4635-ba60-ae92c7c055a9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b1bb2f4c82d995562bd3a5336bc3f4e9", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/3b22b132/uploads/origins/c1d9baed-01ba-4635-ba60-ae92c7c055a9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ac8e6d4572cf9057e39743e960ab2327", "src_set": ""}, "body": "いつもmisskey.ioでかわいいケモちゃんのイラストを拝見しております。\nSkeb募集中のノートを見て、この度依頼させていただきたいと思いリクエストを送信いたしました。\n\n【依頼内容】\nうちの子 りさこちゃん の『ケモ化イラスト』を希望いたします。\n★参考資料\nhttps://media.misskeyusercontent.jp/io/04028537-ca71-46fc-8303-fc3c84691a5a.webp\nhttps://media.misskeyusercontent.jp/io/c8d1ab31-f28a-4fc2-b01a-426ff7a90a2c.webp\n\n【詳細】\nケモ度についてはアイコンやヘッダーのノエルちゃんぐらいのケモ度だとうれしいですが、描きやすいように描いていただいてかまいません。(手足がおおきめだとうれしいです。)\nモチーフはウサギ、リス、クマ等をイメージしていますが、こちらもお好みで描いていただいてかまいません。\n服装についてはフリル、お菓子のモチーフを入れていただけると嬉しいです。\n構図についてはうどんさんにおまかせいたします。\n\n以上、もし可能でしたらよろしくお願いいたします。", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@oudono/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2470075, "client_id": 433864, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/a403484a/uploads/origins/5f8e571b-a37e-49fe-a84d-d3ee62a57e7d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=aba3af225c095831e47d5b5cbae52e6e", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/a403484a/uploads/origins/5f8e571b-a37e-49fe-a84d-d3ee62a57e7d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=407ea98d2cdbbb0398530a874c0eb14c", "src_set": ""}, "body": "こんにちは！\nかわいいランジェリーか下着を着たウサギの絵をお願いしたいです。\n体高約60cm、33歳、ややぽっちゃり体型です!\n小さくても大人の魅力があるように描いてください。\nソフちゃんを描くのに参考になる写真を載せておきます。\nhttps://sta.sh/217dgwf4g8p2\n\nhttps://sta.sh/016coarykqdp", "nc": 176, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@oudono/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2470075, "client_id": 2344303, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/c49dab5a/uploads/origins/55e080a6-6acc-4c5d-b162-92759748fad0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d9126627fc3f3532e9a048ea7186a6d9", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/c49dab5a/uploads/origins/55e080a6-6acc-4c5d-b162-92759748fad0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=14ba63692f53635843e123803b40f85a", "src_set": ""}, "body": "こんにちは！\nうちのこキバキをケモ化して欲しいです！ \nホワイトタイガーベースでしっぽは2本\n\nその他構図･シチュエーション･衣装等は全てお任せします。\n出来れば人物･背景･サイン等がレイヤー分けされたPSDを希望します。\n\n使用用途\n個人使用･私が運用するSNSへの投稿･デザインして頂いたものを他の方に依頼する時の参考資料や自分で描かせて頂く場合があります。\nご検討よろしくお願いします！\nhttps://www.foriio.com/works/526203\n\nhttps://fori.io/yokutototo-h", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@oudono/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2470075, "client_id": 3077104, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/530bfe6f/uploads/origins/85b59f61-ab9d-4424-8721-7a06dee8aec0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=44d3dd36e13791e5fd9b7b86a2578a52", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/530bfe6f/uploads/origins/85b59f61-ab9d-4424-8721-7a06dee8aec0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d078ea584b49aa5394aca042cf9d9a29", "src_set": ""}, "body": "うどんさんのもふもふかわいいけもっこちゃん達にとても癒されています！いぬあかりさんと申します。\nこの度うどんさんに、うちの子のすずちゃんをもふもふケモ化した姿を描いていただきたくリクエストをいたしました。\n\n内容\n頭身、見た目はskeb1作品目の子ぐらいのもふもふ大きめ手足\nポーズは自由\n服装も自由（よく描かれているリボンがついたフリフリな感じの衣装がいいです！）\n差分でフリフリな下着差分をお願いしたいです！\n\n内容に問題がないようでしたらよろしくお願いいたします！", "nc": 160, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@oudono/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2470075, "client_id": 838315, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/a4b5e0c0/uploads/origins/7f828387-4a9c-4b2f-be06-1e476c1b92ae?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c484b54fd70db93298e1f726e371f5cd", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/a4b5e0c0/uploads/origins/7f828387-4a9c-4b2f-be06-1e476c1b92ae?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=dd6377bef619e9e1295f238d248cc123", "src_set": ""}, "body": "こんにちは！\nMisskeyで見たうどんさんのイラストがめちゃかわだったので依頼しました！！！！！\n僕の代理ちゃんのケモ化を描いていただきたいです！！！！\n衣装は着せたままで、前に他の方に描いていただいたケモ化した代理ちゃんをノエルちゃんくらいのかわいい感じで描いていただくことは出来ますか？\nその他の構図や雰囲気等全てお任せ致します！思うまま自由なテイストで描いていただければと思います！！！！すいません！！！！\n\n代理ちゃん\nhttps://misskey.io/notes/9g6km0p114\n\n描いていただいたケモ化のイラスト\nhttps://misskey.io/notes/9jy0jy0u0n", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@oudono/works/3", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/52632822/uploads/origins/650a2db1-46fc-4152-af70-7649dfb7c57a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=9da4de3cb91da18265d1aa94116717fb", "src_set": ""}, "private": true, "genre": "art", "tipped": true, "creator_id": 2470075, "client_id": 473046, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 32, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@oudono/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2470075, "client_id": 0, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/6a79b3ba/uploads/origins/0a1b5d81-25da-4d35-a2f4-20e86bd2fba2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5ba327effa259bcf30e2d4c88446a591", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/6a79b3ba/uploads/origins/0a1b5d81-25da-4d35-a2f4-20e86bd2fba2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=19dfbca88dca6cbb5bd3685fde593d5d", "src_set": ""}, "body": "どうもこんにちは。\nうどんさんのオリキャラ、ノエルちゃんの下着姿絵が可能でしたらお願いします。\nかぼちゃぱんつや猫ランジェリー絵を描かれていましたが、今回は一般的なブラとパンツと言いますか…\nレースやフリルの付いた可愛らしいデザインで描いて頂ければと思います。\n\n少し増額しましたので、可能でしたら裸差分も希望します。\n\nどうぞよろしくお願いします。", "nc": 176, "word_count": 0, "transcoder