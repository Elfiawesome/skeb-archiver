rt_client_visible": false, "total_appeals_count": 3, "received_works": [{"path": "/@YuzukiBooks/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1166142, "client_id": 3288175, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/8b0ccd93/uploads/origins/6f0dd14c-3b67-4859-9058-7abd15f81a25?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bcba93341c616ebe3f0aeac2f417fb9d", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/8b0ccd93/uploads/origins/6f0dd14c-3b67-4859-9058-7abd15f81a25?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=7330a96af1bedb696b3217bb26317dbe", "src_set": ""}, "body": "Hello! I love your work!\nCan you draw my character in a style similar to your first work on your Skeb page and the style of the show, \"Kodocha\" (こどものおもちゃ)? \nMy character is named Lemi Lichen, she is a snail scientist girl with a snail shell backpack! She loves nature and science and has a cute and nerdy personality.\nThis work may be used for YouTube and SNS, thank you!\n\nこんにちは！\nSkebのページにあるあなたの最初の作品と、「Kodocha」(こどものおもちゃ) というショーのスタイルに似たスタイルで、私のキャラクターを描いてもらえますか？\n私のキャラクターはLemi Lichenという名前で、カタツムリの殻のリュックを背負ったカタツムリの科学者の女の子です！自然と科学が大好きで、キュートでオタクな性格です。\nこの作品はYouTubeやSNSで使わせていただきます！\n\nhttps://drive.google.com/drive/folders/1DoAtWUXdzIz8mE-XvWvx_G3PT7TsOqYU?usp=sharing", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@YuzukiBooks/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1166142, "client_id": 1045444, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/e6019d66/uploads/origins/14ac5936-3e00-4f3f-8f12-4db9aa4843cc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b52c05c4299b76d41aa61d700b8e2a8a", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/e6019d66/uploads/origins/14ac5936-3e00-4f3f-8f12-4db9aa4843cc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=33b90c76a9e59b600ed80ffe13937ce1", "src_set": ""}, "body": "前回は素敵なイラストを描いて頂きありがとうございました。\n今回もリクエストさせていただきます。\n\n邪神ちゃんドロップキックの邪神ちゃんを描いて頂きたいです。\n\nシチュエーションとしては、カレーを美味しそうに食べている所を描いていただきたいです。\nキャラの『服は弱いヤツが着るモノ』という思想から普段上裸なので、人間時になったときの服を着た姿で描いて頂けると幸いです。\nそれ以外の部分に関してはゆづきさんにお任せ致します。\n\nよろしくお願いします。", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@YuzukiBooks/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1166142, "client_id": 2565950, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/f302df2f/uploads/origins/3b818fbe-41c0-4c49-84ff-03bd57be8cc4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a9ef0eb0675a6db4400b770b24d4de62", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/f302df2f/uploads/origins/3b818fbe-41c0-4c49-84ff-03bd57be8cc4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=7159a71e77005006380dfcde0de28189", "src_set": ""}, "body": "はじめまして。新人VTuberの永遠ヰらいとと申します。\n検索からゆづきゆうさんのイラストを拝見しまして、とても素敵でしたのでリクエストさせてください…！\n\n■ご依頼事項\nぼく「永遠ヰらいと」を描いていただきたいです。\n今度ゲーム「テイルズオブヴェスペリア」をプレイしようと考えておりまして、\n難しいリクエストで恐縮なのですが、テイルズ世界に永遠ヰらいとがいたらこんな感じかな…とイメージして描いていただけるととっても嬉しいです、、、！\n全身＆三面図：https://twitter.com/gainen104/status/1612010002495209474?s=20\n参考（ゲーム公式サイト）：https://tov10th.tales-ch.jp/remaster/\n\n（ゆづきゆう先生が過去テイルズシリーズを数作描かれていらっしゃったのを拝見したのですが、ヴェスペリアは未プレイでしたら申し訳ございません…！基本お好きに描いていただいて構いません！）\n\n■用途\nXでのツイート投稿、Youtubeでのサムネイル活用\nその他上記プラットフォームにて期間限定でアイコンやヘッダーに使用させていただくかもしれません。\n\nよろしくお願いいたします！", "nc": 0, "word_count": 0, "transcoder": "image", "creator_ac