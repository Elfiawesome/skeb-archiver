"https://si.imgix.net/22471400/uploads/origins/3f6d936f-045b-436b-95df-40332723a9b0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b2e9c5869ee57de055ec6f050ed40f30", "srcset": "https://si.imgix.net/22471400/uploads/origins/3f6d936f-045b-436b-95df-40332723a9b0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b2e9c5869ee57de055ec6f050ed40f30, https://si.imgix.net/22471400/uploads/origins/3f6d936f-045b-436b-95df-40332723a9b0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=1fa294100b5a3ad70eee2d870ff03352 2x, https://si.imgix.net/22471400/uploads/origins/3f6d936f-045b-436b-95df-40332723a9b0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=7eea659c637d0ce1fad3f093fe928546 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/22471400/uploads/origins/3f6d936f-045b-436b-95df-40332723a9b0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3921d00d57e9433daca8bbd5a168eebf", "srcset": "https://si.imgix.net/22471400/uploads/origins/3f6d936f-045b-436b-95df-40332723a9b0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3921d00d57e9433daca8bbd5a168eebf, https://si.imgix.net/22471400/uploads/origins/3f6d936f-045b-436b-95df-40332723a9b0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=d71a3bf52bca88b8a151c452b28cd2fc 2x, https://si.imgix.net/22471400/uploads/origins/3f6d936f-045b-436b-95df-40332723a9b0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=972ec114ec13f71eaae26bf02c2d79a6 3x"}, "body": "傘様\n\n初のリクエスト失礼します。\nヨーロッパ絵画にまつわる、読後感の爽やかな全年齢のお話をお願いします。文字数の指定はありませんので、書きやすい文字数でお願いします。\n\n傘様の小説が大好きなので、リクエストの機会が得られてとても嬉しいです。何卒よろしくお願いします。", "nc": 8, "word_count": 4992, "transcoder": "text", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": []},