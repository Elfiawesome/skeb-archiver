eチャンネル内での使用（サムネイルも）\n・FANBOX内での使用\n・ネットプリント\n・グッズを含む商用利用\n\n【納品形式】\n〇納品について\n可能であれば人物透過の画像が保存できるように人物･サイン･背景分けたPSDでいただけたらとても嬉しいです。\nまたサムネイルに使用したいため頭のてっぺんや髪の毛が見切れていないものも可能であれば宜しくお願い致します。\n\nご一考いただければと思います。何卒よろしくお願いします。", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@kouizumi_/works/4", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/f12c1405/uploads/origins/f0e532cc-b9d3-4ffb-a552-7304a221fee3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=666bf1079771b7e1140059cd317e09c0", "srcset": "https://si.imgix.net/f12c1405/uploads/origins/f0e532cc-b9d3-4ffb-a552-7304a221fee3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=666bf1079771b7e1140059cd317e09c0, https://si.imgix.net/f12c1405/uploads/origins/f0e532cc-b9d3-4ffb-a552-7304a221fee3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=03a8cc3da2d6ee68e1712630eb151a4b 2x, https://si.imgix.net/f12c1405/uploads/origins/f0e532cc-b9d3-4ffb-a552-7304a221fee3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=de49ea2ba5b841fcbb887669f9698437 3x"}, "private": true, "genre": "art", "tipped": true, "creator_id": 3741542, "client_id": 3101098, "nc": 145}, {"path": "/@kouizumi_/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3741542, "client_id": 821152, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/bd61c2df/uploads/origins/d078daa4-5fc4-446c-9bc6-74129b46210c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&