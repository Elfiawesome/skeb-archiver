すように！\n\nあなたのTwitterを見つけて、見たものがすごく気に入りました！あなたの画風はふわふわで柔らかくて素敵です！SNSでシェアするアートを依頼したいのですが、配信中の休憩時間に他の作品とローテーションで流す予定です。柔らかく可愛くてふわふわした表現が本当に上手なので、具体的な指示を出すより、あなたがどんな作品を作ってくれるか楽しみにしています！\n\n*提供したカラーパレットの肌色系を使ってください！手のひらは明るい色にしてくださいね！お引き受けいただければ嬉しいです。もし無理でも、素敵な一日を過ごしてくださいね！<3 https://drive.google.com/drive/folders/1miSrEuoFjphM7X_ciD9xqxatog1jB4_R?usp=sharing", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@koinuame/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3891639, "client_id": 3275333, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/a2fc1a26/uploads/origins/c358b6d6-30fd-46e2-be78-12cc0ff48431?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=de54e51809bb3cb324aa99b16b5cdc4b", "srcset": "https://si.imgix.net/a2fc1a26/uploads/origins/c358b6d6-30fd-46e2-be78-12cc0ff48431?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=de54e51809bb3cb324aa99b16b5cdc4b, https://si.imgix.net/a2fc1a26/uploads/origins/c358b6d6-30fd-46e2-be78-12cc0ff48431?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=6acee9b94ae1722d5006bae32677ae54 2x, https://si.imgix.net/a2fc1a26/uploads/origins/c358b6d6-30fd-46e2-be78-12cc0ff48431?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=96638b4b6e5b56628eabb7614a555b8f 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/a2fc1a26/uploads/origins/c358b6d6-30fd-46e2-be78-12cc0ff48431?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9cb5481aba21cca905f17178f0d678ba", "srcset": "https://si.imgix.net/a2fc1a26/uploads/origins/c358b6d6-30fd-46e2-be78-12cc0ff48431?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9cb5481aba21cca905f17178f0d678ba, https://si.imgix.net/a2fc1a26/uploads/or