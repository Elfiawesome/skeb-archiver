e50?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d06ed8946f5fb826f39b4a65fa816d82 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/6db29a04/uploads/origins/126e859a-6f4b-4c0f-aac0-0cd159d00e50?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c4fd80327ecc67da203f5ef8d3f491db", "srcset": "https://si.imgix.net/6db29a04/uploads/origins/126e859a-6f4b-4c0f-aac0-0cd159d00e50?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c4fd80327ecc67da203f5ef8d3f491db, https://si.imgix.net/6db29a04/uploads/origins/126e859a-6f4b-4c0f-aac0-0cd159d00e50?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=06159386d3fcfc36e7e06ff1df5a9cc1 2x, https://si.imgix.net/6db29a04/uploads/origins/126e859a-6f4b-4c0f-aac0-0cd159d00e50?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=37aebd473adce7624629768cc1eba93d 3x"}, "body": "こんにちは。私のキャラクター「ゾーイ」を描いていただきたいです。彼女は30歳の勤勉な女性で、アライグマのしっぽとふわふわしたアライグマの耳を持っています。彼女の三白眼はよく人を不安にさせますが、いつもとても疲れているため、性格はとても穏やかです。余暇にはデジタルアーティストとして活動していますが、思うように絵を描けないことに不満を感じています。\n\nお好きなように描いていただいて構いませんが、もし参考になる情報があれば……ゾーイは夜行性なので、夜を舞台にしていただきたいです。夜に散歩をしている姿、街灯の下に立っている姿、あるいは公園のベンチに座っている姿などが良いかもしれません。\n\n参考画像はこちらです：\nhttps://drive.google.com/drive/folders/1D70UGGDnYdw8ZQE2ufYAVkOTy0nnz3l2?usp=sharing\n\nお時間をいただき、誠にありがとうございます", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@yoruwalk08/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3917319, "client_id": 2986862, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/aa03ff4e/uploads/origins/b6ebebdb-8015-4293-8a6e-0d46dcf204e8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=de842d09cea104e3ed4583654727287f", "srcset": "https://si.imgix.net/aa03ff4e/uploads/origins/b6ebebdb-8015-4293-8a6e-0d46dcf204e8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=de842d09cea104e3ed4583654727287f, https://si.imgix.net/aa03ff4e/uploads/origins/b6ebebdb-8015-4293-8a6e-0d46dcf204e8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=52a79b860a37a0bd797043be91bb01cf 2x, https://si.imgix.net/aa03ff4e/uploads/origins/b6ebebdb-8015-4293-8a6e-0d46dcf204e8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ce83cb88f1c54bab919a6c0b94ec5780 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/aa03ff4e/uploads/origins/b6ebebdb-8015-4293-8a6e-0d46dcf204e8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d4da51ca8f55701e651a37ede9953a46", "srcset": "https://si.imgix.net/aa03ff4e/uploads/origins/b6ebebdb-8015-4293-8a6e-0d46dcf204e8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d4da51ca8f55701e651a37ede9953a46, https://si.imgix.net/aa03ff4e/uploads/origins/b6ebebdb-8015-4293-8a6e-0d46dcf204e8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=1143868a521f841963bd834d973ad13c 2x, https://si.imgix.net/aa03ff4e/uploads/origins/b6ebebdb-8015-4293-8a6e-0d46dcf204e8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=6f9720a4b3fb7ccac5200f0a1bf5dd31 3x"}, "body": "こんにちは。\n以前は、私のオリジナルキャラである魔女っ子を描いてくださり、ありがとうございました。\n\nその時の作品は、こちらになります。\n\nhttps://skeb.jp/@fuyunoyoiyume_i/works/4\n\nさて、久しぶりに依頼をしたいのですが、私は、魔法というものは、危険な側面も持っていると思っていまして。\nアニメなどでも見られるように、場合によっては危機に陥ってしまうこともあると思うんですね。\n\nそこで依頼内容というのは、私のオリジナルキャラの魔女っ子が、細長い闇のようなものに体を巻かれて、身動きができなくてピンチみたいな場面を描いてほしいのです。\n\nとは言え、そんなにおどろおどろしいというのではなく、困り眉と閉じた両目で表現できる苦しげな表情を用いた、子ども向けアニメでも流せるようなピンチであれば、とは思っております。\n\nかわいい女の子も、不穏な感じの絵も描ける睦月さんと見込んでリクエストした次第ですが、良ければ受けてくださる形で構いません。\n\n以上、宜しくお願い致します。\n\n\n※私のオリジナルキャラの資料は、UR