ull, "private": false, "genre": "art", "tipped": false, "creator_id": 3388598, "client_id": 1511006, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/3a753156/uploads/origins/cf4e805b-f948-4135-96c9-08f4a285db87?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b85ad9f0e745f55d08ef7b985ab7c6bd", "srcset": "https://si.imgix.net/3a753156/uploads/origins/cf4e805b-f948-4135-96c9-08f4a285db87?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b85ad9f0e745f55d08ef7b985ab7c6bd, https://si.imgix.net/3a753156/uploads/origins/cf4e805b-f948-4135-96c9-08f4a285db87?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=6379e490d406c89e7037820a67943338 2x, https://si.imgix.net/3a753156/uploads/origins/cf4e805b-f948-4135-96c9-08f4a285db87?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b9b3ef8e62224b3ed28d1c30a49bf0ec 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/3a753156/uploads/origins/cf4e805b-f948-4135-96c9-08f4a285db87?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=39e04bc3954214f3ff31cd78bfc0f39c", "srcset": "https://si.imgix.net/3a753156/uploads/origins/cf4e805b-f948-4135-96c9-08f4a285db87?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=39e04bc3954214f3ff31cd78bfc0f39c, https://si.imgix.net/3a753156/uploads/origins/cf4e805b-f948-4135-96c9-08f4a285db87?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=ec734cc07ce5a97604d02f559fdbaff9 2x, https://si.imgix.net/3a753156/uploads/origins/cf4e805b-f948-4135-96c9-08f4a285db87?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=f9806f6b9cfcf767ecaf189c0e63a27a 3x"}, "body": "こんにちは、あなたのデザインシートを拝見し、私のキャラクター「ミシュレイ」のデザインをお願いしたいのですが。\n\nミシュレイは蛇の体を持つ、長く流れるような白い着物に身を包んだ、高くそびえ立つ淡い白の龍のような存在です。彼女は2本の扇を持って、流れる水のように優雅に舞う。彼女の動きは流麗で、魅力的でありながら静謐だ。\n\n私が想像する彼女の主な特徴は、背が高く、魅惑的で、穏やかである。\n\n彼女の着物には、長く流れるような袖の着物を希望します。デザインは華美である必要はありませんが、着物にさりげなく色が散りばめられていると嬉しいです。\n\n体については、先ほども言ったように、蛇のような体つきです。カーヴィーな女性の骨格にしてもいいでしょう。あなたの判断にお任せします。彼女のイメージを思い浮かべるために、いくつか画像を追加しました。\n\nよろしくお願いします！\n\nhttps://drive.google.com/drive/u/1/folders/1iiD_sCCNM6E6N16ozO9ieF50nroZeDXi", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@pleiades_mk2/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3388598, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/aa94f87e/uploads/origins/4c22fd41-88b2-4217-8d22-faa16608ab36?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f09e83de406fb75df50123be00a03e17", "srcset": "https://si.imgix.net/aa94f87e/uploads/origins/4c22fd41-88b2-4217-8d22-faa16608ab36?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f09e83de406fb75df50123be00a03e17, https://si.imgix.net/aa94f87e/uploads/origins/4c22fd41-88b2-4217-8d22-faa16608ab36?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=728f364ae9745a3f6d48c1572cc86767 2x, https://si.imgix.net/aa94f87e/uploads/origins/4c22fd41-88b2-4217-8d22-faa16608ab36?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=cf8c263a47c6954061fad59aeed4079d 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/aa94f87e/uploads/origins/4c22fd41-88b2-4217-8d22-faa16608ab36?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c216e2f76bc1be4b928f2e7ebd3716af", "srcset": "https://si.imgix.net/aa94f87e/uploads/origins/4c22fd41-88b2-4217-8d22-faa16608ab36?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c216e2f76bc1be4b928f2e7ebd3716af, https://si.imgix.net/aa94f87e/uploads/origins/4c22fd41-88b2-4217-8d22-