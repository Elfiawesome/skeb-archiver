3356/uploads/origins/853952ea-6b9d-415f-9d70-c8cb1d29a4db?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=7abad916a32e3b447b86d3635c877907", "src_set": ""}, "body": "鍋564様、はじめまして。可愛いイラストいつも楽しみにしています。\n\nゆゆ式という作品の「野々原ゆずこ」を、鍋564様に是非描いていただきたいです。\n\n服装は資料のとおり制服で、ポーズ等はお任せします。表情は笑顔、両目が開いたものでお願いいたします。\n\nいただいたものはSNSのアイコンで使用したいと考えています。よろしくお願いします。\n\n資料\nhttps://drive.google.com/drive/folders/1kg6NRL2K-gcgfg8k8H2q2Og7-9K3u1yE", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@nabegoroshi/works/6", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/c266b8aa/uploads/origins/ef0efb49-1d23-4882-9b43-f071b92d1426?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=b9f340da7d2a9c468eaac04f3924e0fc", "src_set": ""}, "private": true, "genre": "art", "tipped": true, "creator_id": 3609568, "client_id": 1499469, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 16, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@nabegoroshi/works/5", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/b864aedc/uploads/origins/8272b00e-759e-48c5-882d-ec73c7ce0f5d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=119d84a9f6763e093edb986d992102b0", "src_set": ""}, "private": true, "genre": "art", "tipped": true, "creator_id": 3609568, "client_id": 1499469, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 17, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@nabegoroshi/works/4", "private_thumb