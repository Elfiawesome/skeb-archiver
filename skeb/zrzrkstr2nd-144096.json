=top&w=200&h=200&s=80855bfb80732ee06404109ed20fb427, https://si.imgix.net/15ca13fe/uploads/origins/cd5163ca-811a-4f2d-a233-c502012138b7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=2e59694d7b6a207dbc07a8a3c59db19d 2x, https://si.imgix.net/15ca13fe/uploads/origins/cd5163ca-811a-4f2d-a233-c502012138b7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=85fbd6584800472a41f773118ea3a18a 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/15ca13fe/uploads/origins/cd5163ca-811a-4f2d-a233-c502012138b7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=fcd599fbf0b84ebfe113add7a4e10cd5", "srcset": "https://si.imgix.net/15ca13fe/uploads/origins/cd5163ca-811a-4f2d-a233-c502012138b7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=fcd599fbf0b84ebfe113add7a4e10cd5, https://si.imgix.net/15ca13fe/uploads/origins/cd5163ca-811a-4f2d-a233-c502012138b7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=e564ca578e2dbb307e5291027501d17b 2x, https://si.imgix.net/15ca13fe/uploads/origins/cd5163ca-811a-4f2d-a233-c502012138b7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=1c6802d1e91fa8c00d94a11bfd87fb32 3x"}, "body": "初めまして！\nモノクロ漫画でリクエスト可能でしたらお願いします。\n漫画のページ数は金額で可能な範囲でお願いします。\n\n女の子がお仕置きされてる様子が好きなので、JCが先生から罰としてお尻を叩かれる様子をお願いします。\n※制服はセーラー服で短めのスカート希望\n\n「内容」\n宿題を忘れてしまった生徒は教室の前に来なさいと言われ男子生徒は今回0人で、女子生徒が3〜4人ぐらい忘れ物をしてしまい嫌々前に出る。\n※女子生徒達は地味系や超絶可愛い系、元気っ子系等個性的な生徒希望です。\n\n先生からケツ竹刀を宣告され生徒達は教室の隅で縦に並んで順番を待っている。\n皆んなの前で恥ずかしそうに顔を赤らめていたり、耐えられるかドキドキしていたり不安そうな様子。\n他の女子生徒\n「皆んなに見られるとか最悪…」\n「先生女子には手加減してよね！」\n\n可愛い系の女子\n「初めてだし耐えられるか心配だよ…」\nとぼやきながら待っている。\n\n黒板に両手をついてお尻を突き出しお尻を叩かれてる地味系な普通の女子生徒。\n先生は女子にも容赦無くフルスイングでスカートの上から叩かれ必死な表情で耐えている。\n\n次私の番だと…震えてる2人目が呼ばれてその後3人目も叩かれてるシーン。\n苦痛な表情や今にも泣きそうな様子。\n\n\n3人目の生徒の罰が終わり最後の生徒を呼ぶ先生。\nクラスNo.1の可愛い２つ結びの小柄な女子生徒が呼ばれ、か弱い声で返事をして胸に手を当ててドキドキしながら黒板へ向かう。\n両手をついてお尻を突き出し震えながら構えている女子生徒。\n男子生徒が「先生！〇〇さん初めてだから優しくね！！」とか「なんなら代わりに俺が受けるよ！」とかさっきの女子生徒達とは別扱いの様子。\n\nさっき叩かれた女子生徒がブーブー言ってる様子。\n\nしかし先生はそんな状況などお構い無く、平等にケツ竹刀を行う。\nしっかり歯を食いしばりなさい！！と言って竹刀で容赦無く叩かれ、女子生徒はあまりの痛さに驚いた表情で喰らっている。\nその後両手でお尻をさすりながら自分の席に戻り、男子達から頑張ったね！大丈夫？など言われてる。\n\nよろしくお願いいたします。", "nc": 161, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 152406, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "でゅらんだる", "screen_name": "DurandulK3", "avatar_url": "https://pbs.twimg.com/profile_images/1827491190847238144/-5q7Mcww.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1330440003126759426/1691305539/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 120, "skills": [{"genre": "art"}], "banned": false, "nc": 160}, {"id": 180917, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "cent_u/ご依頼はDMへ", "screen_name": "centu_7u", "avatar_url": "https://pbs.twimg.com/profile_images/1414785727271890946/N6l4njzG.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1157496176054112259/1643425200/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "art"}, {"genre": "comic"}, {"genre": "correction"}], "banned": false, "nc": 160}, {"id": 365167, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "R学.ぐらぷ", "screen_name": "R_gaku_gurap", "avatar_url": "https://pbs.twimg.com/profile_images/1433243256674938882/wFGB4_z5.jpg", "header_url": "https://pbs.twimg.com/profile_banners/858335281375608832/1637369480/1500x500", "appe