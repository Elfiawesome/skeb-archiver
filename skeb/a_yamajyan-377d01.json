dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=1dd6180b8056e7fbc6ad4ba5c1805bcb 3x"}, "body": "横山先生こんにちは。\nSkebが募集再開したと知り、ご連絡させていただきました。\n先生の作品は「もえばな」の頃からずっと読んでおり、周りにも布教しまくっております。\nお話の作り方もさる事ながら、イラストの雰囲気やデフォルメの愛らしさにいつもほんわかしながら作品を楽しませていただいておりました。\n\n\n◼︎使用用途\n観賞用\n\n\n◼︎リクエスト\nTRPGで使用しているOCのイラストを依頼させていただきたいです。\n\n38歳男性、関西出身。\n身長は169cmだが他人には「170cmやで〜」と盛っている。\n警察官で、捜査班のチーフを務める結構階級は偉いおじお兄さんですが、ヘラヘラニコニコしているので他人に舐められがち。写真を撮る時はピース✌️\n手料理が得意で、行き場のない父性を部下に注いでいるタイプの男性です。\n\n\n先生の描くデフォルメ、ミニキャラが大好きなのでこちらも描いていただけると嬉しいです。\nお手数をおかけしますが、何卒よろしくお願い致します。\n\nhttps://drive.google.com/drive/folders/1L7OxxFIt6-eqPJJ3hlZchsgCPBfY-oKO?usp=sharing", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@a_yamajyan/works/11", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3743182, "client_id": 3797056, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/ccf4d971/uploads/origins/fdd35a98-8231-42ab-8f8b-b3e598a26261?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5c9b762992a44f66b4a1ce790965a15a", "srcset": "https://si.imgix.net/ccf4d971/uploads/origins/fdd35a98-8231-42ab-8f8b-b3e598a26261?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5c9b762992a44f66b4a1ce790965a15a, https://si.imgix.net/ccf4d971/uploads/origins/fdd35a98-8231-42ab-8f8b-b3e598a26261?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=4b2022dfcdc10d214aaca2c4879e6f48 2x, https://si.imgix.net/ccf4d971/uploads/origins/fdd35a98-8231-42ab-8f8b-b3e598a26261?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f65c171b92522e82e19702930d14e2f2 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/ccf4d971/uploads/origins/fdd35a98-8231-42ab-8f8b-b3e598a26261?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=7eecee787d13879c512ec3a1ce154dfe", "srcset": "https://si.imgix.net/ccf4d971/uploads/origins/fdd35a98-8231-42ab-8f8b-b3e598a26261?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=7eecee787d13879c512ec3a1ce154dfe, https://si.imgix.net/ccf4d971/uploads/origins/fdd35a98-8231-42ab-8f8b-b3e598a26261?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=0dd15bf8cb9bd914ca5772955852715c 2x, https://si.imgix.net/ccf4d971/uploads/origins/fdd35a98-8231-42ab-8f8b-b3e598a26261?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=358ec3b001e7124bc183f5d05b527be3 3x"}, "body": "お世話になります。初めてskebを依頼しますので、不手際がもしかしたからあるかもしれません。ご容赦ください。\n\n依頼したいと思っておりますのは、日本の神様的な女性を横山先生に描いていて頂けたらと思っております。\n\nイメージとしては巫女的な感じと天照大神のイメージです。神聖さと無垢さと無邪気さを兼ね備えた感じが出ていると大変嬉しいです。\n\n何卒宜しくお願い致します。", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@a_yamajyan/works/10", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3743182, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/c3e9a089/uploads/origins/513ab44c-0642-4f52-bd2f-6cde7f9b2755?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=84860f862768d5d36c821e471c9f9824", "srcset": "https://si.imgix.net/c3e9a089/uploads/origins/513ab44c-0642-4f52-bd2f-6cde7f9b2755?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=84860f862768d5d36c821e471c9f9824, https://si.imgix.net/c3e9a089/uploads/origins/513ab44c-0642-4f52-bd2f-6cde7f9b2755?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=d7f4e258bdb0f47550f0466c28732647 2x, https://si.imgix.net/c3e9a089/uploads/origins/513ab44c-0642-4f52-bd2f-6cde7f9b2755?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d4c51406028b01d4314701df2328fe06 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumb