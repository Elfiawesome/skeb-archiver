s&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=0bddc4eab70c1201e040af46e5d3a5fb 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/83120b1c/uploads/origins/a8a877e7-6ba1-42fc-9f93-e31c99dbcc5d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=4726733ad816a4b7f573652c35b42e98", "srcset": "https://si.imgix.net/83120b1c/uploads/origins/a8a877e7-6ba1-42fc-9f93-e31c99dbcc5d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=4726733ad816a4b7f573652c35b42e98, https://si.imgix.net/83120b1c/uploads/origins/a8a877e7-6ba1-42fc-9f93-e31c99dbcc5d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=5efcf3848341b528446af021b87ccd2b 2x, https://si.imgix.net/83120b1c/uploads/origins/a8a877e7-6ba1-42fc-9f93-e31c99dbcc5d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=81d3c48864b340559bb3794f25b4a8c4 3x"}, "body": "九楽丸さんの絵が好きなので、ぜひ立ち絵を依頼したいと思いました！\n以下の項目以外は好きなように描いて構いません。\n\n･イメージカラー▶︎緑\n･男性\n\n【利用用途】\nIRIAMの立ち絵として利用します。\n商用利用、二次創作の許可、グッズ化、立ち絵のXへの投稿、事務所公式Xへの投稿", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@kurakumaru/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3688638, "client_id": 227300, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/1a1dd654/uploads/origins/5853cb63-a087-4313-af5a-4712290b2f93?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8144fe8fd6bb65214e3397c3dc17d24a", "srcset": "https://si.imgix.net/1a1dd654/uploads/origins/5853cb63-a087-4313-af5a-4712290b2f93?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8144fe8fd6bb65214e3397c3dc17d24a, https://si.imgix.net/1a1dd654/uploads/origins/5853cb63-a087-4313-af5a-4712290b2f93?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=80d89365f261d8d48f926c6a53575212 2x, https://si.imgix.net/1a1dd654/uploads/origins/5853cb63-a087-4313-af5a-4712290b2f93?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a9b42f3bfc21379d830be126802473ee 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/1a1dd654/uploads/origins/5853cb63-a087-4313-af5a-4712290b2f93?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=8f6fd418bffebe232358c9014f41e923", "srcset": "https://si.imgix.net/1a1dd654/uploads/origins/5853cb63-a087-4313-af5a-4712290b2f93?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=8f6fd418bffebe232358c9014f41e923, https://si.imgix.net/1a1dd654/uploads/origins/5853cb63-a087-4313-af5a-4712290b2f93?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=37664eab6633798dba2e77d17948885e 2x, https://si.imgix.net/1a1dd654/uploads/origins/5853cb63-a087-4313-af5a-4712290b2f93?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=cb0e97b172dcaef3536cbdda04bea3c7 3x"}, "body": "九楽丸さんはじめまして。るげつぺぽと申します。\nアピールありがとうございます。お気に召したようで嬉しいです。\nお好きに描いていただければと思います。よろしくお願いします。\n\n趣味の配信で使用している代理キャラクター(顔色ちゃん)をお願いしたいです。\n15歳の男の子、身長155～160、顔は若干中性よりです。\n髪の毛は白と青色のツートンで、普段は眠そうにしてて抜けてますが、やるときはやる子です。\n全体図参考\nhttps://twitter.com/rugetsupepo/status/1690939483074826240\n表情変化分参考\nhttps://twitter.com/rugetsupepo/status/1664293689412435968\n新衣装\nhttps://x.com/rugetsupepo/status/1906691283889901583\n\n服装や構図、シチュエーションなどはおまかせします。キャラクターの衣装を乗せておりますが、見えない部分の補完などは好きにしてくださっても大丈夫ですし、全く違う衣装を着せていただいても大丈夫です。\nこれは出来ればのお願いなのですが、顎を90度以上の鈍角で描いて欲しいです。柔らかさを感じられて好きなので…難しそうだったり、描きたい方向と違えばそうじゃなくても大丈夫です。\n\n太極図のアクセサリはキャラクターのモチーフでもあるので、必ず入れて欲しいです。\nSNSのアイコンやヘッダ、YouTubeなどで使用する可能性があります。(収益用途では使いません)\nキャラクターは下部以外は見切れないようにしてほしいです。\nお手数おかけしますが背景や文字などある場合はキャラ単体のものもほしいです。\n形式はpsdまたはpngでお願いします。\n\n以上の内容でお受けできそうであれば、よろしくお願いします。", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@kurakumaru/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3688638, "client_id": 4005712, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/567a3765/uploads/origins/6f51ad18-f8c2-417f-a9ea-d1cfec5faa3e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=836bedaf1810c21a12635afe3dd7acc8", "srcset": "https://si.imgix.net/567a3765/uploads/origins/6f51ad18-f8c2-417f-a9ea-d1cfec5faa3e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=836bedaf1810c21a12635afe3dd7acc8, https://si.imgix.net/567a3765/uploads/origins/6f51ad18-f8c2-417f-a9ea-d1cfec5faa3e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=451452d9d5c93f5f164957d0fd07e8db 2x, https://si.imgix.net/567a3765/uploads/origins/6f51ad18-f8c2-417f-a9ea-d1cfec5faa3e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b45582fb8ca0e0908911481c1b725ee0 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/567a3765/uploads/origins/6f51ad18-f8c2-417f-a9ea-d1cfec5faa3e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c045ca96b8550affaadde8abef195c41", "srcset": "https://si.imgix.net/567a3765/uploads/origins/6f51ad18-f8c2-417f-a9ea-d1cfec5faa3e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c045ca96b8550affaadde8abef195c41, https://si.imgix.net/567a3765/uploads/origins/6f51ad18-f8c2-417f-a9ea-d1cfec5faa3e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=20a71d54d85935db7bbe2c55d34ae29c 2x, https://si.imgix.net/567a3765/uploads/origins/6f51ad18-f8c2-417f-a9ea-d1cfec5faa3e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=82e4b8badc8c06c