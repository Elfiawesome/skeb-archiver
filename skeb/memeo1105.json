で活動する予定です）で活動しているNEGI00Kと申します。\n先生の作品をいつも楽しく読ませていただいております。ぜひ自身のイラストを描いていただきたく思い、リクエストをさせていただきます。\n\n【内容】\n体育の後などで、更衣室で着替えている最中のイメージを描いていただきたいです。\nキャラクターの筋肉が映えるようなイラストだと嬉しいです。\n\n衣装等のデザイン違いなどは気にしませんので、女々男先生の描きやすい形で自由にお願いできれば幸いです。\n\n【人物設定】\n20歳の男で身長は176cmです。\n人間のフリをした悪魔です。チョーカーの下は悪魔のタトゥーを隠しています。\n基本的には穏やかで礼儀正しく敬語で話しますが、悪魔の状態にするとだらしなくなります。猫耳と尻尾も現れます。\n\n【使用用途】\nイラストを収益化済みのチャンネルの配信内、動画内、サムネイル等のVtuber活動で使用させていただく予定です。\n有料メンバー様へのプレゼント（有料特典）などの利用もしたいです。\nサムネイルなどに使いたいためキャラの透過ができるPSDファイルを頂けるととても助かります。\nお受けいただけますと幸いです、よろしくお願いいたします\n\nhttps://drive.google.com/drive/folders/1j_Y-j_uyqoDVg5Er3_Jbq_M4GuVNPRqk?usp=sharing", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@memeo1105/works/93", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/346545c2/uploads/origins/279bddd3-b7ed-4271-995e-aca8884b9b4d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=658ec47d42d47c0c1ffe89235c83caa1", "src_set": ""}, "private": true, "genre": "art", "tipped": false, "creator_id": 2725, "client_id": 121740, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 161, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@memeo1105/works/92", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2725, "client_id": 0, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/22295535/uploads/origins/20a3876e-2423-4938-8f94-adf367c7d8db?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2b74017e9184c431ee011f9209d8cf5f", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/22295535/uploads/origins/20a3876e-2423-4938-8f94-adf367c7d8db