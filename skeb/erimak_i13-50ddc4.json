表情などの差分があれば大変嬉しく思います。\n※可能の範囲内で耳や髪は見切れないようお願い致します。\n※できれば尻尾は有りでお願い致します。\n\n🐺特徴\n・紫の目のみに三日月がある\n・八重歯 \n・白いまつ毛\n・人間の耳なし\n\n🌘比率・納品形式\nPSD形式で、人物とその他のレイヤーを分けていただけますと幸いです。\n\n要望が多くなりましたが、ご検討をお願いします。\n\nhttps://drive.google.com/drive/folders/1TfRdlSOCxMNLFjYdxARGEB3VkWmm6x9w?usp=drive_link", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@erimak_i13/works/9", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1457737, "client_id": 3181742, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/4355af61/uploads/origins/223b7f4d-e981-4770-a111-3646fe021da2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e360f231c0b0a962416d01abb28aff65", "srcset": "https://si.imgix.net/4355af61/uploads/origins/223b7f4d-e981-4770-a111-3646fe021da2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e360f231c0b0a962416d01abb28aff65, https://si.imgix.net/4355af61/uploads/origins/223b7f4d-e981-4770-a111-3646fe021da2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e5ad3a025aab81b15b06590bb2d2f168 2x, https://si.imgix.net/4355af61/uploads/origins/223b7f4d-e981-4770-a111-3646fe021da2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=fc9d1a351193d6846fb4f38cbbf71cf6 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/4355af61/uploads/origins/223b7f4d-e981-4770-a111-3646fe021da2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5cc7e021f48ef31edacb5461ee0de9f5", "srcset": "https://si.imgix.net/4355af61/uploads/origins/223b7f4d-e981-4770-a111-3646fe021da2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5cc7e021f48ef31edacb5461ee0de9f5, https://si.imgix.net/4355af61/uploads/origins/223b7f4d-e981-4770-a111-3646fe021da2?bg=%23fff&auto=format%2Ccomp