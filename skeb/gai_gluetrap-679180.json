e74d4150939951bd98f8b0688f5f 2x, https://si.imgix.net/dd2fb3b2/uploads/origins/ee868a8e-0bd5-4be5-88b0-dd77b41cc9b3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a0e32da1e7ea3dceb8ca560ac5672814 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/dd2fb3b2/uploads/origins/ee868a8e-0bd5-4be5-88b0-dd77b41cc9b3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6343f6e5704d53d04266836f8c880047", "srcset": "https://si.imgix.net/dd2fb3b2/uploads/origins/ee868a8e-0bd5-4be5-88b0-dd77b41cc9b3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6343f6e5704d53d04266836f8c880047, https://si.imgix.net/dd2fb3b2/uploads/origins/ee868a8e-0bd5-4be5-88b0-dd77b41cc9b3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=053e0dcf79f66d1ec11deadf903fc560 2x, https://si.imgix.net/dd2fb3b2/uploads/origins/ee868a8e-0bd5-4be5-88b0-dd77b41cc9b3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=5726d685585ad6f6cf124d5a4328fa88 3x"}, "body": "以前はリクエスト引き受けてくださりありがとうございました。\n今回は以前のイラストリクの続きのシチュで描いてほしいです。\n今回もこちらのうちの子、灰神楽　炎くんの触手攻めをお願いしたいです。\nhttps://x.com/104Zx3/status/2052297972843790842?s=20\n\n以前より更にピンチに追い込まれて、大量の触手に全身をからめとられ、口の中に触手を突っ込まれて怪しい液体を口の中に出されてる感じでお願いします。\n服の中にも潜り込まれ顔もかなり赤くなり息を荒げてるような形でお願いしたいです。\n服は以前と同じくボロボロレベル、R-17くらいでお願いします。\n\nどうぞよろしくお願いいたします。", "nc": 41, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@gai_gluetrap/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2275454, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/5696ad68/uploads/origins/33f9a16b-a4ea-4f44-bb86-cf4d2eb42690?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f393f1f4a6c63d7b8a153caf0cbda9ba", "srcset": "https://si.imgix.net/5696ad68/uploads/origins/33f9a16b-a4ea-4f44-bb86-cf4d2eb42690?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f393f1f4a6c63d7b8a153caf0cbda9ba, https://si.imgix.net/5696ad68/uploads/origins/33f9a16b-a4ea-4f44-bb86-cf4d2eb42690?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=96c560d47f9ad627722b9956134bc9d4 2x, https://si.imgix.net/5696ad68/uploads/origins/33f9a16b-a4ea-4f44-bb86-cf4d2eb42690?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=5be71ae23777f686162c9d4cc67c6c77 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/5696ad68/uploads/origins/33f9a16b-a4ea-4f44-bb86-cf4d2eb42690?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ea3ebefe5d13afa1865281ba122971a1", "srcset": "https://si.imgix.net/5696ad68/uploads/origins/33f9a16b-a4ea-4f44-bb86-cf4d2eb42690?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ea3ebefe5d13afa1865281ba122971a1, https://si.imgix.net/5696ad68/uploads/origins/33f9a16b-a4ea-4f44-bb86-cf4d2eb42690?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=c36c9d5958220f36d120f88628f59cf6 2x, https://si.imgix.net/5696ad68/uploads/origins/33f9a16b-a4ea-4f44-bb86-cf4d2eb42690?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=30832f14099574c8b92fdc59fdaa8636 3x"}, "body": "我伊さん、お疲れ様です。\n先日は着ぐるみ逆バニーボーイの作品、ありがとうございました。\n起承転結の流れがとてもまとまっていて、襲われてから逆バニーボーイにされてしまうまでの流れがとても素晴らしいものでした。\n続編を考えました。検討をお願いします。\n\n内容\n「有須川佑くん、着ぐるみ逆バニーボーイ強制着用。乙葉幹哉くんとともに着ぐるみ逆バニーボーイの2人組にされてしまう」\n\n内容イメージ\n・有須川くん、乙葉くんを追って近道の路地裏へ向かう。そこには着ぐるみ逆バニーボーイ（中身は乙葉くん）がいる\n・着ぐるみ逆バニーボーイの状況はお任せします（マスクを脱ごうと引っ張っている。外側の着ぐるみに操られて、客引きの看板を持って誘っている。興奮が収まらず悶々としている。脱ぎたくて助けを求めて有須川くんに向かってふらふらと歩いてくる）\n・有須川くん、変態が居ると思って離れようとするが、くぐもった声が乙葉くんだと気付き、脱がそうと引っ張る。マスク越しに乙葉くんの顔の輪郭が浮かんだりするが、全く脱がせることはできない\n・有須川くんの頭上に、着ぐるみ逆バニーボーイの着ぐるみのマスクが浮かんでおり、被せられてしまう。もがく有須川くんだが、逆バニーボーイにされてしまう。\n・路地裏に2人組の逆バニーボーイがおり、変態な格好、端正な顔、整った体つきとは対照的に、くぐもった声や興奮しきった様子が見て取れる。\n\n以上になります。\n有須川くんが助けようと必死になっていたら、頭上の着ぐるみマスクに気が付かず、そのまま着ぐるみバニーボーイにされてしまった感じですね。\n有須川くんの着ぐるみ逆バニーボーイのデザインは、服や顔も含めてお任せいたします。乙葉くんと同じような顔でも、整ったイケメン風でも、或いは興奮した少年のような顔でも、お任せいたします。\n長くなりましたが、検討のほどよろしくお願いいたします。", "nc": 184, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@gai_gluetrap/works/5", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/9cc5c2dc/uploads/origins/ad465eac-d1b1-4218-a693-4fb3505c51ca?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=655dcadf0a989ac8f542d802ec3312e6", "srcset": "https://si.imgix.net/9cc5c2dc/uploads/origins/ad465eac-d1b1-4218-a693-4fb3505c51ca?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=655dcadf0a989ac8f542d802ec3312e6, https://si.imgix.net/9cc5c2dc/uploads/origins/ad465eac-d1b1-4218-a693-4fb3505c51ca?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=1dba9dc53a1a93d44b4a257d7194275a 2x, https://si.imgix.net/9cc5c2dc/uploads/origins/ad465eac-d1b1-4218-a693-4fb3505c51ca?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=cc49dbf18c74600550d930391b155721 3x"}, "private": true, "genre": "art", "tipped": false, "creator_id": 2275454, "client_id": 3726141, "nc": 35}, {"path": "/@gai_gluetrap/works/4", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/95aa09cf/uploads/origins/001c571e-6688-4fef-8f61-f9a15d4b566c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txt