tus/1668838995093241856?s=46&t=Mxp_xE-nTL3-YyMqpWx6qg\n検討をお願い致します！", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@muchan_v/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1213708, "client_id": 2556778, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/ea02ee98/uploads/origins/9f5500db-50bc-4fdf-b568-6502f01077f1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=624c6756e54b468163db2d65217c7cf4", "srcset": "https://si.imgix.net/ea02ee98/uploads/origins/9f5500db-50bc-4fdf-b568-6502f01077f1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=624c6756e54b468163db2d65217c7cf4, https://si.imgix.net/ea02ee98/uploads/origins/9f5500db-50bc-4fdf-b568-6502f01077f1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=69bf4447b28724885641e2a391bc1e16 2x, https://si.imgix.net/ea02ee98/uploads/origins/9f5500db-50bc-4fdf-b568-6502f01077f1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=15d58ad674535c241629fe4be1b4ce70 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/ea02ee98/uploads/origins/9f5500db-50bc-4fdf-b568-6502f01077f1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=755f2c35272792a3eb646dd431bb55a7", "srcset": "https://si.imgix.net/ea02ee98/uploads/origins/9f5500db-50bc-4fdf-b568-6502f01077f1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=755f2c35272792a3eb646dd431bb55a7, https://si.imgix.net/ea02ee98/uploads/origins/9f5500db-50bc-4fdf-b568-6502f01077f1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=806a1c7d18bfbe8cf608626d708b5035 2x, https://si.imgix.net/ea02ee98/uploads/origins/9f5500db-50bc-4fdf-b568-6502f01077f1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=5bf0793c33009dddf58638399654528e 3x"}, "body": "むぅ様\n\nSkebでははじめまして。\n主にYoutubeで活動している男性Vtuberの舞藍もこと申します。\n以前量産イラストをご依頼させていただきましたが色々落ち着いてきたので改めてご依頼させていただきます。\n\n【依頼内容】\n以下のツイートにある私を描いていただければと思っております。\nhttps://twitter.com/maiaimoko/status/1577440931845767168\n髪の配色をあわせていただいた上で\nお洋服や髪型、メイク等はむぅ様に全てお任せできればと考えております。\nファイル形式に関しては可能であればpsd形式で頂けますと幸いです。\n\n【使用目的】\n主に生きる糧としてご依頼させていただきました。\nむぅさんの描いてくださった可愛いボクを見てくれ！！！ふはは！！！\n\n【利用範囲】\n以下の範囲で使わせていただければと考えておりますがNGがありましたらその旨頂けますでしょうか。\n・Twitter、Youtubeの配信内、Fanbox等での全体画像の公開\n・YoutubeのサムネイルやTwitter告知等にて一部をトリミングしてテキストとあわせて利用\n・頂いたイラストの一部レイヤー（キャラクターのみ、キャラクターとエフェクトのみ等）を別の背景やテキストとあわせてYoutubeのサムネイルやTwitter告知等にて全体または一部をトリミングしての利用\n・サムネイル等にのせるにあたって全体の統一感を出すためにお色味を調整するようなフィルターの追加。\n参考用：\nhttps://twitter.com/maiaimoko/status/1657671400264732673\n\n以上となります。\nご検討よろしくお願いいたします。", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@muchan_v/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1213708, "client_id": 2105866, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/4a5b53d9/uploads/origins/96d4c7b4-c70f-4ca2-83b2-f09df8fd2f23?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=78ff8a2f1a1095cfa5a4c4812026e635", "srcset": "https://si.imgix.net/4a5b53d9/uploads/origins/96d4c7b4-c70f-4ca2-83b2-f09df8fd2f23?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=78ff8a2f1a1095cfa5a4c4812026e635, https://si.imgix.net/4a5b53d9/uploads/origins/96d4c7b4-c70f-4ca2-83b2-f09df8fd2f23?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=2491f8ac3fc71dbc79813df2c49e7fea 2x, https://si.imgix.net/4a5b53d9/uploads/origins/96d4c7b4-c70f-4ca2-83b2-f09df8fd2f23?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=0e2d0525efb265a6018e3c826f2aab59 3x"}, "duration": null, "nsfw": false, "hardc