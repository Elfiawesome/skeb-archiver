=top&w=200&h=200&blur=200&s=754a44eaa7f3b28e1d2cd993158e14eb", "srcset": "https://si.imgix.net/9971c20e/requests/63790_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=754a44eaa7f3b28e1d2cd993158e14eb, https://si.imgix.net/9971c20e/requests/63790_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=34512ba02ffd8a9aded6fff7f7d6cbba 2x, https://si.imgix.net/9971c20e/requests/63790_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=28ac3d7898314c981145671450ddc289 3x"}, "body": "はじめましてー。新着一覧で大変好みなイラストを拝見しまして、もしごよろしければうちの子をお願いしたく思います\nうちの子資料：https://28.gigafile.nu/0424-cf7fd8d972f26c647a94b56395dcb348\n※衣装が２点ございますがお好みの方でお願いしたいと思います。\n※キャラ立ち絵資料では、胸の方が大変大きくなっておりますが、描く人の許容範囲の大きさでお願いしている感じとなっております。（skeb用は調整していただいて描いていただいたもの。）\n\n今回描いていただける場合、四季おり様のskeb（https://skeb.jp/works/62852）からになりますが、こちらより胸が大きめでお尻も気持ち大きくくらいを可能であればお願いしたく思います。\n\n構図：こちらはおまかせしたいと思いますが、１点だけもしお尻を向ける構図にされる場合は　衣装がお尻に食い込んでいる感じだとうれしいです。\n表情：恥ずかしがっている感じ？頬が赤らめれている感じを希望。\n武器（刀）の有無：こちらもおまかせいたしますが、もし抜刀等される場合のデザインはおまかせします\n\n以上長くなりましたがご対応可能でありましたらお願いします。", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Siki_mim/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 96101, "client_id": 16015, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/cbeb86ff/requests/62852_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a27302ad9567f6e6762b49a1c4bab7fd", "srcset": "https://si.imgix.net/cbeb86ff/requests/62852_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a27302ad9567f6e6762b49a1c4bab7fd, https://si.imgix.net/cbeb86ff/requests/62852_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=525b08819ab5f0b2de40bdcc6590367a 2x, https://si.imgix.net/cbeb86ff/requests/62852_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b01daeea887b74975a53cd5870882562 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/cbeb86ff/requests/62852_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=bb1ac3e2331c9b9ac5e0affe520c4553", "srcset": "https://si.imgix.net/cbeb86ff/requests/62852_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=bb1ac3e2331c9b9ac5e0affe520c4553, https://si.imgix.net/cbeb86ff/requests/62852_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=4839f5fc785b89af84c24668301ddee5 2x, https://si.imgix.net/cbeb86ff/requests/62852_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=9158595be5f3616f6616683d1db96819 3x"}, "body": "自分が描いたこの子を四季おりさんなりにアレンジしていただけませんでしょうか？\nhttps://d.kuku.lu/eaf12ac8f1\nくノ一な子で、手足は色合いを統一した武者鎧風の手甲と脚甲を着けています。\nhttps://t.pimg.jp/044/078/895/1/44078895.jpg\nhttp://www7b.biglobe.ne.jp/~osaru/suneate.jpg\nどこまで描いていただけるかは四季おりさん次第ですが…。\n基本的におっぱい大きく、対魔忍的なむっちりな体つきです。巫女風のニーハイソックスも履かせてあげて下さい。\nかなり前に描いたためアニメチックな髪型ですが、ユエルみたいにストレートヘアーにアレンジしていただくのも良いかなと思っています。\nキャラの雰囲気やカラーリングが元絵を踏襲していれば、ケモミミや尻尾を生やしたり、髪飾りを増やしたりなど四季おりさんの好みをふんだんに取り入れていただけると嬉しいです。\n四季おりさんの可能な範囲でえっちな体つきや衣装デザインにしてあげて下さい。\n性格は無邪気で年齢の割に子供っぽい（実年齢１６歳）ですが、任務は冷徹にこなす子…という雰囲気です。\nよろしくお願いします。ユエソシはいいぞ。", "nc": 160, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 724637, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "夕ウ", "screen_name": "uyuta__", "avatar_url": "https://pbs.twimg.com/profile_images/1474552617405906945/jGNxba3K.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1263268701668663297/1631902863/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by"