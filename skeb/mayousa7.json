89572a5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d6438848b3ecc297a6b580c195b49a78 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/1e80e722/uploads/origins/8cefbcd3-3931-4d81-a8f2-fd7cb89572a5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=caa1d1b49d3735c61081ff1fb55f8caf", "srcset": "https://si.imgix.net/1e80e722/uploads/origins/8cefbcd3-3931-4d81-a8f2-fd7cb89572a5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=caa1d1b49d3735c61081ff1fb55f8caf, https://si.imgix.net/1e80e722/uploads/origins/8cefbcd3-3931-4d81-a8f2-fd7cb89572a5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=9047a55d1f43cc038bef8986d8160b02 2x, https://si.imgix.net/1e80e722/uploads/origins/8cefbcd3-3931-4d81-a8f2-fd7cb89572a5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=053f3c8ac24b1d079d8f8fd43a44aac1 3x"}, "body": "はじめまして！\n絵柄が素敵で気になったのでご依頼しました。\nもしよろしければ、うちのOCの「土御門ノア」をお願いすることは可能でしょうか？ \n参考までに設定は以下のとおりですが、自由に描いていただいて構いません。\n███\n土御門 乃亜（つちみかど のあ）\nベレー帽にウルフショートの少女。\n\n瑠璃の魔法使いの二つ名を持つ。星（力場）と地に干渉する能力を持つ。\n帰国子女で夏休みは海外で過ごす期間の方が長かった。活発な性格で仲間内の精神的な支柱であると同時に、彼女の能力「サタニックリング」は、あらゆる力場を自在に歪める事で敵の攻撃から味方を守ることに長けており、彼女の能力は仲間たちにとっても守りの要だった。\n誰よりも能力の開花が進んでおり、海外渡航中に悪魔からの集中攻撃を単身で受けながらも逆に全滅させている。だがそこで能力を酷使した事でオーバーロードを起こし、帰国途中、飛行機内にて攻撃を受けた際には身を守れずに飛行機と共に墜落した。\n死後は彼女の父親が、彼女に代わって仲間たちのサポートを行っている。\n███\n使用用途は個人活動全般(小説の挿絵等、SNSや個人サイト等でのキャラクター紹介・個人活動の告知等)を考えています。\nもしご都合が合えばよろしくお願いします。\n\nhttps://drive.google.com/file/d/1qdhsdAJp1D_hd2bSXzADoWO7lTqBQiDz/view?usp=drivesdk", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 513978, "creator": true, "nsfw_acceptable": false, "acceptable": false, "name": "倉一ひや", "screen_name": "ohyaarin", "avatar_url": "https://pbs.twimg.com/profile_images