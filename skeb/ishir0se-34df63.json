m=webp&fit=crop&crop=top&w=200&h=200&s=865af21c393468eb05a4eeb05284e39e, https://si.imgix.net/86e3001b/uploads/origins/d791702b-023f-4beb-87ec-ce4cd6f6abb4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=fd762255b5aa1dbdeb59524ddd094c24 2x, https://si.imgix.net/86e3001b/uploads/origins/d791702b-023f-4beb-87ec-ce4cd6f6abb4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=4afd9267b45a3ccf1cacb81852a98eb2 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/86e3001b/uploads/origins/d791702b-023f-4beb-87ec-ce4cd6f6abb4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=374a7ccfaadb7bf22a906dd666b8ee8f", "srcset": "https://si.imgix.net/86e3001b/uploads/origins/d791702b-023f-4beb-87ec-ce4cd6f6abb4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=374a7ccfaadb7bf22a906dd666b8ee8f, https://si.imgix.net/86e3001b/uploads/origins/d791702b-023f-4beb-87ec-ce4cd6f6abb4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=664a149b32aea0a9f8d98ed7d56b3cd3 2x, https://si.imgix.net/86e3001b/uploads/origins/d791702b-023f-4beb-87ec-ce4cd6f6abb4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=acea4997522f58d9d8925ef17c4790d5 3x"}, "body": "skeb\n\nはじめまして！\n個人勢VTuberの水縹そまると申します。\nいしろせ様の素敵なイラストに惹かれ、是非とも依頼させていただきたく、skebの再開を心待ちにしておりました…！\n\n【リクエスト内容】\n私（水縹そまる）のイラストを自由に描いていただけますと幸いです！\n構図、ポーズ等はおまかせいたします。\nもし可能でしたら、イラストに水の要素を入れていただきたく、また、ペットの三郎（三面図の右下あたりにあるゆるキャラ）と戯れている姿を描いていただけますと嬉しいです…！（一匹でも複数匹でも嬉しいです）\n服装、髪型なども全体の雰囲気に合わせて自由に描いていただいて構いません。\n\n設定：水の王国のひきこもり姫\n三面図：https://drive.google.com/file/d/1YWWOuG7kCCPecU1eCtN2EVPLNGaLlBhr/view?usp=drivesdk\n\n※サムネイル等に使用させていただきたいため、頭のてっぺんが見切れないように描いていただけますと幸いです。\n※もし可能でしたら、料金の範囲内で表情差分を何点か描いていただけましたらとても嬉しいです…！\n\n【使用用途】\n・VTuber活動での使用（SNS投稿、サムネイル、歌ってみた、ファンクラブ返礼品 etc.）\n・可能でしたら、グッズ制作への商用利用の可否も教えて頂きたいです。（不可でも全く問題ございません…！）\n※YouTubeチャンネルは収益化済みになります。\n※上記の内容にNGなものが含まれている場合、お手数ですがpsdファイル内のレイヤー等でお伝えいただけますと幸いです。\n\n【納品形式】\nお手数をおかけしますが、キャラクター・背景・宛名等がレイヤー分けされたpsdファイルでいただけますと大変助かります！\n\n可能な範囲で構いませんので、ご検討いただけますと幸いです…！\nお忙しい中大変恐縮ですが、よろしくお願いいたします。", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@ishir0se/works/8", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3113581, "client_id": 3183851, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/86fea4ab/uploads/origins/d5d0dbf6-db96-43ea-b219-ab8f7264ef82?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f5905cb55eb7a7fa69e41528e307e424", "srcset": "https://si.imgix.net/86fea4ab/uploads/origins/d5d0dbf6-db96-43ea-b219-ab8f7264ef82?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f5905cb55eb7a7fa69e41528e307e424, https://si.imgix.net/86fea4ab/uploads/origins/d5d0dbf6-db96-43ea-b219-ab8f7264ef82?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=20f055e2054abce742b4a07d6a347da8 2x, https://si.imgix.net/86fea4ab/uploads/origins/d5d0dbf6-db96-43ea-b219-ab8f7264ef82?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=3f4e6e01e046d73a57d8faa46f3aa258 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/86fea4ab/uploads/origins/d5d0dbf6-db96-43ea-b219-ab8f7264ef82?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=aa3235a5a92c090a78133b6e6e7897e8", "srcset": "https://si.imgix.net/86fea4ab/uploads/origins/d5d0dbf6-db96-43ea-b219-ab8f7264ef82?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=aa3235a5a92c090a78133b6e6e7897e8, https://si.imgix.net/86fea4ab/uploads/origins/d5d0dbf6-db96-43ea-b219-ab8f7264ef82?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w