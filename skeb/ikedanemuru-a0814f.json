7-821b-4e71-9713-5a3eadb6d570?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f098880fef5eafd7426a06691f2f43e6", "srcset": "https://si.imgix.net/3245c984/uploads/origins/aa224577-821b-4e71-9713-5a3eadb6d570?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f098880fef5eafd7426a06691f2f43e6, https://si.imgix.net/3245c984/uploads/origins/aa224577-821b-4e71-9713-5a3eadb6d570?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=b8119a7278d729a75a02374630b58e79 2x, https://si.imgix.net/3245c984/uploads/origins/aa224577-821b-4e71-9713-5a3eadb6d570?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=a360fdd35a570686bf192b43715a0861 3x"}, "body": "よろしければまた青年が赤点撮った罰として子供たちのおもちゃにされるというのをお願いします。\n\n内容は\nイケメンの青年が赤点を取った罰として全裸で足を大きく開いた状態で、両手は上に上げられて縛られて床に寝かされています\nそれをロリとショタに発見され、ロリに乳首を、ショタに股間を弄られて勃起してしまい、そこに興味津々な子供たちが集まってきてしまい…\nというのをお願いします。", "nc": 40, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@ikedanemuru/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 843793, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/163c0ea7/uploads/origins/fd4ce71e-b23d-4744-88cf-a3ffdac13b19?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bbcf0972c7d7c98fab3f00412da3ae3e", "srcset": "https://si.imgix.net/163c0ea7/uploads/origins/fd4ce71e-b23d-4744-88cf-a3ffdac13b19?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bbcf0972c7d7c98fab3f00412da3ae3e, https://si.imgix.net/163c0ea7/uploads/origins/fd4ce71e-b23d-4744-88cf-a3ffdac13b19?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=28a4984d814bda1ce5031557da6e315e 2x, https://si.imgix.net/163c0ea7/uploads/origins/fd4ce71e-b23d-4744-88cf-a3ffdac13b19?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=bcf36145f12502714b247cd6757eb712 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/163c0ea7/uploads/origins/fd4ce71e-b23d-4744-88cf-a3ffdac13b19?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=8ed62795a07503a78954789e82e2a6ab", "srcset": "https://si.imgix.net/163c0ea7/uploads/origins/fd4ce71e-b23d-4744-88cf-a3ffdac13b19?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=8ed62795a07503a78954789e82e2a6ab, https://si.imgix.net/163c0ea7/uploads/origins/fd4ce71e-b23d-4744-88cf-a3ffdac13b19?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=104fa2980f22b5815223334c3015d9a9 2x, https://si.imgix.net/163c0ea7/uploads/origins/fd4ce71e-b23d-4744-88cf-a3ffdac13b19?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=5307be378c3d70b5903e4605d7920dd9 3x"}, "body": "お世話になります。以前ぞうさん踊りのご依頼をしたものです。あの作品があまりにも良すぎたので、またリクエストをお願いしたいです。\n\n内容　全裸でぞうさん踊りをする男女＋先生\n\n登場人物　私が依頼した時のツーサイドの女の子と男の娘、他の人のリク絵のホラー映画で漏らしちゃったお姉ちゃん、リク絵のスカートめくりされてる女の子二人、リク絵の保健室の先生、あとかわいい系の男の子と女の子の計8人でお願いしたいです。\n女の子たちと先生は全員竿あり玉ありのふたなりでお願いします。たくさんのおちんちんを堪能したいので前より全員さらに少し長め大きめでお願いしたいです。\n\n構図など\n枚数は3枚描いて欲しいです。\n\n1枚目\n背景は校舎裏でお願いします。前回のやつのまんまで大丈夫です。\n登場人物は先生を除いて、前回同様全員中学生ぐらいの等身でお願いします。似たような構図で校舎裏に集まっています。\n先生が右側にいる以外はキャラの位置はお任せでお願いします。完全な横向き、後ろ向きはなしでお願いします（2枚目、3枚目も同様です）。\nツーサイドアップの男女は全裸でおちんちんを両手で隠してます。かわいい系の男の子と女の子（誰でも）はパンツを下ろしてるところでおちんちんが少し見えててほしいです。先生は上半身は黒のブラジャー姿で下半身はスカートでお願いします。残りの3人は制服を脱ぎ始めたところでお願いします。\n先生のセリフで「はぁい、みんなお洋服をぬぎぬぎして裸になりましょうね」というセリフはほしいです。その他のメンバー数人のセリフをおまかせでお願いします。（全員分入れたら上が大変なことになりそうなので）\n\n\n2枚目\n全員素っ裸（靴下も靴もなし）になって気持ち良さそうにしてる感じで並んでてほしいです。全員おっぱいも、おちんちんも丸出し丸見えの向きでお願いします。全員フニャチンで下向きでお願いします。\n先生のセリフで「あぁん♡みんなお外ではだかんぼ♡」「みんなおちんちん丸出し♡すっぽんぽん♡」というセリフをお願いします。他数人に「裸」「すっぽんぽん」という言葉を入れたセリフ何個かお願いします。あと先生以外の人にぞうさん踊りをの準備を促すセリフをお願いします。\n\n\n3枚目\n全員おまたにぞうさんを描いてある状態で、思い思いに楽しそうに且つ気持ち良さそうにおちんちんをブラブラ、ふりふりしてる絵をお願いします\nポーズは後ろ向き、横向きは無しで、全員おちんちんがしっかり見えるような体勢でお願いします。\nセリフも「裸でおちんちんフリフリ気持ちいい♡」とか、「ぱおーん♡」とか、そんな感じのセリフをお願いします。表情は全シーンアヘ顔と目閉じは無しでお願いします\n何卒この夢を叶えて頂けませんでしょうか？ご検討よろしくお願いします", "nc": 169, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@ikedanemuru/works/2", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/79a28fa5/uploads/origins/a59897e3-8650-4fec-a3ac-4f385eed6721?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=4e5b72f2aa6f0ec66ea5d6ab3189a439", "srcset": "https://si.imgix.net/79a28fa5/uploads/origins/a59897e3-8650-4fec-a3ac-4f385eed6721?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=4e5b72f2aa6f0ec66ea5d6ab3189a439, https://si.imgix.net/79a28fa5/uploads/origins/a59897e3-8650-4fec-a3ac-4f385eed6721?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=297955969d4b61a42ca802d6ef26c7a7 2x, https://si.imgix.net/79a28fa5/uploads/origins/a59897e3-8650-4fec-a3ac-4f385eed6721?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=d3ab8af809490dc496205cd1548d87d1 3x"}, "private": true, "genre": "art", "tipped": false, "creator_id": 843793, "client_id": 3516141, "nc": 168}, {"path": "/@ikedanemuru/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 843793, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/415dee20/uploads/origins/b86b00fa-1900-4c9d-992d-29fff514b7e4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=61ed6a0d179d05fa390427d04c07af0b", "srcset": 