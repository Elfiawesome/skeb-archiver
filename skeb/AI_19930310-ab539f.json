s=6ce7cb3db7e0063c8c9589f635fc63ea 3x"}, "body": "前回はありがとうございましたっ♪\n## キャンパス\n比率16：9（1920 x 1080以上）　\nできればpsd、最低png\n\n## キャラクター\n前回お願いした６キャラ\n\n## シチュエーション\n### イラスト雰囲気\n今回はこちらのイラストの雰囲気を出していただけますと幸いです。\nhttps://i.imgur.com/kN6DHaF.png\n### シチュエーション\n部隊メン6人の大陸待機場面、次の戦場に空を飛んで移動している雰囲気\nメルファリア大陸と大空を背景に（夕焼けor日中かはラフを見て考えます）", "nc": 161, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@AI_19930310/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 417042, "client_id": 1793066, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/5ce2c333/uploads/origins/a9724f13-1340-4296-b0bc-72b69e04b957?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a5eb1219e4e66a3daee1d3add6855cca", "srcset": "https://si.imgix.net/5ce2c333/uploads/origins/a9724f13-1340-4296-b0bc-72b69e04b957?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a5eb1219e4e66a3daee1d3add6855cca, https://si.imgix.net/5ce2c333/uploads/origins/a9724f13-1340-4296-b0bc-72b69e04b957?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=bb36a589cac06774f0d8aae78e28163f 2x, https://si.imgix.net/5ce2c333/uploads/origins/a9724f13-1340-4296-b0bc-72b69e04b957?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a163ac1bddc8077895a502767a2c39bf 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/5ce2c333/uploads/origins/a9724f13-1340-4296-b0bc-72b69e04b957?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f0d86d0ef34ee589c77c2217422c90bc", "srcset": "https://si.imgix.net/5ce2c333/uploads/origins/a9724f13-1340-4296-b0bc-72b69e04b957?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f0d86d0ef34ee589c77c2217422c90bc, https://si.imgix.net/5ce2c333/uploads/origins/a9724f13-1340-4296-b0bc-72b