ur.com/a/LVsT0TJ）を着せたものにしたいです。ポーズは同じような「咆哮」のポーズになりますが、具体的にはお好きなように変えていただいて構いません。\n\nワンピはあくまで一例です。アダリンダの尻尾と翼をイメージして、緑をメインカラーにオレンジのメッキが入ったワンピを希望します。あまり太りすぎず、翼と尻尾の大きさは本物と同じぐらいがいいです。その他、デザインはお任せします。\n\n値段が許せば、尻尾と羽のぬいぐるみバージョンと、実際の尻尾と羽の位置が違うバージョンの2種類を希望します。\n\nこの度はご依頼いただきありがとうございました。", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@ayatuki_noa_/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1616396, "client_id": 1524117, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/a0f306a2/uploads/origins/9cfbe523-8c9b-4f18-857b-f4315fea63d0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1684ae06145d29f36d8a63fe72f89d92", "srcset": "https://si.imgix.net/a0f306a2/uploads/origins/9cfbe523-8c9b-4f18-857b-f4315fea63d0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1684ae06145d29f36d8a63fe72f89d92, https://si.imgix.net/a0f306a2/uploads/origins/9cfbe523-8c9b-4f18-857b-f4315fea63d0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f67e866941e54564d3a061cac6e125e2 2x, https://si.imgix.net/a0f306a2/uploads/origins/9cfbe523-8c9b-4f18-857b-f4315fea63d0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e4eec8b5c1665f8d602b471ef974f6c3 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/a0f306a2/uploads/origins/9cfbe523-8c9b-4f18-857b-f4315fea63d0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=8ed14255bba912e94c26ebf3b8a1127a", "srcset": "https://si.imgix.net/a0f306a2/uploads/origins/9cfbe523-8c9b-4f18-857b-f4315fea63d0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=8ed14255bba912e94c26ebf3b8a1127a, https://si.imgix.net/a0f306a2/uploads/origins/9cfbe523-8c9b-4f18-857b-f4315fea63d0?bg=%23fff&auto=format%2Ccompres