容］\n　読書をしている沙真愛さんがこちらに気づき、こちらに向けて微笑んでいる様子をお願いいたします。\n服装は資料にもある通常の衣装で、背景は秋の公園のイメージ、そして体型は資料4を参考にしていただけると幸いです。\n［差分］\n　沙真愛さんだけのものと他に、可能であれば資料aの梟もこちらを見ている差分を描いてくださると幸いです。梟は小さく、沙真愛さんの頭にちょこんと居座ってるイメージでお願いいたします。梟のポーズや表情は無くて全く大丈夫ですがお任せいたします。\n［使用用途］\nSNSやYoutube での使用を想定しており、もしそれが大丈夫であれば背景を透過したものも納品してくださると幸いです。\n［最後に］\n沙真愛さんの魅力の一つである太眉や眼鏡は残していただけると幸いです。\n\nそれではよろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/1AFZlXWUNJ7c97rzvqNb47PVnvBmJ89tL?usp=sharing", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@fuwafuwa_ill/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 440540, "client_id": 316943, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/f875c9d0/uploads/origins/1ef05993-d34a-47d5-a75f-15c3339ae374?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=307f395b57b727e06714d1778792ba92", "srcset": "https://si.imgix.net/f875c9d0/uploads/origins/1ef05993-d34a-47d5-a75f-15c3339ae374?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=307f395b57b727e06714d1778792ba92, https://si.imgix.net/f875c9d0/uploads/origins/1ef05993-d34a-47d5-a75f-15c3339ae374?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f4fa69b0583578401a931e466594fb35 2x, https://si.imgix.net/f875c9d0/uploads/origins/1ef05993-d34a-47d5-a75f-15c3339ae374?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e9aa3c1b6dbcd21bf248eee9da6c65f8 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/f875c9d0/uploads/origins/1ef05993-d34a-47d5-a75f-15c3339ae374?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ea82baafa0af09f220616db477b2ea49", "srcset": "https://si.imgix.net/f875c9d0/uploads/origins/1ef05993-d34a-47d5-a75f-15c3339ae374?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&cro