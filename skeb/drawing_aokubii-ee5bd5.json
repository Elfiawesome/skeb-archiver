mat%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c771d44dba88ab8f349b5d910cd8853b, https://si.imgix.net/d0fc668d/uploads/origins/2188b8f5-594c-4712-846e-3c6f06247f50?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=03e7f06489a9f8a524c229243cadbe40 2x, https://si.imgix.net/d0fc668d/uploads/origins/2188b8f5-594c-4712-846e-3c6f06247f50?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=f2a2e90bb0e2010d8d23072600bb9422 3x"}, "body": "お久しぶりです! \n先生の画風がとても好きです。💜\n私のvtuberを描いてください!\n\n[特徴]\nクロワッサンドラゴン\nクロワッサンの角、尻尾\nとても上品で物静かなお姉さんタイプ\n月の要素\n人間の耳はありません\n\n\n[用途]\n個人で使用 (PCの壁紙・印刷して飾る 等)\nSNS\nユーチューブのサムネイル\n\n[キャラ]\n容姿は資料URLよりご参照下さい。\n\n[構図・モチーフ]\nできればキャラクターと背景のレイヤーが分かれている状態でお願いします\nすべてお任せ致します。\n\n本当にありがとうございました！<3\n\nhttps://drive.google.com/drive/u/0/folders/1XjuaTY6ue2Km3i405o6PZLcHDlum9dNC", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@drawing_aokubii/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3405272, "client_id": 3355930, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/bd442ac2/uploads/origins/10de9904-f68f-4836-bbed-717ca0bd34b3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=67dc084ebe01697294dd2d8069662fab", "srcset": "https://si.imgix.net/bd442ac2/uploads/origins/10de9904-f68f-4836-bbed-717ca0bd34b3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=67dc084ebe01697294dd2d8069662fab, https://si.imgix.net/bd442ac2/uploads/origins/10de9904-f68f-4836-bbed-717ca0bd34b3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=36c0494b7cc7be29b9c6547e1720f1ac 2x, https://si.imgix.net/bd442ac2/uploads/origins/10de9904-f68f-4836-bbed-717ca0bd34b3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a4a132db66f7029b68b6452c0cfc31f1 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/bd442ac2/uploads/origins/10de9904-f68f-4836-bbed-717ca0bd34b3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6b3609cfe82db1308fa8729b2e3bfadb", "srcset": "https://si.imgix.net/bd442ac2/uploads/origins/10de9904-f68f-4836-bbed-717ca0bd34b3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6b3609cfe82db1308fa8729b2e3bfadb, https://si.imgix.net/bd442ac2/uploads/origins/10de9904-f68f-4836-bbed-717ca0bd34b3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=c47e57f312cb72dcb1b397e9b95f56cc 2x, https://si.imgix.net/bd442ac2/uploads/origins/10de9904-f68f-4836-bbed-717ca0bd34b3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=fb6cbb0a2490942bbb4b968d1f1e7ef5 3x"}, "body": "はじめまして！にゃると申します！\n\n以前よりX等で、青頸様のモンハンのアイコン風イラストを拝見していて、\nとても素敵だったのでぜひ私の立ち絵でも描いていただきたいと思い、リクエストを送らせていただきました！\n\n表情やポーズなどはお任せいたします！\n\n使用用途はSNSでの投稿・アイコン用、(可能であれば)グッズ利用になります！\n\nコテキャ・イラスト資料以下になります！\n細かいですが、襟足の毛先が薄い紫色になっています🙇\n\nhttps://drive.google.com/drive/folders/1IxVU3N2dDhSYyNeecdu7fDjyBOix3167", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@drawing_aokubii/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3405272, "client_id": 2505951, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/091058d3/uploads/origins/9317c01d-5029-4cd7-9fc1-023ea8805e31?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=47d93419085f64c6d23207e561e661b0", "srcset": "https://si.imgix.net/091058d3/uploads/origins/9317c01d-5029-4cd7-9fc1-023ea8805e31?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=47d93419085f64c6d23207e561e661b0, https://si.imgix.net/091058d3/uploads/origins/9317c01d-5029-4cd7-9fc1-023ea8805e31?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=46b090b98b1854c270838e5c1c9fcdad 2x, https://si.imgix.net/091058d3/uploads/origins/9317c01d-5029-4cd7-9fc1-023ea8805e31?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=452828f9e113c7c5cf4583dab814d3eb 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/091058d3/uploads/origins/9317c01d-5029-4cd7-9fc1-023ea8805e31?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=15892a12b63ef35d3ebc326f45dcbd73", "srcset": "https://si.imgix.net/091058d3/uploads/origins/9317c01d-5029-4cd7-9fc1-023ea8805e31?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=15892a12b63ef35d3ebc326f45dcbd73, https://si.imgix.net/091058d3/uploads/origins/9317c01d-5029-4cd7-9fc1-023ea8805e31?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=2a6894615a012ba9c8d716a27a0c0b17 2x, https://si.imgix.net/091058d3/uploads/origins/9317c01d-5029-4cd7-9fc1-023ea8805e31?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=913037c997695d3cf841790386a5fe62 3x"}, "body": "こんにちは！私のVTuber、ニアンニアンを描いていただけたら嬉しいです！ \n\nニアンニアンは、探検が大好きな元気な女の子です！山に住む獅子舞の踊り子で、いろんないたずらをするのが大好きなんです！『モンスターハンター』風のイラストを希望しています。参考画像はこちらです：https://x.com/drawing_aokubii/status/2026556865702920194/photo/1\n\n\nhttps://drive.google.com/drive/folders/1bgEDeD9x0mjYDo7S85klzc8fZljeKn01?usp=sharing\n\nhttps://drive.google.com/drive/folders/1bgEDeD9x0mjYDo7S85klzc8fZljeKn01?usp=sharing", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@drawing_aokubii/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3405272, "client_id": 3858351, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/2154e3e6/uploads/origins/76bae