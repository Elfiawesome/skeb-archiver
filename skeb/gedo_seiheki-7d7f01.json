=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e425d08dd2b425cd5c2b077fce2d5ee1", "srcset": "https://si.imgix.net/59a5cc7f/uploads/origins/3b946d77-5ab5-4c74-b7d0-052ddc99d3de?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e425d08dd2b425cd5c2b077fce2d5ee1, https://si.imgix.net/59a5cc7f/uploads/origins/3b946d77-5ab5-4c74-b7d0-052ddc99d3de?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ed813154f6babcd4890cf5360de5178a 2x, https://si.imgix.net/59a5cc7f/uploads/origins/3b946d77-5ab5-4c74-b7d0-052ddc99d3de?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f2cdf07695fbc57cc72f5278e62b4de6 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/59a5cc7f/uploads/origins/3b946d77-5ab5-4c74-b7d0-052ddc99d3de?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2fdd11ba838bd1bab76be63a16ffb7ed", "srcset": "https://si.imgix.net/59a5cc7f/uploads/origins/3b946d77-5ab5-4c74-b7d0-052ddc99d3de?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2fdd11ba838bd1bab76be63a16ffb7ed, https://si.imgix.net/59a5cc7f/uploads/origins/3b946d77-5ab5-4c74-b7d0-052ddc99d3de?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=f0ff318b027266fd41e6b39119e0d382 2x, https://si.imgix.net/59a5cc7f/uploads/origins/3b946d77-5ab5-4c74-b7d0-052ddc99d3de?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=7d764f0ee8fe2622c53446473950dfb5 3x"}, "body": "はじめまして、こんにちは。綿菓氏梅と申します。前回リクエストを送らせて頂いた際に丁度タイミングが合わず、あの日再送が叶わなかったことを日々悔やむばかりでしたが、なんとか改めてリクエスト出来るようになりました。\nその間にも多くのシナリオを執筆され、魅力的な世界観で私の心を惹き付けてやまない……非公開依頼であることをいいことに沢山語りたい程にはミツヒロム様のシナリオのファンを(勝手ながら)させていただいています。2022年6月頃に購入した快刀乱魔(、リプロプ、NUMERALS)から一気に沼に落ち、以降BOOTHにあるシナリオは全て購入しています。今年の7月頃頒布を予定されている異端蛇説も非常に楽しみにしております。\n\n前置きが長くなってしまいましたが、本題に移らせていただきます。今回リクエストしたいのは黒須達哉と王旭柊のお2人です。可能ならば作者様本人の考えるプライベートに近いスタイルを見てみたいという欲はありますが、最終的には作者様の描きやすいシチュエーションにお任せしたいです。\nその上でも1つリクエストするのであれば、黒須達哉が喫煙者であるか否かを考え続けてかれこれ4年目のため、それに対する回答をいただくことができるのならばいつかの私も救われる思いです。(ミツヒロム様のpoipikuとミツヒロム様がご依頼された他の方のイラストを閲覧した上で一生頭を抱えている状態です)\n\n私は本当に監察官の2人、特に黒須達哉のことが好きで、自分の快刀乱魔のネタバレアカウントでは大体2人について話しています。そのくらい柊くんには心を射抜かれ、黒須達哉には一目惚れでした。私はミツヒロム様の作られるNPCたちがとにかく大好きなのですが、黒須達哉は人生の推し一覧に並べてしまうほどに見た目も性格もドストライクでした。そんな彼とコンビを組んでいる柊くんに対しても大きな愛を抱えずにはいれませんでした。彼らの、思想は相容れないけれど仕事という一点においては信頼と尊敬がその関係を保たせている、という脆くも簡単には切れることのない関係性が大好きです。リプロプcase3終盤の2人のやり取り\nが人生のサビと言っても過言ではありません。こんな素敵なシナリオを書いてくださって本当にありがとうございます。\n黒須達哉のことを考えると日常生活に支障をきたすため普段は思考の外にやっているのですが、いざ回すとなった時は必ず頭の中に居座っています。そうして快刀乱魔とリプロプと快刀乱魔学園を往復しては悦に浸る日々を繰り返しています。非公開NPC故に周りに気軽に話せないのが苦しいこともありますが、その分この素敵なNPCのおかげで人生に彩りが生まれているのも事実です。本当に、素敵なシナリオとNPCをありがとうございます。\n\n一介のオタクによる長文語りにお付き合いいただきありがとうございます。これからもミツヒロム様の活動を心より応援しております。お体には十分にお気をつけください。", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@3_necoze/works/133", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 40866, "client_id": 1636548, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/2a4fc68d/uploads/origins/5884a4e3-ae07-4084-b179-d53523e96093?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&s=4dd64ae92702d94ef541bc5167e056e2", "srcset": "https://si.imgix.net/2a4fc68d/uploads/origins/5884a4e3-ae07-4084-b179-d53523e96093?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&s=4dd64ae92702d94ef541bc5167e056e2, https://si.imgix.net/2a4fc68d/uploads/origins/5884a4e3-ae07-4084-b179-d53523e96093?bg=%23fff&fm=webp&auto=compress&dpr=2&fit=crop&crop=top&w=200&h=200&s=e3ff653182b7a7cbaceaf8b043be75f0 2x, https://si.imgix.net/2a4fc68d/uploads/origins/5884a4e3-ae07-4084-b179-d53523e96093?bg=%23fff&fm=webp&auto=compress&dpr=3&fit=crop&crop=top&w=200&h=200&s=8c4a977ba873c9aece19daf4919c33ae 3x"}, "duration": null, "nsfw": false, "hardcore": false, "cons