net/12498078/uploads/origins/05335cb1-1260-4e8c-aea9-0a53aa2c6f9c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a0b58acb3f810e199875b6ba4bfb727e, https://si.imgix.net/12498078/uploads/origins/05335cb1-1260-4e8c-aea9-0a53aa2c6f9c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=669c553410857693caaac2ce4ce061aa 2x, https://si.imgix.net/12498078/uploads/origins/05335cb1-1260-4e8c-aea9-0a53aa2c6f9c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=cb707367acbd2d80eaf0f360dbc84a45 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/12498078/uploads/origins/05335cb1-1260-4e8c-aea9-0a53aa2c6f9c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=fd1797a7d6085dea783ae527ba94b67a", "srcset": "https://si.imgix.net/12498078/uploads/origins/05335cb1-1260-4e8c-aea9-0a53aa2c6f9c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=fd1797a7d6085dea783ae527ba94b67a, https://si.imgix.net/12498078/uploads/origins/05335cb1-1260-4e8c-aea9-0a53aa2c6f9c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=9f2ec18ddde0064966a288ddd3ed4042 2x, https://si.imgix.net/12498078/uploads/origins/05335cb1-1260-4e8c-aea9-0a53aa2c6f9c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=0147682c2ff5af9a97075f2585651976 3x"}, "body": "こんにちは、雪村と申します。\nレイヴンズクロフト館における事件奇譚、お疲れ様でした。\n今回のリクエストなのですが、自身がGMを担当したレイクロ館のPCとGMPCの二人を描いて頂けないでしょうか。\n現在のところピクルーで作成した画像しかなく、いつかイラスト化したいなと思っていたのですが、せっかくならシナリオを通過した方にお願いしたいと思い、リクエストをさせて頂きました。\nPLさんからの了解もいただいています。\nキャラシと、ログもお送りしますのでよろしければご参照ください。\n関係性としては、GMPC側からいつも言い寄っては軽く交わされているぐらいの距離感です（それはそれとして仲はいい）\n\n・PC（身長160cmぐらいらしいです）\nhttps://character-sheets.appspot.com/mglg/edit.html?key=ahVzfmNoYXJhY3Rlci1zaGVldHMtbXByFwsSDUNoYXJhY3RlckRhdGEYlKz61QQM\n・GMPC（身長175cmぐらい）\nhttps://character-sheets.appspot.com/mglg/edit.html?key=ahVzfmNoYXJhY3Rlci1zaGVldHMtbXByFwsSDUNoYXJhY3RlckRhdGEYhNPw4AQM\n\n・ログテキスト\nhttps://www.dropbox.com/scl/fi/edbu9ahyz5lyfsn6vjlnx/all.html?rlkey=yb83haxroi0mkzqlke8kerhw4&dl=0", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@sha_oh/works/13", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 598728, "client_id": 3519658, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/a96c2a62/uploads/origins/9d3cc28e-acdf-4943-8935-4563dc549009?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a1c6eacdcc7e956819bf78f952fba48b", "srcset": "https://si.imgix.net/a96c2a62/uploads/origins/9d3cc28e-acdf-4943-8935-4563dc549009?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a1c6eacdcc7e956819bf78f952fba48b, https://si.imgix.net/a96c2a62/uploads/origins/9d3cc28e-acdf-4943-8935-4563dc549009?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=98092ea5642a1f1f6f220026acc60f75 2x, https://si.imgix.net/a96c2a62/uploads/origins/9d3cc28e-acdf-4943-8935-4563dc549009?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=0c2289671bfa7378f7024eb0f0ea5c49 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/a96c2a62/uploads/origins/9d3cc28e-acdf-4943-8935-4563dc549009?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=99bce68f3d1e0b97859f097ddaab8545", "srcset": "https://si.imgix.net/a96c2a62/uploads/origins/9d3cc28e-acdf-4943-8935-4563dc549009?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=99bce68f3d1e0b97859f097ddaab8545, https://si.imgix.net/a96c2a62/uploads/origins/9d3cc28e-acdf-4943-8935-4563dc549009?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=d30d34f7f66130ffe535a0afaa2ef4db 2x, https://si.imgix.net/a96c2a62/uploads/origins/9d3cc28e-acdf-4943-8935-4563dc549009?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=cfeb866f9de2fbdbbc8b1ecb3d72efc3 3x"}, "body": "初めまして、うららと申します。\n以前にみうあおさんのイラストを見て、とてもかわいらしくて素敵だったので今回初めてリクエストさせていただきます。\n\nシノビガミ「空の蒼を知らないキミへ」に参加した自PCを描いていただきたいです。\n名前：ジュリエッタ・サフィア=エトワール・シエラローゼ\n性別：女\n容姿：髪/瞳ともにアイスブルー、髪はハーフアップ部分が編み込みにされており、青い薔薇の髪飾りをつけてます\n　　　あまり表情が変わらないほうのイメージです　体格は小柄、線が細い、薄い\n　　　服装はリンク先画像のようなものを着ているイメージですが、好きなように変更していただいて大丈夫です\n性格：黙っていれば大人しく物静かで、深窓の令嬢風。淡々とした、毅然な態度を崩さないお嬢様\n　　　実際は結構じゃじゃ馬なタイプ\n\n構図・ポーズ、細かい装飾等の部分はお任せでお願いできればと思います。\n以下、参考画像のリンクになります。\nhttps://x.com/ulara008/status/1472131187846316032\n\nどうかご一考いただければと思います。", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@sha_oh/works/12", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 598728, "client_id": 412626, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/175bcad6/uploads/origins/88d3dfa6-ad8b-40d9-9373-c4b3c9bef3a9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=255fbeaa64f13ac9b81fa9b678836a2c", "srcset": "https://si.imgix.net/175bcad6/uploads/origins/88d3dfa6-ad8b-40d9-9373-c4b3c9bef3a9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=255fbeaa64f13ac9b81fa9b678836a2c, https://si.imgix.net/175bcad6/uploads/origins/88d3dfa6-ad8b-40d9-9373-c4b3c9bef3a9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=277ea1fead64a3ae4c5a960ef20604ae 2x, https://si.imgix.net/175bcad6/uploads/origins/88d3dfa6-ad8b-40d9-9373-c4b3c9bef3a9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=88717e39e4385871281b4da827a176ea 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/175bcad6/uploads/origins/88d3dfa6-ad8b-40d9-9373-c4b3c9bef3a9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=7570272d92e226bde2dede63d75cea33", "srcset": "https://si.imgix.net/175bcad6/uploads/origins/88d3dfa6-ad8b-40d9-9373-c4b3c9bef3a9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=7570272d92e226bde2dede63d75cea33, https://si.imgix.net/175bcad6/uploads/origins/88d3dfa6-ad8b-40d9-9373-c4b3c9bef3a9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=38af0399ab9811a6d0db40d12a754698 2x, https://si.imgix.net/175bcad6/uploads/origins/88d3dfa6-ad8b-40d9-9373-c4b3c9bef3a9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=3db6af5fc27db66341df0a4141e0f7b2 3x"}, "body": "いつもお世話になっております。\n私とフォロワーのTRPGのキャラクターのイラストを描いて頂きたいです。(フォロワーからPCの使用許可を得ています)\n構図はお任せします。\nキャラクターの設定は以下の通りです。\n\n・アッシュ\n小柄で中性的な男性。植物画を描くのが好き。\n明るく聡明で、太陽のような性格。\n誰とでも仲良くなれるタイプ。\n読書が好き。身体が弱い。\n\n・ヨナタン(ヨニ)\n背の高い男性。\n男気のある性格で、見た目よりも直情的で子どもっぽいところがある。\n言葉遣いや態度が悪い。ロックを聞くのが趣味。\n\nふたりの共通設定\n・英国出身\n・ふたりは幼馴染\n・1970～80年代のPC\n\n予定している使用用途\n・スマホの待ち受け\n・パソコンの壁紙\n・ミスキー等のSNSでの共有\n・セッションの参加者への共有\n\nご確認のほど、よろしくお願いします。\n\n資料リンク\nhttps://drive.google.com/drive/folders/1MnQEMvqU8V-Qlb9dntEQVw5UTW1vliZ7?usp=drive_link\n\nhttps://takusuki.com/@DDQ/pages/1737817795104", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@sha_oh/works/11", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 598728, "client_id": 355723, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/575f291b/uploads/origins/ec318681-4107-4b8c-9a9a-bcaccedf337f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c1b3779d3a0fefb675d353faea58d406", "srcset": "https://si.imgix.net/575f291b/uploads/origins/ec318681-4107-4b8c-9a9a-bcaccedf337f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c1b3779d3a0fefb675d353faea58d406, https: