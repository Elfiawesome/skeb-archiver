rigins/cfa37a08-60a4-4333-b5dc-5872d2a0bde6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9cd96344b13cbeeae6a414efb8340f20", "srcset": "https://si.imgix.net/7ceb8652/uploads/origins/cfa37a08-60a4-4333-b5dc-5872d2a0bde6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9cd96344b13cbeeae6a414efb8340f20, https://si.imgix.net/7ceb8652/uploads/origins/cfa37a08-60a4-4333-b5dc-5872d2a0bde6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=aeb5e2a2e8e4146aa9fd96c984b73ba0 2x, https://si.imgix.net/7ceb8652/uploads/origins/cfa37a08-60a4-4333-b5dc-5872d2a0bde6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d8b8080522c46f8ee98564c13f620842 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/7ceb8652/uploads/origins/cfa37a08-60a4-4333-b5dc-5872d2a0bde6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=74d865459cde118fea9f0691e18ea607", "srcset": "https://si.imgix.net/7ceb8652/uploads/origins/cfa37a08-60a4-4333-b5dc-5872d2a0bde6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=74d865459cde118fea9f0691e18ea607, https://si.imgix.net/7ceb8652/uploads/origins/cfa37a08-60a4-4333-b5dc-5872d2a0bde6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=095e87b2e56806eda8237fe85e3df24a 2x, https://si.imgix.net/7ceb8652/uploads/origins/cfa37a08-60a4-4333-b5dc-5872d2a0bde6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=8c4ae10be73557c065b1a45415a890a8 3x"}, "body": "Greetings to dear zapi,\nI really appreciated the artwork from my last request!! The texture and atmosphere are both impressive. If this doesn't trouble you, I would like to make another request of my original character. \nThis black-haired girl is rather self-centered and self-indulgent. She came from a broken family and then got pushed around by her relatives. She holds a strong feeling that she never received what other people are granted, which she has to patch up by fair means or foul. She only pretends to be vulnerable and indecisive, whereas in fact, she is indifferent to other people's sufferings since she's more interested in her own struggles. \nOne detail to note is that she has these semicircular red eyeshadow at the end of her eyes. This is a key feature of hers. Please feel free to portray her as innocent or whatever you think would suit her.\nA million thanks in advance!! Please take care in the meantime.\n\nhttps://twitter.com/Fungi_Feast/status/1655345106000519168?s=20", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Ri3Cv/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1954865, "client_id": 2043110, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/f4646b29/uploads/origins/06f9f9ca-c3f8-4b7b-b629-2880f86ab7fb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f9a007b4c7f196c2b78f5a9f1ce8b402", "srcset": "https://si.imgix.net/f4646b29/uploads/origins/06f9f9ca-c3f8-4b7b-b629-2880f86ab7fb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f9a007b4c7f196c2b78f5a9f1ce8b402, https://si.imgix.net/f4646b29/uploads/origins/06f9f9ca-c3f8-4b7b-b629-2880f86ab7fb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c80e8474ec80a9162e100714397e7a3d 2x, https://si.imgix.net/f4646b29/uploads/origins/06f9f9ca-c3f8-4b7b-b629-2880f86ab7fb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=2d8d62e1790306545778e1cc03195f1f 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/f4646b29/uploads/origins/06f9f9ca-c3f8-4b7b-b629-2880f86ab7fb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9631afd703de8f9dfb0e0b5eb74c9063", "srcset": "https://si.imgix.net/f4646b29/uploads/origins/06f9f9ca-c3f8-4b7b-b629-2880f86ab7fb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9631afd703de8f9dfb0e0b5eb74c9063, https://si.imgix.net/f4646b29/uploads/origins/06f9f9ca-c3f8-4b7b-b629-2880f86ab7fb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=73a0c4c8217f5dece9fc10226515445d 2x, https://si.imgix.net/f4646b29/uploads/origins/06f9f9ca-c3f8-4b7b-b629-2880f86ab7fb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=72a476d294b366a281b3182ab04217ef 3x"}, "body": "Greetings to dear zapi,\nThe rich colors and complex atmosphere in your artwork captivated me at first sight, and I would like to invite you to draw my original character if that suits your interest. Her name is Rafaeya Aphelion. She used to be a famous child star under her mother's control and exploitation. Her mother, who had been her manager at the same time, forced her to wear mature clothes and makeup on the stage, then compelled her to work in times of illness. Her impression comes from Swan Lake and the film My Little Princess. She has a gentle yet sometimes delusional nature.\nA million thanks for reading through my request, and please have my warmest regards!!\n\nhttps://twitter.com/seekrain_/status/1620117593054130176?s=46&t=n14-jX_WLGCfB4UyYpMMlw", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Ri3Cv/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1954865, "client_id": 1247194, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/6243031e/uploads/origins/d910fe43-b214-4f49-9438-b7d1571b9425?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d782430536f29a7670e790ee4422fc91", "srcset": "https://si.imgix.net/6243031e/uploads/origins/d910fe43-b214-4f49-9438-b7d1571b9425?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d782430536f29a7670e790ee4422fc91, https://si.imgix.net/6243031e/uploads/origins/d910fe43-b214-4f49-9438-b7d1571b9425?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=34681611a0c98fa8f6207f0f8a1adcb2 2x, https://si.imgix.net/6243031e/uploads/origins/d910fe43-b214-4f49-9438-b7d1571b9425?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=4984dae64c360cde7b78722d87b63edf 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/6243031e/uploads/origins/d910fe43-b214-4f49-9438-b7d1571b9425?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2e015eb6a627673ca4936293cba12c17", "srcset": "https://si.imgix.net/6243031e/uploads/origins/d910fe43-b214-4f49-9438-b7d1571b9425?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2e015eb6a627673ca4936293cba12c17, https://si.imgix.net/6243031e/uploads/origins/d910fe43-b214-4f49-9438-b7d1571b9425?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=8b8961bd8cb770150d89615a50bf7649 2x, https://si.imgix.net/6243031e/uploads/origins/d910fe43-b214-4f49-9438-b7d1571b9425?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=0040df9a2906b9755fb4530515af41c2 3x"}, "body": "Nice to meet you!\nMy name is Colonel Shibaran, a reptilian Vliver, creator and distributor in Japan: ☺️\n\nI would like to contact you to request an illustration!\nI saw your illustrations on Instagram!\nI especially like the dark atmosphere, the absorbing eyes, and the deep paint, and I was hoping to commission an illustration from you someday.\nI would be very happy to work with you!\nHere are the details: 🙇‍♀️\n\nPose, composition, etc.\n1) Exhaustion (Colonel Shibaran's V body)\n▶︎ Slightly sweaty and frightened expression\n▶︎Frontal/waist up\n▶︎ glad if there is a glasses difference\n▶︎ atmosphere darker\nNo specification on ▶︎ pose/background\n\nDesired size, data format, etc.\nSize: 16:9 1920 x 1080 px or larger\nData format: png is preferred (background included/people only)\n\n■Documents and references\n▶︎ depleted: https://twitter.com/shibaran_taisa/status/1612408676408791041?s=46&t=adTI6wSlK0Ycnj2_nTtrEA\nA girl who lives in virtual Japan, she is an energetic, but also mature, chin-tailed bearded lizard.\nShe is 162 cm tall, thin but muscular.\nHer image color is purple.\nHer charm points are the mole on the lower left side of her mouth, her lizard tail, and her purple inner color.\n\nUsage\n(1) Icons/headers for Twitter, discord, etc.\n(2) Thumbnails for distribution (I often play hora-games in particular/I will refrain from using them if they are not allowed to be used in monetized distribution.\n\nhttps://twitter.com/shibaran_taisa/status/1612408676408791041?s=46&t=adTI6wSlK0Ycnj2_nTtrEA", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": []}, "price_history": {"art": [{"amount": 8000, "recorded_at": 1773998811.326473}]}, "custom": {}}