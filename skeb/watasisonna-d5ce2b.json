}, "master_card": {"nsfw": true}, "visa": {"nsfw": true}, "discover": {"nsfw": true}, "american_express": {"nsfw": true}}}, "acceptable_only_public": false, "tip_acceptable": true, "yearly_report_client_visible": false, "total_appeals_count": 0, "received_works": [{"path": "/@watasisonna/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 4118, "client_id": 3456234, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/e37515c0/uploads/origins/c2fafa58-805a-4f22-8b19-635fde7980b0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=08aecc494b08741c5b7bb6db36c80134", "srcset": "https://si.imgix.net/e37515c0/uploads/origins/c2fafa58-805a-4f22-8b19-635fde7980b0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=08aecc494b08741c5b7bb6db36c80134, https://si.imgix.net/e37515c0/uploads/origins/c2fafa58-805a-4f22-8b19-635fde7980b0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=42b6fe807b9ed3bfcc3429962279fbe3 2x, https://si.imgix.net/e37515c0/uploads/origins/c2fafa58-805a-4f22-8b19-635fde7980b0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d8a213c3b7be3dcb5eebd3c9e867abc1 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/e37515c0/uploads/origins/c2fafa58-805a-4f22-8b19-635fde7980b0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=231a2756286b1b5dc6e97b81d88f0a5b", "srcset": "https://si.imgix.net/e37515c0/uploads/origins/c2fafa58-805a-4f22-8b19-635fde7980b0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=231a2756286b1b5dc6e97b81d88f0a5b, https://si.imgix.net/e37515c0/uploads/origins/c2fafa58-805a-4f22-8b19-635fde7980b0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=926a3f479fe9b0a8228f5e03eab041bb 2x, https://si.imgix.net/e37515c0/uploads/origins/c2fafa58-805a-4f22-8b19-635fde7980b0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=f2f208697b49ac499e579fc4f861a851 3x"}, "body": "こんにちは！先日の作品、本当にありがとうございました。エブラナの表情の抑え方がとても上手くて、感情を隠しながらも彼女の本音が少しだけ滲み出ているような繊細な描写に感動しました。支配的な姿勢や構図のセンスも素晴らしく、二人のダイナミクスがしっかり伝わってきました。本当に良い仕事をしていただいたと思っています。\n\n一点だけ修正をお願いしたいことがあります。エブラナとアンタレスの胸の発光が今回の作品では描かれていなかったのですが、これは二人にとってとても重要な特徴なので、修正していただけると嬉しいです。エブラナは紫の光、アンタレスは青白い光です。そして、この発光は体の内側から常に放たれているものなので、服を着ているシーンでも布地を通して外側に滲み出るように描いていただけますでしょうか。たとえばエブラナが黒いクロップトップを着ているシーンでも、胸元に紫の光が布越しにうっすら見えるはずです。アンタレスも同様です。表面的な装飾ではなく、常時発光している内側からの光、というイメージです。\n\nそれから、続きのシーンも追加でリクエストしたいと思います。セックス後のシャワーシーンで、2枚構成です。\n\n【1枚目：ヘアケアのシーン】\nアンタレスがエブラナの後ろに立ち、彼女の膝まで届く長い白髪をゆっくり丁寧に洗っています。エブラナはわずかに頭を後ろへ傾けていて、肩の力が自然に抜けています。彼女にとってはとても珍しいリラックスした姿勢です。エブラナの尻尾はアンタレスの腰か片足に緩やかに巻きついています。アンタレスの表情は穏やかで、ごくわずかに満足げです。腕の良い職人が繊細な作業に向き合うような、静かな自信のある顔つきです。二人とも裸で、湯気の立ち込めるシャワー室にいます。胸の光（エブラナは紫、アンタレスは青白い光）も、前述の通り描いていただけますと幸いです。\n\n【2枚目：キスのシーン】\nアンタレスが主導する形でエブラナとキスしているシーンです。彼がわずかに積極的で、エブラナはそれを受け入れています。ただし完全に受け身というわけではなく、エブラナは片手で彼の首筋か顎を掴み、自分の方へ引き寄せています。身長差があるため、彼女が自然に彼を引き下げる形です。エブラナらしい自然な受け入れ方でお願いします。二人の尻尾はお互いの足や脚に絡み合っています。エブラナの表情は感情を抑えつつも、うっすらと満足げです。シャワーのお湯は引き続き流れています。二人とも裸で、胸の光も引き続きお願いします。\n\n体型や体格については前回と同様にお願いします。両者とも陰毛なし、エブラナのプロポーションも前回に準じてください。\n\nお忙しいところ恐れ入りますが、ご検討いただければ幸いです。引き続きよろしくお願いいたします！\n\nhttps://drive.google.com/drive/folders/1c3wc99X-k7xflWJ6jeH9rJe8Qz158FX9\n\nhttps://drive.google.com/drive/folders/1c3wc99X-k7xflWJ6jeH9rJe8Qz158FX9", "nc": 177, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@watasisonna/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 4118, "client_id": 1931639, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/0d4156f7/uploads/origins/1fec0bce-0ce1-4954-a7cb-e9423c5034c1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=84a0d0a8b9241d875c