webp&fit=crop&crop=top&w=200&h=200&s=3a60496c2032fd0d83ac1fe70a1f3b5f, https://si.imgix.net/f3cd5a74/uploads/origins/0f8db36f-7313-4538-b24d-ec1c03cae40f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=bfffcac681fa4229a86ee081fe5953fb 2x, https://si.imgix.net/f3cd5a74/uploads/origins/0f8db36f-7313-4538-b24d-ec1c03cae40f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=54dfadfa52a7c0ed4b6b9ec6e890f527 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/f3cd5a74/uploads/origins/0f8db36f-7313-4538-b24d-ec1c03cae40f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=4ef00172984a6e1ce6c81260d6bf6b27", "srcset": "https://si.imgix.net/f3cd5a74/uploads/origins/0f8db36f-7313-4538-b24d-ec1c03cae40f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=4ef00172984a6e1ce6c81260d6bf6b27, https://si.imgix.net/f3cd5a74/uploads/origins/0f8db36f-7313-4538-b24d-ec1c03cae40f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=0a08053d5c0832df4cad11327935794a 2x, https://si.imgix.net/f3cd5a74/uploads/origins/0f8db36f-7313-4538-b24d-ec1c03cae40f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=1c42e1e18a22956e9b7b7d09b4f275f1 3x"}, "body": "参考動画（https://twitter.com/Lay_00000/status/1513099022323826688）のマンハッタンカフェっぽい感じの丹波ルンの画像をお願いします。\nポーズはこちら（https://twitter.com/Runba105/status/1513142810920116226）でお願いします。\n\n使用用途としましては、愛でるほか、パーツを切り抜いていろんなポーズをさせてみようと考えております。\n\n\n可能であれば参考動画の角度のほか、真横（右）、真横（左）、真後ろからのアングルのものを書いていただきたいと考えておりますが、可能な範囲でお願いします。\n優先度としましては、\n・正面\n・真横(右)\n・真後ろ\n・真横(左)\nとなっております。\n\n服装は、マンハッタンカフェのもの（https://twitter.com/Runba105/status/1513142810920116226）、\n丹波ルンのもの（https://twitter.com/Runba105/status/1513096156490121216）の2種類をお願いしたいと考えておりますが、可能な範囲でお願いします。\n優先度としましては、\n・丹波ルンのもの\n・マンハッタンカフェのもの\nの順となっております。\n\nまた、切り抜いてポーズをとらせることを想定しているため、問題なければ\n・胴体\n・上腕\n・前腕\n・手\n・首\n・頭（髪の毛を含む）\n・髪の毛\n・太もも\n・ふくらはぎ、脛部分\n・足先（靴履く部分）\nを分割して出力したものをいただけますと幸いです。\n\n\nアングル、服装差分でかなり工数がとられる物とは思いますが、もし余裕がありましたら\n・笑顔差分(参考動画、ポーズの通り)\n・ゴミを見る目差分\n・空条承太郎の表情差分(参考:https://twitter.com/Runba105/status/1513146335339286530）\n\n\nまた、それぞれの目のハイライトなし差分をお願いします。\n\n\n参考\n歩行モーション\nhttps://aniduku.com/2016/08/29/walk/\n\n丹波ルン\nhttps://twitter.com/Runba105/status/1513096156490121216", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@R_BNRITM/works/11", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 809271, "client_id": 772571, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/6b701920/uploads/origins/d0630a23-4d17-4183-b0c0-3fd78fb377ab?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a2809292cc54b82e1979b3d81b6d3ea3", "srcset": "https://si.imgix.net/6b701920/uploads/origins/d0630a23-4d17-4183-b0c0-3fd78fb377ab?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a2809292cc54b82e1979b3d81b6d3ea3, https://si.imgix.net/6b701920/uploads/origins/d0630a23-4d17-4183-b0c0-3fd78fb377ab?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=dea3fe2f60f65c31419d249ad96cf330 2x, https://si.imgix.net/6b701920/uploads/origins/d0630a23-4d17-4183-b0c0-3fd78fb377ab?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=aa94712a35cd07a9b3a6f8c395155f29 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/6b701920/uploads/origins/d0630a23-4d17-4183-b0c0-3fd78fb377ab?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d704ffc1329c022b38721550328d5359", "srcset": "https://si.imgix.net/6b701920/uploads/origins/d0630a23-4d17-4183-b0c0-3fd78fb377ab?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d704ffc1329c0