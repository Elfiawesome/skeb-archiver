ins/28333f0a-7c93-4992-b66f-9017007b9002?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e95cccaa5db8243e39bbebf0c4475174", "srcset": "https://si.imgix.net/1c00f2ea/uploads/origins/28333f0a-7c93-4992-b66f-9017007b9002?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e95cccaa5db8243e39bbebf0c4475174, https://si.imgix.net/1c00f2ea/uploads/origins/28333f0a-7c93-4992-b66f-9017007b9002?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c93beda40860f77a74346c4fe23a9349 2x, https://si.imgix.net/1c00f2ea/uploads/origins/28333f0a-7c93-4992-b66f-9017007b9002?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b2dbe2d18d8018cce791bbfbb6bb4e53 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/1c00f2ea/uploads/origins/28333f0a-7c93-4992-b66f-9017007b9002?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c913b11846083d0266d48fa6fcf84f8f", "srcset": "https://si.imgix.net/1c00f2ea/uploads/origins/28333f0a-7c93-4992-b66f-9017007b9002?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c913b11846083d0266d48fa6fcf84f8f, https://si.imgix.net/1c00f2ea/uploads/origins/28333f0a-7c93-4992-b66f-9017007b9002?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=849f77fdd7b88c4bb5116abbd4f901d2 2x, https://si.imgix.net/1c00f2ea/uploads/origins/28333f0a-7c93-4992-b66f-9017007b9002?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=fca94884f7e25eec3a6762e31f21234b 3x"}, "body": "たきさん、こんにちは！\nたきさんの描かれるロリ巨乳、最高です！！✨\nとてもえっちです！！🥰🥰🥰\nこのたび、たきさんに巨乳なあれぐろもるとのイラストを描いていただけたらと思い、リクエストしました！\n\n■構図・ポーズ\nちょっとロリ寄りなタッチで、かつ、おっぱいは爆盛りで、あれぐろもるとを描いていただきたいです！服は着たままで、いつものドレス（資料をご参照ください）がパッツパツに、おっぱいで引き伸ばされてると嬉しいです！\n\n服の細かいところや、頭のアンテナなど、ディテールに関してはアレンジいただいても全く構いませんので、たきさんの絵のタッチで、楽しく描いていただけたらと思います！\n\n■対象年齢\nR-18\n\n■用途\n次の用途でイラストを使用させていただく場合があります。\n* クレジット表記の上でのSNSでの投稿\n* クレジット表記の上での動画・LIVE配信・サムネへの使用\n※イラストの一部のみトリミングする場合があります\n\n■ファイル形式\n納品いただくファイルの中に、キャラと背景がレイヤー分けされたPSDがあるとありがたいです。\n\n■参考資料\n資料としてMisskey.ioのピン留めを貼らせて頂きました。\nプロフィール欄には、各メディアへのリンクもございますので、必要に応じて参考にしていただければと思います。\n\n以上となります。\nお手数おかけしますがご検討のほどよろしくお願いします！\n\nhttps://misskey.io/@AllegroMoltoV", "nc": 177, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@taki21107458/works/6", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/67ff4586/uploads/origins/baec5f3a-58ff-4ff9-8161-5ecc17c3d576?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=67fc4a4d001851101c0a425a6b60e46e", "srcset": "https://si.imgix.net/67ff4586/uploads/origins/baec5f3a-58ff-4ff9-8161-5ecc17c3d576?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=67fc4a4d001851101c0a425a6b60e46e, https://si.imgix.net/67ff4586/uploads/origins/baec5f3a-58ff-4ff9-8161-5ecc17c3d576?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=29a41b64bdffd7b2d751158668fcece1 2x, https://si.imgix.net/67ff4586/uploads/origins/baec5f3a-58ff-4ff9-8161-5ecc17c3d576?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=80173ed9ee7363f59462ba61fd616df7 3x"}, "private": true, "genre": "art", "tipped": false, "creator_id": 1857749, "client_id": 126961, "nc": 160}, {"path": "/@taki21107458/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1857749, "client_id": 1989569, "vtt_url": null, "thumbnail_image_urls": {"src": "