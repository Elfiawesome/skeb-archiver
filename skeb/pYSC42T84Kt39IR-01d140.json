n・かなり強烈な選民思想の持ち主\n・下等民族の男という男の精液を搾り尽くし、\n自民族とのハーフを自分が産みまくる事で民族浄化しようと本気で考えている\n・その結果産まれたハーフの子供たちを引き取り愛情深く育てているが、\n彼らも犯してさらに下等民族の血を薄めようと目論んでもおり、\nその成長を楽しみにしている\n・それはそれとして普通に敵軍と戦闘したりもする\n\n●見たいシーン\nショタを逆レイプして膣内精通させている所をお願いします！！", "nc": 41, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 3392, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "たぢまよしかづ🐸姫様、ご乱心！（ヤンチャンWEB ）湯ハー(がうがう)W連載中🐸Skeb歓迎", "screen_name": "taditadi", "avatar_url": "https://pbs.twimg.com/profile_images/1486391331689615361/RbMuPUNd.jpg", "header_url": "https://pbs.twimg.com/profile_banners/135971717/1655877745/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 7, "complete_expiration_days": 60, "skills": [{"genre": "art"}, {"genre": "novel"}], "banned": false, "nc": 177}, {"id": 3669, "creator": true, "nsfw_acceptable": true, "acceptable": false, "name": "かみやんみょん Illustrator", "screen_name": "New_kamiyan", "avatar_url": "https://pbs.twimg.com/profile_images/1899781772055138304/0dTqq4J9.jpg", "header_url": "https://pbs.twimg.com/profile_banners/282966316/1738150568/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 120, "skills": [{"genre": "art"}], "banned": false, "nc": 161}, {"id": 1001880, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "タイショー🔞🎨", "screen_name": "ZuizuiDaison", "avatar_url": "https://pbs.twimg.com/profile_images/1591958080371277829/mZnlXz14.jpg", "header_url": "https://pbs.twimg.com/profile_banners/4380506833/1681201463/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank"