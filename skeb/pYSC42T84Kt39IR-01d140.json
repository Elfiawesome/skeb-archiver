民族の血を薄めようと目論んでもおり、\nその成長を楽しみにしている\n・それはそれとして普通に敵軍と戦闘したりもする\n\n●見たいシーン\nショタを逆レイプして膣内精通させている所をお願いします！！", "nc": 169, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 95657, "creator": true, "nsfw_acceptable": true, "acceptable": false, "name": "七紳士＠新刊委託中", "screen_name": "7_shinshi", "avatar_url": "https://pbs.twimg.com/profile_images/1469884105978368004/O9h7-KFD.jpg", "header_url": null, "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 7, "complete_expiration_days": 45, "skills": [{"genre": "art"}], "banned": false, "nc": 176}, {"id": 531646, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "らがー🔞", "screen_name": "Twi2Ryu", "avatar_url": "https://pbs.twimg.com/profile_images/1838917972116873216/7A3ArHt-.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1216710695137333250/1766923386/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 7, "complete_expiration_days": 60, "skills": [{"genre": "art"}, {"genre": "comic"}], "banned": false, "nc": 33}, {"id": 795562, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "杢　臓", "screen_name": "z_mokuzou", "avatar_url": "https://pbs.twimg.com/profile_images/586521329085493249/FB47ZQLJ.jpg", "header_url": "https://pbs.twimg.com/profile_banners/128888085/1425234240/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "art"}], "banned": false, "nc": 161}, {"id": 1126028, "creator": true, "nsfw_acceptable": true, "accepta