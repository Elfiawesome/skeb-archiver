f1bf-49bb-4c42-a1dc-1b294bb2d566?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e940185de59892b24309094768f17e79, https://si.imgix.net/ae5cf346/uploads/origins/0392f1bf-49bb-4c42-a1dc-1b294bb2d566?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=6943e99241b13739731fbb82ad19172a 2x, https://si.imgix.net/ae5cf346/uploads/origins/0392f1bf-49bb-4c42-a1dc-1b294bb2d566?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=159f3af952fafe7a7e66d7e54b778f79 3x"}, "body": "アピールありがとうございます。\n遅ればせながらリクエストさせていただきます。\n\n依頼内容ですが、おまかせでソプルくんを描いていただきたいと思います。\nシチュとか服装とか、すべておまかせでお願いいたします。\nシャボン玉から生まれたという設定なので、シャボン玉を絡めたイラストにしていただけると幸いです。\n\nソプルくんは紫色の右目と緑色の左目を持つ水色のセミロングヘアの男の娘です。壮大な魔力により、シャボン玉が変形して生まれたため、全身が瑞々しく肌は少し白い。普段は水色のハーフパンツに白いTシャツ、家から出る時は犬耳犬尻尾付きの光の当たり具合で所々が虹色に輝く白い撥水レインコートとレインブーツを着用している。元シャボン玉ということもあり、暑さも寒さも全く感じないため、季節に関係なくこの姿でいることが多い。紫色の右目には、異性を魅了する力があるため、普段は前髪で隠している。ちなみに、傘が好きで色んな傘を集めているらしい。詳細は資料URLやskebの送信したリクエストを参考にしていただければ幸いです。\n\nあと、宛名については、ゆゆにゃんへ、とさん付けなしでお願いいたします。\n\nご検討のほど、よろしくお願いいたします。\n\nhttps://www.pixiv.net/artworks/123502936", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@sumine_toka_2/works/8", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3525596, "client_id": 2973566, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/385aba8b/uploads/origins/bc50115e-dc86-478c-a9c8-25a619f53878?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6a3467b86b9731c81485a4233aa33285", "srcset": "https://si.imgix.net/385aba8b/uploads/origins/bc50115e-dc86-478c-a9c8-25a619f53878?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6a3467b86b9731c81485a4233aa33285, https://si.imgix.net/385aba8b/uploads/origins/bc50115e-dc86-478c-a9c8-25a619f53878?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=20