274035\n\nより具体的な情報は\nhttps://drive.google.com/drive/folders/1MGw6BFf6x70k7naIFGwOGCd1Psq2eQpd?usp=sharing\n\nできれば、キャラクターの服装の違いや、過去と現在のイメージの違いも描けるようになりたいです。\n\n[服装1】二人分の作業服です。\n\n\nアイデアは先生にお任せします！自由に描いてください！先生のキャラクター解釈を楽しみにしています。\n\nもし先生がデッサンのスケッチや初稿を残していたら、大歓迎ですし、ぜひ見てみたいです。\n\n量が足りない場合は、再送を申し出ていただければ、喜んで再送いたします。\n\nhttps://drive.google.com/drive/folders/1MGw6BFf6x70k7naIFGwOGCd1Psq2eQpd?usp=sharing", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@vvrivering/works/6", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/37ba9edc/uploads/origins/6cdfe74c-876c-478c-a4a8-0acaa0cb8a82?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=6e681f90a73c957b422dbef0380008f5", "srcset": "https://si.imgix.net/37ba9edc/uploads/origins/6cdfe74c-876c-478c-a4a8-0acaa0cb8a82?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=6e681f90a73c957b422dbef0380008f5, https://si.imgix.net/37ba9edc/uploads/origins/6cdfe74c-876c-478c-a4a8-0acaa0cb8a82?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=a80608f4e5e3bcea3ab684e1b8e290cb 2x, https://si.imgix.net/37ba9edc/uploads/origins/6cdfe74c-876c-478c-a4a8-0acaa0cb8a82?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=8a7f410c44283b2351f04e846ec053ea 3x"}, "private": true, "genre": "comic", "tipped": false, "creator_id": 3165351, "client_id": 3138989, "nc": 17}, {"path": "/@vvrivering/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3165351, "client_id": 72