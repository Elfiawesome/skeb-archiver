, https://si.imgix.net/068bcd71/uploads/origins/42f223d9-dcfe-4ecc-9949-40c9b084b7e9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=84294950c2a117a0abd096471dc98bca 2x, https://si.imgix.net/068bcd71/uploads/origins/42f223d9-dcfe-4ecc-9949-40c9b084b7e9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=79c312fed123f667d648aa77cc64d28d 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/068bcd71/uploads/origins/42f223d9-dcfe-4ecc-9949-40c9b084b7e9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5483f54640429c2c9cb63a15f5ed5c88", "srcset": "https://si.imgix.net/068bcd71/uploads/origins/42f223d9-dcfe-4ecc-9949-40c9b084b7e9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5483f54640429c2c9cb63a15f5ed5c88, https://si.imgix.net/068bcd71/uploads/origins/42f223d9-dcfe-4ecc-9949-40c9b084b7e9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=9c5a4780687279ba6b3728a4036045dd 2x, https://si.imgix.net/068bcd71/uploads/origins/42f223d9-dcfe-4ecc-9949-40c9b084b7e9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=484e0bf96f7cb5bc679f7668497f2ef7 3x"}, "body": "ろーずがーでなさん、こんばんは。\n\n前回のリクエストの際は、温かさと愛にあふれた\n藍しゃまのギフトイラストをありがとうございました！\n\nリクエストですが、ワインの製造工程でかつて行われていた、\n大きな桶に入れたブドウを\n足で踏んでつぶすブドウ踏みから、\n\nスカートを持ちあげて、ブドウ踏みをしている\n萃香ちゃんでお願いしたいです！\n\n構図や背景、衣装など、細かいところは\nろーずがーでなさんにお任せいたします。\n\nまた、イラストはろーずがーでなさんのペースで、\nゆっくり描いていただいて大丈夫です。\n\n特殊なシチュエーションで大変申し訳ないのですが、\n受けていただけたら、とても嬉しいです！\n\n何卒よろしくお願いいたします。", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@ikatyusya/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2283809, "client_id": 2473156, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/27e35447/uploads/origins/fd07eedb-3ff4-427e-834b-c64ca3febeda?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1c7b6f67a3017ef9099604e9572559a1", "srcset": "https://si.imgix.net/27e35447/uploads/origins/fd07eedb-3ff4-427e-834b-c64ca3febeda?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1c7b6f67a3017ef9099604e9572559a1, https://si.imgix.net/27e35447/uploads/origins/fd07eedb-3ff4-427e-834b-c64ca3febeda?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a5a619379c17bcef53b3177b93b2fce4 2x, https://si.imgix.net/27e35447/uploads/origins/fd07eedb-3ff4-427e-834b-c64ca3febeda?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ab1a98c460325807a770848ad78518a8 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/27e35447/uploads/origins/fd07eedb-3ff4-427e-834b-c64ca3febeda?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5578e5ef97b6c64986d5331015f6e63c", "srcset": "https://si.imgix.net/27e35447/uploads/origins/fd07eedb-3ff4-427e-834b-c64ca3febeda?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5578e5ef97b6c64986d5331015f6e63c, https://si.imgix.net/27e35447/uploads/origins/fd07eedb-3ff4-427e-834b-c64ca3febeda?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=fb56b953d0b4db78ec4655d27353f740 2x, https://si.imgix.net/27e35447/uploads/origins/fd07eedb-3ff4-427e-834b-c64ca3febeda?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=78649f3a1a92845a338997abbc2e2100 3x"}, "body": "ろーずがーでなさん、こんばんは。\n\n萃香ちゃんをはじめ、ろーずがーでなさんの可愛くて、\n温かみのあるイラストに癒しをもらっています・・！\nいつもありがとうございます(*´∀｀)\n\nリクエストですが、萃香ちゃんでなくて申し訳ないのですが、\n東方Projectから、八雲藍が\n花束やプレゼントで、お誕生日をお祝いしてくれている\nシチュエーションでお願いしたいです。\nTwitterでお世話になっている方が、\n藍しゃま好きで、その方に、\n喜んでいただきたくて・・\n\nリクエストを受けていただけたらの話ですが、\n描いていただいたイラストを、その方のお誕生日(8/8)に\nお誕生日のプレゼントとして、お渡しできたらと考えております。\n\nそのため、「しゃけさん、お誕生日おめでとうございます！」や\n「しゃけさん、はっぴーばーすでー！」といった\nお誕生日のお祝いメッセージの入った差分も、\n用意していただけたら大変助かります・・\n\nまたです差分イラストのプレゼントの許可についても、\n併せて承認していただけると嬉しいです。\n\n構図や背景など、細かいところは\nろーずがーでなさんにお任せいたします。\n\n長くなってしまった上に、注文も多くて済みませんが、\n何卒よろしくお願いいたします。", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 34718, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "モロコシ@お仕事募集中", "screen_name": "silver_corn", "avatar_url": "https://pbs.twimg.com/profile_images/1203531615005106176/a94zB1QU.png", "header_url": "https://pbs.twimg.com/profile_banners/2888441072/1709314447/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "art"}, {"genre": "correction"}], "nc": 49}, {"id": 450175, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "知香🫖", "screen_name": "x_CHIKA_xx", "avatar_url": "https://pbs.twimg.com/profile_images/1984300336627269637/TRW7HzDZ.jpg", "header_url": "https://pbs.twimg.com/profile_banners/163476609/1772743924/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 6, "complete_expiration_days": 30, "skills": [{"genre": "art"}, {"genre": "comic"}], "nc": 144}, {"id": 575178, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "かめっこ🕊", "screen_name": "mofumofukame", "avatar_url": "https://pbs.twimg.com/profile_images/1678957802335903745/4pF2pz6r.jpg", "header_url": "https://pbs.twimg.com/profile_banners/537052756/1707903967/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at":