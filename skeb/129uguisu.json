メリカンダイナー的なワンピースにしてもらえたら嬉しいです。\nそれ以外は、服自体のドットやストライプ等の柄・靴・その他装飾など含めてお任せします。\n私が眺めてムフフと喜ぶほかに、もし、もし可能でしたらいただいたイラストで個人用のアクスタなど作成したいと思っています…！\n\nskebでのリクエストが初めてで、わかりにくい箇所や何か失礼がありましたら申し訳ございません。。。\nどうぞよろしくお願いいたします！\n\nhttps://dromp.rdy.jp/viewer/?file=main.html#sp", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@129uguisu/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1300735, "client_id": 2102369, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/9dc09b70/uploads/origins/16afe9e0-db23-4cea-94ae-fb5fd7651f3f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6c44203de26195071651c10f7ee218d8", "srcset": "https://si.imgix.net/9dc09b70/uploads/origins/16afe9e0-db23-4cea-94ae-fb5fd7651f3f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6c44203de26195071651c10f7ee218d8, https://si.imgix.net/9dc09b70/uploads/origins/16afe9e0-db23-4cea-94ae-fb5fd7651f3f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e8a251094dbf44e300d5dccbe1093b68 2x, https://si.imgix.net/9dc09b70/uploads/origins/16afe9e0-db23-4cea-94ae-fb5fd7651f3f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=026bc4c21eb47069f4e6a4a96c66485a 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/9dc09b70/uploads/origins/16afe9e0-db23-4cea-94ae-fb5fd7651f3f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b20dfce85795f2d9a4ca02f385550dbd", "srcset": "https://si.imgix.net/9dc09b70/uploads/origins/16afe9e0-db23-4cea-94ae-fb5fd7651f3f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b20dfce85795f2d9a4ca02f385550dbd, https://si.imgix.net/9dc09b70/uploads/origins/16afe9e0-db23-4cea-94ae-fb5fd7651f3f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&