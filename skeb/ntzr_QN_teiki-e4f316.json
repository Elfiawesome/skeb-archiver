モノクルを着用した青い目\n・白いローブとスカート、青いシャツ\n一人称/二人称：我輩/あなた　メルキスへの呼び方：先輩\n性格\n・快活で正義感が強く、後衛職の癖に中衛くらいの位置にいがち\n・一方で読書が好きで、思索に耽ることもままある\n・メルキスよりもスキンシップに躊躇いがなく、興味が向けば(あと一応相手が許せば)遠慮なくハグとかボディタッチもする\n・「〜であります！」というような、若干大仰な軍人口調が特徴", "nc": 160, "word_count": 10119, "transcoder": "text", "creator_acceptable_same_genre": true}, {"path": "/@ntzr_QN_teiki/works/13", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/7904cd12/uploads/origins/6d1b8331-c407-4223-99c4-50bdef7a1f6d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=85dea4da96aa0f8e4449f17739d22ce8", "srcset": "https://si.imgix.net/7904cd12/uploads/origins/6d1b8331-c407-4223-99c4-50bdef7a1f6d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=85dea4da96aa0f8e4449f17739d22ce8, https://si.imgix.net/7904cd12/uploads/origins/6d1b8331-c407-4223-99c4-50bdef7a1f6d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=ce3989902e465ac2ad5bb2974d48420f 2x, https://si.imgix.net/7904cd12/uploads/origins/6d1b8331-c407-4223-99c4-50bdef7a1f6d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=d719e1a2e5b30d011d447442edeae37b 3x"}, "private": true, "genre": "novel", "tipped": true, "creator_id": 3721763, "client_id": 872422, "nc": 178}, {"path": "/@ntzr_QN_teiki/works/12", "private_thumbnail_image_urls": null, "private": false, "genre": "novel", "tipped": false, "creator_id": 3721763, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/a1f89a6a/uploads/origins/bf2b6e38-62c6-4bcf-aa05-946501728f6b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w