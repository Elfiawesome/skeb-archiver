9aea2/uploads/origins/80c5817d-920b-4fc6-a1e4-6a3be41ddfe1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=d1211af8ad938126900127821bad9532 2x, https://si.imgix.net/f8b9aea2/uploads/origins/80c5817d-920b-4fc6-a1e4-6a3be41ddfe1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=deeb940cbdbe7d6d8142b0bf8d7debc1 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/f8b9aea2/uploads/origins/80c5817d-920b-4fc6-a1e4-6a3be41ddfe1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=eff866d33fb73cd4a415ddf512a18daa", "srcset": "https://si.imgix.net/f8b9aea2/uploads/origins/80c5817d-920b-4fc6-a1e4-6a3be41ddfe1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=eff866d33fb73cd4a415ddf512a18daa, https://si.imgix.net/f8b9aea2/uploads/origins/80c5817d-920b-4fc6-a1e4-6a3be41ddfe1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=a425eea015bcf45ccf543fc1f8909486 2x, https://si.imgix.net/f8b9aea2/uploads/origins/80c5817d-920b-4fc6-a1e4-6a3be41ddfe1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=f29548a297f170047f4ba54912ec0a44 3x"}, "body": "先日は素晴らしい作品を、ありがとうございました。\n\n今回は「立凪レッカが、フェラ手コキで搾精している」作品をリクエストします。\n前回お願いした作品の続きのイメージですが、あくまでイメージですので、直接の繋がりはなくても大丈夫です。 \n\n投稿されていた作品の中で、イメージに近い作品を添付しますが、同じである必要はありません。参考になれば幸いです。\n\n状況\n・負けたレッカへリベンジ\n・挑戦者に勝ち目なし(女性優位)\n・楽しんでいるレッカ\n・挑戦者は前回より弱くなっている\n・騎乗位などの本番をするまでもなく、手や口の刺激に全く耐えられていない\n・何度目かの射精\n\n構図\n・フェラまたはチンキス(竿の先を舐める様子)\n・手コキなど、手でも竿や玉を刺激している\n・へそ(お腹)チラ\n・がに股\n・腰を動かして誘惑する様子\n・描写が難しい場合は上記のいずれかのみや、無しでも大丈夫です。\n\n服装\n・原作アニメに出てきた制服\n・パンツの有無はお任せしますが、スカートは見たいです。\n\n体型\n・原作準拠 \n・大きく外れていなければ、描きやすいように多少の変更は大丈夫です。\n\n台詞\n・一人称はレッカちゃん\n・射精への言及\n・「負けたくて来たの？」「負け癖付いてない？」的な、弱過ぎることへの言及\n・「メロメロ」を使用した、快楽に抗えない様子への煽り \n・「レッカちゃん好き好き」的な、レッカの虜になって射精を続けている竿(身体)の心情を代弁するような煽り\n・敗北や射精への誘惑/煽り\n・更に弱くするつもりである様子 \n・搾精を続け、更に快楽に嵌めようとする意思表示\n\nその他\n・状況に合わせた擬音\n・擬音や台詞の語尾にハート\n・顔や身体、服に付いた体液\n\nまた可能であれば、上記の状況を現在として、前(前回の勝負で「メロメロ」になったことを思い出させるような再挑戦への煽り)や後(何度も搾精したことが分かる描写や、次の勝負と敗北を連想させるような台詞など)の差分があると嬉しいです。 \nこちらは可能であればですので、当然ながらリクエストした一枚だけでも大丈夫です。\n\n重ねてのお願いとなりますが、スマホで見ることも多いので、psd以外の見やすいファイルがあるとありがたいです。\nもちろん、こちらも可能であればで大丈夫です。\n\n以上となります。\nよろしくお願いします。\n\nhttps://www.pixiv.net/artworks/129564614", "nc": 168, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@hirakiazino2/works/11", "private_thumbnail_image_urls": null, "private": false, "genre": "comic", "tipped": true, "creator_id": 3768924, "client_id": 2015417, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/caa379c3/uploads/origins/342fa28a-0975-4ee5-8aed-487c56b6c5de?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ee723c61aad9366fa72f442e3d5cf445", "srcset": "https://si.imgix.net/caa379c3/uploads/origins/342fa28a-0975-4ee5-8aed-487c56b6c5de?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ee723c61aad9366fa72f442e3d5cf445, https://si.imgix.net/caa379c3/uploads/origins/342fa28a-0975-4ee5-8aed-487c56b6c5de?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c7baeb4de46d88687b0bbf4ef06c9ea2 2x, https://si.imgix.net/caa379c3/uploads/origins/342fa28a-0975-4ee5-8aed-487c56b6c5de?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ac312de6c5b5171b7a41bc4b84bd463d 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/caa379c3/uploads/origins/342fa28a-0975-4ee5-8aed-487c56b6c5de?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6b5a039a53b437e3df7fc4b574ce9104", "srcset": "https://si.imgix.net/caa379c3/uploads/origins/342fa28a-0975-4ee5-8aed-487c56b6c5de?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6b5a039a53b437e3df7fc4b574ce9104, https://si.imgix.net/caa379c3/uploads/origins/342fa28a-0975-4ee5-8aed-487c56b6c5de?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=a64ebbed759d77ff0d92c752a613e0fd 2x, https://si.imgix.net/caa379c3/uploads/origins/342fa28a-0975-4ee5-8aed-487c56b6c5de?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=beeb41a2918f1d14526cea6890fa32d2 3x"}, "body": "初めまして、Xなどに投稿されている素敵な作品を見て送らせていただきました。\n\n「カードファイトヴァンガードの立凪レッカが、騎乗位で搾精している」作品をリクエストします。\n\n状況\n・SEX勝負的なシチュエーション\n・着衣での騎乗位\n・楽しんでいるレッカ\n・挑戦者に勝ち目なし(女性優位)\n・股から溢れるほど射精している(何度目かの射精)\n\n表情\n・勝負を楽しんでいる\n\n服装\n・原作アニメに出てきた制服\n・パンツの有無はお任せしますが、スカートは見たいです。\n\n構図について\n・素振りフェラ\n・へそ(お腹)チラ\n・脇\n・腰を使っている様子(ぐりぐりなど)\n・描写が難しい場合は上記のいずれかのみや、無しでも大丈夫です。\n\n体型\n・原作準拠\n・大きく外れていなければ、描きやすいように多少の変更は大丈夫です。\n\n台詞\n・一人称はレッカ、またはレッカちゃん　\n・射精への言及\n・勝負のはずなのに快楽に抗えない身体(竿など)に対して「～はメロメロみたいだけど？」的な、「メロメロ」を使用した煽り\n・敗北や射精への誘惑/煽り\n・搾精を続ける、更に快楽に嵌めようとする意思表示\n\nその他\n・状況に合わせた擬音\n・擬音や台詞の語尾にハート\n\nまた可能であれば、上記の状況を現在として、前(射精を耐えているのを煽りながら、本気を出してトドメを刺そうとしている様子)や後(何度も搾精したことが分かる描写や、次の勝負の機会を期待させるような台詞など)の差分があると嬉しいです。\nこちらは可能であればですので、当然ながらリクエストした一枚だけでも大丈夫です。\n\n重ねてのお願いとなりますが、スマホで見ることも多いので、psd以外の見やすいファイルがあるとありがたいです。\nもちろん、こちらも可能であればで大丈夫です。\n\n以上となります。\nよろしくお願いします。", "nc": 169, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@hirakiazino2/works/10", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3768924, "client_id": 109067, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/1bc470fc/uploads/origins/c6e2e1f4-187c-4a21-9fee-ab3fdb95b0be?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=edd111dd5675f056cff3ef25671e6e6d", "srcset": "https://si.imgix.net/1bc470fc/uploads/origins/c6e2e1f4-187c-4a21-9fee-ab3fdb95b0be?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=edd111dd5675f056cff3ef25671e6e6d, https://si.imgix.net/1bc470fc/uploads/origins/c6e2e1f4-187c-4a2