n.discordapp.com/attachments/1078509423003193407/1111054242464157716/98556830_p0_master1200.png\n\n3. https://cdn.discordapp.com/attachments/1078509423003193407/1111054424882815097/97896893_p0_master1200.png\n\n4. https://cdn.discordapp.com/attachments/1078509423003193407/1111054241176506438/95426818_p0_master1200.png\n\nあなたが彼女のためにどんな服を作ってくれるのか、とても楽しみです。\n\nこの度は本当にありがとうございました！もしご希望額が少ないと感じられるようでしたら、ご遠慮なく適正と思われる額をアピールしてください！", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@fugasioisiiyo/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2906534, "client_id": 1883320, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/c0ba8350/uploads/origins/0b10aab0-3412-4aaa-8d20-fd5cd5df9f75?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=471e77ab89d95a5eb33a09e6532410ea", "srcset": "https://si.imgix.net/c0ba8350/uploads/origins/0b10aab0-3412-4aaa-8d20-fd5cd5df9f75?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=471e77ab89d95a5eb33a09e6532410ea, https://si.imgix.net/c0ba8350/uploads/origins/0b10aab0-3412-4aaa-8d20-fd5cd5df9f75?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=3a61030510c9f92a02a20757e956de85 2x, https://si.imgix.net/c0ba8350/uploads/origins/0b10aab0-3412-4aaa-8d20-fd5cd5df9f75?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=11a3663f74d3c8ac244fd10f09386cf0 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/c0ba8350/uploads/origins/0b10aab0-3412-4aaa-8d20-fd5cd5df9f75?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d03ed8ea568eef1121a003807cf6c2e7", "srcset": "https://si.imgix.net/c0ba8350/uploads/origins/0b10aab0-3412-4aaa-8d20-fd5cd5df9f75?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&