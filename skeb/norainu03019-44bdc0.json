を愛でている姿。\n\nただただウサギ(ネザーランド・ドワーフ)が大好きなのと、昔話のアフターストーリーの様でおもしろいかなぁと思って依頼させていただきました。\n\nあまり詳細なリクエストになっておらず申し訳ないですが、何卒宜しくお願い致します。", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@norainu03019/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 145966, "client_id": 405563, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/3d0967f2/requests/77199_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=45cac064d38c86e6f7efbe21f7677d2a", "srcset": "https://si.imgix.net/3d0967f2/requests/77199_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=45cac064d38c86e6f7efbe21f7677d2a, https://si.imgix.net/3d0967f2/requests/77199_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=0e1baea597fbcbf98bdef61779649362 2x, https://si.imgix.net/3d0967f2/requests/77199_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=61b62307e2925b8641c9050c16a61135 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/3d0967f2/requests/77199_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9b4235f117bbaee23c9369c66e61d50d", "srcset": "https://si.imgix.net/3d0967f2/requests/77199_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9b4235f117bbaee23c9369c66e61d50d, https://si.imgix.net/3d0967f2/requests/77199_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=48d32d5c818f95233db1a6885a926373 2x, https://si.imgix.net/3d0967f2/requests/77199_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=195608428e864b4c2c2847b31b8f4620 3x"}, "body": "こんにちは、ヤギと申します。\nいつも野良いぬさんの作品から元気を貰って、幸せになる日々を送っています。\n\n今回、昨年の似顔絵イベントで描いて頂いたイラストのヤギ（僕ではなく動物の、アイコンの左下の子です。わかりづらくてすみません・・・）の擬人化イラストを依頼したく、リクエストさせて頂きました。\n私事で恐縮ですが、描いて頂いたイラストを本当に本当に気に入っていて、似顔絵はもちろん、今回依頼させて頂く子も可愛くて大好きです。\n機会があればこの子のイラストをもっと見たいと思っていて、このような形で依頼させていただきました。\n\n擬人化の際の性別やイラストの構図はお任せしてもよろしいでしょうか？\nまた、このお願いはわがままのようになってしまい申し訳ないのですが、もしよろしければこの子に名前を付けて頂き、イラストに入れて頂けたら大変嬉しいです。\n\nご検討いただければ幸いです。\nただ、描くのが厳しいかなと思ったら遠慮なく断ってください。\n無理なお願いはしたくないので・・・\n\nこのような依頼は初めてなので、至らぬ点等ございましたら恐縮です。\n最後にはなりますが、時節柄、どうぞ体調にお気をつけてご自愛下さいませ。", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@norainu03019/works/2", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/fc37759b/requests/76350_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=4aea6c92db8a86d3bc5526039bf2c427", "srcset": "https://si.imgix.net/fc37759b/requests/76350_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=4aea6c92db8a86d3bc5526039bf2c427, https://si.imgix.net/fc37759b/requests/76350_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=3a9629cd4de949d541ec181f1b643e9e 2x, https://si.imgix.net/fc37759b/requests/76350_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=b90cca8c8a1bd84274010288c36bb540 3x"}, "private": true, "genre": "art", "tipped": true, "creator_id": 145966, "client_id": 428645, "nc": 160}, {"path": "/@norainu03019/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 145966, "client_id": 451005, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/2b735983/requests/75373_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=