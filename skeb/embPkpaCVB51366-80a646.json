、お手数ですが再送要請をお願いします🙇🏻\n\nご多忙のところ恐縮ですが、ご検討のほど何卒よろしくお願い申し上げます。\n\nhttps://drive.google.com/drive/folders/1WN_Ccn42_xESB1V4oqnukCRi9LmG6KTM", "nc": 153, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}], "sent_works": [], "similar_creators": [{"id": 1163368, "creator": true, "nsfw_acceptable": false, "acceptable": false, "name": "ﾅﾂﾊﾞ", "screen_name": "Natsuba002", "avatar_url": "https://pbs.twimg.com/profile_images/1412134279908249617/4aIQ2lL3.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1358074305658068994/1637109599/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "art"}], "banned": false, "nc": 129}, {"id": 1577527, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "サギリ", "screen_name": "sagirisino", "avatar_url": "https://pbs.twimg.com/profile_images/1287403125007998976/CcLrEGPu.jpg", "header_url": "https://pbs.twimg.com/profile_banners/909234697296797696/1654507863/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "art"}, {"genre": "correction"}], "banned": false, "nc": 0}, {"id": 1879501, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "駒ゐ", "screen_name": "deisuibenten", "avatar_url": "https://pbs.twimg.com/profile_images/1513079482030379009/TXHTxYQt.jpg", "header_url": "https://pbs.twimg.com/profile_banners/107990233/1684468054/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 14, "complete_expiration_days": 90, "