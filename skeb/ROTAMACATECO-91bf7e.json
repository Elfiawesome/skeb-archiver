入れて欲しくて、その他はもうカテキンワールドで描いてくれたらおーるおっけーです！\n\nよろしくお願いします！\n\nhttps://drive.google.com/drive/folders/16RbBbjSr0IJ2hV7OeIRZJDC_x2D3zkke", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@ROTAMACATECO/works/15", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2791999, "client_id": 3190766, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/9678ded9/uploads/origins/d9c020e2-c6d3-42e3-99b9-46828d32291d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=15ed564eb13089bd5d69e6a946fa0e5b", "srcset": "https://si.imgix.net/9678ded9/uploads/origins/d9c020e2-c6d3-42e3-99b9-46828d32291d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=15ed564eb13089bd5d69e6a946fa0e5b, https://si.imgix.net/9678ded9/uploads/origins/d9c020e2-c6d3-42e3-99b9-46828d32291d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=13463599822c2035e531c829b4930100 2x, https://si.imgix.net/9678ded9/uploads/origins/d9c020e2-c6d3-42e3-99b9-46828d32291d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=bd25629f418ef9c1055f1361bc981347 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/9678ded9/uploads/origins/d9c020e2-c6d3-42e3-99b9-46828d32291d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f392c95199da6b343891c297801d64f1", "srcset": "https://si.imgix.net/9678ded9/uploads/origins/d9c020e2-c6d3-42e3-99b9-46828d32291d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f392c95199da6b343891c297801d64f1, https://si.imgix.net/9678ded9/uploads/origins/d9c020e2-c6d3-42e3-99b9-46828d32291d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=c0565cb0221675f961335df43b0f02ef 2x, https://si.imgix.net/9678ded9/uploads/origins/d9c020e2-c6d3-42e3-99b9-46828d32291d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=a619f6813abb8171cc5da924949eb363 3x"}, "body": "オリキャラになります。\n背景はピンク系で、ハート系のモチーフが入ってると嬉しいです。\nプリントして部屋に飾りたいので、A4あたりが希望になります。\n人物サイズは一応腰上か全身希望ですが、依頼料が多くないので、カテコさんが描きやすいサイズのおまかせでお願いしたいと思います。\nあまり色々お任せにすると負担になってしまうかもしれないのですが、カテコさんのいつもの文字入れの感じが好きなので、なんとなくキャラのぱっと見のイメージに合うような文を入れてもらえれば有難いです。特にピンとこなければ全然文無しでも大丈夫です。\n\n最後に参考画像についてです。\nオリキャラの夢見ヶ崎ちゃんです。苗字のみです。\n衣装とか装飾とかは、大まかなデザインが変わらなければ、カテコさんのお好みで弄っていただいても大丈夫です。むしろ嬉しいです。\n\nよろしくお願い致します。\n\nhttps://drive.google.com/drive/folders/1VatAJ_2SAsYhqI-n8Lzr8a9VJB4daXKa", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@ROTAMACATECO/works/14", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2791999, "client_id": 2938231, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/c55dd526/uploads/origins/1caed643-7e5c-43e1-b51e-c0e5467c718a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=56fdb7f65f59af0d97d0fbe8e2cbc280", "srcset": "https://si.imgix.net/c55dd526/uploads/origins/1caed643-7e5c-43e1-b51e-c0e5467c718a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=56fdb7f65f59af0d97d0fbe8e2cbc280, https://si.imgix.net/c55dd526/uploads/origins/1caed643-7e5c-43e1-b51e-c0e5467c718a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=35354b29b88fc744967c0ba23a8da1f2 2x, https://si.imgix.net/c55dd526/uploads/origins/1caed643-7e5c-43e1-b51e-c0e5467c718a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b4af4c6d3b46c3b388c1135551486e09 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/c55dd526/uploads/origins/1caed643-7e5c-43e1-b51e-c0e5467c718a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f528fb486d