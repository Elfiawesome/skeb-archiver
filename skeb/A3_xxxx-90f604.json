dpr=2&fit=crop&crop=top&w=200&h=200&s=b2c43ccb7f1ba51d59a44ae73a667e3f 2x, https://si.imgix.net/8f408f60/uploads/origins/bfa32a35-a61c-4302-875c-a7e070455236?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=648ba1657a7d08ce79301a5da1dc5385 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/8f408f60/uploads/origins/bfa32a35-a61c-4302-875c-a7e070455236?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=caa8fe0a94200a5baa894f4a9a400244", "srcset": "https://si.imgix.net/8f408f60/uploads/origins/bfa32a35-a61c-4302-875c-a7e070455236?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=caa8fe0a94200a5baa894f4a9a400244, https://si.imgix.net/8f408f60/uploads/origins/bfa32a35-a61c-4302-875c-a7e070455236?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=1b8505a80718c832a3d42b9912912e51 2x, https://si.imgix.net/8f408f60/uploads/origins/bfa32a35-a61c-4302-875c-a7e070455236?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=de490f8c130316499f67e33e7d490be4 3x"}, "body": "AAAさん、こんにちは！\n前回は素晴らしいイラストを本当にありがとうございました！あのダイナミックさと、キャラクターを見事に表現していただいたことに感激し、ぜひ今回もお願いしたく思います。\n\nネコはプロレスラーで、特に圧倒的な強敵を倒すことに非常に興奮します。彼は非常に強いプロレスラーで、筋肉質な体格をしており、相手をサブミッションホールドで屈服させることを楽しんでいます。対戦相手が「ギブ！」と叫ぶのを聞くことが、彼にとって最大のスリルです。彼は猫のような特徴（微笑んだときに見える小さな牙）を持っていますが、瞳孔は人間らしい形をしています。特に際立っている特徴は、光を反射して美しく輝く青い目と、腰の「アポロの帯」（V字ライン）が際立つ筋肉質な体格です。さらに、彼は鍛え上げられた大胸筋と前鋸筋も持っています。\n\n今回のテーマは『窮地のネコ/ピンチのネコ』です。強敵との試合で追い詰められた状況ですが、落ち込むどころか闘志が燃え上がり、青い瞳を輝かせて自信に満ちた笑みを浮かべる姿を描いていただきたいです。雰囲気としては、ガンダムSEEDのコーディネーターがSEEDモードに入るようなイメージで、「ここまで追い詰めるとは見事だ…だが、まだ始まったばかりだ！」という印象です。\n\n前回同様、胸や腹筋をはじめとした堂々たる肉体をしっかりと見せつつ、力強くクールな姿を描いていただければ嬉しいです。衣装については「レスリング衣装 1」をご参照ください。ポーズはいくつか参考資料を添付しましたが、最終的にはお任せしたいと思っています。試合の激しさを強調するため、身体に軽い打撲痕と汗の表現もお願いいたします。\n\nどうぞよろしくお願いいたします！\n\nhttps://www.dropbox.com/scl/fo/n8znfydvy4fyk1p2cbre4/AItrw3yOXUe1UkURH7EAZjA?rlkey=x0uwoboin3p5n9ultgpxg76or&st=6za8iio2&dl=0", "nc": 48, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@A3_xxxx/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2674341, "client_id": 781992, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/e1810c13/uploads/origins/2e2be9ab-3fce-4c99-bdad-074f922ad03a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2407af7800c2138eace48e2f9c60d522", "srcset": "https://si.imgix.net/e1810c13/uploads/origins/2e2be9ab-3fce-4c99-bdad-074f922ad03a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2407af7800c2138eace48e2f9c60d522, https://si.imgix.net/e1810c13/uploads/origins/2e2be9ab-3fce-4c99-bdad-074f922ad03a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=4248fa0d9623586d70b06acc8ca042bc 2x, https://si.imgix.net/e1810c13/uploads/origins/2e2be9ab-3fce-4c99-bdad-074f922ad03a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=22420afee43d3341ade6c36cec9b338a 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/e1810c13/uploads/origins/2e2be9ab-3fce-4c99-bdad-074f922ad03a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=8f658443a9fff78f37f9a562ac186c17", "srcset": "https://si.imgix.net/e1810c13/uploads/origins/2e2be9ab-3fce-4c99-bdad-074f922ad03a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=8f658443a9fff78f37f9a562ac186c17, https://si.imgix.net/e1810c13/uploads/origins/2e2be9ab-3fce-4c99-bdad-074f922ad03a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=7c075eca60e44d31aa44ec43541fde37 2x, https://si.imgix.net/e1810c13/uploads/origins/2e2be9ab-3fce-4c99-bdad-074f922ad03a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=c97babb9ad355735a2ddfb1d9c5573ed 3x"}, "body": "はじめまして、AAAさん！\n\n原神のリオセスリのイラストと、その堂々たる肉体美に本当に圧倒されました。ぜひ僕のキャラクター「ネコ」も描いていただきたく、ご依頼させていただきます！\n\nネコはプロレスラーで、特に圧倒的な強敵を倒すことに非常に興奮します。彼は非常に強いプロレスラーで、筋肉質な体格をしており、相手をサブミッションホールドで屈服させることを楽しんでいます。対戦相手が「ギブ！」と叫ぶのを聞くことが、彼にとって最大のスリルです。彼は猫のような特徴（微笑んだときに見える小さな牙）を持っていますが、瞳孔は人間らしい形をしています。特に際立っている特徴は、光を反射して美しく輝く青い目と、腰の「アポロの帯」（V字ライン）が際立つ筋肉質な体格です。さらに、彼は鍛え上げられた大胸筋と前鋸筋も持っています。\n\nポーズやシチュエーションはお任せしますが、特に胸や腹筋など、彼の堂々たる体格がしっかり見える構図にしていただければ嬉しいです。強くてクールな雰囲気でお願いします！衣装はローブを着用せず、レスリングコスチューム姿でお願いいたします。\n\nご検討いただけますと幸いです。\n\nhttps://www.dropbox.com/scl/fo/2g5kt6e0axrcxsqmxqcwm/AEyvjK8PK73APvuY5_ZWNvI?rlkey=yp41m1l0nln10qyo1oe3magte&st=6zqc851n&dl=0", "nc": 49, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@A3_xxxx/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2674341, "client_id": 644350, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/6634edf4/uploads/origins/a850d532-084e-4fe8-b92a-8c202f0e6709?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9f7d8ce7a9f38cb33ac72261e52270de", "srcset": "https://si.imgix.net/6634edf4/uploads/origins/a850d532-084e-4fe8-b92a-8c202f0e6709?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9f7d8ce7a9f38cb33ac72261e52270de, https://si.imgix.net/6634edf4/uploads/origins/a850d532-084e-4fe8-b92a-8c202f0e6709?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=56ee4019b72853b19b2d5454beda9d11 2x, https://si.imgix.net/6634edf4/uploads/origins/a850d532-084e-4fe8-b92a-8c202f0e6709?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f384fd1001e74b48fef9bd8d4904e621 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/6634edf4/uploads/origins/a850d532-084e-4fe8-b92a-8c202f0e6709?bg=%23fff&