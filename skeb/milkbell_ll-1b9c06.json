sa2EeglJnUy0fI1scpWssS6jZ4ORCi", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@milkbell_ll/works/12", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2056413, "client_id": 1171340, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/7edd713a/uploads/origins/760a3ecd-9cea-44f4-ad13-1b0a39831991?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0e086bcc00ffb00783cfb5c2537974d3", "srcset": "https://si.imgix.net/7edd713a/uploads/origins/760a3ecd-9cea-44f4-ad13-1b0a39831991?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0e086bcc00ffb00783cfb5c2537974d3, https://si.imgix.net/7edd713a/uploads/origins/760a3ecd-9cea-44f4-ad13-1b0a39831991?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=4dc363919ef62d4e95919b640361f9b5 2x, https://si.imgix.net/7edd713a/uploads/origins/760a3ecd-9cea-44f4-ad13-1b0a39831991?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=347b77810ce29551c25fd4202a711012 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/7edd713a/uploads/origins/760a3ecd-9cea-44f4-ad13-1b0a39831991?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=cf4a2ab5a42fd0b753dcf1d802493914", "srcset": "https://si.imgix.net/7edd713a/uploads/origins/760a3ecd-9cea-44f4-ad13-1b0a39831991?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=cf4a2ab5a42fd0b753dcf1d802493914, https://si.imgix.net/7edd713a/uploads/origins/760a3ecd-9cea-44f4-ad13-1b0a39831991?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=a4df5aa19dbf79ef6290c122c99d87d3 2x, https://si.imgix.net/7edd713a/uploads/origins/760a3ecd-9cea-44f4-ad13-1b0a39831991?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=40fec75245f4d7b3641b25216ad024a3 3x"}, "body": "ミルクベル@skeb募集中様\n\n個人Vtuberをしている とみたけかれる と申します。\nとてもかわいいイラストに惹かれ、私も是非描いていただけないかと思いリクエストさせていただきました。\n\n描いてほしいもの\n・とみたけかれる（資料参考）\n\n構図やポーズ等基本的にはミルクベル@skeb募集中様におまかせしたいと思います。\n服装もおまかせします。資料で着てるものを描いていただく場合も多少のアレンジ簡易化など問題ございません。\n\n女の子のような感じでかわいく描くのも全く問題ないですが、性別は男なので胸の大きさや服の種類等の考慮だけおねがいしたいです。\n\n用途は観賞用とサムネ等でも使えたらなと思っております。\n背景ありとなしのキャラのみに分けていただくか、分けられるpsd形式等でいただければたすかります。\n\nhttps://drive.google.com/drive/folders/11Dg2zCPTjsq102SFyqmz6LLUfJlGwZG-?usp=sharing", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@milkbell_ll/works/11", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2056413, "client_id": 1204692, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/116a6a38/uploads/origins/d3509325-0bbf-4c6d-ac75-b2c607fca9c9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b06638e71bd84c4f0a906a98ee4a73d4", "srcset": "https://si.imgix.net/116a6a38/uploads/origins/d3509325-0bbf-4c6d-ac75-b2c607fca9c9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b06638e71bd84c4f0a906a98ee4a73d4, https://si.imgix.net/116a6a38/uploads/origins/d3509325-0bbf-4c6d-ac75-b2c607fca9c9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=889e35417c165880702ffc67a8cf6878 2x, https://si.imgix.net/116a6a38/uploads/origins/d3509325-0bbf-4c6d-ac75-b2c607fca9c9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=9bac1f13830d2b62e95d422fb44bc078 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/116a6a38/uploads/origins/d3509325-0bbf-4c6d-ac75-b2c607fca9c9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9ce5aeb7e02d1db9ab7cd92de0d29416", "srcset": "https://si.imgix.net/116a6a38/uploads/origins/d3509325-0bbf-4c6d-ac75-