て警察官になり、陽気な性格から真面目で偏執的な性格になる。\nそして出張先のナイトクラブで、ベンジャミンとヴィクターは再会する。ヴィクターはベンジャミンに気づかないが、ベンジャミンはヴィクターにすぐに気づく。ベンジャミンはヴィクターに良心の呵責を感じていたため、ヴィクターの誘いに応じ、依存する態度を見せる。 ヴィクターが自分と同じように、まだ悪い過去の影から抜け出せないでいることを知った二人は、互いに依存し合い、助け合い、ついに過去から抜け出すことに成功する。\n\nベンジャミンはヴィクターに大きな罪悪感を抱いており、時折ヴィクターのからかいに腹を立てながらも、基本的には彼を受け入れ、大いに頼る。\nヴィクターはベンジャミンを頼りにし、愛し、大切に思っているが、今の彼のやや真面目な性格から、からかうのも好きだ。\n\nhttps://drive.google.com/drive/folders/1ckyXvf1q8yl87DtANXDw06MgLbY2W3HX?usp=share_link", "nc": 40, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}], "sent_works": [], "similar_creators": [{"id": 2427, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "ていぎ🔞", "screen_name": "teigi22", "avatar_url": "https://pbs.twimg.com/profile_images/1351711711904972801/4BXPft8m.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1259140260409163776/1679057587/1500x500", "appeal_receivable": true, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 3, "complete_expiration_days": 120, "skills": [{"genre": "art"}, {"genre": "comic"}], "banned": false, "nc": 176}, {"id": 2221150, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "🔰便座掃除", "screen_name": "KIREI_TOILET", "avatar_url": "https://pbs.twimg.com/profile_images/1355080633626755072/HonjieFU.png", "header_url": "https://pbs.twimg.com/profile_banners/1078083573335220224/1762527588/1500x500", "appeal_receivable": true, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 120, "skills": [{"genre": "comic"}, {"genre": "art"}, {"genre": "correction"}], "banned": false, "nc": 177}, {"id": 2732425, "creator": true, "nsfw_acceptable": true, "acceptable": false, "name": "爺太", "screen_name": "jita5max", "avatar_url": "https://pbs.twimg.com/profile_images/