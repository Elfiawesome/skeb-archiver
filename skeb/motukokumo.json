e_only_public": false, "tip_acceptable": true, "yearly_report_client_visible": false, "total_appeals_count": 529, "received_works": [{"path": "/@motukokumo/works/45", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3424079, "client_id": 3417602, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/1083442a/uploads/origins/2327d8ea-2919-4050-a745-33e508af604b?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&s=91606231210384b7977b32764f4ec16c", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/1083442a/uploads/origins/2327d8ea-2919-4050-a745-33e508af604b?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&blur=200&s=284b1b6192d5ebd1a8339125c6a1ba0a", "src_set": ""}, "body": "ごきげんよう、興國です！\n\n私のファーソナに温かいお言葉をいただき、ありがとうございます！デザインで気に入ってもらえたようで嬉しいです！\n\nあなたの魅力で、あなたのイラストのアイデアは素晴らしいと思います！ぜひ挑戦させてください。キットはちょっと変わったけど、ふわふわした女の子だよ！\n\n参考：https://drive.google.com/drive/folders/1cApy_mHrKJ9WKEoBphvagHY8owIyUhpN\n\n必要であれば、具体的な内容をあなたのフィッティングに合わせて自由に翻訳してください！\nありがとうございました！\n\nhttps://drive.google.com/drive/folders/1cApy_mHrKJ9WKEoBphvagHY8owIyUhpN", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@motukokumo/works/44", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3424079, "client_id": 1313561, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/f88bcce1/uploads/origins/53829a04-01db-448e-a9fd-3ea1ac21ccc4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f61a137fd85499ea4e2780c94e2073e0", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/f88bcce1/uploads/origins/53829a04-01db-448e-a9fd-3ea1ac21ccc4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=7990759345daed97bb62bd8f36ba2b14", "src_set": ""}, "body": "こんにちは！アピールのご依頼ありがとうございます。ご提案いただいたアイデアも含め、お受けしたいと思います。ジャンルがアートワークなのかコミックなのかわかりませんが、その判断はお任せします。\n私のオオカミ少女ビビアンが、体格の関係で胸にはさまれていたら、本当に面白いと思います。おそらく、もっと小さな箪笥の方がうまくいくでしょうし、別の収納物でもいいかもしれません。ビビアンの顔は、彼女の状況に少しイライラしていると思います。以下は彼女の参考資料です。\nhttps://drive.google.com/drive/folders/1iMBx7EDReEh2ksy39VgTaAqVTobTlgwN?usp=drive_link", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@motukokumo/works/43", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3424079, "client_id": 2215404, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/33354350/uploads/origins/e96e1a95-7b46-40c1-b1ac-fdc0a72c57d7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=351b725547826ed1be65fc9480249db4", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/33354350/uploads/origins/e96e1a95-7b46-40c1-b1ac-fdc0a72c57d7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=24b28c7c4cc65775ab7f72244c3b22c9", "src_set": ""}, "body": "こんにちは\nメッセージ見てリクエストしました！\n改めてメッセージありがとうございます🙌\nメッセージにあったように四月一日裁判官のイラストをお願いしたいです\n検討よろしくお願いします・・・！", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@motukokumo/works/42", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3424079, "client_id": 2328145, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/f9d8d083/uploads/origins/c49408c2-d2a0-4463-904f-dbce2d0049db?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=08b9314e71589681627d2659b4605b80", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/f9d8d083/uploads/origins/c49408c2-d2a0-4463-904f-dbce2d0049db?