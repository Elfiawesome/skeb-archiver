m=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=8572eb5b15c5f834715784fec38f9ead", "srcset": "https://si.imgix.net/d7224192/uploads/origins/1d123448-727d-444b-b9ac-48b189ea22d3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=8572eb5b15c5f834715784fec38f9ead, https://si.imgix.net/d7224192/uploads/origins/1d123448-727d-444b-b9ac-48b189ea22d3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=73856ed316b929f30a1a916289f3c4d2 2x, https://si.imgix.net/d7224192/uploads/origins/1d123448-727d-444b-b9ac-48b189ea22d3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=6d9ef8450cb09722ddf4692166130ed1 3x"}, "body": "ぷにさんこんにちは！\nリクエストしたいのは飼っていた愛猫を擬人化したオリジナルキャラクターです。\n構図などは全ておまかせします。\n\n全ておまかせは困るという場合は夢絵っぽい感じにしてくださると嬉しいです。\n台詞があっても大丈夫です（ぷにさんの字が好きです）。いかなる口調であっても正解は誰にもわからないので一つの解釈として受け取ります。\n\n\n資料① https://bsky.app/profile/hagiwaramokusei.bsky.social/post/3m2cjwmy2mk2s\n資料② https://bsky.app/profile/hagiwaramokusei.bsky.social/post/3lzlpeggrnc2b\n\n最低限の資料で申し訳ありませんがよろしくお願いします。", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@_AilingPuni/works/15", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 171523, "client_id": 1188451, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/5dbf6b76/uploads/origins/25a7849a-995f-4287-86da-e78dbb5dd622?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ca5565e3588613dce9bcd19cab704a60", "srcset": "https://si.imgix.net/5dbf6b76/uploads/origins/25a7849a-995f-4287-86da-e78dbb5dd622?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ca5565e3588613dce9bcd19cab704a60, https://si.imgix.net/5dbf6b76/uploads/origins/25a7849a-995f-4287-86da-e78dbb5dd622?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=cf7d27f5221058cf014b216f5575fc6b 2x, https://si.imgix.net/5dbf6b76/uploads/origins/25a7849a-995f-4287-86da-e78dbb5dd622?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=bce69a0884a5e22ad883a4622dbef7c9 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/5dbf6b76/uploads/origins/25a7849a-995f-4287-86da-e78dbb5dd622?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5005e29f7fee5173e564275aabdf2996", "srcset": "https://si.imgix.net/5dbf6b76/uploads/origins/25a7849a-995f-4287-86da-e78dbb5dd622?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5005e29f7fee5173e564275aabdf2996, https://si.imgix.net/5dbf6b76/uploads/origins/25a7849a-995f-4287-86da-e78dbb5dd622?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=a9beeb408bae59548bdab60c4c1c070b 2x, https://si.imgix.net/5dbf6b76/uploads/origins/25a7849a-995f-4287-86da-e78dbb5dd622?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=7265dbeb1ed1acdb21ba7da91c60b86d 3x"}, "body": "ぷにさんこんにちは！いつも素敵な作品をありがとうございます！今回も自創作CPのイラストを描いていただきたいです！\n\nシチュエーション：以前描いていただいた( https://skeb.jp/@_AilingPuni/works/5  )のシーンと同じ構図(続きのシーン)で、二人ともこちら側に向かってファンサをして欲しいです(校内新聞に使う写真を撮られている、というようなシチュエーションです)。\n\n人物①はノリノリで笑顔で指ハートしてくれます。ウインクしていてもいいです。\n (この指ハートでお願いします。    https://ja.m.wikipedia.org/wiki/%E6%8C%87%E3%83%8F%E3%83%BC%E3%83%88  )\n\n人物②は呆れ・困惑の表情で(何故こんな写真を撮られなければいけないんだ……)と思いながら渋々ぎこちなくピースをしています。視線をそらしていてもいいです。\n\nちなみにですが、描いていただいたイラストは、一枚のイラストとして愛でるのとは別に、それぞれ硬質ケースデコしたいと考えています。\n\n人物①：生徒会長(攻)\n資料：https://drive.google.com/drive/folders/16O0plIsigCtXgfyqRiTFqFZS-YjSvmu2\n黒髪紫目。平均よりは華奢で小柄。暗黒微笑が似合う敬語攻め。副会長を溺愛しているし一生手放すつもりは無い。\n\n人物②：副会長(受)\n資料：https://drive.google.com/drive/folders/16XqHKZekMzJLswjVCwqxWAsObyim204H\n黒髪青目銀縁眼鏡。平均的な身長。生徒会長以外には唯我独尊俺様だけど会長には逆らえない。\n会長のことは敬愛しているが、自分は彼に相応しいのかどうか自信が持ててない。\n\nよろしくお願いします！", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@_AilingPuni/works/14", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 171523, "client_id": 3502719, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/46e985c0/uploads/origins/8d1194fd-61fb-4014-aeda-44321a78de01?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ee5fdfdc40b3964d1cd24a60fb4e0469", "srcset": "https://si.imgix.net/46e985c0/uploads/origins/8d1194fd-61fb-4014-aeda-44321a78de01?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ee5fdfdc40b3964d1cd24a60fb4e0469, https://si.imgix.net/46e985c0/uploads/origins/8d1194fd-61fb-4014-aeda-44321a78de01?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e27ae7e41ac541c20317b5f05f56487b 2x, https://si.imgix.net/46e985c0/uploads/origins/8d1194fd-61fb-4014-aeda-44321a78de01?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a55e732c23afc3e786a8eb7439c114c0 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/46e985c0/uploads/origins/8d1194fd-61fb-4014-aeda-44321a78de01?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=4d6d4b76fa40afd6d23a525f082f2402", "srcset": "https://si.imgix.net/46e985c0/uploads/origins/8d1194fd-61fb-4014-aeda-44321a78de01?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=4d6d4b76fa40afd6d23a525f082f2402, https://si.imgix.net/46e985c0/uploads/origins/8d1194fd-61fb-4014-aeda-44321a78de01?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=498cc4c86b8674110d03fbfb4190d98d 2x, https://si.imgix.net/46e985c0/uploads/origins/8d1194fd-61fb-4014-aeda-44321a78de01?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=493e2c325524760bddcaee1f6438449b 3x"}, "body": "満を持してぷに様のskebに依頼しにきました！いつも楽しくツイート拝見しております。\n名○偵コ○ンの夢主ちゃんをSNSアイコンで使いたいので、イラストの依頼に来ました。\n描いていただきたい構図と容姿は以下の通りです。\n・公安所属の29歳女性\n・黒のパンツスーツを着用。拳銃での射撃の際は、撃ちやすいようジャケットのボタンを開けており、白のワイシャツが見える。ネクタイはしていない。\n・黒髪のストレートな切りそろえのボブカット。前髪は瞼の少し上。ぱっつんの軽め。前髪の毛先はふんわり緩めのワンカール。左耳に髪をかけ、その左耳には仲間と連絡を取るための黒いインカムが嵌められている。\n・目は黒→紺→薄い紺のように、下に向かうにつれてグラデーションが入っている。\n・眉は中くらいの太さ。太すぎず細すぎずなところ。\n・真正面を向く構図で拳銃を右手で構え、左手は拳銃のグリップの部分を支えている。彼女の額には切り傷（流血あり）、頬には爆発に巻き込まれた際に付着した煤を、乱雑に手の甲で拭ったような黒い跡がある。彼女の着用しているスーツも、爆発や戦闘によってボロボロで、所々破けてしまっている。\n・構図はいわば、こちら（画面外のわたしたち）に向けて照準を合わせているような構図で（分かりにくければすみません！）　その拳銃の奥で鋭い眼光が光っていて、今にも凶悪犯を撃とうとする鬼気迫る表情。その目尻にはほんの少し涙が滲んでいる。（汗の表現等があっても大丈夫です！）\n\n全体はモノクロで描いていただき、目だけカラーでお願いいたします。目のハイライトはぷに様のお好みでお願いいたします。\n\n雑筆＆伝わりにくくて申し訳ありません。\nよろしくお願いいたします！", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@_AilingPuni/works/13", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/ca2db219/uploads/origins/d13982a6-2d96-427e-a55b-4e5b105a0dc7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=9baf406d13f35ab11173758e578437c3", "srcset": "https://si.imgix.net/ca2db219/uploads/origins/d13982a6-2d96-427e-a55b-4e5b105a0dc7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=9baf406d13f35ab11173758e578437c3, https://si.imgix.net/ca2db219/uploads/origins/d13982a6-2d96-427e-a55b-4e5b105a0dc7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=f68202c35e56f732bfcb31f162da16b1 2x, https://si.imgix.net/ca2db219/uploads/origins/d13982a6-2d96-427e-a55b-4e5b105a0dc7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=09ff