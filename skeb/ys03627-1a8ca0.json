976d405a6c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=495e7103faef159e7fdafae942c4b829, https://si.imgix.net/2f95cee7/uploads/origins/7161d81e-09d1-44cf-bbfe-49976d405a6c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=3afb29fd50b5e213c20bf3a32f4e0343 2x, https://si.imgix.net/2f95cee7/uploads/origins/7161d81e-09d1-44cf-bbfe-49976d405a6c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b010283cc092ceedaf3343838d4689c9 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/2f95cee7/uploads/origins/7161d81e-09d1-44cf-bbfe-49976d405a6c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e13ef9c9d10167a006d48eea0c0ef9a5", "srcset": "https://si.imgix.net/2f95cee7/uploads/origins/7161d81e-09d1-44cf-bbfe-49976d405a6c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e13ef9c9d10167a006d48eea0c0ef9a5, https://si.imgix.net/2f95cee7/uploads/origins/7161d81e-09d1-44cf-bbfe-49976d405a6c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=1ba2eab54f73f1c9bf451d2c3a95aefd 2x, https://si.imgix.net/2f95cee7/uploads/origins/7161d81e-09d1-44cf-bbfe-49976d405a6c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=69248fc6474341e2e05732c91573bd51 3x"}, "body": "すうちゃんです この度は本当にありがとう…\n自創作キャラの朝比奈八重乃くんを描いて欲しいです 本当にありがとう\nものすごく大切なキャラなのでニクちゃんにどうしても描いて欲しくて依頼しました！ありがとうね\n以下設定です(何かヒントになれば…🙏)\n\n朝比奈八重乃(あさひなやえの)\n男。警察官。母子家庭で幼い頃新興宗教に傾倒した母親に女の子として育てられた。その影響は今でも強い。(一度も切られずに伸ばされた髪、髪型。好む香水の香りも母のもの。ホワイトリリーの香りが好き。尚本人は気づいていない。気づいていない振りをしてるのかもしれない) ただ別に女の子になりたいわけではない。\n身長が195cmと高く、真っ赤な髪も相まって見た目で判断されることが多かった。それがとても苦手だったが、自身もその影響か人を見た目で判断することが多く、それをやめたいと思っている。元は生活安全課の刑事で青少年等の補導をしていたが、直近の異動で捜査一課配属となった。そこで出会った上司は人生で初めて自分をただの自分として、警察官として見てくれた。それが嬉しくて段々惹かれ、好きになり、最近付き合った。ネクタイのラインは上司のイメージカラーです！！！", "nc": 145, "word_count": 0, "t