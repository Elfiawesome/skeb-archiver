4c5a-932c-01893ad04da9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=27dad4b41b66b125231c76f7741b3d1b", "srcset": "https://si.imgix.net/240a976b/uploads/origins/a2a384c9-5542-4c5a-932c-01893ad04da9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=27dad4b41b66b125231c76f7741b3d1b, https://si.imgix.net/240a976b/uploads/origins/a2a384c9-5542-4c5a-932c-01893ad04da9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=528dd72e48922f157b01619001795408 2x, https://si.imgix.net/240a976b/uploads/origins/a2a384c9-5542-4c5a-932c-01893ad04da9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=c2a661d9d678c826cca99781687062a0 3x"}, "body": "大変癖に刺さるイラストを見かけましたのでぜひほまれ先生に描いていただきたくリクエストさせていただきました。\n\n・キャラクター\nVSK-94(ドールズフロントライン)\nhttps://wikiwiki.jp/dolls-fl/VSK-94\n通常スキンの制服衣装でお願いします(上着は省略しても構いませんがそれ以外の装備はお願いします)\n\n・シチュ\n狙撃任務のため長時間の待機で尿意を催したため、やむなくそのままおしっこを漏らして垂れ流す。\nなるべく姿勢を崩さないように出すもかなりの量が出てしまいタイトスカートのお尻側や脚に伝ってびちゃびちゃになり、床にも溜まりができる。\n(姿勢次第ではスカート前側にも染みができる)\n\nすなわち下記のオトギのようなシチュです。\nhttps://x.com/0141kabosu/status/1917107301498163352\n\n・構図\n狙撃のためしゃがんで物陰からVSK-94(銃)を構え、スコープ越しに外を伺っている。\n上記オトギや下記参考イラストの立て膝のようなスカートの中がよく見えるポーズ・構図でお願いします。\nhttps://www.pixiv.net/artworks/84271922\n(VSK-94の構え方に関しては資料URLも参考にしていただければと思います)\n\n・セリフ、表情\n味方との通信など入れていただければ嬉しいですが、難しければ息遣いやわずかな独白だけでもOKです。\n任務に集中しているので漏らしていることは意に介さず、出し切った後に少しだけ臭いの後始末と着替えのことを考えるような独白がある感じでお願いします。\n表情も任務優先で終始冷静ですが、出し切った後だけ尿意の緊張が解けてわずかにほっとした表情をしている感じでお願いします。\n\n・その他\n基本は黒パンスト着用の姿でお願いしますが、さらに可能でしたら\n　・パンストの股間部分が破れた状態(漏らしても蒸れないようにと狙撃待機開始前に自分で破いたという設定)\n　・パンストなしの生足\nも描いていただけると嬉しいです。必要であれば金額調整いただければと思います。\nご検討よろしくお願いします。\n\nhttps://drive.google.com/drive/folders/1-bTCin2DGnd8NFBYeJNa7VFOZa58kkPU?usp=sharing", "nc": 176, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@homarenyo2/works/12", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/34e80037/uploads/origins/62be7e17-95d9-4ada-81ef-60948737cf50?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=1376961e0918fb538eb51a3badea9b08", "srcset": "https://si.imgix.net/34e80037/uploads/origins/62be7e17-95d9-4ada-81ef-60948737cf50?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=1376961e0918fb538eb51a3badea9b08, https://si.imgix.net/34e80037/uploads/origins/62be7e17-95d9-4ada-81ef-60948737cf50?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=6d804d5f160ce41a02c15a9969d0f3ac 2x, https://si.imgix.net/34e80037/uploads/origins/62be7e17-95d9-4ada-81ef-60948737cf50?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=aaebd8de6c657282194686b49f858bcb 3x"}, "private": true, "genre": "comic", "tipped": true, "creator_id": 3665937, "client_id": 1939944, "nc": 48}, {"path": "/@homarenyo2/works/11", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3665937, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/33336930/uploads/origins/80f07948-36c7-4c37-87f5-1e65f956381f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4ab8f15ed540cbad8106f3a23349c11a", "srcset": "https://si.imgix.net/33336930/uploads/origins/80f07948-36c7-4c37-87f5-1e65f956381f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4ab8f15ed540cbad8106f3a23349c11a, https://si.imgix.net/33336930/uploads/origins/80f07948-36c7-4c37-87f5-1e65f956381f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=4a36b0cbedd49da19eca05d376712463 2x, https://si.imgix.net/33336930/uploads/origins/80f07948-36c7-4c37-87f5-1e65f956381f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a878de2f72edb457a583b32db56afc38 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/33336930/uploads/origins/80f07948-36c7-4c37-87f5-1e65f956381f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=7d6db6e2c9932e88859b9526ea183c2a", "srcset": "https://si.imgix.net/33336930/uploads/origins/80f07948-36c7-4c37-87f5-1e65f956381f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=7d6db6e2c9932e88859b9526ea183c2a, https://si.imgix.net/33336930/uploads/origins/80f07948-36c7-4c37-87f5-1e65f956381f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=f901e3def9c99e48a5b98fa175d822ed 2x, https://si.imgix.net/33336930/uploads/origins/80f07948-36c7-4c37-87f5-1e65f956381f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=649cc4f628c1db17c8ae64d7befdb1cb 3x"}, "body": "前回のミカンママの朝の放尿シーンは素晴らしかったです。またリクエストを送らせていただきます。\n\n概要\nNEWGAME!の滝本ひふみが、個室の洋式トイレで放尿しているイラストをリクエストさせていただきます（一番下のURLのキャラです）\n\n構図\n普通に洋式トイレに座って放尿する構図です、要望として、便器内の水が見えるようにお願いします\nアングルとしては、放尿中のひふみを正面から見下ろす感じでお願いします\nイメージ的には職場内のトイレで放尿という感じです\n\n服装\nイーグルジャンプでの彼女の恰好でお願いします（このURLの公式サイトにあります）\nおパンツが確認できる場合は、白パンでお願いします\nhttps://newgame-anime.com/character/\n\n表情\n束の間の休息をしている表情だと思います（仕事場から離れてホッとしていると思われます）\n\n差分について\n放尿する前から、放尿終了までの大事なところからおしっこの勢いの変化の差分でお願いします（要は支援サイトで貴方様が投稿されている神絵に多くある、キャラクターが放尿している経過差分です）\n\nhttps://dic.pixiv.net/a/%E6%BB%9D%E6%9C%AC%E3%81%B2%E3%81%B5%E3%81%BF", "nc": 33, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@homarenyo2/works/10", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3665937, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/97708616/uploads/origins/a6265453-3bf8-4093-acd8-0a2f49edf90a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=964aa9534ac0c2cc943c6d0b776d5322", "srcset": "https://si.imgix.net/97708616/uploads/origins/a6265453-3bf8-4093-acd8-0a2f49edf90a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=964aa9534ac0c2cc943c6d0b776d5322, https://si.imgix.net/97708616/uploads/origins/a6265453-3bf8-4093-acd8-0a2f49edf90a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=4204b256f6f97750d387648409c48b38 2x, https://si.imgix.net/97708616/uploads/origins/a6265453-3bf8-4093-acd8-0a2f49edf90a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ef8cc0ec2dc737d341bd41992e86ecea 3x"}, "duration": null, "nsfw": true, "hardcore": true, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/97708616/uploads/origins/a6265453-3bf8-4093-acd8-0a2f49edf90a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3624db5e9b718c41c3fcb1771dbdcfc9", "srcset": "https://si.imgix.net/97708616/uploads/origins/a6265453-3bf8-4093-acd8-0a2f49edf90a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3624db5e9b718c41c3fcb1771dbdcfc9, https://si.imgix.net/97708616/uploads/origins/a6265453-3bf8-4093-acd8-0a2f49edf90a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=05b511c806ad11c4ec6b52c0639886a4 2x, https://si.imgix.net/97708616/uploads/origins/a6265453-3bf8-4093-acd8-0a2f49edf90a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=dd2e1db10a85c19d0ec24383b2f60b52 3x"}, "body": "はじめまして。\nこうしたリクエストが可能でしたらご検討いただけないでしょうか。\nキャラクター：オリジナルキャラのエリコ先生。遠足の引率中、という設定でジャージ姿です。\n急に催してしまったエリコ先生だが、辺りにトイレがない…”緊急事態”なので、他の先生に子供達をお願いしてトイレに向かう…が、もう間に合わない。急いで茂みに隠れた、という所からスタート。\n「うぅう…もう無理ぃ…何でこんな時に…早く戻らないと…」\n急いでジャージとパンツを下ろし、しゃがみ込んだ瞬間おしっこが勢いよく。\n（正面からの構図が希望です）\n「何とか…まにあったけど…あっ…あぁ…」\nおしっこの最中、お腹からゴロロと異音…\n「あぁ…もうイヤぁ…大きい方も出ちゃう…」\nプリプリと野グソを始めてしまうエリコ先生。何本かのウンチが山積みに。\n「うぅ…ついに野グソもしちゃったよぉ…見つからないよね…ごめんなさいっ！！」\n慌てて戻るエリコ先生でした。\n\nという設定です。\n大きい方は飛鳥ちゃんがメインのようですが、もし可能なら他の子でも、と思い、エリコ先生をリクエストさせていただきます。", "nc": 59, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@homarenyo2/works/9", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3665937, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/fa4a80fc/uploads/origins/8a3ed375-c6ba-461a-9a86-51aea622d4a4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=33123952152b2a8fe53a47ba7ef538ed", "srcset": "https://si.imgix.net/fa4a80fc/uploads/origins/8a3ed375-c6ba-461a-9a86-51aea622d4a4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=33123952152b2a8fe53a47ba7ef538ed, https://si.imgix.net/fa4a80fc/uploads/origins/8a3ed375-c6ba-461a-9a86-51aea622d4a4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=07974809570e1e0f66ab5af719884d7c 2x, https://si.imgix.net/fa4a80fc/uploads/origins/8a3ed375-c6ba-461a-9a86-51aea622d4a4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f83131382d5309bcd5ba57fd41b586be 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/fa4a80fc/uploads/origins/8a3ed375-c6ba-461a-9a86-51aea622d4a4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=31d616e5b91f2f252847d3bef33864f7", "srcset": "https://si.imgix.net/fa4a80fc/uploads/origins/8a3ed375-c6ba-461a-9a86-51aea622d4a4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=31d616e5b91f2f252847d3bef33864f7, https://si.imgix.net/fa4a80fc/uploads/origins/8a3ed375-c6ba-461a-9a86-51aea622d4a4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=f33fb6c957d7fe33398b63b03cf13cba 2x, https://si.imgix.net/fa4a80fc/uploads/origins/8a3ed375-c6ba-461a-9a86-51aea622d4a4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=08bf379bf99bf06337a8b29d6e727da1 3x"}, "body": "前回のきららちゃんの野ション姿はとても素晴らしいイラストでした。またリクエストを送らせていただきます\n\n概要\nまちカドまぞくの陽夏木ミカンが、洋式トイレでおしっこしているイラストをリクエストさせていただきます\n\n構図\n普通に洋式便器に座り、放尿する内容です\nアングルは便器内の水が、見える構図でお願いします（ミカンママの濃厚な尿で真っ黄色になったのが分かるようにお願いします）\n\n表情\nかなり気持ちよさそうな表情だと思います\n\n恰好\n引用URLの桜ヶ丘高等学校の制服でお願いします\nおパンツが確認できる場合は、白パンでお願いします\nhttps://www.tbs.co.jp/anime/machikado/character/chara04.html\n\n差分について\n放尿する前から、放尿終了までの大事なところからおしっこの勢いの変化の差分でお願いします（要は支援サイトで貴方様が投稿されている神絵に多くある、キャラクターが放尿している経過差分です）", "nc": 177, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@homarenyo2/works/8", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3665937, "client_id": 218059, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/86956fed/uploads/origins/8a13b6df-f5b0-4acf-8087-322f2f766cf3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c66ac37f112f032404a7503582077304", "srcset": "https://si.imgix.net/86956fed/uploads/origins/8a13b6df-f5b0-4acf-8087-322f2f766cf3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c66ac37f112f032404a7503582077304, https://si.imgix.net/86956fed/uploads/origins/8a13b6df-f5b0-4acf-8087-322f2f766cf3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=2fbf15f038dad40adb3362031ef7d2c6 2x, https://si.imgix.net/86956fed/uploads/origins/8a13b6df-f5b0-4acf-8087-322f2f766cf3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=28d766d0b572e1338ecc35c962b50dd5 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/86956fed/uploads/origins/8a13b6df-f5b0-4acf-8087-322f2f766cf3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a7d94fec1332e0d7bdadbe85448cd489", "srcset": "https://si.imgix.net/86956fed/uploads/origins/8a13b6df-f5b0-4acf-8087-322f2f766cf3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a7d94fec1332e0d7bdadbe85448cd489, https://si.imgix.net/86956fed/uploads/origins/8a13b6df-f5b0-4acf-8087-322f2f766cf3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=a3571a96e5e17e250b050b6fd98b6329 2x, https://si.imgix.net/86956fed/uploads/origins/8a13b6df-f5b0-4acf-8087-322f2f766cf3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=b29bb07771245b4e6490c4450443ad49 3x"}, "body": "ほまれさん\n初めまして、いつもイラスト楽しませていただいております。\n数年前にリクエストされないのですか？とお聞きさせていただきましたが、今回その時に温めておいた内容で是非お願いしたくお送りさせていただきます。\n\nキャラ:アロエ(クイズマジックアカデミー)\n\n服装:キャミソール\n十数年前のゲームセンターの景品で着ていたものがあるので、めちゃくちゃ画質悪くて申し訳ありませんが資料として一応添付させていただきます。　他のデザインでも構いません\n\nhttps://www.dropbox.com/scl/fi/dwx166s32d6klsm39gm9q/IMG_2931.JPG?rlkey=becwbmzfxitmnbej64k1rp9cj&st=yzjyftxg&dl=0\n\nシチュ:怖い夢を見ちゃっておねしょ\n相当昔にはなるのですが、2019年に描かれていた「ももちゃんぐったり」にクソお世話になったのでこちら+スヤリス姫のおねしょからイメージさせていただいております。\n夢の内容としてはゲーム内で予選落ちをすると先生から雷で打たれるおしおきがあるので、こちらでお願いいたします。\n\nポーズ:ベッドで就寝、キャミソールがめくれてパンツが全部見えているような感じであれば他の細かいところはお任せします。\nパンツは白、もしくはピンク基調の子供パンツでお願いします\n\n流れ(差分)としてはいつも描かれているような感じで\n①寝息を立てて就寝中\n②夢の中でおしおき直前、眉を顰めて唸っており、既に少しちびり始めている\n③「あっ！」「あぁ〜っ！」と夢の中で雷をくらい、おしっこが本格的にで始める\n④夢から覚めて目を開け、下半身の感触でお漏らししている事に気付き止まってぇ…と自分の膀胱にお願いするも止まってくれるはずもなく\n⑤おしっこが止まり、散々になったシーツを見ながらお仕置きされちゃう…パンツもお気に入りだったのに…と泣いている\n\n他流れ的にこれあった方が自然だな…等あれば好きに補完していただいて大丈夫です。\n\n他、ポスター化して自宅で飾る予定なので、イラストの比率はA寸で、台詞や効果音一切なしの差分をいただけると助かります(音なしをベースにレイヤーで台詞のみ分ける等で構いません)\n\n長くなりましたがご検討いただけますと幸いです。", "nc": 32, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@homarenyo2/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3665937, "vtt_url": null, "thumbnail_image_urls": {"src": "ht