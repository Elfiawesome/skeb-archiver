asset.kirafan.cn/adv/standpic/kirara/kirara_standpic_0/Kirara_StandPic_0.png\nhttps://asset.kirafan.cn/texture/charauiresource/charaillustfull/charaillust_full_32002001.png\nhttps://dic.pixiv.net/a/%E3%81%8D%E3%82%89%E3%82%89(%E3%81%8D%E3%82%89%E3%82%89%E3%83%95%E3%82%A1%E3%83%B3%E3%82%BF%E3%82%B8%E3%82%A2)\n\n構図\n道から外れて野ションする構図です（催して、適当な場所でする感じです）\n放尿姿勢は、しゃがんでするよくあるポーズです（大事な所が見えれば問題ないです）\nおパンツが確認できる場合は、正統派白パンでお願いします\n\n表情\n気持ちよさそうにしている表情だと思います\n当人は田舎育ちなので、野ションに慣れていると思います\n\n差分について\n放尿する前から、放尿終了までの大事なところからおしっこの勢いの変化の差分でお願いします（要は支援サイトで貴方様が投稿されている神絵に多くある、キャラクターが放尿している経過差分です）", "nc": 48, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@homarenyo2/works/6", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/78ae87fa/uploads/origins/80b73cd3-b51f-4d7c-aeca-fa7727d87593?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=9ab53203c4a41ff02096d9c0231c3749", "srcset": "https://si.imgix.net/78ae87fa/uploads/origins/80b73cd3-b51f-4d7c-aeca-fa7727d87593?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=9ab53203c4a41ff02096d9c0231c3749, https://si.imgix.net/78ae87fa/uploads/origins/80b73cd3-b51f-4d7c-aeca-fa7727d87593?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=ed5fdff12f3a41744b4cc76d57cec928 2x, https://si.imgix.net/78ae87fa/uploads/origins/80b73cd3-b51f-4d7c-aeca-fa7727d87593?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=081150d2a4d095d35d652dfe1885f250 3x"}, "private": true, "genre": "art", "tipped": true, "creator_id": 3665937, "client_id": 1104313, "nc": 33}, {"path": "/@homarenyo2/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3665937, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/42e005fc/uploads/origins/ae160c3e-2f47-419f-add0-63eabada1169?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9ede1d278b15164cbeaa847eb7ad5074", "srcset": "https://si.imgix.net/42e005fc/uploads/origins/ae160c3e-2f47-419f-add0-63eabada1169?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9ede1d278b15164cbeaa847eb7ad5074, https://si.imgix.net/42e005fc/uploads/origins/ae160c3e-2f47-419f-add0-63eabada1169?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=074a38b506efe40140b352b9f523c8e5 2x, https://si.imgix.net/42e005fc/uploads/origins/ae160c3e-2f47-419f-add0-63eabada1169?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=81da57f4cdad9ea3828cc9d47262bdb7 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/42e005fc/uploads/origins/ae160c3e-2f47-419f-add0-63eabada1169?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3e859e5e393bfc77d7a765a1dc88a6f8", "srcset": "https://si.imgix.net/42e005fc/uploads/origins/ae160c3e-2f47-419f-add0-63eabada1169?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3e859e5e393bfc77d7a765a1dc88a6f8, https://si.imgix.net/42e005fc/uploads/origins/ae160c3e-2f47-419f-add0-63eabada1169?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=b8bd67fb17b2bfe8cd85b2226d7c02b7 2x, https://si.imgix.net/42e005fc/uploads/origins/ae160c3e-2f47-419f-add0-63eabada1169?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=3163891c67f5ee83a136eac02e6257dd 3x"}, "body": "前回の苺香ちゃんの洋式トイレチャレンジは素晴らしかったです。またリクエストを送らせていただきます\n\n概要\nがっこうぐらしの恵飛須沢胡桃ちゃんが、和式トイレで放尿しているイラストをリクエストさせていただきます。\n\n構図\n和式トイレで屈んで、おパンツを脱いで、大事な所が見えている状態で、放尿する感じだと思います（普通におトイレしているだけです）\n胡桃ちゃんの大事な所からおしっこが出ているのが分かれば問題ないです\n\n差分について\n放尿する前から、放尿終了までの大事なところからおしっこの勢いの変化の差分でお願いします\n\n服装（一番下の引用URLにあります）\n制服でお願いします（胡桃ちゃんの通常の恰好です）\n胡桃ちゃんの履いていたおパンツが見える場合は、白でお願いします\n\n表情\nおしっこして、気持ちよさそうな表情だと思います\n\n最後に\nもし金額が足りない場合は、改めます\n\nhttps://gakkougurashi.com/chara/kurumi.html", "nc": 177, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@homarenyo2/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3665937, "client_id": 1198137, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/8a7a1abe/uploads/origins/0ab56ff6-5e95-4c91-bdf0-d81f35931d2e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0d39d4500a60e71020dfb2bcc40b1eb6", "srcset": "https://si.imgix.net/8a7a1abe/uploads/origins/0ab56ff6-5e95-4c91-bdf0-d81f35931d2e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0d39d4500a60e71020dfb2bcc40b1eb6, https://si.imgix.net/8a7a1abe/uploads/origins/0ab56ff6-5e95-4c91-bdf0-d81f35931d2e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ce07aa6d78198cfa6f1c4db1976a6c5e 2x, https://si.imgix.net/8a7a1abe/uploads/origins/0ab56ff6-5e95-4c91-bdf0-d81f35931d2e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=1e5b3194c29b7e32ab76c38c99804982 3x"}, "duration": null, "nsfw": true, "hardcore": true, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/8a7a1abe/uploads/origins/0ab56ff6-5e95-4c91-bdf0-d81f35931d2e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=1c42471ba0891b36c8b56aadf28d8440", "srcset": "https://si.imgix.net/8a7a1abe/uploads/origins/0ab56ff6-5e95-4c91-bdf0-d81f35931d2e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=1c42471ba0891b36c8b56aadf28d8440, https://si.imgix.net/8a7a1abe/uploads/origins/0ab56ff6-5e95-4c91-bdf0-d81f35931d2e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=ec0203b3dc16b687b0a7dc519b1e95c9 2x, https://si.imgix.net/8a7a1abe/uploads/origins/0ab56ff6-5e95-4c91-bdf0-d81f35931d2e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=c172eb4b1539d3f69cb6b963d36f607a 3x"}, "body": "ほまれさん、ずっとskebの解放待っていました！\nほまれさんのおしっこイラスト大好きでずっとリクエストを送りたいと思っていましたので今回リクエストを送らせていただきました！\nできる限り詳細にと言う事で細かく書きますが今回希望したいイラストは以下の通りです！\n(ジャンル外と思われるキャラかつ頼みたいシチュエーションがとある二次創作由来なので不可能な場合はキャンセルしていただいて構いません)\n\nキャラ：青葉あげは(遊戯王タッグフォースシリーズ)\n服装：タッグフォース６の制服\nシチュエーション：拘束・拷問の末の失禁･脱糞\nシチュエーション詳細：こちらの二次創作→https://www.nicovideo.jp/watch/sm19872937　において上記の青葉あげはと窪田修司というキャラがポケモン世界を旅する作品があり、そちらの２１話→https://www.nicovideo.jp/watch/sm23070646(を参照)にて青葉あげはがロケット団に先回りされたシーンがあるのですが、今回はそれのIFで「ロケット団に追われている際に尿意を催してしまい、トイレに行こうとしたら背後から攻撃を受けてしまい気絶。気がついたらロケット団のアジトで拘束され、情報を聞き出すために尋問されるがあげははそれを拒否。怒ったロケット団は電気イスまたは電気ポケモンの電撃であげはを拷問。情報を聞き出すために命までは奪われなかったが捕まる前に催していた事もあり失禁。それを見てロケット団は「高校生になっておもらしですかぁ~ｗ」と煽る」…みたいなイラストをリクエストしたいです。\n二次創作由来なネタかつそこから自分の妄想が爆発した形のリクエストになりますが…大昔書かれたfateの凛の拘束おもらしイラストが先程の二次創作を見た時からよぎってしまいほまれさんにどうしても描いていただきたいです…！！(イラストの構図もそちらを意識していただけると幸いです)\n余談ですがそのイラスト度々お世話になっています…はい…\n失禁した尿と凛の悔しそうな顔と、めくれたパンツが最大の興奮材料過ぎます…！！\n\nそれでは長たらしく書いてしまいましたがリクエストのご検討お願いします<m(__)m>\nいつもイラスト応援してます~！！", "nc": 186, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@homarenyo2/works/3", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/297b9032/uploads/origins/462c75c2-1068-4876-b674-298e61d8e997?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=90912d7fcaefc982898188a466fec8d8", "srcset": "https://si.imgix.net/297b9032/uploads/origins/462c75c2-1068-4876-b674-298e61d8e997?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&