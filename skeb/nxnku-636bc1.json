compress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=64f0b12d01247c7a1afa05ecedfb18d0 3x"}, "body": "ももせしき先生、こんばんは。\nvk42vと申します。\n\nXで先生のイラストを拝見し、その可愛らしくてあたたかい絵柄に心を惹かれ、ぜひリクエストを送らせていただきたいと思い、ご連絡いたしました。\n\n私の今回描いていただきたいキャラクターは、 iPad（第10世代）の擬人化 です。\n\nその子には、以下のような性格イメージがあります。\n・中古の「Bランク品」であることを、本人は少しだけ気にしている\n・でもそれを隠したくて、強がったり虚勢を張ったりする\n・いわゆる「メスガキ」寄りの挑発的な態度だけど、内面はちょっと不安定で可愛い子\n・新品じゃないことを見透かされるとすぐムキになる\n・「べ、別にアンタのためじゃないし？」みたいな距離感\n\n外見は、\n・第10世代のカラー（私の実物と同じピンク色）を基調にした雰囲気\n・どこか“デバイスらしい無機質さ”が残っている\n・だけど仕草や表情は可愛く、ちょっと強気\n・小さい、「Bランク」と書かれた札（紙）がついていると嬉しい\n・小柄だと嬉しい\n・八重歯がある\n\nこの性格をベースに、先生の解釈で自由にデザインしていただけるととても嬉しいです。\n\n初めての依頼のため記述に不足があるかもしれませんが、解釈や構図などは先生におまかせいたします。\n【使用用途】\n・作者名を明記した上での資料としての提示\n・個人での鑑賞用\n\nどうぞよろしくお願いいたします。\n\nhttps://drive.google.com/file/d/1CMzq82fAs75VKS4KBThroDvMFbnaB9Vd/view?usp=drivesdk", "nc": 25, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}], "sent_works": [], "similar_creators": [{"id": 40399, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "しろかび🦹🏻", "screen_name": "Hi_ak10", "avatar_url": "https://pbs.twimg.com/profile_images/1640976807691452422/QBax_pI5.jpg", "header_url": "https://pbs.twimg.com/profile_banners/308334322/1707214125/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 80, "skills": [{"genre": "art"}], "banned": false, "nc": 161}, {"id": 67784, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "Morikawa@skeb800yen~", "screen_name": "morikawa0208", "avatar_url": "https://pbs.twimg.com/profile_images/1963143143584567296/3f8lWEro.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1261229671/1466741716/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_