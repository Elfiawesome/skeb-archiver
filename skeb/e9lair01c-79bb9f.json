=top&w=200&h=200&blur=200&s=da212c6a5e6696a9deb5e7af7c914e28 3x"}, "body": "アピールありがとうございます！\n\n東方Projectより大妖精をお願いします！\n\n浴衣姿でまだ夏を感じるようなイラストを描いて欲しいです！\n\n浴衣のデザイン等はお任せします！\n\n大まかな内容になりましたがよろしくお願いします！", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@e9lair01c/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3895272, "client_id": 1960223, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/90a69016/uploads/origins/2f643884-89d9-446c-aca6-a621a547f298?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e7f9ce90550218b0c692777a8c7a3f3f", "srcset": "https://si.imgix.net/90a69016/uploads/origins/2f643884-89d9-446c-aca6-a621a547f298?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e7f9ce90550218b0c692777a8c7a3f3f, https://si.imgix.net/90a69016/uploads/origins/2f643884-89d9-446c-aca6-a621a547f298?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=04bfd09a08dae12c6f8e82cfb6ecd602 2x, https://si.imgix.net/90a69016/uploads/origins/2f643884-89d9-446c-aca6-a621a547f298?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=61b611bb5e78532d0c35533acf484a63 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/90a69016/uploads/origins/2f643884-89d9-446c-aca6-a621a547f298?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=59870a6b2f6d36aa2852d41853fc9d11", "srcset": "https://si.imgix.net/90a69016/uploads/origins/2f643884-89d9-446c-aca6-a621a547f298?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=59870a6b2f6d36aa2852d41853fc9d11, https://si.imgix.net/90a69016/uploads/origins/2f643884-89d9-446c-aca6-a621a547f298?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=ec0366b1d0f735020ef0d87e4c29de81 2x, https://si.imgix.net/90a69016/uploads/origins/2f643884-89d9-446c-aca6-a621a547f298?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=8d0b37c977fd11785c6f900417d4a227 3x"}, "body": "エクレア先輩さん初めまして。\nもしよろしければ東方Projectの「火焔猫燐」に「トサキントレオタード」をコスプレさせた一枚をお願いできますか。\n（※トサキントレオタード→初代のポケモンアニメ43話「ナッシーぐんだん　だいこうしん！」で、カスミがマジシャンのアシスタントの際に着用していた、トサキントを模した衣装を指してます）\n\n衣装の造形につきましては資料ページのURLをご参考頂ければと存じます。\nこの衣装が大好きなため、完全に自分の趣味としてコスプレでのご依頼させて頂きますが、元ネタをご存じないだろうことは承知の上です。\nその上で、直近描かれたゆかりんの手袋の描き味（というか「手」そのものに対する魅せ方やこだわり）に目を見張るものを感じさせられましたこと。\nまた、過去にお燐ちゃんも描かれていた所から、まあまあエクレア先輩さんにも描きやすいキャラかなと期待し、このお題目にてお願いさせて頂ければと思いました……！\n\n表情や構図・ポーズ、あと多少のアレンジなどについては、エクレア先輩さんが良いと思ったまま、ご想像されるままのお燐ちゃんで描いて頂ければOKです。\nセンシティブに配慮してストッキング履かせる等の微アレンジを加えて頂く等は問題ないですが、もちろん原作デザインそのままに素足で描かれてもOKです！\n（だけどロングな手袋が性癖なので、アレンジしても手袋は忘れないで頂ければとてもすごく嬉しいです……）\n一応、コスプレ（衣装）がメインなので、なるべくならの範疇で十分ですが、全身が収まるような構図で、衣装姿のほどをご堪能させて頂ければ特に嬉しく思います……！\n\nやや無茶な依頼とは存じますが、それでもよろしければ何卒お願いいたします！\n\nhttps://bulbapedia.bulbagarden.net/w/index.php?title=File:Misty_Goldeen_outfit.png", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 73251, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "刃神氷雨", "screen_name": "hagami495", "avatar_url": "https://pbs.twimg.com/profile_images/1770855519072174081/poSGzf1I.jpg", "header_url": "https://pbs.twimg.com/profile_banners/204254032/1598716205/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "art"}, {"genre": "correction"}], "banned": false, "nc": 177}, {"id": 88659, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "R.シュタットフェルド/Ryuno Stadtfeld ☆Skeb募集中", "screen_name": "ryuno_stadtfeld", "avatar_url": "https://pbs.twimg.com/profile_images