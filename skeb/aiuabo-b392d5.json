e8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c03e47e9110b6f72a36c35f07a96b896", "srcset": "https://si.imgix.net/767967e9/uploads/origins/7f34c8ad-008b-48f4-bb63-a20fd3f6dbe8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c03e47e9110b6f72a36c35f07a96b896, https://si.imgix.net/767967e9/uploads/origins/7f34c8ad-008b-48f4-bb63-a20fd3f6dbe8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=aa668b481c40d84dc45916079fbd876b 2x, https://si.imgix.net/767967e9/uploads/origins/7f34c8ad-008b-48f4-bb63-a20fd3f6dbe8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=5be56b64652ddc95d40f700bb150275d 3x"}, "body": "こんにちはkokomaです。いつもかわいいイラストありがとうございます！\nskebがキャンペーンやってたのでこの機会にまた一枚お願いしいなと思いました。\nどうぞよろしくお願いします！\n\n-依頼内容-\n\n天気のいい日に洗濯もの干し終わって一休みって感じのイラスト。\nそよ風気持ちいいって笑顔で、八重歯（牙？）が見えてると嬉しいです！\n\nロケーションイメージは山間の空が開けている場所ですが、青空ならどこでもいいかなとｗ\n色彩やレイアウトはお任せしたいと思います。\n\nキャラクター設定は前回同様の小鬼の紅姫ちゃんです。\nピンクの普段衣装でお願いします。\n\n今回も納品については一切の要望ありません。\nどうぞよろしくお願いします。", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@aiuabo/works/11", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1886, "client_id": 395435, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/8c77e461/uploads/origins/f1cce2a3-1aa3-403a-8fc8-d050c3d09025?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=43bad36dfd890b323b3503de594e775b", "srcset": "https://si.imgix.net/8c77e461/uploads/origins/f1cce2a3-1aa3-403a-8fc8-d050c3d09025?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=43bad36dfd890b323b3503de594e775b, https://si.imgix.net/8c77e461/uploads/origins/f1cce2a3-1aa3-403a-8fc8-d050c3d09025?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=3d5a2821d8792dbc507a46a58887e99a 2x, https://si.imgix.net/8c77e461/uploads/origins/f1cce2a3-1aa3-403a-8fc8-d050c3d09025?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=68569baeedc489de2caa8a4b93443d01 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/8c77e461/uploads/origins/f1cce2a3-1aa3-403a-8fc8-d050c3d09025?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e39db40f12717823efa4ba9bac674c81", "srcset": "https://si.imgix.net/8c77e461/uploads/origins/f1cce2a3-1aa3-403a-8fc8-d050c3d09025?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e39db40f12717823efa4ba9bac674c81, https://si.imgix.net/8c77e461/uploads/origins/f1cce2a3-1aa3-403a-8fc8-d050c3d09025?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=f981fddccb545b59a14e0f91bfe29201 2x, https://si.imgix.net/8c77e461/uploads/origins/f1cce2a3-1aa3-403a-8fc8-d050c3d09025?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=7e71c601f078b08f4c4091e99fb2841e 3x"}, "body": "あけましておめでとうございます。kokoma と申します。\n前回はとってもかわいい小鬼ちゃんを描いて下さってありがとうございました！\n\n今回またイラストを一枚お願いしたくご連絡させて頂きました。\nどうぞよろしくお願いします！\n\n-依頼内容-\n\n小鬼ちゃんが節分で豆まきしてるイラスト\n\nキャラクター設定は前回同様の小鬼ちゃんです。\nとても気に入っているので衣装や小物もそのまま変更なし。\n\n節分という事で片手に升と豆、もう一方の手は鬼のお面で口元少し隠してる感じ\nちょっとあざといくらいが可愛いかなと。\n\nシチュエーションとしては古民家の軒先イメージですが、キャラとの距離感は近めが嬉しいので背景はシンプルでいいのかなと思ってます。\nそのあたり含めて、色彩やレイアウトはプロにお任せしたいと思います。\n\n\n節分って一般的に「鬼は外」が主流ですが、実は「鬼は内」もあって、鬼を崇めている地域も少なくないそうです。\nそんな人に好かれる小鬼ちゃんに仕上げてもらえたら嬉しいです♪\n\n今回も納品については一切の要望ありません。節分前でも節分後でも全然大丈夫です。\nどうぞよろしくお願いします。", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@aiuabo/works/10", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1886, "client_id": 395435, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/4424cbed/uploads/origins/6cb0cfd5-8ef6-4caf-8e5f-9