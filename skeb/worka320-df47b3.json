rop=top&w=200&h=200&blur=200&s=f500c69d2f29303c9255c2a36876933c, https://si.imgix.net/93754a2d/uploads/origins/eec5c8b4-9592-4ae8-948f-4d03089e4f91?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=6f741ec9b8e9c1c76a40f6b48d0615b6 2x, https://si.imgix.net/93754a2d/uploads/origins/eec5c8b4-9592-4ae8-948f-4d03089e4f91?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=11fccdb892c470c322c5ad63ce06e1fc 3x"}, "body": "リクエスト失礼します。\nVtuberの汀御景さんのイラストを描いていただきたく連絡させていただきました。 \n三面図、キービジュアルなど \nhttps://frontier.creatia.cc/fanclubs/2148/posts/64827\n固定キャラポイント：薄い胸。真っ平らです。全体的にスレンダーに描いていただきたいです。 \n服装に関してはお任せしますが、靴はNew York Knicksのチームカラーのオレンジ・ブルー・ホワイトのスニーカーでお願いします。 \nhttps://x.com/the_bigfifteens/status/1896480570483560656?s=46 \nお手数おかけいたしますが、ご検討の程よろしくお願いいたします。", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@worka320/works/8", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3095593, "client_id": 3042070, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/524fad76/uploads/origins/288eafcf-260d-4c29-b271-1cfe5e1fb585?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f250d64dee4ce750bf8a5d81d252798a", "srcset": "https://si.imgix.net/524fad76/uploads/origins/288eafcf-260d-4c29-b271-1cfe5e1fb585?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f250d64dee4ce750bf8a5d81d252798a, https://si.imgix.net/524fad76/uploads/origins/288eafcf-260d-4c29-b271-1cfe5e1fb585?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=69768d489c54470eca808143e6f67257 2x, https://si.imgix.net/524fad76/uploads/origins/288eafcf-260d-4c29-b271-1cfe5e1fb585?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c5bb70af0bdfe3412c79b05da0ba44c8 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbna