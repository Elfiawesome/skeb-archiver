ろとろで気持ちよさそうな表情or恥ずかしがりながらも気持ちよさそうな表情\n相手の描写は無くても構いません（その場合男性器は描かず、挿入シーンであればぽっかり空いているイメージで）\n胸の大きさは控えめ（Bカップ程度～つるぺたまでお好みで）\n服装は着衣～半脱ぎくらいでお願いします\n顔が見える内容で、その他構図などは描きたいものでお任せします\n\nご検討をお願いいたします\n\nhttps://drive.google.com/drive/folders/1gXZVDfcsl66QZ8VxPLKFXERqQXKioNsJ", "nc": 169, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@mimiya_0o0/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3774178, "client_id": 1913383, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/42604429/uploads/origins/edf5c19f-8ca7-43b1-8507-39f389fa2539?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=239a189b7de3245e2180b4bd85a038fe", "srcset": "https://si.imgix.net/42604429/uploads/origins/edf5c19f-8ca7-43b1-8507-39f389fa2539?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=239a189b7de3245e2180b4bd85a038fe, https://si.imgix.net/42604429/uploads/origins/edf5c19f-8ca7-43b1-8507-39f389fa2539?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=cca528f31c7fd94e4083bbb54e963f2d 2x, https://si.imgix.net/42604429/uploads/origins/edf5c19f-8ca7-43b1-8507-39f389fa2539?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=479ed46d97954c877a7e6cf8fc9f58cf 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/42604429/uploads/origins/edf5c19f-8ca7-43b1-8507-39f389fa2539?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b38b61851ce89f942fc87ca62ce69da4", "srcset": "https://si.imgix.net/42604429/uploads/origins/edf5c19f-8ca7-43b1-8507-39f389fa2539?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b38b61851ce89f942fc87ca62ce69da4, https://si.imgix.net/42604429/uploads/origins/edf5c19f-8ca7-43b1-8507-39f389fa2539?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&