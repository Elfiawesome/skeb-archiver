」の5人でフタナリイラストをお願いしたいです。\n\n全員全裸、和気あいあいとした雰囲気で、カメラ目線。\nマイがアズに、アズがユイナに、ユイナがチョコに、チョコがキョウカに挿入して同時射精しているところをタイマー撮影した、という構図でお願いします。\n\nご検討をお願いします。\n\nhttps://www.maebashi-witches.com/\nhttps://www.maebashi-witches.com/character/", "nc": 160, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@omo_kuroi/works/237", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/39692086/uploads/origins/2dfc38b0-0675-4c77-a701-57e00edfa691?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=e7c4fa3e4dcf06b5c54f7ca60488f4f5", "src_set": ""}, "private": true, "genre": "art", "tipped": true, "creator_id": 285316, "client_id": 0, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 49, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@omo_kuroi/works/236", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 285316, "client_id": 2115975, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/89bdd400/uploads/origins/6abf9b5e-a6bf-4bff-b48d-319263369a75?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f64724ea0245a61a3f45b938a874f6dc", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/89bdd400/uploads/origins/6abf9b5e-a6bf-4bff-b48d-319263369a75?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=531d0bc72f4d796d2b77e2787ed3d9dc", "src_set": ""}, "body": "またリクエストさせていただきたいです！\nもしご対応可能ならぜひよろしくお願いします！\n\nキノの旅からキノがお尻ペンペンされているイラストをお願いしたいです。\n\nシチュエーション\n旅の途中とある国への入国時の入国審査で危険物の持ち込みが見つかり、旅人であること年齢などを考慮して罰としてお尻叩きの刑をで許してもらうという状況です。\n不本意だが補給が必要なので仕方なく罰を受け入れるという流れです。\n\n下半身裸で機械的な拘束台に固定され、お尻を大きく突き出している恰好で丸出しのお尻を何回も叩かれてトマトのように真っ赤になったお尻をお願いしたいです。\n別カットなどで屈辱、恥ずかしさを感じながら、今にも叫んでしまいそうな痛みを必死に歯を食いしばって耐えているような表情も見えるようしていただきたいです。\n\n叩いている人は画面上に入らなくていいです。\nその他背景などはお任せします。\n\nよろしくお願いします！", "nc": 57, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@omo_kuroi/works/235", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/fcf7742f/uploads/origins/d64829ce-4592-4135-95d6-62d0e363651c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=27d4553588985f9a71770be1f50f3a35", "src_set": ""}, "private": true, "genre": "art", "tipped": true, "creator_id": 285316, "client_id": 178635, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 161, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@omo_kuroi/works/234", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/be5a6528/uploads/origins/c1eb2c8f-7e1b-428e-9bb8-d22fd33d59b0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=6e4a224989b1d42bf5e03250ca782331", "src_set": ""}, "private": true, "genre": "art", "tipped": true, "creator_id": 285316, "client_id": 301186, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 17, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@omo_kuroi/works/233", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 285316, "client_id": 0, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/ea456dc3/uploads/origins/86f7013e-8add-4142-b350-52935f2d4e59?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=247afa61ede10eea6b46fc7ad5d77b80", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/ea456dc3/uploads/origins/86f7013e-8add-4142-b350-52935f2d4e59?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=53207d03574742b21d22dcad84597966", "src_set": ""}, "body": "ご無沙汰しております\n早速リクエストさせていただきます\n\n■キャラクター\nFate/staynightのライダーと士郎\n\n■シチュエーション\n野外露出するライダーと士郎\n\n■構図\n全裸で四つん這いのライダーとその後ろを士郎がついて行っている感じでお願いします\n以前に描かれているゆるキャンの野外露出のようなイメージで、ライダーは乗り気、士郎は流されてついてきているような感じでお願いします\nライダーは首輪とアナルに尻尾付きの大人の玩具を挿入しているところ、士郎はライダーの首輪についた縄を持ちながらアナルになにか挿入されていて前立腺を刺激されている感じでお願いします\nちょうど街灯の下のような感じでライダーと士郎の体が明るく照らされておりライダーの肌と士郎の陰茎のツヤを強めに入れていただけると嬉しいです\n\nシチュのイメージはライダーが夜の散歩として野外露出を士郎に提案した感じです\n士郎は初めての野外露出とライダーの体を見ていることと歩く度に前立腺を刺激されていることで陰茎がギンギンに勃起してしまっているイメージです\nライダーも楽しそうに露出しながら士郎に体を見せつけて勃起させて楽しんでいる感じでお願いします\n\n四つん這いのライダーをメインで、士郎は首から下あたりが映っていれば大丈夫です\nライダーは乳首もビンビンに勃起してアナルの玩具が擦れて感じているところをお願いします\n士郎の陰茎は真上を向くくらい勃起させて形の良い立派なものでお願いします\n全員陰毛、ムダ毛なしでお願いします\n\nよろしくお願いします\n\nhttps://dic.pixiv.net/a/%E3%83%A9%E3%82%A4%E3%83%80%E3%83%BC%28Fate%2Fstaynight%29", "nc": 33, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@omo_kuroi/works/232", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 285316, "client_id": 2115975, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/cb099a91/uploads/origins/48868b7b-5fca-45be-8c84-1c4b491b1163?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=22904350c2bcd26917eea686e9e5aaf8", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/cb099a91/uploads/origins/48868b7b-5fca-45be-8c84-1c4b491b1163?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b985683886dffb5079a26f78e5d54699", "src_set": ""}, "body": "リクエストよろしいでしょうか？\nとある科学の超電磁砲から御坂美琴のイラストをお願いしたいです。\nフェチなシチュエーションですがベットの上で真っ赤に腫れたお尻を出して痛みに悶えているシーンをお願いしたいです。\n門限になっても部屋に戻っていないことが寮監にばれてお尻を叩かれた夜というイメージです。\n\n服装はパジャマでお尻だけ丸出しにして真っ赤に腫れたお尻を冷ましている格好です。\n表情としては痛みと恥ずかしさで涙目になっている感じでお願いしたいです。\n別カットでお尻のアップもお願いしたいです。\nお尻の色ですがしっかりとお尻全体を鮮やかな真っ赤にしていただきたいです。\n\nよろしくお願いします！", "nc": 57, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@omo_kuroi/works/231", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/cd1c4e9a/uploads/origins/fd1cf01e-c63c-4bcb-8cd5-09e795b26def?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=0c02e5ba21df9c927c393edaaa7ea9b0", "src_set": ""}, "private": true, "genre": "art", "tipped": true, "creator_id": 285316, "client_id": 301186, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 144, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@omo_kuroi/works/230", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/2e7c11f4/uploads/origins/a78dad50-bc31-444c-9f43-79eaddb55ce1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=45195c71ea28507175da64ff226b70b9", "src_set": ""}, "private": true, "genre": "art", "tipped": true, "creator_id": 285316, "client_id": 108895, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 176, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@omo_kuroi/works/229", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/df129faa/uploads/origins/4c24e73a-7356-4788-85e6-69082ad62d5f?bg=%23fff&auto=format%2Ccompress&fm=we