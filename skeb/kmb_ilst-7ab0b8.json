i.imgix.net/170c934a/uploads/origins/8ddc1d2a-75cb-42c8-ad22-26f83e8a9369?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=8f47c67e4c1ab0493ffdf68956d5e8bd 2x, https://si.imgix.net/170c934a/uploads/origins/8ddc1d2a-75cb-42c8-ad22-26f83e8a9369?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=079b1f351ac4f18b28e0cdffd9a01bf8 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/170c934a/uploads/origins/8ddc1d2a-75cb-42c8-ad22-26f83e8a9369?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=177aab3c44e50298e943a55c5c7eb0fa", "srcset": "https://si.imgix.net/170c934a/uploads/origins/8ddc1d2a-75cb-42c8-ad22-26f83e8a9369?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=177aab3c44e50298e943a55c5c7eb0fa, https://si.imgix.net/170c934a/uploads/origins/8ddc1d2a-75cb-42c8-ad22-26f83e8a9369?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=255cd767159ad6c72c984d88c27b8aef 2x, https://si.imgix.net/170c934a/uploads/origins/8ddc1d2a-75cb-42c8-ad22-26f83e8a9369?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=681269a8b3dcc13cd7a543dc0b91e1c3 3x"}, "body": "里山ぽてこんぶ先生\n先日はとても素晴らしいイラストを描いていただいて、ありがとうございました。\n\n先日の『異世界⇔地球間で個人貿易してみた』から、\nステラのイラストがとても満足できる内容でしたので、\nまた同じキャラを描いていただきたいです。\n\n・朝、パジャマ姿で髪を梳かしている　ぽやぽや寝起き\n・夕食に可愛らしいエプロン姿で、オムライスを作っている。上手にできてムフン、と得意げ\n・できたオムライスを「あ～ん」してる。やる側が照れすぎな顔真っ赤っか笑顔。\n・シンプルなエプロン姿。肌の露出の少ないピチッとした服装で、調薬の仕事をしている。\n薬研や乳鉢、ビーカーなど道具は現代の新しいものだけど、やり方は古い機会化前の職人仕事\n\nといったシーンのうち、好きなものを描いていただければと思います。\n\n前回、構図であったりとか、視点や背景とかも含めてとても素晴らしかったので、基本的に好きに描いていただければと思っております。\n\n引き受けていただければ幸いです。\nよろしくお願いします。", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@kmb_ilst/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creato