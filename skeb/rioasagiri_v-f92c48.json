hana101/works/410", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2177354, "client_id": 1395230, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/b898b81b/uploads/origins/c0f1775c-eeba-4a7c-a799-8081ebd0d5d3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=46eb8fb3904e8e931e2e4f39dade8c39", "srcset": "https://si.imgix.net/b898b81b/uploads/origins/c0f1775c-eeba-4a7c-a799-8081ebd0d5d3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=46eb8fb3904e8e931e2e4f39dade8c39, https://si.imgix.net/b898b81b/uploads/origins/c0f1775c-eeba-4a7c-a799-8081ebd0d5d3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=d5ae2e63dc269cc491f036596e514a24 2x, https://si.imgix.net/b898b81b/uploads/origins/c0f1775c-eeba-4a7c-a799-8081ebd0d5d3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a083fba35339a4c30aee45cbeb8a6991 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/b898b81b/uploads/origins/c0f1775c-eeba-4a7c-a799-8081ebd0d5d3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d15e675201ebc33efab2cee26c5ce7ef", "srcset": "https://si.imgix.net/b898b81b/uploads/origins/c0f1775c-eeba-4a7c-a799-8081ebd0d5d3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d15e675201ebc33efab2cee26c5ce7ef, https://si.imgix.net/b898b81b/uploads/origins/c0f1775c-eeba-4a7c-a799-8081ebd0d5d3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=82b44127e173d86b81962a191f2b5802 2x, https://si.imgix.net/b898b81b/uploads/origins/c0f1775c-eeba-4a7c-a799-8081ebd0d5d3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=de339134042e2b734aba26812c1e1466 3x"}, "body": "はじめまして。Vtuberの浅葱里リオと申します。\nTwitterの版権イラストを拝見して、とても素敵だったのでリクエストさせていただきます！\nどうぞご検討のほどよろしくお願いいたします。\n\n◆場面\nダンスをしながら歌っているライブシーン。\n普段は比較的ゆるっとしていて自然体ですが、真面目で内心には熱い気持ちを持っています。\n「ライブが心から楽しい！もっとやれる！」と思っているような、わくわくしている笑顔をカメラに向ける感じでお願いしたいです。（目は細めても大丈夫ですが、目の色がわかるよう開けておいていただきたいです）\n可愛い感じのファンサをがっつりするタイプではないので、ポーズは決めるという感じではなくジャンプしていたり手を差し伸べていたりと、躍動感のある感じをイメージしています。\nもし可能であれば少し汗の描写を入れていただけたら、本気でライブに臨んでいる感じがして嬉しいです！\nマイクかヘッドセットかはおまかせいたします。\nなお、サイドテールver.とショートボブver.がありますが、ショートボブの方が標準ですので、そちらでお願いいたします。\n\n◆使用用途\n活動3年目のキービジュアルとして使用したく、これだけで髪型や目の色、服装の雰囲気、何を主軸としているかなどが伝わるようなものにしたいと思っております。\n確定：SNSのアイコンやヘッダー・宣伝、動画や配信のサムネイルなど（未収益化）\n希望：缶バッジやアクリル製品などのグッズ。全くデザインせずイラストをそのままグッズとして販売はしません。（例：サインを加えただけのポスターなどはなし）\nまた、限定10個程度になる予定です。\n金銭的な理由でグッズ化NGの場合は、金額調整し再送依頼いただけますと幸いです。\n使用条件や細かい利用可能範囲などあれば、別レイヤーにご記載くださいませ。\n\n◆希望\n描写範囲：サムネイルにも使用したい為、頭と上半身の左右が見切れないようにしていただきたいです。\nサイズなど：描画範囲が決まっていない為曖昧な書き方で申し訳ありませんが、1920*1080でバストアップにしても問題ない程度のサイズでお願いいたします。\nグッズ利用可能でしたら、お手数ですが300dpi以上でお願いいたします。\n差分：全く必須ではありませんがもし描いていただける場合は、表情差分あるいはライトの雰囲気が違うものをいただけたら嬉しいです。\n背景：ライブ風で簡単に描いていただけたら嬉しいですが、必須ではありません。もしライトやペンライトのカラーが必要な場合は、イメージカラーの浅葱色（ターコイズ）を使っていただけたら嬉しいです。\n形式：pdfまたはpng。人物と背景、サイン・注意事項などは分けてください。\n\n◆補足\n資料URLに画像やメモを入れております。ご確認いただけますと幸いです。\n\n\n以上、ぜひうさみみ様に描いていただきたいので、どうぞよろしくお願いいたします…！\n\nhttps://drive.google.com/drive/folders/1XZlq6uVL0FGEmeNAvxsKGyw-idf8TVX4", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "similar_creators": [{"id": 63911, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "なるはやちゃん【公式】バーチャルキャリアアドバイザー", "screen_name": "NarumiHayase", "avatar_url": "https://pbs.twimg.com/profile_images/2004362436628135936/3CQkwJYP.jpg", "header_url": "https://pbs.twimg.com/profile_banners/996663738231996416/1746096265/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "voice"}], "banned": false, "nc": 1}, {"id": 134872