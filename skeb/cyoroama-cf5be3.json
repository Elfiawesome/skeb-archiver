4113213603910/futago.png\n髪型はおだんごがデフォルトですが、いっしょの髪型に変えてあそんだりもします。\n\nこちらは単体ですが参考になりましたら…！\nhttps://cdn.discordapp.com/attachments/1092303886427111436/1120922400712826980/7153a57b3f8029fc.png\n\nよろしければよろしくお願いします。", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@cyoroama/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2790232, "client_id": 910171, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/383ec57f/uploads/origins/f63b513d-2e65-4d4b-a275-81ce29825aaf?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e2d1e0d03f1e0258ddbee6972474c66e", "srcset": "https://si.imgix.net/383ec57f/uploads/origins/f63b513d-2e65-4d4b-a275-81ce29825aaf?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e2d1e0d03f1e0258ddbee6972474c66e, https://si.imgix.net/383ec57f/uploads/origins/f63b513d-2e65-4d4b-a275-81ce29825aaf?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=17f86c905f7e0b5a1f3a7b4de228abb7 2x, https://si.imgix.net/383ec57f/uploads/origins/f63b513d-2e65-4d4b-a275-81ce29825aaf?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=743b72a2ac6a5dd5c73d5d6243e9b605 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/383ec57f/uploads/origins/f63b513d-2e65-4d4b-a275-81ce29825aaf?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=351610412871dbb5b7bdb238ab42cde9", "srcset": "https://si.imgix.net/383ec57f/uploads/origins/f63b513d-2e65-4d4b-a275-81ce29825aaf?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=351610412871dbb5b7bdb238ab42cde9, https://si.imgix.net/383ec57f/uploads/origins/f63b513d-2e65-4d4b-a275-81ce29825aaf?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=7b1014990b801d