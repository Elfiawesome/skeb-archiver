ploads/origins/fec7784a-2f08-4fcf-b9e1-f90458176b52?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=7cf4f1e2dc3a18cbdd0d233e2a6cf9b7", "src_set": ""}, "private": true, "genre": "comic", "tipped": true, "creator_id": 2401097, "client_id": 36048, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 32, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@coumav/works/19", "private_thumbnail_image_urls": null, "private": false, "genre": "comic", "tipped": false, "creator_id": 2401097, "client_id": 2674577, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/167eb366/uploads/origins/9255b457-e6b3-46bb-a316-15587ca433d1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=46dab8d91e0bfbf904487a0c457441aa", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/167eb366/uploads/origins/9255b457-e6b3-46bb-a316-15587ca433d1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=54c14dee1464a84da7932428a05e3045", "src_set": ""}, "body": "田澤こうまさん、初めまして。セナモスと申します。\n田澤こうまさんの素敵な漫画をskebで拝見して、ぜひ田澤こうまさんに漫画をお願いできないかと思い、リクエストを送ります。\n今回は、私のオリジナルキャラクターであるハピネスワッフルが街を破壊する怪物と戦うシーンを漫画で描いていただきたく、リクエストを送ります。\n\n登場させてほしいキャラクターは、\n・ワッフル（ハピネスワッフル）\n・クイラス大魔王\n・怪物\nの3名です。\n\nストーリーは以下の通りです。\n１・クイラス大魔王が魔王の城から遠隔で怪物をワッフルが住む街に召喚する。\n２・怪物が街を破壊し始める。\n３・街を破壊する怪物を見つけたワッフルが、ハピネスワッフルに変身。\n４・ハピネスワッフルが怪物と戦う。（はじめはキックで攻撃する)\n５・怪物が弱まったところで、ハピネスワッフルが強力な魔法技\"ワッフルハピネスハート\"を繰り出し、怪物は浄化されて消滅。\n６・その様子をモニターで見ていたクイラス大魔王は悔しがる。\n７・街は元通りになり、ハピネスワッフルは笑顔で「この街は私が守るわ！」とセリフを言う。\n\n３番目の変身するところに関しては、プリキュアの変身シーンのように描いてくださると幸いです。\nどの装備を装着するところを描くかはお任せしますが、変身を終えた後着地するシーン（ブーツをクローズアップしたアングル）は必須でお願いしたいです。\n\nもしストーリー的に理解できない部分がありましたら話の構成を変更しても問題ありません。\nその他特に指定がない部分はお任せします。\n\nキャラクターの容姿については資料URLがありますので、そちらを参照してください。\n\n・ワッフル（普段着）→https://www.pixiv.net/artworks/120605712\n・ハピネスワッフル（変身後）→https://www.pixiv.net/artworks/104202751\n・クイラス大魔王と怪物→https://www.pixiv.net/artworks/120558202\n\n\nリクエストは以上です。もしよければ受けてくださると嬉しいです。よろしくお願いします。", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@coumav/works/18", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/644889ce/uploads/origins/d74720f9-f556-4801-998b-a15a0826499d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=d921220c48615aa08fbaf9757d048c43", "src_set": ""}, "private": true, "genre": "art", "tipped": true, "creator_id": 2401097, "client_id": 2621969, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 33, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@coumav/works/17", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/2a56df64/uploads/origins/e63701c6-0162-4d28-925b-0e2f39151ded?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=88fc22456c8dd5f7e63c97ebbb937684", "src_set": ""}, "private": true, "genre": "art", "tipped": true, "creator_id": 2401097, "client_id": 36048, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 32, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@coumav/works/16", "private_thumbnail_image_urls": null, "private": false, "genre": "comic", "tipped": false, "creator_id": 2401097, "client_id": 1431858, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/1b51add7/uploads/origins/882eeed5-10e4-45ff-9d37-cdffc767edf7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1c8be10754225cdb24e9d2680b7963b4", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/1b51add7/uploads/origins/882eeed5-10e4-45ff-9d37-cdffc767edf7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b3fe6c816dc6a70d405369c2b2930028", "src_set": ""}, "body": "あおとちゃんとミーチャさん、そして私のオリジナルキャラ「ラギッド」が登場する作品を希望します。\n\nラギッドは、以前描いていただいたムーディの仲間です。\n無骨な人型作業メカ的なイメージで、フック型の首やドリルの様な頭部、左腕の分厚いはさみなどの特徴があります。\n(胸部のスコープ状のものは光線銃です。)\n言葉は話しませんが身振り手振りで意思表示をすることがあります。\n\nよくわからない部分は独自の解釈で描いていただいて問題ありません。\n\n●大まかなストーリー\n・あおとちゃんとミーチャさんが、奇妙だが給料の高いバイトの募集を見つける。\n\n内容は廃小屋解体作業の急募で、\n「場所：再開発地区△□☆」\n「きつい重労働はAI搭載の実験機が代行するので安心！安全管理として見張って下さい。」\n「注:AIは試運転中のため、判断に迷っている際は手伝ってあげてください。」\nといった見出しや説明がある。\n(これらの参考文をそのまま使っても別のものに変えてもどちらでもOKです。)\n\nそもそもバイトをするわけや変わった内容でも参加する理由などは、二人ならこうするだろうと想像していただければと思います。\n\n・実験機というワードからハイテクなものや「こんなロボットだったらいいな」と想像を膨らませたり、もう一人は大丈夫なのかと心配したりしている。\n\n・場所へ行くとすでにラギッド(例の実験機)が廃小屋の解体を進めていた。\n迎えに行く際に頭のドリルを壁にぶつけ破壊したり、鉄骨もはさみで潰してしまう姿にミーチャさんは怖がる。\n\n思っていたものと異なり困惑するも、がれき類を大胆に粉砕する様子に「これなら何もしなくていいや」と壁に腰かけくつろぐあおとちゃん。\n\n・いきなりあおとちゃんの頭上に光弾が通り過ぎおどろくが、足元に穴の開いた空き缶が転がり落ちる。\nあおとちゃんに缶がぶつかりそうになっていたのをラギッドが胸の光線銃で弾いていた。\nあおとちゃんは守ろうとしていたのを察するが「いきなりビーム撃つな！」と怒る。\n\n・唐突な行動で怖がらせたことを申し訳なさそうにしながら、大金を渡すラギッドと苦笑いする二人。\n\nもしも難しい部分がありましたら話の構成を変更しても差し支えありません。\nその他特に指定がない部分もお任せします。\n\n気長にお待ちしておりますので、よろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/1lRfimJVKCAGLB33O0WZkRGj_jLDUaDud?usp=drive_link", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@coumav/works/15", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/b0c7db0b/uploads/origins/9803d721-ff4d-4b20-bdfe-b29794c9de77?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=mi