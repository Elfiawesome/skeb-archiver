須葉南子（くろすはなこ）さんのイラストです。\nこういうお姉さんのイラストがピッタリの絵だったのでリクエストさせてもらいました。\n現在skebの依頼は一時停止中の事ですが、可能であればという事でダメもとなので、ご無理なようでしたら遠慮なくキャンセルしてください。\n\n使用目的：プレゼント\n今後の活動に使っていただきたいので、本人に限り配信のサムネやSNS等に使用する許可をいただけると幸いです。\n\n【希望イラスト】\n衣装やポーズも先生にお任せいたします。\n\n【特徴】\n・優しいお姉さん\n・よくお湯を飲む\n・歌を歌うのが好き\n・大体笑顔\n\n・サムネイル等で利用するため、髪の毛の先が切れないように描いていただけると嬉しいです\nその他ポーズや構図、背景などはお任せ致します。\n全身イラストでなくても大丈夫です。\nもし可能であれば、人物と背景のレイヤーを分けていただければ助かります\n\n\n何卒、ご検討のほどよろしくお願いいたします。\nhttps://twitter.com/Kurosu_875/status/1584546201864908801\n\nhttps://twitter.com/Kurosu_875/status/1584546201864908801", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@yanahataso/works/10", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2432946, "client_id": 2274785, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/9a5012ea/uploads/origins/cb8ac95d-e425-40ab-9644-c03148ba322a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=aa47689c93f6624857a0f0a6f3b2b158", "srcset": "https://si.imgix.net/9a5012ea/uploads/origins/cb8ac95d-e425-40ab-9644-c03148ba322a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=aa47689c93f6624857a0f0a6f3b2b158, https://si.imgix.net/9a5012ea/uploads/origins/cb8ac95d-e425-40ab-9644-c03148ba322a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b07455fbf0165a7f72f67f5764edbfe6 2x, https://si.imgix.net/9a5012ea/uploads/origins/cb8ac95d-e425-40ab-9644-c03148ba322a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=6a86058c7954a433795b93c997d8c334 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/9a5012ea/uploads/origins/cb8ac95d-e425-40ab-9644-c03148ba322a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=363ae413b7c8038422a7762f3261a2a9", "srcset": "https://si.imgix.net/9a5012ea/upload