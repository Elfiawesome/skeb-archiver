お願いいたします。\n・作業量の増加等で金額の不足が生じる場合、金額修正依頼をお願いいたします。\n\n\n【使用用途】\n・Vtuber活動上での使用を予定しております。\n　Youtube（配信、サムネイル、動画等）、SNS（日々のポスト他）、FANBOX（先行公開用）、ネットプリント、歌枠リレー企画等での集合画像での使用など\n\n【その他ご依頼】\n・サムネイル等でも使用したく、出来る限り描画範囲内の見切れがない状態ですと有難いです。（しっぽが大きいので難しい場合はご放念ください）\n・情報に不足がございましたら大変恐れ入りますが、その際はisumisumi様の随意に補完いただけましたらと存じます。\n\n-----\nお忙しいところ恐れ入りますが、ぜひご検討の程よろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/1rsBDQVY1TGyJ5UmaXw6e5M126BHFOFLC?usp=drive_link", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@kururume/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "video", "tipped": false, "creator_id": 3223353, "client_id": 2945574, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/45184a9c/uploads/outputs/aa81a47f-1595-470d-a0bd-5bebcea7dd40?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&s=937706a71b775a2ac736a8de34074c9f", "srcset": "https://si.imgix.net/45184a9c/uploads/outputs/aa81a47f-1595-470d-a0bd-5bebcea7dd40?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&s=937706a71b775a2ac736a8de34074c9f, https://si.imgix.net/45184a9c/uploads/outputs/aa81a47f-1595-470d-a0bd-5bebcea7dd40?bg=%23fff&fm=webp&auto=compress&dpr=2&fit=crop&crop=top&w=200&h=200&s=40c9c5ccd37dc1fac465c691e458989f 2x, https://si.imgix.net/45184a9c/uploads/outputs/aa81a47f-1595-470d-a0bd-5bebcea7dd40?bg=%23fff&fm=webp&auto=compress&dpr=3&fit=crop&crop=top&w=200&h=200&s=1c4355b3bcb6d053923d1066ec72ac9f 3x"}, "duration": 4, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/45184a9c/uploads/outputs/aa81a47f-1595-470d-a0bd-5bebcea7dd40?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&blur=200&s=c2593650adbfb5067e03e80f4cfffacf", "srcset": "https://si.imgix.net/45184a9c/uploads/outputs/aa81a47f-1595-470d-a0bd-5bebcea7dd40?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&blur=200&s=c2593650adbfb5067e03e80f4cfffacf, https