/uploads/origins/44ea53d6-3a83-4c93-9b1a-76bf8f58f3d6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9b4ef984dbb92cb4ea2fa92fd4d955eb", "srcset": "https://si.imgix.net/46e06249/uploads/origins/44ea53d6-3a83-4c93-9b1a-76bf8f58f3d6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9b4ef984dbb92cb4ea2fa92fd4d955eb, https://si.imgix.net/46e06249/uploads/origins/44ea53d6-3a83-4c93-9b1a-76bf8f58f3d6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=0f67c363d81bd124745f2c91062f84b0 2x, https://si.imgix.net/46e06249/uploads/origins/44ea53d6-3a83-4c93-9b1a-76bf8f58f3d6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=28b0367a7cf09ac27b7fa200d2042466 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/46e06249/uploads/origins/44ea53d6-3a83-4c93-9b1a-76bf8f58f3d6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=75870e5f46b68539d78a37101f399ee0", "srcset": "https://si.imgix.net/46e06249/uploads/origins/44ea53d6-3a83-4c93-9b1a-76bf8f58f3d6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=75870e5f46b68539d78a37101f399ee0, https://si.imgix.net/46e06249/uploads/origins/44ea53d6-3a83-4c93-9b1a-76bf8f58f3d6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=18e1ad73f39262c2ed650ffe4a9b3d9d 2x, https://si.imgix.net/46e06249/uploads/origins/44ea53d6-3a83-4c93-9b1a-76bf8f58f3d6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=fbf428f843178c7ae6eb26a7594b21fd 3x"}, "body": "SNSのアイコン・ヘッダー等で継続的に利用するためのオリジナルキャラクターのデザイン資料をお願いさせていただきたくリクエストしました。\n\n添付画像のキャラクターをベースに、クリエイター様の絵柄・世界観でブラッシュアップした三面図（正面、側面、背面）をお願いできれば嬉しいです。\n用途は、今後アイコン・ヘッダー等を依頼する際のキャラクター資料です。\n\nこのキャラクターのコア要素の\n・茶髪\n・編み込みを含むツインテール\n・クラシカル／アンティーク系\n・上品でかわいらしい雰囲気\n・情報量多めの後ろ姿\nは残していただきたいです。\n\n一方で、\n・衣装ディテール\n・リボンの形状や配色\n・小物\n・アクセサリー\n・髪のボリューム感（どちらかというとボリュームは背面のみの画像のような多めのボリュームが良いです）\n・瞳の配色や表情\n・全体の色味バランス\n等は、クリエイター様の解釈でかなりアレンジしていただきたいです。\n\nツインテールのリボンは、既存資料では赤×黒ですが、キャラクターに合わせる形でピンク×黒、赤×白、赤×黒などからクリエイター様にお任せしたいです。\n\nまた、正面向かって左側の花の髪飾りは、既存資料の黒系ではなく、\u000bピンク系または赤系でお願いいたします。\n\n全体としては、既存資料のクラシカルなお嬢様感を残しつつ、クリエイター様の画風のようなダークでキラキラした雰囲気に寄せたデザイン\u000bにしていただけると嬉しいです。\nご検討いただけますと幸いです。\n\nhttps://drive.google.com/drive/folders/12vx50Uh6fuixpHcB0wtkZuN0YY5nczt1", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 138817, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "壽@skeb募集中", "screen_name": "bukitikikaku", "avatar_url": "https://pbs.twimg.com/profile_images/1377123448569307146/iebZ7W4B.jpg", "header_url": "https://pbs.twimg.com/profile_banners/938843350160982016/1677470029/1500x500", "appeal_receivable": true, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 7, "complete_expiration_days": 25, "skills": [{"genre": "art"}, {"genre": "comic"}, {"genre": "correction"}], "banned": false, "nc": 177}, {"id": 2857082, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "ぽめら♡通販開始", "screen_name": "pome_nanoda", "avatar_url": "https://pbs.twimg.com/profile_images/1934464195611049984/mGIquYtK.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1576766408901263360/1780229085/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "art"}, {"genre": "correction"}], "banned": false, "nc": 161}, {"id": 2858330, "creator": true, "nsfw_acceptable": true, "acceptable": false, "name": "せや", "screen_name": "rmya33", "avatar_url": "https://pbs.twimg.com/profile_images/14