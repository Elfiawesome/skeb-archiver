66-71c2fb05aa55?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=182b399dd0df9aa9a242f18c094a7709", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/176a3b44/uploads/origins/4670de88-44f5-4315-9066-71c2fb05aa55?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=7020102f52a7642e6de320c540fdf41a", "src_set": ""}, "body": "こんばんは！\nなしさんがskebを開かれたとのことで、ご依頼に参りました絢木です。\n\nなしさんの絵で雛菊が見たいなぁと思っていたので、改めまして自探索者の三城雛菊を描いて頂きたいです。\nこういった依頼することになれていないので、ふわっとした内容になってしまうのですが、\n・勝気に笑っている雛菊（服装は私服でも、ドレスでも、描きやすいもので大丈夫です）\nをお願いしたいです！\n＊服のカラーは、赤、黒、白、金系の色が多いです。\n\nあと、あわよくばのお願いなのですが、\n・雛菊とHO1君のツーショット？\nもお願いできたら嬉しいです……。\n並んで歩いてたり、一緒にご飯食べてる感じが見られたら、とても嬉しいです。\n\nいろいろお願いしてしまったのですが、なしさんの描きやすいように雛菊を描いて頂けたら嬉しいです！\n資料は参考資料URLに載せておきます。\nこれまでに描いた立ち絵などです。\n\nよろしくお願いいたします！\n\nhttps://drive.google.com/drive/folders/1PV62vr6XbdLv9RUyz0DL-XmCpl0A2cyH?usp=sharing", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@301i4_/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2762173, "client_id": 1939824, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/db5ef7a0/uploads/origins/6439b084-bbb0-43a1-b6fa-28d3281dd9cb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=72dc6ec4e04c9dc0e8127f67db5c2c49", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/db5ef7a0/uploads/origins/6439b084-bbb0-43a1-b6fa-28d3281dd9cb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=36445599c23d715d0c1f5518912c3baa", "src_set": ""}, "body": "こんにちは、いつもお世話になっております水野カズキです！\nなしさんの描かれるイラストが大好きで…あの少しほの暗く彩度が低いセンスの塊でしかないダウナーな絵柄が本当に好みで…もし、よろしければなしさんにうちの子を描いていただきたいです…！\n\n▼リクエスト内容\n・セッションで使用するような等身の高い全身立ち絵\n・立っているポーズ\n・ほのかに笑ってるぐらいの表情\n・そのほかに関しては全てお