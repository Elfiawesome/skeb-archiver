かったら前向きに検討していただければ思います。\nお忙しい中恐れ入りますが、よろしくお願いいたします。\n\nhttps://lit.link/sayaka_tukineko", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 2646621, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "じゅうね 餅　絵を描く", "screen_name": "junemoti_25", "avatar_url": "https://pbs.twimg.com/profile_images/1911630188997222400/GBZIzxpN.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1215168670881603590/1742281759/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 3, "complete_expiration_days": 15, "skills": [{"genre": "art"}], "nc": 129}, {"id": 2690647, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "カナタロ", "screen_name": "gobeeshi", "avatar_url": "https://pbs.twimg.com/profile_images/2014005188911411200/hSY-QiYl.jpg", "header_url": "https://pbs.twimg.com/profile_banners/930050027816329216/1748331142/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "art"}], "nc": 145}, {"id": 3209961, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "芳山/取引垢", "screen_name": "yoshiyama_kirin", "avatar_url": "https://pbs.twimg.com/profile_images/1824705635705032708/8UpSglJe.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1756922880695431168/1723878606/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 7, "complete_expiration_days": 90, "skills": [{"genre": "art"}], "nc": 0}, {"id": 3266513, "creator": true, "nsfw_acceptabl