r=3&fit=crop&crop=top&w=200&h=200&s=fd3bf9787dc0fd29e72b200718d4cbfe 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/91c28276/uploads/origins/16732999-1e6a-4f99-bbba-a71eaa77f282?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e8d8e09f73e2c40a0c809ce40d2c48ec", "srcset": "https://si.imgix.net/91c28276/uploads/origins/16732999-1e6a-4f99-bbba-a71eaa77f282?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e8d8e09f73e2c40a0c809ce40d2c48ec, https://si.imgix.net/91c28276/uploads/origins/16732999-1e6a-4f99-bbba-a71eaa77f282?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=86ab630d939e2f25ba8f79d3ff28b606 2x, https://si.imgix.net/91c28276/uploads/origins/16732999-1e6a-4f99-bbba-a71eaa77f282?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=a497e0672d8cf8321133833f44a24866 3x"}, "body": "初めまして！、素敵な作品を拝見させて頂き、是非にと依頼をお送りしました。\n今回依頼する内容は下記になります。\n\n依頼するキャラクター：私のOC、エレノア・バルトレット\n\n依頼するポーズ：全身が入っていれば問題なしです、描きやすい感じでお願いします！。\n\nそれでは、もし問題なければ、お願いします！。\n\nhttps://imgur.com/a/0LRxdGZ", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@kochikanaochan/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3586318, "client_id": 436697, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/92c68ea8/uploads/origins/c6a2376f-5105-46de-b741-12d0fc4a52ca?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1ef621245334f3874d9a82831db05a64", "srcset": "https://si.imgix.net/92c68ea8/uploads/origins/c6a2376f-5105-46de-b741-12d0fc4a52ca?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1ef621245334f3874d9a82831db05a64, https://si.imgix.net/92c68ea8/uploads/origins/c6a2376f-5105-46de-b741-12d0fc4a52ca?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ea3c40a58af061ae90bde049ff6ff13e 2x, https://si.imgix.net/92c68ea8/uploads/origins/c6a2376f-5105-46de-b741-12d0fc4a52ca?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f6500840a7c2b16aee6b3c7129cab25b 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/92c68ea8/uploads/origins/c6a2376f-5105-46de-b741-12d0fc4a52ca?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6a5361eb458c4cebac3851193cad9d42", "srcset": "https://si.imgix.net/92c68ea8/uploads/origins/c6a2376f-5105-46de-b741-12d0fc4a52ca?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6a5361eb458c4cebac3851193cad9d42, https://si.imgix.net/92c68ea8/uploads/origins/c6a2376f-5105-46de-b741-12d0fc4a52ca?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=9966055d17db7d8e714b8a47f61800fd 2x, https://si.imgix.net/92c68ea8/uploads/origins/c6a2376f-5105-46de-b741-12d0fc4a52ca?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=d0aa9c06b86b6fb3cb5b8ebbfc8444ac 3x"}, "body": "こちかなおさんこんにちは、イラストのリクエストをさせてください。\n描いていただきたいのは、私のOCの女子高生の柳瀬 葵です。\n彼女は寡黙で無表情、黒目がちで伏し目がち、目元が隠れるほど長い前髪を持つボブヘアーの女の子です。\n背中には透き通った鳥の羽のような不定形のオブジェクトがあり、彼女はこれを使って空を自由に飛ぶことができます。\n私の創作では糸で括った畳針を武器としていますが、これは小道具なので描かなくても問題ありません。\nリンク先の「基本資料」の色がベースカラーの参考資料ですが、リクエストのイラストでは自由な色を使っていただいて結構です。\n構図・ポージングは顔が写っていれば細かい指定はしませんので、こちかなおさんの得意な分野でお願いします。\nリンク先のナンバリングされた資料は彼女を描く自由度の幅を例示するものですが、この例の枠に収まらずとも問題ありません。\nよろしくお願いします。\n\n以下は彼女の性格などです。参考程度に。\n\n・多くのことに無関心で、誰に対してもほとんど無口。数少ない心を許した友達にだけ小さな話し声で会話する。\n・感情を表に出さないのは相手が動揺することを知っているため。激情に振り回されることに疲弊しきっており、問題の発端になるコミュニケーションを自ら絶ち切っている。\n\nhttps://drive.google.com/drive/folders/1HN6JOErQVmfhMYk-0ZV7-v8PJwyl0fPu?usp=drive_link", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@kochikanao