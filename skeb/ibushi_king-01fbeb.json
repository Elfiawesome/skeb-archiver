71ff?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=cc2f8b70f940b115363ebf05f557d851 3x"}, "body": "またこんにちは！『ファイアーエムブレム シャドウズ』に登場するリンディス（馬の耳と馬のしっぽがある方です！）に関する、もう一つのお願いがあります。\n\n『ファイアーエムブレム ブレイジングブレード』の、マークがリンディスと初めて出会うシーンを、マークの視点で描いてほしいのです！リンディスは小屋の中で、意識を失った戦略家を嬉しそうに看病し、元気にしてあげています！\nhttps://www.dropbox.com/scl/fo/6vuv3bq2dppqy63w93f1j/AGWW9vgGI3-pkFcntfipxBY?rlkey=c2nd7aruryykg3ge56ukrbous&st=8vanowo4&dl=0\n\nリンが主人公にスプーンで食べさせようとしているポーズを考えていました。リンの母性あふれる優しい一面を表現したかったんです！\n\nリンには馬の耳をつけてください（人間の耳は不可）。（見える場合は馬のしっぽも！）\nまた、リンの爪はピンク色に塗られている点にご注意ください！\n\n背景はリンの小屋でシンプルに描いてください！\n\nお読みいただき、ご検討いただきありがとうございます！\n\nhttps://www.dropbox.com/scl/fo/57n6zeezbbo2z3jmx73fx/AMp1iLzJK6EsbwKFHVqAC1U?rlkey=gpl9ckmztsdbfw4rqeutrk1m3&st=8lejxxeq&dl=0", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@ibushi_king/works/8", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 656890, "client_id": 1637177, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/489b46a6/uploads/origins/0c0c2f53-558a-4aed-ac87-fe28d054cbb0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2cddd2f1597dae7d1982c5a8fe5c15e5", "srcset": "https://si.imgix.net/489b46a6/uploads/origins/0c0c2f53-558a-4aed-ac87-fe28d054cbb0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2cddd2f1597dae7d1982c5a8fe5c15e5, https://si.imgix.net/489b46a6/uploads/origins/0c0c2f53-558a-4aed-ac87-fe28d054cbb0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=987bc34efbb1c38f87930c303af75fbe 2x, https://si.imgix.net/489b46a6/uploads/origins/0c0c2f53-558a-4aed-ac87-fe28d054cbb0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=93f19bc8e8907b01a1d3e1e55ac2d74c 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/489b46a6/uploads/origins/0c0c2f53-558a-4aed-ac87-fe28d054cbb0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ad3d93a414cb4df7f780b3aaab37ff09", "srcset": "https://si.imgix.net/489b46a6/uploads/origins/0c0c2f53-558a-4aed-ac87-fe28d054cbb0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ad3d93a414cb4df7f780b3aaab37ff09, https://si.imgix.net/489b46a6/uploads/origins/0c0c2f53-558a-4aed-ac87-fe28d054cbb0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=102aaedb3fd70b702a509c703192626f 2x, https://si.imgix.net/489b46a6/uploads/origins/0c0c2f53-558a-4aed-ac87-fe28d054cbb0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=6636e1686cd97729c7662f64945c2c50 3x"}, "body": "以前のリクエストと同様に、『Zenless Zone Zero』のビビアン・バンシー（Vivian Banshee）を題材にしたリクエストをもう一つお願いしたいです！\nhttps://skeb.jp/@ibushi_king/works/7\n\n『Mindscape 6』のアートに登場する彼女の衣装で、主であるワイズ（別名ロード・フェートン）のぬいぐるみを抱えている姿を描いていただきたいです！彼女は、ワイズがいない時、まるでワイズ本人であるかのようにそのぬいぐるみを愛し、大切にしています！\n\nポーズについては、ヴィヴィアンがまるで彼を守っているかのように、ぬいぐるみをぎゅっと抱きしめている姿をイメージしています！そのぬいぐるみに何があっても許しません！\n\n見える範囲であれば、青いペンダントも描いてください！\nhttps://www.dropbox.com/scl/fo/vzqlko9gqmnquacu2sqxc/AGeNUccUDNwTp4_hPdq5rco?rlkey=4i9ys3f39794zpf1qm9yqm9w7&st=v612orld&dl=0\n\nヴィヴィアンの左目の近くにほくろがあり、爪は黒く塗られている点にご注意ください。\n\n可能であれば、W-engineの「ヘアグロー」効果をヴィヴィアンにも適用してほしいです。\nhttps://www.dropbox.com/scl/fo/pv8qmzbw4giuldhbu1xyb/AGkgbb6leGVnsmhCCiD4p_k?rlkey=v0gq6i47vhh0n1fnfdyq8rh8j&st=hgd03t8f&dl=0\n\n背景は青空で構いません\n\nお読みいただき、ありがとうございます！\n\nhttps://www.dropbox.com/scl/fo/4gz2tec1hlqmfzg78r6u8/ANLQcGAFn6EK36eYokixaUU?rlkey=4p1x8n1jmaujxtliwwcuboekh&st=tsf83d8h&dl=0", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@ibushi_king/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 656890, "client_id": 1637177, "vtt_url": null, "thumbnail_image_urls": {"src": "http