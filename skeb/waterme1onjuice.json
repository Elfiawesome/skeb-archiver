nre": "correction", "default_amount": 500}], "acceptable_only_public": false, "tip_acceptable": true, "yearly_report_client_visible": false, "total_appeals_count": 0, "received_works": [{"path": "/@waterme1onjuice/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3291170, "client_id": 2009456, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/1e967540/uploads/origins/c93fbc07-71bb-436b-80a3-9f262d09cbc3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9f1fdeff0d3e7bc55e457eda24b11c7e", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/1e967540/uploads/origins/c93fbc07-71bb-436b-80a3-9f262d09cbc3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=29f50df3a64dffd14b8a83002a5fd5f8", "src_set": ""}, "body": "紫苑です、おかわりに来ました！よろしくお願いします。\n\n今回のリクエストはまたよその子となります。名前は愛及屋烏さん。カラスさんと表向きには名乗っています。親御様の許可と企画にて使用されたキャラシ一式を預かっておりますのでリンク先に添付いたします。詳細の説明は以下に。キャラシの立ち絵は2パターンありますが、黒髪の方が本来の姿になりますのでお願いしたいです……！\n\n【キャラクターの詳細】\n才能は殺し屋、年齢は16歳とのこと。悪を殺す悪人です。嘘を吐くこと、他人への加害を行う悪人やそれらの思想を酷く嫌い、排除するための殺しを行います。そしてその悪への嫌悪は自らも例外ではなく、自らが行っている殺しを決して正当化せず、自身もいつかは抹消されるべき悪であると認識しています。その反面、善性の相手には非常に穏やかで優しく、会話を好み、相手の意志を尊重する姿勢を見せます。悪である自分が善である相手に必要以上に干渉してしまうことは好みませんが、意見や助けを求められた時に振り払うことはせず、また進んで矢面に立つことやさり気なく世話をすることもあります。善性でありあまり強くない(特に幼さのある)人間が害されたり、道を踏み外すことを嫌っての行動と思われます。その上で相手からの好意や肯定的な対応は好まず、踏み込まれることも嫌います。\n恐らく本人自体が極めて強い善性と理想、ブレない道徳心を持った上で、それを全部ひっくり返して唯一で確実な解決として悪であることを選んでしまった人。選んだこと自体にも殺しにも後悔はなく、そこはかなりあっさりしています。\n身体能力は才能に見合って非常に高く、ナイフでも銃でも的確にターゲットを貫きます。殺すと決めた時に躊躇いはありません。\n身体的にも精神的にも非常に強い人ですが、精神の方は柔軟な強さではないので、ある側面では強いものの別の側面ではもろく繊細です。幼い自分の持った理想と正しさを今も抱えている人であり、自己矛盾を持っている人なので、常に自壊の危険性を孕んでいます。\n\n\n構図はいつも通りお任せいたします。上記の内容で問題なければ是非、お受けいただけると幸いです。\n\nhttps://www.dropbox.com/scl/fo/hgct4uxiiz71wqk0rf9gh/h?rlkey=r8c9hdaiz817mt7dpui275xuk&dl=0", "nc": 137, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@waterme1onjuice/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3291170, "client_id": 3655608, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/ffe9831d/uploads/origins/d9506891-6f76-4fe2-a690-cfafcf75606d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bb60b3546fc5182ff70a833f4c9cbc8a", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/ffe9831d/uploads/origins/d9506891-6f76-4fe2-a690-cfafcf75606d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=bc53b1ba859bd55eff1137d5ef9cfde8", "src_set": ""}, "body": "いつもお世話になっております！触手と申します。\n\nこの度は、天使音メ口ン様のPC、七野 海陸様を描いていただきたく思い、リクエスト送信させていただきました。\nシチュエーション、構図、サイズはお任せしたいです。\nご検討いただけますと幸いです！", "nc": 137, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@waterme1onjuice/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3291170, "client_id": 2009456, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/b351e0c6/uploads/origins/f523f032-0438-4502-af53-d950d464f8b5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=603038f292d54b264b7319559b85b2ac", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/b351e0c6/uploads/origins/f523f032-0438-4502-af53-d950d464f8b5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6ddce0498da2eeab58a7e97c4f0c3b1d", "src_set": ""}, "body": "いつもお世話になっております、紫苑です！今回は自分のキャラクター単体のリクエストに参りました。お時間ありましたら描いていただけると幸いです。\n\nキャラクター名：天音気生希\nリンクの先には企画の表シートと資料とイラストが1枚あります。\n\nキャラの詳細設定\n身長177cm、職業は葬儀屋。我が家の最大ギャグ値にいると思われる男。頭がだいぶお花畑かつ、思考回路がどっちらけ。冠婚葬祭は等しく人生の大切なイベントという亡き母の教えに基づき、葬式を結婚式と同じくらい大切な行事であると思い、また、葬式によっても結婚式と同じく人は家族になると思っている。さあ！葬式をしておれと家族になろう！不義の子であり、有名俳優である父には正妻と嫡男がいるが、それを気にしないどころか、病弱な母に夢を見せてくれた素晴らしい人認識をしている。し、いつか父や異母兄の葬式を自分が執り行って、正式に家族になるのが夢。全てにおいて思考がとち狂っているが、本人は大まじめ。なお、とち狂ってはいるが、母の誇りであり、自分の愛する葬儀屋という仕事を悪く言われることは嫌いで、死が纏わる以上そういう人もいる……ということは認識しているため、不要な時には自分の肩書きを隠している。おれは宝物は大事にしまって隠しておくたちなんだ。感情はそれなりに豊かなものの、表情筋が死滅しているため、無表情のまま笑い、泣く。その上に話し方も常に棒読み。ひたすらにマイペースかつ、伸び伸びとおおらか、呑気、能天気、遠慮も存在しない。ずぼらで好きなことは日向ぼっこ、寝ること、食べること。細かいことは気にしないを通り越して、細かくないこともさっぱり気にしない。そして裸族。外で裸だと通報されるために、一応は服を着ているが、まず一張羅。家では一切服なんか着やしない。産まれたままの姿こそ正義。おれは見せて恥ずかしいものなど何もないからね。結果リンク先の問題画像に繋がる。杖をついて歩いているものの、杖は病弱だった母の形見であって別に本人の足が悪い訳では無いし、正直サイズもあっていない。かえって転ぶのでは？\n\n構図はお任せしますが、キャラとしての適性はひたすらにギャグです。真顔の大ボケ感が伝わるととても嬉しい。\n\nhttps://www.dropbox.com/scl/fo/hpbnc85tvd4i0ey39vh2q/AF3PppVzLXa54BkGLLsC1Uo?rlkey=c49u3bquqapu0dde7t0qf1rj4&st=id4au6la&dl=0", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "similar_creators": [{"id": 105538, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "蟹江　9/21東6リ08a", "screen_name": "metyayurusu", "avatar_url": "https://pbs.twimg.com/profile_images/1607625673048477697/N-HO6Aj3.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1027539084074307584/1751106210/1500x500", "appeal_receivable": false, "popular_creator_rank": 100, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "skills": [{"genre": "art"}], "nc": 32}, {"id": 476955, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "ヒラガナ", "screen_name": "hiragana_100", "avatar_url": "https://pbs.twimg.com/profile_images/715584507504517125/b0oqUO-8.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1356358836/1628252305/1500x500", "appeal_receivable": true, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "skills": [{"genre": "art"}, {"genre": 