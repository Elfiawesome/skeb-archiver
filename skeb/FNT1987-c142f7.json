૭!\nはじめまして！\n\nホームページで偶然あなたのアートワークを見つけ、一目で完全に魅了されました！🙀 あなたのアートスタイルは本当に愛らしいです🥺。この作品は個人的に楽しむためのものです🤲。  \n\n**内容について:**\nあなたの創造力を自由に発揮してください！🤩\n\n**キャラクターについて:**\n- 性別：**男性\n- 年齢:** 17\n- 性格:**\n  主な性格:**臆病で恐がり、二次分身がいるためしばしば不安になる。一般的に陰気で内向的（表情はキャラクターシートの最初のページから参照できる）。  \n  二次人格：***短気で、攻撃的で、暴力を振るう傾向がある。  \n\nここまで読んでいただき、ありがとうございました！お引き受けいただけると嬉しいのですが、お忙しいところ本当にありがとうございました！(*°ω°*)ノ\"\n\nhttps://drive.google.com/drive/folders/10h9u-DfD8T5ttVRdbOSflzOGq_xMcoW6", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@FNT1987/works/14", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2701017, "client_id": 501332, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/7732aa6d/uploads/origins/720efba5-4772-4feb-b40e-261535a8e903?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=760ef877115ecd32d8afca61567f2783", "srcset": "https://si.imgix.net/7732aa6d/uploads/origins/720efba5-4772-4feb-b40e-261535a8e903?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=760ef877115ecd32d8afca61567f2783, https://si.imgix.net/7732aa6d/uploads/origins/720efba5-4772-4feb-b40e-261535a8e903?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b2c26b09c78e8aab28644b31f7b7a6c5 2x, https://si.imgix.net/7732aa6d/uploads/origins/720efba5-4772-4feb-b40e-261535a8e903?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ca575ec7a7752641b25df248aafb98e7 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/7732aa6d/uploads/origins/720efba5-4772-4feb-b40e-261535a8e903?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9da27a4250f05b2752dccb25da1ea3fe", "srcset": "https://si.imgix.net/7732aa6d/uploads/origins/720efba5-4772-4feb-b40e-261535a8e903?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=