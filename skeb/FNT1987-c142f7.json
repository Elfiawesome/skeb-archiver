。\n\nイリヤはジェンダーレスなキャラクターなので、男の子なのか女の子なのかは明らかではなく、この点だけが重要です。また、イリヤはやや筋肉質な腕をしている。\n\nイリヤは猫とロリポップが大好きだ。すべての参考文献の中で、『参考文献1★』と書かれたものが最も正確ですが、すべての参考文献をご自由にお使いください。\n\nhttps://drive.google.com/drive/folders/1MirevmXwDCprmRARCwLM8zxHLu4emB7B", "nc": 137, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@FNT1987/works/10", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2701017, "client_id": 25681, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/cef0e385/uploads/origins/ebb2def6-832d-4b85-a656-18359e701507?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=be276aab99ded1c93da7ebaea0242e1d", "srcset": "https://si.imgix.net/cef0e385/uploads/origins/ebb2def6-832d-4b85-a656-18359e701507?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=be276aab99ded1c93da7ebaea0242e1d, https://si.imgix.net/cef0e385/uploads/origins/ebb2def6-832d-4b85-a656-18359e701507?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=0e6814ee06d16d8eff5a01a55b278dba 2x, https://si.imgix.net/cef0e385/uploads/origins/ebb2def6-832d-4b85-a656-18359e701507?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a07934af82be4ed29fb6c7616d69be76 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/cef0e385/uploads/origins/ebb2def6-832d-4b85-a656-18359e701507?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c19b9445112435ad88b5b2a680e5d561", "srcset": "https://si.imgix.net/cef0e385/uploads/origins/ebb2def6-832d-4b85-a656-18359e701507?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c19b9445112435ad88b5b2a680e5d561, https://si.imgix.net/cef0e385/uploads/origins/ebb2def6-832d-4b85-a656-18359e701507?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur