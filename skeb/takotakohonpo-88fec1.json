。\n構図等はぷちだこ様におまかせしたいと考えております。\n(むちもち体型ロリ顔の女の子がお好きとのことでしたので、ぷちだこ様の好きを詰め込んで楽しんで制作いただけたりすると嬉しいなぁと思ったりしております。）\n\n配信・動画用のサムネイルやSNSで使用させて頂きたく考えております。\n(作品を頂く際に、背景等描いて下さった際はお手数をお掛けしますが透過画像を頂けますと嬉しいです！)\n\nご機会があればどうぞよろしくお願い致します。\n\n＜参考にして頂ければ…！＞\n資料\nhttps://x.com/shiraganegi_sai/status/1699065866418295161?s=20\n\n自己紹介動画\nhttps://youtu.be/W8Y3FUXgHfE", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@takotakohonpo/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1988059, "client_id": 472094, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/c07b1272/uploads/origins/9946d065-c804-4a00-97b1-d480221f8222?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7e3712371004729ebbb00ebfc89c96d8", "srcset": "https://si.imgix.net/c07b1272/uploads/origins/9946d065-c804-4a00-97b1-d480221f8222?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7e3712371004729ebbb00ebfc89c96d8, https://si.imgix.net/c07b1272/uploads/origins/9946d065-c804-4a00-97b1-d480221f8222?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=2f4340774ac2c57080d92a7216df6ac3 2x, https://si.imgix.net/c07b1272/uploads/origins/9946d065-c804-4a00-97b1-d480221f8222?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d93ea37e6740820d8a82cfebfe09921a 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/c07b1272/uploads/origins/9946d065-c804-4a00-97b1-d480221f8222?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=48d3dfeda782fa42caa42b9e572147ec", "srcset": "https://si.imgix.net/c07b1272/uploads/origins/9946d065-c804-4a00-97b1-d480221f8222?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=48d3dfeda782fa42caa42b9e572147ec, https://si.imgix.net/c07b1272/uploads/origins/99