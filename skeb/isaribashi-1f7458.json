g=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=08307171fbc901afdc6dcfc5596f34c6 3x"}, "body": "初めまして斜さん、初リクエスト失礼します。\n\n過去にファントムオブキル等の絵を描かれているのを見てこうしてリクエストを送らせてもらってます。\n\n今回描いてもらいたい絵はファンキルのピサール(海上編)の絵をお願いします。\n\n夕日の海を背景にこちらに振り向くピサールの絵を描いてもらいたいです。\n\n斜さんが過去に描いていたアーミヤの絵がイメージに近いですね。\n\n表情やポーズに指定はありませんので\n\nよろしくお願いします！", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@isaribashi/works/17", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 150425, "client_id": 830787, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/3578a77e/uploads/origins/76eb80e7-45f1-4414-b8d8-5d546438a588?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5cdcacde326fe2e5de3afe58ccefb7ed", "srcset": "https://si.imgix.net/3578a77e/uploads/origins/76eb80e7-45f1-4414-b8d8-5d546438a588?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5cdcacde326fe2e5de3afe58ccefb7ed, https://si.imgix.net/3578a77e/uploads/origins/76eb80e7-45f1-4414-b8d8-5d546438a588?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=bc709bed7283b1d36912aa4a41faa865 2x, https://si.imgix.net/3578a77e/uploads/origins/76eb80e7-45f1-4414-b8d8-5d546438a588?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=1e0140cf63ea2b9bc2d450dbf64045aa 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/3578a77e/uploads/origins/76eb80e7-45f1-4414-b8d8-5d546438a588?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=958404ea1d3ce65d3bb6996b5157c359", "srcset": "https://si.imgix.net/3578a77e/uploads/origins/76eb80e7-45f1-4414-b8d8-5d546438a588?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=958404ea1d3ce65d3bb6996b5157c359, https://si.imgix.net/3578a77e/uploads