のデザインを入れてもいいです！\n\n重要：\n私とボーイフレンドの目の色はミントグリーン！\n私の髪はキャラメルブロンド、ボーイフレンドの髪は茶色がかったブロンド！\n私のボーイフレンドの服には \"Y \"の文字が、女の子の服には \"R \"の文字がスカートにあったらいいのに！\n\nもう一つの服は、「修道女」の服を見本にしたい！ 襟とスカートのデザインが好きだから、私の服にも加えてほしい！ 靴下は、片方は長い靴下、もう片方はリボンのアンバランスなデザインにしてほしい！ 靴は、私の服に合うように、あなたが一番いいと思うデザインにしてください！\n\nリボン、レース、カメリアは、私の新しい服にぴったりのアイテムよ！\n\nマスコットはレッサーパンダにします！私の髪のような明るい茶色に変えてください！私の美的感覚に合うように、マスコットにも似たようなアイテムを追加してください！\n\nスケッチ・スケブのアイコンもお願いしたいです！\n彼女の姿勢はあなたが決めてください！\n\n私の要望を考慮してくれて本当にありがとう！\n\nhttps://drive.google.com/file/d/1U-XcuRQJyvwo7QyWkPFNbUTXXvSrRoMr/view?usp=drive_link", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@lxomoo/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3045199, "client_id": 2776436, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/8f8c83de/uploads/origins/97f6f6fc-57ad-4c0d-8f70-86a80167b9ef?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=99b33c5b2117cca03a9ecbab7723aabf", "srcset": "https://si.imgix.net/8f8c83de/uploads/origins/97f6f6fc-57ad-4c0d-8f70-86a80167b9ef?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=99b33c5b2117cca03a9ecbab7723aabf, https://si.imgix.net/8f8c83de/uploads/origins/97f6f6fc-57ad-4c0d-8f70-86a80167b9ef?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=9a75c3ce00999e1cc1ba78244d4b2dff 2x, https://si.imgix.net/8f8c83de/uploads/origins/97f6f6fc-57ad-4c0d-8f70-86a80167b9ef?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=daaa2a2de2185c2448e41caeab68e488 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/8f8c83de/uploads/origins/97f6f6fc-57ad-4c0d-8f70-86a80167b9ef?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=408972ff773a9802f57f42227300b3bb", "srcset": "https://si.imgix.net/8f8c83de/uploads/or