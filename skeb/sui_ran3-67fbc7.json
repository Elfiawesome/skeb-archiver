nまた、白衣とナース帽はそのまま着衣でお願いいたします。\n\nポーズや表情はおまかせいたします。\n酔藍様の思う不調シノの姿が見たいです...！\n\n【その他お願い】\n・表情差分があるととても嬉しいです。\n・頭や前後左右、髪が見切れないようにお願いいたします。\n・背景と人物を分けた透過画像もいただきたく存じます。\n\n三面図、立ち絵の資料となりますが、Googleドライブにて共有させていただきます。\n\nお忙しいところ恐れ入りますが、何卒よろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/1k5WGMi3xkq03eAFTGVOcw27gVqfeK0YF", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 2121283, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "蟹鍋もぐ美@固ツイ依頼募集中", "screen_name": "honobono_1717", "avatar_url": "https://pbs.twimg.com/profile_images/1906906567750168576/h_8872nZ.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1114466959247073280/1763910024/1500x500", "appeal_receivable": true, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 10, "complete_expiration_days": 100, "skills": [{"genre": "art"}], "banned": false, "nc": 49}, {"id": 2590674, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "けにぃ＠skebでリクエスト募集中", "screen_name": "KennyMuseum", "avatar_url": "https://pbs.twimg.com/profile_images/1753421452207169536/QL2C0-5l.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1211622859744763906/1774976646/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "art"}, {"genre": "correction"}], "banned": false, "nc": 128}, {"id": 3018451, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "綾瀬ゆずり", "screen_name": "miffy_mofmo", "avatar_url": "https://pbs.twimg.com/profile_images/1923589386299400192/sK4dMWGU.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1530087741840834560/1709370675/1500x500", "appeal_