ラと芹澤瑠依の二人絵を描いていただきたいです！\n\nエレオノーラは少しヤンデレ風でも構いませんので、独占欲のある雰囲気で描いていただけたら嬉しいです。構図やサイズ、ポーズなどはすべて先生の自由にお任せします！\nでも、もしエレオノーラが瑠依を舐めたり噛んだりする描写があったら、すごく嬉しいです！\n\n解釈も自由です！\n\nフォルダの中から気に入った衣装を選んでもいいですし、先生が好きな服を描いてくださっても嬉しいです！全部お任せしちゃいます！\n\nもしご都合が合いましたら、ぜひご依頼をお受けいただけますと幸いです！\n\nエレオノーラ:\nhttps://drive.google.com/drive/folders/1FjjHyog6Z0Yd-YWjC2HsX3y0CIyFTgZR\n芹沢瑠依：\nhttps://drive.google.com/drive/folders/1Fgcjq6TuvSNzCNTYA6cIlp_4pfo6wLk0", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@4iranai/works/7", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/31a9a13e/uploads/origins/b8cc5321-19b4-42e4-aacb-6a008d8c7d13?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=6522a3cbbe3eca1a2e1824c90c57db5e", "srcset": "https://si.imgix.net/31a9a13e/uploads/origins/b8cc5321-19b4-42e4-aacb-6a008d8c7d13?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=6522a3cbbe3eca1a2e1824c90c57db5e, https://si.imgix.net/31a9a13e/uploads/origins/b8cc5321-19b4-42e4-aacb-6a008d8c7d13?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=dee4f2c2692994d712e33660eae3df29 2x, https://si.imgix.net/31a9a13e/uploads/origins/b8cc5321-19b4-42e4-aacb-6a008d8c7d13?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=316c3d4bac50473190f6ed4af4fd4a84 3x"}, "private": true, "genre": "art", "tipped": false, "creator_id": 3862904, "nc": 1}, {"path": "/@4iranai/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3862904, "client_id": 26