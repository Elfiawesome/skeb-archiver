しても体型がほとんど変わらないのですが‥巨乳化して下さい。\n背も極めて低いですが、頭身もある程度上げて頂いて構いません。\nhttps://x.com/Matsunoyu_Bom2/status/1264086025040617473\n\n髪型はそのまま、顔は元の雰囲気を残しつつ、まつ毛をピンと伸ばし、そこはかとなく女の子っぽさを感じさせるような感じでお願いしたいのですが、可能でしょうか。\n\nまた元のコマではすでに服を全部脱ぎ捨てた状態ですが、法被とサラシをはだけて胸を、短パンをブリーフごとずり下ろして股間を露出した半脱ぎ状態で描いて頂けると嬉しいです。\n服の色は下記単行本表紙を参考でお願いします。\nhttps://www.fukkan.com/fk/CartSearchDetail?i_no=68332670\n\nよろしくお願いします。", "nc": 33, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@iwasicco/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 365153, "client_id": 97802, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/91d688f3/uploads/origins/82e31695-6449-4d59-8d7c-93d5a47c1c3e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=64e919ec0b74669899127036f001024a", "srcset": "https://si.imgix.net/91d688f3/uploads/origins/82e31695-6449-4d59-8d7c-93d5a47c1c3e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=64e919ec0b74669899127036f001024a, https://si.imgix.net/91d688f3/uploads/origins/82e31695-6449-4d59-8d7c-93d5a47c1c3e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=0cfbf94a5cca72f09eb143d6a456d136 2x, https://si.imgix.net/91d688f3/uploads/origins/82e31695-6449-4d59-8d7c-93d5a47c1c3e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a10d1fcbfd120fb0595ee9ec258126b6 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/91d688f3/uploads/origins/82e31695-6449-4d59-8d7c-93d5a47c1c3e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0ab636d7edec39bbac2145b3505e9df6", "srcset": "https://si.imgix.net/91d688f3/uploads/origins/82e31695-6449-4d59-8d7c-93d5a47c1c3e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0ab636d7edec39bbac2145b3505e9df6, https://si.imgix.ne