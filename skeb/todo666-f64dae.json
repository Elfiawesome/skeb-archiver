&h=200&s=6343647ac023a08c9ac96eccc60f3ed5 2x, https://si.imgix.net/5b698d68/uploads/origins/73e1f5f4-c4dd-410e-9979-1fa608534f92?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=4e0de8672ef47ff4a40ec04f699bdf9c 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/5b698d68/uploads/origins/73e1f5f4-c4dd-410e-9979-1fa608534f92?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=dfa10e539217ad19c05cf81fc481eaf2", "srcset": "https://si.imgix.net/5b698d68/uploads/origins/73e1f5f4-c4dd-410e-9979-1fa608534f92?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=dfa10e539217ad19c05cf81fc481eaf2, https://si.imgix.net/5b698d68/uploads/origins/73e1f5f4-c4dd-410e-9979-1fa608534f92?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=9afe5f6664c8b10dc35553a75d60e1ec 2x, https://si.imgix.net/5b698d68/uploads/origins/73e1f5f4-c4dd-410e-9979-1fa608534f92?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=577e64ccf8d41fce8c7865230a2ee340 3x"}, "body": "こんにちは！僕のOCのカズマの依頼をお願いできないでしょうか？\n\n彼は16歳の孤児のファイヤーベンダーで、態度が悪く、意地悪そうな外見をしています。野生の猛獣を狩っていたため、体には引き締まった筋肉と様々な傷がある。\n\n彼の最も特徴的な外見は、黒く痩せた蛇のような瞳孔である。また、口を開けると鋭い歯が見える。\n\nとがったブリーチブロンドの髪で、サイドを結んで垂らしている。また、黒いバンダナで額を覆い、後ろから結んでいる。\n\n破れた紺と白のサムライ・ギをよく着ているが、上半身が欠けており、シャツには小さな切り傷がある。また、バンダナに合わせて白い靴下に黒いサンダルを履いている。\n\nまた、彼がファイヤーベンディングを使って戦っているポーズを複数描いてください。\n\nそれと、キャンプファイヤーの横に座って、一人で焼いた肉を食べている絵もお願いします！\n\nよろしくお願いします！\n\nhttps://drive.google.com/drive/folders/1ZFhUbaIuKH2-j62OQSBv_dEV8Jj3405x?usp=sharing", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@todo666/works/10", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2331812, "client_id": 375679, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/0a02