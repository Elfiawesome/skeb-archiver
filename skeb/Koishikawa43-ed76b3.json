3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1310805975851433989%2F9Uq_VRGn.jpg?blend64=aHR0cHM6Ly9za2ViLWF2YXRhci5pbWdpeC5uZXQvfnRleHQ_&blendalpha=100&blendalign=center&blendmode=normal&blendsize=inherit&bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=721ab5c7f4bf6ba5c96e52b048be62bd 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1310805975851433989%2F9Uq_VRGn.jpg?blend64=aHR0cHM6Ly9za2ViLWF2YXRhci5pbWdpeC5uZXQvfnRleHQ_&blendalpha=100&blendalign=center&blendmode=normal&blendsize=inherit&bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=92340d507ffc1e75ffd16148c7c964cb", "srcset": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1310805975851433989%2F9Uq_VRGn.jpg?blend64=aHR0cHM6Ly9za2ViLWF2YXRhci5pbWdpeC5uZXQvfnRleHQ_&blendalpha=100&blendalign=center&blendmode=normal&blendsize=inherit&bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=92340d507ffc1e75ffd16148c7c964cb, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1310805975851433989%2F9Uq_VRGn.jpg?blend64=aHR0cHM6Ly9za2ViLWF2YXRhci5pbWdpeC5uZXQvfnRleHQ_&blendalpha=100&blendalign=center&blendmode=normal&blendsize=inherit&bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=4ab1631d6ca0c3c45905b28e2867a9d3 2x, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1310805975851433989%2F9Uq_VRGn.jpg?blend64=aHR0cHM6Ly9za2ViLWF2YXRhci5pbWdpeC5uZXQvfnRleHQ_&blendalpha=100&blendalign=center&blendmode=normal&blendsize=inherit&bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=f8967db43f4be868c5d923a2f18f98ce 3x"}, "body": "こんにちは。応援を兼ねてリクエストをお送りいたします。\n\nWTRPG10ファナティックブラッドをベースにした半オリジナルエピソードをお願いします。\n当時、こんなことを考えていたなぁというアイデアの切れ端を集めたリクエストです。\n当時の私のアイデアは使われていないものも多いので、あくまで似た世界の別物です。\n\n●概要\nデュミナス開発の物語です。\nCTSのKV開発シナリオをイメージしていただければと思います。\n1幕（オープニング相当）　火星での戦いにおけるドミニオンMk.V（≠ガルガリン）の活躍から新型CAMの開発依頼\n2幕（PCのアイデア出し）　英国アワフォード社と日本の三葉重工の技術者の会議\n3幕　デュミナス試作機のデモンストレーション\n\n●登場人物\n・ジェイラス・タルボット（男　37歳）\n英国のモデルエンジニアリング界の奇才。アワフォード社の工作機械ユーザー。\n顧客リストからアワフォード社にスカウトされる。\n手段の為に目的を選ばず、「巨大人型機械が作れそうだから」とCAMを提案し、ドミニオンシリーズの基礎設計を行った。\n\n・アージア・ゼッピ（女　28歳）\n大学で材料工学を学んだイタリア人。大手メーカーに就職したが直言居士の石頭で馴染めず退社。\n退職後はアクセサリー制作で生計を立てていたが、顧客リストからアワフォード社にスカウトされる。\nジェイラスの無茶な設計に耐える材料の開発・調達に走り回った。\n\n・超電気Ｐ（ピコピコ動画の動画配信者）\nリモートでアワフォード社に勤務する日本人技術者。メッセンジャーを使ってネットスラング盛々の会話をする。\nプログラム制御のエキスパート。社内でも直接会った人間は少なく、投稿する動画は手元の動画と字幕だけで、年齢性別ともに不詳。\nCAMの操縦系を開発した。\n\n・久坂　真（男　40歳）\n三葉重工の技術者。10式戦車開発にも参加した兵器開発技術者。\nアワフォード社の個性的すぎるメンバーに振り回される真面目なジャパニーズサラリーマン。\n\n●設定\n・ドミニオンMk.V\n火星探査用に改装された作業機。12.7mm機関銃などの人間以上戦車未満の銃器類が搭載し、クレーンやドリル、排土板などの工具ツールが武装に流用された。\nマブラヴにおけるFP兵器ハーディマンのような立ち位置。\n（※ガルガリンとナンバリングが被っていますが、虚動のページに旧設定が残っています）\nhttps://www.wtrpg10.com/event/bt003/1\n\n・12試戦闘装甲機\nデュミナス試作機。2012年度の試作機の意味。R6M2bという型番を含め、ゼロ戦（A6M2b）モチーフでした。\n\n●書いて欲しいシーン\n・1幕\n装甲車は搭載した機関銃で接近するVOIDの装甲・生命力を削りきれず、接近戦で次々に撃破される\nCAMは人型を活かしたフットワークでVOIDの攻撃を避けつつ、近接武器（クレーンやドリル、排土板）で牽制し、前線の構築に成功する。RPGでいうところのタンク（壁役）である。\n\n・2幕\nマラトンの戦いではペルシャ軍弓兵の攻撃に対し、アテナイ軍重装歩兵は駆け足で潜り抜けて勝利した\n近現代戦は投射兵器が白兵戦に優越するので、機関銃に刀槍で突撃すれば蜂の巣になる\n「射撃と運動」ドクトリン。弾幕で敵の射撃を牽制し、より有利な射撃位置へ移動する\n\nしかし、アテナイ軍と同じように投射兵器を無効化できるなら白兵戦は再び有効となる\nVOIDは装甲と生命力の強さによって投射兵器を突破する\nCAMは偶然にも白兵戦の歩兵としての役割を担うことができた\nCAMは本来、歩兵支援の装甲と火力を運ぶだけのもの。形式自由だったので作れそうだった人型にした\n火星の戦果は瓢箪から駒だった\n\n重武装化したドミニオンMk.IVbも開発されているが、元々別用途のドミニオンの改良機では心許ない\n主力兵器たる対VOID用CAMの必要性\n重装甲化と出力の向上、白兵戦に対応する各部パーツの強化。その為の一回り大きな８ｍサイズ\n武装は既存製品を改良して搭載する。アサルトライフルにマウザーMk30、分隊支援火器（ガトリング砲）にGAU-8アヴェンジャー、スナイパーライフルにロイヤルオードナンスL7、対VOIDミサイルにFGM-148ジャベリン\n既存製品のないCAM用カタナ、コンバットナイフ、シールドはもっとも苦戦するところだがCAMの肝でもある\n白兵攻撃のモーションデータは大手特撮スタジオの殺陣師の友人に依頼する\n\n・3幕\n数カ月後、富士での演習で試作デュミナス登場\nCAMの役割は前衛の戦士、戦車は機動力のある弓兵、砲兵は魔法使い、航空機は召喚獣\n役割分担の中でCAMはしっかりと仮想VOIDの撃破に貢献する\n諸兵科連合で活躍するかっこいいCAM描写をお願いします", "nc": 25, "word_count": 4747, "transcoder": "text", "creator_acceptable_same_genre": false}, {"path": "/@trill_oshigoto/works/17", "private_thumbnail_image_urls": null, "private": false, "genre": "novel", "tipped": true, "creator_id": 734894, "client_id": 1509710, "vtt_url": null, "thumbnail_image_urls": {"src": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1310805975851433989%2F9Uq_VRGn.jpg?blend64=aHR0cHM6Ly9za2ViLWF2YXRhci5pbWdpeC5uZXQvfnRleHQ_&blendalpha=100&blendalign=center&blendmode=normal&blendsize=inherit&bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=97db01db26d58e4cb302bc1415c0d74c", "srcset": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1310805975851433989%2F9Uq_VRGn.jpg?blend64=aHR0cHM6Ly9za2ViLWF2YXRhci5pbWdpeC5uZXQvfnRleHQ_&blendalpha=100&blendalign=center&blendmode=normal&blendsize=inherit&bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=97db01db26d58e4cb302bc1415c0d74c, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1310805975851433989%2F9Uq_VRGn.jpg?blend64=aHR0cHM6Ly9za2ViLWF2YXRhci5pbWdpeC5uZXQvfnRleHQ_&blendalpha=100&blendalign=center&blendmode=normal&blendsize=inherit&bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=7fb170c9b7458a6b2394055a20bf5521 2x, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1310805975851433989%2F9Uq_VRGn.jpg?blend64=aHR0cHM6Ly9za2ViLWF2YXRhci5pbWdpeC5uZXQvfnRleHQ_&blendalpha=100&blendalign=center&blendmode=normal&blendsize=inherit&bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=6c8f4bec6c0177e3dfcc9744ae715642 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1310805975851433989%2F9Uq_VRGn.jpg?blend64=aHR0cHM6Ly9za2ViLWF2YXRhci5pbWdpeC5uZXQvfnRleHQ_&blendalpha=100&blendalign=center&blendmode=normal&blendsize=inherit&bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=cfc43aac41c06a70c8711bf4d48c4ac9", "srcset": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1310805975851433989%2F9Uq_VRGn.jpg?blend64=aHR0cHM6Ly9za2ViLWF2YXRhci5pbWdpeC5uZXQvfnRleHQ_&blendalpha=100&blendalign=center&blendmode=normal&blendsize=inherit&bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=cfc43aac41c06a70c8711bf4d48c4ac9, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1310805975851433989%2F9Uq_VRGn.jpg?blend64=aHR0cHM6Ly9za2ViLWF2YXRhci5pbWdpeC5uZXQvfnRleHQ_&blendalpha=100&blendalign=center&blendmode=normal&blendsize=inherit&bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=891d90d1d268a7c171216691529fc74d 2x, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1310805975851433989%2F9Uq_VRGn.jpg?blend64=aHR0cHM6Ly9za2ViLWF2YXRhci5pbWdpeC5uZXQvfnRleHQ_&blendalpha=100&blendalign=center&blendmode=normal&blendsize=inherit&bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=36dd573b5f416f6e61e967aa9034dfcf 3x"}, "body": "おひさしぶりです。\nアニメ・マブラヴの感想ツイートを探している中でとりるMSのSkebの募集ツイートを発見いたしました。\nそこで思い立ってリクエストをお送りいたします。\n\n●概要\nマブラヴとWTRPG7「CATCH THE SKY」のクロスオーバー。\nCTS世界に転移した白銀武が傭兵となって、バグアと戦うお話。\n\n●コンセプト\n「主人公が一人だけのCTS世界」。\n多数のPCに活躍を分散させることを前提とするWTRPGの枠を超えて、ものすごく強くてヒロイックな主人公・白銀武がシェイドに乗ったバグアに単機でライバルとして挑み続け、ついに最終決戦に望みます。\n自重しない強い主人公たちをお願いします。\n\n●前提となる物語\n平和なマブラヴEX世界で暮らしていたはずの白銀武は、目を覚ますと異星人バグアに侵略されているCTS世界にいた。\nありふれた難民として保護された武は、検査によってエミタ適合手術の適格者であることが判明すると、能力者の傭兵としてラストホープへ。\nラストホープで出会ったのはよく見知った冥夜、委員長、彩峰、たま、美琴の5人であった。\nいずれも能力者の傭兵であり、6人で結成した小隊は各地で依頼をこなしていた。\n\n傭兵として活躍していく中で、神宮司まりもがカンパネラ学園で教師をしていたり、香月夕呼が未来科学研究所にいることなどを知る。\nしかし、幼馴染の鑑純夏だけはどこにもいないことに気づいた武がその名を口にすると、周囲の反応は驚愕であった。\n「鑑純夏」は数千万Ｃの賞金がかけられたバグアの指揮官の一人であったからだ。\n\nそこから紆余曲折を経て、何度も純夏の姿と名前を持つバグアに挑みながら、武は純夏を自分の手でバグアから解放することを決意していく。\n\n●全体の設定\nCTSの世界ですが、細かい部分で色々と違います。基本的にWTRPG7本編とは別の並行世界であり、マブラヴの要素が大きく混ざっている世界です。\n銀河重工の重役に御剣雷電や御剣悠陽がいたり、未来科学研究所に香月夕呼博士がいたり、有力なバグアの一人に鑑純夏がいたりします。\n素人でも簡単にKVを動かせる世界観は同じですが、センスや経験によって大きな差が生じます（CTSゲーム上では横並びでした）。\n白銀武はUPC軍や傭兵の間ではとても有名な天才KVパイロットとして活躍しています。\n\n\n●人物\n・白銀武（搭乗機　F-204G　タケミカヅチ）\n　異世界転移してきたＥＸ世界の武。アンリミテッドの世界観では浮いていたが、CTSの傭兵としてはそれほど珍しくもない。\n　搭乗機はスレイヤーのカスタム機。宙空変形スタビライザーによる三次元空中格闘戦術は武のもっとも得意とするところである。\n　バグア純夏との最終決戦の為に香月博士の開発した『因果律再構成装置』を搭載する為、銀河重工で大幅な改装が行われている。型番のGは銀河重工のGであり、タケミカヅチは武の思いつきの名前である。\n・御剣冥夜（搭乗機　シコン実験機）\n　銀河重工の母体の一つとなった旧御剣財閥総裁・御剣雷電の孫娘。草壁誠十郎などとも顔見知り。\n　搭乗するシコン実験機は、固定武装「種子島」をミカガミの「雪村」に換装した実験機。\n\n・香月夕呼\n　未来科学研究所所属。この世界でも因果律量子論を研究する科学者であり、その名声はスチムソンやブレストに並ぶ。因果律量子論に基づいた『因果律再構成装置』を開発した。\n　無限に分岐している可能性世界において、鑑純夏がバグアのヨリシロにされた因果よりも、鑑純夏が鑑純夏そのものであることの因果のほうが強いと予想される。築地多恵を猫にしたように、現在のバグア純夏に収束する前の確率の状態に戻すことで、純夏が純夏である因果を引き寄せて純夏の中のバグアを排除しようという作戦である。\n・草壁誠十郎\n　銀河重工のKV開発主任。タマモの開発で忙しい時期なのに、冥夜と夕呼にひっぱり出されて、武のスレイヤーの改装作業をさせられた。夕呼の開発した『因果律再構成装置』を兵器に転用した『天之瓊矛』（あめのぬぼこ）を完成させる。これは機体の胸部内蔵式の照射兵器となっている。\n\n・鑑純夏\n　CTS原作におけるエミタ・スチムソンのような立ち位置。その仕草やふるまいは鑑純夏を完全に模しているが、行動原理はバグアそのものである。\n　メトロポリタンX陥落時にヨリシロにされる。その後は東京陥落でのシェイド初陣からシェイドとともに各地で猛威を奮ってきた。\n　武が優秀なパイロットであることから、ファーストコンタクトから「タケルちゃんは私のもの」と執着を見せている。それがバグアの優秀なヨリシロを求める欲求であるのか、鑑純夏の記憶に引きずられたものであるのかは判然としない。\n\n\n●書いてほしいシーン\n冥夜をはじめとする仲間たちの助けにより、武はバグア純夏のシェイドと1対1の状況に持ち込むことができた。\n飛行形態での激しいドッグファイト、そこに織り交ぜられる人型での空中格闘戦！\n\n戦いながら武は思い出す。この世界に来た時のことを、純夏が世界の敵とされていることを、純夏を取り戻そうと何度もバグア純夏のシェイドに挑んだことを、それを仲間たちが助けてくれたことを。\n今度こそ取り戻すと決意を持ち、まずはシェイドの無力化を果たすべく挑んでいく。\n\n再び思い出す。\n香月夕呼が語った因果律再構成装置によって純夏を取り戻せる可能性についての説明を。\n草壁誠十郎が因果律再構成兵器『天之瓊矛』はシェイドの装甲を貫通する力はなく、対象に直接照射する必要があると忠告したことを。\n\nスレイヤーを大幅改装したタケミカヅチはバグアの象徴であるシェイドを確実に追いこんでいく。\n「さすがは私のタケルちゃん！　絶対にヨリシロにしてみせるよ！」\n「純夏のフリをするなあああぁぁっ！！」\n言葉と感情をぶつけ合う積年のライバルである二人。\nついに武の空中斬撃がシェイドを捕らえ、2機はもつれあうように地上に墜落する。\n陽動した敵を撃墜して、武の援護に向かっていた冥夜がその様子を見ることになる。\n\n墜落のショックで一瞬意識を失っていた武だが、すぐさま『天之瓊矛』を照射するべく撃墜したシェイドのハッチをこじ開けようとする。生身のバグア純夏から携帯光線銃による反撃を受ける。\n上位のバグアは生身でも強い。『天之瓊矛』が使えるのは一度きり。迂闊に撃っても回避されるだけ。\nそこに生身の冥夜が駆け付けた。SES改造した皆琉神威でバグア純夏を引き付ける。今なら狙えるが冥夜も巻き込んでしまう。\n「撃てっ！　武っ！　私も純夏も必ずそなたの元へ帰ってくる！」\n逡巡する武に冥夜の喝が飛ぶ。\n発射される『天之瓊矛』。バグア純夏も冥夜も収束前の確率状態に戻される。\n純夏と冥夜を取り戻すのは因果律と武の想いである。\n武の必死の想いが届き、冥夜と純夏は確率状態から帰ってくるのであった。\n\n●一言\n長いお話のクライマックスだけ書いていただく感じです。\nよろしくご検討お願いいたします。\nNSFWは指定があったからです。\n\nhttp://www.wtrpg7.com/worldguid/worldguide04-1e.html#1", "nc": 177, "word_count": 5181, "transcoder": "text", "creator_acceptable_same_genre": false}, {"path": "/@trill_oshigoto/works/14", "private_thumbnail_image_urls": null, "private": false, "genre": "novel", "tipped": true, "creator_id": 734894, "client_id": 1509710, "vtt_url": null, "thumbnail_image_urls": {"src": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1310805975851433989%2F9Uq_VRGn.jpg?blend64=aHR0cHM6Ly9za2ViLWF2YXRhci5pbWdpeC5uZXQvfnRleHQ_&blendalpha=100&blendalign=center&blendmode=normal&blendsize=inherit&bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d6a52a9743b59ddbadc0bf63d851b345", "srcset": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1310805975851433989%2F9Uq_VRGn.jpg?blend64=aHR0cHM6Ly9za2ViLWF2YXRhci5pbWdpeC5uZXQvfnRleHQ_&blendalpha=100&blendalign=center&blendmode=normal&blendsize=inherit&bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d6a52a9743b59ddbadc0bf63d851b345, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1310805975851433989%2F9Uq_VRGn.jpg?blend64=aHR0cHM6Ly9za2ViLWF2YXRhci5pbWdpeC5uZXQvfnRleHQ_&blendalpha=100&blendalign=center&blendmode=normal&blendsize=inherit&bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=03679eb9209ce75c1001e424c00dd746 2x, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1310805975851433989%2F9Uq_VRGn.jpg?blend64=aHR0cHM6Ly9za2ViLWF2YXRhci5pbWdpeC5uZXQvfnRleHQ_&blendalpha=100&blendalign=center&blendmode=normal&blendsize=inherit&bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=db10e351648e38886986164f2c1fa2c5 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1310805975851433989%2F9Uq_VRGn.jpg?blend64=aHR0cHM6Ly9za2ViLWF2YXRhci5pbWdpeC5uZXQvfnRleHQ_&blendalpha=100&blendalign=center&blendmode=normal&blendsize=inherit&bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=4e2c9759b5ef4ee8642c9172b5f674a0", "srcset": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1310805975851433989%2F9Uq_VRGn.jpg?blend64=aHR0cHM6Ly9za2ViLWF2YXRhci5pbWdpeC5uZXQvfnRleHQ_&blendalpha=100&blendalign=center&blendmode=normal&blendsize=inherit&bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=4e2c9759b5ef4ee8642c9172b5f674a0, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1310805975851433989%2F9Uq_VRGn.jpg?blend64=aHR0cHM6Ly9za2ViLWF2YXRhci5pbWdpeC5uZXQvfnRleHQ_&blendalpha=100&blendalign=center&blendmode=normal&blendsize=inherit&bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=bfd175a046f64d58595bf581b1ee31f0 2x, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1310805975851433989%2F9Uq_VRGn.jpg?blend64=aHR0cHM6Ly9za2ViLWF2YXRhci5pbWdpeC5uZXQvfnRleHQ_&blendalpha=100&blendalign=center&blendmode=normal&blendsize=inherit&bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=728ad6e98857caba9d0a3808c90faf2d 3x"}, "body": "最初のリクエストをお引き受けいただき、ありがとうございます。\n最初のリクエストを書く中で残存しているCTSのページやマブラヴの資料をめくっている中で、もう一つ浮かんだリクエストをキャンペーンが終わらないうちにお送りいたします。\nこちらはお任せの度合いが大きくなりますが、よろしくご検討ください。\n\n●概要\nマブラヴとWTRPG7「CATCH THE SKY」のクロスオーバー。\nα−０１部隊、通称乙女中隊がマブラヴオルタネイティブの世界に所属基地ごと異世界転移してしまうお話をお願いします。\nガンダムやスパロボとのクロスオーバー二次創作作品であるような主人公の所属艦ごと転移してくるのに近いです。\n\n基地はCTS世界にあった時と同座標、九州にまるごと転移しています。\n転移したタイミングは1998年7月。九州にBETAが上陸した頃です。\n\n●内容\nお任せします。\n乙女中隊が転移したマブラヴ世界でどのように生き抜いて、どのように影響を与えたのかを考えていただき、その中でとりるMSが書きたいワンシーンを書いていただければと思います。\n\n例えば、転移直後のBETAとの戦闘、戦闘後の現地勢力（主に日本帝国や国連）との交渉劇、A-01や香月夕呼をはじめとする原作キャラとのとの邂逅、KVシラヌイの運用維持ができなくなて戦術機不知火に乗り換えるイベント、逆にSES搭載型戦術機の開発といったお話、甲21号作戦や桜花作戦への乙女中隊の参戦などなど、色々とあると思います。\nそんな中からチョイスしていただければと思います。当然ですが、上記以外のシーンでも歓迎です。\n\n歴史の記述のような形式で全体をダイジェストするようなものでも構いませんし、マブラヴ側の人々の視点から見た異世界人（乙女中隊）というのもありだと思います。\n\n●難易度（あるいはチート無双の度合）\nマブラヴの二次創作はBETAの強さやチートの有効度で勝利への難易度が変わります。\n例えば、SESやメトロニウム合金などをマブラヴ世界で再現可能か否かで難易度が圧倒的に違います。\nその辺りのさじ加減はとりるMSのお好みにお任せいたします。\n\n●転移した戦力\n・物資\n乙女中隊のシラヌイ12機、他。中隊以外の機体は出撃中が多く、基地の最大数よりは少ない。\n補給物資、および基地要員は揃っているため、基地を存続できれば1年ほどはKVの稼働や修理に支障はない。\nただし、生産設備は存在しないので、いつかはCTS世界から持ってきた物資は枯渇する。\n\n・技術などの知識\n基地のローカルサーバーに残っている資料、および紙の資料などはある。\n研究施設ではないので詳細な研究資料などはない。\nその状態からCTS由来の技術の再現、さらには物資の生産が可能になるかは研究次第。\n\n・KVの戦闘力\n防御面ではシラヌイは試作型AECの効果もあり、重光線級の集中照射にもかなりの長時間耐えることができる。\n物理攻撃に対しても要撃級の前腕の攻撃にも耐える。\nただし、攻撃を受け続ければ破壊される可能性は十分にある。\nまた、飛行形態のまま航空作戦を行うのは、光線級の長時間の連続照射に晒されることになる為、困難である。通常の航空機よりはいくらか対空時間が長くなる。\n\n攻撃面では、フォースフィールドに対応する為に発展したSES搭載兵器は、フォースフィールドを持たないBETAには過剰すぎるほどの破壊力を示す。\n突撃級を正面からバターのように溶かし、要塞級もヘルメットワームに比べたら倒しやすい敵に過ぎない。\nBETAの恐ろしさは物量なので、数十機のKVだけですべてのBETAを全滅させるのは無理。\n\n・能力者の戦闘力\n戦車級までなら余裕で勝てる。中型種以上も工夫すれば倒せる。\n例えば、横浜基地防衛線で涼宮遥中尉に同行したのが能力者であったなら余裕で生還させられただろう。\n戦車級にかじられてもダメージだけで済む。\nそれでもBETAの物量に囲まれる戦場ではいずれ力尽きるのは必定となる。\n\nhttps://games.t-on.jp/game-archive/WT07/scenario/toriru_43_1.html", "nc": 144, "word_count": 5407, "transcoder": "text", "creator_acceptable_same_genre": false}], "similar_creators": [{"id": 12055, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "杏まこに", "screen_name": "makoni_cg", "avatar_url": "https://pbs.twimg.com/profile_images/2022689159534776322/Xsv8TBq5.jpg", "header_url": "https://pbs.twimg.com/profile_banners/2813040168/1652733602/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 120, "skills": [{"genre": "art"}, {"genre": "correction"}], "nc": 32}, 