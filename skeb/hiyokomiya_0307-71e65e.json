いるSNSでの使用\n活動（動画・配信）での使用\nYoutube収益化済チャンネルでの使用\n\n・資料について\n以下のURLに、変身後の姿と妖精メルの資料があります。\nhttps://drive.google.com/drive/folders/1K4e27aIS3FTTYUH3BkTwVKQSJKgXg_qZ?usp=sharing\n\n\n依頼内容は以上となります。\nskebに余り慣れていない為、情報に不足、不備がありましたら申し訳ございません。\n\nご縁ありましたら、どうか宜しくお願い致します…！\n\n\n\n歴史艦ラビィ", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@hiyokomiya_0307/works/10", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1674144, "client_id": 2775075, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/cfe0a30a/uploads/origins/9f76b075-6433-4c76-9c1c-374ed8702252?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=eb138790729aa05dcf222e5df649428f", "srcset": "https://si.imgix.net/cfe0a30a/uploads/origins/9f76b075-6433-4c76-9c1c-374ed8702252?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=eb138790729aa05dcf222e5df649428f, https://si.imgix.net/cfe0a30a/uploads/origins/9f76b075-6433-4c76-9c1c-374ed8702252?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=df969d47e86555a02665d8619a237c47 2x, https://si.imgix.net/cfe0a30a/uploads/origins/9f76b075-6433-4c76-9c1c-374ed8702252?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=679e6a521be5bade9512bcba980a41e7 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/cfe0a30a/uploads/origins/9f76b075-6433-4c76-9c1c-374ed8702252?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e0340cca1592e274e5992af8a4168ebe", "srcset": "https://si.imgix.net/cfe0a30a/uploads/origins/9f76b075-6433-4c76-9c1c-374ed8702252?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e0340cca1592e274e5992af8a4168ebe, https://si.imgix.net/cfe0a30a/uploads/origins/9f76b075-6433-4c76-9c1c-374ed8702252?bg=%23fff&auto=format%2Ccompres