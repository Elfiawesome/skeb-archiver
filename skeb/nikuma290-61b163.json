4f8e-42a8-bd6e-38919b50f4fb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=611b01e8e0f270e49ad57cf9bf4473c1", "srcset": "https://si.imgix.net/7b1f168f/uploads/origins/8ba6ece4-4f8e-42a8-bd6e-38919b50f4fb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=611b01e8e0f270e49ad57cf9bf4473c1, https://si.imgix.net/7b1f168f/uploads/origins/8ba6ece4-4f8e-42a8-bd6e-38919b50f4fb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=ec86fd8c82f1bbe618b79ad636d52c82 2x, https://si.imgix.net/7b1f168f/uploads/origins/8ba6ece4-4f8e-42a8-bd6e-38919b50f4fb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=6a8003b5f9c6ab4894419ba70264e759 3x"}, "body": "二熊先生初めまして！　スライム乗り換え物ですが良ければお願いいたします！\n\nキャラクター\nエレンジョー（ゼンレスゾーンゼロ）\nOC（https://x.com/Mashumaro_114/status/1938683485608386894?s=20）\n\nOCの頭の上の輪っか（ヘイロー）は省略していただいて大丈夫です。\n乗っ取りシーンを長めの動作重視でお願いしたいと思います。\n\n\n内容\nスライムに身体を乗っ取られたエレンジョーの女性器からスライムが出てきて（スライムが出てきている時は虚ろな表情、スライムは多めだと嬉しいです）\nOCの女性器から勢いよく入り込み身体を乗っ取りニヤニヤと笑みを浮かべながら胸を思い切り揉む。\n（最後にｽﾞﾘｭﾝｯ！と入り込み　OCの耳からスライムが出ている感じ）\n\nどちらも全裸でお願いいたします。　セリフ等ある場合はおまかせいたします", "nc": 171, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@nikuma290/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 260020, "client_id": 356518, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/41b63264/uploads/origins/4c5039e4-2f90-487a-84e1-8bcc9de4bd2f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=166ae044428d24e9f74b37f70b11e906", "srcset": "https://si.imgix.net/41b63264/uploads/origins/4c5039e4-2f90-487a-84e1-8bcc9de4bd2f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=166ae044428d24e9f74b37f70b11e906, https://si.imgix.net/41b63264/uploads/origins/4c5039e4-2f90-487a-84e1-8bcc9de4bd2f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=d14ad7d9743800a27bc89220a13569e5 2x, https://si.imgix.net/41b63264/uploads/origins/4c5039e4-2f90-487a-84e1-8bcc9de4bd2f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=77908a74deac6531e31503bdd0856f0d 3x"}, "duration": null, "nsfw": true, "hardcore": true, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/41b63264/uploads/origins/4c5039e4-2f90-487a-84e1-8bcc9de4bd2f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ace218acad9833bc3ab758db0961c150", "srcset": "https://si.imgix.net/41b63264/uploads/origins/4c5039e4-2f90-487a-84e1-8bcc9de4bd2f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ace218acad9833bc3ab758db0961c150, https://si.imgix.net/41b63264/uploads/origins/4c5039e4-2f90-487a-84e1-8bcc9de4bd2f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=727bd28ed009470a5007e37b8ce06428 2x, https://si.imgix.net/41b63264/uploads/origins/4c5039e4-2f90-487a-84e1-8bcc9de4bd2f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=07a83bb3c67369a06cd7151e3dc93479 3x"}, "body": "こんにちは！\n前回に引き続きお願いしたいことがあります：\nhttps://skeb.jp/@nikuma290/works/4\n\n[キャラクター］\n-謎のヒロインXX（3rdアセンション）\n-夏BB（3rdアセンション、日焼け済み）\n-夏メルトリリス（第2次アセンション）\n-おさかべひめ（第2次アセンション）\n\n[シナリオ］\n左から順に、前回の依頼から続く5つのシーンの連続：\n1) 謎のヒロインXXのクシャクシャになったスキンスーツの上に立つサマーBB。XXの口の穴を大きく広げ、BBの脚の一部を覆うことで、スキンスーツがBBから滑り落ちたように見える。\n2)触手の玉座に座ったBB。BBの触手によって形成されたコートハンガーに吊るされたヒロインXXのスキンスーツを、ぼんやりと弄んでいる。\n3) パニックに陥ったBBは、座ったまま玉座につかまろうとするが、胴体の縦に広がった縫い目から全身が萎む。一方、サマー・メルトリリスは同じ縫い目から優雅に顔を出し、目を閉じてBBの状態など気にしていない。\n4) メルトリリスはBBの皮膚を別の触手型コートハンガーに放り投げ、自惚れと無関心の中間のような顔をする。\n5) スクリーンに背を向けたメルトリリスは、水着とスキンスーツを一緒に脱ぎ、上半身を滑らせ、おさかべ姫を露出させる。\n6) 恥ずかしがりながら、ヒロインXXとBBのスキンをタオルケット代わりにして身を隠そうとするおさかべひめ。\n\n上記は大まかなイメージとして捉えていただければと思います。参考までに上記のスケッチも参考フォルダに入れておきます。\n細かい部分（ポーズや表情など）を変えた方がセクシーになると思う方は、ご自由に変えてください。\n同時に、スキンスーツを完全に脱ぐ前の、意識と表情が残っている部分も残していただけるとありがたいです。\n\nhttps://drive.google.com/drive/folders/1yDXbNZq01nYKaCQL60MCzGt8S9Ta8K7A?usp=sharing", "nc": 178, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@nikuma290/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "comic", "tipped": false, "creator_id": 260020, "client_id": 718255, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/0c282441/uploads/origins/c333646e-3e4d-4568-bced-414e766601f3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=edfd768f0ad89956925c4aeaa8073815", "srcset": "https://si.imgix.net/0c282441/uploads/origins/c333646e-3e4d-4568-bced-414e766601f3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=edfd768f0ad89956925c4aeaa8073815, https://si.imgix.net/0c282441/uploads/origins/c333646e-3e4d-4568-bced-414e766601f3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=3ff63eb58d96c57b48bde14c72525634 2x, https://si.imgix.net/0c282441/uploads/origins/c333646e-3e4d-4568-bced-414e766601f3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e1a29eb166ed56e196c5322a4d387779 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/0c282441/uploads/origins/c333646e-3e4d-4568-bced-414e766601f3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=4102aa71eb8e9d903d5a2ff76e33d94e", "srcset": "https://si.imgix.net/0c282441/uploads/origins/c333646e-3e4d-4568-bced-414e766601f3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=4102aa71eb8e9d903d5a2ff76e33d94e, https://si.imgix.net/0c282441/uploads/origins/c333646e-3e4d-4568-bced-414e766601f3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=3db36e6d067b12bebc1200f9856dd6bf 2x, https://si.imgix.net/0c282441/uploads/origins/c333646e-3e4d-4568-bced-414e766601f3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=7b6f14f63f023b9f6272fd0f8e4e7db8 3x"}, "body": "二熊さんこんにちは。慧音の皮を着るサニーミルクの皮モノ4コマをお願いします。\n\n［各コマの詳細］\n①慧音の皮を足の部分まで着込んで頭の部分を持った状態でニヤッと笑うサニー\n②頭の部分まで着込む\n③慧音の姿でウィンクする\n④皮の顔を引っ張りながら胸を揉んで快楽に浸る\n\n皮は目と口の部分が空洞になっているタイプでお願いします。", "nc": 161, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@nikuma290/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 260020, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/c4e78515/uploads/origins/7b46ad31-0089-4326-95bc-81ec4b10e654?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e2667e6ee4847491fc545aeb633b1b41", "srcset": "https://si.imgix.net/c4e78515/uploads/origins/7b46ad31-0089-4326-95bc-81ec4b10e654?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e2667e6ee4847491fc545aeb633b1b41, https://si.imgix.net/c4e78515/uploads/origins/7b46ad31-0089-4326-95bc-81ec4b10e654?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ef4e940388c7299320cea8cdcf9fec29 2x, https://si.imgix.net/c4e78515/uploads/origins/7b46ad31-0089-4326-95bc-81ec4b10e654?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a66d1438fbe53949483869163a95e65f 3x"}, "duration": null, "nsfw": true, "hardcore": true, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/c4e78515/uploads/origins/7b46ad31-0089-4326-95bc-81ec4b10e654?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=067c70e85c60a888bb5f2085afd8c089", "srcset": "https://si.imgix.net/c4e78515/uploads/origins/7b46ad31-0089-4326-95bc-81ec4b10e654?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=067c70e85c60a888bb5f2085afd8c089, https://si.imgix.net/c4e78515/uploads/origins/7b46ad31-0089-4326-95bc-81ec4b10e654?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=5609e07225db5056349462e7fcbc5c2e 2x, https://si.imgix.net/c4e78515/uploads/origins/7b46ad31-0089-4326-95bc-81ec4b10e654?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=536d882ba2f707a476714d3814685343 3x"}, "body": "こんにちは。\nFGOの複数のスキンスーツが絡むシークエンスのアートワークをお願いしたいです。\n\n[キャラクター］\n-夏清姫（第1次アセンション）\n-夏ニトクリス（第2次アセンション）\n-謎のヒロインXX（第3次アセンション）\n\n[シナリオ］\n左から6コマのシークエンス\n1）清姫が興奮した表情で、槍にもたれかかりながらI字バランスをとる。\n2）清姫のスキンスーツが下から開かれ、胸元まで脱がされ、ニトクリスの下半身が映し出される。\n3）清姫のスキンスーツを脱いだニトクリスは、ニトクリスの第2次昇天イラストの白い布のように頭からかぶり、顔の上の動物の耳が清姫のスキンスーツの目の穴から突き出ている。\n4)ニトクリスの胸の皮が割れて、スキンスーツを片側だけ開き、その隙間からヒロインXXの大きな胸を出す。フェイスマスクをまくり上げて、ヒロインXXの顔の下半分を見せる。\n5）清姫とニトクリスのスキンの上に座り、ビキニを調節するヒロインXX。\n6) 視点に背中を向け、ヒロインXXの手（あるいは両手）が下半身を引っ張り、皮膚を少し伸ばし、口から魔神柱らしき触手が出てくる。\n\nフルシークエンスのコンセプト画像と、①④⑤⑥の参考画像を用意しましたが、お好きなように描いてください！\nよろしくお願いします！\n\nhttps://drive.google.com/drive/folders/1651_bf8C3BneZt635bUYV1npiIQufCr5?usp=sharing", "nc": 187, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@nikuma290/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 260020, "client_id": 1301958, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/dde8691d/uploads/origins/3404aad4-0f46-430b-a82f-3ac1c25af42a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=473d50694e5235cd9675c7b22d9f6aeb", "srcset": "https://si.imgix.net/dde8691d/uploads/origins/3404aad4-0f46-430b-a82f-3ac1c25af42a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=473d50694e5235cd9675c7b22d9f6aeb, https://si.imgix.net/dde8691d/uploads/origins/3404aad4-0f46-430b-a82f-3ac1c25af42a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=5326d3e6c932cbbcf52c3db4468bd7a0 2x, https://si.imgix.net/dde8691d/uploads/origins/3404aad4-0f46-430b-a82f-3ac1c25af42a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=25796dda4e3ac89390aae934936cc1f3 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/dde8691d/uploads/origins/3404aad4-0f46-430b-a82f-3ac1c25af42a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=416805471c2d786129f30a223990f75f", "srcset": "https://si.imgix.net/dde8691d/uploads/origins/3404aad4-0f46-430b-a82f-3ac1c25af42a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=416805471c2d786129f30a223990f75f, https://si.imgix.net/dde8691d/uploads/origins/3404aad4-0f46-430b-a82f-3ac1c25af42a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=e2b30b2249986834f704f98047af622d 2x, https://si.imgix.net/dde8691d/uploads/origins/3404aad4-0f46-430b-a82f-3ac1c25af42a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=9e710fd2cbc4c721c9221a583268d487 3x"}, "body": "二熊さんはじめまして。体格差皮モノの話をしていたのでよければ依頼をお願いしたいです。\n\n\n【概要】\n艦これの雷が赤城の全身皮を着るシーケンス4コマ\n\n【詳細】\n①雷が赤城の皮の足に左足だけつっこんでいる。足の長さ的に左足は曲がってて、右足はピンと立ってて若干つま先立ち状態\n②両足が完全に入り、腰～胸あたりを合わせようとしている。普段より目線が高いことに気づき皮のすごさを感じた様子の雷の表情\n③顔の部分を合わせようとしている。左or右から顔を合わせようとして、反対側がぶかぶかになって目のところから電の顔が見える。\n④完全に赤城の姿だが、ポーズがとても電らしい。\n\n\nシチュエーションや背景、セリフなどはお任せします。なしでも問題ありません。\nぜひよろしくお願いします！", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@nikuma290/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 260020, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/5754feff/uploads/origins/0e16ec90-68c8-4c68-ac37-3d73b54ce759?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=31e6c80f67154b35e93a7c2b5b4b951b", "srcset": "https://si.imgix.net/5754feff/uploads/origins/0e16ec90-68c8-4c68-ac37-3d73b54ce759?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=31e6c80f67154b3