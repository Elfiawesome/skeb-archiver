かかわらず、彼女たちはショッピングを楽しむ。\n\n試着室では、彼女たちはブラとパンティ以外はほとんど裸だ。ダークタイニーは突然タイニーを壁ドンに閉じ込めます。ダーク・タイニーは、「私と二人きりでどこかに行くなんてバカね」というような、からかうような意地悪なことを言って、彼女にキスをする。ブラジャーを外し、お互いをこすり合わせます。タイニーの淫らで屈辱的な表情を楽しむサディストクローンからのGxG攻撃の始まりだ。\n\nもしこのリクエストを実行できても支払い金額が十分でない場合は、より高い金額を再送してください。ご検討ありがとうございました。", "nc": 51, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@yugayugami/works/4", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/85afe5b9/uploads/origins/961b8c9c-f0e8-4c41-9a11-e96c0ca0bb4b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=8efbd06b69c1463b51535203bfaab1ec", "srcset": "https://si.imgix.net/85afe5b9/uploads/origins/961b8c9c-f0e8-4c41-9a11-e96c0ca0bb4b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=8efbd06b69c1463b51535203bfaab1ec, https://si.imgix.net/85afe5b9/uploads/origins/961b8c9c-f0e8-4c41-9a11-e96c0ca0bb4b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=0628b282b7c058cfbf7bd33db6ed7593 2x, https://si.imgix.net/85afe5b9/uploads/origins/961b8c9c-f0e8-4c41-9a11-e96c0ca0bb4b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=d1f3f8a3b0a38e24e79dd06bba0de563 3x"}, "private": true, "genre": "art", "tipped": false, "creator_id": 1193129, "nc": 162}, {"path": "/@yugayugami/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1193129, "client_id": 53395, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/34dfa92c/uploads/origins/37674529-797d-468d-ab89-7d5fb12f2612?bg=%23fff&a