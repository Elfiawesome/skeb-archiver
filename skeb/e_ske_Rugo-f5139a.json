ャイナドレスを描いてほしいんだ。\n彼女のボディラインはすでに素晴らしいディテールを作ってくれているので、信頼しています。\n\n## キャラクター情報\n彼女の作者であるPHI先生の作品です。\n\n- https://twitter.com/phi_owo/status/1058337712476844033 (2018.10)\n- https://pixiv.net/i/69759049\n- https://iopwiki.com/wiki/G3#Gallery\n\nヘアピン（ヘッド受信モジュール）の詳細は下記をご確認ください。\n\n- https://pixiv.net/i/108776422\n- https://pixiv.net/i/91569331\n- https://pixiv.net/i/109503857\n\n## 服装\nこの作品にはG3の良い点が含まれている。ボレロ、黒いドレス、ストッキング。\n- https://pixiv.net/i/123241676\n\nカラーバリエーションも歓迎！\n例えば、ゴールドの縁取りのドレス、白い下着の紐、赤い紐のチョッカー（ウェディングドレスのような）など。\n\n## ポーズ\nGFL2のグローザやQBZ-95の寮ポーズを参考にしてください。\n\nhttps://pixiv.net/i/123241676", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@e_ske_Rugo/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3682028, "client_id": 99166, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/6d15e1c2/uploads/origins/60766c68-43ad-4cfc-811a-d2496a837566?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=74aef8c8cd1343aa7186cf2949e61a33", "srcset": "https://si.imgix.net/6d15e1c2/uploads/origins/60766c68-43ad-4cfc-811a-d2496a837566?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=74aef8c8cd1343aa7186cf2949e61a33, https://si.imgix.net/6d15e1c2/uploads/origins/60766c68-43ad-4cfc-811a-d2496a837566?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=9a69dcdec0937bc393e5fb92d3b5d66a 2x, https://si.imgix.net/6d15e1c2/uploads/origins/60766c68-43ad-4cfc-811a-d2496a837566?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=4286ce3cbfe1c70ff480d7ed70dcc33a 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/6d15e1c2/uploads/origins/60766c68-43ad-4cfc-811a-d2496a837566?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a59922f98aa5bcd2277abf98bb77b476", "srcs