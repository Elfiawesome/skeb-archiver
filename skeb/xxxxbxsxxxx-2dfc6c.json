mgix.net/94216f26/uploads/origins/066979c9-dcd9-410a-837c-d1eee2a80ddc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b246a78d41b7031dda4e4ce2787a1c46, https://si.imgix.net/94216f26/uploads/origins/066979c9-dcd9-410a-837c-d1eee2a80ddc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e27734d73d01b57d0a36326d2ba1918b 2x, https://si.imgix.net/94216f26/uploads/origins/066979c9-dcd9-410a-837c-d1eee2a80ddc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=3741e4931943a21fd240e3c9b9c8df39 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/94216f26/uploads/origins/066979c9-dcd9-410a-837c-d1eee2a80ddc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=830aa2f4be6e42aca3122e218d6fd113", "srcset": "https://si.imgix.net/94216f26/uploads/origins/066979c9-dcd9-410a-837c-d1eee2a80ddc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=830aa2f4be6e42aca3122e218d6fd113, https://si.imgix.net/94216f26/uploads/origins/066979c9-dcd9-410a-837c-d1eee2a80ddc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=5a2894fca1523dbc7a3752fcb3e75f95 2x, https://si.imgix.net/94216f26/uploads/origins/066979c9-dcd9-410a-837c-d1eee2a80ddc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=f78cf40c8c265fa0ebe7be62592068ca 3x"}, "body": "こんにちは、yumemiさん。リクエストよろしいでしょうか？\n\n内容としては、美園と千明が互いの頬にキスをするイラストを2枚ほど描いてほしいです。\n\n1枚目は、美園(高1)が千明(小6)の頬に不意打ちでキスをする。\n2枚目は、千明(小6)が美園(高1)の頬に恥ずかしそうにキスをする。\n\n細かいシチュエーションとしては、1枚目での美園の表情は嬉しそうな満面の笑みを浮かべ、千明は驚いたように見開いて赤面する。2枚目での千明の表情は恥ずかしさを隠せず目を大きく瞑り、美園は楽しそうに笑う。\n\n\nよろしくお願いします。", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@xxxxbxsxxxx/works/4", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/054a2050/uploads/origins/b00011e9-4