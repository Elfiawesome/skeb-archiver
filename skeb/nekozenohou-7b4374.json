r.com/a/1ykc0QY", "nc": 176, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@nekozenohou/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2573610, "client_id": 2410915, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/03d3ad94/uploads/origins/f4d0a9e6-9fd6-40fa-baab-f507a554679b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c2bc273dd585883f7baa75731d5e7b33", "srcset": "https://si.imgix.net/03d3ad94/uploads/origins/f4d0a9e6-9fd6-40fa-baab-f507a554679b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c2bc273dd585883f7baa75731d5e7b33, https://si.imgix.net/03d3ad94/uploads/origins/f4d0a9e6-9fd6-40fa-baab-f507a554679b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=9f1d7dfeb1245ee5f972631043ec266d 2x, https://si.imgix.net/03d3ad94/uploads/origins/f4d0a9e6-9fd6-40fa-baab-f507a554679b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=57aa098fe12569f0d31d0ded7c24432a 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/03d3ad94/uploads/origins/f4d0a9e6-9fd6-40fa-baab-f507a554679b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=86d10dcf8a947e2b11ccf0338c15267e", "srcset": "https://si.imgix.net/03d3ad94/uploads/origins/f4d0a9e6-9fd6-40fa-baab-f507a554679b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=86d10dcf8a947e2b11ccf0338c15267e, https://si.imgix.net/03d3ad94/uploads/origins/f4d0a9e6-9fd6-40fa-baab-f507a554679b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=b504d3f8e9ca726e85cdd1316d24d784 2x, https://si.imgix.net/03d3ad94/uploads/origins/f4d0a9e6-9fd6-40fa-baab-f507a554679b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=137d9934d83ddfbb6905b3b2393493a3 3x"}, "body": "はじめまして、こんにちは\n\nカクヨムをメインに小説を書いているmono-zoといいます。\n\n小説を投稿し始めて1年と経って居ない新人ですが広告費を頂きまして少しでも読者に還元しようと思い立ってスケブの新着順を探してたどり着きました。\n\n『少年神官系勇者―異世界から帰還する―』という作品を書いているのですがその中のキャラを描いてもらいたいです。\n\n\n内容は\n【黒葉奈美】\n女・黒髪・高身長・大学生から大学生にて神官になる。\n\n他の作家様には性格なども聞かれた子がありまして\n\n匂いフェチ・いらないことを言ってしまう・自分に自信がない・酒に強い２１歳・元ヤクザたちのまとめ役になってしまう\n\nこれまでに出た服装は\n大学生の服装（決まりはない）、神官服（決まりはない）、黄色い水着、婚姻時に踊り子のような服装にもなる（周りの人には痴女認定された）、和服などもあります。\n\nこういうのはどこまで書けばいいのかわかりませんね。\n\n\n作品は読まずにこの情報から自由に描いてもらっても、作品を読んで描いていただいても大丈夫です。\nこれら以外にもキャラは多くいるのでこれら以外から描いていただいても大丈夫です。\n\n使用する範囲は小説サイトとpixiv（小説を書いているので）、Twitter、You Tubeなどです。\n\nスケブの規約に引っかかったことがあるので何処まで書いて良いのかわかりません(´・ω・｀)\n\nただ僕は新人ですので新着順で調べて、作品が少ない（かつ僕のもらえている広告費で支払える）方にお願いしていっております。\n\n「黒髪地味目女の子をよく描くものです」に惹かれました。\n\nよろしくお願いします。", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 6408, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "ぼたん🔞", "screen_name": "Co_BoTAN", "avatar_url": "https://pbs.twimg.com/profile_images/1795654343850598400/6wnjAgxO.jpg", "header_url": null, "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 30, "skills": [{"genre": "art"}, {"genre": "comic"}, {"genre": "correction"}], "banned": false, "nc": 160}, {"id": 151473, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "ぬゆぬゆ", "screen_name": "nuyums", "avatar_url": "https://pbs.twimg.com/profile_images/1182650703572914176/Q23rBYD_.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1080097248996876289/1570800876/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 7, "complete_expiration_days": 45, 