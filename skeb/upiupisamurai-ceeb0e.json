o」の恥ずかしがり屋でありながらもセクシーな一面を表現していただけると嬉しいです。\n以前、黒髪のキャラクターが横たわっているイラストを拝見し、とても気に入りました。今回、同様の構図でお願いできればと思います。参考までに、キャラクターデザイン、ファッション、イラストの参考画像を添付しました。\n\n動画用ですので、イラストの縦横比は16:9でお願いします！編集は私自身が担当します。\n\nご一緒できるのを楽しみにしています！あなたのアートスタイルはとてもおしゃれですね。\n\nhttps://drive.google.com/drive/folders/1fu3Eu0bZZumv7100ABpQO8PhKFUJ3Y0r?usp=sharing", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@upiupisamurai/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3473090, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/11d82c1f/uploads/origins/5f075481-7a22-4da5-b806-af3c2cce4f10?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=057e6703fd4b4e7115261f31c14a2252", "srcset": "https://si.imgix.net/11d82c1f/uploads/origins/5f075481-7a22-4da5-b806-af3c2cce4f10?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=057e6703fd4b4e7115261f31c14a2252, https://si.imgix.net/11d82c1f/uploads/origins/5f075481-7a22-4da5-b806-af3c2cce4f10?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a6ee06e705d92502436dc23a3e72e647 2x, https://si.imgix.net/11d82c1f/uploads/origins/5f075481-7a22-4da5-b806-af3c2cce4f10?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=5b2f7fce35c2b8f37ac7bc55bd916132 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/11d82c1f/uploads/origins/5f075481-7a22-4da5-b806-af3c2cce4f10?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a4a5c88250002df0de174c5aba6c496d", "srcset": "https://si.imgix.net/11d82c1f/uploads/origins/5f075481-7a22-4da5-b806-af3c2cce4f10?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a4a5c88250002df0de174c5aba6c496d, https://si.imgix.net/11d82c1f/uploads/origins/5f075481-7a22-4da5-b806-af3c2cce4f10?bg=%23