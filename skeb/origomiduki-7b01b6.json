55-4a80-85e8-592157cb0ff5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=6ec9400a716bb255af5a7d80dd7b4194 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/3a300d6d/uploads/origins/6693530e-0b55-4a80-85e8-592157cb0ff5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=742025b17b3a05fb852cd6800a3a8b5a", "srcset": "https://si.imgix.net/3a300d6d/uploads/origins/6693530e-0b55-4a80-85e8-592157cb0ff5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=742025b17b3a05fb852cd6800a3a8b5a, https://si.imgix.net/3a300d6d/uploads/origins/6693530e-0b55-4a80-85e8-592157cb0ff5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=9189a7b9d2c72e58f77c08bc903dcef1 2x, https://si.imgix.net/3a300d6d/uploads/origins/6693530e-0b55-4a80-85e8-592157cb0ff5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=6286c2ddea1824ccad53fa5763ac9ae5 3x"}, "body": "こんにちは！\nVtuberの猫田なつなさんのイラストをお願いしたいです！\ngoogle driveに参考資料があります。注意点は、ダブルテールと胸のビューティーマークです。\n\nイラストは素足でも構いません。足を自由に振っている。軽く微笑みながらこちらを見て、片手でピースをしている。\nアングルは問いません。\n\n配信やサムネイル、ツイッター関連の活動に使われる可能性がありますが、よろしければご了承ください！\nできればPSDレイヤー上でも人物を分けてもらえると助かります。\n\nその他、見落としがありましたら、あとはお任せします。ありがとうございました！\n\nhttps://drive.google.com/drive/folders/1YQobsEj_Td2z9pnd4iISmZ6uYWgAU6ln?usp=sharing", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@origomiduki/works/13", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 656961, "client_id": 2905258, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/9302661c/uploads/origins/8e3982a4-3bc2-45f7-ade9-0e38a7c0438b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=27f49a931d511fa250326276202aa246", "srcset": "https://si.imgix.net/9302661c/uploads/origins/8e3982a4-3bc2-45f7-ade9-0e38a7c0438b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=27f49a931d511fa250326276202aa246, https://si.imgix.net/9302661c/uploads/origins/8e3982a4-3bc2-45f7-ade9-0e38a7c0438b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=615d1881265c061ea1ca0b03e3bd51a5 2x, https://si.imgix.net/9302661c/uploads/origins/8e3982a4-3bc2-45f7-ade9-0e38a7c0438b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=7cb8bfc4b8a54abe323f237b8ced4447 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/9302661c/uploads/origins/8e3982a4-3bc2-45f7-ade9-0e38a7c0438b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ac70137de91d67d3844e0ad051ec060a", "srcset": "https://si.imgix.net/9302661c/uploads/origins/8e3982a4-3bc2-45f7-ade9-0e38a7c0438b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ac70137de91d67d3844e0ad051ec060a, https://si.imgix.net/9302661c/uploads/origins/8e3982a4-3bc2-45f7-ade9-0e38a7c0438b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=04291adcf60027a5400f8104b822e4ec 2x, https://si.imgix.net/9302661c/uploads/origins/8e3982a4-3bc2-45f7-ade9-0e38a7c0438b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=6057705e35ce241b4e6b1209d3569af6 3x"}, "body": "折埖様、初めまして。\n素敵なM200のイラストに惹かれてリクエストを送らせて頂きました。\nこの度は私のOCのイラストを描いて頂きたいです…！\n\n▼キャラクターの詳細\n・三日月がモチーフのキャラクター\n・身長は168cm、年齢は16歳\n・痩せ型で身体が薄く細い中性的な見た目の女の子\n・全長145cmの対物ライフルを分解し、チェロケースに入れて持ち運んでいるスナイパー\n・三日月形のアホ毛と瞳の中の三日月型のハイライト、ジト目のような伏し目がちの瞳が特徴\n\nスレンダーなキャラクターなので、出来るだけ腕や足を細めに描いて頂けるととても嬉しいです。\n\n服装につきましては、資料リンク内の立ち絵のものでお願いさせて頂きたいです。\n見えない部分など細部のデザインは想像で描いて頂けると助かります。\n\n使用用途につきましては\n・アイコン、ヘッダーへの使用\n・SNSでの投稿\n・私的利用範囲内のグッズ化\nをさせて頂きたいと思っています。\n難しいものがあれば差分で教えていただけると助かります！\n\nまた、可能でしたら背景透過版データも頂けるととても助かります。\n\nお手隙の際で構いませんのでご検討よろし