op=top&w=200&h=200&s=c696cc7237d261eef134c2fe892d3cae, https://si.imgix.net/5d370d77/uploads/origins/2bb306c3-263a-4f60-b7e6-82978a1825a7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=48bfdca3ec13a49d2809ef62f1222d2c 2x, https://si.imgix.net/5d370d77/uploads/origins/2bb306c3-263a-4f60-b7e6-82978a1825a7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=057071275b742568f35c93869a1186ce 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/5d370d77/uploads/origins/2bb306c3-263a-4f60-b7e6-82978a1825a7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3b963ecb98511294e697d582f200b503", "srcset": "https://si.imgix.net/5d370d77/uploads/origins/2bb306c3-263a-4f60-b7e6-82978a1825a7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3b963ecb98511294e697d582f200b503, https://si.imgix.net/5d370d77/uploads/origins/2bb306c3-263a-4f60-b7e6-82978a1825a7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=1022a132b387746c24eee28cd45f62e8 2x, https://si.imgix.net/5d370d77/uploads/origins/2bb306c3-263a-4f60-b7e6-82978a1825a7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=2acd1e532693a7a50597b2cf48634664 3x"}, "body": "くもりの日さんこんにちは！いつもSNSでお世話になっておりますうにです！\n今回はくもりの日さんにskebをお願いしたくて参りました！\n\nリクエストはくもりの日さんの描くるるちゃんが見てみたいです……！！\n参考資料：https://x.com/kedarakefuwako/status/1396791494690836481/photo/1\nhttps://x.com/kedarakefuwako/status/1704660757428998467/photo/1\nhttps://x.com/kedarakefuwako/status/1704661472713052179/photo/1\n\nるるちゃんはマイペースで、不思議なうさぎの女の子です！\nいっつもにこにこしていて甘いもの(いちごジャムとかすイーツとか)が大好き。\nおひげとピンクのリボンがチャームポイントです。\n\nくもりの日さんが思い浮かべるるるちゃんを描いて頂けるととても嬉しいです…！！\nご縁がありましたらよろしくお願いします！(´　`*)", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@kumori_nohi/works/4", "private_thumbnai