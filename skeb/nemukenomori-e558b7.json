レコードやカセットテープを集め、ギターも数本持っています。歌うことが大好きで、ストリーミング再生と合わせて、部屋でもよく録音しています。\n \n16:9で綺麗に見えるように合成して、最低でも2560x1440にできるでしょうか？また、できるだけ多くのレイヤーを含むPSDを同梱していただけませんか？彼女のストリーミング活動に使いたいかもしれないので、それがOKな方のみお受けしてください\n \n参考までに右目の下のほくろにご注目ください。\n\nhttps://drive.google.com/drive/folders/1BDKZzTAi-o6khO-VMvHSc0V6qdmS8rFL?usp=sharing", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@nemukenomori/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2401883, "client_id": 1844327, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/62b256cc/uploads/origins/3fd54a79-5747-4ff8-8ac8-7efae885e75f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=cda9b3cd8c459852cdd168be489ae83f", "srcset": "https://si.imgix.net/62b256cc/uploads/origins/3fd54a79-5747-4ff8-8ac8-7efae885e75f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=cda9b3cd8c459852cdd168be489ae83f, https://si.imgix.net/62b256cc/uploads/origins/3fd54a79-5747-4ff8-8ac8-7efae885e75f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=2d920ca2d8b8d01968808d2dbb280d8f 2x, https://si.imgix.net/62b256cc/uploads/origins/3fd54a79-5747-4ff8-8ac8-7efae885e75f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=51aef3df242839ffe68c5b67a8c90c27 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/62b256cc/uploads/origins/3fd54a79-5747-4ff8-8ac8-7efae885e75f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5781a5560a9f1b41b07db578026e6449", "srcset": "https://si.imgix.net/62b256cc/uploads/origins/3fd54a79-5747-4ff8-8ac8-7efae885e75f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5781a5560a9f1b41b07db578026e6449, https://si.imgix.net/62b256cc/uploads/origins/3fd54a79-5747-4ff8-8ac8-7efae885e75f?b