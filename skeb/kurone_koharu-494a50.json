p=top&w=200&h=200&s=a5dda969e73077236b787734b4d11adf", "srcset": "https://si.imgix.net/0062c5ee/uploads/origins/0ec5982e-f16e-4757-b8a6-d5f944915d78?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a5dda969e73077236b787734b4d11adf, https://si.imgix.net/0062c5ee/uploads/origins/0ec5982e-f16e-4757-b8a6-d5f944915d78?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=997d905f529ca4663be5be67cae3a5d7 2x, https://si.imgix.net/0062c5ee/uploads/origins/0ec5982e-f16e-4757-b8a6-d5f944915d78?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=3dc3319679b26451b435e610574b39a2 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/0062c5ee/uploads/origins/0ec5982e-f16e-4757-b8a6-d5f944915d78?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a2f411e5a3185942c687c307bf8cb896", "srcset": "https://si.imgix.net/0062c5ee/uploads/origins/0ec5982e-f16e-4757-b8a6-d5f944915d78?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a2f411e5a3185942c687c307bf8cb896, https://si.imgix.net/0062c5ee/uploads/origins/0ec5982e-f16e-4757-b8a6-d5f944915d78?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=3e24cb51c6375c94cf3a91f3e7850d69 2x, https://si.imgix.net/0062c5ee/uploads/origins/0ec5982e-f16e-4757-b8a6-d5f944915d78?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=4eeb4ebb24e7e618d42bd8cdacb609ed 3x"}, "body": "初めまして！\n\n偶然発見したイラストが素敵でしたのでリクエストさせてください！\nおんすい様が描かれた下記リンクのイラストが大変気に入ってますので、\nhttps://twitter.com/kurone_koharu/status/1495408918079901696\nに似た構図でお願いしたいです。\n\n資料URLにある女性２人（月宮姉妹）と猫を描いて頂けたらな……と思います。\n詳細内容として、\n①姉（髪の長いほう）\n・構図としてはハルカと同じような感じで大丈夫です。\n②妹（髪の短いほう）\n・「雨、やんだよ！」と言わんばかりに姉を見つつ、空を指さしている様子。\n③猫\n・資料URLの通り、妹の頭か肩に乗せてください。\n④背景\n・桜の背景とか、指定は特にありませんのでお任せします。\n\n姉妹の服装は資料URLの通りでお願いします。\nもし資料URLの画像でわかりにくい場合は、\nブログにある”Cronaca関係者設定”カテゴリーより\n・月宮雪華（ツーリング（休憩）mode）\n・月宮奏音（ツーリングmode）\nを参照していただけると幸いです……。\n服装の隠れて見えない部分等、不明点がある場合は全ておんすい様にお任せします。\n\n使用用途はSNSのヘッダーやアイコン、およびオフライン下でパソコンの壁紙等に使わせていただきたいので、イラストは横長でお願いします。\n\n以上、ご検討のほどよろしくお願いします！\n\nhttps://cronaca.livedoor.blog/archives/14621328.html", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 194910, "creator": true, "nsfw_acceptable": false, "acceptable": false, "name": "みるむ┆Skeb作業中✍", "screen_name": "369rim", "avatar_url": "https://pbs.twimg.com/profile_images/1993570446172938240/rLJs3vnw.png", "header_url": "https://pbs.twimg.com/profile_banners/718152644/1763952474/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 14, "complete_expiration_days": 90, "skills": [{"genre": "art"}, {"genre": "voice"}], "nc": 49}, {"id": 686926, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "あんばさ", "screen_name": "abs5287", "avatar_url": "https://pbs.twimg.com/profile_images/1551687229474754561/iaiFy03G.jpg", "header_url": null, "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 120, "skills": [{"genre": "art"}], "nc": 1}, {"id": 2267394, "creator": true, "nsfw_acceptable": false, "acceptable": false, "name": "あきらあゆむ🌱", "screen_name": "ayumu01", "avatar_url": "https://pbs.twimg.com/profile_images/1538825891446669314/1GQ9feOo.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1127146972098351105/1758371948/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 10, "complet