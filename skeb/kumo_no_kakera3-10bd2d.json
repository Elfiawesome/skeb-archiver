=20\n\n雲乃かけら様のプロフィールに書かれている\n「ポップでかわいい」をテーマで構図や表情、服装など全ておまかせしたいと思っています！\n\n【使用用途】\n個人観賞用と、nah本人にデータを渡す予定です。\nそのため普段のSNSを含む、活動におけるプロモーションや収益化済みの配信サムネイルなどで使われる可能性があります。\n※もしイラストがサムネイルで使用される際にはお名前を記載(クレジット掲出)してもらえるようにお願いします\nデータはレイヤーを人物と分けられるように psdデータでお願いしたいと思っています。\n\n上記の使用用途等で問題なく、もしご縁がありましたらリクエストを受けていただけると幸いです。\nご検討のほど、どうぞよろしくお願い致します。", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@kumo_no_kakera3/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2609286, "client_id": 2184654, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/0caeaa5d/uploads/origins/a7988db4-78d9-4b41-9c10-691881bb6b0c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=09c9d09b2c325881f73101b5f616d8e4", "srcset": "https://si.imgix.net/0caeaa5d/uploads/origins/a7988db4-78d9-4b41-9c10-691881bb6b0c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=09c9d09b2c325881f73101b5f616d8e4, https://si.imgix.net/0caeaa5d/uploads/origins/a7988db4-78d9-4b41-9c10-691881bb6b0c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ced00e82e36f1d32ecffb33fb1c2d120 2x, https://si.imgix.net/0caeaa5d/uploads/origins/a7988db4-78d9-4b41-9c10-691881bb6b0c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=63c630da5ac3e891af6956a10beae37a 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/0caeaa5d/uploads/origins/a7988db4-78d9-4b41-9c10-691881bb6b0c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=851cd04d29247bb67e1d0f18f63d4416", "srcset": "https://si.imgix.net/0caeaa5d/uploads/origins/a7988db4-78d9-4b41-9c10-691881bb6b0c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=851cd04d29247bb67e1d0f18f63d4416, https://si.imgix.net/0caeaa5d/uploads/origins/a7988db