h5YLvppCmbvMTY8KENFb8oNDLpWzKH?usp=sharing", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@_pachida_/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3871214, "client_id": 3429532, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/a5f814ff/uploads/origins/fc64d923-011d-443d-8e06-bf6e90be84b3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=47f63d459a07f94ae1a3c154b14bfff4", "srcset": "https://si.imgix.net/a5f814ff/uploads/origins/fc64d923-011d-443d-8e06-bf6e90be84b3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=47f63d459a07f94ae1a3c154b14bfff4, https://si.imgix.net/a5f814ff/uploads/origins/fc64d923-011d-443d-8e06-bf6e90be84b3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=8711607e34f0572f9907d2009967e3b8 2x, https://si.imgix.net/a5f814ff/uploads/origins/fc64d923-011d-443d-8e06-bf6e90be84b3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=9d64ee518f567d453ed84c7e1beaba5a 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/a5f814ff/uploads/origins/fc64d923-011d-443d-8e06-bf6e90be84b3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=4b3c4f9b73216b7121ca081187c304ba", "srcset": "https://si.imgix.net/a5f814ff/uploads/origins/fc64d923-011d-443d-8e06-bf6e90be84b3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=4b3c4f9b73216b7121ca081187c304ba, https://si.imgix.net/a5f814ff/uploads/origins/fc64d923-011d-443d-8e06-bf6e90be84b3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=28f688386ce44802eeea86ec9fcc0c96 2x, https://si.imgix.net/a5f814ff/uploads/origins/fc64d923-011d-443d-8e06-bf6e90be84b3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=e3e2a53077d6876782473f2f7285bbac 3x"}, "body": "ぱちだ様\n\n初めまして。VTuberをしておりますはやのちかと申します。\nアピールありがとうございます。是非、私「はやのちか」のイラストを描いていただきたいと思いリクエストさせていただきました。\n\n【シチュエーションなど】\n・私「はやのちか」イラストをお願いします\n・ぱちだ様の得意なテイストでお好きな表現をしていただけましたら幸いです\n・サムネイルに使用する際に大きくしたり小さくしたり斜めにしたりなど、配置を変える予定があるため、耳、腕、手、しっぽの先などが見切れないように描いて頂けますと嬉しいです\nまた、フォルダ内にある衣装アイテム等は描きやすいように簡略化していただいて問題ございません\n\n【参考資料】\nhttps://drive.google.com/drive/folders/1XEkq-squU8Zxsah6jZcxhkyOSyIWnmlu?usp=sharing\n\n【使用先】\nVtuber活動での使用（収益化済みチャンネルでの使用、告知・サムネイル、SNSアイコンやヘッダー、サブスクライバーへの返礼品、ネップリを含む商用利用 ※グッズ化を除く）\nサイン、イラスト、背景のレイヤー分けをいただいたpsd形式も頂けますと嬉しいです。\n\nリクエスト金額の不足や不備がございましたら、お手数ですが再送依頼をお願いいたします。\nリクエストをお受けいただけますと嬉しいです。よろしくお願いします。\n\nhttps://drive.google.com/drive/folders/1XEkq-squU8Zxsah6jZcxhkyOSyIWnmlu?usp=sharing", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 529427, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "🦔おてん🦔", "screen_name": "if959u", "avatar_url": "https://pbs.twimg.com/profile_images/1406272195551055876/lM_zqnxg.jpg", "header_url": "https://pbs.twimg.com/profile_banners/790832008561692672/1687880086/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 90, "skills": [{"genre": "art"}], "banned": false, "nc": 128}, {"id": 2177354, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "うさ🍑みみ ☕️🍞⚙️", "screen_name": "usahana101", "avatar_url": "https://pbs.twimg.com/profile_images/1986768949271461888/a_1AfK9h.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1317783337285545985/1760519719/1500x500", "appeal_receivable": false, "popular_creator_rank": 57, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_