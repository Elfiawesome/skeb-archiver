内にある衣装アイテム等は描きやすいように簡略化していただいて問題ございません\n\n【参考資料】\nhttps://drive.google.com/drive/folders/1E3vTu6aV-FqOatVuLl271Mk0jlSkabo8?usp=drive_link\n\n【使用先】\nVtuber活動での使用（収益化済みチャンネルでの使用、告知・サムネイル、SNSアイコンやヘッダー、サブスクライバーへの返礼品、ネップリを含む商用利用 ※グッズ化を除く）\nサイン、イラスト、背景のレイヤー分けをいただいたpsd形式も頂けますと嬉しいです。\n\nリクエストの金額に迷ったらを参考にそのままお送りしておりますが、\nリクエスト金額の不足や不備がございましたら、お手数ですが再送依頼をお願いいたします。\nリクエストをお受けいただけますと嬉しいです。よろしくお願いします。", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@_pachida_/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3871214, "client_id": 3289803, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/491b8413/uploads/origins/77fdd809-7048-406a-a39c-50df7c282a00?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5f5fb640de6ed27322ac4f8f9891a60c", "srcset": "https://si.imgix.net/491b8413/uploads/origins/77fdd809-7048-406a-a39c-50df7c282a00?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5f5fb640de6ed27322ac4f8f9891a60c, https://si.imgix.net/491b8413/uploads/origins/77fdd809-7048-406a-a39c-50df7c282a00?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=aee03dc153609c926d7fb00df7062e23 2x, https://si.imgix.net/491b8413/uploads/origins/77fdd809-7048-406a-a39c-50df7c282a00?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=0f7c7ac86627621c0376ea8a65c2468d 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/491b8413/uploads/origins/77fdd809-7048-406a-a39c-50df7c282a00?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=56ba279c52a13c2b74bd54d08c045e2e", "srcset": "https://si.imgix.net/491b8413/uploads/origins/77fdd809-7048-406a-a39c-50df7c282a00?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=56ba279c52a13c2b74bd54d08c045e2e, htt