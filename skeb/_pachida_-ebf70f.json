r=2&fit=crop&crop=top&w=200&h=200&s=3edaf96da5b44f6a0af67cadfcf5e81a 2x, https://si.imgix.net/7349d8b3/uploads/origins/35622b81-4241-497c-aeb5-57beb83a5a64?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=22f78ed9ea78b7e343c0bd021c3e5c26 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/7349d8b3/uploads/origins/35622b81-4241-497c-aeb5-57beb83a5a64?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b05dcb7ab110b084e7b977a040907d4b", "srcset": "https://si.imgix.net/7349d8b3/uploads/origins/35622b81-4241-497c-aeb5-57beb83a5a64?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b05dcb7ab110b084e7b977a040907d4b, https://si.imgix.net/7349d8b3/uploads/origins/35622b81-4241-497c-aeb5-57beb83a5a64?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=c24cc492718148cbf6cae095d3f89d16 2x, https://si.imgix.net/7349d8b3/uploads/origins/35622b81-4241-497c-aeb5-57beb83a5a64?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=9825fbf61f25dcb3ee5c8379dd27ca37 3x"}, "body": "ぱちだ様リクエスト失礼いたします。\nいつもぱちだ様のイラストをとても楽しく拝見させて頂いております。ぱちだ様の描かれるイラストが本当に大好きです。skebの開設とても嬉しいです。\n\n私のOC3人組を描いて頂きたいです。同じ組織に属しており同室で暮らしている仲良し3人組です。\n構図や表情等全てお任せでお願いしたいです。ぱちだ様の描きやすいよう、感じたまま描いてくださると嬉しいです。\n服装や髪型等も自由に変更して頂いて構いません。\n\n【使用用途】 ・本イラストは個人利用に限定させていただきます。\n ・SNSのアイコンへの使用や、個人鑑賞目的でのみ印刷させていただく場合があります。  \n\n金額が足りない場合は、遠慮なく再送依頼をいただければと思います。 \nまた、ご依頼内容が難しいと感じられた場合は、キャンセルしていただいても構いません。  \nお忙しいところ恐縮ですが、ご検討いただけますと幸いです。 何卒よろしくお願い申し上げます。\n\nhttps://drive.google.com/drive/folders/1FNpq-PZ2oKtd7O2RzDuBMld0k_H6RutY", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@_pachida_/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3871214, "client_id": 3486563, "vtt_url": null, "thumbnail_i