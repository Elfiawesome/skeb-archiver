f-536507ccdb5c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=79e296d0e16518354339e955ff3d21f0", "srcset": "https://si.imgix.net/4f86f027/uploads/origins/36cfb74b-45ef-4da2-ac8f-536507ccdb5c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=79e296d0e16518354339e955ff3d21f0, https://si.imgix.net/4f86f027/uploads/origins/36cfb74b-45ef-4da2-ac8f-536507ccdb5c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=fc1c62a96f0176d2a7ce31462db138fc 2x, https://si.imgix.net/4f86f027/uploads/origins/36cfb74b-45ef-4da2-ac8f-536507ccdb5c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=97ba91f9820e7dd8e7780d957415e1f7 3x"}, "body": "Hello again Pachida-san! Sorry for the mistake! Thank you again for your amazing work, I wanted to ask again for another artwork of my VTuber WUMBO in preparation for a cover song I am doing!\n\nI want to use this artwork in the MV for a cover of PRIMADONNA by SUISEI, and am requesting two artworks. Please adjust the price as necessary!\n\nThere are two pose requests in the reference as 01_POSE (Sitting on a chair with an Eyes Open expression, and an Eyes Closed expression) then 02_POSE (Winking at the camera with an Eyes Open expression, and a Winking expression). Please use the 03_PRIMADONNA_OUTFIT design for WUMBO! She is a Tan Dinosaur with Red Hair. In this MV, she is mischievous and wears bold sunglasses! \n\nThis artwork will be used in the MV for the video that will be posted on YouTube as well as Social Media platforms such as X/Twitter! If possible, please provide the PSD files or as a transparent PNG, and ensure that her head is in frame! And I trust your judgement if you would like to adjust the poses to what you see is best!\n\nThank you for your consideration!\n\nさん、またお会いできて嬉しいです！今回も素晴らしい作品を作っていただき、本当にありがとうございます。現在制作中のカバー曲に向けて、私のVTuber「WUMBO」のイラストをもう1点お願いしたいのですが！\n\nこのイラストは、SUISEIさんの「PRIMADONNA」のカバー曲のMVで使用したいと考えており、計2点のイラストをお願いしたいです。料金は適宜調整していただければと思います！\n\nリファレンスには2つのポーズリクエストがあります。01_POSE（椅子に座り、目を開けた表情と目を閉じた表情）と、02_POSE（目を開けた状態でカメラにウインクする表情と、ウインクする表情）です。WUMBOには「03_PRIMADONNA_OUTFIT」のデザインを使用してください！彼女は赤毛の茶色の恐竜です。このMVでは、いたずらっ子で、大胆なサングラスをかけています！\n\nこのイラストは、YouTubeやX/Twitterなどのソーシャルメディアに投稿されるミュージックビデオ（MV）で使用されます！可能であれば、PSDファイルまたは背景透明のPNGファイルで提供してください。また、必ず彼女の頭が画面内に収まるようにしてください！ポーズについては、ご自身の判断で最適な形に調整していただければと思います！\n\nご検討いただき、ありがとうございます！\n\nhttps://drive.google.com/drive/folders/1oT3lCB6vsRKmkeF-mIFHUspOKDVc-kUm?usp=sharing", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@_pachida_/works/8", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3871214, "client_id": 2780022, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/57c83976/uploads/origins/623a96a4-750e-47f0-95c4-562015b37295?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1b4de0eb5d883ff7a49e36c4ebc65a91", "srcset": "https://si.imgix.net/57c83976/uploads/origins/623a96a4-750e-47f0-95c4-562015b37295?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1b4de0eb5d883ff7a49e36c4ebc65a91, https://si.imgix.net/57c83976/uploads/origins/623a96a4-750e-47f0-95c4-562015b37295?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e387ed5d2bcfcaa63137887ff33adbe4 2x, https://si.imgix.net/57c83976/uploads/origins/623a96a4-750e-47f0-95c4-562015b37295?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c788bda5c43162f325bfe02b4a5d6988 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/57c83976/uploads/origins/623a96a4-750e-47f0-95c4-562015b37295?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3a4c9ab42459dce625db7b7640036807", "srcset": "https://si.imgix.net/57c83976/uploads/origins/623a96a4-750e-47f