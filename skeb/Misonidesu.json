nail_image_urls": {"src": "https://si.imgix.net/92d3fc21/uploads/origins/ebf2aa6b-1b26-4b56-bb97-5b815748b2e0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=87c799d9ffb483366e6470e9aabcce1b", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/92d3fc21/uploads/origins/ebf2aa6b-1b26-4b56-bb97-5b815748b2e0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=4de52651f7ea635718c66424d3e162d5", "src_set": ""}, "body": "前回はありがとうございました！今回もリクエストをさせていただきます。\n都合や内容が合わなければキャンセルしてください。\n\nリクエストの内容としましては\n・キャラクター:私のオリジナルキャラクターであるうちのこ｢えすけーちゃん｣のロリ化形態\n・表情、性格:無知、無邪気な少女\n\n・構図:触手に捕まり動けなくされ、犯される。\n\n・服装に関しては解釈お任せします。脱がしたり等自由にお願いします。\n破るのは好まないので、脱がしたり、めくったりでお願いします。\n\n※参照URLを送りますが、わからない部分など解釈による変更は問題ありません\n・参照URL:https://www.pixiv.net/artworks/121314941\n25-29がロリ化形態です", "nc": 185, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Misonidesu/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3584405, "client_id": 1018785, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/7b5da7f5/uploads/origins/b0a52bb3-3d11-45f9-befa-64178d9462ba?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0579e5b4c1a034ab64b5a0c94c6ed4c9", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/7b5da7f5/uploads/origins/b0a52bb3-3d11-45f9-befa-64178d9462ba?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=86980100410779a02b5f6bab31efc9cf", "src_set": ""}, "body": "初めまして。\nskebで拝見したイラストがとても好みでしたのでリクエスト致します。\n\n・キャラ\n遊戯王OCGの「アロマリリス-ローズマリー」\nhttps://x.com/YuGiOh_OCG_INFO/status/1724347687833653704/photo/1\nローズマリーの羽は無しで構いません。\n\n・シチュエーション\n(https://skeb.jp/@Misonidesu/works/1)のように触手に無理矢理挿入されて射精される。\n触手が服の中に侵入し下乳あたりにも射精している。\n触手が服の上から胸を弄っている。\n\n・その他\n胸は少し大きめで服は可能な限り着たままでお願いします。\nパンツの色は水色で脱がさずに横にずらして挿入されている状態をお願いします。\nハート目や快楽堕ち等は控えていただけると幸いです。\n\n\n描きにくい部分等はアレンジして頂いて問題ありません。\n\nご検討のほどよろしくお願い致します。", "nc": 185, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Misonidesu/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3584405, "client_id": 2853980, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/30d97711/uploads/origins/c1d0767d-165b-4c72-afb7-75519458582c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=513ffdbc066f2b4127ac24706028000c", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/30d97711/uploads/origins/c1d0767d-165b-4c72-afb7-75519458582c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2eb89cacd39e34a9ea24f7b50fee6611", "src_set": ""}, "body": "Miso煮さんこんにちは！そるとです！\n前回は素敵なイラストをありがとうございました！\n\nリピートリクエスト失礼します。\n\nそるとちゃんのアイコンを描いていただきたいです。\n\n【用途】\nMisskeyでアイコンに使わせていただきます。\n顔部分をアップにして使うので全身は描かなくても大丈夫です。(お任せします。)\n\n【構図(イメージ)】\nMiso煮さんのアイコンのような、壁からチラッと覗いている感じだと可愛くて好きです。(Miso煮さんが描きたいもの描いてください。)\n\n可能であればぜひよろしくお願いします！", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Misonidesu/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3584405, "client_id": 3020515, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/988ed7b2/uploads/origins/82d29c31-100a-4d5c-83a2-e231aac71e06?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=dc1dc9191b2be47325ef6f8485db2c74", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/988ed7b2/uploads/origins/82d29c31-100a-4d5c-83a2-e231aac71e06?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9206d19881cb3b7db785c673f763cfe3", "src_set": ""}, "body": "はじめまして\nOCの滝やん（https://www.pixiv.net/artworks/118922716）のイラスト制作をお願いしたいです（以下、Aで代用）。\n内容は\nAは森の中で巨大な花の形をした触手植物（植物の大きさは普通の人間くらいの大きさの人間を抱えられる）に捕まってしまう。\n触手植物は白い体液でAを麻痺させる。\n触手はAを縛る（Aはランダムな位置に縛られる）。\n結局、Aは触手植物に吸収され、吸収された魔力は成長のための養分として使われた。\n\nリクエストに応えてくれてありがとう！", "nc": 56, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Misonidesu/works/2", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/7ea03559/uploads/origins/eb00c911-d2f5-43ad-aa31-c3e5f3b9f600?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=6c03b0276ce6b91dca0476ca39cbc1cb", "src_set": ""}, "private": true, "genre": "art", "tipped": true, "creator_id": 3584405, "client_id": 2853980, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 41, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@Misonidesu/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3584405, "client_id": 1410295, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/e89e029d/uploads/origins/d8a4972a-d8b0-44ca-b45d-a00a35e8c299?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5e9f3cd1339c281578997b3632814a33", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/e89e029d/uploads/origins/d8a4972a-d8b0-44ca-b45d-a00a35e8c299?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=df818b2b91d91cd5a959d93eadf8e673", "src_set": ""}, "body": "はじめまして。イラストがとてもエッチで好みなのでリクエストを送らせていただきます。\n都合や内容が合わなければ断られても構いません。\n\nリクエストの内容としましては\n・キャラクター:私のオリジナルキャ