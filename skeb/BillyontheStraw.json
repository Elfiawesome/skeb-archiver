_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1855933, "client_id": 3015400, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/f2ed3468/uploads/origins/514eb0b5-2ff6-4795-8728-0863a6cbd582?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ee8527b622470da68f9fb84eb9d2ad3b", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/f2ed3468/uploads/origins/514eb0b5-2ff6-4795-8728-0863a6cbd582?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=aff897d9a59381f3ea3382312fc8ac5e", "src_set": ""}, "body": "Hello Billy-sensei! You draw such cute and handsome women! I really like your art and hope I can request my character.\n\nJAY (30):\n- She is a phantom thief who lives for beauty and pleasure. She uses her skills as a magician and forger to steal precious artworks. She often breaks rules spectacularly to draw people's attention to her. Life is a performance, and she is the main character.\n- Her personality is calm, charismatic, and fox-like. She takes pride in outsmarting other people.\n- She always wears sunglasses and earrings. Feel free to change the style of the accessories.\n- Motifs: magic tricks, illusions, painting frames, birds, roses, starry nights\n- Wardrobe: https://www.pinterest.com/6gildes/femjay/\n\nPlease cancel or resend if the amount is not enough, thank you!\n\nReference images: https://drive.google.com/drive/folders/1UQlhA4R9XMx2IBOHdDXQCY5CUPPaxrqn?usp=drive_link", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@BillyontheStraw/works/27", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1855933, "client_id": 3259601, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/6e9d35e5/uploads/origins/93210a7d-da24-4ff2-a44a-3011444ad233?bg=%23fff&au