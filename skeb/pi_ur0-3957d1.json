Twitter等のSNSアイコン・広報\nYouTubeやツイキャス配信サイトでのサムネイル\n個人での鑑賞など\n\n◇構図\nぴうろ様にお任せ致します！\n\n◇その他\nPNG形式のファイルで送って頂きたいです。\n\nもし活動上でも使用が大丈夫でしたら、配信サムネイルでの使用もあるため、透過差分等も頂けると幸いです。\n\n\n※アピールしていただいた際に銀髪と書かれていたのですが、色的に区別が付きにくく申し訳ないです。\n設定上は白髪のため、それでも大丈夫でしたら検討していただけると幸いです。\n\n\n失礼がありましたら申し訳ございません。\nご縁がありましたらよろしくお願い致します！\n\nhttps://sites.google.com/view/kurosesato/%E3%83%9B%E3%83%BC%E3%83%A0", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@pi_ur0/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2485922, "client_id": 1276865, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/245b4206/uploads/origins/5f0e007c-da1b-4f57-944a-37c354bc1358?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=dd6862e4d365c06402d8997edc6a02a0", "srcset": "https://si.imgix.net/245b4206/uploads/origins/5f0e007c-da1b-4f57-944a-37c354bc1358?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=dd6862e4d365c06402d8997edc6a02a0, https://si.imgix.net/245b4206/uploads/origins/5f0e007c-da1b-4f57-944a-37c354bc1358?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=4a11ddbecec2e9da80b3fff2402a97db 2x, https://si.imgix.net/245b4206/uploads/origins/5f0e007c-da1b-4f57-944a-37c354bc1358?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f30212f54c2a4dbd064726cf80525694 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/245b4206/uploads/origins/5f0e007c-da1b-4f57-944a-37c354bc1358?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6bfd8d0a91b1952732947964d3cb5069", "srcset": "https://si.imgix.net/245b4206/uploads/origins/5f0e007c-da1b-4f57-944a-37c354bc1358?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6bfd8d0a91b1952732947964d3cb5069, https://si.imgix.net/245