total_appeals_count": 0, "received_works": [{"path": "/@gen_syooooo/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3205669, "client_id": 19206, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/0b892802/uploads/origins/d661d162-cbf2-4a76-adbf-7880bf7aaca0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=35a312b4962a24005fee247e8955e22d", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/0b892802/uploads/origins/d661d162-cbf2-4a76-adbf-7880bf7aaca0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=1dbba5d68712a50d5f0918cee28346c8", "src_set": ""}, "body": "お世話さまです\n\n入口に紙垂（神社にある白いヒラヒラ）のついたしめ縄を付けて「神域（笑）」にした個室の便器に座る便女ヤタガラスさまお願いします\nヤタガラスさまの状態はお任せします\n\n入口の枠や扉がなくともしめ縄がかけられてる事がわかれば大丈夫です", "nc": 49, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@gen_syooooo/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3205669, "client_id": 19206, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/8f4f954f/uploads/origins/ae706ee0-9f7a-4bc0-b222-de56a4a02126?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a5b855dab3d2308bb96b47cbe06a024e", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/8f4f954f/uploads/origins/ae706ee0-9f7a-4bc0-b222-de56a4a02126?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6e2968dbcd3119136000766918586bea", "src_set": ""}, "body": "立ちんぼヤタ様ありがとうございました…\nエロかったです…\n\nその後度重なる交尾でボテ腹になるも立ちんぼを止めず落書きまでされてるヤタ様お願いします！", "nc": 48, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@gen_syooooo/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3205669, "client_id": 1366155, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/98aa2fb0/uploads/origins/b52e8c83-2a48-4762-8a2b-d00ecdfd7db4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8e29c7b910ec5035335e97503ca95754", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/98aa2fb0/uploads/origins/b52e8c83-2a48-4762-8a2b-d00ecdfd7db4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c043028bb6582547aa0a7d51c143d8e8", "src_set": ""}, "body": "遊戯王のRAI-MEIで\n\n・背筋を伸ばして胴全体が見える姿勢でのガニ股杭打ちピストン騎乗位をキャラの正面が見えるように\n・カードのイラストと同じコスチュームで股間のみ穴を開けた物を着用\n・全体的にむちむち\n・ツインテールは頭の幅と同じ位の太さで始まり腰まで届く長さ\n・下腹部がギリ見える位の超乳(乳のサイズを維持しつつ頭身高めで。大きくなりすぎる分にはいくら盛っても可)\n・淫語を連発する下品で口の悪いセリフ付き\n・マスターを誘うように挑発する→挿入されるも余裕ありげに調子に乗り、逆レイプ気味に快楽を貪り出す→反撃に会い即堕ち→トドメの思い切り白目を剥いたほぼ変顔のアへ顔アクメ\nといった構成\n\n以上の要素を加味しつつ描いて欲しいです。よろしくお願いします！\n\nhttps://drive.google.com/drive/folders/1jUv87DsnPJO7pNY_UW8SRfyrto7lmJwm", "nc": 176, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@gen_syooooo/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3205669, "client_id": 1366155, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/c674e206/uploads/origins/74e75099-12aa-4953-a4e4-c902ca068ec2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9d4a4dd3fe28bec49c2461248d36056d", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/c674e206/uploads/origins/74e75099-12aa-4953-a4e4-c902ca068ec2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c5480cceb0cf171cbafb7876e6f6da34", "src_set": ""}, "body": "遊戯王のRAI-MEIが女性器と両乳首からモンスターを勢い良く出産する姿をお願いします。\nモンスターと排出する箇所は以下の通りです。\n\n女性器：フォーマッド・スキッパー\n両乳首：サイバー・ヴァリーとサイバー・ドラゴン・ヘルツを左右それぞれから\n\n・服装は原作の物で胸部の乳輪周辺と股間周辺が破れて露出した状態\n・ポーズはキャラの頭から太ももまでを正面から写して頂ければ後はお任せいたします。\n・バストサイズは上半身が隠れ股間のすぐ上に届く位の超乳で、乳輪と乳首のサイズも大きめ。\n・頭身高めで前身むちむち、ツインテールは太めで腰に届く長さ\n\n以下シチュエーションの説明です。\n\n出産直前。乳房や胎内でモンスターが暴れる快感に決壊寸前で、声を漏らしながらも耐え悶えている。\n↓\n各部からモンスターの頭と全長の1/4程度が勢い良く飛び出してくる。この時点で既に一度アへ顔で絶頂する。\n↓\n全てのモンスターの全身が一気に引き抜かれ、先程とは比べ物にならない強さの絶頂を迎える。大きく目を見開いて白目を剥いたオホ顔で、間抜けな奇声のような絶叫を上げる。乳首はポッカリと大きく開いたまま母乳を垂れ流し、女性器は子宮脱を起こして子宮口が体外に引っ張り出されている。\n\nといった様子です。要求点が多くなってしまいましたがよろしくお願いいたします！\n\nhttps://drive.google.com/drive/folders/1pxd-7i8OdwqwfBqSseaFQPyXCEap2cJf", "nc": 160, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@gen_syooooo/works/2", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/e7eee608/uploads/origins/95caaf02-f64c-4c17-9925-0f5aa16e0681?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=7e04fe011d2d86f2aa3fdc3f74e6c33b", "src_set": ""}, "private": true, "genre": "art", "tipped": false, "creator_id": 3205669, "client_id": 0, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 160, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@gen_syooooo/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3205669, "client_id": 19206, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/1a3212fd/uploads/origins/691d93c6-c2a1-46f8-a437-68fe625f696e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=81da64d03ef1604cb37a8da28f688b87", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/1a3212fd/uploads/origins/691d93c6-c2a1-46f8-a437-68fe625f696e?bg=%23fff&auto=format%2Ccompress&fm