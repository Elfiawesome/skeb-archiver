、申し訳ございありません！\n\nキャラクターの資料は、Googleドライブを添付しました\n\n左頬の下部に一つのホクロがあります（ほぼ中心の位置)、提供資料の内容を基準とします\n魚形のヘアピン\n髪型は姫カット、長さは腰まで\n武士みたいな服装\n\n性格については、ちょっと狡い表情があります\n好きの動物は魚\n\n使用範囲は\nSNSのアイコンやヘッダー\nスマホの待ち受け\n\nお忙しいところ、私のリクエストにお時間を割いていただきありがとうございます！\n楽しんで描いたらとっても嬉しいです\n\nhttps://drive.google.com/drive/folders/1S3T2phchJUz0MS1A7Z1Ev2L76aCFBmDE", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@10101o8/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 4002141, "client_id": 2555700, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/7b7cd176/uploads/origins/1d68d4d3-e6fe-4855-a99e-01347b4ba355?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9ee4afaedc65b4d56c615cb5048392da", "srcset": "https://si.imgix.net/7b7cd176/uploads/origins/1d68d4d3-e6fe-4855-a99e-01347b4ba355?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9ee4afaedc65b4d56c615cb5048392da, https://si.imgix.net/7b7cd176/uploads/origins/1d68d4d3-e6fe-4855-a99e-01347b4ba355?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b7e6d98d8e7563b3cf89e78a604ea306 2x, https://si.imgix.net/7b7cd176/uploads/origins/1d68d4d3-e6fe-4855-a99e-01347b4ba355?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=7d00c2edfdd51be23b1392ca6bd6a2f4 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/7b7cd176/uploads/origins/1d68d4d3-e6fe-4855-a99e-01347b4ba355?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ea44d4fac8ead66a78440b4772048647", "srcset": "https://si.imgix.net/7b7cd176/uploads/origins/1d68d4d3-e6fe-4855-a99e-01347b4ba355?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ea44d4fac8ead66a78440b4772048647, https://si.imgix.net/7b7cd176/uploads/origins/1d68d4d3-e6fe-4855-a