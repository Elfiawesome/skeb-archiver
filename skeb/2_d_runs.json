t_client_visible": false, "total_appeals_count": 1, "received_works": [{"path": "/@2_d_runs/works/57", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1028822, "client_id": 2801967, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/d299b041/uploads/origins/a95ca778-c678-4485-813f-09c1bf24255e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=efe538a2eade915da3358532c0b2df71", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/d299b041/uploads/origins/a95ca778-c678-4485-813f-09c1bf24255e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0b1768970e6296c9b19c0f044863fb62", "src_set": ""}, "body": "いつもお世話になっております。TIEです。\n以前描いていただいたバニー(？)きりたんについて、とても良かったので続編的なものをお願いしたいです。\nhttps://skeb.jp/@Two_seq/works/47\n\n描いていただきたいキャラクターは同様に東北きりたんさんで、成年の成長IF(大学生～程度？)をお願いします。胸は控えめ(手頃なぐらい)でお願いします。\n\nシチュエーションについてですが、以前と同じデザインの衣装を着て、前より余裕がある、けれどやっぱり恥ずかしい、でも前より成長したんだし余裕なところを見せつけたい……な大人きりたんをお願いしたいです。\n\nよろしくお願いいたします！", "nc": 161, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@2_d_runs/works/56", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1028822, "client_id": 0, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/562d5826/uploads/origins/922e81f5-fe9c-4762-a1f1-9a645b3f05d3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a4105b43b53c2811ac526489f4b003aa", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/562d5826/uploads/origins/922e81f5-fe9c-4762-a1f1-9a645b3f05d3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=05f6e08389d0ddc178412621788390d6", "src_set": ""}, "body": "いつもお世話になっています。\n夏色花梨さんの某コラボ水着のイラスト（資料URLのイラスト）がすごくかわいかったので、コッショリですがリクエストします。\n\n「水着姿の花梨さんと、その恋人の男性が、シャワー室でセックスしているイラスト」をリクエストします。\n・恋人の男性が花梨さんの姿を見て股間を大きくしてしまったので、それに気づいた花梨さんが人のいないシャワー室に恋人を連れ込んでセックスし、互いにイって満足するというイメージです。\n・花梨さんはおっぱいだけでなく、乳輪や乳首も大きいと嬉しいです。\n・恋人の男性があまり目立たないように、体の一部もしくは全部が透明等になっても良いです。\n・花梨さんの乳首やおま○こが見える程度に水着をずらし、おち○ちんを挿入して射精するところまで見たいです。\n\nよろしければ、ご検討をお願いします。\n\nhttps://www.pixiv.net/artworks/132293240", "nc": 48, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@2_d_runs/works/55", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1028822, "client_id": 0, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/12d90f16/uploads/origins/90857547-cde2-494e-a182-f977faa55b84?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=102ffdea835642c406d23339da529aa7", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/12d90f16/uploads/origins/90857547-cde2-494e-a182-f977faa55b84?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c26be98a4ac6af0aa78374188c7b82e0", "src_set": ""}, "body": "いつもお世話になっています。\n夏色花梨さんがウェディングマイクロビキニ姿で（旦那様と）えっちしているｺｯｼｮﾘなイラストをリクエストいたします。\n\n・花梨さんの胸がとても大きいと嬉しいです。\n・花梨さんをメインで見たいので、旦那様の体は透明等あまり映らないようにお願いしたいです。\n・最高に幸せで甘々なシチュエーションを希望します。\n・もしよければ、花梨さんに射精した差分をお願いしたいです。\n\nお忙しいとは思いますが、ご検討よろしくお願いします。", "nc": 32, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@2_d_runs/works/54", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1028822, "client_id": 1897976, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/356854a1/uploads/origins/4887840d-77fa-405e-9a51-7f272d239e74?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bdb72c98f92cc89bdb1e0ed599501c67", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_th