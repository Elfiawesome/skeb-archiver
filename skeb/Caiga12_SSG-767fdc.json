rop=top&w=200&h=200&blur=200&s=001dd4321008f08adad811c9d207060f 3x"}, "body": "前回も素敵なイラストをありがとうございました。\n\n今回は、アイオワとガングート(艦これ)のツーショットをお願いします。\n\n衣装は両者ともウエディングドレスで表情は明るく笑っている表情。アイオワには眼鏡差分もお願いします。\n\n宛名の対角にあたる画面端には、6/20と日付をつけてください。\n\nよろしくお願いします。", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@tnsrk612/works/89", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 48102, "client_id": 298195, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/f01061c3/requests/235122_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4c28cb957c2ffd6247c977e8c707e01b", "srcset": "https://si.imgix.net/f01061c3/requests/235122_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4c28cb957c2ffd6247c977e8c707e01b, https://si.imgix.net/f01061c3/requests/235122_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=114708df49da1373417fcc7fd06f67b8 2x, https://si.imgix.net/f01061c3/requests/235122_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=eb7fa2e6a1e6922da8dfc4b59c9977fe 3x"}, "duration": null, "nsfw": true, "hardcore": true, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/f01061c3/requests/235122_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e402c45ec26a00605d7f29d6d5cc53e2", "srcset": "https://si.imgix.net/f01061c3/requests/235122_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e402c45ec26a00605d7f29d6d5cc53e2, https://si.imgix.net/f01061c3/requests/235122_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=7e832530362726959fba51e756dd6dc6 2x, https://si.imgix.net/f01061c3/requests/235122_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=ce0a7397d8d2ac54f5162c6bcc1bd8f8 3x"}, "body": "前回のアイオワさんと娘ちゃんのイラストありがとうございました。\n\n今回も前回と同じくアイオワさんと娘ちゃんのイラストで、アイオワさんが旦那さんとねっとりとした粘度の高いいちゃらぶエッチをしているところを、娘ちゃんがこっそり覗いているイラストをお願いします。\n\n[アイオワ]前回までとは違い出産した後でボテ腹ではなくなっている。全体的にちょっとむちむち感強め。\n\n[旦那さん]先生のいつも描かれている提督と同じような体格と陰茎の大きさ。\n\n[体位]体位は何でも構いませんが、身体を密着させディープキスをしながらセックスをしている。ゴムは無し。もう数回射精したようで精液が結合部から溢れている。\n\n[娘]ドアの隙間から目を大きく開きながら口は半開きで、二人のセックスを息を荒くしながら食いつくように見ている。手はパンツ越しに股間を触っており、股がぐちゅぐちゅに濡れて愛液が床に垂れている。\n\nよろしくお願いします。", "nc": 58, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@tnsrk612/works/73", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 48102, "client_id": 298195, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/9ea585c3/requests/112100_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bf899805346b475a5ec2324359a68811", "srcset": "https://si.imgix.net/9ea585c3/requests/112100_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bf899805346b475a5ec2324359a68811, https://si.imgix.net/9ea585c3/requests/112100_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=bd86925b403bd2ce8338b0cd4c3c7ecc 2x, https://si.imgix.net/9ea585c3/requests/112100_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=3edbd4511f489912987118c68255be1f 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/9ea585c3/requests/112100_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=db5742395b7b55011b3c5263387e23e7", "srcset": "https://si.imgix.net/9ea585c3/requests/112100_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=db5742395b7b55011b3c5263387e23e7, https://si.imgix.net/9ea585c3/requests/112100_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=f3ee4469b3435d6b90188cdd2456218d 2x, https://si.imgix.net/9ea585