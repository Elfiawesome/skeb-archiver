用用途\nYouTubeでのサムネイル、配信・動画内での使用\nX（旧Twitter）などの各種SNSでの投稿・告知等\nその他、自身のVTuber活動全般における使用\n\n■納品データについて\n可能でしたらPSD形式にて、人物、背景、また文字等が含まれる場合にはそれぞれレイヤー分けしていただけますと、大変ありがたく存じます。こちらに関しましても、大ッ嫌い様のご負担にならない範囲でご判断いただければと存じます。\n\n上記内容でご検討いただき、もしお受けいただけるようでしたら大変幸いに存じます。\n大ッ嫌い様にご縁をいただけましたら、これ以上嬉しいことはございません。\n宜しくお願い致します。\n\nhttps://drive.google.com/drive/folders/1CIGdZlqzpUOSynzE21vmH-3uprR0oSaR?usp=drive_link", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 934033, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "マコトウ", "screen_name": "mako_makotoo", "avatar_url": "https://pbs.twimg.com/profile_images/1704475610133958656/GZzgY-Yj.jpg", "header_url": "https://pbs.twimg.com/profile_banners/3263456155/1572620729/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 10, "complete_expiration_days": 60, "skills": [{"genre": "art"}, {"genre": "comic"}], "banned": false, "nc": 160}, {"id": 2594252, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "トロピカル坊や", "screen_name": "tr91641m", "avatar_url": "https://pbs.twimg.com/profile_images/1840203187120484352/ASOVbTEN.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1436277365928120321/1730910986/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 10, "complete_expiration_days": 30, "skills": [{"genre": "art"}], "banned": false, "nc": 17}, {"id": 3331244, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "こまーち ღ", "screen_name": "hhkoma1003", "avatar_url": "https://pbs.twimg.com/profile_images/1998325591028928512/oRCBKvBA.jpg", "header_url": "https://pbs.twimg.com/profile_banners/177580503886