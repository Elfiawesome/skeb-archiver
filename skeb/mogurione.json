75aa7a9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b01f0b55792a01734b02837400dd3030, https://si.imgix.net/d8a3470f/uploads/origins/8eebd39d-b177-4be9-92bd-1b16175aa7a9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=75276f5aecc7533371ba0b5e81edcd21 2x, https://si.imgix.net/d8a3470f/uploads/origins/8eebd39d-b177-4be9-92bd-1b16175aa7a9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=d300bdad5798ca7c6825c118cc538113 3x"}, "body": "以前親子でおねしょおむつの交換をしているイラストを希望した者です。\nその節は大変お世話になりました。\n再度リクエストお願いしてもよろしいでしょうか？\nワンチャンリクエストに投げようとも思ったのですがどうしても見てみたかったのでskebにて失礼致します。\n\n夜尿症のヤンママが子供達を怒鳴りながらおねしょしたおむつを脱いでいるイラストをお願いします。構図は以前お描きになったhttps://www.fanbox.cc/@mogurione/posts/9835642と同じ感じで\n「ママおむつ替えるから自分達で出来ることはやれ！」みたいな感じで第三者から聞くと子供のおむつを変えているのかな？と思いきや実は自分のおむつを変えていた…とわかるようなセリフを言っていて欲しいです。それっぽいセリフなら一言一句同じでなくて大丈夫です。\n\n差分で濡れたスウェットを履いているイラストとおむつが脱げているイラストがあると尚嬉しいです。\nできればお尻と太ももは気持ち太めのむっちりとした体型だとありがたいです。\nおむつはパンツタイプでお願いしたいのですが、それ以外の詳細はお任せいたします。\n\n何卒ご検討よろしくお願いします。", "nc": 43, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@mogurione/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3400146, "client_id": 1017803, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/826f6f25/uploads/origins/03e17710-2ba2-4a21-9fb6-f14f4516c446?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8951a3a7e6d26703097513fe4113421e", "srcset": "https://si.imgix.net/826f6f25/uploads/origins/03e17710-2ba2-4a21-9fb6-f14f4516c446?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8951a3a7e6d26703097513fe4113421e, https://si.imgix.net/826f6f25/uploads/origins/03e17710-2ba2-4a21-9fb6-f14f4516c446?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=5272ec4e1127ca97f1ff3262b2c2fc3f 2x, https://si.imgix.net/826f6f25/uploads/origins/03e17710-2ba2-4a21-9fb6-f14f4516c446?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=949dbbab4e4ecc06ed74fa53ee9a5e69 3x"}, "duration": null, "nsfw": true, "hardcore": true, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/826f6f25/uploads/origins/03e17710-2ba2-4a21-9fb6-f14f4516c446?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c1f6ee83b694482b749fdb5be8e5e9d4", "srcset": "https://si.imgix.net/826f6f25/uploads/origins/03e17710-2ba2-4a21-9fb6-f14f4516c446?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c1f6ee83b694482b749fdb5be8e5e9d4, https://si.imgix.net/826f6f25/uploads/origins/03e17710-2ba2-4a21-9fb6-f14f4516c446?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=1bd0e74ab9b7e2f787855bdbeed9e30b 2x, https://si.imgix.net/826f6f25/uploads/origins/03e17710-2ba2-4a21-9fb6-f14f4516c446?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=b9366e0d1e22926580844780261a6e0a 3x"}, "body": "こんにちは！前回は私のリクエストに素晴らしい仕事をしていただきありがとうございました。本当に細部まで素敵で楽しかったです。\n\nまた同じようなコンセプトで、7歳と12歳の女の子を比較した作品をお願いしたいです。\n\nシーンは、学校から帰ってきた女の子と、立ったままオムツ（テープタイプ）をチェックするママです。\n\n7歳ではシンプルなTシャツとスカートを着ており、ママはそれを持ち上げておむつを見せる。12歳バージョンは中学校の制服姿。おむつはかなり濡れているが、よく持ちこたえている。\n\nどちらのシーンでも、ママは親切に優しく接し続け、おむつが濡れていることを指摘する。7歳バージョンでは、女の子は無邪気に「いっぱい出たよ」などと答えるが、12歳バージョンでは、ママが「どうして保健室の先生に替えてもらわなかったの？\n\n台詞は日本語でOK！\n\nありがとうございました！\n\nhttps://skeb.jp/@mogurione/works/6", "nc": 170, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@mogurione/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3400146, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/a12391b7/uploads/origins/89aff164-612e-48cd-95ea-1339bdfc9854?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ab5cad1713296dc9754574a19c16ea8b", "srcset": "https://si.imgix.net/a12391b7/uploads/origins/89aff164-612e-48cd-95ea-1339bdfc9854?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ab5cad1713296dc9754574a19c16ea8b, https://si.imgix.net/a12391b7/uploads/origins/89aff164-612e-48cd-95ea-1339bdfc9854?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=7f79fbb30aa3cbc8ea141ac845e740b9 2x, https://si.imgix.net/a12391b7/uploads/origins/89aff164-612e-48cd-95ea-1339bdfc9854?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=906146dcf5bd0e5b3716a6ff31771221 3x"}, "duration": null, "nsfw": true, "hardcore": true, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/a12391b7/uploads/origins/89aff164-612e-48cd-95ea-1339bdfc9854?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b66fc0744b043b2ef8f7a306f01dbb16", "srcset": "https://si.imgix.net/a12391b7/uploads/origins/89aff164-612e-48cd-95ea-1339bdfc9854?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b66fc0744b043b2ef8f7a306f01dbb16, https://si.imgix.net/a12391b7/uploads/origins/89aff164-612e-48cd-95ea-1339bdfc9854?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=3b19a3eff9037d528e6d3f051c28e516 2x, https://si.imgix.net/a12391b7/uploads/origins/89aff164-612e-48cd-95ea-1339bdfc9854?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=e32ff0b961ca4488682f21eefb55fd53 3x"}, "body": "こんにちは！ママにおむつを替えてもらっている女の子の写真を並べて欲しい。7歳のときと12歳のときのオムツの状態がわかる。\n\n写真は半分に分かれていて、左半分は7歳の彼女がパジャマのズボンを脱いでベッドに横たわっているところです。両足はM字になり、足はベッドの上に置かれている。テープタイプのおむつはかなり濡れているが、漏れてはいない。ベッドの上にはベビーワイプ、新しいおむつ、パジャマのズボンが置かれている。右半分は同じポーズと状況だが、少女は12歳になっている。\n\n7歳と12歳で、彼女の体、おむつ、気分がどのように違うかを示してください。7歳の女の子はおむつについてまったく気にしていないように見えますが、12歳の女の子は少し恥ずかしそうにしていますが、不快でも苦痛でもないようです。どちらの年齢でも、ママは親切で、優しく、少しからかうような態度をとることができる。\n\n台詞は日本語でOK。\n\nご迷惑でなければ幸いです！\n\nありがとうございました！", "nc": 186, "word_count"