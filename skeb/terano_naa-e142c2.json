c-dcde40380956?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=d3b05c0328e4af387e4e97b858562f58 3x"}, "body": "はじめまして。しおりと申します。\n寺乃なあ様の描かれるイラストの雰囲気に惹かれリクエストさせていただきました…！\n\n■使用用途\n　・私の推しのVTuberである 碓氷ゆら さんへのプレゼント（FAタグを用いたXへの投稿）\n　　※寺乃なあ様に描いていただいた旨を記載させていただきます。\n　　※ご本人の活動で使用する可能性がございます。\n\n■リクエスト内容\n　○シチュエーションなど\n　・碓氷ゆらさんの白黒衣装姿でご自由に描いていただけないでしょうか。\n　　構図やポーズ、表情等は描きやすいように描いていただければと思います。\n　・服装については資料の「三面図_白黒衣装」をご参照ください。\n　　また、「白黒衣装_バリエーション」からお好きな組み合わせのものを描いていただければと思います。\n　・髪型については資料の「髪型サンプル」から、これだ！というもので描いていただければと思います。\n　　（髪型のアレンジについても大歓迎です...！）\n\n　○碓氷ゆらさんについて\n　・イメージカラーは水色\n　・水色や薄ピンク等のパステルカラーが好き\n　・リボン、レース、フリル等の女の子らしいものが好き\n　・優しい雰囲気、よく笑う\n　・瞳の中に三日月型のハイライト\n　・身長156cm\n\n　○その他\n　・頭は見切れていない構図でお願いしたいです。\n　・人物、背景、宛名が別レイヤーのPSDにて納品いただきたいです。\n　　※必要であれば別レイヤーにてウォーターマークを設定していただければと思います。\n　・簡単にでも構いませんので背景まで描いてくださると嬉しいです。\n\n■資料等\n　・三面図、髪型サンプル\n　　https://drive.google.com/drive/folders/1yTUYB7nF-wOMXoKI0SkIObgmn9RsI8ZQ?usp=sharing\n　・二次創作ガイドライン\n　　https://project-nebula.com/guideline\n　・YouTube\n　　https://youtube.com/@yurayurausui", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}], "sent_works": [], "similar_creators": [{"id": 958979, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "れも", "screen_name": "7se_k9", "avatar_url": "https://pbs.twimg.com/profile_images/1511378803167473665/hkE2N_WX.jpg", "header_url": "https://pbs.twimg.com/profile_banners/739102633319759876/1514479618/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "art"}, {"genre": "correction"}], "banned": false, "nc": 32}, {"id": 1201054, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "ぽとわり", "screen_name": "popotowari", "avatar_url": "https://pbs.twimg.com/profile_images/149823586529825