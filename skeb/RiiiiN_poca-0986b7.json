g&s=06\n\n◆使用用途\n・にこさんへのプレゼント(ご本人様がXなどのSNSでの宣伝や配信のサムネイルに使用されるご許可を頂きたく思います)\n※誠に勝手ながら、リクエストの承認・作品の納品をもって、ご許可を頂けたものと致します。\n・私のXアカウントでの投稿（りん🍏様に描いていただいた旨）\n\n◆納品形式\n可能であればサイン、人物、背景のレイヤーを分けたPSDデータでお願いいたします。\n\n◆ご参考資料\n本人のチャンネル\nhttps://www.youtube.com/@Nico_nicodon\n\nご検討のほど宜しくお願い申し上げます。\n※Skebへの依頼をにこさんは了承されています。", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@RiiiiN_poca/works/17", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2624180, "client_id": 2275507, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/5598f32e/uploads/origins/2dd1dc64-4623-407c-b6ac-89836520c55f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c3ddef643fda6fdde266dbd8748526dc", "srcset": "https://si.imgix.net/5598f32e/uploads/origins/2dd1dc64-4623-407c-b6ac-89836520c55f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c3ddef643fda6fdde266dbd8748526dc, https://si.imgix.net/5598f32e/uploads/origins/2dd1dc64-4623-407c-b6ac-89836520c55f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=4f100c1cb6325e8ae5cf902a88117bac 2x, https://si.imgix.net/5598f32e/uploads/origins/2dd1dc64-4623-407c-b6ac-89836520c55f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=7245f0ac24276299304c22b89794c431 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/5598f32e/uploads/origins/2dd1dc64-4623-407c-b6ac-89836520c55f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2545d8ce909ada83dbc96d46c55749aa", "srcset": "https://si.imgix.net/5598f32e/uploads/origins/2dd1dc64-4623-407c-b6ac-89836520c55f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2545d8ce909ada83dbc96d46c55749aa, https://si.imgix.net/5598f32e/uploads/origins/2dd1dc64-4623-407c-b6ac-89836520c55f?bg