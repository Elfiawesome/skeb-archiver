-be4a-a0a3090bdb78?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&blur=200&s=5855f16123f72132fcf6678ace08c6b7, https://si.imgix.net/bfc2b182/uploads/origins/98b6b667-8bcb-4dce-be4a-a0a3090bdb78?bg=%23fff&fm=webp&auto=compress&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=729f4972a249e6e2122caff9f8f57fd4 2x, https://si.imgix.net/bfc2b182/uploads/origins/98b6b667-8bcb-4dce-be4a-a0a3090bdb78?bg=%23fff&fm=webp&auto=compress&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=04bd4cdeee1eeda75d2423f3cf77a2d4 3x"}, "body": "初めまして、こんにちは、色差hote様。\n観月と申します。\n\nこの度は大変申し訳ございませんが、今すぐお邪魔させていただきます。\n\n私が依頼したいキャラクターは：ダンガンロンパv3の王馬小吉とわたしのキャラクター(観月千鶴)\n\nhttps://drive.google.com/drive/folders/1mICIXmvRiTbcXPtB7PRQCCLSmUPHvb7X\n↑ これは二人の画像資料です！\n\n王馬小吉:\n156cm/16歳/男の子\n無邪気な顔、でも心の中に小悪魔。\n笑顔/泣い顔/恥ずかしい(本当にある？)顔が大好き\n嘘つき、しかしあの子の真意が優しいな嘘。\n\n観月千鶴に恋愛感情を抱く考え、しかし、自分もよくわからない...\nだからこそ観月千鶴に近づきたいのに、危険だと感じる。\n恋愛が苦手な子ですね。\n\n観月千鶴:\n165cm/16歳/女の子\n冷たい顔、三白眼、クラゲカットの髪\n一見、付き合いにくそうに見えます、実際は人見知りな人。\n王馬小吉に対して明らかな偏愛を抱いている。\n自分の内気さを乗り越えて王馬小吉と上手くやるように努力する。\n\n殺し合うの中で、観月は王馬に一目惚れした。\nしたがって、観月は一貫して王馬に従っています。\n二人でおしゃべりをしたり、ふざけたりしながら、抑圧的な雰囲気の中で懸命に生きています。\nしかし王馬は殺し合いを終わらせるために、自ら犠牲になることを選んだ。\n最後、観月は精神的に耐えられずに自殺を選択しました、彼女は王馬の死を受け入れられないから。\nもし亡くなった王馬に会えるなら、彼はきっと笑顔で「さようなら」と言うだろう。", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@colordifference/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3922854, "client_id": 2554869, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/d01722d2/uploads/origins/de737532-0909-439a-8327-8acb48fd2f4b?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&s=07efe787b16ae160d7ffcd6ec927a7bd", "srcset": "https://si.imgix.net/d01722d2/uploads/origins/de737532-0909-439a-8327-8acb48fd2f4b?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&s=07efe787b16ae160d7ffcd6ec927a7bd, https://si.imgix.net/d01722d2/uploads/origins/de737532-0909-439a-8327-8acb48fd2f4b?bg=%23fff&fm=webp&auto=compress&dpr=2&fit=crop&crop=top&w=200&h=200&s=29f7b9aa548598b95fac3588b5f4949d 2x, https://si.imgix.net/d01722d2/uploads/origins/de737532-0909-439a-8327-8acb48fd2f4b?bg=%23fff&fm=webp&auto=compress&dpr=3&fit=crop&crop=top&w=200&h=200&s=40eda90d4502b2347c1501eb1ecb9c1a 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/d01722d2/uploads/origins/de737532-0909-439a-8327-8acb48fd2f4b?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&blur=200&s=949c44d7347aa4e15b18c24f9c1b3073", "srcset": "https://si.imgix.net/d01722d2/uploads/origins/de737532-0909-439a-8327-8acb48fd2f4b?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&blur=200&s=949c44d7347aa4e15b18c24f9c1b3073, https://si.imgix.net/d01722d2/uploads/origins/de737532-0909-439a-8327-8acb48fd2f4b?bg=%23fff&fm=webp&auto=compress&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=b3ffe1a453230794a359288bbe60799a 2x, https://si.imgix.net/d01722d2/uploads/origins/de737532-0909-439a-8327-8acb48fd2f4b?bg=%23fff&fm=webp&auto=compress&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=36d38f104565a5d9fa37d08bb8f7e842 3x"}, "body": "こんにちは！あなたの作品が本当に大好きなので、私のオリジナルキャラクターであるウィリアムとイルを描いていただけないでしょうか。彼らの物語は1970年代のニューヨークが舞台です。かつて恋人同士であり、師弟関係でもあった二人は、世界的に有名な歌手と、その秘密のマネージャーという関係です。\nウィリアムは明るく優しい性格ですが、少し自信がないところがあります。彼はネガティブな感情を隠し、公の場では常に完璧なポップスターとして振る舞っています。\nイルは優雅で謎めいた存在、「都市伝説」のような人物です。彼はウィリアムの音楽に対する揺るぎない情熱に惹かれ、彼の秘密の導き手になることを決意しました。彼はウィリアムの前では、わざと自分のダークな一面を隠しています。\nウィリアムが20歳になった時、ついに世間に認められるようになります。しかし、その直後、イルは突然彼の人生から姿を消してしまいました。それ以来、ウィリアムは様々な場所でイルの姿を目にするようになりますが、それは彼の手の届かない、単なる幻に過ぎませんでした。\n\n衣装は自由に選べますし、ご自身でデザインすることも可能です。お支払い金額が適切でない場合は、再送いたしますのでお知らせください。ご配慮いただきありがとうございます！\n\nhttps://drive.google.com/drive/folders/1-8dSTlKrRY5ba0yuRKXgFrt679MSqg6i?usp=sharing", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}], "sent_works": [], "similar_creators": [{"id": 1797