ins/a5dfcd05-40b3-4c9a-a383-897c4cd6a884?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4d70a7dd699f9850cd97dd49884e5f60", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/1eb81f1c/uploads/origins/a5dfcd05-40b3-4c9a-a383-897c4cd6a884?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=13e81622dedcf26720a4828b281c6e27", "src_set": ""}, "body": "初めまして、VTuberで活動中の黒瀬ナギリと申します。\n💪くとう💪様のイラストを拝見して、是非依頼を受けて頂ければと思いリクエストお送りさせて頂きました。\nお忙しいところ恐縮ですがご検討のほどよろしくお願いいたします。\n\nこちらが私のVTuberの姿の資料です。\nhttps://twitter.com/kurose_ovo/status/1713056537999208860\n\n服装はそのままで(上着は無しでも大丈夫です)構図については💪くとう💪様が書きやすいようにお願いできればと思います！\n\nサムネ(収益化済)やその他活動(Xでの宣材・壁紙・ネットプリント・グッズ作成など)で使用させて頂きたい為、頭の先と左右が途切れない形で頂けると助かります。\n(使用不可の用途がある場合は教えて頂けますと助かります！）\nまた、背景を付けて頂ける場合は可能であれば人物だけで透過できるように背景と分けられたPSD形式か透過したPNG形式で頂けると嬉しいです！\n\n手短で申し訳ございませんが何卒ご検討のほどよろしくお願いいたします。\n\nhttps://twitter.com/kurose_ovo/status/1713056537999208860", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@910_ch/works/38", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/3f550d29/uploads/origins/58f71a4d-c1bd-49d0-8de8-8726e6523dbc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=220904c49747b4ab8129a6bf62807a9f", "src_set": ""}, "private": true, "genre": "art", "tipped": false, "creator_id": 3173434, "client_id": 1408081, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 161, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@910_ch/works/37", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3173434, "client_id": 3081462, "vtt_url": null, "thum