table": true, "yearly_report_client_visible": false, "total_appeals_count": 31, "received_works": [{"path": "/@sittomasuku/works/82", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 679928, "client_id": 2610969, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/e19b1cee/uploads/origins/da9ec340-17e2-4e3e-9758-975618db967f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=92be94f03362a574916c58d20718983d", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/e19b1cee/uploads/origins/da9ec340-17e2-4e3e-9758-975618db967f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=294dad6f34e468b772367e5238ca4429", "src_set": ""}, "body": "激しく乳を揺らした超乳純狐ママに搾られる巨根ショタ君お願いします…\n\n細かいシチュエーション・プロポーション等\n場所・人里の納屋\n\n純狐\n胸がとても大きい、尻も同じぐらい大きい\n\nショタ君\n膣奥に届くぐらいの巨根、背格好は小学低学年程\n\nセリフ\nショタ君｢お…お姉さん…こんな事しちゃダメな気がする…｣\n\n純狐｢ふぅん…逆らうの？｣\n\nショタ君｢あっ…いや…あの…｣", "nc": 41, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@sittomasuku/works/81", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 679928, "client_id": 0, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/4d10e599/uploads/origins/f072b3a1-be88-4afb-a842-2710a54ba5b3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=03e540209ec7c58ce7120135c25b33df", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/4d10e599/uploads/origins/f072b3a1-be88-4afb-a842-2710a54ba5b3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=fb2a9e630377ace1d81d21b8376c5cba", "src_set": ""}, "body": "【キャラ】\n古明地さとり（東方Project）\n\n【シチュエーション】\nベッドに寝転がってのラブラブエッチからの中出し。\n\n【バストサイズ】\nでっかく\n\n【服装】\n東方ロストワードの「真夜中のメンタリスト」衣装（下記参照）\nhttps://drive.google.com/file/d/1471305uLRFl9q4cznBPnHJI38uqRDItX/view?usp=drive_link\n乳首のところにハート型の穴を開けてください。\n\n【構図】\n上から見下ろした状態。\n\n【その他】\nボテ腹でお願いします。", "nc": 161, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@sittomasuku/works/80", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 679928, "client_id": 0, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/20ea9ce9/uploads/origins/59c6372d-23e2-4d3d-9331-265dafca4211?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3fcdb2b4cadd334b8d0ac38040306f28", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/20ea9ce9/uploads/origins/59c6372d-23e2-4d3d-9331-265dafca4211?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=98a3fbf9845b2a395fee011fddf7b0fe", "src_set": ""}, "body": "【キャラ】\n坂田ネムノ（東方Project）\n\n【シチュエーション】\n迷い子を保護した夜、自分の小屋で筆おろし＋中出し。\n\n【服装】\n原作服。\n胸や局部は露出した状態でお願いします。\n\n【構図】\nでっかいおっぱいを強調していただければ他はお任せします。", "nc": 177, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@sittomasuku/works/79", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 679928, "client_id": 2102369, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/3799d609/uploads/origins/51ba6e62-ba89-4cc1-b5a0-75251e3afc23?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=176c32cbe18d621011c807c97cc792ea", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/3799d609/uploads/origins/51ba6e62-ba89-4cc1-b5a0-75251e3afc23?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9189d20a62cca3d9be0f75c25d0d1113", "src_set": ""}, "body": "嫉妬マスク@Skeb募集中 例大祭:C13a 総集編DL開始さんの絵柄が個人的に好きなので、描いて欲しいイラストがあります。\n東方projectの古明地こいしとのイチャラブエッチなイラストをお願いします。\nこいしは帽子とサードアイ以外裸で、肉体は全体的にムチムチしていて、胸は大盛でお願いします。\n体位は正常位でお願いします。\n具体的には白いシーツの上で好きな人とイチャイチャしながらエッチしてるのをお願いします。出来れば中出しのところまで描いて欲しいです。\nこいしの台詞や表情はお任せします。\nどうか宜しくお願いします！", "nc": 33, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@sittomasuku/works/78", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 679928, "client_id": 0, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/56384892/uploads/origins/a61e5eab-9c48-4f41-a404-0c79b9977931?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=79741c89774e21e0e2ef61f7725e1c03", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/56384892/uploads/origins/a61e5eab-9c48-4f41-a404-0c79b9977931?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c2c8293af96f949a5c5bca4394003c66", "src_set": ""}, "body": "【キャラ】\n稗田阿求（東方Project）\n\n【シチュ】\n褐色メスガキJカップギャルとなった阿求が、\n寺子屋帰りの獲物を裏路地で襲って搾り取ってしまう。\n（着衣エッチでお願いします）\n\n【服装】\nギャルが着ていそうな露出多めな服＋派手なレース状のパンツ\n\n【構図】\nでっかいおっぱいを強調していただければ他はお任せします。", "nc": 168, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@sittomasuku/works/77", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 679928, "client_id": 462930, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/b94e5995/uploads/origins/7eae44a2-a2b2-4b1b-a3df-4501bc88a0c2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=06bc901b69bab7a8b348305d775d174a", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/b94e5995/uploads/origins/7eae44a2-a2b2-4b1b-a3df-4501bc88a0c2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c35ee5c52c3a7ab2ec5b327e7c8818c6", "src_set": ""}, "body": "東方のパチュリーでまた依頼します。\n\nシチュエーションは\n淫紋を付与されたパチュリーが\n人間のおじさんに孕まされるというものです。\n\n体位は男性主観の正常位で\n以下の影狼や椛などの過去依頼の同じアングルで\nおじさんと汗だくセックスします。\n\nhttps://skeb.jp/@sittomasuku/works/13\nhttps://skeb.jp/@sittomasuku/works/16\n\n\nおじさんに夜這いされてお腹に淫紋を付与されたパチュリーは\nベッドの上で股を開かされた体勢で犯される直前で\n七曜の魔女であるこの私が知性の欠片もないおじさんと\n契りを交わすとかありえない止めなさいと最初は強気ですが\nおじさんが本気で自分を犯す気なのだと気づいて\n処女だから許してと懇願しますがもちろん犯されます。\n\nおじさんチンポで処女を散らされたパチュリーは悔しそうですが\nお腹の淫紋が処女専用でこの淫紋が付与された状態で処女を散らして\n中出しまでされると魔術的に夫婦契約が結ばれる効果があり\n更に必ず妊娠する効果もあると知らされると知らされ\nこんなおじさんと夫婦の契りを結ぶなんていやぁと悲鳴をあげますが\n高名な自分が下賎な男に孕まされる状況にゾクゾクしており\nついに中出しされてパチュリーは絶頂します\n\n絶頂の余韻に浸るパチュリーのお腹の淫紋が光り\nおじさんと夫婦関係が結ばれて妊娠したことを知らせると\nパチュリーはおじさんと夫婦の契りが結ばれたことを理解し\n私の魔女マンコでおじさんの赤ちゃん産みますと誓います。\n\nといった内容を擬音や台詞ありで\n過去依頼と同程度の差分をお願いします。\n\n大きなおっぱいと結合部が見えていれば\n服は全裸でも半脱ぎでもマイクロビキニとかでもOKです。\nマイクロビキニ等の場合は黒や白等の単色でお願いします。\n\n陰毛描写は有りでお願いします。\n\n以上、ご検討ください。", "nc": 56, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@sittomasuku/works/76", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 679928, "client_id": 0, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/613a848c/uploads/origins/4efdb78f-cb2e-4435-9155-4d2caa117ccc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f369a15517bbe252fae8227692c15991", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/613a848c/uploads/origins/4efdb78f-cb2e-4435-9155-4d2caa117ccc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=8332780b01e300235ee8aca4c059a03c", "src_set": ""}, "body": "リクエスト失礼します。\n\nキャラクター\n東方Projectの西行寺幽々子をお願いします。\n\n衣装\n布面積が少ないマイクロビキニをお願いします。\n\n内容\n幽々子が、男性に後ろから、乳首を乳首責めされながら、おまんこを手マンされている内容をお願いします。(この時幽々子は、男性の催眠術によって、常識改変されていて、『目の前の男性はマッサージ師』『今、自分(幽々子)が男性にされていることはただのマッサージ』と思い込まされてる。)\n\n差分\n絶頂差分をお願いします。\n\n台詞\n上記の内容に合った台詞をお願いします。\n\n可能でしたら、全裸差分を描いてもらえるととても嬉しいです。\n\nどうかよろしくお願いします。", "nc": 169, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@sittomasuku/works/75", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 679928, "client_id": 0, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/9fbb4143/uploads/origins/9ed6085a-ac7c-48ff-85a9-a8f8a0750769?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fa8dbf0e023312a039d7ad447fa9125b", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/9fbb4143/uploads/origins/9ed6085a-ac7c-48ff-85a9-a8f8a0750769?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f3c431902f439aa006ef4ef5fb9418e2", "src_set": ""}, "body": "【キャラ】\n射命丸文（東方Project）\n姫海棠はたて（東方Project）\n\n【服装】\n布面積が少なく露出度の高い天狗衣装＋下着なし\n\n【シチュ】\n爆乳ボテ腹を揺らしながらのラブラブ3P。\n両方とも中出しをお願いします。\n\n【構図】\n布団で横並びに寝転がった状態。\n以前依頼させていただいた華扇(works/51)が近い感じです。", "nc": 176, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@sittomasuku/works/74", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 679928, "client_id": 2773996, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/e4ae2802/uploads/origins/2664956c-d95d-4ec0-afed-25dc14250633?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d74bb135ab63184708a94a47eed88b40", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/e4ae2802/uploads/origins/2664956c-d95d-4ec0-afed-25dc14250633?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=8ebbe125d21276bbf4dbf4e61f3e1883", "src_set": ""}, "body": "could i get my oc in a half portrait in a cow girl outfit with a ahegao face with her breast out\n\nhttps://x.com/YFbiagent/status/1875111545379983756", "nc": 160, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@sittomasuku/works/73", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 679928, "client_id": 0, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/74c80f42/uploads/origins/725ff495-2abc-461a-ada2-09945e97a814?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=40f69d8ab88dd5cbeeb21daea1be6512", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/74c80f42/uploads/origins/725ff495-2abc-461a-ada2-09945e97a814?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=94f0ee2b737cf0981c5d9c8c96e5831d", "src_set": ""}, "body": "【キャラ】\n秦こころ（東方Project）\n原作通りのロングヘアでお願いします。\n\n【服装】\nCG集「エロ水着を着た巨乳お姉さんとハメピスする話」で、こころが着ていた水着。\n（乳首に輪っかがはまっており、複数の球が連なったヒモ水着）\n下の水着も同じように球が連なったヒモ水着に変更してください。\n\n【シチュ】\n以前、こころとのエッチで惨敗した少年はリベンジを誓い再度エッチに挑むも、\n全く歯が立たず、結局何度も搾り取られてしまうのであった…みたいな感じです。\n\n【構図】\n海辺の岩に隠れて片足を大きく上げての交尾＋中出し。\n以前投稿された「スリングショット藍様（artworks/116706220）」が近い感じです。\n『海の中で交尾している』感が欲しいので、下の足は膝くらいまで水に浸かった状態でお願いします。\n\n【その他】\n「スリングショット藍様（artworks/116706220）」と比較して、\nおっぱいを一回り大きくしてください。", "nc": 48, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@sittomasuku/works/72", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 679928, "client_id": 462930, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/55692e27/uploads/origins/1c6e5014-08e2-45c6-8f41-bc01cf2a0f94?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=eb83ae01b81cc9c8943051c0b4441a30", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/55692e27/uploads/origins/1c6e5014-08e2-45c6-8f41-bc01cf2a0f94?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d294b4c98a8c99924ebc295a51537759", "src_set": ""}, "body": "東方Projectのアリスとパチュリーでまた依頼します。\n\n過去依頼でゴブリンの孕み袋となった二人が\nゴブリンの前で同時出産する絵をお願いします。\n\n二人の過去依頼\nhttps://skeb.jp/requests/811038　アリス\nhttps://www.pixiv.net/artworks/91875075　パチュリー\n\n巨乳でムチムチボテ腹の二人は全裸でベッドで股を開き\n出産間近のため全身で汗だくでふーふー吐息を漏らしています。\n\n画面内にはいませんが二人の前にはゴブリンがおり\n魔女二人を孕ませて出産させる征服感に上機嫌で\n産まれる子が人型なのかゴブリンなのか楽しみにしてます。\n\nそして二人同時に出産が始まり、\n開いたアソコから見えた頭部は緑色でゴブリン確定\nこれから産む子はゴブリンだと知らされながら二人は出産アクメします。\n\n出産したアソコからへその緒を垂らす二人のお腹は大きいままで\nまだ中にいる！どうやら双子や三つ子を孕んでいたと判明し\n二人はまだまだ出産アクメが続くとゾクゾクしてます。\n\n産み切った二人はアソコからへその緒を複数垂らしながら\n連続出産アクメの余韻に浸って体をビクビクさせています。\n二人が産んだのは全員ゴブリン(♂)で父親ゴブリンは\nアリスは○匹、パチュリーは○匹産んだと結果を伝えながら\nすぐに次の子を孕ませるからなと楽しそうで\n二人は魔女である自分達が下賤なゴブリンの子を産んだとゾクゾク\n\n擬音や喘ぎ声、台詞ありで\n金額的に可能な範囲で出産前や出産中、出産後等の差分をお願いします。\n産まれたゴブリンの姿は見えても足ぐらいまでの描写で良く\n過去の影狼と椛の同時出産時の素材流用で構いません。\n\n以上、ご検討ください。", "nc": 161, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@sittomasuku/works/71", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/ceec300c/uploads/origins/fb7cb6fa-5119-43a6-8d2e-9832b9e9899e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=fb77452f95dd810a785d134c7da945c2", "src_set": ""}, "private": true, "genre": "art", "tipped": false, "creator_id": 679928, "client_id": 0, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 177, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@sittomasuku/works/70", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 679928, "client_id": 0, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/704939d7/uploads/origins/38f8515d-5163-46bd-8da8-ed111a12c6e7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0f754d890de7ac510369fdcb969d25d5", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/704939d7/uploads/origins/38f8515d-5163-46bd-8da8-ed111a12c6e7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0453f23a2aafd98f5e31410490b584e8", "src_set": ""}, "body": "【キャラ】\nパチュリー・ノーレッジ（東方Project）\n\n【服装】\n原作の帽子と服＋でっかいおっぱい丸出しでお願いします。\n\n【シチュ】\nベッド上でラブラブエッチ。\n\n【構図】\n松葉崩しの体位を横から見た感じ。\n以前投稿された「黒ギャルアリスとセックス（artworks/89939537）」を\n真横にした感じです。\n\n【その他】\nボテ腹でお願いします。", "nc": 176, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@sittomasuku/works/69", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/936f703b/uploads/origins/8afd6193-e570-4f18-8b06-db3fd2ec38bb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=e81ea218368b5ccba597c2a58014422f", "src_set": ""}, "private": true, "genre": "art", "tipped": false, "creator_id": 679928, "client_id": 0, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 163, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@sittomasuku/works/68", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 679928, "client_id": 2610969, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/9953643a/uploads/origins/ddc36f82-7398-4f84-a411-94c7a8caa33c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=342fb350da3256d0f8e7248ce9fe1cac", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/9953643a/uploads/origins/ddc36f82-7398-4f84-a411-94c7a8caa33c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b9e3fe2384b68c2a26c5982d21f4d368", "src_set": ""}, "body": "レミリアとさとり様に尻コキで搾り取られるショタ君をお願いします…。\n\n細かいシチュエーションやプロポーション等\n場所 紅魔館\nレミリア 巨尻 貧乳 低身長(原作イメージ)\nさとり 巨尻 爆乳 低身長(原作イメージ)\nショタ\n尻からちょっとはみ出るぐらいには巨根 レミリアとさとりよりは身長はちょっと低い\n\nセリフイメージ\nレミリア｢ほらほら…○○君の好きなお尻よ～｣\n\nさとり｢ああ…分かりますよ…おまんこに挿入れるのよりこっちが好きなんですね…しかもアナルに挿入れるんじゃなくて挟まれるなんて…クスクス…｣", "nc": 40, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@sittomasuku/works/67", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 679928, "client_id": 0, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/208ded57/uploads/origins/d756906c-695e-4783-87bf-bd0a40a7a919?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=314b11636fad0a34c607c1c77525fa2f", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/208ded57/uploads/origins/d756906c-695e-4783-87bf-bd0a40a7a919?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c91d5825cf774b9e183f2ab3ef918634", "src_set": ""}, "body": "【キャラ】\nルナチャイルド（東方Project）\n\n【服装】\n原作の帽子と服＋羽。\nおっぱいは丸出しでお願いします。\n\n【シチュ】\n爆乳でむっちりなおねーさんに変化したルナチャイルドが\n遊び相手の子と木陰でラブラブエッチ。\n\n【構図】\nでっかいおっぱいを強調していただければ、他はお任せします。", "nc": 176, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@sittomasuku/works/66", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 679928, "client_id": 462930, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/350e2380/uploads/origins/db14c6e8-d9c5-46be-8ce1-5800f083e8c5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4fa8cda3c9427e1bdc0e881adfecc19b", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/350e2380/uploads/origins/db14c6e8-d9c5-46be-8ce1-5800f083e8c5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c4a4f785290dc7cf56129696be36d82e", "src_set": ""}, "body": "また依頼します。\n\n過去に一度依頼した東方Projectの藍さまが\n発情期を迎えておじさんと交尾する絵をお願いします。\n竿役は過去依頼で藍さまを嫁にしたおじさんですが\n影狼や椛のことも嫁にしたおじさんでもあります。\n\n藍さまの過去依頼\nhttps://www.pixiv.net/artworks/103001006\n\n体位は以下のような男性主観の騎乗位で\n先日に納品いただいた影狼や椛と近しいアングルです。\n\nhttps://skeb.jp/@sittomasuku/works/50\n\nすっかりおじさんの嫁となった藍さまは\nおじさんのことを「ご主人様」と呼んでラブラブで\n自分も発情期が来たので影狼や椛だけでなく\n私にも種付けしてくれと汗だくで懇願中\n\n影狼や椛ばかり孕ませているおじさんに\n狐の半妖の子も可愛いぞとアピールしており\n次は藍さま似の可愛い女の子が欲しいと言うおじさんに\n藍さまは勿論産みますしご主人様似の男の子も産みますと\nたくさん子を産みますアピールが凄い藍さまは\n中出し絶頂後は影狼や椛が四つ子を産む気なら私は五つ子を産みます\nご主人様の子は私が一番産むのですからとゾクゾクです。\n\nといった内容を擬音や台詞ありで\n過去依頼と同程度の差分をお願いします。\nシチュ内容が影狼や椛のものとほぼ同じでありますが\n多産体質な三人が何人産むのか競い合ってると解釈ください。\n\n衣装はマイクロビキニとかエロ下着を着ており\n大きなおっぱい(乳首含む)や結合部が見えるようずらすか\nレイヤー表示で消せるようお願いします。\nマイクロビキニ等の色は黒や白等の単色系となり\n縞とか柄物といったデザインは避けてください。\n\n陰毛描写は有りでお願いします。\n\n以上、ご検討ください。", "nc": 48, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@sittomasuku/works/65", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 679928, "client_id": 0, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/ae703bae/uploads/origins/ebadaecb-c73d-4df5-9dbe-bb10f2b77f2e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8ff5be9539b782a6af5ffcf80ee7afea", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/ae703bae/uploads/origins/ebadaecb-c73d-4df5-9dbe-bb10f2b77f2e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3398a0319ee94e4afe8b128307c5d83c", "src_set": ""}, "body": "はじめまして、手数料無料期間との事なのでリクエストを送らせていただきます。\n\nキャラ：シュガードール・スカーレット（東方の二次創作キャラ）\n\nシチュ：自称・みんなのアイドル☆なシュガーちゃんがファンを名乗るおっさんに家に連れ込まれて、家に貼られた結界のせいで力を使えなくされて押し倒されて正常位の体位にされ、挿入される前は少し強がりながらメスガキムーブしながらなんとか逃げようと画策するもあっさりと処女を奪われて中出しされて涙目になりながらも何時間も犯され続け、最終的に完全に堕ちてアヘ顔になりながら「旦那さま（おっさん）だけのアイドル」になる事を誓う。\n\n服装は、上はまくった感じで、下は全部脱がされていて、シュガーちゃんの周囲に着けていたブラなどの下着など置いてください。\nまた、行為中の差分は中出しや事後の受精描写をお願いします。\n\nシュガーちゃんの設定に関してはこちらを⇒https://dic.pixiv.net/a/%E3%82%B7%E3%83%A5%E3%82%AC%E3%83%BC%E3%83%89%E3%83%BC%E3%83%AB%E3%83%BB%E3%82%B9%E3%82%AB%E3%83%BC%E3%83%AC%E3%83%83%E3%83%88\nシュガーちゃんの服装に関してはこちらを⇒https://x.com/lagoon9673/status/1796581213421134157\n参考にしてください。\n\nそれと、ファイル形式は可能でしたらjpgでお願いします。\n\n色々と細かくてすみません。どうかご検討のほどよろしくお願いします。", "nc": 184, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@sittomasuku/works/64", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 679928, "client_id": 0, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/6dcff918/uploads/origins/8580ae77-529a-4567-9c74-788788216d25?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7bbe8c6edaf6c28c26d7f818505d728b", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/6dcff918/uploads/origins/8580ae77-529a-4567-9c74-788788216d25?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d66e560871821bd05a73b82177b8c60c", "src_set": ""}, "body": "【キャラ】\n河城にとり（東方Project）\n\n【服装】\n原作の帽子＋白スク水＋濡れ透け\n\n【構図】\n正常位＋ずらし挿入中出し\n\n【シチュエーション】\n水辺でショタと相撲を取っていたら押し倒されてラブラブえっち", "nc": 168, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@sittomasuku/works/63", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 679928, "client_id": 462930, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/91555566/uploads/origins/53460e76-89bb-4774-926d-b0d6f1fa8214?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a9f25417fe27f9b7a7562883736181d7", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/91555566/uploads/origins/53460e76-89bb-4774-926d-b0d6f1fa8214?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0dbb5a211be1b0b8bc5b43ee1fd047b0", "src_set": ""}, "body": "手数料無料キャンペーン中なので追加で依頼します。\n\n過去に何度も依頼した東方Projectの犬走椛が\n再び発情期を迎えておじさんと交尾する絵をお願いします。\n竿役は過去依頼で椛や影狼を何度も孕ませてるおじさんです。\n\n体位は以下のような男性主観の騎乗位で\n他の影狼の依頼とアングルなどは近くでＯＫです\n\nhttps://skeb.jp/@sittomasuku/works/50\n\nすっかりおじさんの奥さんとなった椛は\nおじさんのことを「旦那様」と呼んでラブラブで\n自分にも発情期が来たので影狼さんだけでなく\n私にも種付けしてくださいと汗だくで懇願中\n\n前回依頼(非表示)で影狼と同じく椛も\nおじさん似の不細工な三つ子の男の子を産んだので\n次は椛似の可愛い女の子が欲しいと言うおじさんですが\n椛はおじさん似の不細工な男の子をまた産みたい模様\n中出し絶頂後は次の赤ちゃんは四つ子を産みますとか\n男の子も女の子も両方産みますと今回も多産を期待してゾクゾクです。\n\nといった内容を擬音や台詞ありで\n過去依頼と同程度の差分をお願いします。\nシチュ内容が影狼のものとほぼ同じとなっていますが\n影狼は女の子、椛は男の子を優先して産みたがっていると解釈ください。\n\n衣装はマイクロビキニとかエロ下着を着ており\n大きなおっぱい(乳首含む)や結合部が見えるようずらすか\nレイヤー表示で消せるようお願いします。\nマイクロビキニ等の色は黒や白等の単色系となり\n縞とか柄物といったデザインは避けてください。\n\n陰毛描写は有りでお願いします。\n\n以上、ご検討ください。", "nc": 56, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@sittomasuku/works/62", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 679928, "client_id": 462930, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/317cd359/uploads/origins/fef14057-df5d-4f8d-8322-9989223bffd5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5ddb358718ae069bd40266e1a1e8a250", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/317cd359/uploads/origins/fef14057-df5d-4f8d-8322-9989223bffd5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=bf3f36b788fe06dde7d7ccbbd3c9d382", "src_set": ""}, "body": "また手数料無料キャンペーンが来たので追加で依頼します。\n\n過去に何度も依頼した東方Projectの今泉影狼が\n再び発情期を迎えておじさんと交尾する絵をお願いします。\n竿役は過去依頼で影狼や椛を何度も孕ませてるおじさんです。\n\n体位は以下のような男性主観の騎乗位\n\nhttps://skeb.jp/@sittomasuku/works/50\n\nすっかりおじさんの奥さんとなった影狼は\nおじさんのことを「あなた」と呼んでラブラブで\nまた発情期が来たので種付けして汗だくで懇願中\n\n前回依頼(非表示のもみかげ出産絵)で影狼は\nおじさん似の不細工な三つ子の男の子を産んだので\n次は影狼似の可愛い女の子が欲しいと言うおじさんに影狼も同意しますが\nおじさん似の不細工な男の子を産むのも捨てがたいらしく\n中出し絶頂後は次の赤ちゃんは四つ子を産むわとか\n男の子も女の子も両方産むのぉと今回も多産を期待してゾクゾクです。\n\nといった内容を擬音や台詞ありで過去依頼と同程度の差分をお願いします。\n\n衣装はマイクロビキニとかエロ下着を着ており\n大きなおっぱい(乳首含む)や結合部が見えるようずらすか\nレイヤー表示で消せるようお願いします。\nマイクロビキニ等の色は黒や白等の単色系となり\n縞とか柄物といったデザインは避けてください。\n\n陰毛描写は有りでお願いします。\n\n以上、ご検討ください。", "nc": 169, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@sittomasuku/works/61", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 679928, "client_id": 462930, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/fb5b17d4/uploads/origins/4cb442f1-c814-4f67-881d-a66370cd58dc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a9dad053f3afc7c181b9f7b74510539c", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/fb5b17d4/uploads/origins/4cb442f1-c814-4f67-881d-a66370cd58dc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9cdf95cb57a73f2dc5c719126b637025", "src_set": ""}, "body": "また依頼します。\n\n過去依頼でレミリアの息子君(ゴブリン)の妻となった咲夜さんが\n妊娠して臨月を迎えて出産する様子をお願いします。\n\n咲夜さんの過去依頼\nhttps://skeb.jp/@sittomasuku/works/42\n\n巨乳でムチムチボテ腹姿な咲夜さんはベッドの上で股を開いて\n出産間近のため汗だくではぁはぁと息を荒らげています。\n\n画面内にはいませんが咲夜さんの出産には\nレミリアの息子君とその母親であるレミリアが立ち会い\n自分の息子と咲夜さんが夫婦関係だと知らなかったレミリアに\n咲夜さんはお坊ちゃまとの関係を黙っていたことを謝罪しつつも\nお嬢様の孫にあたる子を自分が産めるのは光栄ですと言い\nレミリアの息子君には元気な子を産みますと約束します。\n\nそして陣痛が始まりアソコから赤子が出てきますが\n開いたアソコから見える赤子の頭部は緑色で\n産まれる子がゴブリンだと伝えられた咲夜さんは\nレミリアの前で自分もゴブリンを出産することや\nお嬢様の血筋を自分が産んでいる状況に出産アクメします。\n\n出産後、ベッド上で股を開いたままの咲夜さんに\nレミリアは労いの言葉をかけながら赤子の容姿(※)を伝え\nレミリアの息子君は親父に負けないようたくさん子作りしようと言い\n咲夜さんは孕み妻としてのこれからを期待してゾクゾクしています。\n\n※出産したゴブリンの子にはレミリアと同じく蝙蝠のような羽が生えており\n　咲夜さんはレミリアの血筋(特徴)の子をちゃんと産めた模様\n\n擬音や喘ぎ声、台詞ありで\n金額的に可能な範囲で出産前や出産中、出産後等の差分をお願いします。\n\n以上、ご検討ください。", "nc": 176, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@sittomasuku/works/60", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 679928, "client_id": 200234, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/f3e4abb7/uploads/origins/f0d71a37-0a9e-4725-a24a-10f073c4d7d7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=270e7377151fb197bf3a8d29dae6b1a0", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/f3e4abb7/uploads/origins/f0d71a37-0a9e-4725-a24a-10f073c4d7d7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6e8d9c70fa6e9308430b11fbb9bcc80e", "src_set": ""}, "body": "初めまして！　せっかくの機会なので依頼をさせていただきます！\nキャラ　東方の名無しの本読み妖怪(朱鷺子)\nムチムチ爆乳の朱鷺子が「本で読んだけど気持ちいいのか試してみたい💓」\nと全裸正常位待機状態で誘惑\n巨根を挿入されて「奥ゴリゴリ届いてる」「馬鹿になるぅ」と快楽堕ちしている絵をお願いします\n可能でしたら、ボテ腹噴乳挿入状態で更にアヘっている差分をご検討下さい。", "nc": 161, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@sittomasuku/works/59", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 679928, "client_id": 0, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/ce44280e/uploads/origins/e9a061fa-dd03-447e-ac2e-5e8549ff8c26?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8a2907153c6177cf792657854d33cada", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/ce44280e/uploads/origins/e9a061fa-dd03-447e-ac2e-5e8549ff8c26?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f2adf7e46feee133acc96db4ed02ac93", "src_set": ""}, "body": "【キャラ】\n依神女苑（東方Project）\n依神紫苑（東方Project）\n\n【服装】\n原作のリボンや帽子＋局部丸