nscoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@sittomasuku/works/56", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 679928, "client_id": 0, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/45238ae7/uploads/origins/8a0832a4-2e8f-43fe-89cc-bb18665cf259?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f9f79e4a16f68d229093cfa72ff34fd5", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/45238ae7/uploads/origins/8a0832a4-2e8f-43fe-89cc-bb18665cf259?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9be6b7bc001a27cae0233f84b3cb6d85", "src_set": ""}, "body": "【キャラ】\n上白沢慧音（東方Project）\n\n【シチュエーション】\n寺子屋で教え子とエッチ\n\n【服装】\n原作服（通常版）。\n胸や局部は露出した状態でお願いします。\n\n【構図】\nでっかいおっぱいを強調していただければ他はお任せします。", "nc": 32, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@sittomasuku/works/55", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 679928, "client_id": 421820, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/d5efc957/uploads/origins/adc4f73c-9350-438d-ad3b-2b44610c3ead?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=836e4b9b00682fa4169cced10d6c264a", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/d5efc957/uploads/origins/adc4f73c-9350-438d-ad3b-2b44610c3ead?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=64100a6482a6bd8d0aebc30d4c8f4152", "src_set": ""}, "body": "嫉妬マスク様いつも作品楽しく拝見させていただいております 早速ですが依頼については下記を確認お願いします キャラ：フランドール・スカーレット シチュエーション ロリ巨乳な処女のフランちゃんが連れ込まれた小屋の布団で正常位で肥えたおっさんに犯されているイラストをお願いします 表情差分は最初は嫌がってる表情で処女を奪われ中出しされた後は涙目になっている感じで数時間後は完全に堕ちてアヘ顔に 服装は上はまくった感じでスカートは結合部が見える状態（描きづらいようでしたら全裸でも大丈夫です） 彼女の周囲に着けていたブラなどの下着など置いてください行為中の差分は中出しや事後の受精描写 それに加えて半紙に彼女のアソコから取った破瓜による血や体液などがついたまん拓をお願いします 取った拓は事後の彼女の横に置いてください  何卒よろしくお願いします", "nc": 160, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@sittomasuku/works/54", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/74033a46/uploads/origins/488cfd1a-1805-43ae-9134-5b3a47941fd7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=eae455e66d0ecb643296a8af9c7b06d1", "src_set": ""}, "private": true, "genre": "art", "tipped": true, "creator_id": 679928, "client_id": 0, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 176, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@sittomasuku/works/53", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 679928, "client_id": 462930, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/cbc49bf6/uploads/origins/b7e535cc-4286-4639-a055-8787f5cbc116?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=104c9c1b826ab29a1f79c9e025ef06df", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/cbc49bf6/uploads/origins/b7e535cc-4286-4639-a055-8787f5cbc116?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=72a89a75bc07533674ad1080dee478cc", "src_set": ""}, "body": "もう１件依頼します。\n今回も東方以外のキャラクターです。\n\n■キャラクター\n聖剣伝説3のリース\nhttps://www.jp.square-enix.com/seiken3_tom/character/\nhttps://dic.pixiv.net/a/%E3%83%AA%E3%83%BC%E3%82%B9%28%E8%81%96%E5%89%A3%E4%BC%9D%E8%AA%AC3%29\n\n■衣装\n胸と結合部が見えれば全裸でも半脱ぎでもＯＫ\n半脱ぎの場合はクラス１(緑色の基本服)をずらし挿入でお願いします。\n肩アーマー等の鎧パーツはパージしてＯＫ\n\n■シチュエーション\n前回のアンジェラの依頼の続き的な内容で\nアンジェラを犯した獣人のおじさんは、\n同じく牢屋にいたリースも犯して嫁にしてやると\nリースを男の部屋に連れ込んで犯すというシチュとなります。\n\n体位は前回のアンジェラと同じ体位で\n構図やアングルは近しいものでお願いします。\n\nベッドで獣人のおじさんに犯される寸前のリースは\nアンジェラさんはどこですか！等とキッとした表情で抵抗しますが\nこのベッドで処女を犯して俺の嫁になったよと教えられると\nリースも自分は処女でローラントの王女だから許してと懇願しますが\nお前も嫁にするとおじさんは二人目の王女様の処女マンコをいただきます。\n\n破瓜の血を流すリースは奥さんになんかなりませんと抵抗しますが\nアンジェラ同様、獣人おじさんチンポにすぐに堕ちてしまい\nおじさんはリースも攫って国に連れて帰り、嫁にして子を産ませると宣言し\nリースも中出しマーキングされて絶頂します。\n\nアンジェラに続き、おじさんの嫁にされたリースは\nセックスの快楽の前に旅の目的(祖国復興とか弟の捜索)を忘れてしまい\nアンジェラさんと一緒に王女マンコでおじさんの赤ちゃんを産みますと誓います。\n\nといった内容を擬音や台詞ありで\n過去依頼と同程度の差分をお願いします。\n\n以上、ご検討ください。", "nc": 41, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "similar_creators": [{"id": 33214, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "えるみや@skeb募集中", "screen_name": "Lrumiya", "avatar_url": "https://pbs.twimg.com/profile_images/1851899346717200384/HZgmskvE.jpg", "header_url": null, "appeal_receivable": true, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 10, "skills": [{"genre": "art"}, {"genre": "comic"}, {"genre": "video"}, {"genre": "correction"}], "nc": 32}, {"id": 38678, "creator": true, "nsfw_acceptable": false, "acceptable": false, "name": "🍄カクンテクン🔞", "screen_name": "kakuntekun", "avatar_url": "https://pbs.twimg.com/profile_images/1122722546690826240/7p4VoADq.png", "header_url": "https://pbs.twimg.com/profile_banners/1079913993219665921/1563985451/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "skills": [{"genre": "art"}], "nc": 160}, {"id": 47326, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "手負い@skeb募集中", "screen_name": "TEOI2", "avatar_url": "https://pbs.twimg.com/profile_images/852949573127491584/Z8h_o_P6.jpg", "header_url": "https://pbs.twimg.com/profile_banners/125024019