FnU2xCWiZ0eHRjbHI9ZmZmJnR4dGZvbnQ2ND1RWFpsYm1seUxVSnNZV05yJnR4dGFsaWduPWNlbnRlciZ0eHRzaXplPTgwJnR4dHNoYWQ9MTAmZm09cG5nJnc9MTIwMA&marky=415&txt64=5aSa5ZKM55Sw5Zyt5rWs&txtclr=fff&txtfont64=QXZlbmlyLUJsYWNr&txtfit=max&txtalign=middle%2Ccenter&txtsize=60&txtshad=10&auto=format%2Ccompress&fit=crop&crop=top&w=1200&h=630&s=4b0b5e1b30a2ee0296f215fe8014d209", "skills": [{"genre": "art", "default_amount": 5000}, {"genre": "comic", "default_amount": 10000}], "payment_methods": {"credit_cards": {"jcb": {"nsfw": true}, "master_card": {"nsfw": true}, "visa": {"nsfw": true}, "discover": {"nsfw": true}, "american_express": {"nsfw": true}}}, "acceptable_only_public": false, "tip_acceptable": true, "yearly_report_client_visible": false, "total_appeals_count": 2, "received_works": [{"path": "/@nonhuman_ok/works/8", "private_thumbnail_image_urls": null, "private": false, "genre": "comic", "tipped": true, "creator_id": 2663069, "client_id": 2437718, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/3d696fe4/uploads/origins/2c90503e-054e-460f-9f59-c01a154a17d5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ad7acd95ac2f39843b22537000ad7b30", "srcset": "https://si.imgix.net/3d696fe4/uploads/origins/2c90503e-054e-460f-9f59-c01a154a17d5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ad7acd95ac2f39843b22537000ad7b30, https://si.imgix.net/3d696fe4/uploads/origins/2c90503e-054e-460f-9f59-c01a154a17d5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a2abb1c7c98ed58ccbaec61edf2bfbed 2x, https://si.imgix.net/3d696fe4/uploads/origins/2c90503e-054e-460f-9f59-c01a154a17d5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=4b973bb1035ab9ddb760e09b03ae65fc 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/3d696fe4/uploads/origins/2c90503e-054e-460f-9f59-c01a154a17d5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=934355fe44d50fcddaea68266a90d19b", "srcset": "https://si.imgix.net/3d696fe4/uploads/origins/2c90503e-054e-460f-9f59-c01a154a17d5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=934355fe44d50fcddaea68266a90d19b, https://si.imgix.net/3d696fe4/uploads/origins/2c90503e-054e-460f-9f59-c01a154a17d5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=ef158ff6feb1453394eeaa47c47899fb 2x, https://si.imgix.net/3d696fe4/uploads/origins/2c90503e-054e-460f-9f59-c01a154a17d5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=d2d57809a00bc977f5fde1d4dc88b042 3x"}, "body": "お元気でしょうか？いつも素敵なイラストや漫画を見させていただけて感謝しています！\n\nいつも描いていただいている少年兵から垂れ目コンビの野田くんと箱崎くんが襲撃者に眠らされるお話を漫画をお願いします。\n\n表情の変化や身体の動きなどの人物描写、眠り倒れた姿は顔が見える全身像として、力を入れて描いてほしいです！\nまた話の展開に無理のあるところや描きやすくしたいところは遠慮せずアレンジしてどうぞ！\n\n僻地にある駐屯地のような場所で少年兵が当番制で周辺地域（森とか住人のいない廃れた町など自由に設定してどうぞ！）の夜警をしている設定。\n夜警では銃とランタン（他の手持ち光源でも良いです）を携帯している。\n\n野田くんと箱崎くんペア、坂井くんと米良くんペアが夜警当番になり（荒巻くんは非番）\n別々に担当のエリアに移動する。\n目的地に着いた2人のうち野田くんは哨戒に出向き、箱崎くんは見張りとして立っている。\n\nガンショルダーを肩に掛けランタンを片手に立ちっぱなしの箱崎くんは欠伸をして瞼が重くなったところを襲撃者に睡眠薬が染み込んだ布で背後から口と鼻を塞がれ、持っていたランタンを落として灯りが消える。\n一度は振り切ることができて距離を取ろうとしたが、暗闇のうえ薬の影響か足取りがふらつきつまづく。\n体勢が崩れてもなんとか応戦しようと銃を向けたが、発砲より早く襲撃者に銃を攻撃して手から離れる。\n襲撃者に突き飛ばされ仰向けに倒れたところを馬乗りにされ、また布を口と鼻に押さえつけられる。\n引き離そうとしたり足を地面について滑ったりしたなど抵抗を見せた末に、腕はパタンと落ち、左足底は地面についたまま右足は横に向いて、眠りに落ちた。\n\n哨戒から戻った野田くんは箱崎の姿が無く、割れたランタンがあることに気づき怪訝に思う。\nすると、すぐ近くで物音が聞こえ（襲撃者が仕掛けた誘き寄せの罠）、思わずビクッと反応する。\n野田くんは箱崎くんの名前を呼ぶが返事は無い。\n冷や汗が出て、ランタンと銃を構えながら恐る恐る物音がした方にゆっくり進む。\n確かめるとそこには何も無く、気のせいかと気が緩んだ直後に背後から睡眠薬が染み込んだ布で口を塞がれる。\n背後の襲撃者に蹴りか拳をくらわして拘束から逃れる。\nすぐに銃を構えて一発を襲撃者に撃ち込み討伐する。\n倒れた襲撃者に銃を構えたまま息を落ち着かせ冷静になろうとしたところを背後から衝撃（突き飛ばしや殴打など）を受けて体勢が崩れる。襲撃者は1人ではなかった。\nその衝撃で銃を落とし、慌てて拾う直前に再び背後から口と鼻に布で塞がれる。\n抵抗するもついに膝から崩れそのままうつ伏せに倒れる。涙目の顔は横を向き、地面に着いた頬は潰れていた。\n\n襲撃者の正体は下級の吸血獣だった。上級貴族からの報酬目当てに若い人間を攫う行為に及んでいた。\n2人の下級は味見したくなり眠らせた2人を抱き寄せその首に牙を突き立てようとした瞬間、駆けつけた坂井くんと米良くんの銃で討伐される。\n実は眠る前に野田くんと箱崎くんは危険を知らせる通知を味方に送っていたことで、近くにいた坂井くんと米良くんが指令を受けて現場に急行して助かった、というオチです。\n\n顔が可愛い2人がアクションを交えて必死に抵抗した末に無力化される場面を見たいという理由でリクエストしました！すみません！(大汗)\nご負担でなければぜひご検討のほどよろしくお願いします！", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@nonhuman_ok/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "comic", "tipped": true, "creator_id": 2663069, "client_id": 2437718, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/a896f3a4/uploads/origins/873ae091-9b28-4aaa-a21b-ea110bd80271?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=97f1b6ff42177b06981c9518f157d46c", "srcset": "https://si.imgix.net/a896f3a4/uploads/origins/873ae091-9b28-4aaa-a21b-ea110bd80271?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=97f1b6ff42177b06981c9518f157d46c, https://si.imgix.net/a896f3a4/uploads/origins/873ae091-9b28-4aaa-a21b-ea110bd80271?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=6c5a912cf160b465161a95e4822462c6 2x, https://si.imgix.net/a896f3a4/uploads/origins/873ae091-9b28-4aaa-a21b-ea110bd80271?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c949d6352b2530cfff727210587fdc91 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/a896f3a4/uploads/origins/873ae091-9b28-4aaa-a21b-ea110bd80271?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5589bda15be0d54dd6d5541e904f0172", "srcset": "https://si.imgix.net/a896f3a4/uploads/origins/873ae091-9b28-4aaa-a21b-ea110bd80271?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5589bda15be0d54dd6d5541e904f0172, https://si.imgix.net/a896f3a4/uploads/origins/873ae091-9b28-4aaa-a21b-ea110bd80271?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=46f797d41f60c2ebcb98359f6c70585d 2x, https://si.imgix.net/a896f3a4/uploads/origins/873ae091-9b28-4aaa-a21b-ea110bd80271?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=b8200b45c72ad0d95ae98fc76c56a8e9 3x"}, "body": "待ってました！！！！ぜひぜひよろしくお願いします〜！（リクエスト内容は同じです）\n前回も最高の吸血漫画を読ませてくださりありがとうございました！！！\n続きを読みたくなったので今度は坂井くん、米良くん、野田くん、箱崎くん、荒巻くんの5人が吸血鬼たちから生還するお話を描いてほしいです！\nちなみに時系列としては、\n「最初の吸血漫画→前作の鬼ごっこ→今回」という流れを一応考えています。\n\nざっくりとした話の流れは考えてきました。あくまで参考程度くらいで受け止めてください笑\n\n・少年兵たちが屋敷を脱出する\n（秘密裏に計画していた脱走作戦を実行）\n（またゲームが始まる前に体力を回復した頃合いと吸血生物がいなくなる機会を狙っていた）\n（基本的に鍵付きの部屋か牢屋に軟禁されている）\n\n・吸血鬼たちが脱出に気付き捜索する\n（主と会合する時間で全員出払っていた）\n（万が一脱走しても捕まえられる自信があった）\n\n・少年兵たちが窮地に陥る展開\n（吸血鬼に追い詰められる）\n（奪い返した武器で戦闘か、ひたすらに逃亡か）\n\n・少年兵たちが味方と合流して吸血生物たちから逃れる\n（吸血生物たちは撃退されるか退却する）\n（行方不明になった少年兵たちを捜索するチームか吸血生物の根城を落とすために組まれた部隊の登場）\n\n・おまけの後日談\n事実確認のためのインタビュー及び本人たちの精密検査やカウンセリングを受けたあとに医務室か病院のベッドで安静後に全員復帰する。\n\n（　）の部分は仮で思い浮かんだだけの内容なので全部を採用する必要もなければオリジナルの展開も大歓迎します！\n多和田圭浬さんが考えてくれたストーリーが1番読みたいのでぜひよろしくお願いします！！\n\n\nなおこの下はリクエスト内容の補完になるかなと妄想した少年兵と吸血鬼のこれまでの経緯です。温かい気持ちで見てください笑\n\n最初の吸血漫画にて、坂井くんたちが遭遇した吸血鬼 2人が去った後に、生きた人間を調達する吸血鬼が5人を回収して吸血鬼の棲家である屋敷に連れ去る。（または後日にまた襲われて拉致される？）\n\n目を覚ました少年兵たちは、武器を奪われたこと、自分たちがどこかの建物の部屋（大部屋か牢屋？）に軟禁されていること、自分たちをわざわざ回復させて吸血鬼の糧として生かされていることを知る。\n\nその後、動けるようになった少年兵たちを解放して吸血鬼たちの鬼ごっこが開催される展開に繋がる\n\n実は吸血鬼たちは、捕らえた少年兵たちの中からそれぞれお気に入りを選び、自分の召使い（悪く言えば奴隷）か愛玩動物のような存在として扱っていた。\n純粋な力勝負では敵わないことと大人しく従っている間は吸血してこないことから言う通りにする他なかった。\n\n少年兵が吸血鬼にやらされていたこと\n・日常の雑用全般\n・少年兵たち自身の食事、シャワー、洗濯の用意\n・吸血鬼が少年兵の反応を愉しむための行為\n\n吸血鬼の中には少年兵の心を折るために不安や恐怖心を煽る行為や屈辱的な行為を強要していた者もきたのかなと思ってしまいました。見る年齢を選ぶものとか…\n\n吸血鬼は少年兵たちを自分たちの糧として管理するために、それなりに栄養のある食事を食べさせたり、シャワーや衣類の洗濯も少年兵自身にやらせたりなど、清潔かつ健康であるようにしていた。\n\n少年兵たちの寝床は、ベッドが人数分ある広めの部屋か個室、又は牢屋を用意され、いる間は鍵を掛けられ軟禁されている。（攫われて目を覚ました場所と同じ）\n\n少年兵たちは、いつまた吸血されるか分からないので、吸血鬼に振り回されながら脱出するために情報収集や準備を悟られないよう進めていた。（吸血鬼側も人間がここから出られるわけがないと油断していた？）\n\nそして今回の脱出編に繋がる。\n（前回の漫画では、考えた作戦を実行する前に見つかってしまったが脱出の手掛かりを掴んでいたのでしょうか？）\n\n考えてるだけで楽しくなってきたので多和田にも共感してもらえるかな〜なんて思って書き残しました笑\n見ていただきありがとうございました！", "nc": 8, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@nonhuman_ok/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2663069, "client_id": 2437718, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/9bb91731/uploads/origins/c7c7ea6c-a630-4748-bf16-a358e6a04ad6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8c76cd065bdad02071fee5ed5777902f", "srcset": "https://si.imgix.net/9bb91731/uploads/origins/c7c7ea6c-a630-4748-bf16-a358e6a04ad6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8c76cd065bdad02071fee5ed5777902f, https://si.imgix.net/9bb91731/uploads/origins/c7c7ea6c-a630-4748-bf16-a358e6a04ad6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f80d76c3dffc0dd66023c63de657dcd2 2x, https://si.imgix.net/9bb91731/uploads/origins/c7c7ea6c-a630-4748-bf16-a358e6a04ad6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=0b6751343de508493dbe52349a03795a 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/9bb91731/uploads/origins/c7c7ea6c-a630-4748-bf16-a358e6a04ad6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=00434cb1e4ec88e4b832155322622ac1", "srcset": "https://si.imgix.net/9bb91731/uploads/origins/c7c7ea6c-a630-4748-bf16-a358e6a04ad6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=00434cb1e4ec88e4b832155322622ac1, https://si.imgix.net/9bb91731/uploads/origins/c7c7ea6c-a630-4748-bf16-a358e6a04ad6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=857abf3c61d480e38cc032966e1a2c20 2x, https://si.imgix.net/9bb91731/uploads/origins/c7c7ea6c-a630-4748-bf16-a358e6a04ad6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=055f7127a1c1ac1a747fe29e1fc4b39e 3x"}, "body": "お疲れ様です！お忙しい中失礼します。\n漫画で何回も描いていただいた創作少年兵\n坂井七斗　米良健　野田天真　箱崎崇　荒巻大地\nの集合イラストと5人それぞれの設定資料風イラストをカラーで描いてほしいです！\n\n集合イラスト\n・背景・場所については、漫画で描いてきた世界観か、少年兵の世界や雰囲気を感じられる風景にしてほしいです。\n・5人はお互い体が重ならない位置にいる。立っているか座っているかのポーズは、キャラクター性から「その子らしい」姿を描いてほしいです。\n・服装はいつも通りで大丈夫です。（夏服制服にゲートルやドッグタグの組み合わせ）\n・メイン武器（アサルトライフルなど）をそれぞれの持ち方で所持している。持ち方もキャラクター性から自由に決めて描いてください。\n（思いつき程度の例えばですが、両手で持つ、ガンスリングで肩にかけている・銃を背中に回してたすき掛けしている、片手で持ち銃口を上に向けているなど）\n\n設定資料風イラスト\n・イメージは「泥の星」則武くんと沖田くんのデータファイルのようなもの。\n・キャラの等身絵に、パーソナル設定や衣装の解説などをできる範囲で設定資料風にまとめてほしいです。\n・ワイシャツのキャラは、インナーのデザインも見せてください。シャツの中にインナーを着ないタイプなら無理に描く必要はありません。\n\nモノクロでも構いませんので、余裕があれば設定資料イラストに描いてほしいもの\n・キャラごとの様々な表情をまとめた設定画\n・米良くんの髪を後ろで結ってない顔と後ろ髪\n\nさらに、余裕があれば描いてほしいイラスト（数字が優先順位の高さ）\n1.少年兵の私服姿（カラー）\n2.ベッドの上に連れてこられ向かい合わせに座り込む野田くんと箱崎くんがアーサーとウィギンズに背後から吸血されている絵（モノクロ）\n\n例の如く多くてすみません！（考えていたら増えました大汗）\n「余裕があれば」は字面の通りですので、本命のカラーイラストだけでも仕上げていただければ十分です！\n多和田さんの創作キャラクター本当に大好きです！\nぜひご検討よろしくお願いします！", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@nonhuman_ok/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "comic", "tipped": true, "creator_id": 2663069, "client_id": 2437718, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/65311030/uploads/origins/f15c9d1c-6482-4260-808c-7e0944faebc3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=70b488bc3568b471cdc349ea7ce457a9", "srcset": "https://si.imgix.net/65311030/uploads/origins/f15c9d1c-6482-4260-808c-7e0944faebc3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=70b488bc3568b471cdc349ea7ce457a9, https://si.imgix.net/65311030/uploads/origins/f15c9d1c-6482-4260-808c-7e0944faebc3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=8c1b71f760b2ab5e1f26b45ab540e45e 2x, https://si.imgix.net/65311030/uploads/origins/f15c9d1c-6482-4260-808c-7e0944faebc3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=4985b8e2a049e978f256e0ca4fe68fba 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/65311030/uploads/origins/f15c9d1c-6482-4260-808c-7e0944faebc3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=83c3f003fb3056fd92e61bdc34b6c884", "srcset": "https://si.imgix.net/65311030/uploads/origins/f15c9d1c-6482-4260-808c-7e0944faebc3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=83c3f003fb3056fd92e61bdc34b6c884, https://si.imgix.net/65311030/uploads/origins/f15c9d1c-6482-4260-808c-7e0944faebc3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=ff2028afed15474a86eac40d7c3c8666 2x, https://si.imgix.net/65311030/uploads/origins/f15c9d1c-6482-4260-808c-7e0944faebc3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=728a5d00ef0e851a4e56896553097c9e 3x"}, "body": "原稿お疲れ様です！多和田さんの漫画とイラストを見るたびにいつも心踊る気持ちにさせてもらっています！リクエストの方でも沢山お世話になりました！\n\n前のリクエストで描いていただけた少年兵たちが今でもお気に入りで、シチュエーションも合わせて自分の好みにドンピシャでした笑\n\nなので同じようなネタばかりですみません！今度は坂井、米良、野田、箱崎、荒巻の5人が、それぞれ吸血鬼に吸血されている姿と、吸血後の倒れた姿を1人ずつ描いてほしいです。どの場面でも少年たちの顔がはっきり見えるな構図でお願いします。\n\n設定としては、生け取りにされた5人が吸血鬼たちの娯楽で、吸血鬼に捕まればそのまま吸血という鬼ごっこに巻き込まれるというお話。\n若い人間という貴重な主食であるから命までは取らないと言うが、捕まえた後に「つい」やりすぎることで不幸も起こるとか…な貴族の遊びをイメージしています。場所は洋館の中と庭、巨大な隠れ家のような世界。\n\n吸血は、飲みやすいようシャツやインナーを剥いで行います。\n吸血後は、倒れた少年1人ずつのボディ全体と、吸血の痕跡を見せつけるように描写し、顔も見えるように意識して描いてください。\n\n吸血のシチュエーションについては5人の内4人にはそれぞれ指定があります。\n・坂井\n首を掴まれて壁に投げ飛ばされた後、這いずって逃げようとするも背後から噛みつかれる。助かりたくて思わず手を伸ばしている。\n・米良\n吸血鬼に捕まり体を持ち上げられたまま運ばれ、大きなベッドの上に放り投げられる。そのまま体を押し倒されて噛みつかれる。苦悶の表情に歪んでいる。\n・野田\n吸血鬼 2人組が正面・背後から抱きついて左右片方ずつ噛まれる。2人同時に吸血されるショックからか上を向いて「あ…あ…」と涎がこぼれるくらい悶絶している。\n・箱崎\n後ろ向きに転んで正面から抱きしめられるようにして噛まれる。最初は引き離そうと吸血鬼の体を掴んでいた両手はストンと床に落ちて、目が霞むほど意識が朦朧としている。\n・荒巻\n多和田さんにお任せします！\n\n詰め込んだ内容になったかもしれませんが、ご検討よろしくお願いします！", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@nonhuman_ok/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2663069, "client_id": 2437718, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/e56df99d/uploads/origins/c3f8584a-332e-48bd-b36b-34f21e89ed1b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0ca4ee13e4567ae56320085c9ed9be11", "srcset": "https://si.imgix.net/e56df99d/uploads/origins/c3f8584a-332e-48bd-b36b-34f21e89ed1b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0ca4ee13e4567ae56320085c9ed9be11, https://si.imgix.net/e56df99d/uploads/origins/c3f8584a-332e-48bd-b36b-34f21e89ed1b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=0378aaa07348431f6ae5f1fcdb196177 2x, https://si.imgix.net/e56df99d/uploads/origins/c3f8584a-332e-48bd-b36b-34f21e89ed1b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a6ccd9712daad4556158938e11993c6d 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/e56df99d/uploads/origins/c3f8584a-332e-48bd-b36b-34f21e89ed1b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0af2b09a7dd78228c96dedb5cce8ba3e", "srcset": "https://si.imgix.net/e56df99d/uploads/origins/c3f8584a-332e-48bd-b36b-34f21e89ed1b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0af2b09a7dd78228c96dedb5cce8ba3e, https://si.imgix.net/e56df99d/uploads/origins/c3f8584a-332e-48bd-b36b-34f21e89ed1b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=75c3080ee47b859c2026b589d6b32967 2x, https://si.imgix.net/e56df99d/uploads/origins/c3f8584a-332e-48bd-b36b-34f21e89ed1b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=0700f003ba8bd0054559e56ef5d6fac5 3x"}, "body": "前回、前前回でも大変お世話になりました。\n\nおかげさまで前回描いていただいた吸血生物に襲撃される少年兵5人が大好きなくらいお気に入りになりました！\n\nリクエストですが、この5人が一部隊として泥の星の本編第1話〜第4話と同じくらいの時間軸（則武くんたちの少年兵時代と同じ世界）を生きる漫画を描いてほしいです！\n則武くんは沖田くんと出会ったことで大きく運命が変わりましたが、あの戦禍の中で5人がどう行動するのか、どんな運命が待っているのか、すごく見てみたいです！\n\n基本的には多和田さんの自由に描いてください！私が許しますので彼らを多少のひどい目に遭わせても大丈夫です！（5人「ちょっと？？？」）\n予想しながら待つのも醍醐味にするつもりでいますので、ご自身のペースで描きあげてください！\n\n（ちなみに予想という名の妄想を膨らませていますが、荒巻くんは脱落しそう（ごめん）で坂井くんと米良くんは捕虜になってから則武くんたちみたいに特別な学校に入れられそう…野田くんと箱崎くんはデッドオアアライブどっちにも転びそうでわからない…）\n\nそれからこちらは自分でも中々の無茶を言うと思っているのですが……もし余力があったらで構いませんので、全滅した世界線と、取り押さえられ捕虜になった世界線を、番外編のような形でイラストだけでもいいので描くこともお願いできるでしょうか？\n全滅なら、静かな狙撃によってか戦闘の末に果てるか。\n捕虜なら、取り押さえられている様子かマグショット\nをイメージしています。\n\n我儘すぎて申し訳ないのですが、無理のない範囲でご検討よろしくお願いします！！", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@nonhuman_ok/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2663069, "client_id": 2437718, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/325ffcd6/uploads/origins/9d127bc9-8a28-4c18-a08d-48ddd206a807?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ec941b1dc49130de65a878543d06fb73", "srcset": "https://si.imgix.net/325ffcd6/uploads/origins/9d127bc9-8a28-4c18-a08d-48ddd206a807?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ec941b1dc49130de65a878543d06fb73, https://si.imgix.net/325ffcd6/uploads/origins/9d127bc9-8a28-4c18-a08d-48ddd206a807?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=cb46aad662cc5a2a7167e6affc9a0817 2x, https://si.imgix.net/325ffcd6/uploads/origins/9d127bc9-8a28-4c18-a08d-48ddd206a807?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ef0a61859fa8fd14cd7745bf4f0dbdd6 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/325ffcd6/uploads/origins/9d127bc9-8a28-4c18-a08d-48ddd206a807?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=586f27417ab6f74edbf88ad1a2c530c5", "srcset": "https://si.imgix.net/325ffcd6/uploads/origins/9d127bc9-8a28-4c18-a08d-48ddd206a807?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=586f27417ab6f74edbf88ad1a2c530c5, https://si.imgix.net/325ffcd6/uploads/origins/9d127bc9-8a28-4c18-a08d-48ddd206a807?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=abfafecf3c52b5313cc4ede3350861bf 2x, https://si.imgix.net/325ffcd6/uploads/origins/9d127bc9-8a28-4c18-a08d-48ddd206a807?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=0445fd2ad5b03b07c67248ec281c3496 3x"}, "body": "リクエストですが泥の星に出てくるような学生服姿の少年兵達が吸血生物に襲撃される漫画を描いてほしいです。\n\n少年兵達のイメージデザイン\n・泥の星主人公達みたいに中学生くらいの年齢。\n・服装の上は白シャツかタンクトップだけなど自由に、下は黒の長ズボンにゲートルを履いている。\n・ドッグタグもつけている。\nなるべく沢山の少年兵達を登場させてほしいですが描いてほしい最低人数は3人（黒髪でキリッとした目の子、癖っ毛でそばかすのある子、短い後ろ髪を一本に結んでいる三白眼の子）を考えています。\n顔や見た目はあまり決めていないので自由に描いてください（丸投げして大変すみません大汗）\n\n吸血生物の設定\n人型（吸血鬼）でも獣型でも多和田さんがきにいるデザインにしてください。\n吸血行為のために野生動物も襲いますが人間にも被害が出るため討伐されるような存在。\n栄養不足な個体ほど見境なく襲ってくるし襲われた方は生存に関わるほどの血液量を持っていかれるケースもある。\n\nシチュエーション\n吸血生物の集団と戦闘することになった少年兵達。\nアサルトライフルで撃ち落とそうと果敢に応戦するも1人、また1人と吸血生物に捕まり噛まれたことで体が動かなくなり、最終的には全員無力化されてしまう。\n\n吸血生物の唾液には即効性の麻痺毒になっているため、噛まれた人間は体に力が入らなくなる（動けなくなる）、声も出しづらくなる、痙攣を起こすなどの影響がある。\n\n少年兵はまだ意識があるうちは涙を流しながら途切れとぎれに声を出そうとする。\n長い時間をかけてゆっくりと吸血されていきく恐怖と苦悶の表情に染まりながら貧血症状によって気絶するまで吸血される。\n\n最後に吸血生物が去った後、首元の吸血痕をはだけさらし意識のないまま倒れている少年兵達の描写をお願いします。\n\nちなみに全員生きていますし仲間に発見されてちゃんと助かります。\n\nこれでもう十分満足なのですが、さらにわがままを言ってもいいのなら少年兵達や吸血生物のキャラクターデザインもじっくり見てみたいです。\n\n癖全開なリクエストですが奇跡的にOKならよろしくお願いします！", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@nonhuman_ok/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2663069, "client_id": 2437718, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/945189aa/uploads/origins/ffaacfb1-b5e6-4589-ad1a-b54340944ae9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f5d1b1e274264d4376bcf0cc5d4585ff", "srcset": "https://si.imgix.net/945189aa/uploads/origins/ffaacfb1-b5e6-4589-ad1a-b54340944ae9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f5d1b1e274264d4376bcf0cc5d4585ff, https://si.imgix.net/945189aa/uploads/origins/ffaacfb1-b5e6-4589-ad1a-b54340944ae9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=32572478bbf7d6033e54a3f95e47a619 2x, https://si.imgix.net/945189aa/uploads/origins/ffaacfb1-b5e6-4589-ad1a-b54340944ae9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=2471aa65652dcd40013174476b3cd6ff 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/945189aa/uploads/origins/ffaacfb1-b5e6-4589-ad1a-b54340944ae9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6595633d5044e4058b158a7943c067b7", "srcset": "https://si.imgix.net/945189aa/uploads/origins/ffaacfb1-b5e6-4589-ad1a-b54340944ae9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6595633d5044e4058b158a7943c067b7, https://si.imgix.net/945189aa/uploads/origins/ffaacfb1-b5e6-4589-ad1a-b54340944ae9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=00ca8a549e312f19549e58274148c7bc 2x, https://si.imgix.net/945189aa/uploads/origins/ffaacfb1-b5e6-4589-ad1a-b54340944ae9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=dddf4092742d3904d079fa6d5186e8da 3x"}, "body": "多和田さんこんにちは！\n泥の星をはじめ多和田さんの描く沢山のイラストや漫画が大好きです！\n多和田さんがskebを始めた時からずっと気になっていましたが、この度やっっっっっと！！！！！！内容が固まってきたので依頼させていただきました！\n\n私からは暗殺者や忍者などのキャラクターがしている口元を隠す布を身につけた則武くんと沖田くんのイラストをお願いします！\n\nインナーは素顔を隠せるタートルネックと両手の指の第二関節くらいまで隠す指穴があるデザインです。\n全身は黒色を基調にした暗殺者風の身軽な武装衣装をイメージしています。\nふわっとしたイメージで申し訳ないのですが多和田さんがイメージする姿で大丈夫です！\n\nそんな衣装に身を包んだ則武くんと沖田くんで、以下四つの内容を描いてほしいです。\n\n1．武器を持った二人が自由に立っている姿（全身像）\n2．鼻まで覆った布に口元の影が浮かび上がっている2人の横顔\n３．木の枝の上で隣り合ってしゃがんでいる二人\n４．複数のナイフを同時に敵に投げつける場面\n\n描いてほしいところは全部伝えたつもりです。その他の細かい部分は多和田さんにお任せします。\n改めてどうぞよろしくお願いします！\n創作活動の方も応援しています！", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@nonhuman_ok/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2663069, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/6eedad2f/uploads/origins/6a9ff0ee-221c-45c0-952f-23e753053791?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2f3feaea25fbb4be582ea8eb8a383ed3", "srcset": "https://si.imgix.net/6eedad2f/uploads/origins/6a9ff0ee-221c-45c0-952f-23e753053791?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2f3feaea25fbb4be582ea8eb8a383ed3, https://si.imgix.net/6eedad2f/uploads/origins/6a9ff0ee-221c-45c0-952f-23e753053791?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=814f705f8842616099cf0de1dc289c4a 2x, https://si.imgix.net/6eedad2f/uploads/origins/6a9ff0ee-221c-45c0-952f-23e753053791?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=12ec5ce799c32b2d5d1340cdfc5ed64d 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/6eedad2f/uploads/origins/6a9ff0ee-221c-45c0-952f-23e753053791?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=24056343e0dd7e0a05d1a52d63b89edd", "srcset": "https://si.imgix.net/6eedad2f/uploads/origins/6a9ff0ee-221c-45c0-952f-23e753053791?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=24056343e0dd7e0a05d1a52d63b89edd, https://si.imgix.net/6eedad2f/uploads/origins/6a9ff0ee-221c-45c0-952f-23e753053791?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=d3f7800495a0e82eb6d7f07276684e61 2x, https://si.imgix.net/6eedad2f/uploads/origins/6a9ff0ee-221c-45c0-952f-23e753053791?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=2c655cba46ed98a74cfb54fd1315b9b5 3x"}, "body": "はじめまして。泥の星という素敵なお話を作ってくれてありがとうございます！少年兵の物語、大好きです！\n\n不都合なら遠慮せず断って構いませんので、泥の星1話で登場した海原君と山上君が敵に薬を嗅がされて眠らされる漫画風イラストをお願いしたいです。正直、理由が「2人のやられが性癖に刺さってちょっと可哀想なところが見たい。NG的に眠らされるだけならセーフかな？」という不純な動機から来てるのでマジでダメなら謝りますし無かったことにして忘れてください…(土下座)\n\n則武君達3人が一時的な拠点として滞在している夜の廃墟で交代しながら見張りをしていて、見張りをしていた海原君とその交代に来た山上君の2人が合流したタイミングで背後に迫ったモブ敵が背後から眠り薬が染み込んだ布を2人の口と鼻を押さえ込まれるという設定です。\n\n描いてほしいものは3つです。\n・海原君と山上君が敵の腕を引き離そうとくぐもった声で必死に抵抗する。\n・薬が回ってクラァと意識が遠のき呻き声も弱々しくなって意識が落ちる。\n・眠りに落とされた後、海原君は仰向け、山上君は地面にペタンと座り込んだ体勢でぐったりと力無く眠る。\n特に３つ目の眠る姿では2人の表情と頭から足先の全体まで見える描写にしてもらえると嬉しいです。\n\n余談ですがその後の敵は則武君も狙いますが返り討ちにされて様子を見に来た則武君に2人とも発見され起こされたと思ったらお説教を則武君から受けたとか受けなかったとか。\n\nこんな内容でリクしてしまって申し訳ないですが本当に大丈夫だったらでいいのでご検討の方よろしくお願いします。\n多和田さんが描きたいものを描くことが一番大事ですので、ご自身のお気持ちを何よりも尊重してください！\n今後も泥の星を応援しております！！", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 389927, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "タクヘイ/拓平", "screen_name": "Takuhe_tarabox", "avatar_url": "https://pbs.twimg.com/profile_images/2073086634346811393/b32ry-z1.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1224703731448590344/1783097257/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 90, "skills": [{"genre": "art"}], "banned": false, "nc": 144}, {"id": 969592, "creator": true, "nsfw_acceptable": false, "acceptable": false, "name": "クレ", "screen_name": "KURE9000", "avatar_url": "https://pbs.twimg.com/profile_images/1555578408964587520/JTwhiVLm.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1251531826545324034/1638434330/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_re