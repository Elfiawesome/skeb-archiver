734-44220f055894?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=311d410997cbac1145b99196f1833076, https://si.imgix.net/f79aecae/uploads/origins/73fa69ab-2ab9-4efe-b734-44220f055894?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=0b024f80c56667eceb5cd71e679adb82 2x, https://si.imgix.net/f79aecae/uploads/origins/73fa69ab-2ab9-4efe-b734-44220f055894?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=72cef72686d752533ceb93be0274ab25 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/f79aecae/uploads/origins/73fa69ab-2ab9-4efe-b734-44220f055894?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5cfa7b5ae68e7bfbde5c1d1e2d363900", "srcset": "https://si.imgix.net/f79aecae/uploads/origins/73fa69ab-2ab9-4efe-b734-44220f055894?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5cfa7b5ae68e7bfbde5c1d1e2d363900, https://si.imgix.net/f79aecae/uploads/origins/73fa69ab-2ab9-4efe-b734-44220f055894?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=594ee79f0682cc45f049b7eebbe100b0 2x, https://si.imgix.net/f79aecae/uploads/origins/73fa69ab-2ab9-4efe-b734-44220f055894?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=b7170e9fe3b79fdcfa08ef6ea031e6cf 3x"}, "body": "リクエスト失礼します。金額に問題なければ差分含め3枚お願いします。\n\nリクエストしたいのはチャイナドレスを着た御形アリシアナ。\n\nチャイナドレスはチュウニパラダイスロストに出てきたリー・メイメイのチャイナドレス。\n黄色がメインな衣装ですがもし出来たらメインの色を黒に変えたチャイナドレスという感じでお願いしたいです。\n髪型はロングヘアのまま、髪飾りはいつも付けているリボンの髪飾りの黒という感じでお願いします。\nポーズはゲームで見かける片足立ちしながら両手を広げている状態のもの。\n\nメンバー達でコスプレをしていたら衣装サイズが合わなかったのか胸元の留め具が外れて胸が露出してしまった。みたいなイメージで以下の基本絵と差分をお願いします。\n\n1）キリッとした表情でポーズを決めて立っている。\n2）ポーズはそのまま、胸元の留め具が外れブラを付けていなかったので胸が丸出しになっている状態。表情は恥ずかしさで赤面している感じ。\n3）足はそのまま悲鳴を上げながら慌てて片手か両手で胸を隠そうとしている状態。\n\n注文が多いとは思いますが、ご検討のほどよろしくお願いします。\n\n\n衣装参考画像\nhttps://dl.easyuploader.cloud/20220