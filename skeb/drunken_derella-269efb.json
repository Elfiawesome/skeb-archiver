ょっと大きめ\n夢主の衣装はそのままでもアレンジしても大丈夫です\n\n一郎が落ち込んでいた夢主の頭を撫でて慰めてる絵をお願いします。\nイラストは資料画像の２枚目の範囲でお願いします（全体描かなくてもOK）\n背景は白背景とかで大丈夫です。\n\n一郎がやさしく微笑んだ表情で夢主を右手で頭を撫でているポーズで、\n夢主がちょっと悲しみながら照れた顔で、両腕を胸のあたりまで上げているポーズ\n\n使用用途はなりきりアカのアイコン＆ヘッダーに使用します\nよろしくお願いします\n\nhttps://x.com/sinsochaos/status/1768994209623662801?s=20", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@drunken_derella/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1979007, "client_id": 3090887, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/a8a9d919/uploads/origins/8aea83c9-a0fe-425d-802c-a86b59884eef?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7c0f496ec52ad26c853093065fd26c92", "srcset": "https://si.imgix.net/a8a9d919/uploads/origins/8aea83c9-a0fe-425d-802c-a86b59884eef?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7c0f496ec52ad26c853093065fd26c92, https://si.imgix.net/a8a9d919/uploads/origins/8aea83c9-a0fe-425d-802c-a86b59884eef?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=bbeaed2ef9ed40beba6ea1a585989b6f 2x, https://si.imgix.net/a8a9d919/uploads/origins/8aea83c9-a0fe-425d-802c-a86b59884eef?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=31feed46ea91d2589ef397be52a64672 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/a8a9d919/uploads/origins/8aea83c9-a0fe-425d-802c-a86b59884eef?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=fab0ff4a39e41b54625dc934ecafd018", "srcset": "https://si.imgix.net/a8a9d919/uploads/origins/8aea83c9-a0fe-425d-802c-a86b59884eef?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=fab0ff4a39e41b54625dc934ecafd018, https://si.imgix.net/a8a9d919/uploads/origins/8aea83c9-a0fe-425d-802c-a86b59884eef?bg=%23