ァイア」（炎の外側はオレンジ色ですが、内側は黒色）を操る力を持つデーモンウルフです！彼は、観客を楽しませるために、地獄のようなコロシアムでモンスターを倒すスリルを味わう、戦闘マニアです。 彼は傲慢で、鋭い牙をむき出しにして常にニヤニヤと笑い、黒い爪を誇示するのが好きです。その地獄のような体は、活火山のようなものです。\n\nhttps://drive.google.com/drive/folders/1rszG6ZXV-nVmzht7I2ScQ4NByZuR4N-_?usp=sharing", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@_mitoku/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3799266, "client_id": 3994881, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/92c71c42/uploads/origins/0b9e15d3-955e-45d4-9d08-ed830c7dc959?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4b4339d24217072a7877c333c62740ec", "srcset": "https://si.imgix.net/92c71c42/uploads/origins/0b9e15d3-955e-45d4-9d08-ed830c7dc959?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4b4339d24217072a7877c333c62740ec, https://si.imgix.net/92c71c42/uploads/origins/0b9e15d3-955e-45d4-9d08-ed830c7dc959?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a89db1c01a5fef9042fe15eea594bc43 2x, https://si.imgix.net/92c71c42/uploads/origins/0b9e15d3-955e-45d4-9d08-ed830c7dc959?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=7e9586b81ac0ddd53c592a014937a3cf 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/92c71c42/uploads/origins/0b9e15d3-955e-45d4-9d08-ed830c7dc959?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=804448ab954e667686bc6cff5d7afa66", "srcset": "https://si.imgix.net/92c71c42/uploads/origins/0b9e15d3-955e-45d4-9d08-ed830c7dc959?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=804448ab954e667686bc6cff5d7afa66, https://si.imgix.net/92c71c42/uploads/origins/0b9e15d3-955e-45d4-9d08-ed830c7dc959?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&