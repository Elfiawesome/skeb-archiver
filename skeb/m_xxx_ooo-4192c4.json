クターの詳細】\n・女性\n・20歳/146cm/水色目/名前はめゆ\n・好きな食べ物はソーダ味のグミ/クリームソーダ/和菓子\n\n〜なのよ・〜よね・〜のね・〜なのね……という話し方をする。一人称が自分の名前。\nかわいいと思っている動物はひつじさん。\n\n和菓子は好きだが、抹茶は好きというわけではないらしい。\n\n\n【構図など】\n特に構図に指定はないのでお任せしたいです！（どんなものでも嬉しくなってしまいます！）\n\n\n以上です。\n服など省略、お好きなように変更していただいて構いません。\nご縁がありましたらよろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/1X8HLgxfWtbiNGHb4oB89uaqhpaerrjSx", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Ko_0070/works/14", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3783187, "client_id": 3782997, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/eb977064/uploads/origins/ec49ed23-c616-4989-a865-3651811e1cc0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=64f0e748c7ceffa2245d5cbeec62997c", "srcset": "https://si.imgix.net/eb977064/uploads/origins/ec49ed23-c616-4989-a865-3651811e1cc0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=64f0e748c7ceffa2245d5cbeec62997c, https://si.imgix.net/eb977064/uploads/origins/ec49ed23-c616-4989-a865-3651811e1cc0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=be4aba5d8f76cd471774f3763211e8e3 2x, https://si.imgix.net/eb977064/uploads/origins/ec49ed23-c616-4989-a865-3651811e1cc0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d4fe1aee9122f4f217710d1191273bb5 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/eb977064/uploads/origins/ec49ed23-c616-4989-a865-3651811e1cc0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=1162b9bf79cc7062ee3464a1dac3c823", "srcset": "https://si.imgix.net/eb977064/uploads/origins/ec49ed23-c616-4989-a865-3651811e1cc0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=1162b9bf79cc7062ee3464a1dac3c823, https://si.imgix.net/eb977064/uploads/ori