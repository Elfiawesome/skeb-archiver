6-427e-9054-2af4c204e582?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=5d4e93469400cd78d1dfe44d686e28ad 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/f8014e2a/uploads/origins/5abd1ce1-2d86-427e-9054-2af4c204e582?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=07e7754499cff60f6a4d6f399ea50e62", "srcset": "https://si.imgix.net/f8014e2a/uploads/origins/5abd1ce1-2d86-427e-9054-2af4c204e582?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=07e7754499cff60f6a4d6f399ea50e62, https://si.imgix.net/f8014e2a/uploads/origins/5abd1ce1-2d86-427e-9054-2af4c204e582?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=464d69c3760dc3507d339e265d7dc08a 2x, https://si.imgix.net/f8014e2a/uploads/origins/5abd1ce1-2d86-427e-9054-2af4c204e582?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=b0015bfe465d9d82482b73a3c982ca89 3x"}, "body": "こんにちばんは、某所ではお世話になっております。\n今回は私が擦り倒しているTRPGの自PCをお願いしたくご依頼を投げさせていただきます。\n\n・添付しているドライブに格納している資料からご自由に解釈していただいて、お好きなようにイラストを描いていただければと思います。\n・黒宮さんの解釈が見たいのでもうほんとお好きなように書いていただければと思うのですが欲を言うと黒宮さんの絵柄でこのPCが髪を下ろした姿が見たいです。\n・画像サイズ、解像度、カラーモノクロ、ファイル形式などはお任せします。\n\n一応軽い性格と好みだけこちらに書かせていただきます。が、無視してもつまみ食いしてもご自由に解釈していただければと思います。\n・善・秩序の根っからのお人よし、頭はいいはずなのだがどんくさいところがある。一言でいうならサモエド。あの胡散臭い恰好は仕事用のもの。\n・好きな食べ物はあんまん。小豆餡が使われているものは大体好き。\n\nどうぞよろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/1bRBSymwKnvmQE1PsgvclUHL0n8Plofx0?usp=drive_link", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@kasuga_kaeru/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3381061, "client_id": 3015798, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/bccc6981/uploads/origins/43e69ed7-c041-4b8f-8b2f-dbc44104709c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0d64685fb22c38a616e34ca90b00e0b8", "srcset": "https://si.imgix.net/bccc6981/uploads/origins/43e69ed7-c041-4b8f-8b2f-dbc44104709c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0d64685fb22c38a616e34ca90b00e0b8, https://si.imgix.net/bccc6981/uploads/origins/43e69ed7-c041-4b8f-8b2f-dbc44104709c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=7c2b563611107df4f51e3f08e8a26f79 2x, https://si.imgix.net/bccc6981/uploads/origins/43e69ed7-c041-4b8f-8b2f-dbc44104709c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=4026e48602cfedcbb341594c163ebd3a 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/bccc6981/uploads/origins/43e69ed7-c041-4b8f-8b2f-dbc44104709c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=651ea0cf023617f2d0fe20fca7bfdfcf", "srcset": "https://si.imgix.net/bccc6981/uploads/origins/43e69ed7-c041-4b8f-8b2f-dbc44104709c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=651ea0cf023617f2d0fe20fca7bfdfcf, https://si.imgix.net/bccc6981/uploads/origins/43e69ed7-c041-4b8f-8b2f-dbc44104709c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=87cb243a126304dd9112d0fce4bbd671 2x, https://si.imgix.net/bccc6981/uploads/origins/43e69ed7-c041-4b8f-8b2f-dbc44104709c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=beec4accf98e96a27f2cbc59b077d55b 3x"}, "body": "おはようございます、お疲れ様です。再々リクエストとなりますが窓口が開き続けて受付されている限り、延々と送り続ける気概ですのでどうぞよろしくお願いいたします。これで弾かれたら笑ってください。\n君が窓口を開いていて納品されるまでリクエストを送り続けるのをやめないっ！！！\n\nこんな者ですがよければ引き続きどうぞよろしくお願いいたします。\n一応今までのリクエスト文も下記に添付しておきます。\n\n\nこんばんは、以前春日かえるさんに描いていただいた自PCがお気に入りでして、また描いていただければと思いご依頼させていただきます！\n\n依頼内容\n・添付する資料の自PCを描いていただきたいです。いくつか差分もありますがお好きなものを選んでいただければと思います。\n・服や装飾は自PCだと分かればある程度省略していただいても構いません。\n・糸目はなるべくそのままでお願いいたします。開眼する場合は差分としてつけてもらえるとありがたいです。\n・構図・キャンバスサイズ・背景の有無などもお任せします。\n・シリアスからギャグまで何でもいける子ですが、以前描いていただいたイラストの胡散臭い雰囲気が大好きなのでその方向性だと私が踊りだします。こんな見た目ですが職業占い師の一般人です。\n\nこのような感じで大丈夫であればお引き受けいただけると幸いです。\nどうぞよろしくお願いいたします！\n\nhttps://drive.google.com/drive/folders/1bRBSymwKnvmQE1PsgvclUHL0n8Plofx0?usp=drive_link", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@NSan0tksousk/works/11", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 618330, "client_id": 3015798, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/eeb7ee47/uploads/origins/21e7f3e5-254b-462d-858e-333330cf5418?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=541114e4ee86b502328b585d1954a6a6", "srcset": "https://si.imgix.net/eeb7ee47/uploads/origins/21e7f3e5-254b-462d-858e-333330cf5418?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=541114e4ee86b502328b585d1954a6a6, https://si.imgix.net/eeb7ee47/uploads/origins/21e7f3e5-254b-462d-858e-333330cf5418?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=efadc727107ed4b8c9ba3abc64b3a244 2x, https://si.imgix.net/eeb7ee47/uploads/origins/21e7f3e5-254b-462d-858e-333330cf5418?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e922fcaf2809e6485f4f449c8aca85ea 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/eeb7ee47/uploads/origins/21e7f3e5-254b-462d-858e-333330cf5418?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9b2053606830de365a7dfdf1157abab5", "srcset": "https://si.imgix.net/eeb7ee47/uploads/origins/21e7f3e5-254b-462d-858e-333330cf5418?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9b2053606830de365a7dfdf1157abab5, https://si.imgix.net/eeb7ee47/uploads/origins/21e7f3e5-254b-462d-858e-33