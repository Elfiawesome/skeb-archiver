44daba1-f2f6-43f3-885b-db823a8d06e4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=74ce0b60d6162dc2d0723bb23dc2a419 3x"}, "body": "こんにちは！\nくじょ様の描かれるキャラクターたちの、圧倒的な顔の良さに悶絶する毎日です。特に目周辺が最高です。\nぜひ、一番好きなくじょ様のオリジナルキャラクターと、うちの子を描いて欲しいと思い、リクエストさせていただくことに致しました。\n\n【依頼内容】\nうちの子であるオリジナルキャラクター『椿折未明』と、くじょ様の『暁烏青』さんが一緒にいるイラストをお願いします。\n2人とも夏服(未明はショウさんコーデの夏服)で、『暁烏青』さんは白椿の髪飾りが見える構図だと嬉しいです。\nその他は全てお任せします。\n\nまた、『暁烏青』さん(特に横顔)が本当に本当に大好きなので、顔アップの画像があると嬉しいです。(なくても大丈夫です)\n\n【使用用途】\n自分用にネットプリントで印刷\n自分用グッズ(アクスタ、アクキーなど)など\n個人観賞用\n\nご検討のほど、よろしくお願いします。", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@beniudon666/works/10", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2075026, "client_id": 11456, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/9862b0f2/uploads/origins/fd477e39-8253-4d2e-b222-b3813dcb1d8e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4a3e9f8ef481ca2b7d56590b4db2bbd4", "srcset": "https://si.imgix.net/9862b0f2/uploads/origins/fd477e39-8253-4d2e-b222-b3813dcb1d8e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4a3e9f8ef481ca2b7d56590b4db2bbd4, https://si.imgix.net/9862b0f2/uploads/origins/fd477e39-8253-4d2e-b222-b3813dcb1d8e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=186eaef7e5eb35786f43dd1b66b7552d 2x, https://si.imgix.net/9862b0f2/uploads/origins/fd477e39-8253-4d2e-b222-b3813dcb1d8e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=86a521ebc3c4b85c38434a81198c7411 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/9862b0f2/uploads/origins/fd477e39-8253-4d2e-b222-b3813dcb1d8e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=49991a14e2f47a4516a71ef1dbcd5481", "srcset": "https://si.imgix.net/9862b0f2/uploads/origins/fd477e39-8253-4d2e-b222-b3813dcb1d8e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=49991a14e2f47a4516a71ef1dbcd5481, https://si.imgix.net/9862b0f2/uploads/origins/fd477e39-8253-4d2e-b222-b3813dcb1d8e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=d984a33d195029da3a843914d5fe98f9 2x, https://si.imgix.net/9862b0f2/uploads/origins/fd477e39-8253-4d2e-b222-b3813dcb1d8e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=d8a1bc87ed08e9c6ce916486ed743356 3x"}, "body": "バニーベル。と申します。\n前回のリクエストを受け付けていただき、ありがとうございます。\n今回二度目のリクエストになります。よろしくお願いします。\n\n\n◆依頼内容\nオリジナルキャラの『おぢさん』を描いていただきたいです。\n\n参考\nhttps://drive.google.com/file/d/1sgn6S7uZcjr5P2p_O6qcQ6IINCQZ47AM/view?usp=sharing\n\n・キャラデザをしてくださった方から、依頼＆画像使用許可は得ています。\n・服装は下段一番右のスーツ姿に近い感じでお願いします。アクセサリー含め、アレンジして頂いてOKです。\n・金色のコインを使って賭け事をしている様子を描いてほしいです。胡散臭さ全開でお願いします。\n・その他詳細はお任せします。\n\n\n◆使用用途\n・『ぽれん』というPvPゲームで使用したいと考えています。\n　512x384か、その倍数のサイズでお願いします。\n\n前回開催時の公式サイト\nhttps://andymente.moo.jp/html/game/phelen/phelen15/phelen15.htm\n\n\n◆おぢさん情報\n・年齢46歳、身長188cm、本名は内緒。喫煙者。\n・職業不詳、住所不定。賭け事弱い。悪運強い。\n・おじさん構文の使い手。\n・イメージカラーは紫。キーアイテムは赤い薔薇。\n\n\nご検討のほど、よろしくお願いします。", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@beniudon666/works/9", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2075026, "client_id": 11456, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/d34982bd/uploads/origins/6eaf2347-1904-424c-a805-9636f3731afa?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d98f2ad04de5778e11f839f9870482c3", "srcset": "https://si.imgix.net/d34982bd/uploads/origins/6eaf2347-1904-424c-a805-9636f3731afa?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d98f2ad04de5778e11f839f9870482c3, https://si.imgix.net/d34982bd/uploads/origins/6eaf2347-1904-424c-