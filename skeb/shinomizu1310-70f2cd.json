_visible": false, "total_appeals_count": 0, "received_works": [{"path": "/@shinomizu1310/works/11", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 505017, "client_id": 2038809, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/aa77bda8/uploads/origins/f46f7fd6-4db3-4db3-9c98-17057826339c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6d99f47249c1e82dda5240cb2ee04555", "srcset": "https://si.imgix.net/aa77bda8/uploads/origins/f46f7fd6-4db3-4db3-9c98-17057826339c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6d99f47249c1e82dda5240cb2ee04555, https://si.imgix.net/aa77bda8/uploads/origins/f46f7fd6-4db3-4db3-9c98-17057826339c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=73d9ded54698b94309dafb653b6e4773 2x, https://si.imgix.net/aa77bda8/uploads/origins/f46f7fd6-4db3-4db3-9c98-17057826339c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=4f9884c31d1ae0f899917ec389a7a475 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/aa77bda8/uploads/origins/f46f7fd6-4db3-4db3-9c98-17057826339c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=60904b6f371f1fdf86c9e423936ddf4b", "srcset": "https://si.imgix.net/aa77bda8/uploads/origins/f46f7fd6-4db3-4db3-9c98-17057826339c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=60904b6f371f1fdf86c9e423936ddf4b, https://si.imgix.net/aa77bda8/uploads/origins/f46f7fd6-4db3-4db3-9c98-17057826339c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=dad472a0b9f456fdabc1cc1e96561ca3 2x, https://si.imgix.net/aa77bda8/uploads/origins/f46f7fd6-4db3-4db3-9c98-17057826339c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=7c3ba27d92544de95328299cad8e102b 3x"}, "body": "こんばんは。\n先日は内容的に重めのリクを送ってしまい、申し訳ありませんでした。その上でまた恐縮ではありますが、別途依頼させて頂ければと思っております。\n\nこの度、自分の拙文に用いる挿絵を描いて頂きたいと考えております。もしご都合よろしければ、資料URLの内容に沿った絵を描いて頂けませんでしょうか？\n具体的には、以下の絵をお願いしたく存じます。\n\n①\nプラスチックの食器やお人形を囲みながら、おままごとをするユイカとハルト。ユイカはおもちゃのフライパンでスパゲッティの具材か何かを炒める素振り。\n②\nユイカがハルトにやり手水してもらいながら、洋式トイレにおしっこしている様子。アングルは斜め前から。\nもし床まで入れられるなら、下に置かれたユイカの桃色のパンツまで描いて頂ければ。\n③\nテレビを観ながらも、便意でやや曇った顔のユイカ。ハルトの言葉を聞き、自分がおもらししてしまった場合の様子や、そうなった自分を観たアニメのキャラの表情等を吹き出しで思い浮かべている。手元には、①でも描かれたお人形がある。\n④\nユイカがハルトにやり手水してもらいながら、洋式トイレにうんちしている様子。アングルは②からやや変えて、正面から。お尻からやや暗い茶色のうんちの尻尾が伸びている。\nもし便器の中まで入れられるなら、水面に浮かんだうんちの欠片も描いて頂ければ。\n⑤\n便器のそばの床に落ちたうんちの欠片を観て、ギャグ調にショックを受けているユイカの様子。\n⑥（※これは余裕があれば）\nこちらを見上げるように満面の笑顔を浮かべているユイカの一枚絵。口を開け、目の前の相手（ハルト）に話しかけているのが分かるようにする（物語ラストのイメージ）。\n\n①、③、⑥については背景は無しでも構いません。\nまた、ユイカのデザインについては、下記URLを参照して下さい。\nhttps://drive.google.com/file/d/1YW5-hZnO3VbR9yPUIjyl7wk1tY5QfCCo/view?usp=drive_link\n\n重ねてですが、もしキャパオーバーや他の方との兼ね合いがあるようでしたら、キャンセル頂いて構いません。また、金額に問題があれば、再送して下さい。\n何卒よろしくお願いします。\n\nhttps://www.alphapolis.co.jp/novel/183157373/933599058/episode/10184409", "nc": 176, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@shinomizu1310/works/10", "private_thumbnail_image_urls": null, "private": false, "genre": "comic", "tipped": true, "creator_id": 505017, "client_id": 56548, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/b6fbbda1/uploads/origins/58372514-9120-499f-86bf-fffb5b108fc9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c848d91c045718bea610e0a7b7b7a4a7", "srcset": "https://si.imgix.net/b6fbbda1/uploads/origins/58372514-9120-499f-86bf-fffb5b108fc9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c848d91c045718bea610e0a7b7b7a4a7, https://si.imgix.net/b6fbbda1/uploads/origins/58372514-9120-499f-86bf-fffb5b108fc9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=884874c5f281a204b3f7f5f7bf2d43f8 2x, https://si.imgix.net/b6fbbda1/uploads/origins/58372514-9120-499f-86bf-fffb5b108fc9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=4f224cd6d19797db78b3c5d71f875e47 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/b6fbbda1/uploads/origins/58372514-9120-499f-86bf-fffb5b108fc9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ca391a260947943649b890b13101f165", "srcset": "https://si.imgix.net/b6fbbda1/uploads/origins/58372514-9120-499f-86bf-fffb5b108fc9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ca391a260947943649b890b13101f165, https://si.imgix.net/b6fbbda1/uploads/origins/58372514-9120-499f-86bf-fffb5b108fc9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=777d5cd0decf1c3ca03990e1d986f727 2x, https://si.imgix.net/b6fbbda1/uploads/origins/58372514-9120-499f-86bf-fffb5b108fc9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=1ec09e4d35db5242a54e8755297c8be9 3x"}, "body": "前回のリクエストの続編として、再びブレアをリクエストしたい。\n\nブレアはまだパンティにウンチをいっぱいにしたまま学校のホールを歩いている。彼女はお腹を押さえ、パンティーの中にさらにウンチをして、ウンチの膨らみをさらに大きくする。(数人の生徒が見ている中）。\nすると生徒が彼女を押し倒し、尻餅をつかせてウンチをつぶし、床をぐちゃぐちゃにする。ブレアは反撃することもなく、ただ泣くだけで、周りの生徒たちは呆れたり笑ったりして見ている。\n\nその後、学校のトイレで、またお腹が痛くなる前にトイレットペーパーを手に取る。時間がないので、彼女はトイレの上に立ち、パンティーをさらに満たし、重みで破れ、トイレに落ちて汚い水しぶきを上げる。しかし、彼女はその後もさらにウンチをし続ける。\n\nその後、彼女は汚れたお尻で底なしに立ち、水を流そうとするが、トイレは詰まり、ウンチの水が漏れてスカートが濡れ、そして彼女は泣く。\n\nhttps://drive.google.com/file/d/1U9VqqVWga_FyN6NY7fitgrO3SpRz9GSr/view?usp=drive_link", "nc": 184, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@shinomizu1310/works/9", "private_thumbnail_image_urls": null, "private": false, "genre": "comic", "tipped": true, "creator_id": 505017, "client_id": 2038809, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/2ae3e588/uploads/origins/b5ee7347-378d-45fe-8495-69f8c234f40d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3a020d810f2e7badf0bc4ae9674dd298", "srcset": "https://si.imgix.net/2ae3e588/uploads/origins/b5ee7347-378d-45fe-8495-69f8c234f40d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3a020d810f2e7badf0bc4ae9674dd298, https://si.imgix.net/2ae3e588/uploads/origins/b5ee7347-378d-45fe-8495-69f8c234f40d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=45d8a8657178ecac15de06dad783973b 2x, https://si.imgix.net/2ae3e588/uploads/origins/b5ee7347-378d-45fe-8495-69f8c234f40d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=0beb2dc05fde78eac30c20b3a8acbaac 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/2ae3e588/uploads/origins/b5ee7347-378d-45fe-8495-69f8c234f40d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=1fde9d5acfef50319d3ac0568588c376", "srcset": "https://si.imgix.net/2ae3e588/uploads/origins/b5ee7347-378d-45fe-8495-69f8c234f40d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=1fde9d5acfef50319d3ac0568588c376, https://si.imgix.net/2ae3e588/uploads/origins/b5ee7347-378d-45fe-8495-69f8c234f40d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=0e32d115aeb66b823cb4b61bf7bfdd5a 2x, https://si.imgix.net/2ae3e588/uploads/origins/b5ee7347-378d-45fe-8495-69f8c234f40d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=52455bd9255726beac3511fc600e6b01 3x"}, "body": "改めて、先日はみなちゃんのイラストありがとうございました。よろしければ、またリクエストさせて頂きたく思います。\n（前回は匿名でしたが、今回はこちらの名義で失礼します）\n今回はちょっと長めの漫画でお願いできればと考えています。\n\n★登場人物（ヒーロー名の●●含め、お好きな名前に変えて下さい）\n・ばなな\n小●入学前位の年齢の女の子。特撮ヒーローの●●が好きで、着ているシャツや下着にも●●の意匠が入っている。\n親戚のBによく懐いていて、彼と●●ごっこをして遊ぶのが好き。\n軽く便秘気味。\n・ともひと\n中●生。ばななにヒーローごっこでボロボロにされるのは若干恐れているが、何やかんやで彼女のことは嫌いではない。\n\n★あらすじ（細かい台詞や展開は調整して下さい）\n親戚の集いで顔を合わせるばななとともひと。一緒に遊ぼうという話になるが、ひとまずは食事優先に。\n食後にヒーローごっこを始める二人だったが、ばななの様子が少し変。どうやら数日ぶりの便意に襲われたようで、遂にはお尻を押さえてしゃがみ込み、大きなおならをしてしまう。\n「ヒーローはトイレなんかいかない」と意地を張るばなな。ともひとは「今のお前に勝っても嬉しくない」などと敵役になり切って煽ることで説得に成功する。\n和式が苦手なばななのために、ともひとが一部始終を見守ってやることに。彼の見ている前で、排便するばなな。恍惚とした表情。\nばななのお尻を拭いてやりながら、「戦えるか、●●？」と聞くともひと。振り向きながら「だいじょうぶ！　もうまけないよ」と言って笑うばなな。用便後のばななに圧倒され、ともひとはいつも以上にボコボコにされるのだった……というオチで〆。\n\n・排便シーンの流れ\n「放屁→硬めうんちの欠片が四、五個出る→硬めの本体が途中まで出てくるも、引っかかる→苦戦するばななに、敵役になり切ったともひとが「これで終わりか？」的なことを言う→奮起したばななが気張って硬めうんちを出し切る→続けて健康なバナナうんちが二本程出る」\n・また、みなちゃんの時と同じく用便中の全身カット（顔からお尻まで、便器透過）をどこかで入れて下さい。できれば正面からのアングルでお願いします。\n・ラストのばななの振り向き笑顔のシーンは、大ゴマで印象に残るようなものにして下さると幸いです。\n\n注文が多くなってしまい申し訳ありません。何卒よろしくお願いいたします。", "nc": 40, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@shinomizu1310/works/8", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 505017, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/665d7fad/uploads/origins/3c6659b6-d0d9-4305-b1d8-bfbcb9fc8852?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fc6fc0e4b27e1d798b72b12d96ac56a7", "srcset": "https://si.imgix.net/665d7fad/uploads/origins/3c6659b6-d0d9-4305-b1d8-bfbcb9fc8852?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fc6fc0e4b27e1d798b72b12d96ac56a7, https://si.imgix.net/665d7fad/uploads/origins/3c6659b6-d0d9-4305-b1d8-bfbcb9fc8852?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=4ca92899a016b1f95a83e2842fa925f6 2x, https://si.imgix.net/665d7fad/uploads/origins/3c6659b6-d0d9-4305-b1d8-bfbcb9fc8852?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=eb67d270c1ed30ed1a0d079abc432972 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/665d7fad/uploads/origins/3c6659b6-d0d9-4305-b1d8-bfbcb9fc8852?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=1e15ebef16f20a1f40c24ed753d4855f", "srcset": "https://si.imgix.net/665d7fad/uploads/origins/3c6659b6-d0d9-4305-b1d8-bfbcb9fc8852?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=1e15ebef16f20a1f40c24ed753d4855f, https://si.imgix.net/665d7fad/uploads/origins/3c6659b6-d0d9-4305-b1d8-bfbcb9fc8852?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=a3a1f719e5e9bfee7e207fc80b3d6a1c 2x, https://si.imgix.net/665d7fad/uploads/origins/3c6659b6-d0d9-4305-b1d8-bfbcb9fc8852?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=a1d4fd40fcd47e3284bfc1a2a8977737 3x"}, "body": "イラスト、陰ながら拝見させて頂いております。\nお漏らしの魅力もさることながら、先日の間に合ったお姉ちゃんの漫画のように気持ちよさそうな顔で排便している姿が個人的に好みです。\nそこで、以前投稿されていた資料URLの子（みなちゃん）の間に合ったVer.を見てみたく思い、依頼させて頂きます。\n\n内容としては、幼稚園によくある背もたれのない洋式便器にみなちゃんが跨り、蕩けるような笑顔で健康便を出している様子をお願いします。尚、先日の絵と同じように、便器が透過して、お尻から便が伸びている様子まで一体で描いて頂きたく思います。\nまた、排便直前にトイレに駆け込んでパンツを下ろして座り込むシーンも描いて頂けると嬉しいです。\n\n（金額等に不備がございましたら再送頂ければ幸いです）\n\nhttps://www.pixiv.net/artworks/117283311", "nc": 57, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@shinomizu1310/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "comic", "tipped": false, "creator_id": 505017, "client_id": 56548, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/9f4c3161/uploads/origins/8d39b696-7c72-41eb-ae12-f88cb1845247?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b759d32ac0355042eaf980bfae0a1d22", "srcset": "https://si.imgix.net/9f4c3161/uploads/origins/8d39b696-7c72-41eb-ae12-f88cb1845247?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b759d32ac0355042eaf980bfae0a1d22, https://si.imgix.net/9f4c3161/uploads/origins/8d39b696-7c72-41eb-ae12-f88cb1845247?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=9a91568056551e4356bf1cfa096288d9 2x, https://si.imgix.net/9f4c3161/uploads/origins/8d39b696-7c