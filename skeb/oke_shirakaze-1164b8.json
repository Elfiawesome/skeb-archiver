200&s=33d199f9630a499d343a4427307be848, https://si.imgix.net/cc6400f6/uploads/origins/82dc6aa7-3530-4345-a80f-9b25be27d4c2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=a887b6bbe9fa0e3306800204f5d8ec6a 2x, https://si.imgix.net/cc6400f6/uploads/origins/82dc6aa7-3530-4345-a80f-9b25be27d4c2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=af518686bbdf6de64e8f9d30cfd6a0f8 3x"}, "body": "はじめまして。あまりこういうリクエストをしないので上手くシチュの説明が出来るか不安ですが…キャラクターはまいてつのハチロクとみくろ、何かしらの作業(掃除とか？)を終えて一息つこうとしているみくろの前にハチロクが現れ、よく頑張りましたねと優しく抱き寄せて頭をなでなでするシチュでお願いします。その際、みくろの表情は最初驚いた顔から段々と惚けたような表情に変わる描写をしてくださると非常に嬉しく存じます。服装は2人とも制服でお願いします。説明で足りなかった部分はどうにか補完してくださればと思います…何卒、よろしくお願いします。", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@oke_shirakaze/works/11", "private_thumbnail_image_urls": null, "private": false, "genre": "comic", "tipped": true, "creator_id": 2720061, "client_id": 423065, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/d0acd870/uploads/origins/21b5880b-8784-4357-acba-281709d2fb18?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=54e3a1aad7aa61431c846827c95b4438", "srcset": "https://si.imgix.net/d0acd870/uploads/origins/21b5880b-8784-4357-acba-281709d2fb18?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=54e3a1aad7aa61431c846827c95b4438, https://si.imgix.net/d0acd870/uploads/origins/21b5880b-8784-4357-acba-281709d2fb18?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=614fa726ef020c4dc22967938c6585e4 2x, https://si.imgix.net/d0acd870/uploads/origins/21b5880b-8784-4357-acba-281709d2fb18?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=5bbeffbdee3a55dde7c7cc0a0d14385e 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/d0acd870/uploads/origins/21b5880b-8784-4357-acba-