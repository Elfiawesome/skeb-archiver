9026532352%2FjwdCSXG3.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c9415d076c832d0350255e84066edbb7", "srcset": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F2061373279026532352%2FjwdCSXG3.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c9415d076c832d0350255e84066edbb7, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F2061373279026532352%2FjwdCSXG3.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=176177386ba34fcc1354c58f1f45ec50 2x, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F2061373279026532352%2FjwdCSXG3.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=3939d0a451465b59720558a665f7f7ca 3x"}, "body": "前回のフェラ＆ゲップオナラASMRがとても良かったのでリピート依頼になります！\n今回はゲップオナラオナニーASMR配信というシチュでお願いします！\n以下入れてほしい要素になります。\n1.挨拶とビール一気飲み\n挨拶をしつつ乾杯でビールを一気飲み（ビールという体で強炭酸水で代用も可）\nした後にマイク向かってどでかいゲップをかます。\nその後も連続でゲップをかましつつ昼食は何を食べたか（可能であればにんにく系）の話やゲップの臭いについて感想もあると嬉しいです。\n2.本命のおならASMR\nビールをおかわりしてガスをチャージ、腹をポンポン叩いてガスがパンパンに溜まってるアピール。\nマイクに向かってお尻を向けて力んでバカでかオナラをかます。\nオナラの臭いについての感想を間に挟みつつその後もオナラを連発してオホ声や汚言を言いながら出しながらオナる（可能ならアナニーも）\n最後は思いっきり気張ってオナラをしてオホりながらフィニッシュ。\nゲップやオナラは先に録音してセリフは後から収録して合わせる形でも大丈夫です。\n前回に引き続き生々しい音を響かせたゲップオナラASMRにしてもらえると嬉しいです！\n今回も何卒よろしくお願いいたします！", "nc": 43, "word_count": 0, "transcoder": "audio", "creator_acceptable_same_genre": true}, {"path": "/@Hukami_Anko/works/3", "private_thumbnail_image_urls": {"src": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F2061373279026532352%2FjwdCSXG3.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=7ce49a8cefbf2a654f2be91f2c895a76", "srcset": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F2061373279026532352%2FjwdCSXG3.jpg?bg