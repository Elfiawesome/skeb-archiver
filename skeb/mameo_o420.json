://drive.google.com/drive/folders/1P2lPRU_jHE9syN7vMKvqBiaTwSk9Ozj8?usp=sharing\nありがとうございました", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@mameo_o420/works/4", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/5804d0b7/uploads/origins/77f01e12-b301-42dc-82f7-0d705cffacb6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=471c75d9a67489ac19fc2363dc703b37", "src_set": ""}, "private": true, "genre": "art", "tipped": false, "creator_id": 3574415, "client_id": 0, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 145, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@mameo_o420/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3574415, "client_id": 3516337, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/6b8703c1/uploads/origins/17a1f6ee-7a2b-4836-8e72-d6495032ad58?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=358fdb6c5ce4b8010611de3cabd41f1b", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/6b8703c1/uploads/origins/17a1f6ee-7a2b-4836-8e72-d6495032ad58?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d66ab9897bf1768624cdb750127b4138", "src_set": ""}, "body": "豆槙様初めまして\n豆槙様の素敵で柔らかで重厚な塗りのイラストに惹かれました。ぜひ豆槙様に私のキャラクターを描いて頂きたいと思い リクエストさせていただきました！\n\n🐭🫖\nヘイゼル・マーロウ     Hazel Marlow\n無性別\n167cm\nカラーやモチーフ\n・黄色と水色\n・眠りネズミ\n\n・ヘイゼルの喋り方はトロくてのんびりで〜〜（なみなみ）でよく喋ります。\n・お茶会が好きで、お喋りも好きです\n\n豆槙様のかかれるイラストが本当に可愛く、構図や絵の雰囲気など、好きです\n\n\n服装やデザイン等ご自由に簡略化などしていただいても構いません。お任せいたします。\n\n構図やシチュエーションなど全てお任せいたします。\n\n\n落書きなどをリンク先に載せています。もしよろしければご参考程度にお願い致します！\n\n