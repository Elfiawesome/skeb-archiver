t%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f0fc4d23e65acfe99b3d672eec4c0e4d 2x, https://si.imgix.net/cb1dbf9d/uploads/origins/aa0f1046-0b61-4a4d-8edb-4ab2345e8162?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=039bd2dacca817144a2362867d3ba1a1 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/cb1dbf9d/uploads/origins/aa0f1046-0b61-4a4d-8edb-4ab2345e8162?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=439a269ec3017da90051d5bc8daba882", "srcset": "https://si.imgix.net/cb1dbf9d/uploads/origins/aa0f1046-0b61-4a4d-8edb-4ab2345e8162?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=439a269ec3017da90051d5bc8daba882, https://si.imgix.net/cb1dbf9d/uploads/origins/aa0f1046-0b61-4a4d-8edb-4ab2345e8162?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=818caeb72d9a8552796e7caeb586b06d 2x, https://si.imgix.net/cb1dbf9d/uploads/origins/aa0f1046-0b61-4a4d-8edb-4ab2345e8162?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=9a8b6e5c8aaece14c56c09f3498d7b11 3x"}, "body": "こんばんは\n氷沼悠理という子をお願いします\nhttp://www.getchu.com/sp/soft.phtml?id=1190\nhttps://drive.google.com/drive/folders/1IwML5k39fvT-axqqDQd9sn5Ym7GOIG2q\n元お嬢様で常時敬語、読書が趣味のおっとりとした子です\n華奢で胸はわずかにふくらみがある程度(AAカップ)\n乳首は淡い桃色で乳輪乳頭小さめ\n陰毛なし\n\n\n・服装等\nセーラーワンピースの上をはだけて胸露出(腕部分のみ脱がないイメージ)\nhttps://drive.google.com/file/d/1JCC7uSO5FjIPl7ZeK90DeQbr3g-sn9SZ\nhttps://drive.google.com/file/d/19RwSUk6huRNG6fM-Pqc1PQjD_16Pxz4P\nスカート部そのまま\n膝下の黒ハイソックス\n下着なし\n服は全て脱げると助かります\n\n\n・シチュ等\n片手でシーツを掴み、もう片方の手は軽く握って口元に当て、視線を逸らしながらも両足で相手の腰をがっちり抑え込み(だいしゅきホールド)、気持ちよさそうにピストンを堪能中(竿に白く濁った愛液=本気汁がべっとり絡みついている)\nふとももの内側に純潔だった証である赤いものが伝っている\n最後までこの体勢\n「あっ。あっ。あっ。あっ」\n「あぁぁぁぁっ！！」\n「わ、私、もうっ！　あっ、あっ、あっ、ああぁぁっっ！」\n↓\n破瓜中出しを受け止め、目を伏せて口を「あ」の形に開いて同時絶頂の悦びに浸っている\n腹部〜スカート→大量に中出しされた精液が溢れて細かく飛び散っている\n結合部及び周辺→破瓜の血・本気汁・精液\n「あ、あ、あ、あぁぁぁぁぁぁぁぁっ!!」\n↓\n繋がったままの余韻\nぼんやりと目を開き、蕩け切った表情\n結合部から破瓜の血と本気汁、精液が混じりあいながら溢れてお尻の下のスカート裏に溜まっている\n「あ……♡」\n↓\n全身余すところなく白濁まみれの状態で再度挿入されて中出し\n「あ゙―――――――――っ♡♡」\n\n擬音や喘ぎ声、断面図あり(喘ぎ声は基本的に「あ」)\n\nレイヤーは可能な限り細かく残し、いろいろなパターンが作れると大変捗ります\n\n修正は細い白線\n\n\n・背景\n自室想定で白いシーツのベッド上\n\n\n・男性\n同年代で特徴のない普通の男性(全裸)\n顔を描く場合ゲームの主人公の様なボサボサ頭で顔なしor頭部見切れ\n\n\n何卒ご検討下さい。", "nc": 177, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@taneshiboringo/works/14", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2301445, "client_id": 305449, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/12fde642/uploads/origins/069c9c7d-8844-4fb7-b6c0-beb3501a0852?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c68482a020be2f9bd1cc9b85a8ec82ab", "srcset": "https://si.imgix.net/12fde642/uploads/origins/069c9c7d-8844-4fb7-b6c0-beb3501a0852?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c68482a020be2f9bd1cc9b85a8ec82ab, https://si.imgix.net/12fde642/uploads/origins/069c9c7d-8844-4fb7-b6c0-beb3501a0852?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ccc6f21ee36f84536e5f00626ec677e6 2x, https://si.imgix.net/12fde642/uploads/origins/069c9c7d-8844-4fb7-b6c0-beb3501a0852?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b0142f7687128f90e6551e5958582cea 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/12fde642/uploads/origins/069c9c7d-8844-4fb7-b6c0-beb3501a0852?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9862c5b75859c71f46c776cee56b8684", "srcset": "https://si.imgix.net/12fde642/uploads/origins/069c9c7d-8844-4fb7-b6c0-beb3501a0852?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9862c5b75859c71f46c776cee56b8684, https://si.imgix.net/12fde642/uploads/origins/069c9c7d-8