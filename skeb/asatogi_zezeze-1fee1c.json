dc8/uploads/origins/dc511d60-c132-4c45-9152-15f29cef502b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=92cab1e13bcb792e746992d9b19841bf 2x, https://si.imgix.net/4ba9edc8/uploads/origins/dc511d60-c132-4c45-9152-15f29cef502b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=cfafeb3c2c86d4a39be8bf04e79a6157 3x"}, "body": "こんにちは！\n新人Vtuberの坂生エンです！！\nTwitterに公開されている、豚汁くんとトンカツくんを見て、こういうの良いな～と思って依頼させて頂きました！\nゆるゆるなイラストをお願いしたいです！\n\n内容は、僕自身・坂生エンの「食べられイラスト」です！\n僕はよくフォロワーさんに食べられてしまうので、もういっそネタにしようと思い至りました。\n\nできれば寿司ネタになってる坂生エンが見てみたいです！\n卵寿司の様に海苔が巻いてあるとなお嬉しいです！\nそれと、透過画像になっていると助かります！\n\n使用用途としては、youtubeおよびSNSでの利用を考えていますが、youtubeにおいては今後収益化された動画に使用する事もあると思いますので、その許可がある前提で受けて頂けると幸いです。\n\nこちらのXに三面図がありますので、参考資料としてお使いください。\nキービジュアルでは手が出ていますが、僕の衣装は萌え袖がデフォルトです。\nhttps://twitter.com/sakanamaen", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}], "sent_works": [{"path": "/@habakura54/works/33", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 428, "client_id": 2898894, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/dc887dfb/uploads/origins/4928ac7f-336c-49d1-8a09-786294c156b9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0ea08498a20feee8754b28a6520e5741", "srcset": "https://si.imgix.net/dc887dfb/uploads/origins/4928ac7f-336c-49d1-8a09-786294c156b9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0ea08498a20feee8754b28a6520e5741, https://si.imgix.net/dc887dfb/uploads/origins/4928ac7f-336c-49d1-8a09-786294c156b9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=77ed995a2aa425a67a9f23222de25e7c 2x, https://si.imgix.net/dc887dfb/uploads/origins/4928ac7f-336c-49d1-8a09-786294c156b9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=beee977e6a8a5fb3b338fd43ed7d7aca 3x"}, "duration": null, "nsfw