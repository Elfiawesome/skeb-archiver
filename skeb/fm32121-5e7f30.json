3fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5f214aab12ce83790b6af8f274b491e8, https://si.imgix.net/979496b3/uploads/origins/91627137-7a0c-4f35-a38b-4fa238f205df?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=7337642bdabcf049a3d14f4448dce704 2x, https://si.imgix.net/979496b3/uploads/origins/91627137-7a0c-4f35-a38b-4fa238f205df?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=8c5f79b6010bd74f51008c3806f7aecf 3x"}, "body": "こんにちは。\n前回は素敵なフジキセキのイラストありがとうございました。\nPCのデスクトップに飾らせて頂いております。\n\n今回は再び学園アイドルマスターのかっこよくて可愛いアイドル「有村麻央」さんを依頼したいです。\n衣装は「見て」で色は赤と白の２パターンがあるのですが、どちらにするかはお任せしたいと思います。\n季節は春で華やかな雰囲気だと嬉しいです。\nポーズや構図はお任せします。\n\n壁紙や額縁に入れて飾りたいと思っております。\nご検討のほどよろしくお願いします。\n\nhttps://seesaawiki.jp/gakumasu/d/%b0%e1%c1%f5%a5%ae%a5%e3%a5%e9%a5%ea%a1%bc/%cd%ad%c2%bc%cb%e3%b1%fb#Mao_Regular_0004D", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@fm32121/works/9", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 12080, "client_id": 852952, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/09ceaaeb/uploads/origins/666dc7aa-b321-47f8-b083-f4d362d1f506?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=72a3f17df460a073a4397a5c2d963da9", "srcset": "https://si.imgix.net/09ceaaeb/uploads/origins/666dc7aa-b321-47f8-b083-f4d362d1f506?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=72a3f17df460a073a4397a5c2d963da9, https://si.imgix.net/09ceaaeb/uploads/origins/666dc7aa-b321-47f8-b083-f4d362d1f506?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=2fac8218d645c377ab54f3f4b99b89c9 2x, https://si.imgix.net/09ceaaeb/uploads/origins/666dc7aa-b321-47f8-b083-f4d362d1f506?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=16fcf1b0c1771292267ea3e6525365f6 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/09ceaaeb/uploads/origins/666dc7aa-b321-47f8-b083-f4d362d1f506?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=da32de8ae58f022ecd783cf9c99f4145", "srcset": "https://si.imgix.net/09ceaaeb/uploads/origins/666dc7aa-b321-47f8-b083-f4d362d1f506?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=da32de8ae58f022ecd783cf9c99f4145, https://si.imgix.net/09ceaaeb/uploads/origins/666dc7aa-b321-47f8-b083-f4d362d1f506?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=9ad402860242bd418d20468dc6f9a8bc 2x, https://si.imgix.net/09ceaaeb/uploads/origins/666dc7aa-b321-47f8-b083-f4d362d1f506?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=a84ce1d182800877c47fb017751a082d 3x"}, "body": "あけましておめでとうございます。\n本年もよろしくお願い申し上げます。\n元旦から依頼してみたいのでお題まとまってないですが依頼します。\n\n【キャラクター】\nまだしばらくボーダーブレイクに囚われて生きていきたいと思っているので、キャラクターはまたクゥ・ラルツァでお願いします。白い髪に赤い一房が映えます。\n\n【お題】まとまりません。\n季節の要素 → 冬はもう完璧なのをいただいている\n元旦だから振袖 → ３が日過ぎたら旬を逃す\n干支の馬 → 少女と馬のよい構図？？？\n恵方巻き → 食べてるイメージがあまりない\n梅 → まだ早い？ 桜の作品と似てしまいそう\n1日考えましたがまとまりません！！　どこまでも綺麗な絵が珠樹さんの強みだと思っているのでそういう方向で書いて欲しいと思いつつ、年明けはめでたい感じで始めたい気持ちもありなにもわかりません。\n年初に書きたいものあったら書いてください！！！\n\n使用用途はiPhone, iPad, パソコンで壁紙にします。まだ夢想してるだけですが缶バッジとかにもできたら楽しそうだなと思ってます。\n宛名書きにサインも入れてもらえると嬉しいです。\nよろしくお願いします。", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@fm32121/works/8", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 12080, "client_id": 2235685, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/e9b73577/uploads/origins/9805fa70-e473-4d7c-b188-9ccd9986c1ee?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=db29b9b9431412f32d27b6efc0eacddd", "srcset": "https://si.imgix.net/e9b73577/uploads/origins/9805fa70-e473-4d7c-b188-9ccd9986c1ee?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=db29b9b9431412f32d27b6efc0eacddd, https://si.imgix.net/e9b73577/uploads/origins/9805fa70-e473-4d7c-b188-9ccd9986c1ee?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=27ceeee9de122efb6a317032c712e072 2x, https://si.imgix.net/e9b73577/uploads/origins/9805fa70-e473-4d7c-b188-9ccd9986c1ee?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e91713ab2f65bc0e60d8de3b6c34b2a2 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/e9b73577/uploads/origins/9805fa70-e473-4d7c-b188-9ccd9986c1ee?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9d80f1c58069c383da864e9e6e2f101e", "srcset": "https://si.imgix.net/e9b73577/uploads/origins/9805fa70-e473-4d7c-b188-9ccd9986c1ee?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9d80f1c58069c383da864e9e6e2f101e, https://si.imgix.net/e9b73577/uploads/origins/9805fa70-e473-4d7c-b188-9ccd9986c1ee?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=788e2e5af809cc2afa28a85754b2813f 2x, https://si.imgix.net/e9b73577/uploads/origins/9805fa70-e473-4d7c-b188-9ccd9986c1ee?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=b650cb96a3a752538d5a4300d015f107 3x"}, "body": "前回はとても素敵な麻央さんのイラストありがとうございました！\n柔らかい笑みがとても綺麗で気に入っております。\n\n今回はウマ娘のフジキセキのイラストを依頼したくご連絡させて頂きました。\n服装は黒のタキシード勝負服でお願いします。\n幸福そうな微笑みを浮かべてこちらに手を差し伸べる感じでお願いします。\n季節は春で背景に藤の花をお願いします。\n\n使用用途は壁紙とダイヤモンドアートにしたいと思います。\nよろしくお願いします！\n\nhttps://gamewith.jp/uma-musume/article/show/287062", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@fm32121/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 12080, "client_id": 852952