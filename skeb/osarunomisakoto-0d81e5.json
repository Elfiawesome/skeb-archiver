n\nイラストに関する依頼が初めてで、何か至らない点などありましたら申し訳ありません；；\nご検討のほど、よろしくお願いいたします...！\n\nhttps://drive.google.com/file/d/1b_1GlvLOwzUpBB7eJv18gRe2EtWr0lfT/view?usp=sharing", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@osarunomisakoto/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1989819, "client_id": 2490879, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/ace420a9/uploads/origins/068180ed-5f04-4a5f-8c8e-d96eef0e70f6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c2f5f1fc82df21ed8fe9b6933b39aca1", "srcset": "https://si.imgix.net/ace420a9/uploads/origins/068180ed-5f04-4a5f-8c8e-d96eef0e70f6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c2f5f1fc82df21ed8fe9b6933b39aca1, https://si.imgix.net/ace420a9/uploads/origins/068180ed-5f04-4a5f-8c8e-d96eef0e70f6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=5adcc3afa18ec4b94d544ba31163bdb2 2x, https://si.imgix.net/ace420a9/uploads/origins/068180ed-5f04-4a5f-8c8e-d96eef0e70f6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d77d23d8f37c72c38262db76d42e8d22 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/ace420a9/uploads/origins/068180ed-5f04-4a5f-8c8e-d96eef0e70f6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9647847b4e43d50a7760bb2f98367e7c", "srcset": "https://si.imgix.net/ace420a9/uploads/origins/068180ed-5f04-4a5f-8c8e-d96eef0e70f6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9647847b4e43d50a7760bb2f98367e7c, https://si.imgix.net/ace420a9/uploads/origins/068180ed-5f04-4a5f-8c8e-d96eef0e70f6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=d71da595ea28d883e087f991bb618b71 2x, https://si.imgix.net/ace420a9/uploads/origins/068180ed-5f04-4a5f-8c8e-d96eef0e70f6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=1d21535237e18a9e4b64188e24638efa 3x"}, "body": "はしもりさんお疲れ様です！\nいつもお世話になっております。\n\n最近、Xの方でアップされていましたデフォルメイラストのようなタッチで私のオリキャラを描いていただきたいと思い、リクエストさせていただきました。\n\n【使用用途】\n個人観賞目的です。もしよろしければ、自分用にアクスタかアクキーを発注したいと考えています。\n\n【キャラクター】\n・20代半ばの成人男性。\n・白髪、左目隠れで、ウェーブがかったロングヘアを後ろで一つ結びにまとめて大きい暗めの赤い色のリボンで結んでいる。\n・赤色の並行目。\n・吸血鬼の為、人間よりも肌が白い。\n\n【構図・ポーズ・表情について】\n構図やポーズはおまかせしたいです。表情はにこやかな明るいものだと嬉しいです……！\n\n【作画】\n最近作成されていました一色鷹目さんや稲荷混さんのデフォルメイラストのようなタッチで描いていただきたいです……！\nパーツ・デザイン等ははしもりさんが描きやすいように省略していただけますと幸いです。\n\n【サイズ・形式について】\nサイズ、形式はおまかせします。\n使用用途に問題がないようでしたら背景透過データを添付して頂けますと幸いです。\n\n\nお忙しいところ恐縮ですが、もしよろしければ描いてくださると嬉しいです！\n金額や使用用途に問題があるようでしたらお手数をおかけしますが再送要請をお願いしたいです。\nご検討いただけますと幸いです。よろしくお願いいたします！\n\nhttps://www.notion.so/1e8221742ee180b2931fd6849b271712?pvs=4", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@osarunomisakoto/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1989819, "client_id": 3536609, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/118abaa7/uploads/origins/d05c5f9c-6b88-46b9-9a87-e0290bdaf39f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3c97a684ed38ecc8586b90a23a415860", "srcset": "https://si.imgix.net/118abaa7/uploads/origins/d05c5f9c-6b88-46b9-9a87-e0290bdaf39f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3c97a684ed38ecc8586b90a23a415860, https://si.imgix.net/118abaa7/uploads/origins/d05c5f9c-6b88-46b9-9a87-e0290bdaf39f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=7ca9b6495be911003e544aa2bd1d7b71 2x, https://si.imgix.net/118abaa7/uploads/origins/d05c5f9c-6b88-46b9-9a87-e0290bdaf39f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=2a7e20ab4a15eeb0af451cdd175e3ab8 3x"}, "d