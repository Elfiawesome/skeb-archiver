b9-c1be-4b74-a66e-422ce3cd67d6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a27d94cbfa1fec053f4b2ae6c9e10fdb", "srcset": "https://si.imgix.net/fdfe0b22/uploads/origins/ac4873b9-c1be-4b74-a66e-422ce3cd67d6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a27d94cbfa1fec053f4b2ae6c9e10fdb, https://si.imgix.net/fdfe0b22/uploads/origins/ac4873b9-c1be-4b74-a66e-422ce3cd67d6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=d352b9be2794136668af74ea16a162b3 2x, https://si.imgix.net/fdfe0b22/uploads/origins/ac4873b9-c1be-4b74-a66e-422ce3cd67d6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=c8661d0ce8ee0b30bb7d82371c233389 3x"}, "body": "こんにちは、前回は素敵なOCを描いていただきありがとうございました。\n別の普段の業務服を着ているOCを再度見たくて投げさせていただきました。\nよろしければ、また私のOCを描いていただけないでしょうか。\n\n＜依頼内容＞\n◯OCの設定等：\n所属：独立行政法人 文化遺産警保局 無形民俗遺産管理部 逝物1課\n\n北国短期大学を卒業後、就職活動をして100社程度応募するが全て不合格。ヤケクソ気味に応募してみた独立行政法人に倍率1000倍を何故か突破し合格。晴れて逝物1課配属となった。（生まれながら逝物に対する耐性が見込まれていたため、この入社と配属は仕組まれたものだが本人は知らない。また組織自体その内容を外部へ漏らしていない為)\n頭はそこまで良くないが、緊急時のアドリブの良さが評価されている。短大時代の友人の影響でサブカル好きではないがオカルト等ソレ系の知識が多い。\n組織内での仕事は「本来であれば時代の経過で失われ、逝去するはずであった遺産（人、動物、文化、伝承、宗教等形状がない物）の排除」。排除方法は形式じみたものから物理的行使まで様々。対人間の場合もある為、拳銃・猟銃といった武器の所持許可が認められているが、緊急事態や対応策として確定した場合のときのみの使用となるので普段は飾りになっている。\n\n○衣装について：\nスーツ姿でお願いします。シャツ・ネクタイの色は白と赤が多いですがほかの色でも構いません。ご自由にどうぞ\n\n◯イラストイメージ・構図・サイズ等：\nおまかせします。\n\n対応不可と言う事であればキャンセルして頂いて構いませんので、ご検討いただければと思います。\n\nhttps://drive.google.com/drive/folders/1tpotvektjecC-nGiWN91aV0HeXNMNtvd?usp=drive_link", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Padumorioic/works/16", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 339612, "client_id": 2784390, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/089b836d/uploads/origins/89541f9d-dd4f-469c-ba38-9b59a38d3e20?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6344ce2a06af9f2630a18a498e4a2edd", "srcset": "https://si.imgix.net/089b836d/uploads/origins/89541f9d-dd4f-469c-ba38-9b59a38d3e20?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6344ce2a06af9f2630a18a498e4a2edd, https://si.imgix.net/089b836d/uploads/origins/89541f9d-dd4f-469c-ba38-9b59a38d3e20?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=698dd313ab1e7a085446eaa419d6d190 2x, https://si.imgix.net/089b836d/uploads/origins/89541f9d-dd4f-469c-ba38-9b59a38d3e20?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b95dd74397efb60f7c5a3e5dcf1672bb 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/089b836d/uploads/origins/89541f9d-dd4f-469c-ba38-9b59a38d3e20?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=83271151a2b7716e8b715dbceb49920c", "srcset": "https://si.imgix.net/089b836d/uploads/origins/89541f9d-dd4f-469c-ba38-9b59a38d3e20?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=83271151a2b7716e8b715dbceb49920c, https://si.imgix.net/089b836d/uploads/origins/89541f9d-dd4f-469c-ba38-9b59a38d3e20?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=a0683e759b816266c9731e1e9a01a75e 2x, https://si.imgix.net/089b836d/uploads/origins/89541f9d-dd4f-469c-ba38-9b59a38d3e20?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=6021b16a0857db17ef29bd6d12491be3 3x"}, "body": "塩髄様\nいつも素敵なイラスト拝見させて頂いています。\n長野県名物モチーフのデザイン、どれも特徴的な部分があり素敵です！\n\nそんな塩髄さんに1枚、朝柊のイラストを描いていただきたくリクエストです！\n描いていただく構図や衣装デザイン等は全てお任せいたします。\n\n参考までに以下リンクにデザイン・設定をまとめてあります。\nご縁がありましたら、ぜひよろしくお願いします。\n\n\nhttps://lit.link/hiragi0623\n\nhttps://drive.google.com/drive/folders/1Yq6nGAVqofjbwUo6ZnxPam_wKTfR3HnP?usp=sharing", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_sa