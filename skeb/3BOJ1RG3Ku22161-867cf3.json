す。", "nc": 56, "word_count": 15992, "transcoder": "text", "creator_acceptable_same_genre": false}, {"path": "/@3BOJ1RG3Ku22161/works/6", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/802f23ea/uploads/origins/13199704-15a5-46f7-8f41-a91ecedcf7f0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=b6581e3700a78ee9018f7f7413511794", "srcset": "https://si.imgix.net/802f23ea/uploads/origins/13199704-15a5-46f7-8f41-a91ecedcf7f0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=b6581e3700a78ee9018f7f7413511794, https://si.imgix.net/802f23ea/uploads/origins/13199704-15a5-46f7-8f41-a91ecedcf7f0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=c2de9bc6437e6fdf27196c91181aa264 2x, https://si.imgix.net/802f23ea/uploads/origins/13199704-15a5-46f7-8f41-a91ecedcf7f0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=9c143fb9e5336302635ea277fa815073 3x"}, "private": true, "genre": "correction", "tipped": false, "creator_id": 3118770, "nc": 48}, {"path": "/@3BOJ1RG3Ku22161/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "novel", "tipped": false, "creator_id": 3118770, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/bfdc1e24/uploads/origins/ec602815-15a2-4b8d-ac7f-55020916c2a6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=dc4fe1502bf6a6fa07a165cb67b79f75", "srcset": "https://si.imgix.net/bfdc1e24/uploads/origins/ec602815-15a2-4b8d-ac7f-55020916c2a6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=dc4fe15