0&s=89ba1a0178a75d558bbc170ec1f0819e 2x, https://si.imgix.net/8e7db820/uploads/origins/67acb300-7323-4e64-9fb0-ee9bdea62859?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=bcbf0092a2d7ee6b0934ce966d5a9c23 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/8e7db820/uploads/origins/67acb300-7323-4e64-9fb0-ee9bdea62859?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=453db0e3077092cdb0de828a91effc67", "srcset": "https://si.imgix.net/8e7db820/uploads/origins/67acb300-7323-4e64-9fb0-ee9bdea62859?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=453db0e3077092cdb0de828a91effc67, https://si.imgix.net/8e7db820/uploads/origins/67acb300-7323-4e64-9fb0-ee9bdea62859?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=226c30f56cfd5dc77076410578e9b9ac 2x, https://si.imgix.net/8e7db820/uploads/origins/67acb300-7323-4e64-9fb0-ee9bdea62859?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=7a87f007fa8d6052dd16389fdd78cc3a 3x"}, "body": "皿花さんにBLEACHのR18二次創作をお願いしたいです。竿役は主人公の黒崎一護でヒロインは井上織姫、ネリエル、四鳳院夜一、毒ヶ峰リルカ、キャンディスの5人でお願いします。\n\n設定は千年血戦から数年後くらいで一護と織姫はまだ付き合っておらず、キャンディスはゾンビ化せずに生き残り、腕を切られた因縁から一護に突っかかりあしらわれるのを繰り返してる（実際は無自覚に惚れている）とかで。\n\nストーリーは色々あって、織姫、夜一、ネリエル、リルカ、キャンディスの5人でラブホ女子会をすることになり5人で女子会を楽しむ中、夜一が思いつきでゲストを連れてくると言い一護を連れてくる、一護はほぼ拉致同然に連行され混乱状態で女子会に参加することに。\n居心地の悪さを覚えつつも楽しむ中、夜一が雰囲気作りに浦原商店からくすねてきたアロマ（効果が不安定な失敗作）が強烈な催淫効果を発揮してしまい全員発情状態になり乱交に発展してしまう感じです。\n\nプレイは織姫はキスを交えつつ正常位で処女喪失H、ネリエルはキスを交えつつ騎乗位H、リルカは対面座位でキスしながら処女喪失H、キャンディスは駅弁体位でH、夜一は寝バックでハメてそれぞれ一発ずつ膣内射精をする。\nその後、精液と愛液で汚れた一護の太さ、長さ、カリの高さが揃った巨根を織姫、リルカ、ネリエルの3人からのお掃除フェラ奉仕をされながら左右から夜一、キャンディスに挟まれてそれぞれキスしつつ2人の巨乳を楽しむ。\n最後は5人を四つん這いで並べバックでハメ比べして責任をとって5人とも娶ると宣言しそれぞれ膣内射精する。\n5人は娶る宣言と膣内射精で受精したことを感じてキュンとしながら支えていくことを決意する感じで。\n\n完成した作品はpixivに投稿して構いません。", "nc": 168, "word_count": 29854, "transcoder": "text", "creator_acceptable_same_genre": false}, {"path": "/@3BOJ1RG3Ku22161/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "novel", "tipped": true, "creator_id": 3118770, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/ebd21c49/uploads/origins/a0f53b0a-42d6-4064-ab08-7b1a3490faac?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8c7190de8613b1fb851da17a04461c65", "srcset": "https://si.imgix.net/ebd21c49/uploads/origins/a0f53b0a-42d6-4064-ab08-7b1a3490faac?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8c7190de8613b1fb851da17a04461c65, https://si.imgix.net/ebd21c49/uploads/origins/a0f53b0a-42d6-4064-ab08-7b1a3490faac?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a357c489b882145fdcf8a077f178e03e 2x, https://si.imgix.net/ebd21c49/uploads/origins/a0f53b0a-42d6-4064-ab08-7b1a3490faac?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=1e711779cca17383dcd7a933dc564f92 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/ebd21c49/uploads/origins/a0f53b0a-42d6-4064-ab08-7b1a3490faac?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=97cae098f804998d8851675c8e77c20a", "srcset": "https://si.imgix.net/ebd21c49/uploads/origins/a0f53b0a-42d6-4064-ab08-7b1a3490faac?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=97cae098f804998d8851675c8e77c20a, https://si.imgix.net/ebd21c49/uploads/origins/a0f53b0a-42d6-4064-ab08-7b1a3490faac?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=7adec465c8b600073a8c91e7bd1ca6ea 2x, https://si.imgix.net/ebd21c49/uploads/origins/a0f53b0a-42d6-4064-ab08-7b1a3490faac?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=2748bf67c5c43418a1f5b52fe53693e1 3x"}, "body": "作品：ゼンゼロ\nキャラ：バーニス\n●カリュドーンの子の皆と飲み会している時に、こっそり精力剤入りの酒を呑ませたアキラに対しデカパイを押し付けたり皆にバレないようにフェラ素振りをしたりで誘惑するバーニス。イラついたアキラにこっそり連れ出される。\n●アキラのデカチンでビンタをされながら「プロキシちゃんってばすぐ盛るんだから♡」と嬉しそう。恋人繋ぎしながらのノーハンドパイズリをし、デカチンにうっとりとしながら最後はフェラで口内射精。\n●まだガチガチのデカチンに対して「それじゃあもっと♡」と騎乗位へ移行。盛ってるのはバーニスの方というアキラの指摘に対し「プロキシちゃんが悪いんだよ♡」「なーんにも知らない私のこと食べちゃったわるーいプロキシちゃんが♡」「あれからプロキシちゃんのこれが忘れられないの♡」と腰を振り搾ろうとするもアキラのつよつよチンポにだんだんと余裕をなくし汚いオホ声を漏らす。そして最後は完全に負けて無様に絶頂し気絶する。\n●その後隠れて見ていたカリュドーンの他のメンバーが目をトロンとさせながら出てくるところでオチ。\n\nどうぞよろしくお願いいたします\n\nhttps://www.google.com/search?sca_esv=7aa1caabb4121f2c&sca_upv=1&rlz=1C1PWSB_jaJP1071JP1071&sxsrf=ADLYWIJaFl1gUOkaFApztV07MJN9PEcRVQ:1727709364086&q=%E3%82%BC%E3%83%B3%E3%82%BC%E3%83%AD+%E3%83%90%E3%83%BC%E3%83%8B%E3%82%B9&udm=2&fbs=AEQNm0BqbPbAzSj6PhNr7nv", "nc": 56, "word_count": 17230, "transcoder": "text", "creator_acceptable_same_genre": false}, {"path": "/@3BOJ1RG3Ku22161/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "novel", "tipped": true, "creator_id": 3118770, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/65fe06c3/uploads/origins/7f9e963d-5271-4686-a620-8b34b13c56f6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3958b3f48ee1801f0c1a784156ec86a3", "srcset": "https://si.imgix.net/65fe06c3/uploads/origins/7f9e963d-5271-4686-a620-8b34b13c56f6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3958b3f48ee1801f0c1a784156ec86a3, https://si.imgix.net/65fe06c3/uploads/origins/7f9e963d-5271-4686-a620-8b34b13c56f6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=411f56fb8e5e25c335bcc38822b2c2e3 2x, https://si.imgix.net/65fe06c3/uploads/origins/7f9e963d-5271-4686-a620-8b34b13c56f6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=3683089b9d6553ecd556552ecd482df2 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/65fe06c3/uploads/origins/7f9e963d-5271-4686-a620-8b34b13c56f6?bg=%23fff&auto=format%2Ccompress&fm=w