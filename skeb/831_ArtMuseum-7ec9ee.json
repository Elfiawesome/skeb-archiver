=200&h=200&s=32083af0d613022fa5f8e2dbf729fbb4, https://si.imgix.net/f82b4132/uploads/origins/23dd09a1-8181-483f-8066-4d164627140b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b1d8513b7d90504d1c675834a6b3ab4e 2x, https://si.imgix.net/f82b4132/uploads/origins/23dd09a1-8181-483f-8066-4d164627140b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=daba1db7aa68610fbe611916c5745fe5 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/f82b4132/uploads/origins/23dd09a1-8181-483f-8066-4d164627140b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ea75d441c7514c8784574727e8c298ce", "srcset": "https://si.imgix.net/f82b4132/uploads/origins/23dd09a1-8181-483f-8066-4d164627140b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ea75d441c7514c8784574727e8c298ce, https://si.imgix.net/f82b4132/uploads/origins/23dd09a1-8181-483f-8066-4d164627140b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=f56add082f19053dfcad869b4f7c07b7 2x, https://si.imgix.net/f82b4132/uploads/origins/23dd09a1-8181-483f-8066-4d164627140b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=09b6bc1d045c5cb9eedd95383039eab3 3x"}, "body": "お久しぶりです！ヤサイさん。 前回のリクエストでは急いで書いて、大切な詳細等を沢山削ったせいでご迷惑をおかけしました。今回はちゃんと詳細に送らせて頂きます！💦  \n\n【使用用途】としては色々な場所(discord、LINE)等のアイコン、壁紙なんかに使わせて頂けたら、喜びます！\n\n 【肌の色】は\"緑色\"(濃くても薄くてもおk) \n【髪の色】は\"グレーに近い色\"でお願いしたいです！ \n【服の色】は\"上着は白色\"で\"下に着ている黒色\" ズボンは\"藍鉄色\"に近くて大丈夫です！ベルトも\"黒\"なんかでいいです！ \n【靴】は参考資料の方に貼ってある作業靴をそのまま履かせてくれたら、嬉しいです！ \n\n 【特徴】は\"ボサボサの髪\"と\"トレードマークの赤いバンダナ\"。\"腕が太く\"、\"胸もでかい\"、\"肩が常に出て\"、他人の目を気にしない。\"仕事傷もよくある\"事です！  \n\n【構図】として頼みたいのは前に描いて頂いたような1枚の絵にいっぱい描いてくれると嬉しいです！\n 仕事をしている姿(ハンマーを握って、鉄を打つ姿) \nコーヒーを持ったまま、寝ぼけてる(だらしない姿で) \nブタの貯金箱にお金を入れる姿 インスタント麺を啜る姿 \nサボテン(名前はサボン)を机に置いて、見つめる姿\n 布団を抱きしめて寝る姿\n 椅子に寄りかかって寝る姿 等\nを描いて頂けたら、嬉しいです！もし、もっと描いてくださるなら、ヤサイさんにおまかせする形でよろしいでしょうか💦  \n\n【性格】なども書かせて頂きます！ 家事はからっきしで料理もできない。昼はほぼインスタント麺。人間関係は仕事以外だと特になく。サボテンの\"サボン\"をとても可愛がっている。職人としての腕はなかなかのもので、評判もいい。必要な事以外は特に喋らないで、とても無口。でも、心の声はよく喋る。口にくわえてる葉っぱが心を癒すらしい。よく口に出す言葉は「うーん……」「たぶん」「〜ですかね」  \n\nこれでも、資料が足りなければ、また書きます！ヤサイさんの絵をほんとに大好きです！承認して頂いたら、毎日楽しく過ごせます！ご無理のなさらぬ用。気長にお待ちしております！\n\nhttps://x.com/oinktonkatu/status/1957580347438428601?s=46", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@831_ArtMuseum/works/14", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/bfaf5797/uploads/origins/7faa5281-fa1d-4b8a-8692-f67d175d58a2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=010f11339ee9615a8b62d58126f3ede9", "srcset": "https://si.imgix.net/bfaf5797/uploads/origins/7faa5281-fa1d-4b8a-8692-f67d175d58a2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=010f11339ee9615a8b62d58126f3ede9, https://si.imgix.net/bfaf5797/uploads/origins/7faa5281-fa1d-4b8a-8692-f67d175d58a2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=9638c35f5fd8bd9dfa461f133c3c1798 2x, https://si.imgix.net/bfaf5797/uploads/origins/7faa5281-fa1d-4b8a-8692-f67d175d58a2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=f9a25d6295b86475462368ae52b178a6 3x"}, "private": true, "genre": "art", "tipped": false, "creator_id": 744028, "nc": 0}, {"path": "/@831_ArtMuseum/works/13", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/a217df3f/uploads/origins/6b87092a-3055-45cb-b1a4-a966811e3241?bg=%23fff&auto=format%2Ccompress&fm=w