け線、左目の下のほくろ、オレンジ色の目、へそピアス。あまり笑わない飄々とした女の子です。\n\nよろしくお願いします。よろしくお願いします！\n\nhttps://drive.google.com/drive/folders/1wCO2FcXYh5FEbbHGqxdC1VoerRWddQie?usp=sharing", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@831_ArtMuseum/works/9", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/83d3d433/uploads/origins/bf8524e6-22fd-4f95-bf21-87ae1604f6dc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=ed87d9e6570faa534f3c0aa0c3b099d5", "srcset": "https://si.imgix.net/83d3d433/uploads/origins/bf8524e6-22fd-4f95-bf21-87ae1604f6dc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=ed87d9e6570faa534f3c0aa0c3b099d5, https://si.imgix.net/83d3d433/uploads/origins/bf8524e6-22fd-4f95-bf21-87ae1604f6dc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=803eda1640c46bdda7fc211c29506adc 2x, https://si.imgix.net/83d3d433/uploads/origins/bf8524e6-22fd-4f95-bf21-87ae1604f6dc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=2a67a9bcc4585345957e4e9a948b3622 3x"}, "private": true, "genre": "art", "tipped": false, "creator_id": 744028, "client_id": 3412606, "nc": 16}, {"path": "/@831_ArtMuseum/works/8", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 744028, "client_id": 773006, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/ad518602/uploads/origins/04f9d23a-be6b-47ce-97aa-afd36f620a84?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=30fa878b795387beea91f1d6b3a75