うような差別化をしていただけたら嬉しいですが部屋着と同じでも構いません\n背景はベッドと窓から朝日が差し込んでるのが分かれば後は簡略化されていて構いません\n何卒よろしくお願いします\n\nhttps://drive.google.com/drive/folders/10-uRonqxNDLQ52mP9qIVU5NT42Q6SHzG", "nc": 161, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@marz/works/10", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 676227, "client_id": 143355, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/e58259c6/uploads/origins/b6f31280-3ada-4921-93ce-15435a06b894?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7e4c35c9114a0071ebfaa9aa6b4b9082", "srcset": "https://si.imgix.net/e58259c6/uploads/origins/b6f31280-3ada-4921-93ce-15435a06b894?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7e4c35c9114a0071ebfaa9aa6b4b9082, https://si.imgix.net/e58259c6/uploads/origins/b6f31280-3ada-4921-93ce-15435a06b894?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=9549587540f5916f07483d85618f7d10 2x, https://si.imgix.net/e58259c6/uploads/origins/b6f31280-3ada-4921-93ce-15435a06b894?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=6ab94d8a8862c17f69373caf90f8feb3 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/e58259c6/uploads/origins/b6f31280-3ada-4921-93ce-15435a06b894?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=4fbb347e1b7bb012659afe8d6c141999", "srcset": "https://si.imgix.net/e58259c6/uploads/origins/b6f31280-3ada-4921-93ce-15435a06b894?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=4fbb347e1b7bb012659afe8d6c141999, https://si.imgix.net/e58259c6/uploads/origins/b6f31280-3ada-4921-93ce-15435a06b894?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=f8f3db0101ed09347563a474860e6aa8 2x, https://si.imgix.net/e5825