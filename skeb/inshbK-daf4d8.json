はっ。\n\nそんな可愛い顔をして。\n私みたいなやつに見下ろされるなんて、幸せなやつだね？」\n━━━━━━━━━━━━━━━\n台詞の関西弁や言い回しに不自然な点があれば、演技しやすくするためにご自由に調整してください。\n\nよろしくお願いいたします！\n\nhttps://imgur.com/a/ujh1VOy", "nc": 16, "word_count": 0, "transcoder": "audio", "creator_acceptable_same_genre": true}, {"path": "/@inshbK/works/3", "private_thumbnail_image_urls": {"src": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1943264738579992576%2F18R5OQZB.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=7371556ae41d547b1e912bf00f8c4fc8", "srcset": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1943264738579992576%2F18R5OQZB.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=7371556ae41d547b1e912bf00f8c4fc8, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1943264738579992576%2F18R5OQZB.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=62fb8879f94a322a76fa1cf1bd964b5b 2x, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1943264738579992576%2F18R5OQZB.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=8f3326dba3d2998cf2d1c53bb610aa85 3x"}, "private": true, "genre": "voice", "tipped": false, "creator_id": 3327480, "nc": 145}, {"path": "/@inshbK/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "voice", "tipped": false, "creator_id": 3327480, "client_id": 1208572, "vtt_url": "https://fcdn.skeb.jp/uploads/outputs/491984d7-3c06-489c-9a6c-c6a1ae0ae31e?response-content-disposition=inline&Expires=1781875345&Sign