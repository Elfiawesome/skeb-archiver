だいて構いません。また、今後の設定や作品作りの参考にさせていただくことがあります。\n\n\n最後までお読みいただきありがとうございました。金額や内容に問題がありましたら再送要請をお願い致します。\nお手数おかけしますがご検討のほど、よろしくお願いします。\n\nhttps://drive.google.com/drive/folders/10fMH1cspJhzPbRL3vpJo1Hw7uQo9eGIM", "nc": 168, "word_count": 11216, "transcoder": "text", "creator_acceptable_same_genre": true}, {"path": "/@MichalFuyuno/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "novel", "tipped": false, "creator_id": 1360725, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/c4520306/uploads/origins/5fd19b8d-b18d-4d8f-9cc9-a863c17f18dd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=623abeb50a791899b1174649cb0b62a8", "srcset": "https://si.imgix.net/c4520306/uploads/origins/5fd19b8d-b18d-4d8f-9cc9-a863c17f18dd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=623abeb50a791899b1174649cb0b62a8, https://si.imgix.net/c4520306/uploads/origins/5fd19b8d-b18d-4d8f-9cc9-a863c17f18dd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=85b3f308805e428c8a1493bbb9925456 2x, https://si.imgix.net/c4520306/uploads/origins/5fd19b8d-b18d-4d8f-9cc9-a863c17f18dd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a5c65ed2f38395809332addd13f2b983 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/c4520306/uploads/origins/5fd19b8d-b18d-4d8f-9cc9-a863c17f18dd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e95fe92758fd997188d48e47d33ccbb9", "srcset": "https://si.imgix.net/c4520306/uploads/origins/5fd19b8d-b18d-4d8f-9cc9-a863c17f18dd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e95fe92758fd997188d48e47d33ccbb9, https://si.imgix.net/c4520306/uploads/origins/5fd19b8d-b18d-4d8f-9cc9-a863c17f18dd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=1c61657f24c8fdc0f56ce825375c1c78 2