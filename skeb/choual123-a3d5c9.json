bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a97edb2c8a4a7644429d91031d422b49 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/1bff3bc6/uploads/origins/60e52ff4-f737-4dbb-9e43-42d86f4577fa?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ec61a32bc7f43dbb4c005c68a372eb39", "srcset": "https://si.imgix.net/1bff3bc6/uploads/origins/60e52ff4-f737-4dbb-9e43-42d86f4577fa?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ec61a32bc7f43dbb4c005c68a372eb39, https://si.imgix.net/1bff3bc6/uploads/origins/60e52ff4-f737-4dbb-9e43-42d86f4577fa?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=0c7a64d2c28ed5ae925f85ab0f7d3c78 2x, https://si.imgix.net/1bff3bc6/uploads/origins/60e52ff4-f737-4dbb-9e43-42d86f4577fa?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=fa245056f91149fd4c60a7ad1854f0e1 3x"}, "body": "初めまして、望月ぴの。と申します。シュアル様の素敵なイラストの数々に一目惚れしまして、この度skebを送らせて頂きました。\n\n私のキャラクターのシャチ×ドラゴン「ハル」をお願いしたいです。構図はお任せします。出来れば正面顔か斜め顔でお願いしたいです。\n(構図にもよりますが、可能であれば縦長の構図で膝から少し下辺りまで描いて頂けるととても嬉しいです。)\n\nシュアル様の過去の作品ですとこちらの2枚のイラストの雰囲気が大変好みです。\nhttps://x.com/choual123/status/1710977004244455697?t=k94hb7DeTDlxViLBaSp5ug&s=19\n\nhttps://x.com/choual123/status/1722946702423007631?t=sT25jcLOnjO82a-hMt34Lg&s=19\n\nまた、ここから先は”もし可能であれば”で大丈夫なのですが、\nこのキャラクターのために踊り子のような衣装をデザインして頂き、その衣装を着用したハルのイラストを描いて頂くことは可能でしょうか。\n\n(※私は衣装を描いたりデザインするのが苦手で着衣イラストを描くことができないため、いつか衣装を着たハルのイラストを誰かに依頼したいと思っておりました。)\n\n参考資料として私の大好きな作品「ファイアーエムブレム」のキャラクターが着用している踊り子衣装のリンクを貼らせて頂きます。 ⬇\n\nhttps://share.google/7QZebrwZ0DYvZ2guN\n\n全体的に露出度が高く、ユラユラ揺れるような布が付いているイメージです。所々、素肌に金属の輪っかやHベルトのようなものが付いています。\n(踊り子というと口元を隠しているような衣装もありますが、口元は隠さないで頂けると助かります。)\nハルは、お腹や太ももの模様が特徴的なのですが、着衣することで模様が隠れてしまっても全然構いません！\n\nまた、納品時のpsdデータに\n・完成イラスト(宛名あり)\n・完成イラスト(宛名なし)\n・キャラ単体のイラストの透過png\nがありますと嬉しいです。\n\n初めての依頼にも関わらず要望が多く申し訳ございません。内容的に難しい場合は「再送依頼」または「キャンセル」でお願い致します。\n\nハルの資料は『最新版(一番正確)』を参考にして頂けますと助かります。\n\nhttps://drive.google.com/drive/folders/1IbtlaJePAQDYrcuDjOiIOwMO_jMvrlea", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@choual123/works/12", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/c4127dc4/uploads/origins/82187940-cfed-4b28-9972-5c2172aa323e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=615f6056df5810bc5877cd942e0e8dae", "srcset": "https://si.imgix.net/c4127dc4/uploads/origins/82187940-cfed-4b28-9972-5c2172aa323e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=615f6056df5810bc5877cd942e0e8dae, https://si.imgix.net/c4127dc4/uploads/origins/82187940-cfed-4b28-9972-5c2172aa323e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=f6e274ca4881166a615a486ac59418c1 2x, https://si.imgix.net/c4127dc4/uploads/origins/82187940-cfed-4b28-9972-5c2172aa323e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=1e856245d4c825f3977caf60d48e0172 3x"}, "private": true, "genre": "art", "tipped": false, "creator_id": 666380, "client_id": 1194232, "nc": 144}, {"path": "/@choual123/works/11", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 666380, "client_id": 505617, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/072766f1/uploads/origins/8ed2fced-f5ba-432b-9e2b-3b81202370a1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1a0c6b163bc48554eb223ba1de40b901", "srcs