ormat%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e292cf724e2aa403111f097f73500609", "srcset": "https://si.imgix.net/6cee4dad/uploads/origins/497a1588-03c9-4ec4-b050-78a3065ce57e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e292cf724e2aa403111f097f73500609, https://si.imgix.net/6cee4dad/uploads/origins/497a1588-03c9-4ec4-b050-78a3065ce57e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=627453fd1f43a1f7cfa86844579a0782 2x, https://si.imgix.net/6cee4dad/uploads/origins/497a1588-03c9-4ec4-b050-78a3065ce57e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=4341211448e39d64331dc09a380c908c 3x"}, "body": "はじめまして。Xにて作品を拝見し、雰囲気やデザインがとても素敵で、ぜひお願いしたく依頼させていただきました。\n\nOCのデザインをお願いしたいです。\n\n黒髪で前髪に片目が隠れている黒猫の少女です。華奢で細身の少女体型で、現在は一見すると普通の少女のような佇まいですが、過去に生物兵器として作られた存在という背景があります。感情表現は乏しく基本は無表情で、笑うことはほとんどありませんが、根は純粋な性格です。\n\nヤンデレ気質で、作り出したマスターについての記憶はありませんが、理由のない強い忠誠心と執着を抱いています。現在もマスターの存在を探し続けています。\n\n全体的に暗く儚い雰囲気で、無機質さと危うさ、一途さが伝わるデザインにしていただけますと嬉しいです。衣装や細かな装飾はお任せいたします。\n\n使用用途は、個人鑑賞、クレジット付きでのSNS投稿（X・Discord等のアイコン含む）、今後の依頼時の参考資料としての使用を考えています。また、本キャラクターデザインをもとに個人利用の範囲でグッズを作らせていただきたいと考えています。\n\nご検討いただけますと嬉しいです。よろしくお願いいたします。", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@daidaihuku_sub/works/14", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3913180, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/7f11d94c/uploads/origins/d8fea544-454f-4d6e-910a-a9d6c5b48b18?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=769c3686b97535422d69107598a3ac1d", "srcset": "https://si.imgix.net/7f11d94c/uploads/origins/d8fea544-454f-4d6e-910a-a9d6c5b48b18?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=769c3686b97535422d69107598a3ac1d, https://si.imgix.net/7f11d94c/uploads/origins/d8fea544-454f-4d6e-910a-a9d6c5b48b18?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=383281ffcfcb892eccc3fb8805b4212e 2x, https://si.imgix.net/7f11d94c/uploads/origins/d8fea544-454f-4d6e-910a-a9d6c5b48b18?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=9c2543e8a7ba90d36c926463d01fd527 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/7f11d94c/uploads/origins/d8fea544-454f-4d6e-910a-a9d6c5b48b18?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=55289a1f78f5e90221094836407b98b2", "srcset": "https://si.imgix.net/7f11d94c/uploads/origins/d8fea544-454f-4d6e-910a-a9d6c5b48b18?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=55289a1f78f5e90221094836407b98b2, https://si.imgix.net/7f11d94c/uploads/origins/d8fea544-454f-4d6e-910a-a9d6c5b48b18?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=95349e2ff1f0c26e5b79937c50003306 2x, https://si.imgix.net/7f11d94c/uploads/origins/d8fea544-454f-4d6e-910a-a9d6c5b48b18?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=0ade2012cd023332e1db14a662b1ad1e 3x"}, "body": "だいだいふく 様  \n\nはじめまして。 \nこれからゲーム実況をメインにYouTube活動を予定している者です。以前からXにて、モチーフ元を最大限に生かした唯一無二のキャラデザが大好きで、この度リクエストをお送りいたしました。  ご縁ございましたら、下記のイラストの制作をご検討いただけますでしょうか。  \n\n┈┈┈┈┈\n\n〖 依頼内容 〗 \n\n活動用の＂キャラクターデザイン＂の制作\n\n┈┈┈┈┈\n\n〖 使用用途 〗\n・活動用のベースとなるデザインの使用\n・YouTube/X(旧Twitter)等のSNSへの投稿\n・アイコンやヘッダー\n・skebなどイラスト依頼時の資料\n\n┈┈┈┈┈\n\n〖 人物イメージ資料 / 要素 〗  \n\n誕生日￤2/21\n誕生色(イメージカラー)￤ライムライト - #FFF799\n誕生花￤ネモフィラ(黒)‪\n誕生石￤角\n誕生魚￤ネズミザメ\n\nイメージ絵文字￤🕯/👻🦴🦈🌼\n\n‪✿ 髪色とヘアアレンジ\nベースは白髪🤍、サブカラーで灰色🩶、差し色はライムライト💛\n髪型とアレンジありで内容はお任せ。\n(三つ編み/お団子/メッシュ/グラデ/インナーなど)\n\n‪✿ 性別は＂中性＂的\nどちらかに寄っていただいても問題ありません。\n\n‪✿ ＂角＂あり［以下仮案］\n①👻(幽霊)要素として、だいだいふく様のOCである真白？さんのような半透明な角。\n②もしくは通常の角に、手足が半透明/欠損/壊死などで👻要素。\n\n‪✿ 衣装［以下仮案］\n①🦴(骨)要素として、OCである輝星くんの肋骨風な衣装。\n② 🦴と🦈(ネズミザメ)要素として、\"衣装\"で\"尾ビレの骨\"の装飾。\n\nだいだいふく様のOCお衣装ですと、\n輝星くんと和菓子組が特に好きです🥰\n\n┈┈┈┈┈\n\n別名義で歌ってみたメインの活動も行っており、そちらの姿と \"対比する\" デザインだと嬉しいです。(資料URLあり🦚)\n\n┈┈┈┈┈\n\n［仮案］の採用有無やデザイン変更など、全てお任せいたします。\n私自身、要素 盛り盛りなキャラデザ大好物ですので、ぜひだいだいふく様の筆がのる形で、新たなOC/PCを描いていただければなと存じます。\n\n不備・金額不足等ございましたら再送いただけますと幸いです。  ご多忙の折 恐れ入りますが、ご検討の程よろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/1f4FMvl1FgSIS1Ph3M3OS6_Xzqds1MIPd", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@daidaihuku_sub/works/13", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3913180, "client_id": 3858736, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/df3d5d98/uploads/origins/42df2912-4553-4a34-b839-b1deb6a0395d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=35bb272ee77c84158161787388dbb094", "srcset": "https://si.imgix.net/df3d5d98/uploads/origins/42df2912-4553-4a34-b839-b1deb6a0395d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=35bb272ee77c84158161787388dbb094, https://si.imgix.net/df3d5d98/uploads/origins/42df2912-4553-4a34-b839-b1deb6a0395d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=7b9df1106d19581239f0437857a5260c 2x, https://si.imgix.net/df3d5d98/uploads/origins/42df2912-4553-4a34-b839-b1deb6a0395d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=01da71902baa007ab0f40631b7e85190 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/df3d5d98/uploads/origins/42df2912-4553-4a34-b839-b1deb6a0395d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d9c5a955ba35a313c40d1be395a70509", "srcset": "https://si.imgix.net/df3d5d98/uploads/origins/42df2912-4553-4a34-b839-b1deb6a0395d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d9c5a955ba35a313c40d1be395a70509, https://si.imgix.ne