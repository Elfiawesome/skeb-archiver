hopping.c.yimg.jp/i/n/suteteko_im014_1\n\n・可能であればレオタードの上から服を羽織っているようなデザインでなくレオタードをベースにして服のパーツや装飾を追加していくようなデザインにして欲しいです\n\n・使用用途ですが他の人に依頼する際の服装の参考画像して使用したいです\n\n以上です", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Nanami096usagi/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3156667, "client_id": 90411, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/08d91034/uploads/origins/3411cba5-b4f8-4d0e-ba19-4e1edb507a8c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6da2449d5198f49d8aaae11570b66ede", "srcset": "https://si.imgix.net/08d91034/uploads/origins/3411cba5-b4f8-4d0e-ba19-4e1edb507a8c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6da2449d5198f49d8aaae11570b66ede, https://si.imgix.net/08d91034/uploads/origins/3411cba5-b4f8-4d0e-ba19-4e1edb507a8c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=9d5bfb43ac2084b6fce9625840999f07 2x, https://si.imgix.net/08d91034/uploads/origins/3411cba5-b4f8-4d0e-ba19-4e1edb507a8c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=10e4bc54b82d2ceefc01b96e8fd8e0d2 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/08d91034/uploads/origins/3411cba5-b4f8-4d0e-ba19-4e1edb507a8c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=07c594e280f0e5c182ef1c953b3626e3", "srcset": "https://si.imgix.net/08d91034/uploads/origins/3411cba5-b4f8-4d0e-ba19-4e1edb507a8c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=07c594e280f0e5c182ef1c953b3626e3, https://si.imgix.net/08d91034/uploads/origins/3411cba5-b4f8-4d0e-ba19-4e1edb507a8c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=2356619037628c4d4e1077d2258e48c3 2x, https://si.imgix.net