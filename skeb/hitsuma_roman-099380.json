ly6yOMdasSI42b8RmmjAgMVqVMi0VK?usp=sharing\n\n○キャラクターについて\n歌とゲームが好きなお狐Vtuberです。\n涙ぼくろは向かって右で人の耳はないです。\nモチーフは🦊と🪭です。\n\n○使用用途\nSNSアイコン、ヘッダー\nおはV、サムネイル(画像や文字重ねる等の加工)\n収益化済みの配信サイト(Twitch)での使用\nネットプリント、サブスク限定壁紙\n\n-----\n\n上記の使用用途のなかで難しいものがありましたら再送等、ご教授いただけますと幸いです。\n\nもしも背景も描いていただけるのであれば背景と人物を分けた画像もいただけると幸いです。\n\nお忙しいところ恐縮ですが、何卒ご検討のほどよろしくお願いいたします！", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@hitsuma_roman/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2245826, "client_id": 2536621, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/06b4da68/uploads/origins/422d3f1b-a13c-4e2b-9f0f-f5c225824cdb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=26387cc7ce7a8149ac6f003cdee0d6cb", "srcset": "https://si.imgix.net/06b4da68/uploads/origins/422d3f1b-a13c-4e2b-9f0f-f5c225824cdb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=26387cc7ce7a8149ac6f003cdee0d6cb, https://si.imgix.net/06b4da68/uploads/origins/422d3f1b-a13c-4e2b-9f0f-f5c225824cdb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=bdf102f4a114df15577347dd1fbbc876 2x, https://si.imgix.net/06b4da68/uploads/origins/422d3f1b-a13c-4e2b-9f0f-f5c225824cdb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=0e5e613a9d4e26a16b22a3d29d01d07f 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/06b4da68/uploads/origins/422d3f1b-a13c-4e2b-9f0f-f5c225824cdb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d0a2b43e815d9bf9d9be7854a55f749e", "srcset": "https://si.imgix.net/06b4da68/uploads/origins/422d3f1b-a13c-4e2b-9f0f-f5c225824cdb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d0a2b43e815d9bf9d9be7854a55f749e, https://si.imgix.net/06b4da68/uploads/origins/