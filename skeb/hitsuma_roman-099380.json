61-2d99-4512-9014-8e70b30466ee?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=57ab49c2089aec411a74beca576fc0c2 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/78a026fd/uploads/origins/74b82d61-2d99-4512-9014-8e70b30466ee?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=bd71f77c72912ce01696d660c9102db0", "srcset": "https://si.imgix.net/78a026fd/uploads/origins/74b82d61-2d99-4512-9014-8e70b30466ee?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=bd71f77c72912ce01696d660c9102db0, https://si.imgix.net/78a026fd/uploads/origins/74b82d61-2d99-4512-9014-8e70b30466ee?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=b0e5d51b94e243480d84898485ad9bb1 2x, https://si.imgix.net/78a026fd/uploads/origins/74b82d61-2d99-4512-9014-8e70b30466ee?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=0ea1f56a809bbcd1b601e245afa02a99 3x"}, "body": "初めまして。\nVtuberとして配信活動をしている狐尾 うにと申します。\n新着イラストを拝見し、大変素敵な絵柄に惹かれましてぜひイラストをお願いしたいと思い、\nリクエスト失礼します！\n\n【依頼内容】\n狐尾 うにのイラストの制作をお願いします。\n・LOLのアーリというキャラの「覚醒せし伝説のアーリ」スキンの衣装を着ているわたしをお願いしたいです。\n参考：https://www.leagueoflegends.com/ja-jp/champions/ahri/\n・ポーズや構図はお任せしますが、全体的にセクシーな感じですと嬉しいです。\nまた、目線はこちら（画面側）を向いていると嬉しいです。\n・髪型は3種ありますがウルフでお願いしたいです。\n・両目元の赤ほくろがチャームポイントです。\n\n【使用用途（予定）】\n・Youtubeのサムネや動画内での使用（未収益化）\n・Twitchの配信内やOP等での使用（収益化済み）\n・Xでのツイートやタグツイートへの添付\n・ネットプリント配布やサブスク特典など\n\n【キャラクター詳細】\n・両目元に赤いほくろがある、九尾の狐です。\n・人耳はなく、狐耳のみです。\n\n【その他】\n・サムネでの使用がメインになるので、髪や耳が切れないようにしていただけますと嬉しいです。\n\n内容や金額が合わない場合にはお手数ですが再送をお願いします。\nぜひご検討をよろしくお願い致します！\n\nhttps://drive.google.com/drive/folders/18-_wgD4iVW5y12b8mMkAr5aIWkELMkkZ?usp=drive_link", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@hitsuma_roman/works/8", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2245826, "client_id": 3810771, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/df53e522/uploads/origins/cbcb217d-5334-4991-b2d9-23ac097f4f53?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a0bd351fa46496e206b197bb46c5379b", "srcset": "https://si.imgix.net/df53e522/uploads/origins/cbcb217d-5334-4991-b2d9-23ac097f4f53?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a0bd351fa46496e206b197bb46c5379b, https://si.imgix.net/df53e522/uploads/origins/cbcb217d-5334-4991-b2d9-23ac097f4f53?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=98c93fc7cb6658e1e429e0bdbd64801f 2x, https://si.imgix.net/df53e522/uploads/origins/cbcb217d-5334-4991-b2d9-23ac097f4f53?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e5deadb65c35b784da374f513df60e31 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/df53e522/uploads/origins/cbcb217d-5334-4991-b2d9-23ac097f4f53?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0d5a6034a54ccceafd5baf70a783bbee", "srcset": "https://si.imgix.net/df53e522/uploads/origins/cbcb217d-5334-4991-b2d9-23ac097f4f53?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0d5a6034a54ccceafd5baf70a783bbee, https://si.imgix.net/df53e522/uploads/origins/cbcb217d-5334-4991-b2d9-23ac097f4f53?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=a994ea4ca21ff302ebc8f5d2ad544306 2x, https://si.imgix.net/df53e522/uploads/origins/cbcb217d-5334-4991-b2d9-23ac097f4f53?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=38d264118503b4a157d6830432774a79 3x"}, "body": "こんにちは！\n\n\nSkebの「新作」コーナーであなたの作品を見かけ、その画風がとても気に入りました。そこで、私のオリジナルキャラクター「ルリ」をビーチを舞台に描いていただけないかと思い、お願いしたくなりました。\n\n\nサンドレスとサンハット姿で描いていただけると嬉しいのですが、もしそれが難しい場合は、カジュアルなビーチウェ