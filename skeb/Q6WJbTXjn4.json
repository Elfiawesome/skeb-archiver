ついて\nライブ中にファンとハートを作るようなレスをしているポーズを希望いたします。\nURLを記載しますので、参考にしていただければと思います。\nhttps://share.google/c41Y2I8fG8sn1IxxT\n参考URLでは右斜め前の方とハートを合わせる形になっています。この構図でお願いいたします。\n\n【使用用途】\nメインはフラスタに添えるイラストとして使う予定です。\n次点でSNSへのアップ、アイコン、自作グッズの作成に使用する予定です。\n※商用利用はいたしません。\n※フラスタや自作グッズにする際にキャラを切り抜くなどの加工をする可能性がございます。\n\n【納品形式】\n画像サイズはA2縦、保存形式は「png」でお願いいたします。\n200〜250dpi程度の解像度でお願いいたします。", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Q6WJbTXjn4/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3778662, "client_id": 3888488, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/3dabdee9/uploads/origins/ce84e642-dcef-4100-b4d6-31d548ddcad6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=db9fedddbb0a8ce19979cfb4b194439d", "srcset": "https://si.imgix.net/3dabdee9/uploads/origins/ce84e642-dcef-4100-b4d6-31d548ddcad6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=db9fedddbb0a8ce19979cfb4b194439d, https://si.imgix.net/3dabdee9/uploads/origins/ce84e642-dcef-4100-b4d6-31d548ddcad6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=02fc6d85a2da9eb47a5e470f38c52402 2x, https://si.imgix.net/3dabdee9/uploads/origins/ce84e642-dcef-4100-b4d6-31d548ddcad6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=12d2aacfbdcc1ffbf33dd343a5e10344 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/3dabdee9/uploads/origins/ce84e642-dcef-4100-b4d6-31d548ddcad6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=7442bd2a00ba9224589e47f79dce2c93", "srcset": "https://si.imgix.net/3dabdee9/uploads/origins/ce84e642-dcef-4100-b4d6-31d548ddcad6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=7442bd2a00ba9224589e47f79dce2c93, https://si.imgix.net/3dabdee9