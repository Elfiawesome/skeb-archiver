衣装についてはリゼ様と同じようなゴシック衣装の半脱ぎの状態でお願いできればと思います）\n\nまた、可能であれば挿入前、ピストン中、中出し後等の差分やセリフ等もお願いできればと思います。\n\n以上です。\n何卒よろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/1Ef8B5vgKK6sqliAdI2yt24dP3xSapuyl", "nc": 32, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@nanagi_ship4/works/140", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 341013, "client_id": 40098, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/4fa105f8/uploads/origins/b1aa516b-28bc-42f0-a0b5-564d67ab15a9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0e51c953c6cd0330cf7f957d0335b253", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/4fa105f8/uploads/origins/b1aa516b-28bc-42f0-a0b5-564d67ab15a9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a2e82ebe5e0b49c61254af0d39fc4f7e", "src_set": ""}, "body": "ドラゴンメイド・パルラを描いて頂けますか？\n髪を下ろし、スカートを捲り上げて、ご主人様にパンツを全部見せるイラストをお願いします。\n以前に見かけたパルラの漫画が可愛かったのでリクエストさせて頂きました。よろしくお願いします。", "nc": 49, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@nanagi_ship4/works/139", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/3b5cf494/uploads/origins/c1ead687-1c29-4326-8900-c1d274c621f7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=ed2ea706d0e0545bdd7123f5bf914468", "src_set": ""}, "private": true, "genre": "art", "tipped": true, "creator_id": 341013, "client_id": 0, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 49, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@nanagi_ship4/works/138", "private_thumbnail_image_ur