anga", "nc": 57, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Emu528_/works/10", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3727570, "client_id": 3007284, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/21d5ebfd/uploads/origins/c908f0b0-61e4-4808-933a-2fe4964be41c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=118a7b31fc7ccbaaef65f401c58cb3a4", "srcset": "https://si.imgix.net/21d5ebfd/uploads/origins/c908f0b0-61e4-4808-933a-2fe4964be41c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=118a7b31fc7ccbaaef65f401c58cb3a4, https://si.imgix.net/21d5ebfd/uploads/origins/c908f0b0-61e4-4808-933a-2fe4964be41c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b70e34fda633311f4d125d7ebf5afbce 2x, https://si.imgix.net/21d5ebfd/uploads/origins/c908f0b0-61e4-4808-933a-2fe4964be41c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=dabbe491062979a85151e6ea57c709fd 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/21d5ebfd/uploads/origins/c908f0b0-61e4-4808-933a-2fe4964be41c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=29dd93436cb25076aa002310b59c0e4b", "srcset": "https://si.imgix.net/21d5ebfd/uploads/origins/c908f0b0-61e4-4808-933a-2fe4964be41c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=29dd93436cb25076aa002310b59c0e4b, https://si.imgix.net/21d5ebfd/uploads/origins/c908f0b0-61e4-4808-933a-2fe4964be41c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=c6d0663ad9950023aaec87d8e4558a68 2x, https://si.imgix.net/21d5ebfd/uploads/origins/c908f0b0-61e4-4808-933a-2fe4964be41c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=9902de3cde47ade