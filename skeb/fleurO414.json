での投稿や配信・動画のサムネイル、メンバーシップの特典の待ち受け画像などへの使用）です。\n\n何卒ご検討の程よろしくお願い致します。\n\nhttps://www.dropbox.com/scl/fo/gel9ee3fd47om53iv0upz/ACG55g3OzCvN-62NSigHj9w?rlkey=js43x5a5144a945829401jgis&st=3ej6k7zu&dl=0", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@fleurO414/works/41", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/68a57810/uploads/origins/54dab357-95d0-4048-a26b-92d1ce434570?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=c50b74d46b772a76730342db440aef7e", "src_set": ""}, "private": true, "genre": "art", "tipped": false, "creator_id": 2984689, "client_id": 3599057, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 17, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@fleurO414/works/40", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/c8cdef2f/uploads/origins/fc88407c-d55c-47c4-b87b-b4cbbceb2043?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=bf19161245294a7cbb2bd345488e11e9", "src_set": ""}, "private": true, "genre": "art", "tipped": false, "creator_id": 2984689, "client_id": 2792635, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 144, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@fleurO414/works/39", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/09ede24b/uploads/origins/937bbcfe-a1b1-4c2b-8076-0061ba40dba6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txts