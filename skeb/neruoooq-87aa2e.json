主に担っていた。\n\n参考資料を資料URLにてGoogleドライブで添付しています。\n \n\n以上です。\n\nもし記載内容に不備や分かりにくい点などございましたら、お手数をおかけしますが再送いただけますと幸いです。\n寧々ねるお様のイラストを心待ちにしております。\n\nよろしくお願いいたします。\n\nボーロ\n\nhttps://drive.google.com/drive/folders/1YYHu2n2MFHs6qeynHmg-9N2Y7KCb2BCS", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 990211, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "げるଳ", "screen_name": "nukoleg", "avatar_url": "https://pbs.twimg.com/profile_images/1960525663913566208/KaFQzeHW.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1278623277267603456/1753853516/1500x500", "appeal_receivable": true, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 120, "skills": [{"genre": "art"}], "banned": false, "nc": 48}, {"id": 1165472, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "斑猫", "screen_name": "han_myoh", "avatar_url": "https://pbs.twimg.com/profile_images/1385663366748807170/bi75RFI_.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1375735023467290628/1619270202/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "art"}], "banned": false, "nc": 0}, {"id": 1314472, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "ボス", "screen_name": "both_original", "avatar_url": "https://pbs.twimg.com/profile_images/1615237234290233345/hq3DqMLw.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1405811484311969796/1758356313/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by