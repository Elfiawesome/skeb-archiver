(ただし目は開いてて欲しい)\n・設定は一応男の娘です。(なのでまつげ不要です)\n・ボトムス部分の服を描く必要があれば、白色の短パンでお願いします。(天使界隈とかでググればどういうものか分かると思います)\n・服の色は資料(つまり白が基調)に準拠していただけると助かります。\n・資料には天使の羽が描いてありますが、これは身体から生えているわけではなく背景のアクセントです。描くかはお任せします。\n・猫耳が付いてますがしっぽは不要です。\n\n描きにくいところなどあればこれを守らなくても大丈夫です。\n以上、よろしくお願いします。\n\nhttps://drive.google.com/file/d/1Dh_RAmd-IpI6D2CC-6rCYm4Rjafiv-yn/view?usp=drivesdk", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@tzsl/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1012348, "client_id": 435804, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/7de9fd3b/uploads/origins/c3c3b4a5-bc68-4954-8dbd-b351a0700d85?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7179dcb31656e49d77d4ca9c86e681a1", "srcset": "https://si.imgix.net/7de9fd3b/uploads/origins/c3c3b4a5-bc68-4954-8dbd-b351a0700d85?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7179dcb31656e49d77d4ca9c86e681a1, https://si.imgix.net/7de9fd3b/uploads/origins/c3c3b4a5-bc68-4954-8dbd-b351a0700d85?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=facec5c5f44382b8fd05282574359530 2x, https://si.imgix.net/7de9fd3b/uploads/origins/c3c3b4a5-bc68-4954-8dbd-b351a0700d85?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=828ce47d384e952d405a1753b7a9fef4 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/7de9fd3b/uploads/origins/c3c3b4a5-bc68-4954-8dbd-b351a0700d85?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c6f950c487926dc0b90e8fcbe5d2189a", "srcset": "https://si.imgix.net/7de9fd3b/uploads/origins/c3c3b4a5-bc68-4954-8dbd-b351a0700d85?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c6f950c487926dc0b90e8fcbe5d2189a, https://si.imgix.net/7de9fd3b/uploads/origins/