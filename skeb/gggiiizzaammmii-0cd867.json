\u65b9\u3084KP\u306b\u5171\u6709\"\u3068\u8003\u3048\u3066\u304a\u308a\u307e\u3059\u3002\n\n\u30ad\u30e3\u30e9\u306e\u898b\u305f\u76ee\u3067\u63cf\u304d\u306b\u304f\u3044\u7b87\u6240\u3084\u308f\u304b\u3089\u306a\u3044\u7b87\u6240\u304c\u3042\u308c\u3070\u7701\u7565\u3057\u3066\u3044\u305f\u3060\u3044\u3066\u69cb\u3044\u307e\u305b\u3093\u3002\n\u69cb\u56f3\u3001\u30dd\u30fc\u30ba\u306a\u3069\u306f\u7279\u306b\u6307\u5b9a\u3042\u308a\u307e\u305b\u3093\u3002\u30ad\u30e3\u30e9\u30af\u30bf\u30fc\u3092\u81ea\u7531\u306b\u89e3\u91c8\u3057\u3066\u63cf\u3044\u3066\u3044\u305f\u3060\u3044\u3066\u5927\u4e08\u592b\u3067\u3059\uff01\n\u4ed6\u8005\u69d8\u306e\u4f9d\u983c\u3067\u3042\u3063\u305f\u3001\u6f2b\u753b\u306e\u8868\u7d19\u306e\u3088\u3046\u306a\u96f0\u56f2\u6c17\u3060\u3068\u5b09\u3057\u3044\u3067\u3059\u3002\n\n\u4e0d\u5099\u3084\u6599\u91d1\u306e\u4e0d\u8db3\u7b49\u304c\u3042\u308a\u307e\u3057\u305f\u3089\u9060\u616e\u306a\u304f\u518d\u9001\u3084\u30ad\u30e3\u30f3\u30bb\u30eb\u3092\u304a\u9858\u3044\u3057\u307e\u3059\u3002\n\u304a\u5fd9\u3057\u3044\u3068\u3053\u308d\u6050\u308c\u5165\u308a\u307e\u3059\u304c\u3001\u3054\u691c\u8a0e\u3044\u305f\u3060\u3051\u308c\u3070\u5e78\u3044\u3067\u3059\uff01\n\n\u30ad\u30e3\u30e9\u306e\u7d30\u304b\u3044\u8a2d\u5b9a\u3001\u8cc7\u6599\u306a\u3069\u306f\u4ee5\u4e0b\u306b\u307e\u3068\u3081\u3066\u3044\u307e\u3059\u3002\n\n\u30102\u4eba\u306e\u8a2d\u5b9a\u3011\n\u30e9\u30a6\u30fc\u30eb\u3068\u6714\u3068\u3044\u30462\u4eba\u3067\u602a\u76d7\u3092\u3057\u3066\u3044\u308b\u3002\n\u30e9\u30a6\u30fc\u30eb\u306f\u5df7\u3092\u9a12\u304c\u3059\u602a\u76d7\u3067\u3042\u308a\u3001\u6714\u306f\u4e00\u5ea6\u898b\u305f\u7d75\u306a\u3089\u306a\u3093\u3067\u3082\u6a21\u5023\u3059\u308b\u3053\u3068\u306e\u3067\u304d\u308b\u8d0b\u4f5c\u5e2b\u3067\u3042\u308b\u3002\n\n\u25b6\ufe0e\u30e9\u30a6\u30fc\u30eb(Raoul)-20\u4ee3(\u5e74\u9f62\u4e0d\u8a73)-\u7537\u6027-165cm\n\u5929\u771f\u721b\u6f2b\u3001\u304a\u6c17\u697d\u3002\u5973\u306e\u5b50\u304c\u3044\u305