format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=113f8552d50190bdb0d0e1a39c21dffd 3x"}, "body": "こんにちは。\n先日、「冬におよぐよ」のヒロイン「陽子」のコミックをリクエストさせていただいた者です。その節はありがとうございました。\n今回は陽子が元カレとのH経験談をその情景とモノローグ付きで杉浦君に語り聞かせるシチュをお願いします。\n盛り込んでいただきたい経験談は以下のようになります。\n\n・彼氏とキスハメし、生中出しを受け入れるラブラブセックスの話\n・ラブホで事後、二人でお風呂に浸かりながらイチャイチャセックスした話\n・危険日だけどお互いムラムラして我慢できず、彼氏の家で朝まで一晩中生セックスした話\n・彼氏にお尻の穴を舐められ、アナルセックスしてアナル中出しされた話\n・杉浦君に披露した『騎乗位で気持ち良くするご奉仕エッチ』を彼氏に仕込まれた話（彼氏の用意したオープンカップ＆オープンクロッチのドエロ下着着用）\n◆ちんちんのデカさやエッチの上手さ等どんな彼氏だったのか説明する脳破壊セリフあり\n◆当時は陽子も彼氏を好きだったからエッチにはノリノリだしエッチを楽しんでいる\n◆NTR感やBSS感をたっぷり盛り込んでください\n\n立て続けの依頼となりますがご検討のほどよろしくお願いします。", "nc": 41, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@fukigentei/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "comic", "tipped": false, "creator_id": 3640007, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/68c8a950/uploads/origins/6c7a50f8-247f-4b82-b196-320dca8c1481?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=082bef27c838db3e29a5c3e61197653e", "srcset": "https://si.imgix.net/68c8a950/uploads/origins/6c7a50f8-247f-4b82-b196-320dca8c1481?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=082bef27c838db3e29a5c3e61197653e, https://si.imgix.net/68c8a950/uploads/origins/6c7a50f8-247f-4b82-b196-320dca8c1481?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=05513b4af463c822c5aa7d7ee19f82c2 2x, https://si.imgix.net/68c8a950/uploads/origins/6c7a50f8-247f-4b82-b196-320dca8c1481?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=292f9b66ee872a6d87fbe5b1ad98cacb 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/68c8a950/uploads/origins/6c7a50f8-247f-4b82-b196-320dca8c1481?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f202cdcd6c7cf6bb274e0e072c51f