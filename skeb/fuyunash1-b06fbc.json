le.com/drive/folders/1j6HgY4pt-naJbnxs8YeAi8lHfqBkVInO?usp=sharing", "nc": 161, "word_count": 0, "transcoder": "video", "creator_acceptable_same_genre": false}, {"path": "/@fuyunash1/works/8", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3610419, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/79384f71/uploads/origins/29a399cd-b162-4c41-8a41-566b1345788d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a119d692bad3393f7cec21537c0871f7", "srcset": "https://si.imgix.net/79384f71/uploads/origins/29a399cd-b162-4c41-8a41-566b1345788d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a119d692bad3393f7cec21537c0871f7, https://si.imgix.net/79384f71/uploads/origins/29a399cd-b162-4c41-8a41-566b1345788d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=01b1eb3a666c6b8642eac76b2b5eb0d0 2x, https://si.imgix.net/79384f71/uploads/origins/29a399cd-b162-4c41-8a41-566b1345788d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=19216048997d2cd4ebd427bac213b303 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/79384f71/uploads/origins/29a399cd-b162-4c41-8a41-566b1345788d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ee5472c23dad858be2db91c98342b69d", "srcset": "https://si.imgix.net/79384f71/uploads/origins/29a399cd-b162-4c41-8a41-566b1345788d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ee5472c23dad858be2db91c98342b69d, https://si.imgix.net/79384f71/uploads/origins/29a399cd-b162-4c41-8a41-566b1345788d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=f3d6a8673af636f7f13f7fa1f906bb85 2x, https://si.imgix.net/79384f71/uploads/origins/29a399cd-b162-4c41-8a41-566b1345788d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=e0acf6d6f2448be78224437682c85a16 3x"}, "body": "こんにちは。いつも素晴らしい作品をありがとうございます。\n早速ですが、下記リクエスト内容となります。\n\n「氷の魔法」の女の子がアイスクリームをこぼして慌てている様子をお願いできますでしょうか。\n\n・描写範囲は元のイラストと同じ、太ももあたりから頭まで。\n・暑さの為、服やインナーが張り付いている状態\n・手に持ったアイスクリームが溶けてこぼれて、ちょっと胸やお腹にかかっている状態\n・場所は喫茶店の中、もしくはパラソルの下などの涼しいところ\n\n以上になります。\nその他についてはお任せします。\nご検討の程、よろしくお願いいたします。", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@fuyunash1/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3610419, "client_id": 1887057, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/8c8fd002/uploads/origins/c96e1061-9e2c-48d5-99c0-4c41ad10a61d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=dcd31fd92180d1363090e14d1d81e85e", "srcset": "https://si.imgix.net/8c8fd002/uploads/origins/c96e1061-9e2c-48d5-99c0-4c41ad10a61d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=dcd31fd92180d1363090e14d1d81e85e, https://si.imgix.net/8c8fd002/uploads/origins/c96e1061-9e2c-48d5-99c0-4c41ad10a61d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=58724ebf625ff86069d36e4354572f23 2x, https://si.imgix.net/8c8fd002/uploads/origins/c96e1061-9e2c-48d5-99c0-4c41ad10a61d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=65dd458df7db31cccdd9fd91b06c3575 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/8c8fd002/uploads/origins/c96e1061-9e2c-48d5-99c0-4c41ad10a61d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=fd95f99525c8f06dec4f6d92f4a78295", "srcset": "https://si.imgix.net/8c8fd002/uploads/origins/c96e1061-9e2c-48d5-99c0-4c41ad10a61d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=fd95f99525c8f06dec4f6d92f4a78295, https://si.imgix.net/8c8fd002/uploads/origins/c96e1061-9e2c-48d5-99c0-4c41ad10a61d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=b971136410779fcd61483bada0a6aab5 2x, https://si.imgix.net/8c8fd002/uploads/origins/c96e1061-9e2c-48d5-99c0-4c41ad10a61d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=cd51e313bf60033e94a61b89832ea4f8 3x"}, "body": "こんにちは、参考資料の中の2人の女の子は私のOCで、あなたに描いてもらいたい。  黒い女の子がアリックスで、白い女の子がキラです。この2人は恋人同士で、アリクスが支配的で、キラは一般的にとても従順です。シナリオでは、2人は全裸でシャワーを浴び、シャワーをかけて水をかけている。アリックスはキラの背中を壁に押し付けて驚かせる。アリクスは片方の手をキラのアソコに入れて指を入れ、もう片方の手はキラの腰を愛撫する。キスをしながらオッパイを押し付け合う。キラは、あなたが理にかなっていると感じることを、彼女の手で何でもすることができます。イメージとしては、アリックスがキラに指を入れてオーガズムを起こさせる。オーガズムに達したキラが愛液を吹き出すところを見たい。可能であれば、アリクスのアソコも興奮しているので、とても濡れていて、愛液が垂れていることも見せてほしい。その他、記載されていないことは何でも結構です。私のリクエストを検討していただき、ありがとうございます。\n\nhttps://postimg.cc/gallery/vyGbRNyM", "nc": 177, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@fuyunash1/works/6", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/155e4de2/uploads/origins/353f85a1-843e-4b86-b749-c9d47a561c32?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=adadf576b9373f0836053755e33e5fb8", "srcset": "https://si.imgix.net/155e4de2/uploads/origins/353f85a1-843e-4b86-b749-c9d47a561c32?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=adadf576b9373f0836053755e33e5fb8, https://si.imgix.net/155e4de2/uploads/origins/353f85a1-843e-4b86-b749-c9d47a561c32?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=e54c5dc01f9b35096f6cf9058e39b53f 2x, https://si.imgix.net/155e4de2/uploads/origins/353f85a1-843e-4b86-b749-c9d47a561c32?bg=%23fff&auto=format%2C