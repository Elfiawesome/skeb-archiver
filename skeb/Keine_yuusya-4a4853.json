際より賢く見せようと努めるが、すぐに恥ずかしがり屋。\n\n二人はロマンチックなカップルで、お互いをとても愛し合っています！愛情深く、お互いにべったりです。ヘベルは身体的な接触を好むため、無意識のうちにヴァレリーを動揺させてしまいます。\n\n二人が笑顔で抱き合っているような絵が理想ですが、自由に描いてください！もし報酬額が不十分だと感じたら、再交渉するかキャンセルしてください！ご配慮ありがとうございます！！！\n\nhttps://drive.google.com/drive/folders/1dozoc-XPWknoHBIa49NJnxTUufdm3jbq?usp=sharing", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Keine_yuusya/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3916446, "client_id": 2076369, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/f39c97c9/uploads/origins/18e9aaba-3a85-481d-a06d-202cb9ecfc15?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=19c79ab1dbad2d0ddfff4f7f68ba761b", "srcset": "https://si.imgix.net/f39c97c9/uploads/origins/18e9aaba-3a85-481d-a06d-202cb9ecfc15?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=19c79ab1dbad2d0ddfff4f7f68ba761b, https://si.imgix.net/f39c97c9/uploads/origins/18e9aaba-3a85-481d-a06d-202cb9ecfc15?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=7eec37f4a284fcac896411598a0a2848 2x, https://si.imgix.net/f39c97c9/uploads/origins/18e9aaba-3a85-481d-a06d-202cb9ecfc15?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=faf7ecbbf157f0e8ace306aed991c7e6 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/f39c97c9/uploads/origins/18e9aaba-3a85-481d-a06d-202cb9ecfc15?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=307d5ca2cfc11fa0562375039dc7880d", "srcset": "https://si.imgix.net/f39c97c9/uploads/origins/18e9aaba-3a85-481d-a06d-202cb9ecfc15?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=307d5ca2cfc11fa0562375039dc7880d, https://si.imgix.net/f39c97c9/uploads/origins/18e9aaba-3a85-481d-a06d-202cb9ecfc15?bg=%23fff&auto=