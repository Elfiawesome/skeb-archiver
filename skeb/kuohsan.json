otal_appeals_count": 0, "received_works": [{"path": "/@kuohsan/works/44", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 694060, "client_id": 1416113, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/d1ca39aa/uploads/origins/318f89fe-7f26-4a1b-8a2c-a4d3a431901a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0ce39490a424bb5231162d9df48acb69", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/d1ca39aa/uploads/origins/318f89fe-7f26-4a1b-8a2c-a4d3a431901a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f75348c19b716adeb45b8654047eaabb", "src_set": ""}, "body": "こんにちは、Kuohsan！私のOCであるユリアと、彼女とスカタハの18歳の息子であるウアタハの共演をお願いしたいです。シーンとしては、ユリアとウアタハに、自分と弟のユリウスが子供の頃の古い肖像画を見てもらいたい。ユリアは、ウアサハが変わる前のユリウスを思い出しながら、その話題について息子に楽しそうに話す。ユリウスとユリアには公式な子供のデザインはないので、まだ描いてほしい！最後に、新しい服装のユリアとウアサハを自由に描いてください。あなたの服装のデザインが好きなので、描いてもらえると嬉しいです！\n\nhttps://imgur.com/a/PLjLWvx", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@kuohsan/works/43", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 694060, "client_id": 1622498, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/69072aed/uploads/origins/5881cc6f-3bcd-4c8c-9fbb-173f01cc2f3c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a41bacca64eae0b60ac68a2d0a15759e", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/69072aed/uploads/origins/5881cc6f-3bcd-4c8c-9fbb-173f01cc2f3c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=059300725e39feb6d2cd0d37a5882b6f", "src_set": ""}, "body": "再びこんにちは！アチューンド・レイフにとても興奮しているので、彼をモデルにした作品をお願いしたいです。\n\nリューとレイフが一緒にアーチェリーの練習をしているところをお願いしたいです。リューは真剣に訓練に取り組んでいて、父親と同じように懸命に訓練しています。レイフはリューの献身と技術を誇りに思っている。FEHのレイフのアクセサリーによると、彼は矢を口にくわえて素早く射る準備をしている。リューはこれを素晴らしいアイデアだと思うので、このように矢をくわえているところを描いてください。\n\nもしよろしければ、ボーナスアートのレイフとアスベルのように、リューとフィンタンがフィンに花冠を持たせてもらってもいいですか？アチューンメントされたレイフの衣装がフィンを祝福しているので、リューとフィンタンもフィンへの敬意と愛を表現してほしいです。\n\nhttps://imgur.com/a/i9P6Fzn\n\nご検討ありがとうございました！", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@kuohsan/works/42", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 694060, "client_id": 3008036, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/167fd00f/uploads/origins/f04b7aa1-30e6-4542-91aa-426c1b33229f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b9671d9c5c82b43c51be6e0cf08d061c", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/167fd00f/uploads/origins/f04b7aa1-30e6-4542-91aa-426c1b33229f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9959dbe958f4cda83555725e574c707e", "src_set": ""}, "body": "こんにちは、コウ！\n\n前回の作品がとても気に入ったので、今回はエリウと永四郎を一緒に描いていただけませんか？エリウはセドとナナの娘で、永四郎の幼なじみでもあります。将来的には2人はパートナーになるわけですが、10代後半の2人の関係を描いていただけませんか？どんな絵が描かれるのか、とても楽しみにしています！\n\nhttps://imgur.com/a/G2Q0kak", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@kuohsan/works/41", "private_thumbnail_image_urls": null, "private": false, "genre": "comic", "tipped": true, "creator_id": 694060, "client_id": 1622498, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/70d6a9f8/uploads/origins/fc43c369-c97f-4da0-ad62-a781f2c976c8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=394466f64cf4ccb0de7b46d86319414c", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/70d6a9f8/uploads/origins/fc43c369-c97f-4da0-ad62-a781f2c976c8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=60e081092e89ff496a9db41637f6c813", "src_set": ""}, "body": "またまたこんにちは！あなたにお願いした漫画がとても気に入ったので、またお願いしたいと思っています。これは、あなたが私のために描いてくれた別の作品と、その作品のアイデアにインスパイアされたものです。\n\nhttps://skeb.jp/@kuohsan/works/22\nhttps://x.com/PEve862/status/1766073878671970320\n\nレイフがナナにシロツメクサの花で作ったジュエリーをプレゼントする漫画をお願いしたいです。シロツメクサは「約束」「幸せ」「長い結婚」を表すので、プロポーズした後、シロツメクサで指輪を作る。彼は毎年、次の年も幸せになることを約束するために、クローバーの花を追加する。花の数が多すぎて指輪が作れないときは、レイフはクローバーの花のブレスレットを作る。花の数が多すぎてブレスレットが作れないときは、クローバーの花のネックレスを作る。私は、ナンナがシロツメクサの花の王冠をもらい、リューとフィンタンが先ほどの作品の王冠をかぶるところでこの漫画を終わらせたいと思う。彼らの王冠は、レイフが約束を守った証拠であることを示している。\n\nご検討ありがとうございました！", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@kuohsan/works/40", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 694060, "client_id": 3008036, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/b8195724/uploads/origins/b4e7f7a9-3ef1-4722-b0a5-ba24fce373cb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=962f27bc2713629685ae08bbdd076e37", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/b8195724/uploads/origins/b4e7f7a9-3ef1-4722-b0a5-ba24fce373cb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e46fa9a9c2bdf654a98a85e69127c583", "src_set": ""}, "body": "こんにちは、コウ！セドとナナがマーケットで一緒に買い物をしているところを描いていただけませんか？背景にはマリータとレイフを一緒に描いてもらえますか？もし新しい服を作りたいなら、それはクールだと思います！引き受けてくれると嬉しいな！\n\nhttps://imgur.com/a/v5PvZDC", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@kuohsan/works/39", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 694060, "client_id": 2961431, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/ff16947c/uploads/origins/6e1ef46f-a7c3-46cb-88c2-fa8402e881a9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e62a448bf54bb42bc60267d662193519", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/ff16947c/uploads/origins/6e1ef46f-a7c3-46cb-88c2-fa8402e881a9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ca55b07277612c150e267309a0ad2ebd", "src_set": ""}, "body": "再びこんにちは！前回のリクエストの仕上がりがとても気に入りました！私のOC（https://i.imgur.com/xP6A5F6.jpeg、青い目、茶色の髪、大きな胸、色白の肌、赤いリボンとメガネをかけている）と、軌跡シリーズのギリアス・オズボーン（https://imgur.com/a/3gns4Xf）のイラストをお願いします。\nOCはパステルブルーのパジャマを着ていて、https://i.imgur.com/kZgXAw3.jpeg。\nベッドで寄り添う2人を描いてください。\nOC = 153cm\nオズボーン＝200cm\nよろしくお願いします！必要であれば値段の調整もお願いします。", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@kuohsan/works/38", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 694060, "client_id": 3192575, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/c42254a5/uploads/origins/0be5aef5-d2d7-4bb0-aef4-23abd8c3301d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1003dd00110911f6aeb125f368214db8", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/c42254a5/uploads/origins/0be5aef5-d2d7-4bb0-aef4-23abd8c3301d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=03a028a363ef8855ed048be991985b9d", "src_set": ""}, "body": "こんにちは、Kuohsan！私の友達はみんなあなたの絵が大好きで、過去にリクエストしたことがあります。私もリクエストしたいと思っていました。\n\n僕のOCを描いてほしいんだ。彼女の名前はAlexandrineです。彼女の参考資料があまりないんだ。彼女の服をデザインしてほしいんだ。\n明るい茶色のロングヘアをポニーテールにして。下ろしている髪もある。\n目は琥珀色。肌は青白い。\nアレクサンドリーヌは若くして騎士になった。16歳にしてはとても強い。家族と家をとても大切に思っており、それらを守りたいと願っている。彼女に武器を持たせるなら、斧がいいだろう。この選択はあなたに任せます。彼女が幸せそうにしていたり、自信に満ちていたりするのを見るのは素晴らしいことです！\n彼女の衣装は、赤、黒、金でレフと同じような感じでお願いします。ピン