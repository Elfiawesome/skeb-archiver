ーズは自由に描いてください。\n英語が苦手です。失礼があったらごめんなさい。\nありがとうございました！\n\nhttps://drive.google.com/drive/folders/11dpB5YwTST1AiQQv90HZXl2rB3dg2zgj?usp=sharing", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@nemo_tty/works/3", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/bcbeefaa/uploads/origins/5646023d-489b-4b99-8a15-47b73bbfa8a5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=d7cc3e8571c23a2a765f9f71098a02f5", "srcset": "https://si.imgix.net/bcbeefaa/uploads/origins/5646023d-489b-4b99-8a15-47b73bbfa8a5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=d7cc3e8571c23a2a765f9f71098a02f5, https://si.imgix.net/bcbeefaa/uploads/origins/5646023d-489b-4b99-8a15-47b73bbfa8a5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=b3a15a39fa58774f7c0a5a059f19da4d 2x, https://si.imgix.net/bcbeefaa/uploads/origins/5646023d-489b-4b99-8a15-47b73bbfa8a5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=b42ff9e3a1b8b270f60eded49fabbf6b 3x"}, "private": true, "genre": "art", "tipped": false, "creator_id": 2998898, "client_id": 1096108, "nc": 144}, {"path": "/@nemo_tty/works/2", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/7e0c53ad/uploads/origins/113fcc8e-99de-40db-8b22-57535a590a5f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=b07e6bf06643ff72106afd582d05cc91", "srcset": "https://si.imgix.net/7e0c53ad/uploads/origins/113fcc8e-99