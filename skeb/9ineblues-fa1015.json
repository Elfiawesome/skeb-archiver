笑顔をしていて、彼が崇拝する人々の前では簡単に赤面します。そうでなければ、彼はたいてい気が散っていて眠そうに見えます。彼はゴールデンドッグを飼っているので、その犬と遊ぶのが好きです（彼は猫なので、自分のペット以外の犬はあまり好きではありませんが）。彼の他の活動は猫のようなもので、寝たり歩いたりするだけです。彼の好きな食べ物はジュジェカバブです。またはどんな肉でも。あなたは彼を好きなように描いてください！彼は主にファンタジーの設定です。目の下と顔に白いタトゥーが入っているので、その点も覚えておいてください。本当にありがとうございます❤️❤️❤️\n\nhttps://drive.google.com/drive/folders/1-Y032vMx_OwIkmoTdrANSJW1gSd724VK", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 524603, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "白滝力レー(BBQ)", "screen_name": "irattakoris", "avatar_url": "https://pbs.twimg.com/profile_images/1742447311744356352/B5orGPEJ.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1014353797571756032/1702300819/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "art"}], "banned": false, "nc": 176}, {"id": 1949120, "creator": true, "nsfw_acceptable": false, "acceptable": false, "name": "もぞもぞ", "screen_name": "aiueonigiri_04", "avatar_url": "https://pbs.twimg.com/profile_images/1910929410179403776/he-BDCCN.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1511197066730811394/1728230794/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 120, "skills": [{"genre": "art"}], "banned": false, "nc": 177}, {"id": 2485075, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "BAZA @ご依頼募集中", "screen_name": "BAZA629", "avatar_url": "https://pbs.twimg.com/profile_images/2015386146738716672/2pshwhVS.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1559507823033085952/1779391965/1500x500", "appeal_re