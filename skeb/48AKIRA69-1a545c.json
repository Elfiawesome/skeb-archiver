%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=1182cd6fe81d08bee737b950d67044cd 2x, https://si.imgix.net/ca62afa1/uploads/origins/5dc35e5c-e1a3-4384-a4bc-0eee53342c0e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=2957cddcf91167ec57e73fbf338c8fd4 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/ca62afa1/uploads/origins/5dc35e5c-e1a3-4384-a4bc-0eee53342c0e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d878fe33b7ff51a85842ab8308e4f21c", "srcset": "https://si.imgix.net/ca62afa1/uploads/origins/5dc35e5c-e1a3-4384-a4bc-0eee53342c0e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d878fe33b7ff51a85842ab8308e4f21c, https://si.imgix.net/ca62afa1/uploads/origins/5dc35e5c-e1a3-4384-a4bc-0eee53342c0e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=451a6b6002f1dec00baeae2f21bd93f0 2x, https://si.imgix.net/ca62afa1/uploads/origins/5dc35e5c-e1a3-4384-a4bc-0eee53342c0e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=d6517f0ab9efb481e042c0b25aa01741 3x"}, "body": "いつもお世話になっております。\nこの度はアキラさんに自キャラを描いて頂きたいと思い、お願いに上がりました。\n\n\n善悪ではなく真偽で物事を見る悪魔です。「真偽を見透かす目」を持っています。\n「感情で動く事」をしない性質を持っているので基本的に表情は穏やか。高笑いやニタリと笑ったりしない、表情筋を大きく動かさないタイプです。\n\n\nとはいえ無感情では無いのでその微妙な表情を描いて頂きたいです。\n例えば「少しだけイラっとしている」「ほんの少し呆れている」「ちょと楽しそう」「僅かにさげすんだような目」「軽く挑発している」等など。　「哀しみ」以外の表情でしたらなんでも大丈夫です。\n迷われましたらデフォルトの穏やかな表情で構いません。　\n\n\nキャラクターデザインについての補足ですが。\n身長は私の絵では少し頭身が短くなってしまったのですが、175㎝位を想定しています。\n注意点は「瞳孔が山羊のような横長四角」であることです。\n\n\n衣装はシースルーの眼帯が必須です。\nそれ以外は露出度が高くない物であればなんでも構いません。\nファンタジーの世界観でのキャラクターで中性的な見た目なので装飾品をつけて下さっても楽しいですし、時代や国籍関係なくアキラさんが「このキャラに似合いそう」と思って描きやすいものを自由に着せて下さい。\n（なんでもと書きましたが、もしも可能であれば和服と現代カジュアル以外だと嬉しいです）\n髪型もアレンジ可です。\n\n\n構図、シチュエーションはお任せします。\n色々書きましたがアキラさんが楽しく描いて頂ければそれが一番です。\nイケメンに…イケメンにお願いします…！！！！\n\n\n宛名を書いて頂ける場合は宛名レイヤーは別仕様だと嬉しいです。\n\n\nご検討頂けると幸いです。\n何卒宜しくお願い致します。\n\nhttps://www.pixiv.net/artworks/102334675", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@48AKIRA69/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 119363, "client_id": 1658685, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/b1feb671/uploads/origins/a5753d87-8a9a-49c0-b544-bff32f65e96c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6b6ca24f4d8b3983c0fd945f09c0be11", "srcset": "https://si.imgix.net/b1feb671/uploads/origins/a5753d87-8a9a-49c0-b544-bff32f65e96c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6b6ca24f4d8b3983c0fd945f09c0be11, https://si.imgix.net/b1feb671/uploads/origins/a5753d87-8a9a-49c0-b544-bff32f65e96c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=3d4e968f0556db8bc12ab845c9c42e77 2x, https://si.imgix.net/b1feb671/uploads/origins/a5753d87-8a9a-49c0-b544-bff32f65e96c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=453ae6ba221c97f4955a180de647b1cb 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/b1feb671/uploads/origins/a5753d87-8a9a-49c0-b544-bff32f65e96c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2f1a326bd2634256e9a161a6585896ce", "srcset": "https://si.imgix.net/b1feb671/uploads/origins/a5753d87-8a9a-49c0-b544-bff32f65e96c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2f1a326bd2634256e9a161a6585896ce, https://si.imgix.net/b1feb671/uploads/origins/a5753d87-8a9a-49c0-b544-bff32f65e96c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=a41f765ce0f2b694b38b1e30ccf618c1 2x, https://si.imgix.net/b1feb671/uploads/origins/a5753d87-8a9a-49c0-b544-bff32f65e96c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&f