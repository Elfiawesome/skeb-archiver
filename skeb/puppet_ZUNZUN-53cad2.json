道に迷った先で時間を潰している\n人に何されてもあんまり怒らない。\n基本的に相手のリクエストに自分が答えられるならする。\n\n\nどちらも結構童顔なタイプです。距離感はそこそこ近め。（HO2がHO1を褒める時にうなじを撫でたり、寝るときにHO1がHO2にくっついて寝たり・・・など）\n\n\n\n\nお忙しいようでしたら蹴っていただいて構いませんので、ご自愛ください🍵\nご都合がよろしければ何卒よろしくお願いいたします！\n\nhttps://www.dropbox.com/scl/fo/h8wege9gyj90dukvmf25y/h?rlkey=79cro66nvgbaz1qjd3enhq749&dl=0", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@hexadeca16/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2933652, "client_id": 2693232, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/32fa7ef9/uploads/origins/522ad7b2-d978-4417-94ee-ff61bc09fb17?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9c52c97447ffae1d5f43307ca827f363", "srcset": "https://si.imgix.net/32fa7ef9/uploads/origins/522ad7b2-d978-4417-94ee-ff61bc09fb17?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9c52c97447ffae1d5f43307ca827f363, https://si.imgix.net/32fa7ef9/uploads/origins/522ad7b2-d978-4417-94ee-ff61bc09fb17?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ce55ed24fc1be0c86ac6f86829409e60 2x, https://si.imgix.net/32fa7ef9/uploads/origins/522ad7b2-d978-4417-94ee-ff61bc09fb17?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=70a3763b8ab81af5df23a25fd3f13ef5 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/32fa7ef9/uploads/origins/522ad7b2-d978-4417-94ee-ff61bc09fb17?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=569bab72c9250bf93668b9676ac7c6c4", "srcset": "https://si.imgix.net/32fa7ef9/uploads/origins/522ad7b2-d978-4417-94ee-ff61bc09fb17?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=569bab72c9250bf93668b9676ac7c6c4, https://si.imgix.net/32fa7ef9/uploads/origins/522ad7b2-d978-4417-94ee-ff61bc09fb17?bg