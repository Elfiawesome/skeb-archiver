_count": 0, "received_works": [{"path": "/@tetsubousensei/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3399533, "client_id": 3713731, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/58d00709/uploads/origins/b2709af6-7a42-4476-90eb-d2fbfa71f226?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0c7b22c1fefea440520d562a7399c480", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/58d00709/uploads/origins/b2709af6-7a42-4476-90eb-d2fbfa71f226?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=520aaa4c25fe1b1513a2dae4c7af162f", "src_set": ""}, "body": "お世話になります。なぎです。せんせえの宇沢レイサちゃんの背景とふわっとしたかわいいイラストが好きすぎて毎日がつらいので、カズサちゃんのイラストも描いていただいてほしいです。カズサちゃんを拝んでより一層つらす…しあわせなせいかつをおくりたいです。", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@tetsubousensei/works/6", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/8fea24a9/uploads/origins/fd5b63ea-d553-43b3-8ef8-dc0ca80c7fb5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=2d0ac9e186eae1d3d37450bc7a86a75c", "src_set": ""}, "private": true, "genre": "art", "tipped": true, "creator_id": 3399533, "client_id": 0, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 145, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@tetsubousensei/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3399533, "client_id": 3330132, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/50b9a492/uploads/origins/eb965a41-3074-4188-9e6e-f808f7383ed3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3ddf052b1488c63993e083ebad2d7281", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/50b9a492/uploads/origins/eb965a41-3074-4188-9e6e-f808f7383ed3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f2cffc6554076b20f56e1ad6e71fafd3", "src_set": ""}, "body": "初めまして。\n私のOC描いて頂けたら嬉しいです。\n髪は赤茶色の腰まである巻き毛でセンター分け、瞳は吊り目で、縁無しのメガネかけてます。\n\n服装はふわもこのショートパンツ、カーディガンに変えてください。色は白か黄色でお願いします。\n\n構図表情はなんでもいいです。\n\nご検討よろしくお願い致します。\n\nhttps://drive.google.com/drive/folders/1dEeBkdxb07Jo4ONY_VuxLs0B7-iGTqJl", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@tetsubousensei/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3399533, "client_id": 0, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/01486fdb/uploads/origins/6f88787c-7792-4f77-aa40-c8d483539360?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f278385a9480d014030cb887b707204a", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/01486fdb/uploads/origins/6f88787c-7792-4f77-aa40-c8d483539360?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=1c0704951c47ec0924e1c1b22d2b97a5", "src_set": ""}, "body": "はじめまして\n概ね1980～2000年代あたりの昔のバスケユニフォーム姿な\n（丈がふともも付け根あたりまでの）短パンスポーツ少女お願いします\n髪型は黒髪セミロング、瞳の色は暗褐色\nバスケのユニフォームは以下の画像を参考にお願いします\n全体\nhttps://aucview.com/yahoo/o1063592096\n短パン\nhttps://jp.mercari.com/item/m31904562813\n画像のユニフォームは上下とも青を基調とし\n両サイドに幅広の白いラインとその両側のところに赤いラインが２本\n間に白いラインが１本入る配色パターンとなっていますが\nまず、青を基調とするデザインを\n赤（スカーレット系）を基調とするデザインへと変更\n元々の赤いラインのところはすべて白いラインへ\n白いラインのところはすべて黒いラインへ、それぞれ変更し\n赤（スカーレット系）を基調とし\n両サイドに幅広の黒いラインとその両側のところに白いラインが２本\n間に黒いラインが１本入る配色パターンに変更してください\nタンクトップは襟ぐりと袖まわりがゆったりとして隙間だらけな感じで\nまた画像から背番号やチーム名等を消去\n何もプリントされてないシンプルなデザインに変更してください\n短パンについては画像を御覧の通り\n丈がふともも付け根あたりまでの丈のかなり短いショートパンツです\n短パン右上のロゴは（色を変換させる以外）残しても構いません\n短パンの中にタンクトップの裾をしっかりと入れてる状態でお願いします\n着装参考例\nhttps://aucfree.com/items/e310120754\n着用時ちょうどタンクトップと短パンのサイドラインが繋がるイメージで\nまたブルマではなく\nあくまでも短パンなので裾まわりに余裕がある感じでお願いします", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@tetsubousensei/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3399533, "client_id": 259704, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/7ee80196/uploads/origins/a775d620-a0c0-4d80-ac5f-0e6cbbfd6d64?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c9e7505ce3cace562a5dfb89acaf211c", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/7ee80196/uploads/origins/a775d620-a0c0-4d80-ac5f-0e6cbbfd6d64?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=271ab8f5680387e561024d248e03758b", "src_set": ""}, "body": "こんにちは～\n\n作品名\nウマ娘プリティーダービー\n\nキャラクター名\nヴィブロス \n\n彼女が、勝負服姿で バスケットボールをもっている\nあるいは、バスケをしているシーンの\nイラストを描いていただけますか？\n\n衣装・表情・構図等はおまかせします。\nご検討よろしくお願いします。\n\nhttps://imgur.com/a/NL9Mbnr", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@tetsubousensei/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3399533, "client_id": 1886437, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/ef404e16/uploads/origins/8b00246e-7922-4e1c-b906-c0cc2c07285b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7127d89ec37d51f0f045bbd2bc7589d9", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/ef404e16/uploads/origins/8b00246e-7922-4e1c-b906