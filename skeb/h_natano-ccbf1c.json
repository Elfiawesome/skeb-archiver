53ae-9739-4fae-b276-25e6b92539b0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=267c7d2567f400b58f1ea0c0ae11fab6 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/f0100375/uploads/origins/26f653ae-9739-4fae-b276-25e6b92539b0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=af8e0e56b0f20b6d182dc7593574c983", "srcset": "https://si.imgix.net/f0100375/uploads/origins/26f653ae-9739-4fae-b276-25e6b92539b0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=af8e0e56b0f20b6d182dc7593574c983, https://si.imgix.net/f0100375/uploads/origins/26f653ae-9739-4fae-b276-25e6b92539b0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=d926248583a77aca136a5a3fda80aedd 2x, https://si.imgix.net/f0100375/uploads/origins/26f653ae-9739-4fae-b276-25e6b92539b0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=3ccd95a980968aad27051dd1cf33c215 3x"}, "body": "こんにちは！\nなたの久憲さんの描かれる人物の生き生きとした表情や構図が好きです！\n今回、うちの子であるノラちゃんを描いていただきたいと思い、リクエストを送信させていただきました。\n（お手数ですが、不備や金額の不足等あれば再送要請をお願いします……！）\n\n資料がSkebの過去リクエストのみであることをお詫びします。\nノラちゃんは狐モチーフのケモミミキャラであり、ふわふわの金髪に狐耳、大きなしっぽがあります。\n青い目と八重歯が特徴で、おでこに眼鏡をよくひっかけています。\nいつもけだるげにしていますが、よく笑う子です。\n\n可能であれば、服装は以下のどちらかでお願いできればと思います。\n①過去のリクエストのような、パーカー+ハーフパンツのいつも通りの服装\n②夏が近いので、半袖パーカーやサンダル等で涼しげな服装\n\n構図・イラストサイズ・デフォルメの有無・着色の有無等はすべてお任せします。\nなたのさんの思うようにかわいくノラちゃんを描いていただければそれが一番です！\n\n依頼は以上です。\n頂いたイラストは私の所有するSNSや各種サイト等のアイコン・ヘッダーで使用させていただきたいと思っています。\n\nよろしくお願いします！\n\nhttps://skeb.jp/@sunajiro8", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@h_natano/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1551, "client_id": 2685266, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/60caf223/uploads/origins/4d4376