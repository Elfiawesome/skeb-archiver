https://www.youtube.com/watch?v=RUrsD3OkOQ4\n∟女性キャラクターをデザインする時に聴いていた曲\n・https://drive.google.com/drive/folders/1Dm0GV45bvSxB3GUjMJgo_CZPHReZgg4p?usp=shar\n∟※イラスト資料には男性、女性両方の情報がございますが、女性側のイメージでお作り頂ければ幸いです。\n\n▍使用用途\n・個人的な音楽鑑賞\n・SNSでの非営利目的での動画での使用\n　※その際にはクレジットを表記させて頂きます\n\n\n食卓上の密告解など、smile dog様のどの楽曲も大好きです…！！\n和服を着用しておりますが、和の要素は考慮して頂かなくて結構です。\nご負担でなければ、ぜひ思うままに作曲して頂ければ幸いです。\n\nどうぞよろしくお願い致します。\n\nhttps://drive.google.com/drive/folders/1Dm0GV45bvSxB3GUjMJgo_CZPHReZgg4p?usp=shar", "nc": 128, "word_count": 0, "transcoder": "audio", "creator_acceptable_same_genre": true}, {"path": "/@inu0417/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "music", "tipped": false, "creator_id": 3551301, "client_id": 455097, "vtt_url": null, "thumbnail_image_urls": {"src": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1774887238054371331%2FDMzxspNt.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b4eb9e09baa7f2b84428e78163f1b41c", "srcset": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1774887238054371331%2FDMzxspNt.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b4eb9e09baa7f2b84428e78163f1b41c, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1774887238054371331%2FDMzxspNt.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=1918c898bfcb257ec641f1ab2247538d 2x, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1774887238054371331%2FDMzxspNt.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=03749dcdc38fffbcce9ab05693e191fa 3x"}, "preview_url": "https://fcdn.skeb.jp/uploads/outputs/6f40d860-4670-4b96-8ee3-b25c7adb3943?response-content-disposition=inline&Expires=1782397832&Signature=V~CyXL4EzL39w82G6uKJAo5-bT~3zoQazUqoHJoUaXEt2OvGxa1q9qXo2xIWM3OcTdIeZR3bUXynEhprPi-IDCX5f3NT6EBusBw4duWZGk8HXK1uU3fvKi-UwSRX2ZJreDYS8SVuARezEGtshbsUPV