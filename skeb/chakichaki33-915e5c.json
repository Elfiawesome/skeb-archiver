て頂きます。\n※印刷することもあるので、PSDデータでお願いします。（透過、サイン・メッセージに関しては、有無できるとありがたいです。）\nもし可能であれば、没稿等あればレイヤー等でON/OFFできるとありがたいです。\n\nご検討頂きます様、宜しくお願い致します。\n\nhttps://www.cocomelody.jp/items/ld4240.html", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}], "sent_works": [], "similar_creators": [{"id": 1692790, "creator": true, "nsfw_acceptable": false, "acceptable": false, "name": "桃野ぽ", "screen_name": "momono4343", "avatar_url": "https://pbs.twimg.com/profile_images/1786048953542443008/rAVQQtE_.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1340423093643169793/1757816277/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 100, "skills": [{"genre": "art"}, {"genre": "comic"}], "nc": 129}, {"id": 2296037, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "まるくに", "screen_name": "Marukuni", "avatar_url": "https://pbs.twimg.com/profile_images/1787631886489309184/wkMczqyQ.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1787631691944828928/1757168309/1500x500", "appeal_receivable": true, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 120, "skills": [{"genre": "art"}], "nc": 144}, {"id": 2635936, "creator": true, "nsfw_acceptable": false, "acceptable": false, "name": "ヒラメ/Hirame", "screen_name": "flatfish_vct", "avatar_url": "https://pbs.twimg.com/profile_images/1756815617896968192/DtWhRpZ-.png", "header_url": "https://pbs.twimg.com/profile_banners/1611416062071013376/1707693615/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "compl