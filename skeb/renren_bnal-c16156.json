単なプロフィールを追記しておきます。\n\nVOID HO3\n年齢：36歳\n身長：178㎝\n自分のことをおじさんと呼ぶ飄々としていて胡散臭い男。人懐っこく人たらしな男だが、本心に踏み込まれると途端に笑顔で拒絶する。\n勤務態度は可もなく不可もなく。どこか仕事に対しては無気力なところがある。\n甘党なのかフラペチーノが好きでよく仕事中にもスタバに行っている。\n\nシチュエーションはお任せしますが、困ったように笑っているようなところを描いていただけると幸いです。\n\n使用用途：鑑賞\n\n以上となります！どうかよろしくお願いします！\n\nhttps://drive.google.com/drive/folders/1E3xVdOdPPh8bk4WGpVh0-nppFP8VB6N3?usp=drive_link", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@gesakusakusaku/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "comic", "tipped": true, "creator_id": 3719900, "client_id": 1152476, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/8ff26187/uploads/origins/84457c62-68bc-4e0c-8420-0b65fbf1c7cb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=070f94913e0f9dddd6dd92cf9f21aa7d", "srcset": "https://si.imgix.net/8ff26187/uploads/origins/84457c62-68bc-4e0c-8420-0b65fbf1c7cb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=070f94913e0f9dddd6dd92cf9f21aa7d, https://si.imgix.net/8ff26187/uploads/origins/84457c62-68bc-4e0c-8420-0b65fbf1c7cb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=8e79004b0f4ecc1840e825926c98155e 2x, https://si.imgix.net/8ff26187/uploads/origins/84457c62-68bc-4e0c-8420-0b65fbf1c7cb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=593fa476c111612cc0eee80035cf586e 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/8ff26187/uploads/origins/84457c62-68bc-4e0c-8420-0b65fbf1c7cb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=cd35e465f77c783e7734c95f3010cad8", "srcset": "https://si.imgix.net/8ff26187/uploads/origins/84457c62-68bc-4e0c-8420-0b65fbf1c7cb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=cd35e465f77c783e7734c95f3010cad8, https://si.imgix.net/8ff