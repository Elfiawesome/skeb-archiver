5c3a5f-f56b-4d0d-aaf4-b84d16a7d553?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=197b8017f0ba10e93a79067e5593c9b7", "srcset": "https://si.imgix.net/5c033e80/uploads/origins/495c3a5f-f56b-4d0d-aaf4-b84d16a7d553?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=197b8017f0ba10e93a79067e5593c9b7, https://si.imgix.net/5c033e80/uploads/origins/495c3a5f-f56b-4d0d-aaf4-b84d16a7d553?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=1ff84bb04cba0f845412bf7b428ef5ac 2x, https://si.imgix.net/5c033e80/uploads/origins/495c3a5f-f56b-4d0d-aaf4-b84d16a7d553?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=9ab2f9c98336d492b07d22fa7c06beff 3x"}, "body": "いつもお世話になっております。新人Vtuberの狐雷希望です！\n\n今回は歌枠のサムネイルなどに使用するイラストをお願いしたく、メッセージを送らせていただきました。\n以下に必要事項を記載いたしますので、ご確認よろしくお願いいたします！\n\n・依頼内容\n　歌枠のサムネイルなどに使用するイラストの制作\n\n・主な使用先\n　歌枠のサムネイルなどに使用、各SNSへの公開などを想定しています。\n　また今後公開する個人サイトへも掲載予定です。\n\n・画像のサイズ\n　16:9の比率でお願いしたいです。\n\n・解像度\n　印刷に適した高解像度でお願いしたいです。\n\n・納品形式\n　pngファイル\n　イラスト1枚になっているものと、背景、キャラを別々に分けたものを貰いたいです。\n\n・構図などについて\n　　狐雷希望(Vの姿)がマイクを握り全力で熱唱している姿を描いていただきたいです。\n　　向きは正面でお願いしたいです。\n　　\n　　背景についてはステージのような場所をイメージしておりますが、こちらについてはお任せいたします。\n　　\n　　可能であればマイクを握っていない状態も差分としてご用意いただけますと助かります。\n\n以上、長文となりましたがご快諾いただけますと幸いです。\nよろしくお願いいたします。", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Lustro_wody/works/16", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 978147, "client_id": 3666818, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/9af8f825/uploads/origins/2930b51d-4e94-4066-a181-c4dd2d3d5647?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=de840f7a429f3d2202d8ba81368f9f57", "srcset": "https://si.imgix.net/9af8f825/uploads/origins/2930b51d-4e94-4066-a181-c4dd2d3d5647?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=de840f7a429f3d2202d8ba81368f9f57, https://si.imgix.net/9af8f825/uploads/origins/2930b51d-4e94-4066-a181-c4dd2d3d5647?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=7e87faa17af1cdecab27fd7eac012310 2x, https://si.imgix.net/9af8f825/uploads/origins/2930b51d-4e94-4066-a181-c4dd2d3d5647?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=53e967fdc0eb410e042ae59944d83362 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/9af8f825/uploads/origins/2930b51d-4e94-4066-a181-c4dd2d3d5647?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ae0bb21eb41f9e5a08565725289bce0a", "srcset": "https://si.imgix.net/9af8f825/uploads/origins/2930b51d-4e94-4066-a181-c4dd2d3d5647?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ae0bb21eb41f9e5a08565725289bce0a, https://si.imgix.net/9af8f825/uploads/origins/2930b51d-4e94-4066-a181-c4dd2d3d5647?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=cc06458411e28b3f6d50d7a345d99c43 2x, https://si.imgix.net/9af8f825/uploads/origins/2930b51d-4e94-4066-a181-c4dd2d3d5647?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=8a791b4a4d80b4673b7cfed334097d98 3x"}, "body": "いつもお世話になっております。新人Vtuberの狐雷希望です！\n\n今回は新キービジュアルイラストをお願いしたく、メッセージを送らせていただきました。\n以下に必要事項を記載いたしますので、よろしくお願いいたします！\n\n・依頼内容\n　新キービジュアルイラスト制作\n\n・主な使用先\n　新キービジュアルとして使用、各SNSへの公開、サムネイルへの使用など\n　また今後公開する個人サイトへも掲載予定です。\n\n・画像のサイズ\n　16:9の比率でお願いしたいです。\n\n・解像度\n　印刷に適した高解像度でお願いしたいです。\n\n・納品形式\n　pngファイル\n　イラスト1枚になっているものと、背景、キャラを別々に分けたものを貰いたいです。\n\n\n・構図などについて\n　剣を持った狐雷希望(Vの姿)が、空に向かって激しい雷を纏った大斬撃を放ち闇夜を\n　切り祓い、快晴の空を出現させるようなイメージです。\n\n　闇夜は絶望感や立ちはだかる壁のイメージを内包し、それを切り祓い希望や未来をイメージした\n　快晴を出現させる、といったテーマとなります。\n　\n　持つ剣についてはSAO(ソードアートオンライン)のキリトが持っている『エリュシデータ』という剣を参考にしてください。\n　剣の色については黒以外でお願いします。それ以外はお任せします。\n　\n　技の構図参考としては、シャングリラ・フロンティアのウェザエモンというキャラが放つ『天晴』\n　がイメージに近い感じです。\n　詳しくは以下公式動画の03:31～03:33あたりが参考になるかと思います。\n　https://youtu.be/OmuIeePWm2g?si=NOV9--nkPgy4WEYy\n　\n　動画では正面に放ってますが、今回は空に向かって放つので下から斜め上に斬撃を打つような\n　構図を希望します。\n　\n　また、完成したイラストに後から文字(キャッチフレーズ)を入れる予定なので、\n　どこかに入れられるようなスペースを確保していただけると助かります。\n　(こちらについて場所はお任せします)\n\n以上、長文となりましたがご快諾いただけますと幸いです。\nよろしくお願いいたします。", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Lustro_wody/works/15", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/d77f4395/uploads/origins/3b6cdf4e-eeed-4363-ab91-5b8ffff2933d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=998b76f0b165c0ea88341bb2ab414007", "srcset": "https://si.imgix.net/d77f4395/uploads/origins/3b6cdf4e-eeed-4363-ab91-5b8ffff2933d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=998b76f0b165c0ea88341bb2ab414007, https://si.imgix.net/d77f4395/uploads/origins/3b6cdf4e-eeed-4363-ab91-5b8ffff2933d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=356b923a6560ede1987c3bd1f05f48ff 2x, https://si.imgix.net/d77f4395/uploads/origins/3b6cdf4e-eeed-4363-ab91-5b8ffff2933d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=ac2fba4a43ca90253781393000fc4970 3x"}, "private": true, "genre": "art", "tipped": false, "creator_id": 978147, "client_id": 3528212, "nc": 129}, {"path": "/@Lustro_wody/works/14", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 978147, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/