な料理を食べる、花火を見る、爆竹を鳴らすなど。その他、思いついたシチュエーションを自由に使ってください。\n\nこんなお願いで大丈夫でしょうか？お気に召さない場合はご遠慮ください。お時間とご配慮をありがとうございました。\n\nセレスティン参考：https://imgur.com/a/7KGq8fe\n丹恒饮月参考：https://imgur.com/a/nw5sVIJ\n白露リファレンス：https://imgur.com/U8n5w4y\n\nhttps://imgur.com/a/7KGq8fe", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Lustro_wody/works/9", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 978147, "client_id": 970661, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/6b7de465/uploads/origins/f32231db-0f8f-45cc-aaa1-01350758affd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=209b0d24724933826878d02d54eeaa75", "srcset": "https://si.imgix.net/6b7de465/uploads/origins/f32231db-0f8f-45cc-aaa1-01350758affd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=209b0d24724933826878d02d54eeaa75, https://si.imgix.net/6b7de465/uploads/origins/f32231db-0f8f-45cc-aaa1-01350758affd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=1a648667e571fcd4d081a227ee9c7416 2x, https://si.imgix.net/6b7de465/uploads/origins/f32231db-0f8f-45cc-aaa1-01350758affd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=5aa8efe7e66d71c7ff830b7fc3765d3d 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/6b7de465/uploads/origins/f32231db-0f8f-45cc-aaa1-01350758affd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b00e9437d8e551556cb25947f106e612", "srcset": "https://si.imgix.net/6b7de465/uploads/origins/f32231db-0f8f-45cc-aaa1-01350758affd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b00e9437d8e551556cb25947f106e612, https://si.imgix.net/6b7de465/uploads/origins/f32231db-0f8f-45cc-aaa1-01350758affd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop