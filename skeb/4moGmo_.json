iv.net/en/artworks/61848215 このような視点も考えられる。\n観客が彼女のパフォーマンスを見ているはずです。\n\nありがとうございました！", "nc": 177, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@4moGmo_/works/11", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/e93b59e0/uploads/origins/00927992-9e59-4008-a803-1ec392bcf40a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=50f8e9dbc129dbed6229471697a927e5", "srcset": "https://si.imgix.net/e93b59e0/uploads/origins/00927992-9e59-4008-a803-1ec392bcf40a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=50f8e9dbc129dbed6229471697a927e5, https://si.imgix.net/e93b59e0/uploads/origins/00927992-9e59-4008-a803-1ec392bcf40a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=f0416ae40addb0ce7b246b758025f125 2x, https://si.imgix.net/e93b59e0/uploads/origins/00927992-9e59-4008-a803-1ec392bcf40a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=ca8fb01b36cf5c0fba6aaaa1530fd4ec 3x"}, "private": true, "genre": "art", "tipped": true, "creator_id": 1287649, "client_id": 262123, "nc": 33}, {"path": "/@4moGmo_/works/10", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/0fcf146c/uploads/origins/47005d2e-eebd-4216-8887-e11f8d0c757f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=69574fa181271427fba629ad4227da7d", "srcset": "https://si.imgix.net/0fcf146c/uploads/origins/47005d2e-eebd-4216-8887-e11f8d0c757f?bg=%23fff&auto=format%2Ccompress&