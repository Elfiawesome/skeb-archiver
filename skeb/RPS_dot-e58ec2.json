b3-9a7b-6e677916b715?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&s=7db3ee997cd01dd7c4ffa961d9f483cc, https://si.imgix.net/6b51139e/uploads/origins/1a38528c-e7a2-45b3-9a7b-6e677916b715?bg=%23fff&fm=webp&auto=compress&dpr=2&fit=crop&crop=top&w=200&h=200&s=15c8a6033e0cd15fbd65869af4fbe7a4 2x, https://si.imgix.net/6b51139e/uploads/origins/1a38528c-e7a2-45b3-9a7b-6e677916b715?bg=%23fff&fm=webp&auto=compress&dpr=3&fit=crop&crop=top&w=200&h=200&s=16cd395ff496c5b00715b862029d06ac 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/6b51139e/uploads/origins/1a38528c-e7a2-45b3-9a7b-6e677916b715?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&blur=200&s=d11e3496e290ccdea6e22edfeac1a20d", "srcset": "https://si.imgix.net/6b51139e/uploads/origins/1a38528c-e7a2-45b3-9a7b-6e677916b715?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&blur=200&s=d11e3496e290ccdea6e22edfeac1a20d, https://si.imgix.net/6b51139e/uploads/origins/1a38528c-e7a2-45b3-9a7b-6e677916b715?bg=%23fff&fm=webp&auto=compress&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=b6c998eff0dbfe682b6f456af13c1bc0 2x, https://si.imgix.net/6b51139e/uploads/origins/1a38528c-e7a2-45b3-9a7b-6e677916b715?bg=%23fff&fm=webp&auto=compress&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=b271cdb53cc549297d0bf9c202954404 3x"}, "body": "はじめまして、けんじぃと申します。日頃よりらぴす教授様のムービーをTwitterで見させて頂いております。\n今回VTuber様へのプレゼントとして依頼に参りました(ᴗᴗ)\n\n依頼内容\nVTuber アール・テテ様のムービー作成\n\n使用用途\nV様本人へのプレゼント\n(SNS、収益化済み配信等での使用の可能性有)\n\n詳細\n前に作成されていたクレーンゲームの様に制作して頂きたく思います。\n(イメージ:奥に本人様が操作されている状態、クレーンゲームの中にある人形は❋ちびてて。その中から❋コットン(💢マークの付いた)が持ち上がると言う感じです)\n❋のキャラクター2体はグッズページ(BOOTH)より二七ヶ月記念グッズ、生誕祭グッズの所で姿が確認できます。(このキャラクターを使う事は了承頂いております)\n\n以上のイメージで制作を受けて頂けないか、検討の程よろしくお願いします🙇\n\nhttps://aretete.booth.pm/    https://lit.link/AreTete", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@RPS_dot/works/177", "private_thumbnail_i