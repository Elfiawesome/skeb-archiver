/2358f60e-0a1c-496f-bf01-06f7cc704549?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&s=c9c5389b1a3be8b40fe372ad011da0c1, https://si.imgix.net/fbae6759/uploads/origins/2358f60e-0a1c-496f-bf01-06f7cc704549?bg=%23fff&fm=webp&auto=compress&dpr=2&fit=crop&crop=top&w=200&h=200&s=824794ea576103aa0b35eca002be3b8f 2x, https://si.imgix.net/fbae6759/uploads/origins/2358f60e-0a1c-496f-bf01-06f7cc704549?bg=%23fff&fm=webp&auto=compress&dpr=3&fit=crop&crop=top&w=200&h=200&s=f2036370b847b58d347997c87dad1556 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/fbae6759/uploads/origins/2358f60e-0a1c-496f-bf01-06f7cc704549?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&blur=200&s=cfbaec7ea85a76510a37549649250366", "srcset": "https://si.imgix.net/fbae6759/uploads/origins/2358f60e-0a1c-496f-bf01-06f7cc704549?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&blur=200&s=cfbaec7ea85a76510a37549649250366, https://si.imgix.net/fbae6759/uploads/origins/2358f60e-0a1c-496f-bf01-06f7cc704549?bg=%23fff&fm=webp&auto=compress&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=618731859e357b364d94994776bb205c 2x, https://si.imgix.net/fbae6759/uploads/origins/2358f60e-0a1c-496f-bf01-06f7cc704549?bg=%23fff&fm=webp&auto=compress&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=677de5d7c67685254eff448e6880711f 3x"}, "body": "らぴす教授様こんにちは。個人勢Vtuberの雪城ひよりと申します。先生の動くSDキャラのドット絵アニメーションがとても可愛らしく素敵で、是非とも私【雪城ひより】でお作りして頂きたく今回リクエストを送らせて頂きました。\nこちら資料となります。\nhttps://drive.google.com/drive/folders/1zD9irBkrYuaVdOhaYzacB9RGRIN9GMxJ?usp=sharing\n\nR.E.P.O.というゲームのカートを押している姿で作成して頂きたいです。\nカートからひょっこり顔を(もしくは上半身までを)出している形で、カートを手で押している感じに作成して頂きたいです。\n・胸の紋章はSD化に当たって作成が難しそうであれば隠して頂く等して頂いて大丈夫です。\n・眼鏡は作成が難しそうであれば無しで大丈夫です。\n・ジャケットは有り/無しどちらの姿で作成して頂いても大丈夫ですので、先生のお好きな方で作成して頂けたら幸いです\n・カートの中身はお任せします\n\n頂いたドット絵アニメーションは配信サムネやSNS活動等、Vtuber活動をする上での使用を考えておりますので、もしよろしければ背景が透過されたファイルを一緒に頂きたいです\nこちらの内容で問題無ければお受けして頂きたいです。\nご検討よろしくお願いします", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@RPS_dot/works/172", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 482850, "client_id": 545255, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/b4d22f24/uploads/origins/ee7d4c64-3371-48f7-a247-46067febf9a9?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&s=09d35f94e9355a47aa1d5bdd56473ad7", "srcset": "https://si.imgix.net/b4d22f24/uploads/origins/ee7d4c64-3371-48f7-a247-46067febf9a9?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&s=09d35f94e9355a47aa1d5bdd56473ad7, https://si.imgix.net/b4d22f24/uploads/origins/ee7d4c64-3371-48f7-a247-46067febf9a9?bg=%23fff&fm=webp&auto=compress&dpr=2&fit=crop&crop=top&w=200&h=200&s=c70cd7718cacfede10858d4aaa49160b 2x, https://si.imgix.net/b4d22f24/uploads/origins/ee7d4c64-3371-48f7-a247-46067febf9a9?bg=%23fff&fm=webp&auto=compress&dpr=3&fit=crop&crop=top&w=200&h=200&s=cf19171b393892fd395878d89ac3b2e4 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/b4d22f24/uploads/origins/ee7d4c64-3371-48f7-a247-46067febf9a9?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&blur=200&s=7b1b067354cd7c064072b81aaa0f7a0d", "srcset": "https://si.imgix.net/b4d22f24/uploads/origins/ee7d4c64-3371-48f7-a247-46067febf9a9?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&blur=200&s=7b1b067354cd7c064072b81aaa0f7a0d, https://si.imgix.net/b4d22f24/uploads/origins/ee7d4c64-3371-48f7-a247-46067febf9a9?bg=%23fff&fm=webp&auto=compress&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=9a22bc05d7d21ef8436fca4fbef5d9c3 2x, https://si.imgix.net/b4d22f24/uploads/origins/ee7d4c64-3371-48f7-a247-46067febf9a9?bg=%23fff&fm=webp&auto=compress&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=74acdd9d9fb8ba3ccd22d1f2d491d34c 3x"}, "body": "こんにちは！\n\n私のオリジナルキャラクター「エクシア」のイラストをお願いしたいです。\n\