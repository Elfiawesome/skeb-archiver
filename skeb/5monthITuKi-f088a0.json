-4737-aebe-6cd99d8414b0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e16423b6c776fab9ec34952c224f495c, https://si.imgix.net/e1a2184b/uploads/origins/98fca3c8-39cf-4737-aebe-6cd99d8414b0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=2aeae355319d7caeef0ad251b34df723 2x, https://si.imgix.net/e1a2184b/uploads/origins/98fca3c8-39cf-4737-aebe-6cd99d8414b0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=308c78dbe8e97fc3e316752f1ce6e496 3x"}, "body": "初めまして！Xでイラスト巡りをしている際に見かけた五月いつきさんの描かれるおじさんのイラストに魅力を感じてしまい、是非とも拙宅のOCを描いていただきたくリクエストを送らせていただきました…！\nもしよろしければ受けていただけると大変嬉しい限りです…！\n\n（以下、詳細となります）\n＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝\n▽キャラ詳細\n名前：セベリン・セルシウス（Severin Celsius）\n年齢：38歳\n身長：180cm\n体格：細身\n職業：FBI捜査官/ホワイトハッカー\n出身：イギリス\n\nほぼ仏頂面で目つきや人相が悪く、笑う時のほとんどはハッキングが成功した時か、皮肉を口にする時。悪い顔で笑う。頭はいいが気分屋の為不誠実に見えがち。\n仕事となると効率重視で完璧にこなそうとし、自分のコンピューター技術に絶対的な自信を持っている。\n色々と難があるように見えるが、その実はあまり素直になれないだけであり、きっちりと好意を抱いている相手へはここぞという時に嘘をつくのは主義に反するらしく、正直な意見を述べる。\n\n▽リクエスト内容\n壁にもたれて腕を組みながら、皮肉っぽく笑ってこちらに目線を送っている感じでお願いします！\n服装やその他の部分などは、描きやすいように描いていただけましたらと思います！\n\n▽資料\nhttps://drive.google.com/drive/folders/1jRfteNZfy3PZN-JpWqsHrwbn2vVpLRuN?usp=drive_link", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@5monthITuKi/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "comic", "tipped": false, "creator_id": 3834595, "client_id": 3860596, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/6d469fbc/uploads/origins/247d99c1-9601-4467-9e44-fe8d6ea6fb76?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=12934b43174af1bcbb315b892f2a9d66", "srcset": "https://si.imgix.net/6d469fbc/uploads/origins/247d99c1-9601-4467-9e44-fe8d6ea6fb76?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=12934b43174af1bcbb315b892f2a9d66, https://si.imgix.net/6d469fbc/uploads/origins/247d99c1-9601-4467-9e44-fe8d6ea6fb76?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=0c7b99ee2d7f48371d2db5c73bb6b14f 2x, https://si.imgix.net/6d469fbc/uploads/origins/247d99c1-9601-4467-9e44-fe8d6ea6fb76?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d37376946f461fe081a43a0befa85227 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/6d469fbc/uploads/origins/247d99c1-9601-4467-9e44-fe8d6ea6fb76?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6f58d22e0f2cf89b796e08948fec21ce", "srcset": "https://si.imgix.net/6d469fbc/uploads/origins/247d99c1-9601-4467-9e44-fe8d6ea6fb76?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6f58d22e0f2cf89b796e08948fec21ce, https://si.imgix.net/6d469fbc/uploads/origins/247d99c1-9601-4467-9e44-fe8d6ea6fb76?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=ec1f7c7f0e969d120d60c2e46d5f945a 2x, https://si.imgix.net/6d469fbc/uploads/origins/247d99c1-9601-4467-9e44-fe8d6ea6fb76?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=34918261fb8ad3bd3c46b17d24ee0128 3x"}, "body": "初めまして！頬キズおじさんの夢的コミック\nをお願い致したいです。女の子の見た目は\nクソガキちゃんを希望したいです。\n\n普段は軽口を言い合う関係性の中で、\nクソガキちゃんの何気ない一言をきっかけに、空気が明確に変わるシーンを見たい\nです。\n「あーあ、チンパンジーとか言うなら他の人に飼ってもらおうかなー！」といった発言の直後、頬キズおじさんが一瞬間を置いてから「…あ？」と低い声で反応し、静かに距離を詰めていくようなシーンが見たいです…！\n気づいたら壁際に追い込まれているような位置関係で、逃げ場を塞がれているような雰囲気で、おじさんは怒鳴ったりはせず、落ち着いた表情のままですが、目だけに強い執着や異常な独占欲が感じられるような所を見たいです。口元はわずかに笑っているようなニュアンスだと嬉しいです。\nクソガキちゃんはいつもの態度が少し崩れて、戸惑いや初めて感じる怖さが出ている表情を見たいです。\nじわっとした狂気と愛を感じる感じでお願い致します。", "nc": 153, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@5monthITuKi/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3834595, "client_id": 3751470, "vtt_url": null, "thumbnail_image_urls