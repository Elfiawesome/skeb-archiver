, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@tokaTouka_/works/11", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3773807, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/1c3113cb/uploads/origins/85df9199-d322-4b40-b92a-6756fb06e72b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6cd4863b2a0e390086e49f611d94e067", "srcset": "https://si.imgix.net/1c3113cb/uploads/origins/85df9199-d322-4b40-b92a-6756fb06e72b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6cd4863b2a0e390086e49f611d94e067, https://si.imgix.net/1c3113cb/uploads/origins/85df9199-d322-4b40-b92a-6756fb06e72b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=486058079816542db172b35b8b2b8c1c 2x, https://si.imgix.net/1c3113cb/uploads/origins/85df9199-d322-4b40-b92a-6756fb06e72b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=4d36d6fd83e4080354a6266b14240e81 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/1c3113cb/uploads/origins/85df9199-d322-4b40-b92a-6756fb06e72b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=de0beb3791cb33e96ebd89bf5ca9b921", "srcset": "https://si.imgix.net/1c3113cb/uploads/origins/85df9199-d322-4b40-b92a-6756fb06e72b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=de0beb3791cb33e96ebd89bf5ca9b921, https://si.imgix.net/1c3113cb/uploads/origins/85df9199-d322-4b40-b92a-6756fb06e72b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=9bca43869795428011c988e993c0e468 2x, https://si.imgix.net/1c3113cb/uploads/origins/85df9199-d322-4b40-b92a-6756fb06e72b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=d5b916192d9e2e90616290199aa6222a 3x"}, "body": "はじめまして、VTuberの夢境めいろと申します。\n\n柔らかく素敵なイラストを拝見し、また中性的な雰囲気が好きとの事でぜひ先生にOCである夢境めいろを描いていただきたくご連絡させて頂きました。\n\n【夢境めいろについて】  \n・歌って演じる中性VTuber\n・夢の案内狐\n・耳に宝石がついている(宝石の取り替え可能)\n・彩度の低い金髪とくすんだ青の毛先\n・瞳に四芒星\n・右目にホクロふたつ\n・少年のような体つき\n\n全身が見える画像ツイートを添付させて頂きます。\nhttps://x.com/me___color/status/1876261831817462229?s=46\n\n【用途】\n・YouTubeでのサムネイル\n・動画内での使用\n・Twitterでの使用\n・素材モデル(デザイナー様へ一時的にデータをお渡しする可能性がございます)\n\n【イラスト詳細】\n構図等はお任せ致しますので、先生の思い描く夢境めいろのイラストを描いていただけますと幸いです。\n\n衣装に関して、通常衣装でも先生オリジナルのお洋服を着せていただいても大丈夫です。\n中性的な容姿のため少年のような肉付きですととても助かります。\n\nサムネイル等で使うため、頭の上や髪の先が途切れない構図ですと嬉しいです。\n\n【納品データ】\n人物と背景のレイヤーが分かれていたらどの形式でも問題ありません。\n\n何卒よろしくお願い致します！", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@tokaTouka_/works/10", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3773807, "client_id": 387423, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/fa6a1559/uploads/origins/eb710b5b-f154-4882-8ed5-ebc515ee73e1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=33968b46b03b0ceac1060a30697c61a9", "srcset": "https://si.imgix.net/fa6a1559/uploads/origins/eb710b5b-f154-4882-8ed5-ebc515ee73e1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=33968b46b03b0ceac1060a30697c61a9, https://si.imgix.net/fa6a1559/uploads/origins/eb710b5b-f154-4882-8ed5-ebc515ee73e1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=fc8ff72017cb377e25ae1580768cda49 2x, https://si.imgix.net/fa6a1559/uploads/origins/eb710b5b-f154-4882-8ed5-ebc515ee73e1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ba2594edc8dd94c5fe0ca6ddcd3ec15a 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/fa6a1559/uploads/origins/eb710b5b-f154-4882-8ed5-ebc515ee73e1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=341b48b3d