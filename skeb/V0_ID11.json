to=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=28f80e1bb5e3db8ad3b94df2e8ad2d55, https://si.imgix.net/f876ed0e/uploads/origins/441a823b-0dcc-42f5-a4e8-88d066bb724c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=41cbd224b87fa791fecd6827cba94365 2x, https://si.imgix.net/f876ed0e/uploads/origins/441a823b-0dcc-42f5-a4e8-88d066bb724c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=5a0c1475b1daaae7c06c97bfea598050 3x"}, "body": "初めまして。先生の作品を拝見して、オリジナルキャラクターを書いていただきたくご連絡差し上げました。\n\nこの少女の名前はノゾミです。苗字はありません。青がかった灰色の長い髪をもっています。インナーカラーに青があります。\n表情が若干乏しかったり、大人しめの印象をうけますが、見た目よりも積極的に会話をし、行動力のある誰にでも手を差し伸べるいい子です(悪く言えばトラブルに自分から顔を突っ込みます)。一眼レフカメラを持ち、世界中をひとりで巡る旅人です。いくつかの魔術を習得しているので、それを駆使して旅をしています。\n彼女の頭の花飾りは青のオダマキです。オダマキの花言葉は決意･愚かなどがあります。\n\n先生の描かれる手が大好きなので、是非手が映るポーズで描いてくださると嬉しいです。カーディガンの柄を正確に描く必要はありません。\n何卒よろしくお願いします。\n\n⬇資料\n\nhttps://drive.google.com/file/d/13hV70EscnoLTlcStxPUlvHIz8axq0-J9/view?usp=drivesdk", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@V0_ID11/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3637942, "client_id": 3065328, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/a549c579/uploads/origins/54189278-119d-464e-add2-9b5a94fcb252?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7bcbdf0afdcf036ef08950c4a9a923f3", "srcset": "https://si.imgix.net/a549c579/uploads/origins/54189278-119d-464e-add2-9b5a94fcb252?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7bcbdf0afdcf036ef08950c4a9a923f3, https://si.imgix.net/a549c579/uploads/origins/54189278-119d-464e-add2-9b5a94fcb252?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=2030c3259469b6026d662b0c0c8b17bc 2x, https://si.imgix.net/a549c579/uploads/origins/54189278-119d-464e-add2-9b5a94fcb252?bg=%23fff&a