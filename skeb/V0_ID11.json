367531f41de?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f163b1feaf35caea893424bcc6e01578, https://si.imgix.net/4bdc7d23/uploads/origins/b2ed49c6-955c-4537-a46d-0367531f41de?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=1731a788b326a04e4f31681ab6654447 2x, https://si.imgix.net/4bdc7d23/uploads/origins/b2ed49c6-955c-4537-a46d-0367531f41de?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=5a3fa5ce8b582f65952f3ad0bce3e25a 3x"}, "body": "リクエストです。自探索者の三條雪心を描いていただきたいです。どんな彼女を描くかは全てお任せいたします。\n名前：三條雪心（さんじょう ゆきこ）\n性別：女性\n年齢：23歳\n誕生日：12月25日\n一人称：わたし\n二人称：貴方、〇〇（苗字呼び）\n身長：161cm\nスリーサイズ：B91cm/W56cm/H88cm\nカップサイズ：Hカップ\n体重：55kg\nイメージCV：大西沙織、ゆかな、斎藤千和\n人物\n元シスター。現在は週3で個人経営の喫茶店で店員をしている。\n幼馴染である三條日向の死に際託された孤児達を養子にして少なくとも５人かそれ以上の子供達を幼児である実子を除いて全員養い学校に通わせているシングルマザー・・・だったのが日向が生き返ったことによりラブラブおしどり夫婦になっている。\n\n元の性格は強気もとい教祖強火勢だったが今は母になり紆余曲折あって日向と結ばれだいぶん落ち着いているが、根っこは目的のためならば手段を選ばず後悔もしない魔女のまま。\nむしろ一度死別したことにトラウマを持っているため夫の日向に危害を加えられそうになると殺意と本性をむき出しにする。\n自分のしていることが悪だ罪だと理解しているし感じた上で後悔も躊躇もしない狂犬メンタル。\n\n教祖として神のような扱いを受け人間であることを奪われる日向の環境に憎悪を抱いていたが、今は全てから解放され妻として、母として生活を送っている。\n朝は家族の朝食とお弁当の準備、見送りをし、午前はカフェで働き午後には家に帰り家事をこなして夕飯と風呂の準備をし、家族を迎えて夕飯を済ませ、夜には子供達を寝かしつけた後最愛の人と愛し合い眠りにつく、絵に描いたような幸せな結婚生活を送っている。\n強く見えて、その実名前が体を表した様に脆く庇護者である夫がいなければ容易く壊されてしまう儚い存在なのは今も変わっていない。\n\nhttps://drive.google.com/drive/u/0/folders/1FNTrX9O_9vLsbENGrQUgrIes4W2DMuRV", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@V0_ID11/works/9", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3637942, "client_id": 2933154, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/4824982c/uploads/origins/49019d9e-bf5f-47b8-b42a-80d0577aac5f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=eb5a90eaaa4a71b1e8912045b2de8974", "srcset": "https://si.imgix.net/4824982c/uploads/origins/49019d9e-bf5f-47b8-b42a-80d0577aac5f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=eb5a90eaaa4a71b1e8912045b2de8974, https://si.imgix.net/4824982c/uploads/origins/49019d9e-bf5f-47b8-b42a-80d0577aac5f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=d9aa1f1f802b1062ea65dae177ec7bd5 2x, https://si.imgix.net/4824982c/uploads/origins/49019d9e-bf5f-47b8-b42a-80d0577aac5f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a0f34afb12743a076a53294533cf8cc5 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/4824982c/uploads/origins/49019d9e-bf5f-47b8-b42a-80d0577aac5f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=407087c8ea622446415efb6d171ada9f", "srcset": "https://si.imgix.net/4824982c/uploads/origins/49019d9e-bf5f-47b8-b42a-80d0577aac5f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=407087c8ea622446415efb6d171ada9f, https://si.imgix.net/4824982c/uploads/origins/49019d9e-bf5f-47b8-b42a-80d0577aac5f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=f1b580e5d44f56fe63eaf3e6f7e48ae6 2x, https://si.imgix.net/4824982c/uploads/origins/49019d9e-bf5f-47b8-b42a-80d0577aac5f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=d1356eed5ea44e4d31a23fd4857329ee 3x"}, "body": "はじめまして。\nCoCTRPGシナリオ「VOID」の探索者二名（HO1/HO2）を描いて頂きたいです。\n相手の方にはリクエストへの使用許可を頂いています。\n\n構図などすべておまかせします。\n一枚に二人納めるのが難しければ、一人ずつになっても大丈夫です。\n衣装もお任せしますが、迷ったら制服を着せてください。\n\n＊須炭大和（すた やまと）\n職業：刑事\n年齢/性別：22歳/男性\n身長/体重：176cm/70kg\n\n真面目で真っ直ぐ、ドが付くほどの負けず嫌いの新人刑事。\n溌剌としている。短気で時々頑固。\n\n発想は大変柔軟だがそれゆえに飛び出しがち。\n対岸に怪しい人影がいたら川に飛び込むとか。\n証拠が揃っていないのに犯人を尾行するとか。\n\n＊蒼月（そうげつ）\n職業：刑事\n年齢/性別：外見20代前半/男性型\n身長/体重：175cm/85kg\n\n落ち着いていて穏やか、誰にでも丁寧な態度で接する新型アンドロイド。\n人とほとんど変わらない見た目で、飲食や呼吸などを擬似的に行う事も出来る。\n\n周囲が引くほどのチョコミント好きで、\nその狂信具合は共に行動しているバディに限らず、\n先輩や先輩アンドロイドすらも恐怖させた。\n\n外見などは資料を参照ください。\n問題があれば再送/キャンセル下さって構いません。\nよろしくお願い致します。\n\nhttps://drive.google.com/drive/folders/1oT0yhmP1GJtzOHxkbMjPqNjx3EVc-Cua?usp=drive_link", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@V0_ID11/works/8", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3637942, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/f876ed0e/uploads/origins/441a823b-0dcc-42f5-a4e8-88d066bb724c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=235c28d4dad8f53cf7048454dee5ca6a", "srcset": "https://si.imgix.net/f876ed0e/uploads/origins/441a823b-0dcc-42f5-a4e8-88d066bb724c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=235c28d4dad8f53cf7048454dee5ca6a, https://si.imgix.net/f876ed0e/uploads/origins/441a823b-0dcc-42f5-a4e8-88d066bb724c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=32235dff9af42c5ef27a5bcdd76d4ac1 2x, https://si.imgix.net/f876ed0e/uploads/origins/441a823b-0dcc-42f5-a4e8-88d066bb724c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=81d68674c061e51f712635b221fc407f 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/f876ed0e/uploads/origins/441a823b-0dcc-42f5-a4e8-88d066bb724c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=28f80e1bb5e3db8ad3b94df2e8ad2d55", "srcset": "https://si.imgix.net/f876ed0e/uploads/origins/441a823b-0dcc-42f5-a4e8-88d066bb724c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=28f80e1bb5e3db8ad3b94df2e8ad2d55, https://si.imgix.net/f876ed0e/uploads/origins/441a823b-0dcc-42f5-a4e8-88d066bb724c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=41cbd224b87fa791fecd6827cba94365 2x, https://si.imgix.net/f876ed0e/uploads/origins/441a823b-0dcc