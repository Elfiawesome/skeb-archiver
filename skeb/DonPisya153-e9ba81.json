age", "creator_acceptable_same_genre": true}, {"path": "/@Zebulun_/works/579", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 263749, "client_id": 319387, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/e50a3334/uploads/origins/649065fc-181c-4b2e-9f61-9b8a1e458ea7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=81d6ccbf1791c0b9e4c73555ac8ac7f6", "srcset": "https://si.imgix.net/e50a3334/uploads/origins/649065fc-181c-4b2e-9f61-9b8a1e458ea7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=81d6ccbf1791c0b9e4c73555ac8ac7f6, https://si.imgix.net/e50a3334/uploads/origins/649065fc-181c-4b2e-9f61-9b8a1e458ea7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a90ed633889e038f7c5f476d4abe9649 2x, https://si.imgix.net/e50a3334/uploads/origins/649065fc-181c-4b2e-9f61-9b8a1e458ea7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=2d119ad71d154bd0c85106f6281bafeb 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/e50a3334/uploads/origins/649065fc-181c-4b2e-9f61-9b8a1e458ea7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6af60a6960aa6bb7f2b63404446bce43", "srcset": "https://si.imgix.net/e50a3334/uploads/origins/649065fc-181c-4b2e-9f61-9b8a1e458ea7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6af60a6960aa6bb7f2b63404446bce43, https://si.imgix.net/e50a3334/uploads/origins/649065fc-181c-4b2e-9f61-9b8a1e458ea7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=cf2c5b3c3e2a816abb39f19973a4887e 2x, https://si.imgix.net/e50a3334/uploads/origins/649065fc-181c-4b2e-9f61-9b8a1e458ea7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=20a0602cc4a3db7fee89b707d84e96e5 3x"}, "body": "先日はイラスト納品ありがとうございました。二回目となりますが、リクエストさせていただこうと思います。\n\nエマちゃん（通常スキン）が指揮官（前回と同じような中年の太った男）と抱き合って対面座位＋ベロチューしているイラストをお願いします。乳や腿の大きさは前回と同じくらいで大丈夫です。\n\n差分は２枚で、\n①上記の構図で、ハート目。挿入部分はスカートで隠れると思うので見えなくてもOKです。\n②男の胸元に顔をうずめながらエマちゃんに中出し。オス臭を嗅ぎながら中出しされているイメージで、エマちゃんにのみビクつき効果あり、受精吹き出しあり。ザーメンは滴り落ちるくらい多め。\n\nできればですが、今回も二人が寄り添う絵を一枚付けてほしいです。上記の事後のような状況で、エマちゃん（通常スキン）の口元にベロチューした後（よだれ跡など）の描写と、エマちゃんの股（スカートたくし上げ）と指揮官の竿からザーメンが垂れている感じでお願いします。\n\nご検討よろしくお願いします。", "nc": 176, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@marinekomimicat/works/117", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 478777, "client_id": 319387, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/fd32c4a7/uploads/origins/cd6991cc-7b94-4afa-b331-609596ef99e2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a45a9b1c95e47c20832f5148c56a4585", "srcset": "https://si.imgix.net/fd32c4a7/uploads/origins/cd6991cc-7b94-4afa-b331-609596ef99e2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a45a9b1c95e47c20832f5148c56a4585, https://si.imgix.net/fd32c4a7/uploads/origins/cd6991cc-7b94-4afa-b331-609596ef99e2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=4ba975c5323b5017cd5d6bc43491e2e7 2x, https://si.imgix.net/fd32c4a7/uploads/origins/cd6991cc-7b94-4afa-b331-609596ef99e2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f6b1d3e9378da78ba995611671452bd2 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/fd32c4a7/uploads/origins/cd6991cc-7b94-4afa-b331-609596ef99e2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=fd5feea41474c9f91cf9a2fcc2bdb9dd", "srcset": "https://si.imgix.net/fd32c4a7/uploads/origins/cd6991cc-7b94-4afa-b331-609596ef99e2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=fd5feea41474c9f91cf9a2fcc2bdb9dd, https://si.imgix.net/fd32c4a7/uploads/origins/cd6991cc-7b94-4afa-b331-609596ef99e2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=f1eb5d5942d84ab5ccdb7159e27d873a 2x, https://si.imgix.net/fd32c4a7/uploads/origins/cd6991cc-7b94-4afa-b331-609596ef99e2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=52a727140641dfe8d783f31d4836c161 3x"}, "body": "先日は素晴らしいイラストありがとうございました。\n三度目になってしまいますが、今回もエマちゃんのイラストをリクエストさせていただこうと思います。\n\n①エマちゃん（ふたなり）が男に目隠し竿をされて、チン嗅ぎしながらセルフパイズリをしてイくイラストをお願いします。\n②男の手をエマちゃんの頭に置き、あたかもチン嗅ぎさせているかのようにしてください。\n③エマちゃんの姿勢は、構図の都合上立膝や座っている等のポーズでも大丈夫ですのでお任せします。\n④男とエマちゃんが同時に射精しているようにしてください。男はぶっかけ無しでそのまま射精する感じで大丈夫ですが、エマちゃんは、以前marineさんがニジエにお上げになったウナちゃんのセルフパイズリイラストがすごく好きなので、あのような感じで描写していただければ嬉しいです。（竿の大きさや射精量も盛って欲しいです）\n⑤射精時は両乳からの母乳噴射とイキ顔もお願いします。\n⑥男はレイヤーを別にしてオンオフ切り替えられるようにお願いします。\n⑦エマちゃんの衣装について、身体は全裸ですが、今回髪型は資料にある通常衣装の方でお願いします。\n\n長くなってしまいましたが、ご検討よろしくお願いします。\n\nhttps://cdn.donmai.us/sample/dd/74/__emanuele_pessagno_azur_lane_drawn_by_kanda_done__sample-dd74d25d98331165cfe2045f5dceeb1d.jpg", "nc": 49, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Zebulun_/works/523", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 263749, "client_id": 319387, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/d66c7be2/uploads/origins/335894a4-c9be-48fb-bb4b-9971ad97fdb0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5bd481ed1ebdf73e04e9a6f890e858bf", "srcset": "https://si.imgix.net/d66c7be2/uploads/origins/335894a4-c9be-48fb-bb4b-9971ad97fdb0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5bd481ed1ebdf73e04e9a6f890e858bf, https://si.imgix.net/d66c7be2/uploads/origins/335894a4-c9be-48fb-bb4b-9971ad97fdb0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=189460369774ea77b86b8c67817a47bf 2x, https://si.imgix.net/d66c7be2/uploads/origins/335894a4-c9be-48fb-bb4b-9971ad97fdb0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d37a2e7ea1003b70dc23a30a9f9524fc 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/d66c7be2/uploads/origins/335894a4-c9be-48fb-bb4b-9971ad97fdb0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d093edbb44d7d1890afb95803b1b9ab0", "srcset": "https://si.imgix.net/d66c7be2/uploads/origins/335894a4-c9be-48fb-bb4b-9971ad97fdb0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d093edbb44d7d1890afb95803b1b9ab0, https://si.imgix.net/d66c7be2/uploads/origins/335894a4-c9be-48fb-bb4b-9971ad97fdb0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=380cb61bdeb223e981a5c67fa3de5433 2x, https://si.imgix.net/d66c7be2/uploads/origins/335894a4-c9be-48fb-bb4b-9971ad97fdb0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=bab09542f1ab818d390b068d367f198c 3x"}, "body": "はじめまして。アズレンのエマちゃんふたなり絵が凄く良かったのでリクエストさせていただこうと思います。\n\nふたなりエマちゃんと指揮官（太った中年男性風）がベロチューしながら、指揮官は片手でエマちゃんの乳を揉み、もう片手でふたなりちんぽを手コキして、エマちゃんは指揮官のちんぽを手コキしているイラストをお願いします。同時に射精する差分もお願いします。\n\nエマちゃんのちんぽの大きさはご自身がお描きになったふたなりエマちゃんくらいで、服は通常衣装でお願いします（服が厳しければ裸でも構いません）。\n乳の大きさは、揉み描写しやすいように盛っても大丈夫です。\n\nまた、二人が身体を寄り添って兜合わせして、こちら側を見てピースしている絵を1枚も添えていただけないでしょうか…！\n\nご検討よろしくお願いします……！", "nc": 32, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@marinekomimicat/works/95", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 478777, "client_id": 319387, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/1c724928/uploads/origins/cb6cc1da-eac5-440c-9faa-93071b9b2795?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=80b47322118033da1f64ade17a875280", "srcset": "https://si.imgix.net/1c724928/uploads/origins/cb6cc1da-eac5-440c-9faa-93071b9b2795?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=80b47322118033da1f64ade17a875280, https://si.imgix.net/1c724928/uploads/origins/cb6cc1da-eac5-440c-9faa-93071b9b2795?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=fc5593ff7cb93ef43240e24b113de62a 2x, https://si.imgix.net/1c724928/uploads/origins/cb6cc1da-eac5-440c-9faa-93071b9b2795?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a6457720e4996ffa443247606dce0b89 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/1c724928/uploads/origins/cb6cc1da-eac5-440c-9faa-93071b9b2795?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=93eccd7048504002e665d9b80556e0a1", "srcset": "https://si.imgix.net/1c724928/uploads/origins/cb6cc1da-eac5-440c-9faa-93071b9b2795?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=93eccd7048504002e665d9b80556e0a1, https://si.imgix.net/1c724928/uploads/origins/cb6cc1da-eac5-440c-9faa-93071b9b2795?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=4a5d7b63d860f68e6a5a0b94e88e45a1 2x, https://si.imgix.net/1c724928/uploads/origins/cb6cc1da-eac5-440c-9faa-93071b9b2795?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=47cdf8086e98f84f0a1abadb18de3f6f 3x"}, "body": "先日はリクエストにお答えいただきありがとうございます！\n今回も同キャラのイラストをリクエストしたいのですが、marine様のふたなりイラストがすごく良かったので、その関連のシチュでお願いします。\n\n【キャラ】エマヌエーレ・ペッサーニョ（アズレン）\n【シチュ】\n差分①：エマ（ふたなり）が目を瞑って男の竿を嗅いでおり、片方の手は自分の乳首を弄り、もう片方は自分の竿をしごいてる絵を描いてください。\n差分②：ちん嗅ぎでイく差分を描いてください。母乳噴射・エマの射精・イキ顔・男の射精によるぶっかけ（少なめ）の4点を描いてほしいです。\n胸露出・大きさは前回リクエストさせていただいたイラストと同じくらいで、エマの竿の大きさや射精量はmarine様のセルフパイズリイラスト目安でお願いします。玉もあると嬉しいですが、構図上難しそうであれば無くても大丈夫です。\n\nご検討をお願いします。（特殊性癖よりのリクエストになってしまった故、金額を少し上げました）\n\nhttps://cdn.donmai.us/origina