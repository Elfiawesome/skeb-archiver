d-b9c3-dbe9eeb02652?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0867e38accab7ef5dfa763a0f8d12118", "srcset": "https://si.imgix.net/28ff2165/uploads/origins/8953f820-2257-490d-b9c3-dbe9eeb02652?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0867e38accab7ef5dfa763a0f8d12118, https://si.imgix.net/28ff2165/uploads/origins/8953f820-2257-490d-b9c3-dbe9eeb02652?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=8a996d8ec34bc2c3e5bff819892ed435 2x, https://si.imgix.net/28ff2165/uploads/origins/8953f820-2257-490d-b9c3-dbe9eeb02652?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=a711f4621ff4dc59bcb3c2fb1b92a23f 3x"}, "body": "底ノ返様、はじめまして。\n偶然お見かけした、ケモ耳・碧眼のお兄さんのイラストがとても素敵で、目を惹かれました。\nもしよろしければわたしのOCを描いていただけないでしょうか。\n\n\nノクス(26)\n・167cm\n・黒兎の獣人、男、童顔\n・イメージカラーは黒色、金色\n・口が悪い、根は優しい 、ツンデレ\n・前髪長め、黒髪ショートカット\n・大きな黒い瞳\n・首に黒糸で編まれたレース状のチョーカーを着用\n・魔法使い (とても強い)\n\n\n\nキイチ(21)\n・189cm\n・灰狼の獣人、男、整った顔\n・イメージカラーは橙色\n・元気いっぱい、真っ直ぐ、人懐っこい\n・灰色と白色が混ざった短髪\n・アーモンド型の目元、焦茶色の瞳\n・魔法使い見習い\n\n\n\n◎魔法が使えるファンタジーな世界観\n◎キイチとノクスは同じ魔法士団に所属、上司と部下兼恋人\n◎ノクスはいつもツンデレ全開、キイチはいつも愛情全開\n◎SNS(X)、小説投稿アプリ(アルファポリス)での使用、印刷して個人鑑賞を予定しています\n\n\nご検討よろしくお願いいたします。", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@sokono_atari/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3291054, "client_id": 3078470, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/5a492fdb/uploads/origins/17f7f5a1-e069-4948-b164-447634c0a11c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=868f1b322d6228f2968bcda5dc70a531", "srcset": "https://si.imgix.net/5a492fdb/uploads/origins/17f7f5a1-e069-4948-b164-447634c0a11c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=868f1b322d6228f2968bcda5dc70a531, https://si.imgix.net/5a492fdb/uploa