ent_visible": false, "total_appeals_count": 0, "received_works": [{"path": "/@utadori_5108/works/9", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3565601, "client_id": 2770463, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/edd5db36/uploads/origins/3b929c50-015b-4a47-98a5-d3375e7a78cd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=cfad7c2e492feed56a16611eabf46ea7", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/edd5db36/uploads/origins/3b929c50-015b-4a47-98a5-d3375e7a78cd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f05a0ce3a67093fe1db75e2523d79427", "src_set": ""}, "body": "こんにちは。\n以前は東風谷早苗を描いていただき、ありがとうございました。\n今回は 東方Projectの蓬莱山輝夜を描いていただくことは可能でしょうか。\n背景に満月を入れていただけますと幸いです。それ以外の構図や雰囲気につきましては、全て作家様にお任せいたします。\nご検討のほど、何卒よろしくお願いいたします。", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@utadori_5108/works/8", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3565601, "client_id": 3701362, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/383a5e86/uploads/origins/e0a74f63-d831-482f-a45b-76a8baea4f8e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fcc9245800c662d1f03dc94585cfbb09", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/383a5e86/uploads/origins/e0a74f63-d831-482f-a45b-76a8baea4f8e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3dbdf13c316d888caa505edecc8d2418", "src_set": ""}, "body": "はじめまして、しふぉんと申します。日頃からXでイラスト拝見させていただいております。雅楽鳥ことはさんの描く女の子がかなり可愛くて好きなので依頼させて頂きました！\n依頼内容なのですが、レミリア・スカーレットを描いていただきたいです。イラスト等に明るくないので、恐れ入りますが構図などは一任する形でお願いしたいと思っています。\n描いて頂いた際はX及びYouTubeでのアイコンに使用したいと考えています。お忙しい中恐縮ですが、どうかご検討の程よろしくお願いします。", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@utadori_5108/works/7", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/6df0ef7d/uploads/origins/365d6eed-415e-48d7-abf7-4f3fc5a50bf5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=f31e6494c5847cc8c0f5c0771a78a92b", "src_set": ""}, "private": true, "genre": "art", "tipped": false, "creator_id": 3565601, "client_id": 2772165, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 128, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@utadori_5108/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3565601, "client_id": 2770463, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/e625e0cb/uploads/origins/442f8f34-e923-4459-b766-5c225728e937?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=555cf5ffab67b5be5312dc76d4f7e062", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/e625e0cb/uploads/origins/442f8f34-e923-4459-b766-5c225728e937?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f3cb8fca237135478be08b9b8dbb757a", "src_set": ""}, "body": "はじめまして.\n\nできれば、東宝企画の小千谷さなえさんがメンヘラ（yamikawaii）スタイルのファッションを着ているイラストをお願いしたいです", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@utadori_5108/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3565601, "client_id": 0, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/dee4fcd4/uploads/origins/d8b6b1ed-cacb-4731-aea7-0f79efcb69a4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=cf0ecdc27b59a9eacf12fb139991d384", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/dee4fcd4/uploads/origins/d8b6b1ed-cacb-4731-aea7-0f79efcb69a4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=df1a3233d65ac6367cf7bf9934aba329", "src_set": ""}, "body": "初めまして、リクエスト失礼します。\nXで見た黒レミリア(https://x.com/utadori_5108/status/1882757790634274881?s=46)が可愛すぎて一目惚れしたのでリクエストさせていただきました。\n依頼内容は黒レミィのイラストで可愛ければ構図や表情などはお任せします。\nアイコンor壁紙に使用したいと考えおります。\nよろしくお願いしますm(_ _)m", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@utadori_5108/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3565601, "client_id": 1518238, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/ad334029/uploads/origins/9483fb97-f012-408e-ba53-56109b2aae32?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=51b04e44c4929b5625cc71b47d0f11f0", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/ad334029/uploads/origins/9483fb97-f012-408e-ba53-56109b2aae32?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=01c97af1ce969106ae760747c8a6b3d5", "src_set": ""}, "body": "こんにちは！あなたの画風に興味があります！私のVTuberモデルの衣装を描いていただけませんか？ポーズや構図はお任せします。自由に描いてください。\n\n赤い服の女の子は、もっとのんきで優しくて元気です。グレー／紫の服を着た女の子は、より攻撃的でストイックで憂鬱な感じです。\n\n可能であれば、レイヤーを分離した.psdファイルと透明な.pngファイルを添付していただけますか？\n\nhttps://drive.google.com/drive/folders/1jqTR6bKFDIJA6UoEl5wYrUjrBdVqhHHx?usp=drive_link", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@utadori_5108/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3565601, "client_id": 2566560, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/69ab58d3/uploads/origins/84cb0410-a4c7-4936-94b0-039339cd8739?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b549733d30b6ba45eff2dcd623908ae0", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/69ab58d3/uploads/origins/84cb0410-a4c7-4936-94b0-039339cd8739?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=347740348317ca01f41c77b3b97f2b06", "src_set": ""}, "body": "はじめまして、歌鳥先生！\n\n今日先生の絵を見て、一瞬で先生の作風に惚れました！\n\n東方projectの古明地こいしさんが一索の麻雀牌を持っているイラストを描いていただけませんか？\n\nこの牌はリーチ麻雀の規格なので、人差し指と薬指で挟んで楽に持てる大きさです。牌の絵は参考までに。\n\n普通の人の手と比べた牌の大きさは、こちらの記事を参考にしてください：\nhttps://x.com/m_l_treca/status/1905530302833066445\nタイルの大きさを変えてもかまいません。\n\n背景など細かい部分については、お好きなように描いてください。ただひとつお願いがあります！可能であれば、私の名前を書いたバージョンもお願いします。\n\n依頼内容に問題があれば、遠慮なくキャンセルしてください。\n金額に問題がある場合は、適切な金額を再送してください！\n\nご配慮ありがとうございました！\n\nhttps://drive.google.com/file/d/1VRL2y1-D6plm4iG56Wcw9lPM0zHGoser/view?usp=sharing", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@utadori_5108/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3565601, "client_id": 3576629, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/f3a58b7f/uploads/origins/3a9c6ca7-aa1d-4688-813b-5ba9cf9a610e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4c185bf39802bcca32702a9ee1544524", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/f3a58b7f/uploads/origins/3a9c6ca7-aa1d-4688-813b-5ba9cf9a610e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2f0190825d108c32d0bb835265b60652", "src_set": ""}, "body": "初めまして！ワヲンと申します\n個人Vtuberの「恋白るな」さんへプレゼントする為のイラストを描いて頂きたいです\n\n対象：恋白るな\n夏の雰囲気があるものでポーズや構図等はすべてお任せしますが\n胸は絶対に盛らないでください小さくなっても構いません\n資料・三面図\nhttps://www.siokazunoko.com/kohakuruna\nイラストが活動に使用される場合があります\nキャラクターだけの透過pngとPSDデータでいただけると幸いです\nご検討のほどよろしくお願いします\n\nhttps://www.siokazunoko.com/kohakuruna", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@utadori_5108/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3565601, "client_id": 2625461, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/9945a9f4/uploads/origins/347abc4a-3753-4f1f-b00a-96bbc31e1b35?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0876c532a3266e193077db7efe7fbfa0", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/9945a9f4/uploads/origins/347abc4a-3753-4f1f-b00a-96bbc31e1b35?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f73edf24962277d9c5b06f0a7b9e1851", "src_set": ""}, "body": "はじめまして。 今回はVliverの藍空きあらさん(@Kiara_no_heya)にファンアートをプレゼントしたいと思い、雅楽鳥ことは様のイラストをXでお見かけし、ぜひ描いていただきたくリクエストさせていただきました。 \n\n性格は元気、生意気、でも優しい。そんな感じです。\n雅楽鳥ことは様のイメージで描いていただければと思います。\n\n【使用用途】描いていただいたイラストの用途はご本人が配信・サムネイルへの使用 、X等での使用です。\n\n【その他】\n人物、背景などが分かれているデータでいただけますでしょうか。\n\n\n■ご本人様の資料が少ないのですが、参考URLを貼っておきます。\n\n以上、ご検討よろしくお願いします。\n\nhttps://x.com/Kiara_no_heya/status/1877287607362613322", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "similar_creators": [{"id": 771286, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "雲之えうん@Skeb募集中！コーヒー好きの絵描き", "screen_name": "euneien", "avatar_url": "https://pbs.twimg.com/profile_images/1834235799472390144/FqvE5tx-.jpg", "header_url": "https://pbs.twimg.com/profile_banners/137740512/1729107242/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": nul