rue}}}, "acceptable_only_public": false, "tip_acceptable": true, "yearly_report_client_visible": false, "total_appeals_count": 0, "received_works": [{"path": "/@tisshu1122/works/10", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3734110, "client_id": 929001, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/fde7c7f7/uploads/origins/d84ce6fa-e4ed-4f70-864a-bf7bdec69cba?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2219c9b7252b292f56b9ea13b11ce3f7", "srcset": "https://si.imgix.net/fde7c7f7/uploads/origins/d84ce6fa-e4ed-4f70-864a-bf7bdec69cba?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2219c9b7252b292f56b9ea13b11ce3f7, https://si.imgix.net/fde7c7f7/uploads/origins/d84ce6fa-e4ed-4f70-864a-bf7bdec69cba?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=71a79a09ffc0bbcd4d5280c89dd621c9 2x, https://si.imgix.net/fde7c7f7/uploads/origins/d84ce6fa-e4ed-4f70-864a-bf7bdec69cba?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=4d5d1ccffbad6bd750d85c97e6e8530e 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/fde7c7f7/uploads/origins/d84ce6fa-e4ed-4f70-864a-bf7bdec69cba?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=247340c27e0441eaccbe07a3f08024ff", "srcset": "https://si.imgix.net/fde7c7f7/uploads/origins/d84ce6fa-e4ed-4f70-864a-bf7bdec69cba?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=247340c27e0441eaccbe07a3f08024ff, https://si.imgix.net/fde7c7f7/uploads/origins/d84ce6fa-e4ed-4f70-864a-bf7bdec69cba?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=b835ae7e7d65673d4ca6b7b124353004 2x, https://si.imgix.net/fde7c7f7/uploads/origins/d84ce6fa-e4ed-4f70-864a-bf7bdec69cba?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=627f2d579043ffa9b797fb0022295d5d 3x"}, "body": "いつも作品にお世話になっております！　リクエストさせていただきます！\n\nお腹を壊して限界で漏れそうな金髪ギャルJKちゃんが、和式トイレで下痢ウンチとおしっこをブリブリジョボジョボ排泄するシーンをカラーのイラスト形式でお願いしたいです。\n排泄時の効果音（ブリブリなど……）は必ず描写してほしいです。\n\n・容姿、服装\n以前先生が描いていらっしゃったこちら（https://www.pixiv.net/artworks/135865533）のようなギャルっぽい強気なJKちゃんでお願いします。\n服装はこちら（https://booth.pm/ja/items/4956440）のブレザー制服と黒のニーハイソックスで、下着はシンプルな白のパンツを履いていると嬉しいです。\n\n・シチュエーション\n放課後、下校しようとしたところ急な腹痛で下痢になってしまったギャルJKちゃん。\n教室近くのトイレではウンチの音とニオイで下痢だと同級生にバレてしまい恥ずかしいので、普段は誰も使わない旧校舎の和式トイレまで急いで向かう。\n何とかトイレにたどり着き、プリプリプスプスとオナラを漏らしながらパンツを下ろしてしゃがみ込み、一気に下痢ウンチを排泄。\n安堵の表情を浮かべブリブリビチビチと下痢ウンチ排便を続け、ひと段落。\nお腹の奥に残っていたオナラをしつつ、おしっこも排尿。\nようやく落ち着き、トイレットペーパーでおまんことお尻を拭く。\n\n・排泄シーンの構図\n他者様の作品で申し訳ありませんが、排泄シーンはこちらのイラスト構図に似せてください（参考URL→https://www.pixiv.net/artworks/96102727）\n\n以上です。\n是非、ご検討のほど、よろしくお願い致します。", "nc": 161, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@tisshu1122/works/9", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/997779a2/uploads/origins/579534c7-9062-4ad8-ad40-e962e091e3a5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=5d9c20ba6fa6799bf42f8ec98479d1ef", "srcset": "https://si.imgix.net/997779a2/uploads/origins/579534c7-9062-4ad8-ad40-e962e091e3a5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=5d9c20ba6fa6799bf42f8ec98479d1ef, https://si.imgix.net/997779a2/uploads/origins/579534c7-9062-4ad8-ad40-e962e091e3a5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=4c9edff5657bd99c75944ffd4063a6ef 2x, https://si.imgix.net/997779a2/uploads/origins/579534c7-9062-4ad8-ad40-e962e091e3a5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=69d2e99652f829b42acb9bf6466abb65 3x"}, "private": true, "genre": "art", "tipped": true, "creator_id": 3734110, "nc": 177}, {"path": "/@tisshu1122/works/8", "private_thumbnail_image_urls": null, "private": false, "genre": "comic", "tipped": true, "creator_id": 3734110, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/0cee1de6/uploads/origins/8c117f11-bb83-4485-8b97-b44c23ded153?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bff98ca0ff3c23a17d926f8161266a42", "srcset": "https://si.imgix.net/0cee1de6/uploads/origins/8c117f11-bb83-4485-8b97-b44c23ded153?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bff98ca0ff3c23a17d926f8161266a42, https://si.imgix.net/0cee1de6/uploads/origins/8c117f11-bb83-4485-8b97-b44c23ded153?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=6b1b4a3490762d7ee23f44610a2376e5 2x, https://si.imgix.net/0cee1de6/uploads/origins/8c117f11-bb83-4485-8b97-b44c23ded153?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=2fd0400e377a8d8e149cb370ffe9f7dd 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/0cee1de6/uploads/origins/8c117f11-bb83-4485-8b97-b44c23ded153?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2e736d9b09fd9b23e403efa99708a9c9", "srcset": "https://si.imgix.net/0cee1de6/uploads/origins/8c117f11-bb83-4485-8b97-b44c23ded153?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2e736d9b09fd9b23e403efa99708a9c9, https://si.imgix.net/0cee1de6/uploads/origins/8c117f11-bb83-4485-8b97-b44c23ded153?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=c5f161352150eb77f019934f3ff1606d 2x, https://si.imgix.net/0cee1de6/uploads/origins/8c117f11-bb83-4485-8b97-b44c23ded153?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=abb6a94372b8c57496fd24b827917a1b 3x"}, "body": "ポケットティッシュを取り出す先生、初めまして。お願いしたいリクエストがありますので、お許しください。\n\n【キャラ】\n津島善子（ラブライブ！サンシャイン！！）\n\n【衣装】\n浦女冬制服+上履き\nパンツ：白（汚れなし）\n髪型や制服のディテールなど、可能な限り設定通りに再現してください。\n参考URL：\nhttps://imgur.com/a/ojGqUql\nhttps://drive.google.com/drive/folders/1NJPBCJJUfrShsG5t-IomWiV50tio-OzO\n（内容は同じです）\n\n【ジャンル】\n全3部構成で、第1部と第3部はコミック（白黒・カラー問わず）。第2部は数点のバリエーションがあるイラスト（カラー）です。\n第1部および第3部のコミックのページ数は、状況に応じてご自身で調整してください。\n\n【シーン】\n以下、時系列順に並べます：\n●第1部：善子は授業中にお腹が痛くなり、便意を我慢していた。授業が終わると、学校の洋式トイレの個室に駆け込み、下痢を始めた。（3ページほど）\n●第2部：片手でお腹を押さえ、もう片方の手の位置はお任せです。時間順にAからEの5種類の差分があります。表情、排泄の状態、文字のみ違い、それ以外は全く同じです。\n\nA：泥下痢\nB：下痢が止まったけど、まだちょっと気分が悪い\nC：第二波の下痢（液状）\nD：下痢がほぼ終了した\nE：おしっこ\n\nAからEまでの表情はそれぞれ異なります。それぞれに簡単なセリフ（思考内容）を付け加えることも、付けないこともできます。\n\n可能であれば、（https://www.pixiv.net/artworks/136977254）を参考に、便器の不透明版と透明版を用意してください。透明版の便器については、中身が時系列に沿って変化するようにお願いします。\n\n●第3部：善子は尻を拭き、下着を履き直してトイレを出たが、教室に戻る前に腹痛と便意が再び襲ってきたため、再びトイレに戻り、下痢を続けた。（2ページほど）\n\n【納品形態】\n●可能であれば、PSDファイルをご提供ください。\n●PSDファイルが提供できない場合、第2部について、文字の有無のバージョンをご用意ください。可能であれば、便器の不透明版と透明版を用意してください。\n\n上記が複雑で申し訳ございません、ご検討いただければ幸いです。\n\nhttps://imgur.com/a/ojGqUql", "nc": 177, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@tisshu1122/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3734110, "client_id": 3545577, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/4706fc82/uploads/origins/f87b71e3-b702-4120-b6f0-a186f90c1d9e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c3d5931b97e21b8da09a845dae48d87a", "srcset": "https://si.imgix.net/4706fc82/uploads/origins/f87b71e3-b702-4120-b6f0-a186f90c1d9e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c3d5931b97e21b8da09a845dae48d87a, https://si.imgix.net/4706fc82/uploads/origins/f87b71e3-b702-4120-b6f0-a186f90c1d9e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e572de600edbbd16520823145983e093 2x, https://si.imgix.net/4706fc82/uploads/origins/f87b71e3-b702-4120-b6f0-a186f90c1d9e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=70b27c21b743634cf0a2821019ad8c3e 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/4706fc82/uploads/origins/f87b71e3-b702-4120-b6f0-a186f90c1d9e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=8def4bbc9be2f531433002a56890e735", "srcset": "https://si.imgix.net/4706fc82/uploads/origins/f87b71e3-b702-4120-b6f0-a186f90c1d9e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=8def4bbc9be2f531433002a56890e735, https://si.imgix.net/4706fc82/uploads/origins/f87b71e3-b702-4120-b6f0-a186f90c1d9e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=a44c9966bab5345fb7dc865e03621773 2x, https://si.imgix.net/4706fc82/uploads/origins/f87b71e3-b702-4120-b6f0-a186f90c1d9e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=ded4af4a858b3e14948454d955e70f8a 3x"}, "body": "こんにちは。このキャラクターが、ぐちゃぐちゃとした塊状の下痢をしているカラーイラストを、5つの違いを入れて作成してほしいです。\n\nhttps://www.pixiv.net/en/artworks/111296882\n\n彼女は公共のシャワー室に立ち、黒いビキニを着ていますが、下は太ももまでずり下がっており、そのぽっちゃりしたお尻が視聴者の方を向いています！彼女は排便を我慢しようと尻を握りしめており、お腹がひどく痛んでいます。人前でこれほどまでに便意を催してしまっていることに恥ずかしさを感じています\n\n1. 彼女は太ったお尻をこすりながらうめき声を上げ、肛門をきゅっと締めている\n\n2. 糞が尻から押し出され始め、彼女はそれを止めようとさらに強く尻を締め付けている\n\n3. 彼女は大量の塊状の糞を排泄し、泣き叫んでいる\n\n4. 便が泥状／水っぽくなり、お尻や太ももをひどく汚しながら、うめき声を上げている\n\n5. 排泄が終わり、安堵した様子だが、お尻からは便が滴り落ち、太ももはひどく汚れている", "nc": 48, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@tisshu1122/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "comic", "tipped": true, "creator_id": 3734110, "client_id": 1776190, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/e8e05385/uploads/origins/7eb2cb4a-71f8-47d2-96fd-53930026c3d0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=902ab288b90293263836782598c54591", "srcset": "https://si.imgix.net/e8e05385/uploads/origins/7eb2cb4a-71f8-47d2-96fd-53930026c3d0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=902ab288b90293263836782598c54591, https://si.imgix.net/e8e05385/uploads/origins/7eb2cb4a-71f8-47d2-96fd-53930026c3d0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=4262e4e87f1a14e5859a47e90afba309 2x, https://si.imgix.net/e8e05385/uploads/origins/7eb2cb4a-71f8-47d2-96fd-53930026c3d0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=07e70023f6f15991d19b2e03954e7adc 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/e8e05385/uploads/origins/7eb2cb4a-71f8-47d2-96fd-53930026c3d0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=4f978ba6183c532bc8199fd2923274ef", "srcset": "https://si.imgix.net/e8e05385/uploads/origins/7eb2cb4a-71f8-47d2-96fd-53930026c3d0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=4f978ba6183c532bc8199fd2923274ef, https://si.imgix.net/e8e05385/uploads/origins/7eb2cb4a-71f8-47d2-96fd-53930026c3d0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=59e55f1d30366549e705e6325226c628 2x, https://si.imgix.net/e8e05385/uploads/origins/7eb2cb4a-71f8-47d2-96fd-53930026c3d0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=9bf476c0386b5941192facdd71897d42 3x"}, "body": "いつも素敵なイラストを拝見しております。先生の漫画内での丁寧な描写、かわいい作画に毎度興奮させられております。この度リクエストを送らせていただきますので、確認をよろしくお願いします。\n\n【シチュエーション】\n①便意を催した大人しめの女子高生主人公が、人気のない体育館裏トイレに向かう。\n②トイレの中には2つの個室とその中で排泄中の先客と順番待ちをしている女子生徒が1人立っている。個室内の先客はどちらも排泄音を出しながら排便しており、前に並んでいる子もお腹を押さえ少しおならを漏らしながら我慢している。\n③個室が空き交代で並んでいた子が入る。緩めの排便音が響き、聞いているとお腹が刺激される。\n④しばらく経つと先程の隣の個室が空き、小柄で小動物のような可愛らしい生徒が出てきて、恥ずかしそうにそそくさと立ち去る。\n⑤個室に入ると濃い便臭と、和式便器に残る茶色い筋がはっきり残っており、「さっきの可愛い子もこんな臭くて汚いうんちするんだ……」と不思議と高揚した気持ちになる。\n⑥和式トイレを跨ぎ、音が響くことに恥ずかしさを感じつつ、固形便→ちょっと緩めの便の流れで排便する。ゆるい便は、便器の中に飛び散り、先程の生徒と同じく便器を汚してしまっている。\n⑦排便を終え個室から出ると、大人しげな生徒が順番待ちをしており、その子が個室に入ったあとの大きな排便音を背に、手を洗い立ち去る。\n\nという流れの漫画を描いていただきたいです。細かい描写を多々入れてしまい申し訳ないです。都合上変更、描写できない所があれば改変していただければと思います。\n\n【細かい指定】\n・キャラクターですが、先生の他作品にすごく好みの子がいるので、可能でしたらその子に似た容姿で、もしくはその子を登場させていただけるとありがたいです。\n主人公は秋恋乃葉ちゃん、小動物チックな子は白川ことちゃんのようなキャラクターにしていただきたいです。その他の子はお任せします。性癖の関係で眼鏡キャラは避けていただきたいです。\n\n以上がリクエスト内容になります。金額不足の場合は、再送依頼をしていただければ幸いです。何卒ご検討の程よろしくお願いします。", "nc": 184, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@tisshu1122/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3734110, "client_id": 1539627, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/a06b3c65/uploads/origins/e20dc18f-53fd-4dea-b948-a0e6634dd644?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=590f84662efa029fa2e930dbde47f4b8", "srcset": "https://si.imgix.net/a06b3c65/uploads/origins/e20dc18f-53fd-4dea-b948-a0e6634dd644?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=590f84662efa029fa2e930dbde47f4b8, https://si.imgix.net/a06b3c65/uploads/origins/e20dc18f-53fd-4dea-b948-a0e6634dd644?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=60a5d21ab26f00953874c54ea093b88c 2x, https://si.imgix.net/a06b3c65/uploads/origins/e20dc18f-53fd-4dea-b948-a0e6634dd644?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d051d82ac2819acfe42103f1c42bc0f8 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/a06b3c65/uploads/origins/e20dc18f-53fd-4dea-b948-a0e6634dd644?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=94a58e2b39db87cffbf1455b666df010", "srcset": "https://si.imgix.net/a06b3c65/uploads/origins/e20dc18f-53fd-4dea-b948-a0e6634dd644?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=94a58e2b39db87cffbf1455b666df010, https://si.imgix.net/a06b3c65/uploads/origins/e20dc18f-53fd-4dea-b948-a0e6634dd644?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=552c59c55829c95161cb8767cdca0598 2x, https://si.imgix.net/a06b3c65/uploads/origins/e20dc18f-53fd-4dea-b948-a0e6634dd644?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=8060efd0a79ade87ef5b4d765b72436d 3x"}, "body": "ポケットティッシュを取り出す先生はじめまして！先生のイラストいつも拝見させていただいています！うちのこの大スカのリクエストをカラーで依頼します！\nhttps://drive.google.com/file/d/1VbcNEyg3NzIexcc_Dq3teDiSiOGun9nu/view?usp=drivesdk\nこの資料を参照してください。服装もリボン以外は資料の通りで、リボンはオレンジ色でパンツは薄いオレンジ色でお願いします。名前は天ヶ瀬桜彩(あまがせさや)です。容姿端麗でマドンナ的存在で優等生な女の子です。\n以下シーンです。\n放課後、天ヶ瀬桜彩が担任の先生にクラスのことでお願いをされて手伝っていたら、急にお腹が下した時の痛みに襲われ、先生に言ってトイレに行くが、女子トイレが全て使用禁止になっていた、1度痛むお腹を抱え教室に戻った時に波が来てしゃがんでしまい、先生に助けを求めて、先生から男子トイレしかないわね…と言われて、先生の肩を借りながら、トイレに行き大量の下痢を激しく音を響かせながら出す(第1波と第二波で水下痢と泥下痢)\n排泄・腹痛擬音と排泄中のセリフは先生のおまかせで、セリフは以下の感じでお願いします。\n桜彩→(何…これ…お腹…いたい…！)\n先生、お手伝いしてる時に申し訳ないのですが、お手洗いに行ってきてもいいですか？\n(うそ…！女子トイレ使用禁止！？)\n先生…女子トイレ使えないんですけd…うぐっ！？\n先生→ええ、どうぞ行ってらっしゃい。\nえ！？ちょっと桜彩さん大丈夫！？女子トイレが使えないの！どうしましょう…\n…男子トイレを使うしかないわね…桜彩さん私の肩につかまって…\n先生ここにいるから、何かあったら言ってね…恥ずかしいと思うけど…\nあとは陰毛なしで便器は出来れば透過したものをお願いします\n構図は先生が以前書いたこちらのトイレシーンでhttps://www.pixiv.net/artworks/135865533 でお願いします\nうちのこの情報を載せときます。\n体質などは少しお腹は弱く、しょっちゅう下痢をしているというのはないが緩いのが出ることが多く、出す量も多い。時にお腹を下してしまって、音を響かせてしまうこともある。和式が苦手で洋式が空いてなければ使い、人目のつかない場所のトイレを使うことが多い。\nシーンが複雑ではありますがよろしくお願いいたします", "nc": 33, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@tisshu1122/works/4", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/f0fb29b8/uploads/origins/70db64c8-2c7d-4695-bc4c-c723ac0ec643?bg