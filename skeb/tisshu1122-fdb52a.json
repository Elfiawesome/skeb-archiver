ator_acceptable_same_genre": true}, {"path": "/@tisshu1122/works/2", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/ebce1478/uploads/origins/5e0f8c74-3766-4277-85a6-b332fba00a1f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=ab799c1e2d9f550fdf3555a828c4a6b6", "srcset": "https://si.imgix.net/ebce1478/uploads/origins/5e0f8c74-3766-4277-85a6-b332fba00a1f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=ab799c1e2d9f550fdf3555a828c4a6b6, https://si.imgix.net/ebce1478/uploads/origins/5e0f8c74-3766-4277-85a6-b332fba00a1f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=3df6dfa57352b2249205970d72f9bb73 2x, https://si.imgix.net/ebce1478/uploads/origins/5e0f8c74-3766-4277-85a6-b332fba00a1f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=e1fc84992ab2bd5956dcc80c89e4c9d0 3x"}, "private": true, "genre": "comic", "tipped": false, "creator_id": 3734110, "nc": 176}, {"path": "/@tisshu1122/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "comic", "tipped": true, "creator_id": 3734110, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/aed85109/uploads/origins/6ff019d7-301f-49d6-bb92-70f416b8a8ad?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=092895f8e119b9370d2f01833637bc3d", "srcset": "https://si.imgix.net/aed85109/uploads/origins/6ff019d7-301f-49d6-bb92-70f416b8a8ad?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=092895f8e119b9370d2f01833637bc3d, https://si.imgix.net/aed85109/uploads/origins/6ff019d7-301f-49d6-bb92-70f416b8a8ad?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e53eba90c22d381700e5ef74cbe19850 2x, https://si.imgix.net/aed85109/uploads/origins/6ff019d7-301f-49d6-bb92-70f416b8a8ad?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f5aca451512b06c4a30c6035bb70c89d 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/aed85109/uploads/origins/6ff019d7-301f-49d6-bb92-70f416b8a8ad?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=8723371d0347c996636d6ea0af5b199a", "srcset": "https://si.imgix.net/aed85109/uploads/origins/6ff019d7-301f-49d6-bb92-70f416b8a8ad?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=8723371d0347c996636d6ea0af5b199a, https://si.imgix.net/aed85109/uploads/origins/6ff019d7-301f-49d6-bb92-70f416b8a8ad?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=90f5f91801752d7b6227ef2afb2a250f 2x, https://si.imgix.net/aed85109/uploads/origins/6ff019d7-301f-49d6-bb92-70f416b8a8ad?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=d3a43db1fce7c7274541e97b7da8194e 3x"}, "body": "はじめまして。描かれている緊張感ある作風がとても好みなので、リクエストさせていただきたいと思いました！\n女性のトイレでの放尿シーンを4ページ程のモノクロ漫画形式でなのですがお願いできますでしょうか。\n\n【登場キャラ】\n・部活顧問の女性教師（女性らしくて気立てが良い）と生徒の男の子（モブ）\n【シチュエーション】\n・部活の合宿所の古びた男女共同和式トイレの個室で男子生徒が用を足し終え出ようとしていたところ、\n密かに好意を抱いている顧問の先生の声がしてトイレに入って来て、終わるまで息をひそめてその場にとどまることに。\n【構図】\n・仕切り板を挟んで隣り合った個室を両方見渡しているような構図・背景で、終始を描く感じでお願いいたします。（先生の個室の方が大きい面積だと嬉しいです）アングルはお任せいたします。\n・1ページで数コマずつじっくり進むような感じを想定していますが、お任せいたします！\n【トイレシーン】\n・先生が共同トイレに戸惑いながらも限界なので入ってきて、カギを閉めます。\n・ハーフパンツを脱いでしゃがみ、放尿音を消す為水洗レバーを押して水を流しながらおしっこを勢いよく大量に出します。\n・ペーパーを取り、拭いて服を整えて、退出します。\n・水洗音の「ザーーーー」や放尿音の「シュイイィーーッ」などの効果音もお願いします。\n・個室内では先生は無表情です。\n・隣の生徒の行動ですが、スマホで思わず録画、と考えているのですがお任せいたします。\n\n以上、地味なシチュエーションの依頼で大変恐縮ですが、ご検討いただければと思います！", "nc": 161, "word_count": 0, "trans