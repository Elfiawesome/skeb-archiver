b7bc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b6da604f5dcfcf420510e3eed7ab3667", "srcset": "https://si.imgix.net/c5bf253e/uploads/origins/b2198910-c15e-4825-a501-3fef9c5ab7bc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b6da604f5dcfcf420510e3eed7ab3667, https://si.imgix.net/c5bf253e/uploads/origins/b2198910-c15e-4825-a501-3fef9c5ab7bc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=574cafdece8887ca4b4b109cdac7b206 2x, https://si.imgix.net/c5bf253e/uploads/origins/b2198910-c15e-4825-a501-3fef9c5ab7bc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=f3db57337101cd8bcbaf53f6106e426c 3x"}, "body": "リクエストさせていただきます\n黒髪ウルフのクール系女性の下痢便故意お漏らしをお願いしたいです\n\n・キャラ設定、容姿\n年齢は20代前半\n高身長で黒髪ウルフカットのクール系女性\n服装の上は黒の長袖、下はジーンズ\n胸は小さいがお尻が少し大きい\n便意我慢や着衣脱糞で興奮する\n\n・シチュエーション\n家のトイレの中で浣腸(もしくは下剤)をする、そして服を着たままフタの空いた洋式便座に座る\n下痢が降りてきてお腹が痛くなるが放屁やお腹をさすり我慢する\n我慢するが徐々に放屁も水っぽくなっていきついに限界が来てしまう\n服を着たまま下痢便を漏らす、ジーンズが膨らみ下痢便がお尻いっぱいに広がる\n出し終わったと思ったらぶり返しさらに出してしまいジーンズの上部分から下痢便が垂れる\n排泄が終わったら気持ちよさそうな顔をして放屁して終了\n\n・その他\n出した際のお尻アップがあると助かります\n容姿と行為のギャップがあればあるほど良いです\n便の形状は下痢、便や放屁の量は多めでお願いします\n表情は我慢時は苦しそうな、決壊時は苦しさと気持ちよさが混ざった感じでお願いします\n故意お漏らしであれば多少内容を描きやすいように変えていただいても大丈夫です、検討の程よろしくお願いいたします", "nc": 177, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@tisshu1122/works/15", "private_thumbnail_image_urls": null, "private": false, "genre": "comic", "tipped": true, "creator_id": 3734110, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/2867ad25/uploads/origins/78f267ae-608a-4e4f-bad2-20497a6e1491?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=aaee0a4ce59cbb457f4937b083a03540", "srcset": "https://si.imgix.net/2867ad25/uploads/origins/78f267ae-608a-4e4f-bad2-20497a6e1491?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=aaee0a4ce59cbb457f4937b083a03540, https://si.imgix.net/2867ad25/uploads/origins/78f267ae-608a-4e4f-bad2-20497a6e1491?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=70aa63bef8cab3bcc6fb70c550749235 2x, https://si.imgix.net/2867ad25/uploads/origins/78f267ae-608a-4e4f-bad2-20497a6e1491?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c0a4759aad19aa4606cc45cdab99aeb4 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/2867ad25/uploads/origins/78f267ae-608a-4e4f-bad2-20497a6e1491?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6ed8ef5b33d43a76957f82109dfe4d67", "srcset": "https://si.imgix.net/2867ad25/uploads/origins/78f267ae-608a-4e4f-bad2-20497a6e1491?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6ed8ef5b33d43a76957f82109dfe4d67, https://si.imgix.net/2867ad25/uploads/origins/78f267ae-608a-4e4f-bad2-20497a6e1491?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=4fb89f6bb5c81d23152e77e16cde6d7f 2x, https://si.imgix.net/2867ad25/uploads/origins/78f267ae-608a-4e4f-bad2-20497a6e1491?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=26c8a283e8ddba99be04824d97c4347b 3x"}, "body": "ポケットティッシュを取り出す先生、こんにちは。リクエスト失礼いたします。\n\n【テーマ】\n学校でAqours2年生の千歌・曜・梨子の3人がお腹を壊して下痢になる。\nモノクロコミック形式、可能なら8〜9ページ前後。\n\n梨子は千歌の前に座っており、曜は千歌の右側にいます。\n\n千歌はほんの少しだけ垂れ目です。梨子はつり目です。曜はつり目でも垂れ目でもありません。\n\n梨子は他2人より僅かに高身長・微貧乳・微長スカート（ただし、これらの違いはいずれもごくわずかです）。曜の下唇に影（ぷっくり感）を。\n\n参考URL\nhttps://drive.google.com/drive/folders/1JojNxRBCxvSd34U-jPzxonuNKD2Qk18b\n\n1年生（必ずしも使用する必要はありません）\nhttps://drive.google.com/drive/folders/1NJPBCJJUfrShsG5t-IomWiV50tio-OzO\n\n【場所】\nトイレは浦女の洋式トイレです（善子のリクエストで登場したトイレと同じものです）。\n\n「恥ずかしさや満室が理由で、体育館（あるいは他のどこか）の和式トイレへ駆け込む」展開の有無はお任せします。\n\n漏れや、トイレ以外の場所で排泄するシーンは避けたほうがよいでしょう。もしお好みであれば、少しだけ入れても構いません。\n\n【衣装】\n浦女冬制服+上履き\nパンツ：白（汚れなし）\n髪型や制服のディテールなど、可能な限り設定通りに再現してください。\n\n展開はお任せします。原因は前日にAqoursで集まった際のこと等、何でも構いません。\n\n1・3年生の登場もOKです（1・2年生は同じ2階で洋式トイレ共通のため）。1・2年生はリボン、3年生はスカーフを着用しています。いずれにせよ、2年生の3人をメインに描いてください（この3人のみでも可）。ただし、Aqours以外のメンバーがお腹を壊すといった描写は避けていただけますと幸いです。\n\n腹痛に関する描写をもう少し多くしてほしい。\n\n【納品】\nPSDは可能なら文字なし差分も希望しますが、無くても構いません。\n\n内容が複雑で恐縮ですが、ご検討いただけますと幸いです。\n\nhttps://drive.google.com/drive/folders/1JojNxRBCxvSd34U-jPzxonuNKD2Qk18b", "nc": 48, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@tisshu1122/works/14", "private_thumbnail_image_urls": null, "private": false, "genre": "comic", "tipped": true, "creator_id": 3734110, "client_id": 1776190, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/0148dc5a/uploads/origins/4a6daefa-3905-4f62-94b5-701f283d6226?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=db44989b0c7ec4dcfc73e8da11a6b5aa", "srcset": "https://si.imgix.net/0148dc5a/uploads/origins/4a6daefa-3905-4f62-94b5-701f283d6226?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=db44989b0c7ec4dcfc73e8da11a6b5aa, https://si.imgix.net/0148dc5a/uploads/origins/4a6daefa-3905-4f62-94b5-701f283d6226?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b36b17d5ef503e95864351584baf9a7f 2x, https://si.imgix.net/0148dc5a/uploads/origins/4a6daefa-3905-4f62-94b5-701f283d6226?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=91a14d7889193946dc3c678e4889b850 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/0148dc5a/uploads/origins/4a6daefa-3905-4f62-94b5-701f283d6226?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3448ea8532abaa610fbe8ddb0e903854", "srcset": "https://si.imgix.net/0148dc5a/uploads/origins/4a6daefa-3905-4f62-94b5-701f283d6226?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3448ea8532abaa610fbe8ddb0e903854, https://si.imgix.net/0148dc5a/uploads/origins/4a6daefa-3905-4f62-94b5-701f283d6226?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=16ffeccf8e804ace994859712e87ce9d 2x, https://si.imgix.net/0148dc5a/uploads/origins/4a6daefa-3905-4f62-94b5-701f283d6226?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=1c511c49997b21759f0a5cfe826dea93 3x"}, "body": "いつも素敵なイラストを楽しみにしております。先日描いていただいた漫画も最高に興奮致しました。また後ほどブースト、メッセージを送らせていただきます。\n今回はブルーアーカイブのキャラクターの漫画を依頼したいと考えております。一読いただき、可能であれば承認いただけるとありがたいです。\n\n【シチュエーション】\n湯雨先生の描かれたこちらの小説(https://www.pixiv.net/novel/show.php?id=20405580)の漫画化をお願いしたいと考えております。湯雨先生には、漫画家を依頼することについての承諾はいただいております。\n\n【詳細】\n・牢屋という設定ですが、服装は制服姿でお願いします。\n・ニコ以外のFOX小隊が牢屋のトイレで拝察をする際の描写が描かれていますが、可能であればその様子をイラストで描写していただけるとありがたいです。（オトギはあまり気にしていないようで、ごめんねーと断りをいれて使用していることが多い。ユキノも流石の適応力と言うべきか、特段気にしているようには見えない。クルミはかなり抵抗していたが、もう既に慣れているようだった。）\n・ニコの排泄物は多めで描いていただきたいです。\n・陰毛の描写をお願いします。\n\n以上が細かい指定になります。ブルーアーカイブについて詳しくない、趣味に合わない等あれば、今回はキャンセルしていただいても大丈夫です。何卒ご検討よろしくお願いします。", "nc": 49, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@tisshu1122/works/13", "private_thumbnail_image_urls": null, "private": false, "genre": "comic", "tipped": true, "creator_id": 3734110, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/61e27dbe/uploads/origins/db08a2ab-3502-4e4c-870e-1a8087756f15?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=805af8b12d8438f5b2b2dd2ed9cad0e3", "srcset": "https://si.imgix.net/61e27dbe/uploads/origins/db08a2ab-3502-4e4c-870e-1a8087756f15?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=805af8b12d8438f5b2b2dd2ed9cad0e3, https://si.imgix.net/61e27dbe/uploads/origins/db08a2ab-3502-4e4c-870e-1a8087756f15?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=9abd7c3529c7b10664f3ce7ea81686fd 2x, https://si.imgix.net/61e27dbe/uploads/origins/db08a2ab-3502-4e4c-870e-1a8087756f15?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=99d372ff0644512b80b900bdcfee10ba 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/61e27dbe/uploads/origins/db08a2ab-3502-4e4c-870e-1a8087756f15?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c0df5d585638a1870ac0c9b13c4b2071", "srcset": "https://si.imgix.net/61e27dbe/uploads/origins/db08a2ab-3502-4e4c-870e-1a8087756f15?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c0df5d585638a1870ac0c9b13c4b2071, https://si.imgix.net/61e27dbe/uploads/origins/db08a2ab-3502-4e4c-870e-1a8087756f15?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=b34fe35be25a2ba4de08c6b6dfc6c704 2x, https://si.imgix.net/61e27dbe/uploads/origins/db08a2ab-3502-4e4c-870e-1a8087756f15?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=1ff020b51dc736e70453a13007b87cbd 3x"}, "body": "ポケットティッシュを取り出す先生、こんにちは。リクエスト失礼いたします。\n\n【キャラ】\n園田海未\n\n【衣装】\n夏練習着：胸元に2本の赤いラインが入った（背中にもあるが）白の半袖Tシャツに。右の手首には赤白のリストバンドを着用し、足元はピンクの靴下に赤と白のスニーカーを履いています。\n\nパンツ：白（汚れなし）\n\n参考URL\nhttps://imgur.com/a/Hr6rKiQ\nhttps://drive.google.com/drive/folders/1vBh8Mw0pROS1p8ooytZPzearH9PWOOhF\n\n【シーン】\n全3部構成で、第1部と第3部はマンガ（モノクロ・カラー不問）、第2部は数点の差分があるカラーイラストです。なお、第1部と第3部のページ数は、展開（状況）に合わせてご自由に調整してください。\n\n第1部と第3部は、海未と穂乃果、ことりが一緒にいる場面にしてもいいし、海未が一人でトレーニングしている場面にしてもいい。友達を「ちゃん」で呼ぶ穂乃果やことりに対し、海未は付けずに呼ぶ。\n\n●第1部：千代田区神田の一帯（※特定の場所を具体的に描く必要はなく、どこかの街の風景と伝われば問題ありません）で練習（ランニング）中の海未は、お腹の不快感を無視して走り続けました。しかし途中で激しい腹痛と便意に襲われます。必死に探した末、小さな公園の和式公衆トイレに駆け込み。\n\n●第2部：時間順にAからFの6種類の差分があります。表情、排泄の状態、文字のみ違い。\n\nA：泥下痢\nB：下痢と腹痛が徐々に止まっております\nC：おしっこ。腹を壊した原因を考えた\nD：腹痛と腸鳴が再び起こる\nE：第二波の下痢（液状）\nF：下痢が止まったけど、まだちょっと気分が悪い\n\n具体的な構図はお任せしますが。\n\n可能であれば、一部の差分で状況に応じて腕や手の位置を変更してください。無理（不可能な場合）ならそのままで構いません。\n\n●第3部：尻を拭き、水を流し、ズボンを履いてトイレから出た。したしかし腹痛と便意に耐えかね、間もな再びトイレに戻り、水下痢（量は多すぎないように）に見舞われました。\n\n【納品】\n●可能であればPSDファイルをご提供ください。\n●可能であれば、文字を別のレイヤーに配置してください（特に第2部）。\n\n上記が複雑で申し訳ございません、ご検討いただければ幸いです。\n\nhttps://imgur.com/a/Hr6rKiQ", "nc": 49, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@tisshu1122/works/12", "private_thumbnail_image_urls": null, "private": false, "genre": "comic", "tipped": true, "creator_id": 3734110, "client_id": 1776190, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/b13042bf/uploads/origins/abb9b2fa-6141-472d-9d3d-71b1a6fbae59?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6b324368afb54aa5bbef26eb00196aa0", "srcset": "https://si.imgix.net/b13042bf/uploads/origins/abb9b2fa-6141-472d-9d3d-71b1a6fbae59?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6b324368afb54aa5bbef26eb00196aa0, https://si.imgix.net/b13042bf/uploads/origins/abb9b2fa-6141-472d-9d3d-71b1a6fbae59?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=6969a1f30799d545f4acbe48c7bf4fb0 2x, https://si.imgix.net/b13042bf/uploads/origins/abb9b2fa-6141-472d-9d3d-71b1a6fbae59?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e1f1369718caec01982254a6caca86be 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/b13042bf/uploads/origins/abb9b2fa-6141-472d-9d3d-71b1a6fbae59?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0db585f42f0cb7b5862d48ec78652ec1", "srcset": "https://si.imgix.net/b13042bf/uploads/origins/abb9b2fa-6141-472d-9d3d-71b1a6fbae59?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0db585f42f0cb7b5862d48ec78652ec1, https://si.imgix.net/b13042bf/uploads/origins/abb9b2fa-6141-472d-9d3d-71b1a6fbae59?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=04e217cf18bf0f0d1a99630369bfe079 2x, https://si.imgix.net/b13042bf/uploads/origins/abb9b2fa-6141-472d-9d3d-71b1a6fbae59?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=e891b470208083ce15c14f8e5b1f4923 3x"}, "body": "いつも素敵なイラストを拝見しております。先日は素敵なイラストをありがとうございました。とても興奮して何度も使わせてもらっています。今回募集再開ということで、新しいリクエストを送らせていただきます。\n\n【シチュエーション】\n①下校中の女子高生が便意を催し公園の公衆トイレへ向かう。\n②トイレの中には先客がおり、排泄音を出しながら排便している。個室の中には濃い便臭が漂っている。\n③トイレットペーパーを巻く音やおしりを拭く音は聞こえるが、一向に水が流れない。\n④しばらく経つと個室が空き、小柄な可愛い女子高生が出てくる。主人公に気付くと驚いた表情を浮かべ、トイレの水が流れないことを恥ずかしそうに伝え、足早にその場を立ち去る。\n⑤和式便器にはその子が残した形が残り気味の緩めの便と、便器後方にOBしたまま放置された軟便が残されているが、我慢できない主人公はそのまま便器を跨ぎ排泄を始める。\n⑥便器から漂う臭いに堪えながら、主人公は形のしっかり残った便とお腹に溜まっていた緩めの便を排泄し、先客の軟便の上に重なっていく。\n⑦すっきりしてお尻を拭こうとすると、ノックの音が響く。素早く後始末をして慌てて個室から出て、惨状を説明しようとすると、我慢の限界な女子生徒が駆け込みドアが開いたまま排泄をしだす。\n⑧派手に排泄をする彼女に呆気にとられていると、排泄中の女の子が涙目で見ないでくださいと弱々しく言いながらドアを閉める。我に返り、謝罪をのべながらその場を立ち去る。\n\nという流れの漫画を描いていただきたいです。細かい描写を多々入れてしまい申し訳ないです。都合上変更、描写できない所があれば遠慮なく変更してください。\n\n【細かい指定】（以前とほとんど同じです）\n・キャラクターですが、先生の他作品にすごく好みのこんがいるので、可能でしたらその子に似た容姿、もしくはその子を登場させていただけるとありがたいです。\n主人公は秋恋乃葉ちゃんのようなキャラクターにしていただきたいです。その他の子はお任せします。（欲を言うと、先日描いていただいた漫画で、最後に順番待ちをしていたキャラを見てみたいです。）性癖の関係で眼鏡キャラは避けていただきたいです。\n\n何卒ご検討をよろしくお願いします。", "nc": 184, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@tisshu1122/works/11", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/1754b4a0/uploads/origins/cdb34945-520b-446a-8eec-f36da709008b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=3b73fbf06ccb53f225facba9cd012bb9", "srcset": "https://si.imgix.net/1754b4a0/uploads/origins/cdb34945-520b-446a-8eec-f36da709008b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=3b73fbf06ccb53f225facba9cd012bb9, https://si.imgix.net/1754b4a0/uploads/origins/cdb34945-520b-446a-8eec-f36da709008b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=702412b1035bc01e025d4e600517ba0f 2x, https://si.imgix.net/1754b4a0/uploads/origins/cdb34945-520b-446a-8eec-f36da709008b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=6f89b99a950940fc691c11ac5d11df4e 3x"}, "private": true, "genre": "comic", "tipped": false, "creator_id": 3734110, "nc": 176}, {"path": "/@tisshu1122/works/10", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3734110, "client_id": 929001, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/fde7c7f7/uploads/origins/d84ce6fa-e4ed-4f70-864a-bf7bdec69cba?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2219c9b7252b292f56b9ea13b11ce3f7", "srcset": "https://si.imgix.net/fde7c7f7/uploads/origins/d84ce6fa-e4ed-4f70-864a-bf7bdec69cba?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2219c9b7252b292f56b9ea13b11ce3f7, https://si.imgix.net/fde7c7f7/uploads/origins/d84ce6fa-e4ed-4f70-864a-bf7bdec69cba?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=71a79a09ffc0bbcd4d5280c89dd621c9 2x, https://si.imgix.net/fde7c7f7/uploads/origins/d84ce6fa-e4ed-4f70-864a-bf7bdec69cba?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=4d5d1ccffbad6bd750d85c97e6e8530e 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/fde7c7f7/uploads/origins/d84ce6fa-e4ed-4f70-864a-bf7bdec69cba?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=247340c27e0441eaccbe07a3f08024ff", "srcset": "https://si.imgix.net/fde7c7f7/uploads/origins/d84ce6fa-e4ed-4f70-864a-bf7bdec69cba?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=247340c27e0441eaccbe07a3f08024ff, https://si.imgix.net/fde7c7f7/uploads/origins/d84ce6fa-e4ed-4f70-864a-bf7bdec69cba?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=b835ae7e7d65673d4ca6b7b124353004 2x, https://si.imgix.net/fde7c7f7/uploads/origins/d84ce6fa-e4ed-4f70-864a-bf7bdec69cba?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=627f2d579043ffa9b797fb0022295d5d 3x"}, "body": "いつも作品にお世話になっております！　リクエストさせていただきます！\n\nお腹を壊して限界で漏れそうな金髪ギャルJKちゃんが、和式トイレで下痢ウンチとおしっこをブリブリジョボジョボ排泄するシーンをカラーのイラスト形式でお願いしたいです。\n排泄時の効果音（ブリブリなど……）は必ず描写してほしいです。\n\n・容姿、服装\n以前先生が描いていらっしゃったこちら（https://www.pixiv.net/artworks/135865533）のようなギャルっぽい強気なJKちゃんでお願いします。\n服装はこちら（https://booth.pm/ja/items/4956440）のブレザー制服と黒のニーハイソックスで、下着はシンプルな白のパンツを履いていると嬉しいです。\n\n・シチュエーション\n放課後、下校しようとしたところ急な腹痛で下痢になってしまったギャルJKちゃん。\n教室近くのトイレではウンチの音とニオイで下痢だと同級生にバレてしまい恥ずかしいので、普段は誰も使わない旧校舎の和式トイレまで急いで向かう。\n何とかトイレにたどり着き、プリプリプスプスとオナラを漏らしながらパンツを下ろしてしゃがみ込み、一気に下痢ウンチを排泄。\n安堵の表情を浮かべブリブリビチビチと下痢ウンチ排便を続け、ひと段落。\nお腹の奥に残っていたオナラをしつつ、おしっこも排尿。\nようやく落ち着き、トイレットペーパーでおまんことお尻を拭く。\n\n・排泄シーンの構図\n他者様の作品で申し訳ありませんが、排泄シーンはこちらのイラスト構図に似せてください（参考URL→https://www.pixiv.net/artworks/96102727）\n\n以上です。\n是非、ご検討のほど、よろしくお願い致します。", "nc": 32, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@tisshu1122/works/9", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/997779a2/uploads/origins/579534c7-9062-4ad8-ad40-e962e091e3a5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=5d9c20ba6fa6799bf42f8ec98479d1ef", "srcset": "https://si.imgix.net/997779a2/uploads/origins/579534c7-9062-4ad8-ad40-e962e091e3a5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=5d9c20ba6fa6799bf42f8ec98479d1ef, https://si.imgix.net/997779a2/uploads/origins/579534c7-9062-4ad8-ad40-e962e091e3a5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=4c9edff5657bd99c75944ffd4063a6ef 2x, https://si.imgix.net/997779a2/uploads/origins/579534c7-9062-4ad8-ad40-e962e091e3a5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=69d2e99652f829b42acb9bf6466abb65 3x"}, "private": true, "genre": "art", "tipped": true, "creator_id": 3734110, "nc": 160}, {"path": "/@tisshu1122/works/8", "private_thumbnail_image_urls": null, "private": false, "genre": "comic", "tipped": true, "creator_id": 3734110, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/0cee1de6/uploads/origins/8c117f11-bb83-4485-8b97-b44c23ded153?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bff98ca0ff3c23a17d926f8161266a42", "srcset": "https://si.imgix.net/0cee1de6/uploads/origins/8c117f11-bb83-4485-8b97-b44c23ded153?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bff98ca0ff3c23a17d926f8161266a42, https://si.imgix.net/0cee1de6/uploads/origins/8c117f11-bb83-4485-8b97-b44c23ded153?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=6b1b4a3490762d7ee23f44610a2376e5 2x, https://si.imgix.net/0cee1de6/uploads/origins/8c117f11-bb83-4485-8b97-b44c23ded153?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=2fd0400e377a8d8e149cb370ffe9f7dd 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/0cee1de6/uploads/origins/8c117f11-bb83-4485-8b97-b44c23ded153?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2e736d9b09fd9b23e403efa99708a9c9", "srcset": "https://si.imgix.net/0cee1de6/uploads/origins/8c117f11-bb83-4485-8b97-b44c23ded153?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2e736d9b09fd9b23e403efa99708a9c9, https://si.imgix.net/0cee1de6/uploads/origins/8c117f11-bb83-4485-8b97-b44c23ded153?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=c5f161352150eb77f019934f3ff1606d 2x, https://si.imgix.net/0cee1de6/uploads/origins/8c117f11-bb83-4485-8b97-b44c23ded153?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=abb6a94372b8c57496fd24b827917a1b 3x"}, "body": "ポケットティッシュを取り出す先生、初めまして。お願いしたいリクエストがありますので、お許しください。\n\n【キャラ】\n津島善子（ラブライブ！サンシャイン！！）\n\n【衣装】\n浦女冬制服+上履き\nパンツ：白（汚れなし）\n髪型や制服のディテールなど、可能な限り設定通りに再現してください。\n参考URL：\nhttps://imgur.com/a/ojGqUql\nhttps://drive.google.com/drive/folders/1NJPBCJJUfrShsG5t-IomWiV50tio-OzO\n（内容は同じです）\n\n【ジャンル】\n全3部構成で、第1部と第3部はコミック（白黒・カラー問わず）。第2部は数点のバリエーションがあるイラスト（カラー）です。\n第1部および第3部のコミックのページ数は、状況に応じてご自身で調整してください。\n\n【シーン】\n以下、時系列順に並べます：\n●第1部：善子は授業中にお腹が痛くなり、便意を我慢していた。授業が終わると、学校の洋式トイレの個室に駆け込み、下痢を始めた。（3ページほど）\n●第2部：片手でお腹を押さえ、もう片方の手の位置はお任せです。時間順にAからEの5種類の差分があります。表情、排泄の状態、文字のみ違い、それ以外は全く同じです。\n\nA：泥下痢\nB：下痢が止まったけど、まだちょっと気分が悪い\nC：第二波の下痢（液状）\nD：下痢がほぼ終了した\nE：おしっこ\n\nAからEまでの表情はそれぞれ異なります。それぞれに簡単なセリフ（思考内容）を付け加えることも、付けないこともできます。\n\n可能であれば、（https://www.pixiv.net/artworks/136977254）を参考に、便器の不透明版と透明版を用意してください。透明版の便器については、中身が時系列に沿って変化するようにお願いします。\n\n●第3部：善子は尻を拭き、下着を履き直してトイレを出たが、教室に戻る前に腹痛と便意が再び襲ってきたため、再びトイレに戻り、下痢を続けた。（2ページほど）\n\n【納品形態】\n●可能であれば、PSDファイルをご提供ください。\n●PSDファイルが提供できない場合、第2部について、文字の有無のバージョンをご用意ください。可能であれば、便器の不透明版と透明版を用意してください。\n\n上記が複雑で申し訳ございません、ご検討いただければ幸いです。\n\nhttps://imgur.com/a/ojGqUql", "nc": 176, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@tisshu1122/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3734110, "client_id": 3545577, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/4706fc82/uploads/origins/f87b71e3-b702-4120-b6f0-a186f90c1d9e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c3d5931b97e21b8da09a845dae48d87a", "srcset": "https://si.imgix.net/4706fc82/uploads/origins/f87b71e3-b702-4120-b6f0-a186f90c1d9e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c3d5931b97e21b8da09a845dae48d87a, https://si.imgix.net/4706fc82/uploads/origins/f87b71e3-b702-4120-b6f0-a186f90c1d9e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e572de600edbbd16520823145983e093 2x, https://si.imgix.net/4706fc82/uploads/origins/f87b71e3-b702-4120-b6f0-a186f90c1d9e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=70b27c21b743634cf0a2821019ad8c3e 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/4706fc82/uploads/origins/f87b71e3-b702-4120-b6f0-a186f90c1d9e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=8def4bbc9be2f531433002a56890e735", "srcset": "https://si.imgix.net/4706fc82/uploads/origins/f87b71e3-b702-4120-b6f0-a186f90c1d9e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=8def4bbc9be2f531433002a56890e735, https://si.imgix.net/4706fc82/uploads/origins/f87b71e3-b702-4120-b6f0-a186f90c1d9e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=a44c9966bab5345fb7dc865e03621773 2x, https://si.imgix.net/4706fc82/uploads/origins/f87b71e3-b702-4120-b6f0-a186f90c1d9e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=ded4af4a858b3e14948454d955e70f8a 3x"}, "body": "こんにちは。このキャラクターが、ぐちゃぐちゃとした塊状の下痢をしているカラーイラストを、5つの違いを入れて作成してほしいです。\n\nhttps://www.pixiv.net/en/artworks/111296882\n\n彼女は公共のシャワー室に立ち、黒いビキニを着ていますが、下は太ももまでずり下がっており、そのぽっちゃりしたお尻が視聴者の方を向いています！彼女は排便を我慢しようと尻を握りしめており、お腹がひどく痛んでいます。人前でこれほどまでに便意を催してしまっていることに恥ずかしさを感じています\n\n1. 彼女は太ったお尻をこすりながらうめき声を上げ、肛門をきゅっと締めている\n\n2. 糞が尻から押し出され始め、彼女はそれを止めようとさらに強く尻を締め付けている\n\n3. 彼女は大量の塊状の糞を排泄し、泣き叫んでいる\n\n4. 便が泥状／水っぽくなり、お尻や太ももをひどく汚しながら、うめき声を上げている\n\n5. 排泄が終わり、安堵した様子だが、お尻からは便が滴り落ち、太ももはひどく汚れている", "nc": 33, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@tisshu1122/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "comic", "tipped": true, "creator_id": 3734110, "client_id": 1776190, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/e8e05385/uploads/origins/7eb2cb4a-71f8-47d2-96fd-53930026c3d0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=902ab288b90293263836782598c54591", "srcset": "https://si.imgix.net/e8e05385/uploads/origins/7eb2cb4a-71f8-47d2-96fd-53930026c3d0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=902ab288b90293263836782598c54591, https://si.imgix.net/e8e05385/uploads/origins/7eb2cb4a-71f8-47d2-96fd-53930026c3d0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=4262e4e87f1a14e5859a47e90afba309 2x, https://si.imgix.net/e8e05385/uploads/origins/7eb2cb4a-71f8-47d2-96fd-53930026c3d0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=07e70023f6f15991d19b2e03954e7adc 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/e8e05385/uploads/origins/7eb2cb4a-71f8-47d2-96fd-53930026c3d0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=4f978ba6183c532bc8199fd2923274ef", "srcset": "https://si.imgix.net/e8e05385/uploads/origins/7eb2cb4a-71f8-47d2-96fd-53930026c3d0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=4f978ba6183c532bc8199fd2923274ef, https://si.imgix.net/e8e05385/uploads/origins/7eb2cb4a-71f8-47d2-96fd-53930026c3d0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=59e55f1d30366549e705e6325226c628 2x, https://si.imgix.net/e8e05385/uploads/origins/7eb2cb4a-71f8-47d2-96fd-53930026c3d0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=9bf476c0386b5941192facdd71897d42 3x"}, "body": "いつも素敵なイラストを拝見しております。先生の漫画内での丁寧な描写、かわいい作画に毎度興奮させられております。この度リクエストを送らせていただきますので、確認をよろしくお願いします。\n\n【シチュエーション】\n①便意を催した大人しめの女子高生主人公が、人気のない体育館裏トイレに向かう。\n②トイレの中には2つの個室とその中で排泄中の先客と順番待ちをしている女子生徒が1人立っている。個室内の先客はどちらも排泄音を出しながら排便しており、前に並んでいる子もお腹を押さえ少しおならを漏らしながら我慢している。\n③個室が空き交代で並んでいた子が入る。緩めの排便音が響き、聞いているとお腹が刺激される。\n④しばらく経つと先程の隣の個室が空き、小柄で小動物のような可愛らしい生徒が出てきて、恥ずかしそうにそそくさと立ち去る。\n⑤個室に入ると濃い便臭と、和式便器に残る茶色い筋がはっきり残っており、「さっきの可愛い子もこんな臭くて汚いうんちするんだ……」と不思議と高揚した気持ちになる。\n⑥和式トイレを跨ぎ、音が響くことに恥ずかしさを感じつつ、固形便→ちょっと緩めの便の流れで排便する。ゆるい便は、便器の中に飛び散り、先程の生徒と同じく便器を汚してしまっている。\n⑦排便を終え個室から出ると、大人しげな生徒が順番待ちをしており、その子が個室に入ったあとの大きな排便音を背に、手を洗い立ち去る。\n\nという流れの漫画を描いていただきたいです。細かい描写を多々入れてしまい申し訳ないです。都合上変更、描写できない所があれば改変していただければと思います。\n\n【細かい指定】\n・キャラクターですが、先生の他作品にすごく好みの子がいるので、可能でしたらその子に似た容姿で、もしくはその子を登場させていただけるとありがたいです。\n主人公は秋恋乃葉ちゃん、小動物チックな子は白川ことちゃんのようなキャラクターにしていただきたいです。その他の子はお任せします。性癖の関係で眼鏡キャラは避けていただきたいです。\n\n以上がリクエスト内容になります。金額不足の場合は、再送依頼をしていただければ幸いです。何卒ご検討の程よろしくお願いします。", "nc": 56, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@tisshu1122/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3734110, "client_id": 1539627, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/a06b3c65/uploads/origins/e20dc18f-53fd-4dea-b948-a0e6634dd644?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=590f84662efa029fa2e930dbde47f4b8", "srcset": "https://si.imgix.net/a06b3c65/uploads/origins/e20dc18f-53fd-4dea-b948-a0e6634dd644?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=590f84662efa029fa2e930dbde47f4b8, https://si.imgix.net/a06b3c65/uploads/origins/e20dc18f-53fd-4dea-b948-a0e6634dd644?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=60a5d21ab26f00953874c54ea093b88c 2x, https://si.imgix.net/a06b3c65/uploads/origins/e20dc18f-53fd-4dea-b948-a0e6634dd644?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d051d82ac2819acfe42103f1c42bc0f8 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/a06b3c65/uploads/origins/e20dc18f-53fd-4dea-b948-a0e6634dd644?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=94a58e2b39db87cffbf1455b666df010", "srcset": "https://si.imgix.net/a06b3c65/uploads/origins/e20dc18f-53fd-4dea-b948-a0e6634dd644?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=94a58e2b39db87cffbf1455b666df010, https://si.imgix.net/a06b3c65/uploads/origins/e20dc18f-53fd-4dea-b948-a0e6634dd644?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=552c59c55829c95161cb8767cdca0598 2x, https://si.imgix.net/a06b3c65/uploads/origins/e20dc18f-53fd-4dea-b948-a0e6634dd644?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=8060efd0a79ade87ef5b4d765b72436d 3x"}, "body": "ポケットティッシュを取り出す先生はじめまして！先生のイラストいつも拝見させていただいています！うちのこの大スカのリクエストをカラーで依頼します！\nhttps://drive.google.com/file/d/1VbcNEyg3NzIexcc_Dq3teDiSiOGun9nu/view?usp=drivesdk\nこの資料を参照してください。服装もリボン以外は資料の通りで、リボンはオレンジ色でパンツは薄いオレンジ色でお願いします。名前は天ヶ瀬桜彩(あまがせさや)です。容姿端麗でマドンナ的存在で優等生な女の子です。\n以下シーンです。\n放課後、天ヶ瀬桜彩が担任の先生にクラスのことでお願いをされて手伝っていたら、急にお腹が下した時の痛みに襲われ、先生に言ってトイレに行くが、女子トイレが全て使用禁止になっていた、1度痛むお腹を抱え教室に戻った時に波が来てしゃがんでしまい、先生に助けを求めて、先生から男子トイレしかないわね…と言われて、先生の肩を借りながら、トイレに行き大量の下痢を激しく音を響かせながら出す(第1波と第二波で水下痢と泥下痢)\n排泄・腹痛擬音と排泄中のセリフは先生のおまかせで、セリフは以下の感じでお願いします。\n桜彩→(何…これ…お腹…いたい…！)\n先生、お手伝いしてる時に申し訳ないのですが、お手洗いに行ってきてもいいですか？\n(うそ…！女子トイレ使用禁止！？)\n先生…女子トイレ使えないんですけd…うぐっ！？\n先生→ええ、どうぞ行ってらっしゃい。\nえ！？ちょっと桜彩さん大丈夫！？女子トイレが使えないの！どうしましょう…\n…男子トイレを使うしかないわね…桜彩さん私の肩につかまって…\n先生ここにいるから、何かあったら言ってね…恥ずかしいと思うけど…\nあとは陰毛なしで便器は出来れば透過したものをお願いします\n構図は先生が以前書いたこちらのトイレシーンでhttps://www.pixiv.net/artworks/135865533 でお願いします\nうちのこの情報を載せときます。\n体質などは少しお腹は弱く、しょっちゅう下痢をしているというのはないが緩いのが出ることが多く、出す量も多い。時にお腹を下してしまって、音を響かせてしまうこともある。和式が苦手で洋式が空いてなければ使い、人目のつかない場所のトイレを使うことが多い。\nシーンが複雑ではありますがよろしくお願いいたします", "nc": 160, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@tisshu1122/works/4", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/f0fb29b8/uploads/origins/70db64c8-2c7d-4695-bc4c-c723ac0ec643?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=bb6ca75e6bfd95f0b1d25e2279c923f0", "srcset": "https://si.imgix.net/f0fb29b8/uploads/origins/70db64c8-2c7d-4695-bc4c-c723ac0ec643?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=bb6ca75e6bfd95f0b1d25e2279c923f0, https://si.imgix.net/f0fb29b8/uploads/origins/70db64c8-2c7d-4695-bc4c-c723ac0ec643?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=96e2ad24988e94af6cfb3842ec82f2e9 2x, https://si.imgix.net/f0fb29b8/uploads/origins/70db64c8-2c7d-4695-bc4c-c723ac0ec643?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=98216da4cc9fe413ccb0e7f2ca82531c 3x"}, "private": true, "genre": "comic", "tipped": false, "creator_id": 3734110, "nc": 161}, {"path": "/@tisshu1122/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "comic", "tipped": false, "creator_id": 3734110, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/b2a6a6a3/uploads/origins/444bfe81-d420-4470-b737-6f82483e935c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c933b9665027d3f68e39b3011e1b5b96", "srcset": "https://si.imgix.net/b2a6a6a3/uploads/origins/444bfe81-d420-4470-b737-6f82483e935c