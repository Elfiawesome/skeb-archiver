、青空など爽やかな雰囲気が感じられるような風景だと嬉しいです。もちろん難しければお好きに描いて頂いて構いません！）\n\nその他、構図・表情・服装などは全てお任せいたします。\nご縁がありましたら、よろしくおねがいいたします。\nこれからも応援しております。\n\n参考\nhttps://drive.google.com/drive/folders/1WbLzZqsMvuHbEKYL7MI_g2A5CKE_dVR8?usp=sharing", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@nnj_ou/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2903207, "client_id": 826194, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/b6216f81/uploads/origins/b90c7a52-ecd5-434a-a0a8-aab2cb575b69?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d835f7da4bd9d3be065cb5d4d126e296", "srcset": "https://si.imgix.net/b6216f81/uploads/origins/b90c7a52-ecd5-434a-a0a8-aab2cb575b69?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d835f7da4bd9d3be065cb5d4d126e296, https://si.imgix.net/b6216f81/uploads/origins/b90c7a52-ecd5-434a-a0a8-aab2cb575b69?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=6b0e48b71a8abce697f3934f30811323 2x, https://si.imgix.net/b6216f81/uploads/origins/b90c7a52-ecd5-434a-a0a8-aab2cb575b69?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=05849491e9e0e655743a85fd5cd85f3d 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/b6216f81/uploads/origins/b90c7a52-ecd5-434a-a0a8-aab2cb575b69?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e3c194e7f6cf01c397a72ef3a24a106e", "srcset": "https://si.imgix.net/b6216f81/uploads/origins/b90c7a52-ecd5-434a-a0a8-aab2cb575b69?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e3c194e7f6cf01c397a72ef3a24a106e, https://si.imgix.net/b6216f81/uploads/origins/b90c7a52-ecd5-434a-a0a8-aab2cb575b69?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=fa9c6b