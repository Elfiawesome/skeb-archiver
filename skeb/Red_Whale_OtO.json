ress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3dd020120cc7e08b7eb8f87ef5293ce6, https://si.imgix.net/21bedc52/uploads/origins/249fe835-102a-4944-b618-5e20cc414994?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=904c1c1ffe140850a02ed857ecc66796 2x, https://si.imgix.net/21bedc52/uploads/origins/249fe835-102a-4944-b618-5e20cc414994?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f70d68c0145ccb0cc6bd90e5c9844eb6 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/21bedc52/uploads/origins/249fe835-102a-4944-b618-5e20cc414994?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=4df8b7a55b4d2ee1aa08178867ddeb5c", "srcset": "https://si.imgix.net/21bedc52/uploads/origins/249fe835-102a-4944-b618-5e20cc414994?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=4df8b7a55b4d2ee1aa08178867ddeb5c, https://si.imgix.net/21bedc52/uploads/origins/249fe835-102a-4944-b618-5e20cc414994?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=86d6539b40e036376bcdaab966bbd6b1 2x, https://si.imgix.net/21bedc52/uploads/origins/249fe835-102a-4944-b618-5e20cc414994?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=114231602efe405b07da0e68c101d93d 3x"}, "body": "こんにちは！私もモルモットを飼っています。私は4匹のモルモットを飼っています！\nモルモット4匹と一緒にいるんちゃんを見てみたいです。\n\n参考までに新しいモルモットのフォルダはこちら：https://drive.google.com/drive/folders/1LAAzw6eJWA3wVq4DwyD3mV6Ogg0twHjT\nそして、参考までに古いフォルダはこちらです：\nhttps://drive.google.com/drive/folders/1ohxI_gvQmVlml3YXOgwe26lmXHVRnN3u\n\nありがとうございました！", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Red_Whale_OtO/works/15", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2389070, "client_id": 2565216, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/6cd3e6fc/uploads/origins/6cfd2f99-035a-49bf-a506-d9a52a8fd3e4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b296617a1a8848e8db9c6619b87ecc4c", "srcset": "https://si.imgix.net/6cd3e6fc/uploads/origins/6cfd2f99-035a-49bf-a506-d9a52a8fd3e4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b296617a1a8848e8db9c6619b87ecc4c, https://si.imgix.net/6cd3e6fc/uploads/origins/6cfd2f99-035a-49bf-a506-d9a52a8fd3e4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=07253bd019faaad899a8ae868dce8330 2x, https://si.imgix.net/6cd3e6fc/uploads/origins/6cfd2f99-035a-49bf-a506-d9a52a8fd3e4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=beea597fdcc3755ab0083bed1ff3f7e6 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/6cd3e6fc/uploads/origins/6cfd2f99-035a-49bf-a506-d9a52a8fd3e4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=62f4c37b807d5eca9148f61291c5a20b", "srcset": "https://si.imgix.net/6cd3e6fc/uploads/origins/6cfd2f99-035a-49bf-a506-d9a52a8fd3e4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=62f4c37b807d5eca9148f61291c5a20b, https://si.imgix.net/6cd3e6fc/uploads/origins/6cfd2f99-035a-49bf-a506-d9a52a8fd3e4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=48c38590d584c257f5185c6f502a0ef1 2x, https://si.imgix.net/6cd3e6fc/uploads/origins/6cfd2f99-035a-49bf-a506-d9a52a8fd3e4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=ad6eb17e674307c3ca2471cda293f8f2 3x"}, "body": "はじめまして！少女マンガを彷彿とさせるあなたの画風がとても好きです。特に、ファイアーエムブレムのかわいい女の子のイラストが好きです：\nhttps://skeb.jp/@Red_Whale_OtO/works/4\nhttps://skeb.jp/@Red_Whale_OtO/works/5\n肌や髪、唇の色や質感がとてもきれいだ。\n\nファイアーエムブレムヒーローズ(FEH)のヴェロニカのイラストをお願いします。ベロニカのキャラクターデザインの参考はこちらです：\nhttps://postimg.cc/gallery/Pf8gq6W\nhttps://guide.fire-emblem-heroes.com/00001005000881-2/\n\nヴェロニカはヴァンパイア・プリンセスの衣装を着ています。この服の形とデザインは、このデザインにゆるくインスパイアされているに違いない：\nhttps://files.catbox.moe/z4p285.png\nhttps://files.catbox.moe/hurohp.png\n特に、マントの形は重要なディテールである。\n\nただし、ヴァンパイアの美学により合うように、ドレスの色やディテールを調整してください。また、色はヴェロニカのデザイン・リファレンスのドレスを彷彿とさせるものでなければなりません。そのため、ヴァンパイア・ドレスの色は赤、黒、金でなければなりません。\n例\nhttps://files.catbox.moe/thlaxj.jpeg\nhttps://twitter.com/minori_chigusa/status/1322078771042680832\nhttps://twitter.com/oren_mi/status/1379263051170373633\n\nヴェロニカは赤いルビーのイヤリングとティアラをつけていなければなりません。ティアラは、ベロニカのキャラクター・デザイン・リファレンスにあるようなものにしてください。また、トップにリンクしたあなたの過去の作品のような、きれいなテクスチャーの背景も見てみたい。可能であれば、バラのアクセサリーをドレスのデザインや背景に加えると、とても素敵なタッチになると思います！\nヴェロニカのポーズや表情など、その他の構図の詳細はお任せします！大切なのは、ヴェロニカが可憐でエレガントで魅力的に見えることです。\n\nこのイラストをSNS（Reddit）で共有したいのですが、その際、作者のクレジットとあなたのプロフィールにリンクを貼らせてください。", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Red_Whale_OtO/works/14", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2389070, "client_id": 1347188, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/9b6d206a/uploads/origins/73c5005c-c1c6-4e36-91b2-207d4221ede1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=80eeaa34de1350f0990d58ff480b8ad1", "srcset": "https://si.imgix.net/9b6d206a/uploads/origins/73c5005c-c1c6-4e36-91b2-207d4221ede1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=80eeaa34de1350f0990d58ff480b8ad1, https://si.imgix.net/9b6d206a/uploads/origins/73c5005c-c1c6-4e36-91b2-207d4221ede1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c34c5ce818eed634120949430fc50e78 2x, https://si.imgix.net/9b6d206a/uploads/origins/73c5005c-c1c6-4e36-91b2-207d4221ede1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=04a6e00f79b13422f6c3855341e1544e 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thu