75-c9b7-4043-8f7b-df508c9f244b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=063f6a8dd743030d6f9dbdcdf8dffceb", "srcset": "https://si.imgix.net/ccdb66f8/uploads/origins/17ce0875-c9b7-4043-8f7b-df508c9f244b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=063f6a8dd743030d6f9dbdcdf8dffceb, https://si.imgix.net/ccdb66f8/uploads/origins/17ce0875-c9b7-4043-8f7b-df508c9f244b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=4b28c20210f10f3a81396674218845b0 2x, https://si.imgix.net/ccdb66f8/uploads/origins/17ce0875-c9b7-4043-8f7b-df508c9f244b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=db2c4079a3d6f451251e7cefae6e26a1 3x"}, "body": "初めまして。Xにてイラストを拝見し、描かれる女の子の可愛らしさに一目惚れしました…！ぜひうちの子である代理キャラクターとその友人たちを描いていただければと思い、リクエスト失礼いたします。\n\n◆使用用途\n個人鑑賞/個人利用のみのアクリルグッズ作成\n\n◆構図\nポーズや構図、服装等全てお任せいたします！\n星や月、星座や天体のモチーフ、青系や銀系の色合いでまとまっていると嬉しいです。\n代理の女の子をメインに耳や尻尾、瞳、あとはお友達の生き物たちが動いてくれたら嬉しいです。\n\n＊＊キャラクターについて＊＊\n\n◆代理/オオカミの半獣人の女の子\n・オオカミ×星×月モチーフの少女\n・おっとり穏やか、感情豊か。好奇心旺盛で不思議な本を片手に様々な物語を巡っている。\n・尻尾も髪も耳もふわふわ。お供の子供オオカミと白いいきものを可愛がっている。\n\n◆お供の白い子供のオオカミ\n・食いしん坊の子供オオカミ。お腹が空いているところを拾われた。\n・好奇心旺盛。とっても頑張ったら人間の姿（子供）になれる。\n・女の子のことが大好き、守ってあげられるようになりたい\n\n◆白い二匹のいきもの\n・気づいたら女の子と白オオカミの頭の上に乗っていた。手のひらサイズ。\n・跳ねたり肩の上で寝ていたり転がっていたりと気まぐれ。\n\n◆ほか\nこちらはもし可能であればで大丈夫ですが、人物、マスコットのみの背景透過PNG画像もあると本当に嬉しいです！\n（個人鑑賞のみのアクリルグッズ作成に使いたいと考えています）\n\nぜひご縁をいただけたら嬉しいです！ご検討何卒よろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/1ISEil5J2CmR3NKFxoLZ-5nQbz5xF8mOy?usp=share_link", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@tmomo00tm/works/10", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/0b0d9f6f/uploads/origins/a98d6c94-3c0a-4816-bc81-3c7b2722e082?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=8fcef8