構図などすべておまかせします！（仲よさげだと嬉しいです！）ご検討よろしくお願いします🙏\n\nhttps://drive.google.com/drive/folders/10NSwgc7xHMe37EPLxkl2F4gntE9Qozp9?usp=sharing\n\nhttps://drive.google.com/drive/folders/10NSwgc7xHMe37EPLxkl2F4gntE9Qozp9?usp=sharing", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "similar_creators": [{"id": 1873433, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "オサムサ/Osamusa(costume design)", "screen_name": "osamusa828", "avatar_url": "https://pbs.twimg.com/profile_images/1638524612635152384/zitGkRgt.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1483796954669019137/1646397682/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 120, "skills": [{"genre": "art"}, {"genre": "correction"}], "banned": false, "nc": 176}, {"id": 2257463, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "米粒くん", "screen_name": "asoi002", "avatar_url": "https://pbs.twimg.com/profile_images/1556956455051599872/WgL49TSM.jpg", "header_url": null, "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 7, "complete_expiration_days": 90, "skills": [{"genre": "art"}], "banned": false, "nc": 129}, {"id": 2742080, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "soji.dot@ドット絵ご依頼受付中", "screen_name": "soji_dot", "avatar_url": "https://pbs.twimg.com/profile_images/1659120206671937536/XaXCXyPR.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1659036498124242946/1684400254/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 3