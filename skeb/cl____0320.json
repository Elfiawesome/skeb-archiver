received_works": [{"path": "/@cl____0320/works/18", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2775374, "client_id": 3180044, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/0d2d40d4/uploads/origins/4fc9c3e4-0b0e-41c5-9b6c-b9d98922164a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1076091f9ec73a1e06c78aac6b04bef7", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/0d2d40d4/uploads/origins/4fc9c3e4-0b0e-41c5-9b6c-b9d98922164a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e1d1c8906809a94e3840c23bf3d2f9ab", "src_set": ""}, "body": "初めまして。TLから素敵なイラストが流れてきて塩素ちゃん様の天使響のキラキラとした暖かさや守る拳の響の凛とした表情に心が奪われました！\nツイートからskebのお知らせを知りましたので、僭越ながらリクエストをお願いしてもよろしいでしょうか？\n\n⚫︎内容\n都会の街で巨大化した（怪獣映画や巨大特撮みたいなスケール感）立花響が、風鳴翼、雪音クリス、小日向未来を己の手のひらや肩や頭の上に乗せているイラストをお願いします。\n（もし余裕があればマリア、切歌、調もいてくれれば嬉しいです）\n\n⚫︎服装\n装者全員XV通常ギア姿です。\n未来のみ私服（シリーズはお任せします）です。\n\n⚫︎表情\n響は恥ずかしがることなく、心の底から楽しそうなわくわくした表情です。\n翼は慣れた感覚で微笑です。\nクリスは困惑と恥ずかしさで顔を赤くしています。\n未来は照れながらも嬉しくて笑顔です。\nもし他の装者も描く場合はその方々はお任せします。\n\n⚫︎その他備考\n都会の天気は晴れで、建物は壊れていません。上の登場人物以外のモブはいません。\n誰が響のどこに乗っているのかはお任せします。\n響がバストアップか全身映るか、カメラアングルなどはスケール感が伝わる感じであれば何でも構いません。もし地面も映す場合は大きさの対比として停車している車も何台かあると助かります。\n一番に、塩素ちゃん様の描きやすい構図でお願いします。\n\nまた、後からskebの「印刷してお届け」機能を使う可能性があります。（自宅での鑑賞のみに使用します）\n\n過去にXDのシナリオイベントで起こった事件がイメージ元でして珍しい設定ですが宜しかったらお願いします。\n\n最後に、たくさんの可愛らしく、かっこいいシンフォギアの装者を描いてくださりありがとうございます！未来（みらい）の家族との幸せも応援しています！", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@cl____0320/works/17", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2775374, "client_id": 667364, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/ab61a3fc/uploads/origins/cdc0953c-3ffe-4883-a241-267ac30e7f40?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=cr