まじめちゃん\n相思相愛でずっといっしょ♡な2人です。\n\n┈┈┈┈┈┈┈┈┈┈\n\n◎ その他要望など\n\nPSD納品希望(難しければPNG形式)\n文字などがレイヤー等で分かれている形式で頂きたいです。\n\n※可能であれば、\nボツネタや試し書きなどなにかあれば\nレイヤー分けや別ファイルにて同梱いただけますとすごい嬉しいですTT\n\n┈┈┈┈┈┈┈┈┈┈\n\n長々と失礼しました…！\n楽しくかいていただけますと嬉しいです❣️\n不備等ありましたらご指定の上再送をお願いいたします。\n\nご縁ありましたらよろしくお願いいたします🙇\n\nhttps://drive.google.com/drive/folders/1vADFIyTDt2XIbloO8M6eFrVLcQjnDrUQ?usp=sharing", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 315399, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "🩷🦄💟🍓", "screen_name": "mmm3395", "avatar_url": "https://pbs.twimg.com/profile_images/2071803643058106368/HxaqyUXS.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1096969501214572544/1691255896/1500x500", "appeal_receivable": true, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 120, "skills": [{"genre": "art"}, {"genre": "correction"}], "banned": false, "nc": 48}, {"id": 1226024, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "はちなな", "screen_name": "tokenhachinana", "avatar_url": "https://pbs.twimg.com/profile_images/1901505829834293249/7W_oCWVM.jpg", "header_url": "https://pbs.twimg.com/profile_banners/742660948628934657/1764008339/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 7, "complete_expiration_days": 30, "skills": [{"genre": "art"}, {"genre": "comic"}, {"genre": "correction"}], "banned": false, "nc": 128}, {"id": 1616186, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "忍田先生", "screen_name": "GSriz", "avatar_url": "https://pbs.twimg.com/profile_images/1479845579681591304/8uEGYMyz.jpg", "header_url": "https://pbs.twimg.com/profile_ba