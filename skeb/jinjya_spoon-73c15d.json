ormat%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=559ab33f80b774c00befb4825d3eb877 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/85bc5741/uploads/origins/81b3913a-c11c-48b2-872e-a2b8153f1ebc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=281d2d05ff69a5e932dc21aa79cd6340", "srcset": "https://si.imgix.net/85bc5741/uploads/origins/81b3913a-c11c-48b2-872e-a2b8153f1ebc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=281d2d05ff69a5e932dc21aa79cd6340, https://si.imgix.net/85bc5741/uploads/origins/81b3913a-c11c-48b2-872e-a2b8153f1ebc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=286a5cbef46f9a2019d2a6c16009f0d3 2x, https://si.imgix.net/85bc5741/uploads/origins/81b3913a-c11c-48b2-872e-a2b8153f1ebc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=5b5b0173ed6f4a6d6e21bcbb97570ad4 3x"}, "body": "はじめまして。リクエストさせて頂きます。\nアニメ版Anotherの赤沢さん(165cm)と恒一(168cm)をカップルらしく描いてください。\n詳細はお任せします。資料を参考にご自由にお描きください。\nなお作品の舞台は98年の北陸の田舎町(モデルは富山県)です。\n絵柄はなるべく公式に寄せてください。\n資料はURLをご参照ください。\nよろしくお願いします。\n\nhttps://t.co/4QcfIihAZD", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@jinjya_spoon/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2785272, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/59516da4/uploads/origins/9b29418b-69f9-4b2f-b7e5-3b60e85b9a86?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6b7427d136b2702252961487498ff496", "srcset": "https://si.imgix.net/59516da4/uploads/origins/9b29418b-69f9-4b2f-b7e5-3b60e85b9a86?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6b7427d136b2702252961487498ff496, https://si.imgix.net/59516da4/uploads/origins/9b29418b-69f9-4b2f-b7e5-3b60e85b9a86?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=07de26d5a4b1bbad9d35ac37e02d49d8 2x, https://si.imgix.net/59516da4/uploads/origins/9b29418b-69f9-4b2f-b7e5-3b60e85b9a86?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=760b9e4264fd2bdd21792a96c523b49e 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/59516da4/uploads/origins/9b29418b-69f9-4b2f-b7e5-3b60e85b9a86?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=fc7d3c06d841c4f1580c337345ff9ea2", "srcset": "https://si.imgix.net/59516da4/uploads/origins/9b29418b-69f9-4b2f-b7e5-3b60e85b9a86?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=fc7d3c06d841c4f1580c337345ff9ea2, https://si.imgix.net/59516da4/uploads/origins/9b29418b-69f9-4b2f-b7e5-3b60e85b9a86?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=22dfe294a0993b5b16bd42899112ece3 2x, https://si.imgix.net/59516da4/uploads/origins/9b29418b-69f9-4b2f-b7e5-3b60e85b9a86?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=55ccefb3f4b1d16182091b66596299ae 3x"}, "body": "初めまして\n\nオリジナルキャラの全身立ち絵で、昭和初期の農家の20歳位、\n純朴な感じのする黒髪女性のイラストをリクエストしたいです。\n髪型、表情、体型、ポーズ等はお任せします。\n\n恰好\n野良着に、もんぺ、地下足袋履きで、手には紺の農作業用の手甲をつけています。\n野良着の色は紺で絣模様にしてほしいです。\nもんぺはへその辺りで紐を結ぶ袴式、長さはくるぶしまでで、色、模様は濃い紫系の縞、\n脇は袴の様にスリットを開けてほしいです。\n地下足袋はくるぶしの上までの長さ、色は黒にしてほしいです。\n服装の大まかなイメージは資料urlをご参照ください。\nもんぺイメージ\nhttps://www.dropbox.com/s/27dregu6fv4xgh3/ms.jpg?dl=0\n地下足袋イメージ\nhttps://www.dropbox.com/scl/fi/0dlq0el8hrwkh15ocjvm7/tb.png?rlkey=id9szwe2vs7xqr6f46enheggn&st=gqb9dkf7&dl=0\n\n以上ご検討の程宜しくお願い致します。\n\nhttps://www.dropbox.com/scl/fi/s6470qhlwdftz8kzbg16s/nk.jpg?rlkey=ve4te44hezclvf9gbnn6zsiw2&st=mglg9oaa&dl=0", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@jinjya_spoon/works/1", "private_thumbn