/0b0f9950-8779-48b4-b026-faf22c5abfc1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e5204fa1de201da6efcfa1a0d82df991", "srcset": "https://si.imgix.net/918fc449/uploads/origins/0b0f9950-8779-48b4-b026-faf22c5abfc1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e5204fa1de201da6efcfa1a0d82df991, https://si.imgix.net/918fc449/uploads/origins/0b0f9950-8779-48b4-b026-faf22c5abfc1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=820b288d85b40c572e372c0e114d76ba 2x, https://si.imgix.net/918fc449/uploads/origins/0b0f9950-8779-48b4-b026-faf22c5abfc1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=609e2a007c92c87d8b3af5b5af7c6bc3 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/918fc449/uploads/origins/0b0f9950-8779-48b4-b026-faf22c5abfc1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=be4696e47b768968b0c074516ef6f1b5", "srcset": "https://si.imgix.net/918fc449/uploads/origins/0b0f9950-8779-48b4-b026-faf22c5abfc1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=be4696e47b768968b0c074516ef6f1b5, https://si.imgix.net/918fc449/uploads/origins/0b0f9950-8779-48b4-b026-faf22c5abfc1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=ea4ee82ff409f24301a44b4133a64f16 2x, https://si.imgix.net/918fc449/uploads/origins/0b0f9950-8779-48b4-b026-faf22c5abfc1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=ed5e371981c1f15b1cfeb72fde6f6c04 3x"}, "body": "こんにちは、依頼失礼いたします。sariaです。\n創作キャラクターの銀花ちゃんを描いていただきたいです。シチュエーションや服装、構図などはお任せでお願いします！\n下記リンクに資料を添付してありますので、容姿の細部などはそちらをご参照ください。\n\n以下設定の補足です。添付した資料ではイラストによって髪の長さに差がありますが、2〜4の胸にかかるくらいの長さが正しいです。色は資料の絵によって銀色に見えると思いますが白という設定で、頭から2本の小さな角が生えています。\n瞳の色は左右で違っていて、右目はベースが紫色で瞳孔の色は白っぽいです。瞳の紫色はくすんだ色ですが、絵柄に合わせて変えて頂いて構いません。左目(向かって右)はグレーですが、髪で隠れて基本的には見えません。\n服装に関しては似合えばなんでも大丈夫です。本人は袴や着物など和物を好み、中でも絵にある袴スカートや、洋服ですとブラウスと膝丈のフレアスカートなどを特に好んで着ます。資料4枚目は着ている洋服の例です(落書きで申し訳ない…)。\nですが前述の通り、基本似合ったと思うものを着せて頂いて大丈夫です！\n性格は明るく、いつもどこかを放浪していて謎が多い印象のあるキャラです。食べることが好きです。(過去は喜怒哀楽の表現が希薄でした)\n\nぜひよろしくお願いいたします。\n\n資料↓\nhttps://drive.google.com/drive/folders/1iLHN67O3Fb4vW-EVncqbYIrEz4thZJKN?usp=share_link", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "similar_creators": [{"id": 10157, "creator": true, "nsfw_acceptable": false, "acceptable": false, "name": "すうりん", "screen_name": "suurin_2", "avatar_url": "https://pbs.twimg.com/profile_images/1804723279724486656/jTkHpVQx.jpg", "header_url": "https://pbs.twimg.com/profile_banners/2809445610/1654528581/1500x500", "appeal_receivable": false, "popular_creator_rank": 51, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "art"}], "banned": false, "nc": 49}, {"id": 72847, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "オニャンコポン  珠野うみか", "screen_name": "tamanoumika", "avatar_url": "https://proxy.misskeyusercontent.jp/avatar.webp?url=https%3A%2F%2Fmedia.misskeyusercontent.jp%2Fmisskey%2F67c72b58-6197-4180-9bab-f8d314c08771.gif&avatar=1", "header_url": "https://media.misskeyusercontent.jp/io/ffe71a2d-af8f-42c3-baee-64fa0f857f43.webp", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 120, "skills": [{"genre": "art"}, {"genre": "voice"}], "banned": false, "nc": 176}, {"id": 308104, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "真白フェア✽Fea Mashiro🖌️🎨", "screen_name": "Fea", "avatar_url": "https://pbs.twimg.com/profile_images/2045766533255921664/8VaJmh_w.png", "header_url": "https://pbs.twimg.