7bf78b9c47d0afcbe4b", "srcset": "https://si.imgix.net/3fb3ca21/uploads/origins/9c6faf93-c597-4f90-9a56-6a0e775f127f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=170f0b67f05967bf78b9c47d0afcbe4b, https://si.imgix.net/3fb3ca21/uploads/origins/9c6faf93-c597-4f90-9a56-6a0e775f127f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=8bd164b440d2f8b7a58ca0da9eaae6b1 2x, https://si.imgix.net/3fb3ca21/uploads/origins/9c6faf93-c597-4f90-9a56-6a0e775f127f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=b569670b69aa3aec5378a10ae25f9c0c 3x"}, "body": "みかん鰤大根さん初めまして、先生の胸から突然悪魔娘が飛び出してくる漫画https://www.pixiv.net/artworks/131872924　が膨乳アイデアとシチュエーションとても良く、その続きもので依頼しました。\n\n内容は新しい住処として先生の胸に悪魔娘が入り超乳サイズに、先生が青ざめて困っている最中、悪魔娘が胸の中でくつろいでいる様子（胸の中が透けて）の漫画をお願いします。\n\nもし可能であれば上半身（胸の全体が見える感じで）構図で、↑の漫画の恰好の様にスーツを着たまま破れずパツパツの超乳に、悪魔娘が少しずつ入っていく度に巨乳、爆乳、超乳と段階的に膨乳して欲しいです。効果音、セリフなどお任せします。", "nc": 177, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@mikanburidaikon/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2056165, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/9569e572/uploads/origins/f3ad96c6-fcd2-4500-b279-a20facc3b706?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b400b04309372b0910dc11d300337e08", "srcset": "https://si.imgix.net/9569e572/uploads/origins/f3ad96c6-fcd2-4500-b279-a20facc3b706?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b400b04309372b0910dc11d300337e08, https://si.imgix.net/9569e572/uploads/origins/f3ad96c6-fcd2-4500-b279-a20facc3b706?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=0d5d9c989465257c02211b99a0b373f1 2x, https://si.imgix.net/9569e572/uploads/origins/f3ad96c6-fcd2-4500-b279-a20facc3b706?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=917956a6f2e5a30f1831e2c46d2d22f9 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/9569e572/uploads/origins/f3ad96c6-fcd2-4500-b279-a20facc3b706?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=7a215030dc2772c92c4e7f8904f8374c", "srcset": "https://si.imgix.net/9569e572/uploads/origins/f3ad96c6-fcd2-4500-b279-a20facc3b706?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=7a215030dc2772c92c4e7f8904f8374c, https://si.imgix.net/9569e572/uploads/origins/f3ad96c6-fcd2-4500-b279-a20facc3b706?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=5f391f0846e2ee4b7386f5c5cf2163ac 2x, https://si.imgix.net/9569e572/uploads/origins/f3ad96c6-fcd2-4500-b279-a20facc3b706?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=8cb6cc40363f9421fbc126136a28c220 3x"}, "body": "こんばんは、匿名でリクエストさせていただきます。私のオリキャラでサイズフェチイラストをお願いします。\n\n巨大化した桃髪少女は茶髪少女を素足で踏み潰そうとする。茶髪少女は踏み潰されまいと、巨大な桃髪少女の素足を両手で支えて抵抗するという内容でお願いします。\n\n細かいリクエストとしては、こちら(https://skeb.jp/@mikanburidaikon/works/4)に似たような構図やアングルと両者の大きさ比で、茶髪少女は汗をかいて片目と口を閉じた必死そうな表情(出来れば内股)で、桃髪少女は抵抗してる茶髪少女を嘲笑っているような歯を見せた不適な笑みを浮かべた表情でお願いします。\nまた、桃髪少女の素足と茶髪少女の両腕両足が震えているように描いて欲しいです。\nあと出来ればでいいですが、茶髪少女の汗をかきながら両目を閉じて歯を食い縛って必死に力んでいる表情(出来れば内股)と、桃髪少女の茶髪少女の抵抗に歯を食い縛りながら汗をたらしてかなり苛ついている表情の差分を描いて欲しいです。\n\n\n茶髪少女のURL\nhttps://drive.google.com/file/d/1gPlmUDtJllJ_OUwkj8qjV5ScVs85HYVi/view?usp=drivesdk\n\n桃髪少女のURL\nhttps://drive.google.com/file/d/1gT2w7ElOrlMJ-9xV0zhnDe07hNDr0DI7/view?usp=drivesdk\n\n\nどうかよろしくお願いします。", "nc": 177, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@mikanburidaikon/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2056165, "client_id": 2162234, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/de356aad/u