nie」スキンからインスピレーションを得ています。Mr TubbsにもKoriの髪のようなスタイルのウィッグをつけてもらいたいです。https://i.ibb.co/88HSFBP/reverse-annie-splashart.jpg\n\nもし、Korienneをアイパッチなしで描いて、Tubbs氏に渡したい場合は、彼女のもう片方の目は次のようになります： https://i.ibb.co/5MHhygc/eyes.png\n\nその他の参考資料はこちらからご覧いただけます： https://drive.google.com/drive/folders/1qx463Bqfop51WXDyfBz0BXQsKzoFzO2z\n\nお時間をいただき、ありがとうございました。この作品を私のソーシャルメディアやTwitchで使用したいのですが、あなたのクレジットを入れてください。♥\n\nhttps://drive.google.com/drive/folders/1qx463Bqfop51WXDyfBz0BXQsKzoFzO2z", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@A_k625/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1480697, "client_id": 161917, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/d3b47368/uploads/origins/6ce67db6-279b-4d36-a797-5e6b9821917d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b85324e950a96d7cff43cf4edce7f8c0", "srcset": "https://si.imgix.net/d3b47368/uploads/origins/6ce67db6-279b-4d36-a797-5e6b9821917d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b85324e950a96d7cff43cf4edce7f8c0, https://si.imgix.net/d3b47368/uploads/origins/6ce67db6-279b-4d36-a797-5e6b9821917d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=4f43c552af15f02a4bbeaa728d4ed4de 2x, https://si.imgix.net/d3b47368/uploads/origins/6ce67db6-279b-4d36-a797-5e6b9821917d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=6f21b96051d66e7a2407c8971f4f7f41 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/d3b47368/uploads/origins/6ce67db6-279b-4d36-a797-5e6b9821917d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=36f4601b9897f3d9b0d2b9846db5e633", "srcset": "https://si.imgix.net/d3b47368/uploads/origins/6ce67db6-279b-4d36-a797-5e6b9821917d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit