c": "https://si.imgix.net/0b162cb5/uploads/origins/588bf8f1-45b8-4cf4-b604-551c24c21f00?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3b1dee02e670f512abdb848b6945ccf7", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/0b162cb5/uploads/origins/588bf8f1-45b8-4cf4-b604-551c24c21f00?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=4e1ec2e5475b206241737a8ac25f4328", "src_set": ""}, "body": "こんにちは、\n\n私のOC（参考）の絵をお願いしてもいいですか？\nフクロウの女の子です。\n身長：161cm\nカップサイズA\nできれば、似合いそうな水着で。あとはお任せします。\n\nありがとうございました。\n\nhttps://pbs.twimg.com/media/F_KIdcmWgAA8Jy1?format=jpg&name=4096x4096", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@usagi_tengoku/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2940141, "client_id": 3340830, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/a157b03d/uploads/origins/bcd7a47a-9e2d-4e95-96a3-6d3e09e35c5c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=47701efb0df55cb739c78dedf9157fa2", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/a157b03d/uploads/origins/bcd7a47a-9e2d-4e95-96a3-6d3e09e35c5c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6edfda230c93367fbafed0e8ea7195de", "src_set": ""}, "body": "めるてぃさんこんにちは！小鹿です！！！\nめるてぃさんの描く絵、可愛くてとても大好きなのでぜひともうちの子を描いていただきたいな〜と思い依頼させていただきました！\n\n\n今回描いてほしいのは〚レプリカントの葬列〛より、自探のほたるを描いてほしいです！\n\n\n自分の存在意義を探すため絵を盗み続ける怪盗。本来の性格は人見知りで警戒心が高いが、怪盗をするときは人懐っこい犬を演じている。\n自分のことを積極的に話すことはしないため、聞かれなければ答えない。\n本人は自覚していない時が多いが、幸運の女。テーブルゲームやギャンブルに強かったと勝負事には強い。が、手先が不器用なので絵を盗む時によくやらかしをして相方としょっちゅう喧嘩をしている。\n誰かに私を見てほしい。という深層心理を持っているため、自分を見てくれる相方に無意識に依存している。\n\n\n構図はお任せします！めるてぃさんのお好きに描いていただければと思います。\nよろしくお願いします。\n\nhttps://drive.google.com/drive/folders/1m67DQEotel6YoZthtCzfQtOSg2ELtGit?usp=sharing", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "similar_creators": [{"id": 2652456, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "こもれび＠skeb募集中", "screen_name": "pano11", "avatar_url": "https://pbs.twimg.com/profile_images/1892898479871016960/yzPCsCFb.jpg", "header_url": null, "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "skills": [{"genre": "art"}], "nc": 129}, {"id": 2892467, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "るーわふ", "screen_name": "S_sya_rin", "avatar_url": "https://pbs.twimg.com/profile_images/1916436473613844480/479EnLse.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1034359404701728768/1758291431/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "skills": [{"genre": "art"}], "nc": 16}, {"id": 3092681, "creator": true, "nsfw_acceptable": false, "acceptable": false, "name": "ノモレクゲル", "screen_name": "D_Zauber", "avatar_url": "https://pbs.twimg.com/profile_images/1794262864771096576/o_uvDI1E.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1556418064568434688/1716620588/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "skills": [{"genre": "art"}], "nc": 144}, {"id": 3237419, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "ぱふりの", "screen_name": "pahurino", "avatar_url": "https://pbs.twimg.com/profile_images/1960722973469630464/OhCuF4KW.jpg", "header_url": "https://pbs.twimg.com/profile_banner