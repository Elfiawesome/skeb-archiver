あのような描き方をしていただけると嬉しいです。マンガである必要はありません。\nこの2人はBLなので、キスシーンなどいちゃついている様子を描いていただけるととてもたすかります。(左右はユーリアン×エヴァナです。)\n\n細かく記載しましたが、阿瀬様の描きやすいように描いていただけたらと思います！金額が足りない場合は、お手数ですが再送要請してください。\nご検討の程よろしくお願いいたします！\n\nhttps://drive.google.com/drive/folders/1XE8XTzH8F5ao1sSIoJ4yXRS3CDjbIIG9?usp=sharing", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@at______1/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3045645, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/ae3f88bb/uploads/origins/26818bb0-7f89-44e0-8549-5a8800a8a15a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ba54ad4c531d77c9b3f1b5e47649f951", "srcset": "https://si.imgix.net/ae3f88bb/uploads/origins/26818bb0-7f89-44e0-8549-5a8800a8a15a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ba54ad4c531d77c9b3f1b5e47649f951, https://si.imgix.net/ae3f88bb/uploads/origins/26818bb0-7f89-44e0-8549-5a8800a8a15a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=73ff55d8e29a646e3e00c72061806bad 2x, https://si.imgix.net/ae3f88bb/uploads/origins/26818bb0-7f89-44e0-8549-5a8800a8a15a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=add75e4a3b4b33d0c55aa991eb78deee 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/ae3f88bb/uploads/origins/26818bb0-7f89-44e0-8549-5a8800a8a15a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=990a251d4dcbb561fdf3d18a36e99fc7", "srcset": "https://si.imgix.net/ae3f88bb/uploads/origins/26818bb0-7f89-44e0-8549-5a8800a8a15a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=990a251d4dcbb561fdf3d18a36e99fc7, https://si.imgix.net/ae3f88bb/uploads/origins/26818bb0-7f89-44e0-8549-5a8800a8a15a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=