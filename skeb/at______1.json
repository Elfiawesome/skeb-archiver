23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=377a37e88549c9f9b1bf5a9bc1e8c5e8 3x"}, "body": "こんにちは、私は先生の作品がとても好きなので、私のパーソナルキャラクターを描いてほしい\nキャラクターは、名家のお嬢様とメイド見習いです。血のつながりはないが、家族のように頼り合っている。\n参考資料と設定を一部ご紹介します：\nhttps://drive.google.com/drive/folders/1H7YguJPZRTwYT9MmDVAue3vSgyUetz_z?usp=sharing\nキャラクターの衣装を選ぶことができる、画面の内容は自分で決めることができます\nもし金額がご期待に添えない場合は、再送させてください\n私の依頼を読んでいただき、ありがとうございます！", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@at______1/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3045645, "client_id": 1213097, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/35b5c34d/uploads/origins/fd2c4b78-de0c-481d-8af0-739be3b9bcb7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7e514ee729b35dfb99608d9a864fdd17", "srcset": "https://si.imgix.net/35b5c34d/uploads/origins/fd2c4b78-de0c-481d-8af0-739be3b9bcb7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7e514ee729b35dfb99608d9a864fdd17, https://si.imgix.net/35b5c34d/uploads/origins/fd2c4b78-de0c-481d-8af0-739be3b9bcb7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=3581985a60e27793d128a4a3aab21809 2x, https://si.imgix.net/35b5c34d/uploads/origins/fd2c4b78-de0c-481d-8af0-739be3b9bcb7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e8231deec91259f30763a6db20493846 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/35b5c34d/uploads/origins/fd2c4b78-de0c-481d-8af0-739be3b9bcb7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=043d2198e5e48604f301b36116be95ca", "srcset": "https://si.imgix.net/35b5c34d/uploads/origins/fd2c4b78-de0c-481d-8af0-739be3b9bcb7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=043d2198e5e48604f301b36116be95ca, https://si.imgix.net/35b5c34d/uploads/origins/fd2c4b78-de0c-481d-8af0-739be3b9bcb7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=c473337d2b36b3c1e1c130413929928b 2x, https://si.imgix.net/35b5c34d/uploads/origins/fd2c4b78-de0c-481d-8af0-739be3b9bcb7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=527525a7c421b3ba50ff7244757876e2 3x"}, "body": "宇然さんこんにちは。\n 今回skebの募集をしているとのことでリクエストを送らせていただきました。宇然さんの眺めたくなるような繊細で流れるような線と、デティールにこだわった装飾や人物の描き方がとても大好きです。もし可能でしたら、私の創作キャラクターを描いていただけないでしょうか？詳細にはキャラクター二人を載せていますが、描きやすい方を選んで描いていただいて構いません！内容、金額不足など不備があった場合は再送させてください。ご検討していただけますと幸いです。\n\nキャラクターについて \n【A】ゲオルグ(George) 黒髪/スーツ/煙草/眼鏡（有無はお任せします）/28歳/178cm 大人しいというより元気がない、投げやりな雰囲気、雑っぽい。武器屋の店主。銃器を扱っています。主に【B】ガルシアによって巻き込まれ、執着されて大切な人を失っています。普段は店の中で銃器のメンテナンスをしたり、雑誌や新聞を読んで客と雑談しています。大切な人から複製された子供と暮らしてます。  \n\n【B】ガルシア(Garcia) 金髪/黄色のジャケット/眼帯/38歳/190cm 軍に配属してる街のパトロールおじさん。朗らか、体格が良く、考えることが得意、戦闘の際に剣を扱うがほぼ力任せ。【A】ゲオルグとは旧知の仲で依存ぽいです。倫理観が破綻しており暴力性が出てしまうこともしばしば。常にAを苦しめている原因元です。普段は街のどこかにいるか、自宅で子供と遊んでいます。  \n\n構図や表情は宇然さんが描きやすいようご自由にお任せ致します。何卒よろしくお願い致します。\n\nhttps://drive.google.com/drive/folders/1bDzQGGjxVo37JCP33yoyvLNpTcWuZUN-", "nc": 48, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@at______1/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3045645, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/61e55bf0/uploads/origins/5ec13ded-d75e-47ca-9f2c-2c0419763127?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=570a3af50c77a3cc53377024b1026c0d", "srcset": "https://si.imgix.net/61e55bf0/uploads/origins/5ec13ded-d75e-47ca-9f2c-2c0419763127?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=570a3af50c77a3cc53377024b1026c0d, https://si.imgix.net/61e55bf0/uploads/origins/5ec13ded-d75e-47ca-9f2c-2c0419763127?bg=%23fff&auto=format%2Ccom