=2&fit=crop&crop=top&w=200&h=200&blur=200&s=cfa86b3220e009d7854c4cbaac5c6d8c 2x, https://si.imgix.net/fda40522/uploads/origins/1c123a19-764a-4474-acd3-851b1a2e9314?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=b35877085f7252c147446d2c8bbf4b92 3x"}, "body": "はじめまして\n\n・キャラクター/お姉さんと弟の友達\n\n・容姿/\n　 お姉さん/JK・運動部で焼けた少し小麦色の肌・胸は普通・髪型はポニーテール・髪色は薄い茶色・目の色は暗い茶色　\n　 弟の友達/DS高学年・外で遊んで小麦色の肌・髪型は短髪・髪色は金色・目の色は暗めの金色\n\n・性格/\n　お姉さん/優しいが怒ると怖い\n　弟の友達/イタズラ好きで能天気(お姉さんが大好き)　\n\n・服装/\n　 お姉さん/制服のスカートと黒のソックス\n　 弟の友達/Tシャツに短パン、頭にお姉さんのブラジャー（綺麗な青色の大人な感じで）\n\n・場所/\n　脱衣所から廊下\n\n・ストーリー(概要)/\n　部活から帰宅したお姉さんがシャワー浴びようと脱衣所で制服を脱いでいる時、遊びに来ていた弟の友達が抜き足差し足忍び足で入室。\n　お姉さんが後ろを向いた時を見計らって脱ぎたてのブラジャーを持って退室\n　お姉さんは鏡にブラジャーを持った弟の友達が見えて脱衣所から廊下に出た。\n\n・シーン(こちらがイラスト用です)/\n　上半身裸で追いかけお姉さん、気が付いた弟の友達はブラジャーを頭に被せて逃走\n\n・表情/\n　お姉さん/眉を吊り上げて怒っている\n　弟の友達/脱ぎたてのブラジャーが手に入りニヤニヤ顔\n\n・ポーズ/お任せします\n　\n以上、宜しくお願いします。", "nc": 184, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}], "sent_works": [], "similar_creators": [{"id": 1389, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "サカモトミツキ", "screen_name": "sakamoto0214", "avatar_url": "https://pbs.twimg.com/profile_images/2002255250078773250/7rypgPCa.jpg", "header_url": "https://pbs.twimg.com/profile_banners/2323979894/1766213810/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 90, "skills": [{"genre": "art"}], "nc": 33}, {"id": 86173, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "YnD", "screen_name": "yatsutsuki", "avatar_url": "https://pbs.twimg.com/profile_images/1542932555032576001/o0_v-8e9.jpg", "header_url": "https://pbs.twimg.com/profile_banners/926318910617423873/1655805525/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester