ac-44b2-9aa3-a079c9dfb20d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c9560b9f964f553220aba59a73211c99 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/6091548a/uploads/origins/8ffab270-40ac-44b2-9aa3-a079c9dfb20d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=fb2d348d42d29380b9131c77888e5b83", "srcset": "https://si.imgix.net/6091548a/uploads/origins/8ffab270-40ac-44b2-9aa3-a079c9dfb20d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=fb2d348d42d29380b9131c77888e5b83, https://si.imgix.net/6091548a/uploads/origins/8ffab270-40ac-44b2-9aa3-a079c9dfb20d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=562328893a1527cf7b872a86aecb5460 2x, https://si.imgix.net/6091548a/uploads/origins/8ffab270-40ac-44b2-9aa3-a079c9dfb20d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=0bc8fd984af2624ae667612b50efe67e 3x"}, "body": "はじめまして、Skebを始められたとお聞きして是非お願いしたくリクエストを送らせていただきました。\n何卒ご検討宜しくお願い致します。\n\n◆拙作、『一式さんは恋を知りたい。』の一式リンナちゃん（17歳身長155cm＋ヒール　胸大きめでツンデレデレエリート飛び級女子　照れてない！と言いながら照れてる）と六反田メイシ君（19歳身長176cm ポンコツぽんやり探偵）を描いていただく事は可能でしょうか？\n\n■希望シチュエーション\n・一式リンナちゃんと六反田メイシくん（服装は通常時（仕事着）でも、それ以外でも構いません）がいちゃいちゃしていれば何でも嬉しいです。仕事帰りにこっそり手を繋いでめちゃくちゃ照れているリンナちゃんを笑顔で見つめるメイシくんや、私服（パジャマ）でメイシくんの膝にリンナちゃんが乗っててお互い照れてたり等　基本的にはお任せします。\n\n・モノクロにて描いていただけると嬉しいです！\n\n・2人とも目を開いてる状態（片目瞑りや、半目等でも大丈夫です）だと嬉しいです。メイシについては笑顔でニッコリ顔でも構いません。また、顔が隠れない角度でお願いします。\n\n・https://twitter.com/sasakomitomo/status/1531270343406792706\nこちらの二枚目のように『その瞬間（一枚絵』と『その後（もしくは前）の瞬間の小ゴマ』があると嬉しいです！（無くても大丈夫です！）\n\n・アクスタ等にしたい為、全身で頂けましたら嬉しいですが、足元まででも構いません。\n背景は無しで大丈夫です。\n\n・前述の通り、個人的な用途（自室に飾る用）としてタペストリーやアクリルスタンドにさせて頂きたいので、psdで納品いただけますと助かります。\n\n・こちらも構わなければなのですが、ラフや下書きを見るのが好きなので良ければ削除せずにレイヤーを置いておいていただけますと幸いです。\n\n参考URL\nhttps://comic-walker.com/contents/detail/KDCW_KS01201829010000_68/\nhttps://www.pixiv.net/users/41066\n\n笹古みとも先生の「シチハゴジュウロク」（特にユイツとムニが好きです…！）や「死神ちゃんは、チョロい」等絵、漫画ともに大好きです！今後の新作も楽しみにしております～！", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@sasakomitomo/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2820881, "client_id": 350097, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/a9e3a5ee/uploads/origins/9f97630f-c111-4097-9049-e446853ea887?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2fd2e4757acd215fd2a66ef2696adfe6", "srcset": "https://si.imgix.net/a9e3a5ee/uploads/origins/9f97630f-c111-4097-9049-e446853ea887?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2fd2e4757acd215fd2a66ef2696adfe6, https://si.imgix.net/a9e3a5ee/uploads/origins/9f97630f-c111-4097-9049-e446853ea887?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=81c3826bcbb5a5153c480c1d8ca491ee 2x, https://si.imgix.net/a9e3a5ee/uploads/origins/9f97630f-c111-4097-9049-e446853ea887?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=019b6e19f9e613dbb201f0ce3a909788 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/a9e3a5ee/uploads/origins/9f97630f-c111-4097-9049-e446853ea887?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3cd0c0bad0a46cac2d7dd3e66520a51b", "srcset": "https://si.imgix.net/a9e3a5ee/uploads/origins/9f97630f-c111-4097-9049-e446853ea887?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3cd0c0bad0a46cac2d7dd3e66520a51b, https://si.imgix.net/a9e3a5ee/uploads/origins/9f97630f-c111-4097-9049-e446853ea887?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=6a9b2a053ff426b2ddf7536e6cc82c2c 2x, https://si.imgix.net/a9e3a5ee/uploads/origins/9f97630f-c111-4097-9049-e446853ea887?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=1b7fa84d8100bdcee3f2bd9b1b5f8f8e 3x"}, "body": "笹古みともさんはじめまして、よければリンク先よりのキャラクターを描いて頂けないでしょうか。私のオリジナルキャラクターです。服装は自由に選んでください。\n\nこの子は幽霊です。生前と同じように淑やか、凛々しいのお嬢様、お花育ちが彼女の趣味。火事で死んだ後、幽霊として記憶と自分を殺した犯人を探しながら、探険している。苦しんでいるけど、諦めず本当の自分を取り戻したい、強い意志の持ち主。\n\n瞳にはハイライトいないです。よければ参考画像にあるタコみたいな小動物を描いてください。\n\n可能でしたらサインはpsdレイヤーでon/offできると嬉しいです。\n依頼内容が金額と見合わない・その他不備などがあればお気軽に再送要請してください。できる限り対応させていただきます。 \nよろしくお願いします。\n\nhttps://drive.google.com/drive/folders/1m_JomAKnMSStDEH4y9AyNMW5PNFg_EwJ", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@sasakomitomo/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2820881, "client_id": 844387, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/9a55ed7c/uploads/origins/f5c39c86-6d8b-48b8-907d-e89bba5832c4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=53c5c42f4ae899bdf26165781ab3a86e", "srcset": "https://si.imgix.net/9a55ed7c/uploads/origins/f5c39c86-6d8b-48b8-907d-e89bba5832c4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=53c5c42f4ae899bdf26165781ab3a86e, https://si.imgix.net/9a55ed7c/uploads/origins/f5c39c86-6d8b-48b8-907d-e89bba5832c4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=0c981b9a30f798e8cf8288782189ab9b 2x, https://si.imgix.net/9a55ed7c/uploads/origins/f5c39c86-6d8b-48b8-907d-e89bba5832c4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=cbeb84468b306d58d1c50d47e5edb143 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/9a55ed7c/uploads/origins/f5c39c86-6d8b-48b8-907d-e89bba5832c4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c819c13fb5f3f701c164c9d623aadcb5", "srcset": "https://si.imgix.net/9a55ed7c/uploads/origins/f5c39c86-6d8b-48b8-907d-e89bba5832c4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c819c13fb5f3f701c164c9d623aadcb5, https://si.imgix.net/9a55ed7c/uploads/origins/f5c39c86-6d8b-48b8-907d-e89bba5832c4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=56e638b3e3b54309e5069ba02902e209 2x, https://si.imgix.net/9a55ed7c/uploads/origins/f5c39c86-6d8b-48b8-907d-e89bba5832c4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=a5374f123344e35edc114e04c79ec95b 3x"}, "body": "こんにちは！いつも素敵な絵をありがとうございます。\n今回私が考えたバ美肉案（https://twitter.com/sigmeya35/status/1216223443122655233?s=20）（https://twitter.com/sigmeya35/status/1424393151171612672)\nのキャラを描いていただきたく依頼させていただきました。\n要望は以下の通りですが、難しそうであれば無視していただいて大丈夫です。\n・そこはかとなく人外らしい怖さや倫理観の外れた雰囲気があると嬉しいです。\n・ブレードランナーや九龍城のような中華系スラム街の住民をイメージした子なので、絵にも反映してもらえると助かります。\nその他構図やディティールについてはお任せいたします。\nいただいたイラストはSNSのアイコンに使用させていただく可能性があります。\nどうぞよろしくお願いいたします。", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@sasakomitomo/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2820881, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/8d0f9595/uploads/origins/2a45cccf-b021-4abf-b0d5-919deb270f82?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3b243acd63953ce993430d7714df8b93", "srcset": "https://si.imgix.net/8d0f9595/uploads/origins/2a45cccf-b021-4abf-b0d5-919deb270f82?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3b243acd63953ce993430d7714df8b93, https://si.imgix.net/8d0f9595/uploads/origins/2a45cccf-b021-4abf-b0d5-919deb270f82?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=11c9090d9b46b0086b74469357a57791 2x, https://si.imgix.net/8d0f9595/uploads/origins/2a45cccf-b021-4abf-b0d5-919deb270f82?bg=%23fff&auto=format%2Ccompress&fm=web