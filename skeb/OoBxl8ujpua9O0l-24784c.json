メージ\n羞恥と混乱が伝わってくるものであれば、変更も可\n\n\n以上となります。\n不明・未指定の部分はお任せします。\nよろしければご一考の程、お願い致します。\n\nhttps://twitter.com/Tamao_PBW/status/1764191828444881266", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 256, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "筆禍＠ぴかすす動画コンテスト", "screen_name": "hikka06", "avatar_url": "https://pbs.twimg.com/profile_images/2062499802882232320/REN7JKt9.jpg", "header_url": "https://pbs.twimg.com/profile_banners/85097065/1737786245/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 14, "complete_expiration_days": 90, "skills": [{"genre": "comic"}], "banned": false, "nc": 49}, {"id": 1478544, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "アズマ🎀1y", "screen_name": "azumari_03", "avatar_url": "https://pbs.twimg.com/profile_images/2008141747902439424/dHPWyOOe.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1002001119541837824/1767618392/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 10, "complete_expiration_days": 20, "skills": [{"genre": "art"}, {"genre": "correction"}], "banned": false, "nc": 128}, {"id": 1514927, "creator": true, "nsfw_acceptable": false, "acceptable": false, "name": "かぎた", "screen_name": "kagitasuimen", "avatar_url": "https://pbs.twimg.com/profile_images/1969346620669247490/RbTFv_LT.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1620260838/1619789075/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days"