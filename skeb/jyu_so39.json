us/1700715516527362306\n\nネルソンちゃんの顔は赤く\n彼女の表情は恥じらっており\n内股で全身に汗をかいて震えている\n\nネルソンは顔を赤くして怒り、動揺して身体が震えている。\n怒っている様子として、頭には怒りマークと湯気のようなものが発生している。\n\n右手の人差し指を手前に突き出して\n左手で服の赤い部分を掴んで、服を下に伸ばそうとして\n少しでも身体を隠そうとしている。\n\nネルソンちゃんの右太ももには「朝凪」と墨で書かれた漢字があります。\n\nリクエストは以上です。", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@jyu_so39/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 547555, "client_id": 727284, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/8c13122f/uploads/origins/6cdbe03b-5d65-4b96-a503-d0c4a1f7583a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1d25fd0f43368cffa4ece3a7c2298b42", "srcset": "https://si.imgix.net/8c13122f/uploads/origins/6cdbe03b-5d65-4b96-a503-d0c4a1f7583a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1d25fd0f43368cffa4ece3a7c2298b42, https://si.imgix.net/8c13122f/uploads/origins/6cdbe03b-5d65-4b96-a503-d0c4a1f7583a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=31a577eb9c0786cbdd5f4f879a6c75e7 2x, https://si.imgix.net/8c13122f/uploads/origins/6cdbe03b-5d65-4b96-a503-d0c4a1f7583a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c78355c93bf5366d68bc6bf1741d6152 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/8c13122f/uploads/origins/6cdbe03b-5d65-4b96-a503-d0c4a1f7583a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=df44cd53baaacc55087344ecda522d89", "srcset": "https://si.imgix.net/8c13122f/uploads/origins/6cdbe03b-5d65-4b96-a503-d0c4a1f7583a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=df44cd53baaacc55087344ecda522d89, https://si.imgix.net/8c13122f/uploads/origins/6cdbe03b-5d65-4b96-a503-d0c4a1f7583a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&c