の空気感(木漏れ日など)が大好きなので、そんな要素が入ったイラストを描いて頂けるととても嬉しいです…！！！\n\nここまで読んで頂きありがとうございました！不備があれば再送要請をお願い致します！\n\nhttps://photos.app.goo.gl/fzTWpPFD5DZn8YAWA", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "similar_creators": [{"id": 2124, "creator": true, "nsfw_acceptable": false, "acceptable": false, "name": "鉄島", "screen_name": "ironjima", "avatar_url": "https://pbs.twimg.com/profile_images/1828405457905659904/lXJF0zkT.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1002772832512720896/1738070264/1500x500", "appeal_receivable": true, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 3, "complete_expiration_days": 80, "skills": [{"genre": "art"}, {"genre": "comic"}], "banned": false, "nc": 17}, {"id": 993483, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "木犀", "screen_name": "mokusei0516", "avatar_url": "https://pbs.twimg.com/profile_images/1717418282679242752/kNfpaaa7.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1334448316436762624/1696083071/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 10, "complete_expiration_days": 120, "skills": [{"genre": "art"}, {"genre": "video"}, {"genre": "correction"}], "banned": false, "nc": 176}, {"id": 2132955, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "きゅうた🥒", "screen_name": "4ki_10ma", "avatar_url": "https://pbs.twimg.com/profile_images/2062613315818528768/RWR5wTUM.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1268449563091714048/1767638633/1500x500", "appeal_receivable": true, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "com