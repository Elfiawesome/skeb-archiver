持った差分の追加(剣先を上に向けたものと、剣先を下に逆手持ちした差分)\n・鍵の形をした剣を持っている差分の追加(持ち方はビームソードと同じ)\n・胸の大きさを一回り大きくなっている差分の追加\n・黒スーツの服の差分の追加\n・参考画像にあるズボンの差分の追加\n・元々あるパーカーの萌え袖差分の追加\n・腕を腰に当てる差分の追加(右腕と左腕それぞれで腕の状態を切り替えられるようにする)\n・元々あるアリアルの差分は全て残す\n\nTRPGで使う全身立ち絵で使用する予定です\nよろしくお願いします\n\nhttps://drive.google.com/drive/folders/1--mfycNMLwZeNyH-U94fOfUvRmQnpqBf", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@yabuhebi1067/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2244544, "client_id": 3420834, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/6d6e4f58/uploads/origins/835a078b-7082-4595-a0b0-09f55cce43df?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1624b51aec965d4a6c39d68cb477313a", "srcset": "https://si.imgix.net/6d6e4f58/uploads/origins/835a078b-7082-4595-a0b0-09f55cce43df?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1624b51aec965d4a6c39d68cb477313a, https://si.imgix.net/6d6e4f58/uploads/origins/835a078b-7082-4595-a0b0-09f55cce43df?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=1921f2ad0b67a2412ed0d5fcc26154b4 2x, https://si.imgix.net/6d6e4f58/uploads/origins/835a078b-7082-4595-a0b0-09f55cce43df?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=7cf430279412edb6ada7793adbfbfb2a 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/6d6e4f58/uploads/origins/835a078b-7082-4595-a0b0-09f55cce43df?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e2a290e8fbcc06f7957b369f96681a62", "srcset": "https://si.imgix.net/6d6e4f58/uploads/origins/835a078b-7082-4595-a0b0-09f55cce43df?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e2a290e8fbcc06f7957b369f96681a62, https://si.imgix.net/6d6e4f58/uploads/origins/835a078b-7082-4595-a0