3364a0085?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f0279a33c6221cd8b46a33cda649ed57, https://si.imgix.net/ca535ccc/uploads/origins/e1652da8-7308-41f7-927e-a733364a0085?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e48774202745745434ed696f90a80567 2x, https://si.imgix.net/ca535ccc/uploads/origins/e1652da8-7308-41f7-927e-a733364a0085?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=2a45ae03c274f966302c0579db4df4a5 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/ca535ccc/uploads/origins/e1652da8-7308-41f7-927e-a733364a0085?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=036bcf175c53251f2115483060a0bdd3", "srcset": "https://si.imgix.net/ca535ccc/uploads/origins/e1652da8-7308-41f7-927e-a733364a0085?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=036bcf175c53251f2115483060a0bdd3, https://si.imgix.net/ca535ccc/uploads/origins/e1652da8-7308-41f7-927e-a733364a0085?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=f7493169e374f547daa648a1a21f2d93 2x, https://si.imgix.net/ca535ccc/uploads/origins/e1652da8-7308-41f7-927e-a733364a0085?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=b4c3aeb8a7a292e2eba415187a27fb13 3x"}, "body": "yuca様\n\nはじめまして!個人勢VtuberのAkoと申します。個人勢の配信者とは言っても、基本的には視聴者がおらず、自分で楽しみながらOCを育てているような感じです\n\n先生の絵から感じられる、どこか寂しげな雰囲気がとても好きです。Akoもそんな風に描いていただけたら嬉しいです。\n\nAkoの3つのステージの中から、先生がお好きな1つを選んでイラストを描いてください。自由にアレンジしていただいて大丈夫です。\n\n【ロリキャラ設定】\n·お家にこもりがちな小魔女さん、魔法でお人形のお友達を作れちゃうの\n·お人形とお話する時は意外とおしゃべりさん、でも家族以外とはほとんどお話しないんだ\n·時々とっても不器用で、針と糸や魔法の本をなくしちゃったり、自分で自分を傷つけちゃうことも\n·同い年の人間たちに仲間外れにされても、誰かを恨んだりしないの。ただ、どうやって人間と仲良くしたら·いいか悩んでるだけ\n·甘いものは大好き！でも苦いのは苦手なの～\n\n【アダルト設定】\n·魔力を失ってからネット依存気味の元魔女、現在はほぼ引きこもり\n·なぜか高校制服に特別な思い入れがある\n·ネット上では饒舌なのに、現実では無口（飲食店で注文するのも一苦労）\n·寂しがり屋で傷つきやすく、神経が細やか\n·時々うっかり者で、おっちょこちょいな失敗ばかり\n·ネット好きと同じくらい食べ歩きが趣味（美味しいもののためなら外出も厭わない）\n\n【ピクセルバイト設定】\n·生活費に追われて仕方なく引きこもり脱出\n·ロボットのように淡々とルーティンワークを処\n·残業が過ぎると突然ダークモード突入\n·集中しすぎて休憩中も無意識に作業動作しちゃう\n·なぜか簡単なところでポカをする\n·給料日だけは無限の忍耐力が発動\n\n設定された髪型や服装は自由に選んでいただけますが、どの設定でも涙ぼくろがありますので、必ず描き入れてください\n\n【その他】\n 不明な点は全てお任せさせて下さい、ご検討よろしくお願いいたします！\n\n【使用用途】\n ＳＮＳ等のプロフ画像や、個人で楽しむ範囲でグッズ等を 作る際等に使わせて頂きます\n\nhttps://drive.google.com/drive/folders/10aRBY6RfXwTi6g__q9Dbz_gUbk-a5ieK?usp=drive_link", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@seadct/works/9", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/3c9e1df6/uploads/origins/cd0761e6-9bac-4ef6-abe9-ca151dd85a5e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=fec0e9dceda4e8092ef0f1620fb2e9ca", "srcset": "https://si.imgix.net/3c9e1df6/uploads/origins/cd0761e6-9bac-4ef6-abe9-ca151dd85a5e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=fec0e9dceda4e8092ef0f1620fb2e9ca, https://si.imgix.net/3c9e1df6/uploads/origins/cd0761e6-9bac-4ef6-abe9-ca151dd85a5e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=845f3b652f11e3850e723cf6026ad389 2x, https://si.imgix.net/3c9e1df6/uploads/origins/cd0761e6-9bac-4ef6-abe9-ca151dd85a5e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=067aa25ad207df189e35659722fee676 3x"}, "private": true, "genre": "art", "tipped": false, "creator_id": 2377861, "client_id": 3483570, "nc": 144}, {"path": "/@seadct/works/8", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "ti