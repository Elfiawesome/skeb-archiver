=200&s=cb14a91b3bd1810ccd7eeb2a7ac30d7a", "srcset": "https://si.imgix.net/e7e76e89/uploads/origins/b84a37b4-683c-4a9d-b85b-aa7ed8bf1bc4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=cb14a91b3bd1810ccd7eeb2a7ac30d7a, https://si.imgix.net/e7e76e89/uploads/origins/b84a37b4-683c-4a9d-b85b-aa7ed8bf1bc4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=edb865ae2e99f6b628898f97878a32d7 2x, https://si.imgix.net/e7e76e89/uploads/origins/b84a37b4-683c-4a9d-b85b-aa7ed8bf1bc4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=7164a36e650c043b787c7a675bc723c3 3x"}, "body": "こんにちは、お会いできて嬉しいです！「おすすめクリエイター」のメールであなたのページを見つけ、そのスタイルに強く惹かれました。本当に素敵です！もしよろしければ、私のオリジナルキャラクターをあなたのスタイルで描いていただけませんか？\n\nエイブリーは率直で、口が達者で、エネルギッシュな人物です。他人に気に入られようとするより、思ったことを言うことを優先します。毎日を最大限に生きることを信条としており、他人が人生を無駄にしているのを見ると苛立ちを覚えます。新しいことに挑戦すること、美味しいものを食べること、大音量の音楽、鮮やかな色、そして甘やかされることを楽しんでいます。実はフェニックスですが、安全のためその事実を隠しています。\n\n普段着のままでも、好みに合わせて別の服装でも構いません（ノンバイナリー／ジェンダーレスなので、どんな服装でも大丈夫です）。翼を描いても構いません。全てはあなたの裁量にお任せします。お断りされる理由があれば、どうぞ遠慮なく。機会をいただきありがとうございます。良い一日をお過ごしください！\n\nhttps://drive.google.com/drive/folders/1nwGeoBpJ6VABnKM2XC9oqpKs1eismhb5?usp=drive_link", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@masamichitsune/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3882232, "client_id": 2685266, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/ae43fb2d/uploads/origins/044b809b-2dbb-4e45-97b8-570a34e5a5ad?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=805b1484afaccfeac33ce64d9a7f7629", "srcset": "https://si.imgix.net/ae43fb2d/uploads/origins/044b809b-2dbb-4e45-97b8-570a34e5a5ad?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=805b1484afaccfeac33ce64d9a7f7629, https://si.imgix.net/ae43fb2d/uploads/origins/044b809b-2dbb-