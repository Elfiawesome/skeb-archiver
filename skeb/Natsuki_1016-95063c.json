ored_thumbnail_image_urls": {"src": "https://si.imgix.net/a2904cd7/uploads/origins/dd959641-09d1-45e5-a19c-bc21c97a4ad2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5a83636a70c0d0a72946da89f97f7561", "srcset": "https://si.imgix.net/a2904cd7/uploads/origins/dd959641-09d1-45e5-a19c-bc21c97a4ad2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5a83636a70c0d0a72946da89f97f7561, https://si.imgix.net/a2904cd7/uploads/origins/dd959641-09d1-45e5-a19c-bc21c97a4ad2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=ebd71930b9e0bbff73cec78289fdb1b3 2x, https://si.imgix.net/a2904cd7/uploads/origins/dd959641-09d1-45e5-a19c-bc21c97a4ad2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=15a07b46a3fb67ce14e9df84e6b4c81c 3x"}, "body": "以前からTwitterでイラストを拝見していました\n送ろうかと考えていた依頼を送らせていただきます\n\n海岸に居る水色ビキニ姿のデアリングタクトをお願いします\n\nイメージとしてはトレーナーと海へ遊びに来て、タクトが着替えてビキニ姿を見せに来たのをトレーナー目線で見ているようなシチュです\nスリーサイズなど公式で出ていますが美乳美尻と表現できるくらいの大きさでスラっとした体つきで描いていただきたいです\nポーズ、背景、ビキニのデザインなどはお任せしますが照れて恥ずかしそうな顔、トレーナーの体などは入れずタクトがビキニ姿と分かる構図でお願いします\n\n可能でしたら白ワンピースを上に着てビキニが透けている差分もお願いします", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Natsuki_1016/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 973402, "client_id": 1032160, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/8ebea2be/uploads/origins/aff0b455-b223-4573-b92c-3255f90e3358?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4d7d83af5118913bf9c572fc8f24dec9", "srcset": "https://si.imgix.net/8ebea2be/uploads/origins/aff0b455-b223-4573-b92c-3255f90e3358?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4d7d83af5118913bf9c572fc8f24dec9, https://si.imgix.net/8ebea2be/uploads/origins/aff0b455-b223-4573-b92c-3255f90e3358?bg=%23fff&auto=format%