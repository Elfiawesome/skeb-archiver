前の https://skeb.jp/@Alpha01Code/works/5 等にて描いて頂いた子のご依頼となります。\n\n今回はジャージや萌え袖の袖を結ぶいたずら的な感じで、この子が衣装の袖同士を結び合わされてしまって両手を拘束されてしまっているようなシチュが欲しいのと\n裾に隠れたままの足の部分まで見えるような全身のある構図が最低一つはあると良いです。\n\n手や足が衣装の長い袖や裾に覆われて見えない感じに描いてくれさえすれば後はなんでも大丈夫ですので、\nそれ以外の部分や作品の構図等はお任せします。\n\n参考資料↓\nhttps://drive.google.com/drive/folders/1mrAl3HpQQzQOHO2p9fMPoKjM5tWbEhW4", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Alpha01Code/works/11", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2265923, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/70e8da3b/uploads/origins/be06749c-8876-41d9-8856-4f9f101dbdee?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1ecf5e4c907bc1bbacebd753f942be93", "srcset": "https://si.imgix.net/70e8da3b/uploads/origins/be06749c-8876-41d9-8856-4f9f101dbdee?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1ecf5e4c907bc1bbacebd753f942be93, https://si.imgix.net/70e8da3b/uploads/origins/be06749c-8876-41d9-8856-4f9f101dbdee?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=35b6f17e4abf4b2efad3d6c4fb9be2bd 2x, https://si.imgix.net/70e8da3b/uploads/origins/be06749c-8876-41d9-8856-4f9f101dbdee?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=9cca3aa3a3bc01e74cae8e96a1daafe4 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/70e8da3b/uploads/origins/be06749c-8876-41d9-8856-4f9f101dbdee?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9e844766d97b078f93246328d37e0748", "srcset": "https://si.imgix.net/70e8da3b/uploads/origins/be06749c-8876-41d9-8856-4f9f101dbdee?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9e844766d97b078f93246328d37e0748, https://si.imgix.net/70e8da3b/uploads/origins/be06749c-8876-41d9-8856-4f9f1