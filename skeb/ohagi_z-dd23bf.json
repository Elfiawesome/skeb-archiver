ogle.com/drive/folders/1Mi6BJvkQ8UZxynjOpgwwBNfS2ur8sDxs", "nc": 9, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@ohagi_z/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "comic", "tipped": true, "creator_id": 3757388, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/71b21b40/uploads/origins/e8359504-3429-4815-a6f8-75c1c8b2e32e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ebc50ad6ab69e2fa45baab1d23620d25", "srcset": "https://si.imgix.net/71b21b40/uploads/origins/e8359504-3429-4815-a6f8-75c1c8b2e32e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ebc50ad6ab69e2fa45baab1d23620d25, https://si.imgix.net/71b21b40/uploads/origins/e8359504-3429-4815-a6f8-75c1c8b2e32e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e0971f079dd4b74c44d284b0d399f6cf 2x, https://si.imgix.net/71b21b40/uploads/origins/e8359504-3429-4815-a6f8-75c1c8b2e32e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a42df45f6c47e65bd4b836a5bebc9ca3 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/71b21b40/uploads/origins/e8359504-3429-4815-a6f8-75c1c8b2e32e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=fe8fe3b8d2af152bfaafa1fa696004ff", "srcset": "https://si.imgix.net/71b21b40/uploads/origins/e8359504-3429-4815-a6f8-75c1c8b2e32e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=fe8fe3b8d2af152bfaafa1fa696004ff, https://si.imgix.net/71b21b40/uploads/origins/e8359504-3429-4815-a6f8-75c1c8b2e32e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=e9796fbfbe914b3a9ede162c1495e343 2x, https://si.imgix.net/71b21b40/uploads/origins/e8359504-3429-4815-a6f8-75c1c8b2e32e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=e8e2db266ee4671f9663a5fa5e632c1d 3x"}, "body": "〇はぎ先生初めまして。\n是非依頼を承諾して頂ければ幸いです。\n\nリクエストは、創作の爽(そう)とスイというキャラです。\nこの二人はSF世界観のキャラクターです。\n爽は最愛の人間を失っており、その人間を食って擬態化しているのがスイというキャラです。\n\n【世界観】\n何度目かの世界戦争が勃発し、アメリカの何割かがコロニー(宇宙船)に乗り、地球から逃げ宇宙人と交流している。\nコロニー内の上層部と農業部・開発部・軍事部・医療部・育成部のトップ、育成部内の職員が不老長寿薬を飲んでいる。\n現在の技術より進歩している。\n\n爽/175cm/48歳\n一人称:俺\n二人称:お前\n三人称:呼び捨て\n淡々とした性格でリアリスト。\n成績優秀で秀才。基本的になんでも出来る。表情筋がほぼ動かない。\n極度の甘い物好き。生クリームを直飲みできる。\nただ、人の気持ちを汲み取るのが苦手としており、全ての物事に正論しか言わないため、物言いがキツめ。\n一緒に暮らしていた男(弘樹)を自ら殺した後、その男を愛していたことに気づき絶望し、数十年ほど引きずっていた。(不老薬を投与されるため見た目は資料のまま)\nその傷ついた心が多少和らいだ頃、生物を食う事でその食った生物に擬態できる生物が最愛の男を食っており、その擬態した生物と出会い動揺する。\n\nスイ/180cm/推定1000歳\n一人称:我(われ)\n二人称:あんた、お前さん\n三人称:呼び捨て\nスイは正式名称ではなく、自称の名前であり、基本的にこの生物自体に固有名詞はない。触手は同時に2本出すことができ、身体の何処からでも生やすことができる。\n人間ではないため、デリカシーがない。\n人間がこういう時はこの顔をする、と学び、感情があるように表情をコロコロ変えているが、基本的に感情はない。\n食べるという行為が大好きであり、爽が作ったご飯を食べる為に彼の家に居候している。\n食った生物の記憶を見ることができ、爽の最愛の男の記憶の中に関西弁の人間がいたため、その話し方を気に入りエセ関西弁を話す。\n\n〇はぎ先生の描く死にたがり少女と食人鬼さんの大ファンです。私の性癖は先生で構成されたと言っても過言ではありません。そんな◯はぎ先生がスケブをするとのことで依頼致しました。\n◯はぎ先生の絵柄、世界観でぜひこの二人を描いていただけたら幸いです。◯はぎ先生のご自由に描いてください。\n\n以下に資料を提示いたしますので確認ください。\nhttps://drive.google.com/drive/folders/1bubkUectFY0xRJZghnrRNUmfHrPV0mH3?usp=sharing\n\n【使用用途】\n個人利用の鑑賞、自分用の壁紙とアイコン、個人用に印刷などの使用をさせて頂く可能性がございます。\nSNS,ネットで公開する際には先生の名前を注記して投稿し、その他のルールに準じます。\n\nここまで読んで頂きありがとうございます。\n私のリクエストを考慮して頂ければ幸いです。\nよろしくお願いいたします。", "nc": 137, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 1729772, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "真角シオ🐂🥕", "screen_name": "shio_ushi", "avatar_url": "https://pbs.twimg.com/profile_images/1655441811656302593/UeIF5Gxj.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1461521770775986177/1668318722/1500x500", "appeal_receivable": true, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 3