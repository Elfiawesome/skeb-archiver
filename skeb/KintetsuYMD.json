c-a175-4b98-bfeb-7d393f586daa?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=40e2432f42647fd5ba0a0badee25884d, https://si.imgix.net/9cea8888/uploads/origins/7e06557c-a175-4b98-bfeb-7d393f586daa?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=424c4ed834e06e289a15c34e9376e66c 2x, https://si.imgix.net/9cea8888/uploads/origins/7e06557c-a175-4b98-bfeb-7d393f586daa?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=f3cd733d40cfc03be1f74cc470fdf7c7 3x"}, "body": "再びご依頼させて頂きます！\n自分が発行している「ドラゴンファーム西東京」というオリジナル同人誌のキャラクターから漆田 環（うるしだ かん）と巻島すずり（まきしま すずり）、そして二人が面倒を見ているドラゴンを1体お願いします。\nドラゴンがエキゾチックアニマルの一種としてペットとして飼育したり競馬のようなドラゴンレースが開催されたりしている世界観で、二人はドラゴンのブリーダーをしています。\n環はドラゴンのケガを治したりする獣医のようなポジションで、大型のドラゴンもよじ登ったりして治療しなくてはならないのでクライマーのような筋肉質な体です。\nすずりはドラゴンが一般人でも扱えるように訓練する、現実のブリーダーと同じようなポジションです。こちらも翼竜に騎乗して飛んだりするため全体的に筋肉質で、特に太ももがパツパツだとかなり嬉しいです。幼い頃からドラゴンと異常に仲良しです！\nそしてドラゴンなのですが、こちらはかふん先生のお好きなようにデザインして頂きたいと思います。\n「ヒックとドラゴン」に登場するような愛嬌はありながらも現実に生息していそうな雰囲気だとありがたいです。\n大きさは最低でも馬くらいのサイズのある個体だと嬉しいですがお任せします。\n何卒宜しくお願い致します。\n\nhttps://drive.google.com/drive/folders/1-6E7RFD184s6RadvrgbN340lLVk-2x98?usp=sharing", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@kafun/works/824", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 120238, "client_id": 24262, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/97dbadd1/uploads/origins/1f7869f3-40ac-4bed-834e-8757571d8e5b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7dc1f346ac1b3225e343f7a2fe9b5599", "srcset": "https://si.imgix.net/97dbadd1/uploads/origins/1f7869f3-40ac-4bed-834e-8757571d8e5b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7dc1f346ac1b3225e343f7a2fe9b5599, https://si.imgix.net/97dbadd1/uploads/origins/1f7869f3-40ac-4bed-834e-8757571d8e5b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=5e9287c30e1af089f7ed5d4df8042444 2x, https://si.imgix.net/97dbadd1/uploads/origins/1f7869f3-40ac-4bed-834e-8757571d8e5b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=71fb4b2ab4dcd72f6517903cb0c70ddd 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/97dbadd1/uploads/origins/1f7869f3-40ac-4bed-834e-8757571d8e5b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=1aca138f9348f3c10956761e477c983b", "srcset": "https://si.imgix.net/97dbadd1/uploads/origins/1f7869f3-40ac-4bed-834e-8757571d8e5b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=1aca138f9348f3c10956761e477c983b, https://si.imgix.net/97dbadd1/uploads/origins/1f7869f3-40ac-4bed-834e-8757571d8e5b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=f388cef13ff69a9237b40ce0f8b577e9 2x, https://si.imgix.net/97dbadd1/uploads/origins/1f7869f3-40ac-4bed-834e-8757571d8e5b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=271ede361c8026817cf9d6fce52304df 3x"}, "body": "初めてご依頼させて頂きます。\n当方が創作同人で出している「性擬態幼馴染」というシリーズのオリジナルキャラクター、若葉（男）とタケル（女）のイラストをお願いできませんでしょうか？\nシチュエーションは2人が私服でUSJのようなテーマパークに遊びに行っているイラストでお願いします。\n\n鈴白若葉（すずしろわかば）（男）…元は女子ですが性転換体質で男体化。アメコミオタクの科学女子で赤いフレームの眼鏡をかけています。男体化した時の体型はやせ型だけど骨格が男らしい感じで、服装はアメコミのTシャツやキーホルダーなどUSJ好きの人が気合い入れて関連グッズ身に着けて行く！みたいなイメージです。髪型はハーフアップでお願いします。\n黒部丈瑠（くろべたける）（女）…元は男子ですが性転換体質で女体化。水泳部所属で日焼けしています。\n女体化しても三白眼ですが、体型はむちっとしています。服装はタンクトップでデコルテが見えつつ、ベイマックスのゴーゴーちゃんのようなボーイッシュなパンツスタイルだと嬉しいです。\nタケルはアメコミオタクではないので若葉ほどグッズなどは身に着けていません。（パークで買ったお揃いグッズなどを身に着けるのは有りです！）\n\nテーマパークの描写は大変だと思うので、雰囲気が伝わればぼやかしていただいて構いません。\nキャライメージの参考資料を下記転送サービスにアップ致しました。\nhttps://drive.google.com/drive/folders/1UEuVj3X7i3ri7wFzeCtYCOlmNiKCVeHP?usp=sharing\n資料URL（ツイッター）は同人誌本編の試し読みになります。\n\nかふん先生のイラストが大好きでいつか依頼させて頂きたいと思っておりました…！\nお忙しい中とは存じますが、もし宜しければご検討いただければ幸いです…！\n\nhttps://twitter.com/YMDsubsub/status/1495708895620517894?s=20&t=cu-Qp80T2ebzqbu5yFBUAA", "nc": 160, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@gomalemo/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 23965, "client_id": 24262, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/6e933e30/requests/771?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a1702e4e3ad0b37e552cd63230413c75", "srcset": "https://si.imgix.net/6e933e30/requests/771?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a1702e4e3ad0b37e552cd63230413c75, https://si.imgix.net/6e933e30/requests/771?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f5d44aaf1a631c06f12219279e786c45 2x, https://si.imgix.net/6e933e30/requests/771?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=1583cecd38dc700d1b2b403ebc844d29 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/6e933e30/requests/771?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=bd52d579981d8fc8aba087942b32dd52", "srcset": "https://si.imgix.net/6e933e30/requests/771?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=bd52d579981d8fc8aba087942b32dd52, https://si.imgix.net/6e933e30/requests/771?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=1a299f4a3bb9dbe4d236b18192e439a7 2x, https://si.imgix.net/6e933e30/requests/771?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=76db88c0f82e7933c82f0ca9b1c5d96d 3x"}, "body": "シマリスを竜化したイラストを希望します。現実のシマリスは冬ごもりのためにくるみなどの木の実を蓄えますが、竜化したらどんな冬支度をするのかな？と楽しく想像して頂ければ嬉しいです。木の実集めに拘らずとも巣作りなどでも構いません。よろしくお願いします。", "nc": 16, "word_count": 0, "transcoder": "image", 