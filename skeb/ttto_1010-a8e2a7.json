d6b73, https://si.imgix.net/bc1970ab/uploads/origins/843660c7-0f59-4388-b867-f773aaf51b83?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=22549ac6b8de23295acf26ed90ef21e8 2x, https://si.imgix.net/bc1970ab/uploads/origins/843660c7-0f59-4388-b867-f773aaf51b83?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=aab56ae963dffb35621f9cf1ca6968a1 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/bc1970ab/uploads/origins/843660c7-0f59-4388-b867-f773aaf51b83?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=05d8708c7fd2491da99c164b8f93c4b8", "srcset": "https://si.imgix.net/bc1970ab/uploads/origins/843660c7-0f59-4388-b867-f773aaf51b83?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=05d8708c7fd2491da99c164b8f93c4b8, https://si.imgix.net/bc1970ab/uploads/origins/843660c7-0f59-4388-b867-f773aaf51b83?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=d6a3a2bfd7468dad27889b75f94dd6c9 2x, https://si.imgix.net/bc1970ab/uploads/origins/843660c7-0f59-4388-b867-f773aaf51b83?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=1ad1f09d8c2c0386dde392d1a554ee06 3x"}, "body": "初めまして、ファッションのゆるさとタイトのバランスやアクセの使い方などに引かれました。もしよければ私の自創作百合をお願いしたいです。\nファッションはトゲトゲさまのセンスに完全にお任せしたく、ピアスやメガネ他表情や髪もお任せします(銀髪の方にはピアスホールが無く、青髪の方には1対ですが、いくつ描いていただいても大丈夫です)。トゲトゲさまの作風を重視していただけたらと思います。\n基本情報として、青髪は地毛が赤紫のため色で描く場合、今も睫毛のみ赤紫です。芯があり健康的で可愛いイメージです。\n銀髪が右で、少しぼーっとしたオン眉細身色白の子です。髪が短めで背は高いですが普通に女の子として描いていただけたらと思います。\n資料がゴチャついており申し訳ありません、顔立ち(5)と体型(6)の資料だけ見てもらえれば情報は大丈夫かと思います。\nご縁があれば嬉しいです。\n\nhttps://drive.google.com/drive/folders/1cNG9ZOQUH1_gaN8A3V5xCBfAGRzN7UuO", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@ttto_1010/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tippe