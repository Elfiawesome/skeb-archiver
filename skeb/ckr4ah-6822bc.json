me_genre": true}, {"path": "/@ckr4ah/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1801054, "client_id": 1241185, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/f3e32147/uploads/origins/096d25df-0e71-451b-a001-ed37594c4aee?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=400ce241cd215948775494586545afaa", "srcset": "https://si.imgix.net/f3e32147/uploads/origins/096d25df-0e71-451b-a001-ed37594c4aee?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=400ce241cd215948775494586545afaa, https://si.imgix.net/f3e32147/uploads/origins/096d25df-0e71-451b-a001-ed37594c4aee?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c0e0b4cedc1c38ead41969b25f0aa61e 2x, https://si.imgix.net/f3e32147/uploads/origins/096d25df-0e71-451b-a001-ed37594c4aee?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a5950831554e9abd148be687526a1ebe 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/f3e32147/uploads/origins/096d25df-0e71-451b-a001-ed37594c4aee?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b946ec6d8951c74d42c098a637fb98aa", "srcset": "https://si.imgix.net/f3e32147/uploads/origins/096d25df-0e71-451b-a001-ed37594c4aee?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b946ec6d8951c74d42c098a637fb98aa, https://si.imgix.net/f3e32147/uploads/origins/096d25df-0e71-451b-a001-ed37594c4aee?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=e47bf27aac7121e83af49aa0b12faa7e 2x, https://si.imgix.net/f3e32147/uploads/origins/096d25df-0e71-451b-a001-ed37594c4aee?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=05c3c2a4e142fcc78b302b4763b28224 3x"}, "body": "チキリさんこんにちは。\n\nいつぞや、執事の成宮由愛ちゃんとお嬢様の望月聖ちゃんをお願いしたものです。\n\n\nさて、此度も是非執事の由愛ちゃんをお願いしたく存じます。\n\n今回お願いしたいのは、\n\n「刀を携えて、足下に月明かりが差し込む路地に佇みながら電話で会話する執事の成宮由愛ちゃん」\n\nです。\n\nシチュエーションというか、そうなる経緯と致しましては…\n\nお嬢様である聖ちゃんを狙う悪い連中がおり、それの始末を聖ちゃんパパ(いわゆる大旦那様？)から仰せつかった由愛ちゃん。\n\n大旦那様からの情報を元に、由愛ちゃんは丸腰でその悪い連中のもとへ赴きます。\n\n突如現れた由愛ちゃんに、悪者達は驚きますが、悪者達はバットやナイフ、銃などを武器に由愛ちゃんに襲い掛かります。\n\n由愛ちゃんは軽やかな身のこなしで、それらをかわしたり、いなしたりしつつ、どんどんやっつけていきます。\n\nそして、最後に残った1人。手には日本刀を握っています。\n\n悪者は震えながらも、果敢にも刀を振り上げ由愛ちゃんに襲いかかりますが、逆に由愛ちゃんに刀を奪われて、由愛ちゃんはその奪った刀で悪者を一刀両断。\n\n……(以下お願いしたい絵のシチュエーション)\n\n全ての始末を終えた由愛ちゃんに電話がかかって来ます。画面には主人の名前。\n\n「もしもし、由愛ちゃん？今何処にいるの？今日一日全然姿を見かけないのだけれど……」\n\n「すみません、実は急な用事がありまして一日館を抜けておりました。おかげで用事も済みましたので、今から館に戻りますね……。」\n\n心配そうな主人を安心させるべく優しい声色の由愛ちゃん。\n\n手には赤く染まった刀を携えて建物の影で由愛ちゃんの顔には影がかかっている。\n\nしかし、その足元には帰りを待つ主人が手を伸ばすように明るい月明かりが差し込んでいる。\n\n\nそんな感じで…どうぞよろしくお願いします！！！", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@ckr4ah/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1801054, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/09dd4efe/uploads/origins/8e2d9372-b48c-4138-9baa-38785cb771ab?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ca39d7072e901944a04451bb31076ff8", "srcset": "https://si.imgix.net/09dd4efe/uploads/origins/8e2d9372-b48c-4138-9baa-38785cb771ab?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ca39d7072e901944a04451bb31076ff8, https://si.imgix.net/09dd4efe/uploads/origins/8e2d9372-b48c-4138-9baa-38785cb771ab?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=521b2637ce4a6dd1054024a6b17ec463 2x, https://si.imgix.net/09dd4efe/uploads/origins/8e2d9372-b48c-4138-9baa-38785cb771ab?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=62161edc6a676e28466d21f99b6c963e 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/09dd4efe/uploads/origins