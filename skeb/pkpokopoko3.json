/si.imgix.net/7d44af9c/uploads/origins/c026157e-eaac-4401-a5f4-c77e41192464?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=bc2338a2c827cb976e535f97188b9715", "src_set": ""}, "private": true, "genre": "art", "tipped": true, "creator_id": 1692506, "client_id": 2698667, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 128, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@pkpokopoko3/works/31", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1692506, "client_id": 656453, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/cc7a8c8c/uploads/origins/634696a7-2dbd-4455-880c-808163b91068?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1fed438e1bab6bf6b0e2b2bf6f936add", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/cc7a8c8c/uploads/origins/634696a7-2dbd-4455-880c-808163b91068?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f0d734bff88da4cc5389798d2b74c6d3", "src_set": ""}, "body": "再びこんにちは！以前も素敵な写真をありがとうございました。\n私の鳥の女の子フィービーの写真が見たいです！彼女は惑星の大きさまで成長できる魔法少女です。遊び好きでエネルギッシュ、気立てがよくのんきな性格です。\n\n写真としては、彼女が地球という惑星に座り、地球をスツール代わりにして、小さな惑星や月の観客に向かって楽しそうに歌っているところを見たい。まるで \"惑星規模のポップスター \"のようだ。片足を太ももの上に置いて、足を組んでリラックスしながら歌っている。\n\n私は、惑星の表面に巨大な足跡クレーターが無数にあると嬉しい。足跡のクレーターがどんどん大きくなって、フィービーが歩き回っているうちにどんどん大きくなっていく様子を表現することもできる！\n\n彼女の衣装を調整したり、他のポップスターの衣装を使ったりするのも自由です！またご一緒できる機会をありがとうございました！\n\nhttps://www.dropbox.com/scl/fi/ugv6z62sw9i4u5dfuayil/Magical-Girl-Phoebe.png?rlkey=b2hse81gip96q9xpxx6yqkx9d&dl=0", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@pkpokopoko3/works/30", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1692506, "client_id": 1909888, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/243a6a20/uploads/origins/a37c0bbb-726e-49a2-9aa0-2f2ed438e50b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f63da03d0985624bb25454ddbeb65f94", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/243a6a20/uploads/origins/a37c0bbb-726e-49a2-9aa0-2f2ed438e50b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=96631e058c668e25e1276f60f1519eb4", "src_set": ""}, "body": "こんにちは！あなたからの依頼に興味があります！\n僕のキャラクター、オリーを描いてほしいんだ！\n眠そうな表情でコーヒーを飲んでいるところとか！\n\nオリーの参照：https://drive.google.com/file/d/1cbJb2QaKKyAu3S1Cg2JlHJTt6x-XfboQ/view?usp=drivesdk\n\nよろしくお願いします！", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@pkpokopoko3/works/29", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1692506, "client_id": 52601, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/f8f1da67/uploads/origins/126f93a8-1783-4fce-b4dc-85e4d2cb031d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3eb376ea3bcb4c31ae986ce070b4ff13", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/f8f1da67/uploads/origins/126f93a8-1783-4fce-b4dc-85e4d2cb031d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a44617d67964156ffad99a4197a3ae26", "src_set": ""}, "body": "今回リクエストさせて頂きましたパイロンといいます。\nX(Twitter)では別垢の方でイラストを楽しくご拝見しております。\nイラストリクエストは私のオリジナル竜人をお願いします。\n変身したアーマー姿の方で装備は複雑であれば省略、アレンジして頂いても構いません。\nローアングルで靴（足先）をメインに見せるポーズをお願い致します。\n資料はURLに貼っております。\nhttps://x.com/PYLON_GT/status/1702523330241474934?s=20\nhttps://x.com/PYLON_GT/status/1702524511491645907?s=20\n\nhttps://x.com/PYLON_GT/status/1702524511491645907?s=20", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@pkpokopoko3/works/28", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/714ff240/uploads/origins/70961fbb-518b-4126-8e34-3abbb154bfbe?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=f1a0472c7f705a9b006a613dbb0fc66a", "src_set": ""}, "private": true, "genre": "art", "tipped": false, "creator_id": 1692506, "client_id": 2900292, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 0, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@pkpokopoko3/works/27", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1692506, "client_id": 2049406, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/d126384c/uploads/origins/c14f31b8-9e30-4f94-b4ff-60eb65571072?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=dd11e060aa50d675fe5159724fb13186", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/d126384c/uploads/origins/c14f31b8-9e30-4f94-b4ff-60eb65571072?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=20fe58614074842316233b80f3081719", "src_set": ""}, "body": "初めまして！！！\nぽこ🐋さんの絵を拝見させていただきまして是非私もと思い、依頼させていただきました。\n\n私自信を描いて頂きたいなと思います。\nポーズなどはお任せいたします。\n\nよろしくお願いします！\n\nhttps://twitter.com/8910_Soarer/status/1525143942303338496?s=20", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@pkpokopoko3/works/26", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1692506, "client_id": 2912288, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/1ed1f2a9/uploads/origins/6de8de79-7ef1-4421-a3bf-d757b147d7a6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9248a334e77b4a81c6bcb3c95e5f1a7d", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/1ed1f2a9/uploads/origins/6de8de79-7ef1-4421-a3bf-d757b147d7a6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ca0184a1226d1ead263b27b1431013bd", "src_set": ""}, "body": "ぽこさんはじめまして。あまんちゅと申します。イラストを楽しく拝見させて頂いております。\n\n今回ぽこさんのタッチでイラストを依頼したいと思い、リクエストさせていただきました。\n今回描いて頂きたいのがオリキャラの「イノ」をお願いしたいです。\n内容ですが、資料URLにある服装を着ている、ヘルメットは外している状態でのイラストをお願いしたいと思っております。それ以外の指定はありません。自由に表現して頂いて大丈夫です。\n\n納品された作品をSNSのアイコンに使用するなどの個人利用の範疇で使わせて頂く場合がございます。\n\n以上になりますが何卒よろしくお願い致します。\n\nhttps://drive.google.com/drive/folders/10Uyc0bKzsUtwbk7Eu6jyaePA4crmJZeg", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@pkpokopoko3/works/25", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1692506, "client_id": 1496640, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/53950474/uploads/origins/7956fd75-f7e6-4b26-9eb1-843226514a1b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=cb6a2e05ad5503dbe34a93d4cdf8f397", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/53950474/uploads/origins/7956fd75-f7e6-4b26-9eb1-843226514a1b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=be1ba9e6ba0842a6e919078953d27db9", "src_set": ""}, "body": "ぽこさんこんにちは！\nうちのトリケモちゃんをお願いしたいです！\nふわふわお尻がよく見えるような感じでお願いしたいです…！\n衣装変更やシチュエーション等は自由にしてください！\nもし大丈夫であればよろしくお願いします！\n　\nhttps://drive.google.com/drive/folders/1ZGK1pQLW_BxUGN023GtLyKG2rDdcOW-3", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@pkpokopoko3/works/24", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1692506, "client_id": 2327892, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/9f1e664e/uploads/origins/8069fb09-ddd7-487f-a65d-45c7424fb6fd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a4bbf61407380fb207d1c928fd2403be", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/9f1e664e/uploads/origins/8069fb09-ddd7-487f-a65d-45c7424fb6fd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=95c17388fdb2a45a38281ae48dc6422e", "src_set": ""}, "body": "こんにちは、ズマサと申します。\n\n以前の依頼では素敵なアカガネくんのイラストありがとうございました。\n今回も、ぽこさんのタッチで当方のオリキャラである「スイハ」のイラストをお願いしたいと思いましたのでリクエスト失礼いたします。\nスイハさんは青色の体色を持つ女性の鷲さんです。\n\n前回のアカガネくんと同様にイラストの構図、シチュエーションについては特に指定はありませんが、可能であれば全身が見えるようにお願いいたします。服装についても資料にある制服以外でも問題ありませんので自由に表現して頂いて大丈夫です。\n\nぜひともぽこさんのタッチで描かれるスイハさんを見てみたいと思っております。お手数をおかけしますがよろしくお願いいたします。\n\nスイハさん資料\nhttps://drive.google.com/drive/folders/1nQ6MAbAOeIpfJHVKCqz-pOI58r3zuwEq?usp=sharing", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@pkpokopoko3/works/23", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1692506, "client_id": 2829716, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/c1b08161/uploads/origins/404b3e2b-ccfe-44a7-89d9-3ae4f796b490?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6f5dbdf0a4e0cf53fd58d4f1585d7d07", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/c1b08161/uploads/origins/404b3e2b-ccfe-44a7-89d9-3ae4f796b490?bg=%23fff&auto=form