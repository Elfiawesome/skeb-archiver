ull, "body": "", "nc": 16, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@pkpokopoko3/works/49", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/24aadbc8/uploads/origins/b09536a8-8d66-402e-b4ba-4d27a6187ace?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=773a9c808f162d26248c93d95b602342", "src_set": ""}, "private": true, "genre": "art", "tipped": false, "creator_id": 1692506, "client_id": 2912143, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 129, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@pkpokopoko3/works/48", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/1516e3e2/uploads/origins/5128895a-7089-4e19-8b70-63ba4e1d9a0d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=4438c21694a6b569e38ee28cc10b2bf5", "src_set": ""}, "private": true, "genre": "art", "tipped": true, "creator_id": 1692506, "client_id": 2698667, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 128, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@pkpokopoko3/works/47", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1692506, "client_id": 3172476, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/de3aeead/uploads/origins/c138fcb0-9a46-4d6b-8876-95a5978ad400?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8883b27555426f0a48d4ae3d2b88a6fd", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/de3aeead/uploads/origins/c138fcb0-9a46-4d6b-8876-95a5978ad400?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f2c35a58614dfc46ed587d08100ace97", "src_set": ""}, "body": "こんにちは！テンの妖怪のキャラデザをして頂きたくてリクエストしました！\n\n動物はホンドテン(キテン)をイメージしています。もちろん完全に同じでなくとも、イタチ科の特徴が残っていればOKです。\n\nこの子の背景をざっくり言うと、｢殺された仲間達の亡骸を食べて力を得た、テンの化け物｣という感じです。\nサイズは全長が人より大きく、普通の人間なら余裕で薙ぎ倒してしまえる強さはあります。でも行動原理が怒りなので、賢くはなさそうです。\n\n背景はなくても大丈夫です！余裕があれば、横から見た時のデザインが分かりやすいとありがたいです。\nよろしくお願いします！\n\n・以下元になっている構想メモからの切り抜き↓\n“人里から少し離れた山の中、人に巧みに化けられる能力を持つテンの妖怪たちが数匹いた。\nしかし毛皮を目当てにやってきた人間に、集まっていた所を狙われてしまう。\n逃げ惑うも仲間を餌におびき寄せられ、一人、また一人と殺されていく。\n足だけになった亡骸をかかえ、一番若い子の元に命からがら戻ってきた仲間も死んでしまった。\n怒りと悲しみで憎悪に火がつき、生き残りは仲間たちの亡骸を食べることで、宿っていた怨念と力を吸収し急激に力を付けた。\n\n〈この姿がリクエストした獣〉\n\n最終的には暴れ回っている所を軍に捕縛されたが、訳あって処分を免れ、ある人物に引き渡される事となる。”", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@pkpokopoko3/works/46", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/d29a4dd7/uploads/origins/57a711ce-6c9a-4d1a-9761-456cf474c91c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=93129c6435480cc4a30f0df5a2f07128", "src_set": ""}, "private": true, "genre": "art", "tipped": true, "creator_id": 1692506, "client_id": 0, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 0, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@pkpokopoko3/works/45", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/1baaf8d7/uploads/origins/a0f24888-ad1a-4ec2-8393-8844c726aa61?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=e1fa0c8e43413e5a0c653a6415