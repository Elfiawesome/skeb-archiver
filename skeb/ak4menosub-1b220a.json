園キリコがかわいすぎて一番好きです）\n\n僕の依頼はSDトレーサーです（BLUE FLAME）\n\n・表情の雰囲気はクソガキ感をなるべく取り入れて欲しいですが、\n　あかめの様の作品スタイルに合わない場合は変更でも結構です\n\n・ポーズはパルスピストルを両手で構えた形が良いですが、\n　全体的な構図やアングルなどにこだわりは無く、\n　最初のポイント以外は全てお任せします\n\n・できれば「MOKHA」または「mokha」をどこかに入れて欲しいです\n　難しければ「モカ」でお願いします\n\n使用用途は主にTwitterやDiscordのアイコンです\nご検討よろしくお願いします\n\n参考\nhttps://x.com/caffemokha/status/1955740659685712230\nhttps://x.com/caffemokha/status/1955740665348022598", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@ak4menosub/works/15", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3404992, "client_id": 3063282, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/b6eb9bc0/uploads/origins/42775940-110b-4ab8-adb2-579b0e4ac6aa?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=226eaf2b89f57ecd9697b353b703cdeb", "srcset": "https://si.imgix.net/b6eb9bc0/uploads/origins/42775940-110b-4ab8-adb2-579b0e4ac6aa?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=226eaf2b89f57ecd9697b353b703cdeb, https://si.imgix.net/b6eb9bc0/uploads/origins/42775940-110b-4ab8-adb2-579b0e4ac6aa?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=67784d4b0ccbf9bca1b21687fa2480eb 2x, https://si.imgix.net/b6eb9bc0/uploads/origins/42775940-110b-4ab8-adb2-579b0e4ac6aa?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=307395d624b33b21764121fd02bf7145 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/b6eb9bc0/uploads/origins/42775940-110b-4ab8-adb2-579b0e4ac6aa?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=05271aefda1d27e6fb4bfecffbcbacd4", "srcset": "https://si.imgix.net/b6eb9bc0/uploads/origins/42775940-110b-4ab8-adb2-579b0e4ac6aa?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=05271aefda1d27e6fb