a3-668b721c6f66?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0eca21591f0a156cb4500d5d239fa0dc", "srcset": "https://si.imgix.net/e969e32d/uploads/origins/3a071c5d-e900-42c8-94a3-668b721c6f66?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0eca21591f0a156cb4500d5d239fa0dc, https://si.imgix.net/e969e32d/uploads/origins/3a071c5d-e900-42c8-94a3-668b721c6f66?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=381885824aa43980c2b7bc1cd8c8186f 2x, https://si.imgix.net/e969e32d/uploads/origins/3a071c5d-e900-42c8-94a3-668b721c6f66?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=c4d7542892a965c00e3b9d133abaaf14 3x"}, "body": "こんにちは！ブルスカでのご縁に感謝します！クロスフォリオでお見かけするうちの子さんホナミちゃんが可愛い！元気な姿がとてもラブです！\n彼女を眺めていてビビっときました！あなたに描いて頂けたらとても可愛くなる予感！\n\nうちの新顔OC「蟲憑きのドリヴァ」を描いて頂けますか？\nファンタジー世界の風変わりな女の子。やや人外風な外見です。詳細は資料ご覧ください。\n\n※R15相当のダークな物語の登場人物です。執筆中で登場前ですが、彼女は悲惨な扱い・結末を辿る可能性があります。お苦手ならご無理なく！\n\nリクエストは戦闘中の彼女。愛用の戦斧を振りかぶって飛びかかる姿など。\n戦斧は身の丈の倍ある怪斧です。彼女は見かけより遥かに怪力で、担いだまま飛び跳ね軽々と振り回します。不器用なのでモグラたたきのように雑に振り下ろすばかりですが、一撃一撃が絶大。盾や鎧は紙切れ同然。しかも痛みは快楽に変換され、超回復力も兼ねる体質で超タフ。\n一方、性格はとても消極的で臆病。戦闘中でも顔だけ弱腰。あわあわと涙目でテンパりながら、バ火力で一方的に敵を粉砕していきます。\n\nちなみに戦闘中の彼女の手は真っ黒。これは彼女の血です。\n超回復力の一方、肌が病的にもろく、大斧を振り回すと摩擦で手指から容易に出血します。血が黒いのも体質。\n\nフィールドはどこでも。原野や街中、洞窟など。昼夜も問わず。\nまた、彼女の敵はこの精霊たちです｡描き込んで頂けるなら⇒https://xfolio.jp/portfolio/yodom_bee/works/4688687\n\nなお、彼女の登場作は私の一次創作『なじか嗄れなきロウレライ』（確認用：https://xfolio.jp/portfolio/yodom_bee/free/358162）。ご納品頂けたものですが、登場作関連アートと呼べる範囲での使用をお許し願いたく思います（掲載のほかサムネイル化、宣材内利用等）。常に他作として作者明記、非商用、リワードオフの条件下で。なお掲載時には転載・第三者利用防止を兼ねた低解像度化や自前のウォーターマーク、ノイズの追加をさせて頂くことがあります。X、META社系列SNSへの投稿は致しません（現在同名義アカウントなし）。さしあたってはご自分のサインを入れて頂けると助かります。\n\n以上、ご都合に適いましたら幸いです。ご検討よろしくお願い致します。\n\nhttps://ln5.sync.com/dl/c47750960#m52vdinw-7pg2wcb9-nn2efcqh-u688iccf", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [{"path": "/@binzoko_paroma/w