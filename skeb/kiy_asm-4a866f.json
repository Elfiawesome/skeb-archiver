/\u9ad8\u63da/\u9752\u3056\u3081)+2\u70b9(\u7791\u76ee/\u958b\u773c)\n\u30fb\u5c0f\u7269\uff08\u7159\u7ba1\u3001\u8776\u3005\u306e\u6a19\u672c\uff09\n\n\u3010\u4f7f\u7528\u7528\u9014\u3011\n\u30fbTRPG\u30bb\u30c3\u30b7\u30e7\u30f3\u306b\u304a\u3051\u308b\u7acb\u3061\u7d75\u3068\u3057\u3066\u306e\u4f7f\u7528\n\u30fb\u7b2c\u4e09\u8005\u3078\u306e\u30a4\u30e9\u30b9\u30c8\u4f9d\u983c\u6642\u306b\u8cc7\u6599\u3068\u3057\u3066\u306e\u4f7f\u7528 (\u7121\u511f/\u6709\u511f\u554f\u308f\u305a)\n\u30fbSNS\u3067\u306e\u516c\u958b(\u30c7\u30a3\u30b9\u30d7\u30ec\u30a4/\u30bb\u30c3\u30b7\u30e7\u30f3\u5831\u544a\u306e\u969b\u306e\u30b9\u30af\u30ea\u30fc\u30f3\u30b7\u30e7\u30c3\u30c8\u3068\u3044\u3046\u5f62\u3067\u516c\u958b\u3057\u307e\u3059\u3002)\n\n\u3010\u30b7\u30ca\u30ea\u30aa\u540d\u3011\n\u30ab\u30ce\u30e8\u8857/HO1\uff1a\u58f1\u756a\u5730\u306e\u6a19\u672c\n\n\u3010\u5f62\u5f0f\u3011\n\u80cc\u666f\u900f\u904e\u3067\u3042\u308c\u3070\u30b5\u30a4\u30ba\u3084\u89e3\u50cf\u5ea6\u306b\u6307\u5b9a\u306f\u3042\u308a\u307e\u305b\u3093\u3002\n\n\u3010\u30ad\u30e3\u30e9\u30af\u30bf\u30fc\u8a73\u7d30\u3011\n\u6027\u5225\uff1a\u5973\n\u5e74\u9f62\uff1a20\u4ee3\u304f\u3089\u3044\n\u8eab\u9577\uff1a200cm(\u8718\u86db\u306e\u30dc\u30c7\u30a3\u3092\u542b\u3081)\n\u77b3\u8272\uff1a\u8840\u306e\u3088\u3046\u306a\u8d64(\u767d\u76ee\u306e\u90e8\u5206\u306f\u9ec4\u8272)\n\u6027\u683c\uff1a\u30bb\u30af\u30b7\u30fc\u306a\u5de8\u4e73\u304a\u59c9\u69d8\n\u5c0f\u7269\uff1a\u7159\u7ba1(\u30ad\u30bb\u30eb)\u3001\u8776\u3005\u306e\u6a19\u672c\n\n\u305d\u306e\u4ed6\uff1a\u56db\u8155\u306e\u30a2\u30e9\u30af\u30cd\u306e\u3088\u3046\u306a\u898b\u305f\u76ee\u306e\u30ad\u30e3\u30e9\u30af\u30bf\u30fc\u306b\u306a\u308a\u307e\u3059\u3002\u8718\u86db\u306e\u30dc\u30c7\u30a3\u306f\u30bf\u30e9\u30f3\u30c1\u30e5\u30e9\u306e\u3088\u3046\u306a\u8089\u539a\u306a\u30bf\u30a4\u30d7\u3002\u8718\u86db\u306e\u4f53\u8272\u306f\u9ed2\u3002\n\u3000\u3000\u3000\u3000\u632f\u8896\u304b\u82b1\u9b41\u304c\u7740\u308b\u3088\u3046\