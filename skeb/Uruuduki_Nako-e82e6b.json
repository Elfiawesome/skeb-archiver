s=e898d04b679587150e4ef5ff6b6c6fb3 3x"}, "body": "「お散歩中に偶然出会って満面の笑みでおはようと挨拶してくれる閏月ナコちゃん」を描いてほしいです。要望は下記の通りです。\n・背景、衣装、ポーズ、角度などはお任せします（可能なら夏っぽい感じで。\n・髪型は三つ編みで。\n・この予算ですのでもちろん全身じゃなくてよいです。\n細かいことはさておき満面の笑みで話しかけてくるナコちゃんというイメージで描いてくれたら嬉しいです。よろしくお願いします。", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@Uruuduki_Nako/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 74219, "client_id": 1193001, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/88740e18/uploads/origins/7783974c-2530-48cb-b272-274d03ae5de2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a9ec8b5fea993b91b4e63a977ad53054", "srcset": "https://si.imgix.net/88740e18/uploads/origins/7783974c-2530-48cb-b272-274d03ae5de2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a9ec8b5fea993b91b4e63a977ad53054, https://si.imgix.net/88740e18/uploads/origins/7783974c-2530-48cb-b272-274d03ae5de2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c9b2210b3dd96922fcd20f0975c672d9 2x, https://si.imgix.net/88740e18/uploads/origins/7783974c-2530-48cb-b272-274d03ae5de2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e89de8b00fdf72aff80200231ee6e678 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/88740e18/uploads/origins/7783974c-2530-48cb-b272-274d03ae5de2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=41ddc729c7071e60ab10fe77d1740303", "srcset": "https://si.imgix.net/88740e18/uploads/origins/7783974c-2530-48cb-b272-274d03ae5de2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=41ddc729c7071e60ab10fe77d1740303, https://si.imgix.net/88740e18/uploads/origins/7783974c-2530-48cb-b272-274d03ae5de2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=to