b9b76?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f060cac091e5ca7371113ef27fbbe006, https://si.imgix.net/c8de8418/uploads/origins/ee3c4086-9f44-4e1b-b0b2-82f883db9b76?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=70b0271beddb71d3fa3c9ffa6626f117 2x, https://si.imgix.net/c8de8418/uploads/origins/ee3c4086-9f44-4e1b-b0b2-82f883db9b76?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=0c48e5c1c412e161cea555bf4cfa35c4 3x"}, "body": "先生の作品をXで拝見し、その美しい画風に一目惚れしました。先生描く女の子はめちゃくちゃかわいい。この度ぜひ先生にお願いしたいと思い、依頼させていただきます以下が依頼内容となります：\n\n\t•\tキャラクター：私のオリジナルキャラクター「芹澤瑠依」\n\t•\tサイズ：お任せいたします\n\t•\t表情：お任せいたします\n\t•\t背景：お任せいたします\n\t•\t服装：白と黒ベースの2000s流行りのライトゴシックスタイル\n\t•\t動き：お任せいたします\n\t•\t注意点：自分いつも使う物入れたいです、もし物品が著作権に違反する場合、先生は他の物品に変更するか、描かなくても構いません。\n\n芹澤瑠依：かわいい物、めいぐるみ、猫、お本が大好きで17歳の魔術師少女。現代魔術師として活動しています。モチーフは廃棄場所、非日常感の日常、カコッカワイイ、深夜、大正風の場所。\nまた人物のみの透過差分もお願いしたいです。\n\n先生が描かれる衣装デザインの方向性は、特に制限を設けません！先生が楽しく創作してくださることが一番大切だと思っております。\n今回の依頼をお引き受けいただけることを心より願っております。どうぞご検討のほど、よろしくお願いいたします。\n\n内容や金額に問題があれば、再送が可能かと思います。難しい場合はキャンセルしていただいても構いませんので、ご検討のほどよろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/1SfYqFABCWXMTka_laAyowIHifx07JkB0", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@haihki/works/15", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1746258, "client_id": 2050581, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/637238de/uploads/origins/f2f5f164-1252-4f99-9937-f2f62e21848e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=16df32aa24e2a75cba962effa1215da2", "srcset": "https://si.imgix.net/637238de/uploads/origins/f2f5f164-1252-4f99-9937-f2f62e21848e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=16df32aa24e2a75cba962effa1215da2, https://si.imgix.net/637238de/uploads/origins/f2f5f164-1252-4f99