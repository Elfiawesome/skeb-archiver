p&w=200&h=200&s=501d44b2eb6e0bb6eb8daa82c36be26c, https://si.imgix.net/7e5c1456/uploads/origins/5eb833b7-2588-4279-b167-f9e88d07f133?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f9ea3e9e9fbb7942d833a6f75b3db6e6 2x, https://si.imgix.net/7e5c1456/uploads/origins/5eb833b7-2588-4279-b167-f9e88d07f133?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=10aedcc1004819287e23294ee3c2f23c 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/7e5c1456/uploads/origins/5eb833b7-2588-4279-b167-f9e88d07f133?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f63a256385771fdf0bd41a2616e5af52", "srcset": "https://si.imgix.net/7e5c1456/uploads/origins/5eb833b7-2588-4279-b167-f9e88d07f133?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f63a256385771fdf0bd41a2616e5af52, https://si.imgix.net/7e5c1456/uploads/origins/5eb833b7-2588-4279-b167-f9e88d07f133?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=665e629aaebdee9f925c0fe76b95eabe 2x, https://si.imgix.net/7e5c1456/uploads/origins/5eb833b7-2588-4279-b167-f9e88d07f133?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=53b52191ae2007f04c3e9d15ae9a7bbd 3x"}, "body": "こんにちは！\n\nあなたの作品がとても好きです！^^\n\nだから、私のキャラクターで依頼を考えてもらえたらとても嬉しいです！\n\nゼンはアライグマの男の子で、船で宇宙を旅し、惑星を訪れてテレビ番組やビデオゲームのような娯楽について学んでいます！やんちゃだけど正直で、誰かが傷つくのを見たくない。\n\n普段は宇宙船「スペース・トラッシュ・バージ」で旅をし、ネオンやサイバーパンクをテーマにした街で過ごすのが好きだ。\n\n故郷の惑星では「騎士」でもあり、戦闘服を持っている。このコンバットスーツを着た彼のアートワークの依頼を引き受けてくれると嬉しい！\n参考までに、彼が下に着ているプラグスーツも載せておきます！\n\nポーズなどは喜んでお任せします！そして、もし引き受けていただけたら、作品作りを楽しんでいただけたらと思います！^^\n\nありがとうございました！\nゼン\n\nhttps://drive.google.com/drive/folders/11Ay10aTXb2EXIShqgwe4FtwvgkQhlQFt?usp=sharing", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@shinagawa_one/works/2", "private_th