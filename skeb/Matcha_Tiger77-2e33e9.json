3fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bb33110d6efba1947188ff4e223cbb30", "srcset": "https://si.imgix.net/645d4bc3/uploads/origins/997245cf-87de-4bd7-a80e-42f5cf40248e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bb33110d6efba1947188ff4e223cbb30, https://si.imgix.net/645d4bc3/uploads/origins/997245cf-87de-4bd7-a80e-42f5cf40248e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=9aa3f78b0cc8badb785dcb43b3daec86 2x, https://si.imgix.net/645d4bc3/uploads/origins/997245cf-87de-4bd7-a80e-42f5cf40248e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=42ec704a75d8819517cd785349a2ae8d 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/645d4bc3/uploads/origins/997245cf-87de-4bd7-a80e-42f5cf40248e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ed008cd1b6f31b8caaedba81f6bce6cc", "srcset": "https://si.imgix.net/645d4bc3/uploads/origins/997245cf-87de-4bd7-a80e-42f5cf40248e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ed008cd1b6f31b8caaedba81f6bce6cc, https://si.imgix.net/645d4bc3/uploads/origins/997245cf-87de-4bd7-a80e-42f5cf40248e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=09deda3c4f94542c83b3a42f6f3b475e 2x, https://si.imgix.net/645d4bc3/uploads/origins/997245cf-87de-4bd7-a80e-42f5cf40248e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=e15685f4432c01eef20d5abbf2333252 3x"}, "body": "リクエスト送信失礼します。\nしずくと千景が二人で飲みながら談笑してるイラストをお願いします。\nシチュの想定としては、成長後に同棲を始めた二人が仕事の後に一杯やりながら団欒してる感じです。\n居酒屋でも宅飲みでも描きやすい場所の想定で大丈夫です\n服装は、しずくは上着がタンクトップの作業着姿（大満開の章の4年後の世界時の服装っぽい感じです）、千景がOLでスーツのイメージです。\nそれと、シズク＆千景で同じ構図の差分verもお願いしたいです。\nよろしくお願いします。", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Matcha_Tiger77/works/4",