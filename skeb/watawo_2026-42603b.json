て頂けると嬉しいです。\n\nVtuberモデル（オリキャラ）へのイラストや使用用途がジャンル外、モデルが気に入らない等で却下して頂いても問題ございません。\n何卒条件等合いましたらご検討の程宜しくお願いします。\n\nhttps://drive.google.com/drive/folders/11dKZv6WOilzkK6q44YHN_fup8mg5q3UG?usp=sharing\n\nhttps://drive.google.com/drive/folders/11dKZv6WOilzkK6q44YHN_fup8mg5q3UG?usp=sharing", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@watawo_2026/works/1", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/d33670b6/uploads/origins/3747a9a7-2099-4c4b-a584-f6b8d4ac903a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=76b503fa884b2e97f8520651a193bdf1", "srcset": "https://si.imgix.net/d33670b6/uploads/origins/3747a9a7-2099-4c4b-a584-f6b8d4ac903a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=76b503fa884b2e97f8520651a193bdf1, https://si.imgix.net/d33670b6/uploads/origins/3747a9a7-2099-4c4b-a584-f6b8d4ac903a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=ec10629c2c57370e71a0e632df6d10a6 2x, https://si.imgix.net/d33670b6/uploads/origins/3747a9a7-2099-4c4b-a584-f6b8d4ac903a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=91a1c0792d6f350af366e05c1aa084bd 3x"}, "private": true, "genre": "art", "tipped": true, "creator_id": 3994768, "client_id": 2014247, "nc": 1}], "sent_works": [], "similar_creators": [{"id": 765082, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "東東🦄ご依頼垢", "screen_name": "world__te", "avatar_url": "https://pbs.twimg.com/profile_images/1866774337791070209/QnWp4BYt.jpg", "header_url": "https://pbs.tw