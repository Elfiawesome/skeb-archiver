て、小さな牙、狼の耳と尻尾があります。※人の耳はありません。\n尻尾は衣装を貫通させずに、ワンピースの下から出ているように描いて欲しいです。\nお好みで衣装のアレンジ・装飾類の追加などあればぜひお願いします。\n\n\n◆作品について\n主に観賞用ですが、SNS・Youtube・WEBサイトで使用する可能性があります。いずれも非商用です。\nデータは背景透過済みのPNGを別途添付するか、キャラと背景が別レイヤーのPSDが希望です。\n\n\n以上、ご検討よろしくお願いします。\n\nhttps://drive.google.com/drive/folders/12dLEgPCkh4ArkfKgxSOHPz-i2Ns1ckcu?usp=sharing", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 151454, "creator": true, "nsfw_acceptable": false, "acceptable": false, "name": "リース", "screen_name": "aaabaaab222", "avatar_url": "https://pbs.twimg.com/profile_images/1718166221584277504/yFCPSHuW.png", "header_url": "https://pbs.twimg.com/profile_banners/416818105/1626349469/1500x500", "appeal_receivable": true, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 90, "skills": [{"genre": "art"}, {"genre": "comic"}], "nc": 128}, {"id": 465009, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "えだまめこ🌱", "screen_name": "mamec0s", "avatar_url": "https://pbs.twimg.com/profile_images/1539027386662285312/csIlHN65.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1243834150261407744/1678185988/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 7, "complete_expiration_days": 40, "skills": [{"genre": "art"}, {"genre": "correction"}], "nc": 160}, {"id": 741209, "creator": true, "nsfw_acceptable": false, "acceptable": false, "name": "ろくしょう", "screen_name": "patina_jam", "avatar_url": "https://pbs.twimg.com/profile_images/1699427286867451904/QuEJ9xyc.jpg", "header_url": null, "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_a