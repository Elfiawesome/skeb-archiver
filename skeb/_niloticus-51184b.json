6054005809428?s=20\n\n希望する画像は古めかしいカメラで撮ったものですが、それ以外でも先生にお任せして大丈夫です！\n\n備考\n背景がある場合は、背景なしの一文字を透過したpngを渡してほしい！\n\nこの依頼を引き受けていただけると嬉しいです！\n\n*自動翻訳を使用しているため、間違いがあるかもしれませんが、ご容赦ください！", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@_niloticus/works/2", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/027e1dbe/uploads/origins/3ecd8ecc-e6d8-4804-bf93-9c5c76cf9afc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=1a31b770ea5d5a60cb2502574fd6c206", "srcset": "https://si.imgix.net/027e1dbe/uploads/origins/3ecd8ecc-e6d8-4804-bf93-9c5c76cf9afc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=1a31b770ea5d5a60cb2502574fd6c206, https://si.imgix.net/027e1dbe/uploads/origins/3ecd8ecc-e6d8-4804-bf93-9c5c76cf9afc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=78ef8aee0d8b8867425bf15dfbbd6e74 2x, https://si.imgix.net/027e1dbe/uploads/origins/3ecd8ecc-e6d8-4804-bf93-9c5c76cf9afc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=297884f91282df61be57e4ec622180b1 3x"}, "private": true, "genre": "art", "tipped": false, "creator_id": 3094811, "client_id": 2712132, "nc": 16}, {"path": "/@_niloticus/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3094811, "client_id": 1249073, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/3ad78de7/uploads/origins/69b0748c-e5bd-4a06-acfc-b585c6489e2e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=848c064d7b92ec8