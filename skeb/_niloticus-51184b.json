たピンクは、体を回復させるためにこの島にやってきました。 ここで青の情熱と執念に触れ、二人は恋に落ちた。 \n\n 構図とポーズなどは自由にお願いします。 \n服装は好きの選んでください。アレンジ、省略もご自由にどうぞ。  \n\n金額を変更して再送することも可能です。\nご検討のほど宜しくお願いいたします。\n\nhttps://drive.google.com/drive/folders/1qLKCIcOjaB7rXwFzMspXQ09J4wyQ6pMh?usp=share_link", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@_niloticus/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3094811, "client_id": 2403555, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/bee184ab/uploads/origins/6da2d8e1-4803-4470-8b9a-a079a66a0af2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=302e080d34ef1d88acde3b529d17b5d7", "srcset": "https://si.imgix.net/bee184ab/uploads/origins/6da2d8e1-4803-4470-8b9a-a079a66a0af2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=302e080d34ef1d88acde3b529d17b5d7, https://si.imgix.net/bee184ab/uploads/origins/6da2d8e1-4803-4470-8b9a-a079a66a0af2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=24f34d3c54443bbcee46366c75dd4c98 2x, https://si.imgix.net/bee184ab/uploads/origins/6da2d8e1-4803-4470-8b9a-a079a66a0af2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=98f23ea021f64921b129013a6211a9f5 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/bee184ab/uploads/origins/6da2d8e1-4803-4470-8b9a-a079a66a0af2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3b8264fe0b0712a319f93410f2d71aff", "srcset": "https://si.imgix.net/bee184ab/uploads/origins/6da2d8e1-4803-4470-8b9a-a079a66a0af2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3b8264fe0b0712a319f93410f2d71aff, https://si.imgix.net/bee184ab/uploads/origins/6da2d8e1-4803-4470-8b9a-a079a66a0af2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&