rmat%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=3900dd1f644f5bc32a0a248ec4ea5364 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/16aea1a2/uploads/origins/610fdc38-03f3-4a51-aed4-0634870db841?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e8f538820e05ac46cfef9a0f362d2385", "srcset": "https://si.imgix.net/16aea1a2/uploads/origins/610fdc38-03f3-4a51-aed4-0634870db841?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e8f538820e05ac46cfef9a0f362d2385, https://si.imgix.net/16aea1a2/uploads/origins/610fdc38-03f3-4a51-aed4-0634870db841?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=7f923f8844c2cfda3e4f6c065adc3adf 2x, https://si.imgix.net/16aea1a2/uploads/origins/610fdc38-03f3-4a51-aed4-0634870db841?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=ada46fb2c74763a407cf50b353c10e3f 3x"}, "body": "こんにちは！\n\n友人と私はあなたのアートワークが大好きで、にじさんじのイルーナのLets Get It Startedのカバーアートを描いていただけたらと思います！総勢6名なので、適当にアピールしてください。主にカバーアートに使用させていただきますが、クレジット表記があればSNSなどにも使用させていただく可能性があります！\n\nイルーナメンバーと一緒に、キャラクターリファレンスを入れました。例えば、「キャラクターリファレンスA」なら「A」と一緒になります。また、衣装・ポーズのリファレンスもフォルダに入れました。私たちのキャラクターに合わせて、色も変えてください！16:9で作っていただけると、背景も追加されて最高です！\n\nレイヤーごとに分けて、PSDファイルをお送りください！\n\n遠慮なくアピールしてください！\nご配慮いただき、本当にありがとうございました。\n\nhttps://drive.google.com/drive/folders/1oLe4ZGGm5NY9K2zMOj-p-92bHOSl-huz?usp=sharing", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@zzz_time/works/15", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1986186, "client_id": 1146662, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/67d22311/uploads/origins/904f4b53-8978-4082-98e5-a85a75652495?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9d31895fa90e66f001be0bbb2