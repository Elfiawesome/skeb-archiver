7f4c80a93f?bg=%23fff&fm=webp&auto=compress&dpr=3&fit=crop&crop=top&w=200&h=200&s=55c944f57e2bacd8a11443f9398562c5 3x"}, "duration": 36, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/f5075a17/uploads/outputs/b3fa0557-2959-4993-a433-067f4c80a93f?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&blur=200&s=bd9675284479f16be630d52eed3f62b2", "srcset": "https://si.imgix.net/f5075a17/uploads/outputs/b3fa0557-2959-4993-a433-067f4c80a93f?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&blur=200&s=bd9675284479f16be630d52eed3f62b2, https://si.imgix.net/f5075a17/uploads/outputs/b3fa0557-2959-4993-a433-067f4c80a93f?bg=%23fff&fm=webp&auto=compress&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=b17e5bf1e52e9f2b30520b4712bbe55e 2x, https://si.imgix.net/f5075a17/uploads/outputs/b3fa0557-2959-4993-a433-067f4c80a93f?bg=%23fff&fm=webp&auto=compress&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=1ef98ff8bbfaef72591c78bfedbefc9e 3x"}, "body": "古城りーみん📻🫖🕯(エロゲギャルゲ特化VTuber)様、\nそこそこ見かける島戸静（シマドジョウ）でございます。\nこの度はYouTube のエンディング動画を依頼させていただきます。\n\n◯作成して頂きたい動画について\n【映像の概要】\n・視点は水槽の内部に固定し、水槽越しに島戸セイの生活をのぞき見る構図にしてください。\n・島戸セイのデザインはリンク先を参照してください。\n　リンク：https://x.com/shimado_sei/status/1995663323132821608?s=20\n・全体の大きな配置については下記リンク先を参照してください。\n　あくまで大まかなイメージなのでこのような雰囲気くらいで参考にしてください。\n　リンク；https://drive.google.com/file/d/1MrNtVEFrx2sKdxQ3-p7brOeX8ImmeA-F/view?usp=drive_link\n・動画の長さはエンディングとして自然な範囲（20～30秒程度を想定）で構いません。\n\n【水槽の構成】\n・水槽内は和風レイアウトにしてください。\n・シマドジョウを必ず入れてください。\n・左右に水草を配置してください。\n・タンクメイトとしてメダカ、エビ、貝などを入れてください。\n・生体は全て日本の淡水生物にしてください。\n\n【部屋のレイアウト】\n・家具配置は基本的に自由です。\n・CRTテレビと本棚は必ず入れてください。\n・本棚の中身はゲームソフトと攻略本にしてください。\n・その他の家具や小物は、季節ごとにその季節の物に自然に変化するようにしてください。\n\n【季節表現】\n・映像内で季節が春、夏、秋、冬の順に自然に移り変わるようにしてください。\n・光の色、外の景色、カーテンの揺れ方、季節小物などを用いて、季節ごとに雰囲気が変化するように表現してください。\n\n【生活動作】\n・島戸セイの生活動作は、四季に応じて自然なものになるようにしてください。\n・例として、お茶を飲む、窓を見る、掃除をする、棚からゲームソフトを取る、テレビゲームをするなどがあります。\n・動作の内容や組み合わせは自由に構成していただいて構いません。\n\nお忙しいところ恐縮ですがご検討頂けますと幸いです。\nよろしくお願いいたします。", "nc": 1, "word_count": 0, "transcoder": "video", "creator_acceptable_same_genre": true}, {"path": "/@RRR_min0401/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3717214, "client_id": 1711770, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/a66a47d5/uploads/origins/79a09fad-5fa9-47f2-9594-4c7a1ccdd431?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b1b0bca6cb98270f277cc3474d8f543e", "srcset": "https://si.imgix.net/a66a47d5/uploads/origins/79a09fad-5fa9-47f2-9594-4c7a1ccdd431?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b1b0bca6cb98270f277cc3474d8f543e, https://si.imgix.net/a66a47d5/uploads/origins/79a09fad-5fa9-47f2-9594-4c7a1ccdd431?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=506716860f84e0eee6cf1efde2e0d99a 2x, https://si.imgix.net/a66a47d5/uploads/origins/79a09fad-5fa9-47f2-9594-4c7a1ccdd431?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=6e51e54206e9bfbc29998947be9a391a 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/a66a47d5/uploads/origins/79a09fad-5fa9-47f2-9594-4c7a1ccdd431?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b1a2257587692a1834508162016395c5", "srcset": "https://si.imgix.net/a66a47d5/uploads/origins/79a09fad-5fa9-47f2-9594-4c7a1ccdd431?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b1a2257587692a1834508162016395c5, https://si.imgix.net/a66a47d5/uploads/origins/79a09fad-5fa9-47f2-9594-4c7a1ccdd431?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=e3ae810946ab3b972a0f88080767c7e1 2x, https://si.imgix.net/a66a47d5/uploads/origins/79a09fad-5fa9-47f2-9594-4c7a1ccdd431?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=bafb459