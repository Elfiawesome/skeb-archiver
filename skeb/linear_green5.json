e, reading manga, etc.).\"\n\nご自由に描いてください。先生にとってかっこいいシーンであればうれしいです。\n\nご検討よろしくお願いします。", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@linear_green5/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3601569, "client_id": 3519950, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/7942e5f3/uploads/origins/ed21f7ec-3778-47d5-abdd-edcbaf3024bb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a6ad4e27aa0c6abe97c4eb68a8f88a5b", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/7942e5f3/uploads/origins/ed21f7ec-3778-47d5-abdd-edcbaf3024bb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b23585ed107440899c29247df007f849", "src_set": ""}, "body": "こんにちは！\n\nアピールありがとうございます\nとてもかわいいアイデアですね\n自由に描いてください！\n\nありがとうございました！\n\nhttps://imgur.com/a/xandie-reference-material-78KYP7c", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "similar_creators": [{"id": 75550, "creator": true, "nsfw_acceptable": true, "acceptable": false, "name": "森野道山", "screen_name": "no_hone", "avatar_url": "https://pbs.twimg.com/profile_images/1920004499126751232/1bnG0ff2.png", "header_url": null, "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "skills": [{"genre": "art"}], "nc": 49}, {"id": 521434, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "葛餅 少戦R8 A-55", "screen_name": "KPL_kuzumochi", "avatar_url": "https://pbs.twimg.com/profile_images/1267383457916674048/4SGhwA8t.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1149676065809297409/1660112277/1500x500", "appeal_receivable": false, "popular_creator_rank": null, 