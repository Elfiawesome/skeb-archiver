6a0bb66b945b87d61d689ff 2x, https://si.imgix.net/61e8d6d5/uploads/origins/33e3d0f4-cbe9-4c59-8d67-bacb42e702ec?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a0f8c64add02e37d59c3509862552605 3x"}, "duration": null, "nsfw": true, "hardcore": true, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/61e8d6d5/uploads/origins/33e3d0f4-cbe9-4c59-8d67-bacb42e702ec?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9f9f39e0db3ee357898991a6026eec34", "srcset": "https://si.imgix.net/61e8d6d5/uploads/origins/33e3d0f4-cbe9-4c59-8d67-bacb42e702ec?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9f9f39e0db3ee357898991a6026eec34, https://si.imgix.net/61e8d6d5/uploads/origins/33e3d0f4-cbe9-4c59-8d67-bacb42e702ec?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=3cf1402b0e8cfcea0742630cc42ceea9 2x, https://si.imgix.net/61e8d6d5/uploads/origins/33e3d0f4-cbe9-4c59-8d67-bacb42e702ec?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=c818e5bdd461df53da65880b15424e26 3x"}, "body": "こんにちは！首の挿げ替えのコミックを描いていただければと思います。\n内容：私に天使が舞い降りた！の星野みやこはいつものように白咲花にコスプレをさせて撮影していた。みやこは首輪型の挿げ替え装置（前回のごちうさの挿げ替えと同じ物）とおっさんと幼女の首なしの身体を用意する。花はおっさんの身体、みやこは幼女の身体に挿げ替え撮影したり、近親相姦プレイを動画で撮ったりしてセックスしまくる。\nまた、花はみやこの元の身体をオナホがわりに使って中出しする。\n設定について︰\n・挿げ替え装置については前回とほぼ同じです。追加要素で生体ディルドパーツがあります。\n・生体ディルドパーツは挿げ替えて首なしになった元の身体に付けるパーツです。チンコの根元に挿げ替え装置の首輪があり、これを首元に装着します。\n装着後は首からチンコが生えてるような見た目になります。（おっぱいの上にディルドの金玉が重なる）\n・装着後は直ぐに勃起し、我慢汁を出し続けます。チンコの刺激は神経を通って、首から下の身体にも伝わり、イクと痙攣します。逆に首から下の刺激はディルドに伝わります。自律型でなく、アプリで行動を操作しますが、たまに制御が効かず自らオナニーすることもあります。\n・挿げ替える首から下の身体は以下の通り。\n花︰50代のおっさんの身体。身長は180cmで体重120kg。ビール腹で毛深く肌色が濃い。チンコは30cmもある巨根で玉もソフトボール大の大きさ。絶倫で10回セックスしても収まらない程。\nみやこ︰4歳の幼稚園児。みやこの頭が30cmで、身体は50cm程のチグハグなイメージ。手足も小さい（手はみやこの顔を覆えない程）。ロリマンコだがセックスできるよう発情状態かつ初潮済みにしてある。\n元の首から下に生体ディルドパーツ（中年男の褐色巨根チンコ、竿が40cmで金玉は大玉メロン並）を付けます。\n各ページについては以下の通りでお願いします。\n1ページ︰みやこと花はいつものように撮影していると、みやこは挿げ替え装置と挿げ替え用の首なしの身体、そして生体ディルドパーツを持ってくる。\nそして、花にはおっさんの身体に挿げ替えて欲しいとお願いする。最初は嫌がるがお菓子あげると言うと快諾。\n2ページ︰2人は首に挿げ替え装置を付ける。するとドローンのように浮遊して花はおっさんの首元に、みやこは幼女の首元に付き挿げ替える。花は挿げ替えた瞬間チンコが勃起してムラムラし始める。\n挿げ替え後の姿は全身絵で、元の首なしの身体は脱力して倒れ込む描写を入れてください。\n3ページ︰みやこは幼女の小さい手で花のおっさんチンコを手コキし始める。花は我慢できずにみやこの顔にぶっかけ射精する。\n4ページ︰花はみやこの身体を抱っこして駅弁の体勢でセックスし始める。徐々にピストン運動のスピードが上がっていく。みやこも幼女のロリマンに極太チンコを入れられる快感で気持ちよくなる。2人がイきそうになり、同時に中出し＆潮をふく。\n5ページ︰次にみやこは元の自分の身体を四つん這いにするよう花に頼む。四つん這いにした後、首に生体ディルドパーツを付ける。すると首のチンコが勃起し、みやこの身体や巨乳もこの刺激で震える。\n6ページ:みやこの身体は首のチンコを両手で掴んで扱き始め、射精する。みやこの身体は首チンコを射精させながら、仰向けに倒れる。この時、オマンコも潮を吹いている。\n7ぺーじ:花とみやこはこの姿がえろく思えて、花はオマンコ、みやこはディルドを攻める。\n花はみやこのオマンコに正常位で突っ込み中出しする。みやこはディルドを垂直に立て騎乗位で挿入し、中出しされる。\n1ページで収まらない場合、内容を分割してページ数を増やしても構いません。\nセリフもつけて頂けるとありがたいです（無しでもOK）。修正は黒海苔希望です。よろしくお願いします。", "nc": 43, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@shotaunk/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "comic", "tipped": false, "creator_id": 507009, "client_id": 2370346, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/19b4e35d/uploads/origins/3fd2c363-06bd-4acb-a3c2-ca6f2225a075?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=39348504329057ef1be2f8c670f77dbb", "srcset": "https://si.imgix.net/19b4e35d/uploads/origins/3fd2c363-06bd-4acb-a3c2-ca6f2225a075?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=39348504329057ef1be2f8c670f77dbb, https://si.imgix.net/19b4e35d/uploads/origins/3fd2c363-06bd-4acb-a3c2-ca6f2225a075?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=360cad7ef1b2c89a1f940fd9b63741cf 2x, https://si.imgix.net/19b4e35d/uploads/origins/3fd2c363-06bd-4acb-a3c2-ca6f2225a075?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e2443140de2649cbdb254ac3dc622804 3x"}, "duration": null, "nsfw": true, "hardcore": true, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/19b4e35d/uploads/origins/3fd2c363-06bd-4acb-a3c2-ca6f2225a075?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0005bd7f507ab2167d0764ad98de2f83", "srcset": "https://si.imgix.net/19b4e35d/uploads/origins/3fd2c363-06bd-4acb-a3c2-ca6f2225a075?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0005bd7f507ab2167d0764ad98de2f83, https://si.imgix.net/19b4e35d/uploads/origins/3fd2c363-06bd-4acb-a3c2-ca6f2225a075?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=e4ca2dc69e7fb8c3318ec990aa278d2e 2x, https://si.imgix.net/19b4e35d/uploads/origins/3fd2c363-06bd-4acb-a3c2-ca6f2225a075?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=3ca5d339c59dd2b6f07bfd716815d4ea 3x"}, "body": "こんにちは！首の挿げ替えのコミックを描いていただければと思います。\n内容：ご注文はうさぎですか？のチノは裏の通販サイトで買った挿げ替え装置で首から下を男の身体に挿げ替え、ココアとリゼの3Pで中出しセックスする。翌日、ココアとリゼも同じサイトで購入した身体に挿げ替え、朝までセックスを楽しむ。\n設定について︰\n・挿げ替え装置と首から下の身体を購入出来る○maz○nみたいな通販サイトが、チノ達が通う学校で密かに流行っている。チノ以外は皆購入して、エッチを楽しんでいるので、チノも楽しみたく利用する。\n・挿げ替え装置は黒い首輪で、挿げ替え用の身体はガラス張りのケースに保存されており、首元に白い首輪の下半分が装着している。黒い首輪を付け中央のボタンを押すと、首が分離する。首はドローンのように自動で動いて、白い首輪にくっつき挿げ替える。元の身体は挿げ替え後、自動で仰向けの体勢になり、脱力する。\n・挿げ替える首から下の身体は以下の通り。\nチノ︰50代のおっさんの身体。身長は180cmで体重120kg。ビール腹で毛深く肌色が濃い。チンコは30cmもある巨根で玉もソフトボール大の大きさ。絶倫で10回セックスしても収まらない程。\nココア︰40代後半の人妻熟女。身長は160cm。胸はKカップの爆乳で、母乳はまだ出る。お腹はたるんでおり、足はむっちりとしたおばさん体型。3人の子供を産んでいるが、まだ子供を作れる。\nリゼ︰9歳の女子小学生。身長100cm未満のロリ。成長が遅めのツルペタロリの処女だが、初潮を迎えている。\n各ページについては以下の通りでお願いします。\n1ページ︰チノはサイトで首輪とおっさんの身体を購入し、自分の部屋で挿げ替える。首輪をつけるところから、ボタンを押して首がおっさんの首元でくっつき、元の身体が仰向けになるところまで描いて欲しいです。挿げ替え後の姿は全身絵でお願いします。\n2ページ︰おっさんの身体に挿げ替えたチノは手や足を動かして具合を確認するが、途中ムラムラし始め、チンコが勃起する。チノは息を荒くしながらガニ股で座り、ココアとリゼをオカズに手コキオナニーして初射精する。ページの最後にイキ顔で賢者モードのチノを描いてください。\n3ページ︰チノはココアとリゼに今日ラビットハウスで泊まらないかと連絡する。2人はチノの部屋に来るとチノは3回目の射精をして、部屋は精液でベタベタの状態。2人に気づいたチノは恥ずかしそうに勃起チンポを手で隠し取り繕うが、ココアとリゼは気にせず左右から手コキとフェラで責められ射精する。その後朝まで中出しセックスをする。\n4ページ︰夜も深まり、3人はセックスし始める。まず、ココア×チノで騎乗位でチノがココアの腰を掴んで激しく上下セックス、その後、リゼ×チノで力強く腰を打ち付け正常位セックスする。表情がわかるような視点でお願いします。チノはオマンコから溢れるくらいたっぷりと中出しするも、まだまだチンポが固いため、朝までセックスの続きを楽しむ。受精する描写をつけてください。\n5ページ︰後日、ココアとリゼは元の身体が妊娠したからと首から下の身体を挿げ替え、またチノの部屋で3Pで中出し孕ませセックスを楽しむ。最後、チノはココアとリゼを両腕で引き寄せ、抱きしめキスする。この時のセックスシーンの体位はお任せします。\n1ページで収まらない場合、内容を分割してページ数を増やしても構いません。\nセリフもつけて頂けるとありがたいです（無しでもOK）。修正は黒海苔希望です。よろしくお願いします。", "nc": 58, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@shotaunk/works/6", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/52fbc7fb/uploads/origins/d50c687a-c516-4cb5-9581-2df755c736db?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=7c5d0101db5c1df81b680de6ed35c890", "srcset": "https://si.imgix.net/52fbc7fb/uploads/origins/d50c687a-c516-4cb5-9581-2df755c736db?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=7c5d0101db5c1df81b680de6ed35c890, https://si.imgix.net/52fbc7fb/uploads/origins/d50c687a-c516-4cb5-9581-2df755c736db?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=5c22497ad47682d70c73cb5eba182929 2x, https://si.imgix.net/52fbc7fb/uploads/origins/d50c687a-c516-4cb5-9581-2df755c736db?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=10e4d8ead62bb5ef9072c4390fee22c6 3x"}, "private": true, "genre": "comic", "tipped": true, "creator_id": 507009, "nc": 50}, {"path": "/@shotaunk/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "comic", "tipped": false, "creator_id": 507009, "client_id": 2370346, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/2847709d/uploads/origins/4d1b6798-1a56-4ec8-8c6b-5a7fa9f3f886?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=10a9facc2a4597062a1deeece890825f", "srcset": "https://si.imgix.net/2847709d/uploads/origins/4d1b6798-1a56-4ec8-8c6b-5a7fa9f3f886?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=10a9facc2a4597062a1deeece890825f, https://si.imgix.net/2847709d/uploads/origins/4d1b6798-1a56-4ec8-8c6b-5a7fa9f3f886?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=7f094442905ef4de6368e447999b7518 2x, https://si.imgix.net/2847709d/uploads/origins/4d1b6798-1a56-4ec8-8c6b-5a7fa9f3f886?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c428580c64b41562b3038143d9001998 3x"}, "duration": null, "nsfw": true, "hardcore": true, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/2847709d/uploads/origins/4d1b6798-1a56-4ec8-8c6b-5a7fa9f3f886?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5748ff2c425738dbecf87f5209ffa3fb", "srcset": "https://si.imgix.net/2847709d/uploads/origins/4d1b6798-1a56-4ec8-8c6b-5a7fa9f3f886?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5748ff2c425738dbecf87f5209ffa3fb, https://si.imgix.net/2847709d/uploads/origins/4d1b6798-1a56-4ec8-8c6b-5a7fa9f3f886?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=1329482af67a6cde62050cab8fd4704a 2x, https://si.imgix.net/2847709d/uploads/origins/4d1b6798-1a56-4ec8-8c6b-5a7fa9f3f886?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=fa77ef88fcb85ce55cde68c0183e3433 3x"}, "body": "こんにちは！おっさんの身体に挿げ替える首の挿げ替えのコミックをお願いします。\n内容：原神のナヒーダが森の中で首から下を中年男の身体に挿げ替えて、手コキオナニーをして射精する。それをニィロウに目撃される。ナヒーダはニィロウとパイズリ射精と中出しセックスをする。その後ナヒーダはニィロウを元自分の体と挿げ替え、手コキと中出しセックスする。\n挿げ替える男の身体は、40代後半で身長170cmほど、体重150kgぐらいで太り気味。チンポは長さ30cmの巨根、玉も大きく絶倫。1回に100mlの精液を射精して、10回以上セックスできる体力がある。\nこの身体はナヒーダが作ったもので、他にも首から下の体があり、人のいないところで挿げ替えて遊んでるという設定です。\n細かな流れは以下の通り。\n①ナヒーダが自分の首を挿げ替えるシーン。\nナヒーダは直立している首なし男ボディ（首なしでも生きており、我慢汁を流しながら勃起してる、首断面に草元素のマークが書いてある）を持ってくる。\nナヒーダはボディの玉袋を握ると、ボディは少しびくっと反応する。次にナヒーダは自分の首元で円状になぞる。すると、首元が光りナヒーダが頭を持ち上げると首が外れる。ナヒーダの首なしボディにも草元素マークが描いてある。首なしでも生きており、興奮して愛液が垂れている。\n②ナヒーダは自分の頭を男ボディの首元に持っていき、押さえながら置く。すると首元の光が消えて完全に癒着する。ナヒーダはくっついた男ボディの手足を動かして、成功を確認。ナヒーダはガニ股になり、勃起したチンコを手コキし始めて、大量の精液を射精し賢者モードとなる。\n③その一部始終を見ていたニィロウに気づいたナヒーダ。ナヒーダは驚き取り繕うとしたが、ニィロウはナヒーダが好きと告白しナヒーダのチンポをおっぱいで挟む。そのままパイズリをしてナヒーダはニィロウに顔射する。ニィロウは自分の顔に着いた精液を舐めてナヒーダとキスする。\n④2人はダブルベッドに行き正常位でセックスする。ナヒーダはニィロウのおっぱいを揉みながら腰を突き、ボテ腹になるほど射精する。⑤ナヒーダはニィロウの首元をなぞりニィロウの首を外す。そして元自分の体にニィロウの首をくっつける。そして2回戦がはじまり、今度は騎乗位でニィロウがピストン運動する。ナヒーダは締め付けが気持ちよすぎて、再度ボテ腹になるほどになるほど中だし射精する。\n最後にニィロウはナヒーダと抱き合ってキスをする。\n流れとしてはこんな感じてお願いします。\n細かな点としては、\n・修正は黒海苔でお願いします。\n・中出し後は受精した描写も欲しいです。\n・差分で膣の断面が分かるようにお願いします。余裕があったらでいいのですが、着衣verの差分も欲しいです。\nよろしくお願いします。", "nc": 187, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@shotaunk/works/4", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/6f377f3e/uploads/origins/80448eeb-093b-4f99-906c-14d779c80e92?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=42a44f0e45e7d0cffb1df898f5ee0c9d", "srcset": "https://si.imgix.net/6f377f3e/uploads/origins/80448eeb-093b-4f99-906c-14d779c80e92?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=42a44f0e45e7d0cffb1df898f5ee0c9d, https://si.imgix.net/6f377f3e/uploads/origins/80448eeb-093b-4f99-906c-14d779c80e92?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=c150e7d0b641cfd20ae7007bfc5e9c2f 2x, https://si.imgix.net/6f377f3e/uploads/origins/80448eeb-093b-4f99-906c-14d779c80e92?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=e4f343dce82c4f878010fe5438c07149 3x"}, "private": true, "genre": "comic", "tipped": true, "creator_id": 507009, "nc": 34}, {"path": "/@shotaunk/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 507009, "client_id": 1853984, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/56803961/uploads/origins/cce321fb-9538-4be2-a2af-436c742c6f83?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3b3c66c95dbc998cf5acb79c5d0c7986", "srcset": "https://si.imgix.net/56803961/uploads/origins/cce321fb-9538-4be2-a2af-436c742c6f83?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3b3c66c95dbc998cf5acb79c5d0c7986, https://si.imgix.net/56803961/uploads/origins/cce321fb-9538-4be2-a2af-436c742c6f83?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a4d3250d336d35005c0bfdf3952c3c7d 2x, https://si.imgix.net/56803961/uploads/origins/cce321fb-9538-4be2-a2af-436c742c6f83?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=9d4a5da565dab36d2f396757fc67487a 3x"}, "duration": null, "nsfw": true, "hardcore": true, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/56803961/uploads/origins/cce321fb-9538-4be2-a2af-436c742c6f83?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=1edac0172fb4048e425dc84e067c275c", "srcset": "https://si.imgix.net/56803961/uploads/origins/cce321fb-9538-4be2-a2af-436c742c6f83?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=1edac0172fb4048e425dc84e067c275c, https://si.imgix.net/56803961/uploads/origins/cce321fb-9538-4be2-a2af-436c742c6f83?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=ff5e66914aba11d2081bb21f8fb12f9b 2x, https://si.imgix.net/56803961/uploads/origins/cce321