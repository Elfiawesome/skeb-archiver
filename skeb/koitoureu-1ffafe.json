true}, "master_card": {"nsfw": true}, "visa": {"nsfw": true}, "discover": {"nsfw": true}, "american_express": {"nsfw": true}}}, "acceptable_only_public": false, "tip_acceptable": true, "yearly_report_client_visible": false, "total_appeals_count": 0, "received_works": [{"path": "/@koitoureu/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3464838, "client_id": 1281227, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/83989a52/uploads/origins/a750fa0b-cd19-49af-85c1-c3f59801b3fc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c0d3932fcd7ea0ede2b2647d6bcaf7ae", "srcset": "https://si.imgix.net/83989a52/uploads/origins/a750fa0b-cd19-49af-85c1-c3f59801b3fc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c0d3932fcd7ea0ede2b2647d6bcaf7ae, https://si.imgix.net/83989a52/uploads/origins/a750fa0b-cd19-49af-85c1-c3f59801b3fc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=caf677704993d6ab07d91eedc6bc0c3a 2x, https://si.imgix.net/83989a52/uploads/origins/a750fa0b-cd19-49af-85c1-c3f59801b3fc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=92763c2f82a9382eed53245a0c290459 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/83989a52/uploads/origins/a750fa0b-cd19-49af-85c1-c3f59801b3fc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3fbd28592ec924bcc289beb567439ab4", "srcset": "https://si.imgix.net/83989a52/uploads/origins/a750fa0b-cd19-49af-85c1-c3f59801b3fc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3fbd28592ec924bcc289beb567439ab4, https://si.imgix.net/83989a52/uploads/origins/a750fa0b-cd19-49af-85c1-c3f59801b3fc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=097c0fa298782d63e156f2ddf193061b 2x, https://si.imgix.net/83989a52/uploads/origins/a750fa0b-cd19-49af-85c1-c3f59801b3fc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=cf848b0c5cd4503c34416ad718f112e4 3x"}, "body": "ご機嫌よう、うれう様！スケブ再開心待ちにしておりました！\n今回は、私の自作小説にある物語そのものを、登場する二人のOCを使って絵に起こして頂けないでしょうか？\n二人は「カロン」という少女と「ニーベル」という女性です。詳細は資料をご覧ください。\n\n物語の詳細も資料に。簡潔には以下。\n・友好的だった精霊たちが突如敵対した世界。精霊は人の歌・音楽に反応して霧から現れ、無差別に人を襲います。このため歌が禁忌となります。\n・精霊の反乱に家族と家を奪われ、心と声を失った魔法使いの少女がいました。少女をニーベルという元歌手の女性が拾います。彼女も家族を失っていました。\n・ニーベルは少女にカロンという名と仕事を与えます。ニーベルは幼いカロンにも厳しい人でしたが、二人はいつも共にいました。\n・あるとき町で権力争いが起き、二人も傭兵たちに襲われます。ニーベルは音楽で精霊を怒らせ、傭兵たちを襲わせました。ニーベルは精霊を引きつけ、カロンだけ逃がそうとしましたが、カロンが逃げないので、二人で最後の歌を歌うことにしました。\n・精霊が迫ったとき、ニーベルだけが歌をやめ、カロンを庇って息絶えます。カロンは引きかえに声と心を取り戻しました。その心は歌う喜びと衝動に満ちていました。\n\nこの物語の特に終盤のカロンについて、心象風景のようなイラストを希望します。お好きなだけ抽象的な表現を。しかしイメージに土台が必要なら、「傷B(資料参照)から血を流しながら歌うカロンと、それを抱くニーベルの亡骸」としてください。念のため精霊の情報も資料に入れています。\n\nこの物語と登場人物は自作小説「なじか嗄れなきロウレイライ」の一部です（確認用：https://xfolio.jp/portfolio/yodom_bee/free/358162※第二幕に該当）。ご納品頂けたものですが、原作関連アートと呼べる範囲での使用をお許し願いたいです（掲載の他サムネイル化、宣材内利用含む）。常に他作として作者明記、非商用、リワードオフの条件下で。なお掲載時には転載・第三者利用防止を兼ねた低解像度化や自前のウォーターマーク、ノイズの追加をさせて頂くことがあります。X、META社系列SNSへの投稿は致しません（現在同名義なし）。さしあたりご自分のサインを入れて頂けると助かります。\n\nご都合に適いましたら幸いです。よろしくお願い致します。\n\nhttps://ln5.sync.com/dl/28dadf990#xd7mr74s-37eetmem-n53n9aej-za637cms", "nc": 24, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@koitoureu/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3464838, "client_id": 3848283, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/26254bbf/uploads/origins/8de5e1ec-924d-4aa2-a372-f0e55ebef721?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=888b040bc6b9ca956abd95d7517c4cb3", "srcset": "https://si.imgix.net/26254bbf/uploads/origins/8de5e1ec-924d-4aa2-a372-f0e55ebef721?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=888b040bc6b9ca956abd95d7517c4cb3, https://si.imgix.net/26254bbf/uploads/origins/8de5e1ec-924d-4aa2-a372-f0e55ebef721?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e196ad53d1ddbc5f02e255e9ec7ac196 2x, https://si.imgix.net/26254bbf/uploads/origins/8de5e1ec-924d-4aa2-a372-f0e55ebef721?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=45c8783fcadbf311c9100028aca98dbb 3x"}, "duration": null, "nsfw": true, "hardcore": true, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/26254bbf/uploads/origins/8de5e1ec-924d-4aa2-a372-f0e55ebef721?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ff55b925e89d70d72eb2ee9d6cbd2ecf", "srcset": "https://si.imgix.net/26254bbf/uploads/origins/8de5e1ec-924d-4aa2-a372-f0e55ebef721?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ff55b925e89d70d72eb2ee9d6cbd2ecf, https://si.imgix.net/26254bbf/uploads/origins/8de5e1ec-924d-4aa2-a372-f0e55ebef721?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=bdc4ae64109fe487d5a43b7b03dbe110 2x, https://si.imgix.net/26254bbf/uploads/origins/8de5e1ec-924d-4aa2-a372-f0e55ebef721?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=599bdf1f0594decf74acb3913097f0bf 3x"}, "body": "今年も一年お疲れ様です、リクエスト失礼します。私のオリジナルキャラクターの、荒海と静原を書いていただきたいです。二人は人間に擬態する生命体で、人間から双子として生まれてきています。長い白髪をみつあみにしていて、荒海が二本、静原が一本です。静原は幼いころより父親に虐待をうけていて、精神が崩壊してしまいました。荒海はそんな静原を支え、逃亡してふたりで静かに暮らしています。荒海は男性ですが、女装しているのは身体を売って生活しているため、そのほうが価値がもたらされるからです。荒海はしゃべることもなくなった静原を大切に思い、また静原が荒海の心の支えでもあります。二人の名前は偽名です。\n\n使用用途に関しては、個人的にパソコンのデスクトップにしたいので横構図だとありがたいです。\n\n参考資料として以下にドロップボックスをはりました。\nhttps://www.dropbox.com/scl/fo/r2x1py2a7vt2e6shy0tmb/AAhoUlQG7JmcofMH_5doBUU?rlkey=n0dwa51mank1yutc44qvanevh&st=6d9lr8or&dl=0", "nc": 171, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@koitoureu/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3464838, "client_id": 1281227, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/960b4e54/uploads/origins/57f1e8c3-5da0-489f-b2a3-0361ea29a540?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8f7b15ad8e4a49bf5d086992bbfad691", "srcset": "https://si.imgix.net/960b4e54/uploads/origins/57f1e8c3-5da0-489f-b2a3-0361ea29a540?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8f7b15ad8e4a49bf5d086992bbfad691, https://si.imgix.net/960b4e54/uploads/origins/57f1e8c3-5da0-489f-b2a3-0361ea29a540?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e57a1a04b968ababa46277639e1f3400 2x, https://si.imgix.net/960b4e54/uploads/origins/57f1e8c3-5da0-489f-b2a3-0361ea29a540?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=5a58ac4386b3f23cf7898471fec7ae1f 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/960b4e54/uploads/origins/57f1e8c3-5da0-489f-b2a3-0361ea29a540?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=df9190c134bd8f46d066a68f80017d4a", "srcset": "https://si.imgix.net/960b4e54/uploads/origins/57f1e8c3-5da0-489f-b2a3-0361ea29a540?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=df9190c134bd8f46d066a68f80017d4a, https://si.imgix.net/960b4e54/uploads/origins/57f1e8c3-5da0-489f-b2a3-0361ea29a540?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=df89fda6806a605bfd8089b059898a86 2x, https://si.imgix.net/960b4e54/uploads/origins/57f1e8c3-5da0-489f-b2a3-0361ea29a540?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=2cad9edd1e0d15f00e43626e719515b5 3x"}, "body": "スケブでは初めまして。愛らしさと容赦ないダークが同居する貴方の世界観が突き刺さった者です。リクエストの機を得てワクワクしています！\nうちのOCの一人をテーマとして使って頂くことはできますか？\n外見は資料をご覧下さい。衣装や些末なデザイン改変はご自由に。\nそして不躾でないとよいのですが、下記のプロフィールを読んだ上でお好きなようにイメージを描いて頂けないかと思います。手加減不要。どうなるかにとても興味があります。\n\n※彼女は制作中の自作小説の登場者です。OCとしての紹介時と登場作品の紐づく範囲（作品ページやサムネイル、宣材等）での掲載をお許し頂ければと思います。常に非商用・非再配布・作者名併記。掲載時に部外者の二次利用防止措置を施す事もあります。差し当たりサインを入れて頂けると幸いです。\n\nOCのプロフィール\n・名はエイレイシア。或いはロア。\n・呪詛師らの造った最初で唯一の人造の吸血鬼。魂のない存在。齢8程だが知能は高い。\n・古典吸血鬼の特徴は持たず、契約した人間(眷属)の循環器と自身の消化器が概念上直結して血と寿命を得る。眷属は不死となり、思考が彼女や他の眷属と共有される。眷属らは教団も組織している。\n・己の血を自在に操り、硬質化させた“鎖”を体から無尽蔵に生やせる。鎖は怪力の触手であり、翼の形に束ねて飛行もできる。力を使うとき左目が赤くなる。体は人間と同じ強度。\n・造られた当初の姿は「血の詰まった皮袋」。その頃の名がロア。自我はなく、夜な夜な妊婦を襲い胎児を喰らう獣だった。とある狂信的な眷属が自身の娘を「胎児なき妊婦」に仕立てて差し出した際、その娘に“子”として受容された事で自我と人の形を得る。\n・現在は長身の女性の姿をした別の化け物「脳喰らい」の養女として、共に世俗に紛れ暮らしている。捕食した生物に成り代われる脳喰らいに瀕死だった娘を喰わせ、“母”の代わりを演じさせている。脳喰らいの演技はオーバーで不自然だが、ロアは依存している。\n・“母”以外に関心はなく、特に人間と教団は嫌いで壊しても平気（無闇に攻撃はしない）。\n・非常に無口。これは声を発すると眷属に居場所を特定されるため（教団は連れ戻したい。彼女は平穏に暮らしたい）。但し元々冷淡・高慢で口下手。\n・常に仏頂面だが、静寂は好まず、賑やかさに惹かれる。\n・味覚がなく食事しない。\n\n以上、ご検討頂ければ幸いです。\n\nhttps://drive.google.com/drive/folders/1B9nbaIEJFyJ9jLqxfRaPAk6t6hYlL-ue?usp=sharing", "nc": 136, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@koitoureu/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3464838, "client_id": 2846401, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/e5befd84/uploads/origins/06a61558-2ae2-4c29-90e5-2e3bc1392e34?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=827f426fe1648d0d3cfc677a1afc1821", "srcset": "https://si.imgix.net/e5befd84/uploads/origins/06a61558-2ae2-4c29-90e5-2e3bc1392e34?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=827f426fe1648d0d3cfc677a1afc1821, https://si.imgix.net/e5befd84/uploads/origins/06a61558-2ae2-4c29-90e5-2e3bc1392e34?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=5c5b0f9cd2c414d9a5c460ccc96c2638 2x, https://si.imgix.net/e5befd84/uploads/origins/06a61558-2ae2-4c29-90e5-2e3bc1392e34?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop