fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=bb916e11a873a17e6813a5e6b7eab4e2, https://si.imgix.net/6f199bfe/uploads/origins/842fa4fc-5e93-4ebd-ab29-c1ca892dfae1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=33815883054423e9f435876db47b2459 2x, https://si.imgix.net/6f199bfe/uploads/origins/842fa4fc-5e93-4ebd-ab29-c1ca892dfae1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=e43a1d8661aa742214ac1dd28673ed14 3x"}, "body": "もぐー様\nいつも大変可愛らしいイラストを拝見しております。（以前はありがとうございました🌸）\nぜひまた友人とのOCをお願いしたく、リクエストさせて頂きました。\n動物に関しましては、ふんわりとしか思いつきませんでしたので、もぐー様の直感にお任せできればと存じます…！\n\n▍キャラクター\n・大神 嵐：（28歳／男性／166㎝）\n　犬っぽい…？\n  \n・未咲 このえ：（27歳／女性／180㎝）\n　うさぎっぽい…？\n\n▍使用用途\n・アイコン(SNSやココフォリアなど)\n・個人観賞用の非営利目的のグッズ制作\n・お相手様との共有\n\n金額や条件など合いませんでしたら再送請求頂ければと思います。\nご多忙の中大変恐縮ではございますが、宜しければご一考頂ければ幸いです。\nどうぞよろしくお願い致します。\n\nhttps://www.notion.so/36143082cb6e809c92ece50894264c36?source=copy_link", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@moguuuu_sub/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3913806, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/cd169fe2/uploads/origins/597bbc8b-78df-4fe6-b4e0-9b1c189cd5ae?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5da5b3accd2b3d38646d8d8993c04a50", "srcset": "https://si.imgix.net/cd169fe2/uploads/origins/597bbc8b-78df-4fe6-b4e0-9b1c189cd5ae?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5da5b3accd2b3d38646d8d8993c04a50, https://si.imgix.net/cd169fe2/uploads/origins/597bbc8b-78df-4fe6-b4e0-9b1c189cd5ae?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b99f8c61009bac6e191b70b8e11ba7e2 2x, https://si.imgix.net/cd169fe2/uploads/origins/597bbc8b-78df-4fe6-b4e0-9b1c189cd5ae?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=412afbc45f28467f1a9f3bd488354b14 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/cd169fe2/uploads/origins/597bbc8b-78df-4fe6-b4e0-9b1c189cd5ae?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ca2f7bef4f6b48abe4736eeb1e802035", "srcset": "https://si.imgix.net/cd169fe2/uploads/origins/597bbc8b-78df-4fe6-b4e0-9b1c189cd5ae?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ca2f7bef4f6b48abe4736eeb1e802035, https://si.imgix.net/cd169fe2/uploads/origins/597bbc8b-78df-4fe6-b4e0-9b1c189cd5ae?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=63feda438d33884059310d64f33e52c3 2x, https://si.imgix.net/cd169fe2/uploads/origins/597bbc8b-78df-4fe6-b4e0-9b1c189cd5ae?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=ddf969caddd500a6ac105fdab93a9887 3x"}, "body": "はじめまして。新着にてイラストを拝見し、リクエストを送らせて頂きました。\n差し支えなければ、資料内OCの動物化イラストを描いていただきたいです。\n\n┈┈┈┈┈┈┈┈┈┈\n・🍓\n女性、151cm、18歳\n天才役者。天然で不思議ちゃん。我が強くて空気が読めないところがあり甘えたがりなため、他の劇団員にお世話をされっぱなし。\nいちごミルクの飴が好きでよく食べている。\n幼少期はバレエを習っていたが、現在は役者活動に専念するためバレエからは距離を取っている。\n\n┈┈┈┈┈┈┈┈┈┈\n\nなんの動物にするかはもぐーさんにお任せしたいです。資料に入っている服装はどちらを着せて頂いても構いません。お好きな方、描きやすい方をお願いします。\n\nまた、金額や資料に不備不足がありましたら、気兼ねなく再送又はキャンセルなどしてください。\nご検討いただけましたら幸いです。よろしくお願い致します🌸\n\nhttps://drive.google.com/drive/folders/1oSZqNezU-Zl_deAcsSN3084eWv776VW8", "nc": 136, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@moguuuu_sub/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3913806, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/bc3a5d74/uploads/origins/3e313327-6981-4d9b-afcf-d5e914c9c554?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c0123b2c023e5fc318e958052eb83929", "srcset": "https://si.imgix.net/bc3a5d74/uploads/origins/3e313327-6981-4d9b-afcf-d5e914c9c554?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c0123b2c023e5fc318e958052eb83929, https://si.imgix.net/bc3a5d74/uploads/origins/3e313327-6981-4d9b-afcf-d5e914c9c554?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f21848175ec68b626dbdbc01dbd22f16 2x, https://si.imgix.net/bc3a5d74/uploads/origins/3e313327-6981-4d9b-afcf-d5e914c9c554?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=04fe7cb36b9399f08611c4ef616e0294 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/bc3a5d74/uploads/origins/3e313327-6981-4d9b-afcf-d5e914c9c554?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=29e06fa48e9617f3bdd2f41a0f8403ca", "srcset": "https://si.imgix.net/bc3a5d74/uploads/origins/3e313327-6981-4d9b-afcf-d5e914c9c554?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=29e06fa48e9617f3bdd2f41a0f8403ca, https://si.imgix.net/bc3a5d74/uploads/origins/3e313327-6981-4d9b-afcf-d5e914c9c554?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=2c1f773d731300113d1ba32a843b08f2 2x, https://si.imgix.net/bc3a5d74/uploads/origins/3e313327-6981-4d9b-afcf-d5e914c9c554?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=56d1284b73eb2bdd5e017deb66c7ad53 3x"}, "body": "可愛い動物化のイラストが大好きです、リクエスト失礼いたします。\n\n「動物化イラスト」をお願いしたいです。\nキャラクターは2人分で、それぞれ資料A・資料Bをご参照ください。\nAに関しては帽子も被せてくれたら嬉しいです（難しい場合は大丈夫です）\n\n動物化のデザインについては、添付している「ぬいぐるみ資料」のようなテイストにしていただけると嬉しいです。その上で、資料A・Bそれぞれの服装を着せていただけたら嬉しいです。\n\nお任せする部分も多くなってしまいますが、ご都合よろしければぜひお願いできますと幸いです。\nよろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/1yhJKg0VaBs4Bwf2SOkKYGSpEqRb7Ej6i?usp=drive_link", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@moguuuu_sub/works/3", "private_thumbnail_image_u