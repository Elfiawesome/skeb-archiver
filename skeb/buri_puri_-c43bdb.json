s://imgur.com/a/PheV66I\n\nこちらはヤトラ、ネズミの女の子です。彼女も褐色の肌をしていますが、もっと薄くなっています。黒いセーラー服を着た彼女を描いてください。真っ赤なスカーフをしています。ハート型の髪留めをしていて、顔にはひげが生えています。\n参考資料// https://imgur.com/a/TlUuPPC\n\nこのように、少し手を繋いで、少し慌てたようにお互いを見ているようなポーズをお願いします。https://i.imgur.com/GyDnx0q.png\n\nありがとうございました。", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@buri_puri_/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 324517, "client_id": 1066282, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/9a2869fe/requests/265313_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4926ab8cdb74459ed5d0eb77bed96e8a", "srcset": "https://si.imgix.net/9a2869fe/requests/265313_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4926ab8cdb74459ed5d0eb77bed96e8a, https://si.imgix.net/9a2869fe/requests/265313_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=869f5b74efd606e86d6c03cd835bce6e 2x, https://si.imgix.net/9a2869fe/requests/265313_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ca50e7dc4c1773a720387a73c56855dd 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/9a2869fe/requests/265313_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9f5cae5c932885289959bfdd2cd7909d", "srcset": "https://si.imgix.net/9a2869fe/requests/265313_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9f5cae5c932885289959bfdd2cd7909d, https://si.imgix.net/9a2869fe/requests/265313_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=73167dbe162f425a8f176861a76fde69 2x, https://si.imgix.net/9a2869fe/requests/265313_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=620722ed50acf5e811d0161bf4f3