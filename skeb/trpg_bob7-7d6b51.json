=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=3ff76fc4fe10c0da1a3901b270bb08fc 2x, https://si.imgix.net/e9d916ae/uploads/origins/7f60de12-8d65-47b7-8d2e-86cf8a0b7b09?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=82e882deefa7bb358efbeaa9963b8409 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/e9d916ae/uploads/origins/7f60de12-8d65-47b7-8d2e-86cf8a0b7b09?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=79f3f3ff2abf24aa8c63783960eea0e4", "srcset": "https://si.imgix.net/e9d916ae/uploads/origins/7f60de12-8d65-47b7-8d2e-86cf8a0b7b09?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=79f3f3ff2abf24aa8c63783960eea0e4, https://si.imgix.net/e9d916ae/uploads/origins/7f60de12-8d65-47b7-8d2e-86cf8a0b7b09?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=b48533b5491b3b8b865161e0cf870464 2x, https://si.imgix.net/e9d916ae/uploads/origins/7f60de12-8d65-47b7-8d2e-86cf8a0b7b09?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=7a2f1b57b6ab07c4bbc4ab3eb849970a 3x"}, "body": "こんにちは！普段からいいよさんのイラストや立ち絵が好きでよく拝見しています。\n色使いや雰囲気がとっても素敵で、ぜひいいよさんに依頼させていただきたく…！\n\nもしよろしければ、添付した資料にあります二人組を描いていただけないでしょうか。CoC「片鱗」を通過し、高校生生還、殺人鬼ロストで死別しました。おとぎ話をモチーフにしたふたりです。\n高校生は女装男子で性別は両方男性です。\n\n高校生の恵良戸 玻璃(えらと-はり)は自分を可愛く着飾るのが大好きでプライドの高い小生意気な性格です。性自認は男で口調も男らしいです。シンデレラをモチーフにしたキャラクターですが、現実主義で非常に芯が強いです。\n\n殺人鬼の折 獄(せつ-ひとや)は非常に大柄で玻璃とは30cm以上身長差があります。悠々自適な性格でおっとりとした話し方をします。玻璃をまるでお姫様のように扱います。キャラクターモチーフは鶴の恩返しです。\n\n低温度、高湿度な雰囲気で雨が降り続ける中、おとぎ話の姫と王子のような会話を繰り広げるような関係性の二人になります。\nキャラデザイン細部の簡略化していただいて大丈夫です！できれば一枚絵風の構図でお願いしたいです。\n\n以上の内容でもしよろしければ、ぜひよろしくお願いいたします！\n\nhttps://drive.google.com/drive/folders/1-4VlFW9sk9huHxMkI6SWwPj3vY-caGTc", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@OlO_xlI/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1429556, "client_id": 1835984, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/21e7289c/uploads/origins/3119dea8-7e0a-4987-a1ac-5e719c57f6b5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=012e86b7bb48967f20f897007449938f", "srcset": "https://si.imgix.net/21e7289c/uploads/origins/3119dea8-7e0a-4987-a1ac-5e719c57f6b5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=012e86b7bb48967f20f897007449938f, https://si.imgix.net/21e7289c/uploads/origins/3119dea8-7e0a-4987-a1ac-5e719c57f6b5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e64fdcd7c3d68dcbf544b641e0846a26 2x, https://si.imgix.net/21e7289c/uploads/origins/3119dea8-7e0a-4987-a1ac-5e719c57f6b5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d1e81af6dee1ffb79f237b7eef446770 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/21e7289c/uploads/origins/3119dea8-7e0a-4987-a1ac-5e719c57f6b5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0b7fe3f442fec19a225b49bf97a0e96c", "srcset": "https://si.imgix.net/21e7289c/uploads/origins/3119dea8-7e0a-4987-a1ac-5e719c57f6b5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0b7fe3f442fec19a225b49bf97a0e96c, https://si.imgix.net/21e7289c/uploads/origins/3119dea8-7e0a-4987-a1ac-5e719c57f6b5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=4cdf7262818346874b7beedd5af1c3c1 2x, https://si.imgix.net/21e7289c/uploads/origins/3119dea8-7e0a-4987-a1ac-5e719c57f6b5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=a1ebc2f71488b826f6b631a1f1cc1292 3x"}, "body": "こんにちは！りんねさんのシナリオやイラスト、普段のツイートなどすべて大好きで楽しく拝見しています。特にシナリオは文体や映画のような雰囲気、イラストは色使いやまとめかたが好きです。\n\nそんなりんねさんに、この度はイラストのリクエストをさせていただきたいです。もしよろしければ、添付した資料の二人を描いていただけないでしょうか。\n\nCoCの「ようこそ！迷冥市役所都市伝説課へ！」というシナリオを通過したPCたちで、咏(よみ)が先輩で女、鈕(こはぜ)が後輩で男になります。\n咏はクールでお高く止まっている意地悪な性格ですが、私生活ではゴミ捨てが苦手だったり、面倒臭がりが転じてか受け身な一面もある先輩です。\n鈕は仕事に真面目ではあるものの実際はポンコツな有能ぶっている後輩で、人懐こく子供っぽい、でも冷静で現実主義な一面もある後輩です。\n関係性としては咏が意地悪をしても鈕にはあまり効かず、逆に咏が鈕のテンポに巻き込まれている、といった感じです。\n\n服装や細かい部分の簡略化などもしていただいて大丈夫です。構図やシチュエーションなどもりんねさんにお任せします！\n\n以上の内容でもしよろしければ、ぜひよろしくお願いします！\n\nhttps://drive.google.com/drive/folders/1Wp34dYHeKdSwhQZiupIhaTtfFKaOvGnm", "nc": 177, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}], "similar_creators": []}, "price_history": {"art": [{"amount": 6000, "recorded_at": "2026-03-20T17:26:46.929317+00:00"}]}}