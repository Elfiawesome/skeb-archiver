て。Xでイラストを拝見し、絵のタッチがとても好みだったのでお伺いさせて頂きました！\n\n もしよろしければリクエストを検討していただければと思います。\n\n  以下リクエスト内容 \n創作キャラクターをお願いします \n・匿名くんという名前のキャラクターです \n・正義感がとても強く自分の正義に反するものは徹底して罰を与えようとする性格です。 ・ルドベキアの花が好きです。\n・イメージカラーは赤色なので使用して頂けるとありがたいです。\n\nホテルマンとして働いているため誠実そうな表情、口元は微笑んでいる感じを出していただくようなものだと嬉しいです。\nまた、服装は資料そのままでお願いいたします。\n\nその他の描写は全てお任せ致します。\n\nhttps://drive.google.com/drive/folders/1-PfYS5V4zdYBSspUUNleBLRRr8vSpAFY\n\n使用用途 主に個人観賞用予定。もしかするとSNSのアカウントに使用する可能性あり\nその場合は🍳さんの名前を表記させていただきます。\n\n金額に見合わない場合変更の再送をして貰えればと思います。よろしくお願いします。", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@0141_egg/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3220809, "client_id": 683785, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/c7d498ba/uploads/origins/71649dc8-2c77-4d11-969e-d7e985f5865d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8eb60a177bc152cb60b45b683c340f60", "srcset": "https://si.imgix.net/c7d498ba/uploads/origins/71649dc8-2c77-4d11-969e-d7e985f5865d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8eb60a177bc152cb60b45b683c340f60, https://si.imgix.net/c7d498ba/uploads/origins/71649dc8-2c77-4d11-969e-d7e985f5865d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=6b1649ada25de601cb36619fe5d831e0 2x, https://si.imgix.net/c7d498ba/uploads/origins/71649dc8-2c77-4d11-969e-d7e985f5865d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f5648faebac9a4daccc8e1568c479e4a 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/c7d498ba/uploads/origins/71649dc8-2c77-4d11-969e-d7e985f5865d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=16864fb5e288a408f738098a5af7b09e", "srcset": "https://si.imgix.net/c7d498ba/uploads/origins/71649dc8-2c77-4d11-969e-d7e985f5865d