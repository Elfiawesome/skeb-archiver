23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=508f1b08bcd397c9636f52e57d8d042a, https://si.imgix.net/bcd5fe05/uploads/origins/fc242184-53a7-458b-a8f6-2da96c5eed3a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=5d968ece82a96b16f3a3beaca2a037a7 2x, https://si.imgix.net/bcd5fe05/uploads/origins/fc242184-53a7-458b-a8f6-2da96c5eed3a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=4be472d932f340541854a57a72915777 3x"}, "body": "こんばんは！お世話になっておりますまろにえです。Twitterアイコン用のイラストをリクエストさせていただきます。\n【リクエスト内容】\nTwitterアカウント@MARRONNIERRRのアイコンの人物(バストアップ)\n【人物詳細】\n・痩せ型で青白い肌(血色なし)\n・黒髪のオールバック一本三つ編み(腰くらいの長さ)\n・輪郭のはっきりした瞼で半目(どちらかと言えばほんのり垂れ目です)\n・黒い瞳\n・鷲鼻\n・大きくて歯並びの良い口\n・しっかりした顎\n・黒くて首の詰まった服(黒タートルで大丈夫です)\n\n・表情については、「無表情」または「うっすら悲しそうな顔」または「ガッカリした顔」でお願いします。\n・アングルについては、ガンジューさんの得意な向きで差し支えありません。\n・背景については、白以外の1色で差し支えありません。\n\n詳細については以上です。\n急ぎませんので、お手隙の際に進めていただく形で差し支えありません。\nどうぞよろしくお願いします。", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@mameCcka/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 450563, "client_id": 33518, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/b5d71e81/uploads/origins/ea35f63e-a1f0-4390-a277-af04b8a9b861?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0cb85a8ea2e76038926cab129f6109d4", "srcset": "https://si.imgix.net/b5d71e81/uploads/origins/ea35f63e-a1f0-4390-a277-af04b8a9b861?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0cb85a8ea2e76038926cab129f6109d4, https://si.imgix.net/b5d71e81/uploads/origins/ea35f63e-a1f0-4390-a277-af04b8a9b861?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b480c5ff36618b41250b1bf163b819f3 2x, https://si.imgix.net/b5d71e81/uploads/origins/ea35f63e-a1f0-4390-a277-af04b8a9b861?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e8fddc107cfea6784e2427a0eeaea015 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/b5d71e81/uploads/origins/ea35f63e-a1f0-4390-a277-af04b8a9b861?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f95047e56de6b768c3cb71bc8cc55256", "srcset": "https://si.imgix.net/b5d71e81/uploads/origins/ea35f63e-a1f0-4390-a277-af04b8a9b861?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f95047e56de6b768c3cb71bc8cc55256, https://si.imgix.net/b5d71e81/uploads/origins/ea35f63e-a1f0-4390-a277-af04b8a9b861?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=3d944d2dbdd5bb96e7b22f3f797bb529 2x, https://si.imgix.net/b5d71e81/uploads/origins/ea35f63e-a1f0-4390-a277-af04b8a9b861?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=a4b0e6d803af8cd582f9a3f808407114 3x"}, "body": "『冠を持つ神の手』より「哄笑するルージョン」の絵をリクエストさせてください！\n\nシチュエーションとしてはルージョン中日イベント「逃げるその先」のワンシーン、追い詰められたルージョンが邪悪な魔術師を演じている瞬間の笑い顔、をお願いしたいです。\n依頼理由が狂ったように笑ってみせる強いルージョンをガンジューさんの絵柄で見てみたいヨォ…！という感じですので、顔以外の体他描写範囲はおまかせします。主人公や衛士等は不要です。\nどちらかというと異様な雰囲気重視、衛士から見た迫真の演技をイメージしていただけたらと思います。\n(衛士が来る前のルージョンは雨に濡れ涙していますが、その残滓(涙跡等)はあってもなくても嬉しいです。弱さ完全カットでも！)\n暗いイベントの依頼ですみません🙇\nルージョンが全ての罪を己に掻き集めて持っていこうとしているような、絶望的な状況で見せる最期の胆力がとても好きなので、ぜひ……！\n\n以下該当イベントより抜粋したテキストとスクリーンショット(URL先)です。\n(出典：小麦畑『冠を持つ神の手』ルージョン中日イベント「逃げるその先」)\n■衛士からの印象参考\n･高笑いが辺りへ響き渡る。ルージョンは狂ったように笑っていた。\n･衛士の驚きの声につられてルージョンを見やれば、そこには異様な光景があった。\n雨は一層激しく降りしきっているのに、いつの間にか彼女の周りだけそのヴェールはかかっていない。\n･恐れと緊張と惑いが、一気に衛士らの中を駆け抜けていったのが分かった。\n･相対しているのが邪なる魔術師なのだと、もはや誰も疑ってはいない。\nあちらこちらで剣の金具が音を立てる。\n\n■ルージョンの台詞参考\n「そうだよ。私は……魔術師だ。」\n「頭の足りない神官や田舎者の候補者をたぶらかすのは簡単だったよ。\n同じ顔に化けて、死んだ弟のふりをするだけでころりと騙された。」\n「愚かな神の奴隷ども！頼みにする強固な砦も、我らの前では何の意味も持たない！\nさあ、次は何を打ち砕いてくれようか！」\n「ああ、そうだ。……神を殺してやろうとも！」\n「さあて、潰してやろうか」\n\n上記台詞のどれかか一部かを絵に入れていただけたらと思うのですが、無くても良いです🙆\n\n長文失礼しました。\nもし受けていただけましたら嬉しいです……！！\nゆるりとお待ちしておりますので、よろしくお願いいたします。\n\nhttps://twitter.com/MaiRaiKa_/status/1431218336738603013", "nc": 25, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@mameCcka/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 450563, "client_id": 3779, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/af20d822/uploads/origins/d4acd129-9913-401d-a434-cdb0cbe53786?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4f55ac77fb281838295ce946da7525e4", "srcset": "https://si.imgix.net/af20d822/uploads/origins/d4acd129-9913-401d-a434-cdb0cbe53786?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4f55ac77fb281838295ce946da7525e4, https://si.imgix.net/af20d822/uploads/origins/d4acd129-9913-401d-a434-cdb0cbe53786?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f89dba14931163320171674b6c060c77 2x, https://si.imgix.net/af20d822/uploads/origins/d4acd129-9913-401d-a434-cdb0cbe53786?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f832f86e4bc321cdd3360fea4bcc18ab 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/af20d822/uploads/origins/d4acd129-9913-401d-a434-cdb0cbe53786?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=edf6f30acdaf4157fa13112014ab9249", "srcset": "https://si.imgix.net/af20d822/uploads/origins/d4acd129-9913-401d-a434-cdb0cbe53786?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=edf6f30acdaf4157fa13112014ab9249, https://si.imgix.net/af20d822/uploads/origins/d4acd129-9913-401d-a434-cdb0cbe53786?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=52e2d5bd14c8af29d7f9460f226a4132 2x, https://si.imgix.net/af20d822/uploads/origins/d4acd129-9913-401d-a434-cdb0cbe53786?bg=%23fff&auto=