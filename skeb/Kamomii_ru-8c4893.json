Dq3t3", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Kamomii_ru/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1959409, "client_id": 3483410, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/16f10a36/uploads/origins/19ef460a-f2da-4e11-8e72-8b13a5e69d1a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=90e49f675a7cd169df976791ebe835d1", "srcset": "https://si.imgix.net/16f10a36/uploads/origins/19ef460a-f2da-4e11-8e72-8b13a5e69d1a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=90e49f675a7cd169df976791ebe835d1, https://si.imgix.net/16f10a36/uploads/origins/19ef460a-f2da-4e11-8e72-8b13a5e69d1a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=3d1ba249ff65271fd5c045ca0a11b2a0 2x, https://si.imgix.net/16f10a36/uploads/origins/19ef460a-f2da-4e11-8e72-8b13a5e69d1a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c5fee8db2d378d8349265c5a7cc437fc 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/16f10a36/uploads/origins/19ef460a-f2da-4e11-8e72-8b13a5e69d1a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e7dcd9e27c71479217f4b0279b45b7b2", "srcset": "https://si.imgix.net/16f10a36/uploads/origins/19ef460a-f2da-4e11-8e72-8b13a5e69d1a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e7dcd9e27c71479217f4b0279b45b7b2, https://si.imgix.net/16f10a36/uploads/origins/19ef460a-f2da-4e11-8e72-8b13a5e69d1a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=3daab4f8aed87568a3817c9a90073754 2x, https://si.imgix.net/16f10a36/uploads/origins/19ef460a-f2da-4e11-8e72-8b13a5e69d1a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=47907bc08