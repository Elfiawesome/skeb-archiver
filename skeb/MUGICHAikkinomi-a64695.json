残像が見えるほど高速ピストン責め\n③低周波電気(電撃)や媚毒液を流されて発狂絶頂\n④バイブを引っこ抜かれて天井に届くほど勢いよく失禁\n⑤息絶え絶えなまま更に凶悪なバイブを近付けられてボロ泣き絶望エンド\n※その他描きたい描写があればお好きなようにお願いします。\n\n清楚で可愛らしいみんなのアイドルそらちゃんが人生終了どころか生命終了しちゃうレベルの尿道快楽責めにガチ泣き発狂アクメしちゃうイラストを麦茶さんの思うままに描いていただけると嬉しいです。\n\n以上、ハードでマニアックな依頼で恐縮ですがよろしくおねがいします。", "nc": 187, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@MUGICHAikkinomi/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1051711, "client_id": 427191, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/282a2c82/uploads/origins/2a09c7a1-ee7e-45a2-ac85-e30a5bb738a7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d5a0ba53983c4a84b17f720266f894d3", "srcset": "https://si.imgix.net/282a2c82/uploads/origins/2a09c7a1-ee7e-45a2-ac85-e30a5bb738a7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d5a0ba53983c4a84b17f720266f894d3, https://si.imgix.net/282a2c82/uploads/origins/2a09c7a1-ee7e-45a2-ac85-e30a5bb738a7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=85b3a8782383104eb25f96352cd4515c 2x, https://si.imgix.net/282a2c82/uploads/origins/2a09c7a1-ee7e-45a2-ac85-e30a5bb738a7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f72b258a68e711fc08bf196720208512 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/282a2c82/uploads/origins/2a09c7a1-ee7e-45a2-ac85-e30a5bb738a7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c5dbed02c66c9f132a56e216467fb1b3", "srcset": "https://si.imgix.net/282a2c82/uploads/origins/2a09c7a1-ee7e-45a2-ac85-e30a5bb738a7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c5dbed02c66c9f132a56e216467fb1b3, https://si.imgix.net/282a2c82/uploads/origins/2a09c7a1-ee7e-45a2-ac85-e30a5bb738a7?bg=%23fff&auto=format%2Ccompress&fm=webp