ds/origins/84afa4ab-2918-4ef3-84de-06cd04817a07?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=0c6e1f5658341be6c684c911a62a37a4 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/0ef1f18c/uploads/origins/84afa4ab-2918-4ef3-84de-06cd04817a07?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9773c37555c690ddda4d451d3f00ff60", "srcset": "https://si.imgix.net/0ef1f18c/uploads/origins/84afa4ab-2918-4ef3-84de-06cd04817a07?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9773c37555c690ddda4d451d3f00ff60, https://si.imgix.net/0ef1f18c/uploads/origins/84afa4ab-2918-4ef3-84de-06cd04817a07?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=099bb58afe8951ca118813256922c839 2x, https://si.imgix.net/0ef1f18c/uploads/origins/84afa4ab-2918-4ef3-84de-06cd04817a07?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=18e34a6b5b42f3e2690f7ed5729061b3 3x"}, "body": "いつも配信にてお世話になっております。\nなるみさんがSkebを再開するのを心待ちにしておりました！\n\n今回描いて頂きたいのは「時雨ミト」さんというVtuberさんです。\n\n\n【希望内容】\n衣装は参考資料の衣装で髪形や服装、ポーズや構図などはおまかせいたします。\n\n【参考資料】\n衣装画像（2枚目一番右）：\nhttps://lit.link/shiguremito\n\n希望している衣装の発表配信：\nhttps://www.youtube.com/live/Kp0Gfp2b_MI?si=t2zmtoYdXkggaJQO&t=4084\n\n【使用用途】\n以下のような形での使用を想定しております。\n・X（旧Twitter）での宣伝活動\n・収益化済みYouTubeチャンネルでの使用\n・YouTube Shortsなどの動画内使用\n・その他、活動内でのサムネイル・ヘッダー・グッズなど\n\n【その他】\nPSD形式でお願いしたいです。\n\n※時雨ミトさんには確認を取り、Skebの許可を頂きました。\nご検討、どうぞよろしくお願い致します！\n\nhttps://www.youtube.com/live/Kp0Gfp2b_MI?si=t2zmtoYdXkggaJQO&t=4084", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@bunbukudou/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 4055335, "client_id": 1366552, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/de602874/uploads/origins/3c344363-ad2e-4a53-96d0-5cf929b8e35f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=169f0b3da4ef771b0f2e87d84f4f4454", "srcset": "https://si.imgix.net/de602874/uploads/origins/3c344363-ad2e-4a53-96d0-5cf929b8e35f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=169f0b3da4ef771b0f2e87d84f4f4454, https://si.imgix.net/de602874/uploads/origins/3c344363-ad2e-4a53-96d0-5cf929b8e35f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=cd38cc2db00c0b6880f74af74404ac78 2x, https://si.imgix.net/de602874/uploads/origins/3c344363-ad2e-4a53-96d0-5cf929b8e35f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f1744fa399644a878a90e413f2c1973f 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/de602874/uploads/origins/3c344363-ad2e-4a53-96d0-5cf929b8e35f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6f059763480c0c75b71589eef0177cdc", "srcset": "https://si.imgix.net/de602874/uploads/origins/3c344363-ad2e-4a53-96d0-5cf929b8e35f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6f059763480c0c75b71589eef0177cdc, https://si.imgix.net/de602874/uploads/origins/3c344363-ad2e-4a53-96d0-5cf929b8e35f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=ce0de5b58f1a77deb45b6028e5111fb1 2x, https://si.imgix.net/de602874/uploads/origins/3c344363-ad2e-4a53-96d0-5cf929b8e35f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=721c2f1480aabb4edc46f388723716a8 3x"}, "body": "なるみゆう　様\n\nいつもかわいいイラストや楽しい配信を、ありがとうございます。\n以前とても素敵に描いていただきました女の子について、お祝い用のドレスに着飾った姿をリクエストさせていただきます。\n\n\n⚪︎服装\n・光の当たり方によって色が変わる、白色のドレス\n（瞳の虹彩やグラデーションのように、白単色ではないイメージです。）\n・または、青い薔薇をモチーフとした、濃青色のドレス\n・脚が映えるアイドル風のフィッシュテールだと嬉しく思います。\n\n⚪︎構図\n・お任せいたします。\n\n⚪︎表情\n・笑顔\n・ウインク\n・両目閉じにっこり\nよろしければ表情差分をレイヤーでわけていただきたく存じます。\n\n⚪︎使用用途\n・SNSアイコンや壁紙\n・美少女ゲーム声優様の継続支援特典として「１〜３分ほどのシチュエーションボイス（全年齢向け）用のイメージイラスト」\n\n（skeb様でサンプル表示されるURLを伝えるのみで、イラストデータや音声データの二次配布は一切致しません。\n代わりに個人利用と無償プレゼント用でアクリルスタンド等のグッズを数個制作させていただきたく存じます。\nあわせまして、背景は透過にてお願い申し上げます。）\n\n\nskeb様でのリクエスト募集開始、ありがとうございます。\n声優様の12か月毎の継続支援特典内容が次回より変更され自由シチュエーションボイスが無くなるため、１回目に初めてお願いさせていただいた、なるみゆう様に今回改めてパーティ風ドレスに身を包んだイラストをお願いさせていただきたく存じます。\n\n特殊なリクエストとなり申し訳ございません。\n何卒よろしくお願い申し上げます。\n\n\n参考として、同じ女の子のイラストのURLを下記に記載いたします。\nお花の数については、今回６個となりますが年を重ねる毎に数が増えておりますので、ご指定ございません。\n\nhttps://skeb.jp/@narumiyu/works/12\nhttps://skeb.jp/@moco_ofuton/works/14\nhttps://skeb.jp/@anbutter_siruko/works/32\nhttps://skeb.jp/@Pooh_Piyo/works/8\nhttps://skeb.jp/@anbutter_siruko/works/41", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 55116, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "てんまそ", "screen_name": "tenmazombie", "avatar_url": "https://pbs.twimg.com/profile_images/1757766640186621952/WMbVJcCv.jpg", "header_url": "https://pbs.twimg.com/profile_banners/90880275/1706034393/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 12, "complete_expiration_days": 45, "skills": [{"genre": "art"}], "banned": false, "nc": 17}, {"id": 1110591, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "七瀬尚", "screen_name": "nanasenao", "avatar_url": "https://pbs.twimg.com/profile_images/2061065108378501120/oH3gDp6z.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1274529210871115776/1780231190/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 3, "complete_expiration_days": 120, "skills": [{"genre": "art"}], "banned": false, "nc": 1