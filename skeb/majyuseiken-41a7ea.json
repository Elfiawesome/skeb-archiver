rigins/f19332ba-f327-4817-a566-69bc4287d40b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=47c31604458dd2ac1431c57ba3fa6f19 2x, https://si.imgix.net/ceeb57ad/uploads/origins/f19332ba-f327-4817-a566-69bc4287d40b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=10485d68ee7c1ce9fcec93acaf1f9247 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/ceeb57ad/uploads/origins/f19332ba-f327-4817-a566-69bc4287d40b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ba233836d8223ebb46191eed28b8ca13", "srcset": "https://si.imgix.net/ceeb57ad/uploads/origins/f19332ba-f327-4817-a566-69bc4287d40b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ba233836d8223ebb46191eed28b8ca13, https://si.imgix.net/ceeb57ad/uploads/origins/f19332ba-f327-4817-a566-69bc4287d40b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=bef97aaa97764f2196a6e3fe3ccff51f 2x, https://si.imgix.net/ceeb57ad/uploads/origins/f19332ba-f327-4817-a566-69bc4287d40b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=c6a58fb6103eb7ffe2874125c408af11 3x"}, "body": "ゾイドとあなたの作品の大ファンです。\n\n私はユニア・コーリンが大好きで、彼女の絵をもっと見たいです。映画のポスターのようなイラストを探しています。私の頭の中では、彼女の間にライバル関係があります、オルディオスのパイロット一族の最後の後継者である彼女と、ギル・ベイダーで破壊するためだけに育てられた古代ゾイドのマン・バレンシア。両ゾイドの間には長い戦いの歴史があるため、ライバル関係が生まれる。\n\n私はこのポスターで、両パイロットとゾイドの間のライバル関係、そして戦争によって引き離された2人の無邪気な子供たちの、友達であったかもしれない必然的な戦いを表現したいと思います。それ以外のことはあなたの経験次第です。\n\nユニア・コーリン\nhttps://ameblo.jp/bluekoara/entry-12280558565.html\nhttps://x.com/SakuraIbuki/status/1802191120279171521\n\nマリエス・バレンシア\nhttps://ameblo.jp/bluekoara/entry-12433028501.html\n\nhttps://web.archive.org/web/20210820084301/https://nerczpb.wixsite.com/zoidsbs/obs612", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@majyuseiken/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3220930, "client_id": 1843343, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/3efaf32b/uploads/origins/fab17500-aafe-4ece-b64a-bba1a820ae61?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d54d0896807333dd5ece236f7e84bd53", "srcset": "https://si.imgix.net/3efaf32b/uploads/origins/fab17500-aafe-4ece-b64a-bba1a820ae61?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d54d0896807333dd5ece236f7e84bd53, https://si.imgix.net/3efaf32b/uploads/origins/fab17500-aafe-4ece-b64a-bba1a820ae61?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b31276d926fd7f08cdccc4fb10f6e400 2x, https://si.imgix.net/3efaf32b/uploads/origins/fab17500-aafe-4ece-b64a-bba1a820ae61?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=664d223329c0f3feb4e0cf82331bd1ca 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/3efaf32b/uploads/origins/fab17500-aafe-4ece-b64a-bba1a820ae61?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e1e330e7b4d101618ef39e02e0db7852", "srcset": "https://si.imgix.net/3efaf32b/uploads/origins/fab17500-aafe-4ece-b64a-bba1a820ae61?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e1e330e7b4d101618ef39e02e0db7852, https://si.imgix.net/3efaf32b/uploads/origins/fab17500-aafe-4ece-b64a-bba1a820ae61?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=47dabf0d42f2778e0f321442f7f1f461 2x, https://si.imgix.net/3efaf32b/uploads/origins/fab17500-aafe-4ece-b64a-bba1a820ae61?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=260138e65b9850eb9681271bfed9ee25 3x"}, "body": "はじめまして。\n早速ですがゾイドのイラストをお願いします。\n\n題材はゾイドシリーズ最初の主人公である「神風ジョー」と「ゾイドゴジュラス」が、邪悪な敵、ゼネバス皇帝率いる帝国軍に戦いを挑む構図の少年漫画の表紙系のものです。\n勇敢な少年と勇猛な相棒が、邪悪で強大な敵に挑んでいる、単純明快な勧善懲悪系の構図でお願い致します。\n\n神風ジョー(彼の体格などはお好みにお任せします)\nhttps://twitter.com/mugenyu10/status/1677991092590120960\nhttps://twitter.com/mugenyu10/status/1677991500079325184\n\n\nゼネバス皇帝(最初期版でのゾイド星人は爬虫類型のヒューマノイドです)\nhttps://twitter.com/yuzumuge4/status/1635252462948057092\nhttps://twitter.com/yuzumuge4/status/1635265342816780288\n\n補足：ゾイド星人設定(最初期版)\nhttps://twitter.com/yuzumuge4/status/1642881430228287491\nhttps://twitter.com/mugenyu10/status/1677991092590120960", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@majyuseiken/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3220930, "client_id": 1471342, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/db058994/uploads/origins/73addb53-b69d-42ab-9dcc-dd47e7c02a94?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1ca501c530b4d11e81a2c06d6191740d", "srcset": "https://si.imgix.net/db058994/uploads/origins/73addb53-b69d-42ab-9dcc-dd47e7c02a94?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1ca501c530b4d11e81a2c06d6191740d, https://si.imgix.net/db058994/uploads/origins/73addb53-b69d-42ab-9dcc-dd47e7c02a94?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=fc990b637c93acdee2aaf52311098b43 2x, https://si.imgix.net/db058994/uploads/origins/73addb53-b69d-42ab-9dcc-dd47e7c02a94?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=7537efe624ee4c859384f2878900e418 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/db058994/uploads/origins/73addb53-b69d-42ab-9dcc-dd47e7c02a94?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=19ad73958b0db8db3f6262a1d4e38a99", "srcset": "https://si.imgix.net/db058994/uploads/origins/73addb53-b69d-42ab-9dcc-dd47e7c02a94?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=19ad73958b0db8db3f6262a1d4e38a99, https://si.imgix.net/db058994/uploads/origins/73addb53-b69d-42ab-9dcc-dd47e7c02a94?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=46b96aef845d99e9608e6f46b2b400f1 2x, https://si.imgix.net/db058994/uploads/origins/73addb53-b69d-42ab-9dcc-dd47e7c02a94?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=6a9ba05fd0c9c314d9a13999ef9bb9da 3x"}, "body": "初めましてです\n今回は魔銃聖剣様に人魚ゾイド（ゾイド？）のイラストを描いていただきたいと依頼いたします（一応参考として拙作https://drive.google.com/drive/folders/1-0JyMIevpdqzjSecAUCVrcpZbxIsXo_y\nもにもに様に依頼いたしました作品　https://skeb.jp/@nimozimonimoni/works/1\nぢゃら様に依頼いたしました作品https://skeb.jp/@GOD_JULAS/works/6）\n設定としてはもにもに様のイラストの感じで人間大サイズの人魚ゾイドがバズーカなどの武器を使って敵の軍用ゾイドと戦ってるシチュエーション、帝国共和国の所属などはお任せしたいと思います\n顔はメカ娘よりは生寄りで腰のあたりに車輪的なパーツがあればあとは参考資料からかけ離れてても大丈夫です\nいろいろデザインしていただくので難しいところもありますが受けていただければ嬉しいです", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 853432, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "アム℃", "screen_name": "omoro3bot", "avatar_url": "https://pbs.twimg.com/profile_images/1833992503168741376/IJza3_wk.jpg", "header_url": "https://pbs.twimg.com/profile_banners/2509424700/1726092884/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 15, "complete_expiration_days": 30, "skills": [{"genre": "art"}], "banned": false, "nc": 128}, {"id": 1614681, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "粘土洋⚓Skeb", "screen_name": "Cleyseamod4", "avatar_url": "https://pbs.twimg.com/profile_images/1689653992656441346/ByxUaRZB.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1459062815105642496/1772811182/1500x500", "a