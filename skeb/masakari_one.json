y_public": false, "tip_acceptable": true, "yearly_report_client_visible": false, "total_appeals_count": 0, "received_works": [{"path": "/@masakari_one/works/8", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 25133, "client_id": 0, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/7ee082c0/uploads/origins/c80e8311-9e8a-440d-8f56-478e70ce1f7a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e837a6bcb92c5c183b80005c111b36fd", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/7ee082c0/uploads/origins/c80e8311-9e8a-440d-8f56-478e70ce1f7a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ae0395b4e8c8ad23ed738f457aec698c", "src_set": ""}, "body": "うちの子の妊娠成長録を描いてください\n\n・描いて欲しい期間\n受精〜臨月(受精→妊娠検査→14週→22週→32週→臨月→産後)\n・シチュ\n睡眠姦\n・スキン\n裸\n・体位と構図\nhttps://drive.google.com/drive/folders/1AvJ7P7kpgEEW_ES_WFClMTOU64qN5kgE\n・詳細\n受精\n左手には精液たっぷりのシリンジ。細い管を通って子宮に直接精子を注入。注入されていく精子は断面図、受精はカットイン\n妊娠検査\n左手には妊娠検査薬。尿に当てる。結果は陽性。子宮内カットイン\n14週のエコー検査は水着の中に手を突っ込む。それ以外は水着の上から\n産後\nへその緒が繋がった女の子の赤ちゃんを隣に配置\n\n・表情:眠ったまま(途中覚醒NG)悪戯やセックス時は感じている(下品な顔NG) \n・中出し断面図、受精描写、胎内描写(胎児の成長差を細かく)お願いします \n・胎児は逆子で女の子と一目でわかるようにお願いします\n・妊娠に伴うバストアップもお願いします\n・パイパン。おっぱいは魅惑の谷間が特徴的なハリがあって形のいい美巨乳。ウエストは引き締まっていて、前からでも見えちゃう尻神様のような安産型のお尻に艶っぽい鼠蹊部と健康的な太もも\n\n金額内で不可能な場合は金額を再送して下さると幸いです\n\nhttps://drive.google.com/drive/folders/1-aU6Jy4i_0sVRLLUTig1DU3yvjRUiS1K", "nc": 40, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@masakari_one/works/7", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/057cc9fb/uploads/origins/56bbb368-6e5c-4a7f-abc9-7f4c26bd9531?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=8cc600dbde69dbde00d99bb13a80ef47", "src_set": ""}, "private": true, "genre": "art", "tipped": true, "creator_id": 25133, "client_id": 0, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 161, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@masakari_one/works/6", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/1e6f738c/uploads/origins/22cded69-b5b4-4d12-bc1e-e74d78af5cb8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=f2d42b61ccbaaf754ee78bab35d84f21", "src_set": ""}, "private": true, "genre": "art", "tipped": false, "creator_id": 25133, "client_id": 222046, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 48, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@masakari_one/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 25133, "client_id": 125850, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/b0c654fc/uploads/origins/651ba318-064e-46fc-b59b-e744f9825661?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=28477f73b877ca49f9f3c27b2c9e1743", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/b0c654fc/uploads/origins/651ba318-064e-46fc-b59b-e744f9825661?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=01ad844d02f3a7a6f577feebb87052e3", "src_set": ""}, "body": "将仮様初めまして、乙茶と申します\n\n以前よりずっと依頼するタイミングを伺っておりました…もしよければお願いします\n\n原神より『蛍』ちゃんのボテ腹をリクエストします\n以下詳細です\n\n・子宮口丸見え\n・黒乳首と竿役描写はＮＧ\n・お腹と乳は可能な限り盛ってください\n・台詞等はなくて良いのでイチャラブな雰囲気\n\nこれらを満たす絵であればＯＫ\n\nこれより下は希望差分です、厳しければ下記の差分はなくて構いません\n\n・子宮脱/子宮脱状態からへその緒を複数本出す\n・母乳や愛液、精液等の汁差分\n採用して欲しい順に上から書いております。\n・当方の過去依頼をご覧いただくと分かると思いますが宛名代わりでよいので体のどこかに『乙茶専用♡』とか『乙茶専用孕み嫁♡』みたいなラクガキをお願いします、絵に合わなければ普通の宛名で大丈夫です\n\n恰好・背景は自由です、スケベなモノに改変したり剥いだりもしくは無しでも構いません\n\n絵のバックストーリー的なモノは大雑把に言うと\n愛する最強雄様に処女を捧げ、全卵子受精♡身も心も結ばれ…そしてお迎え棒ックス事後といった感じです（男主人公の空君が相手ではありません）\n勿論このバックストーリーは絵に反映されなくて大丈夫です\n\n以上、ご確認お願いします", "nc": 48, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@masakari_one/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 25133, "client_id": 254239, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/f65abfdb/uploads/origins/b21d00e9-e5f1-4c00-ba4e-2c1cc11a0870?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=751c92fdae3560c2e18b91d3950674f2", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/f65abfdb/uploads/origins/b21d00e9-e5f1-4c00-ba4e-2c1cc11a0870?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=033be3a3bf9066d851e838a69d3e8ce0", "src_set": ""}, "body": "はじめまして。スカイラとのラブシーンを希望します。騎乗位でのシーンで、可能であれば授乳・妊娠ありのバリエーションを希望します。その他細かいことはお任せします。  よろしくお願いします！\n\nhttps://drive.google.com/drive/mobile/folders/1EoYiPs7wPvWZ1zluJON3oqamZc_e3xjw?sort=13&direction=a", "nc": 176, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@masakari_one/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 25133, "client_id": 1913423, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/32411f62/uploads/origins/8c3a58c8-f963-4d0b-9e23-3ee1dc274b98?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=07ec00f0c461619998b6b2593cadc8a3", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/32411f62/uploads/origins/8c3a58c8-f963-4d0b-9e23-3ee1dc274b98?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c8e31facebe9586a2ca3fcb04f56b0d3", "src_set": ""}, "body": "将仮先生初めまして！\n滅茶苦茶素敵なボテ腹エッチをお見掛けしたもので、よければご依頼させて頂けないでしょうか！\n\n千年戦争アイギスというゲームから\n政務官アンナという女性が山賊頭モーティマとイチャHする内容お願いしたく、\n参考構図のような男性主観での騎乗位構図で、恰好は全裸で恋人繋ぎをしながら\n幸せそうに母乳を溢れさせての騎乗位ボテ腹Hしているイラストをお願いできませんでしょうか！\n※二人は恋人関係にある設定でイチャラブ甘々な感じ\n※男性描写は参考構図のような腕とかお腹が見える場合に体格がそれっぽい程度のもので大丈夫です\n\n▼参考キャラ\nhttps://i.imgur.com/xZY8w2p.png\n\n▼参考構図\nhttps://skeb.jp/@masakari_one/works/1\n\nもしも可能でしたら台詞をお願いしたく、\n「あ♡モーティマさん♡そんなに激しくしたら、赤ちゃんビックリしちゃいますよ♡」\n「もうすぐ産まれるんですから、ちゃんと大切にしてくださいね♡」\nみたいな幸せたっぷりラブラブみたいなイチャラブ感ある台詞などがありますと嬉しいです。\n（台詞は口調の参考程度なので、お好きな感じにして頂きたく思います。台詞難しそうでしたらなしでも全然大丈夫です）\n\nお好みな内容でなければ、お手数おかけしてしまいますがキャンセル頂けますと幸いです。\n何卒ご検討の程よろしくお願い致します。", "nc": 40, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@masakari_one/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 25133, "client_id": 22836, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/c91a68b3/uploads/origins/eb8a4049-9432-4f8c-a1fd-892f01e76f12?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=161356cd15b6187cdfab1efbfe2ddbcc", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/c91a68b3/uploads/origins/eb8a4049-9432-4f8c-a1fd-892f01e76f12?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=7f6d92877cf29a08363533beae2c8a93", "src_set": ""}, "body": "投稿作品を見てお気に入りのキャラでお願いしたくなりました\nガンダムEXVSシリーズよりセシア・アウェアを題材でお願いします\n参考　https://imgur.com/a/rFbXTOR\n過去投稿作のような竿役視点の騎乗位で衣装を残しつつもボテ腹要素込みの作品が希望になります\nよろしくお願いします", "nc": 32, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@masakari_one/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": 