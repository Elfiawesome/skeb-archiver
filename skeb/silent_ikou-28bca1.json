CoPr_mBP3kvywhwtJrG_l", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@silent_ikou/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 4112444, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/8aecdada/uploads/origins/1c9433cb-aa3c-447c-8315-11853bd79cd1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d5b3f6d7975b1101756dc81016a98afc", "srcset": "https://si.imgix.net/8aecdada/uploads/origins/1c9433cb-aa3c-447c-8315-11853bd79cd1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d5b3f6d7975b1101756dc81016a98afc, https://si.imgix.net/8aecdada/uploads/origins/1c9433cb-aa3c-447c-8315-11853bd79cd1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=11d0c0d2fc67fa86a05dd29e60f581df 2x, https://si.imgix.net/8aecdada/uploads/origins/1c9433cb-aa3c-447c-8315-11853bd79cd1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=2204d7c60b8167e41cb617deeb0489a0 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/8aecdada/uploads/origins/1c9433cb-aa3c-447c-8315-11853bd79cd1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c7a126e9d1bf5a485c5254e7bffcf78a", "srcset": "https://si.imgix.net/8aecdada/uploads/origins/1c9433cb-aa3c-447c-8315-11853bd79cd1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c7a126e9d1bf5a485c5254e7bffcf78a, https://si.imgix.net/8aecdada/uploads/origins/1c9433cb-aa3c-447c-8315-11853bd79cd1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=3296837648cc70a384fa63611cfae455 2x, https://si.imgix.net/8aecdada/uploads/origins/1c9433cb-aa3c-447c-8315-11853bd79cd1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=20c32940e6e130e5c1a196a774635eb1 3x"}, "body": "こんにちは。先生の絵柄がとても好きで、ぜひこちらのOCを描いていただきたく、ご連絡いたしました！\n今回は、こちらのイラストのような雰囲気でお願いできればと思っています。\nhttps://x.com/silent_ikou/status/2039357194538492256/photo/1\n\n■ OC\n27歳・男性・190cm\n\n別の世界線に生きるチー・ユーミンを描いていただきたいです。\n主世界の彼は穏やかで物腰の柔らかい社会人ですが、この世界線では幼い頃からさまざまな抑圧や厳しい環境にさらされ、早くから社会に出て生きてきました。そのため、外見そのものは大きく変わらないものの、性格や雰囲気にはより強い世慣れた感じや、社会に揉まれてきた人特有の荒さがあります。\n\n黒く細く柔らかな髪、深い黒の瞳、切れ長の桃花眼、色白の肌、華やかで中性的な顔立ち。左口元などに小さなほくろがあります。\n\n長年の社会経験から、少し世慣れた、荒さのある雰囲気を持っています。目の下には薄い隈があり、右手や身体にはいくつか傷跡があります。左耳に3つ、右耳に4つのピアスがあり、指輪やネックレスなどのアクセサリーも自由に加えていただけると嬉しいです。胸元には「DiVinG」のタトゥーがあります。\n\n今回は、少し暗く退廃的で、色気のある緊張感を持った一枚を希望しています。露骨な表現ではなく、視線や表情、距離感、仕草などから陰暗な性的緊張感が伝わるような雰囲気が嬉しいです。\n\nまた、ピアスや傷、アクセサリーなどから、普通とは少し違う人生を歩み、社会の中で揉まれてきたような世慣れた・荒っぽい気配も感じられると嬉しいです。\n\n構図や演出は先生の自由な解釈にお任せいたします。\nもし可能でしたら、顔の絆創膏は描かないでいただけると嬉しいです。\n\nhttps://drive.google.com/drive/folders/10lHyXTNCwKmL5XAzDDbl5Y87gLo9bI9G", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@silent_ikou/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 4112444, "client_id": 1814269, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/6f178754/uploads/origins/bd428a1a-ea63-43c3-b9da-31bac59a0c61?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=95b30af125bf8990613c72c57d5e3781", "srcset": "https://si.imgix.net/6f178754/uploads/origins/bd428a1a-ea63-43c3-b9da-31bac59a0c61?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=95b30af125bf8990613c72c57d5e3781, https://si.imgix.net/6f178754/uploads/origins/bd428a1a-ea63-43c3-b9da-31bac59a0c61?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=9eedf45be1f6419cc4c7e4f89595df78 2x, https://si.imgix.net/6f178754/uploads/origins/bd428a1a-ea63-43c3-b9da-31bac59a0c61?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f9eda979e3b14584b65438d570337e69 3x"}, "duration"