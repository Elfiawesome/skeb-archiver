機に、今後とも仲良くして頂けますと幸いです…！！", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 486799, "creator": true, "nsfw_acceptable": true, "acceptable": false, "name": "ようづき@2日目西め44ab", "screen_name": "Shiro_Youduki", "avatar_url": "https://pbs.twimg.com/profile_images/1994164843981754370/MS5O3kAT.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1707284070/1764280963/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "art"}], "banned": false, "nc": 177}, {"id": 1347410, "creator": true, "nsfw_acceptable": true, "acceptable": false, "name": "RISE", "screen_name": "RISE19851203", "avatar_url": "https://pbs.twimg.com/profile_images/1956640935984701440/NYbI0Q9H.jpg", "header_url": "https://pbs.twimg.com/profile_banners/2246700306/1582611913/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 7, "complete_expiration_days": 14, "skills": [{"genre": "art"}], "banned": false, "nc": 176}, {"id": 2498238, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "アズミ@skeb募集", "screen_name": "Azumi_illust", "avatar_url": "https://pbs.twimg.com/profile_images/2047228890339577856/odlOcAVJ.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1529466063557079041/1773587269/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "art"}], "banned": false, "nc": 16}, {"id": 2563927, "creator": true, "nsfw_acceptable": false, "acce