な点がございましたら、依頼をキャンセルしていただいても構いません。\nありがとうございます！\n\nhttps://drive.google.com/drive/folders/1uUEhes35k2l2tFUchiHToDkqz-kSNQt3?usp=sharing", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@untgomi/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3706950, "client_id": 2998972, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/cb9dc1bd/uploads/origins/617857d8-aa8c-4f9a-8c96-418c468990dd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3739dba0ac7a9da522e14db318cf048a", "srcset": "https://si.imgix.net/cb9dc1bd/uploads/origins/617857d8-aa8c-4f9a-8c96-418c468990dd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3739dba0ac7a9da522e14db318cf048a, https://si.imgix.net/cb9dc1bd/uploads/origins/617857d8-aa8c-4f9a-8c96-418c468990dd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e4bfa3917fb6a804cd18376d950d16c8 2x, https://si.imgix.net/cb9dc1bd/uploads/origins/617857d8-aa8c-4f9a-8c96-418c468990dd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=51d37d9d946265363d66f16eff7d7b91 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/cb9dc1bd/uploads/origins/617857d8-aa8c-4f9a-8c96-418c468990dd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ff8747398e48dd749fb97c75ef6afc17", "srcset": "https://si.imgix.net/cb9dc1bd/uploads/origins/617857d8-aa8c-4f9a-8c96-418c468990dd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ff8747398e48dd749fb97c75ef6afc17, https://si.imgix.net/cb9dc1bd/uploads/origins/617857d8-aa8c-4f9a-8c96-418c468990dd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=cee5dc034bffa5b6dfb541227d965f3b 2x, https://si.imgix.net/cb9dc1bd/uploads/origins/617857d8-