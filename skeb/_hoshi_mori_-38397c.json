ress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=86b47583577d38f00c44b3c8e4531812 3x"}, "body": "初めまして、流羽・烏狼と申します。\nフォロワー様6万人、おめでとう御座います！\nいつも、素敵なイラストを楽しく拝ませて頂いております……！\n\n今回は、無機質では無いのですが……。\n私のオリキャラ（青年）の相棒である、仔狼を擬人化させたような、人外さんを描いて頂けたら嬉しいです！\nイメージとしては、仔狼のイケオジverみたいな感じです。\n\n仔狼は、繊細な性格のオリキャラの魂から生まれた生命体で、いつも、直ぐ傍で彼を支えてくれています。\n\n顔は狼要素強め、身体は人間要素強め（羽は生やして欲しいです……！）でお願いします。\n足は、迷っているので、ほしもりさんにお任せさせて頂きます。\n\n構図や衣装なども、ほしもり様の自由に描いて頂けたら嬉しいです！\n宜しくお願い致します。\n\n仔狼（一応、オリキャラも入れておきました）の参考資料は、下のリンクより確認して頂けます。\n\nhttps://drive.google.com/drive/folders/1IW5WhlRdN2C1RiNp2-2RsulGc1V_6yom", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@_hoshi_mori_/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3353428, "client_id": 3433882, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/585fe2f5/uploads/origins/8dc2d707-3a11-48ab-927c-edc9751a2cf9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=eb4d58d55422f30504d129453a8fecaa", "srcset": "https://si.imgix.net/585fe2f5/uploads/origins/8dc2d707-3a11-48ab-927c-edc9751a2cf9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=eb4d58d55422f30504d129453a8fecaa, https://si.imgix.net/585fe2f5/uploads/origins/8dc2d707-3a11-48ab-927c-edc9751a2cf9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f2eafbb2b4fa168a6e2b2c4c228a9e9b 2x, https://si.imgix.net/585fe2f5/uploads/origins/8dc2d707-3a11-48ab-927c-edc9751a2cf9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=3a1405fb875aa71d89c254f3d1971a1d 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/585fe2f5/uploads/origins/8dc2d707-3a11-48ab-927c-edc9751a2cf9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=abf70be4a4fe557b2a955a9e55aa4188", "srcset": "https:/