n………………………………………………………\n★描いて欲しいキャラクターイメージ\n魔法使い、魔女\n\n・髪型→赤色(赤オレンジ、赤茶っぽい)\nポートフォリオにいる女の子ぐらいのミディアム外ハネボブ、前髪は、右分け。(髪の毛、ぴょんぴょんさせてください！笑(少しはねてる…？))\n\n・目→緑色(たれ目より、つり目の強い女の子。でも優しい。(イメージ…ララフェルみたいな？感じの目…))\n\n・服→魔法使い(黒魔女っぽい黒紫っぽい服)\n(装飾品として、とんがり帽子やホウキ、黒猫(目→黄色～黄緑色)も描くことが可能でしたら描いて欲しいです))(猫はたくさん大歓迎です。)\n\n・その他好きなモチーフ\nパン(フランスパンetc……)、ドライフラワー、植物、カブ、洋裁(毛糸や糸、ボタンetc……)、猫\n(こちらは、イラストの全体のイメージの雰囲気に合わせるときに装飾品予備としてのイメージです。)\n………………………\n最後に…\nまつうらあいさんの暖かみのある色使いやほっこりした雰囲気のイラストがとても好きです。\nですので、色々とこまごまとたくさんの情報を書きましたが、最終的にはまつうらあいさんに、好きなように楽しくイラストを仕上げていただきたいです！！\n\nもし、名前を書く際には、\n『魔法使いルナ』さんへと書いて欲しいです。\nよろしくお願い致します！", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@norisuko0225/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 960747, "client_id": 1216124, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/a93fe593/uploads/origins/c502a91a-59c8-487a-afad-c975d96ba0e8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=da95a4dfc343b22c166aa8142f2e523f", "srcset": "https://si.imgix.net/a93fe593/uploads/origins/c502a91a-59c8-487a-afad-c975d96ba0e8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=da95a4dfc343b22c166aa8142f2e523f, https://si.imgix.net/a93fe593/uploads/origins/c502a91a-59c8-487a-afad-c975d96ba0e8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=8c0bad907a30385caaedb3e8520072d5 2x, https://si.imgix.net/a93fe593/uploads/origins/c502a91a-59c8-487a-afad-c975d96ba0e8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=46c2bc8cce736e9a98cbf348b34d9ee1 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/a93fe593/uploads/origins/c502a91a-59c8-487a-afad-c975d96ba0e8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=8c77517eb048b8e267fdc67b6792425e", "srcset": 