h=200&blur=200&s=bdb929b6fbfa27616742e1d53ba7bf89 3x"}, "body": "先生、こんにちは！先生の作品がとても好きです。私のキャラにイラストを描いていただきたいのですが(´∀`)\n設定についてはどんなアレンジでも自由にしていただいて構いませんし、先生のご自由な発想で描いていただければ嬉しいです！\nもし金額に問題があれば、再送要請をお送りください。お引き受けいただけない場合も、キャンセルしていただいて構いません。よろしくお願いいたします！\n\nhttps://drive.google.com/drive/folders/1SJvf9a9QBk91qB199kZYV9Wx5kt6pqzj", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@deburi/works/14", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3388203, "client_id": 895502, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/b55c5abd/uploads/origins/1957a6c9-755e-4a7b-8029-e728809d0263?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=de3756f9d915c257e9df6b19e7a5cc3e", "srcset": "https://si.imgix.net/b55c5abd/uploads/origins/1957a6c9-755e-4a7b-8029-e728809d0263?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=de3756f9d915c257e9df6b19e7a5cc3e, https://si.imgix.net/b55c5abd/uploads/origins/1957a6c9-755e-4a7b-8029-e728809d0263?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=68c1a39ace7eaad4ad3c6a0a8eba7fd0 2x, https://si.imgix.net/b55c5abd/uploads/origins/1957a6c9-755e-4a7b-8029-e728809d0263?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=6e6faa601885586313e5395e5e34045b 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/b55c5abd/uploads/origins/1957a6c9-755e-4a7b-8029-e728809d0263?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c749120b8de7f965e1b0768b2f5263e5", "srcset": "https://si.imgix.net/b55c5abd/uploads/origins/1957a6c9-755e-4a7b-8029-e728809d0263?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c749120b8de7f965e1b0768b2f5263e5, https://si.imgix.net/b55c5abd/uploads/origins/1957a6c9-755e-4a7b-8029-