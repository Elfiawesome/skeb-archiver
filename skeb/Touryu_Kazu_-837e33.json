単に別れてしまう。本当は愛されたいと思っているが、それを恐れている。人といても孤独を感じるタイプ。\n\n趣味は化粧（または他人の化粧）、ゲーム、バーやクラブに出かけること。\n\nテーマとモチーフ：ワイン、夜更かし、孤独、自分に嘘をついているようで怖い。\n\nポーズの提案は、彼女が化粧を見たり、化粧直しをしたりすること。それでも、彼女に一番似合うと思うものを自由に描いてください。\n\nhttps://drive.google.com/drive/folders/1xcDA7818kEDbil5KyeU3M3eVlIdsLuew?usp=sharing", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@Touryu_Kazu_/works/4", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/73c9848b/uploads/origins/d17c9cf4-5526-4709-be53-2312aeb51510?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=720f84e24e59b58ffa9e1c5f45cb9209", "srcset": "https://si.imgix.net/73c9848b/uploads/origins/d17c9cf4-5526-4709-be53-2312aeb51510?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=720f84e24e59b58ffa9e1c5f45cb9209, https://si.imgix.net/73c9848b/uploads/origins/d17c9cf4-5526-4709-be53-2312aeb51510?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=9b16608842ac34e62d36ed638ac4a64a 2x, https://si.imgix.net/73c9848b/uploads/origins/d17c9cf4-5526-4709-be53-2312aeb51510?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=377ce988b7315cd93ee3f19c8ff37bc0 3x"}, "private": true, "genre": "art", "tipped": true, "creator_id": 2533266, "client_id": 2055392, "nc": 129}, {"path": "/@Touryu_Kazu_/works/3", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/0944903c/uploads/origins/0bdbc374-db4f-4fb9-8f40-02c6d28de203?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txta