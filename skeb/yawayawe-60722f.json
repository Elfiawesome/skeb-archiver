11d4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=66e0259708da935d66ea7f0e0330bbaa", "srcset": "https://si.imgix.net/db2b9776/uploads/origins/60085605-12d4-4ed6-b386-c813578411d4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=66e0259708da935d66ea7f0e0330bbaa, https://si.imgix.net/db2b9776/uploads/origins/60085605-12d4-4ed6-b386-c813578411d4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=ac5be72bb7917e8c01b467ea19323008 2x, https://si.imgix.net/db2b9776/uploads/origins/60085605-12d4-4ed6-b386-c813578411d4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=cfe666ec17d27f33ce9faf55638459d1 3x"}, "body": "鬼滅の刃をお願いします\n\n・炭治郎、禰豆子、伊之助、善逸が義勇の屋敷に遊びに行って、柱達が嫉妬するほど伊之助は義勇が大好きになった\n・義勇自身は血縁者もいない天涯孤独な身の上と、自己肯定感の低さも相まって、腹を賭けていることに対して影響ないと思っているが、原作の柱合会議編にて義勇の行動を聞いた柱と、周囲の激怒っぷりが酷く、しばらく仕事ができないほど対応に追われた。周囲があまりにも怒るのと反応の大きさに驚いていて、なぜそこまで大事になるのか理解できておらず、鱗滝左近次の影響かとピントがずれた考えをし、師を尊敬した。\n・周囲は柱だと認めており、未だに隊士達の中では隠ではなく柱だと思っているのが大半。｢俺は水柱じゃない｣の発言で、義勇が柱だと思っていなかったことに、言葉に出来ない驚愕と怒りしかなかった\n・悲鳴嶼が鬼の襲撃の際に、義勇に助けられて、その流れで鬼殺隊に入った。義勇は当初悲鳴嶼を継子にするつもりはなく、落ち着いたら、別れると思っていたが、気が付いたら継子になっていた。時透兄弟と宇髄も一緒\n・カナエを上弦の弐の襲撃の際に助け、その怪我が原因で柱を引退した。現在は隠のまとめ役兼柱達の相談役。\n・現役時代は守りに重視した隊士で、パワーなら悲鳴嶼が有利だけど、経験値や手札の多さなら義勇が上のため、勝率では義勇が上回る。現在は隊士としては戦えるが、肺に障がいがあり、持久戦が出来ないため、任務には出ていない。\n・リハビリ中に山にいった際、崖に落ちた時透父を助けた。その後、病魔に侵された時透母を介抱した。それが縁で、義勇の屋敷で、時透家は使用人として働いている。このとき、山の移動が困難になったことや、大人一人すらも抱えていくことが出来ないことから、限界を感じ、隊士の引退を決意した出来事でもある。\n・不死川兄弟の保護者。鬼の襲撃の際に助けた。死んでしまった子や、生きていても障がいが残っている子どももいる。義勇の屋敷で暮らしている。実弥は下の兄弟が義勇の保護下にあることをしっており、義勇から実弥に兄弟はいないのかと問われた際、鬼殺隊に関わらせたくないので、原作以上に突き放した。実弥は母親を殺した後、その場から逃げていて、それをしなければ、兄弟達は全員五体満足で生きていられたのではと罪悪感にかられている。義勇は玄弥の意思を聞いて、元継子の悲鳴嶼を紹介した。\n・実弥も義勇には恩義があり、尊敬しているが相性が悪い。下弦の壱の戦闘時、絶体絶命の中、義勇は「邪魔」の一言で、戦闘を一瞬で終わらせ、実弥達は気づいたらベッドの上で全て終わっていた。柱合会議際に、その件で話しかけたら義勇は何も覚えていなかった。柱の格の違いを見せつけられた出来事であると同時に原作のような関係性が出来上がった\n・煉獄兄弟と伊黒は、蛇鬼の件〜二人が隊士になるまで世話をしているため、顔馴染み。槇寿郎は義勇が苦手(散々尻拭いをさせられた義勇がブチ切れてのした)だが、上弦の弐の戦闘後、義勇が入院中の時は、屋敷にいる子供たちの世話をした。宇髄と伊黒の育手を義勇と一緒に探している。\n・宇髄は元弟子。鬼殺隊に入隊前、追手に追われていたところを義勇が助けた。その時に鬼殺隊のことを教えてもらい、入隊したが、誰も育手になる人がおらず、義勇が引き取った。義勇は宇髄達を何もおぼえておらず悲鳴嶼のほうが覚えていた。宇髄はまともな育手（呼吸を教える人）に巡り会えずたらい回しにされていたため、やさぐれて、鬼殺隊を見限っていた。義勇の元に来たあとは、毎日逃げ出したくなるような鍛錬と真菰(娘)と錆兎（義息子）に負け続けたことから、プライドがへし折られたが、宇髄の中では、大切な思い出になっている。お嫁さんたちは、宇髄が柱になるまで、義勇の屋敷にいた。今でも、通っている(一緒に暮らそうと画策中)\n・伊黒と宇髄は認めてはいないが父親のように思っている。初めて子供扱いされ、おんぶと抱っこされた。悲鳴嶼も同様（こっちは父だと思っている）\n・料理が上手い。蜜璃と煉󠄁獄は出禁になったことがある。伊黒は義勇とサシの時のみ人前で食事をする。\n・男女共にえらくモテる上に、あちこちで初恋キラーしてるが、仕事一筋と天然なことから本人自覚なし\n・産屋敷の五つ子たちに大きくなったら結婚しようと言われたことがある。耀哉も当主就任時から手足となり支えてもらい、第二の父親のような存在\n・煉獄愼寿郎が、冨岡義勇を後妻に迎えようとしている噂を拾った杏寿郎＋柱が、その真偽を確かめようとしたことがある。実際は、義勇は瑠火といとこ同士。鬼殺隊に入った義勇を愼寿郎が気にかけていただけ。その時に、杏寿郎は義勇との関係性を知った\n\nという上記の設定を含めて\n冨岡義勇(36歳)は元柱で、悲鳴嶼は元継子という設定。設定としては、遊郭編の世界線で、宇髄の担当地区で潜入調査をしていた義勇が、尻尾を掴ませるために囮調査をして、出てきた上弦の陸を天元やかまぼこ隊と協力して倒す話をお願いします", "nc": 0, "word_count": 20920, "transcoder": "text", "creator_acceptable_same_genre": true}, {"path": "/@yawayawe/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "novel", "tipped": false, "creator_id": 1782250, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/b9296074/uploads/origins/f3cf0ed7-1198-40bc-9c20-49c53c736cc2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fa3095708634c0ea1a423f6d07dbffe4", "srcset": "https://si.imgix.net/b9296074/uploads/origins/f3cf0ed7-1198-40bc-9c20-49c53c736cc2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fa3095708634c0ea1a423f6d07dbffe4, https://si.imgix.net/b9296074/uploads/origins/f3cf0ed7-1198-40bc-9c20-49c53c736cc2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a6f10f6c0fb155f269712f9a2cb791d3 2x, https://si.imgix.net/b9296074/uploads/origins/f3cf0ed7-1198-40bc-9c20-49c53c736cc2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=580ed29771b636f2ae3ee31b8754bbab 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/b9296074/uploads/origins/f3cf0ed7-1198-40bc-9c20-49c53c736cc2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f1f14d8cb6524dd6dd5d441dcfc2862d", "srcset": "https://si.imgix.net/b9296074/uploads/origins/f3cf0ed7-1198-40bc-9c20-49c53c736cc2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f1f14d8cb6524dd6dd5d441dcfc2862d, https://si.imgix.net/b9296074/uploads/origins/f3cf0ed7-1198-40bc-9c20-49c53c736cc2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=c690bdba18238c999c37a43c90d29af2 2x, https://si.imgix.net/b9296074/uploads/origins/f3cf0ed7-1198-40bc-9c20-49c53c736cc2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=4e9ab125fc66440fec4df43f01e60b54 3x"}, "body": "鬼滅の刃をお願いします\n冨岡義勇の設定は\n①鬼舞辻󠄀無惨が初めて鬼した鬼\n②継国縁壱に出会うまで、眠り続けていた\n③起きた後もほとんど寝ているが、時々目覚めては、人とあっていた。眠っていても世情は把握できる\n④普段は3〜5才位の姿（知能は高いが精神年齢は幼女並）だが、戦うときは21歳の姿になる。その姿になったのは、縁壱の時と原作始まってから、その姿のほうが原作寄\n⑤強さは、上弦以上（師範は縁壱）\n⑥無惨の呪いはなく、日光も平気\n⑦血鬼術は水を用いた物。鬼の毒や産屋敷の呪いも消せる治癒系の血鬼術を保有\n⑧⑫と⑦の力で煉獄瑠火の病や鬼になった母親に傷つけられた不死川兄弟も助けている。一時期、煉獄家と実弥は義勇を匿っていた\n⑨悲鳴嶼も鬼の襲撃時に助けられているが、盲目のため、カナエの件があるまで、鬼だとは判らなかった\n⑩錆兎が水柱（現存では一番の仲良し）。童磨襲撃時以降、同居中\n⑪無惨と珠世は義勇と面識はあるが①〜⑦の事を知らない。無惨が義勇が鬼になっていることを知ったのは、那谷蜘蛛山編の時。\n⑫人であった頃は典薬寮で医師として働いていた。産屋敷家筋の傍流の出身で、無惨とは腐れ縁（義勇記憶なし）\n⑬義勇は末っ子気質の無自覚天然ドジっ子で、合う人全てを過保護にする製造機状態。柱達によく丸め込まれて抱っこされている。義勇自身は長男気質のしっかりものだと思っている\n\n\n以上を踏まえて、上弦の弐との戦闘時にカナエが死を覚悟したときに寝起きの義勇に助けられる。カナエはどうせ食べられるなら、子鬼（義勇）に食べられたいと考えていて、戦闘後、眠ってしまった義勇を抱きかかえていたら、日の出がきたので、そのまま一緒に死のうとしていた。実際は義勇の血鬼術で、カナエは傷は深いが命の別状はなかったし、義勇は日光は効果なしなので、そのまま爆睡。日に当たっても消滅しない義勇を見て、しのぶが来るまで、思考停止していた。その後、陽光に当たらないよう大慌てで羽織でくるんで、蝶屋敷に連れて行った。\nその後に柱合会議で他の柱に合う所と無惨と義勇が再開する話をお願いします\n金額を間違えたので、再送しました。検討お願いします", "nc": 25, "word_count": 33986, "transcoder": "text", "creator_acceptable_same_genre": true}, {"path": "/@yawayawe/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "novel", "tipped": false, "creator_id": 1782250, "client_id": 1947725, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/d03c5036/uploads/origins/da56cf19-49b2-4187-8e4c-9f090b6ace24?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8a4603068216ad145f2acd9e316a36ff", "srcset": "https://si.imgix.net/d03c5036/uploads/origins/da56cf19-49b2-4187-8e4c-9f090b6ace24?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8a4603068216ad145f2acd9e316a36ff, https://si.imgix.net/d03c5036/uploads/origins/da56cf19-49b2-4187-8e4c-9f090b6ace24?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=0e8c0e6472637696f0c08a2bd51b9f17 2x, https://si.imgix.net/d03c5036/uploads/origins/da56cf19-49b2-4187-8e4c-9f090b6ace24?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e2af0a3a550bcd503cdd7d7524750cfb 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/d03c5036/uploads/origins/da56cf19-49b2-4187-8e4c-9f090b6ace24?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=20f1bf78810593f73d2e34954012bed1", "srcset": "https://si.imgix.net/d03c5036/uploads/origins/da56cf19-49b2-4187-8e4c-9f090b6ace24?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=20f1bf78810593f73d2e34954012bed1, https://si.imgix.net/d03c5036/uploads/origins/da56cf19-49b2-4187-8e4c-9f090b6ace24?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=151228c46ff691b6f130952f712f9218 2x, https://si.imgix.net/d03c5036/uploads/origins/da56cf19-49b2-4187-8e4c-9f090b6ace24?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=7c633b9c05a1672f9cec435f01ecaee2 3x"}, "body": "鬼滅の刃。\n原作軸の世界観で、柱合会議の時に産屋敷耀哉の実妹であることがばれる話。\n産屋敷の血筋による予知能力を持っていて、その力を使って他の柱達を直接救済している。不死川家と時透家は家族ごと救済してください\n産屋敷家は過保護過ぎる保護者＆シスコンだといいです\n原作そのままで、中身も姿かたちも変更なし\nゲスメガネ（裁縫係の前田）が好きなので、その話を入れてくれたらありがたいです。\n\nTwitterを見て、とても面白かったので、再度書き直しました。よろしくお願いします", "nc": 9, "word_count": 32237, "transcoder": "text", "creator_acceptable_same_genre": true}, {"path": "/@yawayawe/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1782250, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/c658f7d2/uploads/origins/d41bc2bb-5a51-4ad4-a865-1edbaf490da8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7ae43cbec8e09be4cfbe888eef6a34a1", "srcset": "https://si.imgix.net/c658f7d2/uploads/origins/d41bc2bb-5a51-4ad4-a865-1edbaf490da8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7ae43cbec8e09be4cfbe888eef6a34a1, https://si.imgix.net/c658f7d2/uploads/origins/d41bc2bb-5a51-4ad4-a865-1edbaf490da8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b2d7851cb96f462b25f9c3bd0d24178e 2x, https://si.imgix.net/c658f7d2/uploads/origins/d41bc2bb-5a51-4ad4-a865-1edbaf490da8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=28a1b9fbb201146fd5d91a0aaf975d71 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/c658f7d2/uploads/origins/d41bc2bb-5a51-4ad4-a865-1edbaf490da8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=7eee0ec83371fab01fe311f93f531b01", "srcset": "https://si.imgix.net/c658f7d2/uploads/origins/d41bc2bb-5a51-4ad4-a865-1edbaf490da8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=7eee0ec83371fab01fe311f93f531b01, https://si.imgix.net/c658f7d2/uploads/origins/d41bc2bb-5a51-4ad4-a865-1edbaf490da8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=38039f0e31eb673d070d54922343b983 2x, https://si.imgix.net/c658f7d2/uploads/origins/d41bc2bb-5a51-4ad4-a865-1edbaf490da8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=504911aff7a2d2aaadc09bd9cd376297 3x"}, "body": "はじめまして！\n\n柔硬さんの人物画で作業の合間になごみたいので、依頼させていただきます。\n\n【第一希望】\n街中を歩く、もしくはどこかで休憩する冨岡さん\n大正or現パロなど、シチュエーションはお任せします。\n\n版権ものがNGな場合は【第二希望】の絵でお願いします。\n\n【第二希望】\n大正時代、もしくは現代の街中のどこかで休憩中の和服姿の人物\n性別や年齢等はお任せします。\n\n抽象的すぎかもしれませんが、ほっと一息いれられるような感じで描いていただければ大変ありがたいです。\nどうぞよろしくお願いいたします。\n\n追伸：柔硬さんの二次創作がきっかけで鬼滅の刃にハマりました。\nありがとうございます。", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@yawayawe/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1782250, "client_id": 639771, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/c1b73f78/uploads/origins/ecb86183-ed63-44a8-9f3e-ced30c76e99b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=dc98d42dc14eba6c41681f633769480b", "srcset": "https://si.imgix.net/c1b73f78/uploads/origins/ecb86183-ed63-44a8-9f3e-ced30c76e99b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=dc98d42dc14eba6c41681f633769480b, https://si.imgix.net/c1b73f78/uploads/origins/ecb86183-ed63-44a8-9f3e-ced30c76e99b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=1d8674bb7299faa12a9b36e7c9117ebc 2x, https://si.imgix.net/c1b73f78/uploads/origins/ecb86183-ed63-44a8-9f3e-ced30c76e99b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=55a49edc80384375d330b4a07cc83f66 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/c1b73f78/uploads/origins/ecb86183-ed63-44a8-9f3e-ced30c76e99b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=717345ff8af222164001aa327d60703e", "srcset": "https://si.imgix.net/c1b73f78/uploads/origins/ecb86183-ed63-44a8-9f3e-ced30c76e99b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=717345ff8af222164001aa327d60703e, https://si.imgix.net/