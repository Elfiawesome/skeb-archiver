00&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=0a87c2c9180a5f489030cb00e9a75f74", "src_set": ""}, "private": true, "genre": "art", "tipped": false, "creator_id": 3114788, "client_id": 2684242, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 0, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@ochamamemame/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3114788, "client_id": 2684242, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/c4ea7a45/uploads/origins/c3befce1-c614-46b5-962b-26258f60d442?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=17df9bd42619f0a81a38f52db1fe19bc", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/c4ea7a45/uploads/origins/c3befce1-c614-46b5-962b-26258f60d442?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0285567069ac96509dccf24b86d86cd2", "src_set": ""}, "body": "skeb失礼します。\nこの度、おちゃまめ様にクトゥルフ神話TRPGの自探索者を描いていただきたく、リクエストを送らせていただきました。\n\n\nリクエストさせていただきたい探索者の詳細ですが、\n■名前…魅守 刀夜(みかみ とうや)\n■性別/年齢…男/33歳\n■髪色…黒髪、右側青メッシュ\n■瞳色…青〜水色系統\n■装飾品…左耳にピアス\n■特徴…目の下に青みがかった隈\n■性格…人に自分から絡みにいかないタイプ\n■通過シナリオ…邪神のクオリア(画像名は邪神課と記載)、GODARCA\n■備考…邪神のクオリア→コンバートでGODARCA、その後現代コンバート済み。その為、服装はどの服装でも可(添付画像に無い服装でもお好きに着せてください)。邪神課及びGODARCAはシナリオ規定の衣装となっております。\n\n■納品画像についての希望ですが、背景有無に関わらず背景透過verもつけていただけるとありがたいです。\n■イラストの使用用途に関して。描いていただいたイラストはSNSへの投稿、アイコン等への使用などさせていただく場合があります。\n\n\n□立ち絵制作時期が離れているのと参考資料の意味を含め、URL先に複数枚画像添付済みです。\n□skeb依頼不慣れ+Googleドライブでの共有が初なため、不手際ありましたら申し訳ありません。\nご検討いただけますと幸いです。\n\nhttps://drive.google.com/drive/folders/1pxQ7aY0EHB172jB4o1AGRCDIULEYfTFA?usp=sharing", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {