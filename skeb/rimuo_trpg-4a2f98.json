月の髪飾り\n・表情：画像参照\n・キャラ詳細：夜桜の魔法使い\n・イメージカラー：桜ピンクと水色\n※パステル系\n\n\nお忙しいかと思いますがご依頼のご検討、よろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/1Fx6aKVBgUZHmECEgl9475xAPb0yKcaRK?usp=drive_link", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@rimuo_trpg/works/13", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/87035caa/uploads/origins/39964e91-06c4-4a66-8c85-0f4edcc509bc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=df6a4ff82dd3005350ac1e743a0d4a9d", "srcset": "https://si.imgix.net/87035caa/uploads/origins/39964e91-06c4-4a66-8c85-0f4edcc509bc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=df6a4ff82dd3005350ac1e743a0d4a9d, https://si.imgix.net/87035caa/uploads/origins/39964e91-06c4-4a66-8c85-0f4edcc509bc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=8db4740080c0137ff2ff8262a2fc2c94 2x, https://si.imgix.net/87035caa/uploads/origins/39964e91-06c4-4a66-8c85-0f4edcc509bc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=6729ca514023130ac77d6913b4d96874 3x"}, "private": true, "genre": "art", "tipped": false, "creator_id": 3017589, "client_id": 3593274, "nc": 144}, {"path": "/@rimuo_trpg/works/12", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/137549f9/uploads/origins/3292e1b0-71de-42c3-81cc-10edd60a467d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=001d978f78fdcb8121b4fd1ec8fb7b71", "srcset": "https: