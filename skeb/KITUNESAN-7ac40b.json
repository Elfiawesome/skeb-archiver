200&h=200&blur=200&s=6b813a766da7267cd569ad2502a683e7", "srcset": "https://si.imgix.net/b265afb3/uploads/origins/7c94d13e-e89c-46a4-8e3a-1a87ca5714d0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6b813a766da7267cd569ad2502a683e7, https://si.imgix.net/b265afb3/uploads/origins/7c94d13e-e89c-46a4-8e3a-1a87ca5714d0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=c70eb38ef354772957be9a03510baadb 2x, https://si.imgix.net/b265afb3/uploads/origins/7c94d13e-e89c-46a4-8e3a-1a87ca5714d0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=85e7f17beb27d14dd07ad1e28ea08565 3x"}, "body": "きつねさんの世界観が大好きで\nきつねさんにぜひ描いて頂きたく\n今回リクエストが解放されたので\n思い切ってお願いしてみました。\nぜひぜひ、引き受けて下さると嬉しいです。\n\n【使用用途】\nアイコン等の使用\n\n【希望】\n・レオ君の教会の世界観で働くシスター\n・18号さん(X:@_18go )みたいな\n     センター分けゆるふわロングヘアー\n　髪色はお任せします\n・色白\n・タレ目\n・二の腕が細い・グラマー・美脚\n・武器を持たせて下さい\n・可能であれば返り血差分もお願いしたいです\n\nhttps://www.animatetimes.com/news/details.php?id=1717744899&image_share=1", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@KITUNESAN/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3889500, "client_id": 3887959, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/6ae9f57d/uploads/origins/fa59b37b-1a1d-4fcd-b331-6b23a6a0d6c5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2e6f50c33a6824e4a69928d62fb294a3", "srcset": "https://si.imgix.net/6ae9f57d/uploads/origins/fa59b37b-1a1d-4fcd-b331-6b23a6a0d6c5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2e6f50c33a6824e4a69928d62fb294a3, https://si.imgix.net/6ae9f57d/uploads/origins/fa59b37b-1a1d-4fcd-b331-6b23a6a0d6c5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ce7296d9bd56547ba439032ca0ef67b5 2x, https://si.imgix.net/6ae9f57d/uploads/origins/fa59b37b-1a1d-4fcd-b331-6b23a6a0d6c5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=29aa171e28ffb89e1dddfff6ea83a057 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/6ae9f57d/uploads/origins/fa59b37b-1a1d-4fcd-b331-6b23a6a0d6c5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=50db4b8e6621fa7ee2392729ba6ffbd9", "srcset": "https://si.imgix.net/6ae9f57d/uploads/origins/fa59b37b-1a1d-4fcd-b331-6b23a6a0d6c5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=50db4b8e6621fa7ee2392729ba6ffbd9, https://si.imgix.net/6ae9f57d/uploads/origins/fa59b37b-1a1d-4fcd-b331-6b23a6a0d6c5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=56da10b11c1c861667ce7fc0e64ded9c 2x, https://si.imgix.net/6ae9f57d/uploads/origins/fa59b37b-1a1d-4fcd-b331-6b23a6a0d6c5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=7386fdd338a41661388dbc04be5761ad 3x"}, "body": "はじめまして。\nきつねさんの絵が大好きで、ぜひ描いていただきたくリクエストをお送りいたしました。\nオリジナルキャラクターはいないため、以下の特徴をもとにきつねさんの解釈で描いていただけますと嬉しいです。\n\n【特徴】\n・髪型：高めのツインテール（胸下くらいの長さ）\n　または高めのハーフツイン（おへそあたりの長さ）\n・髪色：黒髪＋紫のインナー\n・アクセサリー：白いぽんぽん or 黒リボン（なくても可）\n・指輪：左薬指にシルバーのリボンモチーフ、右薬指にシルバーの細めリング\n・ネイル：長めで痛ネイル風\n・メイク：地雷メイク系（垂れはねアイライン）\n・服装：LIZ LISA系、丈短めスカート\n\n表情や構図はおまかせいたします。\nSNSアイコンやスマホの待ち受けとして使用させていただきたいです。\n内容が合わない場合はキャンセルしていただいて問題ございません。\nご検討のほどよろしくお願いいたします。", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@KITUNESAN/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3889500, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/d1a60b03/uploads/origins/025b5a96-f053-4915-bb81-aa879a9cf811?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=46840bc1b8dff76d353f06e56500babe", "srcset": "https://si.imgix.net/d1a60b03/uploads/origins/025b5a96-f053-4915-bb81-aa879a9cf811?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=46840bc1b8dff76d353f06e56500babe, https://si.imgix.net/d1a60b03/uploads/origins/025b5a96-f053-4915-bb81-aa879a9cf811?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=992e32776082b90cff71e656e6d7abe1 2x, https://si.imgix.net/d1a60b03/uploads/origins/025b5a96-f053-4915-bb81-aa879a9cf811?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=dbf21ef0a4243337a73d85fa2ac75050 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/d1a60b03/uploads/origins/025b5a96-f053-4915-bb81-aa879a9cf811?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=fdbc6ab5348e30c953985b20305c3315", "srcset": "https://si.imgix.net/d1a60b03/uploads/origins/025b5a96-f053-4915-bb81-aa879a9cf811?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=fdbc6ab5348e30c953985b20305c3315, https://si.imgix.net/d1a60b03/uploads/origins/025b5a96-f053-4915-bb81-aa879a9cf811?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=7557eddd79e72e74aa0fcb5481957b5e 2x, https://si.imgix.net/d1a60b03/uploads/origins/025b5a96-f053-4915-bb81-aa879a9cf811?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=fbdc7094adabc34ce369668ea96a2ca7 3x"}, "body": "こんにちは！\nきつねさんのイラストが大好きなので、リクエストさせていただきます。\n\n【内容】\n推しをイメージしたアイコン用イラストをお願いしたいです。\n推しが2人おり、どちらも「月」がモチーフに入っているため、イラストにも月の要素を取り入れていただけると嬉しいです。\n・1人目：月と十字架がモチーフ\n・2人目：犬と月がモチーフ\n\n構図や服装などのデザインは、きつねさんのセンスにお任せいたします！\nまた、可能でしたら\n・右目の下にほくろ\n・外ハネボブのセンター分け\nを取り入れていただけますと幸いです。\n\nご検討のほど、よろしくお願いたします。\n\nhttps://photos.app.goo.gl/95Emk7u4SM9JnAc7A", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@KITUNESAN/works/3", "private_thumbnail_image_urls": null, "private": false, "