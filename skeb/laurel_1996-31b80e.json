うですが、必要な時には真剣になります。あなたが描く大きな胸の表現がとても好きなので、可能であれば胸を大きく描いてください！お好きなNSFWなシチュエーションで描いていただけると嬉しいです。\n衣装はお好みで変更ください。バニースーツやメイド服などセクシーなものが良いです。制服でも構いません。可能であれば、背景透明版もお願いします。PSDデータも大変助かります。SNSで使用する予定で、もちろんクレジットは記載します。ご検討いただきありがとうございます！https://imgur.com/a/KDDabOv", "nc": 57, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@laurel_1996/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3873771, "client_id": 639858, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/f15ceeb0/uploads/origins/2a1965b0-5e2f-4e28-b2e1-0a46ac9329f8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9a69b5929fad5f8956c4d60206e21483", "srcset": "https://si.imgix.net/f15ceeb0/uploads/origins/2a1965b0-5e2f-4e28-b2e1-0a46ac9329f8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9a69b5929fad5f8956c4d60206e21483, https://si.imgix.net/f15ceeb0/uploads/origins/2a1965b0-5e2f-4e28-b2e1-0a46ac9329f8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f16f50db8d2f9dea688c9b5356036adb 2x, https://si.imgix.net/f15ceeb0/uploads/origins/2a1965b0-5e2f-4e28-b2e1-0a46ac9329f8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=92dc8fc23224bc0e254e01da5cb98cba 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/f15ceeb0/uploads/origins/2a1965b0-5e2f-4e28-b2e1-0a46ac9329f8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=aef4a8b40857ff77d15181fd71dbb55c", "srcset": "https://si.imgix.net/f15ceeb0/uploads/origins/2a1965b0-5e2f-4e28-b2e1-0a46ac9329f8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=aef4a8b40857ff77d15181fd71dbb55c, https://si.imgix.net/f15ceeb0/uploads/origins/2a1965b0-5e2f-4e28-b2e1-0a46ac9329f8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&c