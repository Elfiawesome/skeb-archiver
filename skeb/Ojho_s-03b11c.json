n「ふふん、しょうがないですね〜！」\n「嬉しい？嬉しいですか？ふふ、そうでしょうそうでしょう！」\n「ふふん、ようやく活躍できる機会が来ましたね。今回は絶対に！ヘマなんて！しないんだから！！」\n「え～、そんなコトもできないんですか？それでも同じアンドロイド？笑っちゃいますね」\n「う、うるさい……！アタシだって、好きでこうなってるワケじゃないんですよ…！！」\n「アナタがそう言うなら…別にやってあげないこともないですケド…」\n\nhttps://imgur.com/a/Hl50KRe", "nc": 48, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "similar_creators": [{"id": 1251178, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "白くまʕ•ᴥ•　ʔ", "screen_name": "shirokuma_224", "avatar_url": "https://pbs.twimg.com/profile_images/1935257039753584640/QgziBeDv.jpg", "header_url": "https://pbs.twimg.com/profile_banners/808192202048274432/1620770434/1500x500", "appeal_receivable": true, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 120, "skills": [{"genre": "art"}, {"genre": "comic"}], "nc": 17}, {"id": 2825233, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "沼野ぬー☆絵描き", "screen_name": "swampstar77gat", "avatar_url": "https://pbs.twimg.com/profile_images/1774659191497773056/a2syD8sU.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1677574743510376450/1755856007/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "art"}, {"genre": "correction"}], "nc": 128}, {"id": 2853061, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "ディモ/サブ垢", "screen_name": "Dim0_00", "avatar_url": "https://pbs.twimg.com/profile_images/1979080513177464834/MdhoJqw_.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1676732751570165761/1760682536/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "delet