r=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=f74eff790166baf536f085159da8f3c1", "src_set": ""}, "private": true, "genre": "art", "tipped": true, "creator_id": 3218284, "client_id": 0, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 49, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@amamidare7/works/8", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3218284, "client_id": 0, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/6b2d4a12/uploads/origins/0e8c68f8-6cd1-43aa-adbe-06a17e88e4f3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=624a823cedb182b2fd7c69f386bc0c4c", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/6b2d4a12/uploads/origins/0e8c68f8-6cd1-43aa-adbe-06a17e88e4f3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=946e0b4b564ef7f0fd4dab8bc0a13c1f", "src_set": ""}, "body": "初リクエストです。Skebで絵柄が可愛いイラストレーター様を探していた所、ものすごくクオリティが高くエッチなamamidare様のイラストを見つけまして、Xで複数イラストも拝見し完全に自分にドストライクな絵柄、シチュでしたので是非リクエストさせて頂こうと思いました。\nよろしければお願い致します。\n\namamidare様が描かれた戸鎖くくり様のイラストhttps://skeb.jp/@amamidare7/works/3が物凄く可愛かったので続きのような感じの本番行為のイラストをお願い致します。\n\n詳細：\nXで投稿されていたイラストhttps://x.com/amamidare7/status/1837431577585885193/photo/1の構図、アングルで両胸を鷲掴みで揉みしだきながら(乳首は見えるように)中だしされてるシチュをお願い致します。\n竿役はくくり様の顔の隣でハァハァと興奮した表情でお願いします\n精液量は多めで溢れ出て流れ落ちてる感じでお願いします\nまたスペースに余裕がありましたら、結合部アップで中だし描写がハッキリ見えるコマも欲しいです\n差分は射精前、射精中、射精後をお願いしたいですが可能でしょうか？\n厳しければ射精中のみでもOKです\nまた、台詞や擬音も可能でしたらお願いします。\n甘々な感じで中だしを求めてるような台詞、竿役も可能でしたら快感に浸ってるような台詞があると最高です\n\n希望が多く細かいですがよろしければご検討頂けると大変嬉しいです。", "nc": 48, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@amamidare7/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3218284, "client_id": 1166552, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/b6545c2a/uploads/origins/40124b36-edc2-4a5c-80f7-dc3de1c1c89f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=324b48a014808670a655efd50e78ce70", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/b6545c2a/uploads/origins/40124b36-edc2-4a5c-80f7-dc3de1c1c89f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=34b71e3d1775015e43f897f110454ba4", "src_set": ""}, "body": "こんにちは\n前回あかぴゃではお世話もなりました。\n\n募集開いている間にイディオスでまた誰かお願いしたいなと思いまた来ました\n今回は鏑木ろこさんでお願いしたいです。\nhttps://x.com/65_kaburaki\n\n新衣装のほうでお願いします\nhttps://www.youtube.com/live/lAaXQkSXNBQ?si=Bu680rkk1WWfdm8-&t=1731\nhttps://x.com/lq_saku/status/1694699166000464119\nアウターやエプロンは無しでお願いします。帽子はどっちでもいいです\n\nサロペットの金具を外して、前にめくれるような感じにしていただいて\n中のTシャツをたくし上げて手ブラしてるような感じでお願いしたいです。\n下着は一緒にずり上げてもらうなり、無しにするなり描きやすい形にしていただけると助かります。\n恥ずかしがって顔を逸らしてるような感じにしていただけると嬉しいです。\namamidare様の描かれる乳首好きなんですが、手ブラしている以上見えるの変か？という感じもあるのでこの辺もお任せします。\n\n体勢は膝立ちとか寝転がらせるとか何か良い感じにしていただけると助かります。\n座り姿勢は本人が↓こんな感じの男前な座り方しそうでなんかエッチではない気がするので、できればナシでお願いします。\nhttps://www.youtube.com/live/H3as7fTAZec?si=HWvFTt-z-ru_DTbf&t=4590\n\nここまで書いておいてなんですが、「ろってぃのエチ絵描いてもらいたい」「でも衣装半脱げにしにくい」\nでこういうリク文になっているだけなので、amamidare様のほうでろってぃのエチ絵ならこれが描きたいというものがあれば、ご自由に描いていただいても構いません。\n\n前回同様結合具合などおまかせしますが、PSDで納品していただけると嬉しいです。\n\n大変お忙しいとは思いますが、描いて頂けると嬉しいです。\nお願いしている内容的に金額不足の場合、金額での再送要請をしていただけると助かります。\nご検討宜しくお願い致します", "nc": 176, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@amamidare7/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3218284, "client_id": 3342082, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/ad5b2b4e/uploads/origins/cf201935-d974-4e22-963c-9ee1784ac60b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=148cbf8a5e4c140b050df5784cc3f20b", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/ad5b2b4e/uploads/origins/cf201935-d974-4e22-963c-9ee1784ac60b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d6bc16f92d26367869dd6583067ed974", "src_set": ""}, "body": "こんにちは、私のVTuberキャラクターの絵をお願いしたいのですが。\n彼女は人間の耳を持っていて、サキュバスの角、翼、尻尾を持っています。\n\n上着を脱いで、尻尾でショーツを脱いでいるところを描いてくれませんか？\nまた、彼女の胸とショーツに精液がたくさんついていて、表情が変わっているバージョンもお願いします。\n\n参考画像はURLにあります。\nありがとうございました！\n\nhttps://drive.google.com/file/d/1K8zZReM_tQBbnD3Hq9d1riedzwrsO2lR/view", "nc": 161, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@amamidare7/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3218284, "client_id": 1906848, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/d185b2ff/uploads/origins/2dac31b5-0d5e-4a78-834a-118ec00d0190?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=40872749556d7947b3e5070aa38321a7", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/d185b2ff/uploads/origins/2dac31b5-0d5e-4a78-834a-118ec00d0190?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=69a3fd314c83a9e65ead2490aceef2ad", "src_set": ""}, "body": "初めまして\n版権から可能であれば依頼申し上げます\nキャラはＦＥよりシーダ（小さな島国の王女）\nhttps://twitter.com/RAMU_INU/status/1514222215876669442/photo/1\n\n入浴中にタオルが透ける状況をお願いします（↓下記参照）\nhttps://tadaup.jp/472827fe.png\n\n手間でなければ剣の鞘または畳んだ衣類を近くに配置\n上記以外の詳細はお任せします\nキャラ･内容など困難でしたらキャンセルください", "nc": 176, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@amamidare7/works/4", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/bf92d1cd/uploads/origins/792c2a46-5dd5-413f-804b-b9884a2fbb85?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=380aacda5c21d4d67efba1bde0e91afd", "src_set": ""}, "private": true, "genre": "art", "tipped": false, "creator_id": 3218284, "client_id": 114302, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 177, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@amamidare7/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3218284, "client_id": 2519213, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/853e4689/uploads/origins/e0d2c24f-b70a-4903-9377-0ad6b5a0784a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5874327c7583997d77f65cdc1fa36570", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/853e4689/uploads/origins/e0d2c24f-b70a-4903-9377-0ad6b5a0784a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d89b3a0100384e2777cea2e6119fdc3a", "src_set": ""}, "body": "amamidareさん\n\nはじめまして！\nhttps://x.com/amamidare7/status/1831995765624902062\nを拝見しまして、アイシャドウが素敵でかわいく整ったお顔を描かれる一方、\nチラ見せな乳首や男性器の描き方にどこかしらこだわりを感じたので依頼させてください。\n(シチュも癖に刺さりましたし、その他の作品もすごくよかったです)\nSkebされていないのかなと思っていたら、まさか新着クリエイターに乗っていたので喜びの気持ちでリクエスト文を書かせていただいています。\n\n今回は私の推しである個人vtuberの 戸鎖くくり さん(https://twitter.com/tokusari_kukuri)の\nNSFWなFAをお願いしてもいいでしょうか？\n\n■参考\nhttps://x.com/tokusari_kukuri/status/1763532133950542144\n\n■イメージ\n可愛く透き通った声で、歌うことが好きな子です。\n根は優しく気遣いですが、よく慌てたり笑ったり、調子に乗って口が悪くなったりとっても可愛く愛らしい性格をしています。\n配信は歌枠(めちゃ上手い)とASMR中心で、不定期にゲーム配信をやっています。\nまた、お酒も好きでよく飲んでたりします。\n\n■構図\n衣装・シチュエーション等お任せいたしますが\nおっぱいがちらりと見える、とてもえっちな感じでお願いします。\n\n■用途\n個人鑑賞および(大事な所は隠した上で)Xのヘッダー、アイコンで利用させて頂くかもしれません。\nまた、もしかしたら本人の活動（YouTubeのサムネイル、Xでの投稿等）で使用する可能性もあります。\n可能であれば人物・背景がレイヤー分けできるpsd形式を頂けますと幸いです。\n\n以上、何卒よろしくお願いします。", "nc": 160, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@amamidare7/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3218284, "client_id": 1166552, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/2a34ccc1/uploads/origins/efc92ad4-2227-45c1-bc6f-cc2d6d59bd0b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b46883d7996c1e5dff8682dacdea3446", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/2a34ccc1/uploads/origins/efc92ad4-2227-45c1-bc6f-cc2d6d59bd0b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a1f0478199ad8b0a85f0fbd21919001d", "src_set": ""}, "body": "こんにちは\n\n新着クリエイターでおみかけして、めっちゃエッチでいいなと思いリクエストさせていただきました。\n\nイディオスのイラストとってもいいなと思ったので、にじさんじ所属の獅子堂あかりさんを描いていただきたいです。\nhttps://x.com/44do_akari\nhttps://x.com/44do_akari/status/1616424231117684736\n\n以前「あかりにエロを感じてたらすごすぎる」とご本人は言っていたんですが、普通にえっちだよねと思うのでよろしくお願いしたいです。\nhttps://www.youtube.com/live/3BELrCXSev0?si=Q1aoJghnkUhdAkQI&t=10749\n\nデフォルト衣装のスポブラ？をずり上げて胸が露出するような形で後ろから挿入されているようなイラストでお願いしたいです。スポブラ以外の脱げ具合はおまかせします。\n後ろからであればどんな体勢でも大丈夫です。\n\n構図や作業量的に無理が無ければ、「長時間ハメ倒されてるような描写」がほしいので\nエナドリの空き缶や使用済み・未使用のゴムが散乱している描写をお願いしたいです。\n\n結合具合などおまかせしますが、PSDで納品していただけると嬉しいです。\n\n大変お忙しいとは思いますが、描いて頂けると嬉しいです。\nお願いしている内容的に金額不足の場合、金額での再送要請をしていただけると助かります。\nご検討宜しくお願い致します。\n\nhttps://wikiwiki.jp/nijisanji/%E7%8D%85%E5%AD%90%E5%A0%82%E3%81%82%E3%81%8B%E3%82%8A#model", "nc": 57, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@amamidare7/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3218284, "client_id": 61245, "vtt_url": null, "thumbnail_image_urls": {"src": "htt