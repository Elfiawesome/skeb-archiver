ければと思います。\n\n\n■用途\n\n・個人観賞用のグッズの作成\n・ただのきのこ様の名前を明記したうえでのSNSのアイコンやヘッダーへの使用\n\n金額に不足があれば再送お願い致します。\nご検討の程宜しくお願い致します。", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 462551, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "あまがさなだめ", "screen_name": "amagasa_nadame", "avatar_url": "https://pbs.twimg.com/profile_images/1585253581661540354/SDzp6znH.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1178739606822408193/1667481969/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 20, "complete_expiration_days": 60, "skills": [{"genre": "art"}], "banned": false, "nc": 160}, {"id": 728716, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "🍰", "screen_name": "O_kashi115", "avatar_url": "https://pbs.twimg.com/profile_images/2065143276563529728/YTYCc0KJ.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1059104976763445248/1650758576/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 10, "complete_expiration_days": 30, "skills": [{"genre": "art"}], "banned": false, "nc": 17}, {"id": 2063435, "creator": true, "nsfw_acceptable": false, "acceptable": false, "name": "なじ︎︎まる🌷", "screen_name": "najimaru_0228", "avatar_url": "https://pbs.twimg.com/profile_images/1955801996864503808/tu-V9SEE.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1072710295888351232/1764167294/1500x500", "appeal_receivable": true, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 20, "complete_expiration_days": 70, "skills": [{"genre": "art"}],