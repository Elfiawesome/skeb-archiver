rop=top&w=200&h=200&s=0ee92936b73ffce7d320559f2ba54c5a", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/3d1349c7/uploads/origins/5cf0b07c-336e-41ef-99b9-f8f6bd956f49?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=62c4f64d11196f223e24e898d4f55b70", "src_set": ""}, "body": "はじめまして。\nFGOの藤丸君のカッコよかったり可愛かったりなイラストを拝見して是非にと思いリクエスト差し上げました。\n\n本編開始前は恐らく都内在住の高校生だったと思われるので、藤丸君の学生生活のひとコマをお願いしたく存じます。\nシチュエーションとしては体育の授業で柔道をしているところで、表情やポーズ等はおまかせいたします。\n\nご検討くださいましたら幸いです。\nよろしくお願いいたします。", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@shintyoi2/works/70", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2706166, "client_id": 62494, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/d4e4cd0b/uploads/origins/070c8b0c-32a4-48b0-8f9b-1934ec7a350d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1c73c22866419dee6985359f6470e49c", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/d4e4cd0b/uploads/origins/070c8b0c-32a4-48b0-8f9b-1934ec7a350d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=70a07249c1a8f7fdfe36b56bc1d1fff6", "src_set": ""}, "body": "初めまして、ちょいしんさんの可愛らしいイラストを拝見してリクエストさせていただきました。\n\nリクエスト内容ですが、FGOのイラストを2コマ分割した感じで描いていただきたく。\n\n1コマ目はハベトロットが明るい表情で花嫁衣装を裁縫しているところ\n2コマ目はメディアリリィが病んだ表情で花嫁衣装を裁縫しているところ(神話にて、恋敵に着ると燃える花嫁衣装を送ったという話があるのでそのイメージで)\nを描いていただきたいです。\n\n構図はお任せしますが、1コマ目と2コマ目が対比になる感じでお願いします。\nその他の背景やシチュエーションなどは全てお任せします。\n\nよろしくお願いします。", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@shintyoi2/works/69", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2706166, "client_id": 46552, "vtt_url": null