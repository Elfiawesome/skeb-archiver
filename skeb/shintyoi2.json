防虎燕のイラストをお願いしたいです。\n\nhttps://x.com/Fue_sirikageru/status/1509881316183281670、リツカがフヤンの耳元で褒め言葉をささやきながら、フヤンは褒められて嬉しそうにしている。\n\n構図などはお任せします。ご検討のほど、よろしくお願いいたします。", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@shintyoi2/works/59", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2706166, "client_id": 2517970, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/fa5df7c7/uploads/origins/b8b27f9a-a055-407a-8ca1-1f82afcc5cad?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=57f88ca8cff040a28c9498074b3538cb", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/fa5df7c7/uploads/origins/b8b27f9a-a055-407a-8ca1-1f82afcc5cad?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=28e51dda42a7eb7ef1e39afb85697abd", "src_set": ""}, "body": "こんにちは。まほよの蒼崎青子とFate/Stay Nightのセイバー・アルトリアのアートワークをお願いしたいです。\n\n二人はベッドの脇に座っています。青子は静月のジャケット（https://i.imgur.com/TqmGPru.png）を着ていて、セイバーは士郎のシャツ（https://i.imgur.com/NlDWVsr.png）を着ている。下には何も着ていない。足もむき出しだ。\n\nありがとう。", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@shintyoi2/works/58", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2706166, "client_id": 0, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/1de80a49/uploads/origins/cef46cbd-f195-4e4a-a876-fb0fe05e7502?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a50955c61bbacf89679f6f47855337d8", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/1de80a49/uploads/origins/cef46cbd-f195-4e4a-a876-fb0fe05e7502?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=4904d90734eea47738d85ab22b65baae", "src_set": ""}, "body": "Please draw the Ryougi family\n\nDraw Mikiya walking with Shiki(first personality) in her blue kimono with red jacket holding his arm with a shy expression, Void Shiki(saber shiki) in white kimono on the other side holding his hand with intertwining fingers and then draw SHIKI(2nd personality) in a yellow kimono with red jacket walking hand in hand with Mana Ryougi", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@shintyoi2/works/57", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2706166, "client_id": 2938160, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/6562e7ce/uploads/origins/e7ca10c1-ac2e-4199-8d2b-26c1e86ad200?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2bbb03f0c90ea0123be0fbb3d3fe29d9", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/6562e7ce/uploads/origins/e7ca10c1-ac2e-4199-8d2b-26c1e86ad200?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5ba5a8f46f763f2844de9d0fb3e70fa4", "src_set": ""}, "body": "もしよろしければ、セイバー・アルトリアの英霊ドレス姿と、ぐだおのハロウィン王族ミスティックコードでの依頼をお願いしたいです。\nポスチャーは、舞踏会で踊っているような感じにしてもらえるとありがたいです。", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@shintyoi2/works/56", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2706166, "client_id": 2517970, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/2174b2da/uploads/origins/fc5ebbda-abb4-4440-aba4-aa3377582308?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4bac1776b63aea71f11e987b0fef7231", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/2174b2da/uploads/origins/fc5ebbda-abb4-4440-aba4-aa3377582308?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=dc3e24b6878803c0721006133ee715ae", "src_set": ""}, "body": "こんにちは、『Fate/Stay Night』の衛宮士郎とセイバー・アルトリアのアートワークをお願いしたいです。\n\nFate/Stay Nightのビジュアルノベルの最終話のエンディングシーンをイメージしています。士郎はアヴァロンにたどり着き、セイバーと再会します。\n\nセイバーと士郎がやっと再会できたと大喜びしているイメージ。\n\nセイバーは最終話のドレス（https://i.imgur.com/O33mIfD.jpeg）を着ていて、士郎は少し大人っぽく、白いシャツにいつものジーンズ姿。\n\nありがとう。", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@shintyoi2/works/55", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2706166, "client_id": 2938160, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/95f381f3/uploads/origins/784b877f-6245-45f2-9f46-96f1c784e5a8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ec0da6b9544521fa1bb3c3431487e04f", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/95f381f3/uploads/origins/784b877f-6245-45f2-9f46-96f1c784e5a8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=269756e35c6fcb328cfde2f7522f98be", "src_set": ""}, "body": "はじめまして、もしよろしければ、アーキタイプ・アース（ファーストアセンション）の水着姿の依頼をお願いしたいのですが、どんな感じになるかクリエイティブでお願いします。ポーズとしては、アーキタイプ・アースがぐだおを砂浜に固定させてキスしているような感じでお願いします。もし引き受けてくれるなら、ありがとう。", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@shintyoi2/works/54", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2706166, "client_id": 0, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/a59ecaba/uploads/origins/09b1d70f-8cce-4d3e-9d34-212675820ecd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=967bdadcd690ca75de346f32ab4eaaa8", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_t