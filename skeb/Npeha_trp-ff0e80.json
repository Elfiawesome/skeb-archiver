かけに崇拝する・される関係性に。異常な感情を抱く従者に困惑しながらも、与えられる愛情に絆されている探偵と、命の恩人である探偵を崇拝しながら加害によって愛情を伝える従者。\n肉体関係があり互いに依存しあっているものの付き合ったりなど一般的な恋愛関係とはズレた歪んだ縁で結ばれている\nシナリオEND:1 両生還\nカップリング:助手攻め/探偵受け\n\n◾︎二人資料\nhttps://drive.google.com/drive/folders/1K_IBKUHd1ZM-g8psOYem7P-0Rp-oAdju\n\n◾︎二人資料(R18込)\nhttps://drive.google.com/drive/folders/13M5TfE543cTFXSAsE_QkOozB0-bH72GC", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@t_c3x/works/100", "private_thumbnail_image_urls": null, "private": false, "genre": "comic", "tipped": true, "creator_id": 1160991, "client_id": 2808086, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/3130d6d4/uploads/origins/1f36c536-f632-414f-a533-5f391496ca26?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3d8c1c54bc3f1bb95d0e715551e3c1db", "srcset": "https://si.imgix.net/3130d6d4/uploads/origins/1f36c536-f632-414f-a533-5f391496ca26?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3d8c1c54bc3f1bb95d0e715551e3c1db, https://si.imgix.net/3130d6d4/uploads/origins/1f36c536-f632-414f-a533-5f391496ca26?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=8f3980759bb504bf9173e6b241c71b6c 2x, https://si.imgix.net/3130d6d4/uploads/origins/1f36c536-f632-414f-a533-5f391496ca26?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=cbecbeadce511d9916b49e5148e5fe5e 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/3130d6d4/uploads/origins/1f36c536-f632-414f-a533-5f391496ca26?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=acf12516be56c047c85bd577b8f36a6b", "srcset": "https://si.imgix.net/3130d6d4/uploads/origins/1f36c536-f632-414f-a533-5f391496ca26?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=acf12516be56c047c85bd577b8f36a6b, https://si.imgix.net/3130d6d4/uploads/origins/1f3