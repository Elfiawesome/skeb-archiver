るまでの全プロセスを示す一連のイメージを描いてください。\n\nFur Affinityの私のギャラリーから、Deviousの参考画像をお送りします：https://www.furaffinity.net/view/48341591/, https://www.furaffinity.net/gallery/galaxyeyes/folder/1240909/Devious-feral/ 。彼はArcanineに基づいてモデル化されていますが、あなたのアートスタイルに合わせて詳細を簡略化できます。\n\nBoltの参考画像はこちらです：https://e621.net/posts/599984。", "nc": 41, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [{"path": "/@TENGMB/works/10", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2740424, "client_id": 1993812, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/76c7607c/uploads/origins/0e5dc3d1-b62d-46ac-9d6a-9649d4ec77b9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=82f52ddd904037aac5467de4388a2873", "srcset": "https://si.imgix.net/76c7607c/uploads/origins/0e5dc3d1-b62d-46ac-9d6a-9649d4ec77b9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=82f52ddd904037aac5467de4388a2873, https://si.imgix.net/76c7607c/uploads/origins/0e5dc3d1-b62d-46ac-9d6a-9649d4ec77b9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=5bcd54259e993ed563307e93499ccbda 2x, https://si.imgix.net/76c7607c/uploads/origins/0e5dc3d1-b62d-46ac-9d6a-9649d4ec77b9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=fdf3f5b4992fdc2511cc814433d892b7 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/76c7607c/uploads/origins/0e5dc3d1-b62d-46ac-9d6a-9649d4ec77b9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=55408c8d0d4f1398fe8e48f4e8f44181", "srcset": "https://si.imgix.net/76c7607c/uploads/origins/0e5dc3d1-b62d-46ac-9d6a-9649d4ec77b9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=55408c8d0d4f1398fe8e48f4e8f44181, https://si.imgix.net/76c7607c/uploads/origins/0e5dc3d1-b62d-46ac-9d6a-9649d4ec77b