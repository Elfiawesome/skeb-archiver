rivate_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3451601, "client_id": 2634476, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/34c7fdf4/uploads/origins/ed113aa9-3040-4e99-a385-f17cf1ed0c81?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=faed09142d75f741b15233a38840720a", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/34c7fdf4/uploads/origins/ed113aa9-3040-4e99-a385-f17cf1ed0c81?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6112dd92c404d9c8d92e97f6261a0e02", "src_set": ""}, "body": "こんにちは！あなたの絵が本当に大好きなので、私のVtuberモデルをあなたのスタイルで描いてほしいです！❤︎ 彼女はサイバーワンダーランドのキツネの女の子で、遊び好きで、おバカで、いたずら好きで、ハッピーな時はエネルギッシュです！でも、この作品ではチャラチャラしていたり、セクシーな表現をしてほしいです。\n\n背景やテーマ、ポーズ、アングル、サイズなど、自由な発想で描いてください！マスコットとの組み合わせは自由です。リファレンスにあるランジェリー姿のマスコットを描いていただきたいです。重要なディテールは、キツネ耳のヘッドフォン、顔のマーク、爪、胸のタトゥー、獣のスリッパ（リファレンスに含まれています）です。可能であれば、ポーズと背景の異なる2つのバージョンを希望します。必要であれば値段の調整も可能です。\n\n可能であれば、PSDファイルか、背景を透明にしたバージョンもいただきたいです。\n\n先生、お忙しい中ありがとうございました！⸜(。> ᵕ <)⸝♡\n\nhttps://drive.google.com/drive/folders/1n7vJb1e7Pvt9eJvajjnntgz6YXnDjZuD?usp=drive_link", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@shikaku_asamura/works/80", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/776ea60f/uploads/origins/917ab027-e071-4fff-857d-56ebd12c72c4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=3edc5c7fa2368b66b6d71f9c61814971", "src_set": ""}, "private": true, "genre": "art", "tipped": false, "creator_id": 3451601, "client_id": 0, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 33, "word_count": 0, "transcoder": "", "creator_acce