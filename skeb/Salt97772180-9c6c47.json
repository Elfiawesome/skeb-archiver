tps://anicobin.ldblog.jp/lite/article/61379394/image/177987570\n\n今回は、暗く悲しいテーマになってしまいますが、もし、お気に召されない様でしたら、お断りしても構いません。\n\nどうぞ、ご検討をよろしくお願い致します。", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Salt97772180/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 757981, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/3b8bfbe4/uploads/origins/ca49687e-f347-4fae-b0c3-a9a5ee679614?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=658377fe4c73fe5c73c8e2ccad45185c", "srcset": "https://si.imgix.net/3b8bfbe4/uploads/origins/ca49687e-f347-4fae-b0c3-a9a5ee679614?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=658377fe4c73fe5c73c8e2ccad45185c, https://si.imgix.net/3b8bfbe4/uploads/origins/ca49687e-f347-4fae-b0c3-a9a5ee679614?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=7a2292f5e2a2d90c1c942a48107d3b48 2x, https://si.imgix.net/3b8bfbe4/uploads/origins/ca49687e-f347-4fae-b0c3-a9a5ee679614?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=72d9e27ca0566e9e179834040d219057 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/3b8bfbe4/uploads/origins/ca49687e-f347-4fae-b0c3-a9a5ee679614?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2cc56bf6572342683033258e9bf20e72", "srcset": "https://si.imgix.net/3b8bfbe4/uploads/origins/ca49687e-f347-4fae-b0c3-a9a5ee679614?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2cc56bf6572342683033258e9bf20e72, https://si.imgix.net/3b8bfbe4/uploads/origins/ca49687e-f347-4fae-b0c3-a9a5ee679614?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=4a5a2ea8002bf0c235b76150538621f9 2x, https://si.imgix.net/3b8bfbe4/uploads/origins/ca49687e-f347-4fae-