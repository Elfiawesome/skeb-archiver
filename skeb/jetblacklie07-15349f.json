uto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fd12bb7372d2f6ed5fd2d880fcf26399, https://si.imgix.net/a345f2b5/uploads/origins/3a1c1803-9c97-4703-b22d-a645f076f812?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=2308ed2728311a6536fb28fca55de5d8 2x, https://si.imgix.net/a345f2b5/uploads/origins/3a1c1803-9c97-4703-b22d-a645f076f812?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ea8c512704f6ba2fac2d5c8164604af5 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/a345f2b5/uploads/origins/3a1c1803-9c97-4703-b22d-a645f076f812?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=7c81152989544731ee1d2a3b56df118d", "srcset": "https://si.imgix.net/a345f2b5/uploads/origins/3a1c1803-9c97-4703-b22d-a645f076f812?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=7c81152989544731ee1d2a3b56df118d, https://si.imgix.net/a345f2b5/uploads/origins/3a1c1803-9c97-4703-b22d-a645f076f812?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=a68b03ab4d687e9aa08cf83a05370b05 2x, https://si.imgix.net/a345f2b5/uploads/origins/3a1c1803-9c97-4703-b22d-a645f076f812?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=b1a954bc67cf2ed9fd5266a0bf6fc71c 3x"}, "body": "雨音様\n\nお久しぶりです。昨年は素敵なイラストをありがとうございました！今回も私のオリジナルキャラクターを描いて頂きたいと思い、リクエストさせていただきました。拙いイラストですが、リンク先に資料が添付してありますので参考にしてください。\n\n以下キャラクターの設定です。\n\n年齢は20代前半、男性　くせっ毛　黒縁メガネを掛けている　身長高め\nとある学校で理科を教える新人教師。実験は失敗してばかりで虫が苦手。しかし生徒たちと、真剣に向き合ってくれるので、生徒からの人気は高い。\n彼が顧問を務めるオーケストラ部では、指揮を振っている。指揮棒を握るといつものぎこちない雰囲気とは打って変わって、優雅な動きで指揮棒を振るう。\n趣味はバイオリンの演奏。本当はプロのバイオリニストになりたかったが、金銭的な事情で諦めている。\n\n構図ですが、コンサートで指揮をしている様子でお願い致します。\n\nその他不明な点や参考資料で見づらかった点はご自由に描いて頂いて大丈夫です。\n\nご検討よろしくお願いします。\n\nhttps://drive.google.com/drive/folders/1y4f629ooTabI86lbzpEd84IiW_CBohKm?usp=sharing", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@jetblacklie07/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 129702, "client_id": 2053776, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/8c1782aa/uploads/origins/1fd84572-ad6c-48fd-a12c-0c42942c9c13?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c44e9dca13e9a3b60f1e237890be2356", "srcset": "https://si.imgix.net/8c1782aa/uploads/origins/1fd84572-ad6c-48fd-a12c-0c42942c9c13?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c44e9dca13e9a3b60f1e237890be2356, https://si.imgix.net/8c1782aa/uploads/origins/1fd84572-ad6c-48fd-a12c-0c42942c9c13?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e06a33984158e938703c6200407644f5 2x, https://si.imgix.net/8c1782aa/uploads/origins/1fd84572-ad6c-48fd-a12c-0c42942c9c13?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=5e1960035787b34f4644c0e47e538720 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/8c1782aa/uploads/origins/1fd84572-ad6c-48fd-a12c-0c42942c9c13?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ac742333ceaae602402560724ad319af", "srcset": "https://si.imgix.net/8c1782aa/uploads/origins/1fd84572-ad6c-48fd-a12c-0c42942c9c13?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ac742333ceaae602402560724ad319af, https://si.imgix.net/8c1782aa/uploads/origins/1fd84572-ad6c-48fd-a12c-0c42942c9c13?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=f8eafae45b98046bb0dfce8f3529dc39 2x, https://si.imgix.net/8c1782aa/uploads/origins/1fd84572-ad6c-48fd-a12c-0c42942c9c13?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=1fc174d523cb1ff909c8bcac910be6a0 3x"}, "body": "雨音様\n夜分遅くに失礼いたします。初めまして、あさりと申します。繊細で神秘的な雰囲気を纏った素敵なイラストを見て依頼させていただきました。\n今回私のオリジナルキャラクターを描いて頂きたくリクエストを送らせていただきました。\n拙いアナログ画像で申し訳ございませんが、参考資料を添付しておりますので参考にしてください。\n\n以下キャラクターの設定です。\n設定 病弱な飼い主を助けるために猛勉強して医者になった猫。真面目で穏やかな性格。猫の姿と人間の姿を切り替えることができる。（今回は人間の姿で描いて頂きたいです）\n\n容姿 髪色は黄緑、目の色は黄色。身長は170㎝台後半くらい。目は猫目（瞳孔が縦に長くなっている）でまつ毛がたくさん生えている。口元には八重歯がある。中性的な姿をしているが男性である。長い髪を後ろで縛ってポニーテールにしている。耳は頭上の猫耳のみで、人耳は無し。尻尾は隠しているため見えない。\n\n構図等 優しく穏やかに微笑んだ表情でお願いします。それ以外はお任せいたします。\n\nその他不明な点や参考資料で見づらかった点はご自由に描いて頂いて大丈夫です。アレンジも大歓迎です。\n\nご検討よろしくお願いします。\n\nhttps://drive.google.com/file/d/16uGVy47Fu3os7QJEPcyxQkjKce1UkhH-/view?usp=sharing", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@jetblacklie07/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 129702, "client_id": 1284473, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/6817dc00/uploads/origins/bf272483-9589-4783-8a7a-1b5eb99d0ae2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5d31331970b52612a8fd0ff21ba44fb6", "srcset": "https://si.imgix.net/6817dc00/uploads/origins/bf272483-9589-4783-8a7a-1b5eb99d0ae2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5d31331970b52612a8fd0ff21ba44fb6, https://si.imgix.net/6817dc00/uploads/origins/bf272483-9589-4783-8a7a-1b5eb99d0ae2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=2794614bcfb6d5d507bba9b0cb26d22e 2x, https://si.imgix.net/6817dc00/uploads/origins/bf272483-9589-4783-8a7a-1b5eb99d0ae2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=bde98db56450ecb25355bd3524806a1d 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/6817dc00/uploads/origins/bf272483-9589-4783-8a7a-1b5eb99d0ae2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=48ca4ab34396cef5c69965b8c3f498ce", "srcset": "https://si.imgix.net/6817dc00/uploads/origins/bf272483-9589-4783-8a7a-1b5eb99d0ae2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=48ca4ab34396cef5c69965b8c3f498ce, https://si.imgix.net/6817dc00/uploads/origins/bf272483-9589-4783-8a7a-1b5eb99d0ae2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=6953e615687c5b76884f74798d506cae 2x, https://si.imgix.net/6817dc00/uploads/origins/bf272483-9589-4783-8a7a-1b5eb99d0ae2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=198bc28263eca2641607766047491641 3x"}, "body": "こんにちは。あなたの作品が大好きです。\n\n私のキャラクターをこのように描いていただけると嬉しいです。\nhttps://twitter.com/jetblacklie07/status/1477952398534782977/photo/1\nでも、クローバーとか、キラキラとか、ニンジンが好きなキャラなのでニンジンとか。クローバーはドラゴンのサキュバスで、サメのような歯を持っています。ご検討よろしくお願いします。\n\nまた、署名と背景を分けていただけますか？ありがとうございます!\n\nhttps://toyhou.se/5787895.clover", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@jetblacklie07/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 129702, "client_id": 1601170, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/cf83d065/uploads/origins/52772395-a73b-4fbe-89bf-c6de49c8d333?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=55e659839e50d971ddf4aa6043d7b146", "srcset": "https://si.imgix.net/cf83d065/uploads/origins/52772395-a73b-4fbe-89bf-c6de49c8d333?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=55e659839e50d971ddf4aa6043d7b146, https://si.imgix.net/cf83d065/uploads/origins/52772395-a73b-4fbe-89bf-c6de49c8d333?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=297182d13204ef7326a7f5da35fb2744 2x, https://si.imgix.net/cf83d065/uploads/origins/52772395-a73b-4fbe-89bf-c6de49c8d333?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=443e69d595c74fc1911590fcfc8cda3a 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/cf83d065/uploads/origins/52772395-a73b-4fbe-89bf-c6de49c8d333?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=eb72080387a2a717d5b421a3e41acc45", "srcset": "https://si.imgix.net/cf83d065/uploads/origins/52772395-a73b-4fbe-89bf-c6de49c8d333?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=eb72080387a2a717d5b421a3e41acc45, https://si.imgix.net/cf83d065/uploads/origins/52772395-a73b-4fbe-89bf-c6de49c8d333?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=9325861e7eb5babfa3c695c94037a211 2x, https://si.imgix.net/cf83d065/uploads/origins/52772395-a73b-4fbe-89bf-c6de49c8d333?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=f586e79c0bb68e4c195f86fa830cdc13 3x"}, "body": "雨音先生\n\n先生の美麗で幻想的な絵柄に惹かれました。\nこの度、大好きなVtuberさんへFAを贈りたいのですが、\nこの子↓の違う衣装の姿を見たいので、描いていただけないでしょうか？\n\nhttps://twitter.com/AmehokiYuki\nhttps://twitter.com/AmehokiYuki/status/1421696835131875335\n\n可愛らしい感じのキャラクターですが、\n少し大人びて美人・カッコイイ感じの衣装・雰囲気を見たいな、と思い、\nお願いしたく思います。\n\nポーズ・構図・全身／アップなどは全てお任せします。\n\nなお、FAとしてプレゼントしたいので、配信・サムネ・Twitter等で使用されることを\nご了承ください。\nまた、サムネイル等の素材として使えるよう、本人部分のみの透過素材もご用意いただけると\nありがたいです。\n\nよろしくお願いいたします！\n\nhttps://twitter.com/AmehokiYuki", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@jetblacklie07/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 129702, "client_id": 889753, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/53d99126/requests/214171_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=91c42d6f05be0b5a1c5df80e999324a5", "srcset": "https://si.imgix.net/53d99126/requests/214171_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=