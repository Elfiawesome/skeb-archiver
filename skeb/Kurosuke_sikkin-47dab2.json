してしまう鹿島ちゃん』といった内容を希望します。\n以上、宜しければご検討のほどお願いします。", "nc": 177, "word_count": 5685, "transcoder": "text", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 194188, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "ベネディクタ（pixiv・skebリクエスト受付中）", "screen_name": "yamamaya4", "avatar_url": "https://pbs.twimg.com/profile_images/1648234218978156544/_LO0nOGV.png", "header_url": "https://pbs.twimg.com/profile_banners/124104742/1681804636/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "novel"}], "banned": false, "nc": 185}, {"id": 399472, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "手梳ろが", "screen_name": "Task_rg", "avatar_url": "https://pbs.twimg.com/profile_images/1268086398222921728/vEO1yURM.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1086724963694915584/1623610555/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 5, "complete_expiration_days": 120, "skills": [{"genre": "art"}], "banned": false, "nc": 176}, {"id": 487746, "creator": true, "nsfw_acceptable": true, "acceptable": false, "name": "できすとりん", "screen_name": "cycloC6H12O6_n", "avatar_url": "https://pbs.twimg.com/profile_images/2005241214300491776/CcJAaPxV.jpg", "header_url": null, "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 7, "complete_expiration_days": 120, "skills": [{"genre": "novel"}], "banned": false, "nc": 48}, {"id": 543260, "creator": true, "nsfw_acceptable": true, "acceptable": false, "name": "レイエラ🍄", "screen_n