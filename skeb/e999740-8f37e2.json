s&fm=webp&fit=crop&crop=top&w=200&h=200&s=31602b82335ccad2a9f0bb40bf818991, https://si.imgix.net/a4dcccae/uploads/origins/4d90cd88-a966-4fcd-a378-01e40a129848?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=5d20b7b7b33a745218ae1135f0d4a0ae 2x, https://si.imgix.net/a4dcccae/uploads/origins/4d90cd88-a966-4fcd-a378-01e40a129848?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=00999f3ce96ac026984aadcb0b7ac393 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/a4dcccae/uploads/origins/4d90cd88-a966-4fcd-a378-01e40a129848?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6be89abb7abf7c5df6e549ef6e58f2b4", "srcset": "https://si.imgix.net/a4dcccae/uploads/origins/4d90cd88-a966-4fcd-a378-01e40a129848?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6be89abb7abf7c5df6e549ef6e58f2b4, https://si.imgix.net/a4dcccae/uploads/origins/4d90cd88-a966-4fcd-a378-01e40a129848?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=9675f1b63c4b18f4d6abf67b4eb1d8de 2x, https://si.imgix.net/a4dcccae/uploads/origins/4d90cd88-a966-4fcd-a378-01e40a129848?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=c287ee6b75509dade828ad840161f3de 3x"}, "body": "はじめまして！\n新着でイラストを拝見して素敵な絵柄に惹かれました…！\nもしよろしければ、下記URLのOCを描いて頂けないでしょうか？\n構図や服装等描きやすいようご自由に描いて頂いて構いません\nご検討よろしくお願いいたします🙇🏻‍♀️‪‪\n\n●使用用途\nスマホの壁紙等の個人鑑賞、SNSのアイコンやヘッダー\n\n●キャラクター\n気まぐれで人見知りなスルコウスキーモルフォの女の子。わがままでイタズラをするのが好き。滅多に姿を見せず声も聞かせないが、そのせいで人間には幽霊だと思われていてそれを不服に思っている。\n\nhttps://drive.google.com/drive/folders/1-5ONbeaP9etLRu93jT7DGGqlfeCXEbRw", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@e999740/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 4016701, "client_id": 3416124, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/cd868d82/uploads/origins/6b37b7c7-f121-429e-8e9d-204e739e5f93?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8b003aa57fd5b24e39a7d87c9eeea31f", "srcset": "https://si.imgix.net/cd868d82/uploads/origins/6b37b7c7-f121-429e-8e9d-204e739e5f93?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8b003aa57fd5b24e39a7d87c9eeea31f, https://si.imgix.net/cd868d82/uploads/origins/6b37b7c7-f121-429e-8e9d-204e739e5f93?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=33fbde274056ef902fc8aea6ffbb1aad 2x, https://si.imgix.net/cd868d82/uploads/origins/6b37b7c7-f121-429e-8e9d-204e739e5f93?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=bcd75848b1d9667145283ebb9fe585e6 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/cd868d82/uploads/origins/6b37b7c7-f121-429e-8e9d-204e739e5f93?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f51b42a7839f443c6035487dcaaa8397", "srcset": "https://si.imgix.net/cd868d82/uploads/origins/6b37b7c7-f121-429e-8e9d-204e739e5f93?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f51b42a7839f443c6035487dcaaa8397, https://si.imgix.net/cd868d82/uploads/origins/6b37b7c7-f121-429e-8e9d-204e739e5f93?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=1f26de5f5beda103b083af5e01512f1d 2x, https://si.imgix.net/cd868d82/uploads/origins/6b37b7c7-f121-429e-8e9d-204e739e5f93?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=48f630e25278893ac326efd2443217cb 3x"}, "body": "こんにちは！あなたの作品がとても好きで、オリジナルキャラクター二人のイラストをご依頼したく、ご連絡いたしました。\nもし金額が不足しておりましたら、再送していただけますと幸いです。\n\n■キャラクター設定\n学生時代：\n明るく行動力がありながら、心臓病で体の弱い金髪の女の子 X 礼儀正しく優等生を演じている男の子。\n大人になってから：\n海外で治療を終え帰国した、情熱的な獣医の女性 X 重度のうつを抱えながらバンド活動をしているギタリストの男性。\n\n女の子は流行や新しいものが好きで、動物が大好きです。\n男の子はロックCD集めが趣味で、ギターとピアノを弾きます。\n動物塑造はゴールデンレトリバーとボーダーコリーです。\n\n■関係性\n17歳までは幼なじみとして一緒に育ちました。女の子はよく男の子を遊びに誘い、\n男の子は「面倒だな」と言いながらも、一度も断りません。\n学生時代、女の子は彼を「唯一無二の大切な親友であり家族」のように思っており、男の子も家族のように彼女を支え、守っていました。彼女に恋心を抱いていたかもしれません。\n\n17歳以降、女の子は海外治療のため突然姿を消します。\n同時期に男の子の家庭も崩壊し、彼は一人で生活するようになり、うつ病と身体症状を抱えるようになります。\n数年後、帰国した頃には、男の子はロックバンドのギタリストになっていました。\n最初は彼女を避けますが、やがて彼女を「生きる支え」のように思うようになります。女の子もまた、彼を救おうとしております。\n男の子は強い不安感を抱えており、少し重力系な一面があります。\n\n\n具体的な内容はご自由にご調整ください。髪の時期は、比較的中性的で柔らかな顔立ちをしています。\nお読みいただき、ありがとうございました！\n\nhttps://drive.google.com/drive/folders/1kL64tQfkaKjahpLUWj7h2nxBCXBa6GuH?usp=drive_link", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@e999740/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 4016701, "client_id": 1782540, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/c7c22124/uploads/origins/93bdc476-4d0d-4ad9-bf13-2fadfd711755?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a5cc6a8080b76e9b9c3b5be7a7196ce9", "srcset": "https://si.imgix.net/c7c22124/uploads/origins/93bdc476-4d0d-4ad9-bf13-2fadfd711755?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a5cc6a8080b76e9b9c3b5be7a7196ce9, https://si.imgix.net/c7c22124/uploads/origins/93bdc476-4d0d-4ad9-bf13-2fadfd711755?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=fad2163f22b76b0dfdd1e08ae1249aec 2x, https://si.imgix.net/c7c22124/uploads/origins/93bdc476-4d0d-4ad9-bf13-2fadfd711755?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e78a141cc20779f761238fa778129a2b 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/c7c22124/uploads/origins/93bdc476-4d0d-4ad9-bf13-2fadfd711755?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5cdd4061204c6defe748e3d52b2342f7", "srcset": "https://si.imgix.net/c7c22124/uploads/origins/93bdc476-4d0d-4ad9-bf13-2fadfd711755?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5cdd4061204c6defe748e3d52b2342f7, https://si.imgix.net/c7c22124/uploads/origins/93bdc476-4d0d-4ad9-bf13-2fadfd711755?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=878509083e89ae87f898ea428a5c48d8 2x, https://si.imgix.net/c7c22124/uploads/origins/93bdc476-4d0d-4ad9-bf13-2fadfd711755?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=d2c29e82bb69b9f114dcf9cee834da20 3x"}, "body": "こんにちは、おさしみ先生。\n\n先生の作品がとても大好きです。\nもしよろしければ、私のオリジナルキャラクター2人を描いていただけたら嬉しいです。\n\n**女の子**\n穏やかで物静かな性格です。\n男の子と出会うまでは、ずっと一人で過ごしていました。\n\n**男の子**\n現在はロングヘアのデザインなので、「ロングヘア」と書かれた資料をご参考いただければ幸いです。\n\n彼は女の子が心の中で生み出した「空想の友達（イマジナリーフレンド）」です。\n彼の姿を見ることができるのは女の子だけです。\n\n彼は孤独だった少女の想像から生まれ、これからもずっと彼女のそばにいるために存在しています。\nそして、少女が彼の存在を信じ続ける限り、彼が消えることはありません。\n実体を持たない存在なので、誰も彼に触れることはできません。\n\nイラストは、月明かりに照らされた少し暗く静かな雰囲気だと嬉しいです。\n葦（あし）の生える川辺で、二人が静かにダンスをしているシーンをお願いしたいです。\n\n「これが二人にとって最後の時間であり、このダンスが終わると男の子は消えてしまう」\nそんな切なく儚い情景をイメージしていただけたら嬉しいです。\n\nフォルダ内の「概念&印象」と書かれた資料も、雰囲気づくりの参考になるかもしれません。\n添付した資料やリンク先の作品をご参考に、先生のご解釈・ご自由なアレンジで描いていただけたらとても嬉しいです。\n\n資料をご覧いただいた上で、もし先生の中で描いてみたい場面や構図がありましたら、ぜひご自由に描いていただけたら嬉しいです。\n\n最後まで読んでくださり、本当にありがとうございます。\nどうぞよろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/1OO2XJt71lksnWh4HKj9cAtyquTYcWl5p?usp=drive_link", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@e999740/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 4016701, "client_id": 2608527, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/1e0e0af4/uploads/origins/5c4eadf8-268d-480b-ad56-4a56d405a792?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=be1dcbfdcfd7f6943a3dff2ffa742b9d", "srcset": "https://si.imgix.net/1e0e0af4/uploads/origins/5c4eadf8-268d-480b-ad56-4a56d405a792?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=be1dcbfdcfd7f6943a3dff2ffa742b9d, https://si.imgix.net/1e0e0af4/uploads/origins/5c4eadf8-268d-480b-ad56-4a56d405a792?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=1ffabb0a79f525e0e1cc510349be4dd0 2x, https://si.imgix.net/1e0e0af4/uploads/origins/5c4eadf8-268d-480b-ad56-4a56d405a792?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=40d1f8cc89927b414810f4bbb9be5a76 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/1e0e0af4/uploads/origins/5c4eadf8-268d-480b-ad56-4a56d405a792?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c6fb85c5684199eb1ae81448bc176705", "srcset": "https://si.imgix.net/1e0e0af4/uploads/origins/5c4eadf8-268d-480b-ad56-4a56d405a792?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c6fb85c5684199eb1ae81448bc176705, https://si.imgix.net/1e0e0af4/uploads/origins/5c4eadf8-268d-480b-ad56-4a56d405a792?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=1a21c5379ab0f55b46c1c3516b9e5743 2x, https://si.imgix.net/1e0e0af4/uploads/origins/5c4eadf8-268d-480b-ad56-4a56d405a792?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=f71a3d74c19f4e7ca17a65935502d667 3x"}, "body": "はじめまして。\n先生の作品がとても好きで、ぜひ私のオリジナルキャラクター（OC）を描いていただけないかと思い、ご連絡いたしました🤍\n\n彼女は巡回劇団の主演女優で、明るく甘い性格ですが、少し電波系な一面があります。\n彼女が戦闘に用いる武器はリボンで、\nそのリボンを相手の目に覆いかぶせることで幻覚を生み出す能力を持っている。\n\n幼い頃に両親に捨てられ、偶然にも劇団に拾われて育ちました。\n所属する劇団は裏社会と協力関係にあり、彼女の能力を使って観客の注目を集める一方、裏では違法な美術品の取引や運搬の隠れ蓑となっています。\n彼女は劇団に「居場所」を与えてもらったことに強い感謝を抱いており、それらの行為については黙認しています。\n\nまた、幼少期の影響から、メリーゴーランド、オルゴール、キャンディなど童話世界を象徴するものに強い執着があります。\n\nポーズや構図の指定はありませんので、自由に描いていただければ嬉しいです。\nもしご都合が合わない場合は、そのままキャンセルしていただいて大丈夫です。\n最後までお読みいただき、ありがとうござい