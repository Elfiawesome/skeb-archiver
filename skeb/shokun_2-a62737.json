e5-4d05-92b3-e1d5926ecd34?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=8d1209d23fe0a1e71c0def2d0ef78e2a 2x, https://si.imgix.net/c42aee2d/uploads/origins/909c1e32-52e5-4d05-92b3-e1d5926ecd34?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=89a87e9889ac377276a1fc5c1c9d2329 3x"}, "body": "こんにちは、しょーくんです！私はあなたの源氏アートと表情の捉え方がとても好きで、私のOCを描いてくれないかと期待していました。ダークグレーの肌、白い乱れ髪、黄色い目、鋭い歯が特徴です。黄色い電気タイプの能力を使うことができ、電気ウナギの人型バージョンをベースにしている。また、胸にアンソのシンボルがあり、その他の詳細は下記の参考リンクに示されている。身長は源氏物語の少年像とほぼ同じである。いつも楽しそうに笑っているのですが、その笑顔がどれほど不気味なものなのか、本人は気づいていないことがあります。あなたの描く表情がとても好きなので、どんな風に描いても自由です！今後、作品が完成したら、私のツイッターで、私のアートタグとあなたの全クレジットを添えて再投稿します。ありがとうございました！ 🙇‍♂️\n\nhttps://drive.google.com/drive/folders/10N3LVkcWdt-FJUEsMRjw4yHIkYmXjJJa", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@shokun_2/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2602524, "client_id": 1515739, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/5c0ab12c/uploads/origins/a7886520-4a5f-4402-a086-ffa5abf3e9ee?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=36df19e98f0de1e504b93611a6ea23ff", "srcset": "https://si.imgix.net/5c0ab12c/uploads/origins/a7886520-4a5f-4402-a086-ffa5abf3e9ee?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=36df19e98f0de1e504b93611a6ea23ff, https://si.imgix.net/5c0ab12c/uploads/origins/a7886520-4a5f-4402-a086-ffa5abf3e9ee?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c795ff9da9cca6b4a8698ae60e649138 2x, https://si.imgix.net/5c0ab12c/uploads/origins/a7886520-4a5f-4402-a086-ffa5abf3e9ee?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=37d23337f0a15673a53c9d5051e30351 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/5c0ab12c/uploads/origins/a7886520-4a5f-4402-a086-ffa5abf3e9ee?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=1a317b04e68d6b80002c38137c9dc6c8", "srcset": "https://si.imgix.net/5c0ab12c/uploads/origins/a7886520-4a5f-4402-a086-ffa5abf3e9ee?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=1a317b04e68d6b80002c38137c9dc6c8, https://si.imgix.net/5c0ab12c/uploads/origins/a7886520-4a5f-4402-a086-ffa5abf3e9ee?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=7cc7dac4d38f2d8d03d663fe9e6bd139 2x, https://si.imgix.net/5c0ab12c/uploads/origins/a7886520-4a5f-4402-a086-ffa5abf3e9ee?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=8123e7afbd4cc46b9c9e474c0a1d7716 3x"}, "body": "こんにちは。オリジナルキャラクターの依頼は受け付けていないのでしょうか、私の忍者の男の子、ミストとレイヴンを描いていただけないかと思い、お願いしに来ました。参考文献は以下の通りです。\nhttps://drive.google.com/file/d/1g1RGPHsQjOYCl3OCOb1-SXTUk1R36xzg/view?usp=share_link\nhttps://drive.google.com/file/d/1bsQBuWcYMAW-u6X-YpclFSjbNmVTzKrx/view?usp=share_link\nミストは穏やかで口数の少ない性格で、レイヴンは外向的で少々やんちゃな性格です。彼らは幼い頃から忍者一族のバトルパートナーです。\nミストは火、レイヴンは風というように、元素の力を使った戦いで協力し合う姿を描いていただければと思います（『原始人』の設定に似ています）。その他は自由ですので、好きなように描いて楽しんでください。\nできれば、全体イラスト以外は、各キャラクター別に出力してほしいです。\nご検討のほど、よろしくお願いいたします。\n\nhttps://drive.google.com/file/d/1g1RGPHsQjOYCl3OCOb1-SXTUk1R36xzg/view?usp=share_link", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 813334, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "KHRクン🍼にじそ西4 ソ-48", "screen_name": "khr_zata", "avatar_url": "https://pbs.twimg.com/profile_images/1847329975160238081/4aYzsZKp.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1309704111256788996/1607707495/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_accept