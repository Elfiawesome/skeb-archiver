=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=f37b9cd49ab5695f7d816af07e337734 2x, https://si.imgix.net/c19b2f04/uploads/origins/6f2d35d1-c253-4084-9c52-1397546d1246?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=20eccab761ed42beeb30927a46fa9230 3x"}, "private": true, "genre": "art", "tipped": false, "creator_id": 3483544, "nc": 128}, {"path": "/@SHIOTA_YUN/works/11", "private_thumbnail_image_urls": null, "private": false, "genre": "comic", "tipped": false, "creator_id": 3483544, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/c4c339b7/uploads/origins/68c46a1a-20f9-4dc3-9f80-9c84e9273017?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=113dee3401e3d7c787f4462f17bc4568", "srcset": "https://si.imgix.net/c4c339b7/uploads/origins/68c46a1a-20f9-4dc3-9f80-9c84e9273017?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=113dee3401e3d7c787f4462f17bc4568, https://si.imgix.net/c4c339b7/uploads/origins/68c46a1a-20f9-4dc3-9f80-9c84e9273017?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=1b348d7fc6e6280965fafd30774a5ca1 2x, https://si.imgix.net/c4c339b7/uploads/origins/68c46a1a-20f9-4dc3-9f80-9c84e9273017?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=7f63e59ddf638a54e79064b63566efea 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/c4c339b7/uploads/origins/68c46a1a-20f9-4dc3-9f80-9c84e9273017?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=23cc35a611b1e7bfecd707c26a6047f2", "srcset": "https://si.imgix.net/c4c339b7/uploads/origins/68c46a1a-20f9-4dc3-9f80-9c84e9273017?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=23cc35a611b1e7bfecd707c26a6047f2, https://si.imgix.net/c4c339b7/uploads/origins/68c46a1a-20f9-4dc3-9f80-9c84e9273017?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=eacc90145f34049ed253d6fb62b175e3 2x, https://si.imgix.net/c4c339b7/uploads/origins/68c46a1a-20f9-4dc3-9f80-9c84e9273017?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=9f785b52d04565563d7a3bb3ccd71950 3x"}, "body": "しおたゆん先生、はじめまして！先生の描かれる作品がとても好きです…！いつも応援しております！もしよろしければ、私と知り合いのOCのうちよそキャラクターの漫画をお願いしたいです。シチュエーションとしましては、連日の徹夜のしすぎで倒れてしまった鈴を看病する犬養くんが見たいです…！使用用途といたしましては、個人での鑑賞とうちよそ相手への共有となります！値段等不備がございましたら、再送お願いいたします。\n\n▼設定\n登場人物は深紅鈴と犬養乾の二人。二人は犬猫学園秀才大学に通う大学4年生。大学には二つの学科（猫科、犬科）が存在しており、二人はそれぞれの学科の主席。ライバル同士だが、恋愛感情はない。\n\n▼深紅鈴（しんく　すず）\n22歳の女性。猫科の主席。身長は160cm。ゆるくウェーブした黒髪に琥珀色のつり目が特徴的。制服風のコーディネートをしている上に童顔なのでよく高校生に間違えられている。勝ち気でわがままでケチだが、努力家で曲がったことが大嫌い。得意なことは和菓子作り（和菓子屋さんでアルバイトをしている）と薙刀。趣味はツーリング。犬養くんの頭の良さと、自分に向けられる周囲からの期待に焦りを感じており、毎日睡眠時間を削って勉強している。一人称はアタシ、二人称はお前。犬養くんへの呼び方は「犬養」。\n\nセリフ例\n「アタシは深紅鈴。紛うことなき猫科のエリート！お前なんか目じゃないのよ」\n「おーっほっほっほ！当然よね！」\n「いや、これはお菓子の研究だから！！！ちょっ誰よデブ活って言ったのはー！！！」\n「ま、正々堂々戦いましょう」\n「もー、バカ舌！」\n\n▼犬養乾（いぬかい　けん）\n20歳の男性。犬科の主席。身長は170cm。賢いはずだが陽気で底抜けに明るい男。寒中水泳とチャンバラが趣味の小学生男子みたいな性格。頭がいいのに難しい言葉遣いが苦手で、より一層アホに見える。なんでもよく食べ、よく遊び、よく学び、よくふざけ、よく怒られる。そんな毎日を送っている。猫科に対しては「ウォー‼️鼻につくぜ‼️」という感じで少しイヤミだなぁと思いつつ、正直そんなに気にしていない。一人称は俺、二人称はお前、君。鈴に対する呼び方は「鈴」。賢そうな単語は使わない（使えない）。\n\nセリフ例\n「まっけないからね～！」\n「ふふん……！」\n「俺にまっかせて～！」\n「なんだよさっきからばかばかって！」\n\nhttps://drive.google.com/drive/folders/1nka0pYkYjQ-JzQF64GrEHXsycRDPrtDx?usp=drive_link", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@SHIOTA_YUN/works/10", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3483544, "client_id": 3555705, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/7fec3731/uploads/origins/3207d890-0e25-4e59-9c9b-9e9754cf