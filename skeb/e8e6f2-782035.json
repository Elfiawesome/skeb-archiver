ーガズムを許してくれるよう懇願している。\n\nポーズの参考画像。\nhttps://imgchest.com/p/m9yxln9dqyq\n\nありがとうございます。", "nc": 57, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 51146, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "のえるわ", "screen_name": "noeru_tsukikawa", "avatar_url": "https://proxy.misskeyusercontent.jp/avatar.webp?url=https%3A%2F%2Fmedia.misskeyusercontent.jp%2Fmisskey%2F0f31cef5-2425-47e2-9f7a-b51293af6032.png&avatar=1", "header_url": null, "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 90, "skills": [{"genre": "art"}], "banned": false, "nc": 48}, {"id": 191653, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "おいまんじ", "screen_name": "oimanji", "avatar_url": "https://proxy.misskeyusercontent.jp/avatar/media.misskeyusercontent.jp%2Fio%2Feb3d5ade-cb81-486e-a7c0-ee056047db21.png%3Fsensitive%3Dtrue?avatar=1", "header_url": "https://media.misskeyusercontent.jp/io/e8470dd3-1823-4864-b041-2e1f665d72b3.png", "appeal_receivable": true, "popular_creator_rank": 28, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 2, "complete_expiration_days": 120, "skills": [{"genre": "art"}], "banned": false, "nc": 33}, {"id": 406302, "creator": true, "nsfw_acceptable": true, "acceptable": false, "name": "雨小雨", "screen_name": "tyo_3rin", "avatar_url": "https://pbs.twimg.com/profile_images/1821133148970733568/EEeJe-Hs.jpg", "header_url": "https://pbs.twimg.com/profile_banners/102819886/1549832554/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 6