b0155-10f1-4070-91e1-931cfafc98e4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c403cbb997d7f0dae9c179d7dbc1e4e3 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/86ae5d53/uploads/origins/8a3b0155-10f1-4070-91e1-931cfafc98e4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=11e8287a13abbb7415629ba454472870", "srcset": "https://si.imgix.net/86ae5d53/uploads/origins/8a3b0155-10f1-4070-91e1-931cfafc98e4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=11e8287a13abbb7415629ba454472870, https://si.imgix.net/86ae5d53/uploads/origins/8a3b0155-10f1-4070-91e1-931cfafc98e4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=8270faf80f6a1665a327c57639e2113c 2x, https://si.imgix.net/86ae5d53/uploads/origins/8a3b0155-10f1-4070-91e1-931cfafc98e4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=f673a3f099257c607a41c7a25e6b0f87 3x"}, "body": "以前にもイラストを描いていただいた吠鳴(ほえなき)ワーグです。\nとても素敵なイラストで、よく使用させて頂いてます。\nよろしければまたイラストを描いて頂きたいと思いリクエストさせて貰いました！\n\n■髪型\nこちらのイラストを参考にしてください。\nhttps://drive.google.com/file/d/1GApL6cTOCrjFgm7OMtyIdpXqKChvAZ07/view\n狼がモチーフになっており、人間の耳は付いていません。\n\n■衣装\n衣装の資料はこちらとなります。\nhttps://drive.google.com/file/d/1s9Nfnn5JhPdLzu_2FSo32YGoN1XgDx2L/view\n服装はこの通りでなくても大丈夫ですし、別の服装でも構いません。\n\n■構図等\n今回はその…包丁を持っている姿をお願いできればと思っています…！\n\nTwitter上やYoutubeサムネイルに使用させて頂きたいので、許可を頂ける場合にリクエスト承認して頂ければと思います。\nキャタクターと背景やサインのレイヤー分けをして頂けると嬉しいです。\n\nよろしくお願い致します。", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@chirolo_kawaii/works/14", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 221246, "client_id": 2563874, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/c1e01fbe/uploads/origins/e64e1436-0c5b-42f3-93e8-a76029f65b7b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f15abc5489698e29a93c2ced2c33e213", "srcset": "https://si.imgix.net/c1e01fbe/uploads/origins/e64e1436-0c5b-42f3-93e8-a76029f65b7b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f15abc5489698e29a93c2ced2c33e213, https://si.imgix.net/c1e01fbe/uploads/origins/e64e1436-0c5b-42f3-93e8-a76029f65b7b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=fb911169a817def86705e88426fc2307 2x, https://si.imgix.net/c1e01fbe/uploads/origins/e64e1436-0c5b-42f3-93e8-a76029f65b7b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=73f3038af27f2aa1a3fc09af7735079d 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/c1e01fbe/uploads/origins/e64e1436-0c5b-42f3-93e8-a76029f65b7b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ad04b67f3eef82d77f463df1442bf03d", "srcset": "https://si.imgix.net/c1e01fbe/uploads/origins/e64e1436-0c5b-42f3-93e8-a76029f65b7b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ad04b67f3eef82d77f463df1442bf03d, https://si.imgix.net/c1e01fbe/uploads/origins/e64e1436-0c5b-42f3-93e8-a76029f65b7b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=53c88a86fca7908a46bda9e52d621746 2x, https://si.imgix.net/c1e01fbe/uploads/origins/e64e1436-0c5b-42f3-93e8-a76029f65b7b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=cb7c0119b9fd7a345ef3ffe962c315be 3x"}, "body": "いつも先生のイラストを拝見しております。前回描いていただいたイラストがとても素晴らしかったので、再びお願いさせていただきます。今回はVTuber「眞白かのん」のイラストを描いて頂きたいです。\n\n●テーマ\n「古都の秋夜」「幻想的な紅葉」「和メイド」\n\n●要望\n衣装：「衣装・髪型参考」の衣装を基に、和メイドへのアレンジをお願いします。和メイドのイメージは「和メイド_イメージ画像」を参照してください。\n髪型：「衣装・髪型参考」の髪型でお願いします。「表情_髪型差分動画」でも髪型をご確認いただけます。\nアクセサリー：ねこみみとしっぽを加えてください。\n\n●納品形式\n宛名・メッセージ・キャラ・背景が分かれたPSDファイル\n\n●用途\nVTuber・依頼者本人が「SNS投稿」「配信、動画内での使用」「サムネイル」「プロフィールアイコン」に使用することがあります。予めご了承いただけると幸いです。\n\nご検討のほどよろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/1b2OKImt4kx7VmOLkQPYdpvRJJlPRp2nf?usp=sharing", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@chirolo_kawaii/works/13", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 221246, "client_id": 2316842, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/72351186/uploads/origins/51dde05e-44e2-4362-b600-cd857be0742c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=cd439960091f5dd8fa1f7a98d34d01c2", "srcset": "https://si.imgix.net/72351186/uploads/origins/51dde05e-44e2-4362-b600-cd857be0742c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=cd439960091f5dd8fa1f7a98d34d01c2, https://si.imgix.net/72351186/uploads/origins/51dde05e-44e2-4362-b600-cd857be0742c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=af10e8e513029eba9f9eb2c0039fb314 2x, https://si.imgix.net/72351186/uploads/origins/51dde05e-44e2-4362-b600-cd857be0742c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=666a9285795a6726145f113fb3e5cc4d 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/72351186/uploads/origins/51dde05e-44e2-4362-b600-cd857be0742c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3a6a070d25e4205fe35e3914c58b2c49", "srcset": "https://si.imgix.net/72351186/uploads/origins/51dde05e-44e2-4362-b600-cd857be0742c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3a6a070d25e4205fe35e3914c58b2c49, https://si.imgix.net/72351186/uploads/origins/51dde05e-44e2-4362-b600-cd857be0742c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=93659adebdb9dced1367e7c9cc1dbf5a 2x, https://si.imgix.net/72351186/uploads/origins/51dde05e-44e2-4362-b600-cd857be0742c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=6d93002f9b615326d7d3f6204240d1e0 3x"}, "body": "こんにちは、ろろ先生\n\n先生の絵が好きで、あるVtuberの絵をお願いしたいです。彼女の名前は闇音ネル，小悪魔で左目に涙ほくろがあります。クールな服装が好きですが、性格はとても楽天的で優しいです。\n黒、紫、ピンク、ロック、メタルジュエリー、黒柴犬、パンダが大好き。\n\nvtuber twitterと平面絵描き：\nhttps://twitter.com/yamineneru/status/1561957651210473472\n\n\n\nゴシック・アンド・ロリータ風の服を描いてください。\nゴシック・アンド・ロリータ風の服のディテールを自由に描いてください。\nヘアスタイルは、原作のヘアスタイルと違うようにデザインしてください。\nハロウィンのティーパーティーでお菓子を食べているところです。\nこのイラストは彼女のためにハロウィーンをお祝いします。\n\n參考URL供給服のスタイルとティーパーティーの参考資料\n\n姿勢や表情は自由です。\n\nyoutubeライブやカバー、twitchやtwitter、ポストカード印刷などにご利用ください。\n\nhttps://drive.google.com/drive/folders/14Kohd3dN6QNT9X-mBkVbqbhLCdZv05Zr", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@chirolo_kawaii/works/12", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 221246, "client_id": 1512428, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/44b9b8c3/uploads/origins/68752c37-0b7f-4fcf-af99-2e8aa761e5dc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9d7f14e373247df044cffd93d9bf8536", "srcset": "https://si.imgix.net/44b9b8c3/uploads/origins/68752c37-0b7f-4fcf-af99-2e8aa761e5dc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9d7f14e373247df044cffd93d9bf8536, https://si.imgix.net/44b9b8c3/uploads/origins/68752c37-0b7f-4fcf-af99-2e8aa761e5dc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b0514646c4f2d920f75d3f83c2743d91 2x, https://si.imgix.net/44b9b8c3/uploads/origins/68752c37-0b7f-4fcf-af99-2e8aa761e5dc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=36eb2423bba31e876416a28d90e687e8 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/44b9b8c3/uploads/origins/68752