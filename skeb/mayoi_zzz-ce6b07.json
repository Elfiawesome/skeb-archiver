と尻尾・赤メガネ・アホ毛、そしてちょっぴりツリ目な目つきが特徴的な、160cmくらいの身長の子です。\n本とか、動物や花、星空のような自然をぼーっと見るのが大好きな子です。\n性格的には、ちょっと人見知りで照れ屋ですので人前では余計にクールっぷりしてるけどまた寂しがり屋のちょっと面倒くさい感じです。一人の時や知り合いの前では表情が緩めてちょっと豊かになる感じです。\nこれだけではちょっと説明が足りないと思いますので設定と設定画など、ご参考できそうなものを下のURLにまとめております。\n\nこの娘でまよすけ様の絵柄でのイラストをどうかお願いしたいです。\n衣装は設定画のうちの一つで、他はどうかご自由にお願いします。\nご検討くださいませ！\n\nお忙しい中、要件のみで申し訳ありません。\n応援しております！\n\nhttps://drive.google.com/drive/folders/1kVcp6B8dzGYFGpFb9spMTyDnz0TzyM7Q?usp=sharing", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 17324, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "naohito", "screen_name": "foxconcon", "avatar_url": "https://pbs.twimg.com/profile_images/1102626393697865728/lPQA6Q16.png", "header_url": "https://pbs.twimg.com/profile_banners/30403529/1551880748/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "art"}, {"genre": "correction"}], "banned": false, "nc": 32}, {"id": 110962, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "仂ｲｶ", "screen_name": "ikasyuumai", "avatar_url": "https://pbs.twimg.com/profile_images/1001532901287079936/72gnSM19.jpg", "header_url": "https://pbs.twimg.com/profile_banners/111878483/1708307738/1500x500", "appeal_receivable": true, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 120, "skills": [{"genre": "art"}], "banned": false, "nc": 177}, {"id": 1435346, "creator": true, "nsfw_acceptable": true, "acceptable": false, "name": "パカちゃん(シグリオ)", "screen_name": "PK_sigrio", "avatar_url": "https://pbs.twimg.com/profile_images/1803064802350080000/veabha6_.jpg", "header_url": "https