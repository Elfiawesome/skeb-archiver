。\n戦闘では勇ましく日本刀を振るっているのですが、普段はかわいらしく素直な性格で、色恋には疎いタイプです。\n【シチュエーション】\n朱音ちゃんがメイド服を借りてちょっといい感じの関係（信頼以上恋愛未満）にある男性の前に出て、恥ずかしがっています。目線はこちらを一度だけ見て、男性の表情を確かめている感じです。\n【服装】\nメイド服のドレスの色は黒で、袖は膨らんでいます。ドレスの襟と袖口は白です。白いエプロンはフリルに縁取られています。頭には白いフリルのついたカチューシャをつけています。\n自分はセンスがないのでざっくりとした指定しかできないのですが、うつぎさわさんのお好みで装飾していただいて構いません。\n【ポーズ】\nスカートが短いので、朱音ちゃんは顔を真っ赤にして両手でエプロン越しにスカートを下に引っ張っているポーズがいいです。\n【背景と塗りについて】\n背景は単色もしくはパターンがいいです。塗りはちょっと艶っぽくエロゲみたいな感じでお願いします。", "nc": 160, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@u2gi_sawawa/works/8", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 575300, "client_id": 290555, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/8e9923ac/uploads/origins/b6f128f6-72f6-42bf-8c6d-fabb3c68d054?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e569d55119401108e1162bc66dbfe679", "srcset": "https://si.imgix.net/8e9923ac/uploads/origins/b6f128f6-72f6-42bf-8c6d-fabb3c68d054?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e569d55119401108e1162bc66dbfe679, https://si.imgix.net/8e9923ac/uploads/origins/b6f128f6-72f6-42bf-8c6d-fabb3c68d054?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=562cfad4e5fbd0027ee78af20eba6767 2x, https://si.imgix.net/8e9923ac/uploads/origins/b6f128f6-72f6-42bf-8c6d-fabb3c68d054?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=2201011c2ea56e0318f23555f2cc9d6b 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/8e9923ac/uploads/origins/b6f128f6-72f6-42bf-8c6d-fabb3c68d054?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=42e160a74fed099d4530433eba5ef97d", "srcset": "https://si.imgix.net/8e9923ac/uploads/origins/b6f128f6-72f6-42bf-8c6d-fabb3c68d054?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur