6d-4801-8f19-954e79d1ea5c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=8543fb280ba61a72968c7a70ed24ef7a 2x, https://si.imgix.net/4fc5d992/uploads/origins/9bde3bc1-076d-4801-8f19-954e79d1ea5c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=34897ef844abed16e1465f3c39ed4151 3x"}, "body": "初めまして！\n作品を見て、太ももの描き方や、親密さを感じるポーズの表現がすごく素敵だと思い、リクエストさせていただきました。\n\n孫悟空モチーフの、成人女性の猿娘オリジナルキャラクターを描いていただきたいです！\n\n太もも、お腹、脇、胸、足裏など、少し無防備さを感じる部分が見える構図だと嬉しいです。この中から、選んでいただいたポーズに自然に合うものを、ひとつでもいくつか組み合わせても大丈夫です！\n\n彼女はかなりドジで天然な性格で、そのせいで本人はまったく自覚していないのに、すごく色っぽく見えてしまうような子です。\n\n衣装は普段のデフォルト衣装ではなく、彼女に似合うと思うものを自由に選んでいただけたら嬉しいです！\n\n彼女のドジで無自覚な雰囲気に合うように、服が少し着崩れていたり、片側のウエストが下がっていたり、パンツやショートパンツがずり落ちそうになっていたり、ブラやトップスのストラップが片方ずれていたりするのも似合うかなと思っています。\n\nこのあたりは全部あくまでイメージなので、どれかだけ使っていただいても、いくつか組み合わせていただいても、まったく別の表現にしていただいても大丈夫です！\n\n衣装や髪型、ポーズ、構図なども含めて、描きやすいように自由にアレンジしていただけたら嬉しいです。\n\n使用用途はSNSです。\n\nお忙しいところすみませんが、ご縁がありましたらご検討いただけると嬉しいです。\nよろしくお願いします！\n\nhttps://drive.google.com/drive/folders/1RuP4RVJR7SzWWeRzG19dNu9a24w2IxCy?usp=sharing", "nc": 161, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@kurotetete2/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3015245, "client_id": 3418468, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/06aa36df/uploads/origins/1fe39373-793a-41e9-8248-b6d5f2d69c02?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d1810cf7bfd7d0dde58005b9cfe5846a", "srcset": "https://si.imgix.net/06aa36df/uploads/origins/1fe39373-793a-41e9-8248-b6d5f2d69c02?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d1810cf7bfd7d0dde58005b9cfe5846a, https://si.imgix.net/06aa36df/uploads/origins/1fe39373-793a-41e9-8248-b6d5f2d69c02?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=7f0a2df15beae75e898de51371622e22 2x, https