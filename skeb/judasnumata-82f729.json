imgix.net/e82ea37f/requests/278772_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=ff3d597771c6a99c22adab1a7b4776d8 3x"}, "body": "テーマは「汚された人妻」でお願いします‼︎\n女性\n•新婚さん風\n•20代後半ぐらいで小柄な体格\n•大人しくて清楚な感じ\n•小さめの普乳(貧乳ではない)\n•全裸(重要)\n•そばに破れて散らかった服や下着\n•虚ろな目と表情(可能なら涙目)\n•結婚指輪が見えるように\n•ワキ毛無し\nその他\n•事後(最重要)\n•屋外(廃墟とか空き地)\n•暴力及び快感表現は無し\n•不良達は高校生くらいの年齢で3人ぐらい(増減､省略可)\nイメージとしては｢(待ち伏せ等ではなく)通りすがりに偶然､不良達の目にとまり…｣という感じで\n以上でお願いします‼︎", "nc": 40, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@judasnumata/works/14", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 313912, "client_id": 461653, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/ed8b5faf/requests/189859_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c4406af133d94845a0a726eac9f5f373", "srcset": "https://si.imgix.net/ed8b5faf/requests/189859_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c4406af133d94845a0a726eac9f5f373, https://si.imgix.net/ed8b5faf/requests/189859_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=6322fb76f34e7b3e11a54a7a22359e8f 2x, https://si.imgix.net/ed8b5faf/requests/189859_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ebf62e1e5c174fdb4040cbef92b74327 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/ed8b5faf/requests/189859_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=62f1a0d801da4d3324cd37aceecb6f35", "srcset": "https://si.imgix.net/ed8b5faf/requests/189859_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=62f1a0d801da4d3324cd37aceecb6f35, https://si.imgix.net/ed8b5faf/requests/189859_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=186ee8742f60a6c87ff72c224d62e210 2x, https://si.imgix.net/ed8b5faf/requests/189859_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=f714fbbb6ec9b894da9a3e86c5137d6d 3x"}, "body": "どうもこんにちは\nセイバーリリィに口で奉仕させて口内射精しているイラストをお願いします。\nどんな欲望も悦んで受け入れるリリィ相手に行為はエスカレートし、風呂場で犬耳とドッグベルトを着けさせ、未洗浄の逸物を綺麗に口で掃除させたのち、なおも熱心に吸い付く様子にご褒美の餌やりと称して飲精させるも恍惚とした表情でマスターの欲望を受け止めるというシチュで。\n素直に純粋な好意を寄せてくる上にその肢体でどんな欲望にも応え奉仕してくれるリリィに惚れこむと同時に溺れ、扱いこそ性欲解消の道具というがその実歪な関係でも相思相愛でむしろマスターがリリィに執着心を見せているというような関係で、よろしくお願いいたします。", "nc": 176, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@judasnumata/works/13", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 313912, "client_id": 461653, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/312be4d9/requests/173977_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=55fede08665595258b010174e90da74a", "srcset": "https://si.imgix.net/312be4d9/requests/173977_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=55fede08665595258b010174e90da74a, https://si.imgix.net/312be4d9/requests/173977_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=5e4b95314cca75e5f833710da71d4720 2x, https://si.imgix.net/312be4d9/requests/173977_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=00d22e91a9251ba900791ee63975495f 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/312be4d9/requests/173977_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=7f2ea86985d6a75b51bf820cbca738a6", "srcset": "https://si.imgix.net/312be4d9/requests/173977_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=7f2ea86985d6a75b51bf820cbca738a6, https://si.imgix.net/312be4d9/requests/173977_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fi