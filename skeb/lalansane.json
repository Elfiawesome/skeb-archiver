ebc7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=74a3ceae9c8362726d61b838d320dec2", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/926a6475/uploads/origins/bbe67913-7e35-4456-bba1-dea06365ebc7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=4ecac20d1f10d613eac0115696c71222", "src_set": ""}, "body": "ランサネ様\n\n海竜のモンスター娘のイラストの件で、お世話になりました。\n描いて頂いた海竜のモンスター娘のエ＝ラーグですが、1年半近くの長期キャンペーンを通して活躍してくれました。少し前に、そのキャンペーンも終わりを迎え、思い出として冒険の一幕を1枚絵でぜひとも欲しいなと思いまして、リスクエストを送らせて頂きました。\n\n以下のようなシチュエーションで描いていただけると幸いです。\n〇海底洞窟で宝箱を開けている。\n〇掘り出し物を手に入れた嬉しそうな表情をしている（具体的なお宝としては、宝玉を手に入れた感じです）\n△背後から不穏な気配が近づいている（イメージとしては、モンスターの影）\n※〇が優先度が高めで、△が低めという感じです。※\n\n用途としては、PCの壁紙として考えておりますので、横に長い形だと大変嬉しいです。\n\nお手数をお掛けいたしますが、ご検討いただけますと幸いです。 どうぞよろしくお願いいたします。\n\n参考資料\n\nhttps://drive.google.com/drive/folders/1qx31fPg8PVzdclcEWesCPlQCwd7K9tSl", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@lalansane/works/114", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 41570, "client_id": 512939, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/f5558ac0/uploads/origins/3671bbee-f22a-4343-b8b9-84e21c725d3e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4cc8a2c7c36f9f0678ef0b8a6a3b48c7", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/f5558ac0/uploads/origins/3671bbee-f22a-4343-b8b9-84e21c725d3e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2da4bc3a87cb22e307e44338fa6a4387", "src_set": ""}, "body": "こんにちは、ランサーンさん！リクエスト受付開始、ありがとうございます！ランサネさんの作品は昔から大好きで、イラストをお願いできる日を夢見ていました！😭\n\nオリジナルキャラクターのナビィとボサのイラストをお願いしたいです。どんなシーンやポーズでも構いません。オリジナルと現代のデザインの参考資料を添付しておきますので、お好きな方をお選びください。また、より自分のイメージに合うような衣装を新たにデザインしていただいても構いません。🙏\n\nリクエストに応えていただき、ありがとうございました！今日も素敵な一日をお過ごしいただき、素敵なリクエストがたくさん届きますように！😊。\n\nhttps://drive.google.com/drive/folders/1J9_r2vs54XMo-u9EYmcmxhln8OXqtMZQ?usp=drive_link", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@lalansane/works/113", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 41570, "client_id": 68662, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/c6a2b789/uploads/origins/4cb9f9ee-ec49-4508-a52d-3a5ee031a03e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e8b7c80d8c29ccf715200cc4344bf815", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/c6a2b789/uploads/origins/4cb9f9ee-ec49-4508-a52d-3a5ee031a03e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2107cc5d440f4d61520ad009c6ace6a6", "src_set": ""}, "body": "こんにちは、ランサネさま！\nサネさま、こんにちは！サネさまのキャラクターに息吹を吹き込むところが大好きです！\n\n私のVTuberを描いてくれませんか？彼女はモンスターガールのようなエイリアンです。青灰色の肌、角（耳はない）、異色症、そして大きな長い尻尾を持っています。\n\n彼女がもっとモンスターガールになるのを見たい。彼女の髪をリボン状の触手のようにしようかと考えている。\n\n彼女は別の惑星から宇宙の熱死を防ぐために人類の助けを求めてやってきたが、SCPのように扱われた。人類は助けを拒むので、彼女は宇宙間の裂け目を開く能力で惑星を破壊すると脅す。\n\nひび割れたガラス越しに見るイラストが好きだ。たぶん、封じ込められた独房の中か、彼女が外にいる宇宙ステーションの中だろう。さらに効果を上げるために、彼女の目を光らせるのもいいだろう。\nあるいは、もっとかわいいイラストで、彼女が学校（あるいはOL）の制服を着て奮闘しているイラスト。ドアに尻尾が挟まらないようにする。堕落する前は科学者として働いていた。\nあなたにお任せします！\n\nご検討ありがとうございました！\n\nhttps://drive.google.com/drive/folders/1D0UxkPnDqSphqpe0-w7o1fzMl4CKwGN2?usp=sharing", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@lalansane/works/112", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 41570, "client_id": 2524423, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/5750409d/uploads/origins/c5659b7f-12b5-4fe0-8070-c8cadf68c2c7?bg=%23fff&auto=format%2Ccomp