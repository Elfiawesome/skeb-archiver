うか。\n\n[ポーズ]\nお任せでお願い出来ますでしょうか。\n\n[納品物]\n背景と分かれたキャラクター単体ファイルも頂けると助かります。\nAI生成ツール使用無し希望です。\n\n\n▼参考イラスト２点▼\nhttps://x.com/zakurorain/status/1824790608357347654\nhttps://x.com/zakurorain/status/1813232296180523156", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@haruusa12288/works/1", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/db1205ac/uploads/origins/4759fd93-4535-44fa-99f2-3141ac9baa71?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=13e2f924fa3c5aed75ca5a0adeac8053", "srcset": "https://si.imgix.net/db1205ac/uploads/origins/4759fd93-4535-44fa-99f2-3141ac9baa71?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=13e2f924fa3c5aed75ca5a0adeac8053, https://si.imgix.net/db1205ac/uploads/origins/4759fd93-4535-44fa-99f2-3141ac9baa71?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=415d46cae2089d090d6d0fd8ca203847 2x, https://si.imgix.net/db1205ac/uploads/origins/4759fd93-4535-44fa-99f2-3141ac9baa71?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=614265fffa4e9d6b1ade0f1d0ecd84c9 3x"}, "private": true, "genre": "art", "tipped": false, "creator_id": 3958548, "nc": 17}], "sent_works": [], "similar_creators": [{"id": 850706, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "ふうま ちい✨Comms Open✨", "screen_name": "huumachii", "avatar_url": "https://pbs.twimg.com/profile_images/2025157240450359296/0OHs9tTQ.jpg", "header_url": "https://pbs.twimg.com/profile_banners/151036821/1727383911/1500x500", "appeal_receivable": fa