ut\n\nI would like to use this illustration in a song cover video. Thank you!\n\nhttps://minervamurasaki.carrd.co/#about", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@0zero_kisaragi/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2332459, "client_id": 2433424, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/70ee92c7/uploads/origins/a3952117-3fa4-4442-a455-aee621adc12d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=79d64e4d52485954c50e31c7892f73fc", "srcset": "https://si.imgix.net/70ee92c7/uploads/origins/a3952117-3fa4-4442-a455-aee621adc12d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=79d64e4d52485954c50e31c7892f73fc, https://si.imgix.net/70ee92c7/uploads/origins/a3952117-3fa4-4442-a455-aee621adc12d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f44271b09c2130080fa9cd78d2687f27 2x, https://si.imgix.net/70ee92c7/uploads/origins/a3952117-3fa4-4442-a455-aee621adc12d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a1997f9f915eca0ed4e3b40621a8201e 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/70ee92c7/uploads/origins/a3952117-3fa4-4442-a455-aee621adc12d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f6765bfb654ddadb09cdb746ca457f5d", "srcset": "https://si.imgix.net/70ee92c7/uploads/origins/a3952117-3fa4-4442-a455-aee621adc12d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f6765bfb654ddadb09cdb746ca457f5d, https://si.imgix.net/70ee92c7/uploads/origins/a3952117-3fa4-4442-a455-aee621adc12d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=7bbc125ba63dea01a1fa0fd79232d5e5 2x, https://si.imgix.net/70ee92c7/uploads/origins/a3952117-3fa4-444