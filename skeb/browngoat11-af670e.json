うに描いて頂ければと思います。\n\n◇リクエスト概要\n拙作の創作キャラ♂のイラスト（添付画像参の青髪の男性）\n・容姿：暗めの青髪、襟足がやや長い・三白眼気味の赤い目・スーツ着用、年齢はアラサー\n・愛煙家\n・飄々とした男性\n\n遊山羊さんの描かれる男性大好きなので好きに描いて頂いて構いません。\n衣装はスーツであれば、デザイン・配色等お任せします。\n表情などもイラストの雰囲気で好きに描いて頂いて大丈夫です。喜怒哀楽、おおよその表情はするキャラクターです。\n\n◇許可頂きたい事\n・当方の個人サイトに頂き物として、作者情報付きでイラストの展示\n\n以上\n\nこれからもご活躍を楽しみにしております。\n\nhttps://www.dropbox.com/sh/c905h0ew5xl954e/AACn4jTSrfXrh38vYL0B4io1a?dl=0\n\nhttps://www.dropbox.com/scl/fo/jc2mf3qcdv9vfzi27kbvh/h?dl=0&rlkey=8g1no4vvbi0ljk01hiz1vojdx", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}], "sent_works": [{"path": "/@7nty28/works/14", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 785992, "client_id": 2068921, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/5fcc04b9/uploads/origins/0b1a2e89-4e21-4d06-8ce8-5de9bd6d3f94?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=310b0f28e5e92c68875a6c8425d8c788", "srcset": "https://si.imgix.net/5fcc04b9/uploads/origins/0b1a2e89-4e21-4d06-8ce8-5de9bd6d3f94?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=310b0f28e5e92c68875a6c8425d8c788, https://si.imgix.net/5fcc04b9/uploads/origins/0b1a2e89-4e21-4d06-8ce8-5de9bd6d3f94?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=35eff40bf77c5689f810e438cf24028a 2x, https://si.imgix.net/5fcc04b9/uploads/origins/0b1a2e89-4e21-4d06-8ce8-5de9bd6d3f94?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=317c3b7d4c1a87c1d78c0b0c7f810aec 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/5fcc04b9/uploads/origins/0b1a2e89-4e21-4d06-8ce8-5de9bd6d3f94?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=827c3bf066373011c5802882bc7e0f30", "srcset": "https://si.imgix.net/5fcc04b9/uploads/origins/0b1a2e89-4e21-4d06-8ce8-5de9bd6d3f94?bg=%23fff&auto=f