laylist?list=PLYuTEKWbxwF-dBfhClt5tkRtT-haqczt0\n\n以上です。\n何卒よろしくお願いいたします！", "nc": 40, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@noeru_tsukikawa/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 51146, "client_id": 318030, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/1e38bcd6/uploads/origins/9c3a1c6b-5f93-41a6-b41e-4547eefce676?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ca8d454b2dbc4965d11ca29edbf025d4", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": true, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/1e38bcd6/uploads/origins/9c3a1c6b-5f93-41a6-b41e-4547eefce676?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=fc73e6ac6c6c863c9e505c2ff425a921", "src_set": ""}, "body": "始めまして、RTで流れて参りましたぬぽっとした触手絵に惹かれて参りました。\n\nそこで別の方にクリエイトしていただいたオリジナルキャラクターで恐縮ですが、\n資料の銀髪褐色メスガキギザ歯貧乳刺青ロリダークエルフのカティちゃんが触手にぬぽっとエッチな事をされてしまう所をお願いいたします。\n中出しや種付け、触手出産までエッチな事ならばどんなプレイでも構いませんのでうちの子にエッチな事を！\n\n「うちの子の触手エッチ」その他条件は一切ありません。\n\nご検討よろしくお願いいたします。\n\nご参考\nhttps://twitter.com/wagunasu_TS/status/1298940810973470720\n\nhttps://drive.google.com/file/d/1BVeDyF5KxNPr5mxgqMXxd0tYgtlOSsoT/view?usp=sharing", "nc": 170, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "similar_creators": [{"id": 7078, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "Higle_", "screen_name": "Higle_", "avatar_url": "https://pbs.twimg.com/profile_images/1596343002418802688/vqAG9Kqe.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1068480720279023622/1712316568/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 5, "skills": [{"genre": "art"}], "nc": 48}, {"id": 77246, "creator": true, "nsfw_accept