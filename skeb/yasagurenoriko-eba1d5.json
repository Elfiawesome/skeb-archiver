美胡ちゃんが、リビングのソファーでくつろんでいた汐莉さんを押し倒して事故ってキスしてしまったタイミングに比名子ちゃんがお茶を運びに台所との間の引き戸を開けた瞬間をお願いします。\n\n服装は、三人とも夏らしくガーリーな感じで、細かい点は夏師先生に御一任します。\n\nなお、「違うの比名子！」みたいな感じの表情をしたチビキャラ美胡ちゃんと「たはー」という感じのいつもの笑顔をした汐莉さんのチビキャラを描き添えていただけますと幸いです。", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@yasagurenoriko/works/15", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1948815, "client_id": 3918376, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/aea90e8f/uploads/origins/4dc0805f-0219-4483-a62d-0ca88f518e49?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ed1de73d5fc522527e7eca332df0fc19", "srcset": "https://si.imgix.net/aea90e8f/uploads/origins/4dc0805f-0219-4483-a62d-0ca88f518e49?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ed1de73d5fc522527e7eca332df0fc19, https://si.imgix.net/aea90e8f/uploads/origins/4dc0805f-0219-4483-a62d-0ca88f518e49?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=0fa4dada240e156dbca2f6faecf391b5 2x, https://si.imgix.net/aea90e8f/uploads/origins/4dc0805f-0219-4483-a62d-0ca88f518e49?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=8701cab3b1f890752f6174480c92850e 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/aea90e8f/uploads/origins/4dc0805f-0219-4483-a62d-0ca88f518e49?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a637202758f463992e19e0f25787c5a2", "srcset": "https://si.imgix.net/aea90e8f/uploads/origins/4dc0805f-0219-4483-a62d-0ca88f518e49?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a637202758f463992e19e0f25787c5a2, https://si.imgix.net/aea90e8f/uploads/origins/4dc0805f-0219-4483-a62d-0ca88f518e49?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=9c