です。\n\n■使用用途\n・収益化した動画や配信・サムネイルでの使用、SNS(Twitter・YouTube・Twitchなど)\n\nお手数おかけしますが、不備や金額不足等ございましたらキャンセルまたは再送依頼をしていただけますと幸いです。\nご検討よろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/1oPblYf6AD27UMdp9MR27emBpMOlSoDx5?usp=sharing", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 383290, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "ハセガワいむ", "screen_name": "imuuun_", "avatar_url": "https://pbs.twimg.com/profile_images/2000531083683930113/7rJqRcII.png", "header_url": "https://pbs.twimg.com/profile_banners/726038232182333440/1749213404/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "art"}], "nc": 1}, {"id": 1726360, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "でむり", "screen_name": "volmohisca", "avatar_url": "https://proxy.misskeyusercontent.jp/avatar.webp?url=https%3A%2F%2Fmedia.misskeyusercontent.jp%2Fio%2Fwebpublic-d7202a5c-4309-4563-b140-2f8ec30173df.webp&avatar=1", "header_url": null, "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 90, "skills": [{"genre": "art"}], "nc": 153}, {"id": 2941281, "creator": true, "nsfw_acceptable": false, "acceptable": false, "name": "ねむすし", "screen_name": "htnnm_z", "avatar_url": "https://pbs.twimg.com/profile_images/1976547197278953472/c5ikygWC.png", "header_url": "https://pbs.twimg.com/profile_banners/920678086965727233/1701480523/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_ex