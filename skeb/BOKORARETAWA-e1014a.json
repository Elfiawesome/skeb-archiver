.net/7448312d/uploads/origins/c24de55e-0b86-49d7-8be6-584b8a039226?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5c9f425d22d6833ef56db17bcee99edb", "srcset": "https://si.imgix.net/7448312d/uploads/origins/c24de55e-0b86-49d7-8be6-584b8a039226?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5c9f425d22d6833ef56db17bcee99edb, https://si.imgix.net/7448312d/uploads/origins/c24de55e-0b86-49d7-8be6-584b8a039226?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=59744558439c0ca25cbee9e0cfb12a7f 2x, https://si.imgix.net/7448312d/uploads/origins/c24de55e-0b86-49d7-8be6-584b8a039226?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=25425d77f86ed90b71765ab6d66f1a97 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/7448312d/uploads/origins/c24de55e-0b86-49d7-8be6-584b8a039226?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=47dc9a87e999a843a8815a9bc43e862d", "srcset": "https://si.imgix.net/7448312d/uploads/origins/c24de55e-0b86-49d7-8be6-584b8a039226?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=47dc9a87e999a843a8815a9bc43e862d, https://si.imgix.net/7448312d/uploads/origins/c24de55e-0b86-49d7-8be6-584b8a039226?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=748af648c31e23f75975138863926c5b 2x, https://si.imgix.net/7448312d/uploads/origins/c24de55e-0b86-49d7-8be6-584b8a039226?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=0645c96392559a5ffa838d9cc897b491 3x"}, "body": "こんにちは！私はあなたのアートワークが大好きです!\n私のキャラクターをどう描くか見てみたいわ！\nクリエイティブな自由を存分に発揮してください！\n\n\n\n私のキャラクターは復讐に燃える女王です！\nホラーとダークネスが大好きですが、甘くて優しい一面もあります。\n参考画像を3つ紹介します！\nhttps://drive.google.com/drive/folders/1n5TvsLBKuyxgJQZIuoUmnK-rhlJUfKU7?usp=sharing\n\n私は黒髪で、後ろ髪は濃い緑色に染めています。\n舌も緑色で、ほんの少し明るいです。上下の歯に「吸血鬼の歯」が