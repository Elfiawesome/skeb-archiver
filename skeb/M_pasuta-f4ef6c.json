t%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=854e3010e23a9e3b11b416666f10c4bb 3x"}, "private": true, "genre": "art", "tipped": false, "creator_id": 2457454, "client_id": 2040094, "nc": 16}, {"path": "/@M_pasuta/works/9", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2457454, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/60b6218d/uploads/origins/66a5bd62-db76-4c7d-b30f-f4bf9432a19f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=858a6f48feeeff29a33e10a43d988905", "srcset": "https://si.imgix.net/60b6218d/uploads/origins/66a5bd62-db76-4c7d-b30f-f4bf9432a19f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=858a6f48feeeff29a33e10a43d988905, https://si.imgix.net/60b6218d/uploads/origins/66a5bd62-db76-4c7d-b30f-f4bf9432a19f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=4e810bb243a8860fb16a4fadcbf2e425 2x, https://si.imgix.net/60b6218d/uploads/origins/66a5bd62-db76-4c7d-b30f-f4bf9432a19f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=43a6959eb2d9d83c76f8f15b32025f84 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/60b6218d/uploads/origins/66a5bd62-db76-4c7d-b30f-f4bf9432a19f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=234e2f5435442fc5dc7d7e55c359a190", "srcset": "https://si.imgix.net/60b6218d/uploads/origins/66a5bd62-db76-4c7d-b30f-f4bf9432a19f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=234e2f5435442fc5dc7d7e55c359a190, https://si.imgix.net/60b6218d/uploads/origins/66a5bd62-db76-4c7d-b30f-f4bf9432a19f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=bbaf0f7ddb222cf9ae6265e6242a16e6 2x, https://si.imgix.net/60b6218d/uploads/origins/66a5bd62-db76-4c7d-b30f-f4bf9432a19f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=fd8c2a67601d77fcda4c2b5b02f770b5 3x"}, "body": "こんにちは！はじめまして。ななしの紬と申します。\n今回のskebのご依頼なのですが、異能警察は英雄じゃない、自陣のハロウィンコスを描いていただけないかと思いご連絡させていただきました。\nskeb納品報告のツリーを見て、チミチミした子たちもとても可愛いな、と思いました。\n難しいようでしたら取り消ししていただいて大丈夫ですっ💦\n\nHO正義 唯一の女性。物静かで穏やかだが厳しい一面もある、奥ゆかしい副チーフ。35歳とやや歳上なのを気にしているが、コスプレをしてほしいと頼んだら恥ずかしがりながらしてくれる可愛い人。シスター希望。\n\nHO恋心 27歳男性。NPC柏木双葉と相思相愛だが付き合ってはいない。見た目に似合わずピュアでムードメーカー。とにかく明るくて優しい子。コスプレはノリノリでしてくれる。狼男希望。\n\nHO仲間 27歳男性。みんなの相談役。比較的穏やかだがノリがいい所もある。ドーナツ作りが趣味。1番体格がデカイので、コスプレはフランケンシュタインが似合うと思われる。コスしてもニコニコしてる。\n\nHO疑念 25歳男性。物静かだが少し幼さの残る言動で可愛がられている。辛いもの(中華)がすき。言葉遣いがたまに荒くなる。コスはみんながするならやってくれる。キョンシー希望。\n\n以下に参考資料として卓報告のスクショを添付致します。\n\nhttps://drive.google.com/file/d/1h_xX-q0_e3B8AhGS5nXyTpnJ48nJ3DU2/view?usp=drivesdk", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@M_pasuta/works/8", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/9453107c/uploads/origins/088dcc78-8765-437a-8e74-f93cb50f0548?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=ed597251a4468a63a1f1c1ef329788f6", "srcset": "https://si.imgix.net/9453107c/uploads/origins/088dcc78-8765-437a-8e74-f93cb50f0548?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=ed597251a4468a63a1f1c1ef329788f6, https://si.imgix.net/9453107c/uploads/origins/088dcc78-8765-437a-8e74-f93cb50f0548?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=3c6d52017a607496da4d2fd61597f2c8 2x, https://si.imgix.net/9453107c/uploads/origins/088dcc78-8765-437a-8e74-f93cb50f0548?bg=