op=top&w=200&h=200&blur=200&s=984168df8846fca89fc6ac44129382b2, https://si.imgix.net/cc5f51ba/uploads/origins/7b9fef69-d502-41ae-b980-5276df259a31?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=60dcdf375a1bf8409caeabd13f504ee8 2x, https://si.imgix.net/cc5f51ba/uploads/origins/7b9fef69-d502-41ae-b980-5276df259a31?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=2f3140dbf6a733ad368d8e5c3dd5302d 3x"}, "body": "OCの一枚絵とはだけ差分をお願いいたします。 (全身の姿、身体の絵の入り方が見たくて…！) \n\n構図としては仰向けの人の上に乗っかってその腹を撫でながら(だいすき…最高…全部訳分かんなくしてやりてえ……)とか考えながら良い(悪い)笑顔で見下ろしてる、下の子から見たイメージでどうでしょうか。  髪はハーフアップのまま、少しバラけて背中で泳いでると嬉しいです(長髪カーテン的な ？)\n笑顔にした際に八重歯や舌がチラ見えしてると更に最高です。\n\n文章おかしいところ多くてすみません。\n差分は絶対ではありません。無理はせず作業いただけたらと思います。 \n\nとても好みに刺さるキャラデザなので全身が見たいが故のリクエストになり、丸投げ感多くてすみません…！ 何卒よろしくお願いいたします！\n\nhttps://drive.google.com/drive/folders/1nHoxavu4pkOvvDumgsw7mEwAV4_zm-mL", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@senchihi_1000/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3507176, "client_id": 422632, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/49c025c9/uploads/origins/9f850317-b1cd-4b9d-b2fa-8b559a92b0cf?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5a21b2dc97d2f95e536524d20630d7d0", "srcset": "https://si.imgix.net/49c025c9/uploads/origins/9f850317-b1cd-4b9d-b2fa-8b559a92b0cf?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5a21b2dc97d2f95e536524d20630d7d0, https://si.imgix.net/49c025c9/uploads/origins/9f850317-b1cd-4b9d-b2fa-8b559a92b0cf?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=bd874abe2ebe3590a5648d2ad8da1f0e 2x, https://si.imgix.net/49c025c9/uploads/origins/9f850317-b1cd-4b9d-b2fa-8b559a92b0cf?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d9467ec5920b47493620b4ed35de4423 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/49c025c9/uploads/origins/9f850317-b1cd-4b9d-b2fa-8b559a92b0cf?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f2374776a7819d785690298516a44ad4", "srcset": "https://si.imgix.net/49c025c9/uploads/origins/9f850317-b1cd-4b9d-b2fa-8b559a92b0cf?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f2374776a7819d785690298516a44ad4, https://si.imgix.net/49c025c9/uploads/origins/9f850317-b1cd-4b9d-b2fa-8b559a92b0cf?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=09259c68a82df49c9a15db10fb1294f7 2x, https://si.imgix.net/49c025c9/uploads/origins/9f850317-b1cd-4b9d-b2fa-8b559a92b0cf?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=0c3c31b9760f749ada1bfa32a2191fe1 3x"}, "body": "リクエスト失礼します。\nOCのキャラデザ依頼ですが大丈夫でしょうか？ 其方の古賀さんが途轍もなく好みでして… 似たような雰囲気の依頼になりそうなこと、ご了承ください…。\n\n◾︎特に欲しい特徴  (描写出来る範囲はおまかせします、刺青とか)\n長髪、前髪あり(長いと最高)、メッシュ入ってると泣いて喜びます、普段はハーフアップか一纏めにしている、目つきが悪い三白眼(SENさんの目の絵柄マジで大好きです)、ドS攻め側、八重歯か犬歯デカめだと嬉しい、下腹部や太腿辺りなど脱いだ時にだけ見える場所に蛇モチーフの刺青がある、普通に笑うと良い人そうなのに受けが絡むと急変ヤバイカレ笑いになる(ギャップ)、受けがモデル体型なので更に身長高め(188cmとか)のイメージで出してもらえると嬉しい、筋肉(雄っぱい)はあって困らない腕の太さもあっても困らない\n\n性格は良識あるサイコサド。受けが好き過ぎて受けに対してだけヤンデレ度がヤバい執着愛の塊。裏社会の上の方のイイトコで生きてるのでヤクにも玩具にも精通している。戦闘もできる。上記の蛇の刺青のお揃いをいつか受けに入れたいと夢みてる(でもそこは無理強いはしない)(やさしい)(そうかな？)。ドSでヤの人系で執着愛なので乱暴もするけど、受けもM度が強いので受け入れてくれる相思相愛たちです、傍から見るとヤバいだけで。\n\n全体のカラーリング、刺青の量、アクセサリー系は自分にセンスが無いのでおまかせします。服装もセンスが無いのでアレですが… ｴｯｯベルトや胸元はだけ服とか好きです。\nNGは可愛い系(キュートやプリティー)にならないことくらいでしょうか。\n\n\n受けはこちらのOCで、脳内妄想CPで扱う予定です。受けの資料を載せておきます。美の塊ですんごいドM！！ と認識してもらってれば大丈夫だと思います！\n\n今後、制作いただいたイラストを参考資料として絵師様に出す可能性があります。イラスト内にサインを入れておいていただけると嬉しいです。\n\nごちゃごちゃ長文乱文失礼しました。\n承認いただけた際には何卒よろしくお願いいたします…！\n\nhttps://drive.google.com/drive/folders/1oQdhbbOYEUlPXqSMMjN1dAmoh4SlT24B", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_sam