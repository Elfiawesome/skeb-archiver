でアップであれば、どんなヘアスタイルでも良いです\n・水着のデザインはお任せしますが、淡い黄緑で柄はギンガムチェックが良いです(浮輪は苺柄or哺乳瓶だと可愛い)\n・水鉄砲は、スプラトゥーンの「わかば」という武器だと嬉しいです(インクではなく水が良いです)※わかばじゃなくても大丈夫です\n\n人物と背景やアイテムは別レイヤーで透過で頂きたく、表情差分もあれば嬉しいです！\nまた、もし良ければ肩に乗ってる「ぴえたくん」という柴犬みたいなうさぎも描いて頂けると嬉しいです！(肩でも頭でも別でも◎)\n\n 【使用用途】\n・SNS(おはV等)\n・収益化しているチャンネルでのサムネイルや動画\n・メンシプの待受画像で配布\n・ネットプリント\n\n参考画像は、@OriOriko_chの固ツイを見て頂けますと幸いです。\n宜しくお願い致します。\n\nもし、無理でしたらお断りしてください◎\n\nhttps://x.com/orioriko_ch/status/1785866373912264962?s=46&t=uomlb5jFG7GrLK7DNJ2xmA\n\nhttps://x.com/orioriko_ch/status/1785866373912264962?s=46&t=uomlb5jFG7GrLK7DNJ2xmA", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@kisaunite/works/13", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1656955, "client_id": 2930102, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/dd13f66f/uploads/origins/5a8c5637-446e-4112-9e5e-90ec77ed9f61?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c668f8636cd6892cdae6b655937100d1", "srcset": "https://si.imgix.net/dd13f66f/uploads/origins/5a8c5637-446e-4112-9e5e-90ec77ed9f61?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c668f8636cd6892cdae6b655937100d1, https://si.imgix.net/dd13f66f/uploads/origins/5a8c5637-446e-4112-9e5e-90ec77ed9f61?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=6d319654bf6c2b5979930608e0d47a90 2x, https://si.imgix.net/dd13f66f/uploads/origins/5a8c5637-446e-4112-9e5e-90ec77ed9f61?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=6254607771a9c974d2becb25c1822eb8 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/dd13f66f/uploads/origins/5a8c5637-446e-4112-9e5e-90ec77ed9f61?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2e6bc588444598f1f081c7d45253619e", "srcset": "https://si.imgix.net/dd