op&crop=top&w=200&h=200&blur=200&s=c9d137b40c4dc06941f6530ea2b792e2", "srcset": "https://si.imgix.net/c2a16c81/uploads/origins/acf38d61-8f9d-4049-8df3-b7e975fc4e2f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c9d137b40c4dc06941f6530ea2b792e2, https://si.imgix.net/c2a16c81/uploads/origins/acf38d61-8f9d-4049-8df3-b7e975fc4e2f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=959cb95cf883e00b032a35dd46883bb4 2x, https://si.imgix.net/c2a16c81/uploads/origins/acf38d61-8f9d-4049-8df3-b7e975fc4e2f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=5b21c82169a72e2b1206a346883a8503 3x"}, "body": "こんばんは。\n素敵な主観舌出しイラストを拝見しぜひSkebをお願いしたいと思いご連絡いたしました。\n\nFE風花雪月のソティスが自身の大きな舌を見せつけて挑発するイラストをお願い致します。\n\nシチュエーションとしましては、ソティスが自身の巨大な舌のみで翻弄、打ち倒した相手に対して\n「この舌1枚のみしか使っていないのじゃが、もう終わりか？」「逃げぬというのならこの分厚い舌を巻きつけてわしの唾の匂いをより一層味あわせてやるぞ❤️」\nと余裕げに舌を真下に伸ばし煽っている。\n\nソティスの舌のサイズは過去最大級、例を挙げさせていただきますと「https://skeb.jp/@tukune_oishiine/works/10」と同等〜それ以上のイメージでお願いしたいです。\n\nご多忙のところ恐れ入りますが、ご検討いただけましたら幸いです。何卒よろしくお願い申し上げます。", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@tukune_oishiine/works/10", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2710590, "client_id": 2922868, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/79374b1a/uploads/origins/0c50713e-501d-4532-a7b3-2f9ad4a87c7e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=07506e94235aa65ee67a1b9d3636a233", "srcset": "https://si.imgix.net/79374b1a/uploads/origins/0c50713e-501d-4532-a7b3-2f9ad4a87c7e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=07506e94235aa65ee67a1b9d3636a233, https://si.imgix.net/79374b1a/uploads/origins/0c50713e-501d-4532-a7b3-2f9ad4a87c7e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=0ad793b04ec2cd9bd3394ecded688955 2x, https://si.imgix.net/79374b1a/uploads/origins/0c50713e-501d-4532-a7b3-2f9ad4a87c7e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d8cdd27d4b505fa15861cece3df941fc 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/79374b1a/uploads/origins/0c50713e-501d-4532-a7b3-2f9ad4a87c7e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=884829dec730d92a3aa700ffea2308b4", "srcset": "https://si.imgix.net/79374b1a/uploads/origins/0c50713e-501d-4532-a7b3-2f9ad4a87c7e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=884829dec730d92a3aa700ffea2308b4, https://si.imgix.net/79374b1a/uploads/origins/0c50713e-501d-4532-a7b3-2f9ad4a87c7e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=30550fefcf5ba3ea9ee938b5ea730d15 2x, https://si.imgix.net/79374b1a/uploads/origins/0c50713e-501d-4532-a7b3-2f9ad4a87c7e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=11b8b755b95a6a00e709e9eaaa33e06c 3x"}, "body": "お久しぶりです。ニッチな依頼にはなりますが、再びリクエストさせていただきます。\n\nだがしかしの枝垂ほたるによる主観舌出し＋αイラストをお願いしたいと思います。\n\nシチュエーションは\n少し前につくねさんが描かれた狂三並に巨大な舌を、見せつけるように無邪気な感じで伸ばしているほたる。\nそこを目掛けてチョコとミルクが勢いよく放たれているだけでなく、舌先でふ菓子を舐め回しており、舌の中央の方には飴玉がいくつか乗っかっている。\nこうした状況に対し彼女は「私の舌は色んな駄菓子の味を覚え続けた結果ここまで大きくなったの❤️」「いくらでもちょうだい　一つ一つ正確に種類を当ててあげるわ❤️」的な台詞で応えており、自身の巨舌(味覚)の限界に挑戦しようとしている。\n\n以上となります。色々と細かくてすみません。 \nもしよろしければ引き受けてくださると大変ありがたいです。", "nc": 160, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@tukune_oishiine/works/9", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2710590, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/a9b8ca99/uploads/origins/9ecca999-c235-4633-9563-aa4b9c80af4c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7ff28bb7adb0f20567ca6d189a