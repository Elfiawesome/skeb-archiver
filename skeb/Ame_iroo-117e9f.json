.net/artworks/121375052\n妖狐堕ちした女性をはるしぐれさんに妖艶な表情恰好ポーズで描いていただきたいです\n(うちの子の持ち主の方に許可いただいています)\nお腹のマークは描いていただきたいのと下腹部は健全的にアレンジ、わかりづらい、複雑なところは簡略化していただいて大丈夫です\n描いていただいたものはお借りした方にもお渡し、ミスキーディスコなどで紹介もと思います\n宛名はpsdレイヤーでon/offお願いします\nよろしくおねがいします", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@Ame_iroo/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2283402, "client_id": 2821611, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/b6720d45/uploads/origins/9258506b-e944-4dc7-bff8-43705ccb5636?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a044b29efff74937699d4f252a6941ae", "srcset": "https://si.imgix.net/b6720d45/uploads/origins/9258506b-e944-4dc7-bff8-43705ccb5636?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a044b29efff74937699d4f252a6941ae, https://si.imgix.net/b6720d45/uploads/origins/9258506b-e944-4dc7-bff8-43705ccb5636?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=395384422dd3a0b913db49579ed1dca6 2x, https://si.imgix.net/b6720d45/uploads/origins/9258506b-e944-4dc7-bff8-43705ccb5636?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=46dfe80afec18dd48d18238be2c4fec0 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/b6720d45/uploads/origins/9258506b-e944-4dc7-bff8-43705ccb5636?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=eedeaf0b4743e75adedbf588ac28562b", "srcset": "https://si.imgix.net/b6720d45/uploads/origins/9258506b-e944-4dc7-bff8-43705ccb5636?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=eedeaf0b4743e75adedbf588ac28562b, https://si.imgix.net/b6720d45/uploads/origins/9258506b-e944-4dc7-bff8-43705ccb5636?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blu