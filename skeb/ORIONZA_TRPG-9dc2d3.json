たらな～～～と思います！全部お任せです！！\nキャラクターの解釈は自由にお願いします！！分からないところがあれば想像で描いてもらえると嬉しいです！！！あと、天かすさんのサインあれば書き込んで頂けるとむちゃ嬉しいです！！！！！！\n\n何卒よろしくお願いします！！！！！！！！！！", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@ORIONZA_TRPG/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 972672, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/b09a38b0/uploads/origins/37881247-0e09-465d-9017-2293adab41d9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4a4d0107231c6a25a01c7320602e2a3a", "srcset": "https://si.imgix.net/b09a38b0/uploads/origins/37881247-0e09-465d-9017-2293adab41d9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4a4d0107231c6a25a01c7320602e2a3a, https://si.imgix.net/b09a38b0/uploads/origins/37881247-0e09-465d-9017-2293adab41d9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=7560a4b86cbc2cd408fc03b8e13ba617 2x, https://si.imgix.net/b09a38b0/uploads/origins/37881247-0e09-465d-9017-2293adab41d9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=92c340d44814fa6ee280ac11e26b55a5 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/b09a38b0/uploads/origins/37881247-0e09-465d-9017-2293adab41d9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3fcb051ccd01d945d29dd0b34ef3671b", "srcset": "https://si.imgix.net/b09a38b0/uploads/origins/37881247-0e09-465d-9017-2293adab41d9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3fcb051ccd01d945d29dd0b34ef3671b, https://si.imgix.net/b09a38b0/uploads/origins/37881247-0e09-465d-9017-2293adab41d9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=b87375cd05299ff244e0dc0c0f3daf17 2x, https://si.imgix.net/b09a38b0/uploads/origins/37881247-0e09-465d-901