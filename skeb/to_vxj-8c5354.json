完璧\"を追い求めますが、來明は自分の前だけでもいいから天音に自然体でいて欲しいと思っています。\n\n【要望など】\n構図、衣装、シチュエーションなど、全ておまかせいたします。自由に解釈して描いてくださると嬉しいです。\n\n【使用用途】 \n鑑賞用やSNSのアイコンヘッダー等での使用、個人利用の範囲でのグッズ制作 etc...\n\n金額に不足などあればお手数ですが再送申請をお願いします。是非ともご検討宜しくお願い致します。ありがとうございました。", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@to_vxj/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3103239, "client_id": 1829018, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/61f99ff8/uploads/origins/42980cc7-1f02-4e49-9c76-69e8eb935797?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=91158c90855e4f464ab24dc0ddf9b7be", "srcset": "https://si.imgix.net/61f99ff8/uploads/origins/42980cc7-1f02-4e49-9c76-69e8eb935797?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=91158c90855e4f464ab24dc0ddf9b7be, https://si.imgix.net/61f99ff8/uploads/origins/42980cc7-1f02-4e49-9c76-69e8eb935797?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c62c6f0ddde32cd828922134d29018f5 2x, https://si.imgix.net/61f99ff8/uploads/origins/42980cc7-1f02-4e49-9c76-69e8eb935797?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=4dae00f11d9b70ccff2b552b0db12d85 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/61f99ff8/uploads/origins/42980cc7-1f02-4e49-9c76-69e8eb935797?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b62374e65795883ffa7d30279717e981", "srcset": "https://si.imgix.net/61f99ff8/uploads/origins/42980cc7-1f02-4e49-9c76-69e8eb935797?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b62374e65795883ffa7d30279717e981, https://si.imgix.net/61f99ff8/uploads/origins/42980cc7-1f02-4e49-9c76-69e8eb935797?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=