g\n\n・ツインテール中国結びお団子ヘアー\n・羽織\n・八重歯\n・細めのまろ眉\n\n中華風の書斎で、私が竹簡を解読しようとしているイラストだととても嬉しいです！\n細かな構図やポーズなどは、お任せしても大丈夫でしょうか…？\n服装や装飾品、小物などにつきましては、アレンジしていただいて大丈夫です。\n\n要望が多く、申し訳ございません。\n\n----------------------\nお忙しいところ恐縮ですが、何卒よろしくお願いします！\n\nhttps://drive.google.com/drive/folders/1INjP22KREYrD0kTbIr3VPoWz5yLIjUFK?usp=sharing", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@ningyou_sinsi/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3238307, "client_id": 1233406, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/28498d6f/uploads/origins/289345f2-87cb-4f5e-b320-df9e21dab1e6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=28800b0fd783d80d474a4328e049e37b", "srcset": "https://si.imgix.net/28498d6f/uploads/origins/289345f2-87cb-4f5e-b320-df9e21dab1e6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=28800b0fd783d80d474a4328e049e37b, https://si.imgix.net/28498d6f/uploads/origins/289345f2-87cb-4f5e-b320-df9e21dab1e6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a1de23de43e2e8693c4e4eec9215a365 2x, https://si.imgix.net/28498d6f/uploads/origins/289345f2-87cb-4f5e-b320-df9e21dab1e6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=dff8784e1b5c864330bf325a95bffabc 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/28498d6f/uploads/origins/289345f2-87cb-4f5e-b320-df9e21dab1e6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=41781168767ec99c20d1414961d9eda1", "srcset": "https://si.imgix.net/28498d6f/uploads/origins/289345f2-87cb-4f5e-b320-df9e21dab1e6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=41781168767ec99c20d1414961d9eda1, https://si.imgix.net/28498d6f/uploads/origins/289345f2-87cb-4f5e-b320-df9e21d