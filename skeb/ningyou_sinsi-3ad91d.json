とさせてください。\n噴水広場に群がる白鳩へパンくずをあげてもいいし、ショーウインドウをキラキラした目で眺めるアスターをローリエが保護者の顔で見ているのもいいですし、テラス席で穏やかに食事をしていても可愛い……。\n\n以上、よろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/17U_4qYDm6AS9FIbz91j-JhJw3VifItt8?usp=drive_link", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@ningyou_sinsi/works/9", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3238307, "client_id": 3236640, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/7a646e70/uploads/origins/2576a315-bdd6-4b44-814f-421d72eae1b9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6deda3226012a6ade340dce1a4d6561e", "srcset": "https://si.imgix.net/7a646e70/uploads/origins/2576a315-bdd6-4b44-814f-421d72eae1b9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6deda3226012a6ade340dce1a4d6561e, https://si.imgix.net/7a646e70/uploads/origins/2576a315-bdd6-4b44-814f-421d72eae1b9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=60b3ec5c994089165d2aed36f9ea0f73 2x, https://si.imgix.net/7a646e70/uploads/origins/2576a315-bdd6-4b44-814f-421d72eae1b9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=472f495cf2f24651c1213f6603a0b82f 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/7a646e70/uploads/origins/2576a315-bdd6-4b44-814f-421d72eae1b9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9a99bad051061f138d26490b0a8fe717", "srcset": "https://si.imgix.net/7a646e70/uploads/origins/2576a315-bdd6-4b44-814f-421d72eae1b9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9a99bad051061f138d26490b0a8fe717, https://si.imgix.net/7a646e70/uploads/origins/2576a315-bdd6-4b44-814f-421d72eae1b9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=26292