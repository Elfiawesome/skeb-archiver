きありがとうございます。\n\nhttps://drive.google.com/file/d/1_4vIjQktzLq-WDg3myaN_FcXTkB7XQXb/view?usp=drive_link", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@komin_kuma/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3708707, "client_id": 3782784, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/17072981/uploads/origins/4a13acac-92d0-42ba-acbb-beedd848c49b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=06525a713580c0ee89b02c749bfb6918", "srcset": "https://si.imgix.net/17072981/uploads/origins/4a13acac-92d0-42ba-acbb-beedd848c49b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=06525a713580c0ee89b02c749bfb6918, https://si.imgix.net/17072981/uploads/origins/4a13acac-92d0-42ba-acbb-beedd848c49b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e8443bc67a5cd8c479ea19b5332c32f9 2x, https://si.imgix.net/17072981/uploads/origins/4a13acac-92d0-42ba-acbb-beedd848c49b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=3abbe3104031c7129dfdb317270077b7 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/17072981/uploads/origins/4a13acac-92d0-42ba-acbb-beedd848c49b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=8339a1c11a04b4876724acb2b18facc5", "srcset": "https://si.imgix.net/17072981/uploads/origins/4a13acac-92d0-42ba-acbb-beedd848c49b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=8339a1c11a04b4876724acb2b18facc5, https://si.imgix.net/17072981/uploads/origins/4a13acac-92d0-42ba-acbb-beedd848c49b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=3345ee74ff9c85129cf86194fe4d6396 2x, https://si.imgix.net/17072981/uploads/origins/4a13acac-92d0-42ba-acbb-beedd848c49b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=82c9209b52645beebc2e6a730d42b821 3x"}, "body": "こんにちは、塩胡椒、鳥、クマ先生。初めまして！\nお忙しいところ申し訳ありませんが、先生の作品がとても好きで、描かれるキャラクターの雰囲気が非常に独特なので。私のOCのイラストを描いていただけないかとお願いしたく存じます。\n\n以下は2人のocのキャラクター設定で、彼らの関係は名義の親子です。\n奥古斯特（168cm）\n見た目は20歳前後の中性的で、アンダーソン家の少主で、多くの家族のブランチがtaの位置を虎視眈々と狙っている。*ヴァニトゥスの血統と能力の大部分を受け継いでいます。ワニトゥスが自分の搾取とコントロールに不満を抱いているため、一日中恨みがたまっているように見える。ヴァニトゥスは偽善的で理解できない人だと思っているので、親子の深い感情を演じないでほしい。\n\n瓦尼图斯（183cm）\n\n見た目は35歳前後の貴族男性、アンダーソン家の権力者。オーギュスト名義の父親。権力金銭主義至上。顔の傷跡は血狩りが盛んだった時期、吸血鬼ハンターに残されたオーガストの創造者で、完璧な継承者を作ることを目的としている。感情が全然分からないので、二人の関係はとても悪い。*本人はアウグストの家出は反抗期だと考えている。\n\n下記URLリンクの画像を参考に描いていただければ幸いです。\n価格が足りなければ増やすこともできます\n\n使用用途：個人\n\nお忙しい中お時間を割いてご覧いただき、再度感謝申し上げます。どうぞ良い一日をお過ごしください！\n\nhttps://drive.google.com/drive/folders/14nmH17S6tJtezSR74FTiLh1etuiB-k7B", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@komin_kuma/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3708707, "client_id": 2643244, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/9d00bea0/uploads/origins/d11a46cb-c1b2-4e15-bb07-09bb424f563c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=29844ca2fe269b57c4c42e3a75c6dce8", "srcset": "https://si.imgix.net/9d00bea0/uploads/origins/d11a46cb-c1b2-4e15-bb07-09bb424f563c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=29844ca2fe269b57c4c42e3a75c6dce8, https://si.imgix.net/9d00bea0/uploads/origins/d11a46cb-c1b2-4e15-bb07-09bb424f563c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b4b2035bb5bb26b3e6d46e810f1c65aa 2x, https://si.imgix.net/9d00bea0/uploads/origins/d11a46cb-c1b2-4e15-bb07-09bb424f563c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d3bafe9022075528c51cff9e16db879f 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/9d00bea0/uploads/origins/d11a46cb-c1b2-4e15-bb07-09bb424f563c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2d10bb8f37e92264f9fdb01b4bbafab9", "srcset": "https://si.imgix.net/9d00bea0/uploads/origins/d11a46cb-c1b2-4e15-bb07-09bb424f563c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2d10bb8f37e92264f9fdb01b4bbafab9, https://si.imgix.net/9d00bea0/uploads/origins/d11a46cb-c1b2-4e15-bb07-09bb424f563c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=270a8623fd210bc575fdefdbbdde76b2 2x, https://si.imgix.net/9d00bea0/uploads/origins/d11a46cb-c1b2-4e15-bb07-09bb424f563c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=694974325c440b046689e3152a04698f 3x"}, "body": "先生、初めまして！先生の作風がとても気に入りました。可能であれば、オリジナルキャラクター（OC）のイラスト制作を依頼したいです。キャラクター設定は以下の通りです。お読みいただきありがとうございます！https://docs.qq.com/doc/DVXNjZFdpbktibUx6", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@komin_kuma/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3708707, "client_id": 1018243, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/78826750/uploads/origins/6e52ca5e-a815-4f70-9fc3-9bdf86e4af0a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d8161f212d2de6bd49db67adaa122b33", "srcset": "https://si.imgix.net/78826750/uploads/origins/6e52ca5e-a815-4f70-9fc3-9bdf86e4af0a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d8161f212d2de6bd49db67adaa122b33, https://si.imgix.net/78826750/uploads/origins/6e52ca5e-a815-4f70-9fc3-9bdf86e4af0a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f66a6fc43971064f30eb31b4a30c364d 2x, https://si.imgix.net/78826750/uploads/origins/6e52ca5e-a815-4f70-9fc3-9bdf86e4af0a?bg