c": "https://si.imgix.net/1f6225be/uploads/origins/9bd6631a-ca07-4521-bcf2-c8394e94bb71?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e79802530964a08776848c293ae709c2", "srcset": "https://si.imgix.net/1f6225be/uploads/origins/9bd6631a-ca07-4521-bcf2-c8394e94bb71?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e79802530964a08776848c293ae709c2, https://si.imgix.net/1f6225be/uploads/origins/9bd6631a-ca07-4521-bcf2-c8394e94bb71?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=8b56055a10bd4a56b1b440aafa9c5b6f 2x, https://si.imgix.net/1f6225be/uploads/origins/9bd6631a-ca07-4521-bcf2-c8394e94bb71?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=620097a2d0ea6b1b2f45ee7d4d0745c5 3x"}, "body": "たるとたたん様\n\nこんにちは！ホイップあんです。wickで綺麗でかわいいイラストを拝見し、ぜひリクエストさせていただきたい...!と思いました！\nオリキャラのホイップあんちゃんを描いていただけないでしょうか？\n衣装はこちらのgoogledriveのものをお願いいたします。\nスカートや太ももくらいまで入る構図だと嬉しいです！ポーズはおまかせさせてください！可愛い雰囲気があると嬉しいです！！\nhttps://drive.google.com/drive/folders/1Jj7PJ_LBDGSfE3HSmzIhOc83s5ADNikN?usp=sharing\n\n使用用途\nX, Wick, Youtubeへの掲載\n個人観賞用\n個人の範囲内での印刷\n\nよろしくお願い致します！", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Tar_tetete/works/13", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3311007, "client_id": 1233406, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/b9576006/uploads/origins/bbe70836-57fa-4812-9d67-41a0b0995812?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=915a974bc81b27c2460c507ec4c1e25a", "srcset": "https://si.imgix.net/b9576006/uploads/origins/bbe70836-57fa-4812-9d67-41a0b0995812?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=915a974bc81b27c2460c507ec4c1e25a, https://si.imgix.net/b9576006/uploads/origins/bbe70836-57fa-4812-9d67-41a0b0995812?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c082283b5055f61655502ef8be3ab0ec 2x, https://si.imgix.net/b9576006/uploads/origins/bbe70836-57fa-4812-9d67-41a0b0995812?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ba2557618bb952eb17e17382ec0e5075 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/b9576006/uploads/origins/bbe70836-57fa-4812-9d67-41a0b0995812?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b41e5349a937beb9215fa88fbf46ff63", "srcset": "https://si.imgix.net/b9576006/uploads/origins/bbe70836-57fa-4812-9d67-41a0b0995812?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b41e5349a937beb9215fa88fbf46ff63, https://si.imgix.net/b9576006/uploads/origins/bbe70836-57fa-4812-9d67-41a0b0995812?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=8698f201ab1417227f3eb310733ed275 2x, https://si.imgix.net/b9576006/uploads/origins/bbe70836-57fa-4812-9d67-41a0b0995812?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=4447f157e3164f860d742b35ee1564fa 3x"}, "body": "たるとたたんさんこんばんは！\nいつもお世話になっております、ゆき（翠雪）です。\n吸いこまれそうな瞳をはじめとする、細部まで可愛らしさを追求された絵柄が好きです。\n今回は満を持してリクエストに参りました。\n\n描いていただきたいのは、『緑の指輪と思い草』のアスターです。\n【月桂樹と、薄紫色の紫苑を含むミニブーケを持っている】構図で、背景を透過した差分があると大変嬉しいです。\n（そうでなくてももちろん大丈夫です！）\n\n容姿については、中世ヨーロッパ風の本編基準でも、現パロ基準の洋服でもどちらでも構いません。\nお着替えも大歓迎なので、持ち物以外の要素についてはたるとたたんさんにお任せできればと思います。\n\n参考までに、過去のSkebリクエストの中でも特に好きだな～と思ったイラストのリンクを貼っておきます。\nhttps://skeb.jp/@Tar_tetete/works/9\n全身のバランスや、花弁の薄さが分かるお花の描きこみがすごく良くて……！\n\nアスターの容姿の設定は以下の通りです。\n①～③のいずれかをベースにしていただけますと幸いです。\n──────\n＜各世界線の共通設定＞\n年齢：15歳\n一人称：あたし\n性別・性自認：女\n身長：147cm\n髪色：黒\n目元：大きめ、丸め\n語尾の癖：～です、～じゃないですか　等\n性格：純朴、弱気、泣き虫、柔和、頑張り屋\n（もしその部分が見える構図なら）必ず描いていただきたい小物：左手の小指にはまった指輪\n\n＜①本編『緑の指輪と思い草』ベース、第一章＞\n右目の色：若草色（黄緑色）\n左目の色：薄紫色\n髪型：右目を隠しつつ、うなじ辺りで結んだおさげ\n\n＜②本編『緑の指輪と思い草』ベース、第二章以降＞\n両目の色：若草色（黄緑色）\n髪型：右目を隠しつつ、ボブ風に切りそろえたショートカット\n\n＜③現パロベース＞\n右目の色：若草色\n左目の色：薄紫色\n髪型：右目を隠しつつ、うなじ辺りで結んだおさげ\n※現パロの資料は資料URLの【参考資料】フォルダに格納しています。\n──────\n使用用途は主に個人観賞用ですが、小説の宣伝やグッズ化等でイラストを使用する可能性があります。\n何か不備等ございましたら、遠慮なく却下していただいて構いません。\n\n以上、よろしくお願いいたします！\n\nhttps://drive.google.com/drive/folders/17U_4qYDm6AS9FIbz91j-JhJw3VifItt8?usp=drive_link", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Tar_tetete/works/12", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3311007, "client_id": 3844743, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/654e1323/uploads/origins/bc708c6d-deba-4be2-b662-0851bb5a77a2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=afeea65c1f5ea9bfa7bf9d12423295be", "srcset": "https://si.imgix.net/654e1323/uploads/origins/bc708c6d-deba-4be2-b662-0851bb5a77a2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=afeea65c1f5ea9bfa7bf9d12423295be, https://si.imgix.net/654e1323/uploads/origins/bc708c6d-deba-4be2-b662-0851bb5a77a2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=53364b0b336956b1116bf6c1180f5363 2x, https://si.imgix.net/654e1323/uploads/origins/bc708c6d-deba-4be2-b662-0851bb5a77a2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=9026fd362fdfeb2a13b0841b83bb41df 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/654e1323/uploads/origins/bc708c6d-deba-4be2-b662-0851bb5a77a2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6a8769ac548ae6e1ff1a250457647e42", "srcset": "https://si.imgix.net/654e1323/uploads/origins/bc708c6d-deba-4be2-b662-0851bb5a77a2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6a8769ac548ae6e1ff1a250457647e42, https://si.imgix.net/654e1323/uploads/origins/bc708c6d-deba-4be2-b662