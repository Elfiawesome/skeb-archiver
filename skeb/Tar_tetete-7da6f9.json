b49b6/uploads/origins/94ac6a4b-8b5d-429e-a1e2-61b504014268?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0f1be9d3b92431fafcc9235cdefb1893, https://si.imgix.net/6f7b49b6/uploads/origins/94ac6a4b-8b5d-429e-a1e2-61b504014268?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=c3241cc15bc1e691c5487fd55cad1192 2x, https://si.imgix.net/6f7b49b6/uploads/origins/94ac6a4b-8b5d-429e-a1e2-61b504014268?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=89e7ef517308ff34db290c090f8c1c4d 3x"}, "body": "YouTubeで配信活動をしている花咲ことはです！\n前回素敵なイラストありがとうございました！とっても愛らしくてお気に入りの一枚になっています・・！\n暖かなタッチがとても好みでしたので再度送らせていただきます・・！\n前回今回のイラストを合わせて使いたいと考えていますので区別化できるようなイラストだと嬉しいです！\n\n使用用途\n・収益化済みチャンネルでの歌ってみたに使用\n・おはようVtuber\n・サムネイル\n・ネットプリント等のグッズ可\n\n\n詳細\n髪や頭部が見切れていないと助かります。\nキャラクターは見習い探偵の女の子です。\n長髪の方でお願いしたいです！\n\n・見習い探偵(虫眼鏡を持つ構図はやめてください)\n・服装は変更していただいて大丈夫です。\n・たるとたたん様の世界観にあうように仕上げていただきたいです。\nそのほかはお任せとさせてください！\n\n・人物や小物は透過データもいただけますと幸いです。\n・表情など差分ありのデータを作成いただけるようであれば、同様のご対応をしていただけますと幸いです。\n\n金額面で難しい場合はご指定の上再送していただけますと可能な範囲対応させていただきます！\n何卒よろしくお願いいたします。\n\nhttps://drive.google.com/drive/u/0/folders/1FI-0gH-ZPioNYkpTgDFJNyoGvTwMFBbx?hl=ja", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Tar_tetete/works/8", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3311007, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/0d9f8c68/uploads/origins/6ced2bd1-e5b9-43fe-8a63-15c30e6b7984?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=feec9bf76f6845efe30a47a762efec08", "srcset": "https://si.imgix.net/0d9f8c68/uploads/origins/6ced2bd1-e5b9-43fe-8a63-15c30e6b7984?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=feec9bf76f6845efe30a47a762efec08, https://si.imgix.net/0d9f8c68/uploads/origins/6ced2bd1-e5b9-43fe-8a63-15c30e6b7984?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=fb2a5f7736dbbb1707b5e64b54042cc8 2x, https://si.imgix.net/0d9f8c68/uploads/origins/6ced2bd1-e5b9-43fe-8a63-15c30e6b7984?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=7d5c2bc397e800ecc2024db4d0e2bef2 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/0d9f8c68/uploads/origins/6ced2bd1-e5b9-43fe-8a63-15c30e6b7984?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0696a626f2aedcc5a50c7336a607496f", "srcset": "https://si.imgix.net/0d9f8c68/uploads/origins/6ced2bd1-e5b9-43fe-8a63-15c30e6b7984?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0696a626f2aedcc5a50c7336a607496f, https://si.imgix.net/0d9f8c68/uploads/origins/6ced2bd1-e5b9-43fe-8a63-15c30e6b7984?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=3629c08dded35a62f576119d71a26ee1 2x, https://si.imgix.net/0d9f8c68/uploads/origins/6ced2bd1-e5b9-43fe-8a63-15c30e6b7984?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=6fe973d1f518cc96c155662e2d1a6b6b 3x"}, "body": "こんにちは、はじめまして。\nhttps://skeb.jp/@Tar_tetete/works/3\nhttps://skeb.jp/@Tar_tetete/works/2\n上記のような過去作品群を拝見し、そのクオリティの高さに強く惹かれました。\n艶やかで立体感のある綺麗な髪の表現、目、頬、口が可愛い豊かな表情、シワや陰影の上手な服飾、\nと魅力的な点がたくさんあり、是非イラストをお願いしたいと思いました。\n特に、綺麗な目と可愛らしい表情に魅力を感じており、うちの子も可愛く描いていただけるのではと思いました。\n\n少しマニアックな要素を含みますが、以下のようなオリキャラ(うちの子)の女の子を描いていただけませんでしょうか。\n以下は参考画像ですが、セーラー服のデザインや表情・ポーズ・構図は自由です。\nhttps://drive.google.com/drive/folders/1RIJ2bUUoPHZDhYmSZ5NlFco0yYrqRyDg?usp=sharing\n\n以下、リクエスト内容です。\n\n■女の子\n・艶やかな黒髪の前髪ぱっつん、少し内巻きのショートボブ、横髪・後ろ髪は口のラインくらいで切り揃えている、襟足はソフトに刈り上げ(構図次第で見えなくてもOK)\n・半袖のセーラー服\n・元気な感じ\n■シチュエーション\n・右腕にケガでギプスをしていて、三角巾で首から吊っている\n　‐首と肘のところの三角巾の結び目を見える位置にお願いします(資料URLご参照ください)\n　　(細かいですが…首の方は結び目1つ、三角巾の端が2つ、肘の方は結び目1つ、三角巾の端が1つ、という違いがあります)\n　‐右腕が画面に入るような構図でお願いします\n・ほっぺたに絆創膏１枚\n・ケガをしてても暗くならず、以下のような照れている表情\n　‐片目ウィンク、ペロっと舌を出している、いわゆるてへぺろな表情\n\n包帯に萌えるのと、それでも可愛く元気な姿に萌えるのが個人的なポイントです。\n\nhttps://www.youtube.com/watch?v=iLDkTBdxs4w", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Tar_tetete/works/7", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/8bf7e14a/uploads/origins/c507b65f-0eb9-4317-9fe1-e26afc048a98?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=6ad81e11111ed197d5a212c0aeabc231", "srcset": "https://si.imgix.net/8bf7e14a/uploads/origins/c507b65f-0eb9-4317-9fe1-e26afc048a98?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=6ad81e11111ed197d5a212c0aeabc231, https://si.imgix.net/8bf7e14a/uploads/origins/c507b65f-0eb9-4317-9fe1-e26afc048a98?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=492c76c62cf13e420ecb325824465cc7 2x, https://si.imgix.net/8bf7e14a/uploads/origins/c507b65f-0eb9-4317-9fe1-e26afc048a98?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=275ef834744abd75e4b9e900442620b8 3x"}, "private": true, "genre": "art", "tipped": false, "creator_id": 3311007, "client_id": 3328380, "nc": 1}, {"path": "/@Tar_tetete/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3311007, "client_id": 3873904, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/0f1e36ad/uploads/origins/de8f3e45-367b-4da7-a381-579599183af3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b82de5e000e04e078a6260798203dc0a", "srcset": "https