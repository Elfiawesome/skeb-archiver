出度の高い金色のドレスを着たキツネの女の子を描いてもらえませんか?\n\nhttps://drive.google.com/drive/folders/1J10aawZ8i-dT_7HZ0Gab64-ThBm1cV3R?usp=sharing\n\n金色のドレスは彼女の大きな胸をほとんど覆っておらず、乳輪ははっきりと見えています。彼女の陥没した乳首もドレスの後ろで輪郭が浮かび上がっています。彼女はぽっちゃりとしたお腹も露出しています。\n彼女は、照れくさそうで恥ずかしそうな表情を浮かべながら、セクシーなポーズをとっている。どんなポーズでも構いません。お任せします！\n\n胸は出来るだけ大きく描いてください！ご検討ありがとうございます！\n\nhttps://drive.google.com/drive/folders/1J10aawZ8i-dT_7HZ0Gab64-ThBm1cV3R?usp=sharing", "nc": 161, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@M0kV1vW2BD2nnUF/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 124865, "client_id": 31032, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/6b652100/uploads/origins/e3dad608-47a5-492f-8440-d72f6736d6e1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fdf20a2b5997605bda5b2c5d888bfee6", "srcset": "https://si.imgix.net/6b652100/uploads/origins/e3dad608-47a5-492f-8440-d72f6736d6e1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fdf20a2b5997605bda5b2c5d888bfee6, https://si.imgix.net/6b652100/uploads/origins/e3dad608-47a5-492f-8440-d72f6736d6e1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=bc4024cd5d4511044db2477bdd9eaec8 2x, https://si.imgix.net/6b652100/uploads/origins/e3dad608-47a5-492f-8440-d72f6736d6e1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=220f94b3bf24586c04313728a877819b 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/6b652100/uploads/origins/e3dad608-47a5-492f-8440-d72f6736d6e1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=23434462997bdf0b286d8ede0654650f", "srcset": "https://si.imgix.net/6b652100/uploads/origins/e3dad608-47a5-492f-8440-d72f6736d6e1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=23434462997bdf0b