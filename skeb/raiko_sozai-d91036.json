ds/origins/245b10da-0982-46cc-8f7a-017f99fe4aa0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=41bb6f8b78d620c10bae685ca9daa7bc 2x, https://si.imgix.net/a97344ab/uploads/origins/245b10da-0982-46cc-8f7a-017f99fe4aa0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=da84928c52d60139c886e0ce11b591a7 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/a97344ab/uploads/origins/245b10da-0982-46cc-8f7a-017f99fe4aa0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f18292c4ece3d9f539c9c2d92f807f6b", "srcset": "https://si.imgix.net/a97344ab/uploads/origins/245b10da-0982-46cc-8f7a-017f99fe4aa0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f18292c4ece3d9f539c9c2d92f807f6b, https://si.imgix.net/a97344ab/uploads/origins/245b10da-0982-46cc-8f7a-017f99fe4aa0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=d205205bdc74eb862ca73f5ea1dadc91 2x, https://si.imgix.net/a97344ab/uploads/origins/245b10da-0982-46cc-8f7a-017f99fe4aa0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=b1d62755be80c88123d4a322fc9cd069 3x"}, "body": "初めまして。\nいつもBOOTHの立ち絵でお世話になっております。\nRAIKOさんが中華風のキャラを描かれているのを拝見し、思い切ってSkebに申し込みました。\nBOOTHにありますRAIKOさんの「立ち絵素材_旅行鞄を持つ少女」のキャラクターを中華風世界に送り込むことになりまして、この子で中華風のお洋服を全身立ち絵で描いていただきたいのです。\n中華衣装のイメージカラーは青緑と水色です。\nできれば、スカートは長くてひらひらしている方が嬉しいです。\nピンクの髪は、纏めていても流していても、どちらでも大丈夫です。\nチャイナというか、漢服というのでしょうか。\n自キャラの性格が、中華風の団扇とか羽毛の扇子持ってひらひら舞っているようなキャラでして。\n明るく元気で好奇心が多いというか。\nそんな立ち絵を描いていただけると幸いです。\nお忙しいところ大変申し訳ございませんが、よろしくお願いいたします。", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@raiko_sozai/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3940968, "client_id": 702525, "vtt_url": null, "thumbnail_image_u