}, "acceptable_only_public": false, "tip_acceptable": true, "yearly_report_client_visible": false, "total_appeals_count": 0, "received_works": [{"path": "/@tumuzi_624/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2623183, "client_id": 3503883, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/61961d36/uploads/origins/9e091d5e-cc87-4b0f-8672-f2502c4e4a75?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=41c4b166c58f0f6313f50b956d6b156f", "srcset": "https://si.imgix.net/61961d36/uploads/origins/9e091d5e-cc87-4b0f-8672-f2502c4e4a75?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=41c4b166c58f0f6313f50b956d6b156f, https://si.imgix.net/61961d36/uploads/origins/9e091d5e-cc87-4b0f-8672-f2502c4e4a75?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=657cf8bacc1526491e456ac39fcb0f8d 2x, https://si.imgix.net/61961d36/uploads/origins/9e091d5e-cc87-4b0f-8672-f2502c4e4a75?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=4c8899d2eda99237a8e59d5beb69034c 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/61961d36/uploads/origins/9e091d5e-cc87-4b0f-8672-f2502c4e4a75?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=7f17a306a2c6fb8d0ee221ac71fc25a5", "srcset": "https://si.imgix.net/61961d36/uploads/origins/9e091d5e-cc87-4b0f-8672-f2502c4e4a75?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=7f17a306a2c6fb8d0ee221ac71fc25a5, https://si.imgix.net/61961d36/uploads/origins/9e091d5e-cc87-4b0f-8672-f2502c4e4a75?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=966a0df061e28784181b2f45f12fe204 2x, https://si.imgix.net/61961d36/uploads/origins/9e091d5e-cc87-4b0f-8672-f2502c4e4a75?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=10e438235afad197d745d148ed9088c2 3x"}, "body": "初めまして！配信アプリspoonで配信活動をしています。葉と申します！\nむつじさんの『夏風』と『静謐🌱』の透明感とブラシの質感を強めに残したイラストに一目惚れし、配信背景やSNSのアイコンにしたくご依頼しました！\n\n使用用途\n・配信背景\n・配信活動におけるSNSのアイコン\nhttps://x.com/le4f_yo?s=21\n\nデータ\n・キャラクターのみの透過PNGもいただけると幸いです。\n\n依頼内容は以下になります。\n\nイラスト全体のイメージ\n・和風×洋風のかけ合せ\n・背景は絵本のような、夢の世界の雰囲気のある洋風。\n・キャラクターは真っ白な彦星をイメージとした和服で星々でできた天の川の道を歩いている構図。\n\nキャラクター\n・20代、178cm男性。\n・顔..参考資料のような20代男性\n・目..目の虹彩の色は基本は原神の申鶴のような色合いにしてほしいです。（灰色のものも出来ればほしいです。）\n・髪型..崩壊スターレイルの丹恒を白髪にしたイメージ\n・耳飾り..左耳の耳飾りはグラデーションで下に行くにつれラメが濃い。\n\n表情とポーズ\n・表情..口を閉じて微笑んでいる。\n\n・ポーズ..左向き。胸を張って、天の川を歩いている構図イメージのような感じです。手は体の横、自然な位置でポケットに手を入れないようにお願いします。\n\n服装\n・ボタンを上までしめたインナー襟なし白シャツの上に和服を着崩さずキレイに着ている。全体的に真っ白の和服で上着と袴に装飾がある。\n\n上着..袖口、裾回り、Vの甲斐田晴さんの緑がかっている部分に透明度高めのラメがかり透明色の羽衣のような質感。ひし形の星✨がところどころ金・銀に輝いている。\n\n袴（下半身）..参考資料の箇所に和柄の金色の流水模様。\n\n\n背景\n・月..宝石感があり、月の上に薄く魔法陣を書いてほしいです！\n\n・星..月同様に宝石感を出してほしいです！\n\n・猫..猫種は真っ白なスコティッシュフォールドで目は黄色。宙に浮いており、瞳孔がまん丸で天の川の先端の星でお腹をこちらに向けて遊んでいる様子。\n\n・空..画面最下層に雲。上の方は、集中線のようにスターウォーズのハイパースペースに入る時のシーンのような星々が伸びている様子を描いてほしいです。\n\n最後になりますがご縁がありましたらお描きいただけると嬉しいです。\nよろしくお願いします。\n\nhttps://drive.google.com/drive/folders/17F4EfuRi10caHNAlqjUslDv7T9WA8eHk", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@tumuzi_624/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2623183, "client_id": 3257509, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/648a3467/uploads/origins/0170f943-01bc-48bb-b427-f97942025621?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5ccb7e4e48ec6d91fe1db328ea8f5f75", "srcset": "https://si.imgix.net/648a3467/uploads/origins/0170f943-01bc-48bb-b427-f97942025621?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5ccb7e4e48ec6d91fe1db328ea8f5f75, https://si.imgix.net/648a3467/uploads/origins/0170f943-01bc-48bb-b427-f97942025621?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=4dc56af01c138df133e65a60664f0e24 2x, https://si.imgix.net/648a3467/uploads/origins/0170f943-01bc-48bb-b427-f97942025621?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=23e893e5ae2245fc4b7da32360e391ae 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/648a3467/uploads/origins/0170f943-01bc-48bb-b427-f97942025621?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=4cf18c546287b411d355fa877c6e4fe0", "srcset": "https://si.imgix.net/648a3467/uploads/origins/0170f943-01bc-48bb-b427-f97942025621?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=4cf18c546287b411d355fa877c6e4fe0, https://si.imgix.net/648a3467/uploads/origins/0170f943-01bc-48bb-b427-f97942025621?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=b11b71c98ed0eaea7cbbb6f209c30647 2x, https://si.imgix.net/648a3467/uploads/origins/0170f943-01bc-48bb-b427-f97942025621?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=f4ff4921701c2110317847d779bcdd4e 3x"}, "body": "初めまして、夜方 彼誰(よるべ かなた)と申します。\nXにてむつじ様のイラストお見かけしまして一目惚れでご依頼させていただきたいと思っています。\n特に鮮やかな目の色合いがとても素敵でした！\n\n今回描いていただきたいのは自キャラになります。姿や衣装は資料URL先の画像を参考にしていただければと思います。\n構図・ポーズは基本的にむつじ様におまかせいたしますが、ご参考程度に私の希望を書きました。\nよろしくお願いします。\n\n【希望内容】\n〜構図〜\n夕暮れを背景に高層ビルの屋上のような高いところのへりに腰掛けて座っている\n\n〜ポーズ〜\n足を組んでおり、右肘を膝についている\n\n〜表情〜\n穏やかにほほえんでいる表情\n目線はこちらを向いている\n\n〜ポイント〜\n右手につけている夕陽をモチーフとした指輪を目立たせてもらえると嬉しいです\n\n【用途】\nXやYouTubeなどSNSへの投稿(非商用利用)\n\n【データ】\nキャラクターのみの透過PNGもいただけると助かります\n\n【その他】\n・全身絵でなくて大丈夫です\n・キャラクターのデザインを担当しているクリエイター様には依頼の許可を得ております\n\n参考画像が少なくて申し訳ないのですがどうかご検討よろしくお願いいたします。\n\nhttps://x.com/yorubekanata/status/1909257480510783585?s=46", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@tumuzi_624/works/1", "private_thumbn