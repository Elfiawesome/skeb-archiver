=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=83b7a62ae7b1d754ef7a53e95ee602c3", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/1d872a0e/uploads/origins/67ce130d-96f0-4904-bb43-c7e5123edd30?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d11aad5f06026b007defe225f9207840", "src_set": ""}, "body": "今回お願いしたいネクロテックはネイルアーティストの妹です。 今回も「Diabolical, Draconic, Deadly MODified」のテーマにふさわしい素敵なデザインでお願いします！\n\n添付された参考資料とバックストーリーをお読みになって、メグリムさんが考えたデザインで描いていただければ幸いです！\n\nhttps://drive.google.com/file/d/1g70PGtjjMShBRXRlJENBU8EXow4RKt-s/view?usp=sharing", "nc": 160, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@megrim_haruyo/works/65", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 725063, "client_id": 206892, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/5feebcf2/uploads/origins/aa379311-382d-4a0a-b250-944bd4e1ca1a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=64cfad4304a9c988ed6c08727467823e", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/5feebcf2/uploads/origins/aa379311-382d-4a0a-b250-944bd4e1ca1a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=88c9959699f5da1d94bf0d2ffb4af17e", "src_set": ""}, "body": "こんにちは！\n\n極悪非道、ドラコニック、デッドリーモディファイドをテーマにしたオリジナルキャラクターをお願いします！\n\n大型のネクロテックユニットをお願いします！今回のテーマは【ウォーデン】で、基本的には敵のネクロテック・ユニットを幽閉するための巨大な機械です。\n\nー基本的にはー敵ネクロテック・ユニットをー投獄する巨大なー：\n- 小型のネクロテック・ユニットを捕獲・拘束するための小型ドローン。\n- ヒンデンブルク号のような飛行船をイメージした。\n- ヒンデンブルグなどの飛行船をイメージしている。\n- 監獄船の所長としての彼女の立場を示すため、士官帽と獰猛な表情。\n\n参考文献\nhttps://www.deviantart.com/wen-m/art/Anima-The-Carrier-98999215\nhttps://www.dropbox.com/s/zpxvweumy6e7lti/xz4pptont3y71.jpg?dl=0\n\nありがとうございました！", "nc": 160, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@megrim_haruyo/works/64", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 725063, "client_id": 1057157, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/b9484357/uploads/origins/75cdd503-757e-4e4b-9324-21395c16a1ca?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=50a60df1ef8b3289a6e073117ee13062", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/b9484357/uploads/origins/75cdd503-757e-4e4b-9324-21395c16a1ca?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c8d6b512db55ee543e6a3691f825dc9b", "src_set": ""}, "body": "また会ったね、\n\n前回のリクエストに応えてくれてありがとう。\n今でもとても気に入っています。\n\n今度は、あなたのネクロテックラインからインスピレーションを受けたアート作品をお願いしたいです。\nあなたの作品のひとつひとつが心にしみるほど美しいのが大好きです。\n特に「Sinister Religion」という作品が大好きで、それをモチーフにしたイラストを期待していました。\n\n大まかなイメージで構いませんので、よろしくお願いします。\n\nイラストは宇宙と夜空の星を中心に描いてください。\n女の子の髪の毛は、無重力で浮いているように描いてください。\nこれで十分だと思います。\n他はすべてあなた次第です。\n\nよろしくお願いします。", "nc": 48, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@megrim_haruyo/works/63", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 725063, "client_id": 2627367, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/3dab9c5a/uploads/origins/503441ad-7b1c-4787-a14c-99024bdef133?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4295b257494d368248c9032d5d796f77", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/3dab9c5a/uploads/origins/503441ad-7b1c-4787-a14c-99024bdef133?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d723a5e7a233ad5bce4b2a01c44e13f7", "src_set": ""}, "body": "メグリムさんのネクロテックのデザイン、バックストーリーを初めて見て一目ぼれしました。 そこで、私が考えたコンセプトのネクロテックをメグリムさんがどのようにデザインされるかとても気になってリクエストします！ テーマは「Diabolical, Draconic, Deadly MODified」で、よろしくお願いします！\n\nそしてメグリムさんのネクロテックの世界観はデザインと同じくらいバックストーリーも魅力的なので、ネイルアーティストを評価する人たちのセリフや、プリンランドを見る他国の国民の発言などもお願いしたいです。 これまでリクエストができるかどうかはわかりませんが···\n\nhttps://drive.google.com/file/d/1bARN3L5mEyjqMNUki9eNv1ioB3WfyUo6/view?usp=sharing", "nc": 49, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@megrim_haruyo/works/62", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 725063, "client_id": 0, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/fd4612f4/uploads/origins/4bfa0941-3fa1-4bb3-8572-310556a7a414?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=63cb452cbb104b1b4f2971c80929f1b7", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/fd4612f4/uploads/origins/4bfa0941-3fa1-4bb3-8572-310556a7a414?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=63368f511cfa3a2371d141b0a0a1fd73", "src_set": ""}, "body": "初めまして、今回依頼したいのはジェヴォーダンの獣を主旨に、傷だらけの化け物少女のような形の絵です。\n全て貴方様の想いままにやってください、よろしくお願いします", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@megrim_haruyo/works/61", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 725063, "client_id": 2797984, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/62d41d14/uploads/origins/ea012666-93a3-49b6-adb9-7b51bd3be830?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a5e8b7a80a343923582e06fdfc637e99", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/62d41d14/uploads/origins/ea012666-93a3-49b6-adb9-7b51bd3be830?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2e27ac0ea61cfdd5e1a976119245fd3a", "src_set": ""}, "body": "こんにちは、あなたのアートスタイルが大好きです！とてもユニークです。できれば僕のOCを描いてほしいんだ。彼女は放浪している記憶喪失の山の神です。ピンクと黒の目をしています。よろしくお願いします。\n\nhttps://drive.google.com/drive/folders/1-84-02CedbXOeEF5x0g4_TUIPsEpHjvP", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@megrim_haruyo/works/60", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 725063, "client_id": 2785068, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/af4760c1/uploads/origins/bdd05942-6139-40c2-ab29-96bfd52133ea?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=333355d09f7ac802e7c22a61e36b151b", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/af4760c1/uploads/origins/bdd05942-6139-40c2-ab29-96bfd52133ea?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=596261b7b1bd0bca95c45e2db63e63d1", "src_set": ""}, "body": "はじめまして\nメグリム・ハルヨさんの素晴らしい作品を拝見して美しいと思いリクエストさせて頂きました。\n\nネクロテック技術で造り上げられた人造竜というテーマでキャラクターをデザインして頂けませんか？\n\n使用用途は個人鑑賞と自創作での登場人物としての使用を考えています。\nご検討よろしくお願いします。", "nc": 48, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@megrim_haruyo/works/59", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 725063, "client_id": 0, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/c7a2e76c/uploads/origins/12ac2c28-0f8e-4df0-b496-d63513f83109?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=42168fb06e88ba384f1d359d7db8d10c", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/c7a2e76c/uploads/origins/12ac2c28-0f8e-4df0-b496-d63513f83109?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=52fbf2a386674fa499ea9246520e570c", "src_set": ""}, "body": "はじめまして。\nネクロテックというダークかつ耽美さを感じられるイラスト郡に大変心惹かれ、依頼させていただきました。\n\nファンタジー世界を舞台にした自作小説のキャラクターをリクエストします。\n堕天使と死神がモチーフで、魔王のような立ち位置のキャラクターです。\n容姿などのイメージはURLをご確認ください。\n資料に加え、以下の設定で描いていただきたいです。\nモンスター娘及びドラゴン娘のような要素です。\nこれらに加え、メグリムさんならではのネクロテック的な要素も追加して頂きたいです。\n\n・戦いによってズタボロにされた上、左眼・左腕・左の翼が失われてしまったために自分の魔力で再構成したが、腐食したようないびつな形になり、更に尻尾なども生えた（彼女の心が壊れてしまったことによる）\n・左目は暗い青色の瞳で、白目部分は黒くなっている\n・左腕は腐食したような怪物じみた黒い腕に変化し、指先は鋭い爪のような形になっている（長さや大きさは元の腕と同じ〜少し大きいくらい）\n・左の翼はドラゴンの翼を模したしたような形\n・スカートの下からは長い尻尾が生えている（先端は刃物のように硬質で鋭いもの）\n・耳はドラゴンの翼を模した形になっている（広がったりはせず、人魚キャラに生えているエラのような感じ）\n・服は少しボロボロになっている\n・話は通じず、もはや相手のことを敵や食料としかみなしていないような状態です\n・後戻りはできず、倒される末路しか待ってないようなイメージです\n\nダークで狂気的な雰囲気でお願いしたいです。\nぜひともよろしくお願い致します。\n\nhttps://www.dropbox.com/scl/fi/g9h09wokez0jtfczx2fbh/m_20230930005854.png?rlkey=b5niwchbugliaxgp4z7jmg1ik&dl=0", "nc": 176, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@megrim_haruyo/works/58", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/dcdff133/uploads/origins/dc38e9f5-a3da-4d92-8623-b760e850a894?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=7a8a9e56694aa2549dddbe93c3f9058a", "src_set": ""}, "private": true, "genre": "art", "tipped": true, "creator_id": 725063, "client_id": 301163, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 129, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@megrim_haruyo/works/57", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 725063, "client_id": 333705, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/a153509a/uploads/origins/41670a52-1432-41d5-bfc8-da0897047f00?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5d290b841359c224fc7d69b34ae5b1d9", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/a153509a/uploads/origins/41670a52-1432-41d5-bfc8-da0897047f00?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=437051fd0d78230d4a9410195dbf1168", "src_set": ""}, "body": "こんにちは。以前リクエストした女性（私の姉さん）をまた描いていただきたいのですがよろしいでしょうか。\n三つ編み、眼鏡の女性のデザインは変わらず、\n・季節は秋\n・木漏れ日の下で、座って本を読んでいる（座り方はお任せします）\n・木に寄りかかってうとうとしている\n・膝の上には以前描いていただいた黒い装丁の本\n・スカートから裸足がくるぶしから上くらいまで覗いている\n・表情は、眠気のまだ残る様子だけれど、うっすらと微笑んでいる\n・服装は、季節に合わせた服装でお任せしたいです\n\nもしよろしければ、ぜひお願いいたします。", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@megrim_haruyo/works/56", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 725063, "client_id": 206892, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/46f39d8d/uploads/origins/4f0b243f-0819-45b8-9458-b88d732fb929?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=221888ada073ec2535fb8eeb09c1f50b", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/46f39d8d/uploads/origins/4f0b243f-0819-45b8-9458-b88d732fb929?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ae8b74c17b66cc70d18133958d3a881b", "src_set": ""}, "body": "こんにちは！\n\nあなたのテーマである「Diabolical, Draconic, Deadly MODified」に沿ってデザインされたオリジナルキャラクターを、またお願いしたいです！\n\n私がお願いしたいのは、歩く要塞兵として活躍する超大型ネクロテックユニットです。ユニットタイプはドローン戦に最適化されており、これを用いて敵に群がる。\n\n外見はキャラクターを参考にしつつも、デザインはお任せしたいです！\n\n参考となるキャラクター\nhttps://www.dropbox.com/s/058cs500pdfjbhm/emerson-tung-y-battleship-shinano.jpg?dl=0\nhttps://www.dropbox.com/s/3ldwh8absqoac8c/ChaChi444-1547281248015581184-0.jpg?dl=0\n\n多くの感謝を込めて！", "nc": 177, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@megrim_haruyo/works/55", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 725063, "client_id": 52154, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/7f604a60/uploads/origins/86c356ed-c567-4311-95e7-05da99885dce?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=acbc6df88894207251d46b76ab7640ff", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/7f604a60/uploads/origins/86c356ed-c567-4311-95e7-05da99885dce?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=68e7031e4874f93ab6dc2292146c16a3", "src_set": ""}, "body": "はじめまして。\n絵柄と雰囲気、作風がとても素敵で、リクエストの再開をお待ちしておりました。ご都合よろしければ是非依頼をさせて頂きたいです。\n\nFF14で使用している自キャラをお願い致します。\n表向きは優しいようで実際は生きた人間にほぼ関心の無いネクロフィリアです。一方で気に入った相手にはどこまでも尽くしたり、殺傷に罪悪感を覚えなかったりと少しサイコな性格でもあります。\n写真撮影とケーキと紅茶が好きな子です。\n\n服装は資料内の物をお選びいただけたらと思います。(もしも他に着せたい服などございましたらそれでも全然大丈夫です)\n細部はお任せ致しますが、ホラーでダークな雰囲気だと嬉しいです。是非よろしくお願い致します。\n\nhttps://www.dropbox.com/sh/na7pu9cosltqowh/AADqlw4xsi7h7_1ChKfcv5bya?dl=0", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "similar_creators": [{"id": 18457, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "えもんず（4代目）", "screen_name": "emons03", "avatar_url": "https://pbs.twimg.com/profile_images/1455446663284523008/Fm6GWG1H.jpg", "header_url": null, "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "skills": [{"genre": "art"}], "nc": 160}, {"id": 92036, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "葡萄用図", "screen_name": "BUDOPROGRAM", "avatar_url": "https://pbs.twimg.com/profile_images/1890324981290266624/qCUeIqnG.jpg", "header_url": "https://pbs.twimg.com/