。\n今回お願いしたいのは、私の創作キャラクター「アマモ」と「イクチ」のイラストです。 二人は“「魚」と呼ばれる化け物退治を専門とする会社”に勤めるバディで、アマモが戦闘担当、イクチがサポート担当です。アマモは自由奔放、イクチは口が悪く冷静で、罵り合いながらも強い信頼関係で結ばれています。\nご依頼内容としては「二人の信頼関係、仲の良さ」が伝わる1枚絵をお願いしたいです。構図はフチカビさんの解釈にお任せいたしますが、可能であれば「暖かな日差しのある路地裏で仕事終わりに笑い合う2人。」という雰囲気で描いていただけると嬉しいです。\n頂いた画像はiPadのホーム画面に使用させて頂く予定ですので2360 x 1640ピクセルで描いて頂きたいです。よろしくお願いします。\n\nhttps://drive.google.com/drive/folders/1gYr2sEvUCks4GpOIiJdyavSFB__Ilaa3", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@shamom0_/works/31", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2465721, "client_id": 3571312, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/4afb9e81/uploads/origins/25f4af51-d352-44ce-96e6-c4b24bfab605?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e96199e561f865bfa9636ff5761d0571", "srcset": "https://si.imgix.net/4afb9e81/uploads/origins/25f4af51-d352-44ce-96e6-c4b24bfab605?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e96199e561f865bfa9636ff5761d0571, https://si.imgix.net/4afb9e81/uploads/origins/25f4af51-d352-44ce-96e6-c4b24bfab605?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=51350bc164fdd12b007fce38ebb6dc06 2x, https://si.imgix.net/4afb9e81/uploads/origins/25f4af51-d352-44ce-96e6-c4b24bfab605?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=9f58554864803c31087b12b9583ecffc 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/4afb9e81/uploads/origins/25f4af51-d352-44ce-96e6-c4b24bfab605?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d905ef0aeb4c31aea5325b4b9c45c586", "srcset": "https://si.imgix.net/4afb9e81/uploads/origins/25f4af51-d352-44ce-96e6-c4b24bfab605?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d905ef0aeb4c31aea