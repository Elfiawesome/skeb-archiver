し日焼けしている。\n\nMelodyの髪はこの例のように乱れ、ふわふわしている。\nhttps://drive.google.com/drive/folders/1vJlsOq5AJLVy9s2sTt7FqeG7ZB5w50_l?usp=sharing\n\nご自由に描いてください。先生にとってかっこいいシーンであればうれしいです。\n\nご検討よろしくお願いします。\n\nhttps://drive.google.com/drive/folders/1o5wVZm2_d96skaWohudJzxVatK2kXtGI", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@nhrg806/works/1", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/821fb33e/uploads/origins/35b1965e-98a9-42e9-b39b-f15160a5ec09?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=3ddb970a6749d5ca8dfa87e6afa295aa", "srcset": "https://si.imgix.net/821fb33e/uploads/origins/35b1965e-98a9-42e9-b39b-f15160a5ec09?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=3ddb970a6749d5ca8dfa87e6afa295aa, https://si.imgix.net/821fb33e/uploads/origins/35b1965e-98a9-42e9-b39b-f15160a5ec09?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=c1b4edc751bcddad63be01c2082917d4 2x, https://si.imgix.net/821fb33e/uploads/origins/35b1965e-98a9-42e9-b39b-f15160a5ec09?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=a07dde0854a8c686d47a6adc223c5f77 3x"}, "private": true, "genre": "art", "tipped": false, "creator_id": 1465208, "nc": 17}], "sent_works": [], "similar_creators": [{"id": 500066, "creator": true, "nsfw_acceptable": false, "acceptable": false, "name": "でこのすけ", "screen_name": "chicken_X", "avatar_url": "https://pbs.twimg.com/profile_images/1223783136447717377/XhwSHLuM.png", "header_url": "https://pbs.twimg.com/profile_banners/336537751/1670620144/1