でまた\n繰り返し\n恨み製造機\n\nBメロ2\nあー踊れ踊れ怒りにまかせて\nおのれおのれ回り出した世界め！！\n\nラスサビ\nおまえの息を止めれば\n私が笑えるのなら\n私が過ごしたはずの日々\n全て捧ぐわ全て捧ぐわ\n\n私も結局同じ血が流れてる\n家族なのね！ねぇ、なぁ！\n\nhttps://drive.google.com/drive/folders/1XMiqQM0sk_dXVw2LUJazQZ1mNoWevvbI", "nc": 153, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@kuroDen_waa/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 729466, "client_id": 2580068, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/2584e37d/uploads/origins/03811fa4-de98-47ca-aae9-b0415d2694c9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f34f5ca372d078fe06fc5dade5bfb4fc", "srcset": "https://si.imgix.net/2584e37d/uploads/origins/03811fa4-de98-47ca-aae9-b0415d2694c9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f34f5ca372d078fe06fc5dade5bfb4fc, https://si.imgix.net/2584e37d/uploads/origins/03811fa4-de98-47ca-aae9-b0415d2694c9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=bde6f15a622d3234ec0cc2f27365bc1b 2x, https://si.imgix.net/2584e37d/uploads/origins/03811fa4-de98-47ca-aae9-b0415d2694c9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f75eebfc33bec65b23d3d03ef7a85683 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/2584e37d/uploads/origins/03811fa4-de98-47ca-aae9-b0415d2694c9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c8cd2cfed0d55d764cd3a62528b3d470", "srcset": "https://si.imgix.net/2584e37d/uploads/origins/03811fa4-de98-47ca-aae9-b0415d2694c9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c8cd2cfed0d55d764cd3a62528b3d470, https://si.imgix.net/2584e37d/uploads/origins/03811fa4-de98-47ca-aae9-b0415d2694c9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=68a