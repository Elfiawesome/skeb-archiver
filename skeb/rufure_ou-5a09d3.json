fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ec183de84f7e614018031dda6736bef2, https://si.imgix.net/eddf5259/uploads/origins/36f91cee-6e7c-402d-81b5-40dfcb8d845e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=79b6b7efdbe35308c564abd4d90dd1ea 2x, https://si.imgix.net/eddf5259/uploads/origins/36f91cee-6e7c-402d-81b5-40dfcb8d845e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=f9b71156d1e1afb2c3c047641906b5ad 3x"}, "body": "ゆかこ先生と同じ体位で楓さんのダイバージェンスレイプ絵をお願いします。\n\n●コス\n幻装変身(複雑な衣装なので、ショーツと靴以外簡略化して大丈夫です)\nまたは\n水着2017＋ポニテ\n\n●相手\nゆかこ先生を犯してたオブリ\nまたは\n資料内の猿オブリを人サイズまで縮めた奴\n\n●シチュ\n妊娠の恐怖に泣き叫ぶも中出しで絶頂しながら受精\n子宮に注がれた精子の数がトータルスコアで表示\n\nhttps://drive.google.com/folderview?id=1Ayk0Dw_T4AXELwtvG66sYi50a72Bf_FH", "nc": 187, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@rufure_ou/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1172467, "client_id": 202549, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/4eb2f16e/uploads/origins/4d25a7d5-254c-444c-8c2a-c4ca14fc2e22?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2e27d199160b36f77dc7604528bc4b22", "srcset": "https://si.imgix.net/4eb2f16e/uploads/origins/4d25a7d5-254c-444c-8c2a-c4ca14fc2e22?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2e27d199160b36f77dc7604528bc4b22, https://si.imgix.net/4eb2f16e/uploads/origins/4d25a7d5-254c-444c-8c2a-c4ca14fc2e22?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=16b5ba92cc62064b9483edb1c274d5c3 2x, https://si.imgix.net/4eb2f16e/uploads/origins/4d25a7d5-254c-444c-8c2a-c4ca14fc2e22?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=709d928e63f3a781618d8b2bb83680f1 3x"}, "duration": null, "nsfw": true, "hardcore": true, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/4eb2f16e/uploads/origins/4d25a7d5-254c-444c-8c2a-c4ca14fc2e22?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=93ae930fe68d218de5b8b7058e6f2eb1", "srcset": "https://si.imgix.net/4eb2f16e/uploads/origins/4d25a7d5-254c-444c-8c2a-c4ca14fc2e22?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=93ae930fe68d218de5b8b7058e6f2eb1, https://si.imgix.net/4eb2f16e/uploads/origins/4d25a7d5-254c-444c-8c2a-c4ca14fc2e22?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=5e1881e72c490ea5445c7ba6c737c89d 2x, https://si.imgix.net/4eb2f16e/uploads/origins/4d25a7d5-254c-444c-8c2a-c4ca14fc2e22?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=fc58de0d0470658c119940968e2431af 3x"}, "body": "ルフレ王さん！超お久しぶりです！\nSkebを始められたということでリクしに来ました！\n\n〜キャラ〜\nスクストの『千年夕依＆賢宮ほたる』でお願いします！\n\n〜シチュ〜\n昔描いてくれた\"つぶあんサイコパス＆つぶあんサイコパスの奴隷\"が見てみたいので\n『腹がパンパンになるまでほたるちゃんにつぶあんを食わせる夕依ちゃん』でお願いします！\nあれの豪華版(？)が見てみたいです！\n\n〜構図〜\n夕依ちゃんは、とにかくほたるちゃんにつぶあんを食わせるような感じでお願いします！\n\nほたるちゃんは、もう食わされるがままのような感じでお願いします！\n\"腹がパンパン\"ということで、ほたるちゃんのお腹はかなり大きく膨らませてください！(昔描いてくれたお腹パンパン絵以上だと嬉しいです)\n\n〜表情〜\n夕依ちゃんは『にっこにこで食べさせる』感じで\nほたるちゃんは『無気力そうな』感じで！\n顔のタッチですが、しっかりとしたタッチでもゆるゆるとしたタッチでもどちらでも構いません！お好きな方を！\n\n〜服装・髪型〜\n共に『制服(冬)』でお願いします！\nまた、髪型も共に通常のもの(夕依はロング、ほたるはツインテ)でお願いします！\n\n〜その他〜\n背景はあってもなくてもどちらでも構いません！余裕があればでどうぞ！(背景デザもおまかせします)\nまた、空いたところにつぶあんの山を描いてくれると嬉しいです！\n更にですが、『軽いセリフ』と『ほたるちゃんの食べた量(個数)』もあると嬉しいです！\n\n以上になります！\nよろしくお願いします！ﾍﾟｺﾘ((･ω･)_ _))", "nc": 186, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@rufure_ou/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1172467, "client_id": 197539, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/27ec037c/uploads/origins/2075ff22-3611-4dcb-be3e-19440f93b6a8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=2