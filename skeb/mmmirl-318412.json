ホタテの赤ちゃん様のイラストの絵柄が大好きで、いつも拝見させていただいております。\n\nこの度、ユニット『果汁23％』で活動している「蜜柑月オレコ（ミカヅキオレコ）」と「茜月ももね（アカツキモモネ）」の2人のイラストをお願いしたくご連絡いたしました。\n\n  【イラスト】\n・構図の指定は特にありません。\n・人物のみの画像もいただけると幸いです。\n\n  【使用用途】\n・Vtuber活動での使用(配信のサムネ、SNS活動用画像、アイコン等)\n\n【資料】\n・蜜柑月オレコ→ https://twitter.com/mikadukioreko/status/1553370261394948101?s=46&t=qX3Z46TgC7MvrvOCQkaUyg\n・茜月ももね→ https://twitter.com/akatsuki_momone/status/1619558128479252480?s=46&t=qX3Z46TgC7MvrvOCQkaUyg\n\nお忙しいとは思いますが、何卒ご検討よろしくお願いいたします。", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@mmmirl/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2468647, "client_id": 2331272, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/589df094/uploads/origins/3005f162-3704-4ee3-9d71-4697ba7046f9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=48a83c97e36366445db06567ffaa0821", "srcset": "https://si.imgix.net/589df094/uploads/origins/3005f162-3704-4ee3-9d71-4697ba7046f9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=48a83c97e36366445db06567ffaa0821, https://si.imgix.net/589df094/uploads/origins/3005f162-3704-4ee3-9d71-4697ba7046f9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a0b76a025e44d7dd0384f6234a4fa64d 2x, https://si.imgix.net/589df094/uploads/origins/3005f162-3704-4ee3-9d71-4697ba7046f9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=671015e232ad170e30c8d55f1f8e1238 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/589df094/uploads/origins/3005f162-3704-4ee3-9d71-4697ba7046f9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a66457b7ec003f9397e253c1e64c155f", "srcset": "https://si.imgix.net/589df094/uploads/origins/3005f162-3704-4ee3-9d71-4697ba7046f9?bg=%23fff&auto=format%2Ccompress&fm=webp