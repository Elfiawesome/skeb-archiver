meronn/works/11", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3062518, "client_id": 457965, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/9c67d3d4/uploads/origins/34a91531-45f9-494f-b311-c9fdb18cfa35?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9c57c25659bb93cc544d4d5d588df8df", "srcset": "https://si.imgix.net/9c67d3d4/uploads/origins/34a91531-45f9-494f-b311-c9fdb18cfa35?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9c57c25659bb93cc544d4d5d588df8df, https://si.imgix.net/9c67d3d4/uploads/origins/34a91531-45f9-494f-b311-c9fdb18cfa35?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ddb730da254ef2e9cd001ed854799542 2x, https://si.imgix.net/9c67d3d4/uploads/origins/34a91531-45f9-494f-b311-c9fdb18cfa35?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=523575c3a3035a59af69c3f340bcbaf2 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/9c67d3d4/uploads/origins/34a91531-45f9-494f-b311-c9fdb18cfa35?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=59d13b7bfed8d85b3a439483b6ecec37", "srcset": "https://si.imgix.net/9c67d3d4/uploads/origins/34a91531-45f9-494f-b311-c9fdb18cfa35?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=59d13b7bfed8d85b3a439483b6ecec37, https://si.imgix.net/9c67d3d4/uploads/origins/34a91531-45f9-494f-b311-c9fdb18cfa35?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=293f0868db1350d9481314c6d6a5e242 2x, https://si.imgix.net/9c67d3d4/uploads/origins/34a91531-45f9-494f-b311-c9fdb18cfa35?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=93aeb5fe38bf8cedaa88ab4840b90e35 3x"}, "body": "初めまして、けいせん様 \n\n【キャラクター】  \n桜乃そら(ふたなり)   \nhttps://www.ah-soft.com/sora/\n\n京町セイカ\nhttps://www.ah-soft.com/seika/\n\n【内容】  \nセイそらによるフェラ+飲尿プレイするイラストをお願いします。 \n\n酔っ払いセイカさんの締めの最後感覚として、そらさんの勃起した陰部を咥えて行為している。(セイカさんは美味しいそうにフェラ抜きしており、それに気持ち良さそうに感じているそらさん)。\n\n射精後、尿意を催すそらちゅんだが、察したセイカさん(まだ出るんでしょう？我慢せずにスッキリしちゃいなよ❤︎なイメージ)が陰部に刺激を与え、そのままセイカさんお口へ放尿してしまうそらさんというシチュエーションでお願いします。  \n\n\n・構図・ポーズ、2人の衣装選定、背景、差分など作者様全てお任せします。 もし可能でしたら、そらさんの胸部を描くのでありましたら貧乳でお願いします。  \n\n・飲尿という小スカ要素がある為、もし難しいのでありましたらフェラのみで大丈夫です。\n\nニッチなリクエスト内容、且つ金額で厳しい場合はキャンセルしても構いません。\n\nご検討をよろしくお願いします。", "nc": 49, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@takizawameronn/works/10", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3062518, "client_id": 3282056, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/702d6cc9/uploads/origins/80d98278-4b17-4eff-a709-36984b93766a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d616bf493fe4c972b23968bd6c4a45e5", "srcset": "https://si.imgix.net/702d6cc9/uploads/origins/80d98278-4b17-4eff-a709-36984b93766a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d616bf493fe4c972b23968bd6c4a45e5, https://si.imgix.net/702d6cc9/uploads/origins/80d98278-4b17-4eff-a709-36984b93766a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=6b34e770498f39e0ccffc1aca733bea6 2x, https://si.imgix.net/702d6cc9/uploads/origins/80d98278-4b17-4eff-a709-36984b93766a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c1cc65015d99994706f14c33f96cd57f 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/702d6cc9/uploads/origins/80d98278-4b17-4eff-a709-36984b93766a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=4e9e50a9171e882a9e3b5246b61abcdb", "srcset": "https://si.imgix.net/702d6cc9/uploads/origins/80d98278-4b17-4eff-a709-36984b93766a?bg=%23fff&auto=format%2Ccompress