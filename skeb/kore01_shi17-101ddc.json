さい\n（もしくは「その他衣装」から飛べるフォルダの中にお好みの衣装があれば、そちらを着せてあげてください）\n耳尻尾の有無はお好みでお任せします\n表情・仕草・ポーズについてはお任せします\n見た目からのイメージで描いていただければと思います\n\nご検討をお願いします\n\nhttps://drive.google.com/drive/u/0/folders/1gXZVDfcsl66QZ8VxPLKFXERqQXKioNsJ", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@kore01_shi17/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3612753, "client_id": 1894687, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/b0c6d124/uploads/origins/509432c5-9c6c-4df3-b79b-c58c209690f0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8e27375d5a4b3a16ac2ac96c3408ec57", "srcset": "https://si.imgix.net/b0c6d124/uploads/origins/509432c5-9c6c-4df3-b79b-c58c209690f0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8e27375d5a4b3a16ac2ac96c3408ec57, https://si.imgix.net/b0c6d124/uploads/origins/509432c5-9c6c-4df3-b79b-c58c209690f0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a4ee21203ac531d92fa85c462ecb0b19 2x, https://si.imgix.net/b0c6d124/uploads/origins/509432c5-9c6c-4df3-b79b-c58c209690f0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=92d90d202c6e7c8f239c15bba07961aa 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/b0c6d124/uploads/origins/509432c5-9c6c-4df3-b79b-c58c209690f0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=364e94e7bfd9f73d747aa723af885800", "srcset": "https://si.imgix.net/b0c6d124/uploads/origins/509432c5-9c6c-4df3-b79b-c58c209690f0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=364e94e7bfd9f73d747aa723af885800, https://si.imgix.net/b0c6d124/uploads/origins/509432c5-9c6c-4df3-b79b-c58c209690f0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=fe4190