-5f95-4d2a-8e41-cdcdec3359a5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a860fb2fb2212508b093de2c955a772e, https://si.imgix.net/da4e9adb/uploads/origins/370037c9-5f95-4d2a-8e41-cdcdec3359a5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=700e5ded3e41402cd3ae25e41ffce1f6 2x, https://si.imgix.net/da4e9adb/uploads/origins/370037c9-5f95-4d2a-8e41-cdcdec3359a5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=042e8509ce92357d3d7260e0832bcbba 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/da4e9adb/uploads/origins/370037c9-5f95-4d2a-8e41-cdcdec3359a5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=21eb4951922418ae87671b873d618209", "srcset": "https://si.imgix.net/da4e9adb/uploads/origins/370037c9-5f95-4d2a-8e41-cdcdec3359a5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=21eb4951922418ae87671b873d618209, https://si.imgix.net/da4e9adb/uploads/origins/370037c9-5f95-4d2a-8e41-cdcdec3359a5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=57d8d496270dbebb3a8f306135dd1a60 2x, https://si.imgix.net/da4e9adb/uploads/origins/370037c9-5f95-4d2a-8e41-cdcdec3359a5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=b4f616655779f1a548bb0829436c5636 3x"}, "body": "こんばんは。夜分遅くに失礼します。\n個人鑑賞用のイラストをお願いしたく、ご依頼いたしました。\n\nま行様の作品が長年大好きで、絵柄はもちろん、人物の捉え方や色使い、作字の雰囲気まで含めてずっと大好きです。ま行様のネップリを就職試験の最終面接にお守り代わりとして持って行ったり、今もベッドの横に飾っていたりと、日々癒しを頂いています。\n\n今回、ぜひま行様の作品を一人暮らしの部屋に飾りたいと思い依頼させていただきました。最大でA2程度まで引き伸ばしてポスターとして額縁に入れて飾ることを想定しております。\n\n部屋はピンク・薄紫・白を基調としているため、その空間に馴染むような雰囲気だととても嬉しいです。\n\nモチーフや世界観は基本的にお任せしますが、人物が入っていると特に嬉しいです。また、ま行様の文字のデザインやあしらいが大好きなので、もし可能であればどこかに「miwa」という文字を入れていただけると大変嬉しいです。\n\n好きなモチーフは、\n・リボン\n・お花\n・紅茶\nなどです。\n\n人物のビジュアルの好みとしては、\n【女の子】\n・呪術廻戦の三輪霞さん\n・にじさんじの御子神琴音さん\n【男の子】\n・A3!の月岡紬さん\n・にじさんじの榊ネスさん\n\nのような雰囲気が好きです。\n\nただ、上記はあくまで「好みの参考」であり、キャラクターを描いていただきたいという意味ではありません。\n\n何よりもま行様の感性や表現が大好きなので、構図・モチーフ・人物デザインなどは基本的にお任せしたいと思っております。どうかご負担のない範囲で、自由に描いていただけたら嬉しいです。\n\n出品価格以上のお礼をお渡ししたく、今回は5,000円で依頼させていただく予定です。料金の範囲内でご対応いただける内容で全く問題ございません。\n\n納期につきましても特に急いでおりませんので、ま行様のご都合の良いタイミングでご制作いただければ幸いです。もし可能でしたら半年以内程度でいただけますと嬉しいですが、無理のない範囲でご対応いただければと思います。\n\n素敵なご縁になりましたら幸いです。\nどうぞよろしくお願いいたします。", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@_mgyou_/works/1", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/7ad5cb33/uploads/origins/4bd32668-23cd-4cb9-ae21-4d29a86c2843?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=500f6cc1de01292b3630dcf471b4881e", "srcset": "https://si.imgix.net/7ad5cb33/uploads/origins/4bd32668-23cd-4cb9-ae21-4d29a86c2843?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=500f6cc1de01292b3630dcf471b4881e, https://si.imgix.net/7ad5cb33/uploads/origins/4bd32668-23cd-4cb9-ae21-4d29a86c2843?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=b1de26c4fbb7bf6433c3f6d43f0d07f6 2x, https://si.imgix.net/7ad5cb33/uploads/origins/4bd32668-23cd-4cb9-ae21-4d29a86c2843?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=cd7fdc4ccd9323d19a1fce6df1ac4c1e 3x"}, "private": true, "genre": "art", "tipped": false, "creator_id": 4042777, "client_id": 3168812, "nc": 129}], "sent_works": [], "similar_creators": [{"id": 1998277, "creator": true, "nsfw_acceptable": false, "acceptable": false, "name": "Ema3", "screen_name": "ema3art", "avatar_url"