": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 49, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@organ3432/works/35", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/61739f41/uploads/origins/d3e44a76-d9c4-46b5-a575-4e0934f5368c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=e97a39525ea314bd9234bf548d713f37", "src_set": ""}, "private": true, "genre": "art", "tipped": true, "creator_id": 119754, "client_id": 2042838, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 49, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@organ3432/works/34", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 119754, "client_id": 0, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/705e26f2/uploads/origins/118e7859-2a68-4a6c-8c23-916fc8e1cdd6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f5e77a4f8f00c469aafa35e710b52657", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/705e26f2/uploads/origins/118e7859-2a68-4a6c-8c23-916fc8e1cdd6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3da661e737ccf214e20daa2f0efdc474", "src_set": ""}, "body": "いつも大変お世話になっております｡\n今回はアイドルマスターシャイニーカラーズ(シャニマス)の有栖川夏葉をリクエストします｡\n\nシチュはホテルの浴室での対面立位\n•純愛な雰囲気でディープキスしながらセックスしている\n•2人を横から見た視点\n•夏葉はPの首に手を回し､Pは夏葉の腰に手を回してor添えている\n•胸は垂れてなくB85より盛ってください(あまりにも大きすぎないように)\n•Pの身長は夏葉の顔が少し上を向きながらキスをしている位に高い(夏葉168cmに対しPは少し上くらいに)\n•Pの体格はしっかりしていて､なるべくenza版(ゲーム)の髪型にしてください(目は隠れている)\n•アへ顔やオホ声はなし\n•セリフは夏葉のみで､(Pの体が)逞しくて素敵や私の膣内はどうかしら？等の様々な内容をお願いします\n\n改変や省略しても構いませんので以下の差分をお願いします｡\n•キスをする前\n•舌だけを絡めあっているディープキス\n•挿入前(「プロデューサーの•••硬くて立派ね」みたいなセリフ)→挿入→一息→動かす→ラスト直前→ラストスパート\n•絶頂&射精(キスをしながら「んっ」と絶頂する夏葉)\n•余韻で口を離し唾液をアーチさせながら「ふふっまだ大きいわ､さすが私のプロデューサーね」「続きはベッドでしましょう」みたいなセリフでまだ余裕ある感じで\n•できたらでいいですので腰を引いている(動かしている)差分をお願いします｡難しければ密着しているのだけで構いません\n•断面図ありなし\n•セリフや擬音や湯気やエフェクトのありなし\n\n注文が多くて大変恐縮ですが､ご検討をよろしくお願いします｡", "nc": 49, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@organ3432/works/33", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/ec35c5cd/uploads/origins/2f4a4e3c-0ac5-4900-8a4d-2d5f9a9d3340?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=de9203ad38bf9db6ac0c8d85ec64e831", "src_set": ""}, "private": true, "genre": "art", "tipped": false, "creator_id": 119754, "client_id": 0, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 160, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}], "similar_creators": [{"id": 20899, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "hakuutu二代目@skeb募集中", "screen_name": "kokuutu2", "avatar_url": "https://pbs.twimg.com/profile_images/1764149567409541120/lgTtRaIj.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1159453630312792065/1707259602/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 7, "skills": [{"genre": "art"}, {"genre": "comic"}, {"genre": "novel"}, {"genre": "correction"}], "nc": 40}, {"id": 104254, "creator": true, "nsfw_acceptable": true, "acceptable": false, "name": "パンダィン＠C106合同誌ありまぁす！", "screen_name": "pandain95", "avatar_url": "https://pbs.twimg.com/profile_images/18759260664