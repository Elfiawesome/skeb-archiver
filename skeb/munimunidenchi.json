": false, "total_appeals_count": 0, "received_works": [{"path": "/@munimunidenchi/works/13", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3341935, "client_id": 439569, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/7677d1fa/uploads/origins/eb1a5194-6fb2-49b5-a17b-a3188c356a9f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8393741beac58f52c93c39ddce9efd77", "srcset": "https://si.imgix.net/7677d1fa/uploads/origins/eb1a5194-6fb2-49b5-a17b-a3188c356a9f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8393741beac58f52c93c39ddce9efd77, https://si.imgix.net/7677d1fa/uploads/origins/eb1a5194-6fb2-49b5-a17b-a3188c356a9f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=407b3cb1aca2ce1c76361d7f5f79c702 2x, https://si.imgix.net/7677d1fa/uploads/origins/eb1a5194-6fb2-49b5-a17b-a3188c356a9f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=464a82e2af43ec824ff4df86315fb9e9 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/7677d1fa/uploads/origins/eb1a5194-6fb2-49b5-a17b-a3188c356a9f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=cd6c91fc1263a1f37014e98c883b47f8", "srcset": "https://si.imgix.net/7677d1fa/uploads/origins/eb1a5194-6fb2-49b5-a17b-a3188c356a9f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=cd6c91fc1263a1f37014e98c883b47f8, https://si.imgix.net/7677d1fa/uploads/origins/eb1a5194-6fb2-49b5-a17b-a3188c356a9f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=fa55539dd18cdd88a486b6ae6cd1e297 2x, https://si.imgix.net/7677d1fa/uploads/origins/eb1a5194-6fb2-49b5-a17b-a3188c356a9f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=391f3c56176948e2d91846767b525610 3x"}, "body": "初めまして｡\n\n｢めちゃカッコいいサマルトリア王子の依頼があるな～｣とお名前を拝見しましたら､以前から存じ上げている御方でたまげました｡\n貴方が昔pixivに投稿したマンドリルのイラストはルーブル美術館に飾るべき名画だと思っております｡\n\nもしよろしければ､私からもドラクエ2でリクエストを送らせてください｡\n\n【使用用途】\n個人観賞及び､スマホ及びタブレットPCでの壁紙の利用のみになります｡\n\n【テーマ】\n｢石つぶてを放つ､ローレシア王子｣でお願いします｡\n\n最近発売されたHD-2D版ドラクエ2でのローレシア王子は､日々の鍛練や兵士長との組み手の賜物か､Lv1の時点で複数の特技を習得しているのですが､そのどれもが単体攻撃｡\n\nそして､こちらが1人だろうがお構い無しに群れを成して襲いかかってくるモンスターとの実戦を経てレベルアップし､最初に自力で覚える特技が､王国仕込みの剣技でも何でもない｢石つぶて｣…\n\nという所に､勿論ゲームバランスの事情もあるでしょうが､一対多の戦闘の過酷さと､呪文が使えなくたってその辺の石を利用して真っ先に(恐らく歴代ドラクエ主人公最速で)全体攻撃を習得してしまうローレシア王子の戦闘センスの高さを感じられる､フレーバーとしての役割も担っている特技だと思っています｡\n\nですので､石つぶてを放っているローレシア王子の表情は冷静でも我武者羅でも良いです｡\n\nその他､説明不足な点がございましたらご自由に解釈·描写されてください｡\n\nスケジュールやコンディション､提示した金額等に問題無ければ､ご検討のほど宜しくお願いします｡", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@munimunidenchi/works/12", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3341935, "client_id": 3349859, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/c92741f6/uploads/origins/21bf85dd-ff87-49ea-bbd4-4553ac8c623b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=16dc3320a3a5016e776dbd233901706c", "srcset": "https://si.imgix.net/c92741f6/uploads/origins/21bf85dd-ff87-49ea-bbd4-4553ac8c623b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=16dc3320a3a5016e776dbd233901706c, https://si.imgix.net/c92741f6/uploads/origins/21bf85dd-ff87-49ea-bbd4-4553ac8c623b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=6775fe3f7690258c5a47b6eefc1d7f18 2x, https://si.imgix.net/c92741f6/uploads/origins/21bf85dd-ff87-49ea-bbd4-4553ac8c623b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=84fc3d66e0599af2f5d8234fa0c6c0c6 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/c92741f6/uploads/origins/21bf85dd-ff87-49ea-bbd4-4553ac8c623b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5cd6fddc6e686e03c5402ee614452947", "srcset": "https://si.imgix.net/c92741f6/uploads/origins/21bf85dd-ff87-49ea-bbd4-4553ac8c623b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5cd6fddc6e686e03c5402ee614452947, https://si.imgix.net/c92741f6/uploads/origins/21bf85dd-ff87-49ea-bbd4-4553ac8c623b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=d817907806d3a1f15f25dc0db6b9cdf5 2x, https://si.imgix.net/c92741f6/uploads/origins/21bf85dd-ff87-49ea-bbd4-4553ac8c623b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=c48650d5bce513f69856dd99fe9ad889 3x"}, "body": "伊藤先生、こんにちは。お疲れさまです！\n今回依頼させていただくのは、漫画・アニメで大人気\n「葬送のフリーレン」の主人公・フリーレンです。\n私はアニメ勢なのですが、大・大・大好きなキャラです。\n構図、等々全ておまかせします！\n伊藤先生の絵で描かれるフリーレン、どのようになるか楽しみです♪\n何卒、よろしくお願いいたします。", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@munimunidenchi/works/11", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/3465eb0c/uploads/origins/997c6f1e-fa89-4c5b-b29a-0b19a4f77599?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=66c4560f8f7a250d51e02aaafca9dc56", "srcset": "https://si.imgix.net/3465eb0c/uploads/origins/997c6f1e-fa89-4c5b-b29a-0b19a4f77599?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=66c4560f8f7a250d51e02aaafca9dc56, https://si.imgix.net/3465eb0c/uploads/origins/997c6f1e-fa89-4c5b-b29a-0b19a4f77599?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=ca13f21a7bb690e57629d3dc70209ebf 2x, https://si.imgix.net/3465eb0c/uploads/origins/997c6f1e-fa89-4c5b-b29a-0b19a4f77599?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=8cf33d8573e79c67837e949d5dfdd51f 3x"}, "private": true, "genre": "art", "tipped": false, "creator_id": 3341935, "client_id": 22998, "nc": 17}, {"path": "/@munimunidenchi/works/10", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3341935, "client_id": 2191796, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/b8db0c3c/uploads/origins/ce7c41cd-99a1-46b8-bafb-7fb673f7d582?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=30678ba52365cbcf0b2198230e3f7fd9", "srcset": "https://si.imgix.net/b8db0c3c/uploads/origins/ce7c41cd-99a1-46b8-bafb-7fb673f7d582?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=30678ba52365cbcf0b2198230e3f7fd9, https://si.imgix.net/b8db0c3c/uploads/origins/ce7c41cd-99a1-46b8-bafb-7fb673f7d582?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=2d67202a62241fbe2a44f5ef96216d54 2x, https://si.imgix.net/b8db0c3c/uploads/origins/ce7c41cd-99a1-46b8-bafb-7fb673f7d582?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a589101f976d003f47121c6133e200eb 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/b8db0c3c/uploads/origins/ce7c41cd-99a1-46b8-bafb-7fb673f7d582?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9532ec22f84e65d6cbd0f0ebadf41e53", "srcset": "https://si.imgix.net/b8db0c3c/uploads/origins/ce7c41cd-99a1-46b8-bafb-7fb673f7d582?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9532ec22f84e65d6cbd0f0ebadf41e53, https://si.imgix.net/b8db0c3c/uploads/origins/ce7c41cd-99a1-46b8-bafb-7fb673f7d582?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=d2e0a37bc9e16a98004cf2e3fe9914c0 2x, https://si.imgix.net/b8db0c3c/uploads/origins/ce7c41cd-99a1-46b8-bafb-7fb673f7d582?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=968416f913d22272b7133d22ce5af88d 3x"}, "body": "こんにちは！あなたの作品が大好きです！私のゴーストガールのOCを描いていただけませんか？具体的には、彼女のマリオネットの姿を描いてほしいんだ。\nマリオネットは基本的に人間サイズの磁器製マリオネットで、彼女が閉じ込められている領域から出るときに操ります。主な目的は研究資料や本を調達することですが、彼女の自我意識が歪んでしまったため、『キャラクターを演じる』機会としても使っています。\n絵については、自由に構成してください。舞台は何でも構いませんが、屋外の場合は雨か雪が降っている方がいいです。\nよろしくお願いします！\n\nhttps://drive.google.com/drive/folders/17xWEFl-w9HKRJF62A4MiA3ICmoefju_g?usp=sharing", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@munimunidenchi/works/9", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3341935, "client_id": 1778086, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/fd83090b/uploads/origins/b034b0a0-9df8-4401-8e8c-d175d73cbe1c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=cc2353acad21884fe4f7ff3cbc410a85", "srcset": "https://si.imgix.net/fd83090b/uploads/origins/b034b0a0-9df8-4401-8e8c-d175d73cbe1c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=cc2353acad21884fe4f7ff3cbc410a85, https://si.imgix.net/fd83090b/uploads/origins/b034b0a0-9df8-4401-8e8c-d175d73cbe1c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=7f61e9e091d01a309f526a792f3e510c 2x, https://si.imgix.net/fd83090b/uploads/origins/b034b0a0-9df8-4401-8e8c-d175d73cbe1c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=6a27fcc9e22dd8c8deea0e04aefe1e5b 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/fd83090b/uploads/origins/b034b0a0-9df8-4401-8e8c-d175d73cbe1c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=33719bf6f8048d93e4e588de532ec270", "srcset": "https://si.imgix.net/fd83090b/uploads/origins/b034b0a0-9df8-4401-8e8c-d175d73cbe1c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=33719bf6f8048d93e4e588de532ec270, https://si.imgix.net/fd83090b/uploads/origins/b034b0a0-9df8-4401-8e8c-d175d73cbe1c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=3e2dd1d0f0e57a4a895626419de2ac3f 2x, https://si.imgix.net/fd83090b/uploads/origins/b034b0a0-9df8-4401-8e8c-d175d73cbe1c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=7d77f95df9b8a82c269aa9638b05b81d 3x"}, "body": "伊藤サトシさま\n\nはじめまして、コバルトブルーと申します。\nこのたびは伊藤サトシさまの美しく素晴らしい作品の数々に魅了され、\nぜひ自分の好きなキャラクターを描いていただきたく、リクエストをお送りいたしました。\n\nお願いしたいキャラは「新ビックリマン」に登場する内裏クレオクス妃です。\nクレオパトラと雛人形を融合させたような独自のデザインで、ラスボスの妻として、エキゾチックで雅やかな雰囲気を持っています。\n\n艶やかで全身白塗りのような真っ白な肌に、アイメイク（隈取り）、さらに地毛の眉毛とは別に\n額に麻呂眉を描いた独自の化粧を施し、エルフ耳、豪華な頭巾や着物を身にまとっています。\nこちらのキャラを邪悪で妖艶な笑みを浮かべている顔アップのイラストとして、描いていただけると嬉しいです。\n\n参考資料を以下にまとめております。\nhttps://www.dropbox.com/scl/fo/qxl2f9nxi81k3za4jj0d3/AI5Dwv0fHBDhZj92cBHwBjA?rlkey=kknhocoyx5tj3zp3npz9wnya6&st=6rhs7me0&dl=0\n\nなお、アニメやシールでは隈取りがアイマスクのようにも見えますが、\n今回は肌に描いた隈取りとして表現していただけますと幸いです。\nまた、こちらの希望でぽってりとした唇に紫色の口紅を塗っていただけると嬉しいです。\n\nご検討いただけましたら幸いです。\nどうぞよろしくお願いいたします。", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@munimunidenchi/works/8", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/69b76f6a/uploads/origins/17397c00-f90c-4e7e-83e8-0d5a750c3728?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=2a590d7c985a404963fd8fc4e1bbe219", "srcset": "https://si.imgix.net/69b76f6a/uploads/origins/17397c00-f90c-4e7e-83e8-0d5a750c3728?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalig