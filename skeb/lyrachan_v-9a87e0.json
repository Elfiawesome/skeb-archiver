ラムです、何度もミスをしてしまいまして申し訳ございませんでした(-_-;)\n今回の依頼ですが、自分がカクヨムにて書いている小説の『建御名方之剣(たけみなかたのつるぎ)』に登場するメインキャラクターの一人、『日野照真(ひの　てるま)』という高校2年生の女の子のデザインとイラスト化をお願いしたいのです、外見のイメージは、髪型は栗色のショートボブで、肌の色は白目の肌色で、目の色は黒です。また、服装のイメージは作中からの引用になるのですが\n『亜麻のカットソーに白のフレアスカートを合わせ、桜色のブルゾンを羽織ってデニム地のリュックを肩に下げていて、頭にはグレーのベレー帽を被っている。』\nといった感じで、編み上げでは無いショートブーツを履かせて下さい。\n身長は181cm とのっぽで、体重は66kgで痩せ型です、スリーサイズは、B83cmW63cmH78cmといったイメージです。\n絵師さんにイラストを依頼するのは初めてなので、不備な部分があるかも知れないのですが、どうぞよろしくお願い致しますm(_ _)m\n(絵に関しては、作業配信やサンプルイラストとして公開されてもOKです)", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@lyrachan_v/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1804010, "client_id": 347236, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/6183433e/uploads/origins/41356250-108d-45f5-a285-08314c615173?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ce7ed0fe8c11c01ebc97823fc6d431cc", "srcset": "https://si.imgix.net/6183433e/uploads/origins/41356250-108d-45f5-a285-08314c615173?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ce7ed0fe8c11c01ebc97823fc6d431cc, https://si.imgix.net/6183433e/uploads/origins/41356250-108d-45f5-a285-08314c615173?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=47d8927f0277f04722042a11051355bd 2x, https://si.imgix.net/6183433e/uploads/origins/41356250-108d-45f5-a285-08314c615173?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=258f24fc45ce962fd58241eeb3030f32 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/6183433e/uploads/origins/41356250-108d-45f5-a285-08314c615173?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f434748ad78462764f83cf414b09181b", "srcset": "https://si.imgix.net/6183433e/uploads/origins/41356250-108d-45f5-a285-08314c615173?bg=%23fff&auto=for