lient_visible": false, "total_appeals_count": 0, "received_works": [{"path": "/@paipaidaichuki/works/9", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 57857, "client_id": 0, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/c89a1eba/uploads/origins/5a27f4d6-21ca-45cd-bd94-ceb96a9db870?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c833a3ef313c689b5ddbac05f47ab130", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/c89a1eba/uploads/origins/5a27f4d6-21ca-45cd-bd94-ceb96a9db870?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b43bc0586ac032f614702d68980d57d0", "src_set": ""}, "body": "こんにちは！\n褐色の黒ギャル女神ママに授乳手コキ赤ちゃんプレイされるイラストが見たいです。\n黒ギャルママは金髪でロングヘアー、目は青色、長身で全身ムチムチで爆乳。おいしい母乳が沢山出る。裸。\n女神の力で男の体を小柄な男の子にして大人赤ちゃん用の可愛いベビー帽と前かけ、ハート柄オムツはかせた状態でオムツを脱がせた状態で授乳手コキする\n黒ギャルママは母乳を飲ませながら優しくシコシコして「ママが一緒でちゅからねーヨチヨチ❤️」のような赤ちゃん言葉で甘やかす。\n大人赤ちゃんは「あ〜❤️う〜❤️ママァ〜❤️」と幼児退行してバブバブしながら射精する。\n難しいところや台詞は変更しても構いません！", "nc": 40, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@paipaidaichuki/works/8", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 57857, "client_id": 182552, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/edf8e16c/uploads/origins/cbbf6c95-6231-418e-8e69-7d29d1600b41?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=93ffd7afb8834ee5a5489ea7b5302eee", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/edf8e16c/uploads/origins/cbbf6c95-6231-418e-8e69-7d29d1600b41?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=df6d87e34e90c387b32cd7b4c8017e42", "src_set": ""}, "body": "初めまして。\n先生の描いた聖母の母乳像シリーズが大好きなのですが、\nこれの東洋の亜種版として「天女の母乳像」なるものを考えましたので、よろしければイラスト化して頂けないでしょうか。\n\n顔立ちは黒髪かつ可憐で清楚な大和撫子といった感じで、体型は他の母乳像と同じくとてもムチムチです。基本的に聖母の母乳像と同じく全裸ですが、天女らしく羽衣を追加して頂きたいです。\nそんな彼女は首を少し傾げながら、悟りを開いたかのような穏やかな微笑みを浮かべつつ、台座の上で座禅を組んでいます。そして片方の手は指で輪っかを作り(来迎印と呼ばれる仏様の手印)、もう片方の手は自身のおマンコをくぱぁと広げています。\nまた、彼女が座る台座について、以下の様な細工を施して欲しいです。\n①より東洋感を出したいので、台は蓮座(れんざ)でお願いします。\n②台は2段にして、彼女がお尻を付けている部分のみを少し高くして下さい。理由としては、平地での座禅だと足が邪魔しておマンコが見えなくなりますが、段差を付け、一段下げた所に組んだ足を置くことで、おマンコが見えるようにする為です。\n\nまた、我儘かもしれませんが、他の母乳像と同じく、石化ver.と、モブショタが彼女のおマンコに挿入しているverもお願いしたいです。\n\n以上、ご検討頂けると幸いです。", "nc": 184, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@paipaidaichuki/works/7", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/d7605e94/uploads/origins/bd01776b-8e0b-4328-808c-6887d1ab0acd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=610805f7a4e8951ae2c9872502d76bb1", "src_set": ""}, "private": true, "genre": "art", "tipped": true, "creator_id": 57857, "client_id": 562839, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 48, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@paipaidaichuki/works/6", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/a6f3c0d3/uploads/origins/c642f65e-dc7b-4367-9c9e-46d8bd31f897?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=85289391ccddb677b4885ee7070386fe", "src_set": ""}, "private": true, "genre": "art", "tipped": true, "creator_id": 57857, "client_id": 562839, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 161, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre