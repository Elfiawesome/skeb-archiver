ress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=61f92c21b96a186e6b6890c78238c9e1 3x"}, "body": "初めまして。ハルカの素晴らしいイラストから参りました。\nhttps://www.pixiv.net/artworks/145664466\n私のＯＣもクリエイター様が描かれたハルカのような絵柄で描いて欲しいと思いリクエスト持参致しました。\n以下本文です。\n\n参考画像です\n・https://livedoor.blogimg.jp/ninelives69/imgs/7/b/7bc0e600.jpg\nイラストは画像のようなでかい胸を主張するよなバストアップイラストを下さい。ポーズば正面から立ち胸上に手を添え肉感的な雰囲気で。\n胸の大きさは画像位大きくお願いします。形状的にも、画像のような平く大きく膨らみがある様な形状をお願いします。\n表情はこちらを値踏みするような笑みと長細い画像のような目付きをお願いします。この瞳よく見ると横に潰れていて、一目で狂気が宿っていると感じさせる目つきでお願いします。口は閉じています。\n\n背景はおまかせします。目に良い色だと嬉しいです。\n\nオリキャラについてです。\nhttps://drive.google.com/drive/folders/1Mgy3GC2hp9IJAJtEewdlKvhzMqA9PC2u \nこれが私のキャラクターになります。 黒白目、筋肉質、高身長、巨乳、金髪短い（耳が見えない程度の長さ）、人外要素を取り入れた敵女系キャラです。 黒白目の黒い装甲のキャラでございます。 肌はめっちゃ白いです（肌カラーフォルダ参照\n黒白目は黒白目ファイルをご覧下さい。赤い円形状の瞳になってます。\n衣装は・・・今回はこの三面のスポーティな黒装甲姿で行こうと思います。", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}], "sent_works": [], "similar_creators": [{"id": 63022, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "飛者@春例大祭あ06ab", "screen_name": "Uwata_h", "avatar_url": "https://pbs.twimg.com/profile_images/1987663726330429440/pC0rCLfu.jpg", "header_url": "https://pbs.twimg.com/profile_banners/989169537877594112/1738622693/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 120, "skills": [{"genre": "art"}, {"genre": "comic"}, {"genre": "correction"}], "banned": false, "nc": 129}, {"id": 92373, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "はなつるヲ/🚨Skeb→ Look at the pinned tweet固定にskebの詳細アリ", "screen_name": "hana_tsuru_wo", "avatar_url": "https://pbs.twimg.com/profile_images/1479363294393958403/mOtXsLrL.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1077893419605737473/1675926595/1500x500", "appeal_receivable": false, "popular_creator_ra