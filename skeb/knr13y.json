8e95-3a5d3ba39db7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c4fbc2ed2af6e38ff598fdacb7b7b6f9", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/4196de4c/uploads/origins/006319e7-c7f8-417d-8e95-3a5d3ba39db7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ac117398df2fee323f8a3cf334e4f276", "src_set": ""}, "body": "はじめまして、「はどー」と申します。Vtuberとして活動しております。\n\nかにぱん様の可愛らしく素敵なイラストを拝見し、\nぜひ自分の姿を描いていただきたいと思いリクエストを送らせていただきました！\n\n【依頼内容】\n私のイラストを描いていただきたいです。\n\n構図やポージング等について指定はありません。\nまた服装や髪型をアレンジいただいても大丈夫ですので、かにぱん様のインスピレーションでお願いできればと思います。\n\n【参考資料】\n外観については資料URLのGoogleドライブを参照いただければと思います。\n\n参考としてキャラクター設定ですが、\n「はどー」は趣味で勇者をやっている青年で正義感がありますが、厨二病でいたずら好きという一面も持っています。\n\n【使用用途】\n・収益化済のYoutubeチャンネルでのサムネイルや映像内での利用\n・各種SNSでの利用（アイコンやヘッダー）\nAI学習防止用のためにウォーターマークやノイズ処理をさせていただくことがあります。\n\n以上となります。ご検討のほどよろしくお願いいたします！\n\nhttps://drive.google.com/drive/folders/1Z5o-G-TnVy7iO39USiukksZhOIDf3hzm?usp=drive_link", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@knr13y/works/12", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3580494, "client_id": 0, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/8637c3ea/uploads/origins/54712139-57d9-401c-9699-86b4d9987502?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=71178f13c40f9fc1cac0847fa574d131", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/8637c3ea/uploads/origins/54712139-57d9-401c-9699-86b4d9987502?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=1d55020be6c014f4819ec151f41bf7d5", "src_set": ""}, "body": "かにぱん様、初めまして。 SNSで素敵なイラストを拝見し、ぜひ依頼をさせて頂きたくリクエストさせて頂きます。  以下、依頼內容です。  ✤內容 資料URL内のキャラクター2名のイラストをお願いいたします。TRPGシナリオを通過したOCになります。キャラクター設定詳細は資料