無表情に「大丈夫か？」と聞く\nやや下がり眉で「すまない」と謝っている\n表情が変わらないまま「ありがとう」と感謝する\n首を傾げ「駄目か？」と様子を窺う\n【探索者B】\n「何してるんですか！？」と怒っている\n呆れたように「しょうがないですね」と溜息を吐く\nにこっとした笑顔で「で？」と脅しをかける\n得意げな顔で「そうでしょう」と笑っている\n\n【使用用途】\n友人との共有、アイコンへの使用、個人利用の印刷やグッズ（アクリルキーホルダーなど）、Googleドライブ内にて名前を記載したうえでの資料用\n\nhttps://drive.google.com/drive/folders/1gcAs_Zde9lMHZIfSDP6q2gznOHggvdbJ?usp=drive_link", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@knr13y/works/10", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/292fa92d/uploads/origins/9ab361b0-2b76-43ad-a5b4-5d4d23bbf88e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=7e57e2e87304097bf201949eaffb04f0", "src_set": ""}, "private": true, "genre": "art", "tipped": false, "creator_id": 3580494, "client_id": 0, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 145, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@knr13y/works/9", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3580494, "client_id": 0, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/907d758d/uploads/origins/11c6ac06-03e0-40dc-83b3-149f2d94cc56?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=71b3deef9ef65382776716926d2be127", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/907d758d/uploads/origins/11c6ac06-03e0-40dc-83b3-149f2d94cc56?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=81cf14a992cbe4e0718cae27e5e8c985", "src_set": ""}, "body": "🦀🍞様   \n\n初めまして!\n リクエスト失礼いたします(⁎ᴗ͈ˬᴗ͈⁎) \n以前から素敵なイラストを拝見しておりまして、 \n初めてのskeb依頼は絶対に🦀🍞様にお願いしたいと思っておりました!! \n🦀🍞様にしか出せない唯一無二の絵柄、お色選びから塗り