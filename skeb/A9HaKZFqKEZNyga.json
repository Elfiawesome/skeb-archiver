列挙しますので、\nそれ以外の部分は全てお任せします\n\n・サンバ衣装\n露出度高めに\n激しく踊ったら簡単にポロリしてしまう様な、\nむしろポロリ前提くらいの勢いでセクシーなデザインにして下さい\n\n細かい意匠や色合いはお任せします\n\n・長身\n現実ではギリギリあり得ない位の身長\nいわゆる巨女です\n2〜3mのイメージ\n\n・顔\n左目尻に泣きぼくろ\n鼻筋にそばかす\nぷっくりした唇\n詳細な顔立ちや肌色・髪型・髪色はお任せ\n\n・体\nむちむち豊満ボディ\nBBW・肥満に近いくらいの肉付きが好みです\nたく様の許容限界ギリギリまで盛って下さい！\n\n特に腹肉を重視して下さい\n段腹・マフィントップが大好物です！\n\nがっしり骨太で、脚もぶっとくお願いします\n\n茶〜黒くらいの濃い色で広い乳輪\n(サンバ衣装からはみ出させて下さい)\n\n胸の谷間や肩にかけてそばかす\n\n・キャラ設定\n経産婦\n明るく母性的で心優しい\nノリノリでサンバを踊れる、いわゆる「動けるデブ」", "nc": 176, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@A9HaKZFqKEZNyga/works/6", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/d8797ff5/uploads/origins/2c1f56fe-f4f7-42f1-adb7-354cda5ef3cb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=9798c247e535c678b54d11df294754b4", "src_set": ""}, "private": true, "genre": "art", "tipped": false, "creator_id": 2645106, "client_id": 0, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 33, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@A9HaKZFqKEZNyga/works/5", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/adf4d7a4/uploads/origins/4e056912-11fc-4bbe-9bd8-8fd5ef207a0b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=c68c806d6d1e82b725c6a0d4273d264d", "src_set": ""}, "private": true, "genre": "art", "tipped": false, "creator_id": 2645106, "client_id": 0, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 161, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@A9HaKZFqKEZNyga/works/4", "private