になって、具体的な構図は先生にお任せします。\nhttps://drive.google.com/drive/folders/1P7Rw_rg7viiFxIC-9RpOm8O_SSa9UGCb?usp=share_link\n\n服装は参考だけ添付しました。アレンジ、省略もご自由にどうぞ。\n\nもしご迷惑をお掛けたら、遠慮なくキャンセルしてください。 \n金額を変更して再送することも可能ですので、ご検討のほど宜しくお願いいたします！", "nc": 177, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@mayf00l/works/6", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/4879d887/uploads/origins/fe9a57b6-e3e5-4901-b4bf-befcae3726a1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=69d81747532a60a01febf9ad3218de76", "srcset": "https://si.imgix.net/4879d887/uploads/origins/fe9a57b6-e3e5-4901-b4bf-befcae3726a1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=69d81747532a60a01febf9ad3218de76, https://si.imgix.net/4879d887/uploads/origins/fe9a57b6-e3e5-4901-b4bf-befcae3726a1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=9f7925e8fa6e9c0b4d2da341007d9534 2x, https://si.imgix.net/4879d887/uploads/origins/fe9a57b6-e3e5-4901-b4bf-befcae3726a1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=6aee704651ccc3f727144673c57e985b 3x"}, "private": true, "genre": "comic", "tipped": false, "creator_id": 3288, "client_id": 721856, "nc": 177}, {"path": "/@mayf00l/works/5", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/0cd39dbb/uploads/origins/adda9e52-83cf-4b9a-a693-4506efef3cba?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=47efc17f2be09ccda8e94a10eec