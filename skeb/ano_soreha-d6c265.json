ads/origins/b700171f-5c4d-4233-9ed1-58edfd299120?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0f0976d0d3d3d6b9ededd90788e06ba6, https://si.imgix.net/389c181a/uploads/origins/b700171f-5c4d-4233-9ed1-58edfd299120?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=021fe684e1040fe2f817011a3bb5ab84 2x, https://si.imgix.net/389c181a/uploads/origins/b700171f-5c4d-4233-9ed1-58edfd299120?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=22a1d2ddb60d1f3b435a1f38885db2cf 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/389c181a/uploads/origins/b700171f-5c4d-4233-9ed1-58edfd299120?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d76c28c5c3300bfffaa182af6bc7a26e", "srcset": "https://si.imgix.net/389c181a/uploads/origins/b700171f-5c4d-4233-9ed1-58edfd299120?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d76c28c5c3300bfffaa182af6bc7a26e, https://si.imgix.net/389c181a/uploads/origins/b700171f-5c4d-4233-9ed1-58edfd299120?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=8e5f53ea4fd96bc9ee2bf775840f2cb5 2x, https://si.imgix.net/389c181a/uploads/origins/b700171f-5c4d-4233-9ed1-58edfd299120?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=f6e8e6bfeaa5b8ea4687affd9af54ee9 3x"}, "body": "とても好きな絵柄なので、リクエスト失礼します。\nシチュは（https://skeb.jp/@ano_soreha/works/1）の人妻さんがJK時代に小太りおっさん相手にパパ活をしているイメージです。\n\n服装\n・髪はセミロングくらい\n・ブレザー制服、リボンネクタイ、チェックスカート\n・下着は紫色、JKが穿いていそうなデザイン\n\n人妻さんは他の方のリクエストなので、NGという場合は以下のイメージで似た感じのJKちゃんをお願いします。\n・茶髪セミロング\n・美人系、メガネは無し\n・おっぱい大きめ（E～Fカップくらい）\n\n構図例\n・https://skeb.jp/@sekitan_mmmm/works/143\n\n内容\n・制服半脱ぎ着衣エッチ、背面座位でショーツずらし挿入中出し\n・ショーツは愛液や精液でぐちょぐちょ、結合部は溢れ出た精液でドロドロ\n・ブラジャーはずらされておっぱい丸見え、スカートはまくり上げ結合部が見えている\n・濃厚ベロチューを終えた後で、おっさんの口元と唾液ブリッジがかかっている。JKちゃんの口元は唾液でドロドロベトベト\n・顔は寝取らせのようなカメラ目線で、視線もこちら側に向けて気持ちよさそうな表情\n・シーツは染みだらけ。JKちゃんの学生証を任意の場所に置いて欲しいです\n・構図的に可能であれば、片方のおっぱいも揉んでほしいです\n\nその他\n・おっさんは簡素な描写で大丈夫です\n・差分が可能であれば、以下のものをご検討お願いします\n①基本構図からの差分で肉棒を抜いて中出し精液が溢れ出し垂れ流れるもの\n②ドロドロのショーツが脱がされ太もも付近に引っ掛かっているもの\n③舌を絡めあう唾液まみれ濃厚ベロチューの顔アップのカットイン\n\n細かくて申し訳ありませんが、ご検討いただければ幸いです。", "nc": 176, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@ano_soreha/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2752080, "client_id": 1646686, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/afccc7e5/uploads/origins/1affd688-8354-4db3-9b56-3568b51b128c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e4bf6a8f835f1ec05a78b3aecb413fff", "srcset": "https://si.imgix.net/afccc7e5/uploads/origins/1affd688-8354-4db3-9b56-3568b51b128c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e4bf6a8f835f1ec05a78b3aecb413fff, https://si.imgix.net/afccc7e5/uploads/origins/1affd688-8354-4db3-9b56-3568b51b128c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f210a3874f5adcd50289819aa95c6f7d 2x, https://si.imgix.net/afccc7e5/uploads/origins/1affd688-8354-4db3-9b56-3568b51b128c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=72f72fba7adc27f081bf5312b93ddb07 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/afccc7e5/uploads/origins/1affd688-8354-4db3-9b56-3568b51b128c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3a740e43234aee3b20eb1ac4f85fb887", "srcset": "https://si.imgix.net/afccc7e5/uploads/origins/1affd688-8354-4db3-9b56-3568b51b128c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3a740e43234aee3b20eb1ac4f85fb887, https://si.imgix.net/afccc7e5/uploads/origins/1affd688-8354-4db3-9b56-3568b51b128c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=9b37837c3d44800c2b227891190d3d40 2x, https://si.imgix.net/afccc7e5/uploads/origins/1affd688-8354-4db3-9b56-3568b51b128c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=1435881e4ec92f734f576f61060a0390 3x"}, "body": "はじめまして。リクエストさせて頂きます。\nアニメ版Anotherの赤沢さん(165cm)が恒一(168cm)と結ばれてラブラブエッチしているシーンを描いてください。\n体位や構図などはお任せします。必ずしも本番である必要はありません。前戯的なのも好きです。その場合は恒一が赤沢さんを愛撫する形でお願いします。\n差分として絶頂・絶頂後のシーンもお願いします。\n絵柄はなるべく公式に寄せて欲しいです。\n資料はURLをご参照ください。\nよろしくお願いします。\n\nhttps://t.co/4QcfIihAZD", "nc": 49, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@ano_soreha/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2752080, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/985c8c68/uploads/origins/097d638b-7907-49d4-a6cc-0c627eae4bdd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ab42f5ea7aeb1a5a915095e2a721c4af", "srcset": "https://si.imgix.net/985c8c68/uploads/origins/097d638b-7907-49d4-a6cc-0c627eae4bdd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ab42f5ea7aeb1a5a915095e2a721c4af, https://si.imgix.net/985c8c68/uploads/origins/097d638b-7907-49d4-a6cc-0c627eae4bdd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=dbf310b370fc72b994fe3b402c736fa6 2x, https://si.imgix.net/985c8c68/uploads/origins/097d638b-7907-49d4-a6cc-0c627eae4bdd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=65e82d0b1cb740986317ab0e5770098a 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/985c8c68/uploads/origins/097d638b-7907-49d4-a6cc-0c627eae4bdd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=833ac53b9f7987fa9cd98804f7b580f3", "srcset": "https://si.imgix.net/985c8c68/uploads/origins/097d638b-7907-49d4-a6cc-0c627eae4bdd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=833ac53b9f7987fa9cd98804f7b580f3, https://si.imgix.net/985c8c68/uploads/origins/097d638b-7907-49d4-a6cc-0c627eae4bdd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=298d615afa38974b3d39fe5e01a87cf8 2x, https://si.imgix.net/985c8c68/uploads/origins/097d638b-7907-49d4-a6cc-0c627eae4bdd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=8ed8026cad30473298681b5cce844f3f 3x"}, "body": "初めまして。\n\nオリジナルキャラで、昔の農家の18歳位\n黒髪少女の緊縛イラストをリクエストしたいです。\n顔だち、髪型はお任せします。\n\n恰好\n野良着、もんぺ、足袋履きで、\n胸をだしてM字開脚縛りされています。\n表情は縛られて、涙ぐんでいる感じにしてほしいです。\n頭から爪先まで全身を、真正面からの構図を避けて描いてほしいです。\n\n服装\n野良着の色、模様は適当に、もんぺはウエストを紐で結ぶ袴式、色、模様は濃い紫系の縞、\n足袋は赤、足袋底は白にしてほしいです。\nもんぺイメージ\nhttps://www.dropbox.com/s/27dregu6fv4xgh3/ms.jpg?dl=0\n\n差分で、\n股間部分を、破られ、陰部に極太ディルドが挿入されて\n表情も苦しそうに目を閉じて泣き叫んでる状態もお願いします。\n\nつたない説明で恐縮ですが、説明不足な点、ポーズ、構図など\nアレンジしていただいて構いませんが、\n必ず、もんぺが破れていない状態と、破れた状態の2種を描いていただきたいです。\n\n以上ご検討の程宜しくお願い致します。\n\nhttps://www.dropbox.com/s/shhirdcz5xps18w/sm01.png?dl=0", "nc": 56, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@ano_soreha/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2752080, "client_id": 639089, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/3eeae7b6/uploads/origins/3889b20f-e600-476e-87fa-dc743d0f2e5b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=33182556c2db44709c06ccae1b41a171", "srcset": "https://si.imgix.net/3eeae7b6/uploads/origins/3889b20f-e600-476e-87fa-dc743d0f2e5b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=33182556c2db44709c06ccae1b41a171, https://si.imgix.net/3eeae7b6/uploads/origins/3889b20f-e600-476e-87fa-dc743d0f2e5b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=3e2011b8d3f5bd