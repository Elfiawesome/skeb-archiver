1/uploads/origins/d51f7be1-1063-4581-bee8-e1caff17d412?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c30020b108a0cfd21b343979fcbbcae3, https://si.imgix.net/8ca78a81/uploads/origins/d51f7be1-1063-4581-bee8-e1caff17d412?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=cca6ff4cee4336844b55371fb766b4ba 2x, https://si.imgix.net/8ca78a81/uploads/origins/d51f7be1-1063-4581-bee8-e1caff17d412?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=3957e5324a0104c4afc83b5b19aa6df9 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/8ca78a81/uploads/origins/d51f7be1-1063-4581-bee8-e1caff17d412?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=36da19124b74c1225eb32c542dab708b", "srcset": "https://si.imgix.net/8ca78a81/uploads/origins/d51f7be1-1063-4581-bee8-e1caff17d412?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=36da19124b74c1225eb32c542dab708b, https://si.imgix.net/8ca78a81/uploads/origins/d51f7be1-1063-4581-bee8-e1caff17d412?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=9c40de0574e08e6289aead5c81b21264 2x, https://si.imgix.net/8ca78a81/uploads/origins/d51f7be1-1063-4581-bee8-e1caff17d412?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=e6989c8f7b57451ca9ed076c5648b45c 3x"}, "body": "なめたけこ様\n\nはじめまして、個人Vtuberの神凪てと と申します。\nなめたけこ様の描く可愛らしいイラストがとっても素敵で、\n是非自身を描いていただきたくリクエストさせていただきました！\n\n【依頼内容】\n・シチュエーションボイス用、神凪てと一枚絵\n台本・三面図▶https://drive.google.com/drive/folders/14HBXdfD2AZQqpbrDTdhnhTgbBI8FMmA_?usp=drive_link\n⇒台本内、「切ってしまった指を確かめるシーン」でお願いします。\nリビングにぺたんこ座り、相手の手を持ち見上げる構図のイメージです。\n※なるべくキャラクターの全身が写ると嬉しいです！\n※ボイスはBOOTHで販売予定・差分を頂いた場合は、購入特典に使用させていただきます…！\n\n【キャラクター】\n▼リットリンク▼\nhttps://lit.link/kannagiteto\n▼シチュエーションボイス投稿用Youtube▼\nhttps://youtube.com/@tetokannagi \n\n▽髪型▽\n三面図の髪型(白髪ロング、サイドに三つ編み・赤いメッシュあり)\n\n▽衣装▽\n慌てて駆け寄ったため、着崩れた雰囲気のゆるい部屋着＋エプロン\n\n▽表情▽\n慌てたような表情\n★手を握って嬉しそうな表情を可能であれば差分としていただきたいです…！\n　難しければお捨て置きください。\n\n【納品形式】\n解像度350dpi以上・4K(横長)以上・PSD形式\n※可能な範囲で大き目のサイズ感だと助かります…！\n\n【使用用途】\n・Vtuber活動全般\n⇒SNSでの投稿・収益化しているYouTubeサムネ・配信・その他\n・シチュエーションボイスの販売時に、こちらのイラストを使用したグッズを作成したいのですが、難しいでしょうか…？\n　NGであれば再送要請/別レイヤーで指示をいただけますと幸いです…！\n\n【備考】\n頭部や髪などが切れていない人物の背景透過データ(PSD)をいただけますと大変助かります！\n\n以上となります！ぜひご検討いただけましたら幸いです！\nまた、これからもなめたけこ様の作品楽しみにしております！", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@na_mtk5/works/8", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3333850, "client_id": 3284582, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/378d7553/uploads/origins/429d1865-1d33-4623-a5a9-7346bf2338d8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=acbd6bc56080a317458c337d0882ede8", "srcset": "https://si.imgix.net/378d7553/uploads/origins/429d1865-1d33-4623-a5a9-7346bf2338d8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=acbd6bc56080a317458c337d0882ede8, https://si.imgix.net/378d7553/uploads/origins/429d1865-1d33-4623-a5a9-7346bf2338d8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=74ff04395a80085e7119749f3068ebe0 2x, https://si.imgix.net/378d7553/uploads/origins/429d1865-1d33-4623-a5a9-7346bf2338d8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=7f823286f48116c8dc7d707e5254d9af 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/378d7553/uploads/origins/429d1865-1d33-4623-a5a9-7346bf2338d8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3edb62cef61be90d59e42ade0bb2b19f", "srcset": "https://si.imgix.net/378d7553/uploads/origins/429d1865-1d33-4623-a5a9-7346bf2338d8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3edb62cef61be90d59e42ade0bb2b19f, https://si.imgix.net/378d7553/uploads/origins/429d1865-1d33-4623-a5a9-7346bf2338d8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=dbefeb1906dbe8e35e487d2487ac2c4e 2x, https://si.imgix.net/378d7553/uploads/origins/429d1865-1d33-4623-a5a9-7346bf2338d8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=9b01b9255a066e2ada0757345db9eee9 3x"}, "body": "なめたけこ様！初めまして、Yama Hiroと申します！\n\nTLで見かけた先生の素敵なイラストの数々に凄く惹かれました。\nホロメンの眩しい笑顔がとても印象に残り、特にみこちのはにかんだ笑顔やアイスを食べ、ぺろっとしてる元気で無邪気な感じが凄く大好きです！\n\nそんな素敵なイラストを描かれる先生にどうしても依頼をお願いしたく、この度ご連絡させていただきました。\n\nこの度描いていただきたのは私が今推しているVTuber、向日葵とオレンジカラーがイメージの元気印、『夏橘つばめ』さんのイラストをお願いしたいと思っております。\n\nHP、三面図\n\nhttps://x.com/spv_tsubame_/status/1811970424747753614?s=46\n\n1周年新衣装\n\nhttps://x.com/spv_tsubame_/status/1838493631583572018?s=46\n\n構図、衣装、サイズ\n\n衣装は1周年記念の新衣装を描いていただきたいです。\n\nもしくは先生の描きたいコーディネートでも嬉しいのでお任せしたいと思います。\n(私服みこめっとや制服が凄く可愛かったです)\n\n構図は先生が以前描かれてましたどのイラストも雰囲気がとても素敵でしたのでお任せしたいと思います。\n\nその他・差分・サイズ\n\n可能でしたら元気いっぱいの表情とイタズラ好きな感じの表情差分などもいただけると嬉しく思います。\n\nサイズに関しましては\n可能でしたら、配信やXのポストで使用しやすい様に頭部および腕が見切れない構図ですと非常にありがたく思います。\n\n多くのお願いをしましたが先生の筆の思うがままに描いていただけたらと思います。\n\n使用用途は\n\n本人様へのプレゼントと個人利用\nご本人に限りの配信活動(配信内や、配信のサムネ、X(旧Twitter)等で使用する可能性があります※YouTube収益化済み)での使用許諾をいただきたいです。\n\n納品データは描かれたご本人が使用できるよう、人物・背景・文字等が分かれたＰＮＧファイルで頂けますと幸いです。\n\n\nたくさんの要望ばかりで大変申し訳ありません。\n長文となりましたが、ご検討のほどよろしくお願いいたします。", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@na_mtk5/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3333850, "client_id": 1374366, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/1541ea18/uploads/origins/d3ec914a-c941-457c-ac43-de59b04cdade?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1721d75b82c236e2af4386ec46860393", "srcset": "https://si.imgix.net/1541ea18/upl