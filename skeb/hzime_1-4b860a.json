。その行為が夫であるハナに発覚し、ヴィクターに対する度重なる家庭内暴力に発展する。ハナはヴィクターの裏切りに激怒しながらも、まだ彼女を深く愛しているため離婚するつもりはなく、暴力によってヴィクターを屈服させようと決意する。同様に、ビクターは年に一度、特定の時期を選んでハナを刺そうとするが、それは憎しみからではなく、ハナがまだ自分を愛しているかどうかを試すためである。この極端な相互作用は、二人の関係におけるねじれた避けられないサイクルとなる。\n\n期待\n先生の描く絵の雰囲気がとても好きです。だから創作の内容も、先生が自由にしてくだされば大丈夫です。\n\n\n用途\n個人的に見る。\n\n参考ファイルリンク\nhttps://drive.google.com/drive/folders/11lMoJHltmUOxY22QIJE0ndSUxTAKcJNS?usp=drive_link\n\nhttps://drive.google.com/drive/folders/11lMoJHltmUOxY22QIJE0ndSUxTAKcJNS?usp=drive_link", "nc": 152, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@hzime_1/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1429736, "client_id": 1656598, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/547974b2/uploads/origins/e0e3638e-e244-4d6b-b509-0368c84d32da?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5fdd9f79253b6075060e6a41ed93b771", "srcset": "https://si.imgix.net/547974b2/uploads/origins/e0e3638e-e244-4d6b-b509-0368c84d32da?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5fdd9f79253b6075060e6a41ed93b771, https://si.imgix.net/547974b2/uploads/origins/e0e3638e-e244-4d6b-b509-0368c84d32da?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=77b106e40f69cc379cd162eeefb5ca4c 2x, https://si.imgix.net/547974b2/uploads/origins/e0e3638e-e244-4d6b-b509-0368c84d32da?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c427fa0fa9bdac09ee61278e1ea9948b 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/547974b2/uploads/origins/e0e3638e-e244-4d6b-b509-0368c84d32da?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=894d4922dac4a8ff931fe80b8ee07606", "srcset": "https://si.imgix.net/547974b2/uploads/origins/e0e3638e-e244-4d6b-b509-0368c84d32da?bg=%23fff&auto=format%2C