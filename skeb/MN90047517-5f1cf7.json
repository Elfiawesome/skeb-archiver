\n彼女には自信に満ちた、あるいは媚びたような表情をしてほしい。可能であれば、ヌードのバリエーションを見たいです。ポーズは先生の好みにお任せします。\n\nご自由に描いてください。先生にとってかっこいいシーンであればうれしいです。\n\nご検討よろしくお願いします。\n\nhttps://drive.google.com/drive/folders/1LUJ26pW96iTvWvY3kWxSPn5rqCq_vNWi", "nc": 33, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@MN90047517/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3823847, "client_id": 3883895, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/00f4c024/uploads/origins/e4070832-4e07-4cec-9090-3f85f82061a9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=510a3ddb06314e798bfbb3bad3f73ca3", "srcset": "https://si.imgix.net/00f4c024/uploads/origins/e4070832-4e07-4cec-9090-3f85f82061a9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=510a3ddb06314e798bfbb3bad3f73ca3, https://si.imgix.net/00f4c024/uploads/origins/e4070832-4e07-4cec-9090-3f85f82061a9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=8a571030aca703a55e3458d2c2778c30 2x, https://si.imgix.net/00f4c024/uploads/origins/e4070832-4e07-4cec-9090-3f85f82061a9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=7466575d17c14534ba5453f68ad19064 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/00f4c024/uploads/origins/e4070832-4e07-4cec-9090-3f85f82061a9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e180cca608f1e7c4a2701441cceda755", "srcset": "https://si.imgix.net/00f4c024/uploads/origins/e4070832-4e07-4cec-9090-3f85f82061a9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e180cca608f1e7c4a2701441cceda755, https://si.imgix.net/00f4c024/uploads/origins/e4070832-4e07-4cec-9090-3f85f82061a9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=db8d24ce9a67f7