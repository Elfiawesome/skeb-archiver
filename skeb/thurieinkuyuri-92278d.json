rigins/a2e8b3b0-631d-46f3-a5e7-f7ab26e025db?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c13ee60e4be052609ef0feabdedac8cd", "srcset": "https://si.imgix.net/ba19ae61/uploads/origins/a2e8b3b0-631d-46f3-a5e7-f7ab26e025db?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c13ee60e4be052609ef0feabdedac8cd, https://si.imgix.net/ba19ae61/uploads/origins/a2e8b3b0-631d-46f3-a5e7-f7ab26e025db?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=7bd85ed2d2abfdf822c49f419f9cb1ab 2x, https://si.imgix.net/ba19ae61/uploads/origins/a2e8b3b0-631d-46f3-a5e7-f7ab26e025db?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a1121851a782cfcbf883f8a74d11cf47 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/ba19ae61/uploads/origins/a2e8b3b0-631d-46f3-a5e7-f7ab26e025db?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=cdc8ce65bc0b0dbea26d4b5da254249d", "srcset": "https://si.imgix.net/ba19ae61/uploads/origins/a2e8b3b0-631d-46f3-a5e7-f7ab26e025db?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=cdc8ce65bc0b0dbea26d4b5da254249d, https://si.imgix.net/ba19ae61/uploads/origins/a2e8b3b0-631d-46f3-a5e7-f7ab26e025db?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=8326d5bdeb41d03801c5d0c68f33d7fd 2x, https://si.imgix.net/ba19ae61/uploads/origins/a2e8b3b0-631d-46f3-a5e7-f7ab26e025db?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=ad12f17829592d87ec47cd6c6c980da5 3x"}, "body": "トゥリちゃんさん！あ谷です。\nかねてよりご依頼させていただきたいと思っておりました。\n\n今回はねことかげを描いていただきたいです。\n\nねことかげにまつわる詩を添付させていただきますので、世界観やねことかげ像の補完に活用いただければと思います。\n\n雨が降る日は傘を忘れずに\nだいすきなあなた\nどうか雨に濡れないで\n雨が降る日は傘を忘れずに\n\nあたしにさしてくれた傘\nきっとまたあいつにさしてるんでしょう\nあなたの肩だけが濡れてる相合傘\nあたしはそれがちっとも気に食わない\n\nあたしの肩、濡らすのに\nあたしの傘は跳ね除けたあなた\nあなたの肩、濡れてるのに\nあなたはそれが好きなのね\n\n今でもきっと\n傘忘れちゃったって\nあなたがこまってたら、\n\nだいきらいなあなた\n雨が降る日は傘を忘れずに\n\nつたない詩ですが、少しでもイラストを描く上での参考になれば幸いです。\nトゥリちゃんさんの世界観が大好きなので、トゥリちゃんさん味全開で自由に描いていただければと思います。\n\nよろしくお願いいたします！\n\nhttps://x.com/c_b_a_tani/status/1692564436559806617?s=46", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@thurieinkuyuri/works/8", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1997991, "client_id": 2914672, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/9c9a2f49/uploads/origins/54bd65e2-641f-47ed-8739-6a50cbcd9316?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d383802cfe129a8accfbc5fd5c8203e9", "srcset": "https://si.imgix.net/9c9a2f49/uploads/origins/54bd65e2-641f-47ed-8739-6a50cbcd9316?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d383802cfe129a8accfbc5fd5c8203e9, https://si.imgix.net/9c9a2f49/uploads/origins/54bd65e2-641f-47ed-8739-6a50cbcd9316?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=1e6fac31784fcd459e3c8deec5336041 2x, https://si.imgix.net/9c9a2f49/uploads/origins/54bd65e2-641f-47ed-8739-6a50cbcd9316?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ec100f8b96b8fd103d5f80f97b68f0e3 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/9c9a2f49/uploads/origins/54bd65e2-641f-47ed-8739-6a50cbcd9316?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=594924dad890e9883b887955cf35d329", "srcset": "https://si.imgix.net/9c9a2f49/uploads/origins/54bd65e2-641f-47ed-8739-6a50cbcd9316?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=594924dad890e9883b887955cf35d329, https://si.imgix.net/9c9a2f49/uploads/origins/54bd65e2-641f-47ed-8739-6a50cbcd9316?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&