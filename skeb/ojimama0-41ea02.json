ます。\nサギはスナック菓子通で、甘いものが大好きです。左目の下に小さなピンクのハートがあります。後ろ髪はツインテールではなく、完全に覆われていて、お団子から飴がぶら下がっています。\n\nカリオペに似た友達(ポーズ: https://prnt.sc/eli-7Al_lsAL)。\nティホはグミホ（九尾の狐）の月下美人である。犬歯が2本あることと、ピンクの狐耳、瞳にハートと月の瞳孔があることに注目してください。また、大きなオッパイを持たせてください。\n\n服装は2人とも激しいものにしてください（あなたがデザインしてもいいですが、そうでない場合は参考資料と同じようなものにしてください）。\n\nありがとうございました。\n\nhttps://drive.google.com/drive/folders/1x2vJPRZqiDqaPp9A1_nuvQDzUJczJYy7?usp=sharing", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@ojimama0/works/9", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1983275, "client_id": 1380698, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/641d37de/uploads/origins/3456e5fd-068b-47c9-bc7b-d92397cff4ff?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7f7bb482e151fd97446efd3f839d3013", "srcset": "https://si.imgix.net/641d37de/uploads/origins/3456e5fd-068b-47c9-bc7b-d92397cff4ff?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7f7bb482e151fd97446efd3f839d3013, https://si.imgix.net/641d37de/uploads/origins/3456e5fd-068b-47c9-bc7b-d92397cff4ff?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=8638d3ad5689be05e7d6abe442d25ea8 2x, https://si.imgix.net/641d37de/uploads/origins/3456e5fd-068b-47c9-bc7b-d92397cff4ff?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=4efbc2d6f2a53be9db02ffd7ece43b29 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/641d37de/uploads/origins/3456e5fd-068b-47c9-bc7b-d92397cff4ff?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=fce1cd4145ede8e4325e32d66c619333", "srcset": "https://si.imgix.net/641d37de/uploads/origins/3456e5fd-068b-47c9-bc7b-d92397cff4ff?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=fce1cd4145ede8e4325e32d66c61