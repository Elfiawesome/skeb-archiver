rop&crop=top&w=200&h=200&s=b033dbd7fbd542cdbb02c43bf5348d3a, https://si.imgix.net/7a8a635a/uploads/origins/72f9e3da-dae2-444e-9390-1b19a1b3e07f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=8b3e95e023c15649aa853b554e88493d 2x, https://si.imgix.net/7a8a635a/uploads/origins/72f9e3da-dae2-444e-9390-1b19a1b3e07f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=eadcbaef004d85e29c40c68d8282718b 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/7a8a635a/uploads/origins/72f9e3da-dae2-444e-9390-1b19a1b3e07f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=40d129197fb8924ed257a193346cc8e5", "srcset": "https://si.imgix.net/7a8a635a/uploads/origins/72f9e3da-dae2-444e-9390-1b19a1b3e07f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=40d129197fb8924ed257a193346cc8e5, https://si.imgix.net/7a8a635a/uploads/origins/72f9e3da-dae2-444e-9390-1b19a1b3e07f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=de99c421466606f8d772732a1b2e40ef 2x, https://si.imgix.net/7a8a635a/uploads/origins/72f9e3da-dae2-444e-9390-1b19a1b3e07f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=50f2337ac33d27535fc20d768abee2b3 3x"}, "body": "じょにぃさんこんばんは\n先日は添い寝で癒しの極致な雰囲気の伊良湖さんを描いて下さり有難う御座いました\n今回は、同じく艦これから妙高さん（改二）のイラストを、下記のような内容でお願いできませんか\n\n【衣装】【構図】\nhttps://thup.work/miniup/?mode=dl&id=20850　に黒ニーソをプラスして描いて頂きたいです\nこの中からリボンは除いてくださって結構です\n場所は鎮守府の執務室みたいなところを想定しています\n\n【セリフ】\n「騙していたわけではないのですが、候補生さんが私にもっていたイメージを壊してしまいましたか？」\n\n伊良湖さんのイラストでアレンジも安心してお任せできますので、必要だと思われた部分はお任せいたします\nまたじょにぃさんに描いて頂けるのをとても楽しみにしております\nどうぞよろしくお願いいたします", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@kitagawajo/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator