.imgix.net/246eb542/uploads/origins/8819fdf9-55ec-4702-a15b-51a00253b7b2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d2c101ff2210f2df0a01aa46c8753566 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/246eb542/uploads/origins/8819fdf9-55ec-4702-a15b-51a00253b7b2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b55c30929e80aa7f3e9f1bce5c2e6857", "srcset": "https://si.imgix.net/246eb542/uploads/origins/8819fdf9-55ec-4702-a15b-51a00253b7b2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b55c30929e80aa7f3e9f1bce5c2e6857, https://si.imgix.net/246eb542/uploads/origins/8819fdf9-55ec-4702-a15b-51a00253b7b2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=31e00665f7c64587df65a66c0a09219a 2x, https://si.imgix.net/246eb542/uploads/origins/8819fdf9-55ec-4702-a15b-51a00253b7b2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=b0f3bf89a764abf4551ebeda1ac604f5 3x"}, "body": "おとなりさま \n はじめまして、個人Vtuberとして活動しております黒井黒と申します。\n Xにてイラストを拝見し、おとなりさまの絵柄がとても素敵でこの絵柄での自分自身を見てみたい！！と思ったためリクエストさせていただきます。\n \n・描写内容 \n黒井黒(三面図を資料として載せておきます。)を使用した一枚絵。イメージカラーは黒と山吹色。モチーフは脱走犯。目のハイライトの形、髪型(ウルフカット)が同じであれば服装等は好きにしていただいて大丈夫です。\nできれば人物イラストと背景が分けられた形のデータもいただけると幸いです。\n\n・使用用途\nSNSへの投稿\n配信サムネイルへの使用\n配信の投げ銭に対する返礼品への使用\n\n金額や内容に不備・不足がありましたら、差し戻してください。\nお忙しい中読んでいただきありがとうございました。\nよろしくお願いします。\n\nhttps://drive.google.com/file/d/1k3ifC6zw5uB8eGNEjl-rwfVyF0kWpkKQ/view?usp=drivesdk", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@otonarisan_e/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 4074320, "client_id": 3809760, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/6bb36f51/uploads/origins/3c571a21-fe0b-4f3e-8967-189fbb788ce7?bg=%23ff