9Z7XmtEhHFJbEG1xS9diSWDbxI4GymzI?usp=drive_link", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@TORI_NO_s/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2460482, "client_id": 1319009, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/cf2293e9/uploads/origins/3d167522-982d-43c4-83e1-aa59409d3f31?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=969c7bdcc2555cab3a7999f526f632b4", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/cf2293e9/uploads/origins/3d167522-982d-43c4-83e1-aa59409d3f31?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=957aadba6f0546add5bea771252c2c63", "src_set": ""}, "body": "こんにちは！私のオリジナルキャラクターのアートワークを依頼したいのですが、彼女は内気で優しい小さな魔女です。構図は自由に決めてください。下のリンクに参考画像があります。お忙しい中、ありがとうございました。\n\nhttps://drive.google.com/drive/folders/12ebI2hNvpnL30UYylAWUE37H-U5BvegB", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@TORI_NO_s/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2460482, "client_id": 2407098, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/382b0bed/uploads/origins/369f1998-7aeb-472b-bf43-1f23de63b0f6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d03fdb14bdc60d5fe0968f79db6a4a5a", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/382b0bed/uploads/origins/369f1998-7aeb-472b-bf43-1f23de63b0f6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0b5f79b4d3ebe1d97216c9745ff8e73c", "src_set": ""}, "body": "酉野蛙­­先生こんにちは、お忙しいところお邪魔した。\n宜しければうちのオリジナルキャラクターのイラストを依頼したい。\n彼の服、表情、ポーズ要望ないのでどうかご自由に描いてください、よろしくお願い致します