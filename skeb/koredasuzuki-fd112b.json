f8f2/uploads/origins/b675123c-15a4-4109-b729-30088f3dc7cc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=09a81672d23229862be5fd5d4822f1cb", "srcset": "https://si.imgix.net/713cf8f2/uploads/origins/b675123c-15a4-4109-b729-30088f3dc7cc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=09a81672d23229862be5fd5d4822f1cb, https://si.imgix.net/713cf8f2/uploads/origins/b675123c-15a4-4109-b729-30088f3dc7cc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=9af11ebea5180f96fc9878fca300aa77 2x, https://si.imgix.net/713cf8f2/uploads/origins/b675123c-15a4-4109-b729-30088f3dc7cc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=63976fd55876011677161b87ba52e441 3x"}, "body": "はじめまして。いつもXで素敵なイラストを拝見しております。\n今回リクエストしたい内容は以下の通りです。\n\nキャラ\n池袋晶葉(アイドルマスターシンデレラガールズ)\n陽炎(艦隊これくしょん　艦これ)\nリドリー・ティンバーレイク(ラジアータストーリーズ)\n参考資料\nhttps://www.dropbox.com/scl/fo/22gt4qkn44h05tzk65cx2/h?rlkey=k7pagmk07sbl3faye7no1428e&dl=0\n\n内容：3人が描かれたイラスト。3人が1枚に収まっていればどんな構図、ポーズでも構いません。\n（それぞれ頭から足まで全身描いていただけたら嬉しいです）\n\n髪型：全員デフォルトのツインテールでお願いします。\n\n服装\n晶葉：セーラー服に白衣でお願いします。\n陽炎：資料をご参照ください。ノーマルと改二で手袋などの差異がありますが、描きやすい方をお選び下さい。\nリドリー：資料をご参照ください。模様などの細かい部分は簡略化していただいて構いません。\n\n武器や艤装は有り無しどちらでも構いません。\n\n上記以外の事柄は全てお任せいたします。描きやすいよう描いていただけたらと思います。\n3キャラなうえに注文も多く申し訳ありませんが、何卒よろしくお願いいたします。", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@koredasuzuki/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 235583, "client_id": 137361, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/71567476/uploads/origins/253fabcc-f589-4c44-9055-564290663941?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=dcaaecad991d611c939272b310d961f6", "srcset": "https://si.imgix.net/71567476/uploads/origins/253fabcc-f589-4c44-9055-564290663941?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=dcaaecad991d611c939272b310d961f6, https://si.imgix.net/71567476/uploads/origins/253fabcc-f589-4c44-9055-564290663941?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b8fa24cb81e6bea80f5b3abeaa7fc771 2x, https://si.imgix.net/71567476/uploads/origins/253fabcc-f589-4c44-9055-564290663941?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=1ccd910411ac55bf67a27eef48dce42d 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/71567476/uploads/origins/253fabcc-f589-4c44-9055-564290663941?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ba94ff06f913eba2a6e43a6c4ea1e634", "srcset": "https://si.imgix.net/71567476/uploads/origins/253fabcc-f589-4c44-9055-564290663941?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ba94ff06f913eba2a6e43a6c4ea1e634, https://si.imgix.net/71567476/uploads/origins/253fabcc-f589-4c44-9055-564290663941?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=db2e622a2063e95460423953da86f64f 2x, https://si.imgix.net/71567476/uploads/origins/253fabcc-f589-4c44-9055-564290663941?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=21feaee7b3bfbfb5c670fb39d5af1ee2 3x"}, "body": "シンデレラガールズより池袋晶葉ちゃんをお願いいたします。\nモバマスの方にだけある[ﾒｶﾒｶﾎﾘｯｸ]が晶葉ちゃんの衣装で一番好きなのですが、\nこの衣装の特訓後を元にバージョンアップした衣装がデレステに実装された……という設定で描いていただけないでしょうか。\n\n難しければ最低限、ﾒｶﾒｶﾎﾘｯｸ特訓後衣装と、ウサ耳カチューシャを付けた晶葉ちゃんをお願いいたします。\n構図・ポーズ指定については衣装がどちらであってもお任せとなります。\n\n色々な方に同じテーマで描いていただきたく、他にも依頼を出す予定でおりますのでその点悪しからずご了承ください。\nお手数ですがご検討よろしくお願いいたします。\n\n■詳細\n1.衣装\n概要の通り[ﾒｶﾒｶﾎﾘｯｸ]の特訓後をベースにしたもの\n当方語彙力がなく、サイバー要素・電脳感のある衣装……としか表現できないのですが、その方向性で自由に要素を補足・改変していただければ助かります。\nサイバー要素・電脳感を出す衣装案がございましたら、ベース衣装から逸脱してもそちらを採用していただいて構いません。\n（もし金額が不足する場合は条件付き再送要請をいただければと思います）\nﾒｶﾒｶﾎﾘｯｸ特訓後衣装：https://imas.gamedbs.jp/cg/idol/detail/20?h=83c386a28d4ea6cc5b266fb95e6ccbe0\n\n2.追加してほしい要素：ヘッドホン＋ヘッドホンのバンドと一体化した大きな耳\nﾒｶﾒｶﾎﾘｯｸ特訓後は既にヘッドホンを付けておりますが、このヘッドホンのバンド部分に大きな耳を付けていただきたいです。\nイメージとしては[ﾑｰﾝﾗｲﾄﾊﾞﾆｰ]特訓後のウサ耳カチューシャではありますが、より詳しく言うと「遠くの音を聞くための何か」という要素が近い物となります。\nベース衣装も異なりますしウサ耳には限らず、例えばウサちゃんロボの耳などでもOKですし別の何かでも構いません。\n参考_ヘッドホンと一体化した猫耳：https://imassc.gamedbs.jp/chara/show/18/344\n\nその他、念のため当方の考えるサイバーっぽいな、というイラストを以下に提示いたします。\n(こちらは特に参照されなくても構いません)\n\nよろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/1W3pFRtjpHQytVBsc4NJpsGuMSj9Ag5v2", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@koredasuzuki/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 235583, "client_id": 3109586, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/ec84a2d9/uploads/origins/83cef4df-46d2-4f50-b38e-05f8feea621f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=28e73b96ea4ffe227da698d690df4f6c", "srcset": "https://si.imgix.net/ec84a2d9/uploads/origins/83cef4df-46d2-4f50-b38e-05f8feea621f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=28e73b96ea4ffe227da698d690df4f6c, https://si.imgix.net/ec84a2d9/uploads/origins/83cef4df-46d2-4f50-b38e-05f8feea621f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=0df0452e42e633023fd5c9e333e0ec95 2x, https://si.imgix.net/ec84a2d9/uploads/origins/83cef4df-46d2-4f50-b38e-05f8feea621f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=90014f67e2d0f35eda1eca6bf488cb0c 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/ec84a2d9/uploads/origins/83cef4df-46d2-4f50-b38e-05f8feea621f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d8d81bd692575e655b2b73295a72d3b8", "srcset": "https://si.imgix.net/ec84a2d9/uploads/origins/83cef4df-46d2-4f50-b38e-05f8feea621f?bg=%23fff&auto=format%2Ccomp