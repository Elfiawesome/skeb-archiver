": true, "yearly_report_client_visible": false, "total_appeals_count": 0, "received_works": [{"path": "/@a1um999/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3658578, "client_id": 507423, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/9ef90884/uploads/origins/169d8c6c-ba59-487b-8430-090404ccd5b4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e7a65e472eb2d4a49984ed5693828798", "srcset": "https://si.imgix.net/9ef90884/uploads/origins/169d8c6c-ba59-487b-8430-090404ccd5b4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e7a65e472eb2d4a49984ed5693828798, https://si.imgix.net/9ef90884/uploads/origins/169d8c6c-ba59-487b-8430-090404ccd5b4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=2478e6a3de64852a5528893e548aae73 2x, https://si.imgix.net/9ef90884/uploads/origins/169d8c6c-ba59-487b-8430-090404ccd5b4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e15002f07837dd033f4f75a72afb422e 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/9ef90884/uploads/origins/169d8c6c-ba59-487b-8430-090404ccd5b4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6df710d01b6e33b66aa0b10ea8764001", "srcset": "https://si.imgix.net/9ef90884/uploads/origins/169d8c6c-ba59-487b-8430-090404ccd5b4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6df710d01b6e33b66aa0b10ea8764001, https://si.imgix.net/9ef90884/uploads/origins/169d8c6c-ba59-487b-8430-090404ccd5b4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=1b52f4d53e6148a67784a6966d5bf07b 2x, https://si.imgix.net/9ef90884/uploads/origins/169d8c6c-ba59-487b-8430-090404ccd5b4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=71f388cb2057983d6740c05602910b79 3x"}, "body": "A1um様\nはじめまして。A1um様の絵柄が気に入りましたので、依頼を送らせていただきます。\n犬耳、尻尾の巫女の女の子が種子島(鉄砲)で射撃姿勢を取っている、もしくは射撃している絵を描いていただけないでしょうか。\n\n詳細\n犬種　柴犬、秋田犬、北海道犬、甲斐犬、紀州犬、四国犬の中からお願いします。\n髪、瞳の色　上記で選んだ犬種を基準にお願いします。(髪型と長さは任せます)\n射撃姿勢　立ち射ち、膝射ち、座り射ち、寝射ちの中からお願いします。指を引き金にかけて、今にも射撃をしそうな状況、あるいは射撃している状況をお願いします。\n種子島　一般的な大きさである小筒のほか、大型である中筒、士筒のどれを使っていても構いません。\n巫女装束　巫女装束は丈が短かったり肩に切れ込みがある創作特有のものではなく、正規の物をお願いします。また、損傷していても構いません。\n表情　恐怖で怯えている以外でしたら好きに描写して構いません。(例　落ち着いた感じで淡々としている、不敵な笑みを浮かべている、穏やかに微笑んでいる、戦闘狂染みている、自我を失っている等)\n胸部　貧から爆までの範囲でお任せします。\nその他　早合「http://www.xn--u9j370humdba539qcybpym.jp/part1/archives/35」、「https://www.meihaku.jp/arquebus-basic/matchlock-launchmethod/」を首から下げている。(または袈裟懸けで下げている)\n負傷描写等　一切なくても構いませんし、軽傷または重傷でありながらも堪えている、ないしはものともしないような描写でも構いません。また、土や泥の汚れについても任せます。\n巫女装束が損傷していても構いませんが、下着等が露出することがないようにお願いします。\n場所　委任しますが、宇宙空間等のSF要素を感じさせるものは却下でお願いします。\nセリフ等差分\n内容等に合うものを委任します。\n\nA1um様の発想に頼るところが大きいですが、何卒よろしくお願いします。", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}], "sent_works": [], "similar_creators": [{"id": 497613, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "蒼ウサギ♂", "screen_name": "AoUSA0328", "avatar_url": "https://pbs.twimg.com/profile_images/1582803535041015808/NNPFujB-.jpg", "header_url": "https://pbs.twimg.com/profile_banners/752154761407795200/1666204745/1500x500", "appeal_receivable": false, "popular_creator_rank": 10, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 4, "complete_expiration_days": 50, "skills": [{"genre": "art"}], "nc": 160}, {"id": 506297, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "わごむ", "screen_name": "wagomu2", "avatar_url": "https://pbs.twimg.com/profile_images/1796926644118224896/wO1-I1ei.jpg", "header_url": "https://pbs.twimg.com/profile_banners/157882976/1717255075/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": nul