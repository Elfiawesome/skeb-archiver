: true}, {"path": "/@koume_shirakawa/works/9", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2484411, "client_id": 3174060, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/30384601/uploads/origins/1274a038-6ff3-43dc-af37-d9db914f4590?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0328e1a2ad09bc74537bb64ce1859f70", "srcset": "https://si.imgix.net/30384601/uploads/origins/1274a038-6ff3-43dc-af37-d9db914f4590?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0328e1a2ad09bc74537bb64ce1859f70, https://si.imgix.net/30384601/uploads/origins/1274a038-6ff3-43dc-af37-d9db914f4590?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f3fb513a4a7c7a76daa3f9459706ce05 2x, https://si.imgix.net/30384601/uploads/origins/1274a038-6ff3-43dc-af37-d9db914f4590?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=57c00fd4522d27a538ce6194a64154fb 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/30384601/uploads/origins/1274a038-6ff3-43dc-af37-d9db914f4590?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b8c7a7dc075902e4991f4d11fad2f1e9", "srcset": "https://si.imgix.net/30384601/uploads/origins/1274a038-6ff3-43dc-af37-d9db914f4590?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b8c7a7dc075902e4991f4d11fad2f1e9, https://si.imgix.net/30384601/uploads/origins/1274a038-6ff3-43dc-af37-d9db914f4590?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=ab9afa8c62ddd5011e8f3a7df83b4f52 2x, https://si.imgix.net/30384601/uploads/origins/1274a038-6ff3-43dc-af37-d9db914f4590?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=f4116dc0d75bbe707bc4765708df7436 3x"}, "body": "しらかわ様\n\nお忙しい中失礼します。\nいつもお世話になっております。\nIRIAMでお世話になっておりますVライバーの芽吹ラムです。\n\nこの度は\n「Vライバー 万葉まよの１周年記念イラスト」\nの作成をお願いしたくご連絡させて頂きました。\n初めてskebを利用させていただいておりますが、もし不備やご不快な文言などございましたら申し訳ありません。\n\n今回しらかわ様を詰め込んだイラストをプレゼントできればと思い連絡させていただきました。\n\n\n全体的な雰囲気としては同じskebリクエストにございました\n「Vtuber 玖兎音るうさんの生誕イラスト」が素敵だなと思って今回こちらで依頼させていただきました。\n\n\n【構図】\n・芽吹ラムと万葉まよさんが隣あって一緒にいるイメージ。\n・頭、髪、腕等イラストの端が切れていない構図\n\n【衣装】\n2人の衣装交換ができればと思っております。\n・万葉さんに私が普段着ているアイヌの民族衣装\n・芽吹には万葉さんが着ているアイドル衣装\n2人とも色みやポーズなどは特に希望はありませんのでしらかわさまを詰め込んでいただきたいです。\n\n【表情】\n①おまかせ表情（ういんくや笑顔など明るい雰囲気）\n②万葉さんがテンション高めの表情で芽吹ラムが恥ずかしがっている表情\n\n【使用用途】\n・配信サムネイル、各種snsなど活動全般\n・商用利用(スタンプ、グッズ化等)\n　※不可のものがある場合はお手数おかけしますが、再送かキャンセルをしていただけますと幸いです。\n\n【その他】\n背景透過、それぞれで使用できるように個別の透過もいただきたいと思っております。\n\n【資料】\n万葉まよさんの立ち絵\nhttps://x.com/banbamayo/status/1739571766564151596\n・桃色モモンガ\n・アイドル\n・葉っぱモチーフのヘアピン\n・元気いっぱいで声が大きい\n\n\n細かく書いてしまい申し訳ありませんがよろしくご検討いただけますと幸いです。", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@koume_shirakawa/works/8", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2484411, "client_id": 2718897, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/75892539/uploads/origins/a8f78a46-a7ad-4062-926d-3f5753df7ee7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ccb452c5ac07c965c0b973b3e49e1d78", "srcset": "https://si.imgix.net/75892539/uploads/origins/a8f78a46-a7ad-4062-926d-3f5753df7ee7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ccb452c5ac07c965c0b973b3e49e1d78, https://si.imgix.net/75892539/uploads/origins/a8f78a46-a7ad-4062-926d-3f5753df7ee7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b157261d13e7bd28db85b0466271474f 2x, https://si.imgix.net/75892539/uploads/origins/a8f78a46-a7ad-4062-926d-3f5753df7ee7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=0a4219e35315d77b677c6a0009936a4f 3x"}, "duration": null, "nsfw": false, "hardcore": false, "co