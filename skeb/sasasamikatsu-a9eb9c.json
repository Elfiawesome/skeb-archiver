&s=8563208e74a73edd458384cf2ba05e63, https://si.imgix.net/6e7e4403/uploads/origins/e1ed1dcf-5ad0-4112-a524-4a63b438aea0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c9b0a9acf751efc149350a8d44f4c9ac 2x, https://si.imgix.net/6e7e4403/uploads/origins/e1ed1dcf-5ad0-4112-a524-4a63b438aea0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=449637554721dd7e0335fdcc5ea2871b 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/6e7e4403/uploads/origins/e1ed1dcf-5ad0-4112-a524-4a63b438aea0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f461a18cdbc290b629a33e07c9aa0d11", "srcset": "https://si.imgix.net/6e7e4403/uploads/origins/e1ed1dcf-5ad0-4112-a524-4a63b438aea0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f461a18cdbc290b629a33e07c9aa0d11, https://si.imgix.net/6e7e4403/uploads/origins/e1ed1dcf-5ad0-4112-a524-4a63b438aea0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=bce3c7f25a7663282811dca35e1784ee 2x, https://si.imgix.net/6e7e4403/uploads/origins/e1ed1dcf-5ad0-4112-a524-4a63b438aea0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=227ab1ef86dd280787bad8225ee5e603 3x"}, "body": "初めまして、アガワヒロと申します。\nskebにて依頼するのは初めてのことですので、失礼があったら申し訳ありません。\n描いていただきたいのはTRPGシステム『ソード・ワールド2.5』で使っている自キャラクターの立ち絵イラストとなります。\n\nキャラクターシートのリンクは資料URLにてですが、念のため本文にも記載します。\nhttps://yutorize.2-d.jp/ytsheet/sw2.5/?id=sq5Rck\n\nキャラクターシートに現在置かれているイラストを参考にしていただいて、以下についてお願いしたいです。\n\n●服などのデザイン面\n・全体的なデザインのイメージとしては『和風にアレンジされたシスター服』\n・参考イラストの背後にある後光のようなものはなくしてしまって欲しい\n・参考イラストで見えていない部分のスカート丈は『ミモレ』のイメージですが長さはおまかせ\n・足元に関しては『編み上げブーツ』のイメージですが変えていただいても大丈夫\n・胸元に信仰している神の『雲から雨が降っている様子を図案化したシンボル』が欲しいがなくても大丈夫\n・いわゆるスタッフと呼ばれる『魔法使いの杖』を持っているイメージですがなくても大丈夫\n\n●ポーズや表情に関して\n・ポーズのイメージはおなかのところで両手を重ねている感じですが基本的におまかせ\n・表情は基本的に乏しくポーカーフェイスで差分に関してはあってもなくてもおまかせ\n・12歳にしては体型は細身でキャラクターシートの記載内容を参考にして欲しい\n\n●髪色や瞳など\n・基本的に参考イラストのとおりでお願いしたい\n・髪の毛は艶のある黒色で腰までの長さのさらさらなストレートのロングヘア\n・瞳は夕焼けのようなオレンジ色で参考イラストのように睫毛の印象強め\n・肌は白めですが色白な黄色人種程度の白さ\n\n●その他\n・意外と神出鬼没かつ非常に好奇心旺盛で活発に動き回る\n・『妖精巫女』と元々の故郷では呼ばれており妖精使いとしての優れた才能がある\n・妖精魔法を使う妖精使いであると同時に優れた神聖魔法を使う神官でもある\n・素直なようでいて頑固でたまにロックスターのような過激な発言をすることもある\n・一人称は『しえちゃん』でそう呼ばれたり呼ばれなかったりする\n・立ち絵につける宛名に関してはSNSにあげる可能性があるのでなるべく欲しい\n\n以上となります。どうぞよろしくお願いします。\n\nhttps://yutorize.2-d.jp/ytsheet/sw2.5/?id=sq5Rck", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@sasasamikatsu/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1469347, "client_id": 1589758, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/dc8952c7/uploads/origins/34e5016c-7b7f-41cc-8e26-fa1816633581?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bd26e25a276463bbb51aaf8a15be47e5", "srcset": "https://si.imgix.net/dc8952c7/uploads/origins/34e5016c-7b7f-41cc-8e26-fa1816633581?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bd26e25a276463bbb51aaf8a15be47e5, https://si.imgix.net/dc8952c7/uploads/origins/34e5016c-7b7f-41cc-8e26-fa1816633581?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f7c6682ca7181e281707576c5f3a3c07 2x, https://si.imgix.net/dc8952c7/uploads/origins/34e5016c-7b7f-41cc-8e26-fa1816633581?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a42f89b1ccc2fce05b040752569727a9 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/dc8952c7/uploads/origins/34e5016c-7b7f-41cc-8e26-fa1816633581?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a17691e2bb951e4b523a47d54dab30a8", "srcset": "https://si.imgix.net/dc8952c7/uploads/origins/34e5016c-7b7f-41cc-8e26-fa1816633581?bg=%23fff&auto=format%2Ccompress&fm=webp&fi