白ビキニで絶賛セクシーポーズ中のリンちゃんに突然ちらっと気づいてもらいたい。\n\n2つのシーンがある：\nシーン１：グラビア撮影に集中するリンちゃんを見守りたい。\nシーン２：慌てて顔を赤らめながらも必死に隠そうとするリンちゃんも見てみたい。\n\nリンちゃんの衣装：上はセーラー服で、片手を頭の横にあげていることでヘソがギリギリ見えるくらいに丈が短い。下は白ビキニ。\n\n僕の依頼は読んでくれてありがとうございます。", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@h_tamura/works/5", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/57241f11/uploads/origins/a76b6acc-27c4-45cf-b476-a4f3f3288ddc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=b3f2d669ce2307b4efbb01b702b8ff58", "srcset": "https://si.imgix.net/57241f11/uploads/origins/a76b6acc-27c4-45cf-b476-a4f3f3288ddc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=b3f2d669ce2307b4efbb01b702b8ff58, https://si.imgix.net/57241f11/uploads/origins/a76b6acc-27c4-45cf-b476-a4f3f3288ddc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=f41c395f7150ae187e78f152985d99da 2x, https://si.imgix.net/57241f11/uploads/origins/a76b6acc-27c4-45cf-b476-a4f3f3288ddc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=f317a799cc20b688454d777934c0fd4f 3x"}, "private": true, "genre": "art", "tipped": false, "creator_id": 1449558, "client_id": 1096108, "nc": 128}, {"path": "/@h_tamura/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1449558, "client_id": 2789898, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/39a3537f/uploads/origins/08a60480-55d7-420a-997a-f27ae593edbb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=to