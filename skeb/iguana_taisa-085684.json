imgix.net/657cfcc4/uploads/origins/6f5d9053-bda3-4922-94eb-9688d0c9b7af?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9f4854831275840db61572091bc61b8b, https://si.imgix.net/657cfcc4/uploads/origins/6f5d9053-bda3-4922-94eb-9688d0c9b7af?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=1ce16efc791a4bde6c65066d638a87d4 2x, https://si.imgix.net/657cfcc4/uploads/origins/6f5d9053-bda3-4922-94eb-9688d0c9b7af?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=72283e8a799250c44565075865a073a3 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/657cfcc4/uploads/origins/6f5d9053-bda3-4922-94eb-9688d0c9b7af?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=60a57eebb31e25bd2949b3665b063a74", "srcset": "https://si.imgix.net/657cfcc4/uploads/origins/6f5d9053-bda3-4922-94eb-9688d0c9b7af?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=60a57eebb31e25bd2949b3665b063a74, https://si.imgix.net/657cfcc4/uploads/origins/6f5d9053-bda3-4922-94eb-9688d0c9b7af?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=6100db49e5201d0633bc7d62f3f63dca 2x, https://si.imgix.net/657cfcc4/uploads/origins/6f5d9053-bda3-4922-94eb-9688d0c9b7af?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=c314096381576ce0d47f718a8843463f 3x"}, "body": "いつもお世話になっております。\n八百です。\n前回はとても素敵なイラストをありがとうございました！\n\n今回は旅行に行く『八百アオヰ』を描いていただきたいです。\n前回と同じような雰囲気でお願いしたいです！\n\n髪型は資料通りで、衣装はお任せいたします。\n\n小物案\n・リュック\n・キャリーバック\n・スマホ\n・瓶ラムネ\n\nポーズ、構図は前回と同じか前回のものを反転させたような構図、前回のものと並べやすいものだと嬉しいです。\n\n表情も前回と同じ感じでお願いしたいです。\n\nサイズや用途も前回同様で、\n\n人物のみの背景透過ファイルをお願いしたく、また、人物の姿がなるべく切れないようにしていただけるとありがたいです。サムネや動画内等で使用させていただきたいです。グッズ制作は致しませんが、収益化後も使用させていただきたいです。\n\n資料\nTwitter：https://twitter.com/oo_ja_xX/status/1688872001346400256?s=20\n\nご検討いただけますと幸いです。何卒、よろしくお願いいたします。\