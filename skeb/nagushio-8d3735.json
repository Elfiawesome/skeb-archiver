イドや執事（現代では助手）として働いているノンバイナリーの兎の精霊です。明るく、忠実で、働き者で、マナーも良い。165cmくらいだが、体重は秘密。イチゴ、紅茶、牛乳、秋冬の季節、文房具（手書きの手紙、ペン、ノート、メモ帳）、お手伝い、お話、天体観測、音楽や人の歌を聴くのが好きである。ニンジン、ワナにはまること、失敗すること、人をがっかりさせることが嫌い。\n\n美世のバージョン（メイドバージョンと執事バージョン）は、どちらか好きな方を選ぶことができます。また、ポーズや表情も選ぶことができます。\n\nみよちゃんを気に入っていただきありがとうございます。とてもうれしいです\n\nhttps://sta.sh/218yi3af4kqq", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@nagushio/works/8", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 561638, "client_id": 60084, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/a1d0ae25/uploads/origins/9779ff54-b96e-4608-b773-0116e12fdaef?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1297cdd602e0bcb2a4604f6f5dbcee50", "srcset": "https://si.imgix.net/a1d0ae25/uploads/origins/9779ff54-b96e-4608-b773-0116e12fdaef?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1297cdd602e0bcb2a4604f6f5dbcee50, https://si.imgix.net/a1d0ae25/uploads/origins/9779ff54-b96e-4608-b773-0116e12fdaef?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=3db82b81767e211fa6f11817b6b25b16 2x, https://si.imgix.net/a1d0ae25/uploads/origins/9779ff54-b96e-4608-b773-0116e12fdaef?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=8eafc8f64ae13b1a823ef53847f0388b 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/a1d0ae25/uploads/origins/9779ff54-b96e-4608-b773-0116e12fdaef?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=65c4e8fb89c16c278d43bf161d002917", "srcset": "https://si.imgix.net/a1d0ae25/uploads/origins/9779ff54-b96e-4608-b773-0116e12fdaef?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=65c4e8fb89c16c278d43bf161d002917, https://si.imgix.net/a1d0ae25/uploads/origins/9779ff54-b96e-4608-b773-0116e12fdae