サンドウィッチ、そして紅茶があること!茶色やベージュの毛並みのある白猫が隣の椅子に座ったり、テーブルの上に座ったりしていると嬉しいです。アートは夢のような不思議な感じがいい。時間帯は、太陽の光が差し込んで暖かく輝いている午後の時間帯が望ましいです。前景に花びらが落ちているような感じでお願いします。\n\n夏服を着たランピーを描いてください。ワンピースはウエストを少し絞って、バストや体型を強調してもよいでしょう。彼女は暖かく微笑んでいることでしょう。\n\nSNSで使用しますので、16:9の比率（1920x1080p）でお願いします。背景レイヤーとアートレイヤーの分離、サインレイヤーの分離をお願いします。\n\nhttps://drive.google.com/drive/folders/1QnjPnu_MfOcJKatI18fdiqRrXOTkbBPs?usp=sharing", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@mizuuming/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 522590, "client_id": 1330446, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/dd3f9dbd/uploads/origins/b0bc7bf5-a9cb-4a0f-80c4-9f5d6c98937c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=28d2109e630bda2c84fe612e0a347c4f", "srcset": "https://si.imgix.net/dd3f9dbd/uploads/origins/b0bc7bf5-a9cb-4a0f-80c4-9f5d6c98937c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=28d2109e630bda2c84fe612e0a347c4f, https://si.imgix.net/dd3f9dbd/uploads/origins/b0bc7bf5-a9cb-4a0f-80c4-9f5d6c98937c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=df91372724224449e466092d1a97d015 2x, https://si.imgix.net/dd3f9dbd/uploads/origins/b0bc7bf5-a9cb-4a0f-80c4-9f5d6c98937c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a133db59a24e2d38d7b7a67ad1f93c4c 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/dd3f9dbd/uploads/origins/b0bc7bf5-a9cb-4a0f-80c4-9f5d6c98937c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=41e71db7a3658a123bc034a1418b66b3", "srcset": "https://si.imgix.net/dd3f9dbd/uploads/origins/b0bc7bf5-a9cb-4a0f-80c4-9f5d6c98937c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=41e71db7a3658a123bc034a1418b66b3, http