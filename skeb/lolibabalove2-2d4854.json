x.net/c23b4e2a/uploads/origins/fa138e5e-a0bb-4bc7-8f1c-2c3c49773767?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ae0190679928ba48b403793a8beccecf 2x, https://si.imgix.net/c23b4e2a/uploads/origins/fa138e5e-a0bb-4bc7-8f1c-2c3c49773767?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d4cde01dc82fe1559e3d6493fddeace8 3x"}, "duration": null, "nsfw": true, "hardcore": true, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/c23b4e2a/uploads/origins/fa138e5e-a0bb-4bc7-8f1c-2c3c49773767?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=067516b6d9ce70af604baa81a98d5f69", "srcset": "https://si.imgix.net/c23b4e2a/uploads/origins/fa138e5e-a0bb-4bc7-8f1c-2c3c49773767?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=067516b6d9ce70af604baa81a98d5f69, https://si.imgix.net/c23b4e2a/uploads/origins/fa138e5e-a0bb-4bc7-8f1c-2c3c49773767?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=ba2e5e6ef24817c013bf51b8f3a7e93a 2x, https://si.imgix.net/c23b4e2a/uploads/origins/fa138e5e-a0bb-4bc7-8f1c-2c3c49773767?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=c9c6d7badd2ed3a3d1786ef3b7d0c8cb 3x"}, "body": "こんばんは。ふゆさんのシリーズ毎回楽しみにしています。ロリババアではないのですが、是非フルカラーの漫画形式のイラストをリクエストさせてください。\n\n・キャラクター\n「先輩がうざい後輩の話」の「五十嵐双葉」\n\n・シチュエーション\n会社の昼休みにトイレで先輩の性欲処理をして精液をたっぷり飲ませられる漫画\n\n・是非入れて頂きたい内容\n  ・双葉の頭に巨大で非常に長いちんぽをズシンと乗せて、双葉をびっくりさせる\n  ・双葉が自分からフェラ、大きすぎだと文句を言う\n  ・ 両手で双葉の頭を掴んで、思いっきり喉にちんぽを突っ込んで喉オナホイラマをする \n  ・大量に喉奥で射精して、双葉は無理やり大量に精液を飲まされる(食道に直接注ぎ込まれている)\n  ・精液でスーツからお腹がはみ出るほどのボテ腹になる\n  ・口からちんぽが抜かれた後、頭にもぶっかけて緑髪やスーツがザーメンで真っ白ネバネバになる、それに対し双葉が仕事中だし、お腹もどうするんですかと文句を言う\n  ・まだちんぽがガチガチなのを見て、双葉が私を精液タンクだと思ってしっかりザーメン吐き捨ててください、と言うようなセリフを言って続きを始める、というオチ\n\n・備考\n  ・先輩はちんぽのみか、ちんぽとセリフのみの出演でお願いします。\n  ・双葉は嫌そうにしつつも最後まで付き合ってあげるような感じを出して頂けると嬉しいです。\n  ・是非、主観視点で双葉が上目遣いでフェラかイラマをしているシーンを入れてください。\n  ・最後のぶっかけでは可能な限り大量のザーメンで思い切り汚して頂けると嬉しいです(特に髪型が精液でぐちゃぐちゃになるのが性癖なので…)。\n  ・その他、先生の追加したい要素などありましたら改変して頂いて構いません。\n\n以上、何卒よろしくお願いいたします。", "nc": 170, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@lolibabalove2/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1529419, "client_id": 1497264, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/52f4a05d/uploads/origins/211ba8a5-d27a-48bd-b465-d713c2dd1396?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=dffafc69d03ff7bccd777b1549c26c1c", "srcset": "https://si.imgix.net/52f4a05d/uploads/origins/211ba8a5-d27a-48bd-b465-d713c2dd1396?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=dffafc69d03ff7bccd777b1549c26c1c, https://si.imgix.net/52f4a05d/uploads/origins/211ba8a5-d27a-48bd-b465-d713c2dd1396?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e0fc3a122ff04542a88c29aa23549690 2x, https://si.imgix.net/52f4a05d/uploads/origins/211ba8a5-d27a-48bd-b465-d713c2dd1396?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=cc5f904110da4fc4e9894109d3967222 3x"}, "duration": null, "nsfw": true, "hardcore": true, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/52f4a05d/uploads/origins/211ba8a5-d27a-48bd-b465-d713c2dd1396?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=88d8c445e3f0e9344a24b7c1c60d90db", "srcset": "https://si.imgix.net/52f4a05d/uploads/origins/211ba8a5-d27a-48bd-b465-d713c2dd1396?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=88d8c445e3f0e9344a24b7c1c60d90db, https://si.imgix.net/52f4a05d/uploads/origins/211ba8a5-d27a-48bd-b465-d713c2dd1396?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=bad9b5f03fcf02afcd0685289d537ebc 2x, https://si.imgix.net/52f4a05d/uploads/origins/211ba8a5-d27a-48bd-b465-d713c2dd139