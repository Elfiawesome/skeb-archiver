le.com/drive/folders/10-SB8ER_n8pscPiiQAp_mgAB7DWXwcNl", "nc": 177, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Mojarin_Baby/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2122982, "client_id": 1524117, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/600b6d2e/uploads/origins/1f7b7011-848d-4d18-859e-53b7a03280de?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=840a1f554e18d227ee20e03978f6678d", "srcset": "https://si.imgix.net/600b6d2e/uploads/origins/1f7b7011-848d-4d18-859e-53b7a03280de?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=840a1f554e18d227ee20e03978f6678d, https://si.imgix.net/600b6d2e/uploads/origins/1f7b7011-848d-4d18-859e-53b7a03280de?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=fc95b113c05a1d9713e366f61be8108b 2x, https://si.imgix.net/600b6d2e/uploads/origins/1f7b7011-848d-4d18-859e-53b7a03280de?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f6bd7b5289aacbc60683abee0b7d87ce 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/600b6d2e/uploads/origins/1f7b7011-848d-4d18-859e-53b7a03280de?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=84b956e194f130f539f80b010c64a72e", "srcset": "https://si.imgix.net/600b6d2e/uploads/origins/1f7b7011-848d-4d18-859e-53b7a03280de?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=84b956e194f130f539f80b010c64a72e, https://si.imgix.net/600b6d2e/uploads/origins/1f7b7011-848d-4d18-859e-53b7a03280de?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=a3dc42b7923fc9187bf7617ec28190ae 2x, https://si.imgix.net/600b6d2e/uploads/origins/1f7b7011-848d-4d18-859e-53b7a03280de?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=69fd0fa19c7dd7a4a2d5f2f0f344fa2c 3x"}, "body": "こんにちは、はじめまして。\n私の好きなインディーズ漫画「神様セカンドライフ」のキャラクター「八恵（ヤエ）」を描いてください。\n紫の髪のおかっぱロングで座敷童のロリババアです。\n衣装は普段は赤い着物ですがセーラー服で描いてください。\nセーラー服の色、デザインはご自由になさってください。\n\nパンチラと胸のチラ見えで描いていただきたいです。\n胸のチラ見えは上から（襟元の隙間から）もしくは下から（裾から）のどちらでも大丈夫です。前かがみで、とか風に裾が煽られて、などでもいいし裾をまくって見せている、でも何でも描きやすいもので。\n※胸は貧乳ですので盛らないで欲しいです。乳首が見えて欲しいのでブラは無しでお願いします。\n\n↓こちらが原作者さんの描いた漫画の八恵がよく出てくる回です\nhttps://yamanosu.com/blog-entry-373.html\n\n↓私が描いた八恵のファンアートです（右側）\nhttps://twitter.com/SakumaGinmaru/status/1464599586379501573\n\n原作者さまにはスケブで有償依頼してもよいと許可をいただいておりますので大丈夫です。\n\nまた、描いていただいた八恵を頂き物として私のpixivファンボックス（無料公開枠）に展示したいので転載する許可をいただきたいです。\n\nどうぞよろしくお願いいたします。", "nc": 57, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Mojarin_Baby/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2122982, "client_id": 2047766, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/0c0caba6/uploads/origins/93ae8403-73fa-498b-8a71-6a2912a1caa1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=be3aed8c75ab25551623f2c3bb46cc6c", "srcset": "https://si.imgix.net/0c0caba6/uploads/origins/93ae8403-73fa-498b-8a71-6a2912a1caa1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=be3aed8c75ab25551623f2c3bb46cc6c, https://si.imgix.net/0c0caba6/uploads/origins/93ae8403-73fa-498b-8a71-6a2912a1caa1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c99ad79a6b31dfee87d3fae74ba0dcd4 2x, https://si.imgix.net/0c0caba6/uploads/origins/93ae8403-73fa-498b-8a71-6a2912a1caa1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b16c65c48927831933ef8651885ca75c 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/0c0caba6/uploads/origins/93ae8403-73fa-498b-8a71-6a2912a1caa1?bg=%23fff&auto=format%