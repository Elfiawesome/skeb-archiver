=200&s=a193a9102481e084eab76c15d24887cd, https://si.imgix.net/51346da0/uploads/origins/a1227e2a-18be-42ab-9ac3-f9e3a416d0fc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=7ad67ac4b5c278f16a50e9df79b533e3 2x, https://si.imgix.net/51346da0/uploads/origins/a1227e2a-18be-42ab-9ac3-f9e3a416d0fc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=6cb3d3db471d7d43896623c06e063cb8 3x"}, "duration": null, "nsfw": true, "hardcore": true, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/51346da0/uploads/origins/a1227e2a-18be-42ab-9ac3-f9e3a416d0fc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0e57473ea8c765cdde70663f5bf85353", "srcset": "https://si.imgix.net/51346da0/uploads/origins/a1227e2a-18be-42ab-9ac3-f9e3a416d0fc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0e57473ea8c765cdde70663f5bf85353, https://si.imgix.net/51346da0/uploads/origins/a1227e2a-18be-42ab-9ac3-f9e3a416d0fc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=7a8ce3e9014549bacf9a68cecfe6dfc2 2x, https://si.imgix.net/51346da0/uploads/origins/a1227e2a-18be-42ab-9ac3-f9e3a416d0fc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=12a8d7bbcc05920f03f1a5d7e4012123 3x"}, "body": "みつかさん、前回はご依頼受けていただき本当にありがとうございました！とてもエッチなものを納品していただき、最近のお口絵がどれも魅力的で大好きなのでまたご依頼させてください！\n\n「キャラ」\n・グラブルのクラリス(火SSR)とディアンサ(土SSR)\n\n「衣装」\n・既存の衣装\n・半脱ぎで胸が露出した状態\n・リボンと手袋はつけたまま\n\n「基本ポーズとプレイ内容」\n・Wひょっとこフェラで包茎掃除搾精\n・みつかさんが描いていたラルナママとナルメアのWフェラのような構図\n●参考URL\nhttps://www.pixiv.net/artworks/89545572\n\n\n「詳しいシチュ・雰囲気」\n\n・団長のちんぽ掃除係専属のクラリスとディアンサが、チンカスとザーメンの溜まった団長の包茎ちんぽを逆レイプ搾精しにくる。\n\n・2人が胸をプルンと露出し汗と発情したメス臭が充満、それに加え舌を淫らに動かして団長を誘惑。\n\n・誘惑されてフル勃起したちんぽに2人とも淫らな笑みを浮かべ、舌なめずりしてスイッチが入る。\n\n・フル勃起しても包茎で皮を被ったままのちんぽを2人でお口でムキムキし、においとチンカスに大興奮。\n●参考URL\nhttps://www.pixiv.net/artworks/41544905\n\n・2人で夢中になってチンカスを舌で削ぎ落としひょっとこフェラ、あまりの攻めに我慢汁ダラダラで耐える団長。\n\n・絶頂寸前に気づき先に射精させたほうが勝ちの勝負をし始め、交互にしゃぶりつく。\n\n・ザーメン懇願し2人でしゃぶりつきそのまま大量に射精。口、胸、顔など全身に大量ぶっかけ。\n\n・ザーメンを飲み干しザーメンゲップしながら2人でピースポーズ\n\n・引き分けになってしまったから再勝負しなきゃと、舌なめずりしながらちんぽに頬ずりで終わり\n\n\n「差分や細部」\n\n・差分いろいろ見てみたいです！\n・セリフと擬音あり\n・下品な淫語沢山言って欲しいです\n・表情はいやらしく下品な感じで、えっちが大好きな雰囲気\n・乳首は発情して勃起状態\n・口元に陰毛つけてほしいです\n・射精時に鼻ザー描写みたいです\n\n・ザーメン懇願時のセリフにこの2つを入れて欲しいです\nクラリス「だんちょ♡だんちょ♡私の最かわ口マンコにピュッピュッしよ♡しよ♡」\nディアンサ「団長さん♡私のアイドル口マンコの方が気持ちよくザーメン排泄できますよ♡」\n\n・手袋や衣類など我慢汁やザーメンで汚してほしい\n・団長さんの包茎ちんぽ大好きな2人がくさがったりしつつも汚いちんぽに興奮するような様子で、フェラ大好きな雰囲気で描いていただきたいです\n\n\n\n●長文で要求が多く申し訳ありません。説明不足な点や難しい点がありましたら、みつかさんの解釈やアレンジで描いてくださって構いませんので、ぜひご依頼のほう受けていただければ幸いです。よろしくお願い致します。", "nc": 59, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Dariya282/works/2", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/96adf3e0/uploads/origins/661d13f3-d99f-4373-9f4b-10b85e6d8abe?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=cddeb38d845fd576f6697b47a55ef1d7", "srcset": "https://si.imgix.net/96adf3e0/uploads/origins/661d13f3-d99f-4373-9f4b-10b85e6d8abe?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=cddeb38d845fd576f6697b47a55ef1d7, https://si.imgix.net/96adf3e0/uploads/origins/661d13f3-d99f-4373-9f4b-10b85e6d8abe?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=8b66fbd1ec94facbfa6bb90e9a07e37e 2x, https://si.imgix.net/96adf3e0/uploads/origins/661d13f3-d99f-4373-9f4b-10b85e6d8abe?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=f7022f0077b177f17be3f68fb863d278 3x"}, "private": true, "genre": "art", "tipped": 