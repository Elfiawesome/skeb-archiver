いしたいです！\n\n構図やポーズ等はお任せ致します。いちごのショートケーキやホイップクリームをテーマで描いて頂けると嬉しいです！！ちょっとのキャラ紹介もリンクに書いておきました。衣装も自由に選んでアレンジしても構いません！\n\nもし宜しければ納品はPSD形式で背景とキャラクターのレイヤーを分けていただけると幸いです！描いて頂いたイラストは個人観賞用にグッズにする場合があります。販売など、商業利用は一切ありません。\n\nご検討いただけると幸いです。ありがとうございます！🙇‍♀️\n\nhttps://mhu.crd.co/#yves", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@rice8p/works/14", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 37519, "client_id": 3489911, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/09dd89e7/uploads/origins/b0e5ed40-b2df-4245-b2ed-660d2f4e1993?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=36273f74162c2a8b70b99883861da22f", "srcset": "https://si.imgix.net/09dd89e7/uploads/origins/b0e5ed40-b2df-4245-b2ed-660d2f4e1993?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=36273f74162c2a8b70b99883861da22f, https://si.imgix.net/09dd89e7/uploads/origins/b0e5ed40-b2df-4245-b2ed-660d2f4e1993?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=6a68538ccee098ff61ac9441c59a1180 2x, https://si.imgix.net/09dd89e7/uploads/origins/b0e5ed40-b2df-4245-b2ed-660d2f4e1993?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=fa44722163d54a65d6397ba514f1b38a 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/09dd89e7/uploads/origins/b0e5ed40-b2df-4245-b2ed-660d2f4e1993?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=8952c815199a8a3d79151b18327f764b", "srcset": "https://si.imgix.net/09dd89e7/uploads/origins/b0e5ed40-b2df-4245-b2ed-660d2f4e1993?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=8952c815199a8a3d79151b18327f764b, https://si.imgix.net/09dd89e7/uploads/origins/b0e5ed40-b2df-4245-b2ed-660d2f4e1993?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr