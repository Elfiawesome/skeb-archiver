or_id": 2575, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/afc48cc8/uploads/origins/fcc0a3af-b297-41b8-bf31-7865f65e7db8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=06aa62e2b1a5b90577a351aae18d9196", "srcset": "https://si.imgix.net/afc48cc8/uploads/origins/fcc0a3af-b297-41b8-bf31-7865f65e7db8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=06aa62e2b1a5b90577a351aae18d9196, https://si.imgix.net/afc48cc8/uploads/origins/fcc0a3af-b297-41b8-bf31-7865f65e7db8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=0c6de234e4747fd1f3f9ed5b9043c324 2x, https://si.imgix.net/afc48cc8/uploads/origins/fcc0a3af-b297-41b8-bf31-7865f65e7db8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=db4647bc62eab600f3d516f716c20b69 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/afc48cc8/uploads/origins/fcc0a3af-b297-41b8-bf31-7865f65e7db8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=115a380809a27c024c0dba2c990e3237", "srcset": "https://si.imgix.net/afc48cc8/uploads/origins/fcc0a3af-b297-41b8-bf31-7865f65e7db8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=115a380809a27c024c0dba2c990e3237, https://si.imgix.net/afc48cc8/uploads/origins/fcc0a3af-b297-41b8-bf31-7865f65e7db8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=4b47ff5cc48c65320432eff37286cd33 2x, https://si.imgix.net/afc48cc8/uploads/origins/fcc0a3af-b297-41b8-bf31-7865f65e7db8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=0105548c2a23caefac47c51e50ef38ab 3x"}, "body": "初めまして。雪花ラミィと獅白ぼたんが痴漢に会ってしまった白黒イラストを、漫画形式でお願いしたいです。以下の要素を含む形で、どうかご検討いただければと思います。\n\n・「制服デートをしようと思い立った二人が電車に乗っていたら、運悪く凶悪な痴漢集団に出くわしてしまった」というシチュエーションです。2人の服装はhololive ERRORの制服姿でお願いします。\n・散々痴漢に弄ばれた直後の二人が、電車の中で立ち尽くして、痴漢たち（カメラ側）の方を背を向けて睨みつけているという構図。\n・ラミィの胸元のボタンは全て外され胸が露出しており、スカートも捲れている。パンツは太ももまで下ろされており、アソコから精液が垂れ下がっている。スカートの裾にピンクローターのコントローラ部が挟められており、コードがラミィのお尻の穴の方へと伸びている。涙目で悔しそうな表情。\n・ぼたんも胸が軽く露出している。スカートを奪われてしまい下半身はパンツのみ。バイブを挿入された状態でパンツを履かされ、アソコに栓をしているかのような状態。太ももには精液が伝っている。ラミィと同じく涙目で悔しそうな表情。\n・彼女たちを煽る痴漢たちの台詞を添えていただければと思います。内容としては「ほら早く服着ないと、駅に着いちゃうよ？ｗ」「スカート返してほしい？なら俺達の言う事聞けよｗ」的な台詞回しでお願いします。\n\n・多目的トイレに連れ込まれ、互いに向かい合うように立たせられて、両手を掴まれながら立ちバックレイプされる2人。2人は胸と胸をくっつけ合い、泣きながら喘ぎを堪えている。2人は全裸にされています。\n・最後に、小さいコマで問題ありませんが、2人が痴漢たちに頭を押さえつけられながら無理やりレズキスを強要される絵をお願いします。\n\n以上です。背景や竿役のデザイン等は簡略化して問題ありません。注文が多くて申し訳ありませんが、どうかよろしくお願いします。", "nc": 57, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@kuzuaki/works/15", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2575, "client_id": 326015, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/380ffd9e/uploads/origins/a75961a4-24a4-4b12-85a9-43953ee13ec4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d93ad2ff0fb7fd3ac83ae8e51748548e", "srcset": "https://si.imgix.net/380ffd9e/uploads/origins/a75961a4-24a4-4b12-85a9-43953ee13ec4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d93ad2ff0fb7fd3ac83ae8e51748548e, https://si.imgix.net/380ffd9e/uploads/origins/a75961a4-24a4-4b12-85a9-43953ee13ec4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=274b2ec6f6e1816d3737cefc18f33b1f 2x, https://si.imgix.net/380ffd9e/uploads/origins/a75961a4-24a4-4b12-85a9-43953ee13ec4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f64e38840c20d3006b01d15fd60cc5ef 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/380ffd9e/uploads/origins/a75961a4-24a4-4b12-85a9-43953ee13ec4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=4c1112766cb5f6a4e5c2754ac61cec46", "srcset