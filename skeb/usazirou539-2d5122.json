or_acceptable_same_genre": true}, {"path": "/@usazirou539/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1854244, "client_id": 93103, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/d797291d/uploads/origins/f0142ef9-0ee9-4753-be9b-8a0bee27a2d8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=46b5694a7f24e2f45da102616176e54b", "srcset": "https://si.imgix.net/d797291d/uploads/origins/f0142ef9-0ee9-4753-be9b-8a0bee27a2d8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=46b5694a7f24e2f45da102616176e54b, https://si.imgix.net/d797291d/uploads/origins/f0142ef9-0ee9-4753-be9b-8a0bee27a2d8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f2d4c957e9535e01fa6402fb1ff20fbb 2x, https://si.imgix.net/d797291d/uploads/origins/f0142ef9-0ee9-4753-be9b-8a0bee27a2d8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=9758c4c794336baec048469652166d5f 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/d797291d/uploads/origins/f0142ef9-0ee9-4753-be9b-8a0bee27a2d8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=cb41027afd4a4eb7746dc578933cf8fe", "srcset": "https://si.imgix.net/d797291d/uploads/origins/f0142ef9-0ee9-4753-be9b-8a0bee27a2d8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=cb41027afd4a4eb7746dc578933cf8fe, https://si.imgix.net/d797291d/uploads/origins/f0142ef9-0ee9-4753-be9b-8a0bee27a2d8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=1e30544cbd4dcd529e93953ddd5e7b2a 2x, https://si.imgix.net/d797291d/uploads/origins/f0142ef9-0ee9-4753-be9b-8a0bee27a2d8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=b55420ae4465a7d60b30b1f274640824 3x"}, "body": "ご無沙汰しております。\n先日はハチャメチャに可愛い二乃を