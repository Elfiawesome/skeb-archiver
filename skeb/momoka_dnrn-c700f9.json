p=top&w=200&h=200&blur=200&s=5f294d593802ea7dfe3a3ecfe9f924d7, https://si.imgix.net/a4a6cf65/uploads/origins/cdcb09e5-1d98-453b-afba-fefded8e6e38?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=d4c29e18ef7080540a54cef3b1a91e89 2x, https://si.imgix.net/a4a6cf65/uploads/origins/cdcb09e5-1d98-453b-afba-fefded8e6e38?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=0b8f0cbb5c138c832df559e43cfd8f0a 3x"}, "body": "こんにちは。\n私はあなたのアートスタイルが超きれいだと思います!私のキャラクターをあなたの画風で描いていただけないでしょうか？私のキャラクターは20歳の巫女で、天気を操ることができます。これをSNSやTwitchで背景として使えるようにお願いしたいと思います。\n\n私のキャラクターは、ハッピーでリラックスした表情で描いてほしいです。ポーズは、晴れた日に蝶々や花びらが浮かんでいる蘭の花畑に寝そべっている様子を描いてください。片方の腕を伸ばして、蝶を乗せることもできます。\n\nありがとうございました。\n\nhttps://imgur.com/a/RtaZIU8\n\nhttps://imgur.com/a/RtaZIU8", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@momoka_dnrn/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1033118, "client_id": 1703119, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/1b6f9516/uploads/origins/364bb466-a850-403f-b7ef-61c23afd9e5a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0e0df086f600ab6bc63cc9ab6ffb4f75", "srcset": "https://si.imgix.net/1b6f9516/uploads/origins/364bb466-a850-403f-b7ef-61c23afd9e5a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0e0df086f600ab6bc63cc9ab6ffb4f75, https://si.imgix.net/1b6f9516/uploads/origins/364bb466-a850-403f-b7ef-61c23afd9e5a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=57b7e48d8df8f4a6c24d1a40162a0710 2x, https://si.imgix.net/1b6f9516/uploads/origins/364bb466-a850-403f-b7ef-61c23afd9e5a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e440b6b7ddf7b26bebaa719889129197 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src