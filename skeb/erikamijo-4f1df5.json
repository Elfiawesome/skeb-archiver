pr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=419f5dcc81610cab04756751e9aa4eed 2x, https://si.imgix.net/796593bb/uploads/origins/45d90b49-84cf-442b-a069-3452a05f4589?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=32ca2d87f78ca14f6eacaeec9500371f 3x"}, "body": "Asatoです。\nせっかくの機会なのでリクエストさせて頂きます。SNSでのアイコン利用を考えています。\n私をイメージしたキャラクターを描いて頂ければ幸いです。\n\n希望の特徴\n①30～35歳、男性\n②チャコールグレーのスーツジャケットに濃いグレー系シャツ、同系統色のネクタイ\n（キーワードとしては都会的、シック）\n③濃いべっ甲の眼鏡、黒髪ショートヘアー、アナログの腕時計（革ベルト）\n④構図はお任せいたします。\n\n背景デザインはお任せいたします。\n珈琲が好きなので、濃い茶色系で作成頂けると嬉しいです。\n\n外見イメージのご参考URL\n（URL先の今井翼さん）\nhttps://e.usen.com/interview/interview-original/tell-me-hide.html\n\n恐れ入りますが、ぜひご検討頂ければと思います。よろしくお願いします。", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@erikamijo/works/10", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3526121, "client_id": 3623553, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/32276048/uploads/origins/08b71903-6df8-42be-a122-3db06fa1486a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1a2b94d4f7aad39b3290f4004e75996d", "srcset": "https://si.imgix.net/32276048/uploads/origins/08b71903-6df8-42be-a122-3db06fa1486a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1a2b94d4f7aad39b3290f4004e75996d, https://si.imgix.net/32276048/uploads/origins/08b71903-6df8-42be-a122-3db06fa1486a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f9da356ec6dbd1adcf0e69fa07716d34 2x, https://si.imgix.net/32276048/uploads/origins/08b71903-6df8-42be-a122-3db06fa1486a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=2f751f7721dfe5891a9e971ec168dd13 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/32276048/uploads/origins/08b71903-6df8-42be-a122-3db06fa1486a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e1e445c1063849c73ca1e8909a48ec8d", "srcset": "https://si.imgix.net/32276048/uploads/origins/08b71903-6df8-42be-a122-3db06fa1486a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e1e445c1063849c73ca1e8909a48ec8d, https://si.imgix.net/32276048/uploads/origins/08b71903-6df8-42be-a122-3db06fa1486a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=44307613efce9e3266a9d6cfa7d4894c 2x, https://si.imgix.net/32276048/uploads/origins/08b71903-6df8-42be-a122-3db06fa1486a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=d5d1eed169f6a78660e7e5fe06d6f9b9 3x"}, "body": "上条衿　様\nこんにちは。瑞豊と申します。\nSkebでのリクエストの募集開始の呟きを拝見しリクエストさせて頂きました。\n\n内容\n構図として、右耳に手を添えて「あなたの声をもっと聞かせてほしい」という思いを伝える微笑みの表情。髪型、髪の色、服装はお任せします。眼鏡を着用でお願いします。\n\n左耳に突発性難聴が発症して聴力がかなり弱くなった時に、公的なものではありませんが片耳難聴者用のヘルプマーク的な物で支援をしている団体があることを知り、個人的に上条衿@イラストレーターさんのイラストで同じようなものを手にしたいと思い、リクエストさせて頂きました。\n右耳は健常なので日常生活に支障はないので、上条衿@イラストレーターさんのイラストをモチベーションの維持向上の一助にさせていただければと思っています。\n\nお忙しいところ恐縮ですが、ご検討のほどよろしくお願い申し上げます。", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@erikamijo/works/9", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3526121, "client_id": 4010354, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/1ccae2db/uploads/origins/da4dceb9-a693-4ace-bfc7-3189e7d5320c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0d66528d3ed8b2a64ec196cc8cfc40aa", "srcset": "https://si.imgix.net/1ccae2db/uploads/origins/da4dceb9-a693-4ace-bfc7-3189e7d5320c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0d66528d3ed8b2a64ec196cc8cfc40aa, https://si.imgix.net/1ccae2db/uploads/origins/da4dceb9-a693-4ace-bfc7-3189e7d5320c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=64715686a