-45da-8a00-33a73f5b6a2d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6bf2034ec36b46ba0cfd9564f43fb21c, https://si.imgix.net/4397e54b/uploads/origins/ec1e6f14-2284-45da-8a00-33a73f5b6a2d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=1a5d6c86f8f6e6392f10dc2af3b28200 2x, https://si.imgix.net/4397e54b/uploads/origins/ec1e6f14-2284-45da-8a00-33a73f5b6a2d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=3b06bb9a16b09bf18eab42b81dc942d2 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/4397e54b/uploads/origins/ec1e6f14-2284-45da-8a00-33a73f5b6a2d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=80fe303cbe88a4c13642b8f239dbe91d", "srcset": "https://si.imgix.net/4397e54b/uploads/origins/ec1e6f14-2284-45da-8a00-33a73f5b6a2d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=80fe303cbe88a4c13642b8f239dbe91d, https://si.imgix.net/4397e54b/uploads/origins/ec1e6f14-2284-45da-8a00-33a73f5b6a2d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=0fcb7b11993b28249c6be5d03f90fb00 2x, https://si.imgix.net/4397e54b/uploads/origins/ec1e6f14-2284-45da-8a00-33a73f5b6a2d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=e6e82c90b58ee89d8e2e70cd10d06135 3x"}, "body": "某クレカ時代から応援してます。\nオリジナルキャラクターが出来たので、上条様のskebが再開されたとのなので是非好きに描いて頂きたくリクエスト失礼します。\n\n【コンセプト】 愛犬のパピヨンをモデルにした女の子です。かなりの老犬なのでいつでも身近に感じられるように使い魔のような存在も作りました。今は寝たきりですが、ツンデレな愛犬なのでもし可能でしたら一緒に描いていただけると嬉しいです。\n\n⚫︎用途はPC背景なので横長だと助かります。配信はしていませんが環境は整っているので身内内での配信等で利用する可能性があります。\n\n⚫︎キャラクターは資料の通りですが、メインカラーのターコイズブルーがあれば衣装、構図、髪型お好きに描いて頂いて構いません。髪色はグラデがかってます。\nゲーム好きなのでゲーム要素あると嬉しいです。（先生のゲーム垢のヘッダーもめちゃくちゃ好みです）\n\nご検討よろしくお願い致します。\n\nhttps://drive.google.com/drive/folders/1eQDaHUfPtKcJP5uYoyc2gHkCWZyY663o", "nc": 128, "word_count": 0, "transcoder": "image",