さな星が描かれています。SNSで使いたいので、背景と絵を分けてください。Twitterに投稿する場合は、#Lumpyillusのタグを使用してくださいありがとうございます〜。\n\n参考：https://drive.google.com/drive/folders/1QnjPnu_MfOcJKatI18fdiqRrXOTkbBPs?usp=sharing", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@togemaru34/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1942247, "client_id": 924110, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/e452498b/uploads/origins/77751df8-a46e-4a39-ba03-5ea58f42085a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9e6937082d3ab28eb59dbaf74d2f1f71", "srcset": "https://si.imgix.net/e452498b/uploads/origins/77751df8-a46e-4a39-ba03-5ea58f42085a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9e6937082d3ab28eb59dbaf74d2f1f71, https://si.imgix.net/e452498b/uploads/origins/77751df8-a46e-4a39-ba03-5ea58f42085a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=d04cf45ea8c35304850bb00e88c0c64e 2x, https://si.imgix.net/e452498b/uploads/origins/77751df8-a46e-4a39-ba03-5ea58f42085a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=596423c5ab2f1c066490f92ec913190e 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/e452498b/uploads/origins/77751df8-a46e-4a39-ba03-5ea58f42085a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=fa98697570ce87a8772c89beef341477", "srcset": "https://si.imgix.net/e452498b/uploads/origins/77751df8-a46e-4a39-ba03-5ea58f42085a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=fa98697570ce87a8772c89beef341477, https://si.imgix.net/e452498b/uploads/origins/77751df8-a46e-4a39-ba03-5ea58f42085a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=83adf218d921eb17713cc2d2e872e63c 2x, https:/