main story or a parody, so please feel free to choose whichever suits your taste.\nWe are not particular about the specific composition or pose, so please feel free to draw it according to your interest.\nIf there are any problems with the material or the amount is missing, please feel free to resend it to us.\nThank you in advance for your convenience.", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@sky90852847/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3500394, "client_id": 3478190, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/b6ac4e01/uploads/origins/b85b5477-6fba-434c-b6d6-28f547ba085b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b6475805a44e27cf4bdc8ec53487e4ce", "srcset": "https://si.imgix.net/b6ac4e01/uploads/origins/b85b5477-6fba-434c-b6d6-28f547ba085b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b6475805a44e27cf4bdc8ec53487e4ce, https://si.imgix.net/b6ac4e01/uploads/origins/b85b5477-6fba-434c-b6d6-28f547ba085b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=d64e175bfcc4ce4623fe980b3781ba80 2x, https://si.imgix.net/b6ac4e01/uploads/origins/b85b5477-6fba-434c-b6d6-28f547ba085b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=862782dca5acd4bfde28dcaf84038457 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/b6ac4e01/uploads/origins/b85b5477-6fba-434c-b6d6-28f547ba085b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2c03231224d2e57a15065b9b36806c06", "srcset": "https://si.imgix.net/b6ac4e01/uploads/origins/b85b5477-6fba-434c-b6d6-28f547ba085b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2c03231224d2e57a15065b9b36806c06, https://si.imgix.net/b6ac4e01/uploads