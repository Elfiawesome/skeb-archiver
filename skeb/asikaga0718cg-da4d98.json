=top&w=200&h=200&blur=200&s=889688df2becde500cbc019a8085bedf 3x"}, "body": "こんにちは、イラストの依頼になります。\n【キャラ】\n白雪千夜と彼女を取り巻くデカ乳アイドル達(ちとせ、Unlock Starbeat、君のステージ衣装、Drastic Melodyのメンバーで誰か)\n【内容】\n金カムのラッコ鍋のパロディで輝子が持ってきたモワァ…とするキノコ鍋をみんなで囲んでな感じで。\n千夜がシライシポジションですかね。\nマンガ形式なのでモノクロで大丈夫です。", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@asikaga0718cg/works/8", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1198880, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/0382baba/uploads/origins/02b5b77e-0998-4359-87f2-dbc3687b396e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f249be97bbecc5cf1c7e1da034dfe341", "srcset": "https://si.imgix.net/0382baba/uploads/origins/02b5b77e-0998-4359-87f2-dbc3687b396e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f249be97bbecc5cf1c7e1da034dfe341, https://si.imgix.net/0382baba/uploads/origins/02b5b77e-0998-4359-87f2-dbc3687b396e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=4bfe672ef1577e75ad3cda2c00afab1a 2x, https://si.imgix.net/0382baba/uploads/origins/02b5b77e-0998-4359-87f2-dbc3687b396e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b254a5eb0bb4d9dfbccb89e73c245328 3x"}, "duration": null, "nsfw": true, "hardcore": true, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/0382baba/uploads/origins/02b5b77e-0998-4359-87f2-dbc3687b396e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=cd1c901c4e2209a52c83708ae0e29758", "srcset": "https://si.imgix.net/0382baba/uploads/origins/02b5b77e-0998-4359-87f2-dbc3687b396e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=cd1c901c4e2209a52c83708ae0e29758, https://si.imgix.net/0382baba/uploads/origins/02b5b77e-0998-4359-87f2-dbc3687b396e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=04fa7de554154a1f7284eab865ade2f0 2x, https://si.imgix.net/0382baba/uploads/origins/02b5b77e-0998-4359-87f2-dbc3687b396e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=021cda05d75373a72c45b22611c8c6c7 3x"}, "body": "春菜ちゃんのイラストが琴線に触れました。是非リクエストさせて下さい。\n\nキャラ：荒木比奈（デレステ）\n衣装：改造セパレートセーラー\n資料URLの衣装をベースに、上着は裾が乳輪の上の方にギリギリかからない程度、スカートは股下数cmでちょっと動けば股間部が見えちゃうくらいというそれぞれ超ミニなドスケベ仕様にして下さい。ネクタイは小さめにして乳房を出来るだけ隠さないようにして貰えると嬉しいです。それ以外はノーパンノーブラでお願いします。\nあと、眼鏡は有りでお願いします！\n姿勢：ベッドに腰かけて脚を開いている状態。片手は後ろ手を付いて身体を支え、もう片方の手でアソコをくぱぁしてる。\nシチュ：恋人同士な比奈とＰのラブホエッチシチュ。\nＰのリクエストでドスケベな衣装に身を包んだ比奈は、ベッドに腰をかけ、余りの露骨な衣装に恥ずかしくなり顔を赤く染めつつも、にんまりと悪戯っぽく笑い「なるほどなるほど、Ｐさんはこういうのが趣味なんスねぇ～、このスケベ♡」と煽りながら誘惑してくる。\n\n描きにくい部分などあれば変更して下さって構いません。\nご検討お願いします。\n\nhttps://item.rakuten.co.jp/piccolino01/1000210/", "nc": 59, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@asikaga0718cg/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1198880, "client_id": 23911, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/1d7b2b0e/uploads/origins/fe383921-b43f-4b1f-b7bf-14648a0d77ba?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f09053c4cf502a1ae2273e794f3447df", "srcset": "https://si.imgix.net/1d7b2b0e/uploads/origins/fe383921-b43f-4b1f-b7bf-14648a0d77ba?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f09053c4cf502a1ae2273e794f3447df, https://si.imgix.net/1d7b2b0e/uploads/origins/fe383921-b43f-4b1f-b7bf-14648a0d77ba?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=7de9e4c1ebd8ae2c351311db6f547c73 2x, https://si.imgix.net/1d7b2b0e/uploads/origins/fe383921-b43f-4b1f-b7bf-14648a0d77ba?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=18139771402810c2e8f8608c508204c2 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_