06/uploads/origins/64af4aab-fcd9-4042-afcb-c6682652ade5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8cc814540e38848d9ff113fff7a086b6, https://si.imgix.net/06b0f006/uploads/origins/64af4aab-fcd9-4042-afcb-c6682652ade5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=3f731fb3c2017c155ee133486588c567 2x, https://si.imgix.net/06b0f006/uploads/origins/64af4aab-fcd9-4042-afcb-c6682652ade5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=87fc19af3165d6edd244b16fd6fe85c4 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/06b0f006/uploads/origins/64af4aab-fcd9-4042-afcb-c6682652ade5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=301a5e457e5d8efbcca31798090ac794", "srcset": "https://si.imgix.net/06b0f006/uploads/origins/64af4aab-fcd9-4042-afcb-c6682652ade5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=301a5e457e5d8efbcca31798090ac794, https://si.imgix.net/06b0f006/uploads/origins/64af4aab-fcd9-4042-afcb-c6682652ade5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=0dd6875d2e2fd76954820df1fc320e01 2x, https://si.imgix.net/06b0f006/uploads/origins/64af4aab-fcd9-4042-afcb-c6682652ade5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=3f714fa4e4f55a6410cff70eff7708f3 3x"}, "body": "こんにちは。Xであなたの作品を見かけ、私のオリジナルキャラクター「カイリ」のイラストをお願いしたいです！あなたのスタイルがとても気に入ったので、可能であれば、彼を複数枚描いていただけると嬉しいです。\n\n彼は真面目で優しい性格ですが、人の空気を読むのが苦手です。恋愛に関してはとても純真で無邪気な、いわゆる「草食系」の男性です。恥ずかしがり屋ですが、彼氏には断ることができません。\n\n*カイリの一重まぶたには特にご注意ください\n\nイラストのうち1枚は、参考リンクにある女装姿にしていただきたいです。それ以外については、メイドやナースなど、女の子らしい服を着た姿を自由に描いてください（メガネはOKですが、ウィッグは不要です！）。以前の投稿で描かれていた女装のシンジがとても気に入ったので、似たようなものを依頼したいです。 彼の照れくさくて可愛い一面をぜひ描いてください。また、脇に彼氏のいたずらっぽい笑顔を簡単なスケッチで添えていただけると嬉しいです。\n\nご検討いただき、本当にありがとうございます！\n\nhttps://drive.google.com/drive/folders/1PaH7TzcjC8MrMZBJ86hixfPYe5RMawFE?usp=drive_link", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@rinami456/works/34", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3975193, "client_id": 2544199, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/3f4a2ba3/uploads/origins/aefef0de-9539-4081-8bda-2757564748fc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f95c3018b700d90d5b93450caf99ddab", "srcset": "https://si.imgix.net/3f4a2ba3/uploads/origins/aefef0de-9539-4081-8bda-2757564748fc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f95c3018b700d90d5b93450caf99ddab, https://si.imgix.net/3f4a2ba3/uploads/origins/aefef0de-9539-4081-8bda-2757564748fc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=da87a04fd0cc79c08cb1e6c6900b3b93 2x, https://si.imgix.net/3f4a2ba3/uploads/origins/aefef0de-9539-4081-8bda-2757564748fc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=3503c5ec3ece8f4d1bd4cdca3e2a0a60 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/3f4a2ba3/uploads/origins/aefef0de-9539-4081-8bda-2757564748fc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=38e58549aca43bc9873edf4cbe086b17", "srcset": "https://si.imgix.net/3f4a2ba3/uploads/origins/aefef0de-9539-4081-8bda-2757564748fc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=38e58549aca43bc9873edf4cbe086b17, https://si.imgix.net/3f4a2ba3/uploads/origins/aefef0de-9539-4081-8bda-2757564748fc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=7a02a658fbad610629baef84cc99a1ec 2x, https://si.imgix.net/3f4a2ba3/uploads/origins/aefef0de-9539-4081-8bda-2757564748fc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=c58a3392beb42516580577d08d9658c1 3x"}, "body": "初めまして！\nXでぷにっとさんの可愛らしくスタイリッシュな絵柄に一目惚れし、是非ともぷにっとさんの作風で男女OCを描いて頂きたくリクエストに参りました。\n\n✧セス（男）\n髪／金髪\n瞳／青、下睫毛\n20歳。188cm。次期国王（現王子）。\n冷酷かつ氷のような男。有能。基本スン…としておりあまり表情が変わらないが、姉の前では言動が少し柔らかい。\n嫉妬深く、姉と誰かが会話していると普通に姉さん。と割り込んでくる。後方腕組み彼氏面もする。\n幼い頃、冷遇されていた自分に関わり続け受け入れてくれた姉にかなり依存している。\n\n✧ミラ（女）\n髪／茶色、インテークの中が桃色\n瞳／緑と桃\n24歳。152cm。王女。\n天真爛漫、ゴーイングマイウェイお姫。人を振り回しがち。\nセスは義理とはいえ初めてできた自分の弟であり、うんと可愛がり、ヨシヨシとしてきた。\nふわふわにこにことしているが、セスが思っているより現実がしっかりと見えている。\n懐に入り込んでから手をすり抜ける女。(全て善から来る行動であるが天使のような悪魔のような…)\n\n服装やポーズ、シチュエーション等の指定はありません。細かな装飾なども省いても、好きにデザインしていただいても構いません！\nぷにっとさんのイラストと世界観が大好きなので、どうか好きなように描いて頂けたらと思います。\nカラー・イラストどちらでも嬉しいです！\n\n使用用途としては個人的な鑑賞に使用したいと考えています。\n何か金額等失礼がありましたら申し訳ありません、もし難しいようでしたら再送して頂けると嬉しいです。\nご検討の程、何卒宜しくお願いします…！\n\nhttps://drive.google.com/drive/folders/1DdZZJURoKDORea2vvUdX2-OTxY3rpHBM?usp=drive_link", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@rinami456/works/33", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3975193, "client_id": 3975804, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/1c9fa478/uploads/origins/2c8cc7fc-c160-4b7e-a8bc-b13de2da7ef9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=95e0d3e85c18d718339aa28b5383f80d", "srcset": "https://si.imgix.net/1c9fa478/uploads/origins/2c8cc7fc-c160-4b7e-a8bc-b13de2da7ef9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=95e0d3e85c18d718339aa28b5383f80d, https://si.imgix.net/1c9fa478/uploads/origins/2c8cc7fc-c160-4b7e-a8bc-b13de2da7ef9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=5a53fce501643eadca14d2aa0afdc8d5 2x, https://si.imgix.net/1c9fa478/uploads/origins/2c8cc7fc-c160-4b7e-a8bc-b13de2da7ef9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=88d3fa8d0cdb2c2a017e926165ec0706 3x"}, "duration": null, "n