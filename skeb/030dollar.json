x.net/5070de66/uploads/origins/09bb033a-e7e3-48fb-baad-aa0554d44d83?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=8e96194708c6064e9e27e6518a66b810 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/5070de66/uploads/origins/09bb033a-e7e3-48fb-baad-aa0554d44d83?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d32b8148673b736ef7eb0026815b6ddf", "srcset": "https://si.imgix.net/5070de66/uploads/origins/09bb033a-e7e3-48fb-baad-aa0554d44d83?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d32b8148673b736ef7eb0026815b6ddf, https://si.imgix.net/5070de66/uploads/origins/09bb033a-e7e3-48fb-baad-aa0554d44d83?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=1452dfe6c3d6875e2db2bbe2d1075c2b 2x, https://si.imgix.net/5070de66/uploads/origins/09bb033a-e7e3-48fb-baad-aa0554d44d83?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=cee0701eedc56e77aa99c9e4819f8382 3x"}, "body": "こんにちは！アピールありがとうございます！あなたの提案通り、私のキャラクターをハロウィンのイラストにしてほしいです！\n\nデザートと紅茶と読書が大好きな内気で優しい女の子です。服装は自由です。フォルダにない服でもOKです！細かいところはお任せします！\n\nまた、彼女の目は、他の絵にあるような白い瞳孔ではなく、下の参考資料のようなものがいいです！あと、ヘアスタイルも長い方がいいです。\n\nよろしくお願いします！\n\n目の参考：https://drive.google.com/file/d/1jg-xaMUHfGPMe6Dw6iOFz4pLi1h-Ubhh/view?usp=drivesdk\n\nhttps://drive.google.com/drive/folders/1SLbTigwVbSumaZwRN9Fio-YOf72HUtQK?usp=drive_link", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@030dollar/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3257356, "client_id": 3432950, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/1814a233/uploads/origins/5a057d69-253f-4625-a3fc-54384eff9742?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bb4bb83cc7b320e341d25cfa884f5fbe", "srcset": "https://si.imgix.net/1814a233/uploads/origins/5a057d69-253f-4625-a3fc-54384eff9742?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bb4bb83cc7b320e341d25cfa884f5fbe, https://si.imgix.net/1814a233/uploads/origins/5a057d69-253f-4625-a3fc-54384eff9742?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=5fc975081b46ef70d29209f6e9d20e73 2x, https://si.imgix.net/1814a233/uploads/origins/5a057d69-253f-4625-a3fc-54384eff9742?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ea57feb752fc99498d5a59339dccb9c6 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/1814a233/uploads/origins/5a057d69-253f-4625-a3fc-54384eff9742?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f07a4fdd9da1a687c7536ee9ee8e7cec", "srcset": "https://si.imgix.net/1814a233/uploads/origins/5a057d69-253f-4625-a3fc-54384eff9742?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f07a4fdd9da1a687c7536ee9ee8e7cec, https://si.imgix.net/1814a233/uploads/origins/5a057d69-253f-4625-a3fc-54384eff9742?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=04592e8f740e59527741a535e588693d 2x, https://si.imgix.net/1814a233/uploads/origins/5a057d69-253f-4625-a3fc-54384eff9742?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=684a30921888c6c39f3a850255ef187f 3x"}, "body": "はん田先生、こんにちは。\n先生の絵柄が本当に大好きです！今回、私のオリジナルキャラクター2人（姉妹）のイラストをお願いしたくご連絡しました。金額が足りない場合は、再度送信できます...！\n\n【❤キャラクター1：新垣有希（姉）】\n・女性、160cm、見た目年齢18～19歳\n・明るく快活で社交的。周囲を元気にする存在です。\n・赤い巻き髪（時々ローマ巻）、赤い目。髪色はオレンジ寄りの赤で、青みや紫みは避けてください。髪の長さはお尻より短く。\n\n【🩵キャラクター2：新垣惠理（妹）】\n・女性、163cm、見た目年齢16～17歳\n・電波系でマイペース。よく自分の世界に浸っていますが、内向的ではありません。\n・青いストレートヘア、赤い目。髪は腰までで柔らかめ、できるだけ跳ねないように。右前髪の下（現代服の場合は任意）に額から下まぶたまでの傷があります（髪で隠れている場合は描写自由）。\n\n【❤🩵キャラクター関係性】\n二人は実の姉妹であり、強い信頼と親密さで結ばれています。互いを支え合い、それぞれにとってかけがえのない存在です。姉妹ならではの自然な距離感と、時に友達のような親しさが特徴です。\n姉妹関係を強調しても、GL風に描いていただいても大丈夫です。\n\n【衣装・デザイン参考】\n衣装やアクセサリーは下記リンクの中から先生が一番好きなものを選んで描いていただければ幸いです。画面の美しさのための小さなアレンジは大丈夫です。\n\n【参考資料リンク】\nhttps://photos.app.goo.gl/osYJSPqCHpGov7JCA\n\n【好きな構図・絵柄例】\n二人のキャラクター両方のイラストをお願いしたいです。今回は二人分のご依頼になります！お一人ずつの単体イラストを2枚、またはお二人一緒のイラスト1枚、どちらの形でも大丈夫です。\nhttps://x.com/030dollar/status/1925523282373353848；https://x.com/030dollar/status/1935625247178576098 の塗り（上色）スタイルがとても好きです。もし可能でしたら、こちらの色味に近い仕上がりにしていただけると嬉しいです。\n具体的なポーズや構図などは、先生にお任せしたいです！自由に描いていただければ嬉しいです！\n\n【用途】\n用途は個人コレクション、SNSアイコンやスマホの壁紙等です。\n\n【納品形式】\nもし可能でしたら、PSD形式のファイルをいただけると嬉しいです。レイヤー分けの細かさにはこだわりませんが、PSDだとより高画質な気がして安心できるので……！\n\n【禁止事項】\nえっちな内容。過度に陰鬱な表情や場面は禁止です。\n\nhttps://photos.app.goo.gl/osYJSPqCHpGov7JCA", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@030dollar/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3257356, "client_id": 3494049, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/529ae74a/uploads/origins/4c6834e6-68fa-4690-9a39-3c57c77265b5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4a5ded2c3ad9dbf3c4c87e14053ccb82", "srcset": "https://si.imgix.net/529ae74a/uploads/origins/4c6834e6-68fa-4690-9a39-3c57c77265b5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4a5ded2c3ad9dbf3c4c87e14053ccb82, https://si.imgix.net/529ae74a/uploads/origins/4c6834e6-68fa-4690-9a39-3c57c77265b5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=886bde43247609f2a54832f575a0bf0f 2x, https://si.imgix.net/529ae74a/uploads/origins/4c6834e6-68fa-4690-9a39-3c57c77265b5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=fcb114693c0fbc42937f0d285d2bcf2f 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/529ae74a/uploads/origins/4c6834e6-68fa-4690-9a39-3c57c77265b5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=67984e17230aebeeee849bb6afa4fee2", "srcset": "https://si.imgix.net/529ae74a/uploads/origins/4c6834e6-68fa-4690-9a39-3c57c77265b5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=67984e17230aebeeee849bb6afa4fee2, https://si.imgix.net/529ae74a/uploads/origins/4c6834e6-68fa-4690-9a39-3c57c77265b5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=ab5c805db1f359728b2f4edc82ea45f1 2x, https://si.imgix.net/529ae74a/uploads/origins/4c6834e6-68fa-4690-9a39-3c57c77265b5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=92b553ce779d1c206057907062012c33 3x"}, "body": "はん田 様\n\n先生に私の設定を気に入っていただけてとても嬉しいです！！\n今回のご依頼が先生にとって楽しい制作になりますように！！\nこんにちは！アナイと申します。\n\nはん田様の作品の大ファンで、ぜひ私の活動用にイラストをご依頼させていただきたいと思っております。\nこのイラストはサムネイルなどに使用する予定ですので、頭部周辺はカットせず、全体が映る構図でお願いできれば幸いです。\n\nキャラクターの衣装については、以下のクラウドリンクにある画像をご参照ください。\n本当にありがとうございます！\n\nご多忙のところ恐縮ですが、今回のご依頼をご検討いただけますと幸いです。\n\n---\n\n【構図について】\n夏に向けて、水着の衣装（紫のギンガムチェック）を考えています。\nでも、先生のTwitter投稿（https://x.com/030dollar/status/1803364973948837980）の雰囲気もすごく好きです！\nまた、もしよろしければ、今後公開予定の私の3.0衣装を参考にしていただいても大丈夫です！！\n\n【使用用途】\nYouTubeのサムネイル、プロモーション用イラスト、X（Twitter）、動画内での使用\n\n【キャラクター資料】\nhttps://drive.google.com/drive/folders/1u2-tAZuzvWm4cF0b4Q_nX7YroVE-qUOa?usp=drive_link\nhttps://drive.google.com/drive/folders/1QVDYbNnZaGj1hW5gh09Ivq61YvtgF6eM?usp=drive_link\n\nこのたびご依頼の機会をいただけてとても嬉しく思います。\nぜひよろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/1u2-tAZuzvWm4cF0b4Q_nX7YroVE-qUOa?usp=drive_link\n\nhttps://drive.google.com/drive/folders/1QVDYbNnZaGj1hW5gh09Ivq61YvtgF6eM?usp=drive_link", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@030dollar/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3257356, "client_id": 3346073, "vt