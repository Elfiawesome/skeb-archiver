uto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=1d79bf1cd8c9c66f3055f441577be6cc, https://si.imgix.net/b4aa56f4/uploads/origins/4557e6b7-3fb8-4df3-a1b1-cc817ef6d5a4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=c23010fd7508c9912f4efcbda702b751 2x, https://si.imgix.net/b4aa56f4/uploads/origins/4557e6b7-3fb8-4df3-a1b1-cc817ef6d5a4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=e453691562a2c73c5a0fc22f7df135a9 3x"}, "body": "はじめまして。いつもイラストを拝見してます。リクエスト募集中とのことで依頼させていただきます！\n\n【キャラクター】「ティンクルスターナイツ」より　白楯アム  \n\n【シチュエーション】\n白楯アムとイチャラブキスハメ尻揉み対面座位\n\n【服装】\n・体操服フォーム(ブルマ)\nただしほぼ全裸\n\n【構図】\n・アムが上の対面座位\n・舌を出し合う密着ベロキス\n・片手で大きなお尻を揉んでいる\n・それ以外の手は腕を回して密着している\n・お尻がよく見える構図顔まで見えるように\n・お尻をかなり大きめに描いてください\n・竿役は目は描かないエロゲ主人公\n・ラブラブな感じで\n\n【場所】\n・屋内:体育倉庫 マットの上など\n・屋外:木の茂みの中 ベンチなど\nどちらか好みで\n\nセリフはなし 擬音や喘ぎ声はありでお願いします\n1枚目　挿入　普通のキス\n2枚目　ピストン　ベロキス\n3枚目　中出し\n(んんんん゛〜！？お゛っ♡のような喘ぎ声に少しオホ声が漏れ出てる感じで)\n\n(枚数が多いので金額を上乗せしていますが希望があれば再申請をいたします)\n\n【備考】\n体操服のデザインはカティアを参考にしてください　ブルマは青色でお願いします\n\nその他の部分に関してはお任せします\n\nご検討のほどよろしくお願いします\n\nhttps://twinklestarknights.wikiru.jp/?%EF%BC%BB%E5%85%83%E6%B0%97%E6%BA%8C%E5%89%8C%E2%98%86%E7%9B%BE%E4%B9%99%E5%A5%B3%EF%BC%BD%E3%82%A2%E3%83%A0", "nc": 169, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@IllustAlsy/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3905997, "client_id": 2137364, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/c0165305/uploads/origins/af916a44-d108-4544-b071-8758a07febdc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=01aeadaf78afad4372eaa526694b975f", "srcset": "https://si.imgix.net/c0165305/uploads/origins/af916a44-d108-4544-b071-8758a07febdc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=01aeadaf78afad4372eaa526694b975f, https://si.imgix.net/c0165305/uploads/origins/af916a44-d108-4544-b071-8758a07febdc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=1c91424934e939a7c871110791855afb 2x, https://si.imgix.net/c0165305/uploads/origins/af916a44-d108-4544-b071-8758a07febdc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=56d2a709cf06f796ce065e3a74c050e0 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/c0165305/uploads/origins/af916a44-d108-4544-b071-8758a07febdc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=78415c1b696240faf36fc2688ed6c9f0", "srcset": "https://si.imgix.net/c0165305/uploads/origins/af916a44-d108-4544-b071-8758a07febdc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=78415c1b696240faf36fc2688ed6c9f0, https://si.imgix.net/c0165305/uploads/origins/af916a44-d108-4544-b071-8758a07febdc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=e043a8d77d67d2ecf4df147152332065 2x, https://si.imgix.net/c0165305/uploads/origins/af916a44-d108-4544-b071-8758a07febdc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=8a49a557d8f652a2936b5348975ba241 3x"}, "body": "こんにちは。\n\n早速ですが二次創作の依頼をさせていただきます。 \n対応可能でしたら御願い致します。\n\n\n【作品名】\nティンクルスターナイツ\n\n\n【対象キャラクター】\n桜十路 エルデリーゼ\n\n\n【対象キャラクターのキャラ設定について】\nお金持ちのお嬢様で、箱入り娘として大切に育てられた清楚系な少女です。\n今まで屋敷に籠って育ったため世間知らずで、作品の舞台となる学園で初めて外の世界を見た為か、好奇心旺盛な性格です。\n尚、物語の主人公とは年下(主人公は学園2年生(＝高校生相当)で、エルデリーゼは学園よりも若い生徒たちが通う附属校の3年生(＝中学生相当))なキャラクターです。\nまた、エルデリーゼの個別シナリオでは主人公と恋仲の関係であったりします。\n\n\n【服装】\n白のスクール水着\n\n\n【胸の大きさ】\n絶壁であり膨らみがほぼ無いです\n\n\n【シチュエーション】\n１．プールの隅に座っている or 立っているエルデリーゼが後ろから主人公であるクロト(エルデリーゼと恋仲な関係)に胸と股を愛撫され気持ち良くなっているイラストを描いて下さい。\n\n２．気持ち良くなっているエルデリーゼが可愛く絶頂しつつおしっこしているシーンも描いて下さい。\n\n３．エルデリーゼの全身を描いてください。尚、クロトは見切れていて問題ないです。\n\n\n【備考】\n可能ならば全身が見える感じの構図でお願いします。\nその他の構図等はお任せします。\nもし金額・工数に見合わなかったり、シチュエーション等で内容が描きずらい等あれば「再送依頼」もしくはキャンセルまたは、Alsy様の裁量で変更・アレンジしてOKです。\n\n\n対応可能でしたら何卒よろしく御願い致します。\n\nhttps://drive.google.com/drive/folders/101Mx-2tLlIuO9EnHNG9NR0hQOM6csDYG?usp=sharing", "nc": 184, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@IllustAlsy/works/1", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/cba0c7e2/uploads/origins/e28b7be7-60c5-42c7-a2a5-146c854b803f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=2f85093fcc0ffb42dda6652c55af0394", "srcset": "https://si.imgix.net/cba0c7e2/uploads/origins/e28b7be7-60c5-42c7-a2a5-146c854b803f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=2f85093fcc0ffb42dda6652c55af0394, https://si.imgix.net/cba0c7e2/uploads/origins/e28b7be7-60c5-42c7-a2a5-146c854b803f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=6ccadf94b11a52ff2e96f9a6eb03af34 2x, https://si.imgix.net/cba0c7e2/uploads/origins/e28b7be7-60c5-42c7-a2a5-146c854b803f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=4f6d27aa3421354866187acfad7e964d 3x"}, "private": true, "genre": "art", "tipped": true, "creator_id": 3905997, "client_id": 3730852, "nc": 176}], "sent_works": [], "similar_creators": [{"id": 11496, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "サクマ伺貴@初DL漫画制作中！", "screen_name": "nananananahush1", "avatar_url": "https://pbs.twimg.com/profile_images/1951682890133356545/jbDyEiJE.jpg", "header_url": "https://pbs.twimg.com/profile_banners/759642891933200384/1754152532/1500x500", "appeal_receivable": true, "popular_creator_rank": null, "request_mas