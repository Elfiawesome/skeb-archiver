e68f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5469aa196bf434cbbb747f9f63832848, https://si.imgix.net/eb5555fb/uploads/origins/388dd129-27d4-4548-89fb-df9c3c59e68f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=f61f86958377cb5b3b89586f04bb7837 2x, https://si.imgix.net/eb5555fb/uploads/origins/388dd129-27d4-4548-89fb-df9c3c59e68f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=a286872417ddba8a72481871293ec29b 3x"}, "body": "スチルさんこんばんは。\nスチルさんの画風でうちのキツネっ仔（レンシア）をお願いしたいと思い依頼させて頂きました。\n身体全体が入るポーズ（応援している体勢でなくても下記団服を着用していればOKです）、背景などおまかせしますがへそチラもしくは見えている希望です。\n\n【レンシアの特徴】\n・鼻先ではなく鼻元が毛色の境\n・耳先の毛が垂れている\n・額に水色の模様あり\n・手の指は5本、足の指は３本\n・手や足は薄い茶色\n・設定年齢は１０歳〜１２歳\n\n【装束】\n・学ラン（フロントは空いていてもとじていてもOKです、ボタンの数、色合いなどは調整して頂いて構いません）\n・学ランの襟に水色のストライプが入ります、左腕上に赤の肉球マーク入り腕章をつけてます\n・白の長鉢巻き、タスキを身につけてます\n※肉球表現お願いしたいので手袋や足袋は無しでもOKです\n・赤の褌は六尺褌\n\n手書きですが資料を下記URLにアップしています。\nイラストの用途としてはアクキーやステッカーを予定しています。\nご検討のほどよろしくお願いします。\n\nhttps://drive.google.com/drive/folders/1zWJeC27_6i-xf5V4ExZgz26QrnRbyw7m?usp=sharing", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@pow_japan/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 25469, "client_id": 3020200, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/2cbe8efd/uploads/origins/1580e110-d7e1-4507-a62f-732b377b4f06?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8c871b546ebea65cf352b98fb7e1f28b", "srcset": "https://si.imgix.net/2cbe8efd/uploads/origins/1580e110-d7e1-4507-a62f-732b377b4f06?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8c871b546ebea65cf352b98fb7e1f28b, https://si.imgix.net/2cbe8efd/uploads/origins/1580e110-d7e1-4507-a62f-732b377b4f06?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=077ec2076c37d47d3825b5fdb283b