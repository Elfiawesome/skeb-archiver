oogle.com/drive/folders/1df_sbFwZbiX9FCtFPY3YKdBR7avoR1Rg\n\n【使用用途】\n酔眠はやね様ご本人によるX・YouTubeなどWEB上でのプロモーション活動(収益化済チャンネルでのサムネイル使用等)\n\n【お願い】\n上記の使用用途に付随して、宛名・人物・背景(加えて可能であれば差分）等をレイヤー別にしたPSD形式でお願いできれば非常にありがたいです。 難しい場合はPNG形式での納品をお願い致します。\nまた、頭部や髪などが見切れないようにしていただければ幸いです。\n構図、シチュエーション等はお任せします。\n\nお忙しい中お手数をおかけしましすが、何卒よろしくお願い致します。", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 724021, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "月夜星海@営業垢", "screen_name": "hosi_huru_yoru2", "avatar_url": "https://pbs.twimg.com/profile_images/1925174105722269696/TocqU8ck.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1213468467191377923/1733499922/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "art"}], "banned": false, "nc": 161}, {"id": 946163, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "燈ともす@男装VTuber", "screen_name": "akaritomosu_", "avatar_url": "https://pbs.twimg.com/profile_images/1901312962964647936/JuZoPX4w.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1291881165687623680/1749824849/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 70, "skills": [{"genre": "art"}, {"genre": "comic"}, {"genre": "voice"}], "banned": false, "nc": 129}, {"id": 2669698, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "A_aru 【×🧸×】有償依頼❌", "screen_name": "A_aru__", "avatar_url": "https://pbs.twimg.com/profile_images/1792537445332041728/VFLf-S9A.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1142342102761656320/1633093817/