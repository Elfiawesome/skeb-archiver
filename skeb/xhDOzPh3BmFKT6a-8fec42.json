h=200&s=b2392de7069faa8e836628cd92cddf0a", "srcset": "https://si.imgix.net/01a821ff/uploads/origins/4bc2b4a3-dbca-420d-85be-ee3e1c4d0e8e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b2392de7069faa8e836628cd92cddf0a, https://si.imgix.net/01a821ff/uploads/origins/4bc2b4a3-dbca-420d-85be-ee3e1c4d0e8e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=cad4ed7ef510384ab7fa034fec5491cb 2x, https://si.imgix.net/01a821ff/uploads/origins/4bc2b4a3-dbca-420d-85be-ee3e1c4d0e8e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=fcf622ab655b421525499f79b462a1a2 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/01a821ff/uploads/origins/4bc2b4a3-dbca-420d-85be-ee3e1c4d0e8e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=499954ec454b125e30927fc844f1ab5c", "srcset": "https://si.imgix.net/01a821ff/uploads/origins/4bc2b4a3-dbca-420d-85be-ee3e1c4d0e8e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=499954ec454b125e30927fc844f1ab5c, https://si.imgix.net/01a821ff/uploads/origins/4bc2b4a3-dbca-420d-85be-ee3e1c4d0e8e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=2860bac96ea3b3a81146c6f7123e4cde 2x, https://si.imgix.net/01a821ff/uploads/origins/4bc2b4a3-dbca-420d-85be-ee3e1c4d0e8e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=69829764791642abf980b1f04b6b8648 3x"}, "body": "初めまして。\nイラストの可愛い学生達に惹かれましてリクエスト可能でしたらお願いします。\nイラスト2枚にて希望。\n\n女子生徒は制服着用で半袖ブラウスにリボン(又はネクタイ)スカート。\n※スカートは短い子だったり規定の長さの子だったり\n女子生徒はそれぞれ髪型や体型等変えていただき、性格や雰囲気もバラバラでお願いします。\n※明るそうな子だったり、ケツバットが初めての大人しい性格の子等\n\n「内容」\n昔学校で見た光景で印象に残ったシーンをお願いします。\n学校で厳しい先生がいて男子でも泣くぐらい痛いケツバットを女子にもしている様子。\n\n教室の黒板(背景)の横隅で縦にずらっと3〜4人ぐらい縦に列を作り並んでケツバットの順番を待っている様子。\n両手を胸に手を当ててドキドキしたり、恥ずかしそうに顔を赤らめながら待っていたり、横から顔出して怯えながら待っていたり。\n\nそして黒板の前では1人女子生徒がケツバットを喰らった直後で、両手でお尻を摩りながらスカートをくしゃくしゃさせてめちゃくちゃ痛がっている様子。\n※先生は居ることが分かれば大丈夫です。\n\n2枚目は実際にケツバットをされてる女子の様子。\nスカートにめり込むぐらいの勢いで必死に耐えている様子。\n\nイラスト上、表現等難しい場合は無理せずで大丈夫ですのでご検討お願いします。", "nc": 49, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@xhDOzPh3BmFKT6a/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "comic", "tipped": true, "creator_id": 1795681, "client_id": 12249, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/25b5ffe0/uploads/origins/e2d0383e-eb1e-4f94-9476-b504f4f20860?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e94b2e35ffd214ffb50240eff329f0c3", "srcset": "https://si.imgix.net/25b5ffe0/uploads/origins/e2d0383e-eb1e-4f94-9476-b504f4f20860?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e94b2e35ffd214ffb50240eff329f0c3, https://si.imgix.net/25b5ffe0/uploads/origins/e2d0383e-eb1e-4f94-9476-b504f4f20860?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c41096225175d55cd22ecdb1c7865e58 2x, https://si.imgix.net/25b5ffe0/uploads/origins/e2d0383e-eb1e-4f94-9476-b504f4f20860?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=8853d833c13ccdc3976f46065bdac9ac 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/25b5ffe0/uploads/origins/e2d0383e-eb1e-4f94-9476-b504f4f20860?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d5bdc1656c7279898a3e1f4833bcec2b", "srcset": "https://si.imgix.net/25b5ffe0/uploads/origins/e2d0383e-eb1e-4f94-9476-b504f4f20860?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d5bdc1656c7279898a3e1f4833bcec2b, https://si.imgix.net/25b5ffe0/uploads/origins/e2d0383e-eb1e-4f94-9476-b504f4f20860?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=c480ec4a6bc6547a442b038453933e78 2x, https://si.imgix.net/25b5f