=crop&crop=top&w=200&h=200&blur=200&s=441fe37eed5617d2ba443a0b022c1a5f 2x, https://si.imgix.net/a8904e56/uploads/origins/8e885d54-7c83-4d08-953d-ad7175abe888?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=36f65b6d75acbb92f3420ef49caf7f4b 3x"}, "body": "先生、はじめまして。\n先生の描かれる肉感とチンポが素敵だなと日々拝見させていただいております。。\n\n良ければうちのコも、デカいふたなりで描いて頂けないでしょうか？\n（URLに資料がございます、お好きな方を選んでいただければと思います）\n\n当方、爆～超根、複根　大好きです\n先生の描ける限りデカいチンポと玉で描いていただければと思います\n\n服はなしか、描きやすいようアレンジしていただいて大丈夫です\n体型なども指定いたしませんので、お好きに盛っていただいたりしても構いません\n\nご検討のほど、よろしくお願いします\n\nhttps://sites.google.com/view/mast-my-charactors/home", "nc": 160, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@q10chokka/works/7", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/cb78a7e8/uploads/origins/3d2f4ee3-a10b-40b9-82b4-d9d7d6cc79f9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=8fe804624ef75dfadc8717ad43c53780", "srcset": "https://si.imgix.net/cb78a7e8/uploads/origins/3d2f4ee3-a10b-40b9-82b4-d9d7d6cc79f9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=8fe804624ef75dfadc8717ad43c53780, https://si.imgix.net/cb78a7e8/uploads/origins/3d2f4ee3-a10b-40b9-82b4-d9d7d6cc79f9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=a717e406c91836160b974ac6c1ffc1f1 2x, https://si.imgix.net/cb78a7e8/uploads/origins/3d2f4ee3-a10b-40b9-82b4-d9d7d6cc79f9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=b60acb478330ca67eb7df345deef32fe 3x"}, "private": true, "genre": "art", "tipped": true, "creator_id": 2592230, "client_id": 3616533, "nc": 33}, {"path": "/@q10chokka/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2592230, "client_id": 448556, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/fe5f5eb1/uploads/origins/dc7b136b-033f-43b4-935a-29a8ecb1b6cd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bc25a7955f3c5d62e15979981193761c", "srcset": "https://si.imgix.net/fe5f5eb1/uploads/origins/dc7b136b-033f-43b4-935a-29a8ecb1b6cd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bc25a7955f3c5d62e15979981193761c, https://si.imgix.net/fe5f5eb1/uploads/origins/dc7b136b-033f-43b4-935a-29a8ecb1b6cd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=8c1cc318e59eb90f0cc5fc89ce2aa12a 2x, https://si.imgix.net/fe5f5eb1/uploads/origins/dc7b136b-033f-43b4-935a-29a8ecb1b6cd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=9e28283759af0e02a1a8b3f566459d24 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/fe5f5eb1/uploads/origins/dc7b136b-033f-43b4-935a-29a8ecb1b6cd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=7d39aaef99860b5d0f70b45288e542d7", "srcset": "https://si.imgix.net/fe5f5eb1/uploads/origins/dc7b136b-033f-43b4-935a-29a8ecb1b6cd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=7d39aaef99860b5d0f70b45288e542d7, https://si.imgix.net/fe5f5eb1/uploads/origins/dc7b136b-033f-43b4-935a-29a8ecb1b6cd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=6478cf5717a753e8b1172bcb4018218a 2x, https://si.imgix.net/fe5f5eb1/uploads/origins/dc7b136b-033f-43b4-935a-29a8ecb1b6cd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=852c6999f7431d9617c3750a06c80df4 3x"}, "body": "はじめまして。依頼につき、ご検討いただけますと幸いです。\nポリニアン巨根少年を描いていただきたいと思います。\n\n描いてほしいキャラクター\n・ルーシ：ポリニアンという種族の巨根少年（キャラ設定は私のオリジナル）\n参考資料：https://www.dropbox.com/scl/fo/maysyz0eovzbf39eewhxv/AGhze9wAIBJP0BBj1aWQMi8?rlkey=8dif708y7aq3npbcy8ea9nz5h&st=xjkhx10g&dl=0\n\n上記DropBoxに以下の資料が入っています。\nルーシのキャラクター設定（資料01）、種族の特徴（資料02）\nルーシのフィギュア参考資料（フォルダ03）\n過去依頼イラスト（フォルダ04）\n\nルーシはズル剥け巨根な少年で、エロ漫画時空の竿役的ポジションです。\n今回描いてほしいのは、資料01内にある水着の姿です。\nかっこよく、海でナンパしているイメージのイラストを描いてほしいです。\nポーズ・シチュエーションのイメージは、巨根を武器に、オナホになる相手を探しているイメージです。\n水着の紐を少し持ち上げることで、巨根モッコリを揺らしながら、\n「オレ、ちんぽには自信あるんだよね。あっちの岩陰行かねぇ？」っと言っているシチュ。\n背景は不要、指定がないところはお任せです。\n\nちんぽは勃起しておらず、竿の７割はしっかり水着に仕舞われていますが、通常時でもデカイ、太いがわかる感じ。\nあなたのイラストで言えば、こちら（https://x.com/q10chokka/status/1667560699256778752）のように感じ。\nただし、タマよりは竿部分の方がデカい感じ、かつ亀頭の形が浮き出るようにお願いします。\n竿の根本付近が水着に仕舞われていない感じで、その部分は色素沈着が進んだドス黒ペニスが覗いている。\n（ルーシの灰色の肌と比べても黒い、人間でいう黒人ペニスみたいなのが生えています）\nなお、タマは水着に仕舞われていてもOK、入ってなくてもOK（その場合は竿だけが水着に入っている）です。\nそこは好みでデザインしてください。\n\nグレースキンや関節球体など、普通の子とは違う特徴持ちですが、何卒ご検討よろしくお願いいたします。", "nc": 160, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@q10chokka/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2592230, "client_id": 109229, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/1e6b0112/uploads/origins/a218cecd-f68f-44da-a42b-67ca21dfc10c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=05d1edfb501751f577e112fc5df33de1", "srcset": "https://si.imgix.net/1e6b0112/uploads/origins/a218cecd-f68f-44da-a42b-67ca21dfc10c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=05d1edfb501751f577e112fc5df33de1, https://si.imgix.net/1e6b0112/uploads/origins/a218cecd-f68f-44da-a42b-67ca21dfc10c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=33e2b74a80e700daed5026bd917e44c1 2x, https://si.imgix.net/1e6b0112/uploads/origins/a218cecd-f68f-44da-a42b-67ca21dfc10c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&