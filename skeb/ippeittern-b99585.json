て、右上を見上げながら考え込んでいる」\nこのポーズの吉野一平を描画頂きたく思っております。\n\nとはいえ、金額と労力が見合っていないとも思いますので\n割に合わないと感じられましたら、ご遠慮なくお断り下さい。\n\nまた、本イラストをサムネイル等に使用したく思っているのですが\n不可の場合はイラスト内別レイヤー等にその旨をご記載頂けますと幸いです。\n\n尚、元イラストの刀は今回のイラストには不要ですが\n服装、髪型、メガネ、首掛けヘッドホンはトレードマークの為\n維持して頂けますと幸いです。\n\nまた、金額が金額なのと、お忙しいとも思いますので\n下半身の描画がご負担に感じられる場合は\nバストアップ（腕の描画はお願い致します）でも問題ありません。\n\nこれからも応援しております。\nご検討宜しくお願い致します。\n\n\n吉野一平\n\nhttps://www.wakyoku.com/ippeipic.zip", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@k02_no/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2754010, "client_id": 728887, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/1e31010b/uploads/origins/0785e115-eed2-4c3b-b07f-33c72b6b5164?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0a2971cf7589f4315f4a2eaef3fea3e3", "srcset": "https://si.imgix.net/1e31010b/uploads/origins/0785e115-eed2-4c3b-b07f-33c72b6b5164?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0a2971cf7589f4315f4a2eaef3fea3e3, https://si.imgix.net/1e31010b/uploads/origins/0785e115-eed2-4c3b-b07f-33c72b6b5164?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=71c95ddd010018fb0dac981d533a0ee3 2x, https://si.imgix.net/1e31010b/uploads/origins/0785e115-eed2-4c3b-b07f-33c72b6b5164?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=9b8273b7bb53083b4d07a4ce71c68543 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/1e31010b/uploads/origins/0785e115-eed2-4c3b-b07f-33c72b6b5164?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=56891ee003a5b6c0c5312284e5600d5d", "srcset": "https://si.imgix.net/1e31010b/uploads/origins/0785e115-eed2-4c3b-b07f-33c72b6b5164?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=56891ee003a5b6c0c