mgix.net/2af1ca58/uploads/origins/630d904a-0f66-4161-8355-4d9216d54d98?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=915e60d21e026ac8b58d5be47f9d6d93", "srcset": "https://si.imgix.net/2af1ca58/uploads/origins/630d904a-0f66-4161-8355-4d9216d54d98?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=915e60d21e026ac8b58d5be47f9d6d93, https://si.imgix.net/2af1ca58/uploads/origins/630d904a-0f66-4161-8355-4d9216d54d98?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=5a1f15952de4c73bfe1b0d8e87ec282f 2x, https://si.imgix.net/2af1ca58/uploads/origins/630d904a-0f66-4161-8355-4d9216d54d98?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=bf24411a7a9d5c2f25ea42c9208786e5 3x"}, "body": "Hello!! Im an ENVtuber who is looking to get art of my model and her mecha buddy Twinspin!! The girls name is Wyllow and she is a spunky silly, and stinky mecha mechanic who is friends with the Mecha Twinspin. \n\nhttps://imgur.com/a/vIU1ZD2\n\nHere is links to them!\n\nI did the art for the refs so if you have any questions just let me know :)!!\n\nI wanted to get art of them for my new model! I dont have an exact ref as Ive found it hard to find any mech/human refs, I was thinking her on his shoulder with them both looking at the camera. But im not picky and anything you think is cool im down with :D!", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@birdws_tf/works/9", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1331886, "client_id": 3575409, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/571343a5/uploads/origins/bb985ce9-5b7e-49e2-8345-b2caa7aca457?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9441a78d6505c68700bf708c2556bcd9", "srcset": "https://si.imgix.net/571343a5/uploads/origins/bb985ce9-5b7e-49e2-8345-b2caa7aca457?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9441a78d6505c68700bf708c2556bcd9, https://si.imgix.net/571343a5/uploads/origins/bb985ce9-5b7e-49e2-8345-b2caa7aca457?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=bf103a16bb5a772d2677212200d427d8 2x, https://si.imgix.net/571343a5/uploads/origins/bb985ce9-5b7e-49e2-8345-b2caa7aca457?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=55e4b73c3c14bf9d10b2d9356c158851 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/571343a5/uploads/origins/bb985ce9-5b7e-49e2-8345-b2caa7aca457?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=68653da0c438316c62c6605c553daf73", "srcset": "https://si.imgix.net/571343a5/uploads/origins/bb985ce9-5b7e-49e2-8345-b2caa7aca457?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=68653da0c438316c62c6605c553daf73, https://si.imgix.net/571343a5/uploads/origins/bb985ce9-5b7e-49e2-8345-b2caa7aca457?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=ea9d7a7df198d31cedb01b6aa2912a76 2x, https://si.imgix.net/571343a5/uploads/origins/bb985ce9-5b7e-49e2-8345-b2caa7aca457?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=dff30e6a8272d1c6781a0957cb87a9dc 3x"}, "body": "こんにちは、トーリさん！またリクエストを受け付けてくださって、本当に嬉しいです！\n\n私のMTMTE（オリジナルキャラクター）の「ロビン」と、MTMTEのドリフトのイラストをお願いしてもいいでしょうか？二人が一緒にいる、温かくて、ちょっとロマンチックな雰囲気のイラストを希望しています。 OCはドリフトと一緒にいると嬉しくて照れくさそうで、ドリフトは礼儀正しく、でも彼女に対しては遊び心のある態度で接しています。\n\nこのリクエストについては、お好きなように描いていただいて構いません！二人が触れ合っていたり、話していたり、あるいはドリフトがOCを守っているようなシーンでも構いません。二人の体格差は必須ではありませんが、私は体格差のある描写が好きです。 \n\nドリフトの参考画像（あなたのページから例を借用しました！ドリフトはシーズン1の姿です！） - https://x.com/birdws_tf/status/1974687320059367684?s=20\n\nオリジナルキャラクター（OC）の参考画像（デザインを少し変更しました） - https://x.com/mouseycometz/status/2070551296201937205?s=20\n\nオリジナルキャラクター（参考）（あなたが以前描いた彼女のイラストです。） - https://x.com/mouseycometz/status/2055422429346902332?s=20\n\nご注意：OCの胸のサイズが小さくなりました。Aカップです。小柄なキャラクターです！デザイン変更で特に重視してほしいのは、この点だけです！それ以外は、茶色と赤が混ざった髪と緑の目のままです。また、ウサギのコスチュームではなく、新しい衣装姿で描いていただけると嬉しいです！\n\nいつも通り、私のリクエストをご検討いただき、本当にありがとうございます！\n\nhttps://x.com/mouseycometz/status/2070551296201937205?s=20", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@birdws_tf/works/8", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1331886, "client_id": 3575409, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/c3774377/uploads/origins/0ed97685-e497-43d0-9539-f21f5697a3d6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f0f2e3ec1245030e05f94a688cf08d99", "srcset": "https://si.imgix.net/c3774377/uploads/origins/0ed97685-e497-43d0-9539-f21f5697a3d6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f0f2e3ec1245030e05f94a688cf08d99, https://si.imgix.net/c3774377/uploads/origins/0ed97685-e497-43d0-9539-f21f5697a3d6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=3e9e554b7e5a9b60081e9238e99e4b45 2x, https://si.imgix.net/c3774377/uploads/origins/0ed97685-e497-43d0-9539-f21f5697a3d6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=1d4548da7ae6e00cb833a9d8b523f425 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/c3774377/uploads/origins/0ed97685-e497-43d0-9539-f21f5697a3d6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=4be2a42274bd0fc285a99a2049a84fd5", "srcset": "https://si.imgix.net/c3774377/uploads/origins/0ed97685-e497-43d0-9539-f21f5697a3d6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=4be2a42274bd0fc285a99a2049a84fd5, https://si.imgix.net/c3774377/uploads/origins/0ed97685-e497-43d0-9539-f21f5697a3d6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=e9884542d4b2fc7ab44def646dc38791 2x, https://si.imgix.net/c3774377/uploads/origins/0ed97685-e497-43d0-9539-f21f5697a3d6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=e7de6ffc75b259e76f7b6770fc1d0e9a 3x"}, "body": "こんにちは、トリ！マウジーだよ！『変身ロボット』シリーズのスカイバイト／ゲルシャークと、僕のオリジナルキャラクター（OC）のイラストを描いてもらえないかな？OC参考画像：https://x.com/mouseycometz/status/1982528823716376700?s=20\nOCとスカイバイト：https://x.com/mouseycometz/status/1953918832751341646?s=20OCとスカイバイト（別バージョン）：https://x.com/mouseycometz/status/1930343275623288844?s=20\n\nOCは思いやりのある女性です。彼女の名前はオフェリアで、スカイバイトは彼女に夢中です。オフェリアは整備士でサーファーです。スカイバイトは強がっていますが、オフェリアを慕わずにはいられません！お二人の描写は自由にお任せします。オフェリアにからかわれてスカイバイトが赤面している様子も素敵ですね！可能であればサイズ差も表現していただけると嬉しいです！ 参考資料ではサイズ差が極端ではないので、あまり気にしすぎないでください！ご依頼を検討いただき、誠にありがとうございます！\n\nhttps://x.com/mouseycometz/status/1982528823716376700?s=20", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@birdws_tf/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1331886, "client_id": 3575409, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/0a8cf65e/uploads/origins/690f0fba-4ede-47c5-a5c2-9c0ec19bf188?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=98d8e48e2e69af0f3449004e8377ade1", "srcset": "https://si.imgix.net/0a8cf65e/uploads/origins/690f0fba-4ede-47c5-a5c2-9c0ec19bf188?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=98d8e48e2e69af0f3449004e8377ade1, https://si.imgix.net/0a8cf65e/uploads/origins/690f0fba-4ede-47c5-a5c2-9c0ec19bf188?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=04ff3ad55d5c4201080520c963b56c0c 2x, https://si.imgix.net/0a8cf65e/uploads/origins/690f0fba-4ede-47c5-a5c2-9c0ec19bf188?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=2784b640af3b68a52ea5bf50b3eca34b 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/0a8cf65e/uploads/origins/690f0fba-4ede-47c5-a5c2-9c0ec19bf188?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c4b561a357ed7361323cfc6f1c7ef53d", "srcset": "https://si.imgix.net/0a8cf65e/uploads/origins/690f0fba-4ede-47c5-a5c2-9c0ec19bf188?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c4b561a357ed7361323cfc6f1c7ef53d, https://si.imgix.net/0a8cf65e/uploads/origins/690f0fba-4ede-47c5-a5c2-9c0ec19bf188?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=35678e689d46c5ba2c9b849b177cc2d6 2x, https://si.imgix.net/0a8cf65e/uploads/origins/690f0fba-4ede-47c5-a5c2-9c0ec19bf188?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=4efab57361b9dd3dd9770461932cbc01 3x"}, "body": "こんにちは、トリさん！ネズミです！ちょっと変わったお願いをしに来ました。\n\nロビン（人間のMTMTE OC）がSwerve's Barにいるシーンをイラストにしてくれませんか？バニースーツを着ています。彼女は一人でも、スワーブ、テールゲート、スキッズなど、バーに来るのが好きな他のボットと一緒でも構いません。私はあなたの選択にこだわりません。描きたいキャラクターを選んでください！\n\n私のOCであるロビンは、特にほろ酔い加減の時はいつも優しくてノリがいい。特にほろ酔い加減の時はいつも、優しくてノリがいい！\n\nSwerveのバーの参考：https://x.com/mouseycometz/status/1998974574365708450?s=20\nOCのリファレンス：https://x.com/mouseycometz/status/1985409416900817264?s=20\n\nロビンは小柄！ロビンは小柄で、茶色の髪に緑色の目。靴はどんな色のヒールでもOK！\n\nこのイラストはシンプルに仕上げていただいて結構です！背景は必要ありません！どのようなイラストでも構いません！\n\nお読みいただきありがとうございました！\n\nhttps://x.com/mouseycometz/status/1985409416900817264?s=20", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@birdws_tf/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1331886, "client_id": 513261, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/c242ea16/uploads/origins/d67ddcf0-8840-4b19-a8fa-fa01d7dfd84c?bg=%23fff&auto=format%2Cco