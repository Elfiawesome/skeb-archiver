.net/c3774377/uploads/origins/0ed97685-e497-43d0-9539-f21f5697a3d6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=4be2a42274bd0fc285a99a2049a84fd5", "srcset": "https://si.imgix.net/c3774377/uploads/origins/0ed97685-e497-43d0-9539-f21f5697a3d6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=4be2a42274bd0fc285a99a2049a84fd5, https://si.imgix.net/c3774377/uploads/origins/0ed97685-e497-43d0-9539-f21f5697a3d6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=e9884542d4b2fc7ab44def646dc38791 2x, https://si.imgix.net/c3774377/uploads/origins/0ed97685-e497-43d0-9539-f21f5697a3d6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=e7de6ffc75b259e76f7b6770fc1d0e9a 3x"}, "body": "こんにちは、トリ！マウジーだよ！『変身ロボット』シリーズのスカイバイト／ゲルシャークと、僕のオリジナルキャラクター（OC）のイラストを描いてもらえないかな？OC参考画像：https://x.com/mouseycometz/status/1982528823716376700?s=20\nOCとスカイバイト：https://x.com/mouseycometz/status/1953918832751341646?s=20OCとスカイバイト（別バージョン）：https://x.com/mouseycometz/status/1930343275623288844?s=20\n\nOCは思いやりのある女性です。彼女の名前はオフェリアで、スカイバイトは彼女に夢中です。オフェリアは整備士でサーファーです。スカイバイトは強がっていますが、オフェリアを慕わずにはいられません！お二人の描写は自由にお任せします。オフェリアにからかわれてスカイバイトが赤面している様子も素敵ですね！可能であればサイズ差も表現していただけると嬉しいです！ 参考資料ではサイズ差が極端ではないので、あまり気にしすぎないでください！ご依頼を検討いただき、誠にありがとうございます！\n\nhttps://x.com/mouseycometz/status/1982528823716376700?s=20", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@birdws_tf/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1331886, "client_id": 3575409, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/0a8cf65e/uploads/origins/690f0fba-4ede-47c5-a5c2-9c0ec19bf188?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=98d8e48e2e69af0f3449004e8377ade1", "srcset": "https://si.imgix.net/0a8cf65e/uploads/origins/690f0fba-4ede-47c5-a5c2-9c0ec19bf188?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=98d8e48e2e69af0f3449004e8377ade1, https://si.imgix.net/0a8cf65e/uploads/origins/690f0fba-4ede-47c5-a5c2-9c0ec19bf188?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=04ff3ad55d5c4201080520c963b56c0c 2x, https://si.imgix.net/0a8cf65e/uploads/origins/690f0fba-4ede-47c5-a5c2-9c0ec19bf188?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=2784b640af3b68a52ea5bf50b3eca34b 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/0a8cf65e/uploads/origins/690f0fba-4ede-47c5-a5c2-9c0ec19bf188?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c4b561a357ed7361323cfc6f1c7ef53d", "srcset": "https://si.imgix.net/0a8cf65e/uploads/origins/690f0fba-4ede-47c5-a5c2-9c0ec19bf188?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c4b561a357ed7361323cfc6f1c7ef53d, https://si.imgix.net/0a8cf65e/uploads/origins/690f0fba-4ede-47c5-a5c2-9c0ec19bf188?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=35678e689d46c5ba2c9b849b177cc2d6 2x, https://si.imgix.net/0a8cf65e/uploads/origins/690f0fba-4ede-47c5-a5c2-9c0ec19bf188?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=4efab57361b9dd3dd9770461932cbc01 3x"}, "body": "こんにちは、トリさん！ネズミです！ちょっと変わったお願いをしに来ました。\n\nロビン（人間のMTMTE OC）がSwerve's Barにいるシーンをイラストにしてくれませんか？バニースーツを着ています。彼女は一人でも、スワーブ、テールゲート、スキッズなど、バーに来るのが好きな他のボットと一緒でも構いません。私はあなたの選択にこだわりません。描きたいキャラクターを選んでください！\n\n私のOCであるロビンは、特にほろ酔い加減の時はいつも優しくてノリがいい。特にほろ酔い加減の時はいつも、優しくてノリがいい！\n\nSwerveのバーの参考：https://x.com/mouseycometz/status/1998974574365708450?s=20\nOCのリファレンス：https://x.com/mouseycometz/status/1985409416900817264?s=20\n\nロビンは小柄！ロビンは小柄で、茶色の髪に緑色の目。靴はどんな色のヒールでもOK！\n\nこのイラストはシンプルに仕上げていただいて結構です！背景は必要ありません！どのようなイラストでも構いません！\n\nお読みいただきありがとうございました！\n\nhttps://x.com/mouseycometz/status/1985409416900817264?s=20", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@birdws_tf/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1331886, "client_id": 513261, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/c242ea16/uploads/origins/d67ddcf0-8840-4b19-a8fa-fa01d7dfd84c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3a9cdf044394f1eb9dc7c787d0cf90e2", "srcset": "https://si.imgix.net/c242ea16/uploads/origins/d67ddcf0-8840-4b19-a8fa-fa01d7dfd84c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3a9cdf044394f1eb9dc7c787d0cf90e2, https://si.imgix.net/c242ea16/uploads/origins/d67ddcf0-8840-4b19-a8fa-fa01d7dfd84c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=32cfe595329f015825127ba3db4e2263 2x, https://si.imgix.net/c242ea16/uploads/origins/d67ddcf0-8840-4b19-a8fa-fa01d7dfd84c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=44c1143804198bbe1bb753e00d90cf82 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/c242ea16/uploads/origins/d67ddcf0-8840-4b19-a8fa-fa01d7dfd84c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=31198444828eebf976cd78402f1aace8", "srcset": "https://si.imgix.net/c242ea16/uploads/origins/d67ddcf0-8840-4b19-a8fa-fa01d7dfd84c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=31198444828eebf976cd78402f1aace8, https://si.imgix.net/c242ea16/uploads/origins/d67ddcf0-8840-4b19-a8fa-fa01d7dfd84c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=47af6bf922f183ec03df3bb77fdf4bc6 2x, https://si.imgix.net/c242ea16/uploads/origins/d67ddcf0-8840-4b19-a8fa-fa01d7dfd84c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=fa88cdc6f7c61fcdafa16f8b9402228b 3x"}, "body": "鳥さんこんにちは!前回と同一キャラになってしまいますが、マッハアラートと私のOCをお願いしたいです。\n雰囲気はリンク先の1枚目(タイトル画像の次のイラストなので2枚目?)のイラストのイメージで、デフォルメではなく等身絵(前回と同じスタイル)でお願いしたいです。\nシーンも構図も鳥さんのアレンジで大丈夫です。\nインシグニアも前回同様に誤魔化す感じでお願いします。\n(戦地に迷い込んだOCを助けて運んでる感じだと楽しいかな?と思いイメージとしてイラストは載せました。私は構図想像するのが苦手なので、鳥さんにおまかせしたいです)\n\n容姿はマッハアラートはパワーアップ後の青い姿で、OCは通常のピンクでも白黒でもどちらの姿でも大丈夫です。\n\n可能であれば下記内容を希望します\n･アイコン利用、SNS･Webサイトに掲載(鳥さんのIDは必ず明記します)\n･イラストの印刷、個人用にアクリル･キャンバスボード等のグッズ作成(頒布は一切しません、私用です。SNSには鳥さんID明記の上掲載したいです)\n\nご多忙の中読んで頂きありがとうございました!\nリンク先に、所有してる紙媒体のマッハアラートの資料、他玩具やミニカー画像を追加で載せてみました。参考になれば幸いです。(資料が多いので全部に目を通さなくても大丈夫です)\n※リンク先は画像が多いので閲覧端末によっては2ページに分けて表示されます\n\nhttps://plus.fm-p.jp/u/takamura_kou/gallery/canvas?id=13&bid=12", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@birdws_tf/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1331886, "client_id": 3575409, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/20e13ddd/uploads/origins/76707536-2271-4448-a6ed-0fcaa5500a8f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0b745065efed7cb7b43476427c9ec01a", "srcset": "https://si.imgix.net/20e13ddd/uploads/origins/76707536-2271-4448-a6ed-0fcaa5500a8f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0b745065efed7cb7b43476427c9ec01a, https://si.imgix.net/20e13ddd/uploads/origins/76707536-2271-4448-a6ed-0fcaa5500a8f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=6fd0f5361724edc531ef1e9dc0bf2f4b 2x, https://si.imgix.net/20e13ddd/uploads/origins/76707536-2271-4448-a6ed-0fcaa5500a8f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=5710166d81166b76f96e6ab19574c7c3 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/20e13ddd/uploads/origins/76707536-2271-4448-a6ed-0fcaa5500a8f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=4f5f208727c41bcde1cd6eb48b384187", "srcset": "https://si.imgix.net/20e13ddd/uploads/origins/76707536-2271-4448-a6ed-0fcaa5500a8f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=4f5f208727c41bcde1cd6eb48b384187, https://si.imgix.net/20e13ddd/uploads/origins/76707536-2271-4448-a6ed-0fcaa5500a8f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=2877cf5d39a30ea810d2a13e0da16c2f 2x, https://si.imgix.net/20e13ddd/uploads/origins/76707536-2271-4448-a6ed-0fcaa5500a8f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=83fe1f6c027c4f6af438805cd90cccc3 3x"}, "body": "こんにちは！私の名前はマウスィ！\n\nサイバーバースのスタースクリームと私の人間のOCのイラストをリクエストしてもいいですか？彼女の名前はフェーで、農場で働く航空整備士です！彼女はスタースクリームが地球での戦闘で負傷した後に引き取る。\n\nサイバーバースのスタースクリームは猫のように見えるので、猫の特徴を持つスタースクリームを描けますか？猫耳と尻尾とか！OCはスタースクリームの耳をさすったり、顔を押さえたりしている。スタースクリームは怒っているように見えるけど、実は彼女からのペットが大好きなんだ！スタースクリームはOCと同じ大きさ（人間の大きさ）にすると描きやすいと思います！\n\nこのプロンプトが気に入らないなら、2人を好きなように描いてください。二人はよく喧嘩をしますが、フェーは彼のことを気にかけています！\n\nOC Reference: https://x.com/mouseycometz/status/1975926888804577730\nスタースクリームとのOC：https://x.com/mouseycometz/status/1972008503272525909\n\nhttps://x.com/mouseycometz/status/1975926888804577730", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@birdws_tf/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1331886, "client_id": 513261, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/4382f368/uploads/origins/59339a78-fd8e-4968-8f3e-87bc54cd3e8b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=77a2e3a7766d39394e03208b6c795826", "srcset": "https://si.imgix.net/4382f368/uploads/origins/59339a78-fd8e-4968-8f3e-87bc54cd3e8b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=77a2e3a7766d39394e03208b6c795826, https://si.imgix.net/4382f368/uploads/origins/59339a78-fd8e-4968-8f3e-87bc54cd3e8b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=cab22ead248af285499d1ca02ce2f7c9 2x, https://si.imgix.net/4382f368/uploads/origins/59339a78-fd8e-4968-8f3e-87bc54cd3e8b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=5237ef31aa303e29566145e1e9e1fec8 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/4382f368/uploads/origins/59339a78-fd8e-4968-8f3e-87bc54cd3e8b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=60b6f10addd122ba6c33848ff4b20244", "srcset": "https://si.imgix.net/4382f368/uploads/origins/59339a78-fd8e-4968-8f3e-87bc54cd3e8b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=60b6f10addd122ba6c33848ff4b20244, https://si.imgix.net/4382f368/uploads/origins/59339a78-fd8e-4968-8f3e-87bc54cd3e8b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=be425124e496c92799a5293bec8a3d5b 2x, https://si.imgix.net/4382f368/uploads/origins/59339a78-fd8e-4968-8f3e-87bc54cd3e8b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=353d6371f719f4f95c6f5fa86fd87944 3x"}, "body": "※申請再送失礼します!\nもし承認くださる場合は前回の申請は破棄して頂き、こちらで受けて下さると幸いです🙇‍\n\n鳥さんこんにちは!いつもイラスト楽しく拝見してますっ\nさっそくですが、私のTFOCルージュと、トランスフォーマーカーロボットのマッハアラートを描いて頂きたいです。\n\n構図･シーン、は下記の創作設定の雰囲気で描いて頂けたら幸いです。でもおまかせしたいです。\n\n□創作設定\nマッハアラートが指導教官として新米のOCをパトロール等の任務に同行させてる設定です。OCは位置認識システムが壊れてるので極度の方向音痴で、マッハアラートは手を焼きつつも根気強く指導します!パトロール以外も、警察官の様に振る舞うマッハアラートの手伝いもします。\n(恋人の距離感よりは兄妹に近い、OCが控えめながら懐いている感じ)\n\n鳥さんのキャラ同士親しみのあるやり取りのイラストタッチが大好きなので、その雰囲気で描いて頂ければ嬉しいです!\nOCの表情は嬉しそうで、マッハアラートが少しだけ照れてると嬉しいですっ\n\n□マッハアラート設定(公式サイト引用)\nカーロボ3兄弟の次男。頭脳明晰だが規則にうるさい正義漢。\nときに融通がきかずにチームワークの裏目に出ることも。\n\n□OC設定(無視して大丈夫です!)\n･イメージCVは丹下桜さん\n･非武装の為戦闘には不向き\n･人見知り 、おっとりしてる\n･お菓子の間食が多い\n･装甲から下乳出てるのはあまり気にしてない\n･胸部装甲のどこかにお菓子を隠し持っている\n\n参考URLにデザイン設定を載せましたが、細かいデザインは変えて頂いて構いません!\n下乳がチャームポイントなので描いて欲しいのですが、\"子供向けアニメに出てくる設定\"を意識してるのでセンシティブな雰囲気にならない様にお願いしたいです。\n容姿は通常の姿でもパワーアップ後の姿でもどちらでも大丈夫です!\n\n□可能であれば下記内容を希望します\n･アイコン利用、SNS･Webサイトに掲載(鳥さんのIDは必ず明記します)\n･イラストの印刷、個人用にアクリル･キャンバスボード等のグッズ作成(頒布は一切しません、私用です。SNSには鳥さんID明記の上掲載したいです)\n\nご多忙の中読んで頂きありがとうございました!\n\nhttps://plus.fm-p.jp/u/takamura_kou/gallery/canvas?id=13&bid=12", "nc": 136, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@birdws_tf/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1331886, "client_id": 661111, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/38c273a0/uploads/origins/28bbdeeb-5b86-4f69-bca9-58f28efd2abb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=25ae1c5fdce2e97b9715f720797b683e", "srcset": "https://si.imgix.net/38c273a0/uploads/origins/28bbdeeb-5b86-4f69-bca9-58f28efd2abb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=25ae1c5fdce2e97b9715f720797b683e, https://si.imgix.net/38c273a0/uploads/origins/28bbdeeb-5b86-4f69-bca9-58f28efd2abb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=2a691d45fb4c296b416e3dd830941f60 2x, https://si.imgix.net/38c273a0/uploads/origins/28bbdeeb-5b86-4f69-bca9-58f28efd2abb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=63db666bd4e218839ebc96f8a14586e9 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/38c273a0/uploads/origins/28bbdeeb-5b86-4f69-bca9-58f28efd2abb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=bd8ee8bf2bf4025cb9d2ca3d10a61ba9", "srcset": "https://si.imgix.net/38c273a0/uploads/origins/28bbdeeb-5b86-4f69-bca9-58f28efd2abb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=bd8ee8bf2bf4025cb9d2ca3d10a61ba9