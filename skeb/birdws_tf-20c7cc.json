u4e0b\u8a18\u306e\u5275\u4f5c\u8a2d\u5b9a\u306e\u96f0\u56f2\u6c17\u3067\u63cf\u3044\u3066\u9802\u3051\u305f\u3089\u5e78\u3044\u3067\u3059\u3002\u3067\u3082\u304a\u307e\u304b\u305b\u3057\u305f\u3044\u3067\u3059\u3002\n\n\u25a1\u5275\u4f5c\u8a2d\u5b9a\n\u30de\u30c3\u30cf\u30a2\u30e9\u30fc\u30c8\u304c\u6307\u5c0e\u6559\u5b98\u3068\u3057\u3066\u65b0\u7c73\u306eOC\u3092\u30d1\u30c8\u30ed\u30fc\u30eb\u7b49\u306e\u4efb\u52d9\u306b\u540c\u884c\u3055\u305b\u3066\u308b\u8a2d\u5b9a\u3067\u3059\u3002OC\u306f\u4f4d\u7f6e\u8a8d\u8b58\u30b7\u30b9\u30c6\u30e0\u304c\u58ca\u308c\u3066\u308b\u306e\u3067\u6975\u5ea6\u306e\u65b9\u5411\u97f3\u75f4\u3067\u3001\u30de\u30c3\u30cf\u30a2\u30e9\u30fc\u30c8\u306f\u624b\u3092\u713c\u304d\u3064\u3064\u3082\u6839\u6c17\u5f37\u304f\u6307\u5c0e\u3057\u307e\u3059!\u30d1\u30c8\u30ed\u30fc\u30eb\u4ee5\u5916\u3082\u3001\u8b66\u5bdf\u5b98\u306e\u69d8\u306b\u632f\u308b\u821e\u3046\u30de\u30c3\u30cf\u30a2\u30e9\u30fc\u30c8\u306e\u624b\u4f1d\u3044\u3082\u3057\u307e\u3059\u3002\n(\u604b\u4eba\u306e\u8ddd\u96e2\u611f\u3088\u308a\u306f\u5144\u59b9\u306b\u8fd1\u3044\u3001OC\u304c\u63a7\u3048\u3081\u306a\u304c\u3089\u61d0\u3044\u3066\u3044\u308b\u611f\u3058)\n\n\u9ce5\u3055\u3093\u306e\u30ad\u30e3\u30e9\u540c\u58eb\u89aa\u3057\u307f\u306e\u3042\u308b\u3084\u308a\u53d6\u308a\u306e\u30a4\u30e9\u30b9\u30c8\u30bf\u30c3\u30c1\u304c\u5927\u597d\u304d\u306a\u306e\u3067\u3001\u305d\u306e\u96f0\u56f2\u6c17\u3067\u63cf\u3044\u3066\u9802\u3051\u308c\u3070\u5b09\u3057\u3044\u3067\u3059!\nOC\u306e\u8868\u60c5\u306f\u5b09\u3057\u305d\u3046\u3067\u3001\u30de\u30c3\u30cf\u30a2\u30e9\u30fc\u30c8\u304c\u5c11\u3057\u3060\u3051\u7167\u308c\u3066\u308b\u3068\u5b09\u3057\u3044\u3067\u3059\u3063\n\n\u25a1\u30de\u30c3\u30cf\u30a2\u30e9\u30fc\u30c8\u8a2d\u5b9a(\u516c\u5f0f\u30b5\u30a4\u30c8\u5f15\u7528)\n\u30ab\u30fc\u30ed\u30dc3\u5144\u5f1f\u306e\u6b21\u7537\u3002\u982d\u8133\u660e\u6670\u3060\u304c\u898f\u5247\u306b\u3046\u308b\u3055\u3044\u6b63\u7fa9\u6f22\u3002\n\u3068\u304d\u306b\u