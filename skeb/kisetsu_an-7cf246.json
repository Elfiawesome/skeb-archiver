\n\n少し強引に押し倒されたシチュエーションで、顔を赤らめつつも睨みつけて口は「い」の発音のように食いしばった歯を見せるような表情。ツンデレのツン要素多め。\n\n（デレ要素多めになった様子で快楽に喘ぎ声を上げながら蕩け顔になった表情もお願いしたいですが、そいｔらは可能な場合のみでokです）\n\nhttps://drive.google.com/drive/folders/1rYPBQmEmbBLPXnl-Xob_JXgluQXUFuij", "nc": 161, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 233843, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "足ひれ", "screen_name": "asihire", "avatar_url": "https://pbs.twimg.com/profile_images/1509881494092746753/Eid9xu-U.jpg", "header_url": null, "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "art"}, {"genre": "comic"}], "banned": false, "nc": 48}, {"id": 573381, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "Tea＠ナケナシ", "screen_name": "nakenashi", "avatar_url": "https://pbs.twimg.com/profile_images/1948093606461673472/cTjDVZ8-.jpg", "header_url": "https://pbs.twimg.com/profile_banners/18717754/1532927953/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 100, "skills": [{"genre": "art"}], "banned": false, "nc": 48}, {"id": 587171, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "きゅん◢◣", "screen_name": "t1tsu_kyun", "avatar_url": "https://pbs.twimg.com/profile_images/1263510900050296837/W3ySvbxn.jpg", "header_url": "https://pbs.twimg.com/profile_banners/922669340364742656/1590919927/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 90, 