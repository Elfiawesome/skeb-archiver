021d35f7ef4b9c3059828b4e23a0feb9", "src_set": ""}, "private": true, "genre": "art", "tipped": true, "creator_id": 2384905, "client_id": 0, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 32, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@hamidemachi/works/186", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2384905, "client_id": 0, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/434a8ef6/uploads/origins/2c7e8c7c-c130-4abc-a356-0d3631bfad6d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4f1111090bcff5254da165949f61bc03", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/434a8ef6/uploads/origins/2c7e8c7c-c130-4abc-a356-0d3631bfad6d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f4efcffd0736822dc75f2915c6135148", "src_set": ""}, "body": "はみでまち先生、こんにちは。私はあなたの作品がとても好きです。世良君が地球を使って自慰器にし、太陽に向かって射精するシーンを見たいです。そして、その精液が太陽を消してしまう（その時、世良君は宇宙で巨大化しています）。もし可能であれば、他の穴の開いた星球の自慰カップも見てみたいです……", "nc": 161, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@hamidemachi/works/185", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2384905, "client_id": 173544, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/c6943130/uploads/origins/2e0cd4ce-020b-417c-a803-618a6e69346d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f2b8b760959cde98be79a1cf6b103ef6", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/c6943130/uploads/origins/2e0cd4ce-020b-417c-a803-618a6e69346d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=988cafafa6e05776f5a3b801ce190dc8", "src_set": ""}, "body": "ちんぽの大きさ=強さの世界で、圧倒的な強さによって魔王として君臨している世良くんを描いてください。\n\nちんぽの大きさ・精力の分布は、普通の人は10cmから50cm程度、極少数の才能のある人が突出して巨大なちんぽを持っている世界で、人間の上限は数メートル程度（レベル×10cmが基準）の中で、世良くんだけが長さ5京cm（5兆キロメートル）、太さ8000億キロメートルにも達するちんぽを持っている、という設定でお願いします。\n\n勃起するだけで跡形もなく星系を粉砕してしまうほどの超根（太陽系の半径が45億キロメートル）なので普段は魔法でちんぽを小さくしており、ムラッとしたら転移門を開いてオナホ代わりにして遠方の銀河系を精液で埋め尽くしたりします。\n\n側近である新舞さんと思井くんと白渡くんのちんぽはそれぞれ300万キロメートル、2万キロメートル、15キロメートルくらいのイメージです。（幹部の平均は3000キロメートル程）。\n\n世良くんは本来の世界の記憶をうっすら持っており、ちんぽの大きさを誇示することが普通で、屋外露出のスリルを味わうことのできない魔族の社会に違和感を感じており、玉座の間の広さに合わせたサイズ（天井スレスレ）まで勃起させたちんぽを爆乳モブサキュバス達（元の世界で世良くんかっこいいー！とキャーキャー言っていた女子高生？達）に全身で奉仕させながらアンニュイな気持ちに浸っている、というシチュエーションでお願いします。（その程度では感じないため、モブサキュバス達には全く無関心な感じでお願いします。思井くんを尿道に入れるくらいで漸く感じ始めるくらい）", "nc": 184, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@hamidemachi/works/184", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/a32e820e/uploads/origins/ee2c9adf-8146-44bd-9a66-6a914f7f943f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=0039939ba45903d874cbff130f5738a5", "src_set": ""}, "private": true, "genre": "art", "tipped": true, "creator_id": 2384905, "client_id": 0, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 160, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}], "similar_creators": [{"id": 18701, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "xxFSxx", "screen_name": "xxFSxx2", "avatar_url": "https://pbs.twimg.com/profile_images/1534694110648766465/OjR8S33D.png", "header_url": "https://pbs.twimg.com/profile_banners/1534694013395431424/1743658601/1500x500", "appeal_receivable": false, "popular_creator_rank": 51, "request_master_rank": null, "first_requeste