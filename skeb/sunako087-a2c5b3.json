ix.net/52642cf3/uploads/origins/d4f81cd5-7c4d-4754-823b-54b2804dd752?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e6a4fb6c72281e3353fe1376f0c8683c, https://si.imgix.net/52642cf3/uploads/origins/d4f81cd5-7c4d-4754-823b-54b2804dd752?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=25167171db523bf3498ee03f379ee9b0 2x, https://si.imgix.net/52642cf3/uploads/origins/d4f81cd5-7c4d-4754-823b-54b2804dd752?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=5de6f257a5f25ba922ceafb5356a53f8 3x"}, "body": "こんにちは！あなたの作品の大ファンなので、お願いがあります！私の「あくねこ夢女子」を描いていただきたいです。\n\nポーズはお任せしますが、できれば「お嬢様」のような可愛らしく上品な表情でお願いします。\n\n髪型は肩より少し長めのバタフライカットで、前髪はありません。髪の内側に青いハイライトを入れてください（ハウレスの髪色と同じです）。\n\n服装は、黒のフィットしたマーメイドスカートとレースのブラウス、そして上品なヒールブーツをお願いします。青い蝶のネックレスと指輪、ヘアピン、イヤリングなどのアクセサリーはお任せします（ハウレスのクリスマスイヤリングなど）。\n\n大きくて丸いメガネと右頬のほくろもチャームポイントです。\n\nまた、「忘草」や「百合」のような花、蝶や鳥も好きなので、もし可能であればそれらも描いていただけると嬉しいです。\n\n私の「あくねこ夢女子」は身長173cm、Cカップです。\n\n可能であれば、背景透過のPNGまたはPSDファイルと、眼鏡あり・なしの画像もお願いしたいです。お願いを聞いていただきありがとうございます。ご迷惑をおかけしていなければ幸いです。\n\nhttps://drive.google.com/drive/folders/10Zqth0b5W5FYDs7lbYuX_VtR75LRdleo?usp=sharing", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 1201054, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "ぽとわり", "screen_name": "popotowari", "avatar_url": "https://pbs.twimg.com/profile_images/1498235865298259970/cbbi8CTc.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1392141413047930880/1640850409/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 7, "complete_expiration_days": 45, "skills": [{"genre": "art"}], "banned": false, "nc": 33}, {"id": 2180837, "creator": true, "nsfw_acceptable": false, "acceptable": true,