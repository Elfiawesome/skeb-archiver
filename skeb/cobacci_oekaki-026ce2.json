※この場合は企業様には予め企画以外の用途に使わない旨の確認を必ず取ります)\n\n【納品形式】\nサイズはお任せいたします。\n納品形式はpsdファイル形式ですと助かります。\n\nお忙しい中恐れ入りますが、検討いただければ幸いです。\nどうぞよろしくお願いいたします。\n\nhttps://lit.link/sayaka_tukineko", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@cobacci_oekaki/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 4063214, "client_id": 2842648, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/a9de0843/uploads/origins/08b3914c-7bb2-49e7-9e3c-c81094fbbd69?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7ee31188bf52207dd86d0eb28891f3c1", "srcset": "https://si.imgix.net/a9de0843/uploads/origins/08b3914c-7bb2-49e7-9e3c-c81094fbbd69?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7ee31188bf52207dd86d0eb28891f3c1, https://si.imgix.net/a9de0843/uploads/origins/08b3914c-7bb2-49e7-9e3c-c81094fbbd69?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=d2fd35c2a288e650e8110afb4cc0c754 2x, https://si.imgix.net/a9de0843/uploads/origins/08b3914c-7bb2-49e7-9e3c-c81094fbbd69?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b70de0d6643d2ce5e2804bc985edc7d3 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/a9de0843/uploads/origins/08b3914c-7bb2-49e7-9e3c-c81094fbbd69?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0e4c93fb0caa99cd030ae417d668fd7a", "srcset": "https://si.imgix.net/a9de0843/uploads/origins/08b3914c-7bb2-49e7-9e3c-c81094fbbd69?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0e4c93fb0caa99cd030ae417d668fd7a, https://si.imgix.net/a9de0843/uploads/origins/08b3914c-7bb2-49e7-9e3c-c81094fbbd69?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=6aa462ba0097be69cf84fc5497f3a9f9 2x, https://si.