丈夫ですので、ご検討いただければ幸いです。\n\nhttps://twitter.com/robokoke/status/1562453634390011904?s=20&t=zVytxZcFH5NtqSsgo3cpRA", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}], "sent_works": [], "similar_creators": [{"id": 613571, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "うぱちぇ︎︎", "screen_name": "Upache", "avatar_url": "https://pbs.twimg.com/profile_images/1954912327545012224/U3H68OZa.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1529471290100240384/1764173101/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 20, "complete_expiration_days": 30, "skills": [{"genre": "art"}], "nc": 0}, {"id": 983404, "creator": true, "nsfw_acceptable": false, "acceptable": false, "name": "T8", "screen_name": "T80077497626", "avatar_url": "https://pbs.twimg.com/profile_images/1519322358044975104/e_6uCXbo.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1321179783066103808/1650471050/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 7, "complete_expiration_days": 30, "skills": [{"genre": "art"}], "nc": 17}, {"id": 2541938, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "🌸八丁みそ🌸", "screen_name": "misooo_ll", "avatar_url": "https://pbs.twimg.com/profile_images/1962093895652925440/y4p1gyZz.png", "header_url": "https://pbs.twimg.com/profile_banners/1545592848845746177/1706623879/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 120, "skills": [{"genre": "art"}], "nc": 128}, {"id": 2620286, "creator": true, "nsf