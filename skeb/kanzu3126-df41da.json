ress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=d380c37725a7b2b732b6356b80f51386 3x"}, "body": "はじめましてと依頼失礼します\n\n\n崩壊:スターレイルのフォフォ\n内容はペニバン\n\nペニバンのデザインはショーツタイプでもベルト型でもショーツとベルト一体式でもお好きに\n\n\n表情は涙目orフォフォ立ち絵のような普段の気弱な表情\n\n服装は裸、もしくは程度脱がして胸やペニバン部分等は露出してるでも構いません\n\nポーズ\n後ろ手に縛られ拘束されていて腰掛けている、もしくはガニ股・腰振りダンス姿勢とペニバンを魅せつける感じに\n\n差分\nペニバン射精差分と表情差分(射精による快感・イクとか)を良ければ…！\n以下は先の差分より優先度低いですが目隠し、顔隠し、猿轡差分\n\nその他として、ペニバンとありますがペニバンはちょっと…とかならばふたなりに変更でもOK(その際はペニバン射精はふたなり射精)\n\nペニバンは本物の様に感じれるかつ射精可。\n少しアレンジで鍵・ロックとか封印等が掛けられてフォフォはペニバンを脱げれない・外せれない\n\nセリフや擬音の有無はお任せします\n\n\n完全に私好み故に癖の強い内容ではありますが\nよろしくお願いします", "nc": 176, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 5041, "creator": true, "nsfw_acceptable": true, "acceptable": false, "name": "🔞ROM🔞＠ｃ108 二日目（日曜） 東7　D18b", "screen_name": "ROM_taku", "avatar_url": "https://pbs.twimg.com/profile_images/1402490450250854401/UtPlpWBS.jpg", "header_url": "https://pbs.twimg.com/profile_banners/338180018/1623213816/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "art"}], "banned": false, "nc": 33}, {"id": 1288420, "creator": true, "nsfw_acceptable": true, "acceptable": false, "name": "はまむら", "screen_name": "HMMR114", "avatar_url": "https://pbs.twimg.com/profile_images/1656547220127379456/E10_c4Us.jpg", "header_url": null, "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "art"}, {"genre": "correction"}], "banned": false, "nc": 32}, {"id": 1312836, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "リトスノ", "screen_name": "littlesnow33", "avatar