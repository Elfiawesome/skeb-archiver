ins/92f32a22-928c-4752-8c0b-9e6bfb22782f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d22a7a684c9b7d8cb0cc79be7ae21aa3, https://si.imgix.net/3989b9c3/uploads/origins/92f32a22-928c-4752-8c0b-9e6bfb22782f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=2f96be73b0b2706f01375d682353d58f 2x, https://si.imgix.net/3989b9c3/uploads/origins/92f32a22-928c-4752-8c0b-9e6bfb22782f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=2fe05505935590fdb4fd4d275b3897ed 3x"}, "body": "久方ぶりの依頼失礼します\n\n\n崩壊:スターレイルで\nルアン・メェイ&帰忘の流離人(以下新停雲)を\n\n構図は2人のレズプレイで2人とも裸。新停雲の尻尾は9本で無く1本に簡略・省略でも大丈夫です\n\n\nレズプレイの内容は\n舌を絡め合うキス(ディープキス・ベロチュー)\n\nペニバンorふたなり(ルアン・メェイ&新停雲の両者対象)セックス\n\nどちらか片方or両者が順番に相手へフェラ\n\nその他色々や差分…\n\n\n挿入の際の体位はご自由に。両者相愛orルアン・メェイの方が主導権を握っている関係性\n\nもし良ければ2人のヘソの上or下にですが\n繁殖の淫紋を。デザインは繁殖の封蝋に描かれてるマークで色もそれと同じ…\n\n\nお姉さん・女性系キャラのレズ作品になりますが\n検討お願いします\n\nhttps://wiki.hoyolab.com/pc/hsr/entry/1506?lang=ja-jp", "nc": 184, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@kanzu3126/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 657181, "client_id": 44251, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/7036f6b8/uploads/origins/6155b6ea-df3a-4a67-a67b-0fb56dda6a74?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=83fa22f05aeda4a8418c9c90a506a725", "srcset": "https://si.imgix.net/7036f6b8/uploads/origins/6155b6ea-df3a-4a67-a67b-0fb56dda6a74?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=83fa22f05aeda4a8418c9c90a506a725, https://si.imgix.net/7036f6b8/uploads/origins/6155b6ea-df3a-4a67-a67b-0fb56dda6a74?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ae55c0e399a43ca92a170ccdcbd70882 2x, https://si.imgix.net/7036f6b8/uploads/origins/6155b6ea-df3a-4a67-a67b-0fb56dda6a74?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=7a38dbcd8a428bb6fefcb7f767b71887 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/7036f6b8/uploads/origins/6155b6ea-df3a-4a67-a67b-0fb56dda6a74?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c2497931aaeee2c4253454401ae79f01", "srcset": "https://si.imgix.net/7036f6b8/uploads/origins/6155b6ea-df3a-4a67-a67b-0fb56dda6a74?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c2497931aaeee2c4253454401ae79f01, https://si.imgix.net/7036f6b8/uploads/origins/6155b6ea-df3a-4a67-a67b-0fb56dda6a74?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=893b55fa3f4b131fbc9c0ae7f1200162 2x, https://si.imgix.net/7036f6b8/uploads/origins/6155b6ea-df3a-4a67-a67b-0fb56dda6a74?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=3f2b7ad14eae2ed0dea20b2671ea77f8 3x"}, "body": "依頼失礼します\n\n崩壊:スターレイルのフォフォ\n\n\n今回は裸で帽子無し、ペニバンを装着しペニバン手コキオナニー(つまり男子のオナニーであり自慰行為をペニバンで)を！\n\nペニバンの魅力等かフォフォ自身のせいかペニバンを手コキによるオナニーをする・してしまうフォフォ\n\nペニバンは同じのでも色、デザインが違う(ベルト型かショーツ型か複合なのは変わらず)のでも可\n\n\n差分として\n\n1　オナニーをする前\n2　手コキオナニーを開始\n3　オナニーをする・している\n4　気持ち良さ快感快楽が増していく\n5　いきそう・射精しそう\n6　射精！\n7　絶頂し気持ち良く射精した後等の余韻…\n\nを。他にも\nこんな事(ペニバンでオナニー)したく無いのに…！と躊躇いや嫌がる\n手は身体はペニバンは欲望や快楽に正直に。でも顔は心は気持ち良さに抗おうとする\n快楽に堕ち完全に慣れきった染まった…\n\nといった表情差分も…！\n\n以下の差分や設定は無視なり無しなりお好きに\n\n目隠し差分\n\n本物のみたいに最初は萎えてて次第に唆り勃っていき射精時にはブルンブルン？と震え余韻でまた萎えるか勃起が収まらないままギンギンに勃ち続ける\n\n\nクリエイター様のフォフォがとても良くて気に入り今回も依頼をとなりました。つい差分が多くなりました…\nよろしくお願いします", "nc": 33, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@kanzu3126/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 657181, "client_id": 3759161, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/12566968/uploads/origins/fb3d752d-3973-47b4-b81a-0420bb8d052c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f1b2b6059422094aabf6643cfc4b5193", "srcset": "https://si.imgix.net/12566968/uploads/origins/fb3d752d-3973-47b4-b81a-0420bb8d052c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f1b2b6059422094aabf6643cfc4b5193, https://si.imgix.net/12566968/uploads/origins/fb3d752d-3973-47b4-b81a-0420bb8d052c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=02807060e14739b595161bc2f235006e 2x, https://si.imgix.net/12566968/uploads/origins/fb3d752d-3973-47b4-b81a-0420bb8d052c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b73f709740ed78b392ba6de0ac00bbd4 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/12566968/uploads/origins/fb3d752d-3973-47b4-b81a-0420bb8d052c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ee0cee987798202b949d76d1e5f4d0ab", "srcset": "https://si.imgix.net/12566968/uploads/origins/fb3d752d-3973-47b4-b81a-0420bb8d052c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ee0cee987798202b949d76d1e5f4d0ab, https://si.imgix.net/12566968/uploads/origins/fb3d752d-3973-47b4-b81a-0420bb8d052c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=e82b5e786d8486c8df26c4dcdd708212 2x, https://si.imgix.net/12566968/uploads/origins/fb3d752d-3973-47b4-b81a-0420bb8d052c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=fe3cdbc40f4648822ed6f073fc0540a3 3x"}, "body": "こんにちは！Skebさんがあなたを推薦してくれました。\n\n私のOCを描いてくれませんか？名前はメイ。反抗的なティーンエイジャー。目は鮮やかな緑で、いつもサングラスをかけている。髪はダークブラウンで、少し乱れている。服はよく汚れている。金色のアクセサリーは母親のもので、母親への腹いせに身につけている。武器として野球のバットをよく持ち歩いている。服装は白いタンクトップにグレーのショートパンツ、シンプルな靴。赤いジャケットはオプション。\n\n自信に欠けるが、それを虚勢や嘲り、自信過剰でごまかしている。そのため友達は少ないが、苦しみを表に出すことはない。\n\n表情は自信満々でドヤ顔か、自信なさげで自信なさげか。好きなポーズで描いてください。背景は何でも構いません。\n\nよろしくお願い