むっちりしてます。\n\n○構図・シチュなど \n【大きめの胸・八重歯】\n こちらがわかるようにお願いします。\n\nシチュなど\n・資料記載の要素を含め、（少しウザ）可愛い全振りのイラストでお願い致します。\n表情はお任せ、服のアレンジなども全てお任せ致します。可愛く描いてください。\n納品はpsd形式でお願い致します。\n※下書きなどありましたら、そのまま残していただけますと幸いです。難しければ結構です。（ラフ画を見るのがとても好きなので…）\n\n〇用途 \n本垢や、当方で運用するアカウント（この娘の専用垢）で使用させていただく予定です。 \n※配信（予定）などで使用させていただくかもしれません。 \n\nまた、完全個人用途でタペなどグッズ作成に使用させていただくかもしれません。\n 以上、宜しくお願い致します\n\nhttps://imgur.com/a/gBSp4HV", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@kureno622xx/works/9", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 533495, "client_id": 880622, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/b124cf8e/uploads/origins/3e33f2a2-1957-454d-befb-5bb0dcf9d723?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2f39a3e7dc258fe1f68d68cdd06bdff9", "srcset": "https://si.imgix.net/b124cf8e/uploads/origins/3e33f2a2-1957-454d-befb-5bb0dcf9d723?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2f39a3e7dc258fe1f68d68cdd06bdff9, https://si.imgix.net/b124cf8e/uploads/origins/3e33f2a2-1957-454d-befb-5bb0dcf9d723?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e58eb60167d51f59959940134141bff1 2x, https://si.imgix.net/b124cf8e/uploads/origins/3e33f2a2-1957-454d-befb-5bb0dcf9d723?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=0074288a690438a2cbd310738d0638cf 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/b124cf8e/uploads/origins/3e33f2a2-1957-454d-befb-5bb0dcf9d723?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=1e6d388c948487829d0d267320d1e451", "srcset": "https://si.imgix.net/b124cf8e/uploads/origins/3e33f2a2-1957-454d-befb-5bb0dcf9d723?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=1e6d388c948487829d0d267320d1e451, 