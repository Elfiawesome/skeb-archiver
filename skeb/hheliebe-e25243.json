=200&h=200&blur=200&s=c7f695ae2676d53aa1a44e5aee14e319", "srcset": "https://si.imgix.net/900b65de/uploads/origins/88141587-9010-4916-ab54-c6e7cd88f249?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c7f695ae2676d53aa1a44e5aee14e319, https://si.imgix.net/900b65de/uploads/origins/88141587-9010-4916-ab54-c6e7cd88f249?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=c2ce4e247675225480288fb12c1a271a 2x, https://si.imgix.net/900b65de/uploads/origins/88141587-9010-4916-ab54-c6e7cd88f249?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=f9565971f487c89285be52dad7795199 3x"}, "body": "やあ～～～～～ また僕、バイケンだよ。またイラストのリクエストがあるんだ。\nベレー帽のイラストの仕上がりがすごく気に入ったから、今回は斧を持った僕のキャラクターを、斧とポーズの参考ファイルにあるポーズで描いてほしいんだ。でも、マスクとベレー帽を被らせて、目の光も入れてね。\n 遠近感については「遠近感参考ファイル」を参考にしてほしいんだけど、背景は夜で、夜間の廃墟となった工場地帯のような感じにしてほしい。\n壁紙として使えるように、またワイドスクリーンにしてね。あと、僕のキャラは美少年であって、女性じゃないから忘れないで！\nまた君の作品を見るのが待ちきれないよ！\n参考：https://drive.google.com/file/d/1i4Yth036Y8myl5q6XO_B_UgrfEQglgRq/view?usp=drive_link\n\nhttps://drive.google.com/file/d/1i4Yth036Y8myl5q6XO_B_UgrfEQglgRq/view?usp=drive_link", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@hheliebe/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3142554, "client_id": 3153635, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/f4380d76/uploads/origins/f974995b-12e0-40cd-813b-a91a6d772ee0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=49bd97d9251d2f9216b4bbcb4c2bd0ad", "srcset": "https://si.imgix.net/f4380d76/uploads/origins/f974995b-12e0-40cd-813b-a91a6d772ee0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=49bd97d9251d2f9216b4bbcb4c2bd0ad, https://si.imgix.net/f4380d76/uploads/origins/f974995b-12e0-40cd-813b-a91a6d772ee0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ba093b254e3883dc3f9fbaa07b51eceb 2x, https://si.imgix.net/f4380d76/uploads/origins/f974995b-12e0-40cd-813b-a91a6d772ee0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=05a235680ab297630bbaadac303a1552 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/f4380d76/uploads/origins/f974995b-12e0-40cd-813b-a91a6d772ee0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e2605a68efcd7acda8a615df651d829a", "srcset": "https://si.imgix.net/f4380d76/uploads/origins/f974995b-12e0-40cd-813b-a91a6d772ee0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e2605a68efcd7acda8a615df651d829a, https://si.imgix.net/f4380d76/uploads/origins/f974995b-12e0-40cd-813b-a91a6d772ee0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=25ae6b2d2a20fd5f10777f363c6b124c 2x, https://si.imgix.net/f4380d76/uploads/origins/f974995b-12e0-40cd-813b-a91a6d772ee0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=35ace113c185323fa31ebe0848c0f090 3x"}, "body": "こんにちは！先日、あなたの作品を見ましたが、本当に感動しました。あなたの作品、大好きです！\n\nDriveに添付した参考画像のようなスタイルで、私のキャラクター「イービル・ミユ」を描いていただけませんか？セクシーで、ダークで、ミステリアスな雰囲気を出してほしいです。暗い色使いを自由に試してみてください。\n\n「イービル・ミユ」の性格について少し説明しますと、彼女はいたずら好きで邪悪、そして常に悪巧みを企んでいるようなキャラクターです。混乱を引き起こしたり、意地悪をしたりするのが大好きですが、その一方で、とても可愛らしい見た目をしているため、周囲は彼女を本気で脅威とは捉えきれないのです。彼女のメインカラーは黒、赤、白です。\n\n創作の自由度はかなりお任せしますので、彼女の雰囲気に自然に馴染むような作品を作ってください！\n\nこのイラストを商用利用する予定です。\n\nhttps://drive.google.com/drive/folders/1mG5tBVSHLMkNh8E7h94Btw3W2XEd_S80?usp=sharing", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@hheliebe/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3142554, "client_id": 2483301, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/bca2cc2e/uploads/origins/227b1a31-e43b-4a14-bb2f-6bd874d36538?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=77d334bd400068a0794f4156eaaf9faa", "srcset": "https://si.imgix.net/bca2cc2e/uploads/origins/227b1a31-e43b-4a14-bb2f-6bd874d36538?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=77d334bd400068a0794f4156eaaf9faa, https://si.imgix.net/bca2cc2e/uploads/origins/227b1a31-e43b-4a14-bb2f-6bd874d36538?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=573e0d8b70d89217a05d3e56b7594deb 2x, https://si.imgix.net/bca2cc2e/uploads/origins/227b1a31-e43b-4a14-bb2f-6bd874d36538?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=729a91f3f64175151c05e8d4ac741880 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/bca2cc2e/uploads/origins/227b1a31-e43b-4a14-bb2f-6bd874d36538?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=4ac33419c9965f9ef54cdae75832987f", "srcset": "https://si.imgix.net/bca2cc2e/uploads/origins/227b1a31-e43b-4a14-bb2f-6bd874d36538?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=4ac33419c9965f9ef54cdae75832987f, https://si.imgix.net/bca2cc2e/uploads/origins/227b1a31-e43b-4a14-bb2f-6bd874d36538?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=6967516608a4e3fc69575b9df20c54db 2x, https://si.imgix.net/bca2cc2e/uploads/origins/227b1a31-e43b-4a14-bb2f-6bd874d36538?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=2462465a4cf1c84cca39a2e19c8a2994 3x"}, "body": "こんにちは。skebのプロフィールを見つけました。近日公開予定の私の物語のために、イラストの制作を依頼したいのですが：\n\n[設定]\n-約20年前に魔法が現れた現代の世界\n\n[登場人物]\n-ディディとドド：魔法使いを監視・管理する国際組織「UCW」に徴集された、2人の日本人少女（高校生くらいの年齢）。\n-偵察・救出任務を担う低レベルの魔法使い。前線の「魔法少女」として戦うには力が足りない。\n\n[外見・装備]\n- 紺色／グレーの現代的な戦術用ユニフォーム（オプションで都市型迷彩）\n- 魔法の専門分野を反映したベスト／ポーチ（ディディ：回復、ドド：テクノマシー／ハッキング）\n-軽火器（例：グロックやMP5のような拳銃・マシンピストル）\n-オプションのアクセサリー：ミリタリーベレー帽、ヘルメット、保護メガネ\n-ショートパンツ＋パンティストッキング＋膝パッドの組み合わせも可\n\n[雰囲気]\n-初めての任務を控えて、少し不安げ\n\n[構図]\n-シンプルな座り姿または立ち姿のポーズ、適切な照明\n\n[備考] \n-ご自身の独創的なアレンジを加えても構いません\n\nあまり無理な依頼でなければ幸いです。ご検討いただきありがとうございます！", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@hheliebe/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3142554, "client_id": 3631541, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/48c66d77/uploads/origins/22c818c9-b391-4fc3-88db-5191be711b0f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=54d3d4f626396db033a19488d51a07f8", "srcset": "https://si.imgix.net/48c66d77/uploads/origins/22c818c9-b391-4fc3-88db-5191be711b0f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=54d3d4f626396db033a19488d51a07f8, https://si.imgix.net/48c66d77/uploads/origins/22c818c9-b391-4fc3-88db-5191be711b0f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a0c0da14b4ce9efe3b5e1f252e26952c 2x, https://si.imgix.net/48c66d77/uploads/origins/22c818c9-b391-4fc3-88db-5191be711b0f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f8ce187a94c33ea3a7d52aff8cec9e57 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/48c66d77/uploads/origins/22c818c9-b391-4fc3-88db-5191be711b0f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b7c2f90c7e844bfd8951e3d5629dd1f6", "srcset": "https://si.imgix.net/48c66d77/uploads/origins/22c818c9-b391-4fc3-88db-5191be711b0f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b7c2f90c7e844bfd8951e3d5629dd1f6, https://si.imgix.net/48c66d77/uploads/origins/22c818c9-b391-4fc3-88db-5191be711b0f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=fb24f906a797b32a20a5f4fb0dc5fc96 2x, https://si.imgix.net/48c66d77/uploads/origins/22c818c9-b391-4fc3-88db-5191be711b0f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=391a498c2658798bad51243f2d14504e 3x"}, "body": "こんにちは！前回のイラスト、本当に素敵でした！今回もまたお願いしたくて戻ってきました！\nキャラクターは同じですが、今回は軍用ベレー帽と、肩から掛けたコートを着せていただけると嬉しいです。参考画像をドライブに添付しました。\nポーズの参考画像が3つあります。個人的にはポーズ1とポーズ2が好みですが、ポーズ3や全く別のポーズでも構いませんので、お任せします！\n前回同様、壁紙として使ったりSNSに投稿したりするため、解像度は少なくとも2560×1440以上にしていただきたいです。\n以前、マスクを着けたバージョンと外したバージョンのバリエーションをいただいたのですが、とても気に入りました。今回もぜひ同じようなバリエーションを、背景も含めてお願いできますか！\nマスクを着けたバージョンについては、彼の赤い目を少し光らせていただけると嬉しいです！\nあなたの作品が大好きです。またお声がけいただきありがとうございます！\nhttps://drive.google.com/drive/folders/1ipCoLzawjR9jU4y-1JppkpC9PFFnb3t9?usp=drive_link\n\nhttps://drive.google.com/drive/folders/1ipCoLzawjR9jU4y-1JppkpC9PFFnb3t9?usp=drive_link", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@hheliebe/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3142554, "client_id": 3631541, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/b95c71ec/uploads/origins/8d2b455a-46e0-4d44-bb28-0849f6bcfc9e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c3e1370704955576bbf269ee5e8f6780", "srcset": "https://si.imgix.net/b95c71ec/uploads/origins/8d2b455a-46e0-4d44-bb28-0849f6bcfc9e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c3e1370704955576bbf269ee5e8f6780, https://si.imgix.net/b95c71ec/uploads/origins/8d2b455a-46e0-4d44-bb28-0849f6bcfc9e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ecfeee799702604d9669e7ee1fa29925 2x, https://si.imgix.net/b95c71ec/uploads/origins/8d2b455a-46e0-4d44-bb28-0849f6bcfc9e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=898ad92ef1f90fc013e7f392671a2ad7 3x"}, "duration": null, "nsfw": false, "hardcore