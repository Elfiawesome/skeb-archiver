amount": 4000}, {"genre": "correction", "default_amount": 4000}], "acceptable_only_public": false, "tip_acceptable": true, "yearly_report_client_visible": false, "total_appeals_count": 0, "received_works": [{"path": "/@whale_Shark_sig/works/12", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 969613, "client_id": 0, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/9dc9151e/uploads/origins/a59bba75-d230-4b4c-9996-76ea77116b73?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e92c1fbd13c4d205c3ecaa64bfce5736", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/9dc9151e/uploads/origins/a59bba75-d230-4b4c-9996-76ea77116b73?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=8df4f7e3c7c64c076e790917df54f04b", "src_set": ""}, "body": "四十川さんこんばんは\n前回教導艦modeの能代さんがとても素敵だったので、是非今回も能代さんのイラストを下記のような内容でお願いさせて頂けませんか\n\n【衣装】\nhttps://skeb.jp/@whale_Shark_sig/works/10\n↑\nこちらの紫の下着と同じでお願いします\n\n\n【構図】\nhttps://thup.work/miniup/?mode=dl&id=23383\n↑\nこのような構図でベッドに座る能代先生をお願いします\n\n\n【セリフ】\n候補生\n｢…ここにいるのは先生と自分だけでありますから…どうして阿賀野先生や矢矧先生を思い浮かべる必要があるのか、自分には分かりません｣\n\n能代先生\n｢ふーん、気を遣ってくれてるんだ？その様子だとまだ余裕ありそうね｣\n\n\nこのようなオーダーでお願いします\n全体通して各部必要と感じましたらアレンジして頂いて結構です\n今回もありて頂けるのを楽しみにお待ちしております", "nc": 176, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@whale_Shark_sig/works/11", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 969613, "client_id": 643959, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/d6888727/uploads/origins/e7ff94ec-7b55-4beb-a806-481425d99fb3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b16aa5da2bd5e973e1c359b0600b8505", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/d6888727/uploads/origins/e7ff94ec-7b55-4beb-a806-481425d99fb3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=fa9068af0330589acc4ed2305a717506", "src_set": ""}, "body": "四十川さんこんにちは\n前回は理想的な能代先生描いて下さり有難う御座いました\n今回また、下記のような内容で能代先生のイラストをお願いできませんか\n\n【衣装】\nhttps://thup.work/miniup/?mode=dl&id=20060\n↑\nの香取型練習巡洋艦の制服で、能代先生の教導艦modeをお願いしたいです\n大砲その他の装備は無しで服だけで大丈夫です\n各部必要に応じてアレンジして頂いて構いません\n\n【構図】\n能代先生が自身の経験を候補生に話して聞かせている講義風に描いて欲しいです\n構図自体はそのような雰囲気があればどのような物でも歓迎です\n\n【セリフ】\n能代先生\n「あの時には基地の航空隊もだいぶ消耗してしまっていてね。カビエンへの輸送作戦は制空権確保が難しく、それでも強行したの。そこで中破したから、第二次改装も兼ねて本土へ帰還できたわけ」\n\n候補生(セリフのみの描写でお願いします)\n「よくご無事で…。敵勢力圏がこちらのそれと重複している戦域ですから、戦力整備が消耗速度に追い付かないんですね…」\n\nこのようなオーダーで、四十川さんが必要と思われたアレンジはぜひお願いします\n今回も描いて頂けるのをとても楽しみにしております", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@whale_Shark_sig/works/10", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 969613, "client_id": 0, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/d6ff9c80/uploads/origins/4da3b6cc-4437-4327-9360-a22975704395?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b5dd4a65c774f11aa1728f613f210ddd", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/d6ff9c80/uploads/origins/4da3b6cc-4437-4327-9360-a22975704395?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d6ca62799f388d5ec0e08dcd2c3693a8", "src_set": ""}, "body": "四十川さんこんばんは\nhttps://www.pixiv.net/artworks/87174814　で艦これの能代さん描いているのを拝見して、ぜひ能代改二のイラストお願いできないかと思いご都合伺いに参りました\n下記のような内容で御検討お願いいたします\n\n【衣装】【構図】\nhttps://thup.work/miniup/?mode=dl&id=20733　のような感じでお願いします\nスマホ・ピアス・チョーカーは除いて下さい\n\n【セリフ】\n能代さん\n「私でそんなに緊張してると、矢矧や阿賀野姉の前で失神しちゃうわよ？」\n\nセリフ含めた全体のアレンジもして頂いて構いません\nどうぞよろしくお願いいたします", "nc": 49, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@whale_Shark_sig/works/9", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/b23ae1b9/uploads/origins/29f1cb3e-e45c-493c-9ed6-4bed5d39fd99?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=304cd5809fdf0fb1d02ee9aaf677314d", "src_set": ""}, "private": true, "genre": "comic", "tipped": false, "creator_id": 969613, "client_id": 0, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 179, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@whale_Shark_sig/works/8", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 969613, "client_id": 826500, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/ce9ff75d/uploads/origins/c31dcac0-3f98-4f0b-972e-a22017925dad?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=291bda17ba5aec761e6451578b816cff", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/ce9ff75d/uploads/origins/c31dcac0-3f98-4f0b-972e-a22017925dad?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ce4f4770087982316ecc114fd5409ee9", "src_set": ""}, "body": "艦これのFletcher(フレッチャー)に頭を撫でられながら授乳手コキしてもらうところをお願いします。\n\nFletcherの表情は困り顔であやしているセリフを入れて欲しいです。\nセリフ例：「よしよし」「いいこいいこ」「しょうがないですねぇ」など\n上記の雰囲気に合っていれば、これ以外でも構いません。\n\n描きにくいところはアレンジしていただいても構いません。\n\n可能であれば、下記の差分を作成してほしいです。\n・射精\n・母乳の噴き出し\n・表情：母乳を吸われ感じている表情\n・表情：満足げな笑顔\n\n上記以外はお任せいたします。\n以上、よろしくお願いいたします。", "nc": 33, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@whale_Shark_sig/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 969613, "client_id": 0, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/5c47b3d2/uploads/origins/65f0cddb-6872-4be2-9823-232ceb717ca8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=92f6fd1bf9a2838d49b9fab5f85a6d8a", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/5c47b3d2/uploads/origins/65f0cddb-6872-4be2-9823-232ceb717ca8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=82ea217c0832ac4ef9c940e510aa3c2b", "src_set": ""}, "body": "はじめまして、時雨さんの水着イラストお見かけして素敵だなと思い、イラストお願いできるかお邪魔させて頂きに参りました\n\n同じく時雨改三の水着イラストを構図その外統べてお任せで描いて頂けないでしょうか\n\nもしお引き受け可能でしたら、とてもうれしいです", "nc": 48, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@whale_Shark_sig/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 969613, "client_id": 658387, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/f55cdf1c/uploads/origins/88f5c17f-bd70-4672-b73b-1395f3be4d09?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a0328dd262300f8df542fe7d186552db", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/f55cdf1c/uploads/origins/88f5c17f-bd70-4672-b73b-1395f3be4d09?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a4892ec42d016bbe087a6f74c06e9ff2", "src_set": ""}, "body": "健全な絵が多い方なので、性癖の交通事故が起きたらすみません。\n気分を害す意図は無いので、アカンと思ったら読み進めてる最中でもキャンセルしていただいて構いません。\nその時は変態ですみませんでした。\n\n人間家具になってる艦これの響ちゃんの絵をお願いします。ニーソ以外裸で、まんことアナルにバイブを挿入され、ブリッジの姿勢でプルプル震えてます。\n\nソファか、又は地べたに座って、制服姿の吹雪が食卓についています。♂の設定です。\n響ちゃんがテーブルです。響ちゃんのおっぱいは大きめ、吹雪の胸は0でお願いします。\n\n響ちゃんのお腹に料理と飲み物が置かれてます。\n料理はパンとか肉料理とか、特にこだわりはないですが、ナイフみたいな危ないものは置きたくないので、切る必要の無い料理を希望します。\n片手で食える料理なら、右手で響ちゃんのおっぱい弄ったりしててほしいですね。\n下腹部のあたりに、少し泡立った黄色い液体の入ったグラスが置かれてます。\n\n響ちゃんの表情は、恥ずかしそうな涙目で吹雪の方を見ています。\n差分が可能であれば、イッてる表情や放心してる表情をお願いします。\n\n構図は、ブリッジしてる響ちゃんの表情が見れればなんでもいいです。いつもの髪型が好きなので、前髪が逆側に垂れておでこ全開にならないよう、首は反らないで耐えてて欲しいです。\nふわっとしたイメージでは、絵の中心に響ちゃんの体全体をまっすぐ見下して、絵の右側に吹雪の頭頂部を見下ろしてます。\n吹雪の表情はにこやかに笑ってますが、これは構図上見えなければ見えないで全く構いません。\n\n吹雪は食事をしながらＴＶを観ていて、ハメ撮りした響ちゃんの映像を眺めてます。\nTVは画面外に置いたりと、映像は見えなくていいですが、セックスの擬音と、響ちゃんの喘ぎ声の音声をお願いします。\n\n以上です。可能であればよろしくお願いします。", "nc": 33, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@whale_Shark_sig/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 969613, "client_id": 0, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/fd6cfd25/uploads/origins/574166dd-edf7-45cc-95ff-48f267dc3f8a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=12b8f9320fa468772c7f7891008f96a3", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/fd6cfd25/uploads/origins/574166dd-edf7-45cc-95ff-48f267dc3f8a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9916070917f396fcb28c652050fc3c25", "src_set": ""}, "body": "うーまちゃん！\nうーまちゃんに似合いそうな服を考えてほしいです。", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@whale_Shark_sig/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 969613, "client_id": 1095391, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/87736920/uploads/origins/97062563-9468-4481-9edb-0796d54a208c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5e94364b00800daa0f911bfca8481580", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/87736920/uploads/origins/97062563-9468-4481-9edb-0796d54a208c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=2