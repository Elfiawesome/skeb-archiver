, "discover": {"nsfw": true}, "american_express": {"nsfw": true}}}, "acceptable_only_public": false, "tip_acceptable": true, "yearly_report_client_visible": false, "total_appeals_count": 0, "received_works": [{"path": "/@tsurubee1/works/10", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2110964, "client_id": 2122257, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/455fe65c/uploads/origins/a878df84-2d11-484f-bda2-66de904d523b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5eeda3607084a90d783cf55764fbc8bd", "srcset": "https://si.imgix.net/455fe65c/uploads/origins/a878df84-2d11-484f-bda2-66de904d523b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5eeda3607084a90d783cf55764fbc8bd, https://si.imgix.net/455fe65c/uploads/origins/a878df84-2d11-484f-bda2-66de904d523b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=4dd45cf560cfd8f746266089d818af1e 2x, https://si.imgix.net/455fe65c/uploads/origins/a878df84-2d11-484f-bda2-66de904d523b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=209cac15722c4a64bb03f3f9d1d3999d 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/455fe65c/uploads/origins/a878df84-2d11-484f-bda2-66de904d523b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=7b09d820d6be32eef27e9e125dd95c10", "srcset": "https://si.imgix.net/455fe65c/uploads/origins/a878df84-2d11-484f-bda2-66de904d523b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=7b09d820d6be32eef27e9e125dd95c10, https://si.imgix.net/455fe65c/uploads/origins/a878df84-2d11-484f-bda2-66de904d523b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=1f5a1bd36561f27253b6569fdb13b0e6 2x, https://si.imgix.net/455fe65c/uploads/origins/a878df84-2d11-484f-bda2-66de904d523b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=c8483432352d381f301e9e2f52094c03 3x"}, "body": "tsurubeeさん、こんにちは！\n\n今回はダンジョンズ＆ドラゴンズで使う予定の画像についてです。\nhttps://imgur.com/a/Inruyou。\n\n参考画像をもとに、このキャラクターのアートワークを描いていただけたら嬉しいです。ポーズを変えるのも自由です。現在の特徴と変更点のリストを下に書いておきます：\n\nキャラクターは女性で、青い目をしており、身長はおよそ1,80m。\n銀髪で32歳。\n細い金色の線が体全体に広がっている。ラインはわずかに光るようにしてください。\n\n変更点\nこのキャラクターは、参考文献の服の上に「星のローブ」（参考文献：https://dnkl.gg/4jW7S）という黒いローブを着るようになった。\nナイフの代わりに、かすかな星座を映し出す水色のクリスタルを使う。FFXIV』のASTグローブのように、キャラクターの手の上に浮かんでいる。\n\nあなたからの4作目の作品が届くのを楽しみにしています！\nありがとう、ぜな", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@tsurubee1/works/9", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2110964, "client_id": 2122257, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/1ac59480/uploads/origins/23c8b62b-85e2-42e5-ae6a-2ca0c650cb4d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0c6d806336ba7bf578be5571bea968e9", "srcset": "https://si.imgix.net/1ac59480/uploads/origins/23c8b62b-85e2-42e5-ae6a-2ca0c650cb4d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0c6d806336ba7bf578be5571bea968e9, https://si.imgix.net/1ac59480/uploads/origins/23c8b62b-85e2-42e5-ae6a-2ca0c650cb4d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=09e222dffbdfabb6e1ff7e0d22afb6ae 2x, https://si.imgix.net/1ac59480/uploads/origins/23c8b62b-85e2-42e5-ae6a-2ca0c650cb4d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d03e7e09b725b9e3bd9fedb5993cdd80 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/1ac59480/uploads/origins/23c8b62b-85e2-42e5-ae6a-2ca0c650cb4d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0198edd353f26ee888a8281ab67f59d6", "srcset": "https://si.imgix.net/1ac59480/uploads/origins/23c8b62b-85e2-42e5-ae6a-2ca0c650cb4d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0198edd353f26ee888a8281ab67f59d6, https://si.imgix.net/1ac59480/uploads/origins/23c8b62b-85e2-42e5-ae6a-2ca0c650cb4d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=05aed1b9a8e50783858fdae4b88517c1 2x, https://si.imgix.net/1ac59480/uploads/origins/23c8b62b-85e2-42e5-ae6a-2ca0c650cb4d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=66ab175a7d09f60314e3550f57d49049 3x"}, "body": "やあ、tsurubee1!\n私と友人は、またあなたの作品を依頼したいと思っています!\n\n背景。\nクリスタルタワーを中心に、空や山はあまり細かくなくてもいいですが、存在感のあるものをお願いします。\nキャラクター。\n女性キャラクターは塔の左側、男性キャラクターは塔の右側。FFXIVのキャラクター（A/C）をメインに、フィエスタのキャラクター（B/D）はそれほど細かくなくても良い。\n4 人のキャラクターは、背景のリファレンスから崖の上に立ち、フィエスタのキャラクターは FFXIV のキャラクター の隣と少し後ろにいるようにしてください。\nキャラクターはカメラ目線で楽しそうにしているはずです。\n正確なポーズはお任せします。\n武器は4つとも入れてください。(A/C:https://imgur.com/a/oMQ7A82、B/DはFiestaの参考資料より)\n全体的に親しみやすい雰囲気で、キャラクターが幸せそうであること。天候はEverlasting Lightのままでお願いします。\n追加です。\nBとDはFFXIVをプレイする前にプレイしていた「フィエスタ・オンライン」出身なので、ある意味彼らの過去と現在を表現した画像にしたいです。\n\nhttps://imgur.com/a/NVeh1V5", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@tsurubee1/works/8", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2110964, "client_id": 2090064, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/3eaeae63/uploads/origins/cbdead90-e395-433c-8ae4-b7fbbc752f79?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5d79e3efcf09f33c55434947b1524d06", "srcset": "https://si.imgix.net/3eaeae63/uploads/origins/cbdead90-e395-433c-8ae4-b7fbbc752f79?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5d79e3efcf09f33c55434947b1524d06, https://si.imgix.net/3eaeae63/uploads/origins/cbdead90-e395-433c-8ae4-b7fbbc752f79?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=d26ab06de3219afd55289dea97e73e5d 2x, https://si.imgix.net/3eaeae63/uploads/origins/cbdead90-e395-433c-8ae4-b7fbbc752f79?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=21759fe148a25890696c130efbbbd18d 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/3eaeae63/uploads/origins/cbdead90-e395-433c-8ae4-b7fbbc752f79?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=357c0b39e9c85524ad167b74bcb9ae96", "srcset": "https://si.imgix.net/3eaeae63/uploads/origins/cbdead90-e395-433c-8ae4-b7fbbc752f79?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=357c0b39e9c85524ad167b74bcb9ae96, https://si.imgix.net/3eaeae63/uploads/origins/cbdead90-e395-433c-8ae4-b7fbbc752f79?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=05ded44868eefc55ceee5d276931807f 2x, https://si.imgix.net/3eaeae63/uploads/origins/cbdead90-e395-433c-8ae4-b7fbbc752f79?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=97531adf32578296f58529bf035e56ed 3x"}, "body": "Hello, it's been a while since my last request! Similar to my previous one, I'd like to have an art with me and my friend, Az. This time, can you draw us together having fun dancing surrounded by fairy lights? Feel free to add in whatever else you'd like to the background or pose.\n\nReference (mine): https://i.imgur.com/mvgWvm4.png\nReference (Az): https://imgur.com/7IxIgnI\n\nThank you so much for your time and consideration!", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@tsurubee1/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2110964, "client_id": 793877, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/fb5b5cfb/uploads/origins