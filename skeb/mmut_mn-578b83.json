とい表面的には献身的で従っているように見えますが実際には忠誠や敬意もありません。\n身長は180cmです。\n\n資料はこちらをご確認いただければ幸いです。 \nhttps://drive.google.com/drive/folders/1xb5TFm5XzMNnbba24tShNLJtumY-tNAc\n\n髪型や細かい服装、色味、構図、ポーズ等はご自由に描いていただいて大丈夫です！\n元がゲームのocのため人間体ではない資料がありますが、擬人化で描いていただければと思います。\n\n・使用用途\n個人観賞用です。クレジット表記の上、個人利用の範囲で個人のSNSに掲載させていただく可能性があります。商用利用は致しません\n・サイズ形式\nおまかせでお願いいたします\nまた線画や没ラフ等があれば、PSDデータに入れて頂けると嬉しいです。\n\n再送信させていただきました。申し訳ございません\n拙い文章失礼いたしました。\n ご多忙のところ恐縮ではございますがご検討よろしくお願いいたします。", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@mmut_mn/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3803298, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/2fc0b894/uploads/origins/5d191f44-cd69-4635-a455-a4a4318524b6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0fb69dadbe5dc1a5d6c43ea7ef310012", "srcset": "https://si.imgix.net/2fc0b894/uploads/origins/5d191f44-cd69-4635-a455-a4a4318524b6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0fb69dadbe5dc1a5d6c43ea7ef310012, https://si.imgix.net/2fc0b894/uploads/origins/5d191f44-cd69-4635-a455-a4a4318524b6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=3c39813a36ee15e8658e27869cccd4e1 2x, https://si.imgix.net/2fc0b894/uploads/origins/5d191f44-cd69-4635-a455-a4a4318524b6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=eea4c28a34072e1420351282412c7452 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/2fc0b894/uploads/origins/5d191f44-cd69-4635-a455-a4a4318524b6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6f36e9d2481e818f2dc7a055f6b45d8a", "srcset": "https://si.imgix.net/2fc0b894/uploads/origins/5d191f44-cd69-4635-a455-a4a4318524b6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=