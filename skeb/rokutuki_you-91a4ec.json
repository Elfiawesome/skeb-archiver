ろしければ透過ファイルなどもいただけますとうれしいです！ \n  ご検討いただけますと幸いです。 よろしくお願いいたします。", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@rokutuki_you/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3900107, "client_id": 1589220, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/20f24557/uploads/origins/99053fd1-8351-4179-bc51-9cffa95a4f8d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=35cf9532c3fc755699dbe8d79d63cbed", "srcset": "https://si.imgix.net/20f24557/uploads/origins/99053fd1-8351-4179-bc51-9cffa95a4f8d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=35cf9532c3fc755699dbe8d79d63cbed, https://si.imgix.net/20f24557/uploads/origins/99053fd1-8351-4179-bc51-9cffa95a4f8d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e331f6f2e2030e821de41ca8698429fb 2x, https://si.imgix.net/20f24557/uploads/origins/99053fd1-8351-4179-bc51-9cffa95a4f8d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=db846078a643578fdb4ed184e38ca26a 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/20f24557/uploads/origins/99053fd1-8351-4179-bc51-9cffa95a4f8d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b49b4adf4d467dfde57a66137fdfee7b", "srcset": "https://si.imgix.net/20f24557/uploads/origins/99053fd1-8351-4179-bc51-9cffa95a4f8d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b49b4adf4d467dfde57a66137fdfee7b, https://si.imgix.net/20f24557/uploads/origins/99053fd1-8351-4179-bc51-9cffa95a4f8d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=59cc154fd83f4fc557d43775fe2ca012 2x, https://si.imgix.net/20f24557/uploads/origins/99053fd1-8351-4179-bc51-9cffa95a4f8d?bg=%23fff&auto=format%2Ccompress&fm=web