: false, "total_appeals_count": 0, "received_works": [{"path": "/@inu_masho/works/17", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1258048, "client_id": 0, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/b0a1af69/uploads/origins/87629973-8a8b-49fc-a496-0a7351f21c95?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=36f91cf4b2b375fefa94dbab71a8ff5f", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/b0a1af69/uploads/origins/87629973-8a8b-49fc-a496-0a7351f21c95?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d052f1a94f35e41a597c9d345c4c964b", "src_set": ""}, "body": "こんにちは！2回目の依頼をさせて頂きます！\n\n前回と同じく学校の内科検診を受けてる女の子のイラストを描いて頂きたいです。\n\n前回の女の子と同じ学校と言う設定で行きたいので背景や短パンのデザインは前回と同じでお願いします\n\n女の子\n年齢は14歳くらいで、胸の大きさは成長途中くらい、眼鏡は無しで髪の毛は肩より長めでオリジナルの女の子。髪の毛は結んでても降ろしててもどちらでも可。\n\nシチュエーション\n中年医者と上半身裸で面と向かって座って恥ずかしそうな顔をしている\n\n医者\n中年のおじさん先生だと分かれば、聴診器を持つ手だけとかでも何でも大丈夫です。\n\nその他に関してはお任せします。\n\n都合が合えばで構いませんので何卒ご検討の方をよろしくお願いします。", "nc": 48, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@inu_masho/works/16", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/b4e7647f/uploads/origins/24116596-53f1-4786-90ea-89c31862b645?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=551e6b4daf4fa814d606572f01b574d3", "src_set": ""}, "private": true, "genre": "comic", "tipped": false, "creator_id": 1258048, "client_id": 855232, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 33, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@inu_masho/works/15", "private_thumbnail_image_urls": {"src"