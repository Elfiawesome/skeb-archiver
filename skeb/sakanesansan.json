an/works/379", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2892509, "client_id": 3526984, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/8f3ac594/uploads/origins/4e0e6740-ac7c-4f59-86a3-5f2d647b28f9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1055e1f8a21101a891320b81125c8579", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/8f3ac594/uploads/origins/4e0e6740-ac7c-4f59-86a3-5f2d647b28f9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e074360ce8fab268bd7db8d572cd1de4", "src_set": ""}, "body": "初めまして、Vtuberの巫女狐（みここ）たかなと申します。\nアピールありがとうございます。\n作品を拝見したところ、とても素敵なスマホ壁紙でしたので、ぜひ私のキャラクターで描いてもらいたいと思い、依頼しました。\n\n【巫女狐たかなについて】\nゲームが好きなちょっと天然ポンコツ巫女狐。\nイメージは赤やピンク、和風などです。\n\n以下キャラクター資料URLです\nhttps://drive.google.com/drive/folders/1kx4AjQCnBnupGoWKLdvZmujDYwLRQ3qK?usp=drive_link\n\n以上よろしくお願いします。\n\nhttps://drive.google.com/drive/folders/1kx4AjQCnBnupGoWKLdvZmujDYwLRQ3qK?usp=drive_link", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@sakanesansan/works/378", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/dce7fd76/uploads/origins/56e5285c-af68-45f1-a81d-c9b67f36808d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=a519a1b9914c24cb0f8d29b552495ffd", "src_set": ""}, "private": true, "genre": "art", "tipped": false, "creator_id": 2892509, "client_id": 0, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 129, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@sakanesansan/works/377", "private_thumbnail_image_urls": null, "private": false, "genr