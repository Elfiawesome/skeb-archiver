0-8f1b-2b1fe82d4145?bg=%23fff&fm=webp&auto=compress&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=13878184e53aa5f5596d2e0dbe941470 2x, https://si.imgix.net/2d0ebfcf/uploads/origins/9a343fd5-f2a0-4520-8f1b-2b1fe82d4145?bg=%23fff&fm=webp&auto=compress&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=a24d9e058f64ff29c9bc66602e65a1e3 3x"}, "body": "ゲーム上での新規アイコン制作をお願いします。\n普段使用しているアイコンのIFとして\n・白髪\n・オッドアイ（普段と変わらない）\n・マフラー\nの少年（青年）のさくせいになります。\n立ち姿で動きはお任せします。\nメロ儚い子をよろしくお願いします！", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@Omuist/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3797042, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/341e3315/uploads/origins/c0fbedbb-84b2-46c7-979d-3a17ae633eb9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ad63e64a86a7f5a1634848ed1bce26c0", "srcset": "https://si.imgix.net/341e3315/uploads/origins/c0fbedbb-84b2-46c7-979d-3a17ae633eb9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ad63e64a86a7f5a1634848ed1bce26c0, https://si.imgix.net/341e3315/uploads/origins/c0fbedbb-84b2-46c7-979d-3a17ae633eb9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=77d71e08fc447545c03c9f86769c9de1 2x, https://si.imgix.net/341e3315/uploads/origins/c0fbedbb-84b2-46c7-979d-3a17ae633eb9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e4e36498c00f91313df1a2613555224f 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/341e3315/uploads/origins/c0fbedbb-84b2-46c7-979d-3a17ae633eb9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=85c630d04c7cebf178ffd26e3e0ab7f9", "srcset": "https://si.imgix.net/341e3315/uploads/origins/c0fbedbb-84b2-46c7-979d-3a17ae633eb9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=85c630d04c7cebf178ffd26e3e0ab7f9, https://si.imgix.net/341e3315/uploads/origins/c0fbedbb-84b2-46c7-979d-3a17ae633eb9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=149049595cc08999d38c1afb92eb166c 2x, https://si.imgix.net/341e3315/uploads/origins/c0fbedbb-84b2-46c7-979d-3a17ae633eb9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=53731dc5e3b59d878882caff38a2d5fb 3x"}, "body": "こちらでははじめまして、\n〝あるけみすと〟にて、【はのい・にーま】というキャラクターの背後のひとをしている 内臓と申します。この度はプロフィールに飾るためのイラストを描いて頂きたく、リクエストをさせていただきました。\n\n【雰囲気参考】\nHP https://piku.page/@han012ma/evol\nPinterest https://pin.it/WpvUO9Fjw\n\n【簡易情報】\n身長140センチ、見た目年齢は12歳ほどの少女。光の当たり方によってやや青みがかって見えることもある黒髪、ブルースクリーンのような鮮やかな青目。(インターネットに精通した)悪魔であり、電脳世界に入り込むことができます。ハッキング技術と魔界の魔術を組み合わせた〝サイバーマジック〟の使い手。人形のような薄い身体、すらりと細長い手足、白い肌。無垢で無邪気で人間好きな上位存在で、少なくとも666年以上生きている。イメージカラーは青と黒。子どもっぽく無害な美貌の少女にも見えますが、突然何をしでかすかわからない/本当のところは何を考えているか伺い知れない危うさ・怖さを秘めています。人間および人間のつくる〝物語〟（特に詩や童話、戯曲）全般が好き。彼女に惹かれてしまったが為に人生がずたぼろになった人間は数知れず。現在発露する彼女のあらゆる感情や感性はヒトのまねごとであり、根幹はどこまでも魔界生物。\n\n【希望】\n〝あるけみすと〟のプロフィール絵として使用可能な規格の 幅500x高さ750のpng（3mb以下） であり、はのいは微笑んでいるのにどこかダーク／不穏な雰囲気なイラストであることが希望です。そのほか、構図などはすべてお任せします。\n衣装はPinterest内 - 𝑯𝒂𝒏𝒐𝒊_𝒇𝒂𝒔𝒉𝒊𝒐𝒏 フォルダを参照に、黒か白のゴシックなワンピースを着せて頂けるとうれしいです。\n\n【使用用途】\n・〝あるけみすと〟のプロフ絵に設定\n・他、【はのい・にーま】関連の𝕏やdiscordなどに掲載予定。いずれの場合も、商用利用無し／クレジットはかならず入れさせて頂きます。\n\nhttps://drive.google.com/drive/folders/16_8lgezGJiQVvLnp0dtbLeULqCUsH5QK", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@Omuist/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3797042, "client_id": 3084647, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/82e15da2/uploads/origins/82e979b8-c68b-4f1c-9496-425f218f4dc9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2a3a0d80384383f03a85ca351f394f3f", "srcset": "https://si.imgix.net/82e15da2/uploads/o