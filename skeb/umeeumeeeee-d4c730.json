5f\u306e\u306b\u4e00\u4eba\u3060\u3051\u4e0d\u6a5f\u5acc\u3067\u64ae\u5f71\u304c\u7d42\u308f\u3089\u306a\u3044\u5f1f\u306e\u30ed\u30fc\u30c7\u30ea\u30d2\u3002\u304a\u6012\u308a\u306e\u7236\u3001\u80c3\u304c\u75db\u3044\u30be\u30eb\u30bf\u30f3\u3002\u4f55\u3068\u304b\u306a\u3089\u306a\u3044\u304b\u3068\u60a9\u3093\u3067\u3044\u308b\u3068\u3001\u81ea\u5206\u306e\u59bb\u304c\u5f1f\u306e\u9aea\u3092\u7d50\u3063\u305f\u3002\u5c11\u3057\u7167\u308c\u305f\u5f1f\u306e\u59ff\u306b\u300c\u3053\u308c\u3060\u300d\u3068\u64ae\u308d\u3046\u3068\u3059\u308b\u3068\u7167\u308c\u96a0\u3057\u3067\u5148\u7a0b\u3088\u308a\u30e0\u30b9\u30c3\u3068\u3059\u308b\u3002\u3084\u3080\u3092\u5f97\u305a\u3001\u8868\u60c5\u304c\u308f\u304b\u308a\u3065\u3089\u3044\u3088\u3046\u9006\u5149\u306b\u3059\u308b\u306e\u3067\u3057\u304b\u3081\u9762\u306f\u3088\u305b\u3068\u8aac\u5f97\u3057\u64ae\u5f71\u306b\u81f3\u308b\u3002\n\nhttps://twitter.com/ukiukiBoogie/status/1373673542777073668?s=19", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": []}, "price_history": {"art": [{"amount": 3000, "recorded_at": 1774026590.792329}], "video": [{"amount": 3000, "recorded_at": 1774026590.792329}], "correction": [{"amount": 3000, "recorded_at": 1774026590.792329}]}}