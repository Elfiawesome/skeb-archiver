4f-cd06ca609f3b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=cbd28aca33b2a330d6b39d1866d4ac8f", "srcset": "https://si.imgix.net/4c00ac0c/uploads/origins/2bbe62d6-bf70-4568-a34f-cd06ca609f3b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=cbd28aca33b2a330d6b39d1866d4ac8f, https://si.imgix.net/4c00ac0c/uploads/origins/2bbe62d6-bf70-4568-a34f-cd06ca609f3b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=8ea79be7b718afab6ceec0d6c003542e 2x, https://si.imgix.net/4c00ac0c/uploads/origins/2bbe62d6-bf70-4568-a34f-cd06ca609f3b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=767eff601977f2a8f7ac992bd271a8b2 3x"}, "body": "初めまして。\nくすぐりイラストを描いて欲しくて、誰に依頼しようかと思ってた時に、貴方の描いていた制服を着ていた少女のくすぐりイラストがとても良く、skebを開いていたようだったのでリクエストを送らせて頂きました。\n\nガールフレンド（仮）に登場する「正岡真衣」と言う子のくすぐりイラストを描いて頂けませんでしょうか。\nキャラクターのビジュアルに関しては、こちらのURLを参考にしてもらえればと思います\n（1枚目の画像だと伝わりにくいのですが、この子は黒タイツを履いているので、それも描いて欲しいと思い2枚送らせてもらってます）\nhttps://gfkari.gamedbs.jp/images/card/25a9f8173e2c5949a29acac252e6128e.jpg\n\nhttps://gfkari.gamedbs.jp/images/card/824cb92bd0f33f63454354a8c59569df.jpg\n\nシチュエーションですが、この制服のままくすぐって頂きたいです\n\nhttps://www.pixiv.net/artworks/103806009\n\n↑貴方の描いていたこちらのイラストが教室でのじゃれ合い感がとても好きなので、拘束はあえてせず、「教室でのじゃれ合い感のあるくすぐりシーン」な形で描いて頂けないでしょうか。\n\nお忙しい事とは思いますが、ご検討の程よろしくお願い致します。", "nc": 33, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@yumi_do_ra/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3060538, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/c5a03597/uploads/origins/eac11a29-1ab9-4598-9b91-700e53440277?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=30904cf2ad459e9a232db2b531f8fb23", "srcset": "https://si.imgix.net/c5a03597/uploads/origins/eac11a29-1ab9-4598-9b91-700e53440277?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=30904cf2ad459e9a232db2b531f8fb23, https://si.imgix.net/c5a03597/uploads/origins/eac11a29-1ab9-4598-9b91-700e53440277?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b092f922168fb73886656f3a0da4652e 2x, https://si.imgix.net/c5a03597/uploads/origins/eac11a29-1ab9-4598-9b91-700e53440277?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=1a026b2720d13a4e6066f139c91f6bdd 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/c5a03597/uploads/origins/eac11a29-1ab9-4598-9b91-700e53440277?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=10dc45b5760f3c202c5e344eea7d2bc3", "srcset": "https://si.imgix.net/c5a03597/uploads/origins/eac11a29-1ab9-4598-9b91-700e53440277?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=10dc45b5760f3c202c5e344eea7d2bc3, https://si.imgix.net/c5a03597/uploads/origins/eac11a29-1ab9-4598-9b91-700e53440277?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=e00c25a399fccbcdc1fdf5525700282b 2x, https://si.imgix.net/c5a03597/uploads/origins/eac11a29-1ab9-4598-9b91-700e53440277?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=335254b8e6790e8941ae873c01145a5a 3x"}, "body": "すみません、依頼したいことがあります。  \n\n登場人物はくノ一ゆいとひとみです。  \n\nお互いくすぐりで絶頂する恥ずかしい性癖を持っていることに気づき、新しい日課を遂行する内容です。  \n\nお風呂に入る直前、修行の成果を比較して成果が低調な方は優秀な方にくすぐったい罰ゲームを受ける内容です。  \n\nだいたいはひとみが優秀で罰ゲームを受けるのはゆいの方です。  \n\n今回、ひとみがくすぐる方法は、お風呂の床にゆいをうつ伏せにさせてから、腰の上に乗ってお尻をくすぐる方法です。 \n手に泡立ててすべすべした感触でくすぐったい感じを最大限に引き出します。  \n\nゆいは足をバタバタさせますが、ひとみのおっぱいをぷるぷるさせるのが全部、ひとみの好きなだけくすぐり罰ゲームを受けるしかない状況です。  \n\nお風呂に入る直前なので、どちらも全裸で、水に濡れてすべすべした感じだといいのですが。 \nそして、雰囲気はやられるゆいの方もただ嫌いではない楽しい感じにしてもらいたいです。\n\n視点は、ひとみのお腹あたりを中心にして、ゆいのお尻とひとみのおっぱいがよく見えるようにしてほしいです。", "nc": 176, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {