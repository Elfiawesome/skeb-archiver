の画像と同じパンツを履いているのですが、テーブルの上に横たわり、短すぎる拘束衣を着てお腹を出しています。https://drive.google.com/file/d/1EfFZClZyModzy2ErUk-iLmvWCsvrSvMK/view?usp=sharing\n\n最初の画像では、ブライタが怒りにまかせて、自分をそこから出すように捕獲者に叫んでおり、そうしなければ殺すと脅している。次の画像では、手が人差し指で彼女の露出したおなかをつついている。そのため、彼女の怒りに満ちた表情は、笑いをこらえるために口を閉ざした表情へと変化する。\n\n最後の画像は、マニキュアを塗った爪の女性らしい2本の手がブライタのお腹の真ん中をくすぐっている。彼女は目を閉じて涙を流しながら大笑いし、自分の行動を謝り、止めてくれるよう懇願する。", "nc": 33, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@yumi_do_ra/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3060538, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/f86781f6/uploads/origins/4f585847-d19d-4900-912a-79f1f2ab03cc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=eac7ca02c955b8d94b0734e1794d7204", "srcset": "https://si.imgix.net/f86781f6/uploads/origins/4f585847-d19d-4900-912a-79f1f2ab03cc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=eac7ca02c955b8d94b0734e1794d7204, https://si.imgix.net/f86781f6/uploads/origins/4f585847-d19d-4900-912a-79f1f2ab03cc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c330b603c00c3572c76e9f1f5e8e1bdb 2x, https://si.imgix.net/f86781f6/uploads/origins/4f585847-d19d-4900-912a-79f1f2ab03cc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e4795895ffbd6b2414ce8a6e5c968eef 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/f86781f6/uploads/origins/4f585847-d19d-4900-912a-79f1f2ab03cc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2a1e39867d0c74f12cf4b07922e66e1d", "srcset": "https://si.imgix.net/f86781f6/uploads/origins/4f585847-d19d-4900-912a-79f1f2ab03cc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2a1e39867d0c74f12cf4b07922e66e1d, https://si.imgix.net/f86781f6/uploads/origins/4f585