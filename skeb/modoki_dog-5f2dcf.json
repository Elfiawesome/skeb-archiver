す。\n\n自分「100の人」のアバター (♂・モンテコア式戦艦レ級の改変・資料参照) の、ケモロリ化 & 壁画化を描いていただけないでしょうか？\n壁は壊れて穴が開いており、穴の部分が膣になるような感じで壁画化されてしまうというシチュエーションでお願いします。\n穴の部分は溢れ精液、もしくは陰茎を突っ込まれている状態で、意識が残っているような描写が欲しいです。\n\nご検討よろしくお願いします。\n\n【資料URL】\n(3Dビューアー) https://seed.online/items/454f0b82c1eead9c8c6f7695436748b52bf5679672aee881c2d07f359f305b6e\n(スクリーンショット) https://cdn.discordapp.com/attachments/511077066628661271/1041590009381257266/100-re.png\n(スクリーンショット・Tポーズ) https://cdn.discordapp.com/attachments/511077066628661271/1041590009708429324/100-re-front.png", "nc": 43, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@modoki_dog/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 599178, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/68bb02ec/requests/258023_1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=074b11420c2e20e994cea834e5018695", "srcset": "https://si.imgix.net/68bb02ec/requests/258023_1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=074b11420c2e20e994cea834e5018695, https://si.imgix.net/68bb02ec/requests/258023_1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=afd3af6d5e4a5de2ddc7d03b090a2019 2x, https://si.imgix.net/68bb02ec/requests/258023_1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a8f3756da403a7e9d99f69b9513af06e 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/68bb02ec/requests/258023_1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3df32a681f4ecdeb449172ed89e34530", "srcset": "https://si.imgix.net/68bb02ec/requests/258023_1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3df32a681f4ecdeb449172ed89e34530, https://si.imgix.net/68bb02ec/requests/258023_1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=cr