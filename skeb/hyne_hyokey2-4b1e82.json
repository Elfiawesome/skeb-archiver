23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=b998af4e346a556cb3047fccecd220de 3x"}, "body": "こんにちは！あなたの「ログいぬ」のイラストを見るのはいつも楽しみです。とても幻想的で魅力的ですね！\n\n私のキャラクターの相棒のイラストをお願いしてもよろしいでしょうか？\nhttps://hamsphrey.notion.site/blueberry-3689b0d97f42804fa5f2d23ad4f879e5\n\nガラス製の風鈴とウミウシをモチーフにした生き物です。本来の姿はかなり小さくて弱々しいのですが、友人の幻術の助けを借りれば、より大きく威圧的な姿（幻影の姿）に変身することができます。\nお菓子やベリー類（特にブルーベリー）が大好きです。雨も好きですが、雨が降ると大きな葉っぱや傘の下に隠れるのが好きです。\n特別な能力は持っておらず、たいていは風に乗って気ままに漂うことを楽しんでいます。\n\n詳細や構成は自由です。自由に描いてください！\n可能であれば、署名は別のレイヤーにしていただけると助かります。\nこのリクエストをご検討いただき、ありがとうございます！\n\nhttps://hamsphrey.notion.site/blueberry-3689b0d97f42804fa5f2d23ad4f879e5", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@hyne_hyokey2/works/15", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3887744, "client_id": 3527041, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/33397830/uploads/origins/0d2eba42-de2f-4dfc-8cd3-0aed46fda3d7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c2f5b0c05497faee5de455bcc0cdca41", "srcset": "https://si.imgix.net/33397830/uploads/origins/0d2eba42-de2f-4dfc-8cd3-0aed46fda3d7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c2f5b0c05497faee5de455bcc0cdca41, https://si.imgix.net/33397830/uploads/origins/0d2eba42-de2f-4dfc-8cd3-0aed46fda3d7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=17a65b62f344c23a6415a44731074643 2x, https://si.imgix.net/33397830/uploads/origins/0d2eba42-de2f-4dfc-8cd3-0aed46fda3d7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=15bc1191d183365df40034d6262e1bed 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/33397830/uploads/origins/0d2eba42-de2f-4dfc-8cd3-0aed46fda3d7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=887123443d7b7e81b18b94ac3aee41f0", "srcset": "https://si.imgix.net/33397830/uploads/origins/0d2eba42-de2f-4dfc-8cd3-0aed46fda3d7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=887123443d7b7e81b18b94ac3aee41f0, https://si.imgix.net/33397830/uploads/origins/0d2eba42-de2f-4dfc-8cd3-0aed46fda3d7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=31efef7bf2260cb4731d091cb82a142a 2x, https://si.imgix.net/33397830/uploads/origins/0d2eba42-de2f-4dfc-8cd3-0aed46fda3d7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=f720ab57b727254fddf16de94ad31b4e 3x"}, "body": "先生、こんにちは！ \n 私のCPを描いていただけませんか？\n\nCOSMO x ASYA（コスモ×アーシャ）\nウルフドッグ ×ウサギ（直立した耳）\nCOSMO : 気まぐれな存在で、人を欺くことを楽しみ、気ままに生きる。\nモチーフ：宇宙、煙、サイケ、狼\nASYA : 気楽で無邪気な青年で、いつも優しい微笑みを浮かべている。\nモチーフ：流れ星、兎の心臓、金色の小麦、エメラルド\n*ぜひそのモチーフをご覧ください。\n\n二人はよく軽口を叩き合い、からかい合う関係。彼らは互いにとても気楽に過ごしている。\n\nご検討いただきありがとうございます。\n\nhttps://drive.google.com/drive/folders/1_etUV9hpQDYF7M8muF2U3dI9u4EI8vlR", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@hyne_hyokey2/works/14", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3887744, "client_id": 1971694, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/70da9d46/uploads/origins/c726ed02-784f-43bc-84e4-23fb3cdc4b10?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=48314f074b00c11692e8dd4a688a0071", "srcset": "https://si.imgix.net/70da9d46/uploads/origins/c726ed02-784f-43bc-84e4-23fb3cdc4b10?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=48314f074b00c11692e8dd4a688a0071, https://si.imgix.net/70da9d46/uploads/origins/c726ed02-784f-43bc-84e4-23fb3cdc4b10?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=63d837d7493848c0cf765c29bfa4889e 2x, https://si.imgix.net/70da9d46/uploads/origins/c726ed02-784f-43bc-84e4-23fb3cdc4b10?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e11a72ede4ba484f38a00d8154cb951c 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/70da9d46/uploads/origins/c726ed02-784f-43bc-84e4-23fb3cdc4b10?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=bd47d729cd387f9b50a98b9a5e578e09", "srcset": "https://si.imgix.net/70da9d46/uploads/origins/c726ed02-784f-43bc-84e4-23fb3cdc4b10?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=bd47d729cd387f9b50a98b9a5e578e09, https://si.imgix.net/70da9d46/uploads/origins/c726ed02-784f-43bc-84e4-23fb3cdc4b10?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=eda528925201024f95669a82d50402e9 2x, https://si.imgix.net/70da9d46/uploads/origins/c726ed02-784f-43bc-84e4-23fb3cdc4b10?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=4aae7fdb5d137f582f00a329c02884e8 3x"}, "body": "イヌヤマダさんこんにちは、もしよければわたしのキャラクターを描いてもらえませんか? \n\n女性\n髪はサックスブルー、目はピンクです。大人っぽく安定感のあるタイプで、27歳です。身長は175センチです。\n彼女は狼人種であり、満月の夜になると制御が効かず、血に飢えた狼人に変身してしまいます。\n非常に強くで、協会では誰も手を出せない超難易度の依頼を受けることがあります。時には他の人やモンスターの血を浴びて協会に戻ることもあります。武器は大きい斧です。\n初対面の人には無愛想で慎重ですが、親しくなると意外と面倒見が良い一面も見せます。また、彼女はお酒を飲むのが大好きです。\n\n男性\n赤い髪に金色の目で、27歳です。身長は185センチです。\n彼はドラゴンと人間の混血であり、目は金色と黒色の異なる瞳を持っています。普段の姿は普通の人と変わりませんが、時折角やドラゴンの鱗を見せることがあります。基本的に弱気な表情を見せることはなく、たとえ死の危機に直面しても余裕を持った態度を崩さず、とても頑固です。\n彼の血液には、女性の嗜血症状を和らげる特別な効果があります。\n\n関係\n男性は女性の強さに興味を持って近づいてくることがあります。面白い理由もありますが、強い者同士が引き寄せ合うようなものでもあります。\n女性は男性がとても怪しいと感じていましたが、彼の血液の効果が非常に役立つため、一緒に行動することを了承しました。\n\nhttps://drive.google.com/drive/folders/1MkROMQIGNgUq0P5sPva8-Jy9XQPVv3bu?usp=share_link\n\nもふもふの狼と龍をお願いします。（龍はもふもふしなくても構いません）\nもし納品の中でラフなどを含んだPSD形式であれば嬉しいです。\nどうぞ自由にしてください。\nお忙しい中ご検討頂きありがとうございます。", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"