ーは神話生物探検隊の隊員で、ドラゴンに対して強い興味を持ち、完全に夢中になっています。天然ブラックな面がある疑いも…\n\n構図と姿勢は自由に決めてください。服装も任意に変更できますので、自由に描いてください！  \n\n彼らとの関係を自由に説明して描いてください。もし他の考えがあれば、自由に描くこともできます（*^3^）  \n\n金額が足りない場合は、適切に再送信してください。問題ありません。ご検討ください。受け入れていただければ、とても嬉しいです！！よろしくお願いします。", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@hyne_hyokey2/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3887744, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/cbf24958/uploads/origins/e4dd63c8-3ba0-4b86-915d-c8c48ca7eac3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=aede189cdbfa8fb3242752019a8e444e", "srcset": "https://si.imgix.net/cbf24958/uploads/origins/e4dd63c8-3ba0-4b86-915d-c8c48ca7eac3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=aede189cdbfa8fb3242752019a8e444e, https://si.imgix.net/cbf24958/uploads/origins/e4dd63c8-3ba0-4b86-915d-c8c48ca7eac3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e0d644952e5d2551b44ca8ae39c6d85f 2x, https://si.imgix.net/cbf24958/uploads/origins/e4dd63c8-3ba0-4b86-915d-c8c48ca7eac3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=fff7b3cbe2b0e3874579c53b50c940ad 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/cbf24958/uploads/origins/e4dd63c8-3ba0-4b86-915d-c8c48ca7eac3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d46407285d157b3d8b45d0fd47fd3eb6", "srcset": "https://si.imgix.net/cbf24958/uploads/origins/e4dd63c8-3ba0-4b86-915d-c8c48ca7eac3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d46407285d157b3d8b45d0fd47fd3eb6, https://si.imgix.net/cbf24958/uploads/origins/e4dd63c8-3ba0-4b86-915d-c8c48ca7eac3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=