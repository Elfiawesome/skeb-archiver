テリアスで魅力的な性格の列車運転手です。彼の乗る列車は空を飛び、夜にしか現れません。一見無邪気に見えますが、彼と列車からはどこか不気味で不安を煽るようなオーラが漂っています。その列車はどこから来て、どこへ向かっているのでしょうか？\n彼を、車掌帽をかぶった青いアヒルとして描いていただけたらと思っています。周りには黄色いアヒルたちがたくさんいるのもいいかもしれません！\nぜひ自由にアレンジして、私を驚かせてください！\n\n参考となるモチーフ：オリエント急行、1920～1930年代のイギリス、ゴム製のアヒル、行方不明者、殺人ミステリー、列車の切符、星、雲、夜空、シュルレアリスム、幽霊のような姿、タイムループ、物事は見た目通りではない\n参考画像：\nhttps://drive.google.com/drive/folders/1egbeoMRiEpXimlcb_Uy5DKZW-ODfluwu?usp=sharing", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@hyne_hyokey2/works/12", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3887744, "client_id": 234985, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/ef6cdbc3/uploads/origins/79aa9b81-3b20-4c97-8f5a-5641c8d53ab7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e4fe31180ddfc2478b4e9eda32c49953", "srcset": "https://si.imgix.net/ef6cdbc3/uploads/origins/79aa9b81-3b20-4c97-8f5a-5641c8d53ab7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e4fe31180ddfc2478b4e9eda32c49953, https://si.imgix.net/ef6cdbc3/uploads/origins/79aa9b81-3b20-4c97-8f5a-5641c8d53ab7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ae617bb77e54abe4a4c836c75c41ba7e 2x, https://si.imgix.net/ef6cdbc3/uploads/origins/79aa9b81-3b20-4c97-8f5a-5641c8d53ab7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a742836e25f3efbe32a34cd71b9aac78 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/ef6cdbc3/uploads/origins/79aa9b81-3b20-4c97-8f5a-5641c8d53ab7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2e49a7a289f70230dbb104354b490a86", "srcset": "https://si.imgix.net/ef6cdbc3/uploads/origins/79aa9b81-3b20-4c97-8f5a-5641c8d53ab7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2e49a7a289f7