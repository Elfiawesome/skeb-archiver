シチュエーションで描いていただけませんか？ 変態たちがよだれを垂らすようなシチュエーションで。まるで視聴者を何かへと誘っているかのような感じにしてください。あなたならきっとそんなアイデアを思いつけるはず！ デフォルトの服装で描く必要はありません。シチュエーションに合うなら、別の服を着せていただいても構いません。\n\nリクエストを読んでいただきありがとうございます！", "nc": 177, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 229504, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "川良くも💭イラストレーター", "screen_name": "somegumo", "avatar_url": "https://pbs.twimg.com/profile_images/1541636700220563456/2W2V7vux.jpg", "header_url": "https://pbs.twimg.com/profile_banners/997391199278252033/1630245859/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "art"}, {"genre": "correction"}], "banned": false, "nc": 1}, {"id": 709421, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "日ノ島@スーパーのんびりモード", "screen_name": "Hinoshima_6", "avatar_url": "https://pbs.twimg.com/profile_images/2049470190627463168/MM6vmvbl.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1038683269615607809/1783837842/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "art"}], "banned": false, "nc": 144}, {"id": 2012151, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "かりん", "screen_name": "trtr_ksy", "avatar_url": "https://pbs.twimg.com/profile_images/1386570942579580928/o5uzNIqe.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1386354075487281152/1620317748/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by":