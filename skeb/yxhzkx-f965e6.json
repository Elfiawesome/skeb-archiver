FUl-jvYTM5OuTcWSLJOY9n \n※服飾の簡略化やアレンジ、変更など自由にしていただいて大丈夫です。\n\nできれば少年時代の姿でお願いしたいですが、もし先生が大人になった二人を描きたい場合は、そちらでも構いません。\n\n表情、ポーズなどの解釈、背景の有無、不明点も全てお任せ致します。 \n構図やサイズを含め、先生の完全に自由な解釈で描いていただければ幸いです。\n\n▼【使用用途】\n・個人利用です。\n・SNSのアイコン、ヘッダーへの使用や投稿\n・個人鑑賞目的での印刷や非商用グッズ化等、営利利用は一切いたしません。\n\nまた、ご依頼内容が難しいと感じられた場合は、キャンセルしていただいても構いません。\n\n最後までお読みいただき、本当にありがとうございました。\nご縁がありましたら、何卒よろしくお願い申し上げます。", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}], "sent_works": [], "similar_creators": [{"id": 1939563, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "砂", "screen_name": "sunasuna_3", "avatar_url": "https://pbs.twimg.com/profile_images/1565356075389292546/e6on3oDn.png", "header_url": "https://pbs.twimg.com/profile_banners/1449698958226296838/1788188449/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 90, "skills": [{"genre": "art"}], "banned": false, "nc": 129}, {"id": 2294396, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "や よ た.", "screen_name": "0804ysk_", "avatar_url": "https://pbs.twimg.com/profile_images/1578306025534685184/gvF_VuYL.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1578303967502929920/1785666537/1500x500", "appeal_receivable": true, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 70, "skills": [{"genre": "art"}, {"genre": "comic"}, {"genre": "video"}], "banned": false, "nc": 0}, {"id": 2976404, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "1008", "screen_name": "origami_1008", "avatar_url": "https://pbs.twimg.com/profile_images/1761008790244356096/-etyJmDQ.jpg", "header_url": "https://pbs.twimg.com/profile_banners/81618