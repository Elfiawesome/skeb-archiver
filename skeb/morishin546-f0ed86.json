net/9b7e9f81/uploads/origins/46001af2-f445-4ef5-87d4-4074f38c79b6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=cedc0d4489fcee470761356d6cf9ca43", "srcset": "https://si.imgix.net/9b7e9f81/uploads/origins/46001af2-f445-4ef5-87d4-4074f38c79b6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=cedc0d4489fcee470761356d6cf9ca43, https://si.imgix.net/9b7e9f81/uploads/origins/46001af2-f445-4ef5-87d4-4074f38c79b6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=6f9d94172c6eefa12cf5b2a856e72d6e 2x, https://si.imgix.net/9b7e9f81/uploads/origins/46001af2-f445-4ef5-87d4-4074f38c79b6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=e8f885ecfa709c1867ba687a5a8fb323 3x"}, "body": "初めまして、もりしん様。絵を拝見して是非リクエストしたいと思いました。\nキャラ：聖剣伝説3　リース（光クラス_ヴァナディースの状態）下のメインキャラ資料などを参考に。\n構図：可能なら頭から足先まで全身見える構図で。\nシチュエーション\n強力なモンスターに苦戦、魔法陣のバリアを展開し相手の攻撃を何とか防いで抵抗している。という描写をお願いします。\n●槍や鎧（兜や胸部鎧、肩部鎧の宝玉など）にヒビ割れなどの描写を入れて中破状態の感じに。\n●脚部や腰鎧、腰の白い布、ストッキングは少し破れやヒビがある程度で、欠落部はあまり無い感じに。\n●身体は傷ついて少し血が滲み、残り体力60～70％位のイメージで。\n●シチュエーションは参考資料を参考に（雰囲気の参考程度に使って下さい、構図やポーズ、詳細はお任せします。お好きにアレンジして下さい）\n●モンスターは下のモンスター資料を参考に（触手を持ったモンスター。詳細はお任せします。）\n面倒なリクエストで申し訳ありません。もし気が向いた時受けて頂ければうれしいです。\n\nhttps://drive.google.com/drive/folders/1vJOmCdUooVFArr0M7NoTeNfyudLNARan", "nc": 40, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@morishin546/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2601811, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/0718165f/uploads/origins/dad615b6-7b8a-4a69-a04c-e64208c22d85?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b12f2cb80bbdeb97882052a9972e9b78", "srcset": "https://si.imgix.net/0718165f/uploads/origins/dad615b6-7b8a-4a69-a04c-e64208c22d85?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b12f2cb80bbdeb97882052a9972e9b78, https://si.imgix.net/0718165f/uploads/origins/dad615b6-7b8a-4a69-a04c-e64208c22d85?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=d088e2d26678081b68088272905ceccf 2x, https://si.imgix.net/0718165f/uploads/origins/dad615b6-7b8a-4a69-a04c-e64208c22d85?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=96462140a7b64546c63a2b396ccd28d4 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/0718165f/uploads/origins/dad615b6-7b8a-4a69-a04c-e64208c22d85?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e791a9748324deeee577ce297a4d1786", "srcset": "https://si.imgix.net/0718165f/uploads/origins/dad615b6-7b8a-4a69-a04c-e64208c22d85?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e791a9748324deeee577ce297a4d1786, https://si.imgix.net/0718165f/uploads/origins/dad615b6-7b8a-4a69-a04c-e64208c22d85?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=5aaaa7dea429c8cb056edafd4860f1dd 2x, https://si.imgix.net/0718165f/uploads/origins/dad615b6-7b8a-4a69-a04c-e64208c22d85?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=c39be52cd030cf247c3c093d2978de68 3x"}, "body": "はじめまして。\nこちらは「Sレア装備の似合う彼女」という漫画の25話のワンシーンであり、ヒロインであるユリナ・エア（以下 ユリナ）というキャラクターが人型モンスターである蛾女に捕まり、毒鱗粉を吸わされそうになっているところです。\nhttps://imgur.com/eoQ8awE\n上記のシーンに続く形で『蛾女の翅に包み込まれるように捕まった状態で、彼女の胸に顔をうずめられて苦しそうなユリナ』をお願いします。\n\nユリナの上半身は蛾女の翅で落ちないようにがっしりとホールドされて身動きが取れず、頭部は蛾女の手で彼女の豊満な胸に押し込まれている、いわゆるブレストスムーザーを仕掛けられている状態といった感じのシチュエーションです。\n両者ともに着衣の状態でお願いします。胸の谷間、下着の露出くらいなら大丈夫です。\nその他具体的な構図はお任せします。\n\nキャラデザインの参考資料（細部まで再現しなくても大丈夫です。分からないところは簡略化してください。）\nhttps://i.imgur.com/M0KADMU.jpg\nhttps://i.imgur.com/G4qnui4.png\nhttps://i.imgur.com/htLWdeJ.png", "nc": 48, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path"