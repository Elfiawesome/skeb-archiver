ばよろしくお願い致します。\n\nキャラ\nうちのこの魔法少女変身前\n資料URLに三面図がございます。\n\n内容\n触手生物に敗北して魔法力が切れ変身前に戻ったところを触手の苗床にされ\nアナルに触手なり異型生殖器を突っ込まれながら出産しているシーンをお願い致します。\n\n資料URL画像2のようにお尻側から見上げた視点で床にボトボト軟体生物を産み落としてる感じで。\n\n上記でご検討お願い致します。\n\nhttps://drive.google.com/drive/folders/13YCHHWXm0EzDgTg_zNJ6OaOIuBqxLNXL", "nc": 185, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@morishin546/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2601811, "client_id": 3190811, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/1e7a6c73/uploads/origins/b2d2e7e1-9eb0-416a-b4a1-725bbac3a554?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d45abea06f4545404edcb00888603409", "srcset": "https://si.imgix.net/1e7a6c73/uploads/origins/b2d2e7e1-9eb0-416a-b4a1-725bbac3a554?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d45abea06f4545404edcb00888603409, https://si.imgix.net/1e7a6c73/uploads/origins/b2d2e7e1-9eb0-416a-b4a1-725bbac3a554?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=68617d5d137fab6e54f6f980b079440b 2x, https://si.imgix.net/1e7a6c73/uploads/origins/b2d2e7e1-9eb0-416a-b4a1-725bbac3a554?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=2da9d920168883ff6cc8ee7e001ffa94 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/1e7a6c73/uploads/origins/b2d2e7e1-9eb0-416a-b4a1-725bbac3a554?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=aa2128f8dce21e833948196c37d1cac2", "srcset": "https://si.imgix.net/1e7a6c73/uploads/origins/b2d2e7e1-9eb0-416a-b4a1-725bbac3a554?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=aa2128f8dce21e833948196c37d1cac2, https://si.imgix.net/1e7a6c73/uploads/origins/b2d2e7e1-9eb0-416a-b4a1-725bbac3a554?bg=%23fff&auto=format%2Ccompre