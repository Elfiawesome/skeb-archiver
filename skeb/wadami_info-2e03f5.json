いており、いつも一緒に行動しています。\n構図等は全てお任せしますが、天真爛漫だと分かる雰囲気だととても嬉しいです。\n\n条件が良ければよろしくお願いします！\n\n参考ツイート\n\nhttps://twitter.com/hakuto_iwashi/status/1289010332157976576", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 766695, "creator": true, "nsfw_acceptable": false, "acceptable": false, "name": "IZ（あいぜっと）@『Witch's Heart』の中の人。", "screen_name": "blueiziz", "avatar_url": "https://pbs.twimg.com/profile_images/1704769743725666304/1Cf7deKu.png", "header_url": "https://pbs.twimg.com/profile_banners/962013116765675521/1734268894/1500x500", "appeal_receivable": true, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "art"}], "banned": false, "nc": 48}, {"id": 2017625, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "しろえ", "screen_name": "sousaku_suru", "avatar_url": "https://pbs.twimg.com/profile_images/2018673500727525376/QFBm75zE.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1203287673491738625/1677945948/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 90, "skills": [{"genre": "art"}], "banned": false, "nc": 177}, {"id": 2934401, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "おぐらちゃん｡@ホロクル11 C-13", "screen_name": "OGURA32", "avatar_url": "https://pbs.twimg.com/profile_images/2010603234713624576/o0YhECcN.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1215568317408169984/1717328287/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days"