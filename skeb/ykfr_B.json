されにくい。\n雨と風を操る力を持つ。\n\n🌩️黒髪のほう\n髪と鱗が黒くて、瞳は金色。肌は灰色っぽい。\n荒っぽい雰囲気で、警戒心が強い。大体いつも機嫌が悪い。\n雷を操る力を持つ。\n\n【共通のこと】\nおでこや腕など、体の表面に鱗があります。\n耳は尖っていて、いわゆるエルフ耳です。\n人間との戦いに負けて長い間封印されていたことがあるため、人間のことが嫌いです。\nふたりともあんまり笑いません。\nお互いの認識は兄弟（双子）に近い感じです。\n\n細かいことは気にせず、よくBさまの解釈のまま自由に描いていただけたらと思います。\n再送やキャンセルなどはお気軽に！\n何卒ご検討のほどよろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/1bFKJfO7pTS9UtV3t7ykXFG-5BZkYGvFc", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@ykfr_B/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3870549, "client_id": 1533673, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/e00ae7d4/uploads/origins/611d143f-fd96-417a-9baa-e11c3cb76d6d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=92ae5830d235d977477f6c1f81e9ca61", "srcset": "https://si.imgix.net/e00ae7d4/uploads/origins/611d143f-fd96-417a-9baa-e11c3cb76d6d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=92ae5830d235d977477f6c1f81e9ca61, https://si.imgix.net/e00ae7d4/uploads/origins/611d143f-fd96-417a-9baa-e11c3cb76d6d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=23186d2c9f10deeb4a20d157fbd6cf21 2x, https://si.imgix.net/e00ae7d4/uploads/origins/611d143f-fd96-417a-9baa-e11c3cb76d6d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=5d68731b6bf7f446179eee0588fb9b15 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/e00ae7d4/uploads/origins/611d143f-fd96-417a-9baa-e11c3cb76d6d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=87c36715bdb6d081ccc937ec2c838ae2", "srcset": "https://si.imgix.net/e00ae7d4/uploads/origins/611d143f-fd96-417a-9baa-e11c3cb76d6d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=87c36715bdb6d081ccc937ec2c838ae2, https://s