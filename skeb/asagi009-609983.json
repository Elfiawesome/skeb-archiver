イブを楽しんだり、夕日が綺麗な海岸を歩きながら彼女はいないのか？と他愛のない話をしたり、ぎこちなく料理をして2人でオムライスを食べるシーン、部屋の中で静かに語り合うシーンもありました。\n\nいんげん様の描きやすいように、自由に描いて頂ければと思います。\n\nお忙しい中恐縮ですが、機会をいただけますと幸いです。ご検討のほど宜しくお願いいたします。\n\nhttps://drive.google.com/drive/folders/1IjwnXWIl6UfFOGIxsmfMZblMCfZf0KxN", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}], "similar_creators": [{"id": 90154, "creator": true, "nsfw_acceptable": true, "acceptable": false, "name": "海底囚人／DSP", "screen_name": "funamusea", "avatar_url": "https://pbs.twimg.com/profile_images/1970294062084431878/ubGuSbt-.png", "header_url": "https://pbs.twimg.com/profile_banners/3224022277/1774451305/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 7, "complete_expiration_days": 120, "skills": [{"genre": "art"}, {"genre": "comic"}], "banned": false, "nc": 49}, {"id": 124505, "creator": true, "nsfw_acceptable": false, "acceptable": false, "name": "ダンボール", "screen_name": "dannbo_rukunn", "avatar_url": "https://pbs.twimg.com/profile_images/1077728956114030592/ZgrIRz3a.jpg", "header_url": "https://pbs.twimg.com/profile_banners/863698945888854016/1524670559/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 7, "complete_expiration_days": 30, "skills": [{"genre": "art"}, {"genre": "correction"}], "banned": false, "nc": 145}, {"id": 766695, "creator": true, "nsfw_acceptable": false, "acceptable": false, "name": "IZ（あいぜっと）@『Witch's Heart』の中の人。", "screen_name": "blueiziz", "avatar_url": "https://pbs.twimg.com/profile_images/1704769743725666304/1Cf7deKu.png", "header_url": "https://pbs.twimg.com/profile_banners/962013116765675521/1734268894/1500x500", "appeal_receivable": true, "popular_creator_rank": null, "request_master_rank": nu