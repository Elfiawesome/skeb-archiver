です。参考文献はこちらのリンクからご覧いただけます： https://drive.google.com/drive/folders/1bBHnPkibmpyv49FGPHgY8wCsCke6maYO?usp=sharing\n\n背景には他の観客もいるが、少年と少女が強調されている。写真の構図は舞台を横から見たもので、舞台上の平和と舞台下の退場という矛盾を強調している。\n\nこのファンアートは個人的な使用を目的としています。また、SNSでの使用を許可していただけると幸いです。\n\n金額が足りない場合は、再入力またはキャンセルをお願いします。\n\nご検討のほど、よろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/1bBHnPkibmpyv49FGPHgY8wCsCke6maYO?usp=sharing", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@coc_tera/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2506753, "client_id": 1223216, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/9541c366/uploads/origins/0c29cf2a-9b43-4ffe-82d5-cf764f19d810?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2ef6e7638147c7e8e2b0ced68a04d32d", "srcset": "https://si.imgix.net/9541c366/uploads/origins/0c29cf2a-9b43-4ffe-82d5-cf764f19d810?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2ef6e7638147c7e8e2b0ced68a04d32d, https://si.imgix.net/9541c366/uploads/origins/0c29cf2a-9b43-4ffe-82d5-cf764f19d810?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=fc986d39181b45881ecf4c5360789886 2x, https://si.imgix.net/9541c366/uploads/origins/0c29cf2a-9b43-4ffe-82d5-cf764f19d810?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=181f2d18c201772d077af14b575b692e 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/9541c366/uploads/origins/0c29cf2a-9b43-4ffe-82d5-cf764f19d810?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=cda1d465176b3181a36295e6a86cf32e", "srcset": "https://si.imgix.net/9541c366/uploads/origins/0c29cf2a-9b43-4ffe-82d5-cf764f19d810?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=cda1d465176b3181a36295e6a86cf32e, https://si