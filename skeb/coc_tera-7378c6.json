/A96569006/status/1850043276751143422　　※卓報告のスクショ\nhttps://x.com/19namelesssheep/status/1850055253284225506　　※HO１さんのディスプレイ\nhttps://x.com/akakakme/status/1842528613402558686　　※HO２さんとHO３さんのディスプレイ\nhttps://x.com/toapuguyaritai/status/1842584622850617482　　※HO４さんのディスプレイ\nhttps://books.rakuten.co.jp/rb/17896879/?variantId=17896879　　※怪盗のイメージ\nhttps://gamerch.com/shoumetsu/32940　　※新婦のイメージ\nhttps://gamerch.com/shoumetsu/65683　　※アリスのイメージ", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@coc_tera/works/4", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/b1d6b2c0/uploads/origins/8e855141-f0fb-4f80-b362-7d814ad0e9bb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=ef3784424ee0f5b3bafc5747935cb9a2", "srcset": "https://si.imgix.net/b1d6b2c0/uploads/origins/8e855141-f0fb-4f80-b362-7d814ad0e9bb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=ef3784424ee0f5b3bafc5747935cb9a2, https://si.imgix.net/b1d6b2c0/uploads/origins/8e855141-f0fb-4f80-b362-7d814ad0e9bb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=21154f8e100e664f00e44cc2e1f2f3f3 2x, https://si.imgix.net/b1d6b2c0/uploads/origins/8e855141-f0fb-4f80-b362-7d814ad0e9bb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=28fd27225d572856ba1f768bf274820e 3x"}, "private": true, "genre": "art", "tipped": false, "creator_id": 2506753, "client_id": 2371015, "nc": 16}, {"path": "/@coc_tera/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id":