_urls": {"src": "https://si.imgix.net/3131e9d8/uploads/origins/227d56a4-90d2-4f7d-8a43-73b907e1a3b5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=91b8e0b9e00f4d3fbbd9f37f46a54e1a", "srcset": "https://si.imgix.net/3131e9d8/uploads/origins/227d56a4-90d2-4f7d-8a43-73b907e1a3b5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=91b8e0b9e00f4d3fbbd9f37f46a54e1a, https://si.imgix.net/3131e9d8/uploads/origins/227d56a4-90d2-4f7d-8a43-73b907e1a3b5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=62fe0a08548cd18fe64fa10945ac917b 2x, https://si.imgix.net/3131e9d8/uploads/origins/227d56a4-90d2-4f7d-8a43-73b907e1a3b5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=b2d669a4d8118ce61b06067e6e262da5 3x"}, "body": "*本リクエストは二次創作です。NGであれば気になさらずキャンセルしてくださいませ！\n\nこんにちは、はじめまして。\n先生のLB6関連のイラストが本当に大好きで、どの作品も心を揺さぶられる素晴らしいものばかりでした。\nそのため、失礼を承知の上で今回リクエストさせていただきました。\n\n依頼内容は、アルトリア・キャスター、バーヴァン・シー、そしてモルガンの三人が、夕日の差す海辺にいる情景です。\nあたたかい雰囲気で描いていただければ嬉しいです。\n衣装などは先生のご自由にお任せします。\n\n*もし金額が足りない場合は、ぜひリクエストの再送申請をお送りください。", "nc": 48, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Jul_humi/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3601158, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/d9549849/uploads/origins/aca1333a-566f-41fc-aa28-637109458060?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c50841285994c04da6146f0f3f427844", "srcset": "https://si.imgix.net/d9549849/uploads/origins/aca1333a-566f-41fc-aa28-637109458060?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c50841285994c04da6146f0f3f427844, https://si.imgix.net/d9549849/uploads/origins/aca1333a-566f-41fc-aa28-637109458060?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=6a0e2b27c5c73e66babe0