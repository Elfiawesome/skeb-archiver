tantan/status/1990043376956186789\n\n■備考\n可能であれば背景を透過した人物のみのデータをいただけると嬉しいです。\n\n■使用用途\n・Twitch、Xでの公開(ヘッダー、アイコン、ツイートなど）\n\n是非とも、ご検討の程よろしくお願いいたします。", "nc": 33, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 734293, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "けんいち", "screen_name": "ken1ro_u", "avatar_url": "https://pbs.twimg.com/profile_images/810833954219511810/Ule8TCM5.jpg", "header_url": "https://pbs.twimg.com/profile_banners/3315404808/1598627608/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 120, "skills": [{"genre": "art"}], "banned": false, "nc": 32}, {"id": 786180, "creator": true, "nsfw_acceptable": false, "acceptable": false, "name": "wawa", "screen_name": "wawatiku", "avatar_url": "https://pbs.twimg.com/profile_images/1930047406810509316/scWjWE-1.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1316976623724318720/1784187378/1500x500", "appeal_receivable": false, "popular_creator_rank": 21, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 10, "complete_expiration_days": 50, "skills": [{"genre": "art"}], "banned": false, "nc": 160}, {"id": 1688710, "creator": true, "nsfw_acceptable": true, "acceptable": false, "name": "KiiKo @アニメ原画風skeb", "screen_name": "Kiiko_clip", "avatar_url": "https://proxy.misskeyusercontent.jp/avatar.webp?url=https%3A%2F%2Fmedia.misskeyusercontent.jp%2Fio%2Fd4b360a8-1c07-44f9-b59a-94c6982e2227.gif&avatar=1", "header_url": "https://media.misskeyusercontent.jp/io/fb207f67-3c6c-47bb-9795-c6d4b3977f4a.webp", "appeal_receivable": false, "popular_creator_rank": 36, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_b