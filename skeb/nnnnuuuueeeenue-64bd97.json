0&s=aaa45f68361b168618039fc98d6e5ab5 2x, https://si.imgix.net/7034c261/uploads/origins/9521699a-bd89-47fc-a06d-a1eb626722b3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=1ae142fc04748011b8ab1f492120329c 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/7034c261/uploads/origins/9521699a-bd89-47fc-a06d-a1eb626722b3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=bfe882f02b6e8694371ec2d9811316f3", "srcset": "https://si.imgix.net/7034c261/uploads/origins/9521699a-bd89-47fc-a06d-a1eb626722b3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=bfe882f02b6e8694371ec2d9811316f3, https://si.imgix.net/7034c261/uploads/origins/9521699a-bd89-47fc-a06d-a1eb626722b3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=dfd14920901ce6f87ff7959940c1e3a4 2x, https://si.imgix.net/7034c261/uploads/origins/9521699a-bd89-47fc-a06d-a1eb626722b3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=8604d6b829a54ded01f1649989846c5c 3x"}, "body": "はじめまして！\n新着クリエイターで素敵なイラストを拝見し、是非オリキャラを描いて欲しい！と、リクエストに参りました。\n設定、見た目共に癖のあるキャラクターですが、ご検討下さい。\n使用用途は、Twitterや Discordその他SNSでの使用、紹介、TRPG、その他アイコン、グッズ等の個人利用です。\n\n・キャラクター\n\n睦村 奏衛(むつむら かなえ)\n\n25歳 女性\n身長216センチ\n体重84キロ(痩せ型)\n一人称 私\n二人称 〇〇さん\n\n真っ白な肌や髪(アルビノ)\n傷だらけ。口唇口蓋裂。\n大きな口にギザギザの歯。\n大型肉食獣を思わせる顔立ち。\n左右で色構成が違うやや菱形の瞳。\n眉毛は無く、長い睫毛。欠けた耳。\n左右非対称で羽毛質感の髪の毛。\n長く大きな手。左利き寄り両利き。\n胸は無く、骨格はかなりガッシリと男性的。\n\n表向きはボディガードで、本業は殺し屋。\n卓越した医療技術とナイフ捌きで、ターゲットを苦しませずに一撃で仕留める。\n幼少期の頭部外傷が起因のホルモン分泌異常で背が異常に高く、見た目で女性と見られる(バレる)事はまず無い。\n母親が日本人娼婦、父親が母の客の北欧系(ロシア等)人種。\n頭が弱く騙され易いが、真面目で大人しく、仕事以外で誰かを害する事を嫌う。\n手先が器用で、料理が唯一の趣味。\n動物好き。寒さに強く暑さに弱い。\n夢は子供を産んでお母さんになる事と、小さくて良いので自分の料理の店を持つ事。\n白いネリネ(ダイヤモンドリリー/白彼岸花)が誕生花。\n\n・イメージ\n\n顔付きは資料URL内01.05と顔の詳細、文章、衣装は00(仕事着)をご参考下さい。\n美しい瞳の表現と透明感の有る色彩がとても良かったので、上記設定、容姿を元に自由に表現して頂ければと思います。\nナイフを持たせる場合は左手に。全身の場合は背景無しでOKです。\nその他、お任せします！\n\n※顔や瞳の詳細、色\nhttps://www.dropbox.com/s/fxhjix3lli24eeg/7E7744C5.png?dl=0\n※サインやラフ、線画、色等が別のレイヤーになっているPSDを可能であればお願いします。\n※納品されているギャラリーの作品もご参考頂けると嬉しいです。\n\n以上、ヨロシクお願いします！\n\nhttps://www.dropbox.com/sh/wutrpijgh0twmhq/AADnwxxZsN7UGGtt0soY7hLia?dl=0", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 785795, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "💃🎶愚か🎶🕺", "screen_name": "kyouta_22", "avatar_url": "https://pbs.twimg.com/profile_images/1639980986246242304/vwioSB_D.jpg", "header_url": "https://pbs.twimg.com/profile_banners/303080490/1659529061/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 3, "complete_expiration_days": 30, "skills": [{"genre": "art"}], "nc": 49}, {"id": 2040250, "creator": true, "nsfw_acceptable": false, "acceptable": false, "name": "あじま静丁", "screen_name": "ajimaseitei", "avatar_url": "https://pbs.twimg.com/profile_images/1676572331962159106/D8EhsNSM.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1288571792131383297/1705610113/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 3, "complete_expiration_days": 30, "skills": [{"genre": "art"}], "nc": 145}, {"id": 2110419, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "𝐧𝐢𝐤𝐮", "screen_name": "nikudnk_trpg", "avatar_url": "https://pbs.twimg.com/profile_images/2003066462941159424/GEkswfwC.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1455530479357206530/1752076061/1500x500", "appeal_receivable": true, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accep