-4eecadb0b658?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=779328a88e0e7659fc3e432b516a9ace, https://si.imgix.net/dc13715e/uploads/origins/9732d9e7-a1ad-4499-8054-4eecadb0b658?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=9add2971270637093c721031624e2f36 2x, https://si.imgix.net/dc13715e/uploads/origins/9732d9e7-a1ad-4499-8054-4eecadb0b658?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=28e2a1e629258fb447e6186f465e234d 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/dc13715e/uploads/origins/9732d9e7-a1ad-4499-8054-4eecadb0b658?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9f3d0189c7376f3df8b4c0f8d891e914", "srcset": "https://si.imgix.net/dc13715e/uploads/origins/9732d9e7-a1ad-4499-8054-4eecadb0b658?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9f3d0189c7376f3df8b4c0f8d891e914, https://si.imgix.net/dc13715e/uploads/origins/9732d9e7-a1ad-4499-8054-4eecadb0b658?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=c3594431ad40c4f6faf66307b69dd6d2 2x, https://si.imgix.net/dc13715e/uploads/origins/9732d9e7-a1ad-4499-8054-4eecadb0b658?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=8f47a29708a11f6b1d86672430b7672e 3x"}, "body": "はじめまして。\n過去に描かれていたイラストがとても良かったので今回リクエストさせて頂きました。\n\nリクエスト内容ですが、アイドルマスターシンデレラガールズから十時愛梨さんを描いて頂きたいです。  \n\nまず資料URLから画像が見れるかを確認して頂きたいです。(見れない場合はキャンセルして頂いても構いません。)\n\n [衣装] \nデレステ5周年記念衣装「Go To Paradise」の「リゾート」のパターンを描いて欲しいです。(資料URLの画像1,2枚目参照)\n\n[シチュ] \n上記の衣装を着用して歌う、デレステ5周年楽曲の「Go Just Go!」では曲の途中に早着替えが存在するのですが、その早着替えの際に失敗してしまい衣装がずり落ちて脱げてしまうシチュが見たいです。\n各部の詳細は以下の通りです。\n\n描いて頂くのは正面からで膝下まで描いて貰えればOKです。\n手などで胸は隠さないポーズでお願いします。\n髪は軽く巻いて貰えると嬉しいです。\n(資料URLの画像3枚目参照)\n\n表情は恥ずかしそうに頬を赤らめながら突然の出来事にびっくりしてる感じでお願いします。\n\n胸の部分は衣装が下にずり落ちてる感じで、乳首は両方出して貰ってOKです。(個人的に水越まゆさんの描くおっぱいがめちゃくちゃ好きです…。特に過去に描かれてた8周年記念衣装を着た十時愛梨さんのイラストがめっちゃくちゃ好みなので、胸のサイズもあれくらいだと嬉しいです。)\n\nスカートも下にずり落ちてしまい、パンツが見えてしまってて欲しいです。パンツに関しましては、色は白か薄いピンクでデザインはおまかせ致します。\n(紐パンと極端に面積の狭いものはNG)\n\n出来れば衣装なし、パンツのみの状態も描いて欲しいです。\n\n[要望]\n出来ればPSDファイルで納品して頂き、衣装、表情とパーツを組み合わせを変えて楽しめるようにして頂けると嬉しいです。\n\n注文が多く申し訳ないですが、\n是非とも宜しくお願いします！\n\nhttps://x.com/test_up_e/status/2049345540358640069?s=46&t=gWErDPHd1mrarucZBoDz6g", "nc": 177, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@mayu_m/works/15", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 369857, "client_id": 1060433, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/af1098c6/uploads/origins/d0dbf440-98df-49ac-b134-ce11ebc08db0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=18a4ff68fec870610b74a0e709d4378b", "srcset": "https://si.imgix.net/af1098c6/uploads/origins/d0dbf440-98df-49ac-b134-ce11ebc08db0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=18a4ff68fec870610b74a0e709d4378b, https://si.imgix.net/af1098c6/uploads/origins/d0dbf440-98df-49ac-b134-ce11ebc08db0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=dbd106d8315b6ed27d68d2d9d5603036 2x, https://si.imgix.net/af1098c6/uploads/origins/d0dbf440-98df-49ac-b134-ce11ebc08db0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a53a15c4830edb3eeafd1a805ada40ca 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/af1098c6/uploads/origins/d0dbf440-98df-49ac-b134-ce11ebc08db0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=7e2938cb61ebe1797abc9cd9aea3ee3d", "srcset": "https://si.imgix.net/af1098c6/uploads/origins/d0dbf440-98df-49ac-b134-ce11ebc08db0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=7e2938cb61ebe1797abc9cd9aea3ee3d, ht