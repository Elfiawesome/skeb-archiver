si.imgix.net/d09e4d63/uploads/origins/1b45ea57-ed91-428e-b9b6-16320cf3ceb5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=d28a87ddbdd00e269683e98c7ff6d92b 3x"}, "body": "こんにちは～haraniko様、前回のイラストは本当に大満足でした。今回は、私のオリジナルキャラクターに、乗馬服か競馬場の雰囲気のある衣装を描いていただけないでしょうか。参考として（9.29）のリンクをご覧ください。髪型や衣装は自由にアレンジしてください！すべてharaniko様にお任せします。よろしくお願いします(＞人＜;)\n\nhttps://drive.google.com/drive/folders/1ICJNV78FZs2UEuV53lOSO04hvM4gS9lj", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@S_Haraniko/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 4099632, "client_id": 2915957, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/c391bf87/uploads/origins/c5003d03-48a9-48e0-8405-68f05e4243de?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9dec286e8467b97313e035bb084dda79", "srcset": "https://si.imgix.net/c391bf87/uploads/origins/c5003d03-48a9-48e0-8405-68f05e4243de?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9dec286e8467b97313e035bb084dda79, https://si.imgix.net/c391bf87/uploads/origins/c5003d03-48a9-48e0-8405-68f05e4243de?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=52a13901ca108d2e834fcaef36305083 2x, https://si.imgix.net/c391bf87/uploads/origins/c5003d03-48a9-48e0-8405-68f05e4243de?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a8e6e2877e0fb9b9b22ea94ca264f431 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/c391bf87/uploads/origins/c5003d03-48a9-48e0-8405-68f05e4243de?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e2938188bc2385a52e6ef71e12286e4d", "srcset": "https://si.imgix.net/c391bf87/uploads/origins/c5003d03-48a9-48e0-8405-68f05e4243de?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e2938188bc2385a52e6ef71e12286e4d, https://si.imgix.net/c391bf87/uploads/origins/c5003d03-48a9-48e0-8405-68f05e4243de?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=391ffe156abbfd88bd1f10b705e25eb0 2x, https://si.imgix.net/c391bf87/uploads/origins/c5003d03-48a9-48e0-8405-68f05e4243de?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=a7cf88abe838239470945c7352b00833 3x"}, "body": "はじめまして！\nハラニコ先生の美しい絵に感動しました！洋服の描き方がとても優雅で、細部の描き込みも素晴らしいですね。描く青年キャラクターが大好きなので、ぜひ私のOCを描いていただけたら嬉しいです。\n\nお好なように描いてください！！性格や設定などの詳細は以下に記載しています。創作のヒントになれば幸いです！\n\n[キャラ紹介]\nシモミヤ ／25歳／身長175cm／🐑🐺\nモチーフ：深い水、紅葉、葬儀・喪、椿\nhttps://drive.google.com/drive/folders/1F4UXSmzbN7TqQT0Y-o9B_TeVLQ55ulZc\nシモミヤは由緒ある名家の跡取りであり、兄と父がわずか数年の間に相次いで「不幸な」最期を遂げたことで、若くして一族の当主となった人物です。\n\n人当たりがよく、誠実で勤勉な人物として知られており、誰に対しても常に穏やかな関係を保とうと努めます。繊細で内気な性質の持ち主でもあり、感情を隠すことはあまり得意ではありません。いつまでも喪に服しているかのような哀愁を漂わせています。\n\nしかし、その穏やかな水面の下には、狡猾で人を操る一面が潜んでいます。物腰の柔らかな人格の奥には、利己的な野心と執着心が渦巻いており、それを巧みに隠すことで、周囲に安心感を抱かせています。その本性は、冷酷であると同時に、愛する人には献身的です。何をしようとするのも、すべては脆く傷つきやすい自分の心を守るため。つまり彼は「羊の皮を被った狼」でありながら、その牙もまた、羊毛も、どちらも紛れもない本性なのです\n\n髪はきちんと分けて整えているつもりですが、前髪が左目にかかり、耳にかけてもすぐに落ちてきてしまいます。また、腕時計と結婚指輪は常に身につけており、頻繁にそれらに触れたり、位置を直したりする癖があります。これらは彼にとって重要な品です。\n\n…要するに、ファムファタール男です。ミステリー小説（昭和時代、秋の山奥にある古い屋敷が舞台）ですから、結局のところ「愛しい探偵を裏切る助手」という役回りになります。未亡人のような殺人鬼、恋に盲目な悪魔でありながら、その佇まいは無垢に見えます……。\n\nhttps://drive.google.com/drive/folders/1F4UXSmzbN7TqQT0Y-o9B_TeVLQ55ulZc", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@S_Haraniko/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 4099632, "client_id": 3099808, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/94ff4e32/uploads/origins/a3363f38-c055-4490-bb5c-39fadc60f870?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9c3a9f33745b358ff3c618515cfa6075", "srcset": "https://si.imgix.net/94ff4e32/uploads/origins/a3363f38-c055-4490-bb5c-39fadc60f870?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9c3a9f33745b358ff3c618515cfa6075, https://si.imgix.net/94ff4e32/uploads/origins/a3363f38-c055-4490-bb5c-39fadc60f870?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=374924afd1b154218c8b435da952beb0 2x, https://si.imgix.net/94ff4e32/uploads/origins/a3363f38-c055-4490-bb5c-39fadc60f870?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ace3441a99cad1fe9eb3e1d1ee926585 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/94ff4e32/uploads/origins/a3363f38-c055-4490-bb5c-39fadc60f870?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=854179cd88494d20a57e4ccd080b009c", "srcset": "https://si.imgix.net/94ff4e32/uploads/origins/a3363f38-c055-4490-bb5c-39fadc60f870?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=854179cd88494d20a57e4ccd080b009c, https://si.imgix.net/94ff4e32/uploads/origins/a3363f38-c055-4490-bb5c-39fadc60f870?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=e3c8301287f6bc34bca8beaab4c6571d 2x, https://si.imgix.net/94ff4e32/uploads/origins/a3363f38-c055-4490-bb5c-39fadc60f870?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=d9b381a5c2e8ac63afae24521b5dc264 3x"}, "body": "haraniko様、こんにちは。友人から、このスタイルの衣装デザインをされるのにとても適しているとお聞きしていました。実際に拝見したところ、私もあなたの作品がとても気に入りました。レトロな宮廷風の衣装を1セットお願いしたいのですが、髪型は髪量が多めのローマ風カールにしてほしいです。髪型は自由にアレンジしていただいて構いません。顔の描写については、赤い丸で囲んだ部分を参考にしてください。（注：髪の毛の先端に黄色から赤へのグラデーションがあります）個人的には、華やかな衣装デザインの方が好きです！haraniko様、本当にありがとうございます……\n\nhttps://drive.google.com/drive/folders/1ICJNV78FZs2UEuV53lOSO04hvM4gS9lj", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@S_Haraniko/works/1", "private