振りでゆいさんに思い切り出しまくってほしいです\n台本は好きに変えてもらってかまいませんので\nゆいさんのオホ声や激しいイキ声も聞けたら嬉しいです\nどうか宜しくお願い致します", "nc": 32, "word_count": 0, "transcoder": "audio", "creator_acceptable_same_genre": true}, {"path": "/@shion_yui_v1122/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "voice", "tipped": false, "creator_id": 363797, "vtt_url": "https://fcdn.skeb.jp/uploads/outputs/114d6d52-0878-4d4c-9ad2-7fbcb51b177a?response-content-disposition=inline&Expires=1783804322&Signature=HyZJeoZGjDPrfZxUmfMwSdxXW8emoQj6IiyadyONVoCERoEj0eg9ueWIt-DMwy-kkIBlh308etyvarjruY6vtJ3Anb3XXt~LqZcVozR887NlHrw~1Bvj9nN3bqPsP~DL6AEWXejHTdaYgO0oJKJLkgggTY8mDVypIJhtE7X-hOTj77q1vra2yQv5nKrtcWIErGwXHGbSm8OocmxrpN9g3zvbYSr3q97SpIjP91s8BTEzGsOlbdiEmryTuObgmOvN2WoOfiUFIaybadqXbOsduCKXrFrBrnSWLXcpt0L8nQOBDvvs81Nag~y5fwCsDaBpne3GgtUkaRQZtMVQIZVrXA__&Key-Pair-Id=K1GS3H53SEO647", "thumbnail_image_urls": {"src": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1969387635853705220%2Flh4U7HUb.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=663e0a7610d04951c45d3bec59f66cca", "srcset": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1969387635853705220%2Flh4U7HUb.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=663e0a7610d04951c45d3bec59f66cca, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1969387635853705220%2Flh4U7HUb.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=4404a5622fdefe28c8c173c3cef9d546 2x, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1969387635853705220%2Flh4U7HUb.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ee4c593324c554434bbafd1870072c1a 3x"}, "preview_url": "https://fcdn.skeb.jp/uploads/outputs/7528213f-d3bc-478e-9ef0-0f7b9ca32fe3?response-content-disposition=inline&Expires=1783804322&Signature=bwxCWO7GZhg09B~gx4h7U8dJMpS9E-Rdh54GoY-nJ4cVt1z