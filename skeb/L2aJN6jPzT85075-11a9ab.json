ins/05b71aa5-8cd7-4722-9601-1431d9dce7f4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=48b2b40d9189e5b48a297eff7021e9f4, https://si.imgix.net/a09a1b2f/uploads/origins/05b71aa5-8cd7-4722-9601-1431d9dce7f4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=0d7f7a63263cc7e8274d9cd31f688d76 2x, https://si.imgix.net/a09a1b2f/uploads/origins/05b71aa5-8cd7-4722-9601-1431d9dce7f4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=51c91a2092d2999170bb3dcceddc971c 3x"}, "body": "こんにちは！あなたのアカウントをトップページで見て、絵がマジですごいと思ったの...。もしよろしければ、私のキャラクターの絵をお願いしたいです。\n\n彼女は典型的な心配性の女の子で、ギャンブル中毒のようなところがあり、楽しいときにはちょっと夢中になることがある。その場のノリで勝ったりすると、まるで別人のようになるんだ。クレイジーで熱血漢。あらゆる意味でスリルを求めるが、芯は優しい。命を賭してでも、彼女はただ楽しみたいのだ。\n\n私はあなたのこれまでの作品の怖くて不穏な構図に憧れていて、そのような雰囲気で彼女を描いてほしいと思っています。たぶん、彼女を演じている人の視点で。彼女の口は数枚のトランプの陰に隠れているが、彼女の目は開いていて、私たちの知らない何かを知っているかのように、見る者を正面から見つめている。\n\nもっといいアイデアがあれば、ぜひ教えてほしい！本当にありがとう！\n\nhttps://photos.app.goo.gl/MiJzzfvuqAHzHwcS7", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@L2aJN6jPzT85075/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3725384, "client_id": 2976519, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/7d66f2d9/uploads/origins/9940f3af-2aba-45e3-b5bf-3e8a8aa8531d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ec9d5737ff433b4fcd0c060cbbea3d27", "srcset": "https://si.imgix.net/7d66f2d9/uploads/origins/9940f3af-2aba-45e3-b5bf-3e8a8aa8531d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ec9d5737ff433b4fcd0c060cbbea3d27, https://si.imgix.net/7d66f2d9/uploads/origins/9940f3af-2aba-45e3-b5bf-3e8a8aa8531d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a5d004a0d5fafed34b5d531ac726870c 2x, https://si.imgix.net/7d66f2d9/uploads/origins/9940f3af-2aba-45e3-b