it is feminine and flirty. Other times it is crass, sadistic, and disruptive.\n- Its skin is poisonous.\n- It can drain a planet's moisture completely and turn into a giant leviathan.\nMotifs: deep space, ocean, octopus, sea angels, eels, hunger, greed\n\nFeel free to draw it in whatever outfit you wish. Please cancel or resend if the amount is not enough, thank you!\n\nReference images: https://drive.google.com/drive/folders/1E_ULBGn0d4wS4JyhF7_F5R6BVWnjf3G2", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@L2aJN6jPzT85075/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3725384, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/5a6053db/uploads/origins/cb1e9925-c54c-41d0-bcdf-18624264b0e3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=049db8c064a3e78670bafd49cedfd5dd", "srcset": "https://si.imgix.net/5a6053db/uploads/origins/cb1e9925-c54c-41d0-bcdf-18624264b0e3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=049db8c064a3e78670bafd49cedfd5dd, https://si.imgix.net/5a6053db/uploads/origins/cb1e9925-c54c-41d0-bcdf-18624264b0e3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ffffda7cbc59a608acfb65f0b975177e 2x, https://si.imgix.net/5a6053db/uploads/origins/cb1e9925-c54c-41d0-bcdf-18624264b0e3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a2f9f320cbf9f7ec893b39a8a0350080 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/5a6053db/uploads/origins/cb1e9925-c54c-41d0-bcdf-18624264b0e3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0913da68522628890c96e9b392bf2b10", "srcset": "https://si.imgix.net/5a6053db/uploads/origins/cb1e9925-c54c-41d0-bcdf-18624264b0e3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&