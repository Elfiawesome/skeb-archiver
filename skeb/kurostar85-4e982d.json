ix.net/350a4cb7/uploads/origins/abe02f04-6e59-43db-90bc-fa1df6922c04?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=91f58a418552410177a550648fd32d60", "srcset": "https://si.imgix.net/350a4cb7/uploads/origins/abe02f04-6e59-43db-90bc-fa1df6922c04?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=91f58a418552410177a550648fd32d60, https://si.imgix.net/350a4cb7/uploads/origins/abe02f04-6e59-43db-90bc-fa1df6922c04?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=1d6f92016f3cdd5a455505c3bbba2622 2x, https://si.imgix.net/350a4cb7/uploads/origins/abe02f04-6e59-43db-90bc-fa1df6922c04?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=28aec180559676a271e135d4b1efbc58 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/350a4cb7/uploads/origins/abe02f04-6e59-43db-90bc-fa1df6922c04?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=50a18bc267baa28b8de9538c6c07b9f8", "srcset": "https://si.imgix.net/350a4cb7/uploads/origins/abe02f04-6e59-43db-90bc-fa1df6922c04?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=50a18bc267baa28b8de9538c6c07b9f8, https://si.imgix.net/350a4cb7/uploads/origins/abe02f04-6e59-43db-90bc-fa1df6922c04?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=e0449681860c3aed59207304e2137fff 2x, https://si.imgix.net/350a4cb7/uploads/origins/abe02f04-6e59-43db-90bc-fa1df6922c04?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=0f78500fe436dd03584064b48f0964e8 3x"}, "body": "はじめまして。以下の文章をお読みいただき、イラストをお願いします\n\n少女はふと、思い出します。遠い昔、父と母と、手を繋いで歩いた、夕焼けの畦道を。その先の、田んぼの中の枯れ木を。あの夕焼けを。あの青い空を。あの、温もりを……。それら全てを、思いつく限り、物語に綴りました。そして、もしもの、未来の話を……。もしも、と、少女は物語を綴る手を止め、手紙を認めました。少女は自分の魂が尽きていくのを感じ取っていました。けれども、書く手を止めませんでした。\n\n朦朧とする意識の中、思い出したのは、あの茜雲の夕焼け空だった。父さまと、母さまと手を繋いで歩いた、畦道。蛙の鳴き声と蜩の鳴き声が混ざり合う、黄昏時……。\n\n目を開くと、私は、あの畦道を歩いている。父さまと、母さまと手を繋いで、歩いている。田んぼの中の古い桜の木。鮮やかな薄紅色に染まっていた。咲いてるところを見たことがなかったから、少し驚いた。強い風が吹いて、枝葉を大きく揺らす。舞い散る桜の花びらが視界をかき消すと父さまがいなくなり、もう一度視界をかき消すと、今度は母さまがいなくなった。そしてもう一度、視界がかき消されると、太い幹の根元に、平たくて表面がつやつやした石が三つ、積まれていた。温かな風が、私の濡れた頬を優しく撫ぜていく。\n\n箇条書きですと\n少女\n桜（の木）\n物語\n手紙\n思い出\nです。", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "similar_creators": []}, "price_history": {"novel": [{"amount": 6000, "recorded_at": 1774038992.267964}], "art": [{"amount": 3000, "recorded_at": 1774038992.267964}], "correction": [{"amount": 3400, "recorded_at": 1774038992.267964}]}, "custom": {}}