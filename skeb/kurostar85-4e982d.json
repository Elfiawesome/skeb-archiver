95523af06f3342073702bc8f716, https://si.imgix.net/104fab88/uploads/origins/70f49cc3-06c4-4a8b-83ea-f104f90ec999?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=9bc040a26437b5d8d54bdc0c648ebc6d 2x, https://si.imgix.net/104fab88/uploads/origins/70f49cc3-06c4-4a8b-83ea-f104f90ec999?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a7ba8480d2b561cc8a608d45fa3a2fab 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/104fab88/uploads/origins/70f49cc3-06c4-4a8b-83ea-f104f90ec999?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=561039d10ea72e9de8c16ea5a85b54f4", "srcset": "https://si.imgix.net/104fab88/uploads/origins/70f49cc3-06c4-4a8b-83ea-f104f90ec999?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=561039d10ea72e9de8c16ea5a85b54f4, https://si.imgix.net/104fab88/uploads/origins/70f49cc3-06c4-4a8b-83ea-f104f90ec999?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=88ff70c2808366cd3f128528356357a3 2x, https://si.imgix.net/104fab88/uploads/origins/70f49cc3-06c4-4a8b-83ea-f104f90ec999?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=69cec78ecf317a59691a2c8b030679cc 3x"}, "body": "ゆどーふ様こんにちは。\n今回OC達のssを書いていただきたくリクエストを送らせていただきました。\n\n【リクエスト内容】\n資料からお好きなようにお話を書いていただきたいです。\nジャンルは自由に、BLも可。(左右CP自由)\n資料が少ないとは思いますが、あくまで二次創作としてお好きなように解釈、設定の追加をしていただいて大丈夫です。(全員登場させる必要は無い)\n\n\n【ざっくりとした世界観】\nとある館には人間の主人(魔術師)が、自らの魔術で物語の登場人物たちを現実に呼び出してコレクションとして住まわせている。\n住人たちは皆、異なる世界から来た“伝説”や“神話”、“物語”の存在。\nだけど今は、ただの同居人として、不思議な日常を過ごしている。\n\n【登場人物】\n■アルシェ(人間/魔術師)\n■伊吹(鬼)\n■藍(龍)\n■セシル(吸血鬼)\n\n\n【使用用途】\n・個人鑑賞\n・1部シーンをイラストに描き起こし、SNSに上げる場合があります。\n・作品の内容を設定として取り入れる場合があります。\n\n【その他】\n・形式に指定はありません。\n\n最後までお読みいただきありがとうございました。金額や内容に問題がありましたら再送要請、またはキャンセルをお願い致します。\nお手数おかけしますがご検討のほど、よろしくお願いします。\n\nhttps://drive.google.com/drive/folders/1qE-2ok4j_6j0StnwFkb7rFCBFk9HZByL", "nc": 9, "word_count": 10567, "transcoder": "text", "creator_acceptable_same_genre": true}, {"path": "/@kurostar85/works/7", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/59011f7c/uploads/origins/2926f2ce-507a-4977-8b11-4791b78aed07?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=ea180031144bdc5c953d3372b16f3a2e", "srcset": "https://si.imgix.net/59011f7c/uploads/origins/2926f2ce-507a-4977-8b11-4791b78aed07?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=ea180031144bdc5c953d3372b16f3a2e, https://si.imgix.net/59011f7c/uploads/origins/2926f2ce-507a-4977-8b11-4791b78aed07?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=7031832a546e78da9f17c1daeac33041 2x, https://si.imgix.net/59011f7c/uploads/origins/2926f2ce-507a-4977-8b11-4791b78aed07?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=0d17d0629c9a23a3fbba5f99736f4109 3x"}, "private": true, "genre": "novel", "tipped": true, "creator_id": 3292071, "nc": 128}, {"path": "/@kurostar85/works/6", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/e8aa38c5/uploads/origins/a69f07a8-6e71-4ac7-b9ad-938dce5517c7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=a1eeb5d12b3fb3b34db8089a9a416b39", "srcset": "https://si.imgix.net/e8aa38c5/uploads/origins/a69f07a8-6e71-4ac7-b9ad-938dce5517c7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFF