blic": false, "tip_acceptable": true, "yearly_report_client_visible": false, "total_appeals_count": 0, "received_works": [{"path": "/@mizuyorumuro/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3549145, "client_id": 2393242, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/a22b089a/uploads/origins/33c1a0b6-861b-4a85-ac4f-ea0300f1a91c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8993a279f79d1f7dea0264d620bd221a", "srcset": "https://si.imgix.net/a22b089a/uploads/origins/33c1a0b6-861b-4a85-ac4f-ea0300f1a91c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8993a279f79d1f7dea0264d620bd221a, https://si.imgix.net/a22b089a/uploads/origins/33c1a0b6-861b-4a85-ac4f-ea0300f1a91c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=56bdbc1087f2bb55be04ba4a0ba019b7 2x, https://si.imgix.net/a22b089a/uploads/origins/33c1a0b6-861b-4a85-ac4f-ea0300f1a91c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d1fdfb7441aae10e0ddb1e798d8004cb 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/a22b089a/uploads/origins/33c1a0b6-861b-4a85-ac4f-ea0300f1a91c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0c07a9878ff5ab12ee1582d5b8288f03", "srcset": "https://si.imgix.net/a22b089a/uploads/origins/33c1a0b6-861b-4a85-ac4f-ea0300f1a91c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0c07a9878ff5ab12ee1582d5b8288f03, https://si.imgix.net/a22b089a/uploads/origins/33c1a0b6-861b-4a85-ac4f-ea0300f1a91c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=5a627b0e39459efc3a6606c4f759435f 2x, https://si.imgix.net/a22b089a/uploads/origins/33c1a0b6-861b-4a85-ac4f-ea0300f1a91c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=039aed7992334e249c30d8aad1a833a6 3x"}, "body": "初めまして、みょうと申します。\n水夜むろ様のイラストを拝見し、skebのご依頼をさせていただきたくメッセージ送らせていただきました。\n何か不備等ございましたらお手数おかけしますが再送要請などしていただけますと助かります。\nご検討いただけましたら幸いです。\nよろしくお願いいたします！\n\n*使用用途\nDiscord及びXのアイコン・ヘッダー、パソコンのデスクトップ画像などに利用予定です。\n商用利用の予定はありません。\n\n*お願いしたいこと\nTRPGの自探索者の一枚絵のイラストを描いていただきたいです。（2キャラ分、それぞれ1枚ずつ）\nキャンバスは横長のキャンバスで、それぞれのイラストが何となく対っぽくなっている感じだと嬉しいです。\nまた、刀が映っていると嬉しいです。\n\nA（白髪の方）：藤モチーフ（藤棚の下に立っているイメージ）\nB（紺髪の方）：桜モチーフ（桜の木の間に立っているイメージ）\n\n\n＊キャラクターについて\n（表情やポーズなどの参考にしていただければ幸いです）\n\n【A（白髪の方）】\n名前：五条 藤冶（ごじょう とうや）\n性別：男性\n年齢：17（高校3年生）\nイメージカラー：#FFFFFF\n\n性格など：\n一人称は\"俺\"、二人称は\"君\"。\n飄々としてマイペース、掴みどころがない。\n頭の回転もなかなかで、考え方も柔軟。\n案外面倒見がよく、周囲が良く見えているためサポートとしての役回りが得意。\nひとところに留まっているのがあまり得意ではないため、あちらこちらへ顔を出している。\n\n【B（紺髪の方）】\n名前：一 結桜（にのまえ ゆお）\n性別：男性\n年齢：16（高校2年生）\nイメージカラー：#72B7B5\n\n性格など：\n一人称は\"私（わたくし）\"、二人称は\"貴方\"。\n物腰柔らかで穏やか。\nたおやかな言動の反面、感情に流されずに物事を見るリアリスト。\n考えに芯が通っていて、一度決めたことは流されずやりきる。\n真面目だが、冗談をそのまま受け取ってしまうような天然な一面もある。\n\n\n*納品形式\n画像ファイルでいただけますと助かります。\n\n*参考画像\nhttps://drive.google.com/drive/folders/1HUP-eQBvR5xg-SSqe5hVvhf-bnoddNau?usp=sharing", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@mizuyorumuro/works/3", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/08bb3e3b/uploads/origins/39264912-c33a-4569-8745-2398aaf15610?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=a31f6bc2eb1cab284331a21ab5b6af62", "srcset": "https://si.imgix.net/08bb3e3b/uploads/origins/39264912-c33a-4569-8745-2398aaf15610?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=a31f6bc2eb1cab284331a21ab5b6af62, https://si.imgix.net/08bb3e3b/uploads/origins/39264912-c33a-4569-8745-2398aaf15610?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&