genre": "correction", "default_amount": 5000}], "acceptable_only_public": false, "tip_acceptable": true, "yearly_report_client_visible": false, "total_appeals_count": 0, "received_works": [{"path": "/@1030Aoiyui/works/35", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 977155, "client_id": 3298737, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/0673c89f/uploads/origins/8ad8e2f6-d643-4e9b-ab61-538f79dcdf41?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3689fe11e8c87e76ed9ffe49b6f31a05", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/0673c89f/uploads/origins/8ad8e2f6-d643-4e9b-ab61-538f79dcdf41?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=521e25d7aad3d012a3ae88484d63bafd", "src_set": ""}, "body": "あなたの絵はとてもきれいだ！色使いが本当に素敵で、とても目立つ！\n\n私のキャラクターを描いてもらいたいのですが、にこにこした感じのかわいい親しみやすい表情にしたいのです！とてもにこやかでかわいい。  とても赤い髪！胸は適度にあるが、少し谷間がある！髪は少し長めで、特に後ろ髪は長め！  ドレスのベルトは描かないでください。なんとなく魔法少女っぽくしたいので、その感じがあれば何でもいいです。\n\n\nhttps://imgur.com/a/fpP1EZB\n\nhttps://imgur.com/a/fpP1EZB", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@1030Aoiyui/works/34", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/777e06ee/uploads/origins/8513172c-7eb9-42be-9ef4-d443896a851b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=2c8cfb1af8e48f61b0efce885f87a4bf", "src_set": ""}, "private": true, "genre": "art", "tipped": false, "creator_id": 977155, "client_id": 3703816, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 17, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@1030Aoiyui/works/33", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 977155, "client_id": 3690524, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/3f5fc95e/uploads/origins/aa9f9d4c-a95b-4578-90cb-c887fa6e15d0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e1e9d4f215f24b76a8ff2f16b985b1a1", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/3f5fc95e/uploads/origins/aa9f9d4c-a95b-4578-90cb-c887fa6e15d0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=88f37c8ac5cf81ef0efd9fe1f33bbd56", "src_set": ""}, "body": "すみません、日本語が少し話せます。\nギリシャのミクを作りたいです。私はギリシャ人です。\nあなたのカナダのミクが大好きです。カナダの初音ミクエキスポで見ました。\nギリシャの文化を知っていますか？\n車に貼るステッカーと切り絵を作りたいです。あなたの絵は売りません。\n現代ギリシャでは、女性は特別なドレスを着ます。\nそのドレスを \"フスタネラ \"と呼ぶ。\nhttps://x.com/otimusixya/status/1135002758996680704\nありがとうございました。", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@1030Aoiyui/works/32", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 977155, "client_id": 3627485, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/b041e6ff/uploads/origins/a4033aeb-a532-4fe8-be56-9ddf2522e33e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=818f206ab7f045309712fb8d7b9d3f84", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/b041e6ff/uploads/origins/a4033aeb-a532-4fe8-be56-9ddf2522e33e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=8c1556e0ab31a436994fa9c91a714ba1", "src_set": ""}, "body": "はじめまして。\nいつも素敵なイラストを投稿していただきありがとうございます。\n\nこの度はVライバー葉坂ミカゲ様へのプレゼント用のファンアートを依頼させていただきたく考えております。\n(絵師様に依頼してファンアートを贈ることはご本人了承済です)\n\n基本的な用途としては観賞用となりますが、配信時のサムネとしてご利用いただく可能性もございます。(グッズ化などの商用利用予定はございません)\n\nイラストのイメージとしては、戦闘服(後述参考URL参照)でマイクを持って楽しそうに歌を歌っている感じにしていただければと思います。\nデビュー3周年となりますので「3rd anniversary」といったテキストもお願い致します。\nまた、背景と人物をレイヤー分けいただけますと幸いです。\n\nその他、必要な情報や費用変更などございましたらお知らせ願います。\nお忙しい中とは思いますが、ご検討の程よろしくお願い致します。\n\n参考URL\nhttps://lit.link/83kmikage\n\nhttps://tolico.info/vliver/%E8%91%89%E5%9D%82%E3%83%9F%E3%82%AB%E3%82%B2/", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@1030Aoiyui/works/31", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 977155, "client_id": 3244380, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/807fa35c/uploads/origins/6900c978-be70-49a8-b385-a5ac35555402?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=41cf39a9a3e9afb6735bcb1b76f5f555", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/807fa35c/uploads/origins/6900c978-be70-49a8-b385-a5ac35555402?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=4f4e59c5e4619677ad3c192e17898d41", "src_set": ""}, "body": "青井ゆい先生\n\n今回は夏の初音ミクをお願いしたいです！\n\nいつもご依頼を受けてくださり、素敵な作品を本当にありがとうございます！\n\nご検討のほど、よろしくお願いいたします！！！", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@1030Aoiyui/works/30", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 977155, "client_id": 3295592, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/966d0672/uploads/origins/baf2fa01-5cb7-412b-8220-e868389b2c03?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e39da7d0fd97cafbca201c150e52d867", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/966d0672/uploads/origins/baf2fa01-5cb7-412b-8220-e868389b2c03?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=543a949b8cb801a7b2d174583cf4d2ef", "src_set": ""}, "body": "こんにちは、はじめまして。\n青井ゆい先生のふんわりとしていてとても可愛らしい絵柄が大好きで、\n特に描かれている初音ミクのイラストにいつも癒されています。\n\nこのたび、ぜひ私のオリジナルキャラクターのイラストを描いていただきたく、リクエストをお送りしました。\n\nキャラクターの雰囲気としては、ちょっと天然で、ぽやっとした感じの女の子です。\n細かい構図やポーズなどは先生のイメージで自由に描いていただけたら嬉しいです。\n\n完成した作品は、個人での鑑賞やSNSでの使用を予定しており、商用利用は一切いたしません。\n\nご多忙のところ恐れ入りますが、ご検討いただけましたら幸いです。どうぞよろしくお願いいたします🙇‍♀️\n\nhttps://drive.google.com/drive/folders/1Ezb2BumEF57cUSDAYn1PgxK-lb3rfMWa?usp=drive_link", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@1030Aoiyui/works/29", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 977155, "client_id": 3549800, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/3e72e4d1/uploads/origins/16a3c0ce-83ac-419d-b353-ca9cd911c92b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d74b2658df8a9a90526fbbb995aad971", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/3e72e4d1/uploads/origins/16a3c0ce-83ac-419d-b353-ca9cd911c92b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9280e3e555a3211f51913d8e01163454", "src_set": ""}, "body": "こんにちは、キリ太郎と申します。この度はぜひマジカルミライ2025のペンライトフィルムのイラストデザインを依頼したいと考えております。ペンライトを元気に振っているかわいいミクさんをぜひお願いいたします。\n\n【依頼内容】  \nテーマ：マジカルミライ2025\n使用用途：ペンライトのフィルム、可能ならばタペストリー化(自作)\n詳細：マジカルミライ2025をテーマにしたデザインをお願いしたいです。フィルムはペンライトに装着するもので、ライブ会場での無料配布とBooth、ボーマスでの有償（100円程度）配布を検討しています。\n\n【希望するデザイン】  \n- キャラのみ（実際にペンライトで使用）＋背景のみ（背景はパッケージ化の際に使用）  \n- サイズ：ペンライトのフィルムに適したサイズ（横9cm x 縦14cm）\nご検討のほどよろしくお願いいたします。", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@1030Aoiyui/works/28", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 977155, "client_id": 3244380, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/9143816d/uploads/origins/1e7208d0-484b-4d41-99c5-44c874fbcd32?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b558b1459502752faeb65d82e5bfc8e4", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/9143816d/uploads/origins/1e7208d0-484b-4d41-99c5-44c874fbcd32?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=bb72af942d60b565f6a4851bdf1ef316", "src_set": ""}, "body": "青井ゆい先生\n\n今回は春の初音ミクをお願いしたいです！\n\nご検討のほど、よろしくお願いいたします！！！", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@1030Aoiyui/works/27", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 977155, "client_id": 3512398, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/f2b8e8d9/uploads/origins/69a30987-f6fd-4be9-b115-73687c228e53?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e251ca272ac1fa5c0609faa08e155516", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/f2b8e8d9/uploads/origins/69a30987-f6fd-4be9-b115-73687c228e53?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=de480d756cc5a38ad83a8645d5fe9247", "src_set": ""}, "body": "ゆいさん、いつも素敵なミクちゃんのイラストありがとうございます。今回初めてのリクエストをさせて頂きたいと思います！\n【使用目的】\nアイコン、壁紙\n【イラストについて】\n・足湯でリラックスしてるミクちゃんを描いて頂きたいです！表現は気持ちよさそうなリラックスした表情です！\n・背景は伊香保温泉のような、温泉地の背景でお願いします！\n・服装は暖色系のお花柄の浴衣でお願いします！\n・裸足で紫色のペディキュアをしているミクちゃんを見てみたいです。足をパタパタしながらお湯から足を出しているところが良いです！\n\n細かいこだわりなどがあり、すみません...恐縮ながら、よろしくお願いします！", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@1030Aoiyui/works/26", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 977155, "client_id": 1313562, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/fb7a4b5f/uploads/origins/d1dae02c-caf7-4361-bb5a-bdaca6ab3a13?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b13a0d43a62e2f8dbd284f99260a9238", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/fb7a4b5f/uploads/origins/d1dae02c-caf7-4361-bb5a-bdaca6ab3a13?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ab7df1d52f6530d272018bf6ed3ac405", "src_set": ""}, "body": "ゆい先生\nはじめまして。こよみと申します。いつもXでゆい先生の可愛いミクさんのイラストを拝見しており、大ファンになりました。そこで、ぜひうちのミクもイラストにしていただきたく、リクエストをさせていただきます。\n\n【リクエスト内容】\n\n◆背景\n穏やかな海辺と青い空に輝く日差しを背景にお願いしたいです。\n\n◆キャラ／服装\nうちのミクさんの参考資料は以下リンクのとおりです。ご参考にしていただければと思います。\nhttps://www.pixiv.net/en/artworks/116068416\nまた、参考資料にはカメラやメガネのアクセサリーがありますが、これらは使用せずに描いていただけると助かります。\n\n◆顔／表情／ポーズ\nうちのミクさんは落ち着いた優しい雰囲気とキラキラした笑顔を持っているので、上記のような雰囲気で描いていただけると嬉しいです。また、赤いスカートが見えるアングルで描いていただけると助かります。それ以外の詳細についてはお任せしますので、自由に表現してください。\n\n◆その他の要望\nもうすぐ誕生日ですので、もし可能であれば、イラストにゆい先生からの誕生日メッセージを入れていただけると嬉しいです。ただし、ご都合が悪ければ、普段どおりのメッセージでも大丈夫ですので、お気遣いなくお願いいたします。\n\nさらに、メッセージ入りのPNGファイルと、メッセージなしのPNGファイルをいただけると助かります。\n\n◆使用用途\nイラストはスマホの背景やSNS（Xなど）でのアイコンとして使用する予定です。\n\n多くをお任せする形となり恐縮ですが、ご検討いただけますと嬉しいです。\nよろしくお願いいたします。", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@1030Aoiyui/works/25", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 977155, "client_id": 3244380, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/89184e71/uploads/origins/ce19ea50-8050-4667-a15f-9a565dd47baa?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ee932f86342859aa2aedb0b88b172087", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/89184e71/uploads/origins/ce19ea50-8050-4667-a15f-9a565dd47baa?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c18ffa447346f36c3f0bca25c86a1fe4", "src_set": ""}, "body": "青井ゆい様\n\n以前は素敵なイラストを描いていただき、誠にありがとうございました。再度リクエストをお願いしたく、メッセージをお送りしております。\n\nリクエスト内容\n\n今回は、初音ミクを冬をテーマに描いていただきたく思っております。ただ、雪ミクではなく、青井ゆい様ならではの冬テーマのミクを拝見したいです。もちろん、青井ゆい様が雪ミクを描きたいとお考えであれば、ぜひ拝見したいです。全ての詳細につきましては、青井ゆい様のご自由な発想にお任せしたいと思います。\n\n使用用途\n\nこのイラストもTwitterやYouTube、DiscordなどのSNSでのプロフィールアイコンやバナーとして使用したいと考えております。\n\nお忙しい中恐縮ですが、ご検討いただけますと幸いです。どうぞよろしくお願いいたします。", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@1030Aoiyui/works/24", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 977155, "client_id": 2505868, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/c1a4d44f/uploads/origins/34ed4052-3a26-4dd4-b548-1b7e7681927e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=afa0c660633d25eaa52a2c463593f050", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/c1a4d44f/uploads/origins/34ed4052-3a26-4dd4-b548-1b7e7681927e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e229936eb9d3eb17ac4a7a7574db52b1", "src_set": ""}, "body": "青井ゆい様 初めまして。 mogu hapiと申します。 Twitterで青井ゆい様 のイラストを拝見させて頂き、素敵だなと思いましたのでリクエストさせて頂きました。 \n今回描いて頂きたいのは、私の推しのVTuberである 魔ノ姫こあくさん( https://twitter.com/KoakuManohime ) です。\n\n魔ノ姫こあく さんのプレゼント用イラストとしてご依頼したく考えています。\n\n【利用させて頂きたい範囲】\nイラストはFAタグを付けてTwitterに投稿を考えています。ご本人のVTuberさんにTwitterで触れられたり、場合によっては配信のサムネイルや予定表などに使用される可能性もあります。\nもちろん描いていただいた絵師様のお名前も一緒にツイートしますが、上記を許可していただける方にご依頼したいです。\n\n【イラストについて】\n・登場人物は「魔ノ姫こあく」さん\n・シーンは多くのプレゼントに囲われており、幸せそうな表情を浮かべているシーン\n・衣装はリラックスできそうなルームウェアで、できればジェラートピケのホワイト基調でありそうな感じだと嬉しいです\n・\"Happy 10/4 Birthday!\"とテキストを入れてほしいです\n・構図等は先生にお任せいたします\n\n納品形式:\nキャラクターのみを素材として使用される可能性もあるので、キャラクターと背景をレイヤー分けしていただけると嬉しいです。\n\n容姿のモデルは資料ＵＲＬ(キービジュアル)に貼らせていただいておりますので、参考にしていただければと思います･･･！\n\nhttps://twitter.com/KoakuManohime/status/1698265159461200163", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@1030Aoiyui/works/23", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/9ade0b5f/uploads/origins/4f50b301-f72a-4332-8a6d-ec5de48a9170?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=65b0e8f9e578ec390f4fc2052e384a3d", "src_set": ""}, "private": true, "genre": "art", "tipped": false, "creator_id": 977155, "client_id": 3339432, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 145, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@1030Aoiyui/works/22", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 977155, "client_id": 37410, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/9e1784a0/uploads/origins/58fa92d0-6c02-415d-9610-5dcf364d3d86?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=aac47dfee1d42a6b0719fb499b16f461", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/9e1784a0/uploads/origins/58fa92d0-6c02-415d-9610-5dcf364d3d86?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a0d0a09b224cd1efa473d60840b4a83a", "src_set": ""}, "body": "初めまして。\n青井ゆい様のイラストを拝見し、非常に可愛らしい魅力的なイラストを描いていたため、リクエストをさせていただきたく思います。\nこの度、応援しておりますVtuber様の周年記念日が近付いており、青井ゆい様に描いていただいたイラストをプレゼント出来ないかと考えております。是非ご検討いただけますようお願いいたします。\n\n○描いていただきたいVtuber様\n天日テラス 様(エアリープロダクション所属2期生)※ご本人は既に卒業済\n\n○描いていただきたい構図\n真正面から捉えた頭から足元までのアイドルポーズ(参考イラストURL掲載)\n左手に鞄の代わりにマイク握らせてもらえると嬉しいです\n\n○表情\n参考画像のような顔\n\n◯背景\nお任せします\n\n○その他\nイラストはエアリープロダクション2期生5名の各イラストを組み合わせた合同イラスト作成に使用させていただきたく思います(合成はこちらでします)\n※商業目的の利用は行いません\nそのため、キャラクターのみのイラストもいただけると幸いです。\n出来ましたら青井ゆい様のサイン及び私の宛名有りとナシで両方イラストをいただけると嬉しいです(イラストを使用する際は青井ゆい様のお名前を必ず記載するようにします)\nAIについても、青井ゆい様のイラストを使用した学習は一切行いませんことを厳守いたします。\n改めてご検討のほどよろしくお願いいたします。\n\n・キャラクター(こちらの天日テラスさん)\nhttps://torino.fanbox.cc/posts/4455563\n\n・構図、ポーズ(参考)\nhttps://www.famitsu.com/article/images/202406/7168/50348", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@1030Aoiyui/works/21", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 977155, "client_id": 3244380, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/4046ffb8/uploads/origins/e240d795-f1a9-4c31-8995-e6b6cb8fc537?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c51b78bcd28f06213536e1644588e0f0", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/4046ffb8/uploads/origins/e240d795-f1a9-4c31-8995-e6b6cb8fc537?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=121029776de9ea856c252cb491f5e49c", "src_set": ""}, "body": "青井ゆい様\n\nはじめまして。青井様の素晴らしい作品にいつも感動しております。この度、初音ミクのイラストをお願いしたく、リクエストをさせていただきます。\n\nリクエスト内容\n\n初音ミクの秋をテーマにしたイラストをお願いしたいです。ミクは着物を着ており、ポーズや表情などにミクの純粋さと恥じらい、そして清楚さを表現していただければ幸いです。また、着物に紅葉のシンボルを取り入れていただけると嬉しいです。\n\n使用用途\n\nこのイラストは、TwitterやYouTube、DiscordなどのSNSでのプロフィールアイコンやバナーとして使用したいと考えています。\n\n\n\nこれらは私の個人的な好みであり、青井様のスタイルやアイデアで自由に描いていただければと思います。もし、青井様が試してみたいポーズや表情などがありましたら、どうぞご自由にお描きください。\n\nお忙しいところ恐縮ですが、ご検討いただけますと幸いです。何卒よろしくお願いいたします。", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@1030Aoiyui/works/20", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 977155, "client_id": 0, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/a7bd62c5/uploads/origins/a511f86a-d6e8-4913-849e-7bbff30518d0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a8e5167589722357f93a8d57714cab80", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/a7bd62c5/uploads/origins/a511f86a-d6e8-4913-849e-7bbff30518d0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2dbda051685e6ce823186b16355a31f2", "src_set": ""}, "body": "はじめまして。青井ゆい様のイラストにはいつも心から感動しており、特にその独特なスタイルと色使いに魅了されています。この度、一つお願いがございます。\n私の友人がアニメ『賭ケグルイ』のキャラクター、早乙女芽亜里を非常に気に入っており、そのために特別なイラストを依頼したいと考えております。使用目的は主にプロフィールとしてですので、顔の部分のみの描写でOKです。原作の狂気じみた人物像とは少し異なり、もっと少女の青春感を出した表現を希望しています。\nその他特別な要求はございませんので、青井ゆい様の自由な発想で描いていただければ幸いです。", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@1030Aoiyui/works/19", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 977155, "client_id": 1907383, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/9b2eae48/uploads/origins/88c1fa1a-4832-4e92-9a66-4d4ecf2dc2ed?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f68e6d51a37b0684a072f4b2e16168cd", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/9b2eae48/uploads/origins/88c1fa1a-4832-4e92-9a66-4d4ecf2dc2ed?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d25a8321eebbf145b80a5e37faf26df0", "src_set": ""}, "body": "青井ゆい先生、こんにちは。\n\nTwitterでとても可愛いイラストを拝見しまして、ぜひ推しのイラストを描いていただきたく、ご依頼の方をさせていただきました。\n\nAiceClass所属、ハコニワリリィのHanonさんのイラストをリクエストいたします。（※有償での二次創作依頼の許可はいただいてます）\n\n衣装、構図、背景等は先生にお任せいたします。先生らしい最高に可愛い作品を期待しています。\n\n公開されている三面図は以下リンクのとおりです。また、Instagramにライブの際の写真等もありますのでこちらもご参考にしていただければと思います。\n\n用途は私の観賞用を予定しておりますが、以下のガイドラインのとおり配信のサムネイル等に使用される場合がございますので、ご理解の上引き受けていただけますと幸いです。\nhttps://aiceclass.com/gu