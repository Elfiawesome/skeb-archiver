tter）で投稿等・SNS広報活動\n\n【ファイル形式】\n・PNG形式で、人物と背景を分けていただけると嬉しいです。\n\nお忙しいところ恐縮ですが、ご検討のほどよろしくお願いいたします！\n\nhttps://drive.google.com/drive/folders/18inffItIas-D-JXS2zl9cEGM1AyI6n3C?usp=sharing", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@usa_dark_matter/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1702533, "client_id": 3627919, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/6b845abd/uploads/origins/83595d9c-3103-4623-bb30-5441dcbc5fc8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=eb2997a6efe26dc1fd06b59d6396d6bc", "srcset": "https://si.imgix.net/6b845abd/uploads/origins/83595d9c-3103-4623-bb30-5441dcbc5fc8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=eb2997a6efe26dc1fd06b59d6396d6bc, https://si.imgix.net/6b845abd/uploads/origins/83595d9c-3103-4623-bb30-5441dcbc5fc8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=768a2526ffe57a09ae2d460ee4233bdc 2x, https://si.imgix.net/6b845abd/uploads/origins/83595d9c-3103-4623-bb30-5441dcbc5fc8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=69231d0cb6f1c73c0b3ba5b73d9ee9e8 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/6b845abd/uploads/origins/83595d9c-3103-4623-bb30-5441dcbc5fc8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=45dab9c50840b9024868f363e67e69c2", "srcset": "https://si.imgix.net/6b845abd/uploads/origins/83595d9c-3103-4623-bb30-5441dcbc5fc8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=45dab9c50840b9024868f363e67e69c2, https://si.imgix.net/6b845abd/uploads/origins/83595d9c-3103-4623-bb30-5441dcbc5fc8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=0f6086dfd4406fb19d7460432cf6757f 2x