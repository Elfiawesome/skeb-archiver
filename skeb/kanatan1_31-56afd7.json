w=200&h=200&blur=200&s=8d7928b4155e1cfbaa59c031d3424026 2x, https://si.imgix.net/fbf59c98/uploads/origins/9afd65ea-e3dc-42d7-b1a5-0091666e8f5e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=cada72b66b07de817dd8876218baa130 3x"}, "body": "こんにちは！\nナズーリンの素敵なイラストをありがとうございました！\nまたナズーリンを描いていただけませんか？\nその際は、エキゾチックダンサーの衣装を着たナズーリンを描いてください！\n全てお任せします。\nありがとうございました！\n\nHello!\nThank you very much for the wonderful illustration of Nazrin!\nWould you be able to draw Nazrin again?\nIf so, please draw Nazrin wearing an exotic dancer outfit!\nI'll leave everything up to you.\nThank you very much!", "nc": 32, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@kanatan1_31/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "comic", "tipped": false, "creator_id": 80430, "client_id": 41262, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/a06d9c4e/uploads/origins/28998a53-6497-4802-803d-b9a96c7083a3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2d9ee086a91e10d6577c603f132818d9", "srcset": "https://si.imgix.net/a06d9c4e/uploads/origins/28998a53-6497-4802-803d-b9a96c7083a3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2d9ee086a91e10d6577c603f132818d9, https://si.imgix.net/a06d9c4e/uploads/origins/28998a53-6497-4802-803d-b9a96c7083a3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=0a82aac39500f06ed4c4a14f145f58ea 2x, https://si.imgix.net/a06d9c4e/uploads/origins/28998a53-6497-4802-803d-b9a96c7083a3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=25a96bdcaa082ef7c7f1262d3ed1e762 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/a06d9c4e/uploads/origins/28998a53-6497-4802-803d-b9a96c7083a3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d05a8e12915da