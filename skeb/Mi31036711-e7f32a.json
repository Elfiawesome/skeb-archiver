e6cd26?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f1736737ba5cad8accc8d5636e599fbe, https://si.imgix.net/25b16955/uploads/origins/2b3e17b1-eadd-4128-895f-16c509e6cd26?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=e9df3d1a518727b4ba10606a47e30e64 2x, https://si.imgix.net/25b16955/uploads/origins/2b3e17b1-eadd-4128-895f-16c509e6cd26?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=dfc72f609572a9b370ac442f38d43ef9 3x"}, "body": "こんにちは、我です\n\n今回はあくたんです！あくたん難しいよねー、髪の毛とか特に。パスタもあくたん描いてたけど諦めました。もう目から描けなくて...\nそんな話は置いておきましょう。\n\nさて、描いて欲しいものですがイメージとしては半額のシールがついたスーパーの弁当を嬉しそうに頬張るあくたんでお願いします。部屋のデザインはお任せしますが、散らかしておいてください(ゴミ屋敷ほどではないです)。脱ぎ捨てた私服や衣装(なんでも可)もできれば描いて欲しいです。あとゴミの中にはレッドブルの空き缶も数本お願いします。あくたんの髪は下ろしてもらって、服装は長袖短パンの部屋着で色は明るめです(脚は机かなんかに隠れる場合があると思うので無理に描かなくても大丈夫です)。あとNEKOのぬいぐるみも置いておいてください。\n\n描きづらいものや構図的に入らないものがあれば無視してもらって構いません。分からないことがあればすべてお任せする形にします(こちらとしてはにんじんのイラストを尊重してますので本当にイメージで描いてもらって大丈夫です)。\n\n長くなりましたが、作品の完成を楽しみに待ってます！ゆっくり描いてもらって構いません！\n\nにんじんファンクラブ第n号、我", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Mi31036711/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2140935, "client_id": 1617881, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/32825fe7/uploads/origins/33e30acc-0a1a-4c4c-ab01-6b98ba26a6f1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6d63daf923bf42a87321fae82f5928d9", "srcset": "https://si.imgix.net/32825fe7/uploads/origins/33e30acc-0a1a-4c4c-ab01-6b98ba26a6f1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6d63daf923bf42a87321fae82f5928d9, https://si.imgix.net/32825fe7/uploads/origins/33e30acc-0a1a-4c4c-ab01-6b98ba26a6f1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=9865f4d98b1daa25657d9792956036c4 2x, https://si.imgix.