0&blur=200&s=b505feb8dfe80cbb5d6b870ffb083ccd 2x, https://si.imgix.net/d41aca36/uploads/origins/34bd081e-24fb-44c8-8b4d-3490be328809?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=d17c914a3dff9c4ff0c61db1754d4774 3x"}, "body": "夜長つくねを後ろから犯してメスイキさせる男の作成をお願いします。\n\n構図としてはこちら（https://www.pixiv.net/artworks/69402096）の、女の子側を夜長つくね、種付けおじさん側を男で、1枚目、4枚目、6枚目、7枚目のような形で、両者とも極力全身が入るような構図でお願いします。\n\n相手の男に関しては、もし顔が映る場合は目を描かないモブ顔にしてほしいです。\n　顔や姿が多く隠れていたり見切れていたりするような形でも大丈夫です。\n服は完全には脱がせず、ズボンを降ろさせるなど最小限度の脱衣でお願いします。\nそれぞれに効果音、夜長の吐息や喘ぎ声を加えてほしいです。\n\n夜長つくねの表情は、\n・挿入時のオ”ッて感じのもの\n・少し感じ初めてとろけたもの\n・絶頂のイキ顔\n・事後の脱力顔\nを希望します。\n\n\nまた、もし可能であれば\n・夜長つくねの下着のみの差分\n・夜長つくねの全裸差分\nの作成をお願いします。\nセンシティブイラストは許容されているようなので制作のほどよろしくお願いします。\nhttps://twitter.com/TsukuneYonaga/status/1514843913617502208\n\nhttps://twitter.com/TsukuneYonaga/status/1498856871913918470", "nc": 56, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@F0reverTwilight/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1807767, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/2dc7fff0/uploads/origins/61335fd7-0daf-461c-a28e-e4c9a0a7183a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=92819ddd9b1004d059ed57810b280e02", "srcset": "https://si.imgix.net/2dc7fff0/uploads/origins/61335fd7-0daf-461c-a28e-e4c9a0a7183a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=92819ddd9b1004d059ed57810b280e02, https://si.imgix.net/2dc7fff0/uploads/origins/61335fd7-0daf-461c-a28e-e4c9a0a7183a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=82797ee1c6ff6f866f77e11e28a6af40 2x, https://si.imgix.net/2dc7fff0/uploads/origins/61335fd7-0daf-461c-a28e-e4c9a0a7183a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=460be8a1be3bd1497694a40ec6f01f5c 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/2dc7fff0/uploads/origins/61335fd7-0daf-461c-a28e-e4c9a0a7183a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=20389f45b36dab72013a4e928bec0c5c", "srcset": "https://si.imgix.net/2dc7fff0/uploads/origins/61335fd7-0daf-461c-a28e-e4c9a0a7183a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=20389f45b36dab72013a4e928bec0c5c, https://si.imgix.net/2dc7fff0/uploads/origins/61335fd7-0daf-461c-a28e-e4c9a0a7183a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=8b55e2a953b18974cae6a00b76672068 2x, https://si.imgix.net/2dc7fff0/uploads/origins/61335fd7-0daf-461c-a28e-e4c9a0a7183a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=28d61b677e31f799f1097261671b6342 3x"}, "body": "初めまして　こんにちは\nイラストを拝見させていただいたのですが、とても絵柄が好みだったので依頼させていただきます。\n両神ナギ（♀）が男とセックスしているところをお願いします。体位は背面座位で、両神ナギ（♀）は男に胸を揉まれながら激しく突かれている形。両神ナギ（♀）の衣装は参考URLにある衣装で着衣でのずらし挿入、着物をずらしておっぱいを露出させてほしいです。もし足先まで映る場合はわらじと靴下は脱がせて素足にしてほしいです。相手の男に関しては、もし顔が映る場合は目を描かないモブ顔にしてほしいです。顔や姿の多くが隠れていたり見切れていたりするような形でも大丈夫です。 \nシチュエーション　両神ナギ（♀）は頬を赤らめたトロ顔の表情、男の激しい攻めに「やぁ、激しぃ、らめぇ」「もうちょっと、やさしく……」みたいな事を口では言いつつも、気持ち良さそうな様子で激しく喘いでいる。 \n確認は取っておりますので制作のほどよろしくお願い致します。\nhttps://twitter.com/nagi_Ookami/status/1515287579322568709\n\nhttps://twitter.com/nagi_Ookami/status/1439905078203215874", "nc": 176, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@F0reverTwilight/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1807767, "client_id": 1036118, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/7724ad63/uploads/origins/27f90f4d-5ad2-4ee8-b2fe-2601cfb4d554?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=cdb63d78beea1e116d78dc3bc29028ab", "srcset": "https://si.imgix.net/7724ad63/uploads/origins/27f90