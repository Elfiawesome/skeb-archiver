いて頂けたらと思います。\n\n下書きや線画があればPSDファイル内に残していただけると嬉しいです。\n\nまた、使用用途として完全個人観賞用にグッズ印刷(アクリルスタンド等)に使わせていただきたいと考えています。配布などは絶対に致しません。\nグッズ利用が不可でございましたらお手数ですがファイル内のどこかに記載していただければと思います。\n\nお時間はいくらかかっても大丈夫です。ご検討の程よろしくお願いします！\n\nhttps://drive.google.com/drive/folders/1-3PEpdWh6icHhnXXYBW6S0Yf3g2N3415", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@JG5o_/works/12", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1823916, "client_id": 1291989, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/2245670f/uploads/origins/ddd0a45b-a289-47d1-b735-bd3e25cf203d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ea5d95291f9769911c116730f4785ec3", "srcset": "https://si.imgix.net/2245670f/uploads/origins/ddd0a45b-a289-47d1-b735-bd3e25cf203d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ea5d95291f9769911c116730f4785ec3, https://si.imgix.net/2245670f/uploads/origins/ddd0a45b-a289-47d1-b735-bd3e25cf203d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=0165c4dff5ca5765c6f89998b4eca34b 2x, https://si.imgix.net/2245670f/uploads/origins/ddd0a45b-a289-47d1-b735-bd3e25cf203d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=5ff638cc0429a7da437c69fb72d646ba 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/2245670f/uploads/origins/ddd0a45b-a289-47d1-b735-bd3e25cf203d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=4cd0f2d3ed2804a68e91902a75a41e63", "srcset": "https://si.imgix.net/2245670f/uploads/origins/ddd0a45b-a289-47d1-b735-bd3e25cf203d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=4cd0f2d3ed2804a68e91902a75a41e63, https://si.imgix.net/2245670f/uploads/origins/ddd0a45b-a289-47d1-b735-bd3e25cf203d?bg=%23fff&auto=format%2Ccompr