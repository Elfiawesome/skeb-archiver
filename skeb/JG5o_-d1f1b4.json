VUj8pzSevga?dl=0\n\n\nどちらもシナリオや秘匿のネタバレは一切ありません。\n\n別々にリクエストを送ろうかなと思ったのですが、一つにまとめたほうが見やすいかも…と思い一つにまとめさせて頂きました。\nよろしくお願い致します…！", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@YYGdayo/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1873841, "client_id": 1823916, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/63ffb617/uploads/origins/d827c551-51f1-4f95-a733-49d5d6bfa267?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=24dd88269f2b9043a5a633ca5e9cffe7", "srcset": "https://si.imgix.net/63ffb617/uploads/origins/d827c551-51f1-4f95-a733-49d5d6bfa267?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=24dd88269f2b9043a5a633ca5e9cffe7, https://si.imgix.net/63ffb617/uploads/origins/d827c551-51f1-4f95-a733-49d5d6bfa267?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=77af06a51232c08439f4524cf20896fc 2x, https://si.imgix.net/63ffb617/uploads/origins/d827c551-51f1-4f95-a733-49d5d6bfa267?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=3a615f6e91eb77077a479c9940d00468 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/63ffb617/uploads/origins/d827c551-51f1-4f95-a733-49d5d6bfa267?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3e9a6a004a66f5c22674d0eaf2d9d223", "srcset": "https://si.imgix.net/63ffb617/uploads/origins/d827c551-51f1-4f95-a733-49d5d6bfa267?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3e9a6a004a66f5c22674d0eaf2d9d223, https://si.imgix.net/63ffb617/uploads/origins/d827c551-51f1-4f95-a733-49d5d6bfa267?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=c932de3f62d9fd91207eb2b9bfc3b4c6 2x, https://si.imgix.net/63ffb617/uploads/origins/d827c551-51f1-4f95-