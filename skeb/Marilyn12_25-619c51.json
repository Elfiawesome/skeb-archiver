るマジアベーゼみたいな状態でお願いします  \nhttps://x.com/miyuki_goods/status/1853029510968729960?s=46&t=CbPdDGeL0E5ssiQePULY2Q\n\n表情は羞恥を感じていて、胸はマリリン様の過去に描いていたロコムジカより大きめが良いです。それと若干汗ばんでいて蒸れているような描写もお願いしたいです。\n以前と同じくマリリン様の変えたいポーズやシチュエーションがありましたらご自由に変更していただいて構いません。  お忙しい中何卒よろしくお願いします。", "nc": 49, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Marilyn12_25/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2739570, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/abe91c1d/uploads/origins/ab260387-b070-43f9-882f-7755f8238871?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6d99d7980571290f799407df46f34ce2", "srcset": "https://si.imgix.net/abe91c1d/uploads/origins/ab260387-b070-43f9-882f-7755f8238871?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6d99d7980571290f799407df46f34ce2, https://si.imgix.net/abe91c1d/uploads/origins/ab260387-b070-43f9-882f-7755f8238871?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=8260f539e9066e037d6e37761581f222 2x, https://si.imgix.net/abe91c1d/uploads/origins/ab260387-b070-43f9-882f-7755f8238871?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=676d6b28fa75cdb54ceefb51801c14fd 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/abe91c1d/uploads/origins/ab260387-b070-43f9-882f-7755f8238871?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ea8ef71d8d39ca6e76f7bfc2eac21e0d", "srcset": "https://si.imgix.net/abe91c1d/uploads/origins/ab260387-b070-43f9-882f-7755f8238871?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ea8ef71d8d39ca6e76f7bfc2eac21e0d, https://si.imgix.net/abe91c1d/uploads/origins/ab260387-b070-43f9-882f-7755f8238871?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200