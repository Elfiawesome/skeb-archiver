でお任せいたします。\n・納品形式は、可能でしたら背景などレイヤー分けされたPSDファイルも添付いただけますと大変有難いです。\n・イラストは1名ずつでも、2人一緒の構図でも、どちらでも大歓迎です。\n・表情や服装、ヘアアレンジなども含め、すべてNEMO🌟様にお任せいたします！\nNEMO🌟様の自由な発想で、楽しく描いていただけましたら幸いです。\n\n以上となります！\n金額の不足など、何か不備がございましたら遠慮なく再送ください。\n\nご検討のほど、どうぞよろしくお願いいたします！\n\nhttps://xfolio.jp/portfolio/newon_won/series/3279143", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@voyager6963/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 4133746, "client_id": 3954887, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/a483d376/uploads/origins/0edd0ad0-d2e8-488a-a5ea-ba93acb41bd7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e7b9f40dedae9242f55ac51ca88acaab", "srcset": "https://si.imgix.net/a483d376/uploads/origins/0edd0ad0-d2e8-488a-a5ea-ba93acb41bd7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e7b9f40dedae9242f55ac51ca88acaab, https://si.imgix.net/a483d376/uploads/origins/0edd0ad0-d2e8-488a-a5ea-ba93acb41bd7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=20b323bf4d225f7f82c4ed5b06745334 2x, https://si.imgix.net/a483d376/uploads/origins/0edd0ad0-d2e8-488a-a5ea-ba93acb41bd7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=281981e1c646244ba040dce8a1b74001 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/a483d376/uploads/origins/0edd0ad0-d2e8-488a-a5ea-ba93acb41bd7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=624d019bae1f236f72e1c0ecaaed973a", "srcset": "https://si.imgix.net/a483d376/uploads/origins/0edd0ad0-d2e8-488a-a5ea-ba93acb41bd7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=624d019bae1f236f72e1c0ecaaed973a, https://si.imgix.net/a483d376/uploads/origins/0edd0ad0-d2e8-488a-a5ea-ba93acb41bd7?bg=%23fff