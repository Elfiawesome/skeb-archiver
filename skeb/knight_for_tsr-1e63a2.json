だきありがとうございました♪今回もまた違う友人への誕生日プレゼントにＸ用のヘッダーをお願いいたします！描いていただきたいイラストは、２０２１年の１２月に行われた東京交響楽団の『ホルン紅白』（https://youtu.be/Uy70x3okMIg?si=ts-qwrgdjWVp-vtc）のホルン奏者である大野雄太さん、上間善之さんのお二人で、その他の出演者、司会の大和田さん、ピアノの石井さんはバランス等あると思いますので羽部様にお任せいたします。お誕生日プレゼントですし、紅白でもありますのでおめでたい雰囲気にしていただけると嬉しいです♪どうぞよろしくお願いいたします！", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@knight_for_tsr/works/8", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/232237f2/uploads/origins/dcdf66c9-19f4-475b-a834-1f3940fbdda5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=bb90c3e631968ed4b36943c6108d3251", "srcset": "https://si.imgix.net/232237f2/uploads/origins/dcdf66c9-19f4-475b-a834-1f3940fbdda5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=bb90c3e631968ed4b36943c6108d3251, https://si.imgix.net/232237f2/uploads/origins/dcdf66c9-19f4-475b-a834-1f3940fbdda5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=548aabf646ad707f362495e9eebe22e3 2x, https://si.imgix.net/232237f2/uploads/origins/dcdf66c9-19f4-475b-a834-1f3940fbdda5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=b1634b17fd235f5f3afe14a2c4341d27 3x"}, "private": true, "genre": "art", "tipped": true, "creator_id": 1394903, "client_id": 2940803, "nc": 51}, {"path": "/@knight_for_tsr/works/7", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/d11f0f4c/uploads/origins/023dc426-2916-4963-96a2-43abf7f5b890?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FF