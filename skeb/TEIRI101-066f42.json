4c-8072-229accee9298?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=8a8f87befa1ed7ab0137158ef8903568", "srcset": "https://si.imgix.net/53c39a49/uploads/origins/1417d02d-9d45-494c-8072-229accee9298?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=8a8f87befa1ed7ab0137158ef8903568, https://si.imgix.net/53c39a49/uploads/origins/1417d02d-9d45-494c-8072-229accee9298?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=43593ef1ca8cc8fbecaf7bab91e0caf5 2x, https://si.imgix.net/53c39a49/uploads/origins/1417d02d-9d45-494c-8072-229accee9298?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=444ae7507a9a96e135aec5d157220e45 3x"}, "body": "初めまして🦇\n\nこの度はアピールありがとうございました。\nうちの子を気に入ってくださり、大変うれしいです！\n\nOCが複数居るので、見てくださった子と違っていたらすみません。\n下記の２キャラのイラストをお願いしてもよろしいでしょうか？\n\n血主様🦇\nhttps://x.com/rule_rosePSO2/status/2026140108760732006?s=20\n\n緗樂🐏\nhttps://x.com/rule_rosePSO2/status/2016542195734761690?s=20\nhttps://x.com/rule_rosePSO2/status/2027263027113034052?s=20\n\n選出の理由は拝見したていり様の絵柄や、ていり様自身のOCの子たちに雰囲気が似ている２名かなと思ったからです。\n\n★構図\n・血主様が緗樂へ食べ物を「あーん」させているシチュ\n・二人とも無表情（がデフォルトな為）\n・食べ物は人間の手✋。センシティブと判断された場合は骨付き肉🍖\n\n★キャラ捕捉\n・血主様\n吸血鬼の始祖でとても偉い。見た目は９歳くらい幼女。未亡人イメージの黒いドレスを着ている。\n\n・緗樂\n饕餮と那伽のハーフの人外で、血主様に吸血鬼の眷属にされた。\n吸血鬼化しているが元から人外なので食事は何でも食べる。\n岩とかも食べる。いつもお腹が空いていて、血主様に懐きまくっている。\n\n以上になります。\n長文大変失礼しました！\nよろしくお願いいたします🦇", "nc": 8, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@TEIRI101/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3917176, "client_id": 3647528, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/93763bf9/uploads/origins/3c8faf0d-786f-4860-bc87-b7c868a7635c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=906ddcf1bf534c5a0c9f8d1a958cef5c", "srcset": "https://si.imgix.net/93763bf9/uploads/origins/3