": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@regle_t/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2283121, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/cfe943c2/uploads/origins/453da019-c5aa-489b-9344-ed02464678b7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=75c48396f626be1ac1bf294b94a41aaa", "srcset": "https://si.imgix.net/cfe943c2/uploads/origins/453da019-c5aa-489b-9344-ed02464678b7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=75c48396f626be1ac1bf294b94a41aaa, https://si.imgix.net/cfe943c2/uploads/origins/453da019-c5aa-489b-9344-ed02464678b7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=baf042d01c723c10f1bf1cf6a63efaf0 2x, https://si.imgix.net/cfe943c2/uploads/origins/453da019-c5aa-489b-9344-ed02464678b7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b0bfb95c552485131a4c7468cbf46c81 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/cfe943c2/uploads/origins/453da019-c5aa-489b-9344-ed02464678b7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=54faf1719db95f2e4071878479d199f1", "srcset": "https://si.imgix.net/cfe943c2/uploads/origins/453da019-c5aa-489b-9344-ed02464678b7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=54faf1719db95f2e4071878479d199f1, https://si.imgix.net/cfe943c2/uploads/origins/453da019-c5aa-489b-9344-ed02464678b7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=62f60b91716f0b53125d990fe4ae82b8 2x, https://si.imgix.net/cfe943c2/uploads/origins/453da019-c5aa-489b-9344-ed02464678b7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=19ff61639e34bc47452195b190b8bbd4 3x"}, "body": "こんにちは。以前にワタツミのイラストを依頼した者です。前回のイラストが非常に良かったため、また依頼をさせていただきたいと思います。承認していただけますと幸いです。\n\nジャンル：モンスターストライク\nキャラクター：ワタツミ神化（参考資料：https://dic.xflag.com/monsterstrike/character/3952）\n服装：地雷服。デザインはお任せします。マスクは無しで、顔全体が見えるようにお願いします。\n体型：胸・身長は大きく（普段のイラストと同程度）でお願いします。髪型はお任せしますが、参考画にある額の冠だけはマストでお願いします。\n前回のイラストと同様のイメージで描いていただきたいです。\n\nシチュエーション\nベッドに腰かけたワタツミが、オタク君に膝枕をしようとしているイメージです。片手はオタク君の方向へ伸ばし、反対の手で膝をポンポンと叩いている感じでお願いします。\n状況としては、仕事で疲れたオタク君をワタツミが甘やかそうとしている、というものをイメージしています。\nオタク君本人は映さず、あくまで「誘っている」ようなイメージになります（過去イラストhttps://www.pixiv.net/artworks/104578980　の１～２枚目の様な形でお願いします。）。\n可能であれば、前回のように台詞の有無で差分をいただけると助かります。\n\n衣服のデザインや構図、背景等、上記の指定外の部分はすべてお任せします。\nお忙しいところ恐縮ですが、承認していただけますと幸いです。何卒宜しくお願い致します。", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@regle_t/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2283121, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/8ccbe560/uploads/origins/7cd2e69f-3c98-463f-86c4-7ad0f1080e5f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c2860e0409aebe89d1cef6305bc6a164", "srcset": "https://si.imgix.net/8ccbe560/uploads/origins/7cd2e69f-3c98-463f-86c4-7ad0f1080e5f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c2860e0409aebe89d1cef6305bc6a164, https://si.imgix.net/8ccbe560/uploads/origins/7cd2e69f-3c98-463f-86c4-7ad0f1080e5f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=6319c704796b0d3f6ef745f8646116c8 2x, https://si.imgix.net/8ccbe560/uploads/origins/7cd2e69f-3c98-463f-86c4-7ad0f1080e5f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=1a57855acee8450714293dd37fcff13e 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/8ccbe560/uploads/origins/7cd2e69f-3c98-463f-86c4-7ad0f1080e5f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2a9166e8607af7e79bc0c18593757dd0", "srcset": "https://si.imgix.net/8ccbe560/uploads/origins/7cd2e69f-3c98-463f-86c4-7ad0f1080e5f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2a9166e8607af7e79bc0c18593757dd0, https://si.imgix.net/8ccbe560/uploads/origins/7cd2e69f-3c98-463f-86c4-7ad0f1080e5f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=8ef8c6ef960a5a9e8928ded46edc1403 2x, https://si.imgix.net/8ccbe560/uploads/origins/7cd2e69f-3c98-463f-86c4-7ad0f1080e5f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=f3c0790722b38fb4b339c8815bc2f322 3x"}, "body": "はじめまして。あなたの描く長身地雷系イラストが非常に好みなため、私の推しキャラを依頼したいと思います。版権キャラになりますが、承認していただけると幸いです。\n\nジャンル：モンスターストライク\nキャラクター：ワタツミ神化（参考資料：https://dic.xflag.com/monsterstrike/character/3952）\n服装：地雷服。デザインはお任せします。マスクは無しで、顔全体が見えるようにお願いします。\n体型：胸・身長は大きく（普段のイラストと同程度）でお願いします。髪型はお任せしますが、参考画にある額の冠だけはマストでお願いします。\n\nシチュエーション\nオタク君が電車の中でワタツミに守ってもらってるようなイメージです。背の低いオタク君がワタツミに抱き着き、胸に顔を埋めている感じでお願いします。\nワタツミ自身はオタク君を全力で甘やかしているイメージになります。\nもし可能であれば、甘やかしている台詞の有無で差分をいただけると助かります。\n\n以上となります。稚拙な文章かつ版権キャラで申し訳ありませんが、もし可能でしたら承認宜しくお願い致します。", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@regle_t/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2283121, "client_id": 134041, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/1ffafaaa/uploads/origins/95fde70b-7402-43e9-a98b-2c0ef713e0b5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d5bfefdd9a2f0c4562bbb300d0347a5d", "srcset": "https://si.imgix.net/1ffafaaa/uploads/origins/95fde70b-7402-43e9-a98b-2c0ef713e0b5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d5bfefdd9a2f0c4562bbb300d0347a5d, https://si.imgix.net/1ffafaaa/uploads/origins/95fde70b-7402-43e9-a98b-2c0ef713e0b5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&f