82a-287e19b06caa?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=1197a95c391b4755350b2dcb2d143e03, https://si.imgix.net/147b74d1/uploads/origins/7981af69-6e71-48bd-982a-287e19b06caa?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=a31a00181c0555971a643cb18eabaa40 2x, https://si.imgix.net/147b74d1/uploads/origins/7981af69-6e71-48bd-982a-287e19b06caa?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=21eea667753fa91bb3aed1fe24d3c80a 3x"}, "body": "いつもお世話になっております。\nいただいたイラストを日々眺めては有頂天になっています、本当に素敵なイラストをありがとうございます……！\nまたOCを描いていただきたいと思いましたので、依頼させていただきます。\n\n■要望\n資料内の男性の夢絵を描いていただきたいです。\n構図やシチュエーション等はおまかせいたします。\n\n■設定(水色の髪のキャラクター)\n・ギリシャ神話に登場する「ヘルマプロディートス」をモチーフにしています。\n・前髪含む毛先がピンク色に染まっています。\n・過去のトラウマにより自分自身に関する恋愛事に苦手意識を持っています。\n\n■設定(メカクレのキャラクター)\n・北欧神話に登場する「ヘズ(ホズ)」をモチーフにしています。\n・正面から見て左目が金色(兄と交換したもの)、右目が黒色(瞳孔部分が紫色)です。\n・髪飾りと似たデザインのペンダントを身につけています。\n\n■用途\n個人的な鑑賞、自サイトやSNS等自創作を載せている場所での共有、個人的な印刷です。\n商用利用はいたしません。\n\nわからないところがありましたら偽造等していただいて構いません。\nご検討いただければ幸いです。\n\nhttps://drive.google.com/drive/folders/1g4781zEQ1kjNdbpTi4EPklepbREg88RR?usp=sharing", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@sousaku_tee/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 4128691, "client_id": 3332065, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/e5c50649/uploads/origins/e7806656-9ec0-4097-914c-fc66c31ad7d0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0d1b34b78665b0bf200930478a148faa", "srcset": "https://si.imgix.net/e5c50649/uploads/origins/e7806656-9ec0-4097-914c-fc66c31ad7d0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0d1b34b78665b0bf200930478a148faa, https://si.imgix.net/e5c50649/uploads/origins/e7806656-9ec0-4097-914c-fc66c31ad7d0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=2b97c304c8792483456b4dea3fb3f274 2x, https://si.imgix.net/e5c50649/uploads/origins/e7806656-9ec0-4097-914c-fc66c31ad7d0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=790bba39995c758ed8b45a5ea6a675ac 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/e5c50649/uploads/origins/e7806656-9ec0-4097-914c-fc66c31ad7d0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0dc7b4eb9b0013849780ff40d6653d89", "srcset": "https://si.imgix.net/e5c50649/uploads/origins/e7806656-9ec0-4097-914c-fc66c31ad7d0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0dc7b4eb9b0013849780ff40d6653d89, https://si.imgix.net/e5c50649/uploads/origins/e7806656-9ec0-4097-914c-fc66c31ad7d0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=791af143e651a5d959c2b426451cd10d 2x, https://si.imgix.net/e5c50649/uploads/origins/e7806656-9ec0-4097-914c-fc66c31ad7d0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=52b9138e54ce54ca18878908ab8a8d79 3x"}, "body": "お世話になっております、mieと申します。\nOCの素敵なイラストを納品してくださり、本当にありがとうございました……！\nどの表情も最高で、目に入るたびにとてもドキドキしています！\nまたOCを描いていただきたく、依頼させていただきます……！\n\n■要望\n資料内の男性の夢絵を描いていただきたいです。\n構図やシチュエーション等はおまかせいたします。\n詰め合わせのイラストを描かれる場合、一シーンのみヤンデレのような雰囲気だと嬉しいです……！\n\n■設定\nオレンジ髪＋黄色の目。夢主の幼馴染である高校生です。\n赤いラインが入った制服＋赤ネクタイ。\n前髪を後ろに留めた髪型(ポンパドール)で、既に亡くなっているため目のハイライトが上部に位置していないデザインになっています。\n首に縫いあとがあるのを、髪留めと同じ灰緑色のチョーカーで隠しています。\n首以外にも縫いあとがあるため、基本的に露出度が高い格好はしません。\n\n不幸を呼び寄せる体質で、それにより亡くなってしまいゾンビになっています。オカルトが大好きなシリアスブレイカー。\n基本的に重い一面がないキャラクターですが、時々うっすらとした重みが出ているときがあります。\nゾンビになっているため感覚がうまく働かず、赤面や発汗もしません。\n\n■用途\n個人的な鑑賞、自サイトやSNS等自創作を載せている場所での共有、個人的な印刷です。\n商用利用はいたしません。\n\nわからないところがありましたら偽造等していただいて構いません。\nご検討いただければ幸いです。\n\nhttps://drive.google.com/drive/folders/1dBTbdVqLHDvJR1pew-WAGOhZZeuSftVc?usp=sharing", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@sousaku_tee/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 4128691, "client_id": 3332065, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/9f2027b5/uploads/origins/b8256e65-99f4-45ec-ad0a-0d69ca2bd5ed?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c6186b2cd13b91414bc919c626c00b15", "srcset": "https://si.imgix.net/9f2027b5/uploads/origins/b8256e65-99f4-45ec-ad0a-0d69ca2bd5ed?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c6186b2cd13b91414bc919c626c00b15, https://si.imgix.net/9f2027b5/uploads/origins/b8256e65-99f4-45ec-ad0a-0d69ca2bd5ed?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=3d9e0909534820de540f0ed65c958255 2x, https://si.imgix.net/9f2027b5/uploads/origins/b8256e65-99f4-45ec-ad0a-0d69ca2bd5ed?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=44b93608ef573eb0c759b87e9bcd8b7c 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/9f2027b5/uploads/origins/b8256e65-99f4-45ec-ad0a-0d69ca2bd5ed?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=56037e1b077e7f3015c3978779e4e3ac", "srcset": "https://si.imgix.net/9f2027b5/uploads/origins/b8256e65-99f4-45ec-ad0a-0d69ca2bd5ed?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=56037e1b077e7f3015c3978779e4e3ac, https://si.imgix.net/9f2027b5/uploads/origins/b8256e65-99f4-45ec-ad0a-0d69ca2bd5ed?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=146bdec2d14738dc1c351aa6f3ee9526 2x, https://si.imgix.net/9f2027b5/uploads/origins/b8256e65-99f4-45ec-ad0a-0d69ca2bd5ed?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=a46bfa845c3c4febcf72e7e7aaf46f0b 3x"}, "body": "お世話になっております、mieと申します。\nカオルくんたちやうぞむぞをはじめとしたヤンデレ創作をいつも楽しく拝見しています！\nほーじちゃさんに是非描いていただきたいOCがいますので、依頼させていただきます。\n\n■要望\n資料内の男性の夢絵を描いていただきたいです。\n女性夢主/男性の幼馴染設定だと嬉しいです。\nそれ以外の構図やシチュエーション等はおまかせいたします。\n\n■設定\n緑色の髪と目。スクエア型の眼鏡を身につけている二十歳の大学生。\n全体的にゆったりした服装で、セーターは萌え袖気味です。\nデスゲームの舞台となる仮想空間では緑髪緑目になっていますが、現実世界では黒髪黒目です。\n\nデスゲームに強制参加させられた人たちに紛れこむ黒幕で、ゲーム中は別人を名乗っています。\n幼いころに母親が病に苦しみ、それを善意で隠そうとする父親を兄と幼馴染の夢主と一緒にどうにかしようとしますが、二人とも約束した集合場所にきませんでした。\nそれから母親が亡くなってしまったと勘違いし、約束を破った二人に憎しみを抱き、復讐するためにデスゲームを開きました。\n仮想空間が舞台となっているためループ可能で、何度も二人の絶望する顔を見ています。\n憎しみが強いですが、別人としての自分に優しくする二人やかつての思い出に苦い感情も抱いています。愛憎型ヤンデレ。\n\n夢主のことを、別人のふりをしているときは「ナマエさん(さん付け)」、本性を見せているときは「ナマエ(呼び捨て)」で呼びます。\n\n■用途\n個人的な鑑賞、自サイトやSNS等自創作を載せている場所での共有、個人的な印刷です。\n商用利用はいたしません。\n\nわからないところがありましたら偽造等していただいて構いません。\nご検討いただければ幸いです。\n\nhttps://drive.google.com/drive/folders/1JjBsMWiu0Qn_FANMJY6Lqafgkih1hNLf?usp=sharing", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 2626776, "creator": true, "nsfw_acceptable": false, "acceptable": false, "name": "しばはち", "screen_name": "_siba8", "avatar_url": "https://pbs.twimg.com/profile_images/1957740367086063616/c6G1d30V.jpg", "header_url": null, "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 10, "complete_expiration_days": 120, "skills": [{"genre": "art"}], "banned": false, "nc": 144}, {"id": 3183222, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "鉛分", "screen_name": "darkolivegree", "avatar_url": "https://pbs.twimg.com/profile_images/1931418378650124288/mtEflnGq.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1386177024574713856/1749299866/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "