て引き受けた事で醜い姿へと変わってしまった元土地神です。\n\n※1頭身の怪物はバスケットボールより少し小さいくらいで、少女が抱えられるサイズです。\n※少女の瞳は完成イラストの方を参照して下さい(怪物と同じ色をしています)\n\nラフ、線画、色等でレイヤーが分かれているPSDを頂けると嬉しいです。\n以上、ご検討ヨロシクお願いします！\n\nhttps://drive.google.com/drive/folders/1uNAZb6Qch8FmXlEV5EN3C6ipW7ExNOFY?usp=sharing", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@yamamotokoroo/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 4138323, "client_id": 2732303, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/63f98395/uploads/origins/72818d62-41d5-4f0a-abfa-8e9e4f5b28b1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=34a025f2e26a40c2f21af3c353022361", "srcset": "https://si.imgix.net/63f98395/uploads/origins/72818d62-41d5-4f0a-abfa-8e9e4f5b28b1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=34a025f2e26a40c2f21af3c353022361, https://si.imgix.net/63f98395/uploads/origins/72818d62-41d5-4f0a-abfa-8e9e4f5b28b1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=aca62d9b2213e8668943ff248569e373 2x, https://si.imgix.net/63f98395/uploads/origins/72818d62-41d5-4f0a-abfa-8e9e4f5b28b1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ab62500fdd2cc5b9f5b12b3d1fe0e5d8 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/63f98395/uploads/origins/72818d62-41d5-4f0a-abfa-8e9e4f5b28b1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=7b21149b3df98417e81078d67d75a000", "srcset": "https://si.imgix.net/63f98395/uploads/origins/72818d62-41d5-4f0a-abfa-8e9e4f5b28b1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=7b21149b3df98417e81078d67d75a000, https://si.imgix.net/63f98395/uploads/origins/72818d62-41d5-4f0a-abfa-8e9e4f5b28b1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=