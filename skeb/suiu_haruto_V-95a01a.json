7c-9ce5-67d0fa65b426?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=3124ba5e2db7b5d9c8f0d220958fb648 3x"}, "body": "ハルトさんこんにちは！VTuberの曇一絃です。\n\nSkeb開設ありがとうございます！ハルトさんの透明感ある色の塗り方、魅力的なキャラクターデザインそして華奢な体の描き方にとても惹かれて、ぜひリクエストをさせていただきたいです。\n\nサムネイル用の半身もしくは全身のイラストを描いてほしいです（背景はなし/単色で大丈夫です。）できれば人外衣装でお願いしたいですが、作画コストが高いので髪型や衣装をアレンジしていただいて構いません。\nまた、もし他の衣装でイラストのイメージが浮かぶのであればそちらで描いて頂いてもかまいません。\nハルトさんの絵柄がとても好きなので、何を描いて頂いても嬉しいです！\n\nポーズ、衣装などすべてお任せ致します。\n（満面の笑みや可愛い表情/ポーズはOOCの可能性があるので避けたいです。クールで飄々とした感じにしたいです。影ある悪そうな感じも好きです。）\n\n■作画するうえでお願いしたい部分（間違いやすいかもです）\n・目がオッドアイです。\n・左目の下にほくろがあります。\n\nアバウトなリクエストですみません、ご検討のほどよろしくお願い致します。\n\nhttps://drive.google.com/drive/folders/1_ZFj7fNJqmtg_JMB20XPAgVYErQ6jGLl?usp=sharing", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@suiu_haruto_V/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3677836, "client_id": 1805856, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/0181bd2d/uploads/origins/6ad333e7-c341-43e8-b2d2-9810217dd988?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f4cbf0b7efc25dfede33166b4e9a626b", "srcset": "https://si.imgix.net/0181bd2d/uploads/origins/6ad333e7-c341-43e8-b2d2-9810217dd988?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f4cbf0b7efc25dfede33166b4e9a626b, https://si.imgix.net/0181bd2d/uploads/origins/6ad333e7-c341-43e8-b2d2-9810217dd988?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=befb35f09c1e9a137d56e97fe90a76f3 2x, https://si.imgix.net/0181bd2d/uploads/origins/6ad333e7-c341-43e8-b2d2-9810217dd988?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=950d380a011f4cff13f5078f5cf1f0ff 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/0181bd2d/uploads/origins/6ad333e7-c341-43e8-b2d2-9810217dd988?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=efe74e97e1ee2b4fe7ed0afc7ba14933", "srcset": "https://si.imgix.net/0181bd2d/uploads/origins/6ad333e7-c341-43e8-b2d2-9810217dd988?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=efe74e97e1ee2b4fe7ed0afc7ba14933, https://si.imgix.net/0181bd2d/uploads/origins/6ad333e7-c341-43e8-b2d2-9810217dd988?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=d498a249a9c42c073ee59f9fd2aa43b4 2x, https://si.imgix.net/0181bd2d/uploads/origins/6ad333e7-c341-43e8-b2d2-9810217dd988?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=990c2a85ef60856dc596f35c8f7e75c2 3x"}, "body": "こんにちは！\nskebからご依頼失礼します…！\n\n【キャラクター】\n魔累マヒト\n【構図、テーマ】\nテーマはお化け屋敷(病院)で、ビビってる人(一緒に来た人)に対して、不気味にニヤついてる姿をお願いしたいです！\n構図などは、おまかせ致します…！\n\n出来ればなのですが、服装などは、パンク？サブカルっぽい夏服でお願いしたいです。\n\n【使用用途】\n今後の活動や、ツイートの時などに使用したいと思ってます！\n\nよろしくお願いします。\n\nhttps://drive.google.com/file/d/1TVDiGg5p3opkudD0FDZJffC-Z5aoMXQT/view?usp=drivesdk", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@suiu_haruto_V/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3677836, "client_id": 3681505, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/dffeae63/uploads/origins/61fc7bb2-ba50-49e0-9d0e-2f89d392f44e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1b1d4cd98ee76c584acb7ec002afef5a", "srcset": "https://si.imgix.net/dffeae63/uploads/origins/61fc7bb2-ba50-49e0-9d0e-2f89d392f44e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1b1d4cd98ee76c584acb7ec002afef5a, https://si.imgix.net/dffeae63/uploads/origins/61fc7bb2-ba50-49e0-9d0e-2f89d392f44e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=87069bead61c2ea4246905d3d53589ef 2x, https://si.imgix.net/dffeae63/uploads/origins/61fc7bb2-ba50-49e0-9d0e-2f89d392f44e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=03251b64a9aff446995b3e992c16aeb7 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/dffeae63/uploads/origins/61fc7bb2-ba50-49e0-9d0e-2f89d392f44e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6ce348aa457a3e88d131cfcade0fcf04", "srcset": "https://si.imgix.net/dffeae63/uploads/origins/61fc7bb2-ba50-49e0-9d0e-2f89d392f44e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6ce348aa457a3e88d131cfcade0fcf04, https://si.imgix.net/dffeae63/uploads/origins/61fc7bb2-ba50-49e0-9d0e-2f89d392f44e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=d8d1bcec64025700b5f9849eebf5aad2 2x, https://si.imgix.net/dffeae63/uploads/origins/61fc7bb2-ba50-49e0-9d0e-2f89d392f44e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=2a3be456456eda9f88aae34ba853fa35 3x"}, "body": "お世話になっております。\n以前はリクエスト受けて下さりありがとうございました！\nフォロワーさんにも大好評で、是非他のイラストも見たい…！とのお声を頂いたので、再度リクエストをお送りさせていただきました！ご迷惑でしたらキャンセルをして頂いても構いません。下記依頼内容になります。\n\n〇キャラ\n→瀬戸 ハルキ\n\n〇構図や服装など\n→構図はお任せで、衣装は普段着なさそうな服装を着せて頂きたいです…！\n女装、男装どちらでも可　制服やメイド服、ロリィタ等お好きなお洋服をお願い致します…！\n\n〇使用用途\n→ツイートでの紹介や、Xでのアイコンとしての使用\n配信等のサムネに使用させて頂きたいです。\n\n〇その他希望\n→表情差分を１つ頂けますと嬉しいです。\n※難しいようでしたら無しでも構いません\n\nご検討、よろしくお願い致します！\n\nhttps://drive.google.com/drive/folders/16JOcH5LGOD57PAbGn6Se9htTWV_kd209?usp=drive_link", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@suiu_haruto_V/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3677836, "client_id": 527465, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/328d8b41/uploads/origins/e039aec4-976b-4a7f-b78e-7eec7c2d106f?bg=%23f