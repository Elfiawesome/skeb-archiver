&h=200&s=bfc2dee53055f0a70ae69720895888b3", "srcset": "https://si.imgix.net/0b8c74d6/uploads/origins/6e87acd0-b103-4159-a98f-fca74d3da785?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bfc2dee53055f0a70ae69720895888b3, https://si.imgix.net/0b8c74d6/uploads/origins/6e87acd0-b103-4159-a98f-fca74d3da785?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=14b6101f2e4c36f720a56fde7296301b 2x, https://si.imgix.net/0b8c74d6/uploads/origins/6e87acd0-b103-4159-a98f-fca74d3da785?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=7bbd25b9b8b5b104dfb007a1bd33e020 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/0b8c74d6/uploads/origins/6e87acd0-b103-4159-a98f-fca74d3da785?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=afe14b5a0a8429b2dd7faa567c42c040", "srcset": "https://si.imgix.net/0b8c74d6/uploads/origins/6e87acd0-b103-4159-a98f-fca74d3da785?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=afe14b5a0a8429b2dd7faa567c42c040, https://si.imgix.net/0b8c74d6/uploads/origins/6e87acd0-b103-4159-a98f-fca74d3da785?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=05580982302aeaae0bf2dfeaf8fcd3d1 2x, https://si.imgix.net/0b8c74d6/uploads/origins/6e87acd0-b103-4159-a98f-fca74d3da785?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=d22fd2109b49c59a903a40abb4742960 3x"}, "body": "こんにちは。友人へのプレゼントを準備しています。彼のキャラクターのデッサンをお願いしたいです。ポーズは、ベッドに横たわっていて、髪の毛が下に広がっていて、近くの窓から光が入っていて、ズボンのふくらみが適度にある、というのを入れました。ありがとうございました。\n\nhttps://drive.google.com/drive/folders/1ico2--wiuYwFEYkzn21HvA-4trdp0vST", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@kikimetal/works/13", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "cr