同時に、彼女はレイヴンに情熱的なキスもしています。スターファイアーの舌はレイヴンの口の中に深く入り込み、レイヴンの中にある自分のチンコを舐めています。\n\nスターファイアは嬉しそうにレイヴンの尻の中に大量に精液を出し、自分の精液を味わう。徹底的に犯され、非常にオーガズム的な表情を浮かべるRaven。\n\nスターファイアは少し背が高く、スポーツマンらしい体型をしている。一方、レイヴンは少し背が低く、胸とお尻が大きめです。\n\nX線バージョンとX線がないバージョンもお願いします。\n\nご検討ありがとうございました。\n\nhttps://imgur.com/a/5wQH4bn", "nc": 40, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@kikimetal/works/12", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 491827, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/69b86076/uploads/origins/b6c47333-8814-4203-aca5-6c34b8edc8c7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=def2557d67f8f975a16df109ba37a4ee", "srcset": "https://si.imgix.net/69b86076/uploads/origins/b6c47333-8814-4203-aca5-6c34b8edc8c7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=def2557d67f8f975a16df109ba37a4ee, https://si.imgix.net/69b86076/uploads/origins/b6c47333-8814-4203-aca5-6c34b8edc8c7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=83420577988e35d4510dd3bcceddd551 2x, https://si.imgix.net/69b86076/uploads/origins/b6c47333-8814-4203-aca5-6c34b8edc8c7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=9b24aad10839d2193892645a5d8227da 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/69b86076/uploads/origins/b6c47333-8814-4203-aca5-6c34b8edc8c7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=992cbd12b8d4954a7abc84de7f176496", "srcset": "https://si.imgix.net/69b86076/uploads/origins/b6c47333-8814-4203-aca5-6c34b8edc8c7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=992cbd12b8d4954a7abc84de7f176496, https://si.imgix.net/69b86076/uploads/origins/b6c47333-8814-4203-aca5-6c34b8edc8c7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=b58a62468804afb04b4eb1d669967edf 2x, https://si.imgix.net/69b86076/uploads/origins/b6c47333-8814-4203-aca5-6c34b8edc8c7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=b75c6b0170303028737e4ffef9301201 3x"}, "body": "こんにちは！今回は、私のオリジナルキャラクターを描いていただきました。私のオリジナルキャラクターを描いてくれたら嬉しいです。あなたの画風であれば、とても美しいものになると思います。\n\n彼らの名前はArachneです。元メタルバンドのボーカルで、バンドを辞めた後に科学者になった人たちです。蜘蛛とロックを連想します。\n\nある実験が失敗した後、彼らは体の周りを「動く」（まるで皮膚の下で触手が動いているかのような）奇妙な皮膚病を発症し、それはとても不穏なものに見えます...。そのため、これ以上皮膚の状態が広がらないように、服の下にタイトなスーツを着なければならないのです。今回の作品では、スーツを着ている状態と着ていない状態を選んで描くことができます。\n\n衣装はちょっとおかしな感じなので、変えてもいいかもしれません。このキャラクターは特に男性でも女性でもないので、どんな服装でも良いと思います。アルバムの2枚目の写真は、より正確に彼らの体型を表しています。\n\nお好きなように描いてください。ありがとうございました。\n\nhttps://sta.sh/2a35ipelcog", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@kikimetal/works/11", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 491827, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/bc1d62ab/uploads/origins/6d40b131-8fcf-46b2-a825-1750472827f4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ff1b00f4d42547da49b54e25c6197aaf", "srcset": "https://si.imgix.net/bc1d62ab/uploads/origins/6d40b131-8fcf-46b2-a825-1750472827f4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ff1b00f4d42547da49b54e25c6197aaf, https://si.imgix.net/bc1d62ab/uploads/origins/6d40b131-8fcf-46b2-a825-1750472827f4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=49bbb63be485c4b46bee7ba6fb748bb6 2x, https://si.imgix.net/bc1d62ab/uploads/origins/6d40b131-8fcf-46b2-a825-1750472827f4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=066adf667480fafb00efcd92349b92a7 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/bc1d62ab/