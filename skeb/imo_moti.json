n参考資料ですがURLの方からご確認頂けたら幸いです。\n\n\n▽使用用途\n動画のサムネイル、配信、動画内での使用、SNS活動などで使用させて頂きたく思います。\n(可能でしたらサムネイルなどに使用させて頂きたいので人物と背景を分けた物もいただけたらなと思います。)\n\n\n不慣れで拙い文章ではありますが最後までお読み頂きありがとうございます。\n改めまして、宜しくお願い致します。\n\nhttps://drive.google.com/drive/folders/1sv2-nPkBKyRHtw6MFcr1ieHjs_ShzJ0w?usp=sharing", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@imo_moti/works/8", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/4e1c10d0/uploads/origins/bbb86201-5c88-4dad-b8b4-8dedbcac029c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=8c8dacface8d316e0c8bd778946b3be1", "srcset": "https://si.imgix.net/4e1c10d0/uploads/origins/bbb86201-5c88-4dad-b8b4-8dedbcac029c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=8c8dacface8d316e0c8bd778946b3be1, https://si.imgix.net/4e1c10d0/uploads/origins/bbb86201-5c88-4dad-b8b4-8dedbcac029c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=d2721801eb1eb04889ea705e6de49612 2x, https://si.imgix.net/4e1c10d0/uploads/origins/bbb86201-5c88-4dad-b8b4-8dedbcac029c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=811262b6ee8ac067951eb6a14bea9810 3x"}, "private": true, "genre": "art", "tipped": false, "creator_id": 2844232, "nc": 144}, {"path": "/@imo_moti/works/7", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/7921cd44/uploads/origins/ef5870b3-7f45-4ce3-87ea-578582fd90f4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=