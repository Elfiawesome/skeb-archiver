ls_count": 0, "received_works": [{"path": "/@nametakechi/works/53", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 903546, "client_id": 764472, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/e924f966/uploads/origins/87aeec4e-abb5-4338-902f-b8495f13cc1b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=012e66865a5839fe558940d2bce4a90d", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/e924f966/uploads/origins/87aeec4e-abb5-4338-902f-b8495f13cc1b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b01760f6e08aa20a9dad904cfcb1b6d3", "src_set": ""}, "body": "いつもお世話になっております、こんにちは。エナガと申します。\nなめたけさんの美麗イラストでどうしても自陣を書いてもらいたい！と思いましたので、下記にてリクエストさせてください。\n\n<リクエスト内容>\nロトカヴォルテラの愛堕討ちのHO1（極道）とHO2（落語家）のキャラを描いていただきたいです。\nHO1は工藤恭一朗（くどうきょういちろう）、HO2は湾賀飛鳥（いりがあすか）と言います。\n幼馴染でうちよそを組んでまして、HO1×HO2となってます。\nロトあだ通過2周年記念のイラストを描いていただければ幸いです。\n\n◆各キャラ設定\nHO1:工藤恭一朗（くどうきょういちろう）\n一人称：俺\n相手の呼び名：飛鳥、スカシ\n\n極道の若頭。ぶっきらぼうな喋り方。口は悪いし態度も悪いが仲間思いで弱いものいじめをする奴は暴力で叩き潰す、ガキ大将がそのまま大きくなったような男。\nHO2のことが小学生の頃から好きだったものの、現在に至るまで素直になれていない。好きな子をイジメるというかちょっかいを出すというか、相手をみるとイライラするし放っておけない。告白はしたが、一度振られる。\n文句は言うもののなんだかんだで「チッ、しかたねえな…」とHO2の言うことを聞いてしまう。\nHO2の涙に激弱であり、泣かれるとオロつく。POWが9しかないので…\n最近付き合えて内心めちゃくちゃ嬉しい。\n\n─────────────────────\nHO2:湾賀飛鳥（いりがあすか）\n一人称：僕\n相手の呼び名：恭一朗くん、エトーくん、駄犬\n\n眉目秀麗な落語家。京都弁で話す。その見た目のせいで昔から性的対象に見られることも多かったものの、HO1が助けてくれたりなどで大事に至ることはなかった。むかつくやつではあるがHO1のことを正義のヒーローのように思っている。\n上記の理由から恋愛そのものを忌避してきたものの、HO2への恋愛感情を自覚後、想いを伝えたものの、過去振った経験や「恋人じゃなくて友達じゃダメなのか」と言った発言などからHO1に信じてもらえず、いつもヒス構文でキレている。\n最近ようやくHO1と付き合えたのでメンヘラ彼女のようなワガママをHO1にぶつけて甘えている。ワガママプリンセス。\n\n◆ポーズ、構図、シチュエーション指定\n→基本自由に書いてもらって大丈夫です。（おすましでポーズ取ってたりなど）以前なめたけさんに描いてもらったタバコを吸ってる恭一朗がめちゃくちゃかっこよかったのでタバコ吸ってて欲しい＆距離が近いと嬉しいな…！と思います。\n難しかったら大丈夫です！\n\n◆使用用途\n布ポスターなどに印刷して飾りたいと思います。\n相方フォロワーにプレゼントで贈れたらいいなあと思っていますが、締め切りを急かす意図はありません。\n以上の内容でリクエストをさせていただきたく存じ上げます。\n何卒よろしくお願いいたします！\n\nhttps://drive.google.com/drive/folders/1gaHflp3ZsDznh5YCmfhHJHIWHQy49-wC?usp=sharing", "nc": 152, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@nametakechi/works/52", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/1c45c6f5/uploads/origins/f9ac11f3-e4fe-4ab8-9f59-626ba62b1fc2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=643d2ec7629c4111f0f1f3b5493c320f", "src_set": ""}, "private": true, "genre": "art", "tipped": false, "creator_id": 903546, "client_id": 0, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 49, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@nametakechi/works/51", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/418c685d/uploads/origins/af4099b3-6866-4d01-87fd-4ed2e3485748?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=35752398ad8598f000550b7be10d8b09", "src_set": ""}, "private": true, "genre": "art", "tipped": true, "creator_id": 903546, "client_id": 0, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 49, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@nametakechi/works/50", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/5a817fae/uploads/origins/564cc9f5-b322-4de5-b8d8-adc84beaef3c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=8e29a878e851dfd622aa5429b825eee5", "src_set": ""}, "private": true, "genre": "art", "tip