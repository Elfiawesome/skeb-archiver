w=200&h=200&blur=200&s=394c27ceec2d56637b766aaa6f6ec0ff 2x, https://si.imgix.net/5c3bdb1c/uploads/origins/e81c3c35-88e8-4f6f-8887-514cd298cf0b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=47611f4d1568c287abea5aa5d4b0151e 3x"}, "body": "『プリティ・スターズ』のパート3をお願いします。7ページ分をお願いします。\n\nそれから9ヶ月が経った。\nエルは仕事から帰るのを待ちきれない。\nエルのおっぱいは、中に溜まりすぎた精液で疼いている。\nエルのおっぱいは以前より大きくなっている。\nこの9ヶ月間の絶え間ないセックスが、その大きさを増大させたのだ。\n\nエルが帰宅する。\n\nアルは家にいる。\nアルの両胸は、エルの子供たちを宿して非常に膨らんでいる。\nアルの胸は巨大に成長した。\nアルの乳首は、出産できるほど大きく肥大している。\n\nアルの胸が肥大しているため、アルはエルの巨大なペニスをパイズリできる。\nアルの巨大な乳房が、エルの巨大なペニスを完全に包み込む。\n\nエルはペニスをアルの中に挿入する。\n\nアルは乳首から出産する。\n生まれた二人の赤ちゃんは、エルの髪の色をした、普通の形をした人間だ。\n赤ちゃんの性別は伏せておく。", "nc": 187, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@YP8CxqH2zXYuzib/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "comic", "tipped": true, "creator_id": 3910353, "client_id": 2542893, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/cf545b7f/uploads/origins/f22a6078-e2f4-4956-bad5-aec9f25fd2c9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c7b9392fd429e2d96b901e4df08a86be", "srcset": "https://si.imgix.net/cf545b7f/uploads/origins/f22a6078-e2f4-4956-bad5-aec9f25fd2c9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c7b9392fd429e2d96b901e4df08a86be, https://si.imgix.net/cf545b7f/uploads/origins/f22a6078-e2f4-4956-bad5-aec9f25fd2c9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ef62b702b9b810fedeb1b7e303b3cb6e 2x, https://si.imgix.net/cf545b7f/uploads/origins/f22a6078-e2f4-4956-bad5-aec9f25fd2c9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=fb47e2eb30b07ec0906132e5b9247e0d 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/cf545b7f/uploads/origins/f22a6078-e2f4-4956-bad5-aec9f25fd2c9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=95a85375b2d329555564f25f1eb2df6f", "srcset": "https://si.imgix.net/cf545b7f/uploads/origins/f22a6078-e2f4-4956-bad5-aec9f25fd2c9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=95a85375b2d329555564f25f1eb2df6f, https://si.imgix.net/cf545b7f/uploads/origins/f22a6078-e2f4-4956-bad5-aec9f25fd2c9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=6e47d37beaccb65d5e4e569030eaf57e 2x, https://si.imgix.net/cf545b7f/uploads/origins/f22a6078-e2f4-4956-bad5-aec9f25fd2c9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=8c5f9ce73e07130df36235f0fbbe45a4 3x"}, "body": "リクエストお願いします！\n2009年のヒーローアクション映画「ウォッチメン」に出てくる\n「シルクスペクター」をお願いします！\n以下の要望にて、コミック形式４ページでリクストさせていただきます。\n\n＜シルクスペクター＞\n髪型は黒のロングヘア―で。イエロー＆ブラックのあのセクシーラバーぴちぴちコスチュームに身を包んだ\nつよつよ系キリッと型のヒロイン♡　ボインだよ☆\n\n＜悪のヴィラン：ダッチマン＞\nまたの名をガンメンチェアマン！顔が異様にデカくて(胴体くらいあるか)脂ぎってるキモい☆\nそのベタベタの正体は激しい痒みを発生させるヤマイモ汁で顔のありとあらゆる箇所から分泌できる\nこれを身体に塗りたくられて正気を保っていられた人はいない\n\n＜内容＞\n◇◇◇\n敵のアジト。部屋に反響する粘着液の音と女の喘ぎ声、あとは鎖の音。喘ぎ声だけが回数と音量の増減を繰り返していた。\nダッチマンは、ただ屈伸運動をしているだけ。問題はシルクスペクターとの距離。その「距離」が彼女を悶え苦しませる♡\n\nさっきからダッチマンのブサ顔が彼女のボディをヌル滑るだけで、肝心の痒みが全然取れない。\nむしろくすぐられている感覚に近く、痒みが倍加され、地獄の快楽となって襲い掛かる♡\n\n降伏勧告を幾度も突っぱねてきたシルクスペクターも、もう限界だった。\n特に、最初のうちは気付かなかった、両手に装着されたバイブローターグローブを見てからは…♡\n\n（ここは一旦降伏を受け入れるそぶりを見せて、反撃して脱出を図る。\nその汚いツラに蹴りを一発入れて借りを返してから…！）\n\n◇◇◇\n敵のアジト。部屋に反響するのは…モーター音と女の絶叫、懇願、降伏(幸福)の声♡　爆音で鳴り響いていた☆\nダッチマンはただ座っているだけ。大問題なのは、シルクスペクターがオンザフェイスであること。\n\nバイブローターグローブは巨乳を、ザラついた長いベロはマ〇コを、思いっきりいい子いい子し続けている！\nまるで痒みと快楽の無限ループで迷子になって泣きじゃくるボディをあやすが如く…♡\n\nそして時折、思い出したかのように湧く屈辱の感覚が、スパイスの様に効いてアクメをより深いものにするのであった♡\n\n＜ポイント＞\n・冒頭からシルクスペクターは捕まっていて、拘束されている(拘束姿勢はまかせます)\n・ダッチマンがスクワットで顔をこすりつけている\n・↑拘束されてスクワット責めされているヒロインの後ろからのアングル見たいです\n・耐えるヒロインは既に何度か絶頂済みで、コス越しでも乳首ピンコ立ちの乳輪くっきり\n・気持ちコスチュームのイエロー部分が透けていてもエロいかなと(NO透明)\n\n・最後はカエルをひっくり返したポーズでオンザフェイスがいいのではと(ここはまかせます)\n・同じく最後のコスチュームの着脱もまかせます(NO全裸)\n・案として、ジッパーおろされておっぱい開帳＆下はハイレグ部ずらされて秘部のみあらわとか…\n\nなんか長ったらしくなってわかりづらい内容になってしまいましたが、何卒よろしくお願いしますm(_ _\"m)", "nc": 40, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@YP8CxqH2zXYuzib/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "comic", "tipped": true, "creator_id": 3910353, "client_id": 1350408, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/ba3002a8/uploads/origins/d9b7585e-bb36-4a23-b1ce-9d97552f00ea?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=118bd0aa57ccbda8361e01c2c90da4de", "srcset": "https://si.imgix.net/ba3002a8/uploads/origins/d9b7585e-bb36-4a23-b1ce-9d97552f00ea?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=118bd0aa57ccbda8361e01c2c90da4de, https://si.imgix.net/ba3002a8/uploads/origins/d9b7585e-bb36-4a23-b1ce-9d97552f00ea?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=429a678eb910e1e041964cfad5642912 2x, https://si.imgix.net/ba3002a8/uploads/origins/d9b7585e-bb36-4a23-b1ce-9d97552f00ea?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=956769b0dd68c18201fbc4c56409b12b 3x"}, "duration": null, "nsfw": true, "hardcore": true, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/ba3002a8/uploads/origins/d9b7585e-bb36-4a23-b1ce-9d97552f00ea?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=467ce5652792f5558dd273ee428d48c6", "srcset": "https://si.imgix.net/ba3002a8/uploads/origins/d9b7585e-bb36-4a23-b1ce-9d97552f00ea?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=467ce5652792f5558dd273ee428d48c6, https://si.imgix.net/ba3002a8/uploads/origins/d9b7585e-bb36-4a23-b1ce-9d97552f00ea?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=414909d39f64f517cda5f56e8eaa8632 2x, https://si.imgix.net/ba3002a8/uploads/origins/d9b7585e-bb36-4a23-b1ce-9d97552f00ea?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=e0be5301dee07fd3f9380bc666bf8dd3 3x"}, "body": "プリティスターズ短編コミック第2部を希望。15ページ。彼らの主は、最終任務として改造に使用されたディルドチキシンとオナホルムのサンプルを入手するよう命じた。見返りに主は彼らを解放する。エルとアルは街中で自分たちを改造したイカたちを探す。イカたちが待ち伏せする。イカたちはトレンチコートとシルクハットを着用している。\nイカたちは、再び普通の人間になろうとするエルとアルを嘲笑う。ベータ・イカはエルの尻の美しさに驚嘆する。ベータ・イカはエルの乳房とペニスを覆う衣服を引き裂き、肌を露わにする。ベータ・イカは触手をエルの肛門に挿入し、ペニスを撫でる。エルのペニスは群衆に向かって精液を噴き散らす。\n \nアルファイカはアルを見つけ、触手を挿入する。アルファイカは彼女の胸と陰部を覆う衣服を引き裂き、肌を露わにする。アルの乳房から乳汁が噴出する。アルの腹部は精液で膨張する。エルとアルは強力なエクソスーツのおかげで遂に脱出に成功し、イカたちを撃破する。負傷したイカたちは、二人の体を元の状態に戻すことを提案する。\nエルとアルは現在の身体に満足しているため拒否する。時が経つ。主はサンプルを受け入れ、エルとアルを解放した。\n寝室でエルはアルにキスする。自由を得て二人は幸せだ。エルは興奮し、ペニスは普段より大きく膨張する。エルは激しくアルに挿入する。エルはそれを楽しむ。アルもまた楽しむ。エルの精液がアルの乳房を受精させる。アルのそれぞれの乳房には子宮が形成される。", "nc": 59, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@YP8CxqH2zXYuzib/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "comic", "tipped": true, "creator_id": 3910353, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/8b7a1b52/uploads/origins/43c7f43c-1201-4351-a418-55786d66bc1f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9c4d09626ba3a34ced4d726584e250d9", "srcset": "https://si.imgix.net/8b7a1b52/uploads/origins/43c7f43c-1201-4351-a418-55786d66bc1f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9c4d09626ba3a34ced4d726584e250d9, https://si.imgix.net/8b7a1b52/uploads/origins/43c7f43c-1201-4351-a418-55786d66bc1f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ad40d38da2626b056b35f44d70116a0a 2x, https://si.imgix.net/8b7a1b52/uploads/origins/43c7f43c-1201-4351-a418-55786d66bc1f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d54fd2b35c7df48f8eb2885f48bfb4b9 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/8b7a1b52/uploads/origins/43c7f43c-1201-4351-a418-55786d66bc1f?bg=%23fff&aut