lient_id": 0, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 32, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@ALRIGHT_1224/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 183524, "client_id": 1622261, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/34a89c01/uploads/origins/6bdaf643-fc9f-44fa-9bf8-c128258905f0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e7b2992bfa7f3d8f866d3ce1ac7b996c", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/34a89c01/uploads/origins/6bdaf643-fc9f-44fa-9bf8-c128258905f0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c3af318409aa9bddda336472dcc3890a", "src_set": ""}, "body": "こんにちは。千秋桜花の絵を希望します。水着を着て、航空会社の救命胴衣を着ている姿を描いてほしいです。ポーズや表情はお任せします。ありがとうございました。\n\nhttps://www.pixiv.net/en/artworks/84896757", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@ALRIGHT_1224/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 183524, "client_id": 585706, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/4d3a6dc7/uploads/origins/e354fcae-ae83-4d48-9154-e5ee21f40da8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9a434ac0ebb30a2496fc24a35b15563b", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/4d3a6dc7/uploads/origins/e354fcae-ae83-4d48-9154-e5ee21f40da8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=802f20a08ec57033f0a6a50a6b78f2d2", "src_set": ""}, "body": "どうも、はじめまして。\npixivに投稿する小説用のイラストの依頼です。\nototo氏のオリジナルヒロイン、ウルトラガール・エール（下記URL参照）が、ゼットンに首を絞められているシーンをお願いします。\ntototo氏から許可は得ています。\n\n原作同様、ゼットンがエールの体に馬乗りになり、両手で首を絞めているシチュで。\nエールは歯を食いしばり、右目は閉じ、左目でゼットンを睨みつけている表情で\n手でゼットンの両腕を掴み、外そうとしている感じでお願いします。\nアングルはゼットンの背後からでお願いします。（地面はコンクリで）\n\nどうかよろしくお願いします。\n\nhttps://www.pixiv.net/artworks/63314986", "nc": 161, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@ALRIGHT_1224/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 183524, "client_id": 0, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/95109722/uploads/origins/9ab3b7e8-44c4-4b71-9dc4-0557e0d71cce?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b889fecf7f8c6d3c97d5b769b85b76f9", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/95109722/uploads/origins/9ab3b7e8-44c4-4b71-9dc4-0557e0d71cce?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a8707e61da839dd7c6862765d6aa1df8", "src_set": ""}, "body": "初めまして。\nはーちゃんの触手責めが性癖に刺さったのでリクエストさせてください。\n\nデレマスの桃井あずきちゃんが触手に犯されている所が見たいです。\n\n口と性器に挿入されて涙を流してる状態でお願いします。", "nc": 56, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@ALRIGHT_1224/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 183524, "client_id": 63437, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/ee0ea3f6/uploads/origins/f03b0b76-c8d9-46cf-b678-4323e6cc3cc0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ad1c5e40649ed6a0cba3478e6d9654a4", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": true, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/ee0ea3f6/uploads/origins/f03b0b76-c8d9-46cf-b678-4323e6cc3cc0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b932eceaf53d5870ece3045addfe9af6", "src_set": ""}, "body": "おーらいさんこんにちは、いつもお世話になっております。　先日の触手イラストが見事に刺さったのでリクエストさせてください。\n\n「Scuderia M&H」で検索すると出てくるTrixというタイトルのとても古いパズルゲームのキャラクターである「笠原あずみ」（セーラー服着てる一人目）を触手攻めしていただきたいのです。\n\n先日のはーちゃんに近い感じで下二穴攻めに口とおっぱいはフリーで、催淫液とか無しでただ得体の知れない怪物に犯される嫌悪感１００％でお願いしたいです。　それから金額的に可能であれば「まだ元気があって泣き叫んでる状態」と「首絞めで苦しんでる状態」と「中出しレイプ目状態」で差分があると嬉しいです、無理でしたら全部乗せ一枚で。", "nc": 58, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "similar_creators": [{"id": 17253, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "ひめはち＠お仕事募集中", "screen_name": "hime8manga", "avatar_url": "https://pbs.twimg.com/profile_images/1959637692939186176/2IzPOpQ0.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1956164770383716352/1756049021/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "skills": [{"genre": "art"}], "nc": 176}, {"id": 23232, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "じょん＠強謙 No.168", "screen_name": "soratouenban104", "avatar_url": "https://pbs.twimg.com/profile_images/1787826045460357120/jN6ht1WB.jpg", "header_url": "https://pbs.twimg.com/profile_banners/65394379/1657517767/1500x500", "appeal_receivable": true, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "skills": [{"genre": "art"}, {"genre": "correction"}], "nc": 32}, {"id": 482942, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "みかみん🔞Fantia/Skeb", "screen_name": "gpmikamin", "avatar_url": "https://pbs.twimg.com/profile_images/1270673806135160832/zX_fPVWS.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1614659449/1608774882/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_re