の程どうぞよろしくお願い致します。\n\nhttps://twitter.com/atuagetofu773/status/1623560279576674304", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "similar_creators": [{"id": 11029, "creator": true, "nsfw_acceptable": false, "acceptable": false, "name": "桜庭友紀　コミケ@水曜日 南ｎ17b", "screen_name": "kyomoneko_2", "avatar_url": "https://pbs.twimg.com/profile_images/1495062227476353024/AItvk4e6.jpg", "header_url": "https://pbs.twimg.com/profile_banners/716420764795215873/1459930762/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 120, "skills": [{"genre": "art"}], "nc": 0}, {"id": 526741, "creator": true, "nsfw_acceptable": true, "acceptable": false, "name": "ジョージ", "screen_name": "GeorgGeng", "avatar_url": "https://proxy.misskeyusercontent.jp/avatar.webp?url=https%3A%2F%2Fmedia.misskeyusercontent.jp%2Fio%2Fb9a00fe6-3b5b-46b5-93d5-9349871667e2.gif&avatar=1", "header_url": "https://media.misskeyusercontent.jp/io/4a59e894-6e40-4da5-8433-f63453d549f7.png?sensitive=true", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 15, "complete_expiration_days": 90, "skills": [{"genre": "art"}], "nc": 145}, {"id": 677385, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "なぎ", "screen_name": "illust_nagi", "avatar_url": "https://pbs.twimg.com/profile_images/1289485786732089344/x4jgtGRq.jpg", "header_url": "https://pbs.twimg.com/profile_banners/970972902173556736/1766298629/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genr