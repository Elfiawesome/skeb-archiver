folders/1kVcp6B8dzGYFGpFb9spMTyDnz0TzyM7Q?usp=sharing", "nc": 8, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@nou4_777/works/12", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 659585, "client_id": 913245, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/9b599668/uploads/origins/9e8c5533-e023-4522-bc44-7a7587c8e084?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d67f227369613b9ee421dba4a103c50f", "srcset": "https://si.imgix.net/9b599668/uploads/origins/9e8c5533-e023-4522-bc44-7a7587c8e084?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d67f227369613b9ee421dba4a103c50f, https://si.imgix.net/9b599668/uploads/origins/9e8c5533-e023-4522-bc44-7a7587c8e084?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b0c5aefe963c3ff7121cef43df6dcd0e 2x, https://si.imgix.net/9b599668/uploads/origins/9e8c5533-e023-4522-bc44-7a7587c8e084?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=4cdd96a6b17c469c7ec4b7745744a277 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/9b599668/uploads/origins/9e8c5533-e023-4522-bc44-7a7587c8e084?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c157342da2f17e0be7fbb12c5cd9fa47", "srcset": "https://si.imgix.net/9b599668/uploads/origins/9e8c5533-e023-4522-bc44-7a7587c8e084?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c157342da2f17e0be7fbb12c5cd9fa47, https://si.imgix.net/9b599668/uploads/origins/9e8c5533-e023-4522-bc44-7a7587c8e084?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=8b3a11336737cdd2196de27265fbaa48 2x, https://si.imgix.net/9b599668/uploads/origins/9e8c5533-e023-4522-bc44-7a7587c8e084?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=cr