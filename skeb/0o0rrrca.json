はいたずらを起こすだけだ。\n\n実は、どの選択肢を選んで描いてもらおうか迷っているんだ......だから、もしよければ、君に任せるよ！このリクエストで描いた彼女の性格をどう解釈して、どんなポーズや表情で表現してくれるのか楽しみです。初めてのリクエストですが、よろしくお願いします。\n\nもしこのリクエストを受け入れてくださるのであれば、気長にワクワクしながら待ちたいと思います！もし受け入れていただけないなら、それでもかまいません！あなたの絵はいつも大好きです！とはいえ、私のリクエストを考慮してくださってありがとうございます！\n\nhttps://imgur.com/a/agnes-references-TBYSSzX", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "similar_creators": [{"id": 115915, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "唯ノイロ", "screen_name": "_nnwnoiros", "avatar_url": "https://pbs.twimg.com/profile_images/1821085221355450368/dCavEu4L.jpg", "header_url": "https://pbs.twimg.com/profile_banners/2594782885/1654934758/1500x500", "appeal_receivable": true, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 20, "skills": [{"genre": "art"}, {"genre": "comic"}], "nc": 48}, {"id": 482850, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "らぴす教授🍮", "screen_name": "RPS_dot", "avatar_url": "https://pbs.twimg.com/profile_images/1906831474487427073/pRU0GNWB.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1078044407188750337/1714597547/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "skills": [{"genre": "art"}], "nc": 144}, {"id": 899508, "creator": true, "nsfw_acceptable": false, "acceptable": false, "name": "よしお", "screen_name": "scomsio", "avatar_url": "https://proxy.misskeyusercontent.jp/avatar/media.misskeyusercontent.jp%2Fio%2F47994259-bcb8-424d-a8b9-bdb8dcdcf3e9.webp?avatar=1", "header_url": "https://media.misskeyusercontent.jp/io/1ea3f764-db03-4376-8bf2-61f2fc087b7b.png", "appeal_receivable": true, "popular_creator_rank": 63, "request_master_rank": null, "first_requester_rank": null, "de