ient_id": 3407901, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/0c85ad41/uploads/origins/32342e97-b308-48f7-8fad-964b66236dcf?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=31012b13ec6af790c679410e7da7787d", "srcset": "https://si.imgix.net/0c85ad41/uploads/origins/32342e97-b308-48f7-8fad-964b66236dcf?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=31012b13ec6af790c679410e7da7787d, https://si.imgix.net/0c85ad41/uploads/origins/32342e97-b308-48f7-8fad-964b66236dcf?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=502808e33fa683ad59385f275e67de39 2x, https://si.imgix.net/0c85ad41/uploads/origins/32342e97-b308-48f7-8fad-964b66236dcf?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=afad9e59285cd59aaf0ec3b1cfba5083 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/0c85ad41/uploads/origins/32342e97-b308-48f7-8fad-964b66236dcf?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=8be1310033c9cefa669c3f32ab23c17d", "srcset": "https://si.imgix.net/0c85ad41/uploads/origins/32342e97-b308-48f7-8fad-964b66236dcf?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=8be1310033c9cefa669c3f32ab23c17d, https://si.imgix.net/0c85ad41/uploads/origins/32342e97-b308-48f7-8fad-964b66236dcf?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=2bc2c058c777eddc3be1642e0d936261 2x, https://si.imgix.net/0c85ad41/uploads/origins/32342e97-b308-48f7-8fad-964b66236dcf?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=474ead864b34420f4135bdd111293147 3x"}, "body": "初めまして。個人勢Vtuberとして活動しております、酒栄のどかと申します。\nいつもいちあおぎリスナー＆うらメンとしてななしーさんのイラストを楽しみに拝見しており、この度リクエストを送らせて頂きました！\n\n以下、リクエスト詳細です。\n\n◇人物◇\n酒栄のどか（Xアカウント：　https://x.com/sakae_nodoka　）\n\n概要：うさみみリボンがトレードマークの自称14歳JC（※子持ち人妻）\n好きなもの：お酒とおいしいものと二次元\nVtuberとしての活動内容：クラフト系やMMORPGなどのゲーム実況、歌枠、お酒や食べ物のレビューなど\n\n↓三面図等の資料はこちらにまとめています\nhttps://drive.google.com/drive/folders/1HgeXgNNjbQz0awdm_AauF_PSTP5Z5wFS?usp=drive_link\n\n\n◇シチュエーション・構図など◇\n衣装は資料内の三面図や立ち絵と同じものでお願い致します。\n構図やポーズはおまかせ致しますが、下記２点のみお願いできればと思います。\n・左手が写る場合は薬指の指輪を描いて頂きたいです\n・酒好きVtuberなのですが、諸事情で禁酒中のためお酒を持ったり飲んだりしている構図はNGでお願いいたします\n\n◇使用用途◇\n・Youtubeやニコニコ動画の動画やサムネイル\n・Xの画像投稿（おはVなど）\nに使用予定です。\n仕様の際はクレジット表記をさせて頂きます。\n\n◇納品形式◇\n・人物と背景やサイン（あれば）がレイヤー分けされたPSDデータ、もしくは人物単体の透過PNGデータを別で頂けると助かります。\n\nご検討のほどよろしくお願い致します。", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@316nuiro/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3510686, "client_id": 3407901, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/d8d8d32f/uploads/origins/e588d567-48e0-4fc3-8e93-ead467be8b1e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c864feaad4293d772dd2e3cdba96073f", "srcset": "https://si.imgix.net/d8d8d32f/uploads/origins/e588d567-48e0-4fc3-8e93-ead467be8b1e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c864feaad4293d772dd2e3cdba96073f, https://si.imgix.net/d8d8d32f/uploads/origins/e588d567-48e0-4fc3-8e93-ead467be8b1e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f0b743a3c17bd869f013a8a3a3013b18 2x, https://si.imgix.net/d8d8d32f/uploads/origins/e588d567-48e0-4fc3-8e93-ead467be8b1e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f1deb834e00974260866fa57289cc55e 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/d8d8d32f/uploads/origins/e588d567-48e0-4fc3-8e93-ead467be8b1e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=48d6e69309ba118bef23f50521fe2b47", "srcset": "https://si.imgix.net/d8d8d32f/uploads/origins/e588d56