がって当然でしょう？みたいな顔をしててほしいです。\n\n 資料不足や描くのが手間等、金額が足りない等不手際がございましたらキャンセルもしくは再送依頼をしていただいても構いません。 \n\nご検討のほどよろしくお願いいたします。\n\n【衣装参考資料】\nhttps://plus.fm-p.jp/u/secret_garden1225/gallery/canvas?id=4&bid=6\n\nhttps://plus.fm-p.jp/u/secret_garden1225/gallery/canvas?id=1&bid=6", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@hangariita/works/44", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 108356, "client_id": 1376702, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/ece3239d/uploads/origins/e1d4d2e8-ffc6-409a-81e8-65027834df70?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=aaad2582263f6b9f7f15ef8653657295", "srcset": "https://si.imgix.net/ece3239d/uploads/origins/e1d4d2e8-ffc6-409a-81e8-65027834df70?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=aaad2582263f6b9f7f15ef8653657295, https://si.imgix.net/ece3239d/uploads/origins/e1d4d2e8-ffc6-409a-81e8-65027834df70?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=2fe3c8d02e14e7bf1cfa588aa153216d 2x, https://si.imgix.net/ece3239d/uploads/origins/e1d4d2e8-ffc6-409a-81e8-65027834df70?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=44517ab04a5eed96d9cce14ed50991ec 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/ece3239d/uploads/origins/e1d4d2e8-ffc6-409a-81e8-65027834df70?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d5994c93114d5d023366a3e8a1a057f4", "srcset": "https://si.imgix.net/ece3239d/uploads/origins/e1d4d2e8-ffc6-409a-81e8-65027834df70?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d5994c93114d5d023366a3e8a1a057f4, https://si.imgix.net/ece3239d/uploads/origins/e1d4d2e8-ffc6-409a-81e8-65027834df70?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fi