ore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/c86f4433/uploads/origins/6dda9ba5-4922-462e-b2e6-24573fbe147d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=bd68f8ef1289f7e08d9a84c291773e2d", "srcset": "https://si.imgix.net/c86f4433/uploads/origins/6dda9ba5-4922-462e-b2e6-24573fbe147d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=bd68f8ef1289f7e08d9a84c291773e2d, https://si.imgix.net/c86f4433/uploads/origins/6dda9ba5-4922-462e-b2e6-24573fbe147d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=e00679b62a270bbc4d1ba5c00c2fc557 2x, https://si.imgix.net/c86f4433/uploads/origins/6dda9ba5-4922-462e-b2e6-24573fbe147d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=df77a2476af8f51b0bb6285c6c6452a9 3x"}, "body": "初めまして、春の季語と申します。\n\nXで公開されているイラストを拝見し、線の柔らかな質感や雰囲気がとても素敵で、ぜひお願いしたいと思いリクエストを送らせていただきました。\n\nリクエスト内容としては、私がTRPGで使用しているOCを描いていただけたら嬉しいです。\n\n名前は「落花（らっか）」です。\n\n感情自体は豊かなのですが、表情や声には出にくく、どこかのんびりした天然気味の性格をしています。ノリは良く、写真を撮る際には無表情のままギャルピースをしてくれるような子です。\n\n性別は女の子ですが、全体的な雰囲気は中性的に描いていただけると嬉しいです。\n\n外見の特徴として、\n\n・口元の左側に大きな切り傷の痕があり、えくぼ付近まで裂けています\n・そのため普段は布で口元を隠しています\n・左目は義眼のため、ハイライトなしで描いていただけると嬉しいです\n\nポーズについては、\n\n制服の姿で、両手の人差し指で口角を持ち上げて、自分で自分を笑わせようとしているような仕草を見てみたいなと思っています……！\n\nただ、こちらはあくまで一案ですので、ややまる。様の描きやすい構図や解釈を優先していただいて全く問題ございません。\n\n使用用途については、\n\n・個人鑑賞\n・SNSアイコンやヘッダー\n・友人への共有\n・個人使用の範囲でのグッズ化\n\nなどで使用させていただく可能性があります。\n\nいずれも非商用利用の範囲を想定しております。問題等ございましたら、そちらに合わせます。\n\nご縁がありましたら、ぜひよろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/1hckoidP8G2GUgTz88cTXPUkg2uOqIouP?usp=drive_link", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@yayamarublog/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3970083, "client_id": 19323, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.n