b\u3057\u307e\u3059\u3002 \n\n \u30fb\u8a73\u7d30 \n\u3046\u3061\u306e\u3053\u304c\u4eba\u901a\u308a\u306e\u591a\u3044\u6e29\u6cc9\u8857\u3092\u3069\u3053\u306e\u6e6f\u306b\u5165\u308d\u3046\u304b\u3068\u8003\u3048\u306a\u304c\u3089\u6b69\u3044\u3066\u3044\u308b\u3002\n \u300c\u307f\u3084\u3073\u3055\u307e\u301c\u300d\u3068\u624b\u3092\u632f\u308a\u306a\u304c\u3089 \u8d70\u3063\u3066\u304f\u308b\u30a8\u30ed\u30ac\u30ad\u3002 \n\u8eab\u4f53\u3092\u5411\u3051\u305f\u77ac\u9593\u3001\u30ac\u30c3\u3068\u80f8\u5143\u306e\u5e03\u3068\u30b7\u30e7\u30fc\u30c4\u3092\u305a\u308a\u4e0b\u3052\u3089\u308c\u6027\u5668\u304c\u9732\u308f\u306b\u306a\u3063\u3066\u3057\u307e\u3044\u6d99\u76ee\u3067\u300c\u3046\u304e\u3083\u30fc\u30fc\u3063\uff01\uff01\u300d\u3068\u53eb\u3076\u3046\u3061\u306e\u3053\u3002(\u4e21\u76ee\u306f\u958b\u3044\u3066\u304f\u3060\u3055\u3044)\n\u8b1d\u308a\u306a\u304c\u3089\u30cb\u30e4\u30cb\u30e4\u3057\u3066\u308b\u30a8\u30ed\u30ac\u30ad\u3068(\u3067\u3063\u304b\u2026\u2026)\u3068\u30d2\u30bd\u30d2\u30bd\u8a71\u3059\u5468\u308a\u306e\u4eba\u2026\u2026\u3002\n  \u307f\u305f\u3044\u306a\u611f\u3058\u3067\u304a\u9858\u3044\u3057\u307e\u3059\u3002 \n\n \u4ee5\u4e0b\u30ad\u30e3\u30e9\u8a73\u7d30 \n\u30fb\u3046\u3061\u306e\u3053\u3000 \u8eab\u9577\u9ad8\u3081(169cm) \n\u57fa\u672c\u7684\u306a\u4f53\u578b\u3084\u9aea\u578b\u306f\u8cc7\u6599\u306e\u300c\u5916\u898b\u300d \u670d\u88c5\u306f\u8cc7\u6599\u306e\u300c\u670d\u88c5\u300d\u3092\u53c2\u8003\u306b\u3057\u3066\u304f\u3060\u3055\u3044\u3002\n\u5916\u898b2\u30fb3\u306f\u96f0\u56f2\u6c17\u306e\u78ba\u8a8d\u7528\u3067\u3059\u3002\n\u30b7\u30e7\u30fc\u30c4\u306e\u7d50\u3073\u76ee\u306e\u30ea\u30dc\u30f3\u306f\u306a\u3057\u3067\u304a\u9858\u3044\u3057\u307e\u3059\u3002 \n\u307f\u3063\u3061\u308a\u8a70\u307e\u3063\u305f\u304a\u6900\u65b9\u306e\u7206\u4e73(B110) \u80f4\u9577\u3081\u811a\u9577\u3081\u5c3b\u592a\u3082\u3082\u3081\u3063\u3061\u3083\u3067\u304b\u3044\u3002  \n\u540d\u524d\u306f\u307f\u3084\u3073\u3002\n\u6e29\u6cc9\u8857\u306e\u88cf\u5c71\u306b\u4f4f\u3080100\u6b73\u304f\u3089\u3044\u306e\u5996\u72d0\u3002\u5bdd\u308b\u304b\u6e29\u6cc9\u5165\u308b\u304b\u98df\u3079\u308b\u304b\u3057\u304b\u3057\u3066\u306a\u3044\u8d85\u3050\u30fc\u305f\u3089\u5a18\u3002\n\u6e29\u6cc9\u8857\u306e\u4eba\u9054\u3068\u306f\u4ef2\u826f\u304f\u983b\u7e41\u306b\u76f8\u8ac7\u76f8\u624b\u306b\u306a\u3063\u305f\u308a\u3057\u3066\u308b\u3002\n \u307b\u307c\u88f8\u307f\u305f\u3044\u306a\u683c\u597d\u306f\u3059\u3050\u6e29\u6cc9\u306b\u5165\u308c\u308b\u69d8\u306b\u8131\u304e\u3084\u3059\u304f\u3059\u308b\u305f\u3081\u3002\n\u305d\u306e\u5272\u306b\u7d50\u69cb\u4e38\u88f8\u3092\u516c\u8846\u3067\u898b\u3089\u308c\u308b\u306e\u306f\u6065\u305a\u304b\u3057\u3044\u3089\u3057\u3044\u3002\n\n \u30fb\u30a8\u30ed\u30ac\u30ad \n\u8eab\u9577\u4f4e\u3081(140cm)\n\u304a\u307e\u305b\u306a\u534a\u8896\u77ed\u30d1\u30f3\u574a\u4e3b\u982d\u3002\n\nhttps://drive.google.com/drive/folders/1-G8YMh_k9DrIzMxw6VTRfPzbfCoX7_91", "nc": 41, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@arouni22/works/4", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/c19ec9a6/uploads/origins/977d089e-4383-4685-9f89-189dc05d88fb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=fccf147a080e78f65b4bd7ca921bcdd6", "srcset": "https://si.imgix.net/c19ec9a6/uploads/origins/977d089e-4383-4685-9f89-189dc05d88fb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=fccf147a080e78f65b4bd7ca921bcdd6, https://si.imgix.net/c19ec9a6/uploads/origins/977d089e-4383-4685-9f89-189dc05d88fb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=d4fefedd4796d0f