7-ac8965d35977?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=7d2d7b04fec426eee985d4bcd77dfc47", "src_set": ""}, "body": "いつもお世話になっております！\nクラウンクロウさん(@SongKage )と合作した創作『百日後に滅ぶ村』の二次創作を描いていただきたくて、依頼に参りました！\n\n舞台はこの令和の世に、ほぼ鎖国状態だった小さな村、気ヶ身村。\n気ヶ身村には、代々生きながらにして村の神様の役割を務める、生き神様の家系、木名瀬家がありました。\n風土病と、木名瀬家を中心に村人が正気を失っていき、気ヶ身村が滅びるまでの百日間の物語です。\n\nあらすじを簡単にまとめたものを資料にまとめておきますが、本編はこちらから読むこともできます。\nhttps://www.pixiv.net/artworks/119570982\n\n斧さんに描いていただきたいのは\n\n\n夜、怖い夢を見て泣きじゃくる導。\n導を優しく撫でながら、普段の導が村の子供たちにしている、痛いの痛いの飛んでいけと同じ効能を持つおまじない\n\n『ころりん  ころりん  こんこんと\n痛みも穢みも里帰り\n帰って眠って明けたなら\n優しさひとつ  呼んでこい』\n\nを唱えてあげる荒男。\nそのおまじないが効いたのか、泣き止んで、再びすやすやと寝息をつく導。\n\n\nというシチュエーションです\n大丈夫そうでしたら、ぜひお願い致します……！\n\nhttps://drive.google.com/drive/folders/1-fu3wFUSovrJ5FyTXBK9abLlJbbbjKbv", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "similar_creators": [{"id": 474878, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "𝐆𝐮𝐮", "screen_name": "Guu8_", "avatar_url": "https://pbs.twimg.com/profile_images/1821217556155527170/6dcGyFzd.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1036553916031201280/1686243664/1500x500", "appeal_receivable": true, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "skills": [{"genre": "art"}], "nc": 161}, {"id": 1710702, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "にじいろ@用語小説化", "screen_name": "nijiirononanika", "avatar_url": "https://pbs.twimg.com/profile_images/1303645553285242880/mpRvSJ5c.jpg", "header_url": "https://pbs.twimg.com/profile_banners/2382137190/1596253411/1500x500", "appeal_receivable": true, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "skills": [{"genre": "novel"}, {"genre": "art"}, {"genre": "com