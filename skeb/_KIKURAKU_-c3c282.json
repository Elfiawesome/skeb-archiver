&w=200&h=200&blur=200&s=94ad92a7ee88ecf4b6c99c0541e1c90b 2x, https://si.imgix.net/21e94ffe/uploads/origins/16c34359-587b-4404-b2a9-ddc2b1a94fde?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=20fe6408f8f72f80d3d59f686386e146 3x"}, "body": "Mr. Kiklak, excuse me!\nI received the artwork today and I love it more than I can say 😇❤️\nIf it's okay, I'd like to invite you to draw that character again ↓\n\nhttps://www.mihuashi.com/character-card/4dc4d62d159b47a5bee79d5a6d9c872850e8ea33?utm_source=direct&utm_campaign=character_card&utm _medium=share&utm_content=ordinary\n\nThis time, we've added short hairstyles and new clothes.\nYou can still draw freely according to your own style and feeling, and please feel free to adjust and change the clothes 🤲 ❤️\n\n(If needed) Short hairstyle character change:\nMaybe an electric wave system? I've lost my sad expression and started to smile, and I'm completely immersed in my own world most of the time, and my personality has become very spontaneous!\n\nIf you don't like it, you can just cancel the request!\nI hope you'll reconsider, and please be kind!", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@_KIKURAKU_/works/11", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2594842, "client_id": 1992087, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/45afb549/uploads/origins/faf03111-8348-49bb-8676-7e6655375413?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0fc1a28b24eb8e34dbc609cb52f1a59b", "srcset": "https://si.imgix.net/45afb549/uploads/origins/faf03111-8348-49bb-8676-7e6655375413?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0fc1a28b24eb8e34dbc609cb52f1a59b, https://si.imgix.net/45afb549/uploads/origins/faf03111-8348-49bb-8676-7e6655375413?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=991203f6673f56363e1438814f6c1758 2x, https://si.imgix.net/45afb549/uploads/origins/faf03111-8348-49bb-8676-7e6655375413?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=84ef2b017f74acda437b4de93b0c04e2 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/45afb549/uploads/origins/faf03111-8348-49bb-8676-7e6655375413?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f593c65616b0b52dee47d5fa39080767", "srcset": "https://si.imgix.net/45afb549/uploads/origins/faf03111-8348-49bb-8676-7e6655375413?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f593c65616b0b52dee47d5fa39080767, https://si.imgix.net/45afb549/uploads/origins/faf03111-8348-49bb-8676-7e6655375413?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=39067a0c09e0c1c42dd3f64f642a4b45 2x, https://si.imgix.net/45afb549/uploads/origins/faf03111-8348-49bb-8676-7e6655375413?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=90eb6496efd0092a78307e672661db55 3x"}, "body": "Hello, Mr. Sensei! It's my first time meeting you, and I've always loved your work, so I'd like to commission you to draw an illustration for my own character.\nIf you can, I'd be happy to do it.\nYou can find out what he looks like here ↓ ↓ ↓\nhttps://www.mihuashi.com/character-card/4dc4d62d159b47a5bee79d5a6d9c872850e8ea33?utm_source=direct&utm_campaign=character_card&utm _medium=share&utm_content=ordinary\n\nCharacterization\n16 years old about 165cm, introverted character is not very confident, when alone like to sit on the side of the road, nothing to look at the flowers and grass and the sky to fantasize some of the plankton will feel happy!\nPlease feel free to change and adjust the costumes, and leave the composition and poses to the teacher.\n\nThank you very much for reading this, it would be great if you could consider it, and if you have the chance, please be sure to take care of me!", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@_KIKURAKU_/works/10", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/a2fbaa58/uploads/origins/d8130e4d-59c1-498c-bf5f-f19fe8c02a85?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=3569b940f32654463456bf92d7e0b24f", "srcset": "https://si.imgix.net/a2fbaa58/uploads/origins/d8130e4d-59c1-498c-bf5f-f19fe8c02a85?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=3569b940f32654463456bf92d7e0b24f, https://si.imgix.net/a2fbaa58/uploads/origins/d8130e4d-59c1-498c-bf5f-f19fe8c02a85?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=e4ffcd282590c94665ee8d9102983a7a 2x, https://si.imgix.net/a2fbaa58/uploads/origins/d8130e4d-59c1-498c-bf5f-f19fe8c02a85?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=03df9873feadf1cf30dd89b3fe88de99 3x"}, "private": true, "genre": "art", "tipped": false, "creator_id": 2594842, "nc": 1}, {"path": "/@_KIKURAKU_/works/9", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2594842, "client_id": 1215624, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/43829bdc/uploads/origins/795af014-fd2b-42c8-afbc-45c9bd2b339e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=cb5030ea9c035dcbae30bb6d55807520", "srcset": "https://si.imgix.net/43829bdc/uploads/origins/795af014-fd2b-42c8-afbc-45c9bd2b339e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=cb5030ea9c035dcbae30bb6d55807520, https://si.imgix.net/43829bdc/uploads/origins/795af014-fd2b-42c8-afbc-45c9bd2b339e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=580f120d3f63837170d0845a86f0934e 2x, https://si.imgix.net/43829bdc/uploads/origins/795af014-fd2b-42c8-afbc-45c9bd2b339e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=657d98bce5dd5191475b36c2cb015ede 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/43829bdc/uploads/origins/795af014-fd2b-42c8-afbc-45c9bd2b339e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=7e16f438e4ac22056e1ea2300f8fd170", "srcset": "https://si.imgix.net/43829bdc/uploads/origins/795af014-fd2b-42c8-afbc-45c9bd2b339e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=7e16f438e4ac22056e1ea2300f8fd170, https://si.imgix.net/43829bdc/uploads/origins/795af014-fd2b-42c8-afbc-45c9bd2b339e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=6ec30135c532576389ab0e109ec0940e 2x, https://si.imgix.net/43829bdc/uploads/origins/795af014-fd2b-42c8-afbc-45c9bd2b339e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=4e28bf8988494558bdc5409422442cc3 3x"}, "body": "How do you do?\nI saw your illustration on the social networking service and fell in love with your color composition and the way you captured the shapes.\n\nI would like to ask you to create an original character for a Cthulhu Mythos TRPG scenario called \"Noguko\" and \"Yakushi\".\n\nThe character in the red kimono is\nA man about 175 cm tall.\nA taciturn, always expressionless but sensitive child\n\nThe character wearing a white and green kimono is\na woman of 150 cm in height.\nShe is philanthropic and good at giving her own meaning to natural things. She is very expressive.\n\nYou may draw her as you like.\nIf possible, I would be very happy to see the atmosphere of blending into nature.\n\nI would like to use it for personal use as a standby for my phone or as a Twitter header.\n\nThank you in advance.\n\nhttps://drive.google.com/drive/folders/1-OUF-lC3b7BctsCI-UpiTgEIsvp5YNJ1", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@_KIKURAKU_/works/8", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/39db3abc/uploads/origins/eff4084a-82bb-45c9-ae69-b1214b213fd0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=26d31899e8acb8e771e70f7ac43007fb", "srcset": "https://si.imgix.net/39db3abc/uploads/origins/eff4084a-82bb-45c9-ae69-b1214b213fd0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=26d31899e8acb8e771e70f7ac43007fb, https://si.imgix.net/39db3abc/uploads/origins/eff4084a-82bb-45c9-ae69-b1214b213fd0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=6be9605b7826cb4fe2b029d4f8929ec4 2x, https://si.imgix.net/39db3abc/uploads/origins/eff4084a-82bb-45c9-ae69-b1214b213fd0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=d46c5dac1f1af12c04240e3eb0be1c0a 3x"}, "private": true, "genre": "art", "tipped": false, "creator_id": 2594842, "client_id": 1807424, "nc": 145}, {"path": "/@_KIKURAKU_/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2594842, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/9ff5d349/uploads/origins/6fb6d520-00e0-49f7-b69d-b75b53f7ebb9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d965040020138447948b51259e8dbef0", "srcset": "https://si.imgix.net/9ff5d349/uploads/origins/6fb6d520-00e0-49f7-b69d-b75b53f7ebb9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d965040020138447948b51259e8dbef0, https://si.imgix.net/9ff5d349/uploads/origins/6fb6d520-00e0-49f7-b69d-b75b53f7ebb9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ba4f6d4fc97643d6e4a4df38c196f9fd 2x, https://si.imgix.net/9ff5d349/uploads/origins/6fb6d520-00e0-49f7-b69d-b75b53f7ebb9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=6aa594d23e25b3d2d69cab8a3f6f3fcc 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/9ff5d349/uploads/origins/6fb6d520-00e0-49f7-b69d-b75b53f7ebb9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ab9686231d79cd6bebed6dcbb53cf9de", "srcset": "https://si.imgix.net/9ff5d349/uploads/origins/6fb6d520-00e0-49f7-b69d-b75b53f7ebb9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ab9686231d79cd6bebed6dcbb53cf9de, https://si.imgix.net/9ff5d349/uploads/origins/6fb6d520-00e0-49f7-b69d-b75b53f7ebb9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=20c8b016ceb8479a67e7899c74971303 2x, https://si.imgix.net/9ff5d349/uploads/origins/6fb6d520-00e0-49f7-b69d-b75b53f7ebb9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=a392bb4b621b476d21950702555d7ad9 3x"}, "body": "Hi Dr. Kikulak, nice to meet you!\nI first saw your work on skeb and thought it was very nice.\nI would love to work with you if it is convenient and under the right conditions.\n\nRequest details\nI would like to create a character for a TRPG game.\nI would appreciate it if you could draw an illustration of the two of us as a set with my friend's character (I have already obtained permission from my friend).\n(I have already obtained permission from my friend.) Both characters are male and tall.\nBoth characters are male and tall, but you can deform them into a style that is easy and fun for Kikulak to draw. I was very attracted to Kikuraku's drawing style, so I would be happy if you could draw them as you like.\n\nProfile]\n(*Of course, you don't have to refer to it.)\n\nSenior: A man wearing a mask.\nContrary to his appearance, he has a calm personality. He has an image of flowers scattered around him. Likes tea, embroidery, and music.\n\nJuniors: Male with chestnut hair and red eyes.\nLikes toys, animation and sweets. He has a personality that seems to believe in sexual goodness.\n\n▼ If possible.\nWe are both good friends, so we would be happy if we seem to be close.\n\nThank you in advance.\n\nhttps://drive.google.com/drive/folders/1Sk4cP_Q-r-kZgfWd35yMJT5YDTci5VRT?usp=sharing", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@_KIKURAKU_/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2594842, "client_id": 2031755, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/b1d7e281/uploads/origins/5a809329-0c9d-4503-a14c-5937f9b857f3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e1d0abbf6c4286a2155e340dc0bc5c57", "srcset": "https://si.imgix.net/b1d7e281/uploads/origins/5a809329-0c9d-4503-a14c-5937f9b857f3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e1d0abbf6c4286a2155e340dc0bc5c57, https://si.imgix.net/b1d7e281/uploads/origins/5a809329-0c9d-4503-a14c-5937f9b857f3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f55c74a0525da643582d9d05b2158a3a 2x, https://si.imgix.net/b1d7e281/uploads/origins/5a809329-0c9d-4503-a14c-5937f9b857f3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=0f0c59d33f15bde8b756d38958bb888b 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/b1d7e281/uploads/origins/5a809329-0c9d-4503-a14c-5937f9b857f3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2cda1335fbeef68ae721bd66ac8ec3d4", "srcset": "https://si.imgix.net/b1d7e281/uploads/origins/5a809329-0c9d-4503-a14c-5937f9b857f3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2cda1335fbeef68ae721bd66ac8ec3d4, https://si.imgix.net/b1d7e281/uploads/origins/5a809329-0c9d-4503-a14c-5937f9b857f3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=4f6602ac32380c40a7ed8138a06ee59d 2x, https://si.imgix.net/b1d7e281/uploads/origins/5a809329-0c9d-4503-a14c-5937f9b857f3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=a9b036c85575e477b1ba64bf477f03b4 3x"}, "body": "Hello!！I really like your art and I want to commission you to draw for him？\n\nThe man with black hair is a 26-year-old detective. He is rather stuffy and has no sense of humor. Although he looks ordinary, he may be reliable.\n（wears glasses）\nhttps://sta.sh/0kd0hm19b9f\n\nGinkgo leaves will be the right element for him\n\nThank you so much for considering me! I appreciate it so much!!", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@_KIKURAKU_/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2594842, "client_id": 2658778, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/80bf6c49/uploads/origins/457a8ea2-1c33-4607-9e60-9ebacbbe0fc9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=057750c86da5ceb6a3954f465eaa43c4", "srcset": "https://si.imgix.net/80bf6c49/uploads/origins/457a8ea2-1c33-4607-9e60-9ebac