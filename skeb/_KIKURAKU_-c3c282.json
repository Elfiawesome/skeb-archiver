": 2775008, "nc": 1}, {"path": "/@_KIKURAKU_/works/14", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2594842, "client_id": 2191796, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/54ac81d5/uploads/origins/e9c0fb5d-0112-49cd-b898-b0f40b26e27b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ccd2cf8fbe29e58591477b018507df60", "srcset": "https://si.imgix.net/54ac81d5/uploads/origins/e9c0fb5d-0112-49cd-b898-b0f40b26e27b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ccd2cf8fbe29e58591477b018507df60, https://si.imgix.net/54ac81d5/uploads/origins/e9c0fb5d-0112-49cd-b898-b0f40b26e27b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ef648a0f3c8cdf7fcab7add22df03a37 2x, https://si.imgix.net/54ac81d5/uploads/origins/e9c0fb5d-0112-49cd-b898-b0f40b26e27b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=882671d28a843c660017a1aeed6874e8 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/54ac81d5/uploads/origins/e9c0fb5d-0112-49cd-b898-b0f40b26e27b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=1cdde2251a006d9386671c37954c36d0", "srcset": "https://si.imgix.net/54ac81d5/uploads/origins/e9c0fb5d-0112-49cd-b898-b0f40b26e27b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=1cdde2251a006d9386671c37954c36d0, https://si.imgix.net/54ac81d5/uploads/origins/e9c0fb5d-0112-49cd-b898-b0f40b26e27b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=f901070a9b0feaa91faa582fa772303a 2x, https://si.imgix.net/54ac81d5/uploads/origins/e9c0fb5d-0112-49cd-b898-b0f40b26e27b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=f4609d62efbebc32a68bb618f1e8ad15 3x"}, "body": "Hello! I love your style, and was wondering if you would be willing to draw my ghost girl character. \nー\n◦While she lived, she was a woman who reached the depths of spatial and temporal magics with her studies. However, her studies led her to knowledge no one should know. As a result, she lost her life. Her spirit was eventually resurrected by a druid, though her memory of her life was fractured. She now usually spends her days holed up in her manor's library, piecing her research back together, or lounging around drinking tea.\n◦Even as a spirit, she experiences any range of expressions, though typically mild.\n◦Motifs associated with her are locked doors, keys, books, sunflowers, and the concept of time (clockwork, hourglasses, etc.). \nー\nYou're free to compose the image as you'd like, if that is okay. Thank you for your consideration!\n\nhttps://drive.google.com/drive/folders/1v-gpPEfU53gvMw7CBf5rbd_ojSfStgZd?usp=sharing", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@_KIKURAKU_/works/13", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/328d6bdb/uploads/origins/e3d5fb4e-f0a3-415e-804c-60b4d8c5c3f8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=af357f48c5aedc9f52fd9750eb315ba3", "srcset": "https://si.imgix.net/328d6bdb/uploads/origins/e3d5fb4e-f0a3-415e-804c-60b4d8c5c3f8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=af357f48c5aedc9f52fd9750eb315ba3, https://si.imgix.net/328d6bdb/uploads/origins/e3d5fb4e-f0a3-415e-804c-60b4d8c5c3f8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=dc048dc4fb47fc1ec561ea03fd985bee 2x, https://si.imgix.net/328d6bdb/uploads/origins/e3d5fb4e-f0a3-