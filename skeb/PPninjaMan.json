て添付させていただきますので、ご確認いただければと思います。\nよろしくお願い致します。\n\nhttps://x.com/rqxh083kgd88166/status/1940703803327893749?s=46&t=QinhcmyPe7Mw2j8aU6E-KQ", "nc": 161, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@PPninjaMan/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3676082, "client_id": 0, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/37401543/uploads/origins/30b97f72-bc9b-461a-9084-a761984716d5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8336a8efb7e03ec7ba3a2eb97eb94e44", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/37401543/uploads/origins/30b97f72-bc9b-461a-9084-a761984716d5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=13b84d81c2cca4963c6d8f49fd7a44e2", "src_set": ""}, "body": "こんにちは！ポケモンサン＆ムーンのルサミンとエリオのイラストをお願いしたいです。  \n\nシナリオとしては、ルザミーネがエリオを捕獲して、エーテル研究所でガッチリ拘束してほしいです。  ルサミーネが大きな体でエリオに馬乗りになり、太ももでエリオを挟み込み、徹底的に支配してエリオを服従させる。\n\nその他、背景、台詞、場面転換などの解釈は大歓迎です。\n\nhttps://www.dropbox.com/scl/fo/uau30vuwfy4a4s2lwyoqk/AKhg2wi9bZ64-0lfXZj3dHQ?rlkey=p6yy721xyv5tm2q0lwvn4tyls&st=ys3nb0m9&dl=0", "nc": 185, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@PPninjaMan/works/6", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/94020c8f/uploads/origins/f86aae06-350f-4f3d-b729-d935ad337465?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=2b368c08ac2f2b8e77d4ecb6cd53202f", "src_set": ""}, "private": true, "genre": "art", "tipped": false, "creator_id": 3676082, "client_id": 643001, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 177, "word_coun