-4757-a463-964c64acaa9a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0f878fe3a061da9e1f89559dc4a5ac4a", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/34b4f397/uploads/origins/5310ff61-32f5-4757-a463-964c64acaa9a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=1fac9c00dd16968d47a63d056f5a9e77", "src_set": ""}, "body": "いつも素敵なイラストを拝見させていただいています。\n\nアイドルマスターシリーズから萩原雪歩・緒方智絵里・幽谷霧子・葛城リーリヤ・レトラの5人のイラストをお願いします。\n衣装は私服ではなく、アイドルのライブ衣装でお願いします。\n雪歩：[星降る聖夜]の衣装\n智絵里：[白詰草縁起]の衣装\n霧子：[縷・縷・屡・来]の衣装\nリーリヤ：[極光]の衣装\nレトラ：[Breaker]の衣装\nポーズはお任せしますが、笑顔で和気あいあいとした雰囲気だと嬉しいです。\nまた、名刺サイズに縮小しても5人とも同じくらいの大きさで描かれるような構図でお願いします。（タテ・ヨコはどちらでも構いません）\n全身が入っている必要はありません。\nイラストをP名刺に使用する目的で、多少の加工やトリミングを加えることをご承知おきください。\n\nよろしくお願いします。", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@mercenary_p/works/8", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 156721, "client_id": 137094, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/b98f196b/uploads/origins/00e1e7f6-8384-43ed-948d-18eeb86c75b0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7cb2329cdc634481c24e4fc6fbfaeca2", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/b98f196b/uploads/origins/00e1e7f6-8384-43ed-948d-18eeb86c75b0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3fcd9d6570594df27e8ef925abbe47e7", "src_set": ""}, "body": "リクエスト再開との事で、前回のリクエストを再送させて頂きます。\n前回はとても素晴らしいありふみをありがとうございました！\n今回もありふみでのリクエストをさせて頂きます。\nシチュエーション\nシンデレラガールズ26話より劇中劇のシン選組ガールズにてしがみ付く文香さんを庇うように刀をプルプル震えながら構えるありすがあるのですが、if的な感じでカッコよくありすを守る文香さんをお願い出来ませんか？\n\n膝立ちの半身になってありすを庇うように抱きしめながら刀を構える文香さんと言った感じで、文香さんは出来るだけ眼光鋭く凛々しく描いてほしいです。ありすは逆に守られるヒロインといった感じでお願いしたいです。\nまた可能であれば文香さんはポニーテールだと嬉しいです。(趣味です)\n\n以上となります。\n問題が無ければよろしくお願いします。", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@mercenary_p/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 156721, "client_id": 137094, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/b35a49a4/uploads/origins/c3bf628f-1304-4724-8b69-5b58f217d586?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2a4b7bb2a250804b8fd29c01578016cb", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/b35a49a4/uploads/origins/c3bf628f-1304-4724-8b69-5b58f217d586?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2ded98ab4577d6ad16a9c949bf0b890e", "src_set": ""}, "body": "はじめまして。\nリクエストさせて頂きます。\n\nキャラクター\n橘ありすと鷺沢文香\n\nシチュエーション\nありすをお姫様抱っこする文香さん。\nありすは顔真っ赤で緊張、文香さんは柔らかく微笑んでいる感じでお願いしたいです。\n\n服装\nありす　はじめての表情　特訓前\n文香さん　一瞬の誘惑　特訓前\n普段着でも構いません。\n\n以上となります。\nご一考頂けますと幸いです。\nよろしくお願いします。", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@mercenary_p/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 156721, "client_id": 817539, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/f3341093/uploads/origins/46db33c9-3b31-49f1-913a-5414ba8c3844?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4281d1a6e1726fd7e051ea6d5c0d008c", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/f3341093/uploads/origins/46db33c9-3b31-49f1-913a-5414ba8c3844?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2cb7139f2c5b536f4835ca02ea1b44ee", "src_set": ""}, "body": "アイドルマスターシンデレラガールズの「吉岡沙紀さん」のイラストをお願いします。\n◆乙女な雰囲気の沙紀さんをお願いします。\n（以前庸兵さんが描いてらっ