。   \n\nお忙しいところ恐れ入りますが、 どうぞよろしくお願い致します。\n\nhttps://drive.google.com/drive/folders/13g9Rp8qvVTUY1j7k_lUKdUGtMnCmna9Y?usp=sharing", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@______n___7/works/13", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3821672, "client_id": 1713283, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/506fd10a/uploads/origins/3032e11b-21a9-4ee6-a30f-af60a9f8d4d8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c63457d98cc1324b0a13fd6062dc27ec", "srcset": "https://si.imgix.net/506fd10a/uploads/origins/3032e11b-21a9-4ee6-a30f-af60a9f8d4d8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c63457d98cc1324b0a13fd6062dc27ec, https://si.imgix.net/506fd10a/uploads/origins/3032e11b-21a9-4ee6-a30f-af60a9f8d4d8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=6631d1fdc29deffc68c39e1e1b3cf413 2x, https://si.imgix.net/506fd10a/uploads/origins/3032e11b-21a9-4ee6-a30f-af60a9f8d4d8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=782b8b8ac530167e0d4452a24550f30b 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/506fd10a/uploads/origins/3032e11b-21a9-4ee6-a30f-af60a9f8d4d8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3fcb2465eeb909f9cc8c232ada36340a", "srcset": "https://si.imgix.net/506fd10a/uploads/origins/3032e11b-21a9-4ee6-a30f-af60a9f8d4d8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3fcb2465eeb909f9cc8c232ada36340a, https://si.imgix.net/506fd10a/uploads/origins/3032e11b-21a9-4ee6-a30f-af60a9f8d4d8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=09fac92bd3e5041019c30877209bfeff 2x, https://si.imgix.net/506fd10a/uploads/origins/3032e11b-21a9-4ee6-a30f-af60a9f8d4d8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=3274a6a14891539b64f1d5d349e1a9c2 3x"}, "body": "初めまして、もれもれ様の美しくかっこいいイラストに一目惚れしましてぜひ私のOCをお願いしたいです！\n\nもし宜しければ私のOCのシラヌイさんを描いて頂けないでしょうか？\n\nシラヌイさんは黒に近い紫のポニーテールの長髪に赤と青のオッドアイの瞳（赤い瞳に特殊な紋様）、黒いマスクに、赤いネクタイ（金色の模様）に黒いコート状の服を着ている男性です。\n一人称は私で、口調は「〜だ」「〜だな」といった感じで外見年齢は20代後半です。実際は1000年以上生きており人の姿をしてますが人ではない異種族です。\n無表情で感情を表に出すことがほとんどない強者ですが一緒にいるミカド君には心を許しています。\n\nhttps://drive.google.com/drive/folders/1M4Yd2lBK6RoEVqsX_eUdQSuPi6265Wkp\n\nポーズや構図などはお任せしますので自由に描いて頂けましたら幸いです！\n\nもれもれ様の美しく素敵な絵柄で我が最推しOCであるシラヌイさんを見てみたく思います！\n\nお忙しい中だと思いますのでご都合の良い時にご確認頂ければ幸いです！💦\n\nこちらの内容で良ければご検討の程よろしくお願いいたします。", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@______n___7/works/12", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3821672, "client_id": 2818893, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/4c21ad13/uploads/origins/f4644dc8-30a5-437a-a129-28f811a696f5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=205d224f96cbe37d2b6f9c81f5cb3ef9", "srcset": "https://si.imgix.net/4c21ad13/uploads/origins/f4644dc8-30a5-437a-a129-28f811a696f5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=205d224f96cbe37d2b6f9c81f5cb3ef9, https://si.imgix.net/4c21ad13/uploads/origins/f4644dc8-30a5-437a-a129-28f811a696f5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=1293d053b9d124d01079e3b8856e7091 2x, https://si.imgix.net/4c21ad13/uploads/origins/f4644dc8-30a5-437a-a129-28f811a696f5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=69c3933f42147796306f9c1dc16d4718 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/4c21ad13/uploads/origins/f4644dc8-30a5-437a-a129-28f811a696f5?bg=%23fff&auto=format%2Ccomp