/397f9b59-9615-490d-9ad3-af692b6c5aba?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=28006bac0449a4da359fbf996998eb1c, https://si.imgix.net/dc51edce/uploads/origins/397f9b59-9615-490d-9ad3-af692b6c5aba?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=16c723bbd0677236f89c0e885d601850 2x, https://si.imgix.net/dc51edce/uploads/origins/397f9b59-9615-490d-9ad3-af692b6c5aba?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=060a8e888c159d0df10723035b8fcdef 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/dc51edce/uploads/origins/397f9b59-9615-490d-9ad3-af692b6c5aba?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=99abc86f4d758da96ccd6e633acfe335", "srcset": "https://si.imgix.net/dc51edce/uploads/origins/397f9b59-9615-490d-9ad3-af692b6c5aba?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=99abc86f4d758da96ccd6e633acfe335, https://si.imgix.net/dc51edce/uploads/origins/397f9b59-9615-490d-9ad3-af692b6c5aba?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=5a5344bf8cd06c132441cf5e2e76d3f3 2x, https://si.imgix.net/dc51edce/uploads/origins/397f9b59-9615-490d-9ad3-af692b6c5aba?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=42eebe1af18a230cc01b127e7060e127 3x"}, "body": "リクエストを再開されたようですので、またお願いいたします。\nPixivのブリジットの作品をみました。ギルティギアのキャラクターで依頼をしてみようかと思いましたので、制作の検討をお願いします。内容としては、「着ぐるみを無理やり着せられる」、「エッチな目にあいながら、中の人がしないようなことを無理やりさせられる」ですね。\n\nシチュレーション\n「カイ、ジャック・オーの衣装と着ぐるみの強制装着」\n・生真面目な性格であるギルティギアのカイ＝キスク、敵対者に罠にかけられ、カイとは対照的なジャックの着ぐるみを無理やり着させられる。\n・着ぐるみの内容は、ジャックらしい豊満な肌タイツと衣装、性感帯を責める機械、ジャックの着ぐるみマスクとジャックが普段被っているような仮面。つまりジャックの着ぐるみマスクの上から、さらに仮面を被せられている。\n・ジャックのお尻を突き出すようなポーズをさせられながら、性感帯を責められている。二重の仮面のせいで、内部では大変なことになっているが、うめき声しかあげられない。\n・敵対者に嘲られながら、誘うように尻を突き出している。\n\n以上になります。検討をお願いします。\n\nキャラクター資料\nジャック・オー　\nhttps://www.ggxrd.com/rev/ac/character/jack.html\nhttps://automaton-media.com/articles/newsjp/20210827-173836/\nカイ＝キスク\nhttps://www.ggxrd.com/rev/ac/character/ky.html", "nc": 41, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@self_soilwork2/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2539538, "client_id": 139886, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/720f6941/uploads/origins/46535ec5-3d55-4422-93a3-bead17ba8e0d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2347bf47e58411fdd7b251ec16263019", "srcset": "https://si.imgix.net/720f6941/uploads/origins/46535ec5-3d55-4422-93a3-bead17ba8e0d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2347bf47e58411fdd7b251ec16263019, https://si.imgix.net/720f6941/uploads/origins/46535ec5-3d55-4422-93a3-bead17ba8e0d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=90bf91e6017f18837bd63f04157e8083 2x, https://si.imgix.net/720f6941/uploads/origins/46535ec5-3d55-4422-93a3-bead17ba8e0d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a3543b059dc1eea116307b18f7536015 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/720f6941/uploads/origins/46535ec5-3d55-4422-93a3-bead17ba8e0d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=885262de10abf860b5a618cbc6d3468e", "srcset": "https://si.imgix.net/720f6941/uploads/origins/46535ec5-3d55-4422-93a3-bead17ba8e0d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=885262de10abf860b5a618cbc6d3468e, https://si.imgix.net/720f6941/uploads/origins/46535ec5-3d55-4422-93a3-bead17ba8e0d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=ec4719f42128bba3bc902bc7d535ddb9 2x, https://si.imgix.net/720f6941/uploads/origins/46535ec5-3d55-4422-93a3-bead17ba8e0d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=c60d2f7b45df480bfc7ba57553914972 3x"}, "body": "こんにちは、きぐるみの絵を楽しませてもらっています！私のOCのような赤いラバースーツとキグルミマスクをつけたフェムボーイのイラストをお願いしたいのですが、https://imgur.com/a/RS6TdBG。\n\nフェムボーイは、茶色の巻き毛の短髪で、青い目をしています。ラバースーツとキグルミマスクを着て興奮しています。\n\nスーツには少年のペニスを覆うカバーがあり（参考文献：https://skeb.jp/@Relet2016/works/23, https://www.pixiv.net/en/artworks/105443925）、少年がそれを撫でて気持ちよさそうにしているはずです。また、スーツには胸があるはずですが、小さめか中くらいの大きさにしてください。また、多くの写真でやっているように、マスクをつける前にオープンフェイスフードとボールギャグをつけているところを映してください。\n\n私の要望が分かりにくくなっていなければいいのですが、読んでいただきありがとうございます！", "nc": 49, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@self_soilwork2/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2539538, "client_id": 348204, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/f2e42576/uploads/origins/e82c0ac1-4ca1-4beb-b0c0-640180a3951e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=180691ea1fa908cd6600bc0f443bd602", "srcset": "https://si.imgix.net/f2e42576/uploads/origins/e82c0ac1-4ca1-4beb-b0c0-640180a3951e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=180691ea1fa908cd6600bc0f443bd602, https://si.imgix.net/f2e42576/uploads/origins/e82c0ac1-4ca1-4beb-b0c0-640180a3951e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=1dd474183fb145c15245d001236d9709 2x, https://si.imgix.net/f2e42576/uploads/origins/e82c0ac1-4ca1-4beb-b0c0-640180a3951e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ab8b825fc953780afff439c77e68dc85 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/f2e42576/uploads/origins/e82c0ac1-4ca1-4beb-b0c0-640180a3951e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=24a76c4ba78426b08de31bb1202cd9b8", "srcset": "https://si.imgix.net/f2e42576/uploads/origins/e82c0ac1-4ca1-4beb-b0c0-640180a3951e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=24a76c4ba78426b08de31bb1202cd9b8, https://si.imgix.net/f2e42576/uploads/origins/e82c0ac1-4ca1-4beb-b0c0-640180a3951e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=757fee5b99c08d087ed538be7fba6fd9 2x, https://si.imgix.net/f2e42576/uploads/origins/e82c0ac1-4ca1-4beb-b0c0-640180a3951e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=c00318177404b0e15deb60adc7546973 3x"}, "body": "うちの狐鈴を描いて欲しいです。\n\n・シチュエーション\nTwitterやPixivなどでよく書かれているような着ぐる絵をお願いいたします。\nメインの着ぐるみさんのイラストのバックに色々エッチなことをされている中の人を描いたイラストをお願いしたいと考えています。\n\n↓大まかな希望\n【イベント中で周りに愛想振りまいて可愛いモーションしているが、携帯アプリで着ぐるみの中のアイテムを操作され続け感じてしまっているのを、周囲にバレないように頑張っている狐鈴】\n↓詳細\n・中の人はキャラクター本人(女性)\n・黒の全身ラバースーツを着用していて、股間や胸には玩具がセットされていてセットされていて気持ちよくされている\n・口にはボールギャグを嚙まされている\n・上記の上から肌色のラバースーツか肌タイを着せる(器具などは見えなくなる)\n・着ぐるみのマスクと衣装を着る\n・そのため見た目は普通の着ぐるみさんなのに、中ではすごい責められていて、呼吸も制限されている\nこんな感じの方向性のシチュエーションが希望です\n\n【狐鈴資料】\n狐耳先：茶　狐尻尾先：白　読み：狐鈴（こすず）\nキャラ判別のためにも鈴と花の髪飾りはつけて欲しいです。\nhttps://twitter.com/sinon77/status/1538539620316893184\n\nhttps://twitter.com/sinon77/status/1538539620316893184", "nc": 49, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@self_soilwork2/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2539538, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/411bca8e/uploads/origins/ecb65215-0d90-4633-b826-76da3cc9d056?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=99a75c15ca69ad18be2332558c872c0d", "srcset": "https://si.imgix.net/411bca8e/uploads/origins/ecb65215-0d90-4633-b826-76da3cc9d056?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=99a75c15ca69ad18be2332558c872c0d, https://si.imgix.net/411bca8e/uploads/origins/ecb65215-0d90-4633-b826-76da3cc9d056?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=5be2b305eadd0dfd4c7cc725cbb294e8 2x, https://si.imgix.net/411bca8e/uploads/origins/ecb65215-0d90-4633-b826-76da3cc9d056?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c66c3c69b3dcf8e38c760bc82fb5dfc9 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/411bca8e/uploads/origins/ecb65215-0d90-4633-b826-76da3cc9d056?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=86fe9d12aec3455accac944b0da490d4", "srcset": "https://si.imgix.net/411bca8e/uploads/origins/ecb65215-0d90-4633-b826-76da3cc9d056?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=86fe9d12aec3455accac944b0da490d4, https://si.imgix.net/411bca8e/uploads/origins/ecb65215-0d90-4633-b826-76da3cc9d056?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=83d512e4509629990f374b8f00658171 2x, https://si.imgix.net/411bca8e/uploads/origins/ecb65215-0d90-4633-b826-76da3cc9d056?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=912b411b526ae89bedaa4fa8349fc3e8 3x"}, "body": "はじめまして！\n以前よりTwitterやpixivにて作品を見させていただいております！\nリクエストを募集していましたので送らせていただきます。\n\n黒髪茶色目の青年がけもフレのギンギツネの着ぐるみを着せられ、アナル尻尾と一物にローターを付けられた状態で拘束されて放置プレイをされており、スカートは拘束に使われているロープで一緒にめくりあげた状態で固定されており、入れられたアナル尻尾も立ち上がった一物も隠すことができない、という感じでお願い致します。\n\n以上、よろしくお願い致します。\n\n参考\nギンギツネ(けもフレ)：\nhttps://dic.pixiv.net/a/%E3%82%AE%E3%83%B3%E3%82%AE%E3%83%84%E3%83%8D%28%E3%81%91%E3%82%82%E3%81%AE%E3%83%95%E3%83%AC%E3%83%B3%E3%82%BA%29", "nc": 168, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@self_soilwork2/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2539538, "client_id": 22757, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/23c4f1fe/uploads/origins/c87b3ef0-30cc-4f03-a43c-04756ba0cfa7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b8f28d451ba89c39c59d2aff94606515", "srcset": "https://si.imgix.net/23c4f1fe/uploads/origins/c87b3ef0-30cc-4f03-a43c-04756ba0cfa7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b8f28d451ba89c39c59d2aff94606515, https://si.imgix.net/23c4f1fe/uploads/origins/c87b3ef0-30cc-4f03-a43c-04756ba0cfa7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=cfb1b4f1cad724de72de82012868920c 2x, https://si.imgix.net/23c4f1fe/uploads/origins/c87b3ef0-30cc-4f03-a43c-04756ba0cfa7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a9973e7cd1e09bc7add4e2a8d59e69f2 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/23c4f1fe/uploads/origins/c87b3ef0-30cc-4f03-a43c-04756ba0cfa7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=84559495712dfccf0774b7d679c758d0", "srcset": "https://si.imgix.net/23c4f1fe/uploads/origins/c87b3ef0-30cc-4f03-a43c-04756ba0cfa7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=84559495712dfccf0774b7d679c758d0, https://si.imgix.net/23c4f1fe/uploads/origins/c87b3ef0-30cc-4f03-a43c-04756ba0cfa7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=74189233164f3b7917ee616fe2a8ab80 2x, https://si.imgix.net/23c4f1fe/uploads/origins/c87b3ef0-30cc-4f03-a43c-04756ba0cfa7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=8062479f8bc2262604ce6795497e5d8a 3x"}, "body": "お世話になります。\nskeb開設ありがとうございます。\n以前よりTwitterを拝見させていただいており、リクエストさせていただきました。\n\n可能でしたらリクエストを受けていただければと思います。\n以上、よろしくお願いします。\n\n・リクエスト内容\nサモンナイト3 　アティ先生　水着衣装\n参考資料\nhttps://twitter.com/raise_raw/status/1610969360457146368\nhttps://twitter.com/raise_raw/status/1610976910028292099\n\n・シチュエーション\nTwitterやPixivなどでよく書かれているような着ぐる絵をお願いいたします。\nメインの着ぐるみさんのイラストのバックに色々エッチなことをされている中の人を描いたイラストをお願いしたいと考えています。\n可能であれば、メインの絵と中身の絵は分けられる(PSDファイルにしてレイヤー化されているなど)していただけると助かります。\n\n1.メイン\n海岸でロケ撮影をしているシチュエーションで、砂浜の上で暑い中、フーフー言いながら撮影をしている。\nポージングはお任せしますが、水着グラビアのようなノリノリのポーズでお願いします。\n2.中身のイメージ\nよくしいたけさんが書かれているイラストにあるように、上記のバックに中の人のイメージを書いていただきたいです。\nどのカットを入れるのかはお任せしたいのですが、以下のような構造をいつも妄想しています。\n・中の人はキャラクター本人(女性)\n・顔まで覆う黒の全身ラバースーツを着用する\n・股間には何か器具が挿入されていて気持ちよくされている\n・口にはギャグが挿入されているのとチューブが股間まで伸びていてそこから出ないと呼吸できなくされている\n・上記の上から肌色のラバースーツを着せる(器具などは見えなくなる)\n・着ぐるみのマスクと水着を着る\n・見た目はテカテカした水着の着ぐるみさんなのに、中ではすごい責められていて、呼吸も制限されている\n・本人はそうなっているのをばれないように頑張っている\n\n以上、よろしくお願いします。", "nc": 32, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@self_soilwork2/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2539538, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/5906f966/uploads/origins/4c0c5401-645f-4da2-9ec8-7df86e8fe22b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=db8ef4f73fe288ec929f7dadec49e4f7", "srcset": "https://si.imgix.net/5906f966/uploads/origins/4c0c5401-645f-4da2-9ec8-7df86e8fe22b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=db8ef4f73fe288ec929f7dadec49e4f7, https://si.imgix.net/5906f966/uploads/origins/4c0c5401-645f-4da2-9ec8-7df86e8fe22b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=42bd1abe887d92ff510f129625175d35 2x, https://si.imgix.net/5906f966/uploads/origins/4c0c5401-645f-4da2-9ec8-7df86e8fe22b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=45f76f960885d8be11bc4c8836829479 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/5906f966/uploads/origins/4c0c5401-645f-4da2-9ec8-7df86e8fe22b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c7592c4dd04ce93389dfd629586d0c4b", "srcset": "https://si.imgix.net/5906f966/uploads/origins/4c0c5401-645f-4da2-9ec8-7df86e8fe22b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c7592c4dd04ce93389dfd629586d0c4b, https://si.imgix.net/5906f966/uploads/origins/4c0c5401-645f-4da2-9ec8-7df86e8fe22b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=60b7ae9e2b2e1551056466760c1a154b 2x, https://si.imgix.net/5906f966/uploads/origins/4c0c5401-645f-4da2-9ec8-7df86e8fe22b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=f09dbaa15ee60c324986983b136bb96a 3x"}, "body": "はじめまして、しいたけさんの作品、Twitterやpixivでいつも拝見しています。\nスケブを始められたようですので、リクエストをお願いさせて頂こうかと思い、連絡をしました！\n\nシチュエーション\n「ナイチンゲールのトリック・オア・トリートメントの着ぐるみを、イケメンの青年が無理やり着させられる。脱ごうと藻掻いていると、性感帯をローターで責められて悶絶している。」\nナイチンゲールの\nトリック・オア・トリートメント（　https://www.pixiv.net/artworks/65614011　）\n\nしいたけさんの作品で以前みかけた、脱げなくされた玉藻の前の作品が好きでした。\n（　https://www.pixiv.net/artworks/94572612　）\nナイチンゲールのドスケベ礼装が好きでしたので、イケメンな青年がむちむちのスタイルの良い着ぐるみ姿に変えられて、くぐもった声を出しながら悶絶している姿が見てみたいと思いました。\n製作のご検討をお願いします！", "nc": 56, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 397048, "creator": true, "nsfw_acceptable": true, "acceptable": false, "name": "ゴミクズXX", "screen_name": "gorirakasutera", "avatar_url": "https://pbs.twimg.com/profile_images/1999111543884255232/Jdi4OFbQ.jpg", "header_url": "https://pbs.twimg.com/profile_banners/3835409600/1765709943/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "art"}], "nc": 49}, {"id": 740189, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "たれ", "screen_name": "tarenagas