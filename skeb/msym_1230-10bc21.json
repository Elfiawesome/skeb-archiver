&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=0939a67ab30784b55eb7ca22a28b1f1e 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/7f4e64d5/uploads/origins/73e89db1-2c40-4a45-9fc6-4171d6c90adb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c6683493424a82d83c84f606f20d06f9", "srcset": "https://si.imgix.net/7f4e64d5/uploads/origins/73e89db1-2c40-4a45-9fc6-4171d6c90adb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c6683493424a82d83c84f606f20d06f9, https://si.imgix.net/7f4e64d5/uploads/origins/73e89db1-2c40-4a45-9fc6-4171d6c90adb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=334746ea38b9378142b4844668b06069 2x, https://si.imgix.net/7f4e64d5/uploads/origins/73e89db1-2c40-4a45-9fc6-4171d6c90adb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=0c72a2b09cb4b768eb5478485801faa9 3x"}, "body": "初めまして。\nまさゆみさんの創作作品と、躍動感とストーリー性のある絵柄がとても大好きです。\nTRPGのうちよそキャラクターをまさゆみさんの絵柄で見てみたいと思い、ご依頼させて頂きました。\n片方は別の方のキャラクターですが、許可は頂いています。\n\n使用目的は主に個人の観賞用、PCの壁紙など個人使用です。\nTwitterなどのアイコンにする予定は今の所ないですが、使用の場合はまさゆみさんが描かれたという旨をプロフに記載します。\n\n資料はURLのDropboxにまとめてあります。\n中に詳細をまとめたテキストもあるのでご参考にしてください。\n筆の向くままにお任せしますが、PCの壁紙もしくはスマホの壁紙使用を検討しているため、\n縦長か横長サイズのイラストですと嬉しいです。\nhttps://www.dropbox.com/sh/o0h0tt8xfpo7xn0/AAAoffgjwbmu86pcvNivtQOba?dl=0\n\n簡単ではありますが、ご検討のほど宜しくお願い致します。", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@msym_1230/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1628332, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/f88f8008/uploads/origins/a3b19944-9ee9-4530-aeaa-452f0d679004?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0eb5e05c579ca54bae21674b7ae58223", "srcset": "https://si.imgix.net/f88f8008/uploads/origins/a3b19944-9ee9-4530-aeaa-452f0d679004?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0eb5e05c579ca54bae21674b7ae58223, https://si.imgix.net/f88f8008/uploads/origins/a3b19944-9ee9-4530-aeaa-452f0d679004?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=5dee81d7790de0af477958d4833a6714 2x, https://si.imgix.net/f88f8008/uploads/origins/a3b19944-9ee9-4530-aeaa-452f0d679004?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d7025c52efac35f18e580ccd92e764bf 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/f88f8008/uploads/origins/a3b19944-9ee9-4530-aeaa-452f0d679004?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=cf05599c0ab74ab442a561e95ae327b2", "srcset": "https://si.imgix.net/f88f8008/uploads/origins/a3b19944-9ee9-4530-aeaa-452f0d679004?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=cf05599c0ab74ab442a561e95ae327b2, https://si.imgix.net/f88f8008/uploads/origins/a3b19944-9ee9-4530-aeaa-452f0d679004?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=df6517938f36f865df054cb46eb26afb 2x, https://si.imgix.net/f88f8008/uploads/origins/a3b19944-9ee9-4530-aeaa-452f0d679004?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=e77f964e9b0d8769d6b5e3a12d6b183c 3x"}, "body": "はじめまして。\n以前PBWでイラストを拝見して以来、まさゆみ様のイラストが本当に大好きです！\nまたいつか描いていただけたら……と思っていたところに募集の告知を見て楽しみにしておりました。\n御検討の程、どうぞよろしくお願いいたします\n\n＊＊＊\n\n◆概要\n非商用（TRPG）で使用予定の創作キャラの立ち絵をお願いします。\n\n◇差分候補\n可能でしたら、以下の中から表情差分をお願いしたいです\n（差分の有無・数も含め全てお任せ致します）\n・訝しげな顔\n・不敵に嗤った顔\n・目を伏せた顔\n・苛々顔\n\n◆特徴\n・男\n・34歳、公安の外事課所属の刑事\n・SIZ12、身長172cm。細マッチョ寄り。着痩せするタイプ。\n・APP7（目付きの悪さと首元の傷によるもの）\n・髪は短めの焦げ茶色\n・瞳は焦げ茶色、目付き悪めの三白眼\n・黒スーツ、黒ネクタイ。服装は地味な印象だがスーツの着こなしはラフ寄り。\n・表情の変化に乏しく、あまり人相が良くない\n・首の左側に大きな刃物傷（シャツでも隠れない程度）\n・近接格闘術に長けており、捕縛より鎮圧が得意\n・潜入捜査に必要な為、以外と知識は豊富で語学にも長けている\n\n※他、細部のデザインや不明点は全てお任せします！", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@msym_1230/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1628332, "client_id": 522929, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/d74250c0/uploads/origins/a73353e6-69f2-458a-87c5-e50bf4009f56?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=13a5eac868805b2981bb6ab5fa374d67", "srcset": "https://si.imgix.net/d74250c0/uploads/origins/a73353e6-69f2-458a-87c5-e50bf4009f56?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=13a5eac868805b2981bb6ab5fa374d67, https://si.imgix.net/d74250c0/uploads/origins/a73353e6-69f2-458a-87c5-e50bf4009f56?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=d31377b7ad8277bd0c1d78dba1109b8d 2x, https://si.imgix.net/d74250c0/uploads/origins/a73353e6-69f2-458a-87c5-e50bf4009f56?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a869bb799b9a390b094d65a04c6c1c56 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/d74250c0/uploads/origins/a73353e6-69f2-458a-87c5-e50bf4009f56?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=60618993921e02e11a3f75abf2730d98", "srcset": "https://si.imgix.net/d74250c0/uploads/origins/a73353e6-69f2-458a-87c5-e50bf4009f56?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=60618993921e02e11a3f75abf2730d98, https://si.imgix.net/d74250c0/uploads/origins/a73353e6-69f2-458a-87c5-e50bf4009f56?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=d96f25537acb55f1b0ff737f63eb8a1a 2x, https://si.imgix.net/d74250c0/uploads/origins/a73353e6-69f2-458a-87c5-e50bf4009f56?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=2