がっちりめ\nぼさっとした髪の毛と無精髭\n鼻の上に横一文字の傷跡\n\nゆるゆる上司\n頼りがいのある上司だけど結構お茶目さん\n\n▼よくする表情等\n基本表情はゆるい笑み（煙草があったりなかったり）\n目を閉じた笑み\nいたずらっ子みたいなニカっとした笑み\n無表情（真剣な顔）\n\n参考までにキャラクターシートを載せさせていただきます。\nシナリオのネタバレ等ございません。\nhttps://iachara.com/char/3374687/view\n\n▼使用用途\n非商用\nTRPGのセッションでの使用\ntwitterのアイコン画像に使用\n\nどうぞよろしくおねがいいたします。\n\nhttps://iachara.com/char/3374687/view", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@hm2yp/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2016800, "client_id": 2031450, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/f53038f9/uploads/origins/2c7e71bc-2c6b-4bfc-92e1-1cbd2f9ac787?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=994bc7d528356e51a5a387c856eed50e", "srcset": "https://si.imgix.net/f53038f9/uploads/origins/2c7e71bc-2c6b-4bfc-92e1-1cbd2f9ac787?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=994bc7d528356e51a5a387c856eed50e, https://si.imgix.net/f53038f9/uploads/origins/2c7e71bc-2c6b-4bfc-92e1-1cbd2f9ac787?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=5c6d9e1676c19ae38d5c57f209d00155 2x, https://si.imgix.net/f53038f9/uploads/origins/2c7e71bc-2c6b-4bfc-92e1-1cbd2f9ac787?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=5be6adc6b081fd3b0e7036e698bd00aa 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/f53038f9/uploads/origins/2c7e71bc-2c6b-4bfc-92e1-1cbd2f9ac787?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=7d5d6d12c733b8b53a972a2e414bb736", "srcset": "https://si.imgix.net/f53038f9/uploads/origins/2c7e71bc-2c6b-4bfc-92e1-1cbd2f9ac787?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=7d5d6d12c733b8b53a972a2e414bb736, https://si.imgix.net/f53038f9/uploads/origins/2c7e71bc-2c