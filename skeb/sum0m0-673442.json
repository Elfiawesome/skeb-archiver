ラストをどうかお願いしたいです。\nいつもすもも様が描いて上げてくださるウマ娘たちのように、この娘も生きてる、ってイメージで日常的な感じのイラストがみたいです。\n衣装は設定画のうちの一つでお願いします。\nご検討くださいませ！\n\nお忙しい中、要件のみで申し訳ありません。\n応援しております！\n\nhttps://drive.google.com/drive/folders/1kVcp6B8dzGYFGpFb9spMTyDnz0TzyM7Q?usp=sharing", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@sum0m0/works/7", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/4c998d17/uploads/origins/9abfce85-83c2-4cb2-90f3-2831963207ee?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=35e69c20db44357395e81f8ab3cb6c16", "srcset": "https://si.imgix.net/4c998d17/uploads/origins/9abfce85-83c2-4cb2-90f3-2831963207ee?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=35e69c20db44357395e81f8ab3cb6c16, https://si.imgix.net/4c998d17/uploads/origins/9abfce85-83c2-4cb2-90f3-2831963207ee?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=8f2523c374bd0e359a695238e2e44dd4 2x, https://si.imgix.net/4c998d17/uploads/origins/9abfce85-83c2-4cb2-90f3-2831963207ee?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=a70a87a8afab81ea2ec711910a8a16bb 3x"}, "private": true, "genre": "art", "tipped": true, "creator_id": 1768, "client_id": 32135, "nc": 33}, {"path": "/@sum0m0/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1768, "client_id": 1987833, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/f9883b35/uploads/origins/dce7987a-9630-4557-b8a2-b5b2264473af?bg=%23fff&auto=format%2Ccompress&fm=webp&fit