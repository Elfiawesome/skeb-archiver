ff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=e12384881bf5f5820ad4852a1b77c364 2x, https://si.imgix.net/e5504a57/uploads/origins/c824c3da-5f67-4e7c-bf4f-6b17811e5a83?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=f1691c1bc4786d06ec9ac8bde7fa4ccc 3x"}, "private": true, "genre": "art", "tipped": false, "creator_id": 812236, "nc": 32}, {"path": "/@hari_oekaki/works/10", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 812236, "client_id": 462930, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/a3712870/uploads/origins/41ff9b17-ec10-4d2a-9421-c0795251d942?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=60f997038eb7960bc5a96ec8c52b92be", "srcset": "https://si.imgix.net/a3712870/uploads/origins/41ff9b17-ec10-4d2a-9421-c0795251d942?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=60f997038eb7960bc5a96ec8c52b92be, https://si.imgix.net/a3712870/uploads/origins/41ff9b17-ec10-4d2a-9421-c0795251d942?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=72f814f292f09604702d3d82f36ce0f5 2x, https://si.imgix.net/a3712870/uploads/origins/41ff9b17-ec10-4d2a-9421-c0795251d942?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b61f9100233364e16fc65713bbd29839 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/a3712870/uploads/origins/41ff9b17-ec10-4d2a-9421-c0795251d942?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=11335f9908e1ee9579114c0be6fb33c2", "srcset": "https://si.imgix.net/a3712870/uploads/origins/41ff9b17-ec10-4d2a-9421-c0795251d942?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=11335f9908e1ee9579114c0be6fb33c2, https://si.imgix.net/a3712870/uploads/origins/41ff9b17-ec10-4d2a-9421-c0795251d942?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=09907cc4d7d2451910d166c5ffa92cf0 2x, https://si.imgix.net/a3712870/uploads/origins/41ff9b17-ec10-4d2a-9421-c0795251d942?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=a83b05aa798b6dad588c6ab058a96412 3x"}, "body": "またリクエストします\n\n■キャラクター\n東方Projectの犬走椛\n\n過去に描かれた椛はとても理想的でした\nhttps://www.pixiv.net/artworks/124904092\n\n■シチュエーション\n発情期を迎えてフェロモンムンムンな椛が\n椛を狙う男性(おじさん)に口説かれてお持ち帰りされ\n男性の家の寝室で汗だくムレムレなイチャラブ交尾をします\nこの男性は前回の影狼依頼に登場した竿役と同一人物\n\n前回の影狼の依頼\nhttps://skeb.jp/@hari_oekaki/works/9\n\n体位は前回の影狼と同じく男性主観の騎乗位\n服は胸と結合部が露出していれば全裸でも半脱ぎでもＯＫ\n陰毛描写は「あり」\n\n擬音や喘ぎ声、台詞ありで以下のような差分形式でお願いします\n\n⓪導入(可能なら)\n哨戒任務直後＆汗っかき体質のため全身汗だくな椛は\n男性(影狼の旦那)からとても汗臭いと言われます\n同じ白狼天狗の仲間からも汗臭いと言われている椛は\n体臭がコンプレックスでクサいですよねと去ろうとしますが\n男性から汗を舐めさせてと頼まれて\n影狼さんの旦那さんなのに…と思いながら応じてしまい\n男性からは味や匂いがとても好評でドキドキで\nこのままセックスしようと言われて承諾します\n\n①挿入前\n発情期で全身汗だくムレムレの椛は汗臭くないか気にしていますが\n男性から影狼ちゃんとは違ったエロい匂いで興奮すると言われ\n私の匂いで興奮してるんだとドキドキで\nこの人となら交尾しても…と思っています\n\n②挿入\nずぷぷと挿入された椛は\n影狼さんの旦那さんとしちゃったとゾクゾクで\n椛も男性との交尾の相性バッチリ\n\n③ピストン中\n発情期で今日は危険日と言う椛に男性は椛ちゃんも嫁にすると宣言\nあなたには影狼さんがとかお仕事(哨戒任務)に支障がと戸惑う椛ですが\n男性から責任は取ると言われて本気なんだとドキドキ\n\n④ピストン中(射精直前)\n危険日中出しを受け入れた椛は\n中に出して・孕ませてなどの孕ませワードを自ら囁き\n男性を更に興奮させて迫る中出しにゾクゾク\n\n⑤中出し絶頂\n中出しで椛は絶頂\n\n⑥中出し後の余韻中\n中出しマーキングされた余韻に浸る椛はお仕事は引退するようで\n「私も番いにされちゃった❤」「私も１０人は欲しいです❤」\n「影狼さんと一緒にたくさん産みます❤」と嬉しそうです\n\n以上、ご検討ください", "nc": 160, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@hari_oekaki/works/9", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 812236, "client_id": 462930, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/cb1372fe/uploads/origins/1288be09-d52a-4db7-8730-f3231859c0c9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e02ceaa311a8bccac6fa7e06a9190c19", "srcset": "https://si.imgix.net/cb1372fe/uploads/origins/1288be09-d52a-4db7-8730-f3231859c0c9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e02ceaa311a8bccac6fa7e06a9190c19, https://si.imgix.net/cb1372fe/uploads/origins/1288be09-d52a-4db7-8730-f3231859c0c9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=73bdbcad9a936aa6d1fc657fc3ea8c34 2x, https://si.imgix.net/cb1372fe/uploads/origins/1288be09-d52a-4db7-8730-f3231859c0c9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=41783cf29c545b63919b846241cfb916 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/cb1372fe/uploads/origins/1288be09-d52a-4db7-8730-f3231859c0c9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=7cb2acc9e5157cfb60e1117c26b88b15", "srcset": "https://si.imgix.net/cb1372fe/uploads/origins/1288be09-d52a-4db7-8730-f3231859c0c9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=7cb2acc9e5157cfb60e1117c26b88b15, https://si.imgix.net/cb1372fe/uploads/origins/1288be09-d52a-4db7-8730-f3231859c0c9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=c369cc3dc048ab76f62a57357585a021 2x, https://si.imgix.net/cb1372fe/uploads/origins/1288be09-d52a-4db7-8730-f3231859c0c9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=c5abf8a10bc8cc65d1bc3c7789134023 3x"}, "body": "初めまして、リクエストします。\n\n■キャラクター\n東方Projectの今泉影狼\n\n影狼は過去に以下で描かれていますが\n本依頼では人耳(エルフ耳)は「なし」でお願いします。\n\nhttps://www.pixiv.net/artworks/124419206\n\n■シチュエーション\n発情期を迎えてフェロモンムンムンな影狼が\n彼女を狙う男性(おじさん)に口説かれてお持ち帰りされ\nおじさんの家の寝室で汗だくムレムレなイチャラブ交尾をします。\n\n体位はよく描かれている男性主観の騎乗位\n服は胸と結合部が露出していれば全裸でも半脱ぎでもＯＫ\n陰毛描写は「あり」\n\n擬音や喘ぎ声、台詞ありで以下のような差分形式でお願いします。\nおじさん要素がＮＧな場合は成人男性(人間)と置き換えてください。\n\n①挿入前\n発情期のため全身汗だくムレムレの影狼は\n体臭(特に腋)がクサくないかとても気にしてますが\nおじさんからエロくて興奮すると言われたようで\n私の匂いで興奮してるんだとドキドキしており\nこのおじさんとなら交尾しても良いかもと思っています。\n\n②挿入\nずぷぷと挿入された影狼は\nおじさんと交尾しちゃったとゾクゾクしており\nおじさんと交尾の相性バッチリの模様\n\n③ピストン中\n影狼は発情期で今日は危険日であると伝えると\nこのまま中に出して孕ませて嫁にすると\nおじさんの動きは更に激しくなり\n影狼は本気で孕ませる気なんだとドキドキ\n\n④ピストン中(射精直前)\nおじさんに危険日中出しを承諾した影狼は\n中に出して・孕ませてなどの孕ませワードを自ら囁き\nおじさんのことを更に興奮させて迫る中出しにゾクゾク\n\n⑤中出し絶頂\n中に出されて影狼は絶頂します。\n\n⑥中出し後の余韻中\n中出しマーキングされた余韻に浸る影狼は\n「おじさんと番いになっちゃった❤」\n「元気な赤ちゃんを産むわ❤」と嬉しそうです。\n\n以上、ご検討ください。", "nc": 169, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@hari_oekaki/works/8", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 812236, "client_id": 3191323, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/8fd792f6/uploads/origins/1e6efe60-0d1d-4058-8d1c-52344272f742?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=36f13be6fb2567cfb7ffec08410f6f11", "srcset": "https://si.imgix.net/8fd792f6/uploads/origins/1e6efe60-0d1d-4058-8d1c-52344272f742?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=36f13be6fb2567cfb7ffec08410f6f11, https://si.imgix.net/8fd792f6/uploads/origins/1e6efe60-0d1d-4058-8d1c-52344272f742?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e9f396eb1c787eee06653d7b123f7a89 2x, https://si.imgix.net/8fd792f6/uploads/origins/1e6efe60-0d1d-4058-8d1c-52344272f742?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=5c465f93432206ed6b7a07210f911735 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/8fd792f6/uploads/origins/1e6efe60-0d1d-4058-8d1c-52344272f742?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d7a6f1d3939ce30c3c72fb15eef13c80", "srcset": "https://si.imgix.net/8fd792f6/uploads/origins/1e6efe60-0d1d-4058-8d1c-52344272f742?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d7a6f1d3939ce30c3c72fb15eef13c80, https://si.imgix.net/8fd792f6/uploads/origins/1e6efe60-0d1d-4058-8d1c-52344272f742?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=2a0b795285955a6bcdc703cf807c652c 2x, https://si.imgix.net/8fd792f6/uploads/origins/1e6efe60-0d1d-4058-8d1c-52344272f742?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=3f8179d2357e0f2d23ebcede9357c4da 3x"}, "body": "リクエスト失礼いたします。\nはりくん様が描かれる東方projectのキャラクターがとても魅力的でしたので是非イラストを描いていただきたく存じます。\n\nリクエスト内容:東方projectのレミリア・スカーレットのイラスト\n\n構図:https://x.com/hari_oekaki/status/1852296469954576540/photo/1\nはりくん様が描かれた上記イラストのような構図でお願いいたします。\n\n表情:妖艶に微笑んでいる表情でお願いいたします。\n\n使用用途:Youtubeにて東方projectのASMR動画用イラストに使用予定です。\nその為、頭が見切れないように描いて頂きたいです。\n\n背景がある場合、人物のみの背景透過もお願いいたします。\nファイル形式は、キャラクターと背景を分けたPSDファイルでいただけると幸いです。\n難しい場合は透過PNGでお願いいたします。\n\nリクエスト内容と違う部分があっても問題ありません。\nはりくん様の描きやすいように描いていただけると嬉しいです！\n\nご検討のほど何卒よろしくお願い致します。", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@hari_oekaki/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 812236, "client_id": 1764280, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/08218908/uploads/origins/c734e518-052b-4e4b-83f7-e868493299e7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=76b2450ea95e8f6c17ac228d3187f266", "srcset": "https://si.imgix.net/08218908/uploads/origins/c734e518-052b-4e4b-83f7-e868493299e7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=76b2450ea95e8f6c17ac228d3187f266, https://si.imgix.net/08218908/uploads/origins/c734e518-052b-4e4b-83f7-e868493299e7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=972e894f771a20c353b8f75c6156e3e7 2x, https://si.imgix.net/08218908/uploads/origins/c734e518-052b-4e4b-83f7-e868493299e7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=3ef472052cb907359fdf1abd02847827 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/08218908/uploads/origins/c734e518-052b-4e4b-83f7-e868493299e7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c4faf02374f04e99229f17db89060425", "srcset": "https://si.imgix.net/08218908/uploads/origins/c734e518-052b-4e4b-83f7-e868493299e7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c4faf02374f04e99229f17db89060425, https://si.imgix.net/08218908/uploads/origins/c734e518-052b-4e4b-83f7-e868493299e7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=0a4ba94ba091f41eec5097d5b7ab6ff4 2x, https://si.imgix.net/08218908/uploads/origins/c734e518-052b-4e4b-83f7-e868493299e7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=5526c61613e13fb5aa476e70da526ef6 3x"}, "body": "リクエストさせていただきます。\nはじめまして、朱島悠永です。\nVTuberをしておりまして、Youtubeのサムネ作成等に使用できる一枚絵をお願いしたいです。\n大きさは、フルHD画面いっぱいにバスト～顔だけ大きく映したときに荒くならない程度あれば十分で、1500×1500px以上になるかと思います。縦横比は指定ありません。\n身体や髪の毛が左右、上で見切れないと使い勝手がよく、また差分や透過の背景無しがあると嬉しいです。\n\n資料URLはLive2Dモデルの立ち絵（ほぼ直立）です。\nhttps://x.com/yuna_akashima/status/1491076792173875200\n※上記が閲覧できない場合はこちらをご参照願います。\nhttps://x.com/yuna_akashima/status/1661802642694369280\n髪と目は立ち絵に使用されていない決めた色がありますので、こちらに記載いたします。\n髪：\n・真朱色\nhttps://irocore.com/shinshu/\n目：\n・真朱色（目の色、明るい部分等）\nhttps://irocore.com/shinshu/\n・葡萄色（影等の暗い部分）\nhttps://irocore.com/ebi-iro/\n・海老色（中間色として使用する色）\nhttps://irocore.com/ebi-iro2/\n\n以上です。よろしくお願いいたします。", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@hari_oekaki/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 812236, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/20e3cb61/uploads/origins/1d