願いします。\n\n②衣服は裸or通常衣装の胸の部分が開けた状態で、サングラスやリボン、帽子は省略なしでお願いします。\n\n③表情は蠱惑な笑みを浮かべ、舌舐めずりしており、空になったコンドームの空き箱を見せつけ、今から生で犯すのを示唆している状態。\n※周りに使用済みコンドームがある。\n\n竿役の男(視点主)\n①挿入してないが、フル勃起状態で生で犯される寸前(ゴム有りで何度も搾られた後)。\n\n②描写されてる範囲でペニスや身体に女苑のキスマークを幾つか付けられ、マーキングされてる。\n\n長くなりましたが、何卒よろしくお願いします。", "nc": 42, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@hari_oekaki/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 812236, "client_id": 446356, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/e55f3dde/uploads/origins/bb3397ba-107b-4610-b42d-d8980cdfe8ac?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fee2a944138e76c49d698e54cc69db64", "srcset": "https://si.imgix.net/e55f3dde/uploads/origins/bb3397ba-107b-4610-b42d-d8980cdfe8ac?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fee2a944138e76c49d698e54cc69db64, https://si.imgix.net/e55f3dde/uploads/origins/bb3397ba-107b-4610-b42d-d8980cdfe8ac?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=95e7df618937a583e081a5d1611b7905 2x, https://si.imgix.net/e55f3dde/uploads/origins/bb3397ba-107b-4610-b42d-d8980cdfe8ac?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=0a42eafef7e484fe6b5e1dc9fec81d88 3x"}, "duration": null, "nsfw": true, "hardcore": true, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/e55f3dde/uploads/origins/bb3397ba-107b-4610-b42d-d8980cdfe8ac?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2f9531d5018947a7945d809c289d9306", "srcset": "https://si.imgix.net/e55f3dde/uploads/origins/bb3397ba-107b-4610-b42d-d8980cdfe8ac?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2f9531d5018947a7945d809c289d9306, https://si.imgix.net/e55f3dde/uploads/origins/bb3397ba-107b-4610-b42d-d8980cdfe8ac?bg=%23fff&auto=format%2Ccompress&fm=webp