/origins/62f1b02f-3912-443f-9dcc-1f12f79163bd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4a85b58100177c0d94b26575bbeeef4b, https://si.imgix.net/8ef3aac1/uploads/origins/62f1b02f-3912-443f-9dcc-1f12f79163bd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ebc77d53a609089102c5603f9db26755 2x, https://si.imgix.net/8ef3aac1/uploads/origins/62f1b02f-3912-443f-9dcc-1f12f79163bd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=6036dee14d5413d07f7635d1cb19fff1 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/8ef3aac1/uploads/origins/62f1b02f-3912-443f-9dcc-1f12f79163bd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5c504f60f351c936ea0d53d830551f75", "srcset": "https://si.imgix.net/8ef3aac1/uploads/origins/62f1b02f-3912-443f-9dcc-1f12f79163bd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5c504f60f351c936ea0d53d830551f75, https://si.imgix.net/8ef3aac1/uploads/origins/62f1b02f-3912-443f-9dcc-1f12f79163bd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=2cbc1fb5aac8976028f2178251aea22f 2x, https://si.imgix.net/8ef3aac1/uploads/origins/62f1b02f-3912-443f-9dcc-1f12f79163bd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=2b892a0312eef362a2ddfacadf4da644 3x"}, "body": "初めまして、アピールありがとうございます！\n是非うちの姉妹を描いて頂きたいと思い、リクエストさせて頂きます！\nアピール文では2人をお揃いの衣装で描いてくれるとのことで、そのままお願いしたいです。\n衣装の内容についてはかおルナ様にお任せします、ぜひ可愛くしてください。\n構図やシチュエーションもお任せします！\n\n柏壬（はくみ）\n22歳、薄緑のロングヘアーに薄緑の瞳、170cmで高身長のコスプレ趣味のお姉さん。胸はHカップでボンキュッボンなタイプです。妹と一緒にコスプレをするのが趣味。髪を伸ばしてるのはいろいろアレンジできるから。腰下までの長さです。\n\nhttps://drive.google.com/drive/folders/1jqMr3hmcZtI4Pbkjvhu2E8_xiN3yJni5\nhttps://drive.google.com/drive/folders/1rMpeaTqE_NIfZI4au9Uve-y6UVHkmi2g\n\n桜弥（おうみ）\n17歳、166cm、Dカップ。ボブヘアー。姉がいるが、姉が巨乳で自分が普通なのがコンプレックス。その割にオシャレのためなら胸をアピールすることも忘れない。姉がコスプレ好きで、それに付き合っていろんな服を着させられたりしている。髪が短いのは姉にアレンジさせられまくるのを回避するため。\n髪にインナーカラーが入っている（三面図参照）目の色はインナーカラーと同じで緑ではないです（AIで資料を制作しているためややこしいですが、三面図参考でお願いします）\n\nhttps://drive.google.com/drive/folders/1ldnQ85FiD2bewf2m3tZyI8EBekVtrdmj\nhttps://drive.google.com/drive/folders/1vEsUUbtBMMe0u8itbaKtlOKZw4UYNphw", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 1688710, "creator": true, "nsfw_acceptable": true, "acceptable": false, "name": "KiiKo @アニメ原画風skeb", "screen_name": "Kiiko_clip", "avatar_url": "https://proxy.misskeyusercontent.jp/avatar.webp?url=https%3A%2F%2Fmedia.misskeyusercontent.jp%2Fio%2Fd4b360a8-1c07-44f9-b59a-94c6982e2227.gif&avatar=1", "header_url": "https://media.misskeyusercontent.jp/io/fb207f67-3c6c-47bb-9795-c6d4b3977f4a.webp", "appeal_receivable": false, "popular_creator_rank": 34, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 8, "complete_expiration_days": 120, "skills": [{"genre": "art"}], "banned": false, "nc": 49}, {"id": 1929346, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "ふせんりょ", "screen_name": "fusenryo2", "avatar_url": "https://pbs.twimg.com/profile_images/1570380827116343297/3nAQlmbS.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1429384473171283969/1629629288/1500x500", "appeal_receivable": false, "popular_creator_rank": 46, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 3, "complete_expiration_days": 7, "skills": [{"genre": "art"}, {"genre": "comic"}], "banned": false, "nc": 0}, {"id": 2014628, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "ふろんとほっく", "screen_name": "front_hook", "avatar_url": "https://pbs.twimg.com/profile_images/1995123993586868224/aY4PwYmI.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1503