3fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=79067c76045aa08118991572aedac677, https://si.imgix.net/59bde682/requests/235607_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=aa6d747d96e6f3d5f6859e59facc8863 2x, https://si.imgix.net/59bde682/requests/235607_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=96139efef357cd04d4ccdbf32196ae70 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/59bde682/requests/235607_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f8c2998b15cf668fe802bd8df53efad1", "srcset": "https://si.imgix.net/59bde682/requests/235607_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f8c2998b15cf668fe802bd8df53efad1, https://si.imgix.net/59bde682/requests/235607_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=b26bdf1e8ef5a9ec77872c6ba12b3663 2x, https://si.imgix.net/59bde682/requests/235607_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=746bba998a9ec6b897b90409d9db1f5d 3x"}, "body": "はじめまして。\npixivで貴方のイラストを拝見し、その類稀な技量に感服致しました。\nその腕を見込んで、是非描いていただきたい絵がございます。\nご検討いただければ幸いです。\n\n以下、依頼内容です。\n\n\n\n◎FE覚醒のルフレ♀によるパイズリの絵をお願い致します。\n\n\n○ルフレ♀\n・コスチュームはFEHに登場した水着verでお願い致します。\n・以前pixivにアップされた同キャラのイラストのように、パーカーは羽織ったまま、水着をたくし上げておっぱいを露出させた感じだと嬉しいです。\n・Hに対して積極的な感じ(ビッチ？)に描いていただければと存じます。\n\n○体位、構図\n・立っている男性に対し、膝立ちで行うタイプのパイズリをお願い致します。\n・おっぱいで挟みながら、相手の顔を見上げる感じだと嬉しいです。\n・やや俯瞰気味のアングルで、上から見下ろす感じでお願い致します。\n・他、描きやすい構図などがあれば、適宜調整していただいて構いません。\n\n○竿役\n・一応、クロムという設定で。\n・巨根気味に描いていただければ嬉しいです。\n・男根とその周辺など、最低限の描写だけで構いませんが、お腹などが映る場合、筋肉質に描いてください。\n\n○差分\n基本となる挟んだ絵をベースに、\n・射精の瞬間(びっくりして片目を瞑った顔)\n・ぶっかけられてザーメンまみれな状態(恍惚そうな表情)\nこの2つの差分を作っていただければ幸いです。\n・射精の勢いは強く、量は多めに。\n・顔、おっぱいの両方をザーメンでドロドロに汚す感じだと最高です。\n\n○その他\n・真夏の海で、ルフレからクロムにアプローチをかけるといったシチュエーションを想定。\n・適当で良いので、海の背景があるとありがたいです。\n・局部修正は黒線(or白線)だとありがたいです。\n\n\n以上でございます。\n長々と失礼致しました。\n描けそうであれば、引き受けていただけると嬉しく思います。\n何卒、よろしくお願い致します。", "nc": 160, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@tinpow199/works/2", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/6f3e6170/requests/215367_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=32621a01efe77e47006fecf508e0f215", "srcset": "https://si.imgix.net/6f3e6170/requests/215367_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=32621a01efe77e47006fecf508e0f215, https://si.imgix.net/6f3e6170/requests/215367_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=6b10598a30d22dc2ade77348ceabe778 2x, https://si.imgix.net/6f3e6170/requests/215367_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=8ca6f3deb89c3fd3aad90702090b1594 3x"}, "private": true, "genre": "art", "tipped": true, "creator_id": 936909, "client_id": 806358, "nc": 33}, {"path": "/@tinpow199/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 936909, "client_id": 70097, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/e0f2f61e/requests/215909_1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2e8d3430bf83c46a2625b12bccb1d51a", "srcset": "https://si.imgix.net/e0f2f61e/requests/215909_1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2e8d3430bf83c46a2625b12bccb1d51a, https://si.imgix.net/e0f2f61e/requests/215909_1?bg=%23fff&auto=format%2Ccompress&