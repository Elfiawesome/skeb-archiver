ix.net/7987964f/uploads/origins/05737ee0-d693-48fb-97e3-b4731542acbb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a726f758fb020cee29e4befde61c6240", "srcset": "https://si.imgix.net/7987964f/uploads/origins/05737ee0-d693-48fb-97e3-b4731542acbb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a726f758fb020cee29e4befde61c6240, https://si.imgix.net/7987964f/uploads/origins/05737ee0-d693-48fb-97e3-b4731542acbb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=32233ad6d585769f65006a3b00f8de41 2x, https://si.imgix.net/7987964f/uploads/origins/05737ee0-d693-48fb-97e3-b4731542acbb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=d233f3c7b1638310a252d6aca60ffe1e 3x"}, "body": "こんにちは。\n\n以前、私のOCを描いていただいたイラストがとても気に入ったので、また依頼させていただきたいと思います。  私のファイナルファンタジー14のララフェルのキャラクターを、あなたの小さなキャラクタースタイルでイラストを依頼したいのです。\n\nいつものクラフト職人の服装で、クラフト作業をしている姿を希望しています。  作品には2つのシナリオを考えています。  あなたが一番好きなシナリオ、一番楽しめそうなシナリオを選んでください。\n\n1つ目のシナリオは、武器や道具、アクセサリーに装飾的な彫刻を刻むというものです。  コンセプトの参考画像はURLの中にあります。  どんな刻印にするかは、あなた次第です。  真面目なものでも、かわいらしいものでもOKです。\n\n2つ目のシナリオは、デザートに最後の飾り付けをするシーンです。  どんなデザートにするかはあなた次第。  一切れのケーキのようなものなら、余計にかわいくて面白いかもしれませんね。\n\nポーズや表情など、細かいところはお任せします。\n\n今回もご検討ありがとうございました。\n\nhttps://imgur.com/a/Y0UJ9iE", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@kirich1k4/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2433021, "client_id": 2087198, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/4baec83d/uploads/origins/ca5baa4a-f76f-4fde-9fb6-8b84aeee37bb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5e6138b8acd5eba303f95159121c55eb", "srcset": "https://si.imgix.net/4baec83d/uploads/origins/ca5baa4a-f76f-4fde-9fb6-8b84aeee37bb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s