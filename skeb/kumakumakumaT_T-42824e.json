google.com/drive/folders/1ddLz_q_BMaR9vwEdOZTLzm-GgZEf68hy?usp=sharing", "nc": 33, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@kumakumakumaT_T/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 149068, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/b995f598/uploads/origins/3e3dbf4b-4b90-41b5-8cbf-0085094ce005?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5c3d8bc46b9d8888091838bcb14c58eb", "srcset": "https://si.imgix.net/b995f598/uploads/origins/3e3dbf4b-4b90-41b5-8cbf-0085094ce005?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5c3d8bc46b9d8888091838bcb14c58eb, https://si.imgix.net/b995f598/uploads/origins/3e3dbf4b-4b90-41b5-8cbf-0085094ce005?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=106954a828c5517bbff73548b1d05aa7 2x, https://si.imgix.net/b995f598/uploads/origins/3e3dbf4b-4b90-41b5-8cbf-0085094ce005?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c7d9ba00b422933b0f9fee7081d59004 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/b995f598/uploads/origins/3e3dbf4b-4b90-41b5-8cbf-0085094ce005?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=df1304354b3a51c79b5465e7cee3aadd", "srcset": "https://si.imgix.net/b995f598/uploads/origins/3e3dbf4b-4b90-41b5-8cbf-0085094ce005?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=df1304354b3a51c79b5465e7cee3aadd, https://si.imgix.net/b995f598/uploads/origins/3e3dbf4b-4b90-41b5-8cbf-0085094ce005?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=ce20b883d5eba3c25d5e97fba4e17ed1 2x, https://si.imgix.net/b995f598/uploads/origins/3e3dbf4b-4b90-41b5-8cbf-0085094ce005?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=1db07bde2320ec29d47788767deff60f 3x"}, "body": "リクエスト失礼します。\nもしよろしければご一考ください。\n\n資料URLの女の子で、とにかくパンツが見えまくるイラストをお願いします。\n構図や表情は全体的にお任せします。\n構図の分割はあってもなくてもどちらでも可。背景は無しでokです。\n\n可能な範囲でえっちな感じのイラストにしてもらいたいですが、必ずパンツは穿かせたままで脱がせないでください。\n股間のお肉やスジがパンツ越しに浮かび上がるなどの要素は大歓迎です。\n\n●パンツデザイン追記\n基本、白と水色の縞パンです。\nただしパンツの隅っこのふちの部分（パンツを締めるゴムなどが入っていそうな辺り）は\n資料と同様に白一色で縞々にならないようお願いします。\nまた、股間付近にはクロッチ縫い目もお願いします。\n\nhttps://drive.google.com/file/d/1Mbc2Xp_2SzMgOpElZ3h3b_KhupEvRZEK/view", "nc": 49, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@kumakumakumaT_T/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 149068, "client_id": 6326, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/3923a888/uploads/origins/6533dc9a-a604-4585-9871-e4d03dc5ab29?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=94a58642c4fbc14e76b7bb1140f8bda6", "srcset": "https://si.imgix.net/3923a888/uploads/origins/6533dc9a-a604-4585-9871-e4d03dc5ab29?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=94a58642c4fbc14e76b7bb1140f8bda6, https://si.imgix.net/3923a888/uploads/origins/6533dc9a-a604-4585-9871-e4d03dc5ab29?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=212e264fe1d83a070643123a6d5ad26c 2x, https://si.imgix.net/3923a888/uploads/origins/6533dc9a-a604-4585-9871-e4d03dc5ab29?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=99f4151bab98474aa177545b118dc6bf 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/3923a888/uploads/origins/6533dc9a-a604-4585-9871-e4d03dc5ab29?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6ac4a7a79ff1b8d60d0e65c99f4d9329", "srcset": "https://si.imgix.net/3923a888/uploads/origins/6533dc9a-a604-4585-9871-e4d03dc5ab29?bg=%23fff&aut