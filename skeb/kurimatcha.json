uploads/origins/da8d6249-ea50-4e60-9912-36ba4841471c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a90d829acdc69f11bc3c85c7a5bb845f, https://si.imgix.net/d962d56a/uploads/origins/da8d6249-ea50-4e60-9912-36ba4841471c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=4576751cf04ee4fe4c415d1d6132fcfe 2x, https://si.imgix.net/d962d56a/uploads/origins/da8d6249-ea50-4e60-9912-36ba4841471c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=00a9a93dab263b836ee6c051a91f0812 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/d962d56a/uploads/origins/da8d6249-ea50-4e60-9912-36ba4841471c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2463e0e0560dfe548b603d7d043764f9", "srcset": "https://si.imgix.net/d962d56a/uploads/origins/da8d6249-ea50-4e60-9912-36ba4841471c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2463e0e0560dfe548b603d7d043764f9, https://si.imgix.net/d962d56a/uploads/origins/da8d6249-ea50-4e60-9912-36ba4841471c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=d0838e4e0bc6a48053f19ad1f192dca5 2x, https://si.imgix.net/d962d56a/uploads/origins/da8d6249-ea50-4e60-9912-36ba4841471c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=47a08bf9e10175ba4941970d9f32a223 3x"}, "body": "くり抹茶様\n\nはじめまして！\n素敵なイラストの雰囲気とタッチに惹かれましたので、リクエストを送信させていただきました！\nもし宜しければ、私のOCを描いていただけませんか？\n\n今回のリクエストキャラクターはOCの[ヴェリェーミア]になります。\nこの子のテーマとして[時]をイメージしております。\n\n【キャラクター詳細】\n<性格･表情>\n･野心家な性格で悪巧みなことも考えますが、元々の根は良い子です。\n･表情は悪巧みしている感じでお願いいたします！\n\n<服装>\n･特に変更はなく、フォルダ内にある衣装のままでお願いいたします。\n\n<その他>\n･時空の狭間に住み着いている設定なので、ご余裕がございましたら、それに近い背景があると大変嬉しく思います！\n\n以上となります！\nこちらでご検討いただけますと幸いです！\nよろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/1FVlcDGHwvUpVkFEJ3Brh_Rpu5tLiaNcR", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@kurimatcha/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3574846, "client_id": 3085041, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/562ba5e9/uploads/origins/67828e07-4b4d-471e-b933-22eefd6c7476?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ad7630d68a2ada1cbad2b0706f35aedb", "srcset": "https://si.imgix.net/562ba5e9/uploads/origins/67828e07-4b4d-471e-b933-22eefd6c7476?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ad7630d68a2ada1cbad2b0706f35aedb, https://si.imgix.net/562ba5e9/uploads/origins/67828e07-4b4d-471e-b933-22eefd6c7476?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ecb6ced1a16edd8fefb97336c75ff1bd 2x, https://si.imgix.net/562ba5e9/uploads/origins/67828e07-4b4d-471e-b933-22eefd6c7476?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=750a215c80a58e984029712f42415930 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/562ba5e9/uploads/origins/67828e07-4b4d-471e-b933-22eefd6c7476?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d846c84e524b3eae8863a4efefe019ad", "srcset": "https://si.imgix.net/562ba5e9/uploads/origins/67828e07-4b4d-471e-b933-22eefd6c7476?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d846c84e524b3eae8863a4efefe019ad, https://si.imgix.net/562ba5e9/uploads/origins/67828e07-4b4d-471e-b933-22eefd6c7476?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=4d5ac851454b0fbfef9fae75ddd7f8ac 2x, https://si.imgix.net/562ba5e9/uploads/origins/67828e07-4b4d-471e-b933-22eefd6c7476?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=8f5091ed62f7efc684961c0f76db291c 3x"}, "body": "くり抹茶様 \n初めまして。  \n配信活動をしています、花嶺かざりです。\nくり抹茶様の素敵なイラストを見て、私も描いていただきたく思いリクエストいたしました。\n\n  リクエスト内容  \n「花嶺 かざり」の イラスト。\n納品頂ける月、又はその翌月のイベントやイメージに合うものを描いていただきたいです。\n難しければ、お好きに描いていただいても問題ございません。\n衣装・髪型は好きにアレンジいただいて大丈夫です。\n\n  特徴 \n・明るく茶目っ気のある性格 \n・上がピンク、下が黄色の目  \n・八重歯 (口の線による八重歯で、白い歯はありません)\n ・少し目にかかったパッツンの前髪\n ・黄緑の髪の毛にピンクのメッシュ  \n\nその他\n 背景と人物が別れた透過データもPSD等で頂きたいです。\n\n  使用用途 \n 動画や配信での使用、SNSでの投稿、ファンクラブ等支援者さまへの特典、デジタルグッズなどVTuber活動での使用を予定しております。\n  ※イラスト使用時にフレームや文字や背景追加など、イメージを損ねない範囲で加工することがあります。\n\n  何卒、ご検討のほどよろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/1-DgSfCj7oGTJ2tbky_5Ahbuntpp_riH4", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@kurimatcha/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3574846, "client_id": 3017715, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/ca957992/uploads/origins/f9be332c-9d9c-4614-972d-008dadb94042?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d7b938bc2fd3c718ccc46c0b29e69510", "srcset": "https://si.imgix.net/ca957992/uploads/origins/f9be332c-9d9c-4614-972d-008dadb94042?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d7b938bc2fd3c718ccc46c0b29e69510, https://si.imgix.net/ca957992/uploads/origins/f9be332c-9d9c-4614-972d-008dadb94042?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=94c5e723479581c7e555b03c2a4fb674 2x, https://si.imgix.net/ca957992/uploads/origins/f9be332c-9d9c-4614-972d-008dadb94042?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d12bf9f7c51f69db3041d91cf7100e4d 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/ca957992/uploads/origins/f9be332c-9d9c-4614-972d-008dadb94042?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=06e957aa0fd2c1c9dba8ecacc8fe2552", "srcset": "https://si.imgix.net/ca957992/uploads/origins/f9be332c-9d9c-4614-972d-008dadb94042?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=06e957aa0fd2c1c9dba8ecacc8fe2552, https://si.imgix.net/ca957992/uploads/origins/f9be332c-9d9c-4614-972d-008dadb94042?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=32b8827a4572ca04f02334925a582f51 2x, https://si.imgix.net/ca957992/uploads/origins/f9be332c-9d9c-4614-972d-008dadb94042?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=55f330f0d2c97e9efb4029981c08ad5b 3x"}, "body": "くり抹茶様\n\nいつもお世話になっています。\n\n今回、私のオリジナルキャラクターのイラストをお願いしたいと思い、依頼させていただきました。\n細かい、構図やポーズはお任せしますが、秋の季節に紅葉狩りをしているイラストでお願いしたいです。\nまた、可能であれば表情差分（笑顔等）もお願いできたらと思います。\n\n参考資料として下記リンク先に資料を用意していましたのでご活用していただけたらと思います。\n\nどうかご検討のほどよろしくお願いします。\n\n参考資料①\nhttps://www.pixiv.net/artworks/125902778\n\n参考資料②\nhttps://www.pixiv.net/artworks/120338290", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@kurimatcha/works/2", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/0b5cea8c/uploads/origins/cee8ce02-e98d-4e09-9728-d01d924a729f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=a4439fe49184b64cbba4c8b0ea642836", "srcset": "https://si.imgix.net/0b5cea8c/uploads/origins/cee8ce02-e98d-4e09-9728-d01d924a729f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=a4439fe49184b64cbba4c8b0ea642836, https://si.imgix.net/0b5cea8c/uploads/origins/cee8ce02-e98d-4e09-9728-d01d924a729f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=bf981095416786869e127df1829bf0f9 2x, https://si.imgix.net/0b5cea8c/uploads/origins/cee8ce02-e98d-4e09-9728-d01d924a729f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=a3b148299087abf35a29af038bb124df 3x"}, "private": true, "genre": "art", "tipped": false, "creator_id": 3574846, "nc": 17}, {"path": "/@kurimatcha/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3574846, "client_id": 3520844, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/40edc09d/uploads/origins/1ab9e5c1-c43a-41b4-92dc-94bec7308360?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0a25fe626333b08e449272b32c664ff6", "srcset": "https://si.imgix.net/40edc09d/uploads/origins/1ab9e5c1-c43a-41b4-92dc-94bec7308360?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0a25fe626333b08e449272b32c664ff6, https://si.imgix.net/40edc09d/uploads/origins/1ab9e5c1-c43a-41b4-92dc-94bec7308360?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=118a476d28861afecee916d06f9f0d73 2x, https://si.imgix.net/40edc09d/uploads/origins/1ab9e5c1-c43a-41b4-92dc-94bec7308360?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a3e77b10c89d8fd2dab793408d3f0335 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/40edc09d/uploads/origins/1ab9e5c1-c43a-41b4-92dc-94bec7308360?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2ccc114c06ab9c48c46b5ae400dcae0a", "srcset": "https://si.imgix.net/40edc09d/uploads/origins/1ab9e5c1-c43a-41b4-92dc-94bec7308360?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2ccc114c06ab9c48c46b5ae400dcae0a, https://si.imgix.net/40edc09d/uploads/origins/1ab9e5c1-c43a-41b4-92dc-94bec7308360?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=d274a475d85411ffda75c97aec654744 2x, https://si.imgix.net/40edc09d/uploads/origins/1ab9e5c1-c43a-41b4-92dc-94bec7308360?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=01996f91f82a882c8c43d04a8c43c503 3x"}, "body": "始めまして綾ナギと申します！\nくり抹茶様のtwitterのイラストに一目惚れしました！\n女の子がとてもかわいく素敵だと感じたためリクエストをさせていただきます！\n\n＜内容＞\n個人VTuberの蓮希るいちゃんを描いていただきたいです！\n出来上がったイラストを蓮希るいちゃんへプレゼントさせていただきたいと思います。\n\n＜構図やポーズ＞\n可能であれば16：9のアスペクト比でお願いします。\n構図としてはパジャマ衣装でベッドで座りながら耳かきor寝転がりながら囁きをしようとしている姿でお願いします。\nhttps://x.com/kurimatcha/status/1900751259445194823\nのような雰囲気でお願いします。\nパジャマ衣装はボタンを少し開けて着崩して欲しいです。（中はキャミソールでYouTubeの規約に引っかからない程度のチラ見せでお願いします。）\n他におすすめの構図があればおまかせいたしますのでYouTubeのサムネイルに使用できるようなイラストを描いていただけると助かります。\n耳かき棒を描いていただく場合はON/OFF可能だと助かります。\n頭部や左右が切れないようにしていただけると助かります。\n細かいポーズなどはおまかせでお願いします。\n可能でしたら表情差分をお願いします。\n\n＜ご本人様サイトからの注意点やお願い＞\n以下ご本人様サイトからの文章コピーになります。\n依頼をする際には、このページへのリンクまたはFANBOXのリンクを共有したのち蓮希るいのTwitterや収益化されたYoutubeチャンネルで使用される可能性があること」を依頼文で必ず伝えてください。\n\n▼skebまたは依頼したイラスト\npsdファイル/背景透過ファイルがあると嬉しいです。\nイラストレーター様に依頼していただいたイラストは活動面（サムネイル）で使用できるのでとても嬉しいです！\n\nイラストレーター様にご依頼の際は、二次創作プログラム承認済みですので「蓮希るい」の名前を使用して許可済みだということをお伝えください。\n\n長くなってしまいましたがぜひご検討のほどよろしくお願い致します！\n\nhttps://lit.link/Hasukirui", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [{"path": "/@me1kakuna_1si/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3782287, "client_id": 3574846, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/9c1556b6/uploads/origins/a8fb635b-b035-40fa-9733-21c822fb315d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=33cd430cb8f63b3a77de50c7826cbe90", "srcset": "https://si.imgix.net/9c1556b6/uploads/origins/a8fb635b-b035-40fa-9733-21c822fb315d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=33cd430cb8f63b3a77de50c7826cbe90, https://si.imgix.net/9c1556b6/uploads/origins/a8fb635b-b035-40fa-9733-21c822fb315d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=32c0150d3592aea5ad4e3502f9d00054 2x, https://si.imgix.net/9c1556b6/uploads/origins/a8fb635b-b035-40fa-9733-21c822fb315d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=6dc19190e09f2d25ef5aba206142b89c 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/9c1556b6/uploads/origins/a8fb635b-b035-40fa-9733-21c822fb315d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=562cfd0fa5f7a7890da82b3df9b44a7f", "srcset": "https://si.imgix.net/9c1556b6/uploads/origins/a8fb635b-b035-40fa-9733-21c822fb315d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=562cfd0fa5f7a7890da82b3df9b44a7f, https://si.imgix.net/9c1556b6/uploads/origins/a8fb635b-b035-40fa-9733-21c822fb315d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=6e70c24d5d382ca730cb8292b6a2eede 2x, https://si.imgix.net/9c1556b6/uploads/origins/a8fb635b-b035-40fa-9733-21c822fb315d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=be05313ccd19ec8b460e698c20d22b3b 3x"}, "body": "こんにちは、くり抹茶と申します。\n明確な石さんの優しく暖かみがある世界観のイラストが好きで依頼させていただきたいと思いました。\n今回は私のオリジナルキャラクター「おかしひめ」を描いて頂きたいです。\n\n【キャラクター設定】\nおかしひめは元々「流れ星の妖精（画像参照）」で彼らの持つ魔法の力で大好きなお菓子をまとったお姫様の姿に変身しています。\n元気で愛嬌のある性格で、好きなことはお菓子を食べることと人の願いを叶えることです。\n普段は森や街をお菓子に変えたりして遊んでいます。\n\n【イラスト内容】\n上記のおかしひめを用いて明確な石さんが普段描いているような、背景も活かした世界観溢れるイラストを描いて頂きたいです！\n構図等の指定はありませんので、設定などを見て思いついたものを自由に描いて欲しいです。\n\n【希望納品形式】\n画面サイズは9:16の横長にしていただきたいです。\nまた、psdでおかしひめ単体のレイヤーがあると嬉しいです！(構図的に難しい場合などは大丈夫です。)\n\n【使用用途】\n基本は観賞用ですが、SNSのアイコンやヘッダーに使わせて頂くかもしれません。ですが、使いやすいよう描いて頂かなくて大丈夫です。\n\n背景付きで大変かも知れませんがぜひよろしくお願いします。\n\nhttps://drive.google.com/drive/folders/1sNmSZCWAl8yH8BGrUeZIBfOKI0W2Xtfy", "nc": 16, "word_count": 0, "transcoder": "image", "