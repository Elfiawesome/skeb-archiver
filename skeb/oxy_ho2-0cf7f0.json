部屋の中で外の夜景を見ながら、自身のアーツで手元に小さいガラス細工を作りながら何か考えに耽っているミステリアスな雰囲気で。\nその他細かい部分はoxy先生にお任せいたします。\n\nよろしければ、ご検討の程よろしくお願い致します！", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@oxy_ho2/works/14", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2071398, "client_id": 1871745, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/a94bfa23/uploads/origins/ca524e45-448f-468a-b33c-b85677606797?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e21cc8110ca03601a5dd81dbbf799e7d", "srcset": "https://si.imgix.net/a94bfa23/uploads/origins/ca524e45-448f-468a-b33c-b85677606797?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e21cc8110ca03601a5dd81dbbf799e7d, https://si.imgix.net/a94bfa23/uploads/origins/ca524e45-448f-468a-b33c-b85677606797?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=2fa581370c7a85ce96797a58b2bc362d 2x, https://si.imgix.net/a94bfa23/uploads/origins/ca524e45-448f-468a-b33c-b85677606797?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=dd9b454fbc1ec291e0196ae418576e97 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/a94bfa23/uploads/origins/ca524e45-448f-468a-b33c-b85677606797?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=71b850e74584a30565e96b7c6bce73d2", "srcset": "https://si.imgix.net/a94bfa23/uploads/origins/ca524e45-448f-468a-b33c-b85677606797?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=71b850e74584a30565e96b7c6bce73d2, https://si.imgix.net/a94bfa23/uploads/origins/ca524e45-448f-468a-b33c-b85677606797?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=d2b0a2781f81babaceb5a82e09d173bd 2x, https://si.imgix.net/a94bfa23/uploads/origins/ca524e45-448f-468a-b33c-b85