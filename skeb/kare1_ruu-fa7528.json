絶頂）\n・搾乳は親指人差し指中指で牛のようにガッツリ乳首を握られて搾る感じで\n　手が上にいく時は胸に手が埋まるぐらい強めに潰して頂きたいです\n\n表情、搾り手や胸の差分等がオンオフ切替可のPSDだと有難いです。(難しければ大丈夫です)\nご検討よろしくお願いします\n\n【資料まとめ】(キャラ資料等)\nhttps://drive.google.com/drive/folders/1ghATeOxpk-W0vNmxk0Hxoh6k70bayiuz?usp=drive_link", "nc": 161, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@kare1_ruu/works/2", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/15772cf1/uploads/origins/f5d39c6a-e7ef-4b7e-9755-2e0df0a57d89?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=298c0e5736d87267d3b8c275e83517e1", "srcset": "https://si.imgix.net/15772cf1/uploads/origins/f5d39c6a-e7ef-4b7e-9755-2e0df0a57d89?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=298c0e5736d87267d3b8c275e83517e1, https://si.imgix.net/15772cf1/uploads/origins/f5d39c6a-e7ef-4b7e-9755-2e0df0a57d89?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=2ecef385d448f86c01ab90cc8f685f8e 2x, https://si.imgix.net/15772cf1/uploads/origins/f5d39c6a-e7ef-4b7e-9755-2e0df0a57d89?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=25edc3870673abeeb7a21167f01509f1 3x"}, "private": true, "genre": "art", "tipped": false, "creator_id": 3783363, "nc": 161}, {"path": "/@kare1_ruu/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3783363, "client_id": 720685, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/b9299278/uploads/origins/50ef2007-3251-4569-b93e-b53f6e167f7c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit