\n・https://www.pixiv.net/artworks/98240806\nのような青肌化差分や、台詞があると大変嬉しいです。\n\nあまり描かれていないので大丈夫だとは思いますが、ふたなりはNGなのでご配慮お願いします。\n\n注文多くなってしまいましたが、癖に合わせて変更いただいても構いませんのでよろしくお願いいたします。\n\nhttps://www.takaratomy.co.jp/products/wixoss/card/card_list.php?keyword=%E5%A4%A2%E9%99%90&color=%E7%84%A1&keyword_target=%E3%82%AB%E3%83%BC%E3%83%89%E5%90%8D,%E3%83%95%E3%83%AC%E3%83%BC%E3%83%90%E3%83%BC", "nc": 161, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@gucchioverdrive/works/13", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/bd324f40/uploads/origins/a08217a9-aef6-4f5c-97e0-5779bca6d5ec?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=d1d736d53267ddbd2a90333a5326988e", "srcset": "https://si.imgix.net/bd324f40/uploads/origins/a08217a9-aef6-4f5c-97e0-5779bca6d5ec?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=d1d736d53267ddbd2a90333a5326988e, https://si.imgix.net/bd324f40/uploads/origins/a08217a9-aef6-4f5c-97e0-5779bca6d5ec?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=8594bf1b353e3da736dcc88a55bdc585 2x, https://si.imgix.net/bd324f40/uploads/origins/a08217a9-aef6-4f5c-97e0-5779bca6d5ec?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=82c04f15509f37896c209408253baccb 3x"}, "private": true, "genre": "art", "tipped": false, "creator_id": 854273, "nc": 177}, {"path": "/@gucchioverdrive/works/12", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 854273, "vtt_url": null, "thumbnail_image_urls": {"src": 