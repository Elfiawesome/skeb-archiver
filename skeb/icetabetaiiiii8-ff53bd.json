。\n\n【構図】\nhttps://skeb.jp/@icetabetaiiiii8/works/1\nこちらのイラストがとても好みで、似たような感じで描いていただけたら嬉しいです！\n血を描かれる際は赤ではなく、ショッキングピンク等でお願いいたします。\n人物と背景それぞれをPNGまたはPSDで納品いただけたら幸いです。\n\n【キャラクターについて】\n黒魔術が好きな悪魔っ子です。\nアバターのデザインや性別など、お好きにアレンジや省略等して頂いて構いません。\n参考モチーフ:骨、血、魔法陣、ロウソク、脳みそ、コウモリ、ピアス等\n\n【使用用途】\n私のSNSでのPR活動、配信時のサムネイル、グッズ用として使用させていただけたら嬉しいです。\nいずれもあいすたべたい様のイラストである事を記載いたします。\n\n以上になります。\nご検討よろしくお願いいたします。\n\n資料URL\nhttps://drive.google.com/drive/folders/1enRvUamdM32gdb4beqnF5Vc1OI7ZRMv2", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@icetabetaiiiii8/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2871268, "client_id": 1117978, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/b09915ba/uploads/origins/7906188a-52f9-4c5b-b75a-019ef6f37f07?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9035f3165c3da858aa42eb11c96a05ea", "srcset": "https://si.imgix.net/b09915ba/uploads/origins/7906188a-52f9-4c5b-b75a-019ef6f37f07?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9035f3165c3da858aa42eb11c96a05ea, https://si.imgix.net/b09915ba/uploads/origins/7906188a-52f9-4c5b-b75a-019ef6f37f07?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ee72f0b4765552247a45f4a25e139b21 2x, https://si.imgix.net/b09915ba/uploads/origins/7906188a-52f9-4c5b-b75a-019ef6f37f07?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=00af04fe1551fd797eea88252fda6d56 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/b09915ba/uploads/origins/7906188a-52f9-4c5b-b75a-019ef6f37f07?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=cfdf7e1b8944afe88d46cd6c35f88a80", "srcset": "https://si.imgix.net/b09915ba/uploads/origins/7906188a-52f9-4c5b-b75a-019ef6f37f07?bg=%23fff&auto=format%2Ccompre