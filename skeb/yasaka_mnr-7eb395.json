/skeb.jp/@heibonkaeru/works/5\nhttps://skeb.jp/@e_crsm/works/5\nhttps://skeb.jp/@miyakon22/works/27\nhttps://skeb.jp/@618kazeman/works/7\n\n10cmくらいのフィギュアを予定しており、細かいディテールは再現できないので全体のシルエット・表情・ポーズ等でキャラクターが表現されているとありがたい感じです\n\nシチュやポーズで「はいてない」「腋乳」等フェチポイントを表現してくれるとうれしいです\n\n衣服とフェチポイント以外の、キャラそのものはお任せします。\n迷ったらお好み・お得意なもの・マイキャラ等を当てはめて下さい\n\n背景はありでもなしでもOK\n\n衣装や髪の見えない方向(背中等)からのごく簡単なラフ画もあると嬉しいです\n\n出来るだけ詳しく指示を、とのご希望ですがクリエイター様のアイデアを\nお借りしたい趣旨のリクエストですので、\n個人的にお気に入りの弥栄実のイラストを3点上げさせていただきます。\nこちらのようなテイストで頂けますとありがたいです。\n\n4月29日\n【イラスト】ふわふわ黒髪ポニテが描きたかった\n\n2月22日\n【キャラデザ】猫の日\n\n1月3日\n【キャラデザ】GAO！　2022年もよろしくお願いします\n\n\nよろしければご検討お願い致します\n\nhttps://drive.google.com/file/d/1nwJ55U55jM8KS5ACtXndjRf7x9bagzGA/view?usp=sharing", "nc": 8, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@yasaka_mnr/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 923878, "client_id": 1049285, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/ee0f27cc/uploads/origins/3005aa65-1732-4884-b79e-65d76378d9e8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8fe7f23fc4df9715a605d1721d7bceef", "srcset": "https://si.imgix.net/ee0f27cc/uploads/origins/3005aa65-1732-4884-b79e-65d76378d9e8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8fe7f23fc4df9715a605d1721d7bceef, https://si.imgix.net/ee0f27cc/uploads/origins/3005aa65-1732-4884-b79e-65d76378d9e8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=31b7d7cd800287543a1ddc6d538fb938 2x, https://si.imgix.net/ee0f27cc/uploads/origins/3005aa65-1732-4884-b79e-65d76378d9e8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ed992518b5e2aa9b247cb4864bdb45c3 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/ee0f27cc/uploads/origins/3005aa65-1732-4884-b79e-65d76378d9e8?bg=%23fff&auto=f