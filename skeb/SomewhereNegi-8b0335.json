rop&crop=top&w=200&h=200&blur=200&s=563a7629ae579d8b7284bb42cac9efc0 3x"}, "body": "いつもお世話になっております。ねぎまるという者です。\nこの度はテオ様、および幽魔君、およびマスターさんにご依頼したいボイスがありリクエストを送らせていただきました。\n\n「リーチ」というセリフを三人分のボイスでお願いします。声の勢い、読み方はお任せいたします。\nシチュエーションとして参考までに、スロットゲームで二つ柄がそろって、あと一つリーチといった時に流れるような音声です。\n\nなお、本ボイスは私が作ろうと思っているテオ君のファンゲームで使用したいと思います。問題なければ依頼をうけて頂ければと思います。ボイスを使用するタイミングは、上記の状況の通りになる予定です。\n\n何卒宜しくお願い致します。", "nc": 0, "word_count": 0, "transcoder": "audio", "creator_acceptable_same_genre": true}, {"path": "/@4axf5LewQQ14/works/22", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3633635, "client_id": 2843821, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/7f4659eb/uploads/origins/b8740753-67ab-49db-8f64-727211014eb4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=740d485f70ede7267fe4416166e55f1b", "srcset": "https://si.imgix.net/7f4659eb/uploads/origins/b8740753-67ab-49db-8f64-727211014eb4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=740d485f70ede7267fe4416166e55f1b, https://si.imgix.net/7f4659eb/uploads/origins/b8740753-67ab-49db-8f64-727211014eb4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=078ac92899363ec8172bd0d06963e617 2x, https://si.imgix.net/7f4659eb/uploads/origins/b8740753-67ab-49db-8f64-727211014eb4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=227484eabd828b3d673894b6923f84eb 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/7f4659eb/uploads/origins/b8740753-67ab-49db-8f64-727211014eb4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3630621755992247a6e8c3f83197d755", "srcset": "https://si.imgix.net/7f4659eb/uploads/origins/b8740753-67ab-49db-8f64-727211014eb4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3630621755992247a6e8c3f83197d755, https://si.imgix.net/7f4659eb/uploads/origins/b8740753-67ab-49db-8f64-727211014eb4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=030a8ad23096b0267cba8d4da7122e8d 2x, https://si.imgix.net/7f4659eb/uploads/origins/b8740753-67ab-49db-8f64-727211014eb4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=d7872f0f466f5b1fade9020042a9d485 3x"}, "body": "はじめまして。ねぎまるという者です。Twitter(X)でお見かけして、素晴らしすぎる女装男子を描く方だとお見受けし、こちらを送らせていただこうと思いました。\n\n———\nVtuberのテオ君(@teoteo_1031)と幽魔君のイチャイチャが見たいです。幽魔君が兄、テオ君が弟の、どちらも男の娘です。\n資料通りではなくしっかり男の子の骨格で描いて頂いて構いません。\n\n二人とも恥ずかしがりながら、服をたくし上げ、上と下を露出させている状態の姿をお願いします。参考資料を資料URLに載せておきます。\nなおこのVの方のセンシティブ絵は歓迎されておりますので、その点はご安心ください。\n\nhttps://drive.google.com/drive/folders/1H_Hi8SIBn0-ah1aymhK2QBUkj5ua59r_", "nc": 48, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@mikeli_li/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3065170, "client_id": 2843821, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/de853dc5/uploads/origins/586ab824-ad13-4e7a-84a1-73b258580228?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0b0db8aa1f4d1a962400be85d7b2458c", "srcset": "https://si.imgix.net/de853dc5/uploads/origins/586ab824-ad13-4e7a-84a1-73b258580228?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0b0db8aa1f4d1a962400be85d7b2458c, https://si.imgix.net/de853dc5/uploads/origins/586ab824-ad13-4e7a-84a1-73b258580228?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=2edcf913cf55d1870de6174b925f388a 2x, https://si.imgix.net/de853dc5/uploads/origins/586ab824-ad13-4e7a-84a1-73b258580228?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=14d6965950f23a3a70c5b5f501c392ae 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/de853dc5/uploads/origins/586ab824-ad13-4e7a-84a1-73b258580228?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=cbb96e12ba95a3aa7c50d75af12295dc", "srcset": "https://si.imgix.net/de853dc5/uploads/origins/586ab824-ad13-4e7a-84a1-73b258580228?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=cbb96e12ba95a3aa7c50d75af12295dc, https://si.imgix.net/de853dc5/uploads/origins/586ab824-ad13-4e7a-84a1-73b258580228?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=52ee36c2cb0ce9eb7f57fd05f1c21bc4 2x, https://si.imgix.net/de853dc5/uploads/origins/586ab824-ad13-4e7a-84a1-73b258580228?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=8caaccddc1eec9aedfdf93a2c783a39c 3x"}, "body": "いつも配信を楽しく観させて頂いています、ねぎまると言う者です。\nこの度は“ねぎまる”の新衣装を考えてもらいたくリクエストを送らせていただきました。\n以前ミケリリさんに描いてもらった事もあります、あの青髪で頭からネギが2本自生しているキャラクターがねぎまる(インターネットの姿)であります。\n髪型(ショート)、髪の色(薄めの青)、ネギ2本、瞳の色(青)は固定で、衣装を新しく考えてください。パーカー着用(着方は問わず)でどこかにウサギモチーフの柄が入っているというのを指定させて頂きます。\n\nかなり自由度の高いリクエストですので負担を強いてしまうかも知れませんが、何卒よろしくお願い致します。", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Tsugu_0928/works/17", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1610008, "client_id": 2843821, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/8f517fab/uploads/origins/7dec8466-8d6b-46dc-b562-5a6afed3b7ac?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4b9864108e9e2a311ed354278c7cce47", "srcset": "https://si.imgix.net/8f517fab/uploads/origins/7dec8466-8d6b-46dc-b562-5a6afed3b7ac?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4b9864108e9e2a311ed354278c7cce47, https://si.imgix.net/8f517fab/uploads/origins/7dec8466-8d6b-46dc-b562-5a6afed3b7ac?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=082fd5