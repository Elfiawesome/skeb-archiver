本人様サイトからの文章コピーになります。\n依頼をする際には、このページへのリンクまたはFANBOXのリンクを共有したのち蓮希るいのTwitterや収益化されたYoutubeチャンネルで使用される可能性があること」を依頼文で必ず伝えてください。\n\n▼skebまたは依頼したイラスト\npsdファイル/背景透過ファイルがあると嬉しいです。\nイラストレーター様に依頼していただいたイラストは活動面（サムネイル）で使用できるのでとても嬉しいです！\n\nイラストレーター様にご依頼の際は、二次創作プログラム承認済みですので「蓮希るい」の名前を使用して許可済みだということをお伝えください。\n\n長くなってしまいましたがぜひご検討のほどよろしくお願い致します！\n\nhttps://lit.link/Hasukirui", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 174933, "creator": true, "nsfw_acceptable": true, "acceptable": false, "name": "牛大福🔞", "screen_name": "ushidaihuku", "avatar_url": "https://proxy.misskeyusercontent.jp/avatar.webp?url=https%3A%2F%2Fmedia.misskeyusercontent.jp%2Fio%2Fa8fbbe49-d18c-419c-a317-f9427d6720d2.webp&avatar=1", "header_url": "https://media.misskeyusercontent.jp/io/efc0bd5c-67de-45b3-bc67-2a6d0f7137f1.png?sensitive=true", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 15, "complete_expiration_days": 30, "skills": [{"genre": "art"}], "banned": false, "nc": 48}, {"id": 379885, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "みんみん@skeb募集中", "screen_name": "shiratorikuro", "avatar_url": "https://pbs.twimg.com/profile_images/1642349284036345856/pDeHZq8x.jpg", "header_url": "https://pbs.twimg.com/profile_banners/123222901/1617290474/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "art"}, {"genre": "correction"}], "banned": false, "nc": 40}, {"id": 882386, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "𝑬𝒖𝒑𝒉𝒐𝒓𝒃𝒊𝒂🐍", "screen_name": "akatuki258", "avatar_url": "https://pbs.twimg.com/profile_images/2012856822500098048/6