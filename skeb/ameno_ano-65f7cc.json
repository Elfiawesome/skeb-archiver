bf0b-70c0-48ba-85cf-bbd4fa2c574c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=816e0364963d38f6a7253f49bf8c5131, https://si.imgix.net/bada05bc/uploads/origins/9490bf0b-70c0-48ba-85cf-bbd4fa2c574c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=97325101f76ae444de7b0977c49dc275 2x, https://si.imgix.net/bada05bc/uploads/origins/9490bf0b-70c0-48ba-85cf-bbd4fa2c574c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=c5e4a8557ea679b27a8829a256572264 3x"}, "body": "初めまして、Vtuberの犬山たまきと申します。\n素敵なイラストを拝見しまして、是非ご依頼させて頂きたくご連絡をいたしました。\n\n■イラスト内容\nVtuber「犬山たまき」のイラストを描いて頂きたいです。\n衣装が多数ございますが、先生が気に入られたお衣装で作画頂けますと大変嬉しいです。\n性別は男性で「男の娘」キャラクターとなりますので、胸の描写だけお気をつけいただけますと幸いです…！\n(見た目が女性寄りなので、無理に男性らしく描写する必要はございません…！)\n\n公式HP キャラクター紹介\nhttps://noripro.jp/talent-inuyama/\n\n■希望納品形式\nキャラクターと背景がレイヤー分けされているpsdデータで頂戴出来ますと嬉しいです。\n\n■用途\nYouTubeのサムネイルへの使用、Twitterで活動の際に使用させて頂きたいです。\n使用の際は、先生のTwitterアカウントをYouTubeの概要欄、もしくはTwitterのツイート文にクレジットさせて頂きます。\n\n■構図や要望など\nYouTubeのサムネイルに使用する為、お顔が良く見える構図だと嬉しいです。\n頭の先や髪の毛などは、先端まで切れないように作画頂けますと大変嬉しいです。\n\n何卒、よろしくお願いします！", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@ameno_ano/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2924455, "client_id": 3925800, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/4bd9ae8e/uploads/origins/44ab6881-ca59-457d-ad5c-95e051d824b9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9a9c36de2cf0103e581c8e6ee76a80c9", "srcset": "https://si.imgix.net/4bd9ae8e/uploads/origins/44ab6881-ca59-457d-ad5c-95e051d824b9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9a9c36de2cf0103e581c8e6ee76a80c9, https://si.imgix.net/4bd9ae8e/uploads/origins/44ab6881-ca59-457d-ad5c-95e051d824b9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=1e071a20ef06fe674afe01429ffc1a6b 2x, https://si.imgix.net/4bd9ae8e/uploads/origins/44ab6881-ca59-457d-ad5c-95e051d824b9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=3c37327b37519c2174821381e4180de1 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/4bd9ae8e/uploads/origins/44ab6881-ca59-457d-ad5c-95e051d824b9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d89fa33424bda4de9e28116f9df53d73", "srcset": "https://si.imgix.net/4bd9ae8e/uploads/origins/44ab6881-ca59-457d-ad5c-95e051d824b9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d89fa33424bda4de9e28116f9df53d73, https://si.imgix.net/4bd9ae8e/uploads/origins/44ab6881-ca59-457d-ad5c-95e051d824b9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=77a6a4c0a727ba5473b1eda88acf87ea 2x, https://si.imgix.net/4bd9ae8e/uploads/origins/44ab6881-ca59-457d-ad5c-95e051d824b9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=014627ed11d798ebced80aee96982595 3x"}, "body": "天乃あの様はじめまして。\nスケブでの可愛らしいイラストを拝見し、ぜひイラストを描いていただきたく、リクエストを送りました。\n\n【使用用途】 ・SNS、YouTubeなどVTuberとして活動する上でのアイコンやサムネイル、投稿への利用(𝕏、YouTube)\n\n【希望】  頭や髪の毛が見切れないようお願いしたいです。また、もし可能であればキャラと背景、サイン等のレイヤーを分けた、psdファイルもしくは透過pngファイル形式でお願いいたします。\n\n【構図など】\n構図は天乃先生にお任せします。表情はできればいたずらっぽい表情だと助かりますが、こちらもお任せいたします。\n\n【資料】\nhttps://drive.google.com/file/d/12tfnnPd5QpWsS36ssPwZWadMmGdxyoRh/view?usp=drivesdk", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@ameno_ano/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2924455, "client_id": 2974231, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/930e0ea6/uploads/origins/3c03deef-1d2b-4f03-9023-6e6e017444d3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=dd04cf0d2ee1fc9caa619bfb5baa89ca", "srcset": "https://si.imgix.net/930e0ea6/uploads/origins/3c03deef-1d2b-4f03-9023-6e6e017444d3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=dd04cf0d2ee1fc9caa619bfb5baa89ca, https://si.imgix.net/930e0ea6/uploads/origins/3c03deef-1d2b-4f03-9023-6e6e017444d3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=88749e69a10ba1dffb7d6a9a7a986a82 2x, https://si.imgix.net/930e0ea6/uploads/origins/3c03deef-1d2b-4f03-9023-6e6e017444d3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d5123bb6f3ce43b16581d3a1daf1342b 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/930e0ea6/uploads/origins/3c03deef-1d2b-4f03-9023-6e6e017444d3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=4170dea27448c2bf36304d1dd05c2898", "srcset": "https://si.imgix.net/930e0ea6/uploads/origins/3c03deef-1d2b-4f03-9023-6e6e017444d3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=4170dea27448c2bf36304d1dd05c2898, https://si.imgix.net/930e0ea6/uploads/origins/3c03deef-1d2b-4f03-9023-6e6e017444d3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=16883316ab9739b357f6620e2a7a34e6 2x, https://si.imgix.net/930e0ea6/uploads/origins/3c03deef-1d2b-4f03-9023-6e6e017444d3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=e24bc7af754ecf2ea326a6847d5354b0 3x"}, "body": "天乃あの様\n\nこんにちは、ちいちゃんと申します。\n以前より素敵なイラストを拝見させていただいておりまして、\n今回は私の推しである個人Vtuberの 天魔るる様 のイラストをリクエストさせていただきました。\nご検討頂けましたら幸いです。\n\n⚫︎参考資料 \n https://lit.link/tenmalulu\n\nhttps://drive.google.com/drive/u/0/mobile/folders/1oaMCrsAU6awD60zGtmpHykJ6OnD3xK5_?usp=drive_link\n\n⚫︎依頼内容 \n構図に関しましては、お任せいたします。\n衣装・ヘアアレンジは本人とわかる範囲であれば大丈夫です。\n頭部周辺は画面内におさまっている構図ですとありがたいです。\n\n⚫︎使用用途\n・依頼者本人の私的範囲での個人利用 \n・天魔るる様の活動での使用\n（収益化済みチャンネルでのサムネイルやSNSでの宣伝活動など）\n\n⚫︎納品形式 \n可能であればpsd、または人物のみの透過pngにてお願いいたします。人物と背景のレイヤーは分けて制作いただけますと幸いです。\n\n以上、お忙しい中恐れ入りますがご検討のほどよろしくお願いいたします。\n\nhttps://drive.google.com/drive/u/0/mobile/folders/1oaMCrsAU6awD60zGtmpHykJ6OnD3xK5_?usp=drive_link", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@ameno_ano/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2924455, "client_id": 2762843, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/34325af0/uploads/origins/7331e5b8-9b2b-4889-b6a2-e3347ce3f1b7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=38e5049e3cae576aa0c2ce770e30070c", "srcset": "https://si.imgix.net/34325af0/uploads/origins/7331e5b8-9b2b-4889-b6a2-e3347ce3f1b7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=38e5049e3cae576aa0c2ce770e30070c, https://si.imgix.net/34325af0/uploads/origins/7331e5b8-9b2b-4889-b6a2-e3347ce3f1b7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=3f2efd14fa1775dae7763551c644501c 2x, https://si.imgix.net/34325af0/uploads/origins/7331e5b8-9b2b-4889-b6a2-e3347ce3f1b7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=3da86f67de1986dc8f60398a0c769cf8 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/34325af0/uploads/origins/7331e5b8-9b2b-4889-b6a2-e3347ce3f1b7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=116853f524275c1f78ebc2861d515acb", "srcset": "https://si.imgix.net/34325af0/uploads/origins/7331e5b8-9b2b-4889-b6a2-e3347ce3f1b7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=116853f524275c1f78ebc2861d515acb, https://si.imgix.net/34325af0/uploads/origins/7331e5b8-9b2b-4889-b6a2-e3347ce3f1b7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=to