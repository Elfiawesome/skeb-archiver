Sでの宣伝活動など）\n\n⚫︎納品形式 \n可能であればpsd、または人物のみの透過pngにてお願いいたします。人物と背景のレイヤーは分けて制作いただけますと幸いです。\n\n以上、お忙しい中恐れ入りますがご検討のほどよろしくお願いいたします。\n\nhttps://drive.google.com/drive/u/0/mobile/folders/1oaMCrsAU6awD60zGtmpHykJ6OnD3xK5_?usp=drive_link", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@ameno_ano/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2924455, "client_id": 2762843, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/34325af0/uploads/origins/7331e5b8-9b2b-4889-b6a2-e3347ce3f1b7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=38e5049e3cae576aa0c2ce770e30070c", "srcset": "https://si.imgix.net/34325af0/uploads/origins/7331e5b8-9b2b-4889-b6a2-e3347ce3f1b7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=38e5049e3cae576aa0c2ce770e30070c, https://si.imgix.net/34325af0/uploads/origins/7331e5b8-9b2b-4889-b6a2-e3347ce3f1b7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=3f2efd14fa1775dae7763551c644501c 2x, https://si.imgix.net/34325af0/uploads/origins/7331e5b8-9b2b-4889-b6a2-e3347ce3f1b7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=3da86f67de1986dc8f60398a0c769cf8 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/34325af0/uploads/origins/7331e5b8-9b2b-4889-b6a2-e3347ce3f1b7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=116853f524275c1f78ebc2861d515acb", "srcset": "https://si.imgix.net/34325af0/uploads/origins/7331e5b8-9b2b-4889-b6a2-e3347ce3f1b7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=116853f524275c1f78ebc2861d515acb, https://si.imgix.net/34325af0/uploads/origins/7331e5b8-9b2b-4889-b6a2-e3347ce3f1b7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=