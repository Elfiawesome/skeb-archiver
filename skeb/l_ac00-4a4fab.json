6Xn0Hr8u-dY65rI3Sqzm4hp9W?usp=sharing\n\n▼使用用途\n・依頼した作品としてSNSでの掲載。（依頼元の明記を行います）\n・該当のフォロワーさんとの共有。\n・個人鑑賞、個人利用の範囲内での印刷やグッズ化・TRPGセッションでの利用。\n・Skeb依頼時の資料への追加。", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}], "similar_creators": [{"id": 9755, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "福之内", "screen_name": "ninomarukokuzu", "avatar_url": "https://pbs.twimg.com/profile_images/1867199559342166017/FH74Vz_W.jpg", "header_url": "https://pbs.twimg.com/profile_banners/412353019/1522633847/1500x500", "appeal_receivable": false, "popular_creator_rank": 98, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "art"}, {"genre": "comic"}, {"genre": "correction"}], "banned": false, "nc": 1}, {"id": 1366068, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "お、", "screen_name": "ooo_0926", "avatar_url": "https://pbs.twimg.com/profile_images/1976456505617678337/k4n0GrRE.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1393369213792751620/1768864254/1500x500", "appeal_receivable": true, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "art"}, {"genre": "correction"}], "banned": false, "nc": 176}, {"id": 2471317, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "和", "screen_name": "kazz8_", "avatar_url": "https://pbs.twimg.com/profile_images/1604866384944451584/GA2iOLNQ.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1577166385825783811/1716622829/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 15, "