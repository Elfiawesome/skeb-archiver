to=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=338d4e3869a111dc83afef26e825c235", "srcset": "https://si.imgix.net/69229304/uploads/origins/511bc962-efe6-4a90-8eff-3e163c849b1f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=338d4e3869a111dc83afef26e825c235, https://si.imgix.net/69229304/uploads/origins/511bc962-efe6-4a90-8eff-3e163c849b1f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=d5be6a8125870950a79db17742ba6652 2x, https://si.imgix.net/69229304/uploads/origins/511bc962-efe6-4a90-8eff-3e163c849b1f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=78d1ec862f165ac7bc73b0fca011585b 3x"}, "body": "はじめまして\n以前Twitterに投稿されていたミコッテ触手絵が非常に良かったので依頼させていただきます。\n\nFF14の自キャラを描いていただきたく存じます。\n【容姿】https://twitter.com/FanaticAura/status/1621969865191067648\n【衣装】https://twitter.com/FanaticAura/status/1632561699168591873\n【シチュエーション】\n　触手に襲われている\n　構図等はお好きなようにしていただければと存じます。\n【その他】\n　胸は控えめな設定ですが、お好みに合わせて盛る等していただければと存じます。\n　衣装指定していますがめんどくさければ全脱がしで大丈夫です。\n\n絶攻略、今からだと6.4零式等お忙しいとは存じますが、ご検討のほどよろしくお願いいたします。\n応援しております。", "nc": 41, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@sinzu_u_19/works/10", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1251187, "client_id": 1278408, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/4d0ddb45/uploads/origins/3b2fdc9f-3e6c-4215-a0cc-85b85cd7ed20?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=dec933a4127ec390e9dbdef9d990bf0f", "srcset": "https://si.imgix.net/4d0ddb45/uploads/origins/3b2fdc9f-3e6c-4215-a0cc-85b85cd7ed20?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=dec933a4127ec390e9dbdef9d990bf0f, https://si.imgix.net/4d0ddb45/uploads/origins/3b2fdc9f-3e6c-4215-a0cc-85b85cd7ed20?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=07aa4846c83530db779bc2e963ef2acb 2x, https://si.imgix.net/4d0ddb45/uploads/origins/3b2fdc9f-3e6c-4215-a0cc-85b85cd7ed20?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ecaf70a3c582419fa3faf698223adfc3 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/4d0ddb45/uploads/origins/3b2fdc9f-3e6c-4215-a0cc-85b85cd7ed20?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=078c732e7da04d897987b33f76c31ac4", "srcset": "https://si.imgix.net/4d0ddb45/uploads/origins/3b2fdc9f-3e6c-4215-a0cc-85b85cd7ed20?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=078c732e7da04d897987b33f76c31ac4, https://si.imgix.net/4d0ddb45/uploads/origins/3b2fdc9f-3e6c-4215-a0cc-85b85cd7ed20?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=ff7eda032d0cb1944922a2009f29450d 2x, https://si.imgix.net/4d0ddb45/uploads/origins/3b2fdc9f-3e6c-4215-a0cc-85b85cd7ed20?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=38eb4bff2d9968f8bb94eb5e0e57c368 3x"}, "body": "こんにちはでっす！\n三度うちの子ﾃｨｱﾁｬﾝを描いていただきたくこちらに依頼を出させてもらいました\nまたまたえっちぴくちゃ〜なのですが……\nそれと、もし余裕があれば差分をお願いしたく……\n\nここから描いていただきたい依頼の詳細です\n\nベッドの上で衣服を脱がされて、生まれたままの姿のﾃｨｱﾁｬﾝをお願いします\n資料としてリンクをはらせてもらいました\nぺたん座りみたいな感じなのですが少し脚を開いた状態にしてください\n胸はGカップ相当なので大きめに、ですが乳首乳輪まわりは小さめに\nお腹まわりにはくびれがあって、下半身は少しスリムに、そして下の毛は生やさないでください\n手の位置は資料8枚目の雪泉のようにしてもらいたいですが、左右逆にして胸元に来る手を右手にしてください\n\nもし差分を描いていただけるのであれば右手で胸を、左手ですじを隠しているものもお願いします\n\n色々細かいリクエストになってしまいましたがよろしくお願いしますm(_ _)m\n\nそれと目をお大事になさってくだされ……\nそして来たる絶、ファイトなのでっす！\n\nhttps://twitter.com/victear_231002/status/1612083875949473796?s=46&t=ncakWWx6om6KQz__RRH1ig", "nc": 160, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@sinzu_u_19/works/9", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/cf0971b1/uploads/origins/ffb59367-8733-456f-a695-ece8330fda17?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=3f2322c88ed0ceba7d375e5c4a436520", "srcset": "https://si.imgix.net/cf0971b1/uploads/origins/ffb59367-8733-456f-a695-ece8330fda17?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=3f2322c88ed0ceba7d375e5c4a436520, https://si.imgix.net/cf0971b1/uploads/origins/ffb59367-8733-456f-a695-ece8330fda17?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=adc17cf61e235fc6a628521c94ece033 2x, https://si.imgix.net/cf0971b1/uploads/origins/ffb59367-8733-456f-a695-ece8330fda17?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=08fff44f602deb723dd450fa1f772fef 3x"}, "private": true, "genre": "art", "tipped": true, "creator_id": 1251187, "client_id": 537671, "nc": 49}, {"path": "/@sinzu_u_19/works/8", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1251187, "client_id": 1278408, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/dff15691/uploads/origins/76883924-ecf7-4cdb-ab74-0de9526dab1a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8a324b1780901f841bb42bf3baf75fa5", "srcset": "https://si.imgix.net/dff15691/uploads/origins/76883924-ecf7-4cdb-ab74-0de9526dab1a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8a324b1780901f841bb42bf3baf75fa5, https://si.imgix.net/dff15691/uploads/origins/76883924-ecf7-4cdb-ab74-0de9526dab1a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f0ede80cfdad70d346cfb3323e5cbcc8 2x, https://si.imgix.net/dff15691/uploads/origins/76883924-ecf7-4cdb-ab74-0de9526dab1a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=7e4d3548fd2c905e4ff2b806a56f9359 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/dff15691/uploads/origins/76883924-ecf7-4cdb-ab74-0de9526dab1a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=de5e89880884c4444aeb51334d1ae9ff", "srcset": "https://si.imgix.net/dff15691/uploads/origins/76883924-ecf7-4cdb-ab74-0de9526dab1a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=de5e89880884c4444aeb51334d1ae9ff, https://si.imgix.net/dff15691/uploads/origins/76883924-ecf7-4cdb-ab74-0de9526dab1a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=440d14c8e03132bcff0e319bcf4a0518 2x, https://si.imgix.net/dff15691/uploads/origins/76883924-ecf7-4cdb-ab74-0de9526dab1a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=94de130295401dba5ae1bf61763eeaf9 3x"}, "body": "こんにちはですの\n再びうちの子を描いていただきたく依頼を出します。\nバニー姿のﾃｨｱﾁｬﾝが転んだ拍子に胸に触られてしまうラッキースケベられるシーンをお願いします。胸の部分は、はだけさせてください。やわらかおっぱいを拝みたいですし……(あとﾃｨｱﾁｬﾝならなんかそうなることもあるので)\n胸はGカップ設定なので大きめで、下半身は比較的スラッとさせてください。\nﾃｨｱﾁｬﾝの左右どちらかのおっぱいを誰かの手がガッシリ掴んでしまっていて、ﾃｨｱﾁｬﾝは困惑と恥ずかしさのあまり顔を紅潮させて、ぐるぐる目に涙を浮かべさせてください。\nポーズは転んだ状態ですのでﾃｨｱﾁｬﾝは仰向けな感じですがそれ以上は特に要望がないのでおまかせいたします。\nバニー服なんですが、FFのものではなくURLに記載した参考資料の4~6枚目のものを着せてください。(リボンについてはモデルの彼女のものなので除外してください)\n1~3枚目には念の為、ﾃｨｱﾁｬﾝの全体像と顔のアップを置いておきましたのでよければ……\n\nいろいろとお忙しいとは思いますが、よろしくお願いします。\n(零式頑張って‼️)\n\nhttps://twitter.com/victear_231002/status/1554465052971134979?s=21&t=KcXSqnbFIH3U4Oy1F-qKmg", "nc": 161, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@sinzu_u_19/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1251187, "client_id": 1278408, "vtt_url": null, "thumbn