んにプレゼントする為の衣装デザインをご依頼したいと思います。三面図ではなく、一般的なイラストでも大丈夫であり、ポーズや構図はお月見さんにお任せ致します。\n\nデザインについては一番難しい注文だとご存知ですが、「お二人に似合うそうな」デザインを全面的にお月見さんの判断に任せたいと思います。二人同じデザインでアレンジだけ違うものでもいいし、全く違う別デザインでもいいです：）\n\n自分での3D化作業後、プレゼントしたモデルが実際配信で使用される可能性があり、デザインの活用についての許可を得ることができれば幸いです。曖昧なリクエストで申し訳ございませんが、どうか楽しく作業していただけると嬉しいです。よろしくお願い致します。", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@ochi_curry/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2238486, "client_id": 2620993, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/9a52d4c7/uploads/origins/45ba2ac6-b851-4fd1-8e6f-5ad779e9bbe6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f58993c77bf03ea30f7a47ef1ded1cab", "srcset": "https://si.imgix.net/9a52d4c7/uploads/origins/45ba2ac6-b851-4fd1-8e6f-5ad779e9bbe6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f58993c77bf03ea30f7a47ef1ded1cab, https://si.imgix.net/9a52d4c7/uploads/origins/45ba2ac6-b851-4fd1-8e6f-5ad779e9bbe6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a1f4173092fc735f7fa4c6ce983b7ca7 2x, https://si.imgix.net/9a52d4c7/uploads/origins/45ba2ac6-b851-4fd1-8e6f-5ad779e9bbe6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f05905eb8decbd57cfccb2c476b50570 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/9a52d4c7/uploads/origins/45ba2ac6-b851-4fd1-8e6f-5ad779e9bbe6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6e2eec91433c0f470a6ee0821e57195d", "srcset": "https://si.imgix.net/9a52d4c7/uploads/origins/45ba2ac6-b851-4fd1-8e6f-5ad779e9bbe6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6e2eec91433c0f470a6ee0821e57195d, https://si.imgix.net/9a52d4c7/uploads/origins/45ba2ac6-b851-4fd1-8e6f-5ad779e9bb