ff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=85dd5706e16cf0c91e3bbc82158d8ee8 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/1c77fbae/uploads/origins/b7643bb2-1917-4c98-8f6a-50fe85aa00c6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=bb753ec4d7f41f81d8016bdfb78003cf", "srcset": "https://si.imgix.net/1c77fbae/uploads/origins/b7643bb2-1917-4c98-8f6a-50fe85aa00c6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=bb753ec4d7f41f81d8016bdfb78003cf, https://si.imgix.net/1c77fbae/uploads/origins/b7643bb2-1917-4c98-8f6a-50fe85aa00c6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=d393eb84a446b1fc194a106773a4c25b 2x, https://si.imgix.net/1c77fbae/uploads/origins/b7643bb2-1917-4c98-8f6a-50fe85aa00c6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=34e58d0072af2b98b2c8e9ab7fa05049 3x"}, "body": "菊一もちこ様前回は素晴らしい肥満化イラストありがとうございました\n今回は前回の続きでデブエット企画大ヒット御礼prイベントに出た紡乃世詞音と東北イタコを描いて貰いたいです。\n内容は資料の動画の48:20〜52:23あたりの様に\n以前の体型の等身大パネルと今の太った本人達が並ぶ構図でお願いします。等身大パネルは前回のデブエット開始時と半年の中間発表の2枚づつで、衣装はデブエット後の本人達は前回の水着で以前の体型のパネルはダイエット番組等で使われる黒のスポブラとレギンスでお願いします。\n表情は二人とも、前回同様企画開始時はやる気満々で半年後は太った事をとても恥ずかしがっており、そしてデブエット後の本人達は吹っ切れて堂々としている表情でお願いします。またポーズは以前の体型のパネルは2枚とも直立で、現在の太った二人は真ん丸なお腹を強調させたセクシーなポーズをとっている物でお願いします\nまた、前回は二人が重なり少し隠れている部分があった為今回は出来れば両者共に少し離れ重なる部分が無い構図でお願いします（無理な場合は今回は紡乃世詞音を前にして欲しいです）。また可能ならパネルなし差分をお願いしたいです。\n前回に引き続き多くの事を依頼し申し訳ありません。ご一考のほどお願いします\n\nhttps://m.youtube.com/watch?v=DfE5nHpYEnE", "nc": 33, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@kikuichi_mochi/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1716970, "client_id": 3485107, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/1a4bd04c/uploads/origins/2d1abfd0-14ef-405c-8608-c48827c7dc44?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=42621d99014362a33a06a68f8662b66d", "srcset": "https://si.imgix.net/1a4bd04c/uploads/origins/2d1abfd0-14ef-405c-8608-c48827c7dc44?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=42621d99014362a33a06a68f8662b66d, https://si.imgix.net/1a4bd04c/uploads/origins/2d1abfd0-14ef-405c-8608-c48827c7dc44?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b1c58c0ee3a1e8269914901fe4bd59ac 2x, https://si.imgix.net/1a4bd04c/uploads/origins/2d1abfd0-14ef-405c-8608-c48827c7dc44?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=25f35a73172751a40ef9fd394b3d2dd7 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/1a4bd04c/uploads/origins/2d1abfd0-14ef-405c-8608-c48827c7dc44?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=8bf5b5f472331df8344782e5c3de6ff7", "srcset": "https://si.imgix.net/1a4bd04c/uploads/origins/2d1abfd0-14ef-405c-8608-c48827c7dc44?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=8bf5b5f472331df8344782e5c3de6ff7, https://si.imgix.net/1a4bd04c/uploads/origins/2d1abfd0-14ef-405c-8608-c48827c7dc44?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=774dc6d935f81fb5b685388b21d36b23 2x, https://si.imgix.net/1a4bd04c/uploads/origins/2d1abfd0-14ef-405c-8608-c48827c7dc44?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=99ae92c6d639d905cd99ab1c1674efca 3x"}, "body": "菊一もちこ様初リクエスト失礼します\nA.I.VOICE紡乃世詞音とvoiceroid東北イタコの肥満化をお願いします。\n内容はタレントの紡乃世とイタコがテレビの企画で1年間デブエットをするという物で最初の体型→中間発表→最終結果のイラストを二人並んだ状態で描いて貰いたいです\n開始時:衣装は公式衣装で二人とも巨乳でボンキュボンのナイスバディ。両者頑張ると意気込みを発表する。\n半年後の中間発表:両者+30kg増量。テレビの企画で開始時の衣装に生着替えするが二人とも太って着れず顔から火が出るほど恥ずかしがる。\n1年後:中間発表後から両者共に+50kg増量。番組が用意した水着に着替えているが、二人とも吹っ切れて堂々とし、ノリノリでポーズを決める（水着はイタコ