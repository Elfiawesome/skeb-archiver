"畑みかん様の萃香ちゃんの設定画のイラストから伺いました！可愛らしい表情とやわらかそうなお顔がすごく自分好みで、ぜひ依頼をお願いしたいです！\n\nお酒に酔っ払って服がややはだけた状態で「(お酒)を飲む？」みたいにうっすらした目ではにかみながら誘惑ともお誘いともつかない状態でこっちに声をかけてる萃香ちゃんを是非見てみたいです。原作の衣装ではだけるのが難しそうならオリジナルの着物に変えてください。\n\n先の依頼イラストほかを見た上で境界が把握できなかったため、上記内容が該当しそうならスルーして下さい…！ご一考頂ければうれしいです…！", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@htk_mikan/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 116427, "client_id": 61671, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/041b5631/requests/61519_1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8ba3167648cb9fa33e66888b2a7b138f", "srcset": "https://si.imgix.net/041b5631/requests/61519_1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8ba3167648cb9fa33e66888b2a7b138f, https://si.imgix.net/041b5631/requests/61519_1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b5a3e778db755ebf7251716b37aa6648 2x, https://si.imgix.net/041b5631/requests/61519_1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=58adeb25687b1f1350136da1f028a31a 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/041b5631/requests/61519_1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ae6004bdb718a6b12ceddf3c06bfc3c4", "srcset": "https://si.imgix.net/041b5631/requests/61519_1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ae6004bdb718a6b12ceddf3c06bfc3c4, https://si.imgix.net/041b5631/requests/61519_1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=7c328239fdba308701fc87a4e4ed86ca 2x, https://si.imgix.net/041b5631/requests/61519_1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=1a2544a6cdc919b8a8e3dd7f209f547f 3x"}, "b