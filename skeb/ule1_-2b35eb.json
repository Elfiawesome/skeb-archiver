9194-dcc85a8a00c5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1ee82e3bbc1f1fbf8edd3314f8b8038c, https://si.imgix.net/b99d3efe/uploads/origins/b731dc08-2a1e-4765-9194-dcc85a8a00c5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=14e97ddc4847357b7e92cb958da361dc 2x, https://si.imgix.net/b99d3efe/uploads/origins/b731dc08-2a1e-4765-9194-dcc85a8a00c5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=2283f394c616feef220152a779931194 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/b99d3efe/uploads/origins/b731dc08-2a1e-4765-9194-dcc85a8a00c5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d42befb05f593df9af51c2d2970162a6", "srcset": "https://si.imgix.net/b99d3efe/uploads/origins/b731dc08-2a1e-4765-9194-dcc85a8a00c5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d42befb05f593df9af51c2d2970162a6, https://si.imgix.net/b99d3efe/uploads/origins/b731dc08-2a1e-4765-9194-dcc85a8a00c5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=080708101470fcea570ee3e9b8c8ccab 2x, https://si.imgix.net/b99d3efe/uploads/origins/b731dc08-2a1e-4765-9194-dcc85a8a00c5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=4a5b00a58a1cbc52bd0f697036237f4d 3x"}, "body": "うい様\n\n初めまして！\nXにてSkebの募集ポストを拝見し、うい様の描く空気感が非常に好みだった為、この度リクエストさせていただきます。\nCoCシナリオ「四季送り」の、自探索者（HO弐 夏）と公開NPC神凪蠱毒のイラストをお願いしたいです。\n\n✦・┈┈┈┈┈┈┈┈┈┈┈┈┈┈┈┈┈・✦\n\n自探索者について\n\n名前：夕凪\n性別：男\n年齢：22歳\n身長：175cm\n職業：甘味処店員 兼 殺し屋\nモチーフ：花火、夕焼け\n性格：可愛いものが好きでレディース服を好んで着る男。かなり華奢で中性的な顔立ちをしており、パッと見女性に間違われることも多い。人当たりが良く、いつでも笑顔。軽口を叩いたり人を揶揄ったりすることも好きで、男女問わず人を軽率に口説く人たらし且つ、かなり遊び人。\n見た目の特徴：頭の上のアホ毛がハートで、頬にハートマークのフェイスペイントがあります。\n\n✦・┈┈┈┈┈┈┈┈┈┈┈┈┈┈┈┈┈・✦\n\nまた、うい様が四季送り通過済みとお見受けしたため、二人の関係性や秘匿内容を含む補足資料を別途用意しております。お手数ですが、下記URLをご確認いただけますと幸いです。（私の思い違いであった場合には、リクエストごと棄却してくださると幸いです。すみません……！）\nHO夏秘匿バレあり：https://fse.tw/4PIM6DdQ\n\n構図やシチュエーション、表情、雰囲気などはすべておまかせいたします。二人らしい空気感を感じられる一枚にしていただけたら嬉しいです。\n\n使用用途は個人鑑賞やSNSでのアイコン使用です。可能であればPCのデスクトップ壁紙としても使用したいため、横長のイラストでご制作いただけますと幸いです。（難しい場合はお気になさらなくて大丈夫です！）\n\n資料に不備がある場合や、金額に不足がございましたら、お手数ですが一度再送申請をいただけますと幸いです。\n\nご縁がありましたら、どうぞよろしくお願いいたします！\n\nhttps://drive.google.com/drive/folders/1BlDvgke-MBQOmAEs6WVnuEZIBa8dO06N", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@ule1_/works/9", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3713775, "client_id": 1473258, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/4968fe58/uploads/origins/23c30378-b3fd-4f1d-b65b-e6db1511ec54?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=844865ebeee98f3b7c49e69348d78ec6", "srcset": "https://si.imgix.net/4968fe58/uploads/origins/23c30378-b3fd-4f1d-b65b-e6db1511ec54?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=844865ebeee98f3b7c49e69348d78ec6, https://si.imgix.net/4968fe58/uploads/origins/23c30378-b3fd-4f1d-b65b-e6db1511ec54?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=16407a18b8d50d540c48b36b41b718fe 2x, https://si.imgix.net/4968fe58/uploads/origins/23c30378-b3fd-4f1d-b65b-e6db1511ec54?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d9f552e705a0b23c692ca72988f488d8 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/4968fe58/uploads/origins/23c30378-b3fd-4f1d-b65b-e6db1511ec54?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=61130cd9ae9dafa6436c0084371d7f8a", "srcset": "https://si.imgix.net/4968fe58/uploads/origins/23c30378-b3fd-4f1d-b65b-e6db1511ec54?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=61130cd9ae9dafa6436c0084371d7f8a, https://si.imgix.n