webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=070bc11128cc4708669d48d72c502b88 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/a0b1ec2a/uploads/origins/386c9c0c-1ac1-4faf-b942-7042c405511d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=23836ec96e5872ca552d43deccf64190", "srcset": "https://si.imgix.net/a0b1ec2a/uploads/origins/386c9c0c-1ac1-4faf-b942-7042c405511d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=23836ec96e5872ca552d43deccf64190, https://si.imgix.net/a0b1ec2a/uploads/origins/386c9c0c-1ac1-4faf-b942-7042c405511d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=9f7fa06c1797d92929d2d7d6542800ce 2x, https://si.imgix.net/a0b1ec2a/uploads/origins/386c9c0c-1ac1-4faf-b942-7042c405511d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=6edf63e4bde1fd44a1534935c04e0ed3 3x"}, "body": "初めまして、春の季語と申します。\n\nXで公開されているイラストを拝見し、かわいい絵柄がとても素敵で、ぜひお願いしたいと思いリクエストを送らせていただきました。\n\nリクエスト内容としては、私がTRPGで使用しているOCを描いていただけたら嬉しいです。\n「四季送り」のHO春のキャラクターですが、ネタバレ要素はございません。\n\n名前は「落花（らっか）」です。\n\n感情自体は豊かなのですが、表情や声には少し出にくく、どこかのんびりした天然気味の性格をしています。ノリも良く、写真を撮る際には無表情のままギャルピースをしてくれるような子です。\n\n性別は女の子ですが、全体的に中性的な雰囲気で描いていただけると嬉しいです。\n\n外見の特徴として、\n\n・口元の左側に大きな切り傷の痕があり、えくぼ付近まで裂けています。\n・そのため、普段は布で口元を隠しています。\n\n服装は資料のままでももちろん嬉しいですし、かっこいい服やかわいい服など、うい様のイメージで自由にアレンジしてほしいです！おまかせです！\n\n使用用途については、\n\n・個人鑑賞\n・SNSアイコンやヘッダー\n・友人への共有\n・個人使用の範囲でのグッズ化\n\nなどを想定しております。\nいずれも非商用利用の範囲となります。\n\nご縁がありましたら、ぜひよろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/1hckoidP8G2GUgTz88cTXPUkg2uOqIouP?usp=sharing", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@ule1_/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3713775, "client_id": 3943990, "vtt_url": null, "thumbnail_image_urls": {"src": "https