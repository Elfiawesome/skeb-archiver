7c4-821b-de0e11e9fba9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=ab56d447469803e52fde03546862214c 3x"}, "body": "mizutakuさん、いつもありがとうございます！\n\nいつものタコちゃんをまたリクエストさせてください！\nhttps://drive.google.com/drive/u/2/folders/1AEmjZ7J9TUzfe9fS2CZpyU67XJVhMl1q\n\n海沿いにあるカフェのテラスにある椅子（リゾート地によくあるハンモック型の椅子か、背もたれの角度が強く寝てくつろげるような椅子）で休んでいて、\n暑そうにしているシーンをお願いしたいです。\n乾燥したり暑いのが苦手なので、大きめのパラソルで日陰を作ってほしいです\nhttps://drive.google.com/drive/u/2/folders/1yCQhV8ttZaVgHQKSYQqMJ4C64uZjZJUL\n\n小魚やエビなどの魚介がトッピングされたアイスクリームパフェをもっているか、テーブルに置いておいてほしいです。\n\n楽しみにしております。\nご検討よろしくお願いしますmm", "nc": 49, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@mzsuitaku/works/14", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 656796, "client_id": 2506564, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/7c89fb85/uploads/origins/ef1c12c9-8cc8-4f1f-8e92-b743a016979c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=55de620cc7cce6bdf2e22f993c7d6902", "srcset": "https://si.imgix.net/7c89fb85/uploads/origins/ef1c12c9-8cc8-4f1f-8e92-b743a016979c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=55de620cc7cce6bdf2e22f993c7d6902, https://si.imgix.net/7c89fb85/uploads/origins/ef1c12c9-8cc8-4f1f-8e92-b743a016979c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=28b1a9710f7114d11470f75edd4f63bb 2x, https://si.imgix.net/7c89fb85/uploads/origins/ef1c12c9-8cc8-4f1f-8e92-b743a016979c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=8d70cbc943f5563f8f8425794b3a9638 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/7c89fb85/uploads/origins/ef1c12c9-8cc8-4f1f-8e92-b743a016979c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6e107cb27e9d1614a6318d4862c48047", "srcset": "https://si.imgix.net/7c89fb85/uploads/origins/ef1c12c9-8cc8-4f1f-8e92-b743a016979c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6e107cb27e9d1614a6318d4862c48047, https://si.imgix.net/7c89fb85/uploads/origins/ef1c12c9-8cc8-4f1f-8e92-b743a016979c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=68fde7bdcc2626d9d1c9e03d6ba957fa 2x, https://si.imgix.net/7c89fb85/uploads/origins/ef1c12c9-8cc8-4f1f-8e92-b743a016979c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=0a9a3da69ac365e3646a3e92b822011c 3x"}, "body": "こんばんは。\n新着でお見かけして反射で宝石のように光輝くラミアの鱗に惹かれてまたリクエストしたくなりました！\n\n⚫︎描いて欲しいキャラ\n\nラミア\n\n<外見ポイント>\n・基本ベースはおまかせ\n(セクシーな大人を目指そうと頑張っているがどうしても可愛いが勝ってしまうといったような雰囲気)\n\n・巨乳\n\n・髪型(腰からお尻くらいのロングヘア)※銀髪\nhttps://drive.google.com/file/d/1nvIDNYpzssxmp0kkwWvi1XRizwktEh3N/view?usp=drivesdk\n\n・衣装(ネグリジェ)\nhttps://drive.google.com/file/d/11jxwN-WX12b4lnNIfZhK0qPwbjdocMru/view?usp=drivesdk\n※透け感を強調して欲しいです！\n\n・蛇体は長大かつ肉厚感を重視していただけたら嬉しいです！\nhttps://drive.google.com/file/d/19PGiJVoA_W160jYqm1jnPLjjYrbojTq1/view?usp=drivesdk\n\n\n\n⚫︎描いて欲しいシチュエーション\n\n・背景\nhttps://drive.google.com/file/d/1EP5X4BFAPoyknQ2m8D-_ykMZByCCm_WQ\n※参考イメージなので厳しいところがあれば調整いただいても大丈夫です！\n※クマのぬいぐるみなどたくさん置いてあったらあったら可愛いとセクシー？を兼ね備えてて良さそうかなと…！\n\n・ベッドの上で寝転がるラミアを描いていただきたいです！\n※とぐろを巻いた状態ではなくダランと寝転んでいる感じ\n\n・蛇体の一部がベッドからはみ出てベッドのカーテンが尻尾の上に垂れていたら最高です！\n\n・窓から光が差して鱗が反射しているポイントがあると嬉しいです！\n\n\n\n\nご検討のほどよろしくお願いします！", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@mzsuitaku/works/13", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 656796, "client_id": 1523235, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/08b79b29/uploads/origins/5c03ef50-5022-41f7-808c-4ffdcfadc6f6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7b0c8d0477fb1b3e5fab9822bfdcb5c5", "srcset": "https://si.imgix.net/08b79b29/uploads/origins/5c03ef50-5022-41f7-808c-4ffdcfadc6f6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7b0c8d0477fb1b3e5fab9822bfdcb5c5, https://si.imgix.net/08b79b29/uploads/origins/5c03ef50-5022-41f7-808c-4ffdcfadc6f6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=dbb97ebfa664afdd75fc1f750c8881f2 2x, https://si.imgix.net/08b79b29/uploads/origins/5c03ef50-5022-41f7-808c-4ffdcfadc6f6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=1645e7a6918855ab145518925184a9b2 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/08b79b29/uploads/origins/5c03ef50-5022-41f7-808c-4ffdcfadc6f6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d038aaa08b6511483ec0415c15807233", "srcset": "https://si.imgix.net/08b79b29/uploads/origins/5c03ef50-5022-41f7-808c-4ffdcfadc6f6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d038aaa08b6511483ec0415c15807233, https://si.imgix.net/08b79b29/uploads/origins/5c03ef50-5022-41f7-808c-4ffdcfadc6f6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=ae2d930b34cdcb8cb926345982b3d7ef 2x, https://si.imgix.net/08b79b29/uploads/origins/5c03ef50-5022-41f7-808c-4ffdcfadc6f6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=f773e9b78178a07d86c2218008f5892d 3x"}, "body": "はじめまして、mizutaku様の描くモンスター娘を見て絵柄に惹かれました。もしよろしければ私のOCの竜のアノスを描いていただけませんでしょうか？\n\n【アノス】\n・白髪・青目\n・翼と尻尾は身体の一部なので描いて欲しい\n・翼の内側は銀河のような柄\n・腕翼は手として使うこともできる\n・人間の耳は描かないでください（角が聴覚器官）\n・角は後ろに流れるようにして生えています\n・左目は失明しているので目のハイライトを消してください。色を暗くしたりはしないで下さい\n・竜なので目は縦割れ瞳孔\n・胸は小ぶりのまま、盛らないで欲しいです\n・竜の部分（角・腕翼・尻尾）は重金属のような質感でお願いしたいです\n・身長160cm\n・体重530kg（角翼尻尾込み）\n\n【設定】\n・魔獣なので性格は凶暴で根は邪悪、知能はとても高い。お気に入りの生物以外は下等生物としてしか見てない\n・危険性は天災並（火山噴火とか地震並）、常に瘴気を放っていて生物には超有毒、対策なしで触れ続けると数分で絶命する（人間形態時には出ない）\n・時々人の姿になって遊んでいる、あまり合わせる気がないので竜の部分を多く残している\n・体温は異常に低く-200度、気温も低温を好む\n・闇魔法で、ブラックホールのような物を作り周囲の熱などを消し去って超低温の環境を作ったり、重力を捻じ曲げて飛び立ちやすくしたりしている\n・闇魔法に特化する代わりに他系統の魔法全てが使えない、不便だが本竜はあまり気にしてない（魔力流すだけで使える道具系も闇以外使用不可）\n・腕翼は普通の腕としても使える、爪は鋼鉄も紙の様に切り裂ける\n・貴金属や黄金などのキラキラした物は巣に溜め込み、床に敷いてベッドにしてる\n・産みの父親を除けば世界一強い\n\n\n・歩いているところor空を飛んでいるところを描いて欲しいです。\n・表情は可能ならかっこいい系で描いて欲しいです。\n\n以上になります、よろしくお願いいたします\n\nhttps://drive.google.com/drive/folders/1xdOR4d6BOPDWP0Q1o5jO_eFl8LeA4lnx?usp=drive_link", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@mzsuitaku/works/12", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 656796, "client_id": 34261, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/b3adc8b6/uploads/origins/9fb49b01-8897-437d-9d44-3506e348de81?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5dd46eadaa91d912641cc4e71966fb62", "srcset": "https://si.imgix.net/b3adc8b6/uploads/origins/9fb49b01-8897-437d-9d44-3506e348de81?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5dd46eadaa91d912641cc4e71966fb62, https://si.imgix.net/b3adc8b6/uploads/origins/9fb49b01-8897-437d-9d44-3506e348de81?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e27e4ffeeac6d099cbac26610d6cd042 2x, https://si.imgix.net/b3adc8b6/uploads/origins/9fb49b01-8897-437d-9d44-3506e348de81?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=2dd550b8c32af7312692fc8e8ec47e2e 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/b3adc8b6/uploads/origins/9fb49b01-8897-437d-9d44-3506e348de81?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b846fbadd0cc04faa4367353acf9e9a1", "srcset": "https://si.imgix.net/b3adc8b6/uploads/origins/9fb49b01-8897-437d-9d44-3506e348de81?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b846fbadd0cc04faa4367353acf9e9a1, https://si.imgix.net/b3adc8b6/uploads/origins/9fb49b01-8897-437d-9d44-3506e348de81?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=55769c2a04b222f9e3bf8cbafd996143 2x, https://si.imgix.net/b3adc8b6/uploads/origins/9fb49b01-8897-437d-9d44-3506e348de81?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=05f4e8e87592ed194e7c320faa028015 3x"}, "body": "mizutaku様、はじめまして！百合栖てぃあと申します。\nこちら（https://skeb.jp/@mzsuitaku/works/11）で拝見したラミアちゃんのイラストでmizutaku様の絵柄に一目惚れし、是非リクエストさせていただきたく参りました！！\n御一考の程、よろしくお願いします！\n\n◆キャラクター\nうちの子「ルシェート・プルメリネ」をお願いします！\nおっぱいのおっきなケモ耳ラミアで、天真爛漫な人懐っこさと小悪魔的な性格を兼ね備えるお姫様です。\n詳細は資料URLを参照ください。\n\n◆衣装\nルシェートには全部で「11種」の衣装が存在するのですが、mizutaku様が好まれた衣装で描いてください！\nまた、どの衣装を選ばれた場合でも「ラミア」の姿でお願いしたいです！\n各種衣装のデザインについても資料URLから参照願います！\n\n◆シチュエーション\nルシェートには小さい頃から大好きな先生（https://www.pixiv.net/artworks/95885773）をお膝に乗せたり、尻尾で抱き抱えることが癖になってるのですが、深く考え事をしているときにその癖が無意識のうちに出てしまって獣耳がぴょこぴょこ、尻尾がそわそわと揺らめいてるカワイイ光景をイラストにしていただきたいです！\nまたは先生には内緒で先生の等身大か小さな人形を作っていて、それを無意識に抱いてしまってる感じとか…！\n\nイラストにおける背景の例ですが、中世的なファンタジーの冒険者用宿というイメージで、友人たちと宿泊している大きな共用スペースのソファにルシェートが座ってる感じでお願いしたいです。\n構図などはmizutaku様におまかせします！衝動的なシチュエーション全振りなため難しかったら申し訳ございませんが、なにとぞ……！\n\nまた、ルシェートの122センチQカップのデカ乳や肉感的な肢体、おっきなラミア尻尾は可能な限り強調して描いていただけたら嬉しいです！\n改めて御一考の程、よろしくお願いします……！\n\nhttps://www.pixiv.net/artworks/81537442", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@mzsuitaku/works/11", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 656796, "client_id": 2506564, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/a0744ef0/uploads/origins/5bf0d40b-4429-44d3-82a5-7b2cca58db80?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d33d5f6bf023f4c8d767125febf71c35", "srcset": "https://si.imgix.net/a0744ef0/uploads/origins/5bf0d40b-4429-44d3-82a5-7b2cca58db80?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d33d5f6bf023f4c8d767125febf71c35, https://si.imgix.net/a0744ef0/uploads/origins/5bf0d40b-4429-44d3-82a5-7b2cca58db80?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=4ad3d348296d72d392bb832ba19b1cb8 2x, https://si.imgix.net/a0744ef0/uploads/origins/5bf0d40b-4429-44d3-82a5-7b2cca58db80?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=000f77f0a59695670e79e919960d5e06 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/a0744ef0/uploads/origins/5bf0d40b-4429-44d3-82a5-7b2cca58db80?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5f71c7ecc2f1082e9a4f8062a1ae16aa", "srcset": "https://si.imgix.net/a0744ef0/uploads/origins/5bf0d40b-4429-44d3-82a5-7b2cca58db80?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5f71c7ecc2f1082e9a4f8062a1ae16aa, https://si.imgix.net/a0744ef0/uploads/origins/5bf0d40b-4429-44d3-82a5-7b2cca58db80?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=7db0e84e2a03a62385ed3ec4ecaca0e3 2x, https://si.imgix.net/a0744ef0/uploads/origins/5bf0d40b-4429-44d3-82a5-7b2cca58db80?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=c159f9bcbcd96eeea480cc54ac2ac379 3x"}, "body": "こんばんは、初めまして。\n新着でお見かけしてラミアの肉厚感と鱗1枚1枚の丁寧さに惚れ惚れしました！\n\n\n★描いて欲しいモンスター娘\n\nラミア\n\n→基本ベースはおまかせ(希望ポイント：巨乳タイプ)\n\n→髪型は名前が分からなかったためゲームキャラからですみませんが…\nhttps://i.imgur.com/vkDOmNA.jpeg\nこのように後ろは太めのロング三つ編みという髪型でお願いします！\n(三つ編みは膝に届くくらいの長さ)\n\n・外見の大まかなイメージ\n下半身の蛇体の模様・体色：\nhttps://i.imgur.com/vpeP1vF.jpeg\n\n・衣装(上)：\nhttps://i.imgur.com/FxQAoBB.jpeg\n\n・衣装(下)：\nhttps://i.imgur.com/nSqr0dh.jpeg\n↑腰布にざっくりとスリットが入ってたら嬉しいです。\n\n→衣装はこの2つを組み合わせていただけたら幸いです！\n→腕に巻いているストールのようなものはモコモコしたものか薄い布かどちらにするかはおまかせします！\n\n\n\n\n\n\n★描いて欲しいシチュエーション\n\n\n開放感のある縁側とかウッドデッキにてお酒を飲んでいるラミアというシチュエーションをお願いしたいです！\n\n\n・背景の例\nhttps://i.imgur.com/PVnlLUU.jpeg\n→和風ファンタジー的な雰囲気でお願いします。\n\n\n・上半身ポーズのサンプル\nhttps://i.imgur.com/6NXDifF.jpeg\nhttps://i.imgur.com/laIj7CA.jpeg\n→とぐろを巻いた蛇体の上に乗る形で酒を飲んでだらけている感じ\n→片手に酒器を持っている\nhttps://i.imgur.com/Byqwqfa.jpg\n\n→長い髪や腕のストール(？)が蛇体を伝って垂れている感じもお願いできたら嬉しいです！\n\n\n・下半身(蛇体)の参考図\nhttps://i.imgur.com/3lZrF1v.jpeg\n→尻尾で酒壺を掴んでお酒を注いでいる\nhttps://i.imgur.com/wXfnPVA.jpg\n\n\n\nご検討のほど宜しくお願いします！", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@mzsuitaku/works/10", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 656796, "client_id": 1693343, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/f7e1a745/uploads/origins/6c5a503f-5850-4491-adff-cd1e4d419aea?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8b6ebb2d281a89734885f4a29d3910dc", "srcset": "https://si.imgix.net/f7e1a745/uploads/origins/6c5a503f-5850-4491-adff-cd1e4d419aea?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8b6ebb2d281a89734885f4a29d3910dc, https://si.imgix.net/f7e1a745/uploads/origins/6c5a503f-5850-4491-adff-cd1e4d419aea?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c26a03cefeec70f253bf98b8bc026223 2x, https://si.imgix.net/f7e1a745/uploads/origins/6c5a503f-5850-4491-adff-cd1e4d419aea?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f0fd5ce1cfeca40f62d4a06d91b96106 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/f7e1a745/uploads/origins/6c5a503f-5850-4491-adff-cd1e4d419aea?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b380bdbbc7800009e55761ddbd6d5d9e", "srcset": "https://si.imgix.net/f7e1a745/uploads/origins/6c5a503f-5850-4491-adff-cd1e4d419aea?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b380bdbbc7800009e55761ddbd