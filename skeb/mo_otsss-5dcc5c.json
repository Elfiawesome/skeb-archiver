&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=d35846e4d2d38f485db70414392cd3b6 3x"}, "body": "MOTSU.先生、こんにちは。先生の作品が大好きで、私のオリジナルキャラクターのイラストを依頼させていただきたいです！\nキャラクター設定：\n15歳のウサギの少年\n髪は青で、毛先は水色\n依頼内容：\n服装は自由にお選びください。キュートな雰囲気かクールな雰囲気で描いていただけると嬉しいです！💞https://drive.google.com/drive/folders/1Ijk0qaVZSYyn0H95JmvdHgv3Q8kqK6y9", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@mo_otsss/works/10", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3915570, "client_id": 2950891, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/35c612d3/uploads/origins/29d2f0ce-0410-4989-a6c7-e7cc0a43303c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3040ea30a8f7bded0d017b07f6c364ca", "srcset": "https://si.imgix.net/35c612d3/uploads/origins/29d2f0ce-0410-4989-a6c7-e7cc0a43303c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3040ea30a8f7bded0d017b07f6c364ca, https://si.imgix.net/35c612d3/uploads/origins/29d2f0ce-0410-4989-a6c7-e7cc0a43303c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=34162c133565198d8838df2beba50d91 2x, https://si.imgix.net/35c612d3/uploads/origins/29d2f0ce-0410-4989-a6c7-e7cc0a43303c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=fde755de1db39dafb8cfdfdc24d3d14c 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/35c612d3/uploads/origins/29d2f0ce-0410-4989-a6c7-e7cc0a43303c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=8193bda42412c80ead1f601e4c28eb11", "srcset": "https://si.imgix.net/35c612d3/uploads/origins/29d2f0ce-0410-4989-a6c7-e7cc0a43303c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=8193bda42412c80ead1f601e4c28eb11, https://si.imgix.net/35c612d3/uploads/origins/29d2f0ce-0410-4989-a6c7-e7cc0a43303c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=108754fffffd423f6ca2a9d8700b3d45 2x, https://si.imgix.net/35c612d3/uploads/origins/29d2f0ce-0410-4989-a6c7-e7cc0a43303c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=c92cea0f8bc05fa13083766af52efa9c 3x"}, "body": "MOTSU.様\n\n初めまして、MOTSU.様のイラストを新着で拝見させて頂き、一目惚れしたため、依頼をさせて頂きたく思いメッセージを送らせて頂きました。\n\n以下の2人を描いて頂きたく送付させて頂きました、資料等はGoogleドライブにまとめさせて頂きましたので、よろしければそちらをご確認くださいますようお願い致します。\n\n▽春夏カナタ（白髪の方）男/176cm\n高校生という齢にして工学博士に就任した若き天才。その一方で人間嫌いな面もあり口調が荒い。\n専攻は航空宇宙。星の話ができることからセイレンのことを気に入り傍に置いているが、本人は素直ではないため肯定していない。\n\n▽六合星蓮（ピンク髪の方）女/163cm\n｢星還教｣という宗教の教祖で、｢自殺した人間は星に生まれ変われる｣という教えが説かれていた村で自殺者を見送る役目にあった。\n\n普段は大人しい雰囲気。育った村は閉鎖的な環境で、世間知らずなところがある。\n星のことなど色々知らないことを教えてくれるカナタに惹かれ、カナタに自分の最期、共にいて欲しいと願った。\n\n※資料によって左目デザインが異なりますが、可能であればドライブ内【春夏カナタ→左目変更】【六合星蓮→表情資料】資料参照に、カナタが水色の宝石のような左目、セイレンが黄緑色の星型特殊瞳孔のデザインだと嬉しいです。\n\n▽構図について\nMOTSU.様の描きやすい様にして頂ければ幸いです。\n宇宙、星のモチーフが強いのでそちら含めていただけるとありがたく思いますが、どちらでも構いません。\n\n不備等ございましたら恐れ入りますが再送いただければ幸いです。\nお忙しい中大変恐縮ですが、以上の内容でご検討よろしくお願いします。\n\nhttps://drive.google.com/drive/folders/15pTmuPAkNPTjym9XwtUJvhkt5Al9_N2V", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@mo_otsss/works/9", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3915570, "client_id": 1205508, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/2b42672e/uploads/origins/4da171d2-5087-4f22-a175-ec3a7fee8d19?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=21287df765868cc951df0c2d46d25030", "srcset": "https://si.imgix.net/2b42672e/uploads/origins/4da171d2-5087-4f22-a175-ec3a7fee8d19?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=21287df765868cc951df0c2d46d25030, https://si.imgix.net/2b42672e/uploads/origins/4da171d2-5087-4f22-a175-ec3a7fee8d19?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=53e3651eb42c68ba36173885c5d9a4b8 2x, https://si.imgix.net/2b42672e/uploads/origins/4da171d2-5087-4f22-a175-ec3a7fee8d19?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=84b719983e6d1b4b4aa4969912831fcf 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/2b42672e/uploads/origins/4da171d2-5087-4f22-a175-ec3a7fee8d19?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f01790c1fe2aac678d77aec82c9d2730", "srcset": "https://si.imgix.net/2b42672e/uploads/origins/4da171d2-5087-4f22-a175-ec3a7fee8d19?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f01790c1fe2aac678d77aec82c9d2730, https://si.imgix.net/2b42672e/uploads/origins/4da171d2-5087-4f22-a175-ec3a7fee8d19?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=affa66ba7149b02ef176321063f0c9cc 2x, https://si.imgix.net/2b42672e/uploads/origins/4da171d2-5087-4f22-a175-ec3a7fee8d19?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=64872594ca8c68ce24838255b466ae69 3x"}, "body": "先生こんにちは！\n\n友人と私は先生の作品の大ファンです。\nもしよろしければ、私と友人の創作BLカップル（OC）を描いていただけないでしょうか。\nなお、キャラクター作成相手の友人からは依頼許可をいただいております。\n\n二人は幼馴染であり、恋人同士です。\n\n【直樹（なおき）】\n・茶髪／二重瞼\n・気を紛らわせるために人を口説くことがあるが、ずっと海吏への想いを抱き続けていた\n・社交的で親しみやすく、自然と周囲を惹きつけるタイプ\n・しかし海吏の前では少し不器用で、自信をなくしてしまうこともある\n・海吏の可愛さや無防備さに、よく振り回されている\n\n【海吏（かいり）】\n・黒髪／一重瞼\n・真面目で優しい性格だが、人の感情や空気を読むのが少し苦手\n・恋愛に関しては非常に純粋で鈍感\n・直樹を心から信頼しており、親友として特別な思いを抱いている。生まれつき鈍感で、直接言われないと直樹の気持ちに気づくことができない\n・草食系男子。一緒にいると落ち着く存在だが、あまり存在感はない\n※海吏の一重瞼にご注意ください\n\n【関係性】\n・直樹が海吏に想いを打ち明けたものの、臆病さからその場を逃げ出してしまう\n・海吏は直樹を追いかけて問い詰めるうちに、彼が自分にとっても特別な存在であることに気づく\n・その後、少しずつ距離を縮め、やがて真剣に交際するようになる\n・二人とも医学部に通っているが、専攻は異なる（直樹は歯科医、海吏は医師を目指している）\n・現在は同じアパートで同居しており、何をするにも一緒にいることが多い\n\n二人の性格や関係性については、参考リンクにより詳しい情報を掲載しております。\n\n先生の過去のSkeb作品のような、キャラクター同士の関係性が感じられるイラストをお願いしたいです。\nデザインは高校時代版・大学時代版のどちらでも大丈夫ですので、先生の描きやすい方を選んでいただければ幸いです。\nなお、高校時代の二人を描いていただく場合、直樹は海吏に好意的ではあるものの、関係性としては親友同士です。\n\nシチュエーションや構図はお任せいたします。\n\n使用用途は個人利用になります。\n\nご検討いただけますと幸いです。\n何卒よろしくお願いいたします！\n\nhttps://drive.google.com/drive/u/5/folders/1aFVOJZAx6f__UyuFU5EIwx-Q6S74xVCY\n\nhttps://theoven.notion.site/NaoRi-3504c935899b8009ba88c1298f49e940", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@mo_otsss/works/8", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3915570, "client_id": 3041572, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/502de076/uploads/origins/61e71620-54a8-48f3-b77f-c3cece10553d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=36baaf910a375557e3729718aeba4288", "srcset": "https://si.imgix.net/502de076/uploads/origins/61e71620-54a8-48f3-b77f-c3cece10553d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=36baaf910a375557e3729718aeba4288, https://si.imgix.net/502de076/uploads/origins/61e71620-54a8-48f3-b77f-c3cece10553d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=24bb1a2f9d8792f9d4222673bc5a3145 2x, https://si.imgix.net/502de076/uploads/origins/61e71620-54a8-48f3-b77f-c3cece10553d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=7807d31ce9b17eb4225347c77fbf4f75 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/502de076/uploads/origins/61e71620-54a8-48f3-b77f-c3cece10553d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=1de06efdfd7022190fc625d547801d93", "srcset": "https://si.imgix.net/502de076/uploads/origins/61e71620-54a8-48f3-b77f-c3cece10553d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=1de06efdfd7022190fc625d547801d93, https://si.imgix.net/502de076/uploads/origins/61e71620-54a8-48f3-b77f-c