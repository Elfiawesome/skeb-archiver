=200&h=200&s=17879a32072b2fac8e79fccfb93b8b6b", "srcset": "https://si.imgix.net/516db5f0/uploads/origins/6c8d470e-6942-4e56-9166-58719d066378?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=17879a32072b2fac8e79fccfb93b8b6b, https://si.imgix.net/516db5f0/uploads/origins/6c8d470e-6942-4e56-9166-58719d066378?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=7d67561e3b3b121a73b65ca58937981f 2x, https://si.imgix.net/516db5f0/uploads/origins/6c8d470e-6942-4e56-9166-58719d066378?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c2893fa34a33c8a579a1d272446272f8 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/516db5f0/uploads/origins/6c8d470e-6942-4e56-9166-58719d066378?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0ba925506d42d429f4ca969a041c97d2", "srcset": "https://si.imgix.net/516db5f0/uploads/origins/6c8d470e-6942-4e56-9166-58719d066378?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0ba925506d42d429f4ca969a041c97d2, https://si.imgix.net/516db5f0/uploads/origins/6c8d470e-6942-4e56-9166-58719d066378?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=3aa76fdc668ff416c86771f5752838cd 2x, https://si.imgix.net/516db5f0/uploads/origins/6c8d470e-6942-4e56-9166-58719d066378?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=f4ba099fd6009f6db252a5a360f7a9a8 3x"}, "body": "いつもお世話になっております\nブルーアーカイブの桜井ミヨをお願いします\n\n・戦場が先生が傷ついて倒れている所を見つけてミヨがブチ切れているシチュエーション\n・ゲームでミヨが愛用している銃「キヴォトス・タイプライター」を持たせる\n・顔に少し血がついており、髪型が若干乱れている\n・制服が少し傷ついてボロボロになっている\n・瞳の光沢の量を少なくして、怒りに満ちた表情\n・セリフは「アンタ、先生を傷つけたでしょ　絶対に許さないから」\n\n要望は以上です、細かい部分はくらうちんぐスタート様にお任せします\nいつもと一味違うミヨが見たいのでご検討よろしくお願いします", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@crouchingstart1/works/5", "p