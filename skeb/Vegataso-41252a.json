足元は緑色の来客用スリッパを履いている状態でお願いします\n\n場所\n調理室(背景はなくてもポリタライにミカンを踏み踏みしているのが分かれば大丈夫です)\n\n以上になりましが、スリッパを履いている女の子が好きで、今回も描いてもらえると嬉しいです", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@Vegataso/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3663110, "client_id": 122407, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/b83ef3be/uploads/origins/eea4acc9-b390-4e0d-928f-fc0401c94627?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f05b4633fafe3578f17fd27b193554fa", "srcset": "https://si.imgix.net/b83ef3be/uploads/origins/eea4acc9-b390-4e0d-928f-fc0401c94627?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f05b4633fafe3578f17fd27b193554fa, https://si.imgix.net/b83ef3be/uploads/origins/eea4acc9-b390-4e0d-928f-fc0401c94627?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=aa4a00d4a4f117a4814c57fc55aa7060 2x, https://si.imgix.net/b83ef3be/uploads/origins/eea4acc9-b390-4e0d-928f-fc0401c94627?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=750f582176cdf21da58b8445f2233a35 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/b83ef3be/uploads/origins/eea4acc9-b390-4e0d-928f-fc0401c94627?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2c3909f529dcc94c016809b587d42f49", "srcset": "https://si.imgix.net/b83ef3be/uploads/origins/eea4acc9-b390-4e0d-928f-fc0401c94627?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2c3909f529dcc94c016809b587d42f49, https://si.imgix.net/b83ef3be/uploads/origins/eea4acc9-b390-4e0d-928f-fc0401c94627?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=f216414f0fbc6c3d5de9be8941a0f97d 2x, https://si.imgix.net/b83ef3be/uploads/origins/eea4acc9-b390-4e0d-9