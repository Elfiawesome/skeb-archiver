ん」をしているイラストをお願いいたします。\n\n【用途】\nYouTubeのサムネイルなどでぜひ使用したいと考えておりますので、もし背景などがありましたら背景とキャラクターの別レイヤーで分かれた状態のPSDデータですととても幸いです。\n\nどうぞよろしくお願いいたします！\n\n▼エミリーイラスト\nhttps://www.emilyn.games/illustrations?pgid=kqb56rld-467cc770-d9fc-4db7-9fda-06e34c45104e\n\n▼三面図\nhttps://www.emilyn.games/illustrations?pgid=kqb56rld-cd2da85d-5d5e-40fb-9b5b-b1c04a5754f6\n\nhttps://www.emilyn.games/", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@meloettta/works/12", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/7473e055/uploads/origins/87396804-a37e-4981-8617-618ee99421fa?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=0f591e7c4b5b09ac062d49c4872da1e5", "srcset": "https://si.imgix.net/7473e055/uploads/origins/87396804-a37e-4981-8617-618ee99421fa?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=0f591e7c4b5b09ac062d49c4872da1e5, https://si.imgix.net/7473e055/uploads/origins/87396804-a37e-4981-8617-618ee99421fa?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=b3175cb942701c0f19f367af13654305 2x, https://si.imgix.net/7473e055/uploads/origins/87396804-a37e-4981-8617-618ee99421fa?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=85dc69accfd659a671153dba306ec269 3x"}, "private": true, "genre": "art", "tipped": false, "creator_id": 1038342, "client_id": 43636, "nc": 0}, {"path": "/@meloettta/works/11", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1038342, "client_id": 1254072, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/a4620faa/uploads/origins/d9cf28cf-6382-4405-99a4-f835d181aa51?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1c6d82583cabe88b02ee5ec4083daee6", "srcset": "https://si.imgix.net/a4620faa/uploads/origins/d9cf28cf-6382-4405-99a4-f835d181aa51?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1c6d82583cabe88b02ee5ec4083daee6, https://si.imgix.net/a4620faa/uploads/origins/d9cf28cf-6382-4405-99a4-f835d181aa51?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=73f3bc15f60b33d18cf3db2578af9561 2x, https://si.imgix.net/a4620faa/uploads/origins/d9cf28cf-6382-4405-99a4-f835d181aa51?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e57b319137f8e38d878d9b9f1ee135a4 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/a4620faa/uploads/origins/d9cf28cf-6382-4405-99a4-f835d181aa51?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6427c00f83c14a07ee42a940ab7ca8d6", "srcset": "https://si.imgix.net/a4620faa/uploads/origins/d9cf28cf-6382-4405-99a4-f835d181aa51?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6427c00f83c14a07ee42a940ab7ca8d6, https://si.imgix.net/a4620faa/uploads/origins/d9cf28cf-6382-4405-99a4-f835d181aa51?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=8b4cdb562670cdd143610fa9f0d0982d 2x, https://si.imgix.net/a4620faa/uploads/origins/d9cf28cf-6382-4405-99a4-f835d181aa51?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=73feb517ed0b09a04aa4835e89083104 3x"}, "body": "こんにちは。私はあなたのアートワークスタイルが本当に大好きです!  私は新米VTuberなので、リファレンスシートを作っていただけると光栄です。\n\n私の名前はジャスミンで、雨が好きすぎて自分の仕事(雨を降らせること)をしないてるてる坊主です。  私は基本的にシャイで大人しい性格で、モチーフは雨・雨雲、植物、カメラ（私は写真家です！）です。それらの要素を取り入れていただけると嬉しいのですが、スペースがない場合はご了承ください\n\nまた、参考資料として最低でも正面と背面の写真、そして表情のあるアップやアクセ