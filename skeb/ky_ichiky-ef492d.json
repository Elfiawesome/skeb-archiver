って攻撃している。拘束された瑞希は身を捩ったり、のけぞったり潮吹きやお漏らしすることしか出来ず、強烈な刺激によりイキっぱなしされている。知能のある敵軍は瑞希の反応から的確に弱点を見つけ出し、効率よく性感帯に刺激を与えており、瑞希は休む間もなくアクメさせられ続けているような感じでお願い致します。\n瑞希の表情がなるべく見えるようにお願い致します。また瑞希の目を閉じて苦しむ表情を多めにしていただけると嬉しいです。よろしくお願い致します。", "nc": 32, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@ky_ichiky/works/14", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/9a4fc000/uploads/origins/8c978d30-8bb0-4188-b672-41ffbd97689b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=d27c95971dc228d60a6f140cb1e61aa2", "srcset": "https://si.imgix.net/9a4fc000/uploads/origins/8c978d30-8bb0-4188-b672-41ffbd97689b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=d27c95971dc228d60a6f140cb1e61aa2, https://si.imgix.net/9a4fc000/uploads/origins/8c978d30-8bb0-4188-b672-41ffbd97689b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=aeb07c023d5f129f5a9d0c80a202a846 2x, https://si.imgix.net/9a4fc000/uploads/origins/8c978d30-8bb0-4188-b672-41ffbd97689b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=0818ed27daa4b998a2fd229ed8e399f7 3x"}, "private": true, "genre": "art", "tipped": false, "creator_id": 463992, "nc": 49}, {"path": "/@ky_ichiky/works/13", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/a5bb3d23/uploads/origins/4089a37d-6d87-4ae3-966e-cc49e8d271c1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=0fccf65a3ee1aca26a14651678327943", "srcset": 