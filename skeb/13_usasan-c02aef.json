と違うので控えていただけますと幸いでございます！本編中に触れたのは頭をなでただけです\nhttps://drive.google.com/drive/folders/1PZA67KRwOnV-b0LI3nsZAOLNRJ76DXmn?usp=drive_link\n\n\nいただいた絵は自分用に眺めたり自慢するために投稿したりどこかのSNSのアイコンやヘッダーなどに使用するかもしれません。\n何卒よろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/1PZA67KRwOnV-b0LI3nsZAOLNRJ76DXmn?usp=drive_link", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@mtnmy_/works/121", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1221576, "client_id": 1822835, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/a218a6a0/uploads/origins/92b8cf7d-d125-4d21-8332-e754af8f6e28?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3cd133cd903e17d89bf2945b1cffa75d", "srcset": "https://si.imgix.net/a218a6a0/uploads/origins/92b8cf7d-d125-4d21-8332-e754af8f6e28?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3cd133cd903e17d89bf2945b1cffa75d, https://si.imgix.net/a218a6a0/uploads/origins/92b8cf7d-d125-4d21-8332-e754af8f6e28?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=796b7f84652f9dc8334ca314f0df8651 2x, https://si.imgix.net/a218a6a0/uploads/origins/92b8cf7d-d125-4d21-8332-e754af8f6e28?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d334c78c2bc5b55e8d96ee0cf277e7d1 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/a218a6a0/uploads/origins/92b8cf7d-d125-4d21-8332-e754af8f6e28?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=30e931eef51e3ffa9dc1fb09d2fde8c9", "srcset": "https://si.imgix.net/a218a6a0/uploads/origins/92b8cf7d-d125-4d21-8332-e754af8f6e28?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=30e931eef51e3ffa9dc1fb09d2fde8c9, https://si.imgix.net/a218a6a0/uploads/origins/92b8cf7d-d125-4d21-8332-e754af8f6e28?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=73a45513b96ccbef2154e54982b0c349 2x, https://si.imgix.net/a218a6a0/uploads/origins/92b8cf7d-d125-4d21-8332-e754af8f6e28?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=c9cb1e5bc0511154e654963d37c4e39a 3x"}, "body": "みたにさまこんにちは！\nみたにさまのイラストの、可愛くてふんわりしたたんぽぽのような雰囲気と、唯一無二のかっこかわいい絵柄が本当に大好きです。特に髪の毛と服の皺の描き方が天才的だと思っていて、いつも絵を拝見させていただきながら感動しております。\nみたにさまの描かれる儚げ美青年と、可愛いきゅるきゅる少女の絵柄が絶対に似合うと思いますので、「赤ずきんの狩人」というシナリオの自陣を描いてくださいませんでしょうか？\n\n2人の関係性的はバディです。ググ(男性)は古参の先輩、シャルル(女の子)は新人の後輩です。\nググは女の子が好き(チャラいとか、ロリコンとかではない)で、よく口説いているかのようなことを言いますが、言い回しが若干変態じみているのでシャルルは呆れてそれをあしらったり、ツンツンした返事をしたり、照れて怒ったり、本気で大困惑したり…と言った感じで、ロマンスや恋愛的な空気感というよりは漫才的な愉快なやり取りが多い2人です。　\nそんな無駄話の多い2人(ほぼググのせい)ですが戦闘の時は効率的な戦い方をするというスタイリッシュさもある、メリハリの強いバディです。\n\n構図やシチュエーションなどはお任せしたいのですが、赤い花(バラやチューリップなど)が絵の中にあるととても嬉しいです！\n\nもし資料URLがちゃんと設定できていませんでしたらお手数ですが再送をしてください。\nご検討よろしくお願いいたします！\n\nhttps://drive.google.com/drive/folders/1PZA67KRwOnV-b0LI3nsZAOLNRJ76DXmn?usp=drive_link", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@yasato83/works/28", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2710539, "client_id": 1822835, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/1929d8a4/uploads/origins/3ea39064-0034-4dec-b6d4-186c367bc4d2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=eae3ae7eea635e95dc2568574cc38b61", "srcset": "https://si.imgix.net/1929d8a4/uploads/origins/3ea39064-0034-4dec-b6d4-186c367bc4d2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=eae3ae7eea635e95dc2568574cc38b61, https://si.imgix.net/1929d8a4/uploads/origins/3ea39064-0034-4dec-b6d4-186c367bc4d2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b8917ac8404382acbb4253dc4d0c8af3 2x, https://si.imgix.net/1929d8a4/uploads/origins/3ea39064-0034-4dec-b6d4-186c367bc4d2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c9a02a08d14b060223027c398cda3cf5 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/1929d8a4/uploads/origins/3ea39064-0034-4dec-b6d4-186c367bc4d2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=69e5163a87f126d34d02d0aae94901d5", "srcset": "https://si.imgix.net/1929d8a4/uploads/origins/3ea39064-0034-4dec-b6d4-186c367bc4d2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=69e5163a87f126d34d02d0aae94901d5, https://si.imgix.net/1929d8a4/uploads/origins/3ea39064-0034-4dec-b6d4-186c367bc4d2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=91d7b60f306a0d9e909943539bc29ef6 2x, https://si.imgix.net/1929d8a4/uploads/origins/3ea39064-0034-4dec-b6d4-186c367bc4d2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=a2b0c09979b8b4f553c71bfa4b368acc 3x"}, "body": "やさとさんこんにちは。よければ私の探索者を描いていただければと思い、リクエストさせていただきます。\n\nやさとさんの全身のイラストが好きですので、もしよろしければ全身描いていただけると嬉しいです。立っているか座っているか、またはそれ以外かなどはお任せします！その他はやさとさんの描きたいように描いてくださるとうれしいです。\n\n以下探索者の情報です。\n庭師は何を口遊む HO1\n青羽 凛久（あおば りく）　\n34歳男性　身長178m\n・灰色の髪にヘアピン\n・3本のアホ毛\n・襟足ちょっとある\n・背筋がよく歩き方もきれい\n・左利きで銃を持つときだけ右\n\n警視庁特殊犯罪捜査零課　青羽班チーフ。\n気さくで誰に対しても親しみやすい性格で、喋り方と表情はゆるい。が、目は据わっている。\n非常に愛想よく、好青年の印象。が、実際の性格は不真面目人間で面倒ごとは基本避けたがる。けっこうさぼり癖がついているが普段のふるまいの誠実さで多方面からの信頼が厚く、基本ばれない。\n座右の銘は「笑うより笑われろ」。刑事であるが、好き嫌いなどかなり私情や感情で物事の判断をする。\n人前でキレたりとか怒鳴るタイプではなく、頭に血が上っても冷静でいられる人。冷静すぎることが弱点かもしれない。嫌なこととか、見たくないことに気づかないふりをしたりスルーする自己暗示型の高pow。\n体力がクソ雑魚ナメクジ（CON6）で、たばこや酒も好まないが人脈づくりのためなら付き合いでなら飲んだり吸ったりする。捜査中に走る場面もほかの班員に任せたがる。\n\nといった感じです！長くてすみません！\nご検討のほどよろしくお願いします。\n\nhttps://drive.google.com/drive/folders/1BKquey4E__Ec0lwGcw08UoOyPTGDuAsm?usp=drive_link\n\nhttps://drive.google.com/drive/folders/1BKquey4E__Ec0lwGcw08UoOyPTGDuAsm?usp=drive_link", "nc": 128, "word_count": 0, "tra