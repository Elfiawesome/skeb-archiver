る。肌は少し日焼けしている。\n\nMELODYが疲れたり落ち込んだりした表情をしているところを、DIAが大きな胸を露わにして抱きしめて元気づける、そんな漫画を見てみたいです。その後、MELODYは生き生きとして元気いっぱいになるんです。\n\nご自由に描いてください。先生にとってかっこいいシーンであればうれしいです。\n\nご検討よろしくお願いします。", "nc": 177, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@2000000000yen/works/1", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/04d775e4/uploads/origins/82d1cc9a-9754-4ed5-a7fd-e6ebbc1e2caa?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=6681ad297a7aaa7f0ce24fbec3307214", "srcset": "https://si.imgix.net/04d775e4/uploads/origins/82d1cc9a-9754-4ed5-a7fd-e6ebbc1e2caa?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=6681ad297a7aaa7f0ce24fbec3307214, https://si.imgix.net/04d775e4/uploads/origins/82d1cc9a-9754-4ed5-a7fd-e6ebbc1e2caa?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=2a81f23400c9e17e92685af9bbdfd6ca 2x, https://si.imgix.net/04d775e4/uploads/origins/82d1cc9a-9754-4ed5-a7fd-e6ebbc1e2caa?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=1f58e1eb9183b93b10c35f07e515b781 3x"}, "private": true, "genre": "art", "tipped": false, "creator_id": 3907837, "nc": 48}], "sent_works": [], "similar_creators": [{"id": 12055, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "杏まこに", "screen_name": "makoni_cg", "avatar_url": "https://pbs.twimg.com/profile_images/2022689159534776322/Xsv8TBq5.jpg", "header_url": "https://pbs.twimg.com/profile_banners/2813040168/1652733602/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_mas