om/Kusogaki115/status/1567760539602030592）と同じような感じで、お腹や肋骨が露出しているようなものがいいです。ポーズは正確でなくてもいいのですが、とにかく見せたいので、寝転んだり、倒れたりして、シャツが浮き上がるようなポーズがいいかもしれません。表現はお任せしたいです。\n\nhttps://drive.google.com/drive/u/1/folders/1izwuwpKT-mNWOCTAqINqWd_1i62E9k_z", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Kusogaki115/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2724227, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/acd71e9c/uploads/origins/720dc767-9d0b-4f23-934b-3d9fdbad9b33?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ead50dc83c083f2627c4902a0f9d508b", "srcset": "https://si.imgix.net/acd71e9c/uploads/origins/720dc767-9d0b-4f23-934b-3d9fdbad9b33?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ead50dc83c083f2627c4902a0f9d508b, https://si.imgix.net/acd71e9c/uploads/origins/720dc767-9d0b-4f23-934b-3d9fdbad9b33?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=af33f3954370f96e77f9cb52894ba64b 2x, https://si.imgix.net/acd71e9c/uploads/origins/720dc767-9d0b-4f23-934b-3d9fdbad9b33?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=fd149f4bcfcb58d1fca070cdee9d470a 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/acd71e9c/uploads/origins/720dc767-9d0b-4f23-934b-3d9fdbad9b33?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ba0c7f1d66e197f2f8eb7817cda06c21", "srcset": "https://si.imgix.net/acd71e9c/uploads/origins/720dc767-9d0b-4f23-934b-3d9fdbad9b33?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ba0c7f1d66e197f2f8eb7817cda06c21, https://si.imgix.net/acd71e9c/uploads/origins/720dc767-9d0b-4f23-934b-3d9fdbad9b33?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=10195ad2df