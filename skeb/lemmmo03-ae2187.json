まで届く長さ。\n› 瞳は非常に淡い青色で、瞳孔は白い十字形をしている。\n› 右目から下にかけて、4つのほくろが一直線に並んでいる。\n› 顔全体に傷跡があり、左目を通って下へ伸びている。\n› 胴体全体にも傷跡がある。\n› 肩を覆う白い天使の翼のタトゥーがあり、翼が折りたたまれたように見える。\n\nファウストは現代の「ロビン・フッド」だが、より暗く歪んだ側面を持つ。抑圧された者の自由のためなら、手を汚すことも厭わない。愛用武器はライノ60DSネビュラ拳銃と小型ハンドナイフ。\n\n構図とポーズは完全に自由です。いかなる理由でもこの依頼をお断りいただいても構いません。お時間をいただき誠にありがとうございます！\n\nhttps://drive.google.com/drive/folders/1W2mIu4hLv-eciIzxc2fJJz7xE9kdTaZg?usp=sharing", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@lemmmo03/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3715168, "client_id": 926866, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/682d2420/uploads/origins/f2c023ec-829a-45c0-bdc7-b17b34400a75?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6da121ccd56029458fe38cfb6f345612", "srcset": "https://si.imgix.net/682d2420/uploads/origins/f2c023ec-829a-45c0-bdc7-b17b34400a75?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6da121ccd56029458fe38cfb6f345612, https://si.imgix.net/682d2420/uploads/origins/f2c023ec-829a-45c0-bdc7-b17b34400a75?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=2ec77600367f6f83ea357dd6bb300151 2x, https://si.imgix.net/682d2420/uploads/origins/f2c023ec-829a-45c0-bdc7-b17b34400a75?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=81f23d02a2fa9480d826e9c443a3e352 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/682d2420/uploads/origins/f2c023ec-829a-45c0-bdc7-b17b34400a75?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=7908481dcd3db0f1f9dcf52bfe0b4461", "srcset": "https://si.imgix.net/682d2420/uploads/origins/f2c023ec-829a-45c0-bdc7-b17b34400a75?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=7908481dcd3db0f1f9dcf52bfe0b446