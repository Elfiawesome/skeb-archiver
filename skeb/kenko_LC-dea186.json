8b-2db934e16f31?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=95d71e6eb0d044ca8d7fe2f7467e3e32, https://si.imgix.net/3ce4fdcf/uploads/origins/abab34b4-a7bc-4b35-bf8b-2db934e16f31?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=0dd094b2a3ca79cdea6f8542bfe15a93 2x, https://si.imgix.net/3ce4fdcf/uploads/origins/abab34b4-a7bc-4b35-bf8b-2db934e16f31?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=5206eb739cac0926cf4db21ea91761b5 3x"}, "body": "健康法様、はじめまして！ずっと前からあなたのイラストが大好きで、特にイサンとあのイサンのぬいぐるみたちが本当に可愛くてたまりませんでした！なので勇気を振り絞って、何か描いていただきたいと思い、ご依頼させていただきます🥺🥺🥺\n\n第四章に描かれている友情がとても好きなので、お願いがあります！「九人会」時代のドンベクとドンランが、さまざまなイサンのぬいぐるみに囲まれているイラストを描いていただけませんか？\n\n希望する内容は以下の通りです：\n· 各キャラクターの上半身が少なくとも含まれるようお願いします。\n· ドンベクは💍🪶を手に持ち、困ったような／呆れたような表情で、周りで騒いでいるイサンぬいぐるみたちを見つめている。\n· ドンランは目を細めて笑いながら、3、4体のイサンぬいぐるみを抱え込んでいる（ぬいぐるみたちは彼の腕から這い出そうとしている）。さらに、彼の頭の上ではリエン・イサン（rien yi sang）ぬいぐるみが武器でコツコツと叩いている。\n\nこのリクエストをお読みいただき、本当にありがとうございます。もしご予算が合わなければ、遠慮なくお知らせください。価格は完全に調整可能ですので！🥰🥰", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@kenko_LC/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3852506, "client_id": 3589201, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/33011820/uploads/origins/be9e8e56-e6c9-41b7-bc7f-f0a81d196efe?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1a035ace4d38e3b1e3f11aa7cbb9cbfb", "srcset": "https://si.imgix.net/33011820/uploads/origins/be9e8e56-e6c9-41b7-bc7f-f0a81d196efe?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1a035ace4d38e3b1e3f11aa7cbb9cbfb, https://si.imgix.net/33011820/uploads/origins/be9e8e56-e6c9-41b7-bc7f-f0a81d196efe?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=8d9c2a3a0f4db7df9307c6de7a33056a 2x, https://si.imgix.net/33011820/