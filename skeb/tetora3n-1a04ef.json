ん！他にもアイデアがあれば問題ありません。私の要望はいつでも変更可能です。\n\nここまでお読みいただきありがとうございます。リンクは添付しておりませんので、制約に縛られず自由に創作していただければ幸いです。お手数をおかけします！価格が合わない場合は、お気軽に調整してください！", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@tetora3n/works/3", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/069c8096/uploads/origins/02c68fe4-fcf2-43e8-8320-f2969f9d2f72?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=53bdf6956b45d9221018979c64ad6efc", "srcset": "https://si.imgix.net/069c8096/uploads/origins/02c68fe4-fcf2-43e8-8320-f2969f9d2f72?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=53bdf6956b45d9221018979c64ad6efc, https://si.imgix.net/069c8096/uploads/origins/02c68fe4-fcf2-43e8-8320-f2969f9d2f72?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=e5f3d639f1026de899785611abc755b1 2x, https://si.imgix.net/069c8096/uploads/origins/02c68fe4-fcf2-43e8-8320-f2969f9d2f72?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=559e64d438a34e64d2ef41f0d7d3c242 3x"}, "private": true, "genre": "art", "tipped": false, "creator_id": 3737083, "client_id": 3853623, "nc": 144}, {"path": "/@tetora3n/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3737083, "client_id": 438366, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/844039d9/uploads/origins/db8c7e70-c833-4c39-a1bd-9461fef15e1c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e6ee2eb321e2afd8ea85c55dbb79ff56", "srcset": "https://