と申します。\nアピールを送ってくださり、ありがとうございます！ウチの子に興味を持ってくれて嬉しいです！！Xの方まで見てくださりありがとうございます🙇\nメディア拝見させていただきました。顔だけでなく全身を使って表情豊かにキャラクターを描かれていて、ウチの子ならどんな風に描いてくれるのかなと気になりました！是非描いてくださると嬉しいです！！\nXを見てくださっているのでご存知かと思われますが、ウチの子、むたまちゃんはタマゴ(朝ごはん)をモチーフにデザインした元気バリバリの女の子です。角みたいな毛、ベーコンエッグのようなヘアピン、跳ね毛いっぱい、大きなおさげ、癖を詰め込みまくった服など、これでもかと私の好みが詰まっております。最近尻尾も生えました。\nおてんばだったり食いしん坊だったり自信家だったり。表情も喜怒哀楽いろんな顔で皆さん描いてくれてます。むたまちゃんを見て思ったイメージのまま描いてくださると嬉しいです！\nよろしくお願いします！", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Gifukade__/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2672303, "client_id": 799802, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/c6f78524/uploads/origins/7be3be65-3a06-45d1-852f-19e3869925ff?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=08111f563c4d80deea09458e0d417414", "srcset": "https://si.imgix.net/c6f78524/uploads/origins/7be3be65-3a06-45d1-852f-19e3869925ff?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=08111f563c4d80deea09458e0d417414, https://si.imgix.net/c6f78524/uploads/origins/7be3be65-3a06-45d1-852f-19e3869925ff?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=61b1d7124701383c2523e8e95d6a523a 2x, https://si.imgix.net/c6f78524/uploads/origins/7be3be65-3a06-45d1-852f-19e3869925ff?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=4635b9bf2f497c1d6eaa42a6619403b8 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/c6f78524/uploads/origins/7be3be65-3a06-45d1-852f-19e3869925ff?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c85642cc3fb888c910c9474e4413b916", "srcset": "https://si.imgix.net/c6f78524/uploads/origins/7be3be65-3a06-45d1-852f-19e3869925ff?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c85