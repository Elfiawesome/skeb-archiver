o=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f94f752b5cb41fda4f7d74e37ef2cbb7, https://si.imgix.net/b066170c/uploads/origins/25096fa0-dc19-46ef-b43e-2c0af882f0d3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=7193d539d4f4a721503f213868990229 2x, https://si.imgix.net/b066170c/uploads/origins/25096fa0-dc19-46ef-b43e-2c0af882f0d3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=3e6a8f531966a60e200f9df36baa51a6 3x"}, "body": "ポケモンキャラの輪姦ものが見たいです。\nドドリアントスさんが描かれたマオ(ロケット団の姿)かあくコスチュームユウリが何人もの男達に輪姦されている1、2ページのマンガが見たいです。\nセリフは全部擬音(ハートマークやお金のマーク、♂が♀に突っ込むマークなど)でお願いします。\n口、手、膣にアナルと全身使われていると興奮します。\n可能なら全身ぶっかけ＆全ての穴から逆流の事後の姿があるととても嬉しいです。\nこの内容と金額で問題なければよろしくお願いします。", "nc": 56, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@zundomu/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1985290, "client_id": 17545, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/e427487c/uploads/origins/63ce1f55-e1b8-41a8-ad03-344e286900db?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ea127a1b70575b4d3f69cd37856325c0", "srcset": "https://si.imgix.net/e427487c/uploads/origins/63ce1f55-e1b8-41a8-ad03-344e286900db?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ea127a1b70575b4d3f69cd37856325c0, https://si.imgix.net/e427487c/uploads/origins/63ce1f55-e1b8-41a8-ad03-344e286900db?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=94396a58f308cf3c469400093acbb64f 2x, https://si.imgix.net/e427487c/uploads/origins/63ce1f55-e1b8-41a8-ad03-344e286900db?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a2a41213ad45d866cb9b82f345ab2e26 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/e427487c/uploads/origins/63ce1