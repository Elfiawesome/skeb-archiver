200&s=3e9e9cf0a5f4392209fab3ade1c0ba69 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/2d31d5ee/uploads/origins/8307d24a-1850-43c9-94da-ef17a7523c41?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=514f92a306c2fe9d2c29e492b5a9f786", "srcset": "https://si.imgix.net/2d31d5ee/uploads/origins/8307d24a-1850-43c9-94da-ef17a7523c41?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=514f92a306c2fe9d2c29e492b5a9f786, https://si.imgix.net/2d31d5ee/uploads/origins/8307d24a-1850-43c9-94da-ef17a7523c41?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=6e59dac776fbc9acaf061dfd65c590a8 2x, https://si.imgix.net/2d31d5ee/uploads/origins/8307d24a-1850-43c9-94da-ef17a7523c41?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=16914bf3d34f7ff52a965499527b994f 3x"}, "body": "新着のイラストをみて依頼させて頂きました\n同じくマオちゃんのイラストをお願いできますか?\nM字開脚の姿勢のマオちゃんの両足裏を見させて貰いながら見抜きしている様なシチュエーション\n服は胸元を横にずらしておっぱいを見せて、脱いだ靴は近くに置いてある感じでお願いします\n表情はジト目でちょっと呆れた様な台詞を一言二言お願いします\nご検討お願いします", "nc": 48, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@zundomu/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1985290, "client_id": 1562358, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/ceea8f93/uploads/origins/2e1f330f-174d-4dc4-bf1d-224254e95099?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=486cad9f1a48618f5e9b64c7a373d068", "srcset": "https://si.imgix.net/ceea8f93/uploads/origins/2e1f330f-174d-4dc4-bf1d-224254e95099?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=486cad9f1a48618f5e9b64c7a373d068, https://si.imgix.net/ceea8f93/uploads/origins/2e1f330f-174d-4dc4-bf1d-224254e95099?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w