ody": "リクエストします。VGユニットから。\n\nリシアフェール×エルベリーナ\n\n詳細\n突然エルベリーナに口付けされ、赤面するリシアフェール。エルベリーナは今にも泣きそうな顔で\n\n「あんたが一番じゃないと、あたしが輝けないんだから…だから、いなくならないでよぉ…！」\n\nとリシアフェールに告げ、彼女を抱き締める。\n\n\n公式読み物のリシアフェールで、文面からエルベリーナが百合っぽい感情抱いてるんじゃないかという妄想から思い付きました。\n\n一応クリスレインVSリシアフェールの後日談という設定です。ご検討お願いいたします。", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@kurorio1/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "comic", "tipped": false, "creator_id": 290436, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/9fd77d61/uploads/origins/cb7bd515-34fc-47d8-85f8-87cedd4d838b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=85079493ecc7c28e880c1cbc05885686", "srcset": "https://si.imgix.net/9fd77d61/uploads/origins/cb7bd515-34fc-47d8-85f8-87cedd4d838b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=85079493ecc7c28e880c1cbc05885686, https://si.imgix.net/9fd77d61/uploads/origins/cb7bd515-34fc-47d8-85f8-87cedd4d838b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=4eda42d58538eff809e64151412ef8b5 2x, https://si.imgix.net/9fd77d61/uploads/origins/cb7bd515-34fc-47d8-85f8-87cedd4d838b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a23ad5d785bb3f0df7c2aa47485a955e 3x"}, "duration": null, "nsfw": true, "hardcore": true, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/9fd77d61/uploads/origins/cb7bd515-34fc-47d8-85f8-87cedd4d838b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=143536c2232530c560fedda41295a4e7", "srcset": "https://si.imgix.net/9fd77d61/uploads/origins/cb7bd515-34fc-47d8-85f8-87cedd4d838b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=143536c2232530c560fedda41295a4e7, https://si.imgix.net/9fd77d61/uploads/origins/cb7bd515-34fc-47d8-85f8-87cedd4d838b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&cro