2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=17624bc7f59a37bb4afe48e6e5664970", "srcset": "https://si.imgix.net/7638e8c8/uploads/origins/5da77d46-52ac-49c3-bd97-b5d6657abd87?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=17624bc7f59a37bb4afe48e6e5664970, https://si.imgix.net/7638e8c8/uploads/origins/5da77d46-52ac-49c3-bd97-b5d6657abd87?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=6d1b4a80ac1775aa8b4621aa3d5440dc 2x, https://si.imgix.net/7638e8c8/uploads/origins/5da77d46-52ac-49c3-bd97-b5d6657abd87?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=1d70c02d56d0607b4e5c401c4ce166dd 3x"}, "body": "リクエストします。\n\n麗焔魔嬢オリエンス×魔王竜ガブエリウス “幻影”\n\nシチュ\nオリエンスとガブエリウス幻影の異種間セックス\n\n設定\n惑星クレイの幻世界でオリエンスがガブエリウス幻影から誘いを受けた設定\n\nオリエンスとガブエリウスはベッドの上で寝バックエッチしている。オリエンスは『んっ♡ あっ♡』と声を上げ、ガブエリウスは腰を振りながら彼女の頬を舐める。\n\n事後、しばらく眠っていたオリエンスは起き、隣でうつ伏せで眠っているガブエリウスにそっと寄り添う。\n\n補足\n・オリエンスは全裸で、ガブエリウスはアニメの人間態ではなくクレイでの本来の竜の姿\n\n・ガブエリウスは巨大過ぎず、成熟期の一歩手前の馬位のサイズ\n\n可能であれば\n\n・セリフはオリエンスの語り部で、ガブエリウスはセリフ無し\n\n・セリフは枠無しのモノローグ\nセックス時\n(私を求め、私が愛するこの竜こそ“この幻世界での”私の主)\n\n事後、寄り添う時\n(私はあくまで侍女。たとえ“真”であろうと“幻”であろうと、主に尽くすのみ)\n\n\nこんな感じです。よろしくお願いいたします。", "nc": 59, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@kurorio1/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 290436, "client_id": 3798346, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/b49a7ba4/uploads/origins/1afb32f5-b415-43cd-82d3-08a1123083fa?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8a94b9a968a3849e8f25f31d2b0fb036", "srcset": "https://si.imgix.net/b49a7ba4/uploads/origins/1afb32f5-b415-43cd-82d3-08a1123083fa?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8a94b9a968a3849e8f25f31d2b0fb036, https://si.imgix.net/b49a7ba4/uploads/origins/1afb32f5-b415-43cd-82d3-