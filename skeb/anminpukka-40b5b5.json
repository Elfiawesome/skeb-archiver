てお知らせいただけますと助かります。\n\nイラストですが頭部が見切れていない人物のみの背景透過バージョン、できたらPNGデータもいただけますと助かります。\n\nお忙しいところ申し訳ありませんが、何卒宜しくお願いいたします。\n※もし金額や不備等ありましたらリクエスト再送していただけますと幸いです。\n\nhttps://lit.link/miya318", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@anminpukka/works/9", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3326078, "client_id": 3246593, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/2a97dd6c/uploads/origins/d7a34aec-f26e-4265-b95f-ba63fa5ae3fc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f2ac3e5bfdfcd19481337e0c21924d4e", "srcset": "https://si.imgix.net/2a97dd6c/uploads/origins/d7a34aec-f26e-4265-b95f-ba63fa5ae3fc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f2ac3e5bfdfcd19481337e0c21924d4e, https://si.imgix.net/2a97dd6c/uploads/origins/d7a34aec-f26e-4265-b95f-ba63fa5ae3fc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=73005db2405e5439ad08754b2c96566d 2x, https://si.imgix.net/2a97dd6c/uploads/origins/d7a34aec-f26e-4265-b95f-ba63fa5ae3fc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e1b754baac618676d2661056ac66a337 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/2a97dd6c/uploads/origins/d7a34aec-f26e-4265-b95f-ba63fa5ae3fc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9f20cb28c707df8457d43e03077a6c8e", "srcset": "https://si.imgix.net/2a97dd6c/uploads/origins/d7a34aec-f26e-4265-b95f-ba63fa5ae3fc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9f20cb28c707df8457d43e03077a6c8e, https://si.imgix.net/2a97dd6c/uploads/origins/d7a34aec-f26e-4265-b95f-ba63fa5ae3fc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=128e732774d50e1ac05741044138f06d 2x, https: