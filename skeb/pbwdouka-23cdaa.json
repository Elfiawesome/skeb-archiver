88/uploads/origins/6dc11526-2393-4ca8-ae2a-d7c0fab301c3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=914ddb4eb2e6e0f31145907ef7a6911b, https://si.imgix.net/f8cf4088/uploads/origins/6dc11526-2393-4ca8-ae2a-d7c0fab301c3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=e55a4724c2433be55fe0e23137189729 2x, https://si.imgix.net/f8cf4088/uploads/origins/6dc11526-2393-4ca8-ae2a-d7c0fab301c3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=cc2d3cca4ef7d1e6337dd9b298c94620 3x"}, "body": "いつも大変お世話になっております\n前回のリクエスト納品ありがとうございました！とても可愛かったです\n\n企画【夏の幻】のハーバリウムピンナップをお願いしたくリクエストさせて頂きます\n出来れば2人ピンナップで見たいです！\n\n【シャーリー】\n参考画像左のピンク髪のお姉さん\nhttps://x.com/shigusa_tea/status/1496113253956878343?s=20\n\n淡いローズピンクから牡丹色（#E761A4 位）のグラデーションロングヘア\n前髪は左目から右側に流していている、基本はハーフアップ\n後ろ髪は膝裏辺りまでの長さ、基本ストレートヘアで毛先だけ緩くウェーブしてます\n描きやすい様に弄って下さってOKです\n\n濃いめのピンクの瞳をしている\n\n前回の子より更に豊かなお胸してます\n中華系のメイド様でパーフェクトメイドです、衣装は色々着てくれます\n前衛系戦闘もこなせる万能なメイド様、だけど偶に笑顔で毒舌はいたり\nしっぽにもふるのが密かに好き\n\n【元魅耶】\n狐のお兄さん\nhttps://x.com/shigusa_tea/status/1568640145980796929?s=20\n\n目にかからない短さの猫っ毛短髪、無造作ヘアー\n白に近い白銀の髪としっぽ、しっぽの数は1－9好きな数\n普段はヒト型だったりするので、ケモノ形態でも人間形態でもどちらでもOKです\nヒト型の場合は濃いめの落ち着きある茶髪です\n\n瞳は銀、水色だったり紫だったりと光の角度で変わる感じ\n\n太陰太極図のキーホルダー金具がついたチョーカー（首輪）をしてます、絶対に外れません\n温厚なヒーラーのお兄さん、ワーカーホリック気味\n\n\n落ち着きある大人な感じのカップルです\n宜しくお願いします！", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@pbwdouka/works/8", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1161760, "client_id": 302886, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/c4955302/uploads/origins/e68c72e8-f25f-4a83-be2c-4b14c3ebab35?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a081b9000a6f80d7932e48722fc69960", "srcset": "https://si.imgix.net/c4955302/uploads/origins/e68c72e8-f25f-4a83-be2c-4b14c3ebab35?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a081b9000a6f80d7932e48722fc69960, https://si.imgix.net/c4955302/uploads/origins/e68c72e8-f25f-4a83-be2c-4b14c3ebab35?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e96644c03e3fb7397874115d622e5773 2x, https://si.imgix.net/c4955302/uploads/origins/e68c72e8-f25f-4a83-be2c-4b14c3ebab35?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=4d3e4cbf65b770a06e41191d062ab8a9 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/c4955302/uploads/origins/e68c72e8-f25f-4a83-be2c-4b14c3ebab35?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=352019aa70effa2e61120d13ac359d5f", "srcset": "https://si.imgix.net/c4955302/uploads/origins/e68c72e8-f25f-4a83-be2c-4b14c3ebab35?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=352019aa70effa2e61120d13ac359d5f, https://si.imgix.net/c4955302/uploads/origins/e68c72e8-f25f-4a83-be2c-4b14c3ebab35?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=88ed6598b29a3c1e411102ef068b4992 2x, https://si.imgix.net/c4955302/uploads/origins/e68c72e8-f25f-4a83-be2c-4b14c3ebab35?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=29141048022479fb879a40d86447ac93 3x"}, "body": "初めまして。\n納品絵やX（Twitter）に挙げられている可愛らしい絵柄と素敵なデザインのイラストを拝見してリクエスト致します。\n\n1980年代に不二家より販売されたウエファースチョコ『銀河伝説　バトラーの聖剣』のおまけシールの1枚、\n資料URLの王妃マイリアを、銅貨様が描かれる「リアル頭身」で「生身の姿」をデザインして頂けますでしょうか。\n\nシールでは石化されており、生身の姿がありません（シール自体が第一弾で打ち切りになってしまったので……）。\nまたSDキャラですので、リアルな頭身にして頂くにあたり、カラーリングや細部のデザインは銅貨様にお任せいたします。\nその際、娘のアイララ姫もご参考頂けますと幸いです。\n私の妄想ですが、アイララ姫が14、5歳くらいに見えるので、\n母親であるマイリア妃は30歳前半くらいの包容力のある聖母的、でもどこか妖艶的な美女としてデザインして頂けますと幸いです。\nなお、サンダル履きとして頂き、足の指が見えるようなデザインだと嬉しいです。\n\n以下、資料URL以外の資料になります。\nお手数をお掛け致しますが、ご検討の程よろしくお願いいたします。\n\n・王妃マイリア（裏面）\nhttps://img.mandarake.co.jp/webshopimg/03/00/028/0300590028/03005900281.jpg\n・アイララ姫\nhttps://img.aucfree.com/j586165339.1.jpg\n\nhttps://img.mandarake.co.jp/webshopimg/03/00/028/0300590028/03005900280.jpg", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@pbwdouka/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1161760, "client_id": 2456750, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/8a84f34a/uploads/origins/b3d92698-a9d4-4924-92c1-9392ff0100b6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2f9c6f9ea5354a718f0a88cae598ca85", "srcset": "https://si.imgix.net/8a84f34a/uploads/origins/b3d92698-a9d4-4924-92c1-9392ff0100b6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2f9c6f9ea5354a718f0a88cae598ca85, https://si.imgix.net/8a84f34a/uploads/origins/b3d92698-a9d4-4924-92c1-9392ff0100b6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=433cfdef7dcd65a04c3a859f45744c29 2x, https://si.imgix.net/8a84f34a/uploads/origins/b3d92698-a9d4-4924-92c1-9392ff0100b6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d37b67742306c30984465be09f342d1a 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/8a84f34a/uploads/origins/b3d92698-a9d4-4924-92c1-9392ff0100b6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=44f47d157aed780afd3b8c4057fb9d49", "srcset": "https://si.imgix.net/8a84f34a/uploads/origins/b3d92698-a9d4-4924-92c1-9392ff0100b6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=44f47d157aed780afd3b8c4057fb9d49, https://si.imgix.net/8a84f34a/uploads/origins/b3d92698-a9d4-4924-92c1-9392ff0100b6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=b456d463d39ce7d6c970f65d0320e40f 2x, https://si.imgix.net/8a84f34a/uploads/origins/b3d92698