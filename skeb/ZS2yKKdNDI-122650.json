9-b124-0b63d25cc4db?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=bf8703b48fc4a9a0d8d35e6eba8955ba", "srcset": "https://si.imgix.net/b3424bac/uploads/origins/b193164a-13d0-41a9-b124-0b63d25cc4db?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=bf8703b48fc4a9a0d8d35e6eba8955ba, https://si.imgix.net/b3424bac/uploads/origins/b193164a-13d0-41a9-b124-0b63d25cc4db?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=ac3c34d96c5bfa06a0f2a3643f712ebd 2x, https://si.imgix.net/b3424bac/uploads/origins/b193164a-13d0-41a9-b124-0b63d25cc4db?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=0430632459568cb1fb79de877e133f03 3x"}, "body": "skeb再開されていたのでリクエストさせて頂きます！\n\nシチュ：突然家にやってきた催眠おじさんに人生を根こそぎ滅茶苦茶にされる人妻\n\n描いて頂きたい内容：\n①扉を開けて出てきた女性に対していきなり「おっ！大当たり～！」「可愛くて乳もケツもデカいS級オナホ！」「やっぱ訪問レイプするなら高級住宅地だよな～」「俺のためにお金かけて極上まんこ育ててくれてありがとね！」などとド級のセクハラ発言を連発。\n女性が理解できず困惑している間に即催眠。\n②全裸で土下座して全財産(通帳やクレカや印鑑や権利書など)を男に捧げ、自分をレイプして孕ませて欲しいと懇願する女性。\n男は「え～どうしよっかな～」などと渋るが、「足りないなら借金する」「夫とも今すぐ離婚する」「娘が二人いるので使い捨てオナホとしてお捧げする」など、取り返しのつかないレベルで全てを男に献上してまで犯してもらおうとする。\n③「閉経するまで絶え間なく産ませるから覚悟してね？」「残りの人生ぜ～んぶ俺のガキ育てるために消費しろ」などと言われながらガッツリ犯される女。\n④「ママ～ただいま～！」という声が聞こえ、娘たちも今から犯されることが示唆される。(ここは無くてもいいです)\n\n女性は優しい清楚な世間知らずっぽいお嬢様系、もしくは仕事の出来るキリっとした感じのどちらかでお願いします。\n身体はムチムチでスタイル抜群な感じでお願いします。\nキャラデザはお任せしますがメガネはNG、髪はショートではなく女性らしい長さでお願いします。\n上記のセリフはあくまで例なのでお好きなようにアレンジ・追加して頂けると助かります。\nアサオミさんの書くセリフが大好きなのでセリフ多めにして頂けるととても嬉しいです。ぜひ尊厳破壊強めでお願いします！\n\nコスト的に厳しければ①②のみでも大丈夫です。催眠おじさんによる一時の遊びで、それまで順風満帆だった女性の人生がいきなり蹂躙されブチ壊される悲惨さが一番見たい部分なので。\n\n注文が多くて申し訳ありませんが、ご検討頂ければ幸いです。\nよろしくお願い致します！", "nc": 184, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@ZS2yKKdNDI/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2908475, "client_id": 99663, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/1c4df273/uploads/origins/11fd460f-355e-418b-8c9b-d95bce98633e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2068ab7c4b6b8b7bc8a710290f5604d5", "srcset": "https://si.imgix.net/1c4df273/uploads/origins/11fd460f-355e-418b-8c9b-d95bce98633e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2068ab7c4b6b8b7bc8a710290f5604d5, https://si.imgix.net/1c4df273/uploads/origins/11fd460f-355e-418b-8c9b-d95bce98633e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f311851c0671e519a6363bb051f215aa 2x, https://si.imgix.net/1c4df273/uploads/origins/11fd460f-355e-418b-8c9b-d95bce98633e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=95210d83ea52212afa8fd6e274a5e5bc 3x"}, "duration": null, "nsfw": true, "hardcore": true, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/1c4df273/uploads/origins/11fd460f-355e-418b-8c9b-d95bce98633e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=302905159f198ab867332b353eb1c59a", "srcset": "https://si.imgix.net/1c4df273/uploads/origins/11fd460f-355e-418b-8c9b-d95bce98633e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=302905159f198ab867332b353eb1c59a, https://si.imgix.net/1c4df273/uploads/origins/11fd460f-355e-418b-8c9b-d95bce98633e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=c585c72869165878676b78a6ca89b548 2x, https://si.imgix.net/1c4df273/uploads/origins/11fd460f-355e-418b-8c9b-d95bce98633e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=d996242d6c763cd7d63cfdc1dda20383 3x"}, "body": "初めまして！いつもアサオミさんの作品には非常にお世話になっています！\n折角のチャンスなので依頼させて頂きます。\n催眠とか常識改変とかが大好きで、中でもエロ条例のやつの容赦の無い犯し方や竿役の良い意味でのキモさが本当に大好きで何度もお世話になってたので、同じような世界観(あるいはシンプルに催眠)でリクエストさせて下さい。\n\n描いて頂きたいシチュ：\n臨月のママが小学生の娘と一緒に歩いているところを「あの～ちょっといいですか？」と声を掛けてきた男にいきなり乱暴にガッツリ犯される。\n男は臨月ママが旦那と勝手に赤ちゃん作ったことに理不尽にブチ切れていて「さっさと腹ン中空っぽにして僕のガキ産めクソビッチが！」「破水しろオラッ！」「ここでガキひり出すまで終わんないからね～♡」などと罵倒しながらガン突きする。\n母親か娘本人に「そこの美味そうなロリオナホちゃんは初潮来たの？」と確認し、既に初潮が来ていることが判明すると「やったラッキー！待っててね！今お母さん破水させたらすぐレイプして孕ませてあげるからね！」「JSシングルマザーにしてあげるから！」などと言い、娘もまとめて犯して孕ませることを宣言する。\n\n\n要素全ては入れられないかと思いますので、『初対面の妊婦を破水レイプする』というメインの部分以外は入れられる要素だけ組み込んで頂ければと思います。\n声を掛けるシーンは即堕ちの前振りのようなものなので無くても大丈夫です、お任せします。\nキャラのデザインはお任せしますが、髪は娘、母親共にショートカットではなく女性らしい長さ(ボブやロング等)にして下さい。メガネは掛けさせないで下さい。\n母乳が出てると嬉しいです。\n\n上記のセリフはあくまで例です。イラストはもちろんなんですが、アサオミさんのワードセンスが本当に大好きなのでセリフ等は好きなだけアレンジ・追加して下さい！\nアサオミさんの他の作品のようにセリフ多めにして頂けるととても嬉しいです。尊厳破壊強めでお願いします！\n\n注文が多くて申し訳ありませんがご検討頂ければ幸いです！\n宜しくお願い致します！", "nc": 42, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}], "sent_works": [], "similar_creators": [{"id": 136618, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "午卯ましお", "screen_name": "mn0640", "avatar_url": "https://pbs.twimg.com/profile_images/2010043376117395458/H_ptoRNw.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1522644481312403456/1766918548/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 7, "complete_expiration_days": 50, "skills": [{"genre": "art"}, {"genre": "comic"}, {"genre": "correction"}], "banned": false, "nc": 176}, {"id": 1062051, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "DANGAN", "screen_name": "DANGANminorz3rd", "avatar_url": "https://pbs.twimg.com/profile_images/1822064520472514560/cSIFUwD7.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1819246897745518592/1722641706/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 7, "complete_expiration_days": 120, "skills": [{"genre": "comic"}, {"genre": "art"}], "banned": false, "nc": 32}, {"id": 1229034, "creator": true,