るのが好きじゃない。\n\n◾️リリー・キュアソン\n薄い茶髪に青い目をしている。\nおっとり系に見えるが外見とよりアウトドア派。\nクラインに振り回されているように見えるが反対で振り回している。\n花が好きで特に晴れの日にしか咲かないリビングストンデージーがお気に入り。\n\n◾️関係性\nアメリカ在住の2人は幼馴染で、高校の時にクラインから告白しそこから交際がスタートした。\nお互いに大切にしており天気の良い日には外に出て散歩やフラワーガーデンに出かけている。\n\n\n服装やシュチュエーションは🌻八丁みそ🍉様の描きやすいように書いていただければと思います。\nもし金額が見合わない、資料が足りないなどあれば再送請求をしていただければ幸いです。\nご検討のほど何よろしくお願い申し上げます。\n\nhttps://drive.google.com/drive/folders/1MQOPAiEgA4e8TJ0EazBK8i1Z5wJVliuY?usp=drive_link", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@I3dpi/works/144", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3361201, "client_id": 319807, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/ed34e673/uploads/origins/85b534fe-4aa8-4a28-8f6d-10e2a33a6f5c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5834ca9c114d436522c92c3ea2650f6f", "srcset": "https://si.imgix.net/ed34e673/uploads/origins/85b534fe-4aa8-4a28-8f6d-10e2a33a6f5c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5834ca9c114d436522c92c3ea2650f6f, https://si.imgix.net/ed34e673/uploads/origins/85b534fe-4aa8-4a28-8f6d-10e2a33a6f5c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=9b163b40cbae5cda54323602b036949c 2x, https://si.imgix.net/ed34e673/uploads/origins/85b534fe-4aa8-4a28-8f6d-10e2a33a6f5c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e2c6f0b59145a9c35cc884321e125cb0 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/ed34e673/uploads/origins/85b534fe-4aa8-4a28-8f6d-10e2a33a6f5c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9fca60d1709829597ce9a6a28d4e4401", "srcset": "https://si.imgix.net/ed34e673/uploads/origins/85b534fe-4aa8-4a28-8f6d-10e2a33a6f5c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&bl