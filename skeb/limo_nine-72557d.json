200&h=200&blur=200&s=2a33da849962c45eaf5d029d11f98147", "srcset": "https://si.imgix.net/892725be/uploads/origins/9484bfaf-c7d0-4ec7-bdbc-e74bdb9d5b3c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2a33da849962c45eaf5d029d11f98147, https://si.imgix.net/892725be/uploads/origins/9484bfaf-c7d0-4ec7-bdbc-e74bdb9d5b3c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=d4a75132d18e48c4f3d1a4565388c28e 2x, https://si.imgix.net/892725be/uploads/origins/9484bfaf-c7d0-4ec7-bdbc-e74bdb9d5b3c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=45a2a2e66a3d722d500dc7c4f391a6fa 3x"}, "body": "limo様、初めまして！\nニコニコ動画、Youtubeで歌い手として活動している、飴空と申します。\n\n柔らかいタッチの可愛らしいイラストに心を奪われ、リクエストを送らせていただきました。\n私がインターネットで活動しているときのキャラクターを描いていただきたいです！\n\n・使用用途\nTwitter（現在X）などSNSでの使用\n今後アップする動画等での使用\nBOOTHなどで販売するグッズとしての使用\n\n・納品形式\npsd形式で、人物/背景/文字など、レイヤーで分けていただけると助かります。\n\n・絵柄、ポーズや構図\nポーズや構図について、全てお任せいたします。\n蝶々やお花など、ふんわりと可愛らしい雰囲気で描いていただけると嬉しいです。\n\n・キャラクターの参考\n下記URLに、見た目の詳細、髪色目色の参考などを記載した画像がございますので、そちらを参考に描いていただきたいです。\n衣装について、アレンジや変更も歓迎ですので、お任せいたします。 https://drive.google.com/drive/folders/1oCMEnuUinCsVPVfv1Sv0fUFFwNYsbx5r?usp=sharing\n\n歌うことが大好き。青色と水色が好き。穏やかでマイペース。\nモチーフとして蝶々を描いて欲しいです。\n\n歌声の雰囲気の参考：https://youtu.be/ztDhicBw1ao\n\nご検討のほど、よろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/1oCMEnuUinCsVPVfv1Sv0fUFFwNYsbx5r?usp=sharing", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@limo_nine/works/9", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 664473, "client_id": 27685, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/b6ecad7c/uploads/origins/3db39904-966e-4e7e-b80c-8a43a6e67987?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9176aee08850a1a9b65e07a0286c3951", "srcset": "https://si.imgix.net/b6ecad7c/uploads/origins/3db39904-966e-4e7e-b80c-8a43a6e67987?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9176aee08850a1a9b65e07a0286c3951, https://si.imgix.net/b6ecad7c/uploads/origins/3db39904-966e-4e7e-b80c-8a43a6e67987?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=1b6657bdc10ce75230bf4f279df14c2d 2x, https://si.imgix.net/b6ecad7c/uploads/origins/3db39904-966e-4e7e-b80c-8a43a6e67987?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=cc7b68ab942cf25e231a7945eec7b555 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/b6ecad7c/uploads/origins/3db39904-966e-4e7e-b80c-8a43a6e67987?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=db4924c540590407426c76e53443350e", "srcset": "https://si.imgix.net/b6ecad7c/uploads/origins/3db39904-966e-4e7e-b80c-8a43a6e67987?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=db4924c540590407426c76e53443350e, https://si.imgix.net/b6ecad7c/uploads/origins/3db39904-966e-4e7e-b80c-8a43a6e67987?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=0961fa775e352577ad35a93d2710ca4d 2x, https://si.imgix.net/b6ecad7c/uploads/origins/3db39904-966e-4e7e-b80c-8a43a6e67987?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=77255160b24d1b1b29cffe4bbe6a1a6d 3x"}, "body": "limo様\n\nこんばんは、limo様。\nツイッターからイラストを拝見させて頂いてファンになったものです。\n色がとても上品で美しいです！オリジナルのうさみみちゃんたちに惚れちゃいました！\nそんなlimo様がスケブを開いていらっしゃることを知り、もしよろしければこちらのオリキャラのことを依頼したいです。\n\nお願い申し上げたいのはこちらのオリキャラ狐娘の万里香（まりか）という子です。\n狐耳と尻尾・赤メガネ・アホ毛、そしてちょっぴりツリ目な目つきが特徴的な、160cmくらいの身長の子です。\n本とか、動物や花、星空のような自然をぼーっと見るのが大好きな子です。\n性格的には、ちょっと人見知りで照れ屋ですので人前では余計にクールっぷりしてるけどまた寂しがり屋のちょっと面倒くさい感じです。一人の時や知り合いの前では表情が緩めてちょっと豊かになる感じです。\nこれだけではちょっと説明が足りないと思いますので設定と設定画など、ご参考できそうなものを下のURLにまとめております。\n\nこの娘でlimo様の絵柄でのイラストをどうかお願いしたいです。\n衣装は設定画のうちの一つで、お花畑などの植物の前にいる姿、ってのはどうでしょうか？\nご検討くださいませ！\n\nお忙しい中、要件のみで申し訳ありません。\n応援しております！\n\nhttps://drive.google.com/drive/folders/1kVcp6B8dzGYFGpFb9spMTyDnz0TzyM7Q?usp=sharing", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@limo_nine/works/8", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 664473, "client_id": 3010956, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/a26ffd6f/uploads/origins/bd19694d-cbff-4246-b5a7-797cc48d1453?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6b9ab9632e047312b0f91687aa79ee42", "srcset": "https://si.imgix.net/a26ffd6f/uploads/origins/bd19694d-cbff-4246-b5a7-797cc48d1453?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6b9ab9632e047312b0f91687aa79ee42, https://si.imgix.net/a26ffd6f/uploads/origins/bd19694d-cbff-4246-b5a7-797cc48d1453?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b8b7baf829813b807e60559b2854536e 2x, https://si.imgix.net/a26ffd6f/uploads/origins/bd19694d-cbff-4246-b5a7-797cc48d1453?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=5aeb9072e242a6afe58db3da4da01aec 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/a26ffd6f/uploads/origins/bd19694d-cbff-4246-b5a7-797cc48d1453?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=47c05061f049bd34323252bb324c1e97", "srcset": "https://si.imgix.net/a26ffd6f/uploads/origins/bd19694d-cbff-4246-b5a7-797cc48d1453?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=47c05061f049bd34323252bb324c1e97, https://si.imgix.net/a26ffd6f/uploads/origins/bd19694d-cbff-4246-b5a7-797cc48d1453?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=b7eb08ba006306b33ebd697bb281e360 2x, https://si.imgix.net/a26ffd6f/uploads/origins/bd19694d-cbff-4246-b5a7-797cc4