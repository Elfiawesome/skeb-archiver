理不尽）。\n痛いことは基本的に嫌なので、晃黯から殴られたり蹴られたりするのは普通に嫌がる。おおよそ顔を中心に、見えるところに傷をつけられがち。\nだが逆に夜には晃黯を組み敷いて傷を付けまくっている。噛み跡を付けるのが一番好き。\n家族のことが大好きなので、晃黯と一生共に生きていくつもりでいる。メンヘラ。\n〈台詞例〉\n「……目障りでもなんでもいい。一人より二人の方がお互い安全だから……」\n「ねぇ、兄さんにはおれだけ、おれには兄さんだけ、でしょ？」\n-\nリクエスト内容は以上になります。\nもし承認してくださいましたらとても嬉しいです！何卒よろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/1_HGu4EdyjWGvBEh45ct1zyqlAm2qUE50?usp=sharing", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@yvsqzrv/works/5", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/3112b564/uploads/origins/bf238aaa-e9f3-4005-b19c-f004b2e9e800?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=a4c6e9f542eaa3eac754d552429b792c", "srcset": "https://si.imgix.net/3112b564/uploads/origins/bf238aaa-e9f3-4005-b19c-f004b2e9e800?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=a4c6e9f542eaa3eac754d552429b792c, https://si.imgix.net/3112b564/uploads/origins/bf238aaa-e9f3-4005-b19c-f004b2e9e800?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=1387e587b5630cfd7395aaef566be167 2x, https://si.imgix.net/3112b564/uploads/origins/bf238aaa-e9f3-4005-b19c-f004b2e9e800?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=a58d7a06547f15d7eee9b9684fb3b1da 3x"}, "private": true, "genre": "art", "tipped": false, "creator_id": 3997244, "nc": 0}, {"path": "/@yvsqzrv/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3997244, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.n