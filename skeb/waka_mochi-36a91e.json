6-826b-0743a22c8bd5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9a3cdcfbc66078a7d83673091c3468e6, https://si.imgix.net/25232a9a/uploads/origins/008d1976-8e2c-4526-826b-0743a22c8bd5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=4e9244acb77d57053d1329fd8b5956a7 2x, https://si.imgix.net/25232a9a/uploads/origins/008d1976-8e2c-4526-826b-0743a22c8bd5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=d29b240dce4f08d567425f2f52404d3c 3x"}, "body": "わかもち太先生こんばんは。\n先生の作品はとても奇麗で可愛くて本当に素晴らしいものばかりでいつも感動しております！\n匿名にて恐れ入りますが、リクエストさせて頂ければと思います。\n\nFGOの男性マスター（ぐだ男）(♂)と水着アルトリア・アヴァロン（水着アルトリア・キャスター【狂】の第三再臨）のイチャイチャエッチをお願いできればと思います。\nシチュエーションとしては下記のような雰囲気です。\n\nグランドバーサーカーになったアルトリア・アヴァロンと戴冠戦周回後に魔力回復のため魔力供給することになったマスター。\n最初は「流石のマスターも冠位の私には負けちゃいますよ♡」と自信満々、余裕たっぷりのアルトリア・アヴァロン。でも、マスターにたくさんイチャイチャエッチされていっぱいイクイクさせられちゃう聖剣の守護者。\n負けず嫌いなので「つ、つぎはグランドの私がリードしますからっ」と言ってマスターとまたイチャイチャするけどやっぱりトロトロにされてたっぷり中出し魔力供給されるAAさん、というイメージです。\n\n詳細な構図等は先生の描きやすい形にてお願いできれば幸いです。\n恐れ入りますが、ご作製、ご検討頂けたらと思います。\nどうぞよろしくお願いいたします。", "nc": 176, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@waka_mochi/works/11", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1741780, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/0d2c2f54/uploads/origins/873198ef-0ac2-460d-b814-ba4120fa1674?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=83f6ac2197c1f3ea804832e0c4bb5fa8", "srcset": "https://si.imgix.net/0d2c2f54/uploads/origins/873198ef-0ac2-460d-b814-ba4120fa1674?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=83f6ac2197c1f3ea804832e0c4bb5fa8, https://si.imgix.net/0d2c2f54/uploads/origins/873198ef-0ac2-460d-b814-ba4120fa1674?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=139a3ba8ddaea4bceee9cc4156c281c7 2x, https://si.imgix.net/0d2c2f54/uploads/origins/873198ef-0ac2-460d-b814-ba4120fa1674?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=0cc2d8e444a738d7e348e302512fda5d 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/0d2c2f54/uploads/origins/873198ef-0ac2-460d-b814-ba4120fa1674?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=1c83b2df7bdd45916fbfad0bcadb714a", "srcset": "https://si.imgix.net/0d2c2f54/uploads/origins/873198ef-0ac2-460d-b814-ba4120fa1674?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=1c83b2df7bdd45916fbfad0bcadb714a, https://si.imgix.net/0d2c2f54/uploads/origins/873198ef-0ac2-460d-b814-ba4120fa1674?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=b6156c6427931fe08a51f46a1945c371 2x, https://si.imgix.net/0d2c2f54/uploads/origins/873198ef-0ac2-460d-b814-ba4120fa1674?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=096ef8fbd4771bfacd4f8f6354558265 3x"}, "body": "わかもち太先生こんにちは。\n先生の作品はとても奇麗で可愛くて本当に素晴らしいものばかりなのでリクエストをさせて頂きたく思います。\n匿名にて恐れ入りますが、リクエストさせて頂ければと思います。\n\nFGOの男性マスター藤丸立香君（ぐだ男）(♂)と水着のアルトリア・キャスター（狂）（第一再臨）のイチャイチャエッチをお願いできればと思います。\nシチュエーションとしては下記のような雰囲気です。\n\nシミュレーターのバグで『たくさんイチャイチャしないと出られない部屋』に閉じ込められた二人。\n「助けが来るのを待とう」と言うマスターに「……イチャイチャしたら出られるかもしれませんよ？　マスターとなら、いいよ？」と答えるアルトリア。\nそのままイチャイチャエッチを開始する二人。でも、部屋からは出られません。\n「アルキャス、やっぱり外の救助を待った方が……」\n「……もっとイチャイチャしないとダメなのかも……マスターはスタミナ切れ？　ふ～ん、人類最後のマスターって持久力、ないんですね？」\nトロトロな表情でアルキャスにお誘いされるマスター。二人は更にイチャイチャラブラブなエッチをたくさんして、キスしたりイクイクしたり、中出しをするけど部屋からは出られません。\n結局、助けがくるまでず～っとイチャイチャしちゃう二人、という形です。\n\n構図等は先生の描きやすい形にてお願いできれば幸いです。\n恐れ入りますが、ご作製、ご検討頂けたらと思います。\nどうぞよろしくお願いいたします。", "nc": 48, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@waka_mochi/works/10", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1741780, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/a183c453/uploads/origins/dbc403eb-9523-4a9b-9f78-b3c6e8032dbb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b19eff7b00b246f5debabc6a4903ed3e", "srcset": "https://si.imgix.net/a183c453/uploads/origins/dbc403eb-9523-4a9b-9f78-b3c6e8032dbb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b19eff7b00b246f5debabc6a4903ed3e, https://si.imgix.net/a183c453/uploads/origins/dbc403eb-9523-4a9b-9f78-b3c6e8032dbb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=9e5a6443a2b874deddaa77d87c849093 2x, https://si.imgix.net/a183c453/uploads/origins/dbc403eb-9523-4a9b-9f78-b3c6e8032dbb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a989149202326a0d3db8ccb78dd60f4e 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/a183c453/uploads/origins/dbc403eb-9523-4a9b-9f78-b3c6e8032dbb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=07fef7f58a3d33a90494e268afa0f89b", "srcset": "https://si.imgix.net/a183c453/uploads/origins/dbc403eb-9523-4a9b-9f78-b3c6e8032dbb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=07fef7f58a3d33a90494e268afa0f89b, https://si.imgix.net/a183c453/uploads/origins/dbc403eb-9523-4a9b-9f78-b3c6e8032dbb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=1e42555357bed81a0610aa667298a8df 2x, https://si.imgix.net/a183c453/uploads/origins/dbc403eb-9523-4a9b-9f78-b3c6e8032dbb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=28fd78d617d32e0ddbc2581920488f6d 3x"}, "body": "わかもち太先生こんばんは。先生の作品はとても可愛く素晴らしいものばかりで凄いです。\n匿名にて恐れ入りますが、リクエストさせて頂ければと思います。\n\n作品はFGOにて男性マスター、藤丸立香【ぐだ男】と水着アルトリア・アヴァロン（水着アルトリア・キャスター【狂】の第三再臨）のイチャラブエッチをお願いできればと思います。\nアルトリアの衣装は出来るだけそのままにしてもらえたら幸いです。\nシチュエーションは下記のイメージです。\n\n『三日経つか、エッチでマスターが先にイかないと出られない部屋』に閉じ込められた二人。\n「……う～ん、三日待とうか？　AA？」\n「いえ！　ここはもう一つの選択肢にしましょう！」\nとエッチする気満々なアルトリア・アヴァロン。\nいざエッチになるけれど、マスターがイくまでに何回もイってしまうAA。\n「…………やっぱり三日待たない？」\n「ぃ、いえっ！　いまのはたまたまです！　つぎはまけませんっ」\n困り顔のマスターに負けず嫌いを発動するAA。\nそのまま何回もエッチする二人。\nだんだんラブラブなエッチが目的になっていく。\n「あ♡　これ、すっご！　ヤッバ！　りつか、また、またイッちゃう！　イッちゃうってば！」\n「……また先にイッちゃったねAA？」\n「だ、だってりつかがつよつよだからっ、マスターエッチ凄いから……」\n「…………」\n「あっ♡　また！　さっきよりつよくなったっ！　ヤバッ、またイッ！」\nと言う感じで結局、一度もマスターは先にイかないまま、三日間エッチをし続けて、自動で部屋から出られました、という流れです。\n\n構図等は先生の描きやすい形にして頂ければと思います。\nご作製、ご検討頂けたら幸いです。", "nc": 177, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@waka_mochi/works/9", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1741780, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/9dc96de2/uploads/origins/855df13b-de0e-4510-9f3b-bc6a7caa3cab?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8e900bba13a7a2d520f8a989a99e9c14", "srcset": "https://si.imgix.net/9dc96de2/uploads/origins/855df13b-de0e-4510-9f3b-bc6a7caa3cab?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8e900bba13a7a2d520f8a989a99e9c14, https://si.imgix.net/9dc96de2/uploads/origins/855df13b-de0e-4510-9f3b-bc6a7caa3cab?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=53826b00840e0db55174b286fe78f47d 2x, https://si.imgix.net/9dc96de2/uploads/origins/855df13b-de0e-4510-9f3b-bc6a7caa3cab?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=312406573b31861770eb313da41b46bf 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/9dc96de2/uploads/origins/855df13b-de0e-4510-9f3b-bc6a7caa3cab?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=95fa81911516069dd84af458eb1e7480", "srcset": "https://si.imgix.net/9dc96de2/uploads/origins/855df13b-de0e-4510-9f3b-bc6a7caa3cab?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=95fa81911516069dd84af458eb1e7480, https://si.imgix.net/9dc96de2/uploads/origins/855df13b-de0e-4510-9f3b-bc6a7caa3cab?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=efbf116acf59f57c1f09dd39b038e5bc 2x, https://si.imgix.net/9dc96de2/uploads/origins/855df13b-de0e-4510-9f3b-bc6a7caa3cab?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=57eabf223c97bbdd5926408a777b996d 3x"}, "body": "はじめまして。skeb内での検索で、魅力的なアルトリアキャスターを見て知りました。\n匿名でのリクエストになるのですが、不都合なければご検討いただきたいです。\n\nキャラクター：出雲阿国（Fate/Grand Order）\n\n服装、希望は第一か第三再臨の物ですが和服で作画コスト高いようならば舞台衣装っぽい服装を。\n\nシチュエーションとしては、舞台裏か舞台袖で胸元を見せて誘惑してきた阿国さん。\nが、攻めに攻められて余裕がなくなり、息も絶え絶えに止めようとするもやめてもらえず。\nといったイメージでお願いします。\nえっちの最中は、服の胸元が乱れ（着崩れ）て片方の胸を露出させて頂きたいです。\n\nその他台詞含む書いてないことは全面的にお任せします。\n\n改めて、匿名でのリクエスト申し訳ありません。支障なければよろしくお願いします。", "nc": 161, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@waka_mochi/works/8", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1741780, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/54fdeef3/uploads/origins/e43a289a-f156-4045-a37c-af5af092586e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9c2e2355ce54e310b5b2ff9cf1679068", "srcset": "https://si.imgix.net/54fdeef3/uploads/origins/e43a289a-f156-4045-a37c-af5af092586e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9c2e2355ce54e310b5b2ff9cf1679068, https://si.imgix.net/54fdeef3/uploads/origins/e43a289a-f156-4045-a37c-af5af092586e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=345e63d4f99bdd9897ee28d6a377d5d9 2x, https://si.imgix.net/54fdeef3/uploads/origins/e43a289a-f156-4045-a37c-af5af092586e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ddbb29884ff74943974da33de12d72a4 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/54fdeef3/uploads/origins/e43a289a-f156-4045-a37c-af5af092586e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=35c7fa5292c2a6d51ea20924f3db4bb3", "srcset": "https://si.imgix.net/54fdeef3/uploads/origins/e43a289a-f156-4045-a37c-af5af092586e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=35c7fa5292c2a6d51ea20924f3db4bb3, https://si.imgix.net/54fdeef3/uploads/origins/e43a289a-f156-4045-a37c-af5af092586e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=46409078234cf55583474771675056e9 2x, https://si.imgix.net/54fdeef3/uploads/origins/e43a289a-f156-4045-a37c-af5af092586e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=f35d4847bd3fe53562393109cdce0d07 3x"}, "body": "こんばんは。匿名にて失礼致します。\n先生のイラストは奇麗で繊細で、本当に素晴らしいものばかりなのでリクエストをさせて頂きたく思います。\n\nFGOの藤丸立香君（ぐだ男）(♂)と水着のアルトリア・キャスター（狂）（第一再臨）がイチャラブエッチをしているイラストをお願いしたく思います。\nよろしければ、アルトリアの衣装や帽子は出来るだけ着ている形にしてもらえたらと思います。\n\n最初はアルトリアの方が「今日はぜったい負けませんからね！　かくごしろぉ」と余裕を見せながら立香を攻める形で魔力供給エッチをしている形です。\n途中で攻守が逆転してアルトリアがたくさん攻められて、「待って、りつか、ちょっと待ってっ」と彼女に言われても全然待たないマスターという流れでお願いしたいです。\n最後は魔力供給とは関係ないラブラブなエッチをしている二人を描いて頂きたく思います。\nだんだん余裕がなくなってとろけてしまうアルトリアとマスターのイチャイチャラブラブなエッチをお願いしたいです。\n構図等は先生が描きやすい形でご対応いただき大丈夫です。\n二人が幸せそうにイチャラブエッチをしているシーンを拝見できればと思います。\n\n恐れ入りますが、ご一考頂けたら幸いです。\nどうぞよろしくお願いいたします。", "nc": 33, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@waka_mochi/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1741780, "client_id": 347334, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/d57c6165/uploads/origins/94ff0766-9a56-4845-9795-b079f23bb915?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b5730b46114f2427e67e18e224365898", "srcset": "https://si.imgix.net/d57c6165/uploads/origins/94ff0766-9a56-4845-9795-b079f23bb915?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b5730b46114f2427e67e18e224365898, https://si.imgix.net/d57c6165/uploads/origins/94ff0766-9a56-4845-9795-b079f23bb915?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a0fb138106183021b88b56fdceeeaf2b 2x, https://si.imgix.net/d57c6165/uploads/origins/94ff0766-9a56-4845-9795-b079f23bb915?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=9704cc4674c7f1c8eb8ef823435a58d8 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/d57c6165/uploads/origins/94ff0766-9a56-4845-9795-b079f23bb915?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=19174890aea9f0bbeb5c87af5fae9ae2", "srcset": "https://si.imgix.net/d57c6165/uploads/origins/94ff0766-9a56-4845-9795-b079f23bb915?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=19174890aea9f0bbeb5c87af5fae9ae2, https://si.imgix.net/d57c6165/uploads/origins/94ff0766-9a56-4845-9795-b079f23bb915?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=c4270509181d803294d4f9ab757f4c88 2x, https://si.imgix.net/d57c6165/uploads/origins/94ff0766-9a56-4845-9795-b079f23bb915?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=6b8390873380facaadca787715a45dca 3x"}, "body": "新規リクエスト受付中とのことなので、以前のメリュジーヌに続き、再びのリクエストの方お願いさせていただければと。\n　もしお受けいただけたら大変嬉しいです。　\n\n\n\nキャラクター：\n　FGOのアルトリア・アヴァロン（水着）\n\n　AAの最終再臨イラスト\n　https://i.imgur.com/NPF4Ryh.jpg\n\n\nキャラデザ：\n　顔の書き方は、「イチャイチャしたいモルガンさん」の1コマ目に近い感じでお願いしたいです。\n　https://www.pixiv.net/artworks/102624560\n\n　AAとは姉妹関係ですし、このモルガンの顔、特に好みの書き方なので！\n\n　しかし1コマ目は横顔希望なので（後述）、もし難しいなら、「(9月23日)制作途中のイラスト」のメリュジーヌの一番下のラフの2コマ目みたいな顔の書き方でもOKです。\n　https://waka-mochi.fanbox.cc/posts/6720042\n\n　こちらの横顔も大変どストライクなので！\n\n\n服装：\n　第三臨・最終再臨の水着で。背中をとびきりにセクシーにして下さい！\n　あとキュッとしたくびれをつけていただければと。\n\n\nシチュエーション：\n　「妖精騎士トリスタン×逆バニー」みたいに、奥にベッドがあるとわかる背景で。\n　https://www.pixiv.net/artworks/92505230\n\n\n全体構図：\n　いつもわかもち太先生が描いているような2コマ漫画。\n\n\n1コマ目構図：\n　ベッドの前で直立するAAにぐだが後ろから、脇を通して水着の胸元に左手を差し入れている。\n　それに対しAAは左半分ほど顔を見返りさせて、こちらに流し目を向けている。\n\n\n1コマ目：\n　セリフ1「魔力供給（ルビ：それ）がお望みとあらば 応えるに否はありませんが……」\n\n　セリフ2「聖剣に過ぎない私では、満足させられるかはわかりませんよ？」\n\n　AAの左手：水着の内側から直に自分の左胸を揉んでいるぐだの左手に、水着の上から押さえる、手を添えるように重ねている。萌え袖で、指は細めで。\n　AAの右手：背中にある白い結び目を引っ張りほどいて、「しゅるっ……♡」という音が響く。AAも剣を気取っていながらも乗り気。\n\n　水着のAAの大きく開いて露わになっている背中に、一筋汗が滴っているとセクシーでベストです。\n　AAの白い袖の裏地が、濃いめの色合いであるところも意識してもらえると嬉しいです。（最終再臨の左手参照）\n　\n　袖の裏地の色\n　https://i.imgur.com/b6P21Yp.jpg\n\n　差分として、顔は\n　・頬染めなし\n　・照れて頬に朱が差してる\n　・照れ照れで顔真っ赤\nの3パターンで頂きたいです（その分ちょっと料金乗せてます）。\n\n\n2コマ目構図：\n　「カーマちゃんの弱点」の2コマ目みたいな構図を希望です。\n　https://www.pixiv.net/artworks/92156005\n\n2コマ目：\n　先程までの期待と余裕が消し飛ぶくらいに、満足するまでたっぷりとわからせられているAA。体位は立ちバックで。\n　蕩けた瞳で、声にならない喘ぎ声を必死に絞り出して、なんとかぐだを静止する言葉にしようと必死。構図元のカーマちゃんよりかは余裕なさげに。\n\n　こちらのセリフ内容はおまかせします。いっそ余裕を失ってAAの口調崩れてのキャストリア口調でもいいかもです。\n\n\nその他：\n　ファイル形式はpsdとpngを希望です。\n\n\n\n　また長々と書いてしまいましたが、リクエストの方、どうぞよろしくお願いします！", "nc": 161, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@waka_mochi/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1741780, "client_id": 347334, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/298a2441/uploads/origins/a29dd73c-bba1-4bc8-9af3-fccef8f755fe?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=be2c61e193a26c5515fcd7473346f118", "srcset": "https://si.imgix.net/298a2441/uploads/origins/a29dd73c-bba1-4bc8-9af3-fccef8f755fe?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=be2c61e193a26c5515fcd7473346f118, https://si.imgix.net/298a2441/uploads/origins/a29dd73c-bba1-4bc8-9af3-fccef8f755fe?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=d356f953d7dcf6e011e1fc9d7c69da76 2x, https://si.imgix.net/298a2441/uploads/origins/a29dd73c-bba1-4bc8-9af3-fccef8f755fe?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=92f4a99ff4a91e262578fd37a42ae73f 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/298a2441/uploads/origins/a29dd73c-bba1-4bc8-9af3-fccef8f755fe?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ce3080869d526ac307b164a8341aa7f4", "srcset": "https://si.imgix.net/298a2441/uploads/origins/a29dd73c-bba1-4bc8-9af3-fccef8f755fe?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ce3080869d526ac307b164a8341aa7f4, https://si.imgix.net/298a2441/uploads/origins/a29dd73c-bba1-4bc8-9af3-fccef8f755fe?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=3b59ad7851a6f95de3887462fc269c0a 2x, https://si.imgix.net/298a2441/uploads/origins/a29dd73c-bba1-4bc8-9af3-fccef8f755fe?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=a9fb7203c14973d500297e72a6ae84d9 3x"}, "body": "以前リクエストさせていただいた内容ですが、ちょうど承認待ちの間に手数料無料キャンペーンのメールが来ましたので、良かれと思いキャンセル→再リクエストさせて頂きます。\n\nあと、前回のリクエストの際、依頼に挨拶の一つもなく大変失礼しました……なにぶん初リクエストだったものでして。ご容赦いただければ幸いです。\n何かと刺さる作品の多いわかもち太先生がリクエストを受け付けているということで、今回リクの方送らせて頂きます。\n\n\n\nキャラクター：FGOのメリュジーヌ\n\nキャラデザ：胸は少し盛る程度で。太ももはむっちりでお願いします\n\n服装：第二臨の騎士服。霊衣のレースのバイザーの差分があると嬉しいです\n　　　その場合、バイザーは半分透過というか、バイザーの上からでも瞳が見える感じで\n\n　　　CHOCO先生のメリュジーヌの画像ツイート。右・2枚めの方です\n　　　https://twitter.com/choco_mugi/status/1416398684049133571\n\n　　　第二臨のバイザー霊衣。ゲーム画面からのスクショです\n　　　https://i.imgur.com/EZAWXnX.jpg\n\n\nシチュエーション：マイルームのベッド上\n\n全体構図：いつもわかもち太さんが描いているような2コマ漫画\n\n\n1コマ目構図：視点はベッドの上で仰向けになっているぐだ男のもの。わかもち太さんがよく描いているやつで\n\n1コマ目：メリュジーヌが仰向けになっているぐだの上にまたがっている。またがっている場所はお腹あたりで、まだ挿れてない\n　　　　そのむっちりした太ももでぐだを挟み込んでいる感じ。擬音に「むちっ♡」というのが2つ以上欲しいです\n\n　　　　白のニーソと太ももの絶対領域の境目のところに、レースが肉を圧迫している、むにっとした段差もお願いします\n\n　　　　右手でぐだの右胸を押さえつけ、左手でぐだの右手をつかんで、自分の白いインナーの上から胸に押し付けさせている。「むに♡」という擬音があるとベスト\n　　　　体が小さいので前屈気味で、その分距離が近くて、整った顔がよく見える。そのギラついた目も\n\n\n　　　　セリフ1「つがいをこんなにも寂しがらせるなんていけないマスターだなぁ……」\n　　　　セリフ2「おあずけをし続けた償いをしてもらうよ？　今夜は覚悟してね……」\n\n\n　　　　そう口にするメリュジーヌは、顔は騎士としてのキリッとしたもの\n　　　　だけど切れ長の瞳、その瞳孔が竜のもので、飢えた獣の如くギラギラしてる感じ\n　　　　片目は細めていて、もう片方の目がじろりと見開いている\n\n　　　　こめかみや太ももに薄く汗をかいていて、口の端から、興奮を表すように僅かに蒸気が立ち上っているとイイです\n\n\n2コマ目構図：わかもち太さんの「イチャイチャしたいモルガンさん」の2コマ目と同じような感じで、真横ベースからやや斜めからの視点のもの\n\n　　　　　　「イチャイチャしたいモルガンさん」\n　　　　　　https://www.pixiv.net/artworks/102624560\n\n\n2コマ目：スイッチが入ったぐだに逆転されて、たっぷりわからせられているメリュジーヌ\n　　　　ぐだが上の正常位で、容赦なく突きこまれている\n\n　　　　メリュジーヌの服は、首元から肩にかけてのアクセは外れていて、首にひっかかっているだけ\n　　　　ズレた首元の薔薇の飾りと隣り合うように、首にキスマークが一つ付いている\n　　　　お腹の留具は全て外れていて、胸元から中途半端にめくれているといい感じです\n\n\n　　　　セリフ1「こ、これすごいっ♡　ああっ、来るっ♡」\n　　　　セリフ2「ダメっ♡　お願い、待っれっ♡　マスターっ！♡」\n　　　　セリフ3「～～～～！！♡♡♡♡」\n\n\n　　　　セリフ3は呂律回ってない感じに、言葉にならない声で、止まるよう懇願する風に\n　　　　1コマ目で細めていた瞳を、今度は一杯に見開いて。ぐだを見つめながら突きこまれている\n\n　　　　書いておいてなんですが、2コマ目のセリフはそちらの判断である程度追加・改変させてしまってもOKです\n　　　　うまくハマるえっちぃ感じのが浮かびましたら、遠慮なくそちらを採用してください\n\n\n　　　　メリュジーヌは1コマ目とは打って変わって、その両手を必死に伸ばしてぐだを押し留めようとしてる\n　　　　けど腕が短くて、手が届くか届かないかの距離で、抵抗が功を奏しておらずされるがままになっている\n\n\nその他：\n顔の書き方は、わかもち太さんの\n\n「妖精騎士トリスタンわからせ反撃」の2コマ目\nhttps://www.pixiv.net/artworks/92010400\n\n「妖精騎士トリスタン×逆バニー」の1コマ目\nhttps://www.pixiv.net/artworks/92505230\n\n「水着アナスタシア」\nhttps://www.pixiv.net/artworks/93006323\n\n「イチャイチャしたいモルガンさん」の1コマ目\nhttps://www.pixiv.net/artworks/102624560\n\nなどのものが特に好みなので、それに近くなるようお願いします。（タイトルはPIXIVのものです）\n\n1コマ目は、本当にスパダリ感あふれるイケメン美少女を全開でひとつお願いしたいです。\n\n\nファイル形式はpsdとpngを希望です。\n\n\n\n長々と書いてしまいましたが、リクエスト、受けていただけると大変嬉しいです。どうぞよろしくお願いします。\n\nhttps://twitter.com/choco_mugi/status/1416398684049133571", "nc": 168, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@waka_mochi/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1741780, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/932270be/uploads/origins/7b2f94db-36ed-49f2-9966-e91cb4c38cff?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=20