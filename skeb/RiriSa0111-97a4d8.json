p&crop=top&w=200&h=200&s=cde6429e8fcdb2dd1fd967bc1fb92ffa 2x, https://si.imgix.net/712cdb54/uploads/origins/fd76d295-1cdc-46f3-b6bd-48f4ff3b4eef?bg=%23fff&fm=webp&auto=compress&dpr=3&fit=crop&crop=top&w=200&h=200&s=f9fc470260f9cdf253f73400ee33b8f1 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/712cdb54/uploads/origins/fd76d295-1cdc-46f3-b6bd-48f4ff3b4eef?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&blur=200&s=722a93030186159b08143d7e3f0b78d5", "srcset": "https://si.imgix.net/712cdb54/uploads/origins/fd76d295-1cdc-46f3-b6bd-48f4ff3b4eef?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&blur=200&s=722a93030186159b08143d7e3f0b78d5, https://si.imgix.net/712cdb54/uploads/origins/fd76d295-1cdc-46f3-b6bd-48f4ff3b4eef?bg=%23fff&fm=webp&auto=compress&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=19ce138911301e6eaf8c7aa0033558af 2x, https://si.imgix.net/712cdb54/uploads/origins/fd76d295-1cdc-46f3-b6bd-48f4ff3b4eef?bg=%23fff&fm=webp&auto=compress&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=514d17d154b8c25a1a574510c8fe02b9 3x"}, "body": "はじめまして！個人でVTuber活動をしております、はなごろもと申します。\n\nmiroさまの愛らしいミニキャラ詰め込みイラストを一覧で拝見し、ぜひ私も沢山詰め込んで描いていただきたくリクエスト致しました。\n\n■キャラクターデザイン\nhttps://x.com/v_hanagoromo/status/1911414334300758375\n（３枚目の２面図。差分衣装と髪型は気に入ったものを使用いただければと思います）\n\nグッズ化・返礼品使用などの商用利用はいたしませんが、チャンネルは収益化済です。\nサムネ使用のため、背景透過いただけますと助かります。\n\n以上、ご検討いただけますと幸いです。", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@RiriSa0111/works/8", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3545328, "client_id": 3005300, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/7131feb0/uploads/origins/293e8b40-e5b5-460e-8400-150010647291?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&s=4579e86a91c396926f26f666349d836a", "srcset": "https://si.imgix.net/7131feb0/uploads/or