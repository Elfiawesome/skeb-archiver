ーズやその他のディテールはあなたが自由にコントロールできます。\n\nよろしくお願いします。\n\nhttps://drive.google.com/drive/folders/1jp_XhY6THVdWGPv1soCl7kw_4trUEQU5?usp=sharing", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@kaburagi_y/works/7", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/8252b326/uploads/origins/ee3af22a-f700-434d-8218-0da8f9c6c39d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=b30b1ab903fba6ffec4bf9932f2d172b", "srcset": "https://si.imgix.net/8252b326/uploads/origins/ee3af22a-f700-434d-8218-0da8f9c6c39d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=b30b1ab903fba6ffec4bf9932f2d172b, https://si.imgix.net/8252b326/uploads/origins/ee3af22a-f700-434d-8218-0da8f9c6c39d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=c4c1e9924af062bfc30fe035f2b5746a 2x, https://si.imgix.net/8252b326/uploads/origins/ee3af22a-f700-434d-8218-0da8f9c6c39d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=c228cd78c6311c415348cd964ccd8108 3x"}, "private": true, "genre": "art", "tipped": false, "creator_id": 1135207, "nc": 177}, {"path": "/@kaburagi_y/works/6", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/059835d8/uploads/origins/86ace806-51cf-4e5e-9bcf-35301b81f634?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=a92dae4a719b3e140536ef41833d0f72", "srcset": "https://si.imgix.net/059835d8/uploads/origins/86ace806-51cf-4e5e-9bcf-35301b81f6