p=top&w=200&h=200&blur=200&s=ae3df78c2864b05b831347f0045ef5fc 3x"}, "body": "とらつき様\n初めまして、うららと申します。\n卓すきでお見掛けしたイラストがとても素敵で、ぜひ今回ご依頼させていただければと思います。\n\nCoC「かいぶつたちとマホラカルト」に参加した自PCをお願いできればと思います。\n名前：狼希\n性別：女\n容姿：紫髪金目。髪型は腰まであるロングヘアに細めの縦ロール。ツリ眉ツリ目、化粧含め派手めな顔立ち\n　　　服装は女優さんが着てそうな派出めドレス＋ハイヒール姿、アクセサリーも大きめのものを身に着けている\n　　　身長170cm、色白め、全体的に細身ですが胸だけあるタイプ\n　　　容姿をころころ変えるタイプなので、髪型や服装、アクセサリー等は描きやすいよう変更いただいて問題ありません。\n性格：見た目に違わず派手好きで、享楽主義のアウトロー。口の悪い俺様系お姉さん。\n\n構図・ポーズなどもおまかせにできればと思います。\n以下、参考画像になります。\nhttps://takusuki.com/notes/a56kjpqfon\n\nご一考いただければと思います。", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@tigerpger/works/9", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 215505, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/b2590263/uploads/origins/5aaaf3c9-0c30-4602-bbfd-6ec1d6830137?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=14f4d74d3eb93511f91f6d860d989d7d", "srcset": "https://si.imgix.net/b2590263/uploads/origins/5aaaf3c9-0c30-4602-bbfd-6ec1d6830137?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=14f4d74d3eb93511f91f6d860d989d7d, https://si.imgix.net/b2590263/uploads/origins/5aaaf3c9-0c30-4602-bbfd-6ec1d6830137?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=7e3821d6a61e5d4272dd19fcf9766ee0 2x, https://si.imgix.net/b2590263/uploads/origins/5aaaf3c9-0c30-4602-bbfd-6ec1d6830137?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=0c3ebb46456570a05ee1709c8f6bcafe 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/b2590263/uploads/origins/5aaaf3c9-0c30-4602-bbfd-6ec1d6830137?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=4c8d02f06ee396e121950adaedc3c950", "srcset": "https://si.imgix.net/b2590263/uploads/origins/5aaaf3c9-0c30-4602-bbfd-6ec1d6830137?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=4c8d02f06ee396e121950adaedc3c950, https://si.imgix.net/b2590263/uploads/origins/5aaaf3c9-0c30-4602-bbfd-6ec1d6830137?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=6d3760609f2c74d3cd7dea355eefd6b1 2x, https://si.imgix.net/b2590263/uploads/origins/5aaaf3c9-0c30-4602-bbfd-6ec1d6830137?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=d59b1cfb40903c2090d4b28f761c121b 3x"}, "body": "初めまして、こんにちは！\nたくすきでイラストをお見かけし、とても素敵なイラストでしたので、TRPGで使用したOCたちについて、イラストを描いていただければと思い依頼させていただいております。\n金額・リクエスト共に問題があればキャンセルもしくは再送をお願いいたします。\n\n\n【依頼内容】\n添付させていただいた資料にあるOCたちについて、戦闘を挑まれている姿を描いていただけないでしょうか\n天使の子はおいで、挑戦者！みたいな形で真剣に挑まれているのを受け止めており、\n悪魔の子は天使の子をバックハグで後ろから支えつつ、ニヒルな表情で挑戦者を見ています。\n\nつたない文章で申し訳ございません。\nぜひご検討していただければと存じます。\n\n【添付資料】\n立ち絵を保存しております。\nhttps://drive.google.com/drive/folders/1q2guvdLdzu8jAQwELGtx-6r9YQUByY2X?usp=sharing", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@tigerpger/works/8", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 215505, "client_id": 2010193, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/5c8ee523/uploads/origins/3aaebf4f-e091-4bce-b267-9230c659e887?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2c0efebc6c460b8159ec99db8aca99dd", "srcset": "https://si.imgix.net/5c8ee523/uploads/origins/3aaebf4f-e091-4bce-b267-9230c659e887?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2c0efebc6c460b8159ec99db8aca99dd, https://si.imgix.net/5c8ee523/uploads/origins/3aaebf4f-e091-4bce-b267-9230c659e887?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=5bf190213e530839c9f1e412f84bc42d 2x, https://si.imgix.net/5c8ee523/uploads/origins/3aaebf4f-e091-4bce-b267-9230c659e887?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=fc4b63dae8134dc02f2e92a081632900 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/5c8ee523/uploads/origins/3aaebf4f-e091-4bce-b267-9230c659e887?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=48ce95ae4efccb5fae678888ff20cdf7", "srcset": "https://si.imgix.net/5c8ee523/uploads/origins/3aaebf4f-e091-4bce-b267-9230c659e887?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=48ce95ae4efccb5fae678888ff20cdf7, https://si.imgix.net/5c8ee523/uploads/origins/3aaebf4f-e091-4bce-b267-9230c659e887?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=a6ac1a5068d539fb558f5e82d2e4deb6 2x, https://si.imgix.net/5c8ee523/uploads/origins/3aaebf4f-e091-4bce-b267-9230c659e887?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=f9fb6dd391ad7d95f2463d143a5105f7 3x"}, "body": "とらつき様、初めまして、ウニクロスと申します。\nこの度は是非貴方様に友人とのOCをお描きしていただきたくご依頼させていただきました。\n双方ともに男性キャラクターですので、金額・リクエスト共に問題があればキャンセルもしくは再送をお願いします。\n\n【依頼内容】\n資料にある二人のイラストをお願いしたいです。\nこの二人はTRPGで制作したOCとなります。\n構図・服装に関しましてはご自由にしていただいても結構です。\nとらつき様が描きやすいようにお好きにお描きください。\n\n【使用用途につきまして】\n・自分とお相手様のSNSやdiscordでの壁紙やアイコンへの設定。\n・お描きいただいた際の報告時にSNSにてURLと共に掲載等。\n・自分とお相手方用の個人観賞用・非商用グッズ化\n・いずれも個人使用用途の域を出ないもの。\n\nとても大事な子達です、ご縁があれば是非よろしくおねがいします。\n\nhttps://drive.google.com/drive/u/0/folders/1T1vR8ZFBddBrk1PhOG9JgmBY-zBVGRga", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@tigerpger/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 215505, "client_id": 452170, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/fa5bd611/uploads/origins/85b873d8-32e6-4d11-8d9c-bb76bb1e4d0e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=60e19d09a2016c10024f1d15fe6f2039", "srcset": "https://si.imgix.net/fa5bd611/uploads/origins/85b873d8-32e6-4d11-8d9c-bb76bb1e4d0e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=60e19d09a2016c10024f1d15fe6f2039, https://si.imgix.net/fa5bd611/uploads/origins/85b873d8-32e6-4d11-8d9c-bb76bb1e4d0e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e43837e5d8aa4e2e1315c704b98caacb 2x, https://si.imgix.net/fa5bd611/uploads/origins/85b873d8-32e6-4d11-8d9c-bb76bb1e4d0e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ae9d706c6829cffc33f71994dd5b1c5f 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/fa5bd611/uploads/origins/85b873d8-32e6-4d11-8d9c-bb76bb1e4d0e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5cc5a34a3b4bb553659dcdb0837091e1", "srcset": "https://si.imgix.net/fa5bd611/uploads/origins/85b873d8-32e6-4d11-8d9c-bb76bb1e4d0e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5cc5a34a3b4bb553659dcdb0837091e1, https://si.imgix.net/fa5bd611/uploads/origins/85b873d8-32e6-4d11-8d9c-bb76bb1e4d0e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=ed266ca469647d177bfcfacdb8e98bcc 2x, https://si.imgix.net/fa5bd611/uploads/origins/85b873d8-32e6-4d11-8d9c-bb76bb1e4d0e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=4b9103058a78a3adf08921072cd5a352 3x"}, "body": "虎憑きさん！いつもお世話になっております。\nもしよければと思い、改めてリクエストに参りました。\n\nもしよければ、OCの『ミゼラ（Misera Amalgam August）』をお願いできますでしょうか？\n・連邦国軍部・統合参謀総長の壮年の男\n　戦乱の中に生まれ、戦争に生きているような生い立ちと性分を持ちます\n・年齢はおよそ35歳くらい\n　身長も175cm超ありますが、ヒール等でもう少し高く見える程度の威圧感\n・生まれ育った地は山岳が国の半分以上を占めており、\n　一年のほとんどを豪雪の冬の中で過ごすことになるような国柄\n・喜怒哀楽における楽が7～8割を占めている性分であり、\n　日々好奇心と欲求を満たすことに余念がありません\n　また、飲酒などの嗜好品趣味などがあります\n・専ら作戦指揮を執ることが仕事のメインですが、自ら戦場に出ることに一切抵抗はありません\n　良くも悪くも、近い間柄に対してはとりわけ強い影響力を持っています\n・キャラクターの設計として、大勢の部下を率いるボスの狼をイメージしています\n※使用用途としては、ごく個人的な観賞のみになります\n　可能であればPCの背景画像などで使わせていただけると幸いです\n※シチュエーションの厳密な指定はありませんが、雪・冬などのテーマがあると嬉しいです。\n\n外観の参考資料としてURLを付属させていただきましたが、必ずしも参考資料通りの衣装である必要はありません。\nご検討よろしくお願い致します！\n\nhttps://drive.google.com/drive/folders/1LWklbe00IMExwhpnVtKih3muWEXQZeCd?usp=sharing", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@tigerpger/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 215505, "client_id": 809527, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/ec9b1f0c/uploads/origins/2bbcaf09-a660-4173-8537-64fa5191dbb0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=673088553c41cd29443b9403ccecb616", "srcset": "https://si.imgix.net/ec9b1f0c/uploads/origins/2bbcaf09-a660-4173-8537-64fa5191dbb0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=673088553c41cd29443b9403ccecb616, https://si.imgix.net/ec9b1f0c/uploads/origins/2bbcaf09-a660-4173-8537-64fa5191dbb0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=051a68d3ed9fb2c5265cdd3732b1ad0d 2x, https://si.imgix.net/ec9b1f0c/uploads/origins/2bbcaf09-a660-4173-8537-64fa5191dbb0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=7203318f25ddcadc09b0bccda84c4260 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/ec9b1f0c/uploads/origins/2bbcaf09-a660-4173-8537-64fa5191dbb0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=bda9dd6e704277ccc2a02a41d9eb2b83", "srcset": "https://si.imgix.net/ec9b1f0c/uploads/origins/2bbcaf09-a660-4173-8537-64fa5191dbb0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=bda9dd6e704277ccc2a02a41d9eb2b83, https://si.imgix.net/ec9b1f0c/uploads/origins/2bbcaf09-a660-4173-8537-64fa5191dbb0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit