a-0cdc-40c8-879e-a822045e9d46?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8c8aad7c1954a8bcd451f654fe732cae, https://si.imgix.net/61e09650/uploads/origins/6df812fa-0cdc-40c8-879e-a822045e9d46?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=769ba619f652a5d018bd87cf001d6483 2x, https://si.imgix.net/61e09650/uploads/origins/6df812fa-0cdc-40c8-879e-a822045e9d46?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=8196eee6c82c18fd37aef337b7b25efd 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/61e09650/uploads/origins/6df812fa-0cdc-40c8-879e-a822045e9d46?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=19713d8d9ebfba3c428a1d01f29a8e9d", "srcset": "https://si.imgix.net/61e09650/uploads/origins/6df812fa-0cdc-40c8-879e-a822045e9d46?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=19713d8d9ebfba3c428a1d01f29a8e9d, https://si.imgix.net/61e09650/uploads/origins/6df812fa-0cdc-40c8-879e-a822045e9d46?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=aec9155cb60e28d2b27cce672f52faaf 2x, https://si.imgix.net/61e09650/uploads/origins/6df812fa-0cdc-40c8-879e-a822045e9d46?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=6d51437b5afb49ee5bee7ae43a5464dc 3x"}, "body": "フカさん、おはようございます！\n先ほどあなたの投稿を拝見して、複雑なデザインの服も上手に描けるんだなと思いました。特にVTuberのイラストは、すごく可愛く描かれていますね！！それに、美味しそうな食べ物も本当に上手に描けるのがよく分かります～ とても食欲をそそられて、美味しそうです～\n\nそこで、私のキャラクターを描いていただけないでしょうか？参考画像はこちらのリンクからご覧いただけます：\nhttps://drive.google.com/drive/folders/1dzZPhD_pbFG1xEDJRbY0eiK9dtQt-iby\n\nあ、そうそう、私のキャラクターがすごく複雑なのは十分承知しています。もしこの金額では足りない場合は、遠慮なく再送して価格を調整してください。\n\n私のキャラクターが一人でティーパーティーを楽しんでいる絵を描いていただけないでしょうか。ピクニックテーブルには美味しい料理がたくさん並んでいるのに、彼女一人きりという設定です。おそらく、この場所にはもう誰も残っていないからでしょう。彼女が静けさを楽しみながら、お茶を飲んでいる様子を描いていただけると嬉しいです。\n\nここまでお読みいただき、本当にありがとうございます。絵の構図はあなたにお任せします～", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Fuka_higuchi/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3961678, "client_id": 3963551, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/c5c6444f/uploads/origins/f05c2bc4-a992-43a7-82b2-aee1edf48402?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=96eae344dd7cae131b0ca99111ea08ca", "srcset": "https://si.imgix.net/c5c6444f/uploads/origins/f05c2bc4-a992-43a7-82b2-aee1edf48402?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=96eae344dd7cae131b0ca99111ea08ca, https://si.imgix.net/c5c6444f/uploads/origins/f05c2bc4-a992-43a7-82b2-aee1edf48402?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=656f709fa69cfc9dab7bb91d052c57bd 2x, https://si.imgix.net/c5c6444f/uploads/origins/f05c2bc4-a992-43a7-82b2-aee1edf48402?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=335b855e960c131236c77a091c512eb0 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/c5c6444f/uploads/origins/f05c2bc4-a992-43a7-82b2-aee1edf48402?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c1fd4c9216dc6b6aac4ae00861823e04", "srcset": "https://si.imgix.net/c5c6444f/uploads/origins/f05c2bc4-a992-43a7-82b2-aee1edf48402?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c1fd4c9216dc6b6aac4ae00861823e04, https://si.imgix.net/c5c6444f/uploads/origins/f05c2bc4-a992-43a7-82b2-aee1edf48402?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=c8078a970f7b33629207bc2896f73434 2x, https://si.imgix.net/c5c6444f/uploads/origins/f05c2bc4-a992-43a7-82b2-aee1edf48402?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=2