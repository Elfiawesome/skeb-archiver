のほどよろしくお願いします。\n\nhttps://x.com/Onwa_Inu/status/2058164319918199000", "nc": 185, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "similar_creators": [{"id": 73531, "creator": true, "nsfw_acceptable": true, "acceptable": false, "name": "あおいの😪", "screen_name": "shir0kur0_bw", "avatar_url": "https://pbs.twimg.com/profile_images/1364248754329509889/LEDA9O_U.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1184734986/1652472137/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 90, "skills": [{"genre": "art"}], "banned": false, "nc": 161}, {"id": 462750, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "サツキ・ラビット", "screen_name": "Satuki_rabbit", "avatar_url": "https://pbs.twimg.com/profile_images/1728181678169047040/aPGiAnQu.jpg", "header_url": null, "appeal_receivable": true, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 90, "skills": [{"genre": "art"}, {"genre": "correction"}], "banned": false, "nc": 160}, {"id": 678921, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "つばさ", "screen_name": "GROWTH_pix", "avatar_url": "https://pbs.twimg.com/profile_images/1631630766294831105/_zLT1nEz.jpg", "header_url": "https://pbs.twimg.com/profile_banners/783295248705269760/1703560819/1500x500", "appeal_receivable": true, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 90, "skills": [{"genre": "art"}, {"genre": "comic"}], "banned": false, "nc": 32}, {"id": 864194, "creator": true, "nsfw_acceptable": true, "acceptable": true, "nam