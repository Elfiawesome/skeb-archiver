eator_acceptable_same_genre": true}, {"path": "/@ewokakuyo_maru/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3691669, "client_id": 1424711, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/5bd824cb/uploads/origins/4b4a82ee-e2af-4d62-b919-06d4454d8325?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b27bd07c1565f3de8713417809fee438", "srcset": "https://si.imgix.net/5bd824cb/uploads/origins/4b4a82ee-e2af-4d62-b919-06d4454d8325?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b27bd07c1565f3de8713417809fee438, https://si.imgix.net/5bd824cb/uploads/origins/4b4a82ee-e2af-4d62-b919-06d4454d8325?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=52d35e3d0a234e06ed44098d2095a2fa 2x, https://si.imgix.net/5bd824cb/uploads/origins/4b4a82ee-e2af-4d62-b919-06d4454d8325?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=5eb4d55480cf86a12156096ae5ea930f 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/5bd824cb/uploads/origins/4b4a82ee-e2af-4d62-b919-06d4454d8325?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=06e2d829b2ce8a336757dab831214358", "srcset": "https://si.imgix.net/5bd824cb/uploads/origins/4b4a82ee-e2af-4d62-b919-06d4454d8325?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=06e2d829b2ce8a336757dab831214358, https://si.imgix.net/5bd824cb/uploads/origins/4b4a82ee-e2af-4d62-b919-06d4454d8325?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=c19f47417ef4204546f97d961e5e79fd 2x, https://si.imgix.net/5bd824cb/uploads/origins/4b4a82ee-e2af-4d62-b919-06d4454d8325?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=b67fd98e6d2d563783ea9a6c218a0f3c 3x"}, "body": "福来まる様、初めまして。\n少し不安感もありつつ、温かでどこか懐かしい絵本のような空気感のイラストが本当に素敵で惹かれましたため、リクエストさせて頂きたく参りました。\n私のTRPGのOCをお願いさせて頂ければと思います。\n\n容姿：https://drive.google.com/drive/folders/10dNHgCrEuymaxUp-u5bCG3_XHrEczTnr\n\nシナリオ：「FRaTRlCiDE-フラトリサイド-」\n年齢：17歳\n性格：イギリスの伝統ある寄宿学校に通っている。\n寮の監督生を務めており、いつも笑顔の優等生。\nイギリス人らしい皮肉はあまり言わないが、紅茶とミルクの順番にはうるさい。\n家は古い時代から貴族に仕えていた執事を生業としており、所作等に厳しかった。\nなんでも器用にできる性格ではないが、「いい顔」は気がつけば染み付いてしまった。\n友達は多いが、親友はいない。\n\n夜に監督のため、一人で静かな寮を歩いている時間は寧ろ落ち着く時間かもしれない。\n幼い頃も誰かと遊んだりするのではなく、一人で木陰で本を読んだり、鳥の声や小さな動物たちに囲まれている方がずっと楽しかった。\n妖精の伝承が残る地に家があったが故に、より自然の中では安心ができた。\n\n\n衣装に関して、立ち絵イラストの制服が難しければ描きやすい形で変更して頂けますと幸いです。\n福来まる様の描かれる世界観に大変惹かれましたため、構図やシーン等をお好きに描いて頂けますと大変嬉しいです。\n\n内容等に不備がございましたら、お気軽に再送申請・キャンセル等してください。\nご検討頂けますと幸いです、よろしくお願い致します。\n\nhttps://drive.google.com/drive/folders/10dNHgCrEuymaxUp-u5bCG3_XHrEczTnr", "nc": 137, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@ewokakuyo_maru/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3691669, "client_id": 368243, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/1887b082/uploads/origins/66e60a53-dde5-44b1-8543-3435d288b3a4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=216d9bbcb902d9390c079c2f54317eef", "srcset": "https://si.imgix.net/1887b082/uploads/origins/66e60a53-dde5-44b1-8543-3435d288b3a4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=216d9bbcb902d9390c079c2f54317eef, https://si.imgix.net/1887b082/uploads/origins/66e60a53-dde5-44b1-8543-3435d288b3a4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c1edddc6e14cb9a6c93cdc9ce645fa8e 2x, https://si.imgix.net/1887b082/uploads/origins/66e60a53-dde5-44b1-8543-3435d288b3a4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=38f34691ed8e93050dbb43f04abf6360 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.