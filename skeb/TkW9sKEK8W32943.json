ea-40aa-b599-af0bfb190cd0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6962a66748daa3726f3a7a00c6c93d2b", "srcset": "https://si.imgix.net/13c4f2fc/uploads/origins/a3998ef7-d0ea-40aa-b599-af0bfb190cd0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6962a66748daa3726f3a7a00c6c93d2b, https://si.imgix.net/13c4f2fc/uploads/origins/a3998ef7-d0ea-40aa-b599-af0bfb190cd0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=d133ee23a1cda6d609c0ae9202565ba4 2x, https://si.imgix.net/13c4f2fc/uploads/origins/a3998ef7-d0ea-40aa-b599-af0bfb190cd0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=88fc13c90140108ef70597e895dfc84b 3x"}, "body": "こんにちは、お元気ですか！ 今回もお願いしたくて連絡しました♪ 今回は『ディスガイア』シリーズのフロン（Flonne）の絵をお願いしたいです。 描いてほしいのは1作目の天使バージョンのフロンで、白いドレスと青いリボンのあの姿です！\nポーズについては、この2つの作品をミックスした感じでお願いしたいです： https://www.pixiv.net/en/artworks/138083888 https://www.pixiv.net/en/artworks/139508226\n両腕を頭の上に挙げて、少し体を捻りながら、得意げに（ちょっと自慢するように）自分の身体を見せつけるような雰囲気で！\nあと、フロンちゃんは頭のリボン以外は全部裸でお願いします！\n表情はとても興奮していて、目がキラキラしている感じがいいです。 見えない観察者が「うわっ、フロンちゃんマジで臭い……！」みたいなことを言うので、 フロンちゃんが「正義のためならお風呂なんてしてる暇ないもん！」 みたいな感じで返しているシーンにしてください♪\nフロンの脇は少し毛が生えている感じでお願いします（この絵のような雰囲気）： https://www.pixiv.net/en/artworks/138388069 この絵がすごく好きなので、似たニュアンスで描いていただけると嬉しいです！\nそれ以外は、フロンのおまんこは毛がなく、臭くて、スメグマがはっきり見えるようにしてください。 可能であれば、息も臭そうに見える簡単な演出（プ～って感じの匂いエフェクトとか）を入れていただけると最高です！ もしこれが絵の雰囲気に合わないと感じたら、無理に入れなくても大丈夫です。\n以上になります！ いつも素敵な絵を描いてくれて本当にありがとうございます。 今回も楽しみにしています～！", "nc": 33, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@TkW9sKEK8W32943/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3765379, "client_id": 3751213, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/2b169f9e/uploads/origins/7ff6b075-4fb2-4414-acac-811f5f4efb2c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=48704790ccf437ec04866d77687a0acb", "srcset": "https://si.imgix.net/2b169f9e/uploads/origins/7ff6b075-4fb2-4414-acac-811f5f4efb2c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=48704790ccf437ec04866d77687a0acb, https://si.imgix.net/2b169f9e/uploads/origins/7ff6b075-4fb2-4414-acac-811f5f4efb2c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=8c51ad4593ff745bd77b25cc2d923dde 2x, https://si.imgix.net/2b169f9e/uploads/origins/7ff6b075-4fb2-4414-acac-811f5f4efb2c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c1d616e4b65d7311c8e7d6603f91a111 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/2b169f9e/uploads/origins/7ff6b075-4fb2-4414-acac-811f5f4efb2c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c8f66ecfdf14cbfc0299903c6ad3335c", "srcset": "https://si.imgix.net/2b169f9e/uploads/origins/7ff6b075-4fb2-4414-acac-811f5f4efb2c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c8f66ecfdf14cbfc0299903c6ad3335c, https://si.imgix.net/2b169f9e/uploads/origins/7ff6b075-4fb2-4414-acac-811f5f4efb2c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=bf6bf0c2e0b41a8a28078cb496b91eae 2x, https://si.imgix.net/2b169f9e/uploads/origins/7ff6b075-4fb2-4414-acac-811f5f4efb2c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=9bd80ae7d6f9e5cc278487f93d84f00d 3x"}, "body": "またこんにちは！\n今回はまたちょっと違う感じのイラストをお願いしたいです！\n「けいおん！」の中野梓ちゃんを、口が臭い状態で描いてほしいです。\n学校に遅刻しそうになって慌てて家を出たせいで、歯磨きをすっかり忘れてしまった梓ちゃん。\nなんとか間に合わせようと走ってきたので、息がかなり上がっています。\n画面外のクラスメイトが\n「うぎゃっ、中野さん歯磨き忘れた…？」\nみたいな感じで言っているイメージです。\n詳細：\n\n教室の引き戸の前に立っている梓ちゃんがいいです。\n背景はできるだけシンプルで構いません！（面倒なら最小限でOKです）\nカメラ目線で、ゼェゼェ息を切らしながら舌を出している感じでお願いします。\n息が臭そうなのがはっきり分かるようにしてほしいです。\n舌にはうっすら白っぽいor黄色っぽい苔（コーティング）があると嬉しいです。\n髪の毛が少し乱れていたり、制服がちょっとシワになっていたりすると、\n慌ててきた感が出て良いかなと思います！\nポーズは自由で大丈夫です。ただやっぱり臭そうな口の中と舌が一番のメインで見えるようにしていただけると嬉しいです。\n\nちょっとマニアックで申し訳ないのですが、\n舌と口臭感がちゃんと伝われば自分的には大満足です！\nよろしくお願いします!", "nc": 176, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@TkW9sKEK8W32943/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3765379, "client_id": 3751213, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/61ece799/uploads/origins/9d007e91-bce3-4bbe-8b05-7e559fe75628?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=29ac870a893fbaf5de7edbfe6f4ace70", "srcset": "https://si.imgix.net/61ece799/uploads/origins/9d007e91-bce3-4bbe-8b05-7e559fe75628?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=29ac870a893fbaf5de7edbfe6f4ace70, https://si.imgix.net/61ece799/uploads/origins/9d007e91-bce3-4bbe-8b05-7e559fe75628?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=024471dafacb9b15f2994470c0a61a47 2x, https://si.imgix.net/61ece799/uploads/origins/9d007e91-bce3-4bbe-8b05-7e559fe75628?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=cb537652d0dfa89d36e6af13a4928a98 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/61ece799/uploads/origins/9d007e91-bce3-4bbe-8b05-7e559fe75628?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=7ac88d1084cf6ee7564c2f29d730794c", "srcset": "https://si.imgix.net/61ece799/uploads/origins/9d007e91-bce3-4bbe-8b05-7e559fe75628?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=7ac88d1084cf6ee7564c2f29d730794c, https://si.imgix.net/61ece799/uploads/origins/9d007e91-bce3-4bbe-8b05-7e559fe75628?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=ee5236dc4579d3257b6c1eeec2e3d12a 2x, https://si.imgix.net/61ece799/uploads/origins/9d007e91-bce3-4bbe-8b05-7e559fe75628?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=3983250f2028a7081d9f5a7b2c919f84 3x"}, "body": "こんにちは！\n\nラビリビのえりなちゃんを臭いマンコとワキで描いてほしい！うさぎから人間になったえりなは、衛生観念の大切さがわからない。リボンちゃんに腕を上げながら「どうしたの？彼女の無邪気さと好奇心を捕まえてみてほしい！女の子なのだから、少しは顔を赤らめているはずだ。リボンちゃんは悪臭に激しく反応するはずだ！\n\nもちろん、彼女のアソコも臭くしたい！布を動かしてアソコを露出させるか、それともスーツ越しに臭わせるか......。どちらも良いので、お任せします！", "nc": 160, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 40796, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "broiler", "screen_name": "broiler_u", "avatar_url": "https://pbs.twimg.com/profile_images/1968692531132252162/tGq3wKhK.jpg", "header_url": "https://pbs.twimg.com/profile_banners/966646907056488448/1758246928/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "art"}], "nc": 161}, {"id": 304405, "creator": true, "nsfw_acceptable": true, "acceptable": false, "name": "さつきあしゃ", "screen_name": "satukiasya", "avatar_url": "https://pbs.twimg.com/profile_images/1658288662516498432/udJsMPkc.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1477555789/1769642834/1500x500", "appeal_receivable": true, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "art"}, {"genre": "comic"}, {"genre": "correction"}], "nc": 32}, {"id": 517317, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "あきすこ🔞電子版1/21配信", "screen_name": "akisuke06080608", "avatar_url": "https://pbs.twimg.com/profile_images/1993091048252559360/9wx-S9Ks.jpg", "header_url": "https://pbs.twimg.com/pr