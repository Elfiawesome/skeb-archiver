p=sharing\n\n\u25bd\n\u4ee5\u4e0b\u306e\u5185\u5bb9\u306f\u30ad\u30e3\u30e9\u30af\u30bf\u30fc\u306e\u53c2\u8003\u7528\u3067\u3059\uff01\n\u96f0\u56f2\u6c17\u3084\u89e3\u91c8\u306f\u81ea\u7531\u306b\u63cf\u3044\u3066\u3044\u305f\u3060\u3044\u3066\u5927\u4e08\u592b\u3067\u3059\u301c\uff01\n\uff08\u3056\u3063\u304f\u308a\u3057\u305f\u30a4\u30e1\u30fc\u30b8\u5171\u6709\u306e\u305f\u3081\u306e\u8aac\u660e\u306b\u306a\u308a\u307e\u3059\uff01\uff09\n\n\uff1e\uff1e\uff1e\u30ad\u30e3\u30e9\u30af\u30bf\u30fc\u6982\u8981\n\u300c\u7121\u90aa\u6c17\u305d\u3046\u306a\u9854\u3092\u3057\u305f\u60aa\u3044\u5b50\u300d\n14\u301c15\u6b73\u304f\u3089\u3044\u306e\u5c11\u5e74\uff08\u4e2d\u5b66\u751f\u301c\u9ad8\u6821\u751f\u306e\u30a4\u30e1\u30fc\u30b8\u3067OK\u3067\u3059\uff01\uff09\n\n\u751f\u5f92\u4f1a\u306e\u526f\u4f1a\u9577\u3002\n\u4e21\u89aa\u3092\u4ea1\u304f\u3057\u3066\u4ec7\u306b\u5f15\u304d\u53d6\u3089\u308c\u305f\u904e\u53bb\u304c\u3042\u308a\u3001\u990a\u7236\u306e\u3053\u3068\u304c\u5927\u5acc\u3044\u3002\n\u305d\u306e\u305f\u3081\u3001\u308f\u3056\u3068\u53cd\u6297\u7684\u306b\u632f\u308b\u821e\u3063\u3066\u5468\u56f2\u306b\u201c\u60aa\u3044\u5b50\u201d\u3092\u6f14\u3058\u3066\u3044\u308b\u3002\n\uff08\u3067\u3082\u5b9f\u969b\u306f\u305f\u3060\u5e7c\u3044\u3060\u3051\u3067\u3001\u6839\u306f\u305d\u3093\u306a\u306b\u60aa\u3044\u5b50\u3058\u3083\u306a\u3044\u3067\u3059\u3002\uff09\n\n\uff1e\uff1e\uff1e\u5916\u898b\u7684\u7279\u5fb4\n\u30fb\u5782\u308c\u76ee or \u4e38\u3044\u76ee\n\u30fb\u4e38\u9854\u3067\u5e7c\u3044\u5370\u8c61\n\u30fb\u8868\u60c5\u304c\u5c11\u306a\u3081\n\u30fb\u7121\u57a2\u305d\u3046\u306a\u9854\u7acb\u3061\n\u30fb\u982c\u306b\u304b\u304b\u308b\u8efd\u304f\u30a6\u30a7\u30fc\u30d6\u3057\u305f\u9aea\uff08\u3082\u307f\u3042\u3052\u304c\u9854\u306b\u6cbf\u3046\u611f\u3058\uff09\n\n\uff1e\uff1e\uff1e\u30a4\u30e1\u30fc\u30b8\u30a2\u30a4\u30c6\u30e0\u30fb\u30e2\u30c1\u30fc\u30d5\n\u30fb\u9283\u706b\u5668\uff08\u30cf\u30f3\u30c9\u30ac\u30f3\uff0f\u30e9\u30a4\u30d5\