の隠れ蓑となっています。\n彼女は劇団に「居場所」を与えてもらったことに強い感謝を抱いており、それらの行為については黙認しています。\n\nまた、幼少期の影響から、メリーゴーランド、オルゴール、キャンディなど童話世界を象徴するものに強い執着があります。\n\nポーズや構図の指定はありませんので、自由に描いていただければ嬉しいです。\nもしご都合が合わない場合は、そのままキャンセルしていただいて大丈夫です。\n最後までお読みいただき、ありがとうございます💙\n\nhttps://imgur.com/a/akM4ufA", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@U2uki_/works/6", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/7b0ef22a/uploads/origins/ac5f4ac3-6c14-4e5b-b2da-eb758e06ce77?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=98a105e2749ee7e6a2e6794341df27e3", "srcset": "https://si.imgix.net/7b0ef22a/uploads/origins/ac5f4ac3-6c14-4e5b-b2da-eb758e06ce77?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=98a105e2749ee7e6a2e6794341df27e3, https://si.imgix.net/7b0ef22a/uploads/origins/ac5f4ac3-6c14-4e5b-b2da-eb758e06ce77?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=581f18f405a6f87121f044acbf8fe760 2x, https://si.imgix.net/7b0ef22a/uploads/origins/ac5f4ac3-6c14-4e5b-b2da-eb758e06ce77?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=d3f4b403e850205b76c1a9437ceea464 3x"}, "private": true, "genre": "art", "tipped": false, "creator_id": 3721954, "client_id": 3428624, "nc": 1}, {"path": "/@U2uki_/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3721954, "client_id": 2378340, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/e7235edf/uploads/origins/34089472-9015-450e-858f-7334d66312a2?bg=%23fff&a