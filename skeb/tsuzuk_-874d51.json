200&h=200&s=f5d435818f5761bb3c3221e1690d9c11 2x, https://si.imgix.net/ba12a347/uploads/origins/8ec54b9d-ac24-4901-8a94-acdc41c4ffc9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e0bce2fef67e0d342168be1974821700 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/ba12a347/uploads/origins/8ec54b9d-ac24-4901-8a94-acdc41c4ffc9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e138d2d4fd59f73e1b82744e480932ab", "srcset": "https://si.imgix.net/ba12a347/uploads/origins/8ec54b9d-ac24-4901-8a94-acdc41c4ffc9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e138d2d4fd59f73e1b82744e480932ab, https://si.imgix.net/ba12a347/uploads/origins/8ec54b9d-ac24-4901-8a94-acdc41c4ffc9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=28ca76762158e357310d6c29ab946dff 2x, https://si.imgix.net/ba12a347/uploads/origins/8ec54b9d-ac24-4901-8a94-acdc41c4ffc9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=59ebc725fa977d3e7e45e89d6ed87f6f 3x"}, "body": "都築先生、こんにちは！\n\n先生のイラスト、本当に可愛いです！私のオリジナルキャラクターの百合カップリングを描いてください。\n\nもし2人のキャラクターを描くのに金額が足りない場合は、リクエストを再送信してください。\n\n- 百合 / GL\n- 2人とも若くて小柄な設定でお願いします（ロリでもOK）\n- 構図は自由\n- 可能であれば、先生のお好きな新しい衣装で（クリエイティブなデザインを歓迎します）\n- リボンや髪飾りはそれぞれ違うものでもOK\n- 明るい白／真白の髪（シルバーやグレーは避けてください）\n- 必須ではありません：もしよろしければ、私の2人のオリジナルキャラクターを非人間（猫娘、狐娘、ウサギ娘、ドラゴン娘など）として描いていただけると嬉しいです\n- 注意：動物の耳を描く場合は、人間の耳は避けてください\n\n- 可能であればPSDファイル\n- レイヤーを分離してください\n\nよろしくお願いします！ 🩷\n\nhttps://drive.google.com/drive/folders/1VXJdVy7D6KULdy6uZ3OShVMQ3yVT-Enn?usp=sharing", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@tsuzuk_/works/9", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3835026, "client_id": 1110118, "vtt_url": null, "thumbnail_image_urls": {"src": 