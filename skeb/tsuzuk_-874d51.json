りましたらよろしくお願いいたします！\n\nLitLink\nhttps://t.co/OAbfX5mb7o\n\nYouTube\nyoutube.be/@tsukisuzu_\n\nhttps://drive.google.com/drive/folders/1ePWXMIY5rLq8dqinfBg9TvN7O6J6HecL", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}], "sent_works": [], "similar_creators": [{"id": 334786, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "あめぱ🍍@お仕事募集中", "screen_name": "ame_pinecandy", "avatar_url": "https://pbs.twimg.com/profile_images/1905382782916055040/DnQPJYj8.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1042201675581149185/1643086607/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 7, "complete_expiration_days": 60, "skills": [{"genre": "art"}, {"genre": "correction"}], "banned": false, "nc": 176}, {"id": 563232, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "мercυre❤️‍🩹", "screen_name": "Mercure_1104", "avatar_url": "https://pbs.twimg.com/profile_images/1700444550987419648/Z6pP0mB7.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1112697023734505472/1694253693/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "art"}, {"genre": "video"}, {"genre": "correction"}], "banned": false, "nc": 48}, {"id": 1117688, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "瀬谷ねこ🌸パステルミニキャラ｜VTuber向け｜skeb・つなぐ受付中", "screen_name": "setani_", "avatar_url": "https://pbs.twimg.com/profile_images/1549356780261502976/Y7YM_Jxo.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1332198823163162628/1780462406/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_request