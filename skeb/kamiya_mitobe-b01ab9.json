ています。胸は大きく、八重歯があります。\n\n・イラストに関してはみとべ様の描きたいようにお任せで描いて頂けると幸いです。\n衣装の細かいところはお好きにアレンジして頂いて大丈夫です。\n\nリクエストが多数来ているとのことでご都合が悪ければキャンセルして頂いても大丈夫です。\nその場合、また改めて折を見てリクエストさせて頂きます。\nどうぞよろしくお願い致します。", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@kamiya_mitobe/works/2", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/a4c107cf/uploads/origins/4ba57ab6-4007-4d61-8b01-f04be1eb8c63?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=00e6604f76343c1d532b023882ee3543", "srcset": "https://si.imgix.net/a4c107cf/uploads/origins/4ba57ab6-4007-4d61-8b01-f04be1eb8c63?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=00e6604f76343c1d532b023882ee3543, https://si.imgix.net/a4c107cf/uploads/origins/4ba57ab6-4007-4d61-8b01-f04be1eb8c63?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=731d0d766a32ed4e6085053f07a92baf 2x, https://si.imgix.net/a4c107cf/uploads/origins/4ba57ab6-4007-4d61-8b01-f04be1eb8c63?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=1d127aa78f94d11a75b13db286d3a85d 3x"}, "private": true, "genre": "art", "tipped": false, "creator_id": 1585433, "nc": 128}, {"path": "/@kamiya_mitobe/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1585433, "client_id": 130865, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/16395433/uploads/origins/2ea72dc6-6302-4f52-98c0-c8e6720e05ae?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d475c661b82783cb92d08