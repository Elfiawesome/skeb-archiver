ipped": true, "creator_id": 1446271, "client_id": 1547770, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/b4b287aa/uploads/origins/213a4092-15bc-452e-b1c8-580eab0e0438?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7e9170df19b0774897054eaf46236821", "srcset": "https://si.imgix.net/b4b287aa/uploads/origins/213a4092-15bc-452e-b1c8-580eab0e0438?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7e9170df19b0774897054eaf46236821, https://si.imgix.net/b4b287aa/uploads/origins/213a4092-15bc-452e-b1c8-580eab0e0438?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=be2b9d12840fba4595d712d0be1527c6 2x, https://si.imgix.net/b4b287aa/uploads/origins/213a4092-15bc-452e-b1c8-580eab0e0438?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=6dc3a188ecf0433c3ccd09831986c0d1 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/b4b287aa/uploads/origins/213a4092-15bc-452e-b1c8-580eab0e0438?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=7dab401157f29a8eaf3ed08ed210b7af", "srcset": "https://si.imgix.net/b4b287aa/uploads/origins/213a4092-15bc-452e-b1c8-580eab0e0438?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=7dab401157f29a8eaf3ed08ed210b7af, https://si.imgix.net/b4b287aa/uploads/origins/213a4092-15bc-452e-b1c8-580eab0e0438?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=c3956dea4c56c4ec16a4dad09e35ee6a 2x, https://si.imgix.net/b4b287aa/uploads/origins/213a4092-15bc-452e-b1c8-580eab0e0438?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=c6498fa1f582fc1986a75dba5135e191 3x"}, "body": "狐の嫁入りイラストをお願いします\n\n表情　結婚式を控え、はにかみつつも嬉しそう、又は幸せそうに微笑んでる\n(上記に限らず、幸せそうなイラストであれば嬉しいです。自由に描いてください)\n\n特徴　けもみみ(キツネ耳)有り　(ヒト耳はなし)\n(作者様判断で「けもみみ無し」でも可です。その場合の注意点を一番下に記載)\n\n髪のスタイル　作者様におまかせします\n髪の色　狐のイメージ色でおまかせします。白狐等も可\n\n服装　白無垢\n服の色は少し黄色味がかかった白色、又は白でお願いします(絹か化繊で色が違います)\n白無垢のライン色(ふきの色)　基本の白無垢はなしですが、流行の赤色、その他色を作者様判断で入れても構いません。自由に描いてください\n\nできれば使用しないで欲しい小物や装飾品のお願い\n綿帽子(頭の被り物)　なし　(帽子でけもみみが隠れるため)\n赤色和傘の所持　なし　(人物よりも目立つため)\n狐のお面の装着　なし　(顔が隠れるため。手に持たせたる等、小物での使用可)\n\nその他の装飾品や小物等の使用は作者様におまかせします\n\n構図、解像度は作者様におまかせします\n宛名等の文字はナシでお願いします\n\n使用用途\n個人で使用、キツネ関連の振興で使用(地域の祭り等、非商用に限る)\n\n参考ＵＲＬ\nhttps://www.pixivision.net/ja/a/6580\nhttps://www.pixivision.net/ja/a/940\nhttps://www.pixivision.net/ja/a/3340\nhttps://hana-yume.net/howto/shiromuku/\n\n山口県の稲穂祭（きつねの嫁入り）を応援しています\n\nご検討お願いします\n\n※例外\nけもみみ無しの場合の注意点\nキャラクターは通常の人として扱い、髪の色は黒、又は茶髪でお願いします\n\n狐の嫁入りという設定のため、下記の例の中からひとつお願いします\n例１．綿帽子はなし。狐のお面を所持。手に持たせる等してください\n例２．綿帽子を着用。帽子をけもみみっぽく加工。狐のお面を所持。手に持たせる等してください\n例３．綿帽子を着用。帽子の加工無し。狐のお面を所持。手に持たせる等してください\n綿帽子をけもみみ加工の例は参考ＵＲＬをご覧ください", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Yukihira_3690/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1446271, "client_id": 678683, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/f45c64ab/uploads/origins/8a8ff00d-dc01-41bf-8cac-63d343c92984?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5d946e595cb717416bec4272daa57582", "srcset": "https://si.imgix.net/f45c64ab/uploads/origins/8a8ff00d-dc01-41bf-8cac-63d343c92984?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5d946e595cb717416bec4272daa57582, https://si.imgix.net/f45c64ab/uploads/origins/8a8ff00d-dc01-41bf-8cac-63d343c92984?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b539e17a3669fbcefba1596fb74662e7 2x, https://si.imgix.net/f45c64ab/uploads/origins/8a8ff00d-dc01-41bf-8cac-63d343c92984?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=7abcff22d7580cf2a3cfb27c57eb000a 3x"}, "duration": null, "nsfw": false, "hardcore": false, "cons