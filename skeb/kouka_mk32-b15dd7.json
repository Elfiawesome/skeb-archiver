D93/view\n・片方上着が少しずれ落ちている\n・ネコミミは付け耳、尻尾は無しです。\n・お腹辺りに付いてる花はオレンジ色のアネモネ\n見た目は画像通りですが、アレンジOKです。\n\n・キャラの他にデフォルメ調でもリアル調でもいいので猫を1~4匹入れてください。その中で1匹以上三毛猫を入れて欲しいです。\n\n・明るく可愛く描いて貰えると嬉しいです。\n・背景はあってもなくても大丈夫です。\n\nポーズや表情、キャラが入る範囲などわからない所は全ておまかせです。\n描きにくい所あれば変えてもらって大丈夫です。\n\n【キャラクター詳細】\n・猫の擬人化ではなく、三毛猫の仲間になりたくて猫耳つけてるだけのただの人間。\n・花や動物、草木など自然が好き\n\nもしよければ、よろしくお願いします！", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}], "similar_creators": [{"id": 224129, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "いすぃ", "screen_name": "mizusoba", "avatar_url": "https://pbs.twimg.com/profile_images/1409073289490690048/J6rmR-bB.jpg", "header_url": "https://pbs.twimg.com/profile_banners/113892547/1628629813/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "art"}], "banned": false, "nc": 48}, {"id": 1252870, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "シロネコバン", "screen_name": "shiro_neko_ban", "avatar_url": "https://pbs.twimg.com/profile_images/1473996618743828482/NesCh48G.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1383329374233976835/1640263155/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 10, "complete_expiration_days": 120, "skills": [{"genre": "art"}], "banned": false, "nc": 0}, {"id": 1375171, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "ひづ雨英＠C108(土)東Ｊ-06a", "screen_name": "hidu320", "avatar_url": "https://pbs.twimg.com/profile_images/1909260482684624896/r92JU23s.jpg", "header_url": "https://pbs.twimg.com/profile_banners/99016369/1756035982/1500x500", "appeal_receivable": false, "popular_creator_rank