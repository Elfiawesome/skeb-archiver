ss&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b10358312bc5e3d69d4532ca9e889d8d, https://si.imgix.net/665ea266/uploads/origins/c853e46a-7097-4c5d-9716-4afc8266387d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=10e06f960ffec705698855ddd79e5e79 2x, https://si.imgix.net/665ea266/uploads/origins/c853e46a-7097-4c5d-9716-4afc8266387d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=62a1ee1a97e85cc28a3365f3843dfa98 3x"}, "body": "こんにちは。私のダンピールキャラクターの絵をお願いしたいです。\n\n彼はとても陽気で友好的で、少し奇妙です。彼は放浪者でレンジャーです。夫を亡くして以来、世界中を放浪している。迷子になるのが趣味のひとつ。猫と音楽も好きで、竪琴を演奏する。\n\n構図、雰囲気、服装はお任せします。アイパッチとモノクルを忘れずに。ファッションのインスピレーションはこちら：https://www.pinterest.se/toffepajja/jakhein-winterwood/\n\nhttps://toyhou.se/15506671.jakhein-winterwood/gallery", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@hinyariTyomo/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2305399, "client_id": 454273, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/b9bb95c3/uploads/origins/e0dffe0e-087f-4440-a8b4-5ea125b31d65?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=02433376283a0acb26e6d4e303926011", "srcset": "https://si.imgix.net/b9bb95c3/uploads/origins/e0dffe0e-087f-4440-a8b4-5ea125b31d65?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=02433376283a0acb26e6d4e303926011, https://si.imgix.net/b9bb95c3/uploads/origins/e0dffe0e-087f-4440-a8b4-5ea125b31d65?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=9e48fa7cd14513622704d0ce0dbe989f 2x, https://si.imgix.net/b9bb95c3/uploads/origins/e0dffe0e-087f-4440-a8b4-5ea125b31d65?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=61933a786353f095a25c840251165565 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src":