dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=6b19c557f575403618d33f31894716ff 3x"}, "body": "久しぶりに募集をかけていると知って、TRPGの晧志という少年キャラを描いていただきたくリクエストさせていただきました。\n　使用用途は待ち受け画面、SNSでのアイコンなどです。過去に描いていただいたものみたく、アクスタにもさせてもらえれば嬉しいです。\n\n●晧志\n（白ネズミをイメージした見た目）\n・髪色→白\n・目の色→赤に近い紫\n・身長は180と高め\n・服→学ラン（前は開けている）\n・眼鏡をつけている\n・「感情」というものに夢見がちなロマンチスト\n\n下記URLにはぴくるー様で作った見た目のイメージを載せています。\nhttps://x.com/chiha_trpg/status/1672599845738254342?t=XOqmNFXhTm-TPDsCXKB0KA&s=19\n\n宛名は千早もしくは@chiha8_6でお願いします。\n\nよろしくお願いします！\n\nhttps://x.com/chiha_trpg/status/1672599845738254342?t=XOqmNFXhTm-TPDsCXKB0KA&s=19", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@rikka_kamisaka/works/11", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1673566, "client_id": 2987775, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/1b63a663/uploads/origins/4b3d5777-4b52-4653-bdc6-e1f728db6529?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e873fc269574f78b268d7e2733c6d9be", "srcset": "https://si.imgix.net/1b63a663/uploads/origins/4b3d5777-4b52-4653-bdc6-e1f728db6529?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e873fc269574f78b268d7e2733c6d9be, https://si.imgix.net/1b63a663/uploads/origins/4b3d5777-4b52-4653-bdc6-e1f728db6529?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a540999938fbb149f9df1da098ce83c8 2x, https://si.imgix.net/1b63a663/uploads/origins/4b3d5777-4b52-4653-bdc6-e1f728db6529?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=2fd446f737e8cd517bcfe48ce2c185be 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/1b63a663/uploads/origins/4b3d5777-4b52-4653-bdc6-e1f728db6529?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=899532295d087f371e730cba82f76295", "srcset": "https://si.imgix.net/1b63a663/uploads/origins/4b3d5777-4b52-4653-bdc6-e1f728db6529?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=899532295d087f371e730cba82f76295, https://si.imgix.net/1b63a663/uploads/origins/4b3d5777-4b52-4653-bdc6-e1f728db6529?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=9c9b0ccb7ef6db9198fcc3dba4df6be9 2x, https://si.imgix.net/1b63a663/uploads/origins/4b3d5777-4b52-4653-bdc6-e1f728db6529?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=17ed3353a94d35e6dcedb589f3a6a5a6 3x"}, "body": "いつもお世話になっております。\n\nよろしければ、うちのこトウカのイラストを描いていただきたいと思います。\n服装は設定画を参考にお願いします。帽子やアクセサリーなど多少の追加は構いません。\nポーズや構図などはお任せいたしますが、和風のイメージ強めで描いていただけると嬉しいです。\n\n使用用途として、描いていただいたイラストを切り絵にさせていただくかもしれません。\nその場合の投稿先候補としてはMisskey.io、Misskey.art、X(Twitter) を考えております。\n\nどうぞよろしくお願いいたします。\n\nhttps://misskey.io/notes/9rkcgca8ia6t0dda", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@rikka_kamisaka/works/10", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1673566, "client_id": 782821, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/d524aa14/uploads/origins/a3d4a3c6-dea7-4637-915d-e2a4b26c6e03?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d84e9edc772e7585a7e4523565bb3305", "srcset": "https://si.imgix.net/d524aa14/uploads/origins/a3d4a3c6-dea7-4637-915d-e2a4b26c6e03?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d84e9edc772e7585a7e4523565bb3305, https://si.imgix.net/d524aa14/uploads/origins/a3d4a3c6-dea7-4637-915d-e2a4b26c6e03?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=370c04ab7fa63a5e6759f7ce9efde639 2x, https://si.imgix.net/d524aa14/uploads/origins/a3d4a3c6-dea7-4637-915d-e2a4b26c6e03?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ca44f0e8ecd7d115369237811c5460af 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/d524aa14/uploads/origins/a3d4a3c6-dea7-4637-915d-e2a4b26c6e03?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=bbd37766e2809dc96100dc37c054621e", "srcset": "https://si.imgix.net/d524aa14/uploads/origins/a3d4a3c6-dea7-4637-915d-e2a4b26c6e03?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=bbd37766e2809dc96100dc37c054621e, https://si.imgix.net/d524aa14/uploads/origins/a3d4a3c6-dea7-4637-915d-e2a4b26c6e03?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=57bb86745eb09e4649d4b2032f6cdd0b 2x, https://si.imgix.net/d524aa14/uploads/origins/a3d4a3c6-dea7-4637-915d-e2a4b26c6e03?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=f2c73c1a1ff1eb716996ae45313d7b1d 3x"}, "body": "前回はとても可愛いイラストありがとうございました！！\n \nまたよろしければ自創作のキャラをリクエストさせていただいてもよろしいでしょうか？ \nURLに資料や作品を繋げておりますのでご参考ください。  \n\n◆キャラ 「墨染千晃」 \n・わかりやすいツンデレキャラ。\n・目付きが悪く、基本的に無表情か不機嫌そうなムスッとした顔をしています。 \n・イメージカラー：赤  \n※URL資料の記事をスクロールしていただくと2番目に該当のキャラが出てきます。\n お手数ですがオリジナルサイズで大きいサイズを表示した上でご確認下さい。  \n\n◆服装 \nおまかせします。\n資料にある服でお好きな服をお選びください。\n\n◆その他\nポーズや構図などは特に指定ございませんので、お好きに描いていただければと思います。 \n可能であればキャラの周りが透過されたデータもいただけると嬉しいです。  \n\n何卒ご検討よろしくお願いいたします！\n\nhttps://tasomorera.fanbox.cc/posts/5139351", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@rikka_kamisaka/works/9", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1673566, "client_id": 2796206, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/d771ded0/uploads/origins/e1ff46c5-1563-45b4-a0f3-d91bef003dbe?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=cf423b842af004a77e127a6fcc265c76", "srcset": "https://si.imgix.net/d771ded0/uploads/origins/e1ff46c