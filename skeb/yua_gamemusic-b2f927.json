/watch?v=SjIJfwaFSAE (曲)\n\nhttps://drive.google.com/drive/folders/1sFCc23RO554v4qhp4oTCPKIFpEFRBJ8m?usp=sharing (OC)", "nc": 144, "word_count": 0, "transcoder": "audio", "creator_acceptable_same_genre": true}, {"path": "/@yua_gamemusic/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "music", "tipped": true, "creator_id": 3828252, "client_id": 2283998, "vtt_url": null, "thumbnail_image_urls": {"src": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1551109754004549632%2FzTtIfbaR.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e7b9571fa09d3d45c242de918983c3a0", "srcset": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1551109754004549632%2FzTtIfbaR.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e7b9571fa09d3d45c242de918983c3a0, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1551109754004549632%2FzTtIfbaR.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=818103f017ccfd1ab7a18d344d56a02b 2x, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1551109754004549632%2FzTtIfbaR.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=5ce6313be996855adb83f3b9e08c1c97 3x"}, "preview_url": "https://fcdn.skeb.jp/uploads/outputs/2181a5b6-23be-461d-98f8-00204325e171?response-content-disposition=inline&Expires=1780461023&Signature=dq2Fb-GwW9f4anL-LxCwoqV3CAk~SSzM~ucmthxHYXDGf01hDtJyZ3qN~H-GHluiIauywo7KPjknKEApVgFa~huD7d63t2bQvthK6xfrcKBjBLVM8vVJSFtC0DcnH9xqqRkmO0L7TdTr0oR38TvAWq6tsCk7KWwDSBG1BRkbdlp6KPI13yoh-UB2WRRWdFrghT~b45NEuhr5f0YON8kvYttRPCcSlxv0i1ZePqaBgImZ37eyeUoOItzxijfx~ldh2vzJ2RjyMMqC7eoAfxzfV1XVlx0gPzVKuisqW-GqS2qU-cfI9FCdTiwTAPsVxRhmCZQ8zyhHLW3JfEGUFyljgw__&Key-Pair-Id=K1GS3H53SEO647", "duration": 105, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://skeb-avatar.imgix.net/https%3A