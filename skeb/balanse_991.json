ている状態(ジャケットのような感じになります)\n　表情は笑顔で、顔全体を描いていただければと思います。\n　首から下については、安定さんの描きやすい部分までで構いません(例：胸元まで、上半身全体等)\n\n以上が描いていただきたい絵の詳細となります。\n不慣れなところもあり、伝わり辛かったら申し訳ありません…。\n\n資料URLについては添付致します。\nお忙しいなかでの急な以来となりますが、\nどうかよろしくお願いします！\n\nhttps://drive.google.com/drive/u/3/folders/1tlorCBRHa6joms4i3ph75tnnZIzyCuJm", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [{"path": "/@gigash/works/39", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 71461, "client_id": 303622, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/2b023c7a/uploads/origins/f419f323-0426-40a2-b826-fc58c87e5ac6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6c4462519de2f9e135e71b1d125162bd", "srcset": "https://si.imgix.net/2b023c7a/uploads/origins/f419f323-0426-40a2-b826-fc58c87e5ac6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6c4462519de2f9e135e71b1d125162bd, https://si.imgix.net/2b023c7a/uploads/origins/f419f323-0426-40a2-b826-fc58c87e5ac6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=3681a031d587d1a7e5ee9205beaccf4c 2x, https://si.imgix.net/2b023c7a/uploads/origins/f419f323-0426-40a2-b826-fc58c87e5ac6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=325cdd56a285ad00e765164edd8a961e 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/2b023c7a/uploads/origins/f419f323-0426-40a2-b826-fc58c87e5ac6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c8f749a36293a3ac797127ad6fe498d9", "srcset": "https://si.imgix.net/2b023c7a/uploads/origins/f419f323-0426-40a2-b826-fc58c87e5ac6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c8f749a36293a3ac797127ad6fe498d9, https://si.imgix.net/2b023c7a/uploads/origins/f419f323-0426-40a2-b826-fc58c87e5ac6?bg=%2