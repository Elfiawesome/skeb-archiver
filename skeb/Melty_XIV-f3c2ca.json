のリファレンス・フォルダーがある。フォルダには \"MNK \"というラベルがついている。  どの衣装を選ぶかは自由です。\n\n彼女の表情については、冒頭でリンクした2枚のポートレートで気に入った点として、人を惹きつける笑顔と決意の固さを挙げました。また、私が希望する大まかなスタイルに合う例として、表情の画像をいくつか掲載しました。具体的なディテールはお任せしますので、そのスペースに収まるものであれば何でもOKです。\n\n私の要望を考慮していただき、ありがとうございました！\n\nhttps://drive.google.com/drive/folders/108QdpAzFcno3-Joaw12hxbJAi6EN0bgj?usp=drive_link", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@Melty_XIV/works/10", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/a0121267/uploads/origins/72994b8c-35c4-49a1-bdaf-9d880efba8a0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=5af0749aef482c3b8104959dda826dbb", "srcset": "https://si.imgix.net/a0121267/uploads/origins/72994b8c-35c4-49a1-bdaf-9d880efba8a0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=5af0749aef482c3b8104959dda826dbb, https://si.imgix.net/a0121267/uploads/origins/72994b8c-35c4-49a1-bdaf-9d880efba8a0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=d1b8e7a9dc9f342b5940d6b0222fa8d4 2x, https://si.imgix.net/a0121267/uploads/origins/72994b8c-35c4-49a1-bdaf-9d880efba8a0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=0ad574b10aaf2c511cd31ca2d2c500fa 3x"}, "private": true, "genre": "art", "tipped": true, "creator_id": 1543295, "client_id": 300885, "nc": 0}, {"path": "/@Melty_XIV/works/9", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1543295, "client_id": 1352565, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.n