dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=f8e0de3577be00525edbe1682b1b1f60 3x"}, "body": "こんにちは！地下リングマッチのイラストを依頼したいです。\n大会に参加する2人の格闘家のコードネームは「レッドドラゴン」と「ブラックスコーピオン」です。二人とも、発達した胸筋と硬い8パックの腹筋を持っています。\n彼らのうちの1人は、MMAグローブ、タイトなショーツ、足首ブレースなど、MMAスタイルの服装をしていた。\nもう一人は、ハンドラップ、タイトなブリーフ、足首ブレースなど、レスリングスタイルの服を着ていた。\n結局、一人のファイターが惨めに敗北し、かすかな射精でKOされた。彼は白目をむき、唾液が床中に飛び散り、勃起したペニスがショーツの中に射精された。\n\n2 人の格闘家をデザインして勝者と敗者を決めることができます。イラストは次のとおりです。\nhttps://x.com/sytravelers/status/1842936456198898101/photo/1\n\nどうもありがとうございます！\n\nhttps://x.com/sytravelers/status/1842936456198898101/photo/1", "nc": 35, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@gobri_comes/works/13", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1024336, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/cd16445a/uploads/origins/07a5c22a-8c05-43c0-82ac-5692508772c7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=07d76bb4e82f1f4bf4e13653488456bc", "srcset": "https://si.imgix.net/cd16445a/uploads/origins/07a5c22a-8c05-43c0-82ac-5692508772c7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=07d76bb4e82f1f4bf4e13653488456bc, https://si.imgix.net/cd16445a/uploads/origins/07a5c22a-8c05-43c0-82ac-5692508772c7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=94f6667545cbc20a8bfc98e3a9378d3e 2x, https://si.imgix.net/cd16445a/uploads/origins/07a5c22a-8c05-43c0-82ac-5692508772c7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=0e2083912851c688db0020e1be0e90de 3x"}, "duration": null, "nsfw": true, "hardcore": true, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/cd16445a/uploads/origins/07a5c22a-8c05-43c0-82ac-5692508772c7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=39d5b173a4a31f21c16b55f70970f14c", "srcset": "https://si.imgix.net/cd16445a/uploads/origins/