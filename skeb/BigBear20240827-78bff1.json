o=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ed1b9639f6c860c868bfe3cb804a3f19, https://si.imgix.net/2a92bc2f/uploads/origins/170b41be-0c99-4475-99fd-b621365e07d0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=53209644d22f84918b6f6092d85f3752 2x, https://si.imgix.net/2a92bc2f/uploads/origins/170b41be-0c99-4475-99fd-b621365e07d0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=6dd794bfd16f53cb0a14572fd7840b81 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/2a92bc2f/uploads/origins/170b41be-0c99-4475-99fd-b621365e07d0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a53195543d4eaf98842f832e9dbb77f1", "srcset": "https://si.imgix.net/2a92bc2f/uploads/origins/170b41be-0c99-4475-99fd-b621365e07d0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a53195543d4eaf98842f832e9dbb77f1, https://si.imgix.net/2a92bc2f/uploads/origins/170b41be-0c99-4475-99fd-b621365e07d0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=ccf7657d1baa6b5c6f41fa6cc3515ebb 2x, https://si.imgix.net/2a92bc2f/uploads/origins/170b41be-0c99-4475-99fd-b621365e07d0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=54c7bf1ae02327e6a145389e04a563e1 3x"}, "body": "リクエスト失礼します\n\nキャラ：幽乃うつろ\n服装：裸に、資料のURLのチョーカー。腕が白、脚が黒の逆バニー。\n特徴1：幽霊の子なので肌は白く、舌や乳首・乳輪、口内、膣内、アナルなど粘膜が青～紫系のカラーになっています(参考 https://cdn-ak.f.st-hatena.com/images/fotolife/o/onigirisan07/20240401/20240401112757.jpg)\n特徴2：両目の色が違います（向かって左が紫系、右が黄系）\nシチュ：\n・超軟体ポーズ(https://pbs.twimg.com/media/EnuCWhQVgAA6XMX?format=jpg&name=large https://pbs.twimg.com/media/EnuCWhaUUAEN04L?format=jpg&name=large)でおまんこがドアップのイメージ\n・表情は困り眉で控えめな笑顔、舌をべーっと出している。\n・左右からそれぞれおまんこと顔に向かってぶっかけ。精液の粘度が高いのでチンポから顔やおまんこへ糸を引いてつながっている。\n・吹き出しやカットインのような感じで、卵子に精子が受精しているところを描いていただきたいです。\n人魂のような感じで紫の火に包まれている卵子に5～6匹の精子が受精しています\n\n受けていただけますと嬉しいです。\nよろしくお願いします。\n\nhttps://pbs.twimg.com/media/FvXw3ydXsAkCO7N?format=jpg&name=large", "nc": 49, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@BigBear20240827/works/12", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3364045, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/e172e4ac/uploads/origins/033c9f2f-5395-4498-893b-c75e451ff351?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ea70f91bf71c4b71f14c65fad110b623", "srcset": "https://si.imgix.net/e172e4ac/uploads/origins/033c9f2f-5395-4498-893b-c75e451ff351?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ea70f91bf71c4b71f14c65fad110b623, https://si.imgix.net/e172e4ac/uploads/origins/033c9f2f-5395-4498-893b-c75e451ff351?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=460f0d319deaa94c740806e4d16c4288 2x, https://si.imgix.net/e172e4ac/uploads/origins/033c9f2f-5395-4498-893b-c75e451ff351?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=1e9a22fcedacfd7b03beaa4b4399dcbc 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/e172e4ac/uploads/origins/033c9f2f-5395-4498-893b-c75e451ff351?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=df86aa001b4451f9bf61f86ec030043d", "srcset": "https://si.imgix.net/e172e4ac/uploads/origins/033c9f2f-5395-4498-893b-c75e451ff351?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=df86aa001b4451f9bf61f86ec030043d, https://si.imgix.net/e172e4ac/uploads/origins/033c9f2f-5395-4498-893b-c75e451ff351?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=89f49eb3b779ef5aa88d9dba5cad7384 2x, https://si.imgix.net/e172e4ac/uploads/origins/033c9f2f-5395-4498-893b-c75e451ff351?bg=%23fff&auto=f