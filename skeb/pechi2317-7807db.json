青みがかったグレーの目、下の方にハイライト＋左目下に涙ぼくろ\n水色メイド服＋パニエ、頭の横に白い細リボン\n詳しくは資料リンクをご参照ください。\n\n▼利用用途\nSNSのアイコン、依頼の際の参考資料として使用予定です。\n\n参考資料のイラストはニコニコしていますが、ぺち様の魅力的なアンニュイな表情で仕上げていただけると嬉しいです。どうぞよろしくお願いします。\n\nhttps://drive.google.com/drive/folders/1p6plvYQ_1pE-lsoItfSW9kkiQJAD-yPz?usp=drive_link", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@pechi2317/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3104926, "client_id": 2410194, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/d1734d79/uploads/origins/3c233cb9-2fff-48b1-a626-fc777968c79a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=65f08af79963d5c238218647a10ef1ec", "srcset": "https://si.imgix.net/d1734d79/uploads/origins/3c233cb9-2fff-48b1-a626-fc777968c79a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=65f08af79963d5c238218647a10ef1ec, https://si.imgix.net/d1734d79/uploads/origins/3c233cb9-2fff-48b1-a626-fc777968c79a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=d6dc11a124e35929c00401a7cb6883bf 2x, https://si.imgix.net/d1734d79/uploads/origins/3c233cb9-2fff-48b1-a626-fc777968c79a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=badc511dac61bcd463b7ef003f5a93c9 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/d1734d79/uploads/origins/3c233cb9-2fff-48b1-a626-fc777968c79a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6210f5aa0f3656e33d29f24f9f8fa6c4", "srcset": "https://si.imgix.net/d1734d79/uploads/origins/3c233cb9-2fff-48b1-a626-fc777968c79a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6210f5aa0f3656e33d29f24f9f8fa6c4, https://si.imgix.net/d1734d79/uploads/origins/3c233cb9-2fff-48b1-a626-fc777968c79a?bg=%23fff&auto=format%2Ccompress&fm=