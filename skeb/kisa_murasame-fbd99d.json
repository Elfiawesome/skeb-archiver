る。特技はストリートダンス。\n\n構図等はお任せします、村雨様の感性で自由に描いていただけますと嬉しいです。\n\n以上、よろしくお願い致します。\n\nhttps://drive.google.com/drive/folders/1M3xfm-UqLN299gHAfeEphDqUzyj3GSsM", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@kisa_murasame/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 501742, "client_id": 2764760, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/5f0718db/uploads/origins/be7a6784-ac16-49cb-ba60-ca0325708181?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b1b2b3a79142134e54026a3c489c537c", "srcset": "https://si.imgix.net/5f0718db/uploads/origins/be7a6784-ac16-49cb-ba60-ca0325708181?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b1b2b3a79142134e54026a3c489c537c, https://si.imgix.net/5f0718db/uploads/origins/be7a6784-ac16-49cb-ba60-ca0325708181?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=0225edef979de39d322c435f955c02cd 2x, https://si.imgix.net/5f0718db/uploads/origins/be7a6784-ac16-49cb-ba60-ca0325708181?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=bb5d76b4a6f98fdf5b084a99717b0c55 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/5f0718db/uploads/origins/be7a6784-ac16-49cb-ba60-ca0325708181?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2a8f7ea8b59d131ecd559a830c760a38", "srcset": "https://si.imgix.net/5f0718db/uploads/origins/be7a6784-ac16-49cb-ba60-ca0325708181?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2a8f7ea8b59d131ecd559a830c760a38, https://si.imgix.net/5f0718db/uploads/origins/be7a6784-ac16-49cb-ba60-ca0325708181?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=df80418b9dec518d0eba9b3c73bcb042 2x, https://si.imgix.net/5f0718db/uploa