ークシスについてもっと詳しく書きたいのだが、今週はとても忙しく、あまり時間がない。\n好きなようにアークシスを描いてください！\nアピールにあるように描いてもいいし、もっと別のことをやりたければ別のシナリオを選んでもいい！\n\n彼女の伝承やキャラクターに関するメモがここにあります：\nhttps://skeb.jp/@shimazu_akadu/works/8\n\nよろしくお願いします！\nOC: https://drive.google.com/drive/folders/1cRFXt49i-LSBcZhBpTbgKIZAqCq4TPAW?usp=sharing\n\nhttps://drive.google.com/drive/folders/1cRFXt49i-LSBcZhBpTbgKIZAqCq4TPAW?usp=sharing", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@nyankowanwano/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3563171, "client_id": 3227487, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/8002c386/uploads/origins/eccc0f4e-0cf2-4981-a2f8-d316c1749ab0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0913cd838b58dc0efb911c6ca7e179e3", "srcset": "https://si.imgix.net/8002c386/uploads/origins/eccc0f4e-0cf2-4981-a2f8-d316c1749ab0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0913cd838b58dc0efb911c6ca7e179e3, https://si.imgix.net/8002c386/uploads/origins/eccc0f4e-0cf2-4981-a2f8-d316c1749ab0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=30843af40ca0b2e6a6aeb8da5f9723e1 2x, https://si.imgix.net/8002c386/uploads/origins/eccc0f4e-0cf2-4981-a2f8-d316c1749ab0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=74a15c040bdcf50a001f16c344ba0725 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/8002c386/uploads/origins/eccc0f4e-0cf2-4981-a2f8-d316c1749ab0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c6bd9f7460ab5f070f8e75de2f5a55fd", "srcset": "https://si.imgix.net/8002c386/uploads/origins/eccc0f4e-0cf2-4981-a2f8-d316c1749ab0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c6bd9f7460ab5f070f8e75de2f5a55fd, https://si.img