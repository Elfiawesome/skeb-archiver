な服装で、かわいいハイヒール。ビューは非常にローアングルであるべきです。彼女は小さな城の上に立っていて、片方の靴を上げ、それを踏みつけようとしているはずです。ペニスの周りには宝石やリボンが巻かれていて、とても大きく勃起しているはずです。睾丸は大きく、音を立てて鳴るはずです。表情はドヤ顔で残酷に。そして、「死んでください！」と大きな声で言ってほしい。\n\n楽しんでいただけたら幸いです、ありがとうございました！\n\nhttps://drive.google.com/drive/folders/11cc6BmCbo3L9925WFBqMjoydpyDDOg2G?usp=share_link", "nc": 176, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@kiyoshi2431/works/11", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2643843, "client_id": 51961, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/1ff2162f/uploads/origins/84aac0fe-8050-4345-bc71-96ae69515694?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9130d27dd021c4a8ccd3dc84b284af63", "srcset": "https://si.imgix.net/1ff2162f/uploads/origins/84aac0fe-8050-4345-bc71-96ae69515694?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9130d27dd021c4a8ccd3dc84b284af63, https://si.imgix.net/1ff2162f/uploads/origins/84aac0fe-8050-4345-bc71-96ae69515694?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=85d84268264344b2fbf0771fe9193a41 2x, https://si.imgix.net/1ff2162f/uploads/origins/84aac0fe-8050-4345-bc71-96ae69515694?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=bc48f99cb67c0040fff694ae7b2bc4be 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/1ff2162f/uploads/origins/84aac0fe-8050-4345-bc71-96ae69515694?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e43822f736261d6f48ba797ba32fac68", "srcset": "https://si.imgix.net/1ff2162f/uploads/origins/84aac0fe-8050-4345-bc71-96ae69515694?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e43822f736261d6f48ba797ba32fac68, https://si.imgix.net/1ff2162f/uploads/origins/84aac0fe-8050-4345-bc71-96ae69515694?bg=%23fff&aut