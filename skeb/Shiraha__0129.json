le": true, "yearly_report_client_visible": false, "total_appeals_count": 0, "received_works": [{"path": "/@Shiraha__0129/works/17", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2652069, "client_id": 8151, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/e9599ec9/uploads/origins/6a3d5b06-9a2d-42af-b95b-f51f92e2a306?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=65478a73710369fe4497fff27ab41520", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/e9599ec9/uploads/origins/6a3d5b06-9a2d-42af-b95b-f51f92e2a306?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d35c61389ece82522c7082bd81d63613", "src_set": ""}, "body": "御世話になります。\n「鷺沢文香が何者かにクロロホルムを嗅がされて眠らされるシーン」をお願いします。\n・基本表情に「驚き」差分に「もがき」「目がとろーん」「薬が効き目の焦点が合わない」「白目を向き、気絶寸前（こちらは余裕があれば、で大丈夫です）」「目を閉じ気絶」「ハンカチ無しで寝顔が見える」をお願いします。\n・全裸で、乳やスジ（陰毛）が見える構図でお願いします。\n・犯人は腕など一部分やシルエットで大丈夫です。背景もこだわりません。\n・犯人に抱きしめられる感じで眠らされます。\n・よければ台詞や効果音の有無差分もよろしいでしょうか。", "nc": 56, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Shiraha__0129/works/16", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2652069, "client_id": 455860, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/7627e795/uploads/origins/9c91f293-7c21-430c-bc09-fbcbb7d4891e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2258b0ad82f99637315823b53220c004", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/7627e795/uploads/origins/9c91f293-7c21-430c-bc09-fbcbb7d4891e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=835432eafa61ea14acb04f59c7cc510d", "src_set": ""}, "body": "はじめまして、聖ちゃんのイラストから参りました。\n\nシンデレラガールズよりクラリスさんをお願いした