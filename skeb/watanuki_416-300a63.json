7-700db8c47e85?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=315fac26d2bec425b559e9f9952a6593", "srcset": "https://si.imgix.net/fab138fb/uploads/origins/683578d2-2aa7-4839-9df7-700db8c47e85?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=315fac26d2bec425b559e9f9952a6593, https://si.imgix.net/fab138fb/uploads/origins/683578d2-2aa7-4839-9df7-700db8c47e85?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=5466ffe46fc51677b6feb0c2e8e3f368 2x, https://si.imgix.net/fab138fb/uploads/origins/683578d2-2aa7-4839-9df7-700db8c47e85?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=009829fe52f15500dfa9dc86fa674918 3x"}, "body": "こんにちは。\n\nアズールレーンのJenkinsの作品をお願いしたいのですが !(URL参照)\n\nブルーアーカイブの響のようなチアガール姿のジェンキンスを見たいです（あなたが作ったものに近いもの :https://twitter.com/watanuki_416/status/1577238993221332992)\n\nクロップトップとスカートに「USS Jenkins」のマークを入れても良いですね。\n\n細かいところでは、ジェンキンスのリボンは頭につけたままでお願いします。\n\nポーズや表情はお好みで\n\nご検討よろしくお願いします。\n\nhttps://twitter.com/azurlane_staff/status/930342386315665408", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@watanuki_416/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 99115, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/fcc50388/uploads/origins/a36ddfd9-0da9-4ced-bfca-baa4507729b2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=67e0940ebb1db615d8160655acbec175", "srcset": "https://si.imgix.net/fcc50388/uploads/origins/a36ddfd9-0da9-4ced-bfca-baa4507729b2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=67e0940ebb1db615d8160655acbec175, https://si.imgix.net/fcc50388/uploads/origins/a36ddfd9-0da9-4ced-bfca-baa4507729b2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a1b7c4d5ae4acfcf3b11b4f315bcccd2 2x, https://si.imgix.net/fcc50388/uploads/origins/a36ddfd9-0da9-4ced-bfca-baa4507729b2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=04990337183146a41355a4b43216b615 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/fcc50388/uploads/origins/a36ddfd9-0da9-4ced-bfca-baa4507729b2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d611921e822645807b71da3f862d3849", "srcset": "https://si.imgix.net/fcc50388/uploads/origins/a36ddfd9-0da9-4ced-bfca-baa4507729b2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d611921e822645807b71da3f862d3849, https://si.imgix.net/fcc50388/uploads/origins/a36ddfd9-0da9-4ced-bfca-baa4507729b2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=9ffd47af71fbb9237fbd87a7f01f6805 2x, https://si.imgix.net/fcc50388/uploads/origins/a36ddfd9-0da9-4ced-bfca-baa4507729b2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=a90abbd00ae86330559d4f4bc361e7e5 3x"}, "body": "初めまして！\n最近の可愛いくてエッチなブルアカイラストが素晴らしかったなので可能であれば、ご依頼をお願いします。\n\n【キャラ、シチュ】\n１枚イラストで、同じ女の子のガチャゲーから４つバージョン・コスをお願いします。\n基本的に「ガチャゲー世界のパラドクスっぽい、同じ娘たちが同じハーレムに入れる」テーマ。\nキャラはファイアーエムブレムのミルラ様、ロリババアなので貧乳と小さい体を下さい。\nよければ四月一日六日先生のブルアカイロハやカエデが特に好きなので同じようエッチな感じがあると嬉しいです。\n\n【構図、コスの詳細】\n構図は主人公や男の視点から。４人の近くて誘いようなロリたち（見る人方を見ている）やのんびり雰囲気を希望します、先生の「pixiv.net/en/artworks/75146063」みたい。\n\nコス、バージョンについて：\n①　普通のミルラ様、構図の画面の手前で。萌え要素はミニスカや太もも。表情は穏やか・無口な彼女の小さいすぎる微笑みとか、上目遣い・少し不機嫌している（注意を引くための「こっち見て、私はオリジナル・本物だから」感じ）とか、どっちでもいい　imgur.com/a/m7UcBBX\n②　この女神っぽい聖なるミルラ、構図の画面の手前で。萌え要素はフィッシュテールスカート（前のスカート丈がすごく短い）。表情は参考のお姉ロリっぽい優しい微笑み　imgur.com/CexnCQu.png\n③　この魔法少女コスミルラ、構図の後ろで。ウサギっぽいの帽子なし、さらにエッチな感じに多少アレンジしていただけると幸いです（萌え要素のミニスカ、パンスト、腋窩にフォーカス）。ポーズは普通のキラキラ・ピースピース魔法少女っぽい、表情は赤面汗しているウインク笑顔（普段は温厚子の恥ずかしい元気魔法少女を演じるみたい）　imgur.com/Fnl7rWj.jpeg\n④　このハロウィンミルラ、構図の後ろで。コスのエッチ力が低いなのでまたアレンジして大丈夫。黒い上着なし等。バニーガールみたいにされる（バニー耳やハイヒールなので）が良いかもしれません。表情はジト目やため息（「なぜ、このコス…」感じ）　imgur.com/hlpndpV.png\n\n背景できればきれいな部屋の中（中世ファンタジーとか現代とか）を下さい。\n\n上記以外の事と詳細はそちらにお任せします。 よろしくお願いします！", "nc": 152, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@watanuki_416/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 99115, "client_id": 904824, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/aefb5a2a/uploads/origins/b43fcfb4-6c24-4915-a865-1350f8e5eae4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=aaaf6986b54bea8c6a209eb4cd2b14d5", "srcset": "https://si.imgix.net/aefb5a2a/uploads/origins/b43fcfb4-6c24-4915-a865-1350f8e5eae4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=aaaf6986b54bea8c6a209eb4cd2b14d5, https://si.imgix.net/aefb5a2a/uploads/origins/b43fcfb4-6c24-4915-a865-1350f8e5eae4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=20617f52254c773432733591019c7a96 2x, https://si.imgix.net/aefb5a2a/uploads/origins/b43fcfb4-6c24-4915-a865-1350f8e5eae4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=3d36f7ae83aa9525dc3afe98fe5bfbad 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/aefb5a2a/uploads/origins/b43fcfb4-6c24-4915-a865-1350f8e5eae4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=712f71eb4b5302f22c42c1d8e613fcb4", "srcset": "https://si.imgix.net/aefb5a2a/uploads/origins/b43fcfb4-6c24-4915-a865-1350f8e5eae4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=712f71eb4b5302f22c42c1d8e613fcb4, https://si.imgix.net/aefb5a2a/uploads/origins/b43fcfb4-6c24-4915-a865-1350f8e5eae4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=2b234bb8573930c755f61f56eae8aca9 2x, https://si.imgix.net/aefb5a2a/uploads/origins/b43