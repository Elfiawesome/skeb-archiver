&h=200&s=a71cc4899ff75b1475d2649d9e43a553 2x, https://si.imgix.net/6a64cdcc/uploads/origins/710ee966-bcee-4ca8-96e3-914e7316ba8c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d5a4d1451d04bb57669d0717d3cf29a8 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/6a64cdcc/uploads/origins/710ee966-bcee-4ca8-96e3-914e7316ba8c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a924b0ecc9b496f2a30d516b21be2d85", "srcset": "https://si.imgix.net/6a64cdcc/uploads/origins/710ee966-bcee-4ca8-96e3-914e7316ba8c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a924b0ecc9b496f2a30d516b21be2d85, https://si.imgix.net/6a64cdcc/uploads/origins/710ee966-bcee-4ca8-96e3-914e7316ba8c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=69660210381b00937ee13928bf75d96a 2x, https://si.imgix.net/6a64cdcc/uploads/origins/710ee966-bcee-4ca8-96e3-914e7316ba8c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=45a1ebe389ea1e4321ddddff5751d130 3x"}, "body": "再送失礼します。\n\nこがよんこさんが描いたオリジナルキャラ（https://fantia.jp/posts/1056598の赤い髪の娘）の円柱化をお願いします。\n\n・公園にあったパイプスライダーに懐かしさを感じて滑りこむが、何故か先に進むほど口径が細くなっており、結果、円柱状に排出されてしまう。というシチュエーションでお願いします。\n・円柱になった彼女の表情は、自分の異変に気付かず、楽しそうにしている感じでお願いします。\n・体育座りの状態のまま円柱状に圧縮（頭の天辺が円柱の天面、お尻と足の裏が合わせて円柱の底の面にくる感じ\n・円柱の比は3:2（高さ:幅）でおねがいします。", "nc": 48, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@kogaOnko/works/12", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1372259, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/c926cc39/uploads/origins/ba62f940-d8cb-4225-b6fc-cf565425b226?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d7978ebbe0dc3ed9fa253383a4f298c7", "srcset": "https://si.imgix.net/c926cc39/uploads/origins/ba62f940-d8cb-4225-b6fc-cf565425b226?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d7978ebbe0dc3ed9fa253383a4f298c7, https://si.imgix.net/c926cc39/uploads/origins/ba62f940-d8cb-4225-b6fc-cf565425b226?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=01989aa184cb800db7923160d242bb77 2x, https://si.imgix.net/c926cc39/uploads/origins/ba62f940-d8cb-4225-b6fc-cf565425b226?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=155d003eb87f0df54a07f73f9f5c11dc 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/c926cc39/uploads/origins/ba62f940-d8cb-4225-b6fc-cf565425b226?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f2ffe53a00140794e74b53812bef6957", "srcset": "https://si.imgix.net/c926cc39/uploads/origins/ba62f940-d8cb-4225-b6fc-cf565425b226?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f2ffe53a00140794e74b53812bef6957, https://si.imgix.net/c926cc39/uploads/origins/ba62f940-d8cb-4225-b6fc-cf565425b226?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=9e262765c5803f6a66608bca5bde67b0 2x, https://si.imgix.net/c926cc39/uploads/origins/ba62f940-d8cb-4225-b6fc-cf565425b226?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=13404e75dfa25f9d93be14983fc87be3 3x"}, "body": "以前リクエストさせてもらったブリトマートのダッチワイフ化のシチュエーションがとても良かったので、こちらのツイート【https://twitter.com/draw_swindler/status/1616979031165120513?t=GiZKfjR73-kFKiF5MJVcrA&s=19】の1枚目の女騎士スティレットがブリトマートのようにゴブリン討伐の依頼を受けてゴブリンの巣に向かうも魔法の杖でダッチワイフにされて尊厳破壊の限りを尽くされてしまう漫画風のイラストを2~3Pくらいでお願いします！\n\n1.ゴブリンの巣で何体かゴブリンを倒すスティレット\n\n2.スティレットの前に魔法の杖を持ったゴブリンが現れ、杖による攻撃を警戒して盾を構えて身を守るスティレット\n\n3.魔法の杖から放たれた魔法はスティレットを構えていた盾や剣ごとダッチワイフにしてしまう（剣と盾は風船でできたオモチャのようになってダッチワイフ化したスティレットの両側に落ちている）\nダッチワイフになったスティレットの角部分は角をそのまま膨らませた少し丸みを帯びた風船のような感じにして、装備は表面にプリントされたタイプ（スカート部分だけペラペラのビニールでスカートを表現している）\nと全裸の2種類をお願いします。\n\n4.ダッチワイフにされたスティレットをゴブリンが犯す。\n犯された後は全身にゴブリンの精液をぶっかけされてM字開脚のポーズで放置されて、放置されてるスティレットの前では2匹のゴブリンが風船のオモチャになった剣と盾でチャンバラみたいなことをしたり、魔法の杖を持ったゴブリンがスティレットに小便をかけたりして徹底的に尊厳を破壊してる感じのシーンをお願いします。\n\nスティレットの性格は自信家なのでドヤ顔や余裕がある感じの表情でお願いします。\nセリフは終始お嬢様言葉でダッチワイフにされた後も意識があり、最初はゴブリンに犯されるのを嫌がるがだんだん気持ちよくなって堕とされる。\n使用後の尊厳破壊のシーンでは意識も消えかけていて最期に誰かに助けを求めるような感じでまとめて下さい。\n\nゴブリンにセリフは無く、それっぽい鳴き声だけでOKです。\n表情は常にいやらしいというか雌をどう辱めるかニタニタしてる感じでお願いします。\n\nhttps://twitter.com/draw_swindler/status/1616979031165120513?t=GiZKfjR73-kFKiF5MJVcrA&s=19", "nc": 169, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@kogaOnko/works/11", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1372259, "client_id": 681844, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/878d2b11/uploads/origins/13a74661-3e2e-416b-ba92-7b69697eb5ce?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d4ac7732257dc8dc94424d3d4f79d7da", "srcset": "https://si.imgix.net/878d2b11/uploads/origins/13a74661-3e2e-416b-ba92-7b69697eb5ce?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d4ac7732257dc8dc94424d3d4f79d7da, https://si.imgix.net/878d2b11/uploads/origins/13a74661-3e2e-416b-ba92-7b69697eb5ce?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=1caabfdd589060c71d36ff9f88a0b4f2 2x, https://si.imgix.net/878d2b11/uploads/origins/13a74661-3e2e-416b-ba92-7b69697eb5ce?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=6492cd513dc941e1e7724b1b6d3a6023 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/878d2b11/uploads/origins/13a74661-3e2e-416b-ba92-7b69697eb5ce?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9cec8c8d77fef58c343ec2cca2d55b92", "srcset": "https://si.imgix.net/878d2b11/uploads/origins/13a746