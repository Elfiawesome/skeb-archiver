 "nc": 161, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@miyukiyayaa/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2797605, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/44f2895c/uploads/origins/8236e530-0c9d-48c0-adf3-1b7589039fe5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7e148c3d91f3d9496beef1e26d037576", "srcset": "https://si.imgix.net/44f2895c/uploads/origins/8236e530-0c9d-48c0-adf3-1b7589039fe5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7e148c3d91f3d9496beef1e26d037576, https://si.imgix.net/44f2895c/uploads/origins/8236e530-0c9d-48c0-adf3-1b7589039fe5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=3aab4e8bf07b478587f91730e1c72774 2x, https://si.imgix.net/44f2895c/uploads/origins/8236e530-0c9d-48c0-adf3-1b7589039fe5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=0880bd2c3235ad510f1dc3424b8772ea 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/44f2895c/uploads/origins/8236e530-0c9d-48c0-adf3-1b7589039fe5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=faa27b8fe4688d4f33122be018c84082", "srcset": "https://si.imgix.net/44f2895c/uploads/origins/8236e530-0c9d-48c0-adf3-1b7589039fe5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=faa27b8fe4688d4f33122be018c84082, https://si.imgix.net/44f2895c/uploads/origins/8236e530-0c9d-48c0-adf3-1b7589039fe5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=1f77afc1ddcd4a0701cd2020affa4e42 2x, https://si.imgix.net/44f2895c/uploads/origins/8236e530-0c9d-48c0-adf3-1b7589039fe5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=59da16c64b82598073f4e0c52d78cecc 3x"}, "body": "はじめまして。\n以前、ドルフロのキャラを描かれていたので可能であればリクエストをお願いできればと思います。\n【キャラ】\nドールズフロントラインよりスプリングフィールド。\nキャラクターの外見や服装については資料URLを参考にしていただければと思います。\n【外見】\n服装は、資料URLの「カフェ立ち絵」のもの（エプロンはなし、タイトジーンズ）。\n見える状態であれば陰毛あり。\nシャツははだけている状態ですがブラは脱がさず。\nジーンズは太もも程度まで脱がしてショーツずらしで挿入。\n乳房の露出の状況等についてはおまかせいたします。\n【シチュエーション】\nカフェで指揮官と情事に至ってしまい、カウンターかテーブルに手をついての立バック。\n中出しされてしまうもスプリングフィールドも絶頂してしまい潮を吹いてしまう。\n精液や愛液でジーンズが汚れてしまい、惚けているもののちょっと釘をさすお姉さんといった感じ。\n\nという形で依頼させていただければと思います。\nイメージとしては以前描かれていました、叢雲とのエッチのようなイメージです。（https://www.pixiv.net/artworks/70081829）\n精液や愛液のかけられ具合、垂れ具合の表現の加減はお任せいたします。\nよろしくお願いいたします。\n\nhttps://wikiwiki.jp/suosuo/%E3%82%B9%E3%83%97%E3%83%AA%E3%83%B3%E3%82%B0%E3%83%95%E3%82%A3%E3%83%BC%E3%83%AB%E3%83%89", "nc": 176, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@miyukiyayaa/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2797605, "client_id": 3041191, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/2afe0482/uploads/origins/766b2363-64c2-4467-9edb-20d427571bb7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=711089def481fc95d360659f170c5bf9", "srcset": "https://si.imgix.net/2afe0482/uploads/origins/766b2363-64c2-4467-9edb-20d427571bb7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=711089def481fc95d360659f170c5bf9, https://si.imgix.net/2afe0482/uploads/origins/766b2363-64c2-4467-9edb-20d427571bb7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=47da895ab3f17c6a54a564ecda20f8e9 2x, https://si.imgix.net/2afe0482/uploads/origins/766b2363-64c2-4467-9edb-20d427571bb7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=0b841197b7ccd079ae2f359027bbb468 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/2afe0482/uploads/origins/766b2363-64c2-4467-9edb-20d427571bb7?bg=%23fff&auto=format%2