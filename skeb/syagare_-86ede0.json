ail_image_urls": {"src": "https://si.imgix.net/f4bc8719/uploads/origins/c840b90a-a342-4d07-a3ec-e93acd76d713?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=7e9072ccfd77c3b823b0b6cb95ed5bb4", "srcset": "https://si.imgix.net/f4bc8719/uploads/origins/c840b90a-a342-4d07-a3ec-e93acd76d713?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=7e9072ccfd77c3b823b0b6cb95ed5bb4, https://si.imgix.net/f4bc8719/uploads/origins/c840b90a-a342-4d07-a3ec-e93acd76d713?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=e1467d74f33de10e16e17eb6763b8d92 2x, https://si.imgix.net/f4bc8719/uploads/origins/c840b90a-a342-4d07-a3ec-e93acd76d713?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=bed66fe83787f590a05fd1804e686842 3x"}, "body": "しゃがれ様初めまして\n新着クリエイター欄でお見かけして\nリクエストさせていただければと思います。\n\nリクエストは自分のうちの子であるオリジナルキャラクター作品です。\n\n\nテーマとしては\nもしうちの子が『葬送のフリーレン』世界にいたら\nというものをお願いしたく\n服装などアレンジいただければ幸いです。\n\n\nもし複数人が可能でしたら2人描写いただければ幸いです。\n\n\n1人目\n柄葉五鈴(つかは いすず)ちゃん\nとても明るい元気な子\n身長は167センチ\n資料内には肌が褐色っぽいのもありますが通常の肌色でお願いします。\n\nhttps://www.dropbox.com/scl/fo/e8iu1cvikxaj8q57lf5jp/h?rlkey=tozw7ff7id1z7fvch02u38olv&dl=0\n\n2人目\n悪鈴ちゃん\n\n五鈴ちゃんの別個体になります。\n性格はわかりやすくいうとツンデレに近く\n悪鈴ちゃんが別個体ということもあり五鈴ちゃんを少し敵視してイタズラなどを仕掛けるがいつも五鈴ちゃんが無意識ながらそれを躱し、無意識反撃や自滅などしてしまう。\n体型は五鈴ちゃんと同じで\n肌の色は資料通りで問題ありません\n\n\n\nhttps://www.dropbox.com/scl/fo/ze944cqnnlatlb5r711e1/h?rlkey=s8ng0tafa8a9ee9er8s3nbdn4&dl=0\n\n\n\nhttps://www.dropbox.com/scl/fo/4ixd0ax0u7fcybbmg9gr4/h?rlkey=k96r8p5lotlhcljz3l409m7z5&dl=0", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 1228969, "creator": true, "nsfw_acceptable": true, "acceptable": false, "name": "しいたけ", "screen_name": "kta_922", "avatar_url": "https://pbs.twimg.com/profile_images/1879402942480236544/D0Mkfve3.jpg", "header_url": "https://pbs.twimg.com/profile_banners/848793733