txtfont64=QXZlbmlyLUJsYWNr&txtfit=max&txtalign=middle%2Ccenter&txtsize=60&txtshad=10&auto=format%2Ccompress&fit=crop&crop=top&w=1200&h=630&s=2643d6957bbc97e506e85967938f890b", "skills": [{"genre": "art", "default_amount": 6000}], "payment_methods": {"credit_cards": {"jcb": {"nsfw": true}, "master_card": {"nsfw": true}, "visa": {"nsfw": true}, "discover": {"nsfw": true}, "american_express": {"nsfw": true}}}, "acceptable_only_public": false, "tip_acceptable": true, "yearly_report_client_visible": false, "total_appeals_count": 0, "received_works": [{"path": "/@hal_yuru/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2113826, "client_id": 3995169, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/875e4933/uploads/origins/f5cd275a-1c6b-4041-8bb7-a3ff9ad61ed4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e24dd73e097540112b309dfda0b8f160", "srcset": "https://si.imgix.net/875e4933/uploads/origins/f5cd275a-1c6b-4041-8bb7-a3ff9ad61ed4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e24dd73e097540112b309dfda0b8f160, https://si.imgix.net/875e4933/uploads/origins/f5cd275a-1c6b-4041-8bb7-a3ff9ad61ed4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=0d4be9940516854135df38ab5cd602dd 2x, https://si.imgix.net/875e4933/uploads/origins/f5cd275a-1c6b-4041-8bb7-a3ff9ad61ed4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=94561585430db1929430c37332924d29 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/875e4933/uploads/origins/f5cd275a-1c6b-4041-8bb7-a3ff9ad61ed4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3f51717cce121507908d0f7d8c2bbcd0", "srcset": "https://si.imgix.net/875e4933/uploads/origins/f5cd275a-1c6b-4041-8bb7-a3ff9ad61ed4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3f51717cce121507908d0f7d8c2bbcd0, https://si.imgix.net/875e4933/uploads/origins/f5cd275a-1c6b-4041-8bb7-a3ff9ad61ed4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=02c730dc1318a7bdc2f0ba029098617a 2x, https://si.imgix.net/875e4933/uploads/origins/f5cd275a-1c6b-4041-8bb7-a3ff9ad61ed4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=d9f75b016db64f5570416a7d3408fa25 3x"}, "body": "halさんこんにちは！\n今回依頼させて頂くのは、私のオリジナルキャラ（版権キャラとの夢創作のヒロインとして作った固定夢主）の単体イラストです。\n\n\n▼イラストのテーマ\n「拙宅夢創作の2人をイメージした香水のキービジュアル」\n自カプイメージのグッズが発売された！というていで楽しみたいと考えています。\n\n▼使用用途\n個人使用の範疇で楽しませて頂きます。\nイラストを個人的にプリントし、実際の香水と揃えて自室に飾らせて頂きたいです。\nまた、完成したイラストは、私のSNS（X、Bluesky）にて、調香師の方から頂いた香水の解釈や香りの説明文等を添えて、halさんにイラスト作成頂いたことを明記した上で公開させて頂きたいと考えています。\n\n\n▼キャラクター資料\n・X（リンクは正面、横顔、デフォルメが混ざったカラーイラストに繋がるポストです）\nhttps://x.com/sunknown68/status/1948759482462601469?s=46&t=IN2D8OKXxfReEGlM_rNwhw\n\n\n▼簡易プロフィール\n名前：パピィ\n性別：女　　年齢：20歳\n性格：気遣い屋、照れ屋、穏やか／気弱、心配性、臆病\n\n\n▼構図、シチュエーション、背景について\n・香水瓶を顔の近くに持ってこちらを見ている構図。\n顔の表情がよく分かるようにバストアップ、もしくは座っているポーズ。\n香水瓶のサイズは30mlくらいのイメージで（正確でなくて大丈夫です）形はお任せします。\n実際の香水は細長いペン型のボトルですが、忠実に再現する必要はありません。一般的なブランド香水のボトルのイメージでお願いします。\n\n・好きな人を見つめるような表情。\n「自分の恋心を上手く伝えられないことをもどかしく思っている」ような、甘く切ない雰囲気だと嬉しいです！\n\n・背景の有無はお任せしますが、単色塗りつぶしの場合は白（陽光などは可）。\n柄やモチーフを使用する場合、原色を避けて淡い雰囲気に。\n背景ありの場合、街中等の騒がしいロケーションは避けて、海や花畑、空が見える場所、神聖な雰囲気（教会や遺跡） 等の自然に近い静かな空間だとありがたいです。\n\n\n▼服装について\n・白を基調とした薄手のフリルやレース、オーガンジーのような素材を用いたフェミニン系統の服装。\n（あくまでイメージのため、無理に全て含まなくても大丈夫です）\n\n・品良く見える程度のさりげない肌見せがあると嬉しいです。\n更に言うと、ノースリーブやオフショル等、肩が見えるとかなり嬉しいです。\n装飾品の追加、差し色の有無や割合はお任せします。\n\n・デフォルトは紺色っぽいヘアバンドを着用しています。\nヘアバンドの色・材質の変更、髪型アレンジの有無はお任せしますが、キャラクターのアイデンティティに関わるため、可能であれば ヘアバンドのシルエットは崩さずに描いて頂けるとありがたいです。\n（例…ヘアバンドを違う色のリボンやカチューシャに変更する 等はOK）\n\n・普段なら帽子やフードでヘアバンドが隠れる分には大丈夫ですが、今回はイラストのイメージ的に顔のシルエットが大きく隠れるような服装は避けて頂きたいです。\n（例…透けているレースやリボン、花飾り等を頭に被っている 等の表現はOK）\n\n\n▼補足\n香水の香りの中でイラストのイメージに合いそうな部分を共有します。\n・トップノート…お相手のイメージです。\n・ミドルノート…鈴蘭、（ヒヤシンス）\n・ラストノート…アンブレットシード、（アンバー、オリバナム）\n尚、あくまで香りのイメージのため、無理に要素を含めずとも大丈夫です。\nどちらかというとキャラをイメージする植物はカスミソウですが、こちらも無理に含めずとも可。\n\nまた、こちらの香水はScentlyさんに作成頂いたものです。\n補足として香水本体の仕上がりイメージを共有させて頂きます。\n（既に終了していますがこちらのキャンペーンで作成頂いたものです。説明カードのハート型を黄色×水色で作成頂いています）\nhttps://x.com/scently_jp/status/2022143795941585094?s=46&t=IN2D8OKXxfReEGlM_rNwhw\n\n\n拙い長文で失礼いたしました。\nhalさんのご都合や体調を最優先した上で進行頂けますと幸いです。\n今後もhalさんの創作活動を心から応援しています！", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@hal_yuru/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2113826, "client_id": 3994620, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/b27f6a73/uploads/origins/9540f069-f371-4a5c-b1b7-eeb77f59a7a0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e56c9f10bdd8e779a8a87679c984de01", "srcset": "https://si.imgix.net/b27f6a73/uploads/origins/9540f069-f371-4a5c-b1b7-eeb77f59a7a0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e56c9f10bdd8e779a8a87679c984de01, https://si.imgix.net/b27f6a73/uploads/origins/9540f069-f371-4a5c-b1b7-eeb77f59a7a0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=eb2f5775c289fe8b22b274370ea0a5ee 2x, https://si.imgix.net/b27f6a73/uploads/origins/9540f069-f371-4a5c-b1b7-eeb77f59a7a0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=8759b849e3f662acc0d2338e292a4e10 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/b27f6a73/uploads/origins/9540f069-f371-4a5c-b1b7-eeb77f59a7a0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=21a17267538881f7fd547303d45a464e", "srcset": "https://si.imgix.net/b27f6a73/uploads/origins/9540f069-f371-4a5c-b1b7-eeb77f59a7a0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=21a17267538881f7fd547303d45a464e, https://s