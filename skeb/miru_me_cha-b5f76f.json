compress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f274ade3893c5ac6d7b3112d7e203fe9 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/8b6867b0/uploads/origins/b503b04d-aed6-4b25-a42b-b9572df4010d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e1e5063b2d2d50b66596ac788bd10a2e", "srcset": "https://si.imgix.net/8b6867b0/uploads/origins/b503b04d-aed6-4b25-a42b-b9572df4010d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e1e5063b2d2d50b66596ac788bd10a2e, https://si.imgix.net/8b6867b0/uploads/origins/b503b04d-aed6-4b25-a42b-b9572df4010d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=8270ae55e6573416ebb8445895c92a82 2x, https://si.imgix.net/8b6867b0/uploads/origins/b503b04d-aed6-4b25-a42b-b9572df4010d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=9fd501ab624971eed9a6e88844dfa973 3x"}, "body": "初めまして！\n\nYouTubeで配信活動をしている天夜さなと申します。\nスケブにて海松様のイラストを拝見し、キャラクターの表情や絵のタッチがとても好みだったのでリクエストを送らせていただきました！\n\n【使用用途】\nYouTubeでのサムネイル、配信、動画への使用\nSNSへの掲載\nネットプリントやグッズ化\n（サイン等を入れさせていただく可能性がございます）\n\n【依頼内容】\n冬っぽいイメージでおっきめのニットを着ているイラストをお願いいたします！\n太ももが見えてるものだと嬉しいです、、！\n髪型はふわふわに巻いておろしているものをお願いできたらと思います！\nサムネイルに使用予定なので、キャラクターの透過画像をいただきたいです。\n\n\nお忙しい中読んでいただきありがとうございます！\nよろしくお願いいたします。\n\nhttps://drive.google.com/drive/u/0/mobile/folders/17Pg88KDhaau4_LGGytYWCyppBZRog_Qd?usp=share_link", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@miru_me_cha/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3641980, "client_id": 3143432, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/c99c60fb/uploads/origins/21ce1ade-f1d6-48ff-8e90-51c937f44960?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f438511b0a514c475f157557cc6704ba", "srcset": "https://si.imgix.net/c99c60fb/uploads/origins/21ce1ade-f1d6-48ff-8e90-51c937f44960?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f438511b0a514c475f157557cc6704ba, https://si.imgix.net/c99c60fb/uploads/origins/21ce1ade-f1d6-48ff-8e90-51c937f44960?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=2ebd6c647070fdf9e3ec6adbb9648fc4 2x, https://si.imgix.net/c99c60fb/uploads/origins/21ce1ade-f1d6-48ff-8e90-51c937f44960?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=1f39818b65e2cdfda4c82977c91b3899 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/c99c60fb/uploads/origins/21ce1ade-f1d6-48ff-8e90-51c937f44960?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=165ba533861476f889b89ae53fa6278a", "srcset": "https://si.imgix.net/c99c60fb/uploads/origins/21ce1ade-f1d6-48ff-8e90-51c937f44960?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=165ba533861476f889b89ae53fa6278a, https://si.imgix.net/c99c60fb/uploads/origins/21ce1ade-f1d6-48ff-8e90-51c937f44960?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=a02ce2f088ee1d3754f954acfd965bfc 2x, https://si.imgix.net/c99c60fb/uploads/origins/21ce1ade-f1d6-48ff-8e90-51c937f44960?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=45087d6333fc5520de85189e31d3eee5 3x"}, "body": "海松様こんばんは！みゅーと申します。\nYouTubeでVTuberとして活動しております。\n\nかわいらしいイラストを拝見させていただき、絵柄がとっても好みだったので\nもし良ければ描いていただければと思い連絡させて頂きました。\n\n\n当方、みゅー・あうろーらのイラストを依頼させていただければと思います。\n\n\n衣装や構図、ポーズに関してはお任せします。当方の衣装でもよいですし何かしらのコスプレでも構いません。座っていても寝ていてもどのような角度でもかまいません。ゲームのキャラ風でも何かのボカロ曲モチーフでもOKです。セクシーなものでも問題ありません！\n海松様の趣味やフェチ、性癖などを全開で盛り込んでいただければと思います。\n（前髪は片目隠れでお願いします。表情豊かだとうれしいです。）\n\n\n\n人物の透過PNGかPSDを合わせて頂ければ嬉しいです。\n\n\n用途はXでの投稿や収益化したライブ配信や動画、アイコンやヘッダー使用、ネットプリント、グッズ、ファンボックスなどのVTuberとしての活動で