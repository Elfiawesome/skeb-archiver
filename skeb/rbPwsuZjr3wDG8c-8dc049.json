=200&h=200&s=2f864189a3a48ef556d378f7df5cd897", "srcset": "https://si.imgix.net/719450a3/uploads/origins/794555e4-dc40-4802-8505-65b1232c053c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2f864189a3a48ef556d378f7df5cd897, https://si.imgix.net/719450a3/uploads/origins/794555e4-dc40-4802-8505-65b1232c053c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=afb33c2fbf70508f500c28592f065862 2x, https://si.imgix.net/719450a3/uploads/origins/794555e4-dc40-4802-8505-65b1232c053c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c611ee60459b86389f7ff86e65143d7b 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/719450a3/uploads/origins/794555e4-dc40-4802-8505-65b1232c053c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=52b90aefcb7cc8418cb57b7b91ebef94", "srcset": "https://si.imgix.net/719450a3/uploads/origins/794555e4-dc40-4802-8505-65b1232c053c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=52b90aefcb7cc8418cb57b7b91ebef94, https://si.imgix.net/719450a3/uploads/origins/794555e4-dc40-4802-8505-65b1232c053c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=ff2e1cde5a9cf51e337fc05b4605046c 2x, https://si.imgix.net/719450a3/uploads/origins/794555e4-dc40-4802-8505-65b1232c053c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=9830cbb59d3ad9aae875f87acef97dec 3x"}, "body": "初めまして、短小シチュをお願い致します。\n\n【キャラクター】\n清姫(FGO)\n\n【シチュエーション】\nモテない短小男は偶然に手に入れた聖杯を使って、どんな異性も魅了できる自分に都合のいい「租チン崇拝特異点」を作りあげる。\n清姫に寝取りフェラシチュです。\n\n【内容】\n①男のもとに、レイシフトに失敗してマスターと離れ離れになった清姫が現れる。\n清姫に一目ぼれして告白する男だが、外見の不潔さやマスターへの愛を理由に断られる。\n(男の告白を本気で拒絶して罵り、マスターへの愛を語るセリフをお願いします。)\n\n②しかし租チンを見せられた清姫は態度が一変、聖杯による精神支配で魅了状態になり、マスターのペニスを「グロテスクなマラ」と呼び、男の租チンを「愛らしいおチンポ様♡」と呼び比べる。\n調子に乗った男の命令で皮越しに口づけする。\n(清姫の頭上に魅了状態のマークとエフェクトをお願いします。)\nhttps://appmedia.jp/wp-content/uploads/2020/04/c9e107150de82ea0d70f31f344f6237c.jpg　効果\nhttps://appmedia.jp/wp-content/uploads/2018/11/192338_ath8k.webp　中央マーク\n\n③男の命令で清姫はチン皮をめくり、チンカス掃除を長い舌を使ってすることになる。\n男は女の子に掃除してもらうために溜めていたといい、清姫は喜んで掃除をする。\n\n④最後はバキュームフェラで精液を搾り取る清姫。\n\n⑤ごっくんをお願いしながら口内射精。\n\n⑥舌を出して飲み込んだのを見せる清姫。\n魅了状態から永続魅了にデバフが変化。\nマスターが見つかるまで「おチンポの世話係」になると契約する。\n男への呼び方がご主人様に変わる。\n\n以上となります。\nよろしければご検討のほどよろしくお願いします。", "nc": 33, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@rbPwsuZjr3wDG8c/works/6", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/5f0b33e5/uploads/origins/acba9960-10ec-4b4a-af1d-eb716f951695?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=41bae57c11688c612d439c76c214d753", "srcset": "https://si.imgix.net/5f0b33e5/uploads/origins/acba9960-10ec-4b4a-af1d-eb716f951695?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=41bae57c11688c612d439c76c214d753, https://si.imgix.net/5f0b33e5/uploads/origins/acba9960-10ec-4b4a-af1d-eb716f951695?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=4cecd823dca3f5e082f02765474ef6d4 2x, https://si.imgix.net/5f0b33e5/uploads/origins/acba9960-10ec-4b4a-af1d-eb716f951695?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=2fbe1d43f4bca9f7d937430b0cd111dc 3x"}, "private": true, "genre": "art", "tipped": false, "creator_id": 169089, "client_id": 349624, "nc": 33}, {"path": "/@rbPwsuZjr3wDG8c/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 169089, "client_id": 2205615, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/eda154e2/uploads/origins/e10c9da7-29dd-45f9-936d-1e57fd90a3e1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=18b1645e4324c11e4697e7ef6effcce1", "srcset": "https://si.imgix.net/eda154e2/uploads/origins/e10c9da7-29dd-45f9-936d-1e57fd90a3e1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=18b1645e4324c11e4697e7ef6effcce1, https://si.imgix.net/eda154e2/uploads/origins/e10c9da7-29dd-45f9-936d-1e57fd90a3e1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=03f1650ae6771453575ddb1218cd5bb1 2x, https://si.imgix.net/eda154e2/uploads/origins/e10c9da7-29dd-45f9-936d-1e57fd90a3e1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=44dbc02a0a96810c16ef2f154719e793 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/eda154e2/uploads/origins/e10c9da7-29dd-45f9-936d-1e57fd90a3e1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=03d93c44277c581237bce030203b5a91", "srcset": "https://si.imgix.net/eda154e2/uploads/origins/e10c9da7-29dd-45f9-936d-1e57fd90a3e1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=03d93c44277c581237bce030203b5a91, https://si.imgix.net/eda154e2/uploads/origins/e10c9da7-29dd-45f9-936d-1e57fd90a3e1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=aa283e5c1f7a65c10d876b803b0b600d 2x, https://si.imgix.net/eda154e2/uploads/origins/e10c9da7-29dd-45f9-936d-1e57fd90a3e1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=132d5494b1ba8af7c4fa69fcc7d197ca 3x"}, "body": "初めまして。\n\n短小ラブラブシチュが非常に刺さったのでリクエストさせていただきます。\n\n描いていただきたいキャラクターはラブプラスの姉ヶ崎寧々さんです。\n\n・シチュエーション\n短小カレシの頼み事を断れない寧々さん、ホテルへの呼び出しにも快く応じる。\n\n・コスチューム\n乳首のところがハート型に開いたエロ下着\n\n・具体的な流れ\n①仰向けになったカレシの短小包茎チンポを指先でつまむようにシゴいて勃起させる。\n\n②皮を被ったままの亀頭に愛おしそうにキス\n\n③我慢できなくなってハート目発情顔でチンポにむしゃぶりつく、口を窄めてひょっとこフェラ\n\n④ハート目で見つめながら情けなく早漏射精させる\n\n⑤口内に出されたものを啜るように飲み干す\n\n⑥口元に精液と陰毛つけたまま顔の横でピース\n\n以上の流れを情けないカレシのお願いを愛おしそうにきいてあげるイチャラブプレイで描いて欲しいです。\n\n分量の多い内容になってしまいましたが、ご検討の程宜しくお願い致します。", "nc": 49, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@rbPwsuZjr3wDG8c/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 169089, "client_id": 905503, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/52ccdc2f/uploads/origins/0bedfa4c-78d6-4a8b-8ed5-1a6666fa3250?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=036024f03629e6a58c0152721f9171c7", "srcset": "https://si.imgix.net/52ccdc2f/uploads/origins/0bedfa4c-78d6-4a8b-8ed5-1a6666fa3250?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=036024f03629e6a58c0152721f9171c7, https://si.imgix.net/52ccdc2f/uploads/origins/0bedfa4c-78d6-4a8b-8ed5-1a6666fa3250?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=8272b3ae3b27971afcd4a87358f9a440 2x, https://si.imgix.net/52ccdc2f/uploads/origins/0bedfa4c-78d6-4a8b-8ed5-1a6666fa3250?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=4e379a89d8ddd7ba7b90872af2b381e7 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/52ccdc2f/uploads/origins/0bedfa4c-78d6-4a8b-8ed5-1a6666fa3250?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f65326e497151755923cfc9e07b406d1", "srcset": "https://si.imgix.net/52ccdc2f/uploads/origins/0bedfa4c-78d6-4a8b-8ed5-1a6666fa3250?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f65326e497151755923cfc9e07b406d1, https://si.imgix.net/52ccdc2f/uploads/origins/0bedfa4c-78d6-4a8b-8ed5-1a6666fa3250?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=b68c3b0fb6708a9eec100b9366f90b9d 2x, https://si.imgix.net/52ccdc2f/uploads/origins/0bedfa4c-78d6-4a8b-8ed5-1a6666fa3250?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=7776e3082699f1a98c299f7f26189c99 3x"}, "body": "前回は素晴らしいイラストをありがとうございました。今回もまた八宮めぐるのイラストをリクエストしたいです。\n\nシチュエーションは以下のものでお願いします。\n↓\n① 事務所のソファで休憩しているプロデューサーとその隣に座るめぐる。\n② プロデューサーはついつい事務員の七草はづきのお尻を目で追ってしまうが、めぐるは目ざとくそれに気づく。\n③ はづきが退室し2人きりになった事務所で突然プロデューサーにキスをするめぐる。\n④激しくキスをした後に、はづきを見ていたことを問い詰めるめぐる。\n⑤めぐるはプロデューサーの竿を取り出してお仕置きと称して手コキをする。\n⑥プロデューサーも負けじと手マンしてやり返す。\n⑦キスをしながら2人とも絶頂する。\n⑧その後、喧嘩していたことも忘れ、２人はキスをしてイチャイチャする。\n\nよろしければお願いします。", "nc": 185, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@rbPwsuZjr3wDG8c/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 169089, "client_id": 905503, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/fd7d2729/uploads/origins/b3d9f3f4-4fcb-4450-911f-3bfeba4b1c7c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=81816b621b1945436c93b302b979a97c", "srcset": "https://si.imgix.net/fd7d2729/uploads/origins/b3d9f3f4-4fcb-4450-911f-3bfeba4b1c7c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=81816b621b1945436c93b302b979a97c, https://si.imgix.net/fd7d2729/uploads/origins/b3d9f3f4-4fcb-4450-911f-3bfeba4b1c7c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=5b06680d4c6132703862ac693bfd730a 2x, https://si.imgix.net/fd7d2729/uploads/origins/b3d9f3f4-4fcb-4450-911f-3bfeba4b1c7c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d4c6399deda85d0c4505de9e70ad360c 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/fd7d2729/uploads/origins/b3d9f3f4-4fcb-4450-911f-3bfeba4b1c7c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6190c0f8339a8067c3133e05e858d243", "srcset": "https://si.imgix.net/fd7d2729/uploads/origins/b3d9f3f4-4fcb-4450-911f-3bfeba4b1c7c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6190c0f8339a8067c3133e05e858d243, https://si.imgix.net/fd7d2729/uploads/origins/b3d9f3f4-4fcb-4450-911f-3bfeba4b1c7c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=14c318138f594a0641cff2a94f08d9e3 2x, https://si.imgix.net/fd7d2729/uploads/origins/b3d9f3f4-4fcb-4450-911f-3bfeba4b1c7c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=e700a6311dae5e5f85ae5dd8710d3e86 3x"}, "body": "Pixivから飛んできました。\n初の依頼ですが、アイドルマスターシャイニーカラーズから八宮めぐるのイラストお願いします。\nデブ短小包茎で女性経験のないプロデューサーに処女ビッチ的な八宮めぐるが、イチャラブなひょっとこフェラをするイラストを差分込みでお願いします。\n\n①際どいマイクロビキニを着用し、プロデューサーを誘惑してパンツを脱がせるめぐる。\n②プロデューサーがちんこが小さくて恥ずかしいと言うと、「そうなの？かわいくて私は好きだな。」とちんちんにキスするめぐる。\n③皮の中に溜まったチンカスを見て、汚れてるから綺麗にしてあげると、皮の中を舌でなめまわす。\n④チンカスを咀嚼して、濃厚で癖になる味かもとめぐる。\n⑤先端を咥えて舐めまわし、口の中で皮を剥いてかっこよくなったねと褒めるめぐる。\n⑥ちんちんを咥えなおして、だんだんと激しくフェラチオをする。\n⑦見つめあいながら口内に射精、そのまま精液を飲み込むめぐる。\n⑧ちんちんから口を離しキスを浴びせながら、精液をもっと飲みたいからとおかわりをおねだりするめぐる。\n以上です。\n\n構図は以前描かれたこちらのようなイメージでお願いしたいです。\n↓\nhttps://www.pixiv.net/artworks/109053228\n\n八宮めぐる\n↓\nhttps://shinycolors.idolmaster.jp/idol/illuminationstars/meguru.html\n\n何か問題があれば遠慮なく却下や、再送要請をしてください。\nよろしければお願いします。", "nc": 168, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@rbPwsuZjr3wDG8c/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 169089, "client_id": 43940, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/1d99757e/uploads/origins/f50a0cb8-348a-4b3a-994b-ad16117b633f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c3e2c5faa2d9117f4a85ca30e8d5cd59", "srcset": "https://si.imgix.net/1d99757e/uploads/origins/f50a0cb8-348a-4b3a-994b-ad16117b633f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c3e2c5faa2d9117f4a85ca30e8d5cd59, https://si.imgix.net/1d99757e/uploads/origins/f50a0cb8-348a-4b3a-994b-ad16117b633f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c63e8cae12e971231c1347d4e7eebc82 2x, https://si.imgix.net/1d99757e/uploads/origins/f50a0cb8-348a-4b3a-994b-ad16117b633f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=24bb6d51b55fe35efff269321e4af862 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/1d99757e/uploads/origins/f50a0cb8-348a-4b3a-994b-ad16117b633f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=dbc9fd6b5b5c43cec33e2495ed870764", "srcset": "https://si.imgix.net/1d99757e/uploads/origins/f50a0cb8-348a-4b3a-994b-ad16117b633f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=dbc9fd6b5b5c43cec33e2495ed870764, https://si.imgix.net/1d99757e/uploads/origins/f50a0cb8-348a-4b3a-994b-ad16117b633f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=3382e7b16fd92652b700a360f763f23e 2x, https://si.imgix.net/1d99757e/uploads/origins/f50a0cb8-348a-4b3a-994b-ad16117b633f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=7bc8c316df7802cf2862f152c8259528 3x"}, "body": "アイドルマスターシンデレラガールズの向井拓海が\n短小包茎キモオタにお礼のキスとフェラする絵をお願いします\n服装は【愛の癒し系】及川雫＋のナース姿\nフェラする時のアングルはこの前の麗子と同じです\n\n（前提）\n深夜、キモオタが夜道を歩くとヤンキーたちがたむろしてるのを目撃しキモオタは適当な理由で警察に通報…するもその最中にヤンキーに見つかってボコボコにされて病院送りに\n実はそのヤンキーたち、拓海が以前所属してたレディースの後輩たちを拉致った直後で\nこれから輪姦しようとする直前だったので駆けつけた警察に御用されてキモオタは結果的に大手柄\n妹分たちを助けてくれたキモオタに恩義を感じた拓海はキモオタを看病しにナースに扮してキモオタの病室へ行き…\n（キモオタは拓海のライトオタク、写真集でオナる程度でライブはまだ行ったことない）\n\n具体的な流れ\n「ってことでお礼をしに来たんだよ」と現れた拓海\nキモオタは同じく大人気アイドルのナース服に興奮\n「これはお礼だ…チュッ♥」\n拓海は自分が出来る最大級のお礼としてキモオタにキスした\n生まれて初めて且つ大人気アイドルからのキスに歓喜するキモオタ\n拓海も熱が入り舌を絡ませるぐらいの激しいお礼キスをする\n※キスアングルは真正面で拓海のキス顔を見せてほしいです\n\nそのうち股間がふっくらするキモオタ\nすっかりデキあがってる拓海はズボンを下ろしてチンポを露出\n「へえこんなもんなのか」と手コキする拓海\n「よぉしお前が入院してる間は私がアンタの専用ナースになって看病してやる\n　ただのナースじゃねえぞ、いつでもどこでもお前のチンポをしゃぶる即尺ドスケベアイドルナースだ♥\n　妹分全員助けてくれたんだ、これぐらいはしないと女が廃るだろ♥」\n前ボタンを外し爆乳を露出させながらフェラチオ開始\n「いつでもどこでもオチンポナメナメ♥朝勃ちでも夜寝る前でもいっぱいしゃぶってやるよ♥」\nキモオタもすっかり拓海にメロメロになってたくみんがオンリー推しドル！とか言ったりして拓海もますます熱が入ってひょっとこフェラになる\n射精後は即尺ドスケベアイドルナース契約の証のチンポキスをする\n\n以上です、よろしくお願いします\n\nP.S.飲尿する場合は拓海は特に嫌な顔もせず\n「怪我して動くの辛いもんな、ションベンしたいときも呼べよ\n　私の口をし尿便代わりにしていいからさ、皆には内緒だぞ？」", "nc": 184, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@rbPwsuZjr3wDG8c/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 169089, "client_id": 43940, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/d4424964/uploads/origins/036ff545-577a-41dd-8ef5-4fcef7a29110?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=445088264e32a57fee208b952e8e6bba", "srcset": "https://si.imgix.net/d4424964/uploads/origins/036ff545-577a-41dd-8ef5-4fcef7a29110?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=445088264e32a57fee208b952e8e6bba, https://si.imgix.net/d4424964/uploads/origins/036ff545-577a-41dd-8ef5-4fcef7a29110?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=88e8a8d0f570f1e64804ab0876bfaa82 2x, https://si.imgix.net/d4424964/uploads/origins/036ff545-577a-41dd-8ef5-4fcef7a29110?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b788cc66408f90be85a99184ac268c14 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/d4424964/uploads/origins/036ff545-577a-41dd-8ef5-4fcef7a29110?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=4e7362f7fdd3e79afe94a4798c0e05dd", "srcset": "https://si.imgix.net/d4424964/uploads/origins/036ff545-577a-41dd-8ef5-4fcef7a29110?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=4e7362f7fdd3e79afe94a4798c0e05dd, https://si.imgix.net/d4424964/uploads/origins/036ff545-577a-41dd-8ef5-4fcef7a29110?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=d9b01cd3c4d9e78ba72c4cb454816d52 2x, https://si.imgix.net/d4424964/uploads/origins/036ff545-577a-41dd-8ef5-4fcef7a29110?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=d95eed75b2f4e7388352521e20ea06a6 3x"}, "body": "pixivリクエストでは片桐早苗ありがとうございました\nこちらでも始められたようなので1件リクエストしてみます\n\nこち亀の秋本・カトリーヌ・麗子が短小包茎キモオタのチンチンをフェラする絵をお願いします\n衣装はURLのセクシーポリス衣装というものです（ピンク色）\nアングルはこの前の早苗と同じような感じです\n\n（前提）\n・麗子はキモオタのおっぱいを見る目線を気持ち悪がってた\n・ある日キモオタが怪しい人間を見かけて通報したら\n　劇場版コ〇ンに出るような超極悪国際犯罪者であった\n・逮捕に貢献したとして警察上層部とキモオタの交渉の末の麗子が\n　キモオタの1か月の婦警妻になることになった\n・絵にほしいシーンはその冒頭のようなもの\n\n具体的な流れ\nホテルの一室で麗子が跪いてジト目のような表情で\n「もうっ、全く…あなたのような人が社会貢献どころか国際貢献するなんて…」\nと言いつつキモオタに早く早くっとせがまれてしょうがないと一転\nキモオタを見上げながら敬礼して口上を述べる\n「国際犯罪者を通報し逮捕に貢献していただきありがとうございます\n　この度のご協力に感謝いたしまして警察より本官、秋本・カトリーヌ・麗子が\n　1か月の間キモオタ様専用ば、爆乳ドスケベオナホ婦警妻に着任いたします♡」\nそう言って麗子はブラを外して爆乳おっぱいを晒して\n「おっぱい揉み放題、キスし放題、生セックスし放題、いつでもどこでもご命令ください♡」\nウインクしながらのドスケベ口上でキモオタが興奮して勃起、フェラをせがまれ\n「は、はい、愛情たっぷり麗子フェラ、どうか御受取ください♡」\nとフェラする麗子\nチンカスの匂いもして（なにこれ臭い、もうちゃんと洗いなさいよっ）と思いながらも口には出さず一生懸命フェラをしキモオタを射精\n短小チンポからいっちょ前にザーメンを出されて麗子、ほんの少し興奮\nキモオタはこの1か月で絶対麗子をモノにすると誓うのだった\n\n以上です\nご検討お願いします\n\nhttps://www.dropbox.com/scl/fi/one30w0nk92h4f8txgurz/.jpg?rlkey=ofwm7nuiw4fzlpc828mhw46mr&dl=1", "nc": 169, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 21933, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "ありあ。🎨", "screen_name": "koiiroharemoyou", "avatar_url": "https://pbs.twimg.com/profile_images/2021566581898387456/cG4Jdqgz.jpg", "header_url": "https://pbs.twimg.com/profile_banners/127465712/1777350680/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_