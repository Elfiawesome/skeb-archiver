d the format of the illustration are entirely up to you. I want to see the daily life of my guess.\nI'm new to Skeeve and don't know much about it, but if it bothers you, please feel free to go through with it.", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@12020626sr/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1409234, "client_id": 235230, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/0c1a6c86/uploads/origins/1f98a8b6-3a6e-40ca-af04-49b8b440f4b4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b98e0878dbe6af94f16d5d04f0b507d8", "srcset": "https://si.imgix.net/0c1a6c86/uploads/origins/1f98a8b6-3a6e-40ca-af04-49b8b440f4b4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b98e0878dbe6af94f16d5d04f0b507d8, https://si.imgix.net/0c1a6c86/uploads/origins/1f98a8b6-3a6e-40ca-af04-49b8b440f4b4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=26bd7503e9d70b84795bad736045972b 2x, https://si.imgix.net/0c1a6c86/uploads/origins/1f98a8b6-3a6e-40ca-af04-49b8b440f4b4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ae06d6bd12b41455528c3474338d0618 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/0c1a6c86/uploads/origins/1f98a8b6-3a6e-40ca-af04-49b8b440f4b4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=160204b78579492b030aa05425a4dd32", "srcset": "https://si.imgix.net/0c1a6c86/uploads/origins/1f98a8b6-3a6e-40ca-af04-49b8b440f4b4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=160204b78579492b030aa05425a4dd32, https://si.imgix.net/0c1a6c86/uploads/origins/1f98a8b6-3a6e-40ca-af04-49b8b440f4b4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=9166803e32a74b8