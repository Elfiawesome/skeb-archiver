/si.imgix.net/1efbc65a/uploads/origins/0c695e8e-8200-4d6e-b8b9-8de9b37c55f9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=7ad97dad6e95fdfbf8cfe06d169d1882 2x, https://si.imgix.net/1efbc65a/uploads/origins/0c695e8e-8200-4d6e-b8b9-8de9b37c55f9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f325e849212fd69d84a96c2e9b450c22 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/1efbc65a/uploads/origins/0c695e8e-8200-4d6e-b8b9-8de9b37c55f9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=8350f029508495b8b587402b0327f157", "srcset": "https://si.imgix.net/1efbc65a/uploads/origins/0c695e8e-8200-4d6e-b8b9-8de9b37c55f9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=8350f029508495b8b587402b0327f157, https://si.imgix.net/1efbc65a/uploads/origins/0c695e8e-8200-4d6e-b8b9-8de9b37c55f9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=b433cb695a67cfe47a37c82d037bcde8 2x, https://si.imgix.net/1efbc65a/uploads/origins/0c695e8e-8200-4d6e-b8b9-8de9b37c55f9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=f957d0d36f44584bcaaf34549a3ffe49 3x"}, "body": "登場人物はアカシ(PC1)・キョウイチ(PC3)・観主1(PC2)・GM(後ろ姿だけだったり顔にGMと書いて顔が分からないモブ)\nシーン全体のテーマとしては卓を囲んでTRPGをしている場面を\n自由にコマ割りして1枚のイラストにしてもらいたいです。\n\n例としては\n・1戦闘中1回の大技を使ってキメにいったモノのダイスがファンブルしてしまい茫然とするアカシとそれを見て爆笑するキョウイチ、ちょっと可哀想に思っている観主１\n・安全策を取ってトドメを刺しに行ったものの、クリティカル以外命中の状態でGMが素目のクリティカルを出して回避してしまい思わず「マジかよ……」という顔になるキョウイチと笑いを堪える他二人\n・クライマックス直前、アカシと観主1がやり取りする場面で感情が入りまくって涙を流してしまい全員でアカシをフォローする\n・もしくは告白したりなどと言った重要NPCを口説き落として味方につけるシーンで赤面するアカシと表情全部使って面白がるキョウイチとちょっと重要NPCに感情移入してうるっとしちゃう観主1\n\n等と言った、TRPGでよくありそうなシーンで一喜一憂している三人を藤嶋さんの絵で見たいです。\nお好きにシーンを削ったり追加したりしてください！", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@3Pdpta/works/9", "private_thumbna