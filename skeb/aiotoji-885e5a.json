4670-b3c7-1f38ac16c0b9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=8642cba01d1324ec0b05e6f4c116872e", "srcset": "https://si.imgix.net/1e4e8ae1/uploads/origins/3d9b9335-6a56-4670-b3c7-1f38ac16c0b9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=8642cba01d1324ec0b05e6f4c116872e, https://si.imgix.net/1e4e8ae1/uploads/origins/3d9b9335-6a56-4670-b3c7-1f38ac16c0b9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=7995897387f70379e3f65bb55d693ac3 2x, https://si.imgix.net/1e4e8ae1/uploads/origins/3d9b9335-6a56-4670-b3c7-1f38ac16c0b9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=fec55400f51e7fa1dd057b5a15de3be4 3x"}, "body": "VRチャット連携済み はじめまして\n手数料無料期間終了間際ですいません\n『准教授・高槻彰良の推察』を読んでて、この方の絵柄素敵だなといつか依頼してみたいなと思ってました\nもしよろしければOC2人のモノクロコミックをお願いします\n\nOC2人の私服姿を描いてほしいです\n私自身私服のセンスが皆無でどういうコーデがいいのか全く分からず、どうしてもOCには制服などを着てもらうしかなく。\n2人に似合う私服を先生に複数デザイン、着せていただきたく今回依頼しました\n\n【シチュエーション】\n休日、品揃え豊富でお洒落な洋服店に来た2人\n互いが互いに似合ってる・似合いそう、着せてみたかった全身コーデを着せる　という感じになります\n\n始めは②が①へこの服の組み合わせが似合うと複数着てもらいます\n次に①が②へ複数着てもらう\nこのお互い着せてるときは、褒めポイント、紹介ポイントを言ってる\n「こういう系似合うと思ってた」「こういうのもイケますね」などなど\n\n最後にお互い見合いあってて\n②「かっこいい」照れ、惚れ惚れしてる\n①「かっこいいですね」「(かわいい)」ポーカーフェイス\n\n以上があくまで話のイメージです\n難しい場合は一部分を端折ったり、変更してOKです\n背景は無しでOK\n\n\n【キャラ】\n①後輩　　②先輩\n↓詳細(ファイルにキャラ説明あります)\nhttps://photos.app.goo.gl/kHAT1fi4eBDzgR2r7\n\n\n【2人の関係性】\nhttps://photos.app.goo.gl/UoWkjNf27B9wHAcy9\n\n\nできれば描いてて出来たラフ、没ラフ、下絵などがあれば一緒に納品して頂けると嬉しいです\nもし金額等・不備があれば再送していただけると助かります\nぜひよろしくお願いします", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@aiotoji/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2700293, "client_id": 1677128, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/abaebb58/uploads/origins/f28bfa78-f133-4445-b948-320f8491fe80?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e4e3d71dcd1903412d4f886da4e88e46", "srcset": "https://si.imgix.net/abaebb58/uploads/origins/f28bfa78-f133-4445-b948-320f8491fe80?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e4e3d71dcd1903412d4f886da4e88e46, https://si.imgix.net/abaebb58/uploads/origins/f28bfa78-f133-4445-b948-320f8491fe80?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=28571a0e8078f770204b267f98f19c63 2x, https://si.imgix.net/abaebb58/uploads/origins/f28bfa78-f133-4445-b948-320f8491fe80?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d39244c781a2da11a6ed10bfa25ad451 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/abaebb58/uploads/origins/f28bfa78-f133-4445-b948-320f8491fe80?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=8fffc57e1c57f280f5912764a816bfea", "srcset": "https://si.imgix.net/abaebb58/uploads/origins/f28bfa78-f133-4445-b948-320f8491fe80?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=8fffc57e1c57f280f5912764a816bfea, https://si.imgix.net/abaebb58/uploads/origins/f28bfa78-f133-4445-b948-320f8491fe80?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=39776044b98d286e419bbf34a7728533 2x, https://si.imgix.net/abaebb58/uploads/origins/f28bfa78-f133-4445-b948-320f8491fe80?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=196fa8fd43d85a6fa1f519f69e71755d 3x"}, "body": "相尾灯自先生、初めまして。\n先生のイラストが大好きです！\nSkebを開設されたと知り、ぜひ私のOCを描いて頂きたくリクエストを送らせて頂きました！\n\nもし可能でしたら当方の創作BLを描いて頂きたいです。\n\n描いて頂きたい子は資料内に貼らせて頂きました！\n資料内におります、白髪の子は大きく口を開けて笑わないためこちらの表情のみNGでお願い致します。\nその他NGはないためお好きなように描いて頂ければ幸いです....！\n\n2人の関係性\n樹と瞬は義理の兄弟で同級生、現在は恋人同士です。\n樹は無口で感情をあまり言葉にしませんが、行動で好意を示すタイプで、無自覚にスキンシップ（抱きしめる・キスなど）をします。キスも衝動的で自然にすることが多いです。\n\n瞬は明るく感情表現が豊かで、樹のことが大好きで好意が分かりやすく出ます。樹に対して尊敬や「かっこいい」という気持ちも強く、キスされると驚いたり照れたりとリアクションが大きいです。\n\n2人の口調\n樹は口数が少なく、短い言葉で話すタイプです。\n落ち着いた話し方で、感情は行動で出ることが多いです。\n\n瞬は明るくリアクションが大きいタイプで、樹よりよく喋ります。\nツッコミや驚きの反応が多いです。\n\n構図、シチュ等はお好きなように描いて頂ければ幸いです！\n\n使用用途\nSNSのアイコンやヘッダー\n個人観賞用でグッズ制作をする場合がございます。\n\n金額が不足している場合はキャンセルお願い致します。\n\nご検討の程宜しくお願いいたします！\n\nhttps://drive.google.com/drive/folders/1_t4GeNnQQaDk6sbply4zpnqMwMh9SgkV", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@aiotoji/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2700293, "client_id": 2190184, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/1a4963e0/uploads/origins/02c04299-c892-4efc-b426-d3a1af600964?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7999321998267af23039b6b6aeaec5a2", "srcset": "https://si.imgix.net/1a4963e0/uploads/origins/02c04299-c892-4efc-b426-d3a1af600964?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7999321998267af23039b6b6aeaec5a2, https://si.imgix.net/1a4963e0/uploads/origins/02c04299-c892-4efc-b426-d3a1af600964?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=d493592d5e005c20d6e514dcc8f8d822 2x, https://si.imgix.net/1a4963e0/uploads/origins/02c04299-c892-4efc-b426-d3a1af600964?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f1056bb198ed9454d3a1f9b234a84b53 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/1a4963e0/uploads/origins/02c04299-c892-4efc-b426-d3a1af600964?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=4b6abe1f4b488c52434287aec493fc6f", "srcset": "https://si.imgix.net/1a4963e0/uploads/origins/02c04299-c892-4efc-b426-d3a1af600964?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=4b6abe1f4b488c52434287aec493fc6f, https://si.imgix.net/1a4963e0/uploads/origins/02c0429