.net/8d7ba70a/uploads/origins/734bfb96-b216-4fe2-b38a-9b7862b0da83?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=3f6430af1ec35d10051ef6b38f743b72 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/8d7ba70a/uploads/origins/734bfb96-b216-4fe2-b38a-9b7862b0da83?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0b48d9e08e0d016ca430989d8d85fc25", "srcset": "https://si.imgix.net/8d7ba70a/uploads/origins/734bfb96-b216-4fe2-b38a-9b7862b0da83?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0b48d9e08e0d016ca430989d8d85fc25, https://si.imgix.net/8d7ba70a/uploads/origins/734bfb96-b216-4fe2-b38a-9b7862b0da83?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=0b5bcaca2f8b122712b40aeb6af08427 2x, https://si.imgix.net/8d7ba70a/uploads/origins/734bfb96-b216-4fe2-b38a-9b7862b0da83?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=ad628a44faf90a0a770e84698d52da4d 3x"}, "body": "黒いドレスのオーラさんのスケブを拝見しましたが、まさに圧巻ですね。私のキャラクターも是非描いて欲しいです。\n\n彼女は優しくて、好奇心旺盛で、明るくて、ちょっと衝動的で、遊び心があり、よく物思いにふけることがあるんです。普段はおてんばな感じですが、きれいなドレスが好きです。\n\nリファレンスにはいくつかの衣装があるので、その中から好きなものを選んでください。ペイントされたリファレンスシートの服か、「MNK」と書かれた服のいずれかが最もふさわしいだろう。ただし、他に気に入った衣装があれば、そちらで描いてください。どんな絵を描いても楽しんでほしいです。\n\nできれば、私のキャラクターはPSDの別レイヤーにしていただけるとありがたいです。\n\nよろしくお願いします。\n\nhttps://drive.google.com/drive/u/1/folders/1HdxysbTza1ML9NZZkX0DSmU4swID-XZM", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@3ch__/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1407941, "client_id": 2328190, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/65086787/uploads/origins/09031c88-d17e-461c-ba4c-1b4d615e8e4a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5ac