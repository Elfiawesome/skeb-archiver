7c0-e351128866a1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=19efe5977481c911297cc69e32ef8a54, https://si.imgix.net/ba09f89e/uploads/origins/fd87f90f-5236-40fe-b7c0-e351128866a1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=7bba492986fd6ba5339ec52bba2ae520 2x, https://si.imgix.net/ba09f89e/uploads/origins/fd87f90f-5236-40fe-b7c0-e351128866a1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=32812824b7dc8a9c0ff878c49d0c08a1 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/ba09f89e/uploads/origins/fd87f90f-5236-40fe-b7c0-e351128866a1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0af6847d6f51a297df2a2fff8c18f5f7", "srcset": "https://si.imgix.net/ba09f89e/uploads/origins/fd87f90f-5236-40fe-b7c0-e351128866a1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0af6847d6f51a297df2a2fff8c18f5f7, https://si.imgix.net/ba09f89e/uploads/origins/fd87f90f-5236-40fe-b7c0-e351128866a1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=8a070a6eb9c628008b55dcfce7d3f03a 2x, https://si.imgix.net/ba09f89e/uploads/origins/fd87f90f-5236-40fe-b7c0-e351128866a1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=85831c0e59bf0ee4319f4e536f25b377 3x"}, "body": "はじめまして。\nYouTubeにて歌ってみた動画やシチュエーションボイスを中心に活動しております、Ragdoll（ラグドール）と申します。\n\nこのたびは、Ame様の美しく繊細なイラストに一目惚れし、ぜひ私の姿を描いていただきたく、リクエストを送らせていただきました。\nAme様が描かれる表情や空気感、世界観のある雰囲気がとても好きです。\n\nご依頼させていただきたいのは、「ニャン」（MARETU様）という楽曲の歌ってみた動画に使用するイラストです。\n主に【動画内】【サムネイル】としての使用を想定しております。\n\n楽曲リンク：https://www.youtube.com/watch?v=SOhCtSuVSWo\n\n【ご依頼内容】\n構図・ポーズなどはすべてお任せさせていただきます。\n衣装・髪型アレンジも自由に調整いただいて構いません。\n可能であれば、頭部（頭回り）が見切れない構図ですと幸いです。\n\n【使用予定範囲】\n歌ってみた動画（YouTube）本編・サムネイル\nSNS告知・ショート動画・配信サムネイル\nSNSアイコン・ヘッダー\n\n【データ形式について】\n背景・人物をレイヤー分けしていただけると助かります（PSD形式対応可能です）\n\