ためだけですので、脚に巻き付く程度でいいです。\nモザイク処理（修正処理）で見えないには見えないのですが、触手などで穴部分が隠れないような感じでお願いします。\nその辺りも以前描いて頂いた黒子ちゃん準拠でお願いします。\n要は何度か描いてもらっている触手くぱぁの狼メイドさんバージョンです。\nにれさんに描いてもらうあのポーズ好きなのです。\n\nどうぞよろしくお願い致します。", "nc": 168, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@niretama7/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3988932, "client_id": 89241, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/1dfcfdec/uploads/origins/5bbcf8cb-6c87-40be-baed-dd09968c31d4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=94ea8fdecc1d0ba6706efb727ab3af53", "srcset": "https://si.imgix.net/1dfcfdec/uploads/origins/5bbcf8cb-6c87-40be-baed-dd09968c31d4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=94ea8fdecc1d0ba6706efb727ab3af53, https://si.imgix.net/1dfcfdec/uploads/origins/5bbcf8cb-6c87-40be-baed-dd09968c31d4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=9c6ee613fa506e035eb0f0b3625fed41 2x, https://si.imgix.net/1dfcfdec/uploads/origins/5bbcf8cb-6c87-40be-baed-dd09968c31d4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c44fd8ed15c7f54a86963ce9228957cc 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/1dfcfdec/uploads/origins/5bbcf8cb-6c87-40be-baed-dd09968c31d4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=cf8352ed5b587c94fba77713a8b30e21", "srcset": "https://si.imgix.net/1dfcfdec/uploads/origins/5bbcf8cb-6c87-40be-baed-dd09968c31d4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=cf8352ed5b587c94fba77713a8b30e21, https://si.imgix.net/1dfcfdec/uploads/origins/5bbcf8cb-6c87-40be-baed-dd09968c31d4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=f18c1b2eebee40eff742efc370101180 2x, 