it=crop&crop=top&w=200&h=200&s=80ed8abe9b7ea6bda900b7ff7f4bf98e", "srcset": "https://si.imgix.net/cce049b3/uploads/origins/675d1176-8070-4d9d-802e-48d2210cf77c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=80ed8abe9b7ea6bda900b7ff7f4bf98e, https://si.imgix.net/cce049b3/uploads/origins/675d1176-8070-4d9d-802e-48d2210cf77c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=3d1a93124c6d0604c9e81dd6b3fe721e 2x, https://si.imgix.net/cce049b3/uploads/origins/675d1176-8070-4d9d-802e-48d2210cf77c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=0bd836c199251b4895ec0285edde596f 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/cce049b3/uploads/origins/675d1176-8070-4d9d-802e-48d2210cf77c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=7009bed8df623dbf4365a86920c02810", "srcset": "https://si.imgix.net/cce049b3/uploads/origins/675d1176-8070-4d9d-802e-48d2210cf77c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=7009bed8df623dbf4365a86920c02810, https://si.imgix.net/cce049b3/uploads/origins/675d1176-8070-4d9d-802e-48d2210cf77c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=66c614f874f79e32ab2855738011ca36 2x, https://si.imgix.net/cce049b3/uploads/origins/675d1176-8070-4d9d-802e-48d2210cf77c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=01d7ae05f638b133a873304bc308e93b 3x"}, "body": "栗間潤様こんにちは。\nあなたの素晴らしいアートスタイルに心を惹かれました。\n\n【詳細】\n今回お願いしたいのは、創作キャラクターとアイドルマスターSideMの山下次郎の夫婦です。版権キャラクターが難しい場合は気兼ねなくお断りください。\n\n【用途】\nこのカップルの創作活動を主にしている鍵アカウント(skebに登録しているアカウントとは別のアカウント)で作者様へのメンションをつけてツイートさせて頂きたいと考えています。その際、作者さまが描いてくださったという旨は記載いたします。\n\n【キャラクター】\n女性はキザで清楚な性格で、夫の所属するアイドル事務所の事務員です。\n［身体的特徴］\n163cm\n口の左下にほくろ\n若緑色の髪\n金のシンプルな結婚指輪\n資料にミディアムヘアのものとショートヘアのものがありますが、どちらでも問題ありません。\nオフィスカジュアルや、ナチュラルな服装を好みます。\n\n山下次郎は優しく少し情けない男性です。\n［身体的特徴］\n185cm\n30歳\n口髭、顎髭あり\n猫背ぎみ\n金のシンプルな結婚指輪\nすね毛が生えている\n資料に髪を上げたものと片目が隠れたものがありますが、できれば片目が隠れたものでお願いしたいです。\n\n女攻めのカップルで、山下はいつも彼女には敵わないと感じています。仲睦まじく、落ち着いたカップルで、三毛猫を飼っています。\n\n【アイデア】\nお好きに描いていただいて構いませんが、何かヒントになるかもしれないのでアイデアを書き連ねておきます。\n\n夜の海や花畑などのロケーション\nあるいはメイド服やバニースーツなどの衣装を着せたもの\nラーメンを食べる二人、服を選ぶ二人、一緒にスマホを見ている二人などのシチュエーション\n又はユニットの二人と一緒に写っている絵なども楽しいかもしれません。ご一考いただければ幸いです\n\n\nわたしのリクエストをご検討くださりありがとうございます。\n\nhttps://drive.google.com/drive/folders/1-9oUiwSOJ1ghjs9Tdqb81w9iQC34oH0G", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 786180, "creator": true, "nsfw_acceptable": false, "acceptable": false, "name": "wawa", "screen_name": "wawatiku", "avatar_url": "https://pbs.twimg.com/profile_images/1930047406810509316/scWjWE-1.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1316976623724318720/1729758706/1500x500", "appeal_receivable": false, "popular_creator_rank": 20, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 10, "complete_expiration_days": 50, "skills": [{"genre": "art"}], "nc": 49}, {"id": 1337647, "creator": true, "nsfw_acceptable": false, "acceptable": false, "name": "スイ🐰", "screen_name": "suimizG", "avatar_url": "https://pbs.twimg.com/profile_images/1609070287097847808/s-Xb3axG.jpg", "header_url": "https://pbs.twimg.com/profile_banners/235435478/1669351776/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "art"}], "nc": 144}, {"id": 1729963, "creator": true, "nsfw_acceptable": true, "acceptable": false, "name": "Akuru", "screen_name": "akr369akr", "avatar_url": "https://pbs.twimg.com/profile_images/1947104858957299712/x5LxJEAa.jpg", "header_