1f0-b8ea-fdd19d6a38ff?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0175b6e5066ad60a71823de457b86c8b", "srcset": "https://si.imgix.net/319daf59/uploads/origins/0be22a69-8ab1-41f0-b8ea-fdd19d6a38ff?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0175b6e5066ad60a71823de457b86c8b, https://si.imgix.net/319daf59/uploads/origins/0be22a69-8ab1-41f0-b8ea-fdd19d6a38ff?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=523ab4b3b1e9f48ff5af260d498d6e61 2x, https://si.imgix.net/319daf59/uploads/origins/0be22a69-8ab1-41f0-b8ea-fdd19d6a38ff?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=a6d3efbc7d8dc75fe1dc55c968b418e1 3x"}, "body": "亜夜螢様、こんにちは。\n禾ズ真です。\nハオフィを気に入っていただきありがとうございます！白髪好きの方にお褒めいただけるのはとても嬉しいです…！\n\n亜夜螢様の絵を拝見し、とても可愛かったので是非イラストをお願いしたいと思います…！\n\n資料はこちらになります。\n\n・最新イラスト\nhttps://note.com/psyan75_17_ra/n/ne1c2caf05cc5\n・基本資料\nhttps://note.com/psyan75_17_ra/n/n2199d76dc144\n\n■キャラ説明\nハオフィはいわゆる元人間のアンデッドで、武闘派の熱血ネクロマンサーです。\n太ももの札でキョンシーを使役したり、周りに浮かぶヒトダマの炎で熱したフライパンで好物の炒飯を作ったりします。\n\n青肌なのは体内に血の代わりとなる霊力の源を巡らせているからで、そのためゾンビでありながらも心臓は動いており代謝も行われているので、ヒトで無くなった身ながらも生き生きとしています。\n\n故郷の世界を救う戦いの結果としてあの世に行けなくなった戦友の霊のため、我流の禁術でヒトを辞めることで寄り添う決断をしたという過去を持ちます。\n\n現在は居場所を失った英雄だけを招くという隠された異世界に招待され、ウラ料理屋の店主として第二の人生を送っています。バイトの主人公に自慢の料理を教えたり迷惑客を共に撃退するのが日課です。\n\n■外見の特徴\n・青肌で頬、左腕、右足に縫い痕があります。\n右足だけ変色具合が異なります。\n・白髪に七色のハイライトが入っています。\n・基本ジト目ながらも瞳に生気を宿しています。\n・テンションが高い時は緑と金のオッドアイで、自然体の時は両目とも金色です。どちらで描くかはお任せいたします。\n・目尻にピンクのアイシャドウをしています。いわゆる目張りです。\n・服や袖の炎柄は決まったパターンがないので、描きやすいように描いてOKです。\n\n髪型や衣装はお好みのものをお選びください。\n描いていて違和感がある部分は改変しても大丈夫です。\n\n元気いっぱいに描いていただけたら嬉しいです！\nリクエスト内容に問題なければ、ぜひよろしくお願いします！", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@AyaHotaru_V/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3903103, "vtt_url": null, "thumbnail_image_url