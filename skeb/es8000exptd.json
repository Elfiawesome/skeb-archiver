_id": 1413371, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/1e98625e/uploads/origins/7b92ebe4-bc5f-4091-864b-18feef04b84f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=df617bc40182f0195460cb6855032091", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/1e98625e/uploads/origins/7b92ebe4-bc5f-4091-864b-18feef04b84f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=267a634a2980d08aa61c88ccef199865", "src_set": ""}, "body": "初めてまして、skebの作品を見させていただき、好みだったのでリクエストします。\n自分は宇都宮のライトラインの車両デザインが好きなので、ライトラインの擬人化した女の子を描いて欲しいです。詳細は以下の通りです。 \n・衣装はバニーガールのようなハイレグレオタードを基本にライトラインの意匠や色彩を落とし込む感じでお願いします。ただ、蝶ネクタイ、カフス、編みタイツは必須でお願いします。\n・ハイレグの角度は鼠蹊部が見えるくらい鋭くしてください。\n・編みタイツの網目はなるべく細かくしてください。\n・体型ショートカット、体型はスレンダーで胸は谷間があるくらいの大きさでお願いします。\n・ポージングは正面からの立ち姿でお願いします。", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@es8000exptd/works/14", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 358296, "client_id": 1265349, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/41107bae/uploads/origins/bee9623c-38b0-4841-be78-17801299f499?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ea5ac3d694b8c39be53315812fea5194", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/41107bae/uploads/origins/bee9623c-38b0-4841-be78-17801299f499?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5c23c91ee030fc1634bdc8da97a2169d", "src_set": ""}, "body": "鉄道むすめの八戸ときえ(夏服)、彩都さんの絵で見てみたいです。", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@es8000exptd/works/13", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creato