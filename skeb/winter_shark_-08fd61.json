m=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e81c63138f98cc85928e8221a3da4ba7, https://si.imgix.net/e8aef172/uploads/origins/985fb935-ff47-41d9-b8f5-8c99d6739712?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=b89c7546326bd3aec1e52c195c6b6402 2x, https://si.imgix.net/e8aef172/uploads/origins/985fb935-ff47-41d9-b8f5-8c99d6739712?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=7da99344a448bc4a489f4fe841cfcc99 3x"}, "body": "はじめまして、キーリ・コノミスという名でVtuberとして活動しているものです。 日頃マーダーミステリーなど推理もののゲームを主に配信しております。\n\nマーダーミステリーのイメージビジュアルの\n美しい翼を拝見し思わずリクエストさせて頂きました!\n\n\n依頼したいもの\n\nキーリ(https://twitter.com/Kili_Vno023/status/1512752274938150914?t=H4L5GsgoGbmc6fonskElwQ&s=19)\nがカササギの羽ペンを持って文章(台本)を書いている姿のイラスト\n\nYouTubeでやTwitterでの配信活動で、動画内やサムネイル、宣伝などに使用します\n\n\n姿勢、構図はお任せします。\n可能であれば背景透過の差分か、\nPSDファイルで背景とキャラクターの分割ができる状態での納品をお願いします。\n\nご検討よろしくお願いします!", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@winter_shark_/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1706296, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/dcf1967b/uploads/origins/65392424-ef1c-4899-822e-f5f2c47f42ce?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e684d079be09160bb030890219c3ba3c", "srcset": "https://si.imgix.net/dcf1967b/uploads/origins/65392424-ef1c-4899-822e-f5f2c47f42ce?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e684d079be09160bb030890219c3ba3c, https://si.imgix.net/dcf1967b/uploads/origins/65392424-ef1c-4899-822e-f5f2c47f42ce?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e531d5daa4db7cb8b387b1a35dab5739 2x, https://si.imgix.net/dcf1967b/uploads/origins/65392424-ef1c-4899-822e-f5f2c47f42ce?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c2fe4395ca13a15984b1993518c9c68b 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/dcf1967b/uploads/origins/65392424-ef1c-4899-822e-f5f2c47f42ce?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=bcfa7d1592bab134e5ad16c731580664", "srcset": "https://si.imgix.net/dcf1967b/uploads/origins/65392424-ef1c-4899-822e-f5f2c47f42ce?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=bcfa7d1592bab134e5ad16c731580664, https://si.imgix.net/dcf1967b/uploads/origins/65392424-ef1c-4899-822e-f5f2c47f42ce?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=b1d09d8e677d4f119ddfb2693fb24e84 2x, https://si.imgix.net/dcf1967b/uploads/origins/65392424-ef1c-4899-822e-f5f2c47f42ce?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=391e73b4f9d7514cb2b4633f770f64c0 3x"}, "body": "はじめまして。\n前垢フォローさせてもらっていたのですが変わった拍子に分からなくなってしまって今回分かったので是非🦈さんに依頼させてもらいたく思いました！\n\nPC・iPadの背景に使用させてもらいたいです。\nその為横向きでお願いします💦\n(Twitterなどのアイコンでも使用する可能性あります)\n\n描いてもらいたい子は\n・高校、大学ぐらいの男性\n・黒髪だが中野あるまさんやアベレージさんに近い髪型\n・服装はクラシカルなメイド服、ホワイトブリムorヘッドドレスのどちらか着用\n基本服はモノクロ色\n服の参考用→ https://oekaki-zukan.com/articles/32438\n・以下に添付した狙撃銃を持っている(見切れてもok)\nhttps://twitter.com/fusen_ramunen/status/1522338981010341890?s=21&t=Vmv6STx1Ol8acMSoKrIGQg\n・狂気に満ちた表情\n・イメージカラー紫、ピンク\n\n服のデザインや構図は🦈さんにお任せします！\n\n何かのキャラとかでは無いので参考少なくて申し訳ないのですが🦈さんの描いたシビュラの🏹🥽、stigmaの🥽、狂気山脈の🏹などの表情や雰囲気が引き込まれるように好きなのでそちらに近づけてもらえればと思います。\n\n無くてもあっても良いのですがもし血跡などつける場合はショッキングピンクだとありがたいです。\n\n他指定してないものは🦈さんの好きに描いてもらって大丈夫です！！\n\n金額を上げてはいますが銃などリクエストが重たい場合はリクエストをキャンセルしてもらっても構いません。\n何卒宜しくお願いします🙇‍♀️", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@winter_shark_/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1706296, "client_id": 1809239, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/cb5fe63a/uploads/origins/10714159-5875-4a9a-83a6-2c6d06f5089d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a57f6c8dff28d49dcb0c331f589283e4", "srcset": "https://si.imgix.net/cb5fe63a/uploads/origins/10714159-5875-4a9a-83a6-2c6d06f5089d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a57f6c8dff28d49dcb0c331f589283e4, https://si.imgix.net/cb5fe63a/uploads/origins/10714159-5875-4a9a-83a6-2c6d06f5089d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=365aca861dc5923f294a9b68dd82b7c1 2x, https://si.imgix.net/cb5fe63a/uploads/origins/10714159-5875-4a9a-83a6-2c6d06f5089d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ea32f6f4ff9c019709b17d3b36f4f51b 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/cb5fe63a/uploads/origins/10714159-5875-4a9a-83a6-2c6d06f5089d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=08805c4200eff71fef2c853df470faa5", "srcset": "https://si.imgix.net/cb5fe63a/uploads/origins/10714159-5875-4a9a-83a6-2c6d06f5089d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=08805c4200eff71fef2c853df470faa5, https://si.imgix.net/cb5fe63a/uploads/origins/10714159-5875-4a9a-83a6-2c6d06f5089d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=43c233a1fd558361726063b255c29e31 2x, https://si.imgix.net/cb5fe63a/uploads/origins/10714159-5875-4a9a-83a6-2c6d06f5089d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=abc9998508c99512f73537f2f4323317 3x"}, "body": "はじめまして、女児子と申します。\n🦈様の絵柄がとても好きで（特に🚬🐬さん、Sibylの🥽🏹さん、opinionsとTRYPOPHOBIAのmemeが大好きです..!!）、是非自キャラのイラストを依頼したいと思い、今回リクエストさせていただきました。\n\n・依頼したい内容\n一枚絵とデフォルメ全身イラストをお願いしたいです。\n一枚絵の描写範囲や構図等はお任せ致します。\nデフォルメイラストは🦈様が昨年の10/14に上げていらしたチェシャ⏰さんの等身のイメージです。こちらもポーズはお任せ致します。\nもしお手数でなければ両方とも背景ありのものと背景透過バージョンを2枚ずつをいた