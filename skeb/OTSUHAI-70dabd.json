h=200&blur=200&s=48c4380b5ac2f750830e011165bf51bf 3x"}, "body": "おつはい(skeb)様こんにちは。\nこーほく(古山)と申します\n\n専門ジャンルを存じあげていないのですが、\n作品が非常に綺麗でしたのでお声がけしました。\n\nキャラデザ的なリクエストなのですが\nもしよろしければご検討下さい。\n\nURLの様なキャラのフィギュアを販売中で、新作モチーフを必要としています\n南国の無邪気な薄着少女のキャラを、等身は12歳くらい、裸足の全身画をお願いします\nhttps://drive.google.com/file/d/1nwJ55U55jM8KS5ACtXndjRf7x9bagzGA/view?usp=sharing\n\n衣装：添付画像のフィギュアのように布をまとって腰紐で縛っただけのようなシンプルな感じで\n形状は奴隷ちゃんのような、よくある奴隷服をベースに「天使」「貫頭衣」「踊り子」「くノ一」「エジプト風」等の検索で出るヒラヒラした感じの服と合わせて自由にアレンジして下さい。\n完全な水着やズボン形状は避けて下さい\n\nポーズ：お得意なポーズ等、映えると思われるポーズをお好みで。うつぶせ以外で、静かな感じでも動きのある感じでもOKです\nキャラ：笑顔とロング系(結び・三つ編み等もOK)の髪で。詳細はお任せします。\n\n衣装や髪の見えない方向(背中等)からのごく簡単なラフ画もあると嬉しいです\n迷ったらお好み・お得意なもの・マイキャラ等を当てはめて下さい\n背景はありでもなしでもOK\n\n宜しくご検討願います\n\nhttps://drive.google.com/file/d/1nwJ55U55jM8KS5ACtXndjRf7x9bagzGA/view?usp=sharing", "nc": 25, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@OTSUHAI/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 850165, "client_id": 1962427, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/5d732f3d/uploads/origins/b1a89858-3e19-48f7-abb9-549a3cbbdcc4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=698c9c848e222fc2cbf97eb95c47bb24", "srcset": "https://si.imgix.net/5d732f3d/uploads/origins/b1a89858-3e19-48f7-abb9-549a3cbbdcc4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=698c9c848e222fc2cbf97eb95c47bb24, https://si.imgix.net/5d732f3d/uploads/origins/b1a89858-3e19-48f7-abb9-549a3cbbdcc4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=9370a2b6e8405b94bbb3d93441e6b100 2x, https://si.imgix.net/5d732f3d/uploads/origins/b1a89858-3e19-48f7-abb9-549a3cbbdcc4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=db29801f7a5fc17fca266797ffad8d1e 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgi