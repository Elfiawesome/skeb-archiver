まま、全身絵の正面向きでお願いします。表情はSっ気のある感じで\n\n検討のほう何卒よろしくお願いします。", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 4475, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "飛来ボデー・C107 1日目東ア-16a", "screen_name": "goumonsha", "avatar_url": "https://pbs.twimg.com/profile_images/1434581948/____________.jpg", "header_url": "https://pbs.twimg.com/profile_banners/232656815/1611487636/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "art"}, {"genre": "novel"}, {"genre": "correction"}], "banned": false, "nc": 160}, {"id": 120641, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "にぼっく", "screen_name": "emoroomoro", "avatar_url": "https://pbs.twimg.com/profile_images/1173522656550719488/oVhhR43Q.jpg", "header_url": "https://pbs.twimg.com/profile_banners/3140562147/1568624708/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "art"}], "banned": false, "nc": 48}, {"id": 602745, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "まこちあ", "screen_name": "CowMopCat", "avatar_url": "https://pbs.twimg.com/profile_images/2057305687492034561/fwN7AYe2.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1457733253/1779757600/1500x500", "appeal_receivable": true, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 7, "complete_expiration_days": 30, "skills": [{"genre": "art"}], "banned": false, "nc": 160}, {"id": 656391, "creato