[{"genre": "art", "default_amount": 30000}], "acceptable_only_public": false, "tip_acceptable": true, "yearly_report_client_visible": false, "total_appeals_count": 0, "received_works": [{"path": "/@dedechi_skeb/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3363091, "client_id": 2784169, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/a75e1085/uploads/origins/e461484a-b885-43ff-8326-0bb71373a6f5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=af7697e506e63260b7cb0d08d771eb21", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/a75e1085/uploads/origins/e461484a-b885-43ff-8326-0bb71373a6f5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ad9cf2f7efe2edd69ba37775f5f3b368", "src_set": ""}, "body": "デデチ様、初めまして⭐️\nVtuberの神那レイアと申します。\n\nskebさんの再開を楽しみにしておりました！以前よりデデチ様のイラストを拝見しておりかわいさの中にあるかっこいいイラストが大好きなので是非デデチ様に私のイラストをご制作いただきたく今回リクエスト送らせていただきました！\n\n【希望依頼内容】\n普段は夜に悪魔退治をし、みなさんが素敵な夢を見れるようにと活動しているのですが住んでいる教会で日中はシスターとして教会でぼ業務(礼拝、お花に水やり、子供達のお世話など)をしているためデデチ様に\n【シスターとして働いている様子】を構図、衣装、髪型など全てお任せでお願いできればいいなと思っております。\n\n【キャラクターポイント】\n永遠の88歳の女の子。150cm\n本職: エクソシスト☪️兼シスター\n相棒のむうちゃんはバクの精霊で魔法を使う🪄僕自身は足技で悪魔退治をしている。\nチャームポイント：まろ眉とオッドアイ\n(キャラの右目紫、左ピンク。わかりやすくしてくださると嬉しいです）\n\n【使用用途】\nXを含むSNSでの利用/動画・配信内、サムネイルで使用/FANBOX等\n\n【お願い】\n人物と小物を分けたPSDデータや透過されたデータでお願いしたいです。また、ポーズや髪型が上右左見切れていないように描いていただけますと幸いです。デデチ様のサインやメッセージもいただけますと飛んで喜んじゃいます💕\n\nご縁がありますように…\n神那レイア\n\nhttps://drive.google.com/drive/folders/1-EJnRN66efXkNFudK7-olbOVFQW6Mdg9", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@dedechi_skeb/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3363091, "client_id": 2609658, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/6e352b12/uploads/origins/188c1d5d-0966-4eac-8f22-e47335c3774f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0a465c5609cdb96e0444901ea5374591", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/6e352b12/uploads/origins/188c1d5d-0966-4eac-8f22-e47335c3774f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=bdd31000ecd42277b01878267e3ac358", "src_set": ""}, "body": "デデチ様  \n初めまして。\nりちゃむと申します。\n Vtuberとして活動しています。\n\n  デデチ様のイラストを拝見し、表情や色使いがとても素敵だと思いました。\nそこでぜひ自分（りちゃむ）を描いていただきたくスケブを依頼させていただきました。   \n\n使用用途はキービジュアルとして \n・動画や配信での使用（サムネイル、配信画面、歌ってみた動画など）\n ・snsでのツイート、アイコンやヘッダー \n・fanboxのプランの先行公開 \n・活動支援へのお礼画像  \n・ネットプリント\n・グッズ\n\n 以上のようなvtuber活動で使用させていただきたいです。  \nキャラクターデザインを参考資料に入れています。\n\n雰囲気はASMR用の暗めで綺麗な感じ、比率は16:9（YouTubeサムネイルの比率）を希望します。\n衣装、ポーズ、表情、背景等はデデチ様におまかせいたします。 \n\n  可能であれば\n　・表情差分\n　・背景透過のキャラクターのみのpsd\n　・画面外で切れてしまった髪や体の可能な範囲の描画\nをお願いしたいです。\n\n ご検討いただけましたら幸いです。\n よろしくお願いいたします。\n\nりちゃむ各リンク: https://lit.link/richamu0924\n\nhttps://drive.google.com/drive/folders/1-OM_GZppN4nP80AuwJGBVLXXn6RqXOK2", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@dedechi_skeb/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3363091, "client_id": 2803044, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/fed68cc5/uploads/origins/87b73592-bc59-48ef-8586-0cdbae92fa53?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a3a4a26a6e1ea2b53d5dadb5595329d4", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/fed68cc5/uploads/origins/87b73592-bc59-48ef-8586-0cdbae92fa53?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=55f619bb56a09265bbc3c4f3de499ee7", "src_set": ""}, "body": "初めまして！イラストレーターとVtuber活動をしている麻呂太と申します！\nデデチさんのブルアカイラストがとても可愛くて、以前からとても好きだったので、依頼させていただきました！\n\n●キャラクター\n麻呂太ちゃん\nゆるふわ牛娘Vtuber\n\n麻呂太ちゃん参考画像▶\nhttps://drive.google.com/drive/folders/1nl-x0VaLHPqrnEXpS7iKEpdrSza22okk?usp=sharing\n\n\n牛柄ビキニとカウベルを着用して、牧場で牛乳の売り子をしている麻呂太ちゃんをお願いします！\n雰囲気はこちらの樫野のイラストのイメージです。\nhttps://x.com/azurlane_staff/status/1834445651494797330\n\nポーズや表情はお任せします！\n\n\n●その他\nPSDデータで背景とキャラクターをレイヤー分けしていただけると助かります！\n右目の下と左胸にほくろがあります！\n\n\n●使用用途\nSNSでの掲載\n配信サムネイルでの使用\n\n以上です！ご検討よろしくお願い致します！", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@dedechi_skeb/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3363091, "client_id": 3327944, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/3f74b5eb/uploads/origins/1ffca8e9-4503-4fa4-acf1-e26013c48a8d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=40f7cf9d0f2ffc52cbf6d291bb71abe9", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/3f74b5eb/uploads/origins/1ffca8e9-4503-4fa4-acf1-e26013c48a8d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=de9ffe319b7938c5524de7bda82cda22", "src_set": ""}, "body": "初めましてVTuber準備中の那来萌と申します。\n\nデデチ様のイラストすごく素敵だなと思い是非私のイラストを書いて頂きたくリクエストしました。\n\n・内容\n耳かきをしているシチュエーションで構図、服装、背景等はお任せします。\nデデチ様の好きな感じで描いて頂きたいです！\n\n・使用用途\nVTuber活動に伴うSNSでの使用、サムネイル等\n\n・キャラクター\n資料URLに立ち絵、3面図がありますので参考にしてください。\n\n・納品形式\n人物、背景、宛名等がレイヤー分けされたPSDデータ、もしくはPNGだととても助かります。\n\nご検討よろしくお願いします！\n\nhttps://drive.google.com/drive/folders/1-0Lh2PrMpsR9Vb7WZ-KvesAxJr3jJKMl", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@dedechi_skeb/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3363091, "client_id": 104966, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/538bac47/uploads/origins/bf03df96-a3d5-4a99-b1be-d6337f662a21?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=409f1264cabb5c319755b026cd78d27a", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/538bac47/uploads/origins/bf03df96-a3d5-4a99-b1be-d6337f662a21?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e4f8b02f61ce78e64d2a6d6d97ebd436", "src_set": ""}, "body": "いつもお世話になっております。\n\nVtuber「七狼さくや」として活動中の七瀬さくら（中身）です。\n\n【依頼内容】\n・七狼さくやのイラスト\n\n▶︎参考資料「七狼さくや」\nhttps://drive.google.com/drive/folders/1zyebQ1AQIzDxfmpCnrqJR_kQkRAA90gm\n\nキャラフォリオ\nhttps://charaforio.com/ja/ip/70398\n\n▶︎設定\n一匹狼 2.5次元コスプレ Vtuber\n\n▶︎構図\n耳と髪が見切れない構図の一枚絵でお願いいたします。（見切れていても別レイヤーに見切れていないものが別途あると嬉しいです）\n可能であれば、\n口の表情差分があれば嬉しいです。\n\nポージングや表情の詳細はお任せいたします。\n\nデデチさんの描くキャラクターたちの表情、動きのあるポージング、そこに生きてるような雰囲気の空気感が、とっっても大好きなのでずっと依頼したいと思っていました。\n\n▶︎衣装\n資料内の衣装ならばどちらでもOK\n\n▶︎デザイン\n髪の毛の裾（毛先）のカラー、狼耳の先、さらに\nしっぽの先がブラックグレー系のグラデーションカラーになります。\n髪飾りは左右違うものがついております。牙あり。\nインナーにも胸ベルトあり。\n詳細は三面図またはキャラフォリオをご覧下さいませ。\n\n▶︎使用用途\n主に動画配信サイト（YouTube等）の動画や配信、サムネイルでの利用。\n各種SNSへの使用、ファンクラブ、HP、ファクラブなどへの掲載。\nグッズなどの頒布物（アクキーやアクスタなど）、ネットプリント、リアルでの印刷物にも利用させて頂けますと幸いです。\n\n・納品\n被写体と背景や小物が分かれた状態（PSD）\nまたは、背景透過データでの納品を希望致します。\n\n今後の活動に活用させていただますと幸いです。\nここまでお読み頂きありがとうございます。\n\nよろしくお願い申し上げます。", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@dedechi_skeb/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3363091, "client_id": 113383, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/dfd879f3/uploads/origins/ae8c61eb-1d23-4d95-b4df-4b835a956e4b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=20d30a735525e10d5273eb7c633fb89f", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/dfd879f3/uploads/origins/ae8c61eb-1d23-4d95-b4df-4b835a956e4b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=97d7e61ce0c4c935c024aec9d386b679", "src_set": ""}, "body": "デデチさんこんにちは！\nリクエストをお願いします！\n\n【キャラクター】\nブプレウルム（花騎士）\nカジノディーラーの駆け引き上手な明るい女の子です。\n耳は魔力が強すぎて実体化したものです。\n\n【衣装】\n進化前（衣装が分かりにくい所はアレンジしていただいて大丈夫です）\nキャラwiki\nhttps://xn--eckq7fg8cygsa1a1je.xn--wiki-4i9hs14f.com/index.php?%E3%83%96%E3%83%97%E3%83%AC%E3%82%A6%E3%83%AB%E3%83%A0\n\n以前依頼したものが何件かあるのでこれらを参考に...！\nhttps://skeb.jp/@zank37336643\n\n【構図等】\nお任せします！\n\nよろしくお願いいたします！", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "similar_creators": [{"id": 1830, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "みねたナオキ", "screen_name": "naokimineta026", "avatar_url": "https://pbs.twimg.com/profile_images/1591957689894043648/WjeqQHxi.jpg", "header_url": "https://pbs.twimg.com/profile_banners/160757075/1741415716/1500x500", "appeal_receivable": false, "popular_creator_rank": 15, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "skills": [{"genre": "art"}], "nc": 176}, {"id": 651535, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "佳乃。", "screen_name": "sora87186800", "avatar_url": "https://pbs.twimg.com/profile_images/1593043962650329089/GVTLAXtQ.jpg", "header_url": "https://pbs.twimg.com/profile_banners/2277293864/1504420114/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 4, "skills": [{"genre": "art"}, {"genre": "correction"}], "nc": 33}, {"id": 1381841, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "✏️@Skeb", "screen_name": "skeb1000", "avatar_url": "https://pbs.twimg.com/profile_images/1828085100653039616/UZAW7xEX.jpg", "header_url"