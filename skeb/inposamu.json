_same_genre": false}, {"path": "/@inposamu/works/20", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2827498, "client_id": 408354, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/66659ef1/uploads/origins/ed043d93-a5d7-4e45-9e17-94df46d55eee?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=176ff6175606cb19e0f17ebfd5708293", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/66659ef1/uploads/origins/ed043d93-a5d7-4e45-9e17-94df46d55eee?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=671e611611efdc9ad1d4585633893eb1", "src_set": ""}, "body": "こんにちは！\n\nペーパーマリオのビビアンとレディ・ボウのセックスが見たい。\n\nレディ・ボウに人型の体を与えてください。デザイン例をいくつか載せましたが、自分で作ってもかまいません。彼女は背が低く、お尻と胸が大きく、カーヴィーなボディであるべきです。彼女の牙と長い舌を入れてください。\n\nビビアンはフタナリです。ビビアンはフタナリです。ゲームと同じようなデザインで構いませんが、胸とお尻が大きく、カーヴィーな体型にしてください。彼女は弓ほどカーヴィーではないが、背が高い。彼女に巨大なチンコを与えよう。彼女には大きすぎるように見えるし、ボウの小さな体と比べると特に大きい。\n\nビビアンはボウを激しく犯す。ポーズはあなた次第です。弓はゴーストなので、ビビアンのチンコを全部受け止めることができます。弓のお腹を極限まで大きく膨らませてください。ビビアンはムラムラしているので慌てた表情をしていますが、ボウは巨大なチンコに痛みを感じていないので、ドヤ顔をしています。ビビアンが大量にクンニして、ボウの腹を大きく膨らませる別バージョンも入れてください。2人とも淫らな表情をしている。\n\nありがとう！\n\nhttps://www.dropbox.com/scl/fo/olqoc3yhq2ijn4xpr4q7h/AHKp0VD0Cp2onXbYQqLN6dE?rlkey=dklb16o3g5hcmikesohk9p7ju&st=fwr68fut&dl=0", "nc": 169, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@inposamu/works/19", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/9d38ab6c/uploads/origins/949a992c-e383-4f87-a3eb-1e53a32e9acb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=25d86f647df7bbd4441c3b44ede491d3", "src_set": ""}, "private": true, "genre": "art", "tipped": false, "creator_id": 2827498, "client_id": 0, "vtt_url": "", "thumbnail_image_urls": null, "dura