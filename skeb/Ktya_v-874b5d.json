l consider our proposal! Best regards\n\nhttps://twitter.com/hisora_tiri\nhttps://www.youtube.com/channel/UCUkK9vz62dyomBMiIJEiZDg\n\nhttps://twitter.com/hisora_tiri/status/1672602025232838656?t=btzvvnsNw89ZuIGkrr2eCw&s=19\n\nhttps://twitter.com/hisora_tiri/status/1681213643646722049", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@Ktya_v/works/5", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/88da4aaf/uploads/origins/074b9252-598d-4bc7-a549-a375d14ee57c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=1e3b78bfdd920bee88e215caa29830d6", "srcset": "https://si.imgix.net/88da4aaf/uploads/origins/074b9252-598d-4bc7-a549-a375d14ee57c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=1e3b78bfdd920bee88e215caa29830d6, https://si.imgix.net/88da4aaf/uploads/origins/074b9252-598d-4bc7-a549-a375d14ee57c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=b9db21cab311b2a43a89da9700a6bfbe 2x, https://si.imgix.net/88da4aaf/uploads/origins/074b9252-598d-4bc7-a549-a375d14ee57c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=b9ca7fea32cd4b4f7d21f40d1d0e29f1 3x"}, "private": true, "genre": "art", "tipped": false, "creator_id": 2705054, "client_id": 2349988, "nc": 17}, {"path": "/@Ktya_v/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2705054, "client_id": 2768540, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/2a2942e5/uploads/origins/b1bc9744-8522-4e5e-86f