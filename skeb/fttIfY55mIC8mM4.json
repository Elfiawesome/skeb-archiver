": "correction", "default_amount": 1000}], "acceptable_only_public": false, "tip_acceptable": true, "yearly_report_client_visible": true, "total_appeals_count": 0, "received_works": [{"path": "/@fttIfY55mIC8mM4/works/18", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 692267, "client_id": 1201878, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/05460af3/uploads/origins/d41640ac-3fb7-417f-9bff-500b3dbc9d2a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f514ecc84fffb1175c75f73bdbce5a96", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/05460af3/uploads/origins/d41640ac-3fb7-417f-9bff-500b3dbc9d2a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9b44e916cdf56d78f7aeb831caecb893", "src_set": ""}, "body": "あなごさん、こんばんは。\nいつも素敵なイラストありがとうございます。\n\nサキュバスちゃんの友達(青髪サキュバスちゃん)が変な性癖の男に変なプレイをさせられるイラストを描いて頂きたいです。\n以下のようなイメージです。\n\n・青髪サキュバスちゃんの衣装は普段の服装(フリル付きの白レオタード)\n・普段の服装がニーソックス+靴なのかニーハイブーツなのかわかりませんでしたが、今回ニーハイブーツ風に描いて頂きたいです\n・上記の服装のまま、ヨガの鳩のポーズ(資料URL)を取らされる\n・男はヨガポーズの青髪サキュバスちゃんを見ながら非常に興奮している\n・青髪サキュバスちゃんは性癖が理解できずに？マークの表情\n\n表情やシチュエーションなどはサキュバスちゃんの設定にあうように変更していただいて構いません。\nこの依頼自体が解釈違いでしたらお気軽にキャンセルしてください。\nご検討よろしくお願いいたします。\n\nhttps://www.hotyoga-loive.com/column/yoga-pose/hato-pose", "nc": 176, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@fttIfY55mIC8mM4/works/17", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 692267, "client_id": 1201878, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/a772ddaa/uploads/origins/1c52bc1b-ed1d-489d-831b-d73352b853c4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a82558f5d1b723461ad23f19a60769c2", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/a772ddaa/uploads/origins/1c52bc1b-ed1d-489d-831b-d73352b853c4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d9304cc5d2f9376d58d284a63d8b8497", "src_set": ""}, "body": "あなごさん、こんばんは。\nいつも素敵なイラストありがとうございます。\nあなごさんが公開されていたサキュバスちゃんのイラストが可愛かったので、サキュバスちゃんのイラストをお願いしたいです。\n\nスクール水着でしか興奮しない男に声をかけてしまい、スクール水着を着る羽目になったサキュバスちゃんのイラストを描いて頂きたいです。\n以下のようなイメージです。\n\n・サキュバスちゃんがJS時代のスクール水着を着ている\n・水着が小さいのでいろんな所がパツパツになっている\n・特に股間部分が引っ張られてハイレグ気味になっている\n・サキュバスちゃんは恥ずかしそうな表情\n\n表情やシチュエーションなどはサキュバスちゃんの設定にあうように変更していただいて構いません。\nこの依頼自体が解釈違いでしたらお気軽にキャンセルしてください。\n\nご検討よろしくお願いいたします。", "nc": 176, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@fttIfY55mIC8mM4/works/16", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 692267, "client_id": 1201878, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/072c0ba9/uploads/origins/e29ba0c2-9e17-4a50-8712-8c82ea223290?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=317b67a23a8dc3274eebdad64505fcb1", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/072c0ba9/uploads/origins/e29ba0c2-9e17-4a50-8712-8c82ea223290?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9b8c59fe86757b3f74f0e33f8d3f9dcc", "src_set": ""}, "body": "あなごさん、こんばんは。\nいつも素敵なイラストありがとうございます。\nあなごさんのXを見ていて、安全靴を履いた女の子が見たいなと思ったのでリクエストさせてください。\n\nわんぷりの犬飼こむぎちゃんが、安全靴を履いて足踏みしているイラストをお願いします。\nhttps://x.com/anago_001/status/1921610316875469240 に近いイメージで、以下のように変更したものを描いて頂きたいです。\n\n・変身前の姿(私服こむぎちゃん)\n・靴がハイカットまたはブーツタイプの安全靴\n・普段の靴より大き目でソール厚めで靴裏がごつごつしてそうな感じ\n・こむぎちゃんは靴が重くてとても疲れた表情\n\nご検討よろしくお願いいたします。", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@fttIfY55mIC8mM4/works/15", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 692267, "client_id": 1201878, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/e548bb53/uploads/origins/a47e6804-9f20-4f34-ad8f-fa919357defd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4dd33cbf21e932a7f8c1319a09f1c69f", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/e548bb53/uploads/origins/a47e6804-9f20-4f34-ad8f-fa919357defd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=1de2f0e2d3bd851e2910467464c26c9b", "src_set": ""}, "body": "あなごさん、こんばんは。\nいつも素敵なイラストありがとうございます。\n今回もGoプリキャラの衣装アレンジイラストを描いていただきたく、リクエストさせていただきます。\n\nGoプリのキュアマーメイドの衣装をレオタ見せ衣装風にアレンジしたイラストをお願いします。\nキュアマーメイドはへそ出しのセパレートタイプですが、以下のように改変していただきたいです。\n\n・お腹部分のおへそや肌の色が透ける素材になっている競泳水着風の衣装(透ける部分は白ベース、透けない部分は青系)\n・上記の衣装にキュアマーメイド風のスカートなどをつけた状態\n・マーメイドの表情は恥ずかしそうな感じ\n競泳水着風の部分は資料URLのもの(白+青/水色)がイメージに近いです。\n\nあなごさんに他の衣装アイデアがあれば、上記の指示を無視して描いて頂いて構いません。\nご検討よろしくお願いいたします。\n\nhttps://www.salondarts.com/SHOP/PF679.html", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@fttIfY55mIC8mM4/works/14", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 692267, "client_id": 1201878, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/a892b7d6/uploads/origins/479e860d-7a96-40fb-8179-b7422a6ffcb1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ef27c5255cb7d985907abd5db41ee2fe", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/a892b7d6/uploads/origins/479e860d-7a96-40fb-8179-b7422a6ffcb1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=7a450901fac98a63644051bf33e5bfac", "src_set": ""}, "body": "あなごさん、こんばんは。\nいつも素敵なイラストありがとうございます。\n\n前回、前々回と描いて頂いたイラストがとても素晴らしかったので、\nぜひ同じテーマで別キャ