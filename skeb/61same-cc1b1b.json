格は明るくかわいい子を予定しています。\n服装は、お送りした制服を元に描いてくださると嬉しいです。制服のカラーリングなどは変えずにお願いします。そのほかの装飾などは、安藤様にお任せします。\n安藤様の好きな要素を入れてくださると嬉しいです。私がとても嬉しいです。\n\n髪形、ポーズや構図なども\nすべておまかせいたします\n\n全体的に可愛く、仕上げてもらえたら嬉しいです！\n\n【使用用途】\nシナリオ通過時に立ち絵として使用\n卓報告に使用\n\nこちらの条件で問題ない場合は、お受けいただけたら嬉しいです。\n\nご検討、どうぞよろしくお願い致します！\n\nhttps://drive.google.com/file/d/1Nk0TcuxqtgDvZXFnMFnQJG_pVSzSPCGR/view?usp=sharing", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@61same/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 115919, "client_id": 3792204, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/3d198b86/uploads/origins/25796676-018e-4737-90a9-2e526a75e6c1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=655f0679e41e97f08cd6b7360dc96aad", "srcset": "https://si.imgix.net/3d198b86/uploads/origins/25796676-018e-4737-90a9-2e526a75e6c1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=655f0679e41e97f08cd6b7360dc96aad, https://si.imgix.net/3d198b86/uploads/origins/25796676-018e-4737-90a9-2e526a75e6c1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=5515661d0110bdfa03d43c9f9a5b4736 2x, https://si.imgix.net/3d198b86/uploads/origins/25796676-018e-4737-90a9-2e526a75e6c1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=db5156e36159cc0e78dba3a59b380fe8 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/3d198b86/uploads/origins/25796676-018e-4737-90a9-2e526a75e6c1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d0ac19330ec0f12e62268a7afcd32453", "srcset": "https://si.imgix.net/3d198b86/uploads/origins/25796676-018e-4737-90a9-2e526a75e6c1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d0ac19330ec0f12e62268a7afcd32453, https://si.imgix.net/3d198b86/up