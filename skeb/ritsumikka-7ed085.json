uration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/74eb82fb/uploads/origins/67c63f78-dc4e-41ae-bdbd-a2cbd7d60dc4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2012ec9a23eb97350715f2b26cac553e", "srcset": "https://si.imgix.net/74eb82fb/uploads/origins/67c63f78-dc4e-41ae-bdbd-a2cbd7d60dc4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2012ec9a23eb97350715f2b26cac553e, https://si.imgix.net/74eb82fb/uploads/origins/67c63f78-dc4e-41ae-bdbd-a2cbd7d60dc4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=ac9aada74242cd062d866406679ee86a 2x, https://si.imgix.net/74eb82fb/uploads/origins/67c63f78-dc4e-41ae-bdbd-a2cbd7d60dc4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=b9f93b222bbd3c89aaf93187705be501 3x"}, "body": "This may be an illustration or a very unusual request, but it is a request to create an elementary body illustration based on your understanding of the structure of the human body as seen in your drawings and the fact that you are a lecturer.\nI am having trouble understanding the connection between the neck, head, and shoulders in particular when drawing the human figure, and since I fundamentally dislike humans, I am sick and tired of observing them and have trouble doing it properly. I am having trouble observing people properly because I fundamentally dislike them. I thought I might be able to remember if I refer to illustrations of my favorite types.\nRequirements for creation\nI would like to use a boy around 14 years old as a model.\nThe illustration should be above the shoulders.\nThe connection between the neck, head, and shoulders should be clear.\nI would like you to use your illustration, not a realistic one.\nWe would like you to draw several illustrations.\nFor example, I can see the front view, but I would like you to draw an illustration that shows the position of the neck when the shoulders are slanted, the bend of the neck and the position of the face when the neck is swung to the left or right, and the position of the face when the head is turned to the right or left while facing straight ahead, so that I can compare it with the normal state.\nAs an aside, I prefer a simple boy like villager A to a beautiful boy.\nThank you in advance.", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "similar_creators": [{"id": 71355, "creator": true, "nsfw_acceptable": true, "acceptable": false, "name": "うかの / ukano ＠声音6 E-17", "screen_name": "xkanoxxx", "avatar_url": "https://pbs.twimg.com/profile_images/1918284282847752192/no4P7cPP.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1138381320130711552/1746115391/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 7, "complete_expiration_days": 60, "skills": [{"genre": "art"}, {"genre": "correction"}], "banned": false, "nc": 33}, {"id": 110000, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "のんびりケイス@絵描き､skeb一応やってます", "screen_name": "keishu__D", "avatar_url": "https://pbs.twimg.com/profile_images/1913239069506834432/U4n1owOY.jpg", "header_url": "https://pbs.twimg.com/profile_banners/292633171/1615982850/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "art"}, {"genre": "correction"}], "banned": false, "nc": 144}, {"id": 142596, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "きりく💫kiriku", "screen_name": "kirikuxxx", "avatar_url": "https://pbs.twimg.com/profile_images/1730992919040184320/FcA97u1k.jpg", "header_url