になる！\n\nふー、お腹いっぱい！お兄ちゃん、ご馳走さまでした。ちょっと食べすぎちゃったかも…？\nでも、こんなに楽しい食べ歩きは久しぶりだよ～！お兄ちゃん、今日は本当にありがとう！\nあ、私が奢ったことは2人だけの秘密にしてね？\nうん、約束だよ。もし破ったら…とんでもない事になっちゃうよ～？\n…あはは、そこまで怯えなくても大丈夫だよ～。大事にはしないから。\n…えっと、あのね、お兄ちゃん。次なんだけどね、遊園地とかどうかな？\nうん！連絡、待ってるからね！お兄ちゃん、大好きだよ！じゃあまたね！ばいばーい！！", "nc": 0, "word_count": 0, "transcoder": "audio", "creator_acceptable_same_genre": false}, {"path": "/@mashinemu_zZ/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "voice", "tipped": false, "creator_id": 1381079, "client_id": 110449, "vtt_url": "https://fcdn.skeb.jp/uploads/outputs/780f1e36-b8d2-4ad7-b2af-58c244a94be5?response-content-disposition=inline&Expires=1783062373&Signature=h76MTGcaDNGbsKvnbQlNYmk1V~N3RTWIL2B44a2P5Y9ME-Z~87R3nnvyFBwRbIJx~4rf~DAWyvnqp-v08iA-oSd9mPRPK-~NBSnJMOKWC1i3fK2DeqUHmRmxtBxFSq5W8FQ1aInDHFeDYELx4Olm1gPQJs5TvMLv2JfHvipv2RJno72lkdUoWwL8IlloVkCITTloKPN83zjldmzXqN2r3FZT~jg9q4Cq~aJSR4EUyH6FN4~h6hOuZeqmSAH-Qk1hrBdP5fBaRIxOW8Rl~YTxQU~kBcoeZGCIKGmptQHsLiSpjAcvfLwybx5Ec~yKVHztmndyZZbddPmaKvHKBu-qyg__&Key-Pair-Id=K1GS3H53SEO647", "thumbnail_image_urls": {"src": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1932841482287038464%2F3Hbuhg0Y.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e22af7c79592ace77bcbd1b26f732161", "srcset": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1932841482287038464%2F3Hbuhg0Y.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e22af7c79592ace77bcbd1b26f732161, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1932841482287038464%2F3Hbuhg0Y.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=7485151ae7780655d2d3e21a74116ea9 2x, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1932841482287038464%2F3Hbuhg0Y.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ad44ddd2a8d28d1751fb51bd30617c79 3x"}, "preview_ur