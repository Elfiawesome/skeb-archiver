2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ac1cee00cae1c430dd9f4971f46a54e8 2x, https://si.imgix.net/1f7c9128/uploads/origins/cd81818b-daa6-424e-a567-1097ec2d568a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=26e7e8f1865dd8e16bdcc24f87882900 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/1f7c9128/uploads/origins/cd81818b-daa6-424e-a567-1097ec2d568a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3314793a220f87985709ee13a290c005", "srcset": "https://si.imgix.net/1f7c9128/uploads/origins/cd81818b-daa6-424e-a567-1097ec2d568a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3314793a220f87985709ee13a290c005, https://si.imgix.net/1f7c9128/uploads/origins/cd81818b-daa6-424e-a567-1097ec2d568a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=a5d6216e58763d684b0f49bf97dac17f 2x, https://si.imgix.net/1f7c9128/uploads/origins/cd81818b-daa6-424e-a567-1097ec2d568a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=2cfa507db427e6d316263e676ab206bd 3x"}, "body": "Hello!\nSorry for the second request.\nI really want to ask you to draw a picture of my cat.\nWhat I would like you to draw is a personification of our cats.\nWe have 5 cats, and I would like you to draw my 3rd and youngest son.\n\nCharacteristics of the third boy: White with a light brown-gray blotch on his head. Short hair. Black tail, light blue eyes. He has a very sweet personality to humans and can get around well among other cats. He is a good big brother to his youngest son, playing with and bothering him.\n\nYoungest son is a male black cat, short-haired. He is only 5 months old. His eyes are more golden than copper. He has a mischievous personality. He is very fond of the third boy. He plays with them a lot. He is not shy of people at all.\n\nThat's all.\nThe purpose of use is \"I want to love my child.\n\nhttps://www.instagram.com/p/CxqRx3VStnC/?igshid=NTc4MTIwNjQ2YQ==", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@kanariraku/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2635607, "client_id": 2671201, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/710861b9/uploads/origins/e3823486-af91-4c18-a153-14d37faae04c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=01dcc824ed28e14678a10e2cf172e4c8", "srcset": "https://si.imgix.net/710861b9/uploads/origins/e3823486-af91-4c18-a153-14d37faae04c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=01dcc824ed28e14678a10e2cf172e4c8, https://si.imgix.net/710861b9/uploads/origins/e3823486-af91-4c18-a153-14d37faae04c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e57f660fde34d40a0b8753b801fda629 2x, https://si.imgix.net/710861b9/uploads/origins/e3823486-af91-4c18-a153-14d37faae04c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=73c26fa5337497f6de5b1ea4af515d77 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/710861b9/uploads/origins/e3823486-af91-4c18-a153-14d37faae04c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=bf751423178842fad508cfe72dea108f", "srcset": "https://si.imgix.net/710861b9/uploads/origins/e3823486-af91-4c18-a153-14d37faae04c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=bf751423178842fad508cfe72dea108f, https://si.imgix.net/710861b9/uploads/origins/e3823486-af91-4c18-a153-14d37faae04c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=010b784185deb1865c2b8a4de34ba591 2x, https://si.imgix.net/710861b9/uploads/origins/e3823486-af91-4c18-a153-14d37faae04c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=25694a1eb5df4553d7a22a081bce63d9 3x"}, "body": "こんにちは。\n夏鳴さんの絵柄やタッチが好きなので、リクエストを送らせてください！\n\n【要望】\n家族の猫２匹を擬人化\n表情や構図などは自由にお任せします。\n\n【詳細】\nどちらもオスで猫種は推測です。\n・ひなた（15）タイ※シャム猫を丸くした感じの種\n　おとなしくて甘え下手、どちらかといえばクールな一匹狼です。\n・ぐーぐー(12) キジトラ\n　ひなたの２～３年後にやってきました。コミュ強で甘え上手。\n\nぐーぐーが近づくと、ひなたは怒るので、ずっと微妙な距離感で同居しています。\nけして仲良しではないですが、稀にくっついたり近くにいたりします。\n資料の写真をこちらにアップしております。\nhttps://drive.google.com/drive/folders/1TOZyhOi4z3b7Sc7gcB6nCsj2nmPLLk5g?usp=sharing\n\nよろしくお願いします！", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@kanariraku/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2635607, "client_id": 2668977, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/a9d5b11b/uploads/origins/6bd71552-cd6c-44ca-b05e-925add54bb63?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=80d55fddedb84b37a8a326c6d69da1b5", "srcset": "https://si.imgix.net/a9d5b11b/uploads/origins/6bd71552-cd6c-44ca-b05e-925add54bb63?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=80d55fddedb84b37a8a326c6d69da1b5, https://si.imgix.net/a9d5b11b/uploads/origins/6bd71552-cd6c-44ca-b05e-925add54bb63?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b6bad6f93b7707030536916fd45350c4 2x, https://si.imgix.net/a9d5b11b/uploads/origins/6bd71552-cd6c-44ca-b05e-925add54bb63?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=fee3161b4c110667b832320297554e36 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/a9d5b11b/uploads/origins/6bd71552-cd6c-44ca-b05e-925add54bb63?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c73823f0f2abc76a189308421214efde", "srcset": "https://si.imgix.net/a9d5b11b/upl