&w=200&h=200&s=a9d720504cc7959fd53aeb392d45e35b", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/77662055/uploads/origins/90593366-6d04-4332-a044-a7e1bfd233cd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3e071daa898e26194290c823f77876bd", "src_set": ""}, "body": "お世話になっております。\n大科学少女という作品の根古守というキャラクターのイラストをお願いします。\n\n制服の上にジャージを羽織っている\nおでこと太眉が特徴的な娘です。\n構図はお任せします。元気っ娘！という感じでお願いします。\n\n小柄だけど下半身の肉付きが良い\nお尻周りの大きい体型で描いていただけると\n嬉しいです！\n\nhttps://bookwalker.jp/de989be783-8c2c-4eb1-a176-2ae24bc2f46f/?adpcnt=7qM_SasK", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@jinnnouti_akira/works/27", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 629057, "client_id": 0, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/3fd87d52/uploads/origins/1e6ac968-9337-4e95-b499-ee431691fc85?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f332138661ba310cbcdde1611335d432", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/3fd87d52/uploads/origins/1e6ac968-9337-4e95-b499-ee431691fc85?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2894731d8738782f9597dc21edf22592", "src_set": ""}, "body": "『キルミーベイベー』と『ぼっち・ざ・ろっく！』のクロスオーバー的なイラストをお願いします。\n\n【人物】\nソーニャと虹夏\n\n【イラスト概要】\nお互いの衣服を交換して着ているソーニャと虹夏の姿\n\n2人のポーズや表情など、指定していないところは自由に描いていただいて構いません。\nよろしくお願いします。", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@jinnnouti_akira/works/26", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 629057, "client_id": 0, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/a9dee681/uploads/origins/5f9899ce-b13f-4d15-b