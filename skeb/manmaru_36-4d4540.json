586a6c/uploads/origins/73f48128-7e05-4b5e-87b2-c3080b1d5d1d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=4dcfc75176e67c61de4b6991d708cfc6 2x, https://si.imgix.net/6e586a6c/uploads/origins/73f48128-7e05-4b5e-87b2-c3080b1d5d1d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=597751c2dfe5d72ca75386c0c3b680cb 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/6e586a6c/uploads/origins/73f48128-7e05-4b5e-87b2-c3080b1d5d1d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=08f71cb82c8ea4bf7d10f74cec88e2f9", "srcset": "https://si.imgix.net/6e586a6c/uploads/origins/73f48128-7e05-4b5e-87b2-c3080b1d5d1d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=08f71cb82c8ea4bf7d10f74cec88e2f9, https://si.imgix.net/6e586a6c/uploads/origins/73f48128-7e05-4b5e-87b2-c3080b1d5d1d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=e41bee688eb9ef6c7c746bae2ac4daa0 2x, https://si.imgix.net/6e586a6c/uploads/origins/73f48128-7e05-4b5e-87b2-c3080b1d5d1d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=c560e22122e752326c22367092913900 3x"}, "body": "アピールありがとうございます！たまに新着からイラスト見てました！アピールくれて嬉しいです、ぜひリクエストさせて下さい！\n\n案1）柏壬ちゃんにちょっと際どい衣装を勧められ桜弥ちゃんがタジタジになっている様子\nぜひこちらの未明様のアピールでの案で描いて欲しいと思っています。\nどういう衣装が得意かわからないので、お任せしたいと思います。\n構図などもお任せしますね。\n可愛く描いてくれたら嬉しいです！\n\n柏壬（はくみ）\n22歳、薄緑のロングヘアーに薄緑の瞳、170cmで高身長のコスプレ趣味のお姉さん。胸はHカップでボンキュッボンなタイプです。妹と一緒にコスプレをするのが趣味。髪を伸ばしてるのはいろいろアレンジできるから。腰下までの長さです。\nhttps://drive.google.com/drive/folders/1jqMr3hmcZtI4Pbkjvhu2E8_xiN3yJni5\nhttps://drive.google.com/drive/folders/1rMpeaTqE_NIfZI4au9Uve-y6UVHkmi2g\n\n桜弥（おうみ）\n17歳、166cm、Dカップ。ボブヘアー。姉がいるが、姉が巨乳で自分が普通なのがコンプレックス。その割にオシャレのためなら胸をアピールすることも忘れない。姉がコスプレ好きで、それに付き合っていろんな服を着させられたりしている。髪が短いのは姉にアレンジさせられまくるのを回避するため。\n髪にインナーカラーが入っている（三面図参照）目の色はインナーカラーと同じで緑ではないです（AIで資料を制作しているためややこしいですが、三面図参考でお願いします）\n\nhttps://drive.google.com/drive/folders/1ldnQ85FiD2bewf2m3tZyI8EBekVtrdmj\nhttps://drive.google.com/drive/folders/1vEsUUbtBMMe0u8itbaKtlOKZw4UYNphw\n\nもしご縁がありましたら、よろしくお願いします。", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@manmaru_36/works/8", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3450475, "client_id": 3502391, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/23104909/uploads/origins/9a4063d0-522b-4cd1-b04e-7e111ed62131?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8501128821902e3f410f95f8398621c3", "srcset": "https://si.imgix.net/23104909/uploads/origins/9a4063d0-522b-4cd1-b04e-7e111ed62131?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8501128821902e3f410f95f8398621c3, https://si.imgix.net/23104909/uploads/origins/9a4063d0-522b-4cd1-b04e-7e111ed62131?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f8e4104403ed5e7c45e471f31763f5d9 2x, https://si.imgix.net/23104909/uploads/origins/9a4063d0-522b-4cd1-b04e-7e111ed62131?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=dab55b0732fcd1407e2d51af521fd24a 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/23104909/uploads/origins/9a4063d0-522b-4cd1-b04e-7e111ed62131?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a08434dc8c2306b498da98c82f38bece", "srcset": "https://si.imgix.net/23104909/uploads/origins/9a4063d0-522b-4cd1-b04e-7e111ed62131?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a08434dc8c2306b498da98c82f38bece, https://si.imgix.net/23104909/uploads/origins/9a4063d0-522b-4cd1-b04e-7e111ed62131?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=28746f8a9b67a9c26967afc840