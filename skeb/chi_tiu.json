received_works": [{"path": "/@chi_tiu/works/95", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 578294, "client_id": 864384, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/b6079d40/uploads/origins/1cc278cf-cba9-4bdd-a712-8e16d3c0a0c5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5cab90fd64d1bd0bf6020a8e9db838f2", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/b6079d40/uploads/origins/1cc278cf-cba9-4bdd-a712-8e16d3c0a0c5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=29799925701430bda5cd013dbb045a58", "src_set": ""}, "body": "こんにちは！私のキャラクターであるカワウソのフェンは、とてもnsfwで思わせぶりですが、ギリギリ隠れるか角度がついているので、打ち切られる必要はありません。あなたが望むなら、彼は他の服やアクセサリーを身に着けていてもいいし、細かいディテールはすべて芸術的自由であり、前回描いたときと同じようでもいいし、あなたのスタイルが成熟してきたときに彼を違うように解釈し直してもいい。フェンについてやりたいことは何でもしていい！  \n重要なディテールは、メガネ、牙、小さめの黒っぽい耳、薄めの親指です。あなたのスタイルで彼を描くために必要なことは何でも自由にやってください。\n\nhttps://www.dropbox.com/sh/94ppvarxvejbzmc/AADJLZTDD_rmvFX-oSwZ9WF1a?dl=0", "nc": 161, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@chi_tiu/works/94", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/8f3f2fee/uploads/origins/708f3dbe-38c9-4b7e-9fbb-2a27dd5a62ab?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=6ff2b0129cad45676487d8356d2d7f89", "src_set": ""}, "private": true, "genre": "art", "tipped": true, "creator_id": 578294, "client_id": 0, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 49, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@chi_tiu/works/93", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/8afbed30/uploads/origins/75250f3e-6119-4736-a028-e6f2eaac4419?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=0b34ffd253ef0b1b15f240a555b43cb6", "src_set": ""}, "private": true, "genre": "art", "tipped": false, "creator_id": 578294, "client_id": 0, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 49, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@chi_tiu/works/92", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 578294, "client_id": 436504, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/3283557b/uploads/origins/3dd5e41a-4073-4dfa-9838-9676bc819b1c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2a0503ed1be245726c7d41a6590725d9", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/3283557b/uploads/origins/3dd5e41a-4073-4dfa-9838-9676bc819b1c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=886db106a9ea0ade7cc58def4918d699", "src_set": ""}, "body": "かなり前に相撲部の虎くんみたいなのをツィッターに載せてらしたと思うのですがその子をお願いできますか？\n回しジャージ普通顔と、回しなし露茎えっち顔差分があると好ましいですが１枚でも大丈夫です\nご検討ください！", "nc": 32, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@chi_tiu/works/91", "private_thumbnail_image_urls": null, "private": false, "genre": "comic", "tipped": true, "creator_id": 578294, "client_id": 0, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/7e84120c/uploads/origins/a8b7095d-f439-4a27-8d50-852cacef7cbd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=cf41ea538201049db1ed9a2c93e2b23d", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/7e84120c/uploads/origins/a8b7095d-f439-4a27-8d50-852cacef7cbd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b27a985ba8987fd67db3123c7099bf2d", "src_set": ""}, "body": "pixivを拝見していた時に、ファンファンされファンファン（獣姦）のイラストに衝撃を受けた者です。\nそこでファンファンのイラストのような事が、忍者ヒーロー斬影の漫画の主人公：斬影だったらどうなってしまうだろうと、以下の妄想をしてみましたが、具象化していただく事は可能でしょうか。同人イベントの色紙が、いつも売切れで購入する事が出来ない為、せめてSkebだけでもと思い、ご依頼させていただきます。\n\nタイトル：潜入失敗！？\n\nシチュエーション（妄想）：\n敵のアジトに忍び込んだ斬影、とっ捕まって連れて行かれたのは犬小屋だった。するとそこには雌犬に飢えた、大小様々な本能をむき出しにした若い雄犬が十数頭いた。\nそこで突然雄犬達の性処理をするように命じられるが、いくらちんぽが好きな斬影でも、「さすがに犬のちんぽだけは」と拒否をしたが、突然お尻に貫かれるような違和感を覚えた。\n振り返ると待ちきれない一匹の狂棒（狂暴）な雄犬が「四の五の言わずに、まずは試してみたらどうだ。答えはここにあるだろ」と言わんばかりに、斬影の柔らかな肉穴へ、いきり勃つ肉棒を突き刺していた。\n今までの威勢が急に無くなり、艶の交じった声で「やっ、やめろ」と言う事が精一杯な斬影、雄犬の肉棒に何度も突き上げられるたびにヒーローとしての理性と雌犬の本能の狭間を彷徨っていたが、斬影の中に子種が放たれた時、斬影の身体もまたメスイキと理性が崩壊し、思考が雌犬のそれに書き換えられた。\n\n犬と体を結合してからどのくらい時間が経っただろうか、斬影の肉穴から溢れ出た子種のきつい臭いで目を覚ますと、次は俺達の番だとばかりに他の雄犬達に囲まれていた。\n本能をむき出しにした犬達は、束になって斬影に襲いかかるも、雌犬と化した無双状態の斬影に次から次へと抜かれ、ヤ（犯）られていく。\n血しぶきのように子種まみれになっていく斬影を遠目から見ていたボス犬は、「お前たちが適う相手ではない、俺が相手をする。下がれ」と言わんばかりに、あらゆる雌犬達を泣かせてきた肉棒をぶら下げ、斬影の前に歩み出てきた。\n\n次回予告：ボス犬vs斬影の穴闘（けっとう）、どうする斬影、どうなる忍者ヒーロー斬影　つづく\n\nというような妄想をコミックで見てみたいですが、変わっても構いません。あとはお任せいたしますので、ご検討のほどよろしくお願い致します。", "nc": 56, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@chi_tiu/works/90", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/a30f7802/uploads/origins/f7e311ec-d5c1-42bc-a193-ee4996302fe0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=830e38b3bfe6874817508b31f52eb8dc", "src_set": ""}, "private": true, "genre": "art", "tipped": true, "creator_id": 578294, "client_id": 0, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 48, "word_count": 0, "tran