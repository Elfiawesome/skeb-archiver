508-b719e7af9246?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=9467b1593e601425659e0b0efd201456 2x, https://si.imgix.net/7ec36ee3/uploads/origins/63829022-45da-4cd4-9508-b719e7af9246?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=45bb24725cd60c995fae2f41d8ff7367 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/7ec36ee3/uploads/origins/63829022-45da-4cd4-9508-b719e7af9246?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ad7307c37c92946630ffa95c50a4c38e", "srcset": "https://si.imgix.net/7ec36ee3/uploads/origins/63829022-45da-4cd4-9508-b719e7af9246?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ad7307c37c92946630ffa95c50a4c38e, https://si.imgix.net/7ec36ee3/uploads/origins/63829022-45da-4cd4-9508-b719e7af9246?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=a13000d41eee160de8268ebc31a22739 2x, https://si.imgix.net/7ec36ee3/uploads/origins/63829022-45da-4cd4-9508-b719e7af9246?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=9d64092a58f86105b0e61cbb8c0d6afc 3x"}, "body": "こんにちは、私はあなたのドラゴンの絵がとても好きです！\n私のキャラクターを描いてください。\n彼はレイライン クリスタルの守護竜であり、レイライン クリスタルがいたるところに成長する雪をかぶった極地に住んでいます. 彼の体のクリスタルは、環境内で互いに共鳴して光ることができます.\n彼が立って、彼の後ろから光が輝いていることを望んでいます。私たちの視点から見ると、彼は神聖に見えます。クリスタルと目も光を放射します。そして翼を開くと、翼の稲妻の模様も白く光りました。\n\nhttps://drive.google.com/drive/folders/1dzZTKnkea8pmVsbBcXBBbB6CJjWGpM0I?usp=drive_link\n\nhttps://drive.google.com/drive/folders/1dzZTKnkea8pmVsbBcXBBbB6CJjWGpM0I?usp=drive_link", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@ShimaShima_4444/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2566299, "client_id": 584710, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/5eb6a3a8/uploads/origins/243f8b6d-b1ea-4315-9a34-101f5285b454?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6fb8078731cf510b5dfd25fe14d3ffec", "srcset": "https://si.imgix.net/5eb6a3a8/uploads/origins/243f8b6d-b1ea-4315-9a34-101f5285b454?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6fb8078731cf510b5dfd25fe14d3ffec, https://si.imgix.net/5eb6a3a8/uploads/origins/243f8b6d-b1ea-4315-9a34-101f5285b454?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=5254d99a3ec4444ab3b614916db04491 2x, https://si.imgix.net/5eb6a3a8/uploads/origins/243f8b6d-b1ea-4315-9a34-101f5285b454?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a82e0785fdec106147c5366ad57a76e8 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/5eb6a3a8/uploads/origins/243f8b6d-b1ea-4315-9a34-101f5285b454?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=72902c726af0f923aba98c2d3e2f79ca", "srcset": "https://si.imgix.net/5eb6a3a8/uploads/origins/243f8b6d-b1ea-4315-9a34-101f5285b454?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=72902c726af0f923aba98c2d3e2f79ca, https://si.imgix.net/5eb6a3a8/uploads/origins/243f8b6d-b1ea-4315-9a34-101f5285b454?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=04414b9b604f8ebf57855a4df4a58de4 2x, https://si.imgix.net/5eb6a3a8/uploads/origins/243f8b6d-b1ea-4315-9a34-101f5285b454?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=5af08783865039a9b1c68c6af9ab46bc 3x"}, "body": "はじめまして！　貴方の手掛けられたドラゴンの迫力と魅力に満ち溢れた表現にすっかり魅了されて、リクエストをお送りさせて頂きました。\n良ければ、うちの子のドラゴンを貴方の手で手掛けて頂けませんか？\nまた、良ければ差分も手掛けて頂けますと嬉しく思います。\n\nお願いさせて頂きたい子は、エリクシルという名の、頭から後ろ脚まで30mくらいある竜のお姉さんになります。\n通常は四足歩行ですが、後ろ脚だけで立ち上がることも可能な子です。\nこの子の巨体ぶりが際立つような構図で、ぜひ手掛けて頂けませんか？\n全身に近い範囲がアングルに入っていますと嬉しいです！\n\nまた、お願いしたい差分の内容なのですが、彼女はお腹に魔力を大量に貯め込んでパワーアップできる一方、貯めた分だけお腹が丸々と膨らんでしまう体質を持っています。\nそこで、彼女が目一杯魔力を貯めたようなイメージでお腹が膨らんだ姿の差分を手掛けて頂けないでしょうか？\n大きければ大きいほど嬉しいですが、ShimaShima様の筆の乗るぐらいで手掛けて頂けますと非常に嬉しいです。\nもし良ければ大きさに挑戦して頂けますと、大変感謝いたします。\n\nぜひともご検討を宜しくお願い申し上げます。\n\nご参考\nhttps://x.com/Haku17/status/1685236847876755456\n\nご参考その2\n\nhttps://x.com/Haku17/status/1685237653401427968", "nc": 33, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@ShimaShima_4444/works/4", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/2e3e108a/uploads/origins/f54c6af7-6955-4663-941f-0527dc5bce2f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=9607012aac9dae299def3729edb25e11", "srcset": "https://si.imgix.net/2e3e108a/uploads/origins/f54c6af7-6955-4663-941f-0527dc5bce2f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=9607012aac9dae299def3729edb25e11, https://si.imgix.net/2e3e108a/uploads/origins/f54c6af7-6955-4663-941f-0527dc5bce2f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=077c28be2d71af27a99557250a90563b 2x, https://si.imgix.net/2e3e108a/uploads/origins/f54c6af7-6955-4663-941f-0527dc5bce2f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=341c018efb2d754e8feda09757903022 3x"}, "private": true, "genre": "art", "tipped": true, "creator_id": 2566299, "client_id": 542319, "nc": 16}, {"path": "/@ShimaShima_4444/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2566299, "client_id": 256930, "vtt_url": null, "thumbnail_i