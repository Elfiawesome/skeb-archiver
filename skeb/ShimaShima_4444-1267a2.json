ツの背中側のイラストをお願いします。\n可能であれば、全体のデザインをしていただけるとありがたいです。\nイラストについては、以下の２点を満たしていれば後は自由です。\n\n１　「Y.C. 1st Aniv」という文字が入っている\n２　鯖主である矢沢さんを髣髴とさせるようなデザイン\n\nTシャツの色についてはお任せします。\nデザインのイメージに合う色を指定していただけるとありがたいです。\n\n参考までに、矢沢さんはギルティギアストライヴというゲームでアンジを使っています。\n\nその他についてはお任せします。\nご検討よろしくお願いします。", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@ShimaShima_4444/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2566299, "client_id": 205337, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/feb30387/uploads/origins/66085df3-c93b-48fc-b945-8cb8438b2a5f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8debc20a14732af24338ed7954467ae2", "srcset": "https://si.imgix.net/feb30387/uploads/origins/66085df3-c93b-48fc-b945-8cb8438b2a5f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8debc20a14732af24338ed7954467ae2, https://si.imgix.net/feb30387/uploads/origins/66085df3-c93b-48fc-b945-8cb8438b2a5f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=5f8b798a1f64c07a2da6d2da1a77917a 2x, https://si.imgix.net/feb30387/uploads/origins/66085df3-c93b-48fc-b945-8cb8438b2a5f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=8cd20c721e133b7a8dc314effac4b6fd 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/feb30387/uploads/origins/66085df3-c93b-48fc-b945-8cb8438b2a5f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e8ab00b5c4c0237ca4f36d1e263f6d50", "srcset": "https://si.imgix.net/feb30387/uploads/origins/66085df3-c93b-48fc-b945-8cb8438b2a5f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e8ab00b5c4c0237ca4f36d1e263f6d50, https://si.imgix.net/feb30387/uploads/origins/66085df3-c93b-48fc-b945-8cb8438b2a5f?bg=%23fff&auto=format%2Ccompre