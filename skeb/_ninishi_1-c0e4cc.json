rigins/f784080e-5778-4d10-b43d-09d11ca173da?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=e5965ac070388f1c95d3faebdb05f2f9 3x"}, "body": "僕のOCのヴィチェンツォとエデルを描いてくれないかな？\n\n僕が今開発中の乙女ゲーム（ant-san.itch.io/villainotome）の恋愛オプションなんだ。\n\nエデルはヴィチェンゾの忠実な執事で、彼の右腕でもある。他人にちょっかいを出すのが趣味。ゲームのいくつかのバッドエンドで女性主人公を殺す。\n\nエデルの肌は日焼けしており、目の下に2つのほくろがある。目は赤と紫の2色。また、髪が乱れていることでも知られている。アホ毛がある。\n\nヴィチェンツォは伯爵で、原作の悪役。いつも笑顔を浮かべている。シルバーブルーのふわふわの髪とキツネ目（糸目）が特徴。ヴィチェンツォは策略家でいたずら好きだが、おバカで陽気なところもある。主人公の女性には優しく振る舞う。彼の真意を読み取るのは難しい。\n\n構図はお任せするので、とにかくカッコよくハンサムに仕上げてください！\n\n使い道：\nゲームには使いませんが、ゲーム開発ブログのサムネイル（itch.io/devlogs）やSNSの投稿に使いたいと思います。\n\nhttps://drive.google.com/drive/folders/1nURkFqYSotKMGBfACAyqfTZloHZUO7ga?usp=sharing\n\nhttps://drive.google.com/drive/folders/1eXPnwyqXjzw3lSk-Wa8Oz4VBLn4VxwOZ?usp=sharing", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@_ninishi_1/works/12", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1981292, "client_id": 629365, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/89afb4e2/uploads/origins/024e7ea7-4a41-41ac-8a87-c6a722286ef8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e6c00bfab310194def723b84f64d13aa", "srcset": "https://si.imgix.net/89afb4e2/uploads/origins/024e7ea7-4a41-41ac-8a87-c6a722286ef8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e6c00bfab310194def723b84f64d13aa, https://si.imgix.net/89afb4e2/uploads/origins/024e7ea7-4a41-41ac-8a87-c6a722286ef8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=059c414ea77381e5faf3fa65ab5d5231 2x, https://si.imgix.net/89afb4e2/uploads/origins/024e7ea7-4a41-41ac-8a87-c6a722286ef8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=22eaaddceb34280158d3d94f9ec9a45e 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_