file/f2-toyhou-se/images/32923432_1W9IdwMNIBei2tZ.png\nhttps://toyhou.se/2419562.han\n\n彼は男の子ですが、アンドロイドに見えます！彼はとても幸せで遊び好きですが、瞑想や旅行も好きです。彼はとてもハッピーで遊び好きですが、瞑想や旅行も好きです。ポーズや服装はお任せします。唯一具体的なリクエストは、彼がネックレスをつけていることです彼の世界には自然や古い遺跡、魔法がたくさんあり、モチーフは宇宙と植物と火です。また、彼は癒し系で、薬やハーブの知識も豊富です。そんな彼のために、みなさんが好きなものを描いてください\n\n今回もありがとうございました", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@breezewindy/works/3", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/a2a696ec/uploads/origins/0beaf1a3-82a8-42d0-b0da-0bd21c34c18f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=92ee25bbf179638497737111d04fda1c", "srcset": "https://si.imgix.net/a2a696ec/uploads/origins/0beaf1a3-82a8-42d0-b0da-0bd21c34c18f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=92ee25bbf179638497737111d04fda1c, https://si.imgix.net/a2a696ec/uploads/origins/0beaf1a3-82a8-42d0-b0da-0bd21c34c18f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=202e52269a94a53412a5fb4620ba88a0 2x, https://si.imgix.net/a2a696ec/uploads/origins/0beaf1a3-82a8-42d0-b0da-0bd21c34c18f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=ff92e12a5dd52468ab5d4015bcff41c6 3x"}, "private": true, "genre": "art", "tipped": true, "creator_id": 354141, "nc": 0}, {"path": "/@breezewindy/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 354141, "client_id": 2398571, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/78041705/uploads/origins/929e118