ibb.co/mD3ThRv\n\nこれと同じような、座って見る人を見上げるポーズをとってほしい。同じようなポーズであれば、これらのポーズと全く同じである必要はありません。\nhttps://ibb.co/vX6C3KY\nhttps://ibb.co/6b28rM9\nhttps://ibb.co/SPMsHZK\n\n背景については、前回のリクエストで追加していただいたような枠線があることだけをお願いします。その他はすべてお任せします。ありがとうございました！", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@pukupuku_tr/works/7", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/ef2ef53c/uploads/origins/cf8e0631-74ce-4b24-9c61-ea4062374f4c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=62974a2bf8b4cb62feb5b2b58e6e9fb9", "srcset": "https://si.imgix.net/ef2ef53c/uploads/origins/cf8e0631-74ce-4b24-9c61-ea4062374f4c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=62974a2bf8b4cb62feb5b2b58e6e9fb9, https://si.imgix.net/ef2ef53c/uploads/origins/cf8e0631-74ce-4b24-9c61-ea4062374f4c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=37db8b451b295313aa6c41253df97fb2 2x, https://si.imgix.net/ef2ef53c/uploads/origins/cf8e0631-74ce-4b24-9c61-ea4062374f4c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=c10a0ea9b7d9f41ebfac3b27cb8af479 3x"}, "private": true, "genre": "art", "tipped": true, "creator_id": 2621397, "client_id": 207086, "nc": 145}, {"path": "/@pukupuku_tr/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2621397, "client_id": 2801467, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/cd62ee22/uploads/origins/188d1216-338f-498c-bedf-93cf6f2e743a?bg=%23fff&auto=format%2Ccompre