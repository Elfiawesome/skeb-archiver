いです！（両手を頭の後ろで組んでるセクシーポーズなど）、写真みたいな感じで両足が開いてて太ももの間拳一つ分以上空いてるとうれしいです！また少し鼠蹊部を書いて欲しいです！\n\nもし値段や条件などに問題があれば再送を要請して欲しいです！\n\n長文失礼しました！", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 778114, "creator": true, "nsfw_acceptable": true, "acceptable": false, "name": "Savankov", "screen_name": "m1928tommygun", "avatar_url": "https://pbs.twimg.com/profile_images/1894437393266024448/zaz3tIsl.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1225369752421326848/1723872494/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 3, "complete_expiration_days": 60, "skills": [{"genre": "art"}], "nc": 16}, {"id": 1652770, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "ろろ", "screen_name": "ofukurodayo", "avatar_url": "https://pbs.twimg.com/profile_images/1954961762144702464/3DMT6UCa.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1201153208430690305/1754934192/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 7, "complete_expiration_days": 60, "skills": [{"genre": "art"}], "nc": 128}, {"id": 1948911, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "Ayaka.", "screen_name": "_shiroikarasu_", "avatar_url": "https://pbs.twimg.com/profile_images/1933186878670561280/0H-6Zb3z.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1068640259867439104/1749742645/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "art"}], "nc": 16}, {"id"