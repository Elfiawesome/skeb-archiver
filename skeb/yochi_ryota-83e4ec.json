-f42e2b7ea3f4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=cdc229d159cf8ee04d3a5f96ebba2ff2 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/838ec66a/uploads/origins/74d6c674-8f9b-4ef0-aa19-f42e2b7ea3f4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=7ca8664dd8abcaecbb87ed1ff3d04cca", "srcset": "https://si.imgix.net/838ec66a/uploads/origins/74d6c674-8f9b-4ef0-aa19-f42e2b7ea3f4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=7ca8664dd8abcaecbb87ed1ff3d04cca, https://si.imgix.net/838ec66a/uploads/origins/74d6c674-8f9b-4ef0-aa19-f42e2b7ea3f4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=a10382352163bbbea1ea7895520a6dd7 2x, https://si.imgix.net/838ec66a/uploads/origins/74d6c674-8f9b-4ef0-aa19-f42e2b7ea3f4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=a50cda15eab2091b6fb366ad642889b5 3x"}, "body": "はじめてのSkebで不手際がありましたらご容赦ください。\nいつも応援させて頂いております!\n私のブログが8月頃に引っ越し後2年となります(段階的に移行したので記念日は特にないです)\nつきましては、当ブログの移設2周年の記念絵をお願いしたいです。当ブログの該当記事のトップに掲出いたします。\nもし可能であれば、よち先生の初単行本のレビュー記事としてお出ししたいので、単行本登場のキャラクター要素(どなたでも)を入れて頂けると嬉しいです。文言含めて単行本の宣伝要素を入れていただけるとなお嬉しいです(入手後のレビューでお出しするので「絶賛発売中」ステータスで)。何らかの事情で単行本発売が順延した場合も、当ブログでの掲出は単行本発売(=レビュー)に合わせます。それまでは手元で愛でさせて頂きます!\n\n「お祝い」の雰囲気であれば構図含めてお任せいたします。セクシー要素はあっても無くてもOKです。ブログのトップ画像としてSNSにサムネイルが載りますので、NSFW要素はナシでお願いします。\n\n当ブログの主宰者は実はウチに古くから居るぬいぐるみ(貫禄あるので「かもめ先生」と呼んでます)というテイなのです。バナー・アイコンにも出ています。参考写真を貼っておりますので、お手数ですがこちらを組み込んで頂けますでしょうか。キャラとしては色つきの角帽(卒業式で投げるやつ)を被っています。翼部分は自由に動きます。黒の点目ですが表情を入れて頂いてもOKです。人間比で各辺50cmの立方体ぐらいのサイズ感でお願いします。デザインで考慮して頂く必要はありませんが、このキャラ部分のみアイコンなどブログパーツとして使わせて頂きたいです。もしかもめ先生のキャラクターに文字が重なる場合は、文字抜き差分をご用意いただけると助かります。\nhttps://eromanga-memory.com/wp-content/uploads/20260526_190436787-scaled.jpg\nhttps://eromanga-memory.com/wp-content/uploads/20260526_190441251-scaled.jpg\nhttps://eromanga-memory.com/wp-content/uploads/20260526_190501648-scaled.jpg\n\nよろしくお願いいたします\n\nhttps://eromanga-memory.com/", "nc": 161, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@yochi_ryota/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3368895, "client_id": 3462444, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/a946cae2/uploads/origins/d987a616-63dd-45bc-8251-7693da0f417a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=92708a6e3504dc6a16f680b7eae9e697", "srcset": "https://si.imgix.net/a946cae2/uploads/origins/d987a616-63dd-45bc-8251-7693da0f417a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=92708a6e3504dc6a16f680b7eae9e697, https://si.imgix.net/a946cae2/uploads/origins/d987a616-63dd-45bc-8251-7693da0f417a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a491faca04326213e6985684b7d23944 2x, https://si.imgix.net/a946cae2/uploads/origins/d987a616-63dd-45bc-8251-7693da0f417a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d506c54609023c5d1d0fb9dd4b6c8f34 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/a946cae2/uploads/origins/d987a616-63dd-45bc-8251-7693da0f417a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=1da488561183e49fa3f2bfe71fc66971", "srcset": "https://si.imgix.net/a946cae2/uploads/origins/d987a616-63dd-45bc-8251-7693da0f417a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=1da488561183e49fa3f2bfe71fc66971, https://si.imgix.net/a946cae2/uploads/origins/d987a616-63dd-45bc-8251-7693da0f417a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=1e20c1419a0ae3e7a3bb8b3f15040aed 2x, https://si.imgix.net/a946cae2/uploads/origins/d987a616-63dd-45bc-8251-7693da0f4