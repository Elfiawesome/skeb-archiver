fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=24f4ea9988b3ff2529da0ea26a87194c 2x, https://si.imgix.net/b6a797ca/uploads/origins/4d2b120d-6af9-4b3e-a966-7e6006c96eb1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=6d4e405f353471945d2d8dcd8194f4a0 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/b6a797ca/uploads/origins/4d2b120d-6af9-4b3e-a966-7e6006c96eb1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e74e808c9d1c5a2b17ebde76d1080891", "srcset": "https://si.imgix.net/b6a797ca/uploads/origins/4d2b120d-6af9-4b3e-a966-7e6006c96eb1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e74e808c9d1c5a2b17ebde76d1080891, https://si.imgix.net/b6a797ca/uploads/origins/4d2b120d-6af9-4b3e-a966-7e6006c96eb1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=13862c29e843f72e2144894d0fd097f5 2x, https://si.imgix.net/b6a797ca/uploads/origins/4d2b120d-6af9-4b3e-a966-7e6006c96eb1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=85f9107f1e9b63ab003efd50d5a684b6 3x"}, "body": "こんにちは、\n\nはじめまして。同じファイナルファンタジー、そして腐敗ファンとして、以前からあなたの作品に興味を持っていました。私の好きな古典的なFFキャラクターの一人の絵を依頼したいと思います。\n\nFF4のリディアの絵をお願いしたいのですが、普段の服装を反映したボディコン風の服装でお願いします。リディアが邪悪で魅惑的な表情を浮かべながら、見る人に体を差し出しているような、お尻にフォーカスしたものを希望します。最後の召喚士は、今やゼロムスの手下の快楽のための玩具となっている。\n\nご検討のほど、よろしくお願いします。\n\n参考文献\nhttps://drive.google.com/drive/folders/1G12GlQ0_oXATgUBmbdKq2PwBi6LpH9Tb", "nc": 49, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@yamimochi/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3187904, "client_id": 713359, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/6f771650/uploads/origins/38fc03e4-a0cf-43e9-a582-e24aab371a16?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f7113ca3f07d385ea08d9fbd3749f268", "srcset": "https://si.imgix.net/6f771650/uploads/origins/38fc03e4-a0cf-43e9-a582-e24aab371a16?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f7113ca3f07d385ea08d9fbd3749f268, https://si.imgix.net/6f771650/uploads/origins/38fc03e4-a0cf-43e9-a582-e24aab371a16?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=25ebaec2dbecb03da943f598110d06ad 2x, https://si.imgix.net/6f771650/uploads/origins/38fc03e4-a0cf-43e9-a582-e24aab371a16?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=08fc1b43da855502190a148d6affb337 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/6f771650/uploads/origins/38fc03e4-a0cf-43e9-a582-e24aab371a16?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=df5b939aae1f31547b7043577b048cd5", "srcset": "https://si.imgix.net/6f771650/uploads/origins/38fc03e4-a0cf-43e9-a582-e24aab371a16?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=df5b939aae1f31547b7043577b048cd5, https://si.imgix.net/6f771650/uploads/origins/38fc03e4-a0cf-43e9-a582-e24aab371a16?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=77fe8e5d64e01eca941398cba506fe85 2x, https://si.imgix.net/6f771650/uploads/origins/38fc03e4-a0cf-43e9-a582-e24aab371a16?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=1dc63a87c4be8a825fc2fcafdb2ca598 3x"}, "body": "闇餅先生、こんにちは。先生、こんにちは。『ダンダン』に登場するキャラクター 綾瀬もも のイラストを描いていただきたいです。綾瀬もも は セルポステリン によって完全に洗脳されています。前髪の下には緑色の逆三角形の洗脳チップが埋め込まれており、かすかに赤い光を放ち、顔には邪悪なメイクが施されています。紫のアイシャドウと紫の口紅、首には革の首輪、耳には象徴的なイヤリング、ピンクのオフショルダーでへそ出しの革ブラジャー、乳首にはほんのりと赤く光る乳首、へそにはダイヤモンド型の緑色のチップが埋め込まれています。左足の付け根には革のレッグリング、足元にはワンストラップのハイヒールサンダル、手足の爪には黒いマニキュアが塗られ、片手で敬礼をし、邪悪な笑みを浮かべた直立不動の姿勢をとっています。画面右上の illust/120525197 のような、キャラクターのお尻が描かれたイラストを描きたいです。キャラクターの肛門には、エメラルドがちりばめられた洗脳用のアナルプラグが詰め込まれていて、不思議な光を放っています。料金が適切でないと思われる場合は、依頼を辞退してください。", "nc": 56, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@yamimochi/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3187904, "client_id": 97802, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/1e5ca586/uploads/origins/9e31a3bb-c811-4d90-92d4-7e9ae16e0595?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=245097149e46a0bdbe095086065d0054", "srcset": "https://si.imgix.net/1e5ca586/uploads/origins/9e31a3bb-c811-4d90-92d4-7e9ae16e0595?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=245097149e46a0bdbe095086065d0054, https://si.imgix.net/1e5ca586/uploads/origins/9e31a3bb-c811-4d90-92d4-7e9ae16e0595?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e8e8157aec5647b9356040b2c83fe8e9 2x, https://si.imgix.net/1e5ca586/uploads/origins/9e31a3bb-c811-4d90-92d4-7e9ae16e0595?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=8d0b2fca8b8c0119e762eb75ebaf3981 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/1e5ca586/uploads/origins/9e31a3bb-c811-4d90-92d4-7e9ae16e0595?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ffa884db46456dcef3d5d7d012dc2b97", "srcset": "https://si.imgix.net/1e5ca586/uploads/origins/9e31a3bb-c811-4d90-92d4-7e9ae16e0595?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ffa884db46456dcef3d5d7d012dc2b97, https://si.imgix.net/1e5ca586/uploads/origins/9e31a3bb-c811-4d90-92d4-7e9ae16e0595?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=4ed8d6e48a22f59fd4c2e42b48b52f76 2x, https://si.imgix.net/1e5ca586/uploads/origins/9e31a3bb-c811-4d90-92d4-7e9ae16e0595?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=01dee64c8124f7d163f8b8c42e68779b 3x"}, "body": "闇餅様、お久しぶりで御座います。\n先日は素晴らしい作品を誠に有難う御座いました。\n今一度リクエストさせて頂きます。\n\n以前、竜帝の依代にされ悪堕ちしたアンジェラ(竜帝アンジェラ)を描いて下さりましたが、アンジェラと竜帝の魂の融合シーンを宜しくお願いします。\n\n具体的にはアンジェラ肉体の変貌がほぼ完了しており、竜帝が同化の最後の仕上げとしてアンジェラと竜帝の魂の融合を行おうとしてます。\n該当シーンは竜帝アンジェラの立ち絵の後ろの背景に二人の魂が描写されるようお願い致します。\n二人の魂の描写はボヤけた輪郭の描写を希望致します。表情やその他姿等詳細には記さないようお願い致します。\nアンジェラの魂は人間の女性の形か球体状、竜帝の魂は竜の形か球体状にて宜しくお願いします。\n融合シーンは基本的にはお任せ致しますが、融合を感じられる様お願いします。\n\n描写例\n・竜帝の魂がアンジェラの魂を包み込む\n・竜帝の魂が蛇状になりアンジェラの魂に絡みつく\n・アンジェラの魂に竜帝の魂が突進し入り込む\n・竜帝の魂から触手状のモノが出てアンジェラの魂に刺し込んで自らを注ぎ込む\n\nこれらはあくまで例であり融合を感じさせられれば例より外れても構いません。\n\n差分として同化完了のシーンで竜人の女の輪郭を持つ竜帝アンジェラの魂の描写も希望致します。\n立ち絵の竜帝アンジェラの表情は\n・抵抗している(若しくは泣いてる)顔→恍惚とした顔\n・恍惚とした顔→邪悪な笑みを浮かべてる顔\nの何れかをお願い致します。\n\n若し、コスト的に余裕があればですが\n・抵抗している(若しくは泣いてる)顔→恍惚とした顔→邪悪な笑みを浮かべてる顔\nの三段階を希望致しますがあくまで余裕がある場合のみでお願いします。\n逆にコスト的に厳しい場合は恍惚とした顔の竜帝アンジェラと魂の融合シーンのみでお頼み申し上げます。\n\nその際にご自由にアレンジして頂いて構いません。\n報酬が割に合わないと思いましたら再送を御願い致します。\n不都合があれば完全キャンセルして構いません。\n\n闇餅様には竜帝アンジェラを描いて下さってより他の方に竜帝アンジェラを描いて頂く際に参照資料として使用させて頂き感謝の言葉も御座いません。\nこの他は御礼の代わりとして依頼させて頂きます。\nどうか御検討御願い致します。", "nc": 33, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@yamimochi/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3187904, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/988dc6f5/uploads/origins/ab9c11ce-6d95-46a4-ba69-1e720da2da1f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c4bcc2d31fb004604e34247586e80810", "srcset": "https://si.imgix.net/988dc6f5/uploads/origins/ab9c11ce-6d95-46a4-ba69-1e720da2da1f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c4bcc2d31fb004604e34247586e80810, https://si.imgix.net/988dc6f5/uploads/origins/ab9c11ce-6d95-46a4-ba69-1e720da2da1f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=354876b79748bc6d064f61ce0a71c131 2x, https://si.imgix.net/988dc6f5/uploads/origins/ab9c11ce-6d95-46a4-ba69-1e720da2da1f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=6f6845880e4b6126b2addf8ee2c4a97d 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/988dc6f5/uploads/origins/ab9c11ce-6d95-46a4-ba69-1e720da2da1f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e3df86a20b28df59420c14f1ce7fb759", "srcset": "https://si.imgix.net/988dc6f5/uploads/origins/ab9c11ce-6d95-46a4-ba69-1e720da2da1f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e3df86a20b28df59420c14f1ce7fb759, https://si.imgix.net/988dc6f5/uploads/origins/ab9c11ce-6d95-46a4-ba69-1e720da2da1f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=0d084256e3df8bdf2add24fb56c627c9 2x, https://si.imgix.net/988dc6f5/uploads/origins/ab9c11ce-6d95-46a4-ba69-1e720da2da1f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=139ded07a42935c70566d66067b19341 3x"}, "body": "闇餅さん、あなたのアートワークはとても好きです。そのため、今回は原稿の依頼をお願いしたいと思います。作品は『犬夜叉』のキャラクター、日暮かごめを題材にしたいと思います。彼女は悪の桔梗によって洗脳され、悪の高校生の娘に変わりました。そして、彼女は胸の真ん中に悪の力で黒く染まった四魂の玉を埋め込まれ（象嵌の具体的な手順については、作品を参照してください。illust/100156730），指に黒いネイルを塗り、できればウエストピアスやニップルリングなどのアクセサリーを身に着け、顔には紫色のアイシャドウと黒いリップを塗り、悪の微笑みを浮かべています。服装に関しては、暗黒や悪のデザインがよろしいです。さらに、彼女の体から紫色の輝きを放つらせてください。もし報酬に不満があったら、返送してもらってもいいですよ。", "nc": 185, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@yamimochi/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3187904, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/8a3045b9/uploads/origins/44d9e7ae-c683-4da6-b58d-3282cd104482?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f7390f73170aadbb102c9f7f6931e01d", "srcset": "https://si.imgix.net/8a3045b9/uploads/or