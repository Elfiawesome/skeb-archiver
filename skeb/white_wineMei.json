amount": 10000}], "acceptable_only_public": false, "tip_acceptable": true, "yearly_report_client_visible": false, "total_appeals_count": 0, "received_works": [{"path": "/@white_wineMei/works/10", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 348890, "client_id": 2361019, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/45a255a0/uploads/origins/f4ad36a2-7774-49c4-a9e3-13f7a2d0ea17?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f56995b9a66a509b997490871555cf48", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/45a255a0/uploads/origins/f4ad36a2-7774-49c4-a9e3-13f7a2d0ea17?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ae71401c72ce006826cf62d3dd0fe884", "src_set": ""}, "body": "お互いの体液が染み込んだパンツを交換する封獣ぬえとふたなり赤蛮奇の漫画をお願いいたします。\n以下流れ\n密着してキスしながらお互いにパンツの上から相手の股間を愛撫するぬえと蛮奇。同タイミングで絶頂し、パンツ越しに精液と愛液が漏れ出る。今日はこれで終わるかと思いきやぬえがお互いの体液が染み込んだパンツを交換しようと提案する。難色を示しながらも提案を受け入れパンツを交換する蛮奇。パンツを受けとると染み込んだ体液の重さを感じ、履こうとする際に中でまだ匂いの残る体液を見てムラムラする二人。履いた瞬間に相手の体液を直接股間に感じ更にムラムラ。蛮奇に至ってはスカート越しでもわかるくらいに勃起してしまう。このまま二人で出かけようと提案するぬえとそれにしぶしぶ応じる蛮奇。人里でドキドキしながら手を繋ぎ歩く二人。下から見たアングルではお互いの体液がパンツから垂れ滴っている。", "nc": 48, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@white_wineMei/works/9", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 348890, "client_id": 0, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/932bf7ef/uploads/origins/bddcc0ea-f310-4865-914b-0c177a3bb103?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e132741676a12b0af946f264c0f2d79d", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/932bf7ef/uploads/origins/bddcc0ea-f310-4865-914b-0c177a3bb103?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=da26c39751bb15c27e50c9f8770b9ec6", "src_set": ""}, "body": "ご依頼いたします。\n産卵したわかさぎ姫にふたなりの影狼ちゃんが精液をぶっかけするシチュエーションを描いていただきたいです。\n構図などはお任せしたいですが、過去に描かれたわかさぎ姫の脇腹のヒレなどの人魚的な特徴が好みだったのであるとありがたいです。\nご検討よろしくお願いします。", "nc": 177, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@white_wineMei/works/8", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/e7a02710/uploads/origins/30acedf2-6927-4da1-a269-d79a1f7ca1a4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=b89b28e1f7e49c78c7c19683f89c883a", "src_set": ""}, "private": true, "genre": "art", "tipped": true, "creator_id": 348890, "client_id": 0, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 177, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@white_wineMei/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 348890, "client_id": 1094212, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/dd3c9f3f/uploads/origins/fecc6032-50e6-4d7a-b808-33e22c5f5a6c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=764ebc7775253a4139ed10cb2763bf74", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/dd3c9f3f/uploads/origins/fecc6032-50e6-4d7a-b808-33e22c5f5a6c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=44f074e3dc43d92e816fe594a6c23961", "src_set": ""}, "body": "初めまして、偶然ドレミーさんの絵を見かけて絵柄が好みだったので依頼してみたいと思いました。早速ですが依頼の話をしていきたいと思います\n\n東方Projectの東方神霊廟のキャラクターの幽谷響子のラブラブなH絵をお願いします\n\n流れ的には①寝転がって足を開いた響子がおねだり\n②パンツを脱がされ受け入れ態勢\n③挿入④ピストン⑤中出し\n⑥大量に出して精液が溢れてくる\n⑦膣にお札、絆創膏、パンツなどで