ation": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/f71786c5/uploads/origins/13213c70-0c05-48d7-80a4-597342b6d5d3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d8ad318450b5550d748b961bef818d4b", "srcset": "https://si.imgix.net/f71786c5/uploads/origins/13213c70-0c05-48d7-80a4-597342b6d5d3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d8ad318450b5550d748b961bef818d4b, https://si.imgix.net/f71786c5/uploads/origins/13213c70-0c05-48d7-80a4-597342b6d5d3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=cdce691c1a6019bf992b98a0cc60a04b 2x, https://si.imgix.net/f71786c5/uploads/origins/13213c70-0c05-48d7-80a4-597342b6d5d3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=f5d0260cb24c8e109ba502f2051abc41 3x"}, "body": "先日アナログ絵をご依頼させて頂いた者です。\n可愛いステッカーと名刺のおまけまでありがとうございました。本当に嬉しかったです。\n実は以前デザインしていただいた「おもい」というアイドルが彼女とお友達なので、ステッカーのSDキャラと同じ絵柄のおもいをお願いしたいです。\n衣装は二人が一緒に写っている絵の方でお願い致します。\n配信者さん等ではなく拡散力がなく申し訳ないのですが、5年前からずっとNIA様の絵が大好きです。単色で緻密な線も、ミニマルで可愛らしい絵も両方大好きです。\n金額は、ささやかですがステッカーと日頃素敵な絵を無料で見せて頂いているお礼です。\n金銭的に余裕ができたらいつか個展などに足を運びたいと思っております。\n微力ながらこれからも応援しています。\nどうかお身体にお気を付けてお過ごしください。\n\nhttps://drive.google.com/drive/folders/1-W25-DfYoGzdoIABco0r6itI35U5yllN\n\nhttps://drive.google.com/drive/folders/1-W25-DfYoGzdoIABco0r6itI35U5yllN", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@nia5710/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2782636, "client_id": 3281121, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/80c6e4da/uploads/origins/e1d89f9f-3417-4143-b06e-6591b948789a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fc26bbf2c44c492b5df6d968098f8158", "srcset": "https://si.imgix.net/80c6e4da/uploads/origins/e1d89