igins/39c8c685-d5c0-45ba-ba74-49222d63aa5e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=00e58ba21356d7b0f108be00f33368fc", "srcset": "https://si.imgix.net/065e4ffe/uploads/origins/39c8c685-d5c0-45ba-ba74-49222d63aa5e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=00e58ba21356d7b0f108be00f33368fc, https://si.imgix.net/065e4ffe/uploads/origins/39c8c685-d5c0-45ba-ba74-49222d63aa5e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=ac79ee6b692230c0868b18f2bfba3bd9 2x, https://si.imgix.net/065e4ffe/uploads/origins/39c8c685-d5c0-45ba-ba74-49222d63aa5e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=b6c4f9134ccc3a38c2798ff9c9c79a21 3x"}, "private": true, "genre": "art", "tipped": false, "creator_id": 2782636, "client_id": 3268497, "nc": 0}, {"path": "/@nia5710/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2782636, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/9d65d9d2/uploads/origins/b13ad910-e662-47f1-8d4e-f884c5a9e25c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5d04a15e6f93de3e4f27ebc6ef874d9a", "srcset": "https://si.imgix.net/9d65d9d2/uploads/origins/b13ad910-e662-47f1-8d4e-f884c5a9e25c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5d04a15e6f93de3e4f27ebc6ef874d9a, https://si.imgix.net/9d65d9d2/uploads/origins/b13ad910-e662-47f1-8d4e-f884c5a9e25c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=25502e11d72f46dd3730ef7ee9ae9312 2x, https://si.imgix.net/9d65d9d2/uploads/origins/b13ad910-e662-47f1-8d4e-f884c5a9e25c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=fe20a25f9f022b9a20336b974db4d087 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/9d65d9d2/uploads/origins/b13ad910-e662-47f1-8d4e-f884c5a9e25c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=68be74328d2f19e522cf0cc66349f56c", "srcset": "https://si.imgix.net/9d65d9d2/uploads/origins/b13ad910-e662-47f1-8d4e-f884c5a9e25c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=68be74328d2f19e522cf0cc66349f56c, https://si.imgix.net/9d65d9d2/uploads/origins/b13ad910-e662-47f1-8d4e-f884c5a9e25c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=bca339f565d9f981da5833c41562577e 2x, https://si.imgix.net/9d65d9d2/uploads/origins/b13ad910-e662-47f1-8d4e-f884c5a9e25c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=901cd7a073fae24d53e36ccf14da3603 3x"}, "body": "We would like you to draw three idol units of original characters.\n\nUnit theme: dolls, idols, machines\n\nFirst (center): Inochi\nBlack, long hair to waist level, bangs are thin, just over the eyes, slicked back to the left side, with a princess cut.\nEyes: Vivid red, pinched, large, with long eyelashes.\nCostume: Gothic Lolita, black and red, Western doll image.\nPersonality: Bright, loves cute things, smiles a lot, best friends with Mariya\n\nSecond: Mariya\nHair: White, bob cut just below the shoulders, see-through bangs to just below the eyebrows, hair on the sides of the bangs not hanging over the ears\nEyes: Sky-blue, slanted, with long lower lashes.\nShe has a mole on the right side of her mouth.\nCostume: A white and light blue version of Inochi's costume, with the image of an angel (I want to incorporate wings somewhere).\nPersonality: Calm and natural, objective to everyone, good friend of Inochi and Inochi\n\nThird: Omoi\nHair: Gray, up to the chest area, inwardly curled in layers, M-shaped bangs, crossed in the middle, layered cut around the face.\nEyes: Saturated purple with glazed eyes and long lower lashes.\nCostume: A gray and purple version of Inochi's costume, with an androgynous image.\nPersonality: A little twisted and quiet, she has a distorted desire for her best friend, like faith.\n\nI love Meisuke-sama's sense of style, so I would like to leave the costume design, colors, composition, etc. to her.\nI apologize for the length of this essay.\nIf it is possible, I would appreciate it very much.", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@nia5710/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2782636, "client_id": 2754616, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/1aba1cdd/uploads/origins/fe80c710-b5bc-48d1-9df2-3c8e41beb503?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9b5481f00375bf642890d9ed7e5b86cd", "srcset": "https://si.imgix.net/1aba1cdd/uploads/origins/fe80c710-b5bc-48d1-9df2-3c8e41beb503?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9b5481f00375bf642890d9ed7e5b86cd, https://si.imgix.net/1aba1cdd/uploads/origins/fe80c710-b5bc-48d1-9df2-3c8e41beb503?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=8b665490aee2b551e81ed69c68da674c 2x, https://si.imgix.net/1aba1cdd/uploads/origins/fe80c710-b5bc-48d1-9df2-3c8e41beb503?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=40c4d24d3e79ffbd4fd4095700215126 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/1aba1cdd/uploads/origins/fe80c710-b5bc-48d1-9df2-3c8e41beb503?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=66b97a2c8ec86cd1adbdf2219faa644c", "srcset": "https://si.imgix.net/1aba1cdd/uploads/origins/fe80c710-b5bc-48d1-9df2-3c8e41beb503?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=66b97a2c8ec86cd1adbdf2219faa644c, https://si.imgix.net/1aba1cdd/uploads/origins/fe80c710-b5bc-48d1-9df2-3c8e41beb503?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=43f46938cbb0169a30937c445ab38dd4 2x, https://si.imgix.net/1aba1cdd/uploads/origins/fe80c710-b5bc-48d1-9df2-3c8e41beb503?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=69510e91908b901786c86c118cb96da4 3x"}, "body": "Hello! I really like your SD character art. I'd like to request one of my character, Nep.\nHe is a wolf boy with a flirty personality. I would like him to be smiling and have a confident pose.\nPlease include a version with a transparent background. Thank you.\nhttps://drive.google.com/file/d/1U3T9_ejShQbm9b2DY4E5e4B-Yv5EKEYG/view?usp=sharing\n\nhttps://drive.google.com/file/d/1U3T9_ejShQbm9b2DY4E5e4B-Yv5EKEYG/view?usp=sharing", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@nia5710/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2782636, "client_id": 2981951, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/672f47e0/uploads/origins/c8a6184b-0296-4113-bd7a-8a954df4d53c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=34e8b62c5537d9c3cedaefde90ed4ed9", "srcset": "https://si.imgix.net/672f47e0/uploads/origins/c8a6184b-0296-4113-bd7a-8a954df4d53c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=34e8b62c5537d9c3cedaefde90ed4ed9, https://si.imgix.net/672f47e0/uploads/origins/c8a6184b-0296-4113-bd7a-8a954df4d53c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=354b8fbbd4624d6ecf84127353bed2a4 2x, https://si.imgix.net/672f47e0/uploads/origins/c8a6184b-0296-4113-bd7a-8a954df4d53c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b567c89e595ea1281cdb6bd11f9e82b7 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/672f47e0/uploads/origins/c8a6184b-0296-4113-bd7a-8a954df4d53c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e8988e0af857e3dcbb82b9e6c8c76c07", "srcset": "https://si.imgix.net/672f47e0/uploads/origins/c8a6184b-0296-4113-bd7a-8a954df4d53c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e8988e0af857e3dcbb82b9e6c8c76c07, https://si.imgix.net/672f47e0/uploads/origins/c8a6184b-0296-4113-bd7a-8a954df4d53c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=64417ad44974e5c5680d3c02eaa67024 2x, https://si.imgix.net/672f47e0/uploads/origins/c8a6184b-0296-4113-bd7a-8a954df4d53c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=3c626578bf364a376bf0a2eb17e80be5 3x"}, "body": "It is nice to meet you!\nI love your illustrations and would love to have you as my illustrator.\n\nI would like to have a one-picture illustration and a two-headed miniature character!\n\nOne-picture\nI would like you to draw a figure lying down as shown in the sample. I want to make it a Cheki-style image, so please draw it in 3:4 size.\nI like the hands that Mr. Niai draws, so I would be happy if you could draw her lying down with her cheekbones on her head. Please make it a grinning expression. A window in the background would be nice (a simple outline of light only would be fine).\n\nMini-Character\nI would like the character in the reference image to be a two-headed mini character.\nPlease make the pose similar to the reference image.\nThe character should have a smiling expression with an open mouth.\nIt would be nice if the background is transparent.\n\nThat's all. I have always loved Mr. Niai's illustrations, so I am very happy to be able to work with him.\nI would like to use your illustrations in my app IRIAM, as well as in my header and icons.\n\nIf your illustration does not meet our requirements, you can cancel your order.\nThank you very much for your consideration.\n\nhttps://drive.google.com/drive/folders/1-5qcI6pntjC6I_jnfXBEvXScSIitc0S2", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [{"path": "/@oniku_seiniku/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3300365, "client_id": 2782636, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/8334fbde/uploads/origins/dd56471a-29e4-4f85-9071-8f5845f7fba1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2d7c016d1ed2f4ae489941bf46b74032", "srcset": "https://si.imgix.net/8334fbde/uploads/origins/dd56471a-29e4-4f85-9071-8f5845f7fba1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2d7c016d1ed2f4ae489941bf46b74032, https://si.imgix.net/8334fbde/uploads/origins/dd56471a-29e4-4f85-9071-8f5845f7fba1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=8915cee41dc707976996eb4a22d911ed 2x, https://si.imgix.net/8334fbde/uploads/origins/dd56471a-29e4-4f85-9071-8f5845f7fba1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=af5f608ab0c4a9e42b7f5d29b6225e16 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/8334fbde/uploads/origins/dd56471a-29e4-4f85-9071-8f5845f7fba1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=18d1cc2b278fb570130edfb8b8a3b48e", "srcset": "https://si.imgix.net/8334fbde/uploads/origins/dd56471a-29e4-4f85-9071-8f5845f7fba1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=18d1cc2b278fb570130edfb8b8a3b48e, https://si.imgix.net/8334fbde/uploads/origins/dd56471a-29e4-4f85-9071-8f5845f7fba1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=7b18cc2745ee95e5add0e11ca4c425dd 2x, https://si.imgix.net/8334fbde/uploads/origins/dd56471a-29e4-4f85-9071-8f5845f7fba1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=ec40dc15e27551271d7d66848100e812 3x"}, "body": "はじめまして、NiAと申します。\n今田さんのテラコッタ、イラストの作品を拝見してぜひイラストを描いていただきたいと思いご連絡いたしました。\n\n描いていただきたいキャラクターは、私の漫画作品【僕とヤミ】に登場する主人公です。\n(Twitterのリンクで失礼します)\nhttps://x.com/nia5710/status/1813140638541750395?s=46&t=LPpLkolVJuuUnjiPhRXj_w\n黒髪で猫耳としっぽがあり、上下白のとっくりのあるスウェットを着ています。\n特徴が少ないキャラクターですので、描きにくいかと思います。\n今田さんの描きやすいように描いていただいて構いません。\n今田さんの造形する横顔がとても美しいと思っています。鼻筋がスッと通っていて、ラインが美しいです。今回のイラストは横顔をお願いします。(横顔が入っていれば、顔だけ、またはバストアップどちらでも可です。)\n\nよろしくお願いいたいします！\n\nhttps://x.com/nia5710/status/1813140638541750395?s=46&t=LPpLkolVJuuUnjiPhRXj_w", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "similar_creators": [{"id": 587400, "creator": true, "nsfw_acceptable": false, "acceptable": false, "name": "片目隠れ屋さん🔥", "screen_name": "nmti_kz", "avatar_url": "https://pbs.twimg.com/profile_images/1969511854688124928/d2QzY3J0.jpg", "header_url": "https://pbs.twimg.com/profile_banners/3167208140/1681625212/1500x500", "appeal_receivable": true, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 90, "skills": [{"genre": "art"}], "banned": false, "nc": 0}, {"id": 1102656, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "犬のおしり", "screen_name": "inu_shiori", "avatar_url": "https://pbs.twimg.com/profile_images/1258929374834745344/YGzkNMcO.jpg", "header_url": "https://pbs.twimg.com/profile_banners/916534054010228736