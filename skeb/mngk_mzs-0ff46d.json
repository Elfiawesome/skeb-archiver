200&h=200&s=729c7621d633e13080c677f73e7b1a71, https://si.imgix.net/281011d6/uploads/origins/cac2b7a6-d093-4f59-94bb-df55990f2528?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e5d1fc91bac0e48135bf3ecab89b915b 2x, https://si.imgix.net/281011d6/uploads/origins/cac2b7a6-d093-4f59-94bb-df55990f2528?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ad487291c0d6ef7501acf0a923d54bbd 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/281011d6/uploads/origins/cac2b7a6-d093-4f59-94bb-df55990f2528?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5f5caf4ae599556ba191b1c78c6ba1c4", "srcset": "https://si.imgix.net/281011d6/uploads/origins/cac2b7a6-d093-4f59-94bb-df55990f2528?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5f5caf4ae599556ba191b1c78c6ba1c4, https://si.imgix.net/281011d6/uploads/origins/cac2b7a6-d093-4f59-94bb-df55990f2528?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=37ce89df498c2f3867acf6e6dbd2da19 2x, https://si.imgix.net/281011d6/uploads/origins/cac2b7a6-d093-4f59-94bb-df55990f2528?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=90104edef02331950b83671b8eae2df0 3x"}, "body": "はじめまして！Fanbox加入し素敵な作品拝見して、お世話になっております…濃厚な漫画描写が大好きです。\n手数料無料期間も始まりましたので、この機会にぜひお願いしたく…\n\nよろしければにじさんじの郡道先生のモノクロ漫画形式作品をお願いできますでしょうか…？\n\n衣装：URL一番左、下着は黒のブラとショーツ\nhttps://twitter.com/g9v9g_mirei/status/1356196131076775937\n体型：身長168cm(ヒール込175cm)、バストは公式Cカップなので程よい美乳で、毛の有無はおまかせいたします。\n\nお相手は夜遊び上手な生徒くんですが裸モブ風、多少見切れて見えない、ぼかしetc…OKで、見える場合見た目チャラいか普通か…のキャラ付けはおまかせいたします。\n\n以下、細かい希望シチュエーションになります。\n\n・前置きとして「夜遊び激しい生徒くんを注意したところ、Hテク自慢で煽られたため対決で白黒つける事に…」\n\n・学校のどこかの一角(施錠済)で、煽られた先生が逆に煽り返すように生徒に対してスーツを着崩し始めるなどの色仕掛けを始める…若干興奮する生徒くんに対し「あれぇ？先生じゃ抜けないんじゃないのぉ？」と\n\n・生徒くんのデカチンに多少驚きつつ、序盤は先生が攻め攻めで手コキとフェラでまずは抜き勝ちます\n\n・勝ったか？と先生は一度安堵しますが、生徒に手マンで反撃され先生も達してしまう\n\n・まだ少し余裕がある先生だがついに本番、まだまだ全然萎えない生徒くんに生で挿入され…絶倫とデカチン、テクの前にだんだん余裕がなくなり最後にはヘロヘロになってイカサレまくり…\n\n・なかなか堕ちず抵抗はしつつも全く余裕のない郡道先生、最後には意識飛びかけで中出しされ快楽堕ちしてしまい負けてしまう…\n\n・放心した先生を後に生徒は勝ち誇って退散、先生は内心少しクセになりそうな自分に驚きつつ、リベンジを考える…\n\n先生は全体的に強気でヤリ慣れたテクに自信ありげに攻めつつ\n攻められちゃうと「負けたくない…でも感じちゃう…」な感じ\n男は基本的にはテクに自信があって反撃したがりな感じで\n\nらむだ様に初めてお願いするので無理な内容でしたらすみません…\n難しいor金額等見合わないようであれば\n多少内容を改変or削っていただいて構いません。\n何卒ご検討お願い申し上げます。", "nc": 177, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@mngk_mzs/works/8", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/00490fc7/uploads/origins/787f9dd9-8e9a-43c5-9545-d9a6f116f0f3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=a8e3e6c857c7ba21a90d34b2ff5b71cc", "srcset": "https://si.imgix.net/00490fc7/uploads/origins/787f9dd9-8e9a-43c5-9545-d9a6f116f0f3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=a8e3e6c857c7ba21a90d34b2ff5b71cc, https://si.imgix.net/00490fc7/uploads/origins/787f9dd9-8e9a-43c5-9545-d9a6f116f0f3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=2eb9985c6f31d2acc800de9742d6524e 2x, https://si.imgix.net/00490fc7/uploads/origins/787f9dd9-8e9a-43c5-9545-d9a6f116f0f3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=5e28f31333a4efd98ae910eb3419c58f 3x"}, "private": true, "genre": "art", "tipped": true, "creator_id": 967178, "nc": 177}, {"path": "/@mngk_mzs/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 967178, "client_id": 339181, "vtt_url": null, "