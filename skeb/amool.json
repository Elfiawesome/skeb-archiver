ラストのようなライディングスタイルでお願いしたいです。\n（特にハイカットの網紐ブーツが素敵です…！）\n上着はフード付きシェルで、女の子らしいやや明るめの色味などでお願いします。\n\n◆納品\nPSDとPNG形式でお願いします。\n\nご検討いただけますと幸いです。\nよろしくお願いいたします。\n\nhttps://twitter.com/silas_012/status/1624678045637550083?s=20", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@amool/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 602119, "client_id": 910082, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/bd0f1c9b/uploads/origins/2791d437-615d-4f77-ab48-018e99516e1e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8e206ddf6d882fe4840fef2c578153e6", "srcset": "https://si.imgix.net/bd0f1c9b/uploads/origins/2791d437-615d-4f77-ab48-018e99516e1e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8e206ddf6d882fe4840fef2c578153e6, https://si.imgix.net/bd0f1c9b/uploads/origins/2791d437-615d-4f77-ab48-018e99516e1e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b7d8c3620aac24d42a8fb35baa5c06a7 2x, https://si.imgix.net/bd0f1c9b/uploads/origins/2791d437-615d-4f77-ab48-018e99516e1e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a4aa097d68074fa8f266fde1ca244c97 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/bd0f1c9b/uploads/origins/2791d437-615d-4f77-ab48-018e99516e1e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5d0fee45b9ade0ad0e6cd455ced88a1f", "srcset": "https://si.imgix.net/bd0f1c9b/uploads/origins/2791d437-615d-4f77-ab48-018e99516e1e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5d0fee45b9ade0ad0e6cd455ced88a1f, https://si.imgix.net/bd0f1c9b/uploads/origins/2791d437-615d-4f77-ab48-018e99516e1e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=860a9becc8493df2