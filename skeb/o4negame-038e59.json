itter, Twitch, and Youtube!\nThank you in advance!\n\nhttps://cdn.discordapp.com/attachments/802899699580272641/866895518541545522/Hoodie_Template.png\n\nhttps://cdn.discordapp.com/attachments/802899699580272641/859956994592604181/Reference.png", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@o4negame/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1431426, "client_id": 869288, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/f781a09c/uploads/origins/6a171db0-46b5-45b4-8e6b-81e05b00c005?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d282ba640fe220b8d0b2925d506f9c30", "srcset": "https://si.imgix.net/f781a09c/uploads/origins/6a171db0-46b5-45b4-8e6b-81e05b00c005?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d282ba640fe220b8d0b2925d506f9c30, https://si.imgix.net/f781a09c/uploads/origins/6a171db0-46b5-45b4-8e6b-81e05b00c005?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=819228813649873e64f5311b541b61e1 2x, https://si.imgix.net/f781a09c/uploads/origins/6a171db0-46b5-45b4-8e6b-81e05b00c005?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d6ddfff6267e4b53175206ce54dad201 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/f781a09c/uploads/origins/6a171db0-46b5-45b4-8e6b-81e05b00c005?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=7476615fc46484cca939775bce6e34f1", "srcset": "https://si.imgix.net/f781a09c/uploads/origins/6a171db0-46b5-45b4-8e6b-81e05b00c005?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=7476615fc46484cca939775bce6e34f1, https://si.imgix.net/f781a09c/uploads/origins/6a171db0-46b5-45b4-8e6b-81e05b00c005?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=2