op&crop=top&w=200&h=200&s=a92af8a6f2b1a27d2191d22f0bb297d7 2x, https://si.imgix.net/f7036294/uploads/origins/1691796a-718c-4cf1-8ea5-b87a746d10a1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=1bab5e2ed3f275cb74be97c6755730a1 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/f7036294/uploads/origins/1691796a-718c-4cf1-8ea5-b87a746d10a1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=558ae956e530c3fe889441a64fe26a9c", "srcset": "https://si.imgix.net/f7036294/uploads/origins/1691796a-718c-4cf1-8ea5-b87a746d10a1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=558ae956e530c3fe889441a64fe26a9c, https://si.imgix.net/f7036294/uploads/origins/1691796a-718c-4cf1-8ea5-b87a746d10a1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=aec81711cf51b0e11863bb12badc51f6 2x, https://si.imgix.net/f7036294/uploads/origins/1691796a-718c-4cf1-8ea5-b87a746d10a1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=d7ced269678ec03213c762f8c4bbfcd9 3x"}, "body": "こんにちは。\n\n私の風船の悪魔キャラクター「ロロ」のリデザインをお願いできないでしょうか。\n\n身長は143cmで、鋭い歯を持っています。\nへそのあたりに空気弁があります。\n\n少し生意気で、ユーモアのセンスがちょっと変です。\n\n普段はコンビニで働いていることが多いですが、最近はファンタジー色のある異世界で家族が経営する店を手伝っているため、自由にクリエイティブな発想で描いてください。\n\n彼女をショタ少年としてリデザインしてほしいです。\n\nコンセプトとしては、誤って男の子になってしまい、しばらくその状態でいるうちに新しい体を前向きに受け入れているという設定です。\n\n衣装については、もともと男の子だったような雰囲気を保ちつつ、元の衣装の要素をほんの少し取り入れてリデザインしていただけると嬉しいです。\n\nデザインに関しては、クリエイターの裁量にお任せします。\n\nhttps://bsky.app/profile/rorotte.bsky.social/post/3k5j3blftko23", "nc": 152, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@hemogi08/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3929494, "client_id": 3616120, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/d6b34912/uploads/origins/613becb2-011e-4f9d-b1aa-154f1665b13d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7c0165f5a221439e6600aff1be3931c9", "srcset": "https://si.imgix.net/d6b34912/uploads/origins/613becb2-011e-4f9d-b1aa-154f1665b13d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7c0165f5a221439e6600aff1be3931c9, https://si.imgix.net/d6b34912/uploads/origins/613becb2-011e-4f9d-b1aa-154f1665b13d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=51070aa9b655e3369be1422ecea5a615 2x, https://si.imgix.net/d6b34912/uploads/origins/613becb2-011e-4f9d-b1aa-154f1665b13d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d1248f198a28fd1cdec26453f53fadbc 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/d6b34912/uploads/origins/613becb2-011e-4f9d-b1aa-154f1665b13d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=7c9662d3982b0a5cdac12a6d6b882ef4", "srcset": "https://si.imgix.net/d6b34912/uploads/origins/613becb2-011e-4f9d-b1aa-154f1665b13d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=7c9662d3982b0a5cdac12a6d6b882ef4, https://si.imgix.net/d6b34912/uploads/origins/613becb2-011e-4f9d-b1aa-154f1665b13d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=70bff05cd027c49800c9759fb8381081 2x, https://si.imgix.net/d6b34912/uploads/origins/613becb2-011e-4f9d-b1aa-154f1665b13d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=bb1c2a51ddb04df1d18bc1258af61f60 3x"}, "body": "アオエナさん、こんにちは！\nあなたが描く元気いっぱいで愛らしい男の子キャラクターが大好きで、キャラクターの衣装デザインもとても気に入っています。そこで、私のOC 2人の衣装デザインと全身イラストをお願いしたいです。\n具体的には、先生があなたのアイデアに基づいて自由にデザインしてくれることを願っています！\n\nテーマは異世界ファンタジーRPG風の衣装で、上半身はボリューム感のある凝ったデザイン、下半身は脚を強調するショートパンツを希望します。あなたの絵画に描かれている膝の描写が本当に大好きなので、衣装デザインでも可愛くて美しい膝が際立つように、隠さずに見せてくれることを期待しています！\n彼らが魔法の世界で一緒に冒険する姿を見るのが楽しみです！\n*添付のGoogle Driveの画像は、過去の衣装デザインの参考例です。キャラクターの主要な特徴を維持するだけでよく、元の衣装に基づいて描く必要はありません。\n\n以下に、この世界観におけるキャラクターデザインの概略を記載します。\n-\nOC1 夢宮ヨユ\n僕のOC(1)は、14歳のスライムウサギ男の子です。身長155cm。\n彼はいたずら好きで活発な性格で、天然ボケがある。\nその特徴は、垂れ耳のウサギの耳と、犬のような尻尾である。\nこのキャラクターの魔法界における職業は、毒魔法やポーション魔法、弱体化魔法を得意とする暗殺者タイプの魔法使いである。\n脚はキャラクター2の脚よりもややふっくらしている。\n-\nOC２ 星雨透\n僕のOC(2)は、14歳の猫耳男の子です。身長155cm。\n彼は学ぶことと読書が大好きな、無口属性の子供です。\nその特徴は、猫の右耳が垂れ下がり、左耳が正常な上向きになっていることで生じる左右非対称性である。\nこのキャラクターは、星や月との関連性を反映し、天体魔法を念頭に置いてデザインされた。\n彼は魔法学院で、壮麗な魔法を研究する勤勉で優秀な生徒だ。\n-\n個人使用です。OCは主に趣味として行っています。時折、娯楽目的で個人VTuberとしても活動しています。\n-\n読んでくれてありがとう！\n先生が僕の絵のリクエストを検討してくれるといいな！\n\nhttps://drive.google.com/drive/folders/16PJa4RMhgOwdB3lR2IHMe6Z2_CjwWzsf?usp=sharing", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@hemogi08/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3929494, "client_id": 3490957, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/34a10e92/uploads/origins/2911ce12-2677-46d4-bdb8-8441af976901?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fa049bfad1497155ef205c38c5f766c7", "srcset": "https://si.imgix.net/34a10e92/uploads/origins/2911ce12-2677-46d4-bdb8-8441af976901?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fa049bfad1497155ef205c38c5f766c7, https://si.imgix.net/34a10e92/uploads/origins/2911ce12-2677-46d4-bdb8-8441af976901?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=d6963574b37bc0cb33dc7916c4aa9005 2x, https://si.imgix.net/34a10e92/uploads/origins/2911ce12-2677-46d4-bdb8-8441af976901?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=3e527502775f5baea99a70545bba82db 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/34a10e92/uploads/origins/2911ce12-2677-46d4-bdb8-8441af976901?bg=%23fff&