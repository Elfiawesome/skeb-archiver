4c298/uploads/origins/b869a1f7-d197-4fac-a1fb-a3309c37d1a6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=bb8237f76bedcd62dc189ebe416d2f0a 3x"}, "body": "初めまして、いつもむっちりした椛イラスト拝見させていただいています。\nSkeb窓開け通知が来たのでぜひ依頼させていただきたく。\n\nhttps://x.com/Skeb74863772/status/1450020619228106753　OC1\nhttps://x.com/Skeb74863772/status/1637411528671641605　OC2\nこちらのうちの子のむっちりエッチなイラストをお願いしたいです、どちらでも構いません。\n私も東方の中では椛最推しでモチーフになってる子たちですので描きやすいかなとは思います。\nお受けしていただければ内容は何でも構いません、よければご一考お願いいたします。", "nc": 32, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@321_0819/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3805353, "client_id": 3589905, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/b2e4cd76/uploads/origins/f224121f-580c-43ad-a76f-6900b6a9cbc0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=347237c4ae343a56bef2dda877d0f5e7", "srcset": "https://si.imgix.net/b2e4cd76/uploads/origins/f224121f-580c-43ad-a76f-6900b6a9cbc0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=347237c4ae343a56bef2dda877d0f5e7, https://si.imgix.net/b2e4cd76/uploads/origins/f224121f-580c-43ad-a76f-6900b6a9cbc0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c057152d5e568224dc7a84a6f85ba4e9 2x, https://si.imgix.net/b2e4cd76/uploads/origins/f224121f-580c-43ad-a76f-6900b6a9cbc0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=61db9e31ac454357d8489a9718cd0762 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/b2e4cd76/uploads/origins/f224121f-580c-43ad-a76f-6900b6a9cbc0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=86a95d416af7b731d72d8529b8477275", "srcset": "https://si.imgix.net/b2e4cd76/uploads/origins/f224121f-580c-43ad-a76f-6900b6a9cbc0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=86a95d416af7b731d72d8529b8477275, https://si.imgix.net/b2e4cd76/uploads/origins/f224121f-580c-43ad-a76f-6900b6a9cbc0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=7a9a64b875c598579db6916c35858f8a 2x, https://si.imgix.net/b2e4cd76/uploads/origins/f224121f-580c-43ad-a76f-6900b6a9cbc0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=7d8fd8c26f8d1fa622b531ba8231ab79 3x"}, "body": "はじめまして。\nいつも素敵な椛ちゃんのイラストを楽しく拝見しています。\n\n今回、椛ちゃんのイラストをぜひお願いしたく、リクエストさせていただきました。\n\nポーズの参考として、こちらの画像を共有させてください：\nhttps://wimg.rule34.xxx//images/2727/43e6057500e0bbf58fa0521f6e9f892d.png\n\n※右側のポーズの雰囲気のみを参考にしていただければ嬉しいです。\n\n椛ちゃんは全裸で、場所は静かな室内。\n照明は少し暗めで、大人っぽく、二人きりの親密な空気感が伝わる雰囲気を希望しています。\n\n全体として、緊張感と色気が同居したような、プライベートな瞬間を感じられる一枚になれば嬉しいです。\n\n細かい表現や演出については、すべて志々様にお任せします。\nもし可能でしたら、どうぞよろしくお願いいたします。", "nc": 33, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@321_0819/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3805353, "client_id": 624195, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/c46477a8/uploads/origins/d5454a9b-c525-43e1-9d89-0b443d288f00?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a51bf25d0d693959b63583430dffe220", "srcset": "https://si.imgix.net/c46477a8/uploads/origins/d5454a9b-c525-43e1-9d89-0b443d288f00?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a51bf25d0d693959b63583430dffe220, https://si.imgix.net/c46477a8/uploads/origins/d5454a9b-c525-43e1-9d89-0b443d288f00?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c17f00add30909a31e8cf5d852079999 2x, https://si.imgix.net/c46477a8/uploads/origins/d5454a9b-c525-43e1-9d89-0b443d288f00?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=49145fcd1c41607edc889e4b1cf384d2 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/c46477a8/uploads/origins/d5454a9b-c525-43e1-9d89-0b443d288f00?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=922521abcc63ca446c9d9cc44ae3f68b", "srcset": "https://si.imgix.net/c46477a8/uploads/origins/d5454a9b-c525-43e1-9d89-0b443d288f00?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=922521abcc63ca446c9d9cc44ae3f68b, https://si.imgix.net/c46477a8/uploads/origins/d5454a9b-c525-43e1-9d89-0b443d288f00?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=df034dfd83bac5b1582f93c0a8e9de57 2x, https://si.imgix.net/c46477a8/uploads/origins/d5454a9b-c525-43e1-9d89-0b443d288f00?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=65acd3ced90c3f1eafe1c7d58db479a7 3x"}, "body": "志々さん、こんにちは。以前から志々雄さんのぽっちゃり椛ちゃんの絵のファンでしたので、この度ようやく作品をお願いできることになり、とても嬉しく思っています！もうすぐ冬が始まるので、最近目覚めたばかりのぽっちゃりレティ・ホワイトロックがベッドに座っている絵をリクエストしたいです。彼女は小さなパンツ一枚に、おっぱいがかろうじて隠れる程度のシャツしか着ていません。\n横からのアングルで、レティの大きなオッパイ、お尻、お腹がすべて見えるような写真が理想です！\nその他、ご希望があればご自由に追加してください。\n\nよろしくお願いします！", "nc": 161, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@321_0819/works/3", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/51649143/uploads/origins/451644ad-68fe-41c2-ae03-a35533da7f45?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=e2b5b9d63526407baeff93e9d7a464f9", "srcset": "https://si.imgix.net/51649143/uploads/origins/451644ad-68fe-41c2-ae03-a35533da7f45?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=e2b5b9d63526407baeff93e9d7a464f9, https://si.imgix.net/516