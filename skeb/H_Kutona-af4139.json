氏を、今日もおつかれ様！がんばってえらいねよしよしと、甘やかしてあげていると\n急に彼氏にぎゅっと抱きすくめられ、驚きます。\n甘えん坊なんだから…と撫でてあげ、少しの間のあと、クトナさんの方から囁くように、キスしよ？\nと声をかけて欲しいです\n最初は啄むように、段々と激しくなって、好き、愛してる等こちらも段々と激しく言って欲しいです。\nリップ音等出来れば多めで、唾液が絡むようにしていただけると嬉しいです。\n終わりと荒くなった息をはぁ…はぁ…と整えて\nねぇ、ベッド、行こ？\nと声をかけて終わらせて欲しいです。\n全体的に甘々な雰囲気で、呼び方はダーリンだとうれしいです。\n\n長くなりましたが、ご検討いただけたらと思います。\nよろしくお願いします。", "nc": 48, "word_count": 0, "transcoder": "audio", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 134907, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "藤村莉央🍀", "screen_name": "fujimura_rio", "avatar_url": "https://pbs.twimg.com/profile_images/1807627814709116928/a2mzUqG6.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1023846918319828993/1719806826/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 7, "complete_expiration_days": 30, "skills": [{"genre": "voice"}], "nc": 33}, {"id": 391426, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "デビルダンス🔞", "screen_name": "devildance", "avatar_url": "https://pbs.twimg.com/profile_images/2050512955280945152/pM62Vtzz.jpg", "header_url": "https://pbs.twimg.com/profile_banners/141575991/1777715361/1500x500", "appeal_receivable": true, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 5, "complete_expiration_days": 100, "skills": [{"genre": "art"}, {"genre": "correction"}], "nc": 176}, {"id": 2104805, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "駄天使るぅね💘", "screen_name": "datenshi_lune", "avatar_url": "https://pbs.twimg.com/profile_images/1527345925001138179/KMY1of7f.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1452917913099247625/1652785317/1500x500", "appeal_receivable": true, "popular_creator_rank": null, 