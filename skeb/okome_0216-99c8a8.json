=top&w=200&h=200&blur=200&s=9446c11ec9351039dd386f205002e5b1 2x, https://si.imgix.net/ca46bc98/uploads/origins/09951452-0a48-4110-9f1f-2d5346da095b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=02e61edd8377fde392174dbfc5d88240 3x"}, "body": "おこめさんはじめまして\n\nおこめさんが描かれるダークな雰囲気のイラストやキャラクター達を拝見し是非イラストを描いて頂きたくてリクエストさせて頂きました\n\nリクエストさせて頂きたいのはOCキャラです\n\nリクエストの内容は良ければ新しい衣装のデザインと見た目をお願いしたいです。\n\n衣装デザインはおこめさんのすきなデザインで描いて貰って大丈夫です、見た目の方は今は明るい雰囲気なので真逆のダークな雰囲気でお願いしたいです。\n\n髪型は良ければ伸ばしてロングヘアにして頂きたいです、おこめさんのイラストを見た時赤目に惹かれたので可能であれば片目の色を赤目にして頂きたいです。\n\nもしよろしければご検討の程よろしくお願いします\n\nhttps://drive.google.com/file/d/1BVXUX6afNf4SXuXwCpWdpsiSmaOIPjhU/view?usp=drivesdk", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@okome_0216/works/8", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 684977, "client_id": 54026, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/5c4c116d/uploads/origins/8960780b-ae90-4c97-99e2-96eec4b754ab?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=623784f0a7b14f2972fae2deb257609e", "srcset": "https://si.imgix.net/5c4c116d/uploads/origins/8960780b-ae90-4c97-99e2-96eec4b754ab?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=623784f0a7b14f2972fae2deb257609e, https://si.imgix.net/5c4c116d/uploads/origins/8960780b-ae90-4c97-99e2-96eec4b754ab?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=9a3b0abcc3ccb145f2306043f870892a 2x, https://si.imgix.net/5c4c116d/uploads/origins/8960780b-ae90-4c97-99e2-96eec4b754ab?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=96b1914e95aff0021889efe8e651e080 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/5c4c116d/uploads/origins/8960780b-ae90-4c97-99e2-96eec4b754ab?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f2568c3dbd4d86573ae6c97adf2abeef", "srcset": "https://si.imgix.net/5c4c116d/uploads/origins/8960780b-ae90-4c97-99e2-96eec4b754ab?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f2568c3dbd4d86573ae6c97adf2abeef, https://si.imgix.net/5c4c116d/uploads/origins/8960780b-ae90-4c97-99e2-96eec4b754ab?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=ac4bd88eb7cf56041b94a9034f849270 2x, https://si.imgix.net/5c4c116d/uploads/origins/8960780b-ae90-4c97-99e2-96eec4b754ab?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=8794ba8e5a3ef9da93e6fd3c305681f0 3x"}, "body": "はじまして\n素敵なイラストを拝見し依頼をいたしました。お引き受けいただけたら嬉しいです。\n\nお菓子垢・VTuberとして活動しておりますうちの子ちゃん(女装男子)の「彩月つむぎ」をお願いしたいです。\n雰囲気・イメージはほんわかのんびりとしたお姉さんな感じ\n職種:スティルルームメイド\n仕草などの指定はございません\n\nもしよろしければサムネや配信等でも使用したいと考えております。\n\nhttps://twitter.com/AyatsukiTsumugi/status/1524625081422721024?t=a6P_3dh85zINLtk3d9EEZg&s=19", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@okome_0216/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 684977, "client_id": 2382231, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/15849860/uploads/origins/24fe7d81-632d-4222-85a2-a6cc7e86d9db?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=979ca5f7f64ee466ea16092bb0efc9ff", "srcset": "https://si.imgix.net/15849860/uploads/origins/24fe7d81-632d-4222-85a2-a6cc7e86d9db?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=979ca5f7f64ee466ea16092bb0efc9ff, https://si.imgix.net/15849860/uploads/origins/24fe7d81-632d-4222-85a2-a6cc7e86d9db?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=34e89f5fc73690c90f0089ab4f1e2e9f 2x, https://si.imgix.net/15849860/uploads/origins/24fe7d81-632d-4222-85a2-a6cc7e86d9db?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e0cd50aaf977a45926482819aca3339f 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/15849860/uploads/origins/24fe7d81-632d-4222-85a2-a6cc7e86d9db?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=591f396530914f6ac11e96fdc3f2b655", "srcset": "https://si.imgix.net/15849860/uploads/origins/24fe7d81-632d-4222-85a2-a6cc7e86d9db?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=591f396530914f6ac11e96fdc3f2b655, https://si.imgix.net/15849860/uploads/origins/24fe7d81-632d-4222-85a2-a6cc7e86d9db?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=e62daa8c7f33c18cfcb8c3e8a4b6a053 2x, https://si.imgix.net/15849860/uploads/origins/24fe7d81-632d-4222-85a2-a6cc7e86d9db?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=e9a8d2299221e284118319f73f9c9030 3x"}, "body": "X/Twitterから参りました。\nこの度は、個人勢Vtuberの酒神ぱいんさんのファンアートをお願いしたくご連絡しました。\n\n・用途\n依頼者（路地猫）による使用ではなく、酒神ぱいんさんが配信活動で使うことを想定しています（二次創作公認プログラムに準ずる用途）。\nご参考に、過去に当方がskebでご依頼したイラストの使用例を以下にリンクさせて頂きます。\nhttps://www.youtube.com/channel/UCaJSNoq04a3Fm0IpKCmdFMw/community?lb=UgkxPQKBjphQbqB0Z6_y61s8xrPf5cObkXzl\n\n・ご必要に応じて「酒神ぱいん」側のガイドラインもご確認いただけるようリンクしておきます（「二次創作　-総合-」の項などをご参照ください）\nhttps://profcard.info/u/PfYNZCtZjuOF0VrI0GJHjwyLwZe2\n\n・資料\n三面図を「資料URL」に記します。\n\n・盛り込んで欲しい要素\n　・闇可愛い、いわゆる地雷系\n　・地べたにしゃがんでいる\n　・ストロング系のお酒を持っている\n　・↑にストローを差している\n　・MCM的なリュックを背負っている\n元ネタはお友達Vさんとのツイートです↓\nhttps://twitter.com/pain_sakagami/status/1696859617505243483\n\n先述のガイドラインにて髪型・服装等もアレンジしてよい旨が明記してありますので、その点もご安心ください。\n\n・ファイル形式、画角等\nもし可能でしたら、PSDか、もしくはPNGで背景透過バージョン有り（もし背景がある場合）を希望します。\n用途に鑑みまして、キャラクターのみのレイヤー（バージョン）については、もし可能でしたら頭のてっぺんや肩などが見切れないような画角でお願いできると尚嬉しいですが、skebの精神は理解しておりますので、ご負担にならない範囲でお願いできれば幸いです。\n\n　　　†\n\nお忙しい中、最後までお読みくださりありがとうございます！\nおこめ様のこれまでの作品とヘッダーを見て、ちょっぴりダークな感じなどから、このお題だったらおこめ様にぴったりに違いないと確信してリクエスト送らせて頂きました。\nご検討のほど、何卒よろしくお願い致します。\n\nhttps://pbs.twimg.com/media/FdmEMgvUoAA_BM9?format=jpg&name=4096x4096", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@okome_0216/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 684977, "client_id": 1355189, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/07e739a7/uploads/origins/92b69e2e-a832-4241-90fb-657c89145338?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=aaaf579c2f256788c0f617f585825494", "srcset": "https://si.imgix.net/07e739a7/uploads/origins/92b69e2e-a832-4241-90fb-657c89145338?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=aaaf579c2f256788c0f617f585825494, https://si.imgix.net/07e739a7/uploads/origins/92b69e2e-a832-4241-90fb-657c89145338?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c6b8215de7a4aa0af2d41c03aa36f097 2x, https://si.imgix.net/07e739a7/uploads/origins/92b69e2e-a832-4241-90fb-657c89145338?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f2f35860d8e7e7b14d57a095054626b2 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/07e739a7/uploads/origins/92b69e2e-a832-4241-90fb-657c89145338?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d3007657399b1ae748a87dbd037b9d65", "srcset": "https://si.imgix.net/07e739a7/uploads/origins/92b69e2e-a832-4241-90fb-657c89145338?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d3007657399b1ae748a87dbd037b9d65, https://si.imgix.net/07e739a7/uploads/origins/92b69e2e-a832-4241-90fb-657c89145338?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=07a0dbb199294eff02136806a907a885 2x, https://si.imgix.net/07e739a7/uploads/origins/92b69