。\n性格としてはめんどくさがり屋ですが、よく笑う子です。\nふわふわとした金髪に狐耳、もふもふのしっぽ、八重歯が特徴です。\n青い眼鏡をおでこにかけ、青いパーカーを着用しています。\n\nしろさんの描くロリキャラが好きなので、キャラの見た目年齢はお好きなように変えて大丈夫です！\n（もちろん過去のリクエストを参考にしていただいても結構です。設定上は14歳ということになっています）\nその他服装のアレンジ、構図に関しては特に指定を行いませんので、自由にかわいく描いてください！\n\n資料は過去のSkebリクエストのみとなります。ご容赦ください。\nよろしくお願いします！\n\nhttps://skeb.jp/@sunajiro8", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@White_ztt_/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2868388, "client_id": 1249073, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/51989655/uploads/origins/099b1f4f-98d0-47cb-9f2d-c42870864ad3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=815cea1638c7a0102c97662d8d451d07", "srcset": "https://si.imgix.net/51989655/uploads/origins/099b1f4f-98d0-47cb-9f2d-c42870864ad3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=815cea1638c7a0102c97662d8d451d07, https://si.imgix.net/51989655/uploads/origins/099b1f4f-98d0-47cb-9f2d-c42870864ad3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=600d97072a1994e189003a3a772af3ca 2x, https://si.imgix.net/51989655/uploads/origins/099b1f4f-98d0-47cb-9f2d-c42870864ad3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a45491887ec1217c5c0e550c30f3402d 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/51989655/uploads/origins/099b1f4f-98d0-47cb-9f2d-c42870864ad3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b8911012a07ebc9d5ceeac81097da23f", "srcset": "https://si.imgix.net/51989655/uploads/origins/099b1f4f-98d0-47cb-9f2d-c42870864ad3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b8911012a07ebc9d5ceeac81097da23f, https://si.imgix.net/51989655/uploads/origins/099b1f4f-98d0-47cb-9f2d-c42870