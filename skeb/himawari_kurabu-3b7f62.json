+難しい本をよく読み、お堅い性格（だけど真顔でボケたりも）\n\n【拝歌マルタ】\n+好きなもの／手羽先、苦手なもの／特になし\n+女性生まれですが、お腹にあるはずのアレは摘出しました。\n+神サマは自分を見捨てはしないと思ってる\n+傷を見るのが好き（でも善い人）な看護師兼使用人\n\n二人は主従関係にあります。（主→エズラ、従→マルタ）\n現在の二人は山のほうで施療院をひっそりやってます。\n########\n\n以上の内容に、もし御不快なことがあれば申し訳ございません。\n\nhttps://drive.google.com/drive/folders/1JN_0PzlnYxQnZpFzNEhrv1TiLbBUiLdy?usp=sharing", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 1853291, "creator": true, "nsfw_acceptable": false, "acceptable": false, "name": "伊賀ハピネス🍀", "screen_name": "iga_happiness", "avatar_url": "https://pbs.twimg.com/profile_images/1960815033652535301/uvKC4KkB.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1494690175020310533/1751266481/1500x500", "appeal_receivable": true, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "art"}, {"genre": "correction"}], "banned": false, "nc": 32}, {"id": 2412927, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "蒲.ᐟ.ᐟ", "screen_name": "horurara", "avatar_url": "https://pbs.twimg.com/profile_images/1649115280751362053/yNIW4HyY.jpg", "header_url": "https://pbs.twimg.com/profile_banners/348862517/1661952493/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "art"}], "banned": false, "nc": 145}, {"id": 2711043, "creator": true, "nsfw_acceptable": true, "acceptable": false, "name": "ゆんこめ", "screen_name": "yunkome_okome", "avatar_url": "https://pbs.twimg.com/profile_images/1983478102782296064/Le-ZfNiz.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1373481244558651395/1743815636/1500x500", "appeal_receivable": false