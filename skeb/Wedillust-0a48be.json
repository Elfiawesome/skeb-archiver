も気に入っています。もし私のオリジナルキャラクターのイラストを描いていただけたら、大変光栄です。彼女は、異世界への転送事故を生き延びた実験的な少女で、明るく行動力があり、少しおてんばなところがあり、悲劇的な要素はありません。自由を大切にし、支配されることを嫌い、携帯端末を使って異世界を行き来し、遊び心のあるサメのような歯を見せて笑います。このイラストは私の個人ウェブサイトやTwitterで使用させていただきますが、もちろんクレジットは明記します。 構図は完全にあなたにお任せします。お時間をいただきありがとうございます。\n\nhttps://edc5240.wixsite.com/the-one-beyond-the-g\n\nhttps://drive.google.com/drive/folders/1NiAzodxwQIvvMtPmYRiYcRVBjjQi6aFK?usp=sharing", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@Wedillust/works/8", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3784483, "client_id": 1985095, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/813f0460/uploads/origins/da414bbe-cd89-4fe8-9a79-1280d27b3d3c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=032e00a8bb7b1b5899dd1219a90a1d6b", "srcset": "https://si.imgix.net/813f0460/uploads/origins/da414bbe-cd89-4fe8-9a79-1280d27b3d3c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=032e00a8bb7b1b5899dd1219a90a1d6b, https://si.imgix.net/813f0460/uploads/origins/da414bbe-cd89-4fe8-9a79-1280d27b3d3c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=1b77b3a8ae21c59fc0f423c562753876 2x, https://si.imgix.net/813f0460/uploads/origins/da414bbe-cd89-4fe8-9a79-1280d27b3d3c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=927172bfcf288adb48bc722453665b69 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/813f0460/uploads/origins/da414bbe-cd89-4fe8-9a79-1280d27b3d3c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=cf0bdeb7f5e6672d26ce1018d2dbf41c", "srcset": "https://si.imgix.net/813f0460/uploads/origins/da414bbe-cd89-4fe8-9a79-1280d27b3d3c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=cf0bdeb7f5e6672d26ce1018d