06/uploads/origins/567700cb-7ee8-48ca-9671-be6fb2b3bbee?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=94fafe9bcf3b174c443656bb0b467ee1", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/5b671506/uploads/origins/567700cb-7ee8-48ca-9671-be6fb2b3bbee?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ebb3723de09a22d80a431eed537eaa2d", "src_set": ""}, "body": "初めてリクエストします。\n\nキャラ：テイルズオブデスティニーのリリス・エルロン\n内容\n兄（スタン）が入っている風呂場に「一緒に入ろう」と言って裸を隠さず一切恥じらい無しに入ってくるリリスをスタン目線でお願いします。", "nc": 160, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Reisen_Alice/works/19", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 17215, "client_id": 26362, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/cd2aee7b/uploads/origins/31eb2926-17ab-463a-826c-1a824957248b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c6ddcb487440f3cc4216d7be2025577a", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/cd2aee7b/uploads/origins/31eb2926-17ab-463a-826c-1a824957248b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c5da41ecec10029cc1391476c06aaf04", "src_set": ""}, "body": "○キャラクター:\n・東方旧作のロリスちゃんとフランちゃんをお願いします\n\n〇内容：\n・二人共スライムもしくは触手に寄生されており本人の意思とは無関係に無理やりショタを犯してるシチュでお願いします\n\n〇服装：\n・ロリスちゃんとフランちゃんはおまかせします。\n・二人共資料URLのイラストの様に衣服が一部破れてブラやパンツが見えてる状態でお願いします\n\n〇その他：\n・大きなおっぱいが好きなので二人共大きめでお願いします。\n・寄生されてるとわかるように耳もしくはお尻から寄生体が出てるようにして頂けると嬉しいです\n・目のハイライトありとなしの差分もあると嬉しいです、差分が難しい場合目のハイライトはなしでお願いします\n・胸元や脚などには精液が付着してる描写をお願いします。\n・可能であればセリフなどを入れて頂けると嬉しいです。\n・もし足元を描写する際はフランちゃんもロリスちゃんもブーツでお願いします。\n\nhttps://twitter.com/Reisen_Alice/status/1457793404394369024?s=20", "nc": 184, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Reisen_Alice/works/18", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 17215, "client_id": 63521, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/9f324920/uploads/origins/74702e88-bbe4-4079-ba7c-a11e536bb813?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=aee3b8e7289072bff63e74f3203e6924", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/9f324920/uploads/origins/74702e88-bbe4-4079-ba7c-a11e536bb813?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b4b503f23b5d95e7639a3ffe0ed73a08", "src_set": ""}, "body": "ツイッターで募集されていたので僭越ながらお願いしたく文章を書かせていただいております。\n\nhttps://www.pixiv.net/artworks/90874300\n\nこちらに書かれているセラフィさんの容姿、能力がとても素敵でしたのでこちらの方を中心に依頼を考えさせていただきました。\n\nキャラクター\n・攻め：セラフィさん\n・受け：巨乳な女の子（お任せします。）\n\nシチュエーション\n・前回に引き続き謎の人物に憑依されているセラフィさん\n・転移魔法を使い見えないところから性的に攻める\n・乳首責めを中心にベロチューや手マンなど受けが思いっきりレズレイプされる\n・セラフィさん、受けの子共に初めは嫌がっているが徐々に快楽に溺れていく\n\nよければよろしくお願いします。", "nc": 57, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Reisen_Alice/works/17", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 17215, "client_id": 297010, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/5a707342/uploads/origins/4da39db1-8e02-43a9-a518-1ea08cd0a594?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3f1d5ec20c7683a9e6c739078b380e07", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": true, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/5a707342/uploads/origins/4da39db1-8e02-43a9-a518-1ea08cd0a594?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5c5d7634dac219a89524a0b13f9d54aa", "src_set": ""}, "body": "「いつかの未来」\nということで、閃乱カグラの未来（爆乳）をお願いします。彼女がよく夢見る姿ではなく、背丈はそのままで！\n\n衣装は黒の猫耳（資料参照）と、\n81の日爆乳祭の雪不帰の水着（あるいはそれのような、レースのついたオトナっぽいブラジャーとパンツ上下、色は黒〜深紫）\n\nシチュは、おっぱいの大きくなった未来が、顔に不釣り合いなHな下着姿で先生に初めてのパイズリをしている、というところです。\n（ウソみたい……あたし、先生とおっぱいえっちしちゃってる……♡今日から毎日、こうやっておっぱい犯されちゃうんだ……♡）と心の声をつけて、\n「はっ♡」「んっ♡」と吐息を漏らしつつ、自分の行為や響いている音なんかに本人も興奮し、軽くイキながら頑張っている感じでお願いします。\n\nおっぱいの大きさは竿をほぼ飲み込んでしまうほど。ブラ面積が大きめになると思いますが、乳輪が見えていても構いません。ただし、下着ごときっちり締め付けている感を出すため、はだけないようにお願いします。\n\nもし可能なら、すみっこにワイプ感覚で、ローアングルからのおしり〜股ぐらまでのアップ、キュンキュン疼いているところを描いていただけるとありがたいです。\nよろしくお願いします！\n\nhttps://drive.google.com/folderview?id=1BmENWA0wI73cSfKbulFxV4l7_J-z6RE-", "nc": 59, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Reisen_Alice/works/16", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/c351f0fe/uploads/origins/f8687c01-49fc-4841-a0a6-1392ca9836a8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=41328bc4f8901638f0ac5fbaa86984d8", "src_set": ""}, "private": true, "genre": "art", "tipped": false, "creator_id": 17215, "client_id": 0, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 160, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@Reisen_Alice/works/15", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 17215, "client_id": 0, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/b7b6a947/uploads/origins/ca5f15ed-4e34-4ba8-8638-1ee9899f98dd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b5b5b1ad0edb0b3aa89d23d63397c13c", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/b7b6a947/uploads/origins/ca5f15ed-4e34-4ba8-8638-1ee9899f98dd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=fca537654413d8be8f96af2884acbad8", "src_set": ""}, "body": "・ロリがお兄ちゃんの乳首とチンチンを同時に責めている\n・お兄ちゃんの乳首は開発によって三センチくらいにまで肥大している、ロリはそれを親指と人差し指でつまみ、しごいている\n・ロリはもう一方の手でチンチンを乱暴にしごいている\n・ロリは膝で睾丸をグリグリしている\n\nこのようなシチュエーションをお願いします\n（キャラクターは変わっても問題ありません）", "nc": 41, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Reisen_Alice/works/14", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 17215, "client_id": 90411, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/366d800a/uploads/origins/3244cb1e-e6e3-4d8f-9e8b-f7f5cf696e18?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d93ba5ca7945aae65fc2425330845317", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/366d800a/uploads/origins/3244cb1e-e6e3-4d8f-9e8b-f7f5cf696e18?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=41d2c565d3819eca9ecab735f3ab0d91", "src_set": ""}, "body": "はじめまして。いきなりの依頼失礼します。自キャラ的な女の子のR-18(エロです)イラストを依頼したいです\n\n・キャラクターは下記のリンクの女の子です\nhttps://pbs.twimg.com/media/ElWJvQtU8AMmMZX?format=jpg&name=4096x4096\n\n・衣装を下記のリンクの衣装にして欲しいです\nhttps://drive.google.com/file/d/1G2OG3GjQkUCXfGZNWNsdduYJ5l1DlbWP/view?usp=sharing\n・もし可能であれば杖も描画して欲しいです\nhttps://drive.google.com/file/d/1Hcq-RHUysMIzu1uqBmz2J7H8aXzLSbx3/view?usp=sharing\n\n・シチュエーション等についての要望ですが魔法少女に対するエロ攻撃的な感じで幽霊をイメージした半透明な手に手足を掴まれて状態で胸揉み+手マンのような感じで描いて欲しいです。\n・服を破いたりはだけさせたりせず服をすり抜けて直接胸やアソコをいじれるという設定で上記の行為をさせて欲しいです\n\n以上です", "nc": 184, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Reisen_Alice/works/13", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/4869f83d/uploads/origins/35a979fc-e8ca-4750-81c7-f9b922fee4d2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Cc