姿を想像で描いていただけますでしょうか。\n\n・ヘアスタイル\n頭頂から毛先に掛けて白からピンクのグラデーション。\nゆるくパーマのかかったふんわりロングヘアを高めの位置でポニーテール。\n肩くらいの長さの前髪をセンター分け。\n\n・顔\n優しい顔のお淑やか系美人。\n垂れ目でまつ毛は長い。\n笑う時ははにかむ感じで口は閉じて歯を見せない。\n\n・身体\n某有名怪盗アニメのヒロインみたいなウエスト細めで胸と腰がしっかりある、メリハリのがついた体型。\n\n・服装\n胡蝶蘭のようなドレープ感のあるマーメイドドレス。ベルスリーブがついています。\nピンヒールのロングブーツを履いています。\n戦闘するためスリット等を上手く入れて動きやすそうだけどエレガントな感じに纏めていただけると嬉しいです。\nヘアスタイルと同様に肩から裾にかけて白からピンクのグラデーションです。", "nc": 153, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@spicA_urania/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3317867, "client_id": 3328311, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/3c7c8ab0/uploads/origins/fabfc883-24ec-4043-b576-9dba045882d7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=aa1903b1b817c899cc345cc655c0fdff", "srcset": "https://si.imgix.net/3c7c8ab0/uploads/origins/fabfc883-24ec-4043-b576-9dba045882d7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=aa1903b1b817c899cc345cc655c0fdff, https://si.imgix.net/3c7c8ab0/uploads/origins/fabfc883-24ec-4043-b576-9dba045882d7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a6027361ef5788071a8325907d939ddf 2x, https://si.imgix.net/3c7c8ab0/uploads/origins/fabfc883-24ec-4043-b576-9dba045882d7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=4e1737e829bd7912024fc1be581f4619 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/3c7c8ab0/uploads/origins/fabfc883-24ec-4043-b576-9dba045882d7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a36501894f44b199d37f7739ac3f77dc", "srcset": "https://si.imgix.net/3c7c8ab0/uploads/origins/fabfc883-24ec-4043-b576-9dba045882d7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a36501894f44b199d37f7739ac3f77dc, htt