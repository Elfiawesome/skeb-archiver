/186419ad/uploads/origins/eaa38732-d2db-484b-ab14-014528ed98c7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=e1b20261f5602b90afe6ff6fbb42783e 3x"}, "body": "女子高生セーラー服(紺色、スカーフは赤)に黒　　ストッキング(太ももまで)でおむつ(テープ止めタイプで)にうんちブリブリ(しゃがんで)と出す処でお願い致します。女子高生は眼鏡使用で黒髪場所は電車の中で", "nc": 56, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Mitaray_3/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1046204, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/b8356095/uploads/origins/5ca387fd-aa3a-4cbc-a7be-4135efe7f13d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=eb5506552717b11dc33c12a0ebc2a34f", "srcset": "https://si.imgix.net/b8356095/uploads/origins/5ca387fd-aa3a-4cbc-a7be-4135efe7f13d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=eb5506552717b11dc33c12a0ebc2a34f, https://si.imgix.net/b8356095/uploads/origins/5ca387fd-aa3a-4cbc-a7be-4135efe7f13d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=10f65fc0c941d946a980b82f78e83bb0 2x, https://si.imgix.net/b8356095/uploads/origins/5ca387fd-aa3a-4cbc-a7be-4135efe7f13d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=fd2f9d6f9e982218f714cd8f1c04983a 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/b8356095/uploads/origins/5ca387fd-aa3a-4cbc-a7be-4135efe7f13d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=cb21bf50afcd595c9929643f87484f30", "srcset": "https://si.imgix.net/b8356095/uploads/origins/5ca387fd-aa3a-4cbc-a7be-4135efe7f13d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=cb21bf50afcd595c9929643f87484f30, https://si.imgix.net/b8356095/uploads/origins/5ca387fd-aa3a-4cbc-a7be-4135efe7f13d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=72a35c4284b8034516a8a433dfc8728a 2x, https://si.imgix.net/b8356095/uploads/origins/5ca387fd-aa3a-4cbc-a7be-4135efe7f13d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=053add30cf53088b0d50760f0d1860b2 3x"}, "body": "みたらい先生、初めまして。\n最近の紫衣花ちゃんのリクエスト作を見ていたら自分も描いていただきたくなったので、依頼させていただきます。\nシチュエーションとしてはおもらし遊びをし過ぎたせいか寝ている間に大小どちらも本当に失敗してしまった紫衣花ちゃん。朝になって起きた後にわざとではない本当の失敗に焦りつつも興奮してしまうといった内容で描いていただけると幸いです。ご検討のほどよろしくお願いします。", "nc": 48, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Mitaray_3/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1046204, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/8126bb1c/uploads/origins/9da0ee02-506d-4557-98ca-27ed5424df41?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5067f563af6a808082bd86ee6fe96d40", "srcset": "https://si.imgix.net/8126bb1c/uploads/origins/9da0ee02-506d-4557-98ca-27ed5424df41?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5067f563af6a808082bd86ee6fe96d40, https://si.imgix.net/8126bb1c/uploads/origins/9da0ee02-506d-4557-98ca-27ed5424df41?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=1fee9dbb44e954b94cf1170b03131f3e 2x, https://si.imgix.net/8126bb1c/uploads/origins/9da0ee02-506d-4557-98ca-27ed5424df41?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b2dfddd900c165face6de1ab183b192c 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/8126bb1c/uploads/origins/9da0ee02-506d-4557-98ca-27ed5424df41?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ab6eb169e7e7874e405fbd563868b848", "srcset": "https://si.imgix.net/8126bb1c/uploads/origins/9da0ee02-506d-4557-98ca-27ed5424df41?bg=%23fff&auto=format%2Ccompre