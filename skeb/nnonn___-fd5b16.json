oder": "image", "creator_acceptable_same_genre": false}, {"path": "/@a503112n/works/112", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 61767, "client_id": 1533599, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/42ebe265/uploads/origins/aa609bec-4b94-4159-b6d9-ada57d747054?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3eeac61f7aaa97fe296ba04a159d606a", "srcset": "https://si.imgix.net/42ebe265/uploads/origins/aa609bec-4b94-4159-b6d9-ada57d747054?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3eeac61f7aaa97fe296ba04a159d606a, https://si.imgix.net/42ebe265/uploads/origins/aa609bec-4b94-4159-b6d9-ada57d747054?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=559b4df3d763335a9a18f7653ee4aedc 2x, https://si.imgix.net/42ebe265/uploads/origins/aa609bec-4b94-4159-b6d9-ada57d747054?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=35f634ce8a04814810582b5bd9ac81fa 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/42ebe265/uploads/origins/aa609bec-4b94-4159-b6d9-ada57d747054?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5b7939ca57ba687d121013328f39b387", "srcset": "https://si.imgix.net/42ebe265/uploads/origins/aa609bec-4b94-4159-b6d9-ada57d747054?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5b7939ca57ba687d121013328f39b387, https://si.imgix.net/42ebe265/uploads/origins/aa609bec-4b94-4159-b6d9-ada57d747054?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=467c36350a929282d53518e5757a72a4 2x, https://si.imgix.net/42ebe265/uploads/origins/aa609bec-4b94-4159-b6d9-ada57d747054?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=a6c0c54d7b2a34f34fffec13af4d05c3 3x"}, "body": "こんにちは。はじめてリクエストいたします。\n_anさんがスケブをしていると知って以降、いつかリクエストしてみたいな…とずっと考えていたのですが\n漸く、自分がTRPG(COC)で遊ばせていただいた時に制作した探索者と、そのペアーだった探索者さんを是非_anさんの絵で見たい！！描いて欲しい！！\nとなったため、リクエスト致します。\nよろしければお願いします。\n\n---------\n下記のグーグルドライブに資料計6種があるので参考にしていただければと思います。\n\n＊二人組です。先輩(大きい方)と後輩(被り物をしている方)\n＊風神と雷神をイメージしてそれぞれが探索者をキャラデザしました。\n＊少年漫画をイメージして制作しています。\n＊もうひとかた方(先輩のPLさん)にはリクエスト使用の許可を頂いてます。\nhttps://drive.google.com/drive/u/0/folders/1xp1t6U2bkomEk8uaWUNEMaUW6dgDaA6U\n\nリクエスト内容\n添付資料の2人を_anさんに描いて頂きたいです。\n私は_anさんのキャラクターの描かれ方も好きなのですが、何より全体の雰囲気やモチーフの描かれ方がとても好きなため、雨や雲、曇天をモチーフとして取り入れていただけると非常にありがたいです。\nが、思う様に描いて頂ければそれだけで満足です！！！\n\n長々と書いてしまいすみません。\nよろしくお願いいたします", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "similar_creators": [{"id": 1158599, "creator": true, "nsfw_acceptable": true, "acceptable": false, "name": "櫻庭", "screen_name": "skrblue_", "avatar_url": "https://pbs.twimg.com/profile_images/1693584154045419520/j4yDuh8H.jpg", "header_url": "https://pbs.twimg.com/profile_banners/811960328980307968/1711100378/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 14, "complete_expiration_days": 120, "skills": [{"genre": "art"}, {"genre": "comic"}, {"genre": "novel"}, {"genre": "correction"}], "banned": false, "nc": 33}, {"id": 1939608, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "てつジ💋Skeb〇", "screen_name": "ttG___29", "avatar_url": "https://pbs.twimg.com/profile_images/2088977328194158593/evXvlLP6.jpg", "header_url": "https://pbs.twimg.com/profile_banners/129734178/1765046885/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 120, "skills": [{"genre": "art"}, {"genre": "comic"}], "banned": false, "nc": 128}, {"