tube・SNSでの活動への利用\n\n【依頼内容】\n笑顔の菊宮みゃご\n両手または片手が顔の近くにある構図だと嬉しいです。\nサムネイル等に使えるように、人物について上・左・右に見切れがないと助かります。\n\n【納品形式】\nPSDまたはPNGにて、人物のみのものがあるようにお願いしたいです。\n\n立ち絵資料は以下のリンクを参照してください。\nhttps://drive.google.com/file/d/1sn4l9mcp2USkJ9E6RglAWgYkNIFZSfX9/view?usp=drive_link\n\n\n以上です。\nもしリクエスト受注可能であれば、ぜひよろしくお願いいたします！", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@2UTbAeC26LfSIbw/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2918404, "client_id": 3003998, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/216a0968/uploads/origins/296082a2-ac9d-4338-b831-dfbdc090bcbc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2709bb7814306a914cb448158e002b20", "srcset": "https://si.imgix.net/216a0968/uploads/origins/296082a2-ac9d-4338-b831-dfbdc090bcbc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2709bb7814306a914cb448158e002b20, https://si.imgix.net/216a0968/uploads/origins/296082a2-ac9d-4338-b831-dfbdc090bcbc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=6f528153329428c4b6b36a7a45a7bebf 2x, https://si.imgix.net/216a0968/uploads/origins/296082a2-ac9d-4338-b831-dfbdc090bcbc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=943ecbdb39d0e4ce6966a816a5924754 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/216a0968/uploads/origins/296082a2-ac9d-4338-b831-dfbdc090bcbc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f3d930c3d8324669e12beafe7f5e7c24", "srcset": "https://si.imgix.net/216a0968/uploads/origins/296082a2-ac9d-4338-b831-dfbdc090bcbc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f3d930c3d8324669e12beafe7f5e7c24, https://si.imgix.net/216a0968/uploads/origins/296082a2-ac9d-4338-b831-dfbdc090bcbc?