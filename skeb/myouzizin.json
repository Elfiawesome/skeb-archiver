他の女の子を描きたいのであれば、どの子を描いていただいても構いません！\n彼女たちの参考資料はすべてのリクエストに含まれており、簡単にアクセスできます。\n\nただ1点だけ、男性キャラクターが登場する場合は、私のアバターか、彼のデザインに似せてほしいです。https://skeb.jp/@SIRATAMA5656/works/94\n\nお読みいただきありがとうございます！\n自由度の高さに魅力を感じていただけたら幸いです。\n\nhttps://drive.google.com/drive/folders/1t1vs2guOFCbodliWoTs2cv5rA3gbBxvk?usp=sharing", "nc": 33, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@myouzizin/works/3", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/8d4ae58b/uploads/origins/c18ef139-6707-4d86-aa2a-75629f897dd8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=346315568c074d114a5e5f61c1ee82a5", "srcset": "https://si.imgix.net/8d4ae58b/uploads/origins/c18ef139-6707-4d86-aa2a-75629f897dd8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=346315568c074d114a5e5f61c1ee82a5, https://si.imgix.net/8d4ae58b/uploads/origins/c18ef139-6707-4d86-aa2a-75629f897dd8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=eafe6c348bdb033b39a70433cd93bf39 2x, https://si.imgix.net/8d4ae58b/uploads/origins/c18ef139-6707-4d86-aa2a-75629f897dd8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=fd4833a6439260b7c7784146b8206056 3x"}, "private": true, "genre": "art", "tipped": false, "creator_id": 3705244, "nc": 32}, {"path": "/@myouzizin/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3705244, "client_id": 3553908, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/0a1f05e3/uploads/origins/8e6db05c-09c2-47c8-8374