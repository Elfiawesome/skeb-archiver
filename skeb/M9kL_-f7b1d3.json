ee7-b1e2-864e690c70f0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=15dc5ce849bcb04953c5292d8659a6cd", "srcset": "https://si.imgix.net/2f19e25e/uploads/origins/e500b854-1b4d-4ee7-b1e2-864e690c70f0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=15dc5ce849bcb04953c5292d8659a6cd, https://si.imgix.net/2f19e25e/uploads/origins/e500b854-1b4d-4ee7-b1e2-864e690c70f0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=69b62d972ab988dd463a0d5a712dd35f 2x, https://si.imgix.net/2f19e25e/uploads/origins/e500b854-1b4d-4ee7-b1e2-864e690c70f0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=7335846fc4280eec409ebc8dbddb210b 3x"}, "body": "間宮さん初めまして。\nウマ娘でコミッションを募集している方を探してる所に見つけさせていただきました。\nややマイナーなご依頼で恐縮ですが、もしよろしければウマ娘の「ワンダーアキュート」に「トサキントレオタード」をコスプレさせた一枚をお願いできますか。\n（※トサキントレオタード→初代のポケモンアニメ43話「ナッシーぐんだん　だいこうしん！」で、カスミがマジシャンのアシスタントの際に着用していた、トサキントを模した衣装を指してます）\n衣装の造形につきましては資料ページをご参考ください。\nコスプレとしての依頼は完全に自分の趣味のお願いとなりますため、元ネタをご存じないだろうことは百も承知ですが、それでもよろしければお願いさせて頂きたく存じます……！\n\n表情や構図・ポーズ、あと多少のアレンジなどについては、間宮さんが良いと思ったまま、間宮さんのご想像されるアキュートさんのリアクションで描いて頂ければOKです。\nコスプレ（衣装）姿がメインなので、せめて全身絵で衣装姿を堪能させて頂ければ特に嬉しく思います。\nセンシティブに配慮してストッキング履かせる等の微アレンジを加えて頂く等は問題ないですが、もちろん原作デザインそのままに素足で描かれてもOKです！\n（だけどロングな手袋が性癖なので、アレンジしても手袋は忘れないで頂ければとてもすごく嬉しいです……）\nまた、可能でしたら、アキュートさんの髪型は先日の水着イベントの際の、髪の毛を二つ結びにした髪型の方が好みでしたので、そちらで描いて頂けましたらと存じます！（難しかったら通常のものでも大丈夫です）\n\n間宮さんご自身、ダート組が推しということで、その中でも自分が見たいアキュートさんでお願いさせて頂く形となりますが、それでもよろしければ何卒よろしくお願いします！\n\nhttps://bulbapedia.bulbagarden.net/w/index.php?title=File:Misty_Goldeen_outfit.png", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@M9kL_/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3019007, "client_id": 727284, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/b0cf759c/uploads/origins/a32c8a2e-b98e-4f43