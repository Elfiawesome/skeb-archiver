ds/origins/c9957bf1-c8f8-4aec-a785-b2ddd765f8f4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=6dbfcd06cd1ec4c7aef913562c1165cf 3x"}, "body": "たちや様\n\nいつもイラストを拝見させて頂いております。\nユニコーンと申します。\nこの度はたちや様がskebでリクエスト募集をしていると知り、是非ともリクエストさせて頂きたく思い、リクエストをさせて頂きました。\n\n創作物及び複数人構図が可能であれば、たちや様がご参加されていたクトゥルフロンパリセットのキャラクターを2人構図で頼みたいのですがよろしいでしょうか？\n可能でしたら、たちや様宅の白雪百合香ちゃんが、月夜里深影くんの個室のソファにて、金木犀の花を、緑色のカラーコンタクトをした月夜里深影くんに渡してる絵を描いていただきたく思います。\n百合香ちゃんのお膝の上か片手にハムレットの本がありましたら、幸いです。(限定的なリクエストのため、難しければ蹴っていただいて大丈夫です)\n\n送付URLにて、親御様から許可を頂きました、月夜里深影くんの参考画像、個室のソファの参考画像をお渡しします。何卒よろしくお願いします。\n\n以上、リクエストとなります。\n何卒、よろしくお願い致します。\n\nユニコーン\n\nhttps://drive.google.com/drive/folders/1EGqf6LQ5owNDTS-y3_ss2N2eZrgS_9Bw", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}], "sent_works": [{"path": "/@garyu3126/works/9", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 68771, "client_id": 1570042, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/2cdf91fe/uploads/origins/fe453857-272d-4f67-a5f8-1e544ea20f5e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9264dbca51f02e3bf5a9268e7bfb40e3", "srcset": "https://si.imgix.net/2cdf91fe/uploads/origins/fe453857-272d-4f67-a5f8-1e544ea20f5e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9264dbca51f02e3bf5a9268e7bfb40e3, https://si.imgix.net/2cdf91fe/uploads/origins/fe453857-272d-4f67-a5f8-1e544ea20f5e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=db8b91d75e9a78ffdd226749d1880ab6 2x, https://si.imgix.net/2cdf91fe/uploads/origins/fe453857-272d-4f67-a5f8-1e544ea20f5e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=924b0a020ef247885123fbb137211913 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/2cdf91fe/uploads/origins/fe453857-272d-4f67-a5