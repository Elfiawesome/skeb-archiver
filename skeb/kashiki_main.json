657-8a22-6c0286338350?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2b8c4eb87f201b6efe162128b9ebf4b3", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/06ee08cf/uploads/origins/055456a8-cf79-4657-8a22-6c0286338350?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=cd88bbf28f2efe21c71d3bc1949455a4", "src_set": ""}, "body": "いつもお世話になっております。手数料無料キャンペーンが来るのを待つつもりでいたらちょうど来たので依頼させていただきます。\nワンダーランドウォーズが2025年2月19日をもちまして稼働開始から10周年となりアーケードゲームとしては数少ない長寿タイトルとなりました。\n今回は10周年記念イラストを描いていただきたく参りました、10周年記念という事でそれなりの金額を提示しますが趣味絵を描く時間やコスパを加味してご検討していただければと思ってます。\n\n作品名:ワンダーランドウォーズ\n\nキャラクター:キャラと人数は完全におまかせします(描きたいキャラクターを好きなように描いていただければ大丈夫です)\n\n服装:水着・トップレス・ヌード\n\nシチュエーション:皆でプールもしくはビーチに遊びに来ている\n\n構図:全ておまかせします\n\nアスペクト比:ディスクトップ画面に使いたいので可能であれば16:9でお願いします。\n\n使用用途:Skebの印刷してお届け機能、PCディスクトップ画面\n\nキャラの参考資料はお手数ですが公式サイトや動画などを参考にしてください。\n色々希望してますが無理なく描いていただければと思っています。よろしくお願いします。", "nc": 161, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@kashiki_main/works/137", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 618569, "client_id": 180981, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/31951f5b/uploads/origins/8bfe4feb-e691-4b52-815b-d5c85d07fb05?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c3e5ab386286516b86b46d14d766548f", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/31951f5b/uploads/origins/8bfe4feb-e691-4b52-815b-d5c85d07fb05?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=950adbda6275c478e525cf062452f9e6", "src_set": ""}, "body": "遅くなりましたがアピールをありがとうございます。\n\nかなり特殊なリクエストになります。無理な場合はキャンセルを、非表示をご希望の場合は再送要請ををお願いします。\n\n艦これの時津風がポケモンのアーボックに巻き付かれている絵をお願いします\n\nアーボックは時津風の首から下を４巻程で隙間なく巻き付け、時津風の頭の上に頭を乗せ鼻の付近まで舌を出して下さい。アーボックの口は閉じてください。\n全身巻き付かれている事を強調する為、時津風の全身（しつこくて申し訳ございませんが首から下は足も見えないぐらい隙間なく全身巻き付けて下さい）を描いて頂けるとうれしいです。\n又、できればアーボックは通常色と色違いをお願いします。\n又、さらに大丈夫ならアーボックの尻尾で首を巻き付けているパターンと巻き付けていないパターン(どちらかでしたら巻き付けていないパターン)をお願いします。\n\n時津風の表情ですが、大丈夫でしたら以下の通り（無理なようでしたら①と④を優先でお願いします）又、できればどの表情もアーボックは通常色と色違いをお願いします。\n①締め付けられて涙目で苦しんでいる（目は閉じています）\n②苦しんでいるけど若干感じていて赤面になっている（目は閉じています）\n③苦しいけど若干気持ちよくて恥ずかしがっている（目は開けています）\n④嬉しくて締め付けられているのに笑っている（目は開けています）", "nc": 49, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@kashiki_main/works/136", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 618569, "client_id": 2800654, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/e83993b0/uploads/origins/e906f35b-f7d9-41e1-8f0f-1561bcb226d5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1373feeaccbd146c0fd1f15898ecad6c", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/e83993b0/uploads/origins/e906f35b-f7d9-41e1-8f0f-1561bcb226d5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=cbf00e996b6d045ff12cfff8c7146b3c", "src_set": ""}, "body": "以前はついなちゃんのイラストありがとうございました。\n再びリクエストさせて頂きます。\n\n今回もついなちゃんをお願いいたします。\n\n雨が降る中、全裸にレインコートを着ていて、傘をさしているイラストです。\nレインコートは半透明で、フードが付いていないものをお願いします。\nポーズ・表情などの詳細はお任せします。\n\n以上、よろしくお願いいたします", "nc": 32, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@kashiki_main/works/135", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/1bebb5b7/uploads/origins/738bb28b-a44d-4d7f-b29c-e4b778622c43?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=30aeee39f4b41a04129d8739dbb06f14", "src_set": ""}, "private": true, "genre": "art", "tipped": true, "creator_id": 618569, "client_id": 0, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 48, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@kashiki_main/works/134", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 618569, "client_id": 3236983, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/6fc94d53/uploads/origins/df1f5887-070c-43ec-9f85-034fa696f2f8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=540ba8836822e215d6abfe017888f8f4", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/6fc94d53/uploads/origins/df1f5887-070c-43ec-9f85-034fa696f2f8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e64c80d0e96933d6ce70d53fcfd7e08a", "src_set": ""}, "body": "リクエストになります！\n下脱ぎで自分のを指で開いて見せている蕾の琴葉姉妹をお願いします", "nc": 32, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@kashiki_main/works/133", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 618569, "client_id": 768267, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/7bd0fca4/uploads/origins/794dad4d-ce2b-4197-9fd8-a775b6ff0a32?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=83708cfe99d60b74221c96dac4c4c922", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/7bd0fca4/uploads/origins/794dad4d-ce2b-4197-9fd8-a775b6ff0a32?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b4ae66c3570e394c74211e17642ee2eb", "src_set": ""}, "body": "ご無沙汰しております！\n久しぶりにリクエストを送らせていただきます。\n\n8歳サイズの男物の服を着たさとうささらさんのイラストをお願いします。\n・8歳の男が超常現象でささらさんの姿に変身してしまった、というシチュエーションをイメージしています。なお、精神や意識は8歳男のままという想定です。\n・服装は、8歳の男が着ていそうなデザインの半袖Tシャツと半ズボンでお願いします。\n・参考URL[1]の「な？すごいだろ？」のコマや参考URL[2]の一番右のように、服のサイズが合わずパツパツになっている感じにしてください（大きく膨らんだ胸でシャツが埋め尽くされている、身長が伸びたことでお腹が露出している、大きく膨らんだ尻とふとももがズボンにギチギチに詰まっている）\n・髪型や顔つき・体型は、菓色さんが普段描かれている通りのささらさんのものでお願いします。\n・セリフは「え！？おっぱい！？」「ぼくのカラダどうなってるの・・・？」でお願いします。\n・精神は男のままなので、ポーズも男っぽい感じにしてください。（内股にならない）\n・背景は無くても構いません。\n・もし可能であれば、追加で水着バージョン（上半身は裸で下半身は海パン一丁）も頂けますと幸いです。\n\n参考URL\n[1] https://www.pixiv.net/artworks/82693604\n[2] https://www.pixiv.net/artworks/57512781", "nc": 32, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@kashiki_main/works/132", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 618569, "client_id": 288621, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/cb586d6f/uploads/origins/989111fa-9ca3-4f2a-bb4d-1ac29aa56563?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7f0a6f472fa3db192febcb358fa2959e", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/cb586d6f/uploads/origins/989111fa-9ca3-4f2a-bb4d-1ac29aa56563?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=600f0a2bbc2128d2e6b42810443de888", "src_set": ""}, "body": "いつも素晴らしい作品をありがとうございます。\n今回リクエストしたいのは、先日投稿された、ゆかりさんのイラスト\nhttps://kashiki.fanbox.cc/posts/8922444\n\nこれを元にリクエストしたいと思います。\n\nゆかりさんの煽りを受けたマスターの命令で、全裸撮影するところをお願いします\nマスターから命令されたけど、イザとなると弱腰になるゆかりさんのために、雫ちゃんも参加してる感じ\n\nシチュエーションは\n時間は昼間\n人気の無い公園\n\n衣装\nゆかりさん、雫ちゃん、二人とも全裸にコートのみ\nデジカメを三脚に固定して、撮影してる感じ\n\n二人が公園のベンチに座った状態と\nコートの前を広げてるところと\n全裸でM字開脚して、アソコも広げてるところ\n\nをデジカメで撮影してる感じでお願いします\n\n可能なら、犬がやってきて、それにゆかりさんが驚いてるところもお願いします\n\n細かいところは、お任せします。\n\n色々注文が多いですが、よろしくお願いします。", "nc": 48, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@kashiki_main/works/131", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 618569, "client_id": 0, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/b7a94ff8/uploads/origins/501f9b7e-90c7-40e9-b23c-82aab4948638?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9d3f6aca9908629114c1a1ce3aaa0dd3", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/b7a94ff8/uploads/origins/501f9b7e-90c7-40e9-b23c-82aab4948638?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=11accbeb9aeb888935036276507b999f", "src_set": ""}, "body": "菓色先生の絵柄に惹かれ、このスケブに来ました。\n\n今回のリクエストですが、「吹奏楽部の弦巻マキ」をお願いします。\n利用用途は「吹奏楽部の部員募集（吹奏楽団の団員募集）」「吹奏楽の演奏会（コンサート）」などのポスターとして使います。\n\nサイズ・構図等としてはこのようなものでお願い出来るようでしたら幸いです。\n●A2サイズ（5787×8185ピクセル）で、文字が入れられるスペースがある\n●マキは金管楽器（トランペット、トロンボーンなど）を持っている\n　（楽器を吹いているかはどちらでも構いません）\n●マキの衣装は「スクール水着」「競泳水着」どちらか（以下の通り詳細あり。ポーズの構造等の理由で描けない場合は省略しても構いません）\n　いずれも、黒または白のオーバーニーソックスを履いており、乳房の先っぽが水着の上からわかるように勃っている\n・スクール水着\n　胸に「弦巻」の名前が書かれている\n・競泳水着\n　黒（もしくは紺）色にピンク色のラインの走っている\n●背景は「コンサートホール」「学園」「青空」のいすれか（金銭的・技術的な理由等で不可能な場合は、無しで構いません）\n\nご検討をお願いします。", "nc": 161, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@kashiki_main/works/130", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 618569, "client_id": 763017, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/5f2905af/uploads/origins/7127b8da-97c0-4c7f-8781-c7d706ae895b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=abac7f23149f0fb46794ae5492a4d6f0", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/5f2905af/uploads/origins/7127b8da-97c0-4c7f-8781-c7d706ae895b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=8227d4b1cb99692087c9230d425a48eb", "src_set": ""}, "body": "菓色 様\n\n前回は素晴らしい作品をいただきありがとうございました。\nまたリクエストさせていただきます。\n内容やご都合などに問題がありましたら、遠慮なくキャンセル・再送要請をしてください。\n\nリクエスト内容：\n「球詠」の武田詠深と大村白菊が\nバリカンで丸坊主にされてしまうシーンをお願いします\n\nシチュ指定：\n・デフォルト状態と断髪差分2枚を含めて全3枚の基本構成\n・ポーズは蹲踞\n・表情は涙を流しつつ睨んでいる感じで\n・2人の恰好・服装は資料URLのユニフォームとしてください（帽子無し）\n・2人ともむっちりした感じで\n・胸元はずらすか破く等しておっぱいが露出して、ズボンは脱がせて性器は露出する感じで\n・刈り手は全裸の男性（勃起中・女の子1人につき1人の男性）\n　※断髪時の体勢はバリカンの刃先を頭にあてて髪を刈っている感じで※\n\n差分指定：\n・髪が普通にある劇中通りの状態（デフォルト状態）\n・髪の半分（右半分か左半分）がバリカンで刈られたハーフ丸坊主状態（差分1）\n・髪が全部に刈り落されて完全に丸坊主になった状態（差分2）\n\n差分指定２：\n・デフォルト状態と断髪差分2枚それぞれに\n射精差分（顔や頭や胸に射精・膣内に中出し）を付けてください\n　表示非表示が切り替えられるようレイヤー分け願います\n・男性は非表示が出来るようレイヤー分け願います\n\nその他ポイント：\n・丸坊主の長さは一厘刈りで、ほとんど剃ったのと同じ位短い状態にしてください\n・五厘刈り以下の長さになると坊主頭の色味は灰青色（黒髪の場合）に近い色になります、これは肌や髪色とはまた違う色味です\n・刈った髪はそのまま床や体に落としてください\n・バリカンで刈った髪は意外と毛束となってブロック単位で落ちます、落ちた髪にも元の髪型の痕跡が所々に残ってる感じでお願いします\n※床に落ちた髪については「量」や「質感」や「長さ」が頭に付いていた時と同様にしてください\n・刈った跡（頭皮）に光沢をいれてください\n・使うバリカンのイメージは「ヘアークリッパー MODEL 5500」に似せてください\n（大きさは500ミリペットボトル位、ロゴ部分は改変願います）\n・背景の指定は無いですが床は明るい色でお願いします\n\n下記サイトでも掲示する場合があります\nhttps://www.futabafetish.com\nよろしくお願いいたします\n\nhttps://tamayomi.com/character/", "nc": 32, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@kashiki_main/works/129", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 618569, "client_id": 288621, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/a73715ed/uploads/origins/e3e96f83-661c-41f7-87de-055625f15781?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0522d7c1e621f5f079083e7efc99e746", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/a73715ed/uploads/origins/e3e96f83-661c-41f7-87de-055625f15781?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e93c3ed3c04793b183755f8afa9a098a", "src_set": ""}, "body": "前回のゆかりさんのイラスト、とても素晴らしかったです。\nhttps://skeb.jp/@kashiki_main/works/127\nそこで、その続きをリクエストしたいと思います。\n\n前回のゆかりさんのワンフィ