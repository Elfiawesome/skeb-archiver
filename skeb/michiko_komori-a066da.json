03-890c6c4dff25?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=8e2a0e7d5831421fa7229fa244ec11bf, https://si.imgix.net/45931c80/uploads/origins/a47a5889-1ccb-4ab2-9303-890c6c4dff25?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=764af2d364df1b799fc8130bef3154e3 2x, https://si.imgix.net/45931c80/uploads/origins/a47a5889-1ccb-4ab2-9303-890c6c4dff25?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=8b845003a19ad70d7a7946b2c9da09ad 3x"}, "body": "初めまして、シンプルかつ美しい線と絵に惹かれ当方の創作夫婦(男女)を描いていただきたくリクエストいたしました。\n\n■内容\nもしよろしければ、資料内の「010別衣装」で描いていただけると大変嬉しいです。\n表情やポーズ、服の簡略化等は全てお任せいたします。\n\n［キャラクター］ \n①リョラル\n150歳/190cm 魔法使い  夫\n情緒と肝臓が終わっている。 不器用。\n②アルズ \n140歳(故人)/160cm 魔女  妻\n器用でおだやか。甘やかし上手。\n\n\n■資料\nhttps://drive.google.com/drive/folders/1-C0Wyo8hfabr7wI7iRd5KM-PhKec-NnH\n\n金額や内容等、不都合がありましたら遠慮なくキャンセルしていただいて差し支えありません。\nご多忙のなか大変恐縮ですが、ご検討の程よろしくお願いいたします。", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@michiko_komori/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1898832, "client_id": 3140972, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/fc0fbda7/uploads/origins/e9ca5f24-44dc-4ee9-a870-046b3b34ea3e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=613b3c98deed61c4f114f8822626e42b", "srcset": "https://si.imgix.net/fc0fbda7/uploads/origins/e9ca5f24-44dc-4ee9-a870-046b3b34ea3e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=613b3c98deed61c4f114f8822626e42b, https://si.imgix.net/fc0fbda7/uploads/origins/e9ca5f24-44dc-4ee9-a870-046b3b34ea3e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a0ad3e5f7dfaa04db557c0bb7dec6a15 2x, https://si.imgix.net/fc0fbda7/uploads/origins/e9ca5f24-44dc-4ee9-a870-046b3b34ea3e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=c