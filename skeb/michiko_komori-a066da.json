ter(X)、Discordのアイコン/ヘッダーです！\nアイコンに設定する際はプロフィールにクレジットさせて頂きます。\n\nもし受けていただけるようであれば、よろしくお願いいたします！\n\nhttps://www.dropbox.com/sh/m31fy5xp8a5lo59/AAANaz2gNqPyCjplj-umUb9pa?dl=0", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@michiko_komori/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1898832, "client_id": 2783194, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/163b7f9e/uploads/origins/992b1be8-d4d9-4c8b-8908-cbdaf78e8df3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a74f1b84e4189c190200fc39c0a1e967", "srcset": "https://si.imgix.net/163b7f9e/uploads/origins/992b1be8-d4d9-4c8b-8908-cbdaf78e8df3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a74f1b84e4189c190200fc39c0a1e967, https://si.imgix.net/163b7f9e/uploads/origins/992b1be8-d4d9-4c8b-8908-cbdaf78e8df3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=1ba09ee312b4e88d8e1dbf1ddd640783 2x, https://si.imgix.net/163b7f9e/uploads/origins/992b1be8-d4d9-4c8b-8908-cbdaf78e8df3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e9cbc66241b797f313faa658ce787369 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/163b7f9e/uploads/origins/992b1be8-d4d9-4c8b-8908-cbdaf78e8df3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3e5ce8ced047dbcb699a64107038545e", "srcset": "https://si.imgix.net/163b7f9e/uploads/origins/992b1be8-d4d9-4c8b-8908-cbdaf78e8df3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3e5ce8ced047dbcb699a64107038545e, https://si.imgix.net/163b7f9e/uploads/origins/992b1be8-d4d9-4c8b-8908-cbdaf78e8df3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=9dd50f3eeddc373a790ab2cf64ec15fd 2x, https://si.