いる。\n〜〜なのニャ、と話すシニカルで軽薄なネコ。 \nマクレガーは契約者で面倒を見てくれる相手だが、\n上から目線でああだニャこうだニャ言っている。\n\nhttps://hexen-laboratory.notion.site/3156bd7c2d9e80cf8461fc3d17eb5336?source=copy_link\n\nhttps://hexen-laboratory.notion.site/3156bd7c2d9e800a8293d6be8328aab9?source=copy_link", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@33guLab/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3809571, "client_id": 3049865, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/5a81ef62/uploads/origins/b2628c1b-bbe8-4286-85ad-62b5310c6582?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9b923e17330f813147875e7a2c1de173", "srcset": "https://si.imgix.net/5a81ef62/uploads/origins/b2628c1b-bbe8-4286-85ad-62b5310c6582?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9b923e17330f813147875e7a2c1de173, https://si.imgix.net/5a81ef62/uploads/origins/b2628c1b-bbe8-4286-85ad-62b5310c6582?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=22a6bd5d841377e9a9578c8c53297b0b 2x, https://si.imgix.net/5a81ef62/uploads/origins/b2628c1b-bbe8-4286-85ad-62b5310c6582?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c037cd16522bc50b0def1d4d8c2eed63 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/5a81ef62/uploads/origins/b2628c1b-bbe8-4286-85ad-62b5310c6582?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f154ee53f6c3a29bb4c5c0c78b56e043", "srcset": "https://si.imgix.net/5a81ef62/uploads/origins/b2628c1b-bbe8-4286-85ad-62b5310c6582?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f154ee53f6c3a29bb4c5c0c78b56e043, https://si.imgix.net/5a81ef62/uploads/origins/b2628c1b-bbe8-4286-85ad-62b5310c6582?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&cr