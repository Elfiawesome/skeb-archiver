3b9d0-12d5-4c6f-b432-748ddcba2eaf?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=7db2e5c8909a23ae6a2e25cf65606124 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/c8458eff/uploads/origins/cb93b9d0-12d5-4c6f-b432-748ddcba2eaf?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2912a61b2ab497725629eda3dc9ff71f", "srcset": "https://si.imgix.net/c8458eff/uploads/origins/cb93b9d0-12d5-4c6f-b432-748ddcba2eaf?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2912a61b2ab497725629eda3dc9ff71f, https://si.imgix.net/c8458eff/uploads/origins/cb93b9d0-12d5-4c6f-b432-748ddcba2eaf?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=5d5ca7d0bb2c151c4f665420390a41d4 2x, https://si.imgix.net/c8458eff/uploads/origins/cb93b9d0-12d5-4c6f-b432-748ddcba2eaf?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=255dd5e8b62326f032fc2260131cb4f0 3x"}, "body": "先生、こんにちは～ 改めてお願いですが、私のオリジナルキャラクター（OC）を描いていただけないでしょうか (⸝⸝ɞ̴̶̷ ·̮ ‹⸝⸝ᐡ) ⟡.·\n\n今回描いていただきたいのは、クマ族の悪魔の兄弟です\n\nお兄さん\n種族：熊族の悪魔（熊＋サーモン寿司）\n怠惰の区に住んでいる。暴食の区に住む弟がいる。\n身体再生能力が高い。暴食の区の貴族の家に生まれたが、生まれつき食物の血筋を持っていたため、見捨てられ、貴族たちに食われる存在となった。\n重度の嗜眠症で、普段は半覚醒状態にあるため、事故を起こしやすいが、またすぐに復活する\n\n弟\n種族：熊族の悪魔（熊＋バターチェック柄クッキー）\n暴食区に住む貴族の悪魔。食物の特徴を持つが、食物を食べる悪魔としての本能も備えている。自身の食欲には嫌悪感を抱いているが、兄を食べたいという欲望を抑えきれず、そのため自分の口を縫い付けている。兄に対して本能的な保護欲を持っている \n\n依頼について：二人の関係はケーキとフォークのようなものです。やり取り、髪型、服装、アクセサリーなどは、イメージに合わせて自由にアレンジしてください ˙ᵕ˙ᰔ\n\nもし依頼金額が不足している場合は、お知らせいただければ再送いたします。よろしくお願いいたします꜀(˘꒳˘ ꜀)", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@33guLab/works/14", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3809571, "client_id": 23772, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/47e02764/uploads/origins/ac7bc926-633e-44f4-b647-5957d93ba0d4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=11db179bf2f9999f94e61b28733d5438", "srcset": "https://si.imgix.net/47e02764/uploads/origins/ac7bc926-633e-44f4-b647-5957d93ba0d4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=11db179bf2f9999f94e61b28733d5438, https://si.imgix.net/47e02764/uploads/origins/ac7bc926-633e-44f4-b647-5957d93ba0d4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=5772bab73f87ee1c35f001e2ef4e585e 2x, https://si.imgix.net/47e02764/uploads/origins/ac7bc926-633e-44f4-b647-5957d93ba0d4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=0aa29e5ceddea46de64985ff53181a30 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/47e02764/uploads/origins/ac7bc926-633e-44f4-b647-5957d93ba0d4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c861d9be20e2f6613548b184983dd8a7", "srcset": "https://si.imgix.net/47e02764/uploads/origins/ac7bc926-633e-44f4-b647-5957d93ba0d4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c861d9be20e2f6613548b184983dd8a7, https://si.imgix.net/47e02764/uploads/origins/ac7bc926-633e-44f4-b647-5957d93ba0d4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=691305c87cebd421bb907e4edd012402 2x, https://si.imgix.net/47e02764/uploads/origins/ac7bc926-633e-44f4-b647-5957d93ba0d4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=9212e1781777385b736d93b31183f0c0 3x"}, "body": "先日は素敵なイラストをありがとうございました。\nとてもうれしく、いつも眺めて元気を出しています！\n\nまたぜひうみねこさまの絵柄で見たいキャラがおりまして、\nリクエストさせていただきました。\n\nイラストの内容はおまかせいたします。\n自由に楽しく描いていただけたら嬉しいです！\nイラストレーターさんの描かれるラフなども見るのが好きなので、\nもし可能であればアイデアスケッチなども残しておいていただけると嬉しいです。\n\nもし差し支えございませんでしたら、\n以下の3キャラクターにてご制作いただきたいです。 \n\n●ロンリ・ヴォルクス \n16歳、171cm。人狼の少年。\n三人の中だと比較的常識人でツッコミ役のやれやれ系。\nいや、と変だ……が口癖。ふたりの押しに流されることが多い。\nふたりに生活を管理・保証されている。末っ子ポジション。\n\n●ヴァネッサ・カーター \n26歳、179cm。運び屋業の女性エージェント。\nスタイル抜群で面倒見がよい。明るく快活で知り合いが多い。\n壊滅的に料理が下手で、ふたりからはやんわり苦言を呈されている。\nロンリの保護者で、アンリの部下。お姉ちゃんポジション。\n\n●アンリ・ロシャ \n32歳、191cm。研究者職の男性エージェント。 \n楽しいことと映画と情操教育が大好きな享楽主義者。\n特にB級映画や低予算映画をふたりに見せるのが何よりの趣味。\nロンリの管理者で、ヴァネッサの上長。お兄ちゃんポジション。\n\n●その他 \n3人が所属している組織は、SCP財団をイメージソースとした組織です。\n3人はそれぞれ収容対象、運び屋、研究者の役割を持っています。 \n3人の仲はすこぶるよく、よくみんなでB級映画を観ています。\n清潔かつ潔癖な組織で擬似家族として暮らしている3人組になります。\n\nご検討のほどよろしくお願いいたします。\n\nhttps://hexen-laboratory.notion.site/32e6bd7c2d9e8037940fd4693becdcd1?source=copy_link", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@33guLab/works/13", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3809571, "client_id": 3658386, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/f90d6da0/uploads/origins/ba5d3bc1-3e7f-4748-8fc8-2671cf29a56b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4beaf4dd3c6d9d4679143a73d324b9fe", "srcset": "https://si.imgix.net/f90d6da0/uploads/origins/ba5d3bc1-3e7f-4748-8fc8-2671cf29a56b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4beaf4dd3c6d9d4679143a73d324b9fe, https://si.imgix.net/f90d6da0/uploads/origins/ba5d3bc1-3e7f-4748-8fc8-2671cf29a56b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=6ac47e2b1819b20ec1ebe681e58dba4f 2x, https://si.imgix.net/f90d6da0/uploads/origins/ba5d3bc1-3e7f-4748-8fc8-2671cf29a56b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=1880ef3aeea60396c4e1b2c187b40229 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/f90d6da0/uploads/origins/ba5d3bc1-3e7f-4748-8fc8-2671cf29a56b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=17d15efa2ab15b5322ede1e803794bfb", "srcset": "https://si.imgix.net/f90d6