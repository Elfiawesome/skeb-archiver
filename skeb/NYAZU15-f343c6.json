gestions if it will help drawing the character. \nDrinking Cream Soda or lemonade, Blowing bubbles, water, and drinking lemonade. \n\nThank you for all your hardwork! If possible I would like to use this artwork for my streams, Videos and social media. I will always make sure to credit you as the artist! Thank you!\n\nhttps://drive.google.com/drive/folders/1rK5d79jBFWPeCfjCK7I7jGmcC4AYvn7I?usp=sharing", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@NYAZU15/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2892877, "client_id": 1551454, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/e7eca757/uploads/origins/a0b67994-6c2b-4033-862a-fce18e4812bc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=00f1a10e0f36050a5be2f9b76e0cf5e8", "srcset": "https://si.imgix.net/e7eca757/uploads/origins/a0b67994-6c2b-4033-862a-fce18e4812bc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=00f1a10e0f36050a5be2f9b76e0cf5e8, https://si.imgix.net/e7eca757/uploads/origins/a0b67994-6c2b-4033-862a-fce18e4812bc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=7e61da2908c68e09df6df3c76a832f89 2x, https://si.imgix.net/e7eca757/uploads/origins/a0b67994-6c2b-4033-862a-fce18e4812bc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e9047c415f4121061f53a778aae7237f 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/e7eca757/uploads/origins/a0b67994-6c2b-4033-862a-fce18e4812bc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5968f3b6c3b278a5834a1a149b667f53", "srcset": "https://si.imgix.net/e7eca757/uploads/origins/a0b67994-6c2b-4033-862a-fce18e4812bc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5968f3b6c3b278a5834a1a149b