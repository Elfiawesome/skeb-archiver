46ece/uploads/origins/3bb8cf92-47b7-499a-9be5-182a0d59d1c0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=1adff03e7624136d4fcf5d9d9a821503 2x, https://si.imgix.net/5c046ece/uploads/origins/3bb8cf92-47b7-499a-9be5-182a0d59d1c0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=6ebed9ec344a563c5fd90780aac3cd80 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/5c046ece/uploads/origins/3bb8cf92-47b7-499a-9be5-182a0d59d1c0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=54e25f1bd99e66400682e6d58eef7f1d", "srcset": "https://si.imgix.net/5c046ece/uploads/origins/3bb8cf92-47b7-499a-9be5-182a0d59d1c0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=54e25f1bd99e66400682e6d58eef7f1d, https://si.imgix.net/5c046ece/uploads/origins/3bb8cf92-47b7-499a-9be5-182a0d59d1c0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=538475b312db158be0bdcb4c16afc76e 2x, https://si.imgix.net/5c046ece/uploads/origins/3bb8cf92-47b7-499a-9be5-182a0d59d1c0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=03104ea872bafd8e1fb59dbf484fe7fe 3x"}, "body": "初めてまして。初めてのリクエスト失礼します。\n\n　プリンセス/コネクトリダイブのキャラクターのペコリーヌの膨体をお願いしたいです。\n\n通常の服装でお願いします。\nhttps://priconne-redive.jp/character/gourmet_edifice/\n\nネタ\nアニメ力ービィの肥惨！スナックジャンキーに出てくるデブリチン入りポテチを食べてしまう。そのポテチにハマってしまい、夢中になって食べ続けてしまいブクブクに膨れてしまう。膨れていながらもなおポテチを食べ続けてしまう。\nでお願いします。\n\n\n膨体は以前描いていただいたユイと同じ様なタプンとした膨体で、全体を見える様にお願いします。\nhttps://x.com/sanshouo999/status/1631629487699025920?s=46&t=mySeOMd3W_wRB20yhvJuPA\n\n膨体する前の普通の体型も描いてもらえると、又可能でしたら膨れる瞬間も描いて頂けたらありがたいです。\n\nよろしくお願いします。", "nc": 49, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@Sanshouo999/works/10", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id