のため大きく膨らんだ状態をお願いします。\n身体は思いっきり膨らませて肉盛り盛りでお願いしたいですが、それ以上に特に顔を強調し顔肉を限界まで盛り盛り状態にしていただけますと嬉しいです。\n\n希望は以上です。よろしくお願いします。\n\n\n■キャラクター：『その着せ替え人形は恋をする』喜多川海夢\n　　　　　　　　（キャラクター参考「https://bisquedoll-anime.com/character/#1」", "nc": 185, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@Sanshouo999/works/9", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2352769, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/73358667/uploads/origins/6b9d726d-dc06-4342-bee5-12978f9a19ea?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f62177b7ba70b5b46adceee3fd1208d2", "srcset": "https://si.imgix.net/73358667/uploads/origins/6b9d726d-dc06-4342-bee5-12978f9a19ea?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f62177b7ba70b5b46adceee3fd1208d2, https://si.imgix.net/73358667/uploads/origins/6b9d726d-dc06-4342-bee5-12978f9a19ea?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=1959c280043d60c32d8a44af3679a13d 2x, https://si.imgix.net/73358667/uploads/origins/6b9d726d-dc06-4342-bee5-12978f9a19ea?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a5bcf1257fce18bcf6ab3bafba633967 3x"}, "duration": null, "nsfw": true, "hardcore": true, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/73358667/uploads/origins/6b9d726d-dc06-4342-bee5-12978f9a19ea?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f149d46dabac3deeb329fc46d9c1d73b", "srcset": "https://si.imgix.net/73358667/uploads/origins/6b9d726d-dc06-4342-bee5-12978f9a19ea?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f149d46dabac3deeb329fc46d9c1d73b, https://si.imgix.net/73358667/uploads/origins/6b9d726d-dc06-4342-bee5-12978f9a19ea?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=ca24a7dc22562bb5769a9e52fd7688d0 