ks": [{"path": "/@kitagoukai/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "comic", "tipped": false, "creator_id": 3481225, "client_id": 1031168, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/4a6cff60/uploads/origins/77919f4f-5cc1-457f-bdf0-97d538f3818d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e8ebea215a8757b9bc2b67da144256f1", "srcset": "https://si.imgix.net/4a6cff60/uploads/origins/77919f4f-5cc1-457f-bdf0-97d538f3818d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e8ebea215a8757b9bc2b67da144256f1, https://si.imgix.net/4a6cff60/uploads/origins/77919f4f-5cc1-457f-bdf0-97d538f3818d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=890f296012af8026e7c0bf20fccebdcc 2x, https://si.imgix.net/4a6cff60/uploads/origins/77919f4f-5cc1-457f-bdf0-97d538f3818d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ff9fefe68824950b4ef199e365b5b528 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/4a6cff60/uploads/origins/77919f4f-5cc1-457f-bdf0-97d538f3818d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5fa7bc54ae0a7cf964bc65fb01983cf7", "srcset": "https://si.imgix.net/4a6cff60/uploads/origins/77919f4f-5cc1-457f-bdf0-97d538f3818d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5fa7bc54ae0a7cf964bc65fb01983cf7, https://si.imgix.net/4a6cff60/uploads/origins/77919f4f-5cc1-457f-bdf0-97d538f3818d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=108b15303f94a3fee6f9c03a06a5f869 2x, https://si.imgix.net/4a6cff60/uploads/origins/77919f4f-5cc1-457f-bdf0-97d538f3818d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=ba5b2305eb0c9dfa4287f033024528ad 3x"}, "body": "Nice to meet you 北郷海-san, I like your art so much that I would like to submit a personal request to you for my oc.\nあなたが描いたキャラクターはとても生命力があって好きです！\n\n■キャラ\nLink: https://sta.sh/212egacz4b2j\nあなたに彼らの【heif】を描いてほしい。\n\n■宛名\n中国語で「那些風景你替我去看吧」\n\n■内容\nシオンが半月に一度、影の反発による痛みを受けて、部屋に自分を閉じこめて誰の近づきや助けも拒むそのシーンを描いてほしいです。ミナミは無理やり部屋に入ってくる（多分彼に攻撃されるだろうね）。\n影の反噬は神経の末端一つ一つが激痛に苛まれるようで、理性を保つことすら困難になる。南はそれを経験したことがあったから、その感覚をよく知っている。彼女はただ紫苑を抱きしめ、痛みに理性を失った紫苑が肩に噛みついてきても離さなかった。紫苑が今の姿を見られるのを嫌がっていることもわかっていたが、南は静かに彼の顎を掴み、自分を見つめさせた。「私は今、あなたが泣くのを見たいのです。その泣きべそをかいた顔を曝け出しなさい。」\nそのようなストーリーを基に描いていただけたらうれしいです。\nどうぞご自由にお願いします。💗\n\nとはいえ最終的には資料やキャラクター性などを元にあなたのお好みでご自由に描いて頂ければ幸いです。\n没ラフや下描きなどがあれば残したままにしていただけると嬉しいです、個人的な解読があればもとても嬉しいです！画像データはpngもしくはpsdだと助かります！\n以上、私の依頼を考慮していただき、ありがとうございました！*ᴗ ᴗ)⁾⁾", "nc": 9, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@kitagoukai/works/5", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/0ce474a8/uploads/origins/506e213a-8875-4f34-a959-f32d4731faa3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=dfa35fa940cde06672810e9e7e422302", "srcset": "https://si.imgix.net/0ce474a8/uploads/origins/506e213a-8875-4f34-a959-f32d4731faa3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=dfa35fa940cde06672810e9e7e422302, https://si.imgix.net/0ce474a8/uploads/origins/506e213a-8875-4f34-a959-f32d4731faa3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=4ab7e705d86d2528fc7d29bd7b327a73 2x, https://si.imgix.net/0ce474a8/uploads/origins/506e213a-8875-4f34-a959-f32d4731faa3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVAT