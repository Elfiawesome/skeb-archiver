fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=199a5d86ca309f237a6ef43b254138f6, https://si.imgix.net/6ffd4ff9/uploads/origins/3c4551b6-9989-415a-85b0-6396baf0ee9a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a8fe8d544e97433a163ce06356a99609 2x, https://si.imgix.net/6ffd4ff9/uploads/origins/3c4551b6-9989-415a-85b0-6396baf0ee9a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=fc17335c496b5be1fccc2ca62ae3b78d 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/6ffd4ff9/uploads/origins/3c4551b6-9989-415a-85b0-6396baf0ee9a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b3acdb718df05fcfe31f319b8cd54d39", "srcset": "https://si.imgix.net/6ffd4ff9/uploads/origins/3c4551b6-9989-415a-85b0-6396baf0ee9a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b3acdb718df05fcfe31f319b8cd54d39, https://si.imgix.net/6ffd4ff9/uploads/origins/3c4551b6-9989-415a-85b0-6396baf0ee9a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=32f72f5e1383b5d7d3ac8bd82e6edf68 2x, https://si.imgix.net/6ffd4ff9/uploads/origins/3c4551b6-9989-415a-85b0-6396baf0ee9a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=58845be2cb2ad1a6bf4d395b47570e2a 3x"}, "body": "北郷海さん、こんにちは！\n北郷海さんの作品が大好きです、是非自分のオリジナルキャラクターを描いていただきたいです。\n詳しい立ち絵やキャラクター設定などは下記のリンク先にまとめました。\nもし苦手な場合、断っても構いません。金額が不足でしたら追加も可能です。\nよろしくお願いいたします！\n\nhttps://drive.google.com/drive/folders/1PFIWfOw47dLYXwgqdGVCf1aze4lsMjr_?usp=drive_link", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@kitagoukai/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "comic", "tipped": false, "creator_id": 3481225, "client_id": 3323736, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.ne