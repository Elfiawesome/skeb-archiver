loads/origins/bb1c77d9-adc9-4684-8883-d8bc99bfa73a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9e66d25fccf5836f79422d85e440a4c4", "srcset": "https://si.imgix.net/daa5eb34/uploads/origins/bb1c77d9-adc9-4684-8883-d8bc99bfa73a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9e66d25fccf5836f79422d85e440a4c4, https://si.imgix.net/daa5eb34/uploads/origins/bb1c77d9-adc9-4684-8883-d8bc99bfa73a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e0206590c0aba32f467b43489c27ddd6 2x, https://si.imgix.net/daa5eb34/uploads/origins/bb1c77d9-adc9-4684-8883-d8bc99bfa73a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=803c214c65e3265f0e6090409851d4e6 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/daa5eb34/uploads/origins/bb1c77d9-adc9-4684-8883-d8bc99bfa73a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=7bd48d91ca08e4dae3374a2ba8ea2a1f", "srcset": "https://si.imgix.net/daa5eb34/uploads/origins/bb1c77d9-adc9-4684-8883-d8bc99bfa73a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=7bd48d91ca08e4dae3374a2ba8ea2a1f, https://si.imgix.net/daa5eb34/uploads/origins/bb1c77d9-adc9-4684-8883-d8bc99bfa73a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=e537f30dd5bbee1da3eb29b47bace528 2x, https://si.imgix.net/daa5eb34/uploads/origins/bb1c77d9-adc9-4684-8883-d8bc99bfa73a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=a4fe4a1ba75e4b840bb9094ab27028b0 3x"}, "body": "こんにちは、私のVTuberキャラクターの絵をお願いしたいのですが。\n彼女は人間の耳を持っていて、サキュバスの角、翼、尻尾を持っています。\n\n乳首が隠れるような白いシャツを着て、白と緑のストライプのパンティーを履いています。\n寝起きみたいな感じで。\n\nBlueskyの投稿のようにSNSで使いたいです。\nURLの参考画像、よろしくお願いします！\n\nhttps://i.imgur.com/oQivf5x.png", "nc": 48, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@taisandesuyo/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 110540, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/c71e8bbf/uploads/origins/7003b225-3396-417b-8703-e1eccb3f04e6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7356716eff950feee5953d4d612e4fe0", "srcset": "https://si.imgix.net/c71e8bbf/uploads/origins/7003b225-3396-417b-8703-e1eccb3f04e6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7356716eff950feee5953d4d612e4fe0, https://si.imgix.net/c71e8bbf/uploads/origins/7003b225-3396-417b-8703-e1eccb3f04e6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=586702d60268b028489e1f2d4c878859 2x, https://si.imgix.net/c71e8bbf/uploads/origins/7003b225-3396-417b-8703-e1eccb3f04e6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=aa5a9a37dfb20460438be387f21d4225 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/c71e8bbf/uploads/origins/7003b225-3396-417b-8703-e1eccb3f04e6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=91c5ca4ff0343e3bb65b4743a382db62", "srcset": "https://si.imgix.net/c71e8bbf/uploads/origins/7003b225-3396-417b-8703-e1eccb3f04e6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=91c5ca4ff0343e3bb65b4743a382db62, https://si.imgix.net/c71e8bbf/uploads/origins/7003b225-3396-417b-8703-e1eccb3f04e6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=665d038edaa28e4e74856bdf8a0b6944 2x, https://si.imgix.net/c71e8bbf/uploads/origins/7003b225-3396-417b-8703-e1eccb3f04e6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=f7f048b453cc75bca0df478e493dad82 3x"}, "body": "ころねるねるねさま、リクエストします。\nリクエストを送ろうと思った動機は、貴方様の描かれるパーシュースが世界で一番カワイイと思ったからです。\n\nアズールレーンのパーシュースを描いてほしいです。\nぶっきらぼうなパーシュースに恥ずかしいポーズと恥ずかしい掛け声をあげているイラストを描いてほしいという内容になります。\n\nまず彼女には以下の衣装を着させてください。\n衣服：http://www.mizugishop.com/fs/mizugishop/n2ma022269-2xl\n\n次にしてほしい具体的な行動を書きます。\n以上の服着たパーシュースに以下の行動をさせたイラストを描いてほしいです。\n\nシチュエーション：便利なスマホアプリによって身体の自由がきかなくなったパーシュース\n\nパーシュースの表情は、顔を真っ赤にして涙目であり、全身は震えている。\n首には同作品のベルファストと同じ首輪をしている。\n\nそんなパーシュースは「ハイグレのポーズ」をしながら\n「ハイグレ、ハイグレ」と小声で発声させられている。\n\n時が経った後のイラストも描いてほしく\n\n便利スマホアプリの強度が高まり、パーシュースは「ハイグレのポーズ」に悦びを感じるようになる。\nパーシュースちゃんはハート目になり、涎を垂らしている。\n\n着衣の股には湿り気も目立つようになる。\n\nさらに、大きな声で「ハイグレ！ハイグレッ！！」と叫び声をあげるようになっていく。\n\n以上の内容でパーシュースちゃんを頭から足元まで描いてほしいです。\n胸の大きさはアズールレーン公式絵と同じ感じでお願いします。\n衣装にあるロゴエンブレムはロイヤル陣営のエンブレムに置き換えてください。\n\n\nリクエストは以上です。\n\nハイグレとは\nhttps://dic.pixiv.net/a/%E3%83%8F%E3%82%A4%E3%82%B0%E3%83%AC\n\nハイグレポーズ参考\n\nhttps://x.com/tvasahi_cs/status/682335554340405248", "nc": 137, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@taisandesuyo/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 110540, "client_id": 937073, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/c6858fc6/uploads/origins/fe39c44f-38e9-4671-bb90-03e5769ac910?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=84179e9e26c90b2f71d99c06c7e349ee", "srcset": "https://si.imgix.net/c6858fc6/uploads/origins/fe39c44f-38e9-4671-bb90-03e5769ac910?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=84179e9e26c90b2f71d99c06c7e349ee, https://si.imgix.net/c6858fc6/uploads/origins/fe39c44f-38e9-4671-bb90-03e5769ac910?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=0331608550b54b816ec8200d43ee52fd 2x, https://si.imgix.net/c6858fc6/uploads/origins/fe39c44f-38e9-4671-bb90-03e5769ac910?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=909426ce6bd26462d5cffcca622c9f38 3x"}, "duration": null, "nsfw": true, "hardcore": true, "consored_thumbnail_image_urls": 