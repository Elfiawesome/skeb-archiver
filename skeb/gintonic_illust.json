たわっているような感じだと最高です。\n・身体、顔や眼鏡にまで精液がかかっている(眼鏡が少しずれている)\n・可能でしたら破瓜表現の描写(秘部から溢れた精液に血が混ざっている等)をお願いします\n・壊れた武器が転がっている\n・太ももに使用回数を表すタリーマークが書かれている\n・余裕がありましたら、陵辱前のイメージで、涙目で悔しそうに睨みつけている表情の差分をいただければと思います。\n\n\n以上となります。\n要望が多くりますが、ご検討頂けたら幸いです。\n\nhttps://drive.google.com/drive/folders/163MiPplTGDRmaktdJB4Fy84MUhXPfCgG", "nc": 184, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@gintonic_illust/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3773484, "client_id": 148312, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/fb15ad4e/uploads/origins/bf3951f5-a310-4da2-ad6e-aa92c72be75e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=05934156aea39fbb5dc46b8e246f0fa9", "srcset": "https://si.imgix.net/fb15ad4e/uploads/origins/bf3951f5-a310-4da2-ad6e-aa92c72be75e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=05934156aea39fbb5dc46b8e246f0fa9, https://si.imgix.net/fb15ad4e/uploads/origins/bf3951f5-a310-4da2-ad6e-aa92c72be75e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b3634b8e11e418312ecfe996b1870aa3 2x, https://si.imgix.net/fb15ad4e/uploads/origins/bf3951f5-a310-4da2-ad6e-aa92c72be75e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=dd2e04a2d4198927a7a729f94840aab8 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/fb15ad4e/uploads/origins/bf3951f5-a310-4da2-ad6e-aa92c72be75e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9069bfcef7e4aa5416e7db59766c44ef", "srcset": "https://si.imgix.net/fb15ad4e/uploads/origins/bf3951f5-a310-4da2-ad6e-aa92c72be75e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9069bfcef7e4aa5416e7db59766c44ef, https://si.imgix.net/fb15ad4e/uploads/origins/bf3951f5-a310-4da2-ad6e-aa92c72be75e?