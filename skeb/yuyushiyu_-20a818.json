-cc7f-4337-ac81-a8d37c6bd986?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=a15e2949943b04166e1f0431f7d982c1 2x, https://si.imgix.net/31519079/uploads/origins/231c7696-cc7f-4337-ac81-a8d37c6bd986?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=181385c221185b0f27136f1d376cfc1e 3x"}, "private": true, "genre": "art", "tipped": true, "creator_id": 1060750, "client_id": 2178312, "nc": 16}, {"path": "/@yuyushiyu_/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1060750, "client_id": 909214, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/363bf825/uploads/origins/09f7ae2d-3792-4028-bfee-5d220708d623?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=db87deb8a126296445debad75e40f62b", "srcset": "https://si.imgix.net/363bf825/uploads/origins/09f7ae2d-3792-4028-bfee-5d220708d623?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=db87deb8a126296445debad75e40f62b, https://si.imgix.net/363bf825/uploads/origins/09f7ae2d-3792-4028-bfee-5d220708d623?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b3dff76df2fe3d4ba0122d33877cdde2 2x, https://si.imgix.net/363bf825/uploads/origins/09f7ae2d-3792-4028-bfee-5d220708d623?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=5576222a3f32c419447166a6b1d3f099 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/363bf825/uploads/origins/09f7ae2d-3792-4028-bfee-5d220708d623?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a1c3c2b5fc6442cb93a6b6afd8c422f8", "srcset": "https://si.imgix.net/363bf825/uploads/origins/09f7ae2d-3792-4028-bfee-5d220708d623?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a1c3c2b5fc6442cb93a6b6afd8c422f8, https://si.imgix.net/363bf825/uploads/origins/09f7ae2d-3792-4028-bfee-5d220708d623?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=8321db1ec40a07e1ee0658524cc9b9b9 2x, https://si.imgix.net/363bf825/uploads/origins/09f7ae2d-3792-4028-bfee-5d220708d623?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=5315d366cd400a78d27c063084813af7 3x"}, "body": "こんにちは、はじめまして。もしよろしければリクエストさせていただきたいのですが...キャラクターはリンバス社のヘルマンと私のオリジナルキャラクターのヴェディオヴィスです。\n\n関係詳細\nヘルマンとヴェディオヴィスは物語の同じ敵対グループの同僚です。ヘルマンはヴェディオヴィスをとてもかわいいと思っており、彼女に愛情を注ぐことを好む。ヘルマンはこの関係において主導権を握る傾向がある。ヴェディオヴィスは愛情表現を恥ずかしがるが、ヘルマンの愛情を受けるのは好きである。ヴェディオヴィスはヘルマンのことを「王子様」と思っている。二人はお互いに少し独占欲もあるが、それを認めようとしない。\n\nリクエスト詳細\n可能であれば、サンプル投稿にある3番目の例のような構図にしていただけるとうれしいです。https://twitter.com/yuyushiyu_/status/1715225463986209091/photo/3\n\nモノクロイラストのみの場合は、できればヴェディオヴィスの肌の色が青白くないことを表現するためにグレートーンでお願いします。ただし、3つ目のサンプルのような構図が無理な場合は、他の構図でもOKです。カップルのポーズやシチュエーションは問いませんので、ご自由にどうぞ。また、服装はカジュアル、フォーマルなど自由ですが、普段着でもOKです。\n\nその他の詳細\n- ヘルマンはヴェディオヴィスより背が高い\n- 制服のまま描く場合、ヴェディオヴィスの衣装は参考資料に2種類ありますので、好きな方を描いてください。\n- ヴェディオヴィスは何があっても手袋を外さないので、衣装を変えても手袋をして描いてください。\n- ヴェディオヴィスのハンドジュエリーは簡略化・調整可能です。\n\n長文失礼しました。分量が足りない場合はお気軽に再送してください。また、何らかの理由でキャンセルされる場合もOKです。依頼が受理されましたら、よろしくお願いします。ありがとうございました！\n\nhttps://drive.google.com/drive/folders/1zLh0p7FCWWfYYwK8BHkdgcp3tTZDuRsr", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@yuyushiyu_/works/1", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/88fb1f0c/uploads/origins/515822b9-dfd6-4925-9c14-3a82bab82d52?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=16e24c27b424f252c048429add40a907", "srcset": "https://si.imgix.net/88fb1f0c/upload