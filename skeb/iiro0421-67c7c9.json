です。\n全身でも腰上でも大丈夫です。お任せします。\n\n画像3枚添付しております。よろしくお願いします。\n\nタイトルやイラストレーターとして異色さんのお名前を入れて欲しいです。もしくは納品後に文字を入れることを許可してもらえると助かります。\n\n注文が多くて申し訳ないです。でも、引き受けてもらえると嬉しいですが、コストが見合わないようでしたら断ってくださいませm(*_ _)m\n\nhttp://bakumatsu.fc2web.com/irai.html", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@iiro0421/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1362855, "client_id": 1414269, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/01c2deb3/uploads/origins/5b8a862b-5490-4cb5-8e38-936de449bfa8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d7849fb1b53b996b165815c90761157f", "srcset": "https://si.imgix.net/01c2deb3/uploads/origins/5b8a862b-5490-4cb5-8e38-936de449bfa8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d7849fb1b53b996b165815c90761157f, https://si.imgix.net/01c2deb3/uploads/origins/5b8a862b-5490-4cb5-8e38-936de449bfa8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c642788a98effa5e8f2ddd8fc5de5a13 2x, https://si.imgix.net/01c2deb3/uploads/origins/5b8a862b-5490-4cb5-8e38-936de449bfa8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=127d5249e0ac6dc720296f376d4064b2 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/01c2deb3/uploads/origins/5b8a862b-5490-4cb5-8e38-936de449bfa8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=4bb844a6878fafec5550661f2ab6086f", "srcset": "https://si.imgix.net/01c2deb3/uploads/origins/5b8a862b-5490-4cb5-8e38-936de449bfa8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=4bb844a6878fafec5550661f2ab6086f, https://si.imgix.net/01c2deb3/uploads/origins/5b8a862b-5490-4cb5-8e38-936de449bfa8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&b