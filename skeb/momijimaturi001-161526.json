ploads/origins/211d202a-f470-468e-ab0a-7c691fe93d06?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b8a9146a821a46ef536aa69cbec263f6 2x, https://si.imgix.net/4c611941/uploads/origins/211d202a-f470-468e-ab0a-7c691fe93d06?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=49d5e02da478b4b48c575f7e41a0d43a 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/4c611941/uploads/origins/211d202a-f470-468e-ab0a-7c691fe93d06?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2a58ff5138d34b289bf3af47e31f2fff", "srcset": "https://si.imgix.net/4c611941/uploads/origins/211d202a-f470-468e-ab0a-7c691fe93d06?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2a58ff5138d34b289bf3af47e31f2fff, https://si.imgix.net/4c611941/uploads/origins/211d202a-f470-468e-ab0a-7c691fe93d06?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=32d8f1f4ba459528c4512de98a720fb5 2x, https://si.imgix.net/4c611941/uploads/origins/211d202a-f470-468e-ab0a-7c691fe93d06?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=dcb8d2741fb495b13611600fab33602a 3x"}, "body": "ぬまみずき先生はじめまして。\nGuildCQ所属のVtuber紅記えり(@Kurenagieri)さんのイラストを描いていただきたいです。\n\n【構図など】 \n服装…部屋着 新衣装 上着あり\n髪型…片目隠しツインテール\n\nポーズ……ベッドか床に女の子座りしている\n顔や耳などが見切れないようにお願いします。\n\n【使用用途】\n紅記えりさんへのプレゼントとして、紅記えりさんご本人に限りの配信活動での使用許可を頂きたいです。\n\n【その他】\n背景を描いて頂ける場合、人物・背景等がレイヤー分け出来るPSDデータまたはPNGで頂きたいです。\n宜しくお願い致します。\n\n【参考サイトなど】\nhttps://lit.link/kurenagieri\nhttps://www.fanbox.cc/@kurenagieri/posts/5783559", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@momijimaturi001/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 839869, "client_id": 747601, "vtt_url": null, "thumbnail_image_urls": {"src": "ht