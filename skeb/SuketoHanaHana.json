スのペンダント（金色の花びらがついた灰色の三角形の装置）は、秘密の通信装置（基本的には高級電話）である。外して電話のように見ることもできる。タップするとホログラフィック・スクリーンを投影することもできる。\n\n彼女の武器のオレンジ色の部分は光ることができるが、それは熱を帯びているときだけ。常に光っているわけではない。\n\nネメシス自身は信じられないほど狡猾で、ずる賢く、カリスマ性があり、残酷だ。  また、信じられないほど人を操る。\n\nモチーフは蝶と逆さ松明。\n\nドライブ：https://drive.google.com/drive/folders/1CHqf6Awv0Z12EcPqY72dZqt27I55FSoZ?usp=sharing", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@SuketoHanaHana/works/111", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/87ec71b3/uploads/origins/3fcb8a33-8eb0-4f09-b510-f3ef76cfad82?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=30ca64ab1da8d1eefa369c326087f73c", "src_set": ""}, "private": true, "genre": "art", "tipped": false, "creator_id": 2047323, "client_id": 0, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 0, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@SuketoHanaHana/works/110", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/1524b857/uploads/origins/e70980aa-a9cf-45b7-a26c-85b347ba4942?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=592d32cf93d11719e5274a3cfd4148bf", "src_set": ""}, "private": true, "genre": "art", "tipped": false, "creator_id": 2047323, "client_id": 0, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 1, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@SuketoHanaHana/works/109", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/f5f60c74/uploads/origins/56f84061-35e1-48d0-8994-e824ab2c7e0a?bg=%23fff&aut