f69-d39962bf1a23?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=2113470b30e476fab226c2f6da7042d3 2x, https://si.imgix.net/c90f0b14/uploads/origins/0fa40210-d4f7-433a-9f69-d39962bf1a23?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=37d4aad9d48b29af4a1f8f0fcc72f242 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/c90f0b14/uploads/origins/0fa40210-d4f7-433a-9f69-d39962bf1a23?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=27e881bbf142f1e030f9747939857481", "srcset": "https://si.imgix.net/c90f0b14/uploads/origins/0fa40210-d4f7-433a-9f69-d39962bf1a23?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=27e881bbf142f1e030f9747939857481, https://si.imgix.net/c90f0b14/uploads/origins/0fa40210-d4f7-433a-9f69-d39962bf1a23?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=503b2d8b2fa5228b1700bc5448c5e620 2x, https://si.imgix.net/c90f0b14/uploads/origins/0fa40210-d4f7-433a-9f69-d39962bf1a23?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=f8827051d19673c91674d6cd5d2dc87e 3x"}, "body": "ふーさん、こんみすきーです。しゃどかのです。\n\nご退院おめでとうございます。これからも健康に、幸せに過ごせるよう願っております。\n退院祝いとして(言い方含め)だいぶ変なのですが(お金のやり取りということで...)ご依頼のご連絡をさせていただきました。\n\n先日散々ノートしてた通りなのですが、うちのコのイラストをお願いしたく思います。\n\n\nうちのコの設定等は以下のノートを参考にするようお願いいたします。\nhttps://misskey.io/notes/a7cuc2hc96sj04uv\n\n以下原文ママ\n・♀(生えてる)\n・アホ毛\n・耳(耳ではない)\n・やや寸胴\n・175cmくらいある\n・C\n・おなかくらいまでの後髪\n・頭周りはボブっぽい\n・髪色は薄い茶色だったり赤っぽかったりする\n・目は蛍光緑\n・服はまぁ、青のカーディガンと赤リボン\n・実際何を着せてもOK\n\n\n基本的に特別な指定はありませんが、原画に準拠しなくても良いのでふーさん本来の絵柄のままで、描きやすいように描いていただけると幸いです。\nポーズ、背景、小物等はおまかせします(困ったら無背景バストアップのみでもOKです)。\nまた、ここに記載していない事項は全て自由とします。\n\n\nいただいたイラストは自分で描く際の参考として利用させていただきます。\nまた、アイコンに使用させていただく場合もあります。\n\n\n依頼内容は以上となります。もし不備等ございましたら申し訳ありませんが、そちらの解釈で行ってもらえると幸いです。\nよろしくお願いいたします。", "nc": 145, "word_count": 0, "transcoder":