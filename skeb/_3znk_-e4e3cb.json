H、テーブル、背景、その他必要だと思われるものだけにしたものです。また、私からのサインが入っているものとサインが入っていないものがあるとありがたい。画像4枚\n\nこの作品にはたくさんの要望があると思いますので、それ以上の金額が必要な場合はお知らせください。ありがとうございました。\n\nhttps://drive.google.com/drive/folders/1gSjRRTODBJUZEF2PSy4IaJsb2ffek2Hh", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@_3znk_/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2725966, "client_id": 3241005, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/2db4c001/uploads/origins/1163ae38-35a5-4b82-910e-b48aaacbf818?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4cf046cda31e30e6618dff289d9a037f", "srcset": "https://si.imgix.net/2db4c001/uploads/origins/1163ae38-35a5-4b82-910e-b48aaacbf818?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4cf046cda31e30e6618dff289d9a037f, https://si.imgix.net/2db4c001/uploads/origins/1163ae38-35a5-4b82-910e-b48aaacbf818?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b13d10ed881d957e6c5b649414f65f19 2x, https://si.imgix.net/2db4c001/uploads/origins/1163ae38-35a5-4b82-910e-b48aaacbf818?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=27622c6fda35185e8e4b0113a99c8a35 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/2db4c001/uploads/origins/1163ae38-35a5-4b82-910e-b48aaacbf818?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=546d12681e5aa4bae57858e3f1cc46cc", "srcset": "https://si.imgix.net/2db4c001/uploads/origins/1163ae38-35a5-4b82-910e-b48aaacbf818?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=546d12681e5aa4bae57858e3f1cc46cc, https://si.imgix.net/2db4c001/uploads/origins/1163ae38-35a5-4b82-910e-b48aaacbf818?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=cabb502cb5