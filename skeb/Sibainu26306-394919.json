ラブオルタナティブの篁優衣のふたなり触手攻め絵をお願いします。\n●キャラ\nマブラブオルタナティブの篁優衣\n●シチュ\nBETAに捕まった優衣がふたなりチンポ(玉あり)を生やされて顔型フェラ専用触手BETAにちんぽをファラチオされている。同様の頭触手が顔を舐めている。チンポが しゃぶりやすいように他の触手に拘束されている。\n●服装\n全裸 後頭部か首元に洗脳を連想させる触手チョーカーがある\n●他ポイント周りにいくつか目玉触手があっていやらしく観察している\n\nもしよかったら受けてください。\nよろしくお願いします。", "nc": 56, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Sibainu26306/works/8", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 802364, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/d0b5ca12/uploads/origins/44ae006c-b5a4-40a7-92c7-40bdb2c2a782?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9a769d641d82a047aa8bb9a317b00b5c", "srcset": "https://si.imgix.net/d0b5ca12/uploads/origins/44ae006c-b5a4-40a7-92c7-40bdb2c2a782?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9a769d641d82a047aa8bb9a317b00b5c, https://si.imgix.net/d0b5ca12/uploads/origins/44ae006c-b5a4-40a7-92c7-40bdb2c2a782?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=96974049ab9bb9a35bc51bb411766414 2x, https://si.imgix.net/d0b5ca12/uploads/origins/44ae006c-b5a4-40a7-92c7-40bdb2c2a782?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=5d9c0b05053fcee7031cf2dcb690d5a2 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/d0b5ca12/uploads/origins/44ae006c-b5a4-40a7-92c7-40bdb2c2a782?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=4446d63ade59ba46d5d3386f8384a378", "srcset": "https://si.imgix.net/d0b5ca12/uploads/origins/44ae006c-b5a4-40a7-92c7-40bdb2c2a782?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=4446d63ade59ba46d5d3386f8384a378, https://si.imgix.net/d0b5ca12/uploads/origins/44ae006c-b5a4-40a7-92c7-40bdb2c2a782?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=20