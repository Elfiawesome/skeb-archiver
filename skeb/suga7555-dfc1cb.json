bad4-cbc4-4126-8e99-81f9ab6fe373?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c2ed69a550e306c2046982dacd7999bc", "srcset": "https://si.imgix.net/929e3807/uploads/origins/e192bad4-cbc4-4126-8e99-81f9ab6fe373?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c2ed69a550e306c2046982dacd7999bc, https://si.imgix.net/929e3807/uploads/origins/e192bad4-cbc4-4126-8e99-81f9ab6fe373?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=31f1c20e55407a29ed96b589ebfe2e9d 2x, https://si.imgix.net/929e3807/uploads/origins/e192bad4-cbc4-4126-8e99-81f9ab6fe373?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=fe16bb148df576e5f4fe1a4f7b87afad 3x"}, "body": "いつも素敵なイラストを拝見させていただいております！YouTubeチャンネル(ゆっくり実況)の作成にあたって、YouTubeで使用する私のオリジナルキャラクターを描いていただきたく、リクエストを送らせて頂きました。\n\nポーズや構図はおまかせします。アイコンに使用するため、解像度は高めでお願いしたいです。\nオリジナルキャラクターは身長低めです。頭は\nhttps://drive.google.com/file/d/1R6Iei5FsJQqyt4pLI5BWX_mcsEaU7n2j/view?usp=share_link\nのもので、服装は青を基調とした魔法使いのデザインを描いていただきたいです！\n\n使用用途はX のアイコンや、YouTubeのアイコン(収益化を目標としたチャンネル)での使用です。\n\nオリジナルキャラクターの服装イメージ参考\nhttps://share.google/bAQv3SZMu27vlK3Ii\n\nX\nhttps://x.com/nesugita_kamin\n\nYoutube\nhttps://youtube.com/@satpnyo?si=StuYkRjMTIJ-tC7M\n\nお忙しい中恐れ入りますが、ご検討いただけますと幸いです！", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@suga7555/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3560706, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/125e4ec1/uploads/origins/a9f13032-77fd-487e-b0cc-1caaa5ab9cff?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6d774a41daa6df0d17b27ad683613b37", "srcset": "https://si.imgix.net/125e4ec1/uploads/origins/a9f13032-77fd-487e-b0cc-1caaa5ab9cff?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6d774a41daa6df0d17b27ad683613b37, https://si.imgix.net/125e4ec1/uploads/origins/a9f13032-77fd-487e-b0cc-1caaa5ab9cff?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=14b35b98b0262dec924d3d03b32b2e3a 2x, https://si.imgix.net/125e4ec1/uploads/origins/a9f13032-77fd-487e-b0cc-1caaa5ab9cff?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e9b3e2300c1a8b5c44f3488f157cde65 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/125e4ec1/uploads/origins/a9f13032-77fd-487e-b0cc-1caaa5ab9cff?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=bb4b0633fc23f90e84e014e09e697a5b", "srcset": "https://si.imgix.net/125e4ec1/uploads/origins/a9f13032-77fd-487e-b0cc-1caaa5ab9cff?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=bb4b0633fc23f90e84e014e09e697a5b, https://si.imgix.net/125e4ec1/uploads/origins/a9f13032-77fd-487e-b0cc-1caaa5ab9cff?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=bff9b87ed2d075b071239dec3ce5ece1 2x, https://si.imgix.net/125e4ec1/uploads/origins/a9f13032-77fd-487e-b0cc-1caaa5ab9cff?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=ece6dc3289de24fb495c29c9a762ad06 3x"}, "body": "初めまして。\nXよりキャンペーンを拝見させていただきました。\nファンタジーの世界観を舞台に女戦士と魔導士が入れ替わってしまったというイラストをお願いしたいです。\n\n詳細です。\n粗暴で豪快な男まさりの女戦士と、淑やかで慎ましく聡明な魔導士。そんな2人がひょんなことから入れ替わってしまい、相手の体で元の自分のような格好をしているというシチュエーションになります。\n\n複雑なシチュエーションかつニッチなジャンルということもあるので、苦手なジャンルでしたら遠慮なくキャンセルしていただけますと幸いです。\nまた今回入れ替わり前後の計4人を描いていただきたく思っております。もし値段が足りない等のこともございましたら再送していただけますとありがたいです。\n\nキャラ設定になります。\nイメージはURLのイラストを参考に須賀様にアレンジしていただけますと嬉しいです。\n\n本来の2人\n○女戦士\n拳一つで闘う豪快な肉食系女戦士\n165cmくらいで引き締まった筋肉質な体\n肌は赤く焼けていて傷跡も\n骨格のはっきりしたきつめな顔立ち、美人系\n(女性らしさは感じられます)\nギラギラとした切れ長な赤色の瞳\n癖っ毛な短めの赤髪をセットせず無造作に\n赤をベースとした濃いスモーキーなメイク\n衣装も動きやすさ重視の金属アーマースタイル\n胸元も腰回りも最低限隠すぐらい\n\n○魔導士\nおっとしていて清楚な心優しい魔導士\n160cmくらい\n衣装で隠れていますが豊満な体型\n白くて傷ひとつない美しい肌\nおっとりしていて知性溢れる顔立ち\nサファイアブルーのタレ目\n綺麗なブロンドヘアをハーフアップに\nメイクもナチュラルなもの\n露出の少ない白と黄色をベースとしたローブ衣装\n\n\n入れ替わり後\n○女戦士(中身魔導士)\nきつめの顔立ちにはナチュラルなメイク\n髪も少しまとめてハーフアップ\n焼けた肌と白いローブ衣装とのギャップ\n自分の体(魔導士(中身女戦士))を見て恥ずかしそうにし、顔を赤くしています。\n\n○魔導士(中身女戦士)\nおっとりした優しげな顔立ちにスモーキーなメイク\n綺麗なブロンドヘアもどこか無造作に\n面積の少ないアーマー衣装で豊満な体型が強調\n清楚な雰囲気とは打って変わり豪快で肉食系なポーズ表情をしています。\n\n2人の見た目と今着ている衣装やメイク、ポーズや表情とのギャップを強調していただけますと嬉しいです。\n\nhttps://drive.google.com/file/d/15TjwBKqodB1dWLAengLn894i8JnAfrls/view?usp=drivesdk", "nc": 33, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}], "sent_works": [], "similar_creators": [{"id": 162767, "creator": true, "nsfw_acceptable": true, "acceptable": false, "name": "えくるあ@同人委託中", "screen_name": "ek_ra", "avatar_url": "https://pbs.twimg.com/profile_images/1788835502390755328/QCEl1FmJ.jpg", "header_url": "https://pbs.twimg.com/profile_banners/81551027/1728571454/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "art"}], "banned": false, "nc": 177}, {"id": 1031397, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "暁サトル@COMITIA156【こ03a】", "screen_name": "subtle_dawn", "avatar_url": "https://pbs.twimg.com/profile_images/1882781496647573504/zRtKU2SO.jpg", "header_url": "https://pbs.twimg.com/profile_banners/860811332483899392/1779071461/1500x500", "appeal_receivable": true, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "art"}, {"genre": "correction"}], "banned": false, "nc": 160}, {"id": 1273612, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "やゆよ缶", "screen_name": "yayuyo2019", "avatar_url": "https://pbs.twimg.com/profile_images/125662