thumbnail_image_urls": {"src": "https://si.imgix.net/cb71c49a/uploads/origins/3d27627e-7954-4a49-8173-1eed9992b125?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=66449a6a0d63cfb0080f92e169b791e6", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/cb71c49a/uploads/origins/3d27627e-7954-4a49-8173-1eed9992b125?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e9c00b8875eedf2f16ed3dbefdeb1789", "src_set": ""}, "body": "またまたこんにちは！\nまたヘラジカの画像が欲しいです。https://skeb.jp/@fumm31051/works/89 のキャラクターも入れたい。\nhttps://x.com/neet_23_neet3/status/1846945538044055844。\n彼女たちがかわいいポーズをとったり、ペニスと触れ合ったりすることで、見る人のペニスは彼女たちにからかわれている。\nこの画像では、口紅がなく、部屋の明かりがついているバージョンが欲しい。また、リファレンスのように、部屋を暗くして、ペニスをマークする口紅を光らせているバージョンも欲しい。彼らの目も光っていて、口紅の色と目の色を合わせてほしい。\n光る目の色については、https://files.catbox.moe/oegv6k.png。\n口紅の位置は、ヘラジカの口紅がペニスの一番下、次にハシビロコウ、シロサイ、オオアルマジロ、パンサーカメレオン、そして臆病で奥まで入れなかったアフリカタテガミヤマアラシ。\nぶっかけバリエーションもお願いします。\n他は何でも結構です。", "nc": 49, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@fumm31051/works/270", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/30eb155f/uploads/origins/8257e5d4-52eb-46d2-a6ed-422344c927c3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=504d74a51fab8a4df410fc56f3823571", "src_set": ""}, "private": true, "genre": "art", "tipped": false, "creator_id": 753415, "client_id": 866592, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 33, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@fumm31051/works/269", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 753415, "client_id": 2956711, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/17fb23c1/uploads/origins/c2ce836d-8e08-44b0-8eb1-120d0b8fc138?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=54576cadf2f9da5d885f8bbfec527bc8", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/17fb23c1/uploads/origins/c2ce836d-8e08-44b0-8eb1-120d0b8fc138?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d60288ab210e9c506d30bff16d5d18de", "src_set": ""}, "body": "アズールレーンのラフィーのえっちなイラストを描いてください。\nhttps://www.azurlane-bisoku.jp/character/laffey/\nラフィーと対面まんぐり返しでセックスな絵お願いします。こんな感じ: https://www.pixiv.net/artworks/130810004\n\nこの差分を描いてください。挿入前、挿入、中出し、事後。表情は眠そう、すごく感じて、トロ顔で絶頂、ハート目で中出しされる。精液は股間や胸に溢れ出ます。妊娠姿も描いてください。よろしくお願いします。", "nc": 32, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@fumm31051/works/268", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 753415, "client_id": 1440837, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/7fe2df07/uploads/origins/f961d063-b33c-4b2c-961f-e13ce76062cd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7f5fcf9a1e48ea0d8cc9d5697320daff", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/7fe2df07/uploads/origins/f961d063-b33c-4b2c-961f-e13ce76062cd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=715c43c9061d56e0e9d86ebf0faf83e4", "src_set": ""}, "body": "こんにちは！\n\nZZZのRina(futanari)×Lucyをお願いしたいです。\n\nリナ（訳が悪いといけないのでリンクだけ）：https://zenless-zone-zero.fandom.com/wiki/Alexandrina_Sebastiane\n\nポーズ\nhttps://www.pixiv.net/en/artworks/129660150\nルーシーは両脚をリナの腰に巻きつけ、リナが再び彼女の中（膣内）でクンニをする。ルーシーの肛門は大きく開いていて、複数のクリンプから精液が漏れているはずだ。たくさんの射精を反映するために、二人の股間からはたくさんの白い精液が飛び散って漏れてほしい。\nリナは片方の手でルーシーの頭を撫で、もう片方の手で彼女の尻を軽く握っている。\n\nリナは口を開けたまま目を閉じて微笑み、頭はルーシーに向かって少し下を向いている。\n\nルーシーは髪をほどいて長くしてください。例：https://www.pixiv.net/en/artworks/129146791\nリナの髪もほどいて自由に流してください。\n\nルーシーのアヘ顔と肥大した子宮を示す2つ目のコマを下にしてください：\nhttps://www.pixiv.net/en/artworks/78361317\n\nありがとう！", "nc": 48, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@fumm31051/works/267", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/6ff76ef2/uploads/origins/bb601c1b-11d5-437c-8c1d-70ab1d1ca3f8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=2f09cb95f409db8c2ab051cb1c8fd843", "src_set": ""}, "private": true, "genre": "art", "tipped": true, "creator_id": 753415, "client_id": 0, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 32, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@fumm31051/works/266", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/ab39f404/uploads/origins/2369bae0-ff66-4618-b1c1-be0cc8b3eeb1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=5f6e87710eb701dee1b35e5f6c3a1b61", "src_set": ""}, "private": true, "genre": "art", "tipped": true, "creator_id": 753415, "client_id": 723898, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 177, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@fumm31051/works/265", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/b0b8f44f/uploads/origins/b14d8933-66c5-4345-9e88-34b68968ca11?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFF