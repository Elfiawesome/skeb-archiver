jdSiawQFh6GIK?usp=sharing\n\n※通過シナリオのネタバレ有\nhttps://iachara.com/view/13005259\n\nーーーーーーーーーーーーー\n金額・内容に不備などありましたらお手数ですが再送要請をしていただけますと幸いです。\n恐れ入りますが、何卒よろしくお願いします！\n\nhttps://drive.google.com/drive/folders/1ZwAs5s4CzapY72p6q9EjdSiawQFh6GIK?usp=sharing", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@sketrpg/works/12", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1194705, "client_id": 3376244, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/121a8f19/uploads/origins/7f4f8878-f8b4-4b5f-92b4-cd44d77220a0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4a954751a22261403f24bf6bf617f242", "srcset": "https://si.imgix.net/121a8f19/uploads/origins/7f4f8878-f8b4-4b5f-92b4-cd44d77220a0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4a954751a22261403f24bf6bf617f242, https://si.imgix.net/121a8f19/uploads/origins/7f4f8878-f8b4-4b5f-92b4-cd44d77220a0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=7dfa6f932acf8288bd19a29737391b1b 2x, https://si.imgix.net/121a8f19/uploads/origins/7f4f8878-f8b4-4b5f-92b4-cd44d77220a0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=2573261d554959b36456bd26bc708021 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/121a8f19/uploads/origins/7f4f8878-f8b4-4b5f-92b4-cd44d77220a0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b6650db545bc9498792428775f5e28dc", "srcset": "https://si.imgix.net/121a8f19/uploads/origins/7f4f8878-f8b4-4b5f-92b4-cd44d77220a0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b6650db545bc9498792428775f5e28dc, https://si.imgix.net/121a8f19/uploads/origins/7f4f8878-f8b4-4b5f-92b4-cd44d77220a0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top