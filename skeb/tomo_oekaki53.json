3fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a5d58f73d6d36222ce61e9cb405272be", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/baac4642/uploads/origins/d853c2a6-f790-44d7-8c0b-fbe9e795e31d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=1b38d7fc31de69f7166645c33071d76d", "src_set": ""}, "body": "アピールありがとうございます。ミクとポケモンの絵リクエストしたいと言います。ミクはMiku Expo 10thの衣装でチルタリスとのイラスト描いてください。\n\nhttps://youtu.be/kp10JO1Tfrg?si=KF01uDwVFuZMFgo6\n\nhttps://skeb.jp/@camomile_teatea/works/3\n\nミクとチルタリスは隣り合っています。こんな感じみたい: https://www.pixiv.net/artworks/122448753\nハッピーな感じお願いします。他の詳細はお任せしたいです。よろしくお願いします。", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@tomo_oekaki53/works/47", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3225850, "client_id": 621198, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/454ebda2/uploads/origins/80a8bec6-bd3c-4eed-b325-89fbd9403341?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9656d8b1d6356d68236948a5a642e9c1", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/454ebda2/uploads/origins/80a8bec6-bd3c-4eed-b325-89fbd9403341?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9bf3e7626641d660163fee930ad30528", "src_set": ""}, "body": "アピールありがとうございます。\nせっかくなのでシチュエーションに癖を入れた二次創作をリクエストさせていただきます\n髪の毛を解いたウマ娘のアドマイヤベガをお願いします。\n\nただし、後ろ髪は誰かに持ち上げられているイメージで逆立っている風にしてほしいです\nトレーナーさんのわがままを許したのか、誰か友達にやられているのかはお任せしますが、\nシュールにされているのは間違いないので少々不満気味というか呆れ気味な表情になるかと思います。\nたぶん後ほどふわふわを堪能する代わりにロングヘアを堪能されている感じになります。\n前髪や横髪(顔のラインを覆う前髪？)はそのままにしておけば人耳がありそうな部分は隠せると思います\n\n台湾式シャンプーや、寝転んでるときに毛先を上にやる、落下時に毛先が遅れる、\nといった後ろ髪が逆立つような構図が好きなのでお願いした次第です。\n特にアヤベさんとかレベルの髪の長さだと迫力も跳ね上がるもので……。\n少々無茶ぶりな気もします