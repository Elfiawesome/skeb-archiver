ません)\nその他のアレンジについてはNGありません。\n\n▼使用用途(可能性があるものを含む)\n配信・動画サムネイル(メイン)、SNSでの宣伝、配信先での使用、ヘッダー各種など不可ありましたらご教示願います。\n\n▼納品形態\n背景、サイン、キャラクターが分かれているPSDデータで納品頂ければ助かります。\n\n\nご検討の程、どうぞよろしくお願いいたします。", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@rt_macoto/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3319301, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/b3ca2149/uploads/origins/858fc942-ec67-439a-ac27-d9dcf3a53b78?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=390301340c8d2744830626c525b83e98", "srcset": "https://si.imgix.net/b3ca2149/uploads/origins/858fc942-ec67-439a-ac27-d9dcf3a53b78?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=390301340c8d2744830626c525b83e98, https://si.imgix.net/b3ca2149/uploads/origins/858fc942-ec67-439a-ac27-d9dcf3a53b78?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=2059df87a3e3f6e426eddff26cfea7df 2x, https://si.imgix.net/b3ca2149/uploads/origins/858fc942-ec67-439a-ac27-d9dcf3a53b78?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ef57259e00e63df8d61f2d3fe28240af 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/b3ca2149/uploads/origins/858fc942-ec67-439a-ac27-d9dcf3a53b78?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d87532054e72c7906056821f00e6a04b", "srcset": "https://si.imgix.net/b3ca2149/uploads/origins/858fc942-ec67-439a-ac27-d9dcf3a53b78?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d87532054e72c7906056821f00e6a04b, https://si.imgix.net/b3ca2149/uploads/origins/858fc942-ec67-439a-ac27-d9dcf3a53b78?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=b43c9907d6a8908227f7020881216605 2x, https://si.imgix.net/b3