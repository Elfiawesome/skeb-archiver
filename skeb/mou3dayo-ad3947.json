p=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=19a233000b51b11efd4ccb7e4647a22a 3x"}, "private": true, "genre": "art", "tipped": true, "creator_id": 63061, "client_id": 1731443, "nc": 177}, {"path": "/@mou3dayo/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 63061, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/573bab62/uploads/origins/8ce4aa44-23ea-4845-b73b-03708384dee9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=cb3126af9d6d798c6bbdcfa6f2f56f01", "srcset": "https://si.imgix.net/573bab62/uploads/origins/8ce4aa44-23ea-4845-b73b-03708384dee9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=cb3126af9d6d798c6bbdcfa6f2f56f01, https://si.imgix.net/573bab62/uploads/origins/8ce4aa44-23ea-4845-b73b-03708384dee9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=5a167558d7b0ca24111a4f3832bf79b1 2x, https://si.imgix.net/573bab62/uploads/origins/8ce4aa44-23ea-4845-b73b-03708384dee9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=881fc83039301035366a04689472a9e3 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/573bab62/uploads/origins/8ce4aa44-23ea-4845-b73b-03708384dee9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d69d62c9f82dd1588e7fdb84eb1ea0e5", "srcset": "https://si.imgix.net/573bab62/uploads/origins/8ce4aa44-23ea-4845-b73b-03708384dee9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d69d62c9f82dd1588e7fdb84eb1ea0e5, https://si.imgix.net/573bab62/uploads/origins/8ce4aa44-23ea-4845-b73b-03708384dee9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=66daeb06a5c59632834b09a3bbe26c74 2x, https://si.imgix.net/573bab62/uploads/origins/8ce4aa44-23ea-4845-b73b-03708384dee9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=9b0915cd533bfc377e5694b494ca1c2a 3x"}, "body": "もうさんこんにちは！初めての依頼失礼します！！\nこちらのツイートのウチの子冒険者パーティのダッチワイフ化イラストをお願いします！\nウチの子資料【https://twitter.com/draw_swindler/status/1684226432522919937?t=ySX_DmWJwXGPNWY4ZM7MoQ&s=19】\nシチュエーションイメージの参考はもうさんのこちらの過去作品のような感じで【https://www.pixiv.net/artworks/26524329】\n首から下をダッチワイフにされた3人が完全にダッチワイフにされる過程のイラストを複数枚とその後の末路イラストを文字無し差分とセットでお願いします。\n（ダッチワイフは全体的にモノ感を強めにするために顔は参考作品のように生身の頃よりも少し過度にキラキラした目がプリントされていたり、鼻がツンと立っていたり、口はオナホ穴とその周りにわざとらしいリップのような唇がプリントされていたり、頬染めは少し大きめの楕円形のアホっぽい頬染めになっている感じでお願いします）\n頬染めイメージ資料\n【https://www.pixiv.net/artworks/134559644】\n\n1枚目\n・首から下をダッチワイフにされた3人（左から順にエリカ、スティレット、サーシャ）が並んで女の子座りでペタンと座らされている\n・3人の台詞と表情\nエリカ「アンタ…元の姿に戻ったらただじゃおかないわ…！」怒り顔\nスティレット「私たちを罠にはめてこんな姿にするとは下衆の極みですわね…！でもお生憎様、私たちには優秀なクレリックの仲間がいますの。彼女にこの卑劣な魔法を解除してもらったら貴方を必ず後悔させてさしあげますわ…！」ちょっと焦りつつもまだ余裕がありそうなドヤ顔\nサーシャ「今ならまだ少しお説教するくらいで許してあげますよ〜？」優しく諭すような表情\n\n2枚目\n・1枚目のイラストをベースに3人の足元に既に空気を抜かれてペラペラなダッチワイフになったハンナが置かれる\n（ハンナダッチワイフは髪がダッチワイフにプリントされた部分とペラペラのビニールになっている部分があるタイプ）\n地の文「その優秀なクレリックとやらはこのビニールゴミのことか？」\n・3人は絶句していて台詞は無い\nエリカは「はぁ？」という声が聞こえてきそうな怪訝そうな表情\nサーシャはポカンと口を開いた呆然とした表情\nスティレットは顔を青ざめながら驚いた表情\n\n3枚目\n・2枚目をベースにした3人の表情差分と台詞\n・3人の表情と台詞\nエリカ「こ…こ\"ろ\"し\"て\"や\"る\"ぅ\"…！」涙を流しながらとても悔しそうに睨む\nスティレット「あ、あの〜？私たちこう見えても結構腕利きの冒険者ですのよ？だからきっと貴方様のお役に立てると思いますので何卒どうかお考え直しては頂けませんこと？」引き攣った笑顔で何とか取り入ろうとする\nサーシャ「なんでハンナちゃんがここに…？あれれ？どうして…？あは…あはははははは」瞳から光を失い（いわゆるレイプ目）狂ったように笑う\n\n4枚目\n・2枚目をベースにした3人の表情差分\n・3人の表情\n3人とも参考作品のように頬がぷくーっと膨らんで完全にダッチワイフ化する直前の状態で台詞は無く、\nエリカは相手を強く睨みつけながら涙を浮かべて\nスティレットは顔を青ざめながら涙を浮かべて（心の底から死んでもダッチワイフになりたくなさそうな感じ）\nサーシャはレイプ目で涙を浮かべながら\n3人とも頬をプク〜ッと膨らまされている\n\n5枚目\n・2枚目をベースにした3人の表情差分と地の文\n地の文「お前たちの使い道はもう決まっている。せいぜい俺を楽しませてくれよダッチワイフ共」\n・3人の表情\n3人は完全にダッチワイフと化しており、\nエリカはツインテール以外が全て頭の部分にプリントされたダッチワイフにされてしまう（ツインテールはツインテールをイメージした棒状の風船が頭の横にくっついているだけ）\nスティレットは参考資料のようなウィッグタイプのダッチワイフにされてしまう\nサーシャはエリカと同じプリントタイプのダッチワイフにされるが、ドリルツインテだけでなくエルフ耳もこちらの作品【https://www.pixiv.net/artworks/52985709】のように膨らんでいて頭にくっついている（ドリルツインテに干渉しないくらいで）\n\n6枚目\n・4つのダッチワイフの末路イラストで、4つのダッチワイフが路地裏のゴミ捨て場に捨てられている\n・4つのダッチワイフの様子\nエリカはゴミ山の表面に適当に投げ捨てられて両足が別々の方向に曲がっているバンザイのようなポーズで逆さまに\nハンナは肉玉のように雑に丸められてエリカの頭の近くに適当に捨てられている\nサーシャはゴミ山の近くでM字開脚で座らされていて自分の手でオナホまんこを見せつける所謂\"くぱぁ\"のポーズのまま捨てられている\nスティレットはおしりがゴミ箱にすっぽりとはまっていてウィッグが少しズレてメカクレぎみになった状態で捨てられている\n（エリカとサーシャ、スティレットは修正がわりにオナホにそれぞれの顔写真を貼り付け、ハンナは肉玉のどこかに適当に顔写真が貼られてる感じでお願いします）\n\nとても細かい内容になっていますが、どうかよろしくお願いします！！", "nc": 40, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@mou3dayo/works/5", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/7a445b9f/uploads/origins/eace9a38-db44-4a2f-962f-6b0dbd812c99?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=87414ce21d48dc5ae1d8410d9b463a12", "srcset": "https://si.imgix.net/7a445b9f/uploads/origins/eace9a38-db44-4a2f-962f-6b0dbd812c99?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=87414ce21d48dc5ae1d8410d9b463a12, https://si.imgix.net/7a445b9f/uploads/origins/eace9a38-db44-4a2f-962f-6b0dbd812c99?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=986d728888254c06a8568e06a115a953 2x, https://si.imgix.net/7a445b9f/uploads/origins/eace9a38-db44-4a2f-962f-6b0dbd812c99?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=6912f44dcc9a9ac15f263bb62d7249a4 3x"}, "private": true, "genre": "art", "tipped": false, "creator_id": 63061, "client_id": 79155, "nc": 176}, {"path": "/@mou3dayo/works/4", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/b21f8360/uploads/origins/52