せん。自由な発想で構いません。例えば、お腹を見せる、暑さで汗をかく、テーブルの上に足を上げるなど。ミサトの服装は正確にお願いします。可能であれば、ペットのペンギンの代わりに首輪をつけたファンマスコット「ライオンキャット」もお願いします。マスコットの入れ方は自由です。\n\nあまり難しいものでなければ、透明でも構いません。重ねてよろしくお願いいたします。前回の依頼にも対応していただきありがとうございました。あなたの絵は素晴らしいと思います。\n\nhttps://drive.google.com/drive/folders/1TA4Lfusr051BxF6eiSgIxQQ9pNBVARMt?usp=sharing", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@l_o_a_f_/works/11", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2501678, "client_id": 3044999, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/e7b89803/uploads/origins/413e79fe-3112-4358-9933-69542e615d3e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a07a3f8e330c2b186c8fbc8c5798f52b", "srcset": "https://si.imgix.net/e7b89803/uploads/origins/413e79fe-3112-4358-9933-69542e615d3e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a07a3f8e330c2b186c8fbc8c5798f52b, https://si.imgix.net/e7b89803/uploads/origins/413e79fe-3112-4358-9933-69542e615d3e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=4eb6f10f3462c9e646c22aac80ada98a 2x, https://si.imgix.net/e7b89803/uploads/origins/413e79fe-3112-4358-9933-69542e615d3e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=48489abd18535e01d6378e28a39f1886 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/e7b89803/uploads/origins/413e79fe-3112-4358-9933-69542e615d3e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=15d6e2e3ee6b95f9b2b1e778d71417ff", "srcset": "https://si.imgix.net/e7b89803/uploads/origins/413e79fe-3112-4358-9933-69542e615d3e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=15d6e2e3ee6b95f9b2b1e778d71417ff, https://si.imgix.net/e7b89803/uploads/origins/413e79fe-3112-4358-9933-69542e615d3e?bg=