参照ください)\n　　(細かいですが…首の方は結び目1つ、三角巾の端が2つ、肘の方は結び目1つ、三角巾の端が1つ、という違いがあります)\n　‐右腕が画面に入るような構図でお願いします\n・ほっぺたに絆創膏１枚\n・ケガをしてても暗くならず、以下のような照れている表情\n　‐片目ウィンク、ペロっと舌を出している、いわゆるてへぺろな表情\n\n包帯に萌えるのと、それでも可愛く元気な姿に萌えるのが個人的なポイントです。\n\nhttps://www.youtube.com/watch?v=iLDkTBdxs4w", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@ikashiosabu/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3192921, "client_id": 2671376, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/6dc2fa1c/uploads/origins/c3d511e0-179c-44ca-a632-e35e813c2942?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=54e50721057eea3e5423e12dc572ca09", "srcset": "https://si.imgix.net/6dc2fa1c/uploads/origins/c3d511e0-179c-44ca-a632-e35e813c2942?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=54e50721057eea3e5423e12dc572ca09, https://si.imgix.net/6dc2fa1c/uploads/origins/c3d511e0-179c-44ca-a632-e35e813c2942?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=9a54aaf35d2d3ee930ba569e14e76967 2x, https://si.imgix.net/6dc2fa1c/uploads/origins/c3d511e0-179c-44ca-a632-e35e813c2942?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=070a05d3a69aaf8cc7020a26f26c514a 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/6dc2fa1c/uploads/origins/c3d511e0-179c-44ca-a632-e35e813c2942?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=03610563bfb205e33242028e646bdb79", "srcset": "https://si.imgix.net/6dc2fa1c/uploads/origins/c3d511e0-179c-44ca-a632-e35e813c2942?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=03610563bfb205e33242028e646bdb79, https://si.imgix.net/6dc2fa1c/uploads/origins/c3d511e0-179c-44ca-a632-e35e813c2942?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=cro