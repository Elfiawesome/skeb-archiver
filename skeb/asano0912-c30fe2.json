duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/cf6c172d/uploads/origins/b0da8f57-3116-4662-bc31-f25008195a8e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0df93f9112f9c80c513ae0d5c901c363", "srcset": "https://si.imgix.net/cf6c172d/uploads/origins/b0da8f57-3116-4662-bc31-f25008195a8e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0df93f9112f9c80c513ae0d5c901c363, https://si.imgix.net/cf6c172d/uploads/origins/b0da8f57-3116-4662-bc31-f25008195a8e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=713e0f00f9d7a587b18c6e991ec6a0da 2x, https://si.imgix.net/cf6c172d/uploads/origins/b0da8f57-3116-4662-bc31-f25008195a8e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=8ab73f2eedb3ac78018371c2cf8cfe6d 3x"}, "body": "こんにちは、私はあなたの英雄伝説のアートが好きです。\nティオで何かお願いしたいです。ティオがアルティナの服を着ているところを描いてください（ただし、必要に応じてティオに似合うように改変してください）。\nテーマは卯年なので、ティオがアルティナの服を着ていることです。ティオの猫耳センサーはそのままでいいかなと思います。もしくは、ウサギの耳があるコスチュームなら、ウサギの耳だけどティオの猫耳センサー風にしてほしい。\n特に欲しい衣装はないので、一番しっくりくるもの（好みのもの）を自由に選んでください。\n\n私の要望を叶えてくれるのであれば、ありがとうございます。訳がわかりにくかったらごめんなさい。", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@asano0912/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 11426, "client_id": 782821, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/a80c465d/uploads/origins/8b861c27-03ba-4094-81d4-62ca11c4a2dc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e82b7298d5306dcbb217549b49e0130c", "srcset": "https://si.imgix.net/a80c465d/uploads/origins/8b861c27-03ba-4094-81d4-62ca11c4a2dc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e82b7298d5306dcbb217549b49e0130c, https://si.imgix.net/a80c465d/uploads/origins/8b861c27-03ba-4094-81d4-