0a8c/uploads/origins/f9a96990-eb49-4d62-9c45-390ffeecee65?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f3d2bae3cf0955f89270e45b23b1f3c2, https://si.imgix.net/c5150a8c/uploads/origins/f9a96990-eb49-4d62-9c45-390ffeecee65?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=81245a7f34248fd001648573f3279c5d 2x, https://si.imgix.net/c5150a8c/uploads/origins/f9a96990-eb49-4d62-9c45-390ffeecee65?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=936e2acf2646c7611cc9a23b3bc05336 3x"}, "body": "こんにちは、JINU先生。\n私はVtuberをやっております緋音と申します。\nJINU先生の絵がとても好きで、JINU先生にアートワークを依頼したいです。\n\n【使用用途】 YouTubeのサムネイルやTwitter等のSNS投稿。YouTubeメンバーで配布。\n【イメージ要望】 背景、ポーズ、構図はお任せできれば幸いです。\n【希望納品形式】 PNG or PSD 、背景を分けたうえで透過版も頂けますと嬉しいです。\n\nこのリンクは私の人物設定の資料です。\n参考として使用してください。\n衣装は複数あったので、ご自由に選んでください\n衣装は変更、簡略化頂いても大丈夫です。\n\nお忙しいところありがどうございます。\nもし私の依頼が受け入れたら、嬉しいです。\n\nhttps://drive.google.com/drive/folders/1bt6kI-hm12im3tk_ZFVbzyOdey9MvO0b?usp=share_link", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@ozk9c/works/11", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3699799, "client_id": 3246636, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/e561495a/uploads/origins/1a4990ef-ce1d-4538-86d3-cc26bf71c30b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=114adc1649ef71b90b7ca573e3cf0ba1", "srcset": "https://si.imgix.net/e561495a/uploads/origins/1a4990ef-ce1d-4538-86d3-cc26bf71c30b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=114adc1649ef71b90b7ca573e3cf0ba1, https://si.imgix.net/e561495a/uploads/origins/1a4990ef-ce1d-4538-86d3-cc26bf71c30b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a045e497af0e10d47ec41275257ba34f 2x, https://si.imgix.net/e561495a/uploads/origins/1a4990ef-ce1d-4538-86d3-