もう一人の男より背が低く、ほんの3、4センチ低い。\n\n赤毛の男性はもっと陽気で明るく、とてもフレンドリーだ。大声で感情を表現するタイプで、すぐに感情を表に出す傾向がある。年下で、もう一人の男より背が高いと自慢したがる。\n\nもしよろしければ、赤毛の男性が白髪の男性の腰を抱えたまま、二人で微笑み合うことはできますか？もしダメなら、それぞれのポーズを自由に決めてください！\n\nもし無理でしたら、調整でもキャンセルでも結構です。リクエストを読んでいただき、ありがとうございました！", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@yudou_yan/works/2", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/daec1213/uploads/origins/bc4e51dc-edd8-4b1e-b27a-fd971b9802bd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=a8c2d652c5e8c75c756a115b8762e40f", "srcset": "https://si.imgix.net/daec1213/uploads/origins/bc4e51dc-edd8-4b1e-b27a-fd971b9802bd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=a8c2d652c5e8c75c756a115b8762e40f, https://si.imgix.net/daec1213/uploads/origins/bc4e51dc-edd8-4b1e-b27a-fd971b9802bd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=05bd676af3b51bed89dd743152726dd4 2x, https://si.imgix.net/daec1213/uploads/origins/bc4e51dc-edd8-4b1e-b27a-fd971b9802bd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=efdb6c691b5b347a0a1ae2978967f903 3x"}, "private": true, "genre": "art", "tipped": false, "creator_id": 2485367, "client_id": 836425, "nc": 144}, {"path": "/@yudou_yan/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2485367, "client_id": 2337667, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/43d3e4c9/uploads/origins/8cf05ae7-e5e0-4e02-9218-5292ecf0404a?bg=%23fff&auto=format%