彼女はpkmn世界のocなのですが、版権要素は無視し、ただの女の子として描写していただいて大丈夫です！\n\n【考えられる使用用途】\n・アイコンやヘッダーへの使用、又SNSに掲載 \n・スマホ等の壁紙への使用\n・依頼をする際などの資料として使用\n・アクリルスタンドやトレカ等の非商用、完全個人用にグッズ製作\n\n長々と失礼いたしました🙇‍♀️\nメロ無先生にカナを描いていただくことがずっと夢だったので、ぜひ先生の思うように描いていただければとても嬉しいです！\n金額不足等不備がありましたら再送要請をお願いします…！よろしくお願いいたします！\n\nhttps://drive.google.com/drive/folders/17YF74PT9NuRLqIJu1admmY8WIZZNom1U", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@meromuri/works/11", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 486211, "client_id": 3783208, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/b8d75d34/uploads/origins/672e195f-723a-4835-97b3-110cffb0c964?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9897a489e081dc887fee750166eeb311", "srcset": "https://si.imgix.net/b8d75d34/uploads/origins/672e195f-723a-4835-97b3-110cffb0c964?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9897a489e081dc887fee750166eeb311, https://si.imgix.net/b8d75d34/uploads/origins/672e195f-723a-4835-97b3-110cffb0c964?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=0f1c20745e50a6abe9893da2b83b0a22 2x, https://si.imgix.net/b8d75d34/uploads/origins/672e195f-723a-4835-97b3-110cffb0c964?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=5c06de73be4c75dacef84da11beb1454 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/b8d75d34/uploads/origins/672e195f-723a-4835-97b3-110cffb0c964?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=747c3dd5a941b78f8e9b52a3e065e067", "srcset": "https://si.imgix.net/b8d75d34/uploads/origins/672e195f-723a-4835-97b3-110cffb0c964?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=747c3dd5a941b78f8e9b52a3e065e067, https://si.imgix.net/b8d75d34/uploads/origi