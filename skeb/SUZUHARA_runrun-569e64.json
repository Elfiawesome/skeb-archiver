装が破損、紛失しています\nマントや衣装に隠れていますがインナーは手首以外に継ぎ目、縫い目のない白い全身タイツです\n性的な部分も露出してほしいのですが\nあくまで戦闘による偶発的な服ビリなので\n片胸のみ露出、靴が片方紛失しタイツ足など\nあからさまに綺麗な丸見えではありません\n\nご検討よろしくお願いします\n\nhttps://www.gonzo.co.jp/archives/druaga_anime_2nd/chara_p2_02.html", "nc": 177, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 8550, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "なすきち＠春例E02b", "screen_name": "nasuurin", "avatar_url": "https://pbs.twimg.com/profile_images/1571063385378422784/TOLekINN.jpg", "header_url": "https://pbs.twimg.com/profile_banners/922123442878423040/1569193724/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 100, "skills": [{"genre": "art"}], "nc": 176}, {"id": 346172, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "メガクラ禁止@全艦東へ！4/29(水)C20", "screen_name": "megacra", "avatar_url": "https://pbs.twimg.com/profile_images/1698521467841859584/5OkAPi2e.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1059670093/1748235668/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "art"}, {"genre": "comic"}, {"genre": "correction"}], "nc": 177}, {"id": 2944754, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "手羽元本舗", "screen_name": "tebahonpo", "avatar_url": "https://pbs.twimg.com/profile_images/1802339975155068928/MoPyzuRy.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1665959465336844288/1696612371/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": nul