1c9ffa2b16?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0c65a492e2269112aa7373514aba9084", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/86e67c1f/uploads/origins/d9b95932-5c75-4c48-a443-b41c9ffa2b16?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=85b7d67cd0613f1ed3ecb81a89156889", "src_set": ""}, "body": "こんにちは、Vea!  私はあなたのアークナイツのファンアートが大好きで、最近あなたが依頼した私の友人SeiryuKomatsuからあなたのことを聞きました。  その絵がとても素敵だったので、私のVtuberにも同じようなものをお願いしたいと思っています。\n\n作品の全体的な感じはアークナイツのE2プロモーションのような感じでお願いします。  私のvtuberのクレシダもカピバラがテーマなので、動物やみかんも要素として入れてもいいと思います。  \n\nポーズや表情、環境はおまかせします。\n\nhttps://drive.google.com/drive/folders/1BDl3_nBPyG-UkbDOtn0iu0CTi5w4yBWG?usp=sharing", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@v_ea_/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1799116, "client_id": 903694, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/8b5b9ca4/uploads/origins/c1c9dc5a-8c49-4ea5-aa4a-a7165ac61c31?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0b8ec9ec52dbe4e77ac83b19a3a6f81c", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/8b5b9ca4/uploads/origins/c1c9dc5a-8c49-4ea5-aa4a-a7165ac61c31?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f0b8e835551f6b93eb5058d0c421a25d", "src_set": ""}, "body": "こんにちは！\n\nVeaさんのアートスタイルが本当に好きで、アークナイツも好きです。私のVTuberキャラクターがアークナイツ風の服を着ているイラストを依頼したいと思います。\n\nキャラクターは、リンゴが大好きなレッサーパンダの女の子です。\n普段の服装の参考：https://twitter.com/_Khiren/status/1489263227460456456 \n\nデザインされたアークナイツ風の衣装を着ている姿を描いてほしいです。インスピレーションはインドラやフリントのような喧嘩っ早いガードです。\n服のデザインはこちら： https://twitter.com/_Khiren/status/1533821009236619265\n\n設定は、彼女が任務の後で疲れてバーのテーブルに座っていて、テーブルの上にリンゴの芯とウィスキーに