": "image", "creator_acceptable_same_genre": true}, {"path": "/@upn2o/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3825635, "client_id": 3436786, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/4aea687c/uploads/origins/234155cf-2e03-49a2-a7b8-7fe6b337d330?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b066cd736f3210939e598ae97471c9db", "srcset": "https://si.imgix.net/4aea687c/uploads/origins/234155cf-2e03-49a2-a7b8-7fe6b337d330?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b066cd736f3210939e598ae97471c9db, https://si.imgix.net/4aea687c/uploads/origins/234155cf-2e03-49a2-a7b8-7fe6b337d330?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=8410b510c3394dc5eca114f2cb9b5423 2x, https://si.imgix.net/4aea687c/uploads/origins/234155cf-2e03-49a2-a7b8-7fe6b337d330?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=4021249e8400e967c7313a917a0f6d2e 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/4aea687c/uploads/origins/234155cf-2e03-49a2-a7b8-7fe6b337d330?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=41da4481b346c6366bfcafdbc9732392", "srcset": "https://si.imgix.net/4aea687c/uploads/origins/234155cf-2e03-49a2-a7b8-7fe6b337d330?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=41da4481b346c6366bfcafdbc9732392, https://si.imgix.net/4aea687c/uploads/origins/234155cf-2e03-49a2-a7b8-7fe6b337d330?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=b347d423ea86bed06a8467b352883f86 2x, https://si.imgix.net/4aea687c/uploads/origins/234155cf-2e03-49a2-a7b8-7fe6b337d330?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=e6364eee93273a545864ad2c81f07be2 3x"}, "body": "はじめまして。Twitchで配信をしております鈴羽かおんと申します。\n\nさむ様のかわいらしい絵柄に惹かれ、\nぜひ私を描いていただきたくリクエストさせていただきました。\n\n【イラストの内容】\n「鈴羽かおん」のイラストを描いていただきたいです。\n・表情、ポーズなどはお任せでお願いできれば幸いです。\n・おめめの中に肉球が隠れていたり、ネイルが塗ってあったりこだわりポイントに注目していただけたら嬉しいです。\n\n■「鈴羽かおん」について\n・チャームポイントは猫耳おだんご\n・うちのにゃんこが大好き\n・ゲーム配信をしている\n・ドジ属性あり\n\n【使用用途】\n・SNSでの投稿、アイコン、ヘッダーなど\n・Twitch/YouTubeの配信/動画内での使用\n・サムネイル（自分、コラボ相手の使用を含む）\n・支援者様向けの壁紙配布\n（現在は収益化していませんが、将来的にサブスクなどを予定しています）\n\n【その他希望】\n・サムネイルとして使用したいと考えておりますので、お顔や髪の毛などが見切れない構図だと嬉しいです。\n・キャラクター/文字/背景などは別レイヤーに分けたPSDか、もしくは背景透過のPNGでいただけますと大変助かります。\n\nご検討のほど、どうぞよろしくお願いいたします。\n\nhttps://drive.google.com/file/d/1Iseijv60jzwuPM6kSUkBD9-dE1enD-re/view?usp=drivesdk", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@upn2o/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3825635, "client_id": 3805832, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/87affc36/uploads/origins/253726de-293e-4b2d-a42a-c0c6b01ba0f2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=669f0751f02018bd25dc67937136ddf0", "srcset": "https://si.imgix.net/87affc36/uploads/origins/253726de-293e-4b2d-a42a-c0c6b01ba0f2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=669f0751f02018bd25dc67937136ddf0, https://si.imgix.net/87affc36/uploads/origins/253726de-293e-4b2d-a42a-c0c6b01ba0f2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a416959d670f7f965b4592b92b68e118 2x, https://si.imgix.net/87affc36/uploads/origins/253726de-293e-4b2d-a42a-c0c6b01ba0f2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=230a2667027033f18c26a8d058080b1d 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/87affc36/uploads/origins/253726de-293e-4b2d-a42a-c0c6b01ba0f2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b57fd84f