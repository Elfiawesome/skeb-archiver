nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Wyatt_0006/works/14", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 386229, "client_id": 76008, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/afa02535/uploads/origins/7aa256c5-3dfe-4c2c-a911-d7cbeeac0626?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4f56ccd5bbfb7ce67b35f635918cde9e", "srcset": "https://si.imgix.net/afa02535/uploads/origins/7aa256c5-3dfe-4c2c-a911-d7cbeeac0626?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4f56ccd5bbfb7ce67b35f635918cde9e, https://si.imgix.net/afa02535/uploads/origins/7aa256c5-3dfe-4c2c-a911-d7cbeeac0626?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=794bc36f64c840bc275d620295f7bc28 2x, https://si.imgix.net/afa02535/uploads/origins/7aa256c5-3dfe-4c2c-a911-d7cbeeac0626?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d14faf4e4e010003f5613b5d9e7afe7b 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/afa02535/uploads/origins/7aa256c5-3dfe-4c2c-a911-d7cbeeac0626?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=8051cba0f0c85a90beaed8169ad09152", "srcset": "https://si.imgix.net/afa02535/uploads/origins/7aa256c5-3dfe-4c2c-a911-d7cbeeac0626?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=8051cba0f0c85a90beaed8169ad09152, https://si.imgix.net/afa02535/uploads/origins/7aa256c5-3dfe-4c2c-a911-d7cbeeac0626?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=db0ef7dc057606347ea82c3e831e2581 2x, https://si.imgix.net/afa02535/uploads/origins/7aa256c5-3dfe-4c2c-a911-d7cbeeac0626?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=f45c1ae782aff259b217076f39c84a04 3x"}, "body": "はじめまして、白銀様の描かれるかっこいい女性に惹かれ、\n自キャラのそういった姿（『騎士の姿』）を見てみたいと思い、イラスト依頼します\n\nキャラクター\n名前：リコフォス\n性別：女\n年齢（外見）：16ほど\n髪の色、形/瞳の色：黒、一つの三つ編みにして垂らしている / 琥珀色と表現されるオレンジに近い茶色\n経歴：冒険者→近衛騎士、騎士団長\n得物：幅広で片刃のカトラスに似た曲刀→ハルバード\n\n魔法で肉体の成長をはじめ色々止められた人間。\n本人は魔法が使えない代わりに心身の鍛錬をものすごくしています。\n彼女を停滞させている枷がなくなったら……という\n別ルートの彼女が『騎士の姿』です。\n以下は共通、資料にはない『騎士の姿』の彼女がしていそうなスタイルです。\n\n身長：163cm→185cmほど\n外見年齢：20代半ば\n髪型：前はワンレングス、横や後ろは視界の邪魔にならないよう一つに結んでいる。\n　　　本来の髪質はややふわふわで柔らかい猫っ気。\n服装：鎧をつけていないときは鍛錬中ならタンクトップに7分丈のパンツ\n　　　（稽古をつけるときは普通の西洋剣を持つこともあります。）\n　　　人前に出るときは長袖のブラウスに革のベスト、ロングスカート。\n筋肉：実用的特化。着やせするタイプ。白銀さん宅の砕屑さんより少し肩幅が狭いイメージです。\n\nその他：少女の姿は諸事情で傷を残さないようにしていますが騎士の彼女はむしろ名誉、飾りじゃないことを示す勲章だと思っています。\n傷跡だらけなのは主が描く平和に似つかわしくない、傷を負うことが稀なので顔にはあまりありませんが\nそれ以外には細かなものが『守った証』としてあるかなあ、と。\n\n性格\n自分に対してはストイックですが\n依頼を請け負う冒険者時代から自信家（自称\"強くてかわいくてできる冒険者\"）\nポジティブ思考、忠誠心、責任感が強いところがあります。\nオフではかわいいものや花、穏やかな時間を好みます。\n戦闘狂の気はありますが相手が強いと「どう勝つか」で燃えるタイプです。\n\n長くなりましたが以上の情報から浮かんだ\n白銀様の\"騎士、成長したリコ\"を見たい！と思い失礼します。\n心身に余裕があるとき、姿が浮かんだらで構いませんので、よろしくお願いいたします。\n\nURLは　少女の姿、表情。成長後の見た目のイメージです。\n\nhttps://privatter.me/page/68a6247491d79", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Wyatt_0006/works/13", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 386229, "client_id": 3108910, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/0801fc7e/uploads/origins/ff121924-8022-4885-be4c-3694ae8b34b4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e3c18311babaabb3e9c4f729f7044ebf", "srcset": "https://si.imgix.net/0801fc7e/uploads/origins/ff121924-8022-4885-be4c-3694ae8b34b4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e3c18311babaabb3e9c4f729f7044ebf, https://si.imgix.net/0801fc7e/uploads/origins/ff121924-8022-4885-be4c-3694ae8b34b4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=7d9f530f8ffb5a708bc21e97c90b876a 2x, https://si.