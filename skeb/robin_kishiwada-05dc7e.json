%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=2ed9fb8488a0ac1a6d9f757b9b2b5beb 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/5f9155f6/uploads/origins/0f7f1721-2422-4e61-b6a7-b1d0583a2aa1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c379f2af318785945ef2d7a6538dabc5", "srcset": "https://si.imgix.net/5f9155f6/uploads/origins/0f7f1721-2422-4e61-b6a7-b1d0583a2aa1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c379f2af318785945ef2d7a6538dabc5, https://si.imgix.net/5f9155f6/uploads/origins/0f7f1721-2422-4e61-b6a7-b1d0583a2aa1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=7f43024fb9bbd0762f266c1e6e2b1615 2x, https://si.imgix.net/5f9155f6/uploads/origins/0f7f1721-2422-4e61-b6a7-b1d0583a2aa1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=38c73f364b5b822846284915e6bbd44b 3x"}, "body": "岸和田ロビン様\n\nいつも素敵なイラストありがとうございます。\n今回は、VTuberの「乙羽スピカ」さん「未々花てゆ」さんの2人のファンアートをリクエストさせていただきたいです。\n\n乙羽スピカさん\nhttps://x.com/OtohaSpica\nhttps://www.youtube.com/@OtohaSpica\nhttps://lit.link/otohaspica\n\n未々花てゆさん\nhttps://x.com/tuyotuyomimimi\nhttps://www.youtube.com/@Mimihana_Teyu\nhttps://lit.link/teyumaru\n\n【依頼内容】\n楽曲『マチアプリンセス』のMV内（動画の2:20頃）にある、ラストの「2人の決めポーズ（アイドルらしい華やかなポーズ）」をしている構図をお願いいたします。\n（参考：https://www.youtube.com/watch?v=ngVPf_NMLkw ）\nカメラ目線で、2人の仲の良さや、華やかなアイドルとしての可愛らしさが全面的に伝わるような仕上がりだと嬉しいです。\n\n【衣装・他】\n衣装、背景や細かなポーズのニュアンス、全体のレイアウトなどにつきましては、岸和田ロビン様独自の解釈でアレンジしていただいて構いません。\n\n【使用用途】\nV本人様および、発注者である私の以下の活動での使用を想定しております。\n・SNSでの公開\n・YouTubeのサムネイル、配信画面等での使用\n・V本人様イベント参加時の贈呈物（フラスタ等）への利用\n・個人利用目的のグッズ作成\n\n【お願い】\nご本人様達が配信サムネイルに使用される可能性があるため、頭や顔周りが切れない構図にしていただけますと大変助かります。\nもし可能であれば、背景・キャラクターがレイヤー分けされたPSDデータ、あるいは背景とキャラクターのみの透過PNGファイルをいただけますと幸いです。\n\nご多忙のところ恐れ入りますが、ご検討のほど何卒よろしくお願いいたします。\n\nhttps://docs.google.com/spreadsheets/d/1htFZrfg00tgc0SbvqjLE-Rts2bwzvxadZj1BfJUSEX8/edit?usp=sharing", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@robin_kishiwada/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3734692, "client_id": 240108, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/139d44df/uploads/origins/21fb3c49-a04b-4af2-a198-a5ba66594691?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0e40c0d68c70cc84c0d76b3fde78a244", "srcset": "https://si.imgix.net/139d44df/uploads/origins/21fb3c49-a04b-4af2-a198-a5ba66594691?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0e40c0d68c70cc84c0d76b3fde78a244, https://si.imgix.net/139d44df/uploads/origins/21fb3c49-a04b-4af2-a198-a5ba66594691?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c0fec2ed7d9d36fa1d5acce51c1a1ff5 2x, https://si.imgix.net/139d44df/uploads/origins/21fb3c49-a04b-4af2-a198-a5ba66594691?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a5ea3cc3b9ebc09f293257abdf544bf8 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/139d44df/uploads/origins/21fb3c49-a04b-4af2-a198-a5ba66594691?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0a185f41f68adb3d79b92cc8d4ca4c59", "srcset": "https://si.imgix.net/139d44df/uploads/origins/21fb3c49-a04b-4af2-a198-a5ba66594691?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0a185f41f68adb3d79b92cc8d4ca4c59, https://si.imgix.net/139d44df/uploads/origins/21fb3c49-a04b-4af2-a198-a5ba66594691?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=2087155585d3cc35a10fcedf4f45831e 2x, https://si.imgix.net/139d44df/uploads/origins/21fb3c49-a04b-4af2-a198-a5ba66594691?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&