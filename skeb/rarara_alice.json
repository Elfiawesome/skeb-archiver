uration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/3ff53ac8/uploads/origins/dea6c16f-03dc-45e0-8d33-93828a7bf688?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=65605c559b9bd857b7bc2538c9c1e384", "src_set": ""}, "body": "アリスさん、初めまして。リクエストしてもよろしいでしょうか？バンドリの松原花音をお願いします。衣装は、水色のマイクロビキニ姿です。全裸と陰毛付き全裸差分をお願いします。背景は水をイメージした青色です。陰毛は、できれば髪の色と同じが良いですが、そこはアリスさんの判断にお任せします。また、花音の表情は小悪魔の表情をしています。ポーズは、正面を向いて、片方の手はピースをしてます。気に入ってくれたら嬉しいです。どうか、よろしくお願いします。", "nc": 32, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@rarara_alice/works/18", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 300020, "client_id": 1564840, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/8e8ef4db/uploads/origins/244b0d29-85e3-4afd-a704-14684491a9ae?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a4f32dc1cd7917ae13236d60562d35d9", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/8e8ef4db/uploads/origins/244b0d29-85e3-4afd-a704-14684491a9ae?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=cd9ec189baf51a661e9f8808917a9591", "src_set": ""}, "body": "アピールありがとうございます\n\nうちの子で良ければ好きに描いてください(*´ω｀*)", "nc": 161, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@rarara_alice/works/17", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 300020, "client_id": 1700197, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/353a21af/uploads/origins/aa576d85-d0f2-4fe4-88ac-95c30d7c6a66?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3d62e2cf41d98622b051ae0448ab9b44", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thum