op&w=200&h=200&blur=200&s=8cbb4ccddf1a9827c35fe0fbf387c950, https://si.imgix.net/4979918e/uploads/origins/aa807cd5-7d4a-450e-a708-7a566f2d7fc7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=35f03a87736725fc032e703eaa256366 2x, https://si.imgix.net/4979918e/uploads/origins/aa807cd5-7d4a-450e-a708-7a566f2d7fc7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=72213db5c8b0a078cd9fafde9fb61776 3x"}, "body": "こんにちは！あなたの作品はとても美しいです。もし可能であれば、私のキャラクター \"RIYO \"のアートワークが欲しいです。クールでエキサイティングでハッピーな雰囲気のバンドのボーカルです！ハッピーなキャラクターですが、照れ屋な一面もあります。そんな彼のキュートで臆病な一面を表現してもらえたら嬉しいです！照れたときの赤面が強い。よく「ピーン」という顔をする。この雰囲気でよければ、どんなポーズやシチュエーションでも見てみたい！\n\nhttps://drive.google.com/file/d/1fOtQtenmw2YvOobSUmnHW-xn8kenFNYK/view?usp=sharing\n\nありがとうございました！", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@c_ckn_41/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2832437, "client_id": 1097401, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/f96cf04a/uploads/origins/aff1c2bb-2486-41c3-a93a-2009c4a85a5b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bf8db6469a2c34b689842102324e94ae", "srcset": "https://si.imgix.net/f96cf04a/uploads/origins/aff1c2bb-2486-41c3-a93a-2009c4a85a5b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bf8db6469a2c34b689842102324e94ae, https://si.imgix.net/f96cf04a/uploads/origins/aff1c2bb-2486-41c3-a93a-2009c4a85a5b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=17357eb4aef78dacdea620df0e07347a 2x, https://si.imgix.net/f96cf04a/uploads/origins/aff1c2bb-2486-41c3-a93a-2009c4a85a5b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=23dc418c7e9b5e8197e97d3d201a3c2f 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/f96cf04a/uploads/origins/aff1c2bb-2486-41c3-a93a-2009c4a85a5b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=838c103d177b1c5680e8184c5094053a", "srcset": "https://si.imgix.net/f96cf04a/uploads/origins/aff1c2bb-2486-41c3-a93a-2009c4a85a5b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=838c103d177b1c5680e8184c5094053a, https://si.imgix.net/f96cf04a/uploads/origins/aff1c2bb-2486-41c3-a93a-2009c4a85a5b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=7ed4f33ffd8ff891c551753c4542f572 2x, https://si.imgix.net/f96cf04a/uploads/origins/aff1c2bb-2486-41c3-a93a-2009c4a85a5b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=7af957e7c4f46c30e0115e9471fd7f51 3x"}, "body": "こんにちは！しちさんのskebと聞いて喜んでやって来ました\nしちさんの絵柄や色使い、塗りの質感が大好きです。\n特に美しさとレトロさ融合させた絵柄が本当に好きで好きで、この度是非依頼させて頂きたく…！\n料金不足ありましたら再送要請して頂ければと思います！\n\n┃依頼内容、シチュエーション\n下記①②の自探索者とその父親を書いて頂きたいです！\n双方ともに家族を宝のように大切に思っております。そういった雰囲気があればどんな構図やシチュエーションでも構いませんのでしちさんの描きやすいように描いて頂ければと思います\n個人的な観賞用として使用させて頂きますのでキャンバスサイズの指定はございません。\n\n┃キャラクター\n①アメリカ国籍の27歳の男性。身長174cm\nクリーム色がかった白髪にインナーカラーで青みがかった黒が入っています。\n髪型は肩につく程度の長さで、ツーブロックになっています。\n容姿はやや太めの眉、水色のたれ目、首元に2つ黒子があり、口を開けると八重歯が見えます\n②アメリカ国籍の58歳の男性。身長182cm\n手入れを怠っているぼさぼさの短髪黒髪\n容姿は鼻の下と顎にひげが生えています、①のキャラクターよりもしっかりとしたふと眉で、黒目たれ目\n目元にしっかりと皺があり、頬は少しこけています\n\n上記内容にてお願い致します。\n上記詳細に不明点がありましたら、しちさんの描きやすいように修正・加筆して頂いて構いません。\n\nよろしくお願い致します。\n\nhttps://drive.google.com/drive/folders/18br7gIZT6cAOSGiQv9jTAXAZjFLINEZB?usp=sharing", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@c_ckn_41/works/2", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/764b40fe/uploads/origins/ef0c8a8d-e5bb-4e0a-81dc-321801fb956d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=ac80e2dc8551ddc2b5