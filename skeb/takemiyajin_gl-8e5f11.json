200&h=200&s=af703a0c4f960a842a033e358a09b9ae 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/9ff168a8/uploads/origins/8761b5f6-4307-4605-b75b-926bbd0ddbb0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=fde380d386809f95619987aa33fa6c76", "srcset": "https://si.imgix.net/9ff168a8/uploads/origins/8761b5f6-4307-4605-b75b-926bbd0ddbb0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=fde380d386809f95619987aa33fa6c76, https://si.imgix.net/9ff168a8/uploads/origins/8761b5f6-4307-4605-b75b-926bbd0ddbb0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=7afb78052b99c6f49cf6cd45c499bce2 2x, https://si.imgix.net/9ff168a8/uploads/origins/8761b5f6-4307-4605-b75b-926bbd0ddbb0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=b000e3290d676fe95e2e5a8a71b2b33f 3x"}, "body": "Dカップのバスト、腰まである緑の髪、ピンクの瞳を持ち、左手に剣、右手に凧型の盾を持ち、暗い森の中でワーグの群れを撃退する175cmの女性パラディンを描いていただけませんか？パラディンの名前はベリル \"バレル \"ベルリッツで、盾と胸当てにこの紋章をつけている。https://drive.google.com/drive/folders/1l1P9btKGaczQTvOJYpnxoXf1z-GTBdnS?usp=drive_link 。また、白と金の鎧を身にまとい、スカートのファウルドを着用している。\nウォーグはオオカミのようなものですが、もっと大きいです（ロード・オブ・ザ・リングを思い浮かべてください）。絵が怖く見えるように！", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@takemiyajin_gl/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3361549, "client_id": 1509886, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/3cc44c94/uploads/origins/5a4e610d-86a1-4aa8-9cf4-13d78282aa1d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c323309d6855dee25f077780c385648c", "srcset": "https://si.imgix.net/3cc44c94/uploads/origins/5a4e610d-86a1-4aa8-9cf4-13d78282aa1d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c323309d6855dee25f077780c385648c, https://si.imgix.net/3cc44c94/uploads/origins/5a4e610d-86a1-4aa8-9cf4-13d78282aa1d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ff4bc5ba2fd44a5508b6733fc91d53e9 2x, https://si.imgix.net/3cc44c94/uploads/origins/5a4e610d-86a1-4aa8-9cf4-13d78282aa1d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d4dcfd1ac475623943f98e9b587c1dc4 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/3cc44c94/uploads/origins/5a4e610d-86a1-4aa8-9cf4-13d78282aa1d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a20a712918d2a1c492f73f51f81bf3db", "srcset": "https://si.imgix.net/3cc44c94/uploads/origins/5a4e610d-86a1-4aa8-9cf4-13d78282aa1d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a20a712918d2a1c492f73f51f81bf3db, https://si.imgix.net/3cc44c94/uploads/origins/5a4e610d-86a1-4aa8-9cf4-13d78282aa1d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=30890770f96c4fa3d5bcf975698a4c99 2x, https://si.imgix.net/3cc44c94/uploads/origins/5a4e610d-86a1-4aa8-9cf4-13d78282aa1d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=3efa43ac90629592d3dec7f43b8260f1 3x"}, "body": "以前、肌の黒いキャラクターを描いたことがあるかどうかはわかりません。\nhttps://drive.google.com/drive/folders/1x_0TK2gLqP4o-Fk_IjeLpkAcT9Ls187-?usp=drive_link、メリエスも描いてください。\nメリエスの姉の名前はシュールで、身長188cm、胸122cmのLカップ（メリエスはJカップ）。膝丈の銀髪に青い毛先と前髪（以前は黒髪だったが、1000歳になったときに銀髪になった。いいえ、高齢者ではありません）、オレンジ色の目をしている。へそと股の間に左右対称のタトゥーがある。右手には笏を持っている。スールはダークエルフの女王で、アルフディスと共同統治している。\nスールとメリースはとても露出度が高く、かつ威厳のある服を着て、宝石をたくさんつけて描いてください。シュールには王冠を、メリースにはティアラを描いてください！\nスールは誇り高く高慢で、メリースは内気で物静かです。舞台は彼らが住むエルフの村です！\n(注：メリースとスールはウェールズ語で甘酸っぱいという意味です。）", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@takemiyajin_gl/works/4", "private_thumbnail_image_urls": null, "private": fals