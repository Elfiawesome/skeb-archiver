0&s=4328c21a0093c16bd1135a5299944550 2x, https://si.imgix.net/3330db31/uploads/origins/3f33ec95-5aeb-4210-9107-b159ce2ce6b9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=80233f7e2dc43612ea79bf36add75494 3x"}, "body": "はじめまして。Blueskyで作品を拝見して、長髪キャラクターのイラストがとても素敵だと感じました！\nぜひ私のオリジナルキャラクターを描いていただきたいと思い、リクエストさせていただきました。\n---\n描いていただきたいキャラクターについてです。\n\n23歳男性、身長190cm、体重100kg、筋肉質。\n水色の髪、緑の瞳、肌は色白、イメージカラーは暗い青紫（資料の横長の画像の右下にカラーサンプルがあります）。\n目の下に濃いクマがあり、腰ほどまでの長さのゆる三つ編み。黒いリボンで結んであります。\n服装は黒のローブです。\n\n魔術系貴族の子息（四男）で、あらゆる魔術の知識や秘術にまみれた大書庫の管理人。\n学問的な魔術資料の管理が主な仕事。\n近寄りがたく陰気で神秘的で自己開示を嫌う、非社交的で全く気が利かない男。\n恵まれた体格の持ち主ですが、魔術師です。武術のたぐいは一切やりません。\n---\n構図に関してはぜひ、描きやすいかたち、描きなれたかたちで制作していただきたいです！\nもし可能なら小道具として本を手に持っていると嬉しいです！\n---\n用途は個人での観賞のみです。\nご検討のほどよろしくお願いいたします！\n\nhttps://drive.google.com/drive/folders/14TIIYTFYFiROpZMzQL1CQ8CcuR2KXPrz?usp=drive_link", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "similar_creators": [{"id": 2582580, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "メミ", "screen_name": "memidesuyo", "avatar_url": "https://pbs.twimg.com/profile_images/1735651871812136960/7EpbN4ci.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1083594370387853314/1771077494/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 15, "complete_expiration_days": 60, "skills": [{"genre": "art"}], "banned": false, "nc": 0}, {"id": 3340952, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "たけやぶ②", "screen_name": "TKYB2000", "avatar_url": "https://pbs.twimg.com/profile_images/1948300525403078656/xPLRPkjA.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1819374554227396610/1750414332/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, 