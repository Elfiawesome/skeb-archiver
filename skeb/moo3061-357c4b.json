&fit=crop&crop=top&w=200&h=200&blur=200&s=f3d635e663ed0b337f7e84f9e65e939e, https://si.imgix.net/b4c1f424/uploads/origins/0e3febbb-4d63-4cbc-bfec-e7197998c692?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=f0ae368ab5f85ab278b6cd4e232c4401 2x, https://si.imgix.net/b4c1f424/uploads/origins/0e3febbb-4d63-4cbc-bfec-e7197998c692?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=543fe22ce4862c53c09f1b3500ac2e9a 3x"}, "body": "na様、いつもお世話になっております。\n今回、CoC「光彩奪目」の探索者2名を描いていただきたく依頼させていただきました。\n\n使用用途としては同卓者との共有やグッズ化等個人利用の範囲のものとなります。\n\nご検討のほどよろしくお願いします。\n\nhttps://drive.google.com/drive/folders/18H7-P8zcHCFlISh_U0QeOpbYIYkNkzks", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@moo3061/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3584195, "client_id": 2011574, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/d7a0c243/uploads/origins/43dee1aa-4d3e-4171-b10c-05827ad13e4c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8367917d53fa92161231f297cc04e327", "srcset": "https://si.imgix.net/d7a0c243/uploads/origins/43dee1aa-4d3e-4171-b10c-05827ad13e4c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8367917d53fa92161231f297cc04e327, https://si.imgix.net/d7a0c243/uploads/origins/43dee1aa-4d3e-4171-b10c-05827ad13e4c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=decd4d5bfedd042e0ae3b1c922153f0d 2x, https://si.imgix.net/d7a0c243/uploads/origins/43dee1aa-4d3e-4171-b10c-05827ad13e4c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=fea63f5d1502f3f414c94cf7b1db8775 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/d7a0c243/uploads/origins/43dee1aa-4d3e-4171-b10c-05827ad13e4c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=7b00a69cba7738fc7687f9012e61b6fc", "srcset": "https://si.imgix.net/d7a0c243/uploads/origins/43dee1aa-4d3e-4171-b10c-05827ad13e4c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=7b00a69cba7738fc7687f9012e61b6fc, https://si.imgix.net/d7a0c243/uploads/origins/43dee1aa-4d3e-4171-b10c-05827ad13e4c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=dd791b7a411f3ebcd002df880c94ad42 2x, https://si.imgix.net/d7a0c243/uploads/origins/43dee1aa-4d3e-4171-b10c-05827ad13e4c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=74f8a0be257f69a81669498ae4a294be 3x"}, "body": "naさん、お世話になっております！\n\n先日素敵なSDイラストをありがとうございました✨\n立て続けの依頼となり大変恐縮なのですが、Ⅶ・Peccātaというシナリオの傲慢と嫉妬のPC(OC)をお願いできればと思い、今回は依頼メッセージを送らせていただきました。\n\n以下、PCの説明になります。容姿についてはリンク先の資料を見ていただければと思います。\n\n────\n\n✦HO傲慢\n男/27歳/APP13/SIZ14\n\nいつも気障でご陽気な探偵。相手が誰であれ、物怖じせずよく喋る。\n基本的に人が好きで、万人の行いに対して寛容。親切ではあるものの、物言いがどこか不遜、かつ胡散臭いため、結果的に好感度はトントンになる。いつも一言多い。\n助手である嫉妬のことはレディと呼び、目に入れても痛くないほど好いている。万人に寛容だが、特に嫉妬に対しては甘い。5つ年下の嫉妬のことはひとりの少女、女性として扱う。子ども扱いではなくレディファースト。\n\n✦HO嫉妬\n女/22歳/APP17/SIZ11\n\n探偵助手を務める聡明な女性。常にツンとしている。\n傲慢以外には不遜で高飛車な態度をとり、相手を見下すような発言が目立つ。誰に対しても物怖じせず、口調は丁寧だが強い言い方のため、相手から反感を買うこともしばしば。\nしかし傲慢が相手となると、概ね全ての発言において首を縦に振り、自身を顧みない危うさを持つ。傲慢の前ではしおらしく女性的で、普段の仏頂面も柔らかくなる。傲慢を害するものを全て敵だと認識している。\n傲慢以外の男性をうっすら嫌いなため、容姿につられて声をかけると痛い目にあう。\n\n────\n\n構図やキャラデザの簡略化等についてはお任せします🌸\n使用目的はSNSのアイコンや個人利用のみです。\n可能であれば透過の別ファイルをいただけると嬉しいのですが、こちら必須ではありません。\n\n以上、よろしくお願いいたします🦕🎶\n\nhttps://drive.google.com/drive/folders/1lUTzBqIjlAiKR_WUJ2HLuH5PDhZPjc1u?usp=drive_link", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@moo3061/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3584195, "client_id": 1223839, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/2720cb5c/uploads/origins/0ea08b02-0fff-4e13-9e61-1b65ecb4a022?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ff18065526235c95aa3a01110d62bc03", "srcset": "https://si.imgix.net/2720cb5c/uploads/origins/0ea08b02-0fff-4e13-9e61-1b65ecb4a022?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ff18065526235c95aa3a01110d62bc03, https://si.imgix.net/2720cb5c/uploads/origins/0ea08b02-0fff-4e13-9e61-1b65ecb4a022?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=14425be95ff8dc368ee6dcca1d7bd73e 2x, https://si.imgix.net/2720cb5c/uploads/origins/0ea08b02-0fff-4e13-9e61-1b65ecb4a022?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ff008f4fb51956b3768c6e6e09e14491 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/2720cb5c/uploads/origins/0ea08b02-0fff-4e13-9e61-1b65ecb4a022?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=24675a20c1015c4faabaa52903b59769", "srcset": "https://si.imgix.net/2720cb5c/uploads/origins/0ea08b02-0fff-4e13-9e61-1b65ecb4a022?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=24675a20c1015c4faabaa52903b59769, https://si.imgix.net/2720cb5c/uploads/origins/0ea08b02-0fff-4e13-9e61-1b65ecb4a022?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=c234c7ab76611b2a7ceba8f62ecbe56c 2x, https://si.imgix.net/2720cb5c/uploads/origins/0ea08b02-0fff-4e13-9e61-1b65ecb4a022?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=4803dc625459161ac313f5f14e035461 3x"}, "body": "ⁿ ᵃさんこんにちは！ⁿ ᵃさんの絵柄でこの男のちみを見たすぎると思いリクエストさせていただきました…！！\n\n構図、ポーズ等描きやすいように描いていただければ幸いです。資料を添付しておりますが、わからない点は好きに描いていただいて構いません！\n金額不足などあれば、お手数ですが再送いただければ修正致します！\n何卒よろしくお願いいたします🙏✨\n\n\n＜詳細＞\n２２歳男性/１８２ｃｍ/大学生\n髪：亜麻色　目：右目が灰、左目がオレンジで縁取られた黒、クマがある\n装飾：口元に二つ銀のピアス、両耳に多量のピアス、頭の上に丸いサングラスをのせている\n筋肉は少なく体は薄め。瞳孔が開きがち。\n\n人文学専攻の文系大学生。住居から少し離れたアンティークショップでバイトしている。\n口調は丁寧だは荒い、所謂ヤンキー敬語。身長が高いこと、装飾を多く開けていることもあり怖がられがち。\n触るだけで物の記憶等を読み取るサイコメトリーの能力を持っており、警察の捜査協力など、時折能力由来の依頼を受けたりする。趣味は国内外旅行。\n\nhttps://drive.google.com/drive/folders/104Ybax53CTnngfm_bQoxpArKQSSk1Yb2", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@moo3061/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3584195, "client_id": 2011574, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/ef418aab/uploads/origins/7b311076-fd88-40ee-af4b-dfc26de7d8a9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ad526baacaf01b8e979af1f3e9266d89", "srcset": "https://si.imgix.net/ef418aab/uploads/origins/7b311076-fd88-40ee-af4b-dfc26de7d8a9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ad526baacaf01b8e979af1f3e9266d89, https://si.imgix.net/ef418aab/uploads/origins/7b311076-fd88-40ee-af4b-dfc26de7d8a9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=74aae88d7e83bd7f78e09fc64b0a4724 2x, https://si.imgix.net/ef418aab/uploads/origins/7b311076-fd88-40ee-af4b-dfc26de7d8a9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=0f05386cd613c7a21c170aa50a664439 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/ef418aab/uploads/origins/7b311076-fd88-40ee-af4b-dfc26de7d8a9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c13ccba4c624d42ea069649256a248e9", "srcset": "https://si.imgix.net/ef418aab/uploads/origins/7b311076-fd88-40ee-af4b-dfc26de7d8a9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c13ccba4c624d42ea069649256a248e9, https://si.imgix.net/ef418aab/uploads/origins/7b311076-fd88-40ee-af4b-dfc26de7d8a9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s