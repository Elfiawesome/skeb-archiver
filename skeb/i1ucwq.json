8rbOvhR6rEeG6z9KpRDSVyHGIO1CQWS", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@i1ucwq/works/17", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3329096, "client_id": 2210148, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/726411e9/uploads/origins/d3931553-b247-4a52-9911-8e13c3b0a16b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5aeed4cb5061bde6f271bbfcab469135", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/726411e9/uploads/origins/d3931553-b247-4a52-9911-8e13c3b0a16b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=cc935c949372320d93ca1aa8be4d4708", "src_set": ""}, "body": "初めまして！小雪うのと申します。\n\nねこしゅ様の絵柄や雰囲気、とても素敵で是非skebをお願いさせて頂きたいです…！  当方のオリキャラ(吸血鬼)を描いて頂きたいです。 \n\n細かい3面図等なくて申し訳ありません。\nわかりにくい部分は簡略化や想像で描いていただいて問題ありません\n【使用用途】\nSNSや配信での運用\nアイコンやPCの壁紙等\n\n\n【お願いごと】\n右目の涙ボクロを忘れないで頂けると幸いです\n良ければ人物のみの透過データも頂けると幸いです。\n\n【性格】\nツンデレっぽい雰囲気\n強気\n\n何卒よろしくお願いいたします！\n\nhttps://drive.google.com/file/d/1fwHjWqgouVsjRBBpu6ZEj3Du-xgG2jLh/view?usp=drivesdk", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@i1ucwq/works/16", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3329096, "client_id": 3060254, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/0ccfd3f8/uploads/origins/076d30fd-f26b-4b80-8f31-1106aedc62c3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a1c754b2675f48bb4b4f1b871470162e", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/0ccfd3f8/uploads/origins/076d30fd-f26b-4b80-8f31-1106aedc62c3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=2