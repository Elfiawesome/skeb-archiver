用、イラスト資料として他の方への共有、相方との共有\n商用目的での使用は一切行いません。\n\n苦手な要素や不明な点、料金不足等があった場合はキャンセルや再送要請をしていただいて構いません。\nご検討のほど、よろしくお願いいたします！\n\nhttps://drive.google.com/drive/folders/1AVMMSSWfXKYwVNhBjvVvX68LJ6CY-4Ln?usp=sharing", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@sadg0o/works/6", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/f1e7a95e/uploads/origins/ae9d2ae6-d54f-4848-9bf8-fa2eefc00541?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=e85f9cadb7db6c3f018e03990d7e9efe", "srcset": "https://si.imgix.net/f1e7a95e/uploads/origins/ae9d2ae6-d54f-4848-9bf8-fa2eefc00541?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=e85f9cadb7db6c3f018e03990d7e9efe, https://si.imgix.net/f1e7a95e/uploads/origins/ae9d2ae6-d54f-4848-9bf8-fa2eefc00541?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=da41b2c74f7d7cf229196575ee4376bb 2x, https://si.imgix.net/f1e7a95e/uploads/origins/ae9d2ae6-d54f-4848-9bf8-fa2eefc00541?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=52938bd3eb07dd57b7698d479c0be876 3x"}, "private": true, "genre": "art", "tipped": false, "creator_id": 4053439, "client_id": 3854796, "nc": 145}, {"path": "/@sadg0o/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 4053439, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/ec91fb08/uploads/origins/9bbfe866-659b-4428-8d66-721c01c9227d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bed944b7c14f4