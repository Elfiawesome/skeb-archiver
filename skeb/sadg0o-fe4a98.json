cb0-9a73-2600898fc6f3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=fd08cc523b76c78bcf41bf3898966694 2x, https://si.imgix.net/112fac2c/uploads/origins/729cef00-821c-4cb0-9a73-2600898fc6f3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=dbe34df075925dbd6415cb43f90f52aa 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/112fac2c/uploads/origins/729cef00-821c-4cb0-9a73-2600898fc6f3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6542e268572a3b5023f9b7dc0a81d5f4", "srcset": "https://si.imgix.net/112fac2c/uploads/origins/729cef00-821c-4cb0-9a73-2600898fc6f3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6542e268572a3b5023f9b7dc0a81d5f4, https://si.imgix.net/112fac2c/uploads/origins/729cef00-821c-4cb0-9a73-2600898fc6f3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=786b97ea69f803c1db23eaf8536a3a14 2x, https://si.imgix.net/112fac2c/uploads/origins/729cef00-821c-4cb0-9a73-2600898fc6f3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=aa72deaf68186adfb90bc91cf4de996f 3x"}, "body": "sa様\n\n初めまして。 X(旧Twitter)にてskeb募集されているツイートをお見かけし、イラストが大変好みだった為依頼したいと思いリクエストを送らせて頂きました。\nもしご縁がありましたら私のOCを描いていただけないでしょうか？  \n\n【OC詳細】 \n19歳/女性/155cm(厚底含め157cm)/ 大学生 \nイメージ絵文字┊︎🐶🌷\nモチーフ┊︎犬(ポメラニアン)、花(チューリップ)、レース \n見た目┊︎目元が少したれ目で、目の色は薄めのピンク。胸はAカップ。髪型はハーフツイン(結び目がくるりんぱしている)に髪の長さは腰あたりで髪色はミルクティー色。パステルピンクのグラデーションが入っている。\nとある大学に通う普通の大学生。わんぱくで元気な性格。誰にでも優しくふわふわしているため男女問わずモテる。幼く見えるせい(身長のせい)で高校生と間違われることが最近の悩み。\n\n【リクエスト内容】\n資料にある女性を描いていただきたいです。まだ新しく生まれたOCなので固定の服装がありません。お腹を出さない服装以外はsa様に好きに描いていただければ幸いです。\n (URL先にあるイラストは絵師様より他コミッションにて参考資料として使用する許可を得ております)\nイラストは頭が見切れないようにしていただき、背景がある場合は透過の方もいただけると大変助かります。   \n\n【イラストの希望、構図、ポージング】\nsa様にお任せします。\n\n【使用用途】 \n・SNS上の掲載とアイコン使用\n・他依頼等への参考画像使用\n・個人鑑賞用\n\n金額が厳しければ再送やキャンセルしてください。 お忙しい中申し訳ございませんが、ご検討のほど宜しくお願い致します。\n\nhttps://drive.google.com/drive/folders/1bUuJuM_3mxwUHdnlR5qTnl0o3uX8SHWP", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@sadg0o/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 4053439, "client_id": 2618136, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/76cfb50c/uploads/origins/ec12be3a-407e-4294-ab98-fe636e3f0cce?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9c8f5e0f0b49018e150c1f7b4dfee42f", "srcset": "https://si.imgix.net/76cfb50c/uploads/origins/ec12be3a-407e-4294-ab98-fe636e3f0cce?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9c8f5e0f0b49018e150c1f7b4dfee42f, https://si.imgix.net/76cfb50c/uploads/origins/ec12be3a-407e-4294-ab98-fe636e3f0cce?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=8013685787b88f43995f24c5053a63c8 2x, https://si.imgix.net/76cfb50c/uploads/origins/ec12be3a-407e-4294-ab98-fe636e3f0cce?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=53bf22067946f2f9a4b9205a31910004 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/76cfb50c/uploads/origins/ec12be3a-407e-4294-ab98-fe636e3f0cce?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=de86c95b4409aa3f4f604bac290ccecd", "srcset": "https://si.imgix.net/76cfb50c/uploads/origins/ec12be3a-407e-4294-ab98-fe636e3f0cce?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=de86c95b4409aa3f4f604bac290ccecd, https://si.imgix.net/76cfb50c/uploads/origins/ec12be3a-407e-4294-ab98-fe636e3f0cce?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=0cd2d1251c64bae8471e6c21fa1b1003 2x, https://si.imgix.net/76cfb50c/uploads/origins/ec12be3a-407e-4294-ab98-fe636e3f0cce?bg=%23fff&auto=fo