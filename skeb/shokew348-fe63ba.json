op&w=200&h=200&blur=200&s=8b2e3fbaaa5437e2dfb258a212c435c2 2x, https://si.imgix.net/0383936c/uploads/origins/b76d2020-ed2d-4ec8-bee5-f57ad6c88289?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=0a9e2e2c6cd7f4992f32e505dcac7f68 3x"}, "body": "車庫貝様\n\nご無沙汰します。以前アイドル達の拘束イラストをリクエストした者です。\n今回は違うシチュエーションでリクエストしたいと存じます。以下に詳細を記述します。\n\n概要\nお忍びでラブホテルに来たアイドルと男がセックスする。\n\nアイドル\n・黒埼ちとせ\n\n場所\nラブホテルの個室(以下資料URLの「HOTEL MYTH」をご参照ください。)\n\n詳細\n・アイドルと竿役の男性がホテルの部屋で行為する\n・定点カメラ視点での構図、数個のカットに分けて描写する\n・性行為中のみアイドルの「♡」の吹き出しを入れる、それ以外はセリフ無し\n\n以上です。\n上記以外の詳細は特に指定しません。自由に描いていただいてOKです。\nご検討のほう、何卒よろしくお願いいたします。\n\nhttps://hotel-myth.jp/", "nc": 32, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@shokew348/works/8", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 274346, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/997e8f02/uploads/origins/b74b5184-27f5-4fa5-a36e-beac551c8059?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=417716ffc33dbdccc9262e33c09a9a6c", "srcset": "https://si.imgix.net/997e8f02/uploads/origins/b74b5184-27f5-4fa5-a36e-beac551c8059?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=417716ffc33dbdccc9262e33c09a9a6c, https://si.imgix.net/997e8f02/uploads/origins/b74b5184-27f5-4fa5-a36e-beac551c8059?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b501de55f131f2e2611cd28d0e0b6a42 2x, https://si.imgix.net/997e8f02/uploads/origins/b74b5184-27f5-4fa5-a36e-beac551c8059?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a53dd3f7e2adbc4302416cb9aca21248 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/997e8f02/uploads/origins/b74b5184-27f5-4fa5-a36e-beac551c8059?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=db97d186156bbd45df407d4424fb6eb2", "srcset": "https://si.imgix.net/997e8f02/uploads/origins/b74b5184-27f5-4fa5-a36e-beac551c8059?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=db97d186156bbd45df407d4424fb6eb2, https://si.imgix.net/997e8f02/uploads/origins/b74b5184-27f5-4fa5-a36e-beac551c8059?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=75ffcd8c53625cb7393b4865081f2b8f 2x, https://si.imgix.net/997e8f02/uploads/origins/b74b5184-27f5-4fa5-a36e-beac551c8059?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=fcd96a72e1a8092a62db812d7e31a9fc 3x"}, "body": "先日はみほはじ百合セックスの依頼を受けていただきありがとうございました。今回は受け攻めを逆にしてまた依頼をさせてください。\n\n▪︎依頼内容\n小日向美穂が攻め藤原肇が受けで百合セックスする絵\n\n・美穂が肇のマンコを口(舌)で責めるシチュエーション\n→舌で舐めたり、舌を膣内に挿入したりする美穂の顔元のカットの差分をお願いします\n・肇はベッドの端に座って、手を後方にやって身体を支えている体勢、または仰向けで寝ている体勢で、上半身を激しく仰け反らしてイかされている状態\n・美穂は、肇がM字開脚の形で脚を広げ上げている間に入って責めている体勢\n・絵の構図についてはお任せしますが、肇の顔が見えない形の場合は肇のイキ顔のカットもお願いしたいです。\n\nイメージが合わなかったり金額が見合わなかったりがあれば、 キャンセルや再送依頼していただければと思います。\n\n注文が多くなってしまい恐縮ですが、ご検討の程よろしくお願いいたします。", "nc": 176, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@shokew348/works/7", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/6dffa57c/uploads/origins/97984dd7-336e-44c0-8a6c-cca6f71609f9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=18d6db23ab2d8a0839bcc9b4cbeb6176", "srcset": "https://si.imgix.net/6dffa57c/uploads/origins/97984dd7-336e-44c0-8a6c-cca6f71609f9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=18d6db23ab2d8a0839bcc9b4cbeb6176, https://si.imgix.net/6dffa57c/uploads/origins/97984dd7-336e-44c0-8a6c-cca6f71609f9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txt