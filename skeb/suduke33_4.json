信が基本的に夜で、ASMRや歌枠、ゲームでも落ち着いた配信が多いので、夜の星がきらめく感じや、ベッドかソファーがあったり、リラックスできる感じがいいなと思います。\nかんぺきに整頓された感じより、ぬいぐるみとか少しだけ散らかってるような遊び心のあるお部屋だといいなって思います！\nあとは他の作品もすてきだったので、おまかせしたいです！( *¯ ꒳¯*)\n\nhttps://x.com/soyo_akm/status/1877508118990528532?s=46&t=YQcWF4r-0iaq5DG5oMI_Mw", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@suduke33_4/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 996056, "client_id": 1834183, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/6bb9e6e1/uploads/origins/b7b3897d-3ff2-43a9-9b54-133b935dadf0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=baf084b49b4588651eb1d352ae14f266", "srcset": "https://si.imgix.net/6bb9e6e1/uploads/origins/b7b3897d-3ff2-43a9-9b54-133b935dadf0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=baf084b49b4588651eb1d352ae14f266, https://si.imgix.net/6bb9e6e1/uploads/origins/b7b3897d-3ff2-43a9-9b54-133b935dadf0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f1a10473b29cb27b24adc758aad45457 2x, https://si.imgix.net/6bb9e6e1/uploads/origins/b7b3897d-3ff2-43a9-9b54-133b935dadf0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=beee6fd05265373b875886b2d5dc0eae 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/6bb9e6e1/uploads/origins/b7b3897d-3ff2-43a9-9b54-133b935dadf0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=8117a049f216746ec5890a53a315eb01", "srcset": "https://si.imgix.net/6bb9e6e1/uploads/origins/b7b3897d-3ff2-43a9-9b54-133b935dadf0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=8117a049f216746ec5890a53a315eb01, https://si.imgix.net/6bb9e6e1/uploads/origins/b7b3897d-3ff2-43a9-9b54-133b935dadf0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=c