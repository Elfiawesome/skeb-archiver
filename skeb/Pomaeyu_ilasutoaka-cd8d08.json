ョン\n・右腕にケガでギプスをしていて、三角巾で首から吊っている\n　‐首と肘のところの三角巾の結び目を見える位置にお願いします(資料URLご参照ください)\n　　(細かいですが…首の方は結び目1つ、三角巾の端が2つ、肘の方は結び目1つ、三角巾の端が1つ、という違いがあります)\n　‐右腕が画面に入るような構図でお願いします\n・ほっぺたに絆創膏１枚\n・ケガをしてても暗くならず、以下のような照れている表情\n　‐片目ウィンク、ペロっと舌を出している、いわゆるてへぺろな表情\n\n包帯に萌えるのと、それでも可愛く元気な姿に萌えるのが個人的なポイントです。\n\nhttps://www.youtube.com/watch?v=iLDkTBdxs4w", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Pomaeyu_ilasutoaka/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3435661, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/3bdb7b5b/uploads/origins/59307357-6d00-4d39-bfdd-5a23d57bead6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5f61e059cef4520c4ffc60550e2fefe8", "srcset": "https://si.imgix.net/3bdb7b5b/uploads/origins/59307357-6d00-4d39-bfdd-5a23d57bead6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5f61e059cef4520c4ffc60550e2fefe8, https://si.imgix.net/3bdb7b5b/uploads/origins/59307357-6d00-4d39-bfdd-5a23d57bead6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=07af30100ffd8d57383e4dd78c9ab244 2x, https://si.imgix.net/3bdb7b5b/uploads/origins/59307357-6d00-4d39-bfdd-5a23d57bead6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=36e7641c5edce76342175120223486bb 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/3bdb7b5b/uploads/origins/59307357-6d00-4d39-bfdd-5a23d57bead6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0e6c95cbbeb2b214190c0d41c8c98cb9", "srcset": "https://si.imgix.net/3bdb7b5b/uploads/origins/59307357-6d00-4d39-bfdd-5a23d57bead6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0e6c95cbbeb2b214190c0d41c8c98cb9, https://si.imgix.net/3bdb7b5b/uploads/origins/59307357-6d00-4d39-bfdd-5a23d57bead6