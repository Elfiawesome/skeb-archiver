e-868b-4c78-a398-ea22599ba597?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5b1d72c5156530400d66ea19be9ad614, https://si.imgix.net/66994cdf/uploads/origins/fc611cce-868b-4c78-a398-ea22599ba597?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=757663df7dc37438a6745fbbc5e94c28 2x, https://si.imgix.net/66994cdf/uploads/origins/fc611cce-868b-4c78-a398-ea22599ba597?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=6d03dd1147e8b5fcc08323b7b131ce1a 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/66994cdf/uploads/origins/fc611cce-868b-4c78-a398-ea22599ba597?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=628afea0eda93180395759f41fb87091", "srcset": "https://si.imgix.net/66994cdf/uploads/origins/fc611cce-868b-4c78-a398-ea22599ba597?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=628afea0eda93180395759f41fb87091, https://si.imgix.net/66994cdf/uploads/origins/fc611cce-868b-4c78-a398-ea22599ba597?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=6c2efb27df311e14a01c1e740b69fe6d 2x, https://si.imgix.net/66994cdf/uploads/origins/fc611cce-868b-4c78-a398-ea22599ba597?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=ea0c9e268d988d2b5017a505d0373edb 3x"}, "body": "こんにちは。以前はイラストをありがとうございました。\n\n自由に好きなように描いてください。以前のXの投稿（https://x.com/curusucururi/status/1863172483597393978）で描いていただいたような雰囲気で、ドリーミーで淡いピンクの雰囲気を希望しています。\n\n彼女の服をふわふわした白いワンピースにデザインするのも自由です。量が許されない場合は、リンクに入れた服を使うこともできます。\n\n納品時には、背景を透明にしたキャラクターと、キャラクターなしの背景のPSDもお願いします。  \n\nありがとうございました。\n\nhttps://drive.google.com/drive/folders/1X-vCSYnw1Nfcn2SrCFAssdb3-wJdp43w", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@curusucururi/works/7", "private_thumbnail_image_urls": null, "priv