-HqyXhUa1fs?si=Mfl2HObuCSFJ7iPP\nこちらは額縁の様に空欄の周りを装飾頂けますと幸いです！\n\n■NowLoading を動画内に入れて頂けますと幸いです！\n\n■サイズは1920×1080でお願い致します。\n\n■その他キャラクターイメージとしては下記となります。モチーフなど取り入れて頂けますと大変嬉しいです。\n・ハロウィン大好き\n・ホーンテッドマンションの様な屋敷に住んでいる\n・たくさんのゴーストを屋敷で働かせている\n・コウモリ/骨を衣装やモチーフに取り入れがち\n\n頂いた作品はYouTube/bilibili/Twitter等の各種SNSで使用させて頂け\n\nhttps://x.com/setoya0102/status/1752680409358536901", "nc": 1, "word_count": 0, "transcoder": "video", "creator_acceptable_same_genre": false}, {"path": "/@prmhm2/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2714292, "client_id": 442943, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/00e4aa40/uploads/origins/e5b649c8-8d92-42ec-8e9b-a5fc2a27ce1f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f2900f319f27105b2c44bcefb464c550", "srcset": "https://si.imgix.net/00e4aa40/uploads/origins/e5b649c8-8d92-42ec-8e9b-a5fc2a27ce1f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f2900f319f27105b2c44bcefb464c550, https://si.imgix.net/00e4aa40/uploads/origins/e5b649c8-8d92-42ec-8e9b-a5fc2a27ce1f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=652eeffb43b8621241e9ac03a1034b23 2x, https://si.imgix.net/00e4aa40/uploads/origins/e5b649c8-8d92-42ec-8e9b-a5fc2a27ce1f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=7d35acf581bb78dcb6820037ea49efb9 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/00e4aa40/uploads/origins/e5b649c8-8d92-42ec-8e9b-a5fc2a27ce1f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=1c44e72c4f263ef800e800760a9aba0d", "srcset": "https://si.imgix.net/00e4aa40/uploads/origins/e5b649c8-8d92-42ec-8e9b-a5fc2a27ce1f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=1c44e72c4f263ef800e800760a9aba0d, https://si.imgix.net/00e4aa40/uploads/