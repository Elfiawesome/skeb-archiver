格は活発で好奇心旺盛。\n少し飽きっぽい、猫のような気まぐれさもあります。\n飲むラムネが大好きで、歌うこともとても好きな子です。\n\n性別は明確に設定しておらず、見る方の解釈にお任せしているキャラクターですので、ぜひ瀬兎くんが受け取ってくださった解釈で自由に描いていただけましたら嬉しいです。\n\n瀬兎くんの世界観の中で、この子がどのように生きるのかを拝見できたらとても幸せです。\nどうぞよろしくお願いいたします。\n\nhttps://x.com/ramune_soda_14/status/2024064430649319894?s=46&t=CTNVYjqPFcegUmNzLMxtOA", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@setoya0102/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 442943, "client_id": 3236287, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/2c8c7794/uploads/origins/f224c1fb-1ce5-4fec-bb54-4fd4ab52d6cb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f8bf35d5fa7e6aed5129ea31688f0ebb", "srcset": "https://si.imgix.net/2c8c7794/uploads/origins/f224c1fb-1ce5-4fec-bb54-4fd4ab52d6cb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f8bf35d5fa7e6aed5129ea31688f0ebb, https://si.imgix.net/2c8c7794/uploads/origins/f224c1fb-1ce5-4fec-bb54-4fd4ab52d6cb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e461777f6852cab1bdc59f91fc746c16 2x, https://si.imgix.net/2c8c7794/uploads/origins/f224c1fb-1ce5-4fec-bb54-4fd4ab52d6cb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d8e4f8d02d193feccedd657b4e4468ff 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/2c8c7794/uploads/origins/f224c1fb-1ce5-4fec-bb54-4fd4ab52d6cb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=17a22989f7015c97a09585173c209a70", "srcset": "https://si.imgix.net/2c8c7794/uploads/origins/f224c1fb-1ce5-4fec-bb54-4fd4ab52d6cb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=17a22989f7015c97a09585173c209a70, https://si.imgix.net/2c8c7794/uploads/origins/f224c1fb-1ce5-4fec-bb54-4fd4ab52d6cb?bg=%23fff&a