_acceptable_same_genre": true}, {"path": "/@lunalto/works/9", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 425620, "client_id": 734454, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/e6c38315/uploads/origins/2472b9b8-8f9a-42e4-bf59-df227bfc26dc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=80432002a3d60c67c1aa384543fd6c6e", "srcset": "https://si.imgix.net/e6c38315/uploads/origins/2472b9b8-8f9a-42e4-bf59-df227bfc26dc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=80432002a3d60c67c1aa384543fd6c6e, https://si.imgix.net/e6c38315/uploads/origins/2472b9b8-8f9a-42e4-bf59-df227bfc26dc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=6e8662e4babcb41c61d8c8b392e8c600 2x, https://si.imgix.net/e6c38315/uploads/origins/2472b9b8-8f9a-42e4-bf59-df227bfc26dc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d83a342ef2a0b5829b3fe5a3982cb969 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/e6c38315/uploads/origins/2472b9b8-8f9a-42e4-bf59-df227bfc26dc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3ee9c6a25fa119f31db859ccf79d1016", "srcset": "https://si.imgix.net/e6c38315/uploads/origins/2472b9b8-8f9a-42e4-bf59-df227bfc26dc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3ee9c6a25fa119f31db859ccf79d1016, https://si.imgix.net/e6c38315/uploads/origins/2472b9b8-8f9a-42e4-bf59-df227bfc26dc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=a236bec61eaba28b69be2a973cb7b617 2x, https://si.imgix.net/e6c38315/uploads/origins/2472b9b8-8f9a-42e4-bf59-df227bfc26dc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=0ee76b0e2a951efd45c4fc58c2d5f10c 3x"}, "body": "◆キャラクター：『淫靡な洞窟のその奥で』より、レティシア\n◆シチュ：原作11巻(AD6)にて、大浴場で凌辱されるシーンのif。(場所は玉座の間、服装は普段のドレス姿で)\n◆構図：体位は資料1(原作)の通りで四つん這い。(両手はスライムにより床に拘束。両足は左右に開き、お尻を高く突き上げている)\n　⇒構図的なイメージとしては資料2の様な感じで。\n\n※資料2：https://drive.google.com/file/d/17VIh1ycaBdvsz30pCTXMBuBhqMQywR9c/view?usp=drive_link\n\n◆セリフ：\n　(1)「…ぅう、やめて、おねがい…おしりは、お尻はいやぁ…」\n　(2)「あっ、あっ…だめっ、お尻、お尻だけはぁぁああ！？」\n　(3)「いや、いやいやっ、もういやぁあああ！？」\n◆描写：金額と労力的に可能でしたら、下記描写を差分でお願いします。(難しい様でしたら③で)\n　①上半身は所々破れていて胸が露出している。(スカートは引きずられた時にできた解れ程度で大きな損傷はないが、スライムにより濡れている)\n　②床とスカートの隙間から入り込んだ触手が足を這い上がって、下着を目指しているところ。(下着は白で刺繍あり)\n　　└スカート付近に内部の様子(触手視点)を描写したカットイン的なコマ割りをお願いします。(以降、スカート付近に触手コマ割り)\n　③2本の触手が下着を太ももまで下ろし、それとは別に人間の手の形をした触手が尻肉を左右に開いているところ。\n　　目を瞑ってすすり泣くレティシア。(セリフ1)\n　　└レティシアの顏付近に表情を描写したカットイン的なコマ割りをお願いします。(以降、顏付近に表情コマ割り)\n　④尻肉を開きつつ、長く伸びた左右の親指が尻穴に入り込み激しくピストン。\n　　押し寄せる快楽と恐怖から、見開いた目から涙を流し、涎を垂らしながら叫ぶ。(セリフ2)\n　⑤親指の先から射精。\n　　…と同時に絶頂するレティシア。(セリフ3)(アヘ顔じゃない方が嬉しいです)\n　⑥親指を抜かれた事で尻穴から白濁液が溢れて垂れている。\n　　涙を流している目はレイプ目。開いたままの口から涎。周囲に湯気。\n\n構図的に難しい物は、改変/省略をしていただいて問題ありません。\nマリアベルとレティシアは推し2TOPで大好きなので、是非よろしくお願いいたします。\n\nhttps://drive.google.com/file/d/16IOkydsBcr89kojFZkYUmVkBgGMq_pjt/view?usp=drive_link", "nc": 40, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@lunalto/works/8", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 425620, "client_id": 734454, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/eb2b4f1b/uploads/origins/51277679-0451-4f67-843b-58996891aec7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=866f75ae6c9c4952f09fd9e46fe1be47", "srcset": "https://si.imgix.net/eb2b4f1b/uploads/origins/51277679-0451-4f67-843b-58996891aec7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=866f75ae6c9c4952f09fd9e46fe1be47, https://si.imgix.net/eb2b4f1b/uploads/origins/51277679-0451-4f67-843b-58996891aec7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=1826429ae1e39a35e58a3d55e0c3a22f 2x, https://si.imgix.net/eb2b4f1b/uploads/origins/51277679-0451-4f67-843b-58996891aec7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f42ac5106251dfec2bf496d266d43a05 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/eb2b4f1b/uploads/origins/51277679-0451-4f67-843b-58996891aec7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6654ce61befcf40ed5b0f8d7b774b7fb", "srcset": "https://si.imgix.net/eb2b4f1b/uploads/origins/51277679-0451-4f67-843b-58996891aec7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6654ce61befcf40ed5b0f8d7b774b7fb, https://si.imgix.net/eb2b4f1b/uploads/origins/51277679-0451-4f67-843b-58996891aec7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=c84d62e8c545e9dd670303b5d042c3d6 2x, https://si.imgix.net/eb2b4f1b/uploads/origins/51277679-0451-4f67-843b-58996891aec7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=9787a0b0c7d913d58c72ec9dc9c2c868 3x"}, "body": "◆キャラクター：月猫さんの看板猫ちゃん(アイコンやバナーにしている月猫さんオリジナルの女の子)\n◆シチュ：構ってちゃんオーラを醸し出してきていたので、撫でたりして可愛がっていたら、ゴロンと横になったところ。\n◆構図：参考写真の様に寝転がってお腹を見せてくれているポーズを上から見ている構図。\n　ただ、写真に写っている様な人の影は\"なし\"でお願いしたいです。(屋内か屋外かはお任せいたします)\n◆描写：基本的な構図は参考写真と前述した内容でお願いしたいのですが、\n　表情だけは現在月猫さんがアイコンにしている看板猫ちゃんみたいに、「ニャッ♪」と可愛く言っている感じでお願いしたいです！\n\n参考写真が私のぬこで恐縮ですが、何卒よろしくお願いいたします。\n\nhttps://twitter.com/AlmightyKanon/status/1481979744107507717/photo/1", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@lunalto/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 425620, "client_id": 734454, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/a9cc1ef1/uploads/origins/8673de12-2522-426b-a03e-19022bcd119b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=489d312d583edf01b370659be9e3492f", "srcset": "https://si.imgix.net/a9cc1ef1/uploads/origins/8673de12-2522-426b-a03e-19022bcd119b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=489d312d583edf01b370659be9e3492f, https://si.imgix.net/a9cc1ef1/uploads/origins/8673de12-2522-426b-a03e-19022bcd119b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f954c770b3ab37e93fd7d55a7e23816c 2x, https://si.imgix.net/a9cc1ef1/uploads/origins/8673de12-2522-426b-a03e-19022bcd119b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=8d2da5a51296099cc97953482b257c6e 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/a9cc1ef1/uploads/origins/8673de12-2522-426b-a03e-19022bcd119b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=514b7c6cd53f17fa68f4062234653093", "srcset": "https://si.imgix.net/a9cc1ef1/uploads/origins/8673de12-2522-426b-a03e-19022bcd119b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=514b7c6cd53f17fa68f4062234653093, https://si.imgix.net/a9cc1ef1/uploads/origins/8673de12-2522-426b-a03e-19022bcd119b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=feb1e616780e4914d59316aa6a21e440 2x, https://si.imgix.net/a9cc1ef1/uploads/origins/8673de12-2522-426b-a03e-19022bcd119b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=485f911cd700b8d7ca896e7ca96d453e 3x"}, "body": "◆キャラクター：『淫靡な洞窟のその奥で』より、マリアベル\n◆シチュ：複数の小スライムが胸当てや破れた服の隙間から中に入り込み、直接\"左乳首\"、\"陰核\"、\"肛門\"を責め続けていて、マリアベルは快感に膝が折れそうになるものの、剣を杖代わりにして何とか耐えている状態。\n◆セリフ：ギザギザの吹き出しで「ひぃぃっ！？そんなに乱暴にしないでっ！」「もっ、そ、こっ……そこはもうやめてぇぇえぇ！！」\n◆表情：羞恥と快感に屈しまいと必死に堪えていたが、責めが激しくなり、思わず「やめて(上記セリフ)」と叫び懇願してしまう。(頬は紅潮、目から涙、唇の端からは涎)\n◆描写：責めている箇所(左乳首、クリ、アナル)付近に、それぞれ詳細な拡大図を描いていただきたいです。\n　①左乳首：力強くつねられ、乳輪ごと引っ張られている図。(胸当てや服を内側から押し上げている様な描写があると尚嬉しいです)\n　②クリ：薄桃色の下着の上からクリをつねって責めている図。(可能であれば、下着は愛液で濡れていて且つ下着から愛液が垂れている描写があると尚嬉しいです)\n　③アナル：下着の中に入り込み、直接アナルに挿入(侵入)して、ピストンしている様を断面図で描写していただきたいです。\n\n以上となります。\n今回、リクエスト自体を初めて行うので、曖昧で不明瞭な説明や不備などがありましたら大変申し訳ございませんが、何卒よろしくお願いいたします。", "nc": 32, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@lunalto/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 425620, "client_id": 173648, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/58fa65f2/uploads/origins/d225c96e-b536-49ca-924a-70ba105dd9f6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7c3258a2466790994612aef5f5553a95", "srcset": "https://si.imgix.net/58fa65f2/uploads/origins/d225c96e-b536-49ca-924a-70ba105dd9f6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7c3258a2466790994612aef5f5553a95, https://si.imgix.net/58fa65f2/uploads/origins/d225c96e-b536-49ca-924a-70ba105dd9f6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ca48e53d17c725fc92fde070e0bbdcb2 2x, https://si.imgix.net/58fa65f2/uploads/origins/d225c96e-b536-49ca-924a-70ba105dd9f6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a6ebf335c0c9ab698ffc97ac83b1a9f8 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/58fa65f2/uploads/origins/d225c96e-b536-49ca-924a-70ba105dd9f6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=91368c72935920bfa2483b6e397bfc52", "srcset": "https://si.imgix.net/58fa65f2/uploads/origins/d225c96e-b536-49ca-924a-70ba105dd9f6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=91368c72935920bfa2483b6e397bfc52, https://si.imgix.net/58fa65f2/uploads/origins/d225c96e-b536-49ca-924a-70ba105dd9f6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=a0b690cbcd91cec8e5d8eb0698571b90 2x, https://si.imgix.net/58fa65f2/uploads/origins/d225c96e-b536-49ca-924a-70ba105dd9f6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=134146af2089e7cd559192f256406054 3x"}, "body": "この度はアズールレーンの彩雲の薔薇のベルファストさんの触手凌辱絵をありがとう\nございました。\n\nhttps://skeb.jp/requests/105447　\n\n今回描いてもらった彩雲の薔薇のベルファストさんの触手絵の別の構図で描いていただきたいので\n再度依頼を出します。\n\n今度は正面から両方の太股と肩に巻き付いた触手で持ち上げられ、両足を広げさせられ、ベルファストさんの\n腕位ある太さの触手でチャイナドレスの前垂れと下着をずらして挿入されて、服越しに下腹部が僅かに触手の形に膨らんでるとよいです。\n\n片方の露出した乳房を先端が３つ又になってる触手で揉まれ、ポニーテールの髪に絡んだ触手で下を向かせないようぐいって引っ張られてる感じにお願いします。\n\n首輪の鎖を触手で引っ張られてるころ、両手首を金属の腕輪で拘束され、鎖が壁に固定されているのは\n継続されていると嬉しいです。可能であれば手が構図に入ってると助かります。\n\n膣内に大量に媚薬混じりの体液を注ぎ込まれてもまだ、屈しないように頬を赤らめながら我慢している表情と、大量に流し込まれて達しているのにも構わず膣内を責め続けられて涙を流しながら許しを乞うてる感じの表情差分をいただけると助かります。\n\nまた長時間責められているので、前のように汗は浮き、大量に中に出された体液が漏れ出し、足元に\n水溜りになってるとよいです。\n\nよろしくお願いします。", "nc": 41, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@lunalto/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 425620, "client_id": 44650, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/fa0cfbe2/uploads/origins/4589a8d0-b4c1-4866-b5bb-0da99dd39106?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a54c360c8f89e6cc2275c57b7a2ae911", "srcset": "https://si.imgix.net/fa0cfbe2/uploads/origins/4589a8d0-b4c1-4866-b5bb-0da99dd39106?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a54c360c8f89e6cc2275c57b7a2ae911, https://si.imgix.net/fa0cfbe2/uploads/origins/4589a8d0-b4c1-4866-b5bb-0da99dd39106?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=32e5a2e9812d931cb1f8089feaa562d1 2x, https://si.imgix.net/fa0cfbe2/uploads/origins/4589a8d0-b4c1-4866-b5bb-0da99dd39106?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b94ac93463c807f8df12db48e9280349 3x"}, "duration": null, "nsfw": true, "hardcore": true, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/fa0cfbe2/uploads/origins/4589a8d0-b4c1-4866-b5bb-0da99dd39106?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6d13ef9dd91ac4f8eb6d58ce6be0102c", "srcset": "https://si.imgix.net/fa0cfbe2/uploads/origins/4589a8d0-b4c1-4866-b5bb-0da99dd39106?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6d13ef9dd91ac4f8eb6d58ce6be0102c, https://si.imgix.net/fa0cfbe2/uploads/origins/4589a8d0-b4c1-4866-b5bb-0da99dd39106?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=0821c15ffd8a937ca5e23a872c7c1c5c 2x, https://si.imgix.net/fa0cfbe2/uploads/origins/4589a8d0-b4c1-4866-b5bb-0da99dd39106?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=9eff29cf87de077b84c063d86e7b4b37 3x"}, "body": "前回描いて頂いた『淫靡な洞窟のその奥で』よりマリアベル尿道姦のイラストを基にした差分を４点お願いしたいです。\n４つのシチュに対して『画面下から伸びてきた尿道責め用触手』『マリアベルの表情』『尿道と膀胱が見える断面図』そして『尿道口がはっきりと見える拡大図』の４点を差分化して欲しいです。\n\n①ピストンの”抜き”の描写\n・触手：先端を尿道口に押し当てて残りの部分を弧を描くように引いてしならせてる描写（挿入直前の力を溜めているような感じ）\n　　　　弧の長さは大体２０～３０ｃｍくらいでその部分だけイボイボのビーズ形状\n　　　　触手の先端にはパチンコ玉サイズのスライム核が浮いている\n・表情：頬を流れるほどの大量の涙を流しながら恐怖に怯えて震えている表情\n・断面：ぴっちりと締まりきった尿道としぼんだ風船のような状態で僅かに尿が溜まってるだけの膀胱\n・拡大：触手の先端をぐぐぐっと捩じ込むように押し付けられて尿道口が没してる（凹んでる）描写\n\n②ピストンの”挿し”の描写\n・内容：①の直後といった感じで、弧になってた部分の触手を根本まで一気に挿入してる描写\n・表情：目をギュッと瞑り必死に歯を食いしばって耐えてる我慢顔\n・断面：尿道をこじ開けるようにして拡げられた尿道とパンパンに膨れ上がった膀胱\n・拡大：挿入の勢いが良すぎてスライムの一部が尿道口から飛び散ってる様子\n\n③高速ピストンの描写\n・内容：①と②の触手を重ねて半透化処理や残像線を加えて『残像が見えるほど高速ピストンしてる』ような描写\n・表情：尿意と快感に襲われ目を開きながら歯を食いしばってる苦しそうな表情\n・断面：ランダムに掻き回されて波打つように歪む尿道と膀胱\n　　　　膀胱内で分裂増殖するスライム核\n・拡大：大量のスライムを飛び散らせながら触手に押し込まれるようにして\n\n④核排泄（尿道出産）の描写\n・触手：挿入していた触手を一気に引っこ抜く描写\n・表情：大きく口を開けて泣きじゃくってるような絶頂顔\n・断面：大量の核と粘液がぎっしり詰まってパンパンに膨らんだ膀胱\n　　　　尿道をえぐるように飛び出していくスライム核\n・拡大：滝のような勢いの粘液噴射に混じって四方八方に発射されていくスライム核\n　　　　排泄の勢いに引っ張られて尿道口が盛り上がってる描写\n\n以上、大変細かいですが可能な範囲で構いませんのでぜひよろしくおねがいします。", "nc": 187, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@lunalto/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 425620, "client_id": 173648, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/a7a33813/requests/105447_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=56d0c38cc9b9ae348d2535948f992596", "srcset": "https://si.imgix.net/a7a33813/requests/105447_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=56d0c38cc9b9ae348d2535948f992596, https://si.imgix.net/a7a33813/requests/105447_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=3f4cca34eb521c7e399dd4a817fab154 2x, https://si.imgix.net/a7a33813/requests/105447_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=57777f5bf827753e12c96fb45c1ea8e0 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/a7a33813/requests/105447_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=146f72f4f4bb9bacd7ba5133c39dc49e", "srcset": "https://si.imgix.net/a7a33813/requests/105447_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=146f72f4f4bb9bacd7ba5133c39dc49e, https://si.imgix.net/a7a33813/requests/105447_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=764a97067a58988fdb6f7337af4fd010 2x, https://si.imgix.net/a7a33813/requests/105447_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=b68cfde0455761080310e0f0fefcf384 3x"}, "body": "イラストの依頼を送ります。\n\nキャラクター：アズールレーンの軽巡ベルファストの季節限定衣装の\n彩雲の薔薇装備のもの。資料URL参照でお願いします。\nストールは省略して構いません。\n\nシチュエーション：囚われの身となり、地下牢で両手を鎖で後ろ手に縛られ、\n伸びた鎖は壁に固定されて逃げられない状態になっています。\n\n膝立ちで前屈みにされて、膣もお尻も下着をずらして侵入した太めの触手に犯されてる\n構図でお願いします。脇の隙間からも服の中に触手が入り込んでるとよいです。\n\n乳房が片方露出して戦闘であちこち破れているものの衣装は原型を留めて着せたまま。\n\n触手の一本で顎を上に向けさせ、恥辱を煽るためにカメラで撮影されてる構図。\nもう一本の触手で首輪についている鎖を軽く引いてる感じで。（首の鎖の長さは公式より長めに）\n\nベルファストは顔を耳まで赤くしながら涙を流しながらも屈しないよう、キッと睨み返している。\n胸は公式より多少盛ってくれると嬉しいです。髪型もストレートではなくポニーテールでお願いします。\n斜め前から見てるような構図だと助かります。\n\nもし、可能であれば表情差分で完全に屈服してしまい触手に犯されてるのを喜んでしまってる\nのをいただけると幸いです。\n\nよろしくお願いします。\n\nhttps://www.inside-games.jp/article/2019/01/25/120081.html\n\nhttps://www.inside-games.jp/article/2019/01/25/120081.html", "nc": 57, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@lunalto/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 425620, "client_id": 44650, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/63cd6660/requests/102529_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=993f06cc40ccfb863929141676701b3d", "srcset": "https://si.imgix.net/63cd6660/requests/102529_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=993f06cc40ccfb863929141676701b3d, https://si.imgix.net/63cd6660/requests/102529_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=8973bbb93934d90aef8addfa3906cca7 2x, https://si.imgix.net/63cd6660/requests/102529_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d3668b2b5bd4fb34923b0651ea43ec18 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/63cd6660/requests/102529_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=91a5294c01bf52e450251d738156ae86", "srcset": "https://si.imgix.net/63cd6660/requests/102529_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=91a5294c01bf52e450251d738156ae86, https://si.imgix.net/63cd6660/requests/102529_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=5b194671757777f85cf590ce0c42c112 2x, https://si.imgix.net/63cd6660/requests/102529_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=66040f19473a774ae2fc5c39ffadefa0 3x"}, "body": "『淫靡な洞窟のその奥で』より勇者の娘マリアベルのスライムに尿道姦されるイラストをお願いしたいです。\n\nポーズM字開脚で拘束、アングルはお尻側から顔を覗き込むような局部アップの煽り視点。\nアナルとアソコを目一杯拡げたままお預けして、クリと尿道だけを徹底的に責め立ててるシチュをお願いします。\nイボイボの触手状に細めたスライム体を高速ピストンしてる残像表現やクリトリスをサンドバッグのように上下左右に弾いてる描写があると嬉しいです。\n表情は「おしっこしたくて仕方ない」「尿道でイクのが止まらない」といった辛そうなイキ顔(ボロ泣き顔)をお願いします。\nまた、可能ならスライムでパンパンになった膀胱断面図もお願いします。", "nc": 56, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@lunalto/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 425620, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/6d871038/requests/101195_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=aa5bc8a2caf447dd11cda1feb1c3837f", "srcset": "https://si.imgix.net/6d871038/requests/101195_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=aa5bc8a2caf447dd11cda1feb1c3837f, https://si.imgix.net/6d871038/requests/101195_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=802463d85283b26fd146d77ac46e3f59 2x, https://si.imgix.net/6d871038/requests/101195_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f824887b046d318ad88186ff84cb18aa 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/6d871038/requests/101195_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9f703158360e324732b6157d0f018a25", "srcset": "https://si.imgix.net/6d871038/requests/101195_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9f703158360e324732b6157d0f018a25, https://si.imgix.net/6d871038/requests/101195_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=3a6a00311e5e0a5e00935a730d09e19b 2x, https://si.imgix.net/6d871038/requests/101195_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=038c6a1fd13280cb5a4c7c7abda88fcd 3x"}, "body": "アドミラル・グラーフ・シュペー(アズールレーン)の日常風景的なイラストを依頼したい。\nなお、月猫さんのツイッターでZaraのラフを受け取ったため、貴方はこの依頼絵の完成度によらずすでに報酬を受け取る権利がある。少ないですが2枚分と思っていただければ。\n\n【大まかな構図】\n・雨の日、シュペーと待ち合わせ。ちょうど指揮官を見つけて手を上げて合図しているところ。\n・雨宿り中、または屋外で傘をさしているかはどちらでもよい\n・シュペーの通常スキンではなく『少女の日曜日』または『平穏な毎日』の私服Verであること\n\n【細かな指定】\n・シュペー通常スキンの大きな爪は艤装の一部(推定)なので私服スキンでは普通の手でよい\n・アズレン攻略WIkiなどに載っている『平穏な毎日』スキンには表情差分があるが、基本的に無表情のまま手だけ振っているほうがシュペーらしくてよい\n・お供の艤装(サメ)は不要(いてもよい)\n・同じくシュペーの海龍のような青い尻尾も不要(あってもよい)\n・服装の細かなディティールは省略可(バッジなど)、ただしバッグやスカートなどについている姉(ドイッチュラント)のキーホルダーはあった方が望ましい(過保護な姉が持たせている、という公式設定なので)\n\n【その他備考】\nシュペーはアズレンKANSENの中でも屈指の美脚なので脚がよく見える構図だとｳﾚｼｲ\n\n以上、ご検討をよろしくお願いします。", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 6793, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "綾枷ちよこ", "screen_name": "chiyoko241", "avatar_url": "https://pbs.twimg.com/profile_images/1534971108134649857/xrRGA6N1.jpg", "header_url": "https://pbs.twimg.com/profile_banners/131799653/1654800452/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "correction"}, {"genre": "art"}], "nc": 177}, {"id": 36630, "creator": true, "nsfw_acceptable": true, "acceptable": false, "name": "チャパ仮🔞", "screen_name": "1_tri_pic", "avatar_url": "https://pbs.twimg.com/profile_images/1970123772117303296/nZmLBS5F.jpg", "header_url": "https://pbs.twimg.com/profile_banners/980563720114864129/1681788426/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "art"}], "nc": 160}, {"id": 400