5c-4167-955e-719aa426d9a7.webp", "appeal_receivable": true, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 12, "skills": [{"genre": "art"}], "nc": 49}, {"id": 3503574, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "風花そー@skeb募集中", "screen_name": "Soo_kazahana", "avatar_url": "https://pbs.twimg.com/profile_images/1957566485913825281/D9_PbY6D.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1621501850452389888/1757009121/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 3, "skills": [{"genre": "art"}], "nc": 49}]}, "price_history": {"art": [{"amount": 7000, "recorded_at": "2025-10-10T18:57:40.093318"}]}, "works": [{"path": "/@habemiru_012/works/11", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3266473, "client_id": 0, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/0c750ded/uploads/origins/0392340d-ac89-4b4b-a786-c961601e407a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0c9509e65e716b87e873b020c5d4e134", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/0c750ded/uploads/origins/0392340d-ac89-4b4b-a786-c961601e407a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=cfad6549a448fd900ff46ef7f974faed", "src_set": ""}, "body": "以下のリクエストのご検討よろしくお願い致します。\n\n●登場人物\n古明地こいし\n博麗霊夢（ふたなり）\n\n●依頼内容\n古明地こいしがふたなりの博麗霊夢とキスハメしながらイチャラブセックスをしているイラスト\n\n●依頼内容の詳細\n・霊夢は怨霊化している。\n・こいしは霊夢に後ろ矢筈で犯されている。\n・こいしと霊夢はお互いにキスをし合っている。\n・こいしは猫耳と尻尾が生えている。\n・霊夢は狐耳と尻尾が生えている。\n・霊夢の男性器には睾丸も付いている。\n・こいしはサードアイを身につけている。\n・こいしのサードアイには霊夢のお札が貼られている。\n・こいしはほぼ全裸の状態(帽子も被っていない)\n・霊夢もほぼ全裸の状態(頭のリボンも外されている)\n・こいしの服全て(帽子も含む)と霊夢の服全て(頭のリボンも含む)が室内に散らばっている。\n・背景は地霊殿の室内\n・こいしは嬉し涙を流している。\n・こいしは困り眉になっている。\n・こいしの目にはハートを宿している。\n・こいしは虚ろな目で霊夢を見つめている。\n・こいしの処女は霊夢に奪われて破瓜している。\n・受精(霊夢の精子がこいしの卵子に入り込んでいく)描写あり", "nc": 57, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@habemiru_012/works/10", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/94a11556/uploads/origins/efd45a0d-75ac-442f-98b6-dbae3a116933?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=3d41708f1e58239810c18aeedd562f3d", "src_set": ""}, "private": true, "genre": "art", "tipped": true, "creator_id": 3266473, "client_id": 58140, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 161, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@habemiru_012/works/9", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3266473, "client_id": 0, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/b531b582/uploads/origins/badfd212-5083-4792-9b79-852e3e2c4bdb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=496684eb5af9c859cdbc93c931b52614", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/b531b582/uploads/origins/badfd212-5083-4792-9b79-852e3e2c4bdb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=79a98a671c3fdd3dd12aa35547eaa8ee", "src_set": ""}, "body": "初めまして。はべみる。氏の可愛らしい絵柄が好きなので依頼させていただきます。\n\n八雲藍と饕餮尤魔を描いて頂けないでしょうか。\nイメージ的には二人が畜生界に居た頃で二人ともふたなり状態\n（ふたなり男性器は小さ目で皮冠り、幼いイメージ。クリトリスの代わりについてるイメージ）。\n誰か（男かふたなり女かは不明）を相手にラブラブ処女喪失3Pエッチしてる最中の絵で、藍が中出しされながら射精（精通）している。\n饕餮は先に処女喪失＆中出しを済ませたが痛みでイキきれておらず、藍の性欲を吸収して興奮し、藍に男性器を押し付けて精通している。\n二人とも女性器～太もも辺りまで血の混じった精液が漏れている。\n\n二人としている相手の姿は描かなくて良いです（透明人間状態）\n衣装・容姿に関しては畜生界時代の資料が無いので、体型などは現代のイメージ、\n衣装も現代のもの半脱ぎでも独自解釈でも全裸でも良いです。\n\n以上、よろしくお願いします。", "nc": 169, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@habemiru_012/works/8", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3266473, "client_id": 90160, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/a68a171a/uploads/origins/e54c23a8-73e3-4e6d-aee4-1c0a0677d15a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=625690a3cffd65613ec4efd57daaa8fb", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/a68a171a/uploads/origins/e54c23a8-73e3-4e6d-aee4-1c0a0677d15a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2238bcaad8f8e894adddbfc3ca538389", "src_set": ""}, "body": "よろしければ、またのリクエストをお願いしたいです！\n今回は里乃ちゃんで、スカートたくし上げシチュをお願いしたいです！\n\n構図はややローアングルで、後ろ向きに、少しお尻を突き出す形で、\nパンツを見せつけている感じに、スカートをたくし上げていて、\nパンツは全体が見えるように、デザインは、サイズが標準的なフルバックのもので、シンプルなデザイン、色は「黒」、「薄緑かピンク」の2種類でお願いしたいです！\n\nもし、先生の思うパンツ色や柄などがありましたら、追加でお願いしたいですが、もちろん、無くてもかまいません！\n反応については、メスガキっぽく、ニヤニヤして笑っている感じに、お願いしたいです…！", "nc": 177, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@habemiru_012/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3266473, "client_id": 0, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/a94c6fd2/uploads/origins/d9759090-8335-4a3a-80a0-99c73443aa31?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=993092708298f5deea62a3a5ecda94cc", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/a94c6fd2/uploads/origins/d9759090-8335-4a3a-80a0-99c73443aa31?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=91215f2f92b23c9b8b9dd7ded14fb4d2", "src_set": ""}, "body": "匿名でのリクエスト失礼します。\n\n●キャラクター\n東方の古明地こいし\n\n●シチュエーション\n（基本形）\n・構図はローアングル視点で膝から上が描かれた状態\n・黒タイツを履いていて、太もも部分にランガードのような太い線あり\n・表情は赤くなりつつ「本当に良いの？」と困惑した感じ（こいしの下からのぞき込む相手に放尿してほしいと懇願された形なので）\n\n（差分）\n・黒タイツや下着越しに大量に放尿する\n・表情は目を瞑って感じている\n\nちなみに効果音の有無はお任せします。\n金額やシチュがお気に召さなければキャンセルしてください。\n検討よろしくお願いします。", "nc": 49, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@habemiru_012/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3266473, "client_id": 0, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/e5442c04/uploads/origins/d7c4dd47-187e-4b09-a98b-04e367246294?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=eea5044c3481187ab19a5e3b92802f86", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/e5442c04/uploads/origins/d7c4dd47-187e-4b09-a98b-04e367246294?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=cff902ae4719d6b522adbf34b0092477", "src_set": ""}, "body": "東方Projectのナズーリンを描いていただきたいです。\n昔描かれていたナズーリンがとても可愛かったので、今のタッチでのナズーリンも観てみたいです。\n通常頭身とデフォルメ頭身の2種類依頼させていただければと思います。\n\n以下は通常/デフォルメ共通の指示詳細です。\n・服装は原作星蓮船の衣装をベースにしつつ、アレンジしていただいても大丈夫です。\n・全身が写るような構図を希望します。\n・通常/デフォルメでポーズは一緒でも違っても大丈夫です。\n\nよろしくお願いいたします。", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@habemiru_012/works/5", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/94cfe6df/uploads/origins/a19a9b5b-880f-45e3-b643-140e34148fcf?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=d992103606810a51f9175890c61ab9cf", "src_set": ""}, "private": true, "genre": "art", "tipped": true, "crea