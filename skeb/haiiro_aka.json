l_appeals_count": 0, "received_works": [{"path": "/@haiiro_aka/works/9", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2052756, "client_id": 2231946, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/36636205/uploads/origins/849515ae-6404-4898-be6e-1bb816c3334f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fa870a618f27d46f963f2e8abca7238d", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/36636205/uploads/origins/849515ae-6404-4898-be6e-1bb816c3334f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=82a7e47d4189ebc00ce633f25cafdcf3", "src_set": ""}, "body": "箱羊様こんばんは\n前回は素敵な作品をありがとうございました\nhttps://skeb.jp/@haiiro_aka/works/7\n犬になりきり甘えておねだりする仕草がとても可愛く刺さりました\nもしよろしければ、違う衣装で同じキャラクターを依頼させてください\n\n・希望する内容を箇条書きで\n「依頼衣装（夏服）」というファイルの衣装を着せてあげてください\n犬耳を着け、尻尾付プラグをお尻に挿入した状態（付け根のプラグが見えないような、尻尾だけお尻から伸びているような形状）\n恋人とのいちゃらぶセックス、または尻尾は無しでアナルセックス（野外のイメージ）\n恥ずかしがりながらも気持ちよさそうな表情\n相手の描写は無くても構いません\n胸の大きさは控えめ（Bカップ程度～つるぺたまでお好みで）\n服装は着衣～半脱ぎくらい\n顔が見える内容で、その他構図などは描きたいものでお任せします\n\nご検討をお願いいたします\n\nhttps://drive.google.com/drive/folders/1gXZVDfcsl66QZ8VxPLKFXERqQXKioNsJ", "nc": 40, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@haiiro_aka/works/8", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/f90fdf4b/uploads/origins/7cf84e0a-6cdf-4f0f-9abc-1e914c50a23f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=fbc7d4b74640beb6469a55f2545251c2", "src_set": ""}, "private": true, "genre": "art", "tipped": false, "creator_id": 2052756, "client_id": 0, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 32, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@haiiro_aka/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2052756, "client_id": 2231946, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/a02ee0ab/uploads/origins/1237fdbb-6a7a-4db1-b56e-ba5cb084c847?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=05050f5b04ffc7beb5ac4257f114c4aa", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/a02ee0ab/uploads/origins/1237fdbb-6a7a-4db1-b56e-ba5cb084c847?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b440f83a99e51fdce8862a0031b8d3a7", "src_set": ""}, "body": "はじめまして、新着作品一覧から過去作品に惹かれてきました\nもしよろしければリクエストを受けていただけないでしょうか\nモデルはサービス終了したネットゲームのマイキャラクターになります\nお淑やかな性格でむっつりスケベ、胸は控えめのスレンダーな子です\n\n・希望する内容を箇条書きで（共通部分）\n恋人とのいちゃらぶセックス\n「依頼衣装」というファイルの衣装を着せてあげてください\n（もしくは「その他衣装」から飛べるフォルダの中にお好みの衣装があれば、そちらを着せてあげてください）\n犬耳を着け、尻尾付プラグをお尻に挿入した状態（付け根のプラグが見えないような、尻尾だけお尻から伸びているような形状）\nもし可能であれば尻尾は無しでアナルセックス（案2）\nとろとろで気持ちよさそうな表情\n相手の描写は無くて構いません\nゲーム内モデルでは胸が大きいですが、控えめにアレンジをお願いします（Bカップ程度～つるぺたまでお好みで）\n服は着衣・半脱ぎ・下着のみ・全裸 でお任せします（細かい装飾などは省略やアレンジしていただいて構いません）\n顔が見える内容で、その他構図などは描きたいものでお任せします\n\n・案1\n犬になりきりながら気持ちよくなっているイメージ\n\n・案2\nアナルセックスで、おしりでとても気持ちよくなっているイメージ\n\nご検討をお願いします\n\nhttps://drive.google.com/drive/folders/1gXZVDfcsl66QZ8VxPLKFXERqQXKioNsJ", "nc": 41, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@haiiro_aka/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2052756, "client_id": 2767686, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/8a6714da/uploads/origins/f06ef980-5bec-45fc-bfa8-f881c597e4bd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6f0760104e328097cc613cf679cfa9b7", "src_set": ""}, "duration": n