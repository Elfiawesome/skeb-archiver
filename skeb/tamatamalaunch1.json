e_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1094669, "client_id": 88626, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/ce5cb623/uploads/origins/d501a59c-8bfa-45fb-b330-e0ec6cf4b004?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9b6dd57806b4d4ce7ff37ce51480820d", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/ce5cb623/uploads/origins/d501a59c-8bfa-45fb-b330-e0ec6cf4b004?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b7d0e48c4b77fb4edce41a31dec8c97f", "src_set": ""}, "body": "こんにちは！いつも良いモンスター娘たちの絵を鑑賞しています！\n\nできれば、「もんむす・くえすと」シリーズの外伝の一つである「もんむす・くえすと！外伝～女騎士セシルの冒険」の登場人物、「セシル」のモンスター娘の姿をお願いしたいと思います！\n\n作中でセシルは蛾娘である「サタニア」に敗北すると、体内でゆっくりと変化し、彼女の眷属となり、彼女と同じ蛾娘に生まれ変わります！\n\n私が見たいシーンは、セシルが恍惚な表情で蛾娘の姿になった状態で繭を開いて出てくる姿です！\n\nセシルの人間時代の姿と変化した後の姿の資料です！\n\nセシル:https://drive.google.com/drive/folders/12b43DeTYyn7r33wcAn9TuOgzWvpuHL5U?usp=sharing\n\n余談ですが、肌色の場合は、素材よりも少し青色で、髪色の場合は人間時代の色を保つように若干の色変更をお願いしたいと思います！\nまた、ポーズの場合、4つの手のうちの1つは自分の性器に触れ、1つは舌に触れ、残りの2つの手は繭を剥がし、自分の繭から出てくる姿をお願いしたいと思います！\n\n繭内部の粘膜とかセシルの体液のため少し湿った感じのような描写もお願いします！\n\nできれば本当にありがとうございます！よろしくお願いします！", "nc": 32, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@tamatamalaunch1/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1094669, "client_id": 1533762, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/b997e666/uploads/origins/258de295-e052-48f4-8aa9-0008647bff3f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9bd01d06694f1b9598fbe57393c297db", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/b997e666/uploads/origins/258de295-e052-48f4-8aa9-0008647bff3f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=cc698dd462741f2c858987a781edf059", "src_set": ""}, "body": "はじめまして。Pixivでイラストをお見かけして描かれていたキャラが凄く可愛く、絵柄も好みでしたのでリクエストを送らせていただきました。\n\n特にオーガ・バーバリアンのニクスさんがめちゃくちゃ自分の癖にささりまして、ショタっ子が彼女に抱きかかえられてのパフパフ＋腹筋コキのシチュエーションを描いていただきたいです。\nHシーンとして描かれていたこちら（https://www.pixiv.net/artworks/109500776）の体位のように、大きなおっぱいの谷間で身体ごとパフパフしてあげたら、興奮したショタっ子がニクスさんの腹筋に腰を擦り付けているという形で、可能なら射精差分もつけていただけると嬉しいです。\n\nニクスさんは「これがきもちいいの？」っていうように優しく見下ろしているような表情で、逞しい腹筋も少し見えるように正面より斜めで、少し見上げるようなアングルでお願いしたいです。ショタっ子は元イラストと同じ子で、背景など細かなところはお任せいたします。\n\nご検討、よろしくお願いいたします。", "nc": 185, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "similar_creators": [{"id": 18457, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "えもんず（4代目）", "screen_name": "emons03", "avatar_url": "https://pbs.twimg.com/profile_images/1455446663284523008/Fm6GWG1H.jpg", "header_url": null, "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "skills": [{"genre": "art"}], "nc": 177}, {"id": 72255, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "ゆりも@10/4割る31,32", "screen_name": "yurimo1108", "avatar_url": "https://pbs.twimg.com/profile_images/1625740995001462784/qxn-E_7o.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1268287542/1747053734/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 15, "skills": [{"genre": "art"}, {"genre": "comic"}], "nc": 48}, {"id": 339725, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "よぐも🔞", "screen_name": "yog_mo", "avatar_url": "https://pbs.twimg.com/profile_images/1973355351081885704/f0I330oo.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1185016620986462208/1588788823/1500x500", "a