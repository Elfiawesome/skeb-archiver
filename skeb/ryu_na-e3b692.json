%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F497407548538900480%2F28qK0z3u.jpeg?blend64=aHR0cHM6Ly9za2ViLWF2YXRhci5pbWdpeC5uZXQvfnRleHQ_&blendalpha=100&blendalign=center&blendmode=normal&blendsize=inherit&bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=865dd9b4ff65b4590601d9ba43e09706, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F497407548538900480%2F28qK0z3u.jpeg?blend64=aHR0cHM6Ly9za2ViLWF2YXRhci5pbWdpeC5uZXQvfnRleHQ_&blendalpha=100&blendalign=center&blendmode=normal&blendsize=inherit&bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=efe936565701c5bbef9eddcbfc0997e5 2x, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F497407548538900480%2F28qK0z3u.jpeg?blend64=aHR0cHM6Ly9za2ViLWF2YXRhci5pbWdpeC5uZXQvfnRleHQ_&blendalpha=100&blendalign=center&blendmode=normal&blendsize=inherit&bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=6b306e8c7d10b64715d5d9d9b19f4b31 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F497407548538900480%2F28qK0z3u.jpeg?blend64=aHR0cHM6Ly9za2ViLWF2YXRhci5pbWdpeC5uZXQvfnRleHQ_&blendalpha=100&blendalign=center&blendmode=normal&blendsize=inherit&bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f165650df62c07723aedd0983faa0ec4", "srcset": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F497407548538900480%2F28qK0z3u.jpeg?blend64=aHR0cHM6Ly9za2ViLWF2YXRhci5pbWdpeC5uZXQvfnRleHQ_&blendalpha=100&blendalign=center&blendmode=normal&blendsize=inherit&bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f165650df62c07723aedd0983faa0ec4, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F497407548538900480%2F28qK0z3u.jpeg?blend64=aHR0cHM6Ly9za2ViLWF2YXRhci5pbWdpeC5uZXQvfnRleHQ_&blendalpha=100&blendalign=center&blendmode=normal&blendsize=inherit&bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=1395702d58ea68fe91dd1246c6182080 2x, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F497407548538900480%2F28qK0z3u.jpeg?blend64=aHR0cHM6Ly9za2ViLWF2YXRhci5pbWdpeC5uZXQvfnRleHQ_&blendalpha=100&blendalign=center&blendmode=normal&blendsize=inherit&bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=7129ccc067587913d4442a03045108e3 3x"}, "body": "小説に興味があったのでご依頼しました。\nうちのOCの「蓮柄まどか」で小説をお願いすることは可能ですか？\n設定は以下のとおりですが、舞台背景、その他登場人物等、自由に書いていただいて構いません。\n███\n蓮柄 円(はちすがら まどか)\n切れ長の目をした黒髪ボブのボーイッシュな女の子。\nフードの付いた前開きの白いパーカーを制服の上からいつも羽織っている。\n\n十数年前に旧校舎にて何者かに殺害された。\n事件当初は失踪事件として処理されていたが、致死量の倍に達するほどの大量の血痕が旧校舎に残されており、その血が全て彼女のものと断定された事で殺人事件に切り替わったとされる。\n現に彼女は亡霊となって学校に留まっているが、自分の死体の在処は彼女自身も知らない。\n生前は環境美化委員として学内の美化にも熱心に取り組んでおり、死後も面倒見の良い性格はそのままで、困っている後輩がいると人知れず手を貸している。\n\n幼少期に姉妹同然に親しかった幼馴染を事故で喪っている。\nその傷心の時期に偶然公園で見つけた蝉の亡骸を、自分を探しに来たその子の父親と共に供養したのを機に、生き物の死骸を拾ってスケッチに起こすようになった。\n\n彼女の能力『モータル・アンダーテイカー』は、そんな彼女の性格を反映したものであり、生き物の死骸とその付随物を自身の心象世界に取り込んで保存する性質を持つ。\n取り込んだ死骸等は、スケッチに起こすようにイメージを思い描くことで自在に実体化できるが、意識を集中し続けていないとたちまち消えてしまう。\n\n母は産後すぐにまどかを連れて逃げるように生家を離れたため、母子家庭で育った。\n同形異音の名（「円」と書いて「つぶら」と読む）の双子の姉がいるが、置いていかれた姉つぶらは父の手で育てられることになった。\n母はつぶらを置いてきてしまった後ろめたさもあってか、まどかには姉の存在を伏せており、父親についても交通事故で死んだと伝えていた。\nその母はまどかの死を受けて、その後を追うように自ら命を絶っている。\n\nまどか当人は母の死も父の生存も姉の存在も、何一つ知らされぬまま、今もなお亡霊として存在している。\n███\n著作者様のクレジット表記ありでSNSや個人サイト等でのキャラクター紹介等での掲載、コミッション等での朗読依頼等も考えています。\nもしご都合が合えばよろしくお願いします。\n\nhttps://drive.google.com/drive/folders/1-GE5K5dreWeICc1_QfVJqFNTViEPxwPF", "nc": 153, "word_count": 811, "transcoder": "text", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 1128091, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "いる田", "screen_name": "iruiru_popopo", "avatar_url": "https://pbs.twimg.com/profile_images/1989318003205488641/ofHtNuN0.j