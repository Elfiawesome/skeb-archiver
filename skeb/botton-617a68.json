、文房具（手書きの手紙、ペン、ノート、メモ帳）、お手伝い、お話、星空観察、音楽や人の歌を聴くことが好きである。ニンジン、ワナにはまること、失敗すること、人をがっかりさせることが嫌い。\n\n美世は、メイドバージョン、執事バージョン、藩主バージョンの中から好きなものを選ぶことができます。また、ポーズや表情も選ぶことができます。\n\n美世を気に入っていただき、ありがとうございます。とてもうれしいです\n\nhttps://sta.sh/218yi3af4kqq", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@botton/works/11", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1606524, "client_id": 1986403, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/5c6a4e0c/uploads/origins/d4fbe337-46d5-4a75-a5b4-19925202b9e0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=134ebce90c165d78f8a4ca9a2b6e5d98", "srcset": "https://si.imgix.net/5c6a4e0c/uploads/origins/d4fbe337-46d5-4a75-a5b4-19925202b9e0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=134ebce90c165d78f8a4ca9a2b6e5d98, https://si.imgix.net/5c6a4e0c/uploads/origins/d4fbe337-46d5-4a75-a5b4-19925202b9e0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=eba868685100a389cafc7bbc046ed650 2x, https://si.imgix.net/5c6a4e0c/uploads/origins/d4fbe337-46d5-4a75-a5b4-19925202b9e0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=06c906154280758bc1dc6f93528418a7 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/5c6a4e0c/uploads/origins/d4fbe337-46d5-4a75-a5b4-19925202b9e0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9cc0b8ed74b20caa9a33ae75fc5c215e", "srcset": "https://si.imgix.net/5c6a4e0c/uploads/origins/d4fbe337-46d5-4a75-a5b4-19925202b9e0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9cc0b8ed74b20caa9a33ae75fc5c215e, https://si.imgix.net/5c6a4e0c/uploads/origins/d4fbe337-46d5-4a75-a5b4-19925202b9e0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=2