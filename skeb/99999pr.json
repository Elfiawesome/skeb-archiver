7878ba-d81e-4728-83a7-e3cc0566d4e8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=1fca3ebf29ac58265a72ca1b5fb189ec 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/23e37832/uploads/origins/737878ba-d81e-4728-83a7-e3cc0566d4e8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=8f5cb596f793ff3de05709bdcb9cec0b", "srcset": "https://si.imgix.net/23e37832/uploads/origins/737878ba-d81e-4728-83a7-e3cc0566d4e8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=8f5cb596f793ff3de05709bdcb9cec0b, https://si.imgix.net/23e37832/uploads/origins/737878ba-d81e-4728-83a7-e3cc0566d4e8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=922c4c69e8fbc732dc55cbd177b38a3e 2x, https://si.imgix.net/23e37832/uploads/origins/737878ba-d81e-4728-83a7-e3cc0566d4e8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=0d2cfb0c9bcbab3da3ded1b003415d4a 3x"}, "body": "猫山宮古 凹先生、お世話になっております、矢場居です。\nいつも素敵なイラスト拝見させていただいております\n\n私のオリジナルキャラクターのイラストをお願いしたいです\n1.キャラクター原図：https://i.imgur.com/pm8IUey.png\n2.服装：チャイナ服\n3.髮型：お団子ヘア\n4.頭にりぼん：格子柄\n\nそれ以外の構図等ご自由にどうぞ\n本当にありがとうございます\n何卒よろしくお願い致します", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@99999pr/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 119614, "client_id": 2549593, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/8d727306/uploads/origins/c29129ed-9979-40af-b29c-3dab18f760bf?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=dcfb06d9861dfef60f633c1206a11593", "srcset": "https://si.imgix.net/8d727306/uploads/origins/c29129ed-9979-40af-b29c-3dab18f760bf?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=dcfb06d9861dfef60f633c1206a11593, https://si.imgix.net/8d727306/uploads/origins/c29129ed-9979-40af-b29c-3dab18f760bf?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=4e149b0503d23e3bd335550a64ac6b54 2x, https://si.imgix.net/8d727306/uploads/origins/c29129ed-9979-40af-b29c-3dab18f760bf?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=fc91929b74118fb78cb0bec2ac64e4f7 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/8d727306/uploads/origins/c29129ed-9979-40af-b29c-3dab18f760bf?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=355bcd862071ca8753ecf4e52599648a", "srcset": "https://si.imgix.net/8d727306/uploads/origins/c29129ed-9979-40af-b29c-3dab18f760bf?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=355bcd862071ca8753ecf4e52599648a, https://si.imgix.net/8d727306/uploads/origins/c29129ed-9979-40af-b29c-3dab18f760bf?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=c43ae8ed4a6198e4dce8990ca57a08bb 2x, https://si.imgix.net/8d727306/uploads/origins/c29129ed-9979-40af-b29c-3dab18f760bf?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=e8d2e05bda8026f589d0cda86575a0aa 3x"}, "body": "猫山宮古さんリクエスト失礼します。\n\n前回はまぐねっこ・つなかんさんとまぐ子が食事てしいる可愛いファンアートをありがとうございました。今回も推しているVtuberさんへのファンアートリクエストになります。\n\n【個人Vtuber】\n 有頂天ビビさん（@vivi_Vframe ）\n クラウン学園の生徒会長、おもに雑談配信をメインに活動なされております。\n\n【希望内容】\nビビさんが「メン限、居酒屋有頂天」とのタイトルでそちらへのリクエストに\n\nイメージとしましてカウンターのある居酒屋でビビさんを中心に皆がわいわいしているイラストをお願いします。人数が多いのですが減らして貰っても大丈夫です、女将ビビさんのイメージは自分のリクエスト内にありますのでそちらをご参考に（自由に女将ビビさんを）\n\n通常ビビさん×１\n女将ビビさん×１\nカウンター内で調理している大将×１\n男性×数人\n女性×数人\n半魚人×１\n\nでお願いします。構図などは指定はないので猫山宮古さんの自由に描いて頂きたく、ころさんがスト６？の打ち上げファンアートに似た感じで\n\nこれは無視して頂いても大丈夫なんですが【居酒屋有頂天と達筆に書かれた巨大看板に店のドアを塞がれて店に入れず佇んでるハゲ（コロネスキーではない）】、カラーではなくラクガキ、線画レベルのを一枚お願いしたいです。本当に無視して頂いて大丈夫です。\n\n前回同様にご本人様のみイラストの使用許可をお願いしたく\n長くなり申し訳ございません！！料金も足りないようでしたら返送お願いします！！\n数年前から練っていたイラストなのでご検討して頂けましたら幸いです。\n\n追記、ビビさんのリスナー（ビビっ友）が今度受肉しますが関係なしに人間と半魚人でお願いします。", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@99999pr/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 119614, "client_id": 2549593, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/5cafd75d/uploads/origins/0bbe116d-712d-4549-92af-b59b0ad3526d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=595e7bf6c2320ac67633fe0ea4b60c2a", "srcset": "https://si.imgix.net/5cafd75d/uploads/origins/0bbe116d-712d-4549-92af-b59b0ad3526d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=595e7bf6c2320ac67633fe0ea4b60c2a, https://si.imgix.net/5cafd75d/uploads/origins/0bbe116d-712d-4549-92af-b59b0ad3526d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=0b302db01a5c3b22da861b632ca124c9 2x, https://si.imgix.net/5cafd75d/uploads/origins/0bbe116d-712d-4549-92af-b59b0ad3526d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e2bded81c5fcc04ed6109e98acfcb917 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/5cafd75d/uploads/origins/0bbe116d-712d-4549-92af-b59b0ad3526d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=755c53979ed5e1253ec9e171171313ab", "srcset": "https://si.imgix.net/5cafd75d/uploads/origins/0bbe116d-712d-4549-92af-b59b0ad3526d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=755c53979ed5e1253ec9e171171313ab, https://si.imgix.net/5cafd75d/uploads/origins/0bbe116d-712d-4549-92af-b59b0ad3526d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=f6a8d23b4c458b86c9a2ea76062f20de 2x, https://si.imgix.net/5cafd75d/uploads/origins/0bbe116d-712d-4549-92af-b59b0ad3526d?bg=%23fff&auto=