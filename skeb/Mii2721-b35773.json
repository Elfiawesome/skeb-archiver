si.imgix.net/aa387a0f/uploads/origins/b068e29c-3453-445a-a173-710956bf9702?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=545be195be4739ffbd9bb3938c4407c2", "srcset": "https://si.imgix.net/aa387a0f/uploads/origins/b068e29c-3453-445a-a173-710956bf9702?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=545be195be4739ffbd9bb3938c4407c2, https://si.imgix.net/aa387a0f/uploads/origins/b068e29c-3453-445a-a173-710956bf9702?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=e56ad83f6cee2cc994683521fc5d511a 2x, https://si.imgix.net/aa387a0f/uploads/origins/b068e29c-3453-445a-a173-710956bf9702?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=3bee9531a805bc5a199545875b08a8fa 3x"}, "body": "misakiさん、こんにちは。「お茶碗」と申します。\nTwitter（X）でたまたま「まんじゅう怖い」の絵を拝見してから、misakiさんの描くイラストに惹かれております。\n\nプロフィールに「人や動物を描くのが好き」とありましたので、私の一番好きな鳥を描いていただければと思い、リクエストを送りました。\n\n描いていただきたいのは「パフィン」と呼ばれる鳥です。\nこの呼び名で呼ばれる鳥は大きく分けて3種類いるのですが、もしよろしければ、その中の「エトピリカ」に近い顔や模様で描いていただけると嬉しいです。\n\n構図などはmisakiさんのお好きなようにしていただいて構いません。\n（「まんじゅうこわい」の絵を拝見して、あのシーンをこの構図で描くのか……というmisakiさんの\"画\"作りのセンスにも惹かれたもので……）\n\n描いていただいた絵は、SNSのアイコン等に使用したいと考えています。\nどうぞよろしくお願いいたします。", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Mii2721/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3387982, "client_id": 2937535, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/f4d561d8/uploads/origins/728d5e4b-b2c2-42c7-897d-2082eccd5f42?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=379d0494130ae37fd0ef928cda4acc4e", "srcset": "https://si.imgix.net/f4d561d8/uploads/origins/728d5e4b-b2c2-42c7-897d-2082eccd5f42?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=379d0494130ae37fd0ef928cda4acc4e, https://si.imgix.net/f4d561d8/uploads/origins/728d5e4b-b2c2-42c7-897d-2082eccd5f42?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=426ca61cc04dd77ba7ef70c335ba8bed 2x, https://si.imgix.net/f4d561d8/uploads/origins/728d5e4b-b2c2-42c7-897d-2082eccd5f42?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=bec1f457415c49ec85fc31de9a001216 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/f4d561d8/uploads/origins/728d5e4b-b2c2-42c7-897d-2082eccd5f42?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=1bbdddd1c215081368adbecf699fccb8", "srcset": "https://si.imgix.net/f4d561d8/uploads/origins/728d5e4b-b2c2-42c7-897d-2082eccd5f42?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=1bbdddd1c215081368adbecf699fccb8, https://si.imgix.net/f4d561d8/uploads/origins/728d5e4b-b2c2-42c7-897d-2082eccd5f42?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=fc67ef0ddc9dbcf852e576a2e5717755 2x, https://si.imgix.net/f4d561d8/uploads/origins/728d5e4b-b2c2-42c7-897d-2082eccd5f42?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=186d9f246bb7284c98b2b39fa0c8f03f 3x"}, "body": "はじめまして。あなたのアートは幾何学的な形と明るい色使いで、とても陽気で素敵です！また、様々なメディウムに似合うのも本当に驚きです。あなたのアートに出会えて嬉しいです！\n\n私のユニコーンの女の子のキャラクターのアートを作ることに興味があるかどうか知りたいです。彼女は自然や自分の住む世界を愛する優しいキャラクターです。彼女のデザインは、あなたのアートに合うように好きなように変えたり、シンプルにしたりできます。構図は特に考えていないので、あなたが合うと思うものでお願いします！\n\nしかし、もしあなたが私のOCを描くことに興味がないのであれば、別のプロンプトとして、あなたなりの白いユニコーンの解釈を見てみたいと思います。そのアイデアが浮かんだら何でも作ってください。\n\nどちらのプロンプトでも構いません！両方描く必要はありません。ただ選択肢を与えたかっただけです。どんなものであれ、あなたの絵をもっと見たい！このリクエストがうまく伝わることを願っています。ありがとうございました！\n\nhttps://drive.google.com/drive/folders/1AymqAw8Iy62jin7AStK5ugPLprqS1r80", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Mii2721/works/1", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/b3f7a30f/up