t": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@guusura_jp/works/9", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3362617, "client_id": 70581, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/986716b7/uploads/origins/6f576540-89bf-488d-8751-e416ad6143e3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4e80f05928e252347239b9f51e5e43e5", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/986716b7/uploads/origins/6f576540-89bf-488d-8751-e416ad6143e3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9801ca71d5dca828f8dd2db029dea89e", "src_set": ""}, "body": "はじめまして、ぐうたらスライムさん。\n\n直近で納品された男の娘風船疑似膨乳を拝見させていただきました。とても興味のわくイラストでしたので依頼をさせていただきたいと思います。\n\nhttps://www.pixiv.net/artworks/129030733\n上記の納品イラストの真ん中の姫カットの男の娘が同じように資料URL(小さな画像ですみません…)のようなコンビニ制服で胸に風船を入れた疑似超乳状態のイラストを描いてください。疑似超乳の大きさは上記のpixivの納品イラストでの超乳状態と同じくらいの胸でお願いします。背景の感じも上記のpixivのイラストのようなセット裏風でお願いします。\n\nシチュエーションとしては「テレビの再現ドラマでとても胸の大きい女性役をやることになった」というもので、男の娘はとても恥ずかしそうな感じで「こんな胸の女居ないって…」とブツブツ言っています。表情は上記のpixivイラストみたいな不機嫌そうな感じにしてください。\n\nまた、差分イラストとして風船を入れた疑似超乳が破裂してしまい、コンビニ制服の胸元がダルダルになってしまっている状態のイラストも描いてほしいです。「いってぇ〜…」と言いながら相変わらず不機嫌ながらも目に涙を浮かばせています。\n\n上記のような内容でお願いします。体調の方との相談になる可能性もあるかもしれませんが、どうかよろしくお願いします。\n\nhttps://www.dropbox.com/scl/fo/1mw4z47ly2aeyk3f6nt3j/AByCuCRwY2Aa8rTm2BpvBp4?rlkey=mq98uj4x7xan0633ba5tcr09r&st=ldnx09xc&dl=0", "nc": 32, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@guusura_jp/works/8", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3362617, "client_id": 0, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/8d4aaa3d/uploads/origins/7d62e6c7-8972-42e8-8a7b-c3cef8941d3a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&