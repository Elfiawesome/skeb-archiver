gins/7a602d51-1025-45d1-93b8-9996d200069c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=2f9cbe7eb7d1791629bdb8309c546902 3x"}, "body": "アピールありがとうございます！作品もいい感じですね。人魚のみりあを気に入っていただけて嬉しいです。\n\nみりあは2バージョンで描いてください。背景にはプールがあります。\n\n最初のバージョンは、ミリアが上下とも赤いビキニを着ています。ミリアは見る人を見て、微笑んでいます。\n\nセカンドバージョンはビキニトップのみで、腰の下にはオレンジ色のマーメイドテールが付いています。ビキニのボトムはヒレの下で結ばれています。足が濡れて人魚になったミリアですが、嬉しそうです。\n\nその他、細かいことはお任せします。", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@inahohonchan/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2509477, "client_id": 1624722, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/61972d03/uploads/origins/fb69fd61-51e2-4440-98b6-972b892e09e9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d1c9177bafd570f8af15b0866e1a0243", "srcset": "https://si.imgix.net/61972d03/uploads/origins/fb69fd61-51e2-4440-98b6-972b892e09e9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d1c9177bafd570f8af15b0866e1a0243, https://si.imgix.net/61972d03/uploads/origins/fb69fd61-51e2-4440-98b6-972b892e09e9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=4b61500f333271339a877df5aee6ef3c 2x, https://si.imgix.net/61972d03/uploads/origins/fb69fd61-51e2-4440-98b6-972b892e09e9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=44303b992627b41a512792536475bc02 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/61972d03/uploads/origins/fb69fd61-51e2-4440-98b6-972b892e09e9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0de18143dc0fd209d1cd2ec5341ed042", "srcset": "https://si.imgix.net/61972d03/uploads/origins/fb69fd61-51e2-4440-98b6-972b892e09e9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&bl