s://si.imgix.net/424e340b/uploads/origins/3d851c06-4523-4630-9e48-73aeac6fc2ff?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=376341777e70b150aeeb95e69da99171", "srcset": "https://si.imgix.net/424e340b/uploads/origins/3d851c06-4523-4630-9e48-73aeac6fc2ff?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=376341777e70b150aeeb95e69da99171, https://si.imgix.net/424e340b/uploads/origins/3d851c06-4523-4630-9e48-73aeac6fc2ff?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=98213e616a6aa6ccb65ca651447e1027 2x, https://si.imgix.net/424e340b/uploads/origins/3d851c06-4523-4630-9e48-73aeac6fc2ff?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=1fbafdb1cf4e343ddbc798c6ffcf06bf 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/424e340b/uploads/origins/3d851c06-4523-4630-9e48-73aeac6fc2ff?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=236aa8cb3c47128cb70a3c30dd475df7", "srcset": "https://si.imgix.net/424e340b/uploads/origins/3d851c06-4523-4630-9e48-73aeac6fc2ff?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=236aa8cb3c47128cb70a3c30dd475df7, https://si.imgix.net/424e340b/uploads/origins/3d851c06-4523-4630-9e48-73aeac6fc2ff?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=79348c279dbf5c18e1dc9165ec2d9d0f 2x, https://si.imgix.net/424e340b/uploads/origins/3d851c06-4523-4630-9e48-73aeac6fc2ff?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=844d4823b833c88c561fb45047c2ced8 3x"}, "body": "おぺつ様\n\n初めまして、個人でvtuberをしております初瀬りる（@paseriru）と申します。\n\nダークな雰囲気のイラストがとっても素敵で大好きだったので、ぜひご依頼したいと考えお声掛けさせて頂きました。\n\n以下についてはこんな風だと嬉しい、という希望です。\nお値段が定額なのもあり、できるできないがあることは承知しておりますので、おぺつ様の思う範囲内でお願いできればと思います。\n\n\n【人物】\n初瀬りるのイラストをお願いしたいです。\n\n【雰囲気・服装等】\n服装については共有させていただくゾンビ衣装でお願いいたします。\nまた、雰囲気、構図、表情等すべてお任せ致します！\n\n【使用用途】\nサムネイル、Twitterでのタグ投稿画像など、活動で使用させていただきたいと考えております。\nまた、可能であればグッズ等で使用させていただきたいなと思っております。商用の利用不可の場合はレイヤーの中にひとこと添えていただけますと嬉しいです。\n\n【その他】\n背景、人物を分けたpsdで納品していただけると嬉しいです。\n厚かましいお願いになってしまうのですが、可能であれば全身、もしくは上半身以上のイラストであり、髪の毛や服をはみ出ずに描いていただけるととても助かります。\n\n以上長くなってしまいましたが何卒よろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/1-0PEjSKIOM99YxaOIx2MUymWYfKpi23G", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@nekoonigirimaru/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2673559, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/eeb49d50/uploads/origins/2fe5165f-3875-409e-aa85-b46ecdaef62b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ca29b7ca0c52fb52293469c811c3ffa8", "srcset": "https://si.imgix.net/eeb49d50/uploads/origins/2fe5165f-3875-409e-aa85-b46ecdaef62b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ca29b7ca0c52fb52293469c811c3ffa8, https://si.imgix.net/eeb49d50/uploads/origins/2fe5165f-3875-409e-aa85-b46ecdaef62b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=627da865f8d94c12f0e0d6c14127674d 2x, https://si.imgix.net/eeb49d50/uploads/origins/2fe5165f-3875-409e-aa85-b46ecdaef62b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=473c91f28209b4ca217852457afd3c39 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/eeb49d50/uploads/origins/2fe5165f-3875-409e-aa85-b46ecdaef62b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9af1865a5fef236193159314f87710af", "srcset": "https://si.imgix.net/eeb49d50/uploads/origins/2fe5165f-3875-409e-aa85-b46ecdaef62b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9af1865a5fef236193159314f87710af, https://si.imgix.net/eeb49d50/