200&s=b5401b2865c9ac143cbab5f5b0ac6b56", "srcset": "https://si.imgix.net/e8d3fccf/uploads/origins/5e452864-34ec-4da6-8ebe-2a5e3e6af175?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b5401b2865c9ac143cbab5f5b0ac6b56, https://si.imgix.net/e8d3fccf/uploads/origins/5e452864-34ec-4da6-8ebe-2a5e3e6af175?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=9e40bea66f421f133e5d5b805db72be8 2x, https://si.imgix.net/e8d3fccf/uploads/origins/5e452864-34ec-4da6-8ebe-2a5e3e6af175?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=09a5297dd98d32c55e021d3bade3ac9a 3x"}, "body": "こんにちは！もとやまさんの絵柄や動物さんが大好きで、毎回新作が出る度にBOOTHで購入しています。\nこの度、skebを募集中とのことでリクエストさせてください。\n\n1.ふくよかなショートヘアのマダムとコビトカバの赤ちゃん、図書館のイメージをメインにお願いします。\n2.マダムは青いエプロンをつけています。\n3.可能であれば蓮の花をどこかに入れていただけると嬉しいです。\n\nこちらの3点以外にも、本や花、動物さんを自由に足していただいても構いません。", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@kotkotri/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3386228, "client_id": 27685, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/2e7e92cb/uploads/origins/0b8b17e6-9ea1-41ed-8d36-1f1880df28c5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=dd554084aae3910ba519d579f9f9981c", "srcset": "https://si.imgix.net/2e7e92cb/uploads/origins/0b8b17e6-9ea1-41ed-8d36-1f1880df28c5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=dd554084aae3910ba519d579f9f9981c, https://si.imgix.net/2e7e92cb/uploads/origins/0b8b17e6-9ea1-41ed-8d36-1f1880df28c5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f55cf0ceddc7ccac2546a3602badb797 2x, https://si.imgix.net/2e7e92cb/uploads/origins/0b8b17e6-9ea1-41ed-8d36-1f1880df28c5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b62cbeef2565e54a6ce969217e90f8c1 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/2e7e92cb/uploads/origins/0b8b17e6-9ea1-41ed-8d36-1f1880df28c5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f5990cf0049833cee7801a2bd7633914", "srcset": "https://si.imgix.net/2e7e92cb/uploads/origins/0b8b17e6-9ea1-41ed-8d36-1f1880df28c5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f5990cf0049833cee7801a2bd7633914, https://si.imgix.net/2e7e92cb/uploads/origins/0b8b17e6-9ea1-41ed-8d36-1f1880df28c5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=597350c79591ce136c7d19993150dbef 2x, https://si.imgix.net/2e7e92cb/uploads/origins/0b8b17e6-9ea1-41ed-8d36-1f1880df28c5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=6fabab2e034b217479bcaa4e9f621063 3x"}, "body": "もとやままさこ様\n\nこんばんは、もとやままさこ様。\nツイッターからイラストを拝見させて頂いてファンになったものです。\nいつも暖かいイラストをあげてくださりありがたい限りです。毎回癒やされます！\nそんなもとやままさこ様がスケブを開いていらっしゃることを知り、もしよろしければこちらのオリキャラのことを依頼したいです。\n\nお願い申し上げたいのはこちらのオリキャラ狐娘の万里香（まりか）という子です。\n狐耳と尻尾・赤メガネ・アホ毛、そしてちょっぴりツリ目な目つきが特徴的な、160cmくらいの身長の子です。\n本とか、動物や花、星空のような自然をぼーっと見るのが大好きな子です。\n性格的には、ちょっと人見知りで照れ屋ですので人前では余計にクールっぷりしてるけどまた寂しがり屋のちょっと面倒くさい感じです。一人の時や知り合いの前では表情が緩めてちょっと豊かになる感じです。\nこれだけではちょっと説明が足りないと思いますので設定と設定画など、ご参考できそうなものを下のURLにまとめております。\n\nこの娘でもとやままさこ様の絵柄でのイラストをどうかお願いしたいです。\n衣装は設定画のうちの一つで、動物達と一緒に本を楽しそうに読んでる、というのはどうですか？\nご検討くださいませ！\n\nお忙しい中、要件のみで申し訳ありません。\n応援しております！\n\nhttps://drive.google.com/drive/folders/1kVcp6B8dzGYFGpFb9spMTyDnz0TzyM7Q?usp=sharing", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 393571, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "えびみりん", "screen_name": "ebimirin1214", "avatar_url": "https://pbs.twimg.com/profile_images/1818113576852398080/fI7vr8lB.jpg", "header_url": "https://pbs.twimg.com/profile_