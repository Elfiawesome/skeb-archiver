嬉しいです！\n\nイメージや設定等はURL先で失礼いたします。ファイルの貼り方が分からなかったため、ツイッターやサイトのリンクになってしまい申し訳ありません…。\n①オリジナルキャラクター(https://twitter.com/pho_white7/status/1424002331842994181?s=21)\n男の子⇨ややタレ目で癖っ毛の子です。\n女の子⇨サラサラとした肩より少し長い髪の毛です。\n②全部大好きですし特に好きなイラストです🙏✨\n(つぎのさんがツイッターに載せられた、2021年1月19日〜27日の素敵なキャラ×たべもののイラストの雰囲気でお願いしたいです)\n③コック服イメージ\n(https://www.iwaki-uni.co.jp/smartphone/detail.html?id=000000001997、緑色のスカーフとエプロンでお願いできればと思います)", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@nextooo00/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1386843, "client_id": 232421, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/7756a74e/uploads/origins/da6eae70-922a-4a2d-a7f7-d8895cd352c9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4f36797bbdbfbae63c8d4359a800ee22", "srcset": "https://si.imgix.net/7756a74e/uploads/origins/da6eae70-922a-4a2d-a7f7-d8895cd352c9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4f36797bbdbfbae63c8d4359a800ee22, https://si.imgix.net/7756a74e/uploads/origins/da6eae70-922a-4a2d-a7f7-d8895cd352c9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ee621d1113912ea26cfde006e4ebfe7d 2x, https://si.imgix.net/7756a74e/uploads/origins/da6eae70-922a-4a2d-a7f7-d8895cd352c9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=bb11a772da14b48fd6d5ccf2897d30bc 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/7756a74e/uploads/origins/da6eae70-922a-4a2d-a7f7-d8895cd352c9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6a87fa548dc00a7f866e311790c940fc", "srcset": "https://si.imgix.net/7756a74e/uploads/origins/da6eae70-922a-4a2d-a7f7-d8895cd352c9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6a87fa548dc00a7f866e311790