1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1334564, "client_id": 2725465, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/e9c473f6/uploads/origins/9e2381cf-0758-4eb4-9009-33a5d7e8e59c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a7fa7a9aab981104dcba1579d4c417db", "srcset": "https://si.imgix.net/e9c473f6/uploads/origins/9e2381cf-0758-4eb4-9009-33a5d7e8e59c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a7fa7a9aab981104dcba1579d4c417db, https://si.imgix.net/e9c473f6/uploads/origins/9e2381cf-0758-4eb4-9009-33a5d7e8e59c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=34f6392954c34131ab878febc9757d8a 2x, https://si.imgix.net/e9c473f6/uploads/origins/9e2381cf-0758-4eb4-9009-33a5d7e8e59c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c631ff863d6a0fa5e4c89266ae5e2053 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/e9c473f6/uploads/origins/9e2381cf-0758-4eb4-9009-33a5d7e8e59c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d2c0f92d7ed079168a17f18f88971a47", "srcset": "https://si.imgix.net/e9c473f6/uploads/origins/9e2381cf-0758-4eb4-9009-33a5d7e8e59c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d2c0f92d7ed079168a17f18f88971a47, https://si.imgix.net/e9c473f6/uploads/origins/9e2381cf-0758-4eb4-9009-33a5d7e8e59c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=b9b35c18d70f1c75d52fbb1ca9295365 2x, https://si.imgix.net/e9c473f6/uploads/origins/9e2381cf-0758-4eb4-9009-33a5d7e8e59c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=f6721f8c753858df99654e80e8266a60 3x"}, "body": "【依頼概要】\nTRPG用の全身立ち絵＋下記三つの表情差分\n・笑顔\n・吐血＋苦しそうな顔\n・吐血＋無理して笑っている\n\n--------------------------------------\n名前：明楽 迅音（あきら はやと)\n年齢：20歳\n身長：176cm\n体重：65kg（176cmの平均体重より少し細め＝施設の仕事とバンド活動のおかげで、少し筋肉質で細身）\n職業：児童養護施設職員＋バンドマン\n＜https://iachara.com/sns/6032555/view＞\n→キャラの性格や職業の詳細は、上記URL先の「メモ欄」から確認よろしくお願いいたします！\n\n\n【テーマカラーとイメージ】\n・紫寄りのピンク：優しい、受容（施設職員部分）\n・橙色or黄色：快活、楽天的、親しみやすい（バンドマン部分）\n→上記3色をキャラの配色にて混ぜていただくか、どれか一部の色のみ用いていただく感じでも問題ありません！\n\n【顔】\n・人懐っこい顔。八重歯があっても可愛いかもしれない…。\n・でもイケメンも並立しているので、真顔だとかっこいいのに、笑うと急に犬っぽくなる。\n・普段はカラコンを入れている。（色はお任せします！）\n\n【服装】\n・マウンテンパーカー：シンプルなのは好まないため、複数色入っている少し目立つデザイン。\n・シャツ：アウターが派手なのでシンプルなもの。\n・ズボン：施設での仕事や子供を追いかけた時に引っかからないように、裾はシュッとしていて膨らんでいないタイプ。裾はハイカットスニーカーの中に入れてしまうことが多い。\n・ハイカットスニーカー：バンド活動用におしゃれなものの、子供たちと走り回るのも兼用なので走りやすいもの。結構生地が分厚いと私好みです（）\n\n【髪】\n・髪型：襟足が長いタイプで、普段は後頭部か首元辺りで緩く結んでるイメージ。その結ぶアレンジの仕方もバンドマンなのでちょっとおしゃれ。ハーフアップな感じでも大好きです！\n・ベースは明るいベージュ系→オレンジベージュかピンクベージュ（ここは服の配色によってどちらが似合うか変わると思うので、うおたさんのセンスに頼らせていただきたいです…！）\n・メッシュ：全体的にまばらに、ではなく片側の一部に入れていただきたいです。あくまで髪色のベースを中心した子がいいかなと…！\n　メッシュではなく、インナーカラーなどでも大丈夫です！\n\n【アクセサリ系】\n・ピアスは付けているが、子供相手をするときに引っかかって事故ったりしないように飾り部分が長いものは付けないようにしている。\n・左手首にシンプルめのブレスレットかシルバーのバングルを付けている。\n・ループタイの丸い部分（？）を結構下まで下げた状態で、カジュアルに首に付けて着こなしていたらいいなという願望があります…\n・指輪は、子供たちに触れた時に万が一引っかかるとまずいので基本つけていない。", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 520588, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "Ikegawa🍀絵を描く人", "screen_name": "Hikarigoke3", "avatar_url": "https://pbs.twimg.com/profile_images/2050564390479622145/I_JPAPpK.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1251152796532891648/1777727762/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 7, "complete_expiration_days": 20, "skills": [{"genre": "art"}], "banned": false, "nc": 16}, {"id": 624828, "creator": true, "nsfw_acceptable": false, "acceptable": false, "name": "宮花ゆう🌸🐾『青春マッチングアプリ』1巻5