他ご都合が合わない場合は、キャンセルいただいて問題ございません。\n\nご検討のほど、よろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/1tB3Np9g8HE2PcF7bg6UP7H5tql9enQ29", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "similar_creators": [{"id": 1158780, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "えのまる💫", "screen_name": "number_TRPG", "avatar_url": "https://pbs.twimg.com/profile_images/1930094699949502464/Wq640aHi.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1264327466870386688/1735916951/1500x500", "appeal_receivable": true, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 7, "complete_expiration_days": 120, "skills": [{"genre": "art"}, {"genre": "novel"}], "nc": 145}, {"id": 1746171, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "ｶｶﾄ", "screen_name": "spcsa35", "avatar_url": "https://pbs.twimg.com/profile_images/1934423053192314881/TvhDaQ3w.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1199045369608339456/1776951905/1500x500", "appeal_receivable": true, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "art"}], "nc": 128}, {"id": 2718263, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "hiyoko", "screen_name": "PUMZ03", "avatar_url": "https://pbs.twimg.com/profile_images/2032229943808319488/WE9QOK8t.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1648170063797846017/1768191945/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 120, "skills": [{"genre": "art"}], "nc": 1}, {"id": 3365717