 570593, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 49, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@Hsushhuahau/works/162", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 555048, "client_id": 0, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/253c9762/uploads/origins/4b515a7e-d8fd-4ae0-89d8-0a31a01a27f0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=82afef26431452f3b642228041e50b60", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/253c9762/uploads/origins/4b515a7e-d8fd-4ae0-89d8-0a31a01a27f0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=76351fbe5a4138bee7fd157ca658f71f", "src_set": ""}, "body": "女性が男性になるビフォーアフターをお願いしたい。\n\nある既婚女性が男になることを決意した。\n彼女は夫に謝り、もう夫の女にも子供の母親にもなれないと言う。\n彼女はずっと男になりたかった。\n最後にもう一度、自分の裸体をよく見てほしいと夫に頼む。\n\nその後、彼女は男になった。\n彼女は彼に自分の体を見てくれと頼む。\n彼が愛していた女性の部分はすべてなくなっている。\n彼女はもう彼の妻にはなれない。\n彼が望むなら、彼女はボーイフレンドになれる。\n\n変身前の彼女はセクシーで大人っぽい。\n大きな胸とふくよかな体。\n乳が滴る大きな乳首。\n母親の体。\n優しい顔。\nポニーテールに結ったダークブラウンの髪。\n\n変身後もふくよかな大人の体。\nホルモン剤で育った少年のような小さな乳房。\n小さくて黒い乳首。\nペニスは小さく弱い。", "nc": 176, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Hsushhuahau/works/161", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/3961298b/uploads/origins/1f2973d7-15c0-4b30-af9a-62880a67499c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=756c5decd6f47c3da74002eb795629ba", "src_set": ""}, "private": true, "genre": "art", "tipped": true, "creator_id": 555048, "client_id": 203670, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "h