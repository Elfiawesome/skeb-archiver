3fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=c6819d9e6f68817a1af07f8589e19671 3x"}, "body": "とろみ先生@Skeb募集中先生、はじめまして\n匿名で失礼いたします。\n新着作品で流れてきた絵柄が好みでして、リクエストいたします。\n\n描いていただきたいのは、FANZA GAMESの宝石姫のダイヤモンドというキャラクターです。\n資料URLが服装となります。\n\n\n乳暖簾や下乳・横乳がエッチになるような感じでお願いしたいと思います。\n表情や構図など他はすべて先生にお任せいたします。\n\n＊3Dのデフォルメキャラの画像ですが、ご参考になれば幸いです。\n横や背面の資料\nhttps://gyazo.com/121cff9603f2c7008fa53a511f2bba4a\n城の1本ストライプが入った紫のスカートのようなものは前掛けで、後ろから見るとお尻が丸見えな衣装です。\n\nマイナーなゲームで資料も少なく、衣装も複雑で大変恐縮ではございますが、\nどうかよろしくお願いいたします。\n\nhttps://jewel-reincarnation.wikiru.jp/?%E3%83%80%E3%82%A4%E3%83%A4%E3%83%A2%E3%83%B3%E3%83%89", "nc": 160, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@toromi_sensei/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3979246, "client_id": 3672600, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/7d713066/uploads/origins/f1ce7a90-55c8-4386-9c13-9dced19afdbe?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=327eb647a3e1eaeb6841b2dc561aff83", "srcset": "https://si.imgix.net/7d713066/uploads/origins/f1ce7a90-55c8-4386-9c13-9dced19afdbe?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=327eb647a3e1eaeb6841b2dc561aff83, https://si.imgix.net/7d713066/uploads/origins/f1ce7a90-55c8-4386-9c13-9dced19afdbe?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=93dbe2e0805a5acd790861b3f2278e83 2x, https://si.imgix.net/7d713066/uploads/origins/f1ce7a90-55c8-4386-9c13-9dced19afdbe?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=496bdd91fd9db414ec31cba0b54644dc 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/7d713066/uploads/origins/f1ce7a90-55c8-4386-9c13-9dced19afdbe?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=797ad53f5e2bce519bf15b9a19c7fdee", "srcset": "https://si.imgix.net/7d713066/uploads/origins/f1ce7a90-55c8-4386-9c13-9dced19afdbe?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=797ad53f5e2bce519bf15b9a19c7fdee, https://si.imgix.net/7d713066/uploads/origins/f1ce7a90-55c8-4386-9c13-9dced19afdbe?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=e3124195c2375c7de400973db1d04815 2x, https://si.imgix.net/7d713066/uploads/origins/f1ce7a90-55c8-4386-9c13-9dced19afdbe?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=f32fedb2ecbff77bc1be7c55de4121c4 3x"}, "body": "こんにちは。あなたの作品、特に髪の毛のディテールへのこだわりが本当に素敵だと思います！私の推しであるルミエル・ルミエールのエロいイラストを描いていただけないでしょうか。\n\nバニースーツ、あるいはストッキングから足が見えるリバースバニースーツ姿で描いていただけると嬉しいです。 \n\nポーズやエッチな度合いは、お任せします。\n\nこのリクエストは、Xのアートタグを通じて投稿する予定です。\n\nhttps://x.com/i/status/2053490990237839560", "nc": 160, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@toromi_sensei/works/6", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/32b98f41/uploads/origins/4f4af27e-ec28-401d-9aca-e5054aca6ac6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=ce1a3c6f1689a4c196c96ee97d5b71bc", "srcset": "https://si.imgix.net/32b98f41/uploads/origins/4f4af27e-ec28-401d-9aca-e5054aca6ac6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=ce1a3c6f1689a4c196c96ee97d5b71bc, https://si.imgix.net/32b98f41/uploads/origins/4f4af27e-ec28-401d-9aca-e5054aca6ac6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=51496ff044662267aec8942956242cfc 2x, https://si.imgix.net/32b98f41/uploads/origins/4f