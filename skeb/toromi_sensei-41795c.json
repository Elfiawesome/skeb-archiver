55de4121c4 3x"}, "body": "こんにちは。あなたの作品、特に髪の毛のディテールへのこだわりが本当に素敵だと思います！私の推しであるルミエル・ルミエールのエロいイラストを描いていただけないでしょうか。\n\nバニースーツ、あるいはストッキングから足が見えるリバースバニースーツ姿で描いていただけると嬉しいです。 \n\nポーズやエッチな度合いは、お任せします。\n\nこのリクエストは、Xのアートタグを通じて投稿する予定です。\n\nhttps://x.com/i/status/2053490990237839560", "nc": 160, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@toromi_sensei/works/6", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/32b98f41/uploads/origins/4f4af27e-ec28-401d-9aca-e5054aca6ac6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=ce1a3c6f1689a4c196c96ee97d5b71bc", "srcset": "https://si.imgix.net/32b98f41/uploads/origins/4f4af27e-ec28-401d-9aca-e5054aca6ac6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=ce1a3c6f1689a4c196c96ee97d5b71bc, https://si.imgix.net/32b98f41/uploads/origins/4f4af27e-ec28-401d-9aca-e5054aca6ac6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=51496ff044662267aec8942956242cfc 2x, https://si.imgix.net/32b98f41/uploads/origins/4f4af27e-ec28-401d-9aca-e5054aca6ac6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=d70d2265fde674dba257b8892421d9bb 3x"}, "private": true, "genre": "art", "tipped": false, "creator_id": 3979246, "client_id": 1027591, "nc": 32}, {"path": "/@toromi_sensei/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3979246, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/5b960807/uploads/origins/610ac38a-0742-410e-b52a-7cd684274da3?bg=%23fff