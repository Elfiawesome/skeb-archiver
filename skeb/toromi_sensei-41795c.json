1etDshu3ynwkAVVchRwEUqbZzHO6siCla/\nと同様の構図及び体位で和姦処女喪失(破瓜の血の描写をお願いします)\n↓\nピストン(竿に白く濁った愛液=本気汁が絡みつき始める)\n↓\n根元まで押し込んで下半身を密着させ、子宮口に押し付けながら破瓜中出しと同時に絶頂\nお尻やスカート、背中→大量に中出しされた精液が溢れて細かく飛び散っている\n結合部及び周辺→破瓜の血・本気汁・精液まみれ\n(血・本気汁・精液をそれぞれオンオフ可能に)\n(可能であれば)オンオフ可能な断面図\n↓\n引き抜かれて血・本気汁・精液がべっとり絡みついたモノとアソコとでザーメンブリッジ、\n開いたままの膣口から血と本気汁混じりの精液が溢れている描写(モノが服や体に被らないと嬉しいです)\n↓\n髪・顔・口内・服・ふともも(・黒ハイソックス)などもうかける場所がないくらい全身ドロドロな状態\n\n擬音や喘ぎ声等もあると助かります\n喘ぎ声は基本的に「あ」を使用し、\n絶頂時は「あ、あ、あ、あぁぁぁぁぁぁぁぁっ!!」\n\n結合部に\n藻ではなく線を使って頂けると捗ります\n(色は白)\n\nレイヤーは可能な限り細かく\n\n\n・背景\n自室想定で白いシーツのベッド上\n\n\n\n・男性\n同年代想定の特徴がない普通の男性(全裸)\n手や下半身程度\n\n\n何卒ご検討下さい。\n\nhttps://drive.google.com/drive/folders/1IwML5k39fvT-axqqDQd9sn5Ym7GOIG2q", "nc": 184, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@toromi_sensei/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "comic", "tipped": false, "creator_id": 3979246, "client_id": 1872748, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/ba502e0a/uploads/origins/cf7d73c5-90d4-483d-8ff3-c450e9298572?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f6defd44a07593cdc6bd7ed09c85e16f", "srcset": "https://si.imgix.net/ba502e0a/uploads/origins/cf7d73c5-90d4-483d-8ff3-c450e9298572?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f6defd44a07593cdc6bd7ed09c85e16f, https://si.imgix.net/ba502e0a/uploads/origins/cf7d73c5-90d4-483d-8ff3-c450e9298572?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=622e6cd61d9b7b5c348dc194e7cab9a1 2x, https://si.imgix.net/ba502e0a/uploads/origins/cf7d73c5-90d4-483d-8ff3-c450e9298572?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a0d79ed664e9abbc400171b7a1a0bb50 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/ba502e0a/uploads/origins/cf7d73c5-90d4-483d-8ff3-c450e9298572?bg=%23fff&auto=format%2Ccompress&fm=webp