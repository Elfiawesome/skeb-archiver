.net/c18c6568/uploads/origins/1f575a2e-b094-49e8-96e3-ea655af51a80?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4cce09a8175241933ae2bc76d7a99710", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/c18c6568/uploads/origins/1f575a2e-b094-49e8-96e3-ea655af51a80?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a85ecf9bd98565d7d533eb917f2144bd", "src_set": ""}, "body": "はじめまして。 よろしければ下記の内容にてイラストの依頼をさせていただきたく存じます。 \n-------  \n【依頼概要】 \n個人VTuber、浅瀬遊希さんの銭湯コラボ風イラストをお願いします。\n\n  【構図】\n ・全身（立ち絵風）\n\n  【外見イメージ】\n 基本的な容姿は遊希さんの現行の最新デザイン準拠。（髪をおろした姿） 金色の髪飾りは装着したままで、ウサ耳は外した状態でお願いします。  \n\n【服装】 \n服装は浴衣＋羽織のお風呂上りスタイルで、胸元は無防備にはだけている状態。（乳輪がギリギリ見えないくらい） 浴衣の色はダークレッド、帯や羽織は黒色。（浴衣の柄は牡丹をあしらったデザインが希望です） 足には下駄を履いている。\n\n  【その他・小道具など】 \n風呂上りらしく首にはタオルを。 また木製の風呂桶を小脇に抱えていて、桶の中には頭から外したウサ耳カチューシャといかがわしいローションのボトルが入っている。  \n\n【表情・シチュエーション】\n お風呂上りにバッタリ会ったリスナーに向かって妖艶に、いたずらっぽく微笑むイメージ \n\n 【備考】\n ・服装や小道具については筆が乗るようにアレンジしていただいて構いません。 \n・イメージとしてはアズールレーンの銭湯コラボ立ち絵が近いと思います。\n ------- \n何卒ご検討のほどよろしくお願いいたします。", "nc": 177, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@gizajuu10/works/35", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/83ce2555/uploads/origins/7da83478-e1b5-44a1-abb8-da0f190dfa2f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=8718898fdeccfbc21f44f5fcb4107d58", "src_set": ""}, "private": true, "genre": "art", "tipped": false, "creator_id": 1748056, "client_id": 0, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 161, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@gizajuu10/works/34", "private_thumbnail_image_urls": {"src": "https://si.imgix.