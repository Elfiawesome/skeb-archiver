f&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ed0a2267ccece09f69fe2cf4e7a02933", "src_set": ""}, "body": "リクエスト再開お待ちしておりました。https://skeb.jp/@gizajuu10/works/25 のチンカス描写や https://www.pixiv.net/en/artworks/117633459 のキャラクターの可愛さ、髪の綺麗さにビビッときまして、ぜひリクエストしたいと思っておりました。\n\nアイドルマスターシンデレラガールズの小早川紗枝でチンカスプレイのイラストをお願いできないでしょうか\nひとつは https://skeb.jp/@gizajuu10/works/25 のような感じで、皮を剥いてチンカスまみれのチンポを舌で舐めとります。舌の上に舐めとったチンカスや陰毛がよく見える感じだと嬉しいです。差分でチンカスの咀嚼やごっくんもいただきたいです。\n\nもうひとつはチンカスまみれのチンポを頭に擦り付けて、綺麗なサラサラの髪の毛でチンカス掃除をします。髪の毛にチンカスがこびりついているのがわかるような描写がいただけると嬉しいです。こちらは射精差分で髪の毛が精液でベタベタになっているような描写がいただけるとさらに嬉しいです。\n\n服装は[思ひ出になる今日へ]小早川紗枝の制服姿でお願いします。ふたつのプレイはそれぞれ別イラストでも、別カットとして一枚にまとめていただいても構いません。要望が大盛で恐縮ですが、ご検討いただければ幸いです。どうぞよろしくお願いします。\n\nhttps://imas.gamedbs.jp/cg/idol/detail/33?h=imcgss-c3159", "nc": 41, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@gizajuu10/works/28", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/0a25c277/uploads/origins/81279e6a-1c62-4d0e-982b-70377e1b79bb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=755dcc9e1e481bd1d93f2b48e4970a8c", "src_set": ""}, "private": true, "genre": "art", "tipped": false, "creator_id": 1748056, "client_id": 22182, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 48, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@gizajuu10/works/27", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1748056, "client_id": 92937, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/82aca7e4/uploads/origins/1cd55a3f-7254-4f49-9f10-4ff25b3bd024?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8fce816bbb038805d18d698518aaa8e3", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/82aca7e4/uploads/origins/1cd55a3f-7254-4f49-9f10-4ff25b3bd024?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9cdc2dcad8982f7996cebf5149d5cfa8", "src_set": ""}, "body": "はじめまして…！\nギザジュウ様のとても可愛いイラストをX(Twitter)でお見かけし、是非私も描いていただきたいと思い、リクエストいたしました…！\n\n伝えた内容の中で難しいもの、分かりづらいものがあった場合や、こうした方がいい、などあれば、内容を一部省略したり変更するなど、自由に描いていただけるとうれしいです…！\n\n内容としては\n私のOC兼アバターである、ひつじ娘の桜日ハルのイラスト\n\n詳しい内容\nこちらの作品(https://x.com/gizajuu10_rr/status/1742545973425951173?s=46&t=PhnHJnJyxv7in8tNnUZelA)がとても癖に刺さったので、同じようなシチュエーションで、涙目でチンカスお掃除フェラをしている姿をお願いしたいです…！\nまた、綺麗になったおちんちんとは反対に舐めとったチンカスがたくさん乗って汚れてしまった舌を見せさせられる描写も入れていただきたいです…！\n\n衣装は資料のもの、またはおまかせします\n\nというもので、もしよろしければお願いします…！\n\n設定などはこちらのURL先「桜日ハル(設定・資料)」という欄のもの\nhttps://profcard.info/u/T8qYyDkjSlTsUZ2PyqiHkKar1jK2\n\n姿の資料はこちらのURL先にある和メイド姿のものです\nhttps://x.com/halvital396/status/1653961644270325762?s=46&t=PhnHJnJyxv7in8tNnUZelA", "nc": 49, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@gizajuu10/works/26", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1748056, "client_id": 0, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/f67162df/uploads/origins/0952e8a5-760b-4771-bea7-d9dfda34748e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b1ca85de072f6cda1814bf1d11ce46a2", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/f67162df/uploads/origins/0952e8a5-760b-4771-bea7-d9dfda34748e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b8c9967936efc38f6d5fa089a8b19ff8", "src_set": ""}, "body": "いつもお世話になっております。\n前回素晴らしいリリス様を有難うございました。\n今回もリクエストお願いします！\n\n「戦闘員、派遣します！」に登場する黒のリリスを書いてほしいです。\n\n内容としては\nお風呂に入るために着替えている所を盗撮されてしまうイラストをお願いしたいです。\n本人は、盗撮されている事に気づかず無防備に着替える感じでお願いします。\n\n下着は\n↓のシナモンロールの白ををイメージしたものでお願いします。\nhttps://amzn.asia/d/duGJHyM\n\nもし可能であれば、ニコニコ動画のように視聴者の変態コメントがほしいです。\n\n注文が多いですが、何卒よろしくお願いします。", "nc": 161, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@gizajuu10/works/25", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1748056, "client_id": 0, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/57d3f9d1/uploads/origins/b2f2053a-f375-4723-a6bc-db48a344bb84?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=25d9206e4e4533ee282c670b4462bba5", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/57d3f9d1/uploads/origins/b2f2053a-f375-4723-a6bc-db48a344bb84?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ea6d7d40789b0c5dc2c2aaab1b3f18a2", "src_set": ""}, "body": "前回は素晴らしいリリス様のイラストを有難うございました。またリクエストお願いします。\n\n「戦闘員、派遣します！」に登場する黒のリリスを書いてほしいです。\n\nシチュエーションとしては、実験を頑張ったご褒美としてフェラをしてもらうシチュでお願いします。\n包茎でチンカスの溜まったチンポに舌を使って綺麗にして最後にチンカスがなくなった綺麗なチンポが映る感じでお願いします。\nチンカスの量にドン引いて、内心は罵倒しながらも舌を使ってピカピカにする感じでお願いします。\n\n注文が多いですが、何卒よろしくお願いします。", "nc": 176, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@gizajuu10/works/24", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1748056, "client_id": 0, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/7058c882/uploads/origins/660032df-f558-4a48-8cdd-16e651ee4027?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=db3e720ec05917b56f7a515b8ee85e56", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/7058c882/uploads/origins/660032df-f558-4a48-8cdd-16e651ee4027?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=fe45cc3c38d228c9b831930103036c03", "src_set": ""}, "body": "ギザジュウ様\n若葉ひなたのイラスト、いつもお世話になっております。\n\nこの度またリクエストしたく…\n\n今回はシチュエーションとして、足(膝)を痛めつけられた結果ギブアップ。痛めつけられた足を庇い倒れている状況で御願いしたいです。\n\nコスチュームとしては体操服のブルマ(裾出し)で、良い感じに素肌が見えているとありがたいです。\n\n表情としては泣いて痛がっている感じで御願いします。\n\n(可能であればなのですが、表情差分2.3種程作成して頂けると幸いです。)\n\n御検討を御願い致します。", "nc": 40, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@gizajuu10/works/23", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1748056, "client_id": 0, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/71a00e18/uploads/origins/2194a4a7-abd0-4311-b41c-130abe66d0b4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5cf0ca049c4841e89de37a4a5871078a", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/71a00e18/uploads/origins/2194a4a7-abd0-4311-b41c-130abe66d0b4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f2b4e4300a4bc218440f9dbb6d499bad", "src_set": ""}, "body": "こんちにちは！初めまして。\n\n先生の↓足コキイラストがすばらしかったためリクエスト致しました。\nhttps://skeb.jp/@gizajuu10/works/20\n\n書いて欲しいキャラ\n「戦闘員、派遣します！」に登場する黒のリリス\nhttps://sneakerbunko.jp/kisaragi/img/chara_08.png\n\n内容\nガルパンのマリーのイラストのように、パンチラをしながらニーソを履いた足で、罵倒しながら足コキをするイラストをお願いします。\n\nよろしくお願いいたします。", "nc": 176, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@gizajuu10/works/22", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/0570321c/uploads/origins/885d598d-4b4c-4e77-a5af-9506320d24eb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=12445e61e14b522f773f154906fcf60d", "src_set": ""}, "private": true, "genre": "art", "tipped": true, "creator_id": 1748056, "client_id": 0, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 178, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@gizajuu10/works/21", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/419bb8a0/uploads/origins/d5fdec68-b349-453f-9191-da0cd73b58dd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=29ac4e2ab84f6aaf5d84daba132f73ea", "src_set": ""}, "private": true, "genre": "art", "tipped": true, "creator_id": 1748056, "client_id": 0, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 34, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@gizajuu10/works/20", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1748056, "client_id": 0, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/7e9272aa/uploads/origins/17ebf1a6-0ae1-4558-8a04-cb477e328cb7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f114503d2ce284d49b93adb67d060a66", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/7e9272aa/uploads/origins/17ebf1a6-0ae1-4558-8a04-cb477e328cb7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ea43491faba526515436af462641febe", "src_set": ""}, "body": "こんにちわ！ギザジュウ様がお描きになりましたプルアさん、セセリアマゾ向けイラストが素晴らしくリクエストをお送りさせていただきます。\n\n●キャラ\nガルパンのマリー\n・https://x.gd/BIYVM\n・https://x.gd/HXs3V\n・https://x.gd/F97Cr\n●服装参考画像\n・https://x.gd/91RQW\n\n●構図\n・以前お描きになりましたプルアさんと似た構図にて、足コキをしているイラストをお願い致します\n・服装は、パンツが見えている以外は着崩さず着衣にてお描きください\n・表情は、見下してバカにしているようなイメージ\n・ギザジュウ様の選ばれるセリフも素晴らしくセリフもいれていただければ幸いです\n・また靴着用、靴下着用差分、射精差分も可能であればお願い致します。\n\n細かなご指定をしてしまい、申し訳ありませんが是非ご検討の程よろしくお願い致します。", "nc": 160, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@gizajuu10/works/19", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1748056, "client_id": 2488568, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/238254f7/uploads/origins/827d8e9f-4e6c-41c0-91c3-85ce8a8bf0eb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9f885a339f4222ee06aba5482194d768", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/238254f7/uploads/origins/827d8e9f-4e6c-41c0-91c3-85ce8a8bf0eb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=19e83a5a632396198761f6b033e679f8", "src_set": ""}, "body": "こんにちは、私のキャラクター、ハニーの画像をリクエストしたいです。\nhttps://www.pixiv.net/artworks/105707746 のようなベッドの上で、男性が彼女と宣教師体位でセックスしているPOV画像です。\n彼女の両腕は頭の上で縛られ、両脚は広げられています。彼女は目隠しをされ、白いニーソックスとハートのネックレス以外は裸である。\n男は彼女の片方の乳房を乱暴に揉みしだき、乳首を口に入れ、https://www.pixiv.net/artworks/101186473。彼女は熱心に吸っており、唾液は多いがミルクは出ていない。\nもう片方の乳首にはピンクのバイブが貼られ、男は電マをクリトリスに当てている。\n目隠しが部分的に外れて目が見えるバージョンも欲しい。男が彼女の中で射精すると、彼女はアヘ顔で潮を吹く。\nありがとうございました！\n\nhttps://drive.google.com/drive/folders/1imp9fK0fCV3nqfizYqCvfkrROcj0rvTt", "nc": 168, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@gizajuu10/works/18", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1748056, "client_id": 605317, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/d5bd5e15/uploads/origins/40cc4a13-698f-443e-9c43-9b332ff82693?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4e72bb6afb94e0a41a080993c744b2f2", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/d5bd5e15/uploads/origins/40cc4a13-698f-443e-9c43-9b332ff82693?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=bea378f78645ca2d79d34e56220969e2", "src_set": ""}, "body": "バイブルブラックの佐伯香織をお願いします。\nhttps://drive.google.com/drive/folders/1qI-P-c8VG1FXqclyfEeHpm0v1BU4lLdq?usp=drive_link\n\nおっさんに強制フェラチオされてるシチュで\n\n服装は資料画像の私服姿で上着はめくれ胸は露出している。\n後ろ手で拘束され口にはリングギャグを付けられる。\nhttps://drive.google.com/drive/folders/1yN_A-YAxVas7OngJn2ieVZQ5bzVHvddC?usp=drive_link\n\nしゃがんでパンチラしながらリングギャグを付けたまま男に頭を掴まれてイラマチオされている。\n香織は苦しそうな表情をしている。\n\n射精差分と白目むきそうな表情の差分もあると嬉しいです。\n\nご検討のほどお願いします。", "nc": 168, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@gizajuu10/works/17", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1748056, "client_id": 1304968, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/5843fb62/uploads/origins/bf12b935-ec42-4efc-9464-2aa3af4902ec?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f1cbb563252bb6d1c0998ab38609b34c", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/5843fb62/uploads/origins/bf12b935-ec42-4efc-9464-2aa3af4902ec?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6b0751a3205d343f387e50b3c4b81303", "src_set": ""}, "body": "ギザジュウ先生お疲れ様です。前回はありがとうござい\nました。よろしければリクエストお願い致します。\n\n■キャラクター・外見\n・合歓垣amneさん\n・https://www.pixiv.net/artworks/99161562\n　こちらの様な裸に黒ニーソのみか全裸でお願いします。\n\n■シチュエーション・構図等\n・前回描いて頂いたセルフ授乳しながらのエッチが素晴らし\n　かったので今回も同じ様なシチュでのお願いです。\n・主観視点の正常位セックス、結合部が見えている。\n・amneさんは興奮すると母乳が出るという設定で、突かれな\n　がら前回と同じく胸を手で口に寄せて母乳の出る乳首を\n　吸うか舐めていて、片方の手でもう片方の乳首を摘まんで\n　搾乳している。\n・イチャラブな感じでもいいですし、わからせといった感じ\n　でハメながらセルフ授乳をさせているという感じでも構い\n　ません。\n・汗や母乳、愛液等の液体表現を先生のお好みでお願いします。\n・よろしければ膣内射精され、同時にamneさんも絶頂する様子\n　の差分を描いて頂けると嬉しいです。\n\nご検討よろしくお願い致します。", "nc": 33, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@gizajuu10/works/16", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1748056, "client_id": 2485057, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/0ec93200/uploads/origins/57e6bf5f-e4d3-420e-8d2b-6d6be8d4a81f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d0e9068d733076539327b1921ab7f39a", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/0ec93200/uploads/origins/57e6bf5f-e4d3-420e-8d2b-6d6be8d4a81f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9c544e40ffb3d9826e2cda605ed299a2", "src_set": ""}, "body": "失礼します。\n\nSAMURAI DEEPER KYOのアンテラが足をこちらに向けた状態で脱衣KOされ気絶している姿をお願いします。\n\n服装は設定通りで足袋のみ無傷で汚れ無し、厚底の草履は脱げて飛ばされている感じです。", "nc": 32, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@gizajuu10/works/15", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1748056, "client_id": 1304968, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/4c616771/uploads/origins/2132e30f-96a0-4a4b-ac9e-00f09f02df01?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0b876bccb2787e1496ed1ee7cc38f1b6", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/4c616771/uploads/origins/2132e30f-96a0-4a4b-ac9e-00f09f02df01?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9dd05964261ac3a5f08bbc36ae9008ca", "src_set": ""}, "body": "ギザジュウ先生こんにちは。素敵なイラストを\n拝見しましてリクエストを送らせていただきます。\nよろしければお願い致します。\n\n■キャラ・外見\n・https://www.pixiv.net/artworks/86237537\n　こちらの作品のセルフ授乳お姉さん\n・イラストの恰好もしくは全裸\n\n■シチュエーション・構図等\n・セルフ授乳しながらセックスしているという感じで\n　お姉さんとのエッチイラストをお願いします。\n・主観視点の正常位か騎乗位のどちらかで。\n・お姉さんは片方の母乳の出る乳首を吸うか舐めていて\n　もう片方の乳首を摘まんで搾乳し、感じている表情。\n　先生の描きやすい様にアレンジして頂いても構いません。\n・可能でしたら膣内射精され、同時にお姉さんも絶頂する\n　差分を描いて頂けると嬉しいです。\n\nご検討よろしくお願い致します。", "nc": 48, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@gizajuu10/works/14", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1748056, "client_id": 0, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/32eb197b/uploads/origins/d11a56ed-b93a-4150-8250-275dd6cc3180?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e35d8cd816f21d0c348fc1d02c197241", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/32eb197b/uploads/origins/d11a56ed-b93a-4150-8250-275dd6cc3180?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d5a7a751c876c8a9db8cd83d29625cc0", "src_set": ""}, "body": "私立ジャスティス学園シリーズの若葉ひなた(制服)のイラストを御願い致します。\n\n参考動画(https://youtu.be/ntja-UIk67I)1:22〜を参考にダウン中に片足を掴まれて強制的に開脚させられ、丸見えになっているシチュで御願い致します。\n\n表情ですが、赤面して慌てている表情で御願いします。(可能であれば、レイプ目で泣き喚いている表情、両目を閉じて泣き喚いている表情、失神している(寝ている)表情の差分を御願いしたいです。)\n\nhttps://w.atwiki.jp/niconicomugen/pages/1688.amp", "nc": 185, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@gizajuu10/works/13", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1748056, "client_id": 971874, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/3d17bc42/uploads/origins/cb9bc5b2-cc4b-4ce5-84d5-d92d502c5ad2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2283e59c4fed50da2df95b8ad296a274", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/3d17bc42/uploads/origins/cb9bc5b2-cc4b-4ce5-84d5-d92d502c5ad2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=173c40a32ddc3077c2d595f07be2d728", "src_set": ""}, "body": "はじめまして。\n素晴らしい作品をお見かけしたのでリクエストさせていただきます。\n\n●キャラクター\n艦これ　千歳\n\n●服装\n白いブラウス、黒タイツ、白いショーツ\nブラウスは前をはだけ。タイツは股間部だけ破けている。ショーツずらして挿入\nタイツは資料の通常立ち絵くらいの濃さ\n\n●シチュエーション\nアクシデントでショタ化した提督とイチャイチャセックス\n“怪しげな実験で縮んでしまった提督。それでも嫁艦との情事は止められない。\n幼い体には快感が強すぎて相手の事なんて考えず夢中で腰振り。\nそんな提督を千歳は優しく受け止めてくれるのでした”\n\n・正常位で、ショタがおっぱいに顔を埋めて抱きつく体勢\n・快感で夢中になってヘコヘコ腰を振るショタ提督と、それを愛おしそうな表情で見つめる千歳\n・千歳はショタの頭を撫でている。左手薬指に結婚指輪\n・千歳は身長170cm位のイメージ。はっきりと体格差があると嬉しいです\n・ショタ提督は全裸。黒髪短髪\n\n以上です。ご検討いただければ幸いです。\n\nhttps://imgur.com/a/9m07iYD", "nc": 57, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@gizajuu10/works/12", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/0107f3bb/uploads/origins/01021490-ac9f-4724-8019-23ca29e0bf6c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=ae3efa839d80782b31e4b40008b26744", "src_set": ""}, "private": true, "genre": "art", "tipped": false, "creator_id": 1748056, "client_id": 347903, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 176, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@gizajuu10/works/11", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/cd2b91a4/uploads/origins/bae9ce98-e0d8-4d75-8b31-fb0369316c1f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=76bc524a6b8b4d93e615ea318c077fa0", "src_set": ""}, "private": true, "genre": "art", "tipped": false, "creator_id": 1748056, "client_id": 347903, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 161, "word_count": 0, "transcoder": "", "creator_acce