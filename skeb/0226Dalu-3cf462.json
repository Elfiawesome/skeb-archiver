いファーが付いており、猫耳(リングのピアス２つ付き)もついています。猫耳は取り外し可能です。\n\n性格 : 人に対し挑発的な表情で笑ったり、煽ったりする子で、情緒が安定しないので泣いたり怒ったりもします。焦ったような、何かに怯えたような顔もしがち。\n\nhttps://drive.google.com/drive/folders/1ExgpzwnMbD0Ve5UsPcjO-hhDHbcdozqr?usp=sharing", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}], "similar_creators": [{"id": 7565, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "🐇", "screen_name": "u_arca_u", "avatar_url": "https://pbs.twimg.com/profile_images/1605160738108035072/YMZZmIvG.png", "header_url": "https://pbs.twimg.com/profile_banners/1049340312571666436/1613799222/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "art"}], "banned": false, "nc": 145}, {"id": 866772, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "しお大福🧂", "screen_name": "sio_anko2", "avatar_url": "https://pbs.twimg.com/profile_images/1867571173472841728/ZgMQRO8p.jpg", "header_url": "https://pbs.twimg.com/profile_banners/854705023271358466/1786983971/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 18, "complete_expiration_days": 55, "skills": [{"genre": "art"}], "banned": false, "nc": 16}, {"id": 2740400, "creator": true, "nsfw_acceptable": false, "acceptable": false, "name": "しにもち", "screen_name": "sinimochi", "avatar_url": "https://pbs.twimg.com/profile_images/2029496446618398720/01-qLLNH.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1527983425382404096/1753112380/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 2