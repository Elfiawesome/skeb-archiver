！\n\n── ⋅ ⋅ ── ⋅ ⋅ ── ✦ ── ⋅ ⋅ ── ⋅ ⋅ ──\n\n私のキャラクターはダークエルフで、ネメシスの娘です。<3\nホラーや闇が大好きですが、甘くて優しい一面もあります。\n参考画像はこちらです！\n私のVTuberのペット、ファングも自由に使ってくださいね。<3\nhttps://drive.google.com/drive/folders/1n5TvsLBKuyxgJQZIuoUmnK-rhlJUfKU7?usp=sharing\n\n髪は黒で、後ろ髪は濃い緑色に染めています。\n舌も緑色ですが、少し明るい色で、上下の歯には「ヴァンパイアの牙」があります。\nまた、舌にピアスと、左目の下に2つのピアスがあります。\n\n参考画像の中から、描きたい髪型や衣装を自由に選んでください。\n主にSNSやTwitchで使いたいと思っています。<3\n\n \nどうもありがとうございます！！！！\n\nhttps://drive.google.com/drive/folders/1n5TvsLBKuyxgJQZIuoUmnK-rhlJUfKU7?usp=sharing", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@hayo_nelo/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3658018, "client_id": 53759, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/06c1fa1e/uploads/origins/cca04507-ed62-4b60-bcf0-2e95f860903e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ffbeab6c95f6656c1d1425442a4b9d65", "srcset": "https://si.imgix.net/06c1fa1e/uploads/origins/cca04507-ed62-4b60-bcf0-2e95f860903e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ffbeab6c95f6656c1d1425442a4b9d65, https://si.imgix.net/06c1fa1e/uploads/origins/cca04507-ed62-4b60-bcf0-2e95f860903e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=9919af946d4bb4d59e437a4c30bc6d64 2x, https://si.imgix.net/06c1fa1e/uploads/origins/cca04507-ed62-4b60-bcf0-2e95f860903e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=954c272767aedc88f4be052488272b70 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/06c1fa1e/uploads/origins/cca04507-ed62-4b60-bcf0-2e95f860903e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=066a8c308ef0c5f462390b1598f6a51e", "srcset": "https://si.imgix.net/06c1fa1e/uploads/origins/cca04507-ed62-4b60-bcf0-2e95f860903e?bg=%23ff