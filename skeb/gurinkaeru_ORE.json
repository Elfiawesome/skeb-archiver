&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a0635b0d002d8c1a7f15dda91db0f531", "src_set": ""}, "body": "Discordのアイコンを新しくしたいので描いてください\n\n今回は僕の創作からではなく、従来通りマフィアバカモンでお願いします", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@gurinkaeru_ORE/works/26", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2673357, "client_id": 3324565, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/12d8af18/uploads/origins/6cddb3fd-0f60-42be-9ef4-f11e9dcbdcb4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9993b38c0b00d32efd554ab8678af645", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/12d8af18/uploads/origins/6cddb3fd-0f60-42be-9ef4-f11e9dcbdcb4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=010b6f7ab06c3ddf5cad3b08bfe8d5f9", "src_set": ""}, "body": "YouTubeにて投稿している拙作「しのぶ＆タケシで学ぶエルデンリング」のサムネイルイラストをお願い致します。\n「しのぶ」がエルデンリング内に出てくる武器「騎士大剣」をFF2（FC版）のパッケージの様に構えて、「タケシ」がFF3のパッケージの様に黒い炎を出している構図でお願いします。\n背景は透過して頂けるとありがたいです。よろしくお願いします。", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@gurinkaeru_ORE/works/25", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2673357, "client_id": 3228261, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/e9703a09/uploads/origins/6e3127e2-a488-429d-bdd6-b0c12b7597d6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=72abc5952c72df32fad2e7f9a598cca8", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/e9703a09/uploads/origins/6e3127e2-a488-429d-bdd6-b0c12b7597d6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=585dc8fba0e8ff996ffd0d72ed7c5f93", "src_set": ""}, "body": "前回と同じく私の創作から、主人公の伯父ベスニクの絵をお願いします\n\nベスニクは都会・(アルバニアから見て)外国で仕事をすることが多い人なので、民族衣装ではなく普通のスーツかコートを着た姿で描いてください。指定したこと以外はいつものようにお任せします", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@gurinkaeru_ORE/works/24", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2673357, "client_id": 3090461, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/544fc6f9/uploads/origins/e69bb15f-af82-43e8-9b6b-eb44f9ecf57e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1a5c296e713153c681a2541f4d263508", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/544fc6f9/uploads/origins/e69bb15f-af82-43e8-9b6b-eb44f9ecf57e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3a263a39fd51d5367fbe8cad64dd43e9", "src_set": ""}, "body": "前回はとても素敵なうちの子を描いていただきありがとうございました。\nぐりんかえる様の描かれるキャラの表情、マジで好きです。\nそして詰め合わせ依頼という夢の単語をお見かけしたので、早急にリクエスト文をしたためています。\n\nよろしければ、うちの子二人をお好きに描いていただけないでしょうか。\n\n\n■世界観(読み飛ばしてOK)\nこの世界は、十三の世界が不定期に干渉しあうようにして成り立っている。\n感じるが見えず、現れては消え、希望を見せては台無しに。\n世界と世界の周波が重なった際に様々な事象が発生し、数多の問題を引き起こす。\nそれは害意ある魔物の強襲であったり、輝く剣を巡っての闘争であったりと、明確な法則性は存在しない。\n\n元は一つだった世界。争いの果てに星によって分かたれ、独自の発展を遂げた世界。\n異様な世の在り方は永い時とともに風化し、いつしか\"異層十三世界\"と呼ばれるようになった。\n\n舞台である第三世界は、人族、獣人族、精霊族、魔族からなる\"人間種\"が大多数の人口を占め、様々な種族が繁栄している。\n異層世界からの干渉を特に受けやすい世界とされており、人族にのみ発症する\"紋様憑き\"、異層からの魔物や武具や技術といった\"漂流物\"、未だ表面化していない被害を含め、様々な問題が後を絶たない。\n総人口の増加、異層の神や魔物への信仰などが遠因ではないかと言われているが、真実は定かではない。\n\n\n■キャラクター\n以下の資料URLに格納しております。\n火酒の行商人である蛇人と、護衛役の闇妖精の侍のバディです。\nスレイプニルが曳く馬車で第三世界を旅しています。\n\n蛇人⇒闇妖精：能天気な浮雲、護衛役としては信頼、考えて動いてほしい、東酒頼んでる癖に私の酒を飲むなはっ倒すぞ。\n\n闇妖精⇒蛇人：実利を取れない甘ちゃん、自分と違い天賦の才を持つ、青臭いが好ましい、女癖の悪さは直した方がいい。\n\n\n■構図\nぐりんかえる様の解釈と絵柄で描かれる二人の詰め合わせが見たいです。\nお好きに描いていただいて構いません。\n服や小物等々はお好きに省略していただいて大丈夫です。\n(一応NSFWは有効にしています。お気になさらず)\n\n\n金額に不足がありましたら再送依頼をいただけますと幸いです。\n資料が少なく申し訳ないのですが、どうかよろしくお願いいたします……！\n\nhttps://drive.google.com/drive/folders/1l_uw8L4V9T5yhIcdF28LEY3cBH_axFCS?usp=sharing", "nc": 56, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "similar_creators": [{"id": 26259, "creator": true, "nsfw_acceptable": true, "acceptable": false, "name": "イツエ", "screen_name": "itsue_1A", "avatar_url": "https://pbs.twimg.com/profile_images/1671885182901841923/vcpnZe-0.jpg", "header_url": "https://pbs.twimg.com/profile_banners/46047536/1713689879/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "skills": [{"genre": "art"}, {"genre": "correction"}], "nc": 144}, {"id": 227586, "creator": true, "nsfw_acceptable": true, "acceptable": false, "name": "暇うさ", "screen_name": "eOLQZzHnoNShlhQ", "avatar_url": "https://pbs.twimg.com/profile_images/1952771980631101440/l3ulFccd.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1035332985828986881/1754412155/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "skills": [{"genre": "art"}], "nc": 145}, {"id": 1730175, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "さばもり🔞", "screen_name": "sabamori55", "avatar_url": "https://pbs.twimg.com/profile_images/1489276815407341569/gVGWmzJx.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1434379106540392453/1643797462/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "skills": [{"genre": "art"}], "nc": 161}, {"id": 2847063, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "あの🐢", "screen_name": "go_guratan", "avatar_url": "ht