ら来た“伝説”や“神話”、“物語”の存在。\n――だけど今は、ただの同居人として、不思議な日常を過ごしている。\n\n【登場人物】\n■アルシェ(人間/魔術師)\n■伊吹(鬼)\n■藍(龍)\n■セシル(吸血鬼)\n\n\n【使用用途】\n・個人鑑賞\n\n【その他】\n・形式に指定はありません。\n・服装は自由です。衣装は腰から下の資料がないため自由に描いていただいたり、細かな部分は簡略化しても大丈夫です。\n\n\n最後までお読みいただきありがとうございました。金額や内容に問題がありましたら再送要請、またはキャンセルをお願い致します。\nお手数おかけしますがご検討のほど、よろしくお願いします。\n\nhttps://drive.google.com/drive/folders/1qE-2ok4j_6j0StnwFkb7rFCBFk9HZByL", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@gurinkaeru_ORE/works/51", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/d0f82fc3/uploads/origins/67b8a3e9-4ed0-40be-9de4-106c45cd7b1c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=0562a52b8df31d6ba13289319b817c1b", "src_set": ""}, "private": true, "genre": "art", "tipped": true, "creator_id": 2673357, "client_id": 0, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 177, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@gurinkaeru_ORE/works/50", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/7c51fb7b/uploads/origins/dfda484d-8a90-4e70-8e84-0e4282b186ce?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=3f88cf0d240e216cdb19a81855cadc59", "src_set": ""}, "private": true, "genre": "art", "tipped": true, "creator_id": 2673357, "client_id": 0, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 128, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@gurinkaeru_ORE/works/49", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false,