た対象に幻覚を見せる異能力を持っている\n・無口、冷徹\n・ハーフの黒人、半分日本人\n\nキャラ設定-外見\n・男性\n・25歳\n・173cm\n・無表情\n・褐色肌、青目、白銀髪にオレンジのインナーカラー\n・イメージカラー、オレンジ\n・モチーフは人形\n\nお時間あって筆が進む時で構わないのでもしよろしければ描いてもらえればと思います。\n長々と失礼しました、スケブでの依頼は慣れておらず色々と不手際がありましたらすみません。\nどうぞよろしくお願いいたします！\n\nhttps://drive.google.com/file/d/1Mv_OLvKWJP6BWfnlAPP-UDHOoVkHFhYr/view?usp=sharing", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@lunchboxGorilla/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2365008, "client_id": 965905, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/b6ed1304/uploads/origins/42c023bb-930d-487c-9037-7f48632f0eab?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=cd9cd3b4c1d16ad761c40e7ba39dced4", "srcset": "https://si.imgix.net/b6ed1304/uploads/origins/42c023bb-930d-487c-9037-7f48632f0eab?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=cd9cd3b4c1d16ad761c40e7ba39dced4, https://si.imgix.net/b6ed1304/uploads/origins/42c023bb-930d-487c-9037-7f48632f0eab?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e04d1def88e0734fd9c9e660e6a48a1b 2x, https://si.imgix.net/b6ed1304/uploads/origins/42c023bb-930d-487c-9037-7f48632f0eab?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=7db5e6b510361759e278355989581170 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/b6ed1304/uploads/origins/42c023bb-930d-487c-9037-7f48632f0eab?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a3287accb5b8cbf30ba52be1b0290296", "srcset": "https://si.imgix.net/b6ed1304/uploads/origins/42c023bb-930d-487c-9037-7f48632f0eab?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a3287accb5b8cbf30ba52be1b0290296, https://si.imgix.net/b6ed1304/uploads/origins/42c023bb-930d-487c-90