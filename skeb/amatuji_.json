txt=PRIVATE&s=ec03c36b56fb1338ae082f53e1055dc6", "src_set": ""}, "private": true, "genre": "art", "tipped": false, "creator_id": 484710, "client_id": 976781, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 33, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@amatuji_/works/100", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 484710, "client_id": 227230, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/1a30dece/uploads/origins/7420baaf-8e91-4f02-ae09-a60f18f1d29b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1c9520b0a2e2d8285bb354506110f206", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/1a30dece/uploads/origins/7420baaf-8e91-4f02-ae09-a60f18f1d29b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0c120002974c8cb7c4adca09963368e5", "src_set": ""}, "body": "はじめまして。お世話になります。\n\n艦これの榛名をリクエストさせてください\n服装は下記資料のもので、背後の装備は省略してキャラ単体でお願いします。\nhttps://drive.google.com/file/d/1Ipe5x4anQ1Vdy5LvBS42F9Wg1YyKk-cZ/view?usp=drive_link\n構図・ポージングなどの詳細はお任せします\n\n恐れ入りますが、何卒ご検討のほどよろしくお願いします。", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@amatuji_/works/99", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 484710, "client_id": 0, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/c9bd5ee5/uploads/origins/136bf455-4f74-4162-a5c7-e4d5a31486fb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5858f77cc906a37ba58b92c79bdbdde8", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/c9bd5ee5/uploads/origins/136bf455-4f74-4162-a5c7-e4d5a31486fb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=351db990bf9a1cd6902bb7d4ba8ddd3d", "src_set": ""}, "body": "キュートなイラストを拝見してから再開をお待ちしておりました。\n\n画像資料のオリジナルキャラクター（OC）をリクエストします。\n納品された作品は個人観賞以外に、Skebサンプルと同サイズ（横800ピクセル）に縮小した上で\nコミッション依頼時の画像資料使用、SNS（Discord等）でのOC紹介に使わせて頂く場合があります。\nもしクリエイター名記載が必須であれば、レイヤー分けせずにあまつじさんのサインを入れて下さい。\nこの内容をご了承いただけない場合はキャンセルでお願いします。\n\nhttps://www.pixiv.net/artworks/116943240\nhttps://www.pixiv.net/artworks/112638241\nhttps://www.pixiv.net/artworks/121308270\nこれらのイラストの様な、キャラクターの魅力溢れる立ち姿イラストをお願いします。\nシチュエーション候補は、屈託なく想い人に笑顔を向けている（キュート）、凛々しく魔術を発動（クール）のどちらかで。\nポーズ等はお任せします。\n\n金額等問題がありましたら条件付きリクエスト再送要請で対応お願いします。\nご検討宜しくお願い致します。\n\nhttps://drive.google.com/drive/folders/1_daKF9C8m11LRlnAQ2M2JX32suKYuy1T", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@amatuji_/works/98", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 484710, "client_id": 335678, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/b065e277/uploads/origins/6776ddf1-eb34-41ce-b7c6-46f623dcd90f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=20c2a36cc4c1a9a40d753d49705cd2f3", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/b065e277/uploads/origins/6776ddf1-eb34-41ce-b7c6-46f623dcd90f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=614d3e5bd80ccd0a3570137e7b7a37ef", "src_set": ""}, "body": "お疲れ様です。\n前回は素敵なうちのコ(褐色ミコッテ)を描いていただきありがとうございました。\n今回の再オープンを機に、リクエストさせてください。\n前回依頼とガラリと変わってしまいますが、「Fate/kaleid liner プリズマ☆イリヤ」より\nイリヤスフィールをお願いします。\n\n■キャラ衣装\n水着(ビキニ)でお願いします。\n鼠径部が見えるローライズな水着で、カラーやデザインはお任せします。\nもちろん既存のものでもOKです。イリヤ水着で検索すると可愛い水着姿がたくさん出てきます。\n\n■内容\n水着の紐を外して見せようとしてくる、ちょっとエッッな感じのイリヤちゃん見たいです。\nNSFWはONにしておきます。エッッ度合いはお任せしますｗ\n他、表情や背景等もお任せします。\n可能であれば表情差分をお願いいたします。\n\nなお、デスクトップにして眺めていたいので、横描きにしていただければ嬉しいです。\n\n以上です。\nご検討よろしくお願いいたします。", "nc": 48, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@amatuji_/works/97", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/154bb687/uploads/origins/5dec96cb-abc1-40ed-8486-818355ebedf6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=b31e0dfb2c411638e360ce2ff1204d66", "src_set": ""}, "private": true, "genre": "art", "tipped": false, "creator_id": 484710, "client_id": 2763225, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 32, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@amatuji_/works/96", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 484710, "client_id": 628644, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/f6d16a95/uploads/origins/58db9367-7927-4a44-a438-2c1db6fc0591?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=dfea71fb98626066d3329ca0fd0fcbac", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/f6d16a95/uploads/origins/58db9367-7927-4a44-a438-2c1db6fc0591?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b4de8b0c91c12ba2d650892e4e923cf4", "src_set": ""}, "body": "こんばんは、以前ハミダシクリエイティブの鎌倉詩桜のイラストを依頼させていただいた者です。\nその折は美麗なイラスト本当にありがとうございました！　今でも定期的に眺め、目の保養にさせていただいております。\n\n先日あまつじ先生の過去のイラストを拝見していたところ、下記リンク先(1)のフェチポイントが詰まったイラストがツボに入ってしまったので、今回はディアちゃんのフェチ向け（とくに足フェチ）イラストを依頼したいと思います。\n(1) https://www.pixiv.net/artworks/87745692\n\n・服装\nニーソを着用した服装であれば何でも構いません。\nそれ以外のディティールは一任いたします。\n\n・構図\n下記リンク先(2)のように、ヒロインが太ももを押さえて両足裏をこちらに見せつけるようなポーズをお願いします。\n(2) https://drive.google.com/file/d/19QocwM1S8q7VRV2rgJ2IamgZICnONy5S/view?usp=sharing\nなお、リンク先(2)の参考画像では精液描写がありますが、今回のリクエストでは不要です。\n\n・差分\n以下に挙げる健全版と成年版の2パターンをお願いできればと思います。\nこの値段では難しいということでしたら、再送依頼をお願いできれば幸いです。\n①：健全版\n　・服装にはだけている箇所はなく、ニーソ足裏をこちらに見せているイメージ\n　・表情はこちらをぼーっと見つめている（無表情に近い）感じ\n②：成年版\n　・下記リンク先(3)ぐらいはだけている（胸部はほとんど露出されている）イメージ\n　　(3) https://www.pixiv.net/artworks/100084705\n　・ニーソは完全に脱げていて、素足となった足裏がリンク先(2)のように見えている\n　・ディアちゃんの近くにニーソの他、①で着ていた衣装が近くに脱ぎ散らかされている感じ\n　・表情は上記リンク先(3)のような、ハート目かつ恍惚とした感じ\n　\n・背景\nベッドの上（屋内）でお願いします。時間帯はお任せします。\n\n・解像度/サイズ\nポスターに印刷して個人観賞用として飾ることを想定しておりますので、\n可能であれば、B2サイズの印刷に耐えうる解像度/サイズでお願いできればと思います。\n\n・その他\n前回と同じようにpsdファイルも可能であればお願いします。\n\n以上、よろしくお願いいたします。", "nc": 168, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@amatuji_/works/95", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 484710, "client_id": 0, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/5266eb28/uploads/origins/25dcacfd-6625-4c60-8cf2-543a91aa181f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d18cf9d0f4b6cc4b22c6092dae598229", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/5266eb28/uploads/origins/25dcacfd-6625-4c60-8cf2-543a91aa181f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a8c3eab3c32d95cdda62600f209af844", "src_set": ""}, "body": "以前、超昂閃忍の鷹守ハルカを依頼した者です。素敵な絵をありがとうございました。\n\n忍衣装が素晴らしかったので、夏川詠でイラストを依頼してもいいでしょうか？\n構図などはお任せします。", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@amatuji_/works/94", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 484710, "client_id": 2859918, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/5748f022/uploads/origins/bb3e5f7e-8cc7-4fb3-87e1-e461dd6f3901?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c94f280dcb3d36f3464bd699ee607b4f", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/5748f022/uploads/origins/bb3e5f7e-8cc7-4fb3-87e1-e461dd6f3901?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=383fdf6e475992c36f88b2842ae833c1", "src_set": ""}, "body": "前回はありがとうございました！\nVtuberさんのファンアートです\nよろしくお願いします。\n\n依頼内容\nプリキュアっぽい衣装を着ている甘姉ミナさんのイラスト\nサムネなどに使いやすいように頭から足先髪の毛もある全身のイラストをお願いします。\n\nキャラクター\n甘姉ミナ @AmaneMina_maha5\n3面図 https://twitter.com/AmaneMina_maha5/status/1693567016714850727?t=WVnO4f-nvhnutn6lYeMSFA&s=19\n\n衣装\n前回とは違うプリキュア衣装\n肩に乗ってる柴犬と融合したみたいなイメージでお願いします\n具体的には\n肩に乗ってる柴犬のケモミミカチューシャと大きめの肉球手袋と肉球の靴と大きいしっぽ(タマモキャットのイメージ)\n柴犬の毛量を出すために厚手に着込んだ衣装\n(スカートの下のフリルをモコモコにするなど)\n色合いも柴犬の茶色や首に巻いてるスカーフなどを参考にお願いします\n\nその他\n甘姉ミナさんご本人の配信活動での使用許可\n（例、サムネやTwitterへの投稿など）\nまた甘姉ミナさんだけの透過pngなども頂ける\nと嬉しいです\n\nよろしくお願いします", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@amatuji_/works/93", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/1eb9fa07/uploads/origins/4c447bfd-b3d7-4678-94b8-77f6f7c605c6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=fad7e17e667c353157c78d3c4752358a", "src_set": ""}, "private": true, "genre": "art", "tipped": true, "creator_id": 484710, "client_id": 628644, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 160, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@amatuji_/works/92", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 484710, "client_id": 1209, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/