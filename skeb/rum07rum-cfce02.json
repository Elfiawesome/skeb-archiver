c7-e5cf-4984-8cf7-f62d63804901?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=39d5c18ee1e79edf9ef56af579bb2e1e", "srcset": "https://si.imgix.net/9cd964a8/uploads/origins/3fe64fc7-e5cf-4984-8cf7-f62d63804901?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=39d5c18ee1e79edf9ef56af579bb2e1e, https://si.imgix.net/9cd964a8/uploads/origins/3fe64fc7-e5cf-4984-8cf7-f62d63804901?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=8016a619918d95b243ad03326dd843db 2x, https://si.imgix.net/9cd964a8/uploads/origins/3fe64fc7-e5cf-4984-8cf7-f62d63804901?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=944f853d2d4aa31311ee2f9586142deb 3x"}, "body": "𝗝𝗔𝗠🍓🫐先生、前回は素晴らしいイラストをありがとうございました！\n納品していただいたイラストが大変嬉しく、また大変今更ながら先生のXを拝見しまして、是非先生の等身イラストでもキャラクター達を見てみたいと思い、再度ご依頼させて頂きたくリクエストを送らせていただきます。\n今回もまた、友人達とのTRPGキャラクター(FBI捜査官の1チームです)のイラストを描いてもらいたいです。\n可能であれば一枚絵でお願いしたいです。\n\n【キャラ設定】\n▶HO1　\nフィンリー・ハワード\nFinley Howard\n男/31歳/177cm\n目：赤、髪：茶\nリーダー。\n深い情愛を理性で律し、仲間の日常と対象の尊厳を守るため、時には大胆すら動く勇気のある人間。　\n\n▶HO2　\nリゼット・ミラー\nLizette＝Miller　\n女/27歳/160㎝\n髪：赤茶\n内面、外面共に魅力的な女性。明るくて真面目な性格。面の皮は厚い。\nフットワークは軽い、時々型破りな行動をする。\n\n▶HO3　\nシグ サイト シェパード\nCeeg Cyght Cshepherd\n男/27歳/159cm\n目：アップルグリーンの目、髪：アッシュブラウン\nハッカー。\n素っ気なく、クールそうに見えて実は世話焼き。\n歳のわりに幼く見える。\n\n▶HO4\nオーリー・ライト\nOllie Right\n男/22歳/187㎝\n目：スカイブルー、髪：ブルネット/バターブロンド\nFBI捜査官の新人。\n人懐っこく素直な犬系新人後輩。明るく真っ直ぐ、声も大きい。超のつく美形。真顔も多いが表情豊か。\n\n▶HO5　\nバーニス・ベイカー\n女/26歳/176㎝\n\nFBI捜査官で渉外担当。\n見た目はギャルだが、警察になれるていどにはちゃんと真面目。\n\n▶HO6　\nIris･Cumulus(アイリス･キュムラス)\n女/25歳/170cm\n目：薄紫→ピンクのグラデ、髪：白(後ろ髪毛先薄紫)\nほわほわとした緩やかな雰囲気、ゆっくりマイペース。純粋で他者を信じやすい。\n表情変化が貧しくおとなしめ、無口。\n\n\n【使用用途】\n個人観賞用、自身のSNSに掲載、TRPG内で使用\n\n構図やポーズ、そのほか全て先生の解釈にお任せできればと思います。\n不備や金額が合わない場合、お手数をおかけしますが再送をお願いいたします。\nよろしくお願いいたします！\n\nhttps://drive.google.com/drive/folders/1pUZBDDh-Pli7rljNZaZzWu1y-Qvbn-tn?usp=drive_link", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre