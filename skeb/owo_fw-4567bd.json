fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=1272122e9318eb4ffafa542a618dcd04 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/72e625ff/uploads/origins/d31e30d1-1673-4fd5-b53e-b8155bc5658e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=4ff1a7199b10c48df57880d395b50674", "srcset": "https://si.imgix.net/72e625ff/uploads/origins/d31e30d1-1673-4fd5-b53e-b8155bc5658e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=4ff1a7199b10c48df57880d395b50674, https://si.imgix.net/72e625ff/uploads/origins/d31e30d1-1673-4fd5-b53e-b8155bc5658e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=403fb28e68273476506452d0c059a042 2x, https://si.imgix.net/72e625ff/uploads/origins/d31e30d1-1673-4fd5-b53e-b8155bc5658e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=f0c6f69dbacbd2dabe9ca396dacbe722 3x"}, "body": "みやゐ 様、はじめまして。\nyoutubeでVtuber活動をしている　宝絡くるる（takara kururu）と申します。\nみやゐ先生の描かれているイラストがとても素敵で可愛らしく、ぜひ宝絡くるるのイラストを描いていただきたいと思いリクエストさせていただきました。\n\n\n【使用目的】 \n・動画配信サービスやSNSでのサムネイル使用や画面配置(将来的に収益化する可能性があります)\n\n【キャラクター像】\n・喫茶店で働く100cmの球体関節ドール\n・楽しいこと、おしゃべりが好き\n\n【チャームポイント】\n・球体関節\n・巻き髪\n\n【参考資料】\nhttps://drive.google.com/file/d/1ftUIxXXLqc0a-vL-5uOHqURDfKITZPTK/view?usp=sharing\n\n正面の立ち絵1枚となります。\n球体関節：手首、足首のみ気を付けていただければ、他はお洋服で隠れています。\n\n【イラスト詳細】  \n喫茶店の休憩中に、チョコレートケーキを頬張っている様子を第三者に見られてきょとんとしている様子。（小さい体で一生懸命食べてかわいい…と思われているが、本人はなんでまじまじと見られているかわからない）\n口の端にケーキの一部がついているとうれしいです。\n\nみやゐ先生のイラストがとても好きなので、イラスト詳細を記載させていただきましたが、構図・シチュエーションは、資料からイメージしていただいたおまかせでも大丈夫です。その際、みやゐ先生の描く瞳が好きなので、目が開いていると嬉しいです。\n\n【その他】\n可能でございましたら、人物だけのPNGデータまたはPSDデータもいただけると幸いです。\nまた頭部や髪など上部左右が見切れていないイラストにしていただけますと大変助かります。\n\nここまでお見通しくださりありがとうございました。\nご検討のほど、何卒よろしくお願いいたします。\n【X】 https://x.com/takara_9ruru\n【YouTube】https://www.youtube.com/channel/UCodQvFgstcx77ZZK9KOD21Q\n\nhttps://drive.google.com/file/d/1ftUIxXXLqc0a-vL-5uOHqURDfKITZPTK/view?usp=sharing", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@owo_fw/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3955333, "client_id": 3945739, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/7d9d49f6/uploads/origins/d2cadf53-3cfa-42fa-a92b-8ae1ca2d50aa?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c1f5a8e9e2d42a7ae3588dc377eb5224", "srcset": "https://si.imgix.net/7d9d49f6/uploads/origins/d2cadf53-3cfa-42fa-a92b-8ae1ca2d50aa?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c1f5a8e9e2d42a7ae3588dc377eb5224, https://si.imgix.net/7d9d49f6/uploads/origins/d2cadf53-3cfa-42fa-a92b-8ae1ca2d50aa?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f88464dc5961647bfbb57a1da458514f 2x, https://si.imgix.net/7d9d49f6/uploads/origins/d2cadf53-3cfa-42fa-a92b-8ae1ca2d50aa?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=2f617096045dfc8d52eb00485db146af 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/7d9d49f6/uploads/origins/d2cadf53-3cfa-42fa-a92b-8ae1ca2d50aa?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b2d84e1c0a562f1fe4c61c1b82813a09", "srcset": "https://si.imgix.net/7d9d49f6/uploads/origins/d2cadf53-3cfa-42fa-a92b-8ae1ca2d50aa?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b2d84e1c0a562f1fe4c61c1b82813a09, https://si.imgix.net/7d9d49f6/uploads/origins/d2cadf53-3cfa-42fa-a92b-8ae1ca2d50aa?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=f4a58dddcf6caea1d783fd6fb445e580 2x, https://si.imgix.net/7d9d49f6/uploads/origins/d2cadf53-3cfa-42fa-a92b-8ae1ca2d50aa?bg=%23fff&auto=format%2Ccompress&fm=webp&d