\u5712\u5150\u306e\u59b9\u304c\u3044\u308b\u3001\u6e29\u539a\u306a\u9577\u5973\u3067\u3059\u3002\n\u273d\u5916\u898b\n\u982d\u9aea\uff1a\u8276\u3084\u304b\u306a\u6f06\u9ed2(RGB:000)\u306e\u9aea\u8272\u3002\u7709\u3092\u96a0\u3059\u524d\u9aea\u3068\u3001\u8170\u307e\u3067\u4f38\u3073\u305f\u5f8c\u308d\u9aea\u306f\u4e21\u65b9\u300c\u3071\u3063\u3064\u3093\u300d\u306e\u6bdb\u5148\u3002\u4e21\u8033\u306e\u524d\u306f\u982c\u306e\u300c\u59eb\u30ab\u30c3\u30c8\u300d\u3068\u306f\u5225\u9014\u3001\u80f8\u307e\u3067\u5782\u3089\u3057\u305f\u9aea\u675f\u3082\u3042\u308a\u307e\u3059\u3002\n\u8eab\u4f53\uff1a\u3084\u3084\u5782\u308c\u76ee\u3001\u77b3\u306f\u6df1\u3044\u7d3a\u8272\u3002\u8eab\u9577160cm\u3001\u30d0\u30b9\u30c879cm(B\u30ab\u30c3\u30d7)\u3002\u30b9\u30e9\u30ea\u3068\u3057\u305f\u7d30\u8eab\u3067\u3001\u80f8\u3082\u5c0f\u3076\u308a\u30fb\u63a7\u3048\u3081\u3067\u3059(\u30da\u30c3\u30bf\u30f3\u30b3\u3067\u306f\u3054\u3056\u3044\u307e\u305b\u3093)\u3002\u808c\u306f\u8272\u767d\u3002\nhttps://www.pixiv.net/artworks/108339287\n\u2191\u7d75\u5e2b\u69d8\u5fa1\u4f5c\u54c1\u306e\u5185\u3001\u4e0a\u306e\u307a\u3053\u5b22\u304f\u3089\u3044\u306e\u80f8\u30b5\u30a4\u30ba\u3067\u3054\u63cf\u5199\u3044\u305f\u3060\u3051\u307e\u3059\u3068\u5e78\u3044\u3067\u3059\u3002\n\u273d\u670d\u88c5\n\u30b9\u30af\u30fc\u30eb\u6c34\u7740(\u65b0\u30b9\u30af)\u3042\u308b\u3044\u306f\u7af6\u6cf3\u6c34\u7740\u3092\u5e0c\u671b\u3057\u307e\u3059\u3002\u3069\u3061\u3089\u306e\u30bf\u30a4\u30d7\u3082\u3001\u4e0b\u534a\u8eab\u304c\u811a\u3050\u308a\u3067\u30ab\u30c3\u30c8\u3055\u308c\u3066\u3044\u308b\u30bf\u30a4\u30d7\u3092(\u3042\u307e\u308a\u30cf\u30a4\u30ec\u30b0\u306b\u306a\u3089\u306a\u3044\u7a0b\u5ea6\u3067\u2026)\u304a\u9858\u3044\u3057\u307e\u3059\u3002\u306a\u304a\u3001\u80f8\u306b\u30bc\u30c3\u30b1\u30f3\u306f\u4ed8\u3044\u3066\u3044\u307e\u305b\u3093\u3002\u30ab\u30e9\u30fc\u30ea\u30f3\u30b0\u306f\u3044\u305a\u308c\u3082\u7d3a\u8272\u30e1\u30a4\u30f3\u3002\n\u7dbe\u9999\u306e\u53f3\u624b(\u