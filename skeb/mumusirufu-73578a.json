ody": "こんにちは！お元気でお過ごしでしょうか\nやっとイラストの依頼を受け付けてくれるようになったんですね！前々から欲しいと思っていたので、嬉しいです。特に、デフォルメのイラストがとても好きです。東方デフォルメのイラストをお願いします。 キャラクターは鈴仙・優曇華院・イナバと純狐です。\n特に、あなたのこのイラストがとても気に入りました: \nhttps://www.pixiv.net/artworks/85015564\nできれば、鈴仙と純狐のラブラブなポーズをかわいく描いてください。二人の口は、あなたの過去に描いたデフォルメイラストの口と同じように、猫口で描くとよいでしょう。\n\nありがとうございました!  私の要望をご考慮いただければ幸いです!", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@mumusirufu/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2590849, "client_id": 168315, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/8da374b7/uploads/origins/f8cd651d-7875-4313-853d-b82867f94634?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a2f913e02082487e427973cfa59e9233", "srcset": "https://si.imgix.net/8da374b7/uploads/origins/f8cd651d-7875-4313-853d-b82867f94634?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a2f913e02082487e427973cfa59e9233, https://si.imgix.net/8da374b7/uploads/origins/f8cd651d-7875-4313-853d-b82867f94634?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e9b8f38f42d2e0319cc2879177667eda 2x, https://si.imgix.net/8da374b7/uploads/origins/f8cd651d-7875-4313-853d-b82867f94634?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=9fceb15030415f0f80149e5c65e66c82 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/8da374b7/uploads/origins/f8cd651d-7875-4313-853d-b82867f94634?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f381e8c0fdb0e1e9f83b0534b7a035c7", "srcset": "https://si.imgix.net/8da374b7/uploads/origins/f8cd651d-7875-4313-853d-b82867f94634?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f381e8c0fdb0e1e9f83b0534b7a035c7, https://si.imgix.net/8da374b7/uploads/origins/f8cd651d-7875-4