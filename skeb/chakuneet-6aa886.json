ーのネオン＝ノストラードが団長に能力を奪われた後、トチ狂った父親によって他マフィアに売られ、肉便器として死ぬまでマワされるというシチュのイラストを描いていただけないでしょうか\n最初は「パパ助けて！」と叫びながらも父親から罵倒されてマフィア達に犯されており、死んだ後（相変わらずマフィア達に犯されている）になって取り乱した父親に謝られてる感じです。父親はセリフだけ描いていただければいいです\nカラーリングは旧アニメ版（髪がピンクの方）でお願いします", "nc": 170, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@chakuneet/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 438606, "client_id": 12731, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/e1f9a97d/uploads/origins/d99f79f5-4abd-4b92-b6cd-aa29bd84d103?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=41191caf81fbd1a3d73dc5da33f41fb4", "srcset": "https://si.imgix.net/e1f9a97d/uploads/origins/d99f79f5-4abd-4b92-b6cd-aa29bd84d103?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=41191caf81fbd1a3d73dc5da33f41fb4, https://si.imgix.net/e1f9a97d/uploads/origins/d99f79f5-4abd-4b92-b6cd-aa29bd84d103?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=24efc3c3cb759e10538c75e120708899 2x, https://si.imgix.net/e1f9a97d/uploads/origins/d99f79f5-4abd-4b92-b6cd-aa29bd84d103?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=5b4fa20a0414280b752ed5ba23a84c28 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/e1f9a97d/uploads/origins/d99f79f5-4abd-4b92-b6cd-aa29bd84d103?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=cdbac00d51f611fc52feac96a94b76e9", "srcset": "https://si.imgix.net/e1f9a97d/uploads/origins/d99f79f5-4abd-4b92-b6cd-aa29bd84d103?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=cdbac00d51f611fc52feac96a94b76e9, https://si.imgix.net/e1f9a97d/uploads/origins/d99f79f5-4abd-4b92-b6cd-aa29bd84d103?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=013