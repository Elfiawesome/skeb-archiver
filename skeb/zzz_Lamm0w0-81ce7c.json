w=200&h=200&blur=200&s=f1ff3adcaa214240b2d76b5db53aecbb, https://si.imgix.net/504b5b66/uploads/origins/5a374666-94e9-4b63-bfe8-8a62ceb63f67?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=b3b4e3a0c9cbaacf8d149e7897ec91fb 2x, https://si.imgix.net/504b5b66/uploads/origins/5a374666-94e9-4b63-bfe8-8a62ceb63f67?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=090a815efb557289615e73d587d2f553 3x"}, "body": "先生、こんにちは。\nいつも素晴らしい作品を拝見し、どの一枚もとても美しいと感じております。\n大変恐れ入りますが、私のオリジナルキャラクターのイラストを一枚、お描きいただけないでしょうか。\nお好きなほうの衣装デザインをお選びいただいて構いません。\n\nキャラクター名：温梣（Windsrim）\n· 軍装バージョン：17歳\n· クトゥルフ系礼服バージョン：20歳\n  種族：異形の存在と融合した人間\n\n外見の特徴：\n· 髪は黒色。M字前髪。\n· 瞳は赤く、赤いアイシャドウを施している。\n· 左目の目頭に泣きぼくろがある。\n· 左手は包帯で完全に巻かれ、右手は手袋を着用。\n· 首に「0922」の刻印／番号がある。\n関連モチーフ／要素：\n戦闘 / 屍骸 / 十字架 / カラス / 白鳩 / 猫 / ポピー（ケシの花） / 死 / 眼球 / 蛇\n\n人物設定（世界観含む）：\n· 本作は西洋ファンタジーとクトゥルフ神話的要素が融合した世界観です。\n· 温梣は表向きは明るく朗らかな少年で、人に警戒心を抱かせず、自然と油断させてしまう雰囲気を持っています。\n· しかしその裏では、冷淡で人間離れした陰湿な性格であり、狂気を秘めた人物でもあります。\n· 基本的な言動は非常に礼儀正しく節度をわきまえていますが、正気を失い発狂した際にはその異質な側面が露わになります。\n\nご一読いただき、誠にありがとうございます。\nもし機会がございましたら、ぜひ先生に描いていただけますと幸いです。\nhttps://drive.google.com/drive/folders/1aiYbL9sxpyqhtVlc67FmrnzSQfjaLnCH\n\nhttps://drive.google.com/drive/folders/1qNBGV-o-T5qFbBmJphu3aSKeeiilGbhq", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@zzz_Lamm0w0/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3885340, "client_id": 3200465, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/8e87f99b/uploads/origins/84fe11ae-a280-4ec1-b1b0-0ce3acd02b81?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0c025d6efe9762e4fa1ee497f4110c50", "srcset": "https://si.imgix.net/8e87f99b/uploads/origins/84fe11ae-a280-4ec1-b1b0-0ce3acd02b81?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0c025d6efe9762e4fa1ee497f4110c50, ht