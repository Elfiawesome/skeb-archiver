紙、他の依頼の参考や部屋の飾り物など、個人の範囲で大切に使用させていただきます。もし可能であれば 1つのレイヤーに先生のサインを入れていただき、レイヤーを分離したPSDファイルで納品していただけますと助かります。\n可能な範囲で、いくつか表情差分もお描きいただけますと幸いです。\nもし都合が良ければ、完成品の前に採用・不採用に関わらず下書きを残してもらえないでしょうか？OCのイメージの進化について、他の人の視点にとても興味があります。無理ならこのラインは無視しても全然OKです。\nご検討のほど、よろしくお願いいたします。\nhttps://www.dropbox.com/scl/fo/0p1l39q36emmi75dfuh2c/AKdLEhOejb_764OpxEXim7A?rlkey=y6hyyvfx6hdwswtd9zizhkycm&st=nzvvf3z9&dl=0\n\nhttps://www.dropbox.com/scl/fo/0p1l39q36emmi75dfuh2c/AKdLEhOejb_764OpxEXim7A?rlkey=y6hyyvfx6hdwswtd9zizhkycm&st=nzvvf3z9&dl=0", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@zzz_Lamm0w0/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3885340, "client_id": 3518643, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/3c827767/uploads/origins/213665c2-ff42-4c87-9800-4ec7403e5e51?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5d1f28cf1a3400c52054020971c2f67f", "srcset": "https://si.imgix.net/3c827767/uploads/origins/213665c2-ff42-4c87-9800-4ec7403e5e51?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5d1f28cf1a3400c52054020971c2f67f, https://si.imgix.net/3c827767/uploads/origins/213665c2-ff42-4c87-9800-4ec7403e5e51?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=720d22ea9035780aca99c967de2710c9 2x, https://si.imgix.net/3c827767/uploads/origins/213665c2-ff42-4c87-9800-4ec7403e5e51?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c5a2f418b0d0f53218fa8f17b6868900 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/3c827767/uploads/origins/213665c2-ff42-4c87-9800-4ec7403e5e51?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=63fa31d70e920689f0cd0944fda892ee", "srcset": "https://si.imgix.net/3c827767/uploads/origins/213665c2-ff42-4c87-9800-4e