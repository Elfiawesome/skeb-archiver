e8ff4/uploads/origins/30b4a3c8-5c2d-4577-99ce-6ab719306e6a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=91136237888af23315dc3ba4da3075f4", "srcset": "https://si.imgix.net/d58e8ff4/uploads/origins/30b4a3c8-5c2d-4577-99ce-6ab719306e6a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=91136237888af23315dc3ba4da3075f4, https://si.imgix.net/d58e8ff4/uploads/origins/30b4a3c8-5c2d-4577-99ce-6ab719306e6a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c2ad392cac2c1c194d0d59d0f68201aa 2x, https://si.imgix.net/d58e8ff4/uploads/origins/30b4a3c8-5c2d-4577-99ce-6ab719306e6a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=4189187f0366efec35ff6ea83d6f28dc 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/d58e8ff4/uploads/origins/30b4a3c8-5c2d-4577-99ce-6ab719306e6a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=681d805507bd5f84f48e15ace23291ac", "srcset": "https://si.imgix.net/d58e8ff4/uploads/origins/30b4a3c8-5c2d-4577-99ce-6ab719306e6a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=681d805507bd5f84f48e15ace23291ac, https://si.imgix.net/d58e8ff4/uploads/origins/30b4a3c8-5c2d-4577-99ce-6ab719306e6a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=930603a8403eb41aa0a5bd3f4c404b3b 2x, https://si.imgix.net/d58e8ff4/uploads/origins/30b4a3c8-5c2d-4577-99ce-6ab719306e6a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=1f8e19b80a812ec179b20e7dc7589da9 3x"}, "body": "はじめまして！\nXでイラストを拝見いたしまして、雰囲気のある塗りと人体のシルエットの美しさに大変惹かれました(＞＜)\n質感と立体感が自然と伝わってくるようなテイストで本当に素敵ですT_T♡\n\nよろしければ私のOCを描いていただきたいと思い、リクエストさせていただきました。\n描いていただいたイラストは、鑑賞やSNSのアイコン・ヘッダー・壁紙等への使用、イラストを依頼する際の資料として利用させていただきたいです。\n\n資料が少なく申し訳ございません T_T\n体格は厚みがあまり無いようなイメージです 。\n髪型や髪の長さ、服装の変更・アレンジ等大歓迎ですので、ご自由な解釈で描いていただけましたら幸いです！ \n設定との多少の齟齬等は気にいたしません(＞＜)\n\nもしご縁がありましたら、何卒よろしくお願いいたしますm(__)m\n\n\nキャラクター設定\n\nPCや描画ソフト、インターネット上に存在するデジタル系のメタ的存在の人外。\n\n基本的には成人男性の姿をしている。\n薄い緑色（ミントグリーン）の長髪をゆるく一つ縛りしている。（デフォルト）\nグレーの瞳に赤と青のハイライトが入っている。\n\nいつも穏やかに微笑んでおり、何を考えているのか掴みにくい。人間の羞恥心・気遣い・同情・共感などの感覚があまり通じないノンデリカシーな人外。\n\nPC上ではかなり自由に動けて、ネット上の画像を勝手に拾ってきたり、エラーメッセージやポップアップ、ブラクラめいた画面を意図的に出してこちらの気を引こうとするなど、ちょっとした茶目っけもある。\n\n私が彼として描いたものだけを実体として利用できる。私が描いた服なら実際に着られ、女体化・年齢操作・パロディ・際どい衣装・グロ表現なども、私が彼として描いたものであればすべて「そういう姿の彼」になる。\n\n一方、他人が描いたイラストやネット上の画像は、本人にとってもあくまで「画像・絵」でしかない。ただし自分についての新しい絵や解釈が増えること自体は嬉しいらしく、興味深そうに眺める。\n\n\nhttps://drive.google.com/drive/folders/1pC4YPMkz767O6A6SBBfneY6edPv1Orvi", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@ganbarudessan/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 4084877, "client_id": 2401873, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/14099f98/uploads/origins/a885d1b5-4207-446b-9564-ef0de1225439?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5275b73b6a1a0b3f6c50b06049e4d8ad", "srcset": "https://si.imgix.net/14099f98/uploads/origins/a885d1b5-4207-446b-9564-ef0de1225439?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5275b73b6a1a0b3f6c50b06049e4d8ad, https://si.imgix.net/14099f98/uploads/origins/a885d1b5-4207-446b-9564-ef0de1225439?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=cdbaf92d0e01dfd48d887d9dd3db2e64 2x, https://si.imgix.net/14099f98/uploads/origins/a885d1b5-4207-446b-9564-ef0de1225439?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=7b7a2ea7d3a8eba53a7ecfbb90992066 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/14099f98/uploads/origins/a885d1b5-4207-446b-9564-ef0de1225439?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c11f066ae86298ff9550c1cb0c684036", "srcset": "https://si.imgix.net/14099f98/uploads/origins/a885d1b5-4207-446b-9564-ef0de1225439?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c11f066ae86298ff9550c1cb0c684036, https://si.imgix.net/14099f98/uploads/origins/a885d1b5-4207-446b-9564-ef0de1225439?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=75ecb1e63620e4f4597acb4e4d99d004 2x, https://si.imgix.net/14099f98/uploads/origins/a885d1b5-4207-446b-9564-ef0de1225439?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=edfee04503cefcb8d4e51d920b0d362b 3x"}, "body": "にょーにち様\n\n初めまして、Vsingerのえんと申します。\nXにて募集ポストを拝見しクオリティはもちろん、構図や懐かしさ・個性を感じるデザイン等にとても惹かれ、今回ご縁があれば嬉しいなとリクエストをさせていただきます。\n\n■内容 \nVsingerの「えん」をにょーにち様の世界観で描いて頂きたいです。  \n構図と、可能であればにょーにち様のお好みの衣装、髪型もデザインをお任せできますと幸いです。\n以下キャラクター衣装資料もありますのでお任せでなくても問題ございません。\n\nキャラクター情報\n衣装①②有\nhttps://drive.google.com/drive/folders/1-7Fpn4hMe_Dm5a1kHNS-3KfVpbPx35Vd\n\n身体特徴\n・くるくるアホ毛\n・オッドアイ\n・長めのまつ毛\n・まろ眉\n・金木犀タトゥー\n・口を開けると向かって右側に八重歯\n※資料にて衣装によってタトゥーの位置(片足or両足&右肩)が変わりますが創作衣装の場合はどちらのパターンでも問題ありません。\n\n特にこちらの作品が\n塗り、雰囲気等とても好きです。\nhttps://x.com/ganbarudessan/status/2092456578226262102?s=46&t=qUTNSnuhkryovWod7Gg0pA\n\n性格\n・根暗\n・基本の性格は怠惰\n・眠たそうなことが多い\n・好奇心は旺盛\n・人見知りだが慣れると人を煽ったりしてしまう\n・歌、金木犀、春巻き、狐が好き\n・夜に活動している\n\n■希望納品形式 \nPSDデータまたは、背景透過人物のみデータも含めていただけますと幸いです。\nあくまで可能であればですが、サムネ使用の際のために描写範囲の頭や肩は切らずに入れていただけますと幸いです。\n\n■用途 (可能性も含む)\nYouTube(収益化CH)のサムネイル\nXにて掲載\n\nご縁がありましたら何卒よろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/1-7Fpn4hMe_Dm5a1kHNS-3KfVpbPx35Vd", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@ganbarudessan/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 4084877, "client_id": 2544199, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/c1243ab7/uploads/origins/0a80721d-ba