ytsheet/dx3rd/?id=kDUwRc）\nできれば、↑のキャラクターシートのアイコンイラストのところにある台詞を和田が言って、それを神崎君が聞いてくれている場面だととてもとても嬉しいです。表情やシチュエーションはお任せします。\n他のリクエストとの兼ね合いもあると思うので、もしお時間的に許せば……という気持ちです。よろしくお願いいたします。", "nc": 137, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@yomogi_0v0_/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1015831, "client_id": 403337, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/6c006b27/uploads/origins/9e6a38d5-4d03-4955-9d65-4e37e27b900d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fe7f196f77975226585da66693ed1e02", "srcset": "https://si.imgix.net/6c006b27/uploads/origins/9e6a38d5-4d03-4955-9d65-4e37e27b900d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fe7f196f77975226585da66693ed1e02, https://si.imgix.net/6c006b27/uploads/origins/9e6a38d5-4d03-4955-9d65-4e37e27b900d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=263282ad2baf260f965c8068cbb6c937 2x, https://si.imgix.net/6c006b27/uploads/origins/9e6a38d5-4d03-4955-9d65-4e37e27b900d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a7c7a18a1cf84da1c4bb7c84fdb87926 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/6c006b27/uploads/origins/9e6a38d5-4d03-4955-9d65-4e37e27b900d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=bfd9744683397236e3a8b502c6bb58f0", "srcset": "https://si.imgix.net/6c006b27/uploads/origins/9e6a38d5-4d03-4955-9d65-4e37e27b900d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=bfd9744683397236e3a8b502c6bb58f0, https://si.imgix.net/6c006b27/uploads/origins/9e6a38d5-4d03-4955-9d65-4e37e27b900d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=dca8d8b9acd62c60c5395cf3bcf7d9ac 2x, https://si.imgix.net/6c006b27/uploads/origins/9e6a38d5-4d03-4955-9d65-4e37e27b900d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=340d551c9ba963653d6211fc4ca54b5d 3x"}, "body": "いつもお世話になっております。\n私事ですが、以前同卓したAIMキャンペーン自陣の二次創作を、紙の本の形に印刷して自分で楽しみたいと思っています。つきましては、表紙用のイラストをお描きいただけませんでしょうか？\n【頼みたいイラスト内容】\n・どこか遠くを見ているアズール\n（・↑とはいえよもぎさんの自卓関連イラストなんでもテンションがあがるので、AIMおよび自陣関連であればだれでも嬉しいです）\n・夜のイメージ\n・タイトルとして「可惜夜の怪物」の文字を入れてほしい\n【頼みたい仕様】\n154*216mm（A5サイズ、3mmドブあり）\nPDFファイル形式（本文PDFのつもりなので、それに合わせてです。すみません）", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@uminomokuzu09/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "novel", "tipped": false, "creator_id": 1230473, "client_id": 403337, "vtt_url": null, "thumbnail_image_urls": {"src": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1588094006449573888%2FpCygd86n.jpg?blend64=aHR0cHM6Ly9za2ViLWF2YXRhci5pbWdpeC5uZXQvfnRleHQ_Ymc9NjAwMDIyMjgmdHh0NjQ9NDRPQTQ0T1c0NE9yNDRLdjQ0T3Q0NEs1NDRDQVZHaGxJRE55WkNCRlpHbDBhVzl1NDRDQTQ0SzM0NE9LNDRPcTQ0S3E1WkNONDRDTTVxbWY1cUt3Nkp5bDZKeTA0NEd2NTRHdzQ0R3I1NFNtTGk0dSZ0eHRzaXplPTMwJnR4dGFsaWduPWNlbnRlciUyQ21pZGRsZSZ0eHRjbHI9ZmZmJnc9MzYwJmg9MzYwJnM9Mjg5Zjg2YTBkZTdiNmY3ZjU1MDE3OTQ2ZWZhMDk3MWU&blendalpha=100&blendalign=center&blendmode=normal&blendsize=inherit&bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ad2990f6ff3642e5a16f04bd203e7111", "srcset": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1588094006449573888%2FpCygd86n.jpg?blend64=aHR0cHM6Ly9za2ViLWF2YXRhci5pbWdpeC5uZXQvfnRleHQ_Ymc9NjAwMDIyMjgmdHh0NjQ9NDRPQTQ0T1c0NE9yNDRLdjQ0T3Q0NEs1NDRDQVZHaGxJRE55WkNCRlpHbDBhVzl1NDRDQTQ0SzM0NE9LNDRPcTQ0S3E1WkNONDRDTTVxbWY1cUt3Nkp5bDZKeTA0NEd2NTRHdzQ0R3I1NFNtTGk0dSZ0eHRzaXplPTMwJnR4dGFsaWduPWNlbnRlciUyQ21pZGRsZSZ0eHRjbHI9ZmZmJnc9MzYwJmg9MzYwJnM9Mjg5Zjg2YTBkZTdiNmY3ZjU1MDE3OTQ2ZWZhMDk3MWU&blendalpha=100&blendalign=center&blendm