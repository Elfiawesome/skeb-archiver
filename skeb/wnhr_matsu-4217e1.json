、勉強熱心な正義の味方が好きですが、大切な人には思いやりと気遣いがあります。リュウはとても外向的で他人に共感するが、腐敗した権力には反抗する。黒猫とハスキーのダイナミックな関係。\n\nリュウには快適でありながら体にフィットしたアスレジャーを、アルルソには整った探偵スーツとパンツのセットを着てもらいたい。\n\nポーズや顔は、彼らの個性に合うものなら何でも！\n\nリュウ参考：https://drive.google.com/drive/folders/1_8wVmBYV8v-RdPIIAGVEe0OA2XWfjpm6?usp=drive_link\nアルスロ参考：https://drive.google.com/drive/folders/18XdqDqNQAJD4JtCnxp1FLRvVJeDzhzOH?usp=drive_link", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@wnhr_matsu/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1798152, "client_id": 1551454, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/f6d6cc23/uploads/origins/94124f0c-3f12-4016-9256-872e049df19c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=64d79a5b30121848aba578031bdbc349", "srcset": "https://si.imgix.net/f6d6cc23/uploads/origins/94124f0c-3f12-4016-9256-872e049df19c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=64d79a5b30121848aba578031bdbc349, https://si.imgix.net/f6d6cc23/uploads/origins/94124f0c-3f12-4016-9256-872e049df19c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=092ed113622873610570474c1548de40 2x, https://si.imgix.net/f6d6cc23/uploads/origins/94124f0c-3f12-4016-9256-872e049df19c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=89c7a7936bde8b41c189686d4f6a6c9a 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/f6d6cc23/uploads/origins/94124f0c-3f12-4016-9256-872e049df19c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=63d101cbba108b12211a24fd0a8a2489", "srcset": "https://si.imgix.net/f6d6cc23/uploads/origins/94124f0c-3f12-4016-9256-872e049df19c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=63d101cbba108b12211a24fd0a8a2489, https://si.imgix.net/