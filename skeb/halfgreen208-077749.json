houlder383/status/1706692050454994961）\n警察官、勧木の同僚。真面目ではないが、勧木のおかげで真面目にやらざるを得ない苦労人。首根っこを引っ掴むなどして止めたり方向転換させたりする。\n\nリクエスト文は以上です。お時間あるときにご検討のほどよろしくお願いします。", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@pakipakiiishi/works/67", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 871975, "client_id": 617507, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/d36e7f83/uploads/origins/06c6c65d-09de-4692-9880-1e06d348f301?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=771a6281fd573e4dfe181a06ad39f5c6", "srcset": "https://si.imgix.net/d36e7f83/uploads/origins/06c6c65d-09de-4692-9880-1e06d348f301?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=771a6281fd573e4dfe181a06ad39f5c6, https://si.imgix.net/d36e7f83/uploads/origins/06c6c65d-09de-4692-9880-1e06d348f301?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=3c7ca03bb4af8da1c004ab5ab6b8dfcf 2x, https://si.imgix.net/d36e7f83/uploads/origins/06c6c65d-09de-4692-9880-1e06d348f301?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=2e5cf404b1af8f54fadec430b47f0529 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/d36e7f83/uploads/origins/06c6c65d-09de-4692-9880-1e06d348f301?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d40be5e4aa4a74df6b71d4db0d5e5a44", "srcset": "https://si.imgix.net/d36e7f83/uploads/origins/06c6c65d-09de-4692-9880-1e06d348f301?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d40be5e4aa4a74df6b71d4db0d5e5a44, https://si.imgix.net/d36e7f83/uploads/origins/06c6c65d-09de-4692-9880-1e06d348f301?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=555912a6dbbfd0721da967d868cf1881 2x, https://si.imgix.net/d36e7f83/upl