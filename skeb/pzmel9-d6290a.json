ang/status/1619970178372239360?s=46&t=IyZ-bZXC0Qa_DRtlAkMxRw\n世界観の漫画: https://drive.google.com/drive/mobile/folders/1irAHqpUKI_NJUm7gWRWsxH1KsjZfmyJT\n関係性：\nソリット：ラヴェルに対して\nラヴェルのことは全然見抜けないが、彼と一緒にいるといつもリラックスができ、つい甘えてしまう。よくからかわれるが、仕方がなくと思っている。ソリットはラヴェルの感情を察すことができない。一方で、ソリット自身もラヴェルの心を見抜く能力に怯えている。\n \nラヴェル：ソリットに対して\nソリットは自意識過剰のため、ラヴェルが計画した通りには動かない。それと同時に、ソリットの偉そうな態度に不愉快を覚えてしまう。自由を崇めるソリットと真逆の理念を持ち、すべてを自分の手に絞り込むことを好む。真逆であるからこそ、ラヴェルにとって、ソリットは「特別な人」である。\nその感情は好奇心から発するものか、それとも対抗心か慕うになるか、ラヴェル自身も分からなかった。彼は好きな男の人をいじめるように、不意にソリットをいじめる。彼自身はこの感情に否定しているが。", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@pzmel9/works/8", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 142648, "client_id": 929361, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/e0c12a0c/uploads/origins/0bc024d3-05e9-410d-b10c-6c86da94ad3d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2826c070d641f23d96663b74f5905324", "srcset": "https://si.imgix.net/e0c12a0c/uploads/origins/0bc024d3-05e9-410d-b10c-6c86da94ad3d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2826c070d641f23d96663b74f5905324, https://si.imgix.net/e0c12a0c/uploads/origins/0bc024d3-05e9-410d-b10c-6c86da94ad3d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b39118248e79aaceb846b856d8a37d2f 2x, https://si.imgix.net/e0c12a0c/uploads/origins/0bc024d3-05e9-410d-b10c-6c86da94ad3d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=cec8cacade299e9ce50ba7b129ad034d 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/e0c12a0c/uploads/origins/0bc024d3-05e9-410d-b10c-6c86da94ad3d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3252dca4684d7995f254d6d5b808c2cf", "srcset": "https://si.imgix.net/e0c12a0c/uploads/origins/0bc024d3-