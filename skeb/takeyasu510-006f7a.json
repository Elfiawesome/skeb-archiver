るかどうか)など自由な印象\n\n　チルノさんはツリ目系で裏表のない勝気で積極的な性格\n　大妖精さんはタレ目系で口数が少なく、少し内気で受け身な性格\n　よく一緒にいる仲良しコンビ\n\n　並んで立って目線が合う同身長カプ\n　２人のお胸の大きさも差異はなく\n　妖精さん達なので\n　可能な限り無乳系の方が嬉しいです\n\n夏も近いので、水着の２人をリクエストいたします。\n水着のデザインについてはお任せいたします。\nスクール水着や競泳水着、可愛い系やセクシー系\n何か羽織っているような形でも描きやすいもので問題ございません。\n２人１枚の構図でも、１人ずつ２枚のものでもお任せいたします。\n\nもしよろしければご検討下さいますよう、何卒お願い申し上げます。", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@takeyasu510/works/16", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 358629, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/bd2cfa16/uploads/origins/fdaf081e-a32e-46e4-828a-b04989057e51?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e88e358abe6fd7b18b1d1aa762291eda", "srcset": "https://si.imgix.net/bd2cfa16/uploads/origins/fdaf081e-a32e-46e4-828a-b04989057e51?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e88e358abe6fd7b18b1d1aa762291eda, https://si.imgix.net/bd2cfa16/uploads/origins/fdaf081e-a32e-46e4-828a-b04989057e51?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=43ef252e2217ceed26e101fabb02cee4 2x, https://si.imgix.net/bd2cfa16/uploads/origins/fdaf081e-a32e-46e4-828a-b04989057e51?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=6e07c3788d3340eec1a28ed2ac5daf9c 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/bd2cfa16/uploads/origins/fdaf081e-a32e-46e4-828a-b04989057e51?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0d3dc45765a72bebb1bfc6af1051d878", "srcset": "https://si.imgix.net/bd2cfa16/uploads/origins/fdaf081e-a32e-46e4-828a-b04989057e51?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0d3dc45765a72bebb1bfc6af1051d878, https://si.imgix.net/bd2cfa16/uploads/origins/fdaf081e-a32e-46e4-828a-b04989057