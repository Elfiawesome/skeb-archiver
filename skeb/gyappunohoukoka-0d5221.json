ていただけますと幸いです。\n参照：身長差.jpg\n・地に足をつけている（浮いていない）ポーズにしていただけますと幸いです。\n・しっかりと目が合うようにしていただけますと幸いです（×伏せ目×逸らし目×横顔）\n\n○使用用途\nSNS等での投稿（紹介等、他キャラと並べての掲載を含む）\nキャラクターシートや個人サイトへの掲載\nセッションでの使用\n個人利用の範疇でのグッズ化\n\n○ご提出形態\npngまたはpsdでお願いしたいです。\n\nhttps://drive.google.com/drive/folders/19cX55HhvA47RO_hXR5C2KlgvKHiAEn8J?usp=sharing", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 1156322, "creator": true, "nsfw_acceptable": false, "acceptable": false, "name": "ヘルプマン", "screen_name": "helpen_hhh", "avatar_url": "https://pbs.twimg.com/profile_images/1709960853137879040/OnXwAjNe.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1328729254209540096/1771903800/1500x500", "appeal_receivable": true, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 100, "skills": [{"genre": "art"}], "banned": false, "nc": 160}, {"id": 1652827, "creator": true, "nsfw_acceptable": false, "acceptable": false, "name": "古林けやき", "screen_name": "furuihou", "avatar_url": "https://proxy.misskeyusercontent.jp/avatar/media.misskeyusercontent.jp%2Fio%2F392d0637-fe6f-4668-819d-447f1dab08f0.webp?avatar=1", "header_url": "https://media.misskeyusercontent.jp/io/578aa516-ad00-4289-8d91-0cb9952b0f73.webp", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 5, "complete_expiration_days": 60, "skills": [{"genre": "art"}], "banned": false, "nc": 49}, {"id": 2725348, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "脱兎研究会/Skeb募集中", "screen_name": "escape_rabbit_8", "avatar_url": "https://pbs.twimg.com/profile_images/1980090239809884160/BQDhEdw4.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1501522965493874694/1683470992/1