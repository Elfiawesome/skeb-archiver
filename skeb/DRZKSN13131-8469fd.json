な絵が好きです。\n\nご希望であれば、彼女のデザインも少しいじっていただいても結構です〜。", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}], "sent_works": [], "similar_creators": [{"id": 1075496, "creator": true, "nsfw_acceptable": false, "acceptable": false, "name": "館田 かばえ◾️C107 2日目西へ-40a", "screen_name": "TaTeDaNo_KaBae", "avatar_url": "https://pbs.twimg.com/profile_images/1840698339849048064/ORq2b3PQ.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1240251120510840833/1774691846/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "art"}, {"genre": "correction"}], "banned": false, "nc": 17}, {"id": 2812175, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "えんげぷみぷみ", "screen_name": "dokkora014", "avatar_url": "https://pbs.twimg.com/profile_images/1818651872846397441/olGM8JNG.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1020561122888376320/1714655198/1500x500", "appeal_receivable": true, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 10, "complete_expiration_days": 30, "skills": [{"genre": "art"}, {"genre": "comic"}], "banned": false, "nc": 160}, {"id": 2956376, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "ねさむま", "screen_name": "YzgHbpMVbQmjzfh", "avatar_url": "https://pbs.twimg.com/profile_images/1803449745945587712/qksy6WYx.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1283755758446768128/1713272694/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 3, "complete_expiration_days": 20, "skills": [{"genre": "art"}], "b