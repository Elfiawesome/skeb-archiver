で胸がいっぱいです。\n\n\n\n\n使用用途は、私のSNSでの使用許可と上観鈴さんの使用許可が欲しいです。\n上観鈴さん（モデルですが）VTuberの活動(観鈴さんのSNSでの使用許可と。週間予定表や、YouTubeでのサムネ等での)配信活動に使用させていただくことが可能ですか？上観鈴さんは、ユーチューブのチャンネルではスパチャをしてますので商用利用にあたります。。可能でしたら制作お願いします。\nまた、人物だけの透過pngやpsdデータのご用意お願いします。\nまた、サインほしいのですが加工とか自分でできない為必ずサインなしもお願いします。\n\nどうかご検討お願いいたします。", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [{"path": "/@la_noc_annu/works/9", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2741874, "client_id": 2854649, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/5fa5b95c/uploads/origins/771c5ae0-9270-47a6-8e3c-d1eb17ed9e47?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bc6e798198e1602a668831d799b16ba5", "srcset": "https://si.imgix.net/5fa5b95c/uploads/origins/771c5ae0-9270-47a6-8e3c-d1eb17ed9e47?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bc6e798198e1602a668831d799b16ba5, https://si.imgix.net/5fa5b95c/uploads/origins/771c5ae0-9270-47a6-8e3c-d1eb17ed9e47?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=dc00caa3d63e78eca4f39a7446a657ec 2x, https://si.imgix.net/5fa5b95c/uploads/origins/771c5ae0-9270-47a6-8e3c-d1eb17ed9e47?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c0a6788d65272e5a5430e2d978e5476b 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/5fa5b95c/uploads/origins/771c5ae0-9270-47a6-8e3c-d1eb17ed9e47?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=339d7ce95435ce90de8eb365f8297415", "srcset": "https://si.imgix.net/5fa5b95c/uploads/origins/771c5ae0-9270-47a6-8e3c-d1eb17ed9e47?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=339d7ce95435ce90de8eb365f8297415, https://si.imgix.net/5fa5b95c/uploads/origins/771c5ae0-9270-47a6-8e3c-d1eb17ed9e47?b