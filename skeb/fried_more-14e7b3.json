97716417273856%2F3Y_-rE00.jpg?blend64=aHR0cHM6Ly9za2ViLWF2YXRhci5pbWdpeC5uZXQvfnRleHQ_&blendalpha=100&blendalign=center&blendmode=normal&blendsize=inherit&bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=de8c63cf5b085476ce4b0cff5e803b59 2x, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F2061397716417273856%2F3Y_-rE00.jpg?blend64=aHR0cHM6Ly9za2ViLWF2YXRhci5pbWdpeC5uZXQvfnRleHQ_&blendalpha=100&blendalign=center&blendmode=normal&blendsize=inherit&bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=cc09d0859c0928674b6ea88978ffe8a6 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F2061397716417273856%2F3Y_-rE00.jpg?blend64=aHR0cHM6Ly9za2ViLWF2YXRhci5pbWdpeC5uZXQvfnRleHQ_&blendalpha=100&blendalign=center&blendmode=normal&blendsize=inherit&bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=4dcb9a7b9035752653a46adb4051e0de", "srcset": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F2061397716417273856%2F3Y_-rE00.jpg?blend64=aHR0cHM6Ly9za2ViLWF2YXRhci5pbWdpeC5uZXQvfnRleHQ_&blendalpha=100&blendalign=center&blendmode=normal&blendsize=inherit&bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=4dcb9a7b9035752653a46adb4051e0de, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F2061397716417273856%2F3Y_-rE00.jpg?blend64=aHR0cHM6Ly9za2ViLWF2YXRhci5pbWdpeC5uZXQvfnRleHQ_&blendalpha=100&blendalign=center&blendmode=normal&blendsize=inherit&bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=30ed7094c83fcf25f92192cabf973f85 2x, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F2061397716417273856%2F3Y_-rE00.jpg?blend64=aHR0cHM6Ly9za2ViLWF2YXRhci5pbWdpeC5uZXQvfnRleHQ_&blendalpha=100&blendalign=center&blendmode=normal&blendsize=inherit&bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=40586315a7402c50c000e7d170d8f88f 3x"}, "body": "れっさん、お疲れ様です。\n\n今回、他場所で書いて頂いた\nhttps://tw8.t-walker.jp/scenario/show?scenario_id=7569\n\n上記の内容の後、また七十がグノシエンヌ（と、オルフェウス）にとてもエッチに下拵えされて捕食される内容を書いて頂きたいです。\n前回の様にグノシエンヌが探しに来ない場合は、七十が前回グノシエンヌに抱っこして貰ったときにしっかり香りを嗅いでいるので、その香りを頼りに現在の拠点に押しかけて家の猫と主張するように部屋の隅で寝ているとかと……。\n\n七十は受けリバタイプ（覚えたて単語ゆえにあってるか不明）攻め時は支配型ドSになるが、受け時は救いようがないレベルのドM奉仕体質に変わり、感度もS時は普通から鈍い位に対しM時は過敏から敏感位まで感度が良くなってしまう。\n奉仕体質になるためか嫌なこと以外は基本何でもしてあげたくなり、捕食（文字通りでもエッチな意味でも）される度に相手好みの肉質になれる様に身体を変えていたりしてる。\n（なのでどっちの意味でもまずい言われると割とショックを受ける）\n（グノシエンヌに好みの肉質と味があり、それを知ればグノシエンヌを相手するときはその肉質と味に変わっていくことに）\n（オルフェウスとエウリュディケって致したりするのでしょうか？もしするなら……描写して貰えると嬉しいです）", "nc": 32, "word_count": 5301, "transcoder": "text", "creator_acceptable_same_genre": true}, {"path": "/@fried_more/works/14", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/8f52af6f/uploads/origins/8c2dc21e-7398-4b9a-86ed-0609712947a2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=6b52dd7592576b251c4caa352222ccbf", "srcset": "https://si.imgix.net/8f52af6f/uploads/origins/8c2dc21e-7398-4b9a-86ed-0609712947a2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=6b52dd7592576b251c4caa352222ccbf, https://si.imgix.net/8f52af6f/uploads/origins/8c2dc21e-7398-4b9a-86ed-0609712947a2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=4875533371bc7973d732ca6796085f60 2x, https://si.imgix.net/8f52af6f/uploads/origins/8c2dc21e-7398-4b9a-86ed-0609712947a2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&t