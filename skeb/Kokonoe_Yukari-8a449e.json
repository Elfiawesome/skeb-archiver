io", "creator_acceptable_same_genre": true}], "sent_works": [{"path": "/@omataro9/works/45", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2089168, "client_id": 457941, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/e903c7e9/uploads/origins/d3f13957-c374-4f61-bb56-7278a3504734?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=815b18f757129f14e949c3b772127ab9", "srcset": "https://si.imgix.net/e903c7e9/uploads/origins/d3f13957-c374-4f61-bb56-7278a3504734?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=815b18f757129f14e949c3b772127ab9, https://si.imgix.net/e903c7e9/uploads/origins/d3f13957-c374-4f61-bb56-7278a3504734?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=46b8aa7c64fc9e32172ca5decda50727 2x, https://si.imgix.net/e903c7e9/uploads/origins/d3f13957-c374-4f61-bb56-7278a3504734?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=6a1437ab12df37c5a3652c5e11ff68f7 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/e903c7e9/uploads/origins/d3f13957-c374-4f61-bb56-7278a3504734?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=dbc8b46530eb2e6fe389cc9f72fead44", "srcset": "https://si.imgix.net/e903c7e9/uploads/origins/d3f13957-c374-4f61-bb56-7278a3504734?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=dbc8b46530eb2e6fe389cc9f72fead44, https://si.imgix.net/e903c7e9/uploads/origins/d3f13957-c374-4f61-bb56-7278a3504734?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=2ab7d7225627d18059a3dc00f9c7d769 2x, https://si.imgix.net/e903c7e9/uploads/origins/d3f13957-c374-4f61-bb56-7278a3504734?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=08dfce20467974f9493932d2ef6e0c6a 3x"}, "body": "もち