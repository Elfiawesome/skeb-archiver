n人差し指に銀の指輪をしています。\n\n◆服装は制服に変更してほしいです。\n学ラン\nセーラー服\n\n◆個人的に好きな色の組み合わせ\n朱色、青緑、黒、白\nこちらのイラストの色使いがとても好きです。\nhttps://x.com/Takanashi_218/status/1753677943107395727\n\nたかなし様のイラストの中で好きなテイスト\nhttps://twitter.com/takanashi_218/status/1761356336103928023?s=46&t=7MRU_7GwBK2-ZjxmCm-RuQ\nhttps://twitter.com/takanashi_218/status/1763460332490785208?s=46&t=7MRU_7GwBK2-ZjxmCm-RuQ\n\nたかなし様のイラストに一目惚れしてお願いしたくなった為、\n基本自由に描いて頂いて構いません。\n\nもし、描いていただけましたら\nVRCの自宅に飾らせていただこうと思っております。\nよろしくお願い致します！\n\nhttps://tadanoichi.notion.site/d51e3562f57f41049da51675d248797f?pvs=4", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@umi_hisagi_/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3149193, "client_id": 2091337, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/3584d612/uploads/origins/27f8c247-39f4-4719-a521-f9dba1e8d650?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8188d86e0258b1b7d5b3971e3532bf64", "srcset": "https://si.imgix.net/3584d612/uploads/origins/27f8c247-39f4-4719-a521-f9dba1e8d650?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8188d86e0258b1b7d5b3971e3532bf64, https://si.imgix.net/3584d612/uploads/origins/27f8c247-39f4-4719-a521-f9dba1e8d650?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=935f58c37e43298cb7041c25692259e3 2x, https://si.imgix.net/3584d612/uploads/origins/27f8c247-39f4-4719-a521-f9dba1e8d650?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=3cab42bd708cd06838e9c3bbb4486b08 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/3584d612/uploads/origins/27f8c247-39f4-4719-a521-f9dba1e8d650?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=cccbc89cfd1b24a1931110609262ef03", "srcset": "https://si.imgix.net/3584d612/uploads/ori