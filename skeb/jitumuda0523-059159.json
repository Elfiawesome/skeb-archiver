行為については黙認しています。\n\nまた、幼少期の影響から、メリーゴーランド、オルゴール、キャンディなど童話世界を象徴するものに強い執着があります。\n\nポーズや構図の指定はありませんので、自由に描いていただければ嬉しいです。\nもしご都合が合わない場合は、そのままキャンセルしていただいて大丈夫です。\n最後までお読みいただき、ありがとうございます💙\n\nhttps://imgur.com/a/akM4ufA", "nc": 9, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@jitumuda0523/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3249889, "client_id": 3345256, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/524e315d/uploads/origins/91efc4a5-9915-4e85-99c5-8d9ee96e0ff8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=904fc47a658aebbc261f0bd82bb25120", "srcset": "https://si.imgix.net/524e315d/uploads/origins/91efc4a5-9915-4e85-99c5-8d9ee96e0ff8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=904fc47a658aebbc261f0bd82bb25120, https://si.imgix.net/524e315d/uploads/origins/91efc4a5-9915-4e85-99c5-8d9ee96e0ff8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e060b222ffeeb8559c1aecca1ed3e19f 2x, https://si.imgix.net/524e315d/uploads/origins/91efc4a5-9915-4e85-99c5-8d9ee96e0ff8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c434bdaeb2620fe4332f749d992178c7 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/524e315d/uploads/origins/91efc4a5-9915-4e85-99c5-8d9ee96e0ff8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ab629ea1b368c370b639cbc3bdfbb282", "srcset": "https://si.imgix.net/524e315d/uploads/origins/91efc4a5-9915-4e85-99c5-8d9ee96e0ff8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ab629ea1b368c370b639cbc3bdfbb282, https://si.imgix.net/524e315d/uploads/origins/91efc4a5-9915-4e85-99c5-8d9ee96e0ff8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=5fdc36f5cfce0