%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b144658b27bd1f57fff33a44a9dc7339", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/a5bbeead/uploads/origins/15825545-9533-4c74-a410-0a56cf1da464?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c50f02bb9d0bd79479667e2723539638", "src_set": ""}, "body": "よろしくお願いします。\nURLのOCの見せハイレグパンツとかレイヤードビキニみたいなセクシーな水着（全然違う好みのものでも良いです）を描いてください。\nあと、もしよろしければエッチな感じのピースサインをしてると嬉しいです（無くてもイイです）。\n\nhttps://drive.google.com/drive/folders/1AQPyps0nK959xY-Vuleq4MBBWv01c-pc?usp=drive_link", "nc": 160, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@miroku_mosman/works/19", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 287532, "client_id": 0, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/5644993e/uploads/origins/3c8bd13d-8038-4214-8667-f7131b63217f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fe501243235256dbb233218f5b23edf5", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/5644993e/uploads/origins/3c8bd13d-8038-4214-8667-f7131b63217f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=8e18b3938f92737af650587a0913a8fd", "src_set": ""}, "body": "こんにちは！あなたの芸術的センスと能力が大好きです。本当に美しい！\n\n私のVTubeキャラクターを描いていただけませんか？私のキャラクターは、ネット上のテーマパークに閉じ込められた猫の男の子で、ネット上の視聴者に対して延々と演技を強いられます。彼の体の一部が \"グリッチ \"するのは、絶え間なく演技をしなければならないからです。視聴者に感動を与えなければ罰を受ける！\n\nhttps://pbs.twimg.com/media/GUNr36SXIAA8oK4?format=jpg&name=large\nこの構図では、このランジェリーを身につけた彼をベッドルームでポーズをとっていただけますか？\nランジェリーの色合いや、ランジェリーに描かれているボーンは、私のキャラクターに一番合うと思うものに自由に変えてください！\nまた、髪型は参考画像 \"inspo_LIVE \"の髪型に合わせてほしいのですが、私のキャラクターの髪型は片目を隠してほしいです。\n\nそれ以外は、あなたがマスターなので、何ができるか楽しみです。残りの構図はお任せします。💗\n\nSNSに投稿させていただくかもしれません！\n\nありがとうございました\n\nhttps:/