c7-43b7-9c7d-85f908c7d53c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=2ae76931b60c9b795c44d623649bbad3 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/c7bae015/uploads/origins/bb6049f5-fdc7-43b7-9c7d-85f908c7d53c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ee879d5d2b12f49cb21c3c72ebabfbbb", "srcset": "https://si.imgix.net/c7bae015/uploads/origins/bb6049f5-fdc7-43b7-9c7d-85f908c7d53c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ee879d5d2b12f49cb21c3c72ebabfbbb, https://si.imgix.net/c7bae015/uploads/origins/bb6049f5-fdc7-43b7-9c7d-85f908c7d53c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=0884d1787b41464f7e1399dda4c84b7d 2x, https://si.imgix.net/c7bae015/uploads/origins/bb6049f5-fdc7-43b7-9c7d-85f908c7d53c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=2f1ba3458d91ecb0ec9084a0c1953219 3x"}, "body": "はじめまして(？)…ドクさんのイラストがとても大っ好きで依頼させて頂きました。アイコンが好きすぎて見る度に自分が勝手に得した気分になってます。\nskeb依頼が初めてでしかも文下手なので、もしかしたら不足とかがあると思いますが何卒…聞いていただけますと幸いです。\n\n■使用用途・サイズ▶自分へのご褒美でどうしても見たいというだけなので、サイズはお任せいたします🙇‍♀️\n\n■納期▶お手隙の際で構いません。もし受けていただけるのであればいつでもお待ちしてます。\n\n■キャラクター▶ラスプーチン(言峰)とぐだ子ちゃんの組み合わせでお願いします。服装は選べないので…お任せします…‼️\n\n■構図▶これ！といったのは無いのですが、その、欲を言いますとラスプーチンの体の厚み、筋肉とかが見れると嬉しいです(ドクさんの描かれる筋肉大好きなので…)。あとぐだ子ちゃんとの体格差が好きなので、あわよくば…体格差がわかりやすいと嬉しいです。\n\n■雰囲気？▶暗めの感じだと嬉しいです。(アバウトすぎる)ドクさんのアイコンのイメージが近いかなと。\n\n■絵柄▶ドクさんのいつもの絵柄大好きなので描いてほしいです。\n\n本当にわがままばかりでわかりにくく、申し訳ないです。(しかもおまかせも多い…)\nご都合悪ければ(気分乗らないとか忙しいとかでも構わないので…)、断っていただいて構いません。これからも応援しております！長々と失礼いたしました。", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@DOKU_BUTSU/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3790479, "client_id": 501558, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/60ca1947/uploads/origins/4c4ba5b8-382f-418a-8501-3e25c674876f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=044b4df4670e3285fab331e98673fca7", "srcset": "https://si.imgix.net/60ca1947/uploads/origins/4c4ba5b8-382f-418a-8501-3e25c674876f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=044b4df4670e3285fab331e98673fca7, https://si.imgix.net/60ca1947/uploads/origins/4c4ba5b8-382f-418a-8501-3e25c674876f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=fa7089adb2f79dee5ecf9a577ef94559 2x, https://si.imgix.net/60ca1947/uploads/origins/4c4ba5b8-382f-418a-8501-3e25c674876f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=23f02481b9bf0dace88b79d80dfb3483 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/60ca1947/uploads/origins/4c4ba5b8-382f-418a-8501-3e25c674876f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e35c99b5a3c2ca3faf2ec9bdd9a213b1", "srcset": "https://si.imgix.net/60ca1947/uploads/origins/4c4ba5b8-382f-418a-8501-3e25c674876f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e35c99b5a3c2ca3faf2ec9bdd9a213b1, https://si.imgix.net/60ca1947/uploads/origins/4c4ba5b8-382f-418a-8501-3e25c674876f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=96adb6beee631785cc4f4bfc867f004e 2x, https://si.imgix.net/60ca1947/uploads/origins/4c4ba5b8-382f-418a-8501-3e25c674876f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=1774ed3e638b9688837ab9c6f52278f9 3x"}, "body": "こんにちは！ちょっとおバカなお願いがあるんですが。ナポレオン好きのあなたに頼もうと思ったんです。でもお断りされても全然構いません。\n私が創作したオリジナルキャラクター（OC）がいます。1830年頃の『モンテ・クリスト伯』のメイド役です。エデンという名で、子供の頃からナポレオンの大ファンでした。私は個人的に小説を書いていて、モンテ・クリスト伯に腹が立った時、ナポレオン（彼の関与でモンテ・クリスト伯が投獄された）がエデンを慰める姿を想像するのが好きです。この冗談を現実のものにしてほしいのです：\n画像「10,000,000」のポーズでナポ