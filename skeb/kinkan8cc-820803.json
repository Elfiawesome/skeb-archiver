90846557?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3483173510d5323f09daa40d547abd92, https://si.imgix.net/4887c123/uploads/origins/dfd7b7b4-2364-4887-a6d0-a97590846557?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=ed397ae01197596c0f14c4d5a7409fe3 2x, https://si.imgix.net/4887c123/uploads/origins/dfd7b7b4-2364-4887-a6d0-a97590846557?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=16eac2167dc51a5e5b3c6b79d50cce26 3x"}, "body": "こんにちは！\nあなたの衣装デザインは本当に素晴らしく、私のドラゴンレディ「イシャラ」のために、新しい衣装を1つ以上デザインしていただけないかとお願いしたくて連絡しました！\n\nイシャラは、策略家で魅惑的な悪役の性格を持っており、自分の体を誇示したり、華やかで印象的、あるいは威圧的な姿を見せたりするのが好きです。\n\n衣装のアイデアですが、描いてみたいものをいくつでも自由に選んでください：\n- セクシーで大人っぽい水着\n- バニースーツ\n- フォーマルウェア\n- カジュアルウェア\n\nその他、似合うと思うものであれば何でも構いません！\n\n今回の作品では、翼なしで描いていただいても大丈夫です！\n\n参考画像：https://imgchest.com/p/6eyr3dnqxyp\n\nよろしくお願いします！\n\nhttps://imgchest.com/p/6eyr3dnqxyp", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@kinkan8cc/works/13", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3579575, "client_id": 1280069, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/73ab0bc4/uploads/origins/e16d0993-588a-4c5e-a1ee-a79b848f470f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=56354bb80a377e875018f642e0e77000", "srcset": "https://si.imgix.net/73ab0bc4/uploads/origins/e16d0993-588a-4c5e-a1ee-a79b848f470f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=56354bb80a377e875018f642e0e77000, https://si.imgix.net/73ab0bc4/uploads/origins/e16d0993-588a-4c5e-a1ee-a79b848f470f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=aa61a100894cf0e43663477ca8d260b2 2x, https://si.imgix.net/73ab0bc4/uploads/origins/e16d0993-588a-4c5e-a1ee-a79b848f470f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f0efe22bdb0221efd687ea82b91a2f5d 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/73ab0bc4/uploads/origins/e16d0993-588a-4c5e-a1ee-a79b848f470f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=8d847552cfa49477f4fc39b6d53ea617", "srcset": "https://si.imgix.net/73ab0bc4/uploads/origins/e16d0993-588a-4c5e-a1ee-a79b848f470f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=8d847552cfa49477f4fc39b6d53ea617, https://si.imgix.net/73ab0bc4/uploads/origins/e16d0993-588a-4c5e-a1ee-a79b848f470f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=6a36de4007e1b60a5be7ed789fb2b2bb 2x, https://si.imgix.net/73ab0bc4/uploads/origins/e16d0993-588a-4c5e-a1ee-a79b848f470f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=85663ac8de9651af23deb926edf3dde5 3x"}, "body": "こんにちは！私はWolflessと申します。\n今日、Skebであなたの素晴らしい衣装デザインを偶然見かけ、とても気に入りました。\nもし可能であれば、以前のSkebでの作品（ https://skeb.jp/@kinkan8cc/works/10 ）のような、私のキャラクター用の衣装デザインをお願いしたいのですが。\n\n彼女の名前はオーロラです。サイバーパンクな未来を舞台に、魔女であり賞金稼ぎとして活動しています。ポータル魔法を使って、虚無から銃や剣を召喚します。  \n彼女の見た目は以下の通りです：\nhttps://imgur.com/a/aurora-witch-oc-SbNJOq7\n魔法の発動シーンはこちらです：\nhttps://imgur.com/a/magic-how-does-she-fight-scezTS0\n繰り返し描かれている十字のデザインは無視していただいて構いません。\n\n■ 依頼する衣装\n① 最優先：彼女のために思いついたどんな衣装やコンセプトでも （これが私にとって一番重要です）\n② バニースーツ\n③ 大人っぽい水着（タイプやデザインはお任せします）\n④ カジュアルなストリートファッション（以前のSkeb作品のようなもの — 参考：https://skeb.jp/@kinkan8cc/works/11）\n\nご依頼をご検討いただき、誠にありがとうございます！\n\nhttps://imgur.com/a/aurora-witch-oc-SbNJOq7", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@kinkan8cc/works/12", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3579575, "client_id": 3090461, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/c415d945/uploads/origins/a58c5ef0-1789-487b-b74b-2fb34591857a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1f7733e5b03af694f616391439341eaf", "srcset": "https://si.imgix.net/c415d945/uploads/origins/a58c5ef0-1789-487b-b74b-2fb34591857a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1f7733e5b03af694f616391439341eaf, https://si.imgix.net/c415d945/uploads/origins/a58c5ef0-1789-487b-b74b-2fb34591857a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=fbc5e1b24c76feb5a6e8cb62fa1b0b53 2x, https://si.imgix.net/c415d945/uploads/origins/a58c5ef0-1789-487b-b74b-2fb34591857a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c4673965808580487641469f4a50016b 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/c415d945/uploads/origins/a58c5ef0-1789-487b-b74b-2fb34591857a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5ac11e5d9463957a9eb0441f2669fc37", "srcset": "https://si.imgix.net/c415d945/uploads/origins/a58c5ef0-1789-487b-b74b-2fb34591857a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5ac11e5d9463957a9eb0441f2669fc37, https://si.imgix.net/c415d945/uploads/origins/a58c5ef0-1789-487b-b74b-2fb34591857a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=0ba3d641c1b30ab852fb05216a7cd60d 2x, https://si.imgix.net/c415d945/uploads/origins/a58c5ef0-1789-487b-b74b-2fb34591857a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=bd0ded0bfdcb3d99429a241ffa91e571 3x"}, "body": "お久しぶりです。\n以前は姉妹のお仕着せを仕立てていただき、本当にありがとうございました。\nご縁がありましたら、うちの子のお仕着せを描いていただけないでしょうか。\n\n\n■世界観\n遥か昔、星によって十三分割された、魔術のあるファンタジーな多層世界となっています。\n他世界から色々な物(魔物やら武具やら技術やら)が落ちてくる世界のため、技術レベルについては気にしなくて大丈夫です。\n食べ物等々もおおむね現実世界にならっています(魔物は例外)\n\n\n■キャラクター\nサツキといいます。\nキャラクター設定と参考イラストについては資料URLに格納しております。\n\nダークエルフの侍。\n人を食ったようなふてぶてしい顔、老成した雰囲気。\n人族の師が今際に放った\"魔剣\"の再現をのんびり目指す凡人。\n銀髪褐色、灼眼、尖り耳\n貨幣による羅漢銭、魔術刀による居合術を用いる。\n魔術刀である打刀には鍔がなく、刃は半ばから完全に折れている。師の遺品を媒介として造られた。\n\n火酒の行商をする蛇人女性の護衛をしつつ、第三世界を旅しています。\n\n\n■お仕着せ\n冒険者用の戦闘服。\n設定資料の服装はあまり気にせず、雉サーカス様の描きたいように描いていただけますと嬉しいです。\n細かい装飾などもお任せいたします。\n\n\n■用途\n個人鑑賞、コミッション依頼用\n\nご縁がありましたらよろしくお願いいたします……！\n\nhttps://drive.google.com/drive/folders/1NEzvFkNu-kHVN7GZErepK1N8cY6CvH77?usp=drive_link", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@kinkan8cc/works/11", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3579575, "client_id": 1066697, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/813f9684/uploads/origins/a4f17e37-92ec-4723-9e65-f2412fdbb4df?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b144f138949b507c149e0f3636ab616e", "srcset": "https://si.imgix.net/813f9684/uploads/origins/a4f17e37-92ec-4723-9e65-f2412fdbb4df?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b144f138949b507c149e0f3636ab616e, https://si.imgix.net/813f9684/uploads/origins/a4f17e37-92ec-4723-9e65-f2412fdbb4df?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=6e3fec07bcdbc5bcdd9d2fc31a30ed71 2x, https://si.imgix.net/813f9684/uploads/origins/a4f17e37-92ec-4723-9e65-f2412fdbb4df?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=9971019ee6c1845ff5b9a04e1dbf7801 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/813f9684/uploads/origins/a4f17e37-92ec-4723-9e65-f2412fdbb4df?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=bc00001d28f8f3a8bc928f519ba5cfe1", "srcset": "https://si.imgix.net/813f9684/uploads/origins/a4f17e37-92ec-4723-9e65-f2412fdbb4df?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=bc00001d28f8f3a8bc928f519ba5cfe1, https://si.imgix.net/813f9684/uploads/origins/a4f17e37-92ec-4723-9e65-f2412fdbb4df?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=4dd2422e234184b973e9facbe6efc4a7 2x, https://si.imgix.net/813f9684/uploads/origins/a4f17e37-92ec-4723-9e65-f2412fdbb4df?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=5ceef28d318b43a12b7ace85001073f2 3x"}, "body": "はじめまして、歪んだむと申します。\n衣装デザインや様々な衣装のイラストが目に留まりリクを送りました。\n\nうちの子の「フォルン（デュレイルフォルム）」の衣装デザインをリクエストします。\n資料で分かりにくい点、不明な点などは描きやすいように調整・アレンジしていただいて大丈夫です。\n\n\n●フォルン（デュレイルフォルム https://x.com/i/status/2053106690007187580?s=20 ）\n少女からの大人化、狼からの擬人化のイメージで生まれた中間形態。大人の狼獣人女性のような姿。\n魔法戦士的な中～近距離での戦闘を想定し、長身＋長い手足＋筋肉質ではないが引き締まった外観となっている。\n角込み（靴無し）で192.３cm\n出るところは出つつ引き締まっている。胸は顔よりデカい\n黙ってるとクール系女王様っぽいが、中身は他の姿と変わらない。人としての一般常識に疎い少女と野生動物みたいな本能で動く…を良くも悪くも両立している感じ\n※\n頭や背後の鎧部分は外した状態　【首輪や鎖＆鉄球、左額の氷角は据え置き】\n髪は腰くらいまで長く、尻尾もモフモフかつ長い\n少女姿と同じく前髪の一部、体毛や尻尾に紋様のような黒いメッシュ\n肘～手首、膝下～足首は腕カバーやブーツでなく実際に体毛が生えていますが、戦闘力offのイメージで普通に褐色肌でもOK\n\n●服装　可能な範囲でお願いします。\n①非戦闘時の、大人姿での普段着やよそ行きの服\n可能なら背面なども\n\n②大人っぽい水着（タイプやデザインお任せ）\n③名前が下手くそなひらがなで書いてあるパッツパツの白スクール水着（新旧のタイプなどもお任せ）\n④メイド、バニー、チャイナなどから好きなもの\n\n髪型のアレンジ（長さ含む）、メイク、ネイル、装飾品の類い…等、もろもろお任せします。先生が大人フォルンに似合いそうだと思うもので好きにコーディネートしていただけたらと思います\n\nそれぞれの衣装での姿や、\n文字や背景、宛名・サインにつきましてはpsdレイヤーで別々にon/offできるようお願いいたします（投稿時はサインon）\n\nご検討よろしくお願いします。\n\n\n・補足資料　フォルンのその他の姿など\n　https://x.com/i/status/1977337608620658814\n【封印の要となっている首輪や鎖は外れない　※すべての姿で共通】", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@kinkan8cc/works/10", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3579575, "client_id": 3090461, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/a4ba18ef/uploads/origins/0212dc76-6076-4e7e-b4fd-d036673053b4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4192ff6b831577e66042287e7272b260", "srcset": "https://si.imgix.net/a4ba18ef/uploads/origins/0212dc76-6076-4e7e-b4fd-d036673053b4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4192ff6b831577e66042287e7272b260, https://si.imgix.net/a4ba18ef/uploads/origins/0212dc76-6076-4e7e-b4fd-d036673053b4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ab6ac52973bae45e7a370a97c5e72d0f 2x, https://si.imgix.net/a4ba18ef/uploads/origins/0212dc76-6076-4e7e-b4fd-d036673053b4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d1557f25873540c6d685d3fa366e4138 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/a4ba18ef/uploads/origins/0212dc76-6076-4e7e-b4fd-d036673053b4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9e9a8eab711bbb18eee60b4e935ab53d", "srcset": "https://si.imgix.net/a4ba18ef/uploads/origins/0212dc76-6076-4e7e-b4fd-d036673053b4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9e9a8eab711bbb18eee60b4e935ab53d, https://si.imgix.net/a4ba18ef/uploads/origins/0212dc76-6076-4e7e-b4fd-d036673053b4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=33323c5a2cb50e0960e241edc5cc045b 2x, https://si.imgix.net/a4ba18ef/uploads/origins/0212dc76-6076-4e7e-b4fd-d036673053b4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=9f2cd538d2593efd5285ee128160ff81 3x"}, "body": "先日はユラヴィカのお仕着せをありがとうございました！\n本当に素敵で感動です！\nもしよろしければ、姉であるルビアナにも同じように衣装のデザインをしていただけないでしょうか……！\n\n■世界観\n遥か昔、星によって十三分割された、魔術のあるファンタジーな多層世界となっています。\n他世界から色々な物(魔物やら武具やら技術やら)が落ちてくる世界のため、技術レベルについては気にしなくて大丈夫です。\n食べ物等々もおおむね現実世界にならっています(魔物は例外)\n\n■キャラクター\nユラヴィカといいます。\n身長百七十五センチル、多層世界に生きる龍人。\n金髪眼鏡、見た目は理知的頭脳は筋肉、愛情深い人理の守護者、ナチュラル不遜な風龍。\nアクセや髪型等は自由にアレンジしていただいて大丈夫です。\n\n■服装\n以下希望構図の箇条書きです。\n①が理想ですが、②以降で気に入ったイメージがあれば使ってくださると嬉しいです……！\n\n①雉サーカス様の思いついたお仕着せやイメージ(なにより優先)\n②ニットにスカート。珈琲でも買っていそうな落ち着いた姿。\n③スポーツウェアに近い形。\n④バニー\n\n■