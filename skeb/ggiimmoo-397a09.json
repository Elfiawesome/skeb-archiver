si.imgix.net/58d049db/uploads/origins/46e9c556-0f5b-4c97-ae03-cd12c9bea1d6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=0947b67c35009387ca5a5f5d61387c51 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/58d049db/uploads/origins/46e9c556-0f5b-4c97-ae03-cd12c9bea1d6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=37cf004d04615c5d8120b3e7f8e635a8", "srcset": "https://si.imgix.net/58d049db/uploads/origins/46e9c556-0f5b-4c97-ae03-cd12c9bea1d6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=37cf004d04615c5d8120b3e7f8e635a8, https://si.imgix.net/58d049db/uploads/origins/46e9c556-0f5b-4c97-ae03-cd12c9bea1d6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=f44a848ca2eca7c2fd096a37eeb29ce4 2x, https://si.imgix.net/58d049db/uploads/origins/46e9c556-0f5b-4c97-ae03-cd12c9bea1d6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=b256b8b01bd393d8e8fb4992a0bb2729 3x"}, "body": "ご無沙汰しております。\n繰り返しで恐縮ですが、ミアちゃんを依頼してもよろしいでしょうか？\n\n社会人なミアちゃんはどうでしょうか。\n得意げな顔で今月分のお給料を没収する、あくどいミアちゃんをお願いしたいです。\n服装はスーツ・オフィスカジュアルなど、指定はありません。また、ミアちゃんの姿勢や構図の指定もありません。\n小悪魔的な可愛さが理想です。\n\nよろしければ手書きの台詞を頂けないでしょうか？（ミアのための労働、お疲れさま♡ など）\n最後に、「プリちゃんへ」の宛名を頂きたく思います。\n\n今までに頂いていたミアちゃんを定期的に見返しては恍惚としています。ありがとうございました。\nこの度もぜひ、ご検討の程よろしくお願い致します。", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@ggiimmoo/works/13", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/5123a067/uploads/origins/276eeb36-06a0-4829-8490-bb9404766caf?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=81de7a1a6ccd1e6924d59d4f524ff66f", "srcset": "https://si.imgix.net/5123a067/uploads/origins/276eeb36-06a0-4829-8490-bb9404766caf?bg=%23