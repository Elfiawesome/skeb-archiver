6-12d3ddf91365?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=fbe99e14b9282b0fc61f2a6096b65eb2", "srcset": "https://si.imgix.net/64061d1d/uploads/origins/6fa660d7-f427-47ad-92e6-12d3ddf91365?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=fbe99e14b9282b0fc61f2a6096b65eb2, https://si.imgix.net/64061d1d/uploads/origins/6fa660d7-f427-47ad-92e6-12d3ddf91365?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=243cc40441055cb8911085bd0287a6d2 2x, https://si.imgix.net/64061d1d/uploads/origins/6fa660d7-f427-47ad-92e6-12d3ddf91365?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=c47b0df36ad95c556c2f97e88ad8af80 3x"}, "body": "藍ぽんさん初めまして。いつもイラスト等楽しませていただいております。\nクルクル幕張公演でのフラスタも現地で見させて頂きました！最高でした\n\nさっそくイラストのリクエストなのですが、自分はダンツフレームのSSRサポカがものすごく大好きなのであれのようなウイニングライブで主役になった喜び、ファンへの感謝をあらわにして踊っているダンツのイラストがみたいです！\n初めてskebでイラストをリクエストするのでよくわからない点などがあったら申し訳ありません...\n\n文字数にあまりがあるので少しリクエストを送る理由などを綴っておきます。時間があれば読んでもらえるとありがたいです。\n　今回藍ぽんさんにリクエストさせていただいた理由はダンツを描いてる方で1番史実のことをよく知っていてそれを作品で描いて下さったのが大きな理由です！自分はコミケに行けなかったので作品を所持してないですがサンプルを見ただけで自分は思わず泣いてしまうくらい素晴らしい作品でした...\n個人的な話ですがダンツは今世間的に可愛いキャラとしての認識が強いと思っていてその中でも藍ぽんさんは可愛いと史実の出来事を含めて大好きなんだなぁと思い自分は今回イラストのリクエストに思い立ちました。\n自分語りを含めた文を長々と綴ってしまい申しわけありませんでした...\n今後も活動頑張ってください！応援しております", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@ipon17grablue/works/8", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1321327, "client_id": 2763378, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/c7365f34/uploads/origins/e06da847-f8da-4918-b68d-54ea4bd0561d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=841f50385a890a96f0cd3b7a2598a4c8", "srcset": "https://si.imgix.net/c7365f34/uploads/origins/e06da847-f8da-4918-b68d-54ea4bd0561d?bg=%23fff&auto=format%2Ccompress&fm=webp&fi