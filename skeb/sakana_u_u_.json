0ca7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d813213416bf1cfdab2875ff1d0d5117", "src_set": ""}, "body": "はじめて。\n先日はじめて焼魚先生の素晴らしいイラストを拝見させて頂きましてリクエストをお願いしたいと思いましたのでリクエストさせて頂きます。\n\n艦これの秋月をお願いしたいと思います。\n\nいつも真面目で頑張り屋な彼女がふと提督にだけ見せる笑顔、そんな秋月をお願いしたいと思います。\n\n背景は白で大丈夫です。\n\nポーズ他細かな所は焼魚先生におまかせします。\n\nリクエストのご検討をどうかよろしくお願い致します。", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@sakana_u_u_/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3359673, "client_id": 64692, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/416a61b0/uploads/origins/ed5e2749-0799-4a2f-98dd-d3f762fc353c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f6f7cf046b308eca7fd37320832975dc", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/416a61b0/uploads/origins/ed5e2749-0799-4a2f-98dd-d3f762fc353c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=777b88802644c647d557ae37a7c961fe", "src_set": ""}, "body": "焼魚先生いつも素晴らしいイラスト素敵なイラストを拝見しております。\n先生にぜひリクしたいと思いお願いにあがりました。\n\n今回描いていただきたいのは　艦これ　川内改二です。\n\n改二制服　頭の髪飾りあり。\nこちらを向いて優しく微笑んでいる。\n\n背景は指定しません　白で大丈夫です\n\nほか細かいところはお任せします。\n\nリクエストのご検討何卒よろしくお願いします！", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@sakana_u_u_/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3359673, "client_id": 582146, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/387b36dd/uploads/origins/e09004bc-8763-44dc-b62d-c98e11fcee1f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=576490690c432ddd3bfd6dd7f21ba79c", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "