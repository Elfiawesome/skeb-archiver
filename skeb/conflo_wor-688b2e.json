い茶髪、青い目。ストイックな衣装仕立て屋。\n\nこの2人は、サーカス／マジシャンのショーで一緒に働いている。ブライアーはパフォーマーで、チェルは衣装とセットのデザインを担当している。ふたりは、一緒に働くことで複雑になる、浮気性のロマンチックな関係を持っている。\n\n「◈」使い方ソーシャルメディアのプロフィール写真と個人的な感謝の言葉。常にアーティストであるあなたの直接のクレジットを添えて。\n\n「◈」参照リンク\n🕊️ https://drive.google.com/file/d/1dW8emBkZlhRiZHfPee5byvuEk3h-UT2M/view?usp=sharing\n🌊https://drive.google.com/file/d/1b2DRMURuuAvq-LBSLwzAYSKIjOuRBPti/view?usp=sharing\n\n🖼️ https://drive.google.com/drive/folders/1-fciKcmQQZ1EEwcW8mPK54hzRB8k1qPl?usp=sharing\n\nhttps://drive.google.com/drive/folders/1-fciKcmQQZ1EEwcW8mPK54hzRB8k1qPl?usp=sharing", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@conflo_wor/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1552560, "client_id": 3137892, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/c8fe7733/uploads/origins/f328e57b-4eb3-48c7-8f07-8b39532a69fd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bf57a31c60ef0a2510ec81cb86c0d3ed", "srcset": "https://si.imgix.net/c8fe7733/uploads/origins/f328e57b-4eb3-48c7-8f07-8b39532a69fd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bf57a31c60ef0a2510ec81cb86c0d3ed, https://si.imgix.net/c8fe7733/uploads/origins/f328e57b-4eb3-48c7-8f07-8b39532a69fd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f1a69eb8184c7db518643209b2e3161c 2x, https://si.imgix.net/c8fe7733/uploads/origins/f328e57b-4eb3-48c7-8f07-8b39532a69fd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=898c323756032df0875faeff282b195a 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/c8fe7733/uploads/origins/f328e57b-4eb3-48c7-8f07-8b39532a69fd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=71f6eb2ed0895bef07d25bdc7bfd1e68", "srcset": "https://si.imgix.net/c8fe7733/up