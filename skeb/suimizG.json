資料があります！\n\n二人はまだそれほど親しくはないが、ロマンチックな緊張感がある！そして、彼らは将来必ず一緒になる！！トイハウスのプロフィール（残念ながら英語ですが、翻訳すれば大丈夫です！もっと有益な情報があるはずです）とアートリファレンスをgoogleドライブに保存しています！ベジークは恥ずかしがり屋ではないんだ。でも、ローランに近づくために多くのことを学ぶ！一方、ローランはとても自信家で、人と触れ合うのが好きです。\n\nhttps://toyhou.se/11661368.bezykard-dorenga (彼のルックスについては、google driveのリファレンスを見てください。ここではまだ更新されていないので！)\nhttps://toyhou.se/11662181.laurent-de-attele\n\nhttps://drive.google.com/drive/folders/1BCVy3qt9M8Quo-_oJNe54R2qPJNkVS_Q", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@suimizG/works/217", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/ab590e4a/uploads/origins/e9949781-ea64-4e30-aaa5-fe9a5fdb5b3a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=b87708ea59a6147eaadc570f670669ad", "src_set": ""}, "private": true, "genre": "art", "tipped": false, "creator_id": 1337647, "client_id": 695217, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 145, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@suimizG/works/216", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1337647, "client_id": 1746351, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/ac33cb96/uploads/origins/bafda75a-77b7-432c-88be-e099afe1ccb7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=46f6dfc651dce01da88d1a4d8e8779c3", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/ac33cb96/uploads/origins/bafda75a-77b7-432c-88be-e099afe1ccb7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a0a2325f18fbd3111124b18696419dfd", "src_set": ""}, "body": "スイ🐰さん、初めまして！スイ🐰さんの作品がとて