ins/2769e0a4-64c6-4662-85d4-f8b63140584c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=43c839e509f9f2d0398d57e3da8ddf73", "srcset": "https://si.imgix.net/e08f7125/uploads/origins/2769e0a4-64c6-4662-85d4-f8b63140584c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=43c839e509f9f2d0398d57e3da8ddf73, https://si.imgix.net/e08f7125/uploads/origins/2769e0a4-64c6-4662-85d4-f8b63140584c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=1d4693898fd3029e0fa85c0d60796b82 2x, https://si.imgix.net/e08f7125/uploads/origins/2769e0a4-64c6-4662-85d4-f8b63140584c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=58da620355edb8a0ad2859308823bde3 3x"}, "body": "Ag様\n\nいつもお世話になっております。illdと申します。\nAg様の絵柄や世界観が本当に大好きです。よろしければ、自創作の男ペアのイラストをお願いできますでしょうか。\n\n〇キャラクター詳細\n🤍Necro\n20歳/176cm\nフィジカルギフテッドの魔力なし。ある出来事がきっかけでNo.73に執着している。彼以外に興味がなく、彼に出会えた今が人生で一番幸せだと思っている。No.73の強かな面に気づいたうえで、それでもいいから傍にいたいと思っている。\n🖤No.73\n19歳/170cm\n魔力持ち。しかし使える魔法も実力も価値観も何もかもが平凡。それゆえに「普通の優しさ」から起こした行動のせいで、Necroから執着される。逆に利用して守ってもらおうとしていたが、最近は絆されてきており、自ら何かと世話を焼いている。\n\n〇構図指定など\n特に希望はありません。自由に描いてください。\n資料には明記されていませんが、キャラクター同士の距離間（友人、相棒、恋人など）は自由に解釈していただいて問題ありません。\nもし可能でしたら、PSD形式で納品していただけましたら幸いです。\n\n〇使用用途\n・連携先以外を含むSNSのアイコンやバナー、そのほか個人利用\n・連携先以外を含むSNSでの掲載(非営利)\n・個人観賞目的でのグッズ作成\n\n内容や金額で問題点がございましたら、遠慮なく再送にてお知らせください。\nご検討いただけますと幸いです。よろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/1KPAe5L7uujRubEpLBTEtZVbvrXExYGkP?usp=drive_link", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@tewoawasete/works/10", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1880982, "client_id": 3438863, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/f8afd37a/uploads/origins/67507b71-bac0-40e0-acd8-e0252754c676?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=168b45ba0f6e5a6971c7e36db0240cbd", "srcset": "https://si.imgix.net/f8afd37a/uploads/origins/67507b71-bac0-40e0-acd8-e0252754c676?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=168b45ba0f6e5a6971c7e36db0240cbd, https://si.imgix.net/f8afd37a/uploads/origins/67507b71-bac0-40e0-acd8-e0252754c676?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e80eb84fd046ff769c6117dd6cbeab2f 2x, https://si.imgix.net/f8afd37a/uploads/origins/67507b71-bac0-40e0-acd8-e0252754c676?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=07a95ddba2459e1889546eae89e82c56 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/f8afd37a/uploads/origins/67507b71-bac0-40e0-acd8-e0252754c676?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=25075bb2766ae2f765cad4147234660a", "srcset": "https://si.imgix.net/f8afd37a/uploads/origins/67507b71-bac0-40e0-acd8-e0252754c676?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=25075bb2766ae2f765cad4147234660a, https://si.imgix.net/f8afd37a/uploads/origins/67507b71-bac0-40e0-acd8-e0252754c676?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=f5ca3c9617e71d6b46c4a5475a096e4e 2x, https://si.imgix.net/f8afd37a/uploads/origins/67507b71-bac0-40e0-acd8-e0252754c676?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=b7923c4f433cd2ae25237cd0e27969f5 3x"}, "body": "𓌉◯𓇋様はじめまして。\n今年、「果ての鳥よ、」をKPさせていただきとても思い出に残るセッションになりました。\n素敵なシナリオに出会えて本当に良かったです。ありがとうございました。\n今回はその「果ての鳥よ、」のPCたちを書いていただきたくご依頼させていただきました。\n\nKPC\n名前：朴 架 (すなお かける)\n性別：男\n年齢：20歳\n身長：178cm\n性格など：物静かで冷静、言動は常に落ち着いている。叔母の唯に対しては少し冗談を言ってからかったり笑ったりする一面もある。ギターが好きで大学生になってから隣町の楽器店でバイトをしている。\nPCとの関係性：15歳の頃に両親を事故で亡くし、叔母である唯(PC)に引き取られた。\n事故から塞ぎがちになり高校生の間はその反動で反抗的な態度を唯に向けたり無視をしたりと迷惑をかけていた。\n\nPC\n名前：朴 唯(すなお ゆい)\n性別：女\n身長：160cm\n性格など：中学までは真面目だった。写真が趣味で、コンテストで受賞記録もある。が、高校の頃にコンテストで自分よりも歴の浅い参加者が最優秀賞を受賞した。\nその時、コネクションという陰謀を偶然にも知る。2年連続で受賞を逃し、受験勉強も手につかずぐれにぐれて高校卒業後、キャバ嬢として働く。\n現在は落ち着いたアラサーではあるが、見た目だけで中身は子どもっぽい。\n外面は猫かぶりで、穏やかに笑うような女を演出している。\nKPCとの関係性：25歳のとき、甥っ子(当時15時)を引き取ることになる。過去甥っ子が反抗期のときに盛大に喧嘩したこともある。\n\nイラストの希望\n「果ての鳥よ、」のイメージで描いていただけると嬉しいです。出来れば人物はトレーラーのように白黒だと嬉しいです。\nその他はすべてお任せします。\n\n頂いたイラストの用途\nSNSのアイコン・ヘッダーなどの使用、TRPGでの使用(配信はしてません)\n個人で楽しむためのグッズ作成\n\nよろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/1Njyj_YpJgS95Fbrdmd5DY0dPrEo85J9A?usp=sharing", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@tewoawasete/works/9", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1880982, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/60529399/uploads/origins/3bde4196-a58d-4423-a78b-4db17745a457?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9dd494087c82c8fdbaf1455c0a972e2c", "srcset": "https://si.imgix.net/60529399/uploads/origins/3bde4196-a58d-4423-a78b-4db17745a457?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9dd494087c82c8fdbaf1455c0a972e2c, https://si.imgix.net/60529399/uploads/origins/3bde4196-a58d-4423-a78b-4db17745a457?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=8d1ab2c06acdeecd7514aaa2b3fd58f5 2x, https://si.imgix.net/60529399/uploads/origins/3bde4196-a58d-4423-a78b-4db17745a457?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=8f17a7dcae103b9b9a0d5ff62ee8ec44 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/60529399/uploads/origins/3bde4196-a58d-4423-a78b-4db17745a457?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=11ead5b5a3dc90df8c4abd6a556b3975", "srcset": "https://si.imgix.net/60529399/uploads/origins/3bde4196-a58d-4423-a78b-4db17745a457?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=11ead5b5a3dc90df8c4abd6a556b3975, https://si.imgix.net/60529399/uploads/origins/3bde4196-a58d-4423-a78b-4db17745a457?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=db2aadb4aac9660cb093f86d8b25260a 2x, https://si.imgix.net/60529399/uploads/origins/3bde4196-a58d-4423-a78b-4db17745a457?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=1f08ee0da98687fb467f70bb5642e4f3 3x"}, "body": "Ag様はじめまして。コンと申します。\n可愛らしい絵柄に惹かれて、うちよその探索者のイラストをお願いできればと思いリクエスト失礼致します。\n\n◆関係性など\nCoCシナリオを通して知り合い探索を続けていくなかで恋仲になった二人です。\nお互いの作るもの(スイーツと音楽）が大好きで日々の生活で大事に楽しんでいます。\nよく一緒にお互いの家に泊まってゆっくり時間を過ごしたりおでかけしたりして思い出作りしたりしています。\n\n◆キャラクターの説明\n砂ヶ原 章近(さがはら ふみちか)\n男/183cm/22歳/焦げ茶色の髪、茶色の瞳/11月1日生まれ\n街の小さな洋菓子店に勤めるパティシエ。\n花、読書、テディベアが好きな穏やかで繊細な性格。\n料理が得意でよく作るのは和食と洋食とスイーツ。\n左目の下にホクロがる。\n\n\n藤任 満(ふじとう みのる)\n男/168cm/22歳/黒色の髪、琥珀色の瞳/10月9日生まれ\n駆け出しのシンガーソングライター。アコースティックギターでの演奏と歌が中心。\n『フジ』のアーティスト名前で音楽の投稿や、路上での弾き語りなどで活動している。\nまた、楽器店でアルバイトもしている。\n明るくカラッとした性格。正義感が強い。\n趣味は音楽鑑賞(全般)、甘いものやカレー、ハンバーグといった料理が好きな子供舌。\n\n\n◆二人の思い出深い場所\nお互いの自宅アパートのリビング(雑談したり藤任が砂ヶ原にギターを弾いて聞かせたり。泊まり合いはよくする)・キッチン、海、満天の星、お花畑、二人でよく行くカフェ、クリスマスマーケット\n\n恐縮ですがポーズや構図などはAg様にお任せとさせてください。\n\n\nご検討のほどよろしくお願いいたします。\nAg様の創作活動とシナリオ制作が素敵なものになりますように。\n\nhttps://drive.google.com/drive/folders/1brloGL78M2Ru-tEAeqR9Vs4CU6gQfgI9?usp=sharing", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@tewoawasete/works/8", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1880982, "client_id": 3322553, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/09e18bda/uploads/origins/c8d5e408-20d1-4e5b-a932-24a1f5490976?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=de3b11cbf02e3bd6eb84885108e100c4", "srcset": "https://si.imgix.net/09e18bda/uploads/origins/c8d5e408-20d1-4e5b-a932-24a1f5490976?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=de3b11cbf02e3bd6eb84885108e100c4, https://si.imgix.net/09e18bda/uploads/origins/c8d5e408-20d1-4e5b-a932-24a1f5490976?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=4ae1d87d1d080b1438602d128a131dba 2x, https://si.imgix.net/09e18bda/uploads/origins/c8d5e408-20d1-4e5b-a932-24a1f5490976?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=1bcdba15fba22e95199f4acdbbf2c3cb 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/09e18bda/uploads/origins/c8d5e408-20d1-4e5b-a932-24a1f5490976?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a515e9f7a203edac6e2e4230cea41b15", "srcset": "https://si.imgix.net/09e18bda/uploads/origins/c8d5e408-20d1-4e5b-a932-24a1f5490976?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a515e9f7a203edac6e2e4230cea41b15, https://si.imgix.net/09e18bda/uploads/origins/c8d5e408-20d1-4e5b-a932-24a1f5490976?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=44ccd17b05b3078e690b15bb86c490a3 2x, https://si.imgix.net/09e18bda/uploads/origins/c8d5e408-20d1-4e5b-a932-24a1f5490976?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=3032963bc59d267d27e5ca48562608e9 3x"}, "body": "銀食器さんこんにちは。はるのと申します。\n\n夏ということで、ライラ自陣の夏らしい一枚絵を依頼させていただきたいです。\n\n月がしやSara、SN1572を回しましたが、銀食器さんの書かれる海辺のシナリオがとても好きで、いつも楽しく遊ばせていただいております。\n素敵なシナリオを公開していただきありがとうございました。\nこれからも陰ながら応援しています。\n\n[資料]\nhttps://x.com/uoxou_mepu/status/1753814771001106803?s=46&t=n0E7GrSmOniaXJ2hb1HIpA\n\nhttps://x.com/uoxou_mepu/status/1753995483058679901?s=46&t=n0E7GrSmOniaXJ2hb1HIpA\n\nhttps://x.com/uoxou_mepu/status/1812325742912700782?s=46&t=n0E7GrSmOniaXJ2hb1HIpA", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@tewoawasete/works/7", "priva