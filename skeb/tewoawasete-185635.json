5\u307f\u3061\u304b)\n\u7537/183cm/22\u6b73/\u7126\u3052\u8336\u8272\u306e\u9aea\u3001\u8336\u8272\u306e\u77b3/11\u67081\u65e5\u751f\u307e\u308c\n\u8857\u306e\u5c0f\u3055\u306a\u6d0b\u83d3\u5b50\u5e97\u306b\u52e4\u3081\u308b\u30d1\u30c6\u30a3\u30b7\u30a8\u3002\n\u82b1\u3001\u8aad\u66f8\u3001\u30c6\u30c7\u30a3\u30d9\u30a2\u304c\u597d\u304d\u306a\u7a4f\u3084\u304b\u3067\u7e4a\u7d30\u306a\u6027\u683c\u3002\n\u6599\u7406\u304c\u5f97\u610f\u3067\u3088\u304f\u4f5c\u308b\u306e\u306f\u548c\u98df\u3068\u6d0b\u98df\u3068\u30b9\u30a4\u30fc\u30c4\u3002\n\u5de6\u76ee\u306e\u4e0b\u306b\u30db\u30af\u30ed\u304c\u308b\u3002\n\n\n\u85e4\u4efb \u6e80(\u3075\u3058\u3068\u3046 \u307f\u306e\u308b)\n\u7537/168cm/22\u6b73/\u9ed2\u8272\u306e\u9aea\u3001\u7425\u73c0\u8272\u306e\u77b3/10\u67089\u65e5\u751f\u307e\u308c\n\u99c6\u3051\u51fa\u3057\u306e\u30b7\u30f3\u30ac\u30fc\u30bd\u30f3\u30b0\u30e9\u30a4\u30bf\u30fc\u3002\u30a2\u30b3\u30fc\u30b9\u30c6\u30a3\u30c3\u30af\u30ae\u30bf\u30fc\u3067\u306e\u6f14\u594f\u3068\u6b4c\u304c\u4e2d\u5fc3\u3002\n\u300e\u30d5\u30b8\u300f\u306e\u30a2\u30fc\u30c6\u30a3\u30b9\u30c8\u540d\u524d\u3067\u97f3\u697d\u306e\u6295\u7a3f\u3084\u3001\u8def\u4e0a\u3067\u306e\u5f3e\u304d\u8a9e\u308a\u306a\u3069\u3067\u6d3b\u52d5\u3057\u3066\u3044\u308b\u3002\n\u307e\u305f\u3001\u697d\u5668\u5e97\u3067\u30a2\u30eb\u30d0\u30a4\u30c8\u3082\u3057\u3066\u3044\u308b\u3002\n\u660e\u308b\u304f\u30ab\u30e9\u30c3\u3068\u3057\u305f\u6027\u683c\u3002\u6b63\u7fa9\u611f\u304c\u5f37\u3044\u3002\n\u8da3\u5473\u306f\u97f3\u697d\u9451\u8cde(\u5168\u822c)\u3001\u7518\u3044\u3082\u306e\u3084\u30ab\u30ec\u30fc\u3001\u30cf\u30f3\u30d0\u30fc\u30b0\u3068\u3044\u3063\u305f\u6599\u7406\u304c\u597d\u304d\u306a\u5b50\u4f9b\u820c\u3002\n\n\n\u25c6\u4e8c\u4eba\u306e\u601d\u3044\u51fa\u6df1\u3044\u5834\u6240\n\u304a\u4e92\u3044\u306e\u81ea\u5b85\u30a2\u30d1\u30fc\u30c8\u306e\u30ea\u30d3\u30f3\u30b0(\u96d1\u8ac7\u3057\u305f\u308a\u85e4\u4efb\u304c\u7802\u30f6\u539f\u306b\u30ae\u30bf\u30fc\u3092\u5f3e\u3044\