て頂きます。\n\nkobakobaさんの作品は魅力的で個人的にとても好きな作風なのに加え、自分の好きなVTuberさんのイラストも描かれていてファンになりました。\n\n作品はTwitterのdiscord等のアイコンに使用したいと考えています。また、使用する際はお名前を必ず記載させて頂きます。\n\n今回は女の子でお願いします。\n髪色は白〜薄いベージュくらいでインナーカラーや毛先は深緑色、イメージカラーは黒と緑でかっこよさ7可愛さ3くらいのイメージでお願いします。それ以外は全ておまかせします。\n\n宛名のあるものと無いものがあるととてもありがたいです。\n\n改めてご検討のほどよろしくお願い致します。", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@kobakoba0_0/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1319019, "client_id": 207927, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/96885f46/uploads/origins/04ab1e6b-3f94-4f24-8142-635a48f2e725?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=eccdd1c171634727b6615cc87c6046e2", "srcset": "https://si.imgix.net/96885f46/uploads/origins/04ab1e6b-3f94-4f24-8142-635a48f2e725?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=eccdd1c171634727b6615cc87c6046e2, https://si.imgix.net/96885f46/uploads/origins/04ab1e6b-3f94-4f24-8142-635a48f2e725?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=0a238953c2e590ef3d18170f3ef86530 2x, https://si.imgix.net/96885f46/uploads/origins/04ab1e6b-3f94-4f24-8142-635a48f2e725?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=3f47e0af17aa8875ccdd295a4ab361f1 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/96885f46/uploads/origins/04ab1e6b-3f94-4f24-8142-635a48f2e725?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e45a4081a1f5fe67ea56ba30d1c54f1e", "srcset": "https://si.imgix.net/96885f46/uploads/origins/04ab1e6b-3f94-4f24-8142-635a48f2e725?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e45a4081a1f5fe67ea56ba30d1c54f1e, https://si.imgix.net/96885f46/uploads/origins/04ab1e6b-3f94-4f24-8142-635a48f2e725?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=ec0f5a80ebe62a8d3e1724fb6f44d3c9 2x, https://si.imgix.net/96885f46/uploads/origins/04ab1e6b-3f94-4f24-8142-635a48f2e725?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=9a56ca7d5150e6da35a211bde4a6e571 3x"}, "body": "kobakobaさんこんにちは。\nこりすと申します。\n優しい色や雰囲気の女の子のイラストに惹かれてリクエストお送りいたしました！\n\n熊の女の子を描いてほしいです。\nはちみつが大好きで、手や顔につけつつも微笑みかける少し幼めのケモ耳少女。\n\n作品はYoutubeのサムネに使用したいと考えています。\nファイル形式はpngだと嬉しいです！\nよろしくお願いいたします。", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@kobakoba0_0/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1319019, "client_id": 1809157, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/b7b683bf/uploads/origins/e5808ce6-271a-4e28-a09b-5830df16a89e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=681b615ea16deb627cd3507e566d42c3", "srcset": "https://si.imgix.net/b7b683bf/uploads/origins/e5808ce6-271a-4e28-a09b-5830df16a89e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=681b615ea16deb627cd3507e566d42c3, https://si.imgix.net/b7b683bf/uploads/origins/e5808ce6-271a-4e28-a09b-5830df16a89e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b8a807d4f6f8df9f6c6e04b27bcd3c19 2x, https://si.imgix.net/b7b683bf/uploads/origins/e5808ce6-271a-4e28-a09b-5830df16a89e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=fddae16a487c37e3e0c0ba03f38090de 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/b7b683bf/uploads/origins/e5808ce6-271a-4e28-a09b-5830df16a89e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=aa644ad49f3107bb6c1c33d5d4b952e1", "srcset": "https://si.imgix.net/b7b683bf/uploads/origins/e5808ce6-271a-