4fa4-a50a-74540903fd72?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e99c0b0c3e676e0b82acdad8146073d3", "src_set": ""}, "body": "初めまして。リクエスト失礼します。\nFGOよりマリーアントワネットをお願いします。\n\n爆乳･爆根ふたなりに改造されたマリーが偽牝台でオナニーをして巨大精子をぶちまけながら射精する。\nというシチュエーションをお願いします。\n\n恰好は牛コスのような恰好でお願いします。\n\nご検討の程よろしくお願いします。", "nc": 160, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@takaki_555/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2961612, "client_id": 741655, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/fbf174b9/uploads/origins/60362259-3517-4fc1-9213-055ecbe8e690?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f52b1cb967fa985fb24ded2323227bcd", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/fbf174b9/uploads/origins/60362259-3517-4fc1-9213-055ecbe8e690?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=196b8ef96be5008f56eaa6b2fc527b5c", "src_set": ""}, "body": "私はあなたのふたなりイラストのファンです。オリジナルのふたなりキャラをお願いしたいです。全裸です。幸せそうな表情。黒髪に真っ青な瞳。\n肌色。↓\nhttps://www.pixiv.net/en/artworks/114698878\n\n構図、体型、ペニスと睾丸のサイズ。おっぱいのサイズ。↓\nhttps://www.pixiv.net/en/artworks/115448814\n\n髪型。↓\nwww.pixiv.net/artworks/98047478\n\n目(2ページ目)↓\nhttps://www.pixiv.net/en/artworks/116022273\n\nよろしくお願いします。", "nc": 49, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@takaki_555/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2961612, "client_id": 1366155, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/fa699575/uploads/origins/fddb91ec-14e4-4fbb-b4c6-c076a9de5964?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=07a82ef440d62f5aca0ea50136825baf", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/fa699575/uploads/origins/fddb91ec-14e4-4fbb-b4c6-c076a9de5964?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=130fd89fa549bfb76b6d18fe462ca497", "src_set": ""}, "body": "魔法カード《洗脳ーブレインコントロール》で感度3000倍オナペット化変態洗脳され、淫語連発オナサポバイブ咥え込みガニ股腰ヘコデカパイ揺らしで絶頂失神する遊戯王のRAI-MEIをリクエストします。\n\n洗脳シーン→バイブ挿入軽イキ→全力腰ヘコ乳揺らし+オナニー促進淫語連発絶叫→白目剥きアへ顔アクメ\n…といった4シーンの差分をお願いします。\n\n服装はカードのイラストと同じ物をベースに1枚目のみ完全着衣、2枚目以降は股間と胸部先端がハート型に切り取られ、バイブ挿入及びパフィーニップル気味で大きめサイズの乳首と乳輪が完全に露出している状態でお願いします。\n\n乳のサイズは顔より大きく臍の少し上まで届き上半身が隠れるような位の大きさで、RAI-MEI単体の股下までを竿役の一人称視点で正面寄りから見た姿を写して欲しいです。\n\nまた、各シーンに合わせたRAI-MEIのセリフのテキストを付けて下さい。キャラクター像はたかきさんのイメージでお好きなように書いて頂ければ幸いです。\n\n細かい指示が多くて申し訳ありませんがどうかよろしくお願いします！\n\nhttps://drive.google.com/drive/folders/1jUv87DsnPJO7pNY_UW8SRfyrto7lmJwm", "nc": 40, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@takaki_555/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2961612, "client_id": 0, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/1cdbc9d3/uploads/origins/b5e6283f-518a-494d-ae60-e5b253d2e87b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0f19c7c0698aaf9d5c18b360ff72b3d6", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/1cdbc9d3/uploads/origins/b5e6283f-518a-494d-ae60-e5b253d2e87b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=61f716b4f3bc449d63516a796034eba8", "src_set": ""}, "body": "先生、はじめまして！\nふたなり×男のコンテンツはよろしいでしょうか?\nゲーム\"じゃんたま\"のキャラ　セイランのふたなり×男の絵をお願いします。\nセイランはふたなり爆根爆玉を生えた、サイズは先生の以前の作品のキャラよりでかいでも良いです。彼女は参考リンク中の服を着用。男のチンポは小さい、他の要件はいない。\nストーリーは、男はフル勃起姿のセイランをセクハラする。セイランの表情は冷たく、怒りっぽい。同じ時に、セイランは大量射精中。\nこのあと、男性のお尻がセイランにアナルファックされています。セイランはまるで杭打ち機のように激しく何度も打ち付ける、超大量射精。男は口もアナルも吐精された。セイランの表情はドSな感じ、男に対しては無関心。\nチンポ挿入の断面図をお願いします。\nよろしければ台詞をお願いします。\nありがとうございました！\n服の参考:\nhttps://twitter.com/MahjongSoul_JP/status/1749990405150736402\nhttps://twitter.com/MahjongSoul_JP/status/1749994180745572673\nキャラ設定と台詞の参考:\nhttps://mahjongsoul.club/content/%E9%9D%92%E9%B8%9E", "nc": 176, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@takaki_555/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2961612, "client_id": 0, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/1a77d72c/uploads/origins/013101f9-438f-4341-a10b-17be408e8c44?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4c5a2c510cf0172a819a3430aecb7c3d", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/1a77d72c/uploads/origins/013101f9-438f-4341-a10b-17be408e8c44?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ca1b3530503d279cdcf6843f59018ae7", "src_set": ""}, "body": "Z/Xより、着衣セルフパイズリで股間のビッグマグナム♂の試し撃ちをするアゲハをお願いします。\n「ゾンビ娘的なアンデッドだったアゲハが、不思議な高級化粧水の効能で美肌と若さを取り戻して今の姿になって、満ち溢れる活力に任せて服や体が汚れるのも構わずに本気オナニーする」みたいな感じです。\n\nhttps://twitter.com/zxtcg/status/1540984911167094784\nhttps://twitter.com/zxtcg/status/1625691493628547072\nhttps://twitter.com/zxtcg/status/1710218345897939152", "nc": 48, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}], "similar_creators": [{"id": 8418, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "九尾🍆", "screen_name": "cube1139", "avatar_url": "https://pbs.twimg.com/profile_images/1930476750796140552/FjpZQ4IP.jpg", "header_url": "https://pbs.twimg.com/profile_banners/2548346515/1491922636/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "