: "https://pbs.twimg.com/profile_banners/1213406486157656064/1745145093/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "skills": [{"genre": "art"}, {"genre": "correction"}], "nc": 48}, {"id": 2606481, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "mariyo🐇💘💦🌕🌟🌙🍼🐄🍼🫧🐺📣🍌🩶🩵", "screen_name": "mariyo_siki", "avatar_url": "https://pbs.twimg.com/profile_images/1948714626184876033/_qn4aCYK.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1437802605283999744/1707296730/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 10, "skills": [{"genre": "art"}], "nc": 48}]}, "price_history": {"art": [{"amount": 6000, "recorded_at": "2025-10-18T12:40:30.525635"}], "comic": [{"amount": 7000, "recorded_at": "2025-10-18T12:40:30.525635"}]}, "works": [{"path": "/@takaki_555/works/12", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2961612, "client_id": 1366155, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/3db714a6/uploads/origins/72e8bf12-5907-4fae-b06b-293154e5c1fc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3b0011cfadd874f0dc6ff2656054bbe4", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/3db714a6/uploads/origins/72e8bf12-5907-4fae-b06b-293154e5c1fc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d74976696ee1f64ced87f34535b78733", "src_set": ""}, "body": "遊戯王のRAI-MEIとサイバー・チュチュボンのコンビがフタナリの宣告者の神巫とワルキューレ・セクストにハメ潰されるイラストをリクエストさせて頂きます\n\n受け:RAI-MEI&チュチュボン。生えてない。全身むちむちで乳のサイズは頭より大きく上半身を目一杯覆い、股間がギリギリ見えるくらいの超乳(可能な限り盛って下さい)\n\n攻め：神巫&セクスト。身長低め巨乳で腹ボコ余裕そうな巨根付き。\n\n服装は全員元のカードのイラストで着ている物で、神巫の紫のスカートのみ脱がす。受け側は股間が♡型の穴空きで勃起した乳首と盛り上がった乳輪が布越しにくっきり浮かび上がっており、攻め側は陰茎が前垂れを持ち上げて露出した状態です。\n\n体位は正面が良く見えるアングルでの正常位で受け二人が横並び、攻め側の様子はバストアップのワイプを受け二人の顔の横に別枠で写すようお願いします。\n\n挿入前。攻め側が挿入を焦らし、受け側は完全に堕ちきった様子で媚びながら挿入を懇願する。\n↓\n挿入時。攻め側がSッ気のある表情で一気に挿入し、受け側はその衝撃で間抜けな叫び声を上げ即堕ちアへ顔アクメを晒す。\n↓\n挿入後。激しくピストンしながら全員軽めのアへ顔でオホ声混じりの淫語を連発しよがっている。\n↓\n膣内射精&絶頂。全員汚い口調で淫語を絶叫しながらイき、白目を剥いたここ一番の変顔に片足突っ込んだアへ顔になる。\n精子が卵子に受精するカットインあり。\n\n…という流れで、それぞれに二人のセリフを付けて頂きたいです。\nキャラの性格や口調はRAI-MEIがくっ殺の似合う隠れマゾなお姉さん。チュチュボンは明るく元気に受け入れてくれるバブみを感じさせるお姉さん。攻め二人は普段は真面目だが性欲に負けて盛りが付き、オラついた生意気なガキ、といったイメージです。\n\n細かく指定してしまいましたが何卒宜しくお願い致します。\n\nhttps://drive.google.com/drive/folders/1RxErfHKIlZ2Wtir4kvfPIw3cxECBO84j", "nc": 40, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@takaki_555/works/11", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/fccb62dd/uploads/origins/70e81e50-e981-41de-8080-28963e95c029?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=19347bca25a0120cae477a7c780e297a", "src_set": ""}, "private": true, "genre": "art", "tipped": true, "creator_id": 2961612, "client_id": 370553, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 177, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@takaki_555/works/10", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2961612, "client_id": 659796, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/3d65ad33/uploads/origins/1cacf686-d385-4fce-ab5c-cd295392df2b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b1b48bb96602cc590e9483d47809cee9", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_i