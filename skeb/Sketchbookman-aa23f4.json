f-4980-b0ab-f0d19a33df84?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=06665bb1f9aecbcbfde2fdcf5a122664, https://si.imgix.net/e39e08a9/uploads/origins/04906b18-944f-4980-b0ab-f0d19a33df84?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=32a7975f3727ed65880120ca6ea030cf 2x, https://si.imgix.net/e39e08a9/uploads/origins/04906b18-944f-4980-b0ab-f0d19a33df84?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=c9acac15246cf52e9061a3a23f3b4380 3x"}, "body": "インディーゲームシリーズ『*Freedom Planet*』に登場するサッシュ・ライラックのイラストを依頼したいです。https://imgur.com/a/e3juyUv I\n\n彼女は、いつも友達を助けようと熱意あふれる英雄的なキャラクターです。誰かが困っているのを見かけたら、ためらうことなく助けに駆けつけます。上の画像よりも胸と太ももを強調して、このかわいい衣装を着せた姿にしてほしいです。https://imgur.com/a/oEzWats", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Sketchbookman/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1796169, "client_id": 1960223, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/47e03e12/uploads/origins/122cb810-9ec2-4b78-ae41-91fc44eccbd9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4332e8ff2086b4b5b3d9027d3ea48c46", "srcset": "https://si.imgix.net/47e03e12/uploads/origins/122cb810-9ec2-4b78-ae41-91fc44eccbd9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4332e8ff2086b4b5b3d9027d3ea48c46, https://si.imgix.net/47e03e12/uploads/origins/122cb810-9ec2-4b78-ae41-91fc44eccbd9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=879a4103cc9651f28cf4d293d47c143f 2x, https://si.imgix.net/47e03e12/uploads/origins/122cb810-9ec2-4b78-ae41-91fc44eccbd9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=7732526f7967c14c433c81ef6c989506 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/47e03e12/uploads/origins/122cb810-9ec2-4b78-ae41-91fc44eccbd9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ea160973d07ac36508e293194b23d80d", "srcset": "https://si.imgix.net/47e03e12/uploads/origins/122cb810-9ec2-4b78-ae41-91fc44eccbd9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ea160973d07ac36508e293194b23d80d, https://si.imgix.net/47e03e12/uploads/origins/122cb810-9ec2-4b78-ae41-91fc44eccbd9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=1224eb46d8a4da4dc5f43048b5096790 2x, https://si.imgix.net/47e03e12/uploads/origins/122cb810-9ec2-4b78-ae41-91fc44eccbd9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=fd05eb343a7b8623eace63a558593fda 3x"}, "body": "初めまして、スケッチブックさん。\nFGOでご依頼を掛けられそうな方を探してた所、スケッチブックさんのことを見つけさせて頂きました。\nもしろよろしければFGOから、「清少納言ちゃん」に「セミラミスの最終再臨の衣装をコスプレ」をさせたイラストをお願いできるでしょうか……！？\n\n細かいディティールにつきましては、フィギュアの写真にてご確認いただければと存じます。\nhttps://www.goodsmile.info/ja/product/10713/%E3%82%A2%E3%82%B5%E3%82%B7%E3%83%B3+%E3%82%BB%E3%83%9F%E3%83%A9%E3%83%9F%E3%82%B9.html\n\n個人的にハマってしまった謎の組み合わせのため、ご理解に苦しむお題は百も承知ながら、それでもなぎこちゃんに着せることにハマってしまいましたゆえ、まずそこはご容赦頂きたく……。（厳か衣装と明るいキャラの着こなしのギャップ感とかが良くて……）\n\nその上で、スケッチブックさんは、メインこそよう実の畑の方と見受けましたものの、FGOも現役プレイ中のご様子。更には、お肌を見せる構図の、躍動感ある胸の描写の卓越したお手前を見込みまして、自分が好きなセミ様の最終再臨ドレスを、明るく元気ななぎこちゃんに着せるという組み合わせを手掛けて頂けたならば、どんな極上の仕上がりになるかと期待を寄せ、ご依頼させて頂ければと思った次第です！\n\n一応、コスプレ（衣装）がメインとなりますので、なるべくならの範疇で十分ですが、全身が収まるような構図で、衣装姿のほどをご堪能させて頂ければ特に嬉しく思います……！\nまた、清少納言ちゃんの髪は第一再臨のもの（青・赤・黒のマーブルのやつ）を希望いたしますが、もっとセンスを光らせる直感が下りてくださったのなら、その限りではなくてもOKです。\n\n色んな意味で相当難易度が高いお題とは存じますが、それでもスケッチブックさんの躍動感ある構図力、お肌の魅惑の魅せ方、また衣装の艶テカがとても美味しい質感表現、そして明るく可愛さ溢れる表情を描く力などなど……その全てに期待を込めた上で、お手を振るって頂ければありがたく存じます。\nよろしければ、何卒よろしくお願いいたします……！\n\nhttps://www.pixiv.net/artworks/88419852", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 1688710, "creator"