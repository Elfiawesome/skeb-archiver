-bd91-c02d3118d2cf?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3e12a597ccbc9a26d6d29d0a0a3f7431", "srcset": "https://si.imgix.net/859c1a2e/uploads/origins/d30da394-b3fc-4a28-bd91-c02d3118d2cf?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3e12a597ccbc9a26d6d29d0a0a3f7431, https://si.imgix.net/859c1a2e/uploads/origins/d30da394-b3fc-4a28-bd91-c02d3118d2cf?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a8096ec05855283b2654c7d2a857f45b 2x, https://si.imgix.net/859c1a2e/uploads/origins/d30da394-b3fc-4a28-bd91-c02d3118d2cf?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f8d3365e828323f5cf5293d39f99c6aa 3x"}, "duration": null, "nsfw": true, "hardcore": true, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/859c1a2e/uploads/origins/d30da394-b3fc-4a28-bd91-c02d3118d2cf?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f084066fce1c0a20dfc2bbb44aef1b6f", "srcset": "https://si.imgix.net/859c1a2e/uploads/origins/d30da394-b3fc-4a28-bd91-c02d3118d2cf?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f084066fce1c0a20dfc2bbb44aef1b6f, https://si.imgix.net/859c1a2e/uploads/origins/d30da394-b3fc-4a28-bd91-c02d3118d2cf?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=701ec8b85eaadc839030e4f943d2e2db 2x, https://si.imgix.net/859c1a2e/uploads/origins/d30da394-b3fc-4a28-bd91-c02d3118d2cf?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=bf517adb481aad93711e0665b2434316 3x"}, "body": "みよぴゐ様　初めましてです！ \n\n作品名：閃の軌跡2 \n\nキャラ：アルティナ \n\n設定 \n\n洗脳装置で機械姦 \n\n構図 \n\n・全体イメージ(参考１) \n\n・培養装置に入れられている(参考１・２) \n\n・四肢を拘束\n※拘束位置：両腕が手首まで天井に埋まって肘を曲げて拘束(参考１・２)\n両足が膝上まで機械に埋まって拘束(参考１)\n※天井と腕、床と足の境目に機械製の拘束具 \n\n・洗脳装置(頭)\n①洗脳バイザー(参考３)\n※同じデザイン\n※厚さは厚め(参考３)\n※顔の輪郭に沿ってフィット(参考４)\n②後頭部装置(参考２) \n\n・酸素マスク(参考５) \n\n・乳首注射機械(薬剤入カートリッジ付)＋爪付き搾乳器(参考１・２・５) \n\n・貞操帯装置(参考１・２)\n※(参考１・２)のような厚みがあって 同じ あるいは同じようなデザイン\n※機械の外側に機械製の太いコードが前後に1本ずつ、細いコードが数本、前側に媚薬入カートリッジ複数、機械の内側にバイブ (バイブ部分が貞操帯装置の外側に露出していないタイプ)\n※貞操帯装置上部の左右斜め上に拘束バンド&差し込み口、左右斜め上に腰に引っ掛けて固定(参考６) \n\n・カメラ視点、角度、ズーム具合、培養槽のデザイン、角度、サイズ感、狭さ、姿勢、ポーズ等　(参考１・２)と同じ \n\n・髪は下ろしている \n\n・全裸 \n\n・淫紋 \n\n・つるぺた、無乳、３Dモデルくらいの幼さ \n\n可能でしたら(差分) \n\n・背景(実験施設内) \n\n・培養装置の培養液(有、無) \n\n・培養装置前ガラス部分にSFゲートデザインの機械製シャッター(開、閉)(参考７～１０) \n\n・培養装置内(アルティナ有、無) \n\n・姿勢(通常ver【参考１】、腰を突き出しているver) \n\n・表情(眠り、虚ろ目【無表情】、快楽苦【歯くいしばり】、快楽悶え、快楽喘ぎ【目と口大開】、トロ顔、アヘ顔、絶頂【目と口大開、歯くいしばり】、快楽堕ち、悪堕ち 等) \n\n・洗脳バイザー(有【透過、無透過】、無) \n\n・酸素マスク(有、無) \n\n・注射機械搾乳器(有、無) \n\n・乳首(通常、ピンと立っている) \n\n・貞操帯装置装着(直前、途中【半分挿入】、後) \n\n・貞操帯拘束バンド(有、無) \n\n・淫紋(有、無) \n\n※各差分毎、姿勢・表情・各洗脳装置などの各レイヤーを自由に切り替え出来ると嬉しいです\n\nhttps://drive.google.com/folderview?id=1dCTXlD3OzsjgOfId3w78-qKnR6lR-b8L", "nc": 171, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@miyopi7/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1315084, "client_id": 764940, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/9f68524f/uploads/origins/b313d449-070a-4ca0-8e0e-c19302a287b9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=453681f706d88becc8a083a7e452f402", "srcset": "https://si.imgix.net/9f68524f/uploads/origins/b313d449-070a-4ca0-8e0e-c19302a287b9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=453681f706d88becc8a083a7e452f402, https://si.imgix.net/9f68524f/uploads/origins/b313d449-070a-4ca0-8e0e-c19302a287b9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=3230c810f56733c9c8340e678fa0e3ca 2x, https://si.imgix.net/9f68524f/uploads/origins/b313d449-070a-4ca0-8e0e-c19302a287b9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e7fdd9f195d416923bfff016876a11c8 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "http