さに朦朧としながらお互い励ましあいながら歩いている場面を描いて頂きますようお願いします。\n\n〇その他\n・用途は個人観賞用です。\n・極力全身を描いて頂きますようお願いします。\n\n今回は以上となります。どうかよろしくお願いいたします。", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 1824070, "creator": true, "nsfw_acceptable": false, "acceptable": false, "name": "黒木シゲヲ@再就職しました", "screen_name": "kuroki_shigewo", "avatar_url": "https://pbs.twimg.com/profile_images/1770244504358100992/Q2ZoBnAU.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1170553886022590472/1720701293/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 3, "complete_expiration_days": 120, "skills": [{"genre": "art"}, {"genre": "comic"}], "banned": false, "nc": 145}, {"id": 2160793, "creator": true, "nsfw_acceptable": false, "acceptable": false, "name": "かたお。", "screen_name": "Tukaimasen", "avatar_url": "https://pbs.twimg.com/profile_images/1912847387510607872/wRsM2zlh.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1312344619598770176/1690742296/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "art"}, {"genre": "comic"}, {"genre": "video"}], "banned": false, "nc": 144}, {"id": 2980168, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "&ɴᴋᴅ", "screen_name": "and8NKD", "avatar_url": "https://pbs.twimg.com/profile_images/1764984002614788096/LpmgwX71.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1700954066543902720/1700040282/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_