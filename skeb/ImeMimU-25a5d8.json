goDX1414/works/104", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 583942, "client_id": 550484, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/a301b9da/uploads/origins/99bca3c1-2d66-4126-80bc-98bd0063d85b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=074cbb269e13834a7ed157f126e8fe34", "srcset": "https://si.imgix.net/a301b9da/uploads/origins/99bca3c1-2d66-4126-80bc-98bd0063d85b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=074cbb269e13834a7ed157f126e8fe34, https://si.imgix.net/a301b9da/uploads/origins/99bca3c1-2d66-4126-80bc-98bd0063d85b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=309a236f16136069df4bb6792e069880 2x, https://si.imgix.net/a301b9da/uploads/origins/99bca3c1-2d66-4126-80bc-98bd0063d85b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a320163b5d23202fbf89c3633aff0a45 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/a301b9da/uploads/origins/99bca3c1-2d66-4126-80bc-98bd0063d85b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=de11f03fdcda58b06b333d495e7d5657", "srcset": "https://si.imgix.net/a301b9da/uploads/origins/99bca3c1-2d66-4126-80bc-98bd0063d85b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=de11f03fdcda58b06b333d495e7d5657, https://si.imgix.net/a301b9da/uploads/origins/99bca3c1-2d66-4126-80bc-98bd0063d85b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=4c0a0a1dcff3a47cd0e2e5a71dbc1620 2x, https://si.imgix.net/a301b9da/uploads/origins/99bca3c1-2d66-4126-80bc-98bd0063d85b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=50cc806353a6ecc9a2abb76c8172e6c1 3x"}, "body": "あんどう様はじめまして！\n1月、今年初の卓としてサイレン清掃会社をHO2にて通過させていただきました！\nいままでずっと導入だったんですか！？！？！？！？！？なシナリオ展開、ゲームの世界で大暴れするPCたち、握ったハンドアウト、世界観、NPC等あまりにも好みすぎて卓中ずっと嬉しすぎて笑顔になりまくり卓初めがこんな優勝シナリオで本当にいいんですか？？？？とずっとデカ喜びボイスを出し通過していました。やったー！通常攻撃が2回攻撃だ〜！！！！！！！\nそして無事エンド1でクリアし、大優勝しました。本当に嬉しい。\nそんなこんなでKPとも色々やりとりをする中、偶造神環絶対全部通過する。というガチ決意を抱きました。絶対全部PL通過したい！！！！\nそしてサイレンも、いつか回る他の偶造神環も回して全員めちゃくちゃになっていただこうかな。と思っています。偶造神環を、サイレン清掃を生み出してくれて、本当にありがとうございます。\n\nサイレン清掃のNPCでは特に藍が大好きです。上大に顔が似てて、可愛い。血が水より濃い。最高。\n趣味:ツルツルの泥団子作り←おい、可愛すぎる────\n無理やり大人になるしかなかった子供。←良すぎる！！！！！！！\nと言った調子で、藍の情報をふせったー等で見ては大いに狂わせていただいております。ありがとうございます。流石に愛しすぎる。度々マシュマロの返答でのふせったーを見ては、藍‼️‼️‼️これ以上萌え萌えになるのはやめろ‼️‼️‼️とサイレン用の鍵垢で大泣きしています。本当に大好き。これからも強く生きてほしい。\n\n自PCはというと初対面から藍に対しては（HO2の割に）柔和で、まず話聞くか…ってスタンスでした。態度や言動からしても目的が一致している事や、導入後の一面を見るなどして藍に大いに感情移入していました。なんか計らずもおにショタみたいになって面白かったです。\nシナリオクリア後も仲良くしていて、HO2がご飯を作ってあげたり、訓練等に付き合ってあげたり、休憩所に備え付けられたお菓子を食いまくる藍を咎める目的で、お菓子を食いまくって夕飯が全然食えなさそうな日に限って肉料理を出す意地悪をしたりしています。\nただ、上大に関わる人への憎悪が未だ弊HO2の中では燻っているため、それが稀に剥き出しになって藍に詰め寄るなどして無茶を言うことがあったり、どうしても親子なため顔が上大に似ていることから、藍が無意識に高圧的な態度を取ったりする（それが思春期故の照れ隠し的態度であっても）と上大を思い出して殺意がまろび出てしまうなど、多少不安定な関係性ながらも楽しそうに接しています。\n\n恥ずかしながら私自身こういう二律背反を抱えたクソデカ情念の関係性（情念が一方的だとマジで嬉しい）がめちゃくちゃ大好きでして、こんな風にしていいか⁉️と言っても快く応じてくれたKPにも、藍という立場の人間がいることにも、本当に嬉しく、通過してからというもの毎日喜んでいます。\n\nということで前置きが超絶長くなってしまい恐縮なのですが、\n【弊HO2と藍のイラスト2枚程度】をリクエストさせていただきたいと思います。\nあんどうさんの絵で藍と自PCでこの光景が見たすぎるためです。\n\nシチュエーションの指定としては\n1枚目は、シナリオ内で上大を殺すことになる場面がありますが、これを藍と弊HO2が一緒に刀を握って殺している……という場面を書いていただきたいです。\n\nこちら、導入前に一度ふせったーでこれできねえかな…って思っていたのを、いざ殺せますよ、となったのでKPに\n「藍と一緒に（復讐）やっていいですか。どうしてもやりたい。頼む。」とお願いしたところ、これまた大変快く受けてくれて、KPの最高・RPと共に藍と文字通り一緒に復讐を果たさせていただいた個人的に最も思い出深いシーンなので、どうしてもこのシーンが、見たくて………！！\nシナリオ内の描写なのでそちらが難しければ、殺す相手や場所はぼかしていただいて大丈夫です。藍に殺人、復讐を唆し共犯する弊HO2があんどう様の絵でガチで見たいので、それだけでも構いません。\n\n2枚目は藍と弊HO2の日常的なワンシーンをお願いしたいです。藍にちょっとした意地悪をしている弊HO2みたいな感じの構図だととても嬉しいです。弊HO2の私服を描くなどの場合私服は特に決めていないのであんどう様の方で自由に決めていただいて構いません。\n\n資料等は下記にまとめておきます。\n\n■CS\nhttps://iachara.com/char/view/3787113\n■容姿、自陣の制服、RPの参考等資料\nhttps://drive.google.com/drive/folders/1-NyhRmEN5paboTbS1pjwB7F9uZP6jR8M\n\n備考:容姿について\nいつもはちゃんとツナギの上も羽織ってるけど仕事中は動きにくいため片方かどっちも脱ぐ\n別に返り血が好きではない（あくまで好きなのは人斬った時の感触）ので目立たないよう中は黒のタンクトップを着ている。刀も刀身含めて黒いものを好む。\n※刀のデザイン等もあまり決めてないので描く場合はお任せします。\nツナギは至近距離での戦闘のほか、無茶な動きをしたり、自傷上等の戦闘スタイルが特徴なため制服を幾度となく切ったり破いたりなどしており、その度にワッペンや刺繍を自作して傷を修繕（魔改造）している。\nワッペンや刺繡なども見えない位置はどこについてるか等はお任せします。\n身体の傷も全身に切り傷がありますが場所に指定などはないです。好きなように描いて頂いて構いません！\n\n\n以上になります！\nお忙しいこととは存じますが何卒よろしく申し上げます！また、まだまだ寒い日が続きますので、どうぞご自愛ください！", "nc": 153, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "similar_creators": [{"id": 1143777, "creator": true, "nsfw_acceptable": false, "acceptable": false, "name": "かぼ", "screen_name": "kabohell", "avatar_url": "https://pbs.twimg.com/profile_images/1494453391820353546/o2f2w50j.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1046794659370946561/1699199593/1500x500", "appeal_receivable": true, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 7, "complete_expiration_days": 60, "skills": [{"genre": "art"}, {"genre": "comic"}], "banned": false, "nc": 128}, {"id": 1453908, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "一期崎", "screen_name": "ichigojaki", "avatar_url": "https://pbs.twimg.com/profile_images/2065713426459168768/ZH9xBf8h.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1324219879906406401/1780843576/1500x500", "appeal_receivable": true, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 3, "complete_expiration_days": 80, "skills": [{"genre": "art"}, {"genre": "correction"}], "banned": false, "nc": 129}, {"id": 2169292, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "O2β💎✍🏻Skeb募集中", "screen_name": "SeekingOxygen", "avatar_url": "https://pbs.twimg.com/profile_images/2068276133230161920/mTVaqvEK.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1366971989039083524/17812589