75-a49b-fc7720345e6a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=518e1e3b6ab8dcde0f7d94b6ee9d2be1 2x, https://si.imgix.net/719d5623/uploads/origins/981cc0f4-3eaa-4975-a49b-fc7720345e6a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=60bdfe3ab3c0f1b538cbcafe8b251307 3x"}, "body": "こんにちは！\n\n私のdndキャラクターLilyと彼女のNPC Dawiのアートが欲しいです。\n\nリリーは身長2フィートで腕に包帯を巻いたフェイで、不器用で空気が読めない。\n\nダウィは身長1フィートのNPC妖精で、リリーが昔助けたことがあり、リリーの愚かな行動にも時々付き合ってくれます。\n\n参考ポーズとキャラクターリファレンスは下のリンクにあります！\n\nhttps://drive.google.com/drive/folders/1KoetO9K9VZj7RuoL0_9Yay3YBXFEs9A9?usp=sharing", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@NightMisting/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3136563, "client_id": 3178874, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/e1f932e8/uploads/origins/e5370df8-abb1-454a-82c9-5efae1bc8676?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a764e8727135a1fbba927e28d7773653", "srcset": "https://si.imgix.net/e1f932e8/uploads/origins/e5370df8-abb1-454a-82c9-5efae1bc8676?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a764e8727135a1fbba927e28d7773653, https://si.imgix.net/e1f932e8/uploads/origins/e5370df8-abb1-454a-82c9-5efae1bc8676?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a909f13d3da3906530d798770fab9fea 2x, https://si.imgix.net/e1f932e8/uploads/origins/e5370df8-abb1-454a-82c9-5efae1bc8676?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=94a164d70b8eb8cf5fa3058fb4fa1f71 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/e1f932e8/uploads/origins/e5370df8-abb1-454a-82c9-5efae1bc8676?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=