g=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=01f072f4cffc7d57e707aac0e9a36e34 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/55af5566/uploads/origins/9d4b3901-9d6d-43f9-9656-08ac2165c6fa?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=455f648d4f6335b545fc16ffa3af3ffc", "srcset": "https://si.imgix.net/55af5566/uploads/origins/9d4b3901-9d6d-43f9-9656-08ac2165c6fa?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=455f648d4f6335b545fc16ffa3af3ffc, https://si.imgix.net/55af5566/uploads/origins/9d4b3901-9d6d-43f9-9656-08ac2165c6fa?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=a6b97eb22c75f04ae2056b2e8564f899 2x, https://si.imgix.net/55af5566/uploads/origins/9d4b3901-9d6d-43f9-9656-08ac2165c6fa?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=80f1aec0a8511dce862b8c8e425baef0 3x"}, "body": "フジキ様\n初めまして、素敵な作品に惹かれ依頼させていただきました。\n私と相方のオリジナルキャラクターを描いていただきたくリクエストさせていただきます。\n怪盗と贋作家のペアで日中に作業、夜な夜な盗みのために動いている二人です。一つ屋根の下に住んで仕事がうまくいった日には酒盛りをする二人です。\n構図等々はお任せいたします。\n\n\n【内容】\n・赤髪の方　職業：怪盗\n172cm\n髪：赤　　瞳：右目水色、左目黄色のオッドアイ　　特徴：余裕のある笑顔\n周りにいる人にちょっとうるさく構う（小型犬）。贋作家ご飯の話とか世間話をしに行く。どこに家族がいるか分からないが、見つけるまでは近くにいる人が離れないようにうろちょろしている。どちらかというと素直。普通に生活していれば騙される側。\n\n・青髪の方　職業：贋作家\n182cm\n髪：青　　瞳：黒　　特徴：無表情、タバコ\nダウナー男。少し間延びした発声をし、禁煙室以外ではタバコを吸っているヘビースモーカー。贋作作りは作者への尊敬の念があれば問題ないと自身の中で折り合いをつけており、息をするように贋作を描いている。\n\n\n条件等々厳しい場合はキャンセルしていただいて構いません。\n何卒ご検討お願いいたします。\n\nhttps://www.dropbox.com/scl/fo/riund6r87ipfjlhkufait/AGfKtFeu2ed-N9GGH2S9Bo4?rlkey=wkdfu4yf23d9ims92brfpv5b3&st=e2a08f5j&dl=0", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@fjk_6F/works/9", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/7f7e45c8/uploads/origins/04e333b7-6ffe-474e-bfd0-f427f1032e90?bg=%23fff&auto=format%2Ccompress&fm=w