46943/uploads/origins/040ccc6c-d98f-458f-86af-d2cef01bb673?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=79ea737cbe7e1e6597d343611f1f7f14, https://si.imgix.net/99b46943/uploads/origins/040ccc6c-d98f-458f-86af-d2cef01bb673?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=41dcea7cd300750f4633822cd19608e0 2x, https://si.imgix.net/99b46943/uploads/origins/040ccc6c-d98f-458f-86af-d2cef01bb673?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d4d6b9fb98ae7c5c732de2ae78f179c1 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/99b46943/uploads/origins/040ccc6c-d98f-458f-86af-d2cef01bb673?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=62b11906f313a111e834fec089613605", "srcset": "https://si.imgix.net/99b46943/uploads/origins/040ccc6c-d98f-458f-86af-d2cef01bb673?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=62b11906f313a111e834fec089613605, https://si.imgix.net/99b46943/uploads/origins/040ccc6c-d98f-458f-86af-d2cef01bb673?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=217cd1d47cec6bbc616421aedcea1b5e 2x, https://si.imgix.net/99b46943/uploads/origins/040ccc6c-d98f-458f-86af-d2cef01bb673?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=1d833608651f02552b625b17305e76f6 3x"}, "body": "こんにちは！英語でのリクエストで申し訳ありません！\n\n女の子がお母さんにおむつを替えてもらっているシーンをリクエストしたいです。\n\n女の子：\n- 小学生高学年か中学生低学年。\n- テープオムツをしている。\n- ちょっと恥ずかしいけど、ママにお世話されるのも好き。\n\nおむつは\n- テープタイプで、大きめの子供用にデザインされており、たくさん濡れても大丈夫である。\n- 何度もおしっこをしているので、とても濡れている。\n\n母親とのやりとり：\n- 母親はとても親切で優しく、ちょっといじわるかもしれない。\n- 愛情をこめて娘を拭き、新しいおむつに替える。\n\n可能であれば、濡れたおむつを見せるためにショーツを脱がされる少女／おむつがほどかれ、脚を持ち上げながら体を拭かれる少女／新しいおむつを装着される少女のアルトと台詞をお願いしたい（ただし、やりすぎだったら変更／削除してください！）。\n\n全体的なトーンは甘く、愛情に満ちている。\n\n台詞は日本語でOK。\n\nありがとう！", "nc": 169, "word_count": 0, "transcoder": "i