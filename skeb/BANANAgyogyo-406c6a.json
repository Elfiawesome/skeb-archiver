le.com/drive/folders/1znnqCEGJR6aX3H7Dd0seQp9d9Xz3tFLT?usp=sharing )\n- キャラクター設定・背景： https://skeb.jp/@yuki_shiro/works/2\n\n選択はあなた次第です！\n詳細はあなたの腕に任せます。お好きなように描いてください！\n\nご検討いただきありがとうございます！\n翻訳が不十分な点、お詫び申し上げます。\n\nhttps://drive.google.com/drive/folders/1zIhdXn2U1Vs2xiK0xN1jlm9fTDzlF814?usp=sharing", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@BANANAgyogyo/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1478552, "client_id": 133419, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/fdbeba6a/uploads/origins/795ed76f-3d7c-4dec-9d2d-68d96eb639ca?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=37ed18998239e867c150b58e19fe7e78", "srcset": "https://si.imgix.net/fdbeba6a/uploads/origins/795ed76f-3d7c-4dec-9d2d-68d96eb639ca?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=37ed18998239e867c150b58e19fe7e78, https://si.imgix.net/fdbeba6a/uploads/origins/795ed76f-3d7c-4dec-9d2d-68d96eb639ca?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=17343a611109378a773a7674189570dd 2x, https://si.imgix.net/fdbeba6a/uploads/origins/795ed76f-3d7c-4dec-9d2d-68d96eb639ca?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=db34c958829c34bb524691d90d85836a 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/fdbeba6a/uploads/origins/795ed76f-3d7c-4dec-9d2d-68d96eb639ca?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=8941656a545e880b71e0a9d4190e4892", "srcset": "https://si.imgix.net/fdbeba6a/uploads/origins/795ed76f-3d7c-4dec-9d2d-68d96eb639ca?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=8941656a545e880b71e0a9d4190e4892, https://si.imgix.net/fdbeba6a/uploads/origins/795ed76f-3d7c-4dec-9d2d-68d96eb639ca?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=dc93bb02323cce4ba9d32b6be65fd42b 2x, https://si.imgix.net/fdbeba6a/uploads/origins/795ed76f-3d7c-4dec-9d2d-68d96eb639ca?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=75ec1ce0489c462ca7a9357029612a98 3x"}, "body": "こんにちは！！お元気ですか？ご依頼をいただきありがとうございます。あなたのギャラリーを拝見しましたが、様々な効果やセンスを表現する才能に溢れていると確信しました。私のオリジナルキャラクター、SF鬼戦士タマキ・ライラッカは、あなたが描くのにぴったりのキャラクターです。お引き受けいただけますか？ 参考資料は下記リンクに全て準備済みです。彼女の生意気で生意気な性格を念頭に置きつつ、お好きなポーズを選んでください。この鬼は魔法も操れるため、炎や稲妻を使った表現力を存分に発揮していただけると嬉しいです。\n\nhttps://drive.google.com/drive/folders/11F9U3I_TUeh4cjZUbAcmg-PJzgQTkgvB?usp=drive_link", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@BANANAgyogyo/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1478552, "client_id": 18708, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/c64daf74/uploads/origins/570d8da0-3177-4954-b7ec-e6a2b56d86b6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7472340702168243f3bb1ee6defd5efa", "srcset": "https://si.imgix.net/c64daf74/uploads/origins/570d8da0-3177-4954-b7ec-e6a2b56d86b6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7472340702168243f3bb1ee6defd5efa, https://si.imgix.net/c64daf74/uploads/origins/570d8da0-3177-4954-b7ec-e6a2b56d86b6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=5adcd2e289f36d1ddf66be27d29300d8 2x, https://si.imgix.net/c64daf74/uploads/origins/570d8da0-3177-4954-b7ec-e6a2b56d86b6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d259a4562f0e33489953982b6e95aabc 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/c64daf74/uploads/origins/570d8da0-3177-4954-b7ec-e6a2b56d86b6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0c54fff2eecd69eaed2c03a9a6c576d3", "srcset": "https://si.imgix.net/c64daf74/uploads/origins/570d8da0-3177-4954-b7ec-e6a2b56d86b6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0c54fff2eecd69eaed2c03a9a6c576d3, https://si.imgix.net/c64daf74/uploads/origins/570d8da0-3177-4954-b7ec-e6a2b56d86b6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=68f053dfa8a91eb4a1dfc24fc9d84ae2 2x, https://si.imgix.net/c64daf74/uploads/origins/570d8da0-3177-4954-b7ec-e6a2b56d86b6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=cc9e483bc342f3a72154c46b38bc0cc3 3x"}, "body": "こんにちは。アピール有難うございます。\n\n私のOCであるMelody Horizon（メロディー・ホライズン）のアートをお願いしたいと思います。\n\nMelodyはちょっとおてんば娘。とても自信家で、どんな状況にもすぐに適応できる。とても頼りになるが、気が短い。外向的で、人助けが好きな女の子だ。Melodyが使うのは、大きなレンチと剣、そして体力だ。彼女は他の道具や即席の武器も適当に使う。趣味は特撮番組と漫画。辛い食べ物と甘いコーヒーが好きだ。Melodyは控えめな胸とむっちりとした太もも、そしてキュートなお尻を持っている。引き締まった体つきをしている。肌は少し日焼けしている。\n\nMelodyの髪はこの例のように乱れ、ふわふわしている。\nhttps://drive.google.com/drive/folders/1vJlsOq5AJLVy9s2sTt7FqeG7ZB5w50_l?usp=sharing\n\nMelodyがスクリュードライバーの剣で攻撃しているシーンが欲しい。彼女の戦闘スタイルはパワーとスピードを重視しており、時に無謀に見えることもある。彼女の武器は電気と火を生み出す。\n\n彼らの世界は少し未来的だが、現代世界の多くの側面を残している。この世界では、古い技術と新しい技術が隣り合わせになっているのをよく目にする。以下は、私が考えている世界や雰囲気をとらえた参考文献です。\nhttps://drive.google.com/drive/folders/13hBddiIoeDENY54mA6j5BUIWfRfg--3A\n\nご自由に描いてください。先生にとってかっこいいシーンであればうれしいです。\n\nご検討よろしくお願いします。\n\nhttps://drive.google.com/drive/folders/1o5wVZm2_d96skaWohudJzxVatK2kXtGI", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@BANANAgyogyo/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1478552, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/ac1d925c/uploads/origins/3064a48a-6836-4e62-8c1c-63dd58ccd6fc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f48f94895327cc002529059b1a8ecae8"