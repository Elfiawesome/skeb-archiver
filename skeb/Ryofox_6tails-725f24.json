review_url": "https://fcdn.skeb.jp/uploads/23322/0/mp3_128k/0?response-content-disposition=inline&Expires=1780472614&Signature=D0LaFcKCl77OkHUZkPTluGHiG-GhLMXpS6n8WgWbp5IijZXu-f9lftUlJiJvgeCnzRf6GYiVf~utNds2Ecze1pUXuT5SdqhX32cDvcSYIACND--iHNj-vEEn~sRWWFumogZf~zY1Wgf~3orq3~X~rQBuTbofu8ew9jDw4vgRYmXHlNzW7-2i3APP~RUDvqj9I~Mnjvfx53sYhJ5RLyLURQo932LHtuFrPcqdv4JyjnF6ykbJUmyNRCOn1O3ePt3ZN3nJvUpYu-PPt8Wu4gsHIPUyjMzYwu3oW69numHw1iCtKCLNdOmECXWlK~6ds4os8X1s2KJNig4oTlKebxcxDw__&Key-Pair-Id=K1GS3H53SEO647", "duration": 96, "nsfw": true, "hardcore": true, "consored_thumbnail_image_urls": {"src": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1911418957648519168%2FhpzqlxAm.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f0c0ee60bae53874bd70c75ffc9566ef", "srcset": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1911418957648519168%2FhpzqlxAm.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f0c0ee60bae53874bd70c75ffc9566ef, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1911418957648519168%2FhpzqlxAm.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=c10f1302b72ebbfedab99843251e20ec 2x, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1911418957648519168%2FhpzqlxAm.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=e6dcc91652681456bf9fb991f2730103 3x"}, "body": "「んゃ……やめて、もう離して！」\n\nりょーねーは四肢をベッドに縛られ、動けなくされていた。\nくらやみにベッドライトのほのかな明かりだけがりょーねーを照らしている。\n\n「んっ……んっ、んゃ……や、離して、離してっ……」\n\nりょーねーのほおを汗が伝う。\n暴れるりょーねーとカシャカシャと音を立てる拘束具。一生懸命に暴れているけれども、ここから出られる気配はなく、りょーねーの息はだんだんと荒くなっていく。\n\n「はぁっ……はぁっ……はぁっ……ここ、からっ……出して」\n\nだんだんと暴れる力は弱まっていき、気づけば、りょーねーはただベッドの上で強制的に大の字に四肢を広げることしかできなくなる。\n\n「はぁっ……はぁっ……はぁっ……んっ、ん……ん゛」\n\nりょーねーの目が見開かれる。\nそしてほおを赤らめ何かに耐えようとしているが、そんな抵抗むなしく、りょーねーの口からは艷やかな音が漏れていく。\n\n「ん゛……んぅ……ん、んっ……んっ、やだ……やだ、わたし……あっ……んっ……あっ」\n\nもじもじと内ももを擦り合わせて、りょーねーのおまたは、りょーねーの恥ずかしい気持ちを惜しげもなく透明な液体に乗せて露出させていた。\n\n「や、やだ……わたし、あっ……やっ」\n\nりょーねーはじぶんのおまたから出た液体が、ベッドのシーツに大きなシミを作っているのを見てしまった。\nもしこのすがたを見られたら、りょーねーはえっちなきつねだってことが知られてしまう。\nりょーねーの中に恥ずかしいという思いが巡るけれども、それ以上に気持ちよくなりたいという思いが巡る。\n\n「……あっ、んっ……あっ……んっ、んゅ……はぁっ……あっ、ああっ……あっ」\n\nそんな自分のこころに、りょーねーはだんだんとだんだんと耐えられなくなっていく。\n恥ずかしい気持ちに、じぶんの中にあるえっちな気持ちが混ざり合って、恥ずかしいのにやめたいのにやめられなくなって、うずいてうずいてどうしようもなくなる。\n\n「んっ……んぅ、あっ……あっ、あっ……もっと……もっと」\n\nえっちな声が響いている。\n四肢をベッドに縛りつけられたりょーねーが恥ずかしい声を上げている。\nでも、その顔はほおを真っ赤にしながら多幸感を隠そうともしない。\n\n「んっ……もっと、もっとちょうだい……あっ、いいっ……んっ……あぁっ」\n\nりょーねーは気持ちよさそうに、一段とおおきな声をあげた。", "nc": 58, "word_count": 0, "transcoder": "audio", "creator_acceptable_same_genre": true}], "sent_works": [{"path": "/@tamanoumika/works/15", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 72847, "client_id": 79040, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/df3d1d63/uploads/origins/528566dc-d71a-486c-80c1-61f08d9b5fe1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7de22839306a98b3e8f136dd00a51ed1", "srcset": "https://si.imgix.net/df3d1d63/uploads/origins/528566dc-d71a-486c-80c1-61f08d9b5fe1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7de22839306a98b3e8f136dd00a51ed1, https://si.imgix.net/df3d1d63/uploads/origins/528566dc-d71a-486c-80c1-61f08d9b5fe1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ac9ff992ecf899597d1cf1f17f282c07 2x, https://si.imgix.net/df3d1d63/uploads/origins/528566dc-d71a-486c-80c1-61f08d9b5fe1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=4ad118b023fee198327cca1863b367c8 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/df3d1d63/uploads/origins/528566dc-d71a-486c-80c1-61f08d9b5fe1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=973d7881c9fb63819fe5fb58d843dce0", "srcse