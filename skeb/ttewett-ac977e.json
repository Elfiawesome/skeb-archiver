/a2e990e7-1581-4d20-aba8-e39b41d175b9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=518fbb9c3cb3802cd7e1b7ba66919bb9, https://si.imgix.net/6d3ee79d/uploads/origins/a2e990e7-1581-4d20-aba8-e39b41d175b9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=8dd1319cd7361b8a0b8785e1dd6c6393 2x, https://si.imgix.net/6d3ee79d/uploads/origins/a2e990e7-1581-4d20-aba8-e39b41d175b9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=34352731e732628912c1d56df86ea715 3x"}, "body": "はじめまして！skebのおすすめで見かけて優しいタッチもイラストに惹かれて依頼させていただきました！\nお願いしたいのは個人Vtuberの芽唯さんになります！芽唯さんのYoutube登録10万人達成のお祝いに銀盾を持ったイラストをプレゼントしたいと思っております。\n添付のサイトにある三面図の1番上のツインテールの黄色い背景の衣装でお願いしたいです！Vご本人が希望された際にXでのポストやサムネ等で使用させていただけると幸いです。\n\nよろしくお願いします！\n\nhttps://lit.link/meigarden", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@ttewett/works/18", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 364731, "client_id": 1076647, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/6dc1fc5e/uploads/origins/0e7022c5-0cba-49af-89ea-a8f48d190d9a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3657de9330ed4c1278a3d05a9c32fca7", "srcset": "https://si.imgix.net/6dc1fc5e/uploads/origins/0e7022c5-0cba-49af-89ea-a8f48d190d9a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3657de9330ed4c1278a3d05a9c32fca7, https://si.imgix.net/6dc1fc5e/uploads/origins/0e7022c5-0cba-49af-89ea-a8f48d190d9a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b94500bb70b775169e88073ae80eca86 2x, https://si.imgix.net/6dc1fc5e/uploads/origins/0e7022c5-0cba-49af-89ea-a8f48d190d9a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a47acb84596c87399032a4c01af1c11a 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/6dc1fc5e/uploads/origins/0e7022c5-0cba-49af-89ea-a8f48d190d9a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b0e08ccd6da173675699b5d381319cea", "srcset": "https://si.imgix.net/6dc1fc5e/uploads/origins/0e7022c5-0cba-49af-89ea-a8f48d190d9a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b0e08ccd6da173675699b5d381319cea, https://si.imgix.net/6dc1fc5e/uploads/origins/0e7022c5-0cba-49af-89ea-a8f48d190d9a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=fc6671bd288df388d8651bd57c8fc196 2x, https://si.imgix.net/6dc1fc5e/uploads/origins/0e7022c5-0cba-49af-89ea-a8f48d190d9a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=5896b561255fa09620496e5378788861 3x"}, "body": "ととてて様、初めまして！\n個人Vtuberサークル・Project Wee:Dにて活動しております、鯱家(しゃちや)るかと申します。\nXにてかすていらヨリコさんの素敵なイラストを拝見して、この度ご連絡させていただきました。\nヨリコさんの瞳や表情、ティーセットの細かな模様など、本当に素敵でした！\n\n本題なのですが、今回はリクエストとして、ぼく(鯱家るか)の、食事前のいただきます！風景のイラストをお願いできないでしょうか？\nイメージとしては、ぼくが美味しそうなお寿司を食べる直前の嬉しそうな様子がいいです。\n構図は腰上くらいで、ポーズや表情は上記のイメージに合っていればお任せで問題ないです。\nお寿司は黒地に金の筆で斜めの線が引いてある柄の回転寿司皿(ぼくのメンバーシップ24ヶ月のバッジの柄です)で、寿司ネタは中トロやいくら等そのお皿に似合いそうな価格帯のお寿司でお願いします！\n回転寿司なので、食べ終わったお皿が周りに積み重なっててもいいかも…その辺も出来上がりを楽しみにしたいのでお任せします！\n\nサイズの希望はざっくりですがポストカードサイズくらいで、用途は配信サムネイルやメンバーシップリスナーさん対象の無料配布で使わせていただければと考えておりますので、背景透過のデータもいただければとてもありがたいです。\n\nもしお引き受けいただけるようでしたらうれしいです。\n何とぞよろしくお願いいたします！\n\nProject Wee:D\n鯱家るか", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@ttewett/works/17", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 364731, "client_id": 1690465, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/aec6c5b2/uploads/origins/139b0c33-b206-4804-8e41-ec3cfb0389cd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6ddadbe932a56393a614fb31a774436a", "srcset": "https://si.imgix.net/aec6c5b2/uploads/origins/139b0c33-b206-4804-8e41-ec3cfb0389cd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6ddadbe932a56393a614fb31a774436a, https://si.imgix.net/aec6c5b2/uploads/origins/139b0c33-b206-4804-8e41-ec3cfb0389cd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=7b1399597c89e7e667495b02129a4b68 2x, https://si.imgix.net/aec6c5b2/uploads/origins/139b0c33-b206-4804-8e41-ec3cfb0389cd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=26c7d82a1d0517bf34dd76069baf31ba 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/aec6c5b2/uploads/origins/139b0c33-b206-4804-8e41-ec3cfb0389cd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5af127118b7a30ddf70bcfc18ef95426", "srcset": "https://si.imgix.net/aec6c5b2/uploads/origins/139b0c33-b206-4804-8e41-ec3cfb0389cd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5af127118b7a30ddf70bcfc18ef95426, https://si.imgix.net/aec6c5b2/uploads/origins/139b0c33-b206-4804-8e41-ec3cfb0389cd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=d5264442e3cae2ef79eddfdedf36e34c 2x, https://si.imgix.net/aec6c5b2/uploads/origins/139b0c33-b206-4804-8e41-ec3cfb0389cd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=7dce1b9cd1606b2fb6d654d04fa6621b 3x"}, "body": "はじめまして。長崎でVtuberをしております、かすていらヨリコと申します。\nととてて様の可愛くて透明感のあるイラストを拝見してぜひ描いていただきたい！と思いリクエストさせていただきます。\n\nもし御都合合いましたらよろしくお願いいたします！\n（先程一部間違えてリクエスト送信してしまい大変失礼いたしました）\n\n■希望のイラスト\nVtuber「かすていらヨリコ」を描いていただきたいです。\nサムネイルなどに使用させていただきたいため、頭の上部分や髪の先が切れない構図ですととてもありがたいです。\n\n〈人物の特徴〉\n長崎在住の庶民派お嬢様\nよりよりの形をした金髪ツインテール（巻き髪ツインテール）\nX、YouTube等見た目の参考にされてくださいませ。\nYouTube：https://youtube.com/@yoriko-nagasaki\nXアカウント：https://x.com/yoriyoriyorikoo\n\n歌枠等配信のサムネイルとしての使用を考えております。\nととてて様の可愛いと思うシチュエーションや構図でおまかせいたします。\n\n■使用用途\nYoutube(収益化済）サムネやX（Twitter）での宣伝活動。\n\n■その他\n可能でしたらキャラクターと背景を分けたpngファイルもいただけると幸いです。\n\nご検討のほどよろしくお願いいたします。", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@ttewett/works/16", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 364731, "client_id": 2881776, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/35054baf/uploads/origins/89d172be-4d13-41be-a2a7-693415adc838?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0446f06d23d82c1e7d7e19c097fe81b8", "srcset": "https://si.imgix.net/35054baf/uploads/origins/89d172be-4d13-41be-a2a7-693415adc838?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0446f06d23d82c1e7d7e19c097fe81b8, https://si.imgix.net/35054baf/uploads/origins/89d172be-4d13-41be-a2a7-693415adc838?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e638b191b20df7cc592fe3bccaf6da47 2x, https://si.imgix.net/35054baf/uploads/origins/89d172be-4d13-41be-a2a7-693415adc838?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=722a53896022428c3801238b7ec514a9 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/35054baf/uploads/origins/89d172be-4d13-41be-a2a7-693415adc838?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e51f4edf8eab065c852a288a9c494229", "srcset": "https://si.imgix.net/35054baf/uploads/origins/89d172be-4d13-41be-a2a7-693415adc838?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e51f4edf8eab065c852a288a9c494229, https://si.imgix.net/35054baf/uploads/origins/89d172be-4d13-41be-a2a7-693415adc838?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=3239653af2390460d240db1978d87598 2x, https://si.imgix.net/35054baf/uploads/origins/8