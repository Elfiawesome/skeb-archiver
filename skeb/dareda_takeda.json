tube、twitchで使わせていただきます。\n\n悪役令嬢として、彼女は残酷で、少しクレイジーですが、それでも破滅した王国と王座を守っています。しかし、恥ずかしがると慌てふためくこともある！ちょっとおバカなところもある。影の魔法が使える。\n\n潜入中の姿は現代に潜伏しており、趣味は悪役令嬢のイセカイ・コミックを読むこと、コーヒーを飲むこと、料理をすること。おっとりしているが、根は悪女！\n\nデザイン上の注意点人間の耳はありません。尻尾はありません。\n\nありがとうございました！\n\nhttps://drive.google.com/drive/folders/1Gho4ZgPZntzqhR0AgjrJN0g_DXsyUITr?usp=drive_link", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@dareda_takeda/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3814260, "client_id": 3211553, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/37234f5e/uploads/origins/839be250-0c40-466b-8791-4e45b1ba3352?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b79940c2ba73fbe3a1118923ea5c0f91", "srcset": "https://si.imgix.net/37234f5e/uploads/origins/839be250-0c40-466b-8791-4e45b1ba3352?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b79940c2ba73fbe3a1118923ea5c0f91, https://si.imgix.net/37234f5e/uploads/origins/839be250-0c40-466b-8791-4e45b1ba3352?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=df9a4b060e1535b5ea528b6e2a052fd8 2x, https://si.imgix.net/37234f5e/uploads/origins/839be250-0c40-466b-8791-4e45b1ba3352?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d9c2deeb7b61b81ac08e5a42ffce6671 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/37234f5e/uploads/origins/839be250-0c40-466b-8791-4e45b1ba3352?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=1957c9f6e0231766849b0bbc5506f5fc", "srcset": "https://si.imgix.net/37234f5e/uploads/origins/839be250-0c40-466b-8791-4e45b1ba3352?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=1957c9f6e0231766849b0bbc5506f5fc, https://si.imgix.net/37234f5e/uploads/origins/839be2