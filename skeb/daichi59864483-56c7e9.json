a6-655522782cd0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=aa393098a78fdf709343ed4f807e6014, https://si.imgix.net/3600f744/uploads/origins/0e9ce765-5840-4d68-aea6-655522782cd0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=8676e56fd064492d9e3885d5eeef4748 2x, https://si.imgix.net/3600f744/uploads/origins/0e9ce765-5840-4d68-aea6-655522782cd0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=4051c8abcab1635faa91b629ee2b1c4e 3x"}, "body": "こんにちは、大地先生。先生の絵、特に狂気の表現がとても好きです。そこで、私の魔法少女OCのイラストのアポイントを取りたいと思います。\n\n長さは半身（ふくらはぎくらいまで）でも全身でも構いません！\n\nキャラクター：彼女の名前はクララエ。髪を使って嫌いなものをバラバラにするのが好きな、超能力を持った魔法少女だ。髪は薄紫のロングポニーテールで、毛先に濃い紫のハイライトが入っている。右目はオレンジとピンクの猫の瞳孔、左目は青と紫の蝶の瞳孔。右目の下の赤い涙袋はピエロのメイクで、左目の下には涙袋がある。添付の参考画像はモデルと別の雰囲気のイラストですが、気にしないでください。\n\n衣装：モデルさんの衣装と別イラストの衣装は参考にせず、顔の特徴だけでお願いします。他の参考画像の黒い魔法少女の衣装のみ着用してください。衣装のデザインは非常に複雑で申し訳ありませんが、先生は衣装を簡略化して修正することができます。\n\nシナリオ：目を大きく見開き、左目から涙を流し、ベールを吹き飛ばし、怒りを全面に出した彼女を描きたい。ポニーテールの髪が飛び散り、髪には血が混じっている。手の動きは、こんな風に腕を組んでもいいし、先生がいつも描くように画面に向かって爪を伸ばしてもいい。全体のポーズや体の構図は先生に決めてもらいましょう。\n\n背景：雪景色。\n\nありがとうございました！\n\nhttps://drive.google.com/drive/folders/1Dpc6Z2q2l8D3MWXavLrb7A6WGz2pbHP-?usp=sharing", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@daichi59864483/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2696747, "client_id": 1875821, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/e8e94383/uploads/origins/71e50878-3ed9-49c9-a10b-28099bc583b5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a2df856d2edd5e7072b706a264c140f7", "srcset": "https://si.imgix.net/e8e94383/uploads/origins/71e50878-3ed9-49c9-a10b-28099bc583b5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a2df856d2edd5e7072b706a264c140f7, https://si.imgix.net/e8e94383/uploads/origins/71e50878-