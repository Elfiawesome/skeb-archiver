w=200&h=200&blur=200&s=9ac0d16e5c4da380f9d26e360ece373a", "srcset": "https://si.imgix.net/3e75f7b1/uploads/origins/34aa422c-0fea-4cbc-82fe-3038ce8839d7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9ac0d16e5c4da380f9d26e360ece373a, https://si.imgix.net/3e75f7b1/uploads/origins/34aa422c-0fea-4cbc-82fe-3038ce8839d7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=d87a8c69598ed3a4d82e221bf2a529e4 2x, https://si.imgix.net/3e75f7b1/uploads/origins/34aa422c-0fea-4cbc-82fe-3038ce8839d7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=b9a22edd484c1d9c1f4f7bfeb535c299 3x"}, "body": "はじめまして。\nPSのゲーム『モンスターファーム2』の助手コルトのエロ絵をお願いします。\n\n・ワルモン(アニメ版敵勢力の名前)のナーガに捕まり、鎖と金属の首輪で繋がれて犯されています。\n・参考のような露出度の高い儀式用の衣装を着せられています。また片側のブラが少しずれて乳首が露出しています。\n・コルトは悔しそうな表情。目は開いてます。\n・ナーガは玉座の椅子に座っていて、コルトは背面座位です。\n・へそフェチ腹フェチのためおへそがよく見えるアングルでお願いします。(腹ボコなどはなしでお願いします。)\n・またへそは丸くて中が見えてるのが好みです。\n・がもがも様のお腹に少しだけシワが寄った描写が好きなので構成上差し支えなければ描いていただきたいです。(このような感じhttps://skeb.jp/@gamogamo092/works/5)\n・おっぱいの大きさはDカップくらい。\n・ナーガの大きさはコルトに合わせて実際より小さくしても問題ありません。ペニスも無理なく入るサイズで。\n・ナーガは背景的に描いていただければ結構です。顔まで描く必要はありません。\n・全裸で号泣してる差分もできればお願いします。\n\nご検討よろしくお願いします。\n\n参考\nコルト\n\nhttps://monster-rancher.fandom.com/wiki/Coltia\n\nナーガ\nhttps://villains.fandom.com/wiki/Naga_(Monster_Rancher)\n\nhttps://www.deviantart.com/giuseppedirosso/art/Monster-Rancher-Ep-35-Naga-5-846978159\n\nhttps://www.pixiv.net/artworks/9178343\n\n衣装参考\n\nhttps://x.com/lino_shuwasoda/status/1709171148423057629?s=46&t=LMWYjzC8LfXRmin_laojXA\n\n首輪参考\n\nhttps://www.pixiv.net/artworks/59284284", "nc": 185, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@gamogamo092/works/13", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2974418, "client_id": 927456, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/e8a9e6c3/uploads/origins/de578b36-6372-4abf-973c-412873718cc8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6741d8443d666f37d66437d6ef366532", "srcset": "https://si.imgix.net/e8a9e6c3/uploads/origins/de578b36-6372-4abf-973c-412873718cc8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6741d8443d666f37d66437d6ef366532, https://si.imgix.net/e8a9e6c3/uploads/origins/de578b36-6372-4abf-973c-412873718cc8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=28c24daffc53d1ae65aefb6c0a630534 2x, https://si.imgix.net/e8a9e6c3/uploads/origins/de578b36-6372-4abf-973c-412873718cc8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=4e4723040c76995b9a860b91ae3bd187 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/e8a9e6c3/uploads/origins/de578b36-6372-4abf-973c-412873718cc8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=1f0ce319b75a0cefa3fd24427404584d", "srcset": "https://si.imgix.net/e8a9e6c3/uploads/origins/de578b36-6372-4abf-973c-412873718cc8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=1f0ce319b75a0cefa3fd24427404584d, https://si.imgix.net/e8a9e6c3/uploads/origins/de578b36-6372-4abf-973c-412873718cc8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=fbf1a9438cade6d8a4df55bbd3083a46 2x, https://si.imgix.net/e8a9e6c3/uploads/origins/de578b36-6372-4abf-973c-412873718cc8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=406672a883e8fa0184f243b357258e89 3x"}, "body": "キャラクター: ユリス×モニカ（ダーククロニクル）\n\nモニカを妊娠させるために、ユリスとモニカが何度も激しいイチャラブ生セックスをする様子を描いてください。\nセックスの1ラウンド全体と、その後の2～3回の絶頂（ぶっかけか中出し）、セックスの後を、一連の差分として描いてください。\n体位はお任せします。\n断面図もお願いします。\nユリスとモニカは裸でも、参考文献にある衣装を着ていても構いません。\nモニカは巨乳が露出していて、はっきり見えます。\nユリスはモニカのおっぱいを鷲掴みしてもいい。\nモニカはユリスに中に出して孕ませてくれと懇願する。\nユリスは二人が一緒に絶頂に達すると、喜んでモニカに中出しする。\nユリスとモニカは、モニカが妊娠するように何度もセックスを続ける。\n何時間ものセックスの後、モニカは膣からたくさんの精液を漏らす。モニカのおっぱい、顔、体も精液まみれです。\nモニカが妊娠に成功したことを示すために、モニカの卵子がユリスの精子と受精しているところを描いてください。\nその他はお任せします。\n\nよろしくお願いします。\n\nhttps://nextcloud.aonium.net/s/skeb-gamogamo092-20231116", "nc": 160, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@gamogamo092/works/12", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/259fd667/uploads/origins/1ae25b72-0aeb-4fb4-a01f-9835b462e57e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=f5276c522d485f833a76d500c99847e3", "srcset": "https://si.imgix.net/259fd667/uploads/origins/1ae25b72-0aeb-4fb4-a01f-9835b462e57e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=f5276c522d485f833a76d500c99847e3, https://si.imgix.net/259fd667/uploads/origins/1ae25b72-0aeb-4fb4-a01f-9835b462e57e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=da24e654e3c89996f4e143103561ee41 2x, https://si.imgix.net/259fd667/uploads/origins/1ae25b72-0aeb-4fb4-a01f-9835b462e57e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=146d89da866119f9588b2dc3b8da859f 3x"}, "private": true, "genre": "art", "tipped": false, "creator_id": 2974418, "nc": 32}, {"path": "/@gamogamo092/works/11", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2974418, "client_id": 32189, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/a247dfa7/uploads/origins/dbfb0836-df9c-48ae-975a-929a8b75b03d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0