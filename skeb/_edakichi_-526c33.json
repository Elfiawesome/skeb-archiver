ress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=632e88c01d83bdb066dddd42898ae7f6 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/a2222bae/uploads/origins/22409907-e6a1-4b03-b5bf-ab2597ade8af?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=24c3c35f3a2b3de0752c17a369be7428", "srcset": "https://si.imgix.net/a2222bae/uploads/origins/22409907-e6a1-4b03-b5bf-ab2597ade8af?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=24c3c35f3a2b3de0752c17a369be7428, https://si.imgix.net/a2222bae/uploads/origins/22409907-e6a1-4b03-b5bf-ab2597ade8af?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=d627c69a366abab42e7b0df1d346e379 2x, https://si.imgix.net/a2222bae/uploads/origins/22409907-e6a1-4b03-b5bf-ab2597ade8af?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=667547936d686c447912a5e76767646e 3x"}, "body": "いつも素敵な絵をありがとうございます。\n先生の絵好きなのでぜひ描いていただきたいと思いリクエストしました。\n\nTwitterのほうでリクエストがあった方が良いと伺ったので僭越ながらいくつかさせて頂きます。\n・クール系(ボーイッシュ系でも良い)\n・メガネがある(かける、おでこにある、服にかける等なんでもあれば嬉しいです)\n・タバコ(メーカー問わず  紙、電子どちらでも)\n\n希望少しで申し訳ないですが採用していただけると幸いです。\nお時間に余裕があるときや気分が乗ったときでよろしいので描いていただけると嬉しいです。\nよろしくお願いします！", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@_edakichi_/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 541295, "client_id": 541433, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/3ae52238/requests/254686_1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=afcf5a4972ed9dc4fd06788105bd2f16", "srcset": "https://si.imgix.net/3ae52238/requests/254686_1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=afcf5a4972ed9dc4fd06788105bd2f16, https://si.imgix.net/3ae52238/requests/254686_1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=88846960cdb53ef669682e82d841d434 2x, https://si.imgix.net/3ae52238/requests/254686_1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=71d3d07ce1b5901cb062fbf0f56530e4 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/3ae52238/requests/254686_1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=684a969b74a5d2f4053e1fbfdd196ff3", "srcset": "https://si.imgix.net/3ae52238/requests/254686_1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=684a969b74a5d2f4053e1fbfdd196ff3, https://si.imgix.net/3ae52238/requests/254686_1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=b47a35edfbe31532daddacf99c41238e 2x, https://si.imgix.net/3ae52238/requests/254686_1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=ba651cff8a67ea26951391a4f40eaee6 3x"}, "body": "3月になりましたね！3月になったので！\n枝吉先生に、とにかく何か絵を描いて見せて欲しい！と思った次第です。\n\n『\"本当になんでもいい\"ので描いて欲しいです。』\n\n自分の希望としてはそれなのですが、それだけ言っても投げやり過ぎるかも知れないので、描いてみて欲しいな！というところも！！　（これらは描いてみたくなったら採用してみてください！どれを採用してもしなくてもバリバリ大丈夫です！！出来上がったものがバリバリ最強ナンバーワンなので！自由〜にお願いします！）\n・（もし髪の生えた人間等を描いていただけるなら）髪の生え際が見えていると嬉しい！オールバックも万々歳！！\n・ミサンガなど、アクセサリー\n・腕捲り\n・上からパンチラ（へその方からゴムのところだけ見えるみたいなです。性別等問わず！）\n・くるぶし\n・かわいい、キュートな感じ\n\nこんな感じでしょうか、お時間に余裕があれば是非受けてください！ラクガキも飛びついて喜びますよ！\n枝吉先生の絵が見れたらとっても滅茶苦茶嬉しいです！！\nいつもありがとうございます！！！！！", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 123509, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "廣野累", "screen_name": "kouno_rui", "avatar_url": "https://pbs.twimg.com/profile_images/1992188288422256640/1kbvpxsM.jpg", "header_url": "https://pbs.twimg.com/profile_banners/3305102510/1679833591/1500x500", "appeal_receivable": true, "popular_creator_ra