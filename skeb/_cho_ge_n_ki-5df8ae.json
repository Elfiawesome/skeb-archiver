7-4a56-bca2-03af4c2e6a18?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b305c022c6dec8ed0323fc11d9f0b9f1, https://si.imgix.net/6de25f96/uploads/origins/45789b49-9bb7-4a56-bca2-03af4c2e6a18?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=d2732772ca08556e21d2967c7082b9c5 2x, https://si.imgix.net/6de25f96/uploads/origins/45789b49-9bb7-4a56-bca2-03af4c2e6a18?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=31bff8cac59a409a04cd113141d2922c 3x"}, "body": "初めまして、アピールありがとうございます！\n\nイラストを拝見させて頂きとても可愛かったので是非リクエストさせて頂きます(⋆ᴗ͈ˬᴗ͈)”\n\n内容はご提案いただいたもので大丈夫です🍒◎\n以下、詳細のご提示をさせて頂きます。\n\n୨୧┈┈┈┈┈┈┈┈┈┈┈┈┈୨୧\n\n【キャラクター詳細】\n・髪型→ツインテール、ハーフツインの2パターン（指定は無いため、お好きな方を描いていただけると嬉しいです！）\n・口→ωの形、向かって右側にのみ八重歯\n・目→猫目、まつげ多め\n・モチーフ→音符の飾りやアクセサリー、ジャスミンの花、猫のポシェットとレッグウォーマー\n・資料URLも添付させて頂きますのでご確認いただけますと幸いです。\n\n【衣装】\n・デフォルト、オリジナルどちらでもおまかせいたします！\n\n【構図、表情、イメージ】\n・キャラクター自体の雰囲気のイメージはゆめかわ、POP系になります。\n・記載のモチーフの連想できる要素を取り入れていただけると嬉しいです…！\n\n【用途】\n・XなどのSNSへの投稿\n・配信（未収益）動画のサムネイル\n\n→以下、可能であれば希望\n・メンバーへの壁紙返礼、配布\n・グッズへの使用\n\n【形式】\n・psdまたはpngデータ\n\n【その他希望】\n・pngの場合、可能であれば背景/人物/小物などそれぞれの透過データを、psdの場合レイヤー分けにていただけると嬉しいです。\n・頭周りや手のポーズが見切れないように描いて頂きたいです。\n・余裕がある場合のみで構いませんので、表情差分があると嬉しいです。\n\n୨୧┈┈┈┈┈┈┈┈┈┈┈┈┈୨୧\n\n長々と申し訳ございません！何卒ご検討の程、よろしくお願い申し上げます。\n\nhttps://drive.google.com/drive/folders/1GXDGO5tr0MUjqDmqFSF_2KAEbxfamoEW", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@_cho_ge_n_ki/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2429844, "client_id": 3484092, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/6d7f5ea9/uploads/origins/24f289a3-92a0-481c-a8ae-102669940575?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0bff2d7dca5aaf3ff31b59e9b9c4d990", "srcset": "https://si.imgix.net/6d7f5ea9/uploads/origins/24f289a3-92a0-481c-a8ae-102669940575?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0bff2d7dca5aaf3ff31b59e9b9c4d990, https://si.imgix.net/6d7f5ea9/uploads/origins/24f289a3-92a0-481c-a8ae-102669940575?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f12196591b397e42dda6391a80cca18c 2x, https://si.imgix.net/6d7f5ea9/uploads/origins/24f289a3-92a0-481c-a8ae-102669940575?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=53697798a5b9cb8523864b0672c1b22b 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/6d7f5ea9/uploads/origins/24f289a3-92a0-481c-a8ae-102669940575?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=1f0077cc9e8ea28b8c7e52e10370b3ac", "srcset": "https://si.imgix.net/6d7f5ea9/uploads/origins/24f289a3-92a0-481c-a8ae-102669940575?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=1f0077cc9e8ea28b8c7e52e10370b3ac, https://si.imgix.net/6d7f5ea9/uploads/origins/24f289a3-92a0-481c-a8ae-102669940575?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=288fe08db71bb6b40052e133e17dcc19 2x, https://si.imgix.net/6d7f5ea9/uploads/origins/24f289a3-92a0-481c-a8ae-102669940575?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=756c2b5c0cc38150e26c7bf56b305af6 3x"}, "body": "（すみません、宛名不要を選択し忘れてしまっていたので、再度リクエストを送信させていただきました🙇‍♂️）\n\nsasami様初めまして！Xを拝見させていただきまして、むにっとしてたお姉さん達のタッチがとっても可愛いらしいと思いリクエストさせていただきました！ まだ活動は開始していないものの、依頼させて頂きたいのはしゃかまどというお姉さんのキャラクターです！  【キャラクターー詳細】  髪型：長めのウルフカット 髪色: ワインレッド 服装: 胸元の開いたメイド服。スカートにはスリッドが入っており、ガーターベルト着用。ピアスは水色。 瞳: オッドアイで色はクリーム色と赤、したまつ毛あり。  【仕様用途】 SNSのアイコン、サムネイル、アイコン、ヘッダー等、商用利用有り グッズ用にも使用させていただくかもしれません。   【構図や衣装など】  お姉さんぽく、太ももが見えるポーズだと嬉しいです。たばこっぽいラムネを持っている設定なので、話を聞いてくれる気だるげなお姉さん感を出していただけますと幸いです。出来れば口を開けながら下をべーっとしてニヤッと笑っている表情だとうれしいです！  髪型、衣装に関しては、細部はおまかせでお願いできますと幸いです。  色味も資料は自分でざっくり書いた参考なので、完全に一致していなくても問題ありません！  データは可能でしたらpsdとpngでいただけると嬉しいです！難しければpsdだけで大丈夫です🙇  お忙しいとは思いますが、ご検討の程お願いいたします。\n\nhttps://drive.google.com/drive/folders/1-3RBi0Y9JNv1_ic5hEr5F31vTA8o9zCP", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@_cho_ge_n_ki/works/2", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/475588fc/uploads/origins/6ed2a5a8-a54b-49ae-8434-9189d5c37b3d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=0d441d7f599181e1b10465c9a74f4cab", "srcset": "https://si.imgix.net/475588fc/uploads/origins/6ed2a5a8-a54b-49ae-8434-9189d5c37b3d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=0d441d7f599181e1b10465c9a74f4cab, https://si.imgix.net/475588fc/uploads/origins/6ed2a5a8-a54b-49ae-8434-9189d5c37b3d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=0b63341d36133825f4e0b66c2d784017 2x, https://si.imgix.net/475588fc/uploads/origins/6ed2a5a8-a54b-49ae-8434-9189d5c37b3d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=73fd1f1f5538068037bef45ecdf2dfa0 3x"}, "private": true, "genre": "art", "tipped": false, "creator_id": 2429844, "client_id": 3425525, "nc": 1}, {"path": "/@_cho_ge_n_ki/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2429844, "client_id": 3352845, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/1da623ff/uploads/origins/925be724-d578-434b-be86-b3109443722e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=931faec4263736a977d6df62fe800f82