661-f657ec130d93?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=6635cc9b7eb0a279e1d726f097c131fc 3x"}, "body": "すぐはすさん　ご無沙汰しております。\n以前、イラスト本買わせていただきました。\nまた、久々にイラストの方見させていただいたので、リクエストいたします。\n\n依頼の内容ですが、衣装違いの美談みことちゃん2人をお願いします。\n衣装の方ですが、「天使みこと」と「スイートエンジェルなみこと」の衣装違いの天使2つ\n指でみことの数字の語呂合わせ「3」「5（パー）」「1」「0（グー）」のポーズ（指を立てる本数）でどちらか一人がウインクしてるのをお願いしたいです。\n\nそれ以外の背景とかはお任せいたしますので、お願いしたいです。", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@SUNFAIL/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1053522, "client_id": 459602, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/defd24a6/uploads/origins/5815074a-2fd5-41ee-b16e-3dd7af6deaab?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2ae57fd32d4bad826591697830b71efc", "srcset": "https://si.imgix.net/defd24a6/uploads/origins/5815074a-2fd5-41ee-b16e-3dd7af6deaab?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2ae57fd32d4bad826591697830b71efc, https://si.imgix.net/defd24a6/uploads/origins/5815074a-2fd5-41ee-b16e-3dd7af6deaab?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=7b5a06bdf02f3c1e8dd03f79ed98da65 2x, https://si.imgix.net/defd24a6/uploads/origins/5815074a-2fd5-41ee-b16e-3dd7af6deaab?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=498cf7e22dcc73f2c983f99d515445d3 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/defd24a6/uploads/origins/5815074a-2fd5-41ee-b16e-3dd7af6deaab?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a3c9f1dd6349622bc33a8c93ddb89231", "srcset": "https://si.imgix.net/defd24a6/uploads/origins/5815074a-2fd5-41ee-b16e-3dd7af6deaab?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a3c9f1dd6349622bc33a8c93ddb89231, https://si.imgix.net/defd24a6/uploads/origins/5815074a-2fd5-41ee-b16e-3dd7af6deaab?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=c05811a93b3f54ad5d55951d6a00d720 2x, https://si.imgix.net/defd24a6/uploads/origins/5815074a-2fd5-41ee-b16e-3dd7af6deaab?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=1905656ea0808241aa5c8777e7bd4fef 3x"}, "body": "skebがキャンペーン中で募集されていたのを見て依頼を出させて頂きました。\n\n駅メモの上田電鉄コラボイベントがとても良かったので、記念のファンアートを描いて頂けないでしょうか。別所温泉駅に保存されている丸窓電車の前でコラボの制服ラッピングを着ている神畑いおりさんが希望ですが、別のイベントスポットや、背景までは大変だった場合キャラの方に注力して描いて頂いても大丈夫です。その他の構図やポーズは全てお任せします。パンタグラフその他描きにくいパーツがあれば、適宜描きやすいように省略していただいて大丈夫です。\n\nもし可能なら納品版の絵にイベント期間の日付が入っている版があるとより嬉しいです。\n\n資料にラッピングと電車を載せておきますが、検索すればイベントに行かれた方で他にもっと上手く写真を撮られている方のが出てくると思います。\n\nもし引き受けて頂ける場合も、急ぎませんので他の依頼ややりたいことを優先して、依頼と気負わずに気楽に描いて頂ければ幸いです。\n\n以上、よろしくご検討下さい。\n\nhttps://twitter.com/vgloTDcrhxRn5B2/status/1575882247911387136?t=c7Q5jjORHNRYUOnq-urNRg&s=19", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@SUNFAIL/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1053522, "client_id": 79218, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/e4fdda1b/uploads/origins/4851a9db-b5bd-45bc-bc1b-813ee9d1eac1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2e16d9de699cdb4e07aa24e56c1654a9", "srcset": "https://si.imgix.net/e4fdda1b/uploads/origins/4851a9db-b5bd-45bc-bc1b-813ee9d1eac1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2e16d9de699cdb4e07aa24e56c1654a9, https://si.imgix.net/e4fdda1b/uploads/origins/4851a9db-b5bd-45bc-bc1b-813ee9d1eac1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=d054718d2f91a80f51561d61d89e6dc4 2x, https://si.imgix.net/e4fdda1b/uploads/origins/4851a9db-b5bd-45bc-bc1b-813ee9d1eac1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e26e236291987787bd1e31d2f1797279 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/e4fdda1b/uploads/origins/4851a9db-b5bd-45bc-bc1b-813ee9d1eac1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=bf2d29fb39fcfa59d714516ba63765bf", "srcset": "https://si.imgix.net/e4fdda1b/uploads/origins/4851a9db-b5bd-45bc-bc1b-813ee9d1eac1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=bf2d29fb39fcfa59d714516ba63765bf, https://si.imgix.net/e4fdda1b/uploads/origins/4851a9db-b5bd-45bc-bc1b-813ee9d1eac1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=acd287bb74bbec6bc1ed99e20eede99c 2x, https://si.imgix.net/e4fdda1b/uploads/origins/4851a9db-b5bd-45bc-bc1b-813ee9d1eac1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=ee124f6eae16249053cdd5b1efa0d5f7 3x"}, "body": "初めまして、突然の長文失礼します。\npixivでお見かけしたマコトが肉感的でとても良かったので、良ければリクエストさせてください。\n\nアイドルマスターシンデレラガールズの城ヶ崎美嘉と、グラブル主人公のグランのイラストを描いていただけないでしょうか。\n\n内容は二人の模擬戦中の光景といった感じのシチュエーションで、隙をついた美嘉が鞭を巻き付けてグランを引き倒し、起き上がろうとしたグランの背中を踏みつけている、という場面で。\n美嘉の衣装はグラブルコラボ時のもので、資料URLの画像を参考にお願いします。\n\n特に力を入れてもらいたいのは美嘉の方で、彼女の全身が描かれていて、ヒールが食い込む音が聴こえてくるようながっつり踏みつけている感じを出して欲しいです。\n\nグランの方は顔が見えなかったり一部が見切れているような構図で構いません。\n服や髪なども多少ラフな仕上げで問題ありません。\n\n背景には公式のイラストのように多数のハートマークを散りばめてもらいたいです。\n\n美嘉の表情は自信たっぷりのキメ顔、笑顔でウインク、ちょっと小馬鹿にしてからかう様なものの三種類を差分でお願いしたいです。\n\nリクエスト内容は以上です。ご検討、よろしくお願いします。\n\nhttps://gbf-wiki.com/index.php?%BE%EB%A5%F6%BA%EA%C8%FE%B2%C5%20%28SR%29", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@SUNFAIL/works/5", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/a175c631/uploads/origins/d72d679c-0c60-4b54-85c0-50170ee45e3c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&