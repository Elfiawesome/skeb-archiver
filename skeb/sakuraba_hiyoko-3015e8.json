et/c3841f56/uploads/origins/1e256ea5-96d2-4b48-bca4-72c3f9951bbc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c23f45e2e41679b76eea80ddff754c90", "srcset": "https://si.imgix.net/c3841f56/uploads/origins/1e256ea5-96d2-4b48-bca4-72c3f9951bbc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c23f45e2e41679b76eea80ddff754c90, https://si.imgix.net/c3841f56/uploads/origins/1e256ea5-96d2-4b48-bca4-72c3f9951bbc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=7407df92fb27ef7c702d3eca1b210261 2x, https://si.imgix.net/c3841f56/uploads/origins/1e256ea5-96d2-4b48-bca4-72c3f9951bbc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=614e4c48d14f8ee86790be20d95e8239 3x"}, "body": "お世話になっております、さくらばさんのイラストが好きなので再び依頼させて頂きます。\n1枚絵の依頼となります。\n\nクトゥルフ神話TRPG非公式シナリオ「確信的イナモラメント」セッションにて使用させて頂きたいと考えています。\nSNSアイコンとして使用させていただく場合もあります。\n\n資料URL先の2人が深淵(宇宙っぽければなんでも大丈夫です)でダンスを踊っている姿をお願いしたいと思います。確信的イナモラメントKPCは触手が生えますが(概要に書いてあるのでネタバレではありません)、イラストには触手なしでお願いします。\nリアム(金髪)がリードする側でお願い出来ればと思います。\n是非検討頂ければ幸いです。\n\nhttps://drive.google.com/drive/folders/1-L1sugB3N5zOZ5uuJTLfr2hER64qTPOt", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@sakuraba_01/works/27", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 676241, "client_id": 1857930, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/059bbc25/uploads/origins/7965d1fd-1225-4a4d-b711-fe7eaa291e73?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c4215c9363b2a7406d8e072b6e76d852", "srcset": "https://si.imgix.net/059bbc25/uploads/origins/7965d1fd-1225-4a4d-b711-fe7eaa291e73?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c4215c9363b2a7406d8e072b6e76d852, https://si.imgix.net/059bbc25/uploads/origins/7965d1fd-1225-4a4d-b711-fe7eaa291e73?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a2bb03f22000c9698d2a023f58be94c3 2x, https://si.imgix.net/059bbc25/uploads/origins/7965d1fd-1225-4a4d-b711-fe7eaa291e73?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=7721e768278f3a967168ed116d3d8699 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/059bbc25/uploads/origins/7965d1fd-1225-4a4d-b711-fe7eaa291e73?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=4c105a723ac9b0d9eb51667e0c23f36c", "srcset": "https://si.imgix.net/059bbc25/uploads/origins/7965d1fd-1225-4a4d-b711-fe7eaa291e73?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=4c105a723ac9b0d9eb51667e0c23f36c, https://si.imgix.net/059bbc25/uploads/origins/7965d1fd-1225-4a4d-b711-fe7eaa291e73?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=85735ec642905647048778bf0dd5a9f7 2x, https://si.imgix.net/059bbc25/uploads/origins/7965d1fd-1225-4a4d-b711-fe7eaa291e73?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=42c61eb8cae8a49ffb77a37c490449a4 3x"}, "body": "さくらば様\nいつも表情豊かで滑らかな体の動きのイラストが素敵だなあと思いながら拝見させていただいております。\n今回はうちよその1枚絵を依頼させて頂きたく、こちらに失礼致します。\nお忙しいところだとは思いますので無理せずにスケブの規約通りスルーしていただければと思います🌸\n\n朔之助\n\n\nポーズ/構図/表情などおまかせ致します。\n\n\n━━━━━━━以下説明になります━━━━━━━\n\n【資料/参考画像】\nhttps://drive.google.com/drive/folders/1-Kr6ODC6Tk0GKIIxp5IDmswRDTMkKsEf\n\n\n【関係性など】\n互い以外に友人と呼べる存在はいないが決して「友人はいるか」という問いに互いの名前をあげないため、2人とも友人がいない。\n幼い頃は今よりも純粋に仲が良く、公園の隅で遊ぶなどしていた淺田翔を狗川秀が誘って遊んでいた。\n現在は軽口を叩き合いながらもなんだかんだで何故か同居。\n汚職刑事(表立っては真面目だが指名手配犯を捕まえようとはしていない)と大罪人(殺人窃盗放火etc…)。\n割と猫がじゃれているような感じです。組み付いたり蹴ったり…。\n\n\n【CS】※ シナリオのネタバレになるところは大きくスペースを空けて下方に記載してありますのでご注意ください\n狗川秀：https://iachara.com/char/3130662/view\n淺田翔：https://iachara.com/char/3130781/view\n\nイメージソングなどの要素が平気でしたら狗川秀のCSの(どうでもいい話)以降に記載の「イメソンに関して」をご覧いただけると分かりやすいかなと思います。\n\n\n\n━━━━━━━以下余談━━━━━━━\n\nどこまで書けばいいかわからず書きたいままに書いた結果、余談となってしまったものたちです。蛇足とも言います。\n\nネタバレあり/ワンクッション\n\nhttps://twitter.com/sakuraba_hiyoko/status/1525211552277999616?s=21&t=-RzDUbPQMD8rNSHnVp-LCQ\n\nhttps://twitter.com/sakuraba_hiyoko/status/1525220540247515136?s=21&t=-RzDUbPQMD8rNSHnVp-LCQ", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "similar_creators": [{"id": 12, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "おぷーナ", "screen_name": "op_na_ura", "avatar_url": "https://pbs.twimg.com/profile_images/2022337732757037056/5ZzamyG2.jpg", "header_url": "https://pbs.twimg.com/profile_banners/2350122362/1753346915/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "art"}], "banned": false, "nc": 48}, {"id": 72006, "creator": true, "nsfw_acceptable": true, "acceptable": false, "name": "それーゆ🟩個展7/11~", "screen_name": "ywyw_MNTL", "avatar_url": "https://pbs.twimg.com/profile_images/2019655018564186114/RFVBlR2l.jpg", "header_url": "https://pbs.twimg.com/profile_banners/965621467827249152/1675614537/1500x500", "appeal_receivable": false, "popular_creator_rank": 33, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 90, "skills": [{"genre": "art"}], "banned": false, "nc": 176}, {"id": 585423, "creator": true, "nsfw_acceptable": false, "acceptable": false, "name": "石田", "screen_name": "segu_ishida", "avatar_url": "https://pbs.twimg.com/profile_images/1323615591622569984/PFIu5_5O.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1143103126594961408/1639735721/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null