や腋を魅せるポージング\n※納品されているイラストに足組みや腋見せのがありますのでご参考にお願いします。\n【その他】\n表情や髪型はお任せします。\n（通常Ver.の髪飾りのシミニョンは無くてもいいです。）\n予算内で可能であれば、表情・半脱ぎ・別衣装等の差分をお願いします。\nR18差分大歓迎！\n\n 納品データはpsdでレイヤー分けをのお願いします。\n使用用途は個人使用でのタペストリーに使用予定です。\nびろぶどう様の肉感的でフェチ満載のイラストに仕上げてくださればと思いますので是非ご検討ください。\n\nhttps://x.com/misa19950707/status/1726556394227384661?s=20", "nc": 33, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@birobudou_hinan/works/11", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2677603, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/ef2b171b/uploads/origins/dcd4a9b1-6018-4d70-b17b-36c0eadfa9bc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8b88716b76fabb9e9466b237d4ae2271", "srcset": "https://si.imgix.net/ef2b171b/uploads/origins/dcd4a9b1-6018-4d70-b17b-36c0eadfa9bc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8b88716b76fabb9e9466b237d4ae2271, https://si.imgix.net/ef2b171b/uploads/origins/dcd4a9b1-6018-4d70-b17b-36c0eadfa9bc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=2387291ef289a324c5b9efc6820c518b 2x, https://si.imgix.net/ef2b171b/uploads/origins/dcd4a9b1-6018-4d70-b17b-36c0eadfa9bc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=75e6de9f55a21693407640b797c0b5d3 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/ef2b171b/uploads/origins/dcd4a9b1-6018-4d70-b17b-36c0eadfa9bc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=aaaf0fb5bec6be0d8bd13e1c9757dce1", "srcset": "https://si.imgix.net/ef2b171b/uploads/origins/dcd4a9b1-6018-4d70-b17b-36c0eadfa9bc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=aaaf0fb5bec6be0d8bd13e1c9757dce1, https://si.imgix.net/ef2b171b/uploads/origins/dcd4a9b1-6018-4d70-b17b-36c0eadfa9bc?bg=%23fff