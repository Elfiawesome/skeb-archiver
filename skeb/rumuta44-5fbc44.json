/origins/3b75cd9e-96cd-4887-b134-9741d87d93e4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3b7e507ff3d96a4ee1f6f0958e0ca998, https://si.imgix.net/e4553257/uploads/origins/3b75cd9e-96cd-4887-b134-9741d87d93e4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=337560ff880a26c5c23ff0975a3721a3 2x, https://si.imgix.net/e4553257/uploads/origins/3b75cd9e-96cd-4887-b134-9741d87d93e4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=7a003a6019bd7e388de3fcadb6b0d13d 3x"}, "body": "はじめまして。\nXで昨日投稿されていたシェリーちゃんに一目惚れしてしまい、リクエストを送らせていただきます。\n\n等身イラストでまのさばのシェリーちゃんを描いていただきたいです。\nるむた様が思うシェリーちゃんの可愛い姿を存分に表現していただきたく、構図などは全てお任せいたしますが、帽子や装飾が収まるようにしていただけますと幸いです。\n描いていただいたイラストはSNSのアイコンや壁紙などに個人利用させていただきます。\n\nよろしくお願いいたします。\n\n【「魔法少女ノ魔女裁判」二次創作ガイドライン】\nhttps://manosaba.com/guidelines\n\n【参考資料】\nhttps://x.com/13witch_Trials/status/1917859601212670103\nhttps://x.com/13witch_Trials/status/2048598108410679389", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@rumuta44/works/8", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3289504, "client_id": 3394649, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/059d774f/uploads/origins/be993a75-0e79-48b6-a459-a77258b8ccad?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1e64e0b3a7d3209af3c3db0a7c7d0f5e", "srcset": "https://si.imgix.net/059d774f/uploads/origins/be993a75-0e79-48b6-a459-a77258b8ccad?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1e64e0b3a7d3209af3c3db0a7c7d0f5e, https://si.imgix.net/059d774f/uploads/origins/be993a75-0e79-48b6-a459-a77258b8ccad?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=6f252a38423d55fb53dbfdfa4f66cbd3 2x, https://si.imgix.net/059d774f/uploads/origins/be993a75-0e79-48b6-a459-a77258b8ccad?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=7a314f31c6b3421674e702c9b8cec3ff 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/059d774f/uploads/origins/be993a75-0e79-48b6-a459-a77258b8ccad?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=eecdc116df862ef0a07120d8eada8cc5", "srcset": "https://si.imgix.net/059d774f/uploads/origins/be993a75-0e79-48b6-a459-a77258b8ccad?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=eecdc116df862ef0a07120d8eada8cc5, https://si.imgix.net/059d774f/uploads/origins/be993a75-0e79-48b6-a459-a77258b8ccad?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=cc0b5dff128f65b28bf8dfdb01782135 2x, https://si.imgix.net/059d774f/uploads/origins/be993a75-0e79-48b6-a459-a77258b8ccad?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=936487014a8fbbad46249758ed1a7c5d 3x"}, "body": "るむた様\n\nお世話になっております。常磐イツキです。\n以前は私の可愛いミニキャラをたくさん描いていただきありがとうございました。\n実はこの度、新衣装を公開いたしましてぜひ新衣装の私のミニキャライラストを描いて頂けないかとリクエストを送らせて頂きました。\n\n【希望内容】\n・私の姿\n・配信や動画のサムネイル等に使用したいため、左右上が見切れ無しでお願いしたいです。\n※下はどこまで描くかお任せ致します。\n可能でしたら全身描いて頂けると嬉しいです。\n・背景透過済みの人物のみのデータを頂けると幸いです。\n\n【使用用途】\n・vtuber活動でのサムネイルやXでのSNS活動。(チャンネル収益化済み)\n・グッズ化はいたしません。\n\n新衣装を公開した際にはるむた様のミニキャライラストで、私のミニキャライラストを揃えたいと思っておりました。\n資料にある立ち絵の装飾(ハット＆リボンか、リボン帽子か)どちらを使うかはるむた様の気に入った方で描いていただけたらと思います。\nご検討の程よろしくお願いいたします。\n\nhttps://x.com/itsuki_tokiwa/status/2032858842430935174?s=46&t=hGF_6m6EiPXKV98EwuB88Q", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@rumuta44/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3289504, "client_id": 460270, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/371f5252/uploads/origins/72c1daa9-d1d3-410c-b0d7-ff2e016bfb1d?bg=%23fff&auto=forma