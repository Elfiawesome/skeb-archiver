色はアッシュブラウン、中くらいの濃さの灰色から、少しだけ橙色に寄る感じ\n✅虹彩はディスク面のようなプリズムのグラデーション\n✅右涙ぼくろ (向かって左)\n✅右こめかみ (向かって左) に青色に発光するLEDリング\n✅向かって右のバストとデコルテの間に縦2連のほくろ\n✅風船のような巨乳ではなくレモン形の張りのある円錐形のバスト、F65\n・身長は162cmです\n\n・イメージキーワード　夏至・冬至・夜明け・朝焼け・朝の光・水平線\n・服は普段着(コンサバ+フェミニン)ですとうれしいです\n(また水着やブラ&ショーツでもokです。ねこみーちゃん🐈先生が描きやすい形で。もしブラショーツの場合はワインレッドベースの刺繍、レース、フロントに小さな宝石のチャーム\n\nアングルやテイスト・シチュエーション、ロケーションもお任せいたします\nもちろん上記リンク先のページをご参考にしていただいても全然okです\n少し大胆なポージング・動きがあるとなおうれしいです\n\nなにとぞよろしくお願いいたします\n\nhttps://note.com/raysolstice/n/n8f9f8e4637b1", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Michan127neko/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2721808, "client_id": 2190746, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/686bbd0d/uploads/origins/297ed401-0fb4-43d4-9542-19dabb97c185?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=00c2c54a2449a1fd2e4e1dd2635fea43", "srcset": "https://si.imgix.net/686bbd0d/uploads/origins/297ed401-0fb4-43d4-9542-19dabb97c185?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=00c2c54a2449a1fd2e4e1dd2635fea43, https://si.imgix.net/686bbd0d/uploads/origins/297ed401-0fb4-43d4-9542-19dabb97c185?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=40a630097368ee83ff5b4ac0964dfb57 2x, https://si.imgix.net/686bbd0d/uploads/origins/297ed401-0fb4-43d4-9542-19dabb97c185?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ad6c9333feddc5c2162f37d964ccf42d 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/686bbd0d/uploads/origins/297ed401-0fb4-43d4-9542-19dabb97c185?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=918072be0d054058ea0e63c102f450d8", "srcset": "https://si.imgix.net/686bbd0d/uploads/origins/297ed401-0fb4-43d4-9542-19dabb97c185?bg=