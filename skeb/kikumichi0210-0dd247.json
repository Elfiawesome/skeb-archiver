acceptable": true, "yearly_report_client_visible": false, "total_appeals_count": 0, "received_works": [{"path": "/@kikumichi0210/works/11", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2652919, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/40d8920e/uploads/origins/8654eeaf-663a-4ec0-a66c-cb51a9de2375?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=add3fb9e8f0316e771d3d8f42e54e18a", "srcset": "https://si.imgix.net/40d8920e/uploads/origins/8654eeaf-663a-4ec0-a66c-cb51a9de2375?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=add3fb9e8f0316e771d3d8f42e54e18a, https://si.imgix.net/40d8920e/uploads/origins/8654eeaf-663a-4ec0-a66c-cb51a9de2375?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=5ee901eaca789a52f2702a5343a8eb52 2x, https://si.imgix.net/40d8920e/uploads/origins/8654eeaf-663a-4ec0-a66c-cb51a9de2375?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=0a22ab5f076c5f3ad908d686d56016cb 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/40d8920e/uploads/origins/8654eeaf-663a-4ec0-a66c-cb51a9de2375?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f63739ddef1e653544dbedcfcb8da082", "srcset": "https://si.imgix.net/40d8920e/uploads/origins/8654eeaf-663a-4ec0-a66c-cb51a9de2375?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f63739ddef1e653544dbedcfcb8da082, https://si.imgix.net/40d8920e/uploads/origins/8654eeaf-663a-4ec0-a66c-cb51a9de2375?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=8d50c58984b8191133abb7507d1e6baf 2x, https://si.imgix.net/40d8920e/uploads/origins/8654eeaf-663a-4ec0-a66c-cb51a9de2375?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=853a1e5aafa297a479a07b6ff1ce1dc1 3x"}, "body": "リリア依頼の者です。\nリリア達の漫画の続編お願いします！\n\n〇リリア達の補足\n・落ちこぼれ同士\n人のいない所で練習をしてるが、いつもバッタリ会い、あっち行ってと喧嘩してる。だから努力をしてるのはお互いが一番よく知ってる。そこは認めあってはいるけど、だから負けたくない！マネされるのはやっぱむかつく！でも…みたいな感じ\n・実は相互使い魔になって心を一つにすれば共鳴で大きな魔法使え、さらにキスをすれば伝説の聖女と同じ魔法が発動！でも喧嘩しちゃうから不安定\n\n〇内容\n・同じ寮室から同時に出て、くっついてこないで！私より後に出てよ！と横並びで喧嘩しながら（徒歩or箒で空から）登校する二人\n\n・教室でクラスメイト達「お互いが使い魔？」「知能が高い生き物ほど契約難しいのにどうやって？」「「うっ、それは…」」　コソコソ「キスしたのは内緒よ！」「当たり前よ！キスしたなんて…」ボッ「なんで顔赤い？」「「な…何でもない！」」\n魔力の波長がよっぽど合わないと無理、契約出来る人と身分に関係なく結婚する人も居るんだって、\nみたいな話を聞いて「「リ、リリアと相性いいなんてありえない！」」\n実際は相性バッチリ＆唇同士の接触（唇はマナが流れやすい特別な部位）なので協力な契約魔法になった。普通は手など触れ合って魔法を使うとかする。\n\n・使い魔と一緒の授業\n本来は魔力を使い魔と受け渡しして魔法を使うが\nあんたが私の使い魔なんだから魔力渡しなさいよと喧嘩し、くっついて魔力を吸いあい何も起きない\n使い魔のどこかに口づけしたら魔力移しやすいと皆やってるけど嫌！\n\n・嫌なクラスメイトが、やっぱり落ちこぼれと笑う\n\n・努力をしているのをお互いが一番よく分かってるリリア達「「何も知らないくせにー！」」と怒り、心が一つになり魔法が発動する\n\n・風魔法発動！\n喜ぶが、あたしのおかげ、使い魔はそっちと喧嘩し、風魔法が暴発し飛ばされて池の中に。お互いの方に飛びながらの勢いで水中でごっちんとぶつかり事故キス\n\n・二人から不思議な光が出る、先生が伝説の魔法の光かもと驚く\n皆に今の光で池がキレイどうやったの？と言われる（水中だったのでキスは見られてない）\n\n・二人きりになって「「どんなに凄い魔法でもあんたとキスなんてもう絶対しないんだから！！」」と、内心またキスしたらどうしようと思いながら喧嘩する二人\n\nよろしくお願いします！", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@kikumichi0210/works/10", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/bd509c22/uploads/origins/e950c4f9-3926-4af9-81ec-14ef48f242a7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=398202c59ac71aeafeb209ed05ba2253", "srcset": "https://si.imgix.net/bd509c22/uploads/origins/e950c4f9-3926-4af9-81ec-14ef48f242a7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=398202c59ac71aeafeb209ed05ba2253, https://si.imgix.net/bd509c22/uploads/origins/e950c4f9-3926-4af9-81ec-14ef48f242a7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=00dfd8e1a18af675022d91ec90893575 2x, https://si.imgix.net/bd509c22/uploads/origins/e950c4f9-3926-4af9-81ec-14ef48f242a7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=a7fd09671df779dfe12eba1913bc4a5b 3x"}, "private": true, "genre": "art", "tipped": true, "creator_id": 2652919, "nc": 1}, {"path": "/@kikumichi0210/works/9", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2652919, "client_id": 2724201, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/911d1d3e/uploads/origins/7e244377-6d23-4296-afb9-09fd88e89d80?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a8bd09e1c2c3d1a537d904960861ee12", "srcset": "https://si.imgix.net/911d1d3e/uploads/origins/7e244377-6d23-4296-afb9-09fd88e89d80?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a8bd09e1c2c3d1a537d904960861ee12, https://si.imgix.net/911d1d3e/uploads/origins/7e244377-6d23-4296-afb9-09fd88e89d80?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=2e90086b82e9ca79b9ee0bf9297a8665 2x, https://si.imgix.net/911d1d3e/uploads/origins/7e244377-6d23-4296-afb9-09fd88e89d80?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=965256116e2a5636a74694eb0fa919c1 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/911d1d3e/uploads/origins/7e244377-6d23-4296-afb9-09fd88e89d80?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e7a016c4da98bc15b7923cb4ddd9ae2c", "srcset": "https://si.imgix.net/911d1d3e/uploads/origins/7e244377-6d23-4296-afb9-09fd88e89d80?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e7a016c4da98bc15b7923cb4ddd9ae2c, https://si.imgix.net/911d1d3e/uploads/origins/7e244377-6d23-4296-afb9-09fd88e89d80?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=ba667b692f2c4aa986748144c7271714 2x, https://si.imgix.net/911d1d3e/uploads/origins/7e244377-6d23-4296-afb9-09fd88e89d80?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=4b516bda5cb8529efecb2b77ea478771 3x"}, "body": "菊田みちよ先生、ここでは初めまして。\n「高梨里奈@OL美脚物語」ですわよ。\nきっかけはツイッターやインスタグラムで知りました。\n\nまもってロリポップはアニメで知りました。\nけれども当時は全く右も左も知らないままアニメをうろ覚えしていました。\n\nプリティーシリーズ「プリチャン」などのイラストが目立ったのが気になって色々手掛けているなと思いました。\n\nツイッターでリクエストをしている事を知り検討して整いましたので\n「OL美脚物語…」の高梨里奈と三崎ゆりのキャラクターを描いていただく事でリクエストを送ります。\n\nリクルートスーツを着用している高梨里奈が机の上に乗っかり\nリクルートスーツを着用している三崎ゆりがその机を叩いて叱る構図で\nお願いします。\n\n背景では先生にお任せします。\n資料はリンクにありますので確認して頂けたら幸いです。\n※指輪をはめている里奈もありますが自由に指輪を付けても構いません\n（先生が好きな場所の指輪も歓迎しますわよ）\n\n「先生が描いたら違った世界になると思い楽しみにしていますわよ（by高梨里奈）」\n\nではよろしくお願いします。\n以上\n\n【資料】「OL美脚物語…」画像\nhttps://mcnetanime.info/OL4koma/img/titlemt.jpg\n\n【ウェブサイト】\n「OL美脚物語…」ホームページ\nhttps://mcnetanime.info/OL4koma/\n\nhttps://mcnetanime.info/OL4koma/img/titlemt.jpg", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@kikumichi0210/works/8", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/197cd460/uploads/origins/225b7234-e8b0-4a65-bf17-4a99d02a4de5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=10b7f6bfe203a143316151d9d58c2c85", "srcset": "https://si.imgix.net/197cd460/uploads/origins/225b7234-e8b0-4a65-bf17-4a99d02a4de5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=10b7f6bfe203a143316151d9d58c2c85, https://si.imgix.net/197cd460/uploads/origins/225b7234-e8b0-4a65-bf17-4a99d02a4de5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=c0843fa2f590f3e1261ead8c789baea9 2x, https://si.imgix.net/197cd460/uploads/origins/225b7234-e8b0-4a65-bf17-4a99d02a4de5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=69aa3302ad69dd902881673f0a2d6dc7 3x"}, "private": true, "genre": "art", "tipped": true, "creator_id": 2652919, "client_id": 59083, "nc": 144}, {"path": "/@kikumichi0210/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2652919, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/264f3224/uploads/origins/d952171d-305c-49ee-9c75-7724397f34b4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5d310f5301f4612e6c617c7f793b76ca", "srcset": "https://si.imgix.net/264f3224/uploads/origins/d952171d-305c-49ee-9c75-7724397f34b4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5d310f5301f4612e6c617c7f793b76ca, https://si.imgix.net/264f3224/uploads/origins/d952171d-305c-49ee-9c75-7724397f34b4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ee14690c972a4a0fe6ea71d38c7fe67c 2x, https://si.imgix.net/264f3224/uploads/origins/d952171d-305c-49ee-9c75-7724397f34b4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ead4281769a2907c06d431bb9c5aec22 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/264f3224/uploads/origins/d952171d-305c-49ee-9c75-7724397f34b4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=7dcd40c713f337e9a5a53f866c9936d6", "srcset": "https://si.imgix.net/264f3224/uploads/origins/d952171d-305c-49ee-9c75-7724397f34b4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=7dcd40c713f337e9a5a53f866c9936d6, https://si.imgix.net/264f3224/uploads/origins/d952171d-305c-49ee-9c75-7724397f34b4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=06cd02511db591209185790861049bc2 2x, https://si.imgix.net/264f3224/uploads/origins/d952171d-305c-49ee-9c75-7724397f34b4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=52065b53d9a31c7b97b1d57c606a33b9 3x"}, "body": "絵柄が好みなのと、他の方の依頼の漫画が素敵だったので依頼を出させて頂きます。\nオリジナルのケンカップル百合漫画をお願いします。\n\n〇世界観\n魔法や不思議な生き物が存在する少女向け作品にあるようなメルヘンな中学校\n\n〇キャラクター\nメインキャラ二人\n・リリア・イースト\n・リリア・ウエスト\n\nそれぞれ魔法の家系の子供の魔法中学一年生\n・二人の共通設定\n二人とも王道タイプ（ラビット・スタイル）のツインテール\n前髪はパッツンでもデコ出しでも無いノーマルな感じ。\n\n名前は昔の聖女の名前から肖って付けられたもので珍しくはなく偶然被った。\n髪型は、マネしないでと喧嘩して以来、元々お気に入りの髪型なのに先に変えたら負けみたいになって、互い変える事も無くおそろい。\n\nどっちも美少女で、姿が似てるのもあって双子に間違えられたりする。\n性格もそっくりで、よくセリフがハモって、同じ事言わないでよ！ってなったりも。\n\n背丈・スタイル全く同じ（主人公タイプのちょい小柄体系）・学力、魔法の実力も常に拮抗してるライバル関係。\n\n真似しないで、などとしょっちゅう喧嘩してるが、結果的に張り合って成績は伸びてる\n\n〇内容\n\n・「「あ～もう！」」「いつもいつもマネしないでよ！」「マネしてるのはそっちじゃない！」\n「「あんたなんかに絶対負けないんだから！！」」「「同じ事言わないで！」」など、ムキーと喧嘩してる二人\n・モブ生徒は「またいつもの喧嘩かー」「喧嘩するほど仲がいいっていうよね」って言って「「よくない！！」」っと同時に否定したり\n↓\n・森で野生の生き物と使い魔契約する授業\n二人とも、行きたい所が被って先を歩こうとしてお互い肩をぶつけたりほっぺを押し付け合ったりして、「どいてよ！」「そっちが邪魔してるんじゃない！」と喧嘩して、その声で周りの生き物が逃げちゃうから、フン！と離れる\n↓\n・しばらくして、茂みからガサガサ音がする、捕まえようとして飛びつく\n↓\n・ガサガサ音はお互いだったリリア達、びっくりするも同時に飛びつこうとしてたから遅く、正面からぶつかって事故チュー\n↓\nキスが契約手続き（口以外も可だった）だったから、お互いがお互いの使い魔に。契約魔法は一年間は解除出来ない\n↓\nお互い離れる事が出来ないから寮室が一緒になり、ベットの取り合いから背中合わせで寝る\n\n細部は良い感じに調整でお願いします", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@kikumichi0210/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2652919, "client_id": 2654242, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/c8040070/uploads/origins/a365ed0b-3755-442f-b796-1179373d4f8d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6396bd9daa39c3827ae50ea3aa3ff5c1", "srcset": "https://si.imgix.net/c8040070/uploads/origins/a365ed0b-3755-442f-b796-1179373d4f8d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6396bd9daa39c3827ae50ea3aa3ff5c1, https://si.imgix.net/c8040070/uploads/origins/a365ed0b-3755-442f-b796-1179373d4f8d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c97075fbb9d5da9bb495714b61843996 2x, https://si.imgix.net/c8040070/uploads/origins/a365ed0b-3755-442f-b796-1179373d4f8d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=92f67ad697a774c75b0e5014cffd55fb 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/c8040070/uploads/origins/a365ed0b-3755-442f-b796-1179373d4f8d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=63a5038df46524e8bb3716bdaa27baf2", "srcset": "https://si.imgix.net/c8040070/uploads/origins/a365ed0b-3755-442f-b796-1179373d4f8d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=63a5038df46524e8bb3716bdaa27baf2, https://si.imgix.net/c8040070/uploads/origins/a365ed0b-3755-442f-b796-1179373d4f8d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=86e399c4656dbbbd688b8896f4f0fdd9 2x, https://si.imgix.net/c8040070/uploads/origins/a365ed0b-3755-442f-b796-1179373d4f8d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=deb9cd593acee8b18745d0da83eb8b72 3x"}, "body": "菊田みちよ先生、こんにちは！\n\n小学生の頃からまもってロリポップが大好きで、今も定期的に漫画を読み返しています🍭💞\n先生が描かれるイラスト、キャラクター、ストーリー等全てが大好きで、この度先生にイラストを描いていただけるということが夢みたいです。\n\nずっと何を描いていただこうか迷っておりましたが、読み切りでも可能とありましたので、\nレイヤー×レイアー同時収録の『BLT』の美利ちゃん、世良くん、保志くんの3人を描いていただくことは可能でしょうか？\n他にはない設定で、読んでいて小さいながらドキドキしてました…今改めて読んでもきゅんきゅんします！\n3人の今後はどうなるのか？恋に発展するのかな？と1人で想像している日々です！\n\n美利ちゃんは男装verではなく、女の子のままで、その他はおまかせでお願いできたらと思います！\n\n不都合がございましたらキャンセル、追加料金発生等ありましたら再送要請していただければと思っております。\n\nご検討のほどよろしくお願いいたします。", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@kikumichi0210/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2652919, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/ab8e0a70/uploads/origins/1879e72c-d09a-402f-8ca6-0a61434a96ad?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b0f94b98da4151efcd92476a7dc282d7", "srcset": "https://si.imgix.net/ab8e0a70/uploads/origins/1879e72c-d09a-402f-8ca6-0a61434a96ad?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b0f94b98da4151efcd92476a7dc282d7, https://si.imgix.net/ab8e0a70/uploads/origins/1879e72c-d09a-402f-8ca6-0a61434a96ad?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a55ffd166918f883bb7e2902424bae46 2x, https://si.imgix.net/ab8e0a70/uploads/origins/1879e72c-d09a-402f-8ca6-0a61434a96ad?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c574728bef9131d008490b617d0c85f5 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/ab8e0a70/uploads/origins/1879e72c-d09a-402f-8ca6-0a61434a96ad?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=45f8d7b1f4a461ac160184b6175da3ea", "srcset": "https://si.imgix.net/ab8e0a70/uploads/origins/1879e72c-d09a-402f-8ca6-0a61434a96ad?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=45f8d7b1f4a461ac160184b6175da3ea, https://si.imgix.net/ab8e0a70/uploads/origins/1879e72c-d09a-402f-8ca6-0a61434a96ad?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=1aeb671dacd5ad0c0b0867fd675b0461 2x, https://si.imgix.net/ab8e0a70/uploads/origins/1879e72c-d09a-402f-8ca6-0a61434a96ad?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=93d206fdd0f24f7268576b07401469d9 3x"}, "body": "初めまして、好みの絵柄でしたので漫画テイストな内容をお願いしたいです。\n\n●少女漫画系の絵柄\n\n登場人物\n・男の子キャラ1名\n・女の子キャラ2名(ヒロインA、ヒロインB)、2人とも長髪\n全員学生くらいのイメージ\n\n相関図\nヒロインA→男キャラ←ヒロインB\n（ヒロインAとヒロインBは犬猿の恋敵）\n\n●内容\n男キャラとヒロインAが一緒にいるところに、ヒロインBが男キャラに抱きつこうと勢いよくダイブしてくる。\n↓\nヒロインAが「させるかっ！！！」的に咄嗟に間に割り込む。\n↓\nヒロインB「ちょ…！？」、ヒロインA「ま…！？」\n↓\nヒロインBが止まり切れず、ヒロインAに顔面から激突。\n↓\n事故的に勢いよくキスしてしまうヒロインAとヒロインB。\n(お互いに大きく目を見開いて驚いた表情でキスをしてしまっている)\n↓\nヒロインAB「「～～～～～…!？(キスした状態のまま、声にならない悲鳴)」」\n↓\nヒロインAB「「お゛ぇぇぇ～～…」」\n↓\nヒロインA「(何すんのよ！)」、ヒロインB「(あんたが邪魔するからでしょ！)」的に、\n至近距離で睨み合って言い争いを始めるヒロインAとヒロインB。\n↓\nヒロインA「私のファーストキスを返して！！！」的に、ヒロインAがヒロインBにキスする\n（ヒロインAが睨みながらヒロインBに強引にキスする、ヒロインBは驚いた表情でキスされている）\n↓\nヒロインB「アンタこそ私のファーストキス返しなさいよ！！！」的に、ヒロインBがヒロインAにキスする\n（ヒロインBが睨みながらヒロインAに強引にキスし返す、ヒロインAは驚いた表情でキスされている）\n↓\nヒロインAB「「～～～～～っ…!(キスした状態のまま唸っている)」」的に、\nお互いに睨み合いながらキスを続ける2人\n↓\n男キャラ「と…とりあえず落ち着いて、一旦離れないか…？」、と場を落ち着かせようとする。\n↓\nキスしたままの状態でヒロインAとヒロインBが「「あ〝？」」と男キャラをキツく睨み付ける。\n男キャラ「なんでもないです…続けてください…」とヒロイン達に威圧され萎縮しながら呟く。\n\n\n細部などはおまかせで、描きやすいかたちで描いていただいても大丈夫ですので、\nシチュエーション等が可能でしたらよろしくお願いします。", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@kikumichi0210/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2652919, "client_id": 52853, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/8b2696cd/uploads/origins/202deafa-4909-42e0-8241-d385b4959179?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=86aeae69264e539f774e409a788c90b3", "srcset": "https://si.imgix.net/8b2696cd/uploads/origins/202deafa-4909-42e0-8241-d385b4959179?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=86aeae69264e539f774e409a788c90b3, https://si.imgix.net/8b2696cd/uploads/origins/202deafa-4909-42e0-8241-d385b4959179?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=13bdd6a535103262a0cfa655547ccd47 2x, https://si.imgix.net/8b2696cd/uploads/origins/202deafa-4909-42e0-8241-d385b4959179?bg=%23fff&auto=fo