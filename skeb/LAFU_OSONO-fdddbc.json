分の未来をハッピーエンドにするためにVtuberになる｡\n\n［使用用途］\n・SNS(X(旧Twitter)など)へ投稿､アイコンなど\n・YouTubeやTwitchなど配信時のサムネイル使用など\n魚座の魔法使いとしての活動全般で使用させていただきます。\n☆使用する際は必ずクレジットを記載させていただきます｡\n\n［希望］\n・ケモ耳と左右は切れないようにお願いしたいです……！\n・人物･宛名などを別レイヤーにしたPSDデータ､もしくは透過データをいただきたいです｡\n・もし可能でしたら表情差分をいただければ嬉しいです｡同じ構図でも異なるイメージになり見た方の解釈の幅を広めて欲しいため｡\n\n長々と大変失礼致しました。\n最後まで御一読頂けましてありがとうございます。\nご検討の程よろしくお願いします。\n\nhttps://x.com/pisceswizard/status/1672620829870530560?s=46&t=ptbVd-lrKBTRaZHsojZjZg", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@LAFU_OSONO/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2944300, "client_id": 2973452, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/4f48991b/uploads/origins/589313e1-d269-40d7-878b-fa344fa2229c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=140c1a8786fb7f3144968c0bff3d00e7", "srcset": "https://si.imgix.net/4f48991b/uploads/origins/589313e1-d269-40d7-878b-fa344fa2229c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=140c1a8786fb7f3144968c0bff3d00e7, https://si.imgix.net/4f48991b/uploads/origins/589313e1-d269-40d7-878b-fa344fa2229c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=5c1b5c8f4c42624bfcf226f39735514c 2x, https://si.imgix.net/4f48991b/uploads/origins/589313e1-d269-40d7-878b-fa344fa2229c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=66f09f53f048c0ab1afb8505b9cc06fb 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/4f48991b/uploads/origins/589313e1-d269-40d7-878b-fa344fa2229c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=267cf8aa815d3e0bcfcb98b8a8d2c5ee", "srcset": "https://si.imgix.net/4f48991b/uploads/origins/589313e1-d269-40d7-878b-fa344fa2229c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w