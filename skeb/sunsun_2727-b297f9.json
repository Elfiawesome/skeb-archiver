/drive/folders/1Bu2PAaWCs2MANlrhIpP4uffTKIAq1BKh", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@sunsun_2727/works/10", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 355114, "client_id": 3342778, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/0ad79d83/uploads/origins/8e30286e-77ee-4de6-b860-a0eac5cde6f7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=15035e9dd45e574dac933d902c2d78ff", "srcset": "https://si.imgix.net/0ad79d83/uploads/origins/8e30286e-77ee-4de6-b860-a0eac5cde6f7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=15035e9dd45e574dac933d902c2d78ff, https://si.imgix.net/0ad79d83/uploads/origins/8e30286e-77ee-4de6-b860-a0eac5cde6f7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=5315b07b43e5990893ce455f4d524639 2x, https://si.imgix.net/0ad79d83/uploads/origins/8e30286e-77ee-4de6-b860-a0eac5cde6f7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=5331f70b2b865038a8fa954a52703747 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/0ad79d83/uploads/origins/8e30286e-77ee-4de6-b860-a0eac5cde6f7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=50259a75956553d5e099e473d7591bbd", "srcset": "https://si.imgix.net/0ad79d83/uploads/origins/8e30286e-77ee-4de6-b860-a0eac5cde6f7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=50259a75956553d5e099e473d7591bbd, https://si.imgix.net/0ad79d83/uploads/origins/8e30286e-77ee-4de6-b860-a0eac5cde6f7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=d9377ccd7d88f0fe5767ff8365daa47c 2x, https://si.imgix.net/0ad79d83/uploads/origins/8e30286e-77ee-4de6-b860-a0eac5cde6f7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=35542386e96a67449fd5a315cced0909 3x"}, "body": "あなたのアートは素晴らしく、私のストリーム用のTwitchバナー（サイズは1920x480ピクセル）をぜひ依頼したいです。また、他のソーシャルメディアでもアートを使用するつもりです。\n\nアートのテーマは、希望、夢、旅、野心、運命を象徴するものです。色は青。悲しみや憂いを感じさせないようにしたい。\n\n舞台は海辺の町で、海があり、バス停が近くにある。空は昼間のような鮮やかな青色で、空には流れ星が1つ、美しい雲が浮かぶ。少女は遊び心のある身のこなしで、海を見下ろす縁台の上でバランスを取ろうとしており、目の前の縁台には黒猫が歩いている。天候は微風で、彼女のスカートと髪がなびく（参考資料4と5参照）。\n\n黒髪でバッグを持っている。彼女は同じ服を着ていて、スカートの周りには星屑が散らばっている（参考資料1）。\n\nhttps://drive.google.com/drive/folders/11J0j8KfsZ9KKSp8uz30Y8OEQYVPMnema?usp=sharing", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@sunsun_2727/works/9", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 355114, "client_id": 3300835, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/570d794b/uploads/origins/e3d150c8-ec29-42e2-9dde-9749681d38af?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=eb224bbae7eedc0ccc12bb94af0aedd6", "srcset": "https://si.imgix.net/570d794b/uploads/origins/e3d150c8-ec29-42e2-9dde-9749681d38af?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=eb224bbae7eedc0ccc12bb94af0aedd6, https://si.imgix.net/570d794b/uploads/origins/e3d150c8-ec29-42e2-9dde-9749681d38af?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a030549c6887267ba00cc27ca112ed99 2x, https://si.imgix.net/570d794b/uploads/origins/e3d150c8-ec29-42e2-9dde-9749681d38af?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=79f762fdbcfb52f446cdbe14cc724387 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/570d794b/uploads/origins/e3d150c8-ec29-42e2-9dde-9749681d38af?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=52847abb3faf1ce1c985ba90cc0ec55e", "srcset": "https://si.imgix.net/570d794b/uploads/origins/e3d150c8-ec29-42e2-9dde-9749681d38af?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=52847abb3faf1ce1c985ba90cc0ec55e, https://si.imgix.net/570d794b/uploads/origins/e3d150c8-ec29-42e2-9dde-9749681d38af?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=311cbe10083b7ec959e66edcd3d91917 2x, https://si.imgix.net/570d794b/uploads/origins/e3d150c8-ec29-42e2-9dde-9749681d38af?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=11d5e2738e7052d13713bcb81adf3408 3x"}, "body": "にーなさま\n\nお世話になっております。\nぜひにーなさまの星空をモチーフとしたイラストをリクエストしたく、依頼させて頂きます。\n\n【依頼したいもの】\nVTuber御汐かずさのイラストをお願いします。構図やテイストはお任せしたいと考えております。\n冒頭にも記載しておりますが、星空をメインモチーフとした形でお願いいたします。\n※参考として、自キャラに含まれる要素として「ストーリーテリング（魔導書+羽ペン）」「魔法」「お酒」といった要素があります（全てを含めて欲しいというわけではありません）\n\n【用途】\n① SNSやHPでの利用：XやBluesky、lit.linkや自HPでのアイコン、ヘッダ、ポストへの添付画像での利用（他素材と合わせる等、イメージを損なわないレベルでの加工を伴います）\n② 配信や動画での利用：YouTubeならびに他配信媒体でのサムネイル画像、動画内・配信内での画像使用\n③ ファンサイトでの利用：pixivFANBOXやクリエイティアでのイラスト使用\n\n【用途に関する依頼事項】\n・キャラと背景を分けたPSDファイルや透過PNGファイルでの納品を希望します\n・サムネイルなどで利用する可能性を想定し、横方向16:9での納品を希望します\n\nお忙しいところ恐縮ですが、是非ご検討いただけますと幸いです。\nどうぞよろしくお願い致します。\n\nhttps://drive.google.com/drive/folders/1_s4n-r6cnoiuWFcwH9-sc1N413YCT84W?usp=drive_link", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@sunsun_2727/works/8", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 355114, "client_id": 39298, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/6cea7a39/uploads/origins/173e0559-7201-47c7-9d78-aab0267438b0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f15b81eb2745711488f2f3433ac646e9", "srcset": "https://si.imgix.net/6cea7a39/uploads/origins/173e0559-7201-47c7-9d78-aab0267438b0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f15b81eb2745711488f2f3433ac646e9, https://si.imgix.net/6cea7a39/uploads/origins/173e0559-7201-47c7-9d78-aab0267438b0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=63b9c967e9d06c98e4ad23e066597c51 2x, https://si.imgix.net/6cea7a39/uploads/origins/173e0559-7201-47c7-9d78-aab0267438b0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=21a3243ada94ab272fea0a1de2722963 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/6cea7a39/uploads/origins/173e0559-7201-47c7-9d78-aab0267438b0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=946355b6891b75ab6f06cbbf76be07e6", "srcset": "https://si.imgix.net/6cea7a39/uploads/origins/173e0559-7201-47c7-9d78-aab0267438b0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=946355b6891b75ab6f06cbbf76be07e6, https://si.imgix.net/6cea7a39/uploads/origins/173e0559-7201-47c7-9d78-aab0267438b0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=e112ec6cbf9513be5b817672e98d6de4 2x, https://si.imgix.net/6cea7a39/uploads/origins/173e0559-7201-47c7-9d78-aab0267438b0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=bc32673d81b9cdc3f264849161dfe85c 3x"}, "body": "はじめまして。\nSkebでお見かけしたにーな先生のイラストに一目惚れしました。\n\n音楽特化のVtuberラティオ・ユィリスさんを描いて頂けないでしょうか。\nhttps://twitter.com/Ratio_Yuires/\n\n星空の下で、手を伸ばして目を閉じて歌っているような姿を描いて頂きたいです。\n\n\n2024/5/6に発表された新衣装の姿でお願いします。\n新衣装のイラスト、三面図は以下のlit.linkにあります。\nhttps://lit.link/ratiodatekanri\n\n帽子とコートが有りの姿でお願いします。\nまた、髪型は3種類有りますが、巻き髪（上記lit.linkにある三面図の髪型）でお願いします。\n\n\nラティオ・ユィリスさんの二次創作ガイドラインは以下のサイトの「二次創作ガイドライン」の蘭に記載があります。\nhttps://lit.link/RatioYuires\n\n・描いて頂いた絵を、ラティオ・ユィリスさん自身がプロモーション活動全般、SNSやYouTube等で使用させていただく事を許可頂きたいです。\n・PSDまたは背景とキャラを分けたPNGで納品いただけると嬉しいです \n\nこのような条件なのですが、\nリクエストを受けて頂けたら嬉しいです。\nよろしくお願いします。", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@sunsun_2727/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 355114, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/e81d5ce2/uploads/origins/a860fe1e-66e1-4608-bf1e-f4f566640234?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0edf806f995ccf74086c8d6ad7450bee", "srcset": "https://si.imgix.net/e81d5ce2/uploads/origins/a860fe1e-66e1-4608-bf1e-f4f566640234?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0edf806f995ccf74086c8d6ad7450bee, https://si.imgix.net/e81d5ce2/uploads/origins/a860fe1e-66e1-4608-bf1e-f4f566640234?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=0ebdb05989b56964a91db94d4bad3edf 2x, https://si.imgix.net/e81d5ce2/uploads/origins/a860fe1e-66e1-4608-bf1e-f4f566640234?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d742f0aac639e397ddeaa5d92c012c48 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/e81d5ce2/uploads/origins/a860fe1e-66e1-4608-bf1e-f4f566640234?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=1b97d2c04a73a177b6b69fe41f0f070c", "srcset": "https://si.imgix.net/e81d5ce2/uploads/origins/a860fe1e-66e1-4608-bf1e-f4f566640234?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=1b97d2c04a73a177b6b69fe41f0f070c, https://si.imgix.net/e81d5ce2/uploads/origins/a860fe1e-66e1-4608-bf1e-f4f566640234?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=75d6cc739195e9698e657a77e4acdaba 2x, https://si.imgix.net/e81d5ce2/uploads/origins/a860fe1e-66e1-4608-bf1e-f4f566640234?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=e8d1c949398e806f0179fdfdb0a90b28 3x"}, "body": "こんにちは！\nあなたの美しい画風が大好きです！私がカバーしている曲のイラストをお願いできますか？\n\nこの曲をカバーします：\nhttps://www.youtube.com/watch?v=Xo813cO-euw\n\n窓から外を眺めているOCを描いてもらえると嬉しいです。雨のシーンでも星空のシーンでも構いません。曲の雰囲気に合ったシーンを選んでください。ピンクやブルーのペットもお願いします。\n\nOCの特徴\n彗星vtuber\n優しくてチャーミングでエレガントな女の子\nブルーのドレス\nネックレスは白いパールの真ん中に紫の宝石\n下の髪は青と紫のグラデーション\n\n この画像を16:9の横長画像にしたい。この画像を透過/psdファイルにすることもできますか？レイヤー加工して、アニメーションにしたり、SNS（Twitch、YouTubeなど）で使用したいと思っています。クレジット表記はきちんとさせていただきます。ありがとうございました！\n\nOCリファレンス\nhttps://imgur.com/a/skeb-9widVtA", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@sunsun_2727/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 355114, "client_id": 2725825, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/6e5fe9ab/uploads/origins/6fc0a26f-e292-4bcc-9332-1d826fbdb280?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=53ff6eae239fb55128eddbc3024b9e50", "srcset": "https://si.imgix.net/6e5fe9ab/uploads/origins/6fc0a26f-e292-4bcc-9332-1d826fbdb280?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=53ff6eae239fb55128eddbc3024b9e50, https://si.imgix.net/6e5fe9ab/uploads/origins/6fc0a26f-e292-4bcc-9332-1d826fbdb280?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b531dee0bbc597d0b4f98e58b6fdd55a 2x, https://si.imgix.net/6e5fe9ab/uploads/origins/6fc0a26f-e292-4bcc-9332-1d826fbdb280?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a90736a3ba7949ae21d58dfeb6a41935 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/6e5fe9ab/uploads/origins/6fc0a26f-e292-4bcc-9332-1d826fbdb280?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=35376c1fc7911b3a01299851f4a5aff9", "srcset": "https://si.imgix.net/6e5fe9ab/uploads/origins/6fc0a26f-e292-4bcc-9332-1d826fbdb280?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=35376c1fc7911b3a01299851f4a5aff9, https://si.imgix.net/6e5fe9ab/uploads/origins/6fc0a