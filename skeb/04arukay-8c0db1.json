る形になりますが、私は所属する団体があり、個人勢Vtuberではありません。\n\nご検討のほどよろしくお願いします。\n\nhttps://drive.google.com/file/d/1JdGZdbsXWa3YzfzQ2yvHHHKOUOqOh49x/view?usp=drivesdk", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 2295703, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "夏凪", "screen_name": "Kanagi456", "avatar_url": "https://pbs.twimg.com/profile_images/1950259339698036736/Scjw1C32.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1250852239725359104/1624948462/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 5, "complete_expiration_days": 30, "skills": [{"genre": "music"}], "banned": false, "nc": 16}, {"id": 2643077, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "ぴの茶", "screen_name": "PINOCHAnoCHACHA", "avatar_url": "https://pbs.twimg.com/profile_images/1910919177625309184/vxyyJI-Z.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1612606919348465664/1673310839/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "art"}, {"genre": "correction"}], "banned": false, "nc": 145}, {"id": 3391616, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "キュウセイ", "screen_name": "UkkariPokkuri", "avatar_url": "https://pbs.twimg.com/profile_images/1979212236267696128/miWhmfKm.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1575086423774203904/1758636665/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "comp