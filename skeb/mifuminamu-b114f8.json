&crop=top&w=200&h=200&s=f19f8b3d0f2796d8120189ad55dd9a5a 2x, https://si.imgix.net/f54c7c1c/uploads/origins/40595167-8d1d-4d67-a23e-db2027c8df20?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=8f4e1a9abcee6e4eb78bea80591b7fe7 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/f54c7c1c/uploads/origins/40595167-8d1d-4d67-a23e-db2027c8df20?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5d3fd151d92150cd2e892854199eb9b1", "srcset": "https://si.imgix.net/f54c7c1c/uploads/origins/40595167-8d1d-4d67-a23e-db2027c8df20?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5d3fd151d92150cd2e892854199eb9b1, https://si.imgix.net/f54c7c1c/uploads/origins/40595167-8d1d-4d67-a23e-db2027c8df20?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=c4f000b58a813963d67e585fb39e06c0 2x, https://si.imgix.net/f54c7c1c/uploads/origins/40595167-8d1d-4d67-a23e-db2027c8df20?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=c816d2805f2e860e98ac9b7374141452 3x"}, "body": "はじめまして、みふみなむさん！あなたの絵が大好きです。あなたのスタイルはとても表現豊かで素晴らしい！エネルギーと個性に溢れています。TWSTとハズビンのアートも本当に大好きです！\n\nもし可能なら、私のキャラクターであるイービー（♀、白髪、172cm）、ソル（♀、茶髪、168cm）、アリスター（♂、金髪、190cm）の絵を依頼したいです。\n\nアリスターは大金持ちの弁護士で、性格は傲慢で皮肉屋。ちょっとしたいじめっ子で、他人をだましたり馬鹿にしたりするのが好きだ。ワインやウイスキーを飲むのも大好き！プライベートオフィスがあり、そこで依頼人と会う。高慢な態度とは裏腹に、一人になるとかなり陰鬱になり、人間嫌いの一面もある。ちょっとした \"ツンデレ \"だ。\n\nイヴィーはアリスターの幼なじみ。優秀な考古学者だ！口数が少なく、表情も乏しい。ほとんどの時間を調査、執筆、研究に費やしている！クールなオーラがあり、アリスターやソルのおちゃらけた態度にも動じない。\n\n最後に、ソルは2人を困らせるフリーターだ！アリスターのオフィスに泊まり込み、彼のソファでタダで寝ている。彼女はとてもエネルギッシュで、うるさく、フレンドリーだが、少々無礼で熱血漢でもある。彼女はグループの \"心臓 \"であり、パーティの中心人物だ！パイロットなので世界中を飛び回っているが、必ずアリスターとイービーを訪ねてくる。日焼け肌、そばかす、巻き毛が特徴！\n\nポーズや表情、衣装は自由に選んでください！ぜひあなたの解釈で二人の躍動感を表現してください。\nこのリクエストにそぐわなかったり、わかりにくかったりした場合は、遠慮なく却下してください！\n\n本当にありがとうございました。\n\nhttps://drive.google.com/drive/folders/15VbgG5cR2aXoz3CeOlNZA8tCdDLRRHQI?usp=sharing", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@mifuminamu/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3151586, "client_id": 177871, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/ef94a409/uploads/origins/c41ca880-cd7d-4cb4-abe9-19f5b654d963?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3aee5bc88fed2361d5b7684cde3062a2", "srcset": "https://si.imgix.net/ef94a409/uploads/origins/c41ca880-cd7d-4cb4-abe9-19f5b654d963?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3aee5bc88fed2361d5b7684cde3062a2, https://si.imgix.net/ef94a409/uploads/origins/c41ca880-cd7d-4cb4-abe9-19f5b654d963?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=690c2e2f328c903f439305349a4328fa 2x, https://si.imgix.net/ef94a409/uploads/origins/c41ca880-cd7d-4cb4-abe9-19f5b654d963?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c5c01c1ab56f1ccc0662e7c3575dfa86 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/ef94a409/uploads/origins/c41ca880-cd7d-4cb4-abe9-19f5b654d963?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=47dd31c959a608dd78202655a9adbb04", "srcset": "https://si.imgix.net/ef94a409/uploads/origins/c41ca880-cd7d-4cb4-abe9-19f5b654d963?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=47dd31c959a608dd78202655a9adbb04, https://si.imgix.net/ef94a409/uploads/origins/c41ca880-cd7d-4cb4-abe9-19f5b654d963?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=073b2a138218527590dc97ff8be9d5f3 2x, https://si.imgix.net/ef94a409/uploads/origins/c41ca880-cd7d-4cb4-abe9-19f5b654d963?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s