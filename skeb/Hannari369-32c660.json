ンセルしてしまいごめんなさい！少し書き直しました\n\n初めまして！Vtuberやっています星夢まい*です！\nはんなり先生のイラストがとてもえろ可愛いかったのでリクエストさせて頂きました！\n\n描いて頂きたいのは私の抱き枕カバーです。（下の参考画像）\n細かいポーズ、表情、先生におまかせしたいなと思います。\n参考画像では裏面は少しおっぱい出ちゃってますが出ないように下着来てもらって差分で下着有り無しお願いしたいです！\n\n使用用途\n（Youtubeのサムネイルやヘッダー、TwitterなどのSNSでの使用、FANBOXでの紹介）\nこちらはダメでしたらやりません\n（個人でのグッズ化）\n\n私の参考画像\nhttps://twitter.com/hoshimu_mai\n\n抱き枕カバーの参考画像\nhttps://booth.pm/ja/items/3484478", "nc": 160, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@Hannari369/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2740608, "client_id": 812097, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/3d4ee6ff/uploads/origins/5614dee2-1a5d-4d22-8785-6d8e40d9ee43?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3ff5c79fcb9640674b22fdab6d27c42a", "srcset": "https://si.imgix.net/3d4ee6ff/uploads/origins/5614dee2-1a5d-4d22-8785-6d8e40d9ee43?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3ff5c79fcb9640674b22fdab6d27c42a, https://si.imgix.net/3d4ee6ff/uploads/origins/5614dee2-1a5d-4d22-8785-6d8e40d9ee43?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=2e652a07be33f6e3035f911592cbd216 2x, https://si.imgix.net/3d4ee6ff/uploads/origins/5614dee2-1a5d-4d22-8785-6d8e40d9ee43?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=3a788cc3805b44d8da50b522920ffdf5 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/3d4ee6ff/uploads/origins/5614dee2-1a5d-4d22-8785-6d8e40d9ee43?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b066515f98c928dc8676cc510b8f4507", "srcset": "https://si.imgix.net/3d4ee6ff/uploads/origins/5614dee2-1a5d-4d22-8785-6d8e40d9ee43?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b066515f98c928dc8676cc510b8f4507, h