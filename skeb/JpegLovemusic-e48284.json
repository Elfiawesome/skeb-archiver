ix.net/a7701bf2/uploads/origins/48c43517-4083-4185-8fd8-9b6da19122a3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=adcc5bb673252b95d454ca8b1a55a04d 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/a7701bf2/uploads/origins/48c43517-4083-4185-8fd8-9b6da19122a3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=fb16bc00b5a1f6a687663d05f83e3d49", "srcset": "https://si.imgix.net/a7701bf2/uploads/origins/48c43517-4083-4185-8fd8-9b6da19122a3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=fb16bc00b5a1f6a687663d05f83e3d49, https://si.imgix.net/a7701bf2/uploads/origins/48c43517-4083-4185-8fd8-9b6da19122a3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=762207b7d64c82815d3af333103664f3 2x, https://si.imgix.net/a7701bf2/uploads/origins/48c43517-4083-4185-8fd8-9b6da19122a3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=c060cb81b9427713fb646ed86919b2f9 3x"}, "body": "巨乳の母娘。スマホのアプリを使った狡猾な男が、娘を従順なセックスドールにしてしまう。母親はショックでたまらないが、無頓着そうな娘が服を脱ぎ、近くにいた男たちを惹きつけるのを止められない。アプリの男は母親に犬と体を入れ替えさせる。母親は四つん這いになってよだれを垂らしながら、男たちに服を脱がされ、巨乳をもてあそばれる。男たちは娘とセックスしている間、母親は犬のように後ろから犯されながら見ている。母親は娘のアソコから精液を舐め取って大満足。ショックを受けている女子生徒がいるが、リモコンを持った男が女子生徒全員を無頓着なセックス人形に操り、公衆の面前で学校中の男とセックスしている。男は教師の机の上で娘とセックスしているところを自撮りし、母親は床に落ちた精液を舐めてテーブルの横で小便をしている。", "nc": 40, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@JpegLovemusic/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2696983, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/ac9a2a82/uploads/origins/ca73c104-3c65-4f8a-9116-c253c85c16f7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=648ff097d839583e9fab1c5be6853f2f", "srcset": "https://si.imgix.net/ac9a2a82/uploads/origins/ca73c104-3c65-4f8a-9116-c253c85c16f7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=648ff097d839583e9fab1c5be6853f2f, https://si.imgix.net/ac9a2a82/uploads/origins/ca73c104-3c65-4f8a-9116-c253c85c16f7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=19220d4f1a66b08159d0aca90a72c991 2x, https://si.imgix.net/ac9a2a82/uploads/origins/ca73c104-3c65-4f8a-9116-c253c85c16f7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=28665c586db866b65d3782b60dbbc803 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/ac9a2a82/uploads/origins/ca73c104-3c65-4f8a-9116-c253c85c16f7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=396f0d355a0266f364ba0fe61514f5e3", "srcset": "https://si.imgix.net/ac9a2a82/uploads/origins/ca73c104-3c65-4f8a-9116-c253c85c16f7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=396f0d355a0266f364ba0fe61514f5e3, https://si.imgix.net/ac9a2a82/uploads/origins/ca73c104-3c65-4f8a-9116-c253c85c16f7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=d81dac46746d3535a8b04303c894f170 2x, https://si.imgix.net/ac9a2a82/uploads/origins/ca73c104-3c65-4f8a-9116-c253c85c16f7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=88269a143aaa54429aeb89f5577f832c 3x"}, "body": "こんにちは。いつも素晴らしい作品をありがとうございます。\n初めてではありますが可能であればリクエストをお願いします。(少々マニアックかもしれません。)\n数ページほどの漫画形式のイラストになります。\n\n登場キャラクター(デザイン等はお任せします。)\n\n・お姉さん(今回の犠牲者)\n巨乳(かなりデカい)で長身でスタイル抜群の大人っぽい見た目。性格は悪くプライドが高く高飛車。\n下品なもの(下ネタなど)や不潔なものが大嫌いで人一倍身だしなみは気にしている。\n\n・売れないお笑い芸人(男)\n中年で不潔な見た目をしている。あまり入浴をしないので臭い。\n周りが引くほどの幼稚な下ネタや下品なギャグを得意とする。\nひょんな事から人を思い通りに操れる「人体操り銃」を入手している。クソガキと仲良し。\n\n・クソガキ(男)\nバカ山君のような背丈で幼稚な下ネタが大好き。\n少年向け漫画の下ネタギャグをよくクラスで披露して女子には嫌われているが男子には人気。\n売れないお笑い芸人と仲良し。\n\nストーリーの流れ。\n\n①売れないお笑い芸人(以下芸人)とクソガキが仲良く街を歩いていたら、\nたまたまその場にいたお姉さんに芸人に対して不潔や臭い、目障りなどの悪口を言われる。\n\n②腹が立った芸人は人体操り銃をお姉さんに撃ち、完全に操り人形になったお姉さんを持ち帰る。\n(操られたお姉さんの表情は無表情で生気が感じられない表情。)\n\n③数日間、入浴やムダ毛処理を禁止されたお姉さん。芸人とクソガキ二人でお姉さんを全裸にさせる。\nボーボーに生えているまん毛や腋毛を見てバカにして爆笑。\n(二人がかりで服を脱がす描写は入れて頂きたいです。)\n\n④さらに臭くなったお姉さんの体臭や汚い染み付きパンティなど、いろんな箇所を二人で嗅ぎ、\nくっせ～ｗ等のセリフを言いながらさらに爆笑する二人。\n\n⑤お姉さんに無表情で裸踊りをさせる。\n\n⑥最後に芸人とクソガキが考えた幼稚な一発ギャグを披露させられるお姉さん。\n(一発ギャグの内容等はお任せします。)\n\n要望は以上になります。\nもし分かりにくかったり描きにくい点がありましたら、 省いたりお好きに変更して頂いても問題ないです。\n(描きやすいように描いて頂けるとありがたいです) \n可能であれば今後もリクエストをさせて頂きたいです。\nよろしくお願いいたします。", "nc": 169, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@JpegLovemusic/works/4", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/7327f0c3/uploads/origins/51c5eb79-9f20-4209-948e-a0aee3ee8784?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=61d4e05879d0490404b1806b532e6902", "srcset": "https://si.imgix.net/7327f0c3/uploads/origins/51c5eb79-9f20-4209-948e-a0aee3ee8784?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=61d4e05879d0490404b1806b532e6902, https://si.imgix.net/7327f0c3/uploads/origins/51c5eb79-9f20-4209-948e-a0aee3ee8784?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=bc29749770debe6383f43be2fec7a172 2x, https://si.imgix.net/7327f0c3/uploads/origins/51c5eb79-9f20-4209-948e-a0aee3ee8784?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=676b22aad0efa051bb0d6887df03d98d 3x"}, "private": true, "genre": "art", "tipped": false, "creator_id": 2696983, "client_id": 2405813, "nc": 48}, {"path": "/@JpegLovemusic/works/3", "private_thumbnail_ima