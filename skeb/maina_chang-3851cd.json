いです(せんしちぶでもよいです)\n\n【背景など】\n森の中感を出していただければ嬉しいです。泉や川など描きやすそうな水辺のロケーションでも、陸地でもなんでもOKです。\nなくてもOKです。\n\n【その他】\n・描いて頂いた元デザインからわたしが描きやすいようにファジー化された部分が多いので、髪形や髪飾り、杖などのアレンジも大歓迎です。\n・可能ならば簡単なものでよいので表情や衣装差分等があると嬉しいです。 ※衣装の有無や構図・シチュエーションによります\n・いろいろリクエスト書いてますが「リメラちゃんをマーメイドっぽく描いてみてほしい」以上でも以下でもないので、それだけ満たせれば全部おまかせでもOKです\n\n以上がリクエストになります。ご検討いただけたら幸いです。よろしくお願いいたします！\n\nhttps://www.pixiv.net/artworks/109674093", "nc": 33, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@Drive_Line/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 47987, "client_id": 365235, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/a69e94af/uploads/origins/99ce0c6a-ea25-4c8b-a2f0-abf5e938fafc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=becd8543a973eb2ef5319531a5951655", "srcset": "https://si.imgix.net/a69e94af/uploads/origins/99ce0c6a-ea25-4c8b-a2f0-abf5e938fafc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=becd8543a973eb2ef5319531a5951655, https://si.imgix.net/a69e94af/uploads/origins/99ce0c6a-ea25-4c8b-a2f0-abf5e938fafc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=9482498c54ad5f9e60a582fe1327245e 2x, https://si.imgix.net/a69e94af/uploads/origins/99ce0c6a-ea25-4c8b-a2f0-abf5e938fafc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=fa48a1c41c9bf3ed0b722499223d3d9e 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/a69e94af/uploads/origins/99ce0c6a-ea25-4c8b-a2f0-abf5e938fafc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b790bad269b82ebcd3f197c23ae1fbd3", "srcset": "https://si.imgix.net/a69e94af/uploads/origins/99ce0c6a-ea25-4c8b-a2f0-abf5e938fafc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b790bad269b82ebcd3f197c23ae1fbd3, 