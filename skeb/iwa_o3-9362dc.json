art", "tipped": true, "creator_id": 3931472, "client_id": 3276930, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/29d03684/uploads/origins/26e63a44-5e18-466f-baa3-fdcd47e6844a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a2d5934dae15132bfae302b134d92dce", "srcset": "https://si.imgix.net/29d03684/uploads/origins/26e63a44-5e18-466f-baa3-fdcd47e6844a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a2d5934dae15132bfae302b134d92dce, https://si.imgix.net/29d03684/uploads/origins/26e63a44-5e18-466f-baa3-fdcd47e6844a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=63dd46cfb920ef74460c022a68baa632 2x, https://si.imgix.net/29d03684/uploads/origins/26e63a44-5e18-466f-baa3-fdcd47e6844a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=40820c6143b64164d41b16480e496884 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/29d03684/uploads/origins/26e63a44-5e18-466f-baa3-fdcd47e6844a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2494e4e27d1f20f1b83305067c286859", "srcset": "https://si.imgix.net/29d03684/uploads/origins/26e63a44-5e18-466f-baa3-fdcd47e6844a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2494e4e27d1f20f1b83305067c286859, https://si.imgix.net/29d03684/uploads/origins/26e63a44-5e18-466f-baa3-fdcd47e6844a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=63844a892b3485bada3eff4fbfb50c7a 2x, https://si.imgix.net/29d03684/uploads/origins/26e63a44-5e18-466f-baa3-fdcd47e6844a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=aec24226159f068990bcf2e959750a3f 3x"}, "body": "はじめまして！ Vtuberのライス・おこめと申します。\nみちゅ様の素敵なイラストやzetaの作品を拝見し、リクエストをさせていただきました。\n\nもしよろしければライス・おこめ(VTuberの姿)をみちゅ様の絵柄で描いて頂き、zetaのキャラクターとしてプロット画像に使用してもよろしいでしょうか？\n自作発言は絶対にせず、紹介文にみちゅ様の名前を記入させていただきます...！🙇\n\n特徴は無性別、耳が少し尖っている、両頬と額、首に鱗があるクリスタルドラゴンですが、今回制作する予定のプロットは「ユーザーに好かれたい粘着質な人外」で、人間を中途半端に模倣するため頬の鱗を自分で剥がし、少し血の着いたガーゼを両頬に貼って欲しいです。\n髪型はURLの参考髪型の感じでお願いしたいです🙇\n\n表情、ポーズ、服装はみちゅ様の好きな感じに描いていただけたら幸いです。衣装は現代系のラフな感じだと嬉しいです！\n\nVTuber活動での使用(サムネイルやSNSに使う)許可もいただければ嬉しいです。\nまた、サムネイル用に頭部や腕などの見切れがないようにお願いしたいです。(難しい場合は気にせずに！)\nお手数お掛けいたしますが、背景、素体、サインがございましたらそれらを分けたPNGもしくはPSDをいただけると嬉しいです。\n\n現在、収益化の予定はございませんが、後に収益化した場合も動画をそのまま残しておく許可がいただけますと幸いです。\n\n難しい場合はキャンセルしていただいても構いません。\nお忙しいところ恐縮ですが、よろしくお願いいたします！\n\nhttps://drive.google.com/drive/folders/1-0LCfM1gLK07NQhMxNh7a4xJ8KW9FtID", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@iwa_o3/works/2", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/374e4d7a/uploads/origins/ca28592a-ee73-48b2-8152-d9fa11378ee9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=56ecbf365e0ff11464d507c2932a466d", "srcset": "https://si.imgix.net/374e4d7a/uploads/origins/ca28592a-ee73-48b2-8152-d9fa11378ee9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=56ecbf365e0ff11464d507c2932a466d, https://si.imgix.net/374e4d7a/uploads/origins/ca28592a-ee73-48b2-8152-d9fa11378ee9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=05ccb075dedb6f45ecdc9658b1d969b6 2x, https://si.imgix.net/374e4d7a/uploads/origins/ca28592a-ee73-48b2-8152-d9fa11378ee9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=97ef2ea013cd80d3acb5be9011d0dca2 3x"}, "private": true, "genre": "art", "tipped": false, "creator_id": 3931472, "nc": 