p=top&w=200&h=200&blur=200&s=3a64e55a139f3a830f4abd23c2787c17 3x"}, "body": "素晴らしい作品をありがとう！\n\nホロライブのパヴォリア・レイネ、紅葉オリー、メルフィッサ・アーニャのハロウィン衣装を描いてください。彼らの衣装、ポーズ、構図、背景は完全にお任せします！\n\nまた、作品はハロウィンの頃にツイッターに投稿したいと思います。その際、必ずあなたの名前をクレジットします！\n\n依頼を検討していただき、ありがとうございました！\n\n参考資料です：\n玲音\nhttps://drive.google.com/file/d/1fGKfn4AZ-7kTFWlIZNhW23qMnkBgvlXT/view?usp=sharing\nオリー\nhttps://twitter.com/kureijiollie/status/1682458565485707265/photo/1\nアーニャ\nhttps://static.wikia.nocookie.net/virtualyoutuber/images/3/3e/Anya_Melfissa_Costume_Design.jpg/revision/latest?cb=20201206085428", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@MinamotoJONNY/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2179735, "client_id": 2706859, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/bd60afb2/uploads/origins/c6042329-465c-4d21-a42a-413796aa44ee?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=de6dc4be336706a6afc814c6643c3d24", "srcset": "https://si.imgix.net/bd60afb2/uploads/origins/c6042329-465c-4d21-a42a-413796aa44ee?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=de6dc4be336706a6afc814c6643c3d24, https://si.imgix.net/bd60afb2/uploads/origins/c6042329-465c-4d21-a42a-413796aa44ee?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=8881dbe395994bff0bf112770a429802 2x, https://si.imgix.net/bd60afb2/uploads/origins/c6042329-465c-4d21-a42a-413796aa44ee?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c86be80d2574bb6d5c0c6b30d24d8b92 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/bd60afb2/uploads/origins/c6042329-465c-4d21-a42a-413796aa44ee?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=298cd1f9cbb410a08fa37c60e61ac708", "srcset": "https://si.imgix.net/bd60a