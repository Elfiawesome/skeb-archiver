2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c7d1fbc27afec0846d30f8b5c0135504", "src_set": ""}, "body": "初めまして。\n突然のご依頼失礼いたします\nアピールを頂きリクエストさせていただきたいと思いました。\n\n今回お願いしたいのは私の考えたキャラクターの阿那らいりです。\n〇資料\nhttps://drive.google.com/drive/folders/15kT1nGX5p9G9Vj87XRDQ5dALAAw8sUax?usp=drive_link\n〇キャラ詳細\n髪：インナーカラー、アホ毛\n眼：紫、瞳：黄色\n装飾：ヘアピン、クリップ、ピアス、チョーカー\n性格：陰キャ気味、エッチな事は好き\n特徴：低身長、困り眉、にへら笑い、赤面多め\n\n\n〇使用用途\n観賞、アイコンとして使用。\n個人利用の範囲内でのグッズ作成。譲渡、販売などはいたしません。\n\n\nシチュエーションとしては、騎乗位での中出しエッチをお願いいたします。\nねこもくいぬかさんのskebでのアイコンになっている子の表情が魅力的でしたので、それに近い表情にして頂きたいです。\n可能であれば、汁だくの差分をお願いできたら嬉しく思います。\n\nまた、胸の大きなキャラなので大きく描いていただきたいです。\nアクセサリー類は構図によって見えなかったり、変えていただいても問題ありません。\n衣装や構図、背景などの部分はお任せいたします。\n\n\n\nファイル形式に関しましては、psdまたは背景を透過したキャラクターのみのファイルも同梱していただきたく思います。\nもしご承認頂けるようでしたら自由に描いていただければ幸いです。\n\n是非ともよろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/15kT1nGX5p9G9Vj87XRDQ5dALAAw8sUax?usp=drive_link", "nc": 177, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@inumonekomoku/works/110", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1957037, "client_id": 384347, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/3836a34a/uploads/origins/e6645544-8b29-4434-8969-823c2a4e2daf?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e9d78bebe8f78846496dbb9024c474c2", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/3836a34a/uploads/origins/e6645544-8b29-4434-8969-823c2a4e2daf?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=fbffee746b6bdd1ee44d61a24e7eaab6", "src_set": ""}, "body": "アピールありがとうございますはじめまして\nアイドルマスターシリーズの大和亜季さんをお願いします。\nシチュエーションはURLと同じ一糸纏わぬ全裸姿でヨガのポーズをしてるところと一糸纏わぬ全裸姿でURLの画像のポーズをしているのをお願いします。表情は笑顔です。\n良ければよろしくお願いします。\n\nシチュエーションの画像:https://skeb.jp/@Catsoul_Project/works/8、https://skeb.jp/@Catsoul_Project/works/3", "nc": 160, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@inumonekomoku/works/109", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1957037, "client_id": 236677, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/b3a356ba/uploads/origins/af82a377-db79-415a-b2d4-6c07ab44dc78?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2986d65803077e0f7e21401e10ec5768", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/b3a356ba/uploads/origins/af82a377-db79-415a-b2d4-6c07ab44dc78?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f1b1a065e15b1128f06dc3ec9f2a64c6", "src_set": ""}, "body": "アピールありがとうございます！\nぜひうちの子をお願いします。\n\nねこもくいぬかさんの作品(https://www.pixiv.net/artworks/98451694)\nこちらの子ぐらいのむちむち感で衣装の食い込み具合等、構図や表情等はすべてお任せします！\n\nよろしくお願いいたします！\n\nhttps://drive.google.com/drive/folders/11b8-uErBxAcKC0U62zwG4QckpSNx9v85?usp=sharing", "nc": 48, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@inumonekomoku/works/108", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1957037, "client_id": 350376, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/af5b307c/uploads/origins/4346f6ea-0e56-4c6a-a9a2-df6ad07ec776?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d7013bda191d76dd11b04432fe8bf5e3", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/af5b307c/uploads/origins/4346f6ea-0e56-4c6a-a9a2-df6ad07ec776?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=83db6496bb6e3498ab044ecc19fc58bd", "src_set": ""}, "body": "こんにちは！\n\n背が高くてカーヴィーな女の子をたくさん描いていらっしゃるようなので、私のキャラクターを思いっきりマッシブに描いていただけませんか？\n私のキャラクターは、あなたが望むように巨大に描かれたものをリクエストしたいです。私の唯一の希望は\nピチピチの夏服を着ていること。\nhttps://skeb.jp/@inumonekomoku/works/83 や https://skeb.jp/@inumonekomoku/works/51 のような。\n服が小さすぎて体に食い込んでいるはずだ。\nそれ以外は好きにすればいい！\n\n改めまして、アピールありがとうございました！\n\nhttps://files.sizecraft.net/~yagokoro/commission_refs/inumonekomoku/2024-08-13_Soon-Yi_appeal/", "nc": 177, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@inumonekomoku/works/107", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1957037, "client_id": 555096, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/e48bd22c/uploads/origins/f24908bc-1cde-4e50-a9d7-d2e47fad53a9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=32b4e27d632cdeffecdbfcc876a9ae18", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/e48bd22c/uploads/origins/f24908bc-1cde-4e50-a9d7-d2e47fad53a9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=98923a1068d75c60c59a01cd68363fd4", "src_set": ""}, "body": "ご挨拶アピールを見ました。私のOCカウガールを描いてくれませんか？\n\nキャラクターリファレンス\nhttps://drive.google.com/drive/u/0/folders/1EhyH-6upPkk6vjl8jQYJKz8-dStTZCWt\nhttps://drive.google.com/file/d/1msIF1HOPcFVuIql292RntvlHB16EGGFw/view?usp=drive_link\n\n大柄で体格の良いカウガールで、おてんばな性格。フィットネスやボーイッシュなアクティビティに興味があるようです。あるいは、彼女自身の体のセクシーな魅力に関しては無頓着であることを示すアートもいい。\n\n彼女がどれだけ豊満であるかは、アーティストの選択に委ねたい！\n\n注意：\n-乳首はあまり大きくしないでください。できれば、乳首も何らかのトップで覆われている方がいいです。\n\n-ミノタウロスの女の子で、下半身はこの写真と似ています：[https://skeb.jp/@inumonekomoku/works/21 ]。\n\n-彼女の巨大な胸が上に載るのに十分な大きさのお腹を妊娠した。もしお気に召さないようでしたら、この点はオプションとお考えください。\n\nhttps://drive.google.com/drive/u/0/folders/1EhyH-6upPkk6vjl8jQYJKz8-dStTZCWt", "nc": 177, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@inumonekomoku/works/106", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1957037, "client_id": 208885, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/bdd55203/uploads/origins/239b3bd4-2e42-4f4a-991f-8217301e0c5a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e189afb0f145d1dd0ec027075857184f", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/bdd55203/uploads/origins/239b3bd4-2e42-4f4a-991f-8217301e0c5a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=08ab476f3ef5805bad6b098bfbfe7b20", "src_set": ""}, "body": "初めまして。\nねこもくいぬか様の絵が非常に好みだったので依頼させて頂きます。\nぜひねこもくいぬか様の絵で、超爆乳プリキュアを見てみたいと重い、ご依頼させて頂きます。\n\n･キャラ\nキュアムーンライト（ハートキャッチプリキュア!）（立ち絵は資料に）\n\n・衣装\n変身後の姿だが、胸や股間部分が丸出しの痴女コスのイメージ\n胸部分は真ん中のフリルのような所だけ残して、横から爆乳が飛び出している（一定の大きさ以上だとフリルは谷間の中に消えそう）\n股部分はスカートが上過ぎて股間丸出しみたいな感じ\n他の方の絵ですが、ピッタリな物があったので資料に掲載しています\nただ正直大きさ的にどれだけ見えるのか？みたいな所はあるので、そこはバランス見て出来る所はやって頂ければと思います。\n\n・体型\n爆乳で、太もももぶっとくお願いしたい。\n出来れば胸に段階が欲しい（https://skeb.jp/@inumonekomoku/works/99 みたいに…ここまで細かくなくても良いです）\n資料の方に欲しい段階2つと、余裕があれば欲しい段階を置いておきますので、ご参考にしてください。\n体型的に背は高くないと実現不可能だと思うので、好きなだけ高くしてください。\n\n・シチュエーション、構図\n構図は基本おまかせ。キャラに合っていて、爆乳がしっかり見えていればOK\nただ表情は凛々しい感じで、痴女コスである事を全く気にしていない感じにして欲しいです。（なんの違和感もなく変身してプリキュアとして戦おうとしている・戦うみたいな感じ）\n他表情等頂ける場合はお任せします\n\n少し細かめに書きましたが、あくまでもイメージではあるので、ある程度描きやすいようにしていただいて構いません\n良ければ、背景透過等をしたいので、非結合PSDで頂けると嬉しいです。（差分も面倒であればレイヤー毎に分けて頂いていれば、こちらでやります）\n\n勝手が分からないので、とりあえずおすすめ価格に少しだけプラスさせて頂いた価格でお送りしましたが、価格や資料などに問題があれば、お気軽に再送ください。\n\nどうかよろしくお願い致します。\n\nhttps://drive.google.com/drive/folders/11JIbicRaI0Fboh_qy0q2m8xFuhCxqgiq?usp=sharing", "nc": 33, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@inumonekomoku/works/105", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1957037, "client_id": 68662, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/152e0760/uploads/origins/b8367836-d755-413b-b258-33fba8349d86?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d1849476378b9e432dbaea3ab59e101a", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/152e0760/uploads/origins/b8367836-d755-413b-b258-33fba8349d86?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=691503eddae140dd54b3b2339322c098", "src_set": ""}, "body": "こんにちは、ねこもくいぬか先生！\n\n前回の作品、とても気に入りました。またイラストをお願いしてもいいですか？私のVTuberの絵をもっと描いてくれると嬉しいです！\n\n胸が強調されるようなものがいいです！前回はすべてが完璧でした。サイズもアイデアもディテールもチークも全部素敵でした！どんなものを作ってくれるのか見てみたいです。そうでなければ、アイデアが欲しいなら、胸が膨らんでワードローブの故障とか？またはサブフォルダーでアイデアを探してみてください。\n\nご検討ありがとうございました！\n\nhttps://drive.google.com/drive/u/0/folders/1FimPa9HzQV_FglWnzoi1n49xtRckMcDe", "nc": 176, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@inumonekomoku/works/104", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/d4d3b091/uploads/origins/7e6f5a22-7661-4cb1-9ced-303ea9dc673a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=134ed1d27781c9bbb9e6886cee0a2999", "src_set": ""}, "private": true, "genre": "art", "tipped": true, "creator_id": 1957037, "client_id": 0, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 163, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@inumonekomoku/works/103", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/748258cc/uploads/origins/89a9536d-9fde-4734-9baa-d2ec972135fa?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=625bd38f3b4b025a2963a2e423081303", "src_set": ""}, "private": true, "genre": "art", "tipped": true, "creator_id": 1957037, "client_id": 0, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 32, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@inumonekomoku/works/102", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1957037, "client_id": 2627372, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/99a33d30/uploads/origins/49f7279a-6e7a-48b7-98d3-769589020aaf?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a19e81f288854284273601f61b753836", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/99a33d30/uploads/origins/49f7279a-6e7a-48b7-98d3-769589020aaf?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=02cc9f7b6d5d067645d5459ecaca10d2", "src_set": ""}, "body": "こんにちは、以前にも依頼したことがあるのですが、今回もお願いしたいと思います。\n私のocの参考文献はこちら：https://drive.google.com/file/d/1whPGamLd-oUFMxl0Qy9g8Q6qlHd35-8P/view?usp=drive_link\n子宮のタトゥーで日焼けし、上半身をたくし上げて海軍を見せ、小さすぎるスカートをはいて体のラインをドヤ顔でアピールしている女子学生服を着ている彼女を描いてくれませんか？\n\nよろしくお願いします。", "nc": 48, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "similar_creators": [{"id": 4179, "creator": true, "nsfw_acceptable": true, "acceptable": false, "name": "ArumaT（あるまっと）🐬🌌🐰Ω🥕🍚🍃🥜", "screen_name": "savior0iphone", "avatar_url": "https://pbs.twimg.com/profile_images/1894524786908565504/ztHP_wse.jpg", "header_url": "https://pbs.twimg.com/profile_banners/2381244895/1740524893/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 10, "skills": [{"genre": "art"}, {"genre": "correction"}], "nc": 48}, {"id": 67419, "creator": true, "nsfw_acceptable": true, "acce