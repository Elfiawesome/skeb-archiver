常衣装でお願い致します。\n\n◯ポーズ、背景\n⇨うにゃうえ様に全体的におまかせしたいです！\n　もし、指定があった方がよい場合は、\n　うにゃうえ様のXの投稿で拝見した照れ顔や赤面や、ちょっと悪そうなお顔が非常に好きなので、いずれかでお願いしたいです…！\n(可能であれば、頭や顔に見切れのない状態でお願い致します。 )\n\n【希望納品形式】\n PNG or PSD \n可能であれば、背景透過(人物のみの透過)データもいただけましたら幸いです。\n\n［使用用途］\n・SNS(Twitter[X]、リットリンク、その他アイコンなど)での使用/紹介\n・配信告知用サムネ、動画サムネでの使用\n\n お忙しい中、大変恐縮ですが御検討宜しくお願い致します。\n\n\n▼Twitter\nhttps://x.com/Hatya_Meruru\n\nhttps://drive.google.com/drive/folders/1-_eShzlOwIya0S2SLwxnP0b4qe2oyp-4?usp=sharing", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@uni_3u/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "comic", "tipped": false, "creator_id": 3604453, "client_id": 3490175, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/7e367a79/uploads/origins/71eb8a46-73a5-4b8e-af5b-40b8fffded7a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=381b923bf31ca4b34b18bd990a220913", "srcset": "https://si.imgix.net/7e367a79/uploads/origins/71eb8a46-73a5-4b8e-af5b-40b8fffded7a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=381b923bf31ca4b34b18bd990a220913, https://si.imgix.net/7e367a79/uploads/origins/71eb8a46-73a5-4b8e-af5b-40b8fffded7a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=185ddbeddcc4dd8d952555da70fa6a81 2x, https://si.imgix.net/7e367a79/uploads/origins/71eb8a46-73a5-4b8e-af5b-40b8fffded7a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=7e71d7ff9df316b31ac487ed68d949a6 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/7e367a79/uploads/origins/71eb8a46-73a5-4b8e-af5b-40b8fffded7a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f671cc7e6eae061950e5e125421a3aca", "srcset": "https://si.imgix.net/7e367a79/uploads/origins/71eb8a46-73a5-4b8e-af5b-40b8fffded7a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&