/uploads/origins/1b571df8-ef1d-4016-8f2e-aead6a645bc4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=10de39bdc975de3986e9a6b717ee05c8 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/243c8247/uploads/origins/1b571df8-ef1d-4016-8f2e-aead6a645bc4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=226f29ada9e03724135062aad1ea595f", "srcset": "https://si.imgix.net/243c8247/uploads/origins/1b571df8-ef1d-4016-8f2e-aead6a645bc4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=226f29ada9e03724135062aad1ea595f, https://si.imgix.net/243c8247/uploads/origins/1b571df8-ef1d-4016-8f2e-aead6a645bc4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=5dabf43506b992c53a158502d2e99ead 2x, https://si.imgix.net/243c8247/uploads/origins/1b571df8-ef1d-4016-8f2e-aead6a645bc4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=d7528ff38528c4fef90ca4ddd7a991bb 3x"}, "body": "★ﾐ一様\n\n普段から素敵なイラストを拝見して楽しく見させていただいてます。この度は、私がTRPGで使用しているキャラクターの私服姿の立ち絵を描いていただきたいと思い、ご連絡させていただきました。\n以下の内容でリクエストを送らせていただきます。\n\n依頼内容\n差し支えなければ、私がTRPG「四季送り」というシナリオで使用しているキャラクターである「菊咲絡繰」の私服姿をデザインして描いていただきたいです。\n\n・使用用途\nTRPGでの使用\nSNSのアイコンやヘッダーでの利用\nスマホやPCの壁紙での使用\nSkeb依頼時の参考資料として掲載\n（商用利用はございません）\n\n・キャラについて\n名前：菊咲 絡繰（きくざき からくり）\n男性/17歳/169 cm\n京都の一角にある「あび」という甘味処で配膳とHPの作成（広報）をしています。クールビューティな容姿で、いつもニコニコ配膳をしており、若い子より熟年層に人気が高いです。また、自作の配膳用からくり人形と共に配膳を行っています。マイペースなところはありますが、与えられた仕事はしっかりこなす性格です。裏の顔は芸術を好む暗殺者で、絡繰はからくり人形を使用した暗殺を得意としています。秋をイメージしたキャラクターで、菊や紅葉が好みです。\nピアスやチョーカーなど彼氏がくれたアクセサリーをよく身に着けており、特にチョーカーをとてもお気に入りです。\n参考資料で来ている服は「あび」の制服になります。\n\nビジュアルは以下のURLに参考資料として立ち絵をまとめています。\nhttps://drive.google.com/drive/folders/1fwrWn6LMduNMXfqIRO7UUZ3D6EH7TF8o?usp=sharing\n---------------------------------------\n構図やシチュエーション、ポーズ、服装等は好きにしていただいて構いません。\n内容や金額が合わない場合は、キャンセルまたは再送要請等をお願いいたします。長文失礼いたしました。\n\nお忙しいところ恐縮ですが、何卒よろしくお願い申し上げます。\n\nhttps://drive.google.com/drive/folders/1fwrWn6LMduNMXfqIRO7UUZ3D6EH7TF8o?usp=sharing", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 1325714, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "夏越", "screen_name": "nagoshi008", "avatar_url": "https://pbs.twimg.com/profile_images/1502613263229779972/G2u_QoOr.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1404806600553025552/1626080051/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "art"}, {"genre": "correction"}], "banned": false, "nc": 176}, {"id": 2340277, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "和泉コヨミ", "screen_name": "izumi_koyomi", "avatar_url": "https://pbs.twimg.com/profile_images/1923338449391869952/4X_dPJxR.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1532344104285138944/1778856544/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 7, "complete_expiration_days": 60, "skills": [{"genre": "art"}], "banned": false, "nc": 129}, {"id": 3147300, "creator": true, "nsfw_acceptable": false, "acceptable": false, "name": "Ko-dai", "screen_name": "yae_kanai0530", "avatar_url": "https://pbs.twimg.com/profile_images/1307307465235595268/tQOxVLPy.jpg", "header_url": "https://pbs.twimg.com/profile_banners/868276862618816514/1754573638/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 10, "complete_expiration_days": 60, "skill