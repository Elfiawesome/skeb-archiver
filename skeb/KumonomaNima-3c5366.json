round, people, signatures, etc.\n\nUsage\nWe plan to use it in places where we monetize our activities in general (YouTube, Twitter, FANBOX, etc.).\nThumbnails, OP/ED, videos, etc.\n\n---Thumbnails, OP/ED, videos, etc.\nThat's all!\nThank you for your consideration!", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@ktr_pny/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 67456, "client_id": 2694328, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/e44981a0/uploads/origins/8ed44027-8d3f-4131-9a09-107de8a2eb40?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ac90adabede0199bc1898ac2f2336143", "srcset": "https://si.imgix.net/e44981a0/uploads/origins/8ed44027-8d3f-4131-9a09-107de8a2eb40?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ac90adabede0199bc1898ac2f2336143, https://si.imgix.net/e44981a0/uploads/origins/8ed44027-8d3f-4131-9a09-107de8a2eb40?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e9ea5f635a7a384727e717c1fb5f7018 2x, https://si.imgix.net/e44981a0/uploads/origins/8ed44027-8d3f-4131-9a09-107de8a2eb40?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=9133e90dabeae3302421c83ef37af62d 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/e44981a0/uploads/origins/8ed44027-8d3f-4131-9a09-107de8a2eb40?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6401111bfbbf9bfdf119c7a0d882e1a9", "srcset": "https://si.imgix.net/e44981a0/uploads/origins/8ed44027-8d3f-4131-9a09-107de8a2eb40?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6401111bfbbf9bfdf119c7a0d882e1a9, https://si.imgix.net/e44981a0/uploads/origins/8ed44027-8d3f-4131-9a09-107de8a2eb40?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit