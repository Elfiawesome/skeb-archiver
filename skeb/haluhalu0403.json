いただければと思います。（色の切り替わりの位置についてはそのままでお願いしたいです。）\n\n長くなりましたがこの内容のリクエストでお受けいただければ幸いです。\n何卒お願いいたします。\n\nhttps://drive.google.com/drive/folders/1KHzmTjOwwomisCzx_e9OAnkPe7rXSKub", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@haluhalu0403/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3468299, "client_id": 3018328, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/3c348edd/uploads/origins/b77fda14-3019-44fd-9005-499127299ec5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a118a4391a24e217e847fc96da62d1b8", "srcset": "https://si.imgix.net/3c348edd/uploads/origins/b77fda14-3019-44fd-9005-499127299ec5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a118a4391a24e217e847fc96da62d1b8, https://si.imgix.net/3c348edd/uploads/origins/b77fda14-3019-44fd-9005-499127299ec5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=792b0484ddfdfb04609217699d1bc2ee 2x, https://si.imgix.net/3c348edd/uploads/origins/b77fda14-3019-44fd-9005-499127299ec5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d2e123431fa363ea9f9374ce83bed802 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/3c348edd/uploads/origins/b77fda14-3019-44fd-9005-499127299ec5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=47726c56fc05021be48d4138f1bedc25", "srcset": "https://si.imgix.net/3c348edd/uploads/origins/b77fda14-3019-44fd-9005-499127299ec5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=47726c56fc05021be48d4138f1bedc25, https://si.imgix.net/3c348edd/uploads/origins/b77fda14-3019-44fd-9005-499127299ec5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=a8990abdc25555ad3855e61f92b3f31b 2x, https://si.imgi