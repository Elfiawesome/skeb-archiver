ます。（色の切り替わりの位置についてはそのままでお願いしたいです。）\n\n長くなりましたがこの内容のリクエストでお受けいただければ幸いです。\n何卒お願いいたします。\n\nhttps://drive.google.com/drive/folders/1KHzmTjOwwomisCzx_e9OAnkPe7rXSKub", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@haluhalu0403/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3468299, "client_id": 3018328, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/3c348edd/uploads/origins/b77fda14-3019-44fd-9005-499127299ec5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a118a4391a24e217e847fc96da62d1b8", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/3c348edd/uploads/origins/b77fda14-3019-44fd-9005-499127299ec5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=47726c56fc05021be48d4138f1bedc25", "src_set": ""}, "body": "ハルハルさん こんにちは！skeb開かれるのを待っておりました…！開設ありがとうございます！\n\n本当にハルハルさんの絵が大好きなので、速攻リクエスト送らせて頂きました！\nよろしければ、自分のocを描いて頂きたいです！\n\n構図、服装等 おまかせします！ 服装は資料の中からでも、自由に考えても大丈夫です！\n\n\n使用用途\nアイコン、ヘッダー等への使用 \n\n\n何か問題ありましたら遠慮なく再送要請おねがいします よろしくお願い致します\n\nhttps://x.com/amakisiyo/status/1958901336482759077?s=46&t=AyxNcPWwqslN9aMjrTy0nA", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "similar_creators": [{"id": 71351, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "灯花@限界ヲタク", "screen_name": "toka_bellkens", "avatar_url": "https://pbs.twimg.com/profile_images/1710314193973661696/Qkw8QpaQ.jpg", "header_url": "https://pbs.twimg.com/profile_banners/110027120/1639975210/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "skills": [{"genre": "art"}, {"genre": "novel"}, {"genre": "correction"}], "nc": 12