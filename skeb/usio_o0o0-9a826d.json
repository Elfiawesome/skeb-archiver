保護的で、自分を支配から逃れる希望とみなしている。\n代表的な動物はカワウソ🦦。\n\n何を描いても自由です。金額に満たない場合は、再度リクエストを送っていただけると助かります！この度はご依頼をお受けいただき、誠にありがとうございました！\n\nhttps://drive.google.com/drive/folders/1H_KP1SbKS3V5HggDbwvkZRe1QVk2Z6aj?usp=share_link", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@usio_o0o0/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3835289, "client_id": 1673308, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/52a3a9e1/uploads/origins/6024bd25-b0db-4117-bd32-22a912c2026f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ff93cd00870fbf6eb08b264e22c3c0ef", "srcset": "https://si.imgix.net/52a3a9e1/uploads/origins/6024bd25-b0db-4117-bd32-22a912c2026f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ff93cd00870fbf6eb08b264e22c3c0ef, https://si.imgix.net/52a3a9e1/uploads/origins/6024bd25-b0db-4117-bd32-22a912c2026f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=0973110c757b2ef07edc4606bb49e23c 2x, https://si.imgix.net/52a3a9e1/uploads/origins/6024bd25-b0db-4117-bd32-22a912c2026f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=5ae72494dadd7f742169d3a08a87f2fb 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/52a3a9e1/uploads/origins/6024bd25-b0db-4117-bd32-22a912c2026f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=7ce4a59c2d06b88503f6c6639643b924", "srcset": "https://si.imgix.net/52a3a9e1/uploads/origins/6024bd25-b0db-4117-bd32-22a912c2026f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=7ce4a59c2d06b88503f6c6639643b924, https://si.imgix.net/52a3a9e1/uploads/origins/6024bd25-b0db-4117-bd32-22a912c2026f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=e4b7c63f13f4