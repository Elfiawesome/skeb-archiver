dfe-9fd9-b7abe5e5fef3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7f7dc3ef3ccb196c1756a8db20bfc6fa", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/7390c134/uploads/origins/4340b8bb-707f-4dfe-9fd9-b7abe5e5fef3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b64b8b94aeed24b37f24284e1c0079a6", "src_set": ""}, "body": "リクエストの内容は以下のとうりです\n今回のリクエストキャラクターは\n名探偵コナンから\n工藤 有希子と妃英理です\nコスチュームはラバーシスターです\n工藤 有希子は膝下までのピンヒールのロングブーツで妃英理はピンヒールのサイハイブーツで二人の表情は悪そうに微笑んでる感じです顔を黒塗りにするかしないかは先生にまかせます\nあと乗馬鞭とバラ鞭を持たせたいですが\nどのキャラクターにどの鞭を持たせたいたいか甲乙つけがたいので先生に任せます\n資料URLの先生の作品の感じよりもう一回り下半身の肉感をアップさせてもらいたいです\nよろしくお願いいたします", "nc": 48, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@ringokuro999/works/47", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1826786, "client_id": 220108, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/2aa40977/uploads/origins/83f19472-ad3f-471b-88c8-1a8e353d201d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d8657d9e60f3bf8e3235adbc9e208a2a", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/2aa40977/uploads/origins/83f19472-ad3f-471b-88c8-1a8e353d201d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ad6c7a7035752ff15ba33ef951864131", "src_set": ""}, "body": "ラブライブの絢瀬絵里をお願いします。ハイヒール一体型の逆バニー黒ラバースーツ(首まで覆う・胴体の部分は透明のラバーかつレオタードの形状で・ペニスもラバーで覆われているが色は肌色で)を着ていて袖と襟の形状は資料1を参考にしてそれも白のラバー、リボンはライトブルーのラバーでお願いします。乳首には大きめで円形のピアス(ライトブルーの宝石が錘のようにくっついている)と鼻にも円形のピアスが通され、絵里のペニスは資料2と3の本人のを真上に勃起させた構図で、先端には太いブジーが入っていて(黒石りんごリクエスト同人誌弐の登場人物達が入れられているのと同じ形状で人差し指くらいの太さ・ザーメンがブジーの周りに滲み出している)それの先端が少し突き出しそこからリングが1つぶら下がっている先に金属のプレートに本名とスリーサイズが彫られていて、体型は資料2と3の本人と同じように爆乳・細腰・巨尻で、化粧は無しでお願いします。シチュエーションは絵里が働いているカジノバー(背景にはカジノテーブル2つが左に、バーテンダーの居るバーカウンターが右にある)に来店したというイメージで、左手にトレー(シャンパンが入ったシャンパングラス2つとカジノで使う縦に山積みされたカジノ用チップ2つ、セックスで使うローションと極太イボ付きディルドが載っている)を載せ、右手を腰に当て背筋を伸ばしたポーズ(資料4をベースに)を取っていて、やって来た客に対し笑みを浮かべて歓迎している構図(ようこそ～♪と言っているような感じで)かつ全体図でお願いします。差分として、ペニスを黒ラバーで覆ったもの、資料1のように顔までラバーで覆ったもの、顔とペニスを黒ラバーで覆ったもの、顔をラバーで覆ったものにライトブルーの口紅を塗ったもの、顔とペニスをラバーで覆ってライトブルーの口紅を塗ったものの合計6枚をお願い致します。\n\nhttps://skeb.jp/@ringokuro999/works/29\nhttps://www.pixiv.net/artworks/98352756\nhttps://pbs.twimg.com/media/F9BvpfpbUAAKcQK.jpg:orig\nhttps://www.pixiv.net/artworks/105445282", "nc": 48, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@ringokuro999/works/46", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/0bc13d9a/uploads/origins/51116d19-8f08-40e4-b28e-bd63365212fe?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=b6718b1d1ba6887b9e8f1d54104bb710", "src_set": ""}, "private": true, "genre": "art", "tipped": false, "creator_id": 1826786, "client_id": 405982, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 32, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@ringokuro999/works/45", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/b7f404fb/uploads/origins/5b909f15-1027-4a09-8c78-6df718bcb68e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=81eaa4b1c06be5decdb0137938a853d1", "src_set": ""}, "private": true, "genre": "art", "tipped": false, "creator_id": 1826786, "client_id": 0, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 49, "word_count": 0, "transcoder": "", "c