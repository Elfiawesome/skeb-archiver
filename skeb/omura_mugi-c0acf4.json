ら目を離すことはできない。\nハイパーポップやハウスミュージックなどのエレクトロサウンドが特徴だが、ロックやクラシック風のメロディーにも挑戦している。\n\n\n【イラストについて】\n・カメラ目線でかっこいい表情をしている感じのイラストを描いてほしいです。\n・距離感は近めだと嬉しいです。\n・衣装などは自由に着せ替えていただいて大丈夫です。\n\n\nご検討いただけますと幸いです。よろしくお願いいたします！", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@omura_mugi/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3519323, "client_id": 3738280, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/21b670ed/uploads/origins/ae0cfcdd-1889-4e1e-8327-c5e993d2591a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e5c3796dd33658048c1d0b79fc791294", "srcset": "https://si.imgix.net/21b670ed/uploads/origins/ae0cfcdd-1889-4e1e-8327-c5e993d2591a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e5c3796dd33658048c1d0b79fc791294, https://si.imgix.net/21b670ed/uploads/origins/ae0cfcdd-1889-4e1e-8327-c5e993d2591a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=2d2ad4c77604565bba27f55830a75686 2x, https://si.imgix.net/21b670ed/uploads/origins/ae0cfcdd-1889-4e1e-8327-c5e993d2591a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=aeb97932a27a9e876e58c8153eae710e 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/21b670ed/uploads/origins/ae0cfcdd-1889-4e1e-8327-c5e993d2591a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=67b45a2e79a2e6ad2bf3c02fb9eb629e", "srcset": "https://si.imgix.net/21b670ed/uploads/origins/ae0cfcdd-1889-4e1e-8327-c5e993d2591a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=67b45a2e79a2e6ad2bf3c02fb9eb629e, https://si.imgix.net/21b670ed/uploads/origins/ae0cfcdd-1889-4e1e-8327-c5e993d2591a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=ea6fdc03b5c9077