す❕\nわんもふ先生に再び描いて頂きたいと思いリクエストを送らせていただきます。\n\n【内容】\n私レフィーリアが初詣に晴着を着て手を合わせながら微笑んでるような表情かウィンクしてる表情かをお願いしたいです。わんもふ先生が描いて楽しい方を🙏 \n晴着は今の新衣装に近い色合いでお願いできれば【白や青（水色）を主に】\n髪型や髪飾りはそのまま使ってもらえると嬉しいです。リボンは晴着に合えば…合わなければ外してもOKです。他小物はお任せいたします。\n\n【使用用途】\nイラストはSNS（X等）や収益化したYouTube配信のサムネイル等使用させていただきたいと考えております。\n\n12月に入りお忙しい時期になりますが、何卒宜しくお願い致します。\n\nhttps://drive.google.com/drive/folders/1Eqv_D2pvu59-sMt2Bnxzi6zOaHLgKlIb?hl=ja", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@mocomoco__inu/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2662013, "client_id": 2025623, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/8d13d59d/uploads/origins/2ba92583-a02c-4728-8bdd-f4ca8279a96b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4a114cd9270e257f859c3d0eb33ba000", "srcset": "https://si.imgix.net/8d13d59d/uploads/origins/2ba92583-a02c-4728-8bdd-f4ca8279a96b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4a114cd9270e257f859c3d0eb33ba000, https://si.imgix.net/8d13d59d/uploads/origins/2ba92583-a02c-4728-8bdd-f4ca8279a96b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=db002d8f0de656ba30ce6018d5cea1f8 2x, https://si.imgix.net/8d13d59d/uploads/origins/2ba92583-a02c-4728-8bdd-f4ca8279a96b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=269fc6bd9480d869d0a3be0f17a02113 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/8d13d59d/uploads/origins/2ba92583-a02c-4728-8bdd-f4ca8279a96b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=1d2e0c22ffa87d105c3a84db17b98f78", "srcset": "https://si.imgix.net/8d13d59d/uploads/origins/2ba92583-a02c-4728-8bdd-f4ca8279a96b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=1d2e0c22ffa87d105