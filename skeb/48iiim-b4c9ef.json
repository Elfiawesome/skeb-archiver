アイコンや壁紙等、個人利用に留まる範囲で使用させていただきたいです。\n\n\n長文になりまして申し訳ありません。もし依頼内容や金額の不備、難しいようであればキャンセルしていただいて構いません！\nどうかよろしくお願いいたします……！！\n\nhttps://drive.google.com/drive/folders/1b_a3QXKo0gf9V6oK2m2DMXIN4vGfdsnS?usp=drive_link", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@48iiim/works/9", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3171730, "client_id": 2418023, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/4c0493e4/uploads/origins/5b5ecc9a-99c6-4fb3-a96e-87f3be0adb80?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2942f2beac4fc99db0b9ab354b9dd4c8", "srcset": "https://si.imgix.net/4c0493e4/uploads/origins/5b5ecc9a-99c6-4fb3-a96e-87f3be0adb80?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2942f2beac4fc99db0b9ab354b9dd4c8, https://si.imgix.net/4c0493e4/uploads/origins/5b5ecc9a-99c6-4fb3-a96e-87f3be0adb80?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=d2b7f122de552cf28831e5c58c93a16d 2x, https://si.imgix.net/4c0493e4/uploads/origins/5b5ecc9a-99c6-4fb3-a96e-87f3be0adb80?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=4d23a615e3c565fd3f45f25616fc8e9a 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/4c0493e4/uploads/origins/5b5ecc9a-99c6-4fb3-a96e-87f3be0adb80?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b5b1bce78e4c4ea021b29672da3f199e", "srcset": "https://si.imgix.net/4c0493e4/uploads/origins/5b5ecc9a-99c6-4fb3-a96e-87f3be0adb80?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b5b1bce78e4c4ea021b29672da3f199e, https://si.imgix.net/4c0493e4/uploads/origins/5b5ecc9a-99c6-4fb3-a96e-87f3be0adb80?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=7b2fad8d94dc219fe