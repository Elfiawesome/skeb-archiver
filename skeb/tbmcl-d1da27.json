op=top&w=200&h=200&blur=200&s=a61993e72042ef751e97d56fc0a2fc73, https://si.imgix.net/a0434413/uploads/origins/269345d8-05b8-4913-ba88-3f397855eb73?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=7ec72cdecf6305e6e7006848aea6aa99 2x, https://si.imgix.net/a0434413/uploads/origins/269345d8-05b8-4913-ba88-3f397855eb73?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=7f834f71d7dbc66abd377f7f23cf9996 3x"}, "body": "こんにちは！あなたの作品は本当に素敵ですね。私のオリジナルキャラクターのイラストをぜひ描いていただけないでしょうか。彼女は、片方の目を覆うほど長く、くしゃくしゃでふわふわした黒髪に、色白の肌、そして頭に蛾のような触角があります。服装については、中世風やファンタジー風の旅人といった雰囲気にしていただきたいです。具体的なデザインは決まっていないので、あなたの解釈で描いていただけると嬉しいです！ポーズや構図も自由にお任せします。お時間をいただきありがとうございます :)\n\nhttps://drive.google.com/drive/folders/19K7HJYa9SGWTSNfx3xiIR56_eFYpIieg", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@tbmcl/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3929424, "client_id": 3311347, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/474c31ed/uploads/origins/214a3cf1-5b50-4336-b603-4745a190f6bf?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=541b668a3c51cb2147375fa0937dad21", "srcset": "https://si.imgix.net/474c31ed/uploads/origins/214a3cf1-5b50-4336-b603-4745a190f6bf?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=541b668a3c51cb2147375fa0937dad21, https://si.imgix.net/474c31ed/uploads/origins/214a3cf1-5b50-4336-b603-4745a190f6bf?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=d111113b3fa1cac65c3664ec5ba4f476 2x, https://si.imgix.net/474c31ed/uploads/origins/214a3cf1-5b50-4336-b603-4745a190f6bf?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=831ca05b4432927873b1ae6ce04a5707 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https:/