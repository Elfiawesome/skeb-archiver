と人物と背景を分けてほしいです。\n\nVtberさんの情報\nお名前・星空案内人せーな\n特徴\n・ピンクと銀に近い髪色\n・青い瞳\n・特徴的な髪飾り\nまた、YouTube等で収益化して配信をされている方です。\n\nここまで読んでくださりありがとうございました。\nよろしければご検討お願いします。\n\n描いていただきたい方のTwitterアカウントと規約のURL\n規約：https://lit.link/SenaStarrySky\nアカウント：https://x.com/SenaStarrySky", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@yu9425955751711/works/5", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/e07f2df1/uploads/origins/5b25d56e-ca1f-4191-8d80-442df6613d61?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=78e36e8ae926f08f4a3fd7256607cd96", "src_set": ""}, "private": true, "genre": "art", "tipped": false, "creator_id": 3711444, "client_id": 0, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 0, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@yu9425955751711/works/4", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/0d1813ea/uploads/origins/d9e2ecdb-d033-43b2-a375-74229f39bc75?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=79c3c3229c8902200aff72900b3a5644", "src_set": ""}, "private": true, "genre": "art", "tipped": false, "creator_id": 3711444, "client_id": 0, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 16, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@yu9425955751711/works/3", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/77d5efb1/uploads/origins/29968464-0f16-48e6-b67f-8cd9955fd516?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfo