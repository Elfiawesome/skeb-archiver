ormat%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=8fd1d8dfe7da133d98e397e14ba7a51c 2x, https://si.imgix.net/51442a20/uploads/origins/2a6e2992-b048-48d1-9ad5-d4278b286a56?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=293c616e181b5ce525523f06ca214408 3x"}, "duration": null, "nsfw": true, "hardcore": true, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/51442a20/uploads/origins/2a6e2992-b048-48d1-9ad5-d4278b286a56?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5e8437c1f8b0dfe344ebc64e6e342f1a", "srcset": "https://si.imgix.net/51442a20/uploads/origins/2a6e2992-b048-48d1-9ad5-d4278b286a56?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5e8437c1f8b0dfe344ebc64e6e342f1a, https://si.imgix.net/51442a20/uploads/origins/2a6e2992-b048-48d1-9ad5-d4278b286a56?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=9ce5a33aeb48d0eb59dded4ccedcd508 2x, https://si.imgix.net/51442a20/uploads/origins/2a6e2992-b048-48d1-9ad5-d4278b286a56?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=5af57fe57f60a5f870a5b7f564a940dc 3x"}, "body": "蔵人先生の効果的な陰影に彩られた敗北ヒロイン達に魅了されての初リクエストです。六本木サディスティックナイト（株式会社ボルテージのゲーム）のヒロインの一人・響レンのイラスト希望です（マイナーな為、補足情報追記）。ご検討頂ければ幸いです。\n\n■元ネタ\n響（ひびき）レン\n27歳　160cm　47kg　B86（D）W56　H87\n元ヤンで姐御肌、優しく面倒見が良い。根は乙女チックで純粋。木刀が武器。赤髪でポニーテール、服のイメージカラーは緑。\n・公式https://sus-app.voltage.co.jp/roppongi/character/\n（六本木で、ヒロイン達のチームが裏社会の悪と対峙するストーリー）\n\n■イラスト内容\n・レンが闇組織の悪党に敗北し陵辱されている場面。\n・蔵人先生の作品（DOAたまきhttps://skeb.jp/@SEIZOU3/works/40）と似た構図。レンの上に屈強な男を入れ、マウントポジションで殴られながら犯されている。背景は路地裏。\n＜表現等＞\n・たまきのテイストで、顔や胸、全身に痣や血を散りばめ、口の右端から血がこぼれる。鼻血なし。\n・抵抗の意思や強気さを残しつつ、拳の雨に心折れかけの表情（抽象的ですみません）\n・髪型はポニーテール。\n・基本の緑シャツ（ヘソ出し・ノースリーブ）、デニムスカート。\n・服は所々破れ、左胸は露出、残った生地が乳肉に食い込む。ブラ不要。\n・折れた木刀が床面に転がる。\n\nマイナー且つ細かい設定を書き連ね恐縮です。もちろん、構図・演出等、蔵人先生のお好みで調整頂いて構いません。ご検討お願い申し上げます。\n\n■参考\nYouTube　https://www.youtube.com/watch?v=YKl4aD--3j4\nイラスト等\nhttps://w.atwiki.jp/roppongisadisticnyt/pages/82.html\nhttps://w.atwiki.jp/roppongisadisticnyt/pages/83.html\nhttps://rsdn.fukasigi.net/detail/0407\nhttps://rsdn.fukasigi.net/detail/1990\nhttps://rsdn.fukasigi.net/detail/3230\n※画像検索でもある程度ヒットすると思います", "nc": 42, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@SEIZOU3/works/69", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/c9dfc635/uploads/origins/7d61be9c-c1ba-4ec1-b3de-dc3a966ac186?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=cfc2757c2731eaa4114b02751cb80a5a", "srcset": "https://si.imgix.net/c9dfc635/uploads/origins/7d61be9c-c1ba-4ec1-b3de-dc3a966ac186?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=cfc2757c2731eaa4114b02751cb80a5a, https://si.imgix.net/c9dfc635/uploads/origins/7d61be9c-c1ba-4ec1-b3de-dc3a966ac186?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=6ac08be81e4b74d9bfa89e172651f392 2x, https://si.imgix.net/c9dfc635/uploads/origins/7d61be9c-c1ba-4ec1-b3de-dc3a966ac186?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=e0556f2b32c75cdf7bc461656da65d9c 3x"}, "private": true, "genre": "comic", "tipped": true, "creator_id": 1341787, "nc": 179}, {"path": "/@SEIZOU3/works/68", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/a189fedd/uploads/origins/689a09a4-3a90-4324-bd5c-d361ec36761a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=2ec17c2