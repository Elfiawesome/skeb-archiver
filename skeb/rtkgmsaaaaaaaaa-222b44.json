set": "https://si.imgix.net/ee923021/uploads/origins/8da07aac-2eb2-471d-a7a8-3288720efb94?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b291794d68a2ebad2574b093d51c6041, https://si.imgix.net/ee923021/uploads/origins/8da07aac-2eb2-471d-a7a8-3288720efb94?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=7011abd1fe9b12d7105395a4458284cd 2x, https://si.imgix.net/ee923021/uploads/origins/8da07aac-2eb2-471d-a7a8-3288720efb94?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=842ec3923a678256281c5c377514f56a 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/ee923021/uploads/origins/8da07aac-2eb2-471d-a7a8-3288720efb94?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=082c198c6ffc9b4a754a080eeb65d232", "srcset": "https://si.imgix.net/ee923021/uploads/origins/8da07aac-2eb2-471d-a7a8-3288720efb94?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=082c198c6ffc9b4a754a080eeb65d232, https://si.imgix.net/ee923021/uploads/origins/8da07aac-2eb2-471d-a7a8-3288720efb94?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=59c5fc102b2bb2182617de208d4c1d6a 2x, https://si.imgix.net/ee923021/uploads/origins/8da07aac-2eb2-471d-a7a8-3288720efb94?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=7613283fd1bca3048ef3d8704529aa5c 3x"}, "body": "はじめまして。にゃるぅと申します。\nskebでイラストを拝見しとてもイラストが素敵なので、是非りつかがみ様に描いて頂きたいと思った為、\nリクエストを送らせていただきました。\n\n以下の条件等ご覧いただき、\n御検討いただけますと幸いです。\n\n◎内容\n・Vtuberの「成世ななくも」さんのイラスト（FA）をお願いしたいです、本人許可済み。\n・本人がVtuber活動で使用する可能性があるので商用利用の許可をいただきたいです。（YouTube、SNS、イベント、グッズ、印刷物等） \n・背景と被写体のレイヤーが分かれている状態での納品を希望します。（表情等の差分があればとても嬉しいです！）\n\n◎希望の構図、内容\n・全身（頭から足まで）髪の毛や足が見切れないようにしていただけると助かります。\n・バレンタインをイメージしたもので、ななくもさんがチョコレートを渡してくれてるようなシチュエーションのものをお願いしたいです。可能であれば甘々なロリータ風衣装（イメージカラーの白と水色を基調とした）ものでお願いしたいです。\n・ヘアアレンジ等ご自由にお任せしたいです。\n\n詳細が分からない内容につきましては、申し訳ございませんがお任せでお願い致します。\n\n◎成世ななくもさん概要\n・イメージカラーは白と水色\n・雲が好き\n\n・日常や声の雰囲気がわかるもの\nhttps://twitter.com/NaruseNanakumo\nhttps://youtube.com/@NaruseNanakumo\n\n・三面図（以下のURLと同じものになります） \nhttps://drive.google.com/drive/mobile/folders/1W0JPkLGFnebsUNyvJ6AP_tUWqj_1qot0?usp=sharing\n\nご多忙とは思いますが、何卒よろしくお願いいたします。\n\n\n資料URL\n\nhttps://drive.google.com/drive/mobile/folders/1W0JPkLGFnebsUNyvJ6AP_tUWqj_1qot0?usp=sharing", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@rtkgmsaaaaaaaaa/works/12", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3049886, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/b36aceec/uploads/origins/5570f90d-b4ba-45c4-9e90-554fe20dd8f5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=334a5f61cc47a119bfafac1be441aa53", "srcset": "https://si.imgix.net/b36aceec/uploads/origins/5570f90d-b4ba-45c4-9e90-554fe20dd8f5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=334a5f61cc47a119bfafac1be441aa53, https://si.imgix.net/b36aceec/uploads/origins/5570f90d-b4ba-45c4-9e90-554fe20dd8f5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=5d95ec640cb286cbe24ddaeb09599846 2x, https://si.imgix.net/b36aceec/uploads/origins/5570f90d-b4ba-45c4-9e90-554fe20dd8f5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=07d3c677acabc1878f5ed26472f9216b 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/b36aceec/uploads/origins/5570f90d-b4ba-45c4-9e90-554fe20dd8f5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c21c4148e6ecadc069e44d39f5bd44a3", "srcset": "https://si.imgix.net/b36aceec/uploads/origins/5570f90d-b4ba-45c4-9e90-554fe20dd8f5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c21c4148e6ecadc069e44d39f5bd44a3, https://si.imgix.net/b36aceec/uploads/origins/5570f90d-b4ba-45c4-9e90-554fe20dd8f5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=996efc0502e165be00dc60a040382f66 2x, https://si.imgix.net/b36aceec/uploads/origins/5570f90d-b4ba-45c4-9e90-554fe20dd8f5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=3da649efa794b97479c3bd76e7f6c9f7 3x"}, "body": "初めまして！個人勢、新人VTuberの奏瀬ソラ（カナセ ソラ）と申します。\nりつかがみ様のイラストのタッチが凄く好みで、今回「奏瀬ソラ」のイラストの依頼させていただきたく、\nリクエストを送らせていただきました。\n\n【内容】\n奏瀬ソラの1枚絵で、表情はダウナーな感じで描いて頂きたいです。\n\nまた、可能であればPSDファイルで頂けると嬉しいです。\n不可であれば背景と人物の透過を分けた画像でいただけると嬉しいです。\n\n※使用用途\n・SNSのアイコン\n・YouTubeなどの動画、配信のサムネイル\n・スケジュール表\n・配信時の画像素材\n\n上記内容で問題なければよろしくお願い致します。\n\nhttps://x.com/sora_kanase/status/1796385066387742813?s=46&t=9cXI9Ki65Xt-TaTQDQ0N4w", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@rtkgmsaaaaaaaaa/works/11", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3049886, "client_id": 3192528, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/2b70ce45/uploads/origins/f7827b78-76b9-4130-9d5f-0ef88b2f7375?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=04f6b75be10d9660498ca6eb1c16870d", "srcset": "https://si.imgix.net/2b70ce45/uploads/origins/f7827b78-76b9-4130-9d5f-0ef88b2f7375?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=04f6b75be10d9660498ca6eb1c16870d, https://si.imgix.net/2b70ce45/uploads/origins/f7827b78-76b9-4130-9d5f-0ef88b2f7375?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=69479d362b85e769d38c9d6a23921f4d 2x, https://si.imgix.net/2b70ce45/uploads/origins/f7827b78-76b9-4130-9d5f-0ef88b2f7375?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=12abcc3292b4887ff7cdac8d0a711214 3x"}, "duration": null, "nsfw": false,