gix.net/66b047b9/uploads/origins/5c70f121-2e2f-46ef-95bf-948e1b51a1ff?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=f196fd721966b65cf7b665d126297bc6 2x, https://si.imgix.net/66b047b9/uploads/origins/5c70f121-2e2f-46ef-95bf-948e1b51a1ff?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=555ecd18ddda2b404b9bac9ead255e0e 3x"}, "body": "はじめまして。\n\n藤野ホーネットさんのpixivの資料URLの作品(高飛車お嬢様を屈服させるテンプレ漫画)\nの2枚目と3枚目の間にあたるような\nモノクロ漫画をリクエストさせてください。\n\nhttps://www.pixiv.net/artworks/87553954\n\n\n・シチュエーション\n頭や髪を掴んでの、口内を強引にガッツンガッツンピストンするようなイマラチオ\n\n\n\n服装は藤野ホーネットさんが描き易い物で、全裸でもかまいません。\n\n\n以上、ご検討よろしくお願いします。", "nc": 33, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@Fujinoho/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1234029, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/bb7d7d49/uploads/origins/a6cd5deb-b27e-4246-ae7d-6a63ac42d348?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2a6873f0d8a71b102ad986b6ace89533", "srcset": "https://si.imgix.net/bb7d7d49/uploads/origins/a6cd5deb-b27e-4246-ae7d-6a63ac42d348?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2a6873f0d8a71b102ad986b6ace89533, https://si.imgix.net/bb7d7d49/uploads/origins/a6cd5deb-b27e-4246-ae7d-6a63ac42d348?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=222e0e4ee3e65e8678763460ed78706b 2x, https://si.imgix.net/bb7d7d49/uploads/origins/a6cd5deb-b27e-4246-ae7d-6a63ac42d348?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=6da441e1f9a93007c73689519002a76a 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/bb7d7d49/uploads/origins/a6cd5deb-b27e-4246-ae7d-6a63ac42d348?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=4176b6bec8e5815eb5cf9cc6d18d2b8b", "srcset": "https://si.imgix.net/bb7d7d49/uploads/origins/a6cd5deb-b27e-4246-ae7d-6a63ac42d348?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=4176b6bec8e5815eb5cf9cc6d18d2b8b, https://si.imgix.net/bb7d7d49/uploads/origins/a6cd5deb-b27e-4246-ae7d-6a63ac42d348?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=12663647239df717d5aea7e6ce1ac56b 2x, https://si.imgix.net/bb7d7d49/uploads/origins/a6cd5deb-b27e-4246-ae7d-6a63ac42d348?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=5f53c94105b41752acc07d5034c1ce35 3x"}, "body": "前回はとても素晴らしい作品をありがとうございました！\nまた余裕があれば書いていただきたいと思い文章を書かせていただいています。\n\n舞台設定は\n以前と同様「催眠学級H組」\n\nキャラクターは\n攻め：「篠原玲衣」（「斎藤冬美」を追加で登場させた方がエロくなるなら追加してくれると嬉しいですがどちらでも大丈夫です。）\n受け：「堀沢花」\nでお願いします！！\n似たような関係性の新規キャラクターでも大丈夫です！\n新規キャラクターの場合、胸は大きめだと嬉しいです！\n\nシチュエーションとしては、\n攻めは主人公により別人格を植え付けられていると催眠で誤認させられ、体が勝手に動いて受けをレズレイプしてしまいます。\nまた、攻めは心の中で抵抗していますが勝手に動く身体、言葉責めに徐々に快感を覚えていきます。\n受けはレイプされていても攻めの事を信じて大きな抵抗ができず徐々に感じてしまいます。（という催眠様態になっている？）\n\n行為としては、\n攻めに空き教室に呼び出された受けですが、空き教室についたところいきなりディープキスをされてレイプされる、という感じでお願いします。\n攻めの内容は、攻めが自分と受けの上半身の服を破いて（めくって）胸をはだけさせ、乳首責めをメインでディープキスや言葉責めや貝合わせ等でレイプさせてください！！（露出描写は省略しても問題ありません！！！）\nセリフの末尾に「♡」を付けて下さい！\nまた、受けが無意識に自分または攻めの体を弄る描写があると嬉しいです！！\n\n以上、よろしくお願いします！", "nc": 169, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@Fujinoho/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1234029, "client_id": 91127, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/db0dcd5a/uploads/origins/4ea1dac6-8ea4-4a1a-82e2-bb33cc423f7d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c501a9368f6422592c5bcba014cdcad3", "srcset": "https://si.imgix.net/db0dcd5a/uploads/origins/4ea1dac6-8ea4-4a1a-82e2-bb33cc423f7d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c501a9368f6422592c5bcba014cdcad3, https://si.imgix.net/db0dcd5a/uploads/origins/4ea1dac6-8ea4-4a1a-82e2-bb33cc423f7d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=3bb26bb6b3c730a39273582fe9f0e07a 2x, https://si.imgix.net/db0dcd5a/uploads/origins/4ea1dac6-8ea4-4a1a-82e2-bb33cc423f7d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=0441fc2e81b89be6c6532a6e2e85a8a3 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/db0dcd5a/uploads/origins/4ea1dac6-8ea4-4a1a-82e2-bb33cc423f7d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=92bc0f5555388dafff37964b6504274a", "srcset": "https://si.imgix.net/db0dcd5a/uploads/origins/4ea1dac6-8ea4-4a1a-82e2-bb33cc423f7d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=92bc0f5555388dafff37964b6504274a, https://si.imgix.net/db0dcd5a/uploads/origins/4ea1dac6-8ea4-4a1a-82e2-bb33cc423f7d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=1cd863b7ad5d1e41fafac1999b313e9f 2x, https://si.imgix.net/db0dcd5a/uploads/origins/4ea1dac6-8ea4-4a1a-82e2-bb33cc423f7d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=d1a2d295e19445668042b15a334ef648 3x"}, "body": "「催眠学級H組」の『高橋さき』の2P漫画をリクエストさせていただきます。\n\n・『高橋さき』は催眠で周りから便器と認識されてる\n・トイレで妹の自慢話を隣で連れションしてる友達にするシスコン兄\n・実は兄が小便してるのは妹の口\n・『高橋さき』は意識だけ催眠解けて体は動けない状態\n\n以上、ご検討の程よろしくお願いいたします。", "nc": 168, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@Fujinoho/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1234029, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/706480b4/uploads/origins/0fe34f42-66b6-4576-9ff6-d871376bbcf0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3b75eb420b1ea6fb235c5af2985d178d", "srcset": "https://si.imgix.net/706480b4/uploads/origins/0fe34f42-66b6-4576-9ff6-d871376bbcf0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3b75eb420b1ea6fb235c5af2985d178d, https://si.imgix.net/706480b4/uploads/origins/0fe34f42-66b6-4576-9ff6-d871376bbcf0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b8d5c6746aabc81f540b0c889ccace77 2x, https://si.imgix.net/706480b4/uploads/origins/0fe34f42-66b6-4576-9ff6-d871376bbcf0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=06938cb00ec96923f0cb25121c0773be 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/706480b4/uploads/origins/0fe34f42-66b6-4576-9ff6-d871376bbcf0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9bf605da20edc8753dd760091b36dc49", "srcset": "https://si.imgix.net/706480b4/uploads/origins/0fe34f42-66b6-4576-9ff6-d871376bbcf0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9bf605da20edc8753dd760091b36dc49, https://si.imgix.net/706480b4/uploads/origins/0fe34f42-66b6-4576-9ff6-d871376bbcf0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=48e226b2787b9ad5ab5ea71711f1ac52 2x, https://si.imgix.net/706480b4/uploads/origins/0fe34f42-66b6-4576-9ff6-d871376bbcf0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=35b5ce0668c4bfe380a27e65e8d55467 3x"}, "body": "藤野ホーネットさんが描かれる表情が素敵だったので依頼させていただきました！\n\n舞台設定は\n以前描いておられた「催眠学級H組」\n\nキャラクターは\n「雨崎凛」のような巨乳クール系JKと「西村愛奈」のような巨乳可憐JKでお願いします！\n勿論、上記2人をそのまま出演させてくれてもオッケーです！！\n新規キャラクターの場合、胸は大きめだと嬉しいです！\n\nシチュエーションとしては、\n攻めは主人公により女好きにされ、受けは何をされても無反応（存在無視）状態にさせてください！\n受けは服を脱がされたり体をさわられても意識的な反応はしませんが、ディープキスを返したり乳首がたったり愛液が多少出たりとかの身体的反応は少しだけある状態です！\nまた、顔は平常のまま、赤面もなしでお願いします！\nただし、快感はどんどん蓄積されていっていて最後に一気に解放される、といった感じで！！\n\n行為としては、\nいつも通り教室で過ごしている受けに対して、攻めが乳首責めをメインでディープキスや貝合わせ等で責めていき、最後に催眠を解除された受けがイキまくってしまう、といった感じでお願いします！\nまた、セリフの末尾に「♡」を付けて下さい！\n\n以上、よろしくお願いします！", "nc": 56, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}], "sent_works": [], "similar_creators": [{"id": 30163, "creator": true, "nsfw_acceptable": true, "acceptable": false, "name": "瀬戸内：コミティアい20a", "screen_name": "blackse", "avatar_url": "https://pbs.twimg.com/profile_images/680573686756192256/k7RaFYVj.jpg", "header_url": "https://pbs.twimg.com/profile_banners/77520730/1357724105/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 120, "skills": [{"genre": "art"}, {"genre": "comic"}], "banned": false, "nc": 48}, {"id": 54414, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "YoRoZ 4 0", "screen_name": "ygdm_ER", "avatar_url": "https://proxy.misskeyusercontent.jp/avatar/media.misskeyusercontent.jp%2Fio%2F9ab64504-c238-46ed-937d-98e24c27fc38.webp%3Fsensitive%3Dtrue?avatar=1", "header_url": "https://media.misskeyusercontent.jp/io/6ba9af5a-4cc9-4e64-b5ed-f3b4e8c97bc8.png?sensitive=true", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "art"}], "banned": false, "nc": 49}, {"id": 354611, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "肉山しょくす", "screen_name": "shagene5656", "avatar_url": "https://pbs.twimg.com/profile_images/1612454747516309506/CRjL4gil.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1660004636/1544781400/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_da