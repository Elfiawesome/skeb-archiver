嬉しいです。\n\n【用途】\n個人観賞、SNS投稿\n\n金額が足りなければ変更の上再度リクエストをお願いいたします。\n\nhttps://drive.google.com/drive/folders/1aEND-gVjKGtRLlCZHdJfkO_TjlbYw8Nn", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [{"path": "/@ame_kod/works/8", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3590588, "client_id": 3552132, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/3f57f845/uploads/origins/4eb630db-6fe4-4d4f-82a0-825ebcee3827?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=524dc93d0ecf4935e0506b091a219a94", "srcset": "https://si.imgix.net/3f57f845/uploads/origins/4eb630db-6fe4-4d4f-82a0-825ebcee3827?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=524dc93d0ecf4935e0506b091a219a94, https://si.imgix.net/3f57f845/uploads/origins/4eb630db-6fe4-4d4f-82a0-825ebcee3827?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f2814fd983ab5b0996251c6aa755a2bc 2x, https://si.imgix.net/3f57f845/uploads/origins/4eb630db-6fe4-4d4f-82a0-825ebcee3827?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=6b493984626b72c411c9fe80970a7da5 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/3f57f845/uploads/origins/4eb630db-6fe4-4d4f-82a0-825ebcee3827?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9f4838b447f3bb624564767e0bbe1f89", "srcset": "https://si.imgix.net/3f57f845/uploads/origins/4eb630db-6fe4-4d4f-82a0-825ebcee3827?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9f4838b447f3bb624564767e0bbe1f89, https://si.imgix.net/3f57f845/uploads/origins/4eb630db-6fe4-4d4f-82a0-825ebcee3827?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=1f7dd43f12435a7990f13bfa8730c780 2x, https://si.imgix.net/3f57f845/uploads/origins/4eb630db-6fe4-4d4f-82a0-825ebcee3827?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=62c04de92baae02fc7d13832db578073 3x"}, "body": "こんにちは！いつも素敵なイラスト拝見しております あめこ様の絵のタッチや絵柄がとても好きなので、リクエストを送信させていただく運びとなりました🙇‍♂️\n\n【リクエスト内容】\n創作BLのイラストをお願いしたいです！\n･正義新 せいぎあらた 17歳 168cm（攻め）\n正義感のつよい男の子で、真面目ながらも不器用、いつも振り回されポジでツッコミ役です\n瞬(受け)のことは、「からかってくるので本気でムカつくこともあるけど、繊細な部分があって可愛らしいところもある。」と思っています！\n\n･前蜂瞬 まえはちまどか 17歳 178cm（受け）\n一軍の陽キャだが人に興味がなく、いつもつまんねーとどこか達観しています 性格は悪めだが繊細で傷つきやすいです \n新だけは特別で、全部が好きだし全部が可愛い その気持ちはからかうことで消化されています\n新のことは「正義感の強いチビ。痛々しい救世主。でもそこが好き。」と思っています\n\n関係性については添付リンクの中にシートなどが入っているので参考にしてください！\n\n【描いてほしいもの】\n片思いと記載されてますが今回は付き合っているifのイラストを描いてほしいです！\n構図や雰囲気はお任せしますが、BLっぽい感じが全面に出ていると大変嬉しいです\n衣装は資料に入っている制服でお願いします！\n\n【最後に】\n長々と書き連ねましたが、不明なところは好きにしていただいてかまいません🙏\n資料や料金の不備がありましたら御手数ですが再送をお願い致します。\n寒さも本番を迎えてきましたので、どうか体調崩されないようにご自愛ください🙇‍♂️💖\n\nhttps://drive.google.com/drive/folders/1utcJSzSbDEY9vPrlP8HAeXJzXV8qbHNM", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@zgkik/works/15", "private_thumbnail_image_urls": null, "private": false, "genre": "comic", "tipped": false, "creator_id": 3758663, "client_id": 3552132, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/c17d936a/uploads/origins/3babaa6a-3272-4fdf-bda1-1bb9d4fd5b4c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ab4899fb59a8e414de61ef0b4d81bd4e", "srcset": "https://si.imgix.net/c17d936a/uploads/origins/3babaa6a-3272-4fdf-bda1-1bb9d4fd5b4c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ab4899fb59a8e414de61ef0b4d81bd4e, https://si.imgix.net/c17d936a/uploads/origins/3babaa6a-3272-4fdf-bda1-1bb9d4fd5b4c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f99325e4b4601ba18300faf767cb7998 2x, https://si.imgix.net/c17d936a/uploads/origins/3babaa6a-3272-4fdf-bda1-1bb9d4fd5b4c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&