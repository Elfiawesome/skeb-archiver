=30&txt=PRIVATE&s=4c72fe1a1f04764b03aa90cf836099f4", "src_set": ""}, "private": true, "genre": "art", "tipped": false, "creator_id": 1027589, "client_id": 0, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 33, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@lol04null/works/138", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1027589, "client_id": 3327453, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/f22c1f01/uploads/origins/af2857c9-9e79-475e-8904-3240b8ecfcf4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6635684fd759bbc48e0bb9491dc69cb5", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/f22c1f01/uploads/origins/af2857c9-9e79-475e-8904-3240b8ecfcf4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=973e0f010e62dd56bdb8fe82097f98ad", "src_set": ""}, "body": "Nice to meet you 🙏I fell in love with your illustration at first sight and I'd like to request it 🙇‍♀️ sorry for any clumsiness as this is my first time and I'm requesting it in a skeev.\n\nReferences\nhttps://drive.google.com/file/d/1F2INOBLTGr-Uq2qKr8RHnp5GZPd8Itst/view?usp=drivesdk\n\nThey are two lovers.\n\nA dark-haired man with one hidden eye: a languid manga teacher. He is slender with a hunched back. He has broad shoulders but a thin waist. He wears dowdy clothes. He is an oddball who often eats in strange combinations and is oblivious to his surroundings. He has dark circles and bad eyesight. He is more than receptive at the riba. He tends to roll his partner in the palm of his hand and smile evilly. He has a mature personality. 37 years old, 177 cm. and is a kind of bad adult with a lot of sexual experience.\n\nPurple-haired guy: 22 years old, 169cm, college student. He has eyes like a full moon. He works as an assistant to the aforementioned teacher and is pushed around a lot. He is a man of common sense, but when it comes to his teacher, he has no room for complacency and is blind. He has no hesitation in killing people. He is full of emotions, easily embarrassed, and cries easily. She is more aggressive than a virgin. He is not a virgin, but his mood is that of an aggressive virgin. He wears a hoodie that is close to the overcoat.\n\nYou can complement the parts you can't see.\n\nThe location is the sea at night with a full moon.\nPose them holding hands or embracing each other, or any other composition in which they are touching each other.\nBoth of them are smiling with a satisfied look on their faces. They look as if they are satisfied with each other and are in love with each other.\n\nOther than that, I'm happy to leave it up to you.\nThank you in advance.", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@lol04null/works/137", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/e95d6655/uploads/origins/d0f82c6b-7a15-414e-bdcf-49301bcf596d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=b17a89c1901ab0728557eb5b130172e9", "src_set": ""}, "private": true, "genre": "comic", "tipped": false, "creator_id": 1027589, "client_id": 2459698, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 33, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@lol04null/works/136", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/84097e63/uploads/origins/bd431394-1818-4793-99d1-2bb1305da833?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50