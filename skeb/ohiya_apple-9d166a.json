ngsoul.club/content/%E5%B0%8F%E9%B3%A5%E9%81%8A%E9%9B%9B%E7%94%B0", "nc": 169, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@ohiya_apple/works/1", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/c11bbeaf/uploads/origins/d3f539e1-89c2-459d-bb41-e6d61ca23e32?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=61d5bcc5a8bc6f6883c244f770579912", "srcset": "https://si.imgix.net/c11bbeaf/uploads/origins/d3f539e1-89c2-459d-bb41-e6d61ca23e32?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=61d5bcc5a8bc6f6883c244f770579912, https://si.imgix.net/c11bbeaf/uploads/origins/d3f539e1-89c2-459d-bb41-e6d61ca23e32?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=72d2acc1f3ce9288de43833f822db779 2x, https://si.imgix.net/c11bbeaf/uploads/origins/d3f539e1-89c2-459d-bb41-e6d61ca23e32?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=4190427056b3ae2750422e8a6176dfb7 3x"}, "private": true, "genre": "art", "tipped": false, "creator_id": 2919310, "nc": 177}], "sent_works": [], "similar_creators": [{"id": 131247, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "がいえん", "screen_name": "jin_morisono", "avatar_url": "https://pbs.twimg.com/profile_images/1699034047299850240/PqMwPw6w.jpg", "header_url": null, "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 6, "complete_expiration_days": 120, "skills": [{"genre"