_same_genre": true}, {"path": "/@maya_maya/works/10", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2206426, "client_id": 1632689, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/32fa4129/uploads/origins/0c5ee623-5f9e-4fb2-960b-00c1f8aaa54e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3541e161b0e4e9018de7ccffda2c8ef5", "srcset": "https://si.imgix.net/32fa4129/uploads/origins/0c5ee623-5f9e-4fb2-960b-00c1f8aaa54e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3541e161b0e4e9018de7ccffda2c8ef5, https://si.imgix.net/32fa4129/uploads/origins/0c5ee623-5f9e-4fb2-960b-00c1f8aaa54e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e1979474d37dbf812252297537a36aa7 2x, https://si.imgix.net/32fa4129/uploads/origins/0c5ee623-5f9e-4fb2-960b-00c1f8aaa54e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=1eed7fe953a8b20a9f0152b900eba660 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/32fa4129/uploads/origins/0c5ee623-5f9e-4fb2-960b-00c1f8aaa54e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e12d1c0fc43c4f15db89195410b6aebe", "srcset": "https://si.imgix.net/32fa4129/uploads/origins/0c5ee623-5f9e-4fb2-960b-00c1f8aaa54e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e12d1c0fc43c4f15db89195410b6aebe, https://si.imgix.net/32fa4129/uploads/origins/0c5ee623-5f9e-4fb2-960b-00c1f8aaa54e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=bd7d0aae5bc7948d538503ff320b7baa 2x, https://si.imgix.net/32fa4129/uploads/origins/0c5ee623-5f9e-4fb2-960b-00c1f8aaa54e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=292e0244434270bd67e5f62bdc991849 3x"}, "body": "マーヤ先生、こんにちは。\n\nはじめまして。\n\n先生が描かれた艦隊これくしょんの高雄のイラストを拝見しました。https://skeb.jp/@maya_maya/works/9\n\n顔のアップがとても好きなので、リクエストさせてください。艦隊これくしょんの陽炎のイラストをお願いします。\n\n参考画像: https://cdn.imgchest.com/files/4gdcxmejqx4.jpg\n\n頭だけ見えるアップがいいです。高雄のイラストのように目隠しをして、口を大きく開けて舌を思い切り出しています。\n\n文脈については、彼女は私が指を使って喉の一番奥を弄るのが絶対に好きなのだ。私は彼女に、またそれをするつもりだから準備しておくように言った。\n\n彼女は私が喉に指を突っ込むのを待っている。私の指をとても楽しみにしているようで、舌の裏をU字型にしているのがわかる。これで喉が全開になった。彼女ののどちんこは丸見えで、外光が照らしているのでよく見える。\n彼女はとても赤面している。\n彼女はとても興奮しており、のどちんこを触ると痙攣する。\n\nご配慮ありがとうございました。", "nc": 49, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@maya_maya/works/9", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2206426, "client_id": 2643915, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/6bdedafc/uploads/origins/b52458d2-d49b-4edf-96e5-eea32074db6a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=37d69ad92adbe48ce8a8a67252d6ca68", "srcset": "https://si.imgix.net/6bdedafc/uploads/origins/b52458d2-d49b-4edf-96e5-eea32074db6a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=37d69ad92adbe48ce8a8a67252d6ca68, https://si.imgix.net/6bdedafc/uploads/origins/b52458d2-d49b-4edf-96e5-eea32074db6a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=579328f282dfa61746b81ee486f0f7ee 2x, https://si.imgix.net/6bdedafc/uploads/origins/b52458d2-d49b-4edf-96e5-eea32074db6a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=72d6093cd42f07e351d9e06c43496b81 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/6bdedafc/uploads/origins/b52458d2-d49b-4edf-96e5-eea32074db6a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a70ae36c06087f6bb120bf37f6e9be10", "srcset": "https://si.imgix.net/6bdedafc/uploads/origins/b52458d2-d49b-4edf-96e5-eea32074db6a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&c