たします。\n\n\n2枚目\n水着イラスト\nデザインはフレアビキニで、表情、配色や細かなデザイン等はお任せで行っていただきたいと考えております。\n\n構図は下記イメージでお願いします。視線は正面でお願いします。\n\n背景はおまかせします。\n\n\n参考資料\nhttps://drive.google.com/drive/folders/1TTFZ4bYWTuZUpVnr1FIPMuPcI76qKDJI?usp=sharing", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@toromo_oekaki/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2813078, "client_id": 1587516, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/349f48dc/uploads/origins/e6a2fa3a-2734-4dc3-b5a4-805fc38118de?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a80d603f80c9ef01a52f90e718656e62", "srcset": "https://si.imgix.net/349f48dc/uploads/origins/e6a2fa3a-2734-4dc3-b5a4-805fc38118de?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a80d603f80c9ef01a52f90e718656e62, https://si.imgix.net/349f48dc/uploads/origins/e6a2fa3a-2734-4dc3-b5a4-805fc38118de?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e1ba09d9b73b40278d6eab671c98139f 2x, https://si.imgix.net/349f48dc/uploads/origins/e6a2fa3a-2734-4dc3-b5a4-805fc38118de?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a336823947eae07aef530e0326b35feb 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/349f48dc/uploads/origins/e6a2fa3a-2734-4dc3-b5a4-805fc38118de?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=afb0d281d8b8694346b83f27c915b6cf", "srcset": "https://si.imgix.net/349f48dc/uploads/origins/e6a2fa3a-2734-4dc3-b5a4-805fc38118de?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=afb0d281d8b8694346b83f27c915b6cf, https://si.imgix.net/349f48dc/uploads/origins/e6a2fa3a-2734-4dc3-b5a4-805fc38118de?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=6