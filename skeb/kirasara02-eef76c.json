大丈夫です。\n描き下ろしていただいた暁にはツイッターでのヘッダーでの使用や、この2人を中心にした創作物を投稿する際のサムネイルでの使用を検討しております。\nご検討、宜しくお願いいたします😀", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@kirasara02/works/11", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 748454, "client_id": 417759, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/2aeea13a/uploads/origins/472b678b-27cd-438c-9468-e8889cce5016?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1fef19a1f2edc002190f780fc78f7a94", "srcset": "https://si.imgix.net/2aeea13a/uploads/origins/472b678b-27cd-438c-9468-e8889cce5016?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1fef19a1f2edc002190f780fc78f7a94, https://si.imgix.net/2aeea13a/uploads/origins/472b678b-27cd-438c-9468-e8889cce5016?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c9b746db21477b4dc0effd7e8180a02b 2x, https://si.imgix.net/2aeea13a/uploads/origins/472b678b-27cd-438c-9468-e8889cce5016?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=30454ce7d12324389fa192e93be07345 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/2aeea13a/uploads/origins/472b678b-27cd-438c-9468-e8889cce5016?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=fae87cd7dc817a5a0ddef09eb7764f44", "srcset": "https://si.imgix.net/2aeea13a/uploads/origins/472b678b-27cd-438c-9468-e8889cce5016?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=fae87cd7dc817a5a0ddef09eb7764f44, https://si.imgix.net/2aeea13a/uploads/origins/472b678b-27cd-438c-9468-e8889cce5016?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=17acf218baf79c50e36843a143fe9a47 2x, https://si.imgix.net/2aeea13a/uploads/origins/472b678b-27cd-438c-9468-e8889cce5016?bg=%23fff&