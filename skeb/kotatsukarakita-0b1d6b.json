ptable_same_genre": true}, {"path": "/@kotatsukarakita/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1907361, "client_id": 2634504, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/33c8b619/uploads/origins/62adda04-c3ce-4fee-9baa-05305b889252?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fa2de49934417ec0acfd9d7ca4317a1d", "srcset": "https://si.imgix.net/33c8b619/uploads/origins/62adda04-c3ce-4fee-9baa-05305b889252?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fa2de49934417ec0acfd9d7ca4317a1d, https://si.imgix.net/33c8b619/uploads/origins/62adda04-c3ce-4fee-9baa-05305b889252?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=83363a35a097ca2abd4f72fe18dac387 2x, https://si.imgix.net/33c8b619/uploads/origins/62adda04-c3ce-4fee-9baa-05305b889252?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=2674d582a49e582543a6008973821082 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/33c8b619/uploads/origins/62adda04-c3ce-4fee-9baa-05305b889252?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3bec2c27942533f475a3658d746fb5e1", "srcset": "https://si.imgix.net/33c8b619/uploads/origins/62adda04-c3ce-4fee-9baa-05305b889252?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3bec2c27942533f475a3658d746fb5e1, https://si.imgix.net/33c8b619/uploads/origins/62adda04-c3ce-4fee-9baa-05305b889252?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=e0e437b779fd52c88b85d0718fe117d8 2x, https://si.imgix.net/33c8b619/uploads/origins/62adda04-c3ce-4fee-9baa-05305b889252?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=3eea4175624e95ca7f65008c14c645ef 3x"}, "body": "こたばん様\n\nはじめまして。\nかいみんちゃんねる！のみぺんと申します。\n\n6月にVtuberデビューをしたばかりで、普段から二人体制で配信をしております。\nXに載せてらした色合いの美しさを見て、ぜひリクエストをお送りしたく思いました。\n宜しければ、かいみんちゃんねる！を描いていただけないでしょうか。\n\n人物について\n・クラゲが頭にいる方：かんら　\n・ぺんぎんが頭にいる方：みぺん　です。\n\nXにアップされておりました和装のイラストが特に好きで、今回以下の内容でお願いをさせて頂きたく存じます。\n・和装姿のかんらとみぺん\n・できればお面をつけてほしいです。かんらにはクラゲ(普段頭の上にいるクゥちゃん)、みぺんにはぺんぎん(普段頭の上にいるてっぺぇ)\n・みぺんは髪の毛編み込み風だと嬉しいです。\n・構図はお任せ致しますが、サムネイル等に使用したいため頭が切れていない構図だと嬉しいです。\n・みぺん/かんらそれぞれの透過データ(またはPSDデータ)もいただけると助かります。\n\n作成頂いたイラストは、収益化をしておりますYoutubeのサムネイルやおはようVtuber等に使用をさせて頂きたく存じます。\nまた、もし当選した暁には折角の機会ですので運営しておりますグッズサイトにて何か商用グッズを作成させていただけたらと思っております。\n(pixiv　factoryで作成できるものや、チェキにと考えております)\n\n条件など大丈夫でしたらぜひお願いできたらと思います。\n何卒ご検討の程よろしくお願いいたします。\n\n参考URL\nX：https://x.com/kaiminch_64\n\nhttps://www.youtube.com/channel/UCEuCyHGzEN4IPh6JOzi-ZKg", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@kotatsukarakita/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1907361, "client_id": 1562210, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/ba62cf5a/uploads/origins/4f82d519-6967-4bcc-b9ea-a3867116f983?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9d039608bd69422b6cb4171e2de7255e", "srcset": "https://si.imgix.net/ba62cf5a/uploads/origins/4f82d519-6967-4bcc-b9ea-a3867116f983?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9d039608bd69422b6cb4171e2de7255e, https://si.imgix.net/ba62cf5a/uploads/origins/4f82d519-6967-4bcc-b9ea-a3867116f983?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c420ace59bcdda3a9021f86f8e7b5d42 2x, https://si.imgix.net/ba62cf5a/uploads/origins/4f82d519-6967-4bcc-b9ea-a3867116f983?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=33bb0558f3258e059684c8a6f169e273 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/ba62cf5a/uploads/origins/4f82d