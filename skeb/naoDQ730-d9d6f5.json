://si.imgix.net/1c7083f5/uploads/origins/b537747c-02a9-4f85-aa92-42745132071b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=0c3f0cf55cec3acfbd0fbf800d3fe0df 3x"}, "body": "山南クラ助様、初めまして。\n銀治（誠刀）と申します。\nいきなり失礼します。\n\n素敵なウェディ族のキャラクター等を描かれており、是非ともリクエストしたくメッセージを送りました。\n\n自機の「ミオ」をお願いします。\n\n天地雷鳴士（白✖️青のソポス装備、カミュの手袋、アクセルギアが特徴）のウェディ単独の方でお願いします。\n\n構図としてですが、可能な限りで構いませんので\n・笑っていない、不機嫌そうな表情（できれば眼差しは冷たい形）\n・シリアス系\nを入れてください。\n\n背景と武器や盾は描かなくて構いません。\n\n資料はURLに載せておりますが、万が一貼れていなかったり等ございましたらスルーして構いません。\n\n長文、駄文失礼しました。\n\nhttps://drive.google.com/drive/u/0/folders/1-lam6h591WAnN8SUaYAVAGd24nzRFyxQ\n\nhttps://drive.google.com/drive/u/0/folders/1-lam6h591WAnN8SUaYAVAGd24nzRFyxQ", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@naoDQ730/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 502659, "client_id": 3557608, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/229776a6/uploads/origins/44e0b299-8602-4e9e-872b-d76aedd6bd72?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f7f2f798772c59423c0ff5033c5f02ca", "srcset": "https://si.imgix.net/229776a6/uploads/origins/44e0b299-8602-4e9e-872b-d76aedd6bd72?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f7f2f798772c59423c0ff5033c5f02ca, https://si.imgix.net/229776a6/uploads/origins/44e0b299-8602-4e9e-872b-d76aedd6bd72?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e8875fcd4cc26fbe02be0d6ddd5c6de2 2x, https://si.imgix.net/229776a6/uploads/origins/44e0b299-8602-4e9e-872b-d76aedd6bd72?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b002edd8efe1c70686093c8ac42c60d4 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/229776a6/uploads/origins/44e0b299-8602-4e9e-872b-d76aedd6bd72?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a03185517cfbe56b174a50e80f18ffd1", "srcset": "https://si.imgix.net/229776a6/uploads/origins/44e0b299-8602-4e9e-872b-d76aedd6bd72?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a03185517cfbe56b174a50e80f18ffd1, https://si.imgix.net/229776a6/uploads/origins/44e0b299-8602-4e9e-872b-d76aedd6bd72?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=6840a7a2712c795b2b0ebd0d46285800 2x, https://si.imgix.net/229776a6/uploads/origins/44e0b299-8602-4e9e-872b-d76aedd6bd72?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=566e558c5b63284209b5dc36372c6979 3x"}, "body": "初めまして。\n早速ですが描いて頂きたいイラストがあるので依頼させていただきます。\nDQ10の自キャラなんですが、以下にシチュエーションを箇条書きさせていただきます。\n\n・髪を右手でなびかせている様子\n\n・髪と右腕は後ろ(イラストでいうと向かって左側)に流れている状態\n\n・髪は少し大げさ気味に広がっている状態\n\n・顔は少しナナメでこっち向きになっている状態(顔の左側が少し見えているくらい)\n\n・右半身はほぼ真横で、背中が少し見える状態\n\n・すこし斜め下からアオリ気味の画角\n\n・視線はこちら側を向いている状態\n\n・力強くこちらを見ている状態(※睨んだり蔑んだりまではいきません)\n\n・左手は腰に手を当てている状態(多分画角的にあまり見えないと思います)\n\n・背景はおまかせします(全く思いつかないので)\n\n・足元についても全く思いつかないので上半身だけでも大丈夫です\n\n説明が下手で申し訳ないですが、全体的な状態は上記の感じです。\nよろしくお願いします。\nキャラの服装や髪型等の詳細及び、ポージングの3Dモデルについては下記URLに添付しています。\nモデリングが男ですが、キャラは女性です。\nモデリングの構造と説明文で矛盾点があると思いますが、できれば説明文のほうを優先でよろしくお願いします。\n\nhttps://ibb.co/MDfxGk2v\nhttps://ibb.co/kVvHPQ65\nhttps://ibb.co/pvY1dt2s\nhttps://ibb.co/G6XkvK6\nhttps://ibb.co/FbgPzdSm\nhttps://ibb.co/rRCXJRqv\nhttps://ibb.co/CpyXd0cj", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@naoDQ730/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 502659, "client_id": 1393227, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/0172c8e6/uploads/origins/a6a325b8-3d9e-483f-b597-fab49bf87d77?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7f9a2e5cbc37f1168bba87a455ed1182", "srcset"