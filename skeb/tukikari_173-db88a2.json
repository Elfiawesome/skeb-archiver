変申し訳ありませんが、ぜひとも好きなように描いていただけますと幸いです。\n\n描くのが難しい場合や不備がある場合は遠慮なく再送要請や拒否等していただいて構いません。\nご検討のほど、どうぞよろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/1xwBq1LY9-DySMB0p5rS2XixhDXobnViS?usp=sharing", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 32564, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "よるかげ🌃ご依頼募集中", "screen_name": "yorukage0", "avatar_url": "https://pbs.twimg.com/profile_images/2093986094140518400/QMXDxoOF.png", "header_url": "https://pbs.twimg.com/profile_banners/206895861/1684411004/1500x500", "appeal_receivable": true, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 80, "skills": [{"genre": "art"}, {"genre": "correction"}], "banned": false, "nc": 0}, {"id": 331738, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "竜田万秋🗻🐲登山系Vtuber", "screen_name": "doragon_maki", "avatar_url": "https://pbs.twimg.com/profile_images/2044623879042461696/2261nOlK.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1158361382653267968/1704503486/1500x500", "appeal_receivable": true, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "art"}, {"genre": "voice"}], "banned": false, "nc": 128}, {"id": 2731500, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "漕枝", "screen_name": "koishi", "avatar_url": "https://pbs.twimg.com/profile_images/2095812178028974080/LHtVPe0S.jpg", "header_url": null, "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration