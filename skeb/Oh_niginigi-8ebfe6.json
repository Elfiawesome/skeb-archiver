ipped": true, "creator_id": 4125147, "client_id": 2735926, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/22ea831d/uploads/origins/00dcb701-9b92-4749-a542-ea891995e9b5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1179fc216d0d8077d956b27b9c97d5d0", "srcset": "https://si.imgix.net/22ea831d/uploads/origins/00dcb701-9b92-4749-a542-ea891995e9b5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1179fc216d0d8077d956b27b9c97d5d0, https://si.imgix.net/22ea831d/uploads/origins/00dcb701-9b92-4749-a542-ea891995e9b5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=0707f1eda7930d39445e703b34f81360 2x, https://si.imgix.net/22ea831d/uploads/origins/00dcb701-9b92-4749-a542-ea891995e9b5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b4004f5d82f7fcf9d13f3ac2b3c95465 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/22ea831d/uploads/origins/00dcb701-9b92-4749-a542-ea891995e9b5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=64b18e161527120f790bece25a30f4ff", "srcset": "https://si.imgix.net/22ea831d/uploads/origins/00dcb701-9b92-4749-a542-ea891995e9b5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=64b18e161527120f790bece25a30f4ff, https://si.imgix.net/22ea831d/uploads/origins/00dcb701-9b92-4749-a542-ea891995e9b5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=8d1169e8daac6fb91653936fc6e75a92 2x, https://si.imgix.net/22ea831d/uploads/origins/00dcb701-9b92-4749-a542-ea891995e9b5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=9d7d4ea6f4daf773bcc57b6ea67e88fe 3x"}, "body": "にぎれさん‼️skebありがとうございます合法でうちのこを頼める😭\nせっかくなのでぜひうちのイタリア人たちをお願いしたいです🙏🙏🙏\n\n \n・人物 \n①テネブロ・ブラック\n29歳/男性/184cm/画家（日本画、油画など）\n南イタリアの田舎の孤児院出身。黒だけで描かれた作品が特徴。気難しくプライドが高い性格で、一見仏頂面に見えるが喜怒哀楽が激しく、表情もころころ変わりやすい。意外と面倒見が良い。嘘と綺麗事がきらい。約束を破られたり裏切られたりする事を許さない。\n同じ孤児院で育った同い年の幼馴染のルーチェ（②）が才能ある天才型の絵描きであり、彼へのライバル心から絶対に画家になると躍起になっていた。12歳の頃に孤児院を出て、色々あって画家として大成し、かなり丸くなった。孤児院を出て以来十数年ぶりに幼馴染に連絡を取り、素直になりきれずとも幼馴染に寄りかかり、寄り添っている。\nモノクロがテーマ。\n\n②ルーチェ・ブランシェ \n29歳/男性/179cm/絵画教室の先生\n①の幼馴染、同じ孤児院出身。今は孤児院の近くの海辺に教室兼アトリエを構え、子供達に絵を教えながらアマチュア画家のような活動をしている。いつもにこにこしている楽観主義者で好奇心旺盛、作品も彩り豊かで華やかなものが多い。常に金欠の浪費家。アクセサリーやインテリアを集めるのが好き。\n文字通りの軟派で、悪気なく二股以上をかけた結果女の子に両側からビンタされたことがあるが、懲りてない。愛のリソースが多すぎる人間。\n他者の寂しさや痛みを敏感に察知する洞察力があり、特にわかりやすい幼馴染のことはよく理解しているつもり。愛を持って手のひらで転がしているが、大事な時には相手のペースに合わせて寄り添っている。それでもあくまで自然体でありのまま。\nカラフルがテーマ。\n\n\n・関係\n南イタリアの海辺の田舎にある孤児院育ちの幼馴染。ルーチェは唯一の同い年のテネブロが大好きだが、テネブロにとってのルーチェは競争相手でライバル（一方的）だった。 \n画家を目指して故郷を飛び出したテネブロのプライドを尊重し、テネブロからの連絡があるまでルーチェは自分からは連絡せず、故郷で待っていた。最近になってやっとテネブロが帰郷し、十数年ぶりに再会した。\nルーチェは悲喜交々のテネブロの旅路を肯定し、再会を喜んだ。でも連絡のひとつもなく十数年も自分を待たせたことはたまに突っつく。\n\n\n・構図・頭身など\n描きやすいのでお任せします‼️\n\n\n・使途\n個人利用のグッズ化、個人鑑賞\n\n\nどうぞよろしくお願いします！\nご検討いただければ幸いです。\n\nhttps://drive.google.com/drive/folders/1Yi4zIjyCpU_pl3zIl8D7RvuYesGAMgb2", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@Oh_niginigi/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 4125147, "client_id": 975702, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/6b08c436/uploads/origins/dba3b40d-7318-4065-873b-3041562d4378?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1ba2e2f3bb4ab1a6e0ac0d652f023b29", "srcset": "https://si.imgix.net/6b08c436/uploads/origins/dba3b40d-7318-4065-873b-3041562d4378?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1ba2e2f3bb4ab1a6e0ac0d652f023b29, https://si.imgix.net/6b08c436/uploads/origins/dba3b40d-7318-4065-873b-3041562d4378?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=95d7c0e58b1fabde83fea79f5fa657e6 2x, https://si.imgix.net/6b08c436/uploads/origins/dba3b40d-7318-4065-873b-