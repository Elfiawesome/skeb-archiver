厳しかったので簡略的な内容になりますので好きに書いて頂いて大丈夫です。\nNGシチュは特にありません。\nこちらのリクエスト文はネタとして気に入っているので他のクリエイター様にも送ることがあります。ご了承ください。\n\nこんな感じで大丈夫でしょうか。良ければお願いします。", "nc": 171, "word_count": 14983, "transcoder": "text", "creator_acceptable_same_genre": true}, {"path": "/@OUYOC4N/works/13", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2330554, "client_id": 153352, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/03129bf3/uploads/origins/a8fdb982-a5ae-40df-aae0-d7ef9c12f524?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2224d89deb862da33d9ea68554e96656", "srcset": "https://si.imgix.net/03129bf3/uploads/origins/a8fdb982-a5ae-40df-aae0-d7ef9c12f524?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2224d89deb862da33d9ea68554e96656, https://si.imgix.net/03129bf3/uploads/origins/a8fdb982-a5ae-40df-aae0-d7ef9c12f524?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=9d874adfce246412d02a4933c27a1b89 2x, https://si.imgix.net/03129bf3/uploads/origins/a8fdb982-a5ae-40df-aae0-d7ef9c12f524?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a00f549e9213083316241e012420505d 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/03129bf3/uploads/origins/a8fdb982-a5ae-40df-aae0-d7ef9c12f524?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e8b137751a2534bda396715449aa28c5", "srcset": "https://si.imgix.net/03129bf3/uploads/origins/a8fdb982-a5ae-40df-aae0-d7ef9c12f524?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e8b137751a2534bda396715449aa28c5, https://si.imgix.net/03129bf3/uploads/origins/a8fdb982-a5ae-40df-aae0-d7ef9c12f524?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=9a7afd82e068dfb6eade4179617bfb28 2x, https://si.imgix.net/03129bf3/uploads/origins/a8