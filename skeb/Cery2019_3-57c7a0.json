=3&fit=crop&crop=top&w=200&h=200&s=57d6862a3cc8b3ff44c86b5d9692e54f 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/deb9668d/uploads/origins/41f56e3e-59d8-4248-8697-d581d58bdc07?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c839bc25b67d63fd04f46d395244a08d", "srcset": "https://si.imgix.net/deb9668d/uploads/origins/41f56e3e-59d8-4248-8697-d581d58bdc07?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c839bc25b67d63fd04f46d395244a08d, https://si.imgix.net/deb9668d/uploads/origins/41f56e3e-59d8-4248-8697-d581d58bdc07?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=38847eeee5be847e53fbee9bc23449c9 2x, https://si.imgix.net/deb9668d/uploads/origins/41f56e3e-59d8-4248-8697-d581d58bdc07?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=3e4a36c4ad47361e2a40d84319670eab 3x"}, "body": "ちぇりい様\n\n申し訳ありません、参考資料の添付を忘れておりましたので再送させていただきます…！\n\n\n初めまして、ぽむぷりと申します。\n ちぇりぃ様の素敵なイラストや立ち絵を拝見させていただいております…！いつかガッシリとした体型の自探索者を描いて欲しいと思い、今回依頼させていただきました。 もしよろしければCoCにて単発シナリオ継続で回っている元ヤン幼馴染の二人をお願いしたくメッセージをお送りさせていただきました。 \n\n▽依頼内容 \nポーズや内容はお任せします。イラストとコミック、どちらにしようか悩んだ挙句イラストにしましたが、もしコミックの方が相性が良さげで変更出来るのであればそれでも構いません。その際、金額が不足してる様であればお手数ですがお伝えいただければと思います。相方からは許可頂いてます。\n\n▽使用用途 \n個人鑑賞・相方への共有\n\n▽キャラ設定 \n①橘 龍牙：金髪・黒のツーブロック/オレンジに近い金色の瞳/吊り目気味。バイクジャケットを着ている。週三で1時間ミッチリと筋トレをしている為、ガッシリとした体型。（STR17）\n24歳/190cm  元ヤン\n過去に60人程束ねていた暴走族の総長。頭はからっきしだが腕っぷしには覚えあり。過去に何回か頭同士のタイマンを張って全勝。エモノは鉄パイプ。カリスマ性があり、チームを引っ張ってきた。 \n現在は元ヤン経歴を生かしてバイク便の職業に就いている。明るく人懐っこい性格だからか配達先にも気に入られている。烈の事は無条件で信頼してる為よく騙されたりする。甘い物が好き。禁煙したいが烈のせいで禁煙出来ない。  \n\n②桜井 烈：赤髪・黒のメッシュ/黄色と赤のオッドアイ/サングラス。左目は小さい頃に飼い猫のケイジに盛大に引っ掛れ大きな傷となっている。髪は一つに束ねている。\n24歳/182cm  元ヤン\n総長である橘 龍牙の幼馴染で、同じチームの副総長。龍牙が力担当、烈が頭担当であり交渉等も行っていた。龍牙の隣に必ず居てチームを支えてきた実質、陰の総長である。 現在は車の良さに目覚めてタクシードライバーに。気さくな性格で客から気に入られている。走るのが好きで、休日は一人でドライブに行く事も。要領が良く面倒くさがりなので、龍牙に鍛えろと言われてもどうサボるかを常に考えている。ヘビースモーカー。何だかんだ龍牙に甘い。\n\n▽二人の関係性 \n生まれた時からの幼馴染。\n暴走族時代で心配や迷惑を掛けているのにも関わらず文句も怒りもせず常に味方で居てくれた為二人とも母親を大事にしている。\n現在は二人とも実家から離れて一人暮らしをしているが、家が近い為ちょくちょく遊びに行っている。\n\n烈「人に煙草教えといて先に禁煙しやがって」\n龍牙「最近煙草代高ぇんだよ。つーかお前が横で吸ってっとマジで吸いたくなるから禁煙しろよ」\n烈「ヤダね（イーッ）」 \n\n▽参考資料\nhttps://drive.google.com/drive/mobile/folders/1NJOR3Wt1bMho5lLs-v9l_ZdbFTCfhp2T?usp=drive_link\n\n以上になります。よろしくお願いします。\n\nhttps://drive.google.com/drive/mobile/folders/1NJOR3Wt1bMho5lLs-v9l_ZdbFTCfhp2T?usp=drive_link", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Cery2019_3/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1121495, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/0a1d54a4/uploads/origins/52bc1038-19ea-451a-a806-33876a5a8f2e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=89df55fc9427c3cbaecc790ce19410ff", "srcset": "https://si.imgix.net/0a1d54a4/uploads/origins/52bc1038-19ea-451a-a806-33876a5a8f2e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=89df55fc9427c3cbaecc790ce19410ff, https://si.imgix.net/0a1d54a4/uploads/origins/52bc1038-19ea-451a-a806-33876a5a8f2e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=61e94da149ac10f759b6de0d61ff72ea 2x, https://si.imgix.net/0a1d54a4/uploads/origins/52bc1038-19ea-451a-a806-33876a5a8f2e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=0ec6fd68642fa85110780ddbdcc17448 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/0a1d54a4/uploads/origins/52bc1038-19ea-451a-a806-33876a5a8f2e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=fc9e50c42231f95053231573e3cdb005", "srcset": "https://si.imgix.net/0a1d54a4/uploads/origins/52bc1038-19ea-451a-a806-33876a5a8f2e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=fc9e50c42231f95053231573e3cdb005, https://si.imgix.net/0a1d54a4/uploads/origins/52bc1038-19ea-451a-a806-33876a5a8f2e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=5c568fe5710df5c5752c4a1e7ea1ea74 2x, https://si.imgix.net/0a1d54a4/uploads/origins/52bc1038-19ea-451a-a806-33876a5a8f2e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=b03fcafb92278c211497206c8d8bf9e0 3x"}, "body": "はじめまして、タイムラインでお見かけした探索者さんがとても好きで、あなたの探索者さんの絵をもっと見てみたい！と思い、リクエストを送らせていただきました\n\n・要望\nhttps://x.com/cery2019_3/status/2052022325818876167?s=46&t=HxCjzp-4Ch4fRanPgLL2_A\n上記の探索者さんの絵を描いていただきたいです\nデザインと雰囲気が本当に好きで、落書き詰めでも、一枚絵でも、どんなものでも嬉しいです　NSFWをオンにしていますが描ける幅が広がるといいなと思って付けているので、NSFW的な要素は無くても大丈夫です　どちらでも嬉しいです\n（外部への掲載や使用などは一切行わず、描いていただいた作品を大切に眺めさせていただければと思っています）\n\nタイムラインで探索者さんをお見かけして、好きだ……もっと見たい……となり勢いでリクエストを送っています　こういったリクエストをするのは初めてなので不手際などありましたら申し訳ありません\n\n問題がなければ遠慮なくキャンセルをお願いします、お忙しいところ大変恐縮ですが、何卒よろしくお願いします！", "nc": 160, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Cery2019_3/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1121495, "client_id": 3089966, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/540d9d7b/uploads/origins/75eef55b-606a-4daa-bc85-9b80ce852e02?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a55e63bb75337619bb8fd3c89fb7f155", "srcset": "https://si.imgix.net/540d9d7b/uploads/origins/75eef55b-606a-4daa-bc85-9b80ce852e02?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a55e63bb75337619bb8fd3c89fb7f155, https://si.imgix.net/540d9d7b/uploads/origins/75eef55b-606a-4daa-bc85-9b80ce852e02?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=287ced26f6423c8ed18df86e50d369db 2x, https://si.imgix.net/540d9d7b/uploads/origins/75eef55b-606a-4daa-bc85-9b80ce852e02?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ef6b40b74fff354c7a84bae48387ba0d 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/540d9d7b/uploads/origins/75eef55b-606a-4daa-bc85-9b80ce852e02?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b2249892f89e67669b1746d5e636d5e5", "srcset": "https://si.imgix.net/540d9d7b/uploads/origins/75eef55b-606a-4daa-bc85-9b80ce852e02?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b2249892f89e67669b1746d5e636d5e5, https://si.imgix.net/540d9d7b/uploads/origins/75eef55b-606a-4daa-bc85-9b80ce852e02?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=917a3adff3325c744d2dad17191be69c 2x, https://si.imgix.net/540d9d7b/uploads/origins/75eef55b-606a-4daa-bc85-9b80ce852e02?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=76418f46d1ee3f810f16ca3ee330db70 3x"}, "body": "ちぇりぃ様\n\nお世話になっております。以前、プル夜のHO2立ち絵でお世話になった者です。\n\nちぇりぃ様の描かれた彼の立ち絵のお陰で、今も楽しいTRPGライフを送ることができております。この度は素敵なご縁をいただき、誠にありがとうございます。\n\n今回は、彼の相方とのイラストをちぇりぃ様にぜひ制作をお願いしたく、メッセージさせていただきました。（大変お待たせしてしまい申し訳ございません💦）\n\n以下に依頼したい内容を記載いたします。\n\n【構図】\n喫煙所のふたり or 背中合わせ\n（詳細おまかせします）\n\n【使用用途】\n\n卓報告（X/SNS）など、個人利用\n\n◆探索者について\n\n【相方】\n\n名前：帳 貴征\n身長：170.5cm。細マッチョ（7頭身）、腰高で脚が長い。\n外見特徴： 30代後半より若く見える童顔。退廃的な美しさ。\n髪：後ろ髪は胸くらいの長さ。さらさらより少しふわふわ、癖っ毛ぽい。前髪は耳下まで。鬢は肩にかかる長さでカール。\n色：メイン（#3A2A34）、ハイライト（#A58798）など\n目元：平行に見えるつり目。眉はつり気味。鋭くもどこか虚ろな光を宿している。\n瞳孔：菱形。\n虹彩：上が赤みのある紫色（#42012A, #5C033C）、下が青みが強い紫色（#9054C1）。\n外見的特徴：濃いめのクマがある。右目に眼帯。\n服装：グレーっぽい黒のスーツ、黒いワイシャツは首元のボタンを開けており、暗い赤のネクタイは緩められている。焦げ茶色のベスト、ベルト、革靴。手の甲が出るタイプの黒手袋。\nアクセサリー：首にチョーカー。左耳下に赤い菱形のイヤーカフ。\n性格：厭世的で不器用だが部下思いの班長。\nその他：ハイライトがない。育ちがいい。甘味は苦手。酒浸り、煙草好き。バツイチ。\n\n【自探】\n\n名前：猪隼 酉二\n身長：168cm。着痩せするタイプ。\n外見特徴：眼鏡。だいたい笑って誤魔化す悪徳業者顔。顔以下の素肌を見せたがらない。\nアクセサリー：首から下げたドッグタグ。\nhttps://iachara.com/edit/9196436\n\n【関係性】\n\n平行世界のぷいち、ぷに。煙草仲間。ビジネスパートナー。\n\n---\n\nお値段や内容など、もし厳しい部分がありましたら、ご遠慮なくキャンセルや再送要請してください。\n\nご多忙の折とは存じますが、ご検討いただけますと幸いです。よろしくお願いいたします。", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Cery2019_3/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1121495, "client_id": 2449685, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/936f1e36/uploads/origins/983d03a2-1db6-40b0-92af-c18ca4f1e50b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=558e63771e2ff8d7ee07f46fbabc87f1", "srcset": "https://si.imgix.net/936f1e36/uploads/origins/983d03a2-1db6-40b0-92af-c18ca4f1e50b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=558e63771e2ff8d7ee07f46fbabc87f1, https://si.imgix.net/936f1e36/uploads/origins/983d03a2-1db6-40b0-92af-c18ca4f1e50b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=6b767338eaec425841f15258aff89def 2x, https://si.imgix.net/936f1e36/uploads/origins/983d03a2-1db6-40b0-92af-c18ca4f1e50b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=530c672ffc61c5835203325d49df276c 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/936f1e36/uploads/origins/983d03a2-1db6-40b0-92af-c18ca4f1e50b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c4fba4df63468249cfaf1674a16f01e4", "srcset": "https://si.imgix.net/936f1e36/uploads/origins/983d03a2-1db6-40b0-92af-c18ca4f1e50b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c4fba4df63468249cfaf1674a16f01e4, https://si.imgix.net/936f1e36/uploads/origins/983d03a2-1db6-40b0-92af-c18ca4f1e50b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=bd63ddd31af1f7a748181bb2bf7f0741 2x, https://si.imgix.net/936f1e36/uploads/origins/983d03a2-1db6-40b0-92af-c18ca4f1e50b?bg=%23fff&auto=format%2Ccompress