2-O1bd5GghG0o?rlkey=boea4sfvonfnyn9yiuw2w6f2t&st=sv18lycq&dl=0", "nc": 25, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@ppsycho02/works/75", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 776507, "client_id": 52445, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/93a0326e/uploads/origins/2eb70b57-9438-4bc6-9004-31cf24a85814?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d9111714cfc75362e633c0be0f26d8ce", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/93a0326e/uploads/origins/2eb70b57-9438-4bc6-9004-31cf24a85814?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9441a4e7894564a97f3ac4423d3b3864", "src_set": ""}, "body": "お久しぶりです。\nよろしくお願い致します。\n\n自作ゲームのキャラクター、\n「メイディ・メイデン」という銀髪女子のイラストをご依頼したいと思います。\n下記URLに参考資料がございます。\nお手数ですが、構図やアレンジなどはお任せでお願い致します。\n\n※イラストの取り扱いは個人観賞及びskebに紐づいたツイッターでのみ\n※クライアントガイドラインを厳守致します。\n\nGoogleドライブ\nhttps://drive.google.com/drive/folders/1a0RsTV98yG_i_Jv2z3fPeUj04qp183db?usp=sharing", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@ppsycho02/works/74", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/8cd7f15b/uploads/origins/6ef4fe93-577e-4285-98e2-40c1ed3347aa?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=145408a93a819625290aef352fb06bf9", "src_set": ""}, "private": true, "genre": "art", "tipped": true, "creator_id": 776507, "client_id": 0, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 1, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@ppsycho02/works/73", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 776507, "client_id": 0, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/cc533674/uploads/origins/9cf78d01-2fc4-43a9-94c0-ddfeb27225e8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9a6f6e4c3ce8ed629d48ec98b61543f0", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/cc533674/uploads/origins/9cf78d01-2fc4-43a9-94c0-ddfeb27225e8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=861614b3e44bf243500cee7dbc7307fe", "src_set": ""}, "body": "いつもpsycho02様の素敵な作品を楽しませていただいております。\n\n早速リクエストになりますが、ヒポグリフ様をお願いしたく思っております。\nポーズや構図等の細かい指定はありませんが、ダークな雰囲気で描いていただけると大変命が助かります。\n\n難しいかとは存じますが、ご検討いただけますと幸いです。どうぞよろしくお願いいたします。\n\n(追伸)\nトリモも大変楽しみにしております！\nお身体にはお気をつけてお過ごしくださいませ。", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@ppsycho02/works/72", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 776507, "client_id": 2695066, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/17b1bf55/uploads/origins/8f0af3f2-95ab-422c-b97a-5063773fdd1f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8615660c43c7647c9da5993d5e27cd90", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/17b1bf55/uploads/origins/8f0af3f2-95ab-422c-b97a-5063773fdd1f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d142f7742544076003caf567b2eedeba", "src_set": ""}, "body": "psycho02様\nskeb再開お待ちしておりました！\nこの度は私のOCの瑞樹を描いていただきたいと思い、ご依頼をいたしました\n\n◇参考画像\nhttps://www.dropbox.com/scl/fo/2z77r0lytoid4oskizc96/AKzi4c0qnaxjYpYKEwdb-js?rlkey=jikpj70sbsw2x6jhm4vzikh7y&st=es43ldf0&dl=0\n　\n◇設定\n身長155cm\n超自己肯定感が高い司教さまです\n性別不詳です\n\n◇シチュエーション等\n特に指定はございませんのでお任せいたします\n服装のアレンジ等も含めてご自由にお描きください\n\nシチュエーション指定が欲しいなどございましたらご遠慮なく適宜変更・差し戻しいただいて問題ございません\n何卒ご検討のほどよろしくお願いいたします", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@ppsycho02/works/71", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 776507, "client_id": 0, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/ac4b1dca/uploads/origins/7c9e342e-3f0a-45c8-b733-277c48371d43?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c9bad218d0ad349baa379411a549c7a6", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/ac4b1dca/uploads/origins/7c9e342e-3f0a-45c8-b733-277c48371d43?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e339d3d498cd125bdec1bf21c565f1c9", "src_set": ""}, "body": "はじめまして！絵柄が大好きでずっとリクエストしたかったです！！！\nリクエスト受け中になったので投げさせていただきます！\n\n今回のリクエストですがTRPGで使用する立ち絵を依頼させてほしいです…！\n\n性別　男の子\n身長　150cm\n年齢　12\n種族　獣人　（狼）\n\n目の色　青\n\n髪色　髪型　黒髪でセミロングヘアにピンと立ったケモミミ（すみません、髪型に詳しくないので可愛い感じでお願いします！）\n\n肌色　普通\n\n服装　首元に灰色のボロボロのマフラー、黒のノースリーブシャツ（へそが見えるくらいの丈で赤のネクタイ）\n前を開けたボロボロのコート、ぼろっとしたデニムショートパンツ\n片足だけ絶対領域のソックス、ブーツ\n\n両手に武器もお願いしたいです、ナタのような長剣と短剣を両方とも逆手に持っている感じで\n\n性格はクールで落ち着いている樣子の子、でも強がっているだけで実際は年相応の子供です、笑顔とかよく見せる感じの\n\nその他の詳細な部分はおまかせします！ポージングとかは全然好きにしてください！服装の方も好きにしちゃってください！\n\nツンツンしてそうな感じのケモミミっ子です、よろしくお願いします！", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@ppsycho02/works/70", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 776507, "client_id": 0, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/4099a42b/uploads/origins/a22abd9a-b5ff-496b-86b4-33a14e5c747a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=00a64350695a64dde95e37cf48075ac2", "src_set": 