b26ddb-91a5-40b8-8a34-24fdaed40f3e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=88fc85ed53a8c257e48e2b255b850031, https://si.imgix.net/089f2cd2/uploads/origins/3bb26ddb-91a5-40b8-8a34-24fdaed40f3e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b7be092b2f07149b0f95d6d000b8cdec 2x, https://si.imgix.net/089f2cd2/uploads/origins/3bb26ddb-91a5-40b8-8a34-24fdaed40f3e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=89f39c3437ff82946c19c03024848432 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/089f2cd2/uploads/origins/3bb26ddb-91a5-40b8-8a34-24fdaed40f3e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=720b37ffcf300d57c1e4e5d3cb1c736f", "srcset": "https://si.imgix.net/089f2cd2/uploads/origins/3bb26ddb-91a5-40b8-8a34-24fdaed40f3e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=720b37ffcf300d57c1e4e5d3cb1c736f, https://si.imgix.net/089f2cd2/uploads/origins/3bb26ddb-91a5-40b8-8a34-24fdaed40f3e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=fb5f96f4c80de06df5917e07fb19a8a6 2x, https://si.imgix.net/089f2cd2/uploads/origins/3bb26ddb-91a5-40b8-8a34-24fdaed40f3e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=7866cd931252bebe8d198da0d3a1e30c 3x"}, "body": "さしれ＠skeb募集中様。初めまして。じゅんざきと申します。\n自分のオリジナルキャラクターを描いて頂きたくご連絡を致しました。\n\n【キャラ詳細】\n・好きなものは「お酒」、「たばこ」、「アイス」\n・性格はふわふわゆるっとした雰囲気で、好物に対しては我慢ができない子です。\n・お酒は酔いやすいのでふにゃっとしがちで顔が赤くなり。アイスはいくらでも食べれるくらい好きです。幸せそうに食べます。たばこに関しては吸う頻度は多くはないですが匂いが好きだから吸ってる。みたいな感じです。吸ってる時は割とリラックスしてたりして穏やかに微笑んだり、逆にキリっと考え事してたりしています。\n・身長は低め\n・髪はセミロングのユニコーンカラー\n・左耳にピアス\n・資料のいる「ユニコーンの子」を描いてもらいたいです\n・ユニコーンの子はおっとりとした性格でこの子にぴったりとくっついたりするのが基本位置です。何でも食べます。\n\n【イラストイメージ】\n・ポーズや表情、雰囲気、背景等はお任せいたします。\n・顔回り（顔や帽子、髪の毛など）が画像端で切れないと嬉しいです。\n・衣装はお送りする資料でお願いしたいです。\n\n【使用用途】\n・X(旧Twitter)など、SNSのPR活動に使用させていただきたいです。\n\n【データについて】\n・画像サイズはお任せいたします。\n・金額上可能なら宛名/人物/背景を分けた、psdまたはpngデータの納品を希望したいです。\n\n【参考資料】\nhttps://drive.google.com/drive/u/2/folders/1zTHKVZCp21w7Al2L-O0df5EpJ9W9jyD4\n\nご検討の程よろしくお願いいたします。", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@ADoX8xAJy264595/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 4034611, "client_id": 923885, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/b797c4a0/uploads/origins/738e0f1a-e8d3-4ef4-a318-b6a09319b413?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f44e9ddf8540be7953e4f3c45322b7ab", "srcset": "https://si.imgix.net/b797c4a0/uploads/origins/738e0f1a-e8d3-4ef4-a318-b6a09319b413?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f44e9ddf8540be7953e4f3c45322b7ab, https://si.imgix.net/b797c4a0/uploads/origins/738e0f1a-e8d3-4ef4-a318-b6a09319b413?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=3af84283579b30da96652ede9b94b98c 2x, https://si.imgix.net/b797c4a0/uploads/origins/738e0f1a-e8d3-4ef4-a318-b6a09319b413?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=adf7021966726074cae1a29a814ec495 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/b797c4a0/uploads/origins/738e0f1a-e8d3-4ef4-a318-b6a09319b413?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5fba68d70903da0b35743e15ef55ab24", "srcset": "https://si.imgix.net/b797c4a0/uploads/origins/738e0f1a-e8d3-4ef4-a318-b6a09319b413?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5fba68d70903da0b35743e15ef55ab24, https://si.imgix.net/b797c4a0/uploads/origins/738e0f1a-e8d3-4ef4-a318-b6a09319b413?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=b6