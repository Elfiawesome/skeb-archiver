itch - I will definitely credit you whenever I use it!\nThank you~\n\nI have attached a file with reference images of my character's design/outfit:\nhttps://drive.google.com/drive/folders/1wfWyTD3QcA2D1ercdBHkkHduoWOduI55?usp=sharing", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@wan5prin/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1373965, "client_id": 1239965, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/5d9c8591/uploads/origins/209b615e-1c6e-43ae-8792-f0ee1da43891?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c70422b92c3ebd1917b1e5bd77472a6d", "srcset": "https://si.imgix.net/5d9c8591/uploads/origins/209b615e-1c6e-43ae-8792-f0ee1da43891?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c70422b92c3ebd1917b1e5bd77472a6d, https://si.imgix.net/5d9c8591/uploads/origins/209b615e-1c6e-43ae-8792-f0ee1da43891?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=45ab0d95524b73de0a56af2acb59c7cd 2x, https://si.imgix.net/5d9c8591/uploads/origins/209b615e-1c6e-43ae-8792-f0ee1da43891?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=8d7809b43dc6bdd146289d085c641f02 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/5d9c8591/uploads/origins/209b615e-1c6e-43ae-8792-f0ee1da43891?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=4095754bda2643a024c1577414dfbb86", "srcset": "https://si.imgix.net/5d9c8591/uploads/origins/209b615e-1c6e-43ae-8792-f0ee1da43891?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=4095754bda2643a024c1577414dfbb86, https://si.imgix.net/5d9c8591/uploads/origins/209b615e-1c6e-43ae-8792-f0ee1da43891?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur