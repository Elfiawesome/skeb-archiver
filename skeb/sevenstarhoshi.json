=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=181bbd4e04235ea055f7e0163b273467", "src_set": ""}, "private": true, "genre": "art", "tipped": false, "creator_id": 305717, "client_id": 0, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 32, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@sevenstarhoshi/works/210", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/29da133c/uploads/origins/b22cc7a6-a176-4063-9a8e-81c1ed2b8759?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=80fdd79cfff02d588e56965160cf170b", "src_set": ""}, "private": true, "genre": "art", "tipped": true, "creator_id": 305717, "client_id": 392528, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 32, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@sevenstarhoshi/works/209", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 305717, "client_id": 0, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/99ecdea3/uploads/origins/f4ef8521-7e2e-4889-9811-73b61fcc648a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b38a081527eac500d97eb662ce9e0cce", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/99ecdea3/uploads/origins/f4ef8521-7e2e-4889-9811-73b61fcc648a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3e67c8efbabf2262174f6a76f1641a79", "src_set": ""}, "body": "12月くらいに投稿していた、クールな後輩のイラストが好きだったので、その続編的なものを描いてほしいです！\n\n【シチュエーション】\n・先輩に、もう一度くすぐってほしいと恥ずかしそうにお願いする\n・下着姿で、前回と同じように拘束される\n・下着の色やデザインはお任せします(前回と全く同じでも大丈夫です！)\n・最初にへそを羽でくすぐられる(ちょっと笑ってしまうが、耐えられてる状態)\n・次にへそを電動歯ブラシをくすぐられて笑わされてしまう(「なんでそんなの持ってるんですか」みたいなセリフを入れてほしいです)\n・今度は脇腹を両手くすぐられて、腰をくねらせる\n・最後に弱点のワキを両手でくすぐられる\n・できれば、ワキをくすぐる直前の描写も入れてほしいです(23年のクリスマスに投稿していた、サンタな彼女のような構図で、ワキをくすぐろうとしている先輩の両手が写っている感じで)\n\nよろしくお願いします！！", "nc": 32, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@sevenstarhoshi/works/208", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/ebcb2c2b/uploads/origins/99dba569-c878-4e0d-aae4-cb081b8abf51?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=1788540d6bbb708c939038fe8ee85aa5", "src_set": ""}, "private": true, "genre": "comic", "tipped": true, "creator_id": 305717, "client_id": 2141827, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 33, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@sevenstarhoshi/works/207", "private_thumbnail_image_urls": null, "private": false, "genre": "comic", "tipped": false, "creator_id": 305717, "client_id": 0, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/24d13a11/uploads/origins/66071a67-c90b-4a68-b05e-e69fa5729e09?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3f4c36ba2f427317882302768d097bd0", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/24d13a11/uploads/origins/66071a67-c90b-4a68-b05e-e69fa5729e09?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a83358013bd6b397112bbad71fae6596", "src_set": ""}, "body": "以前は『女騎士メリス』の続編を作っていただきありがとうございました。大変楽しませてもらいました。\n今回は別作品の続編をお願いできればと思います。\n\n【形式】\n漫画　17〜20ページ\n\n【キャラ】\n・椿\n黒髪ツインテール、巨乳(頭部と同じ〜若干大きい程度・お椀型)、吊り目、男口調、スタイル抜群\n※URL画像参照。より胸が大きく、露出が高い服装希望。\n\n・役人\n椿の監視役を担う青年。20代だが童顔で可愛らしい。普通の黒髪頭に袴+帯刀の姿。\n\n【展開】\n(1〜2ページはプロローグ、キャラや状況説明等)\n　時は戦国時代。女侍・椿は日の本に名を馳せる剣技の使い手であったが、どの国や勢力にも属さない流浪の身であった。\nある晩の道中で野宿した椿だが、そこは運悪く悪名高い大名の領地内であった為、許可なく侵食した不届者として捕えられる。評定所にて、担当奉行は彼女が名高い女侍である事に気付き、この国の配下になれば無罪にすると持ちかけるが、流浪の身を誇りに思う椿は拒絶し「お前らのような欲塗れの狗共に仕えるくらいなら死んだ方がマシだ」と吐き捨てる。\n\n　椿は磔晒し刑に処され、衣を着たまま十字架磔にされ、城下町の道行く者に見られては噂される醜態に顔を染めながらも耐える。\n　その日の晩、ようやく人気が無くなり一息つく椿。そこに監視していた役人が近づき、かつて椿によって斬り伏せられた役人の兄の形見である御守りを椿に見せる。そして役人は椿の処遇を決める権限があり、兄の復讐も込めて本当の罰を与えると宣言する。\n　\n　役人は自分の刀を使い、椿の着ていた物を全て切り刻み、全裸に剥く(アソコはモザイク処理)。羞恥に悶える椿の胸や秘部を見て袴を盛り上げ興奮した役人は、彼女の後ろに周り大きな胸を揉んだ後、黒烏の黒く長い羽根を2本取り出し、彼女の脇の下や脇腹にかけてなぞる。突然の刺激に椿は歯を食い縛って堪える。しかし臍に当てられた途端笑い出し、弱点を見つけた役人はヘソを集中的に攻撃する。\n\n(この後のくすぐりはお任せします)\n\n　役人のくすぐり責めに屈服し、配下になるから許してと懸命に許しを乞うが、結局失禁し、大きく口を開け舌を出しながら気絶するまで続いた。\n　その後、その国に仕えさせられた椿は、以前よりも更に露出度の高い破廉恥な格好で、屈辱的で尊厳を失うような仕事をさせられた(具体的なエンドはお任せします)\n\nhttps://f.yourl.jp/828f80ea/", "nc": 56, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@sevenstarhoshi/works/206", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 305717, "client_id": 0, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/475faec6/uploads/origins/5aa23dbb-2e34-411a-a0e5-5d145f742129?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2357eae9ce8450f11571c31dd3e07899", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/475faec6/uploads/origins/5aa23dbb-2e34-411a-a0e5-5d145f742129?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=efb0ba85abe90d2c36a90ea71ce7c758", "src_set": ""}, "body": "アイプラのTRINITYAiLEの3人が八百長を要求されて承諾するまでこちょこちょされて笑い悶えて、服まで脱がされてへそや腋をくすぐられて承諾してしまうシチュのイラストをお願いします\n１枚目はライブ衣装でこちょこちょされて笑い悶えてしまう\n２枚目は服を脱がされて下着姿にされてへそや腋をくすぐられて承諾してしまうシチュでお願いします\n捕まり方はpixivにあるキュアグレース達のような感じでお願いします", "nc": 40, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@sevenstarhoshi/works/205", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/a83f78fe/uploads/origins/5520a03f-c510-40ac-963c-18d94fdd93a3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=102528fe63b68a708d3eb22aa74c8cb2", "src_set": ""}, "private": true, "genre": "art", "tipped": true, "creator_id": 305717, "client_id": 2141827, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 161, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@sevenstarhoshi/works/204", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 305717, "client_id": 471011, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/b7467609/uploads/origins/2d2a87b2-0250-4ea4-aa49-b3b911775c7d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0ca719f2dd6c56ae34b5971f6ec9f45d", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/b7467609/uploads/origins/2d2a87b2-0250-4ea4-aa49-b3b911775c7d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b8626df32eb69879157a01181bbcd0e7", "src_set": ""}, "body": "お疲れ様です\nアイドルマスターシンデレラガールズの佐藤心のマジックハンドくすぐりイラスト1枚と、差分絵を1枚をリクエストします\n\n\nリクエストの経緯：\n「手ブラ」と「マジックハンドによる拘束」が好相性に感じたので組み合わせました\n差分と併せて抵抗虚しく拘束と責めが強化されていく様子が見たいです\n\nリクエストの詳細：\n①上半身裸、下半身下着のみ\n②おっぱいとお尻を突き出した格好で立ったまま拘束\n③右手で両乳首を隠すように手ブラ、左手は頭上に真っ直ぐ伸ばして拘束\n④マジックハンドによる脇、脇腹、お尻のぐすぐり\n⑤右手を引き剥がそうとするマジックハンド\n⑥下着をお尻が少し見える位置まで脱がすマジックハンド\n⑦笑いながら右手を剥がそうとするマジックハンドに抵抗、下着を脱がそうとするマジックハンドに文句を言う台詞\n⑧以上を斜め前からのアングルで、顔とおっぱいが手前側にきて一番目立つ構図\n⑨画像内に枠を別に作り、その中に斜め後ろからのアングルでくすぐったさから逃れようとお尻をふりふりしている様子を描写\n\nまた、手ブラと下着を剝ぎ取られた差分絵もお願いします\n差分がある番号と差分点を「」で下記に記載します、記載なき番号の詳細はそのままです\n\n③「右手と左手」を頭上に真っ直ぐ伸ばして拘束\n⑤「マジックハンドによりおっぱいを左右から支えられ、別のマジックハンドに正面から乳首をつんつん」\n「マジックハンドによる手マン」\n⑥下着をお尻が「完全に」見える位置まで脱がすマジックハンド\n⑦「手ブラと下着が剥ぎ取られ悲鳴を上げ、制止を求めながらも笑ったり感じてしまう台詞」\n⑨画像内に枠を別に作り、その中に斜め後ろからのアングルでくすぐったさから逃れようとお尻をふりふりしている様子を描写\n「画像内にもう1つ枠を別に作り、両胸を持ち上げるように揉まれ上向きになった両乳首に別のマジックハンドが指を乗せくにくにしている様子を描写」\n\nその他：\n・乳首の色は薄めでお願いします\n・キャラの台詞は入力文字ではなく書き文字でお願いします\n・｢お尻の揺れ｣｢乳揉み｣「尻揉み」｢乳首責め｣の効果音は後ろにハートマークを、くすぐりの効果音はハートマークなしでお願いします\n\n\n以上、よろしくお願いします", "nc": 48, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@sevenstarhoshi/works/203", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 305717, "client_id": 335764, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/27155af7/uploads/origins/5b56d803-6d48-4148-8cf8-a5ae6bf0c198?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=cf56256c347e2a82acaf45cb0928ab11", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/27155af7/uploads/origins/5b56d803-6d48-4148-8cf8-a5ae6bf0c198?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=eeaaa2eab35d1df2178d3f7752694095", "src_set": ""}, "body": "Fateシリーズ、遠坂凛と馬頭桜がバスローブ姿でくすぐり合う。", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "similar_creators": [{"id": 15850, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "ひさめ", "screen_name": "sniflaye", "avatar_url": "https://proxy.misskeyusercontent.jp/avatar.webp?url=https%3A%2F%2Fmedia.misskeyusercontent.jp%2Fio%2Fbee76199-2861-413d-abae-57115724e62f.png%3Fsensitive%3Dtrue&avatar=1", "header_url": "https://media.misskeyusercontent.jp/io/2eeb01d5-70c0-46ec-af19-15b6ed98f516.png?sensitive=true", "appeal_receivable": true, "popular_creator_rank": null, "request_master_rank": null