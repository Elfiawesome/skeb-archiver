nly_public": false, "tip_acceptable": true, "yearly_report_client_visible": false, "total_appeals_count": 0, "received_works": [], "sent_works": [{"path": "/@Originalk312/works/65", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 661652, "client_id": 3267859, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/7b37ab98/uploads/origins/a8b1c76e-9def-4b10-8e59-679167477115?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7d7638b48d9eee69b58f9cbac860e8f1", "srcset": "https://si.imgix.net/7b37ab98/uploads/origins/a8b1c76e-9def-4b10-8e59-679167477115?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7d7638b48d9eee69b58f9cbac860e8f1, https://si.imgix.net/7b37ab98/uploads/origins/a8b1c76e-9def-4b10-8e59-679167477115?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=66cce03c5ef9ee94903c42ed06701226 2x, https://si.imgix.net/7b37ab98/uploads/origins/a8b1c76e-9def-4b10-8e59-679167477115?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=79377340e470d4472a9c0134b1c0c0ab 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/7b37ab98/uploads/origins/a8b1c76e-9def-4b10-8e59-679167477115?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5cdddd52fc99ae93ff05e6e8bb922d44", "srcset": "https://si.imgix.net/7b37ab98/uploads/origins/a8b1c76e-9def-4b10-8e59-679167477115?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5cdddd52fc99ae93ff05e6e8bb922d44, https://si.imgix.net/7b37ab98/uploads/origins/a8b1c76e-9def-4b10-8e59-679167477115?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=63b6a561b4e3a9db45bb79a41dfbb4bb 2x, https://si.imgix.net/7b37ab98/uploads/origins/a8b1c76e-9def-4b10-8e59-679167477115?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=cc740656d971826cade5978ccb5c2612 3x"}, "body": "𝙠𝙨𝙬様\nはじめまして。\n𝙠𝙨𝙬様のイラストを拝見し、𝙠𝙨𝙬様の描く筋肉質な男性のイラストがとても好きだな…筋肉の質感が素敵だな…と思いリクエストさせていただきました！！\nよければ私と友人のOCを描いていただきたいです。\n\n◇リクエスト内容\n「灰と甘露」というシナリオを通過したHO5絡新婦とHO6蝶化身の二人を描いていただきたいです。\nよければHO5がHO6に吸血しているシーンを描いていただきたく…！\n(HO5はノリノリで吸血する、HO6は嫌がりつつなんだかんだ許してくれる性格です。)\n背景や構図等はお任せしたいです。\n\n◇OCに関して\nHO5絡新婦\n名前：カゲ朗\n年齢：24\n身長：175cm\nHO6にダルがらみをしている。\n非常に口達者でよく適当なことをいろいろな人に吹きこんでHO6に怒られている。\nだが、情にあつい面もあり人を見捨てられない。\nなんだかんだ無自覚にHO6のことが好きらしい(恋慕ではない)。相棒としてHO6を大切な相方だと思っている。好きな子に嫌がらせする男子のようなもの。\n能力のデメリットで吸血を定期的に行わなくては死んでしまう。\n見た目は筋肉質だがHO6より筋肉がない。\n\nHO6蝶化身\n名前：胡夢\n年齢：24\n身長：176cm\n己の能力故意図的に人に心を開かない。（シナリオ概要に記載されているのですが近くにいる人間の寿命を削ってしまう能力。）\nHO5のことが好きだが彼に好かれたくはないので嫌われるようなことを故意で行っている。\n嫌味を言ったり軽く小突いたり。\nだが少し抜けていて頑固な面もある。語尾にｷﾘｯとついていそう。\nまた、実は情にあつい男で義理堅い。\n表情筋が死んでいる。ごくまれにほほ笑むくらい。\nだが、感情は豊かでHO5にはバレがち。\n筋肉がなさそうだが細マッチョ。だいぶ力が強い。\n\n◇使用用途\n個人利用\n\n上記内容になります。\n一応NSFWを有効にしております。\n何か不備があれば再送要請を送っていただけると嬉しいです。\nご検討のほどよろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/11degVD2AX2O9xwv0FdAdwp6qj69mgdtj?usp=sharing", "nc": 32, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@gogogo/works/60", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2774893, "client_id": 3267859, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/b6a887f5/uploads/origins/773f6eb6-f1e6-4eab-9959-ae47bc148506?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=99e5b5919263f9cc52b6b8d4554c578c", "srcset": "https://si.imgix.net/b6a887f5/uploads/origins/773f6eb6-f1e6-4eab-9959-ae47bc148506?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=99e5b5919263f9cc52b6b8d4554c578c, https://si.imgix.net/b6a887f5/uploads/origins/773f6eb6-f1e6-4eab-9959-ae47bc148506?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=d26abc54afd77db920a17ff74a5fceae 2x, https://si.imgix.net/b6a887f5/uploads/origins/773f6eb6-f1e6-4eab-9959-ae47bc148506?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a3cdb6869550ff9c05fa87a626d2435d 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/b6a887f5/uploads/origins/773f6eb6-f1e6-4eab-9959-ae47bc148506?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c7a7f077b39fabc4db9d0fdf76745ff4", "srcset": "https://si.imgix.net/b6a887f5/uploads/origins/773f6eb6-f1e6-4eab-9959-ae47bc148506?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c7a7f077b39fabc4db9d0fdf76745ff4, https://si.imgix.net/b6a887f5/uploads/origins/773f6eb6-f1e6-4eab-9959-ae47bc148506?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=23cd1b9a986df44dd715bb9bd5c514db 2x, https://si.imgix.net/b6a887f5/uploads/origins/773f6eb6-f1e6-4eab-9959-ae47bc148506?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=b5782fd73a0e1f648a7b54a2e9fd323e 3x"}, "body": "しまっちゃうひと様、はじめまして。えのきと申します。\nXにて素敵なイラストを拝見させていただいております。（ヘッダーのひよりん*さんのイラストがとても好きです…！）\nこの度はオリキャラを描いていただきたいと思いリクエストさせていただきました。\n\n\n【ご依頼内容】\n2人のデフォルメイラスト\nCoCシナリオ「ようこそ！迷冥市役所都市伝説課へ！」を通過した二人です。\n\n\n【オリキャラ二人に関して】\n・一人目（HO1）\n玉兎/男/160cm\nモチーフ：月のうさぎさん\nカラーコード：#F8E847\n使用武器：木斧、トンカチ\n真面目過ぎることがコンプレックスな関西弁天然風男。\n人前ではあまり笑わず仕事に厳しい印象を受けるが、ただただ真面目なだけで本人もそういう風に見られることを気にしている。なので金髪に染めてみた。\nこんな仕事をしているがtheホラーといったお化けは未だに苦手。\n基本的には規則優先だが人情に篤いため、後輩からのおねだりには弱い。\n普段は後輩や同僚たちのおかんと化しており、よく正座でお説教されている者がいるとかいないとか。\n一方で戦闘スタイルはエグめ。トンカチと木斧の二刀流でロープでの絞首もお手の物。\n小さい図体から繰り出される強力な一撃から兎が連想され、うさちゃん呼びされている。\n\n・二人目（HO2）\nくねくね/男/183cm\nモチーフ：くねくね\nカラーコード：#90ABAC\n使用武器：薙刀\n語尾に♡がついている。HO1のことが大好きで毎日告白している。HO1全肯定。\n他の先輩方に対しては普通。\n\n\n「ようこそ！迷冥市役所都市伝説課へ！」のネタバレが含まれる事柄は下記リンク先に記載しておきます。\nキャラ詳細のみなのでシナリオの内容をご存じでなければ無視していただいて構いません。\npass→yes\nhttps://fse.tw/BdBuOqg9\n\n\n\n上記内容になります。\nご検討いただけると幸いです。\nよろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/1CWDn-ndKyl14VN3PNStXbh1bA5vqtZCk?usp=sharing", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@inocheese/works/80", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1961377, "client_id": 3267859, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/88815711/uploads/origins/18fe5d9f-1af0-44c7-bc09-9071e4015dd6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=570160cc15f785cee70a5a519a19b414", "srcset": "https://si.imgix.net/88815711/uploads/origins/18fe5d9f-1af0-44c7-bc09-9071e4015dd6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=570160cc15f785cee70a5a519a19b414, https://si.imgix.net/88815711/uploads/origins/18fe5d9f-1af0-44c7-bc09-9071e4015dd6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=51cdaafd840ed7f6296206c202e800a3 2x, https://si.imgix.net/88815711/uploads/origins/18fe5d9f-1af0-44c7-bc09-9071e4015dd6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=8bdcc996115a68121174cb9b0f91705a 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/88815711/uploads/origins/18fe5d9f-1af0-44c7-bc09-9071e4015dd6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3583b3b996c7f5906ebef24ca07f8bb8", "srcset": "https://si.imgix.net/88815711/uploads/origins/18fe5d9f-1af0-44c7-bc09-9071e4015dd6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3583b3b996c7f5906ebef24ca07f8bb8, https://si.imgix.net/88815711/uploads/origins/18fe5d9f-1af0-44c7-bc09-9071e4015dd6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=aa422c18488c86a29e952cc7f3bb9bea 2x, https://si.imgix.net/88815711/uploads/origins/18fe5d9f-1af0-44c7-bc09-9071e4015dd6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=57949916a0ce4cfae87da38c85231245 3x"}, "body": "井ノ内様\nはじめまして。\n井ノ内様の可愛らしいSDイラストに惹かれたためこの度はリクエストさせて頂きました。\n私と友人のオリキャラである「灰と甘露」というシナリオを通過したHO5絡新婦とHO6蝶化身を描いていただきたいです。\n\n◇リクエスト内容\n2人のSDイラストを描いていただきたいです。\nポーズ等お任せ致します。\n他の内容に関してもお任せ致します。\n\n◇オリキャラ2人に関して\nHO5絡新婦\n名前：カゲ朗\n年齢：24\n身長：175cm\nHO6にダルがらみをしている。\n非常に口達者でよく適当なことをいろいろな人に吹きこんでHO6に怒られている。\nだが、情にあつい面もあり人を見捨てられない。\nなんだかんだ無自覚にHO6のことが好きらしい。好きな子に嫌がらせする男子のようなもの。\n能力のデメリットで吸血を定期的に行わなくては死んでしまう。\n\nHO6蝶化身\n名前：胡夢\n年齢：24\n身長：176cm\n己の能力故意図的に人に心を開かない。（シナリオ概要に記載されているのですが近くにいる人間の寿命を削ってしまう能力。）\nHO5のことが好きだが彼に好かれたくはないので嫌われるようなことを故意で行っている。\n嫌味を言ったり軽く小突いたり。\nだが少し抜けていて頑固な面もある。語尾にｷﾘｯとついていそう。\nまた、実は情にあつい男で義理堅い。\n表情筋が死んでいる。ごくまれにほほ笑むくらい。\n\n◇使用用途\n個人利用、個人用のグッズ制作\n\n上記内容になります。\n何か不備があれば再送要請を送っていただけると嬉しいです。\nご検討のほどよろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/11degVD2AX2O9xwv0FdAdwp6qj69mgdtj?usp=sharing", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@O1ziP3/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3674907, "client_id": 3267859, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/e18237bb/uploads/origins/46d1b207-36be-4fea-8886-e8b7acf2e8bd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=399ba360458443d8d464c1848c5b1580", "srcset": "https://si.imgix.net/e18237bb/uploads/origins/46d1b207-36be-4fea-8886-e8b7acf2e8bd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=399ba360458443d8d464c1848c5b1580, https://si.imgix.net/e18237bb/uploads/origins/46d1b207-36be-4fea-8886-e8b7acf2e8bd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=52f6497a841d16e18b6877aae40a7369 2x, https://si.imgix.net/e18237bb/uploads/origins/46d1b207-36be-4fea-8886-e8b7acf2e8bd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=419444a24d702e54a5f28fa5493d408e 3x"}, "durati