コンまたはヘッダーへの使用\nbio欄にXのIDを記載致します。\n\n┈┈┈┈┈┈┈┈┈┈\n\n上記内容で受理可能か御検討頂けれると嬉しいです。\nよろしくお願い致します。\n\nhttps://drive.google.com/drive/folders/1-358ppsq7EGIVoieafLzm2YdDNUxqHBQ", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}], "similar_creators": [{"id": 967254, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "ap1os", "screen_name": "ap1os", "avatar_url": "https://pbs.twimg.com/profile_images/2040776264802525184/syQ-JeNI.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1345180934077702144/1715133409/1500x500", "appeal_receivable": true, "popular_creator_rank": 98, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 90, "skills": [{"genre": "art"}], "banned": false, "nc": 48}, {"id": 2584614, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "ぶいつ@skebArtwork45%off  ～7/18", "screen_name": "wcv2", "avatar_url": "https://proxy.misskeyusercontent.jp/avatar/media.misskeyusercontent.jp%2Fio%2F0f453194-7109-4ac1-a7db-4dd0e6e07f2e.gif?avatar=1", "header_url": "https://media.misskeyusercontent.jp/io/1fed095c-1990-4265-b1ab-3856cd8c6def.gif", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 10, "complete_expiration_days": 95, "skills": [{"genre": "art"}, {"genre": "video"}], "banned": false, "nc": 0}, {"id": 2675685, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "縣 妖店長🖌🐿skeb募集中", "screen_name": "kinketusan0", "avatar_url": "https://pbs.twimg.com/profile_images/1829833048692609024/ORqal_HO.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1583076628061884416/1723651963/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": n