top&w=200&h=200&s=fef2766334a7354debd59853b0a5f191", "srcset": "https://si.imgix.net/aaf7b80c/uploads/origins/cd665c38-774d-4bfe-9153-28b1c63f8a6f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fef2766334a7354debd59853b0a5f191, https://si.imgix.net/aaf7b80c/uploads/origins/cd665c38-774d-4bfe-9153-28b1c63f8a6f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a274e77d1eac1873a4dd30d0d751ad28 2x, https://si.imgix.net/aaf7b80c/uploads/origins/cd665c38-774d-4bfe-9153-28b1c63f8a6f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=618355b419670397dce36544a41b7ce0 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/aaf7b80c/uploads/origins/cd665c38-774d-4bfe-9153-28b1c63f8a6f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=969fa57cbd14923f1d712141654dc2d3", "srcset": "https://si.imgix.net/aaf7b80c/uploads/origins/cd665c38-774d-4bfe-9153-28b1c63f8a6f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=969fa57cbd14923f1d712141654dc2d3, https://si.imgix.net/aaf7b80c/uploads/origins/cd665c38-774d-4bfe-9153-28b1c63f8a6f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=348745251f0f1c6431f0f7e66f354510 2x, https://si.imgix.net/aaf7b80c/uploads/origins/cd665c38-774d-4bfe-9153-28b1c63f8a6f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=d28f821e58df2bbe34cf2784c11a293c 3x"}, "body": "はじめまして。\necop様のイラストを拝見し、とても綺麗で魅力的だと感じました。\n是非ご依頼したいと思いリクエストを送信させて頂いた次第です。\n\n○リクエスト内容\nTRPGシナリオ「四季送り」にて使用したキャラクターの1枚絵\n※資料URLにデータの方添付しておきます\n\n○シチュエーション/構図\n・男性Aが簡単な朝ごはん(和食だと嬉しいです)を女性Bに振る舞う\n・女性Bは席に座っている(2人で食卓を囲める程度の机)\n・男性Aは少し照れている、視線を逸らしている\n上記3点を踏まえたシチュエーションだと嬉しいです。\n詳しい構図については特に指定はありません。\n\n○キャラクター詳細\n男性A\n165cm\n\n顔立ちが女性っぽいが男性。筋肉がない。\n無表情な事が多めだが少し微笑んだり、煽られると怒ったりもする。\n基本的に優しいが、自分の守りたいものを何よりも優先してしまう。\n女性Bのことが恋愛的に好き。\nエプロンを着せて頂けれると嬉しいです。\n\nまた、通常立ち絵と私服差分のイラストがGoogleドライブの方に入っていると思いますが、お顔は「通常立ち絵」の方参考にしていただけると嬉しいです。\n\n女性B\n155cm\n\n優しいお姉さん。\n大人びていてしっかりとしている。\nツッコミもしてくれる。\n男性Aのことは守りたいとは思っているが、恋愛的な感情はない。\n\n・関係性\n男性Aと女性Bは同じ甘味処で働いている。\n甘味処ではあるが裏では殺し屋もやっていたり。\n男性Aは女性Bに好意を持っているがそれを伝える気もなければ結ばれたいとも思っていない。\nただ幸せでいて欲しい、守りたいと思っている。\n女性Bも男性Aのことは守りたいと思っているが、庇護欲というか、恋愛感情ではない。\n\n○使用用途\n・TRPGセッション内のスチル\n(セッションの動画を限定公開でYouTubeにアップロードしようと思っていますが、「四季送り」のセッションを共に通過した方以外には公開致しません。概要欄にXのIDを記載致します。)\n・個人鑑賞\n・Xのアイコンまたはヘッダーへの使用\nbio欄にXのIDを記載致します。\n\n┈┈┈┈┈┈┈┈┈┈\n\n上記内容で受理可能か御検討頂けれると嬉しいです。\nよろしくお願い致します。\n\nhttps://drive.google.com/drive/folders/1-358ppsq7EGIVoieafLzm2YdDNUxqHBQ", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "similar_creators": [{"id": 2180108, "creator": true, "nsfw_acceptable": false, "acceptable": false, "name": "🐟", "screen_name": "kabe_sakana", "avatar_url": "https://pbs.twimg.com/profile_images/1417099161476878337/ydv4lN8l.jpg", "header_url": null, "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 10, "complete_expiration_days": 90, "skills": [{"genre": "art"}], "nc": 128}, {"id": 2180837, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "tr", "screen_name": "LML_love_", "avatar_url": "https://pbs.twimg.com/profile_images/1538517419345735680/RhJURxuT.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1535210128961830912/1681382142/1500x500", "appeal_receivable": true, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 120, "skills": [{"genre": "art"}], "nc": 128}, {"id": 3055641, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "マルヤロクセイ⏯", "screen_name": "maru_san_muri", "avatar_url": "https://pbs.