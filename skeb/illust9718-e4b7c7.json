x.net/753cc4fa/uploads/origins/d45590c2-0c6e-4eb4-a212-c2dcfe0fca0d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=89f74f995d3a0e36288516cd0a89ab86, https://si.imgix.net/753cc4fa/uploads/origins/d45590c2-0c6e-4eb4-a212-c2dcfe0fca0d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f6a8f4b6b1cb7795685788c52b4a2afa 2x, https://si.imgix.net/753cc4fa/uploads/origins/d45590c2-0c6e-4eb4-a212-c2dcfe0fca0d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d1c0494e61b3b84a4b64cd37ea20ff22 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/753cc4fa/uploads/origins/d45590c2-0c6e-4eb4-a212-c2dcfe0fca0d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a671f91c79f91211cf3eb5ddef413dce", "srcset": "https://si.imgix.net/753cc4fa/uploads/origins/d45590c2-0c6e-4eb4-a212-c2dcfe0fca0d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a671f91c79f91211cf3eb5ddef413dce, https://si.imgix.net/753cc4fa/uploads/origins/d45590c2-0c6e-4eb4-a212-c2dcfe0fca0d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=04e9137e6f4de9f842be549e513705d4 2x, https://si.imgix.net/753cc4fa/uploads/origins/d45590c2-0c6e-4eb4-a212-c2dcfe0fca0d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=8e9f8676d25093c61fe04ed733e61f62 3x"}, "body": "ぽぬさんこんにちは！お久し振りです！\n前回の依頼（https://skeb.jp/@illust9718/works/4）はとても素晴らしく、本当にありがとうございました。\nまたリクエスト希望を出させて頂くので一度読んで貰えると幸いです。\nご依頼したい内容は以下の通りです。\nモブせか（乙女ゲー世界はモブに厳しい世界です）二次創作小説のイラストをリクエスト致します。\n\n【キャラクター】\nキャラは二次創作小説の主人公であるアンジェとリオン。\n【キャラデザイン】\nキャラクターデザインは前回の依頼（https://skeb.jp/@illust9718/works/4）と同じです。\nアンジェの衣裝はワンピース（https://manus-machina.com/products/fore00039）にカーディガン（https://echoecho.thebase.in/items/72277729）を合わせる。\nリオンの衣裝は濃い色のシャツです。\n【シチュエーション】\nやっと和解した後、落ち込んだがアンジェに甘える。\n構図やポーズや表情は大体 \nhttps://x.com/mikumikulenlen/status/1820596289924419756\nhttps://www.pixiv.net/artworks/121202732\nな感じ、構図に無理があればずれすぎない程度に変更して大丈夫です。\n\n用途もモブせか二次創作小説『婚約破棄された公爵令嬢は田舎の醜男貴族に嫁ぎますが幸せになるようです』（https://syosetu.org/novel/307038/）の応援用、もし二次創作小説の作者本人がイラストとして使用したい場合は、許可をお願いします。\n\n好みに合わなかったり場合はキャンセルしていただいて大丈夫です。\n要望が多く申し訳ございません。\nご検討宜しくお願い致します。", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@illust9718/works/11", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2671859, "client_id": 1696482, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/708590a3/uploads/origins/bf469b52-8c90-4550-a533-4f7c0b6f9477?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5875991cb12e7e7e4a591f6d9dd5e966", "srcset": "https://si.imgix.net/708590a3/uploads/origins/bf469b52-8c90-4550-a533-4f7c0b6f9477?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5875991cb12e7e7e4a591f6d9dd5e966, https://si.imgix.net/708590a3/uploads/origins/bf469b52-8c90-4550-a533-4f7c0b6f9477?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=6390f00a811f6a762dc49a2585ce2d83 2x, https://si.imgix.net/708590a3/uploads/origins/bf469b52-8c90-4550-a533-4f7c0b6f9477?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=7959d75f5ea8fec5836978b1aea341a9 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/708590a3/uploads/origins/bf469b52-8c90-4550-a533-4f7c0b6f9477?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=1aaaeb31cf4161831eea242c0dd5609b", "srcset": "https://si.imgix.net/708590a3/uploads/origins/bf469b52-8c90-4550-a533-4f7c0b6f9477?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=1aaaeb31cf4161831eea242c0dd5609b, https://si.imgix.net/708590a3/uploads/origins/bf469b52-8c90-4550-a533-4f7c0b6f9477?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=b8bc922f745a5be0cd594dd5cdfac0fe 2x, https://si.imgix.net/708590a3/uploads/origins/bf469b52-8c90-4550-a533-4f7c0b6f9477?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=0a4243b554df5e64e4ec05c68d0e48b5 3x"}, "body": "こんにちは！僕は君のアートスタイルが好きだよ！\n\n私のオリジナルキャラクターを描いてくれませんか？名前はヴィヴィ。恥ずかしがり屋で、眠そうで、可愛くて、おっちょこちょい（てんねんぼけ）。\n\n忙しい一日が終わって、ロッカールームにいる彼女を描いてくれませんか？どんなポーズやシーンでも構いません！髪をおろしたり、上着を脱いだり。\n\nキャラクターのリファレンスとして、画像「Vivvy_Reference」を使ってください。このリクエストの詳細とわかりやすさのために、彼女はジャケットを着ていて、ジッパーがついています。ジャケットの周りには白い輪郭があります。白い輪郭はフードの周りにもあります。ジャケットの下には白いボタンアップシャツを着ています。シャツの襟にはティールカラーのリボンがついている。ジャケットの両脇には赤いストラップがある。ストラップはジャケットの腕に取り付けられている。\n\nありがとうございました！\n\nhttps://drive.google.com/drive/folders/1HUcuXQsHWu56g3JJK3d77In-SGIMUIKt?usp=drive_link", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@illust9718/works/10", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2671859, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/bfa33d9e/uploads/origins/94cfe58e-9399-497d-93fa-c31af0da4296?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c18dec53c46b6c7fd0acf82688c40868", "srcset": "https://si.imgix.net/bfa33d9e/uploads/origins/94cfe58e-9399-497d-93fa-c31af0da4296?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c18dec53c46b6c7fd0acf82688c40868, https://si.imgix.net/bfa33d9e/uploads/origins/94cfe58e-9399-497d-93fa-c31af0da4296?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e6f6cb43fe2a0ed02024ffc36bc341c8 2x, https://si.imgix.net/bfa33d9e/uploads/origins/94cfe58e-9399-497d-93fa-c31af0da4296?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c9edb00e84d880568fdd1554baab377a 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/bfa33d9e/uploads/origins/94cfe58e-9399-497d-93fa-c31af0da4296?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=818afee1678f302e7708eb4be7eab864", "srcset": "https://si.imgix.net/bfa33d9e/uploads/origins/94cfe58e-9399-497d-93fa-c31af0da4296?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=818afee1678f302e7708eb4be7eab864, https://si.imgix.net/bfa33d9e/uploads/origins/94cfe58e-9399-497d-93fa-c31af0da4296?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=93d22f21e7cbf716e65eb949cb7cfe17 2x, https://si.imgix.net/bfa33d9e/uploads/origins/94cfe58e-9399-497d-93fa-c31af0da4296?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=027d5f8d45279eceb02954be80eb56d6 3x"}, "body": "ぽぬ。様、こんにちは。\n以前、すずめの戸締りの鈴芽ちゃんをリクエストさせて頂きました。\nまた新しいイメージが固まりましたので鈴芽ちゃんをリクエストさせてください!\n\nイメージは鈴芽座って後ろ髪を結んでいる様子となります。\n服装は今回も制服＆裸足姿で、次の資料の女の子達の様なイメージで座っている様子を少し下から見上げているイメージのアングルでお願いいたします。（こちらの方に不意に顔、視線を向けている瞬間イメージです）\nhttps://imgur.com/iou0soN\nhttps://imgur.com/KIsX0ZR\n\nお願いさせて頂きたいポイントは、資料の女の子の様につま先を内股気味に内側に向けてくるぶしや踵側がこちらに突き出している座り方でお願いいたします!\n※ふくらはぎの筋肉が圧迫された感じや、くるぶしや踵の造形の凹凸や質感が映えるようにイメージして頂きたいです!（アングル的に今回の主人公はくるぶしや踵周りメインなイメージです）\n座り方は資料の女の子の様な女の子座りか正座かぽぬ。様のお好みの方でお選びいただけましたら幸いです。\n\nこの様なイメージでお願いいたします！\nすいません、また肌の色味ですが今回も前回と同じで鈴芽ちゃんの肌の色は特徴的な濃いめなスキンカラーでお願いいたします‼", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@illust9718/works/9", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2671859, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/8ad62d6a/uploads/origins/775ee747-651c-4aee-ad60-28e0e5c7329b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8f4cf6ee90b6dcfc441bd34b9efad0aa", "srcset": "https://si.imgix.net/8ad62d6a/uploads/origins/775ee747-651c-4