t=crop&crop=top&w=200&h=200&s=87f1587fedc3a823a298e62ee59b58da, https://si.imgix.net/cb8ca5bc/uploads/origins/427db226-2dc0-4ba5-b328-67db266ffb26?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ea5eeeb8a6d44f8cfa4e098438bbf66b 2x, https://si.imgix.net/cb8ca5bc/uploads/origins/427db226-2dc0-4ba5-b328-67db266ffb26?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ea4de809d5f2ffca5c0fdb3e8ba0f667 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/cb8ca5bc/uploads/origins/427db226-2dc0-4ba5-b328-67db266ffb26?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ef427c3a53ecb69ceb9f0f27fc8a7191", "srcset": "https://si.imgix.net/cb8ca5bc/uploads/origins/427db226-2dc0-4ba5-b328-67db266ffb26?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ef427c3a53ecb69ceb9f0f27fc8a7191, https://si.imgix.net/cb8ca5bc/uploads/origins/427db226-2dc0-4ba5-b328-67db266ffb26?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=207cd66b00ed5a948e50d6d1ab03cf17 2x, https://si.imgix.net/cb8ca5bc/uploads/origins/427db226-2dc0-4ba5-b328-67db266ffb26?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=b4f892ad54c4eb72ab26697c9272d1f4 3x"}, "body": "初めまして！原作：綾辻行人『Anotherシリーズ』が大大大好きな長文子ちゃんと申します！\n以前にも一度同じリクエストをさせて頂いたのですが納品期限に間に合わなかったみたいなので、もう一度リクエストさせて下さい。もし不都合がある場合はキャンセルをお願いします。\n早速ですが、自分が執筆したSSであるアニメ版の風見智彦が主役の『風見くんの読書の秋』を漫画化して頂けないでしょうか？\n↓今回は以下の風見と望月優矢の会話シーンをお願いしたいです。\n望月「ねぇねぇ、風見くん。」\n風見「何？望月。」\n望月「風見くんはさ、エルヴァルド・ムンクって好き？」\n風見「どうしたの突然。」\n望月「この前、榊原くんと『ムンクの叫び』について語り合ったんだ。美術部以外の人で語り合える人がいなかったから、嬉しくなっちゃって。」\n風見「そうなんだ。でも僕はその手の知識には詳しくないかなぁ。」\n望月「そっか。風見くんは頭良いし物知りだからいけるかなと思ったんだけどな……（溜息）」\n風見「（クラスメイトをガッカリさせるなんて委員長失格じゃないか！！！）あ、でも興味はあるかも！」\n望月「本当に！？なら、これ貸してあげる！ムンクの画集！『ムンクの叫び』以外にも名画がたくさん載っているよ！」\n風見「あ、ありがとう……。」\n帰宅後、エドヴァルド・ムンクと『ムンクの叫び』について猛勉強する風見。\n\n出来れば服装は冬服の制服姿が望ましいです（かざみんは学ランでもっちーは白シャツ）\n基本的な構図や多少のアレンジに関してはお任せします。\n宜しくお願いします！\nhttps://ameblo.jp/choubunkochan/entry-12279980438.html\n\nhttps://drive.google.com/drive/folders/1qQzUR9Nf_q99Sf8C1ZxOdChFp8KOXMZ5?usp=drive_link", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@illust9718/works/15", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2671859, "client_id": 3276469, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/073c5d37/uploads/origins/70c853af-fe7b-49c8-afc5-dd8a1236566d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b6579da194f90167b4c169c6d300cdf5", "srcset": "https://si.imgix.net/073c5d37/uploads/origins/70c853af-fe7b-49c8-afc5-dd8a1236566d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b6579da194f90167b4c169c6d300cdf5, https://si.imgix.net/073c5d37/uploads/origins/70c853af-fe7b-49c8-afc5-dd8a1236566d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=7702558c9e3bd758fd632b9499504446 2x, https://si.imgix.net/073c5d37/uploads/origins/70c853af-fe7b-49c8-afc5-dd8a1236566d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=549edb2eccd7fd6ecb37154ea8477453 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/073c5d37/uploads/origins/70c853af-fe7b-49c8-afc5-dd8a1236566d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9828f7e38263eafff0cc27472d7dd40e", "srcset": "https://si.imgix.net/073c5d37/uploads/origins/70c853af-fe7b-49c8-afc5-dd8a1236566d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9828f7e38263eafff0cc27472d7dd40e, https://si.imgix.net/073c5d37/uploads/origins/70c853af-fe7b-49c8-afc5-dd8a1236566d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&