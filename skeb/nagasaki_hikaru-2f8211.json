-d260-4639-a29b-8cbb8e34fd01?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=1cc49a79b6134f7a5495efa2ccaf2eed", "srcset": "https://si.imgix.net/97dfd9b8/uploads/origins/78a19d1e-d260-4639-a29b-8cbb8e34fd01?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=1cc49a79b6134f7a5495efa2ccaf2eed, https://si.imgix.net/97dfd9b8/uploads/origins/78a19d1e-d260-4639-a29b-8cbb8e34fd01?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=225d71e13f675df9c8148a9d98641deb 2x, https://si.imgix.net/97dfd9b8/uploads/origins/78a19d1e-d260-4639-a29b-8cbb8e34fd01?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=19e8cac40a8a9948b4b6d731eaae32a8 3x"}, "body": "毎度毎度にてのヒカリちゃんのリクエストありがとうございます！\nまた続きのリクエストお願いします！\n\n内容(アレンジOK)\n濃厚なキスで惚けるヒカリ。\nヒカリは温泉の端の岩に腰掛けてレックスはヒカリの両肩を掴む。\nレックスはヒカリの豊満な乳房を感情が制御出来ずなのか強く握り\n乳首にかぶりつく。\n舐める。吸う。噛みつく(甘噛み)等々興奮しながらヒカリの乳房は自分だけのものと言わんばかりに、跡が付きそうな程ヒカリの胸を堪能している。\n\n出来ればやってほしいコマ\n上記での「舐める。吸う。噛みつく(甘噛み)」を小さく１コマずつ書いてほしい。同時にその下(もしくは横か上)にその時のヒカリの表情も小さく１コマ書いてほしいです。\n\n表情と台詞\n基本は吸われている時は目を瞑って小さく声を出している。\nでも段々と声が上がっている。\n\n入れてほしい台詞(全く同じでもなくても良いですしアレンジOK)\nレックス「ヒカリの...俺の...俺だけの...!」\nヒカリ「ダメェ...跡が付いちゃうよぉ...」\n\n大体こんな感じです。\n上記のが作りづらいと思いましたら大体似た感じでのシチュエーションであるのでしたらお好きな形でのアレンジでお願いします。\n\nどうかお願い致します！", "nc": 160, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@nagasaki_hikaru/works/9", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 165622, "client_id": 388373, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/b3f2cdb1/uploads/origins/77e689d7-63bc-465e-9a23-9676a6d8b956?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0aa82461adf8cd4e678ac71e18a81ee2", "srcset": "https://si.imgix.net/b3f2cdb1/uploads/origins/77e689d7-63bc-465e-9a23-9676a6d8b956?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0aa82461adf8cd4e678ac71e18a81ee2, https://si.imgix.net/b3f2cdb1/uploads/origins/77e689d7-63bc-465e-9a23-9676a6d8b956?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=37bde144b28e5ae10964dad718acac25 2x, https://si.imgix.net/b3f2cdb1/uploads/origins/77e689d7-63bc-465e-9a23-9676a6d8b956?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=2cddf5107b49a70b968fc9e8a4a7c406 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/b3f2cdb1/uploads/origins/77e689d7-63bc-465e-9a23-9676a6d8b956?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=cbaec1ae45e85f77de623888ba795198", "srcset": "https://si.imgix.net/b3f2cdb1/uploads/origins/77e689d7-63bc-465e-9a23-9676a6d8b956?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=cbaec1ae45e85f77de623888ba795198, https://si.imgix.net/b3f2cdb1/uploads/origins/77e689d7-63bc-465e-9a23-9676a6d8b956?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=674902db3d5cb8b2b5d024e5e6214432 2x, https://si.imgix.net/b3f2cdb1/uploads/origins/77e689d7-63bc-465e-9a23-9676a6d8b956?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=2e8770d7789d2564c06435250632ad3b 3x"}, "body": "ヒカリちゃんのリクエストありがとうございました！\n続きが見たくてまたリクエストを申し込みたいと思いました\nお願いします！\n\n内容\n前回の続き\n\nヒカリの挑発にレックスは頬を真っ赤にしながらヒカリと真正面になって\n徐々に顔を近づける。(二人とも頬が真っ赤で息を切らしそうなぐらい興奮している)\nヒカリはキュッと目を閉じる。レックスは意を決してヒカリを強く抱き締めてキス。\n最初は唇を何度もつつきあうようなキスから激しさをまして舌を絡ませてディープキスになっていった。\n\n上記を出来ればまた２ページでお願いします。\nもしも足りなかったりここをこうしたいなどアレンジを加えたいと思いましたら是非お願いします。(例えばキスの途中で胸を揉んだり等々)\n\nどうかお願い致します！", "nc": 32, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@nagasaki_hikaru/works/8", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 165622, "client_id": 388373, "vtt_url": null, "t