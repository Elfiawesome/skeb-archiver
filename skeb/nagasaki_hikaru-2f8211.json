=30&txt=PRIVATE&s=86626c6995d5648153f98939728d9d81 3x"}, "private": true, "genre": "art", "tipped": true, "creator_id": 165622, "client_id": 566932, "nc": 160}, {"path": "/@nagasaki_hikaru/works/15", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 165622, "client_id": 388373, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/acda8e01/uploads/origins/1eb19a32-a1f0-420d-abec-dad049d14399?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=838649ed2f0067e077482c0c96f024bf", "srcset": "https://si.imgix.net/acda8e01/uploads/origins/1eb19a32-a1f0-420d-abec-dad049d14399?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=838649ed2f0067e077482c0c96f024bf, https://si.imgix.net/acda8e01/uploads/origins/1eb19a32-a1f0-420d-abec-dad049d14399?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=1c7f1c96ecde403f3b537b28ee0153a5 2x, https://si.imgix.net/acda8e01/uploads/origins/1eb19a32-a1f0-420d-abec-dad049d14399?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=8341363e1a057b01f6ec9a934b53bb32 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/acda8e01/uploads/origins/1eb19a32-a1f0-420d-abec-dad049d14399?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=4f84979b4dc189cb62305db902407475", "srcset": "https://si.imgix.net/acda8e01/uploads/origins/1eb19a32-a1f0-420d-abec-dad049d14399?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=4f84979b4dc189cb62305db902407475, https://si.imgix.net/acda8e01/uploads/origins/1eb19a32-a1f0-420d-abec-dad049d14399?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=d1c312bc58a69e6138913aba53340da0 2x, https://si.imgix.net/acda8e01/uploads/origins/1eb19a32-a1f0-420d-abec-dad049d14399?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=4246bf52cb284488f404c9d86856d859 3x"}, "body": "久しぶりのリクエスト恐縮ですがお願いしたいと思っています\nまたヒカリちゃんの内容続きをお願いしたいです!\n\n一枚目\nヒカリに挿入しようとするレックスに対してジタバタと暴れて拒否するヒカリ（コメディ風に）\n・台詞回し\nヒカリ「ちょッ！待ってここでなんてイヤ！」\nレックス「そんな！？ヒ、ヒカリの方が誘ってきたんじゃないか！」\nヒカリ「そ、そうだけどぉ！」\n\n二枚目\n上に小さいコマでヒカリの目がキッとさせる\nヒカリが「ダメ！」と言ってレックスを突き放す\n「イテテ…」と背中を打つレックス\n\n三枚目\nヒカリはレックスの股に顔を埋めて股間を握り舌で先端を舐めながら恥ずかしさと先程の行動に対しての申し訳無い気持ちでレックスを見つめる\n「ヒカリ！？」と驚くレックス\nヒカリは「ん…チュ♡」と男根の先端をキスするみたいに吸う\n\n四枚目\n気持ちよさに悶えるレックス\nそんなレックスに「ごめんなさい、今はこれで我慢して…んッ」と片手で男根を握りもう片方の手で自分の横髪を掬って男根の先端（亀頭）の半分を口に咥える\n\n五枚目\nヒカリの名前を呼びながら悶えてヒカリの頭を優しく掴んでいるレックス\n2〜3個程のコマを使ってヒカリのフェラ\n例:這うように舌で舐める\n　玉を咥える\n　「ひもひいい？（気持ちいい？）」と言いながら亀頭を甘噛み\n\n六枚目\n激しくフェラするヒカリ\n「ヒカリ…！俺、もう!!」と射精寸前のレックス\n「だひて…！レックスのミルクひょうだい♡」と言いながら\n\"ジュポッ\"ジュポッ\"と音を立てながら目をつぶって射精を促す\n\n\n以上です\n大体上気の様な感じでお願いしたいです。\n上気の内容を踏まえて作りやすいようにアレンジでもOKです!\n例えば\n・レックスとヒカリの押し問答\n↓\n・押し倒されて背中を打つレックス\n↓\n・レックスの股間に顔を埋めて男根にキスすらヒカリ\n↓\n・謝りながらフェラを開始するヒカリ\n↓\n・様々なやり方でフェラするヒカリ\n↓\n・ラストスパートでより激しくフェラするヒカリ\n\n等とこの様なポイントを使って制作してほしいです\nそれと私が提示したコマについての指定もあくまで目安ですのでそちらもしたいようにアレンジしても大丈夫です。\n\n久しぶりになりましたがどうかお願い致します！", "nc": 176, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@nagasaki_hikaru/works/14", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 165622, "client_id": 388373, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/c6155676/uploads/origins/d2a99619-3991-4869-a0d8-97302addc96f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=88becb677ab078d5f3c72d68eee69253", "srcset": "https://si.imgix.net/c6155676/uploads/origins/d2a99619-3991-4869-a0d8-97302addc96f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=88becb677ab078d5f3c72d68eee69253, https://si.imgix.net/c6155676/uploads/origins/d2a99619-3991-4869-a0d8-97302addc96f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=d1b13a63c2c77df92207f235b7715c42 2x, https://si.imgix.net/c6155676/uploads/origins/d2a99619-3991-4869-a0d8-97302addc96f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=efc1c0cd77b80fafa010d73e637e2447 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/c6155676/uploads/origins/d2a99619-3991-4869-a0d8-97302addc96f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=bacc2ded494a1bcca81b72f48aab2075", "srcset": "https://si.imgix.net/c6155676/uploads/origins/d2a99619-3991-4869-a0d8-97302addc96f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=bacc2ded494a1bcca81b72f48aab2075, https://si.imgix.net/c6155676/uploads/origins/d2a99619-3991-4869-a0d8-97302addc96f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=56cb01bc7d0f9ed3450a423ddfed6b8b 2x, https://si.imgix.net/c6155676/uploads/origins/d2a99619-3991-4869-a0d8-97302addc96f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=95d35b8eae43af0df774c1022c490e11 3x"}, "body": "毎度の事ながらリクエストお願い致します！\n前回の続きにて(いつものごとくアレンジOKです)\n１枚目\nヒカリの台詞のあとにちょっと理性が切れかけているレックスが\nまた押し倒してヒカリの両手首を掴んでヒカリの母乳を思うままに吸い上げる\nゴクゴクと美味しそうに吸うレックスにヒカリは微笑みながらも「良いよ...いっぱい飲んで」と言う\n２枚目\nレックスはヒカリの名を言い吸いながらおもむろにヒカリの股を開かせて\n男根の先っぽをヒカリの秘部に擦り付ける\n挿入されそうになり「え！？ちょ、ちょっと待って！？」と予想外の展開だったのか驚くヒカリだった\n\n以上です\nまた出来れば宜しくお願い致します！", "nc": 32, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@nagasaki_hikaru/works/13", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 165622, "client_id": 2568758, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/7f615cf8/uploads/origins/042c061d-6740-4d92-9414-0a745a2549fa?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=444ab343eac4d036e4dbb012d900c84f", "srcset": "https://si.imgix.net/7f615cf8/uploads/origins/042c061d-6740-4d92-9414-0a745a2549fa?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=444ab343eac4d036e4dbb012d900c84f, https://si.imgix.net/7f615cf8/uploads/origins/042c061d-6740-4d92-9414-0a745a2549fa?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=8e18fe97d6e457c834cda2d36d094ab2 2x, https://si.imgix.net/7f615cf8/uploads/origins/042c061d-6740-4d92-9414-0a745a2549fa?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=5a83c0d01f141d95f98ea258f1f9416e 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/7f615cf8/uploads/origins/042c061d-6740-4d92-9414-0a745a2549fa?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=958ef8a5d06ffced7c3b6b4e8d75db0e", "srcset": "https://si.imgix.net/7f615cf8/uploads/origins/042c061d-6740-4d92-9414-0a745a2549fa?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=958ef8a5d06ffced7c3b6b4e8d75db0e, https://si.imgix.net/7f615cf8/uploads/origins/042c061d-6740-4d92-9414-0a745a2549fa?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=2bab37dad0bd093b3fcca292a10732d8 2x, https://si.imgix.net/7f615cf8/uploads/origins/042c061d-6740-4d92-9414-0a745a2549fa?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=013624b8bd3d52e52f4204b85f4ecf0a 3x"}, "body": "はじめまして。\n先日ご投稿されてたレックスにいたずらされるホムヒカのイラストを拝見してとても好みだったのでリクエストさせてください!\nスマブラでゼノブレイド2のヒカリが手前やられをしているシーンをながさきひかる先生のイラストで再現してほしいです。\n衣装は谷間が見えている方のデフォルト衣装でお願いします(あくまで健全絵でお願いします)。\nポーズは体と顔が画面に向かって正面を向いていればあとはお任せいたします。\n表情は片目を閉じて若干痛そうにしている様子でお願いします(あまり過剰にしないでほしいです)。\n背景および剣の有無はお任せいたします。\nそして原作にはない要素ではありますが、画面に張り付いているような表現がほしいです。\n胸と頬と手（＋お任せ）が画面に張り付いているような効果を足してほしいです。\n特殊な依頼で恐縮ではございますが、ご検討よろしくお願いいたします。", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@nagasaki_hikar