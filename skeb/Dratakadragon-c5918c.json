\n・淡い水色のうさ耳（星型のピアス付き）\n\nファンネームのイメージキャラクター「ゆきち」も、\n収まりのいいところに入れていただけると嬉しいです。\n（ポニーテールとツインテールの2種類については、それぞれ違うポーズと配置で、\n落ち着いた、あまり活発すぎない姿勢をイメージしております。）\n\n胸のサイズは少し控えめにしていただけると、三面図の雰囲気に近づくかと思います。\nあわせて右肩のほくろも見えるようでしたら嬉しいです。\n\n難しいものは省いていただいて大丈夫ですので、\nできる範囲でご対応いただけますと幸いです。", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Dratakadragon/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3301438, "client_id": 4044887, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/f932e822/uploads/origins/db6bce98-e7ed-43d3-a85d-f8655c319fae?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8693a366b6a3cabd440316a0930d3330", "srcset": "https://si.imgix.net/f932e822/uploads/origins/db6bce98-e7ed-43d3-a85d-f8655c319fae?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8693a366b6a3cabd440316a0930d3330, https://si.imgix.net/f932e822/uploads/origins/db6bce98-e7ed-43d3-a85d-f8655c319fae?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=52089b25c6eb04a64dc678259df81a10 2x, https://si.imgix.net/f932e822/uploads/origins/db6bce98-e7ed-43d3-a85d-f8655c319fae?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d0d4345b7b2607431b4af7a302052859 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/f932e822/uploads/origins/db6bce98-e7ed-43d3-a85d-f8655c319fae?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=eb90f2300bbb63e2cdbc67499cce717e", "srcset": "https://si.imgix.net/f932e822/uploads/origins/db6bce98-e7ed-43d3-a85d-f8655c319fae?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=eb90f2300bbb63e2cdbc67499cce717e, https://si.imgix.net/f932e822/uploads/origins/db6bce98-e7ed-43d3-a85d-f8655c319fae?bg=%23fff&auto=format%2Ccompress&fm=webp&