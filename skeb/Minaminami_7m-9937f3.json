もじい思いをしたのもあり強欲で、己の欲にどこまでも正直。我慢するということを知らない。\n人を驚かせたり怒らせたりすることで本性を暴こうとする性質がある。性格が悪い。\n\n◆見た目の詳細\n\n・男\n・183cm、58kg(ヒョロ長い)\n・明るめだがくすんだ褐色\n・右手の手首〜ひじ、中指、薬指にタトゥー\n・常に笑っているような目\n・少しくせのある短髪。白い毛を毛先のみオレンジ色に染めている。\n・金色の目と縦長の瞳孔(現在は色味が変わり、金+藍色の瞳です)\n・左目の下に涙ぼくろがあり、犬歯が鋭い。\n\nhttps://drive.google.com/drive/folders/1mT7tD2lwmoal1gcDF8cgg4djANBMTlbH?usp=drive_link", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "similar_creators": [{"id": 1737016, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "奈落₁", "screen_name": "0_teihen", "avatar_url": "https://pbs.twimg.com/profile_images/1487401352812982273/sQY6j4Jx.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1438029153312264194/1661779662/1500x500", "appeal_receivable": true, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "art"}], "banned": false, "nc": 16}, {"id": 1931739, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "やわらかモフ愛し存在", "screen_name": "mohusaikoudesu", "avatar_url": "https://pbs.twimg.com/profile_images/1605498391865106434/qyP_N2s_.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1494886634508066820/1674608645/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "art"}], "banned": false, "nc": 1}, {"id": 2606226, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "🐏TRPG🐑むつき", "screen_name": "mutsu_trpg", "avatar_url": "https://pbs.twimg.com/profile_images/2001568684448587776/dFRgjFat.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1441017655054397444/1731750256/1500x500", "appeal_receivable": false, "popular_c