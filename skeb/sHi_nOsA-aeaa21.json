759a/uploads/origins/cfb6c81b-b6de-403a-aabe-142f818dd527?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3b47b302b16a44a181099613748b1a69, https://si.imgix.net/e1cd759a/uploads/origins/cfb6c81b-b6de-403a-aabe-142f818dd527?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=412b85a48ebfb59cbb52cec11f698efd 2x, https://si.imgix.net/e1cd759a/uploads/origins/cfb6c81b-b6de-403a-aabe-142f818dd527?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=552ceb31539d724ba562e06797343f66 3x"}, "body": "新木さん絵が大変に好きです！\n落書きイラストでの依頼になりますが、押井くんと松日楽の日常やシナリオ本編中のワンシーンなどなどをお願いします！\nチョイスは新木さんにお任せいたします！\n本当にありがとうございました！", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@itto3344/works/47", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1640691, "client_id": 2344555, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/8dc62aad/uploads/origins/304437c8-6c49-4849-97d8-7f3e67d282cd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=afc0f22770a2408222744d2227188ce0", "srcset": "https://si.imgix.net/8dc62aad/uploads/origins/304437c8-6c49-4849-97d8-7f3e67d282cd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=afc0f22770a2408222744d2227188ce0, https://si.imgix.net/8dc62aad/uploads/origins/304437c8-6c49-4849-97d8-7f3e67d282cd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=bbd706708c8ce000f3987d3773e806ba 2x, https://si.imgix.net/8dc62aad/uploads/origins/304437c8-6c49-4849-97d8-7f3e67d282cd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a6d7c339ce5482961da7affafee76468 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/8dc62aad/uploads/origins/304437c8-6c49-4849-97d8-7f3e67d282cd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=702df7b20827edf77d53971859dde956", "srcset": "https://si.imgix.net/8dc62aad/uploads/origins/304437c8-6c49-4849-97d8-7f3e67d282cd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=702df7b20827edf77d53971859dde956, https://si.imgix.net/8dc62aad/uploads/origins/304437c8-6c49-4849-97d8-7f3e67d282cd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=18ffa487217aaecb70c71cdcd7ff1f0d 2x, https://si.imgix.net/8dc62aad/uploads/origins/304437c8-6c49-4849-97d8-7f3e67d282cd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=5e957d4fac1e15054ee88823a5af94b0 3x"}, "body": "はじめまして。\n先日itさんの絵をSkebでお見かけして素敵な雰囲気のイラストに惚れてしまったので依頼させていただくことにしました！\nさっそくですが、描いていただきたいのはクトゥルフ神話TRPGの「蹂躙するは我が手にて」というシナリオの自陣4名の一枚絵です。\nシナリオの公開HO通り敵国同士で、互いに因縁やら恨みやらを抱いているので仲はよくはありません。\n以下、希望シチュエーションや簡単な探索者紹介と立ち絵資料をまとめました。\n\n＝＝＝＝＝＝＝＝＝＝＝\n【シチュエーション】\n・ほの暗い執務室のような室内でソファ(シェーズロングのようなアンティーク調のもの)に座るふたり(後述AとC)、その後ろくらいに立つふたり(後述BとD)\n※映画のポスターライクを想像していますがその他すべてお任せいたします。\n\n【自陣紹介】\n・A国〈アクティリウス共和国〉\n政治的指導者：Theo Wilhelm Eberwein\nテオ・ヴィルヘルム・エーベルヴァイン(24)/ 159㌢\n自陣最年少ながら自分が一番上だと信じてやまない。誰に対しても平等に偉そうに接してくる。いわゆる箱入りだが才能は確か。育ちが良く上品だが足癖は悪い。Bとは犬猿。武器はグロック。\n「俺が統べる世界にこそ、真の平和と安寧がもたらされる。全世界の調和、それを為すことがアクティリウスの民の使命であり、俺の正義だ」\n\n・B国〈東シュテロイア共和国〉\n将軍：Rudy Kloesel Kaiser\nルディ・クローゼル・カイザー(34)/ 179㌢\n戦争が好きだが、それよりも人が争う様を見ることが好き。自分が欲するもののためなら何でもする。誰よりも軍人で状況判断能力に優れる。全体的に荒っぽく勇ましい。武器マニアだが愛用は槍。\n「やはり人間共の争いはいつ見ても気分が良いものだ！！！もっとその闘争心を俺に見せてくれ！！」\n\n・C国〈都市国家シティシャン〉\n参謀総長：Whale・M・Herman\nイサナ・M・ハーマン(42)/ 181㌢\n生粋の策士。引き籠りがちでだらけ癖を持ち合わせているが、興味の向いたことや自分がやるべきと判断したことには精力的に動く。鯨のぬいぐるみをかわいがっている。武器はトカレフ。\n「ぼくが好きなのは転遷、つまりは革変であり革命です。革命には戦火は必要でしょう？領土を守るにせよ奪うにせよ壊すにせよ知識や力だけではなく技術も必要です。技術とは文明とは戦火を持って発展するものです。ですから戦うのです。国を先進させる為に、戦火は必要だと思いませんか？」\n\n・D国〈タァトナハト王国〉\n技術研究所所長：Elijah = Summerfield\nエリヤ=サマーフィールド(35) / 189㌢\n自他ともに認める稀代の天才。ダウナーな見た目に反して陽気で子どもっぽい。戦闘もできる研究職。幼い頃に右目を食べてしまい今はそこに義眼が収まる。自陣のなかでは一番平和主義者。Cは天敵。武器は木斧。\n「俺は別に争いとか世界の情勢とか興味ないんだよねェ。ただ俺に未知を教えてくれたこの国に恩を返したかった。俺の持ってる全部で。それだけだったんだけどねェ」\n\n【参考資料】\n資料URL参照\n\n＝＝＝＝＝＝＝＝\n【その他】\n・使用用途\n→自陣メンバーへの共有、鑑賞。自陣のみのグッズ化\n・Skebでの集合絵依頼が不慣れですので、もし金額に不備などありましたら再送してください。\n\n以上、ご検討よろしくお願いします。\n\nhttps://drive.google.com/drive/folders/1WM3rterHXB3UNwl8fVCC6VPWdxcBZMrV?usp=sharing", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@taison4444/works/47", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2777217, "client_id": 2344555, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/426b0508/uploads/origins/c0d1a6c0-f624-44ad-86ac-077c4e917df6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fdbc4ed3253fafd933943ca472f1a060", "srcset": "https://si.imgix.net/426b0508/uploads/origins/c0d1a6c0-f624-44ad-86ac-077c4e917df6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fdbc4ed3253fafd933943ca472f1a060, https://si.imgix.net/426b0508/uploads/origins/c0d1a6c0-f624-44ad-86ac-077c4e917df6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f80bf77ce291fe676d931c7b387ba7fb 2x, https://si.imgix.net/426b0508/uploads/origins/c0d1a6c0-f624-44ad-86ac-077c4e917df6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e7975435cef8fe7be2544cd7b1b31a24 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/426b0508/uploads/origins/c0d1a6c0-f624-44ad-86ac-077c4e917df6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=84e50fac910d684c106d3e402794d0bc", "srcset": "https://si.imgix.net/426b0508/uploads/origins/c0d1a6c0-f624-44ad-86ac-077c4e917df6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=84e50fac910d684c106d3e402794d0bc, https://si.imgix.net/426b0508/uploads/origins/c0d1a6c0-f624-44ad-86ac-077c4e917df6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=cbd3ce498ed73e496a6d3f3e564067da 2x, https://si.imgix.net/426b0508/uploads/origins/c0d1a6c0-f624-44ad-86ac-077c4e917df6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=187d4ae614f4430e6a272a5eaf18ad59 3x"}, "body": "はじめまして。\n町葬屋怪異譚とても楽しく通過させていただき、シナリオの余白にたくさんの愛を見て今もです。\n\n今回、HO1を担当した自探索者とミナギさんを依頼させていただきたいと思っています。\n構図などの詳細はお任せいたします。\n弊ほいちーふは自陣の良きパパであろうとしましたが少しドジなところがあり、いまいち言葉足らずですが愛だけはたっぷり持っています。SIZとSTRがあいまって昔から今に至るまで零辻家を壊している可能性もありますが、ミナギさんは笑って(引き攣ってるかも)許してくれたかも？？と思っています。そう思わせてくれるミナギさんのすべてが本当に好きで、彼は私がダイスに負けて亡くなってしまいましたが、この家で暮らしながら彼の優しさに触れて泣いて、それでも笑っていくんだなと思いました。\n\n太子さんにいつか依頼したいと考えていて、勢いのままに書いてしまっているので、不備や失礼などがありましたら大変申し訳ございません。\n以上、どうぞよろしくお願いいたします。\n\n＝＝＝＝＝\nCS：https://iachara.com/view/4790265\n資料：https://drive.google.com/drive/folders/1C1LVktVJRNBlx9nVOZstSF27C4L9fBJB?usp=sharing\n＝＝＝＝＝", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@RARI_tacHibana/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 742757, "client_id": 2344555, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/566e3c1a/uploads/origins/d3f2d11c-638d-4c3e-9e19-961165e35c2b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9094629476cb3402591e60768ad54448", "srcset": "https://si.imgix.net/566e3c1a/uploads/origins/d3f2d11c-638d-4c3e-9e19-961165e35c2b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9094629476cb3402591e60768ad54448, https://si.imgix.net/566e3c1a/uploads/origins/d3f2d11c-638d-4c3e-9e19-961165e35c2b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=be2a4171c9237693fb26d54493735b4a 2x, https://si.imgix.net/566e3c1a/uploads/origins/d3f2d11c-638d-4c3e-9e19-961165e35c2b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=8ea