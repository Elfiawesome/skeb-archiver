c-7e65-47de-8c14-c47e9bef5eee?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5b159d00d4e0cb59193a3f8056968f74, https://si.imgix.net/e6afda75/uploads/origins/dfcf60dc-7e65-47de-8c14-c47e9bef5eee?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=507356ccd3a85c34273dbf4c1eb4eac1 2x, https://si.imgix.net/e6afda75/uploads/origins/dfcf60dc-7e65-47de-8c14-c47e9bef5eee?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=1dff09c45ea703f7e5277f45bab5393f 3x"}, "body": "こんにちは！善は急げ！思い立ったが吉日！\nソプスクHO3さんのイラストを見てからずっと依頼をしたいと思い続けていたので今回依頼失礼します…！\n\n依頼内容について悩んだ結果決められなかったので四六時さんのリクエスト候補のどちらか描きたい方を選んでいただけたら嬉しいです。\n\n①\n資料先の「古扉 和葉」の立ち絵\n穏やかな性格の男なので動きのあるポーズというよりは佇んているといったポーズの方が嬉しいです。\n構図や枚数。髪型などはすべてお任せいたします。\n\n②\n資料先の自宅カプの古扉と詩待を描いていただきたいです。\nこちらは全身～パストアップ何でも構いません。\n予算内で収まる範囲で書いていただけたら幸いです。\n構図や枚数。服装、髪型などはすべてお任せいたします。\n\n依頼内容が金額と見合わない、その他不備などがあればお気軽に再送要請してください。\nご検討よろしくお願いします！\n\nhttps://photos.app.goo.gl/Vj7nFifDgGQxT2q58", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@1d46_/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2596387, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/33e2d875/uploads/origins/0696cf76-6c13-43bc-b680-31b502904279?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=962f06bb8dc85c8c1c3aa967da7b9837", "srcset": "https://si.imgix.net/33e2d875/uploads/origins/0696cf76-6c13-43bc-b680-31b502904279?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=962f06bb8dc85c8c1c3aa967da7b9837, https://si.imgix.net/33e2d875/uploads/origins/0696cf76-6c13-43bc-b680-31b502904279?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=91845c714c258294f9e9bb734478003d 2x, https://si.imgix.net/33e2d875/uploads/origins/0696cf76-6c13-43bc-b680-31b502904279?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e01c30e03b48dc6c4e1a447e3cf3b4de 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/33e2d875/uploads/origins/0696cf76-6c13-43bc-b680-31b502904279?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2be13148830452bbf5b3b14c1f31e248", "srcset": "https://si.imgix.net/33e2d875/uploads/origins/0696cf76-6c13-43bc-b680-31b502904279?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2be13148830452bbf5b3b14c1f31e248, https://si.imgix.net/33e2d875/uploads/origins/0696cf76-6c13-43bc-b680-31b502904279?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=b215a7cd97df2dd0ac5e0a62447416d4 2x, https://si.imgix.net/33e2d875/uploads/origins/0696cf76-6c13-43bc-b680-31b502904279?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=fe38ff6e5da49c4ad01686abb1058c51 3x"}, "body": "お世話になっております！\n今回は四六時さんにミカミカの全身立ち絵をお願いしたいです～！\n\n・キャラクター詳細\n身長163センチ、体重58kg。Gカップでグラビアアイドル並みのプロポーション。\n年齢は公表してないが20代前半から半ばぐらい。\n髪はピンクのロング。染めてるので色合いは好きに決めてもらっていいです。\n目は基本的に金色にしてますが、カラコンなのであんまり決まってません。派手な色が多い感じです。\n一応ローカルアイドルをしているのですが、最近はもっぱら配信者をやってます。\n普段はキャンプやサバゲ―をしていて、しょっちゅう外で寝泊まりしています。\n褐色でちょっとそばかすがあります。(アイドル時など、化粧してる時はない)\n基本的に明るくてサバサバした陽キャ。オタクに優しいギャルみたいな性格です。\n\n・服装\n資料のような、サイバー風のパーカー衣装をイメージしてます。\nあくまで参考なので自由にアレンジしてもらっていいです。基本的にはスポーティーな印象。\n配色はいくつかカラーパレットのパターン入れてあるのでお好みで参考にしてください。(しなくてもいいです)\n\n・他要望\nポーズとか雰囲気は自由にしてもらって大丈夫です！\nオプション付けれたら銃(サバゲ―用)があると嬉しい気持ちです！\n\n特に使う予定があるというわけではないのでお時間あるときに書いていただけたら嬉しいです。\nもし値段不相応だったら遠慮なく再送要求してください。\n\nhttps://drive.google.com/drive/folders/1uUgLCAIZTTcsp9WLz1kJhcJEKH1s-U0C?usp=sharing", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@1d46_/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2596387, "vtt_url"