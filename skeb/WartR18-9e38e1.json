soul_jp/status/1494144572934524929\nhttps://x.com/MahjongSoul_JP/status/1496409505210327043\n・パジャマ夜話：\nhttps://x.com/MahjongSoul_JP/status/1682586262941876226\nhttps://x.com/MahjongSoul_JP/status/1846008090669318274\n\n何卒よろしくお願いいたします。", "nc": 32, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 1705, "creator": true, "nsfw_acceptable": true, "acceptable": false, "name": "ヌマハナ⋈Skeb受付中！☆", "screen_name": "numahana", "avatar_url": "https://pbs.twimg.com/profile_images/535659772024864769/jx7eNUqx.png", "header_url": "https://pbs.twimg.com/profile_banners/76622473/1639107902/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 120, "skills": [{"genre": "art"}, {"genre": "comic"}], "banned": false, "nc": 33}, {"id": 40841, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "廣田眞胤 Skeb募集中", "screen_name": "hirotamasatane", "avatar_url": "https://pbs.twimg.com/profile_images/1196010745487486976/1AZ8OJFN.png", "header_url": "https://pbs.twimg.com/profile_banners/226133711/1399071157/1500x500", "appeal_receivable": true, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "art"}], "banned": false, "nc": 185}, {"id": 65622, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "🕷Syumo_Syumo🕷", "screen_name": "Rin69minamimuki", "avatar_url": "https://pbs.twimg.com/profile_images/1939359824262975488/cv0lCFAO.jpg", "header_url": "https://pbs.twimg.com/profile_banners/703182242424557569/1751214389/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "dele