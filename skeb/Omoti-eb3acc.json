考にでOKです\n\n小夜丸がシトリスに誘惑されるがまま挿入して中出ししてしまい肉棒を引き抜いたところ\n\n小夜丸は設定上の存在、またはシトリスの足を手でおさえるくらいでOKです。\n\n\n【内容】\nこのアングルでの中出し事後をお願いしたいです。\n\nhttps://www.pixiv.net/artworks/146091389\n\n中出し後、ちんちんを引き抜いたところでワレメからちんちんに糸が引いている様子をお願いします。\nシトリスの右手はおっぱいの上に添えてパイズリで搾っておっぱいについていた精液を舐めている形でお願いします。\n\nシトリスの表情はこちらの様に妖しく笑った表情でお願いします。\n\nhttps://x.com/3tarasi_dang0/status/2087386555661079004", "nc": 32, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Omoti/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3637101, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/87fe74d3/uploads/origins/3f8a6e1c-390c-4b52-a65f-8314f118d298?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fe999fd21afc7db209db9b4c254501b8", "srcset": "https://si.imgix.net/87fe74d3/uploads/origins/3f8a6e1c-390c-4b52-a65f-8314f118d298?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fe999fd21afc7db209db9b4c254501b8, https://si.imgix.net/87fe74d3/uploads/origins/3f8a6e1c-390c-4b52-a65f-8314f118d298?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=112ef43305e1e23550df346c29378d44 2x, https://si.imgix.net/87fe74d3/uploads/origins/3f8a6e1c-390c-4b52-a65f-8314f118d298?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=9bea07a88094de458bf3d2b13a1b16e4 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/87fe74d3/uploads/origins/3f8a6e1c-390c-4b52-a65f-8314f118d298?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=290985ab76a0e392954ae976c1c6f41d", "srcset": "https://si.imgix.net/87fe74d3/uploads/origins/3f8a6e1c-390c-4b52-a65f-8314f118d298?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=290985ab76a0e392954ae976c1c6f41d, https://si.imgix.net/87fe74d3/uploads/origins/3f8a6e1c-3