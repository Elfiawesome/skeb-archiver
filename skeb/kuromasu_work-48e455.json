ins/49159b89-04a5-4db0-9148-f54e8ce62148?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3e493a639605b059b80c6f3823c27d80", "srcset": "https://si.imgix.net/b34535cb/uploads/origins/49159b89-04a5-4db0-9148-f54e8ce62148?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3e493a639605b059b80c6f3823c27d80, https://si.imgix.net/b34535cb/uploads/origins/49159b89-04a5-4db0-9148-f54e8ce62148?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=796ab7f3ec7500b204350f0390c25a8f 2x, https://si.imgix.net/b34535cb/uploads/origins/49159b89-04a5-4db0-9148-f54e8ce62148?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=1fe34c4902f448226afbfc491a96d52f 3x"}, "body": "はじめまして！\nよろしければ私がゲームで使用しているキャラクターのイラストを描いていただけないでしょうか。\n以前、クロマス様が公開されていた（https://www.pixiv.net/artworks/87627653）のイラストが凄く好みで\n可能であれば、このようなカッコいいイメージにしていただけると嬉しいです。\nご検討よろしくお願いします。\n\n【資料①】https://imgur.com/a/y6d1Q0p\n【資料②】https://imgur.com/a/uk8CRUI\n\nhttps://imgur.com/a/y6d1Q0p", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@kuromasu_work/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2074698, "client_id": 58082, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/6395abd4/uploads/origins/c227de5a-b1c7-44e9-9fa9-09ada2933104?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=309e8a65401325eedc3689e199042e27", "srcset": "https://si.imgix.net/6395abd4/uploads/origins/c227de5a-b1c7-44e9-9fa9-09ada2933104?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=309e8a65401325eedc3689e199042e27, https://si.imgix.net/6395abd4/uploads/origins/c227de5a-b1c7-44e9-9fa9-09ada2933104?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f72ee1e461d69d1dd8c4650a1f9b1ce1 2x, https://si.imgix.net/6395abd4/uploads/origins/c227de5a-b1c7-44e9-9fa9-09ada2933104?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=bc1673be12edfdd4ccf7a4321205b884 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/6395abd4/uploads/origins/c227de5a-b1c7-44e9-9fa9-09ada2933104?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=52abb6961c41118caa30975ea865a717", "srcset": "https://si.imgix.net/6395abd4/uploads/origins/c227de5a-b1c7-44e9-9fa9-09ada2933104?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=52abb6961c41118caa30975ea865a717, https://si.imgix.net/6395abd4/uploads/origins/c227de5a-b1c7-44e9-9fa9-09ada2933104?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=cb2001bbed0740351cbb0b190a95380c 2x, https://si.imgix.net/6395abd4/uploads/origins/c227de5a-b1c7-44e9-9fa9-09ada2933104?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=785f94f8757858a8955cad7c8c4e6e9d 3x"}, "body": "はじめまして。Xであげていらした、クラス1胸が大きい子のイラストが素晴らしかったので依頼させて頂きました。よろしければご検討ください。\n\nあのイラストの続きのイメージで、プールサイドを歩いていた巨乳の子が転び、他の子の顔を大きな胸の下敷きにしてしまう…という感じでお願いします。\n\n下敷きにされる女の子はXのイラストで横にいた胸を分けて欲しいと言っていた子で、「～～～！？」のような呻き声と、(苦し…！でも柔らかくて気持ちいい…！)のような台詞(？)があると嬉しいです。\n\n作業量的に厳しいようでしたら台詞云々の部分は無しで大丈夫です。極端な話、上記の内容に沿っていなくとも巨乳の子が魅力的に描かれていればクロマス様の描きやすい、描きたいように描いて頂けるだけで幸いです。\n\n何卒ご検討よろしくお願いします！", "nc": 153, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@kuromasu_work/works/4", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/c9e2a8da/uploads/origins/40105799-03a2-47cf-923f-f191b6f7ee76?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=c81e786e62a02fc4cef83c2fbbcc72a1", "srcset": "https://si.imgix.net/c9e2a8da/uploads/origins/40105799-03a2-47