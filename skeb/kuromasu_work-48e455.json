0c156a9a-f603-4ce2-bfa5-fb976b5fb694?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e327f18d3707ef869a9526bcc0dc50fd 2x, https://si.imgix.net/b5f68571/uploads/origins/0c156a9a-f603-4ce2-bfa5-fb976b5fb694?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c6f64bfbaa19419a58461f275e127057 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/b5f68571/uploads/origins/0c156a9a-f603-4ce2-bfa5-fb976b5fb694?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=eee74e9b1a502cb26ccc4170c3e981ab", "srcset": "https://si.imgix.net/b5f68571/uploads/origins/0c156a9a-f603-4ce2-bfa5-fb976b5fb694?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=eee74e9b1a502cb26ccc4170c3e981ab, https://si.imgix.net/b5f68571/uploads/origins/0c156a9a-f603-4ce2-bfa5-fb976b5fb694?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=a5a3eb065a167f25c313208da961ae97 2x, https://si.imgix.net/b5f68571/uploads/origins/0c156a9a-f603-4ce2-bfa5-fb976b5fb694?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=37758d9c0eb88f783a256ba1b800a2a4 3x"}, "body": "クロマスさん\nはじめまして\n私のオリジナルキャラクターのイラストをお願いしたいです。\n以下、キャラクターの資料のURLです。\nhttps://drive.google.com/drive/folders/1wvh_L87VXXvocpASkXMUspuU-IAUP-XR\n\n髪は金髪、眼は緑色です\n衣装はシルクハット、燕尾服、マント、レオタード、サイハイブーツとなっています\n\n怪盗の女の子のキャラクターです。\n性格はナルシストで自信満々ですが、ポンコツなアホの子です。\nカッコ付けながら悪い事をしますが、よくドジを踏んで失敗してしまいます。\n\n構図等はお任せします。\n長くなりましたが、ご検討よろしくお願いします。", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@kuromasu_work/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2074698, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/5c04a012/uploads/origins/672754f9-b409-4507-bd51-955c2b3dfbf4?bg=%23fff&auto=forma