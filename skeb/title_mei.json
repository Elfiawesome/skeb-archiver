Es49p0S56NaBcWktYYdm91wotd", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@title_mei/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3787647, "client_id": 1752760, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/d6af532f/uploads/origins/cc22e424-3e54-4e00-93cf-f0090ea6d0d5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3b92768a5291176b2b12f4ccc87aa002", "srcset": "https://si.imgix.net/d6af532f/uploads/origins/cc22e424-3e54-4e00-93cf-f0090ea6d0d5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3b92768a5291176b2b12f4ccc87aa002, https://si.imgix.net/d6af532f/uploads/origins/cc22e424-3e54-4e00-93cf-f0090ea6d0d5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=9c180ed8d3bb36dd1ce532602bcea776 2x, https://si.imgix.net/d6af532f/uploads/origins/cc22e424-3e54-4e00-93cf-f0090ea6d0d5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=83efdeba8512ffe83d0567d501919e57 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/d6af532f/uploads/origins/cc22e424-3e54-4e00-93cf-f0090ea6d0d5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=303f5922f88eada1deb85b13cb9a3f7a", "srcset": "https://si.imgix.net/d6af532f/uploads/origins/cc22e424-3e54-4e00-93cf-f0090ea6d0d5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=303f5922f88eada1deb85b13cb9a3f7a, https://si.imgix.net/d6af532f/uploads/origins/cc22e424-3e54-4e00-93cf-f0090ea6d0d5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=a1ad298bbaff7b865a0ad61593dee450 2x, https://si.imgix.net/d6af532f/uploads/origins/cc22e424-3e54-4e00-93cf-f0090ea6d0d5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=cf101bc0f43a665db4b105f3164e23a6 3x"}, "body": "題め〜さん、はじめまして。Vtuberの月夜猟介と申します。\n題め〜さんの描かれるキャラクターたちのイラストがとても好きです！特に表情が可愛くて素敵です！ぜひ自身のイラストを描いていただく、リクエストをさせていただきます！\n\n【ご依頼したい内容】\nキャラクター：月夜猟介(参考画像URLを添付いたします)\n衣装・髪型等：資料内の『デフォルトの白いアイドル風の衣装』と『通常髪型』の組み合わせ\n\nポーズ・構図・シチュエーション等：\n『得意げに調子にのってるような生意気そうなドヤ笑顔』の猟介を描いていただきたいです！ポーズ、シチュエーション等はおまかせいたします。\nもし予算内で可能でしたら『ちょっと不満そうにむぅっとスネ気味な照れ顔』の表情差分も描いていただけたら嬉しいです\nサムネイル等に使用したいため、少なくともキャラクターの上や左右(髪や腕など)は途切れていないと助かります。また、キャラクターには腋毛描写がありますが(もし見える構図で) 可能であればで構いませんので描画いただけたらと思います(体毛の色は黒です)。\n\n〇形式など：psd形式でいただけると嬉しいです。キャラクターと、そのほかの背景やサインなどは可能な範囲で別レイヤーに分けていただけると大変助かります。\n\n〇使用用途：Youtube等の配信やそのサムネイルでの使用、SNSでの使用などを考えております。そのほか、もし可能であれば個人観賞用に印刷をする許可もいただければ嬉しいです(頒布・販売等は致しません)。\n\n〇参考画像： Ｘアカウントとgoogle driveを記載いたします。\n①https://x.com/RyosukeTsukiyo\n②https://drive.google.com/drive/folders/19_zo9HFwtI_E9Ew6ID3ziu95biPTWZ9d?usp=sharing\n\nもしもご縁がありましたら、どうぞよろしくお願いします！", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 51040, "creator": true, "nsfw_acceptable": false, "acceptable": false, "name": "プリンプリン🍮新規ご依頼6月着手～", "screen_name": "prn0112", "avatar_url": "https://pbs.twimg.com/profile_images/2010818289254248448/ea2SfMrX.png", "header_url": "https://pbs.twimg.com/profile_banners/270714167/1755521995/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 10, "complete_expiration_days": 90, "skills": [{"genre": "art"}, {"genre": "comic"}], "nc": 177}, {"id": 61023, "creator": true, "nsfw_acceptable": false, "acceptable": false, "name": "ポテトルス", "screen_name": "kankan33333", "avatar_url": "https://pbs.twimg.com/profile_images/1834600459488854016/Bq-i3pef.jpg", "header_url": "https://pbs.twimg.com/profile_banners/3220449085/1685383374/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_ra