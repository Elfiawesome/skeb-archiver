ように作っていただけると助かります。\nまた、キャラのみの透過でも利用できるよう、キャラクターのレイヤーだけが分かれているとありがたいです。", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@butachan_emuson/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 369843, "client_id": 801108, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/59dbd1f7/uploads/origins/3a0e4716-1281-4286-8d96-2d0b0e289759?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=808cd64b3dd5b6d9fff39515f51c598e", "srcset": "https://si.imgix.net/59dbd1f7/uploads/origins/3a0e4716-1281-4286-8d96-2d0b0e289759?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=808cd64b3dd5b6d9fff39515f51c598e, https://si.imgix.net/59dbd1f7/uploads/origins/3a0e4716-1281-4286-8d96-2d0b0e289759?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=6b63903d21b4b56cdf4612e0f89d1e6a 2x, https://si.imgix.net/59dbd1f7/uploads/origins/3a0e4716-1281-4286-8d96-2d0b0e289759?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=26c6ad9179914369cc4659dced7bf490 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/59dbd1f7/uploads/origins/3a0e4716-1281-4286-8d96-2d0b0e289759?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5e605c36341d0332726ae6a63f9f7fd4", "srcset": "https://si.imgix.net/59dbd1f7/uploads/origins/3a0e4716-1281-4286-8d96-2d0b0e289759?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5e605c36341d0332726ae6a63f9f7fd4, https://si.imgix.net/59dbd1f7/uploads/origins/3a0e4716-1281-4286-8d96-2d0b0e289759?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=ae6a066c1f91d15c51ff9a29c62e0327 2x, https://si.imgix.net/59dbd1f7/uploads/origins/3a0e4716-1281-4286-8d96-2d0b0e289759?bg=%23fff&auto=format%2Ccompr