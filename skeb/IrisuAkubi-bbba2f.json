wr_k36Zmo5g?si=ZXEWWZeAe6DEqW7M\n\n\n・キャラクターの詳細（性別 / 髪型 / 服装 / 性格など）\n海田まや　女性　22歳。\nイメージカラー：ボルドーっぽい赤と紺色。\n全体の雰囲気：配信をみんなの保健室のような癒しの場にしたい。ポジティブな地雷系。\n小説家を目指している。\nうさぎ系のメイクと左目の瞳孔のバッテン、白いリボンがチャームポイントです。\n口を開けて笑った時に両八重歯が見えます。\n構図や髪型はお任せいたします。\n\n・参考資料\nhttps://drive.google.com/drive/folders/1wYwZKRcoKYxU5hrHGKnjtpGnOtbqPKrX\n\n上記ドライブ内のバレンタインまやという一枚絵の衣装。\n\n\n【使用用途】 \n商用利用あり。\nYouTube歌ってみた動画サムネイル、配信画面、サムネイル、動画、X等SNSでの配信告知、グッズ制作等、その他海田まやの活動に関する用途。\n\nTikTok https://www.tiktok.com/@vtuber988?_t=ZS-8ww6kqFObod&_r=1\n\n\nよろしくお願いします。", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@IrisuAkubi/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3824329, "client_id": 624210, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/8af627f3/uploads/origins/e393267e-38d8-4e6f-b768-db2cad2d459a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=32c68dbe9d97b33a4a8f0d33f9deea17", "srcset": "https://si.imgix.net/8af627f3/uploads/origins/e393267e-38d8-4e6f-b768-db2cad2d459a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=32c68dbe9d97b33a4a8f0d33f9deea17, https://si.imgix.net/8af627f3/uploads/origins/e393267e-38d8-4e6f-b768-db2cad2d459a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b562e1b5de2cde6f0d86886025a1e583 2x, https://si.imgix.net/8af627f3/uploads/origins/e393267e-38d8-4e6f-b768-db2cad2d459a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=3215a1fbf044d9d22478ca1fc6ae9f4b 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/8af627f3/uploads/origins/e393267e-38d8-4e6f-b768-db2cad2d459a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=1697cf83977e45e35232acfcc9423304", "srcset": "https://si.imgix.net/8af627f3/uploads/origins/e393267e-38d8-4e6f-b768-db2cad2d459a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=1697cf83977e45e35232acfcc9423304, https://si.imgix.net/8af627f3/uploads/origins/e393267e-38d8-4e6f-b768-db2cad2d459a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=51bf9e8e0e0a83bedad37735041023e3 2x, https://si.imgix.net/8af627f3/uploads/origins/e393267e-38d8-4e6f-b768-db2cad2d459a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=9a34835e6f8d08c8aecc5590e4a8234f 3x"}, "body": "はじめまして。入巣あくび様の暗がりの雰囲気のイラストに惹かれ、ぜひご依頼したいと思いご連絡いたしました。\n\nマイキャラの女子２人を描いていただきたいです。見た目などはお手数ではありますが資料URL内をご覧いただきたいのですが、外見のポイントとしては、\n\n☆赤髪の方\n・真っ赤な苺ジャムのような髪の毛、少し下にかけて広がり気味のストレート\n・目の上くらいのぱっつん、耳出し\n・伏し目がちのぼんやりした（ハイライトがハッキリしてない）灰色の瞳\n・ぼんやりおっとり気味のハッピー顔\n\n☆緑髪の方\n・薄緑のウェーブヘア\n・眉上ぱっつん\n・凛とした眉、紫のつり目\n・キリッとした令嬢顔\n\n☆キャラクターの雰囲気\n仲良しな二人です💗\n赤髪の方が緑髪の子が大好きでつきまとい大人しそうに見えてグイグイ行くややヤンデレ気質。\n緑髪はつきまとわれる事にとまどいつつ拒否せず、まんざらでもない雰囲気。実はヴァンパイア・・・？！という設定がある。\n\nご依頼内容\n希望としては、先生の暗い画面にキラッと光る描写があるようなイラストが美しく、見たいので、緑髪の子が吸血鬼のように棺桶で眠りについていて、それを赤髪の子が棺桶のヘリにもたれかかるか頬杖をつくなどして寄り添って愛おしそうに見つめている・・・ような雰囲気だと嬉しいです。\n百年の眠りだとしてもずっとそこに居続ける・・・ような、ゴシックでメルヘンロマンティックな感じだと嬉しいです。\n薔薇やリボン、レースモチーフなイメージですが、構図含め、描きやすいように描いていただいて大丈夫です！💦\nまた、棺桶の構図において角度的にどちらかスポットを当てるとしたら赤髪の子の顔がメインで見えるようにしていただきたいです。\n\nできたらドレスっぽいお洋服をおまかせで描いていただきたいのですが、\n・赤髪の子は明るい色（白、水色など。。）の服、左右どちらかにリボンがついてるカチューシャを付けてほしい\n・緑髪の子は黒基調\nでキャラクターの対比が出てると嬉しいです。\n\nお読みいただき、ありがとうございました！ガチガチにこれという指定があるわけではないので、先生のイメージでおまかせでも大丈夫です。\n個人鑑賞、インターネットでの紹介を目的としております。\nご縁がありましたらお願いいたします(_ _)\n\nhttps://drive.google.com/drive/folders/19whpUouV8JBtRLta2fbioEkkY8HYmb_1", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@IrisuAkubi/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3824329, "client_id": 3898035, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/7816eee4/uploads/origins/7792257b-d03f-4f7f-8256-81b7a81bf1bb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=580eac237d57fef989fe49d4839d8c2e", "srcset": "https://si.imgix.net/7816eee4/uploads/origins/7792257b-d03f-4f7f-8256-81b7a81bf1bb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=580eac237d57fef989fe49d4839d8c2e, https://si.imgix.net/7816eee4/uploads/origins/7792257b-d03f-4f7f-8256-81b7a81bf1bb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=6705355b15d093592548856494d92a90 2x, https://si.imgix.net/7816eee4/uploads/origins/7792257b-d03f-4f7f-8256-81b7a81bf1bb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=09bd611207d03b16fad8bb46a40717f1 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/7816eee4/uploads/origins/7792257b-d03f-4f7f-8256-81b7a81bf1bb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0eb09952381a0fa914b946de32422f85", "srcset": "https://si.imgix.net/7816eee4/uploads/origins/7792257b-d03f-4f7f-8256-81b7a81bf1bb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0eb09952381a0fa914b946de32422f85, https://si.imgix.net/7816eee4/uploads/origins/7792257b-d03f-4f7f-8256-81b7a81bf1bb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=03de0e34b625e8d7a9e887ad4676c008 2x, https://si.imgix.net/7816eee4/uploads/origins/7792257b-d03f-4f7f-8256-81b7a81bf1bb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=2a6533ea2fbf5d90ef8b9f2ebcfd08d2 3x"}, "body": "はじめまして、入巣あくび様。😊\n\nいつも密かに拝見しておりました。入巣あくび様の絵には、どこか懐かしいレトロな絵本を思わせる温かみがあり、丁寧に重ねられた質感（テクスチャ） と、隅々まで行き届いた繊細な描写に、初めて見た瞬間から深く心を奪われております。✨\n\nぜひ一度、その唯一無二の温かなタッチで、私の大切なオリジナルキャラクター「曜星（ようせい）」を描いていただけないかと、恐れながらもご依頼申し上げます。🥺\n\n曜星は歌と執筆を得意とする穏やかな子で、髪型のみ以下のようにこだわりがございます（3:7分けの前髪・ハイポニーテール・サイドのキツネ耳風束・ピンクと水色のメッシュ）。詳しくは資料をご参照くださいませ。📎\n\nもしこちらのキャラクターが入巣あくび様の作風に合わないとお感じになられましたら、どうかご遠慮なくお断りいただければと思います。無理をなさらないでくださいね。(。•ω•。)ﾉ♡\n\nもしお受けいただける際には、衣装や構図はすべて入巣あくび様のご感性にて自由にお描きいただければ幸いです。先生が楽しく描いていただけることが、私にとって何よりの喜びでございます。🌸\n\n参考資料：\nhttps://drive.google.com/drive/folders/1c-llNNoYufSnaj8mncdt6RaTh1qEkgp7\n\nお忙しいところ大変恐縮ではございますが、ご検討いただけますと幸いです。😭💕\n\n何卒よろしくお願い申し上げます。🙇‍♀️✨\n\nhttps://drive.google.com/drive/folders/1c-llNNoYufSnaj8mncdt6RaTh1qEkgp7", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@IrisuAkubi/works/3", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/a08bc23d/uploads/origins/8577383b-977a-48c0-b4d8-ea5f40e1d57c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=95ada6ea4d45127e13513fd2aa5f9d3c", "srcset": "https://si.imgix.net/a08bc23d/uploads/origins/8577383b-977a-48c0-b4d8-ea5f40e1d57c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=95ada6ea4d45127e13513fd2aa5f9d3c, https://si.imgix.net/a08bc23d/uploads/origins/8577383b-977a-48c0-b4d8-ea5f40e1d57c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=a8389528e10d4730180c11493f312392 2x, https://si.imgix.net/a08bc23d/uploads/origins/8577383b-977a-48c0-b4d8-ea5f40e1d57c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=06bc7d9d0e1e4aefe7013e0dcf9302c9 3x"}, "private": true, "genre": "art", "tipped": false, "creator_id": 3824329, "client_id": 2717744, "nc": 0}, {"path": "/@IrisuAkubi/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3824329, "vtt_url": null, "thumbnail_imag