目1つ、三角巾の端が2つ、肘の方は結び目1つ、三角巾の端が1つ、という違いがあります)\n　‐右腕が画面に入るような構図でお願いします\n・ほっぺたに絆創膏１枚\n・ケガをしてても暗くならず、以下のような照れている表情\n　‐片目ウィンク、ペロっと舌を出している、いわゆるてへぺろな表情\n\n包帯に萌えるのと、それでも可愛く元気な姿に萌えるのが個人的なポイントです。\n\nhttps://www.youtube.com/watch?v=iLDkTBdxs4w", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 2349927, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "RO2N｜じゃぶマイ21 C-01", "screen_name": "roron_net_art", "avatar_url": "https://pbs.twimg.com/profile_images/2099841047514001408/HwU_y8aW.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1571851162617520128/1789465075/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 90, "skills": [{"genre": "art"}], "banned": false, "nc": 128}, {"id": 2764290, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "ぴにゃめろ", "screen_name": "pinya_mero", "avatar_url": "https://pbs.twimg.com/profile_images/2051596325280727040/WJayFiSl.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1312767170883940352/1787569590/1500x500", "appeal_receivable": true, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 120, "skills": [{"genre": "art"}], "banned": false, "nc": 49}, {"id": 2850495, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "𝔸𝕟𝕟𝕖🐖", "screen_name": "amppo04", "avatar_url": "https://pbs.twimg.com/profile_images/2091161209798270976/4vq_JPdH.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1638374201399840768/1759706439/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": nu