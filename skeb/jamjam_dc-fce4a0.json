uploads/origins/fd12e617-fda6-4370-91b4-83adc68e276a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=723d620bef496f78828261ecb356a343 2x, https://si.imgix.net/acacac90/uploads/origins/fd12e617-fda6-4370-91b4-83adc68e276a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=53388d7b6923aef6f7ccac160fafc458 3x"}, "body": "Hi!\n\nあなたのアートはとてもかわいいですね私のキャラクターを描いてくれたら嬉しいです。彼女は寝ぼけていて、何も知らない悪魔です。枕とパンケーキが大好きなんです。あなたの好きなように描いてください。\n\nhttps://imgur.com/a/ZA3Yqxu\n\nありがとうございました。", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@jamjam_dc/works/13", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1088846, "client_id": 388976, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/d1218a78/uploads/origins/4de33885-8ca1-44fe-8c86-12abcaac9515?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1d14a025add96567776f38a1ce37b12c", "srcset": "https://si.imgix.net/d1218a78/uploads/origins/4de33885-8ca1-44fe-8c86-12abcaac9515?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1d14a025add96567776f38a1ce37b12c, https://si.imgix.net/d1218a78/uploads/origins/4de33885-8ca1-44fe-8c86-12abcaac9515?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=fb07bd8117727283088fe8721655557c 2x, https://si.imgix.net/d1218a78/uploads/origins/4de33885-8ca1-44fe-8c86-12abcaac9515?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=75e2a5da161ee9974b7b2d86b44b4c89 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/d1218a78/uploads/origins/4de33885-8ca1-44fe-8c86-12abcaac9515?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0f2da15a51cb76ae0f41db8953bfb9d5", "srcset": "https://si.imgix.net/d1218a78/uploads/origins/4