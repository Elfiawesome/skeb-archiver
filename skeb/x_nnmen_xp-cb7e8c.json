いです。\n紫ツインテールのおませな女の子です。ツンデレな性格で、よくいたずらをして遊んでいます。尻尾はデフォルメされた蛇や虫をイメージしています。\n\n衣装のアレンジや省略など、構図やシチュエーションなどはお任せします。\nこの子の可愛いところをたくさん生かして描いていただけると幸いです。\n\n⚫︎使用用途\nSNSのアイコンやヘッダー\nSNSなどにOCを掲載する際の、ファンアートとしてのイメージイラスト\n\n背景透過PNG、もしくは背景とイラストが別々のPSDで納品していただけると嬉しいです。\n\nご検討よろしくお願いします！\n\nhttps://drive.google.com/file/d/13gXL1bshxlf_zwkQel1vDe9rN3Z-TekI/view", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@x_nnmen_xp/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3233636, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/cd362185/uploads/origins/8c1eff33-4586-491c-832d-d4ad8d791cb7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b4b02fa8bbd895492f0c05fdbc2364ff", "srcset": "https://si.imgix.net/cd362185/uploads/origins/8c1eff33-4586-491c-832d-d4ad8d791cb7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b4b02fa8bbd895492f0c05fdbc2364ff, https://si.imgix.net/cd362185/uploads/origins/8c1eff33-4586-491c-832d-d4ad8d791cb7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=6fac5f5728f801b58221ed6f80d31b9e 2x, https://si.imgix.net/cd362185/uploads/origins/8c1eff33-4586-491c-832d-d4ad8d791cb7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=44877fedd2fd34e8c1fd1cf5c20b2d1d 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/cd362185/uploads/origins/8c1eff33-4586-491c-832d-d4ad8d791cb7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d48b10aefa216b3a83ec15233587b307", "srcset": "https://si.imgix.net/cd362185/uploads/origins/8c1eff33-4586-491c-832d-d4ad8d791cb7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d48b10aefa216b3a83ec15233587b307, https://si.imgix.net/cd362185/uploads/origins/8c1eff33-4586-491c-83