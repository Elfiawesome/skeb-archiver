ているので、股間は丸見えである。下着が足首や脚に巻きついたままだったら、とてもセクシーです。\n\n ちょっとお茶目な感じで、ちょっと顔を赤らめていたら最高。最後の文化祭の思い出になるような作品にしたい。", "nc": 161, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@cpk_prd/works/9", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/a69ad6e5/uploads/origins/1176bf5c-3152-4e5d-a5c0-38dc3cc35350?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=06a42ffab7a0c6955e0b0875fa242c98", "srcset": "https://si.imgix.net/a69ad6e5/uploads/origins/1176bf5c-3152-4e5d-a5c0-38dc3cc35350?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=06a42ffab7a0c6955e0b0875fa242c98, https://si.imgix.net/a69ad6e5/uploads/origins/1176bf5c-3152-4e5d-a5c0-38dc3cc35350?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=ab866c4681c276db9c9151f6a1a37647 2x, https://si.imgix.net/a69ad6e5/uploads/origins/1176bf5c-3152-4e5d-a5c0-38dc3cc35350?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=38cf91c6959da38f8ab173cf03e6be9f 3x"}, "private": true, "genre": "art", "tipped": true, "creator_id": 1443944, "client_id": 1163729, "nc": 32}, {"path": "/@cpk_prd/works/8", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1443944, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/366ef8f1/uploads/origins/adcd008c-8463-4530-a005-c0c1714d21d7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=44068c4d83efa5708245ba21b01b8bd9", "srcset": "https://si.imgix.net/366ef8f1/uploads/origins/adcd008c-8463-4530-a005-c