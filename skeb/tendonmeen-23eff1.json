4e9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=97deac947b308221c75e67eb43530763 2x, https://si.imgix.net/c0657b94/uploads/origins/f8a6ced3-bc68-4c45-9029-70a54b4814e9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a1e108862dbe89e7a90eef34db5b754b 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/c0657b94/uploads/origins/f8a6ced3-bc68-4c45-9029-70a54b4814e9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3d436fa282e400d7f4cc182069310c8d", "srcset": "https://si.imgix.net/c0657b94/uploads/origins/f8a6ced3-bc68-4c45-9029-70a54b4814e9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3d436fa282e400d7f4cc182069310c8d, https://si.imgix.net/c0657b94/uploads/origins/f8a6ced3-bc68-4c45-9029-70a54b4814e9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=2c3d48c88021b7b1f8506b0a5c8ec814 2x, https://si.imgix.net/c0657b94/uploads/origins/f8a6ced3-bc68-4c45-9029-70a54b4814e9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=78161dc87d8b355b9bcb639d052ff93f 3x"}, "body": "こんにちは！以前、私のOCであるユエルの絵をお願いしたのですが、あなたの作風でとても可愛く仕上がったので、また描いていただけないかと思いました。\n\n今回は、この写真のようなウサギの服を着てほしいです。\nhttps://drive.google.com/file/d/1CxLa480emzx8Hnt_fQofq15SVbwN67CZ/view?usp=share_link\n\n(ユエルは青い服の短髪のキャラクターです。）\n\n顔を紅潮させながら、困ったような、照れたような感じにしてほしいです。ポーズは特に考えていませんので、自由に描いてください。\n\nリクエストにお答えいただきありがとうございました。", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@tendonmeen/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1877724, "client_id": 2081431, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/4d6d64b0/uploads/origins/75de022e-3e1b-4251-8412-09fcc37f43bb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=