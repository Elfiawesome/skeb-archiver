\n▽茶髪のキャラクター\n188cm/30歳\nとある中学校の家庭科の先生。基本的に赤いエプロンをしている。\n大食い。おおらかでマイペースだが、照れ屋なところがある。\n\n▽茶髪のキャラクター×金髪のキャラクターの恋人同士です。\n一見金髪が強気で振り回しているように見えますが、天然でマイペースな茶髪に金髪が翻弄されることもあり、空回りしがちです。スキンシップは茶髪→金髪の方が多めで、茶髪の方が素直に甘えたり触れたりします。\n\nお忙しいところ恐縮ですがご検討ください。\nまた、料金が不十分等がありましたら再送頂けますと幸いです。\n\nhttps://drive.google.com/drive/folders/1HvcGwZNRYa1uZIkOQPrGXk40CRPA_Mc4?usp=sharing", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}], "sent_works": [], "similar_creators": [{"id": 786180, "creator": true, "nsfw_acceptable": false, "acceptable": false, "name": "wawa", "screen_name": "wawatiku", "avatar_url": "https://pbs.twimg.com/profile_images/1930047406810509316/scWjWE-1.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1316976623724318720/1729758706/1500x500", "appeal_receivable": false, "popular_creator_rank": 19, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 10, "complete_expiration_days": 50, "skills": [{"genre": "art"}], "banned": false, "nc": 161}, {"id": 2720789, "creator": true, "nsfw_acceptable": false, "acceptable": false, "name": "くろした", "screen_name": "edam____a", "avatar_url": "https://pbs.twimg.com/profile_images/2026304928122339328/K0aVnFwS.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1580029103821856768/1781610263/1500x500", "appeal_receivable": true, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 14, "complete_expiration_days": 120, "skills": [{"genre": "art"}, {"genre": "comic"}, {"genre": "video"}], "banned": false, "nc": 128}, {"id": 3128982, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "po", "screen_name": "___p___o___", "avatar_url": "https://pbs.twimg.com/profile_images/2039614392908816385/J8UvciYa.png", "header_url": "https://pbs.twimg.com/profile_banners/3095964990/1628136272/1