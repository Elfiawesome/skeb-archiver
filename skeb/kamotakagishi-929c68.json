_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@kamotakagishi/works/11", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 891671, "client_id": 421066, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/6dc23860/uploads/origins/db44bd0d-a5cf-48d6-9c28-6e1a799fd4e5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a97c2dcad0df71023acae415f4407178", "srcset": "https://si.imgix.net/6dc23860/uploads/origins/db44bd0d-a5cf-48d6-9c28-6e1a799fd4e5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a97c2dcad0df71023acae415f4407178, https://si.imgix.net/6dc23860/uploads/origins/db44bd0d-a5cf-48d6-9c28-6e1a799fd4e5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=3991f11147e1fdd7a045b5125b94ce4e 2x, https://si.imgix.net/6dc23860/uploads/origins/db44bd0d-a5cf-48d6-9c28-6e1a799fd4e5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b040e8e708fe4906ddb69d0e8ddffff0 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/6dc23860/uploads/origins/db44bd0d-a5cf-48d6-9c28-6e1a799fd4e5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=135552abf3d2551f31bfebaae5750ae0", "srcset": "https://si.imgix.net/6dc23860/uploads/origins/db44bd0d-a5cf-48d6-9c28-6e1a799fd4e5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=135552abf3d2551f31bfebaae5750ae0, https://si.imgix.net/6dc23860/uploads/origins/db44bd0d-a5cf-48d6-9c28-6e1a799fd4e5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=5bfe9d61464cc0c063e723eebfe1f345 2x, https://si.imgix.net/6dc23860/uploads/origins/db44bd0d-a5cf-48d6-9c28-6e1a799fd4e5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=c2681760a104cc9ec66127700b9e75f