d0171f1c4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ff2593c7e8127724ce1c186ba2377caf", "srcset": "https://si.imgix.net/1b10750c/uploads/origins/c909fa36-e2f2-45aa-971a-e75d0171f1c4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ff2593c7e8127724ce1c186ba2377caf, https://si.imgix.net/1b10750c/uploads/origins/c909fa36-e2f2-45aa-971a-e75d0171f1c4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e06dff236be056723fd316efaec0c5b4 2x, https://si.imgix.net/1b10750c/uploads/origins/c909fa36-e2f2-45aa-971a-e75d0171f1c4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d029e8d5b2df7d69c62bc89172f98b70 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/1b10750c/uploads/origins/c909fa36-e2f2-45aa-971a-e75d0171f1c4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a0f5bad1816e698c8791ceca701f993e", "srcset": "https://si.imgix.net/1b10750c/uploads/origins/c909fa36-e2f2-45aa-971a-e75d0171f1c4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a0f5bad1816e698c8791ceca701f993e, https://si.imgix.net/1b10750c/uploads/origins/c909fa36-e2f2-45aa-971a-e75d0171f1c4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=8233825f2b5979c0e73d3aa2d7f9bee1 2x, https://si.imgix.net/1b10750c/uploads/origins/c909fa36-e2f2-45aa-971a-e75d0171f1c4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=849e1dcde4e03691dbfb6a6a023f7b63 3x"}, "body": "初めまして眉毛ランドの夢女です。\nエニシダ様の眉毛の壁ドンの夢絵に見惚れてしまい是非ともエニシダ様に依頼したい！！と思い連絡いたしました！\nエニシダ様の過去のイラストも遡って拝見いたしましたが絵柄から内容からどストライクすぎて動悸がするくらいです、素敵イラストを描いて見せてくださってありがとうございます。\nこれからも応援しております！\n\n【依頼内容】ですが\n【キャラクター】は【ヘタリアの北アイルランドとウェールズ】で\n【シチュエーション】は【北アイルランドとウェールズが夢主(女性)への恋と好きを拗らせすぎてヤンデレ化して夢主を手錠又はネクタイの様な物で拘束しようとしている、又は拘束して連れ去ろうとしている】ようなイラストを描いていただきたいです！\n【キャラクターの表情は怖く病みつつも優しく少し微笑している雰囲気がいいです】\nわたしの性癖大暴露で申し訳ないです…。\n\n資料URLにエニシダ様が描かれた眉毛ランドの壁ドン夢絵イラストを貼っておきますが夢主の姿はあってもなくてもどちらでも大丈夫です。\nキャラクターの台詞はできればあると萌えるので余裕がありましたらお願いします！！！\n\nそれではお身体にお気をつけてお過ごし下さい。\n乱文長文失礼いたしました。\nまた依頼させていただくこともあるかもしれませんのでその時はまたよろしくお願いいたします。\n\nhttps://mobile.twitter.com/5han4so/status/1552123875064152064", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}], "sent_works": [], "similar_creators": []}, "price_history": {"art": [{"amount": 8000, "recorded_at": "2026-03-20T08:42:35.157238+00:00"}]}}