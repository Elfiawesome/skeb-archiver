\nhttps://drive.google.com/drive/folders/1-Z6taBMPHxDKx8W-hW_dONZi4AmVlQgl  \n料金等問題がございましたら再送していただけたら幸いです。 \nご検討よろしくお願いいたします。", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Manatsu_oekaki/works/12", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2981000, "client_id": 3492229, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/2116f8c9/uploads/origins/0541d13f-ad56-4f79-a394-db9298401b82?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4aa25571e55f9890860c097fd59d006e", "srcset": "https://si.imgix.net/2116f8c9/uploads/origins/0541d13f-ad56-4f79-a394-db9298401b82?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4aa25571e55f9890860c097fd59d006e, https://si.imgix.net/2116f8c9/uploads/origins/0541d13f-ad56-4f79-a394-db9298401b82?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=dd005e4d691f5645642d509c8aa162b1 2x, https://si.imgix.net/2116f8c9/uploads/origins/0541d13f-ad56-4f79-a394-db9298401b82?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=115fb98ae12d7db407d4ca616d9ed725 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/2116f8c9/uploads/origins/0541d13f-ad56-4f79-a394-db9298401b82?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9184ce3fc3d777df21fb2bbc070af9ca", "srcset": "https://si.imgix.net/2116f8c9/uploads/origins/0541d13f-ad56-4f79-a394-db9298401b82?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9184ce3fc3d777df21fb2bbc070af9ca, https://si.imgix.net/2116f8c9/uploads/origins/0541d13f-ad56-4f79-a394-db9298401b82?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=c2ae82510d526dc85f7d55eace3272d7 2x, https://si.imgix.net/2116f8c9/uploads/origins/0541d13f-