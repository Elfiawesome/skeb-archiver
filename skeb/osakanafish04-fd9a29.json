etails to you!\nArtistic freedom!\n\nIf you do not feel comfortable drawing a character like this I understand.\nThank you for your consideration!🦭🪸🦞\nI hope you have a nice day!🐟🦈🐡🪼\n\nhttps://drive.google.com/drive/folders/17a2SuPUHM-HQXyAQ9hxPMYRc3iAIxkWU?usp=sharing", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@osakanafish04/works/64", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3710895, "client_id": 2324077, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/4b59dc38/uploads/origins/89af6a4d-9afe-479e-a099-1305a15a6fc3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=face2b4e11714bd11572d7410109ba73", "srcset": "https://si.imgix.net/4b59dc38/uploads/origins/89af6a4d-9afe-479e-a099-1305a15a6fc3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=face2b4e11714bd11572d7410109ba73, https://si.imgix.net/4b59dc38/uploads/origins/89af6a4d-9afe-479e-a099-1305a15a6fc3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=56f1a464dd751709e8dfb9b6a36c047c 2x, https://si.imgix.net/4b59dc38/uploads/origins/89af6a4d-9afe-479e-a099-1305a15a6fc3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a5b7e21fd0b4ff267e1f3485a0b5ba9a 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/4b59dc38/uploads/origins/89af6a4d-9afe-479e-a099-1305a15a6fc3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e1fbbb825d1ebbbabd987d9c02c793d4", "srcset": "https://si.imgix.net/4b59dc38/uploads/origins/89af6a4d-9afe-479e-a099-1305a15a6fc3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e1fbbb825d1ebbbabd987d9c02c793d4, https://si.imgix.net/4b59dc38/uploads/origins/89af6a4d-9afe-479e-a099-1305a15a6fc3?bg=%23fff&auto=format%2Ccompress&fm=we