長は約155cmで、胸は非常に小さいです。特徴的なデザインの眼鏡をかけている点に注意してください。初期のスケッチには記載されていないデザイン要素を説明するため、参考画像を添付しました。\n\nメツトリは元気で人懐っこい性格の可愛いジャーナリストです。取材で危険に遭遇することもあり、体には傷跡や包帯があります。胸の前でカメラを構え、目の前にアホロートルを置いた状態で、写真を撮ろうとしている瞬間を描いてください。カメラは参考画像のものに似せて、ロゴをアホロートルの画像に変更してください。 カメラには首から下げるストラップを付けてください。メツトリはアホロートルを見て興奮したような明るい笑顔で描いてください。https://drive.google.com/drive/folders/1dHagwYbg_z3QXHEDaWHE9fkyUciMB-3C?usp=sharing", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@osakanafish04/works/53", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3710895, "client_id": 1729453, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/54a5bd51/uploads/origins/747a64e0-69d2-4b05-bf5d-628e8790e171?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=434af95011a9289461ea482e79bb0b59", "srcset": "https://si.imgix.net/54a5bd51/uploads/origins/747a64e0-69d2-4b05-bf5d-628e8790e171?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=434af95011a9289461ea482e79bb0b59, https://si.imgix.net/54a5bd51/uploads/origins/747a64e0-69d2-4b05-bf5d-628e8790e171?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=eb770f78497ee1ce91f240ee1d4478f6 2x, https://si.imgix.net/54a5bd51/uploads/origins/747a64e0-69d2-4b05-bf5d-628e8790e171?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=fe3467f8957ef218eade65a7a67fd728 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/54a5bd51/uploads/origins/747a64e0-69d2-4b05-bf5d-628e8790e171?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=84cd51b530a8f26ee385bc02760e7c61", "srcset": "https://si.imgix.net/54a5bd51/uploads/origins/747a64e0-69d2-4b05-bf5d-628e8790e171?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=84cd51b530a8f26ee385bc02760e7c61, h