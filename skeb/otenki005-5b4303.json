-4669-b7c5-6076395aa34b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=8a948801b8047bf6b742839ccb5f33b6 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/62c1a13f/uploads/origins/d9e7de39-1421-4669-b7c5-6076395aa34b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=18af16907c0f8fd865946148c56e17b5", "srcset": "https://si.imgix.net/62c1a13f/uploads/origins/d9e7de39-1421-4669-b7c5-6076395aa34b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=18af16907c0f8fd865946148c56e17b5, https://si.imgix.net/62c1a13f/uploads/origins/d9e7de39-1421-4669-b7c5-6076395aa34b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=bf7204f4f58bdb7f41ebfbd331b32a64 2x, https://si.imgix.net/62c1a13f/uploads/origins/d9e7de39-1421-4669-b7c5-6076395aa34b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=514c8cb91ecd68d6174a077c946be30f 3x"}, "body": "こんにちは！私はあなたの漫画作品がとても好きです。\n\n180cmのレイリと162cmのコーナを一緒にお願いしたいです。\n\nレイリはいじわるで、時々自信家で、嫌味なところがあります。耳はあまり動かず、尻尾は普段はブラブラしていて動きません。\nhttps://drive.google.com/drive/u/0/folders/1n4o3utH6VHXsV3yS1HFQnw20b-HN4hWm https://toyhou.se/18120617.leyri-amaranth/gallery\n\nコアナ：\nhttps://drive.google.com/drive/u/0/folders/12qbuviAP-PjCzBCPD2cUjTA4Y8ys8kz9\n\nシナリオとしては、2人がディープで情熱的なキスをして、レイリーが小穴にフェラチオをして、2人がセックスをして、小穴が上で恥ずかしそうにしながらも嬉しそうにしていて、レイリーが下で、2人とも情熱的に楽しんでいて、小穴が中出しして、2人が一緒に昼寝をして終わるというのが一般的だと思います。もしやりすぎなら、フェラチオの部分を省いてもいいし、そうでなければ好きなだけ描いてください。\n\n服から始める場合は、レイリはドーントレイルの服を使い、コアナのコートを脱がせて始めてください。\n\nシーンの流れは基本的に自由ですが、できれば小穴がトップで、キスありでお願いします。場所や体位などは自由です。また、可能であれば、小穴の尻尾を少し楽しそうに振るシーンもお願いします。\n\nありがとうございました！", "nc": 33, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@otenki005/works/10", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/38029c8f/uploads/origins/6014ac67-cdaa-4905-b48c