sfw": true}, "visa": {"nsfw": true}, "discover": {"nsfw": true}, "american_express": {"nsfw": true}}}, "acceptable_only_public": false, "tip_acceptable": true, "yearly_report_client_visible": false, "total_appeals_count": 0, "received_works": [{"path": "/@hachibachi_88/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3122186, "client_id": 3865832, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/a40fa899/uploads/origins/cf391614-f490-45d7-ad1c-0ea70194f7cf?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5d0606ceacedc7690d26ecb4924a0ead", "srcset": "https://si.imgix.net/a40fa899/uploads/origins/cf391614-f490-45d7-ad1c-0ea70194f7cf?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5d0606ceacedc7690d26ecb4924a0ead, https://si.imgix.net/a40fa899/uploads/origins/cf391614-f490-45d7-ad1c-0ea70194f7cf?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=d5936655034a5af183597ffcfbce476b 2x, https://si.imgix.net/a40fa899/uploads/origins/cf391614-f490-45d7-ad1c-0ea70194f7cf?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=98e96f93828cb62796c1408f4adba236 3x"}, "duration": null, "nsfw": true, "hardcore": true, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/a40fa899/uploads/origins/cf391614-f490-45d7-ad1c-0ea70194f7cf?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=4b4385f20e93617fb7d8e95e5f885a9f", "srcset": "https://si.imgix.net/a40fa899/uploads/origins/cf391614-f490-45d7-ad1c-0ea70194f7cf?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=4b4385f20e93617fb7d8e95e5f885a9f, https://si.imgix.net/a40fa899/uploads/origins/cf391614-f490-45d7-ad1c-0ea70194f7cf?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=03357c4ab6d42ab0478ac10b992dcb1d 2x, https://si.imgix.net/a40fa899/uploads/origins/cf391614-f490-45d7-ad1c-0ea70194f7cf?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=0542a5a669f9be47d6bb5b756e2365a5 3x"}, "body": "こんにちは。私の依頼をご検討いただき、本当にありがとうございます。漫画のオプションを開放されていないことは承知していますが、もし可能でしたら漫画のような形で描いていただけないでしょうか。私は個人的に足フェチで、女強人の排泄題材が好きです。以下は私が構想しているストーリーです。（インスピレーションは Yokohama Junky（Makari Tohru）の https://nhentai.net/g/315864/ です。お時間があれば参考としてご覧いただいても構いませんし、キャラクターのセリフなども参考にしていただいて大丈夫です。）  \n主人公は、長髪で腹筋がはっきりとした、鍛え上げられた体を持つ、クールで威厳のある美しく強靭な女性です。彼女の設定や立場は自由です（例えば女性刑事、エージェント、戦士など、その他どのような設定でも構いません。すべて作者であるあなたにお任せします）。もし可能であれば、バイオハザードのエイダ・ウォンのような、特別な立場を持ち、肉体的にも強くセクシーな女強人を参考、あるいはイメージとして使用していただけると嬉しいです。  \nとにかく彼女は、何らかの理由（薬を盛られる、敗北するなど）で意識を失い、その後全裸にされ、拘束されます。（私自身が足フェチなので、腹筋が露わになり、裸足が見える全裸の構図だと嬉しいです。）敵役（立場や正体は問いません）は、ある情報を聞き出すために彼女を拷問します。彼女は非常に意志が強いため、必死に拷問に耐え続けます。  \n敵は彼女が昏睡している間に、彼女の身体を制御できる装置を取り付けます。その装置は感覚を増幅させ、痛みや快感を与えたり、排泄をコントロールしたりできるものです。敵はまず彼女に排尿させ、苦しんでいるところに快感を加え、排尿と同時に絶頂させます。そして彼女がまだ回復しきらないうちに、今度は排便欲求を引き起こします（基本的には『Solo Hunter no Seitai WORLD 4』のような展開です）。  \nしかし、肉体的にも精神的にも強靭な彼女は奇跡的に装置の制御に抵抗し、すぐには排泄してしまいません。それでも非常に無理をして耐えている状態で、少しでも気を抜けば制御できなくなりそうです。そこで敵は徐々に装置の出力を上げ、彼女が限界に近づいたところで最後のチャンスとして情報を吐くよう迫ります。しかし彼女は最後まで口を割りません。  \nついに敵は装置の力をさらに強め、彼女は完全に制御を失い、足元に置かれた容器の中に排泄してしまいます。長時間我慢していたため、排泄量は非常に多くなります（ここではぜひ排泄の描写やカットを多めにしてください。便秘のような硬い感じではなく、普通の状態で、何日も我慢していた結果としての大量の量でお願いします。裸足の描写もあると嬉しいです）。同時に敵は装置によって快感も最大限に高めます。  \n彼女は強烈な羞恥を感じながらも、長く我慢していた末に失禁してしまった解放感に次第に溺れていきます。そして最終的に絶頂に達し、そのまま気を失います。ここでは、彼女が放出した量が分かるように、排泄物にカメラを寄せたカットがあると嬉しいです。敵（男女は作者の自由です）の心理描写としては、「taは彼女が簡単に屈しないことを望んでいる。なぜなら、ta 自身も捕らえたこの新しい玩具を弄ぶことを楽しんでいるからだ」といったものを想定しています。\n\n私はあなたの画風がとても好きです。もしより高い金額での受注をご希望であれば、無理のない範囲で多少予算を上げることも可能です。それでも難しい場合は、可能な範囲で内容を取捨選択・簡略化して仕上げていただいても構いませんし、あるいは直接お断りいただいてもまったく問題ありません。", "nc": 59, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@hachibachi_88/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3122186, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/38b2bec1/uploads/origins/f1458212-7035-446c-9edf-df2bf40fda9d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=999b2aba7fa1c400e979a22074331583", "srcset": "https://si.imgix.net/38b2bec1/uploads/origins/f1458212-7035-446c-9edf-df2bf40fda9d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=999b2aba7fa1c400e979a22074331583, https://si.imgix.net/38b2bec1/uploads/origins/f1458212-7035-446c-9edf-df2bf40fda9d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=839443627bbc61a301d71623e4d745f8 2x, https://si.imgix.net/38b2bec1/uploads/origins/f1458212-7035-446c-9edf-df2bf40fda9d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=cbb0a2146374fa2dda32c9ab9502b833 3x"}, "duration": null, "nsfw": true, "hardcore": true, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/38b2bec1/uploads/origins/f1458212-7035-446c-9edf-df2bf40fda9d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=08acfb0259f8104f5b857092a1b701d8", "srcset": "https://si.imgix.net/38b2bec1/uploads/origins/f1458212-7035-446c-9edf-df2bf40fda9d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=08acfb0259f8104f5b857092a1b701d8, https://si.imgix.net/38b2bec1/uploads/origins/f1458212-7035-446c-9edf-df2bf40fda9d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=b255e2a5f47fd7d9fa5b1bbbb6b7045b 2x, https://si.imgix.net/38b2bec1/uploads/origins/f1458212-7035-446c-9edf-df2bf40fda9d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=0a873dd9f99fa22ab00c4c34605163d2 3x"}, "body": "初めまして\nレベルの高い合格点を越えるスカトロイラストをオールウェイズ出してくださりありがとうございます😭特に下記作品に衝撃を受けてリクエストしたいと思いました。アナルやうんこの質感も大変素晴らしいクオリティで激シコでした。\nこちらの作品と同じような内容でリクエストいたします。\nhttps://www.pixiv.net/artworks/129272609\n\n先生の存じ上げない作品だと思いますがもしよろしければ承認をお願いします。キャンセルしていただいても構いません\n\n 【作品】  \nSOUND VOLTEX\n\n【キャラクター】\n下記の女性キャラクターの中から4〜7人お任せ\nhttps://p.eagate.573.jp/game/sdvx/vi/chara/index.html\n\n下記は私の知りうる限りのハッキリとした公式資料があるキャラクターたちです。\n下記以外のキャラクターでも大丈夫です。非常にマイナーゲームなので他キャラクターはpixivなどのサイトでファンイラストを見ることをおすすめします。\n\nレイシス&グレイス\nhttps://x.com/soundvoltex573/status/1322009092680896512?s=46&t=3FccnHHq6yhTT2F7k907cQ\n\nニア&ノア\nhttps://youtu.be/lU6fceXWaF4?si=5Qwn_NCT84aIloZc\n\n氷雪ちゃん\nhttps://x.com/soundvoltex573/status/1470673443897352197?s=46&t=3FccnHHq6yhTT2F7k907cQ\n\n紅刃\nhttps://x.com/soundvoltex573/status/1605559482180046850?s=46&t=3FccnHHq6yhTT2F7k907cQ\n\n恋刃\nhttps://x.com/soundvoltex573/status/1270185860462329857?s=46&t=3FccnHHq6yhTT2F7k907cQ\n\n虹霓・シエル・奈奈\nhttps://x.com/soundvoltex573/status/1187203071966736384?s=46&t=3FccnHHq6yhTT2F7k907cQ\n\nオルトリンデ＝NBLG＝ヴァルキュリア\nhttps://x.com/soundvoltex573/status/1560088621691965441?s=46&t=3FccnHHq6yhTT2F7k907cQ\n\nカヲル&アシタ\nhttps://x.com/soundvoltex573/status/1450657909046595587?s=46&t=3FccnHHq6yhTT2F7k907cQ\n\n 【内容】  \n上で提示した先生のゴッド作品の下のコマの構図でSOUND VOLTEXの女の子たちが大きいお皿に脱糞するイラスト\n\n【差分】 \n脱糞前〜脱糞終わりまで先生の作品と同じで最後に横からのアングルでうんこが盛られたお皿のみを写している\n\n\n 【細かな要望】  \n・構図やアングルについて\n参考作品同様おけつ付近描画で各吹き出しにキャラクターたちの顔\nもしよろしければ長い髪のキャラクターは少しだけお尻付近に髪をもっていただけないでしょうか。\n\n\n・アナルについて\n各キャラクターのアナルの具合も先生にお任せします。\n\n\n・うんこについて\n各キャラクターのうんこの質感も先生にお任せします。横から見たうんこが盛られたお皿ですがうんこがお皿からはみ出たりうんこ汁が糸を引いて地面と繋がっている感じでお願いします。\n量は参考作品同様多めでお願いします。\n\n\n・セリフについて \nなしでいいです。\n\n\n・効果音などについて \n効果音はうんこの色モヤもお願いします \nうんこには「臭…♡」「むわぁ♡」的な効果音もお願いします\n\n\n以上になります\n検討のほどよろしくお願いします", "nc": 170, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@hachibachi_88/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "comic", "tipped": true, "creator_id": 3122186, "client_id": 767016, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/0f747831/uploads/origins/367dfc7e-04e2-41b9-82b0-9f85d1f01d0b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8e7da3a0aeb7b2a364a672a88a3d9db0", "srcset": "https://si.imgix.net/0f747831/uploads/origins/367dfc7e-04e2-41b9-82b0-9f85d1f01d0b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8e7da3a0aeb7b2a364a672a88a3d9db0, https://si.imgix.net/0f747831/uploads/origins/367dfc7e-04e2-41b9-82b0-9f85d1f01d0b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c37fce47351dc90a63fe8fba5b087355 2x, https://si.imgix.net/0f747831/uploads/origins/367dfc7e-04e2-41b9-82b0-9f85d1f01d0b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=9c4d2579f1f31c1d7ce32436ee62ad9f 3x"}, "duration": null, "nsfw": true, "hardcore": true, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/0f747831/uploads/origins/367dfc7e-04e2-41b9-82b0-9f85d1f01d0b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ea3089c187fdbc4cfa415d7451f13ece", "srcset": "https://si.imgix.net/0f747831/uploads/origins/367dfc7e-04e2-41b9-82b0-9f85d1f01d0b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ea3089c187fdbc4cfa415d7451f13ece, https://si.imgix.net/0f747831/uploads/origins/367dfc7e-04e2-41b9-82b0-9f85d1f01d0b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=92ad17547f145cb87cd207ff71ca3344 2x, https://si.imgix.net/0f747831/uploads/origins/367dfc7e-04e2-41b9-82b0-9f85d1f01d0b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=9839ee0b774326b2b34089804e145ff3 3x"}, "body": "この絵の女の子3人（赤でマークしました）と犠牲者1人（青でマークしました、https://drive.google.com/file/d/1KJQSQThw1_aF42OqawOXz7ScGyYGvyu6/view?usp=drive_link）。凪海(ナギ)さんに似たような依頼をしたので、あなたと共有します、https://drive.google.com/drive/u/1/folders/1fqWhyNM3s1StPS1UASY8n7Ed0XcOF16h 、この絵に似ていますが、違いは私が言ったストーリーともちろんキャラクターです。そして、私があなたに送る依頼と違うのは、3人のふたなり女の子が青いマークの女の子の喉に直接排便するので、口がふたなり女の子の肛門につながっていることです。\n\nストーリーは基本的に、私が送ったコミッションのダブル挿入のように、②が④をファックしている間に、①が④の口の中に射精します。射精した後、彼女はトイレに行きたくなったので、直接④の喉の中におしっこをします。それを見て、②は④に尻を舐めて欲しいと頼みますが、彼女が尻を舐めている間に、②は口の中で放屁し（私が共有したコミッションのように）、直接④の喉に排便を始めます。それを見て、①と③も同じことをしたくなり、放屁を始め、直接④の喉に排便します。つまり、3人のふたなり少女全員が、青いマークの女の子の喉に直接排便することになります。表情は、ふたなりキャラには得意げな表情、青いマークの女の子には驚きと嫌悪感の表情をつけてください。", "nc": 187, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@hachibachi_88/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3122186, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/8846d6fe/uploads/origins/a510ca23-0460-4c08-932e-0e5cff3b1905?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=12453a7ba0b14f8b61662f78aa1ee9c3", "srcset": "https://si.imgix.net/8846d6fe/uploads/origins/a510ca23-0460-4c08-932e-0e5cff3b1905?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=12453a7ba0b14f8b61662f78aa1ee9c3, https://si.imgix.net/8846d6fe/uploads/origins/a510ca23-0460-4c08-932e-0e5cff3b1905?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=d00e45634f64db700940824187f5f51a 2x, https://si.imgix.net/8846d6fe/uploads/origins/a510ca23-0460-4c08-932e-0e5cff3b1905?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=4ae66d3fcce0df799948298db3c8b39e 3x"}, "duration": null, "nsfw": true, "hardcore": true, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/8846d6fe/uploads/origins/a510ca23-0460-4c08-932e-0e5cff3b1905?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=11e681dc000dc56e6bed724f5220247f", "srcset": "https://si.imgix.net/8846d6fe/uploads/origins/a510ca23-0460-4c08-932e-0e5cff3b1905?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=11e681dc000dc56e6bed724f5220247f, https://si.imgix.net/8846d6fe/uploads/origins/a510ca23-0460-4c08-932e-0e5cff3b1905?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=cb45032f84019e79072c169dc