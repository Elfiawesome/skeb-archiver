われてしまう、絵を描くことが好きなきつねの女の子です！\n\nリクエストについてですが、私のイラストを描いて貰いたいです！\n構図は芙伎さんにおまかせします！\n\n【モデルのこだわり】\n・風鈴ピアス\n・ハート型の目のハイライト\n・インナーカラー＆メッシュカラー\n・ネイルと指輪\n・口ピアス\nできるだけ忘れずに描いて欲しいです\n\n【使用範囲】\n・YouTube配信、および動画のサムネイル等での使用\n・Xでの画像添付\n・SNSのアイコン\n・ネットプリント\n\nサムネイルへの使用を考えているので腕や耳、髪、ピアスが見切れないようにお願いします。\n\nhttps://drive.google.com/drive/folders/1w8zn7AE6ocR-XNWRBuc5yYXXOB0Dgijx?usp=sharing", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@83_k1_/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2654527, "client_id": 2638879, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/66747736/uploads/origins/aafceb9e-6d57-4e6e-bfb7-11f274dc4cff?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6f132897e84da374ac9423c6ee5a432d", "srcset": "https://si.imgix.net/66747736/uploads/origins/aafceb9e-6d57-4e6e-bfb7-11f274dc4cff?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6f132897e84da374ac9423c6ee5a432d, https://si.imgix.net/66747736/uploads/origins/aafceb9e-6d57-4e6e-bfb7-11f274dc4cff?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=cb83d1c0297fc553149fc66db143f13c 2x, https://si.imgix.net/66747736/uploads/origins/aafceb9e-6d57-4e6e-bfb7-11f274dc4cff?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=54438c7142d5cfb916c7ccf42b4551c9 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/66747736/uploads/origins/aafceb9e-6d57-4e6e-bfb7-11f274dc4cff?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=49e74886b314a1b8d4bf65326c3d1592", "srcset": "https://si.imgix.net/66747736/uploads/origins/aafceb9e-6d57-4e6e-bfb7-11f274dc4cff?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=49e74886b314a1b8d4bf65326c3d1592, https://si.imgix.net/66