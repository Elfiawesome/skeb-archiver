mat%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=bdfe962e3e57a6b818bf02d32470745e 2x, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1529482323187470337%2FDw3BLmwB.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b4921c32a937a1a9581bdcc828324d21 3x"}, "preview_url": "https://fcdn.skeb.jp/uploads/outputs/1849c38a-6fc6-496b-b14d-e45fc920a75e?response-content-disposition=inline&Expires=1795679011&Signature=lnhvJPa0fzQ12gGM3vLnCNdtyWsGZtX6aQodW-q1QnRk3NWDNxmwCH-7XudSEpXN6umAhunGpaW7yV5lW6DQOHIqml5gqGyh-ALs8hb~ixFtUUwNf6OE17o3PTh9L3cLyKTX0dLDnFF0YGIxfTjoXHZQZ2OmqqW52f9IRN6NXLDDiEHN3J21wbdpaUP-~KnrtiLO3SgfeSPGfxejJC~bbkOIjKAE9OX6-YUbbE6SixmAqD7AXqLoOj2YmOp09hIS9lIp0S0GLzMgLsORPGqwvMs1bS7XZsUUr24WU2Fri1zLmlaYg5WGfu0poA4B0rPuoERGXb3y7xZF3JkCjMuCyQ__&Key-Pair-Id=K1GS3H53SEO647", "duration": 112, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1529482323187470337%2FDw3BLmwB.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=dd6a310b02c07b3b1fa1c4760c445775", "srcset": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1529482323187470337%2FDw3BLmwB.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=dd6a310b02c07b3b1fa1c4760c445775, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1529482323187470337%2FDw3BLmwB.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=f0d2cff0924a5584bf26145f8e5b813b 2x, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1529482323187470337%2FDw3BLmwB.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=8aa8680a7c920928ccfe54108636b1c1 3x"}, "body": "umano様、はじめまして。\nこの度、クトゥルフ神話TRPG（CoC）「ビスポークランドでなにがあったか？」に登場する3人のキャラクター紹介動画用のオリジナルBGMを制作していただきたく、リクエストいたします。\n\n楽曲全体のイメージは、洋画や海外ドラマのオープニング・予告編のような、華やかで愉快、エンターテインメント性のある楽曲です。ワクワク感や勢いがあり、キャラクター登場時に印象に残るような、少し大げさで遊び心のある演出感を希望しています。\n\nまた、作品には「テーラー（仕立屋）」という要素があるため、仕立屋・洋服・紳士服・ファッションを連想できる音や演出も入れていただけると嬉しいです。\n\n例えば、キャラクターの登場時に革靴の「コツコツ」という足音をリズムとして使用したり、ハサミで布を切る音、ミシン、針や糸など、仕立て作業を思わせる音を効果音的に取り入れるイメージです。\nこちらはあくまで一例ですので、umano様のセンスで自然に取り入れていただけましたら幸いです。\n\n3人のキャラクター\n\n① イギリス風 🇬🇧\n上品・知的・紳士的な雰囲気をベースに、少しコミカルで遊び心のある感じ。英国映画のような、優雅でおしゃれながらも、どこか癖のある印象を希望しています。クラシカルなテーラーらしさも感じられると嬉しいです。\n\n② イタリア風 🇮🇹\n明るく陽気で情熱的。軽快で華やか、少し大げさなくらいのエンターテインメント感があり、聴いていて楽しくなるような雰囲気を希望しています。ファッションやテーラーらしい洒落っ気もあると嬉しいです。\n\n③ アメリカ風 🇺🇸\nエレキギターやドラムを中心とした、力強くノリの良いアメリカンロック。豪快・爽快・自由な雰囲気で、3人目の登場とともに一気に盛り上がり、「ここから始まる！」というような勢いを出したいです。\n\n構成は「イギリス風 → イタリア風 → アメリカンロック」と自然に変化し、最後は3人の紹介を締めくくるような、派手で印象的なフィナーレにつながると嬉しいです。\n\n可能であれば、キャラクターごとに印象的なメロディや音楽的モチーフを作り、「このフレーズが出てきたらこのキャラクター」と分かるような表現も希望しています。\n\n完成した楽曲はキャラクター紹介動画に使用し、YouTubeやX（旧Twitter）などのSNSで公開予定です。公開時には、楽曲制作者様のお名前である「umano」様をクレジットとして必ず記載いたします。\n\n上記はあくまで希望・イメージとなりますので、具体的な楽器・音色・効果音・編曲・展開などは、umano様の解釈やアイデアを活かして制作していただけましたら幸いです。\n\nご検討の程よろしくお願いいたします。", "nc": 1, "word_count": 0, "transcoder": "audio", "creator_acceptable_same_genre": true}], "similar_creators": [{"id": 356812, "creator": true, "nsfw_acceptable": true, "acceptable": false, "name": "鮭夫@ヒトミ先生㉑巻発売中", "screen_name": "shakekoujou", "avatar_url": "https://pbs.twimg.com/profile_images/2060731453005340672/7MWcSRF8.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1639368229/1712020522/1500x500", "appeal_receivable": true, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 7, "complete_expiration_days": 120, "skills": [{"genre": "art"}], "banned": false, "nc": 32}, {"id": 1039215, "creator": true, "nsfw_acceptable": false, "acceptable": false, "name": "ダニ", "screen_name": "2da_ni", "avatar_url": "https://pbs.twimg.com/profile_images/1801186349812498432/N_7GdzLp.jpg", "header_url": "ht