.com/drive/folders/1tnRjRfdIsnZwvE1ul7_g86eGD9azL_QR", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Nugutt0/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3286968, "client_id": 3775323, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/12dc4a41/uploads/origins/ded1be02-8115-4549-a2a2-bdad753cc31c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=884de87a2be8803ba0467aa2fa92c27d", "srcset": "https://si.imgix.net/12dc4a41/uploads/origins/ded1be02-8115-4549-a2a2-bdad753cc31c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=884de87a2be8803ba0467aa2fa92c27d, https://si.imgix.net/12dc4a41/uploads/origins/ded1be02-8115-4549-a2a2-bdad753cc31c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=9c4b32637790a5be7cd1821c6871b1a9 2x, https://si.imgix.net/12dc4a41/uploads/origins/ded1be02-8115-4549-a2a2-bdad753cc31c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=8558cf99fdf36b55ee5132a6bc75c885 3x"}, "duration": null, "nsfw": true, "hardcore": true, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/12dc4a41/uploads/origins/ded1be02-8115-4549-a2a2-bdad753cc31c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f90fe9562677882bfa8fcf639d45438f", "srcset": "https://si.imgix.net/12dc4a41/uploads/origins/ded1be02-8115-4549-a2a2-bdad753cc31c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f90fe9562677882bfa8fcf639d45438f, https://si.imgix.net/12dc4a41/uploads/origins/ded1be02-8115-4549-a2a2-bdad753cc31c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=47be050abe73d6d52d268c1423656e01 2x, https://si.imgix.net/12dc4a41/uploads/origins/ded1be02-8115-4549-a2a2-bdad753cc31c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&c