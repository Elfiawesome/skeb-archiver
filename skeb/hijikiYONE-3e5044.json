s://si.imgix.net/c587e9b2/uploads/origins/74ea37e6-413e-43db-8722-0117d1ed90bc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=b6784eab0e5012e20285d37b20e90f23 3x"}, "private": true, "genre": "comic", "tipped": false, "creator_id": 2000956, "nc": 48}, {"path": "/@hijikiYONE/works/9", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2000956, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/16473fc2/uploads/origins/c0727ceb-808c-402d-a1dc-63d14327a096?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a96361a9b7229d501d1111499d788573", "srcset": "https://si.imgix.net/16473fc2/uploads/origins/c0727ceb-808c-402d-a1dc-63d14327a096?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a96361a9b7229d501d1111499d788573, https://si.imgix.net/16473fc2/uploads/origins/c0727ceb-808c-402d-a1dc-63d14327a096?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e1a83688f649d9fd970a5c4f702f42ac 2x, https://si.imgix.net/16473fc2/uploads/origins/c0727ceb-808c-402d-a1dc-63d14327a096?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=7fecc5758b4ab7db6dd06de6be5f6d64 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/16473fc2/uploads/origins/c0727ceb-808c-402d-a1dc-63d14327a096?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=01e29ccead27e721c57a558960ac49e7", "srcset": "https://si.imgix.net/16473fc2/uploads/origins/c0727ceb-808c-402d-a1dc-63d14327a096?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=01e29ccead27e721c57a558960ac49e7, https://si.imgix.net/16473fc2/uploads/origins/c0727ceb-808c-402d-a1dc-63d14327a096?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=81680c1fd9d07b945b496e2c575eeb47 2x, https://si.imgix.net/16473fc2/uploads/origins/c0727ceb-808c-402d-a1dc-63d14327a096?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=50f913f633fecc1d179914c2c8c44bf7 3x"}, "body": "サンダーイグニスとサンダーイグニスとシルバーグランツは捕らわれ、強制的に秘めた思いを暴かれるという恥辱を味わった。\n\n敵組織はそんな彼等の秘密を、ヒーローたる所以を暴こうとしていた。\n解析されていくヒーローから脱がしたスーツ…。\nそのスーツが解析され、ヒーローの秘密が暴かれていく有様を、彼等は有様を目の当たりにするしかない。\n剥奪されたヒーローとも言うべき彼等は、全裸で絶望と恥辱の極地にあった。\n\nそして、二人は、全裸の状態でシングルのベッドに放り出される。\n互いの距離が近い。\n隠すものが何もない。己が抱く性欲もすべて互いに知ってしまう状況なのだ。\nいきりたつ逸物をお互いが意識し、敵組織に観察・監視される中で、抱き合い、そして、性なる行為を始めてしまう。\n観られていることを意識しながらも、恥ずかしく思いながらも、お互いの思いの丈をぶちまける…。\n淫らに腰を振る…。\n大股開きをして受け入れる…。\n互いの声が交じり合うほどの、淫らなヒーローがベッドに二つ存在していた。\n（受けがどちらになるのか、お任せします）\n\nよろしくお願いいたします。", "nc": 57, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@hijikiYONE/works/8", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/9011be07/uploads/origins/236541a7-9644-4c1f-98a0-4e1ba6ca43f4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=1eee75bcfdd436d5ae16fc4d1b8eb844", "srcset": "https://si.imgix.net/9011be07/uploads/origins/236541a7-9644-4c1f-98a0-4e1ba6ca43f4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=1eee75bcfdd436d5ae16fc4d1b8eb844, https://si.imgix.net/9011be07/uploads/origins/236541a7-9644-4c1f-98a0-4e1ba6ca43f4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=e9de50a0f7ca625cd208d9de2d4db537 2x, https://si.imgix.net/9011be07/uploads/origins/236541a7-9644-4c1f-98a0-4e1ba6ca43f4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=c68bf47e26c9d36fa06418fc90783426 3x"}, "private": true, "genre": "art", "tipped": true, "creator_id": 2000956, "nc": 49}, {"path": "/@hijikiYONE/works/7", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/eba08b99/uploads/origins/97990938-a906-495b-bf22-85f9b6346bf9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=11df0c8c3345f09296c644f4f9b0e6c7", "srcset": "https://si.imgix.net/eba08b99/uploads/origins/97990938-a906-495b-bf22-85f9b6346bf9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=11df0c8c3345f09296c644f4f9b0e6c7, https://si.imgix.net/eba08b99/uploads/origins/97990938-a906-495b-bf22-85f9b6346bf9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=8b54cf873d4ef08eff7cd0e8f7dd4c0c 2x, https://si.imgix.net/eba08b99/uploads/origins/97990938-a906-495b-bf22-85f9b6346bf9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=872a82102e9800a72355bc31fa846eb8 3x"}, "private": true, "genre": "art", "tipped": true, "creator_id": 2000956, "client_id": 156033, "nc": 177}, {"path": "/@hijikiYONE/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2000956, "client_id": 29945, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/9019385d/uploads/origins/82dadb01-e0a2-4130-b6c8-0ca0eac6fbf8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=534aab585e29774a21e38f1243e68214", "srcset": "https://si.imgix.net/9019385d/uploads/origi