net/9f701fa2/uploads/origins/7c8ee7d4-2df1-4079-b0fd-42418028a42a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=162dd8476cd1b97eb6ccd3faccb76857, https://si.imgix.net/9f701fa2/uploads/origins/7c8ee7d4-2df1-4079-b0fd-42418028a42a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=f4b7a5affe7bc3464395f13cbaf70f75 2x, https://si.imgix.net/9f701fa2/uploads/origins/7c8ee7d4-2df1-4079-b0fd-42418028a42a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=7a9aa66ca4713f47b8bff07bf92176f3 3x"}, "body": "初めまして。\nリクエスト失礼します。\n\nFGOのカーマ（ミステイク、第三再臨）がこぎみゅん＆うさぎさんに\n懐かれて困った顔をするイラストをお願いします。\n⇒こぎみゅんを抱っこしてうさぎさんを頭に乗せる（表情は笑顔でニッコリ）\n\nこぎみゅん\nhttps://www.sanrio.co.jp/wp-content/uploads/2022/06/mv-cogimyun-1.png\nうさぎさん\nhttps://www.sanrio.co.jp/wp-content/uploads/2022/06/sub-cogimyun-usagi.png\n\nご検討をお願いします。", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@amanouti/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2715304, "client_id": 103078, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/cd719e7c/uploads/origins/be010432-26ee-4e43-b227-8822623e67e6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0d87090c37a48387485303bcff268c94", "srcset": "https://si.imgix.net/cd719e7c/uploads/origins/be010432-26ee-4e43-b227-8822623e67e6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0d87090c37a48387485303bcff268c94, https://si.imgix.net/cd719e7c/uploads/origins/be010432-26ee-4e43-b227-8822623e67e6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=8defb3e7e06d1f81cc1ed1ea327edd8c 2x, https://si.imgix.net/cd719e7c/uploads/origins/be010432-26ee-4e43-b227-8822623e67e6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e706b0edec2161d8787d34d7d058c0ae 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/cd719e7c/uploads/origins/be010432-26ee-4e43-b227-8822623e67e6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=93ec977c1ce45b93eb1715f702903ed8", "srcset": "https://si.imgix.net/cd719e7c/uploads/origins/be010432-26ee-4e43-b227-8822623e67e6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=93ec977c1ce45b93eb1715f702903ed8, https://si.imgix.net/cd719e7c/uploads/origins/be010432-26ee-4e43-b227-8822623e67e6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=0b227a60fd29ea71cb6a3e2120a79ce6 2x, https://si.imgix.net/cd719e7c/uploads/origins/be010432-26ee-4e43-b227-8822623e67e6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=3da372e71aba0418beba9bdc5e6c618a 3x"}, "body": "こんにちは、\n\nこのメカドラゴン（全身）のイラストをさらに描いていただけないでしょうか。\n\n以下の要件を必ずお守りください：\nデザインについては、「メカドラゴン・マスター・リファレンスシート 1-5」をご参照ください。\nイラストにはメカドラゴンの翼が含まれており、効果（例：光の翼のような効果）を加えていただけると幸いです。\nメカドラゴンの全身を、細部まで丁寧に描き込み、質感も表現してください。\nメカドラゴンは金属色で、光と影の表現も加えてください。\n\nメカドラゴンが飛んでいるポーズに合うように、サイバーシティもデザインしていただけると幸いです。ぜひ最善を尽くして、素晴らしい作品を描いてください。\n\nアートワークは16:9（4Kレジェンダリー壁紙）サイズで、細部まで丁寧に描いてください。クリエイティブで革新的な作品にしていただきたいです。また、エフェクトなしでドラゴン単体を描いたものを提供していただけると助かります。そうすれば、ドラゴンのディテールをじっくり確認できます。PSDファイルも提供してください。\n\n構図、背景、ポーズなどは天之内ビョウさんにお任せいたします。以上です、何卒よろしくお願いいたします！私のキャラ（設定：https://drive.google.com/drive/folders/1WwkAwVrpRm5t5H3X2GaNFOkaYorAM1Jf?usp=sharing\n\nどうもありがとうございます。\nOrta\n\nhttps://drive.google.com/drive/folders/1WwkAwVrpRm5t5H3X2GaNFOkaYorAM1Jf?usp=sharing", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@amanouti/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2715304, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/15bb0b80/uploads/origins/6ba02