00&h=200&blur=200&s=9be184a02d685b7e0585e70e08868eba 2x, https://si.imgix.net/6c257949/uploads/origins/a655c99d-a238-4df6-a311-a282cebf1fc4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=3ed30adc00f19b7af4a965870ece2044 3x"}, "body": "iyn様こんにちは！\n\n以前からiyn様にOCを描いていただきたいと考えておりましたので再開を嬉しく思います。\n\nOCのイラストを書いていただきたく、リクエストを送らせていただきました！\n\n･キャラクターイメージ\n明るく朗らかな笑顔が似合う女性\nイメージカラー:水色\n\n下記リンクのドライブにて資料まとめております🙇🏻‍♀️\n\n･シチュエーション/背景\n山々や草原が広がる屋外\n風に髪をなびかせている様子\n\n全体的に暖かで爽やかな雰囲気で描いていただけますと幸いです\n\nご検討の程よろしくお願いします！", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@516iyn/works/10", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3458707, "client_id": 3895868, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/5000c97e/uploads/origins/d9a65035-a3a6-4d3d-8b5d-3d225d94b3b0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=488e3e312aecd5b632a833f251bf8e3b", "srcset": "https://si.imgix.net/5000c97e/uploads/origins/d9a65035-a3a6-4d3d-8b5d-3d225d94b3b0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=488e3e312aecd5b632a833f251bf8e3b, https://si.imgix.net/5000c97e/uploads/origins/d9a65035-a3a6-4d3d-8b5d-3d225d94b3b0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=1a0b4065e223e1a907b789bd3e1b04f6 2x, https://si.imgix.net/5000c97e/uploads/origins/d9a65035-a3a6-4d3d-8b5d-3d225d94b3b0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e86fe5599be2cea94e42eea92b6014c9 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/5000c97e/uploads/origins/d9a65035-a3a6-4d3d-8b5d-3d225d94b3b0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=666070905ba719dbd140ef8061596a31", "srcset": "https://si.imgix.net/5000c97e/uploads/origins/d9a65035-a3a6-4d3d-8b5d-3d225d94b3b0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=666070905ba719dbd140ef8061596a31, https://si.imgix.net/5000c97e/uploads/origins/d9a65035-a3a6-4d3d-8b5d-3d225d94b3b0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=62db0a6e3f53a2fd1a52ec1b5d0461f1 2x, https://si.imgix.net/5000c97e/uploads/origins/d9a65035-a3a6-4d3d-8b5d-3d225d94b3b0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=cc89dfdb9670096426dcc34937f31c5f 3x"}, "body": "iyn様\n\n初めまして。個人でデザイナー兼配信活動をしているのだめろんと申します。\niynさんのイラストを拝見しまして、とても素敵だなと思い今回リクエスト送らせていただきました…！\nもしリクエスト内容、使用用途が問題なければ、是非私のイラストを描いていただければなと思っております…！\n\n【参考資料】\nhttps://www.dropbox.com/scl/fo/x2wguxrqjbg0i43hazsd7/AJpGPHqr_LZfUUFx8mbKkCM?rlkey=xqy4ik9v1t4k7kxwd2k4nu3f0&dl=0\n\n\n世界観は異世界なので…中世ヨーロッパ風・異世界感な装い・雰囲気で描いていただけると嬉しいです（でも、がちがちなコンセプトではないので、描きづらければ気にせずにお描きください！）\n\n・構図や表情、ポーズなどは全てお任せ致します。\n・服装・アクセサリー等はキャラデザのものでなくても構いません。（帽子をトルなど、装飾品を減らしたり、全く別の服装になっても構いません。雰囲気等の希望はキャラシに記載しておりますが…基本お好きに描いていただければなと思っております…！）\n・髪型も自由に変更いただいてOKです！（KVはお団子ロングですが、三つ編み・ツインテール・ボブショート・ハーフアップなどなど可愛い髪型大好きです！）\n・宣伝等に使用予定のため、頭部や髪の毛、腕などが見切れていないと嬉しいです！（←構図的に椅子などで隠れたりする場合、気にしないでください！）\n\n\n〈可能であれば…〉\n私の所属する同人音楽サークル「love solfege」の楽曲「Material of your eyes」より得るインスピレーションで描いていただけると嬉しいです！（難しければ気にせずお描きください！）\nhttps://www.youtube.com/watch?v=Kh-fJ_lcE_k&list=RDKh-fJ_lcE_k&start_radio=1\n\n楽曲のざっくりイメージとしては\n・クラシカル\n・王室のダンスパーティー\nみたいな感じです。\nけど、自由解釈で構いません。あくまでも楽曲の雰囲気を踏襲いただけると嬉しいです…！\n\n【使用用途】\n・収益化をしているTwitch・Youtubeチャンネル等のサムネイル・配信バナー・動画\n・SNSのアイコン、ヘッダー、投稿等\n・PCデスクトップ壁紙\n\n\n\n・納品形式は可能であれば…人物・背景・小物（←もしあれば）を分けたpsdデータもしくは透過画像での納品だと大変助かります。\n\n\n何卒、ご検討のほど宜しくお願い致します。", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@516iyn/works/9", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3458707, "client_id": 3053006, "vtt_url": null, "thumbnail_im