h=200&blur=200&s=91b9a810ebadccf18760ec652c9cc8b8 3x"}, "body": "こんにちは！あなたの画風がとても気に入ったので、私のVTuberキャラクター「シン」のイラストを依頼したいです！\n用途：SNSへの投稿、プロフィール画像、バナー\n\n彼は、人をからかって楽しむのが大好きな、いたずら好きで生意気なネット少年です！口を開ける場合は、鋭い歯がある設定にしてください。ハンサムではなく、可愛らしく描いてください。\n\nhttps://vsona.co/shin-chan-", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@tokonatts/works/8", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3518776, "client_id": 3416124, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/a2136cff/uploads/origins/0942baa2-a290-4723-b690-924749d65cfd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b4fe831e4d3eb99fdf388e75c99e2bde", "srcset": "https://si.imgix.net/a2136cff/uploads/origins/0942baa2-a290-4723-b690-924749d65cfd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b4fe831e4d3eb99fdf388e75c99e2bde, https://si.imgix.net/a2136cff/uploads/origins/0942baa2-a290-4723-b690-924749d65cfd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=23d61f190edd46a20f0747484e2864c5 2x, https://si.imgix.net/a2136cff/uploads/origins/0942baa2-a290-4723-b690-924749d65cfd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=4d335283ec5d278133be1584ddcd0d2b 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/a2136cff/uploads/origins/0942baa2-a290-4723-b690-924749d65cfd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d7f10f1b81a7a8f9bce729e577c571e4", "srcset": "https://si.imgix.net/a2136cff/uploads/origins/0942baa2-a290-4723-b690-924749d65cfd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d7f10f1b81a7a8f9bce729e577c571e4, https://si.imgix.net/a2136cff/uploads/origins/0942baa2-a290-4723-b690-924749d65cfd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=5039b82c044243f210111e7465490034 2x, https://si.imgix.net/a2136cff/uploads/origins/0942baa2-a290-4723-b690-924749d65cfd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=745cab73bb22f3fe8fbc452fb9057ec4 3x"}, "body": "こんにちは。\nあなたの作品がとても気に入ったので、この2人のオリジナルキャラクターを基にイラストを描いていただけないでしょうか。完成した作品は、個人的な用途（壁紙として）で使用する予定です。\n\n【黒髪の女の子】\n無口で内向的、少しツンデレな猫のような性格。感情表現が苦手で素直になれませんが、実は茶髪の女の子をとても大切に思い、つい視線で追ってしまいます。文学専攻で読書と甘いものが好き。普段は無表情気味ですが、彼女の前では照れたり微笑んだりすることも。\n\n【茶髪の女の子】\n積極的で優しく、少し腹黒い狐のような性格。自分から黒髪の子に話しかけ、にこにこと接します。素っ気ない態度も気にせず、好意を理解している余裕があります。音楽専攻でヴァイオリンを学び、音楽鑑賞と苦味のある食べ物が好き。\n\n【世界観（お好きな設定で制作可）】\n①現代：高校の同級生。勉強や買い物、お弁当など日常の一コマ。\n②魔女AU：不老の黒髪の魔女と、人間の魔法見習い。前世で恋人同士だったが、茶髪は記憶を失って転生。森の小屋で共に暮らす。\n③天使×悪魔AU：厭世的な悪魔（黒髪）と軽薄そうな天使（茶髪）。現代が舞台。\n\n服装や画面はご自由にお任せします。性別変更などのアレンジも問題ありません！\nお読みいただきありがとうございます。\n\nhttps://drive.google.com/drive/folders/1xQjcmjs_CRdRkRbmmuYPqteQfTZI2bZn?usp=drive_link", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@tokonatts/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3518776, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/5bb3ceb1/uploads/origins/6aace162-6d80-488e-9f85-a938ee62e755?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c24930a14c9b8c93a8d62d6b814ee220", "srcset": "https://si.imgix.net/5bb3ceb1/uploads/origins/6aace162-6d80-488e-9f85-a938ee62e755?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c24930a14c9b8c93a8d62d6b814ee220, https://si.imgix.net/5bb3ceb1/uploads/origins/6aace162-6d80-488e-9f85-a938ee62e755?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ac5a8876858be93d3d0a36d092835716 2x, https://si.imgix.net/5bb3ceb1/uploads/origins/6aace162-6d80-488e-9f85-a938ee62e755?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=7dd6b195fe4b3d6ed97944188ffa45b3 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/5bb3ceb1/uploads/origins/6aace162-6d80-488e-9f85-a938ee62e755?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f8ae44eaf5ac756a833bcf14ef3a6b83", "srcset": "https://si.imgix.net/5bb3ceb1/uploads/origins/6aace162-6d80-488e-9f85-a938ee62e755?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f8ae44eaf5ac756a833bcf14ef3a6b83, https://si.imgix.net/5bb3ceb1/uploads/origins/6aace162-6d80-488e-9f85-a938ee62e755?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=d8f14d0928a0be95db1c1f793c65173b 2x, https://si.imgix.net/5bb3ceb1/uploads/origins/6aace162-6d80-488e-9f85-a938ee62e755?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=4d0855d7175568a28cd9aab09e632498 3x"}, "body": "初めまして。\nなついさんのカラフルな色使いと可愛らしいイラストがとても素敵でリクエストさせていただきました！\n\n宜しければOC(trpg探索者)2人組を描いていただきたいです！\n資料によってデザインが異なるものがありますがどれを参考にしてもらっても大丈夫です。\n\n使用用途\n・アイコン、ヘッダーへの利用\n・共有(絵師様名義記載します)\n・私用範囲での印刷、グッズ化\n\n金額や資料等に不備がありましたら再送申請いただけますと幸いです。\nお忙しい中かとは思いますがよろしくお願いします！\n\nhttps://drive.google.com/drive/folders/1-lUeCwh9Yx4KuxCLV5eP6EsJf1JDZA_X", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@tokonatts/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3518776, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/0c9ef942/uploads/origins/85b9e38e-26fc-4f96-904e-81a340c19fac?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3a28de8190dbcb4b043c2eea2c864b17", "srcset": "https://si.imgix.net/0c9ef942/uploads/origins/85b9e38e-26fc-4f96-904e-81a340c19fac?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3a28de8190dbcb4b043c2eea2c864b17, https://si.imgix.net/0c9ef942/uploads/origins/85b9e38e-26fc-4f96-904e-81a340c19fac?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=97e604cb05963f4d00b8593523d8c433 2x, https://si.imgix.net/0c9ef942/uploads/origins/85b9e38e-26fc-4f96-904e-81a340c19fac?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=33c8840d5e591fb04c5294ccb1c7c8db 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/0c9ef942/uploads/origins/85b9e38e-26fc-4f96-904e-81a340c19fac?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=505014b2537a9e9d2cc1ac778c625b77", "srcset": "https://si.imgix.net/0c9ef942/uploads/origins/85b9e38e-26fc-4f96-904e-81a340c19fac?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=505014b2537a9e9d2cc1ac778c625b77, https://si.imgix.net/0c9ef942/uploads/origins/85b9e38e-26fc-4f96-904e-81a340c19fac?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=9842823829f9ce3be6c849c32f8bd2f4 2x, https://si.imgix.net/0c9ef942/uploads/origins/85b9e38e-26fc-4f96-904e-81a340c19fac?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=75673e5815cdf7f0a8c3d370c25f28f3 3x"}, "body": "こんにちは、はじめまして。\nhttps://skeb.jp/@tokonatts/works/2\nhttps://skeb.jp/@tokonatts/works/1\n上記の最新作や過去作品を拝見し、そのクオリティの高さに強く惹かれました。\n艶やかで立体感のある綺麗な髪の表現、目、頬、口が可愛い豊かな表情、シワや陰影の上手な服飾、\nと魅力的な点がたくさんあり、是非イラストをお願いしたいと思いました。\n特に、明るい表情や見ていて楽しくなるような画面構成が好みで、うちの子も可愛く描いていただけると嬉しいです。\n\n少しマニアックな要素を含みますが、以下のようなオリキャラ(うちの子)の女の子を描いていただけませんでしょうか。\n以下は参考画像ですが、セーラー服のデザインや表情・ポーズ・構図は自由です。\nhttps://drive.google.com/drive/folders/1RIJ2bUUoPHZDhYmSZ5NlFco0yYrqRyDg?usp=sharing\n\n以下、リクエスト内容です。\n\n■女の子\n・艶やかな黒髪の前髪ぱっつん、少し内巻きのショートボブ、横髪・後ろ髪は口のラインくらいで切り揃えている、襟足はソフトに刈り上げ(構図次第で見えなくてもOK)\n・半袖のセーラー服\n・元気な感じ\n■シチュエーション\n・右腕にケガでギプスをしていて、三角巾で首から吊っている\n　‐首と肘のところの三角巾の結び目を見える位置にお願いします(資料URLご参照ください)\n　　(細かいですが…首の方は結び目1つ、三角巾の端が2つ、肘の方は結び目1つ、三角巾の端が1つ、という違いがあります)\n　‐右腕が画面に入るような構図でお願いします\n・ほっぺたに絆創膏１枚\n・ケガをしてても暗くならず、以下のような照れている表情\n　‐片目ウィンク、ペロっと舌を出している、いわゆるてへぺろな表情\n\n包帯に萌えるのと、それでも可愛く元気な姿に萌えるのが個人的なポイントです。\n\nhttps://www.youtube.com/watch?v=iLDkTBdxs4w", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@tokonatts/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3518776, "client_id": 667554, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/cb8759fd/uploads/origins/85e48298-e67c-4531-9f71-f1f70cf396a1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b746d0fadf62484928463f766a9c0164", "srcset": "https://si.imgix.net/cb8759fd/uploads/origins/85e48298-e67c-4531-9f71-f1f70cf396a1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b746d0fadf62484928463f766a9c0164, https://si.imgix.net/cb8759fd/uploads/origins/85e48298-e67c-4531-9f71-f1f70cf396a1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c73e39ba4fa496b285568b1cd52b462d 2x, https://si.imgix.net/cb8759fd/uploads/origins/85e48298-e67c-4531-9f71-f1f70cf396a1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e5e5fc76d7b9d11b6473df1ca07fb3c7 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/cb8759fd/uploads/origins/85e48298-e67c-4531-9f71-f1f70cf396a1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=983b70fcce2e0d24c417fe68638c07cc", "srcset": "https://si.imgix.net/cb8759fd/uploads/origins/85e48298-e67c-4531-9f71-f1f70cf396a1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=983b70fcce2e0d24c417fe68638c07cc, https://si.imgix.net/cb8759fd/uploads/origins/85e48298-e67c-4531-9f71-f1f70cf396a1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=3292f8dcaa6fc58ed3e441bff3f42d23 2x, https://si.imgix.net/cb8759fd/uploads/origins/85e48298-e67c-4531-9f71-f1f70cf396a1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=80e69edbedde04377733c10a978a76aa 3x"}, "body": "Hello なついさん! I really love your illustration so I hope you can draw the mutiple interaction illustration for my OCs (Little Blanke & little Side).\nReference link: https://sta.sh/225gurh6kmu7\n\n·Character\nBlanke (Kid Version) (145cm): He is 【silent and expressionless】, occasionally showing signs of being a child, like a cat who likes to rely on Side.\nSide (Kid Version) (150cm): He has a 【more mature mindset】 than his peers and is a type of person who enjoys taking responsibility on his own. He is reluctantly taking care of Blanke.\n\n·Request\nhttps://x.com/tokonatts/status/2038094896599572791/photo/1\nI really like the mutiple interaction illustration in this form in your X, and I hope to draw such illustrations for my OCs as well.\nThere are four different sets of costumes (daily, Alice, choir, sailor) placed inside the link, and you can freely choose your favorite costume to draw.\n\nThank you for consideration. It doesn't matter if you feel inappropriate, you can cancel this request.", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@tokonatts/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3518776, "client_id": 3944834, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/52562123/uploads/origins/8e886d40-6f38-479d-9ce6-851052e91f68?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c7c349daa2ab0debf7ac01aead84cbad", "srcset": "https://si.imgix.net/52562123/uploads/origins/8e886d40-6f38-479d-9ce6-851052e91f68?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c7c349daa2ab0debf7ac01aead84cbad, https://si.imgix.net/52562123/uploads/origins/8e886d40-6f38-479d-9ce6-851052e91f68?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c14beae51f110b9b73798b75e4162dbe 2x, https://si.imgix.net/52562123/uploads/origins/8e886d40-6f38-479d-9ce6-851052e91f68?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=cf7217bb04d331637275fa21b8864f63 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/52562123/uploads/origins/8e886d40-6f38-479d-9ce6-851052e91f68?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b88a0070c8b1bda641a77ff83b47dc42", "srcset": "https://si.imgix.net/52562123/uploads/origins/8e886d40-6f38-479d-9ce6-851052e91f68?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b88a0070c8b1bda641a77ff83b47dc42, https://si.imgix.net/52562123/uploads/origins/8e886d40-6f38-479d-9ce6-851052e91f68?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=fd8790a8f44d0df9cdbe9cdcdece2179 2x, https://si.imgix.net/52562123/uploads/origins/8e886d40-6f38-479d-9ce6-851052e91f68?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=f8042c65e2edc60de9ce82ac61e2d845 3x"}, "body": "なつい様\n初めまして。普段より素敵なイラスト拝見しております。\n今回skebを募集していると伺い、是非この機会になつい様に創作キャラクターを描いてほしい…！と思い、リクエストさせていただきます。\n\n【使用用途】個人鑑賞用　\n\n【キャラ紹介】\nワスレナ(本名:ミオ)\n見た目は10代前半の女の子。\n勿忘草の妖精だが、自分の出自に関しての記憶は一切ない。\n明るく人懐っこい性格で、何にでも興味を示す。\n自然と触れ合うのが好きで、動物や植物とも会話できる。\n暑いのが苦手。\n\n動植物が好きな設定なので、そういったモチーフと戯れているような構図だと嬉しいです。(可能な範囲で構いません。)\n\nご検討いただけたら幸いです。どうぞよろしくお願いいたします。\n\n【参考資料】\n雰囲気の参考にイラストを添付しています。\n衣装は三面図を参照していただければと思います。\n\nhttps://drive.google.com/drive/folders/1aWaw063Vu6f4iwhC1KLKAb4mztCgHMo8", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@tokonatts/works/3", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/5b0123bf/uploads/origins/e5e85c96-1919-43d7-a015-dbda6769