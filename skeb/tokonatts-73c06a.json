囲で構いません。)\n\nご検討いただけたら幸いです。どうぞよろしくお願いいたします。\n\n【参考資料】\n雰囲気の参考にイラストを添付しています。\n衣装は三面図を参照していただければと思います。\n\nhttps://drive.google.com/drive/folders/1aWaw063Vu6f4iwhC1KLKAb4mztCgHMo8", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@tokonatts/works/3", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/5b0123bf/uploads/origins/e5e85c96-1919-43d7-a015-dbda67690b01?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=2dcb996e9142e3a0fa149dba234a0aa7", "srcset": "https://si.imgix.net/5b0123bf/uploads/origins/e5e85c96-1919-43d7-a015-dbda67690b01?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=2dcb996e9142e3a0fa149dba234a0aa7, https://si.imgix.net/5b0123bf/uploads/origins/e5e85c96-1919-43d7-a015-dbda67690b01?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=101eb6bdfe416a6f523b99c8665c903b 2x, https://si.imgix.net/5b0123bf/uploads/origins/e5e85c96-1919-43d7-a015-dbda67690b01?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=7c2bee7c7255d0fdfef84798a476bae2 3x"}, "private": true, "genre": "comic", "tipped": false, "creator_id": 3518776, "nc": 144}, {"path": "/@tokonatts/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3518776, "client_id": 817791, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/c1899743/uploads/origins/718f5594-1632-4b71-9705-56b69e3340eb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=55d7289aa17592a9cce3d7c73a57a32b", "s