uploads/origins/c759727e-bc71-46bb-a123-241626d2f072?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8d03f1f6991dd4f8d2fb1bec757cdd83", "srcset": "https://si.imgix.net/102e3bd3/uploads/origins/c759727e-bc71-46bb-a123-241626d2f072?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8d03f1f6991dd4f8d2fb1bec757cdd83, https://si.imgix.net/102e3bd3/uploads/origins/c759727e-bc71-46bb-a123-241626d2f072?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b391f15045dffa456940f55cc4c8cfaf 2x, https://si.imgix.net/102e3bd3/uploads/origins/c759727e-bc71-46bb-a123-241626d2f072?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=059fafa8af89ab38dc12377a0e833700 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/102e3bd3/uploads/origins/c759727e-bc71-46bb-a123-241626d2f072?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=70f9ab2f5c77e27a7549132e8aee012b", "srcset": "https://si.imgix.net/102e3bd3/uploads/origins/c759727e-bc71-46bb-a123-241626d2f072?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=70f9ab2f5c77e27a7549132e8aee012b, https://si.imgix.net/102e3bd3/uploads/origins/c759727e-bc71-46bb-a123-241626d2f072?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=77f6ff56d1ddca617bf13356bfa18e41 2x, https://si.imgix.net/102e3bd3/uploads/origins/c759727e-bc71-46bb-a123-241626d2f072?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=ab14d1f9c272866d5ce67dd119f76d39 3x"}, "body": "丸宮みる様\n初めまして、Twitchでゲーム配信をしている白珠ぺるらと申します。\nXにて素敵なイラストを以前から拝見しており、ぜひみる様の絵柄で依頼したくリクエストを送りました。\n\n◇依頼内容\n「ダーリンダンス/かいりきベア様」の歌ってみた動画用イラスト\n\n◇キャラクター\n・白珠ぺるらを描いていただきたいです。\nお手数ですが詳細はGoogleドライブを参照ください。\n\n◇服装、構図\n・どちらも基本的に本家風でお願いしたいです。\n・本家様はピンクのブラウスを着用していますが、\nグレーorブルー系orブラウン系　のどれかお好きな色で描いていただけたら嬉しいです。\n・背景色：髪色と同じグレー系の色味だと嬉しいです。\n\n・こちらのカバーイラストのようなイメージで、髪および瞳は立ち絵資料を参考に着色いただきたいです。\nhttps://youtu.be/uk5MsBVq_f8?si=n4FyOnTpaUzvBnm1\n\n髪はグレーからブルーグレーのグラデ、\n瞳はベージュ系の色味です。\n\n・可能であれば、本家様に描写のあるストロング缶を、コーヒー缶に変更いただけますと嬉しいです。\n\n◇サイズ\n1920×1080の16:9でお願いします。\nまた、動画化予定のため背景と人物、小物が分かれたPSD形式orPNG形式での納品だと嬉しいです。\n\n長々と申し訳ありません。\nもしお引き受けいただける際はなにとぞよろしくおねがいいたします。\n\nhttps://drive.google.com/drive/folders/1O8Yu69uCHiQKjXuEQEasxcDcJHLgp8Uk", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@02m_zzz/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2955310, "client_id": 2113028, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/815de050/uploads/origins/96693a35-6975-48d9-a939-7963335445de?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d894525f1fb96348488aab7c46114e6e", "srcset": "https://si.imgix.net/815de050/uploads/origins/96693a35-6975-48d9-a939-7963335445de?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d894525f1fb96348488aab7c46114e6e, https://si.imgix.net/815de050/uploads/origins/96693a35-6975-48d9-a939-7963335445de?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=0199e9bde7092856ef0ac2a13d77d188 2x, https://si.imgix.net/815de050/uploads/origins/96693a35-6975-48d9-a939-7963335445de?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=03bcb26534945ca1c3858202f55f5c17 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/815de050/uploads/origins/96693a35-6975-48d9-a939-7963335445de?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=141909b2e8bc52a1d01d191c6507b667", "srcset": "https://si.imgix.net/815de050/uploads/origins/96693a35-6975-48d9-a939-7963335445de?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=141909b2e8bc52a1d0