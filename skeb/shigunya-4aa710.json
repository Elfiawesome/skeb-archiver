5597a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=aa9686fdb2bce9327727178668cb8df7 2x, https://si.imgix.net/0188ad24/uploads/origins/d4887626-5571-4b12-a8b9-ce324065597a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ee9ea1176c10b4c770b544400087cd51 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/0188ad24/uploads/origins/d4887626-5571-4b12-a8b9-ce324065597a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=785188f9a9841bfb788442e1444dc4fc", "srcset": "https://si.imgix.net/0188ad24/uploads/origins/d4887626-5571-4b12-a8b9-ce324065597a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=785188f9a9841bfb788442e1444dc4fc, https://si.imgix.net/0188ad24/uploads/origins/d4887626-5571-4b12-a8b9-ce324065597a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=65b5a65a8147e61ac10ffa939a0cf275 2x, https://si.imgix.net/0188ad24/uploads/origins/d4887626-5571-4b12-a8b9-ce324065597a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=ec794e9fe2436ff363c3469a99560fec 3x"}, "body": "こんにちは〜\nいつかしぐねこさんにお願いしたいなあと思っていたので…\n\nキャルちゃんとシェフィちゃんがお揃いのパジャマでうとうとしてる感じのイラストをお願いしたいです…！\nパジャマのお色やデザインはおまかせします〜！\n出来れば…モコモコしてたらうれしいな…なんて…", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@shigunya/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3096894, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/d22ae3f3/uploads/origins/223c9ad2-5e6e-41d2-836a-96e9b68193f9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=cb33faa96a21700ad0a24930e72a44fd", "srcset": "https://si.imgix.net/d22ae3f3/uploads/origins/223c9ad2-5e6e-41d2-836a-96e9b68193f9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=cb33faa96a21700ad0a24930e72a44fd, https://si.imgix.net/d22ae3f3/uploads/origins/223c9ad2-5e6e-41d2-836a-96e9b68193f9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b11306a19a05b87a31b2996cd3eae300 2x, https://si.imgix.net/d22ae3f3/uploads/origins/223c9ad2-5e6e-41d2-836a-96e9b68193f9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c6bd53f83222e67cbfb66fd40b398255 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/d22ae3f3/uploads/origins/223c9ad2-5e6e-41d2-836a-96e9b68193f9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b4d076d3a7a0c6d17763674eed65fe71", "srcset": "https://si.imgix.net/d22ae3f3/uploads/origins/223c9ad2-5e6e-41d2-836a-96e9b68193f9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b4d076d3a7a0c6d17763674eed65fe71, https://si.imgix.net/d22ae3f3/uploads/origins/223c9ad2-5e6e-41d2-836a-96e9b68193f9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=ba3b68f436f6644afc1b833f7b0ce4f1 2x, https://si.imgix.net/d22ae3f3/uploads/origins/223c9ad2-5e6e-41d2-836a-96e9b68193f9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=24f523ec8ec259edb1fdd325ac433397 3x"}, "body": "いきなりですが最初に1つ昔話をさせてください。ご依頼内容は最後の段落にあるので読み飛ばして頂いても構いません。\n\n私が同人の世界を初めて覗いた時、そこは未知で余りにキラキラした世界でした。その頃の私は誰かもわからないまま、心を動かされたイラストを見つけては保存をし、私も描きたいと小さな志を立てていました。\nそれから数年が経ち、少しづつ「あの頃」眺めていた方々の名前が一致し始め、私も少しながら絵が描けるようになった頃のことです。インターネットという広い海の中で、私はしぐねこさんに再度出会うことができました。\n私は、しぐねこさんにとても感謝しています。私にとって「あの頃」見ていた貴方は、私にとってまさに憧憬そのものであり、貴女のお陰であの頃なりたいと思った自分に、少し近づけた気がします。\nそのため、お布施の気持ちで、このリクエストを送るのですが……きっと描かなくてもいいとは言えないのがskebなのでしょう。そこで……\n\nなんでもお好きなのを描いてくださいと、言いたいところですが……よろしければ今少し流行っている「水着ミヤコちゃん」を、しぐねこさんにも是非描いていただきたく思います。\nこの長文と金額がハードルにならないことを願って……無理せず！描きたいと思ったら！！描いていただけたらと思います！！！\n以上です！長々とスミマセンでした！！！", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@shigunya/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3096894, "client_id": 3219825, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/1dc13e8c/uploads/origins/663d4777-e6f5-4e1d-a624-a144ed5a45c7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ca2d64040c1206c703bbad64d0988826", "srcset": "https://si.imgix.net/1dc13e8c/uploads/origins/663d4777-e6f5-4e1d-a624-a144ed5a45c7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ca2d64040c1206c703bbad64d0988826, https://si.imgix.net/1dc13e8c/uploads/origins/663d4777-e6f5-4e1d-a624-a144ed5a45c7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=abb6956e3396af9eea5f9c13e403f830 2x, https://si.imgix.net/1dc13e8c/uploads/origins/663d4777-e6f5-4e1d-a624-a144ed5a45c7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=bbc11554aa8992355bc079bf4fea566e 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/1dc13e8c/uploads/origins/663d4777-e6f5-4e1d-a624-a144ed5a45c7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=4e5fc98535af132108a3448943fabe2b", "srcset": "https://si.imgix.net/1dc13e8c/uploads/origins/663d4777-e6f5-4e1d-a624-a144ed5a45c7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=4e5fc98535af132108a3448943fabe2b, https://si.imgix.net/1dc13e8c/uploads/origins/663d4777-e6f5-4e1d-a624-a144ed5a45c7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=e1898f97f2a4be713d035a113a45ae15 2x, https://si.imgix.net/1dc13e8c/uploads/origins/663d4777-e6f5-4e1d-a624-a144ed5a45c7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=c9db973d6a6fd6eca7aa3ef91063c15e 3x"