7-b346-f4194b528a54?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=db80c6770bd86cff4f26a7e27c88b1e3", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/b34a90ff/uploads/origins/ff0c723f-64c9-49a7-b346-f4194b528a54?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e8c8aa26bcb50663963ce22508ac5da2", "src_set": ""}, "body": "「2MDKの子龍くんが多々良くんにプレスされる…が夢だった」\nというシチュエーションを見てみたいです。\n\nソファに寛（くつろ）いで居た子龍くんに気付かずに多々良くんがドカッと座り、立ち上がると紙の薄さくらいにプレスされた子龍くんが居る。\nそして、左端に夢オチだと分かるようにうなされてる子龍くんがいる。\n\n是非ご検討よろしくお願いします。", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@daihuku_osiri/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2136757, "client_id": 43412, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/42b230c2/uploads/origins/f6eabb6e-4971-4265-a6b8-c184ae3e0997?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=17172d89516d7e51fdc079fd9f868084", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/42b230c2/uploads/origins/f6eabb6e-4971-4265-a6b8-c184ae3e0997?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0a06635b1bda86406fbe6f314d01983e", "src_set": ""}, "body": "こんばんは。ガタイの良い青年とその友人の2P程の漫画を読んでみたいです。\nガタイは立派に育ったものの、顔が子供時代からあまり変わらない童顔(少年というより小僧という感じの顔)なのがコンプレックスな青年は、やや強面な男前の青年の顔を模した覆面を手に入れ、プライベートの時間に被り愛用し始める。\n今日も自分のガタイによく馴染む覆面の顔を鏡で眺めて頬を触りながらうっとりしていると、幼馴染の友人に「せっかくの男前も腑抜けた表情で台無しだな」とからかわれる。\n余計な減らず口が絶えない友人にいつもの調子でヘッドロックをかけておしおきするが、ガタイに見合った顔で凄む青年の姿に、今までのアンバランスな見た目とのギャップもあり胸が高鳴り始めてしまう友人を見てみたいです。\n回想で素顔の時の怒り顔を思い浮かべて比べるコマがあるとより好みです。", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@daihuku_osiri/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2136757, "client_id": 11245, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/38c969c1/uploads/origins/23b139ea-8a00-4e01-9cd8-827d54abc4be?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6394a4a599c68db45d3d8e797f15812b", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/38c969c1/uploads/origins/23b139ea-8a00-4e01-9cd8-827d54abc4be?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=cafe64cb74de28279772659c4d068b81", "src_set": ""}, "body": "こんにちは。いつもイラスト楽しみにしております\n自キャラの男をお願いしたいです。ずまさんの野郎絵が好きなので、なんでもさくっと描いて頂ければ本望です！もし余裕があれば女の子も添えて頂けると昇天します\n印刷用解像度だと自分用何かに印刷しやすいので捗ります\n特に全部網羅してくださいとかではないですが、参考までにいつものリク文も引用しておきます\n\nエルガー（29）　一人称「俺」\nわりと見た目どおりの豪胆な傭兵、ちょいちょい拐われるヒロイン。強い。裏切って死ぬ。ゴリゴリのマッチョ、無精髭、顔に傷あり、二重、縛った髪はちょっと癖っ毛でわりとふさふさです\n好きな子には手を出せないスケベ紳士（ヘタレというよりはスパダリですが相手を大事に思うあまりに……という感じ）\nあやめに対して「嬢ちゃん」「おまえさん」呼び（あやめお嬢ちゃん、あやめちゃんなど……ここぞってときにあやめって呼んでほしいですね）\n\nあやめ（18）　一人称「わたし」\nわりと見た目どおりなストイックな大和撫子、天使爛漫、戦う女子。強い。主人公。巨乳。髪型インテーク。髪色は完全な黒ではないです\n好きな男が手を出してくれないのでもどかしく思いつつも奥ゆかしいので攻め攻めにもなれない\n色味が絵によってまばらですが原則はサイトの紹介イラスト準拠でお願いします（表現上の揺れも乙なものです）\n\n金額に見合うと思われる範囲で形式は問いませんので自由に描いて頂ければと\n口調情報も併記しましたが必ず喋らせてほしいという指定ではございません\nご検討頂けますと幸いです\n\nhttp://tocca571.parallel.jp/original/arc/\n\nhttps://twitter.com/paradoxicaltheo/status/1421715295769567233?s=19", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@daihuku_osiri/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2136757, "client_id": 1144661, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/cc4a7a45/uploads/origins/f446fbbd-3515-4cc7-9ed1-6bd023ca5b0a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f8bfdab52780548626bf6a542b1471cd", "src_set": ""}, "duration"