e}, {"path": "/@daihuku_osiri/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2136757, "client_id": 87554, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/67792ac8/uploads/origins/94b45f27-7060-463e-aa91-f1384e70ae84?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=53a7988842bbb93ed96c77cd97246f06", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/67792ac8/uploads/origins/94b45f27-7060-463e-aa91-f1384e70ae84?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e4b572dd4c7b0278279643b769623cee", "src_set": ""}, "body": "前回描いて頂いた寝具擬人化を使ったマンガをお願いします。\nそれと今回より、こちらの名義で依頼をさせて頂きます。(上手く行っているでしょうか)\n\n\n暑いですね。\n暑くなると毛布と抱き枕はどこへ行くのか。\nそう、押し入れへ行きます。\n\n夜中、人間が寝ていると押し入れがガタガタと音を立てます。\nその音で目が覚めた人間は音の元凶を確認する為に恐る恐る押し入れを開けます。\nすると、突然大きな2つの影に襲われて中へ引き摺り込まれます。\nもみくちゃにされた後、人間は毛布男子から裸締めにされ、抱き枕男子は人間の下半身を捕まえてくすぐっています。(不思議な押入れになっているので、広さを気にせずに思う様にやってしまってください。ツッコミは無しです)\n人間はくすぐったいやら苦しいやらで赤くなっており、擬人化2人はイタズラっぽい顔をしています。\n\nこんな流れを、出来れば前半ホラー調でお願い出来ないでしょうか。\n\nちなみにこの部屋はクーラーがあるので寝やすいですけれど、それはそれとして人間は暑いでしょう。", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "similar_creators": [{"id": 25420, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "そーちゃん", "screen_name": "Sawch_Cls", "avatar_url": "https://pbs.twimg.com/profile_images/1641409964114862083/rErt4F9f.jpg", "header_url": "https://pbs.twimg.com/profile_banners/2387283654/1747823604/1500x500", "appeal_receivable": true, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "skills": [{"genre": "art"}, {"genre": "comic"}], "nc": 160}, {"id": 44571, "creator": true, "nsfw_acceptable": true, "acceptable": false, "name": "まさぺこ@けもケット16【R-27】", "screen_name": "ma