t=crop&crop=top&w=200&h=200&s=c9bf12b028adc1d2fe23e7cbaaa1f0ca 2x, https://si.imgix.net/ed8e875e/uploads/origins/c7e11b12-2d8d-46eb-a4c1-e29b1924af52?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=477b990e4c72935ff47802046200ce4e 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/ed8e875e/uploads/origins/c7e11b12-2d8d-46eb-a4c1-e29b1924af52?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=1b15a9ea06b60e5572aeb767509c8ff6", "srcset": "https://si.imgix.net/ed8e875e/uploads/origins/c7e11b12-2d8d-46eb-a4c1-e29b1924af52?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=1b15a9ea06b60e5572aeb767509c8ff6, https://si.imgix.net/ed8e875e/uploads/origins/c7e11b12-2d8d-46eb-a4c1-e29b1924af52?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=d28ae3c129c663d1e1f9565e90282bd9 2x, https://si.imgix.net/ed8e875e/uploads/origins/c7e11b12-2d8d-46eb-a4c1-e29b1924af52?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=59b0d5d2c8f346cb360a8d91c2d60381 3x"}, "body": "ろう様\n\nはじめまして。Twitter検索より失礼いたします。\nこの度はOCのカップルを描いていただきたくリクエストさせていただきました。\n\nろう様の色使いが本当に素敵で、落ち着いているのに彩度が高く、じわっ広がるような鮮やかなタッチに一目惚れしました。\n今回お願いする2人は、モノクロ+それぞれ赤（緋色）、黄色（山吹色）がイメージカラーとなっていますので、そちらを参考に描いていただけますと幸いです。\n\n使用用途は【個人鑑賞】、【デジタルデバイスの壁紙】場合によっては【自分用のグッズ制作】となります。\n\n構図等についてはお任せいたしますが、イラストの好みの傾向として、できれば胸下〜腰より下あたりまで広めに描かれていると嬉しいです。\n\nキャラクターについて\n〜\n詳しい関係性などは資料を見ていただければと思います。\n（側近でブラッシュアップしたもののため資料が少ないです。ファイル内の過去の二人も参考程度にしていただければ幸いです。）\nー\nひいぶき【モチーフ:比翼連理】\n\n飛色（27）\n表情筋は少し死んでいる。\n唯吹とまた話せるのは嬉しいが、少なからず悪霊化による狂気も感じられ、あの頃の唯吹はもういないんだということを再確認させられるため苦しくもある。上手く笑えない。\nかわいいとは思うし、彼女と一緒に居ることについて嫌ということもないが幼馴染にそっくりな別物に感じられることがあり、過去の彼女の印象が塗り替えられていくような気がして漠然とした焦燥を感じることがある。\n\n唯吹（12）\nかつての自分の「生きていたい」「ひぃくんとずっと一緒に居たい」「お嫁さんになりたい」といった気持ちが強く残っており、契約によって暴走は抑えられてるとはいえ悪霊なりに欲に愚直になっている。\n生前の彼女は謙虚で引っ込み思案だっただけに、困惑する飛色が見られることもあるが、なんだかんだ受け入れてくれるので特に気にしていない。\n普段は飛色の左肩に両手を置き、ふわふわと漂っている。（資料1.png参照）\n足は半透明でもなくてもよい。\n\n以上、目を通していただきありがとうございました。\n御縁ありましたらよろしくお願いいたします。\n\nhttps://x.com/i/status/2021126384576549251", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 1112842, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "輝輔 ╎ ｺﾐﾃｨｱ せ23a", "screen_name": "gv_vn8", "avatar_url": "https://pbs.twimg.com/profile_images/2016396828934057984/fsCRGMTP.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1251535958698192897/1727712442/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 5, "complete_expiration_days": 21, "skills": [{"genre": "art"}], "banned": false, "nc": 129}, {"id": 1366068, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "お、", "screen_name": "ooo_0926", "avatar_url": "https://pbs.twimg.com/profile_images/1976456505617678337/k4n0GrRE.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1393369213792751620/1768864254/1500x500", "appeal_receivable": true, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "art"}, {"genre": "correction"}], "banned": false, "nc": 160}, {"id": 2813240, "creator": true, "nsfw_acceptable": false, "acceptable": false, "name": "並", "screen_name": "6_hanaru_6", "avatar_url": "https://pbs.twimg.com/profile_images/2079800043427745792/b0HJi9dW.jpg", "header_url": null, "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 7, "complete_expiration_days": 100, "skills": [{"genr