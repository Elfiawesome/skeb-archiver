69770d952?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=91a8df59654a0437175bdef6329b0c19", "srcset": "https://si.imgix.net/362bdf4d/uploads/origins/715bdcbf-a159-4aea-8a03-c8a69770d952?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=91a8df59654a0437175bdef6329b0c19, https://si.imgix.net/362bdf4d/uploads/origins/715bdcbf-a159-4aea-8a03-c8a69770d952?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e6e5cc78cdb1ad5d2e2eb59092976b5d 2x, https://si.imgix.net/362bdf4d/uploads/origins/715bdcbf-a159-4aea-8a03-c8a69770d952?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a13314411f04eea7e90772b0c8368044 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/362bdf4d/uploads/origins/715bdcbf-a159-4aea-8a03-c8a69770d952?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=85a471fddada30b35340869f9f4f5a73", "srcset": "https://si.imgix.net/362bdf4d/uploads/origins/715bdcbf-a159-4aea-8a03-c8a69770d952?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=85a471fddada30b35340869f9f4f5a73, https://si.imgix.net/362bdf4d/uploads/origins/715bdcbf-a159-4aea-8a03-c8a69770d952?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=19d8c7cb43d2e0b2a210062ac3590a6b 2x, https://si.imgix.net/362bdf4d/uploads/origins/715bdcbf-a159-4aea-8a03-c8a69770d952?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=673f6c374fcfdc7efe8b52785fbb481b 3x"}, "body": "いつも楽しくイラスト見させていただいています。skebを募集されている事を知り、リクエスト送らせて頂きます。\nキャラクターは、ウマ娘のタマモクロスでお願いします。\n衣装は、以前うまよんという公式4コマ漫画にて登場した、ハロウィンのおばけの衣装でお願いいたします。\n\nhttps://twicomi.com/manga/zekuazu_06/1387767713540489225\n\nhttps://twicomi.com/manga/aiue_lov3/1187406599947579393\n\n公式では上がっていないので、Xに上がっている物になりますが念の為添付しておきます。参考にしていただければなと思います。\n構図ですが、お菓子がいっぱい入ったジャック・オ・ランタンのバケツを両手で持ち、上目遣いでとても嬉しそうにトレーナーに見せている様子でお願いします。\nただトレーナーの姿や影は不要で、イラストにいるのはタマモクロスのみでお願いいたします。恐らくトレーナー視点のような感じになるかと思います。\n全体的にとても可愛い感じでお願いします。表情は開いた両目を輝かせて、とても嬉しそうに大きく口を開けて笑っている感じでお願い致します。また、その際に八重歯も見せていてほしいです。\n両手も、袖で手が隠れている状態でバケツを持っている状態でお願いします。バケツは胸の辺りで持たせていて欲しいです。\n\n念の為いらすとや様の似たようなイラストを資料URLの方に付けておきます。こちらも何かの参考になればなと思います。\nイラストのサイズですが、Simejiのキーボードに使用したいと考えていますので、もし宜しければ公式で推奨されている1242×924のサイズにして頂ければと思います。(だいたい4:3くらいかと思われます)\n\nあれこれとしつこく注文を付けてしまい、本当に申し訳ございません。\n最初に赤目のテイオーのイラストを見た時からずっと貴方の描かれるタマモクロスを見たいなと思っており、skebを募集しているのを見つけた時は本当に嬉しかったので、どうかご一考いただけますと幸いです。\nとても心温まる可愛らしい好きな絵柄で、そんな素晴らしい絵柄で描かれる最推しをキーボードに設定出来たらいつでも見れてとても楽しくなりそうだなと思います。\nお忙しい中本当に申し訳ございません。どうかよろしくお願いいたします。\n\nhttps://www.irasutoya.com/2014/03/blog-post_2158.html?m=1", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@Tujiya_Okuyasu/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3320016, "client_id": 3462963, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/bc0de657/uploads/origins/79c138b5-0eca-4cd4-9e46-a88ab4353e5e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e6cc7c540d9a34222e47f8649d70f590", "srcset": "https://si.imgix.net/bc0de657/uploads/origins/79c138b5-0eca-4cd4-9e46-a88ab4353e5e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e6cc7c540d9a34222e47f8649d70f590, https://si.imgix.net/bc0de657/uploads/origins/79c138b5-0eca-4cd4-9e46-a88ab4353e5e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a4e91b5399e6cab7f89a79db7c67637f 2x, https://si.imgix.net/bc0de657/uploads/origins/79c138b5-0eca-4cd4-9e46-a88ab4353e5e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=87d5652592b84bd9c95463066fbea555 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/bc0de657/uploads/origins/79c138b5-0eca-4cd4-9e4