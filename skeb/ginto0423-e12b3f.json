いません。\n背景などもなくて大丈夫です。\n\nこの内容でよろしければ受けてくださると喜びます。よろしくお願いしますm(_ _)m", "nc": 168, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@ginto0423/works/5", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/321588a7/uploads/origins/c4e438ac-86d0-4dd7-85bb-652b0075e08a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=29a5251231df847db8f610ced4e02fe2", "srcset": "https://si.imgix.net/321588a7/uploads/origins/c4e438ac-86d0-4dd7-85bb-652b0075e08a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=29a5251231df847db8f610ced4e02fe2, https://si.imgix.net/321588a7/uploads/origins/c4e438ac-86d0-4dd7-85bb-652b0075e08a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=4e8b6b04e8b5e4030e0feeb51446c083 2x, https://si.imgix.net/321588a7/uploads/origins/c4e438ac-86d0-4dd7-85bb-652b0075e08a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=b54530c3c660994712c9c099afcfa44f 3x"}, "private": true, "genre": "art", "tipped": false, "creator_id": 2610643, "nc": 34}, {"path": "/@ginto0423/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2610643, "client_id": 1120357, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/2cb440de/uploads/origins/f15f8ecc-394c-4180-aa7d-0ad5800ee0f0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=05a4ce6841444403fec57ecfa1e88f13", "srcset": "https://si.imgix.net/2cb440de/uploads/origins/f15f8ecc-394c-4180-aa7d-0ad5800ee0f0?bg=%23fff&auto=for