, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@ginto0423/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2610643, "client_id": 1120357, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/f8881326/uploads/origins/09951354-9bb4-4ab9-98af-c9c9066bddce?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0a09d3633f446e5a9e13538a7556e177", "srcset": "https://si.imgix.net/f8881326/uploads/origins/09951354-9bb4-4ab9-98af-c9c9066bddce?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0a09d3633f446e5a9e13538a7556e177, https://si.imgix.net/f8881326/uploads/origins/09951354-9bb4-4ab9-98af-c9c9066bddce?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=8b5df8e708512d8cedc477ea3aad9115 2x, https://si.imgix.net/f8881326/uploads/origins/09951354-9bb4-4ab9-98af-c9c9066bddce?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=84086f1111dfe634e3b36da0ea8a882c 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/f8881326/uploads/origins/09951354-9bb4-4ab9-98af-c9c9066bddce?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=655fef3d210a251dcf84828dbaf47804", "srcset": "https://si.imgix.net/f8881326/uploads/origins/09951354-9bb4-4ab9-98af-c9c9066bddce?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=655fef3d210a251dcf84828dbaf47804, https://si.imgix.net/f8881326/uploads/origins/09951354-9bb4-4ab9-98af-c9c9066bddce?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=36fee8b28d4df24b5a340b9b3120f4eb 2x, https://si.imgix.net/f8881326/uploads/origins/09951354-9bb4-4ab9-98af-c9c9066bddce?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=0465b16d4c064c7e625c5fe03905bad6 3x"}, "body": "はじめましてギントさん。格闘描写のあるイラストも描けるとのことでリクエストさせてください。\n\nブルーリフレクションシリーズの平原陽桜莉(ひらはらひおり)と星崎愛央(ほしざきあお)のイラストをお願いします。\n\n衣装はいずれも制服姿で。資料を参照ください。\n平原陽桜莉\nhttps://drive.google.com/drive/folders/1GDWpxPb-5k_oXSrw5Mf1XwzTfIhM3R2A?usp=sharing\n\n星崎愛央\nhttps://drive.google.com/drive/folders/1dYe_ioQxsr1PAommxN0lC1BmQTttjJL3?usp=sharing\n\nシチュエーション\n登校中の愛央を見つけた陽桜莉がタックル気味に飛びつくイラストをお願いします。\nタックルはアメフトやラグビーで見られるスピアーと呼ばれるタックル。\n陽桜莉は愛央に会えた嬉しさで飛びついています。例えるなら、飼い主と再会して喜びが爆発した大型犬が飼い主に飛びつくような感じです。なので陽桜莉の表情は嬉しさが全面に出たものでお願いします。\n\n構図や背景等はお任せします。ご検討のほどよろしくお願いします。", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@ginto0423/works/2", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/e087f99e/uploads/origins/4e0c7a35-759b-459f-b3a8-0352a8803b2f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=13eca172f3eb3aa7854cbc721c093f0c", "srcset": "https://si.imgix.net/e087f99e/uploads/origins/4e0c7a35-759b-459f-b3a8-0352a8803b2f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=13eca172f3eb3aa7854cbc721c093f0c, https://si.imgix.net/e087f99e/uploads/origins/4e0c7a35-759b-459f-b3a8-0352a8803b2f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=7a5f439ecf554b389eff7c21a3f5ed31 2x, https://si.imgix.net/e087f99e/uploads/origins/4e0c7a35-759b-459f-b3a8-0352a8803b2f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=fb87d5c34259fe0497a8fafce5379dd1 3x"}, "private": true, "genre": "art", "tipped": true, "creator_id": 2610643, "client_id": 157199, "nc": 128}, {"path": "