‐-----‐-----‐-----‐--\n\n\nお忙しいところ恐れ入りますが、よろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/10EfQBiqamv2_-WWfSRSAw3VufUPBGJrA\n\nhttps://drive.google.com/drive/folders/10EfQBiqamv2_-WWfSRSAw3VufUPBGJrA", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@5oma_3Do/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2660761, "client_id": 1747021, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/1d778c5d/uploads/origins/b3136fc5-eb48-4881-9a54-cdc271bf7f34?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e4084f5204073d3f4b7e4320e8a22f79", "srcset": "https://si.imgix.net/1d778c5d/uploads/origins/b3136fc5-eb48-4881-9a54-cdc271bf7f34?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e4084f5204073d3f4b7e4320e8a22f79, https://si.imgix.net/1d778c5d/uploads/origins/b3136fc5-eb48-4881-9a54-cdc271bf7f34?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b373554c58dce51c0d89795c7ecd859c 2x, https://si.imgix.net/1d778c5d/uploads/origins/b3136fc5-eb48-4881-9a54-cdc271bf7f34?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d95b64e9de0bd87f9030a9c2bbcb10b3 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/1d778c5d/uploads/origins/b3136fc5-eb48-4881-9a54-cdc271bf7f34?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ec7e4bb47c5ee52ed56288325c45710e", "srcset": "https://si.imgix.net/1d778c5d/uploads/origins/b3136fc5-eb48-4881-9a54-cdc271bf7f34?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ec7e4bb47c5ee52ed56288325c45710e, https://si.imgix.net/1d778c5d/uploads/origins/b3136fc5-eb48-4881-9a54-cdc271bf7f34?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=9278dd3a62d60d77846