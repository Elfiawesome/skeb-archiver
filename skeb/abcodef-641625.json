fit=crop&crop=top&w=200&h=200&blur=200&s=1e124c72378edcf2f524a184cc56e140", "srcset": "https://si.imgix.net/9af58089/uploads/origins/0f6aaf64-e814-473d-abae-3cc871531cec?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=1e124c72378edcf2f524a184cc56e140, https://si.imgix.net/9af58089/uploads/origins/0f6aaf64-e814-473d-abae-3cc871531cec?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=4860df393b2879df0901493f9308a050 2x, https://si.imgix.net/9af58089/uploads/origins/0f6aaf64-e814-473d-abae-3cc871531cec?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=1115a84a6044047162375c7921ab4509 3x"}, "body": "初めまして、エビコさんのユルナイツがとてもすきな者です！\nユルナイツというネーミングも、かっちりイメージの甲冑さんたちがゆるいというギャップも、なによりのびのびとして自由で魅力的な線がとても好きです\nSkebしていることを知り、ぜひうちのこをエビコさんの線で見てみたいなと思い、今回依頼させていただきます。\n\nうちのこのアリデくんとシスコの二人組を描いてほしいです\n資料として、tumblrのリンクです（下に行くほど最近のものです）\nhttps://49heaven.tumblr.com/post/164784918137\nhttps://49heaven.tumblr.com/post/176431614052\nhttps://49heaven.tumblr.com/post/640936060644392960\nhttps://49heaven.tumblr.com/post/672257984377880576\nhttps://49heaven.tumblr.com/post/672258311696023552\n（これは見なくても大丈夫ですがふたりのあれこれを雑にメモしたものの一部です）\n（https://49heaven.blogspot.com/2022/04/blog-post_16.html）\n\nヘルメットの中に星があるのがアリデくんで、ヘルメットがバキバキなのがシスコです\n宇宙服・宇宙飛行士をベースにデザインしていますが、全く安定していないのでお好きにアレンジしていただいて大丈夫です（むしろ投げっぱなしですみません…）\nユルナイツのみなさんの体型というか体のラインがすきなので、等身が高い方で描いてもらいたいです…！\nスマホの待ち受けにして毎日眺めたいので、縦長だと嬉しいです…！\n（版権の話で恐縮ですが、エビコさんの描くキッドとキラーの距離感が大変すきなので、あんな感じの距離感だと喜びます…！）\nもし可能でしたらぜひよろしくお願いいたします！", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@abcodef/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1225334, "client_id": 1223544, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/2280f34d/uploads/origins/b7ce069e-ce48-46de-83d8-9af448a1a0b8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=cd3718ae0a5b032e2331e1c1348fdf98", "srcset": "https://si.imgix.net/2280f34d/uploads/origins/b7ce069e-ce48-46de-83d8-9af448a1a0b8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=cd3718ae0a5b032e2331e1c1348fdf98, https://si.imgix.net/2280f34d/uploads/origins/b7ce069e-ce48-46de-83d8-9af448a1a0b8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=d497935787e7267186abd74dae80086f 2x, https://si.imgix.net/2280f34d/uploads/origins/b7ce069e-ce48-46de-83d8-9af448a1a0b8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=36f3eda17297c11f2492a127d28582f2 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/2280f34d/uploads/origins/b7ce069e-ce48-46de-83d8-9af448a1a0b8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9043cfd1b1e8f7c7e703de17f900cf31", "srcset": "https://si.imgix.net/2280f34d/uploads/origins/b7ce069e-ce48-46de-83d8-9af448a1a0b8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9043cfd1b1e8f7c7e703de17f900cf31, https://si.imgix.net/2280f34d/uploads/origins/b7ce069e-ce48-46de-83d8-9af448a1a0b8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=0ecc600902758776465b0226d5efbfa4 2x, https://si.imgix.net/2280f34d/uploads/origins/b7ce069e-ce48-46de-83d8-9af448a1a0b8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=67ca51bd283d71bc13f3e92b1bbf34c9 3x"}, "body": "こんにちは。私はあなたのアートスタイルが本当に好きです。\nジャック・オー・ランタン」と「ジャックと豆の木」をモチーフにしたモンスター、ジャックを描いていただけませんか？\n-頭は両刃の斧です。\n-その胸は、上下に分離可能なカボチャのランタンです。\n-腕は2本あるが足はなく、宙に浮いている。\n-夜、周囲を照らすために、いつもランタンを使っています。\n-腕の竜骨も植物の茎で包まれている。\n\nできれば、夜の森でランタンを持っていてほしいです。ありがとうございました。\n\nhttps://drive.google.com/drive/folders/1GK3n8f_7yjK00dJHh4KkYXLm41uhtGqU?usp=sharing\n\nhttps://drive.google.com/drive/folders/1GK3n8f_7yjK00dJHh4KkYXLm41uhtGqU?usp=sharing", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@abcodef/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1225334, "client_id": 1287611, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/402a9942/uploads/origins/68ee996e-a736-4b0e-a77f-760eabca83af?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a30ba15c0a448447c404b0dc07d39c7e", "srcset": "https://si.imgix.net/402a9942/uploads/origins/68ee996e-a736-4b0e-a77f-760eabca83af?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a30ba15c0a448447c404b0dc07d39c7e, https://si.imgix.net/402a9942/uploads/origins/68ee996e-a736-4b0e-a77f-760eabca83af?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=1376c260186ba9305425cc9fe8382710 2x, https://si.imgix.net/402a9942/uploads/origins/68ee996e-a736-4b0e-a77f-760eabca83af?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e43d1d84e4080ab657649ef1aa0975c2 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/402a9942/uploads/origins/68ee996e-a736-4b0e-a77f-760eabca83af?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9ecbcf5445158d84f7f33c14f70d584f", "srcset": "https://si.imgix.net/402a9942/uploads/origins/68ee996e-a736-4b0e-a77f-760eabca83af?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9ecbcf5445158d84f7f33c14f70d584f, https://si.imgix.net/402a9942/uploads/origins/68ee996e-a736-4b0e-a77f-760eabca83af?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=a75e5e2888d14264d471e3e7f6fe9f71 2x, https://si.imgix.net/402a9942/uploads/origins/68ee996e-a736-4b0e-a77f-760eabca83af?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=833b2b6517cdeab9a511133bda1b38a4 3x"}, "body": "こんにちは！\nエビコさんのイラストがとても好きです。もし宜ければ、私のオリジナルキャラクターを描いて頂きたいと思いご依頼させて頂きました。\n野獣のような目を持ち、服装や身なりはインディアンスタイルの22歳前後の青年だ。少し朴訥で、あまり笑わない真面目な人です。\n杖を持ち、弓狩りや短刀を使う狩猟者である。\n構図を指定せず、自由に描いてください。\nご検討よろしくお願いします。\n\n資料は下記URLよりご確認ください：\nhttps://drive.google.com/drive/folders/1AQES6pxIuvj8FZgG4yzNlkl1Vm-ZQmPF?usp=sharing", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@abcodef/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1225334, "client_id": 2162782, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/98cc0d4f/uploads/origins/bb18013f-5207-4a3c-b279-23ee9b298c88?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5fc5d6bbcb11e90460eebbd9ab217353", "srcset": "https://si.imgix.net/98cc0d4f/uploads/origins/bb18013f-5207-4a3c-b279-23ee9b298c88?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5fc5d6bbcb11e90460eebbd9ab217353, https://si.imgix.net/98cc0d4f/uploads/origins/bb18013f-5207-4a3c-b279-23ee9b298c88?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=53983570ea3d29e0cbe41a2431884d48 2x, https://si.imgix.net/98cc0d4f/uploads/origins/bb18013f-5207-4a3c-b279-23ee9b298c88?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=2beaa420793684f08529279d0d134a9d 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/98cc0d4f/uploads/origins/bb18013f-5207-4a3c-b279-23ee9b298c88?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0fdca0c8765ca03584cff36facc62b85", "srcset": "https://si.imgix.net/98cc0d4f/uploads/origins/bb18013f-5207-4a3c-b279-23ee9b298c88?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0fdca0c8765ca03584cff36facc62b85, https://si.imgix.net/98cc0d4f/uploads/origins/bb