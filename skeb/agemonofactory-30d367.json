fit=crop&crop=top&w=200&h=200&blur=200&s=d170d9028193c736f2d0e13e26ec11d2", "srcset": "https://si.imgix.net/eadf8f22/uploads/origins/499780dd-fb45-4dda-94b0-cd8c3f337275?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d170d9028193c736f2d0e13e26ec11d2, https://si.imgix.net/eadf8f22/uploads/origins/499780dd-fb45-4dda-94b0-cd8c3f337275?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=94b21f4d646092e6fad56ab085a966da 2x, https://si.imgix.net/eadf8f22/uploads/origins/499780dd-fb45-4dda-94b0-cd8c3f337275?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=236f02f2aef039afff1b9a793ab2e0d5 3x"}, "body": "初めましてからあげファクトリー様\n私創作男女カップルのこがくぜを描いてもらいたいです。\n参考資料:https://drive.google.com/drive/folders/1va8JPdiV_C73tCz4CJ6mHvIlxeXNC__I\n不明瞭な部分については捏造、簡略化していただいて構いません。\n\nウェディングドレスを着た黄金(ブーケを持っている)とタキシードを着た久世がふたりが笑顔で並んでいる構図でお願いたします。\nウェディングドレスとタキシードのデザイン、ヘアアレンジ等は資料内の衣装でも、からあげファクトリー様のセンスでデザインいただくのも、どちらも歓迎です。\n\n使用用途\n・アイコンやヘッダー等の使用\n・参考資料としての使用\n\n金額に不足ありましたらお気軽に再送要請ください\n\nhttps://drive.google.com/drive/folders/1va8JPdiV_C73tCz4CJ6mHvIlxeXNC__I", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@agemonofactory/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3406372, "client_id": 3436783, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/1853ca4e/uploads/origins/4bafe7a1-32c5-40c5-b1d3-165a41b69dde?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=283733464f939a11402015c3683e6ecb", "srcset": "https://si.imgix.net/1853ca4e/uploads/origins/4bafe7a1-32c5-40c5-b1d3-165a41b69dde?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=283733464f939a11402015c3683e6ecb, https://si.imgix.net/1853ca4e/uploads/origins/4bafe7a1-32c5-40c5-b1d3-165a41b69dde?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=1790b13ec053ae43abe38e51132a2995 2x, https://si.imgix.net/1853ca4e/uploads/origins/4bafe7a1-32c5-40c5-b1d3-165a41b69dde?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c7286b6578a700eb6d937c066eabc00f 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/1853ca4e/uploads/origins/4bafe7a1-32c5-40c5-b1d3-165a41b69dde?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=bf7e84158890f63cbc944dd16ff12304", "srcset": "https://si.imgix.net/1853ca4e/uploads/origins/4bafe7a1-32c5-40c5-b1d3-165a41b69dde?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=bf7e84158890f63cbc944dd16ff12304, https://si.imgix.net/1853ca4e/uploads/origins/4bafe7a1-32c5-40c5-b1d3-165a41b69dde?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=0312163ea852c15b6cbfca81244332f2 2x, https://si.imgix.net/1853ca4e/uploads/origins/4bafe7a1-32c5-40c5-b1d3-165a41b69dde?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=88f104362a904c4ef3865c02d08fb5cd 3x"}, "body": "胸ぐらを掴まれた夕ナ卜がループタイを相手の小指に結ぶ作品をお願いいたします。\n\n《夕ナ卜 / 橋本 夕（ハシモト ユウ）》\n【容姿、性格】\n髪、瞳、肌は灰色。つり目つり眉。口内は黒。\n瞳孔が散大している。睫毛、下睫毛が長い。\n瞳のハイライトがうるさいほどに眩しい。\n無性、内臓がなく、血は虹色。\nループタイを着けたオシャンな服装。\n大体フィクション、紙ペラ以下の存在。\n「運命」という単語を好んで使うが、運命自体を好むわけではない。むしろ響きを茶化している。\n誰かの特別（運命）になりたがり、そのくせ自分の特別（運命）は作らない。\n何事においても集中力がない。話し掛けられている最中でも別のことに興味を持つし、その物事もしている間に飽きてくる。\n\n【場面】\n何かしらで誰かを怒らせた、はず。特段興味はなかったので忘れた。\n胸ぐらを掴まれた、ので視界に相手の指が入った。\nせっかくだし巻き付けてみることにした。\n\n【構図、表情】\n胸ぐらを掴む側視点。\n近距離。睫毛の煌めきが見えるほど。\n自身の小指に結び付けられた赤いループタイが見える。運命ごっこの対象にされたようだ。\n視線は完全にこちらを捉えている。強く開かれた瞳孔に怒る気力も吸い込まれてしまいそう。\nヘラりと笑う。真面目に話を聞いてもいないし、結んだことにも徐々に飽き始めている。\n「ごめん聞いていなかった、何？」などと問いかけてくるが、答えを求めているわけではないらしい。\n\nhttps://xfolio.jp/portfolio/AisaiNyawo/series/2434757", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@agemonofacto