bp&dpr=3&fit=crop&crop=top&w=200&h=200&s=85371188e90a59973adb8900a4d86a45 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/1ab57aa4/uploads/origins/43fbcbcb-05b6-43c7-b122-20707fa8ada6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3a7200752f0b688c15b88e7dc7d715e2", "srcset": "https://si.imgix.net/1ab57aa4/uploads/origins/43fbcbcb-05b6-43c7-b122-20707fa8ada6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3a7200752f0b688c15b88e7dc7d715e2, https://si.imgix.net/1ab57aa4/uploads/origins/43fbcbcb-05b6-43c7-b122-20707fa8ada6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=28cb91acd37ae8b4f677996bdb18ff1e 2x, https://si.imgix.net/1ab57aa4/uploads/origins/43fbcbcb-05b6-43c7-b122-20707fa8ada6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=36149d80abdeddb06c3e691a1b152c76 3x"}, "body": "始めまして、鍋ねこと申します。\n湯豆腐先生の絵にとても惹かれましたのでリクエストを送らせてもらいます\n\nワイシャシ一枚の琴葉葵さんをお願いします\nまた、ｺｯｼｮﾘ（裸猥シャツ）や下着有無の差分があればとても嬉しくございます。\n詳細な指定がないので悩ませる部分が多いかと思いますが、すけべな絵をお待ちしております故、ぜひともよろしく願いします。", "nc": 48, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@SparklingYudofu/works/16", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2916839, "client_id": 3723776, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/38f0ef81/uploads/origins/3e1aad3c-f66f-4fc6-a135-6c7e0976cc29?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=663873c00dac7f90754d2bf7d781858c", "srcset": "https://si.imgix.net/38f0ef81/uploads/origins/3e1aad3c-f66f-4fc6-a135-6c7e0976cc29?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=663873c00dac7f90754d2bf7d781858c, https://si.imgix.net/38f0ef81/uploads/origins/3e1aad3c-f66f-4fc6-a135-6c7e0976cc29?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=aa5c7b3538dae6a766e46ab8094d34cc 2x, https://si.imgix.net/38f0ef81/uploads/origins/3e1aad3c-f66f-4fc6-a135-6c7e0976cc29?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=4cd230dfcc4d61b1de750b60aee24d23 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/38f0ef81/uploads/origins/3e1aad3c-f66f-4fc6-a135-6c7e0976cc29?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=99de76ee903f767f9678e906d70a3bf2", "srcset": "https://si.imgix.net/38f0ef81/uploads/origins/3e1aad3c-f66f-4fc6-a135-6c7e0976cc29?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=99de76ee903f767f9678e906d70a3bf2, https://si.imgix.net/38f0ef81/uploads/origins/3e1aad3c-f66f-4fc6-a135-6c7e0976cc29?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=e0bec445bedcb00043e1992b12011841 2x, https://si.imgix.net/38f0ef81/uploads/origins/3e1aad3c-f66f-4fc6-a135-6c7e0976cc29?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=f20d2f9cdad2b210118dad004e7c355f 3x"}, "body": "劇場動画のような芝居で童話『不思議の国のアリス』のアリスの役を演じている紡乃世詞音（左向き、アリスっぽい衣装）と、その紡乃世詞音に大きな撮影用カメラを向けている双葉湊音（右向き、公式衣装）の2カット（左右2コマ）のイラストをお願いします。\n\n場面・シチュエーションとしましては、「涙の池(\"Pool of Tears\")」の場面でアリスに扮した紡乃世詞音が号泣して涙で水たまりを作っているのをカメラ越しに双葉湊音がドキドキしながら見つめている…という謎のシチュエーションです。\n\n紡乃世詞音の涙の表現は若干オーバー寄り（ギャグっぽく噴水もしくは滝のような涙）だと個人的にめちゃくちゃ喜びますが…湯豆腐様にお任せ致します！\n\n以上になります。可能でしたら描いていただけると嬉しいです…！よろしくお願いいたします！！", "nc": 33, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@SparklingYudofu/works/15", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2916839, "client_id": 768267, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/58fa52fa/uploads/origins/ee1c1f0d-0e92-4791-be3c-86a2f66bfcf3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=753f74a73b91595b625c4a011614e71c", "srcset": "https://si.imgix.net/58fa52fa/uploads/origins/ee1c1f0d-0e92-4791-be3c-86a2f66bfcf3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=753f74a73b91595b625c4a011614e71c, https://si.imgix.net/58fa52fa/uploads/origins/ee1c1f0d-0e92-4791-be3c-86a2f66bfcf3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=bc0463c6890f505cce4d50b2179c329a 2x, https://si.imgix.net/58fa52fa/uploads/origins/ee1c1f0d-0e92-4791-be3c-86a2f66bfcf3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=08a9d078f25201cf7589267322ca92e6 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/58fa52fa/uploads/origins/ee1c1f0d-0e92-4791-be3c-86a2f66bfcf3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=7ccd2e7693ae6e45a396d64a356f9485", "srcset": "https://si.imgix.net/58fa52fa/uploads/origins/ee1c1f0d-0e92-4791-be3c-86a2f66bfcf3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=7ccd2e7693ae6e45a396d64a356f9485, https://si.imgix.net/58fa52fa/uploads/origins/ee1c1f0d-0e92-4791-be3c-86a2f66bfcf3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=b5086c0838e198f0c22416e26b87ea7f 2x, https://si.imgix.net/58fa52fa/uploads/origins/ee1c1f0d-0e92-4791-be3c-86a2f66bfcf3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=2749305adc84f03b8d7c102773fc9c13 3x"}, "body": "紡乃世詞音ちゃんが超常現象で突然10歳から16歳に急成長してしまう、というシチュエーションのイラストを描いていただきたいです。\n参考URL[1]や[2]のように、1枚のイラストに変身前の姿と変身後の姿を両方描き、それらを矢印で繋ぐ形式でお願いします。変身前の華奢な体つき・あどけない顔つき・サイズに余裕のある服と、変身後のムチムチな体つき・大人に近づいた顔つき・パツパツな服を見比べてギャップを楽しみたいです！\n\n【ビジュアル】\n・変身前\n設定画通りの服装・体格・顔つき・髪型の「紡乃世詞音(蕾)」\n身長135.5cm\nカバンは不要\n全身がムズムズするのを感じ、困惑している\n\n・変身後\n身長（157.7cm）や体格・顔つきは16歳の詞音ちゃんのもので、服（帽子や髪飾り含む）のデザインとサイズは「紡乃世詞音(蕾)」のもののまま\n髪型は「蕾」のもののまま\n精神年齢や意識・性格は10歳のまま\n参考URL[3]のように、服のサイズが合わずパツパツになっている（大きく膨らんだ胸でシャツが埋め尽くされている、身長が伸びたことでお腹が露出している、大きく膨らんだ尻と太ももがズボンにギチギチに詰まっている）\n参考URL[4][5]のキャラのように、少し苦しそうな表情で嬌声を漏らしている（急な体の成長により、痛みのような快感のような不思議な感覚を味わっている）\n精神年齢は10歳のままなので、お腹丸出しの恰好を恥ずかしがったりはしていない\n身長や腕・指が伸びる様子、胸や尻や太ももが膨らむ様子を「ぐんっ」「すらあっ」「むくむく」などのような擬音で表現\n\n【その他の要望】\n・表情や声はアヘ顔・オホ声のような感じにならないよう注意していただけますと有難いです。\n・背景は無くても構いません。\n\n【参考URL】\n[1]　https://pixiv.net/i/76735466\n[2]　https://pixiv.net/i/87704649\n[3]　https://pixiv.net/i/99351991\n[4]　https://x.com/Spetsnaz10032/status/1819863165544600003\n[5]　https://x.com/Spetsnaz10032/status/1822246445560246296", "nc": 49, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@SparklingYudofu/works/14", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2916839, "client_id": 37757, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/10000e61/uploads/origins/0a5bb3df-fe91-4643-97b7-c7406d24d17c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ef4322f065fe4165a48cb7fe92196687", "srcset": "https://si.imgix.net/10000e61/uploads/origins/0a5bb3df-fe91-4643-97b7-c7406d24d17c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ef4322f065fe4165a48cb7fe92196687, https://si.imgix.net/10000e61/uploads/origins/0a5bb3df-fe91-4643-97b7-c7406d24d17c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=d67f0754613f624d376e72035983bab4 2x, https://si.imgix.net/10000e61/uploads/origins/0a5bb3df-fe91-4643-97b7-c7406d24d17c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a1f7b63adda5273d60d8a5d01eb6a905 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/10000e61/uploads/origins/0a5bb3df-fe91-4643-97b7-c7406d24d17c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2612abf00db5f310554ba944497db9da", "srcset": "https://si.imgix.net/10000e61/uploads/origins/0a5bb3df-fe91-4643-97b7-c7406d24d17c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2612abf00db5f310554ba944497db9da, https://si.imgix.net/10000e61/uploads/origins/0a5bb3df-fe91-4643-97b7-c7406d24d17c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=0e2ec6ea42d7925fb734e8e7d0f40644 2x, https://si.imgix.net/10000e61/uploads/origins/0a5bb3df-fe91-4643-97b7-c7406d24d17c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=5d05d6be32c653b63eb1e6fccb40079d 3x"}, "body": "いつもぼでお世話になっております。\n\nLimbusCompanyというゲームの「E.G.O/ホンル/桃色の欲望」(わかりにくくて申し訳ありませんがキャラクターの装備のようなもの)を着用した紡乃世詞音をよろしくお願いします。\n服装自体はA.I.VOICE衣装のままで、桃色のハイヒールを着用し桃色のリボンが上記のキャラクターのように絡みついて、蕩けたような笑顔を浮かべている姿でよろしくお願いします", "nc": 48, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@SparklingYudofu/works/13", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2916839, "client_id": 2801967, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/67370bcd/uploads/origins/b12a0bf6-7263-463a-aa2d-8af243746e34?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bcd7e91768eae0d039a58e78cef53002", "srcset": "https://si.imgix.net/67370bcd/uploads/origins/b12a0bf6-7263-463a-aa2d-8af243746e34?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bcd7e91768eae0d039a58e78cef53002, https://si.imgix.net/67370bcd/uploads/origins/b12a0bf6-7263-463a-aa2d-8af243746e34?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=6197ad9647563bcf9a345345db257b87 2x, https://si.imgix.net/67370bcd/uploads/origins/b12a0bf6-7263-463a-aa2d-8af243746e34?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=904a95f29b3e6b7bb82647014608c00c 3x"}, "duration": null, "nsfw": true, "hardco