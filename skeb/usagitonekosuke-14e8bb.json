igins/39f3991b-bb99-4057-a192-28836c53c609?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5ac863339fbf0c4e147af2ffcf9969da, https://si.imgix.net/a5ec122d/uploads/origins/39f3991b-bb99-4057-a192-28836c53c609?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=50cdeff1152c5a9536ca5dc467293da6 2x, https://si.imgix.net/a5ec122d/uploads/origins/39f3991b-bb99-4057-a192-28836c53c609?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=10bf4cc2ca1abebe087bafa2e84ac2e3 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/a5ec122d/uploads/origins/39f3991b-bb99-4057-a192-28836c53c609?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=75a1aae0848c5b28d1553bc3bec5940a", "srcset": "https://si.imgix.net/a5ec122d/uploads/origins/39f3991b-bb99-4057-a192-28836c53c609?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=75a1aae0848c5b28d1553bc3bec5940a, https://si.imgix.net/a5ec122d/uploads/origins/39f3991b-bb99-4057-a192-28836c53c609?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=f724ea9858a173242a5929c32661733a 2x, https://si.imgix.net/a5ec122d/uploads/origins/39f3991b-bb99-4057-a192-28836c53c609?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=2e2cab128eda4219678a81f9e914c4e7 3x"}, "body": "はじめまして。LINEスタンプでうさぎとねこすけ見つけてからタカさんの大ファンになりました。スケブを描いて頂けましたらとても嬉しいです。\n\nウェディングの記念写真の様に2人(?)並ぶうさぎとねこすけを希望です。うさぎにウェディングベールをかぶせてブーケを持たせ、ねこすけにはブートニアを着けてタキシード代わりにベストを羽織らせて欲しいです。\n\n毎日、うさぎとねこすけのスタンプで婚約者と遊んでいるので記念にしたいと考えております。これからも応援しておりますので新作を楽しみにお待ちしています。暑いので身体に気を付けてお過ごしください。よろしくお願いします。", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@usagitonekosuke/works/2", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/70592d88/uploads/origins/f0d0b79d-a722-45f8