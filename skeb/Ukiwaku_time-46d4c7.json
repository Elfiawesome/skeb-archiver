思っており、ペットに同じ愛称を付けているし相談ごとがあれば一番に頼る。ヴィルヘルムもウォルターの予想がつかない行動を好ましく感じており、出来る限り力になろうと思っている。\n\nhttps://drive.google.com/drive/folders/1ofkGk9BQTAYRwEs99asgPS1W_AvH54Se", "nc": 153, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@snmncomm/works/15", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3859258, "client_id": 3583546, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/da82c281/uploads/origins/2f63221e-140b-4419-9ea2-321df3a66934?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=afd6013048b43e4244f17735e9d3ca16", "srcset": "https://si.imgix.net/da82c281/uploads/origins/2f63221e-140b-4419-9ea2-321df3a66934?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=afd6013048b43e4244f17735e9d3ca16, https://si.imgix.net/da82c281/uploads/origins/2f63221e-140b-4419-9ea2-321df3a66934?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a2e47457d1e8958c759a077217231ddb 2x, https://si.imgix.net/da82c281/uploads/origins/2f63221e-140b-4419-9ea2-321df3a66934?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=3e3ef16b6161137aaed8d43b7c3e7b96 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/da82c281/uploads/origins/2f63221e-140b-4419-9ea2-321df3a66934?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=da367b804eb3dcf708252519dd03bf50", "srcset": "https://si.imgix.net/da82c281/uploads/origins/2f63221e-140b-4419-9ea2-321df3a66934?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=da367b804eb3dcf708252519dd03bf50, https://si.imgix.net/da82c281/uploads/origins/2f63221e-140b-4419-9ea2-321df3a66934?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=665fecd0eae1af7ff092e4e5a3f3be1b 2x, https://si.imgix.net/da82c281/uploads/origins/2f63221e-140b-4419-9ea2-321df3a66934?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=94d0b1248f50ba36fd0a0fabe41c3479 3x"}, "body": "はじめまして！\n今回はサンタモニカ様に私の探索者のデフォルメイラストを描いていただきたく、Skebを利用させていただきました。\n服装や表情、ポーズはお任せします！\n個人鑑賞以外では、アイコンとして使用する可能性があります。\nご縁がありましたらよろしくお願いします！\n\n以下、キャラ詳細です。外見の詳細は添付資料をご確認ください。\n\n名前：表現（おもて うつし）\n年齢：23歳\n身長：176cm\n容姿特徴：センターパートの銀髪・色白・薄い体・耳に幾つかのピアス・右目下にホクロ・紫のジャージ\n職業：漫画家（作画）\n性格：失礼で無神経で適当。世の中と人間をうっすらナメてるが、犯罪行為に手を染めるほどの悪人ではない。絵の才能はあるが話を作る能力は皆無。\n\nhttps://drive.google.com/drive/folders/1juG9WAX3YhmHhq9SYWZzMy-HaYuNySQ_", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@99R7ml/works/35", "private_thumbnail_image_urls": null, "private": false, "genre": "comic", "tipped": false, "creator_id": 3109586, "client_id": 3583546, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/d2b5ed98/uploads/origins/c7fffe1d-6dcd-4454-9e34-9a789ce98966?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a2576251f095555dca87424db741b5ae", "srcset": "https://si.imgix.net/d2b5ed98/uploads/origins/c7fffe1d-6dcd-4454-9e34-9a789ce98966?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a2576251f095555dca87424db741b5ae, https://si.imgix.net/d2b5ed98/uploads/origins/c7fffe1d-6dcd-4454-9e34-9a789ce98966?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=70b3c3b5032268960aaf65bb1135092f 2x, https://si.imgix.net/d2b5ed98/uploads/origins/c7fffe1d-6dcd-4454-9e34-9a789ce98966?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e2ec71cd68e86fb7c43b83e0233f2915 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/d2b5ed98/uploads/origins/c7fffe1d-6dcd-4454-9e34-9a789ce98966?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=fa1d1027f7ebe1c85c56489073407972", "srcset": "https://si.imgix.net/d2b5ed98/uploads/origins/c7fffe1d-6dcd-4454-9e34-9a789ce98966?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=fa1d1027f7ebe1c85c56489073407972, https://si.imgix.net/d2b5ed98/uploads/origins/c7fffe1d-6dcd-4454-9e34-9a789ce98966?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=2949294150398eeed0bf8ef1126e6447 2x, https://si.imgix.net/d2b5ed98/uploads/origins/c7fffe1d-6dcd-4454-9e34-9a789ce98966?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=a15c11cf4c88376981f45e7506ff7866 3x"}, "body": "はじめまして！今回はニナロッカーさまに自分と友人のOCの漫画を描いていただきたいと思い、Skebを利用させていただきました。\nテーマなどはお任せします！\n個人鑑賞以外の使用は予定していません。\nご縁がありましたらよろしくお願いします！\n\n以下、キャラ詳細です。外見の詳細は添付資料をご確認ください。\n\n一人目 名前：五百光明（いほ ひかり）\n年齢：35歳\n身長：185cm\n容姿特徴：瞼重め・濃い茶色の緩く癖のついた髪・黄色みの強い少し焼けた肌・鍛えられた体・シンプルなファッション\n職業：元舞台俳優、現タクシードライバー\n性格：大胆だが臆病な面もある。仕事に関しては真面目で努力家であり、周りにも厳しい。周りの人間からは人当たりが良く、あまり口数は多くないが親切な人間として評価されていた。本質的には閉鎖的な男。仕事中は人柄が良く見えるようにしているが、櫨畑と居る時は自然体で仏頂面な時が多い。\n一人称：「俺」 饒舌ではなく、気を抜いていると言葉も乱暴な時がある。\n\n二人目\n名前：櫨畑秋（はぜはた あき）\n年齢：享年33歳（生きていれば五百と同い年）\n身長：169cm\n容姿特徴：束感のある髪（色はコロコロ変わる）・丸メガネ・太く短い眉・そばかす・唇厚め・古着\n職業：劇作家 性格：物腰は基本的に柔らかいが、こだわりは非常に強い。デフォルトでニコニコとした表情をしており、冗談を言うことが多い。悩む時は頬が膨らむ。\n一人称：「ぼく」\n柔らかいタメ口。荒っぽい言葉は使わないが冗談はよく言う。\n\n二人の関係性：高校の演劇部に誘った（櫨畑）、誘われた（五百）というところから縁が続いている。普段は戯れ合う単なる男友達といった温度感。\n櫨畑の書いた作品には必ず五百がキャスティングされているが、主役を飾ったことはない。五百はそれを不安に思っているが踏み込んで聞くことができないでいたまま櫨畑が亡くなり、自身も俳優業を引退する。\nなんやかんやあり、櫨畑を生き返らせることに成功すると彼を自身の家に軟禁した。五百は櫨畑を手元に置いておきたいという気持ちが強く、櫨畑は困惑こそするものの拒みはしなかった。\nお互いに「ハゼ」「いほりん・五百くん」と呼び合っているが仕事の時は単に苗字呼び。\n\nhttps://drive.google.com/drive/folders/1jWdiFj3cvvrorpUfwjwS2HOQ5fN4hlAG", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@ysysgasuki/works/13", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 213169, "client_id": 3583546, "vtt_url": null, "thumbnail_image_urls": {"src": "http