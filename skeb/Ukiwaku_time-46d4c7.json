e8e/uploads/origins/ac20883d-f369-43f2-a905-5de7f71062e8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=5173b9b96ff79578d3b3264c227a68fe 2x, https://si.imgix.net/c69bde8e/uploads/origins/ac20883d-f369-43f2-a905-5de7f71062e8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b467043a31c0118c58caf54186f0a040 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/c69bde8e/uploads/origins/ac20883d-f369-43f2-a905-5de7f71062e8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=dd23fa63cc93a88ff85ed2d78e3e1793", "srcset": "https://si.imgix.net/c69bde8e/uploads/origins/ac20883d-f369-43f2-a905-5de7f71062e8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=dd23fa63cc93a88ff85ed2d78e3e1793, https://si.imgix.net/c69bde8e/uploads/origins/ac20883d-f369-43f2-a905-5de7f71062e8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=2648dea12dd019fa0204e78de5dc6a0d 2x, https://si.imgix.net/c69bde8e/uploads/origins/ac20883d-f369-43f2-a905-5de7f71062e8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=45ed68c9c4a21ff03a69fe3fa761fc83 3x"}, "body": "こんにちは！\nお存在パンさんの文章や物語の構成の仕方が好きなので、小説を描いていただきたくリクエストさせて頂きました！\n【内容】\nクトゥルフ神話TRPGの探索者の小説を依頼したいです。料金が見合わない場合は再送請求して頂けると助かります。\n\n人物1:八戸夏生\n性別:男年齢:21\n職業:大学生兼小説家\n一人称:僕 二人称:名前+くん、名前+ちゃん 三人称:あの人、名前+くん、名前+ちゃん\n性格:気楽。自称も他称も運が良い男。能天気で、麻雀のような運要素のある物を好む。口数が多く、口論になると引かない。諦めも悪く、自分がやりたい事に関しては突発的に行動をする。気分屋。\n口調:基本的にタメ口。物事を言い切る事が多い。屁理屈を捏ねることもある。\n\n人物2:野井寺 虎伯\n性別:男 \n年齢:39\n職業:記者\n一人称:私 二人称:あなた、苗字+さん 三人称:彼、彼女、苗字+さん\n性格:硬い。利己的で、特に面白そうな物事には周りの迷惑を考えず首を突っ込む悪癖がある。人の神経を逆撫でしたり煽ったりするのを趣味にしている。口はとても上手く、人をいいように使うのも得意。\n口調:ですます口調。興奮すると崩れる。冷めた言葉を返す事も多いが、人に指摘をする際は言葉数が多くなる。\n\n【関係性】\n八戸→野井寺\n自分にあまり興味を示さないし、ゴマすりや褒めることをしない面白い大人。危険なのもあまりいい人でないのも分かっているが、1度惹かれてしまった以上はどうしようもなく、様々な事に巻き込まれたりしている。\n\n野井寺→八戸\n使い勝手の良い駒。それとなく運はいいようなのでお守り代わりとして様々な場所に引き連れている。\n\n【内容】\n場所は国内外どこでもいいので、奇食をする話を書いてください。\n\nよろしくお願いします。", "nc": 1, "word_count": 1850, "transcoder": "text", "creator_acceptable_same_genre": true}], "sent_works": [{"path": "/@99R7ml/works/42", "private_thumbnail_image_urls": null, "private": false, "genre": "comic", "tipped": false, "creator_id": 3109586, "client_id": 3583546, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/81bdfb4e/uploads/origins/57e54ac6-72e9-40e6-b8f8-537ab118a7c2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e715d5b15b4b641364af2c64c1cd69ea", "srcset": "https://si.imgix.net/81bdfb4e/uploads/origins/57e54ac6-72e9-40e6-b8f8-537ab118a7c2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e715d5b15b4b641364af2c64c1cd69ea, https://si.imgix.net/81bdfb4e/uploads/origins/57e54ac6-72e9-40e6-b8f8-537ab118a7c2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=3851b9cd81e4ad1ca9ea7b8b9edc4991 2x, https://si.imgix.net/81bdfb4e/uploads/origins/57e54ac6-72e9-40e6-b8f8-537ab118a7c2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ed0a5a6b81eb67fcee4cd90f58937803 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/81bdfb4e/uploads/origins/57e54ac6-72e9-40e6-b8f8-537ab118a7c2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6f92697f098b75fba440e7cc338753a8", "srcset": "https://si.imgix.net/81bdfb4e/uploads/origins/57e54ac6-72e9-40e6-b8f8-537ab118a7c2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6f92697f098b75fba440e7cc338753a8, https://si.imgix.net/81bdfb4e/uploads/origins/57e54ac6-72e9-40e6-b8f8-537ab118a7c2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=16967c70f493d1288e52bd91f1c98134 2x, https://si.imgix.net/81bdfb4e/uploads/origins/57e54ac6-72e9-40e6-b8f8-537ab118a7c2?b