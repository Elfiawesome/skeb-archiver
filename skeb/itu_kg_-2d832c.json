c?usp=sharing\n\nリクエスト\n自由に描いてください！提案としては、水遊び（貝殻やシーグラス集めなど）をしているところや、海や庭で話をしているところなど。\n\nご配慮ありがとうございました！", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@itu_kg_/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3202712, "client_id": 1592117, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/e10a9876/uploads/origins/e038d942-5c5e-4c84-8223-179e3dcf5b2f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ab93823ec2513bfaf39c3bb64722a445", "srcset": "https://si.imgix.net/e10a9876/uploads/origins/e038d942-5c5e-4c84-8223-179e3dcf5b2f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ab93823ec2513bfaf39c3bb64722a445, https://si.imgix.net/e10a9876/uploads/origins/e038d942-5c5e-4c84-8223-179e3dcf5b2f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=d5962bed6b0c2abdac7d91175dd99895 2x, https://si.imgix.net/e10a9876/uploads/origins/e038d942-5c5e-4c84-8223-179e3dcf5b2f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=3f7ba92da97224ae79d646b271eddfd1 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/e10a9876/uploads/origins/e038d942-5c5e-4c84-8223-179e3dcf5b2f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=30e111628de4d903c6ca98c1f42ba0ab", "srcset": "https://si.imgix.net/e10a9876/uploads/origins/e038d942-5c5e-4c84-8223-179e3dcf5b2f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=30e111628de4d903c6ca98c1f42ba0ab, https://si.imgix.net/e10a9876/uploads/origins/e038d942-5c5e-4c84-8223-179e3dcf5b2f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=5956fe9c9f065e2ca6bd3901a3096d90 2x, https://si.imgix.net/e10a9876/uploads/origins/e038d942-5c5e-4c84-8223-179e3dcf5b2f?bg