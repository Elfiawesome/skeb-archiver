7, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@aoyagi630630/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3491448, "client_id": 2650505, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/2ec2af1f/uploads/origins/936e4449-2850-46d0-b791-ff561f894a17?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7cd5a7e9896354512832931412cd454b", "srcset": "https://si.imgix.net/2ec2af1f/uploads/origins/936e4449-2850-46d0-b791-ff561f894a17?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7cd5a7e9896354512832931412cd454b, https://si.imgix.net/2ec2af1f/uploads/origins/936e4449-2850-46d0-b791-ff561f894a17?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=d08ec85ef1779d81d233988ba65c94cd 2x, https://si.imgix.net/2ec2af1f/uploads/origins/936e4449-2850-46d0-b791-ff561f894a17?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f42fa77adf48b8f2529c676c47948253 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/2ec2af1f/uploads/origins/936e4449-2850-46d0-b791-ff561f894a17?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b92b1e65fd7daecefc76696a45cb9668", "srcset": "https://si.imgix.net/2ec2af1f/uploads/origins/936e4449-2850-46d0-b791-ff561f894a17?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b92b1e65fd7daecefc76696a45cb9668, https://si.imgix.net/2ec2af1f/uploads/origins/936e4449-2850-46d0-b791-ff561f894a17?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=e504340b8d8a18a26511b0b60afa13ff 2x, https://si.imgix.net/2ec2af1f/uploads/origins/936e4449-2850-46d0-b791-ff561f894a17?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=b64dc777105022ba11260a7db5b32c64 3x"}, "body": "あおね様、はじめまして！\n以前からXでひっそりイラスト拝見しており、ぜひあおね様の絵で私のocが見たいと思っていたのでskebを開いてくださりとても嬉しいです！\n以下はリクエスト内容です。\n\n【内容】\n私のオリジナルキャラクターのバストアップイラストをお願いしたいです！\n資料のキャラクターから気に入った子を描いていただければと思います…！\nキャラクターの設定は資料にまとめてありますが、人選は先生にお任せします。\n\nhttps://x.com/aoyagi630630/status/1896161061465989501?s=61&t=tJ8eJfE6W7CuO5HCrcRFLQ\n\nhttps://x.com/aoyagi630630/status/1849392117699010814?s=61&t=tJ8eJfE6W7CuO5HCrcRFLQ\n上の投稿のような、花と共に描かれる女の子たちが好きなので、花と共にカラフルに仕上げてくだされば幸いです！\nラフやアイデアスケッチなどもあればデータをいただきたいです。\n\n【利用目的】\nSNSのアイコン、壁紙など。一緒に話を作りあげている友人にも共有するつもりです。\nまた、非商用・個人利用の範囲内でいただいたイラストでグッズを作るかもしれません。頒布・販売はしませんが、こちらも一緒に遊んでくれている人には共有するつもりです。こちらに関して難しければ再送要請をいただきたいです…🙇\nラフやアイデアスケッチなどは私が見てニコニコします。\n\n【資料】\nhttps://drive.google.com/drive/folders/1-59gU9Nv9P4w3I3yTT5_3HzXUajm50Eb\nキャラクターの持つ雰囲気やイラストに取り入れてほしいキーワードをそれぞれいくつかまとめてありますが、あくまで参考です…！どれかしら取り入れても、全く取り入れなくても大丈夫です。\n\n先生の描かれる柔らかで可憐な女の子、引き込まれる色使いがとても大好きです！受けていただければ幸いです！\n\nhttps://drive.google.com/drive/folders/1-59gU9Nv9P4w3I3yTT5_3HzXUajm50Eb", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@aoyagi630630/works/2", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/28cce4e7/uploads/origins/76bae679-86b3-4387-993a-9de2bcc1c7f2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=edc94e457cc8db434f6f23fc231588af", "srcset": "https://si.imgix.net/28cce4e7/uploads/origins/76bae679-86b3-4387-993a-9de2bcc1c7f2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=edc94e457cc8db434f6f23fc231588af, https://si.imgix.net/28cce4e7/uploads/origins/76bae679-86b3-4387-993a-9de2bcc1c7f2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=75b23