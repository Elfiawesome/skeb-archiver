ポーズ】\n仰向けで寝転んでいるPに寄り添い、太腿コキをしてあげる楓さん。\n※ベッドでも事務所のソファでも何でも可です。\n※以下細かい指定書いてますが描きやすい様に改変可です！\n\n高垣楓はPの隣に添い寝するようにくっついていて、片足をPの股間に伸ばし、膝を閉じて竿をふくらはぎと太腿で挟んでいる。着ているニットがずり上がってお尻が見えている状態。\n片手は亀頭に伸ばしていて、指先で亀頭を弄っている。\n顔は亀頭を愛おしそうに見つめていて興奮している表情。\n\n【服装/見た目】\n・麗しの妙薬の特訓前の衣装着用\n・ベージュのストッキング着用\n\nhttps://imas.gamedbs.jp/cg/idol/detail/96?h=53c92b0160cbf7e0f2fd0aa4083f6628", "nc": 177, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@V_egabond/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1593013, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/3b9ac739/uploads/origins/37924152-c125-4330-b0cb-c14d3483a8da?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6c056294921a18e4f180203159f4338f", "srcset": "https://si.imgix.net/3b9ac739/uploads/origins/37924152-c125-4330-b0cb-c14d3483a8da?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6c056294921a18e4f180203159f4338f, https://si.imgix.net/3b9ac739/uploads/origins/37924152-c125-4330-b0cb-c14d3483a8da?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f58c2d79d6b77fc530a52802b2330604 2x, https://si.imgix.net/3b9ac739/uploads/origins/37924152-c125-4330-b0cb-c14d3483a8da?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f7959b4a850860d764e41f0816066e6b 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/3b9ac739/uploads/origins/37924152-c125-4330-b0cb-c14d3483a8da?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=df2ee707db0b440001ff4c8497220c2c", "srcset": "https://si.imgix.net/3b9ac739/uploads/origins/37924152-c125-4330-b0cb-c14d3483a8da?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=df2ee707db0b440001ff4c8497220c2c, https://si.imgix.net/3b9ac739/uploads/origins/37924152-c125-4