07ebf4f7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=59107873400c8a3c47d14c0d5adbaff2 2x, https://si.imgix.net/39f3c151/uploads/origins/4848c7b9-6de2-4f1d-9a52-b9a607ebf4f7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=64f983596ed38929756628bc5cb4ac86 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/39f3c151/uploads/origins/4848c7b9-6de2-4f1d-9a52-b9a607ebf4f7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=1525d61d7d3f7a6cf3dbbd31467988db", "srcset": "https://si.imgix.net/39f3c151/uploads/origins/4848c7b9-6de2-4f1d-9a52-b9a607ebf4f7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=1525d61d7d3f7a6cf3dbbd31467988db, https://si.imgix.net/39f3c151/uploads/origins/4848c7b9-6de2-4f1d-9a52-b9a607ebf4f7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=d824f679e6d76c066f67954d8631ac20 2x, https://si.imgix.net/39f3c151/uploads/origins/4848c7b9-6de2-4f1d-9a52-b9a607ebf4f7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=602818298fc28d53b896a09a9d74ef88 3x"}, "body": "初めて依頼します。\nいつもsissy系の作品楽しく読ませていただいてます。\nsissyと赤ちゃんプレイを組み合わせた作品を依頼したいです。\n\nシチュエーション\nベッドで妻を満足させられなかったため女ホルモンでメスにされた男の娘が、女の子の赤ちゃんの真似を強要させられる。\nママ(元妻)が他の男を家に連れてきてセックスするから、いつもより早い夕方の6時に寝かされる。\n素直に言うことを聞いていい子にしてたら行為中の音を聞かせてあげると言われる。\n\n詳細\n女児が着るようなピンクのひらひらしたドレスを着せられる。\nドレスの丈が短くおむつが見える。\nおむつはピンクで海外アニメのプリンセスのイラストが描かれてる。\n許可された時以外はおしゃぶりをしゃぶらされる。\n常にピンクのアナルプラグを入れられる。\nピンクの貞操帯を装着させられる。", "nc": 57, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@ryokutya25/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 410501, "client_id": 401919, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/a571543c/uploads/origins/e348fb9a-6e