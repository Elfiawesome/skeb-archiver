200&h=200&blur=200&s=efbb69bf40e6b7f8c64eb0f49cf03d55, https://si.imgix.net/2d4f9a6b/uploads/origins/d488e2eb-749d-4bab-bba4-389173691ec2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=1b6d6cc12712d71a75dc89edab082caa 2x, https://si.imgix.net/2d4f9a6b/uploads/origins/d488e2eb-749d-4bab-bba4-389173691ec2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=1575607498b4a1c2bd50f9079992f471 3x"}, "body": "こんにちは、\n\nはじめまして。\n\nあなたの画風が好きなので、リクエストさせてください。\n\n髪の長い金髪の裸の女の子をアップで描いてほしいです。胸は中くらいの大きさです。彼女は口を大きく開けて興奮した私を見ている。舌を出し、喉をできるだけ大きく開いている。彼女は舌の裏をU字型にし、私の指が彼女の舌の上に置かれたまま喉の奥に触れる。彼女の口蓋垂は丸見えだ。彼女はそれがとても気に入ったようで、顔を赤らめている。彼女は両手で私の手を握っている。\n\n女の子のデザインはお任せします。\n\nありがとうございました。", "nc": 177, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@utatata_ututu/works/13", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1901861, "client_id": 452066, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/2a907c21/uploads/origins/e605a24a-8816-4c75-9221-7ec5249ec584?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0571a68316c3295f6f9c59493e8eabf5", "srcset": "https://si.imgix.net/2a907c21/uploads/origins/e605a24a-8816-4c75-9221-7ec5249ec584?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0571a68316c3295f6f9c59493e8eabf5, https://si.imgix.net/2a907c21/uploads/origins/e605a24a-8816-4c75-9221-7ec5249ec584?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=8fd4c99fcb8093498cfb7a5ca9da1c3e 2x, https://si.imgix.net/2a907c21/uploads/origins/e605a24a-8816-4c75-9221-7ec5249ec584?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d5248da969429f98b01d8458da270eeb 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/2a907c21/uploads/origins/e605a24a-8816-4c75-9221-7ec5249ec584?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=7442060d96fa1bb5efc6d6454b0dab83", "srcset": "https://si.imgix.net/2a907c21/uploads/origins/e605a24a-8816-4c75-9221-7ec5249ec584?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=7442060d96fa1bb5efc6d6454b0dab83, https://si.imgix.net/2a907c21/uploads/origins/e605a24a-8816-4c75-9221-7ec5249ec584?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=c565e08d9b4255f1766ee11b1207c081 2x, https://si.imgix.net/2a907c21/uploads/origins/e605a24a-8816-4c75-9221-7ec5249ec584?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=d91751a1ce2f7f987f61ef595d9c00db 3x"}, "body": "お初にお目にかかります。\nひょっとこフェラ絵に惹かれました。\n特にこちら（https://skeb.jp/@utatata_ututu/works/11）がとても素敵です…\n“またんごむちゃん”というキャラクターをリク致します。\nご検討いただければ幸いです。\n\n【キャラ参考】\n・https://www.pixiv.net/artworks/77933600\n・https://twitter.com/superganglion/status/1221116225444438017?s=20\n\n【主な特徴】\n・スレンダー美脚\n・痩身、細身（肋骨が浮く感じ、胸はそこまで大きくない）\n・切れ長のつり目がち\n・目元が不健康そう（【重要】クマあり）\n※髪型アレンジOK…ヘアピンを着けない場合、コーディネートのどこかに“だんごむし”意匠をお願いします。\n\n【構図・シチュ等】\n●竿役の正面に跪く主観ノーハンドフェラ\n※こちら（https://www.pixiv.net/artworks/112942163）のP.5以降のようなイメージ\n・主観視点だが、またんごむちゃんのふとももがしっかり見えるようなしゃがみ方…ふともも大好きなので…\n・またんごむちゃんの両手は竿役の内腿をすりすり撫で回している\n・竿役のおちんぽは長くてカリ高であるほど素敵です\n・唇をカリ首にいっぱい引っかけて鼻の下伸びている感じ\n・しっかり頬すぼめるひょっとこフェラ\n・目に♡浮かべた上目遣い\n・余裕ありげに笑んで少し細めている目元\n\n【服装等】\n●マイクロビキニ\n・ニーソ\n・長手袋\n・ピアス要素\n\n\n†またんごむちゃんに叡智あれ†\n\nhttps://www.pixiv.net/artworks/112942163", "nc": 33, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@utatata_ututu/works/12", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/55448611/uploads/origins/2ba4d088-dc00-429d-892e-1bc657464158?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=42daedc2c788f17426b