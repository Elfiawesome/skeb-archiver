a72904cd/uploads/origins/547a8a44-81aa-45a8-bd2b-0c851cac45bf?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=eee0d6133445e14f7979c02a7b09daa4, https://si.imgix.net/a72904cd/uploads/origins/547a8a44-81aa-45a8-bd2b-0c851cac45bf?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=7b3d4d96869aee4aeff3153ccf52da76 2x, https://si.imgix.net/a72904cd/uploads/origins/547a8a44-81aa-45a8-bd2b-0c851cac45bf?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=f515081e1d489cf40086501fa92772d0 3x"}, "body": "勝田範彦が乗っていたラック名古屋スバルWRX（VAB）グラベル車とブルアカのティーパーティーの合わせを書いて欲しいです。セイアがドライバー側、ナギサがコ・ドライバー側、ミカが天井に寝そべる形でお願いします。3人とも通常衣装でポーズと背景はお任せ致します。車は前面とサイドが見えるような形で、ホイールが見えるようハンドルを切って下さい。リアドアのネームステッカーはドライバーがセイアの名前、コ・ドライバーがナギサの名前を入れれたら入れて頂きたいです。ボンネットにはライトポッド付きだととても嬉しいです。\n参考程度に車の外観がわかるサイトがございましたので共有致します。\nhttps://share.google/PMwYfJYYEgH1IXTZ7\n長文で申し訳ございませんが、宜しくお願い致します。\n\nhttps://share.google/PMwYfJYYEgH1IXTZ7", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@abekobenanda/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3400882, "client_id": 3309560, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/fc6f555f/uploads/origins/d5534543-b78c-4434-8d8a-a9ef4729fe5c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3f31675d877d3237fa9e9908d671372f", "srcset": "https://si.imgix.net/fc6f555f/uploads/origins/d5534543-b78c-4434-8d8a-a9ef4729fe5c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3f31675d877d3237fa9e9908d671372f, https://si.imgix.net/fc6f555f/uploads/origins/d5534543-b78c-4434-8d8a-a9ef4729fe5c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=d881ce1d4527101945df0580ea15ae67 2x, https://si.imgix.net/fc6f555f/uploads/origins/d5534543-b78c-4434-8d8a-a9ef4729fe5c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f3d3cdab903f6ce77513c4457e194227 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/fc6f555f/uploads/origins/d5534543-b78c-4434-8d8a-a9ef4729fe5c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=49affb438d21f68a973bd6245ab8f56d", "srcset": "https://si.imgix.net/fc6f555f/uploads/origins/d5534543-b78c-4434-8d8a-a9ef4729fe5c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=49affb438d21f68a973bd6245ab8f56d, https://si.imgix.net/fc6f555f/uploads/origins/d5534543-b78c-4434-8d8a-a9ef4729fe5c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=c3cf2807e9adab821de08079cb1fb046 2x, https://si.imgix.net/fc6f555f/uploads/origins/d5534543-b78c-4434-8d8a-a9ef4729fe5c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=3855d8608d2da31bd9bb4568f4c64720 3x"}, "body": "初めまして。ICU看護師Vtuberをしております宮秋まどかと申します\n女性イラストと共に車をカッコよく描いていただける方を探しているうちにリスナーさんに紹介して頂き一目惚れしました。\n\nご依頼ですが、私のロードスターの前に立つ私を描いていただきたいです。\n車両及び立ち絵につきましては資料URLをご参照ください。\n\n ロードスターは以前に描かれていたように前方が見えるように斜めに配置して頂き、ドアにおしりをもたれるように立ち、フロントガラスの上縁に左腕を乗せるようなポーズが希望です。\n 私の方は白衣衣装でポニーテールの髪型で、表情は微笑んでいる感じ(相棒が大好きっていう雰囲気)でお願いします。\n 背景はおまかせいたします(なくても可)\n\n ファイルは背景透過で車と人物をレイヤー分けしたpsdをお願いしたいです。\n また、グッズにすることも検討しており商用利用許可が頂きたく金額を入れさせていただきました。もし金額ご指定がありましたら差し戻しのうえご提示いただけますと幸いです。\n\nお忙しいところ恐縮ですが、どうぞよろしくお願いいたします。\n\nhttps://1drv.ms/f/c/3b820c810745040f/IgBLLNNKQms5Sq1sqWFsYXMLAXoNP3kWGB9mTIVObR6-BtE", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@abekobenanda/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3400882, "client_id": 644634, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/c3c5856f/uploads/origins/2e553fe1-794d-4408-8770-a512b1c9a9cb