ee-a5f6-8915c79b816c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=de0790ea9a055eb2a2c1518754d10573", "srcset": "https://si.imgix.net/1e8e0d6f/uploads/origins/8d5c91e2-9a99-4fee-a5f6-8915c79b816c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=de0790ea9a055eb2a2c1518754d10573, https://si.imgix.net/1e8e0d6f/uploads/origins/8d5c91e2-9a99-4fee-a5f6-8915c79b816c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=dfa578deede7e85d553d72e05f086c74 2x, https://si.imgix.net/1e8e0d6f/uploads/origins/8d5c91e2-9a99-4fee-a5f6-8915c79b816c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=460d98454353e04fa8d493c08a3868cf 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/1e8e0d6f/uploads/origins/8d5c91e2-9a99-4fee-a5f6-8915c79b816c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=08f3ee9e8147dd2e2dbbe66d74c14282", "srcset": "https://si.imgix.net/1e8e0d6f/uploads/origins/8d5c91e2-9a99-4fee-a5f6-8915c79b816c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=08f3ee9e8147dd2e2dbbe66d74c14282, https://si.imgix.net/1e8e0d6f/uploads/origins/8d5c91e2-9a99-4fee-a5f6-8915c79b816c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=71c36a2c7a64e73c35e3a09aa848d819 2x, https://si.imgix.net/1e8e0d6f/uploads/origins/8d5c91e2-9a99-4fee-a5f6-8915c79b816c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=08610ad113d1efc6b5e066284558a9ea 3x"}, "body": "初めての依頼ですがよろしくお願い致します。\n\nスカトロ趣味の彼女達2で出てきたアイドルの智美ちゃんがステージの上で便秘ウンコをする絵をお願いします。\n構図は「https://x.com/Imopani_Puusuka/status/1819352751543046306/photo/1」のメロンのような立ち姿でパンツだけ履いておらずお尻丸出し、また差分で大きなオナラの後極太で長いデカウンコを産み落とし、足元にウンコのエベレストを作っていただけると助かります。\nまた差分で、白のデカパンツを履いたまま放屁と大量脱糞をし、パンツを人の頭よりも大きくぱんぱんに膨らませた後、パンツがウンコの重さで床に落下し、中身のデカウンコの塊が丸見えだと嬉しいです。\n\nウンコの質感はスカトロ趣味の彼女達2の洋式トイレで智美ちゃんがしたウンコっぽいと嬉しいです。智美ちゃんはかなり食べる子のようなので更に太く量が多いと嬉しいです。\nまた服装はアイドルっぽい物なら何でも良いですし、表情もお任せします。背景等も特にいらないです。\n\n細かい注文が多くて申し訳ございません。お忙しいところ恐縮ですが何卒宜しくお願い致します。また依頼内容に比べて金額に不満がある場合はキャンセルしてもらって構いません。再度金額を上げてまた依頼したいと思います。", "nc": 161, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@PotatoPanicking/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3300151, "client_id": 3354435, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/9c42f0f3/uploads/origins/a8f601b2-17e2-490d-9f74-c2a061629703?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=40e7f7eaa9ebeb8519db66b159b87ab7", "srcset": "https://si.imgix.net/9c42f0f3/uploads/origins/a8f601b2-17e2-490d-9f74-c2a061629703?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=40e7f7eaa9ebeb8519db66b159b87ab7, https://si.imgix.net/9c42f0f3/uploads/origins/a8f601b2-17e2-490d-9f74-c2a061629703?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ab7f4a9f8920a3ab833a13c151a1cf6e 2x, https://si.imgix.net/9c42f0f3/uploads/origins/a8f601b2-17e2-490d-9f74-c2a061629703?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=0e54b10e6941bb03cd6b9a1bb61ccfca 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/9c42f0f3/uploads/origins/a8f601b2-17e2-490d-9f74-c2a061629703?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9dc3d4860d5fef368505f84e9fc8a2af", "srcset": "https://si.imgix.net/9c42f0f3/uploads/origins/a8f601b2-17e2-490d-9f74-c2a061629703?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9dc3d4860d5fef368505f84e9fc8a2af, https://si.imgix.net/9c42f0f3/uploads/origins/a8f601b2-17e2-490d-9f74-c2a061629703?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=22a040a10c88e8a0efb5cb5bbf054207 2x, https://si.imgix.net/9c42f0f3/uploads/origins/a8f601b2-17e2-490d-9f74-c2a061629703?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=2be33be894754c9626e6f981c46462ca 3x"}, "body": "芋塚先生初めまして。\nいつも素晴らしい作品を拝見しており、今回skebを開設されたということでぜひお願いしたいと思い、リクエストさせていただきます。\n\n三船美優（アイドルマスターシンデレラガールズ）のスカ絵をお願いしたいです。\n衣装や構図は問わないですが、羞恥系のシチュエーションだと嬉しいです。\n\nご検討のほどよろしくお願いいたします。\n\nhttps://imas.gamedbs.jp/cg/idol/detail/80", "nc": 57, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@PotatoPanicking/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3300151, "client_id": 172273, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/80b67a42/uploads/origins/d64d0c56-0d77-4b14-986e-eea8bed84ca9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=83e2817b215ca2c5a0180f50d52c2728", "srcset": "https://si.imgix.net/80b67a42/uploads/origins/d64d0c56-0d77-4b14-986e-eea8bed84ca9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=83e2817b215ca2c5a0180f50d52c2728, https://si.imgix.net/80b67a42/uploads/origins/d64d0c56-0d77-4b14-986e-eea8bed84ca9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b377be5faffd84eb6d8f91d38ae3acd3 2x, https://si.imgix.net/80b67a42/uploads/origins/d64d0c56-0d77-4b14-986e-eea8bed84ca9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=2c0c7ab702065803865c4a93b07092fd 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/80b67a42/uploads/origins/d64d0c56-0d77-4b14-986e-eea8bed84ca9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e38d8130d547322d0bf1c3952ba523cc", "srcset": "https://si.imgix.net/80b67a42/uploads/origins/d64d0c56-0d77-4b14-986e-eea8bed84ca9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e38d8130d547322d0bf1c3952ba523cc, https://si.imgix.net/80b67a42/uploads/origins/d64d0c56-0d77-4b14-986e-eea8bed84ca9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=223678af274a05341c3165f0cfdba030 2x, https://si.imgix.net/80b67a42/uploads/origins/d64d0c56-0d77-4b14-986e-eea8bed84ca9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=715e59dc210e1304ecab6f463d3c5e7f 3x"}, "body": "はじめまして、いつも楽しみにしております\nよろしければうちの子メイドのスカトロ絵をお願いします。\n\nエミリー\n身長185cmの教育ママのような眼鏡を掛けたツンとした風貌\nイメージはこちらで、メイド服は白と紫\nhttps://x.com/d_fuduki/status/1725178001548329006\n\nセリカ\n身長195cmの糸目キャラでエミリーより筋肉質の粗暴そうな女性\nイメージはこちらで、メイド服は白と赤\n\nhttps://x.com/d_fuduki/status/1791755189843906816\n開眼時\nhttps://pbs.twimg.com/media/GPsxkvoaYAATl8N?format=jpg&name=small\n\nエリカとナタネの特製こやしのようなシチュエーションで、トイレが満杯で我慢できず風呂場に大きな容器を置いて二人で背中合わせに大量排泄するシーンをお願いします。\n（可能であれば片側の尻肉同士が合わさっていれば嬉しいです）\n\n太さはセリカの方が大きく暗めの色ですが量はエミリーの方が多く、セリカが出し切った後も出していてそれを見ていたセリカが目を開けて驚くような仕草をしていると嬉しいです。\n\nオナラからの排泄、出し切った後の緩んだ顔で\nエミリーは表情豊かにイキ顔していて\nセリカはたまに出す時うっすら目が開く位、出した後のイキ顔や驚くときは目が開きます\n（口元などはエミリーと同じく緩んで大丈夫です）\n\n可能であれば\n\n全裸差分\n\nウンコをパックしてパンツ（エミリーは紫、セリカは赤）をかぶせた差分\n（表情はエミリーがドヤ顔、セリカが屈辱そうな顔で下を向く）\n\n出し切った後のウンコのみの画像\n\nよろしくお願いします", "nc": 41, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@PotatoPanicking/works/1", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/86431112/uploads/origins/15b5ad90-6da0-47e0-8487-319e5c0ffdba?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=ada5029fe6399c5cddeeab2ababd82e8", "srcset": "https://si.imgix.net/86431112/uploads/origins/15b5ad90-6da0-47e0-8487-319e5c0ffdba?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&t