4-4f16-be3e-073707f18c74?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b3cb13fde12f8bc4dfa3db90da1ff9e5 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/e01dec14/uploads/origins/79e2519d-8ba4-4f16-be3e-073707f18c74?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a2876129742e03b72be69c1f40f9340a", "srcset": "https://si.imgix.net/e01dec14/uploads/origins/79e2519d-8ba4-4f16-be3e-073707f18c74?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a2876129742e03b72be69c1f40f9340a, https://si.imgix.net/e01dec14/uploads/origins/79e2519d-8ba4-4f16-be3e-073707f18c74?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=dd84ee02ad274914bef09a1917e6d279 2x, https://si.imgix.net/e01dec14/uploads/origins/79e2519d-8ba4-4f16-be3e-073707f18c74?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=690a6e766b56051289aacde77641a2aa 3x"}, "body": "こんにちは、伊南様。星見と申します。\n\nかわいらしくもかっこよく、元気で暖かい雰囲気の絵柄が好きでリクエストいたします。\n自創作「魔法使い見習いの魔法薬作り」のイラストを描いていただきたいと思い、お願いいたします。\n伊南様のファンタジー少年少女が大好きなので、ほのぼのかわいいキャラクターが見たいと思いました。\n\n⚪︎ロザ\n12歳の女の子。髪はロゼブラウンの長髪です。緑色がかった青目。\nお寝坊さんだが、いざ起きた後は活発。後先考えないところがある。\n魔法使い見習いで、師匠のもとで修行している途中。\n華美ではない、それらしい服を着せていただければと思います。\n構図やシチュエーションはお任せいたします。\n\n⚪︎参考\nカクヨム「魔法使い見習いの魔法薬作り」\nhttps://kakuyomu.jp/works/16818093088572237969\n\nイラストはSNS(みすでざ)で明記の上紹介したいと思っております。 \n内容や金額、ご都合が合わなければお断りください。\nご検討くださればうれしいです。どうぞよろしくお願いいたします。", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@InanHawk/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2733170, "client_id": 758576, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/c3811db1/uploads/origins/394fd1ec-2440-4ded-921b-09937382b9c8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=681ed882d648efddc9aa4aa084346b98", "srcset": "https://si.imgix.net/c3811db1/uploads/origins/394fd1ec-2440-4ded-921b-09937382b9c8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=681ed882d648efddc9aa4aa084346b98, https://si.imgix.net/c3811db1/uploads/origins/394fd1ec-2440-4ded-921b-09937382b9c8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e67e7f6786776431276cefcda5961501 2x, https://si.imgix.net/c3811db1/uploads/origins/394fd1ec-2440-4ded-921b-09937382b9c8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=9c17b2604f354c51e48812ee8bfe634b 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/c3811db1/uploads/origins/394fd1ec-2440-4ded-921b-09937382b9c8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=75c51b3be2a071480481e917edc3184c", "srcset": "https://si.imgix.net/c3811db1/uploads/origins/394fd1ec-2440-4ded-921b-09937382b9c8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=75c51b3be2a071480481e917edc3184c, https://si.imgix.net/c3811db1/uploads/origins/394fd1ec-2440-4ded-921b-09937382b9c8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=cfcb932f795348d8ea2011a78b4af5c5 2x, https://si.imgix.net/c3811db1/uploads/origins/394fd1ec-2440-4ded-921b-09937382b9c8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=eb4e4f0785b9b163435909bd5b7bf026 3x"}, "body": "こんにちは、羽鳥です。\n伊南さんに自創作「竜世界クロニクル」のキャライラストを描いていただきたいと思い、伺いました。\n\n◾️ラファエル・エーレ・ブルーメンタール\n\n年齢19歳、淡い金の髪にサファイアブルーの目、身長は174cmで痩せぎみ。\n髪は肩より少し長いくらいで、ストレートヘア。\n飛竜騎士で、相棒は蒼飛竜のマリユス。服装は貴族服を簡略化したような感じです。\nイラストはこちらです。\nhttps://misskey.design/notes/9lnizbd0fk\n\n\n上記ラファエルと、以下の二人のうちどちらかを組み合わせて欲しいです。\n\n◾️ルフィリア・ミルファーン\n\n年齢16歳、青みがかった白髪と瑠璃紺の目、身長150cmほどで女性らしい体型。\n髪は肩より長いくらい。星型の髪留めをつけている。\n服装は青系のワンピースが多い。肌が白く陽射しに弱いため、長袖と薄手の手袋をしている。\nイラストはこちらにあります。\nhttps://misskey.design/notes/9lqe0bu408\n\n◾️セステュ・クリスタル\n\n年齢17歳、まっすぐ長い銀髪と翡翠の目、身長172cmで細身。\n騎士団支給の上下制服。イラストはこちらにあります。\nhttps://misskey.design/notes/9drfipavyz\n\n\n本編最後まで読んでの一押し、ということでしたので、構図やシチュエーションはお任せします。想像の場面を描いてくださっても、作中で気に入ったシーンを絵にしてくださっても良いです。\n頂いたイラストはミスキーなどのSNSや、カクヨムの近況ノートで紹介したいと思っております。\n\n宜しければご検討ください。", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@InanHawk/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2733170, "client_id": 2823119, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/895f10b7/uploads/origins/1b7718c9-6c5d-4a67-9440-acc71e738541?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3717a8c82d5f171e9c066cf564ea3df1", "srcset": "https://si.imgix.net/895f10b7/uploads/origins/1b7718c9-6c5d-4a67-9440-acc71e738541?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3717a8c82d5f171e9c066cf564ea3df1, https://si.imgix.net/895f10b7/uploads/origins/1b7718c9-6c5d-4a67-9440-acc71e738541?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f3f4d5f8572e0e70384bbd755537a546 2x, https://si.imgix.net/895f10b7/uploads/origins/1b7718c9-6c5d-4a67-9440-acc71e738541?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=16cfe88616b0744602620dd6b431b29e 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/895f10b7/uploads/origins/1b7718c9-6c5d-4a67-9440-acc71e738541?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=84fed932082eb4b069f6916024cc3286", "srcset": "https://si.imgix.net/895f10b7/uploads/origins/1b7718c9-6c5d-4a67-9440-acc71e738541?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=84fed932082eb4b069f6916024cc3286, https://si.imgix.net/895f10b7/uploads/origins/1b7718c9-6c5d-4a67-9440-acc71e738541?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=99e477c1c4a74d82894d103d7d3946e6 2x, https://si.imgix.net/895f10b7/uploads/origins/1b7718c9-6c5d-4a67-9440-acc71e738541?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=fea9efbd6cfafce11877dc3798e43c25 3x"}, "body": "misskey.designから来ました！\n伊南さんに、自キャラ兄弟のペア画を想像で描いていただきたいです。バストアップでも全身でも構いません。服装や持ち物も自由で大丈夫です。\n■キャラ名\n★レオン（15歳、男）166cm\n現代日本風の世界に生まれる。狐色の髪が無造作に逆立っている（向かって左に流れている）。丸顔。瞳は黒。\n複雑な家庭環境でよくもまあというほど単純で、心の機微に疎い。兄のことは自慢に思っているが、兄に追い出されるとヤバいなとは理解している。趣味、カメラ。\n★シオン（21歳、男）178cm\n襟足が肩まで届くかどうかの茶色い短髪、黒い吊り目。現代日本風の世界に暮らすレオンの兄。両親が死んでからは彼がレオンを育てた。二人は連れ子で血が繋がっていない。実は異世界出身の魔法使いで、レオンの秘された使命を承知していた。レオンが旅に出るタイミングで、二年付き合っていた彼女が妊娠。趣味、バイク。\n\n■参考資料（必要に応じ参考にしてください。上記のみで描いていただいても構いません）\n小説〈七神剣の森〉（初出：一筋の光...壱...、再会：七神剣の森...壱...）\nhttps://www.pixiv.net/novel/series/10384557\n設定資料やイラストも本Pixivアカウントにて掲載しています。シオンのイラストはありません…。\n※Pixiv版小説はR15相当の性描写、残虐描写があります。全年齢版を参考にされる場合はこちら（小説家になろうリンク）\nhttps://ncode.syosetu.com/n1459ig/\n\n■その他\nみすでざのご縁なので、よかったら作品をそちらで公開してください。RNと頂き物クリップさせていただきたいです。\n\n以上になります、よろしくお願いいたします！\n\nhttps://www.pixiv.net/novel/series/10384557", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@InanHawk/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2733170, "client_id": 803861, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/68b15e38/uploads/origins/7ba9b080-3b4a-4319-bd0c-7d5431807416?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e66a8d09e11e92e8ffa507539b1d01cb", "srcset": "https://si.imgix.net/68b15e38/uploads/origins/7ba9b080-3b4a-4319-bd0c-7d5431807416?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e66a8d09e11e92e8ffa507539b1d01cb, https://si.imgix.net/68b15e38/uploads/origins/7ba9b080-3b4a-4319-bd0c-7d5431807416?bg=%23fff&auto=format%2Ccomp