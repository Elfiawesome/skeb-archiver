ーズで喜んでいる表情でお願いします\nあと、メフィラスはもちろん等身大サイズで\nテーブルの上にパンの乗った皿とティーカップを置く皿も描いてください", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@UMYU13137/works/12", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2919217, "client_id": 201825, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/353a9da8/uploads/origins/b1924edd-4d3c-4a80-9be1-4e7b3343fde2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2a45dae157151bd6c248a993ed7d9ace", "srcset": "https://si.imgix.net/353a9da8/uploads/origins/b1924edd-4d3c-4a80-9be1-4e7b3343fde2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2a45dae157151bd6c248a993ed7d9ace, https://si.imgix.net/353a9da8/uploads/origins/b1924edd-4d3c-4a80-9be1-4e7b3343fde2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=3452b24c065b93e2193829058810b7fb 2x, https://si.imgix.net/353a9da8/uploads/origins/b1924edd-4d3c-4a80-9be1-4e7b3343fde2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=9805415229bf27ba59ebd2d59909989c 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/353a9da8/uploads/origins/b1924edd-4d3c-4a80-9be1-4e7b3343fde2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=8f10ee0719af71d00fc0c40339e97ccc", "srcset": "https://si.imgix.net/353a9da8/uploads/origins/b1924edd-4d3c-4a80-9be1-4e7b3343fde2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=8f10ee0719af71d00fc0c40339e97ccc, https://si.imgix.net/353a9da8/uploads/origins/b1924edd-4d3c-4a80-9be1-4e7b3343fde2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=09277eeb698a92f64453639fc5a12f52 2x, https://si.imgix.net/353a9da8/uploads/origins/b1924edd-4d3c-4a80-9be1-4e7b3343fde2?bg=%23fff&auto=format%2Ccompres