0-c7ec-42e5-8599-034e179e87f1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=eb6d79e838b2977ae79f46e61434593c, https://si.imgix.net/3eb9de3f/uploads/origins/7133bbe0-c7ec-42e5-8599-034e179e87f1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=12fbd7093e08320fbde3e5a2c07cc5e0 2x, https://si.imgix.net/3eb9de3f/uploads/origins/7133bbe0-c7ec-42e5-8599-034e179e87f1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=8948d7908c05514224720a0cc88e8449 3x"}, "body": "Hello!\n\nI would like to request artwork of my Vtuber! She is a Chinese jade dragon who lives is the world that has traditional and modern elements mixed together: https://arknights.fandom.com/wiki/Yan/Gallery\nI would like a 16:9 image with the background and character in separate layers if possible!\n\nFeel free to draw her however you like in whatever background you think fits!\n\nArtwork will be shared or used on SNS with proper credits given!\n\nHere is link the references of my Vtuber:\nhttps://drive.google.com/drive/folders/1JHUjdqBsvOUsfiJDGpMgHxbP6079SboS?usp=sharing\n\nPlease pay close attention to my earring, the hair streaks and colors of my eyes ^~^", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Datyou000/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2494595, "client_id": 2343596, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/823f24e2/uploads/origins/fc4efb45-2c2e-4849-807e-a2c678a8fc79?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b961b8dabb4001c0ff1cdd83b8f2e547", "srcset": "https://si.imgix.net/823f24e2/uploads/origins/fc4efb45-2c2e-4849-807e-a2c678a8fc79?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b961b8dabb4001c0ff1cdd83b8f2e547, https://si.imgix.net/823f24e2/uploads/origins/fc4efb45-2c2e-4849-807e-a2c678a8fc79?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=68d73e8baab3eb5cce1b515887597695 2x, https://si.imgix.net/823f24e2/uploads/origins/fc4efb45-2c2e-4849-807e-a2c678a8fc79?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=23a830d6ff755c99d30b260e14e02df6 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/823f24e2/uploads/origins/fc4efb45-2c2e-4849-807e-a2c678a8fc79?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6272312cee2a6bb1bd417c91c2abecac", "srcset": "https://si.imgix.net/823f24e2/uploads/origins/fc4efb45-2c2e-4849-807e-a2c678a8fc79?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6272312cee2a6bb1bd417c91c2abecac, https://si.imgix.net/823f24e2/uploads/origins/fc4efb45-2c2e-4849-807e-a2c678a8fc79?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=f4fdb5835e273746727ce5dd892d5680 2x, https://si.imgix.net/823f24e2/uploads/origins/fc4efb45-2c2e-4849-807e-a2c678a8fc79?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=53693c4496438d5fb89eb03fa092a373 3x"}, "body": "Hello! Your art is beautiful and pretty! I love the way you draw and color your characters\n\nI'd like to request a commission of my VTuber! Can it be a horizontal drawing at a 16:9 ratio please?\n\nHere is the link to the references for her: https://drive.google.com/drive/folders/1WR_WuJz_Cag3l-ENZLRVgPZP-L14wkvs?usp=sharing\nShe is wearing dark blue eyeliner and no fang!\n\nI'll leave the expression, pose, background, and prop usage to your expertise!\n\nI plan on using art for Twitch, Twitter, Youtube SNS, etc., with proper credit given! If you could provide the PSD file with separate layers for the character and the background, that would be really nice.\n\nThank you for your consideration!\n\nhttps://drive.google.com/drive/folders/1WR_WuJz_Cag3l-ENZLRVgPZP-L14wkvs?usp=sharing", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Datyou000/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2494595, "client_id": 2228294, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/db3662ca/uploads/origins/8a7969b8-93d4-4867-96d6-f73d88656ee3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=dae6ff00c8c6be091ed3ad845ebf36cc", "srcset": "https://si.imgix.net/db3662ca/uploads/origins/8a7969b8-93d4-4867-96d6-f73d88656ee3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=dae6ff00c8c6be091ed3ad845ebf36cc, https://si.imgix.net/db3662ca/uploads/origins/8a7969b8-93d4-4867-96d6-f73d88656ee3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=18496303ed6be16b2a7a2c218c13ce07 2x, https://si.imgix.net/db3662ca/uploads/origins/8a7969b8-93d4-4867-96d6-f73d88656ee3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d7558bb07fa9882d6d5dd2027f1162af 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/db3662ca/uploads/origins/8a7969b8-93d4-4867-96d6-f73d88656ee3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6f62b52173033d3d728649a06fe44a78", "srcset": "https://si.imgix.net/db3662ca/uploads/origins/8a7969b8-93d4-4867-96d6-f73d88656ee3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6f62b52173033d3d728649a06fe44a78, https://si.imgix.net/db3662ca/uploads/origins/8a7969b8-93d4-4867-96d6-f73d88656ee3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=af0146a9b26333df7d768a901b5a975b 2x, https://si.imgix.net/db3662ca/uploads/origins/8a7969b8-93d4-4867-96d6-f73d88656ee3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=3926caa436c2926e84f44ee99626c9d8 3x"}, "body": "Dear Kara, Nice to meet you! My name is Myro Soratou, and I am a personal Vtuber.\n\nI fell in love with your illustration at first sight...! I would like to request you to draw me, Miro, as well.\n\nComposition, pose, etc.: Please draw Miro singing a song.\nI would appreciate it if the illustration is in psd data format, with the person, background, text, etc. in separate files.\nI would appreciate it if the illustration is in psd data format with separate figures, backgrounds, text, etc.\nWe would like to see the original clothing, but we would be happy to see other clothing as well.\nIn the case of the original clothing, we would be happy to have some of it removed, such as armor or a cape.\n\nWe would like to have a three-sided drawing, profile (including some notes on clothing), and other reference materials.\nhttps://drive.google.com/drive/folders/1Pc26lygzHagrv6xRq3SeERRicRxY_9Mb?usp=sharing\nWe would be happy to provide you with a video or channel that gives you a sense of the person in question:\nhttps://youtu.be/PllrpZnociw\nI intend to dress up as a man.\n\nI would like to use your illustration as a thumbnail for a product or a video, etc. I would like to ask for your permission for commercial use.\nIf you do not, please cancel your request.\n\nThank you very much for your consideration...!", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Datyou000/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2494595, "client_id": 2168110, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/705bf14a/uploads/origins/ab539263-7ff6-4d26-b7a3-f618ab854a0e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7d50612f9c3fdb044d916a31e5e7e4f1", "srcset": "https://si.imgix.net/705bf14a/uploads/origins/ab539263-7ff6-4d26-b7a3-f618ab854a0e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7d50612f9c3fdb044d916a31e5e7e4f1, https://si.imgix.net/705bf14a/uploads/origins/ab539263-7ff6-4d26-b7a3-f618ab854a0e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=d5adce6e041748257335ee2fb8401580 2x, https://si.imgix.net/705bf14a/uploads/origins/ab539263-7ff6-4d26-b7a3-f618ab854a0e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=79c854bb5cbc76a2c3fa8495c4daf8aa 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/705bf14a/uploads/origins/ab539263-7ff6-4d26-b7a3-f618ab854a0e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f752daa9fc8915e7d232dd349249b41b", "srcset": "https://si.imgix.net/705bf14a/uploads/origins/ab539263-7ff6-4d26-b7a3-f618ab854a0e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f752daa9fc8915e7d232dd349249b41b, https://si.imgix.net/705bf14a/uploads/origins/ab539263-7ff6-4d26-b7a3-f618ab854a0e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=6cce65c9d14de8d6a4b2047651d5963b 2x, https://si.imgix.net/705bf14a/uploads/origins/ab539263-7ff6-4d26-b7a3-f618ab854a0e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=faed9996f2b3c1e3061c274fde13088e 3x"}, "body": "Nice to meet you!\nI requested this because of your nice pattern.\nIf you don't mind, would it be possible to ask you to draw our OC \"Shark Ice Shachi\"?\nFor your reference, the setting is as follows, but you are free to draw it as you like.\nI would be happy to draw it.\nShachi Shark Ice\nShe is slender and fair-skinned with long, straight black hair.\nShe wears a sailor uniform based on black and white and a sailor cap.\nIn addition to her idol-like energy and brightness, she has a neat and dainty appearance.\nShe is very curious and her hobbies are visiting theme parks and observing people.\nShe is a picky eater, and eats her favorite foods frequently. On the other hand, she also gets bored quickly.\nEven when he is close to someone, he skillfully manipulates his emotions and uses them for his own convenience.\nHis words and actions are somewhat acting and exaggerated.\nInbornly lacking in empathy, what appears to be emotion at first glance is only what he has acquired as a result of observing people.\nHe is a very good listener and is very good at listening to others.\nI would like to use the illustrations for my personal activities in general (e.g., illustrations for novels, introduction of characters on SNS and personal websites, announcements of personal activities, etc., sample materials for requests for commissions).\nIf this is convenient for you, please contact me.\n\nhttps://drive.google.com/drive/folders/1jei9Iwcg2uY-ZixgeOuH2u12d-FL5dK4", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 81207, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "くるくる数字", "screen_name": "kuru2suuziman", "avatar_url": "https://pbs.twimg.com/profile_images/1978705295527550976/5v7chC_P.jpg", "header_url": "https://pbs.twimg.com/profile_banners/983667441011122176/1646594112/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "art"}], "nc": 49}, {"id": 1258782, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "ふゆみ／冬みかん", "screen_name": "hymkn_cgkiy", "avatar_url": "https://pbs.twimg.com/profile_images/1431672023139241984/K4tlT9-Y.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1400846306763886595/1658351087/1500x500", "appeal_receivable": false, "popular_creator_rank": n