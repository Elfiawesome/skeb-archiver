用する際にはクレジットをつけさせていただきます。\n\n●特徴\nhttps://x.com/baku41yume/status/1785650740549369913\n・白、藍色のグラデーションのボブヘア\n・目と髪の濃い部分は星空っぽい感じ\n・八重歯\n・和(羽織)＋洋(パーカー)の服\n・悪夢を食べて生まれた無邪気な子\n\n\n\nご縁がありましたらぜひよろしくお願いいたします！\n\nhttps://x.com/baku41yume/status/1785650740549369913", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@NatsunoyoiKUN/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3768045, "client_id": 2898579, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/51581a86/uploads/origins/40efe278-6041-461c-b596-d1265e07ed78?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5ec182558c4bd35e8d734ac24fd41d18", "srcset": "https://si.imgix.net/51581a86/uploads/origins/40efe278-6041-461c-b596-d1265e07ed78?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5ec182558c4bd35e8d734ac24fd41d18, https://si.imgix.net/51581a86/uploads/origins/40efe278-6041-461c-b596-d1265e07ed78?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ef0e6c1385565b30ed1b2e707a98d4d6 2x, https://si.imgix.net/51581a86/uploads/origins/40efe278-6041-461c-b596-d1265e07ed78?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=2ae16777a7192e1cdc7986f0793f8b07 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/51581a86/uploads/origins/40efe278-6041-461c-b596-d1265e07ed78?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3d78a1d68a5b45a8775bd202e19ffe23", "srcset": "https://si.imgix.net/51581a86/uploads/origins/40efe278-6041-461c-b596-d1265e07ed78?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3d78a1d68a5b45a8775bd202e19ffe23, https://si.imgix.net/51581a86/uploads/origins/40efe278-6041-461c-b596-d1265e07ed78?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&