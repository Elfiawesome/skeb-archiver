an_express": {"nsfw": true}}}, "acceptable_only_public": false, "tip_acceptable": true, "yearly_report_client_visible": false, "total_appeals_count": 0, "received_works": [{"path": "/@toumyao_093neko/works/9", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3781929, "client_id": 3911211, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/1732ddea/uploads/origins/7195ca0a-4e94-4796-ad48-f09645ec54c3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c919ba830ed8e2701b029cd42d4eb79e", "srcset": "https://si.imgix.net/1732ddea/uploads/origins/7195ca0a-4e94-4796-ad48-f09645ec54c3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c919ba830ed8e2701b029cd42d4eb79e, https://si.imgix.net/1732ddea/uploads/origins/7195ca0a-4e94-4796-ad48-f09645ec54c3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=0c2e8f2d3f6c4d5bf66b88faaa2a701c 2x, https://si.imgix.net/1732ddea/uploads/origins/7195ca0a-4e94-4796-ad48-f09645ec54c3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=34bff0975a28210e1c63e4372d568660 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/1732ddea/uploads/origins/7195ca0a-4e94-4796-ad48-f09645ec54c3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d8270703f1b0c25834440235a35577f3", "srcset": "https://si.imgix.net/1732ddea/uploads/origins/7195ca0a-4e94-4796-ad48-f09645ec54c3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d8270703f1b0c25834440235a35577f3, https://si.imgix.net/1732ddea/uploads/origins/7195ca0a-4e94-4796-ad48-f09645ec54c3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=bc0d563cc25e2eedcceab053f179f2af 2x, https://si.imgix.net/1732ddea/uploads/origins/7195ca0a-4e94-4796-ad48-f09645ec54c3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=b02a68ed1e28cf534318cda38fb0aaa4 3x"}, "body": "豆苗猫先生、こんにちは！はじめまして！先生の画風がとても気に入ったので、私のオリジナルポニー（OC）のイラストを描いていただけないでしょうか！\n以下に、ポニーの設定リンクとキャラクター紹介を貼らせていただきます！\n\n刹那光輝／Ephemeral Lumina／エフェメラル・ルミナ\n\nhttps://www.mihuashi.com/character-card/ed0daaf5ed41e3af69afdfcf53ed5f4635531132?utm_source=direct&utm_campaign=character-card&utm_medium=share\n\n明るくたくましく、黙々と努力を続ける真面目なタイプで、夜にはこっそり寮を抜け出し、力尽きるまで一人で練習に励む。\nデビュー後のレースはなかなか順調にはいかなかった。\n病気でもレースに出場しようと頑張り、当然のようにレース中に気絶してしまったが、気絶する数秒前に体の異変に気づき、他の選手の邪魔にならないよう外枠へ逃げ込んだ。その後、医師とトレーナーから数ヶ月間の出場停止処分を受けた。このスランプ期には、劣等感などのネガティブな感情が爆発した。しかし、走り続ける競走馬娘として、彼女は必ず泥沼から這い上がり、心の中で憧れる光に向かって走り続ける！\n心身のコンディションを完全に整えた後、驚異的な天皇賞の春秋連覇を達成し、その年の有馬記念も制した。レース後、体を酷使しすぎたため、引退を発表した。\nその名のごとく、刹那のように輝いた光。\n\n心流／Don't Mind／ドンマイ (Donmai)\n\nhttps://www.mihuashi.com/character-card/241ac60fd2bb315fc45d5b29e56e36cf23029995?utm_source=direct&utm_campaign=character-card&utm_medium=share\n\nパラレルワールドのポニー。中央を制覇した絶対的な暴君、生まれながらの王者。\nいつも無愛想だが、実は白紙のように純真で、走るのもただ走りたいからに過ぎない。欲しいものは何でも手に入る。生活常識は極めて乏しく、携帯電話などの電子機器は一切使いこなせず、外出して買い物をする際も決して代金を支払わない。トレセンが彼女がよく行く店で事前に代金を立て替えてくれているのだが、熱狂的なファンが先を争って代金を払ってくれることもある。\nプライベートではポテトチップス、フライドポテト、ピーマンとジャガイモの千切り炒めなど、あらゆるジャガイモ製品が好きだ。\n何らかの理由で、目を覚ますと主世界の自分のベッドに横たわっていた。\nこの世界の自分が早くに引退し、戦績もそれほど輝かしいものではないという事実を、どうしても受け入れられない。しかし、光輝が住居を無償で提供し、生活費のすべてを負担してくれたおかげで、彼女はなんとかこの世界の「現実」を受け入れることができた。\n眠りの中で「帰りたい」と思えば帰れるし、心で願えば何でも叶うのだ。\n\nこの二人の関係を文芸的に表現すれば、同じ枝に咲いた異なる花であり、簡単に言えば本質的には同一人物である二つの異なる可能性だ。ただ、様々な巡り合わせで二人が同じ世界で出会い、そこで私は彼女たちに水仙百合（）をさせてしまった。\nあ、このリンクは中国側でキャラクター設定を表示するのに便利な専用サイトです。もし先生がリンクをクリックして確認できない場合は、そのままリクエストをキャンセルしてください！\n\n本題に戻りますが、先生、二人のポニーを両方描く必要はありません。お好きな方を一人選んで描いていただければ結構です！もちろん、二人とも描いていただいても構いません！ポニーの服は、キャラクター設定カードから自由に選んでください！\nもちろん、ポニーに新しい服を描いたり、新しいヘアスタイルにしたりしてもOKです！とにかく、先生が楽しく描けるように、自由に描いてください！\nあ、言い忘れていました。「心流」のキャラクター設定カードの2番目のコレクションにあるカラーチャートは、ポニーの瞳の色で、青とピンクのグラデーションになっています。2頭のポニーは本質的に同一人物ですので、当然、瞳の色も同じです！", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@toumyao_093neko/works/8", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3781929, "client_id": 2796984, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/cf9a8471/uploads/origins/2aaee295-60d5-4215-beda-541b3c3c786e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e1edc3f403fe6ffed4f6b1ba6da4c009", "srcset": "https://si.imgix.net/cf9a8471/uploads/origins/2aaee295-60d5-4215-beda-541b3c3c786e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e1edc3f403fe6ffed4f6b1ba6da4c009, https://si.imgix.net/cf9a8471/uploads/origins/2aaee295-60d5-4215-beda-541b3c3c786e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=53277c5dff84612a1877276835823a54 2x, https://si.imgix.net/cf9a8471/uploads/origins/2aaee295-60d5-4215-beda-541b3c3c786e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=4323719b836f25f6d65208a756b8d99b 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/cf9a8471/uploads/origins/2aaee295-60d5-4215-beda-541b3c3c786e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=98c075f7e1a2133f7c78bc9a021cecb7", "srcset": "https://si.imgix.net/cf9a8471/uploads/origins/2aaee295-60d5-4215-beda-541b3c3c786e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=98c075f7e1a2133f7c78bc9a021cecb7, https://si.imgix.net/cf9a8471/uploads/origins/2aaee295-60d5-4215-beda-541b3c3c786e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=771520f196da83c2aa47d4aa6ab0ea4f 2x, https://si.imgix.net/cf9a8471/uploads/origins/2aaee295-60d5-4215-beda-541b3c3c786e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=e44bf312cb6600722f1df54f1faffaa4 3x"}, "body": "豆苗猫先生、こんにちは！\n前回のリクエストをお受けいただき、本当にありがとうございました！\n今回は、前回先生に描いていただいたオリジナルウマ娘「シオドメ」さんと彼女の親友「石見ともか」のツーショット風イラストをリクエストさせていただきたいです。\n二人のポーズ、背景などにつきましては、よければ今回も先生にお任せできれば幸いです。\n参考画像: https://drive.google.com/drive/folders/1ZvHj6Ni0Fcg0qK2x7RMs66XwZDq-iTlg\n\nhttps://drive.google.com/drive/folders/1ZvHj6Ni0Fcg0qK2x7RMs66XwZDq-iTlg", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@toumyao_093neko/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3781929, "client_id": 2796984, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/625d5d93/uploads/origins/5edfa9df-724b-48cd-956d-d324b99736e6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4ea49186de8b9517ed6ab3ce094530a2", "srcset": "https://si.imgix.net/625d5d93/uploads/origins/5edfa9df-724b-48cd-956d-d324b99736e6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4ea49186de8b9517ed6ab3ce094530a2, https://si.imgix.net/625d5d93/uploads/origins/5edfa9df-724b-48cd-956d-d324b99736e6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=4c0301d2283fe9277df56903d89a7778 2x, https://si.imgix.net/625d5d93/uploads/origins/5edfa9df-724b-48cd-956d-d324b99736e6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c91db0b06cdd9c5bca8dfeaf6c137a7c 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/625d5d93/uploads/origins/5edfa9df-724b-48cd-956d-d324b99736e6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a2e7fc343664ef114fe766197277dd4e", "srcset": "https://si.imgix.net/625d5d93/uploads/origins/5edfa9df-724b-48cd-956d-d324b99736e6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a2e7fc343664ef114fe766197277dd4e, https://si.imgix.net/625d5d93/uploads/origins/5edfa9df-724b-48cd-956d-d324b99736e6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=6e5e88a8f6c9785ea442819a53ff92b9 2x, https://si.imgix.net/625d5d93/uploads/origins/5edfa9df-724b-48cd-956d-d324b99736e6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=2026b6ac7fb8654166d3445524759a78 3x"}, "body": "豆苗猫先生、はじめまして。いつも先生の作品を楽しく拝見しております。\nリクエストですが、私のオリジナルウマ娘を描いていただけますでしょうか。\nこの子の名前は汐留、田舎に住む高校生ウマ娘で、気が合えばすぐに友達になれるタイプ。親しい異性の友人も何人かいる。誕生日は7月31日、暇な時は家の雑用を手伝い、都会の大学に合格できるよう頑張っている。\nもしよければ、ポーズは先生の自由なアレンジでお任せしたいです。\nご検討のほど、どうぞよろしくお願いいたします。\n参考資料：https://drive.google.com/drive/folders/1ZvHj6Ni0Fcg0qK2x7RMs66XwZDq-iTlg?usp=sharing\n\nhttps://drive.google.com/drive/folders/1ZvHj6Ni0Fcg0qK2x7RMs66XwZDq-iTlg?usp=sharing", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@toumyao_093neko/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3781929, "client_id": 3617853, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/2f3c2a6c/uploads/origins/143be3df-d83d-4bd4-a454-4e99469f0761?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=be35afe5756f43963f975dc34f7208d0", "srcset": "https://si.imgix.net/2f3c2a6c/uploads/origins/143be3df-d83d-4bd4-a454-4e99469f0761?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=be35afe5756f43963f975dc34f7208d0, https://si.imgix.net/2f3c2a6c/uploads/origins/143be3df-d83d-4bd4-a454-4e99469f0761?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ae38dcf71f72aa8a81c128ad28ade597 2x, https://si.imgix.net/2f3c2a6c/uploads/origins/143be3df-d83d-4bd4-a454-4e99469f0761?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=40325d6c33e89678ef7b2b55d7b9f2dd 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/2f3c2a6c/uploads/origins/143be3df-d83d-4bd4-a454-4e99469f0761?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=7f02de22be8144875e018ba854f9d209", "srcset": "https://si.imgix.net/2f3c2a6c/uploads/origins/143be3df-d83d-4bd4-a454-4e99469f0761?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=7f02de22be8144875e018ba854f9d209, https://si.imgix.net/2f3c2a6c/uploads/origins/143be3df-d83d-4bd4-a454-4e99469f0761?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=f666e9c47fbb34f33b3bd8b5a74d9970 2x, https://si.imgix.net/2f3c2a6c/uploads/origins/143be3df-d83d-4bd4-a454-4e99469f0761?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=ed9bd4d2a0bb0a97da6f94225caa7335 3x"}, "body": "もやしねこさんこんにちは！(˶' ᵕ ' ˶)\nまた依頼させていただきます！\n今回は私の本垢のアイコンにもなっているOCの絵を描いていただきたいです！\n\n小瀬透花と言います、CoC(クトゥルフ神話TRPG)のシナリオを身内でやった時のOCで、小瀬ちゃんと呼んでいます！\nあともう1人、小瀬ちゃんとシナリオ中で仲良くなった子である他探索者(キャラ)のソフィアちゃんも一緒にお願いします！ソフィたんって呼ばれていためちゃくちゃ可愛い不思議ちゃんです(なんか学マスの広みたい)\n(このキャラを動かしていた方には許可取り済です)\n\n小瀬ちゃんがスマホ持ってて、小瀬ちゃんは満面の笑みで、ソフィたんは小さく笑ってる感じで一緒にピースで自撮りしている構図でお願いします！\n\n何かありましたら再送リクエストなどよろしくお願いいたします‼️\n今回もすいません(泣)(ポイントチャージのエラー関係で二回目がURLついてなかったみたいです…)\n\nそしてもやしねこさんのペースでご承認いただけるなら嬉しいですが、ご無理はなさらないでください(っ ´-` c)\n\nhttps://drive.google.com/drive/u/1/folders/1sj9Uc___zB_Cz-mA5zgXWyGE9dVQdYAZ?usp=gmail", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@toumyao_093neko/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3781929, "client_id": 2697758, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/d03eae69/uploads/origins/d1c84532-c894-40ab-bcd0-83c5c86ca216?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a7196a875ba0c5d3806f7de2f53491d6", "srcset": "https://si.imgix.net/d03eae69/uploads/origins/d1c84532-c894-40ab-bcd0-83c5c86ca216?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a7196a875ba0c5d3806f7de2f53491d6, https://si.imgix.net/d03eae69/uploads/origins/d1c84532-c894-40ab-bcd0-83c5c86ca216?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=21c30a88e887f1daa860441c7d52de23 2x, https://si.imgix.net/d03eae69/uploads/origins/d1c84532-c894-40ab-bcd0-83c5c86ca216?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=06df1f76db11c77feacd47d9bf849547 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/d03eae69/uploads/origins/d1c84532-c894-40ab-bcd0-83c5c86ca216?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=cf108ad826f11e8805f8ed802d5ae8c3", "srcset": "https://si.imgix.net/d03eae69/uploads/origins/d1c84532-c894-40ab-bcd0-83c5c86ca216?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=cf108ad826f11e8805f8ed802d5ae8c3, https://si.imgix.net/d03eae69/uploads/origins/d1c84532-c894-40ab-bcd0-83c5c86ca216?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=024eca9493fee2f53901811fdc64e9d6 2x, https://si.imgix.net/d03eae69/uploads/origins/d1c84532-c894-40ab-bcd0-83c5c86ca216?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=77edd812ce45dab677ba0ebf14b5f674 3x"}, "body": "もやしねこさん、前回は素敵なイラストをありがとうございました！\n想像以上のクオリティに感激し、早速ですがリピート依頼送らせていただきます！\n今回も私デザインの完オリ娘をお願いしたいです！\n\n\n＊プロフィール\nモノ／mono-(英語表記にハイフンが入ります)\n黒鹿毛　中等部159cm　B82／W56／H81\n\n「僕はなるんだ。君達を倒して、本当のウマ娘に」\n\nユニと瓜二つの姿をした謎のウマ娘。\n「ウマ娘」に対して強いコンプレックスがあり、トレセン学生を敵視している。\n基本的にながらも、ユニに何かと世話を焼く苦労人。ユニの過去と深い関係があるようだが、詳細は不明。\n\n＊性格／キャラクター\nクールで気が強く、他人との繋がりを嫌う荒んだ性格(アヤベさんやタイシン系)\nユニコーンの亜種、幻獣モノケロースがモチーフです。\n史実的な要素だと\n・ユニの全兄\n・ユニよりパワー型(ダート適正あり)\n・蹴り癖、ゲート難あり\nあたりまで考えています！\n\n＊容姿／ファッション\n・髪や服の構造はユニと同じ\n・濃い黒の部分は青を若干混ぜてます\n・リボンや袖やはダメージ仕様(公式ブライアンのような破れ方)\nまた、モノケロースはユニコーンより角が湾曲してるので、耳の形が内寄りに変わっています。\n\n＊完成品イメージ\n・背景／文字は前回と同じフォーマットでお願いします！\n・プロフィールの台詞を載せてください！\n・前回と同じく、下にミニキャラ顔をお願いします！\n・ポーズは少し影のある雰囲気。表情は少しムスッとした不機嫌顔でお願いします！\n・その他赤面や呆れ顔など、表情差分あると嬉しいです！(詳細はおまかせです！)\n\n前回はスピーディな納品ありがとうございました！\n今回もお時間ある時で大丈夫ですので、どうぞよろしくお願いします！\n\nhttps://drive.google.com/drive/folders/1m-BDgAydKXSoNNSSL4eVBkDfS02TNXmV", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@toumyao_093neko/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3781929, "client_id": 2697758, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/c7eaf2fc/uploads/origins/9ab632bc-9d3e-4007-b74a-e917e8db3d5c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1eed1a1fb0dc4e83a322ed8c05e1a3b1", "srcset": "https://si.imgix.net/c7eaf2fc/uploads/origins/9ab632bc-9d3e-4007-b74a-e917e8db3d5c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1eed1a1fb0dc4e83a322ed8c05e1a3b1, https://si.imgix.net/c7eaf2fc/uploads/origins/9ab632bc-9d3e-4007-b74a-e917e8db3d5c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=3eca40a7d7a9313c5fc17237dcf82286 2x, https://si.imgix.net/c7eaf2fc/uploads/origins/9ab632bc-9d3e-4007-b74a-e917e8db3d5c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=54f245f975af62a09c5798bc2d3967a2 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/c7eaf2fc/uploads/origins/9ab632bc-9d3e-4007-b74a-e917e8db3d5c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b7ed2c3a7751e06d811d890e60a34c94", "srcset": "https://si.imgix.net/c7eaf2fc/uploads/origins/9ab632bc-9d3e-4007-b74a-e917e8db3d5c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b7ed2c3a7751e06d811d890e60a34c94, https://si.imgix.net/c7eaf2fc/uploads/origins/9ab632bc-9d3e-4007-b74a-e917e8db3d5c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=a90aa22b24a628733ccc2472f156fc10 2x, https://si.imgix.net/c7eaf2fc/uploads/origins/9ab632bc-9d3e-4007-b74a-e917e8db3d5c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=c7dfac9402b33b154de22dd041129d29 3x"}, "body": "もやしねこさん、はじめまして！\n別垢での宣伝ポストをお見かけし、リクエスト送らせていただきます！\n私がデザインしたユニコーン(幻獣)モデルの完オリ娘の立ち絵をお願いしたいです！\n\n＊プロフィール\nユニ／uni-(英語表記にハイフンが入ります)\n白毛　中等部\n159cm　B82／W56／H81\n\n「私、知りたいんです！　ウマ娘のこと、あなたのこと！」\n\nレースが無い異世界からやってきた、記憶喪失の自称ウマ娘。\n普通のウマ娘とは違うルーツを持っているようで、「ウマ娘になること」を夢にトレセンに編入する。\n直観力に優れ、レースでは未来を読むかのように特異な走り方をする。\nその一方で、日常生活では常識に乏しい天然な一面も。\n\n＊性格／キャラクター\n好奇心旺盛で純粋無垢、誰に対しても懐くワンコ系。(トップロードやチヨノオーに近い感じ)\n史実的な要素に関しては(競馬初心者なので)あまり詰められていないのですが\n・牡馬\n・体格は脚が長く細身、馬体重はかなり軽め(430kg程度？)\n・アイルランド系の血が濃いめ(ユニコーンがケルト神話由来なので)\n・芝長距離の差しが得意(京都レース場◎？)\n・騎手や調教師相手には大人しく、牝馬に対して攻撃的(かしこい)\nあたりは構想しています！\n\n＊容姿／ファッション\n・とにかく真っ白！\n・各部の差し色はエメラルドグリーン(色相スケール165～180°あたり)\n・後ろ髪は髪質ストレートのロング(ややグラデーション入り)\n・前髪の構造は公式スぺちゃん似\n・ワンピースは腰をベルトで締めてセパレート(トレセン制服)っぽく見せてる\n・ワンピの袖はオーバーの七分袖\n・絵では隠れていますが、靴にはヒールあり\nまた、ケルト神話のユニコーン伝承から\n・青い目\n・らせん状の角(をイメージし、飴細工のようにひねった形の耳)\n・ヤギのあご髭(ピンクの跳ね毛っぽい部分)\n・ライオンの尾(中に骨と筋肉が通ってる)\n・二対の蹄(ブーツのつま先)\nをデザインに取り入れています。\n\n＊完成品イメージ\n・背景／文字は別垢で描かれている幻覚夕バﾉﾚちゃんと同じフォーマット\n・ポーズは元気いっぱい！なイメージ\n・プロフィールの台詞(「」内)を載せてください！\n・ほかの依頼絵のように、下側にミニキャラ調の顔が欲しいです(表情はおまかせします！)\n・他依頼と同じように表情差分もあれば嬉しいです！(こちらも表情はおまかせします！)\n・ほかの依頼と同じように、納品時に全身絵単体をつけていただければ……！\n\nもやしさんが描かれた幻覚夕バﾉﾚちゃんがぶっ刺さって以来、あなたのポップで明るい絵柄が大好きです！\n新規デザインではない依頼は初と思いますが、どうぞよろしくお願いします！\n\nhttps://drive.google.com/drive/folders/1m-BDgAydKXSoNNSSL4eVBkDfS02TNXmV", "nc": 24, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@toumyao_093neko/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3781929, "client_id": 2090574, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/4310fef2/uploads/origins/e0647dcb-ef8b-47fe-b72e-a36908a03576?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=46b9b97d028c9f82cf9568e347ea077b", "srcset": "https://si.imgix.net/4310fef2/uploads/origins/e0647dcb-ef8b-47fe-b72e-a36908a03576?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=46b9b97d028c9f82cf9568e347ea077b, https://si.imgix.net/4310fef2/uploads/origins/e0647dcb-ef8b-47fe-b72e-a36908a03576?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e5b14baed5f252d476bed500d07c33ca 2x, https://si.imgix.net/4310fef2/uploads/origins/e0647dcb-ef8b-47fe-b72e-a36908a03576?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=3952597144521372cd17e4c4b01bb39e 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/4310fef2/uploads/origins/e0647dcb-ef8b-47fe-b72e-a36908a03576?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=43b9d530cf330f4958f04f9677791054", "srcset": "https://si.imgix.net/4310fef2/uploads/origins/e0647dcb-ef8b-47fe-b72e-a36908a03576?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=43b9d530cf330f4958f04f9677791054, https://si.imgix.net/4310fef2/uploads/origins/e0647dcb-ef8b-47fe-b72e-a36908a03576?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=dba79fb5152c7328e8ddc4f06c6f8fce 2x, https://si.imgix.net/4310fef2/uploads/origins/e0647dcb-ef8b-47fe-b72e-a36908a03576?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=dc937507df85917c1746db234ac3e83e 3x"}, "body": "いつもお世話になってます山田信大です。\nこの度はskeb開設おめでとうございます！！そしてマジで待ってましたw\nすぐに人気になるのは目に見えてるので、最初のうちにさっさとご依頼させて頂こうと思います！！\n\n描いて欲しいものは滅茶苦茶あるのですが、今回のタイミング的に本日、自分の2025年度POG1位指名の【アクセス】君が見事にデビュー勝ちを収めてくれたので、是非妄想ウマ娘化して頂きたいなと思ってます。\n\n豆苗さん(自分の中では豆苗さんなのですが、どの呼び方が理想かいつか教えて頂ければ)が、そこまで馴染みの無い馬だと思うので、とりあえず自分が知り得る限りの情報と、自分なりの解釈を書き連ねていくので、創作の参考の一助にでもしていただければ。\n\n馬名　アクセス\n\n2023年03月03日下河辺牧場生まれ(お父さんのキセキとかソウルラッシュが生まれたところです)\n\n馬名のアクセスは【接近】って意味らしいです。\n\n父キセキ\n母トリニティプレイス\n母父マンハッタンカフェ\n\n石川達絵オーナー(これもキセキとかソウルラッシュの、白，緑二本輪，白袖勝負服の人)\n\n性格、特徴など\n\n脚長でキレイな馬体はお父さんのキセキによく似ています。性格は素直で１歳から始めた馴致（じゅんち）もすこぶる順調で、１歳から坂路に入れることができました。成長するにつれてボリューム感も出てきたのもいい（現在は４８０キロ前後）。ええ、まったく手がかからず、期待の１頭です\nとの関係者からのコメントからおそらく真面目そうなタイプ(おっとりまである？)\n\n関係者の父キセキ評\n\n本来のキセキはね、本当にバカ正直なくらいに素直な馬なんですよ。で、幼い頃とか、経験の少ないときには、そのバカ正直なところが出てしまう危険性があったんですよ。\n\nさっきも言いましたけど、気持ちだけでなく、あまりにも賢いので、何をするのにも正直に反応し過ぎてしまうんですよ。\n\n意外と多いんですけどね。真面目過ぎるがゆえに、「暴走している」と言われる馬。\n\n三代出遅れグセw\n\nルーラーシップ、キセキ、そして本日のアクセスまでビックリするくらい似てる出遅れw\nこれ絶対遺伝すよね？w\n\nんでロングスパート気味の捲りから無尽蔵のスタミナと天性のスピードで押し切るのもまた似てる\n\nそもそも父も母父(マンハッタンカフェ)も菊花賞馬だし、おそらくステイヤー資質高めっすよね\n父と一緒でそのうち逃げとかもやりだすかもだけどw\n\nおっとりロングスパート時々出遅れステイヤー？\nウマ娘で言うならメジロブライトとかヒシミラクルみたいな感じなんすかね？\nそのへんの解釈は豆苗さんにお任せ致します！\n\n見た目\n\nめっちゃ派手な星！！でかい！！可愛い！！\nひな祭り生まれなのもあって、天性の可愛さでも兼ね備えてるのでは？というのは言い過ぎかもやけどw\n自分、POGは馬体で選ぶ人なんですけどバランスも滅茶苦茶いいナイスバディ。(現在既に480あります)\n上記にもある通り、脚長でキレイな馬体らしいですね。\n\n鹿毛\n\n特に変わった道具は身に付けてないですね、今のところ。\n\nそんなところですかね？\nあとの諸々の細かい解釈や見た目や格好等は全てお任せしたいです！！\n豆苗さんの描くウマの雰囲気凄く好きなので！！\n\nいくつか資料も添付しておきます。\n\n用途はとりあえずX関連で考えております。(アイコンとかポストとか。検索避けはするようにします！)\n\nこれでよろしければ是非お願いいたします！！\n\nhttps://postimg.cc/gallery/ZStmWvm", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@toumyao_093neko/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3781929, "client_id": 3617853, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/1a4502c0/uploads/origins/7bea67ea-f2f4-40d0-89e7-29937f5ebb88?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1d3b4872cdac8b36af1254961c7034df", "srcset": "https://si.imgix.net/1a4502c0/uploads/origins/7bea67ea-f2f4-40d0-89e7-29937f5ebb88?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1d3b4872cdac8b36af1254961c7034df, https://si.imgix.net/1a4502c0/uploads/origins/7bea67ea-f2f4-40d0-89e7-29937f5ebb88?bg=%23fff&auto=format%2Ccompress&fm=webp&