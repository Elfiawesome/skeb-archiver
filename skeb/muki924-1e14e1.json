ャラにあった物にして下さい（例:孫美天→猿、清蘭→兎、寅丸星→虎）  \n\n資料→ https://dic.pixiv.net/a/%E3%83%A2%E3%83%96%E3%83%A9%E3%82%A4%E3%83%80%E3%83%BC\n\n\nちなみに僕のユーザーページを見るとわかりますが、このネタは他の方にも依頼した事のある内容だったりします。\n一応描く際の参考になれば、", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@muki924/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 128080, "client_id": 66613, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/e9b6ba1c/uploads/origins/ebd1c5be-7fb1-48f7-a3f9-0b64ace2d688?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ba799907998ac4e9d9a62ef8363ef141", "srcset": "https://si.imgix.net/e9b6ba1c/uploads/origins/ebd1c5be-7fb1-48f7-a3f9-0b64ace2d688?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ba799907998ac4e9d9a62ef8363ef141, https://si.imgix.net/e9b6ba1c/uploads/origins/ebd1c5be-7fb1-48f7-a3f9-0b64ace2d688?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=0c9ca75214e84b8296a77adc3ab3f154 2x, https://si.imgix.net/e9b6ba1c/uploads/origins/ebd1c5be-7fb1-48f7-a3f9-0b64ace2d688?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=cf59a40d38db5ca8f81b059d3c5d0d96 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/e9b6ba1c/uploads/origins/ebd1c5be-7fb1-48f7-a3f9-0b64ace2d688?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=4a1b23de8bc72a0057b2c55ce07e9814", "srcset": "https://si.imgix.net/e9b6ba1c/uploads/origins/ebd1c5be-7fb1-48f7-a3f9-0b64ace2d688?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=4a1b23de8bc72a0057b2c55ce07e9814, https://si.imgix.net/e9b6ba1c/uploads/origins/ebd1c5be-7fb1-48f7-a3f9-0b64ace2d688?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=a003b46b7d599afa0f0f6d554963c900 2x