3f9c5fd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e535b334c82c504a98f1cf6b9cc53dd8", "srcset": "https://si.imgix.net/29fdcd23/uploads/origins/fc160cf4-b619-4505-8122-528193f9c5fd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e535b334c82c504a98f1cf6b9cc53dd8, https://si.imgix.net/29fdcd23/uploads/origins/fc160cf4-b619-4505-8122-528193f9c5fd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=8ae779cbcc0f06591ac2c660a316e091 2x, https://si.imgix.net/29fdcd23/uploads/origins/fc160cf4-b619-4505-8122-528193f9c5fd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=787592a6c73c820853bc0a1ce9cb50e0 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/29fdcd23/uploads/origins/fc160cf4-b619-4505-8122-528193f9c5fd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=382bd4124d4b6115b69f2313cf7078c9", "srcset": "https://si.imgix.net/29fdcd23/uploads/origins/fc160cf4-b619-4505-8122-528193f9c5fd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=382bd4124d4b6115b69f2313cf7078c9, https://si.imgix.net/29fdcd23/uploads/origins/fc160cf4-b619-4505-8122-528193f9c5fd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=9bdc7a979fadc60d9b724830b72c96a3 2x, https://si.imgix.net/29fdcd23/uploads/origins/fc160cf4-b619-4505-8122-528193f9c5fd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=7f96e02f4ba416bd66e1b21e4e03cf01 3x"}, "body": "こんにちは。\n\n以前にフラワーナイトガールのスキラを依頼した者です。\n早速ですが、二次創作の依頼をさせていただきます。\n恐らく八式 あらた様がご存じないタイトルだと思いますが、対応可能ならばお願い致します。\n\n\n【作品名】\nティンクルスターナイツ\n\n\n【対象キャラクター】\n桜十路 エルデリーゼ\n\n\n【対象キャラクターのキャラ設定について】\nお金持ちのお嬢様で、箱入り娘として大切に育てられた清楚系な少女です。\n今まで屋敷に籠って育ったため世間知らずで、作品の舞台となる学園で初めて外の世界を見た為か、好奇心旺盛な性格です。\n尚、物語の主人公とは年下(主人公は学園2年生(＝高校生相当)で、エルデリーゼは学園よりも若い生徒たちが通う附属校の3年生(＝中学生相当))なキャラクターです。\nまた、エルデリーゼの個別シナリオでは主人公と恋仲の関係であったりします。\n\n\n【服装】\n資料URL内の制服\n\n\n【胸の大きさ】\n絶壁であり膨らみがほぼ無いです\n\n\n【シチュエーション】\n１．エルデリーゼがゲーム内の主人公(=エルデリーゼの想い人)を想っているイラストを描いてください\n２．シチュエーションのイメージ的には以前描いていただいたこのイラスト(https://x.com/arata_yasiki/status/1891033104053092575/photo/1)を元に、エルデリーゼがハート型のクッションを抱いて想い人の事を想って照れている表情でいる感じです。\n\n\n【備考】\nそれ以外の構図等はお任せします。\nもし金額・工数に見合わなかったり、シチュエーション等で内容が描きずらい等あれば「再送依頼」もしくはキャンセルまたは、八式 あらた様の裁量で変更・アレンジしてOKです。\n\n\n対応可能でしたら何卒よろしくお願い致します。\n\nhttps://drive.google.com/drive/folders/101Mx-2tLlIuO9EnHNG9NR0hQOM6csDYG?usp=sharing", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@arata_yasiki/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2707642, "client_id": 288669, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/09dfdd8c/uploads/origins/000cb43d-c6c3-4a90-8371-713c1c65320d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=153b68221cab1136f9771130e258568f", "srcset": "https://si.imgix.net/09dfdd8c/uploads/origins/000cb43d-c6c3-4a90-8371-713c1c65320d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=153b68221cab1136f9771130e258568f, https://si.imgix.net/09dfdd8c/uploads/origins/000cb43d-c6c3-4a90-8371-713c1c65320d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=95798946946b4fe6f29e78bda090b3a7 2x, https://si.imgix.net/09dfdd8c/uploads/origins/000cb43d-c6c3-4a90-8371-713c1c65320d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d192383541d170f7c093311dbd83b144 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/09dfdd8c/uploads/origins/000cb43d-c6c3-4a90-8371-713c1c65320d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0e513755b8615cceab331cd388adcce3", "srcset": "https://si.imgix.net/09dfdd8c/uploads/origins/000cb4