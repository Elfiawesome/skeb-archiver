41/uploads/origins/972d6348-7b19-4e52-86fd-f5c6b71257c4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1a45b461536812fcad967bac4f46255c", "srcset": "https://si.imgix.net/619c3241/uploads/origins/972d6348-7b19-4e52-86fd-f5c6b71257c4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1a45b461536812fcad967bac4f46255c, https://si.imgix.net/619c3241/uploads/origins/972d6348-7b19-4e52-86fd-f5c6b71257c4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ed065399682d980d81d970e825783e67 2x, https://si.imgix.net/619c3241/uploads/origins/972d6348-7b19-4e52-86fd-f5c6b71257c4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=7f59c0c8e0b6fd0593e6fb1b1a86ee02 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/619c3241/uploads/origins/972d6348-7b19-4e52-86fd-f5c6b71257c4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=eae807d057bf5a2cce1931819c6992ed", "srcset": "https://si.imgix.net/619c3241/uploads/origins/972d6348-7b19-4e52-86fd-f5c6b71257c4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=eae807d057bf5a2cce1931819c6992ed, https://si.imgix.net/619c3241/uploads/origins/972d6348-7b19-4e52-86fd-f5c6b71257c4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=7979c09b9d0fb80409a88202740f53ee 2x, https://si.imgix.net/619c3241/uploads/origins/972d6348-7b19-4e52-86fd-f5c6b71257c4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=263ea309c13b861a95360194a8563f61 3x"}, "body": "はじめまして! 先生の作品がとても好きので、この度リクエストさせて頂きました。\n\nキャラクターについて:\n\n「Chernot Collins」\n182cm  枢機卿\n\n中央の枢機卿です。自分の野心や攻撃性をうまく隠し、甘言で人の心を惑わす、本人は巧みに言葉で要点をぼかすのが得意ですが、実際に嘘をついたことは一度もありません。\n野心や欲望を持っている反面、心の弱い部分を捨てられず、自分の生徒に対して曖昧な感情を持っていて、その偽りのない「愛」に彼自身も気づいていませんでした。\n\n「Emerold Linton」\n168cm  神父/元貴族\n\n内気で温和な青年で、見た目はとても伝統的で優しい神父ですが、実はかなり反抗的で不作法なこともしますし、顔が単純なので誰も疑いません。\n自分の先生(Chernot Collins)に密かな恋心を抱いており、それをうまく取り繕ったつもりでも、相手には完全に見抜かれていました。先生に対して盲信的な態度で、自分が間違っていることはわかっていてもコントロールできません。\n\n\n二人の関係: \n\n元は先生と生徒の関係です。「Chernot」は「Emerold」の家族を利用するために「Emerold」の家庭教師になりました。\n「Emerold」は家族が滅びた後、何も知らずに神父になりました。\n\n\n欲しい要素は「死のダンス」です。ご自由に描いてください！\n\nキャラ衣装の変更をしても構いません。\n\n金額が不足でしたら追加も可能です。\nご検討よろしくお願いいたします。\n\nhttps://drive.google.com/drive/mobile/folders/1SwX-F3X-MT-tGMlBR0FCWblO18YerXhh?sort=13&direction=a", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@keya_642/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3518439, "client_id": 3053006, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/885e356d/uploads/origins/bc81ba6a-23e9-4b80-bb25-a561cb7ebb6a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9868668b986b84c4a8400f679c644600", "srcset": "https://si.imgix.net/885e356d/uploads/origins/bc81ba6a-23e9-4b80-bb25-a561cb7ebb6a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9868668b986b84c4a8400f679c644600, https://si.imgix.net/885e356d/uploads/origins/bc81ba6a-23e9-4b80-bb25-a561cb7ebb6a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=7376c8478dd28c14d35928accdaa2998 2x, https://si.imgix.net/885e356d/uploads/origins/bc81ba6a-23e9-4b80-bb25-a561cb7ebb6a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ff8ac55296b27f18e6edcb0da7797d6d 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/885e356d/uploads/origins/bc81ba6a-23e9-4b80-bb25-a561cb7ebb6a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=fde8041b73e741656ace0272925c5265", "srcset": "https://si.imgix.net/885e356d/uploads/origins/bc81ba6a-23e9-4b80-bb25-a561cb7ebb6a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=fde8041b73e741656ace0272925c5265, https://si.imgix.net/885e356d/uploads/origins/bc81ba6a-23e9-4b80-bb25-a561cb7ebb6a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=33779254b89448acfde9d47b1f2a1ca5 2x, https://si.imgix.net/885e356d/uploads/origins/bc81ba6a-23e9-4b80-bb25-a561cb7ebb6a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=cfb91afe1b4db30408344aab36920f02 3x"}, "body": "こんにちは、芥屋枯木先生！あなたの画風がとても好きなので、私のOCのイラストをお願いしたいです！大胆な構図も大歓迎です。\n私のキャラクターは様々な世界観を持っています。オリジナルの中世の時間軸を記載しました。服装や設定などは、このパロや他のパロと繋げて描くことも可能です！以下、説明文です：\n\n背景中世ヨーロッパ、どちらも貴族とカルト信者。\n\nキャラクター\nA（レイス，185cm，攻め）：\n養父、短い銀髪とスカイブルーの瞳。\nかつては穏やかな領主だったが、祖国からの裏切りにより復讐に妄執。性格は冷淡でプライドが高く、貴族としての気品と冷静さを持ち合わせている。英雄の称号を背負えるとは思っておらず、復讐のために人間としての善良さを犠牲にした。しかし、イザヤが常に彼を唯一の英雄と見なしていたからこそ、彼は心を動かされ、救済されたのだ。\n\nB（イザヤ，178cm，受け）：\n養子、明るい銀色の三つ編み、バラ色の赤い目。\n父親がレイズの部下であったため、幼少期から大人になるまでレイズが彼のヒーローであった。戦争とホームレス生活で信仰心は崩壊し、無関心な性格になっていた。しかし、若き日の英雄との出会いによって、彼はライズのきめ細かな配慮に救われ、ライズの復讐計画の完遂に協力することを決意する。\n\n互いの傷を舐め合いながら、互いを慰めるために集まった孤独な二人。表面的には、Aの方が冷静で寡黙に見え、Bの方が優しいように見える。しかし実際は、Aの方が穏やかで理性的であり、Bの方は狂気と猛烈な忠誠心を持ち、Aのためにすべてを犠牲にすることを厭わない。\n二人の関係は、AはBを指導し、BはAに服従するという、一種の支配者／被支配者のようなものだ。\n\nストーリーの詳細：（理解を深めるために書いただけなので、読み飛ばしてもらって結構です。）\nAは深く裏切られ、復讐に執念を燃やし、邪神の力を使って国を滅ぼすことさえ厭わなくなったが、Bは決してAを見捨てなかった。Bは何度もAを奈落の底から引き戻し、Aが最後の人間らしさを保てるように手助けした。もともとBは生きる気などなかったが、Aの気遣いと愛情があったからこそ、Aが大改革を成し遂げるために自らを犠牲にすることも厭わなかった。Aは国を滅ぼそうとし、Bは前向きな変化をもたらそうとする傾向があったにもかかわらず、二人は優しさの道を選び、狂信者のような狂人の姿にさえなった。二人は邪神を欺き、自らの苦しみと痛みで邪神の視線を引きつけ、邪神をBの身体へと導いた。そして、Bは強い意志の力で邪神の意識を抑え込み、邪神の力を自分のために利用した。邪神の力を使って、彼らは皆に自分の内面や国家の腐敗と向き合わせた。二人は協力して計画を練り、一人は公の場で、一人は闇の中で別々に実行し、最終的に国に前向きな改革をもたらすことに成功した。\nラストシーンでは、革命軍が王都に侵攻するのに十分な時間を遅らせるため、2人は自らを囮にする。二人は一緒にノートルダム大聖堂の鐘楼の上に \"舞台 \"を設置し、カルトを装ってすべての敵の注目を集める。邪神計画の失敗が明らかになった後、AとBは計画通り、鐘楼から飛び降りて死を偽装し、革命を成功させるために王都に戻る。\n\n\n彼らの物語は、贖罪、復讐、野心、そして国の未来のために自らを犠牲にするというテーマについて描かれている。\nそれはまた、神と対峙するときの「人間讃歌」は「勇気」の讃歌ッである。\n\n\n\n宗教的な、あるいは運命的な雰囲気に満ちたシーンを見てみたい。\nその他はお任せします！あなたのインスピレーションを自由に描いてください！\nもし金額が合わないと感じたら、再送してもいいし、拒否しても構わない！\n\nhttps://drive.google.com/drive/folders/1WSZhqSom99pW1G7WVK6f-gE-9RL5oHvn", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@keya_642/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3518439, "client_id": 2462364, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/d2bdee40/uploads/origins/1bf33eef-028f-4951-bd8e-787ba33b56f2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e7f1602f826fa05e0c6e13be3da411a2", "srcset": "https://si.imgix.net/d2bdee40/uploads/origins/1bf33eef-028f-4951-bd8e-787ba33b56f2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e7f1602f826fa05e0c6e13be3da411a2, https://si.imgix.net/d2bdee40/uploads/origins/1bf33eef-028f-4951-bd8e-787ba33b56f2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=9caf2c6f540e3deea93be5eff760461f 2x, https://si.imgix.net/d2bdee40/uploads/origins/1bf33eef-028f-4951-bd8e-787ba33b56f2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=958984f9da017467f7a597c990af2ede 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/d2bdee40/uploads/origins/1bf33eef-028f-4951-bd8e-787ba33b56f2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9dcc855a1739573fc9e0aaaba4cf417c", "srcset": "https://si.imgix.net/d2bdee40/uploads/origins/1bf33eef-028f-4951-bd8e-787ba33b56f2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9dcc855a1739573fc9e0aaaba4cf417c, https://si.imgix.net/d2bdee40/uploads/origins/1bf33eef-028f-4951-bd8e-787ba33b56f2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=3db7d51802e552290fc08cc941840975 2x, https://si.imgix.net/d2bdee40/uploads/origins/1bf33eef-028f-4951-bd8e-787ba33b56f2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=43d58517329a0a3ec981b2cb79ddfeb3 3x"}, "body": "こんにちは、先生！またまたお邪魔してしまい、大変申し訳ありません！前回の絵がとても素敵だったので、今回は出来ればもう一組のcpの絵をお願いしたいです！URLの写真31にある二人の服装を描いてほしいです（この服装の絵が嫌だったら、他のものでも構いません！）。\n\n西洋ファンタジーの設定で私のocを簡単に説明します↓。\nドラゴン×魔女\n龍之介：傭兵に変装して使われる黒髪緑目の邪龍。普段は冷静沈着だが、椎名に対しては少々意地悪な態度をとり、椎名を怖がらせながら自分の細かい欲求を満たすことを好む。椎名が魔女であることを知ってからは、それ以上の行動に出ることも多いが、相手に危害を加えるつもりはなく、ただ椎名が自分を怖がって懇願する姿が好きで、相手をかわいいと思っているだけである。\n椎名：黒髪赤目の男性魔法少女で、人間と一緒に暮らしているが、魔法少女であるために迫害され、あちこちを転々としている。やや常識に欠け、魔法薬作りに執念を燃やす。近くの森にドラゴンがいると聞いたため、竜之介を雇う前にドラゴンの鱗を手に入れようとしたが、相手が自分の探している対象だとは気づかず、今では相手に無理やり縛られ、からかわれながらペットとして育てられている。\n\n西洋ファンタジー風は苦手という人は、日常的な普段着風でもまったく問題ない！\n相手の性格の範囲内であれば、どんなやり取りを描いてもOKです！ 金額に満たない場合は、再度リクエストを送っていただけると助かります！この度はご依頼をお受けいただき、誠にありがとうございました！\n\nhttps://drive.google.com/drive/folders/1si0qXG7Z7HBkuJkpGrP4VP42MaZHP5zr?usp=share_link", "nc": 9, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@keya_642/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3518439, "client_id": 3526015, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/1f82c624/uploads/origins/5cee7302-5588-4e31-bcff-f4acee0944e5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=79f5fb88d5fab0bd3bc33ea3e052be18", "srcset": "https://si.imgix.net/1f82c624/uploads/origins/5cee7302-5588-4e31-bcff-f4acee0944e5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=79f5fb88d5fab0bd3bc33ea3e052be18, https://si.imgix.net/1f82c624/uploads/origins/5cee7302-5588-4e31-bcff-f4acee0944e5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=6133444d0413b0f4b5aec4f168199c9f 2x, https://si.imgix.net/1f82c624/uploads/origins/5cee7302-5588-4e31-bcff-f4acee0944e5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s