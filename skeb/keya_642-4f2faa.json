00&s=53fc990ebf729111b063b7be9cbcfb86, https://si.imgix.net/5d2c2d8d/uploads/origins/e9e93f15-d959-4f35-b402-8a574f8bd111?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ca7a2d9c2ec4af08214f2a870f77f48a 2x, https://si.imgix.net/5d2c2d8d/uploads/origins/e9e93f15-d959-4f35-b402-8a574f8bd111?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=44694bd64ed0d427ba0d5675e3d58dc8 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/5d2c2d8d/uploads/origins/e9e93f15-d959-4f35-b402-8a574f8bd111?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=58a507da588a9c9a0ab60fa138c47a20", "srcset": "https://si.imgix.net/5d2c2d8d/uploads/origins/e9e93f15-d959-4f35-b402-8a574f8bd111?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=58a507da588a9c9a0ab60fa138c47a20, https://si.imgix.net/5d2c2d8d/uploads/origins/e9e93f15-d959-4f35-b402-8a574f8bd111?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=4a9aae1e0687fc30bc7cdb5fead4ddb0 2x, https://si.imgix.net/5d2c2d8d/uploads/origins/e9e93f15-d959-4f35-b402-8a574f8bd111?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=b9d97d38165c2e874a42ef8eb387a950 3x"}, "body": "芥屋枯木様、初めまして! \n\nとても可愛いらしいく素敵な作品を拝見させていただきました。リクエスト失礼いたします...!!できれば私のキャラクター【カレンデュラ】を描いていただきたいと思います。 \n\n資料URLに画像を添付したので参考にしてください。 \n\n【カレンデュラについて】\n・見た目は17歳くらい、158cm。実は不老者です。\n・魔法使い学院を卒業した正式な魔法使い、占いと植物魔法が得意です。\n・首都の小さい庭付き店舗を経営しています。主に薬を売りますが、時々老顾客の占いもします。店の2階に住んでいます。\n・目が悪いので、眼鏡をかけています。ちょっとそそっかしい人です。\n・日当たりのいい日に、庭でお茶を飲み、本を読むのが好きです。庭の動物たちの世話をしています。\n・あの一角のウサギは彼女の使い魔です。\n・にぎやかな街が好きで、静かな森も好きです。 \n\n【性格】\n・大体優しくて活発な人でした。\n・冷たいところもあります。嫌いな人にはとても態度が悪いんです。\n・気が短い。 \n\n【表情】\n・ぼんやりしたり緊張している時は、無表情になります。その無表情の様子が冷たく見えるとよく言われます。\n・笑顔がかわいい。\n・表情のない顔や優しく笑っている顔が主です。でも怒り、笑い、泣き、そして悪人のような表情も全てOKです。 \n\n【服装】\nキャラクターの衣装デザインは4種類ありますので、お好きなものの1つ選んで描けばいいのです！ \n\n【ポーズ】\n可能であれば全てお任せでお願いしたく思います。構図やポーズも、任せたいです！ \n\n【その他】\nもし背景等いただけるようでしたら、人物のみの透過デートをいただけましたら嬉しいです。 \n\n長文をここまで読んで頂き、ありがとうございました。\nもし金額が適切でなかったり、他に何か問題がありましたら是非お知らせ下さい。改めてリクエストをお送りいたします。\n何卒ご検討いただければと思います！\n\nhttps://drive.google.com/drive/folders/1-0V_RkEnBCmPeOuzjIXOh4IsM8fBrbZj\n\nhttps://drive.google.com/drive/folders/1-0V_RkEnBCmPeOuzjIXOh4IsM8fBrbZj", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@keya_642/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3518439, "client_id": 2462364, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/6a19e0a4/uploads/origins/400b3bd4-32a9-4a8f-93da-5209ee1ac500?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2cd6b605a596a4e3751725d955babd04", "srcset": "https://si.imgix.net/6a19e0a4/uploads/origins/400b3bd4-32a9-4a8f-93da-5209ee1ac500?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2cd6b605a596a4e3751725d955babd04, https://si.imgix.net/6a19e0a4/uploads/origins/400b3bd4-32a9-4a8f-93da-5209ee1ac500?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=8d729ef55c3b538c14b8cb6773ee1283 2x, https://si.imgix.net/6a19e0a4/uploads/origins/400b3bd4-32a9-4a8f-93da-5209ee1ac500?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=7fe84a7ba611a779c0a098e6170ac819 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/6a19e0a4/uploads/origins/400b3bd4-32a9-4a8f-93da-5209ee1ac500?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=81cf8ef9b815db4a5186e357909ef1d2", "srcset": "https://si.imgix.net/6a19e0a4/uploads/origins/400b3bd4-32a9-4a8f-93da-5209ee1ac500?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=81cf8ef9b815db4a5186e357909ef1d2, https://si.imgix.net/6a19e0a4/uploads/origins/400b3bd4-32a9-4a8f-93da-5209ee1ac500?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=02f9dc340282de6f96f3cff47f0ba68c 2x, https://si.imgix.net/6a19e0a4/uploads/origins/400b3bd4-32a9-4a8f-93da-5209ee1ac500?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=a4ab7a21706dd24203111fd9904a72be 3x"}, "body": "こんにちは、マスタードハウス・デッドウッドさん！お忙しいところ大変申し訳ありません！今回の依頼は、できれば私のocのために、あなたの選んだ衣装とインタラクティブな内容のイラストを描いていただきたいのです。\n\n↓ 以下、簡単な性格と要望です。\n\nいずれも20世紀\n(下）コンスタンティン：24歳、金髪、赤い瞳孔、182cm、長身痩躯、優雅な態度。コンスタンチーヌは貴族で、家はとても裕福、両親と兄は彼をとても愛している。貴族気質で、高慢で自尊心が高く、人に優しく接するが、人に距離を感じさせることもある。大学を早々に卒業し、文学の道に進んだ彼は、文筆業でもジャーナリズムでも中心的な存在であり、その頭の良さから警察から事件の捜査協力を依頼されることもある。ヴィラカスに憧れ、その憧れは後に秘密を共有したことで好意を抱くようになる。\n\n(上）ヴィラカス：21歳、186cm、茶色の少しカールした髪、緑の目、標準的な体格、穏やかで礼儀正しい。ヴィラカスは裕福な家庭の平民で、コンスタンティンの助手である。コンスタンティンに憧れ、相手の通信社に応募に来たところ、アシスタントに抜擢された。コンスタンチンの日常生活や生活の世話をし、非常に従順で、忠犬のような性格に見え、コンスタンチンをとても頼りにしている。\n\nどのようなコスチュームで描くかは自由です！(西洋ファンタジーの設定が好きなら、写真28のコスチュームを選んでもいい！もちろん、他のコスチュームもあります！)\n\n金額に満たない場合は、再度リクエストを送っていただけると助かります！また、ちょっとめんどくさいと思ったらキャンセルも可能です。この度はお引き受けいただき、誠にありがとうございました！\n\nhttps://drive.google.com/drive/folders/1mP_-_aYjvuPUdyoPB12Sek3bUxpMOry1?usp=share_link", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 1591911, "creator": true, "nsfw_acceptable": false, "acceptable": false, "name": "某", "screen_name": "nanigashi72", "avatar_url": "https://pbs.twimg.com/profile_images/1423291000437440512/nr-g-Ksp.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1423290543216365572/1720981827/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 100, "skills": [{"genre": "art"}], "nc": 129}, {"id": 2066457, "creator": true, "nsfw_acceptable": false, "ac