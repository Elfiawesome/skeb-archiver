net/7c283d50/uploads/origins/d932eb2b-f7ae-488b-9a1f-e4c834cf4d5c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=470b167944c24d0b23723d0ff094ac9c", "srcset": "https://si.imgix.net/7c283d50/uploads/origins/d932eb2b-f7ae-488b-9a1f-e4c834cf4d5c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=470b167944c24d0b23723d0ff094ac9c, https://si.imgix.net/7c283d50/uploads/origins/d932eb2b-f7ae-488b-9a1f-e4c834cf4d5c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=6d0e1e1e51318c3476f59cce9d073635 2x, https://si.imgix.net/7c283d50/uploads/origins/d932eb2b-f7ae-488b-9a1f-e4c834cf4d5c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a5512428c2f93f8e42a97bfe5a88f6f1 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/7c283d50/uploads/origins/d932eb2b-f7ae-488b-9a1f-e4c834cf4d5c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d110215f7415c6480049207a482bc1e3", "srcset": "https://si.imgix.net/7c283d50/uploads/origins/d932eb2b-f7ae-488b-9a1f-e4c834cf4d5c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d110215f7415c6480049207a482bc1e3, https://si.imgix.net/7c283d50/uploads/origins/d932eb2b-f7ae-488b-9a1f-e4c834cf4d5c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=a94a0066b1f1254fca92683c6df2bf49 2x, https://si.imgix.net/7c283d50/uploads/origins/d932eb2b-f7ae-488b-9a1f-e4c834cf4d5c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=3e3e0f10a157dd4f9deea83682dd0748 3x"}, "body": "Owozora様、はじめまして。\n個人勢VTuberとして活動しております、はいちゃんらと申します。\n\n以前より拝見しておりました、Owozora様の他にないイラストに深く惹かれ、ぜひ私のイラストを描いていただきたくリクエストをお送りいたしました。\n\n【キャラクター詳細】\n・名前：はいちゃんら（紫猫のVTuber）\n・髪型：パステルパープルのショートヘアにグリーンのメッシュ\n・瞳：紫色（ピンクと紫のグラデーション）\n・特徴：猫耳\n（※普段はチャイナメイド服ですが、今回は以下の特別な衣装・テーマでお願いしたいです）\n\n【リクエスト内容】\n・テーマ：やぎ座をモチーフにした、少し神秘的なタロットカード風のイラストに仕上げていただけると嬉しいです。\n・衣装：星座に見合った神秘的な衣装。Owozora様が描きやすく、筆が乗りやすいデザインや構図であれば、ぜひお任せしたいです！\n・構図：YouTubeのサムネイルや各種グッズ等の商用利用を想定しているため、「頭の先や顔周りが切れていない（余白を持たせた）」状態で描いていただけますと大変助かります。\n\n【使用用途】\n・YouTube等の配信活動（サムネイル、配信画面、動画内）\n・SNSへの投稿（※必要に応じて透かしを入れて使用いたします）\n・グッズ制作\n・メンバーシップ限定の壁紙配布\n※使用の際、原型を留める範囲でのトリミングや色調調整などの加工をさせていただく場合がございます。\n\n【納品データ・ご相談】\n・データ形式：キャラクターや背景を分けて切り出せるよう、「PSDデータ」でいただけますと幸いです。\n・差分：もし可能であれば、メンバーシップ限定の壁紙配布のためにOwozora様が対応可能な差分（表情差分など）をいただけますと大変喜びます。（※追加費用やオプション料金が発生する場合は、お戻しください）\n\nお忙しいところ恐縮ですが、Owozora様の描く「はいちゃんら」を見てみたい一心でリクエストさせていただきました。\nスケジュールや諸条件が合いましたら、ぜひご検討いただけますと幸いです。\n\n何卒よろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/1QlqkgADXqeNsJBDeZPpDq88N1y7NHgrQ?usp=sharing", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Owozora/works/14", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 4094747, "client_id": 4131215, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/b035b321/uploads/origins/07906df9-eccc-43a0-ad1b-544d8a28d6c6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f18462dfe1c65dd507e7d9eb2656df9f", "srcset": "https://si.imgix.net/b035b321/uploads/origins/07906df9-eccc-43a0-ad1b-544d8a28d6c6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f18462dfe1c65dd507e7d9eb2656df9f, https://si.imgix.net/b035b321/uploads/origins/07906df9-eccc-43a0-ad1b-544d8a28d6c6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=6cec17c7f2a34df63d6c6f47e87e6d17 2x, https://si.imgix.net/b035b321/uploads/origins/07906df9-eccc-43a0-ad1b-544d8a28d6c6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=8ec2c4b628f2ddf93f48eaebe446b4a7 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/b035b321/uploads/origins/07906df9-eccc-43a0-ad1b-544d8a28d6c6?bg=%