す。\n腰あたりにある変身用モチーフを使用して変身するという設定です。\n参考資料は以下になります。\nhttps://drive.google.com/drive/u/1/folders/1C_zDYYeRV9woC5yn7QjIobqPIEZ7qCOl\n\n【使用用途】\n・Vtuber活動でのSNS投稿やアイコン、ヘッダー\n・配信時サムネイル\n\n【その他】\nサムネイルで使用させていただきたいため、頭部や髪の毛・腕等が切れないようにしていただけますと幸いです。\n納品形式は可能でしたら人物・背景・宛名を分けたpsdデータもしくはpngでの納品だと大変助かります。\n\nお忙しいところ恐縮ですが、ご検討のほどどうぞよろしくお願いいたします。\n\nhttps://drive.google.com/drive/u/1/folders/1C_zDYYeRV9woC5yn7QjIobqPIEZ7qCOl", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Owozora/works/9", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 4094747, "client_id": 215068, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/0130365f/uploads/origins/bfb9652f-ee47-4822-b5af-ada318029ec4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5b4efc91825059249fa177ee511c3a91", "srcset": "https://si.imgix.net/0130365f/uploads/origins/bfb9652f-ee47-4822-b5af-ada318029ec4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5b4efc91825059249fa177ee511c3a91, https://si.imgix.net/0130365f/uploads/origins/bfb9652f-ee47-4822-b5af-ada318029ec4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=3dee0fd55fb5f034e086d7100af55c16 2x, https://si.imgix.net/0130365f/uploads/origins/bfb9652f-ee47-4822-b5af-ada318029ec4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=8e09815a196c37edd8ee2707c7f4ba18 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/0130365f/uploads/origins/bfb9652f-ee47-4822-b5af-ada318029ec4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6cbccfceb22438a9ccd9cd0b165da08c", "srcset": "https://si.imgix.net/0130365f/uploads/origins/bfb9652f-ee47-4822-b5af-ada318029ec4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6cbccfceb22438a9ccd9cd