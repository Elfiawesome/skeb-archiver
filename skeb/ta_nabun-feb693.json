w=200&h=200&s=91b3554a106e6fe29568516b2abb0d4f 2x, https://si.imgix.net/ccff5343/uploads/origins/9f1f37de-86cc-4ef0-9885-174310e86a20?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=128ed2acd86942d3e6e1dd2e7f2946d2 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/ccff5343/uploads/origins/9f1f37de-86cc-4ef0-9885-174310e86a20?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=761df73787ea918af82efd9a9143b622", "srcset": "https://si.imgix.net/ccff5343/uploads/origins/9f1f37de-86cc-4ef0-9885-174310e86a20?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=761df73787ea918af82efd9a9143b622, https://si.imgix.net/ccff5343/uploads/origins/9f1f37de-86cc-4ef0-9885-174310e86a20?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=94600daf78ae6800463cd887e1a95bff 2x, https://si.imgix.net/ccff5343/uploads/origins/9f1f37de-86cc-4ef0-9885-174310e86a20?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=9ba5d8c123d5f65acb4f88a0801bd8ee 3x"}, "body": "再度依頼致します！今回もたな分さんに私の書いているFGOとマーベルコミックスのSSのコミカライズでございます！\n\n今回コミカライズして欲しいのは下記のリンクの話です。\nhttps://syosetu.org/novel/285032/41.html\n\n冒頭から始まり、最後にモーガン・ル・フェイが登場する場面で〆てください。\n\n※モーガン・ル・フェイというのはマーベル世界におけるモルガンの事で、カルデアの\nモルガンと区別する為に便宜上モーガンと呼称しています。\n\n\nこの回では成長したリサとデビッド(パニッシャーの娘と息子)が登場するのですが、両者の容姿については\n以前に私が依頼した絵師様が描いたデザインを参考にしてくださいませ。パニッシャーの妻であるマリアも\n同じくです。\nhttps://www.pixiv.net/artworks/106713862\n\n\nガレスちゃんに関しては第1臨の霊衣でお願いします。パニッシャーは身長191cm、体重102kgと結構な大男なので、ガタイもガレスちゃんが見上げるぐらいに大きくしてください。\n\nモーガン・ル・フェイの容姿と服装に関してはマーベル非公式データベースの彼女の画像を参考に\nしてください。\n\nhttps://marvel.fandom.com/wiki/Morgan_Le_Fay_(Earth-616)\n\n※へそ出しなのはカルデアのモルガン陛下と共通しておりますw\n\n\nシミュレータールームでの成長した家族の姿はモーガンが作り出したやつなんですが、それに心を動かされてしまうパニッシャーさんと、彼に寄り添うガレスちゃんを描写してください。パニッシャーさんが家族の元を去る際に涙を流すのですが、彼の目は映さず頬に一筋の涙が流れるという感じにしてください。パニッシャーさんの服装は以前と同じ黒いロングコートスタイルです。", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@ta_nabun/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "comic", "tipped": true, "creator_id": 2681558, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/7d46778e/uploads/origins/9738bf64-6c99-49bb-8eb5-84845e00c70e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fb216cee248362ac36d75499491f3a2e", "srcset": "https://si.imgix.net/7d46778e/uploads/origins/9738bf64-6c99-49bb-8eb5-84845e00c70e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fb216cee248362ac36d75499491f3a2e, https://si.imgix.net/7d46778e/uploads/origins/9738bf64-6c99-49bb-8eb5-84845e00c70e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=2cd6f9e05f5f6d7cc1345b641cc2246f 2x, https://si.imgix.net/7d46778e/uploads/origins/9738bf64-6c99-49bb-8eb5-84845e00c70e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d0d26c56be43fe3a37e7007c5c926997 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/7d46778e/uploads/origins/9738bf64-6c99-49bb-8eb5-84845e00c70e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d625bb0f5e719b3bcbe99db969a9525b", "srcset": "https://si.imgix.net/7d46778e/uploads/origins/9738bf64-6c99-49bb-8eb5-84845e00c70e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d625bb0f5e719b3bcbe99db969a9525b, https://si.imgix.net/7d46778e/uploads/origins/9738bf64-6c99-49bb-8eb5-84845e00c70e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=c289ad9aa2ce21b6ba29ab09cd99cbda 2x, https://si.imgix.net/7d46778e/uploads/origins/9738bf64-6c99-49bb-8eb5-84845e00c70e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=7d99809e77944be42d3537dcc65c511d 3x"}, "body": "FGOからネロ・クラウディウス、髪型はツインテール\nオリンピアでの敗北の責任を取らされ下着姿のまま公務をする羽目になり\n移動中の馬車内で兵士に下着の上から恥丘をつままれ、弄られる（アップで）\n赤面しながら睨みつけるが目的地に到着し民衆の前で演説の支度をしていると市民が通りすがりにネロの性器をパンツの上から撫でるがネロは笑いながら手を払う。\n市民は目線を部下が運んでいるカゴへと移すと其処には無断で自室から持ち出された複数のパンツが入れられてネロは驚愕する。\n背後からやってきた兵士にパンツの中に手を突っ込まれ、市民たちはどよめく。\nその状態のまま演説を開始する。\n快楽を我慢しながら演説を続けるも兵士はお構いなしに手を突っ込んだままでクリ責めに移行する。\n演説の端々で甘い吐息を漏らす。\n何とか平常を保ち公務を終えるが、よそ見をしていた子供とぶつかりブラが外れた胸を鷲掴みされる形で転倒する。\n興奮し勃起した小さなペニスをネロのパンツの上から擦り付ける。\n市民が少年を引き離し事無きを得るが、すかさず市民の一人によって再びパンツの中に手を突っ込まれイかされ潮を吹く。\n全身に力が入らず、その場で倒れこみそうになるが市民に支えられ何とか立ち上がるもおもむろにネロの腰を両手でつかむとパンツを履いたまま後背位の体勢で挿入しビストンし始める。\n思いもよらぬ事態に理解が追い付かず混乱する。\n周囲にいる民衆はネロの部下が持ってきたかごからそれぞれ違う（デザインはお任せします）パンツを持ち出して自身のペニスに被せネロの両手でそれぞれパンコキをさせる。\n少年も一枚持ち出しソレを使いネロの眼前で自慰行為に耽る。\n自身が辱められている状態と少年の行動によって涙目になる。\n男のビストンはより激しさを増し、最早声を抑えることは出来ずに喘ぎ声を上げる。\nネロを含めた全員がほぼ一斉に絶頂を迎え後ろの男は中に出し（断面図）、少年の精子はネロの頬にかかる。\n一晩をその街で過ごしたネロは、翌日朝の散歩に出かけていると昨日の少年にお尻を触られる。\n一緒に散歩をしようと提案する。\n少年は下半身を露出させ、前日に拝借していたネロのパンツを被せ勃起した状態のペニスを無理やりネロに握らせる。\n左手はネロのパンツの中で性器を愛撫している。\nネロは赤面しうつむく。\nといった内容でお願いいたします。", "nc": 57, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@ta_nabun/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2681558, "client_id": 3043837, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/4b3025a8/uploads/origins/b2303b8e-7495-4107-961d-c601805a5693?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=cddc60f83027320009b643648d3d2e85", "srcset": "https://si.imgix.net/4b3025a8/uploads/origins/b2303b8e-7495-4107-961d-c601805a5693?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=cddc60f83027320009b643648d3d2e85, https://si.imgix.net/4b3025a8/uploads/origins/b2303b8e-7495-4107-961d-c601805a5693?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ba565d567c07029131735574a3a32a57 2x, https://si.imgix.net/4b3025a8/uploads/origins/b2303b8e-7495-4107-961d-c601805a5693?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=13bd7cf6ec6236d41d93865eb190f621 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/4b3025a8/uploads/origins/b2303b8e-7495-4107-961d-c601805a5693?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6ea67ca0682a08a991c8ed4e5fd96630", "srcset": "https://si.imgix.net/4b3025a8/uploads/origins/b2303b8e-7495-4107-961d-c601805a5693?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6ea67ca0682a08a991c8ed4e5fd96630, https://si.imgix.net/4b3025a8/uploads/origins/b2303b8e-7495-4107-961d-c601805a5693?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=e98325ab10d2a4cda6caac7f0990dfa2 2x, https://si.imgix.net/4b3025a8/uploads/origins/b2303b8e-7495-4107-961d-c601805a5693?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=e942079b40aa1dee90a2cba8db01299f 3x"}, "body": "失礼致します。\n先生の漫画が好きで、よく拝見しております。\n今回はもし宜しければ、少しH要素が含んだ漫画をリクエストさせて頂きます。\n少々のカップリング要素ありです。\n\nキャラ　FGO ガウェイン×バーゲスト\n\n大まかな題材としては、事件後のハワトリアでラキスケの呪いにかかったガウェインがバゲ子に対して事あるごとにラキスケを起こしまくり、最終的に我慢できずガウェインのエクスカリバーがガラティーンしてしまう、の様な感じのお話でお願いします。\n\n大まかなシチュ\n\n・ガウェインがよろけてマリアナ海溝ぐらい深くて長い谷間にどぼぉん！！\n\n・ビーチで誰もが目を引く特大の大玉スイカップをゆっさゆっさばるんばるんたっぷんたっぷんどっぷんどっぷん揺らしまくりながら遊んでいる。\n\n・水着の紐が耐えきれず生乳ポロリ。そして弾けた布切れを拾おうとして、突き出したお尻がとんでもなく際どい事になっている。\n\n・何かを取ろうとして、気付かず間違えておっぱいを鷲掴み。\n\n・お風呂でお互い全裸でバッタリ会う。\n\n・仕方なく一緒に入る事に。ぷかぷか浮かぶエベレスト、そしてはっきりと浮き出て見えるかなり大きめの頂を見たガウェインは、抑えていたエクスカリバーを遂にガラティーンさせてしまう。\n\n・聳え立つソレを目撃してしまうバゲ子。\n\n・結局抑えきれず、やる事はしっかりヤりまくった2人。\n\n・後日、風呂から獣みたいな声が聞こえると噂が立っていた。\n\n以上です。\n\n一応大まかな題材とシチュを提示させて頂きましたが、先生の描きやすい様にお好きに変更や追加をして頂いても構いません。細かい部分はお任せいたします。\n\nどうか、よろしくお願いします。", "nc": 185, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@ta_nabun/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2681558, "client_id": 2721266, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/58810bdb/uploads/origins/f21d5bc3-31c0-43af-9b04-5ae8abcab765?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=af6f37a5a6ad760efbe762b3e447a9bd", "srcset": "https://si.imgix.net/58810bdb/uploads/origins/f21d5bc3-31c0-43af-9b04-5ae8abcab765?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=af6f37a5a6ad760efbe762b3e447a9bd, https://si.imgix.net/58810bdb/uploads/origins/f21d5bc3-31c0-43af-9b04-5ae8abcab765?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=0c2c40de33f604d42c16054b9dfa0399 2x, https://si.imgix.net/58810bdb/uploads/origins/f21d5bc3-31c0-43af-9b04-5ae8abcab765?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=772460441b09f224ccafb2d18c4191aa 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/58810bdb/uploads/origins/f21d5bc3-31c0-43af-9b04-5ae8abcab765?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=db20c7e2edbf2a12aa5fcb82131c15fe", "srcset": "https://si.imgix.net/58810bdb/uploads/origins/f21d5bc3-31c0-43af-9b04-5ae8abcab765?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=db20c7e2edbf2a12aa5fcb82131c15fe, https://si.imgix.net/58810bdb/uploads/origins/f21d5bc3-31c0-43af-9b04-5ae8abcab765?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=b3d3baad8de09f1ce7703805ef0ac1bf 2x, https://si.imgix.net/58810bdb/uploads/origins/f21d5bc3-31c0-43af-9b04-5ae8abcab765?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=47a9dd0b2d7d5110d82d1384c2fa0dc2 3x"}, "body": "たな分様\n\nこんにちは。こちらからは、はじめまして。個人VTuberとして活動しております『彩葉 宴（いろは うたげ）』と申します。\n先日は、素敵なFAを描いて頂きありがとうございました！活動内で大切に使わせて頂いております。\n今回、すけぶさんの手数料無料キャンペーンが始まっておりましたので…この機会を利用して直接、私、彩葉宴が活動に使用するイラストをご依頼出来ないかと思い、リクエストを送らせて頂きました。\n\n\n──以下必要事項など──\n\n【ご依頼内容】\nわたくし、彩葉宴のイラストをご依頼出来たらと思います。\n詳しい容姿などは資料をGoogleドライブにて共有させて頂きたいと思いますので…お手数をおかけいたしますが、ご確認いただければ幸いです。\nチャームポイントの泣き黒子とギザ歯だけは変更しないで頂ければ幸いです。\n\n【ポーズや構図】\n今回は、私がyoutubeやTwitchなどで配信並びに投稿予定のFateシリーズ関係（主にFGOと今後発売予定のEXTRAリメイクなど）に使用もできる汎用のイラストを描いて頂けたら嬉しいです。\n衣装は、上記にも記載させて頂きましたが、FGO,Fate/EXTRAに使用したいなっと思っておりますので…マスターの礼装（大人の事情などあるかと思いますので）風のものを描いて頂けたら嬉しいな…と思っております。\n私が一番好きな作品の衣装である「月の海の記憶」,「月の裏側の記憶」,「2004年の断片」の様な制服が良いなっと思っておりますが…。たな分様が「これ、描きたいな！」という衣装がありましたら、そちらを描いて頂ければと思います。\n構図に関しては細かい所はおまかせでお願いいたします。ただもし可能であれば、色々な用途で使用させて頂きたいので左右・上が見切れていない構図、簡単な表情差分をつけて頂けると大変嬉しいです。\n\n【イラストの用途】\n・SNSの投稿、アイコン、ヘッダー、スケジュール、おはVなどの使用\n・収益化されていないYouTubeの生配信やサムネイルなどへの使用\n・収益化されていないTwitchなどの配信内での使用\n＊グッズ化などの商用利用は致しません。\n\n【その他】\n色々な用途で使用させて頂きたいと考えておりますので…人物・背景・サイン等はレイヤー分けをして頂けると助かります。\n(納品はPSDまたは PNGで頂けると幸いです)\n\nhttps://drive.google.com/drive/folders/1fveSLYHSvKiYSJG5V1I6GG7x8JPVcUK8?usp=drive_link", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@ta_nabun/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2681558, "client_id": 2197564, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/ee63946c/uploads/origins/ba6dd5a3-2021-4843-a84f-a72622a0f86a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9e0e3898be2066ed993354891063c968", "srcset": "https://si.imgix.net/ee63946c/uploads/origins/ba6dd5a3-2021-4843-a84f-a72622a0f86a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9e0e3898be2066ed993354891063c968, https://si.imgix.net/ee63946c/uploads/origins/ba6dd5a3-2021-4843-a84f-a72622a0f86a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b1e37f705969e16c36f4036f62351fd7 2x, https://si.imgix.net/ee63946c/uploads/origins/ba6dd5a3-2021-4843-a84f-a72622a0f86a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=849486d64deff2b61067701b5e2a1069 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/ee63946c/uploads/origins/ba6dd5a3-2021-4843-a84f-a72622a0f86a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=fd80ded8bbb94f7e446bf83983f27934", "srcset": "https://si.imgix.net/ee63946c/uploads/origins/ba6dd5a3-2021-4843-a84f-a72622a0f86a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=fd80ded8bbb94f7e446bf83983f27934, https://si.imgix.net/ee63946c/uploads/origins/ba6dd5a3-2021-4843-a84f-a72622a0f86a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=758844e339bee60b77fcd24e96f7d77f 2x, https://si.imgix.net/ee63946c/uploads/origins/ba6dd5a3-2021-4843-a84f-a72622a0f86a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=3215262c8ab843b4fb0e8d4aeb9d4181 3x"}, "body": "初めまして、ドレッジキングと申します！今回はたな分さんに私がハーメルンで投稿しているSSのコミカライズの依頼をしました。\nFate/Grand OrderとマーベルコミックスのパニッシャーのクロスオーバーSSであり、下記の話の一部分をコミカライズしてくださいませ。\n\nhttps://syosetu.org/novel/285032/28.html\nコミカライズの範囲は冒頭の部分からモレーの「はぁ……全く。この子ったら、あたしがキミを利用して怪物に仕立て上げた事を恨んでないのかねぇ？」までです。モレーがパニッシャーに銃撃された傷跡を見せる際はスカートをまくり上げる感じで、その際にモレーの下着が見えてしまい、人形状態の藤丸君が慌てる感じの描写でお願いします。パニッシャーはモレーに対してガチ目にキレており、それに対してシンデレラエリちゃんは彼を宥める形になります。以上で終わりです。コミカライズが完成したら是非ツイッター等のSNSに投稿をお願いします～\n\n実は既に他の絵師様にもコミカライズを依頼しております。パニッシャーの服装は黒いロングコートでお願いします。\nhttps://skeb.jp/@honchu76/works/1\nhttps://skeb.jp/@honchu76/works/3", "nc": 177, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@ta_nabun/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2681558, "client_id": 159317, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/1ee30b0a/uploads/origins/438a6547-1abc-4eb2-82c5-b3491c364b74?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8ebe761d46b923547028161911416a30", "srcset": "https://si.imgix.net/1ee30b0a/uploads/origins/438a6547-1abc-4eb2-82c5-b3491c364b74?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8ebe761d46b923547028161911416a30, https://si.imgix.net/1ee30b0a/uploads/origins/438a6547-1abc-4eb2-82c5-b3491c364b74?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c63012d2d9e7a68f0f8f704f79eb69e7 2x, https://si.imgix.net/1ee30b0a/uploads/origins/438a6547-1abc-4eb2-82c5-b3491c364b74?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=66494064f0e138ea7bd2d70730a7249a 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/1ee30b0a/uploads/origins/438a6547-1abc-4eb2-82c5-b3491c364b74?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a7270f9bd816edc8283b122366b3b1bc", "srcset": "https://si.imgix.net/1ee30b0a/uploads/origins/438a6547-1abc-4eb2-82c5-b3491c364b74?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a7270f9bd816edc8283b122366b3b1bc, https://si.imgix.net/1ee30b0a/uploads/origins/438a6547-1abc-4eb2-82c5-b3491c364b74?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=92fa132b6e2b30c1f6a053c26a7fe1c6 2x, https://si.imgix.net/1ee30b0a/uploads/origins/438a6547-1abc-4eb2-82c5-b3491c364b74?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=182367140917f319a3cae62ed2f6ec0e 3x"}, "body": "はじめまして。\n素手で戦うアルジュナのかっこいい漫画を拝見し、是非とも私の推しも書いて頂きたく思い、有償依頼を送らせていただきました。お忙しいところ申し訳ございませんが、以下の内容のイラストを書いて頂けませんでしょうか。\n\nキャラクター：源頼光（バーサーカー）・藤丸立香（ぐだ男）\n服装：源頼光（第二再臨）・藤丸立香（アニバーサリーブロンド礼装）\n\n服装等は上記のとおりで、刀を構え、マスターを守るように立つ頼光さんと、その後ろでいつでも令呪で支援できるように備える藤丸君のイラストをお願いいたします。親子感よりもコンビ感がつよくでているような雰囲気のイラストにして頂けると嬉しいです。\n\n以上です。\nお忙しいところ誠に恐縮ですが、何卒ご検討ください。", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@t