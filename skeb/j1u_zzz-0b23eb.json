son.ayame-miz.net/\n\n資料写真\nhttps://drive.google.com/drive/folders/1Zft94zEvibVZ-k8jg04gkIKsTGY89Ei0?usp=drive_link\n\nhttps://drive.google.com/drive/folders/1Zft94zEvibVZ-k8jg04gkIKsTGY89Ei0?usp=drive_link", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@j1u_zzz/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3009288, "client_id": 3065730, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/f30444d7/uploads/origins/d9668784-65eb-4976-8b06-a9fc3a5d769a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e3b442a89740308ebffbdab5bffd0961", "srcset": "https://si.imgix.net/f30444d7/uploads/origins/d9668784-65eb-4976-8b06-a9fc3a5d769a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e3b442a89740308ebffbdab5bffd0961, https://si.imgix.net/f30444d7/uploads/origins/d9668784-65eb-4976-8b06-a9fc3a5d769a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=8609ff4a6766c90e5c09b181e31a0563 2x, https://si.imgix.net/f30444d7/uploads/origins/d9668784-65eb-4976-8b06-a9fc3a5d769a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=5a671e31736a955a3f5896a8d284ea54 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/f30444d7/uploads/origins/d9668784-65eb-4976-8b06-a9fc3a5d769a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b2d7d84d7d7b667bdc4a44972984ba78", "srcset": "https://si.imgix.net/f30444d7/uploads/origins/d9668784-65eb-4976-8b06-a9fc3a5d769a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b2d7d84d7d7b667bdc4a44972984ba78, https://si.imgix.net/f30444d7/uploads/origins/d9668784-65eb-4976-8b06-a9fc3a5d769a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=163fc513276cba40089f