願いします。体が固い子なのでハイキックではなく、ももを（膝を）体に引き寄せるくらい高く上げてふとももとスカートの中の下着（見せパンではなく下着という設定）をこちらに見せてくれている感じでお願いします。ふとももは少し太くむちっとさせてください。柔らかいスカートがひらりとしてよりふとももと下着があらわになっている感じで。表情は少し恥じらいが見えるように赤面させてください。その他細かいポーズは作者様にお任せします。\n可能でしたらノーパン（無毛）で真っ赤に照れている差分をお願いします。\nご検討お願いします。", "nc": 177, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@shirokumo18/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2714100, "client_id": 3342082, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/153bc15a/uploads/origins/e18ec044-7b32-4168-bdef-6708988fc25a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9e09e4973a48a8d00e5dc7e6bad71f76", "srcset": "https://si.imgix.net/153bc15a/uploads/origins/e18ec044-7b32-4168-bdef-6708988fc25a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9e09e4973a48a8d00e5dc7e6bad71f76, https://si.imgix.net/153bc15a/uploads/origins/e18ec044-7b32-4168-bdef-6708988fc25a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=091a1ab14a3cad371ea98f0d68ecca8b 2x, https://si.imgix.net/153bc15a/uploads/origins/e18ec044-7b32-4168-bdef-6708988fc25a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=8d6f51cc087df4178f2b56f05a83002b 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/153bc15a/uploads/origins/e18ec044-7b32-4168-bdef-6708988fc25a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f2bf4eca9465bd57b4e4a5cb38fe38b6", "srcset": "https://si.imgix.net/153bc15a/uploads/origins/e18ec044-7b32-4168-bdef-6708988fc25a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f2bf4eca9465bd57b4e4a5cb38fe38b6, https://si.imgix.net/153bc15a/uploads/origins/e18ec044-7b32-4168-bdef-6708988fc25a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&