トで見て一目惚れしたのでリクエストを送らせていただきます。\nぜひ私の留夢れむを描いていただけないでしょうか。\n中の人は男ですが、留夢れむは女の子です。\n\n留夢れむは151cm髪型アシメで胸が小さめのハート目デフォルトです！\n資料用ポストの制服とコートに涙メガネを掛けていただきたいです（資料用ポストのリプライ欄か動きの動画の後半に映っています）\n構図や雰囲気など全てお任せします。\n留夢れむの資料としてＸのポストを添付いたします。\n\nSNSや配信活動で使用したいと思っています。\n可能であれば背景やサインなどを透過した人物だけのファイルもいただけると嬉しいです！\n乱文失礼いたしました。\nよろしくお願いいたします。\n\nhttps://x.com/Lumu_Lemu/status/1918240520587100329", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@shirokumo18/works/7", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/466fbc72/uploads/origins/0967c163-377f-4f66-8b60-881fcf5717ce?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=a2c0cf639ec9718502ce2aead740bb75", "srcset": "https://si.imgix.net/466fbc72/uploads/origins/0967c163-377f-4f66-8b60-881fcf5717ce?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=a2c0cf639ec9718502ce2aead740bb75, https://si.imgix.net/466fbc72/uploads/origins/0967c163-377f-4f66-8b60-881fcf5717ce?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=dee3a2db37a45e3cf8c7729f6f6b1b2a 2x, https://si.imgix.net/466fbc72/uploads/origins/0967c163-377f-4f66-8b60-881fcf5717ce?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=0fd5458b02c7177db00964097f71066c 3x"}, "private": true, "genre": "art", "tipped": false, "creator_id": 2714100, "client_id": 97931, "nc": 161}, {"path": "/@shirokumo18/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2714100, "vtt_url": null, "thumbnail_image_urls": {"