ou are free to add cute elements such as animal ears and a tail however you like. I look forward to a cute expression on his face.\n\nI imagine that he is embarassed about being aroused in this situation.\n\nI hope you enjoy your time together. Please take good care of Kurota!\n\nThank you\n\nhttps://drive.google.com/drive/folders/1nFg6HAq6GTmXI1_zBd0U5kNwaNJr-F4_", "nc": 48, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@ganabarekinniku/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3604277, "client_id": 1752760, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/e0f26807/uploads/origins/61c3630c-ad29-49d4-b204-0eb4b1845ffb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=41d192950dbc67e83ed1ebca06a73ace", "srcset": "https://si.imgix.net/e0f26807/uploads/origins/61c3630c-ad29-49d4-b204-0eb4b1845ffb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=41d192950dbc67e83ed1ebca06a73ace, https://si.imgix.net/e0f26807/uploads/origins/61c3630c-ad29-49d4-b204-0eb4b1845ffb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=866d020ad3cbc7750fffb544cf49b900 2x, https://si.imgix.net/e0f26807/uploads/origins/61c3630c-ad29-49d4-b204-0eb4b1845ffb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=630b30341cde6dd4e6a0106238850e87 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/e0f26807/uploads/origins/61c3630c-ad29-49d4-b204-0eb4b1845ffb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=296288a8418b0ebb95c205a48a4eb374", "srcset": "https://si.imgix.net/e0f26807/uploads/origins/61c3630c-ad29-49d4-b204-0eb4b1845ffb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=296288a8418b0ebb95c205a48a4eb374, https://si.imgix.net/e0f2