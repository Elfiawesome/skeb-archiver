したデータをいただきたいです。\n\n使用用途としては彗月シオンのTwitterアイコン、直接収益の出ないネップリ、配信のサムネイル(こちらは収益化されたものになります)となります。\n\nなにぶん収益が絡みますので、この金額では足りないなどの懸念がある場合はリクエストを却下していただければ幸いです。\n\nhttps://drive.google.com/file/d/1Z1OXIxleDLpqlKzJPk5MGSJOJLEW3_cS/view?usp=sharing", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@hyd_kakuri/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3227325, "client_id": 3175185, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/52ada519/uploads/origins/d259b4c8-9517-4e1f-bd21-d26b921614a2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c433549bda7ce3aea4dd1ca987dff260", "srcset": "https://si.imgix.net/52ada519/uploads/origins/d259b4c8-9517-4e1f-bd21-d26b921614a2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c433549bda7ce3aea4dd1ca987dff260, https://si.imgix.net/52ada519/uploads/origins/d259b4c8-9517-4e1f-bd21-d26b921614a2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ec098a907a256cfd2a99baed4928bfd6 2x, https://si.imgix.net/52ada519/uploads/origins/d259b4c8-9517-4e1f-bd21-d26b921614a2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=7b6c533655ac1d7beea7e3e54874bb70 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/52ada519/uploads/origins/d259b4c8-9517-4e1f-bd21-d26b921614a2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=108e7eef19c8af278c0d6fb2dfec3568", "srcset": "https://si.imgix.net/52ada519/uploads/origins/d259b4c8-9517-4e1f-bd21-d26b921614a2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=108e7eef19c8af278c0d6fb2dfec3568, https://si.imgix.net/52ada519/uploads/origins/d259b4c8-9517-4e1f-bd21-d26b921614a2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200