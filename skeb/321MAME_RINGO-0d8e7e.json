ix.net/2e35b632/uploads/origins/4559394c-9a38-4eff-87b8-6c3505287f6a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b8397c0bbd78f2bfa75560ab1f06f0a4 2x, https://si.imgix.net/2e35b632/uploads/origins/4559394c-9a38-4eff-87b8-6c3505287f6a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=68c5502098b8b646362505d67e21dd8b 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/2e35b632/uploads/origins/4559394c-9a38-4eff-87b8-6c3505287f6a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f2a7bb415cf276313935715e4ffa5f3d", "srcset": "https://si.imgix.net/2e35b632/uploads/origins/4559394c-9a38-4eff-87b8-6c3505287f6a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f2a7bb415cf276313935715e4ffa5f3d, https://si.imgix.net/2e35b632/uploads/origins/4559394c-9a38-4eff-87b8-6c3505287f6a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=6162b19b8ea50617663fc3a955bb42dc 2x, https://si.imgix.net/2e35b632/uploads/origins/4559394c-9a38-4eff-87b8-6c3505287f6a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=03bf5b9f93c2a7a984bc73ef2c17efe6 3x"}, "body": "はじめましてこんにちは、ご連絡失礼いたします。\n個人でVTuber活動をしている白夜ルナと申します。\nMAMERINGO様のポップでかわいらしいイラストの雰囲気に惹かれ、\n平成女児風イラストを描いていただけたらとリクエスト送らせていただきました。\n\n【キャラクター】\n・口が悪い\n・少女\n・飲酒をしていることも多い\n\n【表情・構図等】\nおまかせで、描きやすいイメージでぜひお願いしたいです。\n\n【使用用途】\n・SNS掲載(宣伝活動含む)\n・YouTubeの配信内(待機・EDなど)\n・動画・配信のサムネイル\n・フリー素材と組み合わせての使用\nを想定しております。\n\nもし可能でしたら\n透過PNGを頂戴できましたら嬉しいです。\n\nご検討いただけますと幸いです。\nよろしくお願いいたします。\n\nhttps://x.com/Byakuya_Runa", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@321MAME_RINGO/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 4015600, "client_id": 1116701, "vtt_url": null, "thumb