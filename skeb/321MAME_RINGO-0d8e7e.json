途中で神学の専攻に転向しました。 卒業後、彼は跡形もなく姿を消しました。その間、彼はシベリアの森を旅し、村から村へと巡りながら、牧師として、また田舎の医師として活動していました。\n\n20年後、彼はかつて住んでいた街に突然戻ってきました。 大学時代の親友が彼を見つけ出したが、彼がPTSDに苦しみ、戦争の鮮明な幻覚に悩まされていることに気づいた。\n\n私のリクエストを読んでいただき、ありがとうございます！\n\nhttps://drive.google.com/drive/folders/1Pu_M-orJDep_WkyCCRyrxOTCrJ-sumQQ", "nc": 153, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@321MAME_RINGO/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 4015600, "client_id": 3159324, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/47d13bb2/uploads/origins/713e904e-5300-4d70-a7e8-64b3c1426f5f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=283c8c231a7dd7b86bcc450c646682b2", "srcset": "https://si.imgix.net/47d13bb2/uploads/origins/713e904e-5300-4d70-a7e8-64b3c1426f5f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=283c8c231a7dd7b86bcc450c646682b2, https://si.imgix.net/47d13bb2/uploads/origins/713e904e-5300-4d70-a7e8-64b3c1426f5f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a693f1b73d253273e32321ce3437627d 2x, https://si.imgix.net/47d13bb2/uploads/origins/713e904e-5300-4d70-a7e8-64b3c1426f5f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=08c79db09b47ad0a2ccf833b841c57e7 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/47d13bb2/uploads/origins/713e904e-5300-4d70-a7e8-64b3c1426f5f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0f383bad0f5a054f7d8c2cbd2aba41d5", "srcset": "https://si.imgix.net/47d13bb2/uploads/origins/713e904e-5300-4d70-a7e8-64b3c1426f5f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0f383bad0f5a054f7d8c2cbd2aba41d5, https://si.imgix.net/47d13bb2/uploads/origins/713e904e-5300-4d70-a7e8-64b3c1426f5f?bg=%23fff&auto=format%2Cco