=crop&crop=top&w=200&h=200&s=c818e3745f95aba0b037501a981e4f97", "srcset": "https://si.imgix.net/ceead6ef/uploads/origins/0a1851d6-6fcd-479d-b9b4-879c24299375?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c818e3745f95aba0b037501a981e4f97, https://si.imgix.net/ceead6ef/uploads/origins/0a1851d6-6fcd-479d-b9b4-879c24299375?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=68888b96ee4e45cc960d80cb0d6042a3 2x, https://si.imgix.net/ceead6ef/uploads/origins/0a1851d6-6fcd-479d-b9b4-879c24299375?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d0b55109358817f8bdbccfeeb462ab1d 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/ceead6ef/uploads/origins/0a1851d6-6fcd-479d-b9b4-879c24299375?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=eb520f9171150c2436a328b59898631e", "srcset": "https://si.imgix.net/ceead6ef/uploads/origins/0a1851d6-6fcd-479d-b9b4-879c24299375?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=eb520f9171150c2436a328b59898631e, https://si.imgix.net/ceead6ef/uploads/origins/0a1851d6-6fcd-479d-b9b4-879c24299375?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=d303bf3b4f0d505728230a5070e881fd 2x, https://si.imgix.net/ceead6ef/uploads/origins/0a1851d6-6fcd-479d-b9b4-879c24299375?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=b9a89619386c7cc658f829f1c137a28b 3x"}, "body": "艦これの高雄のNTRイラストをお願いしたいです。\n\n以前描かれていた\nhttps://www.pixiv.net/artworks/115023318\nと同じような対面座位でディープキスをしている描写\n\n高雄の服装は原作立ち絵の帽子とスク水タイツ姿で大きな谷間及び乳首が浮き上がっていることが強調されている描写をお願いします\n\nおっぱいのサイズは可能な範囲で大きくしていただきたいです\nまた上記URLのイラストのようにおっぱいを男の体に強く押し付けられている描写もお願いします\n\n高雄はトロ顔で喜んで男とセックスしている感じの表情\n\n男の風貌は上記URLのイラストと同じような金髪チャラ男で片手を高雄の水着の隙間に手を入れて直におっぱいを揉んでいる\n\n\n可能であれば下記の差分をお願いします\n\n・高雄の表情や精液の描写及び各擬音で射精直前→大量射精→事後の流れになる差分\n\n・おっぱい揉み、ディープキス、射精等の各擬音及び高雄の喘ぎ声と淫らな息遣いの差分\n\n・https://www.pixiv.net/artworks/112329198のイラストのようにドアの隙間から覗いている寝取られ展開の差分\n\n・事後描写で高雄のお腹やタイツに大量の精液が付着していたり、高雄の目線がこちら（ドアの隙間）に向いている差分\n\n以上、ご検討の程よろしくお願いします。", "nc": 177, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@tako/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1278597, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/a2001fe5/uploads/origins/eae1b0de-1567-4754-8b07-2bc34a2883c0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c13153330fdd944efd3e19cd503d179e", "srcset": "https://si.imgix.net/a2001fe5/uploads/origins/eae1b0de-1567-4754-8b07-2bc34a2883c0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c13153330fdd944efd3e19cd503d179e, https://si.imgix.net/a2001fe5/uploads/origins/eae1b0de-1567-4754-8b07-2bc34a2883c0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=931d8ee5abbe9cd4a1eea2c15d0f3bbc 2x, https://si.imgix.net/a2001fe5/uploads/origins/eae1b0de-1567-4754-8b07-2bc34a2883c0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=592669d73a3f3d4d4388e3cbfc9bfc24 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/a2001fe5/uploads/origins/eae1b0de-1567-4754-8b07-2bc34a2883c0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=03010499728b9378ac043b1091123c33", "srcset": "https://si.imgix.net/a2001fe5/uploads/origins/eae1b0de-1567-4754-8b07-2bc34a2883c0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=03010499728b9378ac043b1091123c33, https://si.imgix.net/a2001fe5/uploads/origins/eae1b0de-1567-4754-8b07-2bc34a2883c0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=e2708cabf272de3ed7444301e81f2636 2x, https://si.imgix.