a2/uploads/origins/00a9609b-a6c6-4181-bda1-5a39a714b970?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=1ade79a0c4c5d923c0cf473b085bcfa5 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/8b8ff6a2/uploads/origins/00a9609b-a6c6-4181-bda1-5a39a714b970?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=766088465b985bae757885dafdb6fc52", "srcset": "https://si.imgix.net/8b8ff6a2/uploads/origins/00a9609b-a6c6-4181-bda1-5a39a714b970?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=766088465b985bae757885dafdb6fc52, https://si.imgix.net/8b8ff6a2/uploads/origins/00a9609b-a6c6-4181-bda1-5a39a714b970?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=ea5239954892b49a1ec37a9a8459b964 2x, https://si.imgix.net/8b8ff6a2/uploads/origins/00a9609b-a6c6-4181-bda1-5a39a714b970?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=545c89b40ff82dd0ab2a780fe00ca7d6 3x"}, "body": "ゆめみ様\n\n初めまして。深青白夜と申します。\nゆめみ様の素敵な作品を拝見したので、是非描いて頂きたいと思いリクエストいたします。\n\n【依頼内容】\n参考資料をもとに私、深青白夜のイラストを描いて頂きたい\nゆめみ様の描かれた「https://skeb.jp/@yumemi_illust_/works/1」の雰囲気が素敵だと思っているので、そのようなダークなイメージになると嬉しい\n\n・外見のベース\n添付資料のイラストをベース\n\n・服装/装飾等\n添付資料の衣装を参考に描いて頂きたい\n・描写範囲\n可能なら全身 難しい場合は出来る範囲までで\n\n・アングル/ポーズ\n剣で切りつけた後に返り血を浴びたまま剣を横に構えてポーズをとっている状態で(ポーズイラスト参考にしつつ、剣はもう少し下げて顔にかからないように)2パターン描いて頂きたい\n①通常の表情:真剣な表情でポーズを取ったままこちらをじっと見ている\n②ゲス顔:ポーズはそのままで返り血を舌で舐めている\n\n備考\n・向かって左目の下の泣きぼくろ\n・向かって右の服の襟についたマークをそのまま髪の髪留めとしてつける\n(髪留め・涙ぼくろイラスト参照)\n・メガネ(ベースイラストのようなサングラスでも可)\n・向かって右手の薬指に指輪\nそれぞれアングル的に映らない場合は不要です\n\n背景\nお任せだが、あれば嬉しい\n\n・サイズ\n　拡大する場合もあるので、出来るだけ大きめに(縦横2000以上)に\n　描いて頂けるととてもありがたい\n\n◆使用用途\n・配信アプリ(IRIAM)での返礼品\n・企業コラボで使うイラスト\n・Youtubeの配信、動画のサムネイル\n・SNSでの告知などの投稿\n※今後Youtubeが収益化する可能性がございます\n\n◆希望納品形式\nPNG\n背景があればキャラクターのみの透過データもいただければ幸いです。\n\n◆その他\n頭や髪の毛を含めた左右が見切れないように描いていただけると とても嬉しいです。\n\n金額が不足しているようであれば、金額指定頂いた上で返却頂ければ幸いです。\nご検討よろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/1fKGpeilWmnnDpnrKFVwExvHYrF9N1N9T\n\nhttps://drive.google.com/drive/folders/1fKGpeilWmnnDpnrKFVwExvHYrF9N1N9T", "nc": 176, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@yumemi_illust_/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3594493, "client_id": 211848, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/cd36d3c6/uploads/origins/fc3802dc-ef29-43a6-ac26-a18b11f96265?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=dbbe7f727e7c2ed78ec0e6f6c5c6a0a4", "srcset": "https://si.imgix.net/cd36d3c6/uploads/origins/fc3802dc-ef29-43a6-ac26-a18b11f96265?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=dbbe7f727e7c2ed78ec0e6f6c5c6a0a4, https://si.imgix.net/cd36d3c6/uploads/origins/fc3802dc-ef29-43a6-ac26-a18b11f96265?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=825182ef3b4cdc26b8605c935bd09847 2x, https://si.imgix.net/cd36d3c6/uploads/origins/fc3802dc-ef29-43a6-ac26-a18b11f96265?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=fba17054cc72823e28289436d61d67cc 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/cd36d3c6/uploads/origins/fc3802dc-ef29-43a6-ac26-a18b11f96265?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ba234e9825babf124999e27e4a7872c1", "srcset": "https://si.imgix.net/cd36d3c6/uploads/origins/fc3802dc-ef29-43a6-ac26-a18b11f96265?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ba234e9825babf124999e27e4a7872c1, https://si.imgix.net/cd36d3c6/uploads/origins/fc3802dc-ef29-43a6-ac26-a18b11f96265?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=a2b046d8dd0bb326842f1dfca511631c 2x, https://si.imgix.net/cd36d3c6/uploads/origins/fc3802dc-ef29-43a6-ac26-a18b11f96265?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=ae23f08bde8df535b07170e927b187ba 3x"}, "body": "Hello! I saw the last piece you did and it looked so cool and lovely! I wanted to request art of my child, <Lars>!\n\nsta.sh/0n2z4zzkg7k\n\nLars is a handsome man giving a refined air, working as a butler for a young heiress. While at first he seems like the perfect butler, fulfilling every order no matter how difficult, he is actually extremely immature, easy to upset, and frequently causes problems. The heart of a savage pretending to be a gentlemen.\n\nI will leave the pose and composition up to you. If possible, please deliver a PSD file with the sign layer separate from the illustration. Thankyou, and have a good day!", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@yumemi_illust_/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3594493, "client_id": 53759, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/486ff341/uploads/origins/776a709f-2844-41be-a585-727cf7251b81?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=afa94b8fbca1de2ce07a3844cd89d93f", "srcset": "https://si.imgix.net/486ff341/uploads/origins/776a709f-2844-41be-a585-727cf7251b81?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=afa94b8fbca1de2ce07a3844cd89d93f, https://si.imgix.net/486ff341/uploads/origins/776a709f-2844-41be-a585-727cf7251b81?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=16e6ce1c00300a048f3d2f5becc2864c 2x, https://si.imgix.net/486ff341/uploads/origins/776a709f-2844-41be-a585-727cf7251b81?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=de471da85031d41b095f955256108c47 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/486ff341/uploads/origins/776a709f-2844-41be-a585-727cf7251b81?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=67f573a4de5c07807f16a6609ac5aafa", "srcset": "https://si.imgix.net/486ff341/uploads/origins/776a709f-2844-41be-a585-727cf7251b81?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=67f573a4de5c07807f16a6609ac5aafa, https://si.imgix.net/486ff341/uploads/origins/776a709f-2844-41be-a585-727cf7251b81?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=9cfbace08595724867435c2845c2c366 2x, https://si.imgix.net/486ff341/uploads/origins/776a709f-2844-41be-a585-727cf7251b81?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=0f08733c4d45e2550db33c1b1710c145 3x"}, "body": "こんにちは、ゆめみさん。素晴らしい過去のイラストをありがとう。とても気に入りました。もしよろしければ、またリクエストさせていただいてもよろしいでしょうか。ゆめみさんもアピールの中で私のキャラクター＜ローレンス＞のことをおっしゃっていたので、彼のイラストもお願いできたら嬉しいです。\n\nhttps://toyhou.se/32794094.oc-refs/35482918.lawrence-tsui?key=Zfol9ypIpduXiwe\nローレンスのギャラリーは上記URLからアクセスしてください。\n\nロレンスは、クールで飄々とした、また、ねこのような特徴を持った男性です。ストイックで皮肉っぽい性格の旅人で、\"野良猫の黒猫 \"や \"運命の糸 \"をイメージさせる。\n\nポーズや構図はお任せします。可能であれば、看板レイヤーをイラストとは別にしたPSDファイルで納品をお願いします。ご検討のほど、よろしくお願いいたします。", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@yumemi_illust_/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3594493, "client_id": 53759, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/9d6de044/uploads/origins/c725e1cc-793e-4e26-a44c-33e56820a746?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c984845d8ca0f2a0dbfbfd098ffa9598", "srcset": "https://si.imgix.net/9d6de044/uploads/origins/c725e1cc-793e-4e26-a44c-33e56820a746?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c984845d8ca0f2a0dbfbfd098ffa9598, https://si.imgix.net/9d6de044/uploads/origins/c725e1cc-793e-4e26-a44c-33e56820a746?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=8dea0cf101b1b5bb473bb634f8a4d388 2x, https://si.imgix.net/9d6de044/uploads/origins/c725e1cc-793e-4e26-a44c-33e56820a746?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=851da3268744c6c3d1d04b0e04c3cbe4 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/9d6de044/uploads/origins/c725e1cc-793e-4e26-a44c-33e56820a746?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9ea75aeb9eaaaeada18ceaa42e3f35a3", "srcset": "https://si.imgix.net/9d6de044/uploads/origins/c725e1cc-793e-4e26-a44c-33e56820a746?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9ea75aeb9eaaaeada18ceaa42e3f35a3, https://si.imgix.net/9d6de044/uploads/origins/c725e1cc-793e-4e26-a44c-33e56820a746?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=0d3842dc55089e39e8296d9c09d7da43 2x, https://si.imgix.net/9d6de044/uploads/origins/c725e1cc-793e-4e26-a44c-33e56820a746?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=5254c7eeb2f406a8fe0ae00c1f244b64 3x"}, "body": "ゆめみさん、はじめまして。アピールありがとうございます！アピールにあるような私のキャラクター＜アレクセイ＞のイラストをお願いしたいです。\n\nhttps://toyhou.se/32794094.oc-refs/33404398.alexei-ivanov/gallery?key=aMQPvaeqXapzDzI\n上記URLからアレクセイのギャラリーにアクセスしてください。\n\nアレクセイはハンサムで威圧的な雰囲気を醸し出す堂々とした男である。ブラックマンバのように口の中は黒く、鋭い毒牙を持つ。ロシアの犯罪グループのリーダーである。恐るべき評判を得ている。\n\nポーズと構図はお任せします。可能であれば、看板レイヤーをイラストとは別にしたPSDファイルで納品をお願いします。ご検討のほど、よろしくお願いいたします。", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 122286, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "西なつれ", "screen_name": "720n", "avatar_url": "https://pbs.twimg.com/profile_i