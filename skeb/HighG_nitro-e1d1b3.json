ly_public": false, "tip_acceptable": true, "yearly_report_client_visible": false, "total_appeals_count": 0, "received_works": [{"path": "/@HighG_nitro/works/9", "private_thumbnail_image_urls": null, "private": false, "genre": "comic", "tipped": true, "creator_id": 1545803, "client_id": 113103, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/d37805e2/uploads/origins/9a0f3630-d171-4bd5-9fa9-a4e9fc5be1fa?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ccf9e9dba182cbcda95f666008ccb62c", "srcset": "https://si.imgix.net/d37805e2/uploads/origins/9a0f3630-d171-4bd5-9fa9-a4e9fc5be1fa?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ccf9e9dba182cbcda95f666008ccb62c, https://si.imgix.net/d37805e2/uploads/origins/9a0f3630-d171-4bd5-9fa9-a4e9fc5be1fa?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a0e2ed0613c161c3c5fcf108f8288ef6 2x, https://si.imgix.net/d37805e2/uploads/origins/9a0f3630-d171-4bd5-9fa9-a4e9fc5be1fa?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=1820a612ab60cd65ed841905898b53ca 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/d37805e2/uploads/origins/9a0f3630-d171-4bd5-9fa9-a4e9fc5be1fa?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=aac298745bdcec43b4352cb9c98b8d96", "srcset": "https://si.imgix.net/d37805e2/uploads/origins/9a0f3630-d171-4bd5-9fa9-a4e9fc5be1fa?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=aac298745bdcec43b4352cb9c98b8d96, https://si.imgix.net/d37805e2/uploads/origins/9a0f3630-d171-4bd5-9fa9-a4e9fc5be1fa?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=83be0bcfff42a0f99e935455ca2ce8f5 2x, https://si.imgix.net/d37805e2/uploads/origins/9a0f3630-d171-4bd5-9fa9-a4e9fc5be1fa?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=d2eb951848c1e68040099664a4586200 3x"}, "body": "いつも作品を楽しみに拝見しております！\nハイジさんがお描きになる「M男が女性にキモがられながら責められるシチュ（レイスや野薔薇、千鶴）」が大変癖に刺さりましたので、この度依頼させていただきました。\n\n早速ですが、以下のような内容のものをお願いできますでしょうか？\n\n【内容】\nデレマスの北条加蓮が童貞M男（マゾの弱男）を責めつつ筆下ろしし、最後に少し甘やかす。\n\n１．事前（脱衣）\n女性経験のないM男が加蓮の脱衣をガン見して自分の服を脱ぐことを忘れているため、仕方なく加蓮が服を脱がせてやる。\nすると、明らかにチクニ―のしすぎであろう大きめな乳首と短小包茎な粗チンが出てきてドン引きの加蓮。\n試しに男の乳首をちょいっと弄ると身体をびくつかせ勃起し、その姿に加蓮は「うっわぁ…」という感じ。\n\n２．手コキ\n加蓮は粗チンに唾液を垂らして潤滑油代わりにし、乳首舐め手コキ。\n男の大きい乳首を摘まんで先端を舌でほじってやると気持ちの悪い声で悶える男。\n\n３．フェラ\n男の乳首を弄りながらのフェラ。尿道の先端に舌を入れてほじられ快楽で呻く男。\n\n４．アナル舐め\nちんぐり返しの体勢で男の乳首を弄りながらアナル舐め。\n男のリクエストに応えて尻穴の中にツーっと唾液を垂らした加蓮は、そのまま舌を尻穴の中まで入れて責める。\n\n５．筆下ろし\nコンドームの開け方が分からずもたつく男に呆れ顔の加蓮。\nゴムを奪い取って粗チンに装着…するが、Sサイズにも関わらずブカブカ状態。\n大きく溜息をついた加蓮がゴムを外すと悲しそうな顔をする男。\n男に見つめられた加蓮は「あ～…もう！」という感じで男を睨みながら騎乗位で跨り生挿入。\n…が、しかし、M男には刺激が強すぎたため、挿れただけで我慢できずに勢いよく膣内射精。\n加蓮は射精の余韻でピクピクしている男にデコピンすると、自分の中指を舐めて濡らし、そのまま男の尻穴へ突っ込みクニクニと前立腺を刺激して強制勃起させ騎乗位再開。\n大声で喘ぐ男が再度射精するも腰を止めず、射精の勢いが収まってきてからも入念に前立腺を弄りながら追いピストンで搾り取り。\n\n６．事後・添い寝\nがっつり搾られ放心状態の男と騎乗位挿入状態のままツーショットを撮る加蓮。\nペニスを引き抜くと膣から粘っこい精液が溢れ出てくるが、それはそのままにペニスをティッシュで丁寧に拭うと仕上げのお掃除フェラで尿道に残った精液を搾り出す。\n掃除が終わると、加蓮は男の隣で横になり事後の添い寝。\n男が加蓮に今日のことを怒っているか不安そうに尋ねると、加蓮は男の耳元で「ドン引いたこと、呆れたこと、気持ち悪かったこと」をポソポソと囁き、男の乳首を弄りながら耳に吐息を吹きかける。\nゾクゾクと身を震わせる男に悪戯っぽく笑いかけた加蓮は、舌を絡めてディープキス。\nそのまま男の頭を胸元に抱き寄せて撫でながら一緒に就寝。\n男も加蓮の生乳にちゅぱちゅぱと吸いつきながら幸せそうに寝落ち。\n\n長くなってしまい大変恐縮ですが、是非ご一考いただけますと幸いです。", "nc": 168, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@HighG_nitro/works/8", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1545803, "client_id": 8724, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/337866dd/uploads/origins/0e015746-49e3-4fe9-b166-243f3975ee3d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6744fc4c9eca0ad7ea0dabddaa3c3d38", "srcset": "https://si.imgix.net/337866dd/uploads/origins/0e015746-49e3-4fe9-b166-243f3975ee3d?bg=%23fff&auto=format%2Ccompress&fm=web