0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1ae7b3410b4d19bd1af7c61ec0619764, https://si.imgix.net/bdf83de4/uploads/origins/1fc14eb1-2762-4270-bac4-0069ad4a5c00?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=631cb95b5cbfb69e83ad3787dcb297f9 2x, https://si.imgix.net/bdf83de4/uploads/origins/1fc14eb1-2762-4270-bac4-0069ad4a5c00?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=302871e7f76ddd37127e1c80966f32ad 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/bdf83de4/uploads/origins/1fc14eb1-2762-4270-bac4-0069ad4a5c00?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ec6799202eb231f4b437e05a3ade1884", "srcset": "https://si.imgix.net/bdf83de4/uploads/origins/1fc14eb1-2762-4270-bac4-0069ad4a5c00?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ec6799202eb231f4b437e05a3ade1884, https://si.imgix.net/bdf83de4/uploads/origins/1fc14eb1-2762-4270-bac4-0069ad4a5c00?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=abc6e08d727f39427935abe6bb25eb7a 2x, https://si.imgix.net/bdf83de4/uploads/origins/1fc14eb1-2762-4270-bac4-0069ad4a5c00?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=cd6d8abe9a5e0d95405117cff8a4e541 3x"}, "body": "rororo様\n\nこんばんは、rororo様。\nツイッターからイラストを拝見させて頂いてファンになったものです。\n女の子たちの魅力がたっぷり見えるイラストがすごく好きです。\n特にウマ、その中でもマーベラスがマーベラスでした！\nいつも素敵なイラストを見せてくださり誠にありがとうございます。\nそんなrororo様がスケブを開いてくださることを知り、もしよろしければこちらのオリキャラのことを依頼したいです。\n\nお願い申し上げたいのはこちらのオリキャラ狐娘の万里香（まりか）という子です。\n狐耳と尻尾・赤メガネ・アホ毛、そしてちょっぴりツリ目な目つきが特徴的な、160cmくらいの身長の高校生です。\n本とか、動物や花、星空のような自然をぼーっと見るのが大好きな子です。\n性格的には、ちょっと人見知りで照れ屋ですので人前では余計にクールっぷりしてるけどまた寂しがり屋のちょっと面倒くさい感じです。一人の時や知り合いの前では表情が緩めてちょっと豊かになる感じです。\nこれだけではちょっと説明が足りないと思いますので設定と設定画など、ご参考できそうなものを下のURLにまとめております。\n\nこの娘でrororo様の絵柄でのイラストをどうかお願いしたいです。\n衣装は設定画のうちの一つで、本を抱いてるか読んでるところがみたいです。\nご検討くださいませ！\n\nお忙しい中、要件のみで申し訳ありません。\n応援しております！\n\nhttps://drive.google.com/drive/folders/1kVcp6B8dzGYFGpFb9spMTyDnz0TzyM7Q?usp=sharing", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@loah_66/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2322878, "client_id": 1707656, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/bb726447/uploads/origins/95059f15-f881-45c3-b311-8fdda00b98e8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ea3d6e8caf7192856ce21d33b7bdc10c", "srcset": "https://si.imgix.net/bb726447/uploads/origins/95059f15-f881-45c3-b311-8fdda00b98e8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ea3d6e8caf7192856ce21d33b7bdc10c, https://si.imgix.net/bb726447/uploads/origins/95059f15-f881-45c3-b311-8fdda00b98e8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a0ab2871aaf46f6b6bd13d747b4f7d37 2x, https://si.imgix.net/bb726447/uploads/origins/95059f15-f881-45c3-b311-8fdda00b98e8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=53668e1716366f52bdc0e68e72561e62 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/bb726447/uploads/origins/95059f15-f881-45c3-b311-8fdda00b98e8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=96949c6ce6a3226c106f08ddf3fd24e3", "srcset": "https://si.imgix.net/bb726447/uploads/origins/95059f15-f881-45c3-b311-8fdda00b98e8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=96949c6ce6a3226c106f08ddf3fd24e3, https://si.imgix.net/bb726447/uploads/origins/95059f15-f881-45c3-b311-8fdda00b98e8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=78d6ce9910704905571b8a4ab6c7dde5 2x, https://si.imgix.net/bb726447/uploads/o