した。\n\n【 リクエスト内容 】 \nシュエン＊ルーエの魔女っ子のハロウィンイラストを描いて頂きたいです。衣装デザイン・髪型等々全てお任せします。\n\n【キャラクター】\n・歌が大好き。歌が命。\n・モチーフはお花とリボンと狐。\n(花は藤・桜・菫などその他多数)\n・お供のこんちゃん(狐)\n・声は高め。かわいい系。\n・甘いものが大好き。\n・僕っ子。\n「ぼくは...」「君たちは....」「...なんだよね！｣\n\n【使用用途】 \n・各種SNS、X等への投稿\n ・動画投稿サイト(YouTubeやTikTok等)への投稿 \n・収益化済み配信アプリIRIAMでの使用 \n・グッズ制作(リアル・デジタル)\n\n【その他】\n ・PSDファイル形式で頂けますととても助かります。 \n・頭部や耳尻尾が見切れていないと有難いです。\n・ただの私の趣味なのですが…気が向きましたらラフ等々そのまま入れて下さると幸です。\n\nその他、金額の不備等ございましたら遠慮なくキャンセルや再送申請していただければと思います。\nお忙しい中恐縮ですが、ご検討のほどよろしくお願いいたします！\n\n  【資料】\nhttps://drive.google.com/drive/folders/18yMPncat6pTxjL9ui29OfIB9F3b3B-kH\n\nhttps://drive.google.com/drive/folders/1JrTuEUYEmfKAiCysUI5T69zxMNeLad0W\n\n【litLink】\nhttps://lit.link/shuenrue", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@gattam_/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3918443, "client_id": 2513697, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/f59f74ae/uploads/origins/07b96221-6b6e-40ae-94bc-0e36de1b8778?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=017caddc371f516247dd58d399c0bc84", "srcset": "https://si.imgix.net/f59f74ae/uploads/origins/07b96221-6b6e-40ae-94bc-0e36de1b8778?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=017caddc371f516247dd58d399c0bc84, https://si.imgix.net/f59f74ae/uploads/origins/07b96221-6b6e-40ae-94bc-0e36de1b8778?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=def617341d8e0524c844e227bfc24b73 2x, https://si.imgix.net/f59f74ae/uploads/origins/07b96221-6b6e-40ae-94bc-0e36de1b8778?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=319876bf1cc24fc40e418fbac56c5c16 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/f59f74ae/uploads/origins/07b96221-6b6e-40ae-94bc-0e36de1b8778?bg=%23fff&auto=format%2Cco