, "tip_acceptable": true, "yearly_report_client_visible": false, "total_appeals_count": 0, "received_works": [{"path": "/@huruhuruerikoru/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "novel", "tipped": true, "creator_id": 1249018, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/3e3097f8/uploads/origins/34216e84-9164-4fb0-93e7-edb1810bceb9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a7a80461031894348a002dd9d3c10b62", "srcset": "https://si.imgix.net/3e3097f8/uploads/origins/34216e84-9164-4fb0-93e7-edb1810bceb9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a7a80461031894348a002dd9d3c10b62, https://si.imgix.net/3e3097f8/uploads/origins/34216e84-9164-4fb0-93e7-edb1810bceb9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=6589a514623032084abccfab5fddd50e 2x, https://si.imgix.net/3e3097f8/uploads/origins/34216e84-9164-4fb0-93e7-edb1810bceb9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d59a5c98600bb46090bfff00bd079307 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/3e3097f8/uploads/origins/34216e84-9164-4fb0-93e7-edb1810bceb9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d7e9b53c30cd072f3e3a11dbcec2f344", "srcset": "https://si.imgix.net/3e3097f8/uploads/origins/34216e84-9164-4fb0-93e7-edb1810bceb9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d7e9b53c30cd072f3e3a11dbcec2f344, https://si.imgix.net/3e3097f8/uploads/origins/34216e84-9164-4fb0-93e7-edb1810bceb9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=c01e6974acd8e5fb21cf710c4eef0c50 2x, https://si.imgix.net/3e3097f8/uploads/origins/34216e84-9164-4fb0-93e7-edb1810bceb9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=00a922114ab94c81af1550af6b77a4f4 3x"}, "body": "お世話になっております。\n今回は剣と魔法のファンタジー世界を舞台に「サキュバスが化けた姫の罠に（ニセモノと分かっているにもかかわらず）堕ちてしまう男」のシチュエーションの小説をリクエストしたく思います。\n\n原案は下記となります。\n詳細設定についてはお任せします。\n必要に応じて適宜改変頂いても問題ありません。\n\n＊＊＊\n\n・魔物にさらわれた姫の救出のためダンジョンに向かう男２人（AとB）。\n・男Aは身体を透明化させるアイテムを使い、無用な戦いを避けながらダンジョン内で姫を捜索する。\n・男Bは別口からダンジョン内に侵入し陽動を担当する。\n\n・男A（透明化中）は牢屋のような場所で着替え中のサキュバスを発見する。\n・サキュバスは本物の姫から奪った衣装に着替えると、姫そっくりに変身する。\n・声色を調整したりしながら姫を演じる練習をするサキュバスの様子に、知らず知らずのうちに興奮を覚える男A（透明化中）。\n\n・その時、男Bが牢屋に辿り着いてしまう。\n・男Bはサキュバスの術中に嵌り（本物の姫と思い込んだまま）精を搾り取られてゆく。\n・姫の正体を知る男A（透明化中）は、姫の顔の裏でサキュバスがほくそ笑む光景を想像し、男Bが搾られていくのを羨ましそうに見つめていた。\n\n・透明化しているはずの男Aの方を向いて微笑む【姫】（サキュバスが男の興奮を察知するイメージ）。\n・男Aから透明化させるアイテムを奪ったうえで、【姫】は男Aに城へと案内するよう告げるのだった。\n\n＊＊＊\n\n特記の無い事項についてはお任せします（こちらがNGとする要素や表現は特にございません）。\n以上ご検討宜しくお願いします。", "nc": 57, "word_count": 16907, "transcoder": "text", "creator_acceptable_same_genre": false}, {"path": "/@huruhuruerikoru/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "novel", "tipped": true, "creator_id": 1249018, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/54df9b51/uploads/origins/9444bd90-139c-4aff-9ca9-b702682e2c72?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7d410ecdd37eef92fd5188ea7872a0d9", "srcset": "https://si.imgix.net/54df9b51/uploads/origins/9444bd90-139c-4aff-9ca9-b702682e2c72?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7d410ecdd37eef92fd5188ea7872a0d9, https://si.imgix.net/54df9b51/uploads/origins/9444bd90-139c-4aff-9ca9-b702682e2c72?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c23077248ee5aed8aa245f6e48cd693d 2x, https://si.imgix.net/54df9b51/uploads/origins/9444bd90-139c-4aff-9ca9-b702682e2c72?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=69ca9dfca3c0fd887df9242da4ebcd3d 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/54df9b51/uploads/origins/9444bd90-139c-4