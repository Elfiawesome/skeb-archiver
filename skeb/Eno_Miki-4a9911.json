//si.imgix.net/2b6529ff/uploads/origins/cf1ea7da-5ca8-429a-a672-287e5ad07c42?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=47ffd51381a0701a1e8e39bb0146aadd, https://si.imgix.net/2b6529ff/uploads/origins/cf1ea7da-5ca8-429a-a672-287e5ad07c42?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=db6beb892731c4225890609952609cd0 2x, https://si.imgix.net/2b6529ff/uploads/origins/cf1ea7da-5ca8-429a-a672-287e5ad07c42?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d49122b452a3b2ad5b455cab04f21e25 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/2b6529ff/uploads/origins/cf1ea7da-5ca8-429a-a672-287e5ad07c42?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=cdd3447a81e7353330143c81e2e47127", "srcset": "https://si.imgix.net/2b6529ff/uploads/origins/cf1ea7da-5ca8-429a-a672-287e5ad07c42?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=cdd3447a81e7353330143c81e2e47127, https://si.imgix.net/2b6529ff/uploads/origins/cf1ea7da-5ca8-429a-a672-287e5ad07c42?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=0a3c3688bd687c2ae931585325112c4b 2x, https://si.imgix.net/2b6529ff/uploads/origins/cf1ea7da-5ca8-429a-a672-287e5ad07c42?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=cf3564a165914933f067bcacef042f6d 3x"}, "body": "はじめまして！\n江乃みきさんの作品が好きなので、依頼させていただきます！\n\nファイナルファンタジー14の自キャラのイラストを依頼したいです。\nキャラは下記リンクの画像を参考にしていただければと思います。\nhttps://jp.finalfantasyxiv.com/lodestone/character/11190818/\nhttps://twitter.com/NasnoTawaC/status/1250844238947876865\n\n基本的には江乃みきさんの自由に描いてほしいと思いますが、方針として希望は書いておきます。\n絶対に守ってほしい!ということはなく、違う風に描かれても全く問題ありません。\n\n希望は下記のとおりです。\n★髪型や肌、目の色などの身体的特徴\n　・参考画像からあまり乖離せず、自キャラだと判別できる感じだと嬉しいです。\n★雰囲気\n　・いたずら好き+そそっかしいところのある子という性格です。\n　・ヒーラー的な雰囲気があると尚Goodです。\n　→感覚的なところがあって難しいと思うので、描いててなんかちょっと違うってなってもOKです！\n★服装・アクセサリー\n　・学生制服系が良いです。\n　　江乃みきさんのデザインが好きなのでセーラー/ブレザーや着方などは気分で好きなように描いてほしいです。\n　　特にパッと思いつかないとなったら、リンク先の画像のような服装でOKです。\n★表情\n　下記どちらかが理想的ですが、描くときの気分で決めちゃって大丈夫です。\n　・不敵な笑み or 真剣な表情 or ちょっと煽ってる表情　など、Sっ気のある表情\n　・ポジティブで優しい、かわいい笑顔\n★ポーズ\n　立っている or 何かに寄りかかっているポーズが良いです！\n　こちらを見ているだけだったり、何か別なことをしていたりといった部分はおまかせします。\n★構図\n　できれば江乃みきさんのイラストを存分に味わいたいので、全身が見れる構図だととても嬉しいです。\n　ですが、描きたい構図に合わせてバストアップだけだったり、上半身だけだったりしちゃってもOKです。\n\n色々と希望を書きましたが、江乃みきさんが練習したい構図や表情を取り入れたり、希望に沿っていない形になっても全然OKです。\n\n以上です！\nよろしくお願いします！", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 26280, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "白金宵", "screen_name": "shirokane", "avatar_url": "https://pbs.twimg.com/profile_images/1480263251799998464/hXfcNhTG.png", "header_url": null, "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 7, "complete_expiration_days": 60, "skills": [{"genre": "art"}, {"genre": "novel"}], "banned": false, "nc": 16}, {"id": 444660, "creator": true, "nsfw_acceptable": false, "acceptable": false, "name": "兎鷺ぬい🎀ご依頼受付停止中", "screen_name": "u3g1n", "avatar_url": "https://pbs.twimg.com/profile_images/1875640662068228098/Ou8RjQUU.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1218847864282963968/1736022557/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 120, "skills": [{"genre": "art"}], "banned": false, "nc": 144}, {"id": 507746, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "藤堂 真樹🌸Skeb受付中", "screen_name": "Todomaki41", "avatar_url": "https://pbs.twimg.com/profile_images/2040792637159161856/-Hyza9SI.jpg", "head