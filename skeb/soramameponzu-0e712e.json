_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 328716, "creator": true, "nsfw_acceptable": false, "acceptable": false, "name": "はのるの", "screen_name": "hano_luno", "avatar_url": "https://pbs.twimg.com/profile_images/1902908293250682880/-WC9ziJJ.jpg", "header_url": "https://pbs.twimg.com/profile_banners/2322230635/1777483689/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 120, "skills": [{"genre": "art"}], "banned": false, "nc": 144}, {"id": 1030628, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "kittanke＠skeb募集中", "screen_name": "kittanke_illust", "avatar_url": "https://pbs.twimg.com/profile_images/2018534825775529984/KwcokEzD.jpg", "header_url": "https://pbs.twimg.com/profile_banners/2004138338157318147/1766659705/1500x500", "appeal_receivable": true, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 20, "complete_expiration_days": 50, "skills": [{"genre": "art"}], "banned": false, "nc": 160}, {"id": 2628656, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "ほちょ", "screen_name": "hocho_511", "avatar_url": "https://pbs.twimg.com/profile_images/1798513136070520832/BY6iqULc.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1403562765663432711/1692673176/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 90, "skills": [{"genre": "art"}], "banned": false, "nc": 145}, {"id": 2642849, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "ﾋﾟｮｰ", "screen_n