crop=top&w=200&h=200&s=f5dd1f9db29dccf1e4045c20f700b3f4", "srcset": "https://si.imgix.net/38b48773/uploads/origins/a73ed2af-9183-4773-a409-ab199dfd6951?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f5dd1f9db29dccf1e4045c20f700b3f4, https://si.imgix.net/38b48773/uploads/origins/a73ed2af-9183-4773-a409-ab199dfd6951?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=773aeec67ee3d70415e07c4f1a26f761 2x, https://si.imgix.net/38b48773/uploads/origins/a73ed2af-9183-4773-a409-ab199dfd6951?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=58f5e114255a07ae67099c2d6a0d16a5 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/38b48773/uploads/origins/a73ed2af-9183-4773-a409-ab199dfd6951?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0663cb97f20e09bb4f3e73e9be992542", "srcset": "https://si.imgix.net/38b48773/uploads/origins/a73ed2af-9183-4773-a409-ab199dfd6951?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0663cb97f20e09bb4f3e73e9be992542, https://si.imgix.net/38b48773/uploads/origins/a73ed2af-9183-4773-a409-ab199dfd6951?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=699f6eff1d952c8b38ad1d6788b7b512 2x, https://si.imgix.net/38b48773/uploads/origins/a73ed2af-9183-4773-a409-ab199dfd6951?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=69333024b65c978e951df95964390991 3x"}, "body": "初めまして！新着ユーザーからCeiさんを見つけてイラストを拝見し、最高に可愛い！と一目ぼれしてしまい依頼させていただきました…！\n\nもしよろしければ、自分のTRPG出身のオリジナルキャラクターのイラストを描いていただきたいです…！\n\n◆天使\n穏やかな細身の165cmの男性です。何事にも興味津々で食べることが大好きです。\n\nhttps://drive.google.com/file/d/15aY1o-t-GD4oTbfKOO05fr2MyhspoUZw/view?usp=sharing\n\n\n◆イラストイメージ\n\n雪の降る夜、暖かな部屋でクリスマスツリーに飾り付けをしている彼の姿を描いていただけないでしょうか？クリスマスツリー自体は、彼よりも少し大きいくらいのサイズで、てっぺんは背伸びしてやっと届くくらい…です！大きめのクリスマスツリーに1つずつ頑張って飾り付けている平和な日常を覗きたいです。\n\n服装は、最近冬によく売られてるモフモフのパジャマ？（ルームウェア）を着させてくれるとより嬉しいです！\n\nスマホの壁紙サイズだと嬉しいです。難しければ書きやすいサイズで全然問題ありません！(^^)\n\n\n以上になります。貴重なお時間をいただきありがとうございました！ぜひご検討のほどよろしくお願いします。\n\nhttps://drive.google.com/file/d/15aY1o-t-GD4oTbfKOO05fr2MyhspoUZw/view?usp=sharing", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}], "sent_works": [], "similar_creators": [{"id": 1650340, "creator": true, "nsfw_acceptable": false, "acceptable": false, "name": "ヨジマエ", "screen_name": "0359_am", "avatar_url": "https://pbs.twimg.com/profile_images/1403141495528431616/iUxJ_AD6.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1403131816530178050/1652538601/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 89, "skills": [{"genre": "art"}], "nc": 17}, {"id": 1670327, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "元素番号28🤍衣装skeb募集", "screen_name": "Niccolum_28_", "avatar_url": "https://pbs.twimg.com/profile_images/1886714949436891140/UIsuAN3Z.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1434915626246565899/1693848338/1500x500", "appeal_receivable": true, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 14, "complete_expiration_days": 60, "skills": [{"genre": "art"}], "nc": 145}, {"id": 1690263, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "緋影", "screen_name": "lunatic_rain125", "avatar_url": "https://pbs.twimg.com/profile_images/1977997172898746368/IUKqjUtQ.jpg", "header_url": "https://pbs.twimg.com/profile_banners/4772518934/1697029429/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "al