.net/4d231c36/uploads/origins/94225669-504e-44e2-9399-6ec0acf07ad6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=413e7fb7a605bd4f334272ccb3f0dc12", "srcset": "https://si.imgix.net/4d231c36/uploads/origins/94225669-504e-44e2-9399-6ec0acf07ad6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=413e7fb7a605bd4f334272ccb3f0dc12, https://si.imgix.net/4d231c36/uploads/origins/94225669-504e-44e2-9399-6ec0acf07ad6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=316ae4627c07217fff691bb9e185d1dc 2x, https://si.imgix.net/4d231c36/uploads/origins/94225669-504e-44e2-9399-6ec0acf07ad6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=56b41b942e4025f94228007e9d6f4f5d 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/4d231c36/uploads/origins/94225669-504e-44e2-9399-6ec0acf07ad6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2c46854724625a3ac0148fd7e1f63d0c", "srcset": "https://si.imgix.net/4d231c36/uploads/origins/94225669-504e-44e2-9399-6ec0acf07ad6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2c46854724625a3ac0148fd7e1f63d0c, https://si.imgix.net/4d231c36/uploads/origins/94225669-504e-44e2-9399-6ec0acf07ad6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=e7922b48fcf4365c76e78dfc2e018cc6 2x, https://si.imgix.net/4d231c36/uploads/origins/94225669-504e-44e2-9399-6ec0acf07ad6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=5883e0f0224ce693e4b2ac7c7862086b 3x"}, "body": "初めまして。あなた様の絵がとても好きで、今回リクエストさせていただきます。\n内容ですが、私のオリキャラ、ルートヴィヒを描いていただきたいです。同じ人物で別設定の別のキャラクターです。双方絡ませていただいても構いません。\nルートヴィヒの共通設定：ドイツ人。20代。ナチ親衛隊所属。童顔。他人の痛みに共感しない・できない。外のことに無関心で、冷淡ですらある。感情はあるが、あまり外部に表れない。垂れ目、金髪のオールバックをよく整えている。殆どの場合、穏やかそう笑みを浮かべている。中流階級の出身だが、苦労が多かった。孤独であることに頓着しないが、集団行動に支障はない。甘党。\n緑の軍服の方：特別行動隊の少尉。部下を上手くまとめている。表面上人望が厚いように見える。人好きがする笑顔を浮かべることが得意。拳銃を持ち歩いている。略帽を被るが、被っていないことが多い。\n黒い軍服の方：拷問官の中尉。頭に手術痕がある。口が裂けている。手袋をし、軍帽を被っている。拷問を好み、少尉よりも子供っぽく、倫理観のタガが外れている。ダガーを持ち歩いている。\n具体的な内容：（https://x.com/otori_666/status/1928099192301289923）のように、少し血や刃物（銃）の描写があると嬉しいです。加えて、（https://skeb.jp/@marin_666e/works/1）のように、外枠と内枠の区別や、枠の外に何かが少しはみ出している、黒を大胆に使った雰囲気にして頂きますでしょうか。また、必要に応じて私の過去の依頼もご参照ください。\n差分や没ラフなどがあったらそれも添付して頂けると嬉しいです。\n使用用途：個人での鑑賞、他の依頼人様への参考資料\n条件などが合わなければ、キャンセルや再送などしてもらえると幸いです。ご検討のほどよろしくお願い致しします。\n\nhttps://www.dropbox.com/scl/fo/sk6shgnaha3wylzwshx96/APvUlz6manu8KkkM6pn0B38?rlkey=6awf01n63d1o1445ux6yi5vou&st=gfux941m&dl=0", "nc": 153, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@marin_666e/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3032410, "client_id": 1990741, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/db3be607/uploads/origins/9cf482e3-1a37-4146-b4d5-13ae26147eba?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8f8db8afaaa3adcaf9dae04351b510f3", "srcset": "https://si.imgix.net/db3be607/uploads/origins/9cf482e3-1a37-4146-b4d5-13ae26147eba?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8f8db8afaaa3adcaf9dae04351b510f3, https://si.imgix.net/db3be607/uploads/origins/9cf482e3-1a37-4146-b4d5-13ae26147eba?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=7e69d3cf0a20fce77751b7f21fce56f4 2x, https://si.imgix.net/db3be607/uploads/origins/9cf482e3-1a37-4146-b4d5-13ae26147eba?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=799f88266757dd6ea04179e053abab8a 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/db3be607/uploads/origins/9cf482e3-1a37-4146-b4d5-13ae26147eba?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e716fcdfc