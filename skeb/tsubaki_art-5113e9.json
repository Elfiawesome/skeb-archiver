om/drive/folders/12ysDh6nb2MPlePnLDFOFoW72CegBmuL-?usp=sharing\n(with shuriの資料はこの二人のif魔法のイメージです！）\n\n衣装は中華風/和風　中1\n雰囲気は日常(明るい）/ノワール（暗い）中1\n\nで、詳しいポーズとか衣装、背景などもlí様にお任せします！\n\nよろしくお願いします。", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@tsubaki_art/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2682671, "client_id": 335437, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/ebff7b74/uploads/origins/00aee55d-dae6-4c62-a98d-f3c6214fe0b9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e9e6382f182d0c83a3793d2a5277f83f", "srcset": "https://si.imgix.net/ebff7b74/uploads/origins/00aee55d-dae6-4c62-a98d-f3c6214fe0b9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e9e6382f182d0c83a3793d2a5277f83f, https://si.imgix.net/ebff7b74/uploads/origins/00aee55d-dae6-4c62-a98d-f3c6214fe0b9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=75260ae57505dced4f5be03a4b4bc81f 2x, https://si.imgix.net/ebff7b74/uploads/origins/00aee55d-dae6-4c62-a98d-f3c6214fe0b9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=24a00d0d0a5a6c8df788065cb801f5c1 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/ebff7b74/uploads/origins/00aee55d-dae6-4c62-a98d-f3c6214fe0b9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=80bfdb95c77e81aeebc0d7d77e4491b7", "srcset": "https://si.imgix.net/ebff7b74/uploads/origins/00aee55d-dae6-4c62-a98d-f3c6214fe0b9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=80bfdb95c77e81aeebc0d7d77e4491b7, https://si.imgix.net/ebff7b74/uploads/origins/00aee55d-dae6-4c62-a98d-f3c6214fe0b9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=050e31403694026e98fbf97f7bb5b418 2x, https://si.imgix.net/ebff7b74/uploads/origins/00aee55d-dae6-4c62-a98d-f3c6214fe0b9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=334338cc68891d10247a829229946a7f 3x"}, "body": "こんにちは！私はあなたの絵がとても好きなので、またあなたに依頼したいと思いました。\n\n今回は、私のキャラクターであるアトランとニックスを描いてほしいです。\n\nアトラン (https://sta.sh/07ngv4nag77) は\n170cmで、星から生まれた猫です。髪には小さな星と星座が描かれています。地球に落ちてきてから、この星の生物に興味を持つようになった。\n\nNyxx（https://sta.sh/01o72cm1en86）は身長180cmで、黒い煙でできた狐です。\n昼間は耳と尻尾の先が煙のように透けて見える。人間を好まないが、傷つけたくないという一尾のキツネである。アトランよりも静かで真面目な性格をしている。\n\nこの二人は太陽と月（明と暗）をテーマにしているので、イラストに書き加えてもらえるとうれしいです。二人は友人で、流れ星として地球に降り立ったアトランをニクスが発見した後、旅のパートナーになった。\n\nこの2人が一緒にいる絵を描いてほしいです！ポーズや表情、やりとりなどの詳細はお任せします！ありがとうございました！", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@tsubaki_art/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2682671, "client_id": 2138345, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/4be674d7/uploads/origins/12bcbb6c-5eb3-4470-a905-e0b62a1ff7ca?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a7443719b2c82bde54040b94d3275d3c", "srcset": "https://si.imgix.net/4be674d7/uploads/origins/12bcbb6c-5eb3-4470-a905-e0b62a1ff7ca?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a7443719b2c82bde54040b94d3275d3c, https://si.imgix.net/4be674d7/uploads/origins/12bcbb6c-5eb3-4470-a905-e0b62a1ff7ca?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=3e9e5ad0664dd6a34d962f952b93b664 2x, https://si.imgix.net/4be674d7/uploads/origins/12bcbb6c-5eb3-4470-a905-e0b62a1ff7ca?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b072a1d20d9d3651f783ad6f52b69175 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/4be674d7/uploads/origins/12bcbb6c-5eb3-4470-a905-e0b62a1ff7ca?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2d106850bfdc22bf29258f6efc59f23d", "srcset": "https://si.imgix.net/4be674d7/uploads/origins/12bcbb6c-5eb3-4470-a905-e0b62a1ff7ca?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2d106850bfdc22bf29258f6efc59f23d, https://si.imgix.net/4be674d7/uploads/origins/12bcbb6c-5eb3-4470-a905-e0b62a1ff7ca?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=d744a9c92330ba1653c1b8d1872134ac 2x, https://si.imgix.net/4be674d7/uploads/origins/12bcbb6c-5eb3-4470-a905-e0b62a1ff7ca?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=127ec6b9f562afaa307c81b5f2bbca23 3x"}, "body": "はじめまして。lí様の絵を見て一目惚れしましたのでリクエストをお願いしたいです。\n\n相片思いで同僚関係の二人です。\n\nピンクの女の子は160ｃｍ、明るくて元気な子です。\n金髪の男の子は175ｃｍ、無口で親しい人だけに喋る性格です。\n\nポーズとか衣装、背景など詳しい設定はlí様にお任せします。\nデートとか化け物とかシチュエーションはどうでもいいです！\nlí様のデザインが素敵だと思うのでご自由に作業してください！\n（lí様の和風がとても好きで和風側なら幸せです。）\n\nよろしくお願いします。\n（金額に問題がありましたら、金額を修正した後、再送信を要請していただければ幸いです！)\n\nhttps://drive.google.com/drive/folders/1cSkUuZESntsWG75phZpitofCny5bidHQ?usp=sharing", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@tsubaki_art/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2682671, "client_id": 335437, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/3d6ac3be/uploads/origins/3da7a799-7b18-4cb9-82ea-5938b0519dc3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=844827d9f8ddb1aa09857e3664bab380", "srcset": "https://si.imgix.net/3d6ac3be/uploads/origins/3da7a799-7b18-4cb9-82ea-5938b0519dc3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=844827d9f8ddb1aa09857e3664bab380, https://si.imgix.net/3d6ac3be/uploads/origins/3da7a799-7b18-4cb9-82ea-5938b0519dc3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=669d0907eb1