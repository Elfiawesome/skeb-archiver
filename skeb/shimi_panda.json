e4-87bd-e3deae0f4484?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=22cbbe6be82860818b42b8d03e788071", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/15601b42/uploads/origins/ea362ec5-45ba-48e4-87bd-e3deae0f4484?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=85d8717e12917ad920322d37b7de2d20", "src_set": ""}, "body": "五等分の花嫁の中野二乃お願いいたします！\nポーズはおまかせいたします！", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@shimi_panda/works/49", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 457363, "client_id": 7907, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/dd6f24f4/uploads/origins/36bde4fd-2097-4cc8-a1bb-aaba5bc16b8c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=eb83280e2b07d43f284f8af05855a1af", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/dd6f24f4/uploads/origins/36bde4fd-2097-4cc8-a1bb-aaba5bc16b8c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=8520d2f4f9a838703b4ad6bc53c12f3e", "src_set": ""}, "body": "こんにちは！昨年アピールをいただき、ありがとうございました！\nshimiさんのイラスト、とても素敵ですね！\nぜひ、shimiさんにも私のオリジナルキャラクターのメイプルリーフを描いていただきたく、リクエストさせていただきます。\n\n名前:  メイプルリーフ（メイリ）\n年齢:  14歳\n種族: 翼人\n外観設定: 髪と、人間の耳にあたるところにある鳥のような翼は琥珀色～橙色（メイプルシロップのような）。\n肩ぐらいまでのウェーブがかった髪。三つ編みをリング状に冠のように編み込んでいる（「三つ編みハーフアップ」で検索すると出てくる髪型）。\n背中には大きな鳥のような翼があり、柔らかいクリーム色をしている。\n瞳はアメジストにたとえられる紫色で、くりくりとした可愛らしいイメージ。\n身長は150cmぐらい（まだ伸びる）で、やや華奢ながら、女の子らしいシルエット。\n内面: 普段はほわほわしているが、弟がおり、（お姉ちゃんなんだから、頑張らなきゃ！）が心の中の口癖（根暗気味だったり、破壊衝動にかられたりもする）\n口調: 丁寧、ほんわか\n趣味等:夢は庭園のデザイナー。花や植物について勉強をしたり、世界中の庭園を見て回っている。料理や宝石等も好き。\n「素敵なお庭を作れるようになるために、たくさんの場所を旅してみたいんです！」\n「温かいものを食べると、心までぽかぽかしますね」\n\n●使用用途\nオリジナルキャラクター登録型のゲームでの使用や、キャラクター紹介、他のイラストレーターさんへの参考資料としての提示などキャラクター紹介での利用を予定しています。\nカットインもしくはプロフィール画像、一部を切り抜いてアイコンとして使用させていただきたいです。\n\n服装やシチュエーション等はお任せいたします！\nもしよろしければ、どうぞよろしくお願いいたします。\n\nhttps://nine-tails.biz/img/mapleleaf/mapleleaf_2.png", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@shimi_panda/works/48", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 457363, "client_id": 116281, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/06b1b245/uploads/origins/ebc4192d-0198-4f0e-93e2-515553629cb7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a33b6a8f3144570afd07e6d6193f1bcc", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/06b1b245/uploads/origins/ebc4192d-0198-4f0e-93e2-515553629cb7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ad17aed4112ac84505274a25c7041824", "src_set": ""}, "body": "アイドルマスターシンデレラガールズの神崎蘭子とアニメ版プロデューサー(通称武内P)のイラストをリクエストさせていただきます。\nシチュエーションは以下の通りです。\n\n・喫茶店で大盛りのスパゲッティを二人で食べてたら、スパゲッティが繋がっていてお互いを見ながら照れる場面。\n101匹わんちゃんのスパゲティのシーンのイメージです。\n・蘭子の衣装は資料URLを参照ください。\n・武内Pの衣装はアニメで着ている背広。\n\n以上、検討のほどよろしくお願いいたします。\n\nhttps://starlit-season.idolmaster.jp/idol/idol.php?idol=ranko-kanzaki", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@shimi_panda/works/47", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 457363, "client_id": 2784612, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/1e280335/uploads/origins/883fa705-3dad-4964-bb31-a70455ff10d2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=61f125f9640f32fdb796657923f814bc", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/1e280335/uploads/origins/883fa705-3dad-4964-bb31-a70455ff10d2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=bec45b4290cb0ae9466939a41add19bc", "src_set": ""}, "body": "お久しぶりです。\nalabasと申します。\n\n以前はうちの子のみさらちゃんを描いてくださりありがとうございます。\nもしよろしければ新しいうちの子のれいなちゃんを描いて頂けないでしょうか？\n詳細はの資料リンクにございます。\n\n構図やシチュエーションなどは特に指定しないので、そちらの方で自由に描いてしまってください。基本部分さえ抑えてあればアレンジも自由です。\n以下自分的なメモみたいなものになります。\n参考にできるところは参考にしてください。\n\n・髪型\n腰辺りまでの金髪のロングです。\n束ねている姿でも解いている姿でもどちらでも構いません。\n\n・野戦服\n開襟で色はグリーン系を想定しています。モデルはドイツ軍の野戦服でポケットが４つ付いています。これにY型サスペンダーを付けています。勲章などは自由です。\n\n・肩章、襟章、袖章、アームバンド、ベルトバックルのエンブレム、勲章\n厳格にこういうのというのは無いので好きなようにデザインしてみてください。\n\n・マガジンポーチ、マップケース\n前の方にベルトで付けている設定です。モデルはWWⅡのドイツ軍の物になります。\n\n・ズボン、ブーツ\n将校用の乗馬ズボンと乗馬ブーツです。難しかったらそれっぽい感じでも大丈夫です。\n\n・帽子\n将校用の帽子または戦闘用のヘルメット、もしくは無しでもどちらでも構いません。\n\nよろしければご検討の程、よろしくお願いいたします。\n\nhttps://misskey.io/notes/9ptqtvkwirbv04xp", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@shimi_panda/works/46", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 457363, "client_id": 335739, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/07f7ed94/uploads/origins/e3676bf6-8d1f-4d80-b84c-6df3ec0fff61?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=972f86591a9bef3778e5c8e62310e26a", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/07f7ed94/uploads/origins/e3676bf6-8d1f-4d80-b84c-6df3ec0fff61?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ee6d5c099a41d8da0f30369b46b63b85", "src_set": ""}, "body": "麻雀ファイトガールのアンコク・ミツバをお願いいたします！\nポーズはおまかせいたします！", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@shimi_panda/works/45", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 457363, "client_id": 335739, "vtt_url": null, "thumb