0806-a4e5-41c8-9ce6-bef00ab35319?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=89b1e95d7d7bd30fa3c9a99a5c24de1e", "srcset": "https://si.imgix.net/1b216f58/uploads/origins/7e590806-a4e5-41c8-9ce6-bef00ab35319?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=89b1e95d7d7bd30fa3c9a99a5c24de1e, https://si.imgix.net/1b216f58/uploads/origins/7e590806-a4e5-41c8-9ce6-bef00ab35319?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=0c9b7073bbdeaebbf27fade290101d8a 2x, https://si.imgix.net/1b216f58/uploads/origins/7e590806-a4e5-41c8-9ce6-bef00ab35319?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=932efd16795a30104864cb913c7df2fa 3x"}, "body": "前回はお世話になりました。\n改めて依頼させていただきます。\n\n依頼内容：前回依頼（https://skeb.jp/@haramaseninpu/works/15)の元少年Aの後日談多胎イラスト\n設定：前回依頼の数年後、それまで何度も同級生のフタナリ女子の子供の多胎妊娠を繰り返している元少年Aが何度目かの臨月で学校新聞用のインタビュー記事で裸の立ち姿を撮影している様子(妊娠出産数記録の更新した事の特集扱い)\nキャラ設定\n元少年A　\n前回依頼の3年後の姿\n顔つきや口調や性格は元の男子らしさを保っている(本人曰く、そっちのが同級生からは好評なため)\n首から上は年齢相応だが、首から下の肉体は度重なる多胎妊娠によって(https://www.pixiv.net/artworks/146122201)以上のムッチムチの爆乳爆尻デカ乳首の熟女のようになっている\nお腹には産んだ子供の数だけタトゥー\n(https://www.pixiv.net/artworks/138261339)と同程度かそれ以上のの妊娠数で、お腹の大きさも妊娠数相応（お腹の子供の父親これまで全員同級生で男女問わず）\n元少年Aは妊娠するのにはまっている様子\n\nテキストもお願いします。\n\n以上です。よろしくお願いいたします。", "nc": 169, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@haramaseninpu/works/17", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 357905, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/8faeed9b/uploads/origins/a665969e-35a5-430b-8e38-01debfee56ad?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ae51ca70196f0a939f8601bbb00ed0e7", "srcset": "https://si.imgix.net/8faeed9b/uploads/origins/a665969e-35a5-430b-8e38-01debfee56ad?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ae51ca70196f0a939f8601bbb00ed0e7, https://si.imgix.net/8faeed9b/uploads/origins/a665969e-35a5-430b-8e38-01debfee56ad?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ddc3e56ba3603f34b2ce9cb3f3336de5 2x, https://si.imgix.net/8faeed9b/uploads/origins/a665969e-35a5-430b-8e38-01debfee56ad?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=eaf0cb56f027f27073efa0629437dc24 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/8faeed9b/uploads/origins/a665969e-35a5-430b-8e38-01debfee56ad?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=832c09b8a0779e26e13235a5375c2d00", "srcset": "https://si.imgix.net/8faeed9b/uploads/origins/a665969e-35a5-430b-8e38-01debfee56ad?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=832c09b8a0779e26e13235a5375c2d00, https://si.imgix.net/8faeed9b/uploads/origins/a665969e-35a5-430b-8e38-01debfee56ad?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=0e0b1e7e032a49de0eabcfab9ee33f76 2x, https://si.imgix.net/8faeed9b/uploads/origins/a665969e-35a5-430b-8e38-01debfee56ad?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=b3a95a8385c45e042be9c8fe50383aea 3x"}, "body": "【キャラクター】\nウルフカットでボーイッシュ気味な可愛いJC2の女の子。妊娠38週目。特に妊娠とは関係ないが精神だけが生後半年ほどの赤ちゃんに幼児退行している。(目にハイライトあり)\n\n【シチュエーション】\n実家の綺麗な布団に仰向けに寝かされた体勢で、こちら(母親)を見つけて、口元はヨダレで濡れていて機嫌よく手を伸ばしてきている。\n服装はオムツとヨダレ掛けだけ着用で、それ以外は裸。枕元に口からこぼれたおしゃぶりが落ちている。\n\n\n以上、よろしくお願いします。", "nc": 41, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@haramaseninpu/works/16", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 357905, "client_id": 366455, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/0984a358/uploads/origins/70df0ccb-1879-4c79-8b56-d94dcc9732d7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1b4819a64deb55ed8d54de2f9c4db996", "srcset": "https://si.imgix.net/0984a358/uploads/origins/70df0ccb-1879-4c79-8b56-d94dcc9732d7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1b4819a64deb55ed8d54de2f9c4db996, https://si.imgix.net/0984a358/uploads/origins/70df0ccb-1879-4c79-8b56-d94dcc9732d7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=8f1202cc5f37c9c1d745ae3633dc18cd 2x, https://si.imgix.net/0984a358/uploads/origins/70df0ccb-1879-4c79-8b56-d94dcc9732d7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=7791fb3139bbe65dca09f93dd7650cad 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/0984a358/uploads/origins/70df0ccb-1879-4c79-8b56-d94dcc9732d7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=19f30f040642566b4213a5f32f119615", "srcset": "https://si.imgix.net/0984a358/uploads/origins/70df0ccb-1879-4c79-8b56-d94dcc9732d7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=19f30f040642566b4213a5f32f119615, https://si.imgix.net/0984a358/uploads/origins/70df0ccb-1879-4c79-8b56-d94dcc9732d7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=169caa7a3d13b4fd0feb290ab276b2b9 2x, https://si.imgix.net/0984a358/uploads/origins/70df0ccb-1879-4c79-8b56-d94dcc9732d7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=cc093b8eb4fb351f125ae40859060023 3x"}, "body": "いつも楽しませていただいております。\n\n今回ははらませ様が公開されているイラスト「強豪野球部妊婦マネーシャーのお仕事」が素晴らしかったので、ぜひ似たシチュエーションのイラストを描いていただきたいと思いリクエストを出させていただきました。\n可能ならイラストとテキスト両方でお願いできますでしょうか\n\n【キャラクター】\n・少女\n11～2歳ぐらいの男勝りの日焼け少女。乱暴者でクラスのガキ大将として君臨しており男子も女子も恐れさせていた\n\n【ストーリー】\n・変質者に強姦され妊娠してしまった少女はこれまでの仕返しと、クラスの少年たちの玩具になる\n\n【詳細】\n・妊婦となった少女は全裸でしゃがんで股を開いており、目に涙を浮かべ悔しそうな表情で周りを睨みつけている。\n・少女の周りをクラスの男子たちがやはり全裸で笑いながら取り囲んでいる\n・ストーリーでは、少女が無理やり従わされていることと、少年たちの「逆らったら腹を蹴っ飛ばすぞ！」という感じの脅しゼリフがあると嬉しいです。\n・できれば足の指まで見える構図でお願いできますでしょうか\n・少年たちは無毛包茎でお願いできますでしょうか\n\n以上、ご一考いただければ幸いですので宜しくお願い致します。", "nc": 56, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@haramaseninpu/works/15", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 357905, "client_id": 497423, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/3a85a401/uploads/origins/4e039ab4-2659-43bb-896c-9a7abd50bf05?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b82f6b610403a152094ecbaae2aa6ea0", "srcset": "https://si.imgix.net/3a85a401/uploads/origins/4e039ab4-2659-43bb-896c-9a7abd50bf05?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b82f6b610403a152094ecbaae2aa6ea0, https://si.imgix.net/3a85a401/uploads/origins/4e039ab4-2659-43bb-896c-9a7abd50bf05?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=035df905d3f619e8f8a58f4f1a2d96ce 2x, https://si.imgix.net/3a85a401/uploads/origins/4e039ab4-2659-43bb-896c-9a7abd50bf05?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a705e382419398121545ccc8a463b1d2 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/3a85a401/uploads/origins/4e039ab4-2659-43bb-896c-9a7abd50bf05?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a064e6217305f7ad3f7025c9fa34c2dc", "srcset": "https://si.imgix.net/3a85a401/uploads/origins/4e039ab4-2659-43bb-896c-9a7abd50bf05?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a064e6217305f7ad3f7025c9fa34c2dc, https://si.imgix.net/3a85a401/uploads/origins/4e039ab4-2659-43bb-896c-9a7abd50bf05?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=330c48fc3f836dd804e5eae30a94dcb1 2x, https://si.imgi