柄で是非見てみたい子がおり、リクエストいたします。\n\n描いていただきたいのはイシュメールという名前のOCです。\n・個人鑑賞を目的とします。特にポストカード等の紙媒体に印刷して飾りたいと考えています。\n・イシュメールの表情は笑っていてほしいです。嬉しそうでも、悲しそうでも、困っていても、不敵でも、無邪気でもいいです。\n・そのほかの構図やシチュエーション、服装はお任せします。\n\nご検討よろしくお願い申し上げます。\n\nhttps://skindive.notion.site/2b71a286e3d78082afa7d38e39eea68e?source=copy_link", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@aluy01/works/8", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/ef681a72/uploads/origins/f0c13371-c7dc-4bd8-b0ca-5d1e9aed5854?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=f1a8c47c15958c7398f1018f640344c9", "srcset": "https://si.imgix.net/ef681a72/uploads/origins/f0c13371-c7dc-4bd8-b0ca-5d1e9aed5854?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=f1a8c47c15958c7398f1018f640344c9, https://si.imgix.net/ef681a72/uploads/origins/f0c13371-c7dc-4bd8-b0ca-5d1e9aed5854?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=e56acb8c3760a81d6e7f694cea765e01 2x, https://si.imgix.net/ef681a72/uploads/origins/f0c13371-c7dc-4bd8-b0ca-5d1e9aed5854?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=ba8b2e21c992a2b87f02ee0ab81bfffa 3x"}, "private": true, "genre": "art", "tipped": false, "creator_id": 3088248, "client_id": 37489, "nc": 129}, {"path": "/@aluy01/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3088248, "client_id": 731969, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/388ffb48/uploads/origins/1e2a84a9-a39c-4d