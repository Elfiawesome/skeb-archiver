もって怯えながら暮らしている。\n\n尻尾を両手で挟んで持ってフリフリすることで植物系の魔法を使うことができるが、うまくコントロールできず、\n勝手に植物が生えていたり、ツルで縛られていたりする。\n\n体をちぎると綿が出てきて、尻尾をちぎると草の緑色の汁が出てくる。\n体の70%以上が損傷した場合、自動的に体が光に包まれブローチに吸い込まれ、休眠状態に移行し完全回復できる。服が破れた場合も復活する。\nブローチが破壊されることはない。\n\n窮地に立った際、暴走状態になり全身が真っ赤で攻撃的な状態になるが、詳細は不明。\n本人も覚えてない。\n-------------------\n\nhttps://drive.google.com/drive/folders/1AyedYI0Yhrzp9tRlKZtf3JLo-r9S_7Sz?usp=sharing", "nc": 9, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@aluy01/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3088248, "client_id": 516825, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/84bf5b97/uploads/origins/46dec371-1350-446b-a3c4-ed1e5ce30577?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=57f2acfb703048c8f014343323502c78", "srcset": "https://si.imgix.net/84bf5b97/uploads/origins/46dec371-1350-446b-a3c4-ed1e5ce30577?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=57f2acfb703048c8f014343323502c78, https://si.imgix.net/84bf5b97/uploads/origins/46dec371-1350-446b-a3c4-ed1e5ce30577?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=164dd28141017de1e90cbcc00e5e81bd 2x, https://si.imgix.net/84bf5b97/uploads/origins/46dec371-1350-446b-a3c4-ed1e5ce30577?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=523ae1a27ac6976814ff5a3c263eb5de 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/84bf5b97/uploads/origins/46dec371-1350-446b-a3c4-ed1e5ce30577?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=96f52f96dc576f6b1857866f43542eee", "srcset": "https://si.imgix.net/84bf5b97/uploads/origins/46dec371-1350-446b-a3c4-ed1e5ce30577?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=96f52f96dc576f6b1857866f43542eee, https://si.imgix.n