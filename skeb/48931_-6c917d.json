i.imgix.net/9785a625/uploads/origins/d646fd9f-b9f2-4bab-b5b4-8e69328356da?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=eb7a7b51253f503dd85f3eb1bd2130de 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/9785a625/uploads/origins/d646fd9f-b9f2-4bab-b5b4-8e69328356da?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=fd45cf72ccc5dda394272c48d55d3d1e", "srcset": "https://si.imgix.net/9785a625/uploads/origins/d646fd9f-b9f2-4bab-b5b4-8e69328356da?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=fd45cf72ccc5dda394272c48d55d3d1e, https://si.imgix.net/9785a625/uploads/origins/d646fd9f-b9f2-4bab-b5b4-8e69328356da?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=012ec0829391410514de13d7a2be54d2 2x, https://si.imgix.net/9785a625/uploads/origins/d646fd9f-b9f2-4bab-b5b4-8e69328356da?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=0d93cff06cc0e163b86a6cb22dd854c7 3x"}, "body": "TRPGのうちよそを、お願いします･････････････････\n男二人組で、関係性はブロマンスが一番近いです。\n見た目は三年前ではなく現在の方でお願いします･･･！\n黒髪の方が着ているスカジャンについてですが、デザインはお任せします！配色のみ合っていれば大丈夫です！\n\n以下詳細です（見た目の記載以外は読まなくても全然OKです！）\n\n■一人目：藤 秀太郎(ふじ しゅうたろう)　29歳/男/探偵\n（黒髪でスカジャン着てる方）\n\n・見た目\nhttps://iachara.com/view/8022170\n向かって左目辺りに斜めに切られたような傷跡がある。\nギザ歯。隈がある。常に手袋をしている。\n\nぱっと見の印象から怖がられることも多いが面倒見の良い一面もある。\n金星凛のことを大切に思っており、有事の際には金星凛の安全を最優先する。最悪の場合は自分の命を引き換えにしてでも守ろうと考えている。\n口数はそれほど多い方ではない。何か心配事があっても金星には伝えずにできるだけ一人で解決しようとする。\n神話生物や心霊関連の依頼が増え、内心心労が絶えない。\n喫煙者。煙草が手放せない。\n\n・口調　\n　一人称俺/二人称あんた　金星凛に対しては「金星」呼び\n\n\n■二人目：金星 凛(かなぼし りん) 18歳/男/大学生\n\n・見た目\n銀髪、眼鏡をかけている。\n向かって右目下辺りにほくろが３つある。\n\n・口調　\n　一人称僕/二人称〇〇さん　秀汰郎に対しては「秀汰郎さん」呼び\n\n　出会った当初から秀汰郎に絶対的な信頼を置いており、秀汰郎から「理由は言えないがここを離れるぞ」と話されたとしても「秀汰郎さんがそう言うなら何か理由があるのだろう」と考えて何も聞かずについていくタイプ。最初は自分に自信が持てずおどおどしていたが、今は比較的明るくなった。\n\n【関係性】\nお互いよく喋るタイプではないため、初対面のときは会話が続かずかなり気まずかった。\n今では互いのことを一番大切に思っている。\n3年前に出会い、今は成り行きで同じ家に住んでいる。\n秀汰郎は探偵のため他に事務所があり、金星凛は大学の授業が無い日に依頼人の応対を手伝ったりしている。\n秀汰郎がゲームとかやってると金星が隣に座って見てたりする。\n\nhttps://drive.google.com/drive/folders/1qcjGhkLXQiaJEdf6dRgkmZwETwjbyytj", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "similar_creators": [{"id": 222322, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "しばこ", "screen_name": "sibaco_oioio", "avatar_url": "https://pbs.twimg.com/profile_images/1216040465616658433/XhH0qAfd.jpg", "header_url": "https://pbs.twimg.com/profile_banners/128829852/1609429799/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 120, "skills": [{"genre": "comic"}, {"genre": "art"}], "banned": false, "nc": 177}, {"id": 311083, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "ほ", "screen_name": "Heo_taT3DR", "avatar_url": "https://pbs.twimg.com/profile_images/1387747485376937984/NRGzvdWs.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1228913992808067073/1619699759/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "art"}], "banned": false, "nc": 32}, {"id": 457334, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "名無師", "screen_name": "nanasi_RPG", "avatar_url": "https://pbs.twimg.com/profile_images/2106594522130157568/tbVpr7Mq.jpg", "header_url": "https://pbs.twimg.com/profile_banners/187579824/1685725563/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_da