0fdb9221000421a5b9b936, https://si.imgix.net/b56e5bfe/uploads/origins/74bf3a04-43e3-4118-96c8-3dfa4161e6d0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=df0d2177654f4ff63a7662f1fe44ac22 2x, https://si.imgix.net/b56e5bfe/uploads/origins/74bf3a04-43e3-4118-96c8-3dfa4161e6d0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b9d0eafb04dcb84426281d064c6d39c8 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/b56e5bfe/uploads/origins/74bf3a04-43e3-4118-96c8-3dfa4161e6d0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b739293bb8320f049c103292e86c2c6d", "srcset": "https://si.imgix.net/b56e5bfe/uploads/origins/74bf3a04-43e3-4118-96c8-3dfa4161e6d0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b739293bb8320f049c103292e86c2c6d, https://si.imgix.net/b56e5bfe/uploads/origins/74bf3a04-43e3-4118-96c8-3dfa4161e6d0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=33c56623c4fea3840639825d3f9802b6 2x, https://si.imgix.net/b56e5bfe/uploads/origins/74bf3a04-43e3-4118-96c8-3dfa4161e6d0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=0f883e67674429f387eb7c899d59c44b 3x"}, "body": "こんにちは！私のOCのリクエストを送らせてください！\n\n彼女の名前はShiloh、甘くて優しくて楽観的。ダンス、ファッション、ガーデニング、森の中で自然の中で過ごすのが好き。\n\n胸は平らで、顔にはそばかすがあり、首にはいつも黒い犬の首輪をしています。首輪とピンクのヘッドバンドがデザインに含まれている限り、彼女のリファレンスに登場するどの服装でも、そのスタイルに似たオリジナルのものでも、自由に描いてください！\n\n参考文献\n\nhttps://drive.google.com/drive/folders/1vmSq7B3zXa0066wxDDZZ85qiFBeJwlhV?usp=drive_link\n\n\nリクエスト読んでくれてありがとう", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@mememe119119/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1455047, "client_id": 1060143, "vtt_url": null, "thumbnail_image_urls": {"src": "ht