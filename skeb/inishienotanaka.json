crop=top&w=200&h=200&blur=200&s=5566945d15bbbc7bbbc825ff1788236d", "src_set": ""}, "body": "こんにちは！この度はありがとうございました！私のOCケイルのエイジドアップのデザインをお願いしたいです。彼女は紫のジャケットを着ていて、パンツはブルーのジーンズです。ジャケットは腰に巻いて、下のAシャツは白ではなく黒にしてほしいです。髪は長めで、背中の真ん中あたりまで伸びていて、ティファ・ロックハートのように前髪なしでポニーテールにしてほしい。腕も指から肩まで包帯を巻いているので、それも残したい。最後に、彼女の胸をもっと大きくして、全体的に引き締まって見えるようにしたいです。ポーズとしては、風に髪と上着がなびく中、腰に手を当てて横を見ながら髪をなでるようなポーズがいい。\n\n参考文献\nhttps://files.catbox.moe/udthcl.png\nhttps://files.catbox.moe/glqww1.jpeg\nhttps://files.catbox.moe/peyu5i.jpeg\nhttps://files.catbox.moe/tj32zl.jpg\nhttps://files.catbox.moe/hjxro4.jpg\nhttps://files.catbox.moe/398c6j.jpg", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@inishienotanaka/works/23", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3024770, "client_id": 3594240, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/c821a6cf/uploads/origins/92f1bf7f-ea1f-4cbd-94cf-37c8b9494f1e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6e76701360fa21261185688e87a5a89f", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/c821a6cf/uploads/origins/92f1bf7f-ea1f-4cbd-94cf-37c8b9494f1e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=8b065292d1b8772a6b07cbcdce8375a2", "src_set": ""}, "body": "僕のキャラクター、コーミラの絵を依頼したいんだ。私が持っている参考画像は、私が彼女をどのようにイメージしているかを示すために、大まかな色付けをした簡単なスケッチです。彼女は人間の狼の女の子で、ストリート/パンクの美学を持っていて、あなたのスタイルにとても合うと思います。緑色のサンプル写真に写っているトラの女の子と同じようなポーズが欲しいのですが、その代わりに指の間にタバコを挟んでいます。その代わり、指の間にタバコを挟んでいます。ありがとうございました。\n\nhttps://drive.google.com/file/d/1y2hY7tM5Ig8oSj7CSr87Hb2oIb5YAiks/view?usp=drivesdk", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@inishienotanaka/works/22", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/f7ac9e5c/uploads/origins/7bdced14-8076-4e6c-b6e0-7936fd02f3a3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=c07fa2a278006177ab64d4f0c4f34241", "src_set": ""}, "private": true, "genre": "art", "tipped": false, "creator_id": 3024770, "client_id": 0, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 17, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@inishienotanaka/works/21", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3024770, "client_id": 1024778, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/bb333199/uploads/origins/6e923afc-3b44-4013-b731-9c43d885c710?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bc0c8870f2cd128e34d425f2d1620930", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/bb333199/uploads/origins/6e923afc-3b44-4013-b731-9c43d885c710?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=76976ba71771bdf6363374bfb1a05983", "src_set": ""}, "body": "こんにちは、先生～！\n\n私のOC「レイハ」の人間姿のイラストをお願いしたいです！\n\nレイハは「創造の頂点」と呼ばれる水の女神です。彼女は穏やかで、外向的で、冒険をしたり、新しい世界を探検したりすることを熱望しています。手と手を使った素晴らしいファイターであり、大剣を使ったソードファイターであり、原初の水のパワーの強力な使い手でもある。裸足が大好き。\n\n彼女の衣装が入ったフォルダを送るから、好きなように描いてくれ。選択はお任せします！\n\nReiha 参考：https://drive.google.com/drive/folders/18uNcXeDUgqrQAwfvUAZdKSUT9T4LKz9d\n\nおまかせ！\n\nありがとうございました！", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@inishienotanaka/works/20", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3024770, "client_id": 0, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/d9763217/uploads/orig