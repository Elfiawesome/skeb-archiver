mat%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=22c11adb23ce7a2ee8740707f58b4bd8 3x"}, "body": "こんにちは！\n\nあなたの絵は本当に素晴らしいです！FFXIVのキャラクター、アンブラ・ヴァトーレの絵を描いてほしいんです。キュートで、ハッピーで、でもチャラチャラしたポーズが見たいのですが、ポーズの詳細はお任せします。でも、太ももは見てみたいですね。彼はとてもかわいいはずです。  ドレスを着ているのは知っているけど、アンブラは男だからね。あなたのカッシア・ジャズの写真は私のボーイフレンドのものなので、お揃いにしてほしいのです。混乱させてごめんなさい。一緒に仕事ができることを本当に願っています！\n\nhttps://drive.google.com/drive/folders/19tLswa8jEsN4yJ4eu_cbmijFK5Px50zn?usp=drive_link", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Tazaki_Nabe/works/13", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2506597, "client_id": 236382, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/496e2fe4/uploads/origins/3e0ed566-f76c-4d39-8d05-0b59e57b5399?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=cce5f179f04624aeeb3e4d9cb84d56a9", "srcset": "https://si.imgix.net/496e2fe4/uploads/origins/3e0ed566-f76c-4d39-8d05-0b59e57b5399?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=cce5f179f04624aeeb3e4d9cb84d56a9, https://si.imgix.net/496e2fe4/uploads/origins/3e0ed566-f76c-4d39-8d05-0b59e57b5399?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=fdfbd6f252290912c8acd6dd0cfe6cc3 2x, https://si.imgix.net/496e2fe4/uploads/origins/3e0ed566-f76c-4d39-8d05-0b59e57b5399?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b689fff20a2105853af61bc1ad8e0ebd 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/496e2fe4/uploads/origins/3e0ed566-f76c-4d39-8d05-0b59e57b5399?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=60c3889e52c148c5277923cf122fe8b7", "srcset": "https://si.imgix.net/496e2fe4/uploads/origins/3e0ed566-f76c-4d39-8d05-0b59e57b5399?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop