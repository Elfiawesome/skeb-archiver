4e-8173-557a8de03d97?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=676afd9799e8eca3e0a1053df56d5e22 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/26d1fb2c/uploads/origins/d9a1470d-87d1-404e-8173-557a8de03d97?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=92ac72bf4ef9e6761eeeae57c76876eb", "srcset": "https://si.imgix.net/26d1fb2c/uploads/origins/d9a1470d-87d1-404e-8173-557a8de03d97?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=92ac72bf4ef9e6761eeeae57c76876eb, https://si.imgix.net/26d1fb2c/uploads/origins/d9a1470d-87d1-404e-8173-557a8de03d97?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=ad68c29684ab0a1215991e2c7a157870 2x, https://si.imgix.net/26d1fb2c/uploads/origins/d9a1470d-87d1-404e-8173-557a8de03d97?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=bed2d78fa4eb2a9320f1416520b73741 3x"}, "body": "賑やか銀河🫨Nýx様、初めまして！\n\n賑やか銀河🫨Nýx様のイラストを見て是非ご依頼したい！と思いリクエストを送らせて頂きました。\n\n私のTRPG自陣(うちよそ)のSDイラストを描いて頂きたいです！\n\nポーズや表情等についてはお任せしたいです！\n\n下記に詳細をまとめておきます。\n\n\n【キャラクターについて】\n\n藤極原 鈴 (ふじきわはら りん)\n31歳　152cm　男性　職:極道\n\n馬鹿力の脳筋男。部下の失敗の責任を負って指を詰めたため左手の小指がない。相方のことを「落語家」呼ばわりしている。好きなものは自分より背の低いもの、嫌いなものは組長以外の自分より背の高いもの全て。\n\n・顔に傷\n・ピアス有\n・首元に指輪のネックレス\n\n\n\n月霧 語春 (つきぎり ことは)\n31歳　165cm　男性　職:落語家\n\n頭の回る猫被り男。貼り付けたようなニコニコ笑顔を向けながら色んな人に媚びを売っている。相方のことを「犬」呼ばわりしている。散々男遊びしまくってるカスで、自身の欲望に忠実、危険な人間や場所にも興味が湧けば躊躇なく足を踏み入れる命知らずの変態。\n\n・髪飾り(ゴム)で髪をゆるくまとめている\n・耳飾り有\n・左目の下にホクロ\n\n\n\n日頃から言い合いが絶えない犬猿の二人。でもなんだかんだ仲が良いのか悪いのか分からない。\n\n落語家が極道に我儘を言って、渋々渋々極道がそれを最終的に聞いてやる羽目になっている。落語家がすぐ危険な場所に凸るので極道が守ってやる羽目になっている。なんだかんだお互いのことが大好き。\n\nクトゥルフ神話TRPGシナリオ「ロトカ・ヴォルテラの愛堕討ち」出身の二人。\n\n\n\n外見などは資料URLを参照ください。無理そうでしたら全然キャンセルして頂いて大丈夫です。\n\n使用用途については、SNSのアイコン/ヘッダーや個人鑑賞、相方との共有、壁紙や利益の発生しない個人用アクキー等に使用させて頂きたいです！\n\n宜しければ是非、検討お願い致します！！🙏✨\n\nhttps://drive.google.com/drive/folders/1dEEfeLEom07ty05hRgeB7H5gKfhclT3S?usp=share_link", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@nyukusu11/works/11", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 21431, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/1161e6c6/uploads/origins/439d56c2-0b58-4f27-9e70-ba9529866aec?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4b2f51e79c4a6b8324d20f94453167ae", "srcset": "https://si.imgix.net/1161e6c6/uploads/origins/439d56c2-0b58-4f27-9e70-ba9529866aec?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4b2f51e79c4a6b8324d20f94453167ae, https://si.imgix.net/1161e6c6/uploads/origins/439d56c2-0b58-4f27-9e70-ba9529866aec?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=7ed233038a19c3bcc111e3821901849a 2x, https://si.imgix.net/1161e6c6/uploads/origins/439d56c2-0b58-4f27-9e70-ba9529866aec?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c1a9b749044fb86bcc5d9e1480ad6174 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/1161e6c6/uploads/origins/439d56c2-0b58-4f27-9e70-ba9529866aec?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=024dfac59d6eaec82a11c923edaa357a", "srcset": "https://si.imgix.net/1161e6c6/uploads/origins/439d56c2-0b58-4f27-9e70-ba9529866aec?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=024dfac59d6eaec82a11c923edaa357a, https://si.imgix.net/1161e6c6/uploads/origins/439d56c2-0b58-4f27-9e70-ba9529866aec?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=5627eeeac38b89f68d4645a2e0eb36e5 2x, https://si.imgix.net/1161e6c6/uploads/origins/439d56c2-0b58-4f27-9e70-ba9529866aec?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=20