da/uploads/origins/7d8ce53d-7fb5-4ca5-83eb-c36448c7b9af?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=22b09778001862f8efa15cd6359066c2", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/9c81c0da/uploads/origins/7d8ce53d-7fb5-4ca5-83eb-c36448c7b9af?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6f28b587919441d2e0ad24732d0f9329", "src_set": ""}, "body": "はじめましてAtsuと申します。 普段からアークナイツ漫画などの作品を拝見しており、可愛らしい絵柄が大変気に入りましたので依頼させていただきます。\n\n要望\n私が応援しております、Vtuberのあくまメリルさんを描いていただきたいです。ポーズや構図はおまかせ致しますが、「落ち着いたお姉さん」のイメージを反映していただけると嬉しいです。また、メリルさんの推しオペレーターである、メテオリーテを一緒に描いていただけますでしょうか。\nこちらもポーズ、構図はおまかせ致します。\n\n参考資料\nあくまメリルさん　三面図\nhttps://twitter.com/bookVtuber/status/1613068007378685953?s=20&t=O4RMmSoZXMHFVzycocUjjg\n\n以上よろしくお願いいたします。", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Tsugu_0928/works/12", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1610008, "client_id": 1496641, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/c2d2b893/uploads/origins/04adb23c-78e5-452c-ba64-dbebfcffcb7c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7eef474ccfaa146ba5a40d3245ace5a5", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/c2d2b893/uploads/origins/04adb23c-78e5-452c-ba64-dbebfcffcb7c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=085499bdca4cc1f4cac7b566ba5006aa", "src_set": ""}, "body": "はやみ くらげ🥐様\n\nV声優プロダクションぼいそーれという事務所に所属している日向こがね(@himukai_kogane_)と申します。\nはやみ様の描かれる元気いっぱいで動きのある女の子たちのイラストが大好きで、前々から依頼したいと思っておりました…！\n\n今回お願いしたいのは、下記の内容です。\n\n【リクエスト内容】\n・Vtuber日向こがねのイラスト（三面図やキャラクター資料は文末にございます！）\n・朝の寝起き、あくびしてる眠そうな日向こがねをお願い致します…！\n・洋服などはだぼだぼのオーバーサイズパーカーか、彼シャツのようなものでお願いいたします！\n・ポーズや構図等