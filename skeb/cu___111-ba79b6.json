f2-488f-bafb-9cd9ed642401?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=db5a0e69281493e75123567a5fff0931 2x, https://si.imgix.net/f90b3480/uploads/origins/8fbbe762-2cf2-488f-bafb-9cd9ed642401?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=e4c094f81bea667cfb9d9e1182f74cee 3x"}, "body": "こんにちは！あなたのイラスト、本当に素敵ですね！ぜひ私のオリジナルキャラクターを描いていただけないでしょうか！\n\nレダ（女性）：明るく遊び心のある性格。表情豊かで生き生きとした様子で、彼女によく似合ういたずらっぽい笑顔が特徴です。\n\nノックス（男性）：穏やかで無表情な外見。感情を表に出さず、どこかよそよそしい雰囲気ですが、全体的にきちんとしていて真面目な態度です。\n\nレダとノックスは、遊び心のある対照的な関係にあります。レダは明るく、からかい好きで、人前で愛情表現をするタイプで、ノックスの反応を引き出すためだけに彼にしがみつくこともよくあります。彼女はトラブルを起こしたり、喧嘩を売ったり、厄介な状況に巻き込まれたりする癖があり、そのたびにノックスが介入して彼女を救い出すことになります。彼はイライラしたふりをしていますが、明らかに彼女に弱いところがあります。\n\nお時間をいただき、ご検討いただきありがとうございます！\n\nhttps://drive.google.com/drive/folders/1yjeyvg4-4PyTUTMjSF5yP0oEp3GCUtUU?usp=sharing", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@cu___111/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3881939, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/a2f922d7/uploads/origins/c27158be-5daf-494e-a628-44c57efca4df?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=90a270ded07716afe2400d7accdf693f", "srcset": "https://si.imgix.net/a2f922d7/uploads/origins/c27158be-5daf-494e-a628-44c57efca4df?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=90a270ded07716afe2400d7accdf693f, https://si.imgix.net/a2f922d7/uploads/origins/c27158be-5daf-494e-a628-44c57efca4df?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=991ed02e7aedfede2f5f3afa26406835 2x, https://si.imgix.net/a2f922d7/uploads/origins/c27158be-5daf-494e-a628-44c57efca4df?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=55807bfa0652dfac1615e2d5935a31d1 3x"}, "duration": null, "nsfw": false, "hardcore"