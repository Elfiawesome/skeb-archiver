うれしいです。\n\nSNSの宣伝や配信のサムネイル等に使わせていただきます。\nそのため、特に頭や肩などが切れない構図だと大変ありがたいです…！\nまたFANBOXや案件などでも利用予定です。よろしくお願いいたします。\n\n簡易的な背景があればうれしいですが、そこはお任せいたします。\n\nPNGデータで人物と背景別で納品いただけますと幸いです。\nPSDデータでもかまいません。\n\nどうぞよろしくお願いします。\n\nhttps://drive.google.com/drive/folders/1-9oFwBC6UeKyMTXxRmirtrwfC_Tevbue\n\nhttps://drive.google.com/drive/folders/1-9oFwBC6UeKyMTXxRmirtrwfC_Tevbue", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@kombumaru4/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2975386, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/3a0f25f5/uploads/origins/609734bb-6e3a-45dd-ad68-cb38ee6d2e5c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5de772124154a6f8e169bbdbd8644293", "srcset": "https://si.imgix.net/3a0f25f5/uploads/origins/609734bb-6e3a-45dd-ad68-cb38ee6d2e5c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5de772124154a6f8e169bbdbd8644293, https://si.imgix.net/3a0f25f5/uploads/origins/609734bb-6e3a-45dd-ad68-cb38ee6d2e5c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e1b1c1455ab97f6ac6dda8e36adbb264 2x, https://si.imgix.net/3a0f25f5/uploads/origins/609734bb-6e3a-45dd-ad68-cb38ee6d2e5c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c10017bb652731f47d111321038c6cd6 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/3a0f25f5/uploads/origins/609734bb-6e3a-45dd-ad68-cb38ee6d2e5c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c4a83428c941b50a6b8b5f49f2962e4e", "srcset": "https://si.imgix.net/3a0f25f5/uploads/origins/609734bb-6e3a-45dd-ad68-cb38ee6d2e5c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c4a83428c941b50a6b8b5f49f2962e4e, https://si.imgix.net/3a0f25f5/uploads/origins/609734bb