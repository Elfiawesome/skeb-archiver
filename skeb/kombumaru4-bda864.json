イラストなので、是非リクエストさせて頂きたくご連絡しました。背景のイラストがとても素敵で一目惚れしてしまいました。\n\n ※使用用途\n ・YouTubeのサムネ（今後収益化も目指しています） \n ・その他SNSでの使用\n☆背景ありのイラストは配信のエンディングやオープニングにも使わせていただけたらなと思っています\n \n※概要 \n・表情、ポーズ等はお任せします。 \n・傘や雨モチーフにした物があると嬉しいです\n・頭や左右の見切れてない\n・背景透過済み、背景とキャラクターを分けたものがあると助かります。\n・背景は雨宿り等をイメージした感じだと嬉しいです\n・参考資料→https://x.com/pichon_kaname/status/1834921399624122848?t=uH-CAkTJlEXRlB-hN88Nlg&s=19\n\nhttps://x.com/pichon_kaname/status/1834921399624122848?t=uH-CAkTJlEXRlB-hN88Nlg&s=19", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@kombumaru4/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2975386, "client_id": 1515739, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/460aee2b/uploads/origins/ab759bdc-5999-4507-9c2d-f72264510126?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1bca4fe593274b0d257c787698820cd8", "srcset": "https://si.imgix.net/460aee2b/uploads/origins/ab759bdc-5999-4507-9c2d-f72264510126?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1bca4fe593274b0d257c787698820cd8, https://si.imgix.net/460aee2b/uploads/origins/ab759bdc-5999-4507-9c2d-f72264510126?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a9b9009ae9871cd8929b461d5eeac347 2x, https://si.imgix.net/460aee2b/uploads/origins/ab759bdc-5999-4507-9c2d-f72264510126?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f303bfe7fa91fa218f42ab9e88d47b3e 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/460aee2b/uploads/origins/ab759bdc-5999-4507-9c2d-f72264510126?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ee30bca45a74c4136d50bc433c8ce4a4", "srcset": "https://si.imgix.net/460aee2b/uploads/origins/ab759bdc-5999-4507-9c2d-f72264510126?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ee30bca45a74c4136d50bc433c8ce4a4, https://si.imgix.net/460aee2b/uploads/origins/ab759bdc-5999-4507-9c2d-f72264510126?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=bb904e50546d46919447ed3e9833c53e 2x, https://si.imgix.net/460aee2b/uploads/origins/ab759bdc-5999-4507-9c2d-f72264510126?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=27b58b3d67da354c8b036ced29c7efa3 3x"}, "body": "Could you please draw my two ninja boy characters, Mist and Raven? The references are attached below.\nhttps://drive.google.com/drive/folders/1QBrm3u6P2jLlAwK3lKpkJ57MRLH-T4zf?usp=share_link\nThe orange one, Mist (17 y/o), has a relatively calm and less-talk personality, while the blue one, Raven (16 y/o), is outgoing and somewhat naughty. They are battle partners from a very young age.\nYou can draw any poses and interactions between them as you like! Everything is entirely up to you. You can draw their battle stances, or just draw them rest and cuddle together somewhere comfortable. I would like to see the boys in your art style.\nTake your time and enjoy yourself, and thanks a lot for your consideration!\n\nhttps://drive.google.com/drive/folders/1QBrm3u6P2jLlAwK3lKpkJ57MRLH-T4zf?usp=share_link", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@kombumaru4/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2975386, "client_id": 2704765, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/5852ce72/uploads/origins/4c3fc26e-0fb7-4051-9525-67745f3bc4af?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=40458cacd4181f4958ce889bc6703a82", "srcset": "https://si.imgix.net/5852ce72/uploads/origins/4c3fc26e-0fb7-4051-9525-67745f3bc4af?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=40458cacd4181f4958ce889bc