d037-d3ed-40d6-b719-2b5ee87f9abc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=67d632a71d90b8724384234076a0e689, https://si.imgix.net/b74b0919/uploads/origins/2c10d037-d3ed-40d6-b719-2b5ee87f9abc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=2ac792f5a34ad5132839e0d950ccdd79 2x, https://si.imgix.net/b74b0919/uploads/origins/2c10d037-d3ed-40d6-b719-2b5ee87f9abc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=1697c58a3af4995c4031eeb765df2f62 3x"}, "body": "こんにちは。私のオリジナルキャラクター「友香」を描いていただけませんか？\n\n友香は生物学を専攻する大学生です。大学のアニメ部の部長であり、水泳部の部員でもあります。 彼女の目標は、全国水泳大会への出場権を獲得することです。練習や勉強をしていない時は、友香は自由時間の多くをアニメ鑑賞や漫画を読むことに費やしています。\n\n友香はとても人懐っこく、エネルギッシュな性格です。見知らぬ人であっても躊躇なくアニメサークルに誘い、お気に入りのアニメについてはとても熱く語ります。 友香は猫、ラーメン、イチゴ、ファンタジー小説、そしてかわいいものが大好きです。フルーティーでフローラルな香りが好きなので、いつも香水を身につけています。\n\n多くのイラストにおいて、友香の髪の描き方が統一されていません。そのため、彼女の髪を描く際は「F」の参考画像のみを使用してください。\n\nご協力ありがとうございます。\n\nhttps://drive.google.com/drive/folders/176_RPnitg6-YPYvrIktXY2qYeliUsRC1?usp=drive_link", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@fruit_casr/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 4142420, "client_id": 4117385, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/62ca3b22/uploads/origins/ee90b8f0-70c6-4a94-a9c7-414eb175c21a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a64e865282c9c54a7ba9d2b4a617e835", "srcset": "https://si.imgix.net/62ca3b22/uploads/origins/ee90b8f0-70c6-4a94-a9c7-414eb175c21a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a64e865282c9c54a7ba9d2b4a617e835, https://si.imgix.net/62ca3b22/uploads/origins/ee90b8f0-70c6-4a94-a9c7-414eb175c21a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f26f441163f65b2f008e9181399ec6a0 2x, https://si.imgix.net/62ca3b22