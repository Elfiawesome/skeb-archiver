ゃわちゃ感がありつつも仲の良い関係性です\n・こちら5人組のそれぞれの立ち絵です。少しでも参考になればと思います。\n\n■ロゴの雰囲気（ざっくり） \n・少し自虐的でネタ感のある名前ですが、ダサすぎずかっこよさもあるデザインだと嬉しいです  \n・配信者グループらしい勢い・インパクトがほしいです  \n・サムネで小さく表示しても視認性が高いものだと助かります\n\n■希望納品形式  \n・背景透過PNG  \n・可能であれば高解像度データ\n\n■その他  \n・色味や方向性は、メンバー立ち絵や終わってる奴等という名前を参考に寄せていただけると嬉しいです  \n・もぶざうるす様のセンスをぜひ活かしていただけたらと思います  \n\nご検討いただけましたら幸いです。\n何卒よろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/1zLFKWuhiyUXJtL--gM01LsFOSGSo8EqD", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@siroaraiguma/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1831924, "client_id": 2945221, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/fa64dbfa/uploads/origins/23e21f73-2286-4b14-8b50-49f31b161581?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ff105c82b786caecdb30020f548ef148", "srcset": "https://si.imgix.net/fa64dbfa/uploads/origins/23e21f73-2286-4b14-8b50-49f31b161581?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ff105c82b786caecdb30020f548ef148, https://si.imgix.net/fa64dbfa/uploads/origins/23e21f73-2286-4b14-8b50-49f31b161581?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=032897b7a609f8fb7c6afc39f5d4c7ab 2x, https://si.imgix.net/fa64dbfa/uploads/origins/23e21f73-2286-4b14-8b50-49f31b161581?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b47ca960375ee72a7ca2475836c07ca1 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/fa64dbfa/uploads/origins/23e21f73-2286-4b14-8b50-49f31b161581?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=413368f92bcb03b68c095d89bcfc9566", "srcset": "https://si.imgix.net/fa64dbfa/uploads/origins/23e21f73-2286-4b14-8b50-49f31b161581?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=2