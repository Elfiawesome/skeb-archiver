度高めの水色を覆い焼き発光とかでやるとイメージに近いかもしれません）\n\n\n表情をよく見せたいので顔面アップ、もしくはバストアップでお願いします🙏\n\n上記に記載が当てはまっていれば他はご自由にお描きして頂いて構いません！\n例：手を口元に持ってくる、髪をなびかせる、時間帯を夕方にしたいからオレンジめのレイヤーで加工する……など\n\nご縁がありましたら嬉しいです‼️よろしくお願いします🙏\n\nhttps://drive.google.com/drive/folders/1-Aa_kQ9LQwwAkdnTApsaY6Jg03SAk5OI", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@K__yuQ/works/2", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/b24e78f1/uploads/origins/8aa773cd-f64f-4f68-8957-b4a1776dfcbf?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=9feda3b8ecbd35674a35e21f16944b0a", "srcset": "https://si.imgix.net/b24e78f1/uploads/origins/8aa773cd-f64f-4f68-8957-b4a1776dfcbf?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=9feda3b8ecbd35674a35e21f16944b0a, https://si.imgix.net/b24e78f1/uploads/origins/8aa773cd-f64f-4f68-8957-b4a1776dfcbf?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=e065ac362973c9db4bcd31b31263f8da 2x, https://si.imgix.net/b24e78f1/uploads/origins/8aa773cd-f64f-4f68-8957-b4a1776dfcbf?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=6dcec7c4ed7ece256f810678fbd28129 3x"}, "private": true, "genre": "art", "tipped": true, "creator_id": 3173768, "nc": 17}, {"path": "/@K__yuQ/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3173768, "client_id": 1331406, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/0784a44a/uploads/origins/7a4a3dd0-900c-4f5b-834c-463637f0c2de?bg=%23fff&auto=fo