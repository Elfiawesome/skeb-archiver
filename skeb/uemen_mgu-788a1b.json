200&blur=200&s=6151ce811def6e235ab9294ed6f68cdd, https://si.imgix.net/80ad1c2c/uploads/origins/36a96312-09dd-4c92-804d-11076b058268?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=ce6411323dbb13095021b7e3b6c6f05d 2x, https://si.imgix.net/80ad1c2c/uploads/origins/36a96312-09dd-4c92-804d-11076b058268?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=8e76d080714843ba90a9ea3028e965f0 3x"}, "body": "はじめまして、こちら\nhttps://x.com/uemen_mgu/status/1999450651580071998?s=46\nの金ビキニナズーリン を拝見しリクエストのお願いに参りました。\n\n・キャラは東方のナズーリン\n・表情は八の字眉で弱々しく恥ずかしがっている\n・子供体型\n・構図は膝から上\n・服装は金ビキニと同素材同色の越中褌のみ(トップレス)\n\n※他の方の作品で申し訳ありませんが越中褌の資料です\nhttps://www.pixiv.net/artworks/92065910\n\n・越中褌の紐の結び目はおへその位置で締めている\n\n・前垂れの左端は左手の、右端は右手の親指と人差し指で摘んで上に引っ張り上げている\n\n・ポーズは上記のまま前垂れが垂れている差分をお願い致します。\n(一般的な越中褌の前垂れの半分位の長さになり股布が見えてしまっている状態)\n\n注文が多く申し訳ありませんがご検討の程宜しくお願い致します。", "nc": 184, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@uemen_mgu/works/9", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2620137, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/8afd2579/uploads/origins/8ee31317-7cab-4b8f-9976-972bcc3503dd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2903115a6eafa4d8e75713b129a6ad7f", "srcset": "https://si.imgix.net/8afd2579/uploads/origins/8ee31317-7cab-4b8f-9976-972bcc3503dd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2903115a6eafa4d8e75713b129a6ad7f, https://si.imgix.net/8afd2579/uploads/origins/8ee31317-7cab-4b8f-9976-972bcc3503dd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=1451188cb6a6af6e95670eaafcee8989 2x, https://si.imgix.net/8afd2579/uploads/origins/8ee31317-7cab-4b8f-9976-972bcc3503dd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e841a37d72d727b47284c1aa3d8c48f3 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/8afd2579/uploads/origins/8ee31317-7cab-4b8f-9976-972bcc3503dd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b6ca27aef3f37322bfe94f11e2398413", "srcset": "https://si.imgix.net/8afd2579/uploads/origins/8ee31317-7cab-4b8f-9976-972bcc3503dd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b6ca27aef3f37322bfe94f11e2398413, https://si.imgix.net/8afd2579/uploads/origins/8ee31317-7cab-4b8f-9976-972bcc3503dd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=cf5a6f9b3417aae034b6d7a2af19e691 2x, https://si.imgix.net/8afd2579/uploads/origins/8ee31317-7cab-4b8f-9976-972bcc3503dd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=4aed9665c12c446e882fb0b7e29e3b76 3x"}, "body": "こんにちは！\nいつも東方キャラのたくしあげを依頼している者です!\n今回は菅牧典ちゃんの依頼をお願いしたいです!\n\n●キャラクター\n東方Projectの菅牧典\n\nhttps://dic.pixiv.net/a/%E8%8F%85%E7%89%A7%E5%85%B8\n\n●ポーズ\n足を閉じた状態での直立\n\n※料金上可能であればたくしあげのポーズを追加希望\n\n●服装\n 元の服装のようなデザインのチャイナドレス\n横の切れ込み(スリット)が深すぎて横からぱんつが丸見え状態\n※参考\nhttps://skeb.jp/@enigma_numX/works/5\n\n●体格\n身長が低いプニロリ\n胸は控えめ\n\n●下着\n布面積が広くスジが浮き出ないお子様パンツ\n・赤いリボンが付いた白い無地\n\n●表情\n明るい笑顔\nジト目でのドヤ顔\nメ◯ガキのようなニヤニヤ顔\nジト目でむっとした顔\nニッと笑う顔\n\n以上です!\n似たような依頼ばかりで申し訳ないですが、どうかよろしくお願いいたします!!", "nc": 177, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@uemen_mgu/works/8", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2620137, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/40244147/uploads/origins/bc722ba6-c1a7-4823-a4ee-9819142e3ed8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1a06b4ea494e6aa5bc8314fb0cffdc7f", "srcset": "https://si.imgix.net/40244147/uploads/origins/bc722ba6-c1a7-4823-a4ee-9819142e3ed8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1a06b4ea494e6aa5bc8314fb0cffdc7f, https://si.imgix.net/40244147/uploads/origins/bc722ba6-c1a7-4823-a4ee-9819142e3ed8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=46b944f96df318ec258d8ff1db23a876 2x, https://si.imgix.net/40244147/uploads/origins/bc722ba6-c1a7-4823-a4ee-9819142e3ed8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=bfef6975ba9f8fcb06e20883cbc96f20 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/40244147/uploads/origins/bc722ba6-c1a7-4823-a4ee-9819142e3ed8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=75626520b48187704185f516b9d8a995", "srcset": "https://si.imgix.net/40244147/uploads/origins/bc722ba6-c1a7-4823-a4ee-9819142e3ed8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=75626520b48187704185f516b9d8a995, https://si.imgix.net/40244147/uploads/origins/bc722ba6-c1a7-4823-a4ee-9819142e3ed8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=9dabc818f75f60c03af090bf0a38990c 2x, https://si.imgix.net/40244147/uploads/origins/bc722ba6-c1a7-4823-a4ee-9819142e3ed8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=46e0db626d7464867faf0b84addc359f 3x"}, "body": "こんにちは！\n前回、橙ちゃんのたくしあげを依頼した者です!\nこちらもとても良い作品でしたのでまたリクエストをお願いしたいです!\n今回は東方の饕餮ちゃんを希望します\n\n●キャラクター\n東方Projectの饕餮尤魔\n\nhttps://dic.pixiv.net/a/%E9%A5%95%E9%A4%AE%E5%B0%A4%E9%AD%94\n\n●ポーズ\n今まで同様、足を閉じた状態での直立\n両手でスカートをたくしあげている\n\n●服装\nスカートであれば描きやすいものでおまかせ\n\n●下着\n布面積が広く、スジが浮き出ないお子様パンツ\n・真っ白な無地で中央にクマさんマーク\n・子どもっぽいお子様パンツ\n\n●表情\n明るい笑顔\nジト目でのドヤ顔\nニッと歯を見せてニヤニヤした顔\nジト目で不機嫌そうな顔\nキョトン顔\n\n以上です!\n似たような内容で申し訳ないですが、またよろしくお願いします!", "nc": 49, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@uemen_mgu/works/7", "private_thumbnail_image_urls": null, "private": false, "gen