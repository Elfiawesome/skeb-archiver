ipped": false, "creator_id": 3845765, "client_id": 3787177, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/a03c557e/uploads/origins/ed279a5a-9b78-48bc-825b-7c3ca4774bf7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=18ee643ab6787fda9adf83398c49fe25", "srcset": "https://si.imgix.net/a03c557e/uploads/origins/ed279a5a-9b78-48bc-825b-7c3ca4774bf7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=18ee643ab6787fda9adf83398c49fe25, https://si.imgix.net/a03c557e/uploads/origins/ed279a5a-9b78-48bc-825b-7c3ca4774bf7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a9e220e616cc8dc27e9de0383bdade88 2x, https://si.imgix.net/a03c557e/uploads/origins/ed279a5a-9b78-48bc-825b-7c3ca4774bf7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ef6beb47f1468b4289071a4411b862f8 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/a03c557e/uploads/origins/ed279a5a-9b78-48bc-825b-7c3ca4774bf7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=db01fe3bb8776bb953e11376d49a2ba2", "srcset": "https://si.imgix.net/a03c557e/uploads/origins/ed279a5a-9b78-48bc-825b-7c3ca4774bf7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=db01fe3bb8776bb953e11376d49a2ba2, https://si.imgix.net/a03c557e/uploads/origins/ed279a5a-9b78-48bc-825b-7c3ca4774bf7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=3daf934c8d8012a79e560b0dc47f29be 2x, https://si.imgix.net/a03c557e/uploads/origins/ed279a5a-9b78-48bc-825b-7c3ca4774bf7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=aa8b41783a98dcbfdb8012f8b8fd95eb 3x"}, "body": "こんにちは！\nはじめまして！\n\n「HempieVT」というVTuberのイラストをお願いしたいです。\n彼女は普段から眠そうで、少しぼんやりとした雰囲気をしており、目の下にクマがあります。\nまた、髪に赤いストライプがあり、瞳の中にはX（エックス）型の模様があります。\n添付の参考画像のどの衣装を使っていただいても大丈夫です。\n\nポーズや構図、雰囲気などはすべておまかせします。\n自由に、あなたの思うままに描いていただけると嬉しいです。\n\nHempieは、上官の命令に逆らったためにチェルノブイリの立入禁止区域に追放されたスリーパーエージェントです。\n放射線の影響で彼女自身も放射性を帯びており、孤独の中で廃墟の建築や放棄された軍用車両、武器（SVD、DP-27など）を研究しながら静かに暮らしています。\nまた、酒に酔うのが好きで、時々飲みすぎてしまうこともありますが、それでも楽しんでおり、よく飲んでは物思いにふけり、時々タバコを吸うこともあります。\n\n彼女のそばには、放射能の影響で変異したマスコットの「Pyp（ピップ）」がいます。\nPypは小さな粘性のある生物で、手足がなく、頭上に光る輪（ハロー）が浮かんでおり、いつもHempieの頭の上や近くにいます。\n\nこのキャラクターは、『serial experiments lain（シリアルエクスペリメンツ・レイン）』や『少女終末旅行』のような作品に影響を受けています。\n静けさ、不安定さ、そして虚無感を感じるトーンで表現していただけると嬉しいです。\n\nどうぞよろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/1HKpUvqulI6HbCdDdFmdSel-kAK-mqZ6k?usp=drive_link", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 2563927, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "dia②", "screen_name": "68ta_2", "avatar_url": "https://proxy.misskeyusercontent.jp/avatar/media.misskeyusercontent.jp%2Fio%2F5b91bae7-d0a5-4330-8a2e-3ff84a210bc9.png%3Fsensitive%3Dtrue?avatar=1", "header_url": "https://media.misskeyusercontent.jp/io/90bccb71-24d4-48fb-a5bb-63e6e1dfa5aa.png?sensitive=true", "appeal_receivable": true, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 7, "complete_expiration_days": 120, "skills": [{"genre": "art"}, {"genre": "correction"}], "banned": false, "nc": 129}, {"id": 2882014, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "こめくる　おむ💛🍽", "screen_name": "omuomu_0620", "avatar_url": "https://pbs.twimg.com/profile_images/2003813841294196736/4NrAgmpP.jpg", "header_url": "https://pbs.twimg.com/profile_banners/4911214502/1766581434/1500x500", "appeal_receivable": true, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre