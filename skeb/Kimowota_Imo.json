r the piece, and when she isn't wearing it she has a cute ahoge. Thank you so much for considering my request!\n\nOC: https://drive.google.com/drive/folders/1YoH5U2kxpd7JflrYunwTFpcZ6cjD9-_8?usp=sharing\nOutfit: https://pridemode.com/cdn/shop/products/f5fe030055c0a56a3203657ce17f5040.jpg?v=1652695175", "nc": 48, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@Kimowota_Imo/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3306335, "client_id": 951419, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/3af6236f/uploads/origins/bd4f6e2f-686b-41bd-b9be-8f0b82f8ee4f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ccd8d1b8baca915508df7c03159e82b4", "srcset": "https://si.imgix.net/3af6236f/uploads/origins/bd4f6e2f-686b-41bd-b9be-8f0b82f8ee4f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ccd8d1b8baca915508df7c03159e82b4, https://si.imgix.net/3af6236f/uploads/origins/bd4f6e2f-686b-41bd-b9be-8f0b82f8ee4f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=36e50ce573b34bfdd9f5dc4fe02e7baf 2x, https://si.imgix.net/3af6236f/uploads/origins/bd4f6e2f-686b-41bd-b9be-8f0b82f8ee4f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e618430d948e2157dc694fc73237a56a 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/3af6236f/uploads/origins/bd4f6e2f-686b-41bd-b9be-8f0b82f8ee4f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2c5e95772633e27f6ac2284819da934d", "srcset": "https://si.imgix.net/3af6236f/uploads/origins/bd4f6e2f-686b-41bd-b9be-8f0b82f8ee4f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2c5e95772633e27f6ac2284819da934d, https://si.imgix.net/3af6236f/uploads/origins/bd4f6e2f-686b-41bd-b9be-8f0b82f8ee4f?bg=%23fff