d1c95ed6ff0c4fbe2e526050349a4", "srcset": "https://si.imgix.net/477a9443/uploads/origins/f556bf14-5116-4642-8490-a279b4ecb469?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=256d1c95ed6ff0c4fbe2e526050349a4, https://si.imgix.net/477a9443/uploads/origins/f556bf14-5116-4642-8490-a279b4ecb469?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=8f2a6f6622ea3b55978d114c0958bf9f 2x, https://si.imgix.net/477a9443/uploads/origins/f556bf14-5116-4642-8490-a279b4ecb469?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d6358176f93a4263907c01146ee1b5a0 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/477a9443/uploads/origins/f556bf14-5116-4642-8490-a279b4ecb469?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=885fb2914aee58df7f6fb638e7ae959d", "srcset": "https://si.imgix.net/477a9443/uploads/origins/f556bf14-5116-4642-8490-a279b4ecb469?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=885fb2914aee58df7f6fb638e7ae959d, https://si.imgix.net/477a9443/uploads/origins/f556bf14-5116-4642-8490-a279b4ecb469?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=44a7ccac5d73afc9b7a9de32043f28ea 2x, https://si.imgix.net/477a9443/uploads/origins/f556bf14-5116-4642-8490-a279b4ecb469?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=cec3c761853ec941ccf162df4aa9af4b 3x"}, "body": "こんにちは。私のオリジナルキャラクター、マルクスが登場する、もう一つの「タイムストップ」シナリオを見てみたいです。マルクスは、最近「タイムストップ」集団によって引き起こされた事件を捜査している警官です。彼は街中で、知らず知らずのうちにパトカーのそばで自らも被害者となってしまいます。マルクスは両手を頭の後ろで手錠で繋がれ、制服のボタンは外されています。 ある男が下から彼の尻を犯し、精液が溢れ出る中、他の数人の男たちが彼を取り囲み、その威圧的な真剣な顔と、筋肉質で毛深い体を精液でまみれにしていきます。マルクスの口の中に大量の精液が溜まり、溢れ出る様子を見てみたいです。構図はあなたにお任せします。\n\nhttps://drive.google.com/file/d/1ap4M1cUuPXf-HF5ENvt9qCCKOWCagtai/view?usp=sharing", "nc": 40, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@UshioTakigawa/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1929406, "client_id": 68157, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/4019eafe/uploads/origins/af2fff48-77a9-45a8-9eb9-73225898af65?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e57cc735b27fa9eee1866f191a7dba31", "srcset": "https://si.imgix.net/4019eafe/uploads/origins/af2fff48-77a9-45a8-9eb9-73225898af65?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e57cc735b27fa9eee1866f191a7dba31, https://si.imgix.net/4019eafe/uploads/origins/af2fff48-77a9-45a8-9eb9-73225898af65?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=6dd2b08a9094549d94c6c2b4060d488b 2x, https://si.imgix.net/4019eafe/uploads/origins/af2fff48-77a9-45a8-9eb9-73225898af65?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=6b9238cec9d16153847c80e5046681cf 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/4019eafe/uploads/origins/af2fff48-77a9-45a8-9eb9-73225898af65?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e114fdf46b998b4915559b227e717817", "srcset": "https://si.imgix.net/4019eafe/uploads/origins/af2fff48-77a9-45a8-9eb9-73225898af65?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e114fdf46b998b4915559b227e717817, https://si.imgix.net/4019eafe/uploads/origins/af2fff48-77a9-45a8-9eb9-73225898af65?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=4e4336d6a66132325dbdeaefe4350ba6 2x, https://si.imgix.net/4019eafe/uploads/origins/af2fff48-77a9-45a8-9eb9-73225898af65?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=7e0d816e293de5ffbcf2a573b617796a 3x"}, "body": "こんにちは。また別の「時間が止まった」シチュエーションを見てみたいです。私のオリジナルキャラクター、ルカがジョギングの最中という設定で。ルカはぴったりとしたタンクトップ、ショートパンツ、スニーカーを履いています。汗をかいていて、集中した表情で、息を吸う途中で口を開けています。 ある集団が時間を止め、ルカの服を部分的に脱がせて彼を犯しました。絶頂後のシーンを見たいのですが、精液で満たされたルカの開いた口と、顔や髭に垂れた余分な精液に焦点を当ててほしいです。構図はご自由に。\n\nhttps://drive.google.com/file/d/18GthLFCVcX2bxlUk11uCn4CJXNz1fEnp/view?usp=drivesdk", "nc": 57, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@UshioTakigawa/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1929406, "client_id": 68157, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/62ccb6f5/uploads/origins/d1c02db5-b5da-415a-9ba4-e62bf23b1577?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f707843175ebd437fb906a837c3f9f24", "srcset": "https://si.imgix.net/62ccb6f5/uploads/origins/d1c02db5-b5da-415a-9ba4-e62bf23b1577?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f707843175ebd437fb906a837c3f9f24, https://si.imgix.net/62ccb6f5/uploads/origins/d1c02db5-b5da-415a-9ba4-e62bf23b1577?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=cfaed43c6e2c5dbdefc256a9b2e078a8 2x, https://si.imgix.net/62ccb6f5/uploads/origins/d1c02db5-b5da-415a-9ba4-e62bf23b1577?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=5a31a5ac1bf31ce1ab70b00af2ff61a5 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/62ccb6f5/uploads/origins/d1c02db5-b5da-415a-9ba4-e62bf23b1577?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=89598968a112ca116c20e48b40fbd18c", "srcset": "https://si.imgix.net/62ccb6f5/uploads/origins/d1c02db5-b5da-415a-9ba4-e62bf23b1577?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=89598968a112ca116c20e48b40fbd18c, https://si.imgix.net/62ccb6f5/uploads/origins/d1c02db5-b5da-415a-9ba4-e62bf23b1577?bg=%23ff