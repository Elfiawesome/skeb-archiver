=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=32f1e1909d6c953fe690d6233998b7b7", "srcset": "https://si.imgix.net/c401639f/uploads/origins/eeb63d12-8aa5-49ed-94fe-3f82d84a2679?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=32f1e1909d6c953fe690d6233998b7b7, https://si.imgix.net/c401639f/uploads/origins/eeb63d12-8aa5-49ed-94fe-3f82d84a2679?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=1b8768def1a9da0c08ca876bdb19d584 2x, https://si.imgix.net/c401639f/uploads/origins/eeb63d12-8aa5-49ed-94fe-3f82d84a2679?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a6ad6587c1754fad3836826b4a165e0f 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/c401639f/uploads/origins/eeb63d12-8aa5-49ed-94fe-3f82d84a2679?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c024fd9c5af7e0b0cb27ffb0c02cdb17", "srcset": "https://si.imgix.net/c401639f/uploads/origins/eeb63d12-8aa5-49ed-94fe-3f82d84a2679?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c024fd9c5af7e0b0cb27ffb0c02cdb17, https://si.imgix.net/c401639f/uploads/origins/eeb63d12-8aa5-49ed-94fe-3f82d84a2679?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=3c6b1a05a3591bd4fa11d238c4805691 2x, https://si.imgix.net/c401639f/uploads/origins/eeb63d12-8aa5-49ed-94fe-3f82d84a2679?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=ba2497b381b0f975d0e4f656e7c952b7 3x"}, "body": "ラブライブ!蓮ノ空スクールアイドルクラブの徒町小鈴が男の人(歳は20代半ば以上、4,50代も可)とエッチしまくった後で身体中精液まみれで座りながら男の人のちんちんを舐めているイラストをお願いします。\nシチュエーションはエッチしてみたい小鈴がハタチと偽って男の人(幼く見える成人女性を探していた)に会い、ホテルなどで男の人と満足いくまでエッチして、小鈴が男の人のちんちんに残っている精液を舐めている感じです(小鈴の舌とちんちんには若干精液の糸を引いている状態でお願いします)。\n\n男の人は(会う前から幼く見えると思っていたものの)小鈴が予想以上に幼く見えたのでかなり激しく犯しており、小鈴もかなり気持ちよくなってる感じてす。\n場所についてはお任せします(ホテル、車やバスルームの中、生活感のある男の人の自宅など)\n小鈴の身体は未成熟な感じで、胸はぺったんこか膨らみかけくらいで出来るだけ幼く見えるように描いて下されば嬉しいです。\n\nあと、前述のハタチと偽ってる部分がわかるようにお願いします。\n(エッチしている最中の会話や会う前のDMなどのやり取り\n男「ホントに20歳、だよね？」\n小鈴「ハタチです♡」)\n(内容は追加したり、ある程度改変しても大丈夫です)\n参考にしてください\nhttps://www.pixiv.net/artworks/118832467　(5枚目)\nhttps://www.pixiv.net/artworks/119767899\nhttps://www.pixiv.net/artworks/120332797\nhttps://www.pixiv.net/artworks/120393922\n\n他にも描いてみたいものがあれば自由にお願いします。", "nc": 169, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@714Kotehan/works/8", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3170400, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/312711bf/uploads/origins/8abe591b-bae3-4c17-9924-fad03d445e53?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2ee1ede63d12843480116b1cc2c12486", "srcset": "https://si.imgix.net/312711bf/uploads/origins/8abe591b-bae3-4c17-9924-fad03d445e53?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2ee1ede63d12843480116b1cc2c12486, https://si.imgix.net/312711bf/uploads/origins/8abe591b-bae3-4c17-9924-fad03d445e53?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=1ff5d1746de05597bd30da931997b76b 2x, https://si.imgix.net/312711bf/uploads/origins/8abe591b-bae3-4c17-9924-fad03d445e53?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d2842f8aa5c41ee193c64670b3320200 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/312711bf/uploads/origins/8abe591b-bae3-4c17-9924-fad03d445e53?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=00eb51426d2eafb30e859797fa1a6f5c", "srcset": "https://si.imgix.net/312711bf/uploads/origins/8abe591b-bae3-4c17-9924-fad03d445e53?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=00eb51426d2eafb30e859797fa1a6f5c, https://si.imgix.net/312711