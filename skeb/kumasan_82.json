す。\n瞳のハイライトは赤色です\n\n-----------------\n\nご検討のほど、どうぞよろしくお願いいたします！\nもし料金や内容等に不備がありましたら お手数おかけしますが、再送していただけたら嬉しいです。\n\nhttps://www.dropbox.com/scl/fo/uigtkjga4n6bnprvtwtav/ACqhJBLLBjQUFPuAbRgIOxE?rlkey=glur4zummhuw7da2lr74vmw3b&st=8ljfaclm&dl=0", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@kumasan_82/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3377953, "client_id": 161919, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/43f1d25a/uploads/origins/ad9b7818-0ab0-4062-8ec2-62dc7c6116fd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=14e7f1451f81377e316d9c85a1fb47eb", "srcset": "https://si.imgix.net/43f1d25a/uploads/origins/ad9b7818-0ab0-4062-8ec2-62dc7c6116fd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=14e7f1451f81377e316d9c85a1fb47eb, https://si.imgix.net/43f1d25a/uploads/origins/ad9b7818-0ab0-4062-8ec2-62dc7c6116fd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a477dab0f283e971db5a4eb8d0c7096e 2x, https://si.imgix.net/43f1d25a/uploads/origins/ad9b7818-0ab0-4062-8ec2-62dc7c6116fd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e2660e81f6b224dea0bc129f53c35da0 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/43f1d25a/uploads/origins/ad9b7818-0ab0-4062-8ec2-62dc7c6116fd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=580f53630ecb365a2dc22fd4ae41f691", "srcset": "https://si.imgix.net/43f1d25a/uploads/origins/ad9b7818-0ab0-4062-8ec2-62dc7c6116fd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=580f53630ecb365a2dc22fd4ae41f691, https://si.imgix.net/43f1d25a/uploads/origins/ad9b7818-0ab0-4062-8ec2-62dc7c6116fd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200