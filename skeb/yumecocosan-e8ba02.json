\n　　（本人は部活の合宿で出し物を決める日を休んでおり、学園祭当日に初めて知った状態）\n\n具体的なポーズ等はあまからし先生の解釈で大丈夫ですが、\nもし可能であれば以下のようなイラストであると大変うれしいです。\n　・バニーガールのような衣装（露出が高めならバニーガールでなくとも大丈夫です）\n　・メニュー表を片腕で抱いていて片胸が潰れている様子。\n　・太ももが見えている。\n\n何卒よろしくお願い致します。\n\nhttps://www.pixiv.net/artworks/100807573", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@yumecocosan/works/15", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1448547, "client_id": 2266168, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/0ab0a546/uploads/origins/de1ec245-3dd6-44e0-bc04-e474b72c749b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=35ed3c69f96165bab1aa00673973e1e3", "srcset": "https://si.imgix.net/0ab0a546/uploads/origins/de1ec245-3dd6-44e0-bc04-e474b72c749b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=35ed3c69f96165bab1aa00673973e1e3, https://si.imgix.net/0ab0a546/uploads/origins/de1ec245-3dd6-44e0-bc04-e474b72c749b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=908730ecf4c0586efb729bf6322d3357 2x, https://si.imgix.net/0ab0a546/uploads/origins/de1ec245-3dd6-44e0-bc04-e474b72c749b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=004636e8f2f31cb37daef5fc80a2e98b 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/0ab0a546/uploads/origins/de1ec245-3dd6-44e0-bc04-e474b72c749b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=13694bfa729ce10244dd0fc1dd8e2739", "srcset": "https://si.imgix.net/0ab0a546/uploads/origins/de1ec245-3dd6-44e0-bc04-e474b72c749b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=13694bfa729ce10244dd0fc1dd8e2739, https://si.imgix.net/0ab0a546/uploads/origins/de1ec245-3dd6-44e0-bc04-e474b72c749b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=cro