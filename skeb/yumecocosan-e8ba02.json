5d-47d0-8e92-548799a3c056?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=60d29f816ecf7b0be4ac72202804af9a", "srcset": "https://si.imgix.net/a7720dd7/uploads/origins/6c603a92-6f5d-47d0-8e92-548799a3c056?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=60d29f816ecf7b0be4ac72202804af9a, https://si.imgix.net/a7720dd7/uploads/origins/6c603a92-6f5d-47d0-8e92-548799a3c056?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=db6c1f7b5b9bc6aeeabffe117e16ad4f 2x, https://si.imgix.net/a7720dd7/uploads/origins/6c603a92-6f5d-47d0-8e92-548799a3c056?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=79d40c9c624fae048ac098e4f2e39d93 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/a7720dd7/uploads/origins/6c603a92-6f5d-47d0-8e92-548799a3c056?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6a224279fe5b24ea574765d41cf60b65", "srcset": "https://si.imgix.net/a7720dd7/uploads/origins/6c603a92-6f5d-47d0-8e92-548799a3c056?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6a224279fe5b24ea574765d41cf60b65, https://si.imgix.net/a7720dd7/uploads/origins/6c603a92-6f5d-47d0-8e92-548799a3c056?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=5e51d8f656fd77a3106498413d380b90 2x, https://si.imgix.net/a7720dd7/uploads/origins/6c603a92-6f5d-47d0-8e92-548799a3c056?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=ba4769a0888464ee71dda02436c96e23 3x"}, "body": "あまからし先生！\n\n先日は非常に素敵なイラストをありがとうございました！\n絵もキャラデザもあまりにも好きだったので、このイラスト（https://skeb.jp/@yumecocosan/works/6　）の同じキャラ（店員さん）続編みたいなものをお願いしても良いでしょうか！？\nもっとあの店員さんが見とうございます！\n\n『店員さんが宅飲み中にパンツコキで責めてくれるイラスト』\n・パンツとブラを付けた下着姿の店員さんがパンツコキしてくれる。しなだれかかってきて密着しながら、パンツに包まれたペニスを扱いてくる。男側が快楽で骨抜きなのを把握してるので余裕の表情。\n・宅飲み中なので机にお酒とおつまみがある。一緒に机の上に、店員さんに買わされたパンツやブラが山積みにされてる。\n・部屋にあるテレビに「下着姿の店員さんの自撮り」写真が写してある。買わされた下着を店員さんが着てくれた上に自撮りをプレゼントしてくれたもの。写ってる写真は「パンツを谷間に挟んで疑似パイズリしてる」写真。\n・床に精液まみれになったパンツやブラが散乱してる。\n\n上記の様なイラストをお願いすることはできるでしょうか……？\n下記みたいな流れを経た店員さんのイラストが見たいと思ったのです……！\n\n店員さんにハマって常連と化す\n↓\n店員さんからもロックオンされて、完全篭絡するために私生活にも介入される\n↓\n「自宅を店員さんに開放して好きに使ったり住ませる代わりに、今まで買った下着や新しく買う下着で気持ちよくしてくれる」約束をする\n↓\n入り浸られて半同棲みたいになりながらも、店員さんの性技でズブズブ虜にされていく。その一幕のイラスト\n\n\n………みたいなのを、どうか、どうかお願いできればと思います。\n何卒、よろしくお願い致します……！", "nc": 176, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@yumecocosan/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1448547, "client_id": 129890, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/9ef6cbc3/uploads/origins/e299c39e-e011-4cf8-88ed-8ceb4e307db5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=82f7532b8979605433d5c20771212128", "srcset": "https://si.imgix.net/9ef6cbc3/uploads/origins/e299c39e-e011-4cf8-88ed-8ceb4e307db5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=82f7532b8979605433d5c20771212128, https://si.imgix.net/9ef6cbc3/uploads/origins/e299c39e-e011-4cf8-88ed-8ceb4e307db5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=4ac33b962606fb1b609d92b88d7ee437 2x, https://si.imgix.net/9ef6cbc3/uploads/origins/e299c39e-e011-4cf8-88ed-8ceb4e307db5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=68088ce43187d1936dbe791c86a6af6f 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/9ef6cbc3/uploads/origins/e299c39e-e011-4cf8-88ed-8ceb4e307db5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d7033a85abced22b3256410b515ba659", "srcset": "https://si.imgix.net/9ef6cbc3/uploads/origins/e299c39e-e011-4cf8-88ed-8ceb4e307db5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d7033a85abced22b3256410b515ba659, https://si.imgix.net/9ef6cbc3/uploads/origins/e299c39e-e011-4cf8-88ed-8ceb4e307db5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=e8a92f0f1847d4081d99b01aafe83b49 2x, https://si.imgix.net/9ef6cbc3/uploads/origins/e299c39e-e011-4cf8-88ed-8ceb4e307db5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=d2da74b128129db97ce6140239efd7b4 3x"}, "body": "あまからし先生\n\nすみません、よければお願いしたいイラストがあるのですが、いけるでしょうか？\n色仕掛けで下着を押し売りしてくる、悪いランジェリーショップの女の子店員さん……みたいなイラストをお願いしたく思います。\nこっちは男なのに、色仕掛けで射精させて商品の下着を汚させて買わせる、みたいなイメージです。\n\n・女の子は巨乳。元々スーツを着てたけど、脱いでブラとパンツだけの服装で責めてくる\n・更衣室の中で、ペニスにパンツを被せた上から手で撫で回してくる\n・これから使う予定のパンツとブラが山積みに置かれてる\n・買い物カゴに買わされるパンツとブラが山積み。精液が付着してる\n・状況的には既に何時間も続けられてる状態。パンツとブラをとっかえひっかえ使って、射精させられ続ける。女の子が上手過ぎて快感で抵抗できない\n\n上記のようなイラストをお願いできたりしないでしょうか？\nもしよければ、是非にお願いしたく思います。", "nc": 160, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@yumecocosan/works/5", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/75889966/uploads/origins/05e55574-4e84-4a70-b41b-5df2e7523676?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=45d3e9f12d5dee3c79f5c6cb1a35696f", "srcset": "https://si.imgix.net/75889966/uploads/origins/05e55574-4e84-4a70-b41b-5df2e7523676?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=45d3e9f12d5dee3c79f5c6cb1a35696f, https://si.imgix.net/75889966/uploads/origins/05e55574-4e84-4a70-b41b-5df2e7523676?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=7a87c909f971fcaeec08f7e4c35eca5c 2x, https://si.imgix.net/75889966/uploads/origins/05e55574-4e84-4a70-b4