る用途に加えまして、推しが配信・サムネイル・SNS等の配信活動全般で使えるようにお願いしたく存じます（二次創作公認プログラムに準ずる用途を想定しております）。\n誠に勝手ではございますが、ご納品をもちまして、ご許可いただけたこととさせて頂く旨、予めご了承ください。\n\nなお、これは二二ニ様がpixivやポートフォリオ、SNS等へご掲載されることを制限するものでは一切ありません。\n\n今回お願いしたい配信者は 水縹アオ (みはなだあお) さんという方です\n資料として、推しの画像を添付させていただきます\n\n\n・構図、ポーズ、表情\n美味しそうなパンケーキを頬張ってお目目キラキラさせて幸せな表情をしている水縹アオをお願いします\n背景など他の細かな所はニニニ様にお任せいたします\n\n・ファイル形式\n可能でしたら、PSDか、キャラクターの立ち絵のみのPNG背景透過バージョンをお付け頂けますと幸いです（もし背景をお描きくださる場合）。難しい場合は結構です\n\n以上となります。ご検討のほど、何卒宜しくお願い致します。\n\nhttps://twitter.com/girutaburiru/status/1668267753713573890?t=Bsr9hFXaBQLCvYmgAvqoOA&s=19", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@2103150_/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2576731, "client_id": 104114, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/335c0b47/uploads/origins/fcbb9ae8-7203-444b-a08c-98248bf1adbf?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=444b667639e394ae74ba5e4e05b449e9", "srcset": "https://si.imgix.net/335c0b47/uploads/origins/fcbb9ae8-7203-444b-a08c-98248bf1adbf?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=444b667639e394ae74ba5e4e05b449e9, https://si.imgix.net/335c0b47/uploads/origins/fcbb9ae8-7203-444b-a08c-98248bf1adbf?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=82040adbab8eeb9284b040602d5dd8af 2x, https://si.imgix.net/335c0b47/uploads/origins/fcbb9ae8-7203-444b-a08c-98248bf1adbf?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=9f7b800355d976e71793de797e30f8ab 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/335c0b47/uploads/origins/fcbb9ae8-7203-444b-a08c-98248bf1adbf?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=53db0af507bb2379a86475b973e3ce65", "srcset": "https://si.imgix.net/335c0b47/uplo