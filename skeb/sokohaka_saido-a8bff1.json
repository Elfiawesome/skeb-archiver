ount": 0, "received_works": [{"path": "/@sokohaka_saido/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1518376, "client_id": 3494504, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/b887a882/uploads/origins/9215bd42-b21b-494f-b57f-1e78f561834b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=97ff67d96b3e4805a13e8a4bd20d5e46", "srcset": "https://si.imgix.net/b887a882/uploads/origins/9215bd42-b21b-494f-b57f-1e78f561834b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=97ff67d96b3e4805a13e8a4bd20d5e46, https://si.imgix.net/b887a882/uploads/origins/9215bd42-b21b-494f-b57f-1e78f561834b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a609be3956a772a3552ac973d6412702 2x, https://si.imgix.net/b887a882/uploads/origins/9215bd42-b21b-494f-b57f-1e78f561834b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=7d560f70922800958e9618fb0c5a83e9 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/b887a882/uploads/origins/9215bd42-b21b-494f-b57f-1e78f561834b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0292d7ad40b876887dfe7540acb93e03", "srcset": "https://si.imgix.net/b887a882/uploads/origins/9215bd42-b21b-494f-b57f-1e78f561834b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0292d7ad40b876887dfe7540acb93e03, https://si.imgix.net/b887a882/uploads/origins/9215bd42-b21b-494f-b57f-1e78f561834b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=706b931af778d3813805acaa6008fb9b 2x, https://si.imgix.net/b887a882/uploads/origins/9215bd42-b21b-494f-b57f-1e78f561834b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=57c9028cc29cd94ed5652f5174f4ed63 3x"}, "body": "こんにちは！あなたの美しい絵と素敵な雰囲気が大好きです！私たちのOCを描いていただけませんか？\n\n1) GEIST｜183cm、40歳。\n元刑事。モノの記憶を読み取る能力を持っている。その能力のため、いつも手袋をしている。甘いお菓子や焼き菓子が大好き！\n性格は優しく、物わかりがよく、そつがない。深層心理では計算高く、人を操ることもある。大人でクールであろうとするが、おバカなこともしばしば。\n何が何でも \"真実 \"を見つけるという目標を持ち、最後には自分が死ぬことになっても構わない。そのため、秘密裏に無責任かつ危険な力の使い方をすることが多く、それが彼を傷つけ、死に至らしめることもある。\nモチーフ：冬、雪、氷、刑事事件簿、狩猟犬、フランプリン。\n\n2）コーリー｜172cm、37歳\n面倒くさがりで不器用な学者。物静かで思慮深いが、密かに茶目っ気がある。外見は派手さはない。目は穏やかで鋭い。時々疲れているように見える。怠け者で空気が読めず、よく物をなくす。死者を蘇らせる力を持つ。好奇心から実験や発明をしていることが多い。本と勉強が大好き。ブリーフケースにはワシの骸骨が入っており、彼の相棒である。\nモチーフ：秋、死、本、骨、落ち葉。\n\n2人の関係について：\nふたりは親友同士。コーリーは世間に対して心を閉ざし、ドライで無感情でいようと決意しているが、ガイストは彼を生き返らせようと決意している。\n\n描いてもらいたいのは、乾燥した不毛の森の砂漠だ。木々はすべて干からびて枯れ、そこらじゅうに骨がある。棘のある乾燥した茂みがあり、地面はひび割れてカラカラに乾いている。\n\nコリーは乾燥した木々や茂みのどこかに迷い込み、眠れる森の美女のように眠っている。乾いた蔓に巻かれているか、木の中にいるのかもしれない。ガイストは懸命に闘い、彼のもとへ辿り着こうと枯れ木の中を奮闘している。ガイストは棘のために乾いた地面に血を流しながら歩いている。乾いた木々、棘、骨、そして棘はコーリーの心を表している。ガイストの血と彼の足跡にある生きた植物は、彼が乾いた森に生命を取り戻すことを表している。\n\n画像は横向きでお願いできますか？また、もしよろしければ、将来的にこの画像を個人的な印刷に使いたいと考えています（販売、商用利用、大量生産は不可）。また、レイヤーを分離した.psdファイルにしていただくことは可能でしょうか？問題があれば遠慮なく断ってください！衣装の調整はご自由にどうぞ！\n\nhttps://drive.google.com/drive/folders/1qMbIdLhd7Lp66QQSvv6pW5479ywa8zaE?usp=drive_link", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@sokohaka_saido/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1518376, "client_id": 2191796, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/60076d96/uploads/origins/29c8b597-4240-42d1-87d9-12da2029b828?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6cf03730fa6c401fb7d7e609c6591083", "srcset": "https://si.imgix.net/60076d96/uploads/origins/29c8b597-4240-42d1-87d9-12da2029b828?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6cf03730fa6c401fb7d7e609c6591083, https://si.imgix.net/60076d96/uploads/origins/29c8b597-4240-42d1-87d9-12da2029b828?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=acb31e4fb8c