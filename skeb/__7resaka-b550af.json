。家事などは全般助手がする。\n基本的には事件解決に勤しむ探偵＆サポートをする助手。家では基本的に探偵の言動が発端で軽い喧嘩はしつつも仲のいい2人。\n\n構図や服装など、全て本当にお任せ致します！\n\nまた、画像資料に一部、「【CoC】Ⅶ・peccata」のネタバレがございます\n画像のファイルは分けておりますが、お気を付けください。\n\nもしも、ネタバレが大丈夫でしたらそちらも入れていただけるととても嬉しいですが、ネタバレ注意となりますので、その旨記載していただけると助かります！\n\n使用用途\n⬛︎個人鑑賞\n⬛︎個人で楽しむ範囲のグッズ作成\n⬛︎友人への共有\n\nよろしくお願いいたします！\n\nhttps://www.notion.so/291886ab6bf680f9b320c4f6f7d6e570", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@__7resaka/works/8", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3569503, "client_id": 717411, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/3d216fda/uploads/origins/a6737c7b-2a3d-4065-b1ae-89398231ed49?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c176ce24bddc51f47f3b7791796832b4", "srcset": "https://si.imgix.net/3d216fda/uploads/origins/a6737c7b-2a3d-4065-b1ae-89398231ed49?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c176ce24bddc51f47f3b7791796832b4, https://si.imgix.net/3d216fda/uploads/origins/a6737c7b-2a3d-4065-b1ae-89398231ed49?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=8481691896ec90847b51615b7132b2e0 2x, https://si.imgix.net/3d216fda/uploads/origins/a6737c7b-2a3d-4065-b1ae-89398231ed49?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=feb4467a3573eafc105d49da7e6a467c 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/3d216fda/uploads/origins/a6737c7b-2a3d-4065-b1ae-89398231ed49?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f0e42395fe9f1fa3385220b662e64904", "srcset": "https://si.imgix.net/3d216fda/uploads/origins/a6737c7b-2a3d-4065-b1ae-89398231ed49?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f0e42395fe9f1fa3385220b662e64904, https://si.imgix.net/3d216fda/u