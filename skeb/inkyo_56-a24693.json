華の左足にはコブラのタトゥーがあり、胸と背中には桜のタトゥーがある。春華は繊細な花のようで、とても内気。雪菜は少し筋肉質で、春華は小柄に見えるように。リンホアには、今度の大会に向けてユキナに武術のトレーニングをしてもらいたい。元総合格闘家チャンピオンのリンホアが彼女に対抗するのに問題がない間、ユキナはハードなトレーニングをしているはずだ。トレーニングの最後は、リンファがユキナを地面に叩きつけ、トーナメントに備えて休むように言う。最後のシーンは、雪菜が包帯を巻くのを春華が手伝う場面であるべきだ。ユキナはローブを開き、おっぱいの周りのテープが緩んでいるはずだ。もし漫画が英語でカラーだったら。\n\nhttps://drive.google.com/drive/folders/17Dvkh9RACts9vUPP6sOUnZDqP7xd2Mr5?usp=drive_link", "nc": 48, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@inkyo_56/works/3", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/e1297be9/uploads/origins/1a30384b-7f4c-4255-987d-7d313dbe7431?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=0fb6e42a08b36515479ef0847c0d6e6f", "srcset": "https://si.imgix.net/e1297be9/uploads/origins/1a30384b-7f4c-4255-987d-7d313dbe7431?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=0fb6e42a08b36515479ef0847c0d6e6f, https://si.imgix.net/e1297be9/uploads/origins/1a30384b-7f4c-4255-987d-7d313dbe7431?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=7b2cfc8d90b9932d23ddc3fc1c1fbad0 2x, https://si.imgix.net/e1297be9/uploads/origins/1a30384b-7f4c-4255-987d-7d313dbe7431?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=17b84c10d74dd63146d38f09dbd22723 3x"}, "private": true, "genre": "comic", "tipped": false, "creator_id": 3628231, "client_id": 2873700, "nc": 161}, {"path": "/@inkyo_56/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "comic", "tipped": false, "creator_id": 3628231, "vtt_url": null, "thumbnail_