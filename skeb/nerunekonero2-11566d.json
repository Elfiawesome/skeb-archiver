色は明るいブロンドですが、髪型は右側の「衣装参考画像」にあるユナのスタイル（毛先が短く尖っていて、長いポニーテールを赤いリボンで結んでいる）と同じように描いてください。\n\nもしよろしければ、キャラクターと背景のレイヤーが分離されたPSDファイルに、「ホタル」も別のレイヤーとして追加していただけると嬉しいです。そうすれば、ミュージックビデオ用にアニメーション化することができます！ また、ミュージックビデオでキャラクターの表情を豊かにするために、目を開いたバージョンと目を閉じたバージョンもご用意いただけると助かります！\n\nご検討いただき、誠にありがとうございます！\n\nhttps://drive.google.com/drive/folders/1NJYbf2V711CJwH4snotE87PS0ekv0ioe?usp=sharing", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@nerunekonero2/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3261215, "client_id": 2851674, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/41803c58/uploads/origins/136bdcc4-d96e-4d5c-81f4-0178aff2671c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0f60c621a40edd6c27fd487f3be47443", "srcset": "https://si.imgix.net/41803c58/uploads/origins/136bdcc4-d96e-4d5c-81f4-0178aff2671c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0f60c621a40edd6c27fd487f3be47443, https://si.imgix.net/41803c58/uploads/origins/136bdcc4-d96e-4d5c-81f4-0178aff2671c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=874cc5d5b8cccb4e1cf3ed02bf15161e 2x, https://si.imgix.net/41803c58/uploads/origins/136bdcc4-d96e-4d5c-81f4-0178aff2671c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b4d7b9bdf194794b829fdaa390bdba03 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/41803c58/uploads/origins/136bdcc4-d96e-4d5c-81f4-0178aff2671c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3bc5cb4ca4e438dfdc6bae4279812a30", "srcset": "https://si.imgix.net/41803c58/uploads/origins/136bdcc4-d96e-4d5c-81f4-0178aff2671c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3bc5cb4ca4e438dfdc6bae4279812a30, https://si.imgix.