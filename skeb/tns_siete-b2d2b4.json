ps://imgur.com/a/A2uJTxd\n\n三人の体形はにむちむち体型にしてください。\nhttps://imgur.com/a/4Qu7mmj\n\n背景はなくてもいいです。\n先生の絵が素敵で膝の上とかお尻までは見たいです!", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@tns_siete/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1442756, "client_id": 1881495, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/ec5fa2cc/uploads/origins/3add860e-ed98-454a-a9a8-44f3e2dc92b4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ec150e74b0f183a6142facc4f0dd837e", "srcset": "https://si.imgix.net/ec5fa2cc/uploads/origins/3add860e-ed98-454a-a9a8-44f3e2dc92b4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ec150e74b0f183a6142facc4f0dd837e, https://si.imgix.net/ec5fa2cc/uploads/origins/3add860e-ed98-454a-a9a8-44f3e2dc92b4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=2eea78a76f324f195fc17697cce245d7 2x, https://si.imgix.net/ec5fa2cc/uploads/origins/3add860e-ed98-454a-a9a8-44f3e2dc92b4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=5586307b94c8941fbde215c28abbd85c 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/ec5fa2cc/uploads/origins/3add860e-ed98-454a-a9a8-44f3e2dc92b4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=8255b7208b8ee44c24b69fd6f0272788", "srcset": "https://si.imgix.net/ec5fa2cc/uploads/origins/3add860e-ed98-454a-a9a8-44f3e2dc92b4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=8255b7208b8ee44c24b69fd6f0272788, https://si.imgix.net/ec5fa2cc/uploads/origins/3add860e-ed98-454a-a9a8-44f3e2dc92b4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=57f61194a2b1e9bae870358127e31fb8 2x, https://si.imgix.net/ec5fa2cc/uploads/origins/3add860e-ed98-454a-a9a8