込まれていると尚良いです）\n・殺死杉さんのオフ丸一日\n以上のいずれか一つ以上の要素を汲んだ内容でも構いません。\nなんとかなりそうでしたらよろしくお願いします。", "nc": 153, "word_count": 11835, "transcoder": "text", "creator_acceptable_same_genre": true}], "similar_creators": [{"id": 213957, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "鈍挫", "screen_name": "gyosonnotamiyo", "avatar_url": "https://pbs.twimg.com/profile_images/1581370223281963014/5nSMrHOJ.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1187287187928178688/1650779742/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 2, "complete_expiration_days": 30, "skills": [{"genre": "art"}], "banned": false, "nc": 160}, {"id": 436227, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "ぱた絵", "screen_name": "ahiru_pata", "avatar_url": "https://pbs.twimg.com/profile_images/1797467896337367040/2xEA3KLR.jpg", "header_url": "https://pbs.twimg.com/profile_banners/4583665032/1558572829/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "art"}, {"genre": "comic"}, {"genre": "correction"}], "banned": false, "nc": 177}, {"id": 1177500, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "kimisora", "screen_name": "kimisora", "avatar_url": "https://pbs.twimg.com/profile_images/1661335939078295552/9pzSXz65.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1365636001482244099/1738215725/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "art"}], "banned": false, 