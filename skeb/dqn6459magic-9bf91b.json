ads/origins/b88ae105-4b61-4f15-8f88-702ec96d8f1e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9a7e57ea0240dc3a38c7877b29f4e398, https://si.imgix.net/b4e912af/uploads/origins/b88ae105-4b61-4f15-8f88-702ec96d8f1e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a1f116aefd1a33be031a456956290380 2x, https://si.imgix.net/b4e912af/uploads/origins/b88ae105-4b61-4f15-8f88-702ec96d8f1e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=6b6bab9c254badfbe9d1647af65d8804 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/b4e912af/uploads/origins/b88ae105-4b61-4f15-8f88-702ec96d8f1e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=844341c0e90e90ccd2ac0d092dffd92f", "srcset": "https://si.imgix.net/b4e912af/uploads/origins/b88ae105-4b61-4f15-8f88-702ec96d8f1e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=844341c0e90e90ccd2ac0d092dffd92f, https://si.imgix.net/b4e912af/uploads/origins/b88ae105-4b61-4f15-8f88-702ec96d8f1e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=335af8884ecf9affe6df51d404e81839 2x, https://si.imgix.net/b4e912af/uploads/origins/b88ae105-4b61-4f15-8f88-702ec96d8f1e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=bebf5ad898c64c10186fc48527510638 3x"}, "body": "こんにちは！SNS等で普段より大変お世話になっております。\nずっとあいくさんにskebでコミックを依頼させて頂きたい…！と考えていたので、このたび思い切ってリクエストをお送りしてみました。\n\n\n先日、当方の創作キャラのラムダと、フォロワーさんの創作キャラの凪くんがバトル？してる１枚イラストを頂いて、あいくさんの作画でこの二人がバトルしている漫画を見てみたい…！！と考え、勢いに乗ってリクエストさせて頂きました。\n\nあと折角なので、あいくワールドともコラボできたら……と考えておりまして……\nお互いドラメルの四神と勘違いされたり、差し支えなければ四神の一員（仮）というバトルの切っ掛けは如何でしょう……\nドラメルのどなたかも一緒に出演して頂けると、更に嬉しいです！\nそれぞれピンでも、味方同士でも、なんでも大丈夫です。\n\n上記の筋書きで無くても大丈夫です、シチュエーションはお任せ致します！\nとにかくカッコよくバトルして頂ければ……\n度を過ぎなければ、ボロボロになっちゃっても大丈夫です。\n\nラムダの資料は添付させて頂きます。全身が分かる資料がこれくらいしかなく申し訳ないです…\n（そして凪くんは他所様のキャラクターなので、こちらから提供できる資料がなく…すみません…）\n\nお手隙の際に、よろしくお願い致します。\n改めて、本当にいつもお世話になっております！！\n\nhttps://x.com/kim_urinasu/status/1681246800358031360/photo/1", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@dqn6459magic/works/10", "private_thumbnail_image_urls": null, "private": false, "genre": "comic", "tipped": true, "creator_id": 1613777, "client_id": 387769, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/95639d0e/uploads/origins/3754e10b-e91e-42b6-9f43-c7efcca98df0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4e64a43491e8adaa5cf02328861eacc5", "srcset": "https://si.imgix.net/95639d0e/uploads/origins/3754e10b-e91e-42b6-9f43-c7efcca98df0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4e64a43491e8adaa5cf02328861eacc5, https://si.imgix.net/95639d0e/uploads/origins/3754e10b-e91e-42b6-9f43-c7efcca98df0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=27759c1316339036e5cbe24953f4c0bc 2x, https://si.imgix.net/95639d0e/uploads/origins/3754e10b-e91e-42b6-9f43-c7efcca98df0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=405aa592c1d3ffc7a976381a29216298 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/95639d0e/uploads/origins/3754e10b-e91e-42b6-9f43-c7efcca98df0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f6aa74b4f0e374f814d095d0ed0a05c4", "srcset": "https://si.imgix.net/95639d0e/uploads/origins/3754e10b-e91e-42b6-9f43-c7efcca98df0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f6aa74b4f0e374f814d095d0ed0a05c4, https://si.imgix.net/95639d0e/uploads/origins/3754e10b-e91e-42b6-9f43-c7efcca98df0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=23f69aa9fd28e13292711868607502d6 2x, https://si.imgix.net/95639d0e/up