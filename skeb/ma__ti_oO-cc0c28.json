っかあり\n・右側が黒、左側が白\n・リボンとフリルと骨\n\n【好きな物】\n・ゲーム(特にFPS)\n・ピンク、黒、白\n・歌う事\n・チワワ\n・ポテト\n・寝ること\n\n【参考資料】\n・キャラクターデザイン｜https://lit.link/AmaochiMirua\n・相棒(うさちゃん)｜https://x.com/AmaochiMirua/status/1910347062400766114  \n\n【使用用途】\n・配信サイト(Twitch収益化済み)\n・活動用SNS\n・商用利用 (可能であれば)\n\n金額が不足している場合は、再送リクエストをしていただいて大丈夫です！\nお忙しいところ恐縮ですが、ご検討のほどよろしくお願いいたします。", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@ma__ti_oO/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3111133, "client_id": 2033046, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/36fa6a34/uploads/origins/8efba8fa-8c72-4bbb-a072-f7c98fd1d5d1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=11c14a292072ee77fb766eee3bb671e9", "srcset": "https://si.imgix.net/36fa6a34/uploads/origins/8efba8fa-8c72-4bbb-a072-f7c98fd1d5d1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=11c14a292072ee77fb766eee3bb671e9, https://si.imgix.net/36fa6a34/uploads/origins/8efba8fa-8c72-4bbb-a072-f7c98fd1d5d1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=18dcf18a0c775700efc5337f168f2f89 2x, https://si.imgix.net/36fa6a34/uploads/origins/8efba8fa-8c72-4bbb-a072-f7c98fd1d5d1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e45063d5145412f936095c0ec7aeff79 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/36fa6a34/uploads/origins/8efba8fa-8c72-4bbb-a072-f7c98fd1d5d1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=61266f5af3411e8e7899c8b533c05287", "srcset": "https://si.imgix.net/36fa6a34/uploads/origins/8efba8fa-8c72-4bbb-a072-f7c98fd1d5d1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=61266f5af3411e8e7899c8b533c05287, https://si.imgix.net/36fa6a34/uploads/origins/8efba8fa-8c72-4