om/watch?v=0swTinloNgc&t=16947s\nhttps://www.youtube.com/watch?v=vRy4oiSP28U&t=16850s", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 8734, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "シロ9じらスケブ募集中", "screen_name": "siro90414", "avatar_url": "https://pbs.twimg.com/profile_images/2109528676132167680/mfy2O5b8.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1498108778/1607947973/1500x500", "appeal_receivable": false, "popular_creator_rank": 22, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 120, "skills": [{"genre": "art"}], "banned": false, "nc": 177}, {"id": 2125465, "creator": true, "nsfw_acceptable": false, "acceptable": false, "name": "くりーむ＠ご依頼受付中", "screen_name": "Vcream_unknow", "avatar_url": "https://pbs.twimg.com/profile_images/1342485794741620738/u3eZqmTf.jpg", "header_url": "https://pbs.twimg.com/profile_banners/3229000309/1672923590/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 4, "complete_expiration_days": 30, "skills": [{"genre": "art"}], "banned": false, "nc": 0}, {"id": 2610607, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "蓮/はす", "screen_name": "hasunohato_", "avatar_url": "https://pbs.twimg.com/profile_images/1799474768032444416/Pu61EYxF.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1418359247708901376/1782908172/1500x500", "appeal_receivable": false, "popular_creator_rank": 49, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 10, "complete_expiration_days": 60, "skills": [{"genre": "art"}, {"genre": "music"}], "banned": false, "nc": 129