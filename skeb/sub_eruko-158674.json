ba49c9-c889-4678-8aae-ec061824e2a5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b01e68ee8c22f5440856fe8f8fd4d205, https://si.imgix.net/a30883e7/uploads/origins/fdba49c9-c889-4678-8aae-ec061824e2a5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=4bcd1726c8e72fc16e79540652bafc49 2x, https://si.imgix.net/a30883e7/uploads/origins/fdba49c9-c889-4678-8aae-ec061824e2a5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a857a9e11fc9dd793a159f387085bdb3 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/a30883e7/uploads/origins/fdba49c9-c889-4678-8aae-ec061824e2a5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=78b24645a20e6204ee61fe50ed4f2e62", "srcset": "https://si.imgix.net/a30883e7/uploads/origins/fdba49c9-c889-4678-8aae-ec061824e2a5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=78b24645a20e6204ee61fe50ed4f2e62, https://si.imgix.net/a30883e7/uploads/origins/fdba49c9-c889-4678-8aae-ec061824e2a5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=48f8b652772dc52f709ed6c3236293d4 2x, https://si.imgix.net/a30883e7/uploads/origins/fdba49c9-c889-4678-8aae-ec061824e2a5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=3b23216986ecbab5e1ee429e76ba386c 3x"}, "body": "こんにちは!!!ずっと昔から先生の絵のスタイルが大好きで、今回は指定された二人のキャラクターを描いていただきたいと思っています。\n \n女性キャラクター：微笑みは最も日常的な表情だが、心から喜んでいることは決してない。曇りのある秋と冬に親しみで、暗い感じ。\n \n男性キャラクター：悲観的な性格で、家に閉じこもるのが好き。カーテン越しの陽光を恐れつつも、浴びれたくおもっている。一旦外出すると、強い不安感がある。\n \n二人のイントラクション：幼なじみ同士で一緒に支えあいながら大きくなってきたが、不幸と悲しみに包まれ、悲劇的なストーリーである。\n\n先生が自由に彼らのインタラクションのやり方を発想しても構いません。あるいは、2枚の単人絵に分けて描いていただいても問題ありません。\n\nhttps://drive.google.com/drive/folders/171R7UOYywPLK05rqoNqeSzh7NjC1DZoo", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@sub_eruko/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3803150, "client_id": 3709960, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/4212146f/uploads/origins/7c3550f8-9345-45aa-9d57-bbf3771fcec1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=684b295283117d51a2cc48e3c8909a99", "srcset": "https://si.imgix.net/4212146f/uploads/origins/7c3550f8-9345-45aa-9d57-bbf3771fcec1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=684b295283117d51a2cc48e3c8909a99, https://si.imgix.net/4212146f/uploads/origins/7c3550f8-9345-45aa-9d57-bbf3771fcec1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=4cef76d3e5cd9c5360aafda4140959fc 2x, https://si.imgix.net/4212146f/uploads/origins/7c3550f8-9345-45aa-9d57-bbf3771fcec1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=aabdd9cfe27c5fd9f333fafeb6148bc4 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/4212146f/uploads/origins/7c3550f8-9345-45aa-9d57-bbf3771fcec1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=294c4fcfbe3de1fe6f1c5d97d057ad95", "srcset": "https://si.imgix.net/4212146f/uploads/origins/7c3550f8-9345-45aa-9d57-bbf3771fcec1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=294c4fcfbe3de1fe6f1c5d97d057ad95, https://si.imgix.net/4212146f/uploads/origins/7c3550f8-9345-45aa-9d57-bbf3771fcec1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=770801154c78ab393fcea73bae7056fc 2x, https://si.imgix.net/4212146f/uploads/origins/7c3550f8-9345-45aa-9d57-bbf3771fcec1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=8aa2638052981a2ee0b3db59bb25b118 3x"}, "body": "駒坂える子様\n\n初めまして。\nVtuber事務所「ゆにふぃ！所属」のVtuber「風魔小宵」と申します。\n新着に出てきたイラストに魅力を感じ今回リクエストを送らせていただきました。\n\n【リクエスト内容】\n私自身（小宵）のイラストをお願いしたいです。\n用途の都合上、髪の毛や獣耳などが見切れない形で描いていただけますと大変助かります。\n\n【使用用途】\n・収益化済みYoutubeチャンネルでの利用\n・X（旧Twitter）での告知・プロモーション\n※グッズ等の実物使用などの形での商用利用はございません。\n\n【構図について】\nポーズや描画範囲については、金額に応じお任せで描いていただければ幸いです。\nもし可能でしたら16:9の比率を意識したポージングだと嬉しいです。\nまた、描画の際の注意事項として\n①瞳孔の形はデフォルトでひし形\n②袖の水色のレースは立ち絵ではわかりづらいのですが透け感のあるレースとなっております\n③Live2Dモデルにおいて獣耳と人耳は同時に表示されないので人耳の描写は不要です\n\n【希望納品形式】\n・PSDデータ（もしくは人物のみの透過pngデータとして分けていただけると助かります）\n\n【参考資料】\n下記URLに立ち絵や一部背面資料を添付しております。描画時のご参考にしていただければ幸いです。\nhttps://drive.google.com/file/d/1LtW2PjPaH3hS40ahvF743yn-QkqDd3iz/view?usp=sharing\nhttps://drive.google.com/file/d/1GTuH7WA0WBDWolQdmLvjC7CmRSU2coIb/view?usp=sharing\n\n金額の不足などがございましたら再送していただけますと大変助かります。\nご多忙のところ恐れ入りますが、ぜひご検討いただけましたら幸いです。\nどうぞよろしくお願いいたします。\n\nhttps://drive.google.com/file/d/1GTuH7WA0WBDWolQdmLvjC7CmRSU2coIb/view?usp=sharing", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@sub_eruko/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3803150, "client_id": 3816867, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/fe0b0a95/uploads/origins/d229d48f-49be-4bdf-bcf2-0b82815c49c8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4e3d2e9686511507628b7d9b1c68c315", "srcset": "https://si.imgix.net/fe0b0a95/uploads/origins/d229d48f-49be-4bdf-bcf2-0b82815c49c8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4e3d2e9686511507628b7d9b1c68c315, https://si.imgix.net/fe0b0a95/uploads/origins/d229d48f-49be-4bdf-bcf2-0b82815c49c8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=fd4151c8e71202416ba0d5d52491dd30 2x, https://si.imgix.net/fe0b0a95/uploads/origins/d229d48f-49be-4bdf-bcf2-0b82815c49c8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=8f7f2c09c25752095cea426c31b4408d 3x"}, "duration": null, "nsfw": false, "hardcore