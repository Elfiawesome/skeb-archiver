=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6f7af2aa861a48cec3590c7b6a53107f, https://si.imgix.net/56ba10e8/uploads/origins/0285e662-a19b-4373-8e50-d0a240b295a9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=02a922b57327c82008f547d654a2fac5 2x, https://si.imgix.net/56ba10e8/uploads/origins/0285e662-a19b-4373-8e50-d0a240b295a9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=a54384fc306d9d74fce8c55ea2a10793 3x"}, "body": "はじめまして。\n\n今回描いていただきたいキャラクターは、ブルーアーカイブの世界観のもとでできた私のオリキャラです。\n\nhttps://www.dropbox.com/s/g4f7wr025m55dyb/1309004-3.jpg?dl=0\nhttps://www.dropbox.com/s/2qif3cyrc40vrca/1375360-3.png?dl=0\nこの二人のうちどちらか、もしくは両方を描きやすい方で選んで描いてください。\n\nhttps://x.com/orval_jp/status/1698633580170375223?s=20\nhttps://x.com/orval_jp/status/1550782140538691585?s=20\nTwitterにて投稿されている二つのイラストが非常に好みだと感じたので、このような雰囲気で描いてくれるとうれしいです。細部はおまかせします。\n\n使用用途として、SNSのアイコンやヘッダー等で使わせていただきたいです。ご検討の方よろしくお願いします。", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@orval_jp/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 713862, "client_id": 1379484, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/0025d785/uploads/origins/965d339b-c7c7-491f-8ed0-0be2feda01b6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1933324dfe7caa96dd0136fa2a2efd05", "srcset": "https://si.imgix.net/0025d785/uploads/origins/965d339b-c7c7-491f-8ed0-0be2feda01b6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1933324dfe7caa96dd0136fa2a2efd05, https://si.imgix.net/0025d785/uploads/origins/965d339b-c7c7-491f-8ed0-0be2feda01b6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=1c3c3ec3337708d288e42f97ee8f559d 2x, https://si.imgix.net/0025d785/uploads/origins/965d339b-c7c7-491f-8ed0-0be2feda01b6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d52e5821321624d26053d420490e8aaf 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/0025d785/uploads/origins/965d339b-c7c7-491f-8ed0-0be2feda01b6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e673cf461b84b30ac9f60a0589bcabcb", "srcset": "https://si.imgix.net/0025d785/uploads/origins/965d339b-c7c7-491f-8ed0-0be2feda01b6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e673cf461b84b30ac9f60a0589bcabcb, https://si.imgix.net/0025d785/uploads/origins/965d339b-c7c7-491f-8ed0-0be2feda01b6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=cd47a5cbbbb403069d19fb6e83491e03 2x, https://si.imgix.net/0025d785/uploads/origins/965d339b-c7c7-491f-8ed0-0be2feda01b6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=f31bf23604fe450001a299a52f661fc1 3x"}, "body": "お久しぶりです。2回目の依頼となりますが可能であれば受けていただきたく思います！\n\n今回はスケボー🛹を持って、スケボーの練習場の階段に座り、\n棒付きキャンディー🍭を舐めている、クールだけどポップなイラストをお願いしたく思います。\n\n更に完成したイラストのキャラが被らない場所に上からfrom ORVAL to TKとイカつい文字でサインして頂きたいです。(ORVAL様のTwitterでイラストに文字が描かれた絵を拝見していたので参考にしました)\n\n\n・背景…誰もいないスケボーができる練習場(練習場の床はグレーのコンクリート)\n落書きなどもあり少し治安は悪い。昼の明るさで少し肌寒い天気\n\n・人物… 淡いベージュの前髪がぱっつん、ストレートなロングヘアー。\n髪色と同じ淡いベージュの猫耳と尻尾。\n服装は背景に合う黒や白、淡い紫などのストリート系な洋服。\n高身長。\n猫目でクールな顔。瞳の色は水色\n\n・イラストのサイズ…16:9(横16:縦9)より少し横のサイズを長くしたサイズにして頂きたい。\n\nイラストに対する人物の配置など、ORVAL様の描きやすいようにお任せいたします！\n\nご検討よろしくお願いします！", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@orval_jp/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 713862, "client_id": 1379484, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/24302174/uploads/origins/09b38838-b434-4510-93ad-7fc15beb9e77?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3715ffb50b4389c7d290c3002e610f5f", "srcset": "https://si.imgix.net/24302174/uploads/origins/09b38838-b434-4510-93ad-7fc15beb9e77?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3715ffb50b4389c7d290c3002e610f5f, https://si.imgix.net/24302174/uploads/origins/09b38838-b434-4510-93ad-7fc15beb9e77?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=acc7b1eef3a26a7daff7a20a7be8b477 2x, https://si.imgix.net/24302174/uploads/origins/09b38838-b434-4510-93ad-7fc15beb9e77?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d05d7617f53fcc35a22bbe612ffc5d3e 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/24302174/uploads/origins/09b38838-b434-4510-93ad-7fc15beb9e77?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9ca3859e1cf61d9ea4b10d3bc3ec9a93", "srcset": "https://si.imgix.net/24302174/uploads/origins/09b38838-b434-4510-93ad-7fc15beb9e77?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9ca3859e1cf61d9ea4b10d3bc3ec9a93, https://si.imgix.net/24302174/uploads/origins/09b38838-b434-4510-93ad-7fc15beb9e77?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=1478d37c94332e03efc42950b4c8ffce 2x, https://si.imgix.net/24302174/uploads/origins/09b38838-b434-4510-93ad-7fc15beb9e77?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=8ef713d1f2c6613f15f5ebd8d4d6abd3 3x"}, "body": "こんばんは✨\nORVAL様の描く、シックでリアルな背景とマッチしたタッチのイラストに惚れてしまい依頼させて頂きました。\n\n背景…夜の高層ビルなどが立ち並ぶ街並み\nネオンの看板が光っていたり、サイバー系な雰囲気にして頂きたい。\n\n人物…足元までの全身が映るサイズ。\nポーズは何でも良い。イラストの中心あたりに描いて頂きたい。\n\n人物特徴…\n淡いベージュの前髪がぱっつん、ストレートなロングヘアー。\n髪色と同じ淡いベージュの猫耳と尻尾。\n服装は背景に合う黒や白淡い紫などのストリート系な洋服。\n高身長。\n猫目でクールな顔瞳の色は水色(瞳は光らせてほしい)\n\nイラストのサイズ…16:9(横16:縦9)より少し横のサイズを長くしたサイズにして頂きたい。\n\n電子機器が不得意でして画像添付など出来なくてすみません。\nクールなイラストにして頂けるのでしたら、ORVAL様の描きやすい様でお願いいたします\n\n