せ！\n\nお忙しい中、要件のみで申し訳ありません。\n応援しております！\n\nhttps://drive.google.com/drive/folders/1kVcp6B8dzGYFGpFb9spMTyDnz0TzyM7Q?usp=sharing", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@06chimika13/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2867753, "client_id": 806358, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/ef888af2/uploads/origins/21da7d3b-5817-4c90-a4f5-47fa249929fc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e8f091f8a8dd672c15934d5d91b6776b", "srcset": "https://si.imgix.net/ef888af2/uploads/origins/21da7d3b-5817-4c90-a4f5-47fa249929fc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e8f091f8a8dd672c15934d5d91b6776b, https://si.imgix.net/ef888af2/uploads/origins/21da7d3b-5817-4c90-a4f5-47fa249929fc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=20c360189c80641a6b74d487b4e474d8 2x, https://si.imgix.net/ef888af2/uploads/origins/21da7d3b-5817-4c90-a4f5-47fa249929fc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=af3f01738ed63edd2215b5d7d29cd91b 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/ef888af2/uploads/origins/21da7d3b-5817-4c90-a4f5-47fa249929fc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=78564c71e97285ddbb05441cf4534f55", "srcset": "https://si.imgix.net/ef888af2/uploads/origins/21da7d3b-5817-4c90-a4f5-47fa249929fc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=78564c71e97285ddbb05441cf4534f55, https://si.imgix.net/ef888af2/uploads/origins/21da7d3b-5817-4c90-a4f5-47fa249929fc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=85e76fd77bfac92a6a81658617b6adfe 2x, https://si.imgix.net/ef888af2/uploads/origins/21da7d3b-5817-