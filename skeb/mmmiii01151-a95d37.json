さんは心の中に居ます。\n流血などはなし、直接的な形のないけれど明確な生と死というものが濃い絵だと嬉しいです。(難しくてすみません)\n\n百合でも普通の絵でも大丈夫です。攻め受けも特にありません。お好きな方で描いて頂けると嬉しいです。\n\nよろしくお願いします。\n\nhttps://x.com/ebihara_sou/status/1958798339236925566?s=46", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "similar_creators": [{"id": 12, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "おぷーナ", "screen_name": "op_na_ura", "avatar_url": "https://pbs.twimg.com/profile_images/2022337732757037056/5ZzamyG2.jpg", "header_url": "https://pbs.twimg.com/profile_banners/2350122362/1753346915/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "art"}], "banned": false, "nc": 176}, {"id": 6650, "creator": true, "nsfw_acceptable": false, "acceptable": false, "name": "tomekami🎨FANBOXプリント：JVFWPSI", "screen_name": "tomekami", "avatar_url": "https://pbs.twimg.com/profile_images/1917944849485180928/26CHarZV.jpg", "header_url": "https://pbs.twimg.com/profile_banners/59409949/1779613913/1500x500", "appeal_receivable": true, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 7, "complete_expiration_days": 21, "skills": [{"genre": "art"}], "banned": false, "nc": 33}, {"id": 455043, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "Gaff@春例大祭(あ14ab)", "screen_name": "33_gaff", "avatar_url": "https://pbs.twimg.com/profile_images/1364604475898351617/Q0kzQLlk.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1214985500659871744/1681061480/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 5, "complete_