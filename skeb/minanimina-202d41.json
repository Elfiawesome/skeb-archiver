構図、人数など好きに選んで頂いて構いません...！可能であれば絡みのある構図が嬉しいです。\n\n金額不足や不備がございましたら再送要請頂けますと幸いです！ご縁がありましたらよろしくお願いいたします。", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@minanimina/works/15", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/2284d4c5/uploads/origins/65ba074d-768f-4c25-837d-1547fa27a010?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=f068e28ad294b7df28ed20dc03288ae3", "srcset": "https://si.imgix.net/2284d4c5/uploads/origins/65ba074d-768f-4c25-837d-1547fa27a010?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=f068e28ad294b7df28ed20dc03288ae3, https://si.imgix.net/2284d4c5/uploads/origins/65ba074d-768f-4c25-837d-1547fa27a010?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=6e4b05f71774bcae5db83f26a7d907f7 2x, https://si.imgix.net/2284d4c5/uploads/origins/65ba074d-768f-4c25-837d-1547fa27a010?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=70554ee1ad08b6a1c5e6907b9ce33dcf 3x"}, "private": true, "genre": "art", "tipped": false, "creator_id": 3185605, "client_id": 3817345, "nc": 0}, {"path": "/@minanimina/works/14", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/1a2f9bec/uploads/origins/5c7f7f19-7372-48f7-a10f-8a5eddfcffb4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=297e27a0d9fcefafdb5f3c21996f5649", "srcset": "https://si.imgix.net/1a2f9bec/uploads/origins/5c7f7f19-7372-48f7-a10f-8a5eddfcffb4?bg=%23fff&a