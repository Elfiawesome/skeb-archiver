5effcb6a1fc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a28b3a4cc2414bb86356d954a12a0519 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/1911664d/uploads/origins/b2673b03-3afa-4096-922b-05effcb6a1fc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=84e6a0e4b4b5b4c22da2e3ba3ba3d62f", "srcset": "https://si.imgix.net/1911664d/uploads/origins/b2673b03-3afa-4096-922b-05effcb6a1fc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=84e6a0e4b4b5b4c22da2e3ba3ba3d62f, https://si.imgix.net/1911664d/uploads/origins/b2673b03-3afa-4096-922b-05effcb6a1fc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=efb8daf04abf73b4b9fadeebbb2a8e8b 2x, https://si.imgix.net/1911664d/uploads/origins/b2673b03-3afa-4096-922b-05effcb6a1fc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=2113094b671af4cec66a59c638349663 3x"}, "body": "サンカクヘッド様  \n\n初めまして。個人で配信活動をしている蘭つつみと申します。\nうまるちゃんが大好きで1巻からずっと追っておりました！\n今回、youtubeチャンネルの自己紹介欄を拝見していたところ、skebの記載がありましたのでリクエストさせていただいています。\n\n以下、依頼内容記載いたします。\n\n【人物】 \n 個人V「蘭つつみ」 (資料添付) \n\n【人物詳細】\nVtuberなどで有りがちな設定などは無く、等身大の自分で配信しています。\n喋るのと同じくらいゲームが大好きなのですが大して上手くないのが悩みです。\n普段は仕事中心な生活をしていて、愛猫の食費とエアコン代を稼いでいます。\n\n【イラスト詳細】 \n白猫のぬいぐるみを抱えて、お菓子を食べながら、ゲームのマッチングを待っているイラストをお願いしたいです\nまた、どこでもいいので愛猫が近くで寝ててほしいです\n横長16:9の比率で頭部、髪、左右の見切れがないようにしていただけたら嬉しいです\n\n 【使用用途】\n収益化済みYouTube・twitchでの配信や動画内での使用\n配信のマッチング中や離席中時などで表示させたいです\n4月から普段の配信はtwitch、朝の配信とメンバー限定のみyoutubeというスタイルをとっています\n\n【納品形式】\n背景や人物のレイヤーを分けたPSD、または人物のみの透過png別納での納品でお願いします。\n\nお忙しい中恐縮ですが、何卒よろしくお願い申し上げます。\n\nhttps://drive.google.com/drive/folders/1ijC0lCoj00-7uU092L12ySiPfCDc1UNT?usp=drive_link", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [{"path": "/@fxxk_potez/works/44", "private_thumbnail_image_urls": null, "private": f