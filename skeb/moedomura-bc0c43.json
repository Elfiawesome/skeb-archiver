m=webp&fit=crop&crop=top&w=200&h=200&s=15fe9d5daa41708e35b1988920dedcf2, https://si.imgix.net/e9110716/uploads/origins/de96987b-e1bf-45be-965f-91ca0eaf2d92?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=982104f90a12e965157c65f7ab63d371 2x, https://si.imgix.net/e9110716/uploads/origins/de96987b-e1bf-45be-965f-91ca0eaf2d92?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c4a271d3945c3e7be09ca245f227bcf5 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/e9110716/uploads/origins/de96987b-e1bf-45be-965f-91ca0eaf2d92?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=56a193a3fc8010de3f0b92f09b882501", "srcset": "https://si.imgix.net/e9110716/uploads/origins/de96987b-e1bf-45be-965f-91ca0eaf2d92?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=56a193a3fc8010de3f0b92f09b882501, https://si.imgix.net/e9110716/uploads/origins/de96987b-e1bf-45be-965f-91ca0eaf2d92?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=6ffd64a21e70f1f469b78556eb345f9c 2x, https://si.imgix.net/e9110716/uploads/origins/de96987b-e1bf-45be-965f-91ca0eaf2d92?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=1d9fb2c3bcd48315d1dbcfcd35856bd5 3x"}, "body": "VTuberの栢森エマ/エマ・シュエットさん(@Emma_Chouette)の絵をお願いしたいです。それと、納品いただいた際には、私の手でTwitterのファンアートタグに投稿する許可も合わせて頂きたいです（skebでえどさんに描いてもらった旨は併記します）。\n\n求める絵の雰囲気はかわいらしい感じ（普段のえどさんの絵の感じ）で、季節感のあるシチュでお願いします。例えばクリスマスに間に合いそうならクリスマスの、もうちょっと後なら年末やお正月感、特にちょうどいい時期じゃければ単に冬っぽい感じでもいいです。服装は公式のものに限らず、シチュに合わせて着せ替えたり羽織らせたり脱がせたりしてくれて構いません。微えっちなのは自分では絶対描けそうもないのでそういうものの方が嬉しいかもしれません。えどさんのキラキラした目が好きなので、両目閉じてる絵にはしないでください。あと、腰から生えている羽は忘れないよう注意してください（ありがちらしいので）（見えない画角で描いたり何か羽織らせて隠したりするのはOKですが、あるはずのものがないという感じにはならないように）。\n\nご検討よろしくおねがいします。\n\n設定画のある固定ツイート: https://twitter.com/Emma_Chouette/status/1452264351117705217", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@moedomura/works/10", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1382003, "client_id": 73271, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/a0e75a5d/uploads/origins/fddba690-57a9-424c-89ff-37542000d4b2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=52a7236932d544a45dbd49d31e9e8ae9", "srcset": "https://si.imgix.net/a0e75a5d/uploads/origins/fddba690-57a9-424c-89ff-37542000d4b2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=52a7236932d544a45dbd49d31e9e8ae9, https://si.imgix.net/a0e75a5d/uploads/origins/fddba690-57a9-424c-89ff-37542000d4b2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f783c32972da4fd8e5c53053ec216ee8 2x, https://si.imgix.net/a0e75a5d/uploads/origins/fddba690-57a9-424c-89ff-37542000d4b2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=dd9166a705ad80ef8d3664e026450b39 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/a0e75a5d/uploads/origins/fddba690-57a9-424c-89ff-37542000d4b2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=4f4dae64b2ad6134946815a467d74712", "srcset": "https://si.imgix.net/a0e75a5d/uploads/origins/fddba690-57a9-424c-89ff-37542000d4b2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=4f4dae64b2ad6134946815a467d74712, https://si.imgix.net/a0e75a5d/uploads/origins/fddba690-57a9-424c-89ff-37542000d4b2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=e3e4170eed3e3ce38a1d47be7ff32f5e 2x, https://si.imgix.net/a0e75a5d/uploads/origins/fddba690-57a9-424c-89ff-37542000d4b2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=b06ad6e972ac965d118ec7f7e31d2601 3x"}, "body": "お世話になります。\n下記の内容にてリクエストを送らせていただきます。ご検討くださいますようお願い致します。\n\n【題材】\n・飛影(幽☆遊☆白書)のものまねをする優木せつ菜(虹ヶ咲学園スクールアイドル同好会)\n\n【構図・ポーズ・表情・セリフ】\n・幽☆遊☆白書コミックス11巻より\n\n「もう後もどりはできんぞ　巻き方を忘れちまったからな」のセリフとともに腕の包帯を外し、邪王炎殺黒龍波発動の体勢に入るカットを参考にしてくださるようお願いします。\n\n※1　検索エンジンで「もう後戻りはできんぞ」で検索すると参考画像がすぐ見つかります。\n\n※2　セリフはせつ菜が言いそうなセリフに改変してくださっても結構です。ただ、原作の当該シーンの不敵な笑みと雰囲気が好きなので「うおおおおお」とか雰囲気にそぐわないセリフはご遠慮くださると幸いです。\n\n【背景】\n・特に指定しません。ステージでも虹ヶ咲の部室でも…お手間でしたら省略してくださっても結構です。\n\n【衣装】\n・MAZE TOWNのゴシック調衣装希望ですが、描画の手間が大変でしたら簡単な衣服でも構いません。えどさんにお任せします。\n\n【申し送り事項】\n・A・ZU・NAのファンミで「中二病テーマの楽曲」が話題に上がっていたので今回の題材を提案させていただきました。\n\n・ラブライバーの方はもちろんですが、幽☆遊☆白書ファンの方にも見ていただきたいので、差し支えなければ「幽☆遊☆白書」や「飛影」のタグも合わせて付けてくださると幸いです。", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@moedomura/works/9", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1382003, "client_id": 1427724, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/0d4bfa29/uploads/origins/b47917f0-fed1-41c6-8b71-ab220b0bd4d9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c950e5ddc21004f5cd9cc3a1cce576fe", "srcset": "https://si.imgix.net/0d4bfa29/uploads/origins/b47917f0-fed1-41c6-8b71-ab220b0bd4d9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c950e5ddc21004f5cd9cc3a1cce576fe, https://si.imgix.net/0d4bfa29/uploads/origins/b47917f0-fed1-41c6-8b71-ab220b0bd4d9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=6d7e6a1e9545fbe7b5a2163772d3a606 2x, https://si.imgix.net/0d4bfa29/uploads/origins/b47917f0-fed1-41c6-8b71-ab220b0bd4d9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=5292e0635e577e23c40208aaf8d86582 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/0d4bfa29/uploads/origins/b47917f0-fed1-41c6-8b71-ab220b0bd4d9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=c