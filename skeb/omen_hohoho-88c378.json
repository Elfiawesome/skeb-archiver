ちら用の絵もお願いしたく…\n出来れば、上記の女の子が映画を観ているorテレビにくぎ付けになっているなど…？\n参考例が無く大変申し訳ないのですが、お任せで描いていただけますと…＞＜\n\nもしお時間ございましたら描いていただけますと幸いです…！\nお忙しい中大変恐縮ですがよろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/1fUJs5ZJWC7ycQdJAEkdKDjPSIVoxqIFG?usp=sharing", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@omen_hohoho/works/8", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 781784, "client_id": 678979, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/145140e8/uploads/origins/178377a0-368b-4af7-8ffe-9eab44ef7e17?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=073c9999608bcc5165fc4025c0ad1cc2", "srcset": "https://si.imgix.net/145140e8/uploads/origins/178377a0-368b-4af7-8ffe-9eab44ef7e17?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=073c9999608bcc5165fc4025c0ad1cc2, https://si.imgix.net/145140e8/uploads/origins/178377a0-368b-4af7-8ffe-9eab44ef7e17?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f3a52778e974335d6a793a32761a9641 2x, https://si.imgix.net/145140e8/uploads/origins/178377a0-368b-4af7-8ffe-9eab44ef7e17?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=7870b9e561772acd5f7c85716f4e79b4 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/145140e8/uploads/origins/178377a0-368b-4af7-8ffe-9eab44ef7e17?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3278738d5d9355683ed5d72747ff37a6", "srcset": "https://si.imgix.net/145140e8/uploads/origins/178377a0-368b-4af7-8ffe-9eab44ef7e17?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3278738d5d9355683ed5d72747ff37a6, https://si.imgix.net/145140e8/uploads/origins/178377a0-368b-4af7-8ffe-9eab44ef7e17?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=20