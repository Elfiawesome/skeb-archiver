: 7000}], "acceptable_only_public": false, "tip_acceptable": true, "yearly_report_client_visible": false, "total_appeals_count": 0, "received_works": [{"path": "/@kiritani/works/8", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 19473, "client_id": 630801, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/0817d765/uploads/origins/e97e15b8-fbf2-494e-bf77-7e74f375fc4f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a7e3bd4c1fc3ded0464b7b07889ec120", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/0817d765/uploads/origins/e97e15b8-fbf2-494e-bf77-7e74f375fc4f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=828af0de090798db6b7f9001bd6273e4", "src_set": ""}, "body": "お世話になっております。ミカお願いします。", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@kiritani/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 19473, "client_id": 484006, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/4c4e6cf5/uploads/origins/17a6cd08-8a8a-4144-bb53-5bbba2b25d91?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fe12ee78770bbec564520bc6158ee8d6", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/4c4e6cf5/uploads/origins/17a6cd08-8a8a-4144-bb53-5bbba2b25d91?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=914f4e6f33a813d0e92f87b8d6b9f665", "src_set": ""}, "body": "こんにちは。Twitterでいつも性癖に刺さるヤンデレを見ておりました。\n\nVtuberの星降あめるがヤンデレナースになって主人公を監禁するイラストをお願いします。\n\n<シチュエーション>\n・ヤンデレナースの星降あめるが、入院と称して廃病院で主人公を監禁する\n・主人公は若干違和感を抱きつつも監禁されていることに気づいていない\n\n<内容>\n・ナースの服は薄いピンク\n・ベッドに寝た状態でナースを見る視点\n・ナースは主人公の腕を掴んで胸に当てさせる（揉ませる感じ）\n・主人公は腕だけ映っている\n・主人公の腕は男女かわからない中性的な感じでお願いします\n・廃墟感のある背景(ひび割れた壁、割れたガラス窓などで明らかにわかる形で表現いただけるとありがたいです）\n・ピンク色の点滴がある\n\n<セリフ>\n主人公（ナースのあめるさん優しい人だなぁ。こんなに丁寧に面倒を見てくれるなんて。ただちょっとおかしいな。軽いケガのはずなのにもう半年も入院してる..）\nナース「XXXさん、『リハビリ』の時間ですよ」\n主人公(あっ、もうリハビリの時間か。あめるさんも応援してくれるし、頑張らないと)\n\n立ち絵は下記URL参照ください\nhttps://twitter.com/ameru_hoshifuru/status/1366312255910862852?s=20&t=Cmgw4z1yPB9YFPWiRIqlkA\n\nなお、タグは「星降あめる」「星降あーと」がよく使われていますのでご参考までに\n\nhttps://twitter.com/ameru_hoshifuru/status/1366312255910862852?s=20&t=Cmgw4z1yPB9YFPWiRIqlkA", "nc": 25, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@kiritani/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 19473, "client_id": 1642620, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/8131577e/uploads/origins/2b5c573b-a239-4ba9-b08d-b3faea5c9722?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=28243245fb7336151c22b1b3167e0bf6", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/8131577e/uploads/origins/2b5c573b-a239-4ba9-b08d-b3faea5c9722?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=4948773a97207211bb1d3508da9d5db6", "src_set": ""}, "body": "下記の内容でお願いします！\nキャラ リマ(ヤンデレ)\n構図 いつも桐谷さんが描いてる腰から上ぐらい？の一枚絵 1枚\n服装 指定なし特につけるアクセサリーもなし\nセリフ 自由、ただしどこかに「極上のモフモフ」を入れてください。\nセリフ形式 いつもの通りか桃色どエロ工房さん式(一枚にたくさんセリフを言わせる式)", "nc": 49, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@kiritani/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 19473, "client_id": 0, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/500708e9/requests/179235_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6408d6b368cc85650eaa9bc19de2ca85", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/500708e9/requests/179235_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c456d9e86bfe7a9a08dfb7a33afa2f47", "src_set": ""}, "body": "いつもTwitterのプリコネのイラスト楽しみに見ています！\n桐谷さんのイラストはどの作品もネタが非常に深く素晴らしいと思います。\n今回のリクエストはプリコネではありませんがお時間宜しければご検討お願い致します。\n\n作品：ビーナスイレブンびびっど！\nキャラクター：ミラ\n内容：事故(魔法とか薬とか)でふたなりになり勃起が収まらなくなってしまったミラさんが男にちんぽの快楽を教え込まれながら寝取られる\n入れて欲しい表現：ミラの射精\n可能であれば入れて欲しい表現：男→ミラへの中出し\n\nマンガ形式1ページ以上、モノクロ可です。\n桐谷さんのネタが大変刺さるのでその他の詳細はお任せ致します。\n(例えば男が増えたり男のセフレとかが出てきてもOKです)", "nc": 33, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@kiritani/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 19473, "client_id": 0, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/b3c30003/requests/18129_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d771438e4aa5a1b569961ba1c2b10338", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/b3c30003/requests/18129_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2ab45129b607b9bb27c7b3208e10cce3", "src_set": ""}, "body": "ありささん良かったですありがとうございます！良ければなんですがありささんの続きで朝までじっくりハメられた事後をお願いします。身体中堪能しつくされて顔や胸や下腹辺りにぶっかけされているかんじで。ビクンビクンしてると尚嬉しいです。本当に良ければでいいのでお願いします！", "nc": 48, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@kiritani/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 19473, "client_id": 0, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/09f398cd/requests/17828_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f2c84770a349be5c4bb67b92a9643633", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbna