99-474e-ab1f-7156ad89a5a9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7bf978c377a69e25225b211a39ad018a, https://si.imgix.net/5924351a/uploads/origins/91f3175f-de99-474e-ab1f-7156ad89a5a9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c6f0c887ee47193cb205a5ccab13ffa7 2x, https://si.imgix.net/5924351a/uploads/origins/91f3175f-de99-474e-ab1f-7156ad89a5a9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f447f3b4c352dbffb56ee4e4fd0b2ffb 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/5924351a/uploads/origins/91f3175f-de99-474e-ab1f-7156ad89a5a9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=86dcdb572af400e85541c78fc97d0730", "srcset": "https://si.imgix.net/5924351a/uploads/origins/91f3175f-de99-474e-ab1f-7156ad89a5a9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=86dcdb572af400e85541c78fc97d0730, https://si.imgix.net/5924351a/uploads/origins/91f3175f-de99-474e-ab1f-7156ad89a5a9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=f5a87c89b534d02cfac6cd27814f9436 2x, https://si.imgix.net/5924351a/uploads/origins/91f3175f-de99-474e-ab1f-7156ad89a5a9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=6fbee585e4d7c8b7c55d18871a98ecb9 3x"}, "body": "イワワ様、初めまして。\n\n現在Vtuberの準備を行っておりまして、自分のキャラのファンアートを書いて頂きたく、ご依頼させて頂きました。\n\n以下、依頼内容となります。\n\n■キャラ資料\nhttps://drive.google.com/drive/folders/1aOfTtYsSa7nK-vRrtRhZD9PPD8Vu77HN?usp=sharing\n\n■使用目的\n活動予定のキャラのキービジュアル及び動画やサムネでの使用\n\n■テーマ\nキャラの設定及びイメージとして、以下の様に考えております\n・ロリショタ系男の娘（ただボディは女の子として作ってもらってるため、貧乳系の女の子として描いていただいても大丈夫です）\n・体の成長が止まっており、見た目よりも歳が上\n・夜は化物退治、朝はメイドor女学生としての潜入任務\n・見た目と外面はクールな生真面目、本来の中身はズボラ・面倒くさがり・イタズラ好き \n・武器収集や特異能力の調査・探求が大好き\n・厨ニ大好き\n\n今回は可愛さを強く出しているものを希望のため、イワワ様が可愛いと思われる要素を入れて頂き、自由に作成頂けたらと存じます。\n\n■構図やポージング\nキャラに合いそうなものであれば特に指定はございませんので\nお任せでお願いしたします。\n\n\n■その他\n背景については、あれば嬉しいのですが、キャラのみでも構いません。\n\n活動の際、別途YouTubeのサムネなどの活動目的で使わせて頂きたいとも思っています。\nそのため、頭の先や横の髪の毛などは、先が切れないように書いて頂ければ幸いです。\nまた、キャラのみの透過でも利用できるよう、PSDのデータで、キャラのレイヤーだけが分かれていると、非常に助かります。\n\nまた、現在Vtuber用のTwitterがなく、キャライラストも作成中と前準備の段階のため、あらためて投稿時には名前記載の上、使用をさせていただきたいと思います。\n\n普段描かれている可愛いキャラと少しタイプが違うかと存じますが、条件に問題なければ、何卒よろしくお願いいたします！", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@iwawa__iwawa/works/3", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/c5f31558/uploads/origins/2b6cd17f-dd1b-46b7-8130-55ba22468447?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=7dbef30a84bdfb58f0532b728beac1a3", "srcset": "https://si.imgix.net/c5f31558/uploads/origins/2b6cd17f-dd1b-46b7-8130-55ba22468447?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=7dbef30a84bdfb58f0532b728beac1a3, https://si.imgix.net/c5f31558/uploads/origins/2b6cd17f-dd1b-46b7-8130-55ba22468447?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=69774e8c20ea7c23e50549838f60a11a 2x, https://si.imgix.net/c5f31558/uploads/origins/2b6cd17f-dd1b-46b7-8130-55ba22468447?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=045183a48183251eed17b411b4614345 3x"}, "private": true, "genre": "art", "tipped": true, "creator_id": 1576708, "client_id": 592578, "nc": 129}, {"path": "/@iwawa__iwawa/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1576708, "client_id": 1172470, "vtt_url": null, "thumbna