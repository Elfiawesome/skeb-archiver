いただいて大丈夫です。何卒ご検討の程、よろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/1TaXhNp0QyCsSe5uYFS3Ojb_3piakf7rF", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": []}, "price_history": {"art": [{"amount": 6000, "recorded_at": 1774008365.670594}, {"amount": 5000, "recorded_at": 1779860399.675395}], "comic": [{"amount": 5000, "recorded_at": 1774008365.670594}, {"amount": 4000, "recorded_at": 1780419067.414452}]}, "custom": {}}