ff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0f2cb9d91885809ce52eda10a05b2569, https://si.imgix.net/c7fbc555/uploads/origins/99220f80-1f36-4a87-a5e4-d18d395706b8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=16780c3eece0af98332b02189cf4d1ce 2x, https://si.imgix.net/c7fbc555/uploads/origins/99220f80-1f36-4a87-a5e4-d18d395706b8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=a3b503f67a602d65800edadffd3bf87f 3x"}, "body": "初めまして。\n先生の独特な作風に惹かれ、色彩や雰囲気の美しさにとても感動いたしました。ぜひ一度、私のオリジナルキャラクターを描いていただきたく、ご依頼させていただきました。\n\nキャラクターは小柄なドラゴンで、ピンク色の炎や、暖色系の鉱物や宝石といった要素を持っています。\n\nまた、狂気や恐怖といった強い感情の雰囲気表現や、少し奇妙で独特な構図などが特に好きですので、構図や演出は先生のご自由な発想で描いていただければ幸いです。\n\nどうぞよろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/1a_R-fqFehnFDvdzokEWuFBf_c5ugeVo9", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@hutaAji/works/6", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/97d33265/uploads/origins/2b233f8a-ce8e-49e5-a364-b696589a6c9e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=caa718a9004ab5e0dc57240285702e18", "srcset": "https://si.imgix.net/97d33265/uploads/origins/2b233f8a-ce8e-49e5-a364-b696589a6c9e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=caa718a9004ab5e0dc57240285702e18, https://si.imgix.net/97d33265/uploads/origins/2b233f8a-ce8e-49e5-a364-b696589a6c9e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=5894d8b8eac048d8da76a7d79cc47182 2x, https://si.imgix.net/97d33265/uploads/origins/2b233f8a-ce8e-49e5-a364-b696589a6c9e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=62ca83fca874d355b1ac49f8e6baf3e4 3x"}, "private": true, "genre": "art", "tipped": true, "creator_id": 2995058, "client_id": 755823, "nc": 17}, {"path": "/@hutaAji/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2995058, "client_id": 4024766, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/d54e6055/uploads/origins/0bfb6551-ea2b-4a82-a805-c9033eb440eb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e4c932072c7c7f6cff58912450f06fb9", "srcset": "https://si.imgix.net/d54e6055/uploads/origins/0bfb6551-ea2b-4a82-a805-c9033eb440eb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e4c932072c7c7f6cff58912450f06fb9, https://si.imgix.net/d54e6055/uploads/origins/0bfb6551-ea2b-4a82-a805-c9033eb440eb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=43df9fc36fe45f2cdabd95d8134c4268 2x, https://si.imgix.net/d54e6055/uploads/origins/0bfb6551-ea2b-4a82-a805-c9033eb440eb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a82a53b549b2762d042ad5d518095f8a 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/d54e6055/uploads/origins/0bfb6551-ea2b-4a82-a805-c9033eb440eb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=51eadf990ae3c79123d1ad2e5fde1fee", "srcset": "https://si.imgix.net/d54e6055/uploads/origins/0bfb6551-ea2b-4a82-a805-c9033eb440eb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=51eadf990ae3c79123d1ad2e5fde1fee, https://si.imgix.net/d54e6055/uploads/origins/0bfb6551-ea2b-4a82-a805-c9033eb440eb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=fe7b05ee4fb0d4d25bdbaf73330f5f18 2x, https://si.imgix.net/d54e6055/uploads/origins/0bfb6551-ea2b-4a82-a805-c9033eb440eb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=773344fec84020f37acea256fb56675c 3x"}, "body": "初めまして！\nいつも2味さんの作品に活力を頂いています、Bossと申します。\n2味さんの絵柄や構図、雰囲気、筆使いなど全てがとにかく大好きです…魅了されております\n今回は、そんな素敵な絵を描く2味さんに私のオリキャラを描いて頂きたくてリクエストを送らせていただきました。\n\nこのキャラクターは無性の天使です。常に落ち着いておりあまり表情が変わりません。また、美しさに対するプライドが高く、人間を少し下に見ているところがあります。\n\n資料や設定で分かりづらい、描きづらい部分がありましたら無視して頂いて大丈夫です！\n服やアクセサリーなども2味さんの描きやすいように変更、追加していただいて問題ありません\n\n【使用用途】\n•個人鑑賞、壁紙としての使用\n•SNSでのヘッダーとしての使用\n\nまた、以前リクエストされていた方のように私もこのキャラクターに変なマユゲを描いてもらいたいのですがよろしいでしょうか…？\nもちろん、難しいようでしたら大丈夫です！\n\n何より2味さんが楽しんでご自由に描いていただけたら幸いです。\n\n私自身初めての有償依頼なので至らない点もあると思いますが、お時間がある際にご都合がよろしければぜひよろしくお願いします。\n\nもし何か問題がありましたら遠慮なくリクエストを断っていただいて大丈夫です。\n何卒ご検討の程お願い致します。\n\nhttps://drive.google.com/file/d/1gWH4w7-2lveQCZxsihGuoPhXaAB0UHX5/view?usp=sharing", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@hutaAji/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2995058, "client_id": 3278613, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/ca2b6de9/uploads/origins/ab29e5d8-655c-49f3-81ef-471728625d1f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4493db7714aae34b6dbb285ee5718467", "srcset": "https://si.imgix.net/ca2b6de9/uploads/origins/ab29e5d8-655c-49f3-81ef-471728625d1f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4493db7714aae34b6dbb285ee5718467, https://si.imgix.net/ca2b6de9/uploads/origins/ab29e5d8-655c-49f3-81ef-471728625d1f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=1b96a5728ddd8380e703fcd70dc38484 2x, https://si.imgix.net/ca2b6de9/uploads/origins/ab29e5d8-655c-49f3-81ef-471728625d1f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=2e62a16c66717001022e999eaf4b6a2a 3x"}, "d