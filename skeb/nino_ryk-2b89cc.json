た。\n\n私事ですがクラウドファンティングでお店を開くことが確定したので、そちらのお祝いなどにイラストを使用したいと考えており、よろしければそういった雰囲気を白いパーカーを着ている方の服装で描いていただきたいです。\nhttps://x.com/gomomomomomomo/status/1893512799826890815\n\nまたよろしければマスコットキャラクターのようなものがいますのでそちらもどこかに入れて頂けたら嬉しいです。\nhttps://x.com/gomomomomomomo/status/1893514052347076978\n\n人物のみの背景が透過されているものがあると嬉しいです。\nYouTubeのサムネイルやTwitter等直接販売をしない形で活動に使用させていただく可能性があります。\n何卒宜しくお願い致します。\n\nhttps://x.com/gomomomomomomo/status/1812796883531936183", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@nino_ryk/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3071902, "client_id": 1629238, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/2799e848/uploads/origins/43a98b52-376d-4871-82a1-9836f0c68f79?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=00ca7cc2029d64ae09bc3dcf4235c5dd", "srcset": "https://si.imgix.net/2799e848/uploads/origins/43a98b52-376d-4871-82a1-9836f0c68f79?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=00ca7cc2029d64ae09bc3dcf4235c5dd, https://si.imgix.net/2799e848/uploads/origins/43a98b52-376d-4871-82a1-9836f0c68f79?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=580e5e6781390758cf604d7cbf9a17bc 2x, https://si.imgix.net/2799e848/uploads/origins/43a98b52-376d-4871-82a1-9836f0c68f79?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e95a729be7b42e3f7ad2997eca923e1b 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/2799e848/uploads/origins/43a98b52-376d-4871-82a1-9836f0c68f79?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=7d7e8ad9bf7fccf5bf1585b76d8f1dd5", "srcset": "https://si.imgix.net/2799e848/uploads/origins/43a98b52-376d-4871-82a1-9836f0c68f79?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blu