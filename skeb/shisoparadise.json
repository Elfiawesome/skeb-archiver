0&s=f6e9ade393bc87c5b4a260dea29a97f9", "skills": [{"genre": "art", "default_amount": 8000}, {"genre": "comic", "default_amount": 8000}], "acceptable_only_public": false, "tip_acceptable": true, "yearly_report_client_visible": false, "total_appeals_count": 0, "received_works": [{"path": "/@shisoparadise/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1326718, "client_id": 0, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/d8fcc1b2/uploads/origins/0521f9e3-2d60-4238-8e62-60c4741ff053?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2abdac5b3cedcc8a9ddf917819bb2f20", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/d8fcc1b2/uploads/origins/0521f9e3-2d60-4238-8e62-60c4741ff053?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=20dee2c305ae49ffb7368821bb56fcf3", "src_set": ""}, "body": "大葉シソ吉さん初めてまして、リクエスト募集中になっていたので送らせていただきます。\nシュチュエーション\nルミナスヴィジョンが射精管理された後の後日談で敵が用意した開発マシンのマジックハンドに寸止め、くすぐり責めされるイラストを漫画でお願いします。\nポーズ\n大葉シソ吉さんが前回Xに載せていた②と同じポーズをギャグボール付きでお願いします。https://x.com/shisoparadise/status/1941467583561248939?s=46&t=_cbVw-qPC2P01L4tRNMs6Q\n開発マシン\nコレクターユイの8話に出てきたコチョコチョマシンを大葉シソ吉さん風に描いて欲しいです。\nhttps://x.com/uticklelove/status/1740375251312406737?s=46&t=_cbVw-qPC2P01L4tRNMs6Q\nマジックハンド\nコレクターユイに出てくる触手の先端に着いている5本指の手袋と同じでお願いします。\n差分1\n金玉が空になるまで責められた後に気絶し目を覚ますと実験室の様な部屋に拘束されているのに気づくルミナスヴィジョン\n差分2\n目を覚ました数分後に機械音と共にルミナスヴィジョンの後ろにスマイルマークが着いた開発マシンが降りてくる\n差分3\nスマイルマークが「開発、開発」と呟くとルミナスヴィジョンのおっぱいとお尻を鷲掴みにしおちんちんをシコシコしだす\n差分4\n開発が始まり数分でイキそうになるルミナスヴィジョンですが次の瞬間責めが急に止まり困惑するルミナスヴィジョン\n差分5\n責めが止まったと思ったらスマイルマークが「こちょこちょ」と呟くき全身をくすぐり出し悶えるルミナスヴィジョン\n差分6\n寸止めくすぐり責めを交互にされ一時的に責めが止まった後射精出来ず息を切らしているルミナスヴィジョン\n差分7\n射精出来ずにいるルミナスヴィジョンを煽る様に開発マシンがパンパンに膨れ上がった金玉をこちょこちょしだす\n差分8\n金玉コチョコチョが終わった後開発マシンが「射精、射精」と呟くとおちんちんをシコシコし射精させる\n差分9\n開発マシンに射精させられた後また金玉が空になるまでマジックハンドにくすぐり責めされながらシコシコされ射精するルミナスヴィジョン\n以上の差分をセリフ付きの漫画でお願いします。", "nc": 40, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@shisoparadise/works/6", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/198e09b5/uploads/origins/828b84af-e116-456f-a7b2-8a2bc766f3f6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=9f649c3a457bd87e99eb6b6014dbc7c1", "src_set": ""}, "private": true, "genre": "art", "tipped": true, "creator_id": 1326718, "client_id": 5681, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 160, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@shisoparadise/works/5", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/a6839378/uploads/origins/526e5b4a-7866-4a34-8a2e-0e9e7f85b87e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=0d124c5a87cc9d1f2e47f5fed46b4040", "src_set": ""}, "private": true, "genre": "art", "tipped": true, "creator_id": 1326718, "client_id": 0, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 35, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@shisoparadise/works/4", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/8209ac73/uploads/origins/d39fb3bd-77e7-4ee6-8e5c-3c8b41326ed5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=64f1f25999af59d324b005b8899f52e9", "src_set": ""}, "private": true, "genre": "art", "tipped": true, "creator_id": 1326718, "client_id": 0, "vtt_url": "", 