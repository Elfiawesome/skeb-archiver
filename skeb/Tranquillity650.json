, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/04bbdada/uploads/origins/801c5937-3253-4696-99c3-bc0a0f3a105a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=757d3b83c74b4957fa9ceb66eabdd22e", "src_set": ""}, "body": "提督の顔を太ももに挟んでいる磯風(艦これ)のイラストをお願いします。\n状況的には、\n①ベッドに腰を掛けている磯風に誘惑された提督が股間に顔を埋めた状態。\n②磯風が不意に足を閉じる。太ももに顔をギュッと挟まれた提督は｢むぐっ！｣と言う感じに。\n③太ももの感触に興奮した提督の息や舌使いが激しくなると共に、磯風への刺激も激しくなる。\nと言うような流れです。\n後は、磯風のスカートは捲れてて太ももに挟まれた提督の頭部と磯風の下着が隠れず見えるのと、磯風は喘ぎ声が漏れ始めるけど余裕は持てるくらいの程良い感触と言う感じでお願いします。", "nc": 161, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Tranquillity650/works/122", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/4fde27cd/uploads/origins/9339e00f-c5bb-4a39-a438-94c467e9da54?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=5eed5df4515d02a061301336b5f4ca00", "src_set": ""}, "private": true, "genre": "art", "tipped": true, "creator_id": 2018454, "client_id": 0, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 177, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@Tranquillity650/works/121", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2018454, "client_id": 448481, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/5ef500f6/uploads/origins/364a7011-f6fe-4c2b-ab32-8a923739c3b8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2885ffd4a2a6035e18d86726d8bb92f8", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/5ef500f6/uploads/origins/364a7011-f6fe-4c2b-ab32-8a923739c3b8?bg=%23fff&auto=format%2Cco