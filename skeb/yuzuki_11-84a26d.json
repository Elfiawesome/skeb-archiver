bc5e-a37c5c3aa951?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9af600d9dec90e0d0239d777456c6ea9, https://si.imgix.net/08e69375/uploads/origins/4a675d71-8691-4892-bc5e-a37c5c3aa951?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=118a254b8cc2bab364afb8dce69c679d 2x, https://si.imgix.net/08e69375/uploads/origins/4a675d71-8691-4892-bc5e-a37c5c3aa951?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=333fb751590cc55d51915c14af77bd37 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/08e69375/uploads/origins/4a675d71-8691-4892-bc5e-a37c5c3aa951?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9ff0dd2c11bf8d58223a50b02d01ed80", "srcset": "https://si.imgix.net/08e69375/uploads/origins/4a675d71-8691-4892-bc5e-a37c5c3aa951?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9ff0dd2c11bf8d58223a50b02d01ed80, https://si.imgix.net/08e69375/uploads/origins/4a675d71-8691-4892-bc5e-a37c5c3aa951?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=76a390c92f6d6d61d896866b09d4d0d2 2x, https://si.imgix.net/08e69375/uploads/origins/4a675d71-8691-4892-bc5e-a37c5c3aa951?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=cd5b1d86b656b56e3997ea33897aaebb 3x"}, "body": "書くかも程度ですがドM小説の挿絵に使いたいです\nキャラ：道祖土緑、上木崎常盤、一ノ宮四恩\nシチュ：\n触手に寄生・苗床にされた着衣超乳&特大着衣ボテ腹姿の三人に嘲笑・侮蔑されながら、粘液まみれの触手満載の咥内を見せつけられるドMホイホイシチュ\n三人ともゴミを見る冷めた目(顔の上部や目元まで影がかかりハイライトなし)で\n緑は仕方ないわねといった感じの諦観と母性の混じった嘲笑、常盤は嫌悪と怯えが雑じり合った侮蔑、四恩は変態への嫌悪感を一切隠さない侮蔑希望です\n\n触手満載の咥内は、大量の粘液を着衣超乳に垂らしながら花みたく開くブラシ状触手&吸盤触手と\n咥内壁や本来の舌自体も粘液まみれの襞や繊毛などが密集する、挿入したら搾り尽くされる触手地獄で、\n常盤は触手花の中央部に精巣まで届く長さで、表面に尿道をゴリゴリ責める肉の瘤がびっしり生えている尿道責め触手と\n咥外に出ているブラシ触手間にペニスや玉袋まで丸ごと包み込める粘液まみれの水かき的な薄い膜が張っている構造を、\n緑はアナル&前立腺責め用にお尻をガッチリと捕まえる触手花と、その中心に前立腺をイジメ抜くイボイボ付き太め産卵管触手を、\n四恩は緑と同じ構造+肉塊卵産卵用の産卵管触手付きで\nまた触手咥内は大量の粘液を超乳の谷間に垂らし服がぴったり張り付いている描写(緑と常盤は服越しのピンク色透け乳首希望)を希望します\n\n三人とも両手が簡単に沈む程の、上半身が簡単に隠れるサイズかつ服越しに勃起乳首がわかる着衣超乳と\n妊娠を示す淫紋が下腹部に刻まれ完全着衣状態の特大着衣ボテ腹姿で、服の中にギチギチに押し込まれた超乳とボテ腹内で触手が蠢き波打っている様子と、\nできればpsd形式でON/OFF出来る感じで粘液塗れの触手の蠢く効果音と二人の瞳のハイライト有無、顔上部に掛かる影の有無、(優先度低で)触手なしの咥内差分と、\n粘液まみれの触手肉壁かダーク系の背景希望です\n\n優先度低で男を苗床にしているのは男の理想の女性型疑似餌を作って捕らえる巨大な肉塊の怪物で\n彼女達は男の好みを模して造られた意思なき肉人形に過ぎず、足や下半身等が肉壁や肉床などと融合している設定希望です\nもし上記設定で台詞あり差分(性格や口調はお任せします)で異形の姿に興奮するM男を心底見下し、\n苗床として永遠に搾精し卵を産み付けてあげる等の台詞ができれば希望します\n\nキャラ等参考：\n\nhttps://imgur.com/a/yGEb9rm", "nc": 185, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 104858, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "てぃむたま skeb募集", "screen_name": "timrj000", "avatar_url": "https://proxy.misskeyusercontent.jp/avatar/media.misskeyusercontent.jp%2Fio%2Fwebpublic-015d4fe5-a21f-4557-8372-cafc2a776af1.png?avatar=1", "header_url": "https://media.misskeyusercontent.jp/io/d5d9fc60-2dc4-4358-bb8a-f6cfbe8c945c.webp?sensitive=true", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "art"}, {"genre": "correction"}], "banned": false, "nc": 33}, {"id": 478097, "creator": true, "nsfw_acceptable": true, "acceptable": false, "name": "金麦のGO@C104 2日目 東サ-22a", "screen_name": "NICO_yt_GO", "avatar_url": "https://pbs.twimg.com/profile_images/1782431716394876928/BRhH0rQm.jpg", "header_url": "https://pbs.twimg.com/profile_banners/3190959998/1676561174/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "art"}, {"genre": "correction"}], "banned": false, "nc": 161}, {"id": 1240288, "creator"