=top&w=200&h=200&blur=200&s=bcdff123fa3bdc1999d99601a7fe0f7f", "src_set": ""}, "body": "初めまして。\nFANBOXのシノビリフレ飛鳥を拝見してご依頼させて頂きました。\n閃乱カグラの四季お願いします。\n\n企画物のバラエティ系AVに出演させられており。\nエッチな衣装でバイブ固定されてI字バランスチャレンジをさせられている状態。\n失敗して罰ゲーム受けた後の差分を頂きたいです。\n\n①挑戦中\n衣装は下記リンクのようなピンクポリス。\nhttps://pbs.twimg.com/media/GQ_Z4_vaQAE7ZKy?format=jpg&name=large\n\nバイブはこんな感じで衣装で固定されている描写をお願いします。\nhttps://www.pixiv.net/artworks/81092137\n\nポーズは下記リンクのようなＩ字バランスでピースサイン\n表情も同じ感じで得意げで余裕そうな様子。\nhttps://www.pixiv.net/artworks/122931903\n\n「このくらいよゆーよゆー☆」みたいな調子に乗った台詞\n\n②罰ゲーム後\n罰ゲームのおしおきセックスした後を映されている様子\nFANBOXの拓海のイラストのような感じで\n構図はそのまま表情と衣装だけ変わってる感じの差分をお願いします。\n\n服装はオープンショーツ１枚にさせられ\n乳首とパンツに使用済みのゴムが何個もつけられて辱められてる状態\n下記リンクのような感じでお願いします。\nhttps://www.pixiv.net/artworks/89383135\n\n表情も向井拓海の2枚目のように困り眉で笑う感じの表情をお願いします。\n\n「ちょ、ちょっとハズいかも///♡」みたいな\n恥ずかしいけどまんざらでもない感じのセリフ。\n\nお願いしたい要項は以上となります。\n細かい注文の多い依頼となってしまい恐縮ですが\nご検討よろしくお願いいたします。", "nc": 185, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@reacter996/works/37", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1268458, "client_id": 811345, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/9e6fbedd/uploads/origins/1aca5cb2-68fe-47da-8f24-0bf588874c3d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3033f947f3d57ee75c4370fe60227047", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/9e6fbedd/uploads/origins/1aca5cb2-68fe-47da-8f24-0bf588874c3d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=63bf8b82eb5316873ad8e10f6913bbfd", "src_set": ""}, "body": "京」を描いてください：\nhttps://drive.google.com/file/d/1l0vvZsaE8fX31ATfNuvsqde59eOmWeSc/view?usp=sharing\nhttps://drive.google.com/file/d/1j-PItRWzZ097GZpFjK_MTBq7wY49Vnud/view?usp=sharing\n乳首が逆で、少しぽっちゃりしています。身長は300cmです。この衣装は無視してください！\n\nhttps://drive.google.com/file/d/1nlYvhCvwLxXUPkqKkDzcW5142ed6Q72Z/view?usp=sharing。\n\nヘアピンとヘアボウもお願いします: https://drive.google.com/file/d/1ck70_wrrv0cMNT3HDYQ-wqAZCYWwsU3y/view?usp=sharing\n\n彼女のおっぱいは垂れて、重くて、大きくて、ビキニから落ちている。パンティから見える黒くて太い陰毛。ふっくらとした魅惑的な唇で彼女を描く。\n汗ばんだ重い胸の谷間を広げて、パイズリ／おっぱいファックに誘う彼女を描こう。https://drive.google.com/file/d/1Z9sWB6A_nQ5xuMr3CLnEsPF0kzobfei7/view?usp=sharing", "nc": 33, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@reacter996/works/36", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/eab583bd/uploads/origins/18118f3c-54ec-4272-8f30-108ecdc2f27f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=43ff40a1e858028a7048267e9b6b1691", "src_set": ""}, "private": true, "genre": "art", "tipped": true, "creator_id": 1268458, "client_id": 2504981, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 177, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@reacter996/works/35", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1268458, "client_id": 3354435, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/24568f85/uploads/origins/1acc3d78-f16e-463d-ad8d-841a6c091f1b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1b2f1949993861c3f07b423705518118", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/24568f85/uploads/origins/1acc3d78-f16e-463d-ad8d-841a6c091f1b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=73a0559d4d1fdfcfb2f56b934ead5801", "src_set": ""}, "body": "はじめまして。\nかなり特殊な内容ですが、リクエストさせていただきます。\n\nいわゆるよその子になりますが、\n武田弘光先生の描かれているキャラで、蒼宮瑞波をお願いいたします。\n(https://www.pixiv.net/artworks/82371899  P10)\n\nシチュエーションとしては、女児服を無理やり着せられて\nドラッグストアでこの後使う予定のオムツと浣腸液を\n一人で買いに行かされて会計をしている、という羞恥シチュをお願いします。\n\n女児服についてデザインはお任せしますが、\nギリギリ入店拒否されないかなというくらいには性器や胸が隠れていてほしいです。\n表情は恥ずかしさ半分、悔しさ半分といった感じで、髪型はお任せいたします。\n\nもし差分可能でしたら、\nアダルトショップでディルドやアナルビーズを買わされているシーンもお願いいたします。\n\nご検討のほどよろしくお願いいたします。", "nc": 185, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@reacter996/works/34", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/8d09b597/uploads/origins/eb2b99b1-35c6-4f57-9ad4-bf51f9003f36?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=021280cd4bac66ded18d1bd246afbe63", "src_set": ""}, "private": true, "genre": "art", "tipped": false, "creator_id": 1268458, "client_id": 2730344, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 49, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@reacter996/works/33", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/506efc31/uploads/origins/7122e0b0-fdec-4108-a8d5-873b82de59f3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=47f74e7e21a412b705cee6cb6f7076f5", "src_set": ""}, "private": true, "genre": "art", "tipped": false, "creator_id": 1268458, "client_id": 0, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 49, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@reacter996/works/32", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/e1f9a2d7/uploads/origins/9e002221-db96-4e72-b8db-f77feebf008c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=a154f4cba0ee9abef0e00ed45dd38289", "src_set": ""}, "private": true, "genre": "art", "tipped": false, "creator_id": 1268458, "client_id": 0, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 160, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@reacter996/works/31", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1268458, "client_id": 1537783, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/5e68b946/uploads/origins/f4fb358d-dcec-41a8-9d4d-7d2f5ed78254?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6d253f91fa20b7ba72c905d94fe26243", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/5e68b946/uploads/origins/f4fb358d-dcec-41a8-9d4d-7d2f5ed78254?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=1ea8229c4d147a613992d3c049225f34", "src_set": ""}, "body": "いつもイラスト拝見させて頂いております。\n先生の↓のイラストがとても好きです\nhttps://x.com/AANtapl0izZV1rh/status/1822289887946563587\n是非、うちのオリジナルキャラクターもメス牛奴隷にして頂きたいです\n\nうちの子ですが下記URLの子になります\n肌は色白、金髪で毛先は赤、碧眼で、身長は173cmほどの娘です\n腹筋は引き締まっており、下の毛はパイパンです\nhttps://imgur.com/gallery/uYXOf77\n他の方に描いて頂いたイラストですが、著作権は購入済みです\nたくさんミルクが出そうな乳肉に盛って頂きたいです\n\n牛柄マイクロビキニと牛柄の手足ストッキングを着せてください。\n奴隷っぽい首輪を付けて頂けると嬉しいです\n\n身体のどこかに\n奴隷を表す「Milk Slave」\n彼女の名前である「Britannia」\nスリーサイズである「B106（96に斜線を引いて106に訂正するように表記してください）-W58-H91」　※ミルク奴隷にされてから乳肉が肥大化したことを表している\n下腹部に淫紋の焼印　をそれぞれ刻んで頂きたいです　※淫紋のデザインはお任せします\n\n構図等については↓の作品の様に\n正面から乳肉をもみもみされている感じでお願いします\nhttps://x.com/AANtapl0izZV1rh/status/1793948690262241451\n彼女は屈辱的な表情を浮かべながらも、抵抗できずに乳房を嬲られることしかできません\nずれたマイクロビキニからは勃起した乳首が零れ、母乳を滴らせています\n\n台詞については\n「……ッッ♡！」\n「…あ”っ…お”ぉ”っ♡」のように我慢しても喘ぎ声が漏れ出ている感じでお願いします。\n\n\n以上、ご検討よろしくお願いします\n\nhttps://imgur.com/gallery/uYXOf77", "nc": 40, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@reacter996/works/30", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1268458, "client_id": 1068227, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/15a6b591/uploads/origins/4c7cc067-9578-42a7-9e04-eb8bc4f36b46?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6ef7dbf64efd8d53d542488ccec1ebb0", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/15a6b591/uploads/origins/4c7cc067-9578-42a7-9e04-eb8bc4f36b46?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5c46d8404f5a664d960fc4a5ea0f8c37", "src_set": ""}, "body": "初リクエスト失礼します！以前描かれていた天堂真矢のイラストを拝見してリクエストさせて頂きました！\n少女☆歌劇レヴュースタァライトの星見純那がボテ腹枕営業をするセリフ付きイラストをお願いします！\n・シチュエーション\n聖翔卒業後の留学先で知り合った黒人舞台監督の愛人になり淫らな行為を繰り返す日々を送る(既に2人出産経験がありお腹にはQoSと出産歴を表すタトゥーがある)という設定でお願いします！\n・爆乳、陰毛有り\n・竿役は筋肉質で顔の細かい描写は無しで構いません。\nハード目な内容と拙い文章で申し訳ありませんがご検討よろしくお願いいたします！", "nc": 176, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@reacter996/works/29", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/daa1d34b/uploads/origins/794ec902-8ede-4fd5-9631-4feaac0b96d8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=2a5fb1104eea5c5463fadc2296d8b577", "src_set": ""}, "private": true, "genre": "art", "tipped": true, "creator_id": 1268458, "client_id": 2737687, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 161, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@reacter996/works/28", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1268458, "client_id": 638851, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/9e695b47/uploads/origins/800ae582-8191-483c-bf15-3d66da194f2d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f920943a7f710431806bde65a5002548", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/9e695b47/uploads/origins/800ae582-8191-483c-bf15-3d66da194f2d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0e0aaaa31c124016336cff0bbe99eba0", "src_set": ""}, "body": "初めまして、依頼します。\n\n【キャラ】\n戦姫絶唱シンフォギア　マリア・カデンツァヴナ・イヴ\n\n【シチュ】\n怪盗ギアをまとって怪盗をしていて，呪われた絵画から飛び出してきた触手に捕まり、絶頂させられて脱出もできず敗北しているのを鑑賞されるシチュ\n\n呪われた絵画の例\nhttps://ci-en.dlsite.com/creator/186/article/18832\n\n【服装】\n怪盗ギア\nギアの出力を下がってフリル等が消え、インナーのレオタード部のみになっている\n股間や胸部などは破られている。\n\n【描写】\n四肢を拘束されて、体をいいように開発され感じされられている感じでお願いします。\n二穴攻めされている\n乳首を引っ張られている\n触手で目隠しされる\nクリトリスを引っ張られる\n突き出た舌に触手が巻き付く\nなど\n\n拘束には若干体を動かせる余地があるが，快感で体をよじらせることしか\nできないみたいな描写でお願いします。", "nc": 56, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@reacter996/works/27", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1268458, "client_id": 2646958, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/01f77353/uploads/origins/34608cd4-d0e5-44d5-be1c-b60a02bd32a0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5515a574fd8465d184bcbab34eefcd49", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/01f77353/uploads/origins/34608cd4-d0e5-44d5-be1c-b60a02bd32a0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=71c88f1a736d1af0b5cf42806c262257", "src_set": ""}, "body": "拘束されてディルドで疑似イラマ拷問される刀使ノ巫女の獅童さんをおねがいします！\n細かな希望と流れは以下の通りです。\n\n・拘束された獅童さんが男から要求されたフェラチオを拒否→シリコン製のディルドを突っ込まれて長時間放置（意識が朦朧とする中、唸り声を上げて目を見開きながら助けを懇願する）→嘔吐寸前の粘度の高い唾液を口から垂らして、おびえた目で必死に作り笑いをしながら、言いなりになることを誓う\n\n・拘束・ディルドの仕様は画像の様にお願いします！(拘束方法はなんとなく思いついたものなのでピンク色の何か様の中で描きたいものがあればそちらを優先していただいて構いません！)\nhttps://x.com/dokuro459/status/1784912472388010487\n\n・日頃の鍛錬に自信と誇りを持ってる獅童さんが、アダルトグッズのシリコンディルド1つで死にかけるっていうシチュエーションが見たいです\n\n・以前納品していただいた際に差分などがクリスタではちゃんと表示されなかったので、JPG形式で納品していただければ幸いです。\n\nお忙しいところ恐縮ですがご検討いただければ幸いです\n\nhttps://x.com/dokuro459/status/1784912472388010487", "nc": 185, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@reacter996/works/26", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1268458, "client_id": 0, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/b46d959b/uploads/origins/1fbfcf30-d449-44fd-a504-5ab960815c52?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2d8f9e8273b4e8fc0790836e8fcb98e8", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/b46d959b/uploads/origins/1fbfcf30-d449-44fd-a504-5ab960815c52?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=eb6efd421746a9715679548b89f957cd", "src_set": ""}, "body": "シャニマスの冬優子でリクエストさせていただきます\n先日公開されたショートカット冬優子のようなIFというシチュエーション(https://twitter.com/imassc_official/status/1793114568002355582?t=r9JWv73v9V8p5haDIJr2vA&s=19)\nで、黒人チンポに堕ちて事務所も283プロから黒人が経営する外資系企業へと移籍、しかも社長夫人として娶られてしまう。\n構図としては冬優子がQoS(クイーン・オブ・スペード)のタトゥーが大きく彫られた尻を黒人チンポに向けて突き出し、男の方に向けて振り返っている感じでお願いします\n参考資料\n(https://www.pixiv.net/artworks/118771090)\n(https://www.pixiv.net/artworks/118737746)\n\n格好はショートカット\n(https://pbs.twimg.com/media/GOF6giTaYAEev8c?format=jpg&name=large)\n(https://s.inside-games.jp/imgs/p/6KrKB_I-GbaTEBWLec5LLcMLiAcGBQQDAgEA/1352990.jpg)\nに金ビキニといった風にしていただきたいです。\n\n台詞はなしで、フユコ・ブラウン(2X)みたいな感じで黒人の嫁になったことが分かる簡易キャプションや冬優子が移籍後に売れたなどの情報をのような記載してもらえると嬉しいです", "nc": 176, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@reacter996/works/25", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1268458, "client_id": 3235212, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/8a23bbee/uploads/origins/83a57030-bfec-42e2-aa0a-6d02d31123fe?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=317fde1d84482a1610d664d44c298045", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/8a23bbee/uploads/origins/83a57030-bfec-42e2-aa0a-6d02d31123fe?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3ba0505bf194d622a436d201f822a318", "src_set": ""}, "body": "申し訳ありませんが、より明確に理解していただけるように書き直すことにしました。お手数おかけいたしますが、ご検討いただけますと幸いです。\n\nリクエストのキャラクターはFGOよりモルガンです。登場情報は以下を参考にしてください。\nhttps://www.pixiv.net/artworks/101827671\n\n営業お姫ちんちのような白背景のシンプルな胸像を希望します。男のペニスが彼女の顔の横にあり、フェラチオを期待している。彼女は恥ずかしくて嫌悪感を感じたので、頭を少し横に向けるが、それでも片手でペニスを握っている。もちろん、素敵な乳首を描いてほしいです。\n\nまた、数日前にあなたのスケッチを見ましたが、アルトリア・ペンドラゴンだったと思います。二人はちょっと似ているので、モルガンも上手に描けると思います。\n\n私のリクエストを検討していただきありがとうございます、好きな言葉や詳細を自由に追加してください！", "nc": 32, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@reacter996/works/24", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1268458, "client_id": 528544, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/e035dc32/uploads/origins/64b841c9-155f-476e-a876-cd9fb4ef2f67?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0699f0911ea4546d27376a591f823ca1", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/e035dc32/uploads/origins/64b841c9-155f-476e-a876-cd9fb4ef2f67?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=74f344ffdfee718495f02cb1e3785026", "src_set": ""}, "body": "初めまして、リクエストを希望します。\n\nキャラクター\nKOS-MOS　ver.4（作品：ゼノサーガ3)\n\nシチュエーション\n服装は半裸程度で出来ればヘッドギアは外さない形で。\n薄暗い寝室で男と手を繋ぎながらの正常位ピストンと膣出しで\n無表情やアヘ顔など出来る範囲でいいのでお願いしたいです。\n\n参考資料URL\nhttps://alter-web.jp/products/331/\nhttps://www.kotobukiya.co.jp/product/detail/p4934054105991/\n\nhttps://www.bandainamcoent.co.jp/cs/list/xenosaga3/character/kosmos.php", "nc": 33, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@reacter996/works/23", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/cbb64db9/uploads/origins/6ad5b6d2-26a1-41eb-b2ef-dbd794ff248f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=a25a874920d906169ca35c9725a30635", "src_set": ""}, "private": true, "genre": "art", "tipped": true, "creator_id": 1268458, "client_id": 643939, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 48, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@reacter996/works/22", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/1026fdb4/uploads/origins/1ef95e25-f829-4487-8392-d139fbc70624?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=50edb4dfeca9e4b5e70958f779c92b28", "src_set": ""}, "private": true, "genre": "art", "tipped": true, "creator_id": 1268458, "client_id": 643939, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 176, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@reacter996/works/21", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1268458, "client_id": 0, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/7b6ed50b/uploads/origins/1b1c48f4-5ca5-46a2-a360-f256035f8373?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b6114652fe9c3aacfce3884ca65dc520", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/7b6ed50b/uploads/origins/1b1c48f4-5ca5-46a2-a360-f256035f8373?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ed6fa61619c028184e2d7b253f48f622", "src_set": ""}, "body": "シャニマスの咲耶に生えてしまったチンポを恋鐘がセックスで鎮めてあげるイラストをお願いします。\n\nシチュエーションは二人での仕事が終わって楽屋で休憩している際に、少し前に生えてきた咲耶のチンポが勃起、苦しそうな咲耶を見て恋鐘が自分の体で慰めているといったものです。\n咲耶は恋鐘で童貞喪失、2,3回恋鐘と体を重ねており、恋鐘はプロデューサーとも経験済みという設定です。\n\n構図は以下のように後背位で突いている様子をお願いします。資料では竿役が見切れていますが咲耶の顔も見えるようにして下さい。\nhttps://www.pixiv.net/artworks/104173019\n咲耶がガニ股なのはその方が安定するからという理由です。\n\n体型はそれぞれ以下のようにお願いします。\n■咲耶：過去に描かれていました佐切のようにバキバキにならない程度に締まった体と爆乳でお願いします。太ももや尻はムチムチとしたイメージです。\nhttps://www.pixiv.net/artworks/108795775\n後述の構図で咲耶チンポは見えませんが凶悪なデカチンという設定です。\n■恋鐘：咲耶よりも大きな胸と尻でお願いします。こちらはムチムチ全開のイメージです。\n\n服装はゲーム公式HPの普段着を着させてください。\nhttps://shinycolors.idolmaster.jp/idol/lantica/kogane.html\n■咲耶：上着のシャツだけ着用させ、前部分を止めず胸が見えるようにお願いします。\nネクタイ、スカート、下着は不要です。\n■恋鐘：胸分のボタンを開け、胸が見えるようにして下さい。スカートは腰部分までめくり上がらせて尻が見えるようにお願いします。下着は不要です。\n\n可能であれば場面に応じた表情とセリフの差分をお願いします。\n\n始まり\n咲耶は恋鐘のほうに視線を向け、笑顔ですが恋鐘を気遣い少し申し訳なさそうな表情を浮かべさせて下さい。\n恋鐘も顔は正面ですが意識と目線は後方の咲耶を気遣うようにお願いします。表情はいつもの快活な笑顔を浮かべさせて下さい。\n■咲耶：こんなことになって本当にすまない……\nただ、この後も仕事があるから…… 恋鐘、力を貸してくれるかい……？\n■恋鐘：あったりまえばい！うちの中でびゅーびゅーしてスッキリするとよか！\n……でも顔は見んとってね？まだ咲耶とするのちょっぴり恥ずかしいけん……\n\n数時間経過後\nお互いの体の相性の良さですっかりチンポに支配された二人の様子をお願いします。\n咲耶は視線を真っ直ぐに向け、歯を食いしばり鼻息荒い表情でお願いします。\n恋鐘は視線は真っ直ぐにアヘ顔でお願いします。\n■咲耶：んおっ♡ 恋鐘マンコくそやべぇ♡♡ チンポ蕩ける♡♡\n…このオナホ女、絶対私のものにする♡♡ アイツ（ルビでプロデューサー）になんか渡さない！\n■恋鐘：おほぉっ♡♡ だめばい♡♡咲耶～～っ♡♡\nごめんプロデューサー……♡ うちこのままやと咲耶のコキ捨てティッシュにされてしまうばい……♡♡\n\n色々盛り込んでしまいましたがご検討頂けますと幸いです。\nよろしくお願いいたします。", "nc": 177, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}], "similar_creators": [{"id": 9672, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "おやさい", "screen_name": "yasai_023", "avatar_url": "https://pbs.twimg.com/profile_images/1949040557629861888/uq06DgqN.jpg", "header_url": "https://pbs.twimg.com/profile_banners/2611641907/1735468704/1500x500", "appeal_receivable": true, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 2, "skills": [{"genre": "art"}], "nc": 48}, {"id": 507956, "creator": true, "nsfw_acceptable": true, "acceptable": false, "name": "きりん🔞", "screen_name": "Kirin142", "avatar_url": "https://pbs.twimg.com/profile_images/1831001666306359296/It5qmePh.jpg", "header_url": "https://pbs.twimg.com/profile_banners/948158564874436608/1725379889/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "skills": [{"genre": "art"}], "nc": 176}, {"id": 662043, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "SZNH", "screen_name": "ihsuzanuh", "avatar_url": "https://pbs.twimg.com/profile_images/973617826014511109/TWZAmWyp.jpg", "header_url": "https://pbs.twimg.com/profile_banners/973612978841968640/1595936361/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "skills": [{"genre": "art"}], "nc": 161}, {"id": 665782, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "けものの★＠『はれんちポリス_バトン&レッカー』DLsiteやFANZAなどで販売中★", "screen_name": "kemonono3", "avatar_url": "https://pbs.twimg.com/profile_images/5295638