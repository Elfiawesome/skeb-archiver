ad7c/uploads/origins/80de4320-bfd9-40bb-b52e-23a35ee0abf7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a9ea069ce78c9d5262960ad4db809ae9", "src_set": ""}, "body": "初めまして。いつもイラスト拝見させていただいております。\nPixivにて「やはり俺の青春ラブコメはまちがっている。」の雪ノ下雪乃を拝見し\n大変煽情的で素晴らしかったので、リクエストさせていただきます。\n\n催眠・洗脳・常識改変の類が好きなので、ニッチな内容で大変恐縮ですが\nご検討いただけますと幸いです。\n\n【キャラクター】\n「やはり俺の青春ラブコメはまちがっている。」の雪ノ下雪乃でお願いいたします。\n\n【シチュエーションについて】\n常識改変のシチュエーションでマッサージと言いつつ\n体外式ポルチオマッサージを受けてしまい、その虜になっていく雪ノ下雪乃をお願いいたします。\n仰向けでマッサージを受けるためのラフな格好（もしくは制服半脱ぎなど。）で\n催眠状態になりながらマッサージを受け、自ら求めてしまうといった感じでお願いいたします。\n\n<絵にしなくてもいい設定やあらすじです>\n既に堕ちている由比ヶ浜結衣から、日頃の疲れをとるためにとマッサージ店を紹介される。\n結衣からの紹介とあり気を許していく中、催眠効果のあるアロマやマッサージを受け\n催眠状態にさせられ、体外式ポルチオマッサージを受け堕とされていく。\n\n【入れてほしい表現など】\n催眠・洗脳が大変好きなので虚ろ目であると大変嬉しいです。\nまた、可能な範囲でかまわないので、快感や催眠で堕ちていく過程が\nセリフや表情差分などで見られますと大変嬉しいです。\n\n以上になります。要望が多く大変申し訳ありませんがもし気に入ればご検討いただけますと幸いです。\nよろしくお願いいたします。", "nc": 57, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@reacter996/works/49", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/4a34c6c4/uploads/origins/bd21de14-d099-43d1-9414-2ce4c9305384?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=b3e920952ed2d750611bc23b4dacbb16", "src_set": ""}, "private": true, "genre": "art", "tipped": true, "creator_id": 1268458, "client_id": 38653, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 161, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@reacter996/works/48", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1268458, "client_id": 0, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/ab0a6f0b/uploads/origins/d668f4d0-9fbe-4102-b030-14ffdac7872c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c99bf8607b310901af99b3461f6d085e", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/ab0a6f0b/uploads/origins/d668f4d0-9fbe-4102-b030-14ffdac7872c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=bd5b6ad8a6fea92c36be10a7687235f7", "src_set": ""}, "body": "リクエストを送らせていただきます！\n\nキャラクターは俺ガイルの雪ノ下陽乃をお願いします。\n\nシチュエーションは\nhttps://www.pixiv.net/artworks/127971826\nのようにショタに弱みを握られて恥ずかしい自己紹介をさせられているようなシーンをお願いします。\nショタは背景やデフォルメだったり台詞だけだったりどんな登場のしかたでもいいです。\n\n衣装は上裸でパンツ一丁の姿、\nポーズはがに股蹲踞にピースか両手を頭の後ろに回した状態でお願いします。\n\n何卒よろしくお願いいたします！", "nc": 184, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@reacter996/works/47", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/d55622e2/uploads/origins/6d9469de-269b-4de1-99cf-d26ff2920379?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=b57bb113a0c2d84601d2e9218a2ef1dd", "src_set": ""}, "private": true, "genre": "art", "tipped": false, "creator_id": 1268458, "client_id": 225699, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 32, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@reacter996/works/46", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1268458, "client_id": 0, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/c85b0480/uploads/origins/e007e8ff-e300-4a64-84ef-6a56bc98de56?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a64fba5e88cae09e0392efd987602cc8", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/c85b0480/uploads/origins/e007e8ff-e300-4a64-84ef-6a56bc98de56?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5aa13a9b57943b6a987dc1d8e246526a", "src_set": ""}, "body": "SSSS.GRIDMANの宝多六花をお願いしたいです\n制服姿も素敵なのですが、今回はこのアズレンコラボの衣装やフィギュアのシチュでお願いできないでしょうか？\n勿論、制服姿の方が良いのであればそちらでも構いません\nhttps://www.amiami.jp/top/detail/detail?scode=FIGURE-172221\n\nシチュエーションは、こちらのフィギュア(アズールレーンコラボ)のように柵に座りながら待ち合わせをしているシチュで、なんとノーパンで待っている、という内容\n\n①彼氏(セフレ？)との待ち合わせで「おそーい💙」という感じのセリフで柵に座りながらノーパンのお股をパカっと開脚。遅刻してきた彼氏を叱らずむしろ興奮させる優しい六花\n②①と同じ構図ですが、今度は遅刻している間にエロガキにナンパされその場でセックス、精液まみれの姿で満足げにオマンコを見せつけるビッチ六花(隣にエロガキがニヤニヤしながら立っていると嬉しいです)の寝取られ報告シチュ\n\n厳しい場合は②をメインで描いて頂けますでしょうか。\nその場合は初めから寝取られていますので、おっぱいなんかも剥き出し(もしくはマイクロブラで乳輪がはみ出すようなもの)にして頂けると嬉しいです。要は好きにドエロイ格好にして頂けるとはかどります。\n陰毛はあった方が好みです。\nセリフ等はお好きに弄ってください。ご検討をお願いします。", "nc": 168, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@reacter996/works/45", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1268458, "client_id": 52428, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/b0e8807a/uploads/origins/b1e0396e-5c06-4118-9ef1-ba55056e8277?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3e7860ce1af878a35a330f058e7bb0e1", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/b0e8807a/uploads/origins/b1e0396e-5c06-4118-9ef1-ba55056e8277?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5db580d38c1c727dbfb5da8eeb74e436", "src_set": ""}, "body": "桃色幾何さんの高町なのはさんじゅうきゅうさいの作品を背景いたしまして是非とも描いて頂きたいと思いまして連絡いたしました。\nご都合と金額がよろしければお願い致します。\n\nキャラクターはリリカルなのはStrikerSの高町なのは\nシチュエーションは高官好みに胸と乳首を大きく改造されて感度も爆上げの状態にされたなのはが後ろから爆乳揉まれたり、長乳首をしごかれて母乳を吹きまくるでお願いします。\nポーズは両手を頭の後ろに組みつつガニ股のポーズで、衣装につきましてはピッチリとした質感のバリアジャケットでおねがいします。\n金額内で可能でありましたら、乳首と局部をハート型に切り抜いた差分もありますと助かります。\n以上要望が多くなってしまいまし恐縮ですがご都合と金額がよろしければお願い致します。\n\nhttps://drive.google.com/drive/folders/1rE4r2QeTP8c3oVjQloWs9qedUUHFtA1r", "nc": 161, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@reacter996/works/44", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1268458, "client_id": 0, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/0b45573d/uploads/origins/d992f3ca-72b1-4012-a703-0df10c4fe300?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7e0c958cedf0ae05990269133c195a88", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/0b45573d/uploads/origins/d992f3ca-72b1-4012-a703-0df10c4fe300?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=1a42095e5f4b5f7372abcbbbf8271957", "src_set": ""}, "body": "公衆便女シチュで創彩少女庭園の「一条星羅」をお願いします。\nhttps://sousaishojoteien.com/character/ichijo-seira/\n\n汚い男性用トイレの小便器内にM字開脚で座り、両手にデカチンを握りながら生ハメ中出しされてアヘ顔\n結合部やアナルから精液を噴きこぼし、下腹部は僅かにポコっとする程度に精液ボテ状態\n全身精液でドロドロ、口元や谷間・アソコ周りに男の抜け陰毛こびりつき\n\nブラウスをはだけさせられてノーブラおっぱい丸出し\n下着はオープンクロッチのエロ下着、陰毛は濃く広範囲\n髪や乳首、下着に使用済みゴムを沢山ぶら下げ\n下腹部と太ももに\n「妊娠確定まんこ」「交尾中毒メス犬」「精液専用便女」\nの落書き\n\n体型は爆乳デカ尻＆ムチムチにしてください。\n落書きはレイヤ分けでオンオフできるようにして頂ければ幸いです。\n\nご検討のほどよろしくお願いします。", "nc": 32, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@reacter996/works/43", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/e42f4357/uploads/origins/a68e6701-420b-4032-991f-086ecc1a2b8b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=0a0a6ac851ce6e4cf76b30ceaa3b843c", "src_set": ""}, "private": true, "genre": "art", "tipped": false, "creator_id": 1268458, "client_id": 0, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "c