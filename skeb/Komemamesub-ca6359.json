crop=top&w=200&h=200&blur=200&s=76a57f2aef928291294d00878d2f3f28 2x, https://si.imgix.net/601b062c/uploads/origins/8cac27e7-14ed-4b8e-8209-c2594480c369?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=50b844b42389854d455b99ac4fc971c3 3x"}, "body": "こめまめさんこんにちは！　すなじろと申します。\nいつもかわいいリンレンやSkebのイラストとても楽しみにしております！\nパステルで柔らかな色使いに朗らかで暖かな気持ちになれる表情・ポージングがとっても好きです……！\n\n今回サブスケブを開設されたとのことで、もし宜しければうちの子であるノラちゃんを描いていただきたいです！\n資料が過去のSkebリクエストのみであることをご容赦ください。\n\nノラちゃんは、狐をモチーフとしたけもみみの女の子です。\n年齢は10代半ばくらいで、大きなしっぽと八重歯がチャームポイントです。\n少しジト目気味な青い目と、ふわふわ癖っ毛なボブくらいの髪の毛が特徴で、トレードマークの青い眼鏡をおでこにひっかけています。\n普段の服装は青いパーカーに黒のハーフパンツで、ややオーバーサイズな服装を好んで着ます。\n性格はおっとりとしていていつも眠そうにしており、やる気のないジトッとした目つきをしていますが、ノリはよく朗らかで、不思議なポーズや笑顔の似合う子です。\n\n描写範囲、頭身、構図やデフォルメ具合等お任せします。\n可能であれば衣装を好きなようにアレンジしていただきたい&立ちポーズでも座りポーズでもよいので概ね全身描写されていると嬉しいです。\n\nその他の事項はお任せします。\n頂いたイラストは自身の保有するSNS等のアカウントで、アイコン・ヘッダーとして使用することがあります。\nよろしくお願いします！\n\nhttps://skeb.jp/@sunajiro8", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 301956, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "🌱ししとう🌱", "screen_name": "774_10", "avatar_url": "https://pbs.twimg.com/profile_images/2060328484950687744/K7jl0_zz.jpg", "header_url": "https://pbs.twimg.com/profile_banners/2776333296/1782085465/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 120, "skills": [{"genre": "art"}, {"genre": "correction"}], "banned": false, "nc": 0}, {"id": 2985836, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "牛ちゃん", "screen_name": "ushichansama", "avatar_url": "https://pbs.twimg.com/profile_images/2048420845060775936/2KyRZDo7.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1749370409424924672/1759373841/1500x500", "appeal_