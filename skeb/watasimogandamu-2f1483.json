な所。", "nc": 41, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@watasimogandamu/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 410900, "client_id": 1192514, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/e81917fa/uploads/origins/1a7aacde-45c4-455b-9b3d-e40f5e3404ef?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=44baa51db1f34c769ce89572adb0ea60", "srcset": "https://si.imgix.net/e81917fa/uploads/origins/1a7aacde-45c4-455b-9b3d-e40f5e3404ef?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=44baa51db1f34c769ce89572adb0ea60, https://si.imgix.net/e81917fa/uploads/origins/1a7aacde-45c4-455b-9b3d-e40f5e3404ef?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=3f60efd0e22a1ad316819e1fbbfd4bbc 2x, https://si.imgix.net/e81917fa/uploads/origins/1a7aacde-45c4-455b-9b3d-e40f5e3404ef?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=06fe1c4fc235176d6003845f0162ae50 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/e81917fa/uploads/origins/1a7aacde-45c4-455b-9b3d-e40f5e3404ef?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=4e60b18742bf63e0bb88be6b7ebdad44", "srcset": "https://si.imgix.net/e81917fa/uploads/origins/1a7aacde-45c4-455b-9b3d-e40f5e3404ef?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=4e60b18742bf63e0bb88be6b7ebdad44, https://si.imgix.net/e81917fa/uploads/origins/1a7aacde-45c4-455b-9b3d-e40f5e3404ef?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=c91a575544e41bf039eb4a800e462990 2x, https://si.imgix.net/e81917fa/uploads/origins/1a7aacde-45c4-455b-9b3d-e40f5e3404ef?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=b9751dd379a725246536a6767cec8d6d 3x"}, "body": "こんにちは！水無月が蜘蛛の巣の繭に包まれているイラストをお願いできますか？『水無月憚3』の蜘蛛CGの「もしも」シナリオとして想像しています。\n\nシーンは『モンスターバスター』の大蜘蛛CGのように、ヒロインが蜘蛛の巣繭にきつく拘束されている様子で。頭部・乳房・股間は露出させてください。母乳と愛液が滴っている状態です。蜘蛛本体の描写は不要です。可能であれば、妊娠したお腹のバリエーションもお願いします。よろしくお願いします。", "nc": 49, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 27095, "creator": true, "nsfw_acceptable": true, "acceptable": false, "name": "ライス大森", "screen_name": "note_black0125", "avatar_url": "https://proxy.misskeyusercontent.jp/avatar.webp?url=https%3A%2F%2Fmedia.misskeyusercontent.jp%2Fio%2Fcd0dc16b-2e4a-4278-9e9c-81bc600d4e1a.png%3Fsensitive%3Dtrue&avatar=1", "header_url": "https://media.misskeyusercontent.jp/io/a58ceb0f-e145-4222-9214-dcaa01e6445d.png", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 120, "skills": [{"genre": "art"}, {"genre": "correction"}], "banned": false, "nc": 32}, {"id": 65815, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "ばいでん_skeb募集中", "screen_name": "byden_i3", "avatar_url": "https://pbs.twimg.com/profile_images/2013238423281098752/1p0Z-Fyo.jpg", "header_url": "https://pbs.twimg.com/profile_banners/895632823809302530/1770475633/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "art"}, {"genre": "correction"}], "banned": false, "nc": 176}, {"id": 111026, "creator": true, "nsfw_acceptable": true, "acceptable": false, "name": "羅ぶい", "screen_name": "bui52", "avatar_url": "https://pbs.twimg.com/profile_images/1871553121312448514/F0QLYJSg.png", "header_url": "https://pbs.twimg.com/profile_banners/407531085/16575083