ogle.com/drive/folders/1eHceS03j0FtZD-fVntdI0V4TMmKqqJhe?usp=sharing\nPinterestの衣装ボードのインスピレーション : https://www.pinterest.com/cindy_weres/spade-board/\n\n\n彼は高慢でプライドが高いが、悲しげで不機嫌に描いてもいい。何でもいい。\n\nhttps://imgur.com/a/16AEscm", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@goichi0521/works/8", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2410256, "client_id": 2850170, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/eb04e332/uploads/origins/8eb16b2b-621c-4303-87f9-2805be55698b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=59ceeb4fe81c57640d8ffb172a417594", "srcset": "https://si.imgix.net/eb04e332/uploads/origins/8eb16b2b-621c-4303-87f9-2805be55698b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=59ceeb4fe81c57640d8ffb172a417594, https://si.imgix.net/eb04e332/uploads/origins/8eb16b2b-621c-4303-87f9-2805be55698b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e0ec90e100431f2fa66c86cfcbb80f79 2x, https://si.imgix.net/eb04e332/uploads/origins/8eb16b2b-621c-4303-87f9-2805be55698b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c291170c9ed5de0f0e4e8aad00802aae 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/eb04e332/uploads/origins/8eb16b2b-621c-4303-87f9-2805be55698b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c39be1d4b49043170490615e379bfe5f", "srcset": "https://si.imgix.net/eb04e332/uploads/origins/8eb16b2b-621c-4303-87f9-2805be55698b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c39be1d4b49043170490615e379bfe5f, https://si.imgix.net/eb04e332/uploads/origins/8eb16b2b-621c-4303-87f9-2805be55698b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=484361e323b6c22803bc6161b492ed23 2x, https://si.imgix.net/eb04e332/uploads/origins/8eb16b2b-621c-4303-87f9-2805be55698b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=b2c50a2fa31b01e939ef2e8514237d6d 3x"}, "body": "初めまして。ごいちさんの透明感溢れる素敵な絵柄に一目惚れしました…！Skebを開かれているとのことで是非私のOCを依頼させていただきたく思います。\n\n当キャラクターは自分をヒトだと思い込んでいるアンドロイドの悪役です。性別は不明ですが、ビジュアルは若干女性寄りで描写しています。\n\n目つきの悪いビジュアル(デフォルトです)やにこにことしたビジュアルなどがありますが、時間軸が違うだけの同一人物ですのでどのビジュアルを描いていただいて構いません。詳しい説明や資料は添付しているGoogleドライブに載せています。\nポーズや表情などもごいちさんの描きやすいように描いていただければと思います。血液や口の中の色は青色です…！\n\nラフや加工前、練習絵等がありましたらPSDデータ内に入れていただけると大変嬉しいです。\n\nご検討のほどよろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/1avGZBQginKJYr3NYEzxgNOgWAPWxULQk", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@goichi0521/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2410256, "client_id": 2563927, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/a3a51d96/uploads/origins/a85a395d-14ca-48da-9c4b-ae7f0d27dacc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5e274fb38e8be9b1e3de8633ff73fe13", "srcset": "https://si.imgix.net/a3a51d96/uploads/origins/a85a395d-14ca-48da-9c4b-ae7f0d27dacc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5e274fb38e8be9b1e3de8633ff73fe13, https://si.imgix.net/a3a51d96/uploads/origins/a85a395d-14ca-48da-9c4b-ae7f0d27dacc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=fb540baf065d8650cd6aee86b79f492c 2x, https://si.imgix.net/a3a51d96/uploads/origins/a85a395d-14ca-48da-9c4b-ae7f0d27dacc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=9bc251348b6d3d51e13f9a3083e000c5 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/a3a51d96/uploads/origins/a85a395d-14ca-48da-9c4b-ae7f0d27dacc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ae271135db9c6f71f808b1a6f56668d3", "srcset": "https://si.imgix.net/a3a51d96/uploads/origins/a85a395d-14ca-48da-9c4b-ae7f0d27dacc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ae271135db9c6f71f808b1a6f56668d3, https://si.imgix.net/a3a51d96/uploads/origins/a85a395d-14ca-48da-9c4b-ae7f0d27dacc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=79deac830e7e0427e478d06defdde708 2x, https://si.imgix.net/a3a51d96/uploads/origins/a85a395d-14ca-48da-9c4b-ae7f0d27dacc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=c229074a8bf92906543f8e77880801ae 3x"}, "body": "ごいち様はじめまして。\n募集ツイートを拝見し絵柄に惹かれリクエストさせて頂きました。\n宝石のような髪の塗りと青の使い方がとても素敵です！\n\n資料内のキャラクターを自由に描いて頂きたいです。\n二通りの姿がありますがどちらでも構いません。構図や服装の指定もありません。\n彼は男性ですがとても華奢なため、女性と同じ感覚で描いて頂いて大丈夫です。\n可能であれば口内を目と同じ色で塗って頂きたいです。\nよろしくお願いします。\n\nhttps://drive.google.com/drive/folders/11PR2ZOzO7rDa-UPwrdamtswGeSa9Frl2", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@goichi0521/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2410256, "client_id": 3083483, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/09ed224e/uploads/origins/97ed9775-2de9-4f47-abbe-3faa59ced03a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f3f0b1710ab7bfb2d2ccb7adf7b77cee", "srcset": "https://si.imgix.net/09ed224e/uploads/origins/97ed9775-2de9-4f47-abbe-3faa59ced03a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f3f0b1710ab7bfb2d2ccb7adf7b77cee, https://si.imgix.net/09ed224e/uploads/origins/97ed9775-2de9-4f47-abbe-3faa59ced03a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=4a37c719d2430160ae93c62430f6c335 2x, https://si.imgix.net/09ed224e/uploads/origins/97ed9775-2de