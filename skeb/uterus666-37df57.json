9c31375e39 2x, https://si.imgix.net/3ba8480e/uploads/origins/cac1f827-860b-4ec3-b22f-39153e815d63?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=5de4effbe7a06eee2321604b065d2795 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/3ba8480e/uploads/origins/cac1f827-860b-4ec3-b22f-39153e815d63?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5cb15a8561c9c2eff0b063b8d8576886", "srcset": "https://si.imgix.net/3ba8480e/uploads/origins/cac1f827-860b-4ec3-b22f-39153e815d63?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5cb15a8561c9c2eff0b063b8d8576886, https://si.imgix.net/3ba8480e/uploads/origins/cac1f827-860b-4ec3-b22f-39153e815d63?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=cf46678f55b8e6c9d646752dcf3ff7ef 2x, https://si.imgix.net/3ba8480e/uploads/origins/cac1f827-860b-4ec3-b22f-39153e815d63?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=a5855c4eaee391161a4c26e9574b420a 3x"}, "body": "いつも応援しております。昨今盛り上がったマイブームお題に対し、お願いできる方があまりにも限られる難易度のため、手段を選ばずエンダスさんのお手を頼らせて頂きたい次第です。\n\nもしよろしければ、「ウマ娘のメジロアルダンに、FGOの源頼光／丑御前（アヴェンジャー）・第一再臨のコスプレ」したイラストをお願いできるでしょうか。\n\n参考\n・キャラ：メジロアルダン（ウマ娘）\nhttps://umamusume.jp/character/mejiroardan\n\n・衣装：源頼光／丑御前（FGO）\nhttps://fgogamemeister.com/archives/39506333.html\n（第一再臨はぴっちりタイツのものです）\n\n発想に至った経緯として、ゲーム内のイベントにてアルダンさんが「源頼光になった空想をする」というエピソードがあったこと。また彼女の勝負服が、黒ベースにグリーンをあしらう、丑御前（＝源頼光）を彷彿するカラーリングだった……などなど、こじつける理由に個人的に盛り上がってしまったためです……。\n\nあまりにも奇抜な組み合わせに、双方のネタを熟知してる方を選んでる余裕もないと受け入れ、エンダスさんのこれまでの技量と実績にお願いさせて頂きたく存じます……！\n\n一応、あくまで「アルダンさん」を拝みたいので、衣装の元ネタ的に寄せる必要はありません。（というか丑御前側に寄せて暗く病んだ感じになるのは本意ではないです……ｗ）\nキャラの備考として、深窓の令嬢を思わせる雰囲気から、ちょっとお茶目な面があったり、勝負（レース）に関しては覚悟が決まった芯の強さなどのギャップが美味しい子でもあります。（個人的主観ｗ\nそんな彼女が、いざ渡された衣装に恥じらいを隠せなかったり、予想外なりに「源頼光」になりきるつもりで勇ましさを出そうとしたり、etc……。\nエンダスさんのご手腕ならば、戦う凛々しい女の子の姿も、扇情的な衣装に恥じらう仕草でも、どちらに転んでも十二分に仕上げてくださる期待から、この無茶をお願いさせて頂きたいです……！\n\n一応、ウマ娘のガイドライン的にセンシティブはご禁制ですので、乳首が浮き出る等のNSFW描写は明確に避けて頂ければ、と安全のために明記させて頂きます……ｗ\n\n普段とは畑違いのジャンルとは重々承知しておりますが、それでもよろしければ、何卒お願いいたします……！\n\nhttps://www.pixiv.net/artworks/115999216", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@uterus666/works/12", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 58416, "client_id": 3014814, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/fb2ed857/uploads/origins/eab752de-ff3b-43e9-8f07-74541916c0ac?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0e9853dc5a59665d6dc83c65bffa81f0", "srcset": "https://si.imgix.net/fb2ed857/uploads/origins/eab752de-ff3b-43e9-8f07-74541916c0ac?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0e9853dc5a59665d6dc83c65bffa81f0, https://si.imgix.net/fb2ed857/uploads/origins/eab752de-ff3b-43e9-8f07-74541916c0ac?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=26ef2da946d49e110f2839f41a9b4ca4 2x, https://si.imgix.net/fb2ed857/uploads/origins/eab752de-ff3b-43e9-8f07-74541916c0ac?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=0157c8f60277b614dc27d0faa6a69dd9 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/fb2ed857/uploads/origins/eab752de-ff3b-43e9-8f07-74541916c0ac?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=bcfa679ead1727cbfd685d5035e4c980", "srcset": "https://si.imgix.net/fb2ed857/uploads/origins/eab752de-ff3b-43e9-8f07-74541916c0ac?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=bcfa679ead1727cbfd685d5035e4c980, https://si.imgix.net/fb2ed857/uploads/origins/eab752de-ff3b-43e9-8f07-74541916c0ac?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=57e65028a4fa9e8648e601a5ac296012 2x, https://si.imgix.net/fb2ed857/uploads/origins/eab752de-ff3b-43e9-8f07-74541916c0ac?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=54023678c4f15a12b220a1e49aa2841c 3x"}, "body": "イラストををいつも楽しませていただいております。\nよろしければいわゆる「うちのこ」同士のえっちシーンをシチュエーションを変えつつ（漫画形式でも大丈夫です）描いていただけると嬉しいです。\n\nキャラクターの特徴としては \n【女の子】名前は「令（れい）」\n資料画像→https://imgur.com/a/bkKZb8C \n・柔和な顔つき、巨乳（B90くらい？\n　低身長 、大学生くらいの雰囲気 \n【彼氏】名前は「一美（かずみ）」\n資料画像→https://imgur.io/a/FN4IutY \n・女の子より少し大きいくらいの小柄な大学生、女の子とは同い年の大学生 \n・ちんちん大きい \n\n設定としては、大学生同士の同棲カップルでまあまあ色んなプレイもしている小慣れたふたりで、\n流れとして\n①プレイ前の二人とも少し上気した雰囲気\n②半脱ぎでペッティングしつつ、お互いに名前を呼んだり好きとか言っている様子。服は半脱ぎくらいで胸は見えている。\nモノローグで「甘い言葉をかけながら、お互いの心を通わせるのが好き」と言っている。\n③すこし熱が入ってくる。息が荒くなっていき、お互いの名前呼びながら甘イキしているような様子\n④息を荒くつき、理性が飛ぶのを我慢するようにお互いの首の後ろに手を回し、ボールギャグ（http://www.yf-koubou.com/mart/5103.html のようなデザインで白い穴あきボール）を付け合う。\n⑤二人ともボールギャグを咥えてよだれを垂らしながら交合し、激しく腰を動かしている。2人とも声にならないような呻き声を大きな声であげているような雰囲気。\nモノローグで「言葉もなく、お互いの体を求め合うのも…好き」と言っている。\n⑥雄叫びのような呻き声をあげながらフィニッシュ\n⑦ボールギャグを首にかけて、顔を合わせて微笑んでいる。\n\nというものをお願いします。細かい部分については描きやすいように調整していただいてOKです。", "nc": 33, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@uterus666/works/11", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 58416, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/802e0eb1/uploads/origins/ef65c70d-bb91-4bdc-9614-1a4d27240c24?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0b16fd48bb6d2fef0f58c161dfdb05a9", "srcset": "https://si.imgix.net/802e0eb1/uploads/origins/ef65c70d-bb91-4bdc-9614-1a4d27240c24?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0b16fd48bb6d2fef0f58c161dfdb05a9, https://si.imgix.net/802e0eb1/uploads/origins/ef65c70d-bb91-4bdc-9614-1a4d27240c24?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=bbda77ab63a879f9bd429f7c7c33bb95 2x, https://si.imgix.net/802e0eb1/uploads/origins/ef65c70d-bb91-4bdc-9614-1a4d27240c24?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=45544cf38909364ea2e94d6a246cf8fb 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/802e0eb1/uploads/origins/ef65c70d-bb91-4bdc-9614-1a4d27240c24?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f21ddcd33f5683b80516c19412c6364d", "srcset": "https://si.imgix.net/802e0eb1/uploads/origins/ef65c70d-bb91-4bdc-9614-1a4d27240c24?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f21ddcd33f5683b80516c19412c6364d, https://si.imgix.net/802e0eb1/uploads/origins/ef65c70d-bb91-4bdc-9614-1a4d27240c24?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=507f1e713f70763f704fb5e7ce606b2b 2x, https://si.imgix.net/802e0eb1/uploads/origins/ef65c70d-bb91-4bdc-9614-1a4d27240c24?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=307f11e73e1df60bfc28babe799bc53d 3x"}, "body": "初めまして\n漫画形式のモノクロ作品を依頼したいです\n厳しければ即キャンセルで構いません\n\n◆作品\nFate/staynight\n◆キャラ\nセイバー、ライダー、キャスター\n\n◆竿役\n衛宮士郎\n\n◆視点\n定点\n\n◆希望枚数\n1ページ3〜4コマ×4枚\n\n◆設定\n・キャスターは士郎に料理習ってるうちに肉体関係持ってズルズル続いている\n\n◆流れ\n士郎とキャスターの事後からスタート。キャスターが士郎に背を向け下着を直しているとまだ勃っている士郎に迫られ、渋々受け入れる。士郎がキャスターとセックスしてるとセイバーとライダーが帰ってくる。キャスターに「早く帰れ」等の辛辣な言葉を浴びせながら服を脱いで二人も参加し、4P状態になる。4Pの途中にキャスターの携帯に葛木から電話がかかってきて、電話に出ると士郎に激しくされイクと同時に通話が切れる。\n最後は三人とも力尽きキスマークだらけの三人を尻目に、ケロリとしている士郎が凛か桜にゴムが切れてるから買ってきてくれと電話しているところで終わり。\n\n備考\n・流れは書きやすいようにアレンジしていただいて大丈夫です", "nc": 169, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@uterus666/works/10", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 58416, "client_id": 1960223, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/d8b741b4/uploads/origins/af1e8ae2-85c1-4822-a435-1380d353a0f7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f802d4a5380605fa09509453f2568af4", "srcset": "https://si.imgix.net/d8b741b4/uploads/origins/af1e8ae2-85c1-4822-a435-1380d353a0f7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f802d4a5380605fa09509453f2568af4, https://si.imgix.net/d8b741b4/uploads/origins/af1e8ae2-85c1-4822-a435-1380d353a0f7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=9798fb1f557c45e5dbfd58c9eb04c6fd 2x, https://si.imgix.net/d8b741b4/uploads/origins/af1e8ae2-85c1-4822-a435-1380d353a0f7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=abfebb70fb4b27da4a0386534ea7ce3c 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/d8b741b4/uploads/origins/af1e8ae2-85c1-4822-a435-1380d353a0f7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=bce27a8dac50b071972fcc2e7f2c7f58", "srcset": "https://si.imgix.net/d8b741b4/uploads/origins/af1e8ae2-85c1-4822-a435-1380d353a0f7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=bce27a8dac50b071972fcc2e7f2c7f58, https://si.imgix.net/d8b741b4/uploads/origins/af1e8ae2-85c1-4822-a435-1380d353a0f7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=b55467fad3dc1281853a251ec213e150 2x, https://si.imgix.net/d8b741b4/uploads/origins/af1e8ae2-85c1-4822-a435-1380d353a0f7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=7738d48bd1a642ab5c13ddbbb01a5ea8 3x"}, "body": "こんにちは、今年に入り素敵なバニーイラストのお裾分けをご堪能させて頂いております。\nそんなエンダスさんに、もしよろしければ、東方projectの「河城にとり」に格闘ゲーム「ヴァンパイア」シリーズの「リリスの衣装をコスプレ」をさせたイラストをお願いできるでしょうか？\n\n他とは一味も二味も違った味わいをバニー服に込められるエンダスさんを眺めつつ、常々、それに通ずる質感を持つあの衣装を描いて頂いたらどんなクオリティに仕上げて頂けるのか、興味が抑えられず、この機会にご依頼させて頂きたい次第です……！（着せたい相手がにとりなのは個人的な趣味とこだわりです！！）\n\n前回同様、コスプレがメインなので、なるべく衣装姿を拝める全身絵で描いてくだされば非常にありがたいです。表情や構図・ポーズなどについても、エンジェルダストさんのセンスをそのまま光らせて頂ける形でOKです！（しいて言えば恥じらい方向の方が好みですが、より良く仕上げられる構図が降りてくださったのならばそちらで問題ございません！）\n\n衣装の方がエンダスさんからは縁遠いジャンルとなり、お手をかけさせてしまうとは存じますが、最悪、にとりちゃんの方にキャラの解像度が高ければ「よく分からんけど着させられた」感が出て、十分成立するものと皮算用しておりますので、強く期待させて頂けますと幸いです……！\n\n無茶な注文とは存じますが、何卒よろしくお願いいたします！\n\nhttps://www.pixiv.net/artworks/55194620", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@uterus666/works/9", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 58416, "client_id": 1960223, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/9c8af0fc/uploads/origins/9d80bd78-acc3-44ca-b8c8-147bca77d657?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f431e4aece36f2f8bd4d53f95829645f", "srcset": "https://si.imgix.net/9c8af0fc/uploads/origins/9d80bd78-acc3-44ca-b8c8-147bca77d657?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f431e4aece36f2f8bd4d53f95829645f, https://si.imgix.net/9c8af0fc/uploads/origins/9d80bd78-acc3-44ca-b8c8-147bca77d657?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a6fcd9af70a04a1459190ff7db698603 2x, https://si.imgix.net/9c8af0fc/uploads/origins/9d80bd78-acc3-44ca-b8c8-147bca77d657?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e6ab50c5d868f3e6edcb5dd86bf0539b 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/9c8af0fc/uploads/origins/9d80bd78-acc3-44ca-b8c8-147bca77d657?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=8467342072aaba9eabbc10219335e8fa", "srcset": "https://si.imgix.net/9c8af0fc/uploads/origins/9d80bd78-acc3-44ca-b8c8-147bca77d657?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=8467342072aaba9eabbc10219335e8fa, https://si.imgix.net/9c8af0fc/uploads/origins/9d80bd78-acc3-44ca-b8c8-147bca77d657?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=64506ef135a078ee4b5aca0970ee3e1e 2x, https://si.imgix.net/9c8af0fc/uploads/origins/9d80bd78-acc3-44ca-b8c8-147bca77d657?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=e5efc175c5129bb4a705de1b2f2cb385 3x"}, "body": "こんにちは、天下のエンジェルダストさんの素晴らしい画力にて、自分の願望全開なskebをご依頼させて頂けましたら幸いです……！\n\nもしよろしければ「トサキントレオタードを着た火焔猫燐ちゃん」をお願いできますか。\n（※トサキントレオタード→初代のポケモンアニメ43話「ナッシーぐんだん　だいこうしん！」で、カスミがマジシャンのアシスタントの際に着用していた、トサキントを模した衣装を指してます）\n\n成熟したお姉さんの女体を描かせても、幼い子をキュート描かせても、素晴らしいさじ加減での描き分けつつ抜群の生命力のこもった表情を見せてくださるエンダスさんだからこそ、まだ成熟しきっていない、かと言って幼くもない絶妙な「少女」なお年頃（？）なお燐ちゃんをピックアップさせていただきました……！\n\n表情や構図・ポーズなどについては、エンダスさんが良いと思ったままの「お燐ちゃん」として、センスを光らせて頂ければOKです！　知らない衣装を着せられて戸惑うでも、気に入ってノリノリになるでも、エンダスさんの落とし込みやすいお燐ちゃんで、十二分に素晴らしいクオリティになると期待しております！\nただ、コスプレ（衣装）がメインなので、せめて全身絵で衣装姿を堪能させて頂ければ、特に嬉しく思います。\n\n衣装は、センシティブに配慮してストッキング履かせる等の微アレンジを加えて頂くとかは問題ないです。もちろん原作デザインそのままに素足で描かれてもOKです。（だけどロングな手袋が性癖なのでアレンジしても手袋は忘れないで頂ければすごく幸いです……）\n\n無茶な注文とは存じますが、何卒よろしくお願いいたします！", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@uterus666/works/8", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 58416, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/fdd5e9f7/uploads/origins/af0df8d8-4c3d-4160-9b7f-60d68b24f75e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f4e5fce307419b159a1b157d0f99fece", "srcset": "https://si.imgix.net/fdd5e9f7/uploads/origins/af0df8d8-4c3d-4160-9b7f-60d68b24f75e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f4e5fce307419b159a1b157d0f99fece, https://si.imgix.net/fdd5e9f7/uploads/origins/af0df8d8-4c3d-4160-9b7f-60d68b24f75e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c9851a8aecc8c6ce902363f097647753 2x, https://si.imgix.net/fdd5e9f7/uploads/origins/af0df8d8-4c3d-4160-9b7f-60d68b24f75e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=8fc761d525b13408d190e692ab6134a2 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/fdd5e9f7/uploads/origins/af0df8d8-4c3d-4160-9b7f-60d68b24f75e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6b3084466d98ca436383f438da978bc9", "srcset": "https://si.imgix.net/fdd5e9f7/uploads/origins/af0df8d8-4c3d-4160-9b7f-60d68b24f75e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6b3084466d98ca436383f438da978bc9, https://si.imgix.net/fdd5e9f7/uploads/origins/af0df8d8-4c3d-4160-9b7f-60d68b24f75e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=4917c5a40016007152e6c78e785301bb 2x, https://si.imgix.net/fdd5e9f7/uploads/origins/af0df8d8-4c3d-4160-9b7f-60d68b24f75e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=db8a2c366e4cec5c7b5a4686bdbdf742 3x"}, "body": "お世話になっております。資料URLの藍様の上気した必死の表情大好きです。\nそして時々描かれる異形モノのおどろおどろしい空気もたまりません。\nこの二つを併せ持った秘封（蓮メリ）をシチュ①お願いしたいです。\nまたガラっと変わりますが余裕があれば同じ姿勢でシチュ②もお願いします\n\nシチュ①：百合行為を奉納する神事。薄暗い中に紙垂や神棚などが見え隠れするオリエンタルな空気。土着神への贄なので秘封以外の村の衆はいない\n\nポーズ、表情：参考の藍様に近い姿勢で、向かい合うか同じ方向を向くかの姿勢（お任せ）。淫気にあてられて、これから２人を貫くことになる双頭の張型を上気した余裕の無い必死の表情で口で愛撫している。お互いもキスしてたようにわかる唾液の糸があるとなおよし。\n\n衣装：裸、乳首に紐で鈴が括り付けてある。（帽子は邪魔なら外してどこかに）縄が首か腕かにつながって逃げないように拘束。強制ではないですが下半身が画面中に入る場合は下の毛と滴りはあった方が好き。\n\nシチュ②桃紫色の照明が似合うクラブのステージ（ポールダンスみたいな？）でセレブ達に百合行為を見世物にされている。お互いに首輪とリード線でつながれており、ヘッドセットについてるようなマイク装着、喘ぎ声やキス音が会場皆に聞かれている。どこかモニターに二人の顔のアップで表示されているとなおよし。\n\nhttps://twitter.com/uterus666/status/1323562878096478208", "nc": 57, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@uterus666/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 58416, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/f93b26bb/uploads/origins/