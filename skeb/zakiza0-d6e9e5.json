mgix.net/a494180c/uploads/origins/ad834b4d-03c6-4e9d-a0cf-33bd7c5309fe?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a0eb1adaa3fe8caf638b7d3f0e1cd6d3, https://si.imgix.net/a494180c/uploads/origins/ad834b4d-03c6-4e9d-a0cf-33bd7c5309fe?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b81ce4e9f20c1bcec495fa5130a548ad 2x, https://si.imgix.net/a494180c/uploads/origins/ad834b4d-03c6-4e9d-a0cf-33bd7c5309fe?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ead1a1cf83ab03a49dac8dbaca5f1ed2 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/a494180c/uploads/origins/ad834b4d-03c6-4e9d-a0cf-33bd7c5309fe?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=373740af972f6e484f346654070ce65d", "srcset": "https://si.imgix.net/a494180c/uploads/origins/ad834b4d-03c6-4e9d-a0cf-33bd7c5309fe?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=373740af972f6e484f346654070ce65d, https://si.imgix.net/a494180c/uploads/origins/ad834b4d-03c6-4e9d-a0cf-33bd7c5309fe?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=6f24bf637029ec5c580b203d1459df6e 2x, https://si.imgix.net/a494180c/uploads/origins/ad834b4d-03c6-4e9d-a0cf-33bd7c5309fe?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=c916d5a1271b90e6e95853b17b22e7e5 3x"}, "body": "ふかざき先生の絵が大好きなので可能あればまたリクエストをしたいです…！\n\n彼の家族は病院を経営しており、子供の頃から会社の後継者として勉強を続けてきた。現在は心理カウンセラーとして働いている。\n\n老若男女問わず人気がある。彼の穏やかで親しみやすい性格と見た目から、子供たち（時には大人も）は彼を羊先生と呼ぶ。彼は気にしない。活動的で、セッション中に患者とスポーツをすることもある。オフィスにはミニフィギュアセット（レゴなど）を展示しており、子供の患者たちが喜んで遊ぶ。近視でコンタクトを使用しているが、オフィスには様々な眼鏡を常備している。患者に応じてかける眼鏡を変える（もっと居心地良く感じてもらうために）。\n\n家族と仕事に献身的な働き者。暇な時は読書をし、時には公園へ行ってぼんやりと空間を見上げ、鳩の存在すら気づかないほど。予想に反して、彼は自分の体格を褒められると少し照れくさくなる。彼の富と物腰は女性に人気があるが、恋愛には興味がない。ただし草食系なので、告白してくる女性の気持ちは概ね受け入れる。でも彼女たちは彼が義務感で付き合っていると感じ、すぐに別れを告げる傾向にある。彼は気にしない。\n\nたとえ相手が望んでいなくても彼は助けを必要とする人に惹かれる。趣味は好きな人をからかい、嫌いな人を嫌がらせること。どちらも笑顔で。\n\n彼のイメージデザートはモンブランだけど、彼は絹ごし豆腐が大好きで、特に冷奴！できれば前回のリクエストの女性のように、スプーンを持ってのイラストをお願いします…！(豆腐と)\n\n没ラフや下描きなどがあればPSDに残したままにしていただけると嬉しいです。長いお願いをお読みいただき、またご検討いただきありがとうございます！\n\nhttps://drive.google.com/drive/folders/1VOzmp02R0x2qZlZHnpdec-7mp1f746nf?usp=sharing", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@zakiza0/works/12", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1848259, "client_id": 3273138, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/2bd374ca/uploads/origins/5197ce2e-70dc-44b5-b2a3-d5f5edc06719?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=80bcd6f311e99aec890ae56c5019b363", "srcset": "https://si.imgix.net/2bd374ca/uploads/origins/5197ce2e-70dc-44b5-b2a3-d5f5edc06719?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=80bcd6f311e99aec890ae56c5019b363, https://si.imgix.net/2bd374ca/uploads/origins/5197ce2e-70dc-44b5-b2a3-d5f5edc06719?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=44500734e13f6ed4e98fc03730776af9 2x, https://si.imgix.net/2bd374ca/uploads/origins/5197ce2e-70dc-44b5-b2a3-d5f5edc06719?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=350ac257795a71463f9d4e008adde5dd 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/2bd374ca/uploads/origins/5197ce2e-70dc-44b5-b2a3-d5f5edc06719?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=48f9398433e5ea201ae9d1384c3653e0", "srcset": "https://si.imgix.net/2bd374ca/uploads/origins/5197ce2e-70dc-44b5-b2a3-d5f5edc06719?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=48f9398433e5ea201ae9d1384c3653e0, https://si.imgix.net/2bd374ca/uploads/origins/5197ce2e-70dc-44b5-b2a3-d5f5edc06719?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=a36c334bfe09a076cb1a37307acff988 2x, https://si.imgix.net/2bd374ca/uploads/origins/5197ce2e-70dc-44b5-b2a3-d5f5edc06719?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=46556e6f54433197acd28662c0e58e7c 3x"}, "body": "先生こんにちは！リピートを失礼します…！\n\n幼い頃、親を追い出すまで、かわいい服を着ることも、女性らしい趣味を楽しむことも禁じられていた。欲しいものを手に入れるためなら、卑怯な手段も厭わない。 好きな色は赤で、それは彼女が着ることを許されなかった女子校の制服の色でもある。\n\nかわいいピンクの服が好きだが、自分で着るより他人が着ているのを見る方が好き。 副業として孤児院を経営しており、上品で面倒見のいいお姉さん気質で、理想の家庭を築きたいと願っている。そのため、簡単には信用しないが、温かく優しい笑顔を浮かべている。 \n\n恋愛小説が特に好きで、チェスのような純粋な戦略ゲームが大好き。花が好きだが、手入れが苦手なので庭師に任せている。 また、邸宅にはドールハウス専用の部屋があり、チェスの駒に見立てた動物の置物が飾られている。ほとんどの人は中に入れない。\n\n構図も何もかもあなたにお任せするわ。没ラフや下描きなどがあればPSDに残したままにしていただけると嬉しいです。金額が不足している場合はアピールをお送りください。長いお願いをお読みいただき、またご検討いただきありがとうございます。\n\nhttps://toyhou.se/23486669.fleur-ordelai/gallery", "nc": 25, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@zakiza0/works/11", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1848259, "client_id": 3635005, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/c6d23e67/uploads/origins/c480049c-fffb-4e61-ade8-ccca97a7d442?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2d411df87c337b75cfa65e5e20d07387", "srcset": "https://si.imgix.net/c6d23e67/uploads/origins/c480049c-fffb-4e61-ade8-ccca97a7d442?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2d411df87c337b75cfa65e5e20d07387, https://si.imgix.net/c6d23e67/uploads/origins/c480049c-fffb-4e61-ade8-ccca97a7d442?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e05b395d4179aa6ecce4522139db4e99 2x, https://si.imgix.net/c6d23e67/uploads/origins/c480049c-fffb-4e61-ade8-ccca97a7d442?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=36ebb9c728c58c