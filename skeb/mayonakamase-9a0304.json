819e3/uploads/origins/55c7134a-9092-4b90-bc51-2bd4dd382f6e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bdc935f5718b1e4f00233d34bab6214a", "srcset": "https://si.imgix.net/c78819e3/uploads/origins/55c7134a-9092-4b90-bc51-2bd4dd382f6e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bdc935f5718b1e4f00233d34bab6214a, https://si.imgix.net/c78819e3/uploads/origins/55c7134a-9092-4b90-bc51-2bd4dd382f6e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=9eeb55a2855061c363fec4e297084b4d 2x, https://si.imgix.net/c78819e3/uploads/origins/55c7134a-9092-4b90-bc51-2bd4dd382f6e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=5f11cc7adccec775274730910121503c 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/c78819e3/uploads/origins/55c7134a-9092-4b90-bc51-2bd4dd382f6e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=846ddfc211136b860be8cf68e3cd8cf3", "srcset": "https://si.imgix.net/c78819e3/uploads/origins/55c7134a-9092-4b90-bc51-2bd4dd382f6e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=846ddfc211136b860be8cf68e3cd8cf3, https://si.imgix.net/c78819e3/uploads/origins/55c7134a-9092-4b90-bc51-2bd4dd382f6e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=d406be1907e697b2663d9ede8d2a9dff 2x, https://si.imgix.net/c78819e3/uploads/origins/55c7134a-9092-4b90-bc51-2bd4dd382f6e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=b153aab3241b5bc6d2fcc87007c18b92 3x"}, "body": "ませさんこんにちは‼️横田です‼️\nませさんのイラストが大好きです😻‼️良ければ友人とのOC達を描いていただけないでしょうか…‼️\n\nーーー\n\n■キャラクター\n👁️褫木 日向(あばき ひゅうが)\n21歳・178cm・右利き\n●モチーフ：目\n●見た目の特徴\n目…赤\n髪…黒\n体格…痩せマッチョ\n服は紫を選ぶことが多い\n●一人称/二人称：俺/アンタ\n●みんなの呼び方：鮭川/徒花\n●口癖/語尾(あれば)：「OK」「元気してるか？」「任せろ」「飲みたりないか？」「おいおい〜面白くなってきたな」「アンタの話をしよう」\n\n●趣味: 飲み、███\n●好き\n・友達、\n・相談に乗ること、\n・冗談\n・介抱\n・███\n●嫌い \n・███\n\n【一言人物像】\n「超善良な介抱者、普遍的なモテDD」\n\n有名大学の経営学部3年生。\n飲みサーに所属している。\nまた新歓などのイベントを運営する。\n飲み会ではプロフェッショナルな立ち振る舞いをする。\n面倒見がよく人と関わるのが好きで、ノリがよく、同時に察しがよく空気が読めるいい男。誰にでも優しく、分け隔てなく接する態度により、幼少期からモテまくり、光栄に思いながらも謙虚さを忘れない優秀な男。優等生という訳でも無いが、全てにおいてほんの少し秀でており、いい意味で平均的な男。\n好奇心旺盛で聞き上手。彼自身の話はあまりしない。\n\n「おー！久しぶりだな！元気してるか？なあなあ、どっか飲み行こうぜ」\n\n「すまん、その日は飲みが.....あーーごめんな、この日はサークルで......はは、悪かった、悪かったって笑\nちゃんと連絡よこすからさ、な？アンタとはさ、サシで飲みたいし、また聞かせてくれよ…アンタのこと」\n\n「好きだ」\n\n―――\n\n🍙鮭川 いくら(さけかわ いくら)\n男・22歳(年齢要相談なため仮)・161・右利き\n●モチーフ：いくら\n●見た目の特徴\n目…少しジト目みたいなオレンジ色のつり目\n髪…うしろちょい結びの茶髪(下ろしたらボブ)\n体格…痩せ型\n●一人称/二人称：僕/君・お前\n●みんなの呼び方：日向/勝利/お前ら\n●趣味：寝ること・無駄を減らすこと・節約\n●好き：白米・おにぎり・和食・睡眠\n●嫌い：無駄・常識のない人・鬼ごっこ・虫・汚い物\n\nめんどくさがり屋だけど完璧主義で潔癖症。面倒事に巻き込まれるのが嫌で何よりも自分が最優先な一匹狼。努力に裏切られた少年の復讐。\n\n恋愛の興味はなし、恋人は和食と睡眠。ドが付くほどの白米オタク。\n汚いものは無理。触りたくないし話したくもない。虫も同様。食事の最中に汚い物や虫の話をされるのが何よりも無理。\n\n物に対して「嫌い」とは言うが、人に対して「嫌い」ということは無い。ただ、態度には出る。\n\n「うるさ…睡眠の邪魔なんだけど、黙ってもらっていい？」\n\n「ほひひひはほほははほひほはひひはんほひひひほひっへふ？(おにぎりはそのままが一番おいしいの知ってる？)」\n\n「アイマスクと耳栓？、お前らがうるさいからそれをシャットダウンするためにあるもんだけど。」\n\n「ヤダ。行かない。そんなとこ行く暇あるなら他の事してた方が”マシ”。」\n\nーーー\n\n🐼 徒花 勝利（かちかしょうり）\n男・22歳（仮）・178cm・右利き\n●モチーフ：パンダ、笹\n●見た目の特徴\n目…グレー目\n髪…黒髪、襟足インナーに緑\n体格…うっすらと筋肉のある健康体。ジムや運動というよりは子供の頃からのバイト三昧の生活の上でついた筋肉\n●一人称/二人称：俺ちゃん/お前\n●三人称：(名前)ちゃん、(名前)センパイ/パイセン、(名前)さん\n●みんなの呼び方\n👁ひゅーがちゃん\n🍙いくらちゃん\n●口癖/語尾(あれば)：ちっちゃいカタカナが入りがち\n●趣味：お金稼ぎと酒タバコ・（ちょっとした）ギャンブル\n●好き：金、中華料理、友情・努力・勝利\n●嫌い：お金が無くなること、見放されること\n\n中華街でバイトをする世渡り上手な大学生。\n明るくへらへらしており、基本誰にでも分け隔てなく接する優男。\nだが金の事になるとマジになるなど守銭奴で、さらに酒癖も女癖も悪い。\n\n五人兄弟で生まれ、常に家にお金がなかったため、小学生のころからずっとバイトをしている。そのため金銭にうるさい。大学生になった今でも稼ぎの半分以上は実家に仕送りしている。\n将来の夢は大金持ち。\n\n「パーンダパンダ、パンダ饅頭〜🐼あ、お兄さん？パンダまんいかがっすか〜…って、おーい冷やかしか？」\n\n「パンダと中華屋足して…あとこの前のおためしウーバーと…ばーちゃんの小遣いはもらっとくだろ？スっと██万、マジか、ンであいつらへの仕送り…あとゼイキンもろもろを考えると…シャバいな、クソォ～俺だけ免除になんねえかなァ～パンダ手当とかよお～」\n\n「それこんど俺行くって話だったろ〜…してない？いーや、絶対にしたね。俺ちゃんいーはなしだけは絶対に覚えてるタチだから！…聞いてんのか？…おい無視すんな」\n\n\n┈┈┈┈┈┈┈┈┈┈\n\n■関係性\n幼なじみの同い年大学生3人組。\n家が近所だったことから小さい頃からずっと一緒にいる。\n昔はみんな仲良く過ごしていたが、小学校卒業後から2人に対する🍙の態度が代わり悪くなる一方。\n現在は🍙🐼が二人でルームシェア中で👁は一人暮らし。🐼が👁を家に呼んで遊ぶことが多い。\n\n┈┈┈┈┈┈┈┈┈┈\n\n■今までの3人の生活\n小学校まで\nみんなで仲良く遊んだりお話をしていた。よく見るような笑顔が多い仲良し3人組。\n🍙は小学四年生から陸上部へ。\n↓\n中学校\n👁🐼は軽音部、🍙は陸上部。\n🍙の態度が代わり、どんどん1人行動をするように。👁🐼は変わらず、🍙へと優しい態度のまま。\n🍙の卒業大会で🍙がスタート直後に足を壊し(👁🐼も応援に来ていた)、スポーツ推薦取り消し。\n結局3人同じ高校へ。\n↓\n高校\n🍙は1年の頃からずっと学業に専念。👁🐼は青春を楽しむ。\n🍙は一般で受験するも第1志望である難関大が落ちる。\n👁は🍙と同じ大学に行くべく難関大のみを受験し、合格。\n🐼もみんなと同じ大学に行くために学校推薦を取り、合格。\n↓\n大学\n👁🐼が同じ大学。🍙は滑り止め大学へ。\n🐼の元に🍙の母が「いくらちゃんの一人暮らしが心配すぎるからいくらちゃんサポート隊として一緒に暮らしてあげてくれないかしら😭おかねは私の方で払うから安心してね🎶」と声をかけたことにより🐼と🍙はルームシェア中。(👁の元へも声をかけたが断られ、二人暮しと一人暮らしと分かれている。)\n\nーーー\n\n■使用用途\n個人観賞用・友人間での共有\n\nーーー\n\nこの3人はクトゥルフ神話TRPG「救世主」を通過予定の3人です‼️(HO1👁、HO2🍙、HO3🐼)\n説明文的には現在3人で行動して無さそう…という感じですが🐼が2人を呼んで3人で遊ぶことがよくあります‼️\nませさんがお好きなように調理して問題ないです🎶(服装も簡略化・変更可能です‼️)\n\n不備などがあればお気軽に再送要請していただけると幸いです‼️難しければキャンセルして構いません‼️\n最後まで読んで頂きりがとうございます‼️ご検討の程宜しくお願い致します‼️\n\nhttps://drive.google.com/drive/folders/1EI8FoucZ89migX70WKkHzTyEduAW1hUr?usp=drive_link", "nc": 25, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@mayonakamase/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3703140, "client_id": 2998972, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/d085f3c4/uploads/origins/a4c9e391-91e4-4864-bac1-0e0842d8aa64?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e5ef7e7455151ffd2a8197b03b792491", "srcset": "https://si.imgix.net/d085f3c4/uploads/origins/a4c9e391-91e4-4864-bac1-0e0842d8aa64?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e5ef7e7455151ffd2a8197b03b792491, https://si.imgix.net/d085f3c4/uploads/origins/a4c9e391-91e4-4864-bac1-0e0842d8aa64?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=52e1225273d3115a723d600794b24a89 2x, https://si.imgix.net/d085f3c4/uploads/origins/a4c9e391-91e4-4864-bac1-0e0842d8aa64?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=2e2ce77fa266883286b2b1b10ff10977 3x"}, "duratio