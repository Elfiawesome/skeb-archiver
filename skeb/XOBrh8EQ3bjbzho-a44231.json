ます！胃の内部を見ると、完全に人で満たされている。胃壁はきつく、みんなを無理やりくっつけている。胃壁には液体も染み出ている。胃の底にいる人たちは、少し溶けているのだろうか？\n\nちっぽけな人は10センチくらい\n\nリクエストにお答えいただき、ありがとうございました！\n\nキャラクター紹介はこちら\n\nhttps://drive.google.com/drive/folders/1Cb5bzAZDX-Ud5n6Z61xJWscYrVT13dpw?usp=sharing", "nc": 57, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@XOBrh8EQ3bjbzho/works/9", "private_thumbnail_image_urls": null, "private": false, "genre": "comic", "tipped": false, "creator_id": 818894, "client_id": 3233407, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/fc2a01ac/uploads/origins/c93b6ec9-cca5-48ef-b54f-f7feb8b616b1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=418bf4acebedf3f2ae58ebae6cad8eeb", "srcset": "https://si.imgix.net/fc2a01ac/uploads/origins/c93b6ec9-cca5-48ef-b54f-f7feb8b616b1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=418bf4acebedf3f2ae58ebae6cad8eeb, https://si.imgix.net/fc2a01ac/uploads/origins/c93b6ec9-cca5-48ef-b54f-f7feb8b616b1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=3dbe7bb9399d03bfafab768c93b259f3 2x, https://si.imgix.net/fc2a01ac/uploads/origins/c93b6ec9-cca5-48ef-b54f-f7feb8b616b1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=da39e5cb8d8dd3ee5755409d403b825a 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/fc2a01ac/uploads/origins/c93b6ec9-cca5-48ef-b54f-f7feb8b616b1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0637e6d89b553f53f8ad001a8507b91f", "srcset": "https://si.imgix.net/fc2a01ac/uploads/origins/c93b6ec9-cca5-48ef-b54f-f7feb8b616b1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0637e6d89b553f53f8ad001a8507b91f, https://si.imgix.net/fc2a01ac/uploads/origins/c93b6ec9-cca5-48ef-b54f-f7feb8b616b1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w