.dropbox.com/sh/4oifk7qyv2ix3cx/AADyWShtMDVeBGPqPTQ9xTsra?dl=0\n\n\nたまり醤油\n謎の生命体　ペット\n↑資料上に入ってます。", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@cGVsjMyv0W29499/works/2", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/4ace6473/uploads/origins/18c4ea1e-8746-4545-9d03-f5a212184022?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=6b1ccf2dc51e4814ad1186c35a325660", "srcset": "https://si.imgix.net/4ace6473/uploads/origins/18c4ea1e-8746-4545-9d03-f5a212184022?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=6b1ccf2dc51e4814ad1186c35a325660, https://si.imgix.net/4ace6473/uploads/origins/18c4ea1e-8746-4545-9d03-f5a212184022?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=d1b3d1bca21000b4d62bab7ca40658e5 2x, https://si.imgix.net/4ace6473/uploads/origins/18c4ea1e-8746-4545-9d03-f5a212184022?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=56ac709302266d2b731c9dbda09c2038 3x"}, "private": true, "genre": "comic", "tipped": false, "creator_id": 3287080, "nc": 128}, {"path": "/@cGVsjMyv0W29499/works/1", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/2d004cb2/uploads/origins/fed38c28-9f8b-4d2d-86ac-e3fd5c52e984?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=89617db6d56f8588ca2a337f9ad006b3", "srcset": "https://si.imgix.net/2d004cb2/uploads/origins/fed38c28-9f8b-4d2d-86ac-e3fd5c52e984?bg=%23fff&auto=format