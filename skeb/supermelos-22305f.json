モネなどのモチーフを取り入れた演出にしていただけると嬉しいです。\nそれぞれのモチーフの入れ方やバランスは、画面に合うように自由にアレンジしていただいて構いません。\n\n髪型についても、設定画に合わせる必要はありませんので、画面や雰囲気に合うように自由に変更していただいて大丈夫です。\n\n構図やポーズ、表情、演出などは先生のセンスにお任せいたします。\n衣装や設定の細かな部分も、描きやすさや画面の見映えを優先して、自由に省略・アレンジ・変更していただいて構いません。\n\nご依頼の用途：個人鑑賞用\n\n金額などに問題があれば、お手数ですが再送いただけますと幸いです。\nご検討のほど、よろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/1j0ouG7FywsAvUqKWKXie0FtLy4k2YwYt", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@supermelos/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 4041895, "client_id": 2230580, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/a75ecd1d/uploads/origins/affc0a42-7808-41ac-92c4-454ebd8a01aa?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=44c3d8a7a17b744e67fec90eb3cc3f61", "srcset": "https://si.imgix.net/a75ecd1d/uploads/origins/affc0a42-7808-41ac-92c4-454ebd8a01aa?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=44c3d8a7a17b744e67fec90eb3cc3f61, https://si.imgix.net/a75ecd1d/uploads/origins/affc0a42-7808-41ac-92c4-454ebd8a01aa?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a1bbfb56b4a1c414b2bfd30050666020 2x, https://si.imgix.net/a75ecd1d/uploads/origins/affc0a42-7808-41ac-92c4-454ebd8a01aa?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d85e55cc5cba4f8e620450082796a65f 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/a75ecd1d/uploads/origins/affc0a42-7808-41ac-92c4-454ebd8a01aa?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=dcbf95ba79f730e80ddc3c5df276a897", "srcset": "https://si.imgix.net/a75ecd1d/uploads/origins/affc0a42-7808-41ac-92c4-454ebd8a01aa?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=dcbf95ba79f730e80ddc3c5df276a897, https: