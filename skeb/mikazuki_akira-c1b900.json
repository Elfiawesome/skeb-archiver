%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=5f649a51657b1e6c23770630e75d730f 3x"}, "body": "はじめまして。\n詳細はおまかせいたしますので、もしよろしければお願いいたします。\n※差分については、ポーズ、構図はすべて同じでOKです\n\n■概要\n「ワルキューレの冒険」などの主人公ワルキューレが、敵にやられて気を失っている間にじっくり観察された上に犯される(睡眠姦のようなシチュの)イラストをおねがいします。\n※敵にやられている状態ですが、流血は無しでお願いします\n服や身体の汚れの有無はおまかせします\n\n■キャラ\n基本的にワルキューレ1人でOKです。\n竿はシルエットのみ、竿と玉のみなど簡略的な表現でOKです。\n\n■服装\n参考ページの衣装(兜あり)を着ていてスカートをめくられて陰部が露出している状態。\n\n胸の露出の有無はおまかせいたします(胸の部分が破られて露わになっていても胸の防具をつけたままでも、どちらでもOKです)\n\n■構図\n陰部、肛門が見える構図であればポーズ等はおまかせします。\n手先や足先は見切れていてもOKです。\n\n■陰毛\n陰毛あり:\n陰部周辺から肛門周りまでモサモサ多めの陰毛(清純生真面目で見えない部分は無頓着で完全未処理のイメージ)\n腋毛なしでお願いします。\n陰毛部分は別レイヤーでお願いします。\n\n■他の希望\n線修正、psd、差分は別レイヤー希望です。\nCLIP STUDIOで確認可能です。\n\nhttps://projectxzone.fandom.com/wiki/Valkyrie", "nc": 186, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@mikazuki_akira/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2127909, "client_id": 1632689, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/23abac58/uploads/origins/d705559c-0d82-4605-b3e9-b281984fdf72?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9a7b2f8d9e48d57aef83f9b0596cb283", "srcset": "https://si.imgix.net/23abac58/uploads/origins/d705559c-0d82-4605-b3e9-b281984fdf72?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9a7b2f8d9e48d57aef83f9b0596cb283, https://si.imgix.net/23abac58/uploads/origins/d705559c-0d82-4605-b3e9-b281984fdf72?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=0fa1977432e8eafdae99e101f3105653 2x, https://si.imgix.net/23abac58/uploads/origins/d705559c-0d82-4605-b3e9-b281984fdf72?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d1cabb55d81c2689a891ab09a885c621 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/23abac58/uploads/origins/d705559c-0d82-4605-b3e9-b281984fdf72?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=23b59ca3f8873f1ea8624f08d17291c3", "srcset": "https://si.imgix.net/23abac58/uploads/origins/d705559c-0d82-4605-b3e9-b281984fdf72?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=23b59ca3f8873f1ea8624f08d17291c3, https://si.imgix.net/23abac58/uploads/origins/d705559c-0d82-4605-b3e9-b281984fdf72?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=6c4e594c73fef0278ee18740a09da53b 2x, https://si.imgix.net/23abac58/uploads/origins/d705559c-0d82-4605-b3e9-b281984fdf72?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=c5ccf77c183ee5c110fed5ea861e7e94 3x"}, "body": "こんにちは。\n\n先生のイラストはとても素敵だと思うので、お願いがあります。漫画「アイズ」の葦月伊織のイラストを描いていただけませんか？\n\n参考画像：https://i.ibb.co/Vp0Sxcr/iori.jpg\n\n裸でベッドに座っている。彼女はちょうど目が覚めたところで、ストレッチをしています。大きなあくびをして、口とのどを大きく開けるので、口蓋垂が丸見えになっています。\n\nご考慮いただきありがとうございました。", "nc": 161, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@mikazuki_akira/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2127909, "client_id": 34152, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/cd584e33/uploads/origins/d22b02d3-7b90-4cf0-9ee9-c7d0da411552?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a688f9b76ae0db894f5a351b28bb3b9a", "srcset": "https://si.imgix.net/cd584e33/uploads/origins/d22b02d3-7b90-4cf0-9ee9-c7d0da411552?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a688f9b76ae0db894f5a351b28bb3b9a, https://si.imgix.net/cd584e33/uploads/origins/d22b02d3-7b90-4cf0-9ee9-c7d0da411552?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=8b95dfa750a046b860d37ad2db69a296 2x, https://si.imgix.net/cd584e33/uploads/origins/d22b02d3-7b90-4cf0-9ee9-c7d0da411552?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=7e25d4a4382157899e945e6ca517e1ca 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/cd584e33/uploads/origins/d22b02d3-7b90-4cf0-9ee9-c7d0da411552?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=20fa60f46bf9dfb8c635ff5dba9b815f", "srcset": "https://si.imgix.net/cd584e33/uploads/origins/d22b02d3-7b90-4cf0-9ee9-c7d0da411552?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=20fa60f46bf9dfb8c635ff5dba9b815f, https://si.imgix.net/cd584e33/uploads/origins/d22b02d3-7b90-4cf0-9ee9-c7d0da411552?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=11bd6ba1d2dd784ec82bd46dc00222e4 2x, https://si.imgix.net/cd584e33/uploads/origins/d22b02d3-7b90-4cf0-9ee9-c7d0da411552?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=31fc7d8e678af9fd1eaa09e9616a55da 3x"}, "body": "みかづきあきら先生、はじめまして。\n\nゴブリンスレイヤーに登場する素っ裸の牛飼娘が寝室で朝から気持ちよさそうに自分の母乳を飲みながらセルフ乳吸いオナニーしてしまう絵をリクエストしてよろしいでしょうか？\n\n希望する主な内容と要素は・・・\n・片方の手で大きな胸を口元まで持ち上げ、自分の乳首を丸ごと咥えながら気持ちよさそうに吸う\n・もう片方の胸にも自分の乳首を吸った痕跡があり、両方の胸は母乳と唾液が垂れている\n・アソコを濡らしながら余った手でクリトリスを刺激する\n・朝から激しく自慰行為に浸ってしまい、体中は汗塗れ\n・オナニーが気持ちよすぎて涙を浮かべている、または涙を流している\n\nシチュエーションに合った適当な台詞やエッチな擬音も入れていただけると嬉しいです。\n\nイッちゃう差分もあると嬉しいですけど、負担になるようでしたら無くても結構です。\n\n納品形式は出来ればPSDで。\n\nご検討のほどよろしくお願い致します。\n\n参考URL:\n\n牛飼娘\nbit.ly/3MXhDvY\nbit.ly/3xxmWfH\n\nセルフ乳吸い\nbit.ly/3rrLd56\nbit.ly/3ursPLC\nbit.ly/3sbPrwY\nbit.ly/3gsVzvn", "nc": 33, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 7431, "creator": true, "nsfw_acceptable": true, "acceptable": false, "name": "むむむか", "screen_name": "0mumumuka0", "avatar_url": "https://pbs.twimg.com/profile_images/1709107419056644096/BdBCEZtU.jpg", "header_url": "https://pbs.twimg.com/profile_banners/3561100334/17176