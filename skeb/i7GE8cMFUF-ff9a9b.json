ってくれると思い依頼にきました。ただ特殊性癖の極みなので金額の割りや自身の性癖に合わないと感じた場合断られても大丈夫です。\n\n爆乳長身イケメンのかっこいい女性キャラクターが、局部露出変態男のケツ穴に脚をぶち込み掻き回す。やられ役はアソコが肥大し嬉しそうに発射している。\n\n女性キャラのデザインはお任せ致します。\nやられ役はリアル日本人体型で175cm前後。２次元キャラにしては手足は短いが竿と玉はデカい。顔はのっぺらぼう、SMマスク、適当で大丈夫です。\nやられ役の下半身のイメージ\nhttps://skeb.jp/@hokekyo99/works/12\n\n自分だったら２次元の娘にこんなふうにドMなクライアントの分身をいじめさせる！というイメージのもと描いて貰えたら嬉しいです。ご考案宜しくお願い致します。", "nc": 187, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@i7GE8cMFUF/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3341428, "client_id": 50473, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/abe0985a/uploads/origins/38d71336-7488-4878-b807-d5d3b8577809?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c50946ca68c8adc70c78f4491c2b3307", "srcset": "https://si.imgix.net/abe0985a/uploads/origins/38d71336-7488-4878-b807-d5d3b8577809?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c50946ca68c8adc70c78f4491c2b3307, https://si.imgix.net/abe0985a/uploads/origins/38d71336-7488-4878-b807-d5d3b8577809?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=691d97c3cf5d9831c3acebfa7cc70a0a 2x, https://si.imgix.net/abe0985a/uploads/origins/38d71336-7488-4878-b807-d5d3b8577809?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=753f34633eafbeab8d862b80c5297914 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/abe0985a/uploads/origins/38d71336-7488-4878-b807-d5d3b8577809?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b7fedd690a28582e59b8f056dd1cc675", "srcset": "https://si.imgix.net/abe0985a/uploads/origins/38d71336-7488-4878-b807-d5d3b8577809?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b7fedd690a28582e59b8f056dd1cc675, https://si.imgix.net/abe0985a/uploads/origins/38d71336-7488-4878-b807-d5d3b8577809?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=caf55c928b2ea70ee3ce4bfd5130dbbc 2x, https://si.imgix.net/abe0985a/uploads/origins/38d71336-7488-4878-b807-d5d3b8577809?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=6c7abfbf581cd7cf60225388df092dff 3x"}, "body": "はじめまして、吾と申します。\nイラスト募集をされているとお聞きし、今回依頼させて頂きます。\n\nお願いしたいものは疾風ウルトラ忍法帖という作品に登場する「邪鬼姫」のイラストになります。\n古い作品ですので資料を用意しましたのでご確認ください。\n\n邪鬼姫が作中で使用した「Ｔバック幻術」というお尻に見とれさせることで幻術にかけるシーンをイラストにして頂けないでしょうか。\n\n詳細な構図などはおまかせしますが、こちらに向けてお尻を振っている邪鬼姫とその周囲に幻術のお尻や桃がグルグル回っているようなイメージで作成して頂ければ幸いです。\n\n分かりにくい依頼で申し訳ありませんが、ご検討のほどをよろしくお願いします。\n\nhttps://drive.google.com/file/d/1WAf_3-qZq5qT1Wmy81QzhzjtpxO39Yhd/view?usp=drivesdk", "nc": 33, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@i7GE8cMFUF/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3341428, "client_id": 318030, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/f154752c/uploads/origins/0adc0d64-2e8a-4ae8-842f-1d665c84ab33?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c4f43fab3e17e8dd3c28b76bb9e8474c", "srcset": "https://si.imgix.net/f154752c/uploads/origins/0adc0d64-2e8a-4ae8-842f-1d665c84ab33?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c4f43fab3e17e8dd3c28b76bb9e8474c, https://si.imgix.net/f154752c/uploads/origins/0adc0d64-2e8a-4ae8-842f-1d665c84ab33?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=581a5c859952c15b0c3dada0f3b71268 2x, https://si.imgix.net/f154752c/uploads/origins/0adc0d64-2e8a-4ae8-842f-1d665c84ab33?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a21516da1377015e44d535f88fb83fb2 3x"}, "duration": null, "nsfw": true, "hardcore": true, "consored_thumbnail_image_urls": {"src": "https://si.imgi