78c50?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=44fae562b7ea135283d5677642a4e693 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/f2886577/uploads/origins/3069c59d-16ca-4fbf-9bd9-978472278c50?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9b9c6ebea5a82a1257c4215a1dd45536", "srcset": "https://si.imgix.net/f2886577/uploads/origins/3069c59d-16ca-4fbf-9bd9-978472278c50?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9b9c6ebea5a82a1257c4215a1dd45536, https://si.imgix.net/f2886577/uploads/origins/3069c59d-16ca-4fbf-9bd9-978472278c50?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=036ecdcca80fa870219e5e996308b844 2x, https://si.imgix.net/f2886577/uploads/origins/3069c59d-16ca-4fbf-9bd9-978472278c50?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=2ce66d29f9afe356ed6ec62a7acf8fa9 3x"}, "body": "スーパー兄貴様\n\nこんにちは。うにという者です\nCoCシナリオ「貴様らのエデンはここです｣  で、だいすきなNPCたちのイラストを担当されていたスーパー兄貴様の絵でどうしても自陣が見たくて、今回は依頼をしに参りました\n\n\n＿＿＿＿＿＿＿＿＿＿＿＿＿＿\n\n▍依頼内容\nCoC「貴様らのエデンはここです」の自陣の集合イラスト\nhttps://drive.google.com/drive/folders/1wqYZw1WlCePXEvEnLOKDGWkywwIv-f7S\n\n▍詳細\n・HO1\n前髪で両目がほぼ隠れてるオッドアイの男\n21歳  190cm\nバッタを食べます。嘘じゃないんです。すごく元気でデッカイ(190cm)です。よくHO2と喧嘩(じゃれあい)をしてます。\n\n・HO2\nオレンジ髪で眼帯してる男\n20歳  178cm\nフラ〜と自由に好き勝手してる男です。HO1の手によってバッタを食べさせられたりします。チームのお調子者担当でよくHO2と喧嘩(じゃれあい)をしてます\n\n・HO3\n白髪で片目隠れている女(HO3)\n21歳  168cm＋ヒール5cm  173cm\n表情筋はそんなに動かないです。HO1とHO2の喧嘩(じゃれあい)を拷問するよの一言で収めてます。しっかりしてます\n\n・HO4\n白髪で顔に傷のある男\n36歳  187cm\nチームのパパです。マジで。自分からパパを名乗ってます。割烹着着ていつもごはんとか作ってくれます。お仕事を頑張るとキュービィロップをみんなにくれます。親バカです\n\n▍構図指定\nよくHO4の作ったごはんをみんなで食べるのでご飯食べてたら嬉しいです。難しければスーパー兄貴様の解釈でお好きにしてもらえたらうれしいです。\n\n＿＿＿＿＿＿＿＿＿＿＿＿＿＿\n\n私はHO3出身なのでもうNPCに頭おかしくなるくらい狂ってしまって、シナリオも、どのNPCも本当に大好きになりました。本当にありがとうございました。\n何か問題があれば蹴って頂いて構いません。ご検討いただけますと幸いです\n\nhttps://drive.google.com/drive/folders/1wqYZw1WlCePXEvEnLOKDGWkywwIv-f7S", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "similar_creators": []}, "price_history": {"art": [{"amount": 3000, "recorded_at": 1779885478.371272}], "correction": [{"amount": 3000, "recorded_at": 1779885478.371272}]}, "custom": {}}