\n背景とキャラクターを分けてくださると嬉しいです！\n色々お願いしてしまい申し訳ございません・・・！\nお忙しい中恐縮ですが何卒ご検討いただけますと幸いです！！\n\nよろしくお願いいたします！", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 500701, "creator": true, "nsfw_acceptable": false, "acceptable": false, "name": "n", "screen_name": "2zxt_____", "avatar_url": "https://pbs.twimg.com/profile_images/1803154592760471555/J3YIjhg3.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1035937998444027904/1718741203/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 5, "complete_expiration_days": 120, "skills": [{"genre": "art"}], "banned": false, "nc": 17}, {"id": 1178755, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "ドスコイ人類", "screen_name": "ooo_____1i", "avatar_url": "https://pbs.twimg.com/profile_images/1370141229183164419/eET7Yot6.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1279074363157798914/1619256799/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "art"}, {"genre": "video"}, {"genre": "correction"}], "banned": false, "nc": 145}, {"id": 1462809, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "Soe【連載中･デスレスブライド】", "screen_name": "Soe_chimi", "avatar_url": "https://pbs.twimg.com/profile_images/1408404306487697414/vFdj7f4V.jpg", "header_url": "https://pbs.twimg.com/profile_banners/972869541645570048/1646330200/1500x500", "appeal_receivable": true, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, 