リング、歌うこと、ウクレレを弾くこと\n\n外見については、資料URLの画像を参考にして頂けたら幸いです。\n構図や表情、服装、シチュエーションについては、ABLM先生に全てお任せしたい気持ちです！\n\nあまりskeb依頼の経験がなく、失礼を働いていたら大変申し訳ありません...💦\nご検討の程なにとぞよろしくお願い致します。\n\nhttps://drive.google.com/drive/folders/1Aiz0oXluN0_puJwa0SZB9X-ZuPrYObi0", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}], "sent_works": [], "similar_creators": [{"id": 1705449, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "横 yoko（連絡はメールのみで", "screen_name": "Bh1h1J", "avatar_url": "https://pbs.twimg.com/profile_images/1637507099059187712/CdDdHJOG.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1432670350861426694/1761484627/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "art"}, {"genre": "video"}, {"genre": "correction"}], "banned": false, "nc": 16}, {"id": 2583181, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "knD", "screen_name": "kkk_KND", "avatar_url": "https://pbs.twimg.com/profile_images/1923405438571401216/HC0jCGZ-.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1592467940020191232/1724857985/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "art"}], "banned": false, "nc": 1}, {"id": 3047407, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "isoi", "screen_name": "isoi00", "avatar_url": "https://pbs.twimg.com/profile_images/1791122954388221952/ubEn_Dd3.jpg", "header_url": null, "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "acce