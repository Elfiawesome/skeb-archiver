nvu4e\n彼女は穏やかな超能力者で、仲間とともに最後まで戦う！彼女は、この戦いが身近な人々の多くを奪ってしまうという現実と闘っている！\n\n私たちは、毎回セッションの前に、ゲームのエネルギーを込めたイントロシーケンスを流しています: https://drive.google.com/file/d/14qCOM555rMAJqerUjbT58KFLNBqiaY_1/view?usp=sharing\n\nありがとうございました", "nc": 1, "word_count": 0, "transcoder": "audio", "creator_acceptable_same_genre": true}, {"path": "/@HaLuna1207/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "music", "tipped": true, "creator_id": 3369110, "client_id": 3329611, "vtt_url": null, "thumbnail_image_urls": {"src": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1866701425595781121%2FI4Fqllbx.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=daecc9a4e2fa2423d929eae4d90027d3", "srcset": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1866701425595781121%2FI4Fqllbx.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=daecc9a4e2fa2423d929eae4d90027d3, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1866701425595781121%2FI4Fqllbx.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a451acaa8b49b5801dd6c802d9486a39 2x, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1866701425595781121%2FI4Fqllbx.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=4cc4356217d8f9bb82722233d2d90c09 3x"}, "preview_url": "https://fcdn.skeb.jp/uploads/outputs/daef3ac5-8fe4-4351-9787-86e258352b74?response-content-disposition=inline&Expires=1781950371&Signature=f9cv1Bb3lTmSkecdvnxQ0G0p872eIpidxxvy18XLdljnWjJyZ5sclSPFzZv6y3xAeLmaj6LosbDWZlBEKXAC9CatHF6ulwrzU6-rCoyouwH7MRATJqkpvhT6Y7TZDovrzJWBOq05~ZiABm4UNIy50CltQBfqWay6mS6-e4~DFUzKIwm4VkicrOrZHgPJDre0e1PxNTNzmizUbJ345sPDV3G5mEKpsPSqsYuSj4hqFCU-QYFIJzZimyzN7VQmxL8o8ZH9gsf8gV6lRBnA2Mzoknp3-aAsxfdXs7yN6YpLjDXxxZ8iKo3RGJcn4rnVpGNDnXGOWuSFjJOnPzjLzbd09Q__&Key-Pair-Id=K1GS3H53SEO647", "duration": 156, "nsfw": false, "har