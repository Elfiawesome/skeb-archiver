しく抱きしめ、手もハンナの手に重ねている構図を希望しております。\nまた、ハンナの手には荊棘の巻きついたエマのぬいぐるみを持たせていただけたら嬉しいです。\n\nさらに、エマの翼が閉じるように二人を包み込んでいるイメージを希望しております。\n背景は、魔女化らしい幻想的な空中を飛んでいるような雰囲気だと嬉しいです。\n\n全体としては、少し切なさがありつつも、二人の強い絆が感じられるような雰囲気を希望しております。\n表情や構図の細かなアレンジ、背景の演出などは、先生のご自由な解釈で描いていただければ幸いです。\n\nご検討いただけますと幸いです。\nどうぞよろしくお願いいたします。", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@arki_hrzoi/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3999188, "client_id": 4030251, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/d47a6c67/uploads/origins/c21d20df-52e2-47e6-8c4b-abfce410e8fb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c14e98d5ab04265e9a08703f740d558f", "srcset": "https://si.imgix.net/d47a6c67/uploads/origins/c21d20df-52e2-47e6-8c4b-abfce410e8fb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c14e98d5ab04265e9a08703f740d558f, https://si.imgix.net/d47a6c67/uploads/origins/c21d20df-52e2-47e6-8c4b-abfce410e8fb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a6f3fd7a395df78cc8a06226081d1c3a 2x, https://si.imgix.net/d47a6c67/uploads/origins/c21d20df-52e2-47e6-8c4b-abfce410e8fb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ea04f5cb89ca2534bba181291ecc5898 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/d47a6c67/uploads/origins/c21d20df-52e2-47e6-8c4b-abfce410e8fb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3cfa22469463dbc5b9ad4bc1ab0e27c2", "srcset": "https://si.imgix.net/d47a6c67/uploads/origins/c21d20df-52e2-47e6-8c4b-abfce410e8fb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3cfa22469463dbc5b9ad4bc1ab0e27c2, https://si.imgix.net/d47a6c67/uploads/origins/c21d20df-52e2-47e6-8c4b-abfce410e8fb?bg=%23fff&auto=