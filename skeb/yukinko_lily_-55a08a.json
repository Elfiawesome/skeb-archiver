se it for\n I would like to use this illustration for Twitter and other social networking sites, as well as for YouTube videos and thumbnails. Illustration size and file format\n If possible, we would like to receive the illustration in PSD format. We may use only the characters, so it would be helpful if you could separate them from the text, background, etc!\n Thank you very much for your consideration.\n                                                                      Lily Yukimura\n\nhttps://x.com/yukinko_lily_", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Nyan_McQ/works/46", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 159947, "client_id": 3407520, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/f98c338d/uploads/origins/4845a221-91fe-4df5-9926-9226d0fd8e31?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c898fc501a213b7ff5a3718cd5c77a89", "srcset": "https://si.imgix.net/f98c338d/uploads/origins/4845a221-91fe-4df5-9926-9226d0fd8e31?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c898fc501a213b7ff5a3718cd5c77a89, https://si.imgix.net/f98c338d/uploads/origins/4845a221-91fe-4df5-9926-9226d0fd8e31?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=df1634503c698c44505a3273a6941f71 2x, https://si.imgix.net/f98c338d/uploads/origins/4845a221-91fe-4df5-9926-9226d0fd8e31?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=775d040b16e7dbe25d42c8efa6a0a6f5 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/f98c338d/uploads/origins/4845a221-91fe-4df5-9926-9226d0fd8e31?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=da99b02ae27b135615c06888f0f67755", "srcset": "https://si.imgix.net/f98c338d/uploads/origins/4845a221-91fe-4df5-9926-9