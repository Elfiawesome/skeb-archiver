足①:男の子は結構世話は焼いてくれるタイプではありますが こういった戦略ゲームをするときは相手を揺さぶってきたり出方をよく観察してます。強いです。基本手は抜きませんが、時と場合と相手(小さい子など)によっては負けてくれることもあります。  \n\n補足②:女の子は表情にわりと出にくいタイプの子なのでポーカーフェイスが得意です。演技も上手いです。ボードゲームは不慣れですが 逆に言うと経験数が少ないというだけで未知数ということでもあります。  \n\nキャラクター資料は別途添付しているのをご参考ください。服装と髪型は資料を参考に。漫画の頁数/構図/台詞/表情などそのほかのことはお任せします。ご検討の程を宜しくお願いします。不備や条件が合わなかったり難しいようでしたらご遠慮なくキャンセルしてください。ご縁が有りましたらよろしくお願いします。\n\nhttps://twitter.com/motimiya3/status/1746099720781758489?s=46&t=fGic49pC1f9Y616d52FFOg", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@ASGoshio/works/7", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/598c7119/uploads/origins/d63ad746-7b8a-4068-900d-d982bf74c0f4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=ca648a358977efbc7ce12f2e76c24d2d", "src_set": ""}, "private": true, "genre": "art", "tipped": false, "creator_id": 2959544, "client_id": 1351317, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 16, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@ASGoshio/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2959544, "client_id": 2683933, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/18456595/uploads/origins/a720cced-10cc-412f-9553-d856845c4eeb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3d0a3588f9756547c493c4c5da12d19a", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/18456595/uploads/origins/a720cced-10cc-412f-9553-d856845c4eeb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=36a79348cded0e368f6750ddf8137652", "src_set": ""}, "body": "は