h=200&blur=200&s=b902be8b2b43e1d0b248e98921e9a510", "srcset": "https://si.imgix.net/ab718b83/uploads/origins/a6caf825-d754-42fc-9b47-77ee681db523?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b902be8b2b43e1d0b248e98921e9a510, https://si.imgix.net/ab718b83/uploads/origins/a6caf825-d754-42fc-9b47-77ee681db523?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=0fb97e5854399e176d50e344c08ffae3 2x, https://si.imgix.net/ab718b83/uploads/origins/a6caf825-d754-42fc-9b47-77ee681db523?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=dad28956fb5b1c0dc2c95ecbc2e105a1 3x"}, "body": "こんにちは。初めて依頼させていただきます。\n【キャラクター】\n・楠芽吹\n【衣装】\n防人の戦衣\n【シチュエーション】\n・後背位のような体勢で、ぴっちりした戦衣に包まれた尻をこちら側に突き出している。\n腰布のパーツはどかされて、尻が丸見えな構図。\n・表情→振り向いてはいるが、顔を真っ赤にしてぐぬぬ…とした怒り顔。(「戦衣のケツで見抜きさせて」と頼まれた、という設定)\n\n過去のゆゆゆインナー作品が素晴らしかったのでご依頼させていただきます。よろしくお願いします。", "nc": 48, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@fudesato/works/13", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/32a62d1c/uploads/origins/8047808d-906f-4146-a759-d6cb56f8970e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=7fd325796ea96698acf7183da9b33b6f", "srcset": "https://si.imgix.net/32a62d1c/uploads/origins/8047808d-906f-4146-a759-d6cb56f8970e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=7fd325796ea96698acf7183da9b33b6f, https://si.imgix.net/32a62d1c/uploads/origins/8047808d-906f-4146-a759-d6cb56f8970e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=13c38c2589753a3a5ad5faebc8a45863 2x, https://si.imgix.net/32a62d1c/uploads/origins/8047808d-906f-4146-a759-d6cb56f8970e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=79a992c7eeda93e0828a0523650524ba 3x"}, "private": true, "genre": "art", "tipped": true, "creator_id": 247342, "nc": 161}, {"path": "/@fudesato/works/12", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 247342, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/e64df236/uploads/origins/3d331309-614f-4610-8083-b704c22cb309?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f84bd61f6732601010cf702afe0dfde7", "srcset": "https://si.imgix.net/e64df236/uploads/origins/3d331309-614f-4610-8083-b704c22cb309?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f84bd61f6732601010cf702afe0dfde7, https://si.imgix.net/e64df236/uploads/origins/3d331309-614f-4610-8083-b704c22cb309?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=70f04d330e2bce45519197b1cb9483bd 2x, https://si.imgix.net/e64df236/uploads/origins/3d331309-614f-4610-8083-b704c22cb309?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a784beeb588276ac71e2e3a08cf8daa1 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/e64df236/uploads/origins/3d331309-614f-4610-8083-b704c22cb309?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b33e3780dfb89d953772167f0d7b9e1b", "srcset": "https://si.imgix.net/e64df236/uploads/origins/3d331309-614f-4610-8083-b704c22cb309?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b33e3780dfb89d953772167f0d7b9e1b, https://si.imgix.net/e64df236/uploads/origins/3d331309-614f-4610-8083-b704c22cb309?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=836c193ab69dd6c29cc80c79801fa42b 2x, https://si.imgix.net/e64df236/uploads/origins/3d331309-614f-4610-8083-b704c22cb309?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=16b665b317d5bb27124517def659319f 3x"}, "body": "筆里むぅ様\n\nこんばんは。\n先日はかわいい三ノ輪銀ちゃんをありがとうございました。\n素晴らしい尻でした。\nあのピッチリインナーの尻を見ていたら、ピッチリインナーでピッチリした股間(スジ)も見たくなってしまいました。\n差分のような形になるのですが、あのイラストで銀ちゃんの股間に当てた手をどかして股間を露わにしたものをお願いできないでしょうか。\n手は完全に股から離れて、(！)みたいに股間が完全に見えるようにしてもらいたいです。\nそしてはっきり食い込んで、股間の形(スジ)やプニプニした肉の盛り上がりがわかるものがいいです。\nこの様な差分を求めたリクエストは初めてなのでこの様な書き方や金額でいいかわからないのですが、もしよろしければお願い致します。", "nc": 49, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@fudesato/works/11", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 247342, "client_id": 93409, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/87fa42fe/uploads/origins/680fed66-05f7-4f2f-bdf1-dcd708d67da9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=56de3fadf228d6bc816dec00d4bf091e", "srcset": "https://si.imgix.net/87fa42fe/uploads/origins/680fed66-05f7-4f2f-bdf1-dcd708d67da9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=56de3fadf228d6bc816dec00d4bf091e, https://si.imgix.net/87fa42fe/uploads/origins/680fed66-05f7-4f2f-bdf1-dcd708d67da9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=5fe5921bacfe0b94f6d1dd8698d1ed11 2x, https://si.imgix.net/87fa42fe/uploads/origins/680fed66-05f7-4f2f-bdf1-dcd708d67da9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=9492e992c19435b0c76c9d6d79b084ca 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/87fa42fe/uploads/origins/680fed66-05f7-4f2f-bdf1-dcd708d67da9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=46ed04d4ef37d02563db7f2741bd99a0", "srcset": "https://si.imgix.net/87fa42fe/uploads/origins/680fed66-05f7-4f2f-bdf1-dcd708d67da9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=46ed04d4ef37d02563db7f2741bd99a0, https://si.imgix.net/87fa42fe/uploads/origins/680fed66-05f7-4f2f-bdf1-dcd708d67da9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=2f2389aea996c27faf5bd09ebd8acad7 2x, https://si.imgix.net/87fa42fe/uploads/origins/680fed66-05f7-4f2f-bdf1-dcd708d67da9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=183eee9f1d2cc4d9a41b0823b785eee0 3x"}, "body": "Xから来ました。\n良ければ「結城友奈」をお願いしたいです…！\n\n衣装は讃州中スク水で、（私の胸も、東郷さんや風先輩みたいに大きかったらなぁ）と思ってそうな感じで自分の胸を揉んでいるシーンをお願いします…！\n\n可能でしたら、スク水は腰辺りまで脱いでいて、片手は普通に揉んでいて反対側の手は下腹部or股間部へ伸びていて自慰開始直前みたいな雰囲気になっていますと幸いです", "nc": 160, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@fudesato/works/10", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 247342, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/b5b8b654/uploads/origins/6ca62fec-5612-4342-9be3-28188a846277?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c77faa89f7999193ba7337b3d85156b4", "srcset": "https://si.imgix.net/b5b8b654/uploads/origins/6ca62fec-5612-4342-9be3-28188a846277?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c77faa89f7999193ba7337b3d85156b4, https://si.imgix.net/b5b8b654/uploads/origins/6ca62fec-5612-4342-9be3-28188a846277?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=06c8e4b970221bcd5124ecc3d1d1b2ff 2x, https://si.imgix.net/b5b8b654/uploads/origins/6ca62fec-5612-4342-9be3-28188a846277?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=326586e58f3d9aca0edd43dd5020530c 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/b5b8b654/uploads/origins/6ca62fec-5612-4342-9be3-28188a846277?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=42b1d61b9cfb0e04eb18817bd153ff59", "srcset": "https://si.imgix.net/b5b8b654/uploads/origins/6ca62fec-5612-4342-9be3-28188a846277?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=42b1d61b9cfb0e04eb18817bd153ff59, https://si.imgix.net/b5b8b654/uploads/origins/6ca62fec-5612-4342-9be3-28188a846277?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=7045bbae7cdb0f58e3140502319dfd7d 2x, https://si.imgix.net/b5b8b654/uploads/origins/6ca62fec-5612-4342-9be3-28188a846277?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=25863e35dc7c6373c2305b969550e942 3x"}, "body": "筆里むぅ様、こんばんは。\n\n只今Skeb募集中、ゆゆゆ推奨とのこと。\nそこで、結城友奈は勇者であるの乃木園子ちゃんのイラストをお願いできないでしょうか。\n\n以前、筆里むぅ様の描かれた園子ちゃんのインナースーツ拝見いたしました。\nhttps://www.pixiv.net/artworks/126079435\n園子ちゃんのインナースーツは各自それぞれ解釈に違いがあると思いますが、私は筆里むぅさんのこのハイレグインナーを推したいのです。\nこのなんたるきわどい角度のハイレグよ！\n素晴らしいです！！\nむぅさんが他にもフィギュアを調べてパンツタイプのインナーを描いていることは存じておりますが、私はこのハイレグを推したいです！\n\n失礼いたしました。\n本題です。\n描いていただきたいものは、上でもお話したハイレグタイプの勇者服インナースーツを着た園子ちゃんが、\n「たまにこれ、ハイレグになるんよー」とハイレグ部分（腰と下腹部で十字になっている所）を上に引っ張っているものをお願いします。\n上に引っ張って股間のスジにインナーが食い込むような感じでお願いします。\nインナー越しの乳首のポッチもお願いします。\nポッチ表現もこちらのイラスト素晴らしかったです。\nhttps://www.pixiv.net/artworks/126079435\n\n以上です。\nどうぞよろしくお願いいたします。", "nc": 48, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@fudesato/works/9", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 247342, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/1600600a/uploads/origins/97c8e19d-3485-4249-9ceb-985726a45279?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c0923fe2f8b8d583c1852080dadafb5a", "srcset": "https://si.imgix.net/1600600a/uploads/origins/97c8e19d-3485-4249-9ceb-985726a45279?bg=%23fff