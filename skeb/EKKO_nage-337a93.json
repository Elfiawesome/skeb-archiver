考：https://drive.google.com/drive/folders/1-30HmRV6e8J6o1IRGjhSFkSYjr-Sh2EL\n\nこの二人をシナリオの中で一緒に描いていただけたらと思います。お任せします！ありがとうございました！", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@EKKO_nage/works/13", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 645514, "client_id": 1029185, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/c3e99674/uploads/origins/3a98915b-0438-4431-be51-ff67c2d9e328?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=544ec7eb0c8aa4ba93246c58c226f1ed", "srcset": "https://si.imgix.net/c3e99674/uploads/origins/3a98915b-0438-4431-be51-ff67c2d9e328?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=544ec7eb0c8aa4ba93246c58c226f1ed, https://si.imgix.net/c3e99674/uploads/origins/3a98915b-0438-4431-be51-ff67c2d9e328?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=8da990cde007dd699441b99d44736422 2x, https://si.imgix.net/c3e99674/uploads/origins/3a98915b-0438-4431-be51-ff67c2d9e328?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=bf3184399defae59f638908b1ab6ad89 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/c3e99674/uploads/origins/3a98915b-0438-4431-be51-ff67c2d9e328?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=cb2bc509bf6f28200b525ca95ed40984", "srcset": "https://si.imgix.net/c3e99674/uploads/origins/3a98915b-0438-4431-be51-ff67c2d9e328?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=cb2bc509bf6f28200b525ca95ed40984, https://si.imgix.net/c3e99674/uploads/origins/3a98915b-0438-4431-be51-ff67c2d9e328?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=7fe2545b950da89eab161cb32ea4bd9b 2x, https://si.imgix.net/c3e99674/uploads/origins/3a98915b-0438-44