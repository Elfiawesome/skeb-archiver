&crop=top&w=200&h=200&s=57b66c26a424d755b1dd8576c699b0e2, https://si.imgix.net/7ab27d71/uploads/origins/55cc685c-8fbe-4436-88d8-c4c9db4f6cf1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=151cf9cc4d3dd8193ef3648c7765e9d8 2x, https://si.imgix.net/7ab27d71/uploads/origins/55cc685c-8fbe-4436-88d8-c4c9db4f6cf1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=141e07cc78d97d60ca54d5657970baa4 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/7ab27d71/uploads/origins/55cc685c-8fbe-4436-88d8-c4c9db4f6cf1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=cd0d1a73649853d5b2794b7a7f2ae82a", "srcset": "https://si.imgix.net/7ab27d71/uploads/origins/55cc685c-8fbe-4436-88d8-c4c9db4f6cf1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=cd0d1a73649853d5b2794b7a7f2ae82a, https://si.imgix.net/7ab27d71/uploads/origins/55cc685c-8fbe-4436-88d8-c4c9db4f6cf1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=6618271a000c91039333a3752d97efb5 2x, https://si.imgix.net/7ab27d71/uploads/origins/55cc685c-8fbe-4436-88d8-c4c9db4f6cf1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=653d9696554bb389323f9f14b8b5dc94 3x"}, "body": "資料URLに載っている、緑髪の私のオリジナルキャラクターを描いていただきたいです。\n構図（全身・バストアップ・顔のみなど）はおまかせします。資料によって多少衣服の設定が異なりますが、細かい部分は気にしませんので、ご自由に描いてください。\nなによりもこのキャラクターの二重人格という設定の要素を、青空さんナイズドした感じでイラストに入れていただきたいです。\n以下二重人格の話の詳細です。\n・外的要因（トラウマなどではなく、細胞が分裂するように促されたようなこと）によって幼少期に二重人格になった\n・主人格にサブ人格が生えてきた状態であった\n・サブ人格は表に出ることなくずっと主人格の様子を眺めていた\n・それによって主人格はうっすらと、生活の全てを見られている感覚があった\n・主人格はそれによって気が滅入っていき、そこにたまたま神話生物・超次元的存在・上位存在のようなものに出くわして、廃人（いわゆるSAN 0）になった\n・サブ人格は、自分が現状の一端を担っていることに気がつかないまま、主人格がいつか戻ってくることを信じて、その身体を維持すべく、食事などを代行し続けて暮らしている\n・また、もう一つの元凶（サブ人格にとってはそれだけが元凶）である超次元的存在に復讐をすることを決意している\n・サブ人格は主人格本位、主人格が全てなので、他者に対して攻撃的である\n・主人格は現在、外部からの刺激にほぼ反応しない状態であるが、発狂現場が川辺であったため、雨や水辺には過剰な拒絶の反応を示す\n\n資料一枚目が左が主人格、右がサブ人格の概念です。\n資料二枚目真ん中、赤坂幸喜が該当のキャラクターです。\n資料三枚目は主人格の昔の姿ですが、参考程度に見ていただいて、現在の壊れ切った彼を描いていただきたいです。\nどちらを描くか、どちらも描くか、フレーバー的に片方を入れるか、なども金額との兼ね合いで、お任せします。\n\nhttps://drive.google.com/drive/folders/1HuRv47-FaszuRppkdv3EOZPfVoMd6JP0", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@8_senkou/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1366567, "client_id": 643730, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/ee6639f4/uploads/origins/adf850bb-94aa-4038-9c6e-3beac88d6dda?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fcb16e8b00f677e482d8c14738aaf0ce", "srcset": "https://si.imgix.net/ee6639f4/uploads/origins/adf850bb-94aa-4038-9c6e-3beac88d6dda?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fcb16e8b00f677e482d8c14738aaf0ce, https://si.imgix.net/ee6639f4/uploads/origins/adf850bb-94aa-4038-9c6e-3beac88d6dda?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b76c8efe87982b61eda5fc174fa4dbfe 2x, https://si.imgix.net/ee6639f4/uploads/origins/adf850bb-94aa-4038-9c6e-3beac88d6dda?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d0ccba54494af19cf0f8b862a6b16408 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/ee6639f4/uploads/origins/adf850bb-94aa-4038-9c6e-3beac88d6dda?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f62ca95ff5c7d9b1bb131276a6099649", "srcset": "https://si.imgix.net/ee6639f4/uploads/origins/adf850bb-94aa-4038-9c6e-3beac88d6dda?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f62ca95ff5c7d9b1bb131276a6099649, https://si.imgix.net/ee6639f4/uploads/origins/adf850bb-94aa-4038-9c6e-3beac88d6dda?bg=%23fff&auto=format%2Ccompress&