いですが、引き受けていただけると嬉しいですもし遊戯王が無理なら、アニメの可愛い女の子にするだけでもいいと思います。\n\nHttps://drive.google.com/drive/folders/1xo4_FTQZaAua5IAmlsZa6X--n6HLaynN", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@motituke_0kami/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1002593, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/db908697/uploads/origins/112f2a79-3a8b-4398-b4dc-b0b4fbaad363?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=47dab10c1584db93abd706e5683f5ec6", "srcset": "https://si.imgix.net/db908697/uploads/origins/112f2a79-3a8b-4398-b4dc-b0b4fbaad363?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=47dab10c1584db93abd706e5683f5ec6, https://si.imgix.net/db908697/uploads/origins/112f2a79-3a8b-4398-b4dc-b0b4fbaad363?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a0763c0502a15b05a366fec47187db76 2x, https://si.imgix.net/db908697/uploads/origins/112f2a79-3a8b-4398-b4dc-b0b4fbaad363?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=3dea3e0dc1a21afae188e736da30ec7c 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/db908697/uploads/origins/112f2a79-3a8b-4398-b4dc-b0b4fbaad363?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=85f2745dab91693a6c0a4e4786b2fffe", "srcset": "https://si.imgix.net/db908697/uploads/origins/112f2a79-3a8b-4398-b4dc-b0b4fbaad363?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=85f2745dab91693a6c0a4e4786b2fffe, https://si.imgix.net/db908697/uploads/origins/112f2a79-3a8b-4398-b4dc-b0b4fbaad363?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=913d88a04c8d5eb59e642a22ef63d0c9 2x, https://si.imgix.net/db908697/uploads/origins/112f2a79-3a8b-4398-b4dc-b