bb6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=f19d86eaab78b5c4b5b755048ee79461 3x"}, "body": "キャラはオオカミ少年のルネ君でお願い致します\n内容は、神父様相手に小悪魔的にへそで誘惑するルネ君が見たいです\n構図は、全裸で腰から上だけの人物とヘソがなるべく大きく見える感じで\n○○しないと出られない部屋のイラストと同じような感じで\nお願いします\n前回同様周りにセリフをちりばめる感じでお願いします\n\n以下の内容をセリフとしてお願いします\n\n\n・ヘソの形について（ルネ君は縦長の女性のようなへそに自信持っている）\n・ヘソを触られた感想\n・へそ好きな神父様をどう思っているか\n・へそは母親と繋がっている証だが、母親のことをどう思っているか\n・ヘソ掃除をしているか\n・ヘソ見られて恥ずかしいか\n・神父様はでべそだがどう思うか\n・ヘソのエピソードについて（ルネ君が経験していそうなこと）\nよろしくお願い致します", "nc": 41, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@kozirow/works/9", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 308011, "client_id": 36345, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/6cd0e958/uploads/origins/82b61992-c3a0-4cd5-ac8a-ad706d33b4f7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=783a57f581b0dc3ebb3514c5e91b6456", "srcset": "https://si.imgix.net/6cd0e958/uploads/origins/82b61992-c3a0-4cd5-ac8a-ad706d33b4f7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=783a57f581b0dc3ebb3514c5e91b6456, https://si.imgix.net/6cd0e958/uploads/origins/82b61992-c3a0-4cd5-ac8a-ad706d33b4f7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=1ac0c9ba9dfb8942e8ae88ea7411df3c 2x, https://si.imgix.net/6cd0e958/uploads/origins/82b61992-c3a0-4cd5-ac8a-ad706d33b4f7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=04d85a550e247030c5d6de2399cfdf76 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/6cd0e958/uploads/origins/82b61992-c3a0-4cd5-ac8a-ad706d33b4f7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=92cf2be691e89acc3a61cb90be80aa82", "srcset": "https://si.imgix.net/6cd0e958/uploads/origins/82b61992-c3a0-4cd5-ac8a-ad706d33b4f7?bg=%23ff