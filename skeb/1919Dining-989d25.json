n・お尻に入っていた拡張プラグは背中に乗せて下さい。その際、ローションでプラグがドロドロに濡れている様にして下さい。\n・表情はあまりの気持ち良さでとろけてしまっている感じでお願いします。\n（構図的に顔が隠れてしまう様でしたら、帽子は無しにして頂いても大丈夫です。）\n・唾液が糸を引いてだらだらと垂れている様にして下さい。\n\nキャラクターの資料をお付け致します。\nご検討のほどよろしくお願いします。\n\nhttps://drive.google.com/drive/folders/1RHITQr0FViS7cEdgxVY9iumbNu30geBT?usp=sharing", "nc": 160, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@1919Dining/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1262475, "client_id": 405907, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/b6f9d720/uploads/origins/94e35299-6040-4959-bc92-fab28a5b0669?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ae0affaed1f3154dcc5bc3d994d7aa76", "srcset": "https://si.imgix.net/b6f9d720/uploads/origins/94e35299-6040-4959-bc92-fab28a5b0669?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ae0affaed1f3154dcc5bc3d994d7aa76, https://si.imgix.net/b6f9d720/uploads/origins/94e35299-6040-4959-bc92-fab28a5b0669?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=8efd09641bb44072e319fef83e8cd4cb 2x, https://si.imgix.net/b6f9d720/uploads/origins/94e35299-6040-4959-bc92-fab28a5b0669?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=435cf880b9901684f7d19311679d2242 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/b6f9d720/uploads/origins/94e35299-6040-4959-bc92-fab28a5b0669?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=850d83fd8aa0ca54489b5a33446c0742", "srcset": "https://si.imgix.net/b6f9d720/uploads/origins/94e35299-6040-4959-bc92-fab28a5b0669?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=850d83fd8aa0ca54489b5a33446c0742, https://si.imgix.net/b6f9d720/uploads/origins/94e35299-6040-4959-bc92-fab28a5b0669?bg=%23fff&auto=form