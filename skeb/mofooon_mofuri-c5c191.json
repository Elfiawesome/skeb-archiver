auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=e48fbe6f437d3d3053454717f472b178 3x"}, "body": "Hello, nice to meet you\n\n私の蛇とポケモンのデルフォックスの友達の絵をお願いしたいのですが\nアニメ「メイドインアビス」に出てくる冒険者たちを描いてほしいです。\n二人とも元気な表情をしています。\nヘビはメス、デルフォックスはオスです。\nできれば、背景は自然・ファンタジー系でお願いします。\n以下のリンクの参考文献をご利用ください。\nこのリクエストを受け入れてくださる方、ありがとうございます。\n\nhttps://www.dropbox.com/sh/3xhm5baffd5d1fm/AAAmdecIEe7zmlRZUSD_8yn2a?dl=0", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@mofooon_mofuri/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1550200, "client_id": 17931, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/7ef16b0c/uploads/origins/80c64470-2baa-47ed-ab8c-984c4d9d0d09?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fe2aeaa27c21362a23a08aa2a8502451", "srcset": "https://si.imgix.net/7ef16b0c/uploads/origins/80c64470-2baa-47ed-ab8c-984c4d9d0d09?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fe2aeaa27c21362a23a08aa2a8502451, https://si.imgix.net/7ef16b0c/uploads/origins/80c64470-2baa-47ed-ab8c-984c4d9d0d09?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=6f07cf211f6c901899ef5733525d5cb9 2x, https://si.imgix.net/7ef16b0c/uploads/origins/80c64470-2baa-47ed-ab8c-984c4d9d0d09?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=206b6127865af211c7568915ccb33fc2 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/7ef16b0c/uploads/origins/80c64470-2baa-47ed-ab8c-984c4d9d0d09?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0e2ac5d9aa8409c7fc723059920b4121", "srcset": "https://si.imgix.net/7ef16b0c/uploads/origins/80c64470-2baa-47ed-ab8c-984c4d9d0d09?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0e2ac5d9a