ラや食べ物が大好きで、遊び心がある一方でちょっとおバカなところもあります。また、絵や魔法の才能にも恵まれています。 可愛く描いていただければ、ポーズや表情はなんでも構いません！人間、スライム、そして本来の姿の3つの形態から、お好きなものを選んで自由に描いてみてください！\n\n人間形態のジャミーは、唇の上にほくろがあり、瞳には瞳孔があり、角が1本、頭に耳があり、靴は履いておらず、ヘアクリップを2つつけています。どこに行く時も必ず靴下を履いています！\n\nhttps://drive.google.com/drive/folders/1BdSG0oqKeiYaEwPdoZjF1a1NTbPvqCwU?usp=sharing", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@neeeemm221/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 4140169, "client_id": 3502853, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/e19cf53e/uploads/origins/57af6d33-1f67-4e68-a73f-7c42f27e4c86?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8358356fd5b77001beba7f3c93a4e430", "srcset": "https://si.imgix.net/e19cf53e/uploads/origins/57af6d33-1f67-4e68-a73f-7c42f27e4c86?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8358356fd5b77001beba7f3c93a4e430, https://si.imgix.net/e19cf53e/uploads/origins/57af6d33-1f67-4e68-a73f-7c42f27e4c86?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=7f1ade06c5c4e8d69096fddbc01c2a4f 2x, https://si.imgix.net/e19cf53e/uploads/origins/57af6d33-1f67-4e68-a73f-7c42f27e4c86?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f7239938b91c134e330c186ac6d24204 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/e19cf53e/uploads/origins/57af6d33-1f67-4e68-a73f-7c42f27e4c86?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f57697db005197c3ba627418d807ff96", "srcset": "https://si.imgix.net/e19cf53e/uploads/origins/57af6d33-1f67-4e68-a73f-7c42f27e4c86?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f57697db005197c3ba627418d807ff96, https://si.imgix.net/e19cf53e/uploads/origins/57af6d33-1f67-4e68-a73f-7c42f27e4