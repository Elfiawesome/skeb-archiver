8972b571-2dc8-46ec-b731-970419dfa222?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=fb2544eba5dff5ec54a0fd6c6c1d5ef6 2x, https://si.imgix.net/cfe52197/uploads/origins/8972b571-2dc8-46ec-b731-970419dfa222?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a2e9d5abb5ee4f105c2c5b9b532b8e1b 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/cfe52197/uploads/origins/8972b571-2dc8-46ec-b731-970419dfa222?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=7a22431e149dcdb6579c9ae14aeb8ada", "srcset": "https://si.imgix.net/cfe52197/uploads/origins/8972b571-2dc8-46ec-b731-970419dfa222?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=7a22431e149dcdb6579c9ae14aeb8ada, https://si.imgix.net/cfe52197/uploads/origins/8972b571-2dc8-46ec-b731-970419dfa222?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=03c7ea902961336785b2bd24f54c7a11 2x, https://si.imgix.net/cfe52197/uploads/origins/8972b571-2dc8-46ec-b731-970419dfa222?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=9309766c11bcfcf8cd188fd292a70e85 3x"}, "body": "三角海さんはじめまして。\niL=NuLLa（イル＝ヌーラ）という名で活動をしておりますVTuberです。\n三角海さんのすらっとした絵柄で当方を見て見たいと思い、リクエストを送らせていただきました。\n活動で使用するわけではなく、個の観賞用となります。\n\n\n容姿はURLの内容をご参照ください。古い資料もある上、わかりにくい部分もあるかもしれませんが、リニューアルと記載のあるものが最新デザインとなっており、それ以外はおよそこんな装いをしてきたという参考にしていただければと思います。自由にアレンジして頂いたり、新たにデザインして頂いてもかまいません。\nまた、シチュエーションや構図などもお任せいたします。\n\n以下は送付の資料の画像集ではわかりにくそうな詳細や、制作の際のタネとして使えるかもしれないと思った軽い自己紹介です。\n\n・虚無という概念がバーチャルという世界のバグにより自我を得て、ネット情報から惹かれた要素を組み合わせて自分の姿を作り上げた姿を持ちえなかった無性別人外。\n\n・なろうと思えばどのような姿にでもなれるものの今の姿の要素が気に入ってるので自分の意思を以て大幅に変わることはなく、変わった時はおおよそバグによるもの。(資料の狐がその例の一つです)\n\n・人間に近い形をとったのは多少の親しみやすさを考慮した結果\n・手のサイズは可変です。\n・ジト目で、下まつ毛が4本、目頭から目じりにかけて長くなります。\n・キツネ化している以外の装いは顔に必ず涙をあしらったピエロメイクをしています。\n・冬服時のみ、やや冬毛になり白髪面積が増えます。\n\nこれはお役に立つ情報かはわかりませんが、笑い方が魔王、見た目が魔族、と言われることも多く、反面喋るとゆるい、見た目がかっこいいポンコツと評されることもしばしばです。\n\n以上となります。わかりにくかったら申し訳ないです。\n何卒、よろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/1v_m32fh39_l9GYFAOirhCPMig5Ymc9xl?usp=sharing", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@brurunrun/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2872042, "client_id": 661505, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/4f7f0f5e/uploads/origins/74d4401b-1199-4b93-a26f-14f6d17335f5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c80745a6ed1ad9b8e66a2c2d342aaca6", "srcset": "https://si.imgix.net/4f7f0f5e/uploads/origins/74d4401b-1199-4b93-a26f-14f6d17335f5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c80745a6ed1ad9b8e66a2c2d342aaca6, https://si.imgix.net/4f7f0f5e/uploads/origins/74d4401b-1199-4b93-a26f-14f6d17335f5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=9ff927ec7870d9e4b9a2deb6cf946e2e 2x, https://si.imgix.net/4f7f0f5e/uploads/origins/74d4401b-1199-4b93-a26f-14f6d17335f5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=46bcadb6149d964db8c0c969cd321a75 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/4f7f0f5e/uploads/origins/74d4401b-1199-4b93-a26f-14f6d17335f5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a155facf5149d6880797f589aae96eee", "srcset": "https://si.imgix.net/4f7f0f5e/uploads/origins/74d4401b-1199-4b93-a26f-14f6d17335f5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a155facf5149d6880797f589aae96eee, https://si.imgix.net/4f7f0f5e/uploads/origins/74d4401b-1199-4b93-a26f-14f6d17335f5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=d35fec87c72994a3a8dcd84e40