r": {"nsfw": true}, "american_express": {"nsfw": true}}}, "acceptable_only_public": false, "tip_acceptable": true, "yearly_report_client_visible": false, "total_appeals_count": 0, "received_works": [{"path": "/@kaozemewanko/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "novel", "tipped": false, "creator_id": 1472846, "client_id": 3599438, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/024a5c95/uploads/origins/53d6b3d5-0a02-418a-9a68-b95bc3535439?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0e8c7039c554d615b103395be7b5aa87", "srcset": "https://si.imgix.net/024a5c95/uploads/origins/53d6b3d5-0a02-418a-9a68-b95bc3535439?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0e8c7039c554d615b103395be7b5aa87, https://si.imgix.net/024a5c95/uploads/origins/53d6b3d5-0a02-418a-9a68-b95bc3535439?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e4ab11c192ffe1f86158e04fb2a70350 2x, https://si.imgix.net/024a5c95/uploads/origins/53d6b3d5-0a02-418a-9a68-b95bc3535439?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d3fd162225a6e1e5f00d637465d7bc54 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/024a5c95/uploads/origins/53d6b3d5-0a02-418a-9a68-b95bc3535439?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ed7a97108c997198d79742a19df04fb8", "srcset": "https://si.imgix.net/024a5c95/uploads/origins/53d6b3d5-0a02-418a-9a68-b95bc3535439?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ed7a97108c997198d79742a19df04fb8, https://si.imgix.net/024a5c95/uploads/origins/53d6b3d5-0a02-418a-9a68-b95bc3535439?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=bfd589efdb90304d370a0629269b5fd9 2x, https://si.imgix.net/024a5c95/uploads/origins/53d6b3d5-0a02-418a-9a68-b95bc3535439?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=b4056cac01cbbf340d18e5ff35f2df39 3x"}, "body": "リクエスト送らせていただきます。\n以前あった椅子取りゲーム（運ゲー）の続編お願いします。\nストーリー\nとある場所に集められた5人のアイドル。そこではご褒美をかけた楽しいゲーム行われる。しかし、その裏ではとんでもないゲームが行われるのだった。\nキャラクター\n表\n①我那覇響\n②伊吹翼\n③宮本フレデリカ\n④三峰結華\n⑤藤田ことね\n司会　玲音\n裏\n①1星井美希、2四条貴音、3天海春香、4如月千早\n②1春日未来、2最上静香、3白石紬、4桜守歌織\n③1速水奏、2塩見周子、3城ケ崎美嘉、4一ノ瀬志希\n④1月岡恋鐘、2幽谷霧子、3田中摩美々、4白瀬咲耶\n⑤1花海咲希、2月村手毬、3葛城リーリヤ、4紫雲清香\n\n椅子取りゲーム\n表グループルール\n①円状に並べられた5つの椅子。その椅子には1～5の数字が振られている。\n②5つの椅子のどれかが当たりになっている。当たりを引くとご褒美をもらえる。当たりは４つ。\n③ご褒美は、美味しいデザートや高級エステなどの本当に喜ぶもの\n④全員がハズレを一回ずつ引くまでゲームは続く\nここから下は最後に伝えられる\n⑤当たり多く引いた順番で順位がつけられる。順位が高い人ほど罰ゲームを受ける回数が多くなる\n１位　5回\n２位　4回\n３位　3回\n４位　2回\n５位　1回\n⑥受ける罰は、裏グループが受けた罰と同じかグレードアップしたものが与えられる。\n⑦裏グループの存在と姿はゲーム終了時に知らされる。\n裏グループルール\n①表グループが当たりを引いた場合、同じチームのメンバーの誰かが罰を受ける。表グループがハズレを引いた場合罰を回避できる。\n②罰を受ける順番は、1から順に受けていく4までいくとまた1に戻る。\n③罰ゲームの内容と罰を受ける人数は各ゲームが始まる前に知らされる。一回のゲームで罰を受ける人数1～4人。\n\n罰の種類\n基本的にはおまかせしますが入れてほしいのは、\n墨汁＋粉\n顔塗りや落書き系です。\n後はバッチリメイクと言う罰を入れてほしいです。これはオカマがするような厚化粧を無理矢理させられるものです。\n\n結末\n展開はある程度自由で大丈夫なのですが、最後だけは我那覇響が1位になり５回罰を受けることになるが前回賞品を思い出し司会の玲音に擦り付ける展開にして欲しいです。\n\n長文の内容ですがぜひお願いします。", "nc": 24, "word_count": 9010, "transcoder": "text", "creator_acceptable_same_genre": false}, {"path": "/@kaozemewanko/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "novel", "tipped": false, "creator_id": 1472846, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/4b860394/uploads/origins/6ec1c578-51a5-4e2f-ba53-d987fbd8f316?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7f24cf3611903be9a8ac9db5d61a6fb5", "srcset": "https://si.imgix.net/4b860394/uploads/origins/6ec1c578-51a5-4e2f-ba53-d987fbd8f316?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7f24cf3611903be9a8ac9db5d61a6fb5, https://si.imgix.net/4b860394/uploads/origins/6ec1c578-51a5-4e2f-ba53-d987fbd8f316?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=4d24a805d61527b6e40f9f61bf7725ce 2x, https://si.imgix.net/4b860394/uploads/origins/6ec1c578-51a5-4e2f-ba53-d987fbd8f316?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=045788f8dbfafb58f74a92e85d574ecb 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/4b860394/uploads/origins/6ec1c578-51a5-4e2f-ba53-d987fbd8f316?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=797db05f097a68864314b0d9a6de3e68", "srcset": "https://si.imgix.net/4b860394/uploads/origins/6ec1c578-51a5-4e2f-ba53-d987fbd8f316?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=797db05f097a68864314b0d9a6de3e68, https://si.imgix.net/4b860394/uploads/origins/6ec1c578-51a5-4e2f-ba53-d987fbd8f316?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=08a023c8cd1d54f3637a0d042395271d 2x, https://si.imgix.net/4b860394/uploads/origins/6ec1c578-51a5-4e2f-ba53-d987fbd8f316?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=0237012fa3844d773ec3a1427dbd813f 3x"}, "body": "アイマスでリクエストお願いいたします。\n\nギャルアイドルvsパンスト仮面(ギャル)\n\n・登場人物\nギャルアイドル:城ヶ崎美嘉、城ヶ崎莉嘉\nパンスト仮面:星井美希、大槻唯、和泉愛依、紫雲清夏\n\n\n今学生の間で高い人気を誇る美嘉、莉嘉のギャル姉妹に対して、パンスト仮面で活躍しているギャルアイドルが勝負するという企画。\n\n・メイクバトル(莉嘉vs愛依)\nチャレンジャーの顔に対して、チャレンジャー以外の人物がメイク(実際にはメイクという名の落書き)。視聴者100人にアンケートし、より無様なメイクになった方の勝利。\n\n・ファッションバトル(美嘉vs清夏)\nブリーフや全身タイツ、フンドシ、かつら、鼻フック、輪ゴム、割り箸等、なるべくダサくブサイクな格好に変身。先ほど同様に視聴者アンケートを行い、よりひどい格好の勝利。\n\n・フォトバトル(莉嘉vs美希)\nオシャレな場所や映えスポットなどで、変顔や滑稽なポーズを写真に撮り、SNSにアップ。\n制限時間内に投稿した写真に否定的なコメント(ブサイク、キモい、幻滅した等)が多く寄せられた方の勝利\n写真は制限時間内であれば何枚でもアップしてよく、投稿した写真全てのコメントの数でカウント。\n\n・カラオケバトル(美嘉vs唯)\n自分の持ち歌をカラオケで歌唱して高得点を取った方の勝利。\nただし、顔スト状態で常に引っ張られていて歌いにくい上に、バイブ責めも受けているので、両者ともに満足に歌えない。\n\n・ナンパバトル(ギャルチームvsパンスト仮面チーム)\n美嘉、莉嘉ともにパンスト仮面になりきり、他のパンスト仮面と一緒に街中でナンパをする。制限時間内でより多くの人をナンパした方の勝利。\nただし、チーム全体の合計ではなく、最も多くナンパした人がいたチームが勝利となる。\n※ナンパが成功した場合、相手とキスしなければならない\n\n\n最終的に、\n・ギャルチームが負けた場合、そのままパンスト仮面となり、カリスマパンスト仮面としてSNSを開設して無様な写真を上げるように強制される\n・パンスト仮面チームが負けた場合、自分が通う学校の校門でバキュームベッドで固定され、正体を知らない友人や男子生徒から馬鹿にされる\nという罰ゲームを受ける。\n(どちらが負けるかはお任せします)\n\n\nどうぞよろしくお願いいたします。", "nc": 185, "word_count": 8430, "transcoder": "text", "creator_acceptable_same_genre": false}, {"path": "/@kaozemewanko/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "novel", "tipped": false, "creator_id": 1472846, "client_id": 3599438, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/fe463db1/uploads/origins/c4ee2a0d-f994-4bdb-ae5b-df7a4abde516?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3cccbc214899ebe182b123af36ac5e62", "srcset": "https://si.imgix.net/fe463db1/uploads/origins/c4ee2a0d-f994-4bdb-ae5b-df7a4abde516?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3cccbc214899ebe182b123af36ac5e62, https://si.imgix.net/fe463db1/uploads/origins/c4ee2a0d-f994-4bdb-ae5b-df7a4abde516?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=91888f42f7a030f239e266fa87601be6 2x, https://si.imgix.net/fe463db1/uploads/origins/c4ee2a0d-f994-4bdb-ae5b-df7a4abde516?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=81b895682bb534e23742d75dc7418149 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/fe463db1/uploads/origins/c4ee2a0d-f994-4bdb-ae5b-df7a4abde516?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e8dcb8e79ac982cd838f6b32e36e04d7", "srcset": "https://si.imgix.net/fe463db1/uploads/origins/c4ee2a0d-f994-4bdb-ae5b-df7a4abde516?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e8dcb8e79ac982cd838f6b32e36e04d7, https://si.imgix.net/fe463db1/uploads/origins/c4ee2a0d-f994-4bdb-ae5b-df7a4abde516?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=a597fd968da5533dbccc3ab94b4c9d80 2x,