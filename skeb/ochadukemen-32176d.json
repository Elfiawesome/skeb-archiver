ひとりだけ場違いのガチなピチピチ競泳水着を着ていてかなり浮いてしまって恥ずかしがっているというシチュでお願いします。\n\nその他細かいところはお任せいたします。\n\nよければ、ご検討のほどお願いいたします。", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@ochadukemen/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3639317, "client_id": 3456242, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/1ee9fd9e/uploads/origins/7b31a440-839d-488e-8686-2157658c5a34?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ec30de485ebb2bf9a92483837391b0d5", "srcset": "https://si.imgix.net/1ee9fd9e/uploads/origins/7b31a440-839d-488e-8686-2157658c5a34?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ec30de485ebb2bf9a92483837391b0d5, https://si.imgix.net/1ee9fd9e/uploads/origins/7b31a440-839d-488e-8686-2157658c5a34?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=8b966f524084770fb821d4cbca6fa2d1 2x, https://si.imgix.net/1ee9fd9e/uploads/origins/7b31a440-839d-488e-8686-2157658c5a34?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=8f1cdd5a39e2cfaf1e653fbc77ec9041 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/1ee9fd9e/uploads/origins/7b31a440-839d-488e-8686-2157658c5a34?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=77121b7f429e0b3fa66c68870c2b6ad1", "srcset": "https://si.imgix.net/1ee9fd9e/uploads/origins/7b31a440-839d-488e-8686-2157658c5a34?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=77121b7f429e0b3fa66c68870c2b6ad1, https://si.imgix.net/1ee9fd9e/uploads/origins/7b31a440-839d-488e-8686-2157658c5a34?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=6639ab4c93f8c19f3c315854325a226e 2x, https://si.imgix.net/1ee9fd9e/uploads/origins/7b31a440-839d-488e-8686-2157658c5