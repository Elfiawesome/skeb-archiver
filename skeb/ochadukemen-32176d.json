1c2-f653-40f9-914e-8fa8ef74a8e8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c88c0ab0c4c3c654d21933ac13307e31, https://si.imgix.net/7b3e9071/uploads/origins/fc2451c2-f653-40f9-914e-8fa8ef74a8e8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=2b678ac617624dc2a2878a9acc252600 2x, https://si.imgix.net/7b3e9071/uploads/origins/fc2451c2-f653-40f9-914e-8fa8ef74a8e8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=64acc6c0fc8b58bb44f9fa8b378749b8 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/7b3e9071/uploads/origins/fc2451c2-f653-40f9-914e-8fa8ef74a8e8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=74302ef65ea864da053aee5f56b620ed", "srcset": "https://si.imgix.net/7b3e9071/uploads/origins/fc2451c2-f653-40f9-914e-8fa8ef74a8e8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=74302ef65ea864da053aee5f56b620ed, https://si.imgix.net/7b3e9071/uploads/origins/fc2451c2-f653-40f9-914e-8fa8ef74a8e8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=4181479d3c1256f5efaa52a92fd366b1 2x, https://si.imgix.net/7b3e9071/uploads/origins/fc2451c2-f653-40f9-914e-8fa8ef74a8e8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=9ee8143d289ffc89344d4ec8abefb131 3x"}, "body": "初めましてじゃんばらさん。\nウマ娘とFGOの両ジャンルがお分かりになる方を探して見つけさせて頂きました。\nもしよろしければ「ウマ娘のメジロアルダンに、FGOの源頼光／丑御前（アヴェンジャー）・第一再臨のコスプレ」をさせたイラストなどお願いできるでしょうか。\n\n・衣装参考：源頼光／丑御前（FGO）\nhttps://fgogamemeister.com/archives/39506333.html\n（第一再臨はぴっちりタイツのものです）\n\n発想に至った経緯として、サポカイベントにてアルダンさんが「源頼光になった空想をする」というエピソードがあったこと。また彼女の勝負服が黒ベースにグリーンをあしらう、丑御前（＝源頼光）を彷彿するカラーリングだったり、身を削る固有スキルと宝具同士、ぶっ壊す発言繋がり……などなど、こじつけるに足る理由に個人的に盛り上がってしまったためです……。\n\n両ジャンルを分かる人でなければ難しいという理由でご依頼させて頂くため、キャラや衣装がじゃんばらさんの好みとは異なるとは存じますが、キャラは可愛く、そしてFGOの装飾ゴテゴテ衣装も細かく描き込む胆力も持ち備えてるとお見受けし、お任せできるならば幸いと思った次第です。\n\n表情や構図・ポーズついては、じゃんばらさんが思うアルダンさんのイメージのまま描いて頂けましたらOKです。あくまで「着せ替えしたアルダンさん」を拝みたいので、コスプレ元になりきって描いて頂く必要はないです。（というか元ネタになりきられて暗く病んじゃう感じのアルダンさんになるのは本意ではないためｗ）\nお茶目だったりお淑やかだったり、時々カッコつけたがったり、ノリノリで着こなすでも衣装に恥じらうでも、とにかくじゃんばらさんの解釈するアルダンさんの「らしい」振る舞いとリアクション描いて頂ければと思います！\n一応、コスプレ（衣装）がメインなので、なるべくならの範疇で十分ですが、全身が収まるような構図で、衣装姿のほどをご堪能させて頂ければ特に嬉しく思います……！\n\nなかなかに難しいお題ということは自覚しておりますが、それでもよろしければ、何卒よろしくお願いいたします！\n\nhttps://www.pixiv.net/artworks/115999216", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 284146, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "犬丸@skeb受付中", "screen_name": "kuroinusha", "avatar_url": "https://pbs.twimg.com/profile_images/901199627466166273/0wmQo5jc.jpg", "header_url": "https://pbs.twimg.com/profile_banners/69707256/1547642083/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 5, "complete_expiration_days": 30, "skills": [{"genre": "art"}, {"genre": "comic"}, {"genre": "correction"}], "banned": false, "nc": 177}, {"id": 2364861, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "いの(らぎ)", "screen_name": "Ino", "avatar_url": "https://pbs.twimg.com/profile_images/1951061373410004992/319oQUkg.jpg", "header_url": "https://pbs.twimg.com/profile_banners/734303306860765184/1730112369/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 14, "complete_expiration_days": 60, "skills": [{"genre": "art"}], "banned": false, "nc": 128}, {"id": 2584464, "creator": true, "nsfw_acceptable": false, "acceptable": false, "name": "雲💨", "screen_name": "moufu_sukinano", "avatar_url": "https://pbs.twimg.com/profile_images/1585242478785212418/KVPyQUAb.jpg",