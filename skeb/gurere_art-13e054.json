いるとサイバー感あるって感じがしますが、是非ぐるぐれれさんの考えるサイバー感を見せていただきたく…！\n\n\n「通常笑顔」「ツンとした感じの表情（戦場など緊張している時の表情）」「困った顔（判定失敗など。ぐるぐる目だとなお良し）」「怒った表情（戦闘時など）」\n「目を逸らした感じ（過去を思い出している時など）」「泣き顔」「にかっとした笑顔」「ケモミミ」\n\n\nボリュームの多いお仕事になるかも知れませんが…何卒お願い致します\n\n補足）ぺぇは小さめでお願いします。\n\nhttps://drive.google.com/file/d/1L39jWlRzO2bERKm5ECjOdKbHJoitBXku/view?usp=drive_link", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@gurere_art/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 692045, "client_id": 408016, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/bedabeed/uploads/origins/ae8fc059-2bfb-4f39-840d-41e006406012?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fd96302286aae6ad7f2bc56db3e2b669", "srcset": "https://si.imgix.net/bedabeed/uploads/origins/ae8fc059-2bfb-4f39-840d-41e006406012?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fd96302286aae6ad7f2bc56db3e2b669, https://si.imgix.net/bedabeed/uploads/origins/ae8fc059-2bfb-4f39-840d-41e006406012?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=2322c4f897db2f68cb92775ccf26952d 2x, https://si.imgix.net/bedabeed/uploads/origins/ae8fc059-2bfb-4f39-840d-41e006406012?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=91f46e62d98d58af2f34247e9ca5e56e 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/bedabeed/uploads/origins/ae8fc059-2bfb-4f39-840d-41e006406012?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=299e7ef0538e23966f30f41cd895227c", "srcset": "https://si.imgix.net/bedabeed/uploads/origins/ae8fc059-2bfb-4f39-840d-41e006406012?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=299e7ef0538e23966f30f41cd895227c, https://si.imgix.net/bedabeed/uploads/origins/ae8fc059-2bfb-4f39-840d