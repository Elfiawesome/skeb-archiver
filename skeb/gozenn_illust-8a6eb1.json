要素としては角、尖った耳、人間ではありえない色の瞳と後はお好みでお任せします。受け役は前回と同じくらいの年頃の少年で、プレイのイメージに合わせてお任せでお願いします。\n\n前回同様、身長差・体格差を強調したデザインや構図にしていただけるとありがたいです。また、修正については黒海苔または白線でお願いします。\n\nご検討いただけると幸いです。よろしくお願いします。", "nc": 58, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@gozenn_illust/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1314613, "client_id": 273863, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/4416449c/uploads/origins/9125ccda-c811-4c68-a6c8-b60469a246bd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9857e925c25e7bc244bf848d16437889", "srcset": "https://si.imgix.net/4416449c/uploads/origins/9125ccda-c811-4c68-a6c8-b60469a246bd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9857e925c25e7bc244bf848d16437889, https://si.imgix.net/4416449c/uploads/origins/9125ccda-c811-4c68-a6c8-b60469a246bd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=7eb6a46755405ba495885e4d9b4d808a 2x, https://si.imgix.net/4416449c/uploads/origins/9125ccda-c811-4c68-a6c8-b60469a246bd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=31f878dc3e2cb5daf861b0356153f0eb 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/4416449c/uploads/origins/9125ccda-c811-4c68-a6c8-b60469a246bd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ed40ef32403886a325e4a37bde904973", "srcset": "https://si.imgix.net/4416449c/uploads/origins/9125ccda-c811-4c68-a6c8-b60469a246bd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ed40ef32403886a325e4a37bde904973, https://si.imgix.net/4416449c/uploads/origins/9125ccda-c811-4c68-a6c8-b60469a246bd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=8149a9866fd47dec96e58f5f901647c6 2x, htt