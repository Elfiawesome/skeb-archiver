/origins/38d6b386-6626-437e-81ab-5e182c54043b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=21c35802f2322b3c071a76b18c05ba8f, https://si.imgix.net/1998fac6/uploads/origins/38d6b386-6626-437e-81ab-5e182c54043b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=37cbea5a076532ece52745794d1a88a6 2x, https://si.imgix.net/1998fac6/uploads/origins/38d6b386-6626-437e-81ab-5e182c54043b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=796eba6e12ccea4e6da505f95b380e52 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/1998fac6/uploads/origins/38d6b386-6626-437e-81ab-5e182c54043b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ed7afc4863f5bbb18cdf1ffc0f412416", "srcset": "https://si.imgix.net/1998fac6/uploads/origins/38d6b386-6626-437e-81ab-5e182c54043b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ed7afc4863f5bbb18cdf1ffc0f412416, https://si.imgix.net/1998fac6/uploads/origins/38d6b386-6626-437e-81ab-5e182c54043b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=a30aba353b19816855fd7f621ca2fee3 2x, https://si.imgix.net/1998fac6/uploads/origins/38d6b386-6626-437e-81ab-5e182c54043b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=c477520d4c2e92a593452393dabeed8d 3x"}, "body": "はじめまして！\nTRPG「メタリックガーディアンRPG」にて、うちの子が搭乗するガーディアン（大型人型兵器）のイラストをお願いします。\n\n●設定\nオーバーロード級（ニュータイプ専用機のようなもの）ガーディアン。型式番号、および機体名称は『YG-00/OVL アレクト』\nパイロットの適正に合わせて高機動近接戦闘機としてカスタマイズされており、機動力に特化された分軽装甲\n使われる得物は対艦刀、ダガー等、近接武装のみ\n\n大本は青と白の色合いでのみ塗装された機体だったが、戦闘により一度大破\nその後、アレクトの予備パーツで構築された予備機体『アレクト・エレメント』を組み合わせ、修理が間に合わない部位の緊急修理を行った\n突貫工事だったため塗装色の統一はされておらず、機体バランスも歪。そのため操縦性が劣悪になってしまったが、複座式にし、機体制御を担当するサブパイロットを付ける事でその弱点を補っている\n\n●外観\nガンダムシリーズのモビルスーツのような大型人型兵器\n頭部カメラアイはバイザー型\n上記設定の通り一度大破した後、損傷の大きい部分へ予備機体のパーツが組み合わされているため、各部パーツが青・白の部分と赤・灰の部分で分かれている\n腰部のリアスカートにはダガー、ビームダガーがそれぞれ左右に3本ずつ装着\n主武装としてビーム刃が片刃で形成された対艦刀を持つ\n\n下記URLに3Dモデルがありますので、外観の参考にしていただければ幸いです\nhttps://drive.google.com/drive/folders/1X3ksMXeTwY6CS_M3HhHVNgGOiHB0Nbsj?usp=share_link\n\n●ポーズ\nサンライズパースで、対艦刀を両手で構えているポーズでお願いします", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@ogu_aug12/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2122028, "client_id": 17413, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/c6a18b3a/uploads/origins/c22a7f9f-b141-402a-bdb4-d8228052a42d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=28670d2f66cfa07b7ad2aa57ccf7d5b8", "srcset": "https://si.imgix.net/c6a18b3a/uploads/origins/c22a7f9f-b141-402a-bdb4-d8228052a42d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=28670d2f66cfa07b7ad2aa57ccf7d5b8, https://si.imgix.net/c6a18b3a/uploads/origins/c22a7f9f-b141-402a-bdb4-d8228052a42d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=63e5c2b3fcb57d08592380a582232692 2x, https://si.imgix.net/c6a18b3a/uploads/origins/c22a7f9f-b141-402a-bdb4-d8228052a42d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=253f5a657290af6a8d7186f18f0ef347 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/c6a18b3a/uploads/origins/c22a7f9f-b141-402a-bdb4-d8228052a42d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=96103ce4e0a2363adfbacdb10088a195", "srcset": "https://si.imgix.net/c6a18b3a/uploads/origins/c22a7f9f-b141-402a-bdb4-d8228052a42d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=96103ce4e0a2363adfbacdb10088a195, https://si.imgix.net/c6a18b3a/uploads/origins/c22a7f9f-b141-402a-bdb4-d8228052a42d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=4083712af554a76f2b3d04ebede1d920 2x, https://si.imgix.net/c6a18b3a/uploads/origins/c22a7f9f-b141-402a-bdb4-d8228052a42d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=af64763660c5e1cc50e19ecc177e726a 3x"}, "body": "初めまして！\nうちの子、黒鉄(クロガネ)のパワードスーツ姿を描いていただけませんでしょうか？(資料参考)\nシチュエーション、背景等その他全てはお任せします。\nパワードスーツという設定ですがディテールやシルエットはロボと同等です。\nおぐ様がメカやロボを描かれる時の技法やセンスでカッコよく描いてくだされば嬉しいです。\n武装や装備、アーマーのデザインやカラーリングなども描きやすい様に自由に変更アレンジして貰って構いません、仕様変更大歓迎です！\nおぐ様の好きな要素を詰め込んで自由に楽しく描いて頂ければ幸いです。\nキャラクターの顔をよく見たいので可能でしたらヘルメットの有無とバイザー差分をpsdファイルで選択できる様にしていただけると嬉しいです。\nそれではよろしくお願いします！\n\n設定\n龍人用パワードスーツ:Tycoon(タイクーン)\n全高2.5〜3.5m 重量4〜12t(装備による)\n宇宙空間を含む様々な極限環境下での生命維持と活動を目的に作られた作業用パワードスーツ\nしかし装着の容易さ、使い勝手の良さ、メインテナンス性、頑健さ、拡張性の高さから出力を向上させ装甲化された戦闘仕様が開発された。\n二種類のカラーがあり銀灰が一般用、黒鉄は上位者用の黒を装着する\n胸部分に埋め込まれた結晶体AI『龍玉』が着装者の意図を読み取り動作を含む全機能をコントロールする\n\nhttps://drive.google.com/drive/folders/1wkSaWwt_JdatroIK_--TRZDP8lsh4uhL", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 386448, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "ししみ", "screen_name": "shishimi443", "avatar_url": "https://pbs.twimg.com/profile_images/1886351009628520448/--oeXs-0.png", "header_url": "https://pbs.twimg.com/profile_banners/420250871/1733568499/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 7, "complete_expiration_days": 60, "skills": [{"genre": "art"}], "banned": false, "nc": 128}, {"id": 670958, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "あさ光＠Skebのみ再開🌸", "screen_name": "N_morninglight", "avatar_url": "https://pbs.twimg.com/profile_images/1691077245128134658/AZHvA9RW.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1285977464145997824/1770208914/1500x500", "appeal_receivab