b879, https://si.imgix.net/1b756293/uploads/origins/deb4db96-3d54-4e0c-bcfe-492791a59bf7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=4c5a5c56f57536c14d1bea65cfd7f7b2 2x, https://si.imgix.net/1b756293/uploads/origins/deb4db96-3d54-4e0c-bcfe-492791a59bf7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a4bc1978f447c5e09de87c43b3c80367 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/1b756293/uploads/origins/deb4db96-3d54-4e0c-bcfe-492791a59bf7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=43b2ee7fea9b39d13110d131a857b06c", "srcset": "https://si.imgix.net/1b756293/uploads/origins/deb4db96-3d54-4e0c-bcfe-492791a59bf7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=43b2ee7fea9b39d13110d131a857b06c, https://si.imgix.net/1b756293/uploads/origins/deb4db96-3d54-4e0c-bcfe-492791a59bf7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=71436d4c7c1ad8f4414483dcf9157473 2x, https://si.imgix.net/1b756293/uploads/origins/deb4db96-3d54-4e0c-bcfe-492791a59bf7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=dcb30b66c47252adb56f0f786b5f0627 3x"}, "body": "新しいイラストが欲しくて依頼しました！\n今のところ、雑談枠の背景にするつもりですが、もしかしたらゆーちゅーぶのサムネとかにもするかも……ダメだったら教えてください！\n\n今の所、働いてる/作業してる感(そしてそれに参ってる感……)が伝わるような感じかな……と拙いイメージはあるんですが、そもそもゴッさんの勢いと元気の溢れるイラスト自体がめちゃくちゃ好きなので、最終的にはゴッさんのインスピレーションに任せたいと思っています！！！\n\nイラスト依頼をちゃんとするのはこれが初めてなので、拙くて恐縮です。ゴッさんの絵が欲しいので、ぜひ好きな感じで書いてくれたら嬉しいです！！！", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@ginnaaaaaaan/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2732211, "client_id": 3127563, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/e364e8b9/uploads/origins/059fab31-e4ba-41