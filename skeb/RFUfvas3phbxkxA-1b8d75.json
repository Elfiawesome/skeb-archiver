0年代のアメリカです。\n\nかっこいいオシャレな女性（本当は警官）と、オタクな医者（犯罪者のために働く）。身長はほぼ同じです。医者（男性、疲れ目で白髪）は愛想がよくてスペイシー、女性は主導権を握りがちです。女性の方が真面目だが気さくな性格だ。ドクターは意外とダンスがうまい。\n\n女性のヘアスタイルは、参考文献にあるどのスタイルでもよい。\n\n二人がディスコで楽しんでいるイラストを描いてください。ポーズや構図はお任せします!\n\nいずれにせよ、お読みいただきありがとうございました。\n\nhttps://drive.google.com/drive/folders/14BMM0ur8e7BZpkCV5EbqJt8_IDVx5ZUN?usp=sharing", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@RFUfvas3phbxkxA/works/12", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2095138, "client_id": 667554, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/1d4e5863/uploads/origins/0076005f-30de-4ace-aa81-51736f5f0e04?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4b213034653b9c201ac4750745a1f998", "srcset": "https://si.imgix.net/1d4e5863/uploads/origins/0076005f-30de-4ace-aa81-51736f5f0e04?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4b213034653b9c201ac4750745a1f998, https://si.imgix.net/1d4e5863/uploads/origins/0076005f-30de-4ace-aa81-51736f5f0e04?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=2e0e847de4aed540ad5d3decd3fc2ce1 2x, https://si.imgix.net/1d4e5863/uploads/origins/0076005f-30de-4ace-aa81-51736f5f0e04?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=014076334cd94f955a8275639450c022 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/1d4e5863/uploads/origins/0076005f-30de-4ace-aa81-51736f5f0e04?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d477acf4075ed395939aff2550f61c4d", "srcset": "https://si.imgix.net/1d4e5863/uploads/origins/0076005f-30de-4ace-aa81-51736f5f0e04?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d477acf4075ed395939aff2550f61c4d, https://si.imgix.net/1d4e5863/uploads/origins/0076005f