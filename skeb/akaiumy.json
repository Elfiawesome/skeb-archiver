e": "art", "tipped": false, "creator_id": 2061123, "client_id": 1817509, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/0018c99c/uploads/origins/50cf06ba-43ad-4742-9130-394b000d7e82?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4cd726f70a8f0fdbdbe24bbf96462914", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/0018c99c/uploads/origins/50cf06ba-43ad-4742-9130-394b000d7e82?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3838c0d9e25e22e175c007eef9450202", "src_set": ""}, "body": "はじめまして竜輝ねおる【@TatsukiNeol】といいます\n今回は私のイラストをかいていただきたく依頼させていただきました\n\n■使用用途\n配信活動(Youtube未収益化）\n・Youtubeのサムネイル\n・Youtube/Twitterで使用する画像\n・その他活動で使う画像として（活動予定表等）\n・FANBOXでの壁紙配布として\n\n納品\n背景ありのものと背景なしのもの（人物だけ透過した状態だとありがたいです）\n表情差分などあると活動での使用幅が広がるのでとてもうれしいです…\n頭身でかいていただきたいです。\nまた、姿がきれないようにおさめてほしいです。\n\n\n服装 浴衣（髪型や浴衣などはおまかせします）\n\n【性格】\nねおる　生意気なメスガキ（姉だけど妹みたいな感じ）\n\n身長　ねおる　142（ヒール込み）\n\nhttps://twitter.com/tatsukineol/status/1632349859138375680?s=46&t=8b6OLt1glYrdcPaRJ31UKQ", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@akaiumy/works/11", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2061123, "client_id": 934342, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/48be8ea3/uploads/origins/a12ac29c-96ab-499c-aae4-be27b362fc0e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4e25e0531bcb1778b59258a3ed9fcd4e", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/48be8ea3/uploads/origins/a12ac29c-96ab-499c-aae4-be27b362fc0e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=926c3bb36ef55a7ee32a307120194b84", "src_set": ""}, "body": "初めまして！！\n鳴尾有馬と申します！！\n\n今回、私が普段から仲良くさせていただいておりますVtuberのこたつむりねんねさんを有灰うみさんに描いていただきたいと思いリクエストさせていただきました！\n（リクエストに際し、あらかじめねんねさん本人、ねんねさんの立ち絵の絵師さんに依頼の許可を取っております。)\n\nポーズや表情に関して全て有灰うみさんにお任せします！\n\n使用用途としましては壁紙や待ち受け、こたつむりねんねさんご本人の配信サムネイル等を想定しています。\nまた、サムネイルで使用いただけるように、背景と人物のレイヤーを分けてほしいのと、なるべく全身を枠に収めるようにしてほしいです。(腰下やひざ下が切れる程度なら大丈夫です)\n\n最後に、もし可能でしたら表情差分１,２点ほど付けていただけたら嬉しいです。\n\nかなりわがままな内容になりますが、よろしくお願いします！！\n\n\n\n立ち絵は下記のURLです\n\nhttps://twitter.com/kotatsu_nenne/status/1409872943853809672?s=20&t=lfVyhpNz1tfDwuv19Hw-Bw", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@akaiumy/works/10", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/9d060263/uploads/origins/6abfb272-aa63-4130-b16d-f246e99f1771?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=a098dd8d31d4445b71064fcae4d27165", "src_set": ""}, "private": true, "genre": "art", "tipped": true, "creator_id": 2061123, "client_id": 1963981, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 0, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@akaiumy/works/9", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/86a95a48/uploads/origins/29f0d615-daf5-4ce8-abd1-65fc5862cc7f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=1b2e859830ab7dd247b6477099fce67a", "src_set": ""}, "private": true, "genre": "art", "tipped": true, "creator_id": 2061123, "client_id": 1339552, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 129, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@akaiumy/works/8", "private_thumb