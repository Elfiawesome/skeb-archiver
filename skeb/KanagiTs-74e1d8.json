4ad6-a42b-5e1e157912f9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=c2e47e80f04cb6d61f5865f325625341 2x, https://si.imgix.net/01f09f7f/uploads/origins/3f9ef0b1-6c13-4ad6-a42b-5e1e157912f9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=63c7ca89112c901a310cf1e06ddfb423 3x"}, "body": "こんにちは！英雄伝説 黎明の軌跡』のシズナ・レム・ミスルギ（シズナ・レム・ミスルギ）のアートワークをお願いしたいです。ビフォーアフター」のシナリオを希望します。静奈は最初、勝利に自信満々で、慇懃に笑っている。まるで、これまで何度も対戦相手とやりあってきたかのようだ。しかし、今回はいつもと違い、彼女はゴミ箱に顔から突っ込んでしまう。脚とお尻だけが見えていて、脚は恥ずかしそうに開かれている。イラストの片隅に、惨めな敗戦の表情を入れてもいいと思う。\n\n静奈の参考文献\nhttps://drive.google.com/file/d/1chd-1RtMaDUvn-W8hk9JXXXcUEp7WNP8/view?usp=sharing\nhttps://drive.google.com/file/d/1IEjgJPZvc8jltRs8rFHn6R5Ah4VQC6eA/view?usp=sharing", "nc": 177, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@KanagiTs/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3731623, "client_id": 1676206, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/0a9570b5/uploads/origins/04532f34-0cd2-411f-9dbb-06e7ac6be461?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=01f921049e7124097a95912250cf10bf", "srcset": "https://si.imgix.net/0a9570b5/uploads/origins/04532f34-0cd2-411f-9dbb-06e7ac6be461?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=01f921049e7124097a95912250cf10bf, https://si.imgix.net/0a9570b5/uploads/origins/04532f34-0cd2-411f-9dbb-06e7ac6be461?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=bd40f1b33f86b67f1cf72410932f93c3 2x, https://si.imgix.net/0a9570b5/uploads/origins/04532f34-0cd2-411f-9dbb-06e7ac6be461?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=8595c7be4eaa9d94039bccccec1e0692 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/0a9570b5/uploads/origins/04532f34-0cd2-411f-9dbb-06e7ac6be461?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3c4151d17ac6e0e26c03490d90b189ca", "srcset": "https://si.imgix.net/0a9570b5/uploads/origins/04532f34-0cd2-411f-9dbb-06e7ac6be461?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3c4151d17ac6e0e26c03490d90b189ca, https://si.imgix.net/0a9570b5/uploads/origins/04532f34-0cd2-411f-9dbb-06e7ac6be461?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=820b67669433603f603e0eaa435494b2 2x, https://si.imgix.net/0a9570b5/uploads/origins/04532f34-0cd2-411f-9dbb-06e7ac6be461?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=fcf687990cc6294ba6b4e5c5bc958b32 3x"}, "body": "こんにちは、あなたの最新のアートとポートフォリオに興味を持ったので、ぜひお願いしたいと思いました。\n\n依頼内容はゲーム「ドラケンガード3」/「ドラッグオンドラグーン3」のキャラクター「シスター・ワン」です。\nhttps://files.catbox.moe/o11d2k.jpg\n\nシナリオは即負けのようなシチュエーションです。シスター・ワンは不正を嫌い、堕落することを拒む、冷静で真面目な女性。しかし、そんな彼女が一瞬にして洗脳され、ある邪悪な花の「植木鉢」になってしまう。全裸で逆立ちをし、両脚を大きく開き、股間から花を咲かせる。それ以外の詳細はお任せする。\n\n[ポーズ参考］\nhttps://gelbooru.com/index.php?page=post&s=view&id=11071898\n\n花\nhttps://static.wikia.nocookie.net/drakengard/images/d/d3/DOD3_Flower.png/revision/latest?cb=20150327224551", "nc": 56, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@KanagiTs/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3731623, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/ee7ebe8b/uploads/origins/43554dad-6065-4937-b8e4-2d7ce27a321f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=808ceb24ea4fea66711a0c80c0172dce", "srcset": "https://si.imgix.net/ee7ebe8b/uploads/origins/43554dad-6065-4937-b8e4-2d7ce27a321f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=808ceb24ea4fea66711a0c80c0172dce, https://si.imgix.net/ee7ebe8b/uploads/origins/43554dad-6065-4937-b8e4-2d7ce27a321f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=8e2e076d71fa6251fba107bb362c61b4 2x, https://si.imgix.net/ee7ebe8b/uploads/origins/43554dad-6065-4937-b8e4-2d7ce27a321f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=3376eab68878e5528fed8a0436822906 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/ee7ebe8b/uploads/origins/43554dad-6065-4937-b8e4-2d7ce27a321f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5b2b3907c466d95f8a9b236cc761aa7f", "srcset": "https://si.imgix.net/ee7ebe8b/uploads/origins/43554dad-6065-4937-b8e4-2d7ce27a321f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5b2b3907c466d95f8a9b236cc761aa7f, https://si.imgix.net/ee7ebe8b/uploads/origins/43554dad-6065-4937-b8e4-2d7ce27a321f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=b74a402ee2a142d595c91bf625caba04 2x, https://si.imgix.net/ee7ebe8b/uploads/origins/43554dad-6065-4937-b8e4-2d7ce27a321f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=bab04907e5dccd8aedf786c036e3dae4 3x"}, "body": "いつもイラストを拝見しております。\n\nステラソラよりナズナちゃんの無様敗北シチュを是非お願いしたいです。\n\n下を剥かれた状態でうつ伏せにお尻を突き出すように倒れて失禁しており、菊門に旗の柄を突っ込まれお尻から伸びた敗北の白旗が無様にハタハタと揺れている。意識はあるものの体が動かず恥辱に耐えるほかない　といったイメージです。\n\nご検討宜しくお願い致します。\n\nhttps://stellasora.wikiru.jp/?%E3%83%8A%E3%82%BA%E3%83%8A", "nc": 168, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@KanagiTs/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3731623, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/0ba2c374/uploads/origins/e908f084-031e-4782-bc3c-bbbcd79b6263?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0e39d32f8742ba3c832740b24b092397", "srcset": "https://si.imgix.net/0ba2c374/uploads/origins/e908f084-031e-4782-bc3c-bbbcd79b6263?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0e39d32f8742ba3c832740b24b092397, https://si.imgix.net/0ba2c374/uploads/origins/e908f084-031e-4782-bc3c-bbbcd79b6263?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=1a69c80bc5f80a8f3e94b1c7a756b36a 2x, https://si.imgix.net/0ba2c374/uploads/origins/e908f084-031e-4782-bc3c-bbbcd79b6263?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=66e8d222ee23a9bff90d2b3c2ab6b0f7 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/0ba2c374/uploads/origins/e908f084-031e-4782-bc3c-bbbcd79b6263?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=36943c6a5a02d12d3fe95c79456ec017", "srcset": "https://si.imgix.net/0ba2c374/uploads/origins/e908f084-031e-4782-bc3c-bbbcd79b6263?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=36943c6a5a02d12d3fe95c79456ec017, https://si.imgix.net/0ba2c374/uploads/origins/e908f084-031e-4782-bc3c-bbbcd79b6263?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=770d8cd0d8611400b956f794f26d52a1 2x, https://si.imgix.net/0ba2c374/uploads/origins/e908f084-031e-4782-bc3c-bbbcd79b6263?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=d947b18ceafcc65e4946705b667e74d4 3x"}, "body": "こんにちは。  \n\n画風がとても好みなので依頼させて頂きたいです。\n\nカラーイラスト1枚のリクエストです。\n\n○キャラクター\n\n・ウルトラセブンの女体化キャラであるウルトラレディ・セレス\n(https://www.pixiv.net/artworks/12862994) \n\n・敵の女性宇宙人(シルエットかつ体の一部のみの描写で構いません)\n\n\n○シチュエーション\n\n・敵を前にしてイキがっているセレスだが、ボロ負けして無様な姿を晒してしまう。\n\n○構図\n\n・こちらの作品\n\nhttps://www.pixiv.net/artworks/135559328\n\nのように、即堕ち2コマの様なイメージ。\n\n・before(1コマ目)の部分は、セレスの顔のアップ。「はぁ？アンタなんかにこのあたしが負ける訳ないでしょ」と言って強気な表情を浮かべている。\n\n・after(2コマ目)の部分は、敗北してガニ股の大開脚状態で上半身が地面に埋まったセレス。\n\n・セレスは股間をこちらに向けた状態で埋まり、ピクピクと痙攣している。パンツとニーソックスがボロボロで所々が破れている。さらに、その状態で敵宇宙人に股間を踏まれて失禁し、おしっこを噴水の様に撒き散らしている。\n\n・敵の女性宇宙人の靴はハイヒールで、セレスの股間を踵でグリグリと踏みにじっている。\n\n・背景は不要です。\n\n以上です。\n\nよろしければ是非ご検討して頂けると幸いです。", "nc": 160, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@KanagiTs/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3731623, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/8a383ac4/uploads/origins/97519506-9544-4a5d-8937-93d5bded7fa7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7fb99ea864ebadf6cc74ae613e664ad3", "srcset": "https://si.imgix.net/8a383ac4/uploads/origins/97519506-9544-4a5d-8937-93d5bded7fa7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7fb99ea864ebadf6cc74ae613e664ad3, https://si.imgix.net/8a383ac4/uploads/origins/97519506-9544-4a5d-8937-93d5bded7fa7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=5e723effd25a0915b79d5bfab248d7c5 2x, https://si.imgix.net/8a383ac4/uploads/origins/97519506-9544-4a5d-8937-93d5bded7fa7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=6d5cc3d32a4051d34bcbf8103fd5f3ac 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/8a383ac4/uploads/origins/97519506-9544-4a5d-8937-93d5bded7fa7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=404442400c2840f6d3a7b923de421e7e", "srcset": "https://si.imgix.net/8a383ac4/uploads/origins/97519506-9544-4a5d-8937-93d5bded7fa7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=404442400c2840f6d3a7b923de421e7e, https://si.imgix.net/8a383ac4/uploads/origins/97519506-9544-4a5d-8937-93d5bded7fa7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=7e701697a7a7b88e86a612d6e981931a 2x, https://si.imgix.net/8a383ac4/uploads/origins/97519506-9544-4a5d-8937-93d5bded7fa7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=22768655e1126bb239cf7f26cf945f1e 3x"}, "body": "作品楽しませてもらっています。\n下記のイキリ即堕ち裸踊りのイラストが素晴らしかったので、リクエストさせて頂きます。\n参考作品：https://www.pixiv.net/artworks/134934864\n\n艦これの龍田が裸踊りしているイラストをお願いします。\n上記の参考作品のような、左右コマのビフォーアフター風かつカラーでお願いします。\nイラストの雰囲気も参考のように「相手をナメてイキってたら、あっさり無力化されて即オチ無様を晒す強キャラ（気取り）」というイメージでお願いします。\n\n作品の構図ですが、\n①ビフォー：参考のように、胸元くらいが見える立ち絵。普通の服装\n・武器や装備は省略してもらって構いません\n・余裕綽々といった感じの表情\n\n②アフター：一糸纏わぬ素っ裸で、両手に扇子を持ち、ヒョコヒョコとガニ股裸踊りをしている。\n・参考のように、何処も隠せてない丸見え踊りをさせて下さい。\n・頭から爪先まで、全身が見える構図でお願いします。\n・表情も参考のように、眉をキリッとしつつ、口を突き出したような間抜けな顔（鼻フックは無し）でお願いします。\n・陰毛は濃ゆ目、お尻を大きく書いて下さると有り難いです。\n・龍田の横に、宴会で見る「めくり看板」を置いて、看板に「（軽巡龍田の文字が赤い☓で消されてる）チンポコ勃つ田　変態一発芸」と書いて下さい。\n龍田の頭に浮いてる輪っかも、看板の上に雑に掛けられてる状態にして下さい。\n\n\n普段描かれてない作品ですので、セリフや状況説明文を考えて頂かずとも大丈夫ですが、\nよろしければ、以下のセリフを使って下さい。\n\n①ビフォー\n「誰ですかあなた？鎮守府の関係者じゃないですよね〜？\n…私に裸踊りしてもらう？訳が分からない上に悪趣味ね〜\nそういうことを言う舌は要らないですよね〜？」\n\n「そんな馬鹿なこと、させられるか試してみたらどうですか〜？」\n\n②アフター\n「んぉ\"っ///」「ほっ///」「お\"ほっ♥」\n「ほっ♥ほっ♥ほひっ///」「ほいっ！♥ほいっ！♥」\n\n\n\n要求が多く申し訳ありませんが、受けて頂くと大変嬉しいです。\nよろしくお願いします", "nc": 160, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@KanagiTs/works/3", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/1ff509cf/uploads/origins/f308a0f6-0ab0-4d09-8bd2-31fa1d5aaae6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=e989c0ba352720af48b6a420e1bea0a9", "srcset": "https://si.imgix.net/1ff509cf/uploads/origins/f308a0f6-0ab0-4d09-8bd2-31fa1d5aaae6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=e989c0ba352720af48b6a420e1bea0a9, https://si.imgix.net/1ff509cf/uploads/origins/f308a0f6-0ab0-4d09-8bd2-31fa1d5aaae6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr