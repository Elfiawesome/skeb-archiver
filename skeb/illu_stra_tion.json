ec88/uploads/origins/ca400de0-eb23-41de-a2b8-9edf9a26ca97?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a3202090924bbd88a49a2d478a319473 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/9308ec88/uploads/origins/ca400de0-eb23-41de-a2b8-9edf9a26ca97?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=75ea4b1c5c3213a5a66e2950b40eebdb", "srcset": "https://si.imgix.net/9308ec88/uploads/origins/ca400de0-eb23-41de-a2b8-9edf9a26ca97?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=75ea4b1c5c3213a5a66e2950b40eebdb, https://si.imgix.net/9308ec88/uploads/origins/ca400de0-eb23-41de-a2b8-9edf9a26ca97?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=1c45178de86667829ad8c527f17f700b 2x, https://si.imgix.net/9308ec88/uploads/origins/ca400de0-eb23-41de-a2b8-9edf9a26ca97?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=2607806897025289ad2b0a794fa6597f 3x"}, "body": "いつも見てます❗️一次二次関係なく創作への熱量が強くて尊敬してます‼️\n特に創作キャラちゃんくんたちが大好きで！大っっっっっ好きで！！どうやっても推しを絞れないし何度も何度もCSを見ては勝手にデカ感情を抱えてます🤝色々綴ってたら平気で2000字オーバーしそうなのでここでは頑張って抑えます…好きです…\n\n\n今回はすとらさんにOCのイラストをリクエストさせていただけたらと思います！詳細は以下の通りです\n\n◇プロフ\nウロ\n・20歳\n・武器は拳銃(特定を避けるためタイプやモデルは日替わり)\n・無口かつ思考回路が読めない性格で感情の起伏が表情に現れることは少ない。判断基準がなんかちょっとズレてたり他者との距離感がバグってたり。\n・人間辞めてるレベルの殺しの才能と経験の持ち主だが、やる気のオンオフが極端で事後報告や書類整理といった雑務が特に大嫌い。そのせいで二重人格説や双子説が浮上し始めている。\n\nチリ\n・19歳\n・武器は日本刀(家族からもらった)\n・ウロと同じ課に所属している人間の1人。殺し屋として冷静に努めているものの、沸点が低くむしゃくしゃしてしまいがちで頭が固い。その一方で(業界では珍しく)困っている者を見過ごせない人情を持っている。\n・マイペースなウロを中心とした破天荒なn課のメンバーに振り回されてリズムが崩されがち。\n・天性的な能力はないが努力家。\n\n◇構図\n殺し屋の目をしている2人を所望します…すとらさんのOCちゃんの表情(2025/03/22に創作アカウントで投稿されたイラスト)の雰囲気が刺さって抜けなくて…\n衣装の簡略化や捏造も問題ありません、すとらさんが描きやすい方向で進めていただければなと思います！\n\n◇画像サイズ\n細かい希望はありませんが横長だととても助かります…\n\n◇使用用途\n観賞、ホーム画面等\n\n◇資料\n設定画↓\nhttps://drive.google.com/drive/folders/1zorzwnuLGN72I_-RXCsnFh4ftHPYHFVe\n世界観などのまとめ↓\nhttps://posfie.com/@____n0_0n____/p/MCmWDAa\n\n拙いものですが少しでも参考になれば…\n\n\n初skebでバリ緊張しています、不手際ありましたら申し訳ございません🙏", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [{"path": "/@Pst328/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3607083, "client_id": 2859634, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/b6c5f4e3/uploads/origins/d24b8dce-be75-44b1-8f4d-28ba614edbd9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2836a59f35324ed33d7808589fb42991", "srcset": "https://si.imgix.net/b6c5f4e3/uploads/origins/d24b8dce-be75-44b1-8f4d-28ba614edbd9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2836a59f35324ed33d7808589fb42991, https://si.imgix.net/b6c5f4e3/uploads/origins/d24b8dce-be75-44b1-8f4d-28ba614edbd9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=fa028a9f75ead6c9db5c02d0a9905611 2x, https://si.imgix.net/b6c5f4e3/uploads/origins/d24b8dce-be75-44b1-8f4d-28ba614edbd9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=85c75890895f14aadb0e7004a859b0db 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/b6c5f4e3/uploads/origins/d24b8dce-be75-44b1-8f4d-28ba614edbd9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=add9c3bf338bfaa00dbdaae8c2c10a4d", "srcset": "https://si.imgix.net/b6c5f4e3/uploads/origins/d24b8dce-be75-44b1-8f4d-28ba614edbd9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=add9c3bf338bfaa00dbdaae8c2c10a4d, https://si.imgix.net/b6c5f4e3/uploads/origins/d24b8dce-be75-44b1-8f4d-28ba614edbd9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=6231a703ac6c22b0c12160651f49102e 2x, https://si.imgix.net/b6c5f4e3/uploads/origins/d24b8dce-be75-44b1-