fm=webp&fit=crop&crop=top&w=200&h=200&s=028bf1127952fc9f9e8fb8a0bca07f77, https://si.imgix.net/d6978871/uploads/origins/d7c4c060-b485-4f8a-aaf1-d43c3c79ee5f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=08e0d57d26d04b4c15c9502a8777ab5c 2x, https://si.imgix.net/d6978871/uploads/origins/d7c4c060-b485-4f8a-aaf1-d43c3c79ee5f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=99d41811dc0d30694e2ce9e3f32e3325 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/d6978871/uploads/origins/d7c4c060-b485-4f8a-aaf1-d43c3c79ee5f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=55bce30b23d6d675ebdba630900b3f51", "srcset": "https://si.imgix.net/d6978871/uploads/origins/d7c4c060-b485-4f8a-aaf1-d43c3c79ee5f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=55bce30b23d6d675ebdba630900b3f51, https://si.imgix.net/d6978871/uploads/origins/d7c4c060-b485-4f8a-aaf1-d43c3c79ee5f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=90f73190af51ba348297cab7d6e953d9 2x, https://si.imgix.net/d6978871/uploads/origins/d7c4c060-b485-4f8a-aaf1-d43c3c79ee5f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=027cc3f5a2abc4139a38536f0ef8cf83 3x"}, "body": "152先生へ、\n乳房の小さな裸の少女が、浴室でカテーテルを使って尿道と膀胱を弄り、絶頂に達してカテーテルを抜くときにおしっこをする様子を描いていただけませんか。膀胱と尿道の断面図・レントゲンを描いてください。\n\n上記を描きたくない場合は、おしっこをしたい2人の女の子を描き、女の子が互いの股間に手を当てて喜ばせ合い、その後2人とも絶頂しておねしょをする様子を描いてもらえないだろうか。\n\nそれでもだめなら、温泉の横でおしっこをしたくてたまらない女の子を描き、しゃがんで地面におしっこをかけるか、立ったままおねしょをする。\n\n女の子は胸が小さいか中くらいで、できれば裸でもいいです。英語での複雑な指示で申し訳ありません。", "nc": 168, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@_IKOTU_/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1046178, "vtt_url": null, "thumbnail_image_urls": {"sr