, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/1b65a89b/uploads/origins/174d7465-2c11-465f-b560-de76186222a5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e604411c7d3f1a4468e5b64490fccb05", "src_set": ""}, "body": "はじめまして！先日あげていらっしゃったUTAUのカバー動画のイラストに一目惚れし、ポートフォリオを拝見させていただいていたところ、素敵な霊夢さんのイラストを見つけてskebまで飛んできました...！！\n\nよろしければこの霊夢さんのような雰囲気で、東方projectの古明地こいしちゃんを描いていただけないでしょうか...！！用途は個人使用のみで、私用のSNSのアイコンや、iPhoneの壁紙等に使用させていただこうと思っています..！\n\n◾️ご要望(こちらは可能な限りで大丈夫です🍃)\n・背景は薄めの黒〜紺系の暗めの色\n・彩度を抑えめに描いていただけるとうれしいです\n・原作(地霊殿)に近い白色、灰色っぽい髪の色\n地霊殿の絵については、おそらく資料URLに載っているかと思います...！！\n\n東方projectは二次創作ガイドラインより、skebでの依頼を行ってもいい認識なのですが、赤色フラスコさんの方で版権依頼を受け付けていらっしゃらない場合は遠慮なく流してください...！！ご要望が多くなり申し訳ありません、これからもかわいいイラストを心より楽しみにしています！🤍\n\nhttp://sukimanet.net/profile/chireiden/koishi.html", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@skshkflask/works/12", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/dc42d259/uploads/origins/fcb9bb81-91b7-402f-b9cd-f9906abfdb0e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=8ca208f07245945296f232db945d50b8", "src_set": ""}, "private": true, "genre": "art", "tipped": true, "creator_id": 2770110, "client_id": 330914, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 128, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@skshkflask/works/11", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/c9077e6f/uploads/origins/bc0d1eb3-6504-4a5f-bb1e-a8ffda2548fb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=8f3240cb85b