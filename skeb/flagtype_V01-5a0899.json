!\n私のVTuberの友人と私を描いていただけませんか？\n\n16:9の比率で描いてください。\n背景は私と友人が雪原にいるような感じでお願いします。\n\n友人(ピンクの服を着ている女の子)は膝の上に乗ってAT4ロケットランチャーを撃っているところにしてほしいです。二人とも参考リンクに添付したものと同じようなスタイルのフラックジャケットを着ていればいいと思います。着ているフラックが黒であれば尚良しです。\n\n私のキャラクターが友人の隣で膝をついてM27を撃っているような感じにしてほしいです。参考文献に追加した旗のワッペンを私のキャラの肩につけてください。冬用迷彩や黒の軍服でキャラクターを描いていただけるとありがたいです\n\n壁紙やSNSの背景に使いたいと思います。\nご検討のほど、よろしくお願いいたします\n\n参考：https://drive.google.com/drive/folders/1ZDGrTtotIZ6n23ossEPqaGEI1gX5fkOQ?usp=sharing\n\nhttps://drive.google.com/drive/folders/1ZDGrTtotIZ6n23ossEPqaGEI1gX5fkOQ?usp=sharing", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@flagtype_V01/works/9", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 962182, "client_id": 181347, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/8d04b334/uploads/origins/a40eaa40-124e-44ab-8485-b869cbb71622?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a64fea947e374c6c05574f5358f00962", "srcset": "https://si.imgix.net/8d04b334/uploads/origins/a40eaa40-124e-44ab-8485-b869cbb71622?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a64fea947e374c6c05574f5358f00962, https://si.imgix.net/8d04b334/uploads/origins/a40eaa40-124e-44ab-8485-b869cbb71622?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e3df557aea9bab24c7ab1813202bbd11 2x, https://si.imgix.net/8d04b334/uploads/origins/a40eaa40-124e-44ab-8485-b869cbb71622?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=1b81fbc8d47e8ec05a6d4fa02c269182 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/8d04b334/uploads/origins/a40eaa40-124e-44ab-8485-b869cbb71622?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2ed072275a35ea681bf334a52ca119d9", "srcset": "https://si.imgix.net/8d04b334/uploads/origins/a40e