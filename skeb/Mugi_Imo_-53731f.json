普段の表情は笑顔。不遜でカジュアルな性格だが、内心は非常に危険。\n密かにエイリアンでもある。\n\n可能なポーズとしては、クールなアクション・ポーズ、エイリアンの怪物と戦っているポーズ、リラックスしながらも怖い笑みを浮かべて見る人に銃を向けているポーズ、ソファに座りテーブルに足を乗せて本を読んでいるポーズなどがある。\n\nポーズや構図はお任せします。\n\n使用用途SNS、OC活動、プリントして個人で鑑賞する程度\n\nいずれにせよ、この依頼を読んでいただき本当にありがとうございました！\n\nhttps://drive.google.com/drive/folders/10t7GU69bhcFhvMtnnK7toSza0rYWeIYp?usp=sharing", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Mugi_Imo_/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3653185, "client_id": 2753127, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/0ed7ed77/uploads/origins/916997e1-22b3-434a-b706-a183bf2917a7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d91a9a104b4735b0469e4bdd5acb7b49", "srcset": "https://si.imgix.net/0ed7ed77/uploads/origins/916997e1-22b3-434a-b706-a183bf2917a7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d91a9a104b4735b0469e4bdd5acb7b49, https://si.imgix.net/0ed7ed77/uploads/origins/916997e1-22b3-434a-b706-a183bf2917a7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=687958749a8fa36d11626d1fd5867b9f 2x, https://si.imgix.net/0ed7ed77/uploads/origins/916997e1-22b3-434a-b706-a183bf2917a7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=65fce4e113ba678e0ef96c265ed8cf75 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/0ed7ed77/uploads/origins/916997e1-22b3-434a-b706-a183bf2917a7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=006855475a84a5f7fbfe4f64b3f47350", "srcset": "https://si.imgix.net/0ed7ed77/uploads/origins/916997e1-22b3-434a-b706-a183bf2917a7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=006855475a84a5f7fbfe4f64b3f47350, https://si.imgix.net/0ed7ed77/uploads/origins/916997e1-22b