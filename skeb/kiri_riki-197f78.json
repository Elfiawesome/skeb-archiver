=top&w=200&h=200&blur=200&s=a070da4a07b6f6d4f8f365527aefa567 2x, https://si.imgix.net/65585dcb/uploads/origins/71b50498-298a-47ce-86e1-37c3cbcdeae4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=f9cc8384d2b8148b283b0c3e16c3810e 3x"}, "body": "こんにちは、あなたの絵は超きれいですね私のVTuber「Nia Moni」の絵をお願いしたいです。彼女はファッションデザイナーでありアーティストです。フレンドリーな性格で、友達をからかうのが好きです。大きなハサミを持っていて、それを振り回すのが好きです。ポーズや表情は問いません。\n\nこれは彼女の新しい服なので、ぜひ描いてほしいですね。足の部分はハサミを持っていて、首の周りの黄色い部分はメジャーです。鼻には絆創膏、頬には赤いハートが描かれています。\n\nもしよろしければ、私のYouTubeやTwitchで、あなたのクレジットを入れて使用してもいいですよ。ありがとうございました。\n\nhttps://drive.google.com/drive/folders/1f-WepuZ_QVTpqJIxOS5oQR4gcj0ZzRsW", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@kiri_riki/works/9", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1080523, "client_id": 572937, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/a9d7f6cd/uploads/origins/cbbc8a8c-39f2-40fa-b697-19b6b4852a98?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=54fcce88bd0b8c0814986f05a917ea66", "srcset": "https://si.imgix.net/a9d7f6cd/uploads/origins/cbbc8a8c-39f2-40fa-b697-19b6b4852a98?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=54fcce88bd0b8c0814986f05a917ea66, https://si.imgix.net/a9d7f6cd/uploads/origins/cbbc8a8c-39f2-40fa-b697-19b6b4852a98?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a877debb32ee7c2ac23f594157f1c0f1 2x, https://si.imgix.net/a9d7f6cd/uploads/origins/cbbc8a8c-39f2-40fa-b697-19b6b4852a98?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=623275eaf72fb07e9c4cc7ff7cc4b94c 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/a9d7f6cd/uploads/origins/cbbc8a8c-39f2-40fa-b697-19b6b4852a98?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=2