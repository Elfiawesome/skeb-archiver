bp&fit=crop&crop=top&w=200&h=200&s=5ad32f9c1affe8c0cf46791ad30169be", "srcset": "https://si.imgix.net/d1ed72bb/uploads/origins/61c9f456-f85e-4aff-92e4-3e17b028c909?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5ad32f9c1affe8c0cf46791ad30169be, https://si.imgix.net/d1ed72bb/uploads/origins/61c9f456-f85e-4aff-92e4-3e17b028c909?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c5f5339d712dc06d0a00884ccf5be2d9 2x, https://si.imgix.net/d1ed72bb/uploads/origins/61c9f456-f85e-4aff-92e4-3e17b028c909?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=9a450c6ed417fc3c9c1680057d4a894a 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/d1ed72bb/uploads/origins/61c9f456-f85e-4aff-92e4-3e17b028c909?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5aa1cf48b6b124a1dfab16feb5d5de69", "srcset": "https://si.imgix.net/d1ed72bb/uploads/origins/61c9f456-f85e-4aff-92e4-3e17b028c909?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5aa1cf48b6b124a1dfab16feb5d5de69, https://si.imgix.net/d1ed72bb/uploads/origins/61c9f456-f85e-4aff-92e4-3e17b028c909?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=c72ff5ee605c3ad0ea5f310120966612 2x, https://si.imgix.net/d1ed72bb/uploads/origins/61c9f456-f85e-4aff-92e4-3e17b028c909?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=98d7a7b3e201f8d8917140ef88c76d69 3x"}, "body": "匿名で失礼致します。\nデュエマのクリーチャー娘のスケベ絵が少なすぎると精神的な困窮を覚えていた所に貴方様のデュエマのスケベ絵に出会い、それに大変感銘を受け今回skebによるイラストリクエストを踏み切らせて頂きました。\n今回リクエストするイラストの内容はデュエルマスターズより『龍覇少女隊ハラグロX』の三人（マリニャン・エリカッチュ・サエポヨ)の枕営業乱交セックススケベ絵です。\n※キャラのデザイン資料（デュエルマスターズ公式サイト)を添付させて頂きます。\n\n具体的にはラブホテルの大きなベッドの上でライブ衣装の胸や股といった恥部をはだけさせた状態で三人が仰向けに並んで寝転がり、偉いプロデューサーの汚じさん達に正常位でハメられまくっているといったシチュエーションをイメージしております。\n三人の表情は偉いおじさん達とのパコパコニャンニャン枕営業セックスを心から楽しみ、ガチ恋オタクファンを裏切って男とパコパコしちゃうグループ名通りの腹黒さ、お金持ちのおじさんとの玉の輿の為に平気で枕しちゃう尻軽さ、そして何よりもセックスが大好きな淫乱さを感じられる淫らでスケベな笑みを浮かべているととても嬉しいです。\n何卒ご検討の程よろしくお願い致します。\n\nhttps://dm.takaratomy.co.jp/card/detail/?id=dmex06-040", "nc": 40, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@BlackRose_ZZ/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3000701, "client_id": 157263, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/208b69c4/uploads/origins/9e32a066-ec17-4d48-aa9d-d946af20c915?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d3eb6a492e292668796d3dc8a96309fb", "srcset": "https://si.imgix.net/208b69c4/uploads/origins/9e32a066-ec17-4d48-aa9d-d946af20c915?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d3eb6a492e292668796d3dc8a96309fb, https://si.imgix.net/208b69c4/uploads/origins/9e32a066-ec17-4d48-aa9d-d946af20c915?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=d87db589b21ba42b9d30990356c7aaea 2x, https://si.imgix.net/208b69c4/uploads/origins/9e32a066-ec17-4d48-aa9d-d946af20c915?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e75ebfd8fa1713b5f6b0d8d2536e004c 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/208b69c4/uploads/origins/9e32a066-ec17-4d48-aa9d-d946af20c915?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ea5062a8d10cfd4e3602f498cb6d06ce", "srcset": "https://si.imgix.net/208b69c4/uploads/origins/9e32a066-ec17-4d48-aa9d-d946af20c915?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ea5062a8d10cfd4e3602f498cb6d06ce, https://si.imgix.net/208b69c4/uploads/origins/9e32a066-ec17-4d48-aa9d-d946af20c915?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=6dfcd9bc4302f25b156a9251691e8d03 2x,