みコンドームの中身を取り出して舐めたり嗅いだり指に纏わせて差し込んだりといったエグめのオナニーをお願いします。\n※道具は使わず、指と使用済みコンドームのみでお願いします。\n吹き出しなどでセリフを入れる場合は、マスターへのクソ重い愛故の言葉（マスターの赤ちゃん欲しい、妊娠しちゃいたい、等）があれば幸いです。", "nc": 169, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@sairuikan/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2348822, "client_id": 0, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/d1308715/uploads/origins/b97bee66-9a65-423c-bcc2-b95bb4401e30?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a42562e0ecb38cb2f8c02bf0e3e1a366", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/d1308715/uploads/origins/b97bee66-9a65-423c-bcc2-b95bb4401e30?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=bdf4fb9c0efafe583631bc2957676964", "src_set": ""}, "body": "https://skeb.jp/@sairuikan/works/2\n\nお疲れ様です。ジャックのイラストをありがとうございます。超エロいです。本当はこのままも好きけど、自分が依頼を少し書き間違えたかも。「ボテない」と書いたのは、「ツイッターリンクにある二つのうち、比較的小さい方」という意味でした。確かにボテけどね。\n\nすみませんが、ご迷惑でなければ同じイラストのボテ腹（小～中サイズ）差分をお願いします。", "nc": 32, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@sairuikan/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2348822, "client_id": 0, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/6bce74bb/uploads/origins/76d9865b-4c17-4f3e-b8f3-4c76277dd8f1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8872c6a6dd0d15446ce5aaa6fa19c369", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/6bce74bb/uploads/origins/76d9865b-4c17-4f3e-b8f3-4c76277dd8f1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=8dd1cb369f0fd740b5809b15cce38cc9", "src_se