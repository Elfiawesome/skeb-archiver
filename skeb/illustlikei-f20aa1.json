二乃の黒ハイソックスの生地の質感を強調してみる。特に三玖の黒タイツは、もっと丁寧に繊維感や質感を強調してほしいです。注目すべきは、2種類のソックスの質感が違って見えることです\n-三玖のタイツは半透明で、つま先の部分につま先補強があります。二乃の黒ハイソックスも若干透け感がある、つま先補強がありません\n-タイツの透け感から、三玖の足の爪は描くことができます\n-イラストをワイドにして、左は三玖の左ひざと左ふくらはぎ（左足首以下は見えないように）、右は二乃の右ひざと右ふくらはぎ（右足首以下は見えないように）を見えるようにする\n-二人とも恥ずかしそうに顔を赤らめています\n\n【差分】\n足元から蒸気が出ているものと、出ていないもの。蒸気なし差分＋1枚 透明背景 (画面に映し出されるのはリーリエとマオだけ)\n\nフォーマット3300×4200 px以上\n\nお読みいただきありがとうございます。また、作品を楽しみにしています。\n\nhttps://drive.google.com/drive/folders/1BM7trjjK7_PRRPSzG43Te322GdO5hnbI", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@illustlikei/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1823936, "client_id": 977462, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/b277bd6f/uploads/origins/ac4a43e6-2eb5-46d0-9f99-a67411dd0197?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6e7ceb5fdb6ca95f1b84ad8a032aedba", "srcset": "https://si.imgix.net/b277bd6f/uploads/origins/ac4a43e6-2eb5-46d0-9f99-a67411dd0197?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6e7ceb5fdb6ca95f1b84ad8a032aedba, https://si.imgix.net/b277bd6f/uploads/origins/ac4a43e6-2eb5-46d0-9f99-a67411dd0197?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=98557fab2b06d9ff2b0c51911b2b840b 2x, https://si.imgix.net/b277bd6f/uploads/origins/ac4a43e6-2eb5-46d0-9f99-a67411dd0197?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=cb6f4772e7ef881df0fff14b43280614 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/b277bd6f/uploads/origins/ac4a43e6-2eb5-46d0-9f99-a67411dd0197?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e71394bbbbddce660b75ebb89c460002", "srcset": "https://si.imgix.net/b277bd6f/uploads/origins/ac4a43e6-2eb5-46d0-9f99-a67411dd0197?bg=%23fff&auto=