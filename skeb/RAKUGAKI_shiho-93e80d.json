\nとても注意深く、狡猾で、人を欺くが、親しい人には姉のように振る舞う。\n\n一番好きな服を選んでください。\n必須ではありませんが、見てみたいモチーフは、彼女の後ろにある不気味な目や口です。例を挙げました。\nあとはお任せします。\n重要なのは、彼女のモノクロのテーマだけです。\n背景や構図はモノクロである必要はありません。\n\nご検討のほど、よろしくお願いいたします！\n\nhttps://imgur.com/a/Y1ksxDR", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@RAKUGAKI_shiho/works/14", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1716472, "client_id": 2544339, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/4ff56225/uploads/origins/f0817204-9f23-4d72-a493-e5dc276f483c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=83c4252c361732ca966dcc6805294ceb", "srcset": "https://si.imgix.net/4ff56225/uploads/origins/f0817204-9f23-4d72-a493-e5dc276f483c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=83c4252c361732ca966dcc6805294ceb, https://si.imgix.net/4ff56225/uploads/origins/f0817204-9f23-4d72-a493-e5dc276f483c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=8f5918b72df755abd4a913c09f05b481 2x, https://si.imgix.net/4ff56225/uploads/origins/f0817204-9f23-4d72-a493-e5dc276f483c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=050f313127506905432ebb97a777de79 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/4ff56225/uploads/origins/f0817204-9f23-4d72-a493-e5dc276f483c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e63bf313fef21314572d1033ccebe92e", "srcset": "https://si.imgix.net/4ff56225/uploads/origins/f0817204-9f23-4d72-a493-e5dc276f483c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e63bf313fef21314572d1033ccebe92e, https://si.imgix.net/4ff56225/uploads/origins/f0817204-9f23-4d72-a493-e5dc276f483c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s