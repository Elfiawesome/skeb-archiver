3088\u308a\u3001\u666e\u6bb5\u63cf\u304b\u308c\u3066\u3089\u3063\u3057\u3083\u308b\u3088\u3046\u306a\u30c7\u30a3\u30d5\u30a9\u30eb\u30e1\u306e\u30c6\u30a4\u30b9\u30c8\u5e0c\u671b\u3002\n\u203b\u5225\u4f9d\u983c\u306e\"\u30af\u30ea\u30c6\u30a3\u30ab\u30eb\"\u7528\u306e\u9bdb\u3068\u96f0\u56f2\u6c17\u306a\u3069\u306b\u30e1\u30ea\u30cf\u30ea\u304c\u3042\u308b\u3068\u5b09\u3057\u3044\u3067\u3059\u3002\n\n\u30fb\"\u30d5\u30a1\u30f3\u30d6\u30eb\"\u306e\u6587\u5b57(\u30ab\u30bf\u30ab\u30ca\u30fb\u3072\u3089\u304c\u306a\u30fb\u82f1\u8a9e(fumble)\u3001\u8868\u8a18\u306f\u3069\u308c\u3067\u3082\u53ef\u3002\u203b\u5225\u4f9d\u983c\u306e\"\u30af\u30ea\u30c6\u30a3\u30ab\u30eb\"\u3068\u8868\u8a18\u3092\u63c3\u3048\u3066\u304f\u3060\u3055\u308b\u3068\u5b09\u3057\u3044\u3067\u3059\u3002)\n\n\u5e0c\u671b\u306f\u4ee5\u4e0a\u3067\u3059\u304c\u3001\u30e1\u30a4\u30f3\u3067\u63cf\u304b\u308c\u3066\u3044\u308b\u306e\u304c\u9bdb\u3067\u3042\u308c\u3070\u3001\u5225\u8981\u7d20\u3092\u8db3\u3057\u3066\u3044\u305f\u3060\u3044\u3066\u3082OK\u3067\u3059\u3002\u304a\u307e\u304b\u305b\u3057\u307e\u3059\u3002\n\n\u25a0\u4f7f\u7528\u76ee\u7684\u8a73\u7d30\nTRPG(\u30b5\u30a4\u30b3\u30ed\u306e\u51fa\u76ee\u3092\u7528\u3044\u3066\u7269\u4e8b\u306e\u6210\u529f\u5931\u6557\u3092\u5224\u65ad\u3057\u306a\u304c\u3089\u7269\u8a9e\u3092\u9032\u3081\u3066\u3044\u304f\u30b2\u30fc\u30e0)\u3092\u904a\u3076\u969b\u3001\u30b5\u30a4\u30b3\u30ed\u3092\u3075\u3063\u3066\u2018\u2019\u7279\u5225\u60aa\u3044\u6570\u5024\u201d\u304c\u51fa\u308b\u3053\u3068\u3092\"\u30d5\u30a1\u30f3\u30d6\u30eb\"\u3068\u3044\u3046\u306e\u3067\u3059\u304c\u3001\u30b3\u30b3\u30d5\u30a9\u30ea\u30a2\u3067\u306f\u305d\u308c\u304c\u8d77\u3053\u3063\u305f\u969b\u300c\u30ab\u30c3\u30c8\u30a4\u30f3\u300d\u3068\u3044\u3046\u6a5f\u80fd\u3067\u4e8b\u524d\u306b\u8a2d\u5b9a\u3057\u3066\u3044\u305f\"\u753b\u50cf\"\u3092\u753b\u9762\u306b\u8868\u793a\u3059\u308b\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002\u4f9d\u983c\u54c1\u306f\u3053\u306e\u753b\u50cf\u3067\u3059\u3002\n\n\u30d5\u30a1\u30f3\u30d6\u30eb=\u30e4\u30d0\u30a4\u6570\u5024\u3067\u3061\u3083\u3063\u305f\uff01\u3068\u3044\u3046\u3001\u53c2\u52a0\u8005\u305f\u3061\u304c\u963f\u9f3b\u53eb\u559a\u3059\u308b\u5834\u9762\u3067\u8868\u793a\u3059\u308b\u306e\u3067\u300c\u306a\u3093\u3066\u3053\u3063\u305f\uff01\u300d\u300c\u3084\u3063\u3061\u3083\u3063\u305f\uff01\u300d\u300c\u7d42\u308f\u3063\u305f\u2026\u300d\u3068\u3044\u3046\u3001\u60b2\u58ee\u611f\u3084\u30b7\u30e7\u30c3\u30af\u611f\u306e\u3042\u308b\u30a4\u30e1\u30fc\u30b8\u3067\u3059\u3002\n\n\u305f\u3060\u3001\u6c17\u5206\u3092\u91cd\u304f\u3057\u305f\u3044\u3068\u3044\u3046\u3088\u308a\u306f\u3001\u30ab\u30c3\u30c8\u30a4\u30f3\u306e\u753b\u50cf\u304c\u3067\u3066\u300c\u30d5\u30a1\u30f3\u30d6\u30eb\u3057\u305f\u3089\u7121\u60e8\u306a\u59ff\u306e\u9bdb\u304c\u51fa\u3066\u304d\u305fw(\u7b11)\u300d\u3068\u3001\u30e4\u30d0\u30a4\u3051\u3069\u3064\u3044\u7b11\u3063\u3061\u3083\u3046\u3088\u3046\u306a\u3001\u30b7\u30e5\u30fc\u30eb\u3067\u697d\u3057\u3044\u96f0\u56f2\u6c17\u306b\u306a\u308b\u9bdb\u3060\u3068\u5b09\u3057\u3044\u3067\u3059\u3002\n\n\u4e3b\u306b\u81ea\u5206\u304c\u53cb\u4eba\u3068\u30b2\u30fc\u30e0\u3092\u3059\u308b\u969b\u306e\u5229\u7528\u3068\u89b3\u8cde\u7528\u3068\u3057\u3066\u3001\u79c1\u7684\u5229\u7528\u306e\u7bc4\u56f2\u3067\u4f7f\u308f\u305b\u3066\u9802\u304d\u307e\u3059\u3002\n\n\n\u25a0\u53c2\u8003\u7b49\n\u30fb\u30b3\u30b3\u30d5\u30a9\u30ea\u30a2\u516c\u5f0f \u30ab\u30c3\u30c8\u30a4\u30f3\u306b\u3064\u3044\u3066\u2193\nhttps://docs.ccfolia.com/gm-only/cutin\n\n\u30fb\u30b3\u30b3\u30d5\u30a9\u30ea\u30a2\u3092\u5229\u7528\u3057\u3066\u3044\u306a\u3044\u3068\u3001\u3042\u307e\u308a\u99b4\u67d3\u307f\u306e\u306a\u3044\u4f7f\u7528\u5148\u304b\u3068\u601d\u3046\u306e\u3067\u3059\u304c[ \u30ab\u30c3\u30c8\u30a4\u30f3  \u7d20\u6750  \u30d5\u30a1\u30f3\u30d6\u30eb ]\u7b49\u306e\u30ef\u30fc\u30c9\u3092\u753b\u50cf\u691c\u7d22\u9802\u304f\u3068\u300c\u3053\u3046\u3044\u3063\u305f\u3082\u306e\