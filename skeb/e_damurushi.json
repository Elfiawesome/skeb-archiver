table_only_public": false, "tip_acceptable": true, "yearly_report_client_visible": false, "total_appeals_count": 0, "received_works": [{"path": "/@e_damurushi/works/139", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 27173, "client_id": 1514119, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/82b0caf7/uploads/origins/0264113b-18e3-40c1-96c1-e5fb33100d13?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=cbd2b03a499b8b5fd1a9a9c00a93cc67", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/82b0caf7/uploads/origins/0264113b-18e3-40c1-96c1-e5fb33100d13?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f3e158977a23bd2253bdff20428b775c", "src_set": ""}, "body": "ダムるしさん\nこんにちは、しばたひつじです。\n今回は、それぞれ別の時代に出身したアメリカの自探索者二人のクロスオーバーのイラストをお願いしたいです。\n\n--------------------------------------------------------\n●キャラクター\n\n◇ヴァルター\nhttps://shibatahitsuji.notion.site/WWW-11ca6bbc7127809fa62eec3a660c0a64\n・パンドリHO狩人\n・1980年代アメリカの大学生\n\n◇レイノルド\nhttps://www.dropbox.com/scl/fo/ez3d93yxinw1fp7qmtnka/AM71wYYL8AzgHlYm70nVOeA?rlkey=e6nzchjthjpak4nltquril9z9&dl=0\n\n・月刊かびや先生の『月光』通過済み\n・1920年代アメリカの刑事\n・20代後半くらい　身長165cm　銀髪碧眼\n・正義感が強いけど空気が読めない　顔が良いがめっちゃウザい\n\n--------------------------------------------------------\n\n●説明\n　「レイノルドはヴァルターの母の方の祖父」という設定にしています\n（パンドリのシナリオのせいで色々ややこしくなりましたが…）\n　性格や行動パターンも似ているし、\n　せっかくならこの二人が並んでいたら面白いのではないかなと思います\n\n●シーン\n　漫画の扉絵や雑誌の版権絵のように、時代やストーリーの整合性を気にせずに描かれた、特別な一枚絵というイメージです。\n　二人がお互いの衣装（立ち絵のデフォルト衣装）を交換しているというシーンで、ポーズなどの具体的な構図はおまかせしたいと思っています。\n（二人が身長違うから衣装のサイズも違うと思うけど、そこは無視してもいいです！）\n\nご検討いただければ幸いです！\n\nhttps://www.dropbox.com/scl/fo/ez3d93yxinw1fp7qmtnka/AM71wYYL8AzgHlYm70nVOeA?rlkey=e6nzchjthjpak4nltquril9z9&dl=0", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@e_damurushi/works/138", "private_thumbnail_imag