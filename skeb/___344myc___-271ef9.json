=200&h=200&s=d148686079c24784de2a6974ecdb1b7a 2x, https://si.imgix.net/cb458e5a/uploads/origins/366f6257-794b-4d2f-8d81-8dd555eead5c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=7b99ecb160d34817e220764c04a4c2c3 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/cb458e5a/uploads/origins/366f6257-794b-4d2f-8d81-8dd555eead5c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=71e957d0be5393ff79ca59102305da8a", "srcset": "https://si.imgix.net/cb458e5a/uploads/origins/366f6257-794b-4d2f-8d81-8dd555eead5c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=71e957d0be5393ff79ca59102305da8a, https://si.imgix.net/cb458e5a/uploads/origins/366f6257-794b-4d2f-8d81-8dd555eead5c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=b513872fc5e3a9fd277efdfb6299c20c 2x, https://si.imgix.net/cb458e5a/uploads/origins/366f6257-794b-4d2f-8d81-8dd555eead5c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=31b1f67464505daa0690a8a3cb2db4ab 3x"}, "body": "みよし様こんばんわ。\nポップンミュージックのポエット、メル、アリシアをリクエストします。\n\n大き目のビニールプールの中で３人が水鉄砲撃ったり手で水を掛け合ったり\n楽しそうに遊んでる姿を、みよし様の絵で拝見したいです。\n水着衣装は、ポエットはポップンレアカード、メルがチェンジカードのもので、\nアリシアはワンピースイメージ、ピンクカラーの可愛いらしそうなのを一例に挙げますが\n細部であったり、みよし様の方で「こっちがいいかなぁ」と思われるものがあれば\nそちらを採用して頂いても大丈夫です。\nまた浮き輪等の小道具を含めるかどうかもお任せしたいと思います。省いていただいても良いです。\n\n難しいようでしたら、キャンセル頂いても全然問題ないので\n検討よろしくお願いします。", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@___344myc___/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 578798, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/3d453a52/uploads/origins/b0947687-5658-4cc0-a1ea-bcebbb9349d1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=41f4beebc318573eb1bc95d05087d