05ccad-2290-460c-b3e4-97c4b7607c5e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a6fdd5312996dffd7363282a10c76d60, https://si.imgix.net/9d1aa990/uploads/origins/3d05ccad-2290-460c-b3e4-97c4b7607c5e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=23003817d82912a38652cb8fda351cad 2x, https://si.imgix.net/9d1aa990/uploads/origins/3d05ccad-2290-460c-b3e4-97c4b7607c5e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f9bcdb38864e7b82d39d18ebc48f16a9 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/9d1aa990/uploads/origins/3d05ccad-2290-460c-b3e4-97c4b7607c5e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=921c0c7ff0cd588ca12fe99cc4a6cf72", "srcset": "https://si.imgix.net/9d1aa990/uploads/origins/3d05ccad-2290-460c-b3e4-97c4b7607c5e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=921c0c7ff0cd588ca12fe99cc4a6cf72, https://si.imgix.net/9d1aa990/uploads/origins/3d05ccad-2290-460c-b3e4-97c4b7607c5e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=a25907c4506023cd1775ff7345f72529 2x, https://si.imgix.net/9d1aa990/uploads/origins/3d05ccad-2290-460c-b3e4-97c4b7607c5e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=9e16022d02f20fddd132430d13e3ec11 3x"}, "body": "お世話になります。\n先日は矢吹可奈のイラストを描いて頂きありがとうございました。\n今回また矢吹可奈のイラストを、以下内容でお願いできますでしょうか。\n\n前回同様の衣装のセーラーミズギ（下記のURLを参照ください）を着た可奈が、\nプロデューサーといちゃらぶえっちをしているイラストをお願いします。\n\nhttps://x.com/ChArassmi/status/1665028790907555840\nhttps://x.com/ChArassmi/status/1665238117232640001\nhttps://x.com/ChArassmi/status/1668577466695430144\n\n体位はバックか寝バックでお願いします。\n可奈はPに腰を押し付けられ、一番奥をぐりぐりとされて、強い快楽で泣きそうなトロ顔でお願いします。\nPが可奈の腰を掴んだりもしくはPが可奈にのしかかったりで、可奈は快楽から逃げようとしても逃げられずに責められている、というような内容でお願いできますでしょうか。\n\nよろしくお願いいたします。", "nc": 48, "word_count": 0, "transcoder": "i