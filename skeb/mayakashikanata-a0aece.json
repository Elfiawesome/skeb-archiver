mat%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f3e2666bf3ca250eff6f03de80fd6fd6", "srcset": "https://si.imgix.net/b492d7d6/uploads/origins/d4064eb8-ab8e-4ff1-b702-c85c630be50c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f3e2666bf3ca250eff6f03de80fd6fd6, https://si.imgix.net/b492d7d6/uploads/origins/d4064eb8-ab8e-4ff1-b702-c85c630be50c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=960c1bf43889d59a0ec27438690e1f13 2x, https://si.imgix.net/b492d7d6/uploads/origins/d4064eb8-ab8e-4ff1-b702-c85c630be50c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=8f14bd0818ece487ce30363ec7472cf7 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/b492d7d6/uploads/origins/d4064eb8-ab8e-4ff1-b702-c85c630be50c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=66786a36e4f96706c44ee63e72ecf3bd", "srcset": "https://si.imgix.net/b492d7d6/uploads/origins/d4064eb8-ab8e-4ff1-b702-c85c630be50c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=66786a36e4f96706c44ee63e72ecf3bd, https://si.imgix.net/b492d7d6/uploads/origins/d4064eb8-ab8e-4ff1-b702-c85c630be50c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=c319bb17268540a54089dd827e02f1e3 2x, https://si.imgix.net/b492d7d6/uploads/origins/d4064eb8-ab8e-4ff1-b702-c85c630be50c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=c20c434fe5b8b8b2ffcd0e45062165d9 3x"}, "body": "かなたさん、こんばんは。\n以前のリクエストでは素敵なイラスト、表紙をありがとうございました。\nよかったらまたリクエストご検討ください。\n\n　最初に……あいゆみが百合しかNGならキャンセルで構いません。\n 成人向け小説同人誌に使用する、カバーのイラストをお願いできませんか。\n旧名義から何度か描いておられる、夕美ちゃんと藍子ちゃんのベッドの上で下着姿のセクシーなショットが好きであんな感じでの絵をお願いしたいです（上下下着とかそれに＋ソックスとかガーターとかソックスくらいの露出度のイメージ）。\n構図などは自由に考えていただいて構いません。\nただ、「Pさん×アイドル×アイドル」の3P小説短編集というのを出したいので百合えっちではなく、絵の中に人間はは藍子ちゃんと夕美ちゃんだけでいいのですが本文には男の人（Pさん）が出てくるという感じです。\n匂わせの未使用コンドーム？ か男物の服がベッドの上に脱ぎ散らかしてあるとか何か付け足していただくのがいいのかな？ とか思っています。\nこの辺も含めお任せします。\n\nもしOKなら資料URLのPSD、CMYKのもので描いていただけないでしょうか（https://www.shimaya.net/bungei/download.html#tmp01、文庫サイズ、カバー用「背幅5mm」のテンプレートでお願いできないでしょうか）\nタイトルやクレジットはページ数が決まった後に厚みが少し前後するため、こちらで入れさせて頂こうと思いますので少し字がかぶっても大丈夫なところを表表紙（表１）や裏表紙（表４）に作ってもらえると嬉しいです。\n良かったらご検討ください！\n\nhttps://www.shimaya.net/bungei/download.html#tmp01", "nc": 32, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@mayakashikanata/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2555743, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/c6d2f874/uploads/origins/a4742c4d-fb00-44fc-b8c8-10a20f5987dc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0c7ef1923c0c0365bc73b88cfb17b472", "srcset": "https://si.imgix.net/c6d2f874/uploads/origins/a4742c4d-fb00-44fc-b8c8-10a20f5987dc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0c7ef1923c0c0365bc73b88cfb17b472, https://si.imgix.net/c6d2f874/uploads/origins/a4742c4d-fb00-44fc-b8c8-10a20f5987dc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=34076144df11e8a9e546224b27ae92b7 2x, https://si.imgix.net/c6d2f874/uploads/origins/a4742c4d-fb00-44fc-b8c8-10a20f5987dc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=8fd69cd520231223fff280cbc9f3ba36 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/c6d2f874/uploads/origins/a4742c4d-fb00-44fc-b8c8-10a20f5987dc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=256352e84a00b799d8ccc1061abee51b", "srcset": "https://si.imgix.net/c6d2f874/uploads/origins/a4742c4d-fb00-44fc-b8c8-10a20f5987dc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=256352e84a00b799d8ccc1061abee51b, https://si.imgix.net/c6d2f87