ズ化する可能性があります。\n \n▷納品形態\n背景、キャラクターが分かれているPSDデータで、もしくはPDFで納品頂ければ助かります。  \n\n依頼が料金見合わなければ、遠慮なく差し戻しください 。\n承諾いただければ幸いです、よろしくお願いいたします！\n\nhttps://drive.google.com/drive/folders/1MjfA7zFtsLtRc3dQ", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@dozyoyanagawa/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3734803, "client_id": 3112918, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/d20f074a/uploads/origins/bb451e92-93dc-4ffa-be57-40abc20a079c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b59fbb9a2d45a4cb81e2e576a74b82a3", "srcset": "https://si.imgix.net/d20f074a/uploads/origins/bb451e92-93dc-4ffa-be57-40abc20a079c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b59fbb9a2d45a4cb81e2e576a74b82a3, https://si.imgix.net/d20f074a/uploads/origins/bb451e92-93dc-4ffa-be57-40abc20a079c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=339f8f9342934b678e161914db78fcd5 2x, https://si.imgix.net/d20f074a/uploads/origins/bb451e92-93dc-4ffa-be57-40abc20a079c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=6fa729ecbccfb6a40a20f7bbc4e3d1e1 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/d20f074a/uploads/origins/bb451e92-93dc-4ffa-be57-40abc20a079c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=8dbfaba6f9781186101d71b3e5df28c8", "srcset": "https://si.imgix.net/d20f074a/uploads/origins/bb451e92-93dc-4ffa-be57-40abc20a079c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=8dbfaba6f9781186101d71b3e5df28c8, https://si.imgix.net/d20f074a/uploads/origins/bb451e92-93dc-4ffa-be57-40abc20a079c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=56e42dc5a6693b7960f3bb70de31ee