6d/uploads/origins/e2bc8d4a-bd44-472a-8572-54afd0a863ed?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c3bc761ae6e67aa3811ac6829bfa4e60, https://si.imgix.net/92697a6d/uploads/origins/e2bc8d4a-bd44-472a-8572-54afd0a863ed?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b7e3d5d5224a7f069111ecc5636bd322 2x, https://si.imgix.net/92697a6d/uploads/origins/e2bc8d4a-bd44-472a-8572-54afd0a863ed?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=137787092ca395f98d0584eaf501c49a 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/92697a6d/uploads/origins/e2bc8d4a-bd44-472a-8572-54afd0a863ed?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=72c6c073e734b0beb488b7b962d94792", "srcset": "https://si.imgix.net/92697a6d/uploads/origins/e2bc8d4a-bd44-472a-8572-54afd0a863ed?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=72c6c073e734b0beb488b7b962d94792, https://si.imgix.net/92697a6d/uploads/origins/e2bc8d4a-bd44-472a-8572-54afd0a863ed?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=555acd8b300b3efd3cf62e05807e33af 2x, https://si.imgix.net/92697a6d/uploads/origins/e2bc8d4a-bd44-472a-8572-54afd0a863ed?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=9ac87abdc4b30fb0c3c9a8df21ac7c56 3x"}, "body": "ハンバーグなっとう先生はじめまして\n突然のご相談失礼致します。\n\nTwitterやSkebを拝見して\n先生の書かれているイラストのタッチや雰囲気がとても素敵で\n応援しているVライバーさんの\nSkebのイラストをお願いできないかと思いリクエストさせていただいてます。\nもしよければご検討頂ければ幸いです。\n\n【応援ライバーさん】\n花宮ゆりね　（配信アプリIRIAM/ツイキャスライバー）\nツイッターID：@H7_YuRine\n\n【イラスト服衣装図＠ツイッター】サキュバス風な衣装\nhttps://twitter.com/h7_yurine/status/1637834949620547585?s=46&t=DIJT28jGYjxqb0Q9P0It3g\n\n【構図＆イメージ】\nhttps://twitter.com/miesuku0325/status/1643549540820344832\n座ってる構図で、表情は片目ウィンクで舌を少し出している表情でお願いしたいです。\n配信サムネイルに使用したいので、顔まわりの髪や髪飾りは見切れないようにしていただけると助かります。\nポーズはお任せ致します。できれば胸を強調してくださると嬉しいです。\n参考資料に座り姿の構図を添付しておりますが、\nハンバーグなっとう先生の描きやすいように変えていただいても構いません。\n\n【使用用途】\nTwitterアイコン/IRIAMや他配信アプリ内の\n配信サムネイル用、配信活動全般サムネ等\nリスナーへの無償ネットプリント配布等\n＊グッズ等商用には使用致しません。\n\n【許可等】\nライバー様御本人\n一次作成者様（通称ママ様）には依頼許可を頂いております。\n\nデータ形式は\n署名有り無しでPSDレイヤー分けされたデータをいただけますと幸いです。\n（透過、サイン・メッセージの有無で分けて頂けると助かります）\n\n細かいお願いが多く大変申し訳ありません。\nご縁がありましたらよろしくお願い致します。\n\n最後まで見て頂きありがとうございました。\n\nhttps://twitter.com/h7_yurine/status/1637834949620547585?s=46&t=DIJT28jGYjxqb0Q9P0It3g", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@__32_0/works/8", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/48af3981/uploads/origins/a9402994-6d8a-422f-aa0b-fc3a5a5038d4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=ccfd0678b363fc1115dc2f194400ca2f", "srcset": "https://si.imgix.net/48af3981/uploads/origins/a9402994-6d8a-422f-aa0b-fc3a5a5038d4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=ccfd0678b363fc1115dc2f194400ca2f, https://si.imgix.net/48af3981/uploads/origins/a9402994-6d8a-422f-aa0b-fc3a5a5038d4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=8612d5da3f7277cbc15650e90ceefcbb 2x, https://si.imgix.net/48af3981/uploads/origins/a9402994-6d8a-422f-aa0b-fc3a5a5038d4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=a02374e087f1d2622e195bb8615de422 3x"}, "private": true, "genre": "art", "tipped": false, "creator_id": 73560, "client_id": 2672326, "nc": 16}, {"path": "/@__32_0/works/7", "private_thumbnail_image_urls": null, "private": false, "