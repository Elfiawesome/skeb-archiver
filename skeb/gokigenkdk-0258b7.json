ば納品ファイル内どこかにご記載ください。\n許可を頂いていないものには使用いたしません。\n\n■納品形式\n・背景・人物・文字・サインを別々に分けたものを頂けることは可能でしょうか？\n・ポストに載せていたもののようにGIFアニメーションでの納品希望したいです（PSDもあると嬉しいです）\n・配信画面に載せることを想定して背景が透過しているもの、あるいはグリーンバックのものもあわせて頂けますと助かります。\n\n要望が多く大変申し訳ありませんが、描いていただけるだけでも嬉しいので、\nご検討の程どうぞよろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/1YrguZWxnqGbi3DTLvvnI8LkQdFyC4MYo?usp=sharing", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@gokigenkdk/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3486180, "client_id": 3399332, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/aec47042/uploads/origins/e68e93e0-7e61-4b87-b249-085a5d7e6d8b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f8dd3c6f2ac69fcb92d3490bbb7a04ba", "srcset": "https://si.imgix.net/aec47042/uploads/origins/e68e93e0-7e61-4b87-b249-085a5d7e6d8b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f8dd3c6f2ac69fcb92d3490bbb7a04ba, https://si.imgix.net/aec47042/uploads/origins/e68e93e0-7e61-4b87-b249-085a5d7e6d8b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=0e3d847963026c3f1bd3e9efc763c230 2x, https://si.imgix.net/aec47042/uploads/origins/e68e93e0-7e61-4b87-b249-085a5d7e6d8b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=322ffb554b5a6b40f35850c2e8a2e731 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/aec47042/uploads/origins/e68e93e0-7e61-4b87-b249-085a5d7e6d8b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6174d4255d98cb89eeace672905480cc", "srcset": "https://si.imgix.net/aec47042/uploads/origins/e68e93e0-7e61-4b87-b249-085a5d7e6d8b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6174d4255d98cb89eeace672905480cc, https://si.imgix.net/aec47042/uploads