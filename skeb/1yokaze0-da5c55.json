ive/folders/1T3uhYMHh5On_LsGcg4iWRsM6KrDvoEVq\n\n可能であれば、モノクロのマンガページを願いしたいと思います。\n紫髪の子はケーキ🍰をできて、青髪に味見をしてもらおうと、期待に満ちた目で見ている。\n美味しくなさそうなケーキを見て、最初青髪は笑顔も出さなかったところ、拒否しようとするが、相手の様子を見ると、本心を逆らって褒めた。\n具体的な段取りは先生次第だと思います。\n\n料金が足りない場合、再送要請を願いします。\nどうぞよろしくお願いします。", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@1yokaze0/works/7", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/4c00a2be/uploads/origins/0466d7f5-668e-4ab4-8159-8b13a98f1002?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=dd11d7f818a9fbf4b40aa207efd06932", "srcset": "https://si.imgix.net/4c00a2be/uploads/origins/0466d7f5-668e-4ab4-8159-8b13a98f1002?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=dd11d7f818a9fbf4b40aa207efd06932, https://si.imgix.net/4c00a2be/uploads/origins/0466d7f5-668e-4ab4-8159-8b13a98f1002?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=cbb124cb21c2b1da7710e8e476d25cf4 2x, https://si.imgix.net/4c00a2be/uploads/origins/0466d7f5-668e-4ab4-8159-8b13a98f1002?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=4ada8e651fc6021278dc8f1aa4477353 3x"}, "private": true, "genre": "art", "tipped": true, "creator_id": 784315, "client_id": 308836, "nc": 128}, {"path": "/@1yokaze0/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 784315, "client_id": 1418548, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/31cbf38b/uploads/origins/4849d77f-c928-4d0a-a96a-9695a74cf81e?bg=%23fff&auto=form