net/48cfe41e/uploads/origins/ac503f22-76e0-4b1b-92af-4c115637b977?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=8fd3ed1fe704d26a46a4f4e9f941d879, https://si.imgix.net/48cfe41e/uploads/origins/ac503f22-76e0-4b1b-92af-4c115637b977?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=66f9d63444aa19610969b878190cb4ff 2x, https://si.imgix.net/48cfe41e/uploads/origins/ac503f22-76e0-4b1b-92af-4c115637b977?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=be9a56f364091fd375bed8599b68d4f7 3x"}, "body": "こんにちは！あなたのウマ娘作品が大好きです！私のオリジナルキャラクターをドリームジャーニーのトレーナーとして描いてください！身長差はありますが、怖さは同じです！あなたのビジョンを信じて、気長に待ちます！\n\nhttps://imgur.com/a/l9uvd8I\n\nhttps://umamusume.fandom.com/wiki/Dream_Journey", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@wakkigen/works/9", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1015710, "client_id": 663495, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/786b4fe5/uploads/origins/dc0030b8-60d5-4509-a0d4-df784bd44b80?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=909c21700976ec56067829e6fa13b61a", "srcset": "https://si.imgix.net/786b4fe5/uploads/origins/dc0030b8-60d5-4509-a0d4-df784bd44b80?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=909c21700976ec56067829e6fa13b61a, https://si.imgix.net/786b4fe5/uploads/origins/dc0030b8-60d5-4509-a0d4-df784bd44b80?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=7bbd1d1716e83579801af07f5e5d4d23 2x, https://si.imgix.net/786b4fe5/uploads/origins/dc0030b8-60d5-4509-a0d4-df784bd44b80?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=6016c90812e97dd13212aa085cd2bd67 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/786b4fe5/uploads/origins/dc0030b8-60d5-4509-a0d4-df784bd44b80?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=fa92b62d5e791faf4e57687b8fb5df01", "srcset": "https://si.imgix.net/786b4fe5/uploads/origins/dc0030b8-60d5-4509-a0d4-df784bd44b80?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=fa92b62d5e791faf4e57687b8fb5df01, https://si.imgix.net/786b4fe5/uploads/origins/dc0030b8-60d5-4509-a0d4-df784bd44b80?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=384a26bb0c0e9684498698464c77132c 2x, https://si.imgix.net/786b4fe5/uploads/origins/dc0030b8-60d5-4509-a0d4-df784bd44b80?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=75762bfb34fb503ff213c8b6da514854 3x"}, "body": "初めまして。\nTwitterにてわっきげんさんのイラストをお見掛けして気になっていたため今回リクエストを送らせていただきました。\n\n今回依頼させていただきたいのは私のオリジナルウマ娘であるプロフェッサーです。（https://drive.google.com/drive/folders/1ylAodGy9tkSuhmROnSg8MeX0tSkV6wHi?usp=sharing）\nシチュエーションといたしましては、前にわっきげんさんが描かれていたタンホイザのダンス動画イラスト（https://twitter.com/wakkigen/status/1651160520941248512/photo/1）が個人的にとても刺さりまして、いわゆるダンスレッスン時の様子を描いていただきたいです。\nトレーニングウェアを着用し激しめのダンスの汗を流しながら練習している姿をお願いいたします。\n\n不明点・記載のない箇所につきましては絵師様のお任せでお願いいたします。\n\nhttps://drive.google.com/drive/folders/1ylAodGy9tkSuhmROnSg8MeX0tSkV6wHi?usp=sharing", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@wakkigen/works/8", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1015710, "client_id": 1935863, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/23a0ae1d/uploads/origins/bd3c0368-2fa4-4e44-ae4e-e0c5f28dbad0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=25b71d868beb6e9276f94f22b2bab276", "srcset": "https://si.imgix.net/23a0ae1d/uploads/origins/bd3c0368-2fa4-4e44-ae4e-e0c5f28dbad0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=25b71d868beb6e9276f94f22b2bab276, https://si.imgix.net/23a0ae1d/uploads/origins/bd3c0368-2fa4-4e44-ae4e-e0c5f28dbad0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ace4517835ab690f7daad2d41c06713a 2x, https://si.imgix.net/23a0ae1d/uploads/origins/bd3c0368-2fa4-4e44-ae4e-e0c5f28dbad0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=2cdd307cbcdfa748a2b56e8ad4ea4757 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/23a0ae1d/uploads/origins/bd3c0368-2fa4-4e44-ae4e-e0c5f28dbad0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ceee8017f9b412a71542c7b4fe271dbe", "srcset": "https://si.imgix.net/23a0ae1d/uploads/origins/bd3c0368-2fa4-4e44-ae4e-e0c5f28dbad0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ceee8017f9b412a71542c7b4fe271dbe, https://si.imgix.net/23a0ae1d/uploads/origins/bd3c0368-2fa4-4e44-ae4e-e0c5f28dbad0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=e3e1662e46332a14cffa8d2ea539c64e 2x, https://si.imgix.net/23a0ae1d/uploads/origins/bd3c0368-2fa4-4e44-ae4e-e0c5f28dbad0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=15f6ebc851a7d8e9e38243249298ed5a 3x"}, "body": "【データ概要】\n\n小説の挿絵　モノクロイラスト一枚　縦横比105：148\n\n【シチュエーション概要】\n\n・エイシンフラッシュとスマートファルコンがショックを受けて唖然としている絵をお願いします。季節は春で、ふたりとも春服を着せてあげてください（既存の私服と異なる春服をチョイスしてあげてください）\n・ふたりが王様のブランチの買い物の達人のような企画に参加し、最後にNGワードの発表とそれによる罰金額により、その日の買い物が全てパーになってしまったシーンです。ふたりはそれ（罰金の存在）を一切忘れていたので、しっかり驚いています。\n\n【構図概要】\n・画面にはフラッシュとファル子のふたりが並んでいます。中心から少し右に、足から上が映る形で画角に入っています。ふたりの身体の向きは真正面ではなく少し左（読み手から見て）です。\n・背景上部に、−135000（NGワード27回分）と表示し、背景全体にはショッキングなエフェクトを描いてほしいです。（参考　クレヨンしんちゃんのげんこつカットインなど）\n・シンプルなマフラー、くまのぬいぐるみ、瓶詰めのプリン（高級なもの）を、少し薄めの色合い（買ったはずなのに、という喪失感）で背景に散らばせてほしいです。\n・フラッシュとファル子は手前で明度は明るめに、背景は暗めでお願いします。\n\n以上です。", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@wakkigen/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1015710, "client_id": 1007291, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/f9c389b8/uploads/origins/10d4297c-c252-4408-9af5-05caaf859ff3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1c3a4c15412c38d36b14f0722e8a7c88", "srcset": "https://si.imgix.net/f9c389b8/uploads/origins/10d4297c-c252-4408-9af5-05caaf859ff3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1c3a4c15412c38d36b14f0722e8a7c88, https://si.imgix.net/f9c389b8/uploads/origins/10d4297c-c252-4408-9af5-05caaf859ff3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=77c10c5f9d0e5764da196675241bc5ce 2x, https://si.imgix.net/f9c389b8/uploads/origins/10d4297c-c252-4408-9af5-05caaf859ff3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c7f874144533339a95a61bf05a52a8a8 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/f9c389b8/uploads/origins/10d4297c-c252-4408-9af5-05caaf859ff3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3c6f708db5f0d852a36d4780f299d7c7", "srcset": "https://si.imgix.net/f9c389b8/uploads/origins/10d4297c-c252-4408-9af5-05caaf859ff3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3c6f708db5f0d852a36d4780f299d7c7, https://si.imgix.net/f9c389b8/uploads/origins/10d4297c-c252-4408-9af5-05caaf859ff3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=fb984c2375c07d01c86d2c45cdab77aa 2x, https://si.imgix.net/f9c389b8/uploads/origins/10d4297c-c252-4408-9af5-05caaf859ff3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=c1440e681229baa92f59e50cc8cd5b82 3x"}, "body": "おつかれさまです。\nわっきげんさんのSP隊長が大好きで「もうこれが公式でいいよ」と思いながら毎度楽しみに拝見させてもらっています。\n\nそこで今回ファインモーションのストーリー6話のワンシーン、竜退治後のラーメン屋でのファイン、トレーナー、SP隊長3人の会話を映像化して貰いたくひとコママンガをリクエストさせて頂きます。\n\n映像は壁際の長椅子席にファインと隊長が並んで座っていて、テーブルを挟んで座るトレーナーの目線\n\n台詞はこのシーン\n\n・ファイン「そうだ。それならトレーナーにも何か用意しないとだね。えーと、『ドラゴンスレイヤー十字章』とかどうかな？」\n・トレ「い、いいんじゃないか？」\n・隊長「おめでとうございます。まぁ『魔女熱演勲章』『聖お城役勲章』を持つ、この私の栄誉には少し届かないかもしれませんが……。」\n\nでお願いします。\n\n和やかに微笑むファインと、笑顔の中でマウントを取るようにドヤ顔をキメるSP隊長、といった感じで映像化して頂けると嬉しいです。\n\nそれでは、どうぞよろしくお願いします。\n\nhttps://twitter.com/dan_yuuji/status/1690308550655123458?s=46", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@wakkigen/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1015710, "client_id": 2102369, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/27ed4aee/uploads/origins/96a322a5-2d53-4fe0-b04b-2eacea8d0b31?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=045d5507228439bce95848fc576fb60f", "srcset": "https://si.imgix.net/27ed4aee/uploads/origins/96a322a5-2d53-4fe0-b04b-2eacea8d0b31?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=045d5507228439bce95848fc576fb60f, https://si.imgix.net/27ed4aee/uploads/origins/96a322a5-2d53-4fe0-b04b-2eacea8d0b31?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=0a9c63313c92c53e6fa8d6040bfb47cc 2x, https://si.imgix.net/27ed4aee/uploads/origins/96a322a5-2d53-4fe0-b04b-2eacea8d0b31?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=87b19bf47a7b38bbcf0e0a3b68fa5631 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/27ed4aee/uploads/origins/96a322a5-2d53-4fe0-b04b-2eacea8d0b31?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9a04e0f75781f5d05c825fda24a5b505", "srcset": "https://si.imgix.net/27ed4aee/uploads/origins/96a322a5-2d53-4fe0-b04b-2