864008674652160\n\nhttps://twitter.com/rokusuijo/status/572076183912775680\n\n絵の構図などは\nhttps://twitter.com/maruma_tw/status/1438797376794218501?s=20\nこちらの絵のように拳を突き出してるポーズで、表情は笑っている姿をお願いします。\n描写範囲はこちらの絵と同じくらいの範囲でお願いします。\n胸の谷間は見せていただけると幸いです。\n巨乳キャラなので胸を大きく描いていただければ幸いです。\n\n前髪は\nhttps://twitter.com/rokusuijo/status/854197406019198976?s=21\nこちらの1枚目と同じでお願いします。\n\nこの絵はtwitterに載せていただけると幸いです。", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@Hirohirarin/works/8", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1160176, "client_id": 1034834, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/0e9b5118/uploads/origins/e97616f9-4b64-4a26-8b49-8d7b34866f09?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ad7d8bc333e067c78b323348fb296c2b", "srcset": "https://si.imgix.net/0e9b5118/uploads/origins/e97616f9-4b64-4a26-8b49-8d7b34866f09?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ad7d8bc333e067c78b323348fb296c2b, https://si.imgix.net/0e9b5118/uploads/origins/e97616f9-4b64-4a26-8b49-8d7b34866f09?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=346f1c1ba9fb36b900b8651c533a2743 2x, https://si.imgix.net/0e9b5118/uploads/origins/e97616f9-4b64-4a26-8b49-8d7b34866f09?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=7608c98d86c9192b4d1da87deb67d0e3 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/0e9b5118/uploads/origins/e97616f9-4b64-4a26-8b49-8d7b34866f09?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=dc55652302dfca2e70816eb38d0b7042", "srcset": "https://si.imgix.net/0e9b5118/uploads/origins/e97616f9-4b64-4a26-8b49-8d7b34866f09?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=dc55652302dfca2e70816eb38d0b7042, https: