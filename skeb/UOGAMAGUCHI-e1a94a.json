ers/1twi7NgYDp0Nd-2mpT_O8BXaroN7wtTyO", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 899508, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "よしお", "screen_name": "scomsio", "avatar_url": "https://proxy.misskeyusercontent.jp/avatar/media.misskeyusercontent.jp%2Fio%2F1643ff31-9fe7-49c5-a8d6-74e745d202d0.png%3Fsensitive%3Dtrue?avatar=1", "header_url": "https://media.misskeyusercontent.jp/io/a2332b22-d895-43ee-8c7f-713a5d903a09.png", "appeal_receivable": true, "popular_creator_rank": 77, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 5, "complete_expiration_days": 21, "skills": [{"genre": "art"}], "banned": false, "nc": 176}, {"id": 1688710, "creator": true, "nsfw_acceptable": true, "acceptable": false, "name": "KiiKo @アニメ原画風skeb", "screen_name": "Kiiko_clip", "avatar_url": "https://proxy.misskeyusercontent.jp/avatar.webp?url=https%3A%2F%2Fmedia.misskeyusercontent.jp%2Fio%2Fd4b360a8-1c07-44f9-b59a-94c6982e2227.gif&avatar=1", "header_url": "https://media.misskeyusercontent.jp/io/fb207f67-3c6c-47bb-9795-c6d4b3977f4a.webp", "appeal_receivable": false, "popular_creator_rank": 39, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 8, "complete_expiration_days": 120, "skills": [{"genre": "art"}], "banned": false, "nc": 49}, {"id": 2816753, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "江坂（えさか）", "screen_name": "us_du2", "avatar_url": "https://pbs.twimg.com/profile_images/1674602278412746752/ePM73aoN.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1674473414508306433/1695400494/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expi