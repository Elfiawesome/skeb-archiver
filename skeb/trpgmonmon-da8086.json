h=200&blur=200&s=ee26465fa09326906f7b75216600b4c1", "srcset": "https://si.imgix.net/f720c6d2/uploads/origins/5cb09d3c-c99e-42ac-9095-bdb3ed31a527?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ee26465fa09326906f7b75216600b4c1, https://si.imgix.net/f720c6d2/uploads/origins/5cb09d3c-c99e-42ac-9095-bdb3ed31a527?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=c26ab07cf4c0bbf043f90ed6bc3050d7 2x, https://si.imgix.net/f720c6d2/uploads/origins/5cb09d3c-c99e-42ac-9095-bdb3ed31a527?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=95e9856915733a9644d592a7b2bc0cfc 3x"}, "body": "こんにちは、ねり悶🌼依頼募集中さん！冬日です。\nあなたのイラストのスタイル、とても気に入りました！\nもしよろしければ、私のオリジナルキャラクター2体のイラストをお願いしたいのですが。\n\n[プロフィール]\nhttps://drive.google.com/drive/folders/1Bs9ALwrON-EQlEh587-Yg30eIy83x9gG\n\nキャラクター設定に合わせて、自由に描いていただけると嬉しいです！\nフォルダ内のパラディウムも描いていただいて構いません。\nキャラクターをどのように表現してくださるのか、とても楽しみです。\n\n服装、ポーズ、背景はご自由に決めていただいて構いません。\n報酬額が不十分な場合は、金額を変更してください。\n依頼のキャンセルも遠慮なくお願いします。\n署名は別のレイヤーに分けていただけると助かります！", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@trpgmonmon/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 4009590, "client_id": 3672338, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/6d7858a5/uploads/origins/067f3d2a-82dd-44ed-b3d0-43ff0d4d56ed?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bf7b6cdab4b31a9569953a0dd1db0bb3", "srcset": "https://si.imgix.net/6d7858a5/uploads/origins/067f3d2a-82dd-44ed-b3d0-43ff0d4d56ed?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bf7b6cdab4b31a9569953a0dd1db0bb3, https://si.imgix.net/6d7858a5/uploads/origins/067f3d2a-82dd-44ed-b3d0-43ff0d4d56ed?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=370fdd9e4846dce8ef5b965ba2a7f00b 2x, https://si.imgix.net/6d7858a5/uploads/origins/067f3d2a-82dd-44ed-b3d0-43ff0d4d56ed?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=3b324c77e859e0258572f7c4d4e874f6 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/6d7858a5/uploads/origins/067f3d2a-82dd-44ed-b3d0-43ff0d4d56ed?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=08209a46742b3db56c5a5dbdae53831e", "srcset": "https://si.imgix.net/6d7858a5/uploads/origins/067f3d2a-82dd-44ed-b3d0-43ff0d4d56ed?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=08209a46742b3db56c5a5dbdae53831e, https://si.imgix.net/6d7858a5/uploads/origins/067f3d2a-82dd-44ed-b3d0-43ff0d4d56ed?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=39a13a2565c7c9f897ac66c3b4e80e1f 2x, https://si.imgix.net/6d7858a5/uploads/origins/067f3d2a-82dd-44ed-b3d0-43ff0d4d56ed?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=92486e5f704e40d0a52b0abbb37890a0 3x"}, "body": "はじめまして、みつをと申します。\nねり悶さんのキャラクターを拝見し、とっても特徴を掴んでいてすごくかわいくて素敵だと思い依頼させていただきます…！\n今回、TRPGシナリオ「父の不倫に感謝しています」のPCたちの依頼をお願いさせていただきたく、よろしくお願いいたします。\n\n【キャラについて】\n腹違いの兄弟。幼い頃に兄弟と知らずに遊んでいた時期があったが、父の葬儀で再会した。\n今は兄弟であり、恋人という関係に落ち着いている。一緒に住むことになった。\n\n【東雲　三雲（しののめ　みくも）】\n男/27歳/174m\n雑誌の記者をしている。愛想がよいが、実際は人が嫌い。だが、根がお人よしのため、人を突き放し切れない。\n孤児として育ってきた環境から、信じられるのは形のあるもの(特にお金)。母を捨てた父親のことは大嫌い。\nお金を得るのも好きだが、酒や煙草などで浪費するのも大好き。\n愛を信じられないと言っていたが、今は留くんからの愛を信じられるようになった。\n\n\n【音雨　留（おとあめ　とめる）】\n男/22歳/170cm前後\n作家。丁寧で礼儀正しい。人当たりはいいが、人に対して深入りしない。\n裕福な家庭で育った。現在家から離れているが、お金持ち。\n三雲に対しては、とても甘い。何でもしようとする節がある。\n一方、自分のことに関しては、頼るのにためらいがち。\n人除けのために左手薬指に指輪をしていたが、現在三雲に渡している。\n\n\n【関係の変化】\n初めて会ったときは、三雲→同じ父親を持つ兄弟でありながら、苦労知らずの金持ちの弟、留くんに苛立ちを感じている。\n留くん→三雲を愛している。献身的ながら、愛情の示し方が一方的な所がある。\n\n現在は、三雲→自分に足りなかった愛情をくれる存在であり、大切な存在。いなくならないで欲しい。\n留くん→変わらず愛しているし、献身的。お人好しなど、三雲に対して思うところはある様子。\n\n構図についてはお任せしたいです！\n鑑賞用と、作者明記の上Twitterに載せさせていただくこと、skeb依頼の際の資料とさせていただきたいです。\n\n金額等に不備がありましたらお手数です再送いただければと思います…！\n資料については、以下に記載させていただきます。\n\nhttps://drive.google.com/drive/folders/12zMqpZybIQ3nBhd1D9WuLcy5UFSCh8iv?usp=drive_link", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@trpgmonmon/works/6", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/468c40e3/uploads/origins/d2d2bd42-9416-4a8e-9270-909ce4a694e7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=bbcacd446c94b95ae4bcbec4a0099eca", "srcset": "https://si.imgix.net/468c40e3/uploads/origins/d2d2bd42-9416-4a8e-9270-909ce4a694e7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=bbcacd446c94b95ae4bcbec4a0099eca, https://si.imgix.net/468c40e3/uploads/origins/d2d2bd42-9416-4a8e-9270-909ce4a694e7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=a60316008f3be13658bb9eff5b663c4c 2x, https://si.imgix.net/468c40e3/uploads/origins/d2d2bd42-9416-4a8e-9270-909ce4a694e7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=de25a141ef1ad63fd13bee3d9d8e42ea 3x"}, "private": true, "genre": "art", "tipped": true, "creator_id": 4009590, "client_id": 2802738, "nc": 1}, {"path": "/@trpgmonmon/works/5", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/0b3f57a1/uploads/origins/d148a8d1-6008-4eb0-a2d0-dacbb3a89ab0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=7fba6d8bebc3cd13f4ec6976f85fd484", "srcset": "https://si.imgix.net/0b3f