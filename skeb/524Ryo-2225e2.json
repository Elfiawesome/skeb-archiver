ody": "りょう先生\n\nこんにちは、五風です。\nまた先生の絵が見たくなり、今回もぜひ先生にご依頼したいと思い、ご連絡いたしました。\n\n今回お願いしたいのは、「ちょっと犬っぽい雰囲気の姫芽」のイラストです。\n元々姫芽には少しワンちゃんのようなところがあると思うのですが、最近の新カードで厚手の冬服を着ている姿が、まるで冬毛が生えた大型犬のようで……そこからこのリクエストを思い立ちました。\n\nサイズや画面構成について特に指定はございませんので、単独でも他のキャラクターとの組み合わせでも、先生のイメージに合わせて自由に描いていただければ幸いです。\n\n実は去年の今頃に先生が投稿されていた姫芽のイラストからずっと好きで、今回もぜひ先生にお願いしたいと思っていました。\nどうぞよろしくお願いいたします。", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@524Ryo/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 916529, "client_id": 628593, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/ea5a6b0e/uploads/origins/f49ecd44-c259-4e87-91b2-2c68016da977?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=dd9bc3cb29aadb7eaf1dcd6c6d9d75f5", "srcset": "https://si.imgix.net/ea5a6b0e/uploads/origins/f49ecd44-c259-4e87-91b2-2c68016da977?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=dd9bc3cb29aadb7eaf1dcd6c6d9d75f5, https://si.imgix.net/ea5a6b0e/uploads/origins/f49ecd44-c259-4e87-91b2-2c68016da977?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=1b1b331bfc73029dc241607e083b9a8c 2x, https://si.imgix.net/ea5a6b0e/uploads/origins/f49ecd44-c259-4e87-91b2-2c68016da977?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a4f24737e97a78df0361d0d538e691ae 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/ea5a6b0e/uploads/origins/f49ecd44-c259-4e87-91b2-2c68016da977?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f136086e702a10f933333a073761fbfa", "srcset": "https://si.imgix.net/ea5a6b0e/uploads/origins/f49ecd44-c259-4e87-91b2-2c68016da977?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f136086e702a10f933333a073761fbfa, https://si.imgix.net/ea5a6b0e/uploads/o