ない部分については、一般的なスーツスタイルと思っていただいて大丈夫です。\n(③のキャラはネクタイなし、④のキャラは首に黒のチョーカーをつけています。手袋は基本みんなつけてますが、③はタバコを吸うので外していることも多いです)\n\nキャラクター同士仲が良い自陣ですが、今回はほのぼのとした雰囲気よりは「葬儀屋」という肩書きや仕事から浮かぶイメージで描いていただけたら嬉しいです…！\n\n用途として個人鑑賞の他にヘッダーへの使用やPC壁紙などに設定させていただきたいので、横画面の構図を希望させていただきたいです。\n\n金額や内容などに不備があれば遠慮なく再送をお願いいたします…！\n\nhttps://drive.google.com/drive/folders/1r6YvpdzshOEEDeXgFeClmZ4_m-zAmfNa", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@koukikun_0827/works/80", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1711294, "client_id": 2796465, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/66549c57/uploads/origins/719666bd-760f-45e1-a4ed-54878bce58e4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d5fbe97c246ccb9cbc2788dec8d76b00", "srcset": "https://si.imgix.net/66549c57/uploads/origins/719666bd-760f-45e1-a4ed-54878bce58e4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d5fbe97c246ccb9cbc2788dec8d76b00, https://si.imgix.net/66549c57/uploads/origins/719666bd-760f-45e1-a4ed-54878bce58e4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=2d2f5897b7e7ac375f491ba1e04af215 2x, https://si.imgix.net/66549c57/uploads/origins/719666bd-760f-45e1-a4ed-54878bce58e4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=726aa704bb2868b9afbbf33bc18911ef 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/66549c57/uploads/origins/719666bd-760f-45e1-a4ed-54878bce58e4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=abf6377a4e1dbbb5c34a7cff3df2d505", "srcset": "https://si.imgix.net/66549c57/uploads/origins/719666bd-760f-45e1-a4ed-54878bce58e4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=abf6377a4e1dbbb5c34a7cff3df2d505, https://si.imgix.net/