SNSのアイコン等)。また、個人的に鑑賞する目的でポストカードサイズで印刷を行う可能性があります。\n\n背景や構図などの指定は特にありませんが、先生の仄暗く、陰のあるイラストが大好きなので、そのようなテイストで描いていただけると嬉しいです。\n\n金額に不備がある場合、再送やキャンセル等していただきたいです。\nまた、内容が合わなければキャンセルしていただいて大丈夫です。\nご検討いただけますと幸いです。\n\nhttps://drive.google.com/drive/folders/1sg-pMEo7ntu1nGDvaumiHVMxMDGP_Hbz?usp=sharing", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@koukikun_0827/works/66", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/a6681035/uploads/origins/d457bcbe-2e9c-45bf-b359-3dbd59fb0348?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=48e3b46cbcea7057aac72f54fd2b47c9", "srcset": "https://si.imgix.net/a6681035/uploads/origins/d457bcbe-2e9c-45bf-b359-3dbd59fb0348?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=48e3b46cbcea7057aac72f54fd2b47c9, https://si.imgix.net/a6681035/uploads/origins/d457bcbe-2e9c-45bf-b359-3dbd59fb0348?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=b0b3e70570d7478d33f8199b84830882 2x, https://si.imgix.net/a6681035/uploads/origins/d457bcbe-2e9c-45bf-b359-3dbd59fb0348?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=fac055a1333a405c27a0f1aea89a90a7 3x"}, "private": true, "genre": "art", "tipped": false, "creator_id": 1711294, "nc": 16}, {"path": "/@koukikun_0827/works/65", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1711294, "client_id": 3028725, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/86977b8a/uploads/origins/9ff95ae8-9d5b-445e-