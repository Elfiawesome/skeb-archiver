常に人に囲まれている。キャラ①の性格による悩みや恋愛相談などにも親身にのってくれる。キャラ①のことが恋愛の意味で好きだが一生隠すと決めている。\n\n横向きの絵ですと嬉しいです。\nまた、「傘をさして歩いている2人」といったシチュエーションだと嬉しいです。\nもし難しい場合はどうか先生のお好きなように描いていただけたらと思います！  \n\n先生の絵柄でこの子達を見れたら嬉しいなと思っております。\nご検討よろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/1Vv4eZKz0Yh7bHgZQH_EErVb_SsFfj-A-?usp=sharing", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@koukikun_0827/works/86", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1711294, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/d844a034/uploads/origins/eb4e37b5-9446-40b0-815a-b13e5d991214?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6cf3f70b28db4b7762d73ef8dea1f519", "srcset": "https://si.imgix.net/d844a034/uploads/origins/eb4e37b5-9446-40b0-815a-b13e5d991214?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6cf3f70b28db4b7762d73ef8dea1f519, https://si.imgix.net/d844a034/uploads/origins/eb4e37b5-9446-40b0-815a-b13e5d991214?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=11ad184176686a4bb14600b13f8dfefc 2x, https://si.imgix.net/d844a034/uploads/origins/eb4e37b5-9446-40b0-815a-b13e5d991214?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=18fe87b76d1c7a977c1842b99255d790 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/d844a034/uploads/origins/eb4e37b5-9446-40b0-815a-b13e5d991214?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=7401f577e7777748a7f3bd0f1e457e9d", "srcset": "https://si.imgix.net/d844a034/uploads/origins/eb4e37b5-9446-40b0-815a-b13e5d991214?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=7401f577e7777748a7f3bd0f1e457e9d, https://si.imgix.net/d844a034/uploads/origins/eb4e37b5-9446-40b0-815a-b13e5d991214?bg=%23fff&auto=format%2C