cHU0h2eHdo1GEa7TX-a9az7S?usp=sharing\n\n■OC-A\n公務員/32歳/男/178cm\nOC-Bの兄。OC-Cとは高校からの友人。\n面倒ごとはなるべく避けて生きていたい。自他ともに平穏であれと思うタイプの人。効率厨の面もある。\nラーメンよりゲーム（ソシャゲ）のポイントが気になる。\n\n■OC-B\n刑事/29歳/男/173cm\nOC-Aの弟で、OC-CとOC-Dの後輩。\n努力家で何事にも一生懸命なタイプ。\nラーメンはもりもり食べる。餃子も食べる。\n\n■OC-C\n刑事/32歳/男/180cm\nOC-Dの従兄弟。OC-Aとは高校からの友人。\n内面は冷静だが、表面的には自信家で愛嬌がある振る舞いをする。\nラーメン食べてる後輩見守るのが好き。いっぱい食えと思う。\n\n■OC-D\n刑事/31歳/男/175cm\nOC-Cの従兄弟で、OC-Bの先輩。\n冷静沈着で淡々としており表情の変化が乏しい。\n無難なので醤油ラーメンを選びがち。\n\n■使用用途\n・個人観賞、SNSのアイコン・ヘッダーの使用、グッズ作成\n・相手キャラクターの創作者との画像共有\n\n金額に不備がございましたらお手数ですが再送のリクエストをいただければと思います。\nどうぞよろしくお願いいたします。", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@koukikun_0827/works/76", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1711294, "client_id": 2966150, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/34c1fc1c/uploads/origins/54e91d58-18ac-454c-a2fe-bdec750dc082?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=82c742a906fd97e4d21220585f13f3eb", "srcset": "https://si.imgix.net/34c1fc1c/uploads/origins/54e91d58-18ac-454c-a2fe-bdec750dc082?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=82c742a906fd97e4d21220585f13f3eb, https://si.imgix.net/34c1fc1c/uploads/origins/54e91d58-18ac-454c-a2fe-bdec750dc082?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=74a5b050c77c43d43894e1167b00a3e0 2x, https://si.imgix.net/34c1fc1c/uploads/origins/54e91d58-18ac-454c-a2fe-bdec750dc082?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=7fcabc2f701f5f507ce63576c75fcc10 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/34c1fc1c/uploads/origins/54e91d58-18ac-454c-a2fe-bdec750dc082?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e5c3615ba1fddb3462f02ed06204cb1c", "srcset": "https://si.imgi