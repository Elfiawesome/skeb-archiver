かせします。\n\n金額などに問題がありましたら、お手数ですが再送いただけますと幸いです。\n\nご検討のほどよろしくお願いいたします！\n\nhttps://drive.google.com/drive/folders/1fH307XFp5VmJUBn7JlrBvHlfReNmrDXB\n\nhttps://drive.google.com/drive/folders/1fH307XFp5VmJUBn7JlrBvHlfReNmrDXB", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@koukikun_0827/works/82", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/804819b0/uploads/origins/76995ba4-309b-4450-bf68-1f5f3e21820f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=c0a20977862b3040a95fe4fcb480ffd1", "srcset": "https://si.imgix.net/804819b0/uploads/origins/76995ba4-309b-4450-bf68-1f5f3e21820f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=c0a20977862b3040a95fe4fcb480ffd1, https://si.imgix.net/804819b0/uploads/origins/76995ba4-309b-4450-bf68-1f5f3e21820f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=1d1d34b8792a3a3564e49fae51b736dd 2x, https://si.imgix.net/804819b0/uploads/origins/76995ba4-309b-4450-bf68-1f5f3e21820f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=328d356d75a22f337fb5fc07968579f4 3x"}, "private": true, "genre": "art", "tipped": false, "creator_id": 1711294, "nc": 129}, {"path": "/@koukikun_0827/works/81", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1711294, "client_id": 2563301, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/276a6854/uploads/origins/8910cd9b-0083-4395-ad41-e62ebe15ba38?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=