eb1946827060adde72e80b9", "src_set": ""}, "private": true, "genre": "art", "tipped": true, "creator_id": 289534, "client_id": 0, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 49, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@tokage_eri/works/39", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 289534, "client_id": 0, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/1502fc4c/uploads/origins/3d93c81e-f98d-462b-8d27-c23e78d55bad?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=99ea8df79a3963c43170d0d55ac765c9", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/1502fc4c/uploads/origins/3d93c81e-f98d-462b-8d27-c23e78d55bad?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c2870b8abe88d31fed80c925613f5d37", "src_set": ""}, "body": "初めてリクエストさせていただきます。\nくらみどさんのイラストは画面密度がすごい&シチュエーションに一切の容赦や妥協がないのが魅力だと感じています。\n僭越ながら、今回もそのような高密度で度を超えたどちゃくそえっちなイラストをご提供いただければ幸いです。\n\nsakifoxさんの作品に登場する変身後の「不取羽恋」の無様エロ処刑をお願いします。\n\n（背景シチュエーション：研究者サキュバスによって研究所に捕らわれて能力を解析され、透過≒レイヤー上下の解釈を上位/下位存在に変更の上、強制適応される。\nそのルールは「不取羽恋の身体レイヤー（仮称）を“下位存在”と規定。不取羽恋以外の物体は生物・非生物の区別なく不取羽恋の身体に接触し効果を与えるが、不取羽恋は全ての物体に対して“干渉”することができない。レイヤー（仮称）構成および“干渉”の解釈は研究者サキュバスが規定し、不取羽恋による任意の能力発動および解除は不可。」)\n\n\n以下リクエスト内容です。\n\n「上記の状態で首を吊られ、頭には複数の電極が刺さっていて、身体のあちこちには媚薬注射用のシリンジが突き刺さり、股間や乳首にはバイブ・ローター、電極パッドを貼り付けられるなど、ありとあらゆる手段で絶頂させられている。\n強制絶頂の苦痛から逃れようとして首を括っている縄や身体に取り付けられたものを外そうとするが、ずはちゃんからは“干渉”できないため透過してしまい触ることができずじたばたもがいて絶叫しながらイキ狂うことしかできない。」\n\n以上のシチュエーションをお願いいたします。\n補足として以下の描写をイラスト内に組み込んでいただけると幸いです。\n\n●身体の器具が透過してしまい触れることができない描写\n● ずはちゃんの喘ぎ狂うセリフの吹き出し（大量）\n●効果音の文字表現\n●大量に飛び散るずはちゃんのイキ潮や体液各種\n●度を超えた絶頂のあまり噴き出している鼻血\n●サキュバス達の会話（内容はお任せします、効果的と思われるセリフを入れていただければ幸いです）\n●いずれ処分されることを示唆する描写（今回の責め