ient_visible": false, "total_appeals_count": 0, "received_works": [{"path": "/@exec_paint/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2491706, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/9c204688/uploads/origins/f5e34480-d40c-461f-bb0f-14e36b01c3ef?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4441dd9d8eef418b9ff4cc3f28fabe5f", "srcset": "https://si.imgix.net/9c204688/uploads/origins/f5e34480-d40c-461f-bb0f-14e36b01c3ef?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4441dd9d8eef418b9ff4cc3f28fabe5f, https://si.imgix.net/9c204688/uploads/origins/f5e34480-d40c-461f-bb0f-14e36b01c3ef?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=03fb1e2bc1e5f20fb67024a02f9c73a9 2x, https://si.imgix.net/9c204688/uploads/origins/f5e34480-d40c-461f-bb0f-14e36b01c3ef?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=17f6695d66545a5bf93564003b9d9308 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/9c204688/uploads/origins/f5e34480-d40c-461f-bb0f-14e36b01c3ef?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ef4b704804f25c9e6d196dc0accf17a8", "srcset": "https://si.imgix.net/9c204688/uploads/origins/f5e34480-d40c-461f-bb0f-14e36b01c3ef?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ef4b704804f25c9e6d196dc0accf17a8, https://si.imgix.net/9c204688/uploads/origins/f5e34480-d40c-461f-bb0f-14e36b01c3ef?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=ef166147b81d8c22f9ae69226116495e 2x, https://si.imgix.net/9c204688/uploads/origins/f5e34480-d40c-461f-bb0f-14e36b01c3ef?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=ee14483bf187b4002cbc8699a376e9d1 3x"}, "body": "初めてリクエストさせていただきます。\n『鷲尾須美は勇者である』より、三ノ輪銀が3体のバーテックスとの戦闘で重傷を負いながらも生還したというif設定で、入院中の彼女のイラストを描いていただけないでしょうか。\n\n○設定\n三ノ輪銀は3体のバーテックスとの戦闘で辛うじて一命を取り留めるも、右腕を失うなどの重傷を負って昏睡状態になってしまう。表向きはお役目中の事故で意識不明になったことにされ、しばらくして(数週間~数ヶ月後)意識が戻った後も具体的な容態は伏せられている。それ以外の経緯はそちらにお任せします。\n\n○容姿・服装\n病衣の上にカーディガンを羽織っている。右の頬など本編の最期で負傷していた場所に傷痕が残っているほか、全体的に髪は伸び、少々やつれている。\n\n○構成(描きやすいようある程度改変していただいて構いません)\n①ある日クラスメイトの1人が病院に来ていると、点滴台を持って廊下を移動している銀を見かける。銀の回復を喜んだクラスメイトは思わず彼女に声をかけるも、その途中で右腕に気づいて言葉を詰まらせてしまう。\n②クラスメイトに気づいた銀は咄嗟に左手で右腕を庇い、笑顔を繕いながら応える。銀の体のことを心配するクラスメイトに対し、心配いらないと以前のように気丈に振る舞うも、その表情にはどこか陰りが見られる。\n\nかなり好き嫌いの分かれる描写を含みますので、少しでも抵抗や解釈違いがございましたら、キャンセルしていただけると幸いです。ご検討のほどよろしくお願いいたします。", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@exec_paint/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2491706, "client_id": 1452085, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/cece9f32/uploads/origins/8d232692-0ee2-4b0d-8e85-5a86b95eb377?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f1f827c516fbd265f8af3f31a02327ca", "srcset": "https://si.imgix.net/cece9f32/uploads/origins/8d232692-0ee2-4b0d-8e85-5a86b95eb377?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f1f827c516fbd265f8af3f31a02327ca, https://si.imgix.net/cece9f32/uploads/origins/8d232692-0ee2-4b0d-8e85-5a86b95eb377?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a7069efd427343462575de1402282b9d 2x, https://si.imgix.net/cece9f32/uploads/origins/8d232692-0ee2-4b0d-8e85-5a86b95eb377?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=dc9e670bc502069a8a6a0c76e39056fb 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/cece9f32/uploads/origins/8d232692-0ee2-4b0d-8e85-5a86b95eb377?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=60b3d249575c701868877588ee86eeaf", "srcset": "https://si.imgix.net/cece9f32/uploads/origins/8d232692-0ee2-4b0d-8e85-5a86b95eb377?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=60b3d249575c701868877588ee86eeaf, https://si.imgix.net/cece9f32/uploads/origins/8d232692-0ee2-4b0d-8e85-5a86b95eb377?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=a5f9e4a61a24b0d9e5a2328b3734b3b4 2x, https://si.imgix.net/cece9f32/uploads/origins/8d232692-0ee2-4b0d-8e85-5a86b95eb377?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=c1c9c79abc483fd9629445346d07baac 3x"}, "body": "依頼させていただきます。\n\nキャラクター：郡千景、乃木若葉(のわゆ)\n\nゆゆゆい2019年バレンタインイベントにて\n図書室で若葉ちゃんが千景にもたれかかって寝てしまうところのイラストをお願いいたします。\n↓下記URL動画の 1:30〜4:33 あたり\nhttps://www.nicovideo.jp/watch/sm34629550?ref=nicoiphone_other\n\n\n詳細：\n若葉が千景の膝枕ですやすや寝ており、千景は顔を赤くして、寝てる若葉の頬を指でつんつんしてる感じでお願いします。\n衣装等は上記動画の原作と同じ私服。\n\n以上よろしくお願いします。", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@exec_paint/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2491706, "client_id": 3243210, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/4f22428a/uploads/origins/685db2c6-b178-40ac-a586-64bb7d8eaccc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9e8581891e4bdbafd656fea11a07f58c", "srcset": "https://si.imgix.net/4f22428a/uploads/origins/685db2c6-b178-40ac-a586-64bb7d8eaccc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9e8581891e4bdbafd656fea11a07f58c, https://si.imgix.net/4f22428a/uploads/origins/685db2c6-b178-40ac-a586-64bb7d8eaccc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=6402e55c426fa44612de8486f1430e04 2x, https://si.imgix.net/4f22428a/uploads/origins/685db2c6-b178-40ac-a586-64bb7d8eaccc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d24d48ec34e3abec13e15881d7d97f00 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/4f22428a/uploads/origins/685db2c6-b178-40ac-a586-64bb7d8eaccc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=59a07a4310608e2e1e1be1d49e9b847f", "srcset": "https://si.imgix.net/4f22428a/uploads/origins/685db2c6-b178-40ac-a586-64bb7d8eaccc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=59a07a4310608e2e1e1be1d49e9b847f, https://si.imgix.net/4f22428a/uploads/origins/685db2c6-b178-40ac-a586-64bb7d8eaccc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=a656ad518f5bcb6a60d97db1380501cd 2x, https://si.imgix.net/4f22428a/uploads/origins/685db2c6-b178-40ac-a586-64bb7d8eaccc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=04b666505010c916763ad9c7d3c1331a 3x"}, "body": "丸太さん、こんにちは。\nいつも楽しく拝見しており、今回初依頼をさせていただきます。\n\n[内容]\n◯キャラクター\n(結城友奈は勇者である)より東郷美森\n\n◯シチュエーション\n主観視点でヤンデレ東郷美森に恋人繋ぎをされて押し倒されてる\n服装とポーズは下記のURLを参考していただけると助かります。\n\n◯セリフ\n「大好き」「愛してる」等、愛が重いセリフ\n※セリフは丸太さん解釈次第で変更しても問題ありません。\n\n◯要望\n東郷さんの相手が結城友奈や乃木園子等、誰が相手でも大丈夫なイラストであると幸いです。\nその他細かい点は丸太さんにお任せします。\n\n依頼は以上になります。\n至らぬ点があるかもしれませんがぜひよろしくお願いします\n\nhttps://www.pixiv.net/artworks/112962446", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@exec_paint/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2491706, "client_id": 32701, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/4a496b3f/uploads/origins/2396d9ac-5a24-4bd5-a55e-64bfaad054d3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=eeba633e04ffe94253dff7edad7ad1be", "srcset": "https://si.imgix.net/4a496b3f/uploads/origins/2396d9ac-5a24-4bd5-a55e-64bfaad054d3?bg=%23fff&auto=format%2Ccompress