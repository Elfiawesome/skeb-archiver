30b5a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=150607214485923888351fd714a8ee67, https://si.imgix.net/d43f8e9b/uploads/origins/07e9b8f4-441d-4b93-ac96-d612f8f30b5a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=3a44e4be26cd53216490282d04cbaec2 2x, https://si.imgix.net/d43f8e9b/uploads/origins/07e9b8f4-441d-4b93-ac96-d612f8f30b5a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=d9171665023b4b0b7e767ecc4f0aef97 3x"}, "body": "まがお.zip様\nはじめまして。先生のイラストを拝見し、ぜひOCイラストをお願いしたくリクエストしました。\n\n表情や構図、背景デザインはお任せします。もし可能でしたら背景と人物のレイヤー分けをご検討いただけますと嬉しいです。（難しい場合は問題ありません）\n\n以下はOCについてです。\n\n■資料\nOCの他イラストレーター様への過去依頼分および、肋骨服や指定ブローチの資料\nhttps://drive.google.com/drive/u/2/folders/1tWNvdULb6DMThc-oozWYjvOOj-vtDNIg\n\n過去依頼分のイラストは雰囲気の参考として添付しております。\n髪型や細かな容姿は過去イラストに寄せていただく必要はありません。先生の描きやすい解釈で描いていただけますと嬉しいです。衣装の細かな装飾も省略していただいて構いません。\n\n■キャラクター\n・品のあるお嬢様的な雰囲気の少女\n・黒髪ロングのウェーブヘア\n・瞳はブルーグレー\n\n■衣装\n・紺色の布地に銀糸装飾の肋骨服＋ロングスカート\n・黒色のブーツ\n・胸元に指定のブローチ（基本要素を残していただければ、簡略化やアレンジはお任せします）\n\n■装飾\n・金色の城壁冠（手に持っているか頭に被っているかはお任せします）\n・両耳に赤サンゴの小粒ピアス（枝状ではなく丸型）\n・左右どちらかの人差し指に金地エメラルドの指輪\n※城壁冠以外は、構図上見えない場合は省略していただいて構いません。\n\nご検討いただけましたら幸いです。どうぞよろしくお願いいたします。", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@magao_desu/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3903041, "client_id": 3557843, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/64a831fb/uploads/origins/13ca0f91-1732-49a4-8bb3-83d87aef2b0c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9a1c7c974e9d36e61b3f6b66fcd14f3e", "srcset": "https://si.imgix.net/64a831fb/uploads/origins/13ca0f91-1732-49a4-8bb3-83d87aef2b0c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9a1c7c974e9d36e61b3f6b66fcd14f3e, https://si.imgix.net/64a831fb/uploads/origins/13ca0f91-173