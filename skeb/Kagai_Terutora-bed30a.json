のもの\n\nお出かけ前の「行きたくない」や憂鬱さを払拭して背中をほんのちょっとだけ押してくれる前向きなもの\n\n低音部が坂本九さんの「明日があるさ」のような下支えのある音があると個人的には好きかもです\n\n朝のラジオみたいに、途中に交通情報が流れても違和感のない感じ\n\n以上\n音楽系の内容は慣れていないので失礼な内容でしたり、伝わりづらかったら済みません…\nよろしくおねがい致します\n\nよい方向に物事が向かいますよう、お支えできればと思います\nお身体にお気をつけてお過ごしください", "nc": 145, "word_count": 0, "transcoder": "audio", "creator_acceptable_same_genre": true}, {"path": "/@Kagai_Terutora/works/9", "private_thumbnail_image_urls": {"src": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1843458125967572992%2FQXRPSd4V.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=4475f7d1492d031f69a7bda632ac62ae", "srcset": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1843458125967572992%2FQXRPSd4V.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=4475f7d1492d031f69a7bda632ac62ae, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1843458125967572992%2FQXRPSd4V.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=6c3a93fc1b4c271373c875b0cd8063c5 2x, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1843458125967572992%2FQXRPSd4V.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=539764de2b3495792164ec0cd7dd500a 3x"}, "private": true, "genre": "voice", "tipped": true, "creator_id": 3399735, "client_id": 1993060, "nc": 0}, {"path": "/@Kagai_Terutora/works/8", "private_thumbnail_image_urls": null, "private": false, "genre": "voice", "tipped": false, "creator_id": 3399735, "client_id": 3061980, "vtt_url": "https:/