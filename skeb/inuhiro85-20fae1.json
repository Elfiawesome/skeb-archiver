p&crop=top&w=200&h=200&s=8775efb82e2ea05eaa6ef9dd9c68ccbd 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/57233ce4/uploads/origins/2c668d88-d131-4366-84ea-7bdd423322ec?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a6ab37494fed11a52915d13b9d8ae661", "srcset": "https://si.imgix.net/57233ce4/uploads/origins/2c668d88-d131-4366-84ea-7bdd423322ec?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a6ab37494fed11a52915d13b9d8ae661, https://si.imgix.net/57233ce4/uploads/origins/2c668d88-d131-4366-84ea-7bdd423322ec?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=899baa323266bf6b982bdf20cb1ef5a5 2x, https://si.imgix.net/57233ce4/uploads/origins/2c668d88-d131-4366-84ea-7bdd423322ec?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=cc82fcf1943d32cbb6b888d72d4fd1b1 3x"}, "body": "初めまして。\n可愛らしいドラゴンさん達を見かけて今回送らせて頂きました。\n\nよろしければこちらの白い狐の仔リヒトか、リヒトが白い竜になった姿をいぬひろさんが思いついた姿で描いて頂ければと思います。\n設定としましてはまだ小さい時に両親が帰って来なくなり、形見の大きなサファイアと一緒に旅をしている。そんなまだ甘えたい年頃の仔になります。\n\n以下資料です。\n\nhttps://www.dropbox.com/scl/fi/i91r63nuz7d0nedw0l8lh/licht-n-dra.zip?rlkey=o25vp4v9y8ou2j4fo7lez6fwv&st=foniwyi8&dl=0", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@inuhiro85/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 773664, "client_id": 584710, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/a5462143/uploads/origins/81e017b9-a3e9-4ae5-b5ab-89ab5a0b9368?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=42006907334c3947c298f157710fb4c3", "srcset": "https://si.imgix.net/a5462143/uploads/origins/81e017b9-a3e9-4ae5-b5ab-89ab5a0b9368?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=42006907334c3947c298f157710fb4c3, https://si.imgix.net/a5462143/uploads/origins/81e017b9-a3e9-4ae5-b5ab-89ab5a0b9368?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=67acb199dbaa34e520a42c27fcd1725d 2x, https://si.imgix.net/a5462143/uploads/origins/81e017b9-a3e9-4ae5-b5ab-89ab5a0b9368?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=07bfc433c5c5befd4b48f891b2c8a216 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/a5462143/uploads/origins/81e017b9-a3e9-4ae5-b5ab-89ab5a0b9368?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d1dd03d1412c32ea0e8b6d4c82951b83", "srcset": "https://si.imgix.net/a5462143/uploads/origins/81e017b9-a3e9-4ae5-b5ab-89ab5a0b9368?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d1dd03d1412c32ea0e8b6d4c82951b83, https://si.imgix.net/a5462143/uploads/origins/81e017b9-a3e9-4ae5-b5ab-89ab5a0b9368?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=b700019bdfc7c0ac6cc1e69501bb5819 2x, https://si.imgix.net/a5462143/uploads/origins/81e017b9-a3e9-4ae5-b5ab-89ab5a0b9368?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=d02ee4bd6545351b5920bbbf7fa5d5d6 3x"}, "body": "はじめまして！　いぬひろ様の手掛けられるもっちりとした可愛らしいドラゴン達や、シュッとしたとっても素敵なキャラクター様を拝見して一目惚れし、ぜひともうちの子を手掛けて頂きたくてリクエストをお送りさせて頂きました。\n良ければ、うちの子のドラゴンをぜひ貴方の手で手掛けて頂けませんか？\n更に、差分もお願い出来ますと大変嬉しく思います！\n\nお願いしたい子は、エリクシルという名前の白い竜のお姉さんになります。\n頭から後ろ脚まで30mくらいある大柄めな子で、口を開かないうちはどことなく神秘的な印象も帯びる子ですが、口を開けば意外と気さくで、面倒見の良い一面もある子です。\n\nこちらの素敵なお子様の作品https://skeb.jp/@inuhiro85/works/3を拝見して、立派な身体つきと素敵な顔立ちの魅力にすっかり魅了されました。\nぜひとも、うちの子の立派な体躯を、全身像に近い範囲で手掛けて頂けませんか？\n構図やポーズなどは全てお任せできますと嬉しいです。\n\nまた、お願いしたい差分の内容なのですが、美味しいものをたらふくお腹に詰め込み過ぎて、彼女のお腹がどっしり丸々と膨れ上がってしまっている姿をお願い出来ませんか？\nお腹が大きければ大きいほど嬉しいですが、いぬひろ様の筆の乗るように膨らましてあげて下さいますと非常に嬉しく思います。\n\nぜひご検討をお願い申し上げます。\n\nベース\nhttps://x.com/Haku17/status/1685236847876755456\n\nデザインラフ\nhtt