core": false, "consored_thumbnail_image_urls": {"src": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1741689903443054592%2FojVOpG03.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=aca0b58b7aaceea8981d07b975c25311", "srcset": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1741689903443054592%2FojVOpG03.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=aca0b58b7aaceea8981d07b975c25311, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1741689903443054592%2FojVOpG03.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=ec7b58645db5199ec9b91d99acb6bae0 2x, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1741689903443054592%2FojVOpG03.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=aaad9a218ef49efa40d4f8004f4e226e 3x"}, "body": "こんにちは！Wickで投稿されていた音楽を聴き、ぜひOCCPのイメージソングを作っていただきたいと思いリクエストします。\n\nOCキャラデザイン\nhttps://xfolio.jp/portfolio/amamayaunduy/free/1118493\nピンク色の瞳の少女：インテリタス(破壊の概念)、イメージカラーピンク色。無口だが人間に近づき感情が豊かになっていく。\n青色の瞳の青年：マナブ(水の宇宙人)、イメージカラーアクアマリン色。人間になりたい。人間に近づく少女に嫉妬しつつもその成長に未来を感じている。\nCPのイメージカラー淡い虹色。\n\n関係性\n二人は幻想怪異発生特別区という東京に似た街で出会いました。\n少女の方は街の住人たちの生きている姿、マナブの優しさにきらめきを感じて生活しています。人間の営みに興味津々で、そこに価値を見出しています。\n青年の方は日々人間に近づいていく少女の成長に舌を巻きつつ、少女の未来に期待を感じています。また、庇護欲もあり、少女の保護者のような立ち位置で日々一緒に遊ぶ生活をしています。\n二人の関係性としては、人間の姿になってから10年の年の差があり、青年の方が少女の方に人間に擬態をする仕方について教えたりしている関係で、距離感は近いですが、付き合ってはいません。無口無表情な少女ですが、青年は一緒に過ごしてきた中で、彼女の考えていることをすぐに察することができます。\n全体的にほのぼのとした関係で、二人が登場する物語は常にハッピーエンドです。\n\nこちらの情報を読んで、感じていただいたように作曲をお願いできればと思います。\n説明が長くなってしまい申し訳ありません。ご縁がありましたら幸いです。\n\nhttps://xfolio.jp/portfolio/amamayaunduy/free/1118493", "nc": 129, "word_count": 0, "transcoder": "audio", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 305084, "creator": true, "nsfw_acceptable": false, "accept