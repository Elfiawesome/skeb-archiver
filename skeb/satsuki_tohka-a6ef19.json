非、とおかさんに白雲を描いて頂けないかお願いに上がりました\n下記のような内容で依頼させて頂きたいのですが、ご一考して頂けないでしょうか\n\n【衣装・構図】\nhttps://drive.google.com/file/d/121B0pXirnwFYdJcjWwwlyJE8XZxVGewR/view?usp=sharing\n↑\nこちらのようなポーズと衣装でお願いします（プロポーションも資料に準拠した形にしてくださると嬉しいです）\n衣装はガーターベルト無しにして欲しいです\n衣装のカラーを青系に、デザインやポーズもアレンジして頂いて構いません\n\n【セリフ】\n白雲\n「不肖、この白雲が候補生殿のお相手を務めさせていただきます」\n\n※白雲さんは歴戦の雰囲気で余裕ある感じに描いて頂けると嬉しいです\n\nどうぞよろしくお願いいたします", "nc": 176, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@satsuki_tohka/works/8", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 616017, "client_id": 1475437, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/35f4a64f/uploads/origins/57502bb1-0525-49f4-aa6b-1f72b552b654?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=905be7d66cd7dee6992f59a3b0e85b24", "srcset": "https://si.imgix.net/35f4a64f/uploads/origins/57502bb1-0525-49f4-aa6b-1f72b552b654?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=905be7d66cd7dee6992f59a3b0e85b24, https://si.imgix.net/35f4a64f/uploads/origins/57502bb1-0525-49f4-aa6b-1f72b552b654?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=378d60c9ac5201252ce013bed0f59555 2x, https://si.imgix.net/35f4a64f/uploads/origins/57502bb1-0525-49f4-aa6b-1f72b552b654?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f521d154c9de54e292cbfbda6f00d5bf 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/35f4a64f/uploads/origins/57502bb1-0525-49f4-aa6b-1f72b552b654?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=56788e94c1408343e5d1f9f9d36b00c7", "srcset": "https://si.imgix.net/35f4a64f/uploads/origins/57502bb1-0525-49f4-aa6b-1f72b552b654?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=56788e94c1408343e5d1f9f9d36b00c7, https://si.img