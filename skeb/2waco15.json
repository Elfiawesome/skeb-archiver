n▼アバターについて\n少年型オートマトンのσ0型。細身の少年体型で、外見年齢は15歳ほど。\n身長はおよそ160cmです。\n髪色はインナーカラーとなっており、インナー部分は杜若色(目の色と同じ)です。\nイメージカラーは杜若色(#4d4398)。\n全体的なイメージは「生意気で勝ち気、活発な少年」です。\nデザインの詳細につきましては資料URLをご参考ください。\n\n▼利用用途\nTwitter・Discord等への掲載やアイコンとしての利用\n配信活動(サムネイルや配信画面、配信告知画像等)への利用\nおはV等の配信活動に関するコンテンツへの利用\nを想定しております。\n\nお忙しい中恐れ入りますが、ご検討いただけますと幸いです。\n\nhttps://drive.google.com/drive/folders/13mIGQgZ-RItlOWbKOofabwf77qZBLWGG?usp=drive_link", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 2849285, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "めまふ", "screen_name": "memafu00", "avatar_url": "https://pbs.twimg.com/profile_images/2026276078705393664/eML9wKKu.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1609195636813070338/1693967309/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "art"}, {"genre": "correction"}], "nc": 145}, {"id": 3659492, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "マコト", "screen_name": "gos_spoon0603", "avatar_url": "https://pbs.twimg.com/profile_images/1957570813965774848/sTqfJiNu.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1932455594205872128/1750684288/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 7, "complete_expiration_days": 14, "skills": [{"genre": "art"}], "nc": 128}, {"id": 3767820, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "yataro@skeb募集中", "screen_name": "s_moimoi_k", "avatar_url": "https://pbs.twimg.com/profile_images/1995447579954515968/2KcyMU90.jpg", "header_url": "https://pbs.twimg.com/profile_banners/9802