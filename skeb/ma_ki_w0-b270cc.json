vxtpXRfXYsfT0-oBsr", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@ma_ki_w0/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 5735, "client_id": 2730570, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/e9741981/uploads/origins/d6a25727-4a45-40c8-963f-2f274f81f591?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bff8ede5cbd20733f545ca3b337b1338", "srcset": "https://si.imgix.net/e9741981/uploads/origins/d6a25727-4a45-40c8-963f-2f274f81f591?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bff8ede5cbd20733f545ca3b337b1338, https://si.imgix.net/e9741981/uploads/origins/d6a25727-4a45-40c8-963f-2f274f81f591?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=8791948fbf21f914ccaa3411793c7390 2x, https://si.imgix.net/e9741981/uploads/origins/d6a25727-4a45-40c8-963f-2f274f81f591?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ae1718827349f4ed666951f1cd41f228 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/e9741981/uploads/origins/d6a25727-4a45-40c8-963f-2f274f81f591?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=dd3d962fe9a3f459859140950e3c4ae7", "srcset": "https://si.imgix.net/e9741981/uploads/origins/d6a25727-4a45-40c8-963f-2f274f81f591?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=dd3d962fe9a3f459859140950e3c4ae7, https://si.imgix.net/e9741981/uploads/origins/d6a25727-4a45-40c8-963f-2f274f81f591?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=3a8f9b2fa15fa4fea1e413f66aa1cd4b 2x, https://si.imgix.net/e9741981/uploads/origins/d6a25727-4a45-40c8-963f-2f274f81f591?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=c539202403374d19d69a46732f493735 3x"}, "body": "初めまして。Vtuberのここのと申します。\nTwitterで花巻なるさまのイラストを拝見いたしまして、ぜひ描いていただきたいと思いリクエスト送らせていただきました！\n\n【希望するイラスト】\n構図：頭を切れずに描いていただけるとありがたいです。\n　　　マイクを持っていて歌っているような感じだとありがたいです。\n服装：参考資料の中の衣装案のどれか気に入ったもので描いていただけると幸いです。\n表情：お任せします。ご負担でなければ表情の差分があると嬉しいです。\n\n【お願いしたいキャラクター】\n〇ここの\n・要素：太陽・ワオキツネザル（耳と長いしっぽ）\n・前髪に太陽の形のハイライト。\n・水色のツインテール、インナーカラーは黄色。花の髪飾り。\n（眉上の前髪と太陽のハイライト以外の髪型改変OK）\n・八重歯あり。\n・身長：150㎝くらい\n・基本の服装→白スク水＋セーラー襟の服\n\n〇使用用途\nYoutubeなどのサムネイル\nSNSの活動におけるプロモーション\n\n〇レイヤーを人物・背景でわかれたもの　透過差分\n　psdデータでご準備いただけますと幸いです。\n\nご検討宜しくお願い致します。\n\nhttps://drive.google.com/drive/folders/1rYUsn7IjQOqOd90imxXxR8RgAgac93qv?usp=drive_link", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@ma_ki_w0/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 5735, "client_id": 2274451, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/f798bd6c/uploads/origins/ff936d65-2c14-4d84-9a7d-c2a3a5890288?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6b261f69649fab6ca38ad95cbef1ce72", "srcset": "https://si.imgix.net/f798bd6c/uploads/origins/ff936d65-2c14-4d84-9a7d-c2a3a5890288?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6b261f69649fab6ca38ad95cbef1ce72, https://si.imgix.net/f798bd6c/uploads/origins/ff936d65-2c14-4d84-9a7d-c2a3a5890288?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=729f767c22daf41e348fc86ffaff4968 2x, https://si.imgix.net/f798bd6c/uploads/origins/ff936d65-2c14-4d84-9a7d-c2a3a5890288?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=96b0dbb2aba02d8be294761a4a942565 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/f798bd6c/uploads/origins/ff936d65-2c14-4d84-9a7d-c2a3a5890288?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&b