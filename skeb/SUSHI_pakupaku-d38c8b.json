nbox等のWeb媒体での掲載です。PSD形式で、人物のみ透過レイヤーが別であると大変助かります。\n\nご検討の程、よろしくお願いいたします。", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}], "sent_works": [], "similar_creators": [{"id": 470022, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "えもと", "screen_name": "sen_juge", "avatar_url": "https://proxy.misskeyusercontent.jp/avatar.webp?url=https%3A%2F%2Fmedia.misskeyusercontent.jp%2Fio%2F233362db-206c-4159-bb6a-833388e8aefc.png&avatar=1", "header_url": "https://media.misskeyusercontent.jp/io/262c6060-a92b-44a7-896b-f9d98fb6f2cd.png", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 10, "complete_expiration_days": 80, "skills": [{"genre": "art"}], "banned": false, "nc": 48}, {"id": 527624, "creator": true, "nsfw_acceptable": true, "acceptable": false, "name": "けもみん之助", "screen_name": "simanokoB", "avatar_url": "https://pbs.twimg.com/profile_images/1280684987071688704/pQbeV3as.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1037190349373038593/1749528851/1500x500", "appeal_receivable": false, "popular_creator_rank": 4, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "art"}, {"genre": "comic"}], "banned": false, "nc": 177}, {"id": 1294199, "creator": true, "nsfw_acceptable": false, "acceptable": false, "name": "まるろ", "screen_name": "mar_R_o", "avatar_url": "https://pbs.twimg.com/profile_images/1476114111381794823/PAX2KYFH.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1233686760296607744/1644659715/1500x500", "appeal_receivable": false, "popular_creator_rank": 69, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiratio