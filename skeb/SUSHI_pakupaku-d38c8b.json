t/fe9925cc/uploads/origins/578e83da-57c0-4b9f-be1e-2e19d78aa961?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=3c147ce4cf8684473636e0b2cd97af6a 3x"}, "body": "すめしちゃん様\n初めまして！VTuber準備中の十朱梓乃と申します。すめしちゃん様のイラストが大好きでskebの開始を心待ちにしておりました！！\n\n✧依頼内容\n私十朱梓乃を描いていただきたいです…！資料をURLにて共有させていただきます。衣装や髪型お好きなように改変していただいて構いません！もし改変希望等無い場合は、1つ目のURLの姿でお願いしたいです。\n\n✧使用用途\n･YouTubeやTwitter(サムネイルや動画内使用、各種アイコンやおはようツイートなど)\n\n今回練習との事でしたので、上記での使用が不可の場合個人で楽しむ範囲とさせていただきます…！\n\n✧構図やポーズ\nすべてお任せしたいです……！\n\n✧その他\n･可能でしたら人物やサインなどを分けた透過データをいただけますと幸いです。\n･用途に使用不可なものがございましたら、ファイル内に記載していただければ準拠させていただきます。\n\nskebの開始心待ちにしていた一オタクのため拙い文章かと存じますがご縁がありましたらよろしくお願いいたします…！\n\nhttps://drive.google.com/file/d/1ISga6oNzzgElaDTsBBp7KVW7lYSxldNf/view?usp=drivesdk\n\n\nhttps://drive.google.com/file/d/1Ap8gObbN89iYTnFivpgMERS1CbnGxRqX/view?usp=drivesdk\n\nhttps://drive.google.com/file/d/1ISga6oNzzgElaDTsBBp7KVW7lYSxldNf/view?usp=drivesdk", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@SUSHI_pakupaku/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2999404, "client_id": 615979, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/20ba74e7/uploads/origins/daa7e6c4-c093-45b6-9672-adb74974c96c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a33d44d60f454647ea42f99025a7ad7c", "srcset": "https://si.imgix.net/20ba74e7/uploads/origins/daa7e6c4-c093-45b6-9672-adb74974c96c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a33d44d60f454647ea42f99025a7ad7c, https://si.imgix.net/20ba74e7/uploads/origins/daa7e6c4-c093-45b6-9672-adb74974c96c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=08f6cace5ca4300dc5e19077797dca98 2x, https://si.imgix.net/20ba74e7/uploads/origins/daa7e6c4-c093-45b6-9672-adb74974c96c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=efec8264d8dec6f3b9711403e00e33a8 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/20ba74e7/uploads/origins/daa7e6c4-c093-45b6-9672-adb74974c96c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b3cb440864cb28121a361cd6a553bac8", "srcset": "https://si.imgix.net/20ba74e7/uploads/origins/daa7e6c4-c093-45b6-9672-adb74974c96c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b3cb440864cb28121a361cd6a553bac8, https://si.imgix.net/20ba74e7/uploads/origins/daa7e6c4-c093-45b6-9672-adb74974c96c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=bbdcd63d672d776dc6b10621990c1f42 2x, https://si.imgix.net/20ba74e7/uploads/origins/daa7e6c4-c093-45b6-9672-adb74974c96c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=7f912a4dfc74f4dcc13b3079111ce2b9 3x"}, "body": "はじめまして！いつも別垢からイラスト拝見しております。すめしちゃん様の可愛くて素敵なイラストが大好きでリクエストさせて頂きました。\n\nリクエストの詳細ですが、TRPGのプレイヤーキャラクターとして作成した自創作キャラのイラストをお願いしたいです。\n資料はこちらです。 https://x.com/tmd_neko/status/1725441370742313435?s=46&t=p7JJfg26SSydu-oUcTXomQ \n\n絵柄は等身でお願いします。また、構図はおまかせしたいのですが、とても自信家で元気のあるキャラクター（版権で例えると、デレマスの輿水幸子ちゃんみたいな感じです）なのでそれに合うようなポーズだと嬉しいです。\nまた、すめしちゃん様の描かれる絵で、全体的にピンクっぽくて、少し彩度が低いものがとても大好きなので、元の資料よりも全体的にそのような感じに描いて頂きたいです。\nよろしくお願いします。\n\nhttps://x.com/tmd_neko/status/1725441370742313435?s=46&t=p7JJfg26SSydu-oUcTXomQ", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@SUSHI_pakupaku/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2999404, "client_id": 1976503, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/b2ad9101/uploads/origins/17cbcd2f-56e7-4ec1-818c-060da5a78feb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=849b138db0bdf20e2d6641a363838938", "srcset": "https://si.