ebb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=409ad0b0c055553b3064995e582373d5 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/50520837/uploads/origins/048ad58a-b0fa-443f-bf17-92863717eebb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2c3ce8cfd780fa5ac4103060cfd6d882", "srcset": "https://si.imgix.net/50520837/uploads/origins/048ad58a-b0fa-443f-bf17-92863717eebb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2c3ce8cfd780fa5ac4103060cfd6d882, https://si.imgix.net/50520837/uploads/origins/048ad58a-b0fa-443f-bf17-92863717eebb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=166724204c0000b0c824c2c9935f0359 2x, https://si.imgix.net/50520837/uploads/origins/048ad58a-b0fa-443f-bf17-92863717eebb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=c2621e7383d13cb679c9773ee752d72a 3x"}, "body": "yannoka様\n\nmisskeyでの素敵なイラストに釣られてしまったので\n下記のイラストをリクエストしてもよろしいでしょうか？\n\n＜リクエスト内容＞\nmisskeyに投稿されていたチアきりたんの横に並ぶイメージで\nチアずんだもんをお願いしたいです！\n\nもし細かい指定が可能でしたら、\n髪型やアクセなどは自由にアレンジしてほしいのと、\nチアきりたんとは違い少し恥ずかしそうにしている雰囲気でお願いしたいです！\n\nその他不足している内容などがありましたら、yannoka様が自由に解釈して構いませんので\n御検討よろしくお願いいたします！", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@shibainukaitai/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3811325, "client_id": 475405, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/8eb5dd01/uploads/origins/2eab4a22-e497-40b9-9baa-7b9d16a7c6a5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=484b61cb888968fb6fcd5b0cbe9f0116", "srcset": "https://si.imgix.net/8eb5dd01/uploads/origins/2eab4a22-e497-40b9-9baa-7b9d16a7c6a5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=484b61cb888968fb6fcd5b0cbe9f0116, https://si.imgix.net/8eb5dd01/uploads/origins/2eab4a22-e497-40b9-9baa-7b9d16a7c6a5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=cb2be949b7cc9b2fa30bc1584a8da336 2x, https://si.imgix.net/8eb5dd01/uploads/origins/2eab4a22-e497-40b9-9baa-7b9d16a7c6a5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f619a9f3fb9160464f6416573dc5593f 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/8eb5dd01/uploads/origins/2eab4a22-e497-40b9-9baa-7b9d16a7c6a5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b4198916fb8840edc20f5c1fa32ceb8c", "srcset": "https://si.imgix.net/8eb5dd01/uploads/origins/2eab4a22-e497-40b9-9baa-7b9d16a7c6a5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b4198916fb8840edc20f5c1fa32ceb8c, https://si.imgix.net/8eb5dd01/uploads/origins/2eab4a22-e497-40b9-9baa-7b9d16a7c6a5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=937dea6fa216cb1ad841968160b0d673 2x, https://si.imgix.net/8eb5dd01/uploads/origins/2eab4a22-e497-40b9-9baa-7b9d16a7c6a5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=34cac9e84c3b2e12118e0f5928455970 3x"}, "body": "初めまして。\nうちの子「鳥飼コーニュ」を描いて頂きたく思い依頼させていただきます。\n設定画：https://media.misskeyusercontent.jp/io/531f7ae8-e80f-4970-8763-c8a2dcdc38f4\n\nこちらのジト目でパーカーを着たずんだもん（https://misskey.io/notes/af7tetuh1xkm06jr）が可愛かったです。\nなので、うちの子の着ているパーカーのチャックを上げ、路地裏で壁にもたれてジト目でお客を待っている（物色している）ところを描いて頂けないでしょうか。\n詳細はお任せします。\n（立ちんぼ時代の設定なので指輪は無しでお願いします。）\n\n連絡事項\n・「鳥飼コーニュ」製作者、八陰あおたこ氏からコミッション使用許可を頂いております。\n・可能であれば納品は背景を透過したPNGまたはPSDファイルを付けてください。\n\n納品物の利用\n・グッズ作成（非商用)\n・コミッション資料としての使用。\n・SNSでの掲示、アイコンとしての使用。\n\nもし受けて頂けるのでしたらよろしくお願いいたします。", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators"