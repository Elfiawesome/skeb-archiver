トを送らせて頂きました。\n\n今回はオリジナルキャラクターを2人1枚の絵に描いていただけないでしょうか。\n\n外見や服装はファイルを参照して下さい\n\n\nキャラクター設定\n\n無害\n男/161cm/年齢:不明/種族:神\n無邪気だが何処か狂気的な性格\n\n有害\n男/165cm/年齢:不明/種族:神\n口が悪く性格もまあまあ悪い\n\n2人の関係性について\n\n2人は兄弟で、兄が無害 弟が有害\n無害が一方的に弟に依存している。\n無害は愛というものが分からず、弟に暴力を振るう事を愛だと思っている。\n\nNGは特にありません。構図や表情は全てはーぶさんにお任せします。はーぶさんの解釈で自由に描いてくださると嬉しいです！\n\n【使用用途】\n個人での鑑賞、snsでのアイコン、ヘッダーに使わせていただく予定です！\n\n【参考資料】\nhttps://drive.google.com/drive/folders/1dEKfCusoUqo8RqBYKaFKTdkQcX_5pHby\n\nhttps://drive.google.com/drive/folders/1dEKfCusoUqo8RqBYKaFKTdkQcX_5pHby", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@herb__X0/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 4057694, "client_id": 2997904, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/9988d068/uploads/origins/e1f50e42-183a-4c9f-b91b-fd33c581d66f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b027d89cca309f350269e35b1e8b2006", "srcset": "https://si.imgix.net/9988d068/uploads/origins/e1f50e42-183a-4c9f-b91b-fd33c581d66f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b027d89cca309f350269e35b1e8b2006, https://si.imgix.net/9988d068/uploads/origins/e1f50e42-183a-4c9f-b91b-fd33c581d66f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b1cd2c0c1d82a852d1b50230389ccf22 2x, https://si.imgix.net/9988d068/uploads/origins/e1f50e42-183a-4c9f-b91b-fd33c581d66f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=9e935b1068e75bcec23613530734b2c6 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/9988d068/uploads/origins/e1f50e42-183a-4c9f-b91b-fd33c581d66f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=12ad0c7b002dd6cbd2f8d46bb6a0baf2", "srcset": "https://si.imgix.net/9988d068/uploads/origins/e1f50e42-183a-4c9f-