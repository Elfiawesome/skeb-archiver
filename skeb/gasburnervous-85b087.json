58a5f/uploads/origins/f552cf55-1f2a-4489-b3bd-b180864cdbeb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=57e80421eda3255a39944872fad95190, https://si.imgix.net/cec58a5f/uploads/origins/f552cf55-1f2a-4489-b3bd-b180864cdbeb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=ada5a6ab33b0661c30fea329760654b5 2x, https://si.imgix.net/cec58a5f/uploads/origins/f552cf55-1f2a-4489-b3bd-b180864cdbeb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=c75f3d3e2b748719aa50dcc5dd069e18 3x"}, "body": "作品：プリンセスコネクト\nキャラ：クロエ\n\n・mnkを見せてと言われて、\n片手でスカートをたくしあげ、もう片方の手でパンツをずらして性器を見せている（股布ずらし）\n・上半身は服がはだけて胸が露出している。ブラを書く場合はブラがずれて胸が見えている状態。もしくはノーブラ。\n・衣装は公式衣装。\n・下着の色、デザイン柄等はおまかせ。\n・毛は生えていない。\n・構図はmnkのすじが見えるように、正面もしくはアオリ構図のイメージ。\n・表情は見せるのが当然という感じで笑顔。差分が可能なら恥ずかしそうに照れている表情も。\n\n以上、よろしければご検討ください。", "nc": 48, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@gasburnervous/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 125825, "client_id": 57248, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/e3fe94a1/uploads/origins/0aa6da65-a3ab-4707-bd88-9d870a926fed?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=854af10f96735e69ad79992e7e3e9c80", "srcset": "https://si.imgix.net/e3fe94a1/uploads/origins/0aa6da65-a3ab-4707-bd88-9d870a926fed?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=854af10f96735e69ad79992e7e3e9c80, https://si.imgix.net/e3fe94a1/uploads/origins/0aa6da65-a3ab-4707-bd88-9d870a926fed?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=d24cbb94666b5ebfb252b4daef44150c 2x, https://si.imgix.net/e3fe94a1/uploads/origins/0aa6da65-a3ab-4707-bd88-9d870a926fed?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=34be340695dd67941e9122d9b7f0d223 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/e3fe94a1/uploads/origins/0aa6da65-a3ab-4707-bd88-9d870a926fed?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=1da441cce0b4373f2cd06b9b71511d49", "srcset": "https://si.imgix.net/e3fe94a1/uploads/origins/0aa6da65-a3ab-4707-bd88-9d870a926fed?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=1da441cce0b4373f2cd06b9b71511d49, https://si.imgix.net/e3fe94a1/uploads/origins/0aa6da65-a3ab-4707-bd88-9d870a926fed?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=6494ef67ec9a2ed558c80527b37c0e50 2x, https://si.imgix.net/e3fe94a1/uploads/origins/0aa6da65-a3ab-4707-bd88-9d870a926fed?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=706125bc41e9e2d24ab6249e71e2cb0e 3x"}, "body": "お世話になります。数年前にがすばあなさんのTwitterでノゾミイラストを見て、コミッション開始したら絶対リクエストしたいと思っていました。ちなみに解除されてなければプリコネゲーム内でフレンドだったりします(おにゃんここわれる)\n以下本文\n\nプリコネのノゾミをお願いします\nやや前のめりな姿勢で騎乗位を騎士君にしている構図でお願いします\n恋人握りをさせるか、騎士君の胸板を手で押さえつけるようなものにするかのどちらかのポーズにしてください\nノゾミはシャドウ化しているようにお願いします。シャドウなので逆レイプです\n体の色が暗いシャドウ化ではなく、アニメの融合シオリのように、体の色は普通で、髪の色をやや変化させ、瞳をバイオレットに少し発光させるようなイメージでお願いします。瞳の描写で、がすばあなさんの描くシオリの獣人ぽっさの強く出ている描き方がとても好きなので、シャドウノゾミも同じように獣人っぽく瞳を描いてください。シャドウなので多少人間じゃない感があってもなんら問題ありません\n衣装は資料の現実制服を着ているようにしてください\nスカートも脱がさず着せてください\n臍が出ているので、そこに淫紋を刻んでください\n手の爪をかなり長くして、悪堕ち感を出してください\n胸を可能な限り爆盛りに大きくしてください。顔より大きいくらいが理想ですが、がすばあなさんの絵柄と合わせて最終的な匙加減はお任せします。胸がでかいので制服が凄い乳カーテンになっていると嬉しいです\n表情は、とっても意地悪なニマニマした舌なめずりをさせてください。自分より圧倒的に弱い騎士君を「可愛がって」弄んでいるような感じです。シャドウ化しているので元の人格は気にしなくて構いません。騎士君が大好きという本能だけで動いています\n\n可能ならば射精前、中、後の３パターン差分を頂ければ嬉しいです\nかなり尖ったリクエストですので、ご都合が問題なければどうか宜しくお願い致します\n\nhttps://twitter.com/colPprbIU1TOnv2/status/1606818452962160640?t=kMnkTrDT_VgYnRH0R45e5A&s=19", "nc": 56, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 7436, "creato