b2d1-1e5de463281e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fea2a2483eee4a6defb60842f7b51f19", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": true, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/cd579145/uploads/origins/5e04330a-d7f2-4917-b2d1-1e5de463281e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=033e6426add14d26ed1c0cb879d021dd", "src_set": ""}, "body": "バンドリの氷川日菜と白鷺千聖でHAMASH○風クイズをお願いします。\n全裸（陰毛無し）で立っている状態で、そこから上から泥をかけられ口の中まで全身泥んこになる。\nその後、白い粉がかかり顔と上半身に粉が付着している\n最後に顔と股間にパイ投げされ、目・鼻・口の部分に影ができている\nといった流れでお願いします。\n最後の口だけ開いてる（URLの4枚目みたいに）差分もできればお願いします。\n\nhttps://x.com/nashiro_messy/status/1921612256011231672", "nc": 186, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@White_messy/works/19", "private_thumbnail_image_urls": null, "private": false, "genre": "novel", "tipped": true, "creator_id": 1764696, "client_id": 0, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/b71096e5/uploads/origins/eab00cc0-8ac1-414e-966e-a15bac2d6bd7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=21750127887fa351a670b4ba6a844e52", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": true, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/b71096e5/uploads/origins/eab00cc0-8ac1-414e-966e-a15bac2d6bd7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=773e4d6234ddafdae27b18aed530ac69", "src_set": ""}, "body": "お疲れ様です。\nテキストの募集もされているということで、短編を依頼したいです。\nメッシー鬼ごっこで、季節ものでは無いものとなります。\n前作のサキュバスが玩具化の力を持っていて、手下がピエロ(トランプ兵)ヴァンパイア(チェス兵)河童(将棋兵)の3体。\n逃走者がピエロに捕まると全裸パイ投げ+ガニ股電マ、ヴァンパイアは首にキスマークをつけられて赤インクを胸に塗られる+乳首責め、河童は泥水+尻穴バイブの罰ゲームを受けて牢屋送り。\n前半終了以降で鬼に捕まると、ピエロの場合①全身を真っ白に塗られ、ピエロメイクのうえで、♠♥♣♦のどれかを顔に入れられる②トランプの着ぐるみ(透明なので裸体は隠せない)を着せられて鬼側に回る\nヴァンパイアの場合①顔以外を黒か白、恥部は赤で塗られる、紫の口紅とアイラインでメイク②頭にチェス駒の冠(キングは王冠、ナイトは馬、ポーンは丸)と乳首に金色リング+駒を示す名札装着で鬼側に回る\n河童の場合①顔を真っ白に塗られて、頭に河童の皿をつけられる②将棋駒の着ぐるみ(駒は透明なので裸体が隠せない)を着せられて鬼側に回る\n鬼側になった逃走者は前穴にローター装着、着ぐるみは頭と手足が出ているタイプ(駒やトランプから頭と手足が生えているイメージ)\n逃走者敗北エンドでは、生存者もいずれかの手下にされる。\nトランプ兵は並べられて前後穴に双頭ディルドで繋がれる。\nチェス兵は黒白の同じ駒同士貝合わせ。\n将棋兵は尻穴バイブで尻タワー。\n全員をひと通り責めたあと、前後穴にバイブ装着、ガニ股鼻フックでバキュームベッドに拘束されて姿を晒される。(顔部分は穴を開けて、サキュバスとスタッフにパイ投げを受ける)\nなかなかハードな内容ですし、メッシー要素が少なめなオーダーになっているので、メッシー要素を盛ってもらう分にはオーケーですので、よろしくお願いしたいと思います。", "nc": 58, "word_count": 11451, "transcoder": "text", "creator_acceptable_same_genre": true}, {"path": "/@White_messy/works/18", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1764696, "client_id": 0, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/54c205da/uploads/origins/800ca212-de88-42fa-b937-17187a5f6479?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f926d3ea36354b43272bc58a85a9c4e3", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": true, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/54c205da/uploads/origins/800ca212-de88-42fa-b937-17187a5f6479?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=78ab66f5cf8161e6fc8157cffc344654", "src_set": ""}, "body": "ブルーアーカイブの黒崎コユキでピエロメイクからのパイ投げをお願いします\n\n・表情は恥ずかしがってる\n・素顔の状態からユウカもしくはノアからおしおきとして刷毛で顔や身体中を白粉で白塗りにされる\n・そこからドナルド風のピエロメイクされた後、ピエロの衣装を着せられパイ投げをされる\n・そこから更に全身にパイを投げられ全身生クリームまみれにされる\n・全裸差分は両乳首と股にハートのマークを書いている。\n\nといった感じでセリフ付き、全裸差分も併せてお願いします！", "nc": 187, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@White_messy/works/17", "private_thumbnail_image_urls": null, "private": false, "genre": "novel", "tipped": false, "creator_id": 1764696, "client_id": 816713, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/20a1cf34/uploads/origins/8fabb062-2452-43b4-b282-856eeb10d2f1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f9fe11c0e1636914bb9893154cb484de", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": true, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/20a1cf34/uploads/origins/8fabb062-2452-43b4-b282-856eeb10d2f1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0837ecad667783d4942cf8e86ee4641c", "src_set": ""}, "body": "ブルアカのユウカとノアがメッシー&石化体験をするSSをお願いします\n定期的にブルアカ関連のツイートをしていらっしゃったので、ご存知であろうと読んでの依頼になります\nもし未プレイでしたらごめんなさい\n\nお話の流れとしては、\nひょんなことから特殊性癖の世界を知ってしまったユウカとノア\nどうしても気になって困った2人はこっそりとシャーレの先生の元に訪れ…\nという感じです\n\n細かい体験の流れとしては、\n①全身をユウカはオレンジ色、ノアはピンクに塗られる。口内や目等も塗られ、文字通り1色に。\nその後お互いの色を上塗りしたり、先生が上から別の塗料をかける…等のプレイ。細かい部分は思いつかないのでお任せします。\nプレイ後、体を洗い流すものの、2人の色素の薄い肌からは完璧には落ちずに微妙に染まったまま。\n\n➁手足がX字状になる体勢で拘束(所謂X字拘束)\nその状態でユウカは金粉、ノアは銀粉で全身を塗られる\nこれだとさっきとあまり変わらないな、ということで開口器や鼻フックを装着された上でローターやバイブをつけられての快楽攻め\nプレイ後に再度洗い流すが、微妙に体の一部が光るまま。\n\n③媚薬と石化成分を含む泥での泥レス\n泥にまみれるにつれて、レスリングが激しく、また少しずつ性的なモノを含んでいき、最後は争い合う姿勢のまま石に。\n裸婦像と化した2人は芸術品としてシャーレに暫く展示されることに。\n\n石化ですが、意識は残ってるし快楽も感じるけど視覚や聴覚は無いタイプのものでお願いします\n\nプレイ中のユウカとノアはずっと全裸のままでお願いします\nまた、自分は口内塗りのシーンが大好きな口内塗り癖なので、少しそのシーンへのフォーカスが欲しいです。\n\n先生が全裸の生徒の特殊プレイに付き合うなんてクビ案件だよ！ってのは気にしない方針でお願いします\n\n…性癖詰め詰めで書いたら長くなってしまいました\nお気持ち程度ですがご予算を増額させていただきます", "nc": 42, "word_count": 13053, "transcoder": "text", "creator_acceptable_same_genre": true}, {"path": "/@White_messy/works/16", "private_thumbnail_image_urls": null, "private": false, "genre": "novel", "tipped": false, "creator_id": 1764696, "client_id": 1667125, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/0122df5f/uploads/origins/091147b7-aeeb-43a1-9758-1f7632094d74?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=77d6241a5202f73364022955498d6b18", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": true, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/0122df5f/uploads/origins/091147b7-aeeb-43a1-9758-1f7632094d74?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ce3cf79001271ea955e6f4c1b33fb20f", "src_set": ""}, "body": "いつもmessyパークの小説を読んでます！！\n\nリクエストをしたいのですがmessyパークの小説を書いて欲しいです！！\nシチュエーションとしてはmessyプレイ専用の室内でゆかりさんが作った疑似ザー○ンエキスを使って遊ぶ感じでして、\nいつもmessyパークで遊んでるアトラクションを疑似ザー○ンエキス入りのクリームやパイで遊んだりするやつです！\nラストは全員全裸の状態で頭上から疑似ザー○ンエキス原液100%入りの超巨大パイを被って部屋中パイまみれで全員全身疑似ザー○ンパイ塗れのやつをお願いしたいです！！\n登場人物にゆかりさんと瑠璃ちゃんと詩織ちゃんを入れてくれると嬉しいです！！\nよろしくお願いします！！", "nc": 186, "word_count": 7541, "transcoder": "text", "creator_acceptable_same_genre": true}, {"path": "/@White_messy/works/15", "private_thumbnail_image_urls": null, "private": false, "genre": "novel", "tipped": false, "creator_id": 1764696, "client_id": 54444, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/54daaabd/uploads/origins/79baf8f3-4cb3-43d5-aca9-92566347cfa5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=392a3f975a631f17d73f6f09b52c8829", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": true, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/54daaabd/uploads/origins/79baf8f3-4cb3-43d5-aca9-92566347cfa5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2450f8ba1fb9024dd092b3abc7747ea5", "src_set": ""}, "body": "メッシーイベントで小学生でも関係なく全身（目の中は除く）、口の中、まんこの中やお尻の穴の中まで金粉まみれにされ、さらに、ごんぶとのディルド型バイブをまんこに大きなアナルビーズをアナルに挿入される（小学生だとしても）エロ小説をお願いしたいです。\n参加者は鬼ごっこの時みたいに12歳〜18歳の女の子で陰毛の描写は無し、金粉まみれにする方法は体や顔は刷毛で塗られ、まんこの中、お尻の穴の中は広げられて金粉バズーカをくらわす形で、挿入はバイブ→ビーズの順でお願いします。\nそれから小学生がやられるシーンは中高生よりも長めにやってほしいです。", "nc": 42, "word_count": 7288, "transcoder": "text", "creator_acceptable_same_genre": true}, {"path": "/@White_messy/works/14", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1764696, "client_id": 54444, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/cf306f46/uploads/origins/336112eb-9141-4d5f-8d33-11156ddc1aa2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0f2c471ec18f069a36243015b031b4c8", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/cf306f46/up