といい、遠い国の言葉で風を意味します。\nゲル(仮称)は、元は兄にあたる存在で名前をBenanton(ベナントン)といいました。\"祝福された男\"という意味ながら、姉妹にはゲル(仮称)が兄弟であるという認識はありません。\nゲル(仮称)は普段は麻袋に入れて運ばれます。ある日「しまった、穴が開いていた」と転がり落ちた時も転送にて姉妹の手元に戻ります。\n姉はHasca(ハスカ)といいます。可愛い名前だね。\n\n\nなんという怪文書でしょうか。わたしからは以上です。\n今更ながら、一度のリクエストに複数の人物は禁忌に触れないか心配になってきました。", "nc": 32, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@harunoyoiyami/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 256380, "client_id": 102854, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/158c5091/uploads/origins/c2b1464a-7c12-4438-bbc4-6e739909cf79?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5289f3bde2d6b614692670444b579cee", "srcset": "https://si.imgix.net/158c5091/uploads/origins/c2b1464a-7c12-4438-bbc4-6e739909cf79?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5289f3bde2d6b614692670444b579cee, https://si.imgix.net/158c5091/uploads/origins/c2b1464a-7c12-4438-bbc4-6e739909cf79?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e8c58bb86a4bc2dabd50c2f9a427563d 2x, https://si.imgix.net/158c5091/uploads/origins/c2b1464a-7c12-4438-bbc4-6e739909cf79?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ae48fd6a250b420905b5e475c40c865d 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/158c5091/uploads/origins/c2b1464a-7c12-4438-bbc4-6e739909cf79?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a8db0a238afc89a76e2c09920bbea000", "srcset": "https://si.imgix.net/158c5091/uploads/origins/c2b1464a-7c12-4438-bbc4-6e739909cf79?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a8db0a238afc89a76e2c09920bbea000, https://si.imgix.net/158c5091/uploads/origins/c2b1464a-7c12-4438-bbc4-6e739909cf79?bg=%23fff&auto=format%2Ccompress&f