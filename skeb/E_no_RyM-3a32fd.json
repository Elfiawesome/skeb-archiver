-4d8e-959f-bc9d669e7047?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4e5e90996547ef403bc453fa650a4206, https://si.imgix.net/d9ff652b/uploads/origins/80274eb2-5f11-4d8e-959f-bc9d669e7047?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=da16829758ec49bd277b14ec4fa7264b 2x, https://si.imgix.net/d9ff652b/uploads/origins/80274eb2-5f11-4d8e-959f-bc9d669e7047?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=0f884ae53c8b537e5cbf22d84e6a69e6 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/d9ff652b/uploads/origins/80274eb2-5f11-4d8e-959f-bc9d669e7047?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=654eadabfc7b2286fd3efe468a959482", "srcset": "https://si.imgix.net/d9ff652b/uploads/origins/80274eb2-5f11-4d8e-959f-bc9d669e7047?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=654eadabfc7b2286fd3efe468a959482, https://si.imgix.net/d9ff652b/uploads/origins/80274eb2-5f11-4d8e-959f-bc9d669e7047?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=38c49bb9fed6aae94a72a8658d73a7b6 2x, https://si.imgix.net/d9ff652b/uploads/origins/80274eb2-5f11-4d8e-959f-bc9d669e7047?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=c328dc2b9c1c6298939a06e6aac3a8a3 3x"}, "body": "神前りん様\n\nはじめまして！\n個人でVTuber活動をしております、森永ここあ と申します。\n神前りん様のかわいくてあたたかみのあるイラストを拝見して、ぜひ私のイラストも描いていただきたいと思い依頼させていただきました！\n\n【依頼内容】\n・森永ここあ（私）のイラストをお願いいたします。\n・「明るい」「かわいい」「たのしい」というようなイメージのイラストにしていただけると うれしいです！\n・サムネイル等にも使用させていただきたいので人物の上部と左右が見切れないもの、また可能でしたら背景と人物を分けたデータをいただけると幸いです。\n\n\n【自己紹介】\n名前：森永ここあ🦊🍫\nイチゴとココアが好きな銀色の妖狐。しっぽの数は2本。\n九尾の狐になるために人間界で修行中。\n本体は銀色の狐だが、人型に化けるときは人間界に馴染むように髪の毛をココア色にしている。\n好きな色は赤と緑。\n\n以下に参考資料を添付させていただきます。\nhttps://drive.google.com/drive/folders/1hcdBM2hfYgs7kag96u2faE0yGDPthMzc?usp=sharing\n\n紛らわしいポイントをピックアップさせていた