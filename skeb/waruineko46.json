_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 49, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@waruineko46/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 685257, "client_id": 0, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/7f69df63/uploads/origins/4f3df8e2-31b9-4344-bc4f-ed7cfe5eec5c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bffff1a3c6f7a22c8bd0cd18711fc92d", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/7f69df63/uploads/origins/4f3df8e2-31b9-4344-bc4f-ed7cfe5eec5c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a1ef778626a48cf0ae7ecbc574f38f71", "src_set": ""}, "body": "またまたリクエストです\n今度は一コマ目ではしんのすけが霊夢とレミリアに可愛がられていて、見ていてほっこりするような感じなのですが、2コマ目では霊夢とレミリアがヤンデレのように目がキマっていて息づかいを荒くしながら内心しんのすけのことを『可愛い』やら『襲いたい』など様々な危ない思考を持っているというシチュが見てみたいです\nいわゆる即墜ち2コマに近い感じです\n(タグはクレヨンしんちゃん、東方project、野原しんのすけ、博麗霊夢、レミリア・スカーレット、ヤンデレ、おねショタ、東方暮四禄の計8つをつけて下さい)", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@waruineko46/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 685257, "client_id": 251120, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/9dfb567a/uploads/origins/7607e7d6-e027-4f99-af8b-a02d5abf19d8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5c166f6b74ebf4194741b3dc460414c5", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/9dfb567a/uploads/origins/7607e7d6-e027-4f99-af8b-a02d5abf19d8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ae860974e477151ee0f583334c766a0c", "src_set": ""}, "body": "こんにちは、シブでのイチャイチャしたイラストにいつも興味を持っていてうちの子にこんな事されたいという欲がありましたので依頼してみました。\n\n登場キャラは資料にあるラミア体のお姉さんと竜人で、\nシチュはラミア体のお姉さんに巻き付き拘束されながらたくさんチュッチュッされてしまい快感を味わっている竜人をお願いしたい(ディープキスしていると良いがそこはおまかせします)のと、\nラミア体のお姉さんは翼包み込みもできる大きな翼を持っているので、二人のチュッチュッ状況を翼で包み込み隠してさらに激しくなっている状態をお願いします。キャラは隠れて見えないが、二人だけのプライベート空間で激しくイチャイチャされてるシチュが好きなのでよろしくお願いします。\n\n包み込み時の時は言葉にならない快感の悲鳴やハートがたくさん飛んでると良いです。\nチュッチュッ口紅は紫色など妖艶そうな色が良いです。\n\n色はカラーでお願いします。\n\nhttps://twitter.com/blackdragon2623/status/1672102409039151105?t=b49ab66S6wsERRkx17UZvg&s=19", "nc": 33, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "similar_creators": [{"id": 17501, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "月代：コミ１M19b", "screen_name": "bs_sakayaki", "avatar_url": "https://pbs.twimg.com/profile_images/1707682140383834112/OEdR5UCM.jpg", "header_url": "https://pbs.twimg.com/profile_banners/76016362/1749546319/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 7, "skills": [{"genre": "art"}, {"genre": "comic"}, {"genre": "correction"}], "nc": 161}, {"id": 20242, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "泥っせる", "screen_name": "xxdrosselxx", "avatar_url": "https://pbs.twimg.com/profile_images/1606535687423275008/n4qJslZc.jpg", "header_url": "https://pbs.twimg.com/profile_banners/902999259359752192/1711350078/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "skills": [{"genre": "art"}], "nc": 49}, {"id": 68302, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "𝑨𝒌𝒂𝒊", "screen_name": "aka8mori", "avatar_url": "https://pbs.twimg.com/profile_images/1254794481494142978/WcHB8nyx.jpg", "header_url": "