私のキャラの服装については、自由にアレンジや変更をしていただいても大丈夫です。\n\n◆用途\n完成したイラストは、収益化済みのbilibiliでの配信活動に使用させていただく予定です。\n主に配信サムネイルとゲーム配信予告などと思います。\n\n◆データ\n画像は背景透過もしくはPSDデータがあればとても助かります。\n\nぜひ前向きにご検討いただけますと幸いです。どうぞよろしくお願いいたします！\n\n参考リンク\nhttps://drive.google.com/drive/folders/1qA6Vc052Q7kaf-nuK2M8X0qc-J0x3JO8", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@shimoyake933/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2727980, "client_id": 318030, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/2abd0670/uploads/origins/ecd46e27-2f9b-41a3-b390-a6e92d104d25?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=690d759d98405facd88daeca61c37a3d", "srcset": "https://si.imgix.net/2abd0670/uploads/origins/ecd46e27-2f9b-41a3-b390-a6e92d104d25?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=690d759d98405facd88daeca61c37a3d, https://si.imgix.net/2abd0670/uploads/origins/ecd46e27-2f9b-41a3-b390-a6e92d104d25?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=19292b81eb43e66f865e7ea395f4b082 2x, https://si.imgix.net/2abd0670/uploads/origins/ecd46e27-2f9b-41a3-b390-a6e92d104d25?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=2f5febfdd8846a932a09fef52d10b28f 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/2abd0670/uploads/origins/ecd46e27-2f9b-41a3-b390-a6e92d104d25?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6d0fb698d4c777a21ebfe024176d088e", "srcset": "https://si.imgix.net/2abd0670/uploads/origins/ecd46e27-2f9b-41a3-b390-a6e92d104d25?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6d0fb698d4c777a21ebfe024176d088e, https://si.imgix.net/2abd0670/uploads/origins/ecd46e27-2f9b-41a3-b390-a6e92d104d25?bg=%23fff&auto=format%2Cc