9f-b241-4fb8-9c61-d31b59588253?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3a9848d2069e66140f30524c96d914e4", "srcset": "https://si.imgix.net/4cb3b3bd/uploads/origins/f632639f-b241-4fb8-9c61-d31b59588253?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3a9848d2069e66140f30524c96d914e4, https://si.imgix.net/4cb3b3bd/uploads/origins/f632639f-b241-4fb8-9c61-d31b59588253?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=8856f68e018f2e139af8994f34ec91d1 2x, https://si.imgix.net/4cb3b3bd/uploads/origins/f632639f-b241-4fb8-9c61-d31b59588253?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=acba85715fde02a86b9d92a1e9e4ea1a 3x"}, "body": "失礼いたします！しんしマーカスさんのイラストやオリキャラの子達を拝見させていただきまして、今回うちの子オリキャラのロボット娘の未夜ちゃんのイラストリクエストをお願いしたいです。\n\nそしてリクエストしたい内容なのですが…もし大丈夫でしたら、しんしマーカスさんの子達と、うちの未夜ちゃんのうちよそ絡み的なイラストをお願いしたいです。\n\n◆未夜ちゃんについて\n天宮 未夜(てんぐう みや)\n身長は138～139cmと小柄で胸もぺったんこ。代わりにお尻が少し大きめなイメージ。\n一見普通の女の子な見た目なのですがその正体はロボット少女。ロボットではありますが天真爛漫元気いっぱいな子であり、正体は秘密なのに無邪気さ故に首を外しちゃったりもする子です。\n未夜ちゃんの外見や詳しい資料はこちらを参考にしてください↓\n◆設定資料\n(https://www.pixiv.net/novel/series/7700088/glossary/96634)\n未夜ちゃんの外見資料\n(https://x.com/ssaa_MRT28/status/1953399571515670787?t=xLnFupNcU-pKblF3aYRFPw&s=19)\n(https://x.com/ssaa_MRT28/status/1912164805395533849?t=OaGyoC9rfIJeaBasBAMbaw&s=19)\n\n\n内容\nしんしマーカスさんの子達に、未夜ちゃんが「実は私ロボットなの！本当は秘密なんだけどね、えへへ」といった感じで首外しを披露している。といった感じのイラストをお願いしたいです。\n(しんしマーカスさんの子達の、未夜ちゃんの首外しに対する反応に関しては、しんしマーカスさんにお任せいたします)\n\n(※未夜ちゃんの首外しに関しましては、分離時は無線通信で頭部側から胴体を制御しているという設定なのでケーブルで繋がっている描写は避けていただけるとありがたいです)\n\nその他細かい所はしんしマーカスさんにお任せいたしますです。\n\nロボット娘の首外しというメカバレ要素やうちよそ絡みの内容でもあるので、苦手だったり難しい場合でしたらお断りしていただいても構いません。\nリクエストを受けていただけましたら、未夜ちゃんをよろしくお願いいたします。", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 935262, "creator": true, "nsfw_acceptable": false, "acceptable": false, "name": "ツキラ",