シュガルディアン・ヒーラートップス\n手：アンドロイド旧式手袋:医\n脚：ネオイシュガルディアン・ヒーラーボトム\n足：エデンモーン・ヒーラーブーツ\n※足装備以外は全てピュアホワイト染色\n※要望として頭装備の花を顔向かって右側に描いてほしいです\n\n□キャラ詳細\n髪型は上記資料のロングヘア。髪色は白。\n瞳の色は若干薄目がかったブルー\n\n□構図・雰囲気\n申し訳ありませんが構図やポーズはお任せします。ただ少し動きのある様子だとありがたいです。\n雰囲気として可愛さと美しさを兼ね備えたものにしていただけると嬉しいです。(表情としてゲーム内の感知顔\n背景として白を基調としたものをお願いします(装飾物等はお任せします\n\n\n内容は以上となります。\n至らない点が多いと思いますが、もしこの条件で大丈夫であればよろしくお願いします。", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@karurururuun/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 222219, "client_id": 251151, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/bc959b86/uploads/origins/de52738d-0226-435e-b4ec-f156787b54d6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b7c94dbf12779bab3ddb9898494bcfa1", "srcset": "https://si.imgix.net/bc959b86/uploads/origins/de52738d-0226-435e-b4ec-f156787b54d6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b7c94dbf12779bab3ddb9898494bcfa1, https://si.imgix.net/bc959b86/uploads/origins/de52738d-0226-435e-b4ec-f156787b54d6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c12afc8cb81a7f375b6223df39c5da1c 2x, https://si.imgix.net/bc959b86/uploads/origins/de52738d-0226-435e-b4ec-f156787b54d6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=211b72fdce469599791bf20c80def24c 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/bc959b86/uploads/origins/de52738d-0226-435e-b4ec-f156787b54d6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b6ccbe5e7fed324e5777a7dd145c8fbf", "srcset": "https://si.imgix.net/bc959b86/uploads/origins/de52738d-0226-435e-b4ec-f156787b54d6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b6ccbe5e7fed324e5777a7dd145c8fbf, https://si.imgix.