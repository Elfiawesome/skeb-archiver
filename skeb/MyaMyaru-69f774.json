える時もありますが、基本人を思いやれる良い人です。\n◇顔がとても良いのでモテます。\n◇女装をしているのは家庭環境の影響で、幼少期に母親に女装をさせられてから続いています。\n\n\n難しいなどあればキャンセルしていただいても問題ありません。\nご検討のほどよろしくお願いします。\n\n\n◆キャラ・世界観設定（概要）\nhttps://primitive-species.com/worldofyounggirls/", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 9060, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "赤渕めがね / イラストレーター", "screen_name": "abmJP_", "avatar_url": "https://pbs.twimg.com/profile_images/1966843783519367177/gi3JXuic.jpg", "header_url": "https://pbs.twimg.com/profile_banners/183631210/1770033895/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "art"}, {"genre": "correction"}], "banned": false, "nc": 0}, {"id": 340904, "creator": true, "nsfw_acceptable": false, "acceptable": false, "name": "みんたろう", "screen_name": "min_taroo", "avatar_url": "https://pbs.twimg.com/profile_images/1925153119316705280/QE-wu1-Y.jpg", "header_url": "https://pbs.twimg.com/profile_banners/984890556/1757271898/1500x500", "appeal_receivable": true, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "art"}], "banned": false, "nc": 145}, {"id": 1995919, "creator": true, "nsfw_acceptable": false, "acceptable": false, "name": "七色ないろ", "screen_name": "716", "avatar_url": "https://pbs.twimg.com/profile_images/1074289254556098561/9Bhzkssu.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1066303897038245888/1703390471/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "none"