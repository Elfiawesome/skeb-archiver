s/origins/315ad404-4199-4942-b3ae-dc4b62687c4d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=38212cf1c535adfe5189e59074f82b86", "src_set": ""}, "body": "もしよければリクお願いします。\n\nキャラクター：キュアパッション　フレッシュプリキュア\nhttps://www.deviantart.com/miaknhikari/art/Cure-passion-character-setting-sheet-796335558\n\n基本は既刊モナ本みたいな100％着衣アナル物で\n竿役は顔無し全裸モブ君にしてください\n画面に対する男面積が小さいほうがいいので\n省エネ作画で竿だけとか、竿さえ見えない完全透明でも\n竿役消去差分ありなら竿役で本人隠れててもおｋです\n\n側臥位で片足持ち上げてスタート、足ピン９０度開脚を経て\nフィニッシュはほぼ１８０度開脚(寝た状態でI字/Y字バランス並みに開脚)\n\nタイツのダメージやずらしは無いほうがいいので\n退魔忍とかゼロスーツサムスとかでたまに見るスーツごとそのまま挿入とか\nオリジナルから改変してモナのような穴あきレオタード着せるか\n真ん中にジップついててアクセスできるようになってるとか\nそんな感じでどうでしょうか\n\nポーズは無理あるなと思ったらお好みで変えてもらって全然かまいませんが\n着衣アナルで前は一切触らないとこだけ死守で…", "nc": 49, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@warabiyuzo/works/43", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1171043, "client_id": 93103, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/cb715bad/uploads/origins/654bafd2-35fb-4b28-bb12-e1fd1bacd44c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e2388903ec22e17621665199d62231d6", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/cb715bad/uploads/origins/654bafd2-35fb-4b28-bb12-e1fd1bacd44c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ba25519f3774f880313ae2b041406cc8", "src_set": ""}, "body": "初めまして！\n先日skeb内をサーフィンしていたところ先生が描かれた神田川JET GIRLSの波黄凜ちゃんに辿り着きまして…。\nメチャメチャに可愛かったので以来フォロー＆作品やご投稿楽しみにさせていただいております。\n(※隣の旦那とウチの妻の由衣さんも激エロで大変お世話になりました🙏💦)\n自分も凜ちゃんにてリクエストをお送りいたします。\nお手数おかけしますがお目通しだけでもいただけると有難い限りです。\n\n『ｼﾁｭｴｰｼｮﾝ内容』\n両胸を揉みしだかれながら頬を舐められ乳イキしてしまう波黄凜…にてリクエストさせてください \n \nhttps://anime2.blog.jp/archives/20276010.html\n\n『凜ちゃん』\n・他のご依頼者様作品で書かれていた黄色の下着姿(上下とも)、白色の靴下\n・胸を弄る男性の手〜手首〜腕付近を掴む\n・弱点の胸を責められ羞恥の表情で嬌声をあげている\n・胸だけで達してしまう表情差分をお願い致します(目を瞑る開く等)\n・身悶えながら太ももをもじもじくねらせている\n※イメージ※\nhttps://drive.google.com/drive/folders/1Pikl8umfi2Fp5cnLzMuBUDIOS-nOcRja\n\n『絡み相手』\n・表情は描写せず最低限人間と認識出来る程度の書き込みで構いません\n・凜ちゃんの後方〜または隣から両胸の中心を鷲掴むように揉みまくる\n・凜ちゃんの頬が大きく変形しない程度に舌を這わせ舐めている(白い唾液が付着)\n※可能であればそのままベロチュー\n\nもし台詞などを添付していただける場合はON/OFF切り替えれる形でいただけると嬉しいです🙏\n\n以上の内容でお送り致します。\nご多忙の折、大変恐縮ではございますがご検討いただければ幸いです。", "nc": 160, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@warabiyuzo/works/42", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/e9b941c4/uploads/origins/cd993b6d-54e7-4874-b5e1-75b543c42027?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=73ced0effa34ecf77b9ffc0caf421ca9", "src_set": ""}, "private": true, "genre": "art", "tipped": false, "creator_id": 1171043, "client_id": 0, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 32, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@warabiyuzo/works/41", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/ab1e410b/uploads/origins/7ec2ddad-13d4-498c-9ba6-a36906bed0c4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=d3ff5a02fb779e63a82e717265bd43c0", "src_set": ""}, "private": true, "genre": "art", "tipped": false, "creator_id": 1171043, "client_id": 0, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 161, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@warabiyuzo/works/40", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/a482753d/uploads/origins/ba3820c0-ee5d-4214-9fa6-5788e8cae6d5?bg=%23fff&au