d61bfa2418a4fadda5b7c", "srcset": "https://si.imgix.net/39605297/uploads/origins/31ab03b2-18ac-4bb6-b929-e4579ef37627?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=8f583611d28d61bfa2418a4fadda5b7c, https://si.imgix.net/39605297/uploads/origins/31ab03b2-18ac-4bb6-b929-e4579ef37627?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=dabbc78df5eb8e5e367c5725a61fcccd 2x, https://si.imgix.net/39605297/uploads/origins/31ab03b2-18ac-4bb6-b929-e4579ef37627?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=aff65a44fbee3fc30911253855649412 3x"}, "body": "あなたのオリジナル・キャラクターの写真が欲しい。視聴者の勃起したテントが、あなたのキャラクターの巨大で丸い尻の間にある状態で、視聴者におならをしてもらいたい。その絵は見る人の視点でも構わないし、見る人は勃起した巨根を締め付けるパンツを履いているはずだ。\n\nあなたのキャラクターがパンツの中にウンコをする、視聴者なしのバージョンも追加してください。\n\n(できれば台詞もお願いします。）\n\nhttps://drive.google.com/drive/folders/1w0J6aDg8aBhXNa8BwA9E5X5Vxjz98XVF", "nc": 42, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@kuro4482/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3383764, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/b2780851/uploads/origins/a332d63e-f131-4425-95c4-c236fb891a23?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3576254fcd2239ff26c13737adb7dd28", "srcset": "https://si.imgix.net/b2780851/uploads/origins/a332d63e-f131-4425-95c4-c236fb891a23?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3576254fcd2239ff26c13737adb7dd28, https://si.imgix.net/b2780851/uploads/origins/a332d63e-f131-4425-95c4-c236fb891a23?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=0cc90449e785d96c8e66dd5b4a31e1a6 2x, https://si.imgix.net/b2780851/uploads/origins/a332d63e-f131-4425-95c4-c236fb891a23?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=0b50390c481545e3fd74d81f2e6b70ad 3x"}, "duration": null, "nsfw": true, "hardcore": true, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/b2780851/uploads/origins/a332d63e-f131-4425-95c4-c236fb891a23?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ff0899dd533042db0a51e403d4b31be1", "srcset": "https://si.imgix.net/b2780851/uploads/origins/a332d63e-f131-4425-95c4-c236fb891a23?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ff0899dd533042db0a51e403d4b31be1, https://si.imgix.net/b2780851/uploads/origins/a332d63e-f131-4425-95c4-c236fb891a23?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=cc1c14ffd725b2c4d65a868347379fc4 2x, https://si.imgix.net/b2780851/uploads/origins/a332d63e-f131-4425-95c4-c236fb891a23?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=53c8389dfb09ffcf20045786032f999d 3x"}, "body": "初めまして、あなたの原型に近いながらも凄くえっちに描かれているポケモンを見て、\nリクエストを決めました。加えてスカ表現も素晴らしかったのでぜひお願いしたいです…！！\n\n【キャラクター】\n・ゾロアーク(オス)\n\n【構図】\n資料に詳細を絵に描き起こしてみたので、ご確認いただけたら嬉しいです。\n拙いかもしれませんが、参考になれば幸いです…。\nテキストに描き起こすと、\n・バックでオナホールを犯している\n・片膝立ちのような感じで、オナホールを掴んでいるのが分かる\n・顔、ペニス、玉、アナルが良く見える\n\n【展開等】\n①トレーナーのオナホールを勝手に拝借して犯している（ピストン＋おなら）\nトイレに行きたいが、性欲が勝って我慢しながらオナニー\n②射精するも、我慢できなくて大便も出てしまう（射精＋脱糞）\n　→射精時、金玉が精液を絞り出すように持ち上がる。腰を振るのをやめる。\n③トレーナーが帰ってきてしまい、オナニーがバレる（おなら）\n④射精と脱糞が止まらずに再度どちらも出してしまう（再射精＋再脱糞）\n★射精差分について、放尿版の差分もあると嬉しいです！！\n\n表情や細かな要素につきましては、資料内にも記載したため、参考になれば幸いです。\n\n【セリフについて】\n・セリフを付けて欲しいです。資料内にセリフも入れてありますので、\nもしよければこのままお使いください。\n一応大まかな流れだけお伝えしますと、オラついてる感じのゾロアークが情けなく\n射精＋脱糞してしまったうえ、トレーナーの前でオナニーがバレた挙句再度放出してしまう感じです。\n\n【その他】\n・効果音等は汚くてえっちだと嬉しいです。\n\n【資料】※資料ＵＲＬの欄にも記載いたします\nhttps://drive.google.com/drive/folders/1fZwp79EHz4PN_8xZ1LQbpEZ9rXwmhr0B?usp=sharing\n\nあなたの絵柄、描き方が大好きなので、この内容でぜひ描いて頂きたいです。\n\n勝手ながら、額が低かったかなと反省したのでリクエスト再送いたします。誠に申し訳ございません。\n\n何卒、よろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/1fZwp79EHz4PN_8xZ1LQbpEZ9rXwmhr0B?usp=sharing", "nc": 187, "word_count": 0