-4d35-b379-8e294f3e2d01?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d6c9e917adfba29e2bc3e2ce962adec1", "srcset": "https://si.imgix.net/20d19b22/uploads/origins/db326d0d-cf7f-4d35-b379-8e294f3e2d01?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d6c9e917adfba29e2bc3e2ce962adec1, https://si.imgix.net/20d19b22/uploads/origins/db326d0d-cf7f-4d35-b379-8e294f3e2d01?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=4be654e363c00aad35155792d064a089 2x, https://si.imgix.net/20d19b22/uploads/origins/db326d0d-cf7f-4d35-b379-8e294f3e2d01?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=7673db811b14e5daedf27caf412a229f 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/20d19b22/uploads/origins/db326d0d-cf7f-4d35-b379-8e294f3e2d01?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=399ef4a233a685bb698b214c294764d9", "srcset": "https://si.imgix.net/20d19b22/uploads/origins/db326d0d-cf7f-4d35-b379-8e294f3e2d01?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=399ef4a233a685bb698b214c294764d9, https://si.imgix.net/20d19b22/uploads/origins/db326d0d-cf7f-4d35-b379-8e294f3e2d01?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=6ceeef2b97f230910463d39d1d5cfc7b 2x, https://si.imgix.net/20d19b22/uploads/origins/db326d0d-cf7f-4d35-b379-8e294f3e2d01?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=55819acacec9a297c19ad9fd04d20f5c 3x"}, "body": "お世話になっております、めぐると申します。\nTwitterでいつもぽろぽろさんのイラストを拝見しています！繊細なタッチがとても素敵で大好きです。先日描いていただいた花冷え自探のイラストも本当に素敵で何度も眺めています……！\n\nこのたび依頼したいのは初恋性自陣の2人が正装を着ているイラストです。\n可能であれば、結婚式のタキシードをイメージしたような衣装をお願いしたいです。スーツの色は平沢慈祈が白、明城架流がグレー。お互いに相手の目の色の花を胸に挿していると嬉しいです。その他構図等詳細はお任せします。\n\n平沢慈祈(ひらさわ いつき)→初恋性PC。藍色の髪の方。20歳。179センチ。攻め。目の色は深い青。女顔ではあるが表情、仕草はあくまで男子大学生らしい。穏やかで優しい性格。少し釣り気味の目元が特徴的。ピアスをつけている。\n\n明城架流(みょうじょう かける)→初恋性KPC。赤みのある茶髪の方。目の色はピンクに近いある紫。20歳。182センチ。受け。感情表現はひかえめ。よそゆきだと社交的に振る舞えるが本当は人疲れする方。右目の下に泣きぼくろがある。\n\nご検討頂ければ幸いです。よろしくお願いします……！\n\nhttps://drive.google.com/drive/folders/1-U3zLNay3YJkg7B-BHnTgs16C6dB_Grg", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@maco_mag/works/64", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 292466, "client_id": 2412601, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/aae120bf/uploads/origins/6b0f05d8-23ab-453c-9576-4bfa71a2be8e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ffa0aed14f31f0d8094d9927cf5db8ca", "srcset": "https://si.imgix.net/aae120bf/uploads/origins/6b0f05d8-23ab-453c-9576-4bfa71a2be8e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ffa0aed14f31f0d8094d9927cf5db8ca, https://si.imgix.net/aae120bf/uploads/origins/6b0f05d8-23ab-453c-9576-4bfa71a2be8e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=dba08705ffb315a912060c39e599fb75 2x, https://si.imgix.net/aae120bf/uploads/origins/6b0f05d8-23ab-453c-9576-4bfa71a2be8e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ce4b11676bfb5debec347b7e8e92336f 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/aae120bf/uploads/origins/6b0f05d8-23ab-453c-9576-4bfa71a2be8e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=66d69be4d209d039505e29107c248627", "srcset": "https://si.imgix.net/aae120bf/uploads/origins/6b0f05d8-23ab-453c-9576-4bfa71a2be8e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=66d69be4d209d039505e29107c248627, https://si.imgix.net/aae120bf/uploads/origins/6b0f05d8-23ab-453c-9576-4bfa71a2be8e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&cr