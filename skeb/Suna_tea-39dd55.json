format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=ffca896e4d2b88903651f9b7261343b9 3x"}, "body": "蘭(ふたなり)がモカにパイズリしてもらうよう頼む漫画をお願いします。\n\nアフロゼ攻組飲み会で宇田川姉妹のパイズリトークを聞かされた蘭(知識が豊富な方ではないのでこの時点では「そういうプレイもあるんだ……？」くらいの態度)がモカと二人きりになった途端どうしても気になってしまいモカに挟んでもらうことをお願いする、というような導入でお願いします。モカはおっぱいにすごく視線を感じるのは気づいていたものの、まさかそんなことを頼まれるとは思っておらずびっくりする、というようなリアクションも入れてほしいです。\nよろしくお願いします。", "nc": 33, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Suna_tea/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 394486, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/4e8fb710/requests/137861_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=cf998579cecd5b09b74d9c96c8b599ca", "srcset": "https://si.imgix.net/4e8fb710/requests/137861_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=cf998579cecd5b09b74d9c96c8b599ca, https://si.imgix.net/4e8fb710/requests/137861_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=7efcaf6a5959f78e832df5512aa07c71 2x, https://si.imgix.net/4e8fb710/requests/137861_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=fdc4099e80500e1164cbf29ccf28339d 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/4e8fb710/requests/137861_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=14ba569d37d00a799db32db1527eb4d3", "srcset": "https://si.imgix.net/4e8fb710/requests/137861_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=14ba569d37d00a799db32db1527eb4d3, https://si.imgix.net/4e8fb710/requests/137861_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=e1be7dfe8900ab430ad178111105e870 2x, https://si.imgix.net/4e8fb710/requests/137861_0?bg=%23fff&auto=format%