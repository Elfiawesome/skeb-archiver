ix.net/e2b09b32/uploads/origins/4cd4ecc9-6455-4478-a16c-5ceabd53a059?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=37a2958f1d1b8a4389fa0893a113fd7e", "srcset": "https://si.imgix.net/e2b09b32/uploads/origins/4cd4ecc9-6455-4478-a16c-5ceabd53a059?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=37a2958f1d1b8a4389fa0893a113fd7e, https://si.imgix.net/e2b09b32/uploads/origins/4cd4ecc9-6455-4478-a16c-5ceabd53a059?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=0ec56afcf322505128f6ac388f9cb7a3 2x, https://si.imgix.net/e2b09b32/uploads/origins/4cd4ecc9-6455-4478-a16c-5ceabd53a059?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=7cf6b8917e84df7231413f6e1d87eaea 3x"}, "body": "お世話になっております　今回も依頼をと思い書き込ませていただきます\n\n内容　異世界フルーツ系イラスト(Xでフルーツ系が、というコメントを見て)\n\n詳細　瓶詰めカットフルーツ(シロップ漬け)とベリータルト\n\n・瓶詰め　であるが瓶は瓶でも　・素材が水で、川の精霊が大水で流れが澱むのを防ぐため\n余分な水をシャボン玉のような玉にし　低地に向けてふわふわ低空で飛ばしているのを捕獲\nある程度の強度があり、一度何かに接触すると浮力が無くなるが、非常に軽い為割と重宝されている\nその中に樹液から生成された砂糖(のようなもの)を主としたシロップを入れ、その中に桃などの\nフルーツを入れ　コルクで栓をする製造法である　普通の瓶は存在するがこちらのほうが売れ行きはいい\n\n・ベリーのタルト　我々の世界と左程差はないが参考画像　\nhttps://market.abc-cooking.jp/collections/mixberrytart\n\nベリーの色合いが薄いピンクや黄色のものも混ざっている(少し酸味が強く彩の意味合いが強い)\n地方によっては苺や無花果のような果物のカットが入ってたりする\nポピュラーなデザートであるが地方色が出るため食通は街に入ったら必ず注文するらしい\n\n両方ともテーブルの上に乗せられている(タルトは一切れ誰かが手を出して食べようとしている)\nという感じでお願いいたします    是非ともご検討宜しくお願い致します\n\nhttps://market.abc-cooking.jp/collections/mixberrytart", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@danryoku_R/works/10", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2196631, "client_id": 413386, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/4d58be31/uploads/origins/97588192-e77e-4921-8f99-9c88495792ba?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=166292fa4d2ffd53d5355a89fae12bf5", "srcset": "https://si.imgix.net/4d58be31/uploads/origins/97588192-e77e-4921-8f99-9c88495792ba?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=166292fa4d2ffd53d5355a89fae12bf5, https://si.imgix.net/4d58be31/uploads/origins/97588192-e77e-4921-8f99-9c88495792ba?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=3d228cb73e118a0ae4d9bea9ff1d3d49 2x, https://si.imgix.net/4d58be31/uploads/origins/97588192-e77e-4921-8f99-9c88495792ba?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=03db75a282f630d588e269f3f896bfe6 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/4d58be31/uploads/origins/97588192-e77e-4921-8f99-9c88495792ba?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b4ef85ae8b965d56f034447832213db5", "srcset": "https://si.imgix.net/4d58be31/uploads/origins/97588192-e77e-4921-8f99-9c88495792ba?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b4ef85ae8b965d56f034447832213db5, https://si.imgix.net/4d58be31/uploads/origins/97588192-e77e-4921-8f99-9c88495792ba?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=e350c7f20e33e799de488fbb24eb3bd2 2x, https://si.imgix.net/4d58be31/uploads/origins/97588192-e77e-4921-8f99-9c88495792ba?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=7ddfe63770b8c8636f2ae99360b8c1db 3x"}, "body": "弹力先生へ  \n\nこんにちは！以前Twitter（X）で先生のSkeb募集を見て、イラストの依頼をしたいと思っていました！私のオリジナルキャラクターが食卓で広東式飲茶の点心を食べているイラストを描いていただきたいです。先生は異世界の食材をテーマにしたイラストを手掛けていらっしゃるので、広州の飲茶点心を異世界の食材でアレンジしていただけると嬉しいです！先生が広東式飲茶に詳しいかわからなかったため、私が好きな点心の画像資料を集め、味や食感、材料の解説資料も作成しました。参考になれば幸いです！  \n\nオリジナルキャラクターの参考： \n[鬼狐狸酱の画像/設定資料]  https://drive.google.com/drive/folders/1ayLVR3P9cLtyB089luM6WA-WjJBvO8Po?usp=sharing\n構図の希望：https://drive.google.com/drive/folders/11Lau6booAe-CvGHYqmjq7BpLuGSPX9cj?usp=sharing\n鬼狐狸酱が箸で点心を食べながら、満面の笑みを浮かべている様子です！  \n点心の参考資料（画像＋味・食感・原料の解説）： \n[リンク/資料]  https://drive.google.com/drive/folders/1Aln4y8T3RWZl9S1CMQ91gOgg4ZlzfUt2?usp=sharing\n\nご返信お待ちしております！\n\nhttps://drive.google.com/drive/folders/1i7Gea3yFCjkbD1QrrY7kQYoZ915GPiCl?usp=sharing", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@danryoku_R/works/9", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2196631, "client_id": 88984, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/d15f6621/uploads/origins/afca0412-606a-4e0f-afc6-8ea6c9bba9b2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1516f71f59a2bd121c57dc1a7c36f024", "srcset": "https://si.imgix.net/d15f6621/uploads/origins/afca0412-606a-4e0f-afc6-8ea6c9bba9b2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1516f71f59a2bd121c57dc1a7c36f024, https://si.imgix.net/d15f6621/uploads/origins/afca0412-606a-4e0f-afc6-8ea6c9bba9b2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=4fa5bb88b41b821752e31ec41ae1ef41 2x, https://si.imgix.net/d15f6621/uploads/origins/afca0412-606a-4e0f-afc6-8ea6c9bba9b2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=1eb24c92a71d27258c45fa0f2a637a31 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/d15f6621/uploads/origins/afca0412-606a-4e0f-afc6-8ea6c9bba9b2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c7fc1fd7b9a9bd3c87c80161ddb02504", "srcset": "https://si.imgix.net/d15f6621/uploads/origins/afca0412-606a-4e0f-afc6-8ea6c9bba9b2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c7fc1fd7b9a9bd3c87c80161ddb02504, https://si.imgix.net/d15f6621/uploads/origins/afca0412-606a-4e0f-afc6-8ea6c9bba9b2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=de0de871f2d2c420ccc1e299ca6ec633 2x, https://si.imgix.net/d15f6621/uploads/origins/afca0412-606a-4e0f-afc6-8ea6c9bba9b2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=0ceef8439ceee6b24fe0b7b0c992708d 3x"}, "body": "美味しそうなご飯イラストが頭の中に残り続けていて、この度ご依頼させていただければと思いました。\n私のOCキャラがご飯の前で嬉しそうにしている姿を描いていただけませんか？（ご飯メインでキャラは端っこの方で大丈夫です）\nOCキャラは人型ですが蛇の性質を持っており、普段は森の奥で木の実などシンプルな食生活をしています。今回は一ヶ月に一回街へ下りてきた時の【めっちゃ食うぞ！】の状態です。あまり表情が動かないタイプですが、この時ばかりは喜びが隠し切れないようです。\n\n【食べてる物】\n「ミートスパゲッティ大盛り、フリカッセ大盛り、ラタトゥイユ大盛り、ウフマヨ五人前、とりあえず以上で」\nと注文してるシーンを過去に書いたことがあります。\nしかし、弾力様の描くご飯はどれも美味しそうなので……何を描いていただいても……でっかい骨付き肉も骨ごと食べられますので何卒……沢山食べますので大盛りであれば大盛りである程嬉しいですが、一品デカデカとあっても素晴らしいと思います。\nお任せいたします！\n\n【OCについて】\n・白髪、赤〜ピンクの間くらいの目、やや色黒\n・身長155cm、筋肉質。柔軟性と瞬発力が高い\n・首から頬にかけて蛇に巻かれたような感じの太めの痣あり\n\n以前他の方にOCイラストを依頼したものを添付しております。\n衣装についてですが、今回は外出着を想定しております。フード付きのマントもしくは類似するものを羽織らせていただけませんか？\n\nhttps://www.pinterest.jp/pin/422281209836247/\n\nイメージとしては↑のようなものですが、それっぽいので大丈夫です。正直に言うと今回は衣装に深いこだわりはなくて、弾力様のご飯を見たくて……\n例えばキャラの手だけが入ってて、ご飯がドンとあっても大満足なんです。\nキャラの容姿も具体的に決まっているわけではないので、あまり気になさらないでください。\n\n機会がありましたら、是非よろしくお願いいたします！\n\nhttps://skeb.jp/@Mihira_Fanfic/works/21", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@danryoku_R/works/8", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2196631, "client_id": 1834631, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/c4372c8d/uploads/origins/9e29cd88-4852-4108-937b-4cd52c1075c2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6d0e7af5d5adda7cc06d7cb15753a703", "srcset": "https://si.imgix.net/c4372c8d/uploads/origins/9e29cd88-4852-4108-937b-4cd52c1075c2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6d0e7af5d5adda7cc06d7cb15753a703, https://si.imgix.net/c4372c8d/uploads/origins/9e29cd88-4852-4108-937b-4cd52c1075c2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=1e57e1fbea4a495b59b82caf95274649 2x, https://si.imgix.net/c4372c8d/uploads/origins/9e29cd88-4852-4108-937b-4cd52c1075c2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ad96e4d170537390a511fe0663d0a087 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/c4372c8d/uploads/origins/9e29cd88-4852-4108-937b-4cd52c1075c2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b1bd2b0899126923051179c6c25c33a2", "srcset": "https://si.imgix.net/c4372c8d/uploads/origins/9e29cd88-4852-4108-937b-4cd52c1075c2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b1bd2b0899126923051179c6c25c33a2, https://si.imgix.net/c4372c8d/uploads/origins/9e29cd88-4852-4108-937b-4cd52c1075c2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=5de2fc767a5f3d530800238b912df77c 2x, https://si.imgix.net/c4372c8d/uploads/origins/9e29cd88-4852-4108-937b-4cd52c1075c2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=7bc03dd3d0031ae01f0b3072881eeb2a 3x"}, "body": "先日(前回)はお世話になりました　描いていただいたイラストがとてもよく、大変食欲をそそるもので\n今回はブーストの際にも書き込みましたものをと思います\n\n・内容　屋台のラーメン画像(なおファンタジー世界)\n\n・詳細　和風エルフの国(侍と忍者を輩出している、千年近く前に異世界から技術などが入り国になった。\n食文化もそれを主としたものになっており近代の調理師が転移した際　更に豊富となっていった)における\nメジャーな食べ物、という立ち位置で年配のエルフが屋台で出してくれる本格的なラーメン\n\n・具材　鰹(に似た魚から作られた)節からの出汁ベース、麺は近郊から交易で入ってきた小麦粉で一からつくったほぼ日本で食べられる細目のものと同じ　鶏ガラ、魚介類のスープのどちらか選べる\n鶏ガラだと薄く切った鶏肉が入り、魚介類だとカブトエビに近いエビ(主な可食部である尾が大きい)の\n尾の半身が入っている(頭部や胴体はスープのガラとしてもカリカリに揚げてチップスのように食べれる)\nもやしなどの野菜は多め(数少ないエルフ要素)\n他のトッピングについては入れてみたいものがありましたらお願いします\n\nイメージとして手軽に食べれるものとして定着している、街角の一角、屋台で出てきた一品、という感じで\n可能であればスライスしている鶏肉or鍋で煮込まれてるエビの頭部と胴体、という小さ目なイラストをと\n思います(食材とセットだと異世界での食事なんだな、と感じるためです、自己満足です　ハイ)\n\nお忙しい時期かと思われますが　ご検討のほどよろしくお願いします", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@danryoku_R/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2196631, "client_id": 1834631, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/e713b052/uploads/origins/6e8474b3-467b-4cd1-8dfb-9d4baa675c9f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a382f31979d5cc7d336384a5304c1ff4", "srcset": "https://si.imgix.net/e713b052/uploads/origins/6e8474b3-467b-4cd1-8dfb-9d4baa675c9f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a382f31979d5cc7d336384a5304c1ff4, https://si.imgix.net/e713b052/uploads/origins/6e8474b3-467b-4cd1-8dfb-9d4baa675c9f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=30c697b6bd8dab798fc87257133020ff 2x, https://si.imgix.net/e713b052/uploads/origins/6e8474b3-467b-4cd1-8dfb-9d4baa675c9f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=1fdc0b537b668ced18f7df48e729db1f 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/e713b052/uploads/origins/6e8474b3-467b-4cd1-8dfb-9d4baa675c9f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3acb8e4b80efcf09c31161014699e65f", "srcset": "https://si.imgix.net/e713b052/uploads/origins/6e8474b3-467b-4cd1-8dfb-9d4baa675c9f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3acb8e4b80efcf09c31161014699e65f, https://si.imgix.net/e713b052/uploads/origins/6e8474b3-467b-4cd1-8dfb-9d4baa675c9f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=ccbc55ce6f8570aad37d266ad0c5c7a1 2x, https://si.imgix.net/e713b052/uploads/origins/6e8474b3-467b-4cd1-8dfb-9d4baa675c9f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=7988fc2e8e0b42f096c5fd7e332e3131 3x"}, "body": "はじめまして、ツイッタで募集中と聞き是非ともと思いリクいたします\n\n内容　自分の中での