op=top&w=200&h=200&blur=200&s=ad85aa7d55fa76318ccfb14049c5693e 2x, https://si.imgix.net/5f3e9fda/uploads/origins/a31a1623-ad72-4bfc-9602-4cb331f11e08?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=a5f5dcbf784de9a785ea2ffddb247eb0 3x"}, "body": "つむぎの制服姿が本当に素敵だった！[https://x.com/ZhOhok/status/2010157605742882917]\n\nそれで私もるりの制服姿をコミッションしたんだ。ツムギに負けてから1～2ヶ月経った頃、ふさぎ込んで髪をブリーチしたけど、もう伸び始めている感じかな。[https://static.f-list.net/images/charimage/44021465.png]\n\nツムギが帰宅途中、ルリを見かける短いシーンを考えていた。ツムギはすぐに彼女だと気づき、前回の試合の結果について無礼に挑発する[https://skeb.jp/@ZhOhok/works/2]。その結果、ルリは再戦を挑む。", "nc": 177, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@ZhOhok/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3836674, "client_id": 904972, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/fe4c5be8/uploads/origins/d5225aae-1fe1-4aa6-870b-22b5de25c4ca?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d3f61b4a05eff871a59082b0b966eba3", "srcset": "https://si.imgix.net/fe4c5be8/uploads/origins/d5225aae-1fe1-4aa6-870b-22b5de25c4ca?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d3f61b4a05eff871a59082b0b966eba3, https://si.imgix.net/fe4c5be8/uploads/origins/d5225aae-1fe1-4aa6-870b-22b5de25c4ca?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=7b79d6d73913ad7db8034535b53a4c93 2x, https://si.imgix.net/fe4c5be8/uploads/origins/d5225aae-1fe1-4aa6-870b-22b5de25c4ca?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=6e0ebd2501b0b417df0f98f15dde804e 3x"}, "duration": null, "nsfw": true, "hardcore": true, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/fe4c5be8/uploads/origins/d5225aae-1fe1-4aa6-870b-22b5de25c4ca?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=fbb5100d06d9e0694d849024c2059921", "srcset": "