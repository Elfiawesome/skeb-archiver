がって」\n「（小粋なジョーク）」\n「ギャハハハ！！」\n「（ウェディングミュージックを口笛で奏でる）」\n\n↑場に適した小粋なジョークをコロさんのセンスでお願いします！！\n様々を楽しみにしています！！！！！！", "nc": 184, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "similar_creators": [{"id": 15077, "creator": true, "nsfw_acceptable": true, "acceptable": false, "name": "性威大将軍_ITKZ🔞", "screen_name": "itoudesuyo2", "avatar_url": "https://pbs.twimg.com/profile_images/1000667609640026112/cWYvo0_f.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1000662784676216833/1590036794/1500x500", "appeal_receivable": true, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 120, "skills": [{"genre": "comic"}, {"genre": "art"}, {"genre": "novel"}, {"genre": "correction"}], "nc": 184}, {"id": 2121867, "creator": true, "nsfw_acceptable": true, "acceptable": false, "name": "桐田しらす", "screen_name": "himankadaisuk1", "avatar_url": "https://cdn.bsky.app/img/avatar/plain/did:plc:n44oku5rwbfj3w7ib36eq7if/bafkreihlqqa4jbhtsvf72y3xcoyydjnos4lphet27ayft2vddlovsjxx5e", "header_url": "https://cdn.bsky.app/img/banner/plain/did:plc:n44oku5rwbfj3w7ib36eq7if/bafkreihsot3va2qmmpkpky73dbqovqad422cu7r2ufvby5zll5pqm7tmce", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "art"}], "nc": 161}, {"id": 2644226, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "飴宮めめ＠依頼募集中", "screen_name": "ame_rino", "avatar_url": "https://proxy.misskeyusercontent.jp/avatar.webp?url=https%3A%2F%2Fmedia.misskeyusercontent.jp%2Fio%2Fb814b1cf-c8e5-4741-8677-0e493c24bad7.png%3Fsensitive%3Dtrue&avatar=1", "header_url": null, "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requeste