a-9959-c77f6673dfc5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8f7af62868c09ae03b6cf78ab58bf9be", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/10f328ad/uploads/origins/98a3d7cd-cecf-41fa-9959-c77f6673dfc5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=488b73298f3cca24dfbe4d8af1711fab", "src_set": ""}, "body": "VtuberのAnnyの複数プレイえっちイラストをお願いします\n服装や髪は新verの銀髪の方でお願いします\n服装はデフォルト衣装でどこまで脱がせるかはお任せします\n花柄のニーソだけは履いたままでお願いします（裸にニーソでも大丈夫です）\n竿役複数の３P・４Pプレイ\n太ももフェチなので太ももは見える構図でお願いします\nよろしくお願いいたします。\n\n参考資料\nhttps://virtualyoutuber.fandom.com/wiki/Anny/Gallery", "nc": 176, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@seynyuuupan/works/13", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/846d514a/uploads/origins/d3b9ebd3-992d-465e-b015-9b8102960feb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=6c921257b89741a9ef0e56b0d3819345", "src_set": ""}, "private": true, "genre": "art", "tipped": false, "creator_id": 3626973, "client_id": 0, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 33, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@seynyuuupan/works/12", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3626973, "client_id": 331755, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/3bb9dce3/uploads/origins/167b8cb2-101b-4872-87dd-d96a11e24287?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1285dd46f27ea27770d92975f954abb0", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/3bb9dce3/uploads/origins/167b8cb2-101b-4872-87dd-d96a11e24287?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=639933e8af675a20ea6cc8a716d10fb7", "src_set": ""}, "body": "始めまして！\n新作の中で先生の作品を見つけました！依頼させていただきます！\n\nキャラ：初月（アズールレーン）\n衣装：葉月の恋模様（URLの着せ替え画像を参考にしてください。上着は無しでお願いします）\nシチュ：先生の作品のhttps://www.pixiv.net/artworks/132458579のような乱交シーン。\n要望：①初月は元ネタより盛ってください。\n　　　②相手はおじ達でアへ顔で感じまくっている。\n　　　③上の水着は外側にずらされておっぱい露出。下はずらし挿入で身体中精液塗れ。オマンコからも中出し精液を溢れさせながら犯されている。\n\n以上になります。要望が多いですが目に留まりましたらよろしくお願いします。\n\n参考資料：https://azurlane.wikiru.jp/?%E5%88%9D%E6%9C%88", "nc": 56, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@seynyuuupan/works/11", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3626973, "client_id": 0, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/ab2a8511/uploads/origins/b88e57f2-83c4-4467-ad21-fc87a0410938?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d1390ecaebb0be0535dccba15bd56e73", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/ab2a8511/uploads/origins/b88e57f2-83c4-4467-ad21-fc87a0410938?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ef55caa6b85db20bb55f75850e495c7b", "src_set": ""}, "body": "お疲れ様です。\n以前より生乳ぱん様の素敵なイラストをよく拝見しており、今回リクエストをさせていただきます。\n\n【キャラクター】\n黒埼ちとせ(シンデレラガールズ より)\n【その他要望】\nございません。表情やポーズ等、先生の気の向くままに描いていただければそれが私の楽しみとなります。\n衣装もご自由に定めていただいて構いませんが、もし迷われるのであれば、\n・SSRカード【緋薔薇の令嬢】特訓前(黒いセーラー服の上から赤いカーディガンを羽織った姿)\n\n上記をお描きいただければと思います。(おやまは程よく大きめに描いていただいて大丈夫です！先生の描かれるおっぱい加減、大好きです。いつもありがとうございます。\n資料URLの欄に、「デレマスカードギャラリー」様の該当SSRページのリンクを貼らせていただきますのでご活用ください。\n\nお忙しいかとは思いますが、お受けいただければ幸いの限りです。\nよろしくお願いいたします。\n\nhttps://imas.gamedbs.jp/cg/idol/detail/207?h=imcgss-c1877", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_sa