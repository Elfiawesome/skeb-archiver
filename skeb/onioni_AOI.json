ることになる。\n後ろからのセックス、座ってキスするセックス、騎乗位でのセックスもお願いします。\n彼女の卵子が受精するショットも入れてくれたら最高です。\nありがとう。\n\nhttps://files.catbox.moe/yqf39l.png", "nc": 48, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@onioni_AOI/works/104", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/351d92aa/uploads/origins/a408f92d-6737-46ce-9cae-2735b63ba0eb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=3171f8e22a0ee8acc1d45373e52452bd", "src_set": ""}, "private": true, "genre": "art", "tipped": true, "creator_id": 24603, "client_id": 3692513, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 177, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@onioni_AOI/works/103", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/eb9e831f/uploads/origins/683245f0-1cdb-4c99-a5b2-d3f02518a1d9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=e6a1ce23f2d92ecfe5799e51cb1af473", "src_set": ""}, "private": true, "genre": "art", "tipped": true, "creator_id": 24603, "client_id": 0, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 161, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@onioni_AOI/works/102", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 24603, "client_id": 484415, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/f58beeab/uploads/origins/c700b28b-26bb-4e67-b518-ae2bdd23e182?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ffc39cab45f4b0ad46d11a6d2e592137", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/f58beeab/uploads/origins/c700b28b-26bb-4e67-b518-ae2bdd23e182?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=fc6c12b897097225633fdf9bf09103f0", "src_set": ""}, "body": "いつもお世話になってます！\nもしよろしければ今回は、ミュルジスのNTRをお願い致します！\n\nシチュ\n生態課の飲み会に参加していたミューちゃん。ヤリチン新人に潰されてラブホで泥酔浮気ックス。\nその際のハメ撮りをネタに、もう一度セックスを強要される……という感じでお願いします！\n\n飲み会の翌日、記憶を飛ばして二日酔いで出社したミューちゃん。\n\n「主任、ちょっと話があるのでこちらへ……」\n\n「どうしたの？何か相談事？」と新人くんの後をついていく。\n人気のない会議室に案内され、スマホを見せられる。そこには、ベッドの上で乱れるミューちゃんの姿が。\n何これ……！と新人くんに喰ってかかるミューちゃん。昨晩、最近彼氏のドクターが相手してくれないと愚痴っていたから、それを解消してあげただけですよ。お酒に多少媚薬を盛りましたが、それだけでこんな風になっちゃうなんて俺たち身体の相性最高ですね♡と新人くん。\nミューちゃんは、種族的に環境の変化に敏感だから、媚薬が聞きやすかっただけ。卑怯な行いだ、身体の相性なんて関係ない。動画を消してくれと言う。\nしかし、新人くんはじゃあもう一度身体の相性を確かめましょう。一度もイかなかったらコレは媚薬のせいって事で動画消しますよ……と言う事で、ラブホにてセックスをする事になった2人。\nテクニシャンな新人の愛撫ですぐイかされそうになるミューちゃん。しかしその度に寸止めされ、その状態を1時間繰り返した後、イってはいないものの息も絶え絶えなミューちゃんの前に、流石主任、やっぱ身体の相性微妙だったかな？なんて白々しく言いながら、挿入すればミューちゃんの胸の下ぐらいまで届きそうな程大きいクランタ特有の巨根を取り出す新人くん。\n\n途轍もない巨根から目が離せなくなるミューちゃん。そんな様子を見て、必死すぎでしょ、お\nまんこくぱくぱしちゃってるよ〜とか煽ってくる新人。そのまま激しい浮気セックスへ……\n\n的なシチュでお願いします！\n\n長々と書きましたが、描写するのはスマホを見せる辺りからでお願いします。\n以前投稿されたシーハメ撮りの構図が良かったので、酔っ払った際のハメ撮りであんな感じのミューちゃんが見れると嬉しい……！\n本番シーンはおまかせします！浮気カゼマルちゃんぐらい感じで喘いでると嬉しい！好きに改変してください！\n丸投げで申し訳ないです。\nよろしくお願いします！", "nc": 57, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@onioni_AOI/works/101", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/a6e2b63f/uploads/origins/556ccea0-43b1-4abe-b668-10fe7cae44cb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=b52647e8a708f8034782431ebae602b5", "src_set": ""}, "private": true, "genre": "art", "tipped": true, "creator_id": 24603, "client_id": 0, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, 