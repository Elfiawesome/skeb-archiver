呪文でプログラムされ、電気の代わりに魔力で動く魔法石＝魔道具）に宿った付喪神のようなもの。\n武器は魔法で作った針。\nびっくりするほどビビりで、自分に自信がない。\n「～っす」が口癖。\n\nよろしくお願いいたします！", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Lemon_orenoyome/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 90149, "client_id": 33723, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/eaa6403f/uploads/origins/99d9303e-d045-4788-9cb9-16608ad4500d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bc0215e796d717b57a409e847b9a5cad", "srcset": "https://si.imgix.net/eaa6403f/uploads/origins/99d9303e-d045-4788-9cb9-16608ad4500d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bc0215e796d717b57a409e847b9a5cad, https://si.imgix.net/eaa6403f/uploads/origins/99d9303e-d045-4788-9cb9-16608ad4500d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e5656d7d3fad85fd6683095f95fe6460 2x, https://si.imgix.net/eaa6403f/uploads/origins/99d9303e-d045-4788-9cb9-16608ad4500d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=4a8838874f59f17d959b84bae0a8fc4c 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/eaa6403f/uploads/origins/99d9303e-d045-4788-9cb9-16608ad4500d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6329a38630f1603cc592e82e5c420828", "srcset": "https://si.imgix.net/eaa6403f/uploads/origins/99d9303e-d045-4788-9cb9-16608ad4500d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6329a38630f1603cc592e82e5c420828, https://si.imgix.net/eaa6403f/uploads/origins/99d9303e-d045-4788-9cb9-16608ad4500d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=dad8f7bad739ffbbf6689827474bdc81 2x, https://si.imgix.net/eaa6403f/uploads/origins/99d9303e-d045-4788-9cb9-16608a