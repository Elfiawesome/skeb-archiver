: "image", "creator_acceptable_same_genre": true}, {"path": "/@Lemon_orenoyome/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 90149, "client_id": 246433, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/e29205a7/uploads/origins/5d3823b5-8fd2-487e-8a9a-37fc525107f2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d7956c1e6046aa3c87ec4d000f9b05d1", "srcset": "https://si.imgix.net/e29205a7/uploads/origins/5d3823b5-8fd2-487e-8a9a-37fc525107f2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d7956c1e6046aa3c87ec4d000f9b05d1, https://si.imgix.net/e29205a7/uploads/origins/5d3823b5-8fd2-487e-8a9a-37fc525107f2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=aff94860081e1f707a74aaf551f2d842 2x, https://si.imgix.net/e29205a7/uploads/origins/5d3823b5-8fd2-487e-8a9a-37fc525107f2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=0916e44d505bf4acd1f3f5af864ff95e 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/e29205a7/uploads/origins/5d3823b5-8fd2-487e-8a9a-37fc525107f2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=92df48ef1b60eb0ca8ee1d8efd6973f1", "srcset": "https://si.imgix.net/e29205a7/uploads/origins/5d3823b5-8fd2-487e-8a9a-37fc525107f2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=92df48ef1b60eb0ca8ee1d8efd6973f1, https://si.imgix.net/e29205a7/uploads/origins/5d3823b5-8fd2-487e-8a9a-37fc525107f2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=e14528ae4cdfa4f058959110b94e24c3 2x, https://si.imgix.net/e29205a7/uploads/origins/5d3823b5-8fd2-487e-8a9a-37fc525107f2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=46222cd745cdd41fa935e2c391d075a7 3x"}, "body": "こちらでは始めまして、地底と星と申します。\n描かれていらっしゃるイラストはもちろんロゴやＵＩデザイン、フォントなども好きでして！\nこの度リクエストを送らせて頂きました。\n当方のオリジナルキャラクター【ふわふわ蒸気機関いぬ】をモチーフにしたロゴをお願いしたくリクエストを送らせて頂きます。\n\n【キャラについて】\n・眼鏡/褐色/犬耳/スチームパンク風のアンドロイドです（資料URL有）ｷｯﾁﾝｶｰ兼図書館を持っています。\n・ジョブはメイン司書、ｻﾌﾞに錬金術師・料理人です\n・いぬの体と人の身体があります\n・木炭で動きます\n\n【所属先】最終図書館（植物園）神様が夢見た世界の管理所。世界は書物の姿で具現化されることから図書館の名がついた。最終図書館はながれゆく物語を収集している。他の図書館の司書と違って無数の物語を渡り歩き道具を流通させることを神様から許されている。司書達は全てなんらかの職人・商売人であり、それぞれのスタンスを持っている為植物園同士で対立することも多い。よく言えば個人を尊重し、悪く言えば協調性0の移動図書館。他の組織と協力することもある。\n\nその移動図書館の車やメニュー道具に使われるロゴ、という想定で考えていただけると幸いです。\n用途として個人観賞及び定期更新ゲームなどに参加時に使用したいと考えております（もちろんその際にはきちんとクレジット記載を行います）\n\nご縁がありましたら、何卒よろしくお願い申し上げます！\n\nhttps://drive.google.com/drive/folders/1qyB47XHVUn3jvY1zr2D-lrfDSZ7tjq_G?usp=sharing", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Lemon_orenoyome/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 90149, "client_id": 1994998, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/a764367f/uploads/origins/dd9d56cd-36f0-49b7-a2e9-fe3ff766c784?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9880584eb116647ce3bda0cb4cefcdb5", "srcset": "https://si.imgix.net/a764367f/uploads/origins/dd9d56cd-36f0-49b7-a2e9-fe3ff766c784?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9880584eb116647ce3bda0cb4cefcdb5, https://si.imgix.net/a764367f/uploads/origins/dd9d56cd-36f0-49b7-a2e9-fe3ff766c784?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f36481e18156bf50213415f3b2c202e5 2x, https://si.imgix.net/a764367f/uploads/origins/dd9d56cd-36f0-49b7-a2e9-fe3ff766c784?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=12a7e184f72c029e9365231bbd4af414 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/a764367f/uploads/origins/dd9d56cd-36f0-49b7-a2e9-fe3ff766c784?bg