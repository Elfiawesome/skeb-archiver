458\n\nラピちゃまの身長は110cmくらい(本人談)\nhttps://www.youtube.com/live/U6vFF0fErHY?t=3055s\n\n【その他】\n・身長は補足情報として記載させていただきましたが、身長差のイメージから逸脱しすぎない範囲であれば力さん様のご判断のもと自由に設定していただいて問題ございません。\n・背景を描いていただける場合、人物のみの透過PNG又はレイヤー分けされたPSDをいただけますと幸いです。\n・希望が複数人イラストとなってしまうので金額が見合わない場合再送依頼いただけますと幸いです。\n\n以上、長文となってしまい恐縮ですがご検討いただけますと幸いです。", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@tfmkbokrtrmn/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2823026, "client_id": 2825410, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/72284b41/uploads/origins/06a8fa78-429c-42bf-92d7-84d80206051e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f94735e42429aaf240dcbc6ea958670d", "srcset": "https://si.imgix.net/72284b41/uploads/origins/06a8fa78-429c-42bf-92d7-84d80206051e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f94735e42429aaf240dcbc6ea958670d, https://si.imgix.net/72284b41/uploads/origins/06a8fa78-429c-42bf-92d7-84d80206051e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=814ac641017d490d5c24d4362d6f3315 2x, https://si.imgix.net/72284b41/uploads/origins/06a8fa78-429c-42bf-92d7-84d80206051e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=93675209438189e430abf3f989b68057 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/72284b41/uploads/origins/06a8fa78-429c-42bf-92d7-84d80206051e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=104384cf6a97437860357366d33f6976", "srcset": "https://si.imgix.net/72284b41/uploads/origins/06a8fa78-429c-42bf-92d7-84d80206051e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=104384cf6a97437860357366d33f6976, https://si.imgix.net/72284b41/uploads/origins/06a8fa78-429c-42bf-92d7-84d80206051e?bg