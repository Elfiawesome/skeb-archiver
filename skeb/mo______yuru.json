art", "tipped": true, "creator_id": 3323260, "client_id": 2845547, "nc": 0}, {"path": "/@mo______yuru/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3323260, "client_id": 389303, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/320e60b4/uploads/origins/9c685495-ffc5-4ff5-ba2f-300291f4496c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d67b3c2708a1af4feb8df40455b25c40", "srcset": "https://si.imgix.net/320e60b4/uploads/origins/9c685495-ffc5-4ff5-ba2f-300291f4496c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d67b3c2708a1af4feb8df40455b25c40, https://si.imgix.net/320e60b4/uploads/origins/9c685495-ffc5-4ff5-ba2f-300291f4496c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=8044f89d3661fa130230da7f86a770af 2x, https://si.imgix.net/320e60b4/uploads/origins/9c685495-ffc5-4ff5-ba2f-300291f4496c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e0e3ccec50b2976a75dcd1fb81944584 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/320e60b4/uploads/origins/9c685495-ffc5-4ff5-ba2f-300291f4496c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3eba8291b1207ef9adac333374176c8b", "srcset": "https://si.imgix.net/320e60b4/uploads/origins/9c685495-ffc5-4ff5-ba2f-300291f4496c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3eba8291b1207ef9adac333374176c8b, https://si.imgix.net/320e60b4/uploads/origins/9c685495-ffc5-4ff5-ba2f-300291f4496c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=6bb925f0309cac103eadbd971de6e528 2x, https://si.imgix.net/320e60b4/uploads/origins/9c685495-ffc5-4ff5-ba2f-300291f4496c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=b338c70cc6d61197bd62ecd8b6605ff8 3x"}, "body": "お疲れ様です！ミニキャラを描いていただきたくリクエストに参りました。\n内容としましては、私の代理キャラを描いていただきたいです。\n金額が相応でなければ、お手数ですが再送信お願いします。\n\n\n◾︎リクエスト内容\n枚数┊︎3枚\n等身┊︎三等身×1　ちいさめ×2 \n用途┊︎SNSのアイコン、KPコマなど\n装飾┊︎思いつかなかったので有無任せます\n\n\n◾︎デザインについて\n○三等身\n明治･大正時代っぽい和風の雰囲気でお願いしたいです！\n希望を出すのであれば、ズボンよりもスカートだとより嬉しいです。ポーズはお任せします！\n\n○ちいさめ1\n普段私がよく描くスーツでお願いしたいです！\n特徴は下記に記載しておきます。こちらもポーズはお任せします！\n\n○ちいさめ2\n服装からポーズまで、燃ゆさんの好きなようにしていただければと思います！思うがまま描いてください！\n\n\n◾︎代理キャラ基本情報\n・暗青(ほぼ黒)→襟足のみ青のウルフカット\n・猫目ダイヤ型の瞳孔、色は黄色\n・上まぶたに大きめのまつ毛1つ\n・右目は髪で隠れてる。眼帯あると嬉しい！\n・口は猫みたいなことが多い→ω. 左下にホクロ\n・丸いピアスをしてる(色は気分)\n・おばけﾁｬﾝｽﾞは基本3匹いますが、連れてなくても問題ないです！\n\n○スーツ情報\n・グレーシャツ、黒ベスト、パンツ、パンプス\n・ベストは後ろが燕尾になっていて、裏地が青\n・両腕にアームバンド\n・ベストに右ポケットから懐中時計のチェーンがボタンについてる\n\n\n◾︎参考画像URL\nhttps://x.com/yuzuuu72/status/1885279814921445745?s=46&t=FZhF3-9WFr81LgBbvTEOrA", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@mo______yuru/works/4", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/bc62cadf/uploads/origins/ee236cd9-3443-4b46-bafa-cea6cbda2f6a?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=f4a545b2235d568f8f4462f1f34f4b79", "srcset": "https://si.imgix.net/bc62cadf/uploads/origins/ee236cd9-3443-4b46-bafa-cea6cbda2f6a?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=f4a545b2235d568f8f4462f1f34f4b79, https://si.imgix.net/bc62cadf/uploads/origins/ee236cd9-3443-4b46-bafa-cea6cbda2f6a?bg=%23fff&fm=webp&auto=compress&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=d7928ad1176e1302135ef012c303ed1d 2x, https://si.imgix.net/bc62cadf/uploads/origins/ee236cd9-3443-4b46-bafa-cea6cbda2f6a?bg=%23fff&fm=webp&auto=compress&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtal