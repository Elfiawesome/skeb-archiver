200&s=049f0a829c6e80ec70685e88aa2e9d56, https://si.imgix.net/312b11e8/uploads/origins/f9c5158b-e5ce-4b8c-877b-ae9f0f5438ac?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=6e49d59b2e07a25b26b770fd6c1f8fa5 2x, https://si.imgix.net/312b11e8/uploads/origins/f9c5158b-e5ce-4b8c-877b-ae9f0f5438ac?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=39a2a183bf94d76c5277f5609a20ba3a 3x"}, "body": "はじめまして。体格差のあるふた×ショタ作品を以前から拝見させていただいています。\n「ふたなり巨女のオナホにされる刑」がある社会で、刑の執行人のふたなり巨女にショタがモノ扱いされて犯されている作品をお願いできればと思います。以下キャラなどの詳細です。\n\n【執行人のふたなり巨女】\n・顔は以前描かれていたアルトリアのような、キリッとした厳しい美人顔\n・髪は https://www.pixiv.net/artworks/112156097 の尾張の三つ編みを無くしてショートカットにしたような感じ\n・体付きは https://www.pixiv.net/artworks/107946551 で描かれたメロリーヌくらいの、筋肉質で巨乳な褐色肌\n・玉付きズル剥けの巨根\n・ショタとの身長差は https://twitter.com/misokatsuoden/status/1710525682235936901 こちらくらいか、もう少しショタが小さいくらいでも\n・服については全裸で\n\n【ポーズや雰囲気など】\n・やや斜め前くらいの視点で、膝立ちになった執行人がショタの胴体を腕ごとがっしり両手で掴んで、文字通り処刑するように乱暴にふたなりペニスをぶちこんでる感じ\n・執行人が膝立ちの高さでも、ショタの足は全然地につかない\n・セリフはあってもなくても構いませんが、付ける場合は「男性搾精士とふたなりお姉さん」のふたなりお姉さんのような口調でお願いします\n・複数ポーズや差分が可能であれば、お任せで追加していただければ\n\nご検討いただけると幸いです。よろしくお願いいたします。", "nc": 168, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 428243, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "品門ろんぐ@Long28", "screen_name": "uminequadrillio", "avatar_url": "https://pbs.twimg.com/profile_images/1901292542970433536/0xmnc4Y1.jpg", "header_url": "https://pbs.twimg.com/profile_banners/461148075/1742138372/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "art"}, {"genre": "comic"}, {"genre": "correction"}], "banned": false, "nc": 176}, {"id": 1112035, "creator": true, "nsfw_acceptable": true, "a