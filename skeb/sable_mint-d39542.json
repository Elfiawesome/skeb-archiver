%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=cdd520ad4a646cf22c583d1ae409e3ea 2x, https://si.imgix.net/2c17e098/uploads/origins/8afeab85-8363-4bbc-baf4-f56f3c41d510?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=92a17925202028abe1af45864e0f1170 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/2c17e098/uploads/origins/8afeab85-8363-4bbc-baf4-f56f3c41d510?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=00edcdc4d4e41ec3570b293121f6474a", "srcset": "https://si.imgix.net/2c17e098/uploads/origins/8afeab85-8363-4bbc-baf4-f56f3c41d510?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=00edcdc4d4e41ec3570b293121f6474a, https://si.imgix.net/2c17e098/uploads/origins/8afeab85-8363-4bbc-baf4-f56f3c41d510?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=fa810c556c2e441e5d2a5b8b40948ab6 2x, https://si.imgix.net/2c17e098/uploads/origins/8afeab85-8363-4bbc-baf4-f56f3c41d510?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=d078ec307f9a11a46b77c1d000b160e4 3x"}, "body": "🌿min10🌿さま\n\nはじめまして。\n個人VTuberの天絆ささはと申します。\n\nmin10様の描かれた表情豊かで可愛さ溢れる風真いろはちゃんのイラストに一目惚れしまして、昨年から楽しく拝見しておりました…！\n今回、もしよろしければ僭越ながら私自身を描いていただきたくリクエストをお送りします。\nご検討いただけますと幸いです。\nどうぞよろしくお願いいたします。\n\n□リクエスト内容\n天絆ささは の1枚絵イラスト\n\n特に好みのイラスト：\nhttps://x.com/sable_mint/status/1618186006561443840\nhttps://x.com/sable_mint/status/1670084590055350272\nhttps://x.com/sable_mint/status/1644997267584339971\n\n動き付けのあるもの、またリスナーネームでありキャラクター化した小さなパンダの｢ささのこ｣を愛でていただけますととても嬉しいです。\n\nささのこさんイメージ：\nhttps://x.com/akizuki44/status/1717556700839022974\nhttps://x.com/ntteate338/status/1732776445238522019\n\n詳細図をまだ公開しておらず、参考となりますが、頭上から笹の葉付きのたけのこが生え、耳にお揃いの羽＆首元にお揃いのバンダナがついています。その他ご想像にお任せいたします…！\n\n□使用用途\nVTuber活動内にて使用させて頂きます。\nグッズ化等は行いません。\n\n□人物について\n143cmのパンダの女の子で、表情豊かなですがやや恥ずかしがり屋な性格です。タンカー×ヒーラーの役割を担っており、大きな盾を背負うため太ももがもちっとしています。\n\n資料は、HP下部を参照願います。\n特に、目の光がパンダ型、髪とまつ毛の毛先が緑色、羽と耳の間にチャームポイントの羽毛が入ります。\n\n□おねがい事項\n・人物と背景を分けた状態(PSDor透過PNG)で納品願います。\n・頭部や髪、腕が見切れない構図ですと、使用時の自由度が高まるためとてもありがたいです。\n\n最後までお読みくださりありがとうございます…！\nご検討のほど、よろしくお願いいたします。\n\n天絆ささは\n\nhttps://lit.link/amatsuna338", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@sable_mint/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2292479, "client_id": 2429509, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/524ff071/uploads/origins/c6686f92-5232-48d7-baff-9b154aaa2868?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f6e59ad4746705e4e30c7ec5796364f9", "srcset": "https://si.imgix.net/524ff071/uploads/origins/c6686f92-5232-48d7-baff-9b154aaa2868?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f6e59ad4746705e4e30c7ec5796364f9, https://si.imgix.net/524ff071/uploads/origins/c6686f92-5232-48d7-baff-9b154aaa2868?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=852872829185d95c26ed43fee901ae40 2x, https://si.imgix.net/524ff071/uploads/origins/c6686f92-5232-48d7-baff-9b154aaa2868?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=5286aa1b51d25d985144f9f97b8a2fc9 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/524ff071/uploads/origins/c6686f92-5232-48d7-baff-9b154aaa2868?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0449a4d6f846fd3dcf302f72a08f73d2", "srcset": "https://si.imgix.net/524ff071/uploads/origins/c6686f92-5232-48d7-baff-9b154aaa2868?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0449a4d6f846fd3dcf302f72a08f73d2, https://si.imgix.net/524ff071/uploads/origins/c6686f92-5232-48d7-baff-9b154aaa2868?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=52f6770d320a955805f9d1ed9a269ea4 2x, https://si.imgix.net/524ff071/uploads/origins/c6686f92-5232-48d7-baff-9b154aaa2868?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=5413f4a9685c030a42d77397d51d1391 3x"}, "body": "はじめまして、個人Vtuberのベリル・ヴィランと申します。 \nポートフォリオを拝見し、是非私を描いて頂きたくリクエストしました！\n特に沙花叉クロヱさんのイラストが素敵だなと感じました！\nキャラクター資料はドライブにて添付いたします。 https://drive.google.com/drive/folders/1XtEgSQ_RhZFCIRac6AYcAQ-G29xwNLrL?usp=share_link  \n\n【使用目的】 \nSNSへの投稿、YouTube、ネットプリント、ファンボックスに使用させていただきたいです。 \n\n【構図、表情、服装等】 \n服装はサイバーパンクっぽさがあるスポーティなアウターとインナーでお願いします。（ぶいすぽの猫汰つなさんの衣装がイメージに近いです。）\n構図は、顔が正面を向いていればあとはおまかせいたします。\n髪型は添付した人間体をベースに、角や王冠、横の燃えている髪は無しでお願いいたします。\n表情もお任せいたします。\n\nサイズもお任せいたします、人物や背景などを分けたPSDで納品頂けますと幸いです。\n\n お忙しいとは思いますが、ご検討よろしくお願いいたします！！", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@sable_mint/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2292479, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/35b195b2/uploads/origins/7343992f-1d39-4bcf-baed-fdaede3f5087?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=aafed6753f745c830016e307097d7f02", "srcset": "https://si.imgix.net/35b195b2/uploads/origins/7343992f-1d39-4bcf-baed-fdaede3f5087?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=aafed6753f745c830016e307097d7f02, https://si.imgix.net/35b195b2/uploads/origins/7343992f-1d39-4bcf-baed-fdaede3f5087?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=3cca92a52bb8f24afaae0aab202d6870 2x, https://si.imgix.net/35b195b2/uploads/origins/7343992f-1d39-4bcf-baed-fdaede3f5087?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ec3f000f092e31cc2df7f2be28f2a4ba 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {