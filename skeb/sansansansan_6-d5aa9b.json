ラストを気に入って依頼させてもらってます\n\n依頼内容は、\nFate stay nightの凛が、桜から\n姉妹の和解の証として蟲姦の手解きを受け、幸せな妊娠出産を経験する、という内容でお願いします。\n\n二人ともの楽しかったり嬉しかったりを押し出してもらえたら嬉しいです\n\n枚数やプレイの展開の内容は、値段相応と思う範囲でやってもらって構いませんし、展開上めんどくさいなどあれば、妊娠出産の部分は省いてもらって構いません\n\nキャラが二人になるので、\nもし負担が大きくなるというのでしたら断ってもらって構いません", "nc": 58, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@sansansansan_6/works/17", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/b881e687/uploads/origins/70d62062-d3f7-4ba7-887f-6a48cb42e15e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=05d4fd0a439198eb15fc0168e04d9fdd", "srcset": "https://si.imgix.net/b881e687/uploads/origins/70d62062-d3f7-4ba7-887f-6a48cb42e15e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=05d4fd0a439198eb15fc0168e04d9fdd, https://si.imgix.net/b881e687/uploads/origins/70d62062-d3f7-4ba7-887f-6a48cb42e15e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=93218fc88384f6ee245ad88af176b788 2x, https://si.imgix.net/b881e687/uploads/origins/70d62062-d3f7-4ba7-887f-6a48cb42e15e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=6a875cfa31153f0323023ecf3df8793e 3x"}, "private": true, "genre": "art", "tipped": false, "creator_id": 1384859, "client_id": 562518, "nc": 162}, {"path": "/@sansansansan_6/works/16", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1384859, "client_id": 121946, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/efb0257d/uploads/origins/0394f870-6a60-4096-b40c-251