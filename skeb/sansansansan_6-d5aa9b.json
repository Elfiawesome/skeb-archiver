alusuke/list/Shichiten3/Shichiten082.html", "nc": 42, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@sansansansan_6/works/15", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1384859, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/2a0b1284/uploads/origins/8d9f57f8-64b0-420d-ba9f-93a1f5da7c0b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e6e4860da7a964894461c0ab399381cc", "srcset": "https://si.imgix.net/2a0b1284/uploads/origins/8d9f57f8-64b0-420d-ba9f-93a1f5da7c0b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e6e4860da7a964894461c0ab399381cc, https://si.imgix.net/2a0b1284/uploads/origins/8d9f57f8-64b0-420d-ba9f-93a1f5da7c0b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a283353b4e59d24268e4a7fa95597c6e 2x, https://si.imgix.net/2a0b1284/uploads/origins/8d9f57f8-64b0-420d-ba9f-93a1f5da7c0b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=782a66f18d43697a01dcca313616ea12 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/2a0b1284/uploads/origins/8d9f57f8-64b0-420d-ba9f-93a1f5da7c0b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=4e6c37b25aea91f6ea76560dbe533a85", "srcset": "https://si.imgix.net/2a0b1284/uploads/origins/8d9f57f8-64b0-420d-ba9f-93a1f5da7c0b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=4e6c37b25aea91f6ea76560dbe533a85, https://si.imgix.net/2a0b1284/uploads/origins/8d9f57f8-64b0-420d-ba9f-93a1f5da7c0b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=3e3cf70547b4e6e728d0312cbe11b356 2x, https://si.imgix.net/2a0b1284/uploads/origins/8d9f57f8-64b0-420d-ba9f-93a1f5da7c0b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=4e6d6efe0a41e0affcb7321208451b2f 3x"}, "body": "リクエスト\nVtuber\n・月ノ美兎\n・樋口楓\n衣装・通常服\n\nシチュ\n①右が樋口楓、左が月ノ美兎の様に。\n②プレイ内容は、男性主観視点で、樋口楓と月ノ美兎によるW髪コキご奉仕をお願いいたします。竿が二人の髪の毛で亀頭以外見えなくなる位巻いてほしいです。\n③出来れば２人にあった擬音、喘ぎ声とか会話とか入れてくれたら嬉しいです。\n④又、男性器を蟲姦に見えるような差分も作成していただいて構いません！\n\n以上、大変な依頼を出して申し訳ないですが、引き受けていただけたら幸いです。\n納得のいく創作物を出来上がることを楽しみにしております！\n\n又、キャンセルも気軽にしていただいて大丈夫です！", "nc": 57, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@sansansansan_6/works/14", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1384859, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/9f649b5b/uploads/origins/f7389203-5e3e-4d86-b8fa-f4c82b2d2a46?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=79c09d6ffe4b9edac42918509d6330a2", "srcset": "https://si.imgix.net/9f649b5b/uploads/origins/f7389203-5e3e-4d86-b8fa-f4c82b2d2a46?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=79c09d6ffe4b9edac42918509d6330a2, https://si.imgix.net/9f649b5b/uploads/origins/f7389203-5e3e-4d86-b8fa-f4c82b2d2a46?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=66aa074b461ec52e79424e6f41797f0d 2x, https://si.imgix.net/9f649b5b/uploads/origins/f7389203-5e3e-4d86-b8fa-f4c82b2d2a46?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ae0ebab93e3fc74461670fcb31904084 3x"}, "duration": null, "nsfw": true, "hardcore": true, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/9f649b5b/uploads/origins/f7389203-5e3e-4d86-b8fa-f4c82b2d2a46?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e1d801dd550044a75c390317115577cd", "srcset": "https://si.imgix.net/9f649b5b/uploads/origins/f7389203-5e3e-4d86-b8fa-f4c82b2d2a46?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e1d801dd550044a75c390317115577cd, https://si.imgix.net/9f649b5b/uploads/origins/f7389203-5e3e-4d86-b8fa-f4c82b2d2a46?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=f2cebd0a6fdf1f7aecc4613669c1a3b0 2x, https://si.imgix.net/9f649b5b/uploads/origins/f7389203-5e3e-4d86-b8fa-f4c82b2d2a46?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=c8c2f9a86080e5d9a15468edf12a6d2a 3x"}, "body": "「やがて君になる」より佐伯沙弥香\n蟲姦に加えて、百合キャラを異性愛に落ちた状況です。\n\n沙弥香は新妻っぽい裸エプロン着る。後ろから大きいゴキブリが犯す。同時に小さいゴキが片方の乳に乗って、ニプルファックしている。\n\n①彼女は小さいゴキを授乳中赤ちゃんのように母性で見守る\n②大きいゴキが交尾を始まる。彼女は子供の前にイチャイチャすることを軽く叱る。大きいのを「旦那」や「パパ」とかで呼ぶ。\n③セックス中\n④両方のゴキブリが射精する。彼女は目を閉めて「あん♡」と叫ぶけど、強いアへ顔じゃないでください。\n⑤事後に、彼女は「これは本当に女の幸せ」とかのセリフを言う。\n\nよろしくお願いします。\n\nhttp://yagakimi.com/assets/character/c3.png", "nc": 170, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@sansansansan_6/works/13", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1384859, "client_id": 131994, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/a6dadc71/uploads/origins/107994c2-6345-4e33-b119-1bda11b80fbb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=dbb7849fdf063aa633aa140591554f52", "srcset": "https://si.imgix.net/a6dadc71/uploads/origins/107994c2-6345-4e33-b119-1bda11b80fbb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=dbb7849fdf063aa633aa140591554f52, https://si.imgix.net/a6dadc71/uploads/origins/107994c2-6345-4e33-b119-1bda11b80fbb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=146a3c6d3c13477eb8ddecbf317c51a4 2x, https://si.imgix.net/a6dadc71/uploads/origins/107994c2-6345-4e33-b119-1bda11b80fbb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=59340b725ed8de2b0d7dae66b32f36f4 3x"}, "duration": null, "nsfw": true, "hardcore": true, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/a6dadc71/uploads/origins/107994c2-6345-4e33-b119-1bda11b80fbb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3ce8e0da57a795cb2eedc1258d455293", "srcset": "https://si.imgix.net/a6dadc71/uploads/origins/107994c2-6345-4e33-b119-1bda11b80fbb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3ce8e0da57a795cb2eedc1258d455293, https://si.imgix.net/a6dadc71/uploads/origins/107994c2-6345-4e33-b119-1bda11b80fbb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=7f74d9b40a477b262e1a010c5c7d0208 2x, https://si.imgix.net/a6dadc71/uploads/origins/107994c2-6345-4e33-b119-1bda11b80fbb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=1863cb05e20d899716076e53dacba832 3x"}, "body": "はじめましての依頼になります！\n【キャラ】\nシンデレラガールズよりミステリアスアイズの二人(高垣楓と速水奏)\n【内容】\n旦那様とのラブラブえっち公開ライブ。\n楓さんがゴキの極太オチンポが素敵と言うと、奏がハエの情熱的なキスがたまらないのと旦那様自慢。\nバックで激しく突かれて二人とも喘ぎながら最後は受精アクメ。\n後日、出産ショーとしてボテ腹(別窓で子宮の中)になった二人が噴乳出産アクメをキメる。\n\n上記でお願いします。", "nc": 59, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@sansansansan_6/works/12", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1384859, "client_id": 44201, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/8464bebb/uploads/origins/d670388f-a770-4cd5-ad7c-2096c962ad80?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=863cedd0b85d7eeddeb7edf0812a4c3e", "srcset": "https://si.imgix.net/8464bebb/uploads/origins/d670388f-a770-4cd5-ad7c-2096c962ad80?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=863cedd0b85d7eeddeb7edf0812a4c3e, https://si.imgix.net/8464bebb/uploads/origins/d670388f-a770-4cd5-ad7c-2096c962ad80?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ddb7a63bbf703eca2a49fa61d54ae568 2x, https://si.imgix.net/8464bebb/uploads/origins/d670388f-a770-4cd5-ad7c-2096c962ad80?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=4586b3f94f76842645ad54e88a9c5be5 3x"}, "duration": null, "nsfw": true, "hardcore": true, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/8464bebb/uploads/origins/d670388f-a770-4cd5-ad7c-2096c962ad80?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=830972dcd9aa44cc77b56e8657b4eec4", "srcset": "https://si.imgix.net/8464bebb/uploads/origins/d670388f-a770-4cd5-ad7c-2096c962ad80?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=830972dcd9aa44cc77b56e8657b4eec4, https://si.imgix.net/8464bebb/uploads/origins/d670388f-a770-4cd5-ad7c-2096c962ad80?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=66766d38a6168ff08e20c8a776687d6c 2x, https://si.imgix.net/8464bebb/uploads/origins/d670388f-a770-4cd5-ad7c-2096c962ad80?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=98f4df0a1253fc76aab3c32a721b5960 3x"}, "body": "いつもお世話になっております。\n\n再度グラブルのゼタちゃんの蟲姦イラストをお願いしたいです。\n\n内容としては、蟲姦にあたるかどうかわかりませんが極太のぶっとい注射器の中にカエルの卵やミミズ、蛆虫が入っており喜んでボテ腹になるまで注入する。\nイキながら産卵し子宮脱になる。\n子宮脱したまんこに産卵したミミズや蛆虫が戻って来てまたイキながらボテ腹になる。\n可能で有れば子宮の断面図と体に卑猥な落書きの差分をお願いしたいです。\n\n是非ご検討を宜しくお願い致します。", "nc": 186, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@sansansansan_6/works/11", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/270ccf33/uploads/origins/14532379-e6d7-4f1b-9703-dcac3bff9f15?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=68c7fe3880db34519b4a52e5eec37742", "srcset": "https://si.imgix.net/270ccf33/uploads/origins/14532379-e6d7-4f1b-9703-dcac3bff9f15?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=68c7fe3880db34519b4a52e5