つつ抵抗するも、全く敵わずお仕置きと称して\n響さんの巨根で貫かれ絶大な性欲のはけ口にされる感じでお願いします。\nなお、作品については前回までのような長いストーリーではなく、単発作品の形で大丈夫です。\n\nご検討いただけると幸いです。よろしくお願いいたします。", "nc": 56, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}], "sent_works": [], "similar_creators": [{"id": 9886, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "ぽせきちゅわん🔞", "screen_name": "psk_sk3", "avatar_url": "https://pbs.twimg.com/profile_images/2038537524919042048/iXYpFhVK.jpg", "header_url": "https://pbs.twimg.com/profile_banners/3792954865/1754008618/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 90, "skills": [{"genre": "art"}], "banned": false, "nc": 32}, {"id": 10595, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "ジョッチ＠うちの子絵描き勢", "screen_name": "jotti_reimu", "avatar_url": "https://pbs.twimg.com/profile_images/1848511549914419204/kEIqm--1.jpg", "header_url": "https://pbs.twimg.com/profile_banners/543072023/1729554472/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "art"}, {"genre": "correction"}], "banned": false, "nc": 176}, {"id": 15438, "creator": true, "nsfw_acceptable": true, "acceptable": false, "name": "瀬尾", "screen_name": "Seo_t", "avatar_url": "https://pbs.twimg.com/profile_images/1795434689903390720/2a1Pa8SF.jpg", "header_url": "https://pbs.twimg.com/profile_banners/18943388/1716901072/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 15, "complete_expiration_days": 60, "skills": [{"genre": "art"},