image_urls": {"src": "https://si.imgix.net/7260dbea/requests/203067_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=74c390bd90c92cf99aebad119a2ccfd2", "src_set": ""}, "private": true, "genre": "art", "tipped": true, "creator_id": 187644, "client_id": 562518, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 177, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@tidori_kou/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 187644, "client_id": 799766, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/9da022cc/requests/201213_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d8918d4fac9f9f0eddec127d182020da", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/9da022cc/requests/201213_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=87418fd3889b7f3e63e217b57daa5c83", "src_set": ""}, "body": "私(桜日ハル)のえっちな絵をご依頼したいです\n伝えた内容が難しかったり、わかりづらかった場合は一部内容を省略していただくか、全ておまかせします\n\n内容は\n・ふたなり(陰毛は毛深めに、おちんちんの大きさは自分の胸に届くくらいで、太さは腕より一回りか二回りほど太く、玉は一つ一つがおちんちんの太さと同じ大きさ)\n・両手でふたなりおちんちんを気持ちよさそうに扱いて、濁点のついたような汚い声を出しながら、だらしない顔で大量に射精\n・自分に精液がかかってしまっていて、顔や髪にも付いている\n・服装はメイド服か、おまかせします(メイド服の場合、おちんちんのせいでスカートが捲れ上がっている感じにしてください)\n\nというもので、もしよろしければお願いします…！\n資料はこちらのURL先の金髪メガネメイド姿の画像とそこに繋げてある画像です\n\nhttps://twitter.com/halvital396/status/1330009510308528128?s=21", "nc": 177, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@tidori_kou/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 187644, "client_id": 0, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/765768ae/requests/197607_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=01a4322a7dba8b580eaa16f13c014b08", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/765768ae/requests/197607_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=98d9ae4af0ec069f6d72789bf185d31c", "src_set": ""}, "body": "片方の手は腋毛を見せながらカメラ目線でピースサイン、もう片方の手は自分のふたなり巨根をセンズリする及川雫をお願いします。\nポーズはガニ股で、剛毛の陰毛と腋毛、表情は笑顔で、下品なオナニーを見てもらえて嬉しそうな感じで。", "nc": 49, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@tidori_kou/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 187644, "client_id": 23365, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/df270cf6/requests/195409_1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b02e11fd75728008686c3ad459e946b3", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/df270cf6/requests/195409_1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6ae7d88c08b672e68cea71b8b9e787d3", "src_set": ""}, "body": "始めまして、いつもpixivの方拝見しております。skebの募集を見たので依頼を送らせて頂きました。\n\nキャラクターなのですが、VRchatというゲームをやっていて、そこで使ってる私のアバターを描いていただけないでしょうか(資料有り)\nシチュとしてはキャラクターのおんなのこがふたなりちんぽで気持ちよく射精している姿をお願いできないでしょうか……　構図・向き等詳細は任せます\n一つだけお願いなのですが、陰毛を毛深いめに描いていただけると有り難いです\n\n御一考のほど宜しくおねがいします\n\nhttps://twitter.com/akane_alminium/status/1176521363990777856", "nc": 177, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@tidori_kou/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 187644, "client_id": 55229, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/cc20771c/requests/191625_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=86ffaa7c057af16a6cfb35aa03c28180", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/cc20771c/requests/191625_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0c6ab7d48e0d53c787585f17ef42ca25", "src_set": ""}, "body": "ToLOVEるの西連寺春菜ちゃんを以下内容でお願いします。\n・ヘアピン有\n・ふたなり\n・短小包茎(真性包茎)\n・せんずり\n・トロ顔\n・垂れ乳\n・黒乳首\n・剛毛の陰毛\n・玉袋にも毛\n・可能であればわき毛\n可能であれば以下差分\n・射精（精液の量は少なく、勢いもあまりない感じで）\n・パイパン、わき毛なし\n・整えた陰毛(pixivの「射精止まらない、みくにゃん」のような感じで)\n\n以上、要望が多く申し訳ございませんが、\nご検討くださいますようお願いいたします。", "nc": 160, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@tidori_kou/works/1", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/f3398076/requests/191466_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=76e0ba3860c607e188b67e4f5ffd6693", "src_set": ""}, "private": true, "genre": "art", "tipped": true, "creator_id": 187644, "client_id": 0, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 160, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}], "similar_creators": [{"id": 97666, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "すばるつしると🔞", "screen_name": "subarutsuchinp", "avatar_url": "https://pbs.twimg.com/profile_images/1635005971457261568/damLD8uw.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1083043741072388098/1610976585/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "skills": [{"genre": "art"}, {"genre": "nov