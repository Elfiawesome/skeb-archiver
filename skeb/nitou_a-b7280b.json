o=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=e3478415c805b8b3b04d296ddd5d0329 2x, https://si.imgix.net/780ab844/uploads/origins/0db1adfb-68c0-4726-9e1e-40ae6310aa30?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=d9b0b6490214cf9ca87d1c143af4b70a 3x"}, "body": "初めまして。アーエルと申します。\nアークナイツ関連のTLに流れてきたイラストを拝見してリクエストさせて頂きました。\n\n希望内容\nアークナイツを配信しているVtuberの四季守かとさんのイラストをお願い致します。\n特徴の 角・頭のお花・耳 ・髪型 は盛り込んで頂きたいです。\n\nこれまで、春（デフォルト）、夏の（水着）のイラストは見かけてきましたので、\n可能であれば秋の装いのイラストを希望致します。構図・シチュエーションはお任せ致します。\n頭のお花は可変式ですので、秋の花にしていただけると幸いです。\n\n加えて可能であれば、人物レイヤーが独立可能なPSDファイルでの納品を希望致します。\n\n使用用途\n・各種SNSでの非営利利用\n・希望が有れば、配信を含むVtuberさんの本人利用\n\nご参考資料\nhttps://twitter.com/shiki_traveller/status/1586279736434601984?s=20(三面図)\nhttps://twitter.com/shiki_traveller/status/1656265943369269250?s=20(稼働動画)", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@nitou_a/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 5629, "client_id": 13456, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/424dda31/uploads/origins/9e04f82a-8b89-4dc7-9e72-1ae44304a88a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=be7c6c62e80467a4081bb35bb9131b54", "srcset": "https://si.imgix.net/424dda31/uploads/origins/9e04f82a-8b89-4dc7-9e72-1ae44304a88a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=be7c6c62e80467a4081bb35bb9131b54, https://si.imgix.net/424dda31/uploads/origins/9e04f82a-8b89-4dc7-9e72-1ae44304a88a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=44adaf626a3eae80c9a2c408c29cd680 2x, https://si.imgix.net/424dda31/uploads/origins/9e04f82a-8b89-4dc7-9e72-1ae44304a88a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e186486e1db931f86c0ae44c8abc9832 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_