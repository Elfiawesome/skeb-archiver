ads/origins/d00b36b0-68bb-4e80-b526-48266c3340dc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=78869059c627bfee25394997410ada9d 2x, https://si.imgix.net/11b6f5c4/uploads/origins/d00b36b0-68bb-4e80-b526-48266c3340dc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=646bace562703a6a0ed2d7f3dce839d0 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/11b6f5c4/uploads/origins/d00b36b0-68bb-4e80-b526-48266c3340dc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5c0b4e2c054cdd00090550b69fdd0964", "srcset": "https://si.imgix.net/11b6f5c4/uploads/origins/d00b36b0-68bb-4e80-b526-48266c3340dc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5c0b4e2c054cdd00090550b69fdd0964, https://si.imgix.net/11b6f5c4/uploads/origins/d00b36b0-68bb-4e80-b526-48266c3340dc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=4db54c8be872e6263d21515cc85f43f6 2x, https://si.imgix.net/11b6f5c4/uploads/origins/d00b36b0-68bb-4e80-b526-48266c3340dc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=4ae87d6e37da7f1f4e811c52bd21c9f3 3x"}, "body": "こんにちは！あなたの絵が本当に大好きです！\n私と私の友人を描いた作品をお願いしたいです！\n\n私たちのキャラクターについて詳しく説明します：\nリュリーは内気だけど陽気な猫娘で、よく寝るのが好き。あなたの夢を見守る魔法少女です。- Lullyの参考文献：https://imgur.com/a/Qg6djDb\nShinoはドラゴンの女の子で、派手で表情豊かな性格ですが、状況によっては静かでシャイに見えることもあります。- シノ参考文献：https://imgur.com/a/GJwFx95\n\n私たちのキャラクターが服を交換しているところを描いてほしい！リュリーがシノの服を着て、シノがリュリーの服を着る。\nリュリーは照れくさそうな顔で、シノは楽しそうにちょっと笑ってるとか。他にも何かアイデアがあれば、遠慮なく実行してください！\n\nご考慮いただき、ありがとうございました。良い一日を！", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@maro2_6110/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3452618, "client_id": 1073791, "vtt_url": null, "thumbnail_image_urls": {