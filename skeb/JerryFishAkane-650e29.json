com%2Fprofile_images%2F1422555753362169870%2FJth1Yzpl.jpg?blend64=aHR0cHM6Ly9za2ViLWF2YXRhci5pbWdpeC5uZXQvfnRleHQ_&blendalpha=100&blendalign=center&blendmode=normal&blendsize=inherit&bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=9cc44d3e801fb2845b8ca6e227022c0f 3x"}, "body": "どうもはじめまして\nメスガキJSがストーカーのおっさんに躾られ、口内放尿されるお話をお願いします。\n下校中後ろをつけてくるおっさんを恐れるどころか手を出してくる勇気もないと舐めてかかり、逆に金を巻き上げてやろうと人気の無い所に誘き寄せ、見抜きさせてやるから数万を寄越せと揺する。すると興奮したおっさんに容易く押し倒され、大人の本気セックスで蕩けさせられ自分が単なるJSオナホだとわからせられてしまう。おっさんが満足するまで中出しされた後お掃除フェラをさせられ、それに飽きたらずマーキングしてやろうと口内放尿までされるが、まるで赤ん坊が哺乳瓶にちゅうちゅうと吸い付くかのように、頭を撫でられながらうっとりとした表情で言われるがままに一滴残らず飲み干し身も心も服従してしまうというもので。\nご検討のほどよろしくお願いいたします。", "nc": 168, "word_count": 5482, "transcoder": "text", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 88997, "creator": true, "nsfw_acceptable": true, "acceptable": false, "name": "喚く狂人", "screen_name": "wamekukyouzin", "avatar_url": "https://pbs.twimg.com/profile_images/1523919665881223169/pDGZP0X1.png", "header_url": "https://pbs.twimg.com/profile_banners/76592074/1520415049/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 90, "skills": [{"genre": "novel"}], "banned": false, "nc": 33}, {"id": 123927, "creator": true, "nsfw_acceptable": true, "acceptable": false, "name": "黒胡椒", "screen_name": "kurokosyou50", "avatar_url": "https://pbs.twimg.com/profile_images/1201549367569608704/R-dTMw5Q.png", "header_url": "https://pbs.twimg.com/profile_banners/915209088371277824/1572633179/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "art"}, {"genre": "novel"}], "banned": false