": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/9d64de10/uploads/origins/87ef9370-ce41-4acf-a2af-d2b9e37732e2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=53eda84e6ac7db07c311b2b2e98f48de", "srcset": "https://si.imgix.net/9d64de10/uploads/origins/87ef9370-ce41-4acf-a2af-d2b9e37732e2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=53eda84e6ac7db07c311b2b2e98f48de, https://si.imgix.net/9d64de10/uploads/origins/87ef9370-ce41-4acf-a2af-d2b9e37732e2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=1ba6184834dad79a64f9c1174d30d5b5 2x, https://si.imgix.net/9d64de10/uploads/origins/87ef9370-ce41-4acf-a2af-d2b9e37732e2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=9bdf875f57b0baa91fc1066355af7521 3x"}, "body": "はじめまして、リクエスト失礼します！\nもしよろしければ、私の創作キャラクターを描いていただけないでしょうか。\n依頼したいのはこの子です\n黒崎梟羽　[兄][184cm]\n長男。明るい性格で、思うままに動くカーレーサー、他人に縛られるのが苦手。大学時代は友人と短い間バンドを組んでおり、家族の事情によってで大学では金融を専攻していましたが、卒業間際に急に自分の好きなことしかやりたくないようになり、卒業後は両親の希望通りに企業に就職せず、カーレーサーになった。この一件によって、両親とは縁を切って、自分で暮らすようになった。現在は何人かの友人とルームシェアーをしており、両親とは連絡を取らないが、弟とはたまに連絡を取っている。\n【リクエスト内容】\n·今回はキャラクターの新しい服のデザインお願いしたいと思います。\n·できれば、モダンな服装や、ドライブにぴったりな服、ロックなスタイルなどを彼のためにデザインしてあげたいものです。\nお受けになる場合も、お受けにならない場合も、ここまでお読んでいただき、誠にありがとうございます。\n引き続きよろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/1ezHGgugY7RUnmPbBR-n0fP1MTYUpok4_", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@Ochacha239/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2678263, "client_id": 2413572, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/c83ea9bb/uploads/origins/67459c38-6009-4b1f-9a1a-6f2bf05dccde?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8401a7fe3ba78f82297011b2cd771b3e", "srcset": "https://si.imgi