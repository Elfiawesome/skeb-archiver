置は少し煽り視点でおねがいします\n・サイズは1920px×1080px（動画でよく使われるサイズ）にしていただけると助かります。\n・動画に使用するので、サインあり・なしの差分を用意してくださると助かります。\n\n－－－－－－－－－－－－－－－－－－－－\n\nもしリクエスト内容が少しでも難しいと感じましたら、お気軽に再送やキャンセルして頂いても構いません。\n以上よろしくお願いします。", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@mo_kiduti/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2569073, "client_id": 2646192, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/b8efe369/uploads/origins/b793e2f8-3155-460f-b713-527eed73cc69?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9497b9008007ae5730197b1d6d192adf", "srcset": "https://si.imgix.net/b8efe369/uploads/origins/b793e2f8-3155-460f-b713-527eed73cc69?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9497b9008007ae5730197b1d6d192adf, https://si.imgix.net/b8efe369/uploads/origins/b793e2f8-3155-460f-b713-527eed73cc69?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=9696232a5e47140538bce9e22df08a6f 2x, https://si.imgix.net/b8efe369/uploads/origins/b793e2f8-3155-460f-b713-527eed73cc69?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=677fd40966e44b14dbd85ab6c0210bde 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/b8efe369/uploads/origins/b793e2f8-3155-460f-b713-527eed73cc69?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6792931eed9da8f3ad754aae60a8790f", "srcset": "https://si.imgix.net/b8efe369/uploads/origins/b793e2f8-3155-460f-b713-527eed73cc69?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6792931eed9da8f3ad754aae60a8790f, https://si.imgix.net/b8efe369/uploads/origins/b793e2f8-3155-460f-b713-527eed73cc69?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=61525522ab235044c785a6a64