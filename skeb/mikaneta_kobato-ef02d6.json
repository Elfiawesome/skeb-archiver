式のチョーカー\n・片腿に赤の細リボン\n・中央上部に赤の小さなリボン付き白のアンダースコート\n※服等の色は変えても全然構いません\n\n服か髪のどこかに、資料ＵＲＬの自由惑星同盟軍のマーク（ベレー帽に付いてる青地に金色の星です）を付けています\n\n\n●表情\nカメラ目線＆元気一杯の笑顔\n\n\n詳細は一任です\n可能であればお願いします\n\n●●●キャライメージ\n田中芳樹先生の神作「銀河英雄伝説」の、二次創作キャラです\n田中先生申し訳ございません\n\n名：ヤン・ヤマタ・フォン・ローエングラム\n\nユリアン＋フレデリカ＋シェーンコップ＋ヒルダ＋オフレッサー＋ＳＷのルークなキャラです\n地球教が、ヤンやルドルフ等の優良遺伝子を合成した人工の天才です\nヤン亡き後の共和政府軍を率い、自由惑星同盟を再興します\n\nhttps://gineiden-anime.com/goods/tapes_yang.jpg", "nc": 32, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}], "similar_creators": [{"id": 110116, "creator": true, "nsfw_acceptable": true, "acceptable": false, "name": "いぶお/IBUO", "screen_name": "ibukht1015", "avatar_url": "https://pbs.twimg.com/profile_images/1893682720770785280/s6jxVN38.jpg", "header_url": null, "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "skills": [{"genre": "art"}], "nc": 177}, {"id": 1595544, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "Kiraboshi🎨", "screen_name": "Kiraboshi5201", "avatar_url": "https://pbs.twimg.com/profile_images/1966505987344633856/o484DEEI.jpg", "header_url": "https://pbs.twimg.com/profile_banners/731774890450132992/1757686539/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 10, "skills": [{"genre": "art"}, {"genre": "correction"}], "nc": 33}, {"id": 2314056, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "KAZUKIDA🍎🐈‍⬛", "screen_name": "YoRHa_TypeA", "avatar_url": "https://pbs.twimg.com/profile_images/1670100979591815168/YDw3swiS.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1542834726284988417/1681732965/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank"