auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b231468d2722fbfe0c6ee70db03929d0 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/bfe3df6f/uploads/origins/fffb6d4a-d287-47b3-9925-a19a56fb7479?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=cb3985c97fc99dafd7a6e47e2b5abcf7", "srcset": "https://si.imgix.net/bfe3df6f/uploads/origins/fffb6d4a-d287-47b3-9925-a19a56fb7479?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=cb3985c97fc99dafd7a6e47e2b5abcf7, https://si.imgix.net/bfe3df6f/uploads/origins/fffb6d4a-d287-47b3-9925-a19a56fb7479?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=519fcdf6c0634c83df770870d98dad49 2x, https://si.imgix.net/bfe3df6f/uploads/origins/fffb6d4a-d287-47b3-9925-a19a56fb7479?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=adb9eb84728a29e3aaa87e9aedc7da76 3x"}, "body": "アピールしていただきありがとうございます\n私のVtuberを描いてほしいです\n\nフーマンになりすまし、フーマン社会に潜入する蛇のような魔法使い。狡猾で賢く、繊細で自信に満ちているが、物事がうまくいかないとパニックになる傾向がある。\n\n絵の詳細はお任せしますが、縦横比3:1で描いてください！気に入ったらtwitchやtwitterのバナーにするかもしれません。\n\n参考アート\nhttps://drive.google.com/drive/folders/13FNOFYEk_qKU24qMNfZqcNexpdgpo_EH?usp=share_link", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@kaiko_pekoe/works/12", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1095915, "client_id": 1354188, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/57a0e71c/uploads/origins/c4444681-6494-4967-8541-70b37291a3cb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=13c40189cd709327549df8cfc6949c2b", "srcset": "https://si.imgix.net/57a0e71c/uploads/origins/c4444681-6494-4967-8541-70b37291a3cb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=13c40189cd709327549df8cfc6949c2b, https://si.imgix.net/57a0e71c/uploads/origins/c4444681-6494-4967-8541-70b37291a3cb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c9328b8ff8392d4d054569901fd5859d 2x, https://si.imgix.net/57a0e71c/uploads/origins/c4444681-6494-4967-8541-70b37291a3cb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=fe22a8813f65f9740728c868afac726c 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/57a0e71c/uploads/origins/c4444681-6494-4967-8541-70b37291a3cb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6852c69b6b04c50a656266b57df68327", "srcset": "https://si.imgix.net/57a0e71c/uploads/origins/c4444681-6494-4967-8541-70b37291a3cb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6852c69b6b04c50a656266b57df68327, https://si.imgix.net/57a0e71c/uploads/origins/c4444681-6494-4967-8541-70b37291a3cb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=8fcf7cb1760b0ffe3e5fc0013fb45b59 2x, https://si.imgix.net/57a0e71c/uploads/origins/c4444681-6494-4967-8541-70b37291a3cb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=2ad53f456af68b72f9baa60dae129d32 3x"}, "body": "蚕様\n\n　なしと申します。蚕様が描かれる鮮やかで美麗な絵が好きで、この度ご依頼させて頂きました。自創作四人の絵をお願いする事は可能でしょうか。以下依頼詳細です。\n\n創作名：桜夏秋冬\n人物：\n・咲良美桜(24歳/160cm)モチーフは桜。桜のイヤリングは母の形見。\n・木下秋人(41歳/175cm)モチーフは紅葉。ループタイは祖父の形見。\n・夏野葵(41歳/178cm)モチーフは海と太陽。葵のネックレスは父からの贈物。\n・冬馬雪彦(41歳/173cm)モチーフは雪。ネクタイは夏野、ブレスレット(左)は姉から\n　の贈物。\n※四人全員仲良しで、男性三人は幼馴染で親友。美桜と秋人、夏野と冬馬がカップリ\n　ング。詳細は資料URL参照願います。量が多く流し見で構いません。\n\n依頼内容：\n・秋独特の儚さと穏やかさを感じる行楽シーズンに紅葉狩りにやってきた四人。木漏\n　れ日が落ち、鮮やかな紅葉が舞う中、秋人を少しメインに据えて、楽しそうな幸せ　\n　そうな四人を描いて頂きたいです。楽しそうといっても誰かは相手をいじる等、見て\n　いて仲の良さを感じる絵を、蚕様が思うまま自由に描いて頂けるとありがたいで\n　す。\n・また秋人は自然鑑賞や風景を撮る事が趣味なので、そこを意識した絵にして頂け\n　ると嬉しいです。\n・塗りについてはURL別添とさせて頂きました。\n・可能であれば美桜と秋人、夏野と冬馬のCPを意識した絵にして頂けると嬉しいで\n　す。といっても性的な表現等ではなく、それぞれの近くに配置したり等と簡単なも\n　ので問題ないです。\n・個人的な嗜好で可能であれば四人共デフォルトで少し頬を染めて頂きたいです。\n・皆の表情が分かる様な構図だと嬉しいです。キャラと分かれば、服装、キャラ色、\n　髪形のアレンジ等はお任せします。蚕様の鮮やかな色彩感覚と美麗なタッチを存分\n　に活かして楽しく自由に取り組んで頂けたら幸いです。\n\nその他：お手間でなければ、差分で以下の記載をお願いしたいです。\n・宛名\n・蚕様が描いて感じた四人に対する印象+四人が言いそうな台詞。描いた際に拘った点\n　等。(一言で構いません。創作物として感想が聞きたいという理由です。)\n作品用途：自己観賞。また創作で描いて頂いた設定等に触れるかもしれません。\n飲めない要望は無視して下さって結構です。ご検討頂けますと幸いです。\n\nなし\n\nhttps://www.dropbox.com/sh/4iojf48z58q3wzh/AABC4w1ET3Hfq7izt-VPjoIaa?dl=0", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@kaiko_pekoe/works/11", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1095915, "client_id": 2033496, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/55dbbb60/uploads/origins/072ecf63-7474-4277-86a4-7c261903e1d5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=32040219f884653d9f389bc6340bd940", "srcset": "https://si.imgix.net/55dbbb60/uploads/origins/072ecf63-7474-4277-86a4-7c261903e1d5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=32040219f884653d9f389bc6340bd940, https://si.imgix.net/55dbbb60/uploads/origins/072ecf63-7474-4277-86a4-7c261903e1d5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=fc548db1cc3d9f577ecc1fd018451843 2x, https://si.imgix.net/55dbbb60/uploads/origins/072ecf63-7474-4277-86a4-7c261903e1d5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f10cd2fbd02ebfb337260d646b2b64e5 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/55dbbb60/uploads/origins/072ecf63-7474-4277-86a4-7c261903e1d5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=8f0e33f176f7495cec0922e52ceb9d32", "srcset": "https://si.imgix.net/55dbbb60/uploads/origins/072ecf63-7474-4277-86a4-7c261903e1d5?bg=%23fff&auto=format%2Ccompress&fm=webp&fi