願いしたいです。二人とも下のリンクにある野生の姿になります：\n\nシロウ\nhttps://static.wikia.nocookie.net/brand-new-animal/images/1/15/Ginoru_render.png/revision/latest?cb=20200527201931\n\nアラン\nhttps://static.wikia.nocookie.net/brand-new-animal/images/9/9a/Purebreed_Alan_Render.png/revision/latest?cb=20200624184433\n\nシロウはアランにドギースタイルでマウンティングし、乱暴にアランを貫きながら、アランの真ん中の首を噛んで支配力を示す。アランの真ん中の首は噛まれて歯を食いしばり、より強いシロウに完全に従属しようと抵抗する。他の2つの首は、肛門を貫かれた快感の表情を浮かべながら、服従するように下がるだろう。アランは挿入されている間、ペニスを勃起させている。\n\nこれに加えて、シロウがアランの尻に射精し、彼を完全に服従させ、床に強烈な精液の流れを発射させるバージョンも見てみたい。", "nc": 169, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@howling_wolves/works/4", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/5e5cc7b6/uploads/origins/3c7e6a81-eef6-4354-8595-1415294975ce?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=f3d9543c45a6a745aecdee7b9e754357", "src_set": ""}, "private": true, "genre": "art", "tipped": false, "creator_id": 1993812, "client_id": 2928545, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 177, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@howling_wolves/works/3", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/5a9bf643/uploads/origins/5cd919e9-cf39-4622-8007-5fa723f101ed?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=b74a32d59d8f47fd20ed761e4d2f7da0", "src_set": ""}, "private": true, "genre": "art", "tipped": false, "creator_id": 1993812, "client_id": 1167900, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 161, "word_count": 0, "transcoder": "", "creator_ac