uration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/a41e331e/uploads/origins/eec732a0-ce7e-4e79-8043-10a204dcf035?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2295ddf8c79649b4a733efa7bb825a33", "srcset": "https://si.imgix.net/a41e331e/uploads/origins/eec732a0-ce7e-4e79-8043-10a204dcf035?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2295ddf8c79649b4a733efa7bb825a33, https://si.imgix.net/a41e331e/uploads/origins/eec732a0-ce7e-4e79-8043-10a204dcf035?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=69d16aebe982444689af0ee384ead2f6 2x, https://si.imgix.net/a41e331e/uploads/origins/eec732a0-ce7e-4e79-8043-10a204dcf035?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=18a92fe005f3591a5ebaecdf10c73c40 3x"}, "body": "初めまして！\nお祝いも兼ねて、ひらたまさんの絵で見てみたい子がいまして\nもし宜しければと、リクエストを送らせていただきました！\n\n◆キャラクター\nCoCの探索者\n・28歳男性、職業はwebライター\n・マイペースで、思い立ったらすぐ行動するタイプ。好奇心旺盛。\n・誰に対しても敬語を使う、いい所の生まれ。\n・いわゆるオタク気質で、推しへの情熱が凄い。VTuberの配信であったり、ライブによく出かけがち。\n\n構図やシチュなどはお任せいたします！\n指定があった方がいいとあらば、タブレットPC（あるいはノートパソコンなど）で何か作業している風（あるいは推しの情報収集）だと嬉しいです。ご検討宜しくお願い致します！\n\nhttps://x.com/muginantoka/status/1959921888484053244?s=20", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@hirasakahiro/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1530615, "client_id": 3142114, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/a7e8f4cf/uploads/origins/12c9da84-c416-49c4-af4d-77fb3f3c2e5c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=10a8b6aba4fc8e5a376ac1d05277224a", "srcset": "https://si.imgix.net/a7e8f4cf/uploads/origins/12c9da84-c416-49c4-af4d-77fb3f3c2e5c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=10a8b6aba4fc8e5a376ac1d