ize=inherit&bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=38e07d99bbdd55199a39af6a673aa2c5 3x"}, "body": "いつもお世話になっております。MPです。\n下記、お金払えるなら長文送ってもいいかとも思いましたので、リクエストさせていただきます。\nよろしければご対応いただけると幸いです。\n\nゲーム配信や実況を継続するためのコツや考え方をご教授いただきたいです。\n視聴者の増やし方ではなく、のっけさんのように楽しんで配信するためのアドバイスをいただきたいです。\n\n先日から、ずっとやってみたかったゲーム配信を始めました。\n誰も見に来ないだろうしすぐ辞めるだろうなぁと思っていたのですが、\nTwitterのフォロワーさんやのっけさんのファンの方々が数人見に来てくださって、\nとても楽しくゲーム配信できております。\n自分のゲームプレイにコメントもらいつつゲームできるなんて感動です。\n全部のっけさんのおかげです、いつも色々申し訳ございませんが、大変感謝しております。\n\nただ、楽しいのは楽しいんですが、\n自分の配信なんかを見に来てコメントまでいただくなんて申し訳ないと感じるようになってきました。\nそして、今は物珍しさで面白さを提供できているのかもしれませんが、\nだんだん見に来てくれなくなるだろうとも思い、少し寂しさを感じています。\nまた、やりたいゲームや企画はいくつかあるんですが、\n見に来てくれている方々が興味ないかもと思ってしまうのも悩みです。\n\nのっけさんは楽しく長期間活動されていますが、\n配信や実況をするにあたって、自分も視聴者も楽しむために何か考えられていることはあるでしょうか。\n漠然としたことでもいいので、何かアドバイスいただけると嬉しいです。\nいただけること自体がモチベーションになります。\n\nまた、これは別件ですが、自分の配信でなくてよいので、\nよろしければまた一緒にゲームしていただけると嬉しいです。\nゲームでも何でも人手が必要な場合はいつでもお手伝いいたしますので、\nお気軽にお申し付けいただけると幸甚です。\n\n以上、何卒よろしくお願いいたします。", "nc": 16, "word_count": 969, "transcoder": "text", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 444660, "creator": true, "nsfw_acceptable": false, "acceptable": false, "name": "兎鷺ぬい🎀ご依頼受付中", "screen_name": "u3g1n", "avatar_url": "https://pbs.twimg.com/profile_images/2084237088954974208/ws3WIYbw.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1218847864282963968/1785756021/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 120, "skills": [{"genre": "art"}], "banned": false, "nc": 145}, {"id": 871975, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "健康❣️", "screen_name": "pakipakiiishi", "avatar_url": "https://pbs.twimg.com/profile_images/1704723129929736192/R_51ZIhE.jpg", "header_url": "https://pbs.twimg.com/profile_banner