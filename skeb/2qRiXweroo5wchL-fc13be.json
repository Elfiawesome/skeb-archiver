（この2色は似ているのではなく、明確に区別される色です）であることです。\n\n可能であれば、妊娠中や子供たちと一緒にいる「母」バージョンも描いてほしいです。\n\nキャラクターの背景設定については、自由に考えてください。 私自身のアイデアとしては、アリッサが結婚相手を探していた際、背が高く裕福な年上の男性（40歳以上）ではなく、病弱な少年（18歳）を見つけたという設定です。彼女は少年を引き取り、健康を取り戻すまで世話をし、彼が大人へと成長するにつれて彼への愛を育んでいきました。\n\nPSD形式での納品を希望します。\nお時間を割いてご検討いただき、ありがとうございます。\n\nhttps://drive.google.com/drive/folders/1ahBECQRweJVAkcRUuvp1FVBC7MQPr03M?usp=drive_link", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@2qRiXweroo5wchL/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 4010129, "client_id": 891338, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/a1c5d422/uploads/origins/e2332532-e259-491b-8b65-1f99898cb834?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=726ad13607b16b19416fc070af56d894", "srcset": "https://si.imgix.net/a1c5d422/uploads/origins/e2332532-e259-491b-8b65-1f99898cb834?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=726ad13607b16b19416fc070af56d894, https://si.imgix.net/a1c5d422/uploads/origins/e2332532-e259-491b-8b65-1f99898cb834?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=372e4e502c4979b291a0360120749f14 2x, https://si.imgix.net/a1c5d422/uploads/origins/e2332532-e259-491b-8b65-1f99898cb834?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=99dd4c35fa1402739d314a0b4cf7e7be 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/a1c5d422/uploads/origins/e2332532-e259-491b-8b65-1f99898cb834?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=43dba156d52175365927786dadc7c7bc", "srcset": "https://si.imgix.net/a1c5d422/uploads/origins/e2332532-e259-491b-8b65-1f99898cb834?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=43dba156d52175365927786dadc7c7bc, https://s