図等はaruku様にお任せ致します。 \n\n◆使用用途\n個人観賞用です。但し同卓の友人に個別に共有することがあります。 \n\n以上、ご検討の程よろしくお願い致します。\n\nhttps://drive.google.com/drive/folders/1238EdMpfZJ19peZGERL2XMDofBqxMAe7", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@walking155/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 566888, "client_id": 1224873, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/7e4906cd/uploads/origins/3eaa3e98-2bc1-4d9a-a045-5156483b8fd0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=04b91d9b7705cb7f8c8e2a74f2f032d8", "srcset": "https://si.imgix.net/7e4906cd/uploads/origins/3eaa3e98-2bc1-4d9a-a045-5156483b8fd0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=04b91d9b7705cb7f8c8e2a74f2f032d8, https://si.imgix.net/7e4906cd/uploads/origins/3eaa3e98-2bc1-4d9a-a045-5156483b8fd0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=cecba718dc926d23173cc31a43444353 2x, https://si.imgix.net/7e4906cd/uploads/origins/3eaa3e98-2bc1-4d9a-a045-5156483b8fd0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=3fa81b15fa288f56d34ab3d84f22fd8c 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/7e4906cd/uploads/origins/3eaa3e98-2bc1-4d9a-a045-5156483b8fd0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=277e1756984dd8db6c4d513b37174945", "srcset": "https://si.imgix.net/7e4906cd/uploads/origins/3eaa3e98-2bc1-4d9a-a045-5156483b8fd0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=277e1756984dd8db6c4d513b37174945, https://si.imgix.net/7e4906cd/uploads/origins/3eaa3e98-2bc1-4d9a-a045-5156483b8fd0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=db03607110fb156de6d8d0ac22c178fc 2x, https://si.imgix.net/7e4906cd/uploads/origins/3eaa3e98-2bc1-4d9a-a045-5156483b8fd0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=360ce028fb52bd5bffad1321b2133f00 3x"}, "body": "お世話になっております。トコトコ王国のピクルーいつも使わせていただいています。可愛くてとても気に入っております。\nピクルーで作成したキャラをTRPGで使わせてもらったので、よければ描いていただけたらと思ってリクエストさせていただきました！\n\n男女の二人組なので仲良くしている絵が見れたら嬉しいです。可能であれば女の子の方がクレープを持って食べてるのを男の子の方が一口もらうみたいな構図だと嬉しいですがそうでなくても構いません。\n\nよければよろしくお願いします。\n\nhttps://twitter.com/_nekosoba_/status/1626269798333313025", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@walking155/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 566888, "client_id": 2351425, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/11a26bdf/uploads/origins/3ebdfe5a-f641-4dc2-81af-793c1c66645b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a0f751187826125a14ea0b3485a500cc", "srcset": "https://si.imgix.net/11a26bdf/uploads/origins/3ebdfe5a-f641-4dc2-81af-793c1c66645b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a0f751187826125a14ea0b3485a500cc, https://si.imgix.net/11a26bdf/uploads/origins/3ebdfe5a-f641-4dc2-81af-793c1c66645b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=29e71669ec61d89076ba7640e4a51b6e 2x, https://si.imgix.net/11a26bdf/uploads/origins/3ebdfe5a-f641-4dc2-81af-793c1c66645b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=0bc27f7ffc86352f7d8a966bef3519ab 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/11a26bdf/uploads/origins/3ebdfe5a-f641-4dc2-81af-793c1c66645b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=de79b8521a8076362a9b95db82d87b35", "srcset": "https://si.imgix.net/11a26bdf/uploads/origins/3ebdfe5a-f641-4dc2-81af-793c1c66645b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=de79b8521a8076362a9b95db82d87b35, https://si.imgix.net/11a26bdf/uploads/origins/3ebdfe5a-f641-4dc2-81af-793c1c66645b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=00a9852e5844c61be0e492c010f810e3 2x, https://si.imgix.net/11a26bdf/uploads/origins/3ebdfe5a-f641-4dc2-81af-793c1c66645b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=b4324a8c45d4fb1705e6a19abb6e8901 3x"}, "body": "aruku様、初めまして。飴と申します。aruku様のpicrew「トコトコ王国」を立ち絵作成用として愛用させていただいているTRPGプレイヤーです。素敵なpicrewをありがとうございます。\n今回、「トコトコ王国」にて作成した自キャラのチャイナ衣装がどうしても見たいという気持ちになり、リクエストさせていただきます。新たな衣装のデザインを一任することになるため、金額をやや多めに設定していますが、金額が少ないまたは多いと感じた場合には非承認や再送要求をしていただいて構いません。\n\n◆資料画像\n資料URL参照\n「トコトコ王国」にて作成した画像とその差分です。\n\n◆キャラ設定\nキャラについて\n・ピンク色の髪、紫と青のオッドアイ\n・髪の毛の先端に紫色のグラデーション\n・右目に白いハート形のハイライト\n・左目は義眼のためハイライトなし\n・左目に眼帯をつけていることがある(必須ではない)\n以上が容姿の特徴となります。\n\n衣装について\n・いわゆる「漢服」よりは「チャイナドレス」に類する形のものを希望\n・色は青系または黒系が嬉しい\n・できるならば肩が出ているノースリーブのものを希望\n・髪型はアップにしていてほしい、お団子もしくは編み込みが入っていると嬉しい\n・その他髪飾りやアクセサリーなどはお任せしたい\n・全身、あるいはニーアップを希望\n・ポーズについてはお任せしたい\n以上が希望ですが、全てを取り入れていただく必要はありません。aruku様の判断で取捨選択いただければと思います。\n\n◆使用用途\n基本的に個人観賞用ですが、今後skebなどのイラスト依頼サイトにて他のクリエイター様への依頼の資料として添付する可能性があります。また、同卓の友人たちには画像を共有します。\n\n以上、ご検討の程よろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/1GDj1Q9V2sfTFn2_-hkTSuHK9vQTwX5xs", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@walking155/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 566888, "client_id": 1582675, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/371ff0fb/uploads/origins/43221b03-d2ec-42ac-96ba-11e0afe137d8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=69b6396bab9a870624176034684d4019", "srcset": "https://si.imgix.net/371ff0fb/uploads/origins/43221b03-d2ec-42ac-96ba-11e0afe137d8?bg=%23fff&auto=format