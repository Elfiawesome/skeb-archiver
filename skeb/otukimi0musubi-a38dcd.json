b91b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=114fef075e21e3254e94d0d5b6548db4 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/8a21877b/uploads/origins/e341f743-2897-4cfa-8404-70dc1f0fb91b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=95f6595b5fbdcb5ef3b80b64b35e325f", "srcset": "https://si.imgix.net/8a21877b/uploads/origins/e341f743-2897-4cfa-8404-70dc1f0fb91b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=95f6595b5fbdcb5ef3b80b64b35e325f, https://si.imgix.net/8a21877b/uploads/origins/e341f743-2897-4cfa-8404-70dc1f0fb91b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=6066c09e60b4e34411691b90811f6faa 2x, https://si.imgix.net/8a21877b/uploads/origins/e341f743-2897-4cfa-8404-70dc1f0fb91b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=d7e4e083d044234dded243dba3e8d00e 3x"}, "body": "おはようございます！\n\n苧環さんのかわいいタッチでCoCシナリオ「ドロップアウトディスパイア」の自陣をお願いしたいと思っておりましたのでもしご縁がありましたら描いていただけると嬉しいです！\n下記にシナリオのネタバレはありません。\n\n\n\n▼お願いしたいキャラクター\n\n\n　◆天使　紗来(あまつか　さらい)\n女性。最近大学に入学した18歳。身長152cm。細身。遺書を届ける殺し屋コンビのうちの一人。武器は銃。\n黒髪黒目、髪型は高めのツインテールだったが最近はハーフツイン。\n性格は超真面目な天然。表情筋は基本死んでいる。\nガスマスクは顔を隠すためにAm○zonで買った安物。\n突拍子もないことでも大真面目に言っている。両親が死んでおり、引き取り手であった叔母の家族に虐待を受けていたが大学進学を機に家を出た。\n現在誘衣奈落と同棲中。誘衣奈落のことが好き。本人には伝えたつもりになっている。\n\n\n\n　◆誘衣　奈落(いざない　ならく)\n男性。この春大学に進学した18歳。身長175cm。遺書を届ける殺し屋コンビのうちの一人。\n武器はワイヤー。最近拳銃の扱いも覚えた。八重歯。\n白髪赤目、髪型は腰辺りまでのロングだったが進学にあたって首のあたりまでバッサリ切った。\n性格は簡単に言えば不良。他人と深く関わる気があまりなく必要が無ければ基本的に無視する。\n仕事で必要な時や同業者等とは普通に会話をする。\n天使紗来に対してだけ普通に話すが、口調は荒い。天使紗来の言動に振り回される事が多い。\n天使紗来のことが好きなのを最近自覚した。\n面と向かっては伝えてないが、手紙で一緒に幸せになりたいと伝えてはいる。\n\n\n\n▼構図、世界観、要望等\n舞台は現代日本ではありますが、日常の裏に殺し屋たちがいるようなアングラな部分があります。\n同じ大学に通っています。\n服装などに関してはアレンジ大！歓！迎！ですが天使紗来の方は全体的に黒ベースでお願いします。\n誘衣奈落に関しては白の面積多めでお願いします。\n\n\n\n▼使用用途\n・個人観賞\n・一緒に遊んでくれた相方、KPへの共有\n・上記の3人でのみ印刷、グッズ制作(アクリルスタンド、ブロック等)\n・Skeb依頼時の資料として第三者への提示\n\n\n▼納品形式\n制作過程を見せていただくのが好きなのでラフ等の見れるPSDファイルもありますと嬉しいです。\nもちろんなくても構いません！\n\n\n以上になります。\nご確認本当にありがとうございます！\n何か不手際がありましたら申し訳ございません。\nご検討いただけますと幸いです！よろしくお願いいたします！\n\nhttps://drive.google.com/drive/folders/1p4uw4tuYUSDRNaXCobAUVVdvJ1Kh64Nv?usp=sharing", "nc": 136, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 1203162, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "ちふゆ", "screen_name": "chfy_ibk", "avatar_url": "https://pbs.twimg.com/profile_images/1787381761011593216/GMuPxx8d.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1295239276070727681/1731644652/1500x500", "appeal_receivable": true, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 120, "skills": [{"genre": "art"}], "banned": false, "nc": 128}, {"id": 1409761, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "ぬぬこ", "screen_name": "mu66112902", "avatar_url": "https://proxy.misskeyusercontent.jp/avatar.webp?url=https%3A%2F%2Fmedia.misskeyusercontent.jp%2Fio%2Fwebpublic-57f93bd1-9166-4c4f-8728-2148ab6a70ac.png&avatar=1", "header_url": "https://media.misskeyusercontent.jp/io/2a6be940-bd06-4cb3-9552-8defb79af45f.png?sensitive=true", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 7, "complete_expiration_days": 60, "skills": [{"genre": "art"}], "banned": false, "nc": 32}, {"id": 1589464, "creator": true, "nsfw_acceptable": false, "acceptable": false, "name": "tmtmm", "screen_name": "TAMITOMEMO", "avatar_url": "https://pbs.twimg.com/profile_images/2018996551889424384/-yGIS537.jpg", "header_url": null, "appeal_receivable": true, "popular_creator_rank": null, "request_mast