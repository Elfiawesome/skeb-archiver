r=200&s=30f6311894c2e0f0c5cecee1ce5f7c30", "srcset": "https://si.imgix.net/a4dd0290/uploads/origins/750ca7cc-bd5d-45c4-80bb-c19d7bbad4dc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=30f6311894c2e0f0c5cecee1ce5f7c30, https://si.imgix.net/a4dd0290/uploads/origins/750ca7cc-bd5d-45c4-80bb-c19d7bbad4dc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=a2907cf9f5ad5088629ac5de2e5b768e 2x, https://si.imgix.net/a4dd0290/uploads/origins/750ca7cc-bd5d-45c4-80bb-c19d7bbad4dc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=f3e2e7d8835b5d66525a7d72f8cfb4be 3x"}, "body": "オタクに肉便器にされる結城さくなの無様エロをお願いしたいです\nだらしない体型で胸かなり大きめ陰毛はボーボーかジョリジョリ\n竿役はヒョロガリとかデブがいいですがどんなでも大丈夫です\n\nスパンキングしたり髪ひっぱったりチン媚びさせたりアナル舐めチンカス掃除、自分だけ恥ずかしい恰好、顔が歪んでブサイクになったりするの好きですこれは参考程度で無視して頂いて大丈夫です\n\nＮＧないのでバチボコにお願いします鬼畜目だとむしろ嬉しいです\n金額的に大丈夫であれば漫画的な感じでお願いできないでしょうか", "nc": 59, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Nataihyou/works/12", "private_thumbnail_image_urls": null, "private": false, "genre": "comic", "tipped": false, "creator_id": 2720188, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/cf849986/uploads/origins/88579cca-b593-410b-8c95-36a04510fed2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=39e2b7efef5f779e4c143d1dc3612c91", "srcset": "https://si.imgix.net/cf849986/uploads/origins/88579cca-b593-410b-8c95-36a04510fed2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=39e2b7efef5f779e4c143d1dc3612c91, https://si.imgix.net/cf849986/uploads/origins/88579cca-b593-410b-8c95-36a04510fed2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=20f02fb9394bedebf5b76b6e55102742 2x, https://si.imgix.net/cf849986/uploads/origins/88579cca-b593-410b-8c95-36a04510fed2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=dcae245ca629dd9dbd79c50ff11da91d 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/cf849986/uploads/origins/88579cca-b593-410b-8c95-36a04510fed2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=eea6e5a210de2a715cd8ec7aeddebe4f", "srcset": "https://si.imgix.net/cf849986/uploads/origins/88579cca-b593-410b-8c95-36a04510fed2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=eea6e5a210de2a715cd8ec7aeddebe4f, https://si.imgix.net/cf849986/uploads/origins/88579cca-b593-410b-8c95-36a04510fed2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=01de54d6bd5a7ccde0a3c33a7908fbb6 2x, https://si.imgix.net/cf849986/uploads/origins/88579cca-b593-410b-8c95-36a04510fed2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=b6236182a31ea1c51ef94f276c94b509 3x"}, "body": "竜胆尊の無様エロを描いて頂けないでしょうか\n\n以下はこういうのが好きという参考程度で大丈夫です\n\nお金に困って立ちんぼやデリヘル的な性商売やっててほしいです\n買ってもらうために必死で下品な誘い方や何人でもどんなプレイでもアリで客集めをしてほしいです\nそのせいで客層が最悪で汚いおっさん「ちゃんとやんないと金払わねえぞ」的な事言われて要求された事はなんでも必死にフェラしたりアナル舐めしたり都合よく呼び出されたりなどしてほしいです\n最終的に騙されて輪されたりお金を払われないとか巡回中の警察にレイプされるとか可哀想なことになってほしいです\n\n\n体はだらしない感じで胸はかなり巨乳か長乳　陰毛や腋毛はジョリジョリかボサボサだと嬉しいですがどちらでも大丈夫です\nアナル舐めパイズリ、エロ蹲踞、体に落書きされる、髪の毛がっつり引っ張られる、ヘッドロック首絞め、イラマチオ、ブスや豚、オナホ等の暴言、腹ボコや喉ボコ、殴打、チンカス掃除、タバコの灰皿にされる、おもちゃ、開口機や全頭マスク鼻フック、子宮潰れるぅ的な描写等の尊厳破壊するような無様なことされるのが好きです\n胸や乳首を乱暴に扱う描写が好きなのでねじったり抓ったりビンタ、洗濯バサミやリング等の道具、握り潰したり噛み跡つけたり痛そうな事があると嬉しいです\nエグいアへ顔、白目向きそうなイキ顔、食いしばって痛がる、ブサイクなグポグポ必死なフェラ顔、無様にンホ声オホ声等の表情が崩れるのも大好きです\n\nNGないので無様でハードな内容だと嬉しいです\n\n欲望を書きなぐってしまいすみません\n上記は本当に参考程度なので無視でも問題ないです\n気に入らない場合全く関係なくても大丈夫ですのでおまかせで自由に描いて頂けるとありがたいです\nもし金額的に大丈夫なら数ページの漫画のような形で描いて頂けないでしょうか", "nc": 185, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Nataihyou/works/11", "private_thumbnail_image_urls": null, "private": false, "genre": "comic", "tipped": false, "creator_id": 2720188, "client_id": 1460537, "vtt