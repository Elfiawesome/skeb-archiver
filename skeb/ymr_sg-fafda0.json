n": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/bf027e74/uploads/origins/dfb671d9-6cf7-4a93-a31b-34f2958f5886?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b2bad5f6cee4f5f3c3da6ba77a10b989", "srcset": "https://si.imgix.net/bf027e74/uploads/origins/dfb671d9-6cf7-4a93-a31b-34f2958f5886?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b2bad5f6cee4f5f3c3da6ba77a10b989, https://si.imgix.net/bf027e74/uploads/origins/dfb671d9-6cf7-4a93-a31b-34f2958f5886?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=2c1e19aa6342c4b5b58e9c3f3e87971b 2x, https://si.imgix.net/bf027e74/uploads/origins/dfb671d9-6cf7-4a93-a31b-34f2958f5886?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=080b41900fbcf4a0adda086a13e73432 3x"}, "body": "こんにちは！\nファーストリクエスト、失礼します\n\n今現在、私が個人でやっている創作企画、『ワンワンズアーミー（https://kwg0x-bf.net/bowwowarmy/）』の\nOGP画像（SNSシェア用ビジュアル）をお願いしたく、リクエストさせて頂きました\n\n【企画コンセプト】\n犬獣人×軍人＝∞！\n近未来の混沌とした戦場を舞台に、一騎当千の犬獣人兵士たちが傭兵集団『ワンワンズアーミー』として活躍する世界を描いています\n\n【背景イメージ】\n夜明けの戦場など、「始まり」を感じさせる雰囲気でお願いしたいです\n\n【登場人物】\n以下の2人でお願いしたいです\n関係性としては、同期で同室の新米兵士のバディです\n（※年はリクの方が1つ上。身長差は頭2つ分くらいリクが上で）\n\nアラタ（柴犬／表情豊か・未熟）\n・必死さや前を向く強い眼差し、「俺は俺なりに頑張る！」感\n・少し傷つきながらもリクの隣に立とうとする感じがベストです\n\nリク（ドーベルマン／寡黙・硬派）\n・凛とした佇まい、無表情だが拳を握る姿など「静かな強さ」\n・スッ、とアラタの横か後ろに常に控えてる感じだと嬉しいです\n\n【その他】\n横長サイズの画像が希望です\nサイトタイトルやコピーなどの文字を入れるかはお任せいたします\n\nその他、記載外の事についてはお任せいたします\nお忙しいとは存じますが、受理していただけると幸いです\nそれではよろしくお願いいたします", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": []}, "price_history": {"art": [{"amount": 15000, "recorded_at": 1783144298.920712}], "comic": [{"amount": 4000, "recorded_at": 1783144298.920712}], "novel": [{"amount": 1000, "recorded_at": 1783144298.920712}]}, "custom": {}}