ins/6b8cdfc2-70eb-4629-9a03-22840aee38d3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=2ab21851a262eb124ac3010096dc6c40 2x, https://si.imgix.net/f06fed82/uploads/origins/6b8cdfc2-70eb-4629-9a03-22840aee38d3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=537c6f50d6eb4a6096aef929a70ddd2e 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/f06fed82/uploads/origins/6b8cdfc2-70eb-4629-9a03-22840aee38d3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=4ee6e813b958b3a665684ee48e89704b", "srcset": "https://si.imgix.net/f06fed82/uploads/origins/6b8cdfc2-70eb-4629-9a03-22840aee38d3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=4ee6e813b958b3a665684ee48e89704b, https://si.imgix.net/f06fed82/uploads/origins/6b8cdfc2-70eb-4629-9a03-22840aee38d3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=4678bb2add2733fd602e61e8932edd66 2x, https://si.imgix.net/f06fed82/uploads/origins/6b8cdfc2-70eb-4629-9a03-22840aee38d3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=7228e4a9f49cdc3d698e40f169808c7b 3x"}, "body": "はじめまして\nボクっ娘の幽霊Vtuberの灯火ゆらさんの絵をリクエストさせて頂きます。\n\nリクエストする絵はMKICHIさんが描かれたこちらの絵(https://skeb.jp/@MKIC_/works/3)と同様の灯火ゆらさんの立ち絵です。\n\n\n⓵表情は目と口が開いている状態の笑顔で八重歯が見えています。\n②ポーズは資料1枚目の立ち絵のような両手を前に下げた幽霊のポーズをしています。\n③背景は薄いオレンジ色でお願いします。\n\n\n絵は灯火ゆらさんの活動の糧としてプレゼントする為、私のXで灯火ゆらさんのFAタグとMKICHIさんのXやSkebのURL等を付けて投稿します。\nその為、絵は灯火ゆらさん単体の透過絵もお願いします。\n\n\n灯火ゆらさんはSkebによる依頼を公認しており、ガイドラインでもイラストの二次創作を許可しています。\nhttps://profcard.info/u/NV3QKxLy8KW8OHPU7pZemnqaJAF3\n\n\nご検討をよろしくお願いします。\n\nhttps://x.com/tomoshibiyura/status/1764089903468699847?s=20", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@MKIC_/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "ar