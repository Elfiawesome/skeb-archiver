腹人妻シーメールAV女優としてデビューすること等をファンや友人等に報告している。\n\nシーメール風俗嬢の落合清美の服装はhttps://www.pixiv.net/artworks/51744656のような感じでお願いします。", "nc": 185, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@sodom_shimin/works/50", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/c81e881b/uploads/origins/2ac424ac-e2c4-45b1-9b33-61f5dd5dbaad?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=8e6ec10158c2ac506be481ba5f802110", "src_set": ""}, "private": true, "genre": "art", "tipped": false, "creator_id": 356038, "client_id": 936658, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 32, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@sodom_shimin/works/49", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 356038, "client_id": 12248, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/543933e8/uploads/origins/89ff3521-f4ef-4013-8138-578fea3d2829?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8cbc11ec8cf58d170a9e17b1d3e47ee4", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": true, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/543933e8/uploads/origins/89ff3521-f4ef-4013-8138-578fea3d2829?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0a00126fd9f44d0f6ac1190a37f15fc9", "src_set": ""}, "body": "この前は素敵なイラストをありがとうございます！同じ設定でまたイラストを描いていただきたく連絡しました!   \n\nキャラクター \n橘ありす(アイドルマスターシンデレラガールズ)  \n\nシチュエーション \nhttps://skeb.jp/requests/2003009 の続きの話をお願いします。 アイドル人権廃止法で全人類の肉便器となった橘ありすが排泄ショーを行う。\n\n 詳細\n 橘ありすに腹が妊婦のようになるまで牛乳浣腸を行った後、太さはピンポン玉で長さが30センチを超えるアナルビーズを腸に全部突っ込む。 公衆便所に繋いで一週間その状態で陵辱を行った後、尻を上に上げてまんぐり返しの格好でアナルビーズを一気に引き摺り出して排泄させる。 トイレの天井まで浣腸された牛乳が吹き出す。調教の影響で肛門の感度が上げられてるため排泄の間、絶頂し続ける。 取り囲んでる男たちの嘲笑、罵声、蔑みのセリフをお願いします。", "nc": 186, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@sodom_shimin/works/48", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/b111f227/uploads/origins/ef07a40a-ecb9-453e-a2e6-c043712d3e3c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=384bbfba030ce4fcc28009101362ce24", "src_set": ""}, "private": true, "genre": "art", "tipped": true, "creator_id": 356038, "client_id": 37710, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 161, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@sodom_shimin/works/47", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/5ba8a27f/uploads/origins/2c3ec814-b9ef-46be-908d-bf817616f4a5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=e427a5b93b94ae9f3cfacbe3c1c5cbb1", "src_set": ""}, "private": true, "genre": "art", "tipped": false, "creator_id": 356038, "client_id": 0, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 178, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@sodom_shimin/works/46", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 356038, "client_id": 0, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/5f98e5cf/uploads/origins/6716fb19-5a91-424e-b6e5-c571fd822518?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=54969c8eabb49184a2774b9eb100492e", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": true, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/5f98e5cf/uploads/origins/6716fb19-5a91-424e-b6e5-c571fd822518?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=31cb6bb91a3b00ba830a4899583fb18f", "src_set": ""}, "body": "期限が切れてしまいましたため、再送させていただきます。\n以前お願いさせて頂きました、夏葉リョナエロバラモノの続編作品をお願いいたします！\n設定など、一部前回のコピペとなりますが以下の通りです！\n\n・どれだけエグイ目にあったり残酷な行為が行われても、そういうものとして扱われてる風な世界観。\n嫌なのは間違いないが、泣きわめいたり絶望したり…ではなく明るい雰囲気で残虐な行為を受け入れてる。\n現実で言うゴムパッチンやセンブリ茶くらいのノリで下記の罰ゲームが行われる感じです。\n\n・バラエティ番組に参加した放クラ。ゲームなりなんなりで失敗してしまい罰ゲームを受けることに。夏葉が罰を受けたので、次は樹里ちゃんの番\n\n・全裸にひん剥かれ、顔や体を問わず全身に卑猥なタトゥーや焼き印、ピアス等を入れられ、二度とまともに外を出歩けないような体にされた状態。目にも永続カラコン的なノリでタトゥーが入れられ失明し、焦点がいまいちあっていない。\n・どちらか一方の手は切断。キリトリ線タトゥーもあり\n・自分の現状として、卑猥なタトゥーを入れられたり失明したこと、人権がなくなったことや財産を全部没収されて借金だらけになったこと、これからエグい売春やAVに出させられることなどを説明。\n\nと、ここまでで一区切り。夏葉と同じ目だけど…とか、これだと代わり映えが云々…みたいな煽りを受けて、さらにやっちゃいましょう！みたいな提案をする放クラメンバー+困り笑顔でしょうがねぇなぁ…みたいなリアクションで受け取る樹里。\n一旦暗転して放クラキャラ達による雑談（どうなっちゃうんだろう…人権無いからね…等々、不穏な雑談）\n\n再度暗転空け、さらに悪化した樹里ちゃん公開。\n・鼻フック装着、歯は全部抜かれて総入れ歯化、流動食とかしか食べられなくなってる\n・尿道とアナル破壊済み。一生垂れ流し的な発言（逆トゲだらけの凶悪なディルドやバイブが転がってる）\n・片方の胸と乳首だけ肥大したり伸ばされてたりで胸が左右不揃いな感じに\n・短時間で引っ張られピアスを入れられ等々でグロマン化。女として終わってる発言\n・腎臓一つ摘出済み。体調不良とか、これからの生活が厳しくなる系発言（前パートでの異常AVの件も含めて長生きできない系の発言的な）\n・他、ハードでブラックな要素やセリフを思いつく限り入れていただければと思います。\n\n改めて樹里ちゃんの惨状にそれぞれの感想を述べる放クラの面々のセリフ。\n残りの３人も同じような目に合うことが確定している（夏葉は受けた後）なので、樹里ちゃんのあの扱いは嫌とか、○○は樹里（夏葉）と違って～なので××な目に合うかも（獣姦や食糞、死ぬこと、あるいは死ねないことなどに言及したR18G、とにかく悲惨であればどのような内容でも結構です）…等、悲惨な未来や末路等を雑談っぽく話して匂わせる。\n・次の人は最低でも自分と同じ目、追加でもっとひどい目に合うから頑張ってね！みたいな樹里ちゃんの発言、それを受けて頑張るぞ！みたいな残りの面子や、夏葉に対するラッキーじゃんみたいな弄り等のセリフ\n\n・全体を通して、滅茶苦茶悲惨な状況と、それとはかけ離れた明るい雰囲気\n以上の設定でお願いできませんでしょうか…！\n・常識がおかしい系の世界観（実際に常識改変されてるとかではないです）\n・バラエティの軽くて明るいノリで「終わっちゃう」女の子\nの２つの雰囲気をメインに据えていただければ、あとは書きやすいようにご調整いただいて結構です。\nまた、キャラクターも残る4人の中だと樹里ちゃんがいいかな…？と思っただけなので、他３人のうちの誰かでも結構です。\n描写の形式としては前回の差分風でも、新たに書き下ろしていただいても、あるいはそれらを混ぜた形でも、どんなものでも結構です！\n\n続編、差分といった形でのお願い、ご依頼がご迷惑、ご失礼でなければ良いのですが…\n難しければ断っていただいても結構です！どうぞよろしくお願いいたします…！\n\nhttps://www.p