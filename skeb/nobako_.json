om/drive/folders/1gh7CLQnU0eaE8MVYRJMLg-mot10IOW3J\n\n※希望内容\nポーズも構図ものばこさまにお任せいたします。千眠はほくろがございますので、ご注意ください。ほくろの位置ですが、02costume.jpgで確認できます。もしほくろが見えるポーズでしたら、ほくろを描いていただきたいです。\n\nアスペクト比は16:9、サイズは3,840x2,160 pxでお願いいたします。\n\n※使用用途\nSNS、サムネイル、配信、動画、グッズでの利用をいたします。\n\n※納品形式\n可能でしたら、キャラと背景をレイヤー分けできるPSD資料をいただきたいですが、もし困難でしたらpng資料でも問題ございません。\n\n※その他\n\t●もしよろしければ簡単の背景や表情の差分も描いていただけると嬉しいですが、もちろんなくても問題ございません。\n\t●キャラクターの姿が切れてない構図でしたら嬉しいです。\n\t●イラストを使わせていただくとき、背景やトリミングなどの加工編集をする場合がございます。ご了承ください。\n\n以上、ご検討のほどよろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/1gh7CLQnU0eaE8MVYRJMLg-mot10IOW3J", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@nobako_/works/6", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/4fbc5c3b/uploads/origins/3ac4aca3-7075-40f6-8002-1ab32a5bf829?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=956572691cd7139864886a7218dec2c5", "src_set": ""}, "private": true, "genre": "art", "tipped": false, "creator_id": 3697112, "client_id": 0, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 176, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@nobako_/works/5", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/6e0fca0d/uploads/origins/956125ef-613d-4fd1-8fcd-35d8cea52274?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=7728d9934e48ff32c71a46a15ee06c72", "src_set": ""}, "private": true, "genre": "art", "tipped": false, "creator_id": 3697112, "client_id": 0, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 177, "word_coun