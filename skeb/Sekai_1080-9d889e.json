め、勇希が誘い受け的なポジションです。服装はお任せします。\n何かしら表情差分があると嬉しいですが、難しければ無しでも大丈夫です。\n\n背景はお任せしますが、もし背景も描かれるのであれば、目立たないところに観葉植物（資料参照）を置いていただけると嬉しいです。観葉植物の見た目は特にこだわらなくていいです。背景無しの場合は無視してください。\n\nご検討宜しくお願い致します。\n\nhttps://drive.google.com/drive/folders/1T2NFKXQsRBS1-tnlayledXVMTHGeIH4Z?usp=drive_link", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Sekai_1080/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3616860, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/5c3b5e82/uploads/origins/cc19fdfe-6736-4c0a-a88a-e13ed902d269?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2014d8f58b87a7b48ce5e1f7ad993c3c", "srcset": "https://si.imgix.net/5c3b5e82/uploads/origins/cc19fdfe-6736-4c0a-a88a-e13ed902d269?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2014d8f58b87a7b48ce5e1f7ad993c3c, https://si.imgix.net/5c3b5e82/uploads/origins/cc19fdfe-6736-4c0a-a88a-e13ed902d269?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=af8469801b9df05d2fc46ef1020ba0d2 2x, https://si.imgix.net/5c3b5e82/uploads/origins/cc19fdfe-6736-4c0a-a88a-e13ed902d269?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=6d9dd6efa8c1bff10941b8766c6231e0 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/5c3b5e82/uploads/origins/cc19fdfe-6736-4c0a-a88a-e13ed902d269?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a2919fd5f708daa14c00ac7a3e6fd9b8", "srcset": "https://si.imgix.net/5c3b5e82/uploads/origins/cc19fdfe-6736-4c0a-a88a-e13ed902d269?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a2919fd5f708daa14c00ac7a3e6fd9b8, https://si.imgix.net/5c3b5e82/uploads/origins/cc19fdfe-6736-4c0a-a88a-e13ed902d269?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=cr