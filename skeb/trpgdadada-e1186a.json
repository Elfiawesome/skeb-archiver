e8161b, https://si.imgix.net/56888307/uploads/origins/b3b571fc-a7ce-4898-aef1-699e99b3a106?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=8388caf53caaf9e2ae5d195dedb2828f 2x, https://si.imgix.net/56888307/uploads/origins/b3b571fc-a7ce-4898-aef1-699e99b3a106?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c699989e9cddd7c11d3bd132000dfa97 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/56888307/uploads/origins/b3b571fc-a7ce-4898-aef1-699e99b3a106?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=596f090eceb0d48fa3d8a5c3a41755d4", "srcset": "https://si.imgix.net/56888307/uploads/origins/b3b571fc-a7ce-4898-aef1-699e99b3a106?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=596f090eceb0d48fa3d8a5c3a41755d4, https://si.imgix.net/56888307/uploads/origins/b3b571fc-a7ce-4898-aef1-699e99b3a106?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=2284dc72208d1c08150ad44252f5beec 2x, https://si.imgix.net/56888307/uploads/origins/b3b571fc-a7ce-4898-aef1-699e99b3a106?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=52c0c21d6266e22de286e4e649a935ce 3x"}, "body": "いつもお世話になっております！長月です！\n\nこれをskebで頼んでいいのかわからなかったのですが、アイコンの左手で描いた絵がすごく好きで……うちのPCでも見たい気持ちが出ました！いくらで頼めばいいかわからなかったのでとりあえず入力可能金額の1500円で……高すぎるとかあったら再送しておけです！\n\n以下、PCの特徴です！ネタバレはありません\nシナリオ：かいぶつたちとマホラカルト\n性格：流行好きでファッション好き。のんびりふわふわした雰囲気だが、倫理観がしっかりアウトローで、殺す必要があったら殺すし負い目とかない。定期的にHO狼にお金をせびっている。\n\n髪色：白髪\n目：黄緑。基本閉じてる。\n\n光輪と翼は省略可能！\n太ももらへんに植物っぽいタトゥーがあります。\nいつも目尻にアイシャドーをつけています。色はちょいちょい変わる\n\n資料は以下のとおりです\n\nhttps://drive.google.com/drive/folders/1p87ICD_KaKn_GHd8suqi5hec0B7XtnZx", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@nitenom/works/8", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3984510, "client_id": 3442315, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/df19b1ca/uploads/origins/d61b4370-b77d-44fa-867b-ce77202be603?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=31da7f69a5368718387a6df328864f1c", "srcset": "https://si.imgix.net/df19b1ca/uploads/origins/d61b4370-b77d-44fa-867b-ce77202be603?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=31da7f69a5368718387a6df328864f1c, https://si.imgix.net/df19b1ca/uploads/origins/d61b4370-b77d-44fa-867b-ce77202be603?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=4fedcdba91015e3db916215090d81006 2x, https://si.imgix.net/df19b1ca/uploads/origins/d61b4370-b77d-44fa-867b-ce77202be603?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e60df13557abfc4c2ed5488494f652d1 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/df19b1ca/uploads/origins/d61b4370-b77d-44fa-867b-ce77202be603?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0ac891fb64e8efe336bc96b0f0b2becc", "srcset": "https://si.imgix.net/df19b1ca/uploads/origins/d61b4370-b77d-44fa-867b-ce77202be603?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0ac891fb64e8efe336bc96b0f0b2becc, https://si.imgix.net/df19b1ca/uploads/origins/d61b4370-b77d-44fa-867b-ce77202be603?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=1e57ec3bb33284fb1710178f8798b45b 2x, https://si.imgix.net/df19b1ca/uploads/origins/d61b4370-b77d-44fa-867b-ce77202be603?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=9a5f65ef183e137a74b858b63205b5b0 3x"}, "body": "nite様、初めまして！長月と申します。\n\n最近上げていらしたSkebの作品（トーンが黒く、星がキラキラ瞬いているもの）が魅力的で、御伽話の世界のようで、是非ともうちの子で見たいなと思いリクエストしました。\n\n今回お願いするのは、誰デザで作った子をOCとして動かすことにした子です。\n以下、詳細です。\n\nモチーフ：ガレット・デ・ロワ、チェスのキング\n 特徴：ガレット・デ・ロワがモチーフなので、生地の模様の種類として存在する「月桂樹」、「太陽」、「向日葵（※実際のひまわりではなく、生地の種類としての向日葵です。検索するとすぐ出てきます）」、「麦」の要素をデザインに取り込んでいます。キングイメージとしてはマント（？）、王冠、ステッキがあります。 \n髪型：こちらから見て右側にお団子\n表情：浮世離れした感じ。表情変化薄め。まろまゆ。特殊瞳孔\n身長：130〜140ほど。小さめ\n\n・イメージカラー：オレンジ、黄色\n\n構図やポーズなどはお任せします。\nイメージ資料も提示いたします。\nよろしくお願いします。\n\nhttps://drive.google.com/drive/folders/1dDVu9Yc0xtcMeC8czXbxbHBt_1tvsz4U", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Shisui0530/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3617865, "client_id": 3442315, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/34765ba7/uploads/origins/3dc5e670-93fa-4752-a63c-b46847173fa4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=70ed36a3e47bb10b67f1794147e5e85b", "srcset": "https://si.imgix.net/34765ba7/uploads/origins/3dc5e670-93fa-4752-a63c-b46847173fa4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=70ed36a3e47bb10b67f1794147e5e85b, https://si.imgix.net/34765ba7/uploads/origins/3dc5e670-93fa-4752-a63c-b46847173fa4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=1315182edf3afe30951509b5c6b3dc53 2x, https://si.imgix.net/34765ba7/uploads/origins/3dc5e670-93fa-4752-a63c-b46847173fa4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=5dcaa09abdc3134d0a4abc3e85665973 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/34765ba7/uploads/origins/3dc5e670-93fa-4752-a63c-b46847173fa4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3bbecf2ea573eddd1fd8afdc79795966", "srcset": "https://si.imgix.net/34765ba7/uploads/origins/3dc5e670-93fa-4752-a63c-b46847173fa4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3bbecf2ea573eddd1fd8afdc79795966, https://si.imgix.net/34765ba7/uploads/origins/3dc5e670-93fa-4752-a63c-b46847173fa4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=e4069819a3a65d7e8699d68eeb16592e 2x, https://si.imgix.net/34765ba7/uploads/origins/3dc5e670-93fa-4752-a63c-b46847173fa4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=9266f111601c7da887601501b1df985d 3x"}, "body": "しすいさん、いつもお世話になっております。長月です。\n\n今回は以前お願いしたかいマホ天使の水着SDを見たくてリクエストしました。\n\n星型のサングラスをかけていて、帽子のつばはフリルのようにフリフリしていて、材質は麦わらのイメージです。\n\n水着は首に紐を結ぶタイプで、首後ろがリボン結びになっています。\n\nズボンは風呂冷え立ち絵のような短パンです。こちらから見て左側の太ももにタトゥーがあります。\n\nピアスは錆びるためという理由から今回はついていないため、ピアス穴が見えてる感じです（もちろん描かなくても大丈夫です）\n\n浮き輪はデスイカという継続シナリオのトレーラーがスイカだったため、スイカの模様となっています。\n\n再度資料URLを添付しますので、なければご参照ください🙇‍♀️\n\nhttps://drive.google.com/drive/folders/1p87ICD_KaKn_GHd8suqi5hec0B7XtnZx", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@remiitaroooon/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 4036202, "client_id": 3442315, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/764f14fd/uploads/origins/74076761-79c9-4c4b-a995-1c8518cdf7f7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=509f475736376ab7457719877b85343f", "srcset": "https://si.imgix.net/764f14fd/uploads/origins/74076761-79c9-4c4b-a995-1c8518cdf7f7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=509f475736376ab7457719877b85343f, https://si.imgix.net/764f14fd/uploads/origins/74076761-79c9-4c4b-a995-1c8518cdf7f7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=71314b15668908f69c7878c2c0d0e7e1 2x, https://si.imgix.net/764f14fd/uploads/origins/74076761-79c9-4c4b-a995-1c8518cdf7f7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=006135e1dde82708b7d7d1bfc42f7598 3x"}, "duration": null, "nsfw": false, "hardcore": false, 