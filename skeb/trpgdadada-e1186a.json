", "tipped": false, "creator_id": 3617865, "client_id": 3442315, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/f072d5ae/uploads/origins/339c79b8-8b89-446f-b2ce-0293dde3d325?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ba5ba383a2bf76f0e0c5fb209fc3738d", "srcset": "https://si.imgix.net/f072d5ae/uploads/origins/339c79b8-8b89-446f-b2ce-0293dde3d325?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ba5ba383a2bf76f0e0c5fb209fc3738d, https://si.imgix.net/f072d5ae/uploads/origins/339c79b8-8b89-446f-b2ce-0293dde3d325?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=032647ca356c2c56fd35d9037ca3695e 2x, https://si.imgix.net/f072d5ae/uploads/origins/339c79b8-8b89-446f-b2ce-0293dde3d325?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=cf86241674b5a7ff762e55655ca17479 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/f072d5ae/uploads/origins/339c79b8-8b89-446f-b2ce-0293dde3d325?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a0f51013bb6ecdc21184455d8e57bd55", "srcset": "https://si.imgix.net/f072d5ae/uploads/origins/339c79b8-8b89-446f-b2ce-0293dde3d325?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a0f51013bb6ecdc21184455d8e57bd55, https://si.imgix.net/f072d5ae/uploads/origins/339c79b8-8b89-446f-b2ce-0293dde3d325?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=e94cc2abc7ec853d6c6ece0185b84577 2x, https://si.imgix.net/f072d5ae/uploads/origins/339c79b8-8b89-446f-b2ce-0293dde3d325?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=0a84f5db0e8c9f6c3b3a4537d409502f 3x"}, "body": "しすぴいつもお世話になってます！長月です！\n今回は『かいぶつたちとマホラカルト』の自探索者のSDを描いていただきたくリクエストさせていただきました。\n\n今回は資料にある夏バージョンの服装でお願いしたいと思います。\n\n白いシャツはシースルーです。\nわかりにくいですが目尻に黄色いアイシャドウがついています。\n太ももにあるのはタトゥーです。\n全体的に細いです。\n\n構図などはお任せします！\nよろしくお願いいたします！\n\nーーー\n\n【以下、参考程度のパーソナルです】\n\n156cm\n？歳\n無性別\n髪色：白\n目の色：黄緑（普段は伏せている）\n\n少年のような少女のような見た目の子。いい子のように見えるが、必要であれば同じ犯罪組織のメンバーと兄妹（弟）のフリをできるし、人を殺すことも犯罪をすることも躊躇いはない。根っからのアウトローである。\nサボれるところはサボろうとし、面倒なことと疲れることは嫌いなマイペース。不労所得万歳。\n\nファッションなどの流行のあるものに興味があり、ファッション誌を見たり服を買ったりするのが好き。\n\n腰あたりから枝のようなものが生えていて、光輪のようなものもあるが、消すことが可能。\n\nhttps://drive.google.com/drive/folders/1p87ICD_KaKn_GHd8suqi5hec0B7XtnZx", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@yasai_oisi1/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3761361, "client_id": 3442315, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/03411260/uploads/origins/826443a7-c818-4539-920a-71e2db260480?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6b39bc9e2b608f09df447ac9aabb4131", "srcset": "https://si.imgix.net/03411260/uploads/origins/826443a7-c818-4539-920a-71e2db260480?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6b39bc9e2b608f09df447ac9aabb4131, https://si.imgix.net/03411260/uploads/origins/826443a7-c818-4539-920a-71e2db260480?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=fba1d776d1a1c8a44a5b0f9758d97ea0 2x, https://si.imgix.net/03411260/uploads/origins/826443a7-c818-4539-920a-71e2db260480?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=332072e1bf74ea544dd95dfae4b20d38 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/03411260/uploads/origins/826443a7-c818-4539-920a-71e2db260480?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f9be64ab0f83f72528b6e9b04d634cc5", "srcset": "https://si.imgix.net/03411260/uploads/origins/826443a7-c818-4539-920a-71e2db260480?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&