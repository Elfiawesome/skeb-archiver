6932/uploads/origins/5d63d576-1766-4cab-8d24-d3ed42005c5e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=cf6e186cb40c9e39adde11e7b32ccdc6", "srcset": "https://si.imgix.net/ba5e6932/uploads/origins/5d63d576-1766-4cab-8d24-d3ed42005c5e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=cf6e186cb40c9e39adde11e7b32ccdc6, https://si.imgix.net/ba5e6932/uploads/origins/5d63d576-1766-4cab-8d24-d3ed42005c5e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=fb9db763fb37223b00c24439d192fc9e 2x, https://si.imgix.net/ba5e6932/uploads/origins/5d63d576-1766-4cab-8d24-d3ed42005c5e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=25795db72f10ab7e3067757be82881cd 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/ba5e6932/uploads/origins/5d63d576-1766-4cab-8d24-d3ed42005c5e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=7b15a96d65c40b31711d3f213dd91616", "srcset": "https://si.imgix.net/ba5e6932/uploads/origins/5d63d576-1766-4cab-8d24-d3ed42005c5e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=7b15a96d65c40b31711d3f213dd91616, https://si.imgix.net/ba5e6932/uploads/origins/5d63d576-1766-4cab-8d24-d3ed42005c5e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=61e6633f41599d1cf6f05a1704fcfa1b 2x, https://si.imgix.net/ba5e6932/uploads/origins/5d63d576-1766-4cab-8d24-d3ed42005c5e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=09115c9d212296fd7130064e8f77d379 3x"}, "body": "杜野様\nこんにちは。\n素敵なイラストに惹かれ、ぜひ自分の探索者を描いて欲しいと思いリクエストを送らせて頂きました。\n使用用途は個人鑑賞です。\n\n【キャラクター】\n樒直(しきみなお)\n「VOID」というクトゥルフ神話TRPGシナリオにて作成したPCをお願いしたいです。\nHO4でした。\n\n・旧型アンドロイド\n・黒髪に赤のメッシュ(？)\n・赤目で瞳孔は横長\n・目の下に逆三角形が2つずつ\n・一人称は「直」\n・敬語は使わず「今日の天気は雨の予報だ。明日の晴れを願って、今日は直とてるてる坊主を作ろう」と言うような話し方をします\n\n【要望】\n1枚絵のイメージでお願いしたいです。\nポーズ、雰囲気、構図等もお任せできたらと思います。\n戦闘ではなく日常風景のイメージです。\n衣装は参考画像のどれでも大丈夫です。\n\nご多忙かとは思いますが、検討して頂けましたら幸いです。\nどうぞよろしくお願いいたします。\n\n【参考】\nhttps://twitter.com/esutrpg/status/1575984833339092992?s=46&t=u1u4szreJd1E4OpRJ6Kwow\n\nhttps://twitter.com/esutrpg/status/1592444283331960832?s=46&t=u1u4szreJd1E4OpRJ6Kwow", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@morinonountiaka/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1895651, "client_id": 2080747, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/423d55ff/uploads/origins/e28b3483-4e5e-4f3b-8606-b12200843530?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e2d1ef9dac5583a64f5f3d9f281edd8b", "srcset": "https://si.imgix.net/423d55ff/uploads/origins/e28b3483-4e5e-4f3b-8606-b12200843530?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e2d1ef9dac5583a64f5f3d9f281edd8b, https://si.imgix.net/423d55ff/uploads/origins/e28b3483-4e5e-4f3b-8606-b12200843530?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=414163a1bac411c8ddc291d74e3f3ed8 2x, https://si.imgix.net/423d55ff/uploads/origins/e28b3483-4e5e-4f3b-8606-b12200843530?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=aa898885291f418d6e3f302206086f50 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/423d55ff/uploads/origins/e28b3483-4e5e-4f3b-8606-b12200843530?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=1a7fca641877df0be8337cc87bf98f31", "srcset": "https://si.imgix.net/423d55ff/uploads/origins/e28b3483-4e5e-4f3b-8606-b12200843530?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=1a7fca641877df0be8337cc87bf98f31, https://si.imgix.net/423d55ff/uploads/origins/e28b3483-4e5e-4f3b-8606-b12200843530?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=8086cc31b694327902a88efc1fe78a3c 2x, https://si.imgix.net/423d55ff/uploads/origins/e28b3483-4e5e-4f3b-8606-b12200843530?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=30fa00ed7ee6f00b9b4e8c5bf4cabf01 3x"}, "body": "杜野様、現在リクエスト募集中なのを確認して、イラストを描いていただきたく応募しました。\n\nクトゥルフ神話TRPGシナリオ、みやお様作『VOID』\nKP弥生いちご様卓で回っている以下のキャラ\n\nPC 敬称略/PL\nHO1：徐龍翔/なつか(依頼主)\nHO2：メイ/夜明さん\nHO3：天塩悠人/遠炉さん\nHO4：ケイ/杜野さん\n\nこの4人が一緒にいるイラストをお願いします。\nURLのツイートにある卓報告にアップしたスクリーンショットを参考資料にしていただけたらと思います。\n\n資料不足かつ、各PLさんが準備された絵柄が微妙に違うため難しいかも知れませんが、この4人が一緒に揃っている光景を杜野様のイラストで見たいと思っております。\n\n捜査中でも、休日などで私服を着てるなどでも構いませんので、杜野様が描いてて楽しくなるような4ショットをお願いします。\n\nhttps://twitter.com/natuka/status/1603157395206680577?s=61&t=1ocnjxdOwK-30nlDUz-qtQ", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@morinonountiaka/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1895651, "client_id": 1164612, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/46f1f3ca/uploads/origins/9cd633b0-da13-4fd0-abc8-267bb1bb5659?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5d3239ba8ea0321c8467fef75a3aef37", "srcset": "https://si.imgix.net/46f1f3ca/uploads/origins/9cd633b0-da13-4fd0-abc8-267bb1bb5659?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5d3239ba8ea0321c8467fef75a3aef37, https://si.imgix.net/46f1f3ca/uploads/origins/9cd633b0-da13-4fd0-abc8-267bb1bb5659?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f28d7930694cef3060663b043d71252c 2x, https://si.imgix.net/46f1f3ca/uploads/origins/9cd633b0-da13-4fd0-abc8-267bb1bb5659?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d67347bbc1a7913949ee2d630eefd6bb 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/46f1f3ca/uploads/origins/9cd633b0-da13-4fd0-abc8-267bb1bb5659?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9478b19554d75ee276295ce6eaf475a5", "srcset": "https://si.imgix.net/46f1f3ca/uploads/origins/9cd633b0-da13-4fd0-abc8-267bb1bb5659?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9478b19554d75ee276295ce6eaf475a5, https://si.imgix.net/46f1f3ca/uploads/origins/9cd633b0-da13-4fd0-abc8-267bb1bb5659?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=724e000aa40408c9a9430b4613c3668f 2x, https://si.imgix.net/46f1f3ca/uploads/origins/9cd633b0-da13-4fd0-abc8-267bb1bb5659?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=f016ed31e6b1059fa6a4d107844cf207 3x"}, "body": "こんにちは！\nskeb開設おめでとうございます！\nTRPGキャラで、自陣の２人を描いていただきたく依頼失礼します！\n\n【通過シナリオ】\nシュレディンガーの愛\n\n【キャラについて】\n兄：三角 已折(みつかど いおり)\n・包容力があり、何でも受け止めてくれる。\n・いつも柔らかな笑みを浮かべており、困っている人や悩んでいる人がいたら迷わず手を差し伸べる。\n・弟のことが大切。最近弟に甘えると言うことを覚えてきた。\n・ピアス穴が開いてない。ほくろ\n\n弟：三角 已代(みつかど いより)\n・大学生。兄のことが大好き。ブラコン\n・小さい頃から２人で暮らしてきたので最近まで兄にべったりだった。最近は自立すべく学業やらバイトに励んでいる。\n・最近なんでも１人で抱え込む性格だった兄が甘えてくれるようになったので嬉しい。\n・ピアスは左耳のみ空いてる(兄から貰ったお守り)\n\n【共通設定】\n・26歳と18歳の兄弟\n・双子並みに顔がそっくり(私が顔を寄せきれなかったんですが顔がそっくりっていう設定です…！)\n・仲のいい兄弟で、ずっと二人きりで暮らしてきたせいで距離感が普通の兄弟よりも近く見えるかもしれない。\n\n【構図】\n構図の指定は特にありませんが仲良さそう～～～に幸せそうな顔だったらそれで満足です…！！！\n\nhttps://twitter.com/smzm99/status/1644510233455382529?s=20\nhttps://twitter.com/smzm99/status/1644065077748985857?s=20", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [{"path": "/@tooro_loxia/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1914131, "client_id": 1895651, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/c51cf5af/uploads/origins/5cc1694e-8881-4626-9f1c-65db200675a8?bg=%23fff&auto=format%2Ccompress&fm=webp&fi