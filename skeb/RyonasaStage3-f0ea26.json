mgix.net/52a8b7c9/uploads/origins/4e1d5686-7caa-4e75-8923-cb0716ee4de4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a03e936f142f78f7cc6e4097d31dd838, https://si.imgix.net/52a8b7c9/uploads/origins/4e1d5686-7caa-4e75-8923-cb0716ee4de4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=28f7b780867d6f6cae1377ef8c32ce63 2x, https://si.imgix.net/52a8b7c9/uploads/origins/4e1d5686-7caa-4e75-8923-cb0716ee4de4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=deec65dd4550f79aced28ae3995fbf67 3x"}, "body": "りょなささんへ、初めまして、絵柄とか18G系もよく描かれてるのを見て依頼をしてみようと思いました。もしもお時間頂けるならよろしくお願いします。オリジナル一次創作を頼んでみます。(版権絵を頼もうとも思いましたが、自分は東方のこと詳しくない&りょなささんがどういう作品とか知ってるか分からないので)\n\n【拷問にかけられる女の子】\n概要\n・髪型はロングヘア。髪色はそちらの判断に任せます\n・おっぱいは大きい。りょなささんの過去絵など拝見しましたが、慎ましやかなのが多い気もしましたが、今回は大きいのでお願いします。ラノベアニメとかで見るような巨乳キャラみたいな大きさのやつで\n・服装はそちらの自由でお願いします\n・可愛い女の子で頼みます\n\nシチュエーション\n・どこか地下室にて、腕をロープまたは鎖で縛られ、天井に吊るされている\n・おっぱいを傷つけられる拷問を受けている。服は胸部分が破れ、晒された乳房には痛々しい切り傷がいくつも刻みつけられて流血している\n・おっぱい以外はあまり傷ついてない\n・顔は無傷でお願いします\n・表情は、憔悴しきって泣いている\n・乳首は「髪ブラ」の方法で隠れている\n・画内には、この女の子1人だけが映っている構図でお願いします\n\nこのようなのですが、描けそうでしたらよろしくお願いいたします。", "nc": 187, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 40259, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "かりん🔞Skeb&依頼受付中", "screen_name": "mofmof_r", "avatar_url": "https://pbs.twimg.com/profile_images/1852496883073314816/mczowKZw.jpg", "header_url": "https://pbs.twimg.com/profile_banners/3244134714/1568286781/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 7, "complete_expiration_days": 120, "skills": [{"genre": "art"}, {"genre": "comic"}], "nc": 49}, {"id": 40886, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "みさほみ