al_appeals_count": 0, "received_works": [{"path": "/@marotanidatta8/works/176", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1226244, "client_id": 1363570, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/14aafcfb/uploads/origins/52283135-2d5b-4d9c-b10f-ad72a4b91e96?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fd2c0f00406bc4a21c08aeb1ede26fdc", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/14aafcfb/uploads/origins/52283135-2d5b-4d9c-b10f-ad72a4b91e96?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f259502eb21e4c136a5a12bae5c5a414", "src_set": ""}, "body": "やあ、まろ谷。\nScreWだよん🫰\nボーナスが入ったので依頼しようと思ってね😉✨️\n\n今回は超絶豪華もりもりシチュエーションです！！！！\n\nその名も『両手に花』\nギョッとしたな？したよな？？\n\n大丈夫、安心してくれ。健全だ。\n\nScreWの両サイドにすーちゃん＆しょたりゅ〜が寝ていて、その2人に寄りかかられながらこちらをソファに座り、いつものクールな笑い方で見てるイラストをお願いしたいです！！\n本体は一体(いつもの姿)で大丈夫です！しょたりゅ〜に寄り添っててください！可愛いからね、ぬくもり大事！\n\nPCの壁紙とかに使用させていただければと思います！！\n煩悩まみれの依頼ですが、何卒よろしゅうお願いします！\n\nP.S  最大の愛をあなたに。", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@marotanidatta8/works/175", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/10e489c5/uploads/origins/bafa58fb-0405-4217-a53b-85ef9b925e95?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=a8f979cad8e040c1ba98a7f82e6bab5c", "src_set": ""}, "private": true, "genre": "art", "tipped": true, "creator_id": 1226244, "client_id": 2887643, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 17, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@marotanidatta8/works/174", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1226244, "client_id": 2123209, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/e637eb8f/uploads/origins/eb633c47-0fde-4394-bae6-0a14e7b5e748?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e7e489612bfc40e0947682a7b3a05021", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/e637eb8f/uploads/origins/eb633c47-0fde-4394-bae6-0a14e7b5e748?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=8b2be71509dba5826937d9967b9634b7", "src_set": ""}, "body": "こんにちは！\n以前、浴衣のイラストを依頼させていただいた天ヶ瀬葵麗です！\n素敵なイラストありがとうございました！！\nもう一度イラストをお願いしたく依頼送らせて頂きました…！\n\n〈希望構図〉\nケーキ頬張ってる、又は食べようとしている様な構図をお願いできらたと思います。\n\n ・使用用途：Vtuber活動での使用\n（配信サムネイル、SNSアイコンやヘッダー・告知、PC壁紙など） \n・可能でしたらPSDファイルで背景とサインのON/OFFができたら嬉しいです。\n\nXにて固定してあるポストの画像をご覧いただける様資料URLにて載せさせて頂きました！\n御検討よろしくお願いいたします！！\n\nhttps://x.com/amagase_kiri/status/1744870226775486584?s=46&t=qB_b8cP0MW3E2LyriPt0MQ", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@marotanidatta8/works/173", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1226244, "client_id": 3349094, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/3effc87e/uploads/origins/e38be6a4-eb81-4257-9526-0e2c4e832218?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ae66cb28b4d52d7991f44909f06f8b50", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/3effc87e/uploads/origins/e38be6a4-eb81-4257-9526-0e2c4e832218?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c89696eb76bea9582b3c8e58f7c70945", "src_set": ""}, "body": "まろ谷様\n\nお世話になっております。\n個人で活動しているVtuberの沫雪ゆうりと申します。\n\n以前は素敵なイラストを本当にありがとうございました！\n\nこの度も是非お願いさせていただきたく\nリクエストをお送りさせていただいております。\n\nご依頼内容といたしましては、以下を予定しております。\n\n**********\n\n▶使用用途\n・Twitter、Youtubeでのアイコン・ヘッダー・告知画像等\n・Youtubeの歌枠や雑談配信でのサムネイル等\n\n▶イラストについて\n・普段サムネイルなどで利用するイラストをお願いしたいと考えております。\n\n・歌っているようなイメージのイラストだと嬉しいです。\n\n・胸の大きさは〜Bほどのイメージで、ささやかであると嬉しいです。\n\n・背景やポーズ、小物等もお任せいたします。\n小物やメッシュなど、少し細かい設定がいくつかあります。\nお手数をお掛け致しますが、ご確認をよろしくお願いいたします。\n(新たに三面図の画像資料を追加いたしました)\n\n▶サイズや解像度について\n・解像度や、サイズはお任せいたします。\n描きやすいサイズでよろしくお願いいたします。\n\n・キャラが映えると思いますので、縦長だと嬉しいです。\n\n▶希望の納品形式について\n・PSD\n・背景、人物、サインのレイヤー分けをお願いいたします。\n\n▷キャラ情報\nhttps://drive.google.com/drive/folders/1BhUNnDM1HQJyUQmz8wBQ7NGLD_hyCAgB?usp=sharing\n\n\n▷他イメージ\n・普段は「みんなに癒しを届けたい」をモットーに、癒し系雪猫Vtuberとして活動しております。\n\n・イメージカラー：白、水色\n\n**********\n\nここまでお目通しいただきありがとうございました！\nご検討、よろしくお願いいたします。\n\n沫雪ゆうり\n\nhttps://drive.google.com/drive/folders/1BhUNnDM1HQJyUQmz8wBQ7NGLD_hyCAgB?usp=sharing", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@marotanidatta8/works/172", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1226244, "client_id": 3559579, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/ffce7718/uploads/origins/aa34f51b-3ba5-41ac-b336-ae6701012a12?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0b0374024e2a99579fd1d93d7d89c3e2", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/ffce7718/uploads/origins/aa34f51b-3ba5-41ac-b336-ae6701012a12?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9e4c65eb91a32d03b36ad126bcf953f2", "src_set": ""}, "body": "初めまして、VTuberの神月天と申します。\n私自身を描いていただきたいです。\nお手数ですが以下、ご確認いただけますでしょうか。\n\n■使用用途\n・配信や動画のサムネイル\n・SNSでの掲載、アイコンへの使用など\n\n■お願い\n・構図の指定はございませんが、人物の頭や左右が切れない構図ですと幸いです。\n・サムネイルで使用できるよう、人物のみの透過を合わせてPNGかPSD形式でいただけますと幸いです。\n\n■ポイント\n・髪飾りの月の真ん中の紫の部分は穴が開いているわけではなく宝石がついているものです。\n・3面図を資料URLに貼らせていただきます。\n\n以上になります。\nご検討の程宜しくお願いいたします。\n\nhttps://drive.google.com/file/d/1fjBz7xTAQKC1HmH-R7FZ2RsXFKWlqL5Y/view?usp=drive_link", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@marotanidatta8/works/171", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1226244, "client_id": 2084435, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/69c078f6/uploads/origins/87673b25-7a14-428a-8c55-da93e0754f8e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8aedfa564d7956f3045e25bc2df53754", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/69c078f6/uploads/origins/87673b25-7a14-428a-8c55-da93e0754f8e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=fd4295d9ed5eb7c089e2d36c92e59844", "src_set": ""}, "body": "まろ谷様\n\nYouTubeで活動をしている個人Vtuberの戌衣もちと申します。\nいつも素敵なイラストありがとうございます\nこの度も自身の事も描いていただきたくリクエストさせていただきました。\n\n戌衣もちについて\n普段はゲームやマダミスのGMなど興味があるものを配信しており\n苦手ながらホラゲーなどもプレイしています。\n戌に化けてる餅のVtuberということで正体はお餅となっています。\nVtuber状態では化けていますが、素の姿は丸いお餅のような姿\n普段着用しているのは和服ですが、服装を創作される際洋服・中華などNGなしです。\n性格としてはまったりとしておりマイペースになります。\n\n使用用途について\n配信のサムネイルやスケジュールなどにも使用させていただきたいと考えております。\n\n詳細\n本などを読みながら朗読をしているような戌衣もちを描いていただけないでしょうか\n重ねてのお願いですみませんが、上部や左右で見切れが発生しないようにしていただけると幸いです。\n\n以上、不躾なリクエストになっていたら申し訳ありませんが、ご検討のほど何卒よろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/1NA9527CZXTRWO6vB7VpD74SoTgzq724p?usp=drive_link", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@marotanidatta8/works/170", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1226244, "client_id": 1363570, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/4f552e5d/uploads/origins/a96d9d97-1018-4050-a1dd-d502e2acc2a8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=19901492fae5a4dac3a7a1cc78c5c4bc", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/4f552e5d/uploads/origins/a96d9d97-1018-4050-a1dd-d502e2acc2a8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=46124183750c6a9c1da2110fc890c1f9", "src_set": ""}, "body": "やあ、まろ谷。\nSkeb開放待ってたよ😉\n\nねえねえ、あのね。\n戦闘立ち絵を過去に描いてもらったんだけどさ！あれの第2形態描いてもらいたいな！！\nまさしく！\n【暴走形態】！\nふたつでひとつのScreWのバランスが崩壊して制御できなくなるのって少し怖くて好きなんです私…！\n\n構図は\n目がついた右腕の侵食が激しくなり、人型が焦り？絶望みたいな表情で涙を流してるScreWが見たいです！押さえ込もうもしてたらなおさら私は興奮します。\nまろ谷の描く、恐怖顔的なの見たことないから、私、見てみたいな…！👁️👁️👁️👁️", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@marotanidatta8/works/169", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1226244, "client_id": 1363570, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/1ac4c9de/uploads/origins/5229db86-26dc-430e-9629-fbc0059f33e1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=917d0c2ee2ed775f0dfea23ea070b66a", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/1ac4c9de/uploads/origins/5229db86-26dc-430e-9629-fbc0059f33e1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c322957ea0beb787a3945b12fd75a16c", "src_set": ""}, "body": "やっほ〜！まろ谷〜！\nウチだよ！すーちゃんだよ〜！😆✨️\n今日はね！しょたりゅ〜も一緒なの！！！\n\nまろ谷にさ、ウチらのこと描いて欲しいんだよね！！いいかな？🥺\n\n衣装はね、近くのド○キにあったから買ってきたんだよ！\nじゃじゃーん！！メイド服！✨️✨️\n \nもちろんしょたりゅ〜の分もあるよ！\n嫌がってる顔してるね…ｴﾍﾍ…でも着させるもんね！！‪買っちゃったもん！😖💧‬\n\n\n\nおう、まろ谷。\nScreWだよ！さっきはどうも！\n詳しい構図はオレから説明させてもらうぜ。\n\nすーちゃんとしょたりゅ〜のメイド服が見たい…！！！！！\nオレはダメな大人だ！！\n\nすーちゃんはノリノリでハートマーク作ってて、しょたりゅ〜は恥ずかしそうに嫌がる2人のメイド服が見たいんだ！！！！！\n\nまろ谷、頼む。\nオレ妄想だけで狂いそうだ。現実に変えてください😭ｳｵｵｵｵｱｱｱｱｱｱｱｱｱｯｯｯｯ!!!!!", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@marotanidatta8/works/168", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/72a5a5bd/uploads/origins/772e8559-aac0-4615-9c0c-9d33d3d8a03e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=b6bbf51932b31de83dd835747f1e5808", "src_set": ""}, "private": true, "genre": "art", "tipped": false, "creator_id": 1226244, "client_id": 3027849, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 0, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@marotanidatta8/works/167", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1226244, "client_id": 3370099, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/6fc78750/uploads/origins/079e2b35-cb30-43f0-a369-059da83c2889?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e297a0723f4bf1b6e3c2cf5d515a2d25", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/6fc78750/uploads/origins/079e2b35-cb30-43f0-a369-059da83c2889?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=630442c373ddb354842dd19e2ab8082f", "src_set": ""}, "body": "まろ谷様\n\n\n\nはじめまして。ないんと申します。\n日頃よりまろ谷様の作品や配信を楽しく拝見しております。いつも素晴らしい作品をありがとうございます。\n\nところで、私は2025年に20歳を迎えます。そこで、自分への成年祝いとして大好きなまろ谷様に依頼をさせていただきたい所存です。どうかよろしくお願いいたします。\n今回、初めてSkebを利用して絵のリクエストをさせていただきます。不慣れなため、至らぬ点がございましたらご容赦願います。\n\n --- \n\nリクエストの内容は以下の通りです。\n\n・使用用途: 各種SNSのアイコン、スマートフォンやPCの壁紙 (友人とのゲームやTRPGの際に画面に透過して表示する可能性有)\n ・キャラクター: 人間 (男性) \n・モチーフ: 資料URL参照 \n・服装: 自由 \n・髪型: 自由 \n・特徴: 琥珀色の瞳、明るめの水色の髪 \n・構図: 自由 \n\n・可能であれば、SDを添えてもらいたいです。\n・お手数でなければ、レイヤーの分けたデータも頂きたいです。\n\n全体の色味以外はまろ谷様のご裁量にお任せしたいと考えております。自由に、楽しく描いていただければ幸いです。\n\n--- \n\n以上が依頼内容となります。ご検討のほど、よろしくお願いいたします。内容や金額などについて問題がございましたら、キャンセル・再送要求をお願いします。まろ谷様の作品を楽しみにしております。\n最後に、これからの活動も陰ながら応援しております。お身体に気をつけてお過ごしください。\n\n\n\nないん\nhttps://x.com/nine_valentine?s=21\n\nhttps://drive.google.com/drive/folders/1hykid7v-qL2FQLA4Z5JWfnhond8WFvdl", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@marotanidatta8/works/166", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1226244, "client_id": 315868, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/13748b65/uploads/origins/b775278c-d34f-4c97-a79f-d329d7d73a3f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4386de5b56b1b6bbbcb81f0ec9007e41", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/13748b65/uploads/origins/b775278c-d34f-4c97-a79f-d329d7d73a3f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c995f5b48e9b9814edb3d05fa3e2fb9a", "src_set": ""}, "body": "初めまして、新着イラストからお見かけして絵柄に惹かれてリクエストさせていただきました。\n宜しければ自分を描いていただけたら嬉しいです！\nYouTubeで活動しているのでasmr動画のサムネイル等に使わせていただきたいです。\n顔メインで良い感じに描いていただけたら嬉しいです。\n構図、背景の有無などはお任せします。\npsdファイルか、またはキャラクターが透過済みのものがあると嬉しいです。\n宜しければお願いいたします！\n\nhttps://drive.google.com/drive/folders/1u0SxFPxwSqWjaV92AXpvYdTM8_deOOXS", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@marotanidatta8/works/165", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1226244, "client_id": 1560323, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/d7b4b444/uploads/origins/5cb3be0c-0c76-48ad-95a9-d406c19f69d1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f19b025dfb7a6df4d1b551c389eebe9b", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/d7b4b444/uploads/origins/5cb3be0c-0c76-48ad-95a9-d406c19f69d1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=539cfee27953dd5a4cbe85c5429b1ba2", "src_set": ""}, "body": "まろ谷様、こんにちは。前回はお世話になりました。\n\n今回リクエストしたい内容はこの前にまろ谷さんが描いた理ちゃんと他の衣装です。髪の尾の色は次第に黒くなっています。自分の存在意義を探す旅で心を少しずつ開いていき、笑う姿を描くことができたら幸せです。\n\n困らせたり、条件が難しければキャンセルしても構いません。お気にせずにお願いします。  \n\nご検讨いただきありがとうございます。\n\nhttps://drive.google.com/drive/folders/1-YW682t_dvLUSjJoYb2y-df4X5R9mMC0?usp=drive_link", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@marotanidatta8/works/164", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1226244, "client_id": 27685, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/0263e4cc/uploads/origins/2f96d7eb-5f45-4325-9cad-b9ae21be6886?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ca9872b85cbd9abf8d578fabe2ee5029", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/0263e4cc/uploads/origins/2f96d7eb-5f45-4325-9cad-b9ae21be6886?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6d57bef21fb62e632476a57d0eedcc07", "src_set": ""}, "body": "まろ谷様\n\nこんばんは、まろ谷様。\nツイッターとスケブからイラストを拝見させて頂いてファンになったものです。\n女の子たちの表現がすごく可愛くて惚れちゃいました…！特に顔の表現が好きです！\nそんなまろ谷様がスケブを開いていらっしゃることを知り、もしよろしければこちらのオリキャラのことを依頼したいです。\n\nお願い申し上げたいのはこちらのオリキャラ狐娘の万里香（まりか）という子です。\n狐耳と尻尾・赤メガネ・アホ毛、そしてちょっぴりツリ目な目つきが特徴的な、160cmくらいの身長の子です。\n本とか、動物や花、星空のような自然をぼーっと見るのが大好きな子です。\n性格的には、ちょっと人見知りで照れ屋ですので人前では余計にクールっぷりしてるけどまた寂しがり屋のちょっと面倒くさい感じです。一人の時や知り合いの前では表情が緩めてちょっと豊かになる感じです。\nこれだけではちょっと説明が足りないと思いますので設定と設定画など、ご参考できそうなものを下のURLにまとめております。\n\nこの娘でまろ谷様の絵柄でのイラストをどうかお願いしたいです。\n衣装は設定画のうちの一つで、本を楽しんでるところがみたいです。\n他はどうかご自由にお願いします！\nご検討くださいませ！\n\nお忙しい中、要件のみで申し訳ありません。\n応援しております！\n\nhttps://drive.google.com/drive/folders/1kVcp6B8dzGYFGpFb9spMTyDnz0TzyM7Q?usp=sharing", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@marotanidatta8/works/163", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1226244, "client_id": 203995, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/1e1f1c5e/uploads/origins/bdd648e7-3aac-4ef4-ace2-d9ed50f966dc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8154b51465110f6b8501a86fb7de4fbd", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/1e1f1c5e/uploads/origins/bdd648e7-3aac-4ef4-ace2-d9ed50f966dc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=740181d710ca3ba481dabfc7479d72b5", "src_set": ""}, "body": "まろ谷さま、はじめまして！\n洗練された色遣いやデザイン、かっこよくてかわいいキャラクターのイラストに惹かれてリクエストをお送りいたしました。\nXも拝見しましたが、アイコンの方のデザインや表情がとても素敵です。\n\n今回のリクエストでお願いしたいのは、自創作で使っているOC2人になります。\n世界観は、異形(死霊やアンデッドなどのイメージです)と戦うホラー寄りの現代和風ファンタジーです。\n用途は個人・非商用の範囲です。製作者様を明記の上でご依頼した作品としてSNSやサイトなどに掲載させていただく可能性があります。\n\n以下、キャラクターの詳細です。\n二人とも妖魔の血を引いており、長命で外見年齢より実年齢はかなり高いです。\n\n【史朗】男性\n・年齢：外見10〜20代(不詳な感じ)\n・身長／体格：163cm／スレンダー\n・性格：安定している、余裕がある、お茶目、のんびり、話上手の聞き上手、打算的、ちゃっかり\n・特徴：にっこりタイプの糸目(たまに開ける、目つきは鋭め)、短めの太眉、ピアス、和装\n・設定＆モチーフ：大狸の妖魔を祖先に持つ(大きな妖狸の姿になれる)、場数を踏んでいおり戦闘能力や状況把握能力が高い、風、短刀、鎖鎌\n\n【ほむら】女性\n・年齢：外見10代前半\n・身長／体格：146cm／スレンダー\n・性格：明るい、行動的、せっかち、社交的、苛烈、割り切りが良い\n・特徴：ツインテール、犬歯、セーラー服\n・設定＆モチーフ：狐の妖怪を祖先に持つ(7本の尾を持つ大きな妖狐の姿になれる)、堅苦しいのは苦手で自由を好む、放浪癖がある、炎、刀\n\n史朗は狸、ほむらは狐の耳や尻尾が生えている状態で描いてもらっても大丈夫です。その場合も人間の耳は残ります。\n\n【２人の関係・構図など】\n恋愛感情は一切なく、昔馴染み、腐れ縁、仕事仲間、悪友、ライバル、といった関係性です(史朗の方が戦闘は強いですが、人間関係においては対等)。\n若い頃は非常に仲が悪かったのですが、今はお互いの付き合い方を学び良好な関係を続けています。\n\n【希望】\n・PSD形式で文字のオンオフができると助かります。\n・シチュエーションは以下のどちらかを希望します。\n　➡シチュエーション①：明るめの雰囲気。二人とも笑っていて、現代服(先生に是非デザインしてもらえると嬉しいです)で背中合わせなどのポーズ。\n　➡シチュエーション②：かっこいい雰囲気。それぞれ風と炎とともに武器を構えており、戦闘中に連携して戦っている場面。\n\n上記はあくまで例ですので、最終的には先生のイメージ優先で楽しく描いていただけると幸いです。\n\nお手数おかけして恐縮ですが、不都合がありましたらキャンセルや再送をお願いします。\n以上です、リクエストを読んでいただきありがとうございました！\nご縁がありましたらよろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/1MS4dvmoBJg7CcbzORwJUrbpphmE470rv", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@marotanidatta8/works/162", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/b2343f2c/uploads/origins/6fe67584-4e7c-48c5-9a14-ad489d86ccc1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=71b5a6bd758241b2f3ea737e3733b8d7", "src_set": ""}, "private": true, "genre": "art", "tipped": false, "creator_id": 1226244, "client_id": 0, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 128, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@marotanidatta8/works/161", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1226244, "client_id": 2072575, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/2ea84829/uploads/origins/18720974-0545-4795-8294-dd43cf34f109?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c03d315884946a1bce48648b58b501c0", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/2ea84829/uploads/origins/18720974-0545-4795-8294-dd43cf34f109?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=35278bfae40b50768456df839c5a43a9", "src_set": ""}, "body": "まろ谷さんこんにちは！\n勝手ながらいつも本当に大変お世話になっております。\n\n前回は設定資料風というリクエストを叶えていただきありがとうございました！\nデスクトップ背景にして毎日沢山ご飯をおかわりし続けています🍚\n\nところで私はデュアルディスプレイ環境（＋場合によって液晶タブレット）で、\nいまその片方で設定資料鬼娘をデスクトップ背景にしているのですが\n毎日見れば見るほどもう片方のディスプレイにゲームのキャラクター紹介みたいな\nザ・鬼娘達な感じの立ち絵イラストが並ぶ日を夢見ています💤\n\n是非、鬼娘達を紹介するような代表的（※）な一枚をリクエストさせてください！\n恒例ではありますがキャラクター以外はすべてお任せします。\n\n※代表的、といえば一番最初に描いていただいたイラストは今も至高です。\n　その後描いていただいたものも勿論ですが最初の一枚は思い出含めて宝物…🙏✨\n\n用途として、出典明記のうえで自身のSNS(X/discord等)アカウントや\nTRPG等での使用、投稿を許可いただけると幸いです。\n（レイヤ分けしてあると非常に嬉しいです！）\n\n以上、何卒よろしくお願いいたします。\n\nhttps://skeb.jp/@marotanidatta8/works/147", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@marotanidatta8/works/160", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1226244, "client_id": 1363570, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/98012f30/uploads/origins/20315270-5e0e-4bb7-809e-4f67cbd4f41d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=73145a5a49735a95513ecdfc7d1c5a72", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/98012f30/uploads/origins/20315270-5e0e-4bb7-809e-4f67cbd4f41d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2a12d75906692bf65836a7cc1a599600", "src_set": ""}, "body": "やあ、まろ谷。\n11月に入って寒くなってきたね。体調は問題ないかい？\n\nオレは、この前ある夢を見たんだ。\nそれをまろ谷に実現して欲しいと思ってね…。\n\nその内容はね、「お互いの衣装を交換する。」っていう概念的な物だったんだ。\nその事象を確認した時、痺れたのさ。\nオレの脳みそがな。\n調べたらわんさか出てきた。同じことを考える同志達がこんなにもいた事に感動したのさ。\n\nオレの衣装を着るまろ谷が見たい！！！\nまろ谷の衣装を着るオレが見たい！！！\nツーショットで！！！！とね。\n\n構図はお互いの服を着たら「きっとこんなポーズするだろうな！」ってのをまろ谷のイメージで再現して欲しいんだ！\n\n頼む！オレの見た夢を、実現してくれ！！！🙏", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@marotanidatta8/works/159", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/f9b2e1ad/uploads/origins/abb9b6dc-d21d-47b1-8d16-c1d861422d4e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=7103f0a2a354096bd234610bb62bf2c7", "src_set": ""}, "private": true, "genre": "art", "tipped": true, "creator_id": 1226244, "client_id": 1238013, "vtt_url": 