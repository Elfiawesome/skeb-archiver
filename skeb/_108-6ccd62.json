役：ワーム系の触手、先端は人間のような口・歯・舌がついている。\n触手が苦手な場合は目無しのモブ系青年で。\n内容：クリスが竿役におっぱいを（性的に）食べさせている様子。\n乳首を吸ったり吸い尽くしたりしゃぶったり舐め回したり噛み潰したり（可能なら舌でニプルファックしたり）と、乳首をメインにおっぱいが責められている様子をお願いしたいと思います。\nおっぱいメインなので下半身責めは考えていませんが、もし描いていただける場合はスタンダートにずっこんばっこんして中出ししまくって、といった感じでお願いできればと思います。\n備考：psd納品希望\n\nよろしくお願い致します。\n\nhttps://medicos-e-shop.net/products/detail/15941", "nc": 40, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@_108/works/8", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 544796, "client_id": 2414879, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/2344cf3b/uploads/origins/8a908922-8288-4943-8479-b5284c2a1695?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=cf20f9162ecf2706256c3ae3e703f07c", "srcset": "https://si.imgix.net/2344cf3b/uploads/origins/8a908922-8288-4943-8479-b5284c2a1695?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=cf20f9162ecf2706256c3ae3e703f07c, https://si.imgix.net/2344cf3b/uploads/origins/8a908922-8288-4943-8479-b5284c2a1695?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=6b2a92352da2d0151d9b9212c53a5176 2x, https://si.imgix.net/2344cf3b/uploads/origins/8a908922-8288-4943-8479-b5284c2a1695?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a2ee7fbcbc034873c5f3a630dc3239d2 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/2344cf3b/uploads/origins/8a908922-8288-4943-8479-b5284c2a1695?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=7852e888429f25dbf030e8274709831d", "srcset": "https://si.imgix.net/2344cf3b/uploads/origins/8a908922-8288-4943-8479-b5284c2a1695?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=7852e888429f25dbf030e8274709831d, https://si.imgix.net/2344cf3b/uploads/origins/8a908922-8288-494