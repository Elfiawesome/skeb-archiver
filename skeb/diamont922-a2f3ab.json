-444b-4401-abd7-c07f2eadb991?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=2064f33749d513fc9a041bb1fc717f8e 2x, https://si.imgix.net/1cf4336b/uploads/origins/95c02ba1-444b-4401-abd7-c07f2eadb991?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=4a45cbf379a4c4899baf204c10bf9b8f 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/1cf4336b/uploads/origins/95c02ba1-444b-4401-abd7-c07f2eadb991?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a742ac6fb36806cdd0c50fc1f10fb345", "srcset": "https://si.imgix.net/1cf4336b/uploads/origins/95c02ba1-444b-4401-abd7-c07f2eadb991?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a742ac6fb36806cdd0c50fc1f10fb345, https://si.imgix.net/1cf4336b/uploads/origins/95c02ba1-444b-4401-abd7-c07f2eadb991?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=37ded6968e45849c0d618e52f0867629 2x, https://si.imgix.net/1cf4336b/uploads/origins/95c02ba1-444b-4401-abd7-c07f2eadb991?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=878cd86466c443d588f706ad6e0c039e 3x"}, "body": "初めまして、秋良と申します（skebのアカウント名と違うのは気にしないでください）\nXにてskeb募集中の投稿を拝見し、素敵なイラストに惹かれたため、リクエストを送らせていただきます。\n可能であれば当方が管理するOCを描いていただきたいです。\n\n【リクエスト内容】\nイラストの構図：おまかせします\n希望：キャラに私服っぽい衣装を着させてあげてほしいです。\n\n描いていただきたいキャラ：女性\n\n…特徴：ほぼグレーの茶髪に黄緑色のインナーカラー\nインナーカラーの部分はほぼ黄色にしてもいいし、青緑系でも大丈夫です。\n（Googleドライブの資料は自分で描いたイラストです）\nhttps://drive.google.com/drive/folders/1CHQU5WNfyQYtFMMSBoW4I9oxF09MQb9z?usp=sharing\n\n【使用用途】\n・SNSでの公開（X、bluesky、Misskey、youtube、bilibiliなど）\n・アイコン、ヘッダー、動画サムネイルでの使用（チャンネルは収益化してません）\n・個人サイト、Charaforioへの代理投稿\n・考案していただいた衣装デザインをもとに自分（もしくは他者にお願いして）でイラストを描く\n…それの同人誌収録、収益が発生するグッズの制作\n\n※納品していただいたイラストは必ず先生のお名前を記載いたします\n※納品イラストそのものの商用利用はいたしません\n\n何卒ご検討宜しくお願い致します。\n主にイラストを公開するXアカウントは（@ axe_square）となります。\n\nhttps://drive.google.com/drive/folders/1CHQU5WNfyQYtFMMSBoW4I9oxF09MQb9z?usp=sharing", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@8asys/works/72", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2606280, "client_id": 2008551, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/d0bed465/uploads/origins/afc33b21-8463-4348-9773-985b9f6ffaca?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3ffc4ad4a79572668a2ac41bc8752239", "srcset": "https://si.imgix.net/d0bed465/uploads/origins/afc33b21-8463-4348-9773-985b9f6ffaca?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3ffc4ad4a79572668a2ac41bc8752239, https://si.imgix.net/d0bed465/uploads/origins/afc33b21-8463-4348-9773-985b9f6ffaca?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=d7c43ebbae8ba4a845df3f49008bd65f 2x, https://si.imgix.net/d0bed465/uploads/origins/afc33b21-8463-4348-9773-985b9f6ffaca?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=9540f2b9410833e97e0852f286f475c4 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/d0bed465/uploads/origins/afc33b21-8463-4348-9773-985b9f6ffaca?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=987976707dd69455a6317af5ab9e4b62", "srcset": "https://si.imgix.net/d0bed465/uploads/origins/afc33b21-8463-4348-9773-985b9f6ffaca?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=987976707dd69455a6317af5ab9e4b62, https://si.imgix.net/d0bed465/uploads/origins/afc33b21-8463-4348-9773-985b9f6ffaca?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=b364180a05a4a0084b592231a4a8787a 2x, https://si.imgix.net/d0bed465/uploads/origins/afc33b21-8463-4348-9773-985b9f6ffaca?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=ad2f81149d6afde4e0b20e49ab0fb96b 3x"}, "body": "朝よし先生\n\nいつも素敵なイラスト拝見しております。再度OCのイラストをリクエストさせていただきます。\n\n【内容】\n・OCのバストアップイラスト＋SDイラスト\n\n【キャラ詳細】\n・少年\n・見た目12~14歳（実年齢不明）\n若干中性的、細身、黒髪のややくせ毛を一つ結びにしている\n・紳士的な性格。若い見た目に反して余裕があり、いつも堂々としている。\n\n…若い少年キャラクターですが、大人っぽくなっても大丈夫です\nなんなら「成長して青年になった姿」を想像で描いていただいでも嬉しいです\nすべてお任せします\n\n【使用用途】\n・個人鑑賞、自分用のグッズ制作\n・SNS公開、個人サイト掲載\n・アイコン、動画サムネイルへの使用\n・UTAU音源配布時の資料…限定的二次配布に当たります。それ以外の二次配布は致しません。\n\nなおすべて非商用です\n資料はGoogleドライブの方にまとめてあります（資料Aの衣装以外でお願いします。なんでもいいです。）\n\n歌声→ https://utaloader.net/music/20250825003007232984\n\nhttps://drive.google.com/drive/folders/16QnZuo9eV4amRuiTCkYRpLBD7UGP4KMV?usp=sharing\n\nご検討よろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/16QnZuo9eV4amRuiTCkYRpLBD7UGP4KMV?usp=sharing", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@8asys/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2606280, "client_id": 2008551, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/1920f0f2/uploads/origins/2979fd36-3c89-466f-a9c1-9c78d823f04a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=45f8044be8bf48ccd936506b6841373c", "srcset": "https://si.imgix.net/1920f0f2/uploads/origins/2979fd36-3c89-466f-a9c1-9c78d823f04a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=45f8044be8bf48ccd936506b6841373c, https://si.imgix.net/1920f0f2/uploads/origins/2979fd36-3c89-466f-a9c1-9c78d823f04a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=41ac27e790d356b2a2e84b008863e079 2x, https://si.imgix.net/1920f0f2/uploads/origins/2979fd36-3c89-466f-a9c1-9c78d823f04a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=5c18252b3c5d5f7d7c9fb9cbeafc4c55 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/1920f