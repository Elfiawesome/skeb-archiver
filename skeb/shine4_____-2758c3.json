format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=8e93ba688831956bd2e26e8eace5962e", "srcset": "https://si.imgix.net/a66a08f2/uploads/origins/4ff896b6-93eb-400f-9de9-cd06ce112d6a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=8e93ba688831956bd2e26e8eace5962e, https://si.imgix.net/a66a08f2/uploads/origins/4ff896b6-93eb-400f-9de9-cd06ce112d6a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=aebf053c340b7809f741761bc7f655fb 2x, https://si.imgix.net/a66a08f2/uploads/origins/4ff896b6-93eb-400f-9de9-cd06ce112d6a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=05e9b7ad53ce28eee7a0704e0f886b6b 3x"}, "body": "毎々お世話になっております。新規リクエストのため、メッセージを差し上げております。ご多忙とは存じますが、ご検討くださいますと幸いです。  以下、詳細になります。\n\n  ・黒髪おかっぱメガネの女の子(毎々同じで恐縮ですが、以前からご依頼させていただいている子です) \n・全身黒のサブカルロック系ファッション(レッグカバー\n・底厚めの黒ブーツをまじえてくださいますと幸いです) \n・タバコをカートンでプレゼントされ、目を細めて喜んでる(ピースしているとうれしいのですが、構図上難しければ自由にご変更ください) (タバコ：ラッキーストライク・ボックス) \n・時間的／コスト的に問題なければ、メガネの有り無し差分をご用意いただけましたら幸甚です(ご用意いただける場合、それぞれ別個のファイルで納品くださいますようお願い申し上げます。印刷サービスの仕様上、ファイルを分けないと二種印刷できないためです。お手数おかけしますが、よろしくお願いいたします) \n\n 依頼の詳細は以上になります。詳細につきましては、作画等のコストにかんがみて、自由にご変更いただいてかまいません。注文が多岐にわたり大変恐縮ですが、ご検討のほど何卒よろしくお願いいたします。", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@shine4_____/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3747877, "client_id": 2297154, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/397a4887/uploads/origins/1bda2f59-4da9-43e3-a37d-04c3440770e4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0a4e16860b4c693224889ff33a5edc03", "srcset": "https://si.imgix.net/397a4887/uploads/origins/1bda2f59-4da9-43e3-a37d-04c3440770e4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0a4e16860b4c693224889ff33a5edc03, https://si.imgix.net/397a4887/uploads/origins/1bda2f59-4da9-43e3-a37d-04c3440770e4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=2317eede5f3bf1db45e8f5d560f5f085 2x, https://si.imgix.net/397a4887/uploads/origins/1bda2f59-4da9-43e3-a37d-04c3440770e4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=3f4c12cdbd529ca92506e079257e3621 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/397a4887/uploads/origins/1bda2f59-4da9-43e3-a37d-04c3440770e4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=19917dfe7c2650b334186a8a0479e379", "srcset": "https://si.imgix.net/397a4887/uploads/origins/1bda2f59-4da9-43e3-a37d-04c3440770e4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=19917dfe7c2650b334186a8a0479e379, https://si.imgix.net/397a4887/uploads/origins/1bda2f59-4da9-43e3-a37d-04c3440770e4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=4c7fd74966cf1368b4da57737de20a5e 2x, https://si.imgix.net/397a4887/uploads/origins/1bda2f59-4da9-43e3-a37d-04c3440770e4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=8bcfa744e0e1093f99504c1b916cf88d 3x"}, "body": "個人Vtuberをしております、夕樹陽彩（ゆうき ひいろ）と申します。\n\nSkebを拝見し、ヨイｯシｮ〜さんの描かれる少しダウナーで物憂げな表情や、独特の空気感に一目惚れしました。\n\n私の活動でのワンシーンを、ぜひその素敵なタッチで描いていただきたいと思いリクエストいたしました。\n\n【依頼内容】\n私「夕樹陽彩」が、机に向かって勉強しながら苦戦している様子をお願いします。\n\n【シチュエーション・構図のイメージ】\n「情報の波に溺れて、キャパオーバーしている」イメージです。\n\n・手前に参考書や付箋がタワーのように積まれていて、その奥で少しうんざりしている（あるいは途方に暮れている）様子。\n・背景にはホワイトボードがあり、思考の痕跡（文字や図など）がびっしり書かれている。\n・机の上には、飲み干したエナジードリンクやコーヒーの缶が数本転がっている。\n\n表情は「ダウナーで物憂げな雰囲気」でお任せしたいです。「頑張ったけれど、もう無理……」というような、虚無感や疲労感が滲み出ていると嬉しいです。\n\n【キャラクター詳細】\nお手数ですが、Xの固定ツイートをご参照ください。\nhttps://x.com/Yuki_HERO44/status/1672470901345099776\n\n【納品形式】\n・人物と背景のレイヤーが分かれたPSDデータを希望します。\n・もしPSDでの納品が難しい場合は、「背景ありの画像」と「人物のみの背景透過PNG」の2枚をいただけますと幸いです。\n\n【使用用途】\n・YouTube配信サムネイル、SNS宣伝、個人鑑賞。\n・収益化済みのチャンネルで使用する可能性があります。\n\nもし条件が合わない場合は、キャンセルまたは再送要請をいただけますと幸いです。\nご検討のほど、よろしくお願いいたします！", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@shine4_____/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3747877, "client_id": 3723595, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/440274e1/uploads/origins/bdbf51c2-2b9e-40e8-a0c6-28fc927498ab?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f4e44a67a62ffc91d54c9eb46211c2e0", "srcset": "https://si.imgix.net/440274e1/uploads/origins/bdbf51c2-2b9e-40e8-a0c6-28fc927498ab?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f4e44a67a62ffc91d54c9eb46211c2e0, https://si.imgix.net/440274e1/uploads/origins/bdbf51c2-2b9e-40e8-a0c6-28fc927498ab?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=58fe5a3a3286414bd54fcecc3fa8cb5a 2x, https://si.imgix.net/440274e1/uploads/origins/bdbf51c2-2b9e-40e8-a0c6-28fc927498ab?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e726209a79031aeea4475e5e889505f6 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/440274e1/uploads/origins/bdbf51c2-2b9e-40e8-a0c6-28fc927498ab?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=82416283cd861abd2990071097d948e4", "srcset": "https://si.imgix.net/440274e1/uploads/origins/bdbf51c2-2b9e-40e8-a0c6-28fc927498ab?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=82416283cd861abd2990071097d948e4, https://si.imgix.net/440274e1/uploads/origins/bdbf51c2-2b9e-40e8-a0c6-28fc927498ab?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=aeaddfddefc7488585518b8f6d815841 2x, https://si.imgix.net/440274e1/uploads/origins/bdbf51c2-2b9e-40e8-a0c6-28fc927498ab?bg=%23fff&auto=