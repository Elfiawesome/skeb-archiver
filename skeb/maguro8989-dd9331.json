g=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=fac938c30b9e67dddf7b98b9613b520a 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/977cc2bd/uploads/origins/033ad140-2a45-477b-9a36-4c4684369d09?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=12dd73657a02c5cd3b486641f55805a2", "srcset": "https://si.imgix.net/977cc2bd/uploads/origins/033ad140-2a45-477b-9a36-4c4684369d09?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=12dd73657a02c5cd3b486641f55805a2, https://si.imgix.net/977cc2bd/uploads/origins/033ad140-2a45-477b-9a36-4c4684369d09?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=d96adb6be765709d9603928f1678cb58 2x, https://si.imgix.net/977cc2bd/uploads/origins/033ad140-2a45-477b-9a36-4c4684369d09?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=ea085bdc26a2f84728e228a89dc3356b 3x"}, "body": "こんにちは、お世話になります。\nいつも可愛らしいイラストを拝見しています。\n初めてのご依頼になりますが、お願いしたい内容は以下の通りになります。\n\n🌙キャラクター\n紲星あかり 結月ゆかり\nどちらもVOCALOID6衣装にてお願いしたいと思います。\n\n✨️構図\nあかりちゃんとゆかりさんが軽く抱き合うような形で\n互いに少し照れたような顔をしていると嬉しいです。\n（解釈不一致みたいな事があれば、びんちょうまぐろさんの感性で変えちゃって大丈夫です）\nその他の背景やアクセサリーなど、詳細な箇所はびんちょうまぐろさんにお任せいたします。\n\n・利用用途\nSNSアイコン・デスクトップやスマートフォンの壁紙など・・\n\n以上になります。\nご検討のほど、よろしくお願いいたします。", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@maguro8989/works/15", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 351178, "client_id": 794233, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/1dbd0bc9/uploads/origins/44afc324-a994-4923-8902-2b86db96980e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4096927a628cc399890b138818a05298", "srcset": "https://si.imgix.net/1dbd0bc9/uploads/origins/44afc324-a994-4923-8902-2b86db96980e?bg=%23f