eb0700/uploads/origins/9ddfaf14-7158-4fc7-b45a-c37272d2e528?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=59282e03e5d84d04165e99b187fe6747, https://si.imgix.net/b2eb0700/uploads/origins/9ddfaf14-7158-4fc7-b45a-c37272d2e528?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=d4a138a4c5e7023e4451cff5c4f1ffd4 2x, https://si.imgix.net/b2eb0700/uploads/origins/9ddfaf14-7158-4fc7-b45a-c37272d2e528?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=df694d35efc832908ada01b4b43019f9 3x"}, "body": "はじめまして！いつも素敵な作品をありがとうございます。\n今回、監獄戦艦2のアリシア ・ビューストレームで洗脳黒ギャルビッチ化、またはbimbo化を描いて頂けないでしょうか？\n\nBefore内容\n衣装は原作衣装でまだ反抗的な目つきをしています。\n原作主人公であるボーガンに「お前はこれから俺に命令されたら喜んで俺の尻の穴を舐める最低のメスブタになる」と宣言される。\nそれを受けアリシアが「そんな存在になるくらいなら死んだ方がマシだ！」と言い切る。\n\nAfter内容\n死ぬ事は叶わず、精神も肉体もボーガンの都合の良いように改造されてしまう。乳首やクリや舌にピアスを開け、体中に卑猥なタトゥーを入れている。元々巨乳だったが更に爆乳に。唇もbimboらしくぷっくりと厚くなり、見た目も喋り方も頭の悪い娼婦またはキャバ嬢のようなバカでエロい女になる。ボーガンの事を「ダ〜リン♡」と呼び絶対服従する。「ギャハハ♡ダ〜リンのチンポサイコ〜♡」\nと下品な笑みで媚びるが、元婚約者の男に対してはドSな笑みでマゾ男に調教する。\n\n服装はヒョウ柄のどすけべボディコン、メイクはリップもアイシャドウも盛り盛りでお願いします。リップが派手で強調されていると嬉しいです。\n\nシチュに関しましてはボーガン（顔なし描写）の体中、あるいはチンポ中にキスマーク、または尻の穴にキスをした後で尻の穴と舌との間に唾液の橋が出来ている。と言ったような、男に忠誠を誓った下品なバカ女になった所をイメージしております。\n衣装デザイン、シチュは大まかなイメージなので先生が似合うと思った内容で是非お願いします！\n\n長文となりましたが、是非先生風に下品でエロくなったアリシアを見てみたいです。\nご都合が合いましたらばよろしくお願いいたします。", "nc": 40, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@inouenanaki/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1021443, "client_id": 481062, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/57b36753/uploads/origins/dce47763-e544-41d5-a55b-f4f2732867d6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=97026522c95a9dd8e28c71473ef6b583", "srcset": "https://si.imgix.net/57b36753/uploads/origins/dce47763-e544-41d5-a55b-f4f2732867d6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=97026522c95a9dd8e28c71473ef6b583, https://si.imgix.net/57b36753/uploads/origins/dce47763-e544-41d5-a55b-f4f2732867d6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f550389b9c169828bfbce51facf6407f 2x, https://si.imgix.net/57b36753/uploads/origins/dce47763-e544-41d5-a55b-f4f2732867d6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=4529e592fa44c795197aea074685f71b 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/57b36753/uploads/origins/dce47763-e544-41d5-a55b-f4f2732867d6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3e5fb248f62a4f1e083232c8b7dbf9f8", "srcset": "https://si.imgix.net/57b36753/uploads/origins/dce47763-e544-41d5-a55b-f4f2732867d6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3e5fb248f62a4f1e083232c8b7dbf9f8, https://si.imgix.net/57b36753/uploads/origins/dce47763-e544-41d5-a55b-f4f2732867d6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=8f36da7628df819c3361d5f52498e8c0 2x, https://si.imgix.net/57b36753/uploads/origins/dce47763-e544-41d5-a55b-f4f2732867d6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=5c3ebbc799aeaa72047d0d1c9892e583 3x"}, "body": "こんにちは、私は源頼光のイメージセットをお願いしたいと思います。源頼光は、かつてはセックスをしたことがない人でしたが、セックス中毒の淫乱女に変身します。\n日焼けした肌、QOSタトゥーを入れた黒い肌、妊娠して胸が大きくなったなどのイメージの違いがあるはずです。\nライコウに陰毛とワキ毛を生やしてください。\nバニースーツ、牛柄ビキニ、ボディコン、ギャル系女子高生など、様々な衣装を着せてください。\n\nポーズやシチュエーションはお好みでどうぞ。\nお読みいただきありがとうございました。", "nc": 168, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@inouenanaki/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1021443, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/001c0e29/requests/255019_1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=80db47b03fa2e514f63d3225109d33f9", "srcset": "https://si.imgix.net/001c0e29/requests/255019_1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=80db47b03fa2e514f63d3225109d33f9, https://si.imgix.net/001c0e29/requests/255019_1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=34cb396291689b644e955035a3c58cbf 2x, https://si.imgix.net/001c0e29/requests/255019_1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a74a01e4dd18eb7ed0e34c9bdf519332 3x"}, "duration": null, "nsfw": true, "hardcore": true, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/001c0e29/requests/255019_1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f10d2c05208be8af3fb33fa4109139d6", "srcset": "https://si.imgix.net/001c0e29/requests/255019_1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f10d2c05208be8af3fb33fa4109139d6, https://si.imgix.net/001c0e29/requests/255019_1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=ef51f2045072174755af6fb87d1afa73 2x, https://si.imgix.net/001c0e29/requests/255019_1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=e6480dbd72ed262c53d2b19598dd9859 3x"}, "body": "いつも作品、楽しみにしております。今回、こちらのキャラクターの黒ギャルビッチ化Before Afterイラストをお願いしたく思い、リクエストさせていただきます。\n\nキャラクター参照画像\nhttp://cdn.tw5.jp/i/tw5/basic/2965/525637_e29655_totalbody.jpg\n\nAfter衣装参照画像(後述します）\nhttps://www.pixiv.net/artworks/86799140\n\nBefore分リクエスト内容\n衣装はキャラクター参照画像と同じ\n箱入り娘で世間知らずの、清楚なお嬢様\n本人無自覚のどすけべボディ\n男遊びは当然、性経験も知識もなし\n街を歩いていたら、チャラ男にナンパされて簡単について行ってしまうといったシチュエーションで\n\nAfter分リクエスト内容\n髪色は毛先がピンク色になっている派手な金髪\n衣装は色はお任せで、After衣装参照画像(井上様のpixivで公開されているイラストになります）のような、ヒョウ柄のどすけべボディコン+中指にだけかかっているグローブ（After衣装参照画像でキャラがつけている物と同じです）\n肌の色はAfter衣装参照画像と同じくらいに\nメイクはケバケバしい濃いヤマンバメイク。リップやアイシャドウ、デコレーションもたっぷりめでお願いします。色やデザインは井上様が似合うと思いそうな物でぜひお願いします。\n口にはタバコを咥えて、表情は下品な笑みを浮かべているようにお願いします。\nシチュエーションとしては、すっかりチャラ男に染められて男遊びや、タバコ等なしでは生きていけないようなビッチに。今では毎日夜のラブホ街で男を漁り客を取るように、といった感じです。\n井上様の作品全般が好きなのでBimbo差分や部族差分等があると嬉しいですが、こちらはなしでも大丈夫です\n\n長くなりましたが、ぜひ井上様にヤマンバギャル化を描いてほしかったので、どうかよろしくお願いいたします。", "nc": 59, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}], "sent_works": [], "similar_creators": [{"id": 139717, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "白土", "screen_name": "sirosoil", "avatar_url": "https://pbs.twimg.com/profile_images/1623512569649709056/1g5l4S-P.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1041904157324500992/1639724513/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 2, "complete_expiration_days": 60, "skills": [{"genre": "art"}, {"genre": "correction"}], "nc": 176}, {"id": 470491, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "のざらし", "screen_name": "nozarasi_s", "avatar_url": "https://pbs.twimg.com/profile_images/560999656335765505/GrKXvlto.jpeg", "header_url": "https://pbs.twimg.com/profile_banners/182739575/1488520000/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 12, "complete_expiration_days": 98, "skills": [{"genre": "art"}, {"genre": "comic"}], "nc": 160}, {"id": 1139017, "creator": true, "nsfw_acceptable": true, "acceptable": false, "name": "垢", "screen_name": "SSzbatPUs8", "avatar_url": "https://pbs.twimg.com/profile_images/1745426992990953472/_sCwfukA.jpg", "header_url": null, "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 120, "s