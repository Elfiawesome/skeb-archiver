なモノもお願い出来ますでしょうか。あくまでも素のルギア様メインですので、OZEさんに余裕がございましたらご検討いただけますと嬉しいです。\n\nよろしくお願いいたします！", "nc": 161, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@EZO_J_P/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 4009491, "client_id": 339738, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/458cbb34/uploads/origins/e22a66d9-d704-417e-899d-133bc6c2ed36?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5adf7a80120fa5ceda6f492230e87a8e", "srcset": "https://si.imgix.net/458cbb34/uploads/origins/e22a66d9-d704-417e-899d-133bc6c2ed36?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5adf7a80120fa5ceda6f492230e87a8e, https://si.imgix.net/458cbb34/uploads/origins/e22a66d9-d704-417e-899d-133bc6c2ed36?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=6d1269a059c7132bf6f957502e8765c0 2x, https://si.imgix.net/458cbb34/uploads/origins/e22a66d9-d704-417e-899d-133bc6c2ed36?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a9a73664260df3882a054f5fd77a3ead 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/458cbb34/uploads/origins/e22a66d9-d704-417e-899d-133bc6c2ed36?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=282eccee4896198a7a82ade4c002ea80", "srcset": "https://si.imgix.net/458cbb34/uploads/origins/e22a66d9-d704-417e-899d-133bc6c2ed36?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=282eccee4896198a7a82ade4c002ea80, https://si.imgix.net/458cbb34/uploads/origins/e22a66d9-d704-417e-899d-133bc6c2ed36?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=0d1b9311ae8c0e79752699921a895c7a 2x, https://si.imgix.net/458cbb34/uploads/origins/e22a66d9-d704-417e-899d-133bc6c2ed36?bg=%23fff&auto=format