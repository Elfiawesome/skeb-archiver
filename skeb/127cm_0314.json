た、月宮と同じ舞台に立って演奏するのが現在のやりたいこと。\n相手のことを「葵」と呼ぶ。\n\n  【関係性】\nお互いがお互いの音楽に対する姿勢をリスペクトしており、一緒にセッションすることが大好き。また、お互いを自分のものだと思っている。交際をしているわけではないが、人前で平気な顔で手を繋ぐ。\n\n【使用用途】\n個人鑑賞・利用、クレジット表記をしてのSNSでのアイコン等での使用、お相手の相互さんとの共有\n\n構図や表情等はののか様にお任せします。衣装はご負担でなければメイド服だととても嬉しいです……！金額や内容等で何か不備がありましたら、再送していただけると幸いです。\nご検討よろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/1JggLPCJcySJ6pU9WGTHQMM-11-sfO1__?usp=drive_link", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Gh0st_02/works/51", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 261999, "client_id": 3296636, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/2c182996/uploads/origins/b68315e3-2d22-448d-a4ca-d9a9757d5a0d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=14083f396c0cb98264cbcedd90c876c1", "srcset": "https://si.imgix.net/2c182996/uploads/origins/b68315e3-2d22-448d-a4ca-d9a9757d5a0d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=14083f396c0cb98264cbcedd90c876c1, https://si.imgix.net/2c182996/uploads/origins/b68315e3-2d22-448d-a4ca-d9a9757d5a0d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=3492ce91183b6e1042435df089e75d93 2x, https://si.imgix.net/2c182996/uploads/origins/b68315e3-2d22-448d-a4ca-d9a9757d5a0d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=38ea7e9738a83e436d5c799936782823 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/2c182996/uploads/origins/b68315e3-2d22-448d-a4ca-d9a9757d5a0d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=246af8cd721b4d57a198ca3bdeefce22", "srcset": "https://si.imgix.net/2c182996/uploads/origins/b68315e3-2d22-448d-a4ca-d9a9757d5a0d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=246af8cd721b4d57a198ca3bdeefc