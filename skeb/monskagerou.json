先して突っ走っていくタイプ\n\n２人とも依存症レベルの相思相愛。\n\n〇内容\nほぼ参考画像の通りの体位となります。\nベッドの上でアンを四つん這いにさせ、ふたなり化しているリタがアンを抱えバックのセッ久。\n\nリタはアンのお腹を抱いて胸を掴みながら前後にピストン。射精直前なのか余裕がない表情でアンの腰にしがみつくような形でつながっている。服装はジャケットなし指貫手袋なしのセーラー・ミニスカ・ガーターベルト・ニーソ。\n下半身のみ露出している。\nアンはされるがままに喘ぎ声を漏らしていて必死に腰を動かすリタを愛しそうに流し目で見ている。悩ましい表情をしながらもどこか幸せそうに笑っている。服装はブレザーなしで胸だけ露出させている。\n\n参考画像のようにイラスト全体に喘ぎ声やハートや汁、またビクビク効果やを散らしてほしいです。\n\n\n〇その他\n横長のイラストでお願いします\n背景・不明点はお任せいたします\n\n宜しければぜひ、お願いいたします。\n\nhttps://drive.google.com/drive/folders/1GmQqcsjpQ2BbuDANh5rU07GCW5ib6y2F?usp=sharing", "nc": 49, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@monskagerou/works/86", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/24abc671/uploads/origins/b8bbbde8-2030-49e1-81ec-a07821d89c1a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=61f4fb0bff870cae458d80e09d586730", "src_set": ""}, "private": true, "genre": "art", "tipped": false, "creator_id": 138806, "client_id": 2880206, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 49, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@monskagerou/works/85", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/230e2b7e/uploads/origins/fb1b23a0-a2a7-4804-a259-2825826e3cf2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=14e80645c90bb04f9dbf1bd533a3423f", "src_set": ""}, "private": true, "genre": "art", "tipped": false, "creator_id": 138806, "client_id": 0, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 160, "word_count": 0, "transcoder": "", "creator_acceptable_sa