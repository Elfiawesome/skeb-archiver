.net/5554fe21/uploads/origins/127a87c0-1a68-4e43-99fb-ed99edadd8b8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=cdb779b0bf680e13462b2e53433bc2cf, https://si.imgix.net/5554fe21/uploads/origins/127a87c0-1a68-4e43-99fb-ed99edadd8b8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=f14ef4bdf1287b4578b0618e825a526d 2x, https://si.imgix.net/5554fe21/uploads/origins/127a87c0-1a68-4e43-99fb-ed99edadd8b8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=6164ad767be7070ec43767e2276ff7dd 3x"}, "body": "瀧本祐ヰ様、初めまして！\n私は中国人です、瀧本祐ヰ様の書くイラストがとても好みだったのでリクエストさせて頂きました。\n\n資料 URLに画像を添付したので参考にして下さい。\n【特徴】\n•薄い金色の髪\n•青い目\n•性格はツンデレ、ツンデレ\n•平らな胸\n•少女っぽいけど幼女寄りの体型\n【服装】\n•資料に記載の内容をご使用くださいますようお願いいたします。\n【ポーズ】\n•少女が廃墟の中で戦っているイラスト\n•できれば、体に少し血痕がついていると理想的です。\n【表情】\n•厳粛\n指定の無い点、不明な点はお任せで。\n\n【その他】\n・使用用途としては個人的な壁紙として使わせてもらいたいです\n\n長文をここまで読んで頂き、ありがとうございました。\n何卒ご検討いただければと思います！\n\nhttps://drive.google.com/drive/folders/16_D0A5df96LWVDvDEYdrf4J91zk6D4xA", "nc": 8, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@yuwi_takimoto/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3689275, "client_id": 2403555, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/533f820a/uploads/origins/3aed89da-a33f-4859-ab54-fc18b18e1ddb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e35281eea3c66abcbcc8e6027c022199", "srcset": "https://si.imgix.net/533f820a/uploads/origins/3aed89da-a33f-4859-ab54-fc18b18e1ddb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e35281eea3c66abcbcc8e6027c022199, https://si.imgix.net/533f820a/uploads/origins/3aed89da-a33f-4859-ab54-fc18b18e1ddb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=172a16d7fcd3018ade80b7c851e8ead3 2x, https://si.imgix.net/533f820a/uploads/origins/3aed89da-a33f-4859-ab54-fc18b18e1ddb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=30ca63ed296f9fa9092f3bdfa0f42d95 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/533f820a/uploads/origins/3aed89da-a33f-4859-ab54-fc18b18e1ddb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6d9f559dfb8714011a77e5b750148caf", "srcset": "https://si.imgix.net/533f820a/uploads/origins/3aed89da-a33f-4859-ab54-fc18b18e1ddb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6d9f559dfb8714011a77e5b750148caf, https://si.imgix.net/533f820a/uploads/origins/3aed89da-a33f-4859-ab54-fc18b18e1ddb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=b28fbfd79bbf1ca37db5c92e313f73a7 2x, https://si.imgix.net/533f820a/uploads/origins/3aed89da-a33f-4859-ab54-fc18b18e1ddb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=eccea7ae2aa5ab77290de39fd05f204a 3x"}, "body": "初めまして、新着で格好良いイラストを拝見し、リクエストさせて頂きました。\nご確認お願いいたします。\n\n■キャラクター\n資料の2名のうち、どちらか一人をお願いします。いずれも自作ゲームのキャラクターです。\n\n・案1\n外見25歳前後の男性。 温厚で物静かな性格で、動植物に好かれる。よく寝ている。\n広大な山の屋敷に住んでいる仙人。自然を操る術に長ける。\n髪は銀色、膝まである長髪。耳は出ている。首から下はストレートだが、上は短めで軽く跳ねている。\n瞳は青の吊り目。 好き嫌いはないが小食。\n\n・案2\n外見25歳、実年齢36歳の男性。薬師＆植物魔法が得意な魔導師。街の薬局で働いている。\n美人寄り。所作は上品。素の表情は吊り目＆吊り眉で冷徹な印象があり、それを緩和するために、意識して眉を下げ、わざと女性のような髪型をして温厚感を出している。\n穏やかさは作っていて、根は苛烈。本性は誰よりも怖い。\n趣味は調剤と読書とジグソーパズル。自作のハーブティーをよく飲む。\n\n■シチュエーションなど\nお任せいたします。\n\n■利用用途\n個人観賞用です。\n\n以上、ご検討よろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/12j6Yvxpic53RH_Q1G10gC6r2xdHyS6Oy?usp=sharing", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@yuwi_takimoto/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3689275, "client_id": 10943, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/5cb20ec1/uploads/origins/6f6d88e6-c71a-463e-8432-7e70adbabb25?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a9aa64033a86b53aac374349d2e58b72", "srcset": "https://si.imgix.net/5cb20ec1/uploads/origins/6f6d88e6-c71a-463e-8432-7e70adbabb25?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a9aa64033a86b53aac374349d2e58b72, https://si.imgix.net/5cb20ec1/uploads/origins/6f6d88e6-c71a-463e-8432-7e70adbabb25?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=eff155f974d0a945bf52555586514bf4 2x, https://si.imgix.net/5cb20ec1/uploads/origins/6f6d88e6-c71a-463e-8432-7e70adbabb25?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=233f5c6a76910280d9f10f9f991f9c49 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/5cb20ec1/uploads/origins/6f6d88e6-c71a-463e-8432-7e70adbabb25?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=021e555f015f7773192ce9f4bc1938c4", "srcset": "https://si.imgix.net/5cb20ec1/uploads/origins/6f6d88e6-c71a-463e-8432-7e70adbabb25?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=021e555f015f7773192ce9f4bc1938c4, https://si.imgix.net/5cb20ec1/uploads/origins/6f6d88e6-c71a-463e-8432-7e70adbabb25?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=b84b5bae4bd03b6c278b9cc0bd7bfa08 2x, https://si.imgix.net/5cb20ec1/uploads/origins/6f6d88e6-c71a-463e-8432-7e70adbabb25?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=2c9b33a6437750fa81a42fe8290c5612 3x"}, "body": "うちの子のイラストをお願いします。\n\n構図等お任せですが、可能であれば全身が映る様に縦長or横長イラストでキャラ設定や見た目からピンと来たものをお願いします。\n\nキャラ容姿は資料URL、設定は以下から確認して下さい。\n\nキャラ設定===\n・名前：エリシアンドラヴァル（渾名：エリシア／シア）\n・1000歳超のドラゴン娘（人間換算で20代半ば）。\n・性格：フランクで気さく、めんどくさがり。お金にはルーズで適当だが、面倒見は良い。\n普段は軽口や冗談も多いが、やる時はやる切り替え上手。\n・口調：現代風の喋りに時折、古臭い言い回し。\n・一人称「私」／二人称「◯◯君」。\n・身長180cm超のグラマラス体型で、綺麗なアブクラックス が入っている。\n・瞳：翡翠色。\n・肌：暗い色味で、頬や体の鱗はさらに濃い色。\n・髪：腰まで届く濃い緑色。インナーと毛先は徐々に明るくなるグラデ。\n・耳：やや尖っているがエルフ族ほど長くはない。\n・角：根元は黒寄り、先端に向かうほど緑が強くなる。\n・尻尾：筋肉質。意識して動かす事が出来る。\n・魔法古物店の店主でアイテムの鑑定・売買が本業だが、買取り過多で慢性的に金欠。\n・そのためよくギルドのバイトで小銭稼ぎをしている姿が目撃される。\n・戦闘になると普段の適当さとは一転、耐性無視の無属性魔法を叩き込む高火力アタッカーに変貌。\n・ドラゴン特有の属性耐性と大気中の魔力吸収・自然回復により継戦能力は高い。\n・ただしデバフ耐性は低く、搦め手を仕掛けられると意外と弱い。\n===\n\n尚、psd形式閲覧可能ですので、ラフや差分等ありましたらレイヤー分けして纏めて頂いて大丈夫です。\n\nhttps://drive.google.com/drive/folders/1YsYyTjnTCsVeCoIIDCUXx99FdI1saLvt", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 19438, "creator": true, "nsfw_acceptable": false, "acceptable": false, "name": "西岡知三", "screen_name": "Nishioka_tomozo", "avatar_url": "https://pbs.twimg.com/profile_images/2056980654517358592/VKbAjYHN.jpg", "header_url": "https://pbs.twimg.com/profile_banners/108738817/1779257224/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 7, "complete_expiration_days": 20, "skills": [{"genre": "art"}, {"genre": "comic"}, {"genre": "correction"}], "banned": false, "nc": 0}, {"id": 159273, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "イチノセ奏", "screen_name": "kanade_cocotte", "avatar_url": "https://pbs.twimg.com/profile_images/1225470417063645184/P8_SiB0V.jpg", "header_url": "https://pbs.twimg.com/profile_banners/71243217/1647958329/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 15, "complete_expiration_days": 30, "skills": [{"genre": "art"}], "banned": false, "nc": 33}, {"id": 2496777, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "ひろ", "screen_name": "SrSO4_", "avatar_url": "https://