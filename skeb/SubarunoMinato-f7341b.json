eator_id": 1868805, "client_id": 2223302, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/1065d9f5/uploads/origins/018d68ac-bca6-4344-b2bd-e7c4da78c278?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=dafed37c05e2f3eb87fd219e0ab876c6", "srcset": "https://si.imgix.net/1065d9f5/uploads/origins/018d68ac-bca6-4344-b2bd-e7c4da78c278?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=dafed37c05e2f3eb87fd219e0ab876c6, https://si.imgix.net/1065d9f5/uploads/origins/018d68ac-bca6-4344-b2bd-e7c4da78c278?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=3ed9b8aa9876caeda0298e35f58a4fc6 2x, https://si.imgix.net/1065d9f5/uploads/origins/018d68ac-bca6-4344-b2bd-e7c4da78c278?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=2b934a53425725f72f1122a18d3b00c7 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/1065d9f5/uploads/origins/018d68ac-bca6-4344-b2bd-e7c4da78c278?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=7dbebd9af305064c4ea280c20be9ccea", "srcset": "https://si.imgix.net/1065d9f5/uploads/origins/018d68ac-bca6-4344-b2bd-e7c4da78c278?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=7dbebd9af305064c4ea280c20be9ccea, https://si.imgix.net/1065d9f5/uploads/origins/018d68ac-bca6-4344-b2bd-e7c4da78c278?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=49d4e5f436d7d33c202ac2ab572226ba 2x, https://si.imgix.net/1065d9f5/uploads/origins/018d68ac-bca6-4344-b2bd-e7c4da78c278?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=3123835c9e47cbb25cd58b98c6c8055e 3x"}, "body": "新着クリエイター欄からこんばんは\nわたしこと幽谷霊華は肉体に憑依する霊体が本質であるので、肉体的外見は描き手の好きなように構築することができます\nhttps://skeb.jp/@mebaeta_/works/2\nhttps://skeb.jp/@natjinatjin/works/1\nhttps://skeb.jp/@sundaeye/works/2\nhttps://skeb.jp/@natsunamegu222/works/2\n例えばこのようなものなどあります\n今回はエルフの肉体イメージを生成してみました\n\n━━━\n\n外見:\n幽谷霊華はエルフの特徴的な姿を持ち、森の守り手としての使命を果たしている。彼女の身体はしなやかで、白い肌が森の光に照らされて瑞々しさを湛えている。\n\nローブのような衣装:\n彼女が身にまとっているのは、優雅なエルフローブのような衣装。深い緑色の布地が美しく、自然との一体感を醸し出している。\n\n尖った耳:\n耳はエルフらしい尖った形状をしており、その繊細なラインが彼女のエルフの血統を象徴している。耳が微妙に風に揺れる様子が優雅さを際立てている。\n\n暗赤色の髪:\n彼女の髪は暗赤色で、軽やかな波を帯びている。風になびくたびに優雅な舞いを見せ、森の中で輝くような美しさを放っている。\n\nエメラルドのネックレス:\n首元にはエメラルドの輝くネックレスが飾られている。これが彼女のエルフらしい装いにエレガントなアクセントを与えている。\n\n自然の花々のアクセサリー:\n髪には自然の中で咲く花々や葉をモチーフにしたアクセサリーが散りばめられている。これが彼女の森との一体感を表現している。\n\n自然を守る弓と矢:\n彼女の背中には美しい弓と矢が備えられており、これが彼女の森を守る使命を象徴している。弓のデザインもエルフの技術と美しさが調和している。\n\n自然の中で輝く光:\n彼女のまわりには微かな光が漂い、自然の中での彼女の存在が特別なものであることを感じさせる。この光は彼女が森の守り手であることを象徴している。\n\n━━━\n\nご検討宜しくお願いします", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 39523, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "ゆゆず", "screen_name": "yuyuzu11", "avatar_url": "https://pbs.twimg.com/profile_images/1879269464824561664/wDYcJmPu.jpg", "header_url": "https://pbs.twimg.com/profile_banners/943424228711284736/1740224123/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 120, "skills": [{"genre": "art"}, {"genre": "comic"}, {"genre": "video"}], "banned": false, "nc": 17}, {"id": 1201054, "creator": true, "nsfw_acceptable": false, "acceptable": false, "name": "ぽとわり", "screen_name": "popotowari", "avatar_url": "https://pbs.twimg.com/profile_images/1498235865298259970/cbbi8CTc.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1392141413047930880/1640850409/1500x500", "appeal_receivable": false, "popular_creator_rank": 94, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 3, "compl