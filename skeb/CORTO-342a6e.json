282-24edd78d24b1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=da61706ecdd521e3d5cac14be41cfa4d", "srcset": "https://si.imgix.net/e885d567/uploads/origins/0e07859d-001a-4f5f-8282-24edd78d24b1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=da61706ecdd521e3d5cac14be41cfa4d, https://si.imgix.net/e885d567/uploads/origins/0e07859d-001a-4f5f-8282-24edd78d24b1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=323694b69884a4ff4b7a284930503260 2x, https://si.imgix.net/e885d567/uploads/origins/0e07859d-001a-4f5f-8282-24edd78d24b1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b90859be9da660ed187f4ec81fd8e017 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/e885d567/uploads/origins/0e07859d-001a-4f5f-8282-24edd78d24b1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=7f2bd566b44be95129d84361a9fadf74", "srcset": "https://si.imgix.net/e885d567/uploads/origins/0e07859d-001a-4f5f-8282-24edd78d24b1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=7f2bd566b44be95129d84361a9fadf74, https://si.imgix.net/e885d567/uploads/origins/0e07859d-001a-4f5f-8282-24edd78d24b1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=49eec160e5d2cc7d489efeedea391fe9 2x, https://si.imgix.net/e885d567/uploads/origins/0e07859d-001a-4f5f-8282-24edd78d24b1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=8f5946d461d0c8374b2a2cd456565ec8 3x"}, "body": "可愛く美麗な女の子と、対照的な肉々しい触手に惹かれて依頼させていただきました。\n古い作品ですが、スターオーシャンセカンドストーリーのヒロイン、レナ・ランフォードが苗床妊婦にされているイラストをお願いできないでしょうか？\n\nシチュにいたるまで\nレナは巨大な芋虫モンスター「ブラッドウォーム」（参考画像右）に丸呑みにされ、体内に閉じ込められる。体内に生える無数の触手がレナを「つがい」にするべく日夜彼女を責め続けた。\nそして数か月後。胎内に欲望を注がれ続けた彼女は化物の子を宿した臨月となり、胎動を感じながら苦悶の表情を浮かべている。\n\nレナの設定\n・彼女はネーデ人と呼ばれる種族で、いわゆるエルフ耳と呼ばれるような、横に伸びた尖った耳をしています\n・髪には特徴的な月の髪飾りがありますが、苗床になった今もしっかり髪に付けてほしいです\n・服はほとんど布切れ状態でわずかに残るのみ。特に胸、お腹、股間はしっかり見えるように露出状態\n・まだ男を知らない少女から望まぬ妊婦の身体にされた彼女の乳輪は、元々桜色だったのが茶色い妊婦の色に変化している\n・お腹は大きな臨月のお腹\n\n・彼女の表情と、両胸と、大きなお腹と、股間が見える構図だと嬉しいです\n\n・顔は苦悶の表情でうっすら涙を浮かべながら、必死に触手の責めと陣痛に耐えている（必死に抗っている表情）\n・彼女は少し胸が控えめの設定です（ただし無乳やツルペタではありません）絵師様が前に描かれた赤ずきんちゃちゃより少し控えめサイズの胸だと嬉しいです。\n・瞳は少し光を失い、濁った形だと嬉しいです\n\n化物の設定\n・レナを丸呑みした「ブラッドウォーム」は一般のものより、特に巨大なサイズで体内は割と広い空間\n・触手がレナの肢体をしっかり捕らえ、拘束する\n・ただし両乳首、お腹、股間は視聴者サービスのように触手がなく、しっかり露出状態。\n\nマニアックなお願いですが、可能であれば羊水とともに彼女の股間から彼女が数か月お腹で育てた化け物が現れ始め、やがて産まれ落ちて床に転がる差分が欲しいです。\nその場合、産まれる化け物は芋虫モンスター「ブラッドウォーム」を人間の胎児より少し大きいくらいにしたサイズで、産まれた化け物とレナの股間はへその緒で繋がっていて、間違いなくレナと芋虫の胎児が親子であると強調している形です。\n\nよろしければお願いします。\n\nhttps://i.imgur.com/R7tRTaP.png", "nc": 184, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@CORTO/works/5", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/a15779c9/uploads/origins/55b51e54-1715-4fd5-900f-ee7bc46a56d1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=921963a5ec824f6344d355b473168bca", "srcset": "https://si.imgix.net/a15779c9/uploads/origins/55b51e54-1715-4fd5-900f-ee7bc46a56d1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=921963a5ec824f6344d355b473168bca, https://si.imgix.net/a15779c9/uploads/origins/55b51e54-1715-4fd5-900f-ee7bc46a56d1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=d1232fae07d1509637c34c4747f07aa9 2x, https://si.imgix.net/a15779c9/uploads/origins/55b51e54-1715-4fd5-900f-ee7bc46a56d1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=daa6939cff13d97c0f995632be640dc0 3x"}, "private": true, "genre": "art", "tipped": true, "creator_id": 2199617, "client_id": 2024818, "nc": 49}, {"path": "/@CORTO/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2199617, "client_id": 177120, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/431c3741/uploads/origins/a62c58b2-b3ed-45d2-90ad-46b186d0f49d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4577d630b32ef4a09e0165acfb1f9cce", "srcset": "https://si.imgix.net/431c3741/uploads/origins/a62c58b2-b3ed-45d2-90ad-46b186d0f49d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4577d630b32ef4a09e0165acfb1f9cce, https://si.imgix.net/431c3741/uploads/origins/a62c58b2-b3ed-45d2-90ad-46b186d0f49d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=947020ac78a5a80cdf9b53cbd9a9db72 2x, https://si.imgix.net/431c3741/uploads/origins/a62c58b2-b3ed-45d2-90ad-46b186d0f49d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b67b43dcba8655eef5c20faad3c8524b 3x"}, "duration": null, "nsfw": true, "hardcore": true, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/431c3741/uploads/origins/a62c58b2-b3ed-45d2-90ad-46b186d0f49d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f175353cd69b8ea5d49a08eeb1fd2ea1", "srcset": "https://si.imgix.net/431c3741/uploads/origins/a62c58b2-b3ed-45d2-90ad-46b186d0f49d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f175353cd69b8ea5d49a08eeb1fd2ea1, https://si.imgix.net/431c3741/uploads/origins/a62c58b2-b3ed-45d2-90ad-46b186d0f49d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=b642dcc96d361db86f83f565a25b391e 2x, https://si.imgix.net/431c3741/uploads/origins/a62c58b2-b3ed-45d2-90ad-46b186d0f49d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=94f311c67596877e1a6c06fbd3e22f95 3x"}, "body": "CORTO🔞さんこんにちは、新米賢者×触手の作品がすごく刺さり\nちっぱいキャラなのですが是非ともイラストを描いて頂きたくリクエストいたします。\n\n【対象】\n　作品名：この素晴らしい世界に祝福を！\n　キャラ：アイリス\n\n【バックグラウンド】\n　・めぐみんとゆんゆんと３人で草原に出かけていたところすごくきれいな花を見つけ\n　　その甘い香りに誘われて休憩をとることに。\n　　この花の香りには女性だけを昏睡させたうえ能力を封じる成分が含まれており、\n　　女性冒険者達を眠らせた状態で地中の植物本体が呑み込むとても危険な植物だった。\n　　そうとは露も知らずそのまま眠りに落ちてしまい３人は植物に呑み込まれてしまい\n　　苗床として陵辱され続けることになってしまう。\n\n【シチュエーション】\n　・拘束された状態での触手責めをお願いします。\n\n【構図など】\n　・正面からのアングル\n　　「新米賢者は触手の生贄」の最後のシーン構図がいいです\n　・触手による拘束\n\n　もししっくりするイメージが浮かびましたら適宜変更頂いて構いません\n\n【服装／体形など】\n　・葡萄の髪飾りは有り\n　・ドレスの腕部以外はボロボロに溶けた状態\n　・つるぺたなロリ体形をお願いします\n\nまた、以下もし可能でしたら対応頂ける範囲で構いませんので\nパーツ分けして差分お願い出来ますでしょうか？\n\n【表情】\n　・目：見開き＜視線：下半身側／正面＞、ぎゅっと閉じる、気を失い閉じたイメージ\n　・口：触手の挿入有＜射精：無／有＞\n　　　　挿入無＜「ひっ」の形、悲鳴上げ（涎：無／有）、半開き＞\n　・紅潮の有無\n\n【挿入状況】\n　・未挿入、挿入状態＜愛液：無、潮吹き、垂れ流し状態＞\n\n【その他】\n　・淫紋の有無\n　・(可能でしたら)妊娠差分\n\n【参考情報】\n　・アイリス\n　　https://drive.google.com/drive/folders/1OBFvQt0I-0JUiqzw8XY52Y4suRbwxU5t\n\nご検討よろしくお願いいたします！", "nc": 59, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@CORTO/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2199617, "client_id": 492916, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/b77bde6e/uploads/origins/ba8d2697-9d79-48a7-9ae8-d2533b5d2066?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=18c270956e270373c37d35bdd2cf01eb", "srcset": "https://si.imgix.net/b77bde6e/uploads/origins/ba8d2697-9d79-48a7-9ae8-d2533b5d2066?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=18c270956e270373c37d35bdd2cf01eb, https://si.imgix.net/b77bde6e/uploads/origins/ba8d2697-9d79-48a7-9ae8-d2533b5d2066?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=9f848d5c667151c530bbc99314cd14df 2x, https://si.imgix.net/b77bde6e/uploads/origins/ba8d2697-9d79-48a7-9ae8-d2533b5d2066?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&f