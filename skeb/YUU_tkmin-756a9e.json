ng\n\n使用用途は\n・個人鑑賞（スマホの壁紙使用、SNSのアイコン/ヘッダーへの使用、印刷）\n・個人用グッズ作成\n\n金額不足など、不備がありましたら、お手数ですが再送していただけますと幸いです。\nどうぞよろしくお願いいたします。", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@YUU_tkmin/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3931847, "client_id": 3264588, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/b1d990ee/uploads/origins/47546ee4-3118-48d0-b38c-8810d87c5782?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5952d9d30b97c01ac6ddc3500b3f3830", "srcset": "https://si.imgix.net/b1d990ee/uploads/origins/47546ee4-3118-48d0-b38c-8810d87c5782?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5952d9d30b97c01ac6ddc3500b3f3830, https://si.imgix.net/b1d990ee/uploads/origins/47546ee4-3118-48d0-b38c-8810d87c5782?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=220f7b82bca63d2dcd4c05cdf4a6cad5 2x, https://si.imgix.net/b1d990ee/uploads/origins/47546ee4-3118-48d0-b38c-8810d87c5782?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=3c648626957cf9a5208a930684549489 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/b1d990ee/uploads/origins/47546ee4-3118-48d0-b38c-8810d87c5782?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b07f2c00a9f0a2e899372c3bad6865c5", "srcset": "https://si.imgix.net/b1d990ee/uploads/origins/47546ee4-3118-48d0-b38c-8810d87c5782?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b07f2c00a9f0a2e899372c3bad6865c5, https://si.imgix.net/b1d990ee/uploads/origins/47546ee4-3118-48d0-b38c-8810d87c5782?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=e0aaa18063bd9412d04ded7d64c97314 2x, https://si.imgix.net/b1d990ee/uploads/origins/47546ee4-3118-48d0-b3