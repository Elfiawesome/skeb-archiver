at%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=686502b4e6ab58e7a8fc5dcef9f9b6fc 3x"}, "body": "獅子之レオさん初めまして。絵柄と獅子之レオさんのOCが好きでいつも楽しませていただいております。\n獅子之レオさんに縹樹さんという方のレインというキャラクターを描いていただきたくて依頼を送らせていただきました。縹樹さんご本人から許可はいただいております。\n資料や性格などは下記のURLを参考にしていただきたいです。\n表情は悪そうな顔でお願いしたいです。\n背景と人物のレイヤーは分けていただき、レイヤー分けしたデータでいただきたいです。\n\nいつも影ながら応援しています。今後のご活躍をお祈りしています。\n\nXfolio:https://xfolio.jp/portfolio/hanadagi_noru/works/4418058?search_words=%22縹樹乃ル%22\n\npixiv:https://www.pixiv.net/artworks/132378629\n\n上記二つは同じ資料です。お好きなプラットフォームから閲覧してください", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Meary_Reo/works/11", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2399652, "client_id": 2732553, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/78b85d19/uploads/origins/ef2126dc-0c9c-434d-ae44-790c272d1e33?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7c1d6b8b9d025c004387447b06fe8d1e", "srcset": "https://si.imgix.net/78b85d19/uploads/origins/ef2126dc-0c9c-434d-ae44-790c272d1e33?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7c1d6b8b9d025c004387447b06fe8d1e, https://si.imgix.net/78b85d19/uploads/origins/ef2126dc-0c9c-434d-ae44-790c272d1e33?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=78a276956d42e78e169aba3c748a73e7 2x, https://si.imgix.net/78b85d19/uploads/origins/ef2126dc-0c9c-434d-ae44-790c272d1e33?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d020ef718e2445195cb67b57cbf0eac9 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/78b85d19/uploads/origins/ef2126dc-0c9c-434d-ae44-790c272d1e33?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2339fc7a22125affe5de3e77bff0a13a", "srcset": "https://si.imgix.net/78b85d19/uploads/origins/ef2126dc-0c9c-434d-ae44-790c272d1e33?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2339fc7a22125affe5de3e77bff0a13a, https://si.imgix.net/78b85d19/uploads/origins/ef2126dc-0c9c-434d-ae44-790c272d1e33?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=35899abae581e9666aa406845a91212b 2x, https://si.imgix.net/78b85d19/uploads/origins/ef2126dc-0c9c-434d-ae44-790c272d1e33?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=a42d6ed5ff93864792bffda71b71a824 3x"}, "body": "獅子之レオ様、はじめまして。アピールありがとうございます！\nぜひ獅子之レオ様に当方のアバターを描いていただきたく思い、リクエストいたしました。\n\n▼リクエスト内容\n当方のアバターの等身イラストをお願いいたます。\n具体的なポーズや構図、表情等はおまかせしますので、後述するアバターについてや立ち絵資料から自由にキャラクターについて解釈して描いていただければと思います。\nサムネイル等に使用したいため頭部が見切れていないものですと嬉しいです。\n衣装に関してはアピールいただいた本番衣装でお願いいたします。\nまた、衣装・髪型のアレンジや簡略化等も自由に行っていただいて構いません。\n\n▼アバターについて\n少年型オートマトンのσ0型。細身の少年体型で、外見年齢は15歳ほど。\n身長はおよそ160cmです。\nイメージカラーは杜若色(#4d4398)。\n全体的なイメージは「生意気で勝ち気、活発な少年」です。\nデザインの詳細につきましては資料URLをご参考ください。\n\n▼利用用途\nTwitter・Discord等への掲載やアイコンとしての利用\n配信活動(サムネイルや配信画面、配信告知画像等)への利用\nを想定しております。\n\n▼その他\n上述の利用用途のため、可能であれば人物のみの透過データもいただけると嬉しいです。\n\nお忙しい中恐れ入りますが、ご検討いただけますと幸いです。\n\nhttps://drive.google.com/drive/folders/13mIGQgZ-RItlOWbKOofabwf77qZBLWGG?usp=drive_link", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Meary_Reo/works/10", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2399652, "client_id": 3425905, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/1f10c276/uploads/origins/aceb8495-a2fe-417f-bfb5-f0e8e5e19b49?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bcaac38e8f8a74be33ecd96dac810a77", "srcset": "https://si.imgix.net/1f10c276/uploads/origins/aceb8495-a2fe-417f-bfb5-f0e8e5e19b49?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bcaac38e8f8a74be33ecd96dac810a77, https://si.imgix.net/1f10c276/uploads/origins/aceb8495-a2fe-417f-bfb5-f0e8e5e19b49?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=2f809678574f3d77af62c1f88f1d44a7 2x, https://si.imgix.net/1f10c276/uploads/origins/aceb8495-a2fe-417f-bfb5-f0e8e5e19b49?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=edb16b3b8e1fed8d8fd1bee6bdde71b0 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/1f10c276/uploads/origins/aceb8495-a2fe-417f-bfb5-f0e8e5e19b49?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=7a1c247f7a34463e25e719374c8aff62", "srcset": "https://si.imgix.net/1f10c276/uploads/origins/aceb8495-a2fe-417f-bfb5-f0e8e5e19b49?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=7a1c247f7a34463e25e719374c8aff62, https://si.imgix.net/1f10c276/uploads/origins/aceb8495-a2fe-417f-bfb5-f0e8e5e19b49?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=43c198b13bbc27a8f7fa5797c484cbab 2x, https://si.imgix.net/1f10c276/uploads/origins/aceb8495-a2fe-417f-bfb5-f0e8e5e19b49?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=c66500b30f51c9854e94d785b663d940 3x"}, "body": "獅子之レオ様\n\n初めまして。 \n現在VTuberとして活動しております\n誘桜アリスと申します。  \n\n素敵な言葉とアピール本当にありがとうございます…!!\n頂いた言葉の数々に嬉しい気持ちでいっぱいです。\n\nご依頼させて頂くにあたり獅子之レオ様の作品を拝見させて頂きました。\nあどけなさがある少年の表情かと思えば\n影のある表情があったり\n様々なお顔を拝見でき\n可愛らしいイラストから少し不穏なものまで\nなにからなにまで幅広く\nなによりOC様達が可愛くて可愛くて…!!\n全員可愛くて…。\n少しの間ガン見しておりました。\n\nそしてこの度はせっかくのお声かけに\n是非ご依頼出来ればと思い\nリスエスト送信させて頂きました。\n\n使用用途\n･配信や動画用サムネイル \n･X等のSNSで投稿、アイコン等への使用  \n※使用の際、枠や縁どりをつけたり等の加工をさせて頂く可能性がございます。 \nご了承頂けますと幸いです。  \n\n御依頼内容\n誘桜アリスのイラストをお願い致します。\nキャラクター外見は資料URLより御参照ください。\n\n【人物詳細】\n・自由人のマッド気質吸血鬼\n・少年,中性的\n・たい焼き,実験器具,ぬいぐるみ好き\n\n構図や表情、\nその他服装に関しましても資料通りや\n獅子之レオ様の描きやすい服装等\n全てお任せ出来ればと考えております。\nお声かけ時にお伝え頂けた衣装も\n資料URLに掲載ございますので\nご参照頂ければ幸いです。\n\n背景の有無もお任せ出来ればと考えておりますが背景ありの場