ins/96f77933-82f9-43cf-b58e-09484e78554f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b784d705306345a2ea4f42f2ca73391e 2x, https://si.imgix.net/b71357fb/uploads/origins/96f77933-82f9-43cf-b58e-09484e78554f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c90b92f727cc19e4206a74fdeea4a462 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/b71357fb/uploads/origins/96f77933-82f9-43cf-b58e-09484e78554f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=fa51a93b361b2e47615cbfd6a588c224", "srcset": "https://si.imgix.net/b71357fb/uploads/origins/96f77933-82f9-43cf-b58e-09484e78554f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=fa51a93b361b2e47615cbfd6a588c224, https://si.imgix.net/b71357fb/uploads/origins/96f77933-82f9-43cf-b58e-09484e78554f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=58bb3511dc9ae4c5417570a45ff79810 2x, https://si.imgix.net/b71357fb/uploads/origins/96f77933-82f9-43cf-b58e-09484e78554f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=00000c124569c9b309d3d30f8389673d 3x"}, "body": "無加糖OCHA様　初めまして！\n素敵な作品をお見かけし\n衝動的にリクエスト失礼致します\n\nリクエストしますのは\nうちの子のオリキャラちゃん作品です\n\nキャラと背景との割合は\nこの前のハロウィンやクリスマス作品などが非常に好みでした！\n\nhttps://www.pixiv.net/artworks/113011786\n\n\nhttps://www.pixiv.net/artworks/103867289\n\nhttps://www.pixiv.net/artworks/101157514\n\n無加糖OCHA様が描かれる作品の雰囲気がとても好みでしたので基本は無加糖OCHA様にお任せしたく思います。\nお手数ですがうちの子の資料を見てなにかインスピレーションを浮かんでいただければ感無量です。\n\nが、\nあまりにも大雑把なお題ですので\n作品作成に難儀された場合\nテーマとして\n納品予定月のイベント\n例えば　クリスマスや雪まつり、お正月、バレンタイン、花見、などお任せします\n\nうちの子:\n柄葉五鈴(つかは いすず)ちゃん\nとても明るい元気な子\n\nhttps://www.dropbox.com/sh/ry67ocwtc20fgy8/AACve8MF2Y9B5RILo_RFvaeKa?dl=0\n\n悪鈴ちゃん\n五鈴ちゃんの別個体です。\n性格はわかりやすく言いますとツンデレに近いです。\n\nペットのたまり醤油\n謎の生命体\n\nhttps://www.dropbox.com/sh/4oifk7qyv2ix3cx/AADyWShtMDVeBGPqPTQ9xTsra?dl=0\n\nです！\n注意点は五鈴ちゃんの肌の色は通常の肌色\n悪鈴ちゃんは資料通りで問題ありません\n\n\nもしモブなど描写させれる場合\nよろしければこの中から厳選して選んでいただければとおもいます。\nもちろん、予定がなければなしでも全く問題ありません！\nモブの選択は自分が以前にやった「五鈴ちゃんカレンダー」という年間　毎月　他のオリキャラちゃんを交えた作品をその月のテーマのもと制作してもらうといものをやっていました。\nファイル名1から29の子達はその時点では生まれていなかった子達です。30〜のオリキャラちゃんはいつも五鈴ちゃん作品に反応をくださるありがたいお人たちです！\n\nhttps://www.dropbox.com/scl/fo/7k23jh6jlgheq4rlihnqo/h?rlkey=aof2lcjw9j2pw4wf5loifon3u&dl=0", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@mkt_OCHA/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2676445, "client_id": 2747411, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/a935a0c5/uploads/origins/ee114581-56d3-4a46-8309-a18c84be28ec?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f2dc498401f8a71d47c0aee7b44e170e", "srcset": "https://si.imgix.net/a935a0c5/uploads/origins/ee114581-56d3-4a46-8309-a18c84be28ec?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f2dc498401f8a71d47c0aee7b44e170e, https://si.imgix.net/a935a0c5/uploads/origins/ee114581-56d3-4a46-8309-a18c84be28ec?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=8be7496a0dc1872fd67bd66e2349868e 2x, https://si.imgix.net/a935a0c5/uploads/origins/ee114581-56d3-4a46-8309-a18c84be28ec?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c9393877b03a5e086595d130e83ae39e 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/a935a0c5/uploads/origins/ee114581-56d3-4a46-8309-a18c84be28ec?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=cd491bf21e40b5a607577d6ca36a667e", "srcset": "https://si.imgix.net/a935a0c5/uploads/origins/ee114581-56d3-4a46-8309-a18c84be28ec?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=cd491bf21e40b5a607577d6ca36a667e, https://si.imgix.net/a935a0c5/uploads/origins/ee114581-56d3-4a46-8309-a18c84be28ec?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=d63bdd96f2b90a9d2ab79f11816c2915 2x, https://si.imgix.net/a935a0c5/uploads/origins/ee114581-56d3-4a46-8309-a18c84be28ec?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=98256eeedbfb12a821fcdcc12ef1f647 3x"}, "body": "無加糖OCHA様、はじめまして。\nX(ツイッター)のイラストを拝見し、可愛らしいキャラクターとあたたかみのある色合い、それと奥行きを感じる世界観に魅力を感じ、リクエストしたくご連絡させていただきました。\n\n今回描いていただきたいのは個人Vtuberの「沙汰ナキア」さんです。\nYoutubeでASMRの配信を中心に活動されている悪魔ギャルです。\n沙汰ナキアさんのビジュアルは下記URLにある三面図のとおりです。\n\n構図についての希望は、次のとおりです。\n・全身（またはふとももから上くらいで、髪・腕などキレなし）を描いていただきたい\n・魔界の雰囲気を感じさせる背景（配信では特に魔界を感じさせる描写はほとんどないです）\nその他はお任せで結構です。\n\n使用用途としては、個人観賞用とご紹介でX(ツイッター)に掲載、ファンアートとして沙汰ナキアさんへのプレゼントにしたいので、沙汰ナキアさんの配信活動(youtube収益化済）上の動画やサムネイル、Twitter 等SNSでの使用を許可していただきたいです。\nまた、納品時、背景の有無をレイヤー分けしたPSD形式、背景なしの透過画像のPNG形式をいただけると助かります。\nなお、自分のX(ツイッター)に掲載の際は「転載禁止」の記載を追加するように致します。\nそれと、沙汰ナキアさんはskebの二次創作公認プログラムに登録されています。\n\n何卒ご検討のほどよろしくお願い致します。\n\n＊参考資料＊（グーグルドライブ内PNGファイル）\nhttps://drive.google.com/drive/folders/1ClHsJHvwZ4jomvIkKrE2EGrrkEw4QwW3?usp=sharing", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}], "sent_works": [], "similar_creators": [{"id": 2320961, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "ぎゃん", "screen_name": "00Gvq", "avatar_url": "https://pbs.twimg.com/profile_images/1431243186417008645/BkO55V7b.jpg", "header_url": null, "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 10, "complete_expiration_days": 80, "skills": [{"genre": "art"}], "banned": false, "nc": 176}, {"id": 2561461, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "檜宮しょう", "screen_name": "Ly05YY", "avatar_url": "https://proxy.misskeyusercontent.jp/avatar/media.