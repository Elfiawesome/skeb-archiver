erの小花衣ももみと申します。\n\nぜひ「Vtuber小花衣ももみのイラスト」をリクエストさせてください！\n\n■詳細■\n・使用用途：Vtuber活動での使用（配信サムネイル、SNSアイコンやヘッダー・告知など）\n・可能でしたらPSDファイルでキャラクターがレイヤーわけされているとうれしいです\n・上左右が画面から見切れていないと使用しやすくて助かります🙇\n\n・資料\nhttps://imgur.com/a/Z7R4ZDn\n※年齢は9歳、身長は139㎝なのでかなり幼めに描いて頂きたいです。\n\nよろしくおねがいします✨", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@mkt_OCHA/works/15", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/b0e88aeb/uploads/origins/7fba573a-d848-4fee-baff-b86fda017f67?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=d70f2fd5931ec5cc566986148e443229", "srcset": "https://si.imgix.net/b0e88aeb/uploads/origins/7fba573a-d848-4fee-baff-b86fda017f67?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=d70f2fd5931ec5cc566986148e443229, https://si.imgix.net/b0e88aeb/uploads/origins/7fba573a-d848-4fee-baff-b86fda017f67?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=c7c68fa0db4bed54fade8c477c8fbf4f 2x, https://si.imgix.net/b0e88aeb/uploads/origins/7fba573a-d848-4fee-baff-b86fda017f67?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=475114c066ad0490d0579fc048fc79c1 3x"}, "private": true, "genre": "art", "tipped": false, "creator_id": 2676445, "client_id": 2682937, "nc": 144}, {"path": "/@mkt_OCHA/works/14", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2676445, "client_id": 2067340, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/00082ffa/uploads/origins/3e20da3d-f151-44c9-9796-d5986