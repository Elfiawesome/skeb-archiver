ば \n頭と手に見切れが無いように描いていただけますと嬉しいです。\nまた、人物と背景を分けたものもいただけますと助かります。\n\nお忙しいなか見て頂きありがとうございます。\nご縁がありますと嬉しいです！", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@arabikicoffee/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3912227, "client_id": 1182972, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/e6d82298/uploads/origins/2f0195e2-9e69-4925-9214-b25638a2cfee?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=13860c7444ce7090852da46d331e6246", "srcset": "https://si.imgix.net/e6d82298/uploads/origins/2f0195e2-9e69-4925-9214-b25638a2cfee?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=13860c7444ce7090852da46d331e6246, https://si.imgix.net/e6d82298/uploads/origins/2f0195e2-9e69-4925-9214-b25638a2cfee?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=086b87f6ff6b9530974359323af0c0d2 2x, https://si.imgix.net/e6d82298/uploads/origins/2f0195e2-9e69-4925-9214-b25638a2cfee?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ead4fe8ec2be723daf275426461e3b1a 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/e6d82298/uploads/origins/2f0195e2-9e69-4925-9214-b25638a2cfee?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=35ac3f8644db14647cd5f8da61c15ac6", "srcset": "https://si.imgix.net/e6d82298/uploads/origins/2f0195e2-9e69-4925-9214-b25638a2cfee?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=35ac3f8644db14647cd5f8da61c15ac6, https://si.imgix.net/e6d82298/uploads/origins/2f0195e2-9e69-4925-9214-b25638a2cfee?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=fdfac19ef5795c11e5c0eb317097d332 2x, https://si.imgix.net/e6d82298/uploads/origins/2f0195e2-9e69-4925-9214-b25638a2c