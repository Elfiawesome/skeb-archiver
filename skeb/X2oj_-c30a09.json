てのため、至らぬ点ばかりで申し訳ありません。\nお忙しいところ恐れ入りますが、ご検討いただけましたら幸いです。\nどうぞよろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/1bPDXIbuXB-tWeUPh-DnsY7s4WC5dH6W6", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@X2oj_/works/3", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/b8dcd92e/uploads/origins/8794124e-646d-40a6-9011-eefa2d275ec8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=10637b547861b8d111848707f9eb82eb", "srcset": "https://si.imgix.net/b8dcd92e/uploads/origins/8794124e-646d-40a6-9011-eefa2d275ec8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=10637b547861b8d111848707f9eb82eb, https://si.imgix.net/b8dcd92e/uploads/origins/8794124e-646d-40a6-9011-eefa2d275ec8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=d911936a057293bb25147407439c8a08 2x, https://si.imgix.net/b8dcd92e/uploads/origins/8794124e-646d-40a6-9011-eefa2d275ec8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=1cef7a1780ed100f4551716c6edce379 3x"}, "private": true, "genre": "art", "tipped": false, "creator_id": 2933674, "nc": 177}, {"path": "/@X2oj_/works/2", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/7aa7ef5a/uploads/origins/bbb6ed49-58f5-47dc-81b1-bf544c6e058a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=1c2d8d6a08837b3a003a10439b9378f9", "srcset": "https://si.imgix.net/7aa7ef5a/uploads/origins/bbb6ed49-58f5-47dc-81b1-bf544c