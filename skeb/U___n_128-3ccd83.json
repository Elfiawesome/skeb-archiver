fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=046fa61ee00d211e2c729352411f2bde 3x"}, "body": "こんにちは！私はあなたの作品がとても好きです。私のocを作成することができることを願っています。表情や動きの追加要件はありませんので、好きな衣装を自由に選択してください！\nhttps://drive.google.com/drive/folders/10a_epkHLWzwWo1ilYXOyx28vl5kkQ30N\n\nhttps://drive.google.com/drive/folders/10a_epkHLWzwWo1ilYXOyx28vl5kkQ30N", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@U___n_128/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3645137, "client_id": 3680146, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/24d4aa75/uploads/origins/5b4a4c11-ee4a-49f8-b2af-d05bcc055f8d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=01f9b9bef85dac74f4111b3c0bc48080", "srcset": "https://si.imgix.net/24d4aa75/uploads/origins/5b4a4c11-ee4a-49f8-b2af-d05bcc055f8d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=01f9b9bef85dac74f4111b3c0bc48080, https://si.imgix.net/24d4aa75/uploads/origins/5b4a4c11-ee4a-49f8-b2af-d05bcc055f8d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=5f341f1d0b6c9bb80e393a03d544bc5f 2x, https://si.imgix.net/24d4aa75/uploads/origins/5b4a4c11-ee4a-49f8-b2af-d05bcc055f8d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=cfeda1e076678487db987a29db9e8081 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/24d4aa75/uploads/origins/5b4a4c11-ee4a-49f8-b2af-d05bcc055f8d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0767df0bd2247310f79c9411d1f39647", "srcset": "https://si.imgix.net/24d4aa75/uploads/origins/5b4a4c11-ee4a-49f8-b2af-d05bcc055f8d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0767df0bd2247310f79c9411d1f39647, https://si.imgix.net/24d4aa75/uploads/origins/5b4a4c11-ee4a-49f8-b2af-d05bcc055f8d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=c5318a6db5dc71ac76d3b328604fb271 2x, https://si.imgix.net/24d4aa75/uploads/origins/5b4a4c11-ee4a-49f8-b2af-d05bcc055f8d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=139eeef35e9fe64db7d16a36d0a20d3d 3x"}, "body": "先生（せんせい）、こんにちは。\n推薦（すいせん）を見（み）ていて、長（なが）い間（あいだ）探（さが）していたところ、先生の画風（がふう）に一目（ひとめ）で惹（ひ）かれました。ぜひコラボレーションをさせていただきたいと思（おも）います。\n\n私（わたし）のオリジナルキャラクターは「巫狐（みこぎつね）」といいます。原型（げんけい）は神社（じんじゃ）にいる小（ちい）さな狐（きつね）です。アクセサリーが多（おお）いので、お手数（てすう）をおかけしますが、原稿（げんこう）の仕様（しよう）は先生が以前（いぜん）行（おこな）っていたものと同（おな）じで大丈夫（だいじょうぶ）です。\n\nアクセサリーの向（む）きやデザインなど、少（すこ）し気（き）をつけていただけると幸（しあわ）せです。ポーズは先生が自由（じゆう）に発揮（はっき）していただければと思います。\n\n本当（ほんとう）にありがとうございます。先生は私の女神（めがみ）です！\n\nhttps://drive.google.com/drive/folders/1RwGdxyabMx3MpemvugabLld3RB9XHKq4", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@U___n_128/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3645137, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/158c4dd4/uploads/origins/8ca010c3-57a3-4e0a-84ee-ea23959cbd7f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=cff8c885402ce8388acb324b23325bdd", "srcset": "https://si.imgix.net/158c4dd4/uploads/origins/8ca010c3-57a3-4e0a-84ee-ea23959cbd7f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=cff8c885402ce8388acb324b23325bdd, https://si.imgix.net/158c4dd4/uploads/origins/8ca010c3-57a3-4e0a-84ee-ea23959cbd7f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=3e989136cbc6df9fde74d0ff09ed379f 2x, https://si.imgix.net/158c4dd4/uploads/origins/8ca010c3-57a3-4e0a-84ee-ea23959cbd7f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=89d7a924558f35ab504f577ec10d42d8 3x"}, "duration": null, "nsfw": fal