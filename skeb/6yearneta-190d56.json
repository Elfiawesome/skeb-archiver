af815fa-f147-43dd-8327-145e0fb9e288?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6065a47b2efb504e0fc91c1727587960", "srcset": "https://si.imgix.net/639b6d23/uploads/origins/8af815fa-f147-43dd-8327-145e0fb9e288?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6065a47b2efb504e0fc91c1727587960, https://si.imgix.net/639b6d23/uploads/origins/8af815fa-f147-43dd-8327-145e0fb9e288?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=dbf004ce4c3375fc708420045bada72e 2x, https://si.imgix.net/639b6d23/uploads/origins/8af815fa-f147-43dd-8327-145e0fb9e288?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=7e3fc370adac9c4e04983824cc561f35 3x"}, "body": "いつもえちかわで素敵なイラストをありがとうございます。\n今度はクリスマスなリクエストをお願いします。\n\n【キャラ】\n艦これのザラ、妙高、古鷹\n\n【シチュエーション】\nザラ姉さまをセンターにクリスマスで大胆な3人\n古鷹さんと妙高さんの左右はおまかせします。\n衣装については後述します。\n\n【衣装】\nザラ姉さま：「プレゼントはザ・ラ♡」な感じで大胆でセクシーな格好でリボンが巻かれている\n妙高さんと古鷹さん：ジョンストンのクリスマス衣装\n\n【髪型】\nザラ姉さま：ツーサイドアップorツインテール\n妙高さんと古鷹さん：クリスマス衣装のジョンストンに合わせてツーサイドアップ\n（ツーサイドアップのうえで妙高さんや古鷹さんに合わせてのアレンジはOKです）\n\n【お胸の大きさ】\nザラ姉さまが一番大きくなるように、妙高さんと古鷹さんも大きくお願いします。\nhttps://skeb.jp/@6yearneta/works/9\n具体的にはこちらの大きさくらいだとうれしいです。\nジョンストン衣装でお胸どどーんだと色々すごいことになりそうです。\n\n【ケッコン指輪と海色リボン】\n指輪：全員着用していますが、見えないような角度なら無理に見えてなくてもOKです。\n海色リボン：クリスマスシチュ優先なので必須ではありませんが、着用していてももちろんOKです。\n\n【その他】\n指定していない所や詳細はおまかせします。\n\n\nどうぞ、よろしくお願いします。", "nc": 32, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@6yearneta/works/10", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2546026, "client_id": 916870, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/e5bd1d94/uploads/origins/8dfa742b-d7d0-4370-8e3d-8500c8b10a45?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a5fc3e5575b4323ac805948a5a5abc10", "srcset": "https://si.imgix.net/e5bd1d94/uploads/origins/8dfa742b-d7d0-4370-8e3d-8500c8b10a45?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a5fc3e5575b4323ac805948a5a5abc10, https://si.imgix.net/e5bd1d94/uploads/origins/8dfa742b-d7d0-4370-8e3d-8500c8b10a45?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ffd15f36501e8e63f38617bbf3be60e7 2x, https://si.imgix.net/e5bd1d94/uploads/origins/8dfa742b-d7d0-4370-8e3d-8500c8b10a45?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=5325792c91d82f4ed3a221dcf50020c1 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/e5bd1d94/uploads/origins/8dfa742b-d7d0-4370-8e3d-8500c8b10a45?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=31afc73066ae48d1fc723956356c97ec", "srcset": "https://si.imgix.net/e5bd1d94/uploads/origins/8dfa742b-d7d0-4370-8e3d-8500c8b10a45?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=31afc73066ae48d1fc723956356c97ec, https://si.imgix.net/e5bd1d94/uploads/origins/8dfa742b-d7d0-4370-8e3d-8500c8b10a45?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=b62d83b332c321428a5952e8c886cd4a 2x, https://si.imgix.net/e5bd1d94/uploads/origins/8dfa742b-d7d0-4370-8e3d-8500c8b10a45?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=3878ce0a416dee8566ccb05772b888c4 3x"}, "body": "いつもえっちでかわいいイラストをありがとうございます。\n今回はハロウィンな重巡長女ズの3人をお願いします。\n\n【キャラ】\n艦これのザラ、妙高、古鷹\n\n【シチュエーション】\nハロウィンの仮装でセクシーな衣装を着ていつも以上に大胆に迫る重巡長女の3人\nこれまでもずっと大胆でしたが、今までの「おいで～」と誘う雰囲気があったのに対して、今回は能動的で積極的！つまりは「逃・が・さ・な・い！」な雰囲気です。\n\nザラ姉さま、妙高さん、古鷹さんという重巡のみならず艦娘の中でも良識派で穏やかな重巡長女ズが大胆にえっちに、いつもよりも危うい感じで迫るのは果たして何があったのか？今夜はおたのしみですね！\n\n【衣装】\nハロウィンにちなんだ衣装をセクシーに\n3人とも同系統（おそろい）でも、それぞれ別系統でもOKです。\nまた同系統2人、もう1人は別系統もOKです。\n髪型は衣装や雰囲気に合わせての変更も歓迎ですが、必須ではありません。\n\n【お胸の大きさ】\nザラ姉さまが一番大きいです。\n最近、爆乳古鷹さんという概念が浮かんだので、今回は妙高さんより古鷹さんの方が大きいとうれしいです。\nhttps://skeb.jp/@6yearneta/works/9\n全体的にこちらくらいの大きさで、ザラ姉さまと妙高さんはこのままくらい、古鷹さんはザラ姉さま未満妙高さん以上でお願いしたいです。\n\n【海色リボンと指輪について】\n今回はハロウィンの衣装や仮装を優先していただきたいので、なしでもOKです。\nもちろん有りでもOKです。\n\n【その他】\n指定していない箇所や詳細はおまかせします。\n\n\nどうぞ、よろしくお願いします。", "nc": 33, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@6yearneta/works/9", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2546026, "client_id": 916870, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/0824556a/uploads/origins/8c953d75-be8a-4115-9cc2-07056af6baea?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=65ac210000acbbef1790adc9850218b3", "srcset": "https://si.imgix.net/0824556a/uploads/origins/8c953d75-be8a-4115-9cc2-07056af6baea?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=65ac210000acbbef1790adc9850218b3, https://si.imgix.net/0824556a/uploads/origins/8c953d75-be8a-4115-9cc2-07056af6baea?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ca8c21e3fc526f99bea19da913b6cd8a 2x, https://si.imgix.net/0824556a/uploads/origins/8c953d75-be8a-4115-9cc2-07056af6baea?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=0fbd870075b6bd267aa45193597c8ce5 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/0824556a/uploads/origins/8c953d75-be8a-4115-9cc2-07056af6baea?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=82b6305aefc931fa9e20895b71cba57f", "srcset": "https://si.imgix.net/0824556a/uploads/origins/8c953d75-be8a-4115-9cc2-07056af6baea?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=82b6305aefc931fa9e20895b71cba57f, https://si.imgix.net/0824556a/uploads/origins/8c953d75-be8a-4115-9cc2-07056af6baea?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=987cc0f3a0233316ef0a2272303b8ef