on": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/73b4828e/uploads/origins/ce7fe8f6-6aeb-4597-a4f3-51028544cc18?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=234c2a7ccb2f1b98657af05940defee7", "srcset": "https://si.imgix.net/73b4828e/uploads/origins/ce7fe8f6-6aeb-4597-a4f3-51028544cc18?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=234c2a7ccb2f1b98657af05940defee7, https://si.imgix.net/73b4828e/uploads/origins/ce7fe8f6-6aeb-4597-a4f3-51028544cc18?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=138a1d434d09e91a2a8a9b3ea4529225 2x, https://si.imgix.net/73b4828e/uploads/origins/ce7fe8f6-6aeb-4597-a4f3-51028544cc18?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=be490b316987e5134a5d4ee4c4c9a50c 3x"}, "body": "どうもこんにちわ。\n以下のようなキャラクターのイラストをお願いしたいです。\n\n〇キャラクター\n白衣とミニスカの似合うシーメール博士(マッドサイエンティスト)\n巨乳で、黒髪おかっぱ片目隠れ\nおちんちんは玉竿有り \n\n〇構図・シチュエーション\nシーメール博士が、人知を超える人型クリーチャー(バイオハザードのタイラントやネメシスみたいな人型巨体クリーチャー的な雰囲気のやつ)を開発。\n実験中の事後でクリーチャーが実験室から解き放たれて暴走、シーメール博士はクリーチャーに捕まり、背面セックスな体位でアナルを犯されながら手足を取り込まれていっているが、自分の最高傑作であるクリーチャーと一心同体になれることは素晴らしいことだと歓迎し、クリーチャーとの取り込まれアナルセックスを愉しんでいる。\n\n1コマ目に立絵。\n着衣状態でカルテかタブレットみたいなのを持たせて、開発実験が上手くいっていて得意げな笑みを浮かべている感じにしてください。\n\n2コマ目に取り込まれアナルセックス。\n服装は胸と股間が見えるような状態。半脱ぎでも下着でも全裸でも構いません。\nシーメール博士は、後ろに回した手足がクリーチャーの身体の中に取り込まれて同化されてる状態で、アナルをクリーチャーの巨根ちんぽに犯されている。\nシーメール博士のちんぽは勃起状態。\nクリーチャーは直立不動で、巨根ちんぽだけ勃起させてシーメール博士のアナルに挿入している。\n\n射精シーンがあると嬉しいです。\n\n以上です、よろしくお願いいたします。", "nc": 41, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@atorie_onemin39/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1862617, "client_id": 2935656, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/1637f697/uploads/origins/cfc61d0b-3eff-4308-b7e1-a899d5f26e57?bg=%23fff&auto=