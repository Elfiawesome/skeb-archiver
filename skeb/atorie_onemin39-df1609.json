ておじさんの子を3人妊娠出産済みであること\n　4人目を妊娠中であること等を報告している。", "nc": 57, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 818933, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "ティモシー(Timothy)", "screen_name": "Timothy45468279", "avatar_url": "https://pbs.twimg.com/profile_images/1680375410356535296/u0tggeXu.jpg", "header_url": null, "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 5, "complete_expiration_days": 90, "skills": [{"genre": "art"}, {"genre": "comic"}], "nc": 176}, {"id": 842482, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "オウガロード🔞", "screen_name": "monokuroiti", "avatar_url": "https://pbs.twimg.com/profile_images/1368160865602572293/h-rYamt4.jpg", "header_url": "https://pbs.twimg.com/profile_banners/899124273436016640/1761668057/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "art"}], "nc": 176}, {"id": 1030898, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "shu-ten", "screen_name": "ten102021", "avatar_url": "https://pbs.twimg.com/profile_images/1364482977481170945/Hs9xuMt-.jpg", "header_url": null, "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 90, "skills": [{"genre": "art"}], "nc": 177}, {"id": 1142924, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "朽", "screen_name": "1999_misc", "avatar_url": "https://pbs.twimg.com/profile_images/1517800162546315270/B-q3ILtF.jpg", "header