=200&s=2bb7cb55ef257d8cbaf64d67e234f61a 3x"}, "body": "先生、こんにちは！リクエストを受け付けてくださると聞いてとても興奮しています。私のオリジナルショタ・男の娘キャラ、サムくん（https://rebrand.ly/9fm6r0q）を描いていただけませんか？暑い夏の日に、ビーチサイドの小屋で働いているサムくんを描いてほしいです。卑猥なビーチ客（見えないか見えるか）にサービスしている様子で。\n\nメイド服ではなく、https://x.com/orangelepsy/status/1686338533911654400/photo/1 で描かれたような、白く半透明のスクール水着を基調とした衣装を希望します。 \n\n布地の下から乳首とペニスが透けて見えるように。汗だくで非常に恥ずかしがり、客に促されるかのように卑猥なポーズを取っている様子を。オプション：客の一人（彼の「主人」）が彼の身体を弄んでいる様子を描いても構いません：https://rebrand.ly/b0d2b6\n\nバリエーションをリクエストできるなら、サムくんに猫耳と尻尾をつけたバージョンを希望します。このコンセプトは自由にアレンジしてください。", "nc": 185, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}], "sent_works": [], "similar_creators": [{"id": 64351, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "三浦景幸", "screen_name": "kgyk_miura_pic", "avatar_url": "https://pbs.twimg.com/profile_images/1796218561066934272/Q7IAVYeO.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1125484223802961920/1593676294/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 90, "skills": [{"genre": "art"}, {"genre": "comic"}], "banned": false, "nc": 160}, {"id": 166300, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "もや紙", "screen_name": "korone000", "avatar_url": "https://pbs.twimg.com/profile_images/1575611997420683265/clYzgvNm.jpg", "header_url": "https://pbs.twimg.com/profile_banners/744035889450463233/1708807926/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 30, "skills": [{"genre": "art"}], "banned": false, "nc": 48}, {"id": 725063, "creator": true, "nsfw_acceptable": true, "acceptable": false, "name": "メグリム・ハルヨ", "screen_name": "megrim_haru