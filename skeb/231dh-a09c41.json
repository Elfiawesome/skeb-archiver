/notes/9u5ki5ldwjjd0dew", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@231dh/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "comic", "tipped": false, "creator_id": 1861000, "client_id": 2652985, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/26417cb5/uploads/origins/e9dfd5f1-9f21-457b-9b98-a962998edcff?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e184099b6509de41bd9550b10ac89474", "srcset": "https://si.imgix.net/26417cb5/uploads/origins/e9dfd5f1-9f21-457b-9b98-a962998edcff?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e184099b6509de41bd9550b10ac89474, https://si.imgix.net/26417cb5/uploads/origins/e9dfd5f1-9f21-457b-9b98-a962998edcff?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a300517ec80903ac593e5d0f21326a86 2x, https://si.imgix.net/26417cb5/uploads/origins/e9dfd5f1-9f21-457b-9b98-a962998edcff?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=28721717e8f272020cadbfbae8496d33 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/26417cb5/uploads/origins/e9dfd5f1-9f21-457b-9b98-a962998edcff?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=4b38cde1a1b9bcefc64c1a247aec5fd0", "srcset": "https://si.imgix.net/26417cb5/uploads/origins/e9dfd5f1-9f21-457b-9b98-a962998edcff?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=4b38cde1a1b9bcefc64c1a247aec5fd0, https://si.imgix.net/26417cb5/uploads/origins/e9dfd5f1-9f21-457b-9b98-a962998edcff?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=ec74e7f00eecd367b7a0110ef3f8bb47 2x, https://si.imgix.net/26417cb5/uploads/origins/e9dfd5f1-9f21-457b-9b98-a962998edcff?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=1dea6f63ec5c4d623ca53ea08c753151 3x"}, "body": "うちの子(代理＆くろむ＆りあら)のコミックをお願いしたいです。\nプロフィールやキャラクターデザインについては資料URLを参照願います。\n〇シチュエーション\n　代理とりあらが、代理ちゃんの部屋で格闘ゲームで対戦している様子。\n　くろむは、後の約束のために夕方くらいにやってきます。\n〇うちの子について\n　衣装は既定(キャラクターデザイン通り)でお願いします(アレンジ等加えていただいても構いません)。\n　その他細かな点についてはおまかせします。\n〇役割分担\n　代理：　1P側(左側)。スタンダードで分かりやすい攻めキャラを選びがち。手数の多いテクニカルキャラやトリッキーなキャラは\n　　　　　使うのも相手するのも苦手です。守りが弱いので、攻め切って完勝するか守り切れず完敗するかの両極端です。\n　りあら；2P側(右側)。強さや使いやすさは度外視で、見た目や動きが可愛いキャラを選びがち。あまり高度なことは出来ませんが、\n　　　　　運や偶然(と代理のミス)の積み重ねで、結構いい勝負をします。\n　くろむ：今回はゲーム不参加ですが、どんなキャラでもそれなりに使えるのと、シンプルに守りが固いので、三人の中では最強です。\n　　　　　二人が、来訪に気付かず夢中になっているのを見て「まーたやってるなこいつら」と呆れつつ止めに入る係です。\n〇呼称とか\n　代理：　一人称は「うち」。2人のことは「くろむ」「りあら」と呼び捨てで。\n　くろむ：一人称は「私」。2人のことは「れいま」「りあら」と呼び捨てで。\n　りあら：一人称は「あたし」。2人のことは「れいちゃん」「くろちゃん」と呼んでます。\n　3人の間の会話は全て口語タメ口で問題ないです。\n〇内容\n　代理とりあらが、勝敗に一喜一憂しながら、格闘ゲームで延々と対戦しています。\n　だんだんとヒートアップはしていきますが、暴力はゲーム内で完結させています(ゲームの鬱憤はゲームで晴らす)。\n　ゲーム機本体やゲーム画面については描かなくても大丈夫です。もし描く場合は実在しない架空のものにしてください。\n　代理が格闘ゲームにそこそこガチ目なので、ジョイスティックを二人分用意しています。ただ、基本的にはエンジョイ勢なので、ネット対戦とかはしないです。\n　　ジョイスティック参考：https://www.amazon.co.jp/dp/B07RK349DY/\n　　※ あくまで参考ですので、アレンジしてもいいですし、色とかも好きに変えていただいて構いません(そのままだと武骨すぎるので)。\n　ジョイスティックを机上に置いて使う関係で、結構揺れたりするので、飲み物とかは机上に置かないです。\n　ネーム・コマ割り等に関しては全面的におまかせします。\n〇その他参考\n　資料URLはキャラクター紹介となっています(プロフィール等も記載しています)。\n　キャラクターデザイン依頼の納品イラストのURLも記載していますので、併せて参照いただければと。\n　(描き手の数だけ解釈があるという認識ですので、自由にやっていただけたらと思います)。\n　また、各キャラクターを動かす際の参考として、これまでのコミックの依頼URLを記載しておきます。\n　https://skeb.jp/@hyashiro_88/works/7\n　https://skeb.jp/@wara_straw/works/18\n　https://skeb.jp/@amkn/works/8\n\nhttps://otadon.com/@reima/113064518119407094", "nc": 152, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@231dh/works/3", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/f06e6cef/uploads/origins/c26e66f3-858b-4902-be00-8d8f0586b266?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=cbf2081b5349ea9c3