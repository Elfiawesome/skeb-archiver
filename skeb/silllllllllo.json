d5e-99bd-233b64961b94?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=26ad65da3d441da1d5ea44d45d8ecb2c, https://si.imgix.net/550f1390/uploads/origins/dfe7af09-0bbf-4d5e-99bd-233b64961b94?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=b4b0d617d8cd0f6afc38ee21844817c8 2x, https://si.imgix.net/550f1390/uploads/origins/dfe7af09-0bbf-4d5e-99bd-233b64961b94?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=66c17c0ae66662e937fc2ec8e678c672 3x"}, "body": "Hello! I’m in love with your Fate series artwork and was hoping to make a request drawing one of my characters Levin\n\nLevin is a swordmaster who has a very beautiful if androgynous face, kinda like Enkidu from Fate. He’s not quite human and instead has a sort of perfect humanoid shell for his true form which is kinda like a harmless slime monster. He has the sort of detached personality befitting someone like former nobility or a weakened god\n\nI was hoping for an artwork of Levin in front of a ruined shrine in the mountain, one completely returned to nature\n\nIf possible i’d like a picture of just Levin without the background too if that isn’t too difficult.\n\n\nPlease feel free to add any characters to my character or the scene to make it feel fitting. Thank you so much in advance!\n\nReference: https://drive.google.com/drive/folders/1cTQA31m2XT1_z9WirsgCbdTCQ-uo-Jzy?usp=sharing\n\nhttps://drive.google.com/drive/folders/1cTQA31m2XT1_z9WirsgCbdTCQ-uo-Jzy?usp=sharing", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@silllllllllo/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2999290, "client_id": 2963352, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/ac0db5b9/uploads/origins/78a23429-d3ab-4e1c-a7b0-9d023acec88e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=946eaf8026e0aeb6a1dddc56c06be7aa", "srcset": "https://si.imgix.net/ac0db5b9/uploads/origins/78a23429-d3ab-4e1c-a7b0-9d023acec88e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=946eaf8026e0aeb6a1dddc56c06be7aa, https://si.imgix.net/ac0db5b9/uploads/origins/78a23429-d3ab-4e1c-a7b0-9d023acec88e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=61da4c9d65c05fe18ac3dd056c5ea3f8 2x, https://si.imgix.net/ac0db5b9/uploads/origins/78a23429-d3ab-4e1c-a7b0-9d023acec88e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=85d743bfd39dff42bafdc85cf5e41407 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/ac0db5b9/uploads/origins/78a23429-d3ab-4e1c-a7b0-9d023acec88e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=175d357d2531235f7b34d4d9c9d5f045", "srcset": "https://si.imgix.net/ac0db5b9/uploads/origins/78a23429-d3ab-4e1c-a7b0-9d023acec88e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=175d357d2531235f7b34d4d9c9d5f045, https://si.imgix.net/ac0db5b9/uploads/origins/78a23429-d3ab-4e1c-a7b0-9d023acec88e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=e80af7f845018fe3ccf80879a264fb48 2x, https://si.imgix.net/ac0db5b9/uploads/origins/78a23429-d3ab-4e1c-a7b0-9d023acec88e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=712a03e8989cf1af3b3b816936f15d77 3x"}, "body": "あなたの作品が本当に好きで、その美しさと暗さが大好きです！あなたの作品が本当に好きで、その美しさと暗さが大好きなので、ぜひイラストを依頼したいです！できるだけ詳細なシーンを描いてほしい。\nキャラクターは以下の通りで、ゴキブリを擬人化した設定で、彼女のイラストを描いていただけたらと思います！ハンマーや斧などを集め、ゴキブリを繁殖させ、蝶の標本が好きで、血が好きというキャラクターなので、そういった要素も描く際の参考にしていただければと思います！\nコラボできるのを楽しみにしています🥺🥺🥺🥺🥺🥺🥺🥺🥺🥺🥺 お絵かきでお邪魔してすみません\n\nキャラクター参考\nhttps://x.com/NhubaoT11351/status/1985670123819327781?t=paf6gyBhI2OUCqdlcpe2Qw&s=19\n描く衣装は自由です！\n\nところで、私はあなたのこの作品がとても好きです！このようなダークで血と美しく繊細なイメージの絵が描けたらなぁ〜。\nhttps://x.com/silllllllllo/status/1983197662695567419?t=GfgxgRdYv5IAH8kHsrInvg&s=19\n\nhttps://x.com/NhubaoT11351/status/1985670123819327781?t=paf6gyBhI2OUCqdlcpe2Qw&s=19", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@silllllllllo/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2999290, "client_id": 3539653, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/2d657281/uploads/origins/195cbd1b-996d-4109-9d14-30f334d314d1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4f1859d0ec65f3a23c0e23a218584fc7", "srcset": "https://si.imgix.net/2d657281/uploads/origins/195cbd1b-996d-4109-9d14-30f334d314d1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4f1859d0ec65f3a23c0e23a218584fc7, https://si.imgix.net/2d657281/uploads/origins/195cbd1b-996d-4109-9d14-30f334d314d1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=9fedca4235ebdd29339e893cb3e4057f 2x, https://si.imgix.net/2d657281/uploads/origins/195cbd1b-996d-4109-9d14-30f334d314d1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=234791d548f8b07b019ff6f505ab448b 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/2d657281/uploads/origins/195cbd1b-996d-4109-9d14-30f334d314d1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=7d877fe061fc0f3c8f8c4361143feb05", "srcset": "https://si.imgix.net/2d657281/uploads/origins/195cbd1b-996d-4109-9d14-30f334d314d1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=7d877fe061fc0f3c8f8c4361143feb05, https://si.imgix.net/2d657281/uploads/origins/195cbd1b-996d-4109-9d14-30f334d314d1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=e534a95b17e899852a2b4903c573df01 2x, https://si.imgix.net/2d657281/uploads/origins/195cbd1b-996d-4109-9d14-30f334d314d1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=8993395eb718032fd3a7831ede077e3d 3x"}, "body": "はじめまして！いつものFateの絵、特にジャンヌの描き方がとても好きで、リクエストさせていただきました！私のウェブ小説の主人公アリアを描いていただけませんか？\n\nアリアは剣士と魔導士の家系。彼女の国は、家族のほとんどが殺された激しい戦争の後、破壊されたままになっている。彼女は気高く控えめな性格で、一族の後継者であり、騎士のような剣士である。\n\n私はアリアが自宅の廃墟で家族の肖像画の前にいる作品を期待していた。  \n\nその肖像画は戦前のもので、アリアが家族に囲まれた子供だった頃のものだ。彼女の父親と兄弟は国のために戦った剣士で、アリアの妹、赤ん坊を抱いた母親、使用人の幼なじみもいる。私のアイデアと似たようなことを、このhttps://x.com/silllllllllo/status/1983197662695567419/photo/1。\n\n可能であれば、肖像画だけのバージョンと、現在のアリアが写真の前の実家の廃墟にいるバージョンが欲しいです。肖像画が、彼女の父、兄弟、召使いの上に血まみれで廃墟になっているのは、象徴的に合っていると思います。\n\n私のキャラクターやシーンについて、お好きなところを追加してください！お断りや再送はご自由にどうぞ！よろしくお願いします！\n\nアリアの参考文献\nhttps://drive.google.com/drive/folders/1i7zuLfo5svdEmKtW6hh8lVjhigBoFhiC?usp=drive_link\n\nアリアの剣\nhttps://imgur.com/a/lgvcD2x\n\nアリアの両親：\nhttps://imgur.com/a/arias-parents-xVEts3o\n\nアリアの兄弟\nhttps://imgur.com/a/brothers-eQnt7pr\n\n姉とメイド：\nhttps://imgur.com/a/mary-carol-E23wmJt", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@silllllllllo/works/4", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/84fb9eec/uploads/origins/b7598c0f-2861-40a0-a5c2-8e0cdb25b1b3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=c00f7da38e58f9652164a5cf524006a2", "srcset": "https://si.imgix.net/84fb9eec/uploads/origins/b7598c0f-2861-40a0-a5c2-8e0cdb25b1b3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=c00f7da38e58f9652164a5cf524006a2, https://si.imgix.net/84fb9eec/uploads/origins/b7598c0f-2861-40a0-a5c2-8e0cdb25b1b3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold