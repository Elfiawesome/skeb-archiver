ージングで一枚イラストをお願いできないでしょうか。\n髪型などもお任せします。\n\n描いていただいたイラストはご本人へプレゼントしたいと考えています。\n硝子さんの活動での使用許可をいただけましたら幸いです。\nまた背景等ありましたら透過の差分があると嬉しいです。\n検討いただけましたら幸いです。\n\n資料URLに硝子さんのイラスト資料集がございます。\n\nhttps://twitter.com/Tamashoko_/status/1528189295445495808?s=20", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Shigu_RoNa/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 957245, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/e1317ed7/uploads/origins/c7b94523-c1d6-4636-8ce2-c524248119fa?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8768cfd0046ad7b934b67e4a9aeb7f10", "srcset": "https://si.imgix.net/e1317ed7/uploads/origins/c7b94523-c1d6-4636-8ce2-c524248119fa?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8768cfd0046ad7b934b67e4a9aeb7f10, https://si.imgix.net/e1317ed7/uploads/origins/c7b94523-c1d6-4636-8ce2-c524248119fa?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=be3825aa97cf89470bc760dcd5c87fa6 2x, https://si.imgix.net/e1317ed7/uploads/origins/c7b94523-c1d6-4636-8ce2-c524248119fa?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b180c7de3aa93960e5fdf5a1285ffbb1 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/e1317ed7/uploads/origins/c7b94523-c1d6-4636-8ce2-c524248119fa?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=936a9925115bb6dd215a1ba82206ce75", "srcset": "https://si.imgix.net/e1317ed7/uploads/origins/c7b94523-c1d6-4636-8ce2-c524248119fa?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=936a9925115bb6dd215a1ba82206ce75, https://si.imgix.net/e1317ed7/uploads/origins/c7b94523-c1d6-4636-8ce2-c524248119fa?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=