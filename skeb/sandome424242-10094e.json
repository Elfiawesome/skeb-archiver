19f3-4e00-b3b6-125d34182434?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b93d592f8f6a1e4873b41e9438d2e0c6, https://si.imgix.net/751c0769/uploads/origins/e1321077-19f3-4e00-b3b6-125d34182434?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f058552f4550442408202f17291aa4b4 2x, https://si.imgix.net/751c0769/uploads/origins/e1321077-19f3-4e00-b3b6-125d34182434?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=16b00da57ee2194e36480482dcf51b62 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/751c0769/uploads/origins/e1321077-19f3-4e00-b3b6-125d34182434?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=fc2aeacbcff2ded19ad1665c78b8a009", "srcset": "https://si.imgix.net/751c0769/uploads/origins/e1321077-19f3-4e00-b3b6-125d34182434?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=fc2aeacbcff2ded19ad1665c78b8a009, https://si.imgix.net/751c0769/uploads/origins/e1321077-19f3-4e00-b3b6-125d34182434?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=abd26ba56c68afef54211883e9457470 2x, https://si.imgix.net/751c0769/uploads/origins/e1321077-19f3-4e00-b3b6-125d34182434?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=88ccf13f44588d9cdd4f19b80a57a46f 3x"}, "body": "こんにちは～ トップページであなたの作品を見ました。とても印象的ですね！ スケッチをお願いしたいのですが、個人利用用になります。\n\n「PEEKING-IN HEADER」\n\nマサミ～ キャラクターのテーマは片思いと運命の赤い糸です。彼女は恋に悩む、精神的に不安定な少女です。 彼女が身につけている花は「ストライプカーネーション」です。スカートの裾にある破れた布のディテールにご注意ください。メイクのディテールにもご留意ください。\n\n私のお気に入りのテーマは「運命の赤い糸」です。ぜひ取り入れてみてください。例えば、その糸がキャラクターを巻きついている様子や、感情が不安定な表情などです。 \n\n色はご自由に変更していただいて構いません。ホラーテーマや血の表現が大好きです。極端な感情表現も大好きですが、それはお任せします。\n\nhttps://www.deviantart.com/stash/219rn3n94uzt", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@sandome424242