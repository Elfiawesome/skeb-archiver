展開していただきたいです！\n\n■グッズ化\nBOOTHなどでグッズ化する可能性がございます。\n\n【納品のカタチ】\nMV用ですので、可能であれば比率16：9の横長\n人物のみの背景透過もあれば嬉しいです。\n\n色々要望があり大変申し訳ございませんが、\n無理はせず、ご検討いただければと存じます。\n何卒よろしくお願いいたします。\nhttps://x.com/Aries_VTuber_RB", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 1228629, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "メ・バヂス・バ名言bot", "screen_name": "GRONGIKBTIT", "avatar_url": "https://pbs.twimg.com/profile_images/2107834927190519808/UssFUL2W.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1736000677133119488/1791561114/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "art"}], "banned": false, "nc": 48}, {"id": 2177354, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "うさ🍑みみ ☕️🍞⚙️", "screen_name": "usahana101", "avatar_url": "https://pbs.twimg.com/profile_images/1986768949271461888/a_1AfK9h.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1317783337285545985/1760519719/1500x500", "appeal_receivable": false, "popular_creator_rank": 60, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "art"}, {"genre": "comic"}], "banned": false, "nc": 48}, {"id": 2825679, "creator": true, "nsfw_acceptable": false, "acceptable": false, "name": "絵が好き", "screen_name": "noname__da", "avatar_url": "https://pbs.twimg.com/profile_images/1992984809367564288/jda4CUZZ.jpg", "header_url": null, "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_da