装（参考URL：https://popnmusic.fandom.com/wiki/Poet?file=Poet91P.png　足が見切れてますが赤い靴を履いてます。）\n\nシチュエーション↓\n\n①プールに落としたプレゼントを取ろうとしている（ギリギリ届いていない感じで！）\n\n②プレゼントは取れたけど、今度は足を滑らせて背中からプールに落下しちゃう！同時に持ってたプレゼントも誤って放してしまう！（焦って「きゃっ！」と叫んでいる）\n\n③水面から「ぷはっ！」と顔を出し、浮き輪に掴まっている\n\n④プールから上がった後、全身びしょ濡れになってしまい、その場でぺたん座りして涙目になっちゃう。\n\n\nシチュエーションが細かくなりますがよろしくお願いします！", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@uwomushi/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1236130, "client_id": 937070, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/adad2306/uploads/origins/154a6be1-7cad-4caf-a3a2-55f1501facee?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ab9d67b22357733d12e43e1190f24e41", "srcset": "https://si.imgix.net/adad2306/uploads/origins/154a6be1-7cad-4caf-a3a2-55f1501facee?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ab9d67b22357733d12e43e1190f24e41, https://si.imgix.net/adad2306/uploads/origins/154a6be1-7cad-4caf-a3a2-55f1501facee?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=97602228b62ec21502ca017a5b8cd062 2x, https://si.imgix.net/adad2306/uploads/origins/154a6be1-7cad-4caf-a3a2-55f1501facee?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=8023813e062b4d943235c09e828d01ff 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/adad2306/uploads/origins/154a6be1-7cad-4caf-a3a2-55f1501facee?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a1a9cc0fa6e2e1b9aca7699de184ba0e", "srcset": "https://si.imgix.net/adad2306/uploads/origins/154a6be1-7cad-4caf-a3a2-55f1501facee?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a1a9cc0fa6e2e1b9aca7699de184ba0e, https://si.imgix.net/adad2306/uploads/origins/154a6be1-7cad