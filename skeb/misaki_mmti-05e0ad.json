app.goo.gl/HERp5Ru547cMZDdN7\n\nまた、雰囲気としてはヤンデレの女性が醸し出すような妖艶な色気を\n感じられる表情・ポージングでお願いしたいです。\n（ただ、ヤンデレっぽくと言っても、今回は血や傷などを連想させないで、\n　純潔な感じでお願いします）\n\nそのほか詳細なポーズ・構図・全身／アップなどは全てお任せします。\n\nなお、FAとしてプレゼントしたいので、配信・サムネ・Twitter等で使用されることを\nご了承ください。\nまた、サムネイル等の素材として使えるよう、本人部分のみの透過素材もご用意いただけると\nありがたいです。\n\nよろしくお願いいたします！\n\nhttps://twitter.com/AmehokiYuki", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@misaki_mmti/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1273897, "client_id": 1677132, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/d6d2c585/uploads/origins/d3c3eea6-8278-4d5d-8334-f99524824a40?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e6483cb396cb8da6cdbc49d50e1ee5bb", "srcset": "https://si.imgix.net/d6d2c585/uploads/origins/d3c3eea6-8278-4d5d-8334-f99524824a40?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e6483cb396cb8da6cdbc49d50e1ee5bb, https://si.imgix.net/d6d2c585/uploads/origins/d3c3eea6-8278-4d5d-8334-f99524824a40?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=2ce7dcd3f4f4759d2420e50953af009c 2x, https://si.imgix.net/d6d2c585/uploads/origins/d3c3eea6-8278-4d5d-8334-f99524824a40?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b21ec67998293f2933496a04aa7ececb 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/d6d2c585/uploads/origins/d3c3eea6-8278-4d5d-8334-f99524824a40?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=aa33c0ec3b2984d05f5b157cb909c84e", "srcset": "https://si.imgix.net/d6d2c585/uploads/origins/d3c3eea6-8278-4d5d-8334-f99524824a40?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=aa33c0ec3b2984d05f5b157cb909c84e, https://si.imgix.net/d6d2c585/uploads/origins/d3c3eea6