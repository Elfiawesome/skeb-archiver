d 2x, https://si.imgix.net/9b642758/uploads/origins/5b414c6f-8d26-4756-8f05-bcb32ebb3196?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=33fe4e623d7b7926ea00da9633df39e2 3x"}, "private": true, "genre": "art", "tipped": false, "creator_id": 3591315, "client_id": 33114, "nc": 177}, {"path": "/@kurominokagura0/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3591315, "client_id": 182552, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/18da8789/uploads/origins/6a9d79c8-9dbe-47c5-a910-a9e3d85c6d92?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9250df48742d7c643f17ee99b24ee39b", "srcset": "https://si.imgix.net/18da8789/uploads/origins/6a9d79c8-9dbe-47c5-a910-a9e3d85c6d92?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9250df48742d7c643f17ee99b24ee39b, https://si.imgix.net/18da8789/uploads/origins/6a9d79c8-9dbe-47c5-a910-a9e3d85c6d92?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=7c48e4f9a80ba6c0192a0db52b3c0c3c 2x, https://si.imgix.net/18da8789/uploads/origins/6a9d79c8-9dbe-47c5-a910-a9e3d85c6d92?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=07803c00d06502a0b5afccb9c4ae6c49 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/18da8789/uploads/origins/6a9d79c8-9dbe-47c5-a910-a9e3d85c6d92?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=70ab6694547e616bdc01d6052ffa77fd", "srcset": "https://si.imgix.net/18da8789/uploads/origins/6a9d79c8-9dbe-47c5-a910-a9e3d85c6d92?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=70ab6694547e616bdc01d6052ffa77fd, https://si.imgix.net/18da8789/uploads/origins/6a9d79c8-9dbe-47c5-a910-a9e3d85c6d92?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=25773d18e2f12c69af6b693b6e2c956e 2x, https://si.imgix.net/18da8789/uploads/origins/6a9d79c8-9dbe-47c5-a910-a9e3d85c6d92?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=e0d11d21261311ea6f07c14b3409dbba 3x"}, "body": "こんにちは。\n前回は素敵なウルジュラさんのイラストをありがとうございました。\n\n今回もウルジュラさんのイラストをお願いしたいです。\n内容としては、前回のイラストと同様ウルジュラさんはシーツの上に寝転がっていますが、\n彼女の足先に裸のエリオが倒れています。(エリオは下半身のみで上半身は絵からはみ出す形でもOKです。）\n彼女は股を広げ、おマンコから搾精器官を伸ばして彼のチンポを咥えます。そして精液を大量に搾り取り、次々と彼女のおマンコの中へと送られて行っています。ただ少し多すぎたのか、管とおマンコの隙間から溢れた精液が飛沫を上げて飛び散っています。そのお陰で彼女の下乳及びおマンコ周辺はその精液で汚れており、彼女の片頬にも、その内の遠くへ跳ねた一滴が付いてしまっています。\nこの時のウルジュラさんについては、白衣は着たままですが、帽子は脱いで横に置いていてもらいたいです。更にブラも外しておっぱいを露出させ、乳首から母乳をダラダラと垂れ流していて欲しいです。\n\n以上、ご検討頂けると幸いです。", "nc": 49, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@kurominokagura0/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3591315, "client_id": 182552, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/9971d4df/uploads/origins/a103dd9b-061b-41ca-b004-8a268bd8a237?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=432b38fdffb88349907a71eb2005dcf8", "srcset": "https://si.imgix.net/9971d4df/uploads/origins/a103dd9b-061b-41ca-b004-8a268bd8a237?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=432b38fdffb88349907a71eb2005dcf8, https://si.imgix.net/9971d4df/uploads/origins/a103dd9b-061b-41ca-b004-8a268bd8a237?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=dfa336cb75985baa5f4271ed254376d2 2x, https://si.imgix.net/9971d4df/uploads/origins/a103dd9b-061b-41ca-b004-8a268bd8a237?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ae495ca7502944d90b462d34c8f8b002 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/9971d4df/uploads/origins/a103dd9b-061b-41ca-b004-8a268bd8a237?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ddcbd5169b96921bbe82d16ebea90690", "srcset": "https://si.imgix.net/9971d4df/uploads/origins/a103dd9b-061b-41ca-b004-8a268bd8a237?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ddcbd5169b96921bbe82d16ebea90690, https://si.imgix.net/9971d4df/uploads/origins/a103dd9b-061b-41ca-b004-8a268bd8a237?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=6bf66636a0414fca6c657c27abb56450 2x, https://si.imgix.net/9971d4df/uploads/origins/a103dd9b-061b-41ca-b004-8a268bd8a237?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=c1a9f1ceefb672c8868840f393b22284 3x"}, "body": "こんにちは。\n下記の通り依頼させて頂きます。\n\n『淫魔の館と呪われたエリオ』より、ウルジュラさんの抱き枕カバー風イラストをお願いします。\n\nまた、もし差分がOKでしたら、以下の差分をお願いしたいです。\n①ウルジュラさんの足先に、裸で倒れたエリオを追加。(エリオは下半身のみで上半身は絵からはみ出す形でもOKです。)彼女はおマンコから搾精器官を伸ばし、愛液を涎の様に垂らしながら彼のチンポを咥えようとしている。\nこの時、彼女はブラを外しておっぱいを露出させ、母乳をじわりとにじみ出させて欲しいです。\n②①の状況から進み、搾精器官によってエリオが大量の精液を搾り取られている様子。この時出ている母乳は①の時より勢い良く噴出している。\n③各シーンごとの帽子着脱差分\n\n以上、ご検討頂けると幸いです。", "nc": 48, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@kurominokagura0/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3591315, "client_id": 1853984, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/ec7391e7/uploads/origins/44eaa7f9-7cbd-44be-9a15-b0b4163f9b41?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=44013ff32453139cdd5a83936ea74074", "srcset": "https://si.imgix.net/ec7391e7/uploads/origins/44eaa7f9-7cbd-44be-9a15-b0b4163f9b41?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=44013ff32453139cdd5a83936ea74074, https://si.imgix.net/ec7391e7/uploads/origins/44eaa7f9-7cbd-44be-9a15-b0b4163f9b41?bg=%23fff&aut