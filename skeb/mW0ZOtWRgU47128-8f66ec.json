ていただけないでしょうか。\n私のイチ推しキャラでして、以前電子辞書さんが描かれていた彼女のイラストがとても好きで、、どうかまた見たいと思い、今回依頼をさせていただきました。\n\n大きな獣と獣人少女が共にいるキャラクターですが、イラストは少女メインでお願いしたいです。少女のみで描かれても全く問題はないです。\n構図については、お任せにさせていただきたいです。全身が映っていたり、顔面アップなど、オルトロスが描かれていればどんな感じでも嬉しいです。\n\nキャラデザインについてはこちらのURLを参考にしていただければと思います。\n（https://othellonia.com/about/character?keyword=%E5%A5%94%E9%A8%B0&element=2）\n（https://othellonia.com/about/character?keyword=%E5%8F%8C%E9%A0%AD&element=2）\n公式のデザインについて、装飾など全てを完璧に再現する必要はありません。全く別の衣装を描かれても大丈夫です。武器など持っていますが、描かなくても問題ありません。あくまで参考として、描きやすいように描いていただければありがたいです。\n\nまた、イラストはカラーとモノクロどちらでも大丈夫です。描きやすい方でお願いします。\n\n色々とお任せにしてしまい恐縮ですが、もしお時間がありましたら、よろしくお願いいたします。", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@mW0ZOtWRgU47128/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2984960, "client_id": 300145, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/ad2302a1/uploads/origins/d3496f2e-82b0-4fa4-9ec3-3a2db5a1c6f1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9440bac2dc7db57250babc68670e9b88", "srcset": "https://si.imgix.net/ad2302a1/uploads/origins/d3496f2e-82b0-4fa4-9ec3-3a2db5a1c6f1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9440bac2dc7db57250babc68670e9b88, https://si.imgix.net/ad2302a1/uploads/origins/d3496f2e-82b0-4fa4-9ec3-3a2db5a1c6f1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=6f67872ed95cc6f1ab21fb1f7ee3e462 2x, https://si.imgix.net/ad2302a1/uploads/origins/d3496f2e-82b0-4fa4-9ec3-3a2db5a1c6f1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=95a546e4d6239befd661e83dc80a2049 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/ad2302a1/uploads/origins/d3496f2e-82b0-4fa4-9ec3-3a2db5a1c6f1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=