uploads/origins/34c65d07-e59a-4db9-a2c5-ec9bda7ca4f9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8efde21f1511b40b171105d3e2e171e6", "srcset": "https://si.imgix.net/88a0bcc4/uploads/origins/34c65d07-e59a-4db9-a2c5-ec9bda7ca4f9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8efde21f1511b40b171105d3e2e171e6, https://si.imgix.net/88a0bcc4/uploads/origins/34c65d07-e59a-4db9-a2c5-ec9bda7ca4f9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=0c3c1a86690636a2f30b3f6dd5349bd1 2x, https://si.imgix.net/88a0bcc4/uploads/origins/34c65d07-e59a-4db9-a2c5-ec9bda7ca4f9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=36f34bc786ad07d49190304ffb072f39 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/88a0bcc4/uploads/origins/34c65d07-e59a-4db9-a2c5-ec9bda7ca4f9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a6f7951b8a28add4ae0f60b6614c4734", "srcset": "https://si.imgix.net/88a0bcc4/uploads/origins/34c65d07-e59a-4db9-a2c5-ec9bda7ca4f9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a6f7951b8a28add4ae0f60b6614c4734, https://si.imgix.net/88a0bcc4/uploads/origins/34c65d07-e59a-4db9-a2c5-ec9bda7ca4f9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=9472317e7f79b289a5279fd830da8dd3 2x, https://si.imgix.net/88a0bcc4/uploads/origins/34c65d07-e59a-4db9-a2c5-ec9bda7ca4f9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=d6f95936ca754c4a96596e1321f750aa 3x"}, "body": "うちの子のはると、おもちさんのホワイトちゃん（成体）が、二人で世界（もしくは惑星）を玩具にしながら遊んでいる様子をお願い致します。\n\n両者共にスイッチが入って汗だくむわむわの裸で、汗や匂いを撒き散らしながら、周囲に浮かぶ存在を二人で足裏、脇、抱き合って挟んで臭い責めしたり、可能であればナカにそれらを入れてえっちしている様子があれば嬉しいです。\n\nホワイトちゃんの体型はお任せ致しますが、はるの胸、ふたなり、精巣はなるべく大きめだとありがたいです。ふたなりの形状はイヌ科の物と殆ど同じ形状ですが、難しそうであれば人間の物と同じ形状で大丈夫です。\n\nイラスト:https://twitter.com/HAL_0012/status/1396385989459791876?s=19\n\n文面での設定:https://www.evernote.com/shard/s658/sh/430afe78-e255-4223-941e-4f0209af28c3/86fa01315967e39141c1456c31b4d00b\n\nふたなりの大きさイメージ:https://www.pixiv.net/artworks/84239906", "nc": 160, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@mochimoti_o/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1254754, "client_id": 745571, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/714ea149/uploads/origins/4658a51b-6713-4ad6-930b-68787e069e28?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e0224e1376db20137badeb10abe06233", "srcset": "https://si.imgix.net/714ea149/uploads/origins/4658a51b-6713-4ad6-930b-68787e069e28?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e0224e1376db20137badeb10abe06233, https://si.imgix.net/714ea149/uploads/origins/4658a51b-6713-4ad6-930b-68787e069e28?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=902470b615aa64eb992dd3e3de384d4c 2x, https://si.imgix.net/714ea149/uploads/origins/4658a51b-6713-4ad6-930b-68787e069e28?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=458619390ee6fa93713b63404fabe672 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/714ea149/uploads/origins/4658a51b-6713-4ad6-930b-68787e069e28?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=4505b68aee580b61cbe620374fd2dd7e", "srcset": "https://si.imgix.net/714ea149/uploads/origins/4658a51b-6713-4ad6-930b-68787e069e28?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=4505b68aee580b61cbe620374fd2dd7e, https://si.imgix.net/714ea149/uploads/origins/4658a51b-6713-4ad6-930b-68787e069e28?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=0c8e2b35c6d8b261b5bac185d16e08cb 2x, https://si.imgix.net/714ea149/uploads/origins/4658a51b-6713-4ad6-930b-68787e069e28?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=6e630e2e545ced0e07dcc7affcf3a535 3x"}, "body": "skebを開かれていらっしゃる事に今しがた気付いたので支援も兼ねてご依頼させて頂きたく存じ上げまする…！！\n \n是非、幼体ホワイトちゃんとうちの竜人のレクティシアさんとコラボさせていただきたいですん…！✨\nご依頼の内容ですが、幼体ホワイトちゃんとレクティシアさんが人間の街を汗ばんだ蒸れ蒸れの足で踏み潰したり、足指の間に人間を挟んでいるような感じのものを…！\n\nアングル等はおもちさんの好きなもので構いません…！\nむしろ気楽に自由に描いて貰えれば嬉しいです🙏\nレクティシアさんですが、服を着せずに裸でも大丈夫ですー！\nよろしくお願いします！！\n\nhttps://twitter.com/lecticia_intend/status/1404081368288555012?s=21", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}], "sent_works": [{"path": "/@HAL_0012/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "novel", "tipped": false, "creator_id": 29561, "client_id": 1254754, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/7ffdb163/uploads/origins/e91cd265-14b8-4d69-a722-038f748b5e8a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e15e050babbe6604263fd22b382686f0", "srcset": "https://si.imgix.net/7ffdb163/uploads/origins/e91cd265-14b8-4d69-a722-038f748b5e8a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e15e050babbe6604263fd22b382686f0, https://si.imgix.net/7ffdb163/uploads/origins/e91cd265-14b8-4d69-a722-038f748b5e8a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=6d9ebcf53cf31cbfc5115651678b14e8 2x, https://si.imgix.net/7ffdb163/uploads/origins/e91cd265-14b8-4d69-a722-038f748b5e8a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=2728ba799889ce55519e0313ceaa304d 3x"}, "duration": null, "nsfw": true, "hardcore": true, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/7ffdb163/uploads/origins/e91cd265-14b8-4d69-a722-038f748b5e8a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=86de1c5ffa102267e4ada76c959282c0", "srcset": "https://si.imgix.net/7ffdb163/uploads/origins/e91cd265-14b8-4d69-a722-038f748b5e8a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=86de1c5ffa102267e4ada76c959282c0, https://si.imgix.net/7ffdb163/uploads/origins/e91cd265-14b8-4d69-a722-038f748b5e8a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=8ee04b63ad88fd1311843f7baa09abfe 2x, https://si.imgix.net/7ffdb163/uploads/origins/e91cd265-14b8-4d69-a722-038f748b5e8a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=401af1ab099cb3904b4715e0b3921cb2 3x"}, "body": "こんばんは！お疲れ様です！\n\n初手の挨拶の仕方がわからないので用件から失礼します！\n\n【リクエスト内容】\nざっくり言うとうちの子のルナが開発した機械を試しに起動し、適当に召喚した縮小国(50000分の1)を自慰行為を挟みつつ踏み潰していって処分する、という内容です。\n途中途中でおしっこやおならで建物を消しとばすなど、汚い要素があると嬉しいです。(無理そうな場合はなくても大丈夫です！)\n自慰行為は、ビル群に腰を下ろして敏感なクリを擦り付ける、と言った感じで！基本的に股で押し潰して自慰行為をします！\n\n\n国の大きさは元あった惑星の中では一番大きかった、と言う設定で。\n\n出来たら欲しい流れ(描写)\n初めは小人たちに挨拶をしながら国の外周を踏み潰し、逃げ場をなくす描写\n破壊の最後に、国を指の腹に乗るくらいに縮めて一気に股で押し潰し、擦り付けて何度か絶頂する描写(ここで漏らして欲しいです…)\n召喚した分を壊し終えたら、残骸をそのまま元の場所に返し、臭いやら漏らした尿やらでその星が大変なことになるという描写で〆てほしいです。\n\nルナの設定は資料URLというところに！\n体臭設定はどんどん使ってください！\n\n機械のざっくりとした説明\n薄く広い円盤(国が縮小され召喚される場所)と、その脇に操作盤とモニターが付いているだけのシンプルな見た目。操作盤をいじりスイッチを押すと、選択された星の国が縮小され円盤に出現する。(生物もそのまま縮められ連れてこられる。)\n機械に召喚された国が元々あった場所は、円型に切り取られ綺麗になくなっている。\n縮小国を元の場所に戻すこともできるが、円盤上の状態がそのまま拡大されて送られるため、例えば1000分の1の縮小国にリンゴを置いて返すと、元あった場所に元通りに国が戻され、ついでにあった物を押し潰して1000倍の大きさのリンゴが出現すると言うわけです。\n\nhttps://twitter.com/mochimoti_o/status/1407059203022331911?s=21", "nc": 51, "word_count": 3047, "transcoder": "text", "creator_acceptable_same_genre": true}], "similar_creators": [{"id": 31264, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "ゆーだい", "screen_name": "RabbitDrag0n", "avatar_url": "https://pbs.twimg.com/profile_images/1843325872327286784/BE688mT1.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1337995249/1689815284/1500x500", "appeal_receivable": true, "popular_creator_rank": null, "req