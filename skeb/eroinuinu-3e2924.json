C）の「堕落」イラストを依頼したいです。価格は未定ですが調整可能です。SFWとNSFWの両方のバリエーションを希望します。\n私のOCは普通の体型で、黒い粘液の触手に縛られ、包み込まれて犯されている様子を希望します。目尻からは涙が流れているものの、顔には快楽に浸っているような表情を。犯されるシーンについては、ご自由に演出してください！\n堕落後は、OCの体型ががっしりとし、目の色が白から黒に変わり、邪悪で魅惑的な眼差しで舌を出しています。体や口の中からは黒い粘液が滴り落ち、爪で下半身を握りしめ、性器は以前より一回り大きくなり、精液が滴り落ちています。\n以下は私のオリジナルキャラクターの設定リンクです。目の色が白と黒の時の様子が載っています：https://drive.google.com/drive/folders/1LFf7k06KUrHEuiq5O_go2otPzHTDKc1Q", "nc": 57, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@eroinuinu/works/13", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3182367, "client_id": 3167973, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/08e0dd79/uploads/origins/e4fe886e-2e86-46d2-8921-a3e4fce14515?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9ee9f0aacc06728da7b19dd10df07c00", "srcset": "https://si.imgix.net/08e0dd79/uploads/origins/e4fe886e-2e86-46d2-8921-a3e4fce14515?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9ee9f0aacc06728da7b19dd10df07c00, https://si.imgix.net/08e0dd79/uploads/origins/e4fe886e-2e86-46d2-8921-a3e4fce14515?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=70757e5f1d93ec8f56557aa7c08b3bc0 2x, https://si.imgix.net/08e0dd79/uploads/origins/e4fe886e-2e86-46d2-8921-a3e4fce14515?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=806ffe5547ae98eca2aa3fa53b6370bb 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/08e0dd79/uploads/origins/e4fe886e-2e86-46d2-8921-a3e4fce14515?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e1afd1759728ce51f31b2b9517807656", "srcset": "https://si.imgix.net/08e0dd79/uploads/origins/e4fe886e-2e86-46d2-8921-a3e4fce14515?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e1afd1759728ce51f31b2b951780765