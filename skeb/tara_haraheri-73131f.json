f089dd33b3b73b82a39cd12a, https://si.imgix.net/3380051f/uploads/origins/c5cbac3e-9817-4118-a606-9c40dbf0d755?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e1ec98486c7ce9d424f0567a389d82f6 2x, https://si.imgix.net/3380051f/uploads/origins/c5cbac3e-9817-4118-a606-9c40dbf0d755?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c5fff6a328152f6c2fb81e54699ac887 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/3380051f/uploads/origins/c5cbac3e-9817-4118-a606-9c40dbf0d755?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=556524cdc2830672c79c41cf212ab676", "srcset": "https://si.imgix.net/3380051f/uploads/origins/c5cbac3e-9817-4118-a606-9c40dbf0d755?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=556524cdc2830672c79c41cf212ab676, https://si.imgix.net/3380051f/uploads/origins/c5cbac3e-9817-4118-a606-9c40dbf0d755?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=a9d1d0873c03cceef42c81b84bf1c38b 2x, https://si.imgix.net/3380051f/uploads/origins/c5cbac3e-9817-4118-a606-9c40dbf0d755?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=d611337ce0e367563d906c41e6d328ee 3x"}, "body": "たらら様、はじめまして。\nXやpixivでたらら様の百合イラストを\n拝見し、ぜひ描いていただきたく\nリクエスト致します。\n\n特殊性癖を含むイラストになります。\nもし不可であれば早期にキャンセル\nいただけると助かります🙇‍♂️\n\nお願いしたい特殊性癖とは、\n「白粉を使用した白塗り」です。\n\nお願いしたいシチュエーションは\n下記の通りです。\n\n女性が二人、舞妓体験(化粧)をしている\nという場面です。\n\n二人の年代は２０台前半を\n想定しています。\n中肉中背です。\n\n並んで座って、\nそれを正面から見ている構図です。\n\n二人の服は襦袢か浴衣で、\n白粉を塗るために肩をはだけた状態です。\n\n髪の色や長さはお任せしますが、\n頭にはヘアバンドなどをして\n髪の毛が肩に付かない、かつ\nおでこを出した状態です。\n\n一人は化粧がほぼ終わった状態。\n(胸から顔まで白塗り、眉や\n紅を引き終わってある)\n仮にＡさんとします。\n\n一人は白粉のみ塗ってある状態。\n(肩から顔まで真っ白)\n仮にＢさんとします。\n\nＢさんが目をつぶって\n顔をパフで叩かれるのを待っている状況を、\nＡさんが真っ白な顔を面白がって\nちょっと見ている、\nみたいな感じです。\n\n細かい部分になりますが、\n生え際や耳は白くせず\n塗り残しでお願い致します。\n(うなじが入る場合はうなじも)\n\n以上、とてもフェチな\n内容になりますが、ご検討いただけると\n幸いです。\nよろしくお願い致します。", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@tara_haraheri/works/8", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/31b6241c/uploads/origins/116e798d-90d4-48ba-b1fa-e5294ef2fcf3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=05f038c7fc9653a05df5091dbca795f4", "srcset": "https://si.imgix.net/31b6241c/uploads/origins/116e798d-90d4-48ba-b1fa-e5294ef2fcf3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=05f038c7fc9653a05df5091dbca795f4, https://si.imgix.net/31b6241c/uploads/origins/116e798d-90d4-48ba-b1fa-e5294ef2fcf3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=538f8f65046700e41d2b2b8e4135c322 2x, https://si.imgix.net/31b6241c/uploads/origins/116e798d-90d4-48ba-b1fa-e5294ef2fcf3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=ec8bd11b950b0d652e0acede04910d31 3x"}, "private": true, "genre": "art", "tipped": false, "creator_id": 2821585, "nc": 177}, {"path": "/@tara_haraheri/works/7", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/652c9476/uploads/origins/ef435e31-59c8-4d8b-a397-a3f662d0241e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=ca0e11027bd9d760fccf82d3d4057d0f", "srcset": "https://si.imgix.net/652c9476/uploads/origins/ef435e31-59c8-4d8b-a397-a3f662d0241e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtsha