": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@koreoisiii/works/67", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3395148, "client_id": 1879638, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/490b9f9f/uploads/origins/654389ff-2bd5-4010-96f1-199f35e428c9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=562fadcd2db4dda0477fbce8214aea24", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/490b9f9f/uploads/origins/654389ff-2bd5-4010-96f1-199f35e428c9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b2138ee761132e27484ef3bde215cbe8", "src_set": ""}, "body": "⁂ŧ‹”ŧ‹”⁂s様こんにちは！\nアピールありがとうございます！\n是非かわいい冬服姿を描いて頂きたいです！バレンタインモチーフの可愛らしい感じだと嬉しいです！\n\nキャラクターについてです\n身長１５０㎝後半で２０歳くらいの見た目です。\n白いふわふわな髪を猫耳っぽく見えるように巻いており、猫目っぽくみえるメイクをしています。\nおっとりしていて育ちの良さそうな丁寧口調で話します。\n\n詳しい容姿は資料をご参照下さい！https://drive.google.com/drive/folders/1N3E16ACMWqESj__Fo3cob2DN2qcR3wkr?usp=sharing\n\nhttps://drive.google.com/drive/folders/1N3E16ACMWqESj__Fo3cob2DN2qcR3wkr?usp=sharing", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@koreoisiii/works/66", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3395148, "client_id": 2102629, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/993b658e/uploads/origins/0e084f93-2d62-4cb3-86da-e9056d5d863d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=574a1fa189a62239add8df53eee3c0a4", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/993b658e/uploads/origins/0e084f93-2d62-4cb3-86da-e9056d5d863d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=7495862dda3950213c5e82927