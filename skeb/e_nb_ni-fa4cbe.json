時間があれば剣術を極めたりするような真面目な子なのでそこそこ筋肉はあるんじゃないかな…多少割れてはいそうだな…という感じです\n自分が手伝ってどうにかなる程度なら笑って許しますが、どうにもならないやらかしであれば笑いながら「だめですよ」という感じの真面目君です\n何事も楽しんでやる子です。戦う時も、普通のなんて事の無いお仕事も、探索も。\n感情より理論。座右の銘は　The sole meaning of life is to serve humanity.(人生の唯一の意義は、人のために生きることである。)\nINFJ-T。自分の意見より他人の意見が大事だと思う。\n間違えてると思うことは間違えてると言うし、友人が道を間違えているなら正すのが道理。\n\n\nこんな感じです。\nまだまだ暑い日が続いておりますので、くれぐれもご自愛ください。\n依頼の方、ご一考頂けたら幸いです🙇‍♀️これからもぺんぎんさんの活動を応援しております！！", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@ame_m0c1/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2170098, "client_id": 3252335, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/06371dfa/uploads/origins/a5e1e6a3-2b43-43f7-8439-1311b1002b11?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c7a1a4d658cc63606e51c30e7b06e934", "srcset": "https://si.imgix.net/06371dfa/uploads/origins/a5e1e6a3-2b43-43f7-8439-1311b1002b11?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c7a1a4d658cc63606e51c30e7b06e934, https://si.imgix.net/06371dfa/uploads/origins/a5e1e6a3-2b43-43f7-8439-1311b1002b11?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=86405fdd8f36cec4b41db1c5d7ac2e43 2x, https://si.imgix.net/06371dfa/uploads/origins/a5e1e6a3-2b43-43f7-8439-1311b1002b11?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f419a0105b57df3f2ddcfdfc8e370915 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/06371dfa/uploads/origins/a5e1e6a3-2b43-43f7-8439-1311b1002b11?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=55ef36ea7a8401f357826e0179324c73", "srcset": "https://si.imgix.net/06371dfa/uploads/origins/a5e1e6a3-2b43-43f7-8439-1311b1002b11?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=55ef36ea