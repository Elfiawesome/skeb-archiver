m=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=fc0148e56821aa773810d674ed1d011e, https://si.imgix.net/d12569e4/uploads/origins/b6cd52af-2d1a-4f37-b692-7334d4c08149?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=61a8d892bdc5a456a964f1a9050dc147 2x, https://si.imgix.net/d12569e4/uploads/origins/b6cd52af-2d1a-4f37-b692-7334d4c08149?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=ce3627be9e79fc9494fcb7a795fd879b 3x"}, "body": "こんにちは、tanaka先生。\n私はあなたの作品が大好きなので、私のocのイラストを依頼したいと思います。\n彼らは田舎の町で一緒に育った幼馴染です。今ではそれぞれ立派な大人になりました。\n緑色の髪の男性の名前はともや。性格はとても真面目で、クールに見えて実はとても優しい。\n白い髪の女性の名前はせり。賢くてとても元気で、いつも常識を覆すようなことをしている。\n描いてほしいシーン：ともやとせりが「立ち入り禁止」の標識がかかった金網の前に立ち、懐かしさと悲しみに満ちてそこを見つめている。そこは彼らの故郷だった。\n時は夏の夕暮れ。\nここまで読んでいただき、ありがとうございました。\n\nhttps://drive.google.com/drive/folders/1-NIB1c1OIr_cdJflKSvduyUP1yTlceH3", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@tanakaaaa__0123/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2647760, "client_id": 2280850, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/5c308390/uploads/origins/d8d5af9d-a8c0-42e7-8080-f170fff4d3dd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=af1c9d852593af8b38f1be5d47e70476", "srcset": "https://si.imgix.net/5c308390/uploads/origins/d8d5af9d-a8c0-42e7-8080-f170fff4d3dd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=af1c9d852593af8b38f1be5d47e70476, https://si.imgix.net/5c308390/uploads/origins/d8d5af9d-a8c0-42e7-8080-f170fff4d3dd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b24970ba2cac3d4de400f1e3ae472ef7 2x, https://si.imgix.net/5c308390/uploads/origins/d8d5af9d-a8c0-42e7-8080-f170fff4d3dd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=926629417efcf58a5d5ff804fa903e75 3x"}, "duration":