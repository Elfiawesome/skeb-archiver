54-02f2916045d9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b0c94f469b6e57230748652bf1a3f875", "srcset": "https://si.imgix.net/d086e482/uploads/origins/acf1287d-5994-4074-a254-02f2916045d9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b0c94f469b6e57230748652bf1a3f875, https://si.imgix.net/d086e482/uploads/origins/acf1287d-5994-4074-a254-02f2916045d9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=b967aeeb92c6f4518454f3ed55035469 2x, https://si.imgix.net/d086e482/uploads/origins/acf1287d-5994-4074-a254-02f2916045d9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=9405fecd05351dc0c91932dcb4a40283 3x"}, "body": "ヘイヘイです！\n\nまず最初に、私のInstructionを読み、私のリクエストを受け入れてくれて、本当にありがとうございます！\n私はそれを非常に高く評価します <3\n\n私のキャラクターを、他の作品（https://skeb.jp/@new_zaraki510/works/9）で描かれたような方法で描いてほしいです。\n不気味で、とても怖い雰囲気があること。\nその視線で威圧感を与える。\n彼の背後は暗闇で、瞳の一部が視聴者を直接見ているはずです。\n参考資料として、私が送ったドライブの中にその資料も含まれています！\nどの色にするか、どのような効果を持たせるかは、あなたが決めることができます。威圧的であればいい！\n\n本当にありがとうございました！\nドライブに私のOCの情報が全て入っていますね。自分が一番使いやすいものを使ってください\n\nhttps://drive.google.com/drive/folders/1m8kLbU1YbRtsdzgf_rhYGnNdXqUoSgqR?usp=sharing", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@new_zaraki510/works/10", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1195534, "client_id": 1971474, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/cb904d57/uploads/origins/aa6cfcb0-6dde-4f00-aecf-caac8fb0d693?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=037fd232872d9f1b088983598cd14e1e", "srcset": "https://si.imgix.net/cb904d57/uploads/origins/aa6cfcb0-6dde-4f00-aecf-caac8fb0d693?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=037fd232872d9f1b088983598cd14e1e, https://si.imgix.net/cb904d57/uploads/origins/aa6cfcb0-6dde-4f00-aecf-caac8fb0d693?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=4f3f79283b963f129881223048f26588 2x, https://si.imgix.net/cb904d57/uploads/origins/aa6cfcb0-6dde-4f00-aecf-caac8fb0d693?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=fb0f9ddf0c4022e28f04bd6ea3124d7f 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/cb904d57/uploads/origins/aa6cfcb0-6dde-4f00-aecf-caac8fb0d693?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=80a6a9b57fa5a7b4ed4d04f4f1e812b7", "srcset": "https://si.imgix.net/cb904d57/uploads/origins/aa6cfcb0-6dde-4f00-aecf-caac8fb0d693?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=80a6a9b57fa5a7b4ed4d04f4f1e812b7, https://si.imgix.net/cb904d57/uploads/origins/aa6cfcb0-6dde-4f00-aecf-caac8fb0d693?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=57b28b510a46f9903f461811a7d9ce43 2x, https://si.imgix.net/cb904d57/uploads/origins/aa6cfcb0-6dde-4f00-aecf-caac8fb0d693?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=ca6acb84d5fa7cce35fe843e66f33472 3x"}, "body": "初めまして。\nskebの作品群を見ていて切れ長な目と口角の上がった不敵な笑顔がいいなと思いましたのでリクエストさせていただきました。\n\n私の炎の姿を描いていただけないでしょうか。\n描いていただいた作品を配信活動（Youtubeなど）、Twitter投稿に使用させていただきたいと考えています。\n\n共有リンクに記載がありますが石のコアの周りに炎まとっている体になります。\nよろしければ以下構図で描いていただけますと幸いです。\n顔を少し傾けて何かを正面から見下している構図\n片目は細めるようにゆがんだ眼\nもう片方の目はかっぴらいて白目部分が大きくなったような目\n目の瞳孔部分はX字\n手は三つ指\n歯は基本ないギザギザ口\nコア部分の角度などの指定はなく、炎も不定形なので独自解釈していただいてもかまいません。\n人型ではないので少々難しい点もあるかもしれませんが\n楽しんで描いていただけそうであればよろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/1JCh9webnSLpitQL0FPiTWnr1bC-V_AXo?usp=sharing", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@new_zaraki510/works/9", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": fal