ptable_same_genre": false}, {"path": "/@gugsssccc/works/49", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2410085, "client_id": 2686745, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/5581385c/uploads/origins/bd3e7b59-df76-475e-9b1c-6dfde72088f8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=30ac825d9b6552aa9794b5a5e2d9d26d", "srcset": "https://si.imgix.net/5581385c/uploads/origins/bd3e7b59-df76-475e-9b1c-6dfde72088f8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=30ac825d9b6552aa9794b5a5e2d9d26d, https://si.imgix.net/5581385c/uploads/origins/bd3e7b59-df76-475e-9b1c-6dfde72088f8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=5df203ccb5a1c68624443eaea8af1ec3 2x, https://si.imgix.net/5581385c/uploads/origins/bd3e7b59-df76-475e-9b1c-6dfde72088f8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=7ae3b4fe523c6d4f054e5967a1978350 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/5581385c/uploads/origins/bd3e7b59-df76-475e-9b1c-6dfde72088f8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2c885b0ad0e34279b96a71b5be8f88f0", "srcset": "https://si.imgix.net/5581385c/uploads/origins/bd3e7b59-df76-475e-9b1c-6dfde72088f8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2c885b0ad0e34279b96a71b5be8f88f0, https://si.imgix.net/5581385c/uploads/origins/bd3e7b59-df76-475e-9b1c-6dfde72088f8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=33b81b8a19e526fff3efe0f51d75cf9c 2x, https://si.imgix.net/5581385c/uploads/origins/bd3e7b59-df76-475e-9b1c-6dfde72088f8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=8731f6e8c219ad870607398dde3041b9 3x"}, "body": "こんにちは、rukasakiと申します。以前にもskebを依頼し素敵なイラストを描いていただいた者です（本当にありがとうございました！）。今回もやくしじまさんに、私と他3人のOC（許可済み）を描いていただきたく、リクエストをお送りいたしました。\n\nクトゥルフ神話TRPGの『かいぶつたちとマホラカルト』というシナリオで遊ぶ際に作成したキャラクター4人をお願いしたいです。彼らはある犯罪組織のメンバーで、それぞれの特技を生かして依頼をこなしています。\n\n①HO狼：ローエン\nコートとスーツを着た高身長の人物で、組織のリーダー。人当たりの良い印象を受けるが、実際は好奇心旺盛な自由人。\n\n②HO魔女：Hexe（ヘクセ）\n魔女の帽子をかぶった人物で、ハッキング担当。常に無愛想で口が悪く、自己中心的。実は一番の苦労人でもある。\n\n③HO鬼：キリング・バララデイ\nピンク髪の人物で、武闘担当。いつも笑顔で明るく、すぐに暴力で解決しようとする活発さがあるが、シャイな一面もある。\n\n④HO天使：クリオネ\nメイド服を着た小柄な人物で、交渉担当。掃除とかわいいものが好き。思ったことをすぐに口に出すので、毒舌気味である。\n\n用途は個人観賞用です。画像サイズや、イラストのシチュエーション等はお任せしますが、和気あいあいとした雰囲気だとうれしいです（やくしじまさんの表情の描き方が好きが故のリクエストですが、無理に応えなくても構いません）。\n\nご検討のほどよろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/1dapGQR3N7621-IFNZMrM655L7h7tBpin?usp=sharing", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@bakuinu2/works/12", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3574928, "client_id": 2686745, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/80313e8b/uploads/origins/b5fc8bb8-f35b-4f6f-82f1-83444e915805?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5143fd33174cd7413d8fba7bb131be85", "srcset": "https://si.imgix.net/80313e8b/uploads/origins/b5fc8bb8-f35b-4f6f-82f1-83444e915805?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5143fd33174cd7413d8fba7bb131be85, https://si.imgix.net/80313e8b/uploads/origins/b5fc8bb8-f35b-4f6f-82f1-83444e915805?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=bb91621e7789df76780378ef5bbf6d1c 2x, https://si.imgix.net/80313e8b/uploads/origins/b5fc8bb8-f35b-4f6f-82f1-83444e915805?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=750ed16f0a100bedffc616871bd90f38 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/80313e8b/uploads/origins/b5fc8bb8-f35b-4f6f-82f1-83444e915805?bg=%23fff&auto=f