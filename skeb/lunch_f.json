t_amount": 3000}, {"genre": "comic", "default_amount": 3000}, {"genre": "correction", "default_amount": 3000}], "acceptable_only_public": false, "tip_acceptable": true, "yearly_report_client_visible": false, "total_appeals_count": 0, "received_works": [{"path": "/@lunch_f/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2080278, "client_id": 283866, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/2d972983/uploads/origins/2f199079-3b30-45c6-802c-3eac3c42be19?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d2a1a678d639bacd2281a78d3cf66500", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/2d972983/uploads/origins/2f199079-3b30-45c6-802c-3eac3c42be19?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=31831e818551d821d4752d17833573ea", "src_set": ""}, "body": "初めまして！柔らかくデフォルメされた雰囲気のイラストがとっても可愛かったのでぜひご依頼させていただければと思いました！\n\n・「八月のシンデレラナイン」から「高坂椿」をお願いします。\n\n・夏の青空の元、ベランダor屋上で洗濯物を干しているシチュエーションでお願いします。\n・衣装は下記公式HPキャラ紹介デフォルトの夏制服でお願いします。\n・好きなコトが掃除、洗濯なので機嫌の良い感じでお願いします。\n\n・ひまわりをどこかに飾っていてくれるとありがたいです。\n\nキャラクターの画像などです。\nhttps://hachinai.com/character/kosaka\n\nhttps://drive.google.com/drive/folders/1QcvPaI5nU21ZjIpb7BAEfbm8d3XC_KEF?usp=drive_link\n\n(ミリしらで問題ありません)キャラクター背景として\n歴史ある野球部を受け継ぐキャプテンでありエースの責任感と誰より野球に対するストイックさがありつつも、チームメンバーにも\"全力\"を求めてしまい常にピリピリした雰囲気の女の子です。\n\nぜひよろしくお願いします。", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@lunch_f/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2080278, "client_id": 813173, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/5aeac71a/uploads/origins/b7e95a5e-c04a-4a95-954a-0fd0087e3ef0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=558fc1f190d7b1646884ce109ca5a131", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/5aeac71a/uploads/origins/b7e95a5e-c04a-4a95-954a-0fd0087e3ef0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=03196d47caf44a143180bffafcd70cc5", "src_set": ""}, "body": "こんにちは！\n\n以前、オンラインゲーム「マビノギ」のローワンのイラストを拝見しました。私はあなたのイラストがとても気に入りました！あなたのスタイルはとてもキュートでシンプルです。\n私のマビノギのキャラクターをあなたのスタイルで描いてくれたら嬉しいです！\n\n私のキャラクターについて\n- ウサギが大好き。\n- ペットは黒猫。\n- ピンクのアクセサリーが好き。\n- 少し繊細な性格だが、社交的。\n- ごきげんよう！」「がんばります！」が口癖。\n- 16歳くらい\n\nイラストの構図や具体的な内容はお任せします。\n私のキャラクターを受け入れて、楽しんで描いていただけると嬉しいです！\n\nhttps://drive.google.com/drive/folders/1t4veWRtyjumkj13msJ1VEBvdC67lrcTu?usp=sharing", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@lunch_f/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2080278, "client_id": 99226, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/5de84448/uploads/origins/410d8e20-af5e-42f7-9a5c-c1cb1a3e4620?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3e032487ee873c29bcb5340f983b580c", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/5de84448/uploads/origins/410d8e20-af5e-42f7-9a5c-c1cb1a3e4620?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=360aec5c7885c0ffb2697e7c0a54d7db", "src_set": ""}, "body": "いつも素敵なイラスト拝見させていただいております。\nマビノギというゲームに登場するキャラクター「ローワン」をお願いします。資料URLのページトップで大写しになっている銀髪の女の子です。可憐で儚げな印象と裏腹に、口を開けば「人の名前を憶えられない」「布団から出るのが一番つらい」「坂を上がるのが大変なので移動したくない」など言い出す愉快な子です。\nイラストのタッチや構図、画像サイズはお任せします。キャラクターを見て、こういう感じなのかなと思った通りに描いていただいて大丈夫です。\n\nhttps://mabinogi.nexon.co.jp/campaign/beyond02/", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@lunch_f/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2080278, "client_id": 3185441, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/e2666ab6/uploads/origins/d42668eb-5713-46c4-81c5-45e34b91e4ca?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=df9c4d4c3ea944ee1bded00803e8db74", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/e2666ab6/uploads/origins/d42668eb-5713-46c4-81c5-45e34b91e4ca?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=96345f34b9c3bbd8795d0a277be1e994", "src_set": ""}, "body": "風間様初めまして！\nあうると申します！\n\nBlueskyにて、いつもゆる可愛いイラストを拝見し、楽しまさせていただいてます。\n\nぜひその素敵な絵柄で、わたしのイメージキャラクター「あうるちゃん」を描いていただきたくご依頼させていただきました。\n(今アイコンにしている子になります。元の製作者はびんぞこさん(https://skeb.jp/@binzoko_paroma)です)\n\nイラスト作成時の必須条件はありませんが、1枚絵で持っているスマホを手に持ったイラストだと嬉しいです！\n\n以上、何卒よろしくお願いいたします！\n\nhttps://drive.google.com/drive/folders/1-Kjb6Ay2sJOKSLtitU2Cre6UxrmFOibc", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@lunch_f/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2080278, "client_id": 2767686, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/04718442/uploads/origins/6661953c-bd5f-43fe-b52c-18a804e38582?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=df67ffabda670c4a6cf12cfc958b966f", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/04718442/uploads/origins/6661953c-bd5f-43fe-b52c-18a804e38582?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9516edd43c5a5948a578da52884bcfe0", "src_set": ""}, "body": "ネジドングリさんはじめまして！\nSkebお願いできるとのことなのでリクエストお送りさせていただきます！\n\nうちのこ、にゃがいさん（夏服）を描いてほしいです！\nhttps://misskey.io/notes/9ijzit5n1q\nツナ缶が好きな緑髪ツインテの女の子です。姿勢、構図等はおまかせします。\n\nもし可能であれば、「正方形のカンバスで」「pancake stock( https://www.pixiv.net/artworks/40708619 )のようなタッチで」描いていただけると、うれしいです。\n\nいただいたイラストは、SNSで自慢したり、自分用に楽しむ目的で使わせていただきます。\nよろしくお願いします！", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@lunch_f/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2080278, "client_id": 11797, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/48c64ac3/uploads/origins/c1cee464-13e7-4918-a218-30f1e7c3c877?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f7680303e115d32a4112b9a2b9c217c2", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/48c64ac3/uploads/origins/c1cee464-13e7-4918-a218-30f1e7c3c877?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=974d85088d970c79ee386f974240c82f", "src_set": ""}, "body": "風見さんのTwitterやMisskeyなどに投稿されている「水着RABBIT小隊」「水着ウイヒナとハナコハ」「チョコレー党 ノクチル」などのイラストのデザイン・かわいさがとても素敵で、クリアファイルとかトートとかにこのイラストだったら絶対お気に入りとして使ってるだろうなぁなど考えながら見ています。\n\n依頼したいのは、イラストレーターでVTuberの花籠モアさんのイラストです。(花籠モアさんのイラストを依頼することに関して、マシュマロにて大丈夫との許可を取っています)\n花籠さんは睡眠・パンダ・読書・文具などが好きな方で、以下の資料URL先のように複数の衣装があります。\n- https://x.com/moa_hana_v/status/1397115050087776259\n- https://x.com/moa_hana_v/status/1530827270905921536\nこれらの複数の衣装の花籠さんを描いたポストカードサイズの楽しそうなイラストを依頼したいです。\n\nハガキに印刷して自室に飾ったり、自身で利用するトートバッグかポーチなどに印刷したりしたいと思っています。よろしくお願いします。", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "similar_creators": [{"id": 1924139, "creator": true, "nsfw_acceptable": false, "acceptable": false, "name": "青井", "screen_name": "yooo009", "avatar_url": "https://pbs.twimg.com/profile_images/1099591570003615744/2uMvUowI.jpg", "header_url": "https://pbs.twimg.com/profile_banners/769007618111045633/1550998036/1500x500", "appeal_receivable": false, "popular_creator_rank":