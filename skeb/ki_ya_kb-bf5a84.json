ders/1BFjL-4xbw256AD-nEriu_J4_cTcBEhhX?usp=sharing\n\n※Googleドライブ内にある〈 参考資料【2】 〉は今回ご依頼しているキャラとは異なるものになります。構図の参考に、と思い入れさせていただきました。\n\n\n【　キャラクターについて　】\n名前：アイ\n好きな食べ物は魚(鮭)、身長130cm、体重は機械の影響もあり、70kg。感受性が豊かで表情がころころと変わる。悲しいときは耳が垂れ、うれしいときは尻尾を振る。\n\n\n【　使用用途について　】\n使用用途は個人での使用で、主にKPをする際のアイコンとして使用させていただきたいと思っております。\n\n\n日頃お世話になっているため、お任せよりも高い値段で設定させていただきましたが、特段無理などはせずとも大丈夫です。\nお忙しいところだとは思いますので無理せずにスケブの規約通りスルーしていただければと思います！", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@ki_ya_kb/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 986753, "client_id": 720032, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/fe4062cc/uploads/origins/179c2b31-9023-4dad-acf0-5138260838b5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f4699d5050c6e053a9797b431e092257", "srcset": "https://si.imgix.net/fe4062cc/uploads/origins/179c2b31-9023-4dad-acf0-5138260838b5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f4699d5050c6e053a9797b431e092257, https://si.imgix.net/fe4062cc/uploads/origins/179c2b31-9023-4dad-acf0-5138260838b5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=8a84787d3b2aa4ec7ee178cf8946208c 2x, https://si.imgix.net/fe4062cc/uploads/origins/179c2b31-9023-4dad-acf0-5138260838b5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=4b87586ae4a945e8a41503e032262fdc 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/fe4062cc/uploads/origins/179c2b31-9023-4dad-acf0-5138260838b5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=da4644ef616f0031c244951a030e065b", "srcset": "https://si.imgix.net/fe4062cc/uploads/origins/179c2b31-9023-4dad-acf0-5138260838b5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=da4644ef616f003