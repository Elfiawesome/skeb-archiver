dcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/7e9338d5/uploads/origins/b5cfaa35-0520-471b-a3d5-98b0b1ac1f11?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=7ecd085dca9f71c8f55b4e3dc714028c", "srcset": "https://si.imgix.net/7e9338d5/uploads/origins/b5cfaa35-0520-471b-a3d5-98b0b1ac1f11?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=7ecd085dca9f71c8f55b4e3dc714028c, https://si.imgix.net/7e9338d5/uploads/origins/b5cfaa35-0520-471b-a3d5-98b0b1ac1f11?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=b3373865011e62a545d23a7048807177 2x, https://si.imgix.net/7e9338d5/uploads/origins/b5cfaa35-0520-471b-a3d5-98b0b1ac1f11?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=37c5978da8104ab032d48534259c7c98 3x"}, "body": "にたまご様\n\n以前イブキちゃんのイラストをお願いした者です。その節はたいへん可愛くえっちなイラストをありがとうございました。\n\n今回のリクエストですが、先日アップされていたメスガキマイクロビキニボリスちゃんが公務執行妨害されちゃうシーンを是非見てみたいです。\n\n流れとしてはイブキちゃんの時と同じような感じで大丈夫ですが、たくさんの差分が大変でしたら最低限「中出しされるシーン(あれば断面図)」「事後の溢れシーン(くぱぁする/される/くぱぁなし溢れのみ、はお任せします)」「受精シーン(激しく突き刺さる感じで)」があると嬉しいです。\n\n※個人的にはイブキちゃんの時のような差分マシマシは本当に嬉しいです。でも大変だと思うのでご無理はなさらないで下さい\n\nあの子の設定などはにたまご様の準拠で構いません、\n処女or非処女、わからせorわからせられるなど気になるところがいっぱいあるので、どんなお話になるのか楽しみです。\n\nまた、納品形式に関してですがpsdで予めレイヤー分けされて作業されている場合、修正箇所のみ結合頂き他は分割されたままの1つのpsdまたはclip形式ファイルで大丈夫です。\n\n(前回納品時、差分一枚ごとに結合された単独のpsdファイルで、お手間をおかけしたと思いますので)\n\nご検討宜しくお願いします。", "nc": 184, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@nitamago/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1607983, "client_id": 2927352, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/fd9907e1/uploads/origins/15a768b9-da14-4301-a93d-77d519bbd887?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f1888edd56c21523b734e87c2a2636c6", "srcset": "https://si.imgix.net/fd9907e1/uploads/origins/15a768b9-da14-4301-a93d-77d519bbd887?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f1888edd56c21523b734e87c2a2636c6, https://si.imgix.net/fd9907e1/uploads/origins/15a768b9-da14-4301-a93d-77d519bbd887?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=aecd8bcc7ed21137120894b52f19e26e 2x, https://si.imgix.net/fd9907e1/uploads/origins/15a768b9-da14-4301-a93d-77d519bbd887?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=3dfa0d979370671f5fb8da9bbdeec699 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/fd9907e1/uploads/origins/15a768b9-da14-4301-a93d-77d519bbd887?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a9c6e0d5455ee4db013257e910f0a848", "srcset": "https://si.imgix.net/fd9907e1/uploads/origins/15a768b9-da14-4301-a93d-77d519bbd887?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a9c6e0d5455ee4db013257e910f0a848, https://si.imgix.net/fd9907e1/uploads/origins/15a768b9-da14-4301-a93d-77d519bbd887?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=07457c0780dfd76e72b5558a29f2ae19 2x, https://si.imgix.net/fd9907e1/uploads/origins/15a768b9-da14-4301-a93d-77d519bbd887?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=9e3336932bb229e3bac0e0c6afceed83 3x"}, "body": "えっちイラストの依頼です\n自キャラのマリィちゃんhttps://misskey.io/notes/9z90013zzgfb08ca\n永久嶺ちゃんhttps://misskey.io/notes/a6lysacp66zk0e7r\nのイラストを描いていただきたいです！\n\nシチュはhttps://misskey.io/notes/abuoakx9ib9p07w7　の後\n遊び疲れて2人共裸で汗だく　おまた開いて寝てる感じで\n\nマリィちゃんは淫紋あって\n永久嶺ちゃんは淫紋無い感じでお願いします\n角度的に見えないなら見えなくて大丈夫です\n\n①2人とも愛液垂れてるパターン\nと\n②マリィちゃん設定画の淫液(ピンクの液体)が永久嶺ちゃんのおまたから垂れてる\nパターンの差分が欲しいです\n\n後は親御さんにオリジナルファイルを共有させてもらいたいです\n以上の内容でご検討よろしくお願いいたします", "nc": 56, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@nitamago/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1607983, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/5dc7c6fd/uploads/origins/7d4a5132-671b-48cd-8299-8dd49d72ee4e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=70b156fb94f2bfda0c2ace23a9ec2622", "srcset": "https://si.imgix.net/5dc7c6fd/uploads/origins/7d4a5132-671b-48cd-8299-8dd49d72ee4e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=70b156fb94f2bfda0c2ace23a9ec2622, https://si.imgix.net/5dc7c6fd/uploads/origins/7d4a5132-671b-48cd-8299-8dd49d72ee4e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=0d7d1a823ea468be31907b71f15c7986 2x, https://si.imgix.net/5dc7c6fd/uploads/origins/7d4a5132-671b-48cd-8299-8dd49d72ee4e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=aa9a542757bfff9492e2216721de8c46 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/5dc7c6fd/uploads/origins/7d4a5132-671b-48cd-8299-8dd49d72ee4e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b3e814bcf0a2e6f98db483091efb862f", "srcset": "https://si.imgix.net/5dc7c6fd/uploads/origins/7d4a5132-671b-48cd-8299-8dd49d72ee4e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b3e814bcf0a2e6f98db483091efb862f, https://si.imgix.net/5dc7c6fd/uploads/origins/7d4a5132-671b-48cd-8299-8dd49d72ee4e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=0bbdceb475241cf4bf9de25e4019f855 2x, https://si.imgix.net/5dc7c6fd/uploads/origins/7d4a5132-671b-48cd-8299-8dd49d72ee4e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=55c8494f45a33a65f4cc6ce82620c38f 3x"}, "body": "はじめまして。最近煮たまごさんの事を知り、表現が好きなので依頼をしたいと思いました。\n\nブルアカのアインちゃんのイラストの受精シーンが特に好きなのですが、ほぼ同じようなシチュエーションでイブキちゃんのイラストをお願いしたいです。\n\n概要ここから〜\n初めての先生とのえっちで中出しされ、脚を拡げた状態で両指で直接あそこをくぱぁ(これは自分で拡げていても、先生が拡げるのでもどちらでも良いです。自然に見える方をお願いします。)すると、膜が破れぽっかり穴の空いたあそこが真っ白に染まっていて、中に出された精液とイブキちゃんの初めての証が混ざってピンク色になった濃厚な液体が最初は少しずつ、やがて卑猥な音を立て泡立ちながら大量に溢れ、シーツに紅白の溜まりができる。\nその時イブキちゃんのお腹の中では、まだ幼い卵子が蹂躙されるかの様に大量の精子に取り囲まれ、やがて一匹が音を立てて突き刺さり、ひとつになって新たな生命が誕生する…\n〜概要ここまで\n\nあくまでもイメージなので、枚数は一枚でも、複数に渡ってもどちらでも構いません。またもしも可能であれば、挿入前の膜(ヒダでも可)ありくぱぁの状態や挿入の瞬間、中に出される瞬間や大きくなったお腹の差分(断面図があると凄く嬉しい)などもあると凄く嬉しいですが、あくまでも金額に見合う内容で大丈夫です。\n\n表情は先生と結ばれて幸せそう(ただし挿入の時は痛そう)なのをお願いします。\n\nご検討よろしくお願いします。\n\nhttps://www.pixiv.net/artworks/118103749#manga", "nc": 168, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@nitamago/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1607983, "client_id": 48410, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/4150f5d3/uploads/origins/b09b34f0-a260-47e8-9fbb-0c3c9f70a0cb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=475718ecdd0275a2ebfaf2579b71ebf5", "srcset": "https://si.imgix.net/4150f5d3/uploads/origins/b09b34f0-a260-47e8-9fbb-0c3c9f70a0cb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=475718ecdd0275a2ebfaf2579b71ebf5, https://si.imgix.net/4150f5d3/uploads/origins/b09b34f0-a260-47e8-9fbb-0c3c9f70a0cb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b2819a54d8be78cd3865d62ee239301d 2x, https://si.imgix.net/4150f5d3/uploads/origins/b09b34f0-a260-47e8-9fbb-0c3c9f70a0cb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=8dc09aead05b3c817a24d1ccb7267f08 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/4150f5d3/uploads/origins/b09b34f0-a260-47e8-9fbb-0c3c9f70a0cb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9fe5b3a2a29564b87cd4aaa32cefb6ae", "srcset":