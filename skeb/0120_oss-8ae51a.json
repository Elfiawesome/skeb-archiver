ちもですが、ポップコーンとビントロングの絵が本当に可愛くて生き生きしていて素敵です！ \n実家の猫がサビなのですが、サビはイラストやグッズが少なく、好きな作家さんに描いていただけるなんて願ってもいないチャンスで、ぜひお願いしたいと思いました。 \n納期は急ぎません。何卒よろしくお願いいたします。", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 1033323, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "昂久 稜/TakahisaRyo", "screen_name": "Berrydoggo", "avatar_url": "https://pbs.twimg.com/profile_images/2025529839005155328/TWmnqjLk.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1249325082062667776/1709125508/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "art"}, {"genre": "correction"}], "banned": false, "nc": 129}, {"id": 2246170, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "️ ️️ ️", "screen_name": "aokok_zzZ", "avatar_url": "https://pbs.twimg.com/profile_images/1759903083642175488/aHrMzJZI.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1488394002479345664/1644236373/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "art"}], "banned": false, "nc": 17}, {"id": 2641322, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "ぴたや", "screen_name": "pitayadesu", "avatar_url": "https://proxy.misskeyusercontent.jp/avatar.webp?url=https%3A%2F%2Fmedia.misskeyusercontent.jp%2Fio%2Fa3ae685d-ba67-488e-9e58-781f00aae22d.gif&avatar=1", "header_url": "https://media.misskeyusercontent.jp/io/be0921bb-bd81-4f76-b239-302242c2417f.png", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank"