6f8ba-d601-425c-ae4c-3cf041622c47?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=3d920ced8ef5824c9c1ba0df5413e88f 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/736f148d/uploads/origins/5716f8ba-d601-425c-ae4c-3cf041622c47?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6aa239e64efae4a8df5f47dc900aad07", "srcset": "https://si.imgix.net/736f148d/uploads/origins/5716f8ba-d601-425c-ae4c-3cf041622c47?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6aa239e64efae4a8df5f47dc900aad07, https://si.imgix.net/736f148d/uploads/origins/5716f8ba-d601-425c-ae4c-3cf041622c47?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=623fd93d716ba318ea84226246a7ad59 2x, https://si.imgix.net/736f148d/uploads/origins/5716f8ba-d601-425c-ae4c-3cf041622c47?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=5da8bfc4d4409c8a9bab5f91b29f2464 3x"}, "body": "はじめまして。\n飼っているペットの似顔絵を描いていただきたく依頼しました。\n\n飼い猫が２匹、サビ柄のサビ子、白黒の伍長です。\nサビ子はサビ柄のくせにお腹にちょっとだけ白い部分があったり、向かって右側のおヒゲに白いヒゲが数本あったりとかわいいやつです。\n\n先住猫の伍長はタヌキのような感じで、ちょっとだけ足が短いです。お座りしたときにシュッとしたシルエットにならず、ちょっと猫背。のらくろ軍曹という作品の犬に模様が似ていることから紆余曲折ありこの名前になりました。\n\n詳細な資料などは、猫の写真をアップしているアカウントがあるので、そちらからご確認いただければと思います。\n\n外には出さずに育てているので、りょうさんのイラストの中だけでも自然のなかでのびのびしている姿を見せていただければ嬉しいです。（背景ガッツリじゃなくてももちろん大丈夫です…！）\n\nご検討のほどよろしくお願いいたします。\n\nhttps://x.com/5000000000000ch", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@0120_oss/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 4084350, "client_id": 4090053, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/da0b883a/uploads/origins/10c4b2e1-96ec-4a28-aded-b4762a949020?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9f8a58eaf354b