が、簡易的な背景や、キラキラとした華やかなエフェクトがあると嬉しいです…！\n\n- Vtuber有明めありについて - \n・ピンクベージュの巻髪、赤紫色の瞳 \n・モノクル、ツリ目、下睫毛、ωっぽい口、右の八重歯がチャームポイント \n・セクシーなお姉さん風の見た目 ・活発で元気、ダジャレが好きな明るい性格\n\n衣装とキャラの見た目は、下記リンク内の資料を参考にしてください。\n\n難しいようであればキャンセルしてください。\n何卒よろしくお願いいたします…！\n\nhttps://drive.google.com/drive/folders/1-oKb_utKK8qBs8OvmSrZhnA9M6BDrXkb?usp=sharing", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@nyamo_Lv1/works/2", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/67239b4f/uploads/origins/0029209c-d04a-497e-821b-d55f49dd8d78?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=ff9f731ceb32cdf3ad1b33685bbe8268", "srcset": "https://si.imgix.net/67239b4f/uploads/origins/0029209c-d04a-497e-821b-d55f49dd8d78?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=ff9f731ceb32cdf3ad1b33685bbe8268, https://si.imgix.net/67239b4f/uploads/origins/0029209c-d04a-497e-821b-d55f49dd8d78?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=3cc864bf929f0d13c477558f9624f87e 2x, https://si.imgix.net/67239b4f/uploads/origins/0029209c-d04a-497e-821b-d55f49dd8d78?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=ee41eea5f3d3508b93c83f276df87001 3x"}, "private": true, "genre": "art", "tipped": true, "creator_id": 2554658, "client_id": 2670326, "nc": 129}, {"path": "/@nyamo_Lv1/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2554658, "client_id": 1781572, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/e33