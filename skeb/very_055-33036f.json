ろしくお願いいたします。\n\n\n■ビジュアル資料\nhttps://drive.google.com/drive/folders/1tQj1GScMTF34xdCA7ABjGE1SrbksODfi", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@very_055/works/15", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3599737, "client_id": 3886082, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/5a875e6e/uploads/origins/dcb633d5-2300-4429-bda3-799ab516f53f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d1a455acd9e994552cbdcbe73d4d49c8", "srcset": "https://si.imgix.net/5a875e6e/uploads/origins/dcb633d5-2300-4429-bda3-799ab516f53f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d1a455acd9e994552cbdcbe73d4d49c8, https://si.imgix.net/5a875e6e/uploads/origins/dcb633d5-2300-4429-bda3-799ab516f53f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=bbe2a8324117ee9281f6ff9dd677e607 2x, https://si.imgix.net/5a875e6e/uploads/origins/dcb633d5-2300-4429-bda3-799ab516f53f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b33dc036fe3ed07c567e72be95ef5d49 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/5a875e6e/uploads/origins/dcb633d5-2300-4429-bda3-799ab516f53f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=13fb67d2a3645a50fe93b700b24755f6", "srcset": "https://si.imgix.net/5a875e6e/uploads/origins/dcb633d5-2300-4429-bda3-799ab516f53f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=13fb67d2a3645a50fe93b700b24755f6, https://si.imgix.net/5a875e6e/uploads/origins/dcb633d5-2300-4429-bda3-799ab516f53f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=8937d7781a9c4cb93d05fc65fe10072a 2x, https://si.imgix.net/5a875e6e/uploads/origins/dcb633d5-2300-4429-bda3-799ab516f53f?bg=