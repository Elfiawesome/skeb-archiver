rigins/b8588f72-c013-47aa-9ba7-34352a74c341?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=2a73005c3b7062e23a6d005ffe1b30df 2x, https://si.imgix.net/381bf814/uploads/origins/b8588f72-c013-47aa-9ba7-34352a74c341?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f3c9b6a3768b438bcb27f0e14e92487d 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/381bf814/uploads/origins/b8588f72-c013-47aa-9ba7-34352a74c341?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=08e9f92388aac6c7b55806d5d655640e", "srcset": "https://si.imgix.net/381bf814/uploads/origins/b8588f72-c013-47aa-9ba7-34352a74c341?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=08e9f92388aac6c7b55806d5d655640e, https://si.imgix.net/381bf814/uploads/origins/b8588f72-c013-47aa-9ba7-34352a74c341?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=de07a3972a9ad6239d6c4fb4ffe20d02 2x, https://si.imgix.net/381bf814/uploads/origins/b8588f72-c013-47aa-9ba7-34352a74c341?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=c8d2b564890d563b7bee2a158d4af662 3x"}, "body": "さくま様\n\nはじめまして。個人でVtuber活動をしておりますねむりむみと申します。\nTwitterにてさくま様の作品を拝見しており、描かれる女の子のイラストがとても好みで、いつかご依頼できるようになりましたら絶対にお願いしたいなと思っておりました…！\nSkebの依頼を開始されるとのことでしたので、わたし自身を描いていただきたいなと思いリクエスト送信させていただきます。\n\n■使用用途\n・TwitchやX(旧Twitter)等SNSでの使用\n・ネットプリントでの使用\n・自分用のグッズ化（販売はいたしません）\n等、Vtuber活動内で使用させていただきたいです。\n◇利用不可な用途がございましたら納品いただく際に別レイヤーにて記載いただけますと幸いです。\n◇場合によってトリミング等の加工をさせていただく場合がございます。\n\n■イラストの内容\n・X（旧Twitter）にて投稿されていたこちらの作品（https://twitter.com/S5Fz9/status/1764193794793365903/photo/1）がとてもかわいらしいなと思ったので、可能であればメイド服を着せていただきたいです。\n・髪型はおまかせいたします（参考資料内の髪型にしていただいても、描きやすい髪型で描いていただいても問題ございません）\n・髪の毛や頭は見切れないように描いていただけますとうれしいです。\n・構図や表情はおまかせいたします。腰上が入る形であれば、全身であってもそうでなくてもかまいません。\n・目の色は、ベースの色は同じですが、左右で目の下の部分がピンクとブルーで異なります（三面図参照いただければと存じます）\n\n■納品形式について\n・PSDファイルでの納品、もしくはPNGファイルで背景や文字と分けたイラストのみのデータもいただけますと大変助かります…！\n\n■参考資料\nhttps://drive.google.com/drive/u/2/folders/1xBk-nwdcolIO-MQazfE7Gw5APQXv7PIF\n\n要望が多くなってしまい申し訳ございません。\nご検討いただけますと幸いです。", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@S5Fz9/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3139222, "client_id": 808799, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/bd984bbc/uploads/origins/4f43d8d9-0df9-4792-be76-19ee20ac0d5a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=45c1a02485c6dcf1c861952e37a62c34", "srcset": "https://si.imgix.net/bd984bbc/uploads/origins/4f43d8d9-0df9-4792-be76-19ee20ac0d5a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=45c1a02485c6dcf1c861952e37a62c34, https://si.imgix.net/bd984bbc/uploads/origins/4f43d8d9-0df9-4792-be76-19ee20ac0d5a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a35479a0819d33dbf6f898c63f2200a3 2x, https://si.imgix.net/bd984bbc/uploads/origins/4f43d8d9-0df9-4792-be76-19ee20ac0d5a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=cb97b06201d8fa067fd2a1aef8b99ea8 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/bd984bbc/uploads/origins/4f43d8d9-0df9-4792-be76-19ee20ac0d5a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=70767a80ffbad6f9b41504245e795025", "srcset": "https://si.imgix.net/bd984bbc/uploads/origins/4f43d8d9-0df9-4792-be76-19ee20ac0d5a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=70767a80ffbad6f9b41504245e795025, https://si.imgix.net/bd984bbc/uploads/origins/4f43d8d9-0df9-4792-be76-19ee20ac0d5a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=4121f3039