URLは「衣装ネタなど」のボディコンを参照してください。\n色は赤や紫っぽいの希望ですがお任せします。\n\nハートのチョーカーとイヤリングも希望です。\nハートの中に「７」と入っているタトゥーも希望（バカ息子のお嫁さん７号の証）\n\n上記タトゥー含め、その他加えたい堕ち要素があれば差分分けをお願いします。\n\n\n以上要望が多くなってしまいましたが\nまたうちの子を描いて頂けませんでしょうか\n何卒よろしくお願いいたします。", "nc": 48, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@mahit0/works/11", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 123287, "client_id": 1027591, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/9563dcfd/uploads/origins/07615371-b416-4f25-970a-d44c7c5982b6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=09562cc6c8ca241ef4955e9fec292bd7", "srcset": "https://si.imgix.net/9563dcfd/uploads/origins/07615371-b416-4f25-970a-d44c7c5982b6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=09562cc6c8ca241ef4955e9fec292bd7, https://si.imgix.net/9563dcfd/uploads/origins/07615371-b416-4f25-970a-d44c7c5982b6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=2de18ab868b5e50c7d08c133cbaf496e 2x, https://si.imgix.net/9563dcfd/uploads/origins/07615371-b416-4f25-970a-d44c7c5982b6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=dbd9a649c05538a4421b4c861686f187 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/9563dcfd/uploads/origins/07615371-b416-4f25-970a-d44c7c5982b6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a26ce4bee71abdf1e0927b84cf266b30", "srcset": "https://si.imgix.net/9563dcfd/uploads/origins/07615371-b416-4f25-970a-d44c7c5982b6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a26ce4bee71abdf1e0927b84cf266b30, https://si.imgix.net/9563dcfd/uploads/origins/07615371-b416-4f25-970a-d44c7c5982b6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=c12b46bd67