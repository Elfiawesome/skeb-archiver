\n動きのイメージ:\n髪の先と衣服が微かに揺れる\n\n構図:\nお任せいたします。\n\n使用用途:\n 個人的な鑑賞目的です。\n魔裁 束 様のお名前とskebリンクと共に、「描いていただきました！」とTwitterにアップしたいと思っております。\n\nファイル形式:\n ムービーは初めてのリクエストのため、魔裁 束 様が納品しやすい形式でお願いいたします。\n\nご縁がありますように。\nどうぞよろしくお願いいたします。", "nc": 145, "word_count": 0, "transcoder": "video", "creator_acceptable_same_genre": true}, {"path": "/@GAMIiiiiaaaaaA/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 561791, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/631c562e/uploads/origins/42ecc76c-5ad1-4596-9fa7-799acd969d7f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=17f9dc6bed0f1e8f5a07dbd551410d80", "srcset": "https://si.imgix.net/631c562e/uploads/origins/42ecc76c-5ad1-4596-9fa7-799acd969d7f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=17f9dc6bed0f1e8f5a07dbd551410d80, https://si.imgix.net/631c562e/uploads/origins/42ecc76c-5ad1-4596-9fa7-799acd969d7f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=71ffb3c8c9f91d37ff713abce416eafa 2x, https://si.imgix.net/631c562e/uploads/origins/42ecc76c-5ad1-4596-9fa7-799acd969d7f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=6f9168d0107313def6c0eee676571015 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/631c562e/uploads/origins/42ecc76c-5ad1-4596-9fa7-799acd969d7f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e0ebc915f7a4b784ae07b5fe543f4c49", "srcset": "https://si.imgix.net/631c562e/uploads/origins/42ecc76c-5ad1-4596-9fa7-799acd969d7f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e0ebc915f7a4b784ae07b5fe543f4c49, https://si.imgix.net/631c562e/uploads/origins/42ecc76c-5ad1-4596-9fa7-799acd969d7f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=f1a1028f3ef9bca968099543