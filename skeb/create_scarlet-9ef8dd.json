0a/uploads/origins/5e16432c-418e-458a-9eb9-0b53365d3104?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=4ab5e8cf9eebded02b98e6f67bad71db, https://si.imgix.net/bf52970a/uploads/origins/5e16432c-418e-458a-9eb9-0b53365d3104?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=ae0c689c7dfb9efb383a9edf3ca42bdd 2x, https://si.imgix.net/bf52970a/uploads/origins/5e16432c-418e-458a-9eb9-0b53365d3104?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=a85ce6d8eed4119be9905bd2ecfb0677 3x"}, "body": "リクエスト失礼致します。\nこの度はクトゥルフ神話TRPGシナリオ『DOGMA』HO2-遺恨の復讐者-である探索者の戦闘差分をご依頼させていただきたくご連絡させていただきました。\n\nご検討頂けますと幸いです。\nこの度はよろしくお願いいたします。", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@create_scarlet/works/13", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3373621, "client_id": 3431878, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/05210ec3/uploads/origins/0caee2df-4530-4eac-8307-8f5e7c6cdcc2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1383e76ebaa69e5d7faacadb6a4b968c", "srcset": "https://si.imgix.net/05210ec3/uploads/origins/0caee2df-4530-4eac-8307-8f5e7c6cdcc2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1383e76ebaa69e5d7faacadb6a4b968c, https://si.imgix.net/05210ec3/uploads/origins/0caee2df-4530-4eac-8307-8f5e7c6cdcc2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=5306039ac821852964f4f35003371dba 2x, https://si.imgix.net/05210ec3/uploads/origins/0caee2df-4530-4eac-8307-8f5e7c6cdcc2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=4824ce1fdf831f991e0c96c188adf203 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/05210ec3/uploads/origins/0caee2df-4530-4eac-8307-8f5e7c6cdcc2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=de1c218c0a6fa6948882602a1f92131d", "srcset": "https://si.imgix.net/05210ec3/uploads/origins/0caee2df-4530-4eac-8307-8f5e7c6cdcc2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=de1c218c0a6fa6948882602a1f92131d, https://si.imgix.net/05210ec3/uploads/origins/0caee2df-4530-4eac-8307-8f5e7c6cdcc2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=dfd84bc3e43e86eb4a1ed7dd4472d88b 2x, https://si.imgix.net/05210ec3/uploads/origins/0caee2df-4530-4eac-8307-8f5e7c6cdcc2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=a65b12a1584f2b445a09ddfc740073bd 3x"}, "body": "この度はTRPG用にの立ち絵イラストをご依頼したく、ご連絡いたしました。\n\nぜひ深紅様の絵柄で、下記のキャラクターの立ち絵を描いていただきたく、ご連絡いたしました。 \n\n【依頼内容】\n\n■種類\n・通常立ち絵\n・戦闘差分立ち絵\n計2枚＋差分計6枚\n\n■使用用途\n・TRPG立ち絵、いあきゃら資料\n\n完成したイラストは個人利用の範囲でアクリルスタンドを2個程度制作したいと考えています（販売・配布は一切ありません）が実際に作成するかは未定です....\n\n■詳細\n①通常立ち絵_構図指定なし\n\n②戦闘差分_銃を構えている等\n※何か武器を構える場合は左手（義手側）を使用\n\n■表情差分\n【通常立ち絵】（イメージ画像をご参照ください）\n①通常\n②笑顔／成功\n③およよ／失敗\n\n【戦闘差分】\n①通常　　　　ベースは通常立ち絵参照\n②ダメージ　　別途資料あり\n③絶望／致命的なダメージ　お任せします\n\n【基本データ】\n■名前：華葱 カナメ／ハナキ カナメ\n■性別：男性\n■年齢：24歳\n■身長：175cm\n\n■体格\n細身。あまり筋肉はありません。\nそこまでこだわりは無いため深紅様の普段の描き方にお任せします。\n\nお顔の印象は、どこかあどけなさの残る好青年という印象です。\n（詳細は下部とイメージ画像参照）\n\n■髪型：画像参照\n（メカクレまでは行きませんが、右目に前髪が少しかかるくらい）\n\n■髪色：黒（襟足は白系）\n\n■目の色：赤\n目は基本死んでいます\n\n【服装等】\n■服装全体のイメージ\n少し軍服らしさがあると嬉しいです。\n\n■服の色：黒赤ベース\n\n■服装（上）\n黒いインナー／白いマントかアウターに腕を通さず羽織っている\n\n■服装（下）：お任せ\n■服装（靴）：お任せ\n■服装（他）：手袋をしている\n\n■その他：左手のみ義手。\n事故に遭ったため、手首〜指先まで全て義手です。普段は右利きですが、戦闘時のみ左手で拳銃を構える傾向があります。\n本人なりの殺人に対する細やかな抵抗です。\n\n■アクセサリー：ピアス\n　両耳2個ずつ程度。\n\n揺れないものであればデザイン不問です。\n個数についてもバランスを見て変更していただいて構いません。\n\n◽️資料\n華葱 カナメ(はなき カナメ) - いあきゃら\nhttps://iachara.com/view/12626273\n\n上記を参考に、深紅様の描かれる立ち絵を楽しみにしております。\nよろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/1HGGSaiMUPozaNpOGEjEspS8FmULFph8o", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@create_scarlet/works/12", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3373621, "client_id": 1518409, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/ddd0c732/uploads/origins/fb34b204-e6e0-4333-a187-e44834485dbd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a3906f45c1a4bf65c66a0626e6159680", "srcset": "https://si.imgix.net/ddd0c732/uploads/origins/fb34b204-e6e0-4333-a187-e44834485dbd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a3906f45c1a4bf65c66a0626e6159680, https://si.imgix.net/ddd0c732/uploads/origins/fb34b204-e6e0-4333-a187-e44834485dbd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ca438cfcaf7ada488ad420c6d57b518a 2x, https://si.imgix.net/ddd0c732/uploads/origins/fb34b204-e6e0-4333-a187-e44834485dbd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c89835bec9501257e7e39be41bc4d0df 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/ddd0c732/uploads/origins/fb34b204-e6e0-4333-a187-e44834485dbd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c5a158d2e2ac599a3ab43e82488f4aeb", "srcset": "https://si.imgix.net/ddd0c732/uploads/origins/fb34b204-e6e0-4333-a187-e44834485dbd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c5a158d2e2ac599a3ab43e82488f4aeb, https://si.imgix.net/ddd0c732/uploads/origins/fb34b204-e6e0-4333-a187-e44834485dbd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=797c77cc11cf2f2e74a9878a3de4e8ec 2x, https://si.imgix.net/ddd0c732/uploads/origins/fb34b204-e6e0-4333-a187-e44834485dbd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=b430024a9ca97c7bdf3d425ed4ce5b0b 3x"}, "body": "キャラの立ち絵をお願いしたいです！\n\n❍名前│芥川飛羽（あくたがわ　とわ）\n❍年齢│見た目20代後半－30代\n❍身長│182\n❍イメージカラー│ヴァティカーノ#452157\n❍髪型│やや長めの前髪。後ろは高いポニテにしている（胸まで伸びてる）\n❍髪色│黒色\n❍目の形│吊り目、目の下に隈。\n❍目の色│紫色\n❍瞳孔の形│縦瞳孔、ハイライトなし\n❍肌の色│白よりの肌色\n❍表情│飄々とした微笑み\n❍服:\n灰色の長袖シャツに黒色のロングコート\n黒のズボン\n❍靴:\n黒の革靴\n❍アクセサリー:\nイアリング（左耳のみ、銀色）\n手袋（両手）\n革カバー手帳（手に持っている）\n\nキャラ詳細：\n職業：画家\n目が常にハイライトがないけど根っこは愉快（自称）な男。\nしょうもない話を振ってきたり、皮肉や自傷気味の冗談もたまに言う、雑な敬語を使っている、見た目に反してテンションが常に「ハイ」の人。\nしかし独自の価値観を持ち、芯が強い面もある。\n\nモチーフ作品：『翼』ー李箱", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@create_scarlet/works/11", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3373621, "client_id": 1694272, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/b6f8a171/uploads/origins/8a9ac418-341f-48e0-accf-8aab39f9c7cd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fca272e75eeb6eccc5bb8f1393f43240", "srcset": "https://si.imgix.net/b6f8a171/uploads/origins/8a9ac418-341f-48e0-accf-8aab39f9c7cd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fca272e75eeb6eccc5bb8f1393f43240, https://si.imgix.net/b6f8a171/uploads/origins/8a9ac418-341f-48e0-accf-8aab39f9c7cd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ee9d91eea7798e18d1753bae1a56631e 2x, https://si.imgix.net/b6f8a171/uploads/origins/8a9ac418-341f-48e0-accf-8aab39f9c7cd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=0a4b7408991a6ae30e7bf46235be9da5 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/b6f8a171/uploads/origins/8a9ac418-341f-48e0-accf-8aab39f9c7cd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=941db8022930ad5639861d3a9da655f1", "srcset": "https://si.imgix.net/b6f8a171/uploads/origins/8a9ac418-341f-48e0-accf-8aab39f9c7cd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blu