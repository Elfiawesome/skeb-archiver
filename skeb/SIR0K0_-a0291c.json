ce between them is quite large.\n\nAlso, I would be very happy if the size is wallpaper size (landscape or portrait)...!\nI would be very happy if the size is wallpaper size (landscape or portrait)...!\nThank you very much.\n\n\nImage details: https://drive.google.com/drive/folders/1-MQaI-n7cpme-xJjCz32Q0UDRIphJOTx\n\nhttps://drive.google.com/drive/folders/1-MQaI-n7cpme-xJjCz32Q0UDRIphJOTx", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@SIR0K0_/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1664973, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/e9050ac7/uploads/origins/c3f3e67a-6f00-439d-b491-547a0eba4a32?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=98054605e32750c908612b60cb6c08dc", "srcset": "https://si.imgix.net/e9050ac7/uploads/origins/c3f3e67a-6f00-439d-b491-547a0eba4a32?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=98054605e32750c908612b60cb6c08dc, https://si.imgix.net/e9050ac7/uploads/origins/c3f3e67a-6f00-439d-b491-547a0eba4a32?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=32e065cc966b042079f1ceaadcee2a67 2x, https://si.imgix.net/e9050ac7/uploads/origins/c3f3e67a-6f00-439d-b491-547a0eba4a32?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c4102e949c37469e6385827b12f062df 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/e9050ac7/uploads/origins/c3f3e67a-6f00-439d-b491-547a0eba4a32?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=af5f6c7f120d64ccd0f18bdb506f4383", "srcset": "https://si.imgix.net/e9050ac7/uploads/origins/c3f3e67a-6f00-439d-b491-547a0eba4a32?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=af5f6c7f120d64ccd0f18bdb506f4383, https://si.imgix.net/e9050