・メロン・いちご\n　　　　　　さくらんぼ・ゼリー・チョコ・結晶・愛情にあふれたもの\n避けたい要素：ダークカラー・危険物・血・ステッチ\n\nhttps://sta.sh/21t9tzyzb2jd", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 360438, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "藤原ﾉこーりー🐈", "screen_name": "coreytaiyo", "avatar_url": "https://pbs.twimg.com/profile_images/1699226207173369856/lUR2JJtD.jpg", "header_url": "https://pbs.twimg.com/profile_banners/3288748645/1766898248/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 7, "complete_expiration_days": 120, "skills": [{"genre": "art"}, {"genre": "correction"}], "nc": 48}, {"id": 1899006, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "もぬけ＠お仕事募集中", "screen_name": "monu_oekaki", "avatar_url": "https://pbs.twimg.com/profile_images/1927906600897089536/i6zqvW6G.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1394258380852584448/1730204558/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 100, "skills": [{"genre": "art"}], "nc": 177}, {"id": 2827756, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "Kanade@Animation & Illustration Creator", "screen_name": "Kanade20207", "avatar_url": "https://pbs.twimg.com/profile_images/1911988534493184000/VbXwj4gz.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1278467551119331328/1768825274/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 2, "complete_expiration_days": 60, "skills": [{"genre": "ar