23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f026b086c0a5fbab8abc0ce4fd300a51, https://si.imgix.net/d9f90181/uploads/origins/fb783ccd-834d-44d8-9f63-afff04aef442?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=2cb885eb324b18fdfaab9ddae1a86f10 2x, https://si.imgix.net/d9f90181/uploads/origins/fb783ccd-834d-44d8-9f63-afff04aef442?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=17bac4e3ba756b34d0926d1dc0a5215b 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/d9f90181/uploads/origins/fb783ccd-834d-44d8-9f63-afff04aef442?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=68f770b2383f45615d558b825dab2d49", "srcset": "https://si.imgix.net/d9f90181/uploads/origins/fb783ccd-834d-44d8-9f63-afff04aef442?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=68f770b2383f45615d558b825dab2d49, https://si.imgix.net/d9f90181/uploads/origins/fb783ccd-834d-44d8-9f63-afff04aef442?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=6c3a7706bc114801aa265527e45745a4 2x, https://si.imgix.net/d9f90181/uploads/origins/fb783ccd-834d-44d8-9f63-afff04aef442?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=45d86ba44fce5e61326807d443b0cbe3 3x"}, "body": "夢眠ネムミ🐇💤様\n\nはじめまして！Twitchにて配信活動を行っております蒼海楓架(あおみふうか)と申します。この度はXにてとてもｷﾗｷﾗ可愛くて素敵な夢眠ネムミ様のイラストを拝見し、是非私蒼海楓架のイラストをお願いしたくリクエストを送らせて頂きました…！\n\n【使用用途】\n\n収益化済みのTwitchチャンネルへのサムネイル利用・コラボなどの際にコラボ相手へのサムネイル利用のためにお渡し・SNS(主にX(旧Twitter),収益化済Wick)への投稿・サブスクライバー向け(有償)やチャンネルポイント(無償)でのデジタルグッズへの使用・リアルグッズ(缶バッジやアクリルスタンド等)への使用・おはVやサムネイル素材の素材モデルとしてクリエイター様へお渡し\n\n【キャラクター詳細】\n こだわり点のみ文章での記載失礼いたします。\n◾︎三つ編みｶﾁｭｰｼｬ\n◾︎薄めの紫髪にｲﾝﾅｰｶﾗｰに薄めの青\n◾︎\"両側\"に主張の激しすぎない八重歯\n◾︎たれ目たれ眉\n◾︎人魚ﾓﾁｰﾌ(人間耳ではなく人魚耳)\n◾︎閉じる際の口は「ᵕ」の口ではなく「 ̫ 」の口\n◾︎萌え袖(指先が出る程度)\n◾︎爪は薄紫色\n\n【その他】\n◾︎サムネイル等に使用させて頂きたく思っておりますので、可能であれば頭部や左右が見切れておらず、人物と背景がレイヤー分けされたデータで納品をお願いしたく思います。\n◾︎構図・髪型・服装などはおまかせさせていただきたいです。\n\nご検討いただけますと幸いです。何卒よろしくお願い申し上げます。\n\nhttps://drive.google.com/drive/folders/1zAzQbZJWz4HUmY2S1lakSJ6tSYf5e2zC\n\n蒼海楓架\n\nhttps://drive.google.com/drive/folders/1zAzQbZJWz4HUmY2S1lakSJ6tSYf5e2zC", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@nemumi_oekaki/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2229944, "client_id": 3362679, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/51b17911/uploads/origins/8f382ddf-6874-489a-923b-72c5fadc00dc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a4b3af0428943490993f1023bf0a8d37", "srcset": "https://si.imgix.net/51b17911/uploads/origins/8f382ddf-6874-489a-923b-72c5fadc00dc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a4b3af0428943490993f1023bf0a8d37, https://si.imgix.net/51b17911/uploads/origins/8f382ddf-6874-489a-923b-72c5fadc00dc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=1a5c8b1681d7f2304c7be0be0814631b 2x, https://si.imgix.net/51b17911/uploads/origins/8f382ddf-6874-489a-923b-72c5fadc00dc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=3dd82140b05ebb960a8e1ccda652f185 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/51b17911/uploads/origins/8f382ddf-6874-489a-923b-72c5fadc00dc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6b8b317858f139d63e55078bf6e92753", "srcset": "https://si.imgix.net/51b17911/uploads/origins/8f382ddf-6874-489a-923b-72c5fadc00dc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6b8b317858f139d63e55078bf6e92753, https://si.imgix.net/51b17911/uploads/origins/8f382ddf-6874-489a-923b-72c5fadc00dc?bg=%23fff&auto=format%2Ccompress&fm=webp&