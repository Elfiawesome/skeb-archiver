690be-da5f-48c4-b480-ec6533d2b3c9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6d670e4b9f6906afbbc9ac9a12c1acb4", "src_set": ""}, "body": "てん様、初めまして！アピールありがとうございます！  ぜひマギーを描いてください！明るく働き者の庭師です。好きなように描いてください！\n\n参考文献\nhttps://drive.google.com/file/d/1GeLX2-mrfo4Ou9lHP4ESrRf42A45dmvS/view?usp=drivesdk\nhttps://drive.google.com/file/d/1ODVKrE2kKq_PFg_4AGimT2-JW19f39J3/view?usp=drivesdk\n\nこのイラストはSNS、YouTube、Twitchで使用させていただく可能性があります。よろしくお願いします！\n\nhttps://drive.google.com/drive/folders/1AM03gKREXkzK9b9QhPK3AD50HG8Qyomk", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@na____shi28/works/9", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1053464, "client_id": 3507227, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/2e9e849f/uploads/origins/102fa3dd-bc72-4fd0-baec-963c1af2ff73?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0eb95db55e9abef839635244ceb91bcb", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/2e9e849f/uploads/origins/102fa3dd-bc72-4fd0-baec-963c1af2ff73?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=35f6fec9b8b54407000b446f61054dc2", "src_set": ""}, "body": "てん様の素敵なイラストを拝見し、是非依頼させて頂きたくご連絡致しました。\n\n・お願いしたいもの\n私のオリジナルキャラクターの｢ファネちゃん｣を描いていただきたいと思っております。\nてん様の水彩でリクエスト致します。ポーズ、構図、シチュエーションはお任せします。\n\n参考画像として、私の描いたイラストのクリップURLを添付します。\nhttps://misskey.io/clips/aamjciok4wth07ba\n\n・キャラクターについて\n見た目→銀髪碧眼、色白で、凹凸の少ない華奢な体格の女の子です。耳は髪の毛に隠れていて見えません。頭頂部に太めのアホ毛が２本あり、髪の毛は癖っ毛で跳ねのあるショートヘアです。\n鶏のような形の尻尾があります。\n性格→やや無口、表情の変化が少なめなタイプのキャラクターです。\n服装→シンプルでカジュアルな服装(Tシャツ系)が多いです。首元を隠す服または黒いチョーカーを着けています。\n\n・背景について\nてん様の植物の表現がとても好きなので、何かしらの植物を入れていただけたら嬉しいです。可能であれば烏瓜や鬼灯など赤系のものを希望しますが、すべてお任せいたします。\n\n・用途\n各SNSのヘッダー等プロフィール画像への使用、および個人的な鑑賞を目的としたポストカードやステッカー等のグッズ化。\n商用利用はございません。\n\n・もし可能でしたらキャラクターのみの透過差分を頂きたいです。\n\nお忙しいとは思いますが、ご検討いただけましたら幸いです。\n宜しくお願い致します。", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@na____shi28/works/8", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1053464, "client_id": 2646402, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/90a3bd5e/uploads/origins/fbb8eb7c-a867-4af4-aacf-e64620b53f1a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8df87b3a9bfa7511511f1f1625a77704", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/90a3bd5e/uploads/origins/fbb8eb7c-a867-4af4-aacf-e64620b53f1a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=51c4d183093b78cfbbe192442fdcec36", "src_set": ""}, "body": "テン先生 こんにちは！今回も先生の作品がとても素敵だったので、またお願いしたいと思います！\nhttps://drive.google.com/drive/folders/1yO_R-4uc2AoNsIvzCo7xVm0aEbo7JhBA?usp=drive_link\n\n同じキャラクターです！今回は真ん中の衣装をお願いします！\n今回も性格を大まかに説明します！\n\n日村（21）\n 野心がなかったが、少しずつ野心を持つようになった男！おしゃべりで、すぐふてくされる！人を笑顔にしたい人。\n\n  鮎子（23）\n嘘が多く、少しずつ改善しようとしている女の子。\n自信家で、慇懃無礼で、ぶっきらぼうで、時々とても傲慢になる。しかし、彼女の本当の姿は、嘘つきの仮面と変わらない。唯一の違いは、彼女がもっと内気だということだ。\n\n二人の関係は、鮎子がいじられ役で、日村がいじられ役だ！鮎子は日村にちょっかいを出すのが好きで、日村は超慌てふためく！\n\nシナリオとしては、鮎子が日村をいじめて、日村がすごく慌てふためくような感じにしたいです！どんなポーズでもOKです！真ん中の服を参考に描いてください！\n\n改めてご検討よろしくお願いします\n\nhttps://drive.google.com/drive/folders/1yO_R-4uc2AoNsIvzCo7xVm0aEbo7JhBA?usp=drive_link", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@na____shi28/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1053464, "client_id": 0, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/6d948289/uploads/origins/83bf9ae9-6b54-48d0-9368-808b7ca2ad71?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=07a2839c43febe88a59