見し、\n是非とも自身を描いて頂けたらと思い、リクエストをお送りいたします。\n\n当方シチュエーションボイス等も投稿したりするので、\nダウナー系シチュでの動画に是非とも先生のイラストを\n使用させていただきたいと思いました…!\n\n【使用用途】\n動画のサムネイルや日常ポストの投稿等に使用\n(グッズに使用させていただく可能性もございます）\n\n【人物】\n桜音のん\n(こちら詳細を添付させていただきます）\n\n【服装】\nサブカル系の服装(デザイン等お任せいたします)\n\n【描写範囲】\nバストアップ～お顔アップでお願いいたします\n\n【髪型】\nこちらは新衣装(ブラウンニット)時の前髪をあげている髪型でお願いします。\n\n【髪型差分】\nウルフヘアも描いて頂けますととても嬉しいですTT✨\n\n【ポーズ等】\nこちらはお任せいたします\n\n【表情】\nこちらもお任せいたします\n\n【表情差分】\n何点かいただけますととても助かります…!\n(ヤンデレ表情を含めて頂けるとよりありがたいです✨）\n\n【その他】\nご納品の際は人物のみの背景透過したものも頂けますと嬉しいです。\n\nhttps://drive.google.com/drive/folders/1ijxB6TJLiMreu6uivpprVCjY2KcBMwAi?usp=drive_link", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@Rintaro_9n/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 4058594, "client_id": 4142992, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/2221e25d/uploads/origins/f647aa77-0303-4f41-9192-252e4791a66f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f019c166b170e354d5b2df380dfba31b", "srcset": "https://si.imgix.net/2221e25d/uploads/origins/f647aa77-0303-4f41-9192-252e4791a66f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f019c166b170e354d5b2df380dfba31b, https://si.imgix.net/2221e25d/uploads/origins/f647aa77-0303-4f41-9192-252e4791a66f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=597d48f4002a44e8bc46112e9b5654a8 2x, https://si.imgix.net/2221e25d/uploads/origins/f647aa77-0303-4f41-9192-252e4791a66f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e12c44bb823a08cbf09e9cafa2e83b55 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/2221e25d/uploads/origins/f647aa77-0303-4f41-9192-252e4791a66f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ed1001a91bb06ad10d43260c55ad90d3", "srcs