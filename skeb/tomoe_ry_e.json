s_count": 0, "received_works": [{"path": "/@tomoe_ry_e/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3397505, "client_id": 3467065, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/4be5e117/uploads/origins/bb6b97c9-95a3-4225-a87b-e5a2ffba46a0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2c8542f0346bc76e6e64f2a857223c77", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/4be5e117/uploads/origins/bb6b97c9-95a3-4225-a87b-e5a2ffba46a0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ec18ea9ad43713a9226fb08352da2bb8", "src_set": ""}, "body": "ともえさん、暑中見舞い申し上げます。\n前回の乙葉のイラストが本当に素晴らしくてまたお願いしたくなりました。\n\n今回も『藤堂乙葉』のイラストをお願い致します。\n再び水着っぽい衣装を着た\nhttps://x.com/yuneillusts/status/1932084767580922039?t=3765NILOSYEpmxr2phb2eA&s=06\nの様な衣装で\n背景をナイトプールで楽しんでいる感じでお願い致します。\n\n使用用途ですが、スマホとタブレットの壁紙にて楽しむつもりです。\nかなり猛暑が続き体調管理が大変でしたり、他の方からご依頼があり忙しいと思いますが\n何卒よろしくお願い致します。", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@tomoe_ry_e/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3397505, "client_id": 3213517, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/556eff6b/uploads/origins/b2cc6b27-51ec-4a3a-9571-1fc40a4f536d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7a1213859ce8021fd261508138d6b944", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/556eff6b/uploads/origins/b2cc6b27-51ec-4a3a-9571-1fc40a4f536d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=58b17d4845624c53ef65b4821dba8ecc", "src_set": ""}, "body": "こんにちは！はじめまして！\n\nカストーリスとホタルのアートを見てファンになりました。FF14のキャラクターのアートワークをお願いしたいです。参考リンクの衣装でお願いしたいです。私のキャラクターは、ちょっと大人っぽくて、クールで、セクシーな雰囲気を持っています。\nまた、参考リンクの画像よりも胸を大きくしていただけると嬉しいです。\nポーズや表情はお任せします。\n\nhttps://drive.google.com/drive/folders/1DdDncDG2Fvm5urXZr-z_s88tno0lX3uv?usp=drive_link", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@tomoe_ry_e/works/5", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/dd77abae/uploads/origins/40801275-3f06-4db2-ab00-ed079b26834a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=7f7c78655d985f459dc1e7470da8496c", "src_set": ""}, "private": true, "genre": "art", "tipped": false, "creator_id": 3397505, "client_id": 126448, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 16, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@tomoe_ry_e/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3397505, "client_id": 3467065, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/cf2ac7bc/uploads/origins/ffa55c32-cd8f-4bae-b11b-a65ead9fb796?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e8160fca4bcb757b40e38d3bbd452f36", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/cf2ac7bc/uploads/origins/ffa55c32-cd8f-4bae-b11b-a65ead9fb796?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3bbc82c3ecd41dcd4b4c0848705ccd75", "src_set": ""}, "body": "お初にお目にかかります。シロガネと言います。\nともえさんのイラストを偶然お見かけして、キャラのホタルのイラストが綺麗でしたので、イラストをお願いしたく思いました。\n\n描いて欲しいのは『俺の彼女は2人いる』というゲームのキャラで『藤堂乙葉』という娘です\n↓(参考です)\nhttps://images.app.goo.gl/9j1h25iGpEWDKf1P8\n\nこの娘に下のURLのような衣装、水着姿\nhttps://x.com/TheMallowkitSFW/status/1929066927256731867?t=tdJBh7kLHb70b8EXEBVnTg&s=19\nお願いします。\nポーズと衣装の色はともえさんにおまかせします。\n背景を夕日の海辺が良いです。\n\n長くなりましたが何卒よろしくお願い致します。", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@tomoe_ry_e/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3397505, "client_id": 1316738, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/79c21471/uploads/origins/4dc44efe-ff1c-41ff-a33f-24c865c988da?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=51a91720cab3890b6e60a1ced7538fab", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/79c21471/uploads/origins/4dc44efe-ff1c-41ff-a33f-24c865c988da?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5d3f74e193625b1c53cf04f37685453f", "src_set": ""}, "body": "こんにちは。最近あなたの絵に出会って、本当に大好きになりました！あなたのスタイルで私のVtuberを描いてほしいです。\n\n彼女の服装は何でも構いません。セクシーなもの、チアリーダー、レースクイーンとか。お任せします。\nポーズや表情もお任せします。  \n\n可能であれば、背景を透過したバージョンもお願いできますか？PSDでも結構です。\n\nご検討のほど、よろしくお願いいたします！\n\nhttps://imgur.com/a/KDDabOv", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@tomoe_ry_e/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3397505, "client_id": 3050014, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/782631c0/uploads/origins/56b0cd30-1a3f-4bb1-b0d2-285bff4e05a0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d064bb30a42cda4db98c4d253a71b1c9", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/782631c0/uploads/origins/56b0cd30-1a3f-4bb1-b0d2-285bff4e05a0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9a11a5ffdbecb93d6348a782fd5f4aba", "src_set": ""}, "body": "こんにちは！あなたの絵が好きです！\n\n私のオリジナルキャラクターを描いてほしいです。(https://postimg.cc/gallery/kgj87S5)\n\nその他はお任せします。\n\nよろしくお願いします！", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@tomoe_ry_e/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3397505, "client_id": 1746706, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/042f1969/uploads/origins/0b3831c6-9e6e-40a9-a1cb-70a2c3f8fdd9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c96b4912b3562608ece7229cfee54fcd", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/042f1969/uploads/origins/0b3831c6-9e6e-40a9-a1cb-70a2c3f8fdd9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=41368ab79f4c42e5298ebbfa2c92326d", "src_set": ""}, "body": "個人ＶTubaの上観鈴さんの絵を依頼したいのですがよろしいですか？\n\n\n描いてほいイメージは、\nhttps://x.com/Misuzu_kami_vt/status/1819699754214867060?t=CYqDmawYKwW4kq0cl4Te4g&s=19\nのツイにて新衣装披露してますのでこの衣装でお願いします。（制服ではない方です。）\n描いて欲しいイメージは、先生が上観鈴さんの立ち絵を観てこういう風にしたいとイメージして描いてください。先生の作品どれも素晴らしくて私があれこれいうより数百倍いい作品ができると思うので。\n\nまた、できましたら瞳をハート目でお願いできませんか？\nまた、家に観鈴さんのペットでうしまる（うしみたいな執事）と帝国民（ちんちろ）を描いてもらえませんか？いなくても大丈夫です。\n使用用途は、私のSNSでの使用許可と上観鈴さんの使用許可が欲しいです。\n上観鈴さん（モデルですが）VTuberの活動(観鈴さんのSNSでの使用許可と。週間予定表や、YouTubeでのサムネ等での)配信活動に使用させていただくことが可能ですか？YouTubeチャンネルでは、スパチャ解禁してます。\n商用利用になります。\n上観鈴さんの配信活動に利用させて貰いたいです。可能でしたら制作お願いします。\nまた、人物だけの透過pngやpsdデータのご用意お願いします。\nまた、難しいようでしたら先生の好きなようにかいて大丈夫です。先生にぜひともかいてもらいたいと思います。\n\n\nどうかご検討お願いいたします。", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "similar_creators": [{"id": 2506378, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "shimesaba@７月数枠", "screen_name": "atto_silia", "avatar_url": "https://pbs.twimg.com/profile_images/1848986584198352898/6Y-HHY-e.jpg", "header_url": "https://pbs.twimg.com/profile_