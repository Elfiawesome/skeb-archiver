": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/0e00ee6e/uploads/origins/f2fc2080-2ac9-48c4-a188-9fa948aec2d2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6aeb7d8a3ea6f660e71a17e2443bc30a", "srcset": "https://si.imgix.net/0e00ee6e/uploads/origins/f2fc2080-2ac9-48c4-a188-9fa948aec2d2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6aeb7d8a3ea6f660e71a17e2443bc30a, https://si.imgix.net/0e00ee6e/uploads/origins/f2fc2080-2ac9-48c4-a188-9fa948aec2d2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=94734e64e67a7ca8714a028ece4c617f 2x, https://si.imgix.net/0e00ee6e/uploads/origins/f2fc2080-2ac9-48c4-a188-9fa948aec2d2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=786d05420780c72d8e18f2b2d0f1cf69 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/0e00ee6e/uploads/origins/f2fc2080-2ac9-48c4-a188-9fa948aec2d2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=238367a004c68687d063e69e82bb3ce0", "srcset": "https://si.imgix.net/0e00ee6e/uploads/origins/f2fc2080-2ac9-48c4-a188-9fa948aec2d2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=238367a004c68687d063e69e82bb3ce0, https://si.imgix.net/0e00ee6e/uploads/origins/f2fc2080-2ac9-48c4-a188-9fa948aec2d2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=47a016cc21d84739ed8e79864bfd5693 2x, https://si.imgix.net/0e00ee6e/uploads/origins/f2fc2080-2ac9-48c4-a188-9fa948aec2d2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=e188d14715975f915559eb5a7d87fd3e 3x"}, "body": "初めまして。\nVtuberの千道灯鈴(せんどうともり)と申します。　\nカガミチヒロ様の可愛くて塗りがとても素敵なイラストをお見かけし、是非とも活動で使用する私のイラストをお願い出来たらと思い、メッセージを送らせて頂きます。\n\n○用途:SNSでの掲載、配信や動画内、サムネイル、FANBOX等で使用させて頂きたいです。\n(利用不可な内容がありましたらデータ内に記載して頂けたらと思います)\n\n○サムネイルに使用したい為、頭や髪の先が切れない様に描いて頂けますと幸いです。\nまた、背景がある場合はキャラクターのみ透過のデータか、別レイヤーに分けたPSDデータを頂けるとありがたいです。\n\n私のデザインは以下をご確認下さい。\n---\nTwitter\nhttps://twitter.com/tomori_sendo/status/1513504421820637189?s=21&t=8AJn2TB8s-G4SGo3VSW_7A\n\nHP(いくつか表情あり)\nhttps://xssxrax.wixsite.com/tomori-sendo\n\n髪はストロベリーブロンド系の金髪にピンクのメッシュ。\n瞳はピンクで、ハイライトに星があります。\n胸はペタンコではなく巨乳でも無い範囲であればお好みで。\n服装はこのままでも、変更して頂いても大丈夫です。\n何でも着ます。\n---\n\nご検討頂けましたら幸いです。よろしくお願いいたします。", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@kg3ch6/works/8", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/87037d64/uploads/origins/317440d7-4a8d-44fc-9079-4dd2600cdbd1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=fa698be821583ea848da35bda73aae5d", "srcset": "https://si.imgix.net/87037d64/uploads/origins/317440d7-4a8d-44fc-9079-4dd2600cdbd1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=fa698be821583ea848da35bda73aae5d, https://si.imgix.net/87037d64/uploads/origins/317440d7-4a8d-44fc-9079-4dd2600cdbd1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=9dc220006b56511138826e04fec87cdc 2x, https://si.imgix.net/87037d64/uploads/origins/317440d7-4a8d-44fc-9079-4dd2600cdbd1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=6c4e6e0aebb9986974425a6f9c82f1e8 3x"}, "private": true, "genre": "art", "tipped": false, "creator_id": 2007271, "client_id": 279237, "nc": 1}, {"path": "/@kg3ch6/works/7", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/a02648aa/uploads/origins/7105b4b4-c8e5-4a68-bdaf-af1b57e92f43?bg=%23fff&auto=