積んだ混合動力式三発機の夜間戦闘機です。武装は胴体に斜銃が三門、機首に発動機モーターカノンが一門、機体サイズに関しては15～16ｍ弱程度で考えています。なお液冷エンジンの排気管には消炎マフラーが付いています（He219のものと同型）。\n資料「aro01」を参照に塗装は「aro-tosou」を元にして、尾翼もしくは胴体にトウコちゃんの機体マークを描いていただきたいです（資料「e-to」参照）。\n資料はURL先にまとめてあります。何卒宜しくお願い致します。\n\nhttps://www.dropbox.com/scl/fo/lvxn2t6toklyu9w041q8t/AAGdef1SydAXd9n8_0t76mo?rlkey=0tttj0trpw6huvch1emi5fywq&st=1iguj011&dl=0", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@piitan2_mokotan/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3241751, "client_id": 3805944, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/381cc0d5/uploads/origins/1819230f-e05b-4521-86c2-1b477b3046c8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fee2aa8a3d5267e4874cdf142bc3b30e", "srcset": "https://si.imgix.net/381cc0d5/uploads/origins/1819230f-e05b-4521-86c2-1b477b3046c8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fee2aa8a3d5267e4874cdf142bc3b30e, https://si.imgix.net/381cc0d5/uploads/origins/1819230f-e05b-4521-86c2-1b477b3046c8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=07491333f5baee55c04d59ab84543612 2x, https://si.imgix.net/381cc0d5/uploads/origins/1819230f-e05b-4521-86c2-1b477b3046c8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=23b5948a19154990823db5522dfdac7e 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/381cc0d5/uploads/origins/1819230f-e05b-4521-86c2-1b477b3046c8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=74f0959e7dfff466dbf8cbd198377984", "srcset": "https://si.imgix.net/381cc0d5/uploads/origins/1819230f-e05b-4521-86c2-1b477b3046c8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=74f0959e7dfff466dbf8cbd198377984, https://si.imgix.net/381cc0d5/