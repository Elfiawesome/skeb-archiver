9-f86e-4a3b-844d-05f39afd929d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=7653fc53aaa01078ca20660f3fe188cb 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/8b9df3bf/uploads/origins/6c5db259-f86e-4a3b-844d-05f39afd929d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=321a93721e49b10be2b38ba1575395a9", "srcset": "https://si.imgix.net/8b9df3bf/uploads/origins/6c5db259-f86e-4a3b-844d-05f39afd929d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=321a93721e49b10be2b38ba1575395a9, https://si.imgix.net/8b9df3bf/uploads/origins/6c5db259-f86e-4a3b-844d-05f39afd929d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=6051f5a65dce21b63c649058f3b31755 2x, https://si.imgix.net/8b9df3bf/uploads/origins/6c5db259-f86e-4a3b-844d-05f39afd929d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=1cda1e24cb72d2e244a4a3f91446780f 3x"}, "body": "初めまして。あなたのイラストをSNSで拝見し非常に素敵だと感じたので依頼させていただきました。\n【依頼内容】\n私のアバターであるオスキワのイラストをお願いします。特徴は青メッシュと右耳のイヤリングです。\n元キャラは２０代の設定ですが先生の絵柄に合わせて１６−１７くらいに若く可愛く描いてほしいです。\nキャラ参考資料↓\nhttps://drive.google.com/drive/folders/1NOkcMD6ekGGJKzJzKR2fB1z2RULVnEK3\n【シチュエーション】\n催眠にかけられて自身のことを犬だと思いこんでご主人様におねだりしているシチュでお願いします！\n【ポーズ】\n犬のおねだりポーズ、いわゆるちんちんのポーズをお願いします。 \n↓参考\nhttps://dic.pixiv.net/a/%E3%81%A1%E3%82%93%E3%81%A1%E3%82%93%E3%81%AE%E3%83%9D%E3%83%BC%E3%82%BA\n【衣装】\n犬耳をつけてほしいです。犬耳は垂れ耳です。参考資料に犬耳の画像もあります。\n首輪とリードも付けてほしいです。\n【表情】\n舌を垂らして蕩けた表情をお願いします。\n差分としてハート目の表情差分もいただけると嬉しいです。(難しければ無くても大丈夫です)\n射精の差分もあると嬉しいです。この時アヘ顔にしてくれると嬉しいです。\n【構図】\nリードは画面外に伸びて持ち手がどんな人物かわからないようにしてほしいです。\n\n金額が合わなければアピールいただけますと嬉しいです。\nよろしくお願いします。", "nc": 56, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@R17046432/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id