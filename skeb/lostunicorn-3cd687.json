07a5-4e4e-a701-8d253f02fb7b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=8f642bd0d1692e50ffa67344799ef313", "srcset": "https://si.imgix.net/1212ef84/uploads/origins/41a57fd0-07a5-4e4e-a701-8d253f02fb7b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=8f642bd0d1692e50ffa67344799ef313, https://si.imgix.net/1212ef84/uploads/origins/41a57fd0-07a5-4e4e-a701-8d253f02fb7b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=7a401a6dca1cb18b912a8479dc4b6039 2x, https://si.imgix.net/1212ef84/uploads/origins/41a57fd0-07a5-4e4e-a701-8d253f02fb7b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=9a7955020266714282dd099706814525 3x"}, "body": "Nice to meet you. \n\nI have been following your artwork on Pixiv for a long time. And I would be very happy if you were to accept this request. I apologize for any errors in translation.\n\nライトノベルシリーズようこそ実力至上主義の教室へ\nのキャラクター坂柳 有栖の凌辱イラストをお願いしたいのですが、いかがでしょうか。\n\nシリーズ：ようこそ実力至上主義の教室へ\n\nキャラクター：坂柳 有栖\n\nリファレンスです：https://imgur.com/a/PW6VbHr\n\n2つのシナリオを用意して、自由に選んでもらいました。\n\n最初のアイデアは、校長の娘としての彼女の役割についてです。彼女は後任の校長に会うために校長室に誘われるが、代わりに変態のおじさんたちと一緒に部屋に閉じ込められる。そのおじさんたちは学校のスポンサーで、資金提供の見返りに、彼女の体を好きにすることを許されている。\n\n2つ目のシナリオは、彼女が操って退学させた生徒が彼女に復讐するというバッドエンドでした。彼女の寮の部屋に隠れて、部屋で着替えていた彼女を強姦する。レイプしながら無理やりキスをする彼と。以下、その生徒の参考資料です：https://imgur.io/a/jhPpzLK\n\nどちらかお好きなシナリオをお選びください。詳細はすべてお任せします。できれば、男性陣の射精で彼女が快楽に落ちていくような差分が欲しいです。でも、それはあなた次第です。\n\nご検討のほど、よろしくお願いいたします。", "nc": 169, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@lostunicorn/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 23870, "client_id": 456790, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/88a91b32/uploads/origins/b9d9d150-be60-4a4f-aa04-606d351181b5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e0ab