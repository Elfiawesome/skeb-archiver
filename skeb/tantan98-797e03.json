fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=3e238d5326ff72a95f85b31df8f03ee3 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/8826ce23/uploads/origins/71d778c3-9320-4116-a757-675a8bb0affb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=91ca313c795658cac806bdf4612e2bbd", "srcset": "https://si.imgix.net/8826ce23/uploads/origins/71d778c3-9320-4116-a757-675a8bb0affb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=91ca313c795658cac806bdf4612e2bbd, https://si.imgix.net/8826ce23/uploads/origins/71d778c3-9320-4116-a757-675a8bb0affb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=5391a46807ebc56b50fcbea4578dc77f 2x, https://si.imgix.net/8826ce23/uploads/origins/71d778c3-9320-4116-a757-675a8bb0affb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=d6ad153d0dc1c913f18497b0e877a3de 3x"}, "body": "前回はありがとうございました！\nまたイラストお願いします。\n\n【依頼内容】\n表情　→　唇ぽてぽて、好きだけどフンッみたいな表情\n構図　→　片手は顎、もう片方が画面ツンみたいな感じ\n服装　→　ちょっとセクシーな感じで、チョーカーしてたらうれしいです。\n\nリボンやぱんだはイアラストの雰囲気にお任せします。\n\n【使用用途】\n配信活動（Twitch収益化済）における動画・SNS（Xなど）で使用させていただきたいです。\nそのため、髪の毛などの見切れが少ない構図で、透過PNGまたはPSD形式でご納品いただけると助かります。\n\n可能であればネットプリントへの登録をさせていただきたいです。\n\nサツキチ様のご負担にならない範囲でご対応いただけましたら幸いです。\nよろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/1JxeZ68s5cxYP7oY3DLuCDgOBI_jF0GjM", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@tantan98/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2829123, "client_id": 3864139, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/a0f1fb5f/uploads/origins/89ddda1b-8244-4bff-ba25-82f5ea405e2d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a0325f2c2010344e0b59a68093ca74ae", "srcset": "https://si.img