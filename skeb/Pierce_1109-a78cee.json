96e-9888-26a85ebbff5a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=49b7649b0e662923ebf61034b9499f3a", "srcset": "https://si.imgix.net/7984bed1/uploads/origins/1bd49a3e-fa6c-496e-9888-26a85ebbff5a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=49b7649b0e662923ebf61034b9499f3a, https://si.imgix.net/7984bed1/uploads/origins/1bd49a3e-fa6c-496e-9888-26a85ebbff5a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=b1bb8558285110e9da5b34bcef1c901b 2x, https://si.imgix.net/7984bed1/uploads/origins/1bd49a3e-fa6c-496e-9888-26a85ebbff5a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=97ca4615f42b95905ca27f798133fa8f 3x"}, "body": "先生、はじめまして。先生のイラストがとても大好きです！\nTRPGのOCを描いていただきたいです。\n背景は1990年代のHONG KONG、警察とマフィアが激しく対立していた。二人は警察官の同僚で、相棒関係。\n男性は黒髪で銀色の瞳、右のまぶたにほくろがあります。 動物キャラは狼🐺。\n女性は黒髪でブラウングリーンの瞳、右の目の下にほくろがあります。 動物キャラはウサギ🐇。\n服装や表現方法などは、お好きなように自由に描いていただいて大丈夫です。\n個人利用。\n金額や依頼内容に問題がある場合は、変更をお願いします。\n文法が不自然な部分はご容赦ください。読んでいただきありがとうございます！\n\nhttps://drive.google.com/drive/folders/1BkJh8qmDBLZbVlB3IQ0cj7tR_MTSXJWO?usp=sharing", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Pierce_1109/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3985877, "client_id": 4016819, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/c5182e46/uploads/origins/fd5de035-bad1-44cd-af4a-b84f20135423?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d3e046e6cfab5d7436d2f2cae72b8a0d", "srcset": "https://si.imgix.net/c5182e46/uploads/origins/fd5de035-bad1-44cd-af4a-b84f20135423?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d3e046e6cfab5d7436d2f2cae72b8a0d, https://si.imgix.net/c5182e46/uploads/origins/fd5de035-bad1-44cd-af4a-b84f20135423?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=57f09bbd6ec36d953ea1ac35f6803e43 2x, https://si.imgix.net/c5182e46/uploads/origins/fd5de035-bad1-44cd-af4a-b84f20135423?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b014d2795e633315bb13ade930d986b0 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/c5182e46/uploads/origins/fd5de035-bad1-44cd-af4a-b84f20135423?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f4f6bd4c5c423580b7ed6956cd28400c", "srcset": "https://si.imgix.net/c5182e46/uploads/origins/fd5de035-bad1-44cd-af4a-b84f20135423?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f4f6bd4c5c423580b7ed6956cd28400c, https://si.imgix.net/c5182e46/uploads/origins/fd5de035-bad1-44cd-af4a-b84f20135423?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=b15a624c8a95c8cb52b093b1ff7a4b93 2x, https://si.imgix.net/c5182e46/uploads/origins/fd5de035-bad1-44cd-af4a-b84f20135423?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=b6b9590044d671bbe143ede9823fd49a 3x"}, "body": "Pierce先生、こんにちは！\n\n先生が前回私のオリジナルキャラクターのために描いてくださった作品が本当に大好きで、今でもとても大切にしています。今回はもう一度先生にお願いしたく、ご迷惑でなければ、私のもう一人のオリジナルキャラクターを描いていただけたら嬉しいです。\n\nOC：Sylvan\nSylvan は、黒い少し癖のあるショートヘアと銀白色の瞳をした女の子です。\n少し内向的な性格で、自然が大好きです。\n中世ヨーロッパ風ファンタジー世界の魔法学院で、魔法薬学を学ぶ見習いです。\n\n普段は木製のスプーンと木柄の小さな金属ナイフ（腰につけています）を持ち歩いています。\n透明化魔法と時間魔法が得意で、森を散歩したり、植物を採集したり、あちこちを探索することが好きです。\n\n衣装\n服装は参考資料をご覧いただければと思いますが、先生のお好みで自由にデザインしていただけたら嬉しいです！\n\n全体的には、動きやすく、少し森を感じられるような雰囲気を希望しています。\n配色は、黒、深い青、深い紫、緑、茶色、銀系をイメージしています。\n\n描いていただきたい内容\n生活感のある、かわいらしい日常のワンシーンを描いていただけたら嬉しいです。\n例えば、森を散歩したり、植物を採集したり、ぼんやりしたり、休憩したりするような場面や、そのほか先生が Sylvan に似合うと思われる日常の様子を描いていただけたら嬉しいです。\n\nポーズや仕草、表情、シチュエーションなどは、先生のお好みで自由に描いていただけたら嬉しいです！もしかわいい服装をデザインしていただけましたら、とても嬉しいです！\n\n参考資料は下記の Google Drive にまとめてあります。\n最後まで読んでいただき、本当にありがとうございました！\n\nhttps://drive.google.com/drive/folders/1B0hARYXbgv_RWQzSl7WeZTipV-hQMzmg?usp=sharing", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Pierce_1109/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3985877, "client_id": 1017764, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/baf8299a/uploads/origins/51f08973-9e13-4d14-8fb1-562b047ba321?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=97998a3fcb5b8e1f5eb5a84b5bb10574", "srcset": "https://si.imgix.net/baf8299a/uploads/origins/51f08973-9e13-4d14-8fb1-562b047ba321?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=97998a3fcb5b8e1f5eb5a84b5bb10574, https://si.imgix.net/baf8299a/uploads/origins/51f08973-9e13-4d14-8fb1-562b047ba321?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=862d4ff4fdcdee9031875815521e7f46 2x, https://si.imgix.net/baf8299a/uploads/origins/51f08973-9e13-4d14-8fb1-562b047ba321?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d6368175b6f4d00f7ae15ce521004a94 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/baf8299a/uploads/origins/51f08973-9e13-4d14-8fb1-562b047ba321?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=1b68c689c4224a9b2d6b285986a19829", "srcset": "https://si.imgix.net/baf8299a/uploads/origins/51f08973-9e13-4d14-8fb1-562b047ba321?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=1b68c689c4224a9b2d6b285986a19829, https://si.imgix.net/baf8299a/uploads/origins/51f08973-9e13-4d14-8fb1-562b047ba321?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=f3c62e9b22224264a1fb151caeaf1a8b 2x, https://si.imgix.net/baf8299a/uploads/origins/51f08973-9e13-4d14-8fb1-562b047ba321?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=c253a781851e628c611081722349a2d1 3x"}, "body": "はじめまして！素敵な絵に一目惚れできました！\nオリジナルに限るとこと承知で、一か八か。僕の最推しチェアモルド様を描いていただきたいのです。\nこちらはヴァリアール公式ホームページガイドラインの「有償二次創作のイラスト等に使用可能なキャラクターのリスト」に記載されているキャラクターでして。それにこちらのキャラクターをデザイン制作された中の人（下記のXのポスト）のチェアモルドさんからも許可もいただいております。\n\n以下、公式の全身資料が載ってるXのポストのURL（https://x.com/chair_mold/status/1957085874732118110?s=46&t=A9AxuTUJU2NOpIQOEQe65w）\nまた性格は、紳士的な姿とは裏腹にマイペースでおちゃらけていて、自身が楽しむためだけに問題を起こすトラブルメーカーです。公式の紹介文（https://vrheel.com/villain/%e3%83%81%e3%82%a7%e3%82%a2%e3%83%a2%e3%83%ab%e3%83%89/）も置いておきますゆえこちらをご参考に描いていただきましたら幸いです。\n\nまた、お描きくださった作品はスマホ、iPadの壁紙に使用する予定です。（イラストを壁紙設定した、スマホまたはiPadを撮った画像を貼ったポストする可能性があります。そのポストをする際はpierceさんのXアカウントIDを記載します）\n\n以上になります。ご検討のほどよろしくお願いいたします！", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Pierce_1109/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3985877, "client_id": 4016819, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/64a8b581/uploads/origins/fcfdf237-4d1d-470b-9a1e-27261d0940d8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=57a974bbf70e90a14fdf34baa4c3b3d0", "srcset": "https://si.imgix.net/64a8b581/uploads/origins/fcfdf237-4d1d-470b-9a1e-27261d0940d8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=57a974bbf70e90a14fdf34baa4c3b3d0, https://si.imgix.net/64a8b581/uploads/origins/fcfdf237-4d1d-470b-9a1e-27261d0940d8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=9db970e434c75413d2c2595bba27dd03 2x, https://si.imgix.net/64a8b581/uploads/origins/fcfdf237-4d1d-470b-9a1e-27261d0940d8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=412c8515e0c720b575080e21adc8c210 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/64a8b581/uploads/origins/fcfdf237-4d1d-470b-9a1e-27261d0940d8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f8696d4dce5368abb09514688d8318dd", "srcset": "https://si.imgix.net/64a8b581/uploads/origins/fcfdf237-4d1d-470b-9a1e-27261d0940d8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f8696d4dce5368abb09514688d8318dd, https://si.imgix.net/64a8b581/uploads/origins/fcfdf237-4d1d-470b-9a1e-27261d0940d8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=edcfeca04d5085a2d0e3cd73b8c45c19 2x, https://si.imgix.net/64a8b581/uploads/origins/fcfdf237-4d1d-470b-9a1e-27261d0940d8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=0c678be491d6e86984239e61bb87c8dc 3x"}, "body": "こんにちは、Pierceさん！\nあなたの作品が大好きです。とても可愛らしい絵柄で、ぜひ私のオリジナルキャラクター2人のイラストをお願いしたいです。\n彼らは中世ファンタジーの魔法学院に通う見習い魔法使いです。\nキャラクターA：\n毛先が一つにまとまった長い白髪、青緑色の瞳。風魔法が得意です。平民出身ですが、どこか謎めいた雰囲気があります。ドルイドとの関わりがあるかもしれません。最初は物静かで少しよそよそしく見えますが、親しくなると少し天然で、恥ずかしがり屋で、ユーモアがあります。\nキャラクターB：\n右側に金色のメッシュが入った短い茶髪、茶金色の瞳。火魔法が得意です。貴族出身で、明るく親しみやすく、少しいたずら好きな性格です。\nシーン：\n学院内のどこかで、二人が勉強したり、おしゃべりしたり、のんびり過ごしている場面をお願いしたいです。\n関係性：\n二人が友達になり始めた頃の時期を希望します。まだとても親しいわけではなく、BがAともっと仲良くなろうとしている段階です。\n服装：\nもしよろしければ、普段着を自由にデザインしていただいて構いません。実用的で、あまり複雑ではない服装だと嬉しいです。\n服装のカラーイメージ：\nキャラクターA：銀白、紫、緑、黒\nキャラクターB：茶色、赤、金、白\n\nキャラクター資料：（下記URL参照）\n\nhttps://drive.google.com/drive/folders/1Xt1ffpzBitgXzWOpsgRrG0N3l4bwHRLq?usp=sharing", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Pierce_1109/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3985877, "client_id": 3796108, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/62217a01/uploads/origins/6a761208-6ac2-4e81-9881-78e36477f4ca?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=513d14e45b67aa878d2f6991f4147dcb", "srcset": "https://si.imgix.net/62217a01/uploads/origins/6a761208-6ac2-4e81-9881-78e36477f4ca?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=513d14e45b67aa878d2f6991f4147dcb, https://si.imgix.net/62217a01/uploads/origins/6a761208-6ac2-4e81-9881-78e36477f4ca?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e6eb618d202b9dee2cccab72b7c30dd8 2x, https://si.imgix.net/62217a01/uploads/origins/6a761208-6ac2-4e81-9881-78e36477f4ca?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=25925d52d60e211683ddc461b6700f4d 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/62217a01/uploads/origins/6a761208-6ac2-4e81-9881-78e36477f4ca?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=8540219f4f0eba5eb5fb6f8074a9b8f1", "srcset": "https://si.imgix.net/62217a01/uploads/origins/6a761208-6ac2-4e81-9881-78e36477f4ca?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=8540219f4f0eba5eb5fb6f8074a9b8f1, https://si.imgix.net/62217a01/uploads/origins/6a761208-6ac2-4e81-9881-78e36477f4ca?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=72cca6705ff75e1b1a6ec10513743988 2x, https://si.imgix.net/62217a01/uploads/origins/6a761208-6ac2-4e81-9881-78e36477f4ca?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=6e9a4379a6844798131d8c73c46e2e98 3x"}, "body": "ピアース先生、こんにちは！先生の画風、すごくかわいいですね！！私のオリジナルキャラクター（OC）のイラストをぜひ依頼したいです。彼らは1980年代の北米出身の、とても仲の良い親友同士なんです。\n\nA（黒くカールしたアンダーカット、かなり巻き毛！）\n率直で、荒っぽく、神経質で、情緒不安定、そして短気。自分の子犬が大好き。\n\nB（茶色の80年代風ヘアスタイル、おしゃれ）\nカリスマ的で、ドラマチック、傲慢、そして注目されるのが大好き。\n\nシナリオ\nAのシャツの中に子犬が潜り込み、首輪から頭をのぞかせ、Aの顎の下にぎゅっと抱きしめられている様子を描いてほしいです。BはAの隣にいて、手を伸ばして犬を撫でようとしています。二人ともその子犬を心から愛しています！\n\n全体として、若々しく、ちょっとおバカで、気楽な雰囲気のシーンにしたいです。ポーズや表情は自由に描いてください！\n\n価格が合わない場合は、遠慮なくキャンセルまたは再送してください。\nよろしくお願いします！\n\nhttps://imgur.com/a/WCtIw41", "nc": 1, "word_count": 0, "transcoder": "im