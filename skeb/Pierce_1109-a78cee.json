0b-9a1e-27261d0940d8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f8696d4dce5368abb09514688d8318dd", "srcset": "https://si.imgix.net/64a8b581/uploads/origins/fcfdf237-4d1d-470b-9a1e-27261d0940d8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f8696d4dce5368abb09514688d8318dd, https://si.imgix.net/64a8b581/uploads/origins/fcfdf237-4d1d-470b-9a1e-27261d0940d8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=edcfeca04d5085a2d0e3cd73b8c45c19 2x, https://si.imgix.net/64a8b581/uploads/origins/fcfdf237-4d1d-470b-9a1e-27261d0940d8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=0c678be491d6e86984239e61bb87c8dc 3x"}, "body": "こんにちは、Pierceさん！\nあなたの作品が大好きです。とても可愛らしい絵柄で、ぜひ私のオリジナルキャラクター2人のイラストをお願いしたいです。\n彼らは中世ファンタジーの魔法学院に通う見習い魔法使いです。\nキャラクターA：\n毛先が一つにまとまった長い白髪、青緑色の瞳。風魔法が得意です。平民出身ですが、どこか謎めいた雰囲気があります。ドルイドとの関わりがあるかもしれません。最初は物静かで少しよそよそしく見えますが、親しくなると少し天然で、恥ずかしがり屋で、ユーモアがあります。\nキャラクターB：\n右側に金色のメッシュが入った短い茶髪、茶金色の瞳。火魔法が得意です。貴族出身で、明るく親しみやすく、少しいたずら好きな性格です。\nシーン：\n学院内のどこかで、二人が勉強したり、おしゃべりしたり、のんびり過ごしている場面をお願いしたいです。\n関係性：\n二人が友達になり始めた頃の時期を希望します。まだとても親しいわけではなく、BがAともっと仲良くなろうとしている段階です。\n服装：\nもしよろしければ、普段着を自由にデザインしていただいて構いません。実用的で、あまり複雑ではない服装だと嬉しいです。\n服装のカラーイメージ：\nキャラクターA：銀白、紫、緑、黒\nキャラクターB：茶色、赤、金、白\n\nキャラクター資料：（下記URL参照）\n\nhttps://drive.google.com/drive/folders/1Xt1ffpzBitgXzWOpsgRrG0N3l4bwHRLq?usp=sharing", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Pierce_1109/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3985877, "client_id": 3796108, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/62217a01/uploads/origins/6a761208-6ac2-4e81-9881-78e36477f4ca?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=513d14e45b67aa878d2f6991f4147dcb", "srcset": "https://si.imgix.net/62217a01/uploads/origin