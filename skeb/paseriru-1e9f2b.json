です。\n参考画像については資料に入れさせていただきます。\n\n【雰囲気・服装等】\n今回も雰囲気、服装、構図、表情等お任せ致します。\n強いて言えば、タバコを持っていて少し暗めの雰囲気だと嬉しいです！\n\n【使用用途】\nサムネイル、Twitterでのタグ投稿画像、活動で使用させていただきたいと考えております。また、グッズ制作等を行なってもよろしければ行いたいです。難しければ大丈夫なので、レイヤーにその旨記載いただければ幸いです。\n\n【その他】\npsdファイルでいただけると幸いです。\nサムネイル等に使用したいため、髪や服をイラスト内に収めていただけるととても嬉しいです！\n\n以上長くなってしまいましたが何卒よろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/1-0PEjSKIOM99YxaOIx2MUymWYfKpi23G", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@0onamae/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1822779, "client_id": 1955090, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/476a613f/uploads/origins/5878f12a-4d18-4feb-9db4-75778c15ff77?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=560fc2c3967700332ae2937b62f1f7aa", "srcset": "https://si.imgix.net/476a613f/uploads/origins/5878f12a-4d18-4feb-9db4-75778c15ff77?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=560fc2c3967700332ae2937b62f1f7aa, https://si.imgix.net/476a613f/uploads/origins/5878f12a-4d18-4feb-9db4-75778c15ff77?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b5520082ce0307ec6a4a16e43e2ee274 2x, https://si.imgix.net/476a613f/uploads/origins/5878f12a-4d18-4feb-9db4-75778c15ff77?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=389640439da308e87d7905a83634695b 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/476a613f/uploads/origins/5878f12a-4d18-4feb-9db4-75778c15ff77?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=af035436c9f64f0607ba02f89d662160", "srcset": "https://si.imgix.net/476a613f/uploads/origins/5878f12a-4d18-4feb-9db4-75778c15ff77?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=af035436c9f64f0607ba02f89d