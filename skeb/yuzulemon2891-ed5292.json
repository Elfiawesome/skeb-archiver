e, "total_appeals_count": 0, "received_works": [{"path": "/@yuzulemon2891/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1373843, "client_id": 54482, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/18c27e76/uploads/origins/b730ab31-efa6-43f0-b72c-7e0620a64edb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7056e8f3be2b9b80e8319463ee6bdf69", "srcset": "https://si.imgix.net/18c27e76/uploads/origins/b730ab31-efa6-43f0-b72c-7e0620a64edb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7056e8f3be2b9b80e8319463ee6bdf69, https://si.imgix.net/18c27e76/uploads/origins/b730ab31-efa6-43f0-b72c-7e0620a64edb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=8ca71220ca8e3529f7dd4f1a10581343 2x, https://si.imgix.net/18c27e76/uploads/origins/b730ab31-efa6-43f0-b72c-7e0620a64edb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=6ce2fffad05bcfadc8e9fcc6ce3f6a74 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/18c27e76/uploads/origins/b730ab31-efa6-43f0-b72c-7e0620a64edb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=952695891cd0d0b5ebac41e305bc531b", "srcset": "https://si.imgix.net/18c27e76/uploads/origins/b730ab31-efa6-43f0-b72c-7e0620a64edb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=952695891cd0d0b5ebac41e305bc531b, https://si.imgix.net/18c27e76/uploads/origins/b730ab31-efa6-43f0-b72c-7e0620a64edb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=d927d662c0eb22b6e0287ee2b732d106 2x, https://si.imgix.net/18c27e76/uploads/origins/b730ab31-efa6-43f0-b72c-7e0620a64edb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=5e079898066c30500af963c78d0c6ad5 3x"}, "body": "プリコネの水着サレン調教プレイをお願いします。\n\n媚薬入りのローション風呂に浸けられ発情状態で改造済の水着を着用する、外見上は普段サレンの水着同じように、実はもう調教用衣装になる。\n\n1.黒ブラジャー部分は乳首がはみ出すくらい露出、乳首が青色水着の生地に擦れて勃起する乳首浮き。\n\nブラジャー参考：\nhttps://www.amazon.co.jp/dp/B08GPJQ5C3\n\n2.黒パンツはディルドパンツ、精液逆流防止のためにディルドパンツを水着の黒色パンツに代用しで、入っちゃった精液を排出させないのように精液封入のまま。\n\nディルドパンツ參考\nhttps://www.amazon.co.jp/dp/B07SVTPNNF\n\n3.日焼け止めクリーム代りにザーメンを全身に塗りたくられる\n\n\nサレンの水着参考：\nhttps://www.costowns.com/saren-p_4335.html\n\n\nカラーできれば嬉しいですが難しい場合はモノクロマンガみたいでも大丈夫です！\n細かいシチュ困難の部分は先生の判断で改変いただいて構いません。\n長文になってしまってすみません。よろしくお願いいたします！", "nc": 169, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@yuzulemon2891/works/5", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/8035b087/uploads/origins/a75724b9-21b3-40ba-8efc-aa7dbef1bd62?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=0c028de5f664f9b28b9ac5cdcbd3744d", "srcset": "https://si.imgix.net/8035b087/uploads/origins/a75724b9-21b3-40ba-8efc-aa7dbef1bd62?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=0c028de5f664f9b28b9ac5cdcbd3744d, https://si.imgix.net/8035b087/uploads/origins/a75724b9-21b3-40ba-8efc-aa7dbef1bd62?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=988da8b3f5b156bf7d0bc0e16a7e7458 2x, https://si.imgix.net/8035b087/uploads/origins/a75724b9-21b3-40ba-8efc-aa7dbef1bd62?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=a99bb3af691c4e6bb473529761c8392b 3x"}, "private": true, "genre": "art", "tipped": false, "creator_id": 1373843, "client_id": 54482, "nc": 160}, {"path": "/@yuzulemon2891/works/4", "private_t