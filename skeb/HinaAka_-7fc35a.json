ath": "/@Kiiko_clip/works/1612", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1688710, "client_id": 2548705, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/3f4eb862/uploads/origins/79432ab6-b3b3-49d9-83ed-7d31b2a196af?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5d46beaf8943f8916581c9d612e5cbd1", "srcset": "https://si.imgix.net/3f4eb862/uploads/origins/79432ab6-b3b3-49d9-83ed-7d31b2a196af?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5d46beaf8943f8916581c9d612e5cbd1, https://si.imgix.net/3f4eb862/uploads/origins/79432ab6-b3b3-49d9-83ed-7d31b2a196af?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=642066b112e300807b14305044fbb34c 2x, https://si.imgix.net/3f4eb862/uploads/origins/79432ab6-b3b3-49d9-83ed-7d31b2a196af?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=35d29dac529e44500747756443ca66eb 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/3f4eb862/uploads/origins/79432ab6-b3b3-49d9-83ed-7d31b2a196af?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=8d8ef2f89fb86a5ce73d13c2893ebae9", "srcset": "https://si.imgix.net/3f4eb862/uploads/origins/79432ab6-b3b3-49d9-83ed-7d31b2a196af?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=8d8ef2f89fb86a5ce73d13c2893ebae9, https://si.imgix.net/3f4eb862/uploads/origins/79432ab6-b3b3-49d9-83ed-7d31b2a196af?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=8ae0bf89264c7efa0c3b5c0c2c86763b 2x, https://si.imgix.net/3f4eb862/uploads/origins/79432ab6-b3b3-49d9-83ed-7d31b2a196af?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=0bfbc1eca9ebe44933f32c8d7b41cb47 3x"}, "body": "KiiKo様。こんにちは。\n\n前回は素敵なイラストをありがとうございました。とても気に入っております。\n\n今回は、友達のOC・小鳥遊雛瀬と、私のOC・七海あかねを終わりのセラフのアニメ画風に描いて頂きたいです。\n\n【関係性】\n・お互いにとって初めての友達、唯一の友達\n・仲の良い双子のような存在\n\nこの2人は小鳥遊雛瀬の住む、ある屋敷で出会いました。しかし、1週間程で屋敷から出て行かなければなりませんでした。その後、七海あかねが戦死してしまい、二度と会えない状況になります。1週間程しか一緒に居られませんでしたが、とても仲の良い2人です。\n\n今回は下記リンクを参考に、「小鳥遊雛瀬の部屋で恋バナをしている2人」を描いて頂きたいです。\n\n【小鳥遊雛瀬】\n・あまり話すのが上手ではない\n・屋敷の主に恋をしているが、屋敷の主はあまり屋敷に帰って来ない\n・屋敷の主は、感情をなくした人外だが、人間に興味関心を持ち、美しい物、美しい少女、少年を好んでいる\n・小鳥遊雛瀬は、屋敷の主の、\"お気に入りのお人形さん\" 的な存在\n\n【七海あかね】\n・一緒に屋敷に来た仲間に恋人がいる\n・恋人の事を一途に愛している\n・恋人は七海あかねの事をとても愛おしく思っているが、事情があり1番に優先することが出来ない\n\n【表情】\n・楽しそうに\n・恋バナをしているので頬を赤くしている\n\n服装はリンク先にあるルームウェアでお願いします。\n\n描写範囲・構図は金額に合わせてお任せします。\n\n⚠︎小鳥遊雛瀬の黒子、ピアスを忘れないようにお願いいたします。\n\nよろしくお願いいたします。\n\nhttps://www.dropbox.com/sh/707t0hbjeuj7j51/AAA4vZLmuRTzYEHTZZg4pr7Ba?dl=0", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@shiiro_illust/works/13", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1431467, "client_id": 2548705, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/e92b62ad/uploads/origins/0a47f068-be39-420a-893b-643b35f55780?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1a5af7cd9a014468974367d4794f6ed3", "srcset": "https://si.imgix.net/e92b62ad/uploads/origins/0a47f068-be39-420a-893b-643b35f55780?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1a5af7cd9a014468974367d4794f6ed3, https://si.imgix.net/e92b62ad/uploads/origins/0a47f068-be39-420a-893b-643b35f55780?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=7147da161591cc2f4aa4a2566e8f45eb 2x, https://si.imgix.net/e92b62ad/uploads/origins/0a47f068-be39-420a-893b-643b35f55780?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=8892a68c9fca32d18ea29762451bc61d 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/e92b62ad/uploads/origins/0a47f068-be39-420a-893b-643b35f55780?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=84deb23f4bea2179d96c867d9dd88a73", "srcset": "https://si.imgix.net/e92b62ad/uploads/origins/0a47f068-be39-420a-893b-643b35f55780?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=84deb23f4bea2179d96c867d9dd88a73, https://si.imgix.net/e92b62ad/uploads/origins/0a47f068-be39-420a-893b-643b35f55780?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=dfe80da4564e67a334d68b69b897d4b1 2x, https://si.imgix.net/e92b62ad/uploads/origins/0a47f068-be39-420a-893b-643b35f55780?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=45415e3ef46d0eba3ec9a415b64f6faa 3x"}, "body": "しいろ様。こんにちは。\n\n宜しければ、「OC2人の全身デフォルメイラスト」を描いて頂きたいです。\n\n【OCについて】\n・OC①…小鳥遊雛瀬\n・OC②…七海あかね\n\n【構図】\n顔、体共に正面を向いて、正面側の手を握りあっているような構図\n\n【髪型】\nリンク先の髪型資料を参考にお願いします\n\n【目】\n瞳孔をハートの形にお願いします\n\n【服装】\n・リンク先のメイド服➕靴 (お揃い)\n・OC①のツインテールに白いリボン\n・OC②の三つ編み部分に白いリボン\n(リンク先を参考に)\n\n【背 景】\n・赤い薔薇と白い薔薇で円を作るようにしたもの(キャラを囲むように)\n・赤い薔薇と白い薔薇が7:3になるように配置\n・主背 景は白\n\n【小物】\nOC2人の傍にリンク先のようなぬいぐるみをそれぞれ置いて頂きたいです。\nOC①の傍…白いウサギのぬいぐるみ\nOC②の傍…黄色いウサギのぬいぐるみ\n\n表情はお任せします。\n\nお手数おかけしますが、予算が足りなければ再要請お願いします。\n\nよろしくお願いいたします。\n\nhttps://www.dropbox.com/sh/s4e33cmvi3ie98e/AACOI5fYm9pMKBh4LSL-Wpuba?dl=0", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}], "similar_creators": [{"id": 105538, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "蟹江", "screen_name": "metyayurusu", "avatar_url": "https://pbs.twimg.com/profile_images/1607625673048477697/N-HO6Aj3.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1027539084074307584/1751106210/1500x500", "appeal_receivable": false, "popular_creator_rank": 87, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 90, "skills": [{"genre": "art"