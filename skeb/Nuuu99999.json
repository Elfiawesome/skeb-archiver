on", "default_amount": 1500}], "acceptable_only_public": false, "tip_acceptable": true, "yearly_report_client_visible": false, "total_appeals_count": 0, "received_works": [{"path": "/@Nuuu99999/works/115", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3053281, "client_id": 0, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/630cbecc/uploads/origins/2b6174f1-d7c9-4477-b698-5cdb6efdd9eb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8554a10a206acaf95ba02bd30fb2e10f", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/630cbecc/uploads/origins/2b6174f1-d7c9-4477-b698-5cdb6efdd9eb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=33aaf180a7141a3c0e7f86bf749b9e98", "src_set": ""}, "body": "はじめまして。\nリクエスト失礼します。\n\n▪キャラクター\n　‣ 呼延灼 [FGO]\n\n▪衣装\n　‣ 水着\n　　https://pbs.twimg.com/media/GyR-OIja4AEQBK2?format=png&name=900x900\n　　参考画像よりも水着の布面積を小さくしてください。\n　　水着のサイズが合っておらず、胸やおまんこに食い込んでいる感じにしてください。\n　　腕の装飾などの複雑な個所の描写は簡易的にしていただいても構いません。\n\n▪シチュエーション\n　‣ 暴走した呼延灼に襲われるマスター\n\n▪構図/体勢\n　右側に立ち絵、左側にセックスシーンの構図でお願いします。\n　https://www.pixiv.net/artworks/133608651\n　‣ 立ち絵\n　　・嬉しいけど恥ずかしそうな表情\n　　・しっかりと水着を着ているが乳輪や陰毛や小陰唇がはみ出ている状態\n　‣ セックスシーン\n　　・目をハートにして発情したような表情\n　　・水着がずれて乳首やおまんこが丸見えの状態\n　　・ちんぐり騎乗位\n　　・男性の主観視点\n　　・受精描写\n　　処女喪失と膣内射精によっておまんこから精液と血液と愛液が溢れている感じにしてください。\n\n▪体形\n　‣ 巨乳輪\n　‣ 黒乳首\n　‣ グロマン\n　‣ 筋肉質\n　　可能であればバキバキに割れた腹筋をお願いします。\n\n▪体毛\n　‣ 陰毛\n　‣ 腋毛\n　もし余裕があれば乳首の毛と太ももやすねなどの下半身の毛もお願いします。\n　https://www.pixiv.net/artworks/98052114\n\n▪セリフ\n　‣ 立ち絵側(右側)\n　　<呼延灼>\n　　　「マスター！いかがですか！？私の水着姿！」\n　　<マスター>\n　　　「はは...い、良いんじゃないかな？個性的で...！」\n　‣ セックスシーン側(左側)\n　　<呼延灼>\n　　　「マスターが私の水着姿褒めてくれた！私のこと好きって言ってくれた！」\n　　<マスター>\n　　　「言ってない！言ってないから！落ち着いて！」\n　　<呼延灼>\n　　　「私もマスターのことが大好きです！今すぐ結婚しましょう！子供は何人欲しいですか！？」\n　　<マスター>\n　　　「待って！聞いて！」\n　セリフは追加・削除・変更していただいて構いません。\n\n何卒ご検討のほどよろしくお願いします。", "nc": 177, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Nuuu99999/works/114", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/a0cf24bc/uploads/origins/6d189627-6fff-452f-a7e0-85b508da3f1c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=01fdf2ae0f278b5507395200b718574a", "src_set": ""}, "private": true, "genre": "art", "tipped": false, "creator_id": 3053281, "client_id": 0, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 49, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@Nuuu99999/works/113", "private_thumbnail_image_urls": null, "private": false, "genre": "comic", "tipped": false, "creator_id": 3053281, "client_id": 0, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/3d899520/uploads/origins/87537666-034d-49d9-81b8-2d82c723f75a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=06efb69a5b0e8a9c4bf4406dbd820827", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/3d899520/uploads/origins/87537666-034d-49d9-81b8-2d82c723f75a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a62f3cac8e7a9fd85dd1e04f3deb2b7f", "src_set": ""}, "body": "催眠術シリーズの古橋涼菜と桜井佐和のコミックをお願いいたします。\n\n以下内容\n\n(参考URLの以前の作品の流れから)涼菜の変貌ぶりを心配した上司の佐和が古橋家を訪ねるも、主人公の手中に落ちてしまい、自身も主人公に仕える奴隷の1人となってしまうという内容でお願いいたします。\n\n入れていただきたいシーンとしては「意志の強い佐和を催眠術と性的快感によって思考改変し、最愛の存在を息子から主人公へと置き換えられてしまう過程」と「特注のエロメイド服に身を包んだ涼菜と佐和がガニ股ワキ見せポーズを取って主人公に忠誠を誓う場面」をお願いいたします。\n\n涼菜は常時催眠状態のため、常に虚ろ目。佐和は催眠深度が深まるほどに虚ろ目になるようにしていただければと思います。\n\nまた、奴隷になってからは涼菜は佐和を呼び捨て＆タメ口、逆に佐和は涼菜をお姉様呼び＆敬語という感じで上下関係を逆転させていただきたいです(可能であれば、今まで通りの接し方をしようとした佐和を涼菜が叱って教育するシーンも入れていただきたいです)。\n\nその他のシチュエーションや服装、ポージングなどは先生にお任せしたいと思います。\n\nお忙しいかと存じますがよろしくお願いいたします。\n\n桜井佐和の参考画像\nhttps://www.blackrainbow.jp/br/jutsu2/chara01.html\n\nhttps://skeb.jp/@Nuuu99999/works/60", "nc": 168, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Nuuu99999/works/112", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/1747b335/uploads/origins/241384cb-6d4c-4546-816b-61887c90e131?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=4e2f738ec8e9e5113850b6ab60ba9857", "src_set": ""}, "private": true, "genre": "art", "tipped": false, "creator_id": 3053281, "client_id": 0, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 32, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@Nuuu99999/works/111", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3053281, "client_id": 1472629, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/3bba9e21/uploads/origins/32529215-7b3c-4c79-b8f8-847369848f6e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d93b3bdda3ce8fd02a68312ee04a29e0", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/3bba9e21/uploads/origins/32529215-7b3c-4c79-b8f8-847369848f6e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d48665f1092578afa7c2ff92d513898d", "src_set": ""}, "body": "リクエストさせてください\n\nFGOの光のコヤンスカヤを第1再臨のライダースーツのような状態で画面手前のこちらに首輪をつけようとするか、つけた後に鎖を引っ張っているような構図で描いていただけないでしょうか   \n\nご検討よろしくお願いします", "nc": 160, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Nuuu99999/works/110", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3053281, "client_id": 0, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/e510dd31/uploads/origins/a7fd6090-509d-408e-9042-6c28ed5f0217?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fe669b069aae60d47bf4d918321f5fbc", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/e510dd31/uploads/origins/a7fd6090-509d-408e-9042-6c28ed5f0217?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=611989b1bc8b6acabba8d547a30041cb", "src_set": ""}, "body": "はじめまして。\nいつもイラストを拝見させていただいております。\nもしよろしければと思い、リクエストさせていただきました。\nリクエストの内容としては以前、描かれていたバニー or 佐藤先生の描きやすい再臨(簡易で構いません)のモルガン陛下のイラストをお願い出来ますでしょうか？\n構図については、見下ろす感じ(アオリ)で表情は挑発的か冷たい感じだと嬉しいです。\nその他の細かな仕様は、佐藤先生のお好きなもので大丈夫です。\n\nご検討のほど、よろしくお願いいたします。", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Nuuu99999/works/109", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3053281, "client_id": 0, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/c73b5d7c/uploads/origins/adfe174d-a700-46c7-bd4c-55fb967ce733?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2b7713318a9d914fb370d7c6eba0f605", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/c73b5d7c/uploads/origins/adfe174d-a700-46c7-bd4c-55fb967ce733?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=afebe229e712dc6aead26193afcf220d", "src_set": ""}, "body": "はじめまして\n\nインスピレーションが降りてきたのと他の方のご依頼に沿ったシチュエーションのイラストが素晴らしいので依頼させていただきます\n\n依頼内容ですが\n\nにじさんじ所属 Vtuber 『町田ちま』様が夏らしい涼しげなワンピース(新デフォルト衣装に近い白っぽく水色のラインが入っていて簡素な感じで大丈夫です)急に家に来襲してきて玄関先でいきなり「海行こ！！準備して」と言い出し\n応対した知り合いの年上の男の人(セリフのみの描写でも大丈夫ですが袖は無いです)が「え〜〜、いきなりすぎない…？」と困っていたら、町田様がイタズラげに微笑むと自らワンピースを豪快に胸上まで捲り上げる。ワンピースの下には何も身に付けておらず僅かに生え揃ったアンダーヘアが見てとれる裸体。\nすっかり見蕩れていたのをバッチリ確認した町田様はニヤニヤしながら「あれだけマジマジと見たんだから海行き決定ね♡」と嬉しげにからかうように微笑む\n\nこの感じにお願いしたいと思ってます\n\nご検討よろしくお願いいたします。", "nc": 33, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Nuuu99999/works/108", "private_thumbnail_image_urls": null, "private": false, "genre": "comic", "tipped": true, "creator_id": 3053281, "client_id": 0, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/569965cb/uploads/origins/97e76e1a-bafe-4042-9ca4-09ec566d91a6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b0082d9a9818be49f3e103175588ce7f", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/569965cb/uploads/origins/97e76e1a-bafe-4042-9ca4-09ec566d91a6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=4d53559f4e66b9486becdac0728ecc99", "src_set": ""}, "body": "またFGOのリクエストを出させていただきたいです。(もしお忙しくて不可でしたらキャンセルお願いします。)\n\n■おおまかなシチュエーション\nこちらが書いたSS(https://www.pixiv.net/novel/show.php?id=25425129)の漫画化で、\n自身のシャドウサーヴァント達(下半身のみ男体化)に陵辱されるゼノビア・・・というシチュで。\n\n■細かい点\n・キャラは全員巨乳で、腋毛・陰毛は無しで。シャドウゼノビアは途中から玉『有り』ふたなりでお願いします。\n\n・衣装に関してはゼノビアは第2再臨をベースに髪飾り＋黄金の腕輪・足輪以外は全裸で。\n\nシャドウゼノビアはhttps://www.pixiv.net/artworks/133088383の8枚目のように全身漆黒の全裸＋金の髪飾り＋腕輪・足輪着用で。途中から下半身のみ筋肉質に男体化させるようにお願いします。(ゼノビアのトラウマを抉るように、ローマ男兵士の下半身に変質しているイメージで)\n\n・全体的な表情は、ゼノビアは抵抗しようとするも快楽にあっさりと負けてしまうような感じで。\nシャドウゼノビア達は、↑のように目元に影が掛かっている＋言葉を発する時以外は口を閉じていて終始無表情な感じで。\n\n希望シチュとしては、①ゼノビア、へたり込んだ状態で背後から乳揉み＋正面から手マンされる。\n\n②シャドウゼノビア達、下半身男体化。1体が見せ槍し、ゼノビアはそれから目を離せないといった感じ。\n\n③正常位挿入。周囲のシャドウ達、『イけ』 『往け』 『逝け』とセンズリしながら無表情で呪言を唱え続ける。\n\n④ゼノビア、中出しを懇願。そのまま中出し＆周囲からぶっかけられて絶頂。\nゼノビアは敗北したメス顔で、シャドウゼノビアは上半身を仰け反らせながら射精するも無表情のままな感じで。\n\n・台詞運びはSS本文を参照する感じでお任せします。\n\n以上、長くなってしまいましたがご検討の程よろしくお願いします。", "nc": 41, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Nuuu99999/works/107", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3053281, "client_id": 872789, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/0c3a4016/uploads/origins/a1a8076d-4bcb-470f-9666-7e12ec4caa60?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ec25e88cc8e1c085b5af9791bb9b1f71", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/0c3a4016/uploads/origins/a1a8076d-4bcb-470f-9666-7e12ec4caa60?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=215f147544f32c1a5fa0b11225b9eacc", "src_set": ""}, "body": "Hello. Please draw an erotic scene with my character, Ceres. Ceres is a gorgon graffiti artist. All details are left up to you. Please use any of the hair styles in the reference material.\n\nhttps://catbox.moe/c/eqo6ce", "nc": 49, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Nuuu99999/works/106", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/1f5d114f/uploads/origins/c24dbeba-cc81-4c80-bab9-8f689137f88e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=ff26b8b99d32a7293733468cb5581606", "src_set": ""}, "private": true, "genre": "art", "tipped": false, "creator_id": 3053281, "client_id": 1386876, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 177, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@Nuuu99999/works/105", "private_thumbnail_image_urls": null, "private": false, "genre": "comic", "tipped": false, "creator_id": 3053281, "client_id": 1953120, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/21c1862f/uploads/origins/d8fcdeb0-4667-41c5-a80c-e15dd85ae8a1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e164319b61c472e2f276b07806ae86ab", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": true, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/21c1862f/uploads/origins/d8fcdeb0-4667-41c5-a80c-e15dd85ae8a1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=4151182030a6b9fc1f33400731a8f2b2", "src_set": ""}, "body": "初めまして！リクエストお願いします！ハードな男ものなのでジャンル違いでしたらキャンセルして頂いて大丈夫です!\n\n拷問バイトくんの日常のシウがいつもの業務の拷問中に相手のモブが椅子の拘束を解いてしまい襲い掛かられ好き放題に滅茶苦茶に犯されイカされて最後にはシウが全裸で椅子に拘束され気を失っている救いようのない物語が見たいです\n\nシウは基本気が強くて怖そうな人ですが面倒見が良く、仕事に実直な関西弁のような言葉を使うキャラです。\n\n話の流れ\n①いつも通り仕事でムチなどを使い情報を絞り出すため拷問している\n↓\n②椅子の拘束が甘かったのか相手が拘束を解いてしまい襲い掛かられ組み倒される\n↓\n③着衣が破かれ無理矢理様々な体位で犯される（どんどん服は破けていく感じで）（防音室のため声は届かない）最終的にはドクドク注がれる感じで\n↓\n④セロが「遅いなどうしたんだろ...」と様子見に部屋を開けると既に相手は逃げており、全裸で椅子に拘束され武器であるムチを使われた形跡があり、全身精液まみれ事後状態で気を失っているシウの姿、それを見たセロが「シウ..さん..?」と何を目撃したのかわからない描写でＥＮＤ\n\n参考資料\nhttps://drive.google.com/drive/folders/15A5C7WslkW87WyXqhQlpNWQ3yxvhs4oy?usp=sharing\n※参考体位の中から何種類か選んで頂いて描いて頂きたいです（フルネルソンは必ず入れていただきたいです）\n\n【入れてほしい要素】\n・3～４枚くらいの漫画で描いていただきたいです\n・ヤバいみたいな焦っている、悔しそうな顔でずっとビクビク快楽を感じさせられているので喘がされ勃っててほしいです。\n・セリフや擬音など入れてほしいです。\n・本人であることが証明できるように参考資料のような少し筋肉ついてる細身の長身、髪型、目元の入れ墨、ピアスなどお願いします。\n・精液は多めでおねがいします。（ぶっかけてもらって大丈夫です）\n・モブは顔なくて大丈夫です、\n・傷や涙、などの描写があっても大丈夫です。\n・分かりにくい点などありましたらお手数ですがおまかせいたします。\n\n普段か描かれているジャンルと違うと思いますが、ご一考頂ければ幸いです。\n（もし金額に見合わないと考えて頂けるのであれば再送して頂きたいです）", "nc": 170, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Nuuu99999/works/104", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3053281, "client_id": 617835, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/f3c19be8/uploads/origins/60ab9cd7-ec73-4a96-878e-e4d7b2243c87?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2d63fea1696455cdc2129941ce606026", "src_set": ""}, "duration": null, "nsfw": true, "hard