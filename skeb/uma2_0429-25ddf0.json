g=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c4f6a22d2179f1dc5d4593e14584652a, https://si.imgix.net/0108ad5c/uploads/origins/6e5437b8-5494-42b1-8ffc-1b873f850240?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=78755f747bd0d06abf395668930206ab 2x, https://si.imgix.net/0108ad5c/uploads/origins/6e5437b8-5494-42b1-8ffc-1b873f850240?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=ea6f97dfc88ba85b0d2f9c8785dce5ea 3x"}, "body": "こんにちは！前回描いていただいた作品がとても気に入ったので、またリクエストさせてください！このキャラクター、ナディアを描いていただけると嬉しいです。詳しい参考画像がなく、見た目のイメージも断片的なものしか持っていないので、難しいリクエストになってしまって申し訳ありませんが、ぜひあなたのスタイルで彼女を描いてみたいのです。参考までに、私のプロフィールにある最新の写真が彼女なのですが、その写真では怒っているため、髪型がいつもと違います。 分かりにくいかもしれないので補足しますが、彼女の髪は「雲でできている」のであって、単に雲のように見えるだけではありません。描き方はお任せしますが、ぜひ笑顔のナディアを描いてください！よろしくお願いします！！ https://imgur.com/a/zuDvJpk", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@uma2_0429/works/11", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3331781, "client_id": 2107959, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/cdd48926/uploads/origins/3ce9c260-7a96-4f91-87b4-0bf523d05921?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c0e65b55cfd0c251bbd551deaff819b3", "srcset": "https://si.imgix.net/cdd48926/uploads/origins/3ce9c260-7a96-4f91-87b4-0bf523d05921?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c0e65b55cfd0c251bbd551deaff819b3, https://si.imgix.net/cdd48926/uploads/origins/3ce9c260-7a96-4f91-87b4-0bf523d05921?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=065d86a5b284e3af17406d945d87be03 2x, https://si.imgix.net/cdd48926/uploads/origins/3ce9c260-7a96-4f91-87b4-0bf523d05921?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=7a8389deefe7537bdf1c1caa6c215a66 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/cdd48926/uploads/origins/3ce9c260-7a96-4f91-87b4-0bf523d05921?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d0c7709f5a035ded228a60a347ffbdc9", "srcset": "https://si.imgix.net/cdd48926/uploads/origins/3ce9c260-7a96-4f91-87b4-0bf523d05921?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d0c7709f5a035ded228a60a347ffbdc9, https://si.imgix.net/cdd48926/uploads/origins/3ce9c260-7a96-4f91-87b4-0bf523d05921?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=327a56aba2c3e9946205aed9bbf459c6 2x, https://si.imgix.net/cdd48926/uploads/origins/3ce9c260-7a96-4f91-87b4-0bf523d05921?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=0a117aa9152cb204ef55c23c91f43d8b 3x"}, "body": "「Black Sheep Town」の灰上姉妹の一人を描いてお願いします！\n\nポーズはあぐら座りで、腕はまっすぐにして膝の上に置いてください。姿勢は背筋を伸ばし、肩は少し上げた状態でお願いします。\n無表情または笑顔で、こちらに気づいたような軽い驚きのある表情でお願いします。\nグレーのオフショルダーセーターでブラの肩ひもが見える服装、下は黒のスカートまたはドルフィンショートパンツでお願いします。\n姉妹は目が金色に変えられる。金色の目が見えるのバージョンをお願いします。\n他を任せます。\n\n参考資料が下で付けてしました。灰上姉妹は一卵性双生児ですから二人で違いがありません。\n\nよろしくお願いします！\n\nhttps://drive.google.com/drive/folders/1vqJr0lyHParVtGXtFkuJDGqbIKrV50oJ?usp=sharing", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@uma2_0429/works/10", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3331781, "client_id": 405731, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/75e51fc3/uploads/origins/2ab6d3ec-f01f-44d2-a52e-b6605a85aad9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6ce279801b96e1563c25be6a2c5dddc1", "srcset": "https://si.imgix.net/75e51fc3/uploads/origins/2ab6d3ec-f01f-44d2-a52e-b6605a85aad9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6ce279801b96e1563c25be6a2c5dddc1, https://si.imgix.net/75e51fc3/uploads/origins/2ab6d3ec-f01f-44d2-a52e-b6605a85aad9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a82aad367d58f1910d5d0fbd1a5a7b5d 2x, https://si.imgix.net/75e51fc3/uploads/origins/2ab6d3ec-f01f-44d2-a52e-b6605a85aad9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=35d141d08abe3e557d13b8bc7489d23b 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/75e51fc3/uploads/origins/2ab6d3ec-f01f-44d2-a52e-b6605a85aad9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=49dc6dde16d6076a8f019189ae1a64c2", "srcset": "https://si.imgix.net/75e51fc3/uploads/origins/2ab6d3ec-f01f-44d2-a52e-b6605a85aad9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=49dc6dde16d6076a8f019189ae1a64c2, https://si.imgix.net/75e51fc3/uploads/origins/2ab6d3ec-f01f-44d2-a52e-b6605a85aad9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=347cb9ecf5a277d062cca84fc4345c35 2x, https://si.imgix.net/75e51fc3/uploads/origins/2ab6d3ec-f01f-44d2-a52e-b6605a85aad9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=b072e7e81aef3181013f2a2878c60d38 3x"}, "body": "はじめまして、Twitterで素敵な作品を拝ませて頂いています！\n跳ね回るようにコロコロ変わる豊かでカワイイ表情、ダークな雰囲気の中に差し込まれる鮮やかで印象的なネオンカラーの表現に惹かれています。\n私もぜひ一枚お願いしたいと思い依頼させていただきます。\n\nリクエストですが、バーカウンターに立ったステイゴールドがスイープトウショウにドリンクを振る舞うシーンをお願いします。\nスイープの服装はおまかせしますが、ステイゴールドは制服以外の勝負服風またはバーテンダー風の衣装でお願いします。\n\n二人はトウショウビクターという産駒を生み出した史実夫婦です。\n直接対決のなかった二人がどんなふうに絡むか空想していたところ、旅の思い出や見聞をカクテルを通じて共有してるとエモいなと思い立ちこのリクエストにしました。(スイープは調合とか綺麗な液体好きそうだなというイメージもあります)\n\nぜひご承認のほどよろしくお願いします！", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@uma2_0429/works/9", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 33