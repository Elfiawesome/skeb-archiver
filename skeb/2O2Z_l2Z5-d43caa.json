rop=top&w=200&h=200&blur=200&s=d5449522b19c4755d6aec588f2bcb30f 3x"}, "body": "ゆんちゃん様初めまして．\n目の大きさや目下から顎までの長さなど，絵柄が好みなのでぜひコテキャをお願いしたいです．\n\n【容姿】\n黒髪．長い前髪を左右に分けて額を出している．髪型はストレート，ハーフアップ，耳下のお団子など．\n瞳はグレー．まつ毛が長い．向かって右下の顎にホクロがある．\nモチーフ：白いウサギ\nイメージカラー：ベビーブルー\n【性格】\nおっとり系で素直な箱入り娘．好意は率直な言葉で伝える．強情で負けず嫌い故の努力家．\n昔は成績が良かったが，高校大学と進級するごとに真ん中の成績順位に落ちていて焦っている．\n【要望】\n頭頂部が見切れない構図だとアイコンにしやすいので助かります．\n\n色々画像入ってますが，簡略化/アレンジOKです．\nhttps://drive.google.com/drive/folders/1layFS-PoyJ08uaxjBnb5L84gVE8NF26y\n\nhttps://drive.google.com/drive/folders/1layFS-PoyJ08uaxjBnb5L84gVE8NF26y", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@2O2Z_l2Z5/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1737485, "client_id": 3438651, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/1b1de5fe/uploads/origins/3e567bcd-79e8-44dc-b4d4-882171359654?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=317090b9cc65218f4c80f8ced264735f", "srcset": "https://si.imgix.net/1b1de5fe/uploads/origins/3e567bcd-79e8-44dc-b4d4-882171359654?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=317090b9cc65218f4c80f8ced264735f, https://si.imgix.net/1b1de5fe/uploads/origins/3e567bcd-79e8-44dc-b4d4-882171359654?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e054defcdf1dfb537f46022e2aba44bf 2x, https://si.imgix.net/1b1de5fe/uploads/origins/3e567bcd-79e8-44dc-b4d4-882171359654?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=8ea569eb4c8fe38a723a7c1ff49571dd 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/1b1de5fe/uploads/origins/3e567bcd-79e8-44dc-b4d4-882171359654?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=265e8bb44f5e8689cf332373158d7a3c", "srcset": "https://si.imgix.net/1b1de5fe/