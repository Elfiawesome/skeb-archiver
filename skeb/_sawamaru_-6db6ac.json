.com/wiki/Elia_Stellaria/Gallery", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@_sawamaru_/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2874843, "client_id": 2548796, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/b2d73b61/uploads/origins/bb7c89ae-53bb-4339-a0f0-6fcdac4d9536?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5c3073228eeee060d7c2af49c9c7263e", "srcset": "https://si.imgix.net/b2d73b61/uploads/origins/bb7c89ae-53bb-4339-a0f0-6fcdac4d9536?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5c3073228eeee060d7c2af49c9c7263e, https://si.imgix.net/b2d73b61/uploads/origins/bb7c89ae-53bb-4339-a0f0-6fcdac4d9536?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=99a4aa16058b7ba7bde2dcf8187927e4 2x, https://si.imgix.net/b2d73b61/uploads/origins/bb7c89ae-53bb-4339-a0f0-6fcdac4d9536?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=6029ea1fe82e1e097d52bd71c5b235f3 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/b2d73b61/uploads/origins/bb7c89ae-53bb-4339-a0f0-6fcdac4d9536?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=dcb9c634d6da1fe1aa689f0beaedb81a", "srcset": "https://si.imgix.net/b2d73b61/uploads/origins/bb7c89ae-53bb-4339-a0f0-6fcdac4d9536?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=dcb9c634d6da1fe1aa689f0beaedb81a, https://si.imgix.net/b2d73b61/uploads/origins/bb7c89ae-53bb-4339-a0f0-6fcdac4d9536?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=688744a56d88512393d133283d781b3d 2x, https://si.imgix.net/b2d73b61/uploads/origins/bb7c89ae-53bb-4339-a0f0-6fcdac4d9536?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=6b242d1ab462fb7222847ffca3c981a2 3x"}, "body": "はじめまして、崩莎心和と申します。\n爽丸様のイラストを拝見し、素敵な絵柄に惹かれ\n依頼を受けていただけないかと思いご連絡です。\n\n◆自己紹介\n普段Twitchで活動を行っているVLiverです。\n双子で活動を行っており元気っ子系の女の子心和(ここわ)おっとり系男の子心和(しんわ)の2人で活動しております。\n\n◆依頼内容\nいただきたい人数は2人で、ハロウィンぽい感じでお願いしたいです。\n男の子：狼さん\n女の子：赤ずきん\n\n※女の子のツインテ部分はエクステリングになっています。\n※頭巾ですが被せても被せなくても大丈夫ですが、被せるとエクステリングが大変なことになってしまうと思いますのでその場合はお団子でも大丈夫です!\n※サムネ等に使用させていただきたいため、頭が切れないように描いていただければ幸いです。\n\n◆使用用途\nSNS/配信/サムネイル/宣伝活動/グッズ(返礼品/ネットプリント/suzuriなど)で使用予定ですので使用許可をいただければ幸いです。\n\n◆納品形式\n可能であればPSDデータでいただきたいです。\n(女の子/男の子/背景)と分かれていると嬉しいです。\n\n◆参考資料\nTwitterの固定を参照ください。\nhttps://twitter.com/Kuzusya_sib/status/1647945102248255489?s=20\n\nhttps://twitter.com/Kuzusya_sib/status/1647945102248255489?s=20", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@_sawamaru_/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2874843, "client_id": 2897629, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/174e3e2c/uploads/origins/80d59798-e54d-40ca-a7e7-c5881e65940b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b408da5c143e5ba2bca49c239acdef53", "srcset": "https://si.imgix.net/174e3e2c/uploads/origins/80d59798-e54d-40ca-a7e7-c5881e65940b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b408da5c143e5ba2bca49c239acdef53, https://si.imgix.net/174e3e2c/uploads/origins/80d59798-e54d-40ca-a7e7-c5881e65940b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=48525db3d4ab4eb8310a3467145beb74 2x, https://si.imgix.net/174e3e2c/uploads/origins/80d59798-e54d-40ca-a7e7-c5881e65940b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=39eb3c1dfed87150928c16e9c7482936 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/174e3e2c/uploads/origins/80d59798-e54d-40ca-a7e7-