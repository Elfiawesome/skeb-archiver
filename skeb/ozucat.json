-443d-b66e-baade793140e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5ab9e3aa0a02d1bc6b3cb2bd58372b9b", "src_set": ""}, "body": "前回は呂布のイラストをありがとうございます。また依頼させていただきます。\n\n遊戯王OCGより、黒魔女ディアベルスターをリクエストさせていただきます。（URL参照　https://x.com/YuGiOh_OCG_INFO/status/1682359770806915072\nhttps://x.com/YuGiOh_OCG_INFO/status/1676927725960073216）\n\n背景やポーズなどはお任せします。\n胸はOZ猫さんの描くレジーさん位の大きさでお願いします。身体つきは筋肉質な感じでお願いします。\n差分でマスクとフード無しをお願いします。\n表情は不敵な笑みをしている感じでお願いします。\n\nよろしくお願いいたします。", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@ozucat/works/124", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 994750, "client_id": 1947295, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/e528e6aa/uploads/origins/48216ba5-0e70-4b76-a38a-3d2e00309613?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5f128bdfd42eb54fc51a69d3ba06ab31", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/e528e6aa/uploads/origins/48216ba5-0e70-4b76-a38a-3d2e00309613?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=52552506624b8f187f2847045347bbac", "src_set": ""}, "body": "こんにちは！\n\nタカオのレースクイーンの衣装を着たキツネ娘のユウキの絵をお願いしたいです。\nあとはお任せしますが、ポーズはセクシーというよりクールな感じでお願いします。\nよろしくお願いします、\n\nアフターBRNR\n\nhttps://imgur.com/a/wrabtVh", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@ozucat/works/123", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 994750, "client_id": 0, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/63df09b6/uploads/origins/e4e854bd-41bd-419d-9ef8-031491fa4a6b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a56a07d51fe0b0fe8a47eb45104d084e", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/63df09b6/uploads/origins/e4e854bd-41bd-419d-9ef8-031491fa4a6b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=183b8589e0588f8e4ee56d3234971e64", "src_set": ""}, "body": "初めましていつもイラスト拝見させて頂いております。\nリクエスト失礼します。\nアクション対魔忍に登場する桃知凪のイラストをお願いします。\n・衣装は秋山凜子の対魔忍スーツ\n・構図はこちらの画像の凜子と同じようなポーズと表情で、右手は参考画像とは違い刀を持っているのではなく、右足の太ももに添えるような構図でお願いします。\n参考画像:https://drive.google.com/drive/folders/1-2dacOimbUTDmV3d_Oz3JgXGZWY2-Fup\nご検討お願い致します。", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@ozucat/works/122", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 994750, "client_id": 0, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/2c43dc0f/uploads/origins/2fda171e-fb62-4fd9-801e-7e4c5be2afee?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9b231c91094e1c2f3249ada565f406af", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/2c43dc0f/uploads/origins/2fda171e-fb62-4fd9-801e-7e4c5be2afee?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=4c62328378a0992a0c7747bdec433b7e", "src_set": ""}, "body": "新年明けましておめでとうございます。\n今年もよろしくお願いします。\n前回、ティアーユさん(https://skeb.jp/@ozucat/works/116)の素晴らしい作品を\nありがとうございました。\nまたリクエストをお願いします。\n\nキャラクター：天元突破グレンラガン ヨーコ・リットナー(大人バージョン)\n\n構図：全身立ち絵 正面向き\n　　　頭の後ろで手を組むグラビア撮影っぽいポーズ\n\n背景：無し\n\n胸の大きさ：爆乳(B100cm以上のイメージ)\n\n衣装：踊り子衣装\n　　　資料URLを参照願います。\n\n小物：チョーカー\n\n表情：笑顔と照れ顔\n\n詳細\n構図は、ゲーム等で良く見かけます全身立ち絵で正面を向いており\n頭部の後ろで手を組むグラビア撮影っぽいポーズでお願いします。\n\n胸は爆乳で100cm以上のイメージでお願いします。\n全体のバランス等が有るかと思いますが、大きい分には、いくらでも大丈夫です！！\n\n衣装は踊り子衣装で赤系統の色でお願いします。\n踊り子衣装が描き辛ければアレンジは好きにして頂いて構いませんが、\n胸部衣装面積は少な目でお願いします。\nフェイスベールは有っても無くても構いません。\n\n小物としてチョーカーをお願いします。\n\n最後に、表情は笑顔と照れ顔の2種類を可能ならお願いします。\n\n拙い文面の上、分かりづらい処も有るかと思います