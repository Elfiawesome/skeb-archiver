eptable_same_genre": true}, {"path": "/@kumaoji_san/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 511990, "client_id": 1483292, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/cfd51cc0/uploads/origins/012e84bd-e1dd-433f-87d9-4d6739c8de0e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f635e4292ad98cd89d7952a7041d4a53", "srcset": "https://si.imgix.net/cfd51cc0/uploads/origins/012e84bd-e1dd-433f-87d9-4d6739c8de0e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f635e4292ad98cd89d7952a7041d4a53, https://si.imgix.net/cfd51cc0/uploads/origins/012e84bd-e1dd-433f-87d9-4d6739c8de0e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f6606ea0bc6daf374d4a96707bb1fc02 2x, https://si.imgix.net/cfd51cc0/uploads/origins/012e84bd-e1dd-433f-87d9-4d6739c8de0e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=8d4bb98b03664b2289d69e3ee418f816 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/cfd51cc0/uploads/origins/012e84bd-e1dd-433f-87d9-4d6739c8de0e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9c786ed98de7cd736c0ab305b072a97c", "srcset": "https://si.imgix.net/cfd51cc0/uploads/origins/012e84bd-e1dd-433f-87d9-4d6739c8de0e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9c786ed98de7cd736c0ab305b072a97c, https://si.imgix.net/cfd51cc0/uploads/origins/012e84bd-e1dd-433f-87d9-4d6739c8de0e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=9e8a3f027e849b7130312d0ab3b30d97 2x, https://si.imgix.net/cfd51cc0/uploads/origins/012e84bd-e1dd-433f-87d9-4d6739c8de0e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=02a832172fc760da3cd0107204d209d7 3x"}, "body": "前回の作品が良かったので、今回もお願いしたいと思っています。\n参考資料にあるものを描いてもらえますか？ラフスケッチを添付しました。もう一度言いますが、キャラクターは「アダストラ」の「アミカス」です。オオカミ男で、体格はゴツゴツしています。\n\nAmicusは赤ワインに酔っていて、見る人を直視しているはずです。彼の表情は、一緒に飲もうと誘っているように、心から笑っているはずです。彼はローマ風の椅子（トリクリニウム）に座り、金色のゴブレットを掲げ、そこにワインを注いでいます。彼の前にあるテーブルには、彼自身のゴブレットと食べ物、そして空や半分になったワインボトルが置かれています（つまり、彼が飲んだということです）。吹き出しはアミカスのもので、英単語でこう言っている。「まだ早いよ、一緒に飲もうよ！」と言っている。\n\n彼は、赤いマントとズボンに加えて、参考資料にあるように金の花輪を身につけているはずです。背景は、1枚目と2枚目の参考資料にあるように、他のキャラクターがいない状態にしてください。ありがとうございました。\n\nhttps://imgur.com/a/8xJyKab", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@kumaoji_san/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 511990, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/cd90be46/uploads/origins/24886b33-1aad-44a3-8735-6c23b290ca58?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0d54a791e5e549a1a475cb1c27412b9e", "srcset": "https://si.imgix.net/cd90be46/uploads/origins/24886b33-1aad-44a3-8735-6c23b290ca58?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0d54a791e5e549a1a475cb1c27412b9e, https://si.imgix.net/cd90be46/uploads/origins/24886b33-1aad-44a3-8735-6c23b290ca58?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=034616fab8fb6a31d76451a3fccbc113 2x, https://si.imgix.net/cd90be46/uploads/origins/24886b33-1aad-44a3-8735-6c23b290ca58?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=0c0982b465cbcd4720f8e83e9bf2edd2 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/cd90be46/uploads/origins/24886b33-1aad-44a3-8735-6c23b290ca58?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9a57da462c314f1a0b987d0e5e7631bb", "srcset": "https://si.imgix.net/cd90be46/uploads/origins/24886b33-1aad-44a3-8735-6c23b290ca58?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=2