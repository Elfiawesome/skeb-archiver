-4ab9-898a-09465350c971?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e86c94c514c9cc014244d6579ddd766e", "srcset": "https://si.imgix.net/96750a7e/uploads/origins/3285ce0f-7e56-4ab9-898a-09465350c971?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e86c94c514c9cc014244d6579ddd766e, https://si.imgix.net/96750a7e/uploads/origins/3285ce0f-7e56-4ab9-898a-09465350c971?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=488153d888a6f72aa75d983e5572f565 2x, https://si.imgix.net/96750a7e/uploads/origins/3285ce0f-7e56-4ab9-898a-09465350c971?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=718a1f9ddf7e1ab748742044500ee7a0 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/96750a7e/uploads/origins/3285ce0f-7e56-4ab9-898a-09465350c971?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=fde86f48ece3f5f3e1fcd76b15eb00aa", "srcset": "https://si.imgix.net/96750a7e/uploads/origins/3285ce0f-7e56-4ab9-898a-09465350c971?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=fde86f48ece3f5f3e1fcd76b15eb00aa, https://si.imgix.net/96750a7e/uploads/origins/3285ce0f-7e56-4ab9-898a-09465350c971?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=28b50842bb1c59be2dde6df9d713c997 2x, https://si.imgix.net/96750a7e/uploads/origins/3285ce0f-7e56-4ab9-898a-09465350c971?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=61ec24c3b3890d38aa52f96b1d208d41 3x"}, "body": "左藤うずらさま初めまして。\nいつも素敵なイラストありがとうございます……！左藤うずらさまの絵がとっても好きなので、ぜひ依頼したいと思いメッセージの方を送らせて頂きました。\n\n\n内容-OC男女3名のイラスト\n依頼を行っている自分ともう2人がデザインした3名となります。(許可頂いております)\n\n世界観-怪異などを取り扱う少し不思議な部署に所属している警察。3人で班を組んでおり。最年少の紫を班長に、黒と橙がサポートする形となっている。突然発足したチームだが、会話は少ないものの仲はよく、ツッコミが不在なためいつものほほんとした雰囲気である。\nシリアスな雰囲気になると、互いが互いを守ろうとして、雁字搦めになっていく3人。\n\nキャラクター-\n＊黒 \n陰気臭いお姉さん。人の会話に入るのが苦手で、話したいと思った際は挙手をするのが癖になっている。\n酒を飲むとみんなを子供だと思い情緒不安定になったり可愛がったりする。\n大切な人たちを守れなかった後悔から自暴自棄になっていたが、紫と橙だけは守ろうという意思で再起。2人のことは弟のように思っている。\n\n＊紫\n最年少の班長。生真面目で正義感が強く、そのためすこし付き合い辛そうに見える。\n本人もその点を気にしており、子供に避けられたり泣かれたりすることに困っている。\nとある騒動で家族を失い、今はひとりで暮らしている。そのため、人を目の前で失うことを極度に恐れ、自己犠牲的である。大切な班員である、黒と橙を命に替えても守ろうとしている。\n\n＊橙\n副班長。飄々としておりどこか掴めない青年。適当な物言いをするが決して不真面目な訳ではない。主に戦闘担当だが実は回避能力の方が高い。\n実は一方的に紫の事情を知っており、自分と似た境遇の紫がひたむきに頑張っているところに励まされてきた。\n\n\n構図-構図や等身などはお好きな物にしてください〇\n雰囲気はダークなもので、月が似合う仄暗い雰囲気だと嬉しいです。\n皆が皆のことを見捨てられず一緒になって落ちていくような感じです。\n\n資料-デザインや資料などは描きやすいように改変していただいて構いません。\n\nデータ-サイン、軽い背景など置かれる場合、キャラクターのみのデータもいただけると嬉しいです…！サイズなどはお任せします。\n\n長々とすみません。ご一考お願い致します。\n\nhttps://drive.google.com/drive/folders/1-4D1dDw205cYdREho9h4lFYkaIhdLJSp", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "similar_creators": [{"id": 2630634, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "紅", "screen_name": "kureeeeenai02", "avatar_url": "https://pbs.twimg.com/profile_images/1885946725451583488/3vEXVn7P.jpg", "header_url": "https://pbs.twimg.com/profile_banners/3162371768/1710665700/1500x500", "appeal_receivable": true, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 90, "skills": [{"genre": "art"}, {"genre": "comic"}, {"genre": "novel"}, {"genre": "correction"}], "banned": false, "nc": 144}, {"id": 3031382, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "じゃん", "screen_name": "Jan0050TRPG", "avatar_url": "https://pbs.twimg.com/profile_images/1561488911419191296/1Pn3iXlB.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1561488499161075713/1704078423/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_