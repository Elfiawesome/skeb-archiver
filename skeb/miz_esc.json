nt_visible": false, "total_appeals_count": 0, "received_works": [{"path": "/@miz_esc/works/43", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3456552, "client_id": 2368804, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/97c47d2a/uploads/origins/1af6ac34-43df-4202-a1a9-10165aa89181?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b4dd8833b2cc1ff1def62d64e5083e42", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/97c47d2a/uploads/origins/1af6ac34-43df-4202-a1a9-10165aa89181?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f645fe11a55a2bd8953daa8c6027695c", "src_set": ""}, "body": "こんにちは、あなたのカラフルなイラストが大好きです！\n私と友達のOCをリクエストしてもいいですか？幼馴染→カップルです。\n\n天使パロ(白い羽と後光)でお願いします。\n- おとぎ話のような雰囲気。\n- 雲の上の街に住んでいるのですが、よくこっそり下の土地に遊びに行きます。\n- 海辺で夕日を見たり、花畑でピクニックするのが大好き。\n\nサイライン、青い髪180cm\n- エレガントでチャーミング。プリンセスのようなスタイル。\n- 水色の光輪が月のように輝く。\n- コゼットにべったりで、着飾るのが好き。\n- テーマは猫と海。\n\nコゼット、赤毛：172cm\n- 陽気で自信家。反抗的またはおてんばスタイル。\n- オレンジ色の後光が太陽のように輝いている。\n- サイラインをかわいがり、彼女のためにデザートを作るのが大好き。\n- テーマ：レッサーパンダと太陽\n\nフォルダの中にある服や、スタイルに合った服なら何でもOK！どんなかわいい構図でも自由に描いてください！\n\nご検討よろしくお願いします！\n\nhttps://drive.google.com/drive/u/0/folders/1h-yTmERXKVgO6kFTfUH8jfBDe4uRNCWw", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@miz_esc/works/42", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3456552, "client_id": 3623698, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/3d8f48a3/uploads/origins/514ea3d8-58b6-4b19-a8f9-8c224c10f8bd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=33bb3de3b796cd98607bff51c4d22149", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/3d8f48a3/uploads/origins/514ea3d8-58b6-4b19-a8f9-8c224c10f8bd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=49e587f77fddf98b45174e097ffe193d", "src_set": ""}, "body": "mizさん、初めまして！\nmizさんの可愛らしいイラストと人物描写の魅力に一目惚れし、この度は、一次創作のカップルのセリフありの詰め込みイラストを描いていただきたくリクエストしました。\n\n中国人の男の子と日本人の女の子の高校生カップルです。詳細や資料は下記のリンクにてまとめております。\n\n男の子から女の子への好意やスキンシップが多いカップルなので、ぎゅっとくっついた構図があると嬉しいです。\n糸目の男の子ですが目を開けた状態で描いていただいても構いません！お好きな方を選んでください。\n\n服装は資料の制服、またはメイド服とウエイター服(細部は描きやすいように変更していただいて大丈夫です)、またはmizさんのお好きなスタイルの服やアクセサリーで描いてください。(どこかに中華風の要素があると嬉しいです。)\n\n2人のモチーフ▶︎黒きつね、うさぎ、桃、中華\n\n\n長々と書きましたが、上記は参考程度で全てmizさんのご自由にお描きください！また、リクエストに難があれば金額不足での再送やキャンセル等遠慮なく対応していただけると幸いです。\n\nどうぞよろしくお願いいたします！\n\nhttps://drive.google.com/drive/folders/1CPEMTmcuJ73Jy5s_ZX5TroAYvnA6XcRt", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@miz_esc/works/41", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/e6e0e68b/uploads/origins/667b4773-2054-45d9-ae59-e11009e94368?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=2c7114149ebb250fb8bd9f7877378e59", "src_set": ""}, "private": true, "genre": "art", "tipped": false, "creator_id": 3456552, "client_id": 3066164, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 1, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@miz_esc/works/40", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3456552, "client_id": 3045081, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/8f45d127/uploads/origins/418742a5-9d01-4998-a486-a5f70fd88832?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a08987af11fb605658c1ffe7d233050e", "src_set": ""}, "duration": null, "nsfw"