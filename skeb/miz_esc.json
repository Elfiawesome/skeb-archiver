": false}, {"path": "/@miz_esc/works/31", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3456552, "client_id": 2928251, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/f4aae3df/uploads/origins/5df84361-f3a2-44dd-9097-d39bc9125d2e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3bcbf1fc02c334fd79a0d88d3a1f7b81", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/f4aae3df/uploads/origins/5df84361-f3a2-44dd-9097-d39bc9125d2e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=119a85c38c63441fc3a65b66cc8cec94", "src_set": ""}, "body": "miz@逃亡中さん、こんにちは！\nmiz@逃亡中さん、こんにちは！miz@逃亡中さんの表情ややりとりの描き方がとても好きです！\n私のペアの吸血鬼の恋人、ルシウスとユリのイラストをお願いできますか？\n\nルシウス（177cm）は善でも悪でもない。\n甘い笑顔に覆われた悪魔のような男。\n彼の性格は、まるでおとぎ話の夢か目の錯覚のように非現実的だ。\n彼の本性は誘惑的だが、禁断の果実のように食べられない。\n表情は眠そうで誘惑的。\n\nユリ（168cm）は、穏やかなヴィクトリア朝の乙女と形容される。\n温かく思いやりのある \"オーラ \"を持つ心優しい人。\n思いやりと自信と忍耐で嘆きを隠している。\n胸は平らで、性別はわからない。\n表情は無邪気で活発。\n\nルシウスとユリのほろ苦いロマンス！\nご検討ありがとうございました\n\nhttps://drive.google.com/drive/folders/1cIbmPZ8-T2c0KVP5ZI9qFUDwwr-9RzKG?usp=drive_link", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@miz_esc/works/30", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/2dd19d7a/uploads/origins/f22cda6f-a23f-46a9-97b1-143ef790527d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=1ecd55aee08875a7b0c4355c407245e6", "src_set": ""}, "private": true, "genre": "art", "tipped": true, "creator_id": 3456552, "client_id": 3143792, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 17, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": f