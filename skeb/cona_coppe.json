=200&blur=200&s=812210e18dd8dd8851ed638afaa212c9 3x"}, "body": "お世話になります。\nかわいくえっちで素敵なイラストを拝見しまして、\n資料URLのうちの子のキャラクターを描いていただきたく、\n下記内容にてリクエストさせていただければと思います。\n\n●内容等\n・元気な感じのねこみみの女の子です。\n・服を着たままパンツ(色は白)に手を入れて自慰している様子。\n・その他、細かい部分は全てお任せいたします。\n\n●資料URL\nhttps://gyazo.com/d61e991530cc2f4ee7ba2ce38c407371\n\n以上、ご検討いただけますと幸甚でございます。\nどうぞよろしくお願いいたします。", "nc": 48, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@cona_coppe/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3859640, "client_id": 2493796, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/37813d4d/uploads/origins/1d318d0c-767f-4692-913d-60f4383bb81d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=49ee76c16498a1709c740af14e23cc35", "srcset": "https://si.imgix.net/37813d4d/uploads/origins/1d318d0c-767f-4692-913d-60f4383bb81d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=49ee76c16498a1709c740af14e23cc35, https://si.imgix.net/37813d4d/uploads/origins/1d318d0c-767f-4692-913d-60f4383bb81d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=987728e729484ecd1fc16b2837484848 2x, https://si.imgix.net/37813d4d/uploads/origins/1d318d0c-767f-4692-913d-60f4383bb81d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ae418d8a61175ea3823f8ab4be35a97a 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/37813d4d/uploads/origins/1d318d0c-767f-4692-913d-60f4383bb81d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=762f45eee51fcbb928dc88632e77735e", "srcset": "https://si.imgix.net/37813d4d/uploads/origins/1d318d0c-767f-4692-913d-60f4383bb81d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=762f45eee51fcbb928dc88632e77735e, https://si.imgix.net/37813d4d/uploads/origins/1d318d0c-767f-4692-913d-60f4383bb81d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=9f7ecc73849d3e8d416a4dff3936fce6 2x, https://si.imgix.net/37813d4d/uploads/origins/1d318d0c-767f-4692-913d-60f4383bb81d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=4228f12df4292946d60d6818998b1ea0 3x"}, "body": "初めまして！\n\nMisskeyIoでいつもカワイイイラストを拝見しています。\nSkeb再開されないかな～とお待ちしていました！\n\nよろしければうちの子（OC）を描いていただきたいです。\n\n◆うちの子はこちらです\nhttps://drive.google.com/file/d/1OVTdRLLAhEoE8LqHfKWsTEj8Jnu3tZgM/view?usp=sharing\n\n◆お願いしたいシチュエーション的に、衣装の資料はあまり意味がないのですが一応載せます\nhttps://drive.google.com/file/d/143tX1tODXthD4RXiXbKAYB39dbJZ9gNA/view?usp=sharing\n\n内容はお風呂に入った後か、入る前のうちの子をお願いしたいです。\n脱衣所で半裸でいるところに、ご主人様が入ってきちゃって驚き→テレテレ////みたいな…！\n\nほぼ服は脱いでいて、タオルだけや、下着だけくらいな状態だと嬉しいです。\nお胸は見えてると嬉しいかもです。\n\nその他、下着にする場合のデザインや髪を下ろしているかどうかなど\n細部はお任せ致します！\n\nうちの子カワイイさせていただけたら嬉しいです。\nよろしければお願い致します。", "nc": 32, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@cona_coppe/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3859640, "client_id": 3290628, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/2704cb48/uploads/origins/47ce2d11-6225-418c-b277-ec5de6117aa6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bf52e02e36efbd93f041ee8b0609b005", "srcset": "https://si.imgix.net/2704cb48/uploads/origins/47ce2d11-6225-418c-b277-ec5de6117aa6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bf52e02e36efbd93f041ee8b0609b005, https://si.imgix.net/2704cb48/uploads/origins/47ce2d11-6225-418c-b277-ec5de6117aa6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a44790ff77bb96ee62569f657252b0ea 2x, https://si.imgix.net/2704cb48/uploads/origins/47ce2d11-6225-418c-b277-ec5de6117aa6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b8184e8a4ef1b73e89ef67124d3c66dd 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/2704cb48/uploads/origins/47ce2d11-6225-418c-b277-ec5de6117aa6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c3b7d7ae5135c0d433d16ae4fc5dfb82", "srcset": "https://si.imgix.net/2704cb48/uploads/origins/47ce2d11-6225-418c-b277-ec5de6117aa6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c3b7d7ae5135c0d433d16ae4fc5dfb82, https://si.imgix.net/2704cb48/uploads/origins/47ce2d11-6225-418c-b277-ec5de6117aa6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=3ea8dd9406c24e66fa7315dfa2baa569 2x, https://si.imgix.net/2704cb48/uploads/origins/47ce2d11-6225-418c-b277-ec5de6117aa6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=a8e5183ca31c8983b375ea917d8deab7 3x"}, "body": "こんばんは!こなこっぺさんがskebを開始したと聞いてすっ飛んできました!!\nぜひともうちのこがお風呂に入っているイラストをお願いしたいと思います…!!\n\n☆キャラ…\n「ノイル」\nオレンジ髪、青目の女の子。\nケモミミは薄いクリーム色、尻尾は白色寄り。\nお胸はぜんぜんありません。\n\n☆シチュ…\n湯船に浸かっている、シャワーを浴びている、体を洗っている…\nなどお風呂に入っているとわかる描写であれば特に問いません。\nお風呂の形式なども問いませんので、ご自由に簡単に描きやすいようにお願いできたらと思います!\n\n自キャラの詳細や参考になるかわかりませんが描いたお風呂絵などを下記に添付させていただきます。\nご検討よろしくお願いいたします!\nhttps://misskey.io/notes/a9pr807x2uax08n1\nhttps://misskey.io/notes/af61tcbznogs06mw", "nc": 33, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@cona_coppe/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3859640, "client_id": 3150980, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/451e6ed9/uploads/origins/e12f8611-9a1c-41fc-ac9b-32b7ea00609d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2fd852e5dc76c09059f4f6081217111b", "srcset": "https://si.imgix.net/451e6ed9/uploads/origins/e12f8611-9a1c-41fc-ac9b-32b7ea00609d?bg=%23fff&auto=format%