幸いです！\nまた、先生のお好みに合わせて、衣装や髪型などを自由に変更・アレンジしていただいて全く問題ございません。先生が「一番格好良い・可愛い」「描いていて楽しい」と感じる表現でお描きいただけますと大変嬉しいです。\n\n【用途】\n個人鑑賞、SNS（アイコン・ヘッダー）での使用\n\nお忙しいところ恐れ入りますが、ご承認いただけますと幸いです。\n先生のペースで楽しみながら描いていただけることを心より願っております。どうぞよろしくお願いいたします！\n\nhttps://drive.google.com/drive/folders/1wdGCUh8Rt_faNc7-mS2CseRO3UTeAyEQ", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}], "sent_works": [], "similar_creators": [{"id": 1314046, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "ゆれ", "screen_name": "mr_ayarabbit", "avatar_url": "https://pbs.twimg.com/profile_images/1663553167748104194/ibT862Ug.jpg", "header_url": null, "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 7, "complete_expiration_days": 35, "skills": [{"genre": "art"}], "banned": false, "nc": 32}, {"id": 1392402, "creator": true, "nsfw_acceptable": false, "acceptable": false, "name": "さはらこん", "screen_name": "saharakon", "avatar_url": "https://pbs.twimg.com/profile_images/1466417343454752780/Ot6hLyRa.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1424264512215994370/1637218927/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 120, "skills": [{"genre": "art"}], "banned": false, "nc": 145}, {"id": 2215160, "creator": true, "nsfw_acceptable": false, "acceptable": false, "name": "nel@お返事遅れます", "screen_name": "m_pff7", "avatar_url": "https://pbs.twimg.com/profile_images/1951970069447368705/7z3MP3WQ.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1428695988152143876/1754220756/1500x500", "appeal_receivable": true, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acc