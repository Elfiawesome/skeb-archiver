200&blur=200&s=8f7310eded1e4eb5e884cee5d3a27a1f", "src_set": ""}, "body": "先生、こんにちは！私はあなたの作品が大好きです\n私のOCを描いていただけませんか？\n\n參考URL：https://imgur.com/a/ZSArOg1\n＊傲慢で生意気だが、実は神経質で臆病なヴァンパイアの少女。\n＊舌はカットされていて、飾りがついています。\n＊身体に傷を描く必要はない（描いてもいい）。\n＊十字架は描かないでください。\n＊好きな要素：ピンク、吊り縄、イチゴ、毒キノコ、臓器。\n\n構図も服装も自由だ、\n何卒ご検討の程よろしくお願い致します、\nありがとうございました！", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@so_siopas/works/3", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/a7241d07/uploads/origins/980ac289-6ae5-4c82-b880-c640b778e555?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=8000d10403ba360a0db39282141c6b52", "src_set": ""}, "private": true, "genre": "art", "tipped": false, "creator_id": 2363284, "client_id": 470752, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 16, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@so_siopas/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2363284, "client_id": 3154784, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/55100256/uploads/origins/1932092f-35f2-445f-8dc4-7fbbd3297a5f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=496f93f857ae94d27b0bb6d752ebbbc8", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/55100256/uploads/origins/1932092f-35f2-445f-8dc4-7fbbd3297a5f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e20adac8a9df3a7ccefc72d8545059c6", "src_set": ""}, "body": "夢あつさんこんにちは！\n私の創作カプをリクエストさせていただきたいです♡\n\nリクエストさせていただきたい詳しい内容は資料URL内にて記載しておりますので、お手数お掛けしますがそちらの方に目を通していただけるとうれしいです！泣\n\n服装の指定は特にありませんが、迷ったらだいたいこんな感じの服を着せていただきたいです⤵︎ ︎\n\nピンク髪外ハネボブの女の子/ピンクのロリータ基調の服\n\n黒髪ツインの女の子/露出高めのピンクの服、または裸体\n\nもし不備がございましたら再送申請のほどよろしくお願いします。\n\n夢あつさんのセンスが大好きです♡好きなように描いていただけるととても嬉しいです！\nよろしくお願いいたします。\n\nhttps://photos.app.goo.gl/QW1wT4dpfU12NbHt7", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@so_siopas/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2363284, "client_id": 3132966, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/3458a170/uploads/origins/16298e94-501f-439c-af2e-6b7c9d8f35d8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1dcd65b5eb966a62c19f7208fcd71a92", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/3458a170/uploads/origins/16298e94-501f-439c-af2e-6b7c9d8f35d8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5b182add0bd450a275b2c213d8ee13f1", "src_set": ""}, "body": "夢あつファビュラスさま、初めまして！\nTwitterのメディア欄を拝見させて頂きまして、レトロ＆夢かわ＆不穏なステキ世界観に魅入られました！\n\nよろしければ自分のいわゆる活動用アバターのキャラクターを夢あつファビュラスさまの絵柄＆世界観で描いて頂きたいです！\n\n可能であればSNSのヘッダーや告知画像、動画のサムネイルなどに夢あつファビュラスさまのIDを記載し使わせて頂きたいと思っております。\nそして人物のみの透過pngファイルをご用意頂けるととても助かります…。\n（その際トリミング等加工をさせて頂く可能性が高いです。）\n\nアバターが二種類ありますが、二人描くのは…といった場合、お好きな方をお選びください。\n3Dの方の場合、2Dの方と似たような服を着せて頂けると有り難いです。\n服をアレンジして頂いても全然大丈夫です。\n\n血液やリアルな臓物はNGですが、どれだけ不穏に描いて頂いても構いません。\n表情やポージングもどれだけ不穏でも大丈夫です。全てお任せします。\n\n長々とすみませんでした！よろしくお願い致します！\n本当に夢あつファビュラスさまの描く作品が大好きです！\n\nhttps://twitter.com/near_sumi/status/1757010990737310117", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "similar_creators": [{"id": 176038, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "デスふぐ人間☺︎", "screen_name": "ketunoniku", "avatar_url": "https://pbs.twimg.com/profile_images/1872801968613437440/u2ckGLho.jpg", "header_url": "https://pbs.twimg.com/profile