、服の細かい構造は描いていないので、複雑でよく分からない部分や見えない部分は描きやすいようにアレンジや省略をしていただいて構いません。\nポーズなどは燦影様にお任せしますので、好きなように描いてください...! \n以下に資料を載せています~↓\n\nhttps://drive.google.com/file/d/1a26NZI9H9hmGM2xqYy5Jp6MTnIzHmfad/view", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 278999, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "絵描キ牛 有償依頼受付中", "screen_name": "PainterCattle", "avatar_url": "https://pbs.twimg.com/profile_images/1627357527582314496/BF1DAEZK.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1031015637122875392/1777508901/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 7, "complete_expiration_days": 65, "skills": [{"genre": "art"}], "banned": false, "nc": 16}, {"id": 2538476, "creator": true, "nsfw_acceptable": false, "acceptable": false, "name": "昼行燈", "screen_name": "pieceof_figcake", "avatar_url": "https://pbs.twimg.com/profile_images/1590857481093160963/lMOgbFiq.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1578558519703633920/1696227204/1500x500", "appeal_receivable": true, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 120, "skills": [{"genre": "art"}], "banned": false, "nc": 145}, {"id": 2590674, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "けにぃ＠skebでリクエスト募集中", "screen_name": "KennyMuseum", "avatar_url": "https://pbs.twimg.com/profile_images/1753421452207169536/QL2C0-5l.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1211622859744763906/1774976646/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_b