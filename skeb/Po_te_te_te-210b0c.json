描いていて楽しそうだとお感じになるもので、どうぞご自由に選んでください。新しい衣装のデザインも大歓迎です！\n\nキャラクターの参考画像／過去の作品：\nhttps://drive.google.com/drive/folders/1W82ZBeEXTXJy-37leGWmt55WmlhW5hTf?usp=sharing\n\nご依頼をご検討いただきありがとうございます ^~^", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 575588, "creator": true, "nsfw_acceptable": false, "acceptable": false, "name": "サーモンまなみ◆Skeb", "screen_name": "umaiitiyabosi1", "avatar_url": "https://pbs.twimg.com/profile_images/1282991062538055681/9xVdkLE9.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1282990006982701056/1594724020/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "art"}], "banned": false, "nc": 160}, {"id": 1314046, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "ゆれ", "screen_name": "mr_ayarabbit", "avatar_url": "https://pbs.twimg.com/profile_images/1663553167748104194/ibT862Ug.jpg", "header_url": null, "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 7, "complete_expiration_days": 35, "skills": [{"genre": "art"}], "banned": false, "nc": 48}, {"id": 1688710, "creator": true, "nsfw_acceptable": true, "acceptable": false, "name": "KiiKo @アニメ原画風skeb", "screen_name": "Kiiko_clip", "avatar_url": "https://proxy.misskeyusercontent.jp/avatar.webp?url=https%3A%2F%2Fmedia.misskeyusercontent.jp%2Fio%2Fd4b360a8-1c07-44f9-b59a-94c6982e2227.gif&avatar=1", "header_url": "https://media.misskeyusercontent.jp/io/fb207f67-3c6c-47bb-9795-c6d4b3977f4a.webp", "appeal_receivable": false, "popular_creator_rank": 38, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": 