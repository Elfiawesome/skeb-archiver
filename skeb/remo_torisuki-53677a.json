n性格：\n・優しくのほほんとしており、1度｢お前といると気が抜ける｣と愚痴られたことがある\n・前に出て指揮を執るというよりかは1歩身を引いて周りを見ている。\n・穏やかで怒ることが少なく、怒っても語彙が弱くて怖くない。\n・家族や仲間のことが大好きで、皆の幸せは自分の幸せタイプ\n・実は焦ると脳筋になる。\nイメージカラー：ミストホワイト　E5E8E1\n資料：https://drive.google.com/drive/folders/1YDGtXxOZWOAueEFcpAtLB8Trs1Zcd8Zq\n※他の方から頂いたものもありますが、許可は得ています\n\n┈┈┈┈┈┈┈┈┈┈\n\n何かありましたら再送願います！", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@remo_torisuki/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3848132, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/ff57b91e/uploads/origins/366ff432-9846-4bda-b7f0-20ec3405256c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=864dea9e8908b92ffd592d181ac2f9e1", "srcset": "https://si.imgix.net/ff57b91e/uploads/origins/366ff432-9846-4bda-b7f0-20ec3405256c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=864dea9e8908b92ffd592d181ac2f9e1, https://si.imgix.net/ff57b91e/uploads/origins/366ff432-9846-4bda-b7f0-20ec3405256c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c14976a1566cafe0f3416137343c6e64 2x, https://si.imgix.net/ff57b91e/uploads/origins/366ff432-9846-4bda-b7f0-20ec3405256c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=da5652c90a9b73c9bd568c8f3fd4e13c 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/ff57b91e/uploads/origins/366ff432-9846-4bda-b7f0-20ec3405256c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=dce977340b59c3b52d2d1e74c554b7b9", "srcset": "https://si.imgix.net/ff57b91e/uploads/origins/366ff432-9846-4bda-b7f0-20ec3405256c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=dce977340b59c3b52d2d1e74c554b7b9, https://si.imgix.net/ff57b91e/uploads/origins/366ff432-9846-4bda-b7f0-20ec3405256c?bg=%23fff&au