ごと ねむち)と申します。　\n\n〚人物、服装〛\n・寝言ねむち\nキャラクター：他人の善意で生きている、無気力ダウナー系、マイペース、お姉さん、中低音の声\n顔：口はギザ歯、目は眠そうな猫目、目の中のハイライトはプラスマーク\n髪：濃い青み紫、アスカ・ラングレーのような三角の赤いヘアピン\n服：着物の中に黒シャツ、ループタイ、ライダースジャケットを羽織っている\n\n〚ポーズ、構図〛\n囁いているポーズでお願いいたします。\nASMRや囁き雑談（R18ではない）で使用予定です。\nヤンデレっぽく、ハイライト無し差分などがあるとありがたいです。\n眼鏡差分もお願いしたいです。\n\n〚使用用途〛\n・Youtubeサムネイル（収益化）\n・配信画面\n・おはようツイート\n・グッズ利用\n\n〚納品について〛\n可能であれば\n・背景や文字と人物のレイヤーを分けた形での納品\n・頭と髪が見切れないよう描写\n\n何卒よろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/1EvYHhC865uSAoluQfGmh1AD31MRNa3RG?usp=sharing", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@8_______com/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2315908, "client_id": 3861487, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/e42764fd/uploads/origins/6b5c2b09-1db7-44c8-a4cd-15f89ad94ad1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=39975a71ea5be7b1b2044a16558dbd6b", "srcset": "https://si.imgix.net/e42764fd/uploads/origins/6b5c2b09-1db7-44c8-a4cd-15f89ad94ad1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=39975a71ea5be7b1b2044a16558dbd6b, https://si.imgix.net/e42764fd/uploads/origins/6b5c2b09-1db7-44c8-a4cd-15f89ad94ad1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c469ff69acfccd7b3295def80ab98455 2x, https://si.imgix.net/e42764fd/uploads/origins/6b5c2b09-1db7-44c8-a4cd-15f89ad94ad1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=06145b09d2ae768c3e11dd2902178a04 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/e42764fd/uploads/origins/6b5c2b09-1db7-44c8-a4cd-15f89ad94ad1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f8801fa85d70d5a62bbf6d48d162e090", "srcset": "https://si.imgix.net/e42764fd/uploads/origins/6b5c2b09-1db7-44c8-a4cd-15f89ad