す。\n\nぜひご縁があればと思います🍀\nよろしくお願いいたします！\n\nhttps://drive.google.com/drive/folders/171rec9znbAYUUCEkSXWQWAGiCZXCOBMM", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@oyu_wish/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3775143, "client_id": 3615964, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/00207e31/uploads/origins/d9978421-45ad-48b9-8493-9436e7c96cda?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2b84dc78c3091cb3ad66a1098fdfedad", "srcset": "https://si.imgix.net/00207e31/uploads/origins/d9978421-45ad-48b9-8493-9436e7c96cda?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2b84dc78c3091cb3ad66a1098fdfedad, https://si.imgix.net/00207e31/uploads/origins/d9978421-45ad-48b9-8493-9436e7c96cda?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=22ea82c0398382ccf9ed613d2da41ba1 2x, https://si.imgix.net/00207e31/uploads/origins/d9978421-45ad-48b9-8493-9436e7c96cda?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=5308b7bdadad0343cb09563a66b64fdb 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/00207e31/uploads/origins/d9978421-45ad-48b9-8493-9436e7c96cda?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e3ec5bd5095e57f3c31611078aed6d8e", "srcset": "https://si.imgix.net/00207e31/uploads/origins/d9978421-45ad-48b9-8493-9436e7c96cda?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e3ec5bd5095e57f3c31611078aed6d8e, https://si.imgix.net/00207e31/uploads/origins/d9978421-45ad-48b9-8493-9436e7c96cda?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=29d0c0eb4d618fc76528dada1135a3d0 2x, https://si.imgix.net/00207e31/uploads/origins/d9978421-45ad-48b9-8493-9436e7