the-live2d-model-provided-by-u-stella-inc-tou/\n\n\n以上、長くなって申し訳ありませんが、ぜひぜひご検討のほどよろしくお願いします！\n\nhttps://x.com/mofmof_3/status/1932487130074517767", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@nonbiritya/works/15", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1957874, "client_id": 131988, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/f9d4c721/uploads/origins/91630ba7-bcfa-4ee0-9a7f-f489587a2fc1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=129a387cf7fd536fb5e7fa4fe3e67c2a", "srcset": "https://si.imgix.net/f9d4c721/uploads/origins/91630ba7-bcfa-4ee0-9a7f-f489587a2fc1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=129a387cf7fd536fb5e7fa4fe3e67c2a, https://si.imgix.net/f9d4c721/uploads/origins/91630ba7-bcfa-4ee0-9a7f-f489587a2fc1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ef587b9316f269d2982b323d4899b5d7 2x, https://si.imgix.net/f9d4c721/uploads/origins/91630ba7-bcfa-4ee0-9a7f-f489587a2fc1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=1998aeba9021d1c36ff20fc09a703da2 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/f9d4c721/uploads/origins/91630ba7-bcfa-4ee0-9a7f-f489587a2fc1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=bbee5a417bcc87b9c5ad9a8352375389", "srcset": "https://si.imgix.net/f9d4c721/uploads/origins/91630ba7-bcfa-4ee0-9a7f-f489587a2fc1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=bbee5a417bcc87b9c5ad9a8352375389, https://si.imgix.net/f9d4c721/uploads/origins/91630ba7-bcfa-4ee0-9a7f-f489587a2fc1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=5e80a188797980a15f0eecf7f88e4e56 2x, https://si.imgix.net/f9d4c721/uploads/origin