99_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5d8a1342a20e6da6b2177afe17c96801", "srcset": "https://si.imgix.net/ff0c3d0c/requests/261699_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5d8a1342a20e6da6b2177afe17c96801, https://si.imgix.net/ff0c3d0c/requests/261699_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=bd1b5306ff04e1ff2c9ba46d2d7a4242 2x, https://si.imgix.net/ff0c3d0c/requests/261699_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=7b7f8e5443705c168996191cf9bcb21e 3x"}, "duration": null, "nsfw": true, "hardcore": true, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/ff0c3d0c/requests/261699_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2f420a4882a8a4b7767de4832051f18f", "srcset": "https://si.imgix.net/ff0c3d0c/requests/261699_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2f420a4882a8a4b7767de4832051f18f, https://si.imgix.net/ff0c3d0c/requests/261699_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=897afccefbeb8b4c9b4d00caafda7d2e 2x, https://si.imgix.net/ff0c3d0c/requests/261699_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=4b73e265f824e87ad06c798d830a4505 3x"}, "body": "着衣爆乳が大好きなので可能な範囲でお願い致します\n\n作品名/キャラ名\nデート・ア・ライブ/時崎狂三(水着姿希望)：https://imgur.com/a/XBy2kM0\n\nシチュ：\n着衣爆乳～超乳(&可能であれば着衣ボテ腹)姿の時崎狂三に嘲笑されながら、エグイ内部構造の触手オナホを見せつけられるドMホイホイシチュ。\n\n狂三は手が簡単に沈む程で顔以上のサイズかつ水着の上からでも立っている乳首がわかる感じの着衣爆乳～着衣超乳(&可能であれば特大着衣ボテ腹)姿で、\n水着の中にギチギチに押し込まれた胸(やボテ腹)が強調されるような大きさとポーズを希望します。\n衣装は着衣超乳や着衣ボテ腹用に調整して頂いて問題ありません。\nまたもしボテ腹が可能でしたら、下腹部に怪しく光る淫紋の描写を希望します。\n\n触手オナホはブラシ状触手、吸盤触手に加えて中央部に肉の“かえし”がびっしり生えているような尿道責め触手を持ち、\n内壁も粘液まみれの襞や繊毛などが密集した、挿入したらひたすら搾り取られそうな触手地獄にしてください。\nまた優先度低で可能でしたら、触手が大量の粘液をローションみたくおっぱいの谷間に流し込んで、おっぱいがエロチックに濡れている描写を希望します。\n\nまたできましたら背景は触手肉壁もしくは禍々しい感じで、psd形式希望で粘液まみれの触手が蠢く水音(効果音)の有り/無し、瞳のハイライト有り/無し差分希望です。\n\nボテ腹、触手要素は予算的に可能ならで構いませんので何卒宜しくお願い致します！\n\n時崎狂三通常立ち絵参考：https://i.imgur.com/W2Zweky.png\n触手オナホ参考：https://imgur.com/a/I02AVSy\n尿道責め触手参考：https://i.imgur.com/vVCTyVa.png", "nc": 42, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@liza45694569/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1016780, "client_id": 71755, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/826e000a/requests/262019_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=796bbda4b2c6a4c80d79676f5cfca896", "srcset": "https://si.imgix.net/826e000a/requests/262019_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=796bbda4b2c6a4c80d79676f5cfca896, https://si.imgix.net/826e000a/requests/262019_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=8d766f319a94a3449d72e7b4e1b7f6fa 2x, https://si.imgix.net/826e000a/requests/262019_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=cbdcb99f7eeb7b360fd9dbc25d1b1d5b 3x"}, "duration": null, "nsfw": true, "hardcore": true, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/826e000a/requests/262019_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0e381f013272cc64b4eb9e127bf99e9c", "srcset": "https://si.imgix.net/826e000a/requests/262019_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0e381f013272cc64b4eb9e127bf99e9c, https://si.imgix.net/826e000a/requests/262019_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=9db8744869e0d85cca9a558a1853d791 2x, https://si.imgix.net/826e000a/requests/262019_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=24ab9a2de399cb47e16371cce252091d 3x"}, "body": "一件リクエスト中ですが可能でしたらこちらも何卒よろしくお願いします！\n\n作品名/キャラ名\nデート・ア・ライブ/時崎狂三二人(ナース姿、バニー姿希望)：https://imgur.com/a/F8vn46p\n\nシチュ：\n触手に寄生・苗床にされた着衣超乳&特大着衣ボテ腹姿の時崎狂三２人に嫌悪・侮蔑・罵倒されながら、エグイ内部構造の触手オナホを見せつけられるドMホイホイシチュ。\n\n二人とも手が簡単に沈む程で顔以上のサイズかつ服の上からでも乳首がわかる感じ(透けありなら乳首はピンク色希望)の着衣超乳と特大着衣ボテ腹姿でお願いします。\nまた服の中にギチギチに押し込まれた胸やボテ腹が強調されるような大きさとポーズで、\n衣装は着衣超乳や着衣ボテ腹用(ナース衣装の横の紐が引き伸ばされている感じ等)に調整して頂いて問題ありませんので、\n特にボテ腹部の肌は服で隠れてしまっている様子を希望します。またもし予算的に可能でしたら、下腹部に怪しく光る淫紋の描写を希望します。\n\n表情はボテ腹や触手に興奮するM男を気持ち悪がり、心底見下すようなドM向けの侮蔑表情でお願い致します。\n\n触手オナホはブラシ状触手、吸盤触手に加えて中央部に肉の“かえし”がびっしり生えているような尿道責め触手を持ち、\n内壁も粘液まみれの襞や繊毛などが密集した、挿入したらひたすら搾り取られそうな触手地獄にしてください。\nまた優先度低で可能でしたら、触手が大量の粘液をローションみたくおっぱいの谷間に流し込んで、おっぱいがエロチックに濡れている描写を希望します。\n\nまたできましたら背景は触手肉壁もしくは禍々しい感じにして頂けましたら幸いです。\nまたpsd形式でON/OFFできる感じで、粘液まみれの触手が蠢く水音(効果音)の有り/無し、二人の瞳のハイライト有り/無し差分希望です。\n\n内容的に着衣超乳と蔑み表情を最優先で、着衣ボテ腹と触手要素はシチュや予算的に可能ならでの採用で構いません。\n可能な範囲で構いませんので何卒よろしくお願い致します！\n\n時崎狂三通常立ち絵参考：https://i.imgur.com/W2Zweky.png\n触手オナホ参考：https://imgur.com/a/I02AVSy\n尿道責め触手参考：https://i.imgur.com/vVCTyVa.png", "nc": 178, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}], "sent_works": [], "similar_creators": [{"id": 96586, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "zv", "screen_name": "zv14587228", "avatar_url": "https://pbs.twimg.com/profile_images/1165287203720744960/IXpvHcZ8.jpg", "header_url": null, "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 7, "complete_expiration_days": 90, "skills": [{"genre": "art"}], "banned": false, "nc": 49}, {"id": 557240, "creator": true, "nsfw_acceptable": true, "acceptable": false, "name": "しょ～ぐん", "screen_name": "showgun2918", "avatar_url": "https://pbs.twimg.com/profile_images/1130442108970528768/K7758U5_.png", "header_url": "https://pbs.twimg.com/profile_banners/207657631/1529231390/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null