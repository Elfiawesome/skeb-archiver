op&crop=top&w=200&h=200&s=f07ec8d0e77aad07a7188e1fe6a8ceb1", "srcset": "https://si.imgix.net/6df8dc94/uploads/origins/0f41183e-2575-4359-9e5e-672ee63fed3c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f07ec8d0e77aad07a7188e1fe6a8ceb1, https://si.imgix.net/6df8dc94/uploads/origins/0f41183e-2575-4359-9e5e-672ee63fed3c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f27de3a44bea951ebd90ef94736dc4ae 2x, https://si.imgix.net/6df8dc94/uploads/origins/0f41183e-2575-4359-9e5e-672ee63fed3c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=99bbde2a569159532d197e7fa360e805 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/6df8dc94/uploads/origins/0f41183e-2575-4359-9e5e-672ee63fed3c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=fb591282eed22edc6738127b9d6706d5", "srcset": "https://si.imgix.net/6df8dc94/uploads/origins/0f41183e-2575-4359-9e5e-672ee63fed3c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=fb591282eed22edc6738127b9d6706d5, https://si.imgix.net/6df8dc94/uploads/origins/0f41183e-2575-4359-9e5e-672ee63fed3c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=97e712d0e85fd63821f64af71993d494 2x, https://si.imgix.net/6df8dc94/uploads/origins/0f41183e-2575-4359-9e5e-672ee63fed3c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=f843087001dea8c09831acac50e75adb 3x"}, "body": "はじめまして。\n\nVtuberの星光はちやと申します！\n新着イラストの欄から素敵なイラストに惹かれてリクエストを送りました。\n\n\nぜひ、星光はちやのイラストお願いしたいと思っております。\n\nSNSでの投稿やYoutubeの配信のサムネイルに使用したいと考えております。\n可能であれば頭周り等切れないように描いて頂きたいです。\n\n具体的な表情やポーズはお任せいたします。\n\n\n【参考までに、星光はちやは】\n・明るく元気\n・クールなふりをしたいポンコツお姉さん\n\nな性格です。\n\n\n背景を描いて頂ける場合は人物を透過したPSDデータも頂きたいです\nビジュアルにつきましては下記をご参考ください。\n\n(金額等迷ったため当初のまま送らせていただきました)\n\nhttps://drive.google.com/file/d/1CUAaMKmQpvYG6BkymuXgrmb