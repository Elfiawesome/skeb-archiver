core": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 17, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@Miyako_Warf_/works/10", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3478430, "client_id": 3478860, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/753c64a9/uploads/origins/fc7c06c2-905c-48db-adb4-9f2c4f145abe?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2758184bec1b3ae556a54e180156f027", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/753c64a9/uploads/origins/fc7c06c2-905c-48db-adb4-9f2c4f145abe?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f6725404dad4449c44163eabcf7e3f72", "src_set": ""}, "body": "都々様  \n　\n　こんにちは！もももです\n　先日は、素敵なドレスをデザインいただきありがとうございました‼️とってもフリフリで可愛くて見る度にうっとり見とれてしまいます\n　さて、本日も、私のOCである猫白桃ももちゃんのお洋服を都々様にデザインいただきたく、メッセージを失礼いたします。\n　都々様にデザインしていただけて、すごくすごく嬉しかったので、前回同様になりますが、都々様のインスピレーションの湧くまま、似合うと思うお衣装を着せていただきたいです。\n\n　以下、猫白桃ちゃんの特筆すべき情報になります。\n･ラグドール系長毛猫ちゃん\n･薄紫,紫のオッドアイ\n･日傘をいつも持ち歩いています \n･宙河環,綺羅星めめという双子Vライバーのぬいぐるみを持ち歩いています \n\n　描写の判断はおまかせします。  \n　\n　以上、お忙しいところ恐縮ですが、ご検討をよろしくお願いいたします。\n\nhttps://drive.google.com/file/d/1kwMSt7D9YhYTnUR1vPMN-P2a8Ua_Wgl5/view?usp=drivesdk", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@Miyako_Warf_/works/9", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3478430, "client_id": 19323, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/a3a8e51e/uploads/origins/5faffbfd-6964-4417-888f-0eed116c54ff?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c50faa810663cd643ed9d2461f077322", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "ht