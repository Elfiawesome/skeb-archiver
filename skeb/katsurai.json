、お好きな方を選んでいただければと思います。\n・シチュのイメージとしては、最初は嫌悪感を露にした表情を見せているが、竿役のおっさんのテクに気持ちよさを堪えきれず、とろとろになるまでイカされてチン負けし、たっぷり種付けされてしまう。\n・体位は胸を揉まれながらの背面座位で、結合部は見えるようにお願いします。\n・衣装は全裸でお願いします。また、陰毛表現はありでお願いします。\n・描き文字での擬音やハートマークをお願いします。\n・差分として、堕ちる前の抵抗している表情や絶頂時の表情、事後等の表情差分や精液差分、堕ちた後の差分で体への卑猥な落書きや首輪や乳首へのピアスorハートのニプレスをされている差分をお願いします。\nまた、可能であれば黒海苔修正でいただけると嬉しいです。\n\n内容はアレンジしていただいて構いませんので、ご検討いただけましたら幸いです。\n\nhttps://www.dropbox.com/scl/fo/124me93dj4met8ux6lwod/ANEEkUXXRkYzEC1Zvmk5d2s?rlkey=g88rhpr88h1t5pk6toieoh1ag&st=a9g34ysd&dl=0", "nc": 177, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@katsurai/works/4", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/45b4cf5e/uploads/origins/64bd117c-05ea-4fa7-a457-9e75e7b0fc3b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=eea7f00f13d561d69b47798f9a7e4ec5", "src_set": ""}, "private": true, "genre": "art", "tipped": false, "creator_id": 8934, "client_id": 592158, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 178, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@katsurai/works/3", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/de4c33a7/uploads/origins/3ef16797-97b6-4893-9f84-0703dd36bafa?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=c4d1278631f88802f76b33d8a00195ad", "src_set": ""}, "private": true, "genre": "art", "tipped": false, "creator_id": 8934, "client_id": 0, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 32, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"p