\n有料メンバーへの特典(未定)\nグッズ化(未定)\n\n■サイズ\nおまかせ\nサムネイル等に使用するため、髪の毛の先や耳、指の先等が切れていない構図ですと助かります。\n\n是非、ご検討していただけると幸いです。\n\n参考資料\n(https://drive.google.com/file/d/1tcypKHE9Dwogzh80l_Hjb6G3PkArm5B4/view?usp=sharing)\n(https://drive.google.com/file/d/1LdxQGvGlGWu0n2om2QEb1tEEpAqy3t6Y/view?usp=sharing)\n(https://drive.google.com/file/d/1n5o3GE-KFqzYGFOHG4NuQsNj55KNfg8_/view?usp=sharing)", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@mixkinomi/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3606920, "client_id": 2972867, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/2ce4d3b9/uploads/origins/3db342b9-8ccb-4bc3-be33-14755a28ad5a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d162ebfe23aa8b2969a18d03eeebd0f0", "srcset": "https://si.imgix.net/2ce4d3b9/uploads/origins/3db342b9-8ccb-4bc3-be33-14755a28ad5a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d162ebfe23aa8b2969a18d03eeebd0f0, https://si.imgix.net/2ce4d3b9/uploads/origins/3db342b9-8ccb-4bc3-be33-14755a28ad5a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=6afe2c0d7acc4db929d43d78da98643a 2x, https://si.imgix.net/2ce4d3b9/uploads/origins/3db342b9-8ccb-4bc3-be33-14755a28ad5a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=60932ee4194410318f58705a8673c9d0 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/2ce4d3b9/uploads/origins/3db342b9-8ccb-4bc3-be33-14755a28ad5a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=1d355d6eacf9d3189e23fb4743f580da", "srcset": "https://si.imgix.net/2ce4d3b9/uploads/origins/3db342b9-8ccb-4bc3-be33-14755a28ad5a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=1d355d6eacf9d3189e23fb4743f580da, https://si.imgix.net