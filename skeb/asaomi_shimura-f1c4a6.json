se, "tip_acceptable": true, "yearly_report_client_visible": false, "total_appeals_count": 0, "received_works": [{"path": "/@asaomi_shimura/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 100537, "client_id": 57472, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/30b41f41/uploads/origins/06be6d7f-fc46-44a7-a644-6765c8e26cbf?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a395d798cd6ef63bfac5034912993662", "srcset": "https://si.imgix.net/30b41f41/uploads/origins/06be6d7f-fc46-44a7-a644-6765c8e26cbf?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a395d798cd6ef63bfac5034912993662, https://si.imgix.net/30b41f41/uploads/origins/06be6d7f-fc46-44a7-a644-6765c8e26cbf?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=5851db8e8d4248dd626ac13b075bcb8f 2x, https://si.imgix.net/30b41f41/uploads/origins/06be6d7f-fc46-44a7-a644-6765c8e26cbf?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=4db441e3552f8d5168fd890906df165c 3x"}, "duration": null, "nsfw": true, "hardcore": true, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/30b41f41/uploads/origins/06be6d7f-fc46-44a7-a644-6765c8e26cbf?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0127566953c6af8e975f8b8d448efa7e", "srcset": "https://si.imgix.net/30b41f41/uploads/origins/06be6d7f-fc46-44a7-a644-6765c8e26cbf?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0127566953c6af8e975f8b8d448efa7e, https://si.imgix.net/30b41f41/uploads/origins/06be6d7f-fc46-44a7-a644-6765c8e26cbf?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=16557e376b22ed683264bfbf750885d1 2x, https://si.imgix.net/30b41f41/uploads/origins/06be6d7f-fc46-44a7-a644-6765c8e26cbf?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=9f0cbf34485eb8c20bf817f7387232e1 3x"}, "body": "アサオミ先生どうも初めまして。\nこの度は先生のオリジナルキャラクターである、どスケベメイドカフェの従業員「みろろちゃん」と「めゆ先輩」二人による乳首×乳首での「ニプルセックス」（ニプルファック）絵をご依頼させて戴きたく存じます。\n\n陥没乳首の皺に唯入れる、或いは乳首同士を普通に擦り合わせている形ではなく、資料先のように「勃起した乳首同士で行って」いる、「ガチのニプルファック」プレイを希望します。\n（挿入側の乳頭が相手側の乳管～乳腺にまで達している形のニプルファックで何卒）\n\n・受け乳首はみろろ、攻め乳首はめゆ。\n\n・乳頭の結合部からは乳首セックスで撹拌されて泡立った母乳が溢れ出しており、飛沫が両者の顔面をベットリと濡らしてしまう程に多量。\n\n・カフェの裏メニュー的な「仕込み」を名目に、受け役の乳腺内部に攻め役の母乳を注ぎ込み熟成させる為に選ばれた二人が乳首セックスを行う、という背景。\n\n・二人の台詞の挿入もお願い致します。\n\n・乳首挿入セックス→乳腺内射乳→受け止めきれなくなった母乳が乳腺を逆流して攻め役（めゆ）の乳腺内部に戻ってきてしまい、結合が離れて爆発する射乳の流れを希望したいのですが、予算内で、かつ出来ればで一向に構いません。\n（先生の乳腺内部描写（skeb.jp/@ASAOMINCEPIE/works/2）（skeb.jp/@ASAOMINCEPIE/works/1）が物凄く大好きでして、噴乳した娘の母乳が相手役の乳腺内部をこってり犯し逆流、自身が生成した濃厚母乳を押しのけながら混ざり合い膨らんでしまっているのが解る「二人分の乳腺の透過画像」の挿入をお願いします。射乳中の「どくっ…❤︎どくっ…❤︎」「びゅりゅう～～っ❤︎」等の重体液が乳腺を犯しつつ駆け巡るのが解る擬音等を描写戴けると誠に幸いです）\n\n・お互いの表情は初めてのプレイに不安こそあれ、好奇心満載かつプレイが始まると気持ち良すぎてどうにかなってしまいそうな感じで。\n\n・仕上げはモノクロの漫画形式を希望します。\n\nこのような性癖の塊な依頼で申し訳ございません。\n先生の描くNFプレイを拝見したく送信させて戴きました。\n可能であればで構いませんので何卒ご一考の程宜しくお願い申し上げます。\n\nskeb.jp/@ponchi_89/works/13\nskeb.jp/@isago_s/works/3\n\nhttps://www.pixiv.net/artworks/89000915", "nc": 163, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@asaomi_shimura/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 100537, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/a96a008d/uploads/origins/2b875cbf-0d7b-41bc-83bf-a0df82f609f0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=41cb9893e92e09ff3e2174ef930863ca", "srcset": "https://si.imgix.net/a96a008d/uploads/origins/2b875cbf-0d7b-41bc-83bf-a0df82f609f0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=41cb9893e92e09ff3e2174ef930863ca, https://si.imgix.net/a96a008d/uploads/origins/2b875cbf-0d7b-41bc-83bf-a0df82f609f0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=09264000a48856f481409b94d0d23633 2x, https://si.imgix.net/a96a008d/uploads/origins/2b875cbf-0d7b-41bc-83bf-a0df82f609f0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=72163a540ada1929c4a1801a200ed6c5 3x"}, "duration": null, "nsfw": true, "hardcore": true, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/a96a008d/uploads/origins/2b875cbf-0d7b-41bc-83bf-a0df82f609f0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a54e45dae2810c50204059dc3dee2299", "srcset": "https://si.imgix.net/a96a008d/uploads/origins/2b875cbf-0d7b-41bc-83bf-a0df82f609f0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a54e45dae2810c50204059dc3dee2299, https://si.imgix.net/a96a008d/uploads/origins/2b875cbf-0d7b-41bc-83bf-a0df82f609f0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=d7d1e90f35199fda83ede4d5e79e5e73 2x, https://si.imgix.net/a96a008d/uploads/origins/2b875cbf-0d7b-41bc-83bf-a0df82f609f0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=30544659df5c272451899033bcbe210b 3x"}, "body": "https://skeb.jp/@ASAOMINCEPIE/works/1\nこちらの作品がとても素晴らしかったので、同様の断面図描写のある以下のようなものをお願いしたいのですがいかがでしょうか。（若干ニプルファック表現があります。）\n\nみろろちゃんで、\n母乳が大量に詰まってパンパンの、ものすごく重そうにぶら下がる感じのおっぱい最深部までストローを挿入され、乳腺から直接母乳を吸われる。\n\n急激に全部吸い尽くされて完全に母乳がなくなってしまったことで、萎んでハリがないような感じの、フニャンとした超柔らかおっぱいになってしまう。（垂れた感じが出てると嬉しいです）\n\n母乳の出が悪くなったので、強く揉まれたり、根本から引っ張るように絞られ、\nおっぱいが柔らかすぎて原型を留めないくらい変形している。\n（伸びたり潰れたり変な形になってると大変嬉しいです）\n\nという感じのものをお願いしたいのですがいかがでしょうか。", "nc": 170, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@asaomi_shimura/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 100537, "client_id": 174042, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/22c242c5/uploads/origins/8f23db81-6ee1-4a15-b110-34d75fc453ce?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=431478cda9c5aef60ef9a006ffccd4da", "srcset": "https://si.imgix.net/22c242c5/uploads/origins/8f23db81-6ee1-4a15-b110-34d75fc453ce?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=431478cda9c5aef60ef9a006ffccd4da, https://si.imgix.net/22c242c5/uploads/origins/8f23db81-6ee1-4a15-b110-34d75fc453ce?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=0c697f065b25f1cb5e8220ed4ecb0153 2x, https://si.imgix.net/22c242c5/uploads/origins/8f23db81-6ee1-4a15-b110-34d75fc453ce?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=8936325d7cbff342d2bd54173820d2af 3x"}, "duration": null, "nsfw": true, "hardcore": true, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/22c242c5/uploads/origins/8f23db81-6ee1-4a15-b110-34d75fc453ce?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6bf89ffec977f49f16b91b7f091634fa", "srcset": "https://si.imgix.net/22c242c5/uploads/origins/8f23db81-6ee1-4a15-b110-34d75fc453ce?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6bf89ffec977f49f16b91b7f091634fa, https://si.imgix.net/22c242c5/uploads/origins/8f23db81-6ee1-4a15-b110-34d75fc453ce?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=c66f70734628cc9914208d72895c56de 2x, https://si.imgix.net/22c242c5/uploads/origins/8f23db81-6ee1-4a15-b110-34d75fc453ce?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=3b90b56c4f9fc68f1d387c4a40ea41f6 3x"}, "body": "はじめまして。チチノメコと申します。\nアサオミ様の描かれるおっぱい責めと乳首責め、そして母乳描写が最高でしたのでリクエストさせていただきます。\n\n内容は、アサオミ様のキャラクター「みろろちゃん」が男性のお客様にとにかく乳首を責められ、おっぱいを握り潰されて母乳を大量に噴き出すというものです。\n\n男性は目なしの丸ハゲでお願いします(見た目無個性)。\n\n当方、おっぱいの中身……つまり乳腺描写が大好きで、乳腺描写もお願いしたいです。\n\n\nこちらの絵師様のようなデフォルメ気味の乳腺描写\nhttps://www.pixiv.net/artworks/89865672 \nhttps://www.pixiv.net/artworks/90325091 \n\nまたはこちらの絵師様のようなリアルな乳腺描写(閲覧注意)\nhttps://www.pixiv.net/artworks/78610012 \n\nどちらかの描写をお願いしたいです。\n個人的にはリアル描写が好きなのですが、これはかなり好みが分かれるので、難しかったらデフォルメ気味乳腺描写でも大丈夫です。\n\n少額で厚かましいでしょうが、可能ならカラー、無理なのであればモノクロでお願いします。\nそしてスケベメイドカフェシリーズのように「漫画」でお願いします。\n\n\n流れとしては――\n1:お客様が来店して、いきなりみろろちゃんが乳責めされる。\n2:最初にひたすら乳首を責められる(過激IV撮影たるる編、メイドカフェ♡めゆ編のような無遠慮の力一杯の全力乳首責め)。\n3:乳首責めで大量の母乳が噴き出す(とにかくとんでもない量)。この時、床に母乳が大量に飛び散る描写があるといいです。\n4:メイドカフェ1のような握り潰す乳揉み。ここでも大量の母乳が出る。\n5:とにかくひたすら乳潰し、乳首責め、乳揉みされて、最後に思いっきり絶頂して今までで最大の量の母乳を噴き出す。この時の母乳は粘ついた粘性母乳でお願いします。床、みろろちゃんの体に母乳が付着している様子で〆。\n\n乳責めが始まったときから終わりまで、すべてのおっぱいで乳腺描写を描いていただきたいです。そして乳腺の中に母乳が作られて溜まっていく様子、握り潰されてグシャっとなってる乳腺、母乳が勢いよく乳管を流れ溢れていく様子をお願いします。\n\n無理難題となってしまいますが、是非ともよろしくお願いします！", "nc": 59, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}], "sent_works": [], "similar_creators": [{"id": 127392, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "ガニメデSkeb依頼募集中（5件作業中）", "screen_name": "ganimedevyt", "avatar_url": "https://pbs.twimg.com/profile_images/1112720426981982210/bDi57ldh.png", "header_url": "https://pbs.twimg.com/profile_banners/964394501245566976/1742470896/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 7, "complete_expiration_days": 60, "skills": [{"genre": "art"}], "nc": 48}, {"id": 219708, "creator": true, "nsfw_acceptable": true, "acceptable": false, "name": "超暇神Ｚ", "screen_name": "gnk4649", "avatar_url": "https://pbs.twimg.com/profile_images/1980968108996149248/JK1JioTD.jpg", "header_url": "https://pbs.twimg.com/profile_banners/998995199773691905/1567631847/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "art"}], "nc": 177}, {"id": 276807, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "トウドリ", "scree