エストしています。\n例：https://www.pixiv.net/en/artworks/120971135\n\nキャラ：けいおん！の田井中律\nhttps://files.catbox.moe/fh3x6q.png\n設定：夜の律は、金目当てで見知らぬ男とやる娼婦だ。\n\n詳細：\n・アメスクに改造された学制服を着ている\n・肌と髪は普通の色\n・胸はあまり大きくない\n・カメラに向かってメスの顔をしている\n\n可能性があれば、以下の点をON・OFF可能なPSDレイヤーでお願いします\n・ビッチなメイク\n・太ももに描かれた正の字\n・胸の上部に大きな文字で書かれていた：「WHORE」\n・下腹部に書かれていた：「CUM　DUMP」\n\nご検討よろしくお願いします。", "nc": 48, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@barenaitoomotte/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2477898, "client_id": 2928790, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/c1699634/uploads/origins/a0c1b5fb-44e3-48e4-8ccb-284058b1a784?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=af1de6ebee06222e3e8a3650c248c11d", "srcset": "https://si.imgix.net/c1699634/uploads/origins/a0c1b5fb-44e3-48e4-8ccb-284058b1a784?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=af1de6ebee06222e3e8a3650c248c11d, https://si.imgix.net/c1699634/uploads/origins/a0c1b5fb-44e3-48e4-8ccb-284058b1a784?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e35dfdcbdd930e92c74bec646b37343d 2x, https://si.imgix.net/c1699634/uploads/origins/a0c1b5fb-44e3-48e4-8ccb-284058b1a784?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e10f4910e9031a6fad49f7d43fce21eb 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/c1699634/uploads/origins/a0c1b5fb-44e3-48e4-8ccb-284058b1a784?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=7de26d16b77e177e36cff45915b6d2f3", "srcset": "https://si.imgix.net/c1699634/uploads/origins/a0c1b5fb-44e3-48e4-8ccb-284058b1a784?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=7de26d16b77e177e36cff45915b6d2f3, https://si.imgix.net/c1699634/uploads/origins/a