top&w=200&h=200&s=2342f5176277bd41debc0a96357c1c1f", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/015f00f6/uploads/origins/11faf1a9-eada-4b18-ae9e-733d82067f03?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=43b4130cfa8b7e3a34dee7e4f630204e", "src_set": ""}, "body": "アピールをありがとう\n\nあなたのアートが大好きです\n\n私のVtuberのキャラクターはコカトリスの女の子です。ちょっと自惚れ屋で自信家。また、おてんばで気まぐれな一面もあります（使い魔の神ヘルメスが彼女の養父であり、指導者なので）。\n\n彼女のデザインについてのメモ\n- 両耳に2つのイヤリング\n- ヘア・ジュエリーはいろいろな場所につけることができる（前髪につけるものを除く。）\n- ネックレスとチャームは完全にはつながっていない（魔法で浮いている）。\n- ベルトは金色の蛇のデザイン\n- 鼻から眉にかけての肌の色が薄い。\n\nほろ酔い加減で登場させたい！(普段はアップルサイダーやミックスドリンクを飲むので、缶を持たせたら完璧！）。\n\nこの作品を私のソーシャルメディアアカウントで使いたい（もちろんクレジット付きで）\n\nhttps://drive.google.com/drive/u/0/folders/13u2S5qqlgsqUz9kn_umAPzP4aG2rJeFA?dmr=1&ec=wgc-drive-hero-goto&fd=true", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@tr91641m/works/72", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/a5560d48/uploads/origins/2db3c951-59cd-464d-a0cb-3ac9c5c30749?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=16e039fe750b7d4fdae58392a03b7ecf", "src_set": ""}, "private": true, "genre": "art", "tipped": true, "creator_id": 2594252, "client_id": 3433967, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 16, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@tr91641m/works/71", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2594252, "client_id": 2636450, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/e43b7991/uploads/origins/38c8cbe7-0df0-4a31-84e5-b1d6e22ae214?bg=%23fff&auto=format%2Ccomp