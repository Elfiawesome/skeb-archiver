5034/uploads/origins/078625cc-229b-4e3d-a0b5-37e165b118d4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=63adac56271e0c820d365190f866ad43", "srcset": "https://si.imgix.net/b2945034/uploads/origins/078625cc-229b-4e3d-a0b5-37e165b118d4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=63adac56271e0c820d365190f866ad43, https://si.imgix.net/b2945034/uploads/origins/078625cc-229b-4e3d-a0b5-37e165b118d4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=af43871a9575a5c87909e47a2045c702 2x, https://si.imgix.net/b2945034/uploads/origins/078625cc-229b-4e3d-a0b5-37e165b118d4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=6de01c78ea80d56eec0e7eaffe2015d0 3x"}, "body": "拝啓　マルシエン先生\nいつもお世話になっております。\n先生の可愛らしいイラストはぼすきーで常々拝見しており、日々明るく楽しい気持ちを頂いております。\n\nさて、本日筆を取らせて頂いたのは、先生の画力を見込んでひとつ描いていただきたい結月ゆかりを思いついたためです。\n\n先生は二者の圧倒的な体格差から生じる非対称的なやりとりの中で生まれる情緒についてご存知でしょうか？巨大な少女の、無意識的な動きに翻弄される小さな存在……。その矮小な存在の視点から繰り広げられる、ダイナミックな天変地異としての巨体の生命活動。その落差からは、時として想像を絶する情感を生み出します。\n\nところで、情感といえば「大人の女性の情感あふれる声」という言葉があります。これは結月ゆかりの素晴らしい美声を表現した文章です。\n\nそこで、先生には「巨大な結月ゆかりの身体の上で楽しくキャンプファイヤーに興じる何人かの結月ゆかり雫」という構図のイラストを描いていただきたいと思います。\n\n構図や、雫ちゃんたちがどこでキャンプファイヤーをするかは先生にお任せいたしますが、困ったような慈しむような表情でゆかりさんがキャンプファイヤーする雫ちゃんたちを見下ろしているような構図で大きさの対比をして頂けると幸いです。\n\nご検討のほど、よろしくお願いいたします。\n敬具\n\nエボルオスカー", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@marusien2/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 981250, "client_id": 1381112, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/dcd8b09d/uploads/origins/fcd4a43a-83e6-4c04-a2f7-857373bc891d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=700ea30ea7b459cddc44ba36814c9426", "srcset": "https://si.imgix.net/dcd8b09d/uploads/origins/fcd4a43a-83e6-4c04-a2f7-857373bc891d?bg=%23f