ームの影響で目にハートを浮かべて、自分自身の行動に戸惑い頭にハテナを浮かべているのを\n　押し倒されたアルバスの視点（エクレシアの顔アップ）で見た構図\n・エクレシアの作中時期（教導の聖女、追放者、白の聖女、開かれし大地etc...）はお任せしますが\n　開かれし大地の時期は既に好感度MAXな気がするので、追放者～白の聖女辺りだと嬉しいです\n\n解釈違い等あれば断ってもらって大丈夫です\nよろしくお願いします！", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@shi4see/works/46", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2690878, "client_id": 616482, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/d7d6286e/uploads/origins/c65da43d-8847-4341-a07e-8811e7fb282c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f5a81d765a0b16bddc1b4a81f908cc44", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/d7d6286e/uploads/origins/c65da43d-8847-4341-a07e-8811e7fb282c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=8f2b48564129fcbdf14a4fff54c7b41f", "src_set": ""}, "body": "またリクエスト失礼いたします。\n\nキャラメイクRPG世界樹の迷宮1の\n金パラディン♂と赤ソードマン♂中心の落書き詰め合わせをお願いいたします。\n\n【詳細】\n・衣装の細かい装飾品等は省略していただいて大丈夫です。\n・原作ゲームプレイ済み前提の資料となっているため、わかりにくい部分などは読み飛ばしていただいて大丈夫です。\n・パラディン×ソードマン、金アルケミスト×ソードマンが推しCPですが、BL要素の有無はどちらでも大丈夫です。\n・構図、シチュエーション、解釈などお任せいたします。ご自由に描いてくださいますと幸いです。\n\nご検討のほど、よろしくお願いいたします。\n\n資料URL\nhttps://www.dropbox.com/scl/fo/o9qrlao1r4xxl8c9g8a0e/h?rlkey=scxep8exwxn5frj00ld1gzxti&dl=0", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@shi4see/works/45", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2690878, "client_id": 616482, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/f296ac56/uploads/origins/6907bcc5-6f65-47f9-8785-13b18d86bfd1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9212ea322320796c9e721cc6dc35e510", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, 