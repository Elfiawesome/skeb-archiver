/uploads/origins/7b11a2e5-6127-4b8b-9cf5-df01d7dc6dde?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=03125ebf04763d9f7121f350b0a84e7d 2x, https://si.imgix.net/56a74542/uploads/origins/7b11a2e5-6127-4b8b-9cf5-df01d7dc6dde?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=edcfd94e190495345ef5e89867869a80 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/56a74542/uploads/origins/7b11a2e5-6127-4b8b-9cf5-df01d7dc6dde?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3622b589bd7844bcc23954a6d8853a45", "srcset": "https://si.imgix.net/56a74542/uploads/origins/7b11a2e5-6127-4b8b-9cf5-df01d7dc6dde?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3622b589bd7844bcc23954a6d8853a45, https://si.imgix.net/56a74542/uploads/origins/7b11a2e5-6127-4b8b-9cf5-df01d7dc6dde?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=d7d27cfaf99bba17d3ddce64049f5025 2x, https://si.imgix.net/56a74542/uploads/origins/7b11a2e5-6127-4b8b-9cf5-df01d7dc6dde?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=f16ca31561697349137620e3cdb89d15 3x"}, "body": "ゆせらさんの色彩やふわっとした可愛いイラストが好きでずっと依頼したいと思っていました！\n今回依頼させていただくのは収益化済のYouTubeチャンネルのサムネやおはついなどのツイートで使用できるイラストです。\n背景があった場合背景透過もあると嬉しいです。\nポーズや表情はおまかせしますので私をゆせらさんらしさのある可愛いイラストで描いていただきたいです！\nよろしくお願いします。\n\nhttps://twitter.com/p0n_tori_um/status/1657700637436690433?s=46&t=vBKzLxbB3RlhcBeYsMMNIQ", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@yusera____/works/9", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1852708, "client_id": 2449891, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/acf7c61d/uploads/origins/21523e58-8d19-40c3-894a-77adda38f42e?bg=%23fff&auto=format