で、ハートのハイライトと、ピンク系青系黄色系の控えめワンポイントが入っています(ハートもワンポイントも位置や形はどこでもかまいません！)\n以下のURLは桃江ゆうの立ち絵が載っているツイートになります\nhttps://twitter.com/mmeyuuchan/status/1504062425343328256?s=46&t=8PvlU2KDEFEGYOYTGVPS-w\n\n・使用用途\nTwitter等SNSでの利用、YouTubeのサムネイル、ネットプリント\n\n人物のみの背景透過版もいただけるととても嬉しいです。\nもし説明でわからない部分がございましたら、ゆせらさんの思うように描いていただきたいです！\n大変お忙しいかと存じますが、どうぞよろしくお願いいたします。\n\nhttps://twitter.com/mmeyuuchan/status/1504062425343328256?s=46&t=8PvlU2KDEFEGYOYTGVPS-w", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@yusera____/works/8", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1852708, "client_id": 940289, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/c1378f19/uploads/origins/66d15210-ac47-430d-aa95-5b4bf89887cd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=335171b410e65ab329200484143c009c", "srcset": "https://si.imgix.net/c1378f19/uploads/origins/66d15210-ac47-430d-aa95-5b4bf89887cd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=335171b410e65ab329200484143c009c, https://si.imgix.net/c1378f19/uploads/origins/66d15210-ac47-430d-aa95-5b4bf89887cd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=df4e5cfb5884bbd3f8cface93a8d04f5 2x, https://si.imgix.net/c1378f19/uploads/origins/66d15210-ac47-430d-aa95-5b4bf89887cd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=153a877b4f3daf0e7a3ad44105cdea0d 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/c1378f19/uploads/origins/66d15210-ac47-430d-aa95-5b4bf89887cd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=332bf79503d98e82b62a8b2975ef2f52", "srcset": "https://si.imgix.net/c1378f19/uploads/origins/66d15210-ac47-430d-aa95-5b4bf89887cd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=