x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/c097f00a/uploads/origins/6f1046ee-6938-4a86-92d7-e9ce5ac25dc7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=38dc6d3bd44666476f6c9c4df7cc0dd1", "srcset": "https://si.imgix.net/c097f00a/uploads/origins/6f1046ee-6938-4a86-92d7-e9ce5ac25dc7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=38dc6d3bd44666476f6c9c4df7cc0dd1, https://si.imgix.net/c097f00a/uploads/origins/6f1046ee-6938-4a86-92d7-e9ce5ac25dc7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=b89fdb73ca91299b8bc29e0e5ed14630 2x, https://si.imgix.net/c097f00a/uploads/origins/6f1046ee-6938-4a86-92d7-e9ce5ac25dc7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=2cc736d4188b5c9face3ea94a46e128c 3x"}, "body": "こんにちは、Syu-San。期限を延長する必要がある場合に備えて、事前に送ったリクエストを再送します！\n\n雨の日、傘をさしているか、傘をさしていないか、どちらかのポーズで描いていただけませんか？ポーズは2つ用意しましたが、好きなポーズを選んでください！\n\n前髪を少し長めにして、左目が一部隠れるように描いてください。彼女は笑わないので、表情はニュートラルか暗い感じでお願いします！\n\nありがとうございました\n\nhttps://drive.google.com/drive/folders/1Mhsp6dgrUOpv7E9ktqlmE7ejqR8-wdK3?usp=sharing\n\nhttps://drive.google.com/drive/folders/1Mhsp6dgrUOpv7E9ktqlmE7ejqR8-wdK3?usp=sharing", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@syuu_NL/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2196637, "client_id": 1786522, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/a92043aa/uploads/origins/b745dd27-d8e3-4f9e-b6c2-880ac4e95496?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2212d6dd9bcf940bd81843f39345a7f5", "srcset": "https://si.imgix.net/a92043aa/uploads/origins/b745dd27-d8e3-4f9e-b6c2-880ac4e95496?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2212d6dd9bcf940