ながらもなんとか食べ尽くしてゲップをするケイとその膨れたお腹を撫でるユズをお願いします。", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@SaLtgyomagyoma/works/9", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3457349, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/9fdb78b2/uploads/origins/e6a067c8-ab78-4606-8937-f462fd816669?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ff32618ed8ab01991ff10a98924cd6dd", "srcset": "https://si.imgix.net/9fdb78b2/uploads/origins/e6a067c8-ab78-4606-8937-f462fd816669?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ff32618ed8ab01991ff10a98924cd6dd, https://si.imgix.net/9fdb78b2/uploads/origins/e6a067c8-ab78-4606-8937-f462fd816669?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=4090987adee51790b9ce2aca5d114cc9 2x, https://si.imgix.net/9fdb78b2/uploads/origins/e6a067c8-ab78-4606-8937-f462fd816669?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=8ce56d3faa5f9115ddc33d88d8686bd5 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/9fdb78b2/uploads/origins/e6a067c8-ab78-4606-8937-f462fd816669?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6f2f63dcca6590ca75a9c77f4217b1d4", "srcset": "https://si.imgix.net/9fdb78b2/uploads/origins/e6a067c8-ab78-4606-8937-f462fd816669?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6f2f63dcca6590ca75a9c77f4217b1d4, https://si.imgix.net/9fdb78b2/uploads/origins/e6a067c8-ab78-4606-8937-f462fd816669?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=8342f9d748d57a2710abff7c140d54ee 2x, https://si.imgix.net/9fdb78b2/uploads/origins/e6a067c8-ab78-4606-8937-f462fd816669?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=361d1cd42324854f10f5ee6890f9387f 3x"}, "body": "頭身が縮んでしまったブルアカの剣先ツルギと羽川ハスミの漫画をお願いします。\n胸が大きくて困っているハスミ。それを見てツルギは妬んでいた。\nハスミは通販で頼んでおいた、胸を小さくするサプリが届く。\n早速サプリを飲む。おやつを食べようとしている。\nすると早速効果が現れたが、他の部分もどんどん小さくなり、2頭身になってしまった。\nハスミは最初は困っていたが、すぐに小さくなったことによりいっぱい食べれることに気付き、近くにあったおやつを全部平らげた。\nだがそれはツルギのであり、ツルギは怒ってハスミを追いかける。\nハスミはてちてち逃げ、通気口に入る。\nツルギは追いかけるが、入口が小さくて入れない。\nツルギは仕方なくサプリを飲み、2頭身になる。\n2人はてちてち追いかけっこをし、追い詰められたハスミはサプリを投げる。ツルギも同じく投げ、互いの口の中に入る。\n2人は更に小さくなり、1.5頭身になってしまう", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@SaLtgyomagyoma/works/8", "private_thumbnail_image_urls": null, "private": false, "genre": "comic", "tipped": false, "creator_id": 3457349, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/a14dda00/uploads/origins/dcc1dfb1-9e10-49b6-ba3b-932e84fb9f27?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1160ec29193cc55f80647d002d534b5c", "srcset": "https://si.imgix.net/a14dda00/uploads/origins/dcc1dfb1-9e10-49b6-ba3b-932e84fb9f27?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1160ec29193cc55f80647d002d534b5c, https://si.imgix.net/a14dda00/uploads/origins/dcc1dfb1-9e10-49b6-ba3b-932e84fb9f27?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=4ff63d62e0705136226f673ac3797113 2x, https://si.imgix.net/a14dda00/uploads/origins/dcc1dfb1-9e10-49b6-ba3b-932e84fb9f27?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=48911b1865ebf72b4089cf1965e9152c 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/a14dda00/uploads/origins/dcc1dfb1-9e10-49b6-ba3b-932e84fb9f27?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=dd4202331079b4d5a6df3f9af27bbe0a", "srcset": "https://si.imgix.net/a14dda00/uploads/origins/dcc1dfb1-9e10-49b6-ba3b-932e84fb9f27?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=dd4202331079b4d5a6df3f9af27bbe0a, https://si.imgix.net/a14dda00/uploads/origins/dcc1dfb1-9e10-49b6-ba3b-932e84fb9f27?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=671df51d83769977a88b12c798ff963b 2x, https://si.imgix.net/a14dda00/uploads/origins/dcc1dfb1-9e10-49b6-ba3b-932e84fb9f27?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=5be15e38a83d0099f091aa355b843f78 3x"}, "body": "はじめまして。こちら↓の続きにあたる台詞付きマンガをお願いします。\nhttps://www.pixiv.net/artworks/137067464\n\n1. 前回ラストで登場した鈴木が、食べ物で腹を膨らませたくなる催眠でぐるぐる目になる。\n2. 鈴木は友人（またはツインテールちゃん）との帰宅中にあちこちで買い食いしてしまう。何かがおかしいと気付くが自制できない。\n3. 膨腹するにつれて次第にゲップと腹鳴が悪化する。並行して下半身の肥満化（膨尻＋太ももムチムチ化）が進む。\n4. 最終的にこちら↓の2ページ目ぐらい膨腹し、腹を揺らしてゲップしまくるのに快感を覚える（鈴木本人は認めまいとする）\nhttps://www.pixiv.net/artworks/139163233\n\nぎょま塩さんの都合に応じてご自由に改変・省略していただいて構いません。ご検討のほどよろしくお願いします。", "nc": 184, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@SaLtgyomagyoma/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "comic", "tipped": true, "creator_id": 3457349, "client_id": 3815995, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/d2019617/uploads/origins/97a5a5c4-91a5-4bef-9aea-620b6bcea085?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9f5281a817c623aebc0cad64c6c84308", "srcset": "https://si.imgix.net/d2019617/uploads/origins/97a5a5c4-91a5-4bef-9aea-620b6bcea085?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9f5281a817c623aebc0cad64c6c84308, https://si.imgix.net/d2019617/uploads/origins/97a5a5c4-91a5-4bef-9aea-620b6bcea085?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b0f837f65f85ce3facceb19bd18622c9 2x, https://si.imgix.net/d2019617/uploads/origins/97a5a5c4-91a5-4bef-9aea-620b6bcea085?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ef6f9440f73102b2531b5ed771ea7d54 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/d2019617/uploads/origins/97a5a5c4-91a5-4bef-9aea-620b6bcea085?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6c4b4e64502f3a9366bf18abcb124883", "srcset": "https://si.imgix.net/d2019617/uploads/origins/97a5a5c4-91a5-4bef-9aea-620b6bcea085?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6c4b4e64502f3a9366bf18abcb124883, https://si.imgix.net/d2019617/uploads/origins/97a5a5c4-91a5-4bef-9aea-620b6bcea085?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=76df4c1aebcd3cbcff37e88647da574f 2x, https://si.imgix.net/d2019617/uploads/origins/97a5a5c4-91a5-4bef-9aea-620b6bcea085?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=59f1d87d5d381a67fe906bab6d9c7bab 3x"}, "body": "トヨタヒマメのライバルを作っていただけませんか？陰陽家っぽくて怪しいお姉さんタイプだと思っています。\n話\nトヨタマはライバルに文句を言う。喧嘩するところで作者は間に入って競技を勧める。トヨタマは受け入れた直後に攻撃する。ライバルはそれをかわすので、作者が攻撃を食らう。非暴力とかき口説く。我慢を試しないか？最初に理性を失った者が勝負を決める。\nさてはトヨタマとライバルはお互いに呪う。相手は牛の呪を唱えながらトヨタマはギャルの呪を唱える。彼らは多数の呪詛を浴びせかける。膨乳、膨尻、肥大、母乳、強制発情、などなど。\nとうとうライバルはとどめにして鏡の呪いを唱え始める。この呪いは自分の受けた呪詛を全部写して送る。トヨタマは必死に同じ呪いを唱える。結局,下品な動くないほど肥大の二人が理性を失っちゃた。あと、占い師がたまたま過ぎて、機会を逃すのない人で、どうにか二人を倉庫に渡して搾乳して乳を売りさばく", "nc": 169, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@SaLtgyomagyoma/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "comic", "tipped": false, "creator_id": 3457349, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/d12df22a/uploads/origins/897882b3-0190-4567-b35c-7fa3a55728a7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=086ecc0f76973fb75252c6cf082ec436", "srcset": "https://si.imgix.net/d12df22a/uploads/origins/897882b3-0190-4567-b35c-7fa3a55728a7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=086ecc0f76973fb752