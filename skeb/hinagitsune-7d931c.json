075\n・合成音声カバー\nhttps://utaloader.net/music/20230513184448086150\n\nhttps://misskey.design/notes/9eba0l2pfo", "nc": 1, "word_count": 0, "transcoder": "audio", "creator_acceptable_same_genre": false}], "similar_creators": [{"id": 975270, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "みつみ しい☕プレゼント企画中", "screen_name": "mitumi_ci", "avatar_url": "https://pbs.twimg.com/profile_images/2054053031151562752/s4tf3Kmt.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1587131965093789696/1773408548/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 3, "complete_expiration_days": 60, "skills": [{"genre": "art"}], "banned": false, "nc": 0}, {"id": 1466913, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "めだかＨ2", "screen_name": "killifish_", "avatar_url": "https://pbs.twimg.com/profile_images/1959306089717248000/k3r7BBey.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1029339481122295808/1749563042/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "art"}, {"genre": "correction"}], "banned": false, "nc": 177}, {"id": 1511252, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "む～んべる", "screen_name": "moonbell00", "avatar_url": "https://pbs.twimg.com/profile_images/1750794466397655040/30qtlOcR.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1466493762168057856/1707025088/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 7, "complete_expiration_days": 60, "skills": [{"genre": "art"}], "