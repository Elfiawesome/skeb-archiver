こがれている。\n（野犬に襲われかけたところを偶然助けられたため）\n軍艦島と呼ばれるスラム街（現実で言う西成区あいりん地区あたり）に住む路上生活者。\n亜侠と呼ばれるなんでも屋として生活費を稼いでおり、\n表向きは風俗店の広告人夫として働いている。", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@_hysk_/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 622906, "client_id": 839466, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/669ef34a/uploads/origins/8328ce34-cf80-4a39-a354-ecf8a44542c8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7a7273a08be5b01e77bc40a07f6609ae", "srcset": "https://si.imgix.net/669ef34a/uploads/origins/8328ce34-cf80-4a39-a354-ecf8a44542c8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7a7273a08be5b01e77bc40a07f6609ae, https://si.imgix.net/669ef34a/uploads/origins/8328ce34-cf80-4a39-a354-ecf8a44542c8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=79b0d1835abf56e678abea278edf421f 2x, https://si.imgix.net/669ef34a/uploads/origins/8328ce34-cf80-4a39-a354-ecf8a44542c8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=791a3ac3a6fe2ca66a10f47d36f5a632 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/669ef34a/uploads/origins/8328ce34-cf80-4a39-a354-ecf8a44542c8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e1abfb56254736f74c73c2a91cce53ff", "srcset": "https://si.imgix.net/669ef34a/uploads/origins/8328ce34-cf80-4a39-a354-ecf8a44542c8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e1abfb56254736f74c73c2a91cce53ff, https://si.imgix.net/669ef34a/uploads/origins/8328ce34-cf80-4a39-a354-ecf8a44542c8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=b05b3a52bbc796f4a547cc46fb7311fb 2x, https://si.imgix.net/669ef34a/uploads/origins/8328ce34-cf80-4a39-a3