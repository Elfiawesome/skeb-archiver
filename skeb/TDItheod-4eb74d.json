55155a/uploads/origins/e1359993-acf4-433c-8244-cff2bb2f2252?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=21b61513475e147549f49ac99504a98f, https://si.imgix.net/e855155a/uploads/origins/e1359993-acf4-433c-8244-cff2bb2f2252?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=41672cc3c46d101fe5aca2c5a0577cd0 2x, https://si.imgix.net/e855155a/uploads/origins/e1359993-acf4-433c-8244-cff2bb2f2252?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=6b2e8857f414f64b19df8b1faaace43a 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/e855155a/uploads/origins/e1359993-acf4-433c-8244-cff2bb2f2252?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=50560ce6f2a911034a2cc41657e2fe6b", "srcset": "https://si.imgix.net/e855155a/uploads/origins/e1359993-acf4-433c-8244-cff2bb2f2252?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=50560ce6f2a911034a2cc41657e2fe6b, https://si.imgix.net/e855155a/uploads/origins/e1359993-acf4-433c-8244-cff2bb2f2252?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=8ccc392f9e5dd88258e93f681b8ab3ec 2x, https://si.imgix.net/e855155a/uploads/origins/e1359993-acf4-433c-8244-cff2bb2f2252?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=64dbac282396cd831b6ce6dc51bf0765 3x"}, "body": "こんにちは！いつもイラスト拝見しております。\n\nまたミリシタの最上静香を描いていただきたいです。\n\n内容は、性処理目的でオフの日に電話でプロデューサーの家に呼び出される静香。\nボロい文化住宅の和室ワンルームに敷きっぱなしの汚い布団の上で服を着たまま正常位で犯され中出しされてしまう、部屋は如何にも独身男性のそれといった感じで布団の周りにも雑誌やらゴミやらが散乱している。\n行為の後にちゃぶ台みたいな低い机の上に腰かけてタバコの灰を灰皿に落としながら、静香にフェラで後始末をさせるプロデューサーという感じでお願いします。\n\n静香本人はプロデューサーと付き合っていると思っておりデート気分で服とか髪を整えてやってきている。\nプロデューサーの方は表面上は静香に合わせているが内心は性欲処理に都合のいい女としか思っていない。\n静香の服のデザインはこの前実装された私服ガシャみたいな感じでお願いします、雰囲気似ていれば細部には拘りません。行為中は胸の部分をはだけさせられて乳房を露出させてもらいたいです、スカートは捲り上げられていて下着は片足の膝か足首に半脱ぎのまま引っ掛かっている状態だと有難いです、フェラさせられている時はせっかくセットしてきた服や髪が激しい行為のせいでくしゃくしゃになっている感じを出してもらえると嬉しいです。\n\n出来ればモノクロの漫画形式っぽく描いていただきたいです、コマ割りは話の流れが見て分かれば有りでも無しでも構いません、イラスト形式の場合は布団に押し倒されて正常位で犯されている場面と差分で中出しされて局部から精液が流れている場面とフェラで後始末させられている場面をお願いします。\n\n要求が多すぎて無理かもしれませんが可能でしたらお願いします。", "nc": 184, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@TDItheod/works/10", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2482438, "client_id": 317811, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/08cc83e1/uploads/origins/85ec63e0-6b21-43af-8406-a7c61de92193?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4600a178f0ed7fd1746b3ebfa32c200b", "srcset": "https://si.imgix.net/08cc83e1/uploads/origins/85ec63e0-6b21-43af-8406-a7c61de92193?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4600a178f0ed7fd1746b3ebfa32c200b, https://si.imgix.net/08cc83e1/uploads/origins/85ec63e0-6b21-43af-8406-a7c61de92193?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=2b75c1a7daa1eaf6fb3d6f65037d3a05 2x, https://si.imgix.net/08cc83e1/uploads/origins/85ec63e0-6b21-43af-8406-a7c61de92193?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=5a5c86d6611b29d12c15fd52178648f6 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/08cc83e1/uploads/origins/85ec63e0-6b21-43af-8406-a7c61de92193?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=84c8a34466eabd56324b10b4209017e7", "srcset": "https://si.imgix.net/08cc83e1/uploads/origins/85ec63e0-6b21-43af-8406-a7c61de92193?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=84c8a34466eabd56324b10b4209017e7, https://si.imgix.net/08cc83e1/uploads/origins/85ec63e0-6b21-43af-8406-a7c61de92193?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=