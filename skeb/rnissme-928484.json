手厚くサポートをする。バンドをしていた時期がありベースだった。動揺したり親友の前では素(少しラフな感じ)が出る。\n\n［関係性］\nアイドルとマネージャーであり、はたから見れば子と母のような関係性だが、少しづつアイドルの子は意識をしだしている。多少アイドルの子は依存傾向にあり、マネージャーはそんなアイドルを優しく見守りつつ親身になって助けてくれる。\n\n【使用用途】\nスマホやPC等の壁紙、SNSへの利用等、\n友人と私の個人の範囲内での利用をしたいと思っています。\n\nご検討のほどよろしくお願いいたします！\n\nhttps://drive.google.com/drive/folders/1NxHLL5u6z692Hq2idT0MxNOswxFySyNV?usp=drive_link", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@sekaiseihasann/works/48", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 22365, "client_id": 44481, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/878ad63e/uploads/origins/58fccd0f-fe0c-42cc-8613-be2989edcf5c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=259344ed8bc770b5e75a6c9104f74aad", "srcset": "https://si.imgix.net/878ad63e/uploads/origins/58fccd0f-fe0c-42cc-8613-be2989edcf5c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=259344ed8bc770b5e75a6c9104f74aad, https://si.imgix.net/878ad63e/uploads/origins/58fccd0f-fe0c-42cc-8613-be2989edcf5c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=976ea21007c76e7efc6d14828104e5bc 2x, https://si.imgix.net/878ad63e/uploads/origins/58fccd0f-fe0c-42cc-8613-be2989edcf5c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a9a9ddd14760bc5cdb2c7aec84021d98 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/878ad63e/uploads/origins/58fccd0f-fe0c-42cc-8613-be2989edcf5c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a1c55cfac85b81c428d6fce75699253e", "srcset": "https://si.imgix.net/878ad63e/uploads/origins/58fccd0f-fe0c-42cc-8613-be2989edcf5c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a1c55cfac85b81c428d6fce75699253e, https://si.imgix.net/878ad63e/uploads/orig