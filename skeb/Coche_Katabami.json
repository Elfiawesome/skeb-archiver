1cc4bb7a863?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=135a9ace3db03555f3ab4e08fef3fb42", "src_set": ""}, "body": "𝗞𝗮𝘁𝗮𝗯𝗮𝗺𝗶☘様、こんにちは！\nSkebの新着で素敵なイラストを拝見し、ぜひうちの子を描いていただけないかと思い、リクエストをお送りします。\n\n参考資料のフォルダの中に双子の姉妹がいます。\n赤い方が姉で、青い方が妹になります。\nわからない部分があれば想像で大丈夫ですので、どちらかお好きな方をお願いしたいです。\n\n今回御縁があれば嬉しいです。\nよろしくお願いいたします！\n\n【参考資料】\nhttps://drive.google.com/drive/u/0/folders/1HIM58iruOkrGRqzqO5bPuhLDPIJQ7cpo", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@Coche_Katabami/works/124", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/f0fdc515/uploads/origins/b794bde5-561a-4765-a792-49d0affa249a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=4cd69921317863dab2ee3a29dfa99ac0", "src_set": ""}, "private": true, "genre": "art", "tipped": false, "creator_id": 2609762, "client_id": 3478932, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 1, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@Coche_Katabami/works/123", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2609762, "client_id": 1259978, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/32f12ed8/uploads/origins/6e450d2f-ba4a-40fe-9dfa-7dee3e2a6d5c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=29fe690ffb6c1522b1768982d011e81b", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/32f12ed8/uploads/origins/6e450d2f-ba4a-40fe-9dfa-7dee3e2a6d5c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=fc35cb8b69ec695d030c10675c864a50", "src_set": ""}, "body": "こんにちは！erusha