mgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1963541355122364419%2F6ikvr1uq.jpg?blend64=aHR0cHM6Ly9za2ViLWF2YXRhci5pbWdpeC5uZXQvfnRleHQ_&blendalpha=100&blendalign=center&blendmode=normal&blendsize=inherit&bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=906e18292a19cceeaaacf45954d74730", "srcset": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1963541355122364419%2F6ikvr1uq.jpg?blend64=aHR0cHM6Ly9za2ViLWF2YXRhci5pbWdpeC5uZXQvfnRleHQ_&blendalpha=100&blendalign=center&blendmode=normal&blendsize=inherit&bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=906e18292a19cceeaaacf45954d74730, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1963541355122364419%2F6ikvr1uq.jpg?blend64=aHR0cHM6Ly9za2ViLWF2YXRhci5pbWdpeC5uZXQvfnRleHQ_&blendalpha=100&blendalign=center&blendmode=normal&blendsize=inherit&bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=8cdeb9d6a48a928b33a6d6d2c725c1fb 2x, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1963541355122364419%2F6ikvr1uq.jpg?blend64=aHR0cHM6Ly9za2ViLWF2YXRhci5pbWdpeC5uZXQvfnRleHQ_&blendalpha=100&blendalign=center&blendmode=normal&blendsize=inherit&bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=7a6cc1a389e3f0061641c1ebca44e23c 3x"}, "body": "・はじめまして、pixivの小説見てリクエスト決めました。\n　リクエストは時間停止の異種姦出産をお願いします。\n\n　世界観は時間操作する未知の生命体により、突発的無差別妊娠出産テロ現象が発生している現代社会。\n\n　シチュエーションは、大人しい真面目な貧乳の少女が登校中、時間停止に遭う。\n　未知の生命体のターゲットにされた少女は、まず細い触手でニプルファックのうえ胸を改造され、乳苗床にされる（膨乳シチュ）。\n　その後太い触手で容赦なく処女喪失し、子宮内の時間だけ早送りまたは時間停止で十月十日過ごし、臨月を迎えた状態で時間停止が解除される。\n\n　時間が戻った少女視点としては、突然自分の胸とお腹が膨らんだ状況に、頭が追い付かないまま陣痛が始まる（時間停止中に受けた快楽が解除後に一気に襲うタイプではない）。\n　突発的無差別妊娠出産テロ現象だと気付いた周りの通行人は逃げ惑うが時既に遅く、産まれた触手状の生命体が通行人を補食していく（産まれた存在は母体である少女は襲わない）。\n　自分の乳首と膣に繋がったまま、物理法則に反して自分の体を優に越える大きさで産まれた存在が、通行人を補食する光景に少女はパニックし補食やめてと思うが、同時に改造された肉体がもたらす出産時の快楽に何も考えられずアヘ顔する。\n\n　ちょっとしたエピローグ文章として、上記の様子を撮影した映像がネットに流れ、血溜まりの中でアヘ顔を決める少女が、被害者ではなく加害者として恐れられる的な説明があると嬉しいです。", "nc": 171, "word_count": 6423, "transcoder": "text", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 59860, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "ムメイ🔞（テキストマン）", "screen_name": "mumei193", "avatar_url": "https://proxy.misskeyusercontent.jp/avatar/media.misskeyusercontent.jp%2Fio%2F8956d3d3-74ac-43ce-977e-4bcb4e046542.png%3Fsensitive%3Dtrue?avatar=1", "header_url": "https://media.misskeyusercontent.jp/io/webpublic-706b15c0-aff8-4638-b80c-63f29fc2dd5f.png?sensitive=true", "appeal_receivable": true, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "novel"}], "banned": false, "nc": 176}, {"id": 343397, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "わんざっく skeb&pixivリクエスト募集中", "screen_name": "wanzach1", "avatar_url": "https://cdn.bsky.app/img/avatar/plain/did:plc:ujh4mqeg2s65xs432nmctbzv/bafkreiapn624e7lrgjnrmw5ynenagpocsshteyriomwo7mjecaw3nuyovi", "header_url": "https://cdn.bsky.app/img/banner/plain/did:plc:ujh4mqeg2s65xs432nmctbzv/bafkreigtooyixefhe7ib3n2j5bidwcl5i4ictezxj44gvbgntprczm2jga", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 90, "skills": [{"genre": "art"}, {"genre": "comic"}], "banned": false, "nc": 177}, {"id": 1261801, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "いみじゅ@小説リクエスト受付中", "screen_name": "imiju", "avatar_url": "https://pbs.twimg.com/profile_images/2071029041034092544/fBfk_Eal.jpg", "header_url": "https://pbs.twimg.com/profile_banners/106649399/1684070794/1500x500", "appeal_receivable": false, "popular_