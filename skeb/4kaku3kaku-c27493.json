t/54abf596/uploads/origins/be25182a-fae8-4873-8916-85383209586a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=08449830a437f6a537d576fbdc91e0f5 3x"}, "body": "いつもかわいい三猿ちゃんたち（特にヒヤップちゃん、ヒヤッキーちゃん）とサルノリちゃんのイラストを拝見しております。\n\nヒヤッキーちゃんがヤナッキーくんにベッドで押し倒されちゃっているイラストをお願いします。\n\nシチュエーションですが、\nヤナッキーくん視点で、偶然両手をラブ握り（指と指を絡ませる手の握り方）しちゃっている感じがいいです。\n突然のことで、「うぉ！？」みたいな顔（赤面）をしているヤナッキーくん（顔だけ）を右上に表示してほしいです。\n\n一方ヒヤッキーちゃんは、突然のことに戸惑いながらもまんざらでもないような、ちょっと笑っている感じの表情になっています。\nヒヤッキーちゃんの吹き出しに焦っている感じと照れてる感じの表現があると尚更良しです！\n突然のことだったのか、スカートのがぴらっとめくれて肌がみえちゃっています。\n\nよろしくお願いします。", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@4kaku3kaku/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 833930, "client_id": 1551577, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/22dde397/uploads/origins/6f0a8f91-adaf-4615-b79a-92a14a861dcd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=81bb1ff9d20a0759a5542e84ca21270d", "srcset": "https://si.imgix.net/22dde397/uploads/origins/6f0a8f91-adaf-4615-b79a-92a14a861dcd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=81bb1ff9d20a0759a5542e84ca21270d, https://si.imgix.net/22dde397/uploads/origins/6f0a8f91-adaf-4615-b79a-92a14a861dcd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=d19ac4799d98e9cfac86b518b2bcc321 2x, https://si.imgix.net/22dde397/uploads/origins/6f0a8f91-adaf-4615-b79a-92a14a861dcd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=304a8cfd93f8f7a49bf650d364328f26 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/22dde397/uploads/origins/6f0a8f91-adaf-4615-b79a-92a14a861dcd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=71fd186f676cc8f5e10818fa0e2c0a77", "srcset": "htt