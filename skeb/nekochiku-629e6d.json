atly appreciated.\n\n\nThank you in advance for your consideration.\n\nReference Materials\n\nhttps://drive.google.com/drive/folders/1Jiz2MorSzvaywnaMQ9G4ag5hBMWKwgbP", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@ke_ro_lingual/works/71", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1131928, "client_id": 2607063, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/9533fd3b/uploads/origins/7518745f-c387-4976-b2bb-187be94e9403?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ff94b47bf70eb137121635e0db5c8434", "srcset": "https://si.imgix.net/9533fd3b/uploads/origins/7518745f-c387-4976-b2bb-187be94e9403?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ff94b47bf70eb137121635e0db5c8434, https://si.imgix.net/9533fd3b/uploads/origins/7518745f-c387-4976-b2bb-187be94e9403?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=d654e9281a77d291000e89c4da0579ff 2x, https://si.imgix.net/9533fd3b/uploads/origins/7518745f-c387-4976-b2bb-187be94e9403?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=51874b85d3979fda54ac02d9d5d55ffa 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/9533fd3b/uploads/origins/7518745f-c387-4976-b2bb-187be94e9403?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e4440343e67b793f70191c7781786256", "srcset": "https://si.imgix.net/9533fd3b/uploads/origins/7518745f-c387-4976-b2bb-187be94e9403?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e4440343e67b793f70191c7781786256, https://si.imgix.net/9533fd3b/uploads/origins/7518745f-c387-4976-b2bb-187be94e9403?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=6ebabfff9754723b9759fe96bbd9c3e4 2x, https://si.imgix.