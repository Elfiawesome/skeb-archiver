e/uploads/origins/0d924c51-c774-4f16-914d-2bc2173fee82?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3a9eb48bbf97d8f923effdca8ab678db", "srcset": "https://si.imgix.net/53358dbe/uploads/origins/0d924c51-c774-4f16-914d-2bc2173fee82?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3a9eb48bbf97d8f923effdca8ab678db, https://si.imgix.net/53358dbe/uploads/origins/0d924c51-c774-4f16-914d-2bc2173fee82?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=2866fc0e1c73ab5c428c3678ef170d10 2x, https://si.imgix.net/53358dbe/uploads/origins/0d924c51-c774-4f16-914d-2bc2173fee82?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=4b714ab50b372cf9743d9f1755a8703f 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/53358dbe/uploads/origins/0d924c51-c774-4f16-914d-2bc2173fee82?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6767b9fa58cf98005110879b8e756dd9", "srcset": "https://si.imgix.net/53358dbe/uploads/origins/0d924c51-c774-4f16-914d-2bc2173fee82?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6767b9fa58cf98005110879b8e756dd9, https://si.imgix.net/53358dbe/uploads/origins/0d924c51-c774-4f16-914d-2bc2173fee82?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=49a3a8ec53299386039c5e00ec50ec98 2x, https://si.imgix.net/53358dbe/uploads/origins/0d924c51-c774-4f16-914d-2bc2173fee82?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=ae16ee569142f5a95a152a0c254012c2 3x"}, "body": "自分の持ち主であるマスターの見抜き用オナペットになっていたら魔法カード｢巨乳化｣と罠カード｢強制絶頂装置｣を使われ、その効果で爆乳化アへ顔アクメをキメる遊戯王OCGのRAI-MEIとトリックスター・ホーリーエンジェルのコンビをリクエストします。\n\nキャラの造形は\n・二人とも頭身高めのむちむち、もともと巨乳位のサイズはあるが膨乳で更に大きくなる。\n・膨乳後はへそを超え下腹部がギリギリ隠れない程度の超乳寄りまでサイズアップする(大きい分には好きなだけ盛って下さい)\n・服装は原作と同じ物で、乳首と乳輪は共に大きめかつ勃起状態&パフィーニップルが衣装越しにくっきり浮き出ている。\n・性格のイメージは二人とも少しSっ気を持たせつつ、RAI-MEIは凛としたクールビューティ、ホーリーエンジェルは母性を感じさせる甘々なお姉さん\nといった感じでお願いします。\n\n二人の乳肉同士が密着する位の近さの横並びで股間までを写したバストアップを、以下のようなセリフを用意して欲しいです。\n\nニヤけた表情でこちらを煽り、今からオナペットになることを宣言してオナニーを催促してくる。\n↓\n目の前で｢巨乳化｣と｢強制絶頂装置｣を発動され訳も分からぬまま間抜けな叫び声を上げて絶頂する。微かに残った意識で止めさせようとするも快楽に負け更に汚い淫語を満載したアへオホ声で絶叫し、思い切り白目を剥いたアへ顔を晒しながらイキっぱなしになる。淫語をこれでもかと織り込んだ媚びるような喘ぎ声で射精を催促してくる。\n↓\n射精後。勝手にカードを使った事に怒りながらも優しい態度で褒めてくれる。\n\nとにかく下品で無様なワードで画面を埋め尽くして欲しいです。\n\nよろしくお願い致します！\n\nhttps://drive.google.com/drive/folders/1jUv87DsnPJO7pNY_UW8SRfyrto7lmJwm", "nc": 176, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@rinderon_69/works/2", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/46a1b639/uploads/origins/99f0b39b-f986-48a8-8654-4f0997a35ce5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=a808db7c15496b20669ecb79ad2be875", "srcset": "https://si.imgix.net/46a1b639/uploads/origins/99f0b39b-f986-48a8-8654-4f0997a35ce5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=a808db7c15496b20669ecb79ad2be875, https://si.imgix.net/46a1b639/uploads/origins/99f0b39b-f986-48a8-8654-4f0997a35ce5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=8df83814d4c62a51fb0d2d73bd9fb7bb 2x, https://si.imgix.net/46a1b639/uploads/origins/99f0b39b-f986-48a8-8654-4f0997a35ce5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=837ebd3a8abcc20c36d8b2eff74e97aa 3x"}, "private": true, "genre": "art", "tipped": false, "creator_id": 2795009, "nc": 163}, {"path": "/@rinderon_69/works/1", "private_thumbnail_image_urls": {"src"