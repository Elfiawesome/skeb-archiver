54mA6j5BUIWfRfg--3A\n\nI really like this idea: \"I think it would be fun to explore styles like traditional Japanese clothing or retro fashion\".\n\nご自由に描いてください。先生にとってかっこいいシーンであればうれしいです。\n\nご検討よろしくお願いします。", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}], "sent_works": [], "similar_creators": [{"id": 27046, "creator": true, "nsfw_acceptable": false, "acceptable": false, "name": "みああわ", "screen_name": "miaawa2230", "avatar_url": "https://pbs.twimg.com/profile_images/1681414110645473282/w5iCJGcU.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1001013636628856832/1659613172/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 7, "complete_expiration_days": 90, "skills": [{"genre": "art"}, {"genre": "comic"}], "banned": false, "nc": 145}, {"id": 1366068, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "お、", "screen_name": "ooo_0926", "avatar_url": "https://pbs.twimg.com/profile_images/1976456505617678337/k4n0GrRE.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1393369213792751620/1768864254/1500x500", "appeal_receivable": true, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "art"}, {"genre": "correction"}], "banned": false, "nc": 160}, {"id": 2265795, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "m", "screen_name": "mumumo6", "avatar_url": "https://pbs.twimg.com/profile_images/1667807130173464576/w4-yeCbD.jpg", "header_url": null, "appeal_receivable": true, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration