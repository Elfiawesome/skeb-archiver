長体格が不定です\n・小柄な少女でも、大柄な男性のような体格でもどちらでもOKです\n・服装の細部は適当にしていただいて構いません\n・常に何かを食べています。何でもいいので手に食べ物を持たせて欲しいです！\n・無機物でもOKです。その場合齧ってると分かるように歯形を付けて欲しいです\n\n以上になります。\nよろしくお願いします！🦇🐏", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@nanasiakuru000/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3437413, "client_id": 4051630, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/a51aa3b8/uploads/origins/9cf073e3-1057-402f-a4e7-7d08f872ceb7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=abd6c8b6919f957d66d7599b6dbb3126", "srcset": "https://si.imgix.net/a51aa3b8/uploads/origins/9cf073e3-1057-402f-a4e7-7d08f872ceb7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=abd6c8b6919f957d66d7599b6dbb3126, https://si.imgix.net/a51aa3b8/uploads/origins/9cf073e3-1057-402f-a4e7-7d08f872ceb7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f76a524b2254e693025e7629cb9b8ed2 2x, https://si.imgix.net/a51aa3b8/uploads/origins/9cf073e3-1057-402f-a4e7-7d08f872ceb7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=446d7fee508bfc9fb94610adb694976a 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/a51aa3b8/uploads/origins/9cf073e3-1057-402f-a4e7-7d08f872ceb7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a28ae86ca210dc76c9f0957508c41ed7", "srcset": "https://si.imgix.net/a51aa3b8/uploads/origins/9cf073e3-1057-402f-a4e7-7d08f872ceb7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a28ae86ca210dc76c9f0957508c41ed7, https://si.imgix.net/a51aa3b8/uploads/origins/9cf073e3-1057-402f-a4e7-7d08f872ceb7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=30aa338a3389cf93f51e5265db5faf97 2x, https://si.i