ogle.com/file/d/1kMK2GzlZ1ZA5K75degWnh8lJzwcMeM-c/view?usp=sharing\n\n②涙を流してるポーズ\n▶麻雀のゲームで負けて悔しい！反省！という場面や、ライブに行って感動した！というシーンにも使えるような雰囲気にしていただきたいです\nhttps://drive.google.com/file/d/1qmmUedVdV87rvHZCgiFdE5xDM0JpM_VR/view?usp=sharing\n\n③胸（もしくはアゴ付近）で指を組んでる、幸せそうな雰囲気のポーズ\n▶このご飯美味しかった〜！というシーンや、麻雀勝てて嬉しい！、ライブすごく楽しかったー！という場面などで使えるような感じでお願いします\nhttps://drive.google.com/file/d/1y_SKQia-YbH3WpD8SSsKQkbfi4RNz-hO/view?usp=sharing\n\n\n上記の内容で、腰のあたりまで描いていただけると助かります！\nいただいたイラストは、私のYouTubeチャンネルのサムネイルやSNSで使わせていただく予定です！\n\n\n背景とキャラクターが分けられたPSDファイルにて納品お願いします！\n可能でしたら、表情の差分をいくつかご用意していただけると嬉しいです！\n\n金額が不足している場合は再送をお願いします！\n\n\n以下、資料全体と私の三面図が入ったファイルです\nhttps://drive.google.com/drive/folders/1IiL4EJxrzzM5fR7_wz7046GF3nVBffxx?usp=drive_lin", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@nishikidaenu/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3393028, "client_id": 1306215, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/dbc2b30d/uploads/origins/921b1cd2-4fc1-44bb-a005-bdb645092440?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=64171a5d936704b64c9d573d89084208", "srcset": "https://si.imgix.net/dbc2b30d/uploads/origins/921b1cd2-4fc1-44bb-a005-bdb645092440?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=64171a5d936704b64c9d573d89084208, https://si.imgix.net/dbc2b30d/uploads/origins/921b1cd2-4fc1-44bb-a005-bdb645092440?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=67e9b0e0c420ba6acd765f666a847305 2x, https://si.imgix.net/dbc2b30d/uploads/origins/921b1cd2-4fc1-44bb-a005-bdb645092440?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f8e888e73c2b979c044e7a0d9dda9a30 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/dbc2b30d/uploads/origins/921b1cd2-4fc1-44bb-a005-bdb6450