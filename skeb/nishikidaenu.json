received_works": [{"path": "/@nishikidaenu/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3393028, "client_id": 3758152, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/ce268556/uploads/origins/3d3fe7d3-0b7d-4d81-9faa-a285a4f5d26c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fa0afcac1e7b97612a3102c06c459085", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/ce268556/uploads/origins/3d3fe7d3-0b7d-4d81-9faa-a285a4f5d26c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=fe1dd248fd9c74d6d06e6a8225119839", "src_set": ""}, "body": "にしきださんの絵柄大好き一般人が失礼します。\n１枚絵（PC用のデスクトップイラスト）を描いていただけたら嬉しいなと思います！\n\n希望としましては、\n・キャラクターはキャンバスの中央から右寄りに描いて欲しいです。（左側3分の1ほどフォルダがあるため）\n・明るい印象の女の子を描いて欲しいです。\n・パーカーを着せてもらえるとめっっっっちゃくちゃ嬉しいです。\n・にしきださんの描かれる手がとても好きなので【手ハート】を描いて欲しいです。（手ハートの形はおまかせします！）\n他の方のご依頼のようにキャラクターデザインがないあげく物凄く大雑把な指定ばかりで申し訳ないですが、\nにしきださんのイラストの個性や着彩感覚が大好きなので、なるだけ自由に描いていただきたいなと思っています！\nよろしくお願いいたします。", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@nishikidaenu/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3393028, "client_id": 3528884, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/911d00ef/uploads/origins/1e37d9ad-d91c-42eb-a74e-a3f53d6f86cd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c0685916229b144594c5c33b9508f1da", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/911d00ef/uploads/origins/1e37d9ad-d91c-42eb-a74e-a3f53d6f86cd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6060cfc3ff77591327d95989d3604982", "src_set": ""}, "body": "はじめまして！\nVtuberとして活動している長月朔と申します。\nにしきだえぬ様の絵柄が大変好みで、特にこちらの等身のイラストが私の雰囲気にも合ってるなと感じたのでご依頼させていただきます！\nhttps://x.com/nishikidaenu/status/1947612325839548822\n\n\n下記内容で、①②③のイラストをお願いします。\n私のつたない絵で申し訳ありませんが、ポーズや表情のイメージも共有させていただきます！\n\n\n①「今日はここに来ました！」という雰囲気の笑顔のポーズ\n▶主に音楽フェスやライブ会場で撮影した写真とともに投稿する予定です\nhttps://drive.google.com/file/d/1kMK2GzlZ1ZA5K75degWnh8lJzwcMeM-c/view?usp=sharing\n\n②涙を流してるポーズ\n▶麻雀のゲームで負けて悔しい！反省！という場面や、ライブに行って感動した！というシーンにも使えるような雰囲気にしていただきたいです\nhttps://drive.google.com/file/d/1qmmUedVdV87rvHZCgiFdE5xDM0JpM_VR/view?usp=sharing\n\n③胸（もしくはアゴ付近）で指を組んでる、幸せそうな雰囲気のポーズ\n▶このご飯美味しかった〜！というシーンや、麻雀勝てて嬉しい！、ライブすごく楽しかったー！という場面などで使えるような感じでお願いします\nhttps://drive.google.com/file/d/1y_SKQia-YbH3WpD8SSsKQkbfi4RNz-hO/view?usp=sharing\n\n\n上記の内容で、腰のあたりまで描いていただけると助かります！\nいただいたイラストは、私のYouTubeチャンネルのサムネイルやSNSで使わせていただく予定です！\n\n\n背景とキャラクターが分けられたPSDファイルにて納品お願いします！\n可能でしたら、表情の差分をいくつかご用意していただけると嬉しいです！\n\n金額が不足している場合は再送をお願いします！\n\n\n以下、資料全体と私の三面図が入ったファイルです\nhttps://drive.google.com/drive/folders/1IiL4EJxrzzM5fR7_wz7046GF3nVBffxx?usp=drive_lin", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@nishikidaenu/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3393028, "client_id": 1306215, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/dbc2b30d/uploads/origins/921b1cd2-4fc1-44bb-a005-bdb645092440?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=64171a5d936704b64c9d573d89084208", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/dbc2b30d/uploads/origins/921b1cd2-4fc1-44bb-a005-bdb645092440?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=84176f3c2ef2bdbe2b7b813d95bfea00", "src_set": ""}, "body": "にしきださんのパキッとした絵柄が大好きなのでぜひ描いていただきたいです…！ アイコンもいいかなと思いましたがせっかくなのでデスクトップ画像の依頼は可能でしょうか？ 1枚絵になるのかその辺は分からないですが料金は私の気持ちです！！！！ぜひ！！！描いて欲しかった！！！！！\nイラストの内容については、2人の代理を描いて頂きたいです。1人はｶｽﾐｶﾝの代理キャラクター、もう1人は友人のキャラクターで私が作成したものになります。 資料URLは既にXにあげてある私の代理のみになっています、もし依頼を受けてくださるという話になれば、もう一方の資料も送らせて頂きます。(SNSにあげていないものの為) 構図は特に考えずリクエストを書き始めてしまったのですが、2人がぎゅっと箱に詰められてるような、画面いっぱいのにしきださんの絵が見たいです。  \nもし料金について、内容についてこれは難しい、依頼として受け付けられない等ありましたらいつでも連絡お待ちしております。\n\nhttps://x.com/kasumikan2003/status/1738919083469689084?s=46&t=sWhYboFLAnvIER6aKjKPVQ", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "similar_creators": [{"id": 1137565, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "七月", "screen_name": "uuuusatama", "avatar_url": "https://pbs.twimg.com/profile_images/1750456735268298752/jzpUpkv-.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1382566100936781825/1706250438/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 10, "skills": [{"genre": "art"}], "nc": 16}, {"id": 2843235, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "名無し", "screen_name": "trorpy", "avatar_url": "https://pbs.twimg.com/profile_images/1901251699203059712/GECK3W7c.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1582960140247912450/1737993971/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "skills": [{"genre": "art"}, {"genre": "comic"}], "nc": 145}, {"id": 2940374, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "すずきこな", "screen_name": "soyakimi", "avatar_url": "https://pbs.twimg.com/profile_images/1890105973047717890/aLdH5xEr.jpg", "header_url": "https://pbs.twimg.com/profile_banners/609792027/1749721529/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_ac