-a2bb-b12b5478b521?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1a104a5f7a9782676a61d794ee3ad4db", "srcset": "https://si.imgix.net/891f911e/uploads/origins/ff63e4bc-f26f-4545-a2bb-b12b5478b521?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1a104a5f7a9782676a61d794ee3ad4db, https://si.imgix.net/891f911e/uploads/origins/ff63e4bc-f26f-4545-a2bb-b12b5478b521?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=d9a857574b3c13732e3a50c9cc75d979 2x, https://si.imgix.net/891f911e/uploads/origins/ff63e4bc-f26f-4545-a2bb-b12b5478b521?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=22495c6a746e77366a54a60258e0b174 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/891f911e/uploads/origins/ff63e4bc-f26f-4545-a2bb-b12b5478b521?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=56b91033794dfaaca1c57a729aaa476e", "srcset": "https://si.imgix.net/891f911e/uploads/origins/ff63e4bc-f26f-4545-a2bb-b12b5478b521?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=56b91033794dfaaca1c57a729aaa476e, https://si.imgix.net/891f911e/uploads/origins/ff63e4bc-f26f-4545-a2bb-b12b5478b521?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=81a18a436dec668824684d6c344c7ff2 2x, https://si.imgix.net/891f911e/uploads/origins/ff63e4bc-f26f-4545-a2bb-b12b5478b521?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=4190769228eb470af94072789608156f 3x"}, "body": "※再送です\n\n川村一真様\n以前匿名で可惜夜月の４コマを依頼させていただいた物です。川村さんの４コマが好きでコミケ毎に購入させていただいているので、好きなユニットで描いていただけて嬉しかったです。\nここ２年可惜夜月のカレンダーを企画して、Boothで販売しているのですが来年のカレンダーを企画するにあたり川村さんの４コマを１つお願い出来ないかと思い再びリクエストさせていただきました。\nお願いしたいのは可惜夜月の３人の４コマ１本。用途はカレンダー発送時に購入者用に同封するペーパーに使わせていただきたいと考えております。年末～年始に購入者の手元に届くようにしていますので『来年も(可惜夜月を)よろしくお願いします』や『良いお年を』のような季節感を入れていただけると嬉しいです。難しい場合はお好きに描いていただいても大丈夫です。\n描いていただける場合、完成品は購入者の手元に届く１月頃までアップしないでいただけますようお願いします。\nskebの規約で双方の合意があれば同人の依頼も出来ると聞きましたので、こちらで依頼させていただきました。お忙しいとは思いますが、ご検討ください。", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@kazuma7kawamura/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1508343, "client_id": 396562, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/b95d8adf/uploads/origins/22dff936-b9a1-492f-88be-7a9a6edfd54c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9e88823d0cd5e387e3140e032d8ca0c1", "srcset": "https://si.imgix.net/b95d8adf/uploads/origins/22dff936-b9a1-492f-88be-7a9a6edfd54c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9e88823d0cd5e387e3140e032d8ca0c1, https://si.imgix.net/b95d8adf/uploads/origins/22dff936-b9a1-492f-88be-7a9a6edfd54c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a7cef324810fe868c7922e2796f86dd2 2x, https://si.imgix.net/b95d8adf/uploads/origins/22dff936-b9a1-492f-88be-7a9a6edfd54c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=482a3e4affb94d56b72ae26e57fab0c4 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/b95d8adf/uploads/origins/22dff936-b9a1-492f-88be-7a9a6edfd54c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=661d3e979ff2d2769bc32e9ad09050b2", "srcset": "https://si.imgix.net/b95d8adf/uploads/origins/22dff936-b9a1-492f-88be-7a9a6edfd54c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=661d3e979ff2d2769bc32e9ad09050b2, https://si.imgix.net/b95d8adf/uploads/origins/22dff936-b9a1-492f-88be-7a9a6edfd54c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=35ed7b7c158a87b6560b9ec510eb22aa 2x, https://si.imgix.net/b95d8adf/u