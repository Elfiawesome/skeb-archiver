: 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@snowscapecross/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1831755, "client_id": 2963244, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/2d3b8fd7/uploads/origins/dfe4fc11-f351-44dd-abf8-5d3f75f5b919?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=95a7e27fa7d21c16e6ffa7b0abe83027", "srcset": "https://si.imgix.net/2d3b8fd7/uploads/origins/dfe4fc11-f351-44dd-abf8-5d3f75f5b919?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=95a7e27fa7d21c16e6ffa7b0abe83027, https://si.imgix.net/2d3b8fd7/uploads/origins/dfe4fc11-f351-44dd-abf8-5d3f75f5b919?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=52a88835dd9e3162caa1c3a7f40a6065 2x, https://si.imgix.net/2d3b8fd7/uploads/origins/dfe4fc11-f351-44dd-abf8-5d3f75f5b919?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=41a7b0dec231290aa2b5813ed0037f7a 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/2d3b8fd7/uploads/origins/dfe4fc11-f351-44dd-abf8-5d3f75f5b919?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d82908f938ef05904da468b862a3af64", "srcset": "https://si.imgix.net/2d3b8fd7/uploads/origins/dfe4fc11-f351-44dd-abf8-5d3f75f5b919?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d82908f938ef05904da468b862a3af64, https://si.imgix.net/2d3b8fd7/uploads/origins/dfe4fc11-f351-44dd-abf8-5d3f75f5b919?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=72264ed949b59e059fd49b011121336b 2x, https://si.imgix.net/2d3b8fd7/uploads/origins/dfe4fc11-f351-44dd-abf8-5d3f75f5b919?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=a8ec41d6955e2a04c4bbf670e026f7c9 3x"}, "body": "こんにちは。普段よりゆきや紺子様の素敵なイラストを拝見しております、アトノマツリと申します。skebでの依頼が初めてですので、不備、失礼がありましたら申し訳ございません。\n\n・要望\n私のオリジナルキャラクター2人を、お花の背景と一緒に描いていただきたいです。\n\nカイリ→黒髪、紫インナーの髪の方。自分に自信があり若干のナルシスト(実力はある)ですが、素直になれず少しメンタルが弱い面があります。難のある性格故、友人が少ないです。\n\nハルト→金髪、紫メッシュの髪の方。オラオラ系で少しチャラいですが、情に厚いです。陽キャで友人は多いですが、怖がられがち。\n\n2人は、お互いに唯一互角に戦ったり、互角に友人として渡り合えるような関係です。カイリのインナーカラーとハルトのメッシュは、それぞれ染めたらたまたま色が被ったという設定で、表面上は2人ともお揃いを嫌がっています。\n\n構図はお任せしたいのですが、もしよろしければ\nお花を指定させていただきたいです。\n・紫色のクロッカス\n・ラベンダー          \n・ハナニラ\nなど、紫色系かつ花言葉が少し不穏なお花\n2人はだんだんすれ違って関係を悪化させたまま、やりきれない結末を迎えるので、すこし切ない雰囲気のイラストだと嬉しいです……！\n　\n・使用用途\n　頂いたイラストは個人鑑賞の他、SNSアイコンや個人利用用のグッズに使用する可能性があります。\n\nhttps://drive.google.com/drive/folders/1---Ix3Wzq1Z94KIrlfTCkig92BGa1VkW", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [{"path": "/@NoahZark/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1171466, "client_id": 1831755, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/7f4d25f6/uploads/origins/6e10000e-bdae-4863-8e1d-f6ca847a38af?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=79d195afe088d2390b5f31ab5b00b333", "srcset": "https://si.imgix.net/7f4d25f6/uploads/origins/6e10000e-bdae-4863-8e1d-f6ca847a38af?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=79d195afe088d2390b5f31ab5b00b333, https://si.imgix.net/7f4d25f6/uploads/origins/6e10000e-bdae-4863-8e1d-f6ca847a38af?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ee1a08da37c8b30df797082c7a261948 2x, https://si.imgix.net/7f4d25f6/uploads/origins/6e10000e-bdae-4863-8e1d-f6ca847a38af?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b2b5c994862923659d34e0d61f87df03 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/7f4d25f6/uploads/origins/6e10000e-bdae-4863-8e1d-f6ca847a38af?b