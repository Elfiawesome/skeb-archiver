ナニー、誘惑する様子…等々お好みのシチュエーションで\nお尻で気持ちよさそうにしているor犬になりきりながらなイメージ\nとろとろで気持ちよさそうな表情\n相手の描写は無くても構いません\n胸の大きさは控えめ（Bカップ程度～つるぺたまでお好みで）\nランジェリーは着たままでお願いします（シチュエーションによって胸や股のクロッチを開いてください）\n顔が見え、衣装が映えるよう正面から見た構図ですと嬉しいです\n\nご検討をお願いいたします\n\nhttps://drive.google.com/drive/folders/1gXZVDfcsl66QZ8VxPLKFXERqQXKioNsJ", "nc": 40, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@med_dkdk/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 4043863, "client_id": 3348706, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/e4a63297/uploads/origins/84e0724a-b08d-487a-9fda-4815c8a8a8c0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=07eba2e45f1361c18fa3d4232ae56240", "srcset": "https://si.imgix.net/e4a63297/uploads/origins/84e0724a-b08d-487a-9fda-4815c8a8a8c0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=07eba2e45f1361c18fa3d4232ae56240, https://si.imgix.net/e4a63297/uploads/origins/84e0724a-b08d-487a-9fda-4815c8a8a8c0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=289aacd52caeb616bb767f1c869de1e3 2x, https://si.imgix.net/e4a63297/uploads/origins/84e0724a-b08d-487a-9fda-4815c8a8a8c0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=415d54c33aae662494f6b23cef918970 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/e4a63297/uploads/origins/84e0724a-b08d-487a-9fda-4815c8a8a8c0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=68e09740af9a7e9a26dc69912039977a", "srcset": "https://si.imgix.net/e4a63297/uploads/origins/84e0724a-b08d-487a-9fda-4815c8a8a8c0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=68e09740af9a7e9a26dc69912039977a, https://si.imgix.net/e4a63297/uploads/origins/84e0724a-b08d-487a-9fda-4815c8a8a8c0?bg=%23fff&auto=for