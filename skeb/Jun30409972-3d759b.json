=crop&crop=top&w=200&h=200&s=8360c70dcaf44f9a4829565928e1c29e 2x, https://si.imgix.net/fac4db2c/uploads/origins/fb8269cf-d322-4b08-b31c-4b6ee9c6d75a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=37b29e5c7349ff69c01932d77aaed764 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/fac4db2c/uploads/origins/fb8269cf-d322-4b08-b31c-4b6ee9c6d75a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=de2def6d2986d3065b08511bd59b613b", "srcset": "https://si.imgix.net/fac4db2c/uploads/origins/fb8269cf-d322-4b08-b31c-4b6ee9c6d75a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=de2def6d2986d3065b08511bd59b613b, https://si.imgix.net/fac4db2c/uploads/origins/fb8269cf-d322-4b08-b31c-4b6ee9c6d75a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=7ebaef2c56f0ec6f2258093ccfd67304 2x, https://si.imgix.net/fac4db2c/uploads/origins/fb8269cf-d322-4b08-b31c-4b6ee9c6d75a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=7c57f60f86e641eaa3e446a04367cb17 3x"}, "body": "Junさん初めまして。素敵な絵をいつも見させていただいております。\nこの度は是非描いて欲しいキャラクターがいますので連絡させていただきました。\n\n描いて欲しいのはアイドルマスターシンデレラガールズの大石泉というキャラクターで、ずっと声が付いていなかったのですがいよいよ声付きでイベントデビューする事になりました。\nそれを祝う形でハンドマイクを握って歌っている姿でお願いしたいです。\n背景はステージ上の立ち姿が希望しますがJunさんにお任せします。\n\nよろしくお願いします。\n\nhttps://imas.gamedbs.jp/cg/idol/detail/123?h=27bae0d4009a858d08dced42005cdf25", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Jun30409972/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1923322, "client_id": 405516, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/5e398d3e/uploads/origins/d1d870bb-445c-4d87-a13c-05ffcce721f9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ce9875dcddc3