rmat%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=1aac3f76e9dff6b57374e46bff4f91bb 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/cd9cc85d/uploads/origins/14f51253-c9aa-4783-82ea-360688636396?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a73d4137938de3138fc52cd56146f4aa", "srcset": "https://si.imgix.net/cd9cc85d/uploads/origins/14f51253-c9aa-4783-82ea-360688636396?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a73d4137938de3138fc52cd56146f4aa, https://si.imgix.net/cd9cc85d/uploads/origins/14f51253-c9aa-4783-82ea-360688636396?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=a931a1c29cc48f8bce08c9eb2738e2b3 2x, https://si.imgix.net/cd9cc85d/uploads/origins/14f51253-c9aa-4783-82ea-360688636396?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=ff113f48a2c77a221a9ceb5784c2c022 3x"}, "body": "蓮花さん、はじめまして。現在、次女を探しています。私のキャラのテーマは、身体に障がいがあってもかわいい女の子です。目が見えなくて、日差しから目を守るために目隠しをしている女の子がいいです。目隠しの奥の瞳はとても美しい。表情は出せないけど、かわいく振舞おうとする。(このアイデアは斧乃木余接にインスパイアされたものです）彼女は私のもう一人の娘クロエ・クレメンツと同じ年頃です。小柄な体、長い白髪、エレガントな服を着ているイメージです。ただ、彼女のデザインに関しては、あなたの自由な発想に任せます。彼女の名前はカミリア・ヴァイス。\n\nご検討ありがとうございました。🙇‍♂️", "nc": 161, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@renka_creative/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3353832, "client_id": 71755, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/e123fbcb/uploads/origins/45175b15-6d18-4429-81f3-c50fcc04ec38?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=359b1a2f7724b1940c9d0948798e021a", "srcset": "https://si.imgix.net/e123fbcb/uploads/origins/45175b15-6d18-4429-81f3-c50fcc04ec38?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=359b1a2f7724b1940c9d0948798e021a, https://si.imgix.net/e123fbcb/uploads/origins/45175b15-6d18-4429-81f3-c50fcc04ec38?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c74176e33546240a5a81288d8847bc9b 2x, https://si.imgix.net/e123fbcb/uploads/origins/45175b15-6d18-4429-81f3-c50fcc04ec38?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=75f0547ba8400c9fb6938d42fa13a3b2 3x"}, "duration": null, "nsfw": true, "hardcore": true, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/e123fbcb/uploads/origins/45175b15-6d18-4429-81f3-c50fcc04ec38?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=fe10d2a3d959b9bfe9edb09dd5f1046c", "srcset": "https://si.imgix.net/e123fbcb/uploads/origins/45175b15-6d18-4429-81f3-c50fcc04ec38?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=fe10d2a3d959b9bfe9edb09dd5f1046c, https://si.imgix.net/e123fbcb/uploads/origins/45175b15-6d18-4429-81f3-c50fcc04ec38?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=254896dba325cf914daddfd30bb736fd 2x, https://si.imgix.net/e123fbcb/uploads/origins/45175b15-6d18-4429-81f3-c50fcc04ec38?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=7278c7c0ca0e5fb0c9b2868ec92e80b5 3x"}, "body": "書くかも程度ですがドM小説の挿絵等に利用したいです\nシチュ：\n着衣超乳&着衣ボテ腹姿のサティ(差分で水菜萌)を女性一人が入るほどの超特大ボテ腹M男がアナルから出産しながら前立腺圧迫で絶頂射精するドMホイホイシチュ\n触手肉壁系かダーク系背景で、女性一人が入るほどの超特大ボテ腹M男とサティをベースにpsd形式で各キャラがレイヤーで切替可能、スカートや太ももより上が抜け出る出産シーンで、\nM男をゴミを見る冷めた目(顔上部や目元まで影+瞳のハイライトなし)で変態への嫌悪感MAXを一切隠さず侮蔑する様子希望\n切替が難しい場合はサティを出産しながらマゾ絶頂する超特大ボテ腹M男を水菜萌が嫌悪・侮蔑する内容希望\n\n二人とも全身羊水で濡れ、服が超乳やボテ腹にべったり張り付き、着衣超乳は服越し勃起乳首(可能であればピンク色透け乳首希望)+片乳だけで両腕でも抱え込めない、頭＆胴体以上のサイズで\nそれらと同サイズの特大着衣ボテ腹(淫紋付き/衣装は調整OKで完全着衣状態希望)と共に服をピチピチに引き伸ばされる描写希望\nM男は女体一人入りの特大サイズ&妊娠淫紋付きボテ腹で出産時の一切の苦痛はなく、肉塊卵が男の股間をモザイク不要レベルで完全に覆い内部でペニスを嫐り、\n出産時の際に前立腺への強烈な刺激で肉塊卵の先端にコンドームのように特大精液水風船ができるほど大量射精しまくり受精させる様子希望\n\npsd形式で切替可能設定で、粘液まみれの蠢く肉壁の水音やずるっと這い出す出産の擬音、射精等の効果音や各キャラの瞳のハイライトと顔上部に掛かる影の有無差分と\n優先度低OKで女性キャラ出産後とは別に出産途中として、M男のアナルからサティ(水菜萌)の片腕だけ這い出す切替可能差分及び射精の有無切替差分希望\n更に口調等お任せで、快楽のために擬態肉塊妖魔を孕み産み落とすだけの苗床として自らアナルを捧げ、男の癖に妊娠した挙句マゾ出産射精し、次の肉塊卵に射精して受精させる設定&内容で、出産した女性キャラが外界に出て男を襲いM男と同じようにマゾ堕ちさせた後ボテ腹に改造して繁殖、最終的に全世界の男はアナルで女体を出産しながら射精する苗床へと変貌するという説明に興奮するM男を侮蔑し、老いも死も赦されず苗床として大好きな超乳&ボテ腹美少女ばかり永遠に孕ませてあげる、と変態マゾ男を嫌悪感MAXで罵倒・侮蔑する的な内容の台詞有無差分\n\nhttps://drive.google.com/drive/folders/1eufpnV4DpX0iUO7mQoF9HQ3hBmSryyzq?usp=sharing", "nc": 58, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 62781, "creator": true, "nsfw_acceptable": true, "acceptable": false, "name": "半蔵", "screen_name": "0721Kin29n", "avatar_url": "https://pbs.twimg.com/profile_images/1862083214744973312/k25i7PL0.jpg", "header_url": "https://pbs.twimg.com/profile_banners/754258295657893888/1732799020/1500x500", "appeal_receivable": true, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 5, "complete_expiration_days": 35, "skills": [{"genre": "art"}, {"genre": "correction"}], "banned": false, "nc": 160}, {"id": 373206, "creator": true, "nsfw_acceptable": true, "acceptable": false, "name": "猫ぞんび🔞", "screen_name": "nekodebri", "avatar_url": "https://pbs.twimg.com/profile_images/1515697937258790915/P-UjzXej.jpg", "header_url": null, "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "art"}], "banned": false, "nc": 185}, {"id": 556954, "creator": true, "nsfw_acceptable": true, "acceptable": false, "name": "時猫@skebお休み中", "screen_name": "tokinekorafu", "avatar_url": "https://pbs.twimg.com/profile_images/1480593532599828480/OF4fhstD.jpg", "header_url": "https://pbs.twimg.com/profile_banners/9996281746600263