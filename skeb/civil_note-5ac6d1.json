6/06956318/06984824/imgrc0093345116.jpg\n\n・ボディラインの強調は抑えめにして欲しいです。可能であれば服の生地を厚手な感じにして欲しいです\n\n・使用用途ですが他の人に依頼する際の服装の参考画像として使用したいです\n\n以上です", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@civil_note/works/10", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 515543, "client_id": 965674, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/9586eb71/uploads/origins/2305c391-b479-43db-a1a3-a212c80ceb8e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=aed9a08e8cce0d76aa2f631618ea39fa", "srcset": "https://si.imgix.net/9586eb71/uploads/origins/2305c391-b479-43db-a1a3-a212c80ceb8e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=aed9a08e8cce0d76aa2f631618ea39fa, https://si.imgix.net/9586eb71/uploads/origins/2305c391-b479-43db-a1a3-a212c80ceb8e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b40f46a1ced22f51fa2ee1f8349a881c 2x, https://si.imgix.net/9586eb71/uploads/origins/2305c391-b479-43db-a1a3-a212c80ceb8e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=4f31f3388f3cbc9ddf5503c666cce6b9 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/9586eb71/uploads/origins/2305c391-b479-43db-a1a3-a212c80ceb8e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ee8890767414aab2bee9be29d1e979e7", "srcset": "https://si.imgix.net/9586eb71/uploads/origins/2305c391-b479-43db-a1a3-a212c80ceb8e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ee8890767414aab2bee9be29d1e979e7, https://si.imgix.net/9586eb71/uploads/origins/2305c391-b479-43db-a1a3-a212c80ceb8e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=10a3800515cc1157cb33a1d7e0685424 2x, https://si.imgix.net/9586eb71/uploads/origins/2305