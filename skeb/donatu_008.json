keb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1734946903455055873%2FmDZak61_.jpg?blend64=aHR0cHM6Ly9za2ViLWF2YXRhci5pbWdpeC5uZXQvfnRleHQ_&blendalpha=100&blendalign=center&blendmode=normal&blendsize=inherit&bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3806e91e0599760eeaf34ca5f5749d82", "src_set": ""}, "body": "いつもイラスト楽しみに見てます！\n銅夏先生の作品が大好きで、自分もイラストを描くのですが参考にさせていただければと思いリクエストしました！\n\n特に知りたいのが、\n\n・シチュエーションとか構図のアイデアって普段どうやって考えてますか？\n・イラストのクオリティ上げるために、特に気をつけてるポイントとかこだわりがあれば教えてほしいです！\n・乳首や乳輪の塗り方がすごく綺麗で好きなんですが、塗るときのコツとか意識してることってありますか？\n\n気軽に、ざっくりした感じで答えてもらえると嬉しいです！\nよろしくお願いしますー！", "nc": 176, "word_count": 275, "transcoder": "text", "creator_acceptable_same_genre": false}, {"path": "/@donatu_008/works/40", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/a846b18a/uploads/origins/3aca55e1-ed22-436a-ae51-ea847b663ed7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=132232c6f48dd5faaad46f5c89bf7d4a", "src_set": ""}, "private": true, "genre": "art", "tipped": true, "creator_id": 1262467, "client_id": 3192978, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 33, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@donatu_008/works/39", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1262467, "client_id": 2289799, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/32070c67/uploads/origins/b774e9e0-6724-4fc4-a523-a1c7db1ec0d6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a780f33f36a0a6b1ca8e7ce2eaed12ba", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/32070c67/uploads/origins