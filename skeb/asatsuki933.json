。\n\n【構図など】\nあさつき様の描かれる小悪魔っぽいつり目が最高なので、小悪魔っぽい雰囲気でお願いしたいです。\n基本お任せしますがサムネイルに使用したいので頭や腕などが見切れていない構図でお願いしたいです。\nドライブにある衣装（どれでもOK・オリジナルでもOK）や髪型の改変OKです。可能であれば表情差分もあると嬉しいです！肩が見えていたり萌え袖気味、Aシルエットだと嬉しいです。\n\n\n【納品形式】\n背景と人物を分けてPSDでいただきたいです。\n\n【使用用途】\nサムネイル・SNS宣伝・ＦＡＮＢＯＸやメンバーシップ・ネットプリント等の配布・収益化済みYouTubeチャンネルでの使用など\n※使用不可なものは別途レイヤー内に記載していただけると助かります\n\n長々と失礼しました。\nご縁がありましたらよろしくお願いいたします！\n＠rabis_valet\n\nhttps://drive.google.com/drive/folders/1En4cRp2ghCnHPdpxRedI5mQhKI75ILVC?usp=drive_link", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@asatsuki933/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3293673, "client_id": 187870, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/08965e05/uploads/origins/7c60e376-2715-46af-b6e1-e9325cd12a9b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3f671ca7b130e6c0eb103d549ab5f53b", "srcset": "https://si.imgix.net/08965e05/uploads/origins/7c60e376-2715-46af-b6e1-e9325cd12a9b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3f671ca7b130e6c0eb103d549ab5f53b, https://si.imgix.net/08965e05/uploads/origins/7c60e376-2715-46af-b6e1-e9325cd12a9b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a01b4d18a2bca5080f2cb12b07cfe6eb 2x, https://si.imgix.net/08965e05/uploads/origins/7c60e376-2715-46af-b6e1-e9325cd12a9b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=4ea6f38b4beb473af75b0b0fb37aad82 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/08965e05/uploads/origins/7c60e376-2715-46af-b6e1-e9325cd12a9b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=04f58b52187af809c1eda95744670f7a", "srcset": "https://si.imgix.net/08965e05/uploads/origins/7c60e376-2715-46af-b6e1-e9325cd12a9b?bg=%23fff&auto=format%2Ccompr