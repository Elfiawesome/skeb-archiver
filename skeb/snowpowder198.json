ord_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@snowpowder198/works/141", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1421731, "client_id": 0, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/c75abd87/uploads/origins/8508fb0c-356b-4eac-a901-2ac5974d22a8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1c45d8f0af9eec2784458fed56f88aac", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/c75abd87/uploads/origins/8508fb0c-356b-4eac-a901-2ac5974d22a8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=bb0398c5addd8b50e0f22f2d5c0c4246", "src_set": ""}, "body": "妖怪ウォッチより、高校生になったフミちゃんを全身図でお願いします。\n\n制服はアニメしきるん蛇回のブレザーを参考に、靴下は白ニーソックスで、髪型は小学生時代と同じポニーテールでお願いします。また、右手にフミちゃんウォッチを持ち、左手でスカートの裾をつまむポーズでお願いします。\n\nまた、もし良ければ、隣に高校生ケータも描いてください。ほぼオリジナル要素ですみませんが、制服の着こなしはブレザーの下に赤パーカーで、ローファーの代わりにスポーツシューズを履いてて、ポージングは、右手に妖怪メダルを掴み、左腕は初代ウォッチが見えるように、ガッツポーズみたいな感じでお願いします。", "nc": 41, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@snowpowder198/works/140", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1421731, "client_id": 0, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/128b25d6/uploads/origins/ee0919e2-b13c-46e2-91b1-1f43cd72a386?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3d98e305f883bcbb9fd3d060d8809292", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": true, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/128b25d6/uploads/origins/ee0919e2-b13c-46e2-91b1-1f43cd72a386?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c9d58349e45c60495b5dcc09aea99960", "src_set": ""}, "body": "イナズマイレブンの直球でエロい絵をリクエストします！エイリア学園イプシロンのモールが不動明王（真帝国版）の攻撃を受けてダウンするシチュエーションのイラストが見たいです。不動側の技は特別指定しませんが「元のモール→ダメージを受けて服が破けるモール→倒れるモール」といった3つの流れが最低限あればと思います。また、モールは素顔が不明ですが覆面やガスマスクごと破壊していただいて一際さんが想像した素顔でデザインしていただければと思います。なお、体型は特にこだわりが無いので一際さんがピンとくるもので構いません。突然のリクエストで恐縮ですが何卒よろしくお願いします。", "nc": 35, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@snowpowder198/works/139", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1421731, "client_id": 0, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/bb543697/uploads/origins/1b0039eb-687b-4562-9db0-e52c70e9661e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=86038eb4eb57c54b2a299c827c583ef0", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/bb543697/uploads/origins/1b0039eb-687b-4562-9db0-e52c70e9661e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=cb8aad4a25a1226dab851a51eef7e078", "src_set": ""}, "body": "こんにちは、18歳以上のドローイングに興味があります。\n\nキャラクターです：ポケモンスペシャルのYガベナのボブカットです。\n\nポーズ：赤いビキニのビーチシーン。前傾姿勢で、ぶら下がっているおっぱいがメイン。脱いだばかりのビキニのトップを持っていて、おっぱいが丸出しになっている。セクシーで魅力的な表情。\n\n参考URLは私の好みのプロポーション。\n\nhttps://imgur.com/a/8WdgyKc", "nc": 177, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "similar_creators": [{"id": 1565, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "イスナ🔞Skeb募集中", "screen_name": "footprintofisna", "avatar_url": "https://proxy.misskeyusercontent.jp/avatar.webp?url=https%3A%2F%2Fmedia.misskeyusercontent.jp%2Fmisskey%2Fc077cb00-bd4d-473f-9c86-31f99669842c.png&avatar=1", "header_url": "https://media.misskeyusercontent.jp/io/7e163782-da06-4755-a57d-d6558bd8b30c.png", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "skills": [{"genre": "art"}