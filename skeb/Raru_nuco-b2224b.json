嬉しいです🙇‍♀️\n①IRIAM配信用\n横2000px‪ × 縦4000px、350dpi、20MB以下\n②高解像度の大きめデータ(350dpiかそれ以上)\n縦5000px〜7000px\n横2500px〜3500px\n\nhttps://www.dropbox.com/scl/fo/qrtyk23x4w874xt0uy2y3/ACKoIDMehxqUnQfG2n9lPi8?rlkey=ntkgc57uo2jmk58q8sqjtf6tc&dl=0", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@iroma0ytb/works/11", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 127918, "client_id": 2038526, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/a3d3d166/uploads/origins/9f6ce244-a8a5-4dfc-965d-b05e164555f9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=15dd85ffe8ea559798bc8f9a1bec69b0", "srcset": "https://si.imgix.net/a3d3d166/uploads/origins/9f6ce244-a8a5-4dfc-965d-b05e164555f9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=15dd85ffe8ea559798bc8f9a1bec69b0, https://si.imgix.net/a3d3d166/uploads/origins/9f6ce244-a8a5-4dfc-965d-b05e164555f9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=8b19bd6be6e94d65344e889fd2b0547c 2x, https://si.imgix.net/a3d3d166/uploads/origins/9f6ce244-a8a5-4dfc-965d-b05e164555f9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=bcb66a105e5fcc5b52b7f22a41460214 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/a3d3d166/uploads/origins/9f6ce244-a8a5-4dfc-965d-b05e164555f9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5428bf0acd80b1250d167255958a4704", "srcset": "https://si.imgix.net/a3d3d166/uploads/origins/9f6ce244-a8a5-4dfc-965d-b05e164555f9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5428bf0acd80b1250d167255958a4704, https://si.imgix.net/a3d3d166/uploads/origins/9f6ce244-a8a5-4dfc-965d-b05e164555f9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=