&dpr=2&fit=crop&crop=top&w=200&h=200&s=1323864d7b5dcd408232b2af0a424fa1 2x, https://si.imgix.net/02f992c6/uploads/origins/8506f7f5-c9b5-4ef6-9804-ac3daa6f5d7e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a884fda993c21c9496634eddc2cf241c 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/02f992c6/uploads/origins/8506f7f5-c9b5-4ef6-9804-ac3daa6f5d7e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=7c8b1b9ef810c8b83f6200e7531c8ca5", "srcset": "https://si.imgix.net/02f992c6/uploads/origins/8506f7f5-c9b5-4ef6-9804-ac3daa6f5d7e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=7c8b1b9ef810c8b83f6200e7531c8ca5, https://si.imgix.net/02f992c6/uploads/origins/8506f7f5-c9b5-4ef6-9804-ac3daa6f5d7e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=e6881ff8a58fad340a2d5f9e82acc6dd 2x, https://si.imgix.net/02f992c6/uploads/origins/8506f7f5-c9b5-4ef6-9804-ac3daa6f5d7e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=7c129a8b92e9ae4f664d945116921b40 3x"}, "body": "いぬっこまる様もといさぶっこまる様\n\nお世話になります。\n個人でvtuberをしているエゴと申します。\nさぶっこまる様のアカウントでやっているまるっこくて可愛らしいSDキャラと等身の詰め合わせイラストに惹かれてリクエストさせて頂きました！\nこの度は新しいモデルとなったVtuberの私のイラストを描いていたければ幸いです\n\nイメージカラーはネイビー\nモチーフはサイコロ・水仙の花・ゲームコントローラー等\nポーズ・表情はおまかせにてお願いしたいです！\n\n\n\n◆使用用途 \nYoutubeの動画・配信用のサムネイルや各種SNSで使用させていただければ幸いです \n\n◆形式 \nサムネイルなどでも使わせていただきたいため、\n 可能であれば背景が透過されているデータも頂けるととても助かります ！\nデータはPSDデータまたはPNGデータでいただければ幸いです。\n\n何卒よろしくお願い致します\n\nhttps://x.com/Ego_Gakaku/status/1915603638371922049?t=1FumeZ0JJqLZ70T3G1HdJA&s=19", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@sabukkomaru/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3812929, "client_id": 515379, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/f160ab66/uploads/origins/92c08619-0b23-49c6-9609-801e16492d59?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=64b188da59d13c4f1671a5a6b41abe3b", "srcset": "https://si.imgix.net/f160ab66/uploads/origins/92c08619-0b23-49c6-9609-801e16492d59?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=64b188da59d13c4f1671a5a6b41abe3b, https://si.imgix.net/f160ab66/uploads/origins/92c08619-0b23-49c6-9609-801e16492d59?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=3ba2090f21e718a5fd04ec0e2a0276c5 2x, https://si.imgix.net/f160ab66/uploads/origins/92c08619-0b23-49c6-9609-801e16492d59?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=16c519dca92ac68ad43ea6409d8a2749 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/f160ab66/uploads/origins/92c08619-0b23-49c6-9609-801e16492d59?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ea62484083b898d453ec7e61544b0c20", "srcset": "https://si.imgix.net/f160ab66/uploads/origins/92c08619-0b23-49c6-9609-801e16492d59?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ea62484083b898d453ec7e61544b0c20, https://si.imgix.net/f160ab66/uploads/origins/92c08619-0b23-49c6-9609-801e16492d59?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=e0494463b56525359403eefe8892b965 2x, https://si.imgix.net/f160ab66/uploads/origins/92c08619-0b23-49c6-9609-801e16492d59?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=ea9b3765af73349fb5a35877af42d448 3x"}, "body": "いぬっこまるさん初めまして！　すなじろと申します。\n\nものすごくかわいい絵柄のポストが目に入ってぜひうちの子も描いてほしい！　と一目惚れしましたので、うちの子であるノラちゃんをいぬっこまるさんの絵柄で描いていただきたいです！\n参考資料が過去のSkeb納品イラストのみとなることをご容赦ください。\n\nノラちゃんは、狐をモチーフとしたけもみみの女の子です。\n年齢は10代半ばくらいで、大きなしっぽに八重歯がチャームポイントです。\n少しじっとりとした青い目と、ふわふわ癖っ毛なボブくらいの髪の毛が特徴で、トレードマークの青い眼鏡をおでこにひっかけています。\n普段の服装は青いパーカーに黒のハーフパンツで、ゆとりのある服装を好んで着ることが多いです。\n性格はおっとりとしていていつも眠そうで、だらけることが好きな子ですが、ノリはよく朗らかな笑顔の似合う子です。\n\n過去のイラストを拝見し、いぬっこまるさんのデザインセンスがとても好きでしたので、よろしければ好きな服装へのチェンジ、もしくは既存の服装へのアレンジを加えていただきたいです。\n和装・洋装問いませんが、季節が冬なのであまり寒くなさそうな露出の少ない格好だと嬉しいです。\n\n服装・構図のアイデアやフレークモチーフとして、以下のものを提案します。\nお好きなように混ぜて結構ですので、取捨選択してお使いください。\nあくまでも一例なので、もちろんここにないものを取り入れる・すべて無視していただいてもOKです。自由な発想でお願いします。\n①きつね：足跡、ぬいぐるみ、きつねのハンドサイン\n②夏モチーフ：青空、緑の山、ひまわり、すいか、入道雲\n③音楽モチーフ：♪記号、ヘッドホン、楽器、CD\n④睡眠モチーフ：まくら、目覚まし時計、パジャマ\n⑤好きなポーズ：眼鏡に手をかける、ピース、萌え袖、目をこする、がおーのポーズ\n⑥そのほか：星マーク、風船、かに\n雑多な列挙となってしまい申し訳ありませんが、なにかアイデアの元となれば幸いです！\n\nこれは余裕があればでよいので眼鏡の着用差分があると嬉しいです。\n（金額的に難しければなくても大丈夫です。）\n\nその他の事項はお任せします。\n頂いたイラストは自身の保有するSNS等のアカウントで、アイコン・ヘッダーとして使用することがあります。\n（収益化チャンネルでの使用・商用グッズ利用などは行いません。）\n よろしくお願いします！\n\nhttps://skeb.jp/@sunajiro8", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@sabukkomaru/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3812929, "client_id": 1908638, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/9337aeed/uploads/origins/92fb520c-7040-4a89-8910-a6a13ab804ef?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a73ecbaf00a0a149c929a569eec844c4", "srcset": "https://si.imgix.net/9337aeed/uploads/origins/92fb520c-7040-4a89-8910-a6a13ab804ef?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a73ecbaf00a0a149c929a569eec844c4, https://si.imgix.net/9337aeed/uploads/origins/92fb520c-7040-4a89-8910-a6a13ab804ef?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=1d19ad8d347be074864bfd7592df95ad 2x, https://si.imgix.net/9337aeed/uploads/origins/92fb520c-7040-4a89-8910-a6a13ab804ef?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=02f0510ae140ab3cbdc77151cb10815c 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "