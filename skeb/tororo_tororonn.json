38-f18d-4208-ad6d-3f071f0bbdc4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=50c1e7c51340748cc509bd1eef169dbf 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/81cad080/uploads/origins/3299fb38-f18d-4208-ad6d-3f071f0bbdc4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=60b5c23871110f2522976cc703b4c2f5", "srcset": "https://si.imgix.net/81cad080/uploads/origins/3299fb38-f18d-4208-ad6d-3f071f0bbdc4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=60b5c23871110f2522976cc703b4c2f5, https://si.imgix.net/81cad080/uploads/origins/3299fb38-f18d-4208-ad6d-3f071f0bbdc4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=f1165ce14de5062b3cc36a8789f279db 2x, https://si.imgix.net/81cad080/uploads/origins/3299fb38-f18d-4208-ad6d-3f071f0bbdc4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=3a01cce485d3327aac26e97be41292f9 3x"}, "body": "こんにちは！できれば私のOC、アンギャルをあなたのスタイルで描いてほしいです！\nアンギャルについての重要な注意事項\n彼女は天使と悪魔のハーフです。\n悪魔側の赤い目の瞳孔は猫目ですが、天使側の黄色い目の瞳孔は普通の人間の目です。\n悪魔側の髪は胸まである長い乱れた黒髪だが、天使側の髪は端が逆立つように手入れされた短髪で、首までしかない。\n真ん中にファスナーのあるラテックスのスーツを着ている。\n後光は半分に割れており、天使側の上部にしか見えない。拡大すると資料ではっきりわかる。\n悪魔側の目の下には傷跡があり、溶岩かマグマのような肌を見せている。\nアンギャルにはとがった鋭い歯がある。\n肩には魚網を着ている。\n物静かで、険しく、不機嫌で、無感情に見える。\nパースとしては、彼女が顔を少し持ち上げながら（彼女が見ている人が彼女より少し背が高い場合を想像してほしい）、何か邪悪なことをしようとしているような、非常に険しく、真剣で、死にそうな顔のクローズアップが欲しい。\n背景はあなた次第ですし、追加しなくてもかまいません。ただ、彼女の真剣な表情にふさわしい背景が欲しい。\n\nhttps://drive.google.com/drive/folders/1tCzm9Wy2IQdNbJ4PpdoW21ubpdltv5eM", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@tororo_tororonn/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2625574, "client_id": 3462408, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/6f912f8d/uplo