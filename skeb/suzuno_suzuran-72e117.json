_acceptable": true, "yearly_report_client_visible": false, "total_appeals_count": 0, "received_works": [{"path": "/@suzuno_suzuran/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3902624, "client_id": 3789249, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/54a3ab28/uploads/origins/4bfc7812-ca85-4325-bac8-87d0e65135da?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ef93d82cc54cf64facc8ecc3082b9234", "srcset": "https://si.imgix.net/54a3ab28/uploads/origins/4bfc7812-ca85-4325-bac8-87d0e65135da?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ef93d82cc54cf64facc8ecc3082b9234, https://si.imgix.net/54a3ab28/uploads/origins/4bfc7812-ca85-4325-bac8-87d0e65135da?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f75df57d2640ce3df128cf3db97ab1a6 2x, https://si.imgix.net/54a3ab28/uploads/origins/4bfc7812-ca85-4325-bac8-87d0e65135da?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=254958268ab0a848582fad11e7ff912d 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/54a3ab28/uploads/origins/4bfc7812-ca85-4325-bac8-87d0e65135da?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ad732b8707d366f8b54cc2a348fa946f", "srcset": "https://si.imgix.net/54a3ab28/uploads/origins/4bfc7812-ca85-4325-bac8-87d0e65135da?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ad732b8707d366f8b54cc2a348fa946f, https://si.imgix.net/54a3ab28/uploads/origins/4bfc7812-ca85-4325-bac8-87d0e65135da?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=f6add260cfbfe4c378561c1732fe9061 2x, https://si.imgix.net/54a3ab28/uploads/origins/4bfc7812-ca85-4325-bac8-87d0e65135da?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=7606f9958664203f3e1505fa3c4a56aa 3x"}, "body": "先生、こんにちは。私は外国人なので、AI翻訳を使いました。\nおそらく割引の期限を過ぎてしまったため、先生に断られてしまったようですが、どうしても先生の絵が欲しくて、再度リクエストを送らせていただきました！\n\n先生に描いていただきたいのは、\n髪色は白髪、髪型はストレート、長さはミディアムロングのキャラクターです。\n年齢は少女です！\n目の色は淡い青色です。\nそして、金色の提灯を持っています。\n服装は少女聖騎士のようなスタイルを希望します。（もちろん、先生の方がもっと現代的な普段着をデザインしてくださっても構いません！服装については特に強いこだわりはありません！）\n表情は真剣なものでしょう。\n\nこれは私のD&Dキャンペーン（『エンド・オブ・ザ・ワールド』）のオリジナルキャラクターです。以下がバックストーリーですが、もし先生にこのストーリーからインスピレーションが湧いたら、自由にアレンジしてください！\n\n私、ライセマンにて、仲間たちと共に、最期の一瞬まで戦い抜いた。\n彼らは……皆、無鉄砲な連中だった。なぜ彼らがライセマンで、あの\n【間】\nいわゆる「ささやき手」に仕える……『怪物』（私はそれらを生物とは考えていない）と戦わねばならなかったのか、私には理解できない。何しろ彼らには、信仰などなかったはずだ。\nだが、彼らは確かに、ライセマンで最期の一瞬まで戦い抜いた。\n私は彼らと共に最後まで戦い抜くことはできなかった……\n彼らは生前も戦士であり、死後も安らぎを得ることはない。復讐の軍団が私の耳元で夜通し叫び、咆哮し、たとえ戦って粉々になっても、囁き手の首を刎ね落とすと誓っている。\nライン、スー・ズー、オグルト、タス……計千百二十二の名。そして彼らは必ずや囁き手の命を奪い取るだろう\n戦友よ、焦ることはない。枯れ果てた手が砕け散る時、私は君たちと共に旅立つ。\n千百二十二の名が復讐を叫ぶ\n千百二十二人の戦士たちの怨念が大地に溢れ出す\n千百二十二の刃が、砕けた白骨を渇望している\n私が囁き手の首を斬り落とせば、君たちの安息が得られるだろう。\n\n「ライザーマンの白」ホワイト（white）、彼女にはもはや本名がないようだ。ただ、かつてライザーマンという地を放浪していたこと、そこは狂戦士や魔術師ばかりが生まれる場所であるということだけが知られている。\nなぜ彼女がレイサーマンで暁の主を信仰するようになったのか、なぜ重装甲を身にまとい騎士となったのか、誰も知らない。おそらく、これらすべては1530年以降、囁き手の手下がレイサーマンに侵入したことと関係があるのだろう。\n彼女はかつて「放笑者」と呼ばれる組織で戦っていた。それは1530年以降、囁き手と共にレイサーマンで台頭した組織である。たとえ彼女が、笑うのが好きな人に見えなかったとしても。\n「私は迷える羊のように迷い、後れを取り、人々と共に列を成すことができなかった。今、私はもはや言葉を持たない暁の主にかけて誓う。この最後の戦いにおいて、私は決して後退せず、また失われることもない。」\n\n以上、先生からの返信をお待ちしております", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@suzuno_suzuran/works/6", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/0a2ec82a/uploads/origins/197a4493-8369-43d0-804a-96ca737de0f3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=93e7196975b50487cc5d5d4f62f08fee", "srcset": "https://si.imgix.net/0a2ec82a/uploads/origins/197a4493-8369-43d0-804a-96ca737de0f3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&