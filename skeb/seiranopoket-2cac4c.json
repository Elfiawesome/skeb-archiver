.net/32fe97e4/uploads/origins/37d7758e-8e21-4c49-9a54-96d07a59a39a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=fe5b308313b70ed08c0683a982e853e0 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/32fe97e4/uploads/origins/37d7758e-8e21-4c49-9a54-96d07a59a39a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d4ec29364ef1c43ebd6fd1fe389ba448", "srcset": "https://si.imgix.net/32fe97e4/uploads/origins/37d7758e-8e21-4c49-9a54-96d07a59a39a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d4ec29364ef1c43ebd6fd1fe389ba448, https://si.imgix.net/32fe97e4/uploads/origins/37d7758e-8e21-4c49-9a54-96d07a59a39a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=f883ef6a4337bf54818a00534764c734 2x, https://si.imgix.net/32fe97e4/uploads/origins/37d7758e-8e21-4c49-9a54-96d07a59a39a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=39d8b9bc5246242b76f273ecfcee7da4 3x"}, "body": "いつも遊んでくださってありがとうございます！初スケブ試してみようと思ってせいらさんにご依頼出させていただきます！\n依頼の内容ですが、「うちの子ソラちゃんがソファに座りながらゲーム（スイッチ）している」という絵をお願いしたいと思ってます。\n雰囲気的にはリラックスしながらエンジョイしてる感じでお願いします。やっているゲームはマリオカートという設定です。\nソラちゃんについては資料は下のURLに置いてあります！\n体型はとくに特徴的で胸がかなり大きい(具体的にはIカップぐらい？）設定です！\nソラちゃんの資料↓\nhttps://x.com/evasuran/status/1799780601756848252", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@seiranopoket/works/10", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1269223, "client_id": 3060516, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/055bd83e/uploads/origins/c37e0cb9-f69f-4b08-a24e-370368de5c1e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1a62926001ef03b8f62ae713e294fde9", "srcset": "https://si.imgix.net/055bd83e/uploads/origins/c37e0cb9-f69f-4b