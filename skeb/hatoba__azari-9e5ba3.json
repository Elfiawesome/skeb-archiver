2-816a-b50f0753190c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2e02b51abb16e8b463f313d9582512c7", "srcset": "https://si.imgix.net/9abf0b8f/uploads/origins/b9149a41-bf21-4602-816a-b50f0753190c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2e02b51abb16e8b463f313d9582512c7, https://si.imgix.net/9abf0b8f/uploads/origins/b9149a41-bf21-4602-816a-b50f0753190c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=32cc448f9e5e9f36bedc10eefe324d95 2x, https://si.imgix.net/9abf0b8f/uploads/origins/b9149a41-bf21-4602-816a-b50f0753190c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=70d4986fdf9e65df4f41b2e4b2f1ecab 3x"}, "body": "波帷様\n\nはじめまして、ほいっぷと申します。\n波帷様のイラストをタイムラインでお見かけした時から、いつかリクエストしたい！と思っておりました。\nXのポストを偶然お見掛けしたのですが、どうやら他の方がプル夜キャラのイラストをご依頼されたことに喜ばれていたので…。\nそれならばぜひ自陣のイラストもお願いしてみたい！と勇気を出してリクエストを送らせていただきました。\n\n\n【キャラクター詳細】\nCoC「プルガトリウムの夜」「デストルドーの使者」の探索者たちになります。\n以下、記載している内容にシナリオのネタバレはありません。\n\n【キャラクター詳細】\nHO1：小鳥遊 凌（たかなし りょう）/男性/31歳/180cm\n職業：警視庁刑事部捜査第一課の刑事（警部補/班長）\n性格：非常に生真面目で正義感が強い。表情の変化に乏しく無愛想なため威圧的な印象を与えやすいが、責任感が人一倍強く面倒見がとても良い。\nその他：右利き。喫煙者だが非喫煙者がいる前では吸わない。吸っている煙草の銘柄はメビウス。HO2のことを「小桜」と呼んでいる。\n*CS：https://iachara.com/view/11537220(プル夜通過済み→「メモ」のみ欄閲覧可。追加メモ欄は不可)\n\nHO2：小桜 瑛大（こざくら えいた）/男性/26歳/174cm\n職業：警視庁刑事部捜査第一課の刑事（巡査部長/HO1班の班員）\n性格：非常に温厚で心優しく穏やか。常に呑気でのんびり屋。元々は自己肯定感が低かったが、現在は自分に自信を持っている。\n基本的にはニコニコしている。HO1に無視されてもめげずに話しかける。\nその他：左利き。非喫煙者であり煙草が少し苦手。ラムネ（お菓子）が好物。サクラソウの花が好き。HO1のことを「はんちょー（※班長）」と呼んでいる。\n*CS：https://iachara.com/view/12432851(プル夜通過済み→「メモ」欄のみ閲覧可)\n*立ち絵元：https://booth.pm/ja/items/6941162\n\n\n【資料】\nhttps://drive.google.com/drive/folders/196AGZjJjJOGBSv_0wTg4_1jcRWJ06_iQ?usp=sharing\n(資料URL欄にも同じものを記載しています)\n\n【構図など】\n基本的にはお任せでお願いしたいのですが、2人で仕事をしている様子が見てみたいなと考えています！\n例\n・HO1の持っている資料をHO2が横からのぞき込んでいる\n・担当した事件の報告書を書いている。HO2はちょっとサボってお菓子食べてる\n・事件現場で捜査中\n……などがイメージです！あくまでイメージになりますので、別案があればお任せいたします。\nHO2はちょっとHO1に対して距離感が近いです。\n\n\n【使用用途】\n・個人の鑑賞用及びSNSなどで画像の投稿\n・同じシナリオを通過した友人への共有\n・パソコン用壁紙としての利用、場合によってはSNSでのアイコンやヘッダーとしての利用\n・個人使用の範囲で自分と相方のみ、非商用のグッズ化の可能性\n\n\n上記内容でお願いしたいです。\n金額他、記載の内容など不備がありましたらお手数ですが再送要請・キャンセルをお願いします。\nご検討いただけますと幸いです。よろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/196AGZjJjJOGBSv_0wTg4_1jcRWJ06_iQ?usp=sharing", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@hatoba__azari/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 4002017, "client_id": 1389755, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/9c2f48fa/uploads/origins/251a4794-7f99-4c23-9f2e-0d55c9e2e2e7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3cd323209864d2910334b52a31d6e955", "srcset": "https://si.imgix.net/9c2f48fa/uploads/origins/251a4794-7f99-4c23-9f2e-0d55c9e2e2e7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3cd323209864d2910334b52a31d6e955, https://si.imgix.net/9c2f48fa/uploads/origins/251a4794-7f99-4c23-9f2e-0d55c9e2e2e7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a4e626b3ad8c50fb1457e2b908fdaff7 2x, https://si.imgix.net/9c2f48fa/uploads/origins/251a4794-7f99-4c23-9f2e-0d55c9e2e2e7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=1e51896561da0ee22f2eb39196d4db09 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/9c2f48fa/uploads/origins/251a4794-7f99-4c23-9f2e-0d55c9e2e2e7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5b26689b04ed896da77317145a0399d3", "srcset": "https://si.imgix.net/9c2f48fa/uploads/origins/251a4794-7f99-4c23-9f2e-0d55c9e2e2e7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5b26689b04ed896da77317145a0399d3, https://si.imgix.net/9c2f48fa/uploads/origins/251a4794-7f99-4c23-9f2e-0d55c9e2e2e7?bg=%