only_public": false, "tip_acceptable": true, "yearly_report_client_visible": false, "total_appeals_count": 0, "received_works": [{"path": "/@sol_god_dog/works/83", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 941511, "client_id": 2066431, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/a02b2456/uploads/origins/4a05b6e8-eceb-4332-b4fd-0b337297e913?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f391f1c29ca781b18725b5c737ceca8e", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/a02b2456/uploads/origins/4a05b6e8-eceb-4332-b4fd-0b337297e913?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=4f68ae8c222b7a789223683a5e7dc03a", "src_set": ""}, "body": "そる様\nアリミリのダブルたくし上げ絵（https://x.com/sol_god_dog/status/1888095559770325328/photo/1）の見せっぷりが非常に良かったので、うちの子でリクエストさせて下さい\n\nシチュエーション\n同じく肩を並べて正面たくし上げ\n（ゲームのクエスト中っぽい感じで）情報かアイテムを譲ってもらうため、\n任務のためと言い聞かせながら要求に答えているシーン\n\nワイシャツの分かれ目が見えるまでたくし上げ、\nパンツは二人とも白かパステルカラーの無地を基本にし、あまり割れ目を強調しない感じ（それこそアリミリ絵のように円弧１本で膨らんだパンティーライン）でお願いしたいです\n表情は下のキャラ説明時に記載します\n\n\nキャラ\n二人とも不明点はブレザー系の制服、まな板、ツリ目として解釈してOKです\n①高飛車金髪お嬢様\n（https://downloads.fanbox.cc/images/post/9624632/6JGnGNIZ13lLoO1mnzvDCnRd.png）\n表情は「こ、この程度の事で狼狽えませんわ」と強がってる（めっっちゃ効いてる）引きつった笑顔\n\n②真面目な優等生タイプ（ドジ）\n（https://downloads.fanbox.cc/images/post/9624632/1F12Uf2iAShV8Nvu5t8bFCgc.png）\n表情は恥ずかしさに目を少し逸らしている困惑顔「うぅぅ…」\n\n\nよろしくお願いします", "nc": 161, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@sol_god_dog/works/82", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 941511, "client_id": 0, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/859291bd/uploads/origins/bbe5481a-b0b8-4351-9994-7e0ffcf1181a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b7cc83f907069d6847d89165dfa97ddd", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/859291bd/uploads/origins/bbe5481a-b0b8-4351-9994-7e0ffcf1181a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b9475902e6ab7e3610ab8374cc20f336", "src_set": ""}, "body": "最近Xに投稿された「夏マキちゃんその2」を見ました。このお尻とシチュエーションは最高です！\n\nそこから続くかのように、マキちゃんと後背位を行うイラストをお願いします。\n男性の視点で、背中、お尻、ずらし挿入を堪能させてください。\n可能なら射精差分も頂けると大変嬉しいです。\n\nどうかよろしくお願いします。", "nc": 160, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@sol_god_dog/works/81", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 941511, "client_id": 2654016, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/320096b0/uploads/origins/4616602f-2428-4810-a929-cc5676686012?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d862453c45c9fcf60871e841f79d5c05", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/320096b0/uploads/origins/4616602f-2428-4810-a929-cc5676686012?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=fa6b476e72ac9283466d9ec83f0af364", "src_set": ""}, "body": "こんにちは、昔からイラストのファンです。\nよろしければ、ゲーム「プロジェクトセカイ」に登場する「桐谷遥」をそるさんの絵柄で描いていただきたいです。（お子様もやるゲームなので健全な感じで！お願いします！）\nアイドルなので、こちらにウインクしながらファンサをしている感じでお願いしたいのですが、もし難しいようでしたらポーズはおまかせします。\n参考: 遥が出演した映画の予告編です。https://youtu.be/eBNkVGbjbBk \n\n衣装は資料URLをご参照ください。\n\nいただいたイラストは、私のX（Twitter）アカウント(@ WilliamEB1)で公開する場合がございます。\n\nご検討、どうぞよろしくお願いいたします。\n\nhttps://sh-anime.shochiku.co.jp/pjsekai-movie/character/kiritani-haruka/", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@sol_god_dog/works/80", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/56df8a42/uploads/origins/18d8ef47-f59c-4e16-92d5-942559047c5a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=da4ee1838af560522c737d21a9fcb306", "src_set": ""}, "private": true, "genre": "art", "tipped": true, "creator_id": 941511, "client_id": 0, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 145, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@sol_god_dog/works/79", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 941511, "client_id": 0, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/825d94b0/uploads/origins/3b307d51-811d-4f18-878d-fc5b22203325?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1f14567d044a7e21d4e028af87db49bd", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/825d94b0/uploads/origins/3b307d51-811d-4f18-878d-fc5b22203325?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a69ddb4eef312052216b2af4f2c52360", "src_set": ""}, "body": "素敵なメイドささらちゃんの数々を目にし、ここへたどり着きました。\n\n同じメイド衣装を着たささらちゃんに開脚騎乗位で奉仕されるイラストをお願いします。\n胸は露出させ、スカートを捲るか脱いでずらし挿入をしてほしいです。\nもし可能なら、射精差分もあると感激です。\n\nどうかよろしくお願いします。", "nc": 161, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@sol_god_dog/works/78", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/3077b42e/uploads/origins/bf239b28-4246-4083-bf4d-c2926ded82bf?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=138f5f1b8847fb9f11488bb4f0ad3795", "src_set": ""}, "private": true, "genre": "art", "tipped": true, "creator_id": 941511, "client_id": 0, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 16, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@sol_god_dog/works/77", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 941511, "client_id": 3282056, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/d6e31263/uploads/origins/4468ee8c-ca1e-4261-b45a-110bcb7aaee9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6455fa301f1b8b8666158cea823ae344", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/d6e31263/uploads/origins/4468ee8c-ca1e-4261-b45a-110bcb7aaee9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9bfc8b9c96072b7ac5f0448894b95fcf", "src_set": ""}, "body": "リクエスト失礼いたします。\n\nシチュエーション\nパンツ見せてくれるアリアルさんとミリアルちゃん\n\n詳細\n・ショートパンツを脱いだ状態\n・アリアルさんはすごく恥ずかしがっている/初心な表情、大人し目なパンツ、恥ずかしそうになんとか見せてる/上着で一部隠して一部見えてる状態\n・ミリアルちゃんは肉食系で舌なめずりして期待してる/上気してる表情、大人なパンツ、扇情的に見せつけてる/上着の裾を広げて堂々と見せてる\n\nよろしくお願いいたします。", "nc": 177, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@sol_god_dog/works/76", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 941511, "client_id": 1169005, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/ce192ad4/uploads/origins/cbc4b3ac-e968-45d9-b665-e1a79d457e0e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bb128cca8bd61d7db506c3abdf178aa8", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/ce192ad4/uploads/origins/cbc4b3ac-e968-45d9-b665-e1a79d457e0e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=752e4139429b675a85d1e78bf94325d9", "src_set": ""}, "body": "お世話になっております。\n今回依頼したのは「雪音りうの左側を埋めるもち子さん」です\n\n雪音りうが企画したイラストイベント\nhttps://x.com/yukineriu/status/1839621255210664126\nについて、お題になっているイラストに対して、りう　と　「模型娘のもち子さん」がハートを作れるようにもち子さんのイラストを追加加筆していただきたいです。\n\n※ちなみに雪音りうは A.I.Voiceで音声合成ソフトに目指しているだけの一般人です（発売するかどうかも未定）\n\nもち子さんの衣装は装甲少な目の方でお願いします。\n\nここからは依頼ではないのですが、完成したイラストについて、Twitter等のSNSで素材として投稿した上で、もち子さんのみの部分に「みんなももち子さんとハートを作れるぞ！」等のアオリを添えると、もち子さん公式絵師らしいかと思います。", "nc": 48, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@sol_god_dog/works/75", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 941511, "client_id": 0, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/81f89379/uploads/origins/17603955-3684-4868-b78e-f84c2c660e1d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4e792cc2b38338b661df6ff34f14d130", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/81f89379/uploads/origins/17603955-3684-4868-b78e-f84c2c660e1d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=60226ba77906a4179cf21468fdc4f83a", "src_set": ""}, "body": "ナースコスプレした蓮鬼ねむちゃんが中出しされて蕩けている作品をお願いします（事後ではなく出される瞬間で、体位自由）", "nc": 33, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@sol_god_dog/works/74", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 941511, "client_id": 33592, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/76f3baf6/uploads/origins/63174a5d-b73d-46fe-86ac-60ef27b2310e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=58fc9b74c95add0724f51fc5b028509f", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/76f3baf6/uploads/origins/63174a5d-b73d-46fe-86ac