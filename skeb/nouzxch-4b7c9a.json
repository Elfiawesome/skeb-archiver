ングレット)、体臭が好きになり(一応変だと気づき抵抗はするが結局は溺れる)欲望は膨れあがり、バビディの命令でスポポビッチ(ピッコロの身体)にピッコロへ奉仕させたりピッコロに抱かれたり、ダーブラに逆にピッコロを抱かせて尻の良さを教え込んだりで、ついにピッコロは秘めていた欲望に飲まれて洗脳され此処でピッコロの性癖と性嗜好は完全に歪んでしまう。\n\nピッコロは着ているものも万年同じで体臭はなさそうなので、身体が入れ替わってからの着ているものや汗や体臭に敏感だと嬉しいです。", "nc": 40, "word_count": 4348, "transcoder": "text", "creator_acceptable_same_genre": true}, {"path": "/@nouzxch/works/7", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/56178062/uploads/origins/75e30b5f-d937-4c13-b630-d059b1531976?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=ed70a96bc6de1956cbd7a374d46bf1ed", "srcset": "https://si.imgix.net/56178062/uploads/origins/75e30b5f-d937-4c13-b630-d059b1531976?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=ed70a96bc6de1956cbd7a374d46bf1ed, https://si.imgix.net/56178062/uploads/origins/75e30b5f-d937-4c13-b630-d059b1531976?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=d309885dde1931c2decd61b12edf83f2 2x, https://si.imgix.net/56178062/uploads/origins/75e30b5f-d937-4c13-b630-d059b1531976?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=320b297027a59d0a2969838da14efcea 3x"}, "private": true, "genre": "novel", "tipped": true, "creator_id": 86301, "client_id": 45373, "nc": 49}, {"path": "/@nouzxch/works/6", "private_thumbnail_image_urls": {"src": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1681843730062659585%2FK7ZBpkI5.jpg?blend64=aHR0cHM6Ly9za2ViLWF2YXRhci5pbWdpeC5uZXQvfnRleHQ_&blendalpha=100&blendalign=center&blendmode=normal&blendsize=inherit&bg=%23fff&auto=format%2