//si.imgix.net/a6f306de/uploads/origins/594f6ca4-6b4e-4001-9d15-419eb25f5dbc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=57c97d361db5d472a47bf1fc671b77fd", "src_set": ""}, "private": true, "genre": "art", "tipped": false, "creator_id": 1232984, "client_id": 302886, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 161, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@SSenkoku/works/95", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1232984, "client_id": 28975, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/9500274a/uploads/origins/2a5aa0a9-b893-4912-9c64-91e9b1028f18?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c1829dcc5debbd1012c8e1a4b71b75ab", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/9500274a/uploads/origins/2a5aa0a9-b893-4912-9c64-91e9b1028f18?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=455e4d388818e302e9491fe28794c478", "src_set": ""}, "body": "本当にありがとう。\n\n\nまた大きなダキマクラの依頼があれば、やってみたいです。\n\n\n今度は飛鳥ですね。 パイロットスーツが描かれているのも面白いと思うので、好きな方を自由に選んでください。 サムスのときと同じように、破れてないほうを描いたら、破れてるほうのバリエーションがあってもいいと思います。\n\n\nポーズや構図はまたお任せします。 背景はシンプルなシートでも構わない。 参考になればと思い、ポーズの参考を追加しました。\n\n\nその他、作品に盛り込みたいことがあれば自由にお願いします。 もし適していれば、彼女の帽子や眼帯のようなアクセサリーがあってもいいかもしれませんが、もし適していなければ、これは無視してかまいません。\n\n\n参考文献のリンクは数週間後に削除する予定なので、保存が必要な場合はそうしてください。\n\nhttps://drive.google.com/drive/folders/1hRA2a-9k6dAtKJmGYuqNLchgAuQ7RIno?usp=drive_link", "nc": 161, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@SSenkoku/works/94", "private_thumbnail_image_urls": null, "private": 