細い布があてがわれ、頭の後ろで縛られており反抗的な声や絶叫を抑える程の激しい陵辱の痕跡。\n全身: 汗だくで顔に貼り付く髪。巨根が引き抜かれた女性器はぽっかりと開き、更に指で開かれ奥から精子が垂れ出ている。激しい抽送により女性器や周辺はピンクに染まっている。胸、顔、腋、髪、太腿等には精子が塗り付けられ陰毛も付着。\n\nこだわり\nイグレーヌの褐色肌が汗でテカり、女性器は行為前から事後の変化により、綺麗な状態から下品な状態に。  表情についても凛とした表情と事後のギャップ。\n細部や差分は変更除外頂いても構いません。\n失笑宣告さんにお任せ致します。\n宜しくお願い致します。\n\nhttps://imgur.com/a/7MDzM0n", "nc": 170, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@SSenkoku/works/113", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/c0baeb80/uploads/origins/3c4752e2-61dd-4ca9-bf4e-cbbe52330c1f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=b6853c8795763ea473ac3c458b9a772f", "src_set": ""}, "private": true, "genre": "art", "tipped": false, "creator_id": 1232984, "client_id": 548231, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 35, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@SSenkoku/works/112", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/878c0fff/uploads/origins/adbf9dd9-702a-4a73-8854-314372775bda?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=d6ffdd414eba037f40886feda9d079ba", "src_set": ""}, "private": true, "genre": "art", "tipped": true, "creator_id": 1232984, "client_id": 342804, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 34, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@SSenkoku/works/111", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/1b1940b4/uploads/origins/941b1fae-e0e9-41ee-86ee-778fe5982cdb?bg=%23fff&auto=format%2