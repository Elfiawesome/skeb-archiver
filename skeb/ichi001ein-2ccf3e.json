6f8/uploads/origins/0cd18fda-18a4-401e-870b-00660b7fa0c4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=31d4bd60326de4522127864ee793b4d7, https://si.imgix.net/3aeae6f8/uploads/origins/0cd18fda-18a4-401e-870b-00660b7fa0c4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=8736308b21c38470cc77e8a2c1e48c63 2x, https://si.imgix.net/3aeae6f8/uploads/origins/0cd18fda-18a4-401e-870b-00660b7fa0c4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=0526fc43bc31f991d1c3a40e12f52b15 3x"}, "body": "いち様、初めまして。Ｘにて、いち様の魅力的な長髪男性の投稿を観まして知り、今回リクエストさせて頂きたいと思いました！\n内容は、私のオリジナルキャラクターの「テレクシオ」です。本来は心根優しい病弱お兄さんなのですが、諸々創作上の都合で、やや闇落ちしたような姿の方を依頼したいです。\nキャラクター性としては、敬語で温和な先生のような雰囲気で、どこか含みのある笑みを浮かべているような感じです。（伝わりずらかったらすみません…！）\n\n容姿なのですが、白髪、灰色目、右目下に黒子が２つあります。服装はなんとなくのイメージデザインはあるのですが固定してないので描きやすいようにお好きに変更改良等して頂いて大丈夫です。\n\n素敵な長髪お兄さん供給を日々ありがとうございます！ご検討頂けますと幸いです。\n\nhttps://www.foriio.com/works/2506171", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@ichi001ein/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3916838, "client_id": 3321176, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/008d9d04/uploads/origins/00f93a40-65b5-4b52-ba1e-3ab28582a19a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d21138e57746f61e52f11acf092b7433", "srcset": "https://si.imgix.net/008d9d04/uploads/origins/00f93a40-65b5-4b52-ba1e-3ab28582a19a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d21138e57746f61e52f11acf092b7433, https://si.imgix.net/008d9d04/uploads/origins/00f93a40-65b5-4b52-ba1e-3ab28582a19a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=4ccf64ef0a0c412e01705e1e91e3157c 2x, https://si.imgix.net/008d9d04/uploads/origins/00f93a40-65b5-4b52-ba1e-3ab28582a19a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=fd983dd61c493393f1231aa1bdfd8ef8 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/008d9d04/uploads/origins/00f93a40-65b5-4b52-ba1e-3ab28582a19a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=677b1cda31b3ec8119d37992810c0f0c", "srcset": "https://si.imgix.net/008d9d04/uploads/origins/00f93a40-65b5-4b52-ba1e-3ab28582a19a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=677b1cda31b3ec8119d37992810c0f0c, https://si.imgix.net/008d9d04/uploads/origins/00f93a40-65b5-4b52-ba1e-3ab28582a19a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=2b27e3821c493619b2b0afa592ba751b 2x, https://si.imgix.net/008d9d04/uploads/origins/00f93a40-65b5-4b52-ba1e-3ab28582a19a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=1d45cd67b141b35e4ffa744847d7ac66 3x"}, "body": "初めまして。\nXにて長髪男子のキャラクターをよく描かれると拝見し、この度ご依頼させていただきます。 \n\nオリジナル男子キャラクター、ミハルのイラストをお願いします。 \nプロフィールや外見の資料をアップロードしましたので、ご参照ください。   \n\nhttps://drive.google.com/file/d/18OkoB5lJq7qH8XlxahV6TaZFaijB37J4/view?usp=drivesdk\n\n構図やポーズについてはお任せしたいと思いますが、上半身までは入っていますと嬉しいです。\n背景は無地で問題ありません。\n\nスマホの待ち受けにしたいと思いますので、縦長のサイズでお願いします。\nなお、使用している機種のピクセル数は\t1,320 × 2,868　となっております。\n個人鑑賞としての用途のみ使用します。\n\n どうぞよろしくお願いします。", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@ichi001ein/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3916838, "client_id": 2666890, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/9a1f4ac6/uploads/origins/562b9bba-cf18-4939-a6b8-9e0e881e166f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7663516560c48d8ffcd063db94dc7c47", "srcset": "https://si.imgix.net/9a1f4ac6/uploads/origins/562b9bba-cf18-4939-a6b8-9e0e881e166f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7663516560c48d8ffcd063db94dc7c47, https://si.imgix.net/9a1f4ac6/uploads/origins/562b9bba-cf18-4939-a6b8-9e0e881e166f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=0ce8773100f4f741b530f997412ff88c 2x, https://si.imgix.net/9a1f4ac6/uploads/origins/562b9bba-cf18-4939-a6b8-9e0e881e166f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=3b29d57dc52bf6188d99ca337f5b1bbd 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/9a1f4ac6/uploads/origins/562b9bba-cf18-4939-a6b8-9e0e881e166f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=aec3061e4c4652bace02c29bb7e832f0", "srcset": "https://si.imgix.net/9a1f4ac6/uploads/origins/562b9bba-cf18-4939-a6b8-9e0e881e166f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=aec3061e4c4652bace02c29bb7e832f0, https://si.imgix.net/9a1f4ac6/uploads/origins/562b9bba-cf18-4939-a6b8-9e0e881e166f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=ea3a134ddc91c8e07de5e5a100d53405 2x, https://si.imgix.net/9a1f4ac6/uploads/origins/562b9bba-cf18-4939-a6b8-9e0e881e166f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=2514fdbf3088201f7b016527ee7f02c0 3x"}, "body": "いちさん、はじめまして。しきしまと申します。\nいつも素敵な絵の数々を楽しんで拝見しております。\nリクエスト内容ですが、私の創作ブロマンス小説「良幸学院歌い手部」の主人公の相手役をお願いしたいです。資料として友人作のイラストのリンクをお送りします。リンク先の画像のうち青髪長髪褐色男子のほうです。\n\nキャラクター概要\n敬川真百合(うやがわ・まゆり)\n高校二年生で、10代序盤から歌い手をやっています。無表情でいることの多いダウナーっ子です。身長は177cmです。\n祖母が南アジアのとある国の出身で、彼自身はいわゆるクォーターです。\nコーヒーとカピバラが大好きです。\n\n主人公・陽希(読み方:「はるき」、リンク先のピンク髪の少年です)のことは最初は邪険にしつつ、最初のチャンネル登録者なので悪くなく思っています。\n\n制服がセーラーカラーブレザーと白カーディガンの2通りありますが、いちさんの描きやすい方でお願いします。\n\nアンニュイな感じにしていただければ、構図等はお任せいたします。\n髪型はそのままでも、もしくはいちさんのお好みのヘアアレンジも歓迎です。\n\nhttps://drive.google.com/drive/folders/1SlX8_f9hpsth