b0dafe20e4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=1912229f952638e7c52cc95df4c887dd", "srcset": "https://si.imgix.net/7bbc35fb/uploads/origins/57f2a48e-16b6-4ad1-8ad7-5fb0dafe20e4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=1912229f952638e7c52cc95df4c887dd, https://si.imgix.net/7bbc35fb/uploads/origins/57f2a48e-16b6-4ad1-8ad7-5fb0dafe20e4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=18b329476c3a9d17c34a1f9a8deeb369 2x, https://si.imgix.net/7bbc35fb/uploads/origins/57f2a48e-16b6-4ad1-8ad7-5fb0dafe20e4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=b17a76d818c9efcc936d143e56842eea 3x"}, "body": "砂川 蛟様　こんにちは！前回ありがとうございました！良ければ私のオリジナルの世界観の宝石龍の世界に関わるヒポグリフのイラストをお願いできますでしょうか。\n\n▼キャラ内容\nヒポグリフのデザインの詳細は添付のキャラクターのシート確認してください。\n名前：クシュトー\nテーマ：宝石、樹木、秋、イチョウの葉と楓の葉の紅葉、\n元は普通のヒポグリフでした。とある存在の影響を受けて、体の半分以上樹木化している。羽毛と尻尾が宝石に変わった。\n「亡国の馬獣人の王族の少女：ネーリャエッタ」と幼い頃に出会い仲が良くなり、旅をしている。\n気性：日常では穏やかで友好的、敵や危険に対して勇猛、少女を守る\n\n羽毛と尻尾の毛が宝石化、体が樹木化していますが、クシュトーは通常の体のように、羽毛や尻尾も同様に問題なく動かせます。\nクシュトー以外が触れると樹木や宝石の感触となる。\n\n世界観：西洋風ファンタジーを下地にした異世界です。\n\n▼希望イラスト内容\nヒポグリフ、クシュトーのイラスト\n\n▼データ：原寸大PSDデータと、原寸大宛名無しpngファイルで納品していただけると幸いです。\nPSDはレイヤーファイル内で差分・宛名・背景とキャラ等が切り替えられる形式でお願いいたします。\n\n▼使用用途\n描いて頂いたイラストで他の方へキャラクターイラストのコミッションの参考とする場合があります。\n\nどうぞよろしくお願いいたします。\n\nhttps://www.dropbox.com/scl/fo/dzxui4rmzp4x1oh68x2a9/AIDvc-paQEXE8xacHt7l5ZQ?rlkey=un3z2xwu0hgi9739tx4ahsbz4&st=uo17f75i&dl=0", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Sunakawa_mizuti/works/9", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 875160, "client_id": 3647756, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/390168a6/uploads/origins/876e179f-8f15-41e9-b6c1-92796d3d55ae?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3d88a9795ba866