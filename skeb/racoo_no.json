press&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ca680dff0c713eb61cc0652c4622d7a6", "src_set": ""}, "body": "こんにちは、racoo_noさん！\n\n以前もお願いしたのですが（https://skeb.jp/@racoo_no/works/9）、2.0の新しいキャラクターデザインをぜひ描いていただきたいです！\n\nhttps://imgur.com/20FMvuM。\n\nこれは新しいバージョンの最初のラフリファレンスシートです: https://imgur.com/7CnUHuz\n\n星、宇宙、未来、仮面ライダーをモチーフにしたエイリアンの暗殺者です。  あなたの作品は私のビデオサムネイルとスケジュールに使わせていただきます！\n\nありがとうございます！", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@racoo_no/works/28", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2922988, "client_id": 1363075, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/6f6050ad/uploads/origins/7f97b849-e93e-4487-809c-14638122115c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e9607c39b280028ca9a040375c2b353f", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/6f6050ad/uploads/origins/7f97b849-e93e-4487-809c-14638122115c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a4f84b53dc24fd4d386e3ad19c8df5c5", "src_set": ""}, "body": "こんにちは！あなたの画風がとても可愛くてエレガントで大好きです！あなたの画風で私の分身OCを描いてほしいです！\n\nアルター雪虎(163-165cm)は、やんちゃだけど冷たくて逞しい雪虎のVtuberです。\nバストカップはC！右目は紫、左目は赤。髪には黒い筋があります。耳は「雪虎耳参考.png」を用意しました。\n\n16:9の全身イラストを2枚お願いします。Raonの「クネクネ」をカバーしたいです。YouTubeとTwitterでクレジット表記します！\n\n分身OCはMVの0:53と1:13のようなポーズでお願いしたいです。MV: https://youtu.be/38-cJT320aw?si=Na77xxOc0GDZWRxP\n\n背景、髪型、服装は曲に合わせて自由に決めてください。\n\nすべてPSDで分けてください！できれば、MVを作れるように、目を開けたバージョンと目を閉じたバージョンをお願いします！\n\n私の依頼を読み、検討していただきありがとうございます！\n\nhttps://drive.google.com/drive/folders/1MRfuYbKEQ0E85Ur108PfJT_aJINep9dT?usp=sharing", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@racoo_no/works/27", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2922988, "client_id": 1250821, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/d527bd6d/uploads/origins/f5bb33c4-e98d-4c90-8529-a17d09eadceb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7aa12e1c2ed8891e7207b76b8df45ba0", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/d527bd6d/uploads/origins/f5bb33c4-e98d-4c90-8529-a17d09eadceb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6d2df232795ff6a1b048a9c1ea749121", "src_set": ""}, "body": "また相談にのってください！\n\n今回も\n創作活動で他デザイナー様に作成してもらったオリキャラの\nイメージを広げるため二次創作を御願いしたいです。\n\n未来世界で活躍する人間同等（というか人間以上）のアンドロイドＡＩです。\n基本的にクールな性格の設定ですが感情は豊かです。\n衣装はそのまま系でも別衣装でも良いです。\n\n使用範囲は\n自前の紹介サイトや、\nＸでの掲載となります。（Grok利用はOFFしてます）\n※トリミング使用も予定しています。\n\n御面倒かけますが\nよろしく御検討ください！\n\nhttps://twitter.com/oniyatsuhashi/status/1415375997273133056?s=20", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@racoo_no/works/26", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/86be19fa/uploads/origins/54e43f00-1940-4dee-8dce-3752d77b33ab?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=aa33b0dbd710210418d6777ffa890c2b", "src_set": ""}, "private": true, "genre": "art", "tipped": false, "creator_id": 2922988, "client_id": 0, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 16, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@racoo_no/works/25", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2922988, "client_id": 2187065, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/f4323e52/uploads/origins/dfd82a65-a5c8-4ac5-9896-8c2f807749ca?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=eb0816c041c4b46989e94b217f44f450", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/f4323e52/uploads/origins/dfd82a65-a5c8-4ac5-9896-8c2f807749ca?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=7615ec77d25599e3a4ca0a9cdd3bf467", "src_set": ""}, "body": "あなたのようなスタイルでキャラクターを作りたい！\n\n彼女は強い3尾のキツネで、性格はおてんばです。彼女はブラックホールを中心とした宇宙をテーマにしています。\n参考：https://drive.google.com/drive/u/1/folders/18kzmbjB_fii3D8pBo07Jjq6AmZ0mHqce\n\n新衣装を着て、クールでセクシーなポーズを描いてほしいです。ありがとうございます！\nhttps://drive.google.com/file/d/1n8Syx-ufbhseSiZ8U-PB0Srdqt_8RRDf/view?usp=sharing", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@racoo_no/works/24", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2922988, "client_id": 1250821, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/f6f5634f/uploads/origins/3f2bee94-1262-4005-bb9c-1ffd9779c1e7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=addc9d6e6981212d4d969cc3e7493846", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/f6f5634f/uploads/origins/3f2bee94-1262-4005-bb9c-1ffd9779c1e7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=4add0e455d90cdf3229c858abefcf404", "src_set": ""}, "body": "また相談にのってください！\n\n今回も\n創作活動で他デザイナー様に作成してもらったオリキャラの\nイメージを広げるため二次創作を御願いしたいです。\n\n未来世界で活躍するアンドロイドＡＩキャラです。\n人類を滅ぼす任務を負っていますが、人間が好きなので苦悩します。\n普段は普通に人間たちと接しています。\n衣装は同じでも日常系などで別に仕立てていただいても問題ありません。\n\n使用範囲は\n自前の紹介サイトや、\nＸでの掲載となります。（Grok利用はOFFしてます）\n※トリミング使用も予定しています。\n\n御面倒かけますが\nよろしく御検討ください！\n\n↓キャラデザイン\nhttps://x.com/oniyatsuhashi/status/1666842708630200320?s=20\n↓アレンジ画\nhttps://x.com/oniyatsuhashi/status/1865365008852648102", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@racoo_no/works/23", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2922988, "client_id": 0, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/94b9d1a1/uploads/origins/7cd03daa-dca0-4b53-a657-89396998fce6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0c75b3d92225fdeb78a3f9608933d62c", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/94b9d1a1/uploads/origins/7cd03daa-dca0-4b53-a657-89396998fce6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=1bc9eb0a191d3fb7d741bd838afca6be", "src_set": ""}, "body": "Your illustrations look amazing! I hope to have my OC commissioned in your style.\nhttps://imgur.com/a/setsuna-mls89ir\n\nThe character's name is Setsuna, her outfit wasn't meant to be a 1:1 recreation of the character Kasumi from the third Ninja Gaiden installment but more so to draw inspiration from. The outfit is meant to be of a similar make with a form-fitting black jumpsuit in the style of a ninja.\nhttps://imgur.com/a/setsuna-references-5Jyco0n\nThe sword she wields is a weapon that I'm fond of from the sandbox MMO Runescape 3.\n\n\nIn her illustration, it looks like she's missing an arm, but that's not the case; all her limbs are intact.\nI have no specific pose in mind but her expression always remains serious.\nI apologize for the trouble, Thank you for considering my request.", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@racoo_no/works/22", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2922988, "client_id": 1250821, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/3fc4739e/uploads/origins/823d26b0-e69f-4f