7d8-164977a7221a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=51995fbc00cd3d62482d8b90e801a301, https://si.imgix.net/be2a5a62/uploads/origins/80d5259d-4978-4d30-a7d8-164977a7221a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=94a2b838cd208a95191044c47f8782f8 2x, https://si.imgix.net/be2a5a62/uploads/origins/80d5259d-4978-4d30-a7d8-164977a7221a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=6aee96a25f7c0d30422cad9e7b6b53da 3x"}, "body": "こんにちは、コルプです。\n\n僕は香港出身の浅倉透と映画オタクです。宇宙鍋先生の映画っぽいイラストが大好きです。\n最近『恋する惑星』4Kレストア版が映画館で上映されました。せっかくなのでもう一度映画館に見に行きました。\n\nあらすじ\n\n「その時 彼女との距離は0.1ミリ。57時間後 僕は彼女に恋をした―」用心深くなってレインコートを脱がない女、誕生日の賞味期限のパイン缶を集める刑事、同じ曲をかけ続ける店員、失恋の傷が癒えず寄せられる恋心には鈍感な警官。無国籍な香港の街を舞台に交錯する男女ー。90年代の空気感をリアルタイムに封じ込めた“おとぎ話”。\n\n透は絶対にこういう映画が好きだと思います！先生のイラストを覚えて、リクエストをしようと思った。\n\nhttps://eiga.k-img.com/images/movie/44299/photo/b53e50a6ca563776.jpg\n\n先生のペンでこのポスターを再現して欲しい！\nイラストで、フェイは透に置き換えてほしい。\n\nリクエストの内容は以上です。\n\n宇宙鍋先生はこの映画を楽しめると思います。よろしければどうぞお時間ください。🙏\nhttps://youtu.be/Yx0bZxSH7uI?si=aYUKUy2JD0chmH0U", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@uchuunabe/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "comic", "tipped": false, "creator_id": 2773552, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/536dbb23/uploads/origins/e61fb1d0-9c7d-4359-9a6e-c2b11ee1a2af?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2d82575d1e98f54b6472b938f3c6e403", "srcset": "https://si.imgix.net/536dbb23/uploads/origins/e61fb1d0-9c7d-4359-9a6e-c2b11ee1a2af?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2d82575d1e98f54b6472b938f3c6e403, https://si.imgix.net/536dbb23/uploads/origins/e61fb1d0-9c7d-4359-9a6e-c2b11ee1a2af?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=8d4204cf6f6c4709269bc016010d0551 