1d305d36-1c4a-469f-bc75-e72bb9428df5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=688ac353bf0670c145fcd2de628a4d11 3x"}, "body": "こんにちは、zucchini-先生。\n\n私は長年のファンで、何年も前から先生の作品を楽しませていただいています。私のオリジナルキャラクター「ユキ」を描いていただけたら、本当に光栄です。彼女は背が高く、筋肉質な探偵で、白い髪と青い目を持っています。\n\nこちらのポーズ（https://drive.google.com/file/d/1tdxD-_n1rZ6QvwKrSBOKfE0pAb0qLFx2/）で、セクシーなランジェリーに太ももまでのレギンスを合わせた姿を描いていただけませんか？\n\nイラストは官能的でありながらもエレガントなものにしたいので、露骨なヌードは避けてください。また、キャラクターの丸いサングラスも描いてください。ロボットの腕は描かなくても構いません。\n\n作品の魅力を高めると思われる場合は、ぜひ彼女を鑑賞者の方に向け、魅惑的な表情をさせてください。ランジェリーのデザインは完全にあなたにお任せします。筋肉の描写が得意なようですので、腹筋や力強い腕、太ももも描いていただけると嬉しいです。\n\nまた、ポーズやランジェリーの雰囲気に合うシンプルな背景もお願いできれば幸いです。その詳細については、あなたにお任せします。\n\nこの依頼をご検討いただけましたら光栄です。よろしくお願いします。\n\nhttps://drive.google.com/drive/folders/1uD3Qw46MulUFrTFQje0S8vdD_7B_hP4h?usp=drive_link", "nc": 49, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 24253, "creator": true, "nsfw_acceptable": true, "acceptable": false, "name": "MAMO🔞", "screen_name": "mamo3mamo3", "avatar_url": "https://www.gravatar.com/avatar/1eac3365fcffa832647ee149a86cb19d?d=identicon", "header_url": null, "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "art"}, {"genre": "correction"}], "banned": false, "nc": 176}, {"id": 147860, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "春夏冬工", "screen_name": "akinaie", "avatar_url": "https://pbs.twimg.com/profile_images/1279310955239751681/rBXuU80q.jpg", "header_url": "https://pbs.twimg.com/profile_banners/16089797/1764315161/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 5, "complete