e2-4c75c2cd7090?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=deece12f2fbf903cff1ceee5b02a943a", "srcset": "https://si.imgix.net/78866f60/uploads/origins/b79ee9ba-47f7-4788-a8e2-4c75c2cd7090?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=deece12f2fbf903cff1ceee5b02a943a, https://si.imgix.net/78866f60/uploads/origins/b79ee9ba-47f7-4788-a8e2-4c75c2cd7090?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=df146ded5170ba6d812022f8cdc2936f 2x, https://si.imgix.net/78866f60/uploads/origins/b79ee9ba-47f7-4788-a8e2-4c75c2cd7090?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=ac6e7119625d92bd894af6d023f2340e 3x"}, "body": "こちらでは初めまして！先日のイベントお疲れ様でした！！マンガがとっても面白くて浜辺のナリさま&チカちゃん、ムササンバはえっっっっっ！で最高でした！！\nうといさんのカワイイヒデアキちゃんを見たくていつか依頼したいとずっと思っておりました！お付き合い頂ければ幸いです！！\n\n戦国乙女シリーズより「新・ラーメン大好き小早川さん(ヒデアキちゃん)」をお願いします！\n\n・全年齢\n・上半身、全身でなくてOK\n・(ほぼ)デフォルメ\n\n・うとゐさんの面白かわいいソーリンちゃみたいなやつ(資料参照)を「ラーメンをちゅるちゅる食べているヒデアキちゃん」で見たいなぁという妄想です！\nうといさんとつどいさん……フフ……あ、すみませんすみませんあ\"あ\"あ\"あ\"\n\n・表情、ラーメン\n0辛:デフォルメでない通常顔、両目瞑った満面な笑顔\nピリ辛:デフォルメでない通常顔、両目開き笑顔\n小辛:デフォルメ顔\n中辛:デフォルメ、少し汗、ほろ酔いソーリンのような顔\n大辛:デフォルメ、更に汗いっぱいな感じ\n激辛:デフォルメ、汗だく、顔真っ赤で火を吹いている、泥酔ソーリンのような顔\n地獄:デフォルメ、顔青ざめでボロ泣き\n限定:デフォルメ、ヒデアキレインボー、ラーメンが黒い「？」で隠されている感じ\nをそれぞれイメージしています！\n\n0〜小辛 味噌ラーメン(黄)\nhttps://foodplace.jp/menyatsudoi/menu/57\n中、大辛 辛旨ラーメン(橙)\nhttps://foodplace.jp/menyatsudoi/menu/1\n激辛旨ラーメン(赤)\nhttps://foodplace.jp/menyatsudoi/menu/2\n地獄(金色)\nhttps://pbs.twimg.com/media/G23eUhEbkAAI0K-?format=jpg\n\n・衣装　ピンク色芋ジャージでお願いします！ミニ兜カチューシャは無くてもOKです(https://x.com/official_kanae/status/1772096316187054446?s=20)\n\n・その他細かな表現はお任せ致します。\n\n私はいつでも大丈夫です。\nイベント明けでようやくほっとできるタイミングにめちゃくちゃな依頼で大変恐縮ではありますが、御縁がございましたら宜しくお願い致します。\n\nhttps://x.com/porcinitake/status/1942225923543306326", "nc": 136, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@namekotake/works/9", "private_thumbnail_image_urls