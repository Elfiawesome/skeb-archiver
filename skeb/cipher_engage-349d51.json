ds/origins/8121fd14-e51e-42f2-b23d-e536cf70faf4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=7a8a3753734450345706c84df32a2486 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/166480fd/uploads/origins/8121fd14-e51e-42f2-b23d-e536cf70faf4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=462b82c41ff2025d95330463393ba0fa", "srcset": "https://si.imgix.net/166480fd/uploads/origins/8121fd14-e51e-42f2-b23d-e536cf70faf4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=462b82c41ff2025d95330463393ba0fa, https://si.imgix.net/166480fd/uploads/origins/8121fd14-e51e-42f2-b23d-e536cf70faf4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=0dd3de18377ae5353eb02b7fa453132b 2x, https://si.imgix.net/166480fd/uploads/origins/8121fd14-e51e-42f2-b23d-e536cf70faf4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=62b98da6ec76bdc82d67573841a332ef 3x"}, "body": "こんにちは。\nアズールレーンの三笠のイラストをお願いします。\n\nこちらを見て微笑んでいて、衣装は水着でお願いします。\n水着のデザインはアズレンの高雄や艦これの狭霧の水着みたいな感じのワンピース型水着をイメージして描いていただければ幸いです。\n(色や柄などの細かなデザインはお任せします)\n\nそれ以外の構図や背景などは完全にお任せします。\nお願いいたします。", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@cipher_engage/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1798500, "client_id": 2973358, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/eafedefe/uploads/origins/cf7bc990-0714-429d-949f-ca1e470857db?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1129504efcab817f0a805c8995a35f35", "srcset": "https://si.imgix.net/eafedefe/uploads/origins/cf7bc990-0714-429d-949f-ca1e470857db?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1129504efcab817f0a805c8995a35f35, https://si.im