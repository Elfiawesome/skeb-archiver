服装はオーバーシルエットのラフな感じでお任せします。構図は正面からあぐらをかいて座っているもので、シャチのぬいぐるみを腕で抱えているポーズでお願いします。できれば右手でシャチのヒレを少し握っていると嬉しいです！顔周りは頭を少し傾けて微笑む表情で描いて頂きたいです。背景は可能でしたら宇宙モチーフでシンプルなデザインをお願いします。その他の点についてはさの様にお任せ致します。\n\n人物は全身が見えるように描いて頂けると嬉しいです。また、キャラクターと背景をそれぞれレイヤー分けしたものを頂きたいです。\n\n最後まで読んで頂きありがとうございます。\nお忙しいと思いますが、何卒よろしくお願い致します！\n\n参考画像\nhttps://drive.google.com/drive/folders/1NVRln-RY6_zbjnBbsjE58P0uGtYp5hxu", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@yunsuke31/works/15", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2482456, "client_id": 3114199, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/a79f10ec/uploads/origins/b5b71cd0-edb3-4f14-ad42-404588fefb3a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=79478c0a30c1afd0095d6bc8df3e6ad1", "srcset": "https://si.imgix.net/a79f10ec/uploads/origins/b5b71cd0-edb3-4f14-ad42-404588fefb3a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=79478c0a30c1afd0095d6bc8df3e6ad1, https://si.imgix.net/a79f10ec/uploads/origins/b5b71cd0-edb3-4f14-ad42-404588fefb3a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=0df161bc1a7ae825a8843517cd51a9d4 2x, https://si.imgix.net/a79f10ec/uploads/origins/b5b71cd0-edb3-4f14-ad42-404588fefb3a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f3fde438b34dd22e652b394bd30e9258 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/a79f10ec/uploads/origins/b5b71cd0-edb3-4f14-ad42-404588fefb3a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9df3a05ddd8196c3bdf7db16ff76a880", "srcset": "https://si.imgix.net/a79f10ec/uploads/origins/b5b71cd0-edb3-4f14-ad42-404588fefb3a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9df3a05ddd8196c3bdf7db16ff76a880, https://si