ルだけど、すこしふわふわしてて不思議な雰囲気のある男性。\n・目\n狐目\n瞳の色は東雲色 #f4ac92 \n・髪型\nくせっけマッシュ\n色はブルーグレージュ\n・服装\nグレーか黒の大きめのシャツ\nうえからパーカーもしくは和装(色はおまかせ)を羽織っててもいいかもです。違和感あればなしでも可\n他はお任せします\n・表情\nクール系\n・ポーズ\nおすわり男子\n体の向きは横が斜めでこっちを向いている\n・動物\n狐\n・背景\n青寄りのグレー 又は グレー\n\n参考、特に好きなイラスト(Twitterのタイトルより)\nこんっ\n目が合う瞬間\nおいしいパンダボールはいかが？\nぱんだぼーい\nしゃーく。", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@yunsuke31/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2482456, "client_id": 2534528, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/3fe6f027/uploads/origins/cc58d73f-7d04-40dd-af29-fe7f04ec45bb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=995ced8287ff6b01897d31b649817a1e", "srcset": "https://si.imgix.net/3fe6f027/uploads/origins/cc58d73f-7d04-40dd-af29-fe7f04ec45bb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=995ced8287ff6b01897d31b649817a1e, https://si.imgix.net/3fe6f027/uploads/origins/cc58d73f-7d04-40dd-af29-fe7f04ec45bb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=0ffee2759a910888b3cace8e3364f854 2x, https://si.imgix.net/3fe6f027/uploads/origins/cc58d73f-7d04-40dd-af29-fe7f04ec45bb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=cd95ccf3ae66162722af3452a3ee906c 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/3fe6f027/uploads/origins/cc58d73f-7d04-40dd-af29-fe7f04ec45bb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6bcccaa50ab73104172b9432f1c7420d", "srcset": "https://si.imgix.net/3fe6f027/uploads/origins/cc58d73f-7d04-40dd-af29-fe7f04ec45bb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6bcccaa50ab73104172b9432f1c7420d, https://si.imgix.net/3fe6f027/uploads/origins/cc58d73f-7d04-40dd-af29-fe7f04ec45bb?