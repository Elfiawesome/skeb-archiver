0&h=200&s=ebd6b342101e77b77a094fbe13c090f2", "srcset": "https://si.imgix.net/4014ee66/uploads/origins/6dd84e58-33bd-4a54-b147-fed6a69d2f94?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ebd6b342101e77b77a094fbe13c090f2, https://si.imgix.net/4014ee66/uploads/origins/6dd84e58-33bd-4a54-b147-fed6a69d2f94?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=000cba743602af4ce7e94ae8f0b85271 2x, https://si.imgix.net/4014ee66/uploads/origins/6dd84e58-33bd-4a54-b147-fed6a69d2f94?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=1df0d238d3c68bc1079005f2e190eb84 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/4014ee66/uploads/origins/6dd84e58-33bd-4a54-b147-fed6a69d2f94?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a76faa54629da846be2504ffc2625d6d", "srcset": "https://si.imgix.net/4014ee66/uploads/origins/6dd84e58-33bd-4a54-b147-fed6a69d2f94?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a76faa54629da846be2504ffc2625d6d, https://si.imgix.net/4014ee66/uploads/origins/6dd84e58-33bd-4a54-b147-fed6a69d2f94?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=aa2bdf8572a4b187f221061cf55e542e 2x, https://si.imgix.net/4014ee66/uploads/origins/6dd84e58-33bd-4a54-b147-fed6a69d2f94?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=5e857b32dcd55421a1b83f4e6ab3b5fa 3x"}, "body": "八館ななこさんこんにちは、お忙しいところ失礼いたします。\n\nいつも八館ななこさんの素敵な作品を拝見しております。華やかで繊細な画風に一目惚れしました。特に額縁のデザインが魅力的で大好きなのです。こちらの依頼も、もし可能でしたら、そんな雰囲気で描いていただけたら嬉しいです。\n\n今回依頼したい内容はこちらのオリジナルキャラクターです。\n凛々しく気高い雰囲気のある少年、そして女神様みたいな美貌が持つキャラなので、神々しい美しさを表現していただけたら嬉しいです。\n衣装に関してはほとんど柄のないスタイルですが、八館ななこさんがデザインした柄を描いていただけたら嬉しいです。\n\n衣装は八館ななこさんのオリジナルデザインをいただけたら幸いです！髪形のアレンジもありです。\nキャラクターのイラストや写真を何枚添付ていますので、スタイルの雰囲気の参考になれると思います。既存な衣装はほとんど柄のないスタイルですが、八館ななこさんがデザインした柄を描いていただけたら嬉しいです。詳細な資料や参考画像は、URLに添付しておりますので、ご確認いただけますと幸いです。\n\nまた、依頼して頂いたイラストは将来、個人趣味のイベントでお披露目する可能性があります。友人間の同好会なので、商業利用や営利目的では一切使用いたしません。展示する際には必ずクレジット表記を添えます。\n\nまたよろしくお願いします。\n\nhttps://drive.google.com/drive/folders/1WXJN7SPh6JYvAcWzS5Md3AIjnxE4h-u5?usp=sharing", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@yashiro_nanaco/works/11", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 915103, "client_id": 959595, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/6573fd6b/uploads/origins/d8bb064e-09ab-4d5e-952c-8a579d8bc23f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6cd9a39a64dd8b502646311ee45fda75", "srcset": "https://si.imgix.net/6573fd6b/uploads/origins/d8bb064e-09ab-4d5e-952c-8a579d8bc23f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6cd9a39a64dd8b502646311ee45fda75, https://si.imgix.net/6573fd6b/uploads/origins/d8bb064e-09ab-4d5e-952c-8a579d8bc23f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=57aabcf052a8394dd3f7d1b69add4438 2x, https://si.imgix.net/6573fd6b/uploads/origins/d8bb064e-09ab-4d5e-952c-8a579d8bc23f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=9b08964b8752a6227afe54dc740e2bff 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/6573fd6b/uploads/origins/d8bb064e-09ab-4d5e-952c-8a579d8bc23f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6866e7f43ebf878c043cd55fb364f5dc", "srcset": "https://si.imgix.net/6573fd6b/uploads/origins/d8bb064e-09ab-4d5e-952c-8a579d8bc23f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6866e7f43ebf878c043cd55fb364f5dc, https://si.imgix.net/6573fd6b/uploads/origins/d8bb064e-09ab-4d5e-952c-8a579d8bc23f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=7a5583084bb22fae9834e31394a105b2 2x, https://si.imgix.net/6573fd6b/uploads/origins/d8bb064e-09ab-4d5e-952c-8a579d8bc23f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=8b0c0a526d1748cc9e346831c2784cd3 3x"}, "body": "初めまして、海外からのnanaco先生のファンです。コミッションイラストの依頼を申し込みたい。\n\nギリシア神話の「パリスの審判」のシーンを先生のスタイルにお願いしたい。特に気に入っているところはパリスがアプロディーテーに黄金のリンゴを捧げるテーマです。\n\n参考画像としてクラシカルの美術品を込めていましたが、イラストの指導を先生に任せたいのです。リクエストにご配慮をいただいてありがとうございます！\n\nhttps://drive.google.com/drive/folders/10Row0_r3kBg5ygnQBNtcX8L87QVPWoo6?usp=sharing", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@yashiro_nanaco/works/10", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 915103, "client_id": 1445988, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/30fd04f3/uploads/origins/e592f658-6cc7-4582-ace6-1c9cac6d1514?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5c20c74a552c94b507a07593da555562", "srcset": "https://si.imgix.net/30fd04f3/uploads/origins/e592f658-6cc7-4582-ace6-1c9cac6d1514?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5c20c74a552c94b507a07593da555562, https://si.imgix.net/30fd04f3/uploads/origins/e592f658-6cc7-4582-ace6-1c9cac6d1514?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=bd9ccd9ed8f8875b2244f54d88ad9183 2x, https://si.imgix.net/30fd04f3/uploads/origins/e592f658-6cc7-4582-ace6-1c9cac6d1514?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=8b472697c6fe132f885e51fb57f077c5 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/30fd04f3/uploads/origins/e592f658-6cc7-4582-ace6-1c9cac6d1514?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3aef35299515deedc947bf31f1a58756", "srcset": "https://si.imgix.net/30fd04f3/uploads/origins/e592f658-6cc7-4582-ace6-1c9cac6d1514?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3aef35299515deedc947bf31f1a58756, https://si.imgix.net/30fd04f3/uploads/origins/e592f658-6cc7-4582-ace6-1c9cac6d1514?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=32569b6c5dccd75ea250d39be8454e57 2x, https://si.imgix.net/30fd04f3/uploads/origins/e592f658-6cc7-4582-ace6-1c9cac6d1514?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=8e87fd2b941287d12c0fa6778a452792 3x"}, "body": "八館ななこ様\n八館さんのイラストが大好きで画集や個展にも行かせていただきました！\nスカーフのイラストがとても好きなので、淡くてキラキラした色味で私のOCを描いていただけたら嬉しいです。ご検討宜しくお願い致します。\n\n\n【OC設定】\n◆絵画の中に閉じ込められた画家のOC\n┗色々な絵の中に入り込める設定です\n┗見た目の資料もお送りします\n┗割烹着のようなエプロンを着ています\n┗キャラの服装は省略していただいたり変更も可です\n┗キャラクターは全身でも全身でなくてもかまいません\n\n【設定資料】\nhttps://drive.google.com/file/d/1DiU9yM-nhv7kkxZGvqW9FTqH_Q77uusu/view?usp=drive_link\n\n【使用用途】\nSNSアイコンやスマホの待ち受け\n\nhttps://drive.google.com/file/d/1DiU9yM-nhv7kkxZGvqW9FTqH_Q77uusu/view?usp=drive_link", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@yashiro_nanaco/works/9", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 915103, "client_id": 3582708, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/b3ad09e9/uploads/origins/3ea44ed4-7964-4df5-b840-0925defdcc91?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6d99999981bd91e32837fa236036b08d", "srcset": "https://si.imgix.net/b3ad09e9/uploads/origins/3ea44ed4-7964-4df5-b840-0925defdcc91?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6d99999981bd91e32837fa236036b08d, https://si.imgix.net/b3ad09e9/uploads/origins/3ea44ed4-7964-4df5-b840-0925defdcc91?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=4f0997cd625815827b68c92a00fdd296 2x, https://si.imgix.net/b3ad09e9/uploads/origins/3ea44ed4-7964-4df5-b840-0925defdcc91?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=5a8117dbe1fdcc63d4d15ec0429ce664 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/b3ad09e9/uploads/origins/3ea44ed4-7964-4df5-b840-0925defdcc91?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=25fac9a3cae3aed60d8c2b43204a0000", "srcset": "https://si.imgix.net/b3ad09e9/uploads/origins/3ea44ed4-7964-4df5-b840-0925defdcc91?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=25fac9a3cae3aed60d8c2b43204a0000, https://si.imgix.net/b3ad09e9/uploads/origins/3ea44ed4-7964-4df5-b840-0925defdcc91?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=77c565ed7635874a9d55b5e7123904db 2x, https://si.imgix.net/b3ad09e9/uploads/origins/3ea44ed4-7964-4df5-b840-0925defdcc91?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=eb4a7d709e615b24388857eda20f8c9d 3x"}, "body": "はじめまして。\n先生の華やかで美しい絵がずっと大好きです...！\n今回は、私のオリジナルキャラクターをリクエストさせていただきます！\n\n参考資料を添付していますが、こちらでも箇条書きで特徴やイメージを記載します。\n構図、服装、表情に指定はないので、自由に描いていただきたいです！（資料の服はチャイナ服のイメージとして着せただけなので、同じような服でも違う服でも自由におまかせします！）\n\n\n〈 全体イメージ 〉\n○  中国\n○  背景に桜を描いてほしいです（その他のモチーフや構図などはおまかせします！）\n\n〈 内面 〉\n○  兄属性（ひとりっ子）\n○  面倒見がよく頼もしい\n○  近所の子どもたちの世話をしたり一緒に遊んでくれる\n○  要領がよくなんでも器用にこなす\n○  誠実で責任感がある\n○  人当たりが良い\n○  家が貧しいため、とにかく稼ぎたい\n○  バイトをいくつも掛け持ちしている\n○  実は踊ることが好きで、技術も高い\n\n〈 外見 〉\n○  18歳くらいの男の子\n○  猫っぽい\n○  やんちゃっぽい\n○  妖艶、美人系の顔立ち（スラッとした大人ではなく、美しい少年という感じ）\n○  身長は低め（165cmくらい）\n○  金髪、肩につくくらいの長さ、全体的に首周りにかけて長くなる、レイヤーが入ってスカッとした感じ、きちっとしてない無頓着なイメージ\n○  短めのつり眉\n○  赤い瞳、鋭いつり目（猫っぽい瞳孔や三白眼など、つり目であれば何でも良いです。細かい部分はおまかせします！）\n○  両側の八重歯\n\n\nかなり長くなってしまいすみません...！\n色々特徴を書きましたが、先生なりのこの子を描いていただけたら嬉しいです！\nよろしくお願いいたします！\n\nhttps://www.dropbox.com/scl/fo/38i6nqht0p7i5ss93qgsd/AL1uMcZazgxkPBFqn1IKlLw?rlkey=lmuekwjzyznbvfhemd4z7o6zi&st=1to04jwf&dl=0", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@yashiro_nanaco/works/8", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 915103, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/36150fd2/uploads/origins/2ba52c31-f5c2-4e66-a3cc-415c3f496e94?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0925c4661879f313a317f26a65a76d65", "srcset": "https://si.imgix.net/36150fd2/uploads/origins/2ba52c31-f5c2-4e66-a3cc-415c3f496e94?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0925c4661879f313a317f26a65a76d65, https://si.imgix.net/36150fd2/uploads/origins/2ba52c31-f5c2-4e66-a3cc-415c3f496e94?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=4a26300c3a326987eb10e83dfd53beb8 2x, https://si.imgix.net/36150fd2/uploads/origins/2ba52c31-f5c2-4e66-a3cc-415c3f496e94?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d6f47e00d80ca0a6f88143559210cf05 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/36150fd2/uploads/origins/2ba52c31-f5c2-4e66-a3cc-415c3f496e94?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ff22efd40b6ba4ab3522f253b062f152", "srcset": "https://si.imgix.net/36150fd2/uploads/origins/2ba52c31-f5c2-4e66-a3cc-415c3f496e94?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ff22efd40b6ba4ab3522f253b062f152, https://si.imgix.net/36150fd2/uploads/origins/2ba52c31-f5c2-4e66-a3cc-415c3f496e94?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=ed0ccce0599f4c91e36a5615deb90ff1 2x, https://si.imgix.net/36150fd2/uploads/origins/2ba52c31-f5c2-4e66-a3cc-415c3f496e94?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=c1a8550a39395e5cd1d3a86403d6423b 3x"}, "body": "こんにちは。八館ななこ先生の絵がとても大好きです。個展で絵を購入しなかったことを悔いています。どうしても先生の絵が欲しいので今回依頼をしました。描いていただけたらキャンバスプリント（A3かA4か250x250mm）にして飾ろうと考えています。\n\n絵の内容ですが、八館ななこ先生のタッチで似顔絵を描いてもらっている人たちが羨ましかったので、私も似顔絵を描いてほしいです。似ているかどうかより先生の世界観で描いていただけるのが一番嬉しいです。先生の世界観、モチーフや描き込みがとても大好きです。5月のポップアップストアが楽しみです。また、これからのご活躍も応援しています:)\n\nhttps://drive.google.com/drive/folders/1oNloX7vEACw_VZuk6XzJcA5DXj9v94I7", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@yashiro_nanaco/works/7", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/9991e36d/uploads/origins/176205d1-8e98-4ac2-80c6-dd43d080e361?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=a07bff2c8a425516b0791e1ab55ff4b2", "srcset": "https://si.imgix.net/9991e36d/uploads/origins/176205d1-8e98-4ac2-80c6-dd43d080e361?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=a07bff2c8a425516b0791e1ab55ff4b2, https://si.imgix.net/9991e36d/uploads/origins/176205d1-8e98-4ac2-80c6-dd43d080e361?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=17a211607185764c60459eeed439b25f 2x, https://si.imgix.net/9991e36d/uploads/origins/176205d1-8e98-4ac2-80c6-dd43d080e361?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=122b87462728875c7f72c4fa7f4a6c59 3x"}, "private": true, "genre": "art", "tipped": false, "creator_id": 915103, "client_id": 243772, "nc": 144}, {"path": "/@yashiro_nanaco/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 915103, 