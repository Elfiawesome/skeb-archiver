\nレクリネ要素のある絵を１枚描いていただきたいです。\n\nどのようなシチュエーションなのかはすヘもろさんにお任せします。\nリネアの服装のみ初期のデフォコスにしていただければと思います。\n\n好きなレクリネ絵を資料として以下に貼らせていただきます。\n\nhttps://skeb.jp/@ymm_momaya/works/3\n\nhttps://www.pixiv.net/artworks/65655014\n\nhttps://colopl.co.jp/shironekoproject/calendar/2018/img/wp/wp_sp_0910_1125_2436.jpg\n\nhttps://auctions.c.yimg.jp/images.auctions.yahoo.co.jp/image/dr000/auc0408/users/464ad3d429846f740c9c5b4e0ccfd5fe25792b34/i-img1200x1200-1691407409xrybaj2377711.jpg\n\nすへもろさんの白猫絵が素晴らしく、もしよければ推しの絵を描いていただければ嬉しいです。\n良かったらよろしくお願いいたします。\n\nhttps://colopl.co.jp/shironekoproject/specials/wallpaper/wp/chara201701/wp01_640a.jpg", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@suhemo6/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 95822, "client_id": 54482, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/bda22485/uploads/origins/da662de2-bc74-4a58-a03d-d2bac2d1aab3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=071b018662001bed65dd895a534c09ad", "srcset": "https://si.imgix.net/bda22485/uploads/origins/da662de2-bc74-4a58-a03d-d2bac2d1aab3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=071b018662001bed65dd895a534c09ad, https://si.imgix.net/bda22485/uploads/origins/da662de2-bc74-4a58-a03d-d2bac2d1aab3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=58132c5e2cd90fbc1dee3c46dcca59ef 2x, https://si.imgix.net/bda22485/uploads/origins/da662de2-bc74-4a58-a03d-d2bac2d1aab3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=4d0026597d23bc45093c022de801a84c 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/bda22485/uploads/origins/da662de2-bc74-4a58-a03d-d2bac2d1aab3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=cbb0d0b5e514559f11aec87c7e2