願いできないでしょうか！\n・お手間じゃなければミクカラー差分をいただけないでしょうか？\n・サムネなどに使えるよう背景と人物を分けたデータファイルをいただきたいです！\n\nふわふわした依頼で申し訳ありません！どうぞよろしくお願いします！\n\nhttps://lit.link/sakumaspica", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@kanimiso_uni_/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3243198, "client_id": 3167494, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/d6d18a27/uploads/origins/19759a93-1e9c-4795-9d63-553742d3fb46?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8b4985717451c06cda2d4f4cd8538ba1", "srcset": "https://si.imgix.net/d6d18a27/uploads/origins/19759a93-1e9c-4795-9d63-553742d3fb46?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8b4985717451c06cda2d4f4cd8538ba1, https://si.imgix.net/d6d18a27/uploads/origins/19759a93-1e9c-4795-9d63-553742d3fb46?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=6088ecc8d57fc5e013d3773e44c09c8b 2x, https://si.imgix.net/d6d18a27/uploads/origins/19759a93-1e9c-4795-9d63-553742d3fb46?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=55dd23a5948fc25222dec2428af14d9d 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/d6d18a27/uploads/origins/19759a93-1e9c-4795-9d63-553742d3fb46?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=731ecce6fa0663535ae022ba51044d43", "srcset": "https://si.imgix.net/d6d18a27/uploads/origins/19759a93-1e9c-4795-9d63-553742d3fb46?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=731ecce6fa0663535ae022ba51044d43, https://si.imgix.net/d6d18a27/uploads/origins/19759a93-1e9c-4795-9d63-553742d3fb46?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=f08ca1f4c847bd6cde99d632f249c072 2x, https://si.imgix.net/d6d18a27/