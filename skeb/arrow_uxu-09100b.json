/uploads/origins/2ab9f451-c908-4db8-ba1b-5cb6e0e1fda0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=7f3fcb81f329ac3e18c1a767c3d4fbe0 2x, https://si.imgix.net/cb6397d0/uploads/origins/2ab9f451-c908-4db8-ba1b-5cb6e0e1fda0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d8f4d0ecc82fd9cdf069d67b2a3bdf7a 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/cb6397d0/uploads/origins/2ab9f451-c908-4db8-ba1b-5cb6e0e1fda0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c3f63f3bea471d483d029d6e3bde24ed", "srcset": "https://si.imgix.net/cb6397d0/uploads/origins/2ab9f451-c908-4db8-ba1b-5cb6e0e1fda0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c3f63f3bea471d483d029d6e3bde24ed, https://si.imgix.net/cb6397d0/uploads/origins/2ab9f451-c908-4db8-ba1b-5cb6e0e1fda0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=cbd815913136abd3c43fd1a3282967ec 2x, https://si.imgix.net/cb6397d0/uploads/origins/2ab9f451-c908-4db8-ba1b-5cb6e0e1fda0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=b3988f78aae68d8d40c0e753098bb046 3x"}, "body": "初めまして、Antaresと申します。\nアロウ様の絵柄が好きでした、動きの表現やデザインもとても印象的です！キャラ雰囲気がすごくいいと思います好きです！\nもし宜しければ、私のオリキャラの一キャラの【二つ立ち絵のデザイン】をお願いしたい。\n主に自分楽しみのUTAU音源用の立ち絵として使用する予定です。音源は「弱」と「強」の二種を想定しており、同一キャラクターで個性異なる二枚の立ち絵とデザインをお願いできれば幸いです。\n\n\n【ステージ】\n基本的には西洋魔法-廃土背景。\n災害により、世界は砂の海と化した。砂の海上に建てられた幾つもの時計盤のような母船に人間が住んでいます。人は機械的な装置を使って、魔法と言う技術を使う。\n魔法の中央AIシステムは曰く:ホスト。ホストはとある人間救世主会社の管理下、人類の進歩のため絶対的な忠実さをもって職務を仕える。\n\n【キャラ】\n①神学者\n目立たないドジ学者。ホストのデザイナーの一人人間。神秘的で知的な雰囲気が、ありふれた印象もあるキャラ。\nそばかす＆瓶底眼鏡をかけている。顔が見えなくても大丈夫です。Seal of Solomonは印象的な飾りです。\n\n②砂海の海賊\n海賊。ホストへの狂信者、人類大嫌いいつもイライラする魔法創造物(機械創造物・アンドロイド)。やや人を見下して挑発するような態度。\nそばかす＆黒金オッドアイ。出来れば、海賊船長風の三角帽のようなものをかぶっている姿を見たいです。少し懐中時計の要素も参考になるかもしれません。\n\n【その他】\nhttps://drive.google.com/drive/folders/1Dzh2WrwNEmJFlovnQHQdIFcu_aiq8jbr?usp=sharing\n青少年想定な体格。\nアロウ様の手癖よる自由にデザイン調整して改めてアレンジを頼みます。実に才思が尽きてしまったなのでお願い致しますOTL。\n\n二枚立ち絵がレイヤー分けのファイルで納品いただければ幸いです。\n◆私のオリキャラが歌うためのUTAU音源の立ち絵として使用したいなので、試聴もDriveに付けました。\n音源関連の使用例えば動画やSNSで、そして音源との連携公開はあると思う。\n商用利用ではございません。◆\n\nリクエストを読んでくださって、誠にありがとうございました！\nご検討宜しくお願い致します＞＜\n\nhttps://drive.google.com/drive/folders/1Dzh2WrwNEmJFlovnQHQdIFcu_aiq8jbr", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@arrow_uxu/works/8", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/740af743/uploads/origins/af8c0037-0275-41e0-9e29-21284851c78f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=026171618d3e12e2e7f146344f60c066", "srcset": "https://si.imgix.net/740af743/uploads/origins/af8c0037-0275-41e0-9e29-21284851c78f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=026171618d3e12e2e7f146344f60c066, https://si.imgix.net/740af743/uploads/origins/af8c0037-0275-41e0-9e29-21284851c78f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=5f4922388733a50290861d164a1c471c 2x, https://si.imgix.net/740af743/uploads/origins/af8c0037-0275-41e0-9e29-21284851c78f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=62147cbd7022bfc4030334086999e7f4 3x"}, "private": true, "genre": "art", "tipped": true, "creator_id": 3378167, "client_id": 3686302, "nc": 144}, {"path": "/@arrow_uxu/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3378167, "vtt_url": null, "thumbn