のキャラクターの主なデザインインスピレーションは、花「パピバー『アメージング・グレイ』」から得ています。\n\n残りの部分は全てお任せします！この依頼をご検討いただければ、心から感謝いたします。https://drive.google.com/file/d/161JHKvPu_JgMwimjh_DZUNR_-lV7MfPm/view?usp=sharing", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@arrow_uxu/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3378167, "client_id": 3855100, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/f1fa0868/uploads/origins/cf774041-8e44-4ef1-bb02-b806911ffbd9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=dd0e164e34f9f44cf7e38a0c9f2888c4", "srcset": "https://si.imgix.net/f1fa0868/uploads/origins/cf774041-8e44-4ef1-bb02-b806911ffbd9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=dd0e164e34f9f44cf7e38a0c9f2888c4, https://si.imgix.net/f1fa0868/uploads/origins/cf774041-8e44-4ef1-bb02-b806911ffbd9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b62ffa1260463151c2f72ea9dc97441e 2x, https://si.imgix.net/f1fa0868/uploads/origins/cf774041-8e44-4ef1-bb02-b806911ffbd9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=5ff4706acc3ff1403a7981aab3815cf8 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/f1fa0868/uploads/origins/cf774041-8e44-4ef1-bb02-b806911ffbd9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=61b678d0151332fec738a2cfe04dfa27", "srcset": "https://si.imgix.net/f1fa0868/uploads/origins/cf774041-8e44-4ef1-bb02-b806911ffbd9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=61b678d0151332fec738a2cfe04dfa27, https://si.imgix.net/f1fa0868/uploads/origins/cf774041-8e44-4ef1-bb02-b806911ffbd9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=b8259472075f8b2c366d466e01d8cdc1 2x, https://