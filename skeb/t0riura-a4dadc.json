48-ba10-e34bd64b4dd6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=461c2907460f4d949cb09bf7d3776f5f, https://si.imgix.net/d79eb6a3/uploads/origins/f3ebf739-8ea0-4548-ba10-e34bd64b4dd6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=05c9dce1b0f0ab855418d0fc80053ca0 2x, https://si.imgix.net/d79eb6a3/uploads/origins/f3ebf739-8ea0-4548-ba10-e34bd64b4dd6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=47a14b458669b4e7976804a02c2f3d5e 3x"}, "body": "とりうらママお世話になっております！とりうらママの娘の小波ながれです！\n\nリクエスト再開とっても嬉しいです🥹🩵\n\n◎依頼内容\n・とりうらママの好きなように小波を描いていただきたいです！\n・人魚の姿の小波だと嬉しいです。\n・表情、ポーズ、構図等はとりうらママにお任せします。\n・可能であれば表情差分等つけていただけると活動で使いやすく助かります……！(金額的に難しいようであれば大丈夫です)\n\n◎使用用途\n・SNS上の宣伝画像、アイコン\n・収益化済みYouTubeチャンネルの動画、配信サムネイル\n・金銭的利益の発生しないネットプリント等での使用\n・リスナー向けに配布するデジタルコンテンツ(壁紙やヘッダー等)での使用\n\n◎形式\n可能であれば\n・人物単体の透過PNGもしくは人物とそれ以外を分けたPSDデータ\n・頭の先や左右どちらかの横髪が見切れていない状態\n・サムネイルに使用する際、胸上をアップにすることが多いため大きめサイズ で納品いただけますと幸いです。\n\nご検討のほどよろしくお願いいたします🩵\n\nhttps://drive.google.com/drive/folders/1aD9m374ut7ZDSP7BWh0580eiCAxmyz5O", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@t0riura/works/8", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 4018447, "client_id": 3052713, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/e51b9e6b/uploads/origins/a7da7773-b8d0-4123-8843-a5864ac1b5ce?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a33bb260a2b9c76ba7b094205a15b090", "srcset": "https://si.imgix.net/e51b9e6b/uploads/origins/a7da7773-b8d0-4123-8843-a5864ac1b5ce?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a33bb260a2b9c76ba7b094205a15b090, https://si.imgix.net/e51b9e6b/uploads/origins/a7da7773-b8d0-4123-8843-a5864ac1b5ce?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=eecdb0e1be8c4f9b70b6be26dea4ae03 2x, https://si.imgix.net/e51b9e6b/uploads/origins/a7da7773-b8d0-4123-8843-a5864ac1b5ce?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=8cb000abccadc96cbc4a61719f432105 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/e51b9e6b/uploads/origins/a7da7773-b8d0-4123-8843-a5864ac1b5ce?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f1263403ca2232130512d9b723f5d6b0", "srcset": "https://si.imgix.net/e51b9e6b/uploads/origins/a7da7773-b8d0-4123-8843-a5864ac1b5ce?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f1263403ca2232130512d9b723f5d6b0, https://si.imgix.net/e51b9e6b/uploads/origins/a7da7773-b8d0-4123-8843-a5864ac1b5ce?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=c8bc48c6949c384bd4c551a4e1c456ab 2x, https://si.imgix.net/e51b9e6b/uploads/origins/a7da7773-b8d0-4123-8843-a5864ac1b5ce?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=e8248088835c04edc56517ba09dc1f9c 3x"}, "body": "とりうら 様\n\nリクエスト失礼いたします。\n IRIAMにて活動をしております、白妙うつほと申します。 \nこの度は、とりうら様にぜひイラストを描いていただきたく参りました。\n\n  ・リクエスト内容  \n 立ち絵を基にしたイラストをお願いいたします。\n  白いマスコットを本体、キャラクターを義体として活動しております為、その両方を描写していただけますと幸いです。  \nキャラクターについては男の娘となりますので、胸の描写だけご留意いただけますと幸いです。 \n見た目は中性寄りなので無理に男性として描写していただかなくても問題ございません！ \n構図につきましては、おまかせになってしまいますこと、ご了承ください。\n\n  ・使用用途  \nX(旧Twitter)での公開(透かしやウォーターマークなどAI対策等は施させていただきます。)、  投げ銭機能のある配信でのサムネ利用、  ヘッダーなどのデジダルグッズの作成、  リアルグッズの作成等に使用させていただきます。    \n背景や宛名がある場合は、レイヤーで分けていただく、もしくはPSD形式にしていただけると幸いです。 ご検討の程よろしくお願いいたします。\n\nhttps://drive.google.com/file/d/1xaJ9mmlB1QdzbC1cIpSZdAfG5KOMOnZU/view?usp=drivesdk", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@t0riura/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 4018447, "client_id": 326