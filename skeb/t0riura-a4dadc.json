ubeのサムネイルへの使用、Twitterで活動の際に使用させて頂きたいです。\nまたアイコンなどにも使用予定で、可能であればネップリやグッズ化もしたいので商用利用が可能だと嬉しいです。\n  ■頭の先や髪の毛などは、先端まで切れないように作画頂けますと大変嬉しいです。 何卒、よろしくお願いします！  https://drive.google.com/file/d/1yFUknmaXPr8Drj0diYRwekLJvoN8wOi_/view?usp=drivesdk", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@t0riura/works/10", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 4018447, "client_id": 3690001, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/5364c62c/uploads/origins/8c2459f5-f998-40bb-8957-23754bff5d15?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=aa6a5aef28ba9b1513d303b9b1176116", "srcset": "https://si.imgix.net/5364c62c/uploads/origins/8c2459f5-f998-40bb-8957-23754bff5d15?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=aa6a5aef28ba9b1513d303b9b1176116, https://si.imgix.net/5364c62c/uploads/origins/8c2459f5-f998-40bb-8957-23754bff5d15?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=638bd58183a6b80ffcbe67c6aeea1ffb 2x, https://si.imgix.net/5364c62c/uploads/origins/8c2459f5-f998-40bb-8957-23754bff5d15?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=1784eb6444535baa4049ca56cfc53ab1 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/5364c62c/uploads/origins/8c2459f5-f998-40bb-8957-23754bff5d15?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9ab0bd1087a45d9951ccc66b5db17970", "srcset": "https://si.imgix.net/5364c62c/uploads/origins/8c2459f5-f998-40bb-8957-23754bff5d15?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9ab0bd1087a45d9951ccc66b5db17970, https://si.imgix.net/5364c62c/uploads/origins/8c2459f5-f998-40bb-8957-23754bff5d15?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200