90d427b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=1b3b2784da9d1cd59a9f3f0869e55f14 3x"}, "body": "うさ先生こんにちは！\nアイコン用のイラストをお願いしたいと思っています。 \nキャラクターは、ご注文はうさぎですか？に登場する風衣葉冬優ちゃんです。 アイコンとして利用したいので、顔を中心に肩より上を描いてもらいたいと思っています。\n衣服と髪型は、2022年度のアトレコラボのイマドキ女子衣装をお願いします。表情などはうささんにお任せします。\n\nhttps://gochiusa.com/bloom/news/n02430000.html", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@huhuhuhu35/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2764133, "client_id": 3267751, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/453791d1/uploads/origins/e134a6c3-ff82-4fb9-b2d6-ae8c99b277f3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e9c040da04eec3d55ee73fe2c9708be0", "srcset": "https://si.imgix.net/453791d1/uploads/origins/e134a6c3-ff82-4fb9-b2d6-ae8c99b277f3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e9c040da04eec3d55ee73fe2c9708be0, https://si.imgix.net/453791d1/uploads/origins/e134a6c3-ff82-4fb9-b2d6-ae8c99b277f3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=4c8568dbd978a9a9e47ee253a79988af 2x, https://si.imgix.net/453791d1/uploads/origins/e134a6c3-ff82-4fb9-b2d6-ae8c99b277f3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=79d12087bd507204880a4c618c1d47d7 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/453791d1/uploads/origins/e134a6c3-ff82-4fb9-b2d6-ae8c99b277f3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=27b73d38e1a793b44ad7b06bb1e453ab", "srcset": "https://si.imgix.net/453791d1/uploads/origins/e134a6c3-ff82-4fb9-b2d6-ae8c99b277f3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=27b73d38e1a793b44ad7b06bb1e453ab, https://si.imgix.net/453791d1/uploads/origins/e134a6c3-ff82-4fb9-b2d6-ae8c99b277f3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=49712d5df92880191a12ea1fa07dfb7d 2x, https://si.imgix.net/453791d1/uploads/origins/e134a6c3-ff82-4fb9-b2d6-ae8c99b277f3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=aa5b4c361c3cd35b2a8190fb5c2339e7 3x"}, "body": "夜分遅くに失礼いたします。ゆっくり実況者のあじさいと申します。Skebでリクエスト募集を開始したことを知り、当チャンネルのオリキャラ「金山イブキ」を描いていただきたいと思いリクエストをいたします。\n\n衣装は夏衣装で、私の現アイコンと同様のタッチで全身描いていただきたいです。脱いだサンダルを手に裸足で立っている姿でお願いします。それ以外のポーズや表情はお任せします。また僭越ながら、胸まわりはバンドリの今井リサと同じような大きめのサイズで描いていただければと思います。\n\nうささんへは初めてのリクエストとなり恐縮ですが、どうかよろしくお願いいたします。", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@huhuhuhu35/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2764133, "client_id": 3235528, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/21c598b7/uploads/origins/8d80a957-623a-45b2-b605-f9a34f6cd4c3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7af1c9fd1d667b7d0ac948d30a3d255a", "srcset": "https://si.imgix.net/21c598b7/uploads/origins/8d80a957-623a-45b2-b605-f9a34f6cd4c3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7af1c9fd1d667b7d0ac948d30a3d255a, https://si.imgix.net/21c598b7/uploads/origins/8d80a957-623a-45b2-b605-f9a34f6cd4c3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=66212b7a8119549057e5cc16ead214e0 2x, https://si.imgix.net/21c598b7/uploads/origins/8d80a957-623a-45b2-b605-f9a34f6cd4c3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=84ba9ceccedf043c4d7bc7d17ad2d45a 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/21c598b7/uploads/origins/8d80a957-623a-45b2-b605-f9a34f6cd4c3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c85e1068d72f2f91d546df78c95c12a2", "srcset": "https://si.imgix.net/21c598b7/uploads/origins/8d80a957-623a-45b2-b605-f9a34f6cd4c3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c85e1068d72f2f91d546df78c95c12a2, https://si.imgix.net/21c598b7/uploads/origins/8d80a957-623a-45b2-b605-f9a34f6cd4c3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=1f1589b5ad194da2a39a845f14bc4e71 2x, https://si.imgix.net/21c598b7/uploads/origins/8d80a957-623a-45b2-b605-f9a34f6cd4c3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=daad17d11fcfe9ae43492ed686320e7a 3x"}, "body": "うささんこんにちは、てちーです！\nいつもすとがーちゃんがお騒がせしております（？）\nさて、うささんのイラストが大好きで、よく見させていただいています。うささんがSkebを始めたらリクエストしたいと思っていたので早速ですがご検討ください。\n\nリクエストは『天体のメソッド』のノエルちゃんです。\n\n作品やキャラクターをご存じかどうかわかりませんので、ノエルちゃんの簡単な性格(？)を紹介しておきます。すごく元気いっぱいで無邪気な女の子で、年齢は明かされていませんが子どもっぽい容姿や言動がまたかわいい子です。天体のメソッドのストーリーは友人同士の関係が多少拗れるため日常系が好きな自分には辛かったのですが、ノエルちゃんがもうとにかくかわいくて癒されておりました。\n\n現在天体のメソッド公式サイトは閉鎖なのか不具合なのかわかりませんが閲覧できない状態です。公式Xは動いていますのでそちらをご覧いただくか、資料URLのノエルちゃんの画像を参考になさってください。\n\n服装は資料のようないつもの服で、元気いっぱいで笑顔ではしゃぐノエルちゃんを描いていただきたいです。具体的な動作などは特に指定しませんので、何かで遊んでいたり、普通にこちらに笑顔を向けてピースしているような構図でも何でもお任せします。\n\n長文失礼いたしました。可能でしたら引き受けてくださると幸いです。よろしくお願いします。\n\nhttps://drive.google.com/drive/folders/1L_hb3fBgNPSRQJ7uekVEsRiGNcq_ok1_?usp=sharing", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@huhuhuhu35/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2764133, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/53d9b37c/uploads/origins/e0848ef0-00b9-4406-aca2-a2a703d0bdd6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=83b78d549dac6861353a12800735ee72", "srcset": "https://si.imgix.net/53d9b37c/uploads/origins/e0848ef0-00b9-4406-aca2-a2a703d0bdd6?bg=%23fff&auto=format%2