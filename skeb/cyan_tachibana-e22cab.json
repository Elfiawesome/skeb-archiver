うに描いていただければ…！)\n\n完成したイラストはSNSのアイコンにさせて頂きたいと思っています。アイコン使用へのキャンバスサイズの配慮はなさらくて大丈夫です！\n\n※依頼のイラストですが、以前しあん茶🍵さんがTwitterに上げていらした乱光包ちゃんのイラストを加筆していただく形でも構いません…！\n\n色々と注文をつけ加えてしまい申し訳ありません。もし宜しければよろしくお願いします。", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 104095, "creator": true, "nsfw_acceptable": true, "acceptable": false, "name": "チワワの浩太＠うさむぎいぬもぐ", "screen_name": "geraurgos", "avatar_url": "https://pbs.twimg.com/profile_images/1863885470931042304/OYYqkEB4.jpg", "header_url": "https://pbs.twimg.com/profile_banners/3274715192/1728919532/1500x500", "appeal_receivable": true, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "art"}], "nc": 32}, {"id": 438527, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "すな吉🦊🍓", "screen_name": "satoss", "avatar_url": "https://pbs.twimg.com/profile_images/1820070236592431104/JuZm-0sx.jpg", "header_url": "https://pbs.twimg.com/profile_banners/19526053/1667141438/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 14, "complete_expiration_days": 30, "skills": [{"genre": "art"}, {"genre": "comic"}, {"genre": "video"}], "nc": 49}, {"id": 1035715, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "げりぎみん@skeb", "screen_name": "gerigimi18", "avatar_url": "https://pbs.twimg.com/profile_images/1405147459173568522/Aeb0YJyH.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1252935656239624192/1730960850/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_da