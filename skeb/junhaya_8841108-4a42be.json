sd等をある程度レイヤーが分かれた状態でいただけると助かりますが、無理そうであれば無くても問題ありません。\n\n注文が多くて申し訳ありませんが、検討よろしくお願いします。\n\nhttps://drive.google.com/drive/folders/1nlTaUnZQmjR3cxYkIis-b6M3sWio7oAM", "nc": 48, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@junhaya_8841108/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 912792, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/07768f2c/uploads/origins/231eea27-bed5-47ac-a865-bdcb609bdf78?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c7d97eb3fa64e254b8d8d9a17e875183", "srcset": "https://si.imgix.net/07768f2c/uploads/origins/231eea27-bed5-47ac-a865-bdcb609bdf78?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c7d97eb3fa64e254b8d8d9a17e875183, https://si.imgix.net/07768f2c/uploads/origins/231eea27-bed5-47ac-a865-bdcb609bdf78?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=11c462ae3f9cb659bc832482cad40a36 2x, https://si.imgix.net/07768f2c/uploads/origins/231eea27-bed5-47ac-a865-bdcb609bdf78?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=6a240facb2302708767b764177bb060a 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/07768f2c/uploads/origins/231eea27-bed5-47ac-a865-bdcb609bdf78?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9a371bd0caf3483b395da8f523dbdb29", "srcset": "https://si.imgix.net/07768f2c/uploads/origins/231eea27-bed5-47ac-a865-bdcb609bdf78?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9a371bd0caf3483b395da8f523dbdb29, https://si.imgix.net/07768f2c/uploads/origins/231eea27-bed5-47ac-a865-bdcb609bdf78?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=0f25b266c99bd124b268c714382f8270 2x, https://si.imgix.net/07768f2c/uploads/origin