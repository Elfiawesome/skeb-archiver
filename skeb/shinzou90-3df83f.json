す。\n(バイオニック・レディーの様な「メカバレ」の感じがカラダのどこかしらにある感じです。)\n特殊部隊所属か「組織」の戦闘用サイボーグといった趣です。\n\nまた、体にケーブルやチューブなどが接続されて、機械化されたカラダの調整をされている感じもほしいです。\n\nその他、カラーリング、構図などはおまかせします。かなりマニアックな内容になりますが、よろしくご検討ください。", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@shinzou90/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1114411, "client_id": 206892, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/98797fad/uploads/origins/99ea9c6f-3ff3-4b66-8cc8-be1eb6dfe577?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5e5b3ea006a624bb36a397e58351cffc", "srcset": "https://si.imgix.net/98797fad/uploads/origins/99ea9c6f-3ff3-4b66-8cc8-be1eb6dfe577?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5e5b3ea006a624bb36a397e58351cffc, https://si.imgix.net/98797fad/uploads/origins/99ea9c6f-3ff3-4b66-8cc8-be1eb6dfe577?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=cefa4bf8ad5295f6ead956aecaa3e83e 2x, https://si.imgix.net/98797fad/uploads/origins/99ea9c6f-3ff3-4b66-8cc8-be1eb6dfe577?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=2fc17fbe213a389d6eec09a045ae4226 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/98797fad/uploads/origins/99ea9c6f-3ff3-4b66-8cc8-be1eb6dfe577?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=97c17a90ef9b114042e8cdd9deb11272", "srcset": "https://si.imgix.net/98797fad/uploads/origins/99ea9c6f-3ff3-4b66-8cc8-be1eb6dfe577?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=97c17a90ef9b114042e8cdd9deb11272, https://si.imgix.net/98797fad/uploads/origins/99ea9c6f-3ff3-4b66-8cc8-be1eb6dfe577?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=c1575dcec2161756f9b3f903c8aaaa49 2x, h