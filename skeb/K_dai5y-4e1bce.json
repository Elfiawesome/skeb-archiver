6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c4e98b47693d6fc8d17c285edbd7dbb0", "srcset": "https://si.imgix.net/d55714cb/uploads/origins/7e78f857-ea4d-4db7-bf97-09fecbb96546?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c4e98b47693d6fc8d17c285edbd7dbb0, https://si.imgix.net/d55714cb/uploads/origins/7e78f857-ea4d-4db7-bf97-09fecbb96546?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=2b7fa13e6fc1955b0a5c40a2ddd16fca 2x, https://si.imgix.net/d55714cb/uploads/origins/7e78f857-ea4d-4db7-bf97-09fecbb96546?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=920aff5697883fe312e0f69f60f70141 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/d55714cb/uploads/origins/7e78f857-ea4d-4db7-bf97-09fecbb96546?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=fd849c03d7af82225a6e99bf6a3edbfb", "srcset": "https://si.imgix.net/d55714cb/uploads/origins/7e78f857-ea4d-4db7-bf97-09fecbb96546?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=fd849c03d7af82225a6e99bf6a3edbfb, https://si.imgix.net/d55714cb/uploads/origins/7e78f857-ea4d-4db7-bf97-09fecbb96546?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=e8df50d80a96d39e550fd00f81a4f844 2x, https://si.imgix.net/d55714cb/uploads/origins/7e78f857-ea4d-4db7-bf97-09fecbb96546?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=431d292230ea6c8e8c67708e1d8391c1 3x"}, "body": "こんにちは、私のキャラクター2人のイラストを描いていただける機会があれば嬉しいです！\n\nキャラクターの詳細\n-ウリエル：彼女は大天使で、最初は真面目で冷たく、感情をほとんど表に出さない。王のおかげで、表情が柔らかくなり、温かみが出てきた。彼女はまだ自分の感情を完全に理解するのに苦労しているが、かつての冷たい視線は今では温かさと優しさに満ちている。彼女が人間への愛と絆をより強く持てるようになったのは、王のおかげなのだ。\n\n-国王： 親切で穏やかな性格で、しばしば人類の模範と呼ばれる。英雄に選ばれなかったにもかかわらず、彼は自分の大切な人たちを守るためにわざわざ出かけていった。彼は自分を愛したことがないにもかかわらず、世界を愛し続けた。今ウリエルの前に立っているのは、彼女が深く愛し、大切にしている人ではない。\n\nリクエストの詳細目を閉じたウリエルに向かって、王が丁寧に挨拶し微笑む構図を希望します。それとは対照的に、王は優しく、ほとんど慈愛に満ちたしぐさをしているにもかかわらず、ウリエルは恐怖や恐れの表情を浮かべている。彼女は、目の前に立っている王が昔会った人ではないことを誰よりもよく知っている。彼女の前に立っているのが誰であれ、何であれ、彼女が最も大切にしていた人になりすますことで、ほとんど彼女をあざ笑っているのだ。このような特徴をひとつでも盛り込んでいただけるとありがたい：\n-王の片目の強膜を黒くする（白目の部分を真っ黒にする）。\nまたは\n-片方の目のアイリスの色を不気味な金色に変える。\n\nご検討のほど、よろしくお願いいたします！\n\nhttps://drive.google.com/drive/folders/1i8vUX4Zbe-q0MgdVwSpvxws5ObL1WI36?usp=sharing\nhttps://drive.google.com/drive/folders/1OUEPhK2WJ-urei8j2xCywzD1131XlgUk?usp=sharing", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@K_dai5y/works/11", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/d8fa5adb/uploads/outputs/08503aa5-d7c1-4df0-8ac4-256244e9c684?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=aac8bde4e8605b0e66d9f50633b05807", "srcset": "https://si.imgix.net/d8fa5adb/uploads/outputs/08503aa5-d7c1-4df0-8ac4-256244e9c684?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=aac8bde4e8605b0e66d9f50633b05807, https://si.imgix.net/d8fa5adb/uploads/outputs/08503aa5-d7c1-4df0-8ac4-256244e9c684?bg=%23fff&fm=webp&auto=compress&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=aa6c0bc89381eb44795c8f298062d1fc 2x, https://si.imgix.net/d8fa5adb/uploads/outputs/08503aa5-d7c1-4df0-8ac4-256244e9c684?bg=%23fff&fm=webp&auto=compress&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=4bea94c09310bdfe8fa8a2b04098be77 3x"}, "private": true, "genre": "video", "tipped": false, "creator_id": 3023232, "nc": 128}, {"path": "/@K_dai5y/works/10", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": fal