f&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b3623463959274f4c75abaedcc89fb9a, https://si.imgix.net/7754f5e3/uploads/origins/9c319a99-ad22-484e-a8a3-1e35b6793c7b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=ab9b693137f89d885e85f031d38bb783 2x, https://si.imgix.net/7754f5e3/uploads/origins/9c319a99-ad22-484e-a8a3-1e35b6793c7b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=6ec09474fb295b9fc1ef194c1ba7b246 3x"}, "body": "はじめまして。\nこの度はアピールいただきありがとうございます。\nにかもとひなび様のポートフォリオを拝見しまして、柔らかく優しい絵柄に惹かれました。\n是非うちの子を描いて頂きたくリクエストさせていただきます。\nどうぞよろしくお願いいたします。\n\n◆用途\ntwitter等SNSでの使用\n\n◆三面図・キャラ参考資料\nうちの子の参考資料です。\nhttps://twitter.com/silas_012/status/1624678045637550083?s=20\n\n◆構図・ポージング\n基本的にお任せします。\nアピール文でご記載頂いたように、ピンク髪の同級生の女の子との組み合わせは大歓迎です！\nぜひ自由に描いてください。\n\n◆服装\n制服でもそれ以外でもどちらでもOKです！\n自由に描いてください。\n\n◆納品データ\nPSDとPNGで納品希望です。\n\n以上、\nご検討のほどよろしくお願いいたします。\n\nhttps://twitter.com/silas_012/status/1624678045637550083?s=20", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@nikamotoE/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2678283, "client_id": 1354188, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/73f0f8aa/uploads/origins/3b2fb9d4-2930-4bed-97e6-db52f1a901fd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=badcd865853c211d91c7b1454a0ce7d9", "srcset": "https://si.imgix.net/73f0f8aa/uploads/origins/3b2fb9d4-2930-4bed-97e6-db52f1a901fd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=badcd865853c211d91c7b1454a0ce7d9, https://si.imgix.net/73f0f8aa/uploads/origins/3b2fb9d4-2930-4bed-97e6-db52f1a901fd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=98d603fae2cae6c80db9b9a3f9c6c2a5 2x, https://si.imgix.net/73f0f8aa/uploads/origins/3b2fb9d4-2930-4bed-97e6-db52f1a901fd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=1097f1756f78ba611dc02ecb585bef41 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/73f0f8aa/uploads/origins/3b2fb9d4-2930-4bed-97e6-db52f1a901fd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0f39f77ee2e11e815066312d19b68aee", "srcset": "https://si.imgix.net/73f0f8aa/uploads/origins/3b2fb9d4-2930-4bed-97e6-db52f1a901fd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0f39f77ee2e11e815066312d19b68aee, https://si.imgix.net/73f0f8aa/uploads/origins/3b2fb9d4-2930-4bed-97e6-db52f1a901fd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=566a379266b5e48331183e3f0ccfe251 2x, https://si.imgix.net/73f0f8aa/uploads/origins/3b2fb9d4-2930-4bed-97e6-db52f1a901fd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=06ed0b3495450b78102cc74e18e8e86b 3x"}, "body": "にかもとひなび様\n\n　なしと申します。前回は大変お世話になりました。今回新規アカウントにてゆったりとした価格帯でのご依頼を募集されているとのことで、リクエストを送らせて頂きました。\n\n創作名：桜夏秋冬\n\nキャラ：(①モチーフ②宝物③誕生花)\n・咲良美桜(24歳/160cm)①春の桜②桜のイヤリング③ソメイヨシノ\n・木下秋人(41歳/175cm)①秋の紅葉②ループタイ③金木犀\n\n※美桜と秋人はカップリング。詳細は資料URLをご参照下さい。量が多い為、お手数ですが流し見て下さい。\n\n依頼内容：\n・上記の二人のイラストをお願いしたいです。\n・テイストはサンプルで提示されていた「サンプル３」の様な、二人が仲良く触れ合っているイラストが好ましいです。構図やポーズ、表情等は、にかもと様にお任せ致します。ただ、可能であれば二人の表情が良く見え、二人共幸せそうにしていると嬉しいです。\n・絵柄は、にかもと様が得意とされる温かみのある鉛筆画でお願いしたいです。\n・可能であれば、白背景に少しエフェクトを飛ばす程度等で良いので、ごく簡単な雰囲気背景を添えて頂けると嬉しいです。\n・個人的な嗜好で、可能であれば二人共デフォルトで少し頬を染めて頂きたいです。\n・キャラと分かれば、キャラ色、服装、髪形のアレンジ等はお任せ致します。にかもと様の淡く優しいテイストで、楽しく自由に取り組んで頂けたらと思います。\n・お手間でなければ、にかもと様が描いて感じた二人に対する印象と、描いた際にこだわった点等を記載して頂きたいです。(一言で構いません。創作物として感想が聞きたいという理由です。)\n\n作品用途：\n・自己観賞。また創作で描いて頂いた設定等に触れることがあるかもしれません。　\n・可能であれば当方のブログで、依頼絵を掲載・紹介させて頂きたいと思っております。\n\n飲めない要望は無視して下さって結構です。ご検討頂けますと幸いです。\n\nなし\n\nhttps://www.dropbox.com/sh/4iojf48z58q3wzh/AABC4w1ET3Hfq7izt-VPjoIaa?dl=0", "nc": 1, "word_count": 0, "t