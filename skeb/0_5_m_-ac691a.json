n personal goods (such as ackee or acsta). (I will not sell or distribute any of the goods, but will keep them for myself.)\n\nAlso, if possible, I would like to receive separate portraits and backgrounds. (If this is too difficult, please do not send it to me.)\n\nI know you are busy, but thank you in advance...!\n\nhttps://drive.google.com/file/d/1TJ1LTNDp2bsgo0Ubl6bsPiGEVxpCd2Tv/view?usp=drivesdk", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@sayu_tmg__/works/80", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 751314, "client_id": 1881650, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/68aefbdc/uploads/origins/5f496437-4bdc-4c15-8ca6-18045cd53620?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c8a8a03cfc564a3537026835d0f500f9", "srcset": "https://si.imgix.net/68aefbdc/uploads/origins/5f496437-4bdc-4c15-8ca6-18045cd53620?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c8a8a03cfc564a3537026835d0f500f9, https://si.imgix.net/68aefbdc/uploads/origins/5f496437-4bdc-4c15-8ca6-18045cd53620?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=6b4ceb0ca6c08017a6ea779fab8354c5 2x, https://si.imgix.net/68aefbdc/uploads/origins/5f496437-4bdc-4c15-8ca6-18045cd53620?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=896c57fe8597a0412fef2f91ae4e7b72 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/68aefbdc/uploads/origins/5f496437-4bdc-4c15-8ca6-18045cd53620?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a4792eca68bddba5990602fcf67d3456", "srcset": "https://si.imgix.net/68aefbdc/uploads/origins/5f496437-4bdc-4c15-8ca6-18045cd53620?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a4792eca68bddba5990602fcf6