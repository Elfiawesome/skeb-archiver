https://si.imgix.net/3a1abad1/uploads/origins/b1b79388-79d6-4150-aae3-b1d05cb23211?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b024c95a8ab9bcc417666a660857919f 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/3a1abad1/uploads/origins/b1b79388-79d6-4150-aae3-b1d05cb23211?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a81b3568fc74ad098c1140eb620383d5", "srcset": "https://si.imgix.net/3a1abad1/uploads/origins/b1b79388-79d6-4150-aae3-b1d05cb23211?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a81b3568fc74ad098c1140eb620383d5, https://si.imgix.net/3a1abad1/uploads/origins/b1b79388-79d6-4150-aae3-b1d05cb23211?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=d65dcd128b67e8c83ffe43e638fc8bc1 2x, https://si.imgix.net/3a1abad1/uploads/origins/b1b79388-79d6-4150-aae3-b1d05cb23211?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=94b1e2df6c150862344c784ae8a19c98 3x"}, "body": "Hello! This is 💍 (Diamond Ring) who requested an illustration before! The art you drew for me last time and the time before that was absolutely wonderful—I have it displayed in my room 🥰 This time, I'm sending a request for a different character!\n\nThis time, the character I'd like you to draw is one I created myself! I'd appreciate it if you could refer to the character design in the link below. It doesn't matter which one you choose—please draw whichever one catches your eye. I'll leave the pose and outfit up to you, and please give them a mischievous smile.\n\nI plan to use the artwork as my SNS icon and header, and also to create personal goods like acrylic keychains and stands. (Regarding the goods, I will not sell or distribute them; they will be solely for my personal use.) Also, the white-haired character (not the mermaid) is a character I use for my game streams, so I may also use it for thumbnails and videos. Please keep that in mind as well.\n\nIf possible, I'd also appreciate receiving a version with the character separated from the background. (Feel free to skip this if it's too difficult.) I know you're busy, but I truly appreciate your help. https://drive.google.com/drive/folders/1AH99hUkb1OTYkuQSw4VbmOp9BJgjZW5t", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@llir_re/works/12", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3818677, "client_id": 1881650, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/d65325ea/uploads/origins/7a4f3879-ad67-4fe4-96c7-dbdb9e979e82?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=91c28878f54da37e97d3bec109d9e812", "srcset": "https://si.imgix.net/d65325ea/uploads/origins/7a4f3879-ad67-4fe4-96c7-dbdb9e979e82?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=91c28878f54da37e97d3bec109d9e812, https://si.imgix.net/d65325ea/uploads/origins/7a4f3879-ad67-4fe4-96c7-dbdb9e979e82?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c675643bebe41b9529e5467e49d797f9 2x, https://si.imgix.net/d65325ea/uploads/origins/7a4f3879-ad67-4fe4-96c7-dbdb9e979e82?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=196abc61537be58537c4d6abfbc30baf 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/d65325ea/uploads/origins/7a4f3879-ad67-4fe4-96c7-dbdb9e979e82?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=54b33cf26c71867ba42610216d36a24a", "srcset": "https://si.imgix.net/d65325ea/uploads/origins/7a4f3879-ad67-4fe4-96c7-dbdb9e979e82?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=54b33cf26c71867ba42610216d36a24a, https://si.imgix.net/d65325ea/uploads/origins/7a4f3879-ad67-4fe4-96c7-dbdb9e979e82?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=5fdbedb627c1636c77654e6f1ffd6b38 2x, https://si.imgix.net/d65325ea/uploads/origins/7a4f3879-ad67-4fe4-96c7-dbdb9e979e82?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=1bf5096d1a971a759d00eab87a607789 3x"}, "body": "こんばんは！💍(ダイヤのゆびわ)と申します！\n🧸🍯様のイラストがとても素敵でリクエストを送らせていただきました…！！！\n\nこの度、描いて頂きたいキャラクターは私のオリジナルキャラのアルバちゃんです！\n\nポーズや表情、衣装全ておまかせでお願いします。\n髪型アレンジ、衣装の変更大歓迎です。\nフリルのたくさん付いた服装が好みです。\n\n🧸🍯様の可愛いデフォルメをTwitterでお見かけして勢いでリクエストさせていただきました！\n\n使用目的は個人鑑賞用ですが、SNSのアイコンやヘッダーさせて頂いたり、個人的なグッズ(アクキーやアクスタ等)を制作させて頂く可能性があります。(グッズにつきましては、販売や配布などは一切行わず私自身のみ所有する形となります)\n\nお忙しいとは思いますが、何卒よろしくお願いします…！！！\n\nhttps://drive.google.com/file/d/1oZBPrJC58mTXbGx86GE20wtttWMwf3BG/view?usp=drivesdk", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@sayu_tmg__/works/110", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 751314, "client_id": 1881650, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/590b2fc0/uploads/origins/9f2fbadf-4e59-4382-b00c-a4f7048f2e83?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=683b0ed89b1e9fece57c329285b751ae", "srcset": "https://si.imgix.net/590b2fc0/uploads/origins/9f2fbadf-4e59-4382-b00c-a4f7048f2e83?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=683b0ed89b1e9fece57c329285b751ae, https://si.imgix.net/590b2fc0/uploads/origins/9f2fbadf-4e59-4382-b00c-a4f7048f2e83?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e0afcc635647333ab1aa3a6f8830defc 2x, https://si.imgix.net/590b2fc0/uploads/origins/9f2fbadf-4e59-4382-b00c-a4f7048f2e83?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=eafb25627b1f84405f6568a6f2ee722f 3x"}, "duration": null, "nsfw": false,