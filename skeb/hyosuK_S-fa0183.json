有る差分とかが有ると嬉しい！その他、全てお任せします！\n\n※瞳の色や形に注意して下さい。\n見開いた場合の参考 https://www.dropbox.com/s/oivcgqgmww8kqdv/04.png?dl=0\n※サインやラフ、線画、色等が別のレイヤーになっているPSDを可能であればお願いします。\n\n以上、ヨロシクお願いします！\n\nhttps://www.dropbox.com/sh/wutrpijgh0twmhq/AADnwxxZsN7UGGtt0soY7hLia?dl=0", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [{"path": "/@MIOU_3O/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 316504, "client_id": 316677, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/7659e271/requests/48531_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f85047b347091c594a586fa536618612", "srcset": "https://si.imgix.net/7659e271/requests/48531_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f85047b347091c594a586fa536618612, https://si.imgix.net/7659e271/requests/48531_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=26b6314d7a32ab6dc0d68136f914f955 2x, https://si.imgix.net/7659e271/requests/48531_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=bf9e47dc9274071565486f00520d3a01 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/7659e271/requests/48531_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=00f1137a522775615722419e1ac4fa8d", "srcset": "https://si.imgix.net/7659e271/requests/48531_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=00f1137a522775615722419e1ac4fa8d, https://si.imgix.net/7659e271/requests/48531_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=051cd56ef236a13d3f8e8e19ca579368 2x, https://si.imgix.net/7659e271/requests/48531_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=360e892df21b696cca54a4638fcead70 3x"}, "bo