コウモリ要素（アクセや衣装、小物、その他…どれでも大歓迎です）を、NANASHIさんのチョイスを邪魔しない範囲で、取り入れて頂けると嬉しいです。\n参考資料：（お目汚し失礼致します）\n（https://twitter.com/pokerface_4715/status/1466395369986658309）\n\n\n※資料内の武器要素は、無視して頂いて問題ありません。オシャレに飾って頂けると嬉しいです。\n\n※ある作品の世界観に合わせて考えたキャラ故、便宜上、作中の制服を着せていますが、その他はオリジナルです。", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@74_NA2shi/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 988165, "client_id": 1779662, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/8b8fd349/uploads/origins/894a21fa-e362-4299-a118-200fd6e34fa4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6377797aef74220c4470fd5912184542", "srcset": "https://si.imgix.net/8b8fd349/uploads/origins/894a21fa-e362-4299-a118-200fd6e34fa4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6377797aef74220c4470fd5912184542, https://si.imgix.net/8b8fd349/uploads/origins/894a21fa-e362-4299-a118-200fd6e34fa4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b3454787e18f1abdc3b3d66ace2700d2 2x, https://si.imgix.net/8b8fd349/uploads/origins/894a21fa-e362-4299-a118-200fd6e34fa4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=5a6179ae8a9a209a8c26ef9a90b0f2c6 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/8b8fd349/uploads/origins/894a21fa-e362-4299-a118-200fd6e34fa4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=26a199df682fef088727f6be80ae97aa", "srcset": "https://si.imgix.net/8b8fd349/uploads/origins/894a21fa-e362-4299-a118-200fd6e34fa4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=26a199df682fef088727f6be80ae97aa, https://si.imgix.net/8b8fd349/uploads/origins/894a21fa-e362-4299-a118-200fd6e34fa4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=cr