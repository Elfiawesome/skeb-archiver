a59a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=91bde3b05973207804eab0255f3d3048, https://si.imgix.net/15a3b782/uploads/origins/37d24ac3-ef19-4a23-ac9f-0784ff84a59a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=8340f84df463c9adf7a5e2e157099d25 2x, https://si.imgix.net/15a3b782/uploads/origins/37d24ac3-ef19-4a23-ac9f-0784ff84a59a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=670e6c4c582f233e43a2b5c36a2f9749 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/15a3b782/uploads/origins/37d24ac3-ef19-4a23-ac9f-0784ff84a59a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6a2942542b34b80203bcaa7887e92d8d", "srcset": "https://si.imgix.net/15a3b782/uploads/origins/37d24ac3-ef19-4a23-ac9f-0784ff84a59a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6a2942542b34b80203bcaa7887e92d8d, https://si.imgix.net/15a3b782/uploads/origins/37d24ac3-ef19-4a23-ac9f-0784ff84a59a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=ce5385b8fa709e9db48bb956c1aeb4d5 2x, https://si.imgix.net/15a3b782/uploads/origins/37d24ac3-ef19-4a23-ac9f-0784ff84a59a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=16a3d3e4e763601f3bb1d2f421940340 3x"}, "body": "こんばんは、ぱらしーさんのポップで煌びやかなイラストを手元に置きたくて依頼させて頂きました。\n『カードコネクト』というオリジナルカード印刷に使用するイラストをお願いしたいです。\n\nお願いしたい人物はガガリ Gagally といいます。個人鑑賞が目的なので衣装アレンジや構図はお任せします。\nタトゥーや目付きが悪いせいで一見威圧的ですが、心から好きなものと共にいる時は穏やかに嬉しそうに笑う人なので、そんな表情をイメージして頂けると嬉しいです。\n\nカードコネクトについて\nhttps://p.eagate.573.jp/game/card_connect/1/original/index.htmlhttps://p.eagate.573.jp/game/card_connect/1/original/index.html\n\n何卒宜しくお願いします。\n\nhttps://drive.google.com/drive/folders/1-htKnyqABSSgu9f2Etv5yk2mYw-dXVqI", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@metallightheart/works/43", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3003421, "client_id": 2707942, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/b98ea946/uploads/origins/e139aff2-f9a0-49cc-bd58-8da1198faa59?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=aa0cf76525e6f1927c5a78abdfde3e44", "srcset": "https://si.imgix.net/b98ea946/uploads/origins/e139aff2-f9a0-49cc-bd58-8da1198faa59?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=aa0cf76525e6f1927c5a78abdfde3e44, https://si.imgix.net/b98ea946/uploads/origins/e139aff2-f9a0-49cc-bd58-8da1198faa59?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b3124e4724f254d287f99b0b3ca4f10c 2x, https://si.imgix.net/b98ea946/uploads/origins/e139aff2-f9a0-49cc-bd58-8da1198faa59?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=691e25c65318090e3144ed71a655500b 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/b98ea946/uploads/origins/e139aff2-f9a0-49cc-bd58-8da1198faa59?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2a330fd3f676bc03631e5e3e39d1d10c", "srcset": "https://si.imgix.net/b98ea946/uploads/origins/e139aff2-f9a0-49cc-bd58-8da1198faa59?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2a330fd3f676bc03631e5e3e39d1d10c, https://si.imgix.net/b98ea946/uploads/origins/e139aff2-f9a0-49cc-bd58-8da1198faa59?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=889fe28868b503e5c04a610fb0cbccf4 2x, https://si.imgix.net/b98ea946/uploads/origins/e139aff2-f9a0-49cc-bd58-8da1198faa59?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=b02d01f1ca85d51278513e3a352d4e78 3x"}, "body": "初めまして、チキンライター様のエッジが効いたサイバーで臨場感のあるかっこいいイラストが大好きです。\n宜しければOCをお願いします。\n\nキャラクター設定など\n・全身が機械のひと、肉体生物が滅びてから数千年後の人間\n・身長200cm(この時代の平均身長)、性別の概念無し\n・義体と服の区別が無い、虫みたく全てが機体の一部\n・無表情、生まれつきのエラーによるもの\n・手に目がある\n・DJ中は後頭部のケーブルを下ろして機材に繋ぐ\n\n希望のシチュエーションとしましては、彼がDJをしている場をお願いします。\nDJイベントにしては少し特殊な景色になってしまうかと思いますので、資料に会場の参考を載せてあります。\nこちらの作品のような暗い夜の雰囲気が大好きです！\nhttps://skeb.jp/@metallightheart/works/7\n\nもし金額が足りなければ再送をお願いします。\n何卒宜しくおねがいします。\n\nhttps://drive.google.com/drive/folders/1-ncNF2SD2J1PoJMZqBTpjpdukxR4eW4K", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@eda_log/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3114584, "client_id": 2707942, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/68d23fdd/uploads/origins/93a3a989-b8cb-405b-84f2-efb579b0993c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4e0cffeceb486e4995e0db81eef0e7a7", "srcset": "https://si.imgix.net/68d23fdd/uploads/origins/93a3a989-b8cb-405b-84f2-efb579b0993c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4e0cffeceb486e4995e0db81eef0e7a7, https://si.imgix.net/68d23fdd/uploads/origins/93a3a989-b8cb-405b-84f2-efb579b0993c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=3deaf57c5e52893bc5fe9188e7108628 2x, https://si.imgix.net/68d23fdd/uploads/origins/93a3a989-b8cb-405b-84f2-efb579b0993c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=73fcecef64c5c3c59c3904b5e2451857 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/68d23fdd/uploads/origins/93a3a989-b8cb-405b-84f2-efb579b0993c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a3ea6bd7e21d4f005bbe5199973149cf", "srcset": "https://si.imgix.net/68d23fdd/uploads/origins/93a3a989-b8cb-405b-84f2-efb579b0993c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a3ea6bd7e21d4f005bbe5199973149cf, https://si.imgix.net/68d23fdd/uploads/origins/93a3a989-b8cb-405b-84f2-efb579b0993c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=77e7843e0d1950b8a259551f4207d210 2x, https://si.imgix.net/68d23fdd/uploads/origins/93a3a989-b8cb-405b-84f2-efb579b0993c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=f099020e556e827f291edf94928311d6 3x"}, "body": "初めまして、EDAさんのアートスタイルがずっと大好きです。メリハリがあり鮮やかな色使い、SFと霊的なモチーフの融合、キャラクターの物語を想像させる背景デザインなど、全てにワクワクしながらイラストを拝見しております。 \n今回は音楽と深い関わりを持つサイボーグOCをお願いしたいです。\n \n・身長200cm　DJ兼モデル兼デザイナー \n・眉無し　手の甲に目がある \n・全身が機械　(構造体内部で人類が環境に適応したサイボーグとして生きるしかなくなってから数千年後の人間) \n・機体と服の区別が無い　(合成布も全て機体の一部) \n・表情が全く出ないエラーを抱えているが内面は人間的\n・機械人類に対する脅威が存在するこの世界で仏教に似た独特な死生観・精神世界を持つ\n\nモチーフなど\n・サイケトランス、ダークサイケ、ハイテックなどの音楽\n　メキシコ、ブラジル、モスクワ、日本の曲の影響が強い　\n　参考 https://open.spotify.com/album/0bgXWmGtmTLh9RnQxq3ytE?si=S9fpo2jySSKFAfuGmMIBsw\n・機体色イメージはクジャクガイ、螺鈿\n・Xicalcoliuhqui \n\nhttps://x.com/eda_log/status/1572197858727841794?s=61&t=O9hkKh2R4Oh8hkz2o-jtRA \nhttps://x.com/eda_log/status/1786570883634807021?s=61&t=O9hkKh2R4Oh8hkz2o-jtRA\nこちらのイラストの立ちポーズ(特に靴や脚のライン)や黒の色使いがすごく大好きなので、参考にして頂けますと嬉しいです。\n何故よろしくお願いします！\n\nhttps://drive.google.com/drive/folders/1-dj--g8bOtQSjqFT70ToyY9bdZDdXkjS", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@kyousuke_takagi/works/21", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 362988, "client_id": 2707942, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/e24d9536/uploads/origins/3be91794-b6f6-4631-8df3-c4a313423e85?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d1487f665e2529dd7417eb5dd0284d28", "srcset": "https://si.imgix.net/e24d9536/uploads/origins/3be91794-b6f6-4631-8df3-c4a313423e85?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d1487f665e2529dd7417eb5dd0284d28, https://si.imgix.net/e24d9536/uploads/origins/3be91794-b6f6-4631-8df3-c4a313423e85?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=503f315ced5d08ba3cd101e66ce6d9b6 2x, https://si.imgix.net/e24d9536/uploads/origins/3be91794-b6f6-4631-8df3-c4a313423e85?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f299e1a1e0959ea704ba56d4a246fb4c 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/e24d9536/uploads/origins/3be91794-b6f6-4631-8df3-c4a313423e85?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f1a773549ed6a247a1cda4e3c50309f7", "srcset": "https://si.imgix.net/e24d9536/uploads/origins/3be91794-b6f6-4631-8df3-c4a313423e85?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f1a773549ed6a247a1cda4e3c50309f7, https://si.imgix.net/e24d9536/uploads/origins/3be91794-b6f6-4631-8df3-c4a313423e85?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=38befb8228bf2f9405da08692c4d377e 2x, https://si.imgix.net/e24d9536/uploads/origins/3be91794-b6f6-4631-8df3-c4a313423e85?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=5bd547b8bb15559e99ad42f375808758 3x"}, "body": "高木先生こんにちは！\n今回は衣装デザインの依頼になります。\n今後オリジナルキャラクターとして有償グッズなどで描く予定がある衣装デザインのため、金額が足りないと感じられた場合は再送やキャンセルをしてください。\n\n◆外見設定など\n・性別無し、全身機械、自認は人間\n・髪にあたる部位はフィギュアのような質感、ドリル型\n・ツリ目の四白眼、二重\n・4本指\n◆衣装イメージ\n・ひらひらした普段の姿とは対照的に動きやすい、違った印象の姿\n・どことなくレトロ+SF感\n・彼の人種はみな「機械なので服、機体の一部、肌のどれか分かりにくい」外見を意識しています。服に見えるものは、そういう形に出力した、機体と同じ無機物です。\n　服に見えるけどどう脱ぐか分からない、脱ぐ必要が無いといったイメージをして頂けると嬉しいです。(本当は衣装よりも機体に近いニュアンスかもしれません)\n\nこちらの画像2枚目のように、正面+背面デザインどちらも分かるように描いて頂きたいです。\nhttps://x.com/kyousuke_takagi/status/1757302890161668116?s=46&t=Dj8yy8FQi_1eQE-2apGbDw\n\nイラストとしてのクオリティよりも行き詰まっている外見に関するアイデアを得たい依頼となりますので、以下のような衣装の雰囲気が分かるタッチで構いません。\nhttps://x.com/kyousuke_takagi/status/1776243656590242213?s=46&t=Dj8yy8FQi_1eQE-2apGbDw\nhttps://x.com/kyousuke_takagi/status/1759216633632231686?s=46&t=Dj8yy8FQi_1eQE-2apGbDw\n\n複雑な内容になってしまいましたが、brociManacの皆様のお召し物が大好きなので高木様にデザインして頂けるととても嬉しいです。\n何卒宜しくお願いします！\n\nhttps://drive.google.com/drive/folders/1-eQIlIKZznYUUseFu-tO5thWrJYqqAZD", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@sofw_01/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3019074, "client_id": 2707942, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/48a2a1b0/uploads/origins/464790fd-e2cc-44e1-8f76-699bf19ec5f1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=634626d080eb1e53d3cd72a247fde102", "srcset": "https://si.imgix.net/48a2a1b0/uploads/origins/464790fd-e2cc-44e1-8f76-699bf19ec5f1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=634626d080eb1e53d3cd72a247fde102, https://si.imgix.net/48a2a1b0/uploads/origins/464790fd-e2cc-44e1-8f76-699bf19ec5f1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e105a2f0aa21dc2f931e357035128d55 2x, https://si.imgix.net/48a2a1b0/uploads/origins/464790fd-e2cc-44e1-8f76-699bf19ec5f1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=163bc3e82cc5ee58184931cce45591b1 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/48a2a1b0/uploads/origins/464790fd-e2cc-44e1-8f76-699bf19ec5f1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9061f21e961cf76ee4a38335bae77efe", "srcset": "https://si.imgix.net/48a2a1b0/uploads/origins/464790fd-e2cc-44e1-8f76-699bf19ec5f1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9061f21e961cf76ee4a38335bae77efe, https://si.imgix.net/48a2a1b0/uploads/origins/464790fd-e2cc-44e1-8f76-699bf19ec5f1?bg=%23fff&auto=format%2Ccompre