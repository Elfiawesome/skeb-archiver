fde9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=89abb914f6e2ca24b9453d89bf2a7415, https://si.imgix.net/3a829749/uploads/origins/ba397790-bb8f-48eb-8b38-a3e6a9c8fde9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=0aaadc2a197cdf33458137a0cca74d06 2x, https://si.imgix.net/3a829749/uploads/origins/ba397790-bb8f-48eb-8b38-a3e6a9c8fde9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=b03692238fdce1c06c3409c216abe0a9 3x"}, "body": "サ国さんの進化し続ける塗りと質感にいつも惚れ惚れしております！久しぶりにリクエストをお願いしたいです。\n死者の魂が入った青い鳥のピニャータで、辛いタコスとミニピニャータ狩りが好きです。ミニピニャータ狩りで優位に立てる自分を優秀な戦士だと思っていますが、他にも色々な動物のピニャータがいるので、いつか蛇やジャガーのピニャータに叩き割られてしまうかもしれません。\n構図や性別の解釈などはお任せしたいです。吹き流しのような赤いテープは必ず描いて下さると嬉しいです。\n何卒よろしくお願いします。\n\nhttps://drive.google.com/drive/folders/1-9Qsw-OwsAwlBm5u88U3xfdVtSOShr-j", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@owan_3/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2711146, "client_id": 2707942, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/e1e6e7e4/uploads/origins/9e5a8df2-8379-4b01-ace0-cffeea217f6c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3fb189b013f2d0f84b148d1e2f6940fc", "srcset": "https://si.imgix.net/e1e6e7e4/uploads/origins/9e5a8df2-8379-4b01-ace0-cffeea217f6c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3fb189b013f2d0f84b148d1e2f6940fc, https://si.imgix.net/e1e6e7e4/uploads/origins/9e5a8df2-8379-4b01-ace0-cffeea217f6c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=5a53bf4ddd83e0cc9c1f4e41966e7bee 2x, https://si.imgix.net/e1e6e7e4/uploads/origins/9e5a8df2-8379-4b01-ace0-cffeea217f6c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ff8f68b12b033094af9dbd5bddf7705c 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/e1e6e7e4/uploads/origins/9e5a8df2-8379-4b01-ace0-cffeea217f6c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6cb588d7d71569c1b5d47be72ec86366", "srcset": "https://si.imgix.net/e1e6e7e4/uploads/origins/9e5a8df2-8379-4b01-ace0-cffeea217f6c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6cb588d7d71569c1b5d47be72ec86366, https://si.imgix.net/e1e6e7e4/uploads/origins/9e5a8df2-8379-4b01-ace0-cffeea217f6c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=0cb653ec8de861a10e19de272957afb6 2x, https://si.imgix.net/e1e6e7e4/uploads/origins/9e5a8df2-8379-4b01-ace0-cffeea217f6c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=f0d1aec58c11882bf5f60f9cc2be76c4 3x"}, "body": "初めまして、10年以上前からずっとおみそさんのイラストが大好きです。\n良かったらSF創作のocをお願いしたいです。壁紙やSNSアイコンに使わせて頂きたいです。\n\n◆キャラクター設定\n・珪素生物のような機械人類(未来人)、性別の概念が無い種\n・常に無表情、内面は感情豊か\n・サイケDJ兼トラックメイカー兼モデル\n・顔以外(衣服、髪、肌)の区別が無く、機械と服の境界が曖昧な無機物の機体をしている\n・イメージカラーは淡い水色、貝殻\n\n◆要望など\n・ポーズ等お任せします。\n・表情が絶対に出ないキャラクターです。\n・身長200cmで現代人よりも少し長く見える身体と手足をしていますが画風によるものかもしれません……\n・おみそさんのセクシーなイラストが大好きなので舌ピアスを見せている差分があると嬉しいですが、金額が足りなければ無くて構いません。\n\nおみそさんの作風は全てがすごく好きなのですが、特にこちらのイラストの顔の向きや手足のラインが格好良くてお気に入りです。メカ系キャラクターの義肢やメカパーツのディテールもクールさと色気が備わっていて本当に大好きです！\nhttps://twitter.com/owan_3/status/1505502908745347073?s=46&t=Dj8yy8FQi_1eQE-2apGbDw\nhttps://twitter.com/owan_3/status/1497593241037729792?s=46&t=Dj8yy8FQi_1eQE-2apGbDw\n\n重ね重ねになってしまうのですが、おみそさんの描かれるバキッとした黒ベタ、クールなコントラストと絶妙なカラー、キャラクターに対するフェチと色気とかわいさが本当に大好きです。\nよろしくお願いします……！\n\nhttps://drive.google.com/drive/folders/1-4q2UiM-YYUMdUmNHoXM2AuWVu1chTL8", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@FL0Ra_oo0/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1994986, "client_id": 2707942