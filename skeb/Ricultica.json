f3357/uploads/origins/267c8f92-7162-4b20-9722-248e2f3d3d6c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4ee63315f4b64dcc14fd98c5bcf26d67", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/4b9f3357/uploads/origins/267c8f92-7162-4b20-9722-248e2f3d3d6c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=39d35f9b9a3f0bfe7e8121c9594522c0", "src_set": ""}, "body": "リクルティカ様\n\nお世話になっております。kamashowです。\n先日は素敵なイラストの納品ありがとうございました。\n可愛らしいごももさんがいっぱいで大変助かりました。\nつきましては再度リクエストの方を投げさせていただきたく思います。\n\n今回のリクエストですが、前回ご納品いただいた落書き集の中央にいる王冠を被ったごももさんが可愛すぎたので、あのテイストですべての宝石と猫を統べる王と化したごももさんをお願いできませんでしょうか。\nごももさん御本人による配信等での利用許諾もいただければと思います。\n製作工程の方はいつもの通りYoutube等で配信していただいて問題ありません。\n\n以上、何卒よろしくお願い申し上げます。", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Ricultica/works/15", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1407691, "client_id": 880427, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/4faabc5d/uploads/origins/b3fdd270-0ea6-48ea-841e-a87019d8db84?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c31e197f25fa01e5585d0e1fcd4874c5", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/4faabc5d/uploads/origins/b3fdd270-0ea6-48ea-841e-a87019d8db84?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5667e6d6444ac90ec64912d0f853ddff", "src_set": ""}, "body": "はじめまして！いつもイラスト拝見させてもらっています！VTuberの三月編三兎と申します。\n\nVTuber三月編三兎のイラストを描いていただきたいです！\n\nリクルティカ様のダークなイラストが好きなのでダーク寄りでポーズや衣装はお任せでお願いします。クラシックロリータな服装もあるので既存の服でも衣装デザインしていただいても構いません！できれば活動で使用したいため、キャラクターの端がみきれないのと背景を別にしていただけると幸いです。\n\n配信等で公開して描いて大丈夫です。\nピースのイラストと切りすぎたのイラストの雰囲気がすきです。\nすべておまかせになってしまって申し訳ないですがご検討よろしくお願いします！\n\n\n■キャラ設定等\n・どの衣装にもついている土星のようなものは心臓なので離れてしまうと死んでしまうのでどこかにあると嬉しい。\n・お耳のところに生えてるのは編み物の耳で中の青いところはフェルトを縫い付けています。\n・四白眼ですがイラストでは三白眼で描きがち。リクルティカ様のジト目好きなのでジト目でも可\n・明るい躁鬱みたいな感じで常にパワフル\n・お料理はできるけどお掃除ができない\n・忘れっぽい性格\n\n■使用用途\nVTuber活動全般\nサムネイル等\n\n資料\nhttps://twitter.com/MitsukiAmiusa/status/1634569934687850496?s=20\n動いてる資料\nhttps://youtu.be/43X3jE2sHrA", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Ricultica/works/14", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1407691, "client_id": 1955575, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/0d556227/uploads/origins/db0f9a3e-668d-42cf-998c-4f55f3567c6b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3645b788b4f9d88dd75e96b1c506e284", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/0d556227/uploads/origins/db0f9a3e-668d-42cf-998c-4f55f3567c6b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ea4fe3fc536c3a68eb03c0796e3da529", "src_set": ""}, "body": "はじめまして、fmkと申します。 うちの子のイラストを描いて頂きたく依頼させてもらいました。 細部はおまかせにします。 https://www.dropbox.com/s/scmwe435perpssv/icon_3455.PNG?dl=0", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Ricultica/works/13", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1407691, "client_id": 2559049, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/498c646b/uploads/origins/dc943519-c532-429d-9cd7-0d42190ca56c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fe39641743a761ce62ef3a01994df644", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/498c646b/uploads/origins/dc943519-c532-429d-9cd7-0d42190ca56c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e30f69027eb720154676417498152044", "src_set": ""}, "body": "こんにちは花牟礼ほのめです\n花牟礼ほのめのキャラ絵をお願いしたいです\n動画のサムネや、挨拶ツイートに使いやすい笑顔の立ち絵がありがたいです\n透過PNGファイルでお願いします\n\nhttps://twitter.com/hanamure_honome/status/1666869380322304001?s=46&t=qZdR_ovnzpJdeGSR6krqiw", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Ricultica/works/12", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1407691, "client_id": 807330, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/09b10550/uploads/origins/71d40ffd-e1e3-41db-8367-6fb7a5971a78?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=80225f4ff01761118c804b88844f372d", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/09b10550/uploads/origins/71d40ffd-e1e3-41db-8367-6fb7a5971a78?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=8442b049dcf48a46ecfc4d302231e1b9", "src_set": ""}, "body": "Vtuberのごももさんの落書きをお願いします！\n配信等での使用許可をお願いします。\n配信でやってもらって大丈夫です。むしろやってもらえると嬉しいです。\nよろしくお願いします。", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Ricultica/works/11", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1407691, "client_id": 807330, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/266dc9d3/uploads/origins/5f98a4e2-f8cb-47fc-acd0-3cc79716f664?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6ce6251d65dca3a9a79b9b04105a358e", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/266dc9d3/uploads/origins/5f98a4e2-f8cb-47fc-acd0-3cc79716f664?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=914f82ac