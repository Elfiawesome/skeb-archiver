905/uploads/origins/212c7390-a0d4-485b-8cb1-77d963331a13?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c6d86053ea3e16c5dd83f8776ee6cd54, https://si.imgix.net/df650905/uploads/origins/212c7390-a0d4-485b-8cb1-77d963331a13?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f4cd586ac10d4eacac666825714d14b9 2x, https://si.imgix.net/df650905/uploads/origins/212c7390-a0d4-485b-8cb1-77d963331a13?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=8a496214c04f9ba094c4360f1fc3e665 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/df650905/uploads/origins/212c7390-a0d4-485b-8cb1-77d963331a13?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=1a13b67a02583d0410dc767377918d5c", "srcset": "https://si.imgix.net/df650905/uploads/origins/212c7390-a0d4-485b-8cb1-77d963331a13?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=1a13b67a02583d0410dc767377918d5c, https://si.imgix.net/df650905/uploads/origins/212c7390-a0d4-485b-8cb1-77d963331a13?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=2b8ce3a2b494cc4ad67f67431da2fb7e 2x, https://si.imgix.net/df650905/uploads/origins/212c7390-a0d4-485b-8cb1-77d963331a13?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=a055c4b2e3f9f42a3edb982b99310365 3x"}, "body": "庶務課様\n初めまして、庶務課様の素敵なイラストをいつも拝見しております。是非友人とのTRPGのPCを描いていただきたいとリクエストをお送りさせていただきます。\n\n【依頼内容】\nPC2人のイラストをお願いします。\nシチュエーション\n・夜の街で背中合わせで拳銃を構えてこちらを向いている\n・青空が見える朝焼けの中で微笑み合っている様子　等\n難しければ雨/夜/煙草といったイメージを盛り込んでいただけると嬉しいです。\n構図は描きやすいようにして頂ければと思います。\n服装はスーツを参考に、細かい箇所は簡略化や省略して頂いて構いません。\n\n【PC詳細】\n▽A\n男性/36歳/182cm/喫煙者\nイメージカラー：緑青(深い緑)\n職業：警視庁捜査第一課所属の刑事(班長)\n性格：普段はにこにこしているが、へらへらしているとも取れる\n飄々とした態度のため多少敵を作りやすい\n顔に出ないがふとした仕草に感情が出やすい\nその他：Bに対しての隠し事はなくなった\n拳銃は右手持ち\n\n▽Ｂ\n女性/25歳/160cm/非喫煙者\nイメージカラー：ピンク(#e3acae)\n職業：警視庁捜査第一課所属の刑事(Ａ班の班員)\n性格：クーデレ系キャリア女刑事、基本は敬語だが特に親しい人にはタメ口\nツンとしているが人を突き放しているわけではなく接し方が下手。顔はいいが愛想はいまいち\n芯は強いタイプ\nその他：非喫煙者だがAの前で一度煙草を吸ったことがある。今はもう吸っていない\n拳銃は両手持ち\n\n▽AとBは上司と部下兼相棒(※恋仲ではない)\n\n【使用用途】\n個人観賞用、自陣への共有、SNSでの紹介、アイコンやヘッダーへの使用、イラストを使用したグッズ作成(いずれも非商用かつ個人利用の範囲)\n\n▽B立ち絵元\nhttps://ameharu.booth.pm/items/4393379\nhttps://ameharu.booth.pm/items/4619752\n\n金額に見合わない場合は再送やキャンセルをして頂いて構いません。\nよろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/1cnF3V_xmu6fJIWYMnp1AahJKjuK9i3bm?usp=sharing", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@syomuka_ex/works/43", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/d6ad2f47/uploads/origins/b7bfa68c-3a4d-41d3-ba1c-8db9ba93ecb6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=f125dcb243585c9c30dcc6fd7883c37e", "srcset": "https://si.imgix.net/d6ad2f47/uploads/origins/b7bfa68c-3a4d-41d3-ba1c-8db9ba93ecb6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=f125dcb243585c9c30dcc6fd7883c37e, https://si.imgix.net/d6ad2f47/uploads/origins/b7bfa68c-3a4d-41d3-ba1c-8db9ba93ecb6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=29dbc8ee171983d4ee184d9db58e2078 2x, https://si.imgix.net/d6ad2f47/uploads/origins/b7bfa68c-3a4d-41d3-ba1c-8db9ba93ecb6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=68478de5d0420ffa7e61fc1d2e10d866 3x"}, "private": true, "genre": "art", "tipped": false, "creator_id": 419423, "client_id": 2953018, "nc": 129}, {"path": "/@syomuka_ex/works/42", "private_thumbnail_image_urls": {"src": "