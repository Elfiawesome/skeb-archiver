e4-8d5c-9da1b9a30926?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=433cc2bbd1d0a36ac47fb6155c89d548 2x, https://si.imgix.net/90e7e72e/uploads/origins/3eaac674-0245-4ae4-8d5c-9da1b9a30926?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=34868921d2be7df63c29cd19c1835029 3x"}, "body": "初めまして！\nTwitterでたまたまお見かけし、pixivを拝見して素敵なお乳を描かれているのを知り（https://www.pixiv.net/artworks/127694547\n）、リクエストしたいと思いました。\nうちのこのお乳が揉まれているイラストをリクエストしたいのですが、宜しいでしょうか？\n\n恋人に強めに揉まれている感じで、少しぐにぐに形が変わっていて欲しいです。\n表情は「少し痛いけど、私が迫り続けたのが原因だし……仕方ないな、満足するまで揉ませてあげる」みたいな、我慢と微笑みが混ざったような表情でお願いしたいです。\n構図などはお任せしますが、お乳重点的で両乳首が指の隙間から見えていて、おへそまでは描いてほしいです。\n可能であれば尻尾もお願いしたいです。\nあと、お手数なのですが、母乳差分をお願いします。\n\n別のクリエイター様にリクエストしたものになりますが、デザインはこちらです。\nhttps://skeb.jp/@wf170ZpFwi/works/234\n\n猫の尻尾は上下で黒白と色が分かれていて、ヒマラヤンのような毛並みです。\n猫耳と人間の耳はどちらも存在します。瞳孔は猫が興奮した時みたいに丸めでお願いします。\nバストサイズはＥで、乳輪は少しぷっくりしています。\n全裸で構いません。\n\nもし宜しければ、御検討お願いします。", "nc": 177, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@purinithiXX/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3936185, "client_id": 415622, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/07a27c80/uploads/origins/b96c2b33-481e-497d-a7c3-3c1ba2d82a24?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=228bbf505a3bf6cccfe7a48e7c02fd3e", "srcset": "https://si.imgix.net/07a27c80/uploads/origins/b96c2b33-481e-497d-a7c3-3c1ba2d82a24?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=228bbf505a3bf6cccfe7a48e7c02fd3e, https://si.imgix.net/07a27c80/uploads/origins/b96c2b33-481e-497d-a7c3-3c1ba2d82a24?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=92cbb1e5708a9d5e040006c6e3af4b4a 2x, https://si.imgix.net/07a27c80/uploads/origins/b96c2b33-481e-497d-a7c3-3c1ba2d82a24?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop