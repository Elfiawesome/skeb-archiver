ncredible!\nI loved your latest artwork too, the pose and the lighting was really beautiful! I think you can capture the wholesome chaos that my vTuber represents! I did attach a reference of a character I really love for pose ideas and expression!\n\nThank you so much for your hard work!!\n\nhttps://static.zerochan.net/Ouma.Kokichi.full.2086077.jpg", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@ayaharu4789/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 564726, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/20777ac4/uploads/origins/f76fb95f-c7ca-44eb-aec6-4e45abedef34?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b4b4ae37104cbb6e6e7275da051d51fd", "srcset": "https://si.imgix.net/20777ac4/uploads/origins/f76fb95f-c7ca-44eb-aec6-4e45abedef34?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b4b4ae37104cbb6e6e7275da051d51fd, https://si.imgix.net/20777ac4/uploads/origins/f76fb95f-c7ca-44eb-aec6-4e45abedef34?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e6f49ad5df43c44ca32467ebf40634f1 2x, https://si.imgix.net/20777ac4/uploads/origins/f76fb95f-c7ca-44eb-aec6-4e45abedef34?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=36a37b67c9b706b99f3e4acfbae223d5 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/20777ac4/uploads/origins/f76fb95f-c7ca-44eb-aec6-4e45abedef34?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9ca495ffb828f2f2d33ac08cc9cace05", "srcset": "https://si.imgix.net/20777ac4/uploads/origins/f76fb95f-c7ca-44eb-aec6-4e45abedef34?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9ca495ffb828f2f2d33ac08cc9cace05, https://si.imgix.net/20777ac4/uploads/origins/f76fb95f-c7ca-44eb