いイラストを楽しみにしております。\n\nhttps://bluearchive.wikiru.jp/?%E3%82%AB%E3%83%A8%E3%82%B3", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}], "sent_works": [], "similar_creators": [{"id": 266025, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "瀬奈 悠太", "screen_name": "charon_mog_kero", "avatar_url": "https://pbs.twimg.com/profile_images/1832089666272870401/kDdDDQjr.jpg", "header_url": "https://pbs.twimg.com/profile_banners/3110160620/1669633844/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 90, "skills": [{"genre": "art"}], "nc": 33}, {"id": 1314046, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "ゆれ", "screen_name": "mr_ayarabbit", "avatar_url": "https://pbs.twimg.com/profile_images/1663553167748104194/ibT862Ug.jpg", "header_url": null, "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 7, "complete_expiration_days": 40, "skills": [{"genre": "art"}], "nc": 161}, {"id": 2678772, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "ねこみや うな️", "screen_name": "nekomiya0309", "avatar_url": "https://pbs.twimg.com/profile_images/1926709557482369024/5h7HVyom.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1641773738269229058/1764595073/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 90, "skills": [{"genre": "art"}], "nc": 176}, {"id": 2742776, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "椅子井@多忙", "screen_name": "ISUI_130", "avatar_url": 