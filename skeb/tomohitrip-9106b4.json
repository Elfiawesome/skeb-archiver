82-706778c7fa33?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=3f7cd405d02777df412254e8c738b989 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/dbcdf940/uploads/origins/580569ea-3016-4d73-bc82-706778c7fa33?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f6b27adb4dd19d87f42a41d066bbfd33", "srcset": "https://si.imgix.net/dbcdf940/uploads/origins/580569ea-3016-4d73-bc82-706778c7fa33?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f6b27adb4dd19d87f42a41d066bbfd33, https://si.imgix.net/dbcdf940/uploads/origins/580569ea-3016-4d73-bc82-706778c7fa33?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=dd30d57f5bc41819d580dabc36f9a886 2x, https://si.imgix.net/dbcdf940/uploads/origins/580569ea-3016-4d73-bc82-706778c7fa33?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=05e1a3c467f507e70fd07f2f71a85b7c 3x"}, "body": "ともひ先生の『ゆうやけトリップ』、懐かしさや柔らかな優しさを感じながら、楽しく拝読しております。\nこのたびはマイキャラクター2人の日常風景を描いて頂きたく思い、リクエストをお送りしました。\n\n◆リクエスト内容\nうららかな春の日差しの中、添付資料のマイキャラクター2人（女子高生と猫妖怪）が、両サイドに桜並木の生えている散歩道を、並んで楽しげに歩いているところ\nのイラストをリクエストいたします。\n\n◆用途\n・いわゆるTRPGやPBW系ゲームのオンラインセッションなどで、イベントシーンイメージとして使わせて頂きたいです。（スチル、挿絵的な）\n・商業用途ではございませんが、不特定多数の人が閲覧できる状態に置かれ得ることをお許し頂けますと嬉しいです。\n\n◆キャラクター設定1：女子高生\n・現代日本（妖怪が実在する世界観）の女子高生です。\n・怪異絡みの事故で片目を失い、髪の毛でその傷を隠しています。\n・そんな過去を持っていますが、性格は明るく温厚で元気に学生生活を過ごしています。\n・身長は155cmほどで、同世代の子よりほんの少しだけ低いです。\n・猫妖怪の飼い主、兼、友人で、普段から文字どおり猫可愛がりしています。\n\n◆キャラクター設定2：猫妖怪\n・猫の耳・九本の尻尾を持つ人の姿をした、山猫の妖怪です。\n・人の姿と猫の姿を使い分けて暮らしています。\n・妖怪的正装の時はいかにも大妖怪然とした立ち振る舞いを心がけているものの、実際は自由気ままで食う寝る遊ぶが好きな、猫らしい猫です。\n・普段着のセンスが壊滅的でクソダサです。\n・ぽっくり下駄を履いていたり猫耳があったりで一見背が高く見えますが、それらを抜いた身長は152cmほどでやや小柄です。\n・飼い主、兼、友人の女子高生のことが大好きで、よくじゃれついて甘えます。\n\nリクエスト内容は以上となります。\n上記に指定の無い要素は全てお任せいたします。\nご検討頂けますと幸いです。よろしくお願いいたします。\n\nhttps://www.dropbox.com/scl/fo/491c9pk763llblkxqz40g/ALOdYB73AnVT3BZHu4_MMq