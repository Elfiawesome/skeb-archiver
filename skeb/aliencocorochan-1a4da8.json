す(資料URLご参照ください)\n　　(細かいですが…首の方は結び目1つ、三角巾の端が2つ、肘の方は結び目1つ、三角巾の端が1つ、という違いがあります)\n　‐右腕が画面に入るような構図でお願いします\n・ほっぺたに絆創膏１枚\n・ケガをしてても暗くならず、以下のような照れている表情\n　‐片目ウィンク、ペロっと舌を出している、いわゆるてへぺろな表情\n\n包帯に萌えるのと、それでも可愛く元気な姿に萌えるのが個人的なポイントです。\n\nhttps://www.youtube.com/watch?v=iLDkTBdxs4w", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@aliencocorochan/works/9", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3566787, "client_id": 2102629, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/1fdc3a24/uploads/origins/3347e996-8c92-457d-b85a-f3a9963cd3fd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8b2672b94f65e9a2a3f2441df9563749", "srcset": "https://si.imgix.net/1fdc3a24/uploads/origins/3347e996-8c92-457d-b85a-f3a9963cd3fd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8b2672b94f65e9a2a3f2441df9563749, https://si.imgix.net/1fdc3a24/uploads/origins/3347e996-8c92-457d-b85a-f3a9963cd3fd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=59b53abf9c3e6b6ca3d241f1932a568a 2x, https://si.imgix.net/1fdc3a24/uploads/origins/3347e996-8c92-457d-b85a-f3a9963cd3fd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=45129b3ff20187d72779ddd968e17f0e 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/1fdc3a24/uploads/origins/3347e996-8c92-457d-b85a-f3a9963cd3fd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=00c02a078f0bbb0ffe0e11ced361ddc9", "srcset": "https://si.imgix.net/1fdc3a24/uploads/origins/3347e996-8c92-457d-b85a-f3a9963cd3fd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=00c02a078f0bbb0ffe0e11ced361ddc9, https://si.imgix.net/1fdc3a24/uploads/origins/3347e996-8c92-457d-b85a-f3a9963cd3fd?bg=%23fff&auto=format%2Ccompress&fm=webp&dp