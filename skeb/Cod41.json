_id": 3646584, "client_id": 3723880, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/6aafc05e/uploads/origins/5d64e62d-d4cd-4fa7-bb3d-497152ac077d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8e1d0c57c165e1e7c951f2dcda156cf1", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/6aafc05e/uploads/origins/5d64e62d-d4cd-4fa7-bb3d-497152ac077d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a9f7a66ffdff5af94798ee239dcafa2f", "src_set": ""}, "body": "こんにちは！某あるけみすとのプロフ絵を描いていただきたいです。\n夜空を背景にした横向きor後ろ向きのキャラクターを描いてほしいです！\nキャラクターのアイコン、衣装デザインは資料に置いておきます！\n\n*描いていただきたい内容*\n片手で虹色に光る蛍石を空に掲げていて、頭には丸っこいぬいぐるみみたいなペット(ｶﾆﾁｬﾝ)をちょこんと乗せてほしいです。\n空には星がいっぱいで、かに座と、その他いくつかの星座がふんわり光っていると嬉しいです。\n場所は砂漠の中です！\n\n蛍石とｶﾆﾁｬﾝが含まれていれば、好きなように構図を決めてもらって大丈夫です！思うがままに、よろしくお願いします！\n\n\n雰囲気の参考になりそうなオリジナルスキルも置いときます！\n\n「ひとしずくの光」\nポシェットから虹色に輝く蛍石をとりだした！握る手から、忘れかけていた光がじんわりとにじみ出す。それは、私だけの宝物——誰にも届くやさしい色。\n\n「記憶の星図をなぞって」\n蛍石をひとつ、そっと握って星を見上げた。浮かびあがったのは、名前のない星座​…たぶん、それはあなたの心のかたち。わたしの光は、もう迷わない。きっと、ちゃんと届く。\n\nhttps://drive.google.com/drive/folders/10ouuI8Tfjm_XO4OVSJHyPe8_MqeDehSx?usp=drive_link", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Cod41/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3646584, "client_id": 3690646, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/0114bf34/uploads/origins/752f5f8d-05b1-4713-a0fa-9516f4428de1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=29f7c041ad1622ab8d7b0de811d92159", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/0114bf34/uploads/origins/752f5f8d-05b1-4713-a0fa-9516f4428de1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b1fdd5377606b765f4bdb016951f70e2", "src_set": ""}, "body": "こんにちは！あるキャラクターを描いていただけませんか？名前はLyrで、若いヒーラー（12歳くらい）です。物腰は柔らかいのですが、いつも善意で接しているのですが、非常にナイーブなところがあります。\n\n下のリンクの1枚目の画像が彼の実際の姿だが、2枚目の画像では彼の服装がよくわかる。彼はファイナルファンタジーのゲームに登場する白魔道士に由来していますが、お好みでいろいろ変えてみてください！ポーズや表情も自由です。\n\n最後まで読んでいただきありがとうございました！アレンジできるといいですね！\n\nhttps://drive.google.com/drive/folders/1boro85naHAxaRISCOjfquW3OB8kBWRlT?usp=sharing", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "similar_creators": [{"id": 85547, "creator": true, "nsfw_acceptable": true, "acceptable": false, "name": "葛ノ木", "screen_name": "kuzugitsune", "avatar_url": "https://pbs.twimg.com/profile_images/1414910229439868932/97_05lrU.jpg", "header_url": "https://pbs.twimg.com/profile_banners/878169619/1594297910/1500x500", "appeal_receivable": true, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "skills": [{"genre": "art"}], "nc": 176}, {"id": 398838, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "ヒヨヨ@skeb募集中", "screen_name": "kou_hiyoyo", "avatar_url": "https://pbs.twimg.com/profile_images/1820725109768003584/nFqwhAAN.png", "header_url": "https://pbs.twimg.com/profile_banners/105523086/1725285923/1500x500", "appeal_receivable": false, "popular_creator_rank": 5, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 10, "skills": [{"genre": "art"}, {"genre": "comic"}], "nc": 48}, {"id": 1012217, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "せとちゃん", "screen_name": "mdms_naaa", "avatar_url": "https://pbs.twimg.com/profile_images/1942286206298996736/Cn0BvRuD.png", "header_url": "https://pbs.twimg.com/profile_banners/1298673996347523074/1753897861/1500x500", "appeal_receivable": true, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank