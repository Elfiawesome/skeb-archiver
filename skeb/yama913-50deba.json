をご覧ください。\n\n衣装については２種類あるのですが、どちらを描いてくださっても大丈夫です。\nもしくは、オリジナルの衣装を考えて着せてくださってもかまいません！\n\nイラストの内容に指定はありませんが、配信のサムネイル等にも使用する場合があるので人物と背景のレイヤーは分けていただけると嬉しいです。\nまた、サムネイルなどに使用しやすいように耳の先や指先などが切れていない構図だと助かります。\n\n【使用範囲について】\n納品していただイラストは私のTwitterやYouTube等のSNSで公開、ネットワークプリントサービスを使用しての配布、グッズ購入者への無償特典（おまけ）、その他所属団体の公式HPやSNSでも使用する場合があります。\n\n\n以上です。\nよろしくお願いします。\n\nhttps://drive.google.com/drive/folders/1tb25yc5sgyYwH1QunleeeaWyHgSGyV9W?usp=sharing", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@yama913/works/40", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2709883, "client_id": 3419650, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/d71b2d8a/uploads/origins/c9bbb609-0d9a-49d9-8ec8-7e5dda19c2fa?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=07c1a523c8ef0eed39801654d6679006", "srcset": "https://si.imgix.net/d71b2d8a/uploads/origins/c9bbb609-0d9a-49d9-8ec8-7e5dda19c2fa?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=07c1a523c8ef0eed39801654d6679006, https://si.imgix.net/d71b2d8a/uploads/origins/c9bbb609-0d9a-49d9-8ec8-7e5dda19c2fa?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=380d90ba2fcb1334c0bf7fb7b4a764fd 2x, https://si.imgix.net/d71b2d8a/uploads/origins/c9bbb609-0d9a-49d9-8ec8-7e5dda19c2fa?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c795e750996ec570798c7a0f99b53dd2 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/d71b2d8a/uploads/origins/c9bbb609-0d9a-49d9-8ec8-7e5dda19c2fa?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c0b7d43323f466fa6a3c3d9ca7736115", "srcset": "https://si.imgix.net/d71b2d8a/uploads/origins/c9bbb609-0d9a-49d9-8ec8-7e5dda19c2fa?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur