全然違うですけど）、服のイメージは以下のURLを参照ください。\n\n良ければ、艤装の部分もお願いしたいのですが。\n艤装の構造：アズールレイーンの三笠を参考にして、但し上部の主砲は取り外され、船体の舷側が艤装のメインパーツにする（大盾のように)。\n武装はほぼカロネード砲（船首が大口徑2門、舷側には3階層になった数十門の中口径砲)；まだ、後ろに帆とZ信号旗がある。\n\nhttps://drive.google.com/file/d/1tGFzOP1BXCfHpLCv5J1NViMPVDdPOy4J/view?usp=sharing", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@8ware63/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1311743, "client_id": 227230, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/0a3a571a/uploads/origins/498a85e3-585b-46c3-8740-b6dd4f90009e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=cdf69d8cf20834f3c05f7a2e4c66da36", "srcset": "https://si.imgix.net/0a3a571a/uploads/origins/498a85e3-585b-46c3-8740-b6dd4f90009e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=cdf69d8cf20834f3c05f7a2e4c66da36, https://si.imgix.net/0a3a571a/uploads/origins/498a85e3-585b-46c3-8740-b6dd4f90009e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=089c347b4e35cc02d86058cf4757a6e3 2x, https://si.imgix.net/0a3a571a/uploads/origins/498a85e3-585b-46c3-8740-b6dd4f90009e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=09c5d5a3dbcad5f1d91b61acd843fe37 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/0a3a571a/uploads/origins/498a85e3-585b-46c3-8740-b6dd4f90009e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=be9c6ae9636bb65100369634d2c775ea", "srcset": "https://si.imgix.net/0a3a571a/uploads/origins/498a85e3-585b-46c3-8740-b6dd4f90009e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=be9c6ae9636bb65100369634d2c775ea, https://si.imgix.net/0a3a571a/uploads/origins/498a85e3-585b-46c3-8740-b6dd4f90009e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr