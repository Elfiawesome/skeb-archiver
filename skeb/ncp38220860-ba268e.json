enre": true}, {"path": "/@ncp38220860/works/8", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 196913, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/8496a7e3/uploads/origins/9b0ad2ce-0453-4c44-b78a-a4f772d2c29c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=94db84919e3aff7273d6ee396632c9ff", "srcset": "https://si.imgix.net/8496a7e3/uploads/origins/9b0ad2ce-0453-4c44-b78a-a4f772d2c29c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=94db84919e3aff7273d6ee396632c9ff, https://si.imgix.net/8496a7e3/uploads/origins/9b0ad2ce-0453-4c44-b78a-a4f772d2c29c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=2de4a999301a64657bf783ccbe0d4678 2x, https://si.imgix.net/8496a7e3/uploads/origins/9b0ad2ce-0453-4c44-b78a-a4f772d2c29c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=7891e6adc6c74f68915c2a2ed88ec34a 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/8496a7e3/uploads/origins/9b0ad2ce-0453-4c44-b78a-a4f772d2c29c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=deb2c708f35ad41dd2af5e107002520c", "srcset": "https://si.imgix.net/8496a7e3/uploads/origins/9b0ad2ce-0453-4c44-b78a-a4f772d2c29c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=deb2c708f35ad41dd2af5e107002520c, https://si.imgix.net/8496a7e3/uploads/origins/9b0ad2ce-0453-4c44-b78a-a4f772d2c29c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=5b2f7945ea6983f6aabe670032421181 2x, https://si.imgix.net/8496a7e3/uploads/origins/9b0ad2ce-0453-4c44-b78a-a4f772d2c29c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=936c679abcfc0ded98faa4d4e9fb3faf 3x"}, "body": "とても古いPCゲーム作品ですが\n\n作品:この世の果てで恋を唄う少女YU-NO（PC98版）\nキャラ:武田絵里子\nhttp://i-bbs.sijex.net/bbs/gif/1680958937422o.gif\n\nシーン:\n敵（龍蔵寺）を主人公と共に追い詰めるが、不意打ちから敵の洗脳を受けてしまい幻惑され言いなりに\n\n詳細:\n強い幻惑により正気を失い、\n普段の教師の姿\nhttp://i-bbs.sijex.net/bbs/gif/1680958894466o.gif\n\nからは想像できない妖艶な姿で主人公に大人の女を教えようと迫る絵里子。\n\nしかし、絵里子を正気に戻すため百戦錬磨のテクニックを駆使する主人公に逆に男を教え込まれ、\nhttp://i-bbs.sijex.net/bbs/gif/1680959174574o.png\n\nあまりの刺激に正気を取り戻すも、\n今度は主人公のテクニックと若くて猛々しいモノに屈服してしまい、年下の、しかも10代の学生に感じてしまっていることに悔しさを滲ませながらも、ついには精を懇願しながら本来の目的も忘れイキ狂う。\nhttp://i-bbs.sijex.net/bbs/gif/1680959231488o.png\n\n以上です。\n\n\n保険医は仮の姿、\nぴっちりボディコンで、大人の余裕を見せつける絵里子先生が高校生風情の主人公にいいように弄ばれるシーンが当時からの夢でした。\n\nお忙しいとは思いますが、お時間あるときでかまいませんので描いていただけると幸いです。よろしくお願いします。\n\nhttps://www.google.com/url?sa=t&source=web&rct=j&url=https://m.youtube.com/watch%3Fv%3DHSEdT687SGM&ved=2ahUKEwitmd6T1ZfxAhWVfXAKHYqQBsgQjjgwAHoECAQQAg&usg=AOvVaw0zFgpiEYLlPfycn4tK8FNd", "nc": 185, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@ncp38220860/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 196913, "client_id": 166754, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/dc2d11f5/uploads/origins/d9ddf154-9897-4c73-9683-788c801592f3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c85625a81adae1cb4b0d9ee99982c664", "srcset": "https://si.imgix.net/dc2d11f5/uploads/origins/d9ddf154-9897-4c73-9683-788c801592f3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c85625a81adae1cb4b0d9ee99982c664, https://si.imgix.net/dc2d11f5/uploads/origins/d9ddf154-9897-4c73-9683-788c801592f3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=09f1f0a080d811813dd4666eae37d701 2x, https://si.imgix.net/dc2d11f5/uploads/origins/d9ddf154-9897-4c73-9683-788c801592f3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ea698c4c0f8214ab35b4d06bc938c07d 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/dc2d11f5/uploads/origins/d9ddf154-9897-4c73-9683-788c801592f3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=648337a2bd36c89b3d51dbf547820451", "srcset": "https://si.imgix.net/dc2d11f5/uploads/origins/d9ddf154-9897-4c73-9683-788c801592f3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=648337a2bd36c89b3d51dbf547820451, https://si.imgix.net/dc2d11f5/uploads/origins/d9ddf154-9897-4c73-9683-788c801592f3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=777c38bac23f898d4c0cef5d3dba4297 2x, https://si.imgix.net/dc2d11f5/uploads/origins/d9ddf154-9897-4c73-9683-788c801592f3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=805f805a017177f8d83ff8f2925d6d4b 3x"}, "body": "エナメルナース服（@azazel1944さんのデザイン）を着た女が奴隷のチンコに電動オナホを取り付けその上にカテーテルを尿道に挿入してメスシリンダーに繋げる。\n右手でワイヤレスのリモコンを持ってボタンを押し電動オナホで強制搾精、射精した精液はメスシリンダーに溜める。(1コマでボタンを押す描写を追加でお願い致します)\nボタンを押す度に電動オナホのピストンのスピードが上がり精液がドビュドビュと絞り出させ男でも扱くのが無理なくらいのスピードまで上がった頃にはメスシリンダーがこぼれるくらいに精液が溜まって奴隷は気絶するが女は気にせずにボタンを押しオナホの扱きスピードを更に加速させる。\n※参考画像(画像では顔面騎乗してますがなしで椅子に座ってリモコンのボタンを押してください)\nhttps://mbmbcvq.afxnkkekwfqw.hath.network:2048/h/34bd3563a7fc9829eb4dd1e5f44e3ae0689a4643-78381-800-600-jpg/keystamp=1637766900-4deb549640;fileindex=28911687;xres=2400/ev_iro_h07_05.jpg", "nc": 185, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@ncp38220860/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 196913, "client_id": 166754, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/63c810d4/uploads/origins/6192e884-d5da-45d2-addc-96c35ebb5db9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fab38aaf1d7b1968bfa5e378508fbcfd", "srcset": "https://si.imgix.net/63c810d4/uploads/origins/6192e884-d5da-45d2-addc-96c35ebb5db9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fab38aaf1d7b1968bfa5e378508fbcfd, https://si.imgix.net/63c810d4/uploads/origins/6192e884-d5da-45d2-addc-96c35ebb5db9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=801213750a9d92852ae41ea99a1278b6 2x, https://si.imgix.net/63c810d4/uploads/origins/6192e884-d5da-45d2-addc-96c35ebb5db9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=1b1c4081788a6a6ede523ca6e7ecd85b 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/63c810d4/uploads/origins/6192e884-d5da-45d2-addc-96c35ebb5db9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=7f932d702c05723968117b952e719209", "srcset": "https://si.imgix.net/63c810d4/uploads/origins/6192e884-d5da-45d2-addc-96c35ebb5db9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=7f932d702c05723968117b952e719209, https://si.imgix.net/63c810d4/uploads/origins/6192e884-d5da-45d2-addc-96c35ebb5db9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=fcaf663a7e48e9047222978d0a1d3665 2x, https://si.imgix.net/63c810d4/uploads/origins/6192e884-d5da-45d2-addc-96c35ebb5db9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=091bc7b62c8778959cab93f4a25984b4 3x"}, "body": "チンコに透明な電動オナホを装着されボールギャグで口を塞がれた全裸の奴隷が黒のエナメルナース服（@azazel1944さんのデザイン）を着た女が持っているリモコンをオナホに向けてボタンを押しオナホを動かす。\nあまりのオナホの気持ちよさに奴隷のチンコから精子がドビュッと飛び出て、それを見た女は鼻で笑ったあとにリモコンのボタンを押し続けオナホのしごきスピードを更に強め、我慢出来なくなった奴隷は大量の精子を吹き出すと同時におしっこも漏らしてしまう\nそれを見た女ちゃんは「じゃあ帰るね。あっそうそう」と同時に更にボタンを押し続けて仕舞いには男でもしごけられないスピードまでしごかれて女は「干からびないよう頑張ってね～」と言って帰って放置プレイされる絵をお願い致します\n\n※エナメルナース服のデザイン\nhttps://twitter.com/azazel1944/status/1183323923049529344", "nc": 168, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@ncp38220860/works/5", "private_thumbnail_image_urls": {"src": "https://si.imgix.net