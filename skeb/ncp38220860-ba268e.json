net/1bc68553/uploads/origins/45de4c70-77bf-4592-bb25-ad11fba5b716?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=89bdeb55657e17f7492514a6b8629495 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/1bc68553/uploads/origins/45de4c70-77bf-4592-bb25-ad11fba5b716?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=285684c8dae1cea57fed3ece0360373a", "srcset": "https://si.imgix.net/1bc68553/uploads/origins/45de4c70-77bf-4592-bb25-ad11fba5b716?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=285684c8dae1cea57fed3ece0360373a, https://si.imgix.net/1bc68553/uploads/origins/45de4c70-77bf-4592-bb25-ad11fba5b716?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=46d18437b0212cf4ef687275f82776d9 2x, https://si.imgix.net/1bc68553/uploads/origins/45de4c70-77bf-4592-bb25-ad11fba5b716?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=ee7308e84ccf932726455b83a25cbf18 3x"}, "body": "前回はありがとうございました。素晴らしかったのでリピートお願いします。\nキャラクター：悪女ベラドンナよりベラドンナ（エリカ）\nシチュエーションですが、前回のリクエストにあった回想シーンでの皇帝への手コキフェラ奉仕シチュの掘り下げをお願いします。\n容姿\n衣装ですがベラドンナ衣装（マント有）で、紫色のリップ有で。緑色の瞳で胸の紋章有で。\n設定\nベラドンナに堕ちた直後の為、エリカとしての人格（マコちゃんへの思いが少し残っている）\nフェラ奉仕はしたことがないので行為がきごちない感じでお願いします。\n前に描かれましたベラドンナに堕ちた直後に奉仕するイメージで。\n詳細\n・台詞もよろしければお願いします。（）は一部セリフサンプルになります。\n①初めてのフェラ奉仕をすることになり皇帝のデカ陰茎を見て少し困惑しつつも裏筋を手で撫でる。膣部からは愛液が垂れている。\n　（こんなに大きいのが私の膣部に挿入っていたなんて・・・まだアソコがジンジンする）\n②フェラ開始。臭いで失神しそうになるも舌で亀頭を舐める。\n③深く陰茎を口の中に入れ、少しえづきながらも段々慣れていく\n　（こんなの、マコちゃんにもしたことないのに）\n④皇帝が射精しそうになり、奉仕をいったんやめるよう命じられる。陰茎から唾液ブリッジが形成されている。\nマコちゃんと比べてどうだと皇帝から聞かれて、一瞬戸惑うも身も心も皇帝に塗り替えられてしまい皇帝のがいいと懇願（ごめんねマコちゃん、身も心も皇帝様に変えられてしまったけど今までの想いだけは・・・）\n⑤皇帝から射精するぞと言われ、回想シーンにつながるような表情になったあと精液ぶっかけ\n\nhttps://drive.google.com/drive/folders/1nFVLgfG-0i9X1uQPiC_A5g5V-Y9jK0f0?usp=drive_link", "nc": 57, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@ncp38220860/works/12", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 196913, "client_id": 1202629, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/7669f2a4/uploads/origins/40356ddf-b1e4-46b2-a015-a63f7840ac17?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=54f5468cc6872462dcd4d5eaa74e6bcf", "srcset": "https://si.imgix.net/7669f2a4/uploads/origins/40356ddf-b1e4-46b2-a015-a63f7840ac17?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=54f5468cc6872462dcd4d5eaa74e6bcf, https://si.imgix.net/7669f2a4/uploads/origins/40356ddf-b1e4-46b2-a015-a63f7840ac17?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=996d68a983f550c76b02720fee90e1fa 2x, https://si.imgix.net/7669f2a4/uploads/origins/40356ddf-b1e4-46b2-a015-a63f7840ac17?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b95689018a47ebb78b3a63e8a55b27e8 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/7669f2a4/uploads/origins/40356ddf-b1e4-46b2-a015-a63f7840ac17?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ecf85b413a3707d253c9ee4e0b4dd242", "srcset": "https://si.imgix.net/7669f2a4/uploads/origins/40356ddf-b1e4-46b2-a015-a63f7840ac17?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ecf85b413a3707d253c9ee4e0b4dd242, https://si.imgix.net/7669f2a4/uploads/origins/40356ddf-b1e4-46b2-a015-a63f7840ac17?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=8024c4985a8c4375dbb6929bb9c0ae39 2x, https://si.imgix.net/7669f2a4/uploads/origins/40356ddf-b1e4-46b2-a015-a63f7840ac17?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=623e66e89e427193d80801d5fdc057c3 3x"}, "body": "前回はリクエストありがとうございます。よろしければリピートお願いします。\nキャラクターですが、悪女ベラドンナよりベラドンナ（エリカ）\nシチュエーションですが、一時的に正気に戻ったエリカがマコちゃんの臭チンにフェラ奉仕するも内心満たされないところ、皇帝が現れ、バックで挿入され、再びベラドンナに再洗脳されるシチュをお願いします。\n容姿\n衣装ですが、堕ち前・堕ち後ともにベラドンナ衣装（マント有）で、紫色のリップ有で。\n（堕ち前）\n・瞳の色はエリカ時の茶色で胸の紋章は無しで\n（堕ち後）\n・緑色の瞳で胸の紋章有で\n詳細\n・構図ですがベラドンナのみ描かれている感じでお願いします（竿役は簡易的な感じで）\n・戦闘により強い衝撃を受け、一時的に正気に戻ったエリカが洗脳の後遺症で発情状態に\n・マコちゃんの陰茎を取り出し臭いにしかめつつもチンカス掃除しつつ奉仕\n・マコちゃん射精。エリカは言葉上ではいっぱい出たねと言うが内心は皇帝の方がもっと濃いのに、私、なんてことを考えてるのと不満げに\n・皇帝が現れ困惑・抵抗するエリカ。その後皇帝に挿入される。（挿入時は服がはだけ、胸が露出）\n・快楽に抵抗しつつも皇帝の言葉に段々堕とされていく、再び胸の紋章が形成。瞳の色が緑色に（眼のハイライト無しで）\n・射精＆絶頂（眼ハイライトが戻り、再びベラドンナへ）\n・マコちゃんに仕方なく再フェラしつつ言葉責め罵倒\n細かなセリフはおまかせしますのでご検討お願いします。\n可能であれば堕ち前の眼鏡差分もお願いします。", "nc": 40, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@ncp38220860/works/11", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 196913, "client_id": 1202629, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/7c9640c7/uploads/origins/11b282e8-4ecc-4934-82ec-21293094cfcf?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e7502c0ceae73adccbfce09f804db417", "srcset": "https://si.imgix.net/7c9640c7/uploads/origins/11b282e8-4ecc-4934-82ec-21293094cfcf?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e7502c0ceae73adccbfce09f804db417, https://si.imgix.net/7c9640c7/uploads/origins/11b282e8-4ecc-4934-82ec-21293094cfcf?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=d5079df578d1384b6b3ee7cef87aeac5 2x, https://si.imgix.net/7c9640c7/uploads/origins/11b282e8-4ecc-4934-82ec-21293094cfcf?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a3eb5ea1ae943d13fe7605cbf9650fde 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/7c9640c7/uploads/origins/11b282e8-4ecc-4934-82ec-21293094cfcf?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b3dba26d7738af7b1f41bc13bd1188d1", "srcset": "https://si.imgix.net/7c9640c7/uploads/origins/11b282e8-4ecc-4934-82ec-21293094cfcf?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b3dba26d7738af7b1f41bc13bd1188d1, https://si.imgix.net/7c9640c7/uploads/origins/11b282e8-4ecc-4934-82ec-21293094cfcf?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=500cf074cc94439ccfd17669ed321595 2x, https://si.imgix.net/7c9640c7/uploads/origins/11b282e8-4ecc-4934-82ec-21293094cfcf?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=03ff1c75c83d041e896bb0bc80840195 3x"}, "body": "お久しぶりです。よろしければリクエストお願いします。\n悪女ベラドンナよりベラドンナでシチュエーションですが皇帝により、エリカがベラドンナに堕ちるシチュをお願いします。\n容姿\n衣装ですが、堕ち前・堕ち後ともにベラドンナ衣装（マント有）で、紫色のリップ有で。\n（堕ち前）\n・瞳の色はエリカ時の茶色で胸の紋章は無しで\n（堕ち後）\n・緑色の瞳で胸の紋章有で\n\n詳細\n・基本構図は正常位で両手は掴まれている体勢で。足のつま先まで見える感じで\n・竿役は簡易的な感じで大丈夫です\n台詞もよろしければお願いします。\n①膣部からは愛液が垂れていて、陰茎を当てられている。表情は赤面しつつも睨んでいる。\n　セリフは「たとえこんな姿にされてもあなたなんかに屈しない」のような感じで\n②挿入され、涎を垂らしつつも抵抗している表情で。服がずれ、乳首が露出している。\n③快楽を受け入れていき胸に紋章が形成される。困惑しつつも抵抗する感じで\n④射精＆絶頂。快楽に耐えられなくなり皇帝の妃になることを宣言する。瞳が緑色に。\n⑤妖艶な表情で皇帝に忠誠を誓う。一人称が変化する。\nその他のところはお任せしますのでご検討お願いします。", "nc": 176, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@ncp38220860/works/10", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 196913, "client_id": 1202629, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/71d7fe65/uploads/origins/2ae6f466-c411-4dab-8a51-8b506822dd3b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1b2c5c3948ad4444ecb4efb58fa6ff95", "srcset": "https://si.imgix.net/71d7fe65/uploads/origins/2ae6f466-c411-4dab-8a51-8b506822dd3b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1b2c5c3948ad4444ecb4efb58fa6ff95, https://si.imgix.net/71d7fe65/uploads/origins/2ae6f466-c411-4dab-8a51-8b506822dd3b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=73f08f374a1469717cbdd396bead7c5f 2x, https://si.imgix.net/71d7fe65/uploads/origins/2ae6f466-c411-4dab-8a51-8b506822dd3b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=81573b9cbb00f6cce8c9c711dbddd347 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/71d7fe65/uploads/origins/2ae6f466-c411-4dab-8a51-8b506822dd3b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=58f86178c17b4b51afc6a99d7be96790", "srcset": "https://si.imgix.net/71d7fe65/uploads/origins/2ae6f466-c411-4dab-8a51-8b506822dd3b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=58f86178c17b4b51afc6a99d7be96790, https://si.imgix.net/71d7fe65/uploads/origins/2ae6f466-c411-4dab-8a51-8b506822dd3b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=fb15343757515697e2d0794df02690c6 2x, https://si.imgix.net/71d7fe65/uploads/origins/2ae6f466-c411-4dab-8a51-8b506822dd3b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=df7e53c67e961b5086634ab66b0c5440 3x"}, "body": "以前は悪女ベラドンナのリクエストありがとうございます。よろしければリピートお願いします。\n引き続き悪女ベラドンナでシチュですが、乳首攻め騎乗位しつつ唾液をマコちゃんの顔面に垂らし、攻めるシチュをお願いします。\n詳細\n・竿役（マコちゃん）は描かなくて良いです\n・設定は以前描かれました、足コキシチュの続きのイメージで。まだマコちゃんが勃起している状態に対し、ベラドンナが「そんな租チンのくせにまだ勃っているなんて、本当にマゾね。いいわ。妾が特別に褒美をやろう」と騎乗位を開始するイメージで\n・構図はベラドンナのみが写る一人称視点で\n・セリフもよろしければお願いします。アレンジしていただいて構いません。イメージ的には最初はベラドンナ口調で攻めるも興奮してきて妾から私口調に変化するイメージで。\n・舌を出し、顔面に唾液を垂らし「ほら、妾の唾液を飲むがいい」\n・射精＆絶頂時にイメージとしてはマコちゃんを罵倒しつつも本当は今でも好意を抱いているセリフも可能であればお願いします。「マコちゃんの事は今でも好きだけど、それより皇帝様の方が勝っただけ。だからマコちゃんは何があっても生かしておいてあげるわぁ。私のペットとして」", "nc": 32, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@ncp38220860/works/9", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 196913, "client_id": 1202629, "vtt_url": null, "thumbnail_im