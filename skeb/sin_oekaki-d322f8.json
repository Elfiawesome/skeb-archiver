jp/txiloda/picture.php?user=yutayuta&file=mana_smile.png\n\nhttps://moo-tyaunen.ssl-lolipop.jp/txiloda/picture.php?user=yutayuta&file=aa.png\n\n【使用用途】\nTRPGやオリジナルキャラのイラストを使用するゲーム等で使わせていただく予定です。\n\n【決めごと】\nイラストを使用する際は必ずお名前を掲示し\n自作発言はもちろん自己の金銭稼ぎを目的とした利用も致しません。\nAIでの改造も致しません。\n\n【要望】\n上記リンク先のオリジナルキャラクターの振り袖姿（立ち絵）をお願いします。\nポーズや細かいデザインはお任せします。\n\n背景ありなしはお任せしますが、キャラクターだけの画像をPSDでレイヤー分けしていただけると助かります。\n\nお忙しい日々を送る中で恐縮ですが、何卒よろしくお願い致します。", "nc": 24, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@sin_oekaki/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 478086, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/cc4d5c8c/uploads/origins/f45282d1-d83b-4376-ac01-d531eb0f149e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fe9cffc10e0f37a0ef58769f31416751", "srcset": "https://si.imgix.net/cc4d5c8c/uploads/origins/f45282d1-d83b-4376-ac01-d531eb0f149e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fe9cffc10e0f37a0ef58769f31416751, https://si.imgix.net/cc4d5c8c/uploads/origins/f45282d1-d83b-4376-ac01-d531eb0f149e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=5e6f957ff07f1e16e8cb853faa464438 2x, https://si.imgix.net/cc4d5c8c/uploads/origins/f45282d1-d83b-4376-ac01-d531eb0f149e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e81832a3c95b173b760f26a3b7318185 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/cc4d5c8c/uploads/origins/f45282d1-d83b-4376-ac01-d531eb0f149e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e4c2ab7361dd0c794c1e5145a0950980", "srcset": "https://si.imgix.net/cc4d5c8c/uploads/origins/f45282d1-d83b-4376-ac01-d531eb0f149e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e4c2ab7361dd0c794c1e5