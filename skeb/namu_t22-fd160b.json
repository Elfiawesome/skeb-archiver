w=200&h=200&blur=200&s=841de196308c9c290c31ab33ea7a0f88, https://si.imgix.net/2738684f/uploads/origins/0a61fb7c-a55d-4404-be8f-db06d8bbd547?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=f6f717be963a30fa45486d8afb83b2d8 2x, https://si.imgix.net/2738684f/uploads/origins/0a61fb7c-a55d-4404-be8f-db06d8bbd547?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=b85dedb6f7542a67607ef9fd93998f70 3x"}, "body": "なむ太様、初めまして\n\nリクエスト失礼します。\n\n今回はOCの 南瀬 栗（みなせ くり） ちゃんのイラストを描いてほしいです。栗ちゃんは元気で明るい子で、普通ならちょっとやりたくないことでも、楽しそうにしてしまうのが特徴なんです。そのユニークなところが出るシーンを描いていただけると嬉しいです。\n\n衣装は小学校の制服で、学校の情景を入れてほしいです。シーンは以下の2つから先生のお好みで選んでください:\n\n①先生に呼ばれて黒板で問題を解いてる場面\n\n②掃除当番してる場面\n\n構図や細かいところは全部先生にお任せします！個人的に先生の背景が大好きなので、できたら机や棚に置かれた小物とか教室の窓辺みたいな、学校らしい細かい景色や、みんなで笑ってるような温かい雰囲気を少し強調してもらえると嬉しいです。\n\nよろしくお願いします^ ^\n\nhttps://twitter.com/minase_kuri/status/1958166646805365192?s=19 https://twitter.com/minase_kuri/status/1956745258550558911?s=19 https://twitter.com/minase_kuri/status/1987189115499229689?s=19 https://twitter.com/minase_kuri/status/2012890276075872648?s=19", "nc": 153, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@namu_t22/works/16", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 871416, "client_id": 3423094, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/e1892162/uploads/origins/da91ddbb-be3c-4e9d-9673-dab80b5d6345?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=09b17a2f654cde0524005aa62b642d7c", "srcset": "https://si.imgix.net/e1892162/uploads/origins/da91ddbb-be3c-4e9d-9673-dab80b5d6345?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=09b17a2f654cde0524005aa62b642d7c, https://si.imgix.net/e1892162/uploads/origins/da91ddbb-be3c-4e9d-9673-dab80b5d6345?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=974fd977261c2ba1984da5aaaeae2bd6 2x, https://si.imgix.net/e1892162/uploads/origins/da91ddbb-be3c-4e9d-9673-dab80b5d6345?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c73a0f9cb571608cc902fda920c950e4 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/e1892162/uploads/origins/da91ddbb-be3c-4e9d-9673-dab80b5d6345?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ba1a2f70979f003e0baed06b10214319", "srcset": "https://si.imgix.net/e1892162/uploads/origins/da91ddbb-be3c-4e9d-9673-dab80b5d6345?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ba1a2f70979f003e0baed06b10214319, https://si.imgix.net/e1892162/uploads/origins/da91ddbb-be3c-4e9d-9673-dab80b5d6345?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=0d7f1efddc91574235dd1c257c048563 2x, https://si.imgix.net/e1892162/uploads/origins/da91ddbb-be3c-4e9d-9673-dab80b5d6345?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=2390d9320bf5895e8d7d467fda67dfc7 3x"}, "body": "こんにちは。あなたの画風がとても好きで、イラストを依頼したいと思っています。\n\n主人公は小学生のような外見のヴァンパイアの女の子です。銀髪で、前髪はストレートカットのショートヘア。肌は青白く、儚げで病弱な印象。うさぎのぬいぐるみを持っていて、服装はゴスロリ風にしてほしいです。\n\nその他は自由に解釈してください。\n\n私の要望を読んで検討していただき、ありがとうございました。", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@namu_t22/works/15", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 871416, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/3135d5e3/uploads/origins/f4b04836-2d0e-420d-a24a-d59d7bb59108?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=16c70e58d0f64c8d4a656e90181dafe1", "srcset": "https://si.imgix.net/3135d5e3/uploads/origins/f4b04836-2d0e-420d-a24a-d59d7bb59108?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=16c70e58d0f64c8d4a656e90181dafe1, https://si.imgix.net/3135d5e3/uploads/origins/f4b04836-2d0e-420d-a24a-d59d7bb59108?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=8e080c6fa405fe2d746e617fbb0e5637 2x, https://si.imgix.net/3135d5e3/uploads/origins/f4b04836-2d0e-420d-a24a-d59d7bb59108?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f4c6cd967d7e2b68a7bf8c34f0dda844 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/3135d5e3/uploads/origins/f4b04836-2d0e-420d-a24a-d59d7bb59108?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a60e02cf5f5e91c7769cff00d70b3315", "srcset": "https://si.imgix.net/3135d5e3/uploads/origins/f4b04836-2d0e-420d-a24a-d59d7bb59108?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a60e02cf5f5e91c7769cff00d70b3315, https://si.imgix.net/3135d5e3/uploads/origins/f4b04836-2d0e-420d-a24a-d59d7bb59108?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=4c51707485970bb8655e1793037a4a3b 2x, https://si.imgix.net/3135d5e3/uploads/origins/f4b04836-2d0e-420d-a24a-d59d7bb59108?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=ddf5a50cc7cfda8a54c841728755c610 3x"}, "body": "こんにちは。はじめまして。\nなむ太様の作品に漂うあたたかさと繊細な表現力に惹かれ、ぜひご依頼させていただきたく思い、ご連絡いたしました。\n\n描いていただきたいのは「図書館の一角で、少女が静かに語りかけてくるようなワンシーン」です。\n柔らかく静謐な雰囲気の中、視聴者と対話しているような構図をイメージしております。\n\n【キャラクター】\n・髪色：白髪～グレー系\n・年齢感：小学校高学年〜中学生くらいの、幼さと儚さを併せ持つ少女\n・表情：微笑または無表情（空虚でいて温かいような印象）\n・衣装：白を基調としたワンピース、制服(ボレロ/ワンピース制服)のどちらかですと嬉しいです。靴なしでも構いません。\n・髪型：ショート〜ボブ系で、三つ編み・ハーフアップ・まとめ髪など、世界観に合うものをアレンジしていただければ嬉しいです。\n\n【構図と背景】\n・図書館や古びた美術館のような、小さな箱庭的空間(深沢小さな美術館イメージ)\n・カウンター席のような場所に腰掛け、こちら側（視聴者）を見ているような構図(横長・サムムネイル用途)\n・大きな窓があり、外の自然の風景（木々や緑など）が少し映ると嬉しいです\n・小物（本・花瓶・ぬいぐるみ・小さなランプなど、記憶の断片のようなものを点在させて貰えると大変嬉しいです)\n\n又、もし可能でしたら昼/夜の2パターン頂けると大変嬉しいです。※もし1枚のみの制作であれば「昼」のイメージでお願いいたします。\nイメージだけ下記に記載させて頂きますので、ご検討よろしくお願いいたします。\n\n【差分A（昼の背景）】\n•外は明るく、緑の葉が風に揺れている\n•室内は柔らかな自然光\n•少女の表情はやや穏やか、微笑んでいる雰囲気\n\n【差分B（夜の背景）】\n•外は夜になっており、星がちらっと見えても可\n•窓にかかったカーテンが、風に吹かれてなびいている\n•室内はランプなどのやわらかい灯りに変化\n•少女の表情はやや静かに、少し寂しげでもOKです。\n※表情は同じでも大丈夫です。\n※カーテンのなびきやライティングで印象が変われば十分です。\n※2枚の絵は、1枚目の構図をベースに、夜の演出を加えていただく形で大丈夫です。\n\n長文となり恐縮ですが、作品の世界観に共鳴し、大切な朗読シーンの背景としてぜひお願いできればと願っております。\n何卒ご検討のほど、よろしくお願いいたします。", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@namu_t22/works/14", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 871416, "client_id": 2963352, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/03b41dec/uploads/origins/479ac9c7-3727-4ac7-adbb-8acf10394e6c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=af4a79f200f3034ec1ed83a3c79c9aec", "srcset": "https://si.imgix.net/03b41dec/uploads/origins/479ac9c7-3727-4ac7-adbb-8acf10394e6c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=af4a79f200f3034ec1ed83a3c79c9aec, https://si.imgix.net/03b41dec/uploads/origins/479ac9c7-3727-4ac7-adbb-8acf10394e6c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=4efd2214b2d3846e48cb15bc83001a5c 2x, https://si.imgix.net/03b41dec/uploads/origins/479ac9c7-3727-4ac7-adbb-8acf10394e6c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=2936a2da86ac074c8e4057f477bef8c0 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/03b41dec/uploads/origins/479ac9c7-3727-4ac7-adbb-8acf10394e6c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=81a094911b906b20e19b488d7c6b6e2b", "srcset": "https://si.imgix.net/03b41dec/uploads/origins/479ac9c7-3727-4ac7-adbb-8acf10394e6c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=81a094911b906b20e19b488d7c6b6e2b, https://si.im