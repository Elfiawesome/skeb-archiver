うな衣装を着こなして欲しいです。ゲーミングTシャツでも問題ありません。サンバでも構いません。スパンコールだらけでも構いません。(恐らくリベル様からすれば悪戯の延長線かと思われます)\n・背景までギラギラしていて欲しいです。(難しい時はキラキラエフェクトたくさんつけて欲しいです)\n\n・途中で適度に理性を失いつつ、ですが我に返らない程度の狂気をお願いいたします。", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@rokkakuu/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 27860, "client_id": 1363821, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/39899783/uploads/origins/ec86b8d6-d580-4fb5-bf07-9942f5546dde?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3e41d3f07071fb2093939f67182433ef", "srcset": "https://si.imgix.net/39899783/uploads/origins/ec86b8d6-d580-4fb5-bf07-9942f5546dde?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3e41d3f07071fb2093939f67182433ef, https://si.imgix.net/39899783/uploads/origins/ec86b8d6-d580-4fb5-bf07-9942f5546dde?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=be7caf2921557dafa6f6c9ac9dbe318b 2x, https://si.imgix.net/39899783/uploads/origins/ec86b8d6-d580-4fb5-bf07-9942f5546dde?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=52f07841e24007fde208576607c40123 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/39899783/uploads/origins/ec86b8d6-d580-4fb5-bf07-9942f5546dde?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=195b3bd6aa495f7747629e02a9eeab95", "srcset": "https://si.imgix.net/39899783/uploads/origins/ec86b8d6-d580-4fb5-bf07-9942f5546dde?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=195b3bd6aa495f7747629e02a9eeab95, https://si.imgix.net/39899783/uploads/origins/ec86b8d6-d580-4fb5-bf07-9942f5546dde?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=df8431c75e0fc94d4c9919309753f0e5 2x, https://s