a5ed85769babc", "srcset": "https://si.imgix.net/7db4dba5/uploads/origins/c1c9c3e2-2918-498b-92b9-5e268d9c9629?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=066c4a3724a98185548a5ed85769babc, https://si.imgix.net/7db4dba5/uploads/origins/c1c9c3e2-2918-498b-92b9-5e268d9c9629?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=108bbdb57bcfb1530abbd90a80002176 2x, https://si.imgix.net/7db4dba5/uploads/origins/c1c9c3e2-2918-498b-92b9-5e268d9c9629?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b94adf5b9f5c864910d5af6dc258890b 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/7db4dba5/uploads/origins/c1c9c3e2-2918-498b-92b9-5e268d9c9629?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=69eb731adaa09f2503578b0767f0cc4a", "srcset": "https://si.imgix.net/7db4dba5/uploads/origins/c1c9c3e2-2918-498b-92b9-5e268d9c9629?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=69eb731adaa09f2503578b0767f0cc4a, https://si.imgix.net/7db4dba5/uploads/origins/c1c9c3e2-2918-498b-92b9-5e268d9c9629?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=4b8009a5e4851373f2722104c5d004dc 2x, https://si.imgix.net/7db4dba5/uploads/origins/c1c9c3e2-2918-498b-92b9-5e268d9c9629?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=83777ac13afa4db0c39c6fba0acf37cc 3x"}, "body": "Esu様\n\n初めまして、個人Vtuberの星七セレネと申します。\n\nXを拝見していた際にEsu様のキラキラしたテイストの絵柄がとても好みだったのでぜひ自分を描いていただきたく…！\n条件に合いましたらぜひお願いいたします…！\n\n【使用用途】\n・SNSでの投稿\n・収益化済みのYoutubeのサムネイル\n・FANBOXなどでの壁紙配布\n・ポストカード印刷やネップリ登録\n(NG項目あれば差し戻ししてください)\n\n【依頼内容】\n星七セレネの1枚絵\n構図やポーズは書きやすいようにしていただけましたら幸いです。\nイラストのふわふわキラキラのお衣装がとても可愛かったので特にバニーちゃんとバレエコアの2人のようなかわいいお衣装お仕立て頂けましたら嬉しいです…！\nその際の色味はブルー系でお願いいたします！\n（月の女神をモチーフとしております。神秘的な雰囲気もありつつ、ポンコツで食べることが大好きな一面もあります）\n\n【お願い】\nサムネイルに使用することも念頭に置いておりますので、頭部や髪の毛、体が切れていないキャラクターのみの透過データもしくはPSDデータでいただけますでしょうか。\n可能であれば、表情、髪色髪型差分を入れていただけましたら幸いです。（難しそうであれば大丈夫です）\n※その際はお手数ですがレイヤー分けしていただけましたら大変助かります。\n\n▼参考資料▼\n・髪は白髪\n・髪飾りと耳飾り、ネックレスが似たようなデザインで後頭部に輪っかがあります（輪っかは難しければ無しでも）\n・お袖が少しシースルーになっております\n・月、星、夜空をモチーフにしております\n\n※ドライブのリンク飛べない場合はお手数ですが差戻しお願いいたします。\nhttps://x.com/hoshina_selene\n\nhttps://drive.google.com/drive/folders/1RKT9eZgwY5FYEWNLT51Sssq4rnD29m6A?usp=drive_link", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}], "sent_works": [], "similar_creators": [{"id": 1137565, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "七月", "screen_name": "uuuusatama", "avatar_url": "https://pbs.twimg.com/profile_images/1750456735268298752/jzpUpkv-.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1382566100936781825/1706250438/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 10, "complete_expiration_days": 30, "skills": [{"genre": "art"}], "banned": false, "nc": 17}, {"id": 1502952, "creator": true, "nsfw_acceptable": false, "acceptable": false, "name": "za!", "screen_name": "monogusatar", "avatar_url": "https://pbs.twimg.com/profile_images/1697102063820513280/8-twf6qS.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1422460477167136770/1693453772/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 120, "skills": [{"genre": "art"}], "banned": false, "nc": 144}, {"id": 2177354, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "うさ🍑みみ ☕️🍞⚙️", "screen_name": "usahana101", "avatar_url": "https://pbs.twimg.com/profile_images/1986768949271461888/a_1AfK9h.jpg", "header_url": "https://pbs.twimg.com/profile_bann