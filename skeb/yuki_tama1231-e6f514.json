ただけたらとても嬉しいです。\nまたサムネイルに使用したいため頭のてっぺんや髪の毛が見切れていないものも可能であれば宜しくお願い致します。\n\nご一考いただければと思います。何卒よろしくお願いします。", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@yuki_tama1231/works/4", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/6ac7c834/uploads/origins/697eca1f-9e13-4ffe-b39f-764d1af02934?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=10b39b9a6107cd08bffc81b4d539ba16", "srcset": "https://si.imgix.net/6ac7c834/uploads/origins/697eca1f-9e13-4ffe-b39f-764d1af02934?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=10b39b9a6107cd08bffc81b4d539ba16, https://si.imgix.net/6ac7c834/uploads/origins/697eca1f-9e13-4ffe-b39f-764d1af02934?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=73b985126b17d99bb548308616d448ab 2x, https://si.imgix.net/6ac7c834/uploads/origins/697eca1f-9e13-4ffe-b39f-764d1af02934?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=4333e082279a1cb5d42ec7e32c526bf6 3x"}, "private": true, "genre": "art", "tipped": false, "creator_id": 3895854, "client_id": 4037850, "nc": 1}, {"path": "/@yuki_tama1231/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3895854, "client_id": 3935185, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/beb83388/uploads/origins/ce50cfca-32a8-4f34-a9d6-2682b0406d42?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5e949ed1a801ccf9d33b23ffd633c8f5", "srcset": "https://si.imgix.net/beb83388/uploads/