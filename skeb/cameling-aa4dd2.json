-4b8e-9538-f623ada8f2b6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=86ff4e2acc766766198139d601d62086", "srcset": "https://si.imgix.net/80daab9e/uploads/origins/e358b884-4bd5-4b8e-9538-f623ada8f2b6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=86ff4e2acc766766198139d601d62086, https://si.imgix.net/80daab9e/uploads/origins/e358b884-4bd5-4b8e-9538-f623ada8f2b6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=46f2d35c00366faabf81b1cddcc454b1 2x, https://si.imgix.net/80daab9e/uploads/origins/e358b884-4bd5-4b8e-9538-f623ada8f2b6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=7265680ca87b95666d2f57f4e56dd670 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/80daab9e/uploads/origins/e358b884-4bd5-4b8e-9538-f623ada8f2b6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a8c56d2d744d6ba827f23329356b2e86", "srcset": "https://si.imgix.net/80daab9e/uploads/origins/e358b884-4bd5-4b8e-9538-f623ada8f2b6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a8c56d2d744d6ba827f23329356b2e86, https://si.imgix.net/80daab9e/uploads/origins/e358b884-4bd5-4b8e-9538-f623ada8f2b6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=ecdd529d7baee8dd56662f1857d46df0 2x, https://si.imgix.net/80daab9e/uploads/origins/e358b884-4bd5-4b8e-9538-f623ada8f2b6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=c979940058f9a899731468a94f2038ad 3x"}, "body": "先生、こんにちは！先生のイラストがとてもすきで、この度はリクエストに参りました。\n先生のドット絵の細かい描き込みと、イラストに漂う雰囲気が本当に好きです。\n\nオリジナルキャラクター「シープ」のイラストをお願いしたいです。\n\nキャラクターは「廃城の呪われた守護者」というイメージで、「美女と野獣」のようなAUコンセプトも含まれています。 \nまた、モンスター形態の参考資料は「cheep」フォルダに入っていますが、描くかどうかはお任せします。\n\nかつて「停滞」の呪いを受け、体を獣の姿へと変えられてしまいました。長い年月の中で城の外の世界の記憶を少しずつ忘れていき、城に迷い込んだ侵入者は外へ帰ることができません。守護者として、侵入者を排除する役目を担っています。 \nしかしシープ自身は知らないままですが、その呪いは「大切な誰かのために自己犠牲を選ぶこと」でのみ解けるとされています。 \n何事もない静かな夜には、城の手入れをしたり、庭で一人花冠を編んで過ごしています。 先生のご解釈で自由に描いていただけたら嬉しいです。\n\n【シープ】 \nシープは普段は落ち着いていて穏やかな性格ですが、刺激されると真剣で断固とした一面を見せます。 \n・今回は「extra costumes」と記載のある参考資料の中の、衣装 1 または 2 をご参考にしていただけますと嬉しいです。\n・身長：169cm (人間形態) \n・長くてふわふわした銀白色の髪 \n・羊の耳と角がある （人間の耳がない）\n・中性的でやや女性的な印象 \n・赤いリボンがトレードマーク（位置はどこでも大丈夫です） \n・髪型のアレンジはご自由にしていただいて大丈夫です \n\n内容不備や金額が不足している場合は、アピールをお送りください。\nデザインメモ、没ラフや下描きなどがあればPSDに残したままにしていただけると嬉しいです。 \n\nご検討いただきありがとうございます！\n\nhttps://drive.google.com/drive/folders/1_7wTl6FJONAFtQdBVHH4NZrUZuTNs3xx?usp=drive_link", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 2038291, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "鶫", "screen_name": "Goatsapple", "avatar_url": "https://pbs.twimg.com/profile_images/1391360130373931008/4c2-WOgg.jpg", "header_url": "https://pbs.twimg.com/profile_banners/2995492867/1768087962/1500x500", "appeal_receivable": true, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 3, "complete_expiration_days": 20, "skills": [{"genre": "art"}], "banned": false, "nc": 16}, {"id": 2427154, "creator": true, "nsfw_acceptable": true, "acceptable": false, "name": "えてこ@ｺﾐｹ1日目東3ヒ55b", "screen_name": "cuti_eteco", "avatar_url": "https://cdn.bsky.app/img/avatar/plain/did:plc:zecz6vypchqxhwtgx5xzx5w7/bafkreifyjithwrhtdw7p4y474gsi5j7hgyvezuuuwbyrdid4e6q7qnbrkq", "header_url": "https://cdn.bsky.app/img/banner/plain/did:plc:zecz6vypchqxhwtgx5xzx5w7/bafkreica5esyn3mt2unlec7voghye6x3dfkufja3wmm3xpzkzkcmxgblri", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "art"}], "banned": false,