を願われ、それを叶える存在\n\n──────設定ここまで─────\n\n容姿は資料URLのリンク先をご覧いただけますと幸いです。\n上記の設定以外にも伽さんがご存知のこと/解釈/主観など交えて制作していただけたらうれしいです！\n\nご制作していただいたコピー等などからイメージしたイラストを描かせていただいたり、コピーの制作者が伽さんであることを記載したうえでイラストのキャプションに使わせていただく可能性がございます。\n\n何種類制作していただくかなど指定のない部分はお任せいたします。\n\nご検討のほどよろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/1MwiZAdtl9bXMhWb6maTNnOO0RKEYv0py?usp=sharing", "nc": 0, "word_count": 860, "transcoder": "text", "creator_acceptable_same_genre": true}, {"path": "/@togi_she/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "novel", "tipped": true, "creator_id": 1223590, "client_id": 744687, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/c0251668/uploads/origins/3c82bd1d-4b02-49fe-aae3-e882e572213a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7ca523b2e169f276b388b94c785b63dc", "srcset": "https://si.imgix.net/c0251668/uploads/origins/3c82bd1d-4b02-49fe-aae3-e882e572213a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7ca523b2e169f276b388b94c785b63dc, https://si.imgix.net/c0251668/uploads/origins/3c82bd1d-4b02-49fe-aae3-e882e572213a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=137c26c3cbd8f734b6eee34d81558811 2x, https://si.imgix.net/c0251668/uploads/origins/3c82bd1d-4b02-49fe-aae3-e882e572213a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=463cfea63003a8fefa3c9dec960f8fa6 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/c0251668/uploads/origins/3c82bd1d-4b02-49fe-aae3-e882e572213a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=72807d0497935c8e70c0608d7edf2ba9", "srcset": "https://si.imgix.net/c0251668/uploads/origins/3c82bd1d-4b02-49fe-aae3-e882e572213a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=72807d0497935c8e70c0608d7edf2ba9, https://si.imgix.net/c0251668/uploads