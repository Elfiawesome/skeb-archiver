ストに惹かれました！\nぜひよろしければ、私のキャラクターをかいていただきたいです！\n\n以下リクエストです。\nファイナルファンタジー14のヴィエラです。\n彼女は戦うことも好きですが、同じくメイクをすることも好きです。\nまた、ゲームの仕様上傷跡をつけることが出来ないのですが、出来れば前髪の方の片目に傷跡をつけて欲しいです。\nポーズ等はお任せします！\n\nもし描いて頂けたら、snsのアイコン、観賞用にさせていただきたいです。\n金額、資料に不足がある場合、またご都合が合わない場合はキャンセルをお願いします。\n\nお忙しい中恐れ入りますが、何卒よろしくお願いします！\n\nhttps://drive.google.com/drive/folders/11mkeuS--XWiSiTwe_J5RrTFSkNWXFzZK", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@GmS_masa14/works/12", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1636663, "client_id": 764130, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/dd2e649a/uploads/origins/c1d971eb-70cf-4bb6-baf8-b85937c9dc3f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d777b1932058737724658c74ebf72777", "srcset": "https://si.imgix.net/dd2e649a/uploads/origins/c1d971eb-70cf-4bb6-baf8-b85937c9dc3f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d777b1932058737724658c74ebf72777, https://si.imgix.net/dd2e649a/uploads/origins/c1d971eb-70cf-4bb6-baf8-b85937c9dc3f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=3b35ff8112ba6c93e3ed616e4d7e1736 2x, https://si.imgix.net/dd2e649a/uploads/origins/c1d971eb-70cf-4bb6-baf8-b85937c9dc3f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=1bdae9200aff9d7a026d21b67902aa64 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/dd2e649a/uploads/origins/c1d971eb-70cf-4bb6-baf8-b85937c9dc3f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c4405b34b6d023db9400cd15c2e9c552", "srcset": "https://si.imgix.net/dd2e649a/uploads/origins/c1d971eb-70cf-4bb6-baf8-b85937c9dc3f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c4405b34b6d023db9400cd15c2e9c552, https://si.imgix.net/dd2e6