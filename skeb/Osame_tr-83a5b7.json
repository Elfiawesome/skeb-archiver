あるが相棒がいるときは中身は学生のままはしゃいでいる。\n\n\n\n【関係性など】\nバディネームはラテン語で灰色を意味する「グラウカ」（Glauca）。\n物心ついた頃からの幼馴染。幼小中高大警察学校現在にいたるまでを共に過ごしてきたので下手な兄弟よりも物理的距離が近い。お互いを唯一無二の相棒だと思っている。\n\n【イメージ】\nオシャレな納様の絵に合うような……、雑誌の表紙チックな、そんな2人ですと大変嬉しいです。\n\nまた、キャラクターのみの透過ファイルとそうでないものを分けていただければ幸いです。\n\n【利用用途】\n・個人観賞用\n・納様の作品であることを明示した上での自陣への共有\n・利益の生じない個人用グッズ作成\n・TRPGのセッションでの使用\n\nこの立ち絵からだと難しい部分もあるかとおもいます。お忙しい中だと思いますが、ご検討よろしくお願いいたします！\n\nhttps://drive.google.com/drive/folders/1tz4qZeU6p9qOcE_R01zY2Ow2zewAHI8Z", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@Osame_tr/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2148306, "client_id": 3774826, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/65979667/uploads/origins/7bb49656-6b35-4073-8210-850ba1233799?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=712274df972f9376c82116b138f8a1af", "srcset": "https://si.imgix.net/65979667/uploads/origins/7bb49656-6b35-4073-8210-850ba1233799?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=712274df972f9376c82116b138f8a1af, https://si.imgix.net/65979667/uploads/origins/7bb49656-6b35-4073-8210-850ba1233799?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=533e78d27971b63915b557a4f6d4463e 2x, https://si.imgix.net/65979667/uploads/origins/7bb49656-6b35-4073-8210-850ba1233799?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=10a6ff27bbca0c4ba32c9f159af60c20 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/65979667/uploads/origins/7bb49656-6b35-4073-8210-850ba1233799?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=961b24c73cc64a161249993449ab5977", "srcset": "https://si.imgix.net/65979667/uploads/origins/7bb49656-6b35-4073-8210-850ba1233799?bg=%23fff&auto=format%2Ccompress&fm=web