witter.com/mu_to0610/status/1685601324937977858?s=20", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@azarasinanoka/works/12", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1555853, "client_id": 234538, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/c95b9136/uploads/origins/21d8fb84-1f5a-4b4e-8bf3-c81a18c5e960?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=22156dd57e4f70bdfefce35c0e34203a", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/c95b9136/uploads/origins/21d8fb84-1f5a-4b4e-8bf3-c81a18c5e960?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5edbb58df764f93c494e2dc144b7fc1a", "src_set": ""}, "body": "はじめまして。たいへん好みの絵柄でしたのでリクエストさせていただきます。私のオリキャラである光希(みつき)さんをデザインしてほしいです！私は絵が描けないのでできる限り文字やフリー素材で詳細にお伝えします。特徴として、大人な雰囲気の女性で茶髪ロング(脇の下くらいまで)、サファイアブルーの眼をしています。資料左側に着せて欲しい服を載せました。帽子などは必要ありません！また胸のサイズはブルアカのノノミちゃんくらいのサイズです。同じく添付してありますが、青空の下で見返り美人(資料右下)のようなポーズでこちらに優しく微笑み、風が吹いて髪が揺れ、そこから空いた背中が見える構図でお願いします！胸も拝めたらなお最高です！描いていただくのは全身ではなく太ももくらいまでで大丈夫です。\n最後に、彼女の顔に1番近いと思ったイラストのリンクを貼りますのでご参考にしてください。\nhttps://www.pixiv.net/artworks/71712113\n\nhttps://drive.google.com/file/d/1Upuku_-8F7I6X9mVZw0FZP-qlF3IvWa6/view?usp=drivesdk", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@azarasinanoka/works/11", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1555853, "client_id": 10436, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/14bd864c/uploads/origins/43ad6bcb-88d9-4bed-aa23-755db13d7a1e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4929d85f99ddc9cf40ad5966e890146b", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls