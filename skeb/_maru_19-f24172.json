す。\n\nhttps://drive.google.com/drive/folders/12WCJkvGgYS-960EzJ1E_GaC_PqxT0KiO?usp=sharing", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@goketa_kzhr/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2713163, "client_id": 1869671, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/a18b4a63/uploads/origins/cc8cbe23-12d9-4812-a385-37bf8e709977?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4944e82fb5887e6f895f9384666f6213", "srcset": "https://si.imgix.net/a18b4a63/uploads/origins/cc8cbe23-12d9-4812-a385-37bf8e709977?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4944e82fb5887e6f895f9384666f6213, https://si.imgix.net/a18b4a63/uploads/origins/cc8cbe23-12d9-4812-a385-37bf8e709977?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=498ec3a2cb40031fd7e46ee87efd438a 2x, https://si.imgix.net/a18b4a63/uploads/origins/cc8cbe23-12d9-4812-a385-37bf8e709977?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=cb172506727f72a27e7d72de8f9072b6 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/a18b4a63/uploads/origins/cc8cbe23-12d9-4812-a385-37bf8e709977?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e058ae57fceafea17b46f8ec96cb66ea", "srcset": "https://si.imgix.net/a18b4a63/uploads/origins/cc8cbe23-12d9-4812-a385-37bf8e709977?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e058ae57fceafea17b46f8ec96cb66ea, https://si.imgix.net/a18b4a63/uploads/origins/cc8cbe23-12d9-4812-a385-37bf8e709977?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=83172d2c046128d89f03a5a46d1ff3d5 2x, https://si.imgix.net/a18b4a63/uploads/origins/cc8cbe23-12d9-4812-a385-37bf8e709977?bg=%23fff&aut