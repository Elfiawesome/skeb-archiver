loads/origins/6b2ec543-2e87-415f-aa24-3d1f42b66ff4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ba902d414274db50bcac6745a65ef950 2x, https://si.imgix.net/0c0c3c92/uploads/origins/6b2ec543-2e87-415f-aa24-3d1f42b66ff4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f4b7abc15d32d71848620f639bfe967f 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/0c0c3c92/uploads/origins/6b2ec543-2e87-415f-aa24-3d1f42b66ff4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f056a1032f875b6793e46cd80dcb4f04", "srcset": "https://si.imgix.net/0c0c3c92/uploads/origins/6b2ec543-2e87-415f-aa24-3d1f42b66ff4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f056a1032f875b6793e46cd80dcb4f04, https://si.imgix.net/0c0c3c92/uploads/origins/6b2ec543-2e87-415f-aa24-3d1f42b66ff4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=c000cdcd1477447bbad370f862b0064c 2x, https://si.imgix.net/0c0c3c92/uploads/origins/6b2ec543-2e87-415f-aa24-3d1f42b66ff4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=82543f32825eaf0ceec6306fcd3676ce 3x"}, "body": "はじめまして。kukuさんのskebの作品がとても素敵だったので、リクエスト送らせていただきました。\n\nTRPGのうちよそカップリングのイラストを描いてもらいたいです。お相手様の許可は貰っています。\n探索者①…男性、身長189cm、STR16。骨格がしっかりしていて筋肉質だけど体は細め。\nダウナーな性格で表情が乏しい。\n探索者②…男性、身長160cm、STR7。身長が低めで華奢、性差の少ない体型。\n無邪気な性格で行動的、表情豊か。\n二人とも殺し屋で、互いを守りたいと思ってます。クソデカ感情同士がガッチガチに結びついてる関係性です。\n\n探索者①が②を抱きしめてるイラストをお願いします。構図はバストアップかウエストアップで、二人の対格差を強調してほしいです。イラストのサイズはお任せします。以下、表情についての要望です。\n探索者①…あまり表情は大きく動かさないでほしいのですが、何気ない幸せとか安らぎを感じているような感じ\n探索者②…抱きしめられたことに対して素直に喜んで、無邪気に笑ったり微笑んでいたりしている\n\n服装に関しては、探索者①は白シャツに黒いフード付きの上着(ロング丈)、探索者②は白シャツにモッズコートでお願いします。添付画像を参考にしていただければと思います。\n探索者②の髪型については、添付画像の「探索者②髪型」のように下ろした状態を描いてほしいです。\n背景は、夜の落ち着いた雰囲気の部屋をお願いします。\n\n参考資料が少なくて申し訳ありません...不明確なところがありましたらkukuさんの裁量で保管していただいて構いません。こういった依頼は初めてなので至らない点もあると思いますが何卒よろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/1Pgk3cJdT5iTDIq7zYoqJUfGaxQ7XwVpY", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@kuku_org/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 977216, "client_id": 1718024, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/e1909f4a/uploads/origins/8d1c2698-4c72-42b9-a2bc-ca2504c2c31f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8b2ffc947fc76989cf907585d9b25e03", "srcset": "https://si.imgix.net/e1909f4a/uploads/origins/8d1c2698-4c72-42b9-a2bc-ca2504c2c31f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8b2ffc947fc76989cf907585d9b25e03, https://si.imgix.net/e1909f4a/uploads/origins/8d1c2698-4c72-42b9-a2bc-ca2504c2c31f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=413704f1699ec43ae67b035fee9102a2 2x, https://si.imgix.net/e1909f4a/uploads/origins/8d1c2698-4c72-42b9-a2bc-ca2504c2c31f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ecdd25f75a1342961fd03fc91288c4d1 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/e1909f4a/uploads/origins/8d1c2698-4c72-42b9-a2bc-ca2504c2c31f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=7713ce07c5032fcb7a802d227aa36c98", "srcset": "https://si.imgix.net/e1909f4a/uploads/origins/8d1c2698-4c72-42b9-a2bc-ca2504c2c31f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=7713ce07c5032fcb7a802d227aa36c98, https://si.imgix.net/e1909f4a/uploads/origins/8d1c2698-4c72-42b9-a2bc-ca2504c2c31f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=4e766638f77bcd40c6a513e918fc50c8 2x, https://si.imgix.net/e1909f4a/uploads/origins/8d1c2698-4c72-42b9-a2bc-ca2504c2