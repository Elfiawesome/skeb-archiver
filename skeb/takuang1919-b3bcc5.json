3df2a2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ebdb704fc07ac9d896b3c30db86654db 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/2a881c52/uploads/origins/910d16ee-dc1c-486f-b45e-9291dc3df2a2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a9c1ae6f11fd60f968d82bed8074f89e", "srcset": "https://si.imgix.net/2a881c52/uploads/origins/910d16ee-dc1c-486f-b45e-9291dc3df2a2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a9c1ae6f11fd60f968d82bed8074f89e, https://si.imgix.net/2a881c52/uploads/origins/910d16ee-dc1c-486f-b45e-9291dc3df2a2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=a52955248df76cb80fe4500829f7866c 2x, https://si.imgix.net/2a881c52/uploads/origins/910d16ee-dc1c-486f-b45e-9291dc3df2a2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=cbf5c0af92064b4cdd9e29e873ce5762 3x"}, "body": "オーバーウォッチのビデオゲームキャラクターのロードホッグが普通体型の男とやっているところを描いてほしい。私は体格差が大好きなので、それをとてもうまく描けていると思います。どのような体勢で描けばいいのかわからない。ロードホッグの体型を強調するような体勢を選んでいただければと思います。ロードホッグが男性を支配するのはとても簡単で、彼に多くの喜びをもたらすのです。\n\nロードホッグは全裸か、ズボンを足首に巻いてブーツを履いた状態でお願いします。でも、上半身はぜひとも裸でいてほしい。\n\n重要な特徴\n-タトゥーのある大きな丸いお腹\n-大きな胸\n-大きな筋肉質な腕（ゲームのデザインでは腕が小さすぎると思う）。\n-太い脚\n-太いチンコ（相手の中に入っていて見えないなら、それでもいい）。\n\nゲームと違って、ロードホッグはマスクなしで、短髪、口ひげで描いてほしいです。\n\nロードホッグ\n身長221cm、体重380kg、48歳。\n\nもう一人の男\n身長：179センチ 体重：125キロ 48歳", "nc": 176, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@takuang1919/works/5", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/7b1038f5/uploads/origins/ef305f8c-5f7a-41ca-8b00-d2c585dff87d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=3616b6943f99e86185214371db4d11c8", "srcset": "https://si.imgix.net/7b10