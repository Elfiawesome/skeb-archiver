92c-4ec3-bb6a-1e856ea47ee8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e33d8813b1e86baf53df341dd3fa15e2", "srcset": "https://si.imgix.net/4530073e/uploads/origins/d363a8f9-592c-4ec3-bb6a-1e856ea47ee8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e33d8813b1e86baf53df341dd3fa15e2, https://si.imgix.net/4530073e/uploads/origins/d363a8f9-592c-4ec3-bb6a-1e856ea47ee8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e0e5ec5c6d94916ac89865d07249c2fc 2x, https://si.imgix.net/4530073e/uploads/origins/d363a8f9-592c-4ec3-bb6a-1e856ea47ee8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=4e2d147251e2a96a3dab8c98d60451ba 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/4530073e/uploads/origins/d363a8f9-592c-4ec3-bb6a-1e856ea47ee8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9a16ccd60d299c05896ddeb73a69f0f7", "srcset": "https://si.imgix.net/4530073e/uploads/origins/d363a8f9-592c-4ec3-bb6a-1e856ea47ee8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9a16ccd60d299c05896ddeb73a69f0f7, https://si.imgix.net/4530073e/uploads/origins/d363a8f9-592c-4ec3-bb6a-1e856ea47ee8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=1f6e7656f65549986002b7a5a8679ef8 2x, https://si.imgix.net/4530073e/uploads/origins/d363a8f9-592c-4ec3-bb6a-1e856ea47ee8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=b543bdacc47173a252f1f0e3564107a4 3x"}, "body": "はじめまして、的場無為と申します。\npixivで拝見したシュラク隊のお姉さんたちのキュートな線と彩色のイラストがとても素敵だなと感じました。\nつきましては、元々「マブラヴ」の二次創作目的で作成した、下記小生のOCのお姉さんパイロット（衛士）をご依頼したく存じます。\n\n【キャラ】\nミチェーラ・ナストロエナヤ、ソ連軍大尉\nhttps://skeb.jp/@parayan/works/53\nhttps://skeb.jp/@tubuakiotoko/works/27\n176cm、87-57-93くらい、20代前後（実年齢は20代後半）\n肌はとっても白め、髪色は紫がかった銀髪、瞳は人形のような冷たい青です。\n前髪は左右非対称で長め、左眼側がメカクレ気味。ミディアムヘアをハーフアップでお団子にしその根もとに赤色のリボンをさげています。\n名前は「ブリザード」、姓は「調律済み」の意味です。\n\n「人工ESP発現体」という読心能力や同類との同調能力を持つ存在で、彼女は素質があった人間を調整して生み出されたタイプ、いわば強化人間です。特殊部隊の長として同じ境遇の相方と新型機開発や若い同類衛士（主にクローン生産）の育成を受け持ちつつ、たまに通常の部隊では手に余る戦闘任務を担当しています。\n実年齢は20代後半ですが、強化時に強力な抗加齢処置を施されたため、外見は20歳前後のままです。\n真面目で頭の回転が速く冷徹だが部下思いの優秀な軍人ですが、良くも悪くも物事を後に引きずらず、私も情も封印し感情を出さずに涼しい顔と人形のような瞳のまま仕事をこなすため、部下や周囲からは必要以上に畏怖されています。\n\n【衣 装】\n試97乙型衛士強化装備\n※衣装の詳細は背景素材とともに資料をまとめましたので、URLをご参照ください。\n※両こめかみの上あたりに覗くヘッドセットの髪での隠し方・隠れ方はおまかせします。\n\n【ポーズ・表情・背景】\nシュラク隊のお姉さんのような立ち絵、もしくは以前描かれていたリリアさんのようなコックピット絵をお願いします。\n表情は新人を心は優しく見守っている（でもちょっと怖い）、もしくは新人に冷静に指示を出している雰囲気で、詳細は先生にお任せします。\n背景はお値段の範囲内で良きようにお取りはからいください。\n\n長文乱筆をどうかご容赦くださいませ。\n上、ご検討何卒よろしくお願い申し上げます。\n\nhttps://www.dropbox.com/scl/fi/famtkpmjmk2icjmhtfbw5/mat20251005sai.zip?rlkey=pzk2gqrghkx75d76mpwdise64&st=ddu9fbul&dl=0", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@w_saika_w/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3765736, "client_id": 3173637, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/10d01650/uploads/origins/e9ba313b-26dc-47ee-a403-4ae47f8a9c6f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d3397c714ee06e140e0a3312ee9bc6c7", "srcset": "https://si.imgix.net/10d01650/uploads/origins/e9ba313b-26dc-47ee-a403-4ae47f8a9c6f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d3397c714ee06e140e0a3312ee9bc6c7, https://si.imgix.net/10d01650/uploads/origins/e9ba313b-26dc-47ee-a403-4ae47f8a9c6f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=9f9e168642f5caf7f5dde16b5a19662b 2x, https://si.imgix.net/10d01650/uploads/origins/e9ba313b-26dc-47ee-a403-4ae47f8a9c6f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=2465eebb5e1081a3896a8a223d8bbf11 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_url