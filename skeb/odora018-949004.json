23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=7537e63784b421ed802d509aed183a06 3x"}, "body": "こんにちは、先生！シドラップです。またお邪魔してすみません。先生の絵が大好きです。あなたのスタイルは信じられないほどユニークで、本当に大好きです！❤️\nこの二人のOCを一緒に描いていただけませんか？この双子は、創造性と新たな始まりの象徴である謎めいた数字1543と特別なつながりを共有しています。一方は \"過負荷 \"の概念を体現し、もう一方は \"新しい生命 \"を意味する。ある程度はサイバーウイルスのようなもので、感染するとぼやけたグリッチ画面が現れる。髪に黒いハイライトが入っているのが妹で、目が違う。彼らの後ろにいる \"モンスター \"も描いてください。前回のリクエストのように、私はあなたのアートワークの視覚的なインパクトをとても高く評価していますので、ダイナミックでインパクトのある構図を作るために、どんな大胆なパースでも使ってください！\nこのアートワークは個人的な使用と展示のみで、商業目的には使用しません。ご検討ありがとうございました！❤️\n\nhttps://drive.google.com/drive/folders/1w7_SSWHblqs4qZJf3tMe3jB6jN5N2Lxh", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@odora018/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 66292, "client_id": 3236640, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/b4581598/uploads/origins/9cb2f624-3b03-4aec-b9b3-6d457e620cad?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fbc4322945704911071ea5455cfffd0c", "srcset": "https://si.imgix.net/b4581598/uploads/origins/9cb2f624-3b03-4aec-b9b3-6d457e620cad?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fbc4322945704911071ea5455cfffd0c, https://si.imgix.net/b4581598/uploads/origins/9cb2f624-3b03-4aec-b9b3-6d457e620cad?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=78e5386e1fd434863a81b79fa22b1542 2x, https://si.imgix.net/b4581598/uploads/origins/9cb2f624-3b03-4aec-b9b3-6d457e620cad?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=de7050b2c05f570fff36877ca6e1f015 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/b4581598/uploads/origins/9cb2f624-3b03-4aec-b9b3-6d457e620cad?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d3