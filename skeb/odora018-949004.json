s=ca97ace3814d328fb63d1219579c1823 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/6079381e/uploads/origins/ae5cd882-dfca-4ea9-8579-baa0313a5297?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3f8172d285050ae264e3c6afe0e10957", "srcset": "https://si.imgix.net/6079381e/uploads/origins/ae5cd882-dfca-4ea9-8579-baa0313a5297?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3f8172d285050ae264e3c6afe0e10957, https://si.imgix.net/6079381e/uploads/origins/ae5cd882-dfca-4ea9-8579-baa0313a5297?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=5083f090566fbcaa89e0411ff8729a4c 2x, https://si.imgix.net/6079381e/uploads/origins/ae5cd882-dfca-4ea9-8579-baa0313a5297?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=0862b0e7b2442af85bded044bf34c59a 3x"}, "body": "こんにちは、はじめまして！\nあなたの作品はとてもクールですね！私のOCの作品をリクエストしてもいいですか？\n\n彼はテレキネシスの力を持つ引退した武将で、黙示録後の世界に住んでいます。\n浮遊するカタナを使って戦う。\n彼はよく疲れていて、タバコを吸いすぎている。\nあなたらしく描いてください。\n\nありがとうございました！\n\nhttps://drive.google.com/drive/folders/1_G7seASQXUo3QCtlVbzNwVBR7EZDJsbX?usp=sharing", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@odora018/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 66292, "client_id": 2398863, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/a072fb23/uploads/origins/960cecd3-c942-4665-bcef-1267c9dbed95?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2f519bc2d149cbe512a6fe502fc1e680", "srcset": "https://si.imgix.net/a072fb23/uploads/origins/960cecd3-c942-4665-bcef-1267c9dbed95?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2f519bc2d149cbe512a6fe502fc1e680, https://si.imgix.net/a072fb23/uploads/origins/960cecd3-c942-4665-bcef-1267