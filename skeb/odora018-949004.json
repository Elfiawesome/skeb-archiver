f4c0-48aa-85d4-0368a9e69a30?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=16ad9f8d02ad6ab7f7ffdf21464f5f57", "srcset": "https://si.imgix.net/7938b171/uploads/origins/a9c97dca-f4c0-48aa-85d4-0368a9e69a30?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=16ad9f8d02ad6ab7f7ffdf21464f5f57, https://si.imgix.net/7938b171/uploads/origins/a9c97dca-f4c0-48aa-85d4-0368a9e69a30?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b3d9dd82bd3d2899a6b400628e7cbc9d 2x, https://si.imgix.net/7938b171/uploads/origins/a9c97dca-f4c0-48aa-85d4-0368a9e69a30?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b7740631f9c18b7a1297812f9352be40 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/7938b171/uploads/origins/a9c97dca-f4c0-48aa-85d4-0368a9e69a30?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ef94b330279e1781a82d76f08083895d", "srcset": "https://si.imgix.net/7938b171/uploads/origins/a9c97dca-f4c0-48aa-85d4-0368a9e69a30?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ef94b330279e1781a82d76f08083895d, https://si.imgix.net/7938b171/uploads/origins/a9c97dca-f4c0-48aa-85d4-0368a9e69a30?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=14291e0172e614372e304ddcc20824b8 2x, https://si.imgix.net/7938b171/uploads/origins/a9c97dca-f4c0-48aa-85d4-0368a9e69a30?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=fb6b3aadbc15a7120b1a2d9d35dc6791 3x"}, "body": "こんにちは、Don先生。Twitterで先生の作品を拝見し、とても魅了されました！私のOCのイラストも「百鬼夜行」のようなテーマで描いていただけないでしょうか。\n私のOCの名前は「蓬莱カナタ」で、白い髪、白いまつげ、金色の瞳孔、首と手足には鎖がついています。彼女は不死身の天才剣士で、その恐るべき力ゆえに蓬莱山に永遠に封印されている。毎日、毎年、彼女は自分を殺してくれる人を孤独に待ち続け、「剣」としての呪われた生涯を終える。\n妖怪、地獄、曼珠沙華、紅蓮、骸骨など、日本の伝統的な神話の要素がとても好きなので、シーンの要素や構図は自由に遊んでください。ありがとうございました！\n\nhttps://drive.google.com/drive/folders