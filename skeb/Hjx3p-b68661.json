ile/d/1qXt8Grymoh-N9o_qqenFci67nQmkzegc/view?usp=drive_link", "nc": 49, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Hjx3p/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 4043695, "client_id": 26072, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/339c4e54/uploads/origins/3397e770-f067-43c8-822d-021d01e78b97?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=58ac31e7814b03d43f53ddd757e75161", "srcset": "https://si.imgix.net/339c4e54/uploads/origins/3397e770-f067-43c8-822d-021d01e78b97?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=58ac31e7814b03d43f53ddd757e75161, https://si.imgix.net/339c4e54/uploads/origins/3397e770-f067-43c8-822d-021d01e78b97?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=135810bc959bb68ffe9285f7bf48d59a 2x, https://si.imgix.net/339c4e54/uploads/origins/3397e770-f067-43c8-822d-021d01e78b97?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ded603d252d6e2c1c2a42422828be084 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/339c4e54/uploads/origins/3397e770-f067-43c8-822d-021d01e78b97?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=19a9ed3aa17f361c1fa6f24123dea672", "srcset": "https://si.imgix.net/339c4e54/uploads/origins/3397e770-f067-43c8-822d-021d01e78b97?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=19a9ed3aa17f361c1fa6f24123dea672, https://si.imgix.net/339c4e54/uploads/origins/3397e770-f067-43c8-822d-021d01e78b97?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=1541432116cc187b04ddc24b466ad25e 2x, https://si.imgix.net/339c4e54/uploads/origins/3397e770-f067-43c8-822d-021d01e78b97?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=6ce46f3310fde398a81ffbeee284f56d 3x"}, "body": "はじめまして、ポリゴンブラスト様の描かれる魅力的な人体改造系のキャラクターたちが大好きで、いつも胸を躍らせながら拝見しております。\n\n私のOCを多頭多腕多脚複乳おっぱい口の蜘蛛娘風に改造していただけないでしょうか。\n彼女は研究者だったのですが妖怪に堕ちて妖狐となったという設定です。\n研究者らしく自らの身体を改造し、さらに異形の妖怪となったといった流れを想定しています。\n\n上半身は双頭、二対の胸、二対の腕で、胸の先端や手のひらは口となっており、\n下半身にも乳房があって蜘蛛のように四対の脚があり、それぞれが腕のように先端が手になっている姿を希望しますが、\n部位が多くなってしまう場合は上半身下半身合わせて四対の腕を持つ蜘蛛娘となっていれば、頭部・胸・腕の数や口の数をご調整いただいて問題ございません。\n※逆にこれらが増える分には全く問題ありません。ポリゴンブラスト様がこちらのキャラクターから感じられるように自由に改造いただいて大丈夫です。\n\n下半身の腕は黒く光沢ある素材で覆われていたり、上半身の胸や手の口、指から蜘蛛の糸が出て相手を捕食するような姿にしていただけると大変ありがたいです。\n\n上記でご検討いただけますと幸いです。\nよろしくお願いいたします。\n\nhttps://akuochi.com/mascarorg/demonfoxmascarorg", "nc": 49, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Hjx3p/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 4043695, "client_id": 1853984, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/2b3f0523/uploads/origins/4a0fa489-4dd5-4d06-8dea-fa17c434944b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=27783d9230cdb963b3e1caa1f1085044", "srcset": "https://si.imgix.net/2b3f0523/uploads/origins/4a0fa489-4dd5-4d06-8dea-fa17c434944b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=27783d9230cdb963b3e1caa1f1085044, https://si.imgix.net/2b3f0523/uploads/origins/4a0fa489-4dd5-4d06-8dea-fa17c434944b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=511eeff59be4cc669d77c0974bd72860 2x, https://si.imgix.net/2b3f0523/uploads/origins/4a0fa489-4dd5-4d06-8dea-fa17c434944b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=3b481c5ef3acd82b6ace25b7f9c01ef0 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/2b3f0523/uploads/origins/4a0fa489-4dd5-4d06-8dea-fa17c434944b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&