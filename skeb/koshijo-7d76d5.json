39-8973-397a7eb55805?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=686b3e0a6d05cf694ef2502b0f350587", "srcset": "https://si.imgix.net/9ba7c2d9/uploads/origins/012ff807-1b83-4439-8973-397a7eb55805?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=686b3e0a6d05cf694ef2502b0f350587, https://si.imgix.net/9ba7c2d9/uploads/origins/012ff807-1b83-4439-8973-397a7eb55805?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=e2e5ec9e70c242f675970bdbc67fc8f1 2x, https://si.imgix.net/9ba7c2d9/uploads/origins/012ff807-1b83-4439-8973-397a7eb55805?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=99be40930332f2adc1ba9c261949548d 3x"}, "body": "こんにちは。私はあなたのアートワークが大好きで、あなたが私のVtuberを描いてくれることを望んでいます。\n\n絵の中のクリスマスの服を着て、手にはクリスマスプレゼントを持っていて欲しいです。設定としては、参考写真のような感じでお願いします。背景はクリスマスのイルミネーションや場所など、ぼやけた感じで。  目を開けて笑っている、幸せそうな表情が希望です。ポーズはおまかせします。\n\nトレードマークの牡牛座と赤と金のリボンも忘れないでください。\n\nまた、SNSでの配信に使用するので、1920x1080でレイヤー分けしてほしいです。\n\n\n本当にありがとうございました。\n\n参考リンク：https://drive.google.com/drive/folders/1Pd5_aNC2rW5U0_zlhVJixQScLfsv9mXk?usp=sharing", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@koshijo/works/17", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2120390, "client_id": 1443446, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/722ae789/uploads/origins/04a2c192-77eb-4489-8ce1-c03bcbc5a6ab?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1d7ca10426626b69a27a5ef2eb06e6ea", "srcset": "https://si.imgix.net/722ae789/uploads/origins/04a2c192-77eb-4489-8ce1-c03bcbc5a6ab?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1d7ca10426626b69a27a5ef2eb06e6ea, https://si.imgix.net/722ae789/uploads/origins/04a2c192-77eb-4489-8ce1-c03bcbc5a6ab?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=cro