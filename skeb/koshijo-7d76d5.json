nd I’d like to request another illustration!\n\nI would like to request an illustration of my Vtuber holding a camcorder (https://imgur.com/a/DknWARF) and wearing a winter school uniform.\n\nPose and details are all up to you!  I’d love if a background could be included\n\nPlease make the illustration in a 16:9 aspect ratio.\nI would like to use this for Twitch/Twitter/Youtube, and for a possible song cover if that is okay! Please separate the signature layer.\nThank you!\n\nhttps://imgur.com/a/kqYVSwd", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@koshijo/works/19", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2120390, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/d6e5ffdd/uploads/origins/792d0bff-c13d-4a41-9f3d-56a94c33356f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b4a77bf95dc28adc7a430aa9e835f288", "srcset": "https://si.imgix.net/d6e5ffdd/uploads/origins/792d0bff-c13d-4a41-9f3d-56a94c33356f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b4a77bf95dc28adc7a430aa9e835f288, https://si.imgix.net/d6e5ffdd/uploads/origins/792d0bff-c13d-4a41-9f3d-56a94c33356f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=3712cffbffddd56b3c9e6c309767e692 2x, https://si.imgix.net/d6e5ffdd/uploads/origins/792d0bff-c13d-4a41-9f3d-56a94c33356f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=45176cc5fbb43de50b828afedde5d0b7 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/d6e5ffdd/uploads/origins/792d0bff-c13d-4a41-9f3d-56a94c33356f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=42b3610a88ac87655ada22a24a63112f", "srcset": "https://si.imgix.net/d6e5ffdd/uploads/origins/792d0bff-c13d-4a41-9f3d-56a94c33356f?bg=%23fff&auto=format%2Cco