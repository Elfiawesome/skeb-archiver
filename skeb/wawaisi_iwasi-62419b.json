h=200&s=433dc402457062cd2f597a35fdb2a785 2x, https://si.imgix.net/045ecb7e/uploads/origins/62063d59-8d4e-4db9-8cb5-a3ba062d2d3a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b9faad133d461da515a45a97c04000a9 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/045ecb7e/uploads/origins/62063d59-8d4e-4db9-8cb5-a3ba062d2d3a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=31e4f4c66e46e09aec8d77a7e808031a", "srcset": "https://si.imgix.net/045ecb7e/uploads/origins/62063d59-8d4e-4db9-8cb5-a3ba062d2d3a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=31e4f4c66e46e09aec8d77a7e808031a, https://si.imgix.net/045ecb7e/uploads/origins/62063d59-8d4e-4db9-8cb5-a3ba062d2d3a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=d5356672891479693fa95c3dfeb52fc4 2x, https://si.imgix.net/045ecb7e/uploads/origins/62063d59-8d4e-4db9-8cb5-a3ba062d2d3a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=d9b082b856aca565e64c8159db2bef62 3x"}, "body": "はじめまして、こんばんは！\nYouTubeで配信活動をしている月鈴(つきすず)と申します✨お見かけしたこちら(https://x.com/wawaisi_iwasi/status/1999060098338177484?s=46&t=Ra37aUDpju56eVlBSc4dCw)がとっても素敵だったのでリクエストを送らせていただきます🙇🏻‍♀️✨\n\n◎描いて頂きたいイラスト\n今回は私 月鈴のイラストを描いていただきたいです。座ってるような感じ(お送りしたイラストみたいに椅子はなくて大丈夫です！)で、眼鏡をかけて真剣な顔で考え込んでいて作業を頑張っているようなシーンに使えるイラストをお願いしたいです！お洋服はオリジナルでもデフォのものでもどちらでも大丈夫です！髪型は何種類かありますのでお好きなものでお願いできればと思います✨\n表情差分(忙しくてあわあわしてる感じや微笑んでいるものなど)もあるとありがたいですがもちろんなくても大丈夫です🙇🏻‍♀️\n\n月鈴は月夜にふらっとこちらの世界に遊びに来た女の子で、配信は夜が多く、安心する、眠たくなる落ち着く声と言ってもらえることが多いです。基本的には落ち着いているけど、好奇心は旺盛で、はしゃぐときははしゃぐ！という性格です。アイドルが大好きでステージ上ではアイドルを目指してます！青髪・黄色の瞳・ちょっとタレ目･月下美人が特徴になります。オコジョのような相棒がいるのですが今回はいなくても構いません。\n\n◎使用用途\n配信時のサムネイルやXでのポスト、アイコン等に使用させていただきたいと思っております。(文字を入れたり、ちょっとしたなじませ加工やトリミングをする可能性があります。)頭が切れないように描いていただけると嬉しいです。可能であれば、リスナーさんへ特典(ヘッダーや待受、ネットプリント、ブロマイドなど)として配布、グッズ化をしたいと考えております。難しい場合は使用しませんのでご記載ください🙇🏻‍♀️\n人物と相棒と背景を別(PSDまたは透過png)でいただけると嬉しいです🙇🏻‍♀️\n\nご縁がありましたらよろしくお願いいたします！\n\nLitLink\nhttps://t.co/OAbfX5mb7o\n\nYouTube\nyoutube.be/@tsukisuzu_\n\nhttps://drive.google.com/drive/folders/1ePWXMIY5rLq8dqinfBg9TvN7O6J6HecL", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@wawaisi_iwasi/works/12", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/e90cf71e/uploads/origins/a8eaec85-95cc-4a79-95f5-2f9d7980350d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=3af6c94f9b53fa74ba6a1fb56dfe5a03", "srcset": "https://si.imgix.net/e90cf71e/uploads/origins/a8eaec85-95cc-4a79-95f5-2f9d7980350d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=3af6c94f9b53fa74ba6a1fb56dfe5a03, https://si.imgix.net/e90cf71e/uploads/origins/a8eaec85-95cc-4a79-95f5-2f9d7980350d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=b40fb85fcfe1daa5fd3aff21e6c94618 2x, https://si.imgix.net/e90cf71e/uploads/origins/a8eaec85-95cc-4a79-95f5-2f9d7980350d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=a86b68372c3fda82be741a942416cd18 3x"}, "private": true, "genre": "art", "tipped": false, "creator_id": 3571006, "client_id": 3074119, "nc": 128}, {"path": "/@wawaisi_iwasi/works/11", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3571006, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/c869558d/uploads/origins/09f280ef-b035-41b4-889b-6757ae5fad14?bg=%23fff&auto=format%2Ccompress&fm=webp&f