。\n\n◎一つ要望を付け加えるなら『10year　anniversary』を隅っこに書いてもらえると嬉しいです。\n\n設定だけ細かく、ほぼ丸投げに近い形での依頼となってしまい申し訳ありませんが何卒よろしくお願いします。", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 1180907, "creator": true, "nsfw_acceptable": false, "acceptable": false, "name": "ととそな〜", "screen_name": "rn_9j", "avatar_url": "https://cdn.bsky.app/img/avatar/plain/did:plc:tuhcmppynkwcu4vtdi64kbk3/bafkreibexwy4tafphfk5otha54njp62y4qjyzrerqzhkq6626ysyk4e2qi", "header_url": "https://cdn.bsky.app/img/banner/plain/did:plc:tuhcmppynkwcu4vtdi64kbk3/bafkreidqzc44tj3qae5wya5sbwbkzsed6i2smlh6nanf5mcaooxv3nqvxe", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "none", "accept_expiration_days": 30, "complete_expiration_days": 90, "skills": [{"genre": "art"}], "banned": false, "nc": 145}, {"id": 1223698, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "きくち", "screen_name": "kkc919", "avatar_url": "https://pbs.twimg.com/profile_images/1112576433354731520/E6wrMiPP.png", "header_url": "https://pbs.twimg.com/profile_banners/69552791/1512407766/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "art"}, {"genre": "correction"}], "banned": false, "nc": 17}, {"id": 1314046, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "ゆれ", "screen_name": "mr_ayarabbit", "avatar_url": "https://pbs.twimg.com/profile_images/1663553167748104194/ibT862Ug.jpg", "header_url": null, "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 7, "complete_expiration_days": 