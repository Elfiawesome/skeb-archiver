bf842/uploads/origins/90f9572a-c39d-4986-8f32-98cb49183a88?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=df57bd12b0c612f7f8d56cc582483b04", "srcset": "https://si.imgix.net/a45bf842/uploads/origins/90f9572a-c39d-4986-8f32-98cb49183a88?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=df57bd12b0c612f7f8d56cc582483b04, https://si.imgix.net/a45bf842/uploads/origins/90f9572a-c39d-4986-8f32-98cb49183a88?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=9968bd915e4c6f42435bd60e6654c460 2x, https://si.imgix.net/a45bf842/uploads/origins/90f9572a-c39d-4986-8f32-98cb49183a88?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=17eb0b183cc03a322dbd006d555c8718 3x"}, "body": "私のアヒル娘エレインが水没タンクで、彼氏ロクシーに水没させられている。https://postimg.cc/DS59Wg77 https://postimg.cc/hQ9wK8CW https://postimg.cc/TKks23cw https://postimg.cc/GBVSYgVn https://postimg.cc/jLcgvSmX https://postimg.cc/ZWqfQhhh  1 彼女は水槽の上に座り、足の裏を突き出して. 視聴者を嫌味たっぷりに挑発している. 例：https://postimg.cc/N5BSqL14）2. ロキシーはターゲットに当てようとしてボールを投げ、成功しました。3 彼女は空中で落下中、足の裏を突き出し、焦点となっている（例：https://postimg.cc/VJS34p9X）4 彼女の体が水中に沈み、大きな水しぶきが上がる。足の裏を水槽のガラスに押し付けている（例：https://postimg.cc/4YC5k0k3）エレインはびしょ濡れで息を切らしながら水面から現れる。ロクシーが近づき、二人はキスを交わす。次にロクシーは水上のボードに座ろうと身構える。\n\nエレイン（帽子なし） https://postimg.cc/xq2q3fKq\nロキシー（水着姿）https://postimg.cc/1gF5D2Xp", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@kugiwo/works/15", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 99836, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/96c63989/uploads/origins/1a51cc38-0839-420c-82c1-efa670eba887?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=79468f30460c7351b0aa6aec669b4224", "srcset": "https://si.imgix.net/96c63989/uploads/origins/1a51cc38-0839-420c-82c1-efa670eba887?bg=%23fff&auto=format%2C