m7?usp=sharing  \n\n\n もしよろしければ、2 人の日常の中で密接な接触の暖かい瞬間を描いていただきたいです。\n\nこれは現代日本（架空）を舞台にした物語です。  \n\nもしお好きな衣装がなければ、2 人の OC の衣装は自由に描いていただいて構いません。 構図は全て先生にお任せします。先生のお絵はいつもとても美しいです\n\n【使用用途】 個人観賞 / 壁紙等としての個人的な使用 \n\nもし金額が足りないようでしたら、お手数ですが指定の後再送要請を送っていただけると嬉しいです。  \n\nお読みいただき、誠にありがとうございます\n\nhttps://drive.google.com/drive/folders/1NC8iKGU6mPZYGgKvJU8C8eFEsSDl8bm7?usp=sharing", "nc": 136, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@natusitagemu/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3727085, "client_id": 3504392, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/ab153641/uploads/origins/92fe3463-1a9a-42c7-ac42-5d49187274f3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d62f6387fea0b59dcfbc3262d14d3379", "srcset": "https://si.imgix.net/ab153641/uploads/origins/92fe3463-1a9a-42c7-ac42-5d49187274f3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d62f6387fea0b59dcfbc3262d14d3379, https://si.imgix.net/ab153641/uploads/origins/92fe3463-1a9a-42c7-ac42-5d49187274f3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ac83c03853b3cf41019a755b98d51043 2x, https://si.imgix.net/ab153641/uploads/origins/92fe3463-1a9a-42c7-ac42-5d49187274f3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c3766554581b36c4efa5e58cc957b0f5 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/ab153641/uploads/origins/92fe3463-1a9a-42c7-ac42-5d49187274f3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=8d28863df2264bfd5a888700caf2a38e", "srcset": "https://si.imgix.net/ab153641/uploads/origins/92fe3463-1a9a-42c7-ac42-5d49187274f3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=8d28863df2264bfd5a888700caf2a38e, https://si.imgix.net/