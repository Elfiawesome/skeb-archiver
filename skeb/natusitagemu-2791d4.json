の日の街並み、または暖かい部屋に座っているシーン\n\n構図やシチュエーションなどは、すべてお任せいたします。\nもし可能でしたら、新しい衣装デザインで描いていただけますと幸いです。\n\n私のお願いを読んでくださりありがとうございます。毎日が楽しい日々になりますように！\n\nhttps://drive.google.com/drive/folders/1--N9AUMa--dRPzpC7u9LEehV4-Ey6Snl", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@natusitagemu/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3727085, "client_id": 3142642, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/811a7404/uploads/origins/ba01c82b-cd07-4900-8c18-0256de6540d6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5021f55c758cd96703ededa74c894d53", "srcset": "https://si.imgix.net/811a7404/uploads/origins/ba01c82b-cd07-4900-8c18-0256de6540d6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5021f55c758cd96703ededa74c894d53, https://si.imgix.net/811a7404/uploads/origins/ba01c82b-cd07-4900-8c18-0256de6540d6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c22c2a87b1cfb3f1a473883ac8898414 2x, https://si.imgix.net/811a7404/uploads/origins/ba01c82b-cd07-4900-8c18-0256de6540d6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=dbc0d16930b45c8edb54790ac68858c2 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/811a7404/uploads/origins/ba01c82b-cd07-4900-8c18-0256de6540d6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e53af26d726084ea84df13dd9b0cfb7a", "srcset": "https://si.imgix.net/811a7404/uploads/origins/ba01c82b-cd07-4900-8c18-0256de6540d6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e53af26d726084ea84df13dd9b0cfb7a, https://si.imgix.net/811a7404/uploads/origins/ba01c82b-cd07-4900-8c18-0256de6540d6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=3ba5a36