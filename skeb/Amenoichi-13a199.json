3fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=cb689fd9b383889fd7061d22ed066ad7, https://si.imgix.net/c957d983/uploads/origins/962ddb01-3cb4-4af0-9748-892afa845508?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=560e5763288ee63a52a18de62d522cf3 2x, https://si.imgix.net/c957d983/uploads/origins/962ddb01-3cb4-4af0-9748-892afa845508?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=49569d3bdfe9631f2fbf4a7008dc63f6 3x"}, "body": "こんにちは、あなたの作品が大好きです！私のキャラクター、クラウディアをモチーフにしたイラストをぜひお願いしたいです。\n\nデザインに関するメモ：\n- クラウディアの瞳は緑色で、下部が茶色です。\n- 頬にはそばかすがあります。\n- 彼女はいつも手袋をしており、手のひらは赤いです。\n\n性格について：\n- 彼女は並外れた能力を持つ外傷外科医で、患者の命を救うことに非常に長けています。\n- 神のような存在だと自負しており、自分の能力を過大評価していますが、自尊心は脆く、すぐに圧倒されたり動揺したりしてしまいます。また、怒りっぽいところもあります。\n- 孤独や孤立感を頻繁に感じる。一人になると非常に悲しく憂鬱な気分になり、ひどい見捨てられ不安を抱えている。\n- 物事を考えすぎてしまう傾向が強い。\n\n「手に付いた血」（比喩的または文字通りの意味）を強調してほしい。\n\n彼女を連想させるイメージのアイデア：ひまわり、針やメス、内臓、手、オオカミに追われる羊、的、十字架\n\nhttps://toyhou.se/29159299.claudia-de-la-cruz", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Amenoichi/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 4037608, "client_id": 1699682, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/bab7286b/uploads/origins/a4d1be48-cfa7-4a82-9c81-5cd73ae7eb15?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=806b2d814b8f8e25a9a675c73e1d41d2", "srcset": "https://si.imgix.net/bab7286b/uploads/origins/a4d1be48-cfa7-4a82-9c81-5cd73ae7eb15?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=806b2d814b8f8e25a9a675c73e1d41d2, https://si.imgix.net/bab7286b/uploads/origins/a4d1be48-cfa7-4a82-9c81-5cd73ae7eb15?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a067b0db89875acff5489fd00e29834d 2x, https://si.imgix.net/bab7286b/uploads/origins/a4d1be48-cfa7-4a82-9c81-5cd73ae7eb15?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f17de68ad3d869693835ca0c1ab16e07 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/bab7286b/uploads/origins/a4d1be48-cfa7-4a82-9c81-5cd73ae7eb15?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ef6436ea412673253eee6e32589a9e62", "srcset": "https://si.imgix.net/bab7286b/uploads/origins/a4d1be48-cfa7-4a82-9c81-5cd73ae7eb15?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ef6436ea412673253eee6e32589a9e62, https://si.imgix.net/bab7286b/uploads/origins/a4d1be48-cfa7-4a82-9c81-5cd73ae7eb15?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=3c8c025154f22d8b506f86b1215ab0bd 2x, https://si.imgix.net/bab7286b/uploads/origins/a4d1be48-cfa7-4a82-9c81-5cd73ae7eb15?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=f49fe3022352b0e89c99d5b01d7f4eaf 3x"}, "body": "こんにちは。先ほどあなたの過去の作品を見ましたが、その画風や配色がとても気に入りました！もしよろしければ、私のオリジナルキャラクター（OC）のイラストを依頼させていただけないでしょうか 🙏\n\n彼の名前は「ティキ」で、私のオリジナルストーリーのメインアンタゴニストです。不死身で、時間を操る力を持っています。少しサイコパスなところがあり、相手が自分の望む答えを出すまで、同じ会話や状況をタイムループに閉じ込めてしまうのが好きです。 \n\n20代後半（おそらく26～27歳）で、ブロンドの髪をしています。常に腕時計を身につけ、スーツを着用しています。表情はとても傲慢で、たいてい他人を見下すような目つきをしています。\n\nオンライン上のオリジナルキャラクターのプロフィール画像や、個人的な名刺（販売用ではありません）として使用したいと考えています。\n\nポーズや服装は自由に創作していただいて構いません。必要であれば、遠慮なく再度リクエストを送ってください。本当にありがとうございます！\n\nhttps://drive.google.com/drive/folders/13NjZ4Ditx1wpyBmKWmZTHgF4fCQerexT", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Amenoichi/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 4037608, "client_id": 2811733, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/68749d3e/uploads/origins/0ecba708-070c-475a-967d-eddd21bb2855?bg=%23fff&auto=format%2Cc