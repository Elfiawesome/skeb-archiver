 [{"path": "/@elfk_live/works/79", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 32285, "client_id": 983410, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/75054277/uploads/origins/ce712ca7-fae2-431c-a76b-883782def92f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3ffb2e5a4d6ca766f1c1a22e60e2413a", "srcset": "https://si.imgix.net/75054277/uploads/origins/ce712ca7-fae2-431c-a76b-883782def92f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3ffb2e5a4d6ca766f1c1a22e60e2413a, https://si.imgix.net/75054277/uploads/origins/ce712ca7-fae2-431c-a76b-883782def92f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=fdf9a12210dfdddded98c62b540532d8 2x, https://si.imgix.net/75054277/uploads/origins/ce712ca7-fae2-431c-a76b-883782def92f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=bb153971a070b5be0b7473befa5382bb 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/75054277/uploads/origins/ce712ca7-fae2-431c-a76b-883782def92f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=96f84fc9b3ecd9f7529868f097a14bc4", "srcset": "https://si.imgix.net/75054277/uploads/origins/ce712ca7-fae2-431c-a76b-883782def92f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=96f84fc9b3ecd9f7529868f097a14bc4, https://si.imgix.net/75054277/uploads/origins/ce712ca7-fae2-431c-a76b-883782def92f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=9a319761a00c69235d068bb1162f0a9a 2x, https://si.imgix.net/75054277/uploads/origins/ce712ca7-fae2-431c-a76b-883782def92f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=61b28335fd3bafcecee63709bbb888f3 3x"}, "body": "前回はぱにぽにキャラをありがとうございました。色塗りの勉強させてもらっています。\n今回は響け！ユーフォニアムの田中あすかをお願いします。\n服装は全裸に眼鏡とタイツのみで局部の部分だけ破いて空いていて首に「便女係」の札を下げている状態でおねがいします。\n場所は洋式トイレの上で、ポーズは背中を便座の蓋にもたれつつ局部を突き出して座っていて、腕は開いてダブルピース、足はたたんで足裏が見えてるポーズでお願いします。\n表情は目にハートマークを浮かべる笑顔でお願いします。\n\n胸のサイズは非常に大きく、ピンク色で乳輪は巨大で陥没乳首でピアスをしていて、片方の乳首は引っ込んでいて、もう片方は引っ張り出されている状態でお願いします。\n股間はピンク色で剛毛で立体的に立つほど濃くて、アナル周辺までびっしりでお願いします。テープでくぱぁしている状態で可能であればへその方まで生えてると嬉しいです。\nまた腋毛もびっしり生やしてほしいです。\n\n差分１はチンカスびっしりちんぽを見てよだれを垂らして舌をペロっとしている表情でお願いします。\n差分２は口と局部にちんぽを突っ込まれて射精させられてアヘ顔になっているもので、鼻から精液が飛び出してるのと、口の周りに陰毛とチンカスがついていると嬉しいです。ちんぽは竿と玉のと毛がある周辺部分だけ浮いてるものでお願いします。\n\n可能な範囲で以下の要素の差分があると嬉しいです\n・使用済みコンドームを頭や胸、足などにたくさん乗せられている\n・局部の液体の染みが広がった破く前のタイツ\n・局部と乳首が黒ずんでいる\n・マンカスが大量についている\n\n今回もラフとレイヤー統合しない状態のPSDファイルが欲しいです。また修正は線修正でお願いします。細部の変更はしてもらってもかまいません。以上の内容を可能な範囲で検討お願いします。", "nc": 176, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@elfk_live/works/67", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 32285, "client_id": 983410, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/aa5ef0df/uploads/origins/456b4e59-d7c0-4ebb-b0f6-9ddd7e6517e5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=055ff9b74fe4d570395e7804f125cdbb", "srcset": "https://si.imgix.net/aa5ef0df/uploads/origins/456b4e59-d7c0-4ebb-b0f6-9ddd7e6517e5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=055ff9b74fe4d570395e7804f125cdbb, https://si.imgix.net/aa5ef0df/uploads/origins/456b4e59-d7c0-4ebb-b0f6-9ddd7e6517e5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=471a2b7c5e805be1c3a56591f2514a8b 2x, https://si.imgix.net/aa5ef0df/uploads/origins/456b4e59-d7c0-4ebb-b0f6-9ddd7e6517e5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=25240dcc7905e4c4f755719ba60a1f6a 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/aa5ef0df/uploads/origins/456b4e59-d7c0-4ebb-b0f6-9ddd7e6517e5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=cae626ef25b3e094bb58b9a1fcbb9a18", "srcset": "https://si.imgix.net/aa5ef0df/uploads/origins/456b4e59-d7c0-4ebb-b0f6-9ddd7e6517e5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=cae626ef25b3e094bb58b9a1fcbb9a18, https://si.imgix.net/aa5ef0df/uploads/origins/456b4e59-d7c0-4ebb-b0f6-9ddd7e6517e5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=139c02f05c39a35ef685b7b9ed7e3a3e 2x, https://si.imgix.net/aa5ef0df/uploads/origins/456b4e59-d7c0-4ebb-b0f6-9ddd7e6517e5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=e2d9985bf5d0e17f3abfd9804201d04e 3x"}, "body": "以前のぱにぽにの二人の依頼ありがとうございました。イラスト製作の参考にさせていただいてます。\n今回もぱにぽにの玲ちゃんとベッキーの二人でお願いします。\n\nふたりの体形は前回の依頼と同じ体形でお願いします。二人とも裸です。玲ちゃんは巨乳輪で腋毛、陰毛、アナル周辺まで超剛毛でお願いします。ベッキーは普段のおろした髪型でお願いします。\nテーマは玲ちゃんの肉厚の局部についた恥垢をベッキーがクンニで掃除するというものでお願いします。\n\n１：https://i.imgur.com/fRbNzLq.png\n玲ちゃんは椅子に座った状態で背もたれにもたれかかりながら腋の下を見せて開脚をしています。それをベッキーがくぱぁして広げています。玲ちゃんの局部は「(2021年5月) イラスト ボンバーガール パイン おっぴろげ」のときの色と肉感でおねがいします。ここにマンカスがびっしりついてる状態でお願いします。アナルは中身が飛び出さずぽっかりと広がっていると嬉しいです。セリフはだいたい画像のとおりにつけていただけるといいです。\n\n２：https://i.imgur.com/QjnBvrg.png\n玲ちゃんがアヘ顔になります。またふたりが汗をかきかじめます。ベッキーの顔と舌には玲ちゃんの陰毛と恥垢がくっついてきます。このとき玲ちゃんのおっぱいから母乳が吹き出てくるとうれしいです。\n\n３：https://i.imgur.com/FC2yEXK.png\n最後は玲ちゃんが絶頂して果てています。おっぱいからは母乳が垂れている状態でお願いします。玲ちゃんが潮を吹いてベッキーの顔にかかります。ベッキーは満足そうに顔と口の中を恥垢と陰毛だらけにしながら笑顔で終わります。\n\nキャラのポーズや位置、セリフなどは画像の通りでなく、描きやすいものであれば変更されてもかまいません。余裕があれば、擬音や液体等の追加も可能な範囲でお願いします。\nよろしければ修正はモザイク修正と線修正の二通りでお願いします。また、前回同様、絵の勉強のためレイヤーの統合はせず、できるかぎりそのままでお願いします。ご検討のほどよろしくお願いします。", "nc": 48, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@elfk_live/works/54", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 32285, "client_id": 983410, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/5838a565/uploads/origins/3eaebd04-aacc-413f-9e10-f86005e2cc2e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=50553f6ea49d31b0d70e573c9898113d", "srcset": "https://si.imgix.net/5838a565/uploads/origins/3eaebd04-aacc-413f-9e10-f86005e2cc2e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=50553f6ea49d31b0d70e573c9898113d, https://si.imgix.net/5838a565/uploads/origins/3eaebd04-aacc-413f-9e10-f86005e2cc2e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f17fec86dbd20c23028937675ace0b08 2x, https://si.imgix.net/5838a565/uploads/origins/3eaebd04-aacc-413f-9e10-f86005e2cc2e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f4449ea825259ed676367640de8eb8cf 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/5838a565/uploads/origins/3eaebd04-aacc-413f-9e10-f86005e2cc2e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=38bce9c8e3c7fbb92fa1ef07e2b3b1e3", "srcset": "https://si.imgix.net/5838a565/uploads/origins/3eaebd04-aacc-413f-9e10-f86005e2cc2e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=38bce9c8e3c7fbb92fa1ef07e2b3b1e3, https://si.imgix.net/5838a565/uploads/origins/3eaebd04-aacc-413f-9e10-f86005e2cc2e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=1f0422866bd6e6cf61d2d94fa9a5395c 2x, https://si.imgix.net/5838a565/uploads/origins/3eaebd04-aacc-413f-9e10-f86005e2cc2e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=265ebfcbaf2e8d6931509a83f9b02e31 3x"}, "body": "初めてのリクエストお願いします。\n\n【キャラ】\nぱにぽにの「橘玲」と「レベッカ宮本」の二人をお願いします。\n二人とも髪型と服装はぱにぽにだっしゅ２６話の水着でお願いします、全裸差分があると嬉しいです。\n\n橘玲→おっぱいは大きく、乳輪はぷっくりとしていて、乳輪は大きく、乳首は少し大きいくらいでお願いします。乳輪は水着からはみ出しているほうが嬉しいです。おっぱいと乳輪の境目ははっきりとさせずぼやかしてうっすらぶつぶつがある感じが良いです。腋毛と陰毛は剛毛で汗とまん汁が多く出ている感じでお願いします。\n\nレベッカ宮本→ムダ毛はなく、全身つるつるでお願いします。子供体形で貧乳ですが、乳輪は少し大きめでお願いします。\n\n乳首の色はベッキーが薄ピンク、玲はそれより少し赤みがかったくらいでお願いします。全身の汗やまん汁はすこし多めでお願いします。\n\n【内容】\n二人は以下の画像のようにお願いします\nhttps://i.imgur.com/UkaJrCb.png\n二人とも顔を赤らめながらの笑顔で、玲がわき見せ陰部見せ、ベッキーが陰部見せでどちらも手のピースで開いていてほしいです。ベッキーが玲のふとももに乗っかる感じでお願いします。カメラ目線でお願いします。\nベッキーの右腕の位置は思いつかなかったので、玲の左手首に右手を添えたりしてくださってもかまいません。\n細かい体形やポーズなどはすべてお任せします。\n\n以下いくつかの参考画像\nhttps://i.imgur.com/achV6wt.png\nhttps://i.imgur.com/MEuhSHS.png\nhttps://i.imgur.com/nbyDJto.png\n\n【要望】\n背景はグラデーションでもベッドの上でも何でもいいです。\n余裕があれば玲は制服、レベッカ宮本は普段の先生の時の薄緑のワイシャツと赤ネクタイ黒スカートの時の差分をお願いします。\nelf.k氏の絵を学びたいため、ラフやレイヤーの影、ハイライトなどのすべてのレイヤーを統合をしていないＰＳＤファイルをいただきたいです。どうかよろしくお願いします。\n\nhttps://i.imgur.com/UkaJrCb.png", "nc": 169, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}], "similar_creators": [{"id": 83615, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "HUUG/ skeb comms open", "screen_name": "Huug_illust", "avatar_url": "https://pbs.twimg.com/profile_images/1729912642633134085/oUHUYGxF.jpg", "header_url": "https://pbs.twimg.com/profile_banners/740732755131006976/1718934126/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "art"}, {"genre": "comic"}, {"genre": "voice"}, {"genre": "correction"}], "banned": false, "nc": 33}, {"id": 97666, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "すばるつしると🔞", "screen_name": "subarutsuchinp", "avatar_url": "https://pbs.twimg.com/profile_images/1635005971457261568/damLD8uw.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1083043741072388098/1610976585/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "art