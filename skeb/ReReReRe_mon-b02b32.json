めましてこんにちは、Vtuberやってますいるまかずはと申します\nReモンさんのイラストがとても素敵に感じましたのでぜひ依頼したいと思い、リクエストさせていただきます。\nキャラクター\n・入間かずは\n描いていただきたいイラスト内容\n・全身イラスト\n・衣装「冬」コーデ\n・簡易背景\n・ポーズはおまかせします\n資料詳細はURLにて参照お願いします\n出力はPNGもしくはPSD出力でお願いします\nYoutube、Twitterその他の活動で使用させていただきたい為、背景ありと背景透過イラストでお願いします\n↓資料URL\nhttps://drive.google.com/file/d/1zsgEZTrRNQkuiURCUlW8f2q5kggPcAov/view?usp=sharing", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@ReReReRe_mon/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2082520, "client_id": 1343098, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/dccbd335/uploads/origins/51bffd9e-4e8d-49b8-9d1e-e9a4baeede41?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d89722996ebf22c280319712d221605a", "srcset": "https://si.imgix.net/dccbd335/uploads/origins/51bffd9e-4e8d-49b8-9d1e-e9a4baeede41?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d89722996ebf22c280319712d221605a, https://si.imgix.net/dccbd335/uploads/origins/51bffd9e-4e8d-49b8-9d1e-e9a4baeede41?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=7b2a5a0035b3186048158ac5c7f85922 2x, https://si.imgix.net/dccbd335/uploads/origins/51bffd9e-4e8d-49b8-9d1e-e9a4baeede41?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=5f8d91a4fbc6d80a0161de25eb5d61ab 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/dccbd335/uploads/origins/51bffd9e-4e8d-49b8-9d1e-e9a4baeede41?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5cb5324efdabe86aeea031c658cb6830", "srcset": "https://si.imgix.net/dccbd335/uploads/origins/51bffd9e-4e8d-49b8-9d1e-e9a4baeede41?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5cb5324efdabe86aeea031c658cb6830, https://si.imgix.net/dccbd335/uploads/o