_id": 2328145, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/e8041cda/uploads/origins/98bf30f0-2e96-4d7b-bfc6-da3571e2f360?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=70803b63aa5eb55af8a2b23708692b22", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/e8041cda/uploads/origins/98bf30f0-2e96-4d7b-bfc6-da3571e2f360?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c698c60cf765202d6e5e42fd5b26703a", "src_set": ""}, "body": "こんにちは、伽藍です。\nあなたのアピールを見て、私のオリジナルキャラクターのイラストを描いていただけたら光栄です！\n\nファッション誌のようなイラストを描かれるとのことですが、私は賀蘭さんのイラストの大ファンなので、ぜひお願いします。\n\n服装は、使ってもいいし、変えてもいいし、デザインしてもいい。要するに、私はあなたに完全な自由を与えるということだ。\n\n彼女の性格がちょっと不安定なのは、もうお察しの通りだから、きっとうまく表現できると思うよ！\n\nご丁寧にありがとうございました！\n\nhttps://drive.google.com/drive/u/1/folders/1MwwbmFGwytS5yYOLpKwn3o_yAK1_G7gW", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Garan0502/works/125", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1477472, "client_id": 3492229, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/041856d6/uploads/origins/edd3ff75-8651-4f07-8326-d5e9e51dc56a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9d204de171422c60d67a8f545f3b0d8f", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/041856d6/uploads/origins/edd3ff75-8651-4f07-8326-d5e9e51dc56a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0515293506d4135032365fd3018c9eab", "src_set": ""}, "body": "こんにちは、あなたの魅力と作品を拝見し、ぜひ依頼したいと思いました。あなたの雑誌の絵は壮大でユニークなので、私もお願いしたいと思います。\n\n私のデザインは普通です：\n\n* 青いロングヘア\n* ♦️ 形の瞳孔を持つグレーの目（ライトグレーではない）\n* 明るい肌色\n* 160~163cm\n* 普段はヘッドフォンかヘッドアクセサリーをつけている。\n* 首に首輪。\n\n私のogのために新しい服と髪型を望んでいるので、服をデザインするためにあなたにいくつかのアイデアを