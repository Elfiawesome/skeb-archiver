のカラーがクリーム色、目が黒っぽい赤\n参考画像はこちらでご確認いただけますと幸いです。↓ (Googleドライブに参考画像をまとめております。)\nhttps://drive.google.com/drive/folders/1K1SYDbl3mGqzinj54YXR7sQljwrz7H9k?usp=share_link\n\n上記の内容でお受けいただけるようでしたらよろしくお願い致します。", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@hinorinr/works/9", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2761518, "client_id": 2179785, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/dae96b9e/uploads/origins/fbfdf089-62b6-44cc-bf7b-b43b8e666530?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bbb29e6ff724dc8549d56583886caa06", "srcset": "https://si.imgix.net/dae96b9e/uploads/origins/fbfdf089-62b6-44cc-bf7b-b43b8e666530?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bbb29e6ff724dc8549d56583886caa06, https://si.imgix.net/dae96b9e/uploads/origins/fbfdf089-62b6-44cc-bf7b-b43b8e666530?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a7eed5a35c11e5900b792a4cbb364291 2x, https://si.imgix.net/dae96b9e/uploads/origins/fbfdf089-62b6-44cc-bf7b-b43b8e666530?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=6e16e0a0395f40a62fe8cbc24fef3676 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/dae96b9e/uploads/origins/fbfdf089-62b6-44cc-bf7b-b43b8e666530?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6382f57d8f6198d6f963a5e6698db857", "srcset": "https://si.imgix.net/dae96b9e/uploads/origins/fbfdf089-62b6-44cc-bf7b-b43b8e666530?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6382f57d8f6198d6f963a5e6698db857, https://si.imgix.net/dae96b9e/uploads/origins/fbfdf089-62b6-44cc-bf7b-b43b8e666530?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=d79aec9898cfff398534d70471