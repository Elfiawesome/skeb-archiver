&s=ac11bfd5cb148fd411d213104821c494", "srcset": "https://si.imgix.net/2dc2e254/uploads/origins/07f0140a-b28a-4b21-8378-64a4fcd7a4eb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ac11bfd5cb148fd411d213104821c494, https://si.imgix.net/2dc2e254/uploads/origins/07f0140a-b28a-4b21-8378-64a4fcd7a4eb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=0ccb928ae7d342c5dd33dcbbe1bf9f2e 2x, https://si.imgix.net/2dc2e254/uploads/origins/07f0140a-b28a-4b21-8378-64a4fcd7a4eb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=afde04ea60c545158aff1213cdd3a277 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/2dc2e254/uploads/origins/07f0140a-b28a-4b21-8378-64a4fcd7a4eb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b32275083115cf72829cdd756ca4bf29", "srcset": "https://si.imgix.net/2dc2e254/uploads/origins/07f0140a-b28a-4b21-8378-64a4fcd7a4eb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b32275083115cf72829cdd756ca4bf29, https://si.imgix.net/2dc2e254/uploads/origins/07f0140a-b28a-4b21-8378-64a4fcd7a4eb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=e72a57ed2ecd6d7fa83858ca43b3e384 2x, https://si.imgix.net/2dc2e254/uploads/origins/07f0140a-b28a-4b21-8378-64a4fcd7a4eb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=0269db9d0000017b197c7275ec53caa7 3x"}, "body": "自分は依頼募集はしているのですが、依頼を受けたことがありません。\nやはり「イラスト業界での経験がない」ことと「寡作」なのがいけないのでしょうか。\n\n自分でも、TRPGをやっていますが、シナリオ/イラストとも筆が遅いので\nものを作っていても楽しくないなあと思うことが多いです。\n\nあと、TRPGは海外の作品を遊ぶことが多いですが\n海外のものは日本と絵柄が違います。\n海外の絵柄が好きな人からは「萌え絵は吐き気がする」と言われてしまい\nやむなくコミュニティを離れたことがあります。\n\n自分がゲームマスターをやる卓で、全てのプレイヤーキャラクターの立ち絵を描くのが\n夢ですが、毎週毎日やりたい、だから絵は借り物やAIで適当・・・という人が多いです。\n描くのが間に合わなかったり、描いても受け入れられないことが多いです。\n\nまず、楽しく描くためにはどうしたらいいでしょうか？\nそれからファンがいればいいですが、ファンを作るためにはどうしたらいいでしょうか？\n\n同じような質問を自分より楽しんでいる人にするのですが、\n「普通にやってるだけ」「わからない」\n「自分が楽しめることしかしない」という人が多く、\n自分が楽しむためであれば、TRPGのプレイグループから、\n人をはね子にする人もいます。\n何度かされたこともあるので、\nそんなわがままな人が人気なのか・・・と思ってしまいます。\n\nどうしたらいいでしょうか。\n\nhttps://twitter.com/aoiguircheoikk", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 195323, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "みなべゆうり", "screen_name": "minabe_6711", "avatar_url": "https://pbs.twimg.com/profile_images/1984388632426487808/0oQoc1dr.jpg", "header_url": "https://pbs.twimg.com/profile_banners/808206945848938496/1777117064/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "art"}], "banned": false, "nc": 144}, {"id": 508646, "creator": true, "nsfw_acceptable": true, "acceptable": false, "name": "snuq@SKEB/ACTx6", "screen_name": "nonorenew", "avatar_url": "https://pbs.twimg.com/profile_images/1615717476104560640/5hqkL5Q_.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1218418223357427712/1667391458/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "art"}, {"genre": "correction"}], "banned": false, "nc": 32}, {"id": 2496364, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "Enchel🐾お仕事募集中", "screen_name": "Enchel", "avatar_url": "https://pbs.twimg.com/profile_images/2014153220793458688/m88EMZAR.jpg", "header_url": "https://pbs.twimg.com/profile_banners/15274865/1755776841/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": nul