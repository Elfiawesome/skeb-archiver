12YQ7wIcfkc1hz-IikXr0DNkAyHsIFX0M?usp=drive_link\n\n現在ラフ段階のみなのですが、ここからの大きな変更はございませんので、参考資料としていただけると幸いです。\n髪の毛は長い方でお願い致します。\nポーズなど指定ございませんので、雑魚様の描きやすいように描いていただきたいです。\n\n\nもし不備や金額不足等ございましたらキャンセルまたは再送依頼をしていただけますと幸いです。\nご検討よろしくお願いいたします。", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@shiniz0konai/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3477003, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/05c367c7/uploads/origins/90ec8c13-918c-444b-b42a-72182f38c1ab?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7d0908cf961f5d21a4fd58235249f19a", "srcset": "https://si.imgix.net/05c367c7/uploads/origins/90ec8c13-918c-444b-b42a-72182f38c1ab?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7d0908cf961f5d21a4fd58235249f19a, https://si.imgix.net/05c367c7/uploads/origins/90ec8c13-918c-444b-b42a-72182f38c1ab?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=abde3537ed05f1a0a3d6f639e1f74a32 2x, https://si.imgix.net/05c367c7/uploads/origins/90ec8c13-918c-444b-b42a-72182f38c1ab?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c5314048ecbed1edf19c294069de7e5a 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/05c367c7/uploads/origins/90ec8c13-918c-444b-b42a-72182f38c1ab?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ac6c8ba15b8c0987694e0b275077471e", "srcset": "https://si.imgix.net/05c367c7/uploads/origins/90ec8c13-918c-444b-b42a-72182f38c1ab?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ac6c8ba15b8c0987694e0b275077471e, https://si.imgix.net/05c367c7/uploads/origins/90ec8c13-918c-444b-b42a-72182f38c1ab?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=b1ac84cdac