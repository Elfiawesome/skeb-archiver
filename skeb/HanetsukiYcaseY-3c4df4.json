首責め\n\nよろしければご検討頂けると幸いです\nまた、完成品は他に依頼を行う時等に資料として引用する事をご了承ください\n\nhttps://drive.google.com/drive/folders/1A8NzXu3Ysi1dhrQNAGhLLCbHEezCsjFB?usp=sharing", "nc": 161, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@HanetsukiYcaseY/works/10", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3094043, "client_id": 3206594, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/0c3eaa44/uploads/origins/68c19cde-58d9-455f-a892-e3bad659c0c5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3e3f0952d53d06aacfe0d12d548e50a0", "srcset": "https://si.imgix.net/0c3eaa44/uploads/origins/68c19cde-58d9-455f-a892-e3bad659c0c5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3e3f0952d53d06aacfe0d12d548e50a0, https://si.imgix.net/0c3eaa44/uploads/origins/68c19cde-58d9-455f-a892-e3bad659c0c5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=11d06eb1bbe5275bc15dcdc8a7f7bded 2x, https://si.imgix.net/0c3eaa44/uploads/origins/68c19cde-58d9-455f-a892-e3bad659c0c5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=0389b64ccaffc880589260d3726dff74 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/0c3eaa44/uploads/origins/68c19cde-58d9-455f-a892-e3bad659c0c5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d94b65348e3b7713f5e8037bc86f7b43", "srcset": "https://si.imgix.net/0c3eaa44/uploads/origins/68c19cde-58d9-455f-a892-e3bad659c0c5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d94b65348e3b7713f5e8037bc86f7b43, https://si.imgix.net/0c3eaa44/uploads/origins/68c19cde-58d9-455f-a892-e3bad659c0c5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=a4a2e6c41b5e6c87a32f4c5c26f113f4 2x, https://si.imgix.net/0c3eaa44/uploads/origins/68c19cde-58d9-455f-a892-e3bad659c0c5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=93573058779753520e092f0a6d875629 3x"}, "body": "先日は素晴らしいイラストをありがとうございました。手数料無料期間中なのでもう一度リクエストを送らせてください。\n\n今回はマブラヴガールズガーデンよりドロテアを描いてほしいです。\nシチュエーションは篁唯依の衛士強化装備をAIによって複製に成功しドロテアが着ることになった、その際に再現度の高さに感心している唯依に後ろから触られて驚く、といった感じにしてください。（唯依がどこあたりを触るのかはお任せします。）\n構図は前回のリュシーとステラのイラストと同じ構図にしてください。\nドロテアの髪型は通常の髪型と別衣装の髪型の2種類あるのですが、こちらはハネツキさんの好みにお任せします。\nまた唯依の衣装も唯の衛士強化装備にしてください。\n\nご検討をお願いします\n\nhttps://drive.google.com/drive/folders/1LcmPf2abVtdvKSVTcSaRlMhv04Bc_uGs?usp=sharing", "nc": 33, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@HanetsukiYcaseY/works/9", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3094043, "client_id": 2100, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/c1d2102f/uploads/origins/503149c2-b945-4fae-8e3f-d20001572602?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4738a35c89ba326a35c4bde71eec4e0c", "srcset": "https://si.imgix.net/c1d2102f/uploads/origins/503149c2-b945-4fae-8e3f-d20001572602?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4738a35c89ba326a35c4bde71eec4e0c, https://si.imgix.net/c1d2102f/uploads/origins/503149c2-b945-4fae-8e3f-d20001572602?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b313782694cd7eaa0eedede09dd29bfe 2x, https://si.imgix.net/c1d2102f/uploads/origins/503149c2-b945-4fae-8e3f-d20001572602?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=cdbeff8372560d31827c06bf4709e24e 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/c1d2102f/uploads/origins/503149c2-b945-4fae-8e3f-d20001572602?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6367b463ed30469bb25182aaa7510fde", "srcset": "https://si.imgix.net/c1d2102f/uploads/origins/503149c2-b945-4fae-8e3f-d20001572602?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6367b463ed30469bb25182aaa7510fde, https://si.imgix.net/c1d2102f/uploads/origins/503149c2-b945-4fae-8e3f-d20001572602?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=8b55d9d441f0ecc178e389b1fc1dfb8f 2x, https://si.imgix.net/c1d2102f/uploads/origins/503149c2-b945-4fae-8e3f-d20001572602?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=aec4f3f7cfd605cb3606cd470b5d2cfc 3x"}, "body": "初依頼失礼します\n知り合いのオリキャラの少女とうちのキャラの組み合わせで描いて頂きたいです\n作者側から諸々の許諾は得ておりますのでご心配なく\n参考資料をドライブに用意しておきました\n\n【内容】\n下記二人の組み合わせで夜のお誘い　またはパイズリ(NSFWがどこまでOKか分からないのでどうするかはお任せします)\n女の子側の衣装はフレンチメイド　ないしそれ以上にエロいデザインのメイド服\n勇気を出して女の子側から誘ってる体　パイズリであればぎこちないながらも頑張ってご奉仕してる感じ\nサインや台詞がある場合はレイヤー等でオンオフ切り替えができると幸いです\n\n【要素・要点】\n・二人は互いにちょっと不器用な義理の親子関係(義理親子なので血の繋がりはない)\n・互いに互いを悪く思ってはないのでそういう関係になっても不思議ではない距離感\n\n娘側\n・表情変化の乏しい控えめでしおらしい性格の少女\n・身長は138cm\n・体つきは全体的に細っこいが着痩せする方で胸だけは割とある(過度な巨乳とかの領域ではない、ちゃんと挟めるぐらい)\n・大人ぶった振る舞いだが精神年齢は相応に低く、根っこはまだまだ子供\n・心の奥では親に甘えたがり、気付かない内に動きに出る\n・親と一緒にいられる事は嬉しい\n・黒い勾玉の首飾りを基本的に肌身離さず大切にしている(特に重要)\n・過去のトラウマから性行為に対して苦手意識あり\n・苦手意識はあるが、快楽耐性はかなり低い\n・大切な人がいなくなる事もトラウマのため手を繋いだりする事を好む\n・ブルアカのキキョウ等のような「一人にしないで」と縋るようなしっとりとした空気感の執着あり\n\n親側\n・やや中性的な激情家の男性\n・身長は175cm\n・体つきは割と筋肉質でがっしりしている\n・典型的な不器用親だが頑張って親らしく接そうとする\n・甘えた分だけ甘やかす過保護気味な親馬鹿\n・娘には基本優しい\n・相手がトラウマ持ちなのは理解しているので行為にはとても慎重\n・男性側の描写量は参考資料程度の顔が見えない範疇、極論完全に別人のような体色でもない限りほぼ見切れていてOK\n\nあれば嬉しい\n・事後の蕩けた表情や事後に頭を撫でたり\n\nよろしければご検討頂けると幸いです\nまた、完成品は他に依頼を行う時等に資料として引用する事をご了承ください\n\nhttps://drive.google.com/drive/folders/1Cyocy1cHeT0s6aQhT7wBjAH1J2ZQ1sIl?usp=sharing", "nc": 160, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@HanetsukiYcaseY/works/8", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/27524514/uploads/origins/e5c2fcbf-19f6-4c3a-a3cd-62f913753e36?bg=%2