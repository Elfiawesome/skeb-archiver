そうとする\n・甘えた分だけ甘やかす過保護気味な親馬鹿\n・娘には基本優しい\n・相手がトラウマ持ちなのは理解しているので行為にはとても慎重\n・男性側の描写量は参考資料程度の顔が見えない範疇、極論完全に別人のような体色でもない限りほぼ見切れていてOK\n\nあれば嬉しい\n・事後の蕩けた表情や事後に頭を撫でたり\n\nよろしければご検討頂けると幸いです\nまた、完成品は他に依頼を行う時等に資料として引用する事をご了承ください\n\nhttps://drive.google.com/drive/folders/1Cyocy1cHeT0s6aQhT7wBjAH1J2ZQ1sIl?usp=sharing", "nc": 49, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@HanetsukiYcaseY/works/8", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/27524514/uploads/origins/e5c2fcbf-19f6-4c3a-a3cd-62f913753e36?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=363c625933aa9c525ae93fafc22fd54e", "srcset": "https://si.imgix.net/27524514/uploads/origins/e5c2fcbf-19f6-4c3a-a3cd-62f913753e36?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=363c625933aa9c525ae93fafc22fd54e, https://si.imgix.net/27524514/uploads/origins/e5c2fcbf-19f6-4c3a-a3cd-62f913753e36?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=7ca83fb42ee87c4e1bc81315868ee399 2x, https://si.imgix.net/27524514/uploads/origins/e5c2fcbf-19f6-4c3a-a3cd-62f913753e36?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=bac761e3900a4e375613f56173482b0b 3x"}, "private": true, "genre": "art", "tipped": true, "creator_id": 3094043, "client_id": 81995, "nc": 48}, {"path": "/@HanetsukiYcaseY/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3094043, "client_id": 1246184, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/4055ef5f/uploads