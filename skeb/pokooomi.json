可能であれば)\nPSD、背景とレイヤー分けしていただけたら嬉しいです。\n\nお忙しい所恐縮ですが、よろしくお願いいたします。\n\n<別衣装>\nhttps://drive.google.com/file/d/1NQxFcapHaf_tENjBH1PiqSSoLsPCi8Nd/view?usp=sharing\n\nhttps://drive.google.com/file/d/1TnYdeAFGENBcFbDSc05U-kMu-p7ejJZr/view?usp=sharing\n\nhttps://twitter.com/xkakyux/status/1615157267523063808?s=20&t=aOGOX4o4shDgtbjYwq2fdA", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@pokooomi/works/68", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1275220, "client_id": 2877125, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/fe3ff982/uploads/origins/b31d2ea8-7ed6-4167-bfb5-4a1332b5f8e2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3410b2ccb3524ad512308d234f77a544", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/fe3ff982/uploads/origins/b31d2ea8-7ed6-4167-bfb5-4a1332b5f8e2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3b29e4aaebf83cf746b379bee2d422fe", "src_set": ""}, "body": "ぽんぽこみ様、はじめまして。\n\nアピールありがとうございます。ぜひ、リクエストさせてください。\n私がVRCで使用しているアバターをお願いします。\n構図、表情等はお任せいたします。\n衣装についても、資料から自由に選んでいただいて構いません。\n新しい髪型の方で描いていただけると嬉しいです。\n\nよろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/1SN8muPSsYmrPZRQ_7aCJAXVOeoR3ddro?usp=sharing", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@pokooomi/works/67", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1275220, "client_id": 1094212, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/787ca58c/uploads/origins/73374c61-02e9-4415-9a3b-a13ec4b4b096?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=30a82e1c8af5d8daf234b02449fe5ee6", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbn