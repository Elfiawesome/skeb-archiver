88f/uploads/origins/148b4530-c77a-462e-8dd2-765a3acb7460?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=df185f80f4777f71ecc083893117b899 3x"}, "body": "こんにちは！  あなたの作品が大好きです！\n\n私のオオカミ少女ナタネの絵をお願いしたいです。\n彼女は忍者として敵の城に忍び込む。\n彼女は誤って罠を仕掛けてしまい、ガスが噴射され、胸が巨大化し、体よりも大きくなり、その場に閉じ込められてしまいます。\nナタネの胸からは大量の母乳が吹き出し、彼女は恍惚とした表情を浮かべ、前の任務など忘れてしまうはずだ。\n胸は好きなだけ大きく描いてください！\nその他はお任せします。\n\nよろしくお願いします。\n\nhttps://drive.google.com/drive/folders/13Vb9PnzH5vwt-EDFPDpCYGu4ANAckomm?usp=drive_link", "nc": 48, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@maximumuchi813/works/9", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3489639, "client_id": 182552, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/92ef6470/uploads/origins/bce62ff9-09c5-4cdc-ba92-cadd3af5c53a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=73dfa06e338278b4605324ee160f7cfc", "srcset": "https://si.imgix.net/92ef6470/uploads/origins/bce62ff9-09c5-4cdc-ba92-cadd3af5c53a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=73dfa06e338278b4605324ee160f7cfc, https://si.imgix.net/92ef6470/uploads/origins/bce62ff9-09c5-4cdc-ba92-cadd3af5c53a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=37602fc1d2d9d6e90e545f846216a26f 2x, https://si.imgix.net/92ef6470/uploads/origins/bce62ff9-09c5-4cdc-ba92-cadd3af5c53a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=881a8d94d9d90b25b46becd385ea11a8 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/92ef6470/uploads/origins/bce62ff9-09c5-4cdc-ba92-cadd3af5c53a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=1f8a070a901e157d5195cbb27e5a2a10", "srcset": "https://si.imgix.net/92ef6470/uploads/origins/bce62ff9-09c5-4cdc-ba92-cadd3af5c53a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=1f8a070a901e157d5195cbb27e5a2a10, https://si.imgix.net/92ef6470/uploads/origins/bce62ff9-09c5-4cdc-ba92-cadd3af5c53a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=4f53bc21649375530f4ac2a8de68c394 2x, https://si.imgix.net/92ef6470/uploads/origins/bce62ff9-09c5-4cdc-ba92-cadd3af5c53a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=7cffa4c3069df5d45cf2f51c5ffa8b6f 3x"}, "body": "初めまして。\n『怪盗ワリオ・ザ・セブン』というゲームに出てくるマルゲリータさんが、牛コスに変身するイラストをお願いします。\nシチュエーションとしては、\n①変身前で、普通の体型のマルゲリータさんが眼鏡を外してみせる。\n②変身が始まり、彼女のおっぱいがぶるんと膨らみ、着ているドレスが破ける。\n③ムチムチの体型へ変化すると同時に、まるで魔法少女の変身シーンの様に光の粒子が集まって、コスチュームが形成されていく。\n④光っていたコスチュームが牛コス(＋ティアラ付き)に切り替わって変身完了。グラマラスでエッチな姿になったマルゲリータさんは可愛らしくウインクをしてみせる。\nまた、更によろしければ、④の時にビキニを貫通して母乳を勢いよく放水している差分もお願いしたいです。\n\n以上、ご検討頂けると幸いです。\n\n資料URL\n\nhttps://drive.google.com/drive/folders/1m-TpFtP6BLyGlc2uuOZYtJeTwINLJLCp?usp=sharing", "nc": 32, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@maximumuchi813/works/8", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3489639, "client_id": 2901468, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/732bab5e/uploads/origins/4833869d-b12e-4e27-b73d-8bf5b017b421?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=205acf6bf17f7c86f8579f6f98985c33", "srcset": "https://si.imgix.net/732bab5e/uploads/origins/4833869d-b12e-4e27-b73d-8bf5b017b421?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=205acf6bf17f7c86f8579f6f98985c33, https://si.imgix.net/732bab5e/uploads/origins/4833869d-b12e-4e27-b73d-8bf5b017b421?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=155eeb5a954d3cf1bb8158e676e2d95d 2x, https://si.imgix.net/732bab5e/uploads/origins/4833869d-b12e-4e27-b73d-8bf5b017b421?bg=%23fff&au