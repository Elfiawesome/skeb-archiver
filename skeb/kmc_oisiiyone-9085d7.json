uto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=061d4306bfe67f11a81a1f26f295d394 2x, https://si.imgix.net/85c80b0a/uploads/origins/13de6eae-1008-4c4d-aef2-f1281fcc4410?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=26fc47f05894e107ac19b1dd2be2ac97 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/85c80b0a/uploads/origins/13de6eae-1008-4c4d-aef2-f1281fcc4410?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=76da1835db62087c23a6ea0b483ffddd", "srcset": "https://si.imgix.net/85c80b0a/uploads/origins/13de6eae-1008-4c4d-aef2-f1281fcc4410?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=76da1835db62087c23a6ea0b483ffddd, https://si.imgix.net/85c80b0a/uploads/origins/13de6eae-1008-4c4d-aef2-f1281fcc4410?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=e0b6fa1f4094e7564d5307033e74d0bd 2x, https://si.imgix.net/85c80b0a/uploads/origins/13de6eae-1008-4c4d-aef2-f1281fcc4410?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=0016b193aaa3d5c565dd6e1c1b12d79c 3x"}, "body": "raiqlaさま\n\nこんにちは、はじめまして！む と申します🌷\nTLでとっても素敵な作品を拝見し、アカウントまで飛んで直近のものはほとんど全ての作品を見てしまうくらいに刺さりました💉\nパキパキした色使いによって引き立つキラキラの世界観がすごく好みで、出会えて本当に良かったです😭\n\nぜひraiqla様の描かれる世界観の一員にうちのOCも混ざりたいと感じ、この度リクエスト失礼致します🙌🏻\n\n以下内容\n\n背景や描写範囲について\n⇒完全おまかせでお願い致します！どんなものでもraiqla様の描かれる世界観なら素敵に仕上がると思っておりますので、ぜひ筆の赴くままにご自由にお描きください！\n\n顔周りの特徴について\n⇒まろ眉、八重歯、瞳孔が雪の結晶の形\n⇒髪型:腰までのロングストレート(フロスティブルー)\nヘアアレンジ等はいくらでも大歓迎です◎\n前髪と横髪に白メッシュが入っております\n\n服装・小物について\n⇒簡易にはなりますが資料がございます。資料からお選びいただいても構いませんし、アレンジを加えて頂いたり、新しく自由にデザインしてくださっても構いません！\n⇒アザラシの前髪ピン、雪の結晶飾りのリボン髪飾り、ピアス、ネイルと手の甲に雪の結晶と指輪の装飾、首元に天使の羽チョーカーなど大変多岐に渡っておりますので、ご自由に省いてくださっても、また別のアクセサリーなどにアレンジして頂いてもかまいません！\n\n特にNG等はございませんので、お好きに描いていただければと思います！ご予算や納期、資料の不備等がありましたら、お手数をお掛け致しますが、1度棄却して頂ければ幸いです！\n\nどうぞ素敵なご縁がありましたらよろしくお願い致します✨️✨️\n\nhttps://www.dropbox.com/scl/fo/csunmc1ao1ke5khgvoe3h/AAmm5Fg7--LuQ3ubDrDnpxY?rlkey=g96twfhh4rocfvd330lgukttq&st=b0dh037f&dl=0", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@kmc_oisiiyone/works/13", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3892839, "client_id": 3135849, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/38a00b92/uploads/origins/4bf4dbda-8990-4d42-ad62-6ae54ee7baf6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=48c0201e23fc45ebabed21547ce18bc6", "srcset": "https://si.imgix.net/38a00b92/uploads/origins/4bf4dbda-8990-4d42-ad62-6ae54ee7baf6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=48c0201e23fc45ebabed21547ce18bc6, https://si.imgix.net/38a00b92/uploads/origins/4bf4dbda-8990-4d42-ad62-6ae54ee7baf6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=1fe5902d073ef952c26e62aef35e9622 2x, https://si.imgix.net/38a00b92/uploads/origins/4bf4dbda-8990-4d42-ad62-6ae54ee7baf6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d0e3d20553da9e76b8faac7abfa7a2c3 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/38a00b92/uploads/origins/4bf4dbda-8990-4d42-ad62-6ae54ee7baf6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=17da33fbd1dedbd746f824278c368568", "srcset": "https://si.imgix.net/38a00b92/uploads/origins/4bf4dbda-8990-4d42-ad62-6ae54ee7baf6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=17da33fbd1dedbd746f824278c368568, https://si.imgix.net/38a00b92/uploads/origins/4bf4dbda-8990-4d42-ad62-6ae54ee7baf6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=b9cea895fbd2c21a4f49005ca509d96b 2x, https://si.imgix.net/38a00b92/uploads/origins/4bf4dbda-8990-4d42-ad62-6ae5