細かいディテールについては一任いたしますので、スピーディキックちゃんの魅力の表現にお力添えお願いします！\n\n☆納品形式\n宛名を別レイヤーとしたものとしていただけるとありがたいです。psd形式でも問題ありません。\n\n☆使用用途\n個人鑑賞目的のほか、別の方に同キャライラストを依頼する場合の参考資料としても使用させていただきたいです。\n\nリクエスト内容としては以上です。御縁があれば嬉しいです！\n\nhttps://www.dropbox.com/scl/fo/rc4xu9qgh1zah4xwqusep/h?rlkey=e0d05hx7qonp49n2o7rorz148&dl=0", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@Yu_Hydra0319/works/13", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 345802, "client_id": 852952, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/4383197c/uploads/origins/432a8cc8-482f-49b2-8248-e27d522344ba?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d1be579beda8cb2ec7dac0015ae06db7", "srcset": "https://si.imgix.net/4383197c/uploads/origins/432a8cc8-482f-49b2-8248-e27d522344ba?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d1be579beda8cb2ec7dac0015ae06db7, https://si.imgix.net/4383197c/uploads/origins/432a8cc8-482f-49b2-8248-e27d522344ba?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=d92717f8c4e080a733cf3f024f23fbef 2x, https://si.imgix.net/4383197c/uploads/origins/432a8cc8-482f-49b2-8248-e27d522344ba?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=06a8444bd34e2fa86d9eeb8eecc3b890 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/4383197c/uploads/origins/432a8cc8-482f-49b2-8248-e27d522344ba?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d47eeaa26f913c67adb817c28e4463fd", "srcset": "https://si.imgix.net/4383197c/uploads/origins/432a8cc8-482f-49b2-8248-e27d522344ba?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d47eeaa26f913c67adb817c28e4463fd, https://si.imgix.net/4383197c/uploads/origins/432a8cc8-482f-49b2-8248-e27d522344ba?bg=%23fff&a