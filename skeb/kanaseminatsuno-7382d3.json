36c04/uploads/origins/2b0fbd3e-56f9-45aa-9715-c6ae7f574e99?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0ac7d95aaef45b63e86e533549be5092", "srcset": "https://si.imgix.net/60c36c04/uploads/origins/2b0fbd3e-56f9-45aa-9715-c6ae7f574e99?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0ac7d95aaef45b63e86e533549be5092, https://si.imgix.net/60c36c04/uploads/origins/2b0fbd3e-56f9-45aa-9715-c6ae7f574e99?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b7361d4ff46286e56507367a76eadc66 2x, https://si.imgix.net/60c36c04/uploads/origins/2b0fbd3e-56f9-45aa-9715-c6ae7f574e99?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=577e53e7c737a3f1347f5a5ff14639c3 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/60c36c04/uploads/origins/2b0fbd3e-56f9-45aa-9715-c6ae7f574e99?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=219d98f488e0af5a23457d826aaeb820", "srcset": "https://si.imgix.net/60c36c04/uploads/origins/2b0fbd3e-56f9-45aa-9715-c6ae7f574e99?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=219d98f488e0af5a23457d826aaeb820, https://si.imgix.net/60c36c04/uploads/origins/2b0fbd3e-56f9-45aa-9715-c6ae7f574e99?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=f5ca49f915f015812215df264abff5ab 2x, https://si.imgix.net/60c36c04/uploads/origins/2b0fbd3e-56f9-45aa-9715-c6ae7f574e99?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=cf7248e804dc39bf3671557ce4559e94 3x"}, "body": "はじめまして、夏野かなせみさん。\nTLでお見かけした細やかな背景とキャラクターのイラストがとっても素敵で一目惚れしました…！この機会にリクエスト失礼致します。\n\n◾️内容\n資料先のOCのイラストをお願いしたいです。フォロワーさんと自分のTRPGのキャラクターで、探偵の男と探偵助手の女の子です。お互い大切にし合っている関係で、現在はお付き合いを経て結婚し、同じ家で暮らす家族です。\n\n夏野さんがXにアップロードされていた春夏秋冬のイラスト（https://x.com/kanasemi_nnnnn/status/1991848937456885901?s=46&t=6qZaeGGPHdDcETlw5a1wiw）\nの空気感が好きだったので、どの季節でも構いませんが上記のイラストのようなサイズ比率だったりイラストの雰囲気だと嬉しいです。\n\nどちらかをメインに描いて頂いても構いません。パーツの省略・着脱、衣装の変更・構図・シチュエーションなどはお任せいたします。（顔の見えない構図などでも大丈夫です。）\n\n◾️使用用途\n・SNSへのアップロード（リクエスト報告）\n・個人鑑賞の範囲での印刷\n\n◾️資料\n①ネタバレなしキャラクター資料\nhttps://www.dropbox.com/scl/fo/j7jnytxoq5y7v5mjn6ys6/h?dl=0&rlkey=53k8fyc4kmo42zekrf4qry10d\n\n②TRPGシナリオのネタバレあり資料（主にセプテム・ペッカータのネタバレがございます。ネタバレが大丈夫であればご覧いただくのは可能ですが、イラスト作成に際して基本見る必要はないです）\nhttps://www.dropbox.com/scl/fi/7mjxml3t1bd0jdy5n5lam/.pdf?rlkey=84ptwv147xakfkvyc6zc5hxwy&st=p013fx7g&dl=0\n\nネタバレありの場合ワンクッションしていただけると助かります🙏\n\n無理のない範囲でご検討&ご金額など合わない場合再送要請いただけたらと思います。\nご縁があればよろしくお願いします。", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@kanaseminatsuno/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 833375, "client_id": 167964, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/3dfd8085/uploads/origins/5833b013-58f8-41e8-bded-827f432f3edc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=75f045105372efaaf2a9f37c02a6a45f", "srcset": "https://si.imgix.net/3dfd8085/uploads/origins/5833b013-58f8-41e8-bded-827f432f3edc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=75f045105372efaaf2a9f37c02a6a45f, https://si.imgix.net/3dfd8085/uploads/origins/5833b013-58f8-41e8-bded-827f432f3edc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=5da1ae158db11ff17898cf7223cea74c 2x, https://si.imgix.net/3dfd8085/uploads/origins/5833b013-58f8-41e8-bded-827f432f3edc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ea2e08cfc5b1273e25185162a75d2830 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/3dfd8085/uploads/origins/5833b013-58f8-41e8-bded-827f432f3edc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=7588ba44297985