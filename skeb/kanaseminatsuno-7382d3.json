なります。\n\n●内容\n私と友人のOCのイラストをお願いしたいです。\n探偵と探偵助手の二人です。\n▽参考URL\nhttps://www.dropbox.com/scl/fo/qv1hx3en20vg9rzev2frm/AJhK9bSvgEHfbsPyD9AKVMo?rlkey=0znnmcr7xumsw8kl2wqsc7vdz&st=8ve4gxso&dl=0\n\n●使用用途\n・個人観賞\n・完全個人用に印刷\n\n●その他要望\n二人が自然豊かな田舎に住んでいるため、田舎然とした風景の中にいる二人を描いていただけると嬉しいです。\n構図・サイズ比率・衣装などはおまかせします。\n夏野さんの描きやすいように描いてくださるのが一番嬉しいです。\n\n金額不足など、何かあれば遠慮なく再送申請・キャンセルをしてください。\nご検討のほど、よろしくお願いいたします。\n\nhttps://www.dropbox.com/scl/fo/qv1hx3en20vg9rzev2frm/AJhK9bSvgEHfbsPyD9AKVMo?rlkey=0znnmcr7xumsw8kl2wqsc7vdz&st=8ve4gxso&dl=0", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@kanaseminatsuno/works/8", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 833375, "client_id": 766715, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/fd955178/uploads/origins/3942c95e-2729-44bb-bd2f-49afb10b4f3d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ac6a04cf2e076adbcc0a5489076da9e9", "srcset": "https://si.imgix.net/fd955178/uploads/origins/3942c95e-2729-44bb-bd2f-49afb10b4f3d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ac6a04cf2e076adbcc0a5489076da9e9, https://si.imgix.net/fd955178/uploads/origins/3942c95e-2729-44bb-bd2f-49afb10b4f3d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=eb41b227b4cd413bafbe381804af4505 2x, https://si.imgix.net/fd955178/uploads/origins/3942c95e-2729-44bb-bd2f-49afb10b4f3d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=287c7cd890ccb02a258d3b59f8c138b3 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/fd955178/uploads/origins/3942c95e-2729-44bb-bd2f-49afb10b4f3d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5c784ea242e30492f719885ded5975f8", "srcset": "https://si.imgix.net/fd955178/uploads/origins/3942c95e-2729-44bb-bd2f-