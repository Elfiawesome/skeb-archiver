origins/b451a0df-132c-4b60-bdfa-8a223c9ecbdf?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=802be2c353cec8d5dd5b809bd8ba9d8b, https://si.imgix.net/9757a54b/uploads/origins/b451a0df-132c-4b60-bdfa-8a223c9ecbdf?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=90a43486d46119022be5d8f8dfd0e544 2x, https://si.imgix.net/9757a54b/uploads/origins/b451a0df-132c-4b60-bdfa-8a223c9ecbdf?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=caa69a6d0100c6bc568f311eee77486f 3x"}, "body": "お世話になっております！\nシンプルな白いワンピースを着ている女の子探索者達が見たくて…\n簡単なイラストで大丈夫ですので金額の範囲内で何人か詰め込んで頂きたいなと思いました。全員じゃなくて大丈夫です！金額で可能な範囲内！でお願いします。\n私のリンク先の探索者から選んでいただきたいです！欲を言えばちむさんの女の子探索者ももし可能であれば一緒に入れていただきたいです。\nワンピースの形状は指定ありませんのでお好きなように描いていただきたいです。\n\nご縁がありましたらよろしくお願いいたします！！", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Tsukimi_Chimu/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3289774, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/1464223e/uploads/origins/26834c29-da37-4671-a0f7-548490e6dec7?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&s=dbb49f760b26f093435692110840dd39", "srcset": "https://si.imgix.net/1464223e/uploads/origins/26834c29-da37-4671-a0f7-548490e6dec7?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&s=dbb49f760b26f093435692110840dd39, https://si.imgix.net/1464223e/uploads/origins/26834c29-da37-4671-a0f7-548490e6dec7?bg=%23fff&fm=webp&auto=compress&dpr=2&fit=crop&crop=top&w=200&h=200&s=655c5ccd5f052c1560381fa1ece14c6c 2x, https://si.imgix.net/1464223e/uploads/origins/26834c29-da37-4671-a0f7-548490e6dec7?bg=%23fff&fm=webp&auto=compress&dpr=3&fit=crop&crop=top&w=200&h=200&s=8059b66929b23d19442468e1872cd4af 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net