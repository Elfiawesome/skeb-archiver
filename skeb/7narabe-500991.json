g=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f6d640cd92a032b0505b5d29099d38fd 2x, https://si.imgix.net/70e009d3/uploads/origins/e837a7ae-4ba6-400c-98d4-b76d6b5cdc8a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=fb8e46c4b37b779006ac0a88c874b3e4 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/70e009d3/uploads/origins/e837a7ae-4ba6-400c-98d4-b76d6b5cdc8a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a67225f8db55218cd85d3cb4f151c7a7", "srcset": "https://si.imgix.net/70e009d3/uploads/origins/e837a7ae-4ba6-400c-98d4-b76d6b5cdc8a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a67225f8db55218cd85d3cb4f151c7a7, https://si.imgix.net/70e009d3/uploads/origins/e837a7ae-4ba6-400c-98d4-b76d6b5cdc8a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=f392129809b05cdbfbc0b992ed95a3bf 2x, https://si.imgix.net/70e009d3/uploads/origins/e837a7ae-4ba6-400c-98d4-b76d6b5cdc8a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=87f961dec7014116c1220b16d825d2ea 3x"}, "body": "よりちてで大変お世話になりました、天です。\n今回、よりちて自陣のHO3とHO4の一枚絵をお願いしたいです。\n外見情報はURL先のグーグルドライブに纏めております。\n\n【HO3飼育】田中 茶摘（35）\nゆるふわロング、糸目、ボス猫の雰囲気。優しそうに見えて実際優しいが喧嘩っ早い。生き残れば勝ち。\n貞操観念がガバ過ぎて、游くんに対してどっちでも良いからいつでも来いよ状態。この間そういうのは好きになってからと嗜められました。なぜ？？？\n膝の上に乗せてテレビを見るし、同じベッドで寝たりもするし、なんなら風呂も一緒に入って、尚何も無い。そんな距離感で過ごしています。\n游くんの求愛が成功する度に、少しずつ愛を知っていく。クリティカルしたら照れます。クリティカルしたら。\n\n【HO4水槽】魚住 游（20）\n片メカクレ、ハイライト無しの死んだ魚の目。どことなくぼんやり浮世離れした雰囲気。\n世間知らずなりに相変わらず片想いを実らせようと頑張っておりますが、茶摘さんからの距離感がめちゃくちゃバグりすぎていて逆に宇宙猫状態になっております。\n茶摘さんいわく犬猫と一緒らしいので「じゃあ…まぁ…いっか…（？？？）」とか思っていますが、「ただの弟分にここまでしない」ということは本人から説明されて理解しています。\n技能：求愛が３９になりました。ワンチャンいけます。\n\n雰囲気や構図など全てお任せ致します、しっとりでもゆるふわでもかっこよくでも！\nさとるさんの茶游が見たく、ご縁ありましたら幸いです。\n\nhttps://drive.google.com/drive/folders/1goZTyf37hCUDbIsPV5MaFE9UHSVghgUU?usp=sharing", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@KGW_etu00/works/20", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1817285, "client_id": 681884, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/fdff20ec/uploads/origins/ad3e3976-827a-4e5d-944a-9a9aaf5e0ee4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=192d0375e27e329f3a13bfba83e7c474", "srcset": "https://si.imgix.net/fdff20ec/uploads/origins/ad3e3976-827a-4e5d-944a-9a9aaf5e0ee4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=192d0375e27e329f3a13bfba83e7c474, https://si.imgix.net/fdff20ec/uploads/origins/ad3e3976-827a-4e5d-944a-9a9aaf5e0ee4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b5b201d2fea78e59d58d3034ca8c2ef5 2x, https://si.imgix.net/fdff20ec/uploads/origins/ad3e3976-827a-4e5d-944a-9a9aaf5e0ee4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=3ca62c577ea240e3a14f8193b261546f 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/fdff20ec/uploads/origins/ad3e3976-827a-4e5d-944a-9a9aaf5e0ee4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e587a8970408cfbbac6c205f2f4eecdb", "srcset": "https://si.imgix.net/fdff20ec/uploads/origins/ad3e3976-827a-4e5d-944a-9a9aaf5e0ee4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e587a8970408cfbbac6c205f2f4eecdb, https://si.imgix.net/fdff20ec/uploads/origins/ad3e3976-827a-4e5d-944a-9a9aaf5e0ee4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=da652022cb77c258b486cd797aec5a13 2x, https://si.imgix.net/fdff20ec/uploads/origins/ad3e3976-827a-4e5d-944a-9a9aaf5e0ee4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=29ef96279d4b2d85ff1bfdc9e1dade59 3x"}, "body": "こんにちは、再びのリクエスト失礼します。\n私とお友達がTRPGで使用している男性キャラのイラストをお願いします。\n去年大きな出来事を乗り越えたので、是非彼らへのご褒美にこがわ先生に描いて頂きたいです。\nふんわりと幸せそうな、やさしい雰囲気に。\n\n＊＊＊関係性＊＊＊\n元ブラック企業の同僚。\n死にかけたり病んだりしたが、なんやかんやあって今は穏やかに一緒に海の街で暮らす。\n互いが互いを大切に想いあう恋人同士。\n苗字から通称が「いかたこ」🦑🐙\n\n曲「とっておきの唄／BUMP OF CHICKEN」「勲章／ねごと」「あたしの心臓あげる／黒木渚」\n\n＊＊＊\n筏谷 理（いかや さとる）\n\n29歳、男\n\n灰色がかった緑髪、ストレートヘア。\n茶紫の眼の下にうっすら隈。年相応の顔立ち。\n\n真面目で穏やかな性格。断るのが苦手で優しい分、会社員時代はしんどい日々。\n趣味のカメラで景色や恋人を撮影するのがすき。\n恋人のバイオリンを聴いたり、お茶の時間に一緒にお菓子を食べることもすき。\n\n朝起きてすきな人に挨拶をする、一緒にファミレスに行く、コンビニに行く。\nそういった日常を「当たり前だと思っていい」というのを忘れていた。\n会社員時代に何気なく傍に居てくれた多古に感謝していて、自分を選んでくれたことも幸せと受け取れるまでになりました。\n妹が居るので、ほんのりお兄ちゃん気質。\n\n服装は綺麗めカジュアルでお任せ。\n\n＊＊＊\n多古 布見（たこ ふみ）\n\n29歳、男\n\n赤茶の髪。くせっ毛。\n蛸がモチーフの為、黄色の瞳に横長の瞳孔での描写をお願いします。\n前髪が長いので見えなくても◎です。\n丸顔も相まって童顔寄り。\n\n卑屈で他人に対し気が弱く、内心とげとげとした性格であった。\n奨学金を返し終えたら春の海で自殺するつもりで生きていた。\nが、現在は穏やかに筏谷と海を見ながら暮らす事が出来ている。\n性格もまろくなり、淡白系の幼い言動に偏ってきている。\nとにかく「笑わない」性格でしたが、現在は少しずつ笑うようになってきました。\n控えめで穏やかな、筏谷と一緒にいられる幸せを味わうような笑みを描いていただけたら幸いです。\n\n趣味はバイオリン。初任給で安いバイオリンを買い、それをずっと弾いている。\n\n服装はワークスタイルやブラウンコーデ、ダッドスニー辺りの雰囲気でお願いします。\nややずんぐりした服を好みます。\n\nhttps://drive.google.com/drive/folders/1WdPPNIWmH9m4vKTCUSlip1_ka4DxYiF9?usp=drive_link", "nc": 137, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@SukutaroNo2/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 553174, "client_id": 681884, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/0bf03ca4/uploads/origins/97595284-a482-4425-84ac-f4e213b66daf?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d680883e8f02f93787bbdb6a6ad94e4c", "srcset": "https://si.imgix.net/0bf03ca4/uploads/origins/97595284-a482-4425-84ac-f4e213b66daf?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d680883e8f02f93787bbdb6a6ad94e4c, https://si.imgix.net/0bf03ca4/uploads/origins/97595284-a482-4425-84ac-f4e213b66daf?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c03aaafb8967adb6050e0f480c89c239 2x, https://si.imgix.net/0bf03ca4/uploads/origins/97595284-a482-4425-84ac-f4e213b66daf?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=adcb395c528befedef04173931be99db 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/0bf03ca4/uploads/origins/97595284-a482-4425-84ac-f4e213b66daf?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b01020e734e3fb41dd6219bc12a78dd3", "srcset": "https://si.imgix.net/0bf03ca4/uploads/origins/97595284-a482-4425-84ac-f4e213b66daf?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b01020e734e3fb41dd6219bc12a78dd3, https://si.imgix.net/0bf03ca4/uploads/origins/97595284-a482-4425-84ac-f4e213b66daf?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=e6a635454d04c619c4d68dff77bd9939 2x, https://si.imgix.net/0bf03ca4/uploads/origins/97595284-a482-4425-84ac-f4e213b66daf?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=0ea9e15e03fb42397018af1b81c47ac4 3x"}, "body": "はじめまして、いつも朔太郎さまのピクルーにTRPGでお世話になっております。\n今回、クトゥルフ神話TRPGで使用しているキャラクターの立ち絵をお願いしたいです。\nピクルーを基にしているため、作者さまアレンジなど歓迎です。\n性格などの参考のために普段使用している画像をすべて添付しましたが、表情差分の有無もお任せします。\n\n◆設定\n２８歳、男\n\nヤクザの若頭。\n目つきが悪く無愛想、育ててくれた組長を筆頭に舎弟や組の人間を大事にしている。\n自分のシマで一般人が事件の被害に遭わないよう気を遣うタイプ、きちんと筋を通す。\n\nシナリオ「ロトカ・ヴォルテラの愛堕討ち」HO極道者\n犬猿の仲である美青年落語家に毎回喧嘩を売られる度、青筋を浮かべながら我慢したり受け流したりしている。\n口で勝てることがないため、基本的に勝ち誇った顔をされてはキレてる。けど一般人相手なので暴力に出ない。\n\n秘匿ネタバレ有のキャラクターシート（読まなくてもOK）\nhttps://iachara.com/view/4814353\n\n◆髪\n茶髪のざっくりオールバック\n後ろは襟足短め\n\n◆顔\n年相応でクールな印象かつ強面\n\n三白眼、銀の瞳\n色付きサングラス\n\nつり眉\n\n不機嫌そうで不愛想な表情\n\n若干薄い褐色肌に、→を中心にした火傷痕（全身にもあります）\n\n耳元にイヤカフ\n\n◆体型\n１８８ｃｍ、７８キロ\n体格が良く筋肉質\n\n◆服装\n灰色のシャツ（ネクタイ無し）\nダークトーンのジャケットスーツ\n\n革靴\n\n\nご縁ありましたら幸いです。\n\nhttps://drive.google.com/drive/folders/11doaId9-9ZiDKXMxch7iq_HTeHpC5OAf?usp=sharing", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@satono_omo/works/81", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1727341, "client_id": 681884, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/15ea208e/uploads/origins/ba9afcd3-2484-46fd-833e-a36a53b998be?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=52cb7affa9dd8f6bd9d5d0ff2726d8b3", "srcset": "https://si.imgix.net/15ea208e/uploads/origins/ba9afcd3-2484-46fd-833e-a36a53b998be?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=52cb7affa9dd8f6bd9d5d0ff2726d8b3, https://si.imgix.net/15ea208e/uploads/origins/ba9afcd3-2484-46fd-833e-a36a53b998be?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=fa522fc86f01be252c4d46f208b8d1b0 2x, https://si.imgix.net/15ea208e/uploads/origins/ba9afcd3-2484-46fd-833e-a36a53b998be?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e69730f6f2c78f0bc50db58d05ea7403 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/15ea208e/uploads/origins/ba9afcd3-2484-46fd-833e-a36a53b998be?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=1701ead3a06c4f95c4c3218e923e824a", "srcset": "https://si.imgix.net/15ea208e/uploads/origins/ba9afcd3-2484-46fd-833e-a36a53b998be?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=1701ead3a06c4f95c4c3218e923e824a, https://si.imgix.net/15ea208e/uploads/origins/ba9afcd3-2484-46fd-833e-a36a53b998be?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=08b2c3eb40615cb279e41a44dcbdeff0 2x, https://si.imgix.net/15ea208e/uploads/origins/ba9afcd3-2484-46fd-833e-a36a53b998be?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=49688476e19ddb0a8d86d61700e99c36 3x"}, "body": "はじめまして、いつも素敵な作品を拝見しております！\n今回、私がTRPGで使用しているキャラクターのイラストをお願いしたいです。\n不明点などはすべてお任せします。\n\n使用用途は個人観賞、SNSでお友達に見せるなどです。\n\n◆イラストイメージ\nふんわりあたたかい\nかわいい\n普段地味でシンプルクールな装いなので、佐鳥さんの素敵なかわいいデザインのお洋服を着せてほしいです\n\n◆PCモチーフ\n燕\nお伽話の脇役\n夜景\n\n◆設定\n２３歳、女\n\n警視庁特殊部隊（SAT）に所属する狙撃手。\n高身長でスタイルがいいが顔が地味なのを気にしている。\nはきはきと喋りにこにこ笑いながらも、常に真面目に物事を考えて答えを出そうとする。\nすきなものは様々なお茶を飲む時間。\n女友達に慕われるタイプで男友達とも気軽に話せる印象。\nけど本当はかわいいものがすきで、そういう物が似合うちいさく華奢な女の子に憧れています。\n身体を鍛えている分、荒事を腕力でなんとかすることがある。\n相棒を組む先輩に片思い中。穏やかで、𠮟るべき時は叱ってくれる人柄を信頼しています。\n\n◆髪\n艶のある黒\n真ん中分けの前髪\n後ろはボブヘア\n\n◆顔\n地味な顔立ち\nどちらかといえばクールな印象\n\n若干つり目の黒い瞳\n\n表情は照れたような微笑やきょとんとした様子など乙女っぽさをお願いしたく\n\n健康的な肌色\n\n◆体型\n１７５ｃｍ、６５キロ\n胸はＥカップでスタイルは良い\n\n◆服装\n季節感などもお任せで、かわいらしいイメージのお洋服をお願いしたいです。\nあたたかみのある色合いのものがうれしいです。\n\nご縁ありましたら幸いです。\n\nhttps://drive.google.com/drive/folders/1PQZgcHzbEgaIIUu0vVBC8ROGeo935-yD?usp=sharing", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@shockdazou/works/69", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 989712, "client_id": 681884, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/44c89bb3/uploads/origins/1bf554f1-270c-45d0-a552-754499817d0a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=85c670572962b0acc2657b4bf14646da", "srcset": "https://si.imgix.net/44c89bb3/uploads/origins/1bf554f1-270c-45d0-a552-754499817d0a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=85c670572962b0acc2657b4bf14646da, https://si.imgix.net/44c89bb3/uploads/origins/1bf554f1-270c-45d0-a552-754499817d0a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ddf2570d5b512c60a449effec03b798d 2x, https://si.imgix.net/44c89bb3/uploads/origins/1bf554f1-270c-45d0-a552-754499817d0a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=683d3e0b2136a64879c6edf7d3f256a1 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/44c89bb3/uploads/origins/1bf554f1-270c-45d0-a552-754499817d0a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c245f411f8dbd72cca018d2aa0318472", "srcset": "https://si.imgix.net/44c89bb3/uploads/origins/1bf554f1-270c-45d0-a552-754499817d0a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c245f411f8dbd72cca018d2aa0318472, https://si.imgix.net/44c89bb3/uploads/origins/1bf554f1-270c-45d0-a552-754499817d0a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=776459991eefe2bdf4ffb57b765da24a 2x, https://si.imgix.net/44c89bb3/uploads/origins/1bf554f1-270c-45d0-a552-754499817d0a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=61927fbfddd5933581dead90b06f9f5e 3x"}, "body": "こんにちは、以前SKIMAでTRPGの立ち絵を描いて頂いた者です。\n今回はそのキャラクターの少年時代の立ち絵をお願いしたくリクエストさせて頂きます。\n\n◆設定\n１２歳、男。同じ年の子と比べると低身長。\n資料URLの成人男性をそのまま幼くした印象。\n暴力を振るう父親と精神的に病んだ母親のネグレクトから、あまり家に帰りたくない。\n\n◆髪\n参照と同じ髪型の金髪\n\n◆顔\nどこか疑心暗鬼で不服そうな表情\n灰色の目\n\n◆服装\n小学生男児っぽい半袖シャツに短パン\n膝に絆創膏\n青色のランドセル\n\n不明点等すべてお任せします、ご縁ありましたら幸いです。\n\nhttps://drive.google.com/file/d/1YcI1jSygXOvqhNOGbbw1SDSOfK72LVWb/view?usp=sharing", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@STZZSS/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2053055, "client_id": 681884, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/ee5e5b09/uploads/origins/0e2f298a-2fd1-4f33-be1e-3c183772aef2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a4a45a887781bc04802bbca509f7b15b", "srcset": "https://si.imgix.net/ee5e5b09/uploads/origins/0e2f298a-2fd1-4f33-be1e-3c183772aef2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a4a45a887781bc04802bbca509f7b15b, https://si.imgix.net/ee5e5b09/uploads/origins/0e2f298a-2fd1-4f33-be1e-3c183772aef2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=6138348ff0e05b9b20fd36d16a9926c6 2x, https://si.imgix.net/ee5e5b09/uploads/origins/0e2f298a-2fd1-4f33-be1e-3c183772aef2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c9952e09ed1c3cad53350c6fb9b6b58c 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/ee5e5b09/uploads/origins/0e2f298a-2fd1-4f33-be1e-3c183772aef2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=1051d7110cdca9905ebfa6da32f41e22", "srcset": "https://si.imgix.net/ee5e5b09/uploads/origins/0e2f298a-2fd1-4f33-be1e-3c183772aef2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=1051d7110cdca9905ebfa6da32f41e22, https://si.imgix.net/ee5e5b09/uploads/origins/0e2f298a-2fd1-4f33-be1e-3c183772aef2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=63af010e5fbc5074678feafbac030c43 2x, https://si.imgix.net/ee5e5b09/uploads/origins/0e2f298a-2fd1-4f33-be1e-3c183772aef2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=4faecea576c8e57370b44f1d6d907e8a 3x"}, "body": "はじめまして、Xや納品物を拝見して、美しい曲線や配色の鮮やかさに惹かれました。\n（宝石の国のファンなので、宝石達の美しさの表現も素晴らしく、大変ときめきます！）\n今回、私がTRPGで使用しているキャラクターのイラストをお願いしたいです。\n不明点などございましたらすべてお任せします。\n\n◆イラストイメージ\n綺麗\nクール\n羊の群れに紛れる狼\n\n◆設定\n２６歳、女\n\n表向きは清掃会社であり、本業は暗殺者を営む会社でスナイパーを務める。\nいつもねむそうで、にこにこふんわり笑って会社の同僚達を見守っています。\n本業ではひやりとした眼差しで淡々と仕事を行う性格。\nけれど大切な人が危険に陥ると殺意が優先しそうなのを抑えています。\nキャラクターモチーフは子羊、イメージカラーは若草色。\n\n◆髪\n長い灰交じりの金髪を一纏めにしたシニヨンが、どこかほどけたような雰囲気\n（完全にほどけてウェーブロングになってもOK）\n羊の耳のように、左右にぴょこんとハネた房があります\n前髪は←に分け目があり３：７の割合で分けています\n\n◆顔\n平均的な顔立ちですが、どちらかといえば美人寄り\n\n太いまろ眉\n\n瞳は黒目がち、色は黒\n\n表情は何処かひやりとしています\n\n◆体型\n１６０cm、５０キロ\n胸はCカップ\n\n肌は色白\n\n◆服装、持ち物\n細身の華美なワンピースドレス\n太もも以下まで描写される場合の露出度などはお任せします\n\n可能であればライフルを抱えてほしいです\n（細かな部分はざっくりとしていて構いません、ライフル自体無くてもOK）\n\nご縁がありましたら幸いです。\n\nhttps://drive.google.com/drive/folders/1GOwmWj6LhBCNpwG5zwrb5fvcoVwzrS00?usp=sharing", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@sobakonattou07/works/497", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1057632, "client_id": 681884, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/93438677/uploads/origins/d1890683-10dc-48a2-a061-927a6e9da5f8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6dfa768b34caee2470b0f4b39a9916b0", "srcset": "https://si.imgix.net/93438677/uploads/origins/d1890683-10dc-48a2-a061-927a6e9da5f8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6dfa768b34caee2470b0f4b39a9916b0, https://si.imgix.net/93438677/uploads/origins/d1890683-10dc-48a2-a061-927a6e9da5f8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c0560bf4257e453568de3167a1c28f88 2x, https://si.imgix.net/93438677/uploads/origins/d1890683-10dc-48a2-a061-927a6e9da5f8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f929c43837e767586ead64d430df839e 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/93438677/uploads/origins/d1890683-10dc-48a2-a061-927a6e9da5f8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9cc049c64223cd676f413d5a11e75a98", "srcset": "https://si.imgix.net/93438677/uploads/origins/d1890683-10dc-48a2-a061-927a6e9da5f8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9cc049c64223cd676f413d5a11e75a98, https://si.imgix.net/93438677/uploads/origins/d1890683-10dc-48a2-a061-927a6e9da5f8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=12a20fe2e3d269b69f7cd9b366785700 2x, https://si.imgix.net/93438677/uploads/origins/d1890683-10dc-48a2-a061-927a6e9da5f8?bg=%23fff&auto=f