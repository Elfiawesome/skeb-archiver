fit=crop&crop=top&w=200&h=200&s=1f54f4ff0703874215321a3e222399fa 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/ce109281/uploads/origins/e14d7693-f080-494a-8961-f7c14f16be12?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=7eb3a0ade67b4fae00ac5052376e5e98", "srcset": "https://si.imgix.net/ce109281/uploads/origins/e14d7693-f080-494a-8961-f7c14f16be12?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=7eb3a0ade67b4fae00ac5052376e5e98, https://si.imgix.net/ce109281/uploads/origins/e14d7693-f080-494a-8961-f7c14f16be12?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=f4c611a37e674eab05c01fbb94d5261e 2x, https://si.imgix.net/ce109281/uploads/origins/e14d7693-f080-494a-8961-f7c14f16be12?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=013fdd8c652f1fece9745cedf4568380 3x"}, "body": "こんにちは。VTuberのててるが登場する短い漫画を依頼したいです。彼女とファンである「Homies」との間のユーモラスなやり取りを描いていただきたいです。ててるちゃんはゲームをしたり、ファンと地元の文化についておしゃべりするのが好きです。ててるちゃんとファンの参考資料を添付しました。\n\n彼女のチャンネル：\nhttps://youtube.com/@tetel_flow?si=ttyzfXEK_ffzI-Y0\n\nhttps://drive.google.com/drive/folders/1pJUn50-Df-oDexRx0rh-TzMqnIeFGDOM", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@samegamesan/works/13", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 60710, "client_id": 523972, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/bfabd879/uploads/origins/e5752567-871c-4579-a863-ebccbdf6a827?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9b15d872912339fac54a7db833ad3533", "srcset": "https://si.imgix.net/bfabd879/uploads/origins/e5752567-871c-4579-a863-ebccbdf6a827?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9b15d872912339fac54a7db833ad3533, https://si.i