す。\n\n基本は友情関係ですが、RylanはKAIと多少の親密なスキンシップがあっても大丈夫です。二人の間の親密な雰囲気を見るのも、とても楽しいです。笑）(bl ok!)\n\n詳細はリンク内の設定画像をご参照ください（主にLook 1）。\nかわいい日常的なやり取りであれば、どんなシチュエーションでも大歓迎です！ご自由に描いていただけたら嬉しいです。よろしくお願いいたします！\n\nhttps://drive.google.com/drive/folders/1svhqjiAscRcX9Rc7TeqlM0yC5Jphqve1?usp=sharing", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@akaru024/works/10", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3927288, "client_id": 2563390, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/9376e7d8/uploads/origins/9d3b3f95-351d-42fc-96aa-11f08201e700?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=23af04d6991f92b77621fe0e74644278", "srcset": "https://si.imgix.net/9376e7d8/uploads/origins/9d3b3f95-351d-42fc-96aa-11f08201e700?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=23af04d6991f92b77621fe0e74644278, https://si.imgix.net/9376e7d8/uploads/origins/9d3b3f95-351d-42fc-96aa-11f08201e700?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=d908a76ad70ee3b59bb1734c7d9e4297 2x, https://si.imgix.net/9376e7d8/uploads/origins/9d3b3f95-351d-42fc-96aa-11f08201e700?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=6f3a5655b2d121ea07aa532d8865b826 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/9376e7d8/uploads/origins/9d3b3f95-351d-42fc-96aa-11f08201e700?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=aa797ea07173687e53293096a5576eef", "srcset": "https://si.imgix.net/9376e7d8/uploads/origins/9d3b3f95-351d-42fc-96aa-11f08201e700?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=aa797ea07173687e53293096a5576eef, https://si.imgix.net/9376e7d8/uploads/origins/9d3b3f95-351d-42fc-96aa-11f08201e700?bg=%23fff&auto=format%2Ccompress&