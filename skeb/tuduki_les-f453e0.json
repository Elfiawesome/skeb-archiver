ps://si.imgix.net/35dce5d2/uploads/origins/3edef321-66ee-49e6-8f46-250053b40750?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=0fd507128d68b198d425517c503e777f 3x"}, "body": "こんにちは\n\nスカサハ(FGO)とニアン/ニェン(アークナイト)のイラストをお願いしたいのですが。\n\n二人が一緒に街やマーケットを歩いているところ。\nニアンの片方の腕がスカサハの首や肩に絡まっています。\nニアンは普段の性格のように、とても幸せそうな、あるいは遊び心にあふれたポーズをしています。\nScathachは幸せそうな、柔らかい表情をしています。\n\nScathachはNianの服を着ています。\nScathachとNianはジャケットを着用していません。\nScathachの脚にNianの脚のタトゥーを入れてください。もしかしたら、反対の腕にも同じようなものがあるかもしれません。\n\nもし難しすぎなければ、それぞれを別のレイヤーまたはグループに描いてください。\n肌の色は、青白くなりすぎないように、自由に色をつけてください。\n大きめのプロポーションで、少なくともカーマの大きさくらいで描いてください。\n\nScathachの刺青がないバリエーションとNianの目の輝きがあるバリエーションを追加すると良いでしょう。ない場合は、目の輝きなしで描いてください。\n\nSNS、YouTube（動画サムネイルなど）、Twitch、Minecraftなどで、クレジットを入れて使用できるようにしたいです。\n\n参考：https://imgur.com/a/0C0tFnJ\n\nPSDファイルでお願いします。", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@tuduki_les/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1704444, "client_id": 2042838, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/aa2d1603/uploads/origins/2513e68a-ef8f-4a5a-8967-9c9b90d646d5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=079e8e38fbd52900b51327da2bb661b8", "srcset": "https://si.imgix.net/aa2d1603/uploads/origins/2513e68a-ef8f-4a5a-8967-9c9b90d646d5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=079e8e38fbd52900b51327da2bb661b8, https://si.imgix.net/aa2d1603/uploads/origins/2513e68a-ef8f-4a5a-8967-9c9b90d646d5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=936e420a5b7491967dbc7619ad6f5c4f 2x, https://si.imgix.net/aa2d1603/uploads/origins/2513e68a-ef8f-4a5a-8967-9c9b90d646d5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=2bd7d6226ebead71d7298961c3e1da99 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_