でお願いいたします）\n・構図やその他の細かいアレンジは、すべてソウイ様にお任せします。\n\n■ 使用用途\n個人鑑賞および個人SNSアカウントのアイコン・ヘッダー等\n\n金額やスケジュール等の条件が合わない場合や、描きづらい内容でしたら気兼ねなく非承認・キャンセルにしてください。\n何卒よろしくお願いいたします。\n\nhttps://www.instagram.com/p/Db7t5_ngYYw/", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 2011436, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "もりみやさく", "screen_name": "morimoripur", "avatar_url": "https://pbs.twimg.com/profile_images/1607593021088100352/ipIOaPRB.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1502652753969315842/1689514040/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 15, "complete_expiration_days": 30, "skills": [{"genre": "art"}, {"genre": "correction"}], "banned": false, "nc": 145}, {"id": 2584736, "creator": true, "nsfw_acceptable": false, "acceptable": false, "name": "ステキね", "screen_name": "majidesutekine", "avatar_url": "https://pbs.twimg.com/profile_images/1904831662867021824/LcLgSsW7.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1534204671602348033/1731395872/1500x500", "appeal_receivable": true, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 120, "skills": [{"genre": "art"}], "banned": false, "nc": 1}, {"id": 2754428, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "WH♢Z/サブ垢", "screen_name": "hyper_whoz", "avatar_url": "https://pbs.twimg.com/profile_images/1909078814967406592/ldKyHimG.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1661008412896002050/1746973613/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "t