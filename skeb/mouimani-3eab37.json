rop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=c5838713ecc4683de213122f928f6674 2x, https://si.imgix.net/88f906a4/uploads/origins/c29058b1-9461-42fc-a39c-14c3123a5752?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=473b9a8a6b1ba9b12ab11fd60806ca2a 3x"}, "private": true, "genre": "art", "tipped": true, "creator_id": 32932, "nc": 179}, {"path": "/@mouimani/works/14", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 32932, "client_id": 281852, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/f872763b/uploads/origins/c09d7f18-a36b-4bef-8505-29b2c7d03736?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1dba206a24d12d825c8a0d4bd1f156ec", "srcset": "https://si.imgix.net/f872763b/uploads/origins/c09d7f18-a36b-4bef-8505-29b2c7d03736?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1dba206a24d12d825c8a0d4bd1f156ec, https://si.imgix.net/f872763b/uploads/origins/c09d7f18-a36b-4bef-8505-29b2c7d03736?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=2dbf3bbd8e8c603cfc968a29cc9f9825 2x, https://si.imgix.net/f872763b/uploads/origins/c09d7f18-a36b-4bef-8505-29b2c7d03736?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=42104644b02b983e05a0c682952c16b1 3x"}, "duration": null, "nsfw": true, "hardcore": true, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/f872763b/uploads/origins/c09d7f18-a36b-4bef-8505-29b2c7d03736?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3b2edeaabc8d95d8f03ae60db8234a5c", "srcset": "https://si.imgix.net/f872763b/uploads/origins/c09d7f18-a36b-4bef-8505-29b2c7d03736?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3b2edeaabc8d95d8f03ae60db8234a5c, https://si.imgix.net/f872763b/uploads/origins/c09d7f18-a36b-4bef-8505-29b2c7d03736?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=e9ca970bbaebce689667999105f946ad 2x, https://si.imgix.net/f872763b/uploads/origins/c09d7f18-a36b-4bef-8505-29b2c7d03736?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=60f3f2d8be6f47d2a6eef9283a534849 3x"}, "body": "【概要】\nらんま1/2の女らんまで売春乱交で妊娠、出産を見せ物にしてお金を取るという内容でカラーイラスト3枚+セリフ効果音無し版もお願いします。\n【服装】\n下はピチピチのホットパンツで膣の部分にカットを入れて露出させたもの。上は布面積が小さいビキニタイプの水着で色は白く乳首が浮き出ている。履き物は素足に赤いハイヒール。出産時はホットパンツを脱いだ状態に。\n【体型】\n妊娠時はオッパイが一回り大きくなり乳首や乳輪も真っ黒で大きくする。出産後のボテ腹は若干緩む程度で十分大きいまま。\n【その他】\n表情や効果音等はお任せ、生まれてくる赤ん坊は褐色肌でお願いします。\n【1枚目】\n中腰でお尻を突き出したポーズを真横から見たアングル。男2人にフェラをしながらバックから挿入され射精された直後で口も膣もザーメンブリッジ状態。セリフは男1「ふぅ、中出しOKって聞いたからそのまま出しちゃったけどピルとか飲んでるの？」らんま「俺が避妊なんて面倒な事するわけねーだろ❤️ガキがデキたらそこらの便所でヒリ出して放置だよ(笑)」男2「ウハッ！その歳で5回出産してるだけあってとんでもないビッチだな(笑)」\n【2枚目】\n10ヶ月後のテロップ、らんまは臨月ボテ腹で出産中。体は汗ばんで肛門から大便が出かかり、膣が開いて赤ん坊の頭部が見えている状態。ポーズは過去絵のマクドナルド母のようにお尻を向けて手で尻肉を広げたもの。噴き出た母乳で上着が濡れて黒乳首が透けている。画面端に撮影用のスマホを持った男性の手を2つ描く。セリフは男1「おお、出てきた！って黒人のガキじゃねーか(笑) 」男2「俺の子供をヒリ出して欲しかったのに(涙) 父親は誰だよ！」らんま「毎日50人以上客を取ってんだから父親なんざ分かるわけねーだろ(笑) 黒人ってだけでも父親候補は100人以上居るっての❤️」\n【3枚目】\n胎盤の排出まで終えた状態で放尿中。ポーズは2枚目とまったく同じ。股下では羊水の水溜りに中に大便と赤ん坊が転がって産声を上げている。産後の膣と赤ん坊の周りに湯気表現をつける。セリフは男1「出産なんて初めて見たけど想像以上にエログロいね(笑)」男2「いや〜生命と女体の神秘を堪能させて貰ったよ(笑)」らんま「俺も出産見てチンコバキバキにする変態共のお陰で大儲けだよ(笑)女の体は本当に便利だぜ❤️」", "nc": 170, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@mouimani/works/13", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/de978557/uploads/origins/2e728f35-b59c-42f7-ba7c-4a33972b04d7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=a0554759f803fb33eda2760ed297dc4a", "srcset": "https://si.imgix.net/de978557/uploads/origins/2e728f35-b59c-42f7-ba7c-4a33972b04d7?bg