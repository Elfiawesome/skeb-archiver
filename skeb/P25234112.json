と嬉しいです。） ）\nもしくは彼シャツ をお願いします。\n（P様にお任せします）\n\n・ポージング・表情\n表情）寝起きのとろんとした目とふにゃっとした笑顔\nポージング）ベッドの上で横になっている（寝起き）\n片手は彼（相手）の手に手を重ねている様なイメージだと嬉しいです。\nベッドのどこかにゲーミングコントローラーが置いてあると嬉しいです。\n\n使用用途\nSNSでの使用、ファンBOX（こちらは未定です）\nYouTubeでの動画のサムネイルに使用させて頂きたいです。\n\n姿は御手数で申し訳ないのですが下記URLから確認をお願い致します。  \n\n身長：153cm\n童顔\n大きなお耳と大きなしっぽがチャームポイントです。\n正面から見て右太ももにホクロがあります。\n上の歯に2本八重歯（牙）があります。\n胸のサイズはB～Cです。\n人間の耳はありません。\n髪の毛を結んでいない下ろしている状態の髪型でお願いします。\n髪飾りにあるモチーフの花とリボンのピン留めをどこかにつけて頂きたいです\n\nお忙しい中大変申し訳ありませんがご検討して頂けると幸いです。\nよろしくお願い致します。\n\nhttps://x.com/hazime_qo/status/1670341726823907329?s=46&t=YIB0yIKwqqWIUB7vmptfgQ", "nc": 161, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@P25234112/works/35", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/1fe49856/uploads/origins/d2a252f3-01ba-4232-8416-21a7291d486e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=65a4215ebc10da219baeac07d142698c", "src_set": ""}, "private": true, "genre": "art", "tipped": false, "creator_id": 1519860, "client_id": 146552, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 17, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@P25234112/works/34", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/668581cd/uploads/origins/d9caf33e-d3a0-44a1-9c44-4dc0a0bee05b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=6c4d8c22cf79fce391fb1b413abdf057", "src_set": ""}, "private": true, "genre": "art", "tipped": false, "creator_id": 1519860, "client_id": 0, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "