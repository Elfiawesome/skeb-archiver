cc2-b05f-f99851e7b468?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f08ddbe8e74dbcd39123190246dcc419, https://si.imgix.net/d153cbbe/uploads/origins/a58da210-a41d-4cc2-b05f-f99851e7b468?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=9346fb3e4f36ab05051ae202c883ee01 2x, https://si.imgix.net/d153cbbe/uploads/origins/a58da210-a41d-4cc2-b05f-f99851e7b468?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=d6528f6fe5d94ad65c4dc286b3c065d9 3x"}, "body": "◯内容\nバナナを踏んで滑る吉弔八千慧\n◯要望\n・黒のストラップシューズの描き方と色は可能な限り資料と同じ描き方（つま先は丸くて厚みは薄くして色は墨色ベースでツヤあり)\n※墨色のカラーコード:#595857\n◯詳細\n1.横向きに落ちていたバナナを踏みつけて歩き出そうとしている\n踵は少し浮いて足の向きは少し傾く\nつま先から中身が溢れ出ている\n2.足を滑らせ地面には滑った跡が残る\n3.大コマで構図とアングルは資料と同じ\n伸ばした足はやや内向きにして靴底の甲の部分はバナナの中身で汚れている\n真ん中の地面に潰れたバナナが落ちている\n八千慧の表情はジト目で不機嫌になっている\n空白スペースに沢山のバナナを両手で抱えていて「あわわ」と慌てている美天と笑い転げている早鬼がいる\n4.お仕置きでゲンコツされてたんこぶが出来る美天（表情は資料参考）\n5.八千慧が早鬼の顔を力強く踏みつけて早鬼の顔面が陥没する\n\n\n資料URL\n\nhttps://www.dropbox.com/scl/fo/9azjfkivkbudutmb7lr9w/ABlUTotOOkjxZfHAJdo3IaQ?rlkey=xlcic5dsj18emcqyaigjo6lvi&st=du3yk0ka&dl=0", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@tamakohanabi/works/8", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3581985, "client_id": 1095921, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/36a06ce9/uploads/origins/4be8f4c1-7bd5-42ff-a3d0-8faccdcbb0de?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3bd7eb01c421d8fdc0fbddd00c7aaf96", "srcset": "https://si.imgix.net/36a06ce9/uploads/origins/4be8f4c1-7bd5-42ff-a3d0-8faccdcbb0de?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3bd7eb01c421d8fdc0fbddd00c7aaf96, https://si.imgix.net/36a06ce9/uploads/origins/4be8f4c1-7bd5-42ff-a3d0-8faccdcbb0de?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=33a518441e8937e33691d95650e23328 2x, https://si.imgix.net/36a06ce9/uploads/origins/4be8f4c1-7bd5-42ff-a3d0-8faccdcbb0de?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=4fd9db828ca69a90ccec43f98b5177ac 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/36a06ce9/uploads/origins/4be8f4c1-7bd5-42ff-a3d0-8faccdcbb0de?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c55aea82e53ab5a34a2673c43f6979e1", "srcset": "https://si.imgix.net/36a06ce9/uploads/origins/4be8f4c1-7bd5-42ff-a3d0-8faccdcbb0de?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c55aea82e53ab5a34a2673c43f6979e1, https://si.imgix.net/36a06ce9/uploads/origins/4be8f4c1-7bd5-42ff-a3d0-8faccdcbb0de?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=f3aad4dcf788d774c477ae1194cadce3 2x, https://si.imgix.net/36a06ce9/uploads/origins/4be8f4c1-7bd5-42ff-a3d0-8faccdcbb0de?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=a7e5ba0df97bdffae08248120c6ef5ce 3x"}, "body": "◯内容\nバナナの皮で尻餅をつくマエリベリー・ハーン\n◯要望\n・ショートブーツとコインローファーの差分付き\n※可能であればショートブーツは履き込まれていて傷や汚れがあると嬉しいです\n・バナナの皮の質感など以前描いていただいたサグメのイラストと同じ要領でお願いします\n・コマ割りのイメージは以前のスターサファイアのイラストをイメージしていますがお任せします\n◯詳細\n1.急いで走っているメリーの全身絵と足元にバナナの皮が落ちている\n2.足より大きさのある皮を足全体で踏みつける\nかかと部分の踏まれた所に、踏まれた圧でシワが出来る \n3.真横のアングルで足を滑らせ地面には滑った跡と液体が飛び散っている \n資料の様にスピード感のある動きの表現を加える\n4.表情は資料と同じ\n正面のアングルで尻餅をつく\n滑った足は汚れた靴底を見せる様に真正面に出して宙に浮いている \n足跡の付いた皮も勢いよく飛んでいる\n\nhttps://www.dropbox.com/scl/fo/prqr9x7abvib6g8r3kd85/AGQ3-DqaSSM3g3PlKy48I8o?rlkey=x5wkrpreks8hhqyfj3i9urpvv&st=8lhf7974&dl=0", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@tamakohanabi/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3581985, "client_id": 1095921, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/d1e1d262/uploads/origins/680e113f-e098-4e52-9d17-786a4baf8eef?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e51e37a0cf6673c9b6f0a38cd219d6ed", "srcset": "https://si.imgix.net/d1e1d262/uploads/origins/680e113f-e098-4e52-9d17-786a4baf8eef?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e51e37a0cf6673c9b6f0a38cd219d6ed, https://si.imgix.net/d1e1d262/uploads/origins/680e113f-e098-4e52-9d17-786a4baf8eef?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a69ba8c9cf6ace783c1334f9c32ccccb 2x, https://si.imgix.net/d1e1d262/uploads/origins/680e113f-e098-4e52-9d17-786a4baf8eef?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=73f5d4ff39fa9a8260b15efd717ed07f 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/d1e1d262/uploads/origins/680e113f-e098-4e52-9d17-786a4baf8eef?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9c62178aa9a9d9884bcca22f7cbc4b57", "srcset": "https://si.imgix.net/d1e1d262/uploads/origins/680e113f-e098-4e52-9d17-786a4baf8eef?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9c62178aa9a9d9884bcca22f7cbc4b57, https://si.imgix.net/d1e1d262/uploads/origins/680e113f-e098-4e52-9d17-786a4baf8eef?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=0284b0d073df26b11db478b47a35e656 2x, https://si.imgix.net/d1e1d262/uploads/origins/680e113f-e098-4e52-9d17-786a4baf8eef?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=d6102415f9f034d558b3779c5749226a 3x"}, "body": "◯お題\nスターサファイアがクリームで足を滑らせクリームパイをぶつける\n◯要望\n☆「ブーツ」「クリーム」は色付けと作画に力を入れて下さい\n・ブーツの描き方は原作と同じ丸みのあるつま先で色は濃い茶色（資料参考）\n・クリームは濁りのある白色で質感はドロっとしているイメージ\n・スターサファイアの服装と髪型は、「原作と同じ」又は「資料の様なエプロンとポニーテール」のどちらか（描きやすい方でお任せします）\n◯内容\n1.両足の靴底周りはクリームを踏んで汚れている\n地面はクリームが散らばっており、踏んだ跡や足跡が残っている\n2.つま先立ちになり、靴の甲には革特有のシワが出来る\n足は出来るだけ斜めに傾ける\n地面には滑った後のクリームが残る\n※「1」・「2」はコマ割りで、アングルは資料と同じでお願いします\n3.靴底をアップにした構図（資料参考）\nクリームを踏んで滑らせた靴底は、土踏まず以外の全体が汚れている\n吹き出しからスターサファイアの控えめに驚いた表情で、手に持っているクリームパイをサニーミルクとルナチャイルドに向けている（上体は起きているか・倒れているかはお待たせします）\nサニーとルナが顔面にクリームパイにかかる直前の状況で驚いている\n※下記はイメージとして記載ですので、内容はお任せします\n・二人は食卓の椅子に座っている\n・サニーは驚いた表情\n・ルナは栗の様な形を口にして、ムンクの叫びの様な表情\n・2人の描き方（デフォルメや通常絵）などはお任せします\n\n\n資料URL\n\nhttps://www.dropbox.com/scl/fo/bhdqvdcca0p8kptd4u1wu/AE7bcL0HwRjfy96mQeKCAeI?rlkey=qyhys2lie8plc41rsg82kbad9&st=xmv0nh0t&dl=0", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@tamakohanabi/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3581985, "client_id": 3492967, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/ce479aad/uploads/origins/43a118df-c818-46bf-bee2-540cae7f283b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=80cdf75a85ea0a176d8b6f6f7836f076", "srcset": "https://si.imgix.net/ce479aad/uploads/origins/43a118df-c818-46bf-bee2-540cae7f283b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=80cdf75a85ea0a176d8b6f6f7836f076, https://si.imgix.net/ce479aad/uploads/origins/43a118df-c818-46bf-bee2-540cae7f283b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=674548b3ecdb4aa9630d9e7a11de4a9d 2x, https://si.imgix.net/ce479aad/uploads/origins/43a118df-c818-46bf-bee2-540cae7f283b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f9d085170885a2f382e62a0e5bb5bd86 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/ce479aad/uploads/origins/43a118df-c818-46bf-bee2-540cae7f283b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=52505ee14157d9e856e070c24ce22a23", "srcset": "https://si.imgix.net/ce479aad/uploads/origins/43a118df-c818-46bf-bee2-540cae7f283b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=52505ee14157d9e856e070c24ce22a23, https://si.imgix.net/ce479aad/uploads/origins/43a118df-c818-46bf-bee2-540cae7f283b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=77cd7f0f5dc375bd868cdde505c6cb27 2x, https://si.imgix.net/ce479aad/uploads/origins/43a118df-c818-46bf-bee2-540cae7f283b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=782b8a7e629d332fd8c4e76321573c06 3x"}, "body": "こんにちは！\n\n僕の葉っぱの妖精「ハヤシ」のイラストを描いてくれませんか？\n東方Projectのオリジナルキャラクターです。\n\n今泉蜉蝣、関白、若鷺姫と一緒にイラストを描いてほしいんだけど、いいかな？\n\nシナリオは自由ですが、ほのぼのとした感じでいいと思います！\n\n背景とか！背景とか！\n\nhttps://drive.google.com/file/d/1sXmanB3cMh5dos05XhOwX75cCtUGwXyx/view?usp=drive_link", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@tamakohanabi/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3581985, "client_id": 1095921, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/9037e173/uploads/origins/5530f40b-388a-4c57-93b0-835e95e2ae2b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=28e38e99841eb0425c0e9210ece3bbf0", "srcset": "https://si.imgix.net/9037e173/uploads/origins/5530f40b-388a-4c57-93b0-835e95e2ae2b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=28e38e99841eb0425c0e9210ece3bbf0, https://si.imgix.net/9037e173/uploads/origins/5530f40b-388a-4c57-93b0-835e95e2ae2b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=0f673faa73287fa35c129d5c9428e022 2x, https://si.imgix.net/9037e173/uploads/origins/5530f40b-388a-4c57-93b0-835e95e2ae2b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=59a98eaf1c7d49831ef9286ab9c4b8d7 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/9037e173/uploads/origins/5530f40b-388a-4c57-93b0-835e95e2ae2b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=7ddba8bc06a501da19888101d74d8584", "srcset": "https://si.imgix.net/9037e173/uploads/origins/5530f40b-388a-4c57-93b0-835e95e2ae2b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=7ddba8bc06a501da19888101d74d8584, https://si.imgix.net/9037e173/uploads/origins/5530f40b-388a-4c57-93b0-835e95e2ae2b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=fcb8a397f771fb5353f237c202aa05f0 2x, https://si.imgix.net/9037e173/uploads/origins/5530f40b-388a-4c57-93b0-835e95e2ae2b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=55da99585e72a76995ed64a02767f11b 3x"}, "body": "◯内容\nバナナの皮で転ぶサグメ\n◯要望\n☆「ブーツ」「バナナの皮」「粘液」の作画には力を入れて欲しいです\n・ブーツは茶色の革製で白の✖️紐が二つ付きで、靴底の描き方は靴底はローファーにあるタイプで、土踏まずとヒールがはっきりと区別した描き方（資料参考）\n※靴底が全て平な描き方はNG\n・バナナの皮はテカリとヌメヌメ感のある質感\n・粘液の描き方はバナナの中身をすり潰した様なイメージ\n◯詳細\n1.皮の中心部分を踏みつける\nつま先になり、靴の甲には革特有の皺が出来る\nバナナの皮は踏みつけた圧で靴底側面に食い込む\n2.「1」の構図を真横のアングルで描写\n地面には滑った跡の粘液が残る\n※「1」「2」は足の描写のみのコマ\n3.ポーズと表情は資料参考\n膝を着いて上体は起こして振り向き、口元を抑えながら汗が出ている\n靴底にはバナナの粘液で汚れている\n足元には足跡のついたバナナの皮がある\n空きスペースにはバナナの皮で転んだうどんげの存在と脱げたローファーが描写されている（下半身だけの描写やデフォルトなど内容はお任せします）\n\n資料URL\nhttps://www.dropbox.com/scl/fo/xrqmt0o2aprqwya208foe/AJQSja_SwQGB_MZiJN1jnWM?rlkey=m90uokfz6qcuqcfth29cdsvle&st=ut3in9qm&dl=0", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@tamakohanabi/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3581985, "client_id": 799016, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/1da6ac82/uploads/origins/e34cc161-0024-4cf0-87b3-c68a3a268e6b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8cffb66fa32bd193f5ea0dd4c0d760cd", "srcset": "https://si.imgix.net/1da6ac82/uploads/origins/e34cc161-0024-4cf0-87b3-c68a3a268e6b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8cffb66fa32bd193f5ea0dd4c0d760cd, https://si.imgix.net/1da6ac82/uploads/origins/e34cc161-0024-4cf0-87b3-c68a3a268e6b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=0146cdb3a093a60f46d777a2a0ea5d94 2x, https://si.imgix.net/1da6ac82/uploads/origins/e34cc161-0024-4cf0-87b3-c68a3a268e6b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=86b3a5a1b822330f3b7f68b7f54a480f 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/1da6ac82/uploads/origins/e34cc161-0024-4cf0-87b3-c68a3a268e6b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=979c16f7bff10dd32392175b02acbb0d", "srcset": "https://si.imgix.net/1da6ac82/uploads/origins/e34cc161-0024-4cf0-87b3-c68a3a268e6b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=979c16f7bff10dd32392175b02acbb0d, https://si.imgix.net/1da6ac82/uploads/origins/e34cc161-0024-4cf0-87b3-c68a3a268e6b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=f7c4fc739a98fe1d28b52f27f86b57fc 2x, https://si.imgix.net/1da6ac82/uploads/origins/e34cc161-0024-4cf0-87b3-c68a3a268e6b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=f06c407623cd0f953d971b7c59b644ef 3x"}, "body": "たまはな様\n\n前回は素敵なイラストをありがとうございました。\nよろしければまたリクエストをさせて頂きたいと思います。\n\n今回もまた草の根の三人のイラストをお願いします。\n秋ということもありまして三人でお月見をしている姿を描いていただきたいのですが、満月だと影狼が体毛を気にしてしまうと思うので三日月を眺めることにすれば何も気にかけることもなくお月見ができると思いますのでそのように描いていただけますと幸いです。\n服装に関してはせっかくのお月見なので赤蛮奇も影狼も着物や浴衣を着させていただきたいのですが、わかさぎ姫に関しましてはいつもの着物でも大丈夫ですしいつもと違ったものを着ていてもどちらでも構いません。\n場所に関しては決められなかったので竹林やわかさぎ姫の住む湖、あるいはこの2つ以外の場所でもたまはな様が思い浮かぶ場所で描いて頂ければと思います。\nまた、お月見といえばお月見団子かなと思いましたが、もしイラスト内に描いて頂ける場合ピラミッドのように積まれている一番上のお団子は満月を模した黄色いお団子か、もしくは今回見るのが三日月なので白と黄色が混ざった団子で黄色い部分が三日月のように見えるお団子や思い切って完全に三日月の形をしたお団子などが思いつきましたので不自然に感じなければ採用してみてください。\nそのような団子は現実にはなさそうですが幻想郷には優秀なお団子屋さんが少なくとも二人はいるのできっと作れるのではないかと思います。\nもちろん普通の黄色いお団子もしくは白いお団子だけのほうがしっくり来るようでしたらそちらを採用してください。\n\n以上がリクエスト内容になりますが、もしもたまはな様がお月見は満月のほうが好ましいとお考えの場合は三日月に関する私のお願いは無視していただいて構いません。\n服装に関しても普段の姿がいいと思われましたらそのように描いていただければと思います。\nこちらの内容でもよろしければご一考いただけますと幸いです。\nよろしくお願いします。", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@tamakohanabi/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3581985, "client_id": 375679, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/a517464d/uploads/origins/14194870-f0cd-4fcb-b2c5-5817a4b774e8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=33b438787c631820940eab2a9c5acfed", "srcset": "https://si.imgix.net/a517464d/uploads/origins/14194870-f0cd-4fcb-b2c5-5817a4b774e8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=33b438787c631820940eab2a9c5acfed, https://si.imgix.net/a517464d/uploads/origins/14194870-f0cd-4fcb-b2c5-5817a4b774e8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=71480a5f55c41c117b6194789b6f1f86 2x, https://si.imgix.net/a517464d/uploads/origins/14194870-f0cd-4fcb-b2c5-5817a4b774e8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=cbd711aa5d2478b1c312ff53d00c455c 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/a517464d/uploads/origins/14194870-f0cd-4fcb-b2c5-5817a4b774e8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=dd03d6c48904fd730fa15c4481497cc3", "srcset": "https://si.imgix.net/a517464d/uploads/origins/14194870-f0cd-4fcb-b2c5-5817a4b774e8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=dd03d6c48904fd730fa15c4481497cc3, https://si.imgix.net/a517464d/uploads/origins/14194870-f0cd-4fc