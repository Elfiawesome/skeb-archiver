\n昔の自分がまだそこにいるようで、その自分を否定したくて、苛立つほどにいきり勃つペニスを男娼の菊門にねじ込んでは朝まで思いの丈を吐き出していった。\n\n●内容\nスヴァルがショタをバックで攻めている作品をお願いします。\nショタは顔が見えなくてOK、スヴァルも全裸でOKです。\n詳細はお任せ。\nよろしくお願いします。\n\nhttps://pbs.twimg.com/media/E0IUIkXVUAAO_32?format=jpg&name=large", "nc": 171, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@ysk_o_o_/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 727632, "client_id": 582321, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/08aa627b/uploads/origins/2cc792de-d48c-4dc2-b00e-a5cb265ff61c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=08b69b4dea5d631460d164874d30c7a0", "srcset": "https://si.imgix.net/08aa627b/uploads/origins/2cc792de-d48c-4dc2-b00e-a5cb265ff61c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=08b69b4dea5d631460d164874d30c7a0, https://si.imgix.net/08aa627b/uploads/origins/2cc792de-d48c-4dc2-b00e-a5cb265ff61c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=636068aaa6c8ce5aa0253f589eb6c4c6 2x, https://si.imgix.net/08aa627b/uploads/origins/2cc792de-d48c-4dc2-b00e-a5cb265ff61c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=425cba157a1108d969c3bd0193f5fb9b 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/08aa627b/uploads/origins/2cc792de-d48c-4dc2-b00e-a5cb265ff61c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=06464a58d9ece8cfea62b660d571b89d", "srcset": "https://si.imgix.net/08aa627b/uploads/origins/2cc792de-d48c-4dc2-b00e-a5cb265ff61c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=06464a58d9ece8cfea62b660d571b89d, https://si.imgix.net/08aa627b/uploads/origins/2cc792de-d48c-4dc2-b00e-a5cb265ff61c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=