ceived_works": [{"path": "/@gm_star330/works/229", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 742135, "client_id": 3738056, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/0274e985/uploads/origins/e207fb38-b51d-4186-b436-910209cf285e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6a577c376fbc768f75a59b914db55cdf", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/0274e985/uploads/origins/e207fb38-b51d-4186-b436-910209cf285e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=28b0d5546155c118890d09758ecad3be", "src_set": ""}, "body": "こんにちは！あなたの画風は素晴らしいと思うので、私のオスッテの絵をお願いしたいです！\n\n性格は、礼儀正しく、のんびりしている。注目の的となることは好まないが、必要な時には偉大なリーダーとなる。一人でいることを好む。しかし、戦闘においては真剣で、非常に熟練したウォリアーでもある。\n\n彼のカジュアルな衣装を用意したので、リラックスしたポーズとシナリオをお願いしたい。彼はクガネで生まれ育ったので、クガネで過ごすことが多いですが、イシュガルドで過ごすことも好きです。詳細はお任せします！\n\nメガネやそばかすなど、細部にご注目ください！爪は黒く塗っていて、手には傷がある。\n\nよろしくお願いします！\n\nhttps://drive.google.com/file/d/1-iOCPQA70Tc-F_USRYbtaZ4dolaIsewj/view", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@gm_star330/works/228", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/68bfa1d1/uploads/origins/c87bd981-2b64-4502-a5c2-72017719d3c0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=7c1a49ee2d73b43de21885eeed361d84", "src_set": ""}, "private": true, "genre": "art", "tipped": true, "creator_id": 742135, "client_id": 3721314, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 0, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@gm_star330/works/227", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 742135, "client_id": 2709026, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/f9630ea3/uploads/origins/f8367b36-d4fd-42c7-b260-6dc594e6239b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=efe3875f2f0766e5f5fdc4b669c8642c", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/f9630ea3/uploads/origins/f8367b36-d4fd-42c7-b260-6dc594e6239b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b365143642171f6563e36dea3381ca29", "src_set": ""}, "body": "(Skebのポリシー上、韓国語で書くことになったことをご了承ください。)\n\nこんにちは。久しぶりに依頼をさせていただくことになりました。\n\n今回の依頼はテーマのみの依頼で、「Zinc Oxideの誕生日記念イラスト」をお願いしたいと思います。\n\n詳細は自由ですが、1:1で正面を向いて対面している、少し落ち着いた大人っぽい雰囲気でお願いします。\n\n雰囲気決定に大きな影響を与えたイラスト： https://x.com/komura_sandro/status/1872127374684565640/photo/1\n\n必須ではありませんが、もしお酒を飲む場合はシャンパン（淡い黄色＋炭酸）でお願いします。\n\n衣装は基本衣装（ジャケット付き）でも構いませんし、判断次第で半袖だけで筋肉を強調したり、雰囲気に合わせて他の衣装でも構いません。\n\nよろしくお願いします。ありがとうございました。\n\nhttps://drive.google.com/drive/folders/1VGG5D4_jxKLVNYPQymGR2aiKklE8FjYR?usp=sharing", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@gm_star330/works/226", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 742135, "client_id": 208904, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/0c6c7cf0/uploads/origins/465fd426-bc7e-4be5-ad79-293fd3314199?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e7892bfc29db7262133da238b88f3271", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/0c6c7cf0/uploads/origins/465fd426-bc7e-4be5-ad79-293fd3314199?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=948c69f8c8234d9ce7cdc0ba75c3d39c", "src_set": ""}, "body": "私の自機（ロスガル）を描いてもらいたくて依頼してみました。 依頼したい内容が3つあります。  \n\nhttps://drive.google.com/file/d/1IsfiTlDo6AwieO1yQkdqL8sqLZaup3lF/view?usp=drivesdk（全体図）  \n\nhttps://drive.google.com/file/d/1El_pVdFHsuk-9dziF1iAQOlOYuF_iDWu/view?usp=drivesdk （顔アップ）  \n\nhttps://drive.google.com/file/d/1EziVB4v-8XcGhpPwXYMwdTuNZqBJErV4/view?usp=drivesdk （後ろ横姿）  \n\nひとつ目 \nポーズは占星術師の戦いに備える（男）でカードを右手で取り出す姿で、左手には武器が無くて腰に添えてるところでお願いします。 \n服は全体図に貼った服装でお願いしたいです。表情はウオリの好きな表情で大丈夫です。 \n\n ふたつ目 \nもし良ければ、こちらのリンク下で自機に着せたいです。 https://x.com/nerpzs3gwdsqqy5/status/1944673475245039830?s=46&t=YkGkA8qHrYABXdhxt1U7cQ \n\n 占星術師なので　薄い白文字の H1 で ドロー命 でお願いします。またヒーラーなので薄い緑色？かなぁ　でTシャツを着せたいです。\n（ポーズは出来たらひとつ目にお願いしたポーズでお願いしたいですが、ウオリさんの好みで大丈夫です。表情もウオリさんの好みで大丈夫です。）  \n\nみっつ目 \nウオリさんが良ければエックスのアイコンや今度イベントで赴く時に名刺に使いたいなと考えています。\n（ウオリさんが描きましたと紐付けます。）  \n\nもし、作業が多くて大変であれば、\nひとつ目にお願いした服を全体図とふたつ目の服　2パターンにせずに、ふたつ目に依頼した上の服　Tシャツに統一しても大丈夫です。ズボンは全体図に貼った写真が見れると思います。\n（スカイワーカー・ボトムというズボンです。）\n\n  色々お願いしてしまいましたが ウオリさんが良ければ描いて貰いたいです。 よろしくお願いします。  （資料URLに全体図だけ貼っておきます。）\n\nhttps://drive.google.com/file/d/1IsfiTlDo6AwieO1yQkdqL8sqLZaup3lF/view?usp=drivesdk", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@gm_star330/works/225", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 742135, "client_id": 1426064, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/4cab2d6f/uploads/origins/fea3e790-97e4-4347-950b-b1361396dd12?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9c8450669a4d333c180ea919f4a9c175", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/4cab2d6f/uploads/origins/fea3e790-97e4-4347-950b-b1361396dd12?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=99560217ee2fc2ea3392fe631cab4ace", "src_set": ""}, "body": "こんにちは！私のOC、龍玄ドレイクのFFXIVバージョンを依頼したいです！FFXIVを参考にして依頼するのは初めてなので、わかりやすいと嬉しいです！もし参考になれば、彼がどんな装備を持っているかも説明します！\n\n龍玄ドレイク」は、ストイックで面倒見がいいが頑固な性格のアウトローです。見た目は真面目で、少し怒りっぽい。彼は大切な人たちの安全のために戦いたいと思っているが、少し行き過ぎた行動に出ることもある。  武器はクリプトラーカー・ディフェンダーとクリプトラーカー・マナトリガー。しかし、ヘルメットはかぶっておらず、代わりにサマーサンセット・バンダンナを着用している！\n\nポーズはお任せしますが、リュウゲンのカッコイイ作品を探しています！ガンブレードを持ったポーズもカッコイイと思います！ストイックで、どこか怒っているように見えればOKです。\n\nまた、イラストを楽しみにしています！\n\nhttps://x.com/ryuugenffxiv/status/1947995196077359557", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@gm_star330/works/224", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/d3ae009c/uploads/origins/5c948b61-4d4d-45c7-96d3-71b64fb702f1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=d61ac0dc0ba7ed63339e0d886565cd65", "src_set": ""}, "private": true, "genre": "art", "tipped": false, "creator_id": 742135, "client_id": 203884, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 48, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@gm_star330/works/223", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/5da7bfc5/uploads/origins/12a1dca6-aed6-4cb3-b2e6-ec65c1b85901?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=62b7d4eb83afbed98c4a867a662f7a13", "src_set": ""}, "private": true, "genre": "art", "tipped": false, "creator_id": 742135, "client_id": 169095, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 49, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@gm_star330/works/222", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/be787b60/up