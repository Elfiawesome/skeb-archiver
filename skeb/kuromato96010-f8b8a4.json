afcf7c42ef08b83cab4ec0, https://si.imgix.net/d488a54c/uploads/origins/e1cbde82-2aae-436a-80b6-a531ac1769ea?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=5637ec06a549a16928fe3a5e69f590ea 2x, https://si.imgix.net/d488a54c/uploads/origins/e1cbde82-2aae-436a-80b6-a531ac1769ea?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=aa7ef9ad57ad47e46e8e218a35684642 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/d488a54c/uploads/origins/e1cbde82-2aae-436a-80b6-a531ac1769ea?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=098339396c087a26ebd3e31a7bb3eb59", "srcset": "https://si.imgix.net/d488a54c/uploads/origins/e1cbde82-2aae-436a-80b6-a531ac1769ea?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=098339396c087a26ebd3e31a7bb3eb59, https://si.imgix.net/d488a54c/uploads/origins/e1cbde82-2aae-436a-80b6-a531ac1769ea?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=1a07615a8064e482bc17b398e17d98ac 2x, https://si.imgix.net/d488a54c/uploads/origins/e1cbde82-2aae-436a-80b6-a531ac1769ea?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=838cbe7f64c3c1b3390ec319c1ea2c05 3x"}, "body": "くろまと様\n\nはじめまして！\n個人でVTuber活動をしております、森永ここあ と申します。\nくろまと様のとってもとってもかわいいイラストを拝見して、ぜひ私のイラストも描いていただきたいと思い依頼させていただきました！\n\n【依頼内容】\n・森永ここあ（私）のイラストをお願いいたします。\n・髪型も服装も構図も くろまと様にお任せいたします。服装も和服でなくて全然構いません！\n・表情は照れ顔か ちょっと困り顔だとうれしいです！\n・サムネイル等にも使用させていただきたいので人物の上部と左右が見切れないもの、また可能でしたら背景と人物を分けたデータをいただけると幸いです。\n\n\n【自己紹介】\n名前：森永ここあ🦊🍫\nイチゴとココアが好きな銀色の妖狐。しっぽの数は2本。\n九尾の狐になるために人間界で修行中。\n本体は銀色の狐だが、人型に化けるときは人間界に馴染むように髪の毛をココア色にしている。\n好きな色は赤と緑。\n\n以下に参考資料を添付させていただきます。\nhttps://drive.google.com/drive/folders/1hcdBM2hfYgs7kag96u2faE0yGDPthMzc?usp=sharing\n\n紛らわしいポイントをピックアップさせていただきました。紛らわしくて申し訳ありません！\n・髪の毛はオレンジ味のかかった茶色\n・八重歯と髪飾りは左のみ\n・人耳はなく狐耳のみ\n・しっぽは二本(もっふもふにしていただきたいです)\n・しっぽと狐耳は銀色\n\n重複してしまいますが服装や髪形、装飾品などは変更いただいてかまいません！\n\n\n【使用用途】\nXをはじめとするSNSへの投稿、サムネイルなどのYouTubeでの使用、ネットプリントやグッズに使用させていただく可能性があります。\n使用不可のものがございましたら、お手数ですがイラストデータにご記載いただければと思います。\n\n\n余談ですが私もボカロ好きです！ずっとリンちゃんとレンくんに夢中です…。\nお忙しいと思いますが、ご検討いただけると幸いです。\nどうぞ、よろしくお願いいたします！！\n\nhttps://drive.google.com/drive/folders/1hcdBM2hfYgs7kag96u2faE0yGDPthMzc?usp=sharing", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 1528602, "creator": true, "nsfw_acceptable": false, "acceptable": false, "name": "あわば", "screen_name": "oyasumisan", "avatar_url": "https://pbs.twimg.com/profile_images/1688588506740756480/NUn9fLbN.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1115321128484888584/1667685625/1500x500", "appeal_receivable": true, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 90, "skills": [{"genre": "art"}], "nc": 128}, {"id": 1973155, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "ʜᴏᴛᴀᴛᴇ. 🥞5/9 メイド博！🍓【B-17】", "screen_name": "hotatetatetate", "avatar_url": "https://pbs.twimg.com/profile_images/1435477796277551105/VvB-U2AX.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1435442830776799236/1631079668/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "art"}, {"genre": "voice"}], "nc": 144}, {"id": 2563927, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "rowata", "screen_name": "68ta_2", "avatar_url": "https://proxy.misskeyusercontent.jp/avatar/media.misskeyusercontent.jp%2Fio%2F5b91bae7-d0a5-4330-8a2e-3ff84a210bc9.png%3Fsensitive%3Dtrue?avatar=1", "header_url": "https://media.