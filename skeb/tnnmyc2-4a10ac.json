ea6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0ca9bc35a5c4a33b9b1334b72dea8518, https://si.imgix.net/5b52a737/uploads/origins/3f74f1ba-4101-414d-87b1-8f777115cea6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=55131817e4a81b127e36639f32822d50 2x, https://si.imgix.net/5b52a737/uploads/origins/3f74f1ba-4101-414d-87b1-8f777115cea6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=1e40e1dc3de98f34216e3b9048243d26 3x"}, "body": "白い蛾の婿　最高でした。\nあなたのおかげでNTRの快楽に目覚めました……これが……脳破壊！！！\n\nというわけで投げ銭も兼ねて依頼します。\n\n原作・白い蛾の婿　\n依頼対象。草夆真桜の立ち絵。\n用途、TRPGにおけるPCあるいはNPCして『シナリオ上求められる様々な用途』に使用\n『人間の形状』を汎ゆる意味で保っていた時期の彼女が胸をアピールするような服装をして、明日、彼氏と合って『楽しむ』日を楽しみにしているような――そんな感じの、ちょっとエッチでハッピーな感じの彼女の立ち絵をお願いできないでしょうか。\n……可能であれば、顔だけが『あの図』の容貌になる差分があれば幸福ですが、これはまぁ無理はなさらずに……\n\nAI使用については承諾いただいておりますので、色々使いますが。、それとは別に画像背景の透過差分等をいただけると助かります。\n\nでは、NTR異種間――次回作を楽しみにさせて抱きます。", "nc": 51, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@tnnmyc2/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "video", "tipped": false, "creator_id": 3964530, "client_id": 3531089, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/c895a4c5/uploads/outputs/ee643dc1-804a-44ca-ae8e-886500c74cdf?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&s=3feba548dbf6e3856659bf34936cec8a", "srcset": "https://si.imgix.net/c895a4c5/uploads/outputs/ee643dc1-804a-44ca-ae8e-886500c74cdf?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&s=3feba548dbf6e3856659bf34936cec8a, https://si.imgix.net/c895a4c5/uploads/outputs/ee643dc1-804a-44ca-ae8e-886500c74cdf?bg=%23fff&fm=webp&auto=compress&dpr=2&fit=crop&crop=top&w=200&h=200&s=0193e5e7ec209c4d1dbed8fb15b70011 2x, https://si.imgix.net/c895a4c5/uploads/outputs/ee643dc1-804a-44ca-ae8e-886500c74cdf?bg=%23fff&fm=webp&auto=compress&dpr=3&fit=crop&crop=top&w=200&h=200&s=76ac499465c1dbbffd