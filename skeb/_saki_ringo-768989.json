ものをファイル別々で頂きたいです。 \n・サムネイル等に使いたい為、ケモ耳、しっぽなどの髪の毛、体の一部が見切れないようにお願い致します。   \n\n説明不足のところがあるかと存じますが、\n 何卒ご検討のほどよろしくお願い致します。\n\n恋ノ牙ナズナ\n\nhttps://www.dropbox.com/scl/fo/gpezys6ir10n1v21yuqb2/AOfnd_QJtoVbSh2RKFTpUxM?rlkey=2gx9lxi2sdl630tt49vo9du3v&st=q9tmw7oq&dl=0", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@_saki_ringo/works/14", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/717c733a/uploads/origins/8b4f6776-25a0-4d70-ab07-6004ea3343f2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=802dbc06ff0d2545b84198db86a66ac4", "srcset": "https://si.imgix.net/717c733a/uploads/origins/8b4f6776-25a0-4d70-ab07-6004ea3343f2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=802dbc06ff0d2545b84198db86a66ac4, https://si.imgix.net/717c733a/uploads/origins/8b4f6776-25a0-4d70-ab07-6004ea3343f2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=3391d4c7d68a6a58af1537a55c3a6bcd 2x, https://si.imgix.net/717c733a/uploads/origins/8b4f6776-25a0-4d70-ab07-6004ea3343f2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=6aa3ea54c4baef8aeafd6011a501b0ec 3x"}, "private": true, "genre": "art", "tipped": true, "creator_id": 2869935, "client_id": 2051494, "nc": 17}, {"path": "/@_saki_ringo/works/13", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/be4d2243/uploads/origins/e98b443b-de3b-4d1b-9df1-a5e0a587bd9f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsi