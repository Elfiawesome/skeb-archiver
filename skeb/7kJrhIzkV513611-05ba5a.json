to=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=aeb3b05ff3e10ccbaa68ac70f0bb2cf3, https://si.imgix.net/03136218/uploads/origins/e9124e5a-807e-4cef-8389-3333c32678fb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=db281809019de172fec1cf3436ac15b7 2x, https://si.imgix.net/03136218/uploads/origins/e9124e5a-807e-4cef-8389-3333c32678fb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=211a272f17f06876a64ab0b9bfd7a684 3x"}, "body": "初めまして！\nPC前に座っているイラストがとても素敵でぜひ自分を描いていただきたく、依頼失礼いたします。\n\n・描いていただきたいキャラクター\nhttps://drive.google.com/drive/folders/1ZybhWwHvZL0841ZrzdxH4N057xCZsAxl?usp=drive_link\n「00 live2d用立ち絵.png」\n\n・構図について\n　他の方のイラストのように、ゲーミングPCの前にゲーミングチェアで座っている構図でお願いしたいです。\n　https://skeb.jp/@7kJrhIzkV513611/works/10\n\n　モニターは置けたら３枚、部屋のイメージは白ピンクでお願いしたいです。\n　イメージ動物はホッキョクギツネのため、他の方みたいにぬいぐるみを置いてほしいです。\n　参考資料の中の「【参考2】ホッキョクギツネ」でお願いします。\n\n★使用用途\n・他の方へ依頼する際にお部屋の参考資料として依頼\n・Xでの使用（おはV等やサムネ発信）\n・収益化ONの配信内での使用\n・サムネイルやヘッダー、バナーでの使用\n・ネットプリント\n・グッズ化などの商用利用\n\n・イラストはお手数でなければ、【PSDでレイヤー分けデータ】または【サイン等ある通常のデータ、サイン等なしの人物個々の透過データを別々】で頂けると助かります。\nその際人物の透過はサムネなどで使いやすいように、手や髪は見切れないようにしていただきたいです。\n\nよろしくお願いします。", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@7kJrhIzkV513611/works/13", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3640720, "client_id": 3370380, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/cc26fbde/uploads/origins/75103426-6978-44b2-94bb-57a1980cc7ea?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8a4bbfbe518d5a57844480939885dea9", "srcset": "https://si.imgix.net/cc26fbde/uploads/origins/75103426-6978-44b2-94bb-57a1980cc7ea?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8a4bbfbe518d5a57844480939885dea9, https://si.imgix.net/cc26fbde/uploads/origins/75103426-6978-44b2-94bb-57a1980cc7ea?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=9fc1285b30ec9045c54298285ba536ee 2x, https://si.imgix.net/cc26fbde/uploads/origins/75103426-6978-44b2-94bb-57a1980cc7ea?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d9909efb8ceef14759ec610dc7184ed7 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/cc26fbde/uploads/origins/75103426-6978-44b2-94bb-57a1980cc7ea?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2bae3d2fb1dc2a5fbe697c436b045942", "srcset": "https://si.imgix.net/cc26fbde/uploads/origins/75103426-6978-44b2-94bb-57a1980cc7ea?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2bae3d2fb1dc2a5fbe697c436b045942, https://si.imgix.net/cc26fbde/uploads/origins/75103426-6978-44b2-94bb-57a1980cc7ea?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=e98ea4324c2a69828dcae9047bd771fa 2x, https://si.imgix.net/cc26fbde/uploads/origins/75103426-6978-44b2-94bb-57a1980cc7ea?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=f75485159005caddee18526685569a7e 3x"}, "body": "こんにちは！はじめまして。あなたのアートスタイルがとても気に入りました。私のVTuberのために何か描いていただけないでしょうか？　彼女の名前はネフェリで、「The Drifting Cloud」という小さな酒場を営む「天界の狐」です。そこで、お酒を飲みながらお客さんと交流を楽しんでいます。 彼女はとても思いやりがあり、遊び心のある一面も持っています。ポーズや構図は、こちらの画像のような感じにしていただきたいです：\nhttps://skeb.jp/@7kJrhIzkV513611/works/5\nネフェリが配信の準備をしているような感じで、ゲーミングPCの前でキャラクターを描いていただきたいです。また、机の上に飲み物（お酒でも構いません！）と一緒に、私のマスコットキャラクターも加えていただけると嬉しいです。\n\nこのイラストは、Xでのソーシャルメディア投稿や、YouTube・Twitch用のサムネイル作成などに使用します。また、頭部が切り取られないよう、キャラクターの透明背景版もご提供いただけると大変助かります。\n\nご検討いただきありがとうございます！\n\nhttps://drive.google.com/drive/folders/1MwPKSD_mEcsZ4LbNmZmZnuZAK1T_HM3H?usp=sharing", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@7kJrhIzkV513611/works/12", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3640720, "client_id": 3427631, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/d6e845b8/uploads/origins/b001c5f9-747c-49c5-8b7c-2c01c69931ea?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2b384ecb61e4278ae49fd2657c4729a5", "srcset": "https://si.imgix.net/d6e845b8/uploads/origins/b001c5f9-747c-49c5-8b7c-2c01c69931ea?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2b384ecb61e4278ae49fd2657c4729a5, https://si.imgix.net/d6e845b8/uploads/origins/b001c5f9-747c-49c5-8b7c-2c01c69931ea?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=148a2f16836bc2b711b2fe9aa6494eea 2x, https://si.imgix.net/d6e845b8/uploads/origins/b001c5f9-747c-49c5-8b7c-2c01c69931ea?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e0bda50ff5efe38a1a3bc412153c6ca6 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/d6e845b8/uploads/origins/b001c5f9-747c-49c5-8b7c-2c01c69931ea?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=575b53472aaadf29c3cb2576c6daf35a", "srcset": "https://si.imgix.net/d6e845b8/uploads/origins/b001c5f9-747c-49c5-8b7c-2c01c69931ea?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=575b53472aaadf29c3cb2576c6daf35a, https://si.imgix.net/d6e845b8/uploads/origins/b001c5f9-747c-49c5-8b7c-2c01c69931ea?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=00c28ba3bf39063e9d67b577ba10911b 2x, https://si.imgix.net/d6e845b8/uploads/origins/b001c5f9-747c-49c5-8b7c-2c01c69931ea?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=84ac168df363beac53b9757bb79a0308 3x"}, "body": "こんにちは、まただぼくさん。Skebであなたの作品を見ましたが、そのかわいい画風がとても気に入りました。そこで、私のVTuber「nvyna」を描いていただけないでしょうか？\n\n彼女の名前はnvynaで、男の子がアンドロイドの女の子になったキャラクターです。耳を含めて身長155cm、耳を除くと148cmで、明るく子供っぽい性格です。また、ビデオゲームとお菓子が大好きです。\n\nイラストについては、全体のポーズや構図はあなたにお任せしたいのですが、近々迎える私の誕生日に、無料で配布できる壁紙として使いたいので、16:9の比率で描いていただけると助かります。また、着ている服は、もしよければ変更していただいても構いません。\n\n報酬額が不十分であれば、ご自身で適切な金額に調整してください。その金額を支払えるかどうか検討させていただきます。\n\nこのイラストは、個人利用、SNS、および無料配布用の壁紙として使用させていただきます。\nよろしくお願いします！\n\nhttps://drive.google.com/drive/folders/1aZEwcpgK_nbFoGnI5RuqMjwxQPUMKJlT?usp=sharing", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@7kJrhIzkV513611/works/11", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3640720, "client_id": 3564905, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/e8b84ec1/uploads/origins/fcb90eb2-4f71-499c-97c4-9eca01abfc94?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=61fbbf4c608a5eea313efbccd9b79425", "srcset": "https://si.imgix.net/e8b84ec1/uploads/origins/fcb90eb2-4f71-499c-97c4-9eca01abfc94?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=61fbbf4c608a5eea313efbccd9b79425, https://si.imgix.net/e8b84ec1/uploads/origins/fcb90eb2-4f71-499c-97c4-9eca01abfc94?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b29b39440a2253b1e2ff9cf50cceb344 2x, https://si.imgix.net/e8b84ec1/uploads/origins/fcb90eb2-4f71-499c-97c4-9eca01abfc94?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=20766a6830fc8785f113a765360fdd27 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/e8b84ec1/uploads/origins/fcb90eb2-4f71-499c-97c4-9eca01abfc94?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c4f360ee18e0807d8ab8513c5c951bec", "srcset": "https://si.imgix.net/e8b84ec1/uploads/origins/fcb90eb2-4f71-499c-97c4-9eca01abfc94?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c4f360ee18e0807d8ab8513c5c951bec, https://si.i