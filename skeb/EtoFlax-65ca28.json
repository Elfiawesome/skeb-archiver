首は見えない感じで)\n高校生は逆アナル中は裸です\n擬音多めで射精前と射精後で表情と台詞の差分をお願いします\n逆アナル中に断面図の表示をお願いします\n(男に直接描くような感じです)\n男の台詞は無しで\nメスガキの台詞は敬語口調で\nロリコンの男子高校生をおっぱいで釣った後\nふたなりペニスを見せつけてレイプ宣言をして\nふたなりペニスで蹂躙して\n自分におこづかいを貢ぐようにさせる感じでお願いします", "nc": 168, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 22430, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "さしみ", "screen_name": "SASHiMi", "avatar_url": "https://pbs.twimg.com/profile_images/1603687399439335424/-Ue8HPmT.jpg", "header_url": "https://pbs.twimg.com/profile_banners/395024200/1780673878/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "art"}], "banned": false, "nc": 48}, {"id": 40796, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "broiler", "screen_name": "broiler_u", "avatar_url": "https://pbs.twimg.com/profile_images/1968692531132252162/tGq3wKhK.jpg", "header_url": "https://pbs.twimg.com/profile_banners/966646907056488448/1783193872/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "art"}], "banned": false, "nc": 161}, {"id": 1421731, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "一際", "screen_name": "snowpowder198", "avatar_url": "https://pbs.twimg.com/profile_images/1849609947283378177/OXaZ1Zwv.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1849609773005799424/1733397651/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 