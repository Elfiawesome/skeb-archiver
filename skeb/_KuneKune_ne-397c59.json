mpress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=cb7169475c663a0b94574f3aa65546df 2x, https://si.imgix.net/a9eac532/uploads/origins/ccd6da50-0e5b-4b12-929e-ec5e5f20e000?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=418ef101a7528fe196e1313358db3962 3x"}, "body": "はじめまして　絵を拝見しウマ娘のクロノジェネシスをお描きしてもらいたいと思いご依頼させていただきました。\n用途として完全個人用の抱き枕カバー用のイラストをお描きしてもらいたいと思っており、服装は勝負服で。体勢は仰向けで背景はベッド、顔の上に手が来ないようにお願いします。表情違いのpsdが欲しいです。\n解像度は5,217 x 16,044でお願いします。\n\nご検討いただけますと幸いです。\n\nhttps://drive.google.com/drive/folders/1JDXCyA6hH9wx8o4yRUfcLJOc6hvgAy4M?usp=sharing", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@_KuneKune_ne/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1091998, "client_id": 1960223, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/4bdce859/uploads/origins/764c2639-0398-4bba-b607-7dd002657777?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9412c18056669273225be18351c02b76", "srcset": "https://si.imgix.net/4bdce859/uploads/origins/764c2639-0398-4bba-b607-7dd002657777?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9412c18056669273225be18351c02b76, https://si.imgix.net/4bdce859/uploads/origins/764c2639-0398-4bba-b607-7dd002657777?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=9e225c338299ede73602e8774e077de8 2x, https://si.imgix.net/4bdce859/uploads/origins/764c2639-0398-4bba-b607-7dd002657777?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=fe96b91750c24a6300b7c7031b4d07a5 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/4bdce859/uploads/origins/764c2639-0398-4bba-b607-7dd002657777?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2b9ba565bd054a82f49a0119f3dba6fa", "srcset": "https://si.imgix.net/4bdce859/uploads/origins/764c2639-0398-4bba-b607-7dd002657777?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2b9ba565bd054a82f49a0119f3dba6fa, https://si.imgix.net/4bdce859/uploads/origins/764c2639-0398-4bba-b607-7dd002657777?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=276f18bd76efd4fc0b14e7548942a590 2x, https://si.imgix.net/4bdce859/uploads/origins/764c2639-0398-4bba-b607-7dd002657777?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=242d9d6f1a63f9769c01ec30ee6b70cd 3x"}, "body": "厚みサンセンチさん初めまして。\nウマ娘にてご依頼を掛けられそうな方を探しているところ、厚みサンセンチさんのことを見つけさせて頂きました。\nもしよろしければウマ娘の「グラスワンダー」に「トサキントレオタード」をコスプレさせたイラストをお願いできますか。\n（※トサキントレオタード→初代のポケモンアニメ43話「ナッシーぐんだん　だいこうしん！」で、カスミがマジシャンのアシスタントの際に着用していた、トサキントを模した衣装を指してます）\n\n過去作でもグラスちゃんへの愛満載のイラストや、その描き込みがとても感情豊かで生き生きと生命力も感じるグラスちゃんが山盛りでしたため、その愛に寄生する形で、個人的にお気に入りの衣装を描いて頂ければと思った次第です……！\n\n衣装の造形につきましては資料ページのURLを添付いたしますので、ご参考頂ければと存じます。\nコスプレとしてのご依頼させて頂くのは、完全に自分の趣味の都合となりますため、元ネタをご存じないだろうことは覚悟の上ですが、それでもよろしければお願いさせて頂きたく存じます……！\n\n表情や構図・ポーズ、あと多少のアレンジなどについては、厚みサンセンチさんが良いと思ったまま、ご想像されるままのグラスちゃんのリアクションで描いて頂ければOKです。これまでの作品からも信頼できる解像度のもと描かれる最高なグラスちゃんをご期待させて頂ければと思います！！\nまた、コスプレ（衣装）姿がメインなので、せめて全身絵で衣装姿を堪能させて頂ければ特に嬉しく思います。\nセンシティブに配慮してストッキング履かせる等の微アレンジを加えて頂く等は問題ないですが、もちろん原作デザインそのままに素足で描かれてもOKです！\n（だけどロングな手袋が性癖なので、アレンジしても手袋は忘れないで頂ければとてもすごく嬉しいです……）\n\nやや無茶な依頼とは存じますが、それでもよろしければ何卒よろしくお願いします！\n\nhttps://bulbapedia.bulbagarden.net/w/index.php?title=File:Misty_Goldeen_outfit.png", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}], "sent_works": [], "similar_creators": [{"id": 1008205, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "まほたろう", "screen_name": "MaHoTaRu", "avatar_url": "https://pbs.twimg.com/profile_images/1723462921341292544/13Y9ftXN.jpg", "header_url": "https://pbs.twimg.com/profile_banners/784841415310217216/1709129591/1500x500", "appeal_rec