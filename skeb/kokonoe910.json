求说明：\n水星纪念穿着游戏里的服装“待ち受けスタイル”，身子轻微朝向画面左侧，她的脑袋扭过来看向画面中心，右手拿着手机，搭在自己的胸口上，左手从胸部下侧穿过托起整个胸部，表情很得意\n背景画出能表示她在户外的感觉即可\n这件皮肤的狼尾的服装设计很可爱所以希望能够画上这个小细节\n\nhttps://drive.google.com/drive/folders/1cBGMo9KtcW93tzcR98zBHuGQmCxontU3?usp=sharing", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@kokonoe910/works/1", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/e17b5cb8/uploads/origins/277d7842-bdf5-4959-9232-a7cac7a9b893?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=154c48b5792b4b510530adf89f1253f0", "srcset": "https://si.imgix.net/e17b5cb8/uploads/origins/277d7842-bdf5-4959-9232-a7cac7a9b893?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=154c48b5792b4b510530adf89f1253f0, https://si.imgix.net/e17b5cb8/uploads/origins/277d7842-bdf5-4959-9232-a7cac7a9b893?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=8bfb0d2b961117aecac037d7455beccb 2x, https://si.imgix.net/e17b5cb8/uploads/origins/277d7842-bdf5-4959-9232-a7cac7a9b893?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=5f5712f22eb2944ad61ef8d668027ac6 3x"}, "private": true, "genre": "art", "tipped": false, "creator_id": 2675341, "nc": 128}], "sent_works": [], "similar_creators": [{"id": 112353, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "雄樋ちゃっそ", "screen_name": "ZGMFX90E", "avatar_url": "https://pbs.twimg.com/profile_images/1940776423322447872/edTWzO8P.jpg", "header_url": "https://pbs.twimg.com/profile_banners/359982661/1747038506/1500x500", "appeal_receivable": f