uploads/origins/b1ff079a-5e49-47f5-be8a-e4f60ae96d69?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=08e3e7b8d291159aec902a8243c7b5fb, https://si.imgix.net/13afc29b/uploads/origins/b1ff079a-5e49-47f5-be8a-e4f60ae96d69?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=6061cf20d1d7c87fd1ff34a840f691a5 2x, https://si.imgix.net/13afc29b/uploads/origins/b1ff079a-5e49-47f5-be8a-e4f60ae96d69?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=07a240b05a132568c8f6ad68fb149cb6 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/13afc29b/uploads/origins/b1ff079a-5e49-47f5-be8a-e4f60ae96d69?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=4904cff53b82f274489151406b073a42", "srcset": "https://si.imgix.net/13afc29b/uploads/origins/b1ff079a-5e49-47f5-be8a-e4f60ae96d69?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=4904cff53b82f274489151406b073a42, https://si.imgix.net/13afc29b/uploads/origins/b1ff079a-5e49-47f5-be8a-e4f60ae96d69?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=afdadbe30a3071d64b0fb186e6f149aa 2x, https://si.imgix.net/13afc29b/uploads/origins/b1ff079a-5e49-47f5-be8a-e4f60ae96d69?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=f12bcc9728395f5f6b3121e0f6d76440 3x"}, "body": "紅瀬なび様\nはじめまして、この度はお声がけ頂きありがとうございます。改めましてVライバー兼VTuberの季由鹿きゅんと申します。\n\nお送り頂いたサンプル他なび様のXのイラストポスト拝見させていただきまして、どれも表情豊かでそれぞれ可愛くて素敵な作品に惹かれリクエスト致しました。\n\n◾︎季由鹿きゅんのイラスト\n見た目資料の改変はなさらないようお願い致します。\n\nhttps://x.com/akase05nabi27/status/1899299535563948381?s=46&t=BIlrUSfv0gjHHpHUC_pJug\n\nhttps://x.com/akase05nabi27/status/1896542071387001315?s=46&t=BIlrUSfv0gjHHpHUC_pJug\n\nどのテイストも可愛くて決めれなかったので構図やデザインなどはお任せ致します！\n\n◾︎使用用途\n・SNS上での利用(おはVや告知など)\n・配信サムネイル、動画内使用(IRIAM、YouTube、TikTok)\n・ネットプリント配布\n・返礼品・グッズ制作\n\n◾︎その他お願いなど\n・幅広い用途で使用させて頂きたいため、人物見切れなし(特に顔周り)、人物透過でのご納品をお願い致します。\n\n・もしリクエストをお受けして頂いた場合になりますが、ご依頼を通じてお世話になった方はイラスト使用前にXにて専用のハッシュタグをつけてご紹介ポストをしております。XのAI学習等の懸念がございますため画像をポストする前に透かし防止加工等させて頂く予定です。リプ欄にてメンションをつけてお知らせ致しますので、通知が飛んでしまいます。ご承知おきいただけますと幸いです。\n\n◾︎季由鹿きゅんについての説明\n・季節で姿が変化する鹿の女の子\n・角には白いアネモネが生えており、右に1つ、左に2つ咲いています。(数は固定)\n・身長は150cm、胸は控えめ\n・人耳、歯は生えていません\n・まろ眉、ハム口\n・瞳の色はデフォルトが緑で四季毎変化\n・瞳のハイライトは花の形、瞳孔はヤギのような楕円形\n・前髪は編み込み三つ編み(向き固定)後髪はドーナツリングヘアー\n・前髪 頬にかかる両サイドラインに白のメッシュが薄く入っています\n・緑のベレー帽\n・ブーツ踵ヒールあり\nここまでお目を通して頂きありがとうございます。ご検討お願致します。\n\nhttps://drive.google.com/drive/folders/13SYAsQdJv9nxQShPi3DOwGFJyVK6DfUl", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@aKasE05Nabi27/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3558454, "client_id": 3434968, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/88842cfd/uploads/origins/095e7cd3-06c0-4964-99b9-787ed2fe73ac?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2c70e92fda01593b98a4ed2a70f4a5ad", "srcset": "https://si.imgix.net/88842cfd/uploads/origins/095e7cd3-06c0-4964-99b9-787ed2fe73ac?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2c70e92fda01593b98a4ed2a70f4a5ad, https://si.imgix.net/88842cfd/uploads/origins/095e7cd3-06c0-4964-99b9-787ed2fe73ac?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=81d8d03e03dfc48004f34239af1a71cd 2x, https://si.imgix.net/88842cfd/uploads/origins/095e7cd3-06c0-4964-99b9-787ed2fe73ac?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=73d741fbffcc759a0733b76500711a3a 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/88842cfd/uploads/origins/095e7cd3-06c0-4964-99b9-787ed2fe73ac?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ca8829e3a317243718149a302d7cd773"