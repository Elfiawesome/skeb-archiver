nscoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@TOMORI156203/works/13", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3660713, "client_id": 3923041, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/09b59f65/uploads/origins/af0738a8-8357-4624-8cde-5c2353f4866e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=98dd1d0a8ca040c7619a1acf4bdf3890", "srcset": "https://si.imgix.net/09b59f65/uploads/origins/af0738a8-8357-4624-8cde-5c2353f4866e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=98dd1d0a8ca040c7619a1acf4bdf3890, https://si.imgix.net/09b59f65/uploads/origins/af0738a8-8357-4624-8cde-5c2353f4866e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=92de0fee174e6452f2bf0ee08f592a21 2x, https://si.imgix.net/09b59f65/uploads/origins/af0738a8-8357-4624-8cde-5c2353f4866e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=732e49aca1e0f937e456ce6b619abe7d 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/09b59f65/uploads/origins/af0738a8-8357-4624-8cde-5c2353f4866e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=74d50a3cc4b755e6c5f97e3effac6b85", "srcset": "https://si.imgix.net/09b59f65/uploads/origins/af0738a8-8357-4624-8cde-5c2353f4866e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=74d50a3cc4b755e6c5f97e3effac6b85, https://si.imgix.net/09b59f65/uploads/origins/af0738a8-8357-4624-8cde-5c2353f4866e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=869d28d5ae947a3deec4bee7b09486f5 2x, https://si.imgix.net/09b59f65/uploads/origins/af0738a8-8357-4624-8cde-5c2353f4866e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=94870cf40deb887d7fc0d81560ceebfc 3x"}, "body": "丸吉様、はじめまして。アオと申します。\n\nXで素敵なイラストを拝見させていただきまして、ぜひskebをお願いしたいと思い、リクエストをお送りさせていただきました。\n\n今回は遺香廻りHO3調香とその対応NPCである雲雀染を描いていただきたいです。\n\n立ち絵は他の方に依頼して描いていただいたものになります。（参考資料内のイラストは絵師様より利用許可をいただいております。）\n※資料URLにいあきゃらとGoogle drive URLを添付しております。\n\n【キャラクター詳細】\n•HO調香\n芳梛香　麗（ほなか　れい）\n女性/31歳/170cm\n雲雀とは麗が学生の頃に出会ってからの師弟関係。流れで調香を教えてもらうことになったので、「雲雀ちゃん」「麗ちゃん」と緩い感じの師弟。\n比較的ノリがよく、軽口や雑談にも付き合ってくれるし、笑顔で周りと積極的に交流する性格。\n\n\n【利用用途】\n・個人鑑賞用。場合によっては個人のグッズ用（あくまで個人で楽しむ用）\n・他skeb等での依頼の参考資料\n•同卓者への共有\n•X（旧Twitter）のヘッダー、端末の壁紙等\n\n【構図•服装】\n可能であれば詰め込みイラストでお願いしたいです。\n服装や髪型に関して、立ち絵を参考にでも、丸吉様の描きたいように描いていただけますと幸いです。\n\n以上、金額や内容に不明・不足点等ございましたら再送いただきたく思います。\nお忙しいようでしたら、お手数ですがキャンセルいただけますと幸いです。  ご検討の程よろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/1AS9LNvgl89n5yhH2l3fJSQDBWf6_4MJx   https://iachara.com/view/14683735", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@TOMORI156203/works/12", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3660713, "client_id": 2972990, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/45e3c9cc/uploads/origins/951d531d-f1d6-40c9-b63b-eb18ee43eb17?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6106dae3a5188f2d0913b149b70b408f", "srcset": "https://si.imgix.net/45e3c9cc/uploads/origins/951d531d-f1d6-40c9-b63b-eb18ee43eb17?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6106dae3a5188f2d0913b149b70b408f, https://si.imgix.net/45e3c9cc/uploads/origins/951d531d-f1d6-40c9-b63b-eb18ee43eb17?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=94a9b9461fadd140d8b5a932b2d6f460 2x, https://si.imgix.net/45e3c9cc/uploads/origins/951d531d-f1d6-40c9-b63b-eb18ee43eb17?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=2b899921ef1e59ea4ebff1539b546ba1 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/45e3c9cc/uploads/origins/951d531d-f1d6-40c9-b63b-eb18ee43eb17?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ba2fce5f8b82509e4e0b56e15775e4ae", "srcset": "https://si.imgix.net/45e3c9cc/uploads/origins/951d531d-f1d6-40c9-b63b-eb18ee43eb17?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ba2fce5f8b82509e4e0b56e15775e4ae, https://si.imgix.net/45e3c9cc/uploads/origins/951d531d-f1d6-40c9-b63b-eb18ee43eb17?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=25c55bc49f1313bad5dbacf64ff52526 2x, https://si.imgix.net/45e3c9cc/uploads/origins/951d531d-f1d6-40c9-b63b-eb18ee43eb17?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=e1d024973ba1b3dfb89976f30437271b 3x"}, "body": "丸吉さん、初めまして。\n丸吉さんの絵柄が好きです！自陣の『レプリカントの葬列』の探索者を描いていただけないでしょうか？ \nキャラクターの情報は以下となります。 外見はurl内容を参考してください（他の情報とHO2に関する情報もあります）\n\nHO1『怪盗』Pavo /飛鳥了\n『いつも楽しそうな子犬』のような印象を与えるキャラクターです。\nカードマジックが得意です。\n思考が飛躍していて、活力とやる気に満ちています。派手な装束が好きで、怪盗服も非常に華やかなスタイル。怪盗としての行動スタイルも非常に派手です。\nPavoは英語でクジャクを意味するラテン語に由来し、虚栄心や傲慢さの象徴である。彼の印象に非常に合った怪盗名です。\n怪盗になる前は中華料理店でアルバイトをしてました。麻婆豆腐とチャーハンが得意だが、本人は味覚音痴です。 \n緑目の黒猫一匹を拾い、相棒と一緒に育てているが、猫にはあまり好かれていないようだ。雨の日が嫌いで、猫を抱えてソファでぼんやりします。\n相棒の湊さんが大好き。でも好きという気持ち自体に理由はいらない！ただ特定の誰かを好きというより、自分に関わる人たちはみんな悪い人じゃないと思っていて、みんな好きです！\n\n詰め込みの形で、内容はお任せします。\nよろしくお願いします。\n\nhttps://drive.google.com/drive/folders/15U7gZWH7M1WKNdb2UKrVepcy6I-2FimV", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@TOMORI156203/works/11", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3660713, "client_id": 3668012, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/c95b12af/uploads/origins/3b955ebb-80af-4b9e-9a0f-2aad941642ab?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=30c3407f9228feca11a7ce3f20268a75", "srcset": "https://si.imgix.net/c95b12af/uploads/origins/3b955ebb-80af-4b9e-9a0f-2aad941642ab?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=30c3407f9228feca11a7ce3f20268a75, https://si.imgix.net/c95b12af/uploads/origins/3b955ebb-80af-4b9e-9a0f-2aad941642ab?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=fca96436ede2cea689cfa8c5d0de7905 2x, https://si.imgix.net/c95b12af/uploads/origins/3b955ebb-80af-4b9e-9a0f-2aad941642ab?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e578f9e929d02ed72d362fdc13eeacc7 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/c95b12af/uploads/origins/3b955ebb-80af-4b9e-9a0f-2aad941642ab?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=862df72ad865a0acc0968deea697cda8", "srcset": "https://si.imgix.net/c95b12af/uploads/origins/3b955ebb-80af-4b9e-9a0f-2aad941642ab?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=862df72ad865a0acc0968deea697cda8, https://si.imgix.net/c95b12af/uploads/origins/3b955ebb-80af-4b9e-9a0f-2aad941642ab?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=84095a7b564c2306a0acd13db0807038 2x, https://si.imgix.net/c95b12af/uploads/origins/3b955ebb-80af-4b9e-9a0f-2aad941642ab?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=8a0affe438d4b0069bf64b56361294e8 3x"}, "body": "初めまして、Xにて日頃から丸吉様のイラストを拝見させていただいております！\n丸吉様の描く人物同士の関係性が一目でわかるイラストがとても素敵で、ぜひうちの子を描いていただきたくリクエストをお送りいたしました！\n使用用途は個人鑑賞、アイコンやヘッダーの使用です。\n不手際がありましたら申し訳ありません。価格調整が必要でしたら、お手数ですが、再送依頼をいただければと思います。よろしくお願い致します。\n\n今回は「遺香廻り」のHO1と亜白檀の2人を描いていただきたいです。\n\n【HO1の性格、特徴】\n・好奇心で全方位に迷惑をかける\n・おちゃらけていてイタズラ好き\n・表向きはいい上司だけど中身は自我が強い子供\n・愛煙家\n・身長は170cm\n・普段隠れている部分の体は彼岸花関係なく、刺青がある（首元にちらっと見える）\n・向かって左（本人から見て右）に泣き黒子\n・左手の薬指にゴールドの指輪\n\n【関係性】\n・幼馴染\n・ちょっかいを掛け合って、HO1が悪戯をしたらやり返される\n・仲がいいからこそお互いに雑に扱っている\n\n【概要】\n夜に家で2人でお酒を飲んだりタバコを吸っている姿を見てみたいです。\n亜白檀はグレーのスウェットを着せていただきたいです。\n\n希望が多くなってしまい申し訳ありません……！\n可能な範囲で構いませんので、描いていただけましたら嬉しいです。\nよろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/1w9lla0hd5zXnQbI1yrvWXbUjJ6F3K-Ue?usp=drive_link", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@TOMORI156203/works/10", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3660713, "client_id": 4088721, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/6cc295e9/uploads/origins/4be71d33-ea1b-4c50-b9b6-db83b1abd2be?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fdb418ec4b72da262686af74f289e854", "srcset": "https://si.imgix.net/6cc295e9/uploads/origins/4be71d33-ea1b-4c50-b9b6-db83b1abd2be?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fdb418ec4b72da262686af74f289e854, https://si.imgix.net/6cc295e9/uploads/origins/4be71d33-ea1b-4c50-b9b6-db83b1abd2be?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=6de0c281f6c1bf5382dca5008debfcd6 2x, https://si.imgix.net/6cc295e9/uploads/origins/4be71d33-ea1b-4c50-b9b6-db83b1abd2be?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=2ebd2a43c5f03c2a25bc913243acdcc5 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/6cc295e9/uploads/origins/4be71d33-ea1b-4c50-b9b6-db83b1abd2be?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d172fc5e4f8eb9ee2237cf38dda6dae6", "srcset": "https://si.imgix.net/6cc295e9/uploads/origins/4be71d33-ea1b-4c50-b9b6-db83b1abd2be?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d172fc5e4f8eb9ee2237cf38dda6dae6, https://si.imgix.net/6cc295e9/uploads/origins/4be71d33-ea1b-4c50-b9b6-db83b1abd2be?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=25f6a35bc1fcab788be7550ed34a09cf 2x, https://si.imgix.net/6cc295e9/uploads/origins/4be71d33-ea1b-4c50-b9b6-db83b1abd2be?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=0065bfa39c377c305c57dea843b29ca1 3x"}, "body": "初めまして、🌻👨（ひまわり野郎）と申します。\n\n丸吉様の絵柄がとても素敵でリクエストを送らせて頂きました。\n\n\n【ジャンル】\nイラスト\n\n【内容】\nCOCシナリオ「遺香廻り」のミニキャラ8人\n◼︎自陣探索者4人（HO霊香、HO線香、HO調香、HO幽香）\n◼︎関連NPC（亜白檀、花篝蛇樂、志虎黄泉、伊澄なとり）\n◼︎雰囲気は丸吉さんの描きやすい雰囲気で構いません。添付資料に戦闘立ち絵や武器なども入っております。\n\n◼︎継続卓での駒使用やリアルグッズ化の許可をいただけるのであれば、透過での納品を希望いたします。\n\n【自陣KPからの印象】\nHO1/霊香…仲間のせいで「呆れ→諦め」となっている真面目な人です。(亜白檀をイジる関連だと)悪い笑顔をすることもあります。\n\nHO2/線香…仕事中は追いつこうと背伸びして、作り笑いで誰も内側に入れないようにしていました。本質的にはのんびりとしたマイペースな人です。\n\nHO3/調香…大事な人に関わることだと、無表情ながら饒舌になります。根は真面目で仕事きっちりですが、大事な人が最優先な人です。\n\nHO4/幽香…子供っぽい言動が多く、よく表情が変わります。遠慮ない言動は大事な人への甘えであり、本質はしっかり者で大人の思考ができます。\n\n【使用用途】\n（予定）\n◼︎継続卓での駒使用\n（可能性）\n◼︎アクリルスタンド、アクリルキーホルダー、ネットプリントでの印刷などリアルグッズ化\n\n※商用利用ではなく自陣内でのみの想定です。それにあたり、SNSでグッズ化したものの写真をアップロードする可能性が高くあります。\n※上記は丸吉様の許容できる範囲にさせて頂きます。\n\nskebのリクエストをするのが初めて、人数が8人分と多めというのもあり、詳細や金額に不足がありましたら再送頂けますと幸いです。何卒よろしくお願いいたします。\n\nミニキャラ化にあたり、細かいパーツや模様は省いていただいても構いません。\n\n\nご検討の程よろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/1yCYSEQKZvfz9KstM_-FmJ1M_C-0hwLa7?usp=sharing", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@TOMORI156203/works/9", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3660713, "client_id": 2720547, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/fb956454/uploads/origins/46ecc06b-b0bd-4012-82aa-e23060b009a6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6b764a9ee62b9e0a4a21316da29ab64c", "srcset": "https://si.imgix.net/fb956454/uploads/origins/46ecc06b-b0bd-4012-82aa-e23060b009a6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6b764a9ee62b9e0a4a21316da29ab64c, https://si.imgix.net/fb956454/uploads/origins/46ecc06b-b0bd-4012-82aa-e23060b009a6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=8ba51eb4b4c5b796a0b937f53648b184 2x, https://si.imgix.net/fb956454/uploads/origins/46ecc06b-b0bd-4012-82aa-e23060b009a6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=6559d768f381d4636a45b93a6c3155cd 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/fb956454/uploads/origins/46ecc06b-b0bd-4012-82aa-e23060b009a6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0128368fe85cff0f2413f743220d1b4e", "srcset": "https://si.imgix.net/fb956454/uploads/origins/46ecc06b-b0bd-4012-82aa-e23060b009a6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0128368fe85cff0f2413f743220d1b4e, https://si.imgix.net/fb956454/uploads/origins/46ecc06b-b0bd-4012-82aa-e23060b009a6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=19f9216a194b42764f7af28a68709a7f 2x, https://si.imgix.net/fb956454/uploads/origins/46ecc06b-b0bd-4012-82aa-e23060b009a6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=5f2e37e7ee24a4abad4c9393cf331041 3x"}, "body": "こんばんは！\nXにて丸吉さんのイラストを拝見させていただき、キャラクター二人の距離感や間に流れる雰囲気に惹かれ依頼させていただきました。\n\n今回描いていただきたいのは、CoCシナリオ「タナトスは死に何を想う」のPCふたり（ツーショット）です。\n\n不手際等ありましたら大変申し訳ありません。\n価格調整が必要な場合など、お気軽に再送依頼をいただければと思います。\nよろしくお願い致します。\n\n\n【イラストの雰囲気】\n詳細なリクエストがあるわけではないので構図等描きやすいようお任せできればと思います。\nもしお困りになるのであれば下記ご参照ください。\n・上記シナリオが美術館に行くものであるため美術館のモチーフ、あるいは同居しているのでその風景など\n・ふたりの距離は近めですので、顔や体を寄せている（一緒に寝ているなど）構図など\n\n\n以下長文となりますので適宜無理のない範囲で拾っていただければと思います。\n\n【キャラクター説明】\n・匡（おみ） 男/24歳\n一人称:俺\n目：赤\n髪：白ベースに部分的に黒\nほか：ピアス穴左右に一つずつ（就活のためピアス着用なし）\n所謂ギフテッドと呼ばれる理系分野の天才。就職を控えた薬学専攻の大学院生。\n世界が「自分と詠」と「それ以外」に区分されており、詠以外はどうでもいい。とはいえ体面に気を遣ったほうが生きやすいことも理解しているため、表向き人当たりはいい。柔和な雰囲気。\n\n・詠（よみ） 男/19歳\n一人称:俺\n目：赤\n髪：黒ベースに部分的に白\nほか：ハーフアップ、ピアス多め\n匡を崇拝しており、猛勉強して追いかける形で匡と同じ大学に入学。文系。\n美人に分類されるうえに社交性が高いため交友関係が広いが、その社交性のおおよそが匡に近づく人間への威嚇（牽制）に用いられている。匡に対しては敬語で腰が低い。\n\nhttps://drive.google.com/drive/u/0/folders/1qXAoJwhzPbWNbtkenIQXtfbKvLzU5Ea5", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@TOMORI156203/works/8", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3660713, "client_id": 2645705, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/600a5389/uploads/origins/8e6c6749-efa1-4908-bb8f-18ebee6f9cf4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1de1257500c2136311f09bb7c8feaf27", "srcset": "https://si.imgix.net/600a5389/uploads/origins/8e6c6749-efa1-4908-bb8f-18ebee6f9cf4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1de1257500c2136311f09bb7c8feaf27, https://si.imgix.net/600a5389/uploads/origins/8e6c6749-efa1-4908-bb8f-18ebee6f9cf4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f730418d4f87536e29307f36f591a41f 2x, https://si.imgix.net/600a5389/uploads/origins/8e6c6749-efa1-4908-bb8f-18ebee6f9cf4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=7c7bbbdfc58bdb86f216e17bdb141c6a 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/600a5389/uploads/origins/8e6c6749-efa1-4908-bb8f-18ebee6f9cf4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0bfe6cd007756146a5dca1769eaf99c1", "srcset": "https://si.imgix.net/600a5389/uploads/origins/8e6c6749-efa1-4908-bb8f-18ebee6f9cf4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0bfe6cd007756146a5dca1769eaf99c1, https://si.imgix.net/600a5389/uploads/origins/8e6c6749-efa1-4908-bb8f-18ebee6f9cf4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=2f7b1bb37bb8da355c60f1ea01cd00e1 2x, https://si.imgix.net/600a5389/uploads/origins/8e6c674