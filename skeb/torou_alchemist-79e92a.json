の制作をお願いできたらと思います...！\n\n以下参考資料失礼します。\nデザイン製作者様の許諾は得ています。\nhttps://drive.google.com/file/d/1mniHpsLME6FOXXWPA1QSNYXHvWvx6X68/view?usp=drivesdk\n\nhttps://drive.google.com/file/d/1x11HlimNVO_pjJds0OSPUy0gyt2PbT4R/view?usp=drivesdk\n\n\n拙い文で申し訳ありません。\nお受け頂けるようであれば\nよろしくお願いします🙇", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@torou_alchemist/works/11", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3885975, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/b6098eeb/uploads/origins/68a54fef-8e56-4d38-b9bd-9899fd25a7e1?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&s=cc04c021d87a65f14f03c877136bcf80", "srcset": "https://si.imgix.net/b6098eeb/uploads/origins/68a54fef-8e56-4d38-b9bd-9899fd25a7e1?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&s=cc04c021d87a65f14f03c877136bcf80, https://si.imgix.net/b6098eeb/uploads/origins/68a54fef-8e56-4d38-b9bd-9899fd25a7e1?bg=%23fff&fm=webp&auto=compress&dpr=2&fit=crop&crop=top&w=200&h=200&s=5c6bd900e574fd4dfece4206b23d9c42 2x, https://si.imgix.net/b6098eeb/uploads/origins/68a54fef-8e56-4d38-b9bd-9899fd25a7e1?bg=%23fff&fm=webp&auto=compress&dpr=3&fit=crop&crop=top&w=200&h=200&s=35185a19d78f3b85e658c5edfdef8c3d 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/b6098eeb/uploads/origins/68a54fef-8e56-4d38-b9bd-9899fd25a7e1?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&blur=200&s=9fbb36fb1e64bb8709a2df3bc4796cfe", "srcset": "https://si.imgix.net/b6098eeb/uploads/origins/68a54fef-8e56-4d38-b9bd-9899fd25a7e1?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&blur=200&s=9fbb36fb1e64bb8709a2df3bc4796cfe, https://si.imgix.net/b6098eeb/uploads/origins/68a54fef-8e56-4d38-b9bd-9899fd25a7e1?bg=%23fff&fm=webp&auto=compress&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=e2844870a0b22dffb76fbdd63c56b