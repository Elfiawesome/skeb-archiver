ss&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=e93d7ae3ac68beae81934dc358427c9f 3x"}, "private": true, "genre": "art", "tipped": false, "creator_id": 3885975, "client_id": 3964649, "nc": 129}, {"path": "/@torou_alchemist/works/14", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3885975, "client_id": 4032140, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/e2ad3dbd/uploads/origins/7709b1aa-cf51-47d5-a97b-2e09b4df02ab?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&s=d4d009876bea8dcca7bd45fd26db3d0e", "srcset": "https://si.imgix.net/e2ad3dbd/uploads/origins/7709b1aa-cf51-47d5-a97b-2e09b4df02ab?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&s=d4d009876bea8dcca7bd45fd26db3d0e, https://si.imgix.net/e2ad3dbd/uploads/origins/7709b1aa-cf51-47d5-a97b-2e09b4df02ab?bg=%23fff&fm=webp&auto=compress&dpr=2&fit=crop&crop=top&w=200&h=200&s=dc683d5f9341ca0f24cc3521e4fe5d12 2x, https://si.imgix.net/e2ad3dbd/uploads/origins/7709b1aa-cf51-47d5-a97b-2e09b4df02ab?bg=%23fff&fm=webp&auto=compress&dpr=3&fit=crop&crop=top&w=200&h=200&s=7e2ddee91abcc027de03f2432c37eb74 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/e2ad3dbd/uploads/origins/7709b1aa-cf51-47d5-a97b-2e09b4df02ab?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&blur=200&s=9238140d2977bbdda41e27b92a77b7e3", "srcset": "https://si.imgix.net/e2ad3dbd/uploads/origins/7709b1aa-cf51-47d5-a97b-2e09b4df02ab?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&blur=200&s=9238140d2977bbdda41e27b92a77b7e3, https://si.imgix.net/e2ad3dbd/uploads/origins/7709b1aa-cf51-47d5-a97b-2e09b4df02ab?bg=%23fff&fm=webp&auto=compress&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=419d4811797f1392862e173ca5be2e93 2x, https://si.imgix.net/e2ad3dbd/uploads/origins/7709b1aa-cf51-47d5-a97b-2e09b4df02ab?bg=%23fff&fm=webp&auto=compress&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=b3b10a63d3eab5a3464eb4fb9f4f885a 3x"}, "body": "はじめまして、あるけみ内の名前milkjamと申します。\nアイコン投稿一覧を見ていたところとろー様のアイコンがとても素敵で、アイコン制作をぜひ依頼したいと思いましたのでご連絡させていただきました。\nskebの依頼は初めてなのでなにか不手際ありましたら大変申し訳ございません。\n\n内容としましては今私が使用しているアイコンを少女に擬人化したいです。\n\nデザインとしましては\n頭にミルククラウン風の王冠\n\n髪の毛はメロンパンのようなきつね色でウェーブかかったロング。\n\n瞳はメロンのような緑色。\n\n服装はエプロンドレス風ワンピース？で\nメロンパンのようなきつね色と牛乳の白色を使ってできればスカート部にはメロンパンの焼き目のような格子状デザインなども可能そうであればお願いしたいです。\n\nhttps://www.amavel.jp/products/126170265?_pos=14&_sid=ace86da04&_ss=r\n\nこのようなワンピースをイメージとしては想像しております。\n\n手にはストローをモチーフにした杖を可能であれば持たせたいと考えています。\n\n以上のようなイメージでお願いできればと思います。\n\n私はお恥ずかしながら絵心が0ですのであとはとろー様のセンスで描きやすいように変更やアレンジしてくださってかまいません。\n\n色々丸投げになってしまいますが、依頼の方うけていただけるかご検討の方よろしくお願いいたします。\n\n創作依頼の方に依頼者様のオリジナルキャラクターに限りますと書いてありましたので\n説明させていただきますと、今回依頼するアイコンは私のアイデアのもと描いていただいたアイコンです。\n描いていただいた作者様に擬人化する許可も頂いております。\n\nhttps://drive.google.com/file/d/1BX5KH06z0kRYOIaw9fTPvEVzzgFTDuTF/view?usp=drivesdk\n\n許可いただいた郵便のスクショです。\n\n長々となってしまいましたが、\nぜひご検討の方よろしくお願いいたします。", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@torou_alchemist/works/13", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3885975, "client_id": 3279104, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/28c45888/uploads/origins/2183e55c-ece0-4c8f-ae8d-a28a6ef010ee?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&s=2a4f20dddda462561eaedf9669c3b777", "srcset": "https://si.imgix.net/28c45888/uploads/origins/2183e55c-ece0-4c8f-ae8d-a28a6ef010ee?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&s=2a4f20dddda462561eaedf9669c3b777, https://si.imgix.net/28c45888/uploads/origins/2183e55c-ece0-4c8f-ae8d-a28a6ef010ee?bg=%23fff&fm=webp&auto=compress&dpr=2&fit=crop&crop=top&w=200&h=200&s=948602d2dc8441d5d69dc2df5d9d6c2f 2x, https://si.imgix.net/28c45888/uploads/origins/2183e55c-ece0-4c8f-ae8d-a28a6ef010ee?bg=%23fff&fm=webp&auto=compress&dpr=3&fit=crop&crop=top&w=200&h=200&s=8901851341bfe2a63c221f8af63fd34d 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/28c45888/uploads/origins/2183e55c-ece0-4c8f-ae8d-a28a6ef010ee?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&blur=200&s=f1191a86a3b0ab8ac6dbff912b0b3655", "srcset": "https://si.imgix.net/28c45888/uploads/origins/2183e55c-ece0-4c8f-ae8d-a28a6ef010ee?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&blur=200&s=f1191a86a3b0ab8ac6dbff912b0b3655, https://si.imgix.net/28c45888/uploads/origins/2183e55c-ece0-4c8f-ae8d-a28a6ef010ee?bg=%23fff&fm=webp&auto=compress&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=1688e6f164abbd141ded6baec198ebe6 2x, https://si.imgix.net/28c45888/uploads/origins/2183e55c-ece0-4c8f-ae8d-a28a6ef010ee?bg=%23fff&fm=webp&auto=compress&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=a0b1caa3d0668024cdf33a1e3d5839c0 3x"}, "body": "あうとろーさま\n\nはじめまして。とてもかわいらしいSDイラストにひかれてリクエストさせていただきます。\n\n私のOCのSDドットイラストを描いていただけないでしょうか？\n\n■資料\nhttps://drive.google.com/file/d/1EkxwYSZy8tux6akDRzh2jLfpLStsk7b5/view?usp=sharing\nモチーフ：宇宙・パンダ・ゆめかわ・堕天使\n\n■依頼内容\nキャラクターのSDドットイラスト\n下記のようなアートスタイルを希望します。\nhttps://skeb.jp/@torou_alchemist/works/12\nまばたきのアニメーションをつけていただきたく、閉じ目の状態のときは( ˘ω˘ ) この目の形ではなく、( -ω- )このような一本の目の形にしていただきたいです。（三面図右側の表情差分を参考にしていただければと思います）\n細かい装飾などは省略していただいて問題ございません。\n\n■用途\n・下記アカウントでのアイコン/ヘッダーやお知らせ等に添えるイラストとしての使用・今後制作予定のポートフォリオサイト内での装飾としての利用\nhttps://x.com/yn0777\n・名刺/ステッカーなどの無料でお渡しするグッズへの利用\n・個人観賞/個人用グッズの作成\n・他の方へのイラスト等依頼時に資料として提出\n上記のうちいずれかの目的で使用させていただく可能性がございます。\n\n使用時は権利表記をさせていただきます。\n商用利用の予定はございません。\n背景にデザイン・装飾を入れて使用させていただく可能性がございます。\n\n■納品形式\nもし可能であれば背景が透過されたデータをいただけますと幸いです。他はおまかせいたします。\n\nご検討のほどよろしくお願いいたします。\nもし金額に不足があれば再送依頼をお願いいたします。\n\nhttps://drive.google.com/file/d/1EkxwYSZy8tux6akDRzh2jLfpLStsk7b5/view?usp=sharing", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acce