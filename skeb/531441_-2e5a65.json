も嬉しいです！\n\n可能であれば、別レイヤーにサインを入れたpsdファイルをご提供ください。また、先生が下書きや未使用のrkgkなどを作品に残しておいてくださると、アイデアの変遷を見ることができるのでありがたいです！\n\nご依頼をお読みいただき、ご検討くださり誠にありがとうございます！お気に召さない場合は、遠慮なく直接キャンセルしてください。\n\nhttps://drive.google.com/drive/folders/1G2yldDUusWRmjXtyBZvMCJr11FJAh5xc?usp=sharing", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@531441_/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3728062, "client_id": 1681317, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/88c1c7af/uploads/origins/963d7a38-cdee-4674-b249-02429e6792aa?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=769818ce249e60e950f0ef1dc59656fc", "srcset": "https://si.imgix.net/88c1c7af/uploads/origins/963d7a38-cdee-4674-b249-02429e6792aa?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=769818ce249e60e950f0ef1dc59656fc, https://si.imgix.net/88c1c7af/uploads/origins/963d7a38-cdee-4674-b249-02429e6792aa?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=807fb8566f437c768b02bc2d65d78f5a 2x, https://si.imgix.net/88c1c7af/uploads/origins/963d7a38-cdee-4674-b249-02429e6792aa?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=4c7a4fcb70943d62411ff710d9fb7f90 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/88c1c7af/uploads/origins/963d7a38-cdee-4674-b249-02429e6792aa?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a32322a03ac5ea406415206daa62b214", "srcset": "https://si.imgix.net/88c1c7af/uploads/origins/963d7a38-cdee-4674-b249-02429e6792aa?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a32322a03ac5ea406415206daa62b214, https://si.imgix.net/88c1c7af/uploads/origins/963d7a38-cdee-4674-b249-02429e6792aa?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=cr