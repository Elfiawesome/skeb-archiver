おてんば娘という感じです。\n\nMelodyは、DIAの大きなバストに比べ、控えめなバストサイズです。Melodyは健康的な太ももとお尻をしている。二人とも幸せそう、あるいは自信に満ちているように見えること。\n\n二人とも胸を露出しているバージョンを追加でお願いしたい。\n\nご自由に描いてください。先生にとってかっこいいシーンであればうれしいです。", "nc": 161, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@sayhasokeibu/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2132674, "client_id": 2260929, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/32d1c5dd/uploads/origins/1df942e7-1211-4ca2-a531-a5281331ca47?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3dd0aa6830aa0bdabc1e33a84ee010b9", "srcset": "https://si.imgix.net/32d1c5dd/uploads/origins/1df942e7-1211-4ca2-a531-a5281331ca47?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3dd0aa6830aa0bdabc1e33a84ee010b9, https://si.imgix.net/32d1c5dd/uploads/origins/1df942e7-1211-4ca2-a531-a5281331ca47?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=79323248c8d7ce358cf77e0a3ba82088 2x, https://si.imgix.net/32d1c5dd/uploads/origins/1df942e7-1211-4ca2-a531-a5281331ca47?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=cb98d6e3e523967b8c84398de8d4ede1 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/32d1c5dd/uploads/origins/1df942e7-1211-4ca2-a531-a5281331ca47?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0cabac06a0ad60615701a584f9e84f5f", "srcset": "https://si.imgix.net/32d1c5dd/uploads/origins/1df942e7-1211-4ca2-a531-a5281331ca47?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0cabac06a0ad60615701a584f9e84f5f, https://si.imgix.net/32d1c5dd/uploads/origins/1df942e7-1211-4ca2-a531-a5281331ca47?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=6e84aba824a1d2d434475208ca98d9e3 2x, https