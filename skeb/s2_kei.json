22-4d53-89ac-dddce01ebd53?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=1e181e10ecab40470d9895f9df21c4cb, https://si.imgix.net/53786c62/uploads/origins/f4af23ff-1122-4d53-89ac-dddce01ebd53?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=abfa4cc3dda932c9a01b72a5f166dfdd 2x, https://si.imgix.net/53786c62/uploads/origins/f4af23ff-1122-4d53-89ac-dddce01ebd53?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=f23777234b53544225dd04d52d0d5f6a 3x"}, "body": "こんにちは！先生のイラストがとっても大好きで、よろしければ私を描いていただきたくリクエストを送信させていただきます。\n私の見た目は以下の通りです。\n\n髪の色：緑。毛先に向かって徐々に白色グラデーション。髪型はくせ毛のボブ。\n目の色：黒。\n顔の特徴：ほんの少しつり目。右目真下の頬と唇の左下にほくろあり。無邪気そうな顔をよくするが、時折大人びている顔もします。\n\n描写範囲は腰から上あたりが希望ですが、お送りしたリクエスト金額内に収まる程度でお願いします。\n陽だまりにつつまれたカフェのような場所が似合う服装と雰囲気で描いてくださると大変ありがたいです。\n細かい描写はすべておまかせいたします。\n\n近頃はまだまだ寒さが厳しいですが、先生もどうぞご体調にはお気をつけください。\nリクエストのご検討、何卒よろしくお願いいたします！", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@s2_kei/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3528616, "client_id": 3842260, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/ebabf0bc/uploads/origins/d4977efb-7eec-4a03-9380-f260961f2657?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d058077f1ad6853566e637468c13cfa7", "srcset": "https://si.imgix.net/ebabf0bc/uploads/origins/d4977efb-7eec-4a03-9380-f260961f2657?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d058077f1ad6853566e637468c13cfa7, https://si.imgix.net/ebabf0bc/uploads/origins/d4977efb-7eec-4a03-9380-f260961f2657?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ff423a58e111498818e2bec682692308 2x, https://si.imgix.net/ebabf0bc/uploads/origins/d4977efb-7eec-4a03-9380-f260961f2657?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b8cb6fc4d06b2f431ec0f836051967d7 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/ebabf0bc/uploads/origins/d4977efb-7eec-4a03-9380-f260961f2657?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=844d3ecb6c4c652197ef287463bfd825", "srcset": "https://si.imgix.net/ebabf0bc/uploads/origins/d4977efb-7eec-4a03-9380-f260961f2657?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=844d3ecb6c4c652197ef287463bfd825, https://si.imgix.net/ebabf0bc/uploads/origins/d4977efb-7eec-4a03-9380-f260961f2657?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=bc07b2ced49592c1a45790ef89f4706a 2x, https://si.imgix.net/ebabf0bc/uploads/origins/d4977efb-7eec-4a03-9380-f260961f2657?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=86ecbe550d5116423c189b96f873c239 3x"}, "body": "あけましておめでとうございます！\n配信アプリIRIAMで活動させていただいています、合歓木めろと申します。いつも素敵なイラスト拝見させていただいてます。イラストの質感や、色味がすごく好きで惹かれました。\n\nよろしければぜひ私自身をN-538様に描いていただきたいなと思い、今回skebの方送らせていただきました。\n\n◾︎ 用途 ◾︎\nSNSアイコン、活動時の返礼品使用\n（商用利用を予定しています🙇‍♂️）\n\n◾︎ 希望 ◾︎\n私と羊を一緒に描いていただきたいです。\n羊は 毛の色を紫（#A891CC）\n目をナットボタンで縫ってあるようにしていただきたいです。イラスト資料がなく、文章での説明になりますので可能な範囲お願い致します。その他詳細（羊の衣装の有無等）はありません。\n\n私の説明不足で希望内容が難しいようでしたら\n夜が似合う素敵な女の子にしていただけると幸いです🙇‍♀️\n羊のサイズやその他詳細、合歓木の洋服や髪型、構図等はN-538様が思うように描いていただけますと幸いです。\n\n以下、Googleドライブに立ち絵資料まとめています。\n\n今年もN-538様の活動応援しています。\nそして幸せな1年を過ごせますように。\nよろしくお願い致します。\n\nhttps://drive.google.com/file/d/1bkrKGGPWrK4eutgDnJHZmV4GkHPauiBr/view?usp=drivesdk", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@s2_kei/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3528616, "client_id": 3819869, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/5b6b9e3d/uploads/origins/9bc31c90-c613-4393-a97b-5b1433613811?b