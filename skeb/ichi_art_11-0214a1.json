8svn2qcm1\nhttps://sta.sh/0q2a8ueensm\n\n彼の髪型と髪質の備忘録です。https://sta.sh/017jnolyi5tp\n普段はミステリアスな雰囲気を出すために仮面をつけている。\n主な武器は羽根つき扇子と金属扇子。\n彼の黒い羽は常に見せる必要はありません。そのため、彼の姿はあってもなくてもよい。\n「ヴァロール」はフルートも吹く。\n彼のマスクが顔に描きにくいと感じたら、自由に調整してください。\n\nポーズや構図はお任せします。\n\n今回もご検討ありがとうございました。", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@ichi_art_11/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2226330, "client_id": 2416200, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/c160fdf3/uploads/origins/662c6ae9-dd37-4eec-b687-6dfe96f67c97?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=cf75dedee840ae30113867358bada448", "srcset": "https://si.imgix.net/c160fdf3/uploads/origins/662c6ae9-dd37-4eec-b687-6dfe96f67c97?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=cf75dedee840ae30113867358bada448, https://si.imgix.net/c160fdf3/uploads/origins/662c6ae9-dd37-4eec-b687-6dfe96f67c97?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=060935f6e1f520ed4913ba96978f7cb9 2x, https://si.imgix.net/c160fdf3/uploads/origins/662c6ae9-dd37-4eec-b687-6dfe96f67c97?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=41852f44adcb6323363b56f4508ecf63 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/c160fdf3/uploads/origins/662c6ae9-dd37-4eec-b687-6dfe96f67c97?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=8d60b3933f0380fa07f10a607df3f060", "srcset": "https://si.imgix.net/c160fdf3/uploads/origins/662c6ae9-dd37-4eec-b687-6dfe96f67c97?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=8d60b3933f0380fa07f10a607df3f060, https://si.imgix.net/c160fdf3/uploads/origins/662c6ae9-dd37-4eec-b687-6dfe96f67c97?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&