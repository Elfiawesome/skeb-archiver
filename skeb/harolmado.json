origins/081cbf27-8244-4f0f-8aaf-171b099f8ff5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=3ba7579ab5d369b6bc8b5846e811aadd 2x, https://si.imgix.net/1625dd1c/uploads/origins/081cbf27-8244-4f0f-8aaf-171b099f8ff5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=36512149b467fb051ad3e51e1b2a7fa4 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/1625dd1c/uploads/origins/081cbf27-8244-4f0f-8aaf-171b099f8ff5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5effe71db48692129b1037a0fb7b9eda", "srcset": "https://si.imgix.net/1625dd1c/uploads/origins/081cbf27-8244-4f0f-8aaf-171b099f8ff5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5effe71db48692129b1037a0fb7b9eda, https://si.imgix.net/1625dd1c/uploads/origins/081cbf27-8244-4f0f-8aaf-171b099f8ff5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=07a0390a91eee1bf4cadea76eb36d772 2x, https://si.imgix.net/1625dd1c/uploads/origins/081cbf27-8244-4f0f-8aaf-171b099f8ff5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=bb139a6dac6775a74fc671e9e1edb170 3x"}, "body": "ハロ～窓口様\nご検討頂けましたら幸いです。\n\nオリジナルキャラクターを下記のテーマに合わせて、ハロ～窓口様のテイストでアレンジしたイラストを希望します。\n髪型などアレンジや配色はご自由に、不明点、詳細はお任せします。\n\nなお、外見資料に関してはお手数ですが資料URLに記載のX（Twitter）アカウントの固定ツイート及び、ツリーをご確認ください。\n\n▼テーマ：雪景色\n非常に漠然としてますが、\nしんしんと降り積もる雪をテーマとした衣装。\n触れれば融ける儚さ。\n辺りを満たす静けさ。\n\nそのような印象を受ける装いで着飾った姿を希望します。\n\n▼キャラクター設定\nキャラクターモチーフ：シャム猫\n髪：白色\n・髪型アレンジもお好きな形でお任せ\n瞳：サファイアブルー\n肌：褐色\n・肌は褐色とわかる色彩であれば、濃淡は特に問わず全体のイメージに合わせて変えて問題ありません。\n年齢：14〜15\nイメージ：細身で軽やか、しなやかな所作\n性格：真面目で良いことを好む。\n※猫の擬人化ではないため猫目や猫耳、尻尾等は不要。\n\n▼ウォーターマーク（透かし）\nXのアカウントに掲載予定ですが、昨今のAI学習などに危惧される点がありましたら ウォーターマークのレイヤーを作成頂ければ、そちらを表示した形で掲載いたします。\n\n▼背景（読み飛ばして頂いて構いません）\n・裕福な老齢の夫婦に養い育てられた娘\n・幼い頃から血の繋がりはないと認識してるが、そのようなことは些事です、と構わず養父母のことが大好きで敬愛している\n・養父母の前では、いい子であろうととてもお淑やか、でも甘えたがり。\n・養母の影響で植物が好き。特に、名の由来となった山茶花は特に好きな花。\n・養父母から溺愛され、クローゼットには贈られた服でいっぱい。\n\n以上となります。\n\nhttps://twitter.com/Sasanqua_ykmr", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@harolmado/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3187872, "client_id": 2359466, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/a4c448aa/uploads/origins/e73520f1-d0c7-456d-9262-70531c83ba7d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9d04b1691c3311d1b8f217ca56a31c83", "srcset": "https://si.imgix.net/a4c448aa/uploads/origins/e73520f1-d0c7-456d-9262-70531c83ba7d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9d04b1691c3311d1b8f217ca56a31c83, https://si.imgix.net/a4c448aa/uploads/origins/e73520f1-d0c7-456d-9262-70531c83ba7d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=083e71d9757935bab4dcbfeef26b95b3 2x, https://si.imgix.net/a4c448aa/uploads/origins/e73520f1-d0c7-456d-9262-70531c83ba7d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=dd8d6172730bf13c37a20919c8d35c08 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/a4c448aa/uploads/origins/e73520f1-d0c7-456d-9262-70531c83ba7d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e5d1effc65f1a3578c1a248ad06a0150", "srcset": "https://si.imgix.net/a4c448aa/uploads/origins/e73520f1-d0c7-456d-9262-70531c83ba7d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e5d1effc65f1a3578c1a248ad06a0150, https://si.imgix.net/a4c448aa/uploads/origins/e73520f1-d0c7-456d-9262-70531c83ba7d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=3a87aae78b27f142a0d4c01eb99d0006 2x, https://si.imgix.net/a4c448aa/uploads/origins/e73520f1-d0c7-456d-9262-70531c83ba7d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=903af1fa764a15df91609709ffbf6da4 3x"}, "body": "ハロ〜窓口先生こんにちは。\nいつも素敵なイラストをありがとうございます。先生の描かれるイラストの雰囲気や絵柄が大好きです。\nこの度は自分と知り合いのキャラクターを描いていただきたく、リクエストを送らせていただきました。\n\n2人は魔法使いの弟子と師匠です。異世界で生活しており、同じ家に住んでいます。仲は良好で、買い物をしたり家で過ごしたり穏やかな時間を過ごしています。\n\n・キャラクターの詳細\n【師匠】\n男/185cm/赤髪/金眼\n飄々としている男性。身の回りのことは魔法や弟子に任せている。家事は自分でできるのにやっていない。\n弟子からの恋愛感情に気付いているが自ら返事はせず、のらりくらりとかわしている。\n趣味は植物の世話と紅茶を入れること。それなりのこだわりがある。\n・好きなもの 紅茶・植物・読書\n\n【弟子】\n男/180cm/19歳/黒髪/青目\n師匠のもとで魔法使いの弟子をしている青年。\n明るく元気で社交的。手先が器用で人付き合いが上手。師匠に対して恋愛感情を抱いている。\n美味しい料理を作ることにのめり込んでおり、自分でレシピを書き溜めておくのにハマっている。\n・好きなもの 料理(お菓子作り)・掃除\n\n構図や雰囲気などはハロ〜窓口先生が楽しんで描けるようなもので、自由にお願いできればと思います。\nよろしければご検討お願いいたします。\n\nhttps://drive.google.com/drive/folders/175auAXgc234ug1ED5FoLJ9FTI3_a6c66?usp=share_link", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@harolmado/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3187872, "client_id": 2682914, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/d720d4ee/uploads/origins/4c01fe73-c92d-4d6b-9f14-60bbde3687d2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=eb122dffa7bf89946baadef0fbb6b2d4", "srcset": "https://si.imgix.net/d720d4ee/uploads/origins/4c01fe73-c92d-4d6b-9f14-60bbde3687d2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=eb122dffa7bf89946baadef0fbb6b2d4, https://si.imgix.net/d720d4ee/uploads/origins/4c01fe73-c92d-4d6b-9f14-60bbde3687d2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=104025afe2b4ad7b457aad38cd90babe 2x, https://si.imgix.net/d720d4ee/uploads/origins/4c01fe73-c92d-4d6b-9f14-60bbde3687d2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=9831ed1f9156d92a6cad0c174f08ab51 3x"}, "duration": null, "nsfw": false, "hardcore": false, 