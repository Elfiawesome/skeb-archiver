非書いてください\n\n  【設定】 \n紫陽花の妖怪や妖精みたいな存在で最後の時を待つ花たちがいる農園でお手伝いをしています \n本体は紫陽花の化け物みたいな見た目で分体と人の見た目と犬の形態があります  \n見た目がおとなしめですが、元気な感じで配信を行なっていますので茶目っ気ある元気な雰囲気ですが、不穏なことを話したり、ホラーチックな様子もあります。 \nまた推理や考察が好きですが、かなり逸脱したサイコな考えを出したりします 喜怒哀楽が激しく、漫画やアニメ小説・メイクやコスメがなどが好きなタイプです\n\n【構図やポーズ希望など】\n うたぺいんさんの陰影のコントラストが大変好きですので、夏を感じるようなイラストでお願いしたいです\nポージングなどは特に指定はありません\n  全身や上半身・バストアップなどの指定などありませんがサムネなどに利用したいと思っていますので、できるだけ途切れがないイラストでお願いします。 \n\n 【活用内容】 \n描いていただいたイラストは、Xのアイコンやヘッダーへの使用、活動ツイート、YouTubeのサムネイル等・非収益(ネットプリントなど)の各種活動に使用したいと考えております。 そのため、可能でしたらキャラのみ使用できるよう透過したものやPSDファイルでいただけますと幸いです。\n\n  ご検討のほど、よろしくお願いいたします。\n\nhttps://x.com/hydrangea2015_8?s=21&t=XarozWFLQpOT6cRmIQtU5g", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@U29044241/works/10", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 272862, "client_id": 2801542, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/69a99b04/uploads/origins/4ce9e9c6-e0fb-47f5-a657-5fbf0bcee655?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ef14944ae9289acaedef3b3cf96e0a15", "srcset": "https://si.imgix.net/69a99b04/uploads/origins/4ce9e9c6-e0fb-47f5-a657-5fbf0bcee655?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ef14944ae9289acaedef3b3cf96e0a15, https://si.imgix.net/69a99b04/uploads/origins/4ce9e9c6-e0fb-47f5-a657-5fbf0bcee655?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ef68a33b6008bc16cb6a2df7081a3015 2x, https://si.imgix.net/69a99b04/uploads/origins/4ce9e9c6-e0fb-47f5-a657-5fbf0bcee655?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e466f1f46ebb3d5cc78f77d29c44e196 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/69a99b04/uploads/origins/4ce9e9c6-e0fb-47f5-a657-5fbf0bcee655?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&