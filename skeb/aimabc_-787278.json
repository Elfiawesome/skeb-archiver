bab, https://si.imgix.net/7242e917/uploads/origins/ce38f540-e6e2-4264-9148-4d022e736676?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=28272b8b38e1695f3f6cf338e4b14a4e 2x, https://si.imgix.net/7242e917/uploads/origins/ce38f540-e6e2-4264-9148-4d022e736676?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=2b1586497863316f28cd75866c25bc80 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/7242e917/uploads/origins/ce38f540-e6e2-4264-9148-4d022e736676?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e5c9c1aecb44833c26c71a0a812ca517", "srcset": "https://si.imgix.net/7242e917/uploads/origins/ce38f540-e6e2-4264-9148-4d022e736676?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e5c9c1aecb44833c26c71a0a812ca517, https://si.imgix.net/7242e917/uploads/origins/ce38f540-e6e2-4264-9148-4d022e736676?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=19f14df858ae4b39f45b6386f923f96a 2x, https://si.imgix.net/7242e917/uploads/origins/ce38f540-e6e2-4264-9148-4d022e736676?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=104c1c75bffc68e58ea0e229f26ece24 3x"}, "body": "初めまして！絵柄に惹かれてリクエストさせていただきました。\n少々特殊なシチュエーションになりますがよろしいでしょうか？\n他者様のイラストですがこちら（https://x.com/chikinelf/status/1878307472072413225）のような感じで、ハーピー（半人半鳥）型モンスター娘に跨るようにのしかかられるうちの子を描いていただきたいです。\n\n【シチュエーション】\nハーピー型モンスター娘に捕まり巣まで攫われてしまったうちの子を、ハーピーが逃げないようにのしかかるように押さえつけているというシチュエーションでお願いします。\n脱出したいけどハーピーの重い身体とふわふわと絡みつく体毛に阻まれて身動きが取れないうちの子と、それに対して何かよからぬことを考えていそうな、若干興奮気味のハーピーといった感じでお願いしたいです。\n\nその他具体的な構図はお任せします。\n\n・デザイン\nうちの子のデザインはこんな感じです。\nhttps://i.imgur.com/CQ0FOSS.jpg\n色々載っていますが必要そうな情報だけ拾っていただければ大丈夫です。\n分かりにくい部分等ありましたら省略・簡略化しても大丈夫です。\n\nハーピー型モンスター娘のデザインはお任せしますが、フサフサして暖かそうな体毛、羽を持つイメージでお願いします。\n\n・その他\nカラー、無色問いません。\n背景もお任せします。単色等でも大丈夫です。\n\n分かりにくい点がありましたら申し訳ございません。\nよろしくお願いします！", "nc": 57, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@aimabc_/works/2", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/5974970f/uploads/origins/b958edd1-90c3-46ee-90f3-48da6bdf2fab?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=17f382531ce81a59e2c824e9664ac878", "srcset": "https://si.imgix.net/5974970f/uploads/origins/b958edd1-90c3-46ee-90f3-48da6bdf2fab?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=17f382531ce81a59e2c824e9664ac878, https://si.imgix.net/5974970f/uploads/origins/b958edd1-90c3-46ee-90f3-48da6bdf2fab?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=7f6b5cc61541b95a3ca741580f572aca 2x, https://si.imgix.net/5974970f/uploads/origins/b958edd1-90c3-46ee-90f3-48da6bdf2fab?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=748c18561aced06d01b6f3a29cd768d7 3x"}, "private": true, "genre": "art", "tipped": false, "creator_id": 3481934, "client_id": 1663813, "nc": 176}, {"path": "/@aimabc_/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3481934, "client_id": 2743558, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/124d8ff8/uploads/origins/bce53492-c6a9-4360-a4d2-fe39deaa795b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f9dacaa321f98c68e1da57d0777534a6", "srcset": "https://si.imgix.net/124d8ff8/uploads/origins/bce53492-c6a9-4360-a4d2-fe39deaa795b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w