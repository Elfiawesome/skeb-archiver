3-432c-8749-73ba0b6f1ff4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=62eebeae679610122aa59d6af83f26c9, https://si.imgix.net/cc20d535/uploads/origins/e3829532-1843-432c-8749-73ba0b6f1ff4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=2aca3aa5708d089e705d774f1589f104 2x, https://si.imgix.net/cc20d535/uploads/origins/e3829532-1843-432c-8749-73ba0b6f1ff4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=87e1b0b51410bb4c1596800557536d7a 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/cc20d535/uploads/origins/e3829532-1843-432c-8749-73ba0b6f1ff4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=98650443b903483fc6b8fdaa2a9e3b26", "srcset": "https://si.imgix.net/cc20d535/uploads/origins/e3829532-1843-432c-8749-73ba0b6f1ff4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=98650443b903483fc6b8fdaa2a9e3b26, https://si.imgix.net/cc20d535/uploads/origins/e3829532-1843-432c-8749-73ba0b6f1ff4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=0cd871ae21e1d86a9ee08908b0096f94 2x, https://si.imgix.net/cc20d535/uploads/origins/e3829532-1843-432c-8749-73ba0b6f1ff4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=c5b9212bfa38bcc17473c1109a8adf58 3x"}, "body": "お世話になります\n自分のオリヒーロー、業毒鎧装ヴェネオーンを描いて欲しいです。\n（https://drive.google.com/file/d/1iQvZ-ez8Ars4_fJUl5ZH37JIfzWPbVMZ/view?usp=sharing）\n向かって右がヴェネオーン、左側が強化形態に相当するガイト・ヴェネオーンです。\n\n頭部デザインは、爬虫類を模した兜の口に相当する部分にマスクと赤い目があるという解釈でお願いします。\n\n素体にしたのがドラゴンボーンというプラモデル（https://bandai-hobby.net/item/1107/）なのですが、予算に応じてある程度デザインを変更して別物に見えるようにしてくれるとありがたいです。\n\nガイト・ヴェネオーンは予算内で難しければ省略していただいても構いませんが、ヴェネオーンが纏う強化外骨格のイメージで描いてくれると嬉しいです。\n\n構図などはお任せしますが、紫色の電撃を帯びているようなエフェクトを描いてくれると嬉しいです。\n\n要望多くて恐縮ですが、よろしくお願いいたします。", "nc": 129, "word_count": 0, "transcoder": "image", "