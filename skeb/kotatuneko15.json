"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/4b0c1697/uploads/origins/4d931ec2-8325-44f0-b1e6-2973e94a65a3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9cfc00da1da1719d336721cda226502b", "src_set": ""}, "body": "以前霧子えち絵などをお願いした者です。その節は誠にありがとうございました。\n今回はディライトサマー（白競泳水着）を着たパラコレ霧子おねショタでお願いいたします。3/21に投稿されていた霧子と摩美々の続きで、ショタが勃っているのに気付いてしまい…というイメージです。\n正常位の主観視点で、水着の上半分ははだけて胸が見えており、ずらし挿入されている様子をお願いします。金額的に可能でしたらぶっかけの差分もいただけると嬉しいです。霧子がお姉さんとして受け止めてくれるような台詞が入っているととても嬉しいです。\nよろしければご検討の程よろしくお願いいたします。", "nc": 169, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@kotatuneko15/works/11", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/3a9c2861/uploads/origins/72ccc8d0-170c-4225-b6e0-eabba949b4ea?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=62fdc43fd7e5d251395e50132a0fa46c", "src_set": ""}, "private": true, "genre": "art", "tipped": true, "creator_id": 2791749, "client_id": 0, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 177, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@kotatuneko15/works/10", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/1de0d294/uploads/origins/9c599a49-acca-40ca-a2f2-6fb6d0040388?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=8847b7544238c0bf162da7565be0c81d", "src_set": ""}, "private": true, "genre": "art", "tipped": true, "creator_id": 2791749, "client_id": 0, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "bod