-488e-bfe7-6b33c64dc290?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=9dc1f611064cc0e68a5426da7f75348f", "src_set": ""}, "private": true, "genre": "art", "tipped": true, "creator_id": 1899006, "client_id": 0, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 0, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@monu_oekaki/works/54", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1899006, "client_id": 2845229, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/6e0dde5e/uploads/origins/c99f4c06-f7c0-4f28-8bad-dc6c032880a8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9e6e5c1d9281aa1fe4c60295b3d8fd76", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/6e0dde5e/uploads/origins/c99f4c06-f7c0-4f28-8bad-dc6c032880a8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9143a2d2974820c6f0f18db747357475", "src_set": ""}, "body": "もぬけ様\n\n初めまして、Vtuberシャルエと申します。\nもぬけ様の素敵なイラストを拝見し、リクエストを送信させていただきました。\nもしご縁をいただけましたら、私シャルエのイラストをお願いいたします。\n\n【リクエスト内容】\nもぬけ様の絵柄で内容はお任せでお願いいたします。\nサムネイルなどに使用させていただきたいため、可能であれば魔法帽の左右どちらかのツバが見切れない構図、もしくは猫耳全体が入った構図を希望です。\n\n【使用用途】\nYoutube、SNS、FANBOX、ネットプリント配布\n難しい内容がございましたら、別のレイヤーでお教えいただけますと大変ありがたく存じます。\n\n【納品形式】\n人物、背景、宛名等がレイヤー分けされたPSDもしくは背景透過のPNGを希望です\n\n【キャラクターについて】\n・魔法図書館で使い魔猫に囲まれて暮らす白猫\n・身長150センチ（耳を含まない）\n・猫耳としっぽがあり、人間の耳がありません\n\n【参考資料】\nhttps://drive.google.com/drive/folders/12YJ1-uparnq_s7hCfYaCiP4sSk9bZMpW?usp=sharing\n\nご検討いただけますと幸いでございます。\nどうぞよろしくお願いいたします。", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@monu_oekaki/works/53", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1899006, "client_id": 3218006, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/659102ff/uploads/origins/24f788b3-fb3b-4825-96ce-4f6312796319?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9532758ef892cf46b10402e507f9e009", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/659102ff/uploads/origins/24f788b3-fb3b-4825-96ce-4f6312796319?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=25a3f5df1715bfc6e6a4084822632eef", "src_set": ""}, "body": "うちの子のイラストをお願いしてもいいでしょうか？\nhttps://drive.google.com/drive/folders/1GAMd8B6lK2NbNjISNIJrFYuasNfyFviE?usp=sharing\n\nもぬけさんの絵柄がとってもかわいくてぜひ見たいと思いました…！\n\nできれば、あのデカジャケットの衣装で見たいですが、他の衣装もOKです！\nそして、作ったばかりの子なので、分からない部分があったら、それとも「もっとこう描けばかわいいかも…！」の部分も、適当にいじってもOKです～！\n\nこの子だと、生意気な表情とか、少し照れちゃうのも好きですけど、かわいいなら何でもOKです！\n\nあの衣装的に、少し太もも見える感じの構図だったら嬉しいです！\n具体的な構図とかお任せします！\n\nよろしくお願いします！", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@monu_oekaki/works/52", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1899006, "client_id": 0, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/62a4fbc5/uploads/origins/bb972d0f-7f12-4d23-a0ed-bfd0ec155cde?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=cb67c027a71a52cb40ac29b2219dcbef", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/62a4fbc5/uploads/origins/bb972d0f-7f12-4d23-a0ed-bfd0ec155cde?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=7dc0a2d4cbc2c35f6ffb997eff8a3942", "src_set": ""}, "body": "もぬけ様\n\n初めまして、個人でVTuber活動中のでんぱこはる(名前が変わる予定で現在はまだ鈴々猫こはるとして活動中です。)と申します。\nもぬけ様の描かれる、キラキラで萌え可愛いイラストが大好きですっっ！\nぜひわたしのことも描いて頂けると嬉しいです、、！\n\nイラスト内容:\nYouTube配信待機画面用のもの。\nサイズ→16:9のサイズでお願いいたします！\n全部好きですが、、↓↓こちらのイラストの雰囲気が特に好きです！\nhttps://skeb.jp/@monu_oekaki/works/32\n軽く動かすことが出来ればと考えておりまして、もし可能であれば瞬きorウインクなどの表情もありますと大変嬉しいです！(金額面で難しい様でしたら無しでももちろん大丈夫です…！)\n\n●キャラクターについて(特徴など)●\nでんぱ系×萌え系をイメージしたキャラクターデザインとなっております。\n性格は元気なクソガキ系デス。\n(まだ原案ができたばかりの為、資料が少ないのですが、、特徴等できる限り纏めさせて頂きましたので、ご確認頂けますと幸いです。)\n\n※キャラデザ資料まとめ画像を添付いたします！\n\n●使用用途●\nNow Loading等の文字を被せての配信待機画面での使用のほか、サムネイル、SNSでの宣伝活動での使用。\nまた、ネットプリント配布の可能性もありです。\n難しいものがございましたら、お手数ですが別レイヤー等でお伝えくださいますと有難いです。\n\nデータ形式について:\n背景・人物・サイン等をわけたPSDでのデータで頂けますと大変ありがたいです。\n\nお忙しい中大変恐縮ですが、ご検討頂けますと幸いです！！\n何卒よろしくお願いいたします(⁎ᴗ͈ˬᴗ͈⁎)\n\nでんぱ\n\nhttps://drive.google.com/drive/folders/1-95JCzDRTWYqt0Z7OUse01Yn8IUucfOs", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "similar_creators": [{"id": 101414, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "Mr.Dirty_penguin", "screen_name": "neronero018", "avatar_url": "https://pbs.twimg.com/profile_images/1482246696423735296/EEqfgv4t.jpg", "header_url": "https://pbs.twimg.com/profile_banners/385902326/1601121251/1500x500", "appeal_receivable": true, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 3, "skills": [{"genre": "art"}], "nc": 144}, {"id": 1304383, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "天魚いず", "screen_name": "amago_izu", "avatar_url": "https://proxy.misskeyusercontent.jp/avatar/media.misskeyusercontent.jp%2Fio%2Fb52c95dd-f850-4153-8281-18a7f8f4c4be.webp?avatar=1", "header_url": "https://media.misskeyusercontent.jp/io/96494897-a001-47f8-ba37-112e62c0d125.webp", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 3, "skills": [{"genre": "ar