": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/a6ef5f4e/uploads/origins/ba6b68ae-8a47-4227-909d-6239e0aa30bd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=8ea4b49bd3c097db375194794e66885c", "src_set": ""}, "body": "こんにちは\nはイラストを依頼しています\n\nイラストはVTuberの活動に使わせて頂きます。\n・Twitter等snsでの利用\n・youtubeのサムネイル、動画などです。\n・シンプルなカフェの背景\n・サイズ16:9、人物を中央に配置し、背景なしの独立した人物が必要です。\n\n服装や髪型は自分で選んだり作ったりすることができます。\n人物の原型：\nhttps://drive.google.com/drive/folders/1zDxbYB2zxOBN9MQDUFYn8wXG4IBLz1Gq?usp=sharing\n\nイラストの人物透過pngまたは文字等別々のpsd形式できますと幸いです。\n\nありがとうございました。\n__\n\n構図内容：\n\n片手で指を前に指し（クリームを塗りたい感じ）、もう片方の手でケーキを持って、メイド服を着ていて、背景はカフェです。\n\n参考画像：\nhttps://drive.google.com/drive/folders/1KAhP0AJPumUnxQiSPXJantiW3Py8ZNUz?usp=drive_link", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@monu_oekaki/works/58", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/d8e59ab0/uploads/origins/c3c0bf89-186c-4dbb-913a-3b1140b656db?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=8c87f4bdf7bed7aae5f17ca3b37f7399", "src_set": ""}, "private": true, "genre": "art", "tipped": true, "creator_id": 1899006, "client_id": 3170864, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 144, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@monu_oekaki/works/57", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/e67a149a/uploads/origins/786f16fb-9977-4cca-97c1-da0ef074f100?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=a791ae3a601eb584c573f8f513ad955f", "src_set": ""}, "pr