3b-09b073a06fdc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e8aa54e5aaf29e150191485736d721d5", "srcset": "https://si.imgix.net/15dc1e95/uploads/origins/7f0e1e75-f3da-4d44-ad3b-09b073a06fdc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e8aa54e5aaf29e150191485736d721d5, https://si.imgix.net/15dc1e95/uploads/origins/7f0e1e75-f3da-4d44-ad3b-09b073a06fdc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=ffb7650ca6e42c7edfd1498c27114082 2x, https://si.imgix.net/15dc1e95/uploads/origins/7f0e1e75-f3da-4d44-ad3b-09b073a06fdc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=4eff2a8578ee87910cf41bb719899fb1 3x"}, "body": "むすか先生、お世話になっております。\n先日「ゴブリンズ・ネスト」のリリさんの作品 (https://skeb.jp/@muska_/works/16) をリクエストさせていただいた者です。その際には本当に素晴らしい作品をありがとうございました。\n前回の作品があまりに素晴らしかったため、今回はその続編orパラレル展開にあたる作品をお願いしたくリクエストをお送りしました。ご検討いただけますと幸いです。\n\nキャラクター・シチュエーションは以下のようにお願いします。\n\n【キャラクター】\n●シスター・ヘレナ（先生の御作品「ゴブリンズ・ネスト」のもう一人のヒロインです）\n●ゴグレ（前作の竿役です）\n※前作でのゴグレさんが竿役として完璧でしたので、今回はシスター・ヘレナとの絡みが見たいと思いこのような組み合わせにいたしました。\n\n【シチュエーション】\nゴグレさんに興味を持ったシスター・ヘレナが教会に招いたor性欲を持て余して徘徊していたゴグレさんが教会にたどり着いたことによりセックスすることになりますが、ゴグレさんの人間離れした凶悪巨根と絶倫ぶりによりシスター・ヘレナがイかされまくり、快楽堕ちしてしまうという展開でお願いします。\n\n作品の形式などについては前回同様、お任せいたします。導入についても、より自然で描きやすそうなものがありましたら変更していただいて大丈夫です。前作での描写が非常に素晴らしかったため、アヘ顔・オホ声・のけ反り絶頂などの表現や、断面図付きの子宮姦描写などを入れていただけると大変嬉しいです。\n\n以上のようなシチュエーション・内容について、シスター・ヘレナのキャラ付け的に大きな問題がある（例えば上記では普通に膣でのセックスを想定してしまっていますが、アナルセックスのみOKなキャラであったり、快楽堕ち描写が致命的なキャラ崩壊になったりするなどの）場合につきましては、お手数ですがキャンセルなどでご対応いただければと思います。\nまた、負担が過大・ご多忙であるなどの場合にも同様のご対応をお願いします。リクエスト内容・時期などを再考いたします。\n\n今回も条件が見合うようでしたら、是非よろしくお願いいたします。", "nc": 176, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@muska_/works/17", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/de29d7e8/uploads/origins/5054be91-30b1-4619-bc96-4d9af46fd8fd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=cd3aca70b9f178b7d5beea116103dfb2", "srcset": "https://si.imgix.net/de29d7e8/uploads/origins/5054be91-30b1-4619-bc96-4d9af46fd8fd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=cd3aca70b9f178b7d5beea116103dfb2, https://si.imgix.net/de29d7e8/uploads/origins/5054be91-30b1-4619-bc96-4d9af46fd8fd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=dc20e6951e2878aec134ae32c5755c08 2x, https://si.imgix.net/de29d7e8/uploads/origins/5054be91-30b1-4619-bc96-4d9af46fd8fd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=0cbd4bd676ade8e11cecd63b084b5d71 3x"}, "private": true, "genre": "art", "tipped": false, "creator_id": 60921, "client_id": 157395, "nc": 161}, {"path": "/@muska_/works/16", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 60921, "client_id": 2856240, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/b5bdcf17/uploads/origins/27ff3937-73da-4087-921a-2cd1cba10adc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8e9219238968b3d49f3ef5b55e38ca4a", "srcset": "https://si.imgix.net/b5bdcf17/uploads/origins/27ff3937-73da-4087-921a-2cd1cba10adc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8e9219238968b3d49f3ef5b55e38ca4a, https://si.imgix.net/b5bdcf17/uploads/origins/27ff3937-73da-4087-921a-2cd1cba10adc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=cd4434452ec2fe2ebbaff55824675923 2x, https://si.imgix.net/b5bdcf17/uploads/origins/27ff3937-73da-4087-921a-2cd1cba10adc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e83454eec9387bb142c054cbc0c5db1f 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/b5bdcf17/uploads/origins/27ff3937-73da-4087-921a-2cd1cba10adc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3746a7b35ef0dca43cbdf12ebbdc3b9c", "srcset": "https://si.imgix.net/b5bdcf17/uploads/origins/27ff3937-73da-4087-921a-2cd1cba10adc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3746a7b35ef0dca43cbdf12ebbdc3b9c, https://si.imgix.net/b5bdcf17/uploads/origins/27ff3937-73da-4087-921a-2cd1cba10adc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=76c7cf75fab1a4e51bb1b60c00b2fe65 2x, https://si.imgix.net/b5bdcf17/uploads/origins/27ff3937-73da-4087-921a-2cd1cba10adc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=785a88c42da162a2d3dc6fbdb3cd4161 3x"}, "body": "むすか先生\n大変恐縮ですが再送させていただいております。負担が過大・スケジュール的に厳しいなどのことがありましたら、お手数ですがキャンセルなどでご対応いただければと思います。\n\n以下のようなキャラクター・シチュエーションで作品をお願いできればと思います。\n\n【キャラクター】\n●リリ・D・P・ネヴァライネン（先生が制作されているRPG「ゴブリンズ・ネスト」の主人公です）\n●竿役（村で爪弾きにされている男）\n※オークの血でも引いたのか天然でイボ付きのカリ高巨根の持ち主で、性欲過剰の絶倫です。精液量も多いです。村の女性を襲おうとしたため、村外れに隔離されています。襲撃は村人たちに阻止され三十路を過ぎても童貞ですが、セックスの才能は神がかっています。現在は女性との接点がなく悶々としており、凄まじい性欲と精力を溜め込んでいます。先生の描かれる美女と太った汚いおっさんの絡みが最高にツボですので、この竿役についても脂ぎった肥満体型で剛毛な感じだと嬉しいです。調子に乗るところがあり、普段はおどおどしていても女性を襲うときは強気に出ます。\n\n【シチュエーション】\nリリさんが霊薬の錬成に使う人間の精液採取用に連れてきた（いなくなっても影響が少なさそうかつ精力を溜め込んでいそうな）竿役を抜こうとするも、美女と性行為ができることに興奮・暴走した竿役に犯されまくる\n\nアヘ顔・オホ声・仰け反り絶頂など下品な要素アリアリでお願いします。男は最初、魔女のリリさんにビビッておどおどしており、その後は興奮に任せてガツガツ犯している感じですが、余裕ができてリリさんが感じていることが分かるとねっとり愛撫しながら言葉責めしつつ犯す感じだと嬉しいです。フィニッシュ時は断面図描写を是非入れていただければと思います。NGでなければペニスが子宮内に入っている描写（子宮姦・子宮内直接射精）があると最高です。最後は快楽堕ちだと嬉しいですが、リリさんのキャラに合わなければオミットしてください。\n\n形式（イラスト差分or漫画）、色（カラーorモノクロ）などは先生にお任せいたします。\nご検討をよろしくお願いします。", "nc": 169, "word