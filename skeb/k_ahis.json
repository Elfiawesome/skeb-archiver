umbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2509689, "client_id": 6326, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/c548f1bd/uploads/origins/6ce7ff91-d168-448d-8701-ba300d92aaad?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4ee1b5cb68278e5dbe3b0d0b8621c843", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/c548f1bd/uploads/origins/6ce7ff91-d168-448d-8701-ba300d92aaad?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c2257b8084d3f4ea37fca562569ddc67", "src_set": ""}, "body": "こんばんは。先日は大変お世話にました。\n立て続けのリクエストとなりますが、もしご都合よろしければご一考いただけると幸いです。\n\n資料URLのオリキャラのイラストをお願いします。\n服装のバリエーションが和装、洋装、白スク水など色々ありますがお好きなものを選んでいただいてokです。\nスク水以外の場合は可能な範囲でしっかりめにパンチラしている構図に希望。\n\n薄く紫色がかった髪は前髪だけストレート、もみあげ部分や後ろ髪は軽くウェーブがかったのが特徴。\n肌は色白よりです。\n\nhttps://drive.google.com/drive/folders/1Xav5OaNXLvFK73gX2qZdVuRXfmCFtBiZ", "nc": 48, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@k_ahis/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2509689, "client_id": 6326, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/a6a47665/uploads/origins/faf9cb11-3a08-4efa-bf93-784e5e3b17bf?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0f88e7d2cd25ab34b8f893c0b2f6f5ee", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/a6a47665/uploads/origins/faf9cb11-3a08-4efa-bf93-784e5e3b17bf?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=7c5ff5d4cce41c55ae067b984d548188", "src_set": ""}, "body": "こんばんは。はじめまして、\nもしよろしければうちのオリジナルキャラのイラストリクエストさせていただきたいです。\n\n名前：猫大明神珠尾（通称珠姫）\n外見：資料参照\n性格：明るく積極的なお転婆姫\n\nポージングはおまかせします。手持ちの小道具や武器はなくてもokです。\n表情は明るい雰囲気に。\nスカートは短め。パンチラ希望。パンチラ以上にエッチな目に遭わせてもokです。\n\n妖怪（猫又）×姫×巫女×忍者という結構属性を盛ってあるキャラなので、気に入った要素などあればそれを中心に弄ってやってもらって結構です。\n構図の希望としては肉付きの良い黒ストの太ももがなるべく見えやすい形に希望です。\n\nhttps://drive.google.com/drive/folders/124sOJOAB0EG8FxYOq8w6YF-BJd-L-EEw", "nc": 160, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}], "similar_creators": [{"id": 62902, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "こがくなまイトヒロ3世", "screen_name": "kogaitohiro", "avatar_url": "https://pbs.twimg.com/profile_images/758996973097590786/08Qhl5zD.jpg", "header_url": "https://pbs.twimg.com/profile_banners/758995878765993984/1469794041/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "skills": [{"genre": "art"}], "nc": 161}, {"id": 122727, "creator": true, "nsfw_acceptable": true, "acceptable": false, "name": "かぼす", "screen_name": "kabosudachin", "avatar_url": "https://pbs.twimg.com/profile_images/1708811589204549632/gYl0N6iL.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1708804310065389568/1696248056/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "skills": [{"genre": "art"}], "nc": 33}, {"id": 175720, "creator": true, "nsfw_acceptable": true, "acceptable": false, "name": "ななしろ", "screen_name": "nanasiro", "avatar_url": "https://pbs.twimg.com/profile_images/1963745438915575808/U-mO0w2Q.jpg", "header_url": "https://pbs.twimg.com/profile_banners/76213025/1753927422/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "skills": [{"genre": "art"}], "nc": 176}, {"id": 1251736, "creator": true, "nsfw_accepta