下が黒い\n-傷つきやすい\n-絶望に屈しないようにしている\n-医療用タバコを吸う\n\nhttps://drive.google.com/drive/folders/1YC-nLXmsH8F--UdVoxtMSlrleFYoqdug?usp=drive_link", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 852565, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "ぐじゃ太🍼", "screen_name": "NrU6c", "avatar_url": "https://pbs.twimg.com/profile_images/1611751118153093120/vq6gsoGB.jpg", "header_url": "https://pbs.twimg.com/profile_banners/775633948697202688/1680187723/1500x500", "appeal_receivable": true, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 100, "skills": [{"genre": "art"}], "banned": false, "nc": 48}, {"id": 1782073, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "幽靈ちゃん", "screen_name": "YureiChanXXX", "avatar_url": "https://pbs.twimg.com/profile_images/1963434860959485952/9y_6cagd.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1356724065692643329/1780122573/1500x500", "appeal_receivable": true, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "art"}], "banned": false, "nc": 176}, {"id": 3090307, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "ひ~", "screen_name": "hiipopo", "avatar_url": "https://pbs.twimg.com/profile_images/1756367074904182784/rJYOWZuQ.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1697015935604019201/1758969101/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 100, "skills": [{"genre": "art"}]