どう考えてもお前らが悪い!の\n黒木智子と田村ゆりが\n全裸でレズセックス\nキスしながら貝合わせ\n数コマの漫画の形式で\nお互い照れつつもラブラブな雰囲気で\n\n\n宜しくお願いします。", "nc": 176, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@ISANAinUSA/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 258777, "client_id": 0, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/c570bfc4/requests/234887_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1d0b262dcbe1907b8e5eaa7c7c107b81", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/c570bfc4/requests/234887_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e30effc10874291e6aa1c0e9d68828ae", "src_set": ""}, "body": "自分の勝手な妄想をイラスト化、お願いしたいと思います。\n以前描かれた同人誌「エリゆか地獄ヘン(中)」の⑥『ファム・ファタルの引力』のエリカが目覚めた後。\n優花里とエリカは負け犬同士のキスをして…その後そのまま流されるように、激しく慰め合った…\n…というシーンをお願いします。\n(以下、脳内妄想続き)\nその後、「今日の事は事故、無かったことに」と約束したものの、身体の相性が良すぎてお互いに忘れることが出来ず、その後もちょくちょく二人は互いのカラダを貪り堪能し合うように…行為は悪態を付きあいながら、そして違う想い人の事を考えながら…。\nでも、若いオンナの身体は、嫌と言うほどの快感を二人に味わせ続けて…共にセックスに溺れさせていく…\n------\n・イラストの形式について:\n　白黒で2コマほど起/結、またはカラーで1枚イラスト。(判断して頂いて、ご都合の宜しい方でお願いします)\n・ポーズなど:\n　ナメクジの交尾のようにねっとりと…二人が裸体で絡み、互いに快感に溺れて激しく無心に求め合う…的な感じでお願いします。\n・追記:本作完結、お待ちしてます。", "nc": 161, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "similar_creators": [{"id": 112401, "creator": true, "nsfw_acceptable": true, "acceptable": false, "name": "@yahuokusato", "screen_name": "yahuokusato", "avatar_url": "https://pbs.twimg.com/profile_images/1170562477093900288/HKQBkqO1.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1130287943740825601/1589516851/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 10, "skills": [{"genre": "art"}], "nc