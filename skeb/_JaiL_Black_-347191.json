: true}, {"path": "/@_JaiL_Black_/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 28957, "client_id": 2628535, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/867acffb/uploads/origins/5f4d3070-5580-4c58-b712-a6029d49e195?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=56b6c41a7db7e6eeaff92d621233143b", "srcset": "https://si.imgix.net/867acffb/uploads/origins/5f4d3070-5580-4c58-b712-a6029d49e195?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=56b6c41a7db7e6eeaff92d621233143b, https://si.imgix.net/867acffb/uploads/origins/5f4d3070-5580-4c58-b712-a6029d49e195?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=abe2c664676494e5d4145558ce97b209 2x, https://si.imgix.net/867acffb/uploads/origins/5f4d3070-5580-4c58-b712-a6029d49e195?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b4359195312611fa50d0757de3e92266 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/867acffb/uploads/origins/5f4d3070-5580-4c58-b712-a6029d49e195?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0480ffaf9dcab5384c6897c2bb311f32", "srcset": "https://si.imgix.net/867acffb/uploads/origins/5f4d3070-5580-4c58-b712-a6029d49e195?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0480ffaf9dcab5384c6897c2bb311f32, https://si.imgix.net/867acffb/uploads/origins/5f4d3070-5580-4c58-b712-a6029d49e195?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=f73482a30b1b65326a215cb38bb8cd91 2x, https://si.imgix.net/867acffb/uploads/origins/5f4d3070-5580-4c58-b712-a6029d49e195?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=7f63d64fb1c7cb03e9fb6cce779d14f6 3x"}, "body": "こんにちは、親愛なるNana太郎さん\n私のキャラクター「cen」を気に入っていただけてとても光栄です。\n彼は捕らえられ、研究所に戻された。手足は固定され、ペニスは貞操帯につながれ、尿道は尿道カテーテルにつながれ、触手は尻の穴に挿入され、1ヶ月間動けなかった。1ヶ月間耐えたが射精できず、1ヶ月間の刺激でペニスと睾丸が肥大化したときの彼の絶望的な表情を想像してみてほしい。彼はたくさんの涙とよだれを流した。\nリンクは彼の設定です、彼の髪型を \"发型参考 \"に変えてください。彼の服のアクセサリーを変更したり、布を追加したり削除したりすることができます。\nhttps://drive.google.com/drive/folders/1i3lox3imtXlwve8fvKn1njdSXG4RBou9?usp=sharing\nありがとうございました！\n\nhttps://drive.google.com/drive/folders/1i3lox3imtXlwve8fvKn1njdSXG4RBou9?usp=sharing", "nc": 40, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@_JaiL_Black_/works/4", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/d57cf3d5/uploads/origins/67638890-012a-40a8-88cf-c7883766bdca?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=90c46c028dd479b7583ff8cf7e0f951c", "srcset": "https://si.imgix.net/d57cf3d5/uploads/origins/67638890-012a-40a8-88cf-c7883766bdca?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=90c46c028dd479b7583ff8cf7e0f951c, https://si.imgix.net/d57cf3d5/uploads/origins/67638890-012a-40a8-88cf-c7883766bdca?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=f8c7e3cc9c89c1b86fadf44641a4b7e9 2x, https://si.imgix.net/d57cf3d5/uploads/origins/67638890-012a-40a8-88cf-c7883766bdca?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=d3e3fc9d116779bd310966ad0d1b8d20 3x"}, "private": true, "genre": "art", "tipped": false, "creator_id": 28957, "client_id": 81702, "nc": 161}, {"path": "/@_JaiL_Black_/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 28957, "cl