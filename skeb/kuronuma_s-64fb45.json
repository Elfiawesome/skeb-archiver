-9518-b348ec181e43?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4e53854849f2c9229b36f1fb5aae2bcb, https://si.imgix.net/2e0b22c6/uploads/origins/f6a8c924-6106-4c44-9518-b348ec181e43?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=6cc4d30b8aaf46a175d61a1a8628adec 2x, https://si.imgix.net/2e0b22c6/uploads/origins/f6a8c924-6106-4c44-9518-b348ec181e43?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=61db8bcfd57f33a5d7eeb02f794966c4 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/2e0b22c6/uploads/origins/f6a8c924-6106-4c44-9518-b348ec181e43?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=fd9475c3c4739a25655decbcfc7b2d96", "srcset": "https://si.imgix.net/2e0b22c6/uploads/origins/f6a8c924-6106-4c44-9518-b348ec181e43?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=fd9475c3c4739a25655decbcfc7b2d96, https://si.imgix.net/2e0b22c6/uploads/origins/f6a8c924-6106-4c44-9518-b348ec181e43?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=e1096af27f96800208b5602112d33ab6 2x, https://si.imgix.net/2e0b22c6/uploads/origins/f6a8c924-6106-4c44-9518-b348ec181e43?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=2b16a0977cef60c3abdea4d0b5806b3d 3x"}, "body": "はじめまして。すかいはいと申します。\n以前にTwitterでくろぬまさんが描いていらっしゃった七星みりりさんのファンアートを拝見したのですが、とても綺麗で感動したのでskebを依頼させていただこうと思いました。\n今回は私の推しであるバーチャルアイドルの『江波キョウカ(えば・きょうか)』さんを描いていただきたいです。\n江波キョウカさんは「全肯定オタクエンジェル」という異名があり、アニメや漫画が好きなオタクっぽさと相手のどんなところも全肯定してあげる優しさを持った人です。\nまた、どんな曲でも歌いこなす変幻自在の歌声の持ち主で、可愛らしい見た目ながらメタル系の曲を歌うユニットに所属しているので格好良い系の歌やダンスも得意としています。\nそんな江波キョウカさんが可愛らしい衣装を身に纏ったキラキラしたイラストを描いていただければと思います。\n資料として付けましたLive2D新衣装が好きなので、そちらの衣装だとより嬉しいです。\nまた、キョウカさんは身長149cmと小柄ですが、立ち絵などを見る限りでは割と胸は大きい方なのでそういったところも表現していただけるとありがたいです。\n描いていただいたイラストはキョウカさんのファンアートタグに上げさせていただくつもりです。\n