n\n胸の膨らみはなるべくなだらかだと助かります。\n\nもう一点、使用用途として\nSkeb依頼で描いて頂いた物として\n御本人様のファンアートタグへ投稿したいと考えています。\nなので御本人様に限る形で、\n配信等の活動においてサムネイル素材として使用する許諾を頂きたいです。\nその為、宛名・背景・人物などでレイヤー分けされたpsdファイルで納品頂けますと幸いです。\nリクエストの内容は問題ないけど、そういうのはちょっと……\nと言うことでしたら、内容変更の再送希望を頂けますと幸いです。\n\n\nご一考いただけますと幸いです。よろしくお願いします。", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@kengo_kumaxile/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3376538, "client_id": 1236502, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/6bca20b9/uploads/origins/073760a3-3c34-46d3-9c05-83e9db1e6b30?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6d0b31e46c1a05764f5feb9662f93472", "srcset": "https://si.imgix.net/6bca20b9/uploads/origins/073760a3-3c34-46d3-9c05-83e9db1e6b30?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6d0b31e46c1a05764f5feb9662f93472, https://si.imgix.net/6bca20b9/uploads/origins/073760a3-3c34-46d3-9c05-83e9db1e6b30?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=6210af23551aaae3c89afab215e3e795 2x, https://si.imgix.net/6bca20b9/uploads/origins/073760a3-3c34-46d3-9c05-83e9db1e6b30?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=dc4fa9c2685e9a8130dacf7484334a63 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/6bca20b9/uploads/origins/073760a3-3c34-46d3-9c05-83e9db1e6b30?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=7726264a939e46bedc05fb87f7fe53b1", "srcset": "https://si.imgix.net/6bca20b9/uploads/origins/073760a3-3c34-46d3-9c05-83e9db1e6b30?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=7726264a939e46bedc05fb87f7fe53b1, https://si.imgix.net/6bca20b9/uploads/origins/073760a3-3c34-46d3-9c05-83e9db1e6b30?bg=%23fff&auto=format%2Ccomp