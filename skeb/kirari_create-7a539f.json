84d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=871d40465f38adf21cbfb408cbfc89d5", "srcset": "https://si.imgix.net/42332fdc/uploads/origins/19599e34-3c07-40d7-b7d6-136d1a93184d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=871d40465f38adf21cbfb408cbfc89d5, https://si.imgix.net/42332fdc/uploads/origins/19599e34-3c07-40d7-b7d6-136d1a93184d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=2ae16a4e1ff4a9d52846a240c437094c 2x, https://si.imgix.net/42332fdc/uploads/origins/19599e34-3c07-40d7-b7d6-136d1a93184d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=694be51f8276600a38741f50dff43bc2 3x"}, "body": "星賀キラリ 先生\n\nお世話になっております、さなぎ雪蝶です！\n\n以前からキラリ先生のイラストを拝見しており、とても可愛らしく素敵な絵柄だなと思っていました！\n\nぜひキラリ先生の絵柄で、SDイラストを描いていただけましたら嬉しいです！\n\n下記の内容にて、SDイラストをお願いできればと思っております。\n\n【使用用途】\nIRIAMでの配信・SNSへの投稿・イベントや記念企画での使用・グッズ等への使用を予定しております。\n\n【内容】\n新衣装の立ち絵をもとにした、SDイラストを希望しております。\n\n基本的には、キラリ様の描きやすいポーズ・構図でお任せできればと思っております！\n特にポーズの希望はございませんので、キラリ様の絵柄で可愛らしく仕上げていただけましたら嬉しいです！\n\n【表情差分】\n通常の表情に加えて、3種類ほど表情差分をお願いできればと思っております。\n\n具体的な表情については、\n・子供っぽい満面の笑み\n・泣き顔(´；ω；｀)\n・ほっぺをプクっとして怒ってるような表情(  ｰ̀ н ｰ́ )\n\nなどをイメージしておりますが、キャラクターに合うようにアレンジしていただいても大丈夫です！\n\n【お願い】\nIRIAMやSNS等で使用する予定があるため、頭や身体が切れないよう、全身が分かる形で描いていただけますと幸いです。\n\nまた、可能でしたら背景透過の状態でご納品いただけますと嬉しいです！\n\n【参考資料】\n・新衣装立ち絵\n\n今回、新衣装の立ち絵をもとにお願いできればと思っておりますので、衣装や髪型・アクセサリー・星空モチーフの目などは、基本的に立ち絵に合わせていただけますと幸いです。\n\n細かな部分につきましては、キラリ先生の絵柄や描きやすさを優先していただいて大丈夫です！\n\nお手数をおかけいたしますが、何卒よろしくお願いいたします。\n\nhttps://drive.google.com/file/d/1V6CbAqvaMsbQQ7n_p95rQ1fYG_ATQlJm/view?usp=drivesdk", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@kirari_create/works/14", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3230335, "client_id": 507423, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/aa2dfbdd/uploads/origins/1ecf6728-f1d6-45f7-9933-07011acaf8fc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4baabfb1561f562a6be2546a48831b97", "srcset": "https://si.imgix.net/aa2dfbdd/uploads/origins/1ecf6728-f1d6-45f7-9933-07011acaf8fc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4baabfb1561f562a6be2546a48831b97, https://si.imgix.net/aa2dfbdd/uploads/origins/1ecf6728-f1d6-45f7-9933-07011acaf8fc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=942c89147708f4a78b10226e21f47a99 2x, https://si.imgix.net/aa2dfbdd/uploads/origins/1ecf6728-f1d6-45f7-9933-07011acaf8fc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=6d506d247416f634fa7d19412c1dfab0 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/aa2dfbdd/uploads/origins/1ecf6728-f1d6-45f7-9933-07011acaf8fc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f4d8d589dbac14645c87c232df152a93", "srcset": "https://si.imgix.net/aa2dfbdd/uploads/origins/1ecf6728-f1d6-45f7-9933-07011acaf8fc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f4d8d589dbac14645c87c232df152a93, https://si.imgix.net/aa2dfbdd/uploads/origins/1ecf6728-f1d6-45f7-9933-07011acaf8fc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=b39792584b3be54f6eeb4a622d00accd 2x, https://si.imgix.net/aa2dfbdd/uploads/origins/1ecf6728-f1d6-45f7-9933-07011acaf8fc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=d0c8fb32d3a0d59bfe60f2df01eba2ee 3x"}, "body": "星賀キラリ様\n前回は種子島で武装した犬耳巫女さんをありがとうございました。\n今回は星賀様に終戦の日を描いて頂きたく依頼を送ります。\n\n内容\n巫女装束を着た犬耳ロリババアが三八式歩兵銃で半旗の日の丸に捧げ銃をしている絵をお願いします。\n\n詳細\n巫女装束について\n巫女装束は丈が短かったり肩に切れ込みがある創作特有のものではなく、正規の物をお願いします。\n\n犬耳、尻尾等について\n犬種　柴犬、秋田犬、北海道犬、甲斐犬、紀州犬、四国犬の中からお願いします。\n髪、瞳の色　上記で選んだ犬種を基準にお願いします。(髪型と長さは委任します)\n\n体型等について\n人間でいう9〜18歳くらいの外見\n胸部は貧から巨まで委任します。(ロリ巨乳も可)\n\n表情について\nほんの僅かに優しく微笑んでいる、どこか物憂げ、無表情の中から選んでください。\n\nロリババアついて\n「これが描かれていればロリババア」という定義等はありませんが、悠久の時を生きた経験らしさ、威厳なり落ち着いた雰囲気なりが描かれていればと思います。\n\n場所について\n委任します。\n迷うようでしたら神社、海辺、密林、荒れ地、洞窟等あたりをお願いします。\n\nその他解説\n半旗\n特定の日に弔意を表すために旗を少し下げた状態で掲揚する行為\nhttps://ja.wikipedia.org/wiki/%E5%8D%8A%E6%97%97\n\n三八式歩兵銃\nhttps://regimentals.jugem.jp/?eid=3358#gsc.tab=0\n全長127.6cmあるのでロリババアの身長の参考にして下さい。\n\n捧げ銃\n銃で行う敬礼動作の一種\n参考動画\nhttps://youtu.be/4Qn0lU74PUE?si=O1qJ6KvkmZ0196_n\n(23秒あたり)\n\n注意事項等\n「着剣はしない」ようにお願いします。(各個の敬礼でなく隊の敬礼になるため)\nボルトハンドルは横に倒れている(下記pixiv参照)ようにお願いします。\nhttps://www.pixiv.net/artworks/67649363\n毎年色々な絵師様に同一お題で依頼しており、過去作品等との構図被りは避けられないため、その点に関しては気にしなくて大丈夫です。\n\n今回も大変なお題ではありますが、どうか何卒よろしくお願いします。", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@kirari_create/works/13", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3230335, "client_id": 3062827, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/8e447202/uploads/origins/0cd5247d-c4a5-499d-950a-c37ca50b7cb7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=473db765ac0043614031f8f248479e10", "srcset": "https://si.imgix.net/8e447202/uploads/origins/0cd5247d-c4a5-499d-950a-c37ca50b7cb7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=473db765ac0043614031f8f248479e10, https://si.imgix.net/8e447202/uploads/origins/0cd5247d-c4a5-499d-950a-c37ca50b7cb7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=741ff9b932404cf7e7bf8c26277526da 2x, https://si.imgix.net/8e447202/uploads/origins/0cd5247d-c4a5-499d-950a-c37ca50b7cb7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=2f760f8da55cadd015ed371a000f4737 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/8e447202/uploads/origins/0cd5247d-c4a5-499d-950a-c37ca50b7cb