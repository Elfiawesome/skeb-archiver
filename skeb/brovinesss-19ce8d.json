ovinesss/status/1603417182377218048\n兄酢さんの夢の殺人鬼さんが好みなんですが、特にこの一枚が好of好の為、こんなイメージでお願いできたらと思います。\n返り血を浴びた血濡れのボスが、部下の腰に腕を回しながら「俺のものに何手を出してるんだ」と言いたげに二人で睨みを利かせながら銃口をこちらに向けているようなあおり構図のような……とここまで描きましたがもうなんでもいいです！！兄酢さんのボス部下が見れたらそれでいいので！！好き勝手やりやすいように描いてください！！(やけくそ)\n見れたら嬉しいな～位でのんびりなので、お仕事も落ち着いてから、お手隙の際に宜しくお願いできたらと思います～！\n\nhttps://twitter.com/oshicp_oishiM/status/1616422081763356674", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [{"path": "/@ANT0NI0_ch/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 24303, "client_id": 133645, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/19207b47/uploads/origins/55ce9e88-d405-46b6-856f-cef70dce734c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=41689d5347386d27bc63f7c90b23c214", "srcset": "https://si.imgix.net/19207b47/uploads/origins/55ce9e88-d405-46b6-856f-cef70dce734c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=41689d5347386d27bc63f7c90b23c214, https://si.imgix.net/19207b47/uploads/origins/55ce9e88-d405-46b6-856f-cef70dce734c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=598ca9199c50e7ea29d5a2dc179974d4 2x, https://si.imgix.net/19207b47/uploads/origins/55ce9e88-d405-46b6-856f-cef70dce734c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=2814d352d44f89a80c4931363f705fd0 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/19207b47/uploads/origins/55ce9e88-d405-46b6-856f-cef70dce734c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=7ab59916751be8f2176e4f69e449c5a4", "srcset": "https://si.imgix.net/19207b47/uploads/origins/55ce9e88-d405-46b6-856f-cef70dce734c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=7ab59916751be8f2176e4f69e449c5a4, https:/