文字を入れていただけると嬉しいです。\nロビンのセリフ（くぐもった笑い声）や小人族のセリフ、ロビンの悔しそうな心の声等を入れていただければ嬉しいです。\n以前のロビンのくすぐりイラストと同じような、身動きできない体をぷるぷるとくすぐったそうに震わせながら苦しそうにくぐもった声をあげて笑い悶える感じのイラストにしていただければと思います。\n\n同じようなリクエストばかりで大変恐縮ですが、ご検討のほどよろしくお願いします。", "nc": 161, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@middlefing1111/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2744094, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/7b7c890d/uploads/origins/e72ab32a-82fd-4f78-b9f5-b14b50fde1e3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=27064fa8007e41c37a8ce14fd119e06a", "srcset": "https://si.imgix.net/7b7c890d/uploads/origins/e72ab32a-82fd-4f78-b9f5-b14b50fde1e3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=27064fa8007e41c37a8ce14fd119e06a, https://si.imgix.net/7b7c890d/uploads/origins/e72ab32a-82fd-4f78-b9f5-b14b50fde1e3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=5900e3ad93cd749f10d46c5e73707a1b 2x, https://si.imgix.net/7b7c890d/uploads/origins/e72ab32a-82fd-4f78-b9f5-b14b50fde1e3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=3574089db0d855e51b2e024d05c341a1 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/7b7c890d/uploads/origins/e72ab32a-82fd-4f78-b9f5-b14b50fde1e3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=57184373b36517eb197cf5cafa3890f6", "srcset": "https://si.imgix.net/7b7c890d/uploads/origins/e72ab32a-82fd-4f78-b9f5-b14b50fde1e3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=57184373b36517eb197cf5cafa3890f6, https://si.imgix.net/7b7c890d/uploads/origins/e72ab32a-82fd-4f78-b9f5-b14b50fde1e3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=016c3ea63255ecb942809ca1692813