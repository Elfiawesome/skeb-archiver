3, "client_id": 187493, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/094ef469/uploads/origins/5f11a54e-d5d5-4e12-9a24-f410cd1f2f92?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bfcd0e44638184d26bb93273f35a3e87", "srcset": "https://si.imgix.net/094ef469/uploads/origins/5f11a54e-d5d5-4e12-9a24-f410cd1f2f92?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bfcd0e44638184d26bb93273f35a3e87, https://si.imgix.net/094ef469/uploads/origins/5f11a54e-d5d5-4e12-9a24-f410cd1f2f92?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=71c68c28b36acc9059bb09fa6691ead8 2x, https://si.imgix.net/094ef469/uploads/origins/5f11a54e-d5d5-4e12-9a24-f410cd1f2f92?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=829e825c513c7d6db988945881fe3aa9 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/094ef469/uploads/origins/5f11a54e-d5d5-4e12-9a24-f410cd1f2f92?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5747944f6e54fa4ef4052100c485bb87", "srcset": "https://si.imgix.net/094ef469/uploads/origins/5f11a54e-d5d5-4e12-9a24-f410cd1f2f92?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5747944f6e54fa4ef4052100c485bb87, https://si.imgix.net/094ef469/uploads/origins/5f11a54e-d5d5-4e12-9a24-f410cd1f2f92?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=afb7e3170478da95424814e3327d42d7 2x, https://si.imgix.net/094ef469/uploads/origins/5f11a54e-d5d5-4e12-9a24-f410cd1f2f92?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=1ac9d7189b4f2c13be2492f01baafd85 3x"}, "body": "こんにちは、はじめまして。あなたのアートスタイル、とても美しいです\n\n私のオリジナルキャラクターであるロハンのイラストをお願いしたいです。先生の描く美しい街並みに憧れているので、背景を強く意識したイラストになればうれしいです。ロハンの出身地はアラビアをテーマにした歴史ファンタジー都市で、宮殿やバザールなどがある砂漠のオアシスのようなところです。細かいところは先生の想像にお任せしたいです。\n\nローハンは魔法使いの助手であり、騎士になるための勉強をしている。趣味は本や巻物を読むこと、剣術や武術の練習をすること。性格は真面目で、勉強熱心で、勤勉である。猫のような瞳孔と微妙に尖った耳が特徴。\n\nシーンは何でもいいんです。露伴が景色の中でくつろいでいたり、用事があったり、先生が好きそうな構図を描いてください。\n\nいずれにせよ、このリクエストを読んでいただき、本当にありがとうございました。\n\nhttps://drive.google.com/drive/folders/19ON-gwXTvRNSm_ND_CEcMKw6m3IoY6CD?usp=share_link", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@yoshifunecacao/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 13063, "client_id": 187973, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/c2da7efd/uploads/origins/e45f735c-723e-4d82-ba8a-4d95e353f9c4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e815e48bca3aa3f643dd12475723617b", "srcset": "https://si.imgix.net/c2da7efd/uploads/origins/e45f735c-723e-4d82-ba8a-4d95e353f9c4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e815e48bca3aa3f643dd12475723617b, https://si.imgix.net/c2da7efd/uploads/origins/e45f735c-723e-4d82-ba8a-4d95e353f9c4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=badebfc7fb3630fa189825b50f8a6467 2x, https://si.imgix.net/c2da7efd/uploads/origins/e45f735c-723e-4d82-ba8a-4d95e353f9c4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=fb0c203cfd71bdce8218ece7706aabb9 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/c2da7efd/uploads/origins/e45f735c-723e-4d82-ba8a-4d95e353f9c4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=999a44103dfa11fab4f111a635d9f3ce", "srcset": "https://si.imgix.net/c2da7efd/uploads/origins/e45f735c-723e-4d82-ba8a-4d95e353f9c4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=999a44103dfa11fab4f111a635d9f3ce, https://si.imgix.net/c2da7efd/uploads/origins/e45f735c-723e-4d82-ba8a-4d95e353f9c4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=0d57a4d2187e627a9fff02222975be9f 2x, https://si.imgix.net/c2da7efd/uploads/origins/e45f735c-723e-4d82-ba8a-4d95e353f9c4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=fcdd5d76c205ce6a3a640644733d371b 3x"}, "body": "はじめまして！(*^^*)あなたのアートはとてもかわいいです!\n\nこの2人のオリジナルキャラクターのシーンを描いていただけませんか？ヴィクトリア朝時代（1890年代）のTRPG「コール・オブ・クトゥルフ（CoC）」の設定です。家を持たず、一緒に路上生活をしている親友です。カルト教団に所属している怖い子たちです。\n\n茶髪の少年シェイは物静かで、普段は中性的な表情か、小さく謎めいた微笑みを浮かべている。アロイスのことをとても大切にしている。\n金髪の少年、アロイスは大胆でおしゃべり。表情はいつもにこやか。\n\n以下のようなシーンが考えられます（描きたくなければ描かなくてもかまいません）。\n- 安全な場所に隠れて、盗んだ食料を分け合っている平和なシーン。\n- 廃墟となった教会を一緒に探検している\n- ろうそく、ナイフ、血などを使った怖いカルトの儀式をしているところ。\n- 怖いモンスターと戦ったり、隠れたりしている。\n- お好きなシーン\n\nいずれにせよ、お読みいただきありがとうございました。\n\nhttps://drive.google.com/drive/folders/1uV4UtcsimuwnNtJvnj3WmLZ-heBRzsN9?usp=sharing", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@yoshifunecacao/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 13063, "client_id": 819702, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/78270371/uploads/origins/b5550746-81d4-4723-858b-80abd398534d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bfd608802a47143f9e0641cdbcb6bdab", "srcset": "https://si.imgix.net/78270371/uploads/origins/b5550746-81d4-4723-858b-80abd398534d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bfd608802a47143f9e0641cdbcb6bdab, https://si.imgix.net/78270371/uploads/origins/b5550746-81d4-4723-858b-80abd398534d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=cd8ead1b3b0092bd94829b4aed826a3b 2x, https://si.imgix.net/78270371/uploads/origins/b5550746-81d4-4723-858b-80abd398534d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ad2724cc709dd36a643b55c3fe0443be 3x"}, "duration": null, "nsfw"