fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ba9767775865cdde321200e6dbadb00d 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/1450abed/uploads/origins/983c08ec-88f9-4781-954c-b6869cfb9058?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=55de73f0a4d705d696f11c185ce85f3b", "srcset": "https://si.imgix.net/1450abed/uploads/origins/983c08ec-88f9-4781-954c-b6869cfb9058?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=55de73f0a4d705d696f11c185ce85f3b, https://si.imgix.net/1450abed/uploads/origins/983c08ec-88f9-4781-954c-b6869cfb9058?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=392cf3e08ac3224441882d5b923cdb1b 2x, https://si.imgix.net/1450abed/uploads/origins/983c08ec-88f9-4781-954c-b6869cfb9058?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=276a42c4df6d9e22e8a42d4cbef429b4 3x"}, "body": "DOGDAYSのユキカゼ・パネトーネのイラストを以前描かれていたので下記内容でリクエストさせてください。\n\nユキカゼがモブ男と、https://www.pixiv.net/artworks/65138586　みたいな感じで手つなぎ騎乗位セックスをしているイラストをお願いします。\n\n・ユキカゼは基本着衣状態で、インナーはまくりあげておっぱいが露出した状態\n・上記イラストみたいなずらし挿入\n・モブ男はあまり汚くない感じで顔はイラスト内に入れないでください\n\n細かい構図に関してはお任せいたします。ご検討のほどよろしくお願いいたします。", "nc": 49, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@bol_oekakiyou/works/10", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 6481, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/68ae5b2c/uploads/origins/018addec-1e18-4d56-b7ff-b9084932d7d8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=95ab8eadd726a4e5b05f5ecbf9fbd9f7", "srcset": "https://si.imgix.net/68ae5b2c/uploads/origins/018addec-1e18-4d56-b7ff-b9084932d7d8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=95ab8eadd726a4e5b05f5ecbf9fbd9f7, https://si.imgix.net/68ae5b2c