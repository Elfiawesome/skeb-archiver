humbnail_image_urls": {"src": "https://si.imgix.net/56f67e36/uploads/origins/bb4fb6d7-1490-4b5f-8131-6439d232dee3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=70dcea126294cc7652c6ed1c82bdc10b", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/56f67e36/uploads/origins/bb4fb6d7-1490-4b5f-8131-6439d232dee3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9cc656cb62ec2c75dfa4c62edcd41003", "src_set": ""}, "body": "アイドルマスターシンデレラガールズの柳瀬美由紀をお願いします。\n開脚背面座位で散々中出しされた後のシチュでハート目イキ顔にされているものです。\nち〇ぽを引き抜かれてぽっかり開いたお〇んこからち〇ぽに糸を引く特濃精液が大量に流れ出ている感じでお願いします。\n以上、可能であればお願いします。", "nc": 169, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@tlineporam/works/9", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 426073, "client_id": 321646, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/ff1559c7/requests/198376_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7d0e0fe624b50bf1818e6df42a82ab49", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/ff1559c7/requests/198376_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9835d6832e8fcf116649b84a4136600c", "src_set": ""}, "body": "初めまして、もし受けて貰えたらなと思いリクエストしてみました…！\n\nキャラクターはテイルズオブシンフォニアのコレットで、\n街中に貼られた指名手配書、そこにはコレットが尻を両手で広げてアナルを見せて恥ずかしそうにしている写真が採用されていた。\nそれを見つけたコレットがそれを外そうとすると見知らぬ男が現れコレットのお尻を触りながら宿に誘い、コレットは嬉しそうについて行ってしまう。\nというようなシチュエーションで描いて貰えたらな、と思います…！\n実はコレットが自分で作った手配書で、襲ってくれる人を募集してる、みたいな感じで…とか思ってます！\n\nどうかよろしくお願いします！！", "nc": 176, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@tlineporam/works/8", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 426073, "