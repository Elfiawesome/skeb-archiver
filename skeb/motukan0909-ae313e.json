ns/b836d3b4-2c14-486b-be0a-74a8d14a0251?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=e9f0edd7621065c0d84cd1f117b71474 3x"}, "body": "Hello! I saw your art work on twitter and I really liked your art style! If it would be alright could I pleas,e request an illustration of my Egyptian Priestess OC?\n\nOC Nefertari: https://drive.google.com/drive/u/0/folders/1WWacUI-R6abda71rfNpwi7X1ehpW453F\n\nShe is a stoic & quiet priestess who takes her duty serving her pharaoh a bit too seriously, accidentally coming off as a little cold or emotionless. \n\nPlease draw her however you wish! I would love to see what pose/situation you come up with. NSFW is enabled as well in case you would prefer to draw something sexy or nude.\n\nThank you for your consideration and please have a lovely week!", "nc": 49, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@motukan0909/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 740411, "client_id": 650427, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/b93a5923/uploads/origins/764e2ab9-ff8e-4394-ad0e-270fd0741eb1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f8f46fa2c027e362d2f766a837e6adfa", "srcset": "https://si.imgix.net/b93a5923/uploads/origins/764e2ab9-ff8e-4394-ad0e-270fd0741eb1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f8f46fa2c027e362d2f766a837e6adfa, https://si.imgix.net/b93a5923/uploads/origins/764e2ab9-ff8e-4394-ad0e-270fd0741eb1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=81fd6bd228b6f6d982456a5df10ff810 2x, https://si.imgix.net/b93a5923/uploads/origins/764e2ab9-ff8e-4394-ad0e-270fd0741eb1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ff09eed681ae1964eca87aeb37f4c451 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/b93a5923/uploads/origins/764e2ab9-ff8e-4394-ad0e-270fd0741eb1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=bea667a31b062cdedc5f49ae7911791d", "srcset": "https://si.imgix.net/b93a5923/uploads/origins/764e2ab9-ff8e-4394-ad0e-270fd0741eb1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=bea667a31b062cdedc5f49ae7911791d, https://si.imgix.net/b93a5923/uploads/origins/764e2ab9-ff8e-4394-ad0e-270fd0741eb1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=a44d5887a4cfc9a4bcbed6fe42d4195b 2x, https://si.imgix.net/b93a5923/uploads/origins/764e2ab9-ff8e-4394-ad0e-270fd0741eb1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=dd1e4ca0806b5eb98a213bfd10ce6878 3x"}, "body": "こんにちは、もつかんさん！\nあなたの美しい作風が本当に大好きです。特に『Fate』のイラストが素敵ですね。\n他の作品と同じく、高品質で、フルカラーかつ丁寧に仕上げられたイラストをお願いしたいです。\n参考画像：https://postimg.cc/gallery/t4nPjB4\n沖田アルターと武蔵が一緒に露天風呂に入っているシーン（全身裸で濡れた体）で、参考画像と同じポーズにしてください。二人が一緒に入浴している最中、沖田アルターが武蔵と深くキスをしている様子（唇が密着し、舌は見えない状態）を描いてください。沖田アルターの裸体とお尻が見えるようにしてください。沖田アルターは武蔵の大きな胸を掴んでいます。二人は互いにキスをしている間、頬を赤らめ、リラックスした表情をしています。\nシーンにはロマンチックな雰囲気が漂っています。\nその他の細部については、ご自由に描いてください。\nこのアイデアを気に入っていただけると嬉しいです！", "nc": 160, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@motukan0909/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 740411, "client_id": 1186395, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/32786d10/uploads/origins/7556abea-ce6b-44bf-8cac-8790408e4f9b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0ebadead73c42d843a8c8c811c626455", "srcset": "https://si.imgix.net/32786d10/uploads/origins/7556abea-ce6b-44bf-8cac-8790408e4f9b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0ebadead73c42d843a8c8c811c626455, https://si.im