えないサイズの調整、ロゴや文字などを入れる可能性があります。\n\n◆納品\n背景、キャラクター、文字等のレイヤーを分けての納品希望です。\n形式：第一希望PSD、第二希望PNG（透過）\n\nご縁があると嬉しいです！ご検討の程よろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/1QRa0xP_cGOH3h-laNX73DbbqI7iNuvfR?usp=sharing", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Risu_0717/works/14", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2970408, "client_id": 1448010, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/5a9e9b2d/uploads/origins/5325dde6-ad93-42f6-b481-d3288e399f4d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b4b4c1b3fbb4c0bd4f20ca0273ec2c3f", "srcset": "https://si.imgix.net/5a9e9b2d/uploads/origins/5325dde6-ad93-42f6-b481-d3288e399f4d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b4b4c1b3fbb4c0bd4f20ca0273ec2c3f, https://si.imgix.net/5a9e9b2d/uploads/origins/5325dde6-ad93-42f6-b481-d3288e399f4d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=21c08030fcb801f7eaa276436e5c66d3 2x, https://si.imgix.net/5a9e9b2d/uploads/origins/5325dde6-ad93-42f6-b481-d3288e399f4d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=84d4cc4a005315410e02379b8907eef5 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/5a9e9b2d/uploads/origins/5325dde6-ad93-42f6-b481-d3288e399f4d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c9a0135c80d11addd5a141fd6dd3eab4", "srcset": "https://si.imgix.net/5a9e9b2d/uploads/origins/5325dde6-ad93-42f6-b481-d3288e399f4d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c9a0135c80d11addd5a141fd6dd3eab4, https://si.imgix.net/5a9e9b2d/uploads/origins/5325dde6-ad93-42f6-b481-d3288e399f4d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=f595bfbbc