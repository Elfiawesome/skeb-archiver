検討のほど、よろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/10PnqQ-_cJ_5mtW3vMGqv3pJ7m-_PLE6w?usp=sharing", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@ShiimeL7122_umi/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3904853, "client_id": 793031, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/a10878ff/uploads/origins/d92bbf7e-a5a3-4fc3-b0ac-b1308d4cfb00?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ee5eb23a2187fe36ccffa7b36e8a0a78", "srcset": "https://si.imgix.net/a10878ff/uploads/origins/d92bbf7e-a5a3-4fc3-b0ac-b1308d4cfb00?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ee5eb23a2187fe36ccffa7b36e8a0a78, https://si.imgix.net/a10878ff/uploads/origins/d92bbf7e-a5a3-4fc3-b0ac-b1308d4cfb00?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=628be6e7063056dcc093bc4e142006b2 2x, https://si.imgix.net/a10878ff/uploads/origins/d92bbf7e-a5a3-4fc3-b0ac-b1308d4cfb00?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=5ed3af335ba96c00ed8719cde069b6b2 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/a10878ff/uploads/origins/d92bbf7e-a5a3-4fc3-b0ac-b1308d4cfb00?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=1e02d1a3e22ee3b4fd8cc0730e6f521d", "srcset": "https://si.imgix.net/a10878ff/uploads/origins/d92bbf7e-a5a3-4fc3-b0ac-b1308d4cfb00?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=1e02d1a3e22ee3b4fd8cc0730e6f521d, https://si.imgix.net/a10878ff/uploads/origins/d92bbf7e-a5a3-4fc3-b0ac-b1308d4cfb00?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=c5b6e9d1eb5542cf8cb6340cd29b2e15 2x, https://si.imgix.net/a10878ff/uploads/origins/d92bbf7e-a5a3-4fc3-b0ac-b130