op=top&w=200&h=200&blur=200&s=c1e8d1650e8e04d947b169ed769aab41, https://si.imgix.net/3d6cc0b1/uploads/origins/dc080f1e-3bdc-4686-a78a-a33180971baa?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=b421ce41bbe352742a8f673adc174f18 2x, https://si.imgix.net/3d6cc0b1/uploads/origins/dc080f1e-3bdc-4686-a78a-a33180971baa?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=92b260e128912a20737357b63eb7060b 3x"}, "body": "Hello, I would like to request the similar illustration to this: https://skeb.jp/@vomitrabbit/works/1\n\nまた、私のキャラクターの顔の絵を2枚お願いします（表情は参考資料と同じで、よだれを垂らしていたり、ドヤ顔だったりします）。  コーヒーとパンとカエルが好きなキャラクターです。\n\n宜しくお願いします。\n\nhttps://imgur.com/a/JpZUsZa", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@syumumoon/works/14", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 977177, "client_id": 508654, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/bdf4bf21/uploads/origins/0166fc47-c819-4a51-b034-819cf9181287?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=11ec5ddabfd9dc47567839274e33d75f", "srcset": "https://si.imgix.net/bdf4bf21/uploads/origins/0166fc47-c819-4a51-b034-819cf9181287?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=11ec5ddabfd9dc47567839274e33d75f, https://si.imgix.net/bdf4bf21/uploads/origins/0166fc47-c819-4a51-b034-819cf9181287?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=75e32955faca7383848678bf5b86db20 2x, https://si.imgix.net/bdf4bf21/uploads/origins/0166fc47-c819-4a51-b034-819cf9181287?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=040d09932746e53846b3dcbc3e7b8953 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/bdf4bf21/uploads/origins/0166fc47-c819-4a51-b034-819cf9181287?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f8b486d67777fe1c97f8902a6be305f4", "srcset": "https://si.imgix.net/bdf4bf21/uploads/origins/0166fc47-c819-4a51-b034-819cf9181287?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f8b486d67777fe1c97f8902a6be305f4, https://si.imgix.net/bdf4bf21/uploads/origins/0166fc47-c819-4a51-b034-819cf9181287?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=10a9d4266fa7a3e74edcff82b173e91e 2x, https://si.imgix.net/bdf4bf21/uploads/origins/0166fc47-c819-4a51-b034-819cf9181287?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=4a8427fc02349bc395bb79c055f5a5c5 3x"}, "body": "Hello!\n\nFirstly, I want to say that I adore your art style! Keep up the amazing work!\n\nI was wondering if you would be able to/would like to draw me some emotes for my character Aster? Here are some references:\n\nhttps://www.furaffinity.net/view/37331193/\nhttps://www.furaffinity.net/view/37535470/\n\nGenerally speaking, you're free to have as much fun with them as you'd like! I'd just love to have a variety of emotions, including:\n\n- Neutral\n- Happy\n- Laughing\n- Crying\n- Angry\n- Blushing\n- Giggling\n- Winking\n- Serious\n\nAgain, have as much fun as you'd like! Looking forward to hearing back from you!", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@syumumoon/works/13", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 977177, "client_id": 1003794, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/ef82cbc0/uploads/origins/ca3734d5-0e02-4854-aad2-f21afe0cf511?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7d696981cda9a491d48187fcf517995d", "srcset": "https://si.imgix.net/ef82cbc0/uploads/origins/ca3734d5-0e02-4854-aad2-f21afe0cf511?bg=%23fff&auto=format%2C