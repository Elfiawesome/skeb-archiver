\n可能でしたら、背景込みの完成イラストとは別に、\n人物のみの透過画像も納品していただけますと嬉しいです\n\n【使用用途】\n・YouTubeのサムネイル、動画内での使用等\n・SNS（Twitter等）での投稿等\n・ホームページでの装飾での使用\n\n(三面図がまだ描けていないので正面だけなので分かりにくいかもしれません、すみません！)\nhttps://drive.google.com/file/d/1wnNWsIP8ts5GPCdUo9m2G2UolXRGn96L/view?usp=drive_link\nhttps://drive.google.com/file/d/1Wc8sKQ7wo32n4oa0ZcqUXPZgQKrDid4s/view?usp=sharing\nhttps://drive.google.com/file/d/1py-SaD-Rp9aqRM3m7ouiwQgof4etBEe6/view?usp=sharing", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@koucha94/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3966501, "client_id": 1511006, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/61eedf91/uploads/origins/d049d781-4451-49e7-8e07-d00ea6de75ac?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=513d0a7636b3cf1e7753131f71c4ea07", "srcset": "https://si.imgix.net/61eedf91/uploads/origins/d049d781-4451-49e7-8e07-d00ea6de75ac?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=513d0a7636b3cf1e7753131f71c4ea07, https://si.imgix.net/61eedf91/uploads/origins/d049d781-4451-49e7-8e07-d00ea6de75ac?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=d9917cb97fe45aa149259e6d3e0bd24b 2x, https://si.imgix.net/61eedf91/uploads/origins/d049d781-4451-49e7-8e07-d00ea6de75ac?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d7c0b5be7972b8e2696399b9a7d8a9cb 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/61eedf91/uploads/origins/d049d781-4451-49e7-8e07-d00ea6de75ac?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3895fd7fed307fb4394c286696eb5b86", "srcset": "https://si.imgix.net/61eedf91/uploads/origins/d049d781-4451-49e7-8e07-d00ea6de75ac?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3