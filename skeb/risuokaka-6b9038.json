ません。\n・レンズ色が灰色っぽくなっていますが、これは3Dモデルの描写によるものですので、\n　こちらは通常の透明レンズとしてお取り扱い下さい。\n\n【構図】\n特に指定はありません。\n\n【使用用途】\n個人鑑賞・SNS等での共有(アイコン使用含む)・配信の待機画面\n\n【ファイル形式】\n・解像度や比率等々の細かい条件はございません。\n・可能であれば高画質なまま保管したいので、\n　各種一般的な画像ファイル形式に変換する前のファイル(PSDやそれに準ずる物)も\n　納品頂けると嬉しいです。\n\n以上、ご検討の程よろしくお願い致します。", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@risuokaka/works/8", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2563503, "client_id": 585714, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/4703d523/uploads/origins/3f14ecbb-16c3-49b8-9af6-907a6c99f40c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4fc4d18da885910ec3a2abab93a61bd7", "srcset": "https://si.imgix.net/4703d523/uploads/origins/3f14ecbb-16c3-49b8-9af6-907a6c99f40c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4fc4d18da885910ec3a2abab93a61bd7, https://si.imgix.net/4703d523/uploads/origins/3f14ecbb-16c3-49b8-9af6-907a6c99f40c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ddcd947095dbd7e93e98117dd3675eab 2x, https://si.imgix.net/4703d523/uploads/origins/3f14ecbb-16c3-49b8-9af6-907a6c99f40c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=4e6d2c90671f66b2b42cce5e746cf252 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/4703d523/uploads/origins/3f14ecbb-16c3-49b8-9af6-907a6c99f40c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=616b054e06bf309c256ec33affe5dc8a", "srcset": "https://si.imgix.net/4703d523/uploads/origins/3f14ecbb-16c3-49b8-9af6-907a6c99f40c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=616b054e06bf309c256ec33affe5dc8a, https://si.imgix.net/4703d523/uploads/origins/3f14ecbb-16c3-49b8-9af6-907a6c99f40c?bg=%23fff&auto=format%2Ccompress&fm