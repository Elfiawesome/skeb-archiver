いるが、垂れ耳の兎にも見えないこともない。\n名前の由来は「待て」が覚えられないことから。\nマダマテは周囲の生命体を素材にして事故死した皇すららのクローンを作り続けている。オリジナルが仲良くしていた者にだけ懐き、その者だけはクローンの素材（アメーバ体）にされない。\n███\n宛名・背景はpsdでon/offできると幸いです。\n使用用途は個人活動全般（動画配信の待機画面等、個人サイトやSNSでの小説の挿絵、キャラ紹介、個人活動の告知、トリミング加工を伴うアイコン・ヘッダー・バナーとしての使用等、コミッションサイトでのイラスト等依頼時に参考資料等）を考えています。\nもしご都合が合えばよろしくお願いします。\n\nhttps://drive.google.com/drive/folders/1-DC54qVFtGUFP-9T0gu-zLkbOKQFZ6TK", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@newTakarai_h/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3061254, "client_id": 806358, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/0728ede5/uploads/origins/d3ae010e-de51-492f-a125-8a95bce3abac?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=499b9171666db7f7d87780ee3f1cce54", "srcset": "https://si.imgix.net/0728ede5/uploads/origins/d3ae010e-de51-492f-a125-8a95bce3abac?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=499b9171666db7f7d87780ee3f1cce54, https://si.imgix.net/0728ede5/uploads/origins/d3ae010e-de51-492f-a125-8a95bce3abac?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=4aab01ee671f542a308780abcd7966a7 2x, https://si.imgix.net/0728ede5/uploads/origins/d3ae010e-de51-492f-a125-8a95bce3abac?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=bbb6a7db119052f4821b9f1d1a8212a1 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/0728ede5/uploads/origins/d3ae010e-de51-492f-a125-8a95bce3abac?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=56d97f5a6f7fbc17585cd66bd8f10f52", "srcset": "https://si.imgix.net/0728ede5/uploads/origins/d3ae010e-de51-492f-a125-8a95bce3abac?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=56d97f5a6f7fbc17585cd66bd8f10f52, https:/