igins/54269076-eb19-42f7-9cd8-82ee58a3036f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fba55dde82b9d33e40a2b1389ca7eb2e", "srcset": "https://si.imgix.net/abccc4bd/uploads/origins/54269076-eb19-42f7-9cd8-82ee58a3036f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fba55dde82b9d33e40a2b1389ca7eb2e, https://si.imgix.net/abccc4bd/uploads/origins/54269076-eb19-42f7-9cd8-82ee58a3036f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ceb24ea1d4be01516bace868f49deddd 2x, https://si.imgix.net/abccc4bd/uploads/origins/54269076-eb19-42f7-9cd8-82ee58a3036f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=3bad12deb21969e8f34fe5dfdd9aacec 3x"}, "duration": null, "nsfw": true, "hardcore": true, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/abccc4bd/uploads/origins/54269076-eb19-42f7-9cd8-82ee58a3036f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=38c93538bfc590799e47064789781e7d", "srcset": "https://si.imgix.net/abccc4bd/uploads/origins/54269076-eb19-42f7-9cd8-82ee58a3036f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=38c93538bfc590799e47064789781e7d, https://si.imgix.net/abccc4bd/uploads/origins/54269076-eb19-42f7-9cd8-82ee58a3036f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=a433f6c03c121da6e1ef789cd9be75aa 2x, https://si.imgix.net/abccc4bd/uploads/origins/54269076-eb19-42f7-9cd8-82ee58a3036f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=e28859297f33d65c536a305986d8e5ea 3x"}, "body": "はじめまして。首チンコのイラストを見たので、今回依頼しようと思いました。首のすげ替えというTSジャンルでお願いしたいです。\n首のすげ替えとは首から下を他人の身体に入れ替わるTSジャンルです。\n内容はリトルウィッチノベタのノベタが首から下を中年男ボディ（前回のナビータ挿げ替えの時のボディみたくデブで巨根）に挿げ替え、首なしのノベタの身体（ノベタボディ）に種付けしたり、ノベタボディが動いて騎乗位セックスするといった内容です。\nノベタボディは分離してもデュラハンみたく自力で動けます。（首とボディの意識は別々）また、魔力で欲情状態になっています。\n今回は1シーンを1枚絵で描いて欲しいです。\n①ノベタが魔法で首を外して男ボディの身体に挿げ替えるシーン。男ボディは勃起しており、挿げ替えた瞬間にムラムラする感じで。\n②ノベタボディが四つん這いになり、おまんこを見せつけそのままノベタが挿れてセックスします。ノベタは激しく腰を打ちつけてる感じで。膣断面をつけてください。中だし前と後（精液が溢れ、ボテ腹になる）の差分も出来ればお願いします。\n③騎乗位の体勢でノベタボディが自分で腰を動かしセックスします。こちらも中だし前と後の差分をお願いします。\nセックスシーンはノベタの表情とノベタボディが動くのが分かるような視点でお願いします。\n修正は黒海苔でお願いします。", "nc": 58, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@4514_salmon/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "comic", "tipped": false, "creator_id": 3506461, "client_id": 82839, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/da977cbd/uploads/origins/dc7fa01e-0e20-4f37-8722-cd60629db932?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e67bced60a85e6fd314dfb6f0f5b22e0", "srcset": "https://si.imgix.net/da977cbd/uploads/origins/dc7fa01e-0e20-4f37-8722-cd60629db932?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e67bced60a85e6fd314dfb6f0f5b22e0, https://si.imgix.net/da977cbd/uploads/origins/dc7fa01e-0e20-4f37-8722-cd60629db932?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e6eaa84f249d7cc55ef49848a4316ada 2x, https://si.imgix.net/da977cbd/uploads/origins/dc7fa01e-0e20-4f37-8722-cd60629db932?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ff219b53af038773d12c8cb7cfc88a20 3x"}, "duration": null, "nsfw": true, "hardcore": true, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/da977cbd/uploads/origins/dc7fa01e-0e20-4f37-8722-cd60629db932?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=74308a8f6512bfb3fd0e297ab689759b", "srcset": "https://si.imgix.net/da977cbd/uploads/origins/dc7fa01e-0e20-4f37-8722-cd60629db932?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=74308a8f6512bfb3fd0e297ab689759b, https://si.imgix.net/da977cbd/uploads/origins/dc7fa01e-0e20-4f37-8722-cd60629db932?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=73e054b141ab8aa0f48ea68b028534f3 2x, https://si.imgix.net/da977cbd/uploads/origins/dc7fa01e-0e20-4f37-8722-cd60629db932?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=99bfecebea7bd61d155af8c56fb3a3b3 3x"}, "body": "はじめまして、Xに投稿されている美甘ネルのイラストを拝見し、この度リクエストさせていただきました。\n以下リクエスト内容です。\n\nキャラクター：美甘ネル(ブルーアーカイブ)\n\n\nコスチューム：\n・下記参考のようなピッチリ艶テカ質のエロナースコスチューム\n(参考： https://skeb.jp/@nikomiudon_06/works/108 )\n乳首、クリトリスにはリングピアス装着\n靴のヒールはかなり高めのピンヒールスタイル\n他指定のないデザイン、カラーなどの変更はお任せします。\n\n\nシチュエーション：\n美甘ネルが先生に言いくるめられ、ピチテカエロナースコスチューム姿と様々な小道具を自ら挿入させられ、誰か来るかもしれない中シャーレ内で色々させられてしまうシチュエーション\n以下大まかな流れです。\n\n①最初は仁王立ち気味な立ち姿\n・片手には尿パックを持った状態(しっかり見えるように顔の高さあたりまで持ち上げ、コスチュームや身体となるべく被らない位置)\n・複数の大容量浣腸袋を輸液スタンドにぶら下げた状態\n\n・尿パックに繋がったカテーテルを尿道に挿入された状態\n(参考：https://item.rakuten.co.jp/koichi/p001-yuricare/ )\n\n・浣腸袋に繋がったチューブはポンプ機能付き極太ディルド(エンジニア部謹製)に繋がれ、アナルに挿入された状態\n(参考：https://www.amazon.co.jp/SHUUL-コロンクレンジングバッグ、2L-シリコンエネマバッグキット-コロンクレンズ浣腸袋-腸内洗浄ヘルスケア用/dp/B0CMQGY2RP )\n\n②ベッド(またはソファ)の上でまんぐり返し姿勢\n・尿パックが排尿により満たされていく状態\n・アナルに浣腸液を注ぎ込まれ徐々に空になる浣腸袋と、反対に腹は徐々にボテ腹へ\n・さらに浣腸されながら先生に前穴をハメられ腹を掻き回される様子\n\n③フルネルソン・ホールドで先生に後ろから持ち上げられた状態\n・大量浣腸に耐えきれずディルドごと浣腸液を逆流噴出させてしまう様子\n・ポッカリ空いたアナルを盛大にファック+中出し\n\n指定のない事項はおまかせします。\n以上、何卒よろしくお願いします。", "nc": 186, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@4514_salmon/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3506461, "client_id": 1047, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/beff96af/uploads/origins/1afca73b-bc97-4df3-9f8d-6fa8989ca04c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6578219338b71b788d4bfdbc794f2f32", "srcset": "https://si.imgix.net/beff96af/uploads/origins/1afca73b-bc97-4df3-9f8d-6fa8989ca04c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6578219338b71b788d4bfdbc794f2f32, https://si.imgix.net/beff96af/uploads/origins/1afca73b-bc97-4df3-9f8d-6fa8989ca04c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=768528553d1a2d2e52aeec3e3a3179aa 2x, https://si.imgix.net/beff96af/uploads/origins/1afca73b-bc97-4df3-9f8d-6fa8989ca04c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=15d787aa826d1dc3e03c79722e3075c9 3x"}, "duration": null, "nsfw": true, "hardcore": true, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/beff96af/uploads/origins/1afca73b-bc97-4df3-9f8d-6fa8989ca04c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6a9755122dc2262fd2840c4a88aafbca", "srcset": "https://si.imgix.net/beff96af/uploads/origins/1afca73b-bc97-4df3-9f8d-6fa8989ca04c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6a9755122dc2262fd2840c4a88aafbca, https://si.imgix.net/beff96af/uploads/origins/1afca73b-bc97-4df3-9f8d-6fa8989ca04c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=aa5425674a30c0fd38f6ba7df4826bfb 2x, https://si.imgix.net/beff96af/uploads/origins/1afca73b-bc97-4df3-9f8d-6fa8989ca04c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=82cc354f4770acdcb4d597fd4f8b9dee 3x"}, "body": "はじめまして。どんな性癖もOKと聞きまして、デュラハンみたいに首が取れて断面に性器ができる、首チンコというネタでひとつ、ブルアカのネルを描いていただきたいです。\nhttps://www.pixiv.net/artworks/96530322\nhttps://www.pixiv.net/artworks/109065508\nhttps://www.pixiv.net/artworks/92454997\nhttps://www.pixiv.net/artworks/107057697\nネルの頭(首チンコ)は1つで、胴体3つがそれをアナルや襟元のマンコに挿入しようと奪い合いしているイラストをお願いします。\n\nネルの頭は「ちょっ…止めろ！止めろつってんだろ！！」と怒っているけど、胴体の制御が効かず文字通り手も足も出ない状態で。\n胴体のほうは、メイド・制服・バニーの衣装違いとか、\n服描くの面倒でしたらネル+セイア+リオ、またはC&Cやゲーム部の子たち、(本編でカラミないですが)コノカやヒヨリなど、違う身体だとわかれば、描きやすいものでかまいません。\n\n女性器が好きなので、襟元の女性器をなるべく描いていただきたいのですが、修正で隠れてしまうと思いますし(できたら海苔ですと嬉しいです)、あらまきさんはアナルに造詣が深いようですので、先日のヒヨリや下記のこみトレ脱稿ツイのように、まんぐり返しやバックで両穴くぱぁなど、股間まわりもぜひじっくり見たいです。\nhttps://x.com/4514_salmon/status/1830724896412106950?s=46\n\n(また、この金額の範囲内でもしお願いできればなのですが、胴体が半透明のオナホになって、中身の穴の通り道が透けて見えている差分もいただけないでしょうか\nhttps://x.com/sigrenir/status/1882787412092596459?s=46\nhttps://www.pixiv.net/artworks/97386949\n難しければ無視していただいて全く問題ありません)\n\nありえん場所に女性器が複数ついていること、それで胴体全体が性行為のためにあるとわかるのに興奮する性癖なので、参考になれば幸いです。\n\n以上、長々と恐縮ですが、ご検討のほど、よろしくお願いします。", "nc": 58, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 9454, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "おりぷ", "screen_name": "door_error", "avatar_url": "https://pbs.twimg.com/profile_images/1925201792247443456/JeJBaCBF.jpg", "header_url": null, "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "art"}, {"genre": "correction"}], "banned": false, "nc": 48}, {"id": 15338, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "ぐまから　こうもりさん組", "screen_name": "gumakara", "avatar_url": "https://proxy.misskeyusercontent.jp/avatar/media.misskeyusercontent.jp%2Fio%2Fe2674d04-8ff1-4749-b905-6134cbe869d3.gif%3Fsensitive%3Dtrue?avatar=1", "header_url": "https://media.misskeyusercontent.jp/io/38d09644-7031-4ef4-818a-bb408c409d6b.png?sensitive=true", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 5, "complete_expiration_days": 90, "skills": [{"genre": "art"}, {"genre": "comic"}], "banned": false, "nc": 177}, {"id": 251865, "creator": true, "nsfw_acceptable": true, "acceptable": false, "name": "ささのねこ🐾SLiAエスリオ", "screen_name": "_ssnv", "avatar_url": "https://pbs.twimg.com/profile_images/1959297605420355584/bjtXhxEt.jpg", "header_url": "https://pbs.twimg.com/profile_banners/134356019/1641392068/1500x500", "appeal_receivabl