lse, "total_appeals_count": 0, "received_works": [{"path": "/@Atsuku_KoHiru/works/10", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3423757, "client_id": 3126149, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/4f233a68/uploads/origins/8cb06532-b474-497a-b1c3-99ecf360f32d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a9b20db07df9fb5dd5ff4fe56bca4d8c", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/4f233a68/uploads/origins/8cb06532-b474-497a-b1c3-99ecf360f32d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=418dbcbdb7f79e4025173e86aab39cc7", "src_set": ""}, "body": "はじめまして。\n個人でVtuberとして活動している羅骨梛冴(らこつなぎさ)と申します。\n以前よりTwitterでイラストを拝見させていただいており、コピルアック様が拡張お顔とふにっとしたスタイルのイラストがとても素敵で癖に刺さったため、今回のリクエストを送らせていただきました。\n\n今回描いていただきたいのはVtuberの私自身です。私のデザインについては添付した資料の三面図等を参考にしていただけると幸いです。\n\nこれらは可能であればでいいのですが、イラストの内容について、衣装はチーパオ、ポーズはI字バランスをリクエストさせていただきたいです。\n\nイラストの使用用途としては、YouTubeサムネイルやTwitter等各種SNSでの利用を予定しています。そのため顔付近が見切れていない構図にしていただけると嬉しいです。\n\nまた、もし可能であれば、私自身に利益が発生しない形でのネットプリントに利用したいと思っています。\n\n長くなりましたがよろしくお願いします。\n\nhttps://drive.google.com/drive/folders/1jRYjNNKfuQl06F4o5wNU2YpPutje20Tg?usp=sharing", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Atsuku_KoHiru/works/9", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/73d124bc/uploads/origins/46cd6d21-a798-4b9e-8d7f-6868c56847e2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=2654e5babde801bd9bfd0fbb570a027c", "src_set": ""}, "private": true, "genre": "art", "tipped": false, "creator_id": 3423757, "client_id": 1691946, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consor