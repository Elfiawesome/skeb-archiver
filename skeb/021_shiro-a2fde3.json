私のキャラクターの名前はハコで、彼はミミックモンスターが人間になったものです。私の友人のキャラクターはイフェラという名前で、キノコが人間になったものです。巨大なミミックモンスターの宝箱をソファ代わりにして、コントローラーを持ちながらゲームをしている姿を描いていただけないでしょうか。ミミック宝箱の上にどのように配置するかはあなた次第です。\n\nキャラクターと、そのキャラクターが座っている、または入っているミミックモンスターの参考資料を添付します。\n\n女の子のモデルで、シャツのストライプがpngの左側の参考資料と同じかどうか確認してもらえますか？\n\n本当にありがとうございました！（笑ぜひ、楽しんでみてくださいね\n\nhttps://drive.google.com/drive/folders/1sdz9PmQnwh1bM1k2w02ogctD2MYhVa9k?usp=share_link", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@021_shiro/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 428187, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/81a8e76b/uploads/origins/9cbaa948-2a00-42b0-b1be-524b25dadc48?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7e76a0ac6ace3afbe9c207295502efbe", "srcset": "https://si.imgix.net/81a8e76b/uploads/origins/9cbaa948-2a00-42b0-b1be-524b25dadc48?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7e76a0ac6ace3afbe9c207295502efbe, https://si.imgix.net/81a8e76b/uploads/origins/9cbaa948-2a00-42b0-b1be-524b25dadc48?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=819dc9e171f9c9acc602f4c24263ca91 2x, https://si.imgix.net/81a8e76b/uploads/origins/9cbaa948-2a00-42b0-b1be-524b25dadc48?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=8cf00865538bdacb2e7705010c853a02 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/81a8e76b/uploads/origins/9cbaa948-2a00-42b0-b1be-524b25dadc48?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b280a58c5cceeae0453ff19bbca1930d", "srcset": "https://si.imgix.net/81a8e76b/uploads/origins/9cbaa948-2a00-42b0-b1be-524b25dadc48?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b280a58c5cceeae0453ff19bbca1930d, https://si.img