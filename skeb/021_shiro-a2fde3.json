rop&crop=top&w=200&h=200&s=2228194df99fa6243a810d4d2ab56779, https://si.imgix.net/bc2b4d6b/uploads/origins/e1738747-3f6d-42f0-b66a-09321dacdb0f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=1fa7943133517ef12556d71d9ab2cbdd 2x, https://si.imgix.net/bc2b4d6b/uploads/origins/e1738747-3f6d-42f0-b66a-09321dacdb0f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=276d8d803586188125b3a03b6f987133 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/bc2b4d6b/uploads/origins/e1738747-3f6d-42f0-b66a-09321dacdb0f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ca05f6513c4ae6c04226ef2280c82e5f", "srcset": "https://si.imgix.net/bc2b4d6b/uploads/origins/e1738747-3f6d-42f0-b66a-09321dacdb0f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ca05f6513c4ae6c04226ef2280c82e5f, https://si.imgix.net/bc2b4d6b/uploads/origins/e1738747-3f6d-42f0-b66a-09321dacdb0f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=8ab65be5bbd0583f8f01263c4d7dc0f4 2x, https://si.imgix.net/bc2b4d6b/uploads/origins/e1738747-3f6d-42f0-b66a-09321dacdb0f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=27aa8dbf1eeed90bdf176a8c3dfbf06f 3x"}, "body": "こんにちは！友人（ラルク）と私（アポロ）が、居心地の良い部屋で、テーブルの上にスナックや飲み物を置いてボードゲームやカードゲームをしているような作品が欲しいです。ラルクは、気難しく、怒りやすく、不機嫌で、友達のことを嫌いなふりをするフェイの泥棒です。積極的に遊んでいて、ちょっと怒っているような表情をしてほしいです！アポロは飄々としていて、おっちょこちょいで、間抜けで、社交的で、友達と遊ぶのが大好きな生意気なサンビートル。ラルクがゲームに怒っている間、彼は素晴らしい時間を過ごしているように見えるようにしたいです。ありがとうございました！実は彼は5月12日でvtuberを卒業するので、これをプレゼントにしたいと思っています！\n\nラルク 参考：https://drive.google.com/file/d/1rKeFxSNz1fOdKQkbtqMGbUNT9LhynEJ8/view?usp=share_link\n\nアポロリファレンス： https://drive.google.com/drive/folders/1fx8yyQ89WY_cOzYOKIYPJ5mlYagc8ODg?usp=share_link", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"