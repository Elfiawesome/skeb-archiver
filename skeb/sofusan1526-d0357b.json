ンドがレックスの顔を模したMiiの頭を持ってプンプン怒っている様子も描いてください。(遠くから怒っているので小さめに描いてください)\n\n以上です！ご検討よろしくお願いします！", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@sofusan1526/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2287265, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/053ebf2d/uploads/origins/622d387f-003a-4f32-98b7-5d5ab3babd53?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8238a39b8f62f0a5316c17843255910c", "srcset": "https://si.imgix.net/053ebf2d/uploads/origins/622d387f-003a-4f32-98b7-5d5ab3babd53?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8238a39b8f62f0a5316c17843255910c, https://si.imgix.net/053ebf2d/uploads/origins/622d387f-003a-4f32-98b7-5d5ab3babd53?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=afdb52083baaa331e48c7efba2a900bf 2x, https://si.imgix.net/053ebf2d/uploads/origins/622d387f-003a-4f32-98b7-5d5ab3babd53?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=80ada3eecd1036045d496e64435716a3 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/053ebf2d/uploads/origins/622d387f-003a-4f32-98b7-5d5ab3babd53?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3de29d0ef0ce7f01eacfd5124d1f1209", "srcset": "https://si.imgix.net/053ebf2d/uploads/origins/622d387f-003a-4f32-98b7-5d5ab3babd53?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3de29d0ef0ce7f01eacfd5124d1f1209, https://si.imgix.net/053ebf2d/uploads/origins/622d387f-003a-4f32-98b7-5d5ab3babd53?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=ba5663a6229ca4a1ea15b55793777804 2x, https://si.imgix.net/053ebf2d/uploads/origins/622d387f-003a-4f32-98b7-5d5ab3babd53?bg=%23fff&auto=format%2Ccompress&fm=