ストの有浦柑奈ちゃんのイラストをリクエストします。\nサルバトール・ムンディというレオナルド・ダ・ヴィンチはじめとした画家が描くイエス・キリストのモチーフがあります。\nWikipediaの該当ページを資料URLに添付しますのでそちらをご参照ください。\nこれと同じ構図で柑奈ちゃんを描いてもらいたいです！\n柑奈ちゃんが頭に巻いているいつもの紐とお花の髪飾りは必須でお願いします。\n右手にはギターピックなど持たせていただくとなお素敵です。\nサルバトール・ムンディとは「世界の救世主」という意味だそうですが\n水晶玉を世界に見立て、ラブアンドピースを願い佇む柑奈ちゃん…\nクラリスさんも思わず祈りを捧げ、パイプオルガンを音葉さんが奏で、聖ちゃんが聖歌を歌いだす。\nそんなイメージでお願いします！\n（他の3人はあくまでもイメージの話なのでキャラクターとして描いていただくのは柑奈ちゃん1人で大丈夫です！）\n\nhttps://ja.wikipedia.org/wiki/%E3%82%B5%E3%83%AB%E3%83%90%E3%83%88%E3%83%BC%E3%83%AB%E3%83%BB%E3%83%A0%E3%83%B3%E3%83%87%E3%82%A3", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@unyon/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1317446, "client_id": 100049, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/991aab53/uploads/origins/4a1ccf0f-6e4d-463b-9e79-85218b7ce171?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f1e208a9fef4862d8399511fc000179a", "srcset": "https://si.imgix.net/991aab53/uploads/origins/4a1ccf0f-6e4d-463b-9e79-85218b7ce171?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f1e208a9fef4862d8399511fc000179a, https://si.imgix.net/991aab53/uploads/origins/4a1ccf0f-6e4d-463b-9e79-85218b7ce171?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=bd1dcdda8ef1ff08494ac89079a423d3 2x, https://si.imgix.net/991aab53/uploads/origins/4a1ccf0f-6e4d-463b-9e79-85218b7ce171?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=206f54da9813048df9be956ae04aa70b 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/991aab53/uploads/origins/4a1ccf0f-6e4d-463b-9e79-85218b7ce171?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=690287a9267ad7fec25be15d0f1715c9", "srcset": "https://si.imgix.net/991aab53/uploads/origins/4a1ccf0f-6e4d-