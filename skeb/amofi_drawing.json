ダーヘアーが生えています。\n・胸は貧乳で太ももや尻尾は自由に盛っていただいて大丈夫です。背景や構図など細かい部分はお任せでお願いします。\n\n・金額の範囲内で構わないので差分でストッキング無しと黒パンツ（赤リボンにレース柄）の有無があると嬉しいです！\n\n【イラストの使用用途・その他】\n・羽奏こはくさん本人に限り使用許可（Twitterへの掲載・YouTubeサムネ利用等）を頂きたいです。\n・お手数ですが、人物 ・背景・宛名等がレイヤー分けされたPSDで頂けるとありがたいです。\n\n長文失礼致しました。\nご検討よろしくお願いします。\n\nhttps://kohaku-wakana.fanbox.cc/posts/5051503", "nc": 33, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@amofi_drawing/works/9", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2557274, "client_id": 1601526, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/c0495cb8/uploads/origins/3914834b-c05b-4b0c-b633-52a264eacdda?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=971a03b8cc613fa378d04f5a71e8c463", "srcset": "https://si.imgix.net/c0495cb8/uploads/origins/3914834b-c05b-4b0c-b633-52a264eacdda?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=971a03b8cc613fa378d04f5a71e8c463, https://si.imgix.net/c0495cb8/uploads/origins/3914834b-c05b-4b0c-b633-52a264eacdda?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=44497cfa459f09ed2bd93b548a187678 2x, https://si.imgix.net/c0495cb8/uploads/origins/3914834b-c05b-4b0c-b633-52a264eacdda?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a83bd20636a3271d2133359d5320248f 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/c0495cb8/uploads/origins/3914834b-c05b-4b0c-b633-52a264eacdda?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d5d21a14c5acc33b75af9b924a2c114d", "srcset": "https://si.imgix.net/c0495cb8/uploads/origins/3914834b-c05b-4b0c-b633-52a264eacdda?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d5d21a14c5acc33b75af9b924a2c114d, https://si.imgix.net/c0495cb8/uploads/origins/3914834b-c05b-4b0c-b