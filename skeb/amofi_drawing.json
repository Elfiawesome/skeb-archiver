uploads/origins/c7e49d5f-9f34-475b-97fe-c8c4f33a9814?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=36308dfb9b0f9757adc01d76424cbedd", "srcset": "https://si.imgix.net/a539e39d/uploads/origins/c7e49d5f-9f34-475b-97fe-c8c4f33a9814?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=36308dfb9b0f9757adc01d76424cbedd, https://si.imgix.net/a539e39d/uploads/origins/c7e49d5f-9f34-475b-97fe-c8c4f33a9814?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=cb4ba7826ae9df05e10b697a889a935d 2x, https://si.imgix.net/a539e39d/uploads/origins/c7e49d5f-9f34-475b-97fe-c8c4f33a9814?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=5ba1ea269a8899ed99ad5c2c70813639 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/a539e39d/uploads/origins/c7e49d5f-9f34-475b-97fe-c8c4f33a9814?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=150ae579f427d7dd50ad7344e868d4ce", "srcset": "https://si.imgix.net/a539e39d/uploads/origins/c7e49d5f-9f34-475b-97fe-c8c4f33a9814?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=150ae579f427d7dd50ad7344e868d4ce, https://si.imgix.net/a539e39d/uploads/origins/c7e49d5f-9f34-475b-97fe-c8c4f33a9814?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=cd30c7bc8fcfc5d5aa79b970cbc73ebc 2x, https://si.imgix.net/a539e39d/uploads/origins/c7e49d5f-9f34-475b-97fe-c8c4f33a9814?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=7144ffcceeaf7d7250bd63a363305a5b 3x"}, "body": "amofi様\n\nスーパーダンガンロンパ2より、罪木蜜柑のイラストをお願いします。※資料\n\n・衣装\nスクール水着の胸元に「罪木」とゼッケンが付いているもの。\n※水着は上下がつながっており、股の部分がレオタードのようになっているスタイル\n\n・シチュエーション\n高校生になった罪木が、体育の授業で水泳があるので、中学の頃に使用していたスク水をもって授業を受けようとしたところ、当時より発育が良くなっていたためピチピチで胸や尻がはみ出しまくっている。\n本人は「中学の時はピッタリだったのに」と自身の成長に気が付いてない様子でお願いします。\n\n・その他\nやりすぎなくらいムチムチにしていただけると嬉しいです。\n背景、塗り方や構図等はお任せします。\n\n\n以上、ご検討よろしくお願いします。\n\nhttps://drive.google.com/file/d/13MY2ff55WTCvajoEq_w6YsxX9rfCFIJo/view?usp=drivesdk", "nc": 49, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@amofi_drawing/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2557274, "client_id": 154813, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/5ef0c48e/uploads/origins/089ffd85-fb97-45f8-bccb-386e35ee5e89?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e371378906a3dd0cc8f17b7608b67a09", "srcset": "https://si.imgix.net/5ef0c48e/uploads/origins/089ffd85-fb97-45f8-bccb-386e35ee5e89?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e371378906a3dd0cc8f17b7608b67a09, https://si.imgix.net/5ef0c48e/uploads/origins/089ffd85-fb97-45f8-bccb-386e35ee5e89?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=5230921bfa8c983ddfb056cb4c3e64d7 2x, https://si.imgix.net/5ef0c48e/uploads/origins/089ffd85-fb97-45f8-bccb-386e35ee5e89?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=091624870c7bd5160421d7636bf9bbed 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/5ef0c48e/uploads/origins/089ffd85-fb97-45f8-bccb-386e35ee5e89?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9e9d70c394b62c9ce5a4562b93b8434d", "srcset": "https://si.imgix.net/5ef0c48e/uploads/origins/089ffd85-fb97-45f8-bccb-386e35ee5e89?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9e9d70c394b62c9ce5a4562b93b8434d, https://si.imgix.net/5ef0c48e/uploads/origins/089ffd85-fb97-45f8-bccb-386e35ee5e89?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=707a8053607ea73ea07176b9d0af0be3 2x, https://si.imgix.net/5ef0c48e/uploads/origins/089ffd85-fb97-45f8-bccb-386e35ee5e89?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=6b1e10f419438ab224fc0616e4b1e899 3x"}, "body": "お久しぶりです、前回のイラストがとても良かったので、再びリクエストさせて頂きます！\n\n今回描いて欲しいのはOCの百合（りり）という子です。\n基本的に無表情だけど、実は可愛いものが好きだったり、人のために頑張る優しい子です。\n16歳で身長は決まってませんが150以上160未満です。\n\n描いて欲しい服装とシチュエーションは、サンタ服で、プレゼントを渡してくる感じの姿がいいなって思っています。\n無表情だけど、ちょっと照れてるような、そんな表情ならなお嬉しいです。\n（難しいと思うので、全然出来る範囲で大丈夫です）\n\nぜひご縁がありましたら、よろしくお願いします。\n\nhttps://drive.google.com/drive/folders/19TGt_Dony0-Ab8yCv-bvp-lZB6aynxx8", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@amofi_drawing/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2557274, "client_id": 2223302, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/5747d1a0/uploads/origins/91e01609-8c1b-4aec-9b72-856f842d873b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ddf1c177482a8d32ba1dd803203bca45", "srcset": "https://si.imgix.net/5747d1a0/uploads/origins/91e01609-8c1b-4aec-9b72-856f842d873b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ddf1c177482a8d32ba1dd803203bca45, https://si.imgix.net/5747d1a0/uploads/origins/91e01609-8c1b-4aec-9b72-856f842d873b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=075c7063fddbfceb89a9fb500893736e 2x, https://si.imgix.net/5747d1a0/uploads/origins/91e01609-8c1b-4aec-9b72-856f842d873b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=1acc5bef63e026cb482085e9dd2b8eaa 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/5747d1a0/uploads/origins/91e01609-8c1b-4aec-9b72-856f842d873b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a8eac18c8ad846e3d9807d15fbf69783", "srcset": "https://si.imgix.net/5747d1a0/uploads/origins/91e01609-