raw!\n\nhttps://drive.google.com/drive/folders/1zW2iU3QlnKe7G68kozj3HriImz6xl3m2", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@oilgmto/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2969083, "client_id": 11553, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/39875e7f/uploads/origins/79627a28-39b2-4746-9b21-a6b86680e100?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ac5f6a10382e0cef950711af4ba521c3", "srcset": "https://si.imgix.net/39875e7f/uploads/origins/79627a28-39b2-4746-9b21-a6b86680e100?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ac5f6a10382e0cef950711af4ba521c3, https://si.imgix.net/39875e7f/uploads/origins/79627a28-39b2-4746-9b21-a6b86680e100?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=6fcea45a6c60069162970e0d4c966420 2x, https://si.imgix.net/39875e7f/uploads/origins/79627a28-39b2-4746-9b21-a6b86680e100?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=42e837943ebae8ef2015737a79349d3b 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/39875e7f/uploads/origins/79627a28-39b2-4746-9b21-a6b86680e100?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=8835102ead54d0858814b0d6b1d21903", "srcset": "https://si.imgix.net/39875e7f/uploads/origins/79627a28-39b2-4746-9b21-a6b86680e100?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=8835102ead54d0858814b0d6b1d21903, https://si.imgix.net/39875e7f/uploads/origins/79627a28-39b2-4746-9b21-a6b86680e100?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=103584dea53898a59d7f4fa5a73c50df 2x, https://si.imgix.net/39875e7f/uploads/origins/79627a28-39b2-4746-9b21-a6b86680e100?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=d8fda5e390f9d6a834ca084738bcd8bd 3x"}, "body": "Hello again!! I really loved the art you did of me before and would like to request another from you if that is okay! I was wondering if you could draw my vtuber with a big red ribbon on top of his head. I would like if the clothes could look something like the  boy on the right in this image: https://i.pinimg.com/736x/f4/23/2d/f4232d674a96df9aa9b5d0d77b1e6faf.jpg .  Feel free to be creative with the outfit I would just like it to be red and white. For expression could you draw him with a smirk? My character is male! I would like to use the image for Youtube video thumbnails, if you do not feel comfortable with that please send in another appeal and I will change my request.\n\nもし可能であればSNSや配信のサムネイルにも使用させて頂きたいのです。どうぞよろしくお願いいたします！\n\nhttps://drive.google.com/drive/folders/1zW2iU3QlnKe7G68kozj3HriImz6xl3m2?usp=drive_link", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@oilgmto/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2969083, "client_id": 2065416, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/e4093032/uploads/origins/b08d1e66-32e0-49ea-bda0-befe7e38bd4c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=63e23580b23323e150c515bb0748ca5c", "srcset": "https://si.imgix.net/e4093032/uploads/origins/b08d1e66-32e0-49ea-bda0-befe7e38bd4c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=63e23580b23323e150c515bb0748ca5c, https://si.imgix.net/e4093032/uploads/origins/b08d1e66-32e0-49ea-bda0-befe7e38bd4c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=6218448d641b29eb6589ee206a8122cc 2x, https://si.imgix.net/e4093032/uploads/origins/b08d1e66-32e0-49ea-bda0-befe7e38bd4c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=77b23