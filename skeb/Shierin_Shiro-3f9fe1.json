om/drive/folders/1iI5twAUNakVq05pI7gaA7pIFcn0YgFGy", "nc": 0, "word_count": 0, "transcoder": "video", "creator_acceptable_same_genre": true}, {"path": "/@vitamin_xx_2525/works/46", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 92949, "client_id": 661619, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/33f14606/uploads/origins/8027ac79-d473-4551-a54e-33729798025f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0a2b53d5d31cc58de45ae67896ac6098", "srcset": "https://si.imgix.net/33f14606/uploads/origins/8027ac79-d473-4551-a54e-33729798025f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0a2b53d5d31cc58de45ae67896ac6098, https://si.imgix.net/33f14606/uploads/origins/8027ac79-d473-4551-a54e-33729798025f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=88a94cff7e3c40f66f69ee8d95b7554f 2x, https://si.imgix.net/33f14606/uploads/origins/8027ac79-d473-4551-a54e-33729798025f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=7af46288b57c90987c41928185ba6193 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/33f14606/uploads/origins/8027ac79-d473-4551-a54e-33729798025f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f81f28f6a93a89c12db5faf9b7336353", "srcset": "https://si.imgix.net/33f14606/uploads/origins/8027ac79-d473-4551-a54e-33729798025f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f81f28f6a93a89c12db5faf9b7336353, https://si.imgix.net/33f14606/uploads/origins/8027ac79-d473-4551-a54e-33729798025f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=d63d73bcf7573e61d8f922f5aa4810f2 2x, https://si.imgix.net/33f14606/uploads/origins/8027ac79-d473-4551-a54e-33729798025f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=dccaa41dac5dd7ee0f40064c6786d867 3x"}, "body": "はじめまして、紫江凜と申します。\n辰馬様の描かれる軍服が好きでリクエストいたします！VTuber紫江凜の男体化Verである、ダンテという男性の軍服姿の絵を描いていただきたいです。\n\n軍服の色やデザイン、服に合わせたアクセサリー類は完全にお任せします！\n\n▼用途\n・SNS（アイコンやヘッダー）\n・YouTubeのチャンネルアート、動画のサムネイル\n・私の個人使用のためのグッズ（A4フリアファイル、スマホケースなど）印刷したりする可能性有り。\n・3DVTuberであるため、辰馬様のデザインを元に3D衣装製作の許可。\n・セミオーダー形式として3D衣装製作の依頼を想定しています。3D制作者がBOOTH等で軍服衣装（色違い等を含む）を販売することの許可をいただきたいです。もちろんデザイン原案として、辰馬様のお名前など公開いたします！\n\n上記内容が難しければ、蹴っていただいて構いません！\n\n▼キャラクターについて\n・ダンテ（紫江凜男Ver）\n髪色：金髪\n髪型：マッシュウルフカット\n瞳の色：紺～マゼンタ系のグラデ色\n\n紫江凜は仙女であるため、仙術を使用して色んな姿に変えられるという設定です。「ダンテ（紫江凜男Ver）」は仙術で男の姿になった状態です。\n\n▼ポーズや背景\nポーズ、背景共にお任せいたします。背景は無し（透明）でも構いません。キャラクターと背景をレイヤーの非表示表示ができる状態だと助かります。\n\n▼サイズ\n個人で印刷する可能性があるため、解像度350ぐらい。YouTubeのチャンネルアートサイズが2560px×1440pxなため、横は最低でも2560px以上あると助かります。\nPhotoshop持っておりますため、psd形式でお願いいたします。\n\n▼その他\n・辰馬大助様のサインいただきたいので、別レイヤーでサインをお願いしたいです。\n・可能でしたら簡易でいいので、衣装詳細が分かる三面図をいただきたいです\n・私個人的に色塗りの練習をしたいので、線画のみレイヤーいただけると助かります……！\n\nhttps://drive.google.com/drive/folders/1jzsXYFfG9qtjvbgPBKrfsMDYtN8u73lV?usp=sharing", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@minamonday_v/works/11", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 84826, "client_id": 661619, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/fbbf9741/uploads/origins/4c743842-4982-4a55-8a81-4abe674da465?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=43cad8c690c17b742fdd31ef323b1266", "srcset": "https://si.imgix.net/fbbf9741/uploads/origins/4c743842-4982-4a55-8a81-4abe674da465?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=43cad8c690c17b742fdd31ef323b1266, https://si.imgix.net/fbbf9741/uploads/origins/4c743842-4982-4a55-8a81-4abe674da465?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=8ded6d0e2fd59f9a293b73e9748d63db 2x, https://si.imgix.net/fbbf9741/uploads/or