の蔦、紫のベルフラワー、ルーン文字が刻まれている。刃は深い青氷色で半透明。- 霜の魔法を使用。発動時は星のように輝く。- 技術・文明・人間に対してかなり純真。しかし信頼する周囲の人々には非常に優しく母性的な面を見せる。\n\n表情・背景・ポーズについては、可能な限りクールに仕上げるようご判断ください。参考画像を添付しました。よろしくお願いします！https://drive.google.com/drive/u/2/folders/1mi3ML9TrrWU9bCXv6MTkJQ_LHfW0JqQS", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Shinarika396/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3798056, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/57d1a2e3/uploads/origins/72644c44-5890-49aa-9f0d-7b1c0ab7de66?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=71bc5e1a5049b7433e93aee90e793b33", "srcset": "https://si.imgix.net/57d1a2e3/uploads/origins/72644c44-5890-49aa-9f0d-7b1c0ab7de66?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=71bc5e1a5049b7433e93aee90e793b33, https://si.imgix.net/57d1a2e3/uploads/origins/72644c44-5890-49aa-9f0d-7b1c0ab7de66?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=cf55dcda95f92b27d1e62be4e7ffc22d 2x, https://si.imgix.net/57d1a2e3/uploads/origins/72644c44-5890-49aa-9f0d-7b1c0ab7de66?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=9516fd7b361256381d6c0ef38990869a 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/57d1a2e3/uploads/origins/72644c44-5890-49aa-9f0d-7b1c0ab7de66?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=bb4aa3589bc690d3af858a1a7f7602cb", "srcset": "https://si.imgix.net/57d1a2e3/uploads/origins/72644c44-5890-49aa-9f0d-7b1c0ab7de66?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=bb4aa3589bc690d3af858a1a7f7602cb, https://si.imgix.net/57d1a2e3/uploads/origins/72644c44-5890-49aa-9f0d-7b1c0ab7de66?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blu