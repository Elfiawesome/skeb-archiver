e-a406-411c-94a8-b12b1403d2a0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=de1d9017d094902457331a4c590a545d", "srcset": "https://si.imgix.net/fbb79b9a/uploads/origins/8fc8b01e-a406-411c-94a8-b12b1403d2a0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=de1d9017d094902457331a4c590a545d, https://si.imgix.net/fbb79b9a/uploads/origins/8fc8b01e-a406-411c-94a8-b12b1403d2a0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=90fedca480efd961186ca5f47b11f34c 2x, https://si.imgix.net/fbb79b9a/uploads/origins/8fc8b01e-a406-411c-94a8-b12b1403d2a0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=4d4fb174493eb62148dc734e770e05b4 3x"}, "body": "はじめまして。ずっと昔から貴方を知っていて、初めてスケブをやっていると知りました。貴方の巨大生物の絵に何度感動したか分かりません。こういったリクエストは不慣れですが、どうかお願い致します。\n\nリクエスト内容は、公開するか未定の、オリジナル作品のクリーチャー、穢蟲（せんちゅう）をイラストにしてもらいたいです。\n小型種（自動車並）中型種（家屋並）大型種（ビル相当）蝕淀種（人型）、が存在し、共通する特徴として\n・ドス黒い外骨格　・赤い複眼　それ以外のデザインはおまかせしたいです。作中人類の天敵として描写しているので、凶悪なイメージでお願い致します。\n\n可能であれば、各種複数体お願いしたいと思います。金額が満たされて居ない場合、再送可能なようですので、お手数ですがそうして頂けたら有り難く思います。\n\n御一考頂けたら、とても嬉しいです。", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@GR_River/works/15", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 13427, "client_id": 2057960, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/4f499470/uploads/origins/3c34f524-ccb7-4fa5-a19f-264e56f5c21d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e04b30458a32457b59659443305e7e0e", "srcset": "https://si.imgix.net/4f499470/uploads/origins/3c34f524-ccb7-4fa5-a19f-264e56f5c21d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e04b30458a32457b59659443305e7e0e, https://si.imgix.net/4f499470/uploads/origins/3c34f524-ccb7-4fa5-a19f-264e56f5c21d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&cr