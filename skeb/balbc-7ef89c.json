9-b2c7-21e2caabcfee?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=cafa36d4aff56500fb3dcaedf3b26aa8 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/306a8b0d/uploads/origins/c52d3e32-1582-4269-b2c7-21e2caabcfee?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=866356b540fa14e1f2d8363cb03b540d", "srcset": "https://si.imgix.net/306a8b0d/uploads/origins/c52d3e32-1582-4269-b2c7-21e2caabcfee?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=866356b540fa14e1f2d8363cb03b540d, https://si.imgix.net/306a8b0d/uploads/origins/c52d3e32-1582-4269-b2c7-21e2caabcfee?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=6fbb636cf4e873193d4c06b9f73b414c 2x, https://si.imgix.net/306a8b0d/uploads/origins/c52d3e32-1582-4269-b2c7-21e2caabcfee?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=70d65a931d0c49868556118c2163b867 3x"}, "body": "ばるぶＣさん、こんにちは！\n\nいつもノート読んで下さってありがとうございます！\n\n今回、うちの子であるところのブルーベルちゃんとばるぶCちゃんが邂逅しているところを描いていただきたく、リクエストを送らせていただきます。\nhttps://misskey.io/notes/a0hxrmd4396z06zt\n\nシチュエーションや構図等はお任せします。デフォルメも可ですが、身長差は維持して欲しいです。\n(ブルーベルちゃんの身長は大体140cm前後です。)\n\n書いて欲しいセリフとして、フキダシ等の無い書き文字で\nminimini...\nと入れて欲しいです。\n\nキャラクター自体は別のクリエイターさんに作成頂いたものですが、著作者様から二次創作やSkebでの許可を頂いています。\n詳しくは添付URLをご参照下さい。\n\nhttps://misskey.io/notes/a0hy2ozjchln07z8\n\n10：04　秋葉原発\nつくばるぶCエクスプレス", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@balbc/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3184622, "client_id": 3355990, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/9423257d/uploads/origins/c5c824cd-4341-4d3e-9372-c13919d48b28?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1743ef31cae8ad11112495fb4ed3c