a14-87b0-f107d89fef7e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2fd0807507ee624a4a354927df2d0097", "srcset": "https://si.imgix.net/764ab8a1/uploads/origins/4936dfcd-27f6-4a14-87b0-f107d89fef7e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2fd0807507ee624a4a354927df2d0097, https://si.imgix.net/764ab8a1/uploads/origins/4936dfcd-27f6-4a14-87b0-f107d89fef7e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=da60fe902a0e01fc4362d17f6b492522 2x, https://si.imgix.net/764ab8a1/uploads/origins/4936dfcd-27f6-4a14-87b0-f107d89fef7e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=aa4933542d3fa4a7610017b8c9762739 3x"}, "body": "こんにちは。\nSpice/メガ様のイラストの絵柄がとても好きです。\n特に、明るい陽の光に照らされた瑞々しい女の子と美しい背景の描写が好きなので、今回もそのようなイメージでお願いしたいと思います。\nSpice/メガ様にせっかくお願いできるチャンスですので、うちの子の特別なワンシーンを描いていただきたく。\n以下、少し長くなり恐縮ですが、描いて頂きたい状況や設定について記載しましたのでご一読いただけますと幸いです。\nよろしくお願いいたします。\n\n◆使用用途\ntwitter等SNSでの画像使用\n\n◆オリジナルキャラ参考資料\nこちら参考資料です。\nhttps://twitter.com/silas_012/status/1624678045637550083?s=20\n補足情報として、うちの子の胸の大きさはCカップで、大きすぎず小さすぎず程よいサイズ感です。\n胸の直接的な露出はありませんが、胸元のふくらみを表現いただく際のご参考として。\n\n◆テーマ・シチュエーション\nタイトルは「ティータイム」です。\n親戚の結婚式でハワイを訪れた際の、カフェでのワンシーンを描いて頂きたいです。\nビーチリゾートの爽やかな陽光の下で、上機嫌なうちの子を描いていただけると嬉しいです。\nうちの子は、基本的にはクールであまり表情を変えない女の子ですが、海や魚、植物が好きな子なので、それらに囲まれたリゾートの環境でとても嬉しそうに過ごしています。\n\n◆ロケーション\nイメージは「ビーチハウス・アット・ザ・モアナ」です。\nhttps://www.lealeaweb.com/shopinfo/3760\n\n明るい陽光が降り注ぐホテル併設のカフェでお茶をするシーンを描いて頂きたいです。\n中庭を囲むようにカフェスペースが設けられており、庭の大木に降り注ぐ陽光が木漏れ日となってカフェ席に差している状況です。\nhttps://www.instagram.com/p/BDuTLUEx__9/\n\n◆構図\n中庭と海を背に、カフェのテーブルに座ってお茶をする状況ですが、うちの子を単体でなるべく画面に大きく描いていただきたいです。\nテーブルから上が画面に収まる構図で、うちの子の上半身が画面に入ります。\nロケーションのイメージが伝わるように、背景には中庭（テラス）と海が入ると良い感じだと思います。\nSpice/メガ様の光輝く瑞々しい描写が好きなので、キラキラした感じで描いて頂けると嬉しいです。\n\n◆服装\n①水着（イメージ）\nhttps://www.pixiv.net/artworks/98536654\n②ドレス（イメージ）\nhttps://www.pinterest.jp/pin/810999845417536426/\n③髪飾り（イメージ）\nhttps://twitter.com/spice_mega/status/1543022111857356801?s=20\n\n上記①の女の子が着用しているような可愛らしい水着の上に、②のような海辺に似合う清楚なドレスを着用しています。\n海で泳いだ後、という設定なので水着の上にそのままドレスを着ている状況です。\nポイントとしては、下に水着を着用していることが分かるように、水着の紐を首のところで結んでいる部分が見えるように描いてもらえると嬉しいです。\n髪には③の女の子のような花をあしらった髪飾りを。\nリゾート感を満喫し、いつもより少しお洒落をしている印象で。\n\n◆女の子の表情\nたっぷり海で泳いで心地よい疲れを感じつつ、気持ちの良い場所でお茶をしている状況ですので、かなり上機嫌なうちの子を描いて頂きたいです。\nただ、あまり大げさな表情というよりは、自然な微笑みのような表情が希望です。\n記念撮影的なイラストではなく、自然な表情をさりげなく切り取ったような印象で描いてもらえると。\n目線はこちらを見ていてほしいです。\nまた、女の子はカップを手に取っている感じでも良いですし、別の仕草をしていても良いです。\n\n◆モチーフアイテム\nテーブルの上には茶器が並んだ感じです。\nそれと、できればこちらの本をテーブルの上に置いた状態で描いてほしいです（本は文庫本サイズです）。\nhttps://econews.jp/column/ecobooks/2990/\nいつでも本を持ち歩いている子で、この場所でこの本を読みたいと思っていた本なので。\nカバーデザインは適宜アレンジいただいて構いませんが、タイトルが判別できると嬉しいです（特にタイトルの「海」と大きく書かれた部分など）。\n\n◆納品形式\nPSDとPNG希望です。\n\n以上、\nすべて私の個人的な希望ですので、適宜アレンジいただくなど、基本的にSpice/メガ様の着想で自由に描いてもらえると嬉しいです。\nうちの子を可愛らしい瑞々しい印象で描いてもらえると嬉しいです。\nどうぞよろしくお願いいたします。\n\nhttps://twitter.com/silas_012/status/1624678045637550083?s=20", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@spice_mega/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2086914, "client_id": 1177133, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/87fdc190/uploads/origins/c6ff0675-13fc-4793-8fc5-c3fb3c98ed6e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=99d65c95ccd71d0199b56e366a4b6cfa", "srcset": "https://si.imgix.net/87fdc190/uploads/origins/c6ff0675-13fc-4793-8fc5-c3fb3c98ed6e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=99d65c95ccd71d0199b56e366a4b6cfa, https://si.imgix.net/87fdc190/uploads/origins/c6ff0675-13fc-4793-8fc5-c3fb3c98ed6e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=7d4e730f6e8ec37f6be54ce8a930338f 2x, https://si.imgix.net/87fdc190/uploads/origins/c6ff0675-13fc-4793-8fc5-c3fb3c98ed6e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=20