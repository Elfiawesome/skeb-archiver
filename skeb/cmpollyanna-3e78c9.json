ン。\n\nありがとうございました。\n\n(参考文献はこちらです！前回リンクが悪くて大変失礼しましたOTL)\n\nhttps://drive.google.com/drive/folders/1HojoKd2_HarWN8KW4yft5GPEi5q_vlus?usp=sharing", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@cmpollyanna/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1172556, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/3fc55c53/uploads/origins/49b8d04b-7e4c-4c83-a904-3123a3aac6fb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a701ae1e23f22c31bc6acb59d4ff2cb9", "srcset": "https://si.imgix.net/3fc55c53/uploads/origins/49b8d04b-7e4c-4c83-a904-3123a3aac6fb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a701ae1e23f22c31bc6acb59d4ff2cb9, https://si.imgix.net/3fc55c53/uploads/origins/49b8d04b-7e4c-4c83-a904-3123a3aac6fb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=02aec43b7bf566af71f7d054cb0576c8 2x, https://si.imgix.net/3fc55c53/uploads/origins/49b8d04b-7e4c-4c83-a904-3123a3aac6fb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=eb9c4ccb3bce1d59e9babba905c0ec5a 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/3fc55c53/uploads/origins/49b8d04b-7e4c-4c83-a904-3123a3aac6fb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=fa9c28aa4cb4417ea39955f12d1c97a5", "srcset": "https://si.imgix.net/3fc55c53/uploads/origins/49b8d04b-7e4c-4c83-a904-3123a3aac6fb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=fa9c28aa4cb4417ea39955f12d1c97a5, https://si.imgix.net/3fc55c53/uploads/origins/49b8d04b-7e4c-4c83-a904-3123a3aac6fb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=de03a10fa699fd9742e4dedf6f7be008 2x, https://si.imgix.net/3fc55c53/uploads/origins/49b8d04b-7e4c-4c83