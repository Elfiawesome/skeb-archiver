でも構いません。視点は暖かくて居心地の良い家の中からで、景色は雪の中と外を部分的に見ることになります。\n\n家の中で暖炉の火を囲みながら、三好と知佑がくつろいで話している。外では奈子とスカーレットが雪玉を投げ合う。\n\nキャラクターの詳細\n\n知佑-ホットチョコレートを飲んでいる。モコモコの赤いバスローブを着ている。\n\n三好-ホットワインを飲む。大人っぽい暖かいワンピースを着ている。\n\n奈子- 雪合戦。かわいい冬のコート。\n\nスカーレット- 雪合戦。警察の冬用ジャケット。\n\nいつも素晴らしい作品をありがとう。\n\nhttps://drive.google.com/drive/folders/1C7Dwl88UVSxyjDUDujCrW4KyALYvyBN4\n\nhttps://drive.google.com/drive/folders/1C7Dwl88UVSxyjDUDujCrW4KyALYvyBN4", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@imadragon610/works/8", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 18372, "client_id": 1774222, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/6329e423/uploads/origins/e7e88cdc-eeec-42fe-a4d4-6307a62b3d31?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ff912915828908b3be3bfa502a7e0136", "srcset": "https://si.imgix.net/6329e423/uploads/origins/e7e88cdc-eeec-42fe-a4d4-6307a62b3d31?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ff912915828908b3be3bfa502a7e0136, https://si.imgix.net/6329e423/uploads/origins/e7e88cdc-eeec-42fe-a4d4-6307a62b3d31?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=6f7fbdccb01078fe24c2ac890703bf48 2x, https://si.imgix.net/6329e423/uploads/origins/e7e88cdc-eeec-42fe-a4d4-6307a62b3d31?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=52bf26a6d1528925d377143627d8a1e4 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/6329e423/uploads/origins/e7e88cdc-eeec-42fe-a4d4-6307a62b3d31?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=122bffee6550cbc1f4467437968a45b8", "srcset": "https://si.imgix.net/6329e423/uploads/origins/e7e88cdc-eeec-42fe-a4d4-6307a62b3d31?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=122bffee