f&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ffc1aa0b94e3217143c1ff89232808d1, https://si.imgix.net/cfcf4d58/uploads/origins/6af21838-0459-4863-a10f-425012de2ada?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=357dbc0089908a6bd2c7ef71faaff36c 2x, https://si.imgix.net/cfcf4d58/uploads/origins/6af21838-0459-4863-a10f-425012de2ada?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=374f88d8e368eee6f182e680ac245084 3x"}, "body": "お世話になっております篠原です。\n\n今回はテーブルの上のデッキ５０枚を相手に投げつけるマキちゃんの立ち絵と一枚絵を描いていただきたいと思い依頼を送らせていただきました。\n\nギャグ調　　（難しいようでしたらどのような絵柄でも大丈夫です。）\n\n頭身は低め　（３～４頭身辺り　難しいようでしたらしどの頭身でも大丈夫です。）\n\nイメージとしては右手側に置いてある自分のデッキの束（50枚程をイメージ）をテーブルの対面に座っている相手側に投げつけている感じです。\n（この際に１つの束でも何枚かにばらけている状態でも大丈夫です。）\n\nです。\n\n今度の動画で使うデッキのイメージとして使用する予定なのでよろしくお願いします。", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@sakaue507/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2363984, "client_id": 2138255, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/d0fa7b05/uploads/origins/3dc34164-61dc-4ee4-89f2-e8a86b27c01e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=749b0a4299c7d7d54baf7954c33e468b", "srcset": "https://si.imgix.net/d0fa7b05/uploads/origins/3dc34164-61dc-4ee4-89f2-e8a86b27c01e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=749b0a4299c7d7d54baf7954c33e468b, https://si.imgix.net/d0fa7b05/uploads/origins/3dc34164-61dc-4ee4-89f2-e8a86b27c01e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=80fef55eb8cf9fe9bbd62925d971eca2 2x, https://si.imgix.net/d0fa7b05/uploads/origins/3dc34164-61dc-4ee4-89f2-e8a86b27c01e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=4a483495c0cb526f0f5793e549c7218f 3x"}, "duration": null, "nsfw": false, "hardcore": f