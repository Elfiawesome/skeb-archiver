さんご本人に限り配信やサムネイル・各種SNS投稿での使用を許可いただけますと幸いです\nこのためキャラクターのみを透過したpngかpsdもいただけますと助かります。\n\n参考資料\n・二面図\nhttps://twitter.com/miloilka/status/1553745344457895936?s=21&t=WiVnXLbaEZzSSFnf9LjRpw\n\nご検討いただけますと幸いです、よろしくお願いします\n\nhttps://twitter.com/miloilka/status/1553745344457895936?s=21&t=WiVnXLbaEZzSSFnf9LjRpw", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@pokunoe/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2644127, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/688cb9bc/uploads/origins/c446dbb7-4508-47ef-b613-e5eb69b4cc40?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a3787b4a424fb2c1b043bd6f92413feb", "srcset": "https://si.imgix.net/688cb9bc/uploads/origins/c446dbb7-4508-47ef-b613-e5eb69b4cc40?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a3787b4a424fb2c1b043bd6f92413feb, https://si.imgix.net/688cb9bc/uploads/origins/c446dbb7-4508-47ef-b613-e5eb69b4cc40?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=962dd5aa3c0f91554243dab2fd32f039 2x, https://si.imgix.net/688cb9bc/uploads/origins/c446dbb7-4508-47ef-b613-e5eb69b4cc40?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e3dbcc49089417edae1ed74af5d6d0a7 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/688cb9bc/uploads/origins/c446dbb7-4508-47ef-b613-e5eb69b4cc40?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=884c0bc64e7b4fabb3c6b93b9ef59776", "srcset": "https://si.imgix.net/688cb9bc/uploads/origins/c446dbb7-4508-47ef-b613-e5eb69b4cc40?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=884c0bc64e7b4fabb3c6b93b9ef59776, https://si.imgix.net/688cb9bc/uploads/origins/c446dbb7-4508-47ef-b613-e5eb69b4cc40?bg=%23fff&auto=format%2Ccompress&f