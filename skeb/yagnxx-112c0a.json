更いただいてかまいません！\n\n\n【使用用途】\nXをはじめとするSNSへの投稿、サムネイルなどのYouTubeでの使用、ネットプリントやグッズに使用させていただく可能性があります。\n使用不可のものがございましたら、お手数ですがイラストデータにご記載いただければと思います。\n\n\nお忙しいと思いますが、ご検討いただけると幸いです。\nどうぞ、よろしくお願いいたします！！", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@yagnxx/works/12", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3403245, "client_id": 3027007, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/51c9b245/uploads/origins/70743fa3-20cf-44a3-beb2-844018891666?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f0a61dcd0c1c7028abaeeb5d9f804bfd", "srcset": "https://si.imgix.net/51c9b245/uploads/origins/70743fa3-20cf-44a3-beb2-844018891666?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f0a61dcd0c1c7028abaeeb5d9f804bfd, https://si.imgix.net/51c9b245/uploads/origins/70743fa3-20cf-44a3-beb2-844018891666?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=5d3da0170af58f6d6e39bf3a3122ae2e 2x, https://si.imgix.net/51c9b245/uploads/origins/70743fa3-20cf-44a3-beb2-844018891666?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=0d406555e1ade3e950c87f143508b5a8 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/51c9b245/uploads/origins/70743fa3-20cf-44a3-beb2-844018891666?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=40391ce2d725456b5074cdf486ea8c8f", "srcset": "https://si.imgix.net/51c9b245/uploads/origins/70743fa3-20cf-44a3-beb2-844018891666?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=40391ce2d725456b5074cdf486ea8c8f, https://si.imgix.net/51c9b245/uploads/origins/70743fa3-20cf-44a3-beb2-844018891666?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=4023971c9d240086ee6ba8ee1f567a1a 2x,