ae59?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f3fe9635c5d00c2650442c1faffd1218", "srcset": "https://si.imgix.net/88199e15/uploads/origins/d221740c-e4bc-4b5d-8674-cf9197ecae59?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f3fe9635c5d00c2650442c1faffd1218, https://si.imgix.net/88199e15/uploads/origins/d221740c-e4bc-4b5d-8674-cf9197ecae59?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a54863b38ce783751c049882704af894 2x, https://si.imgix.net/88199e15/uploads/origins/d221740c-e4bc-4b5d-8674-cf9197ecae59?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b975586e545cc9dad170b8c3083541f5 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/88199e15/uploads/origins/d221740c-e4bc-4b5d-8674-cf9197ecae59?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f7f1484ca1323d10a26f309bc8dc0847", "srcset": "https://si.imgix.net/88199e15/uploads/origins/d221740c-e4bc-4b5d-8674-cf9197ecae59?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f7f1484ca1323d10a26f309bc8dc0847, https://si.imgix.net/88199e15/uploads/origins/d221740c-e4bc-4b5d-8674-cf9197ecae59?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=f9be572737a6b3bdac8fa2189e50af04 2x, https://si.imgix.net/88199e15/uploads/origins/d221740c-e4bc-4b5d-8674-cf9197ecae59?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=d69129ccec2bb3d12ef103f1081ee743 3x"}, "body": "成美さんがSkebをはじめられて嬉しいです！\nもしよろしければ『西遊記』の沙悟浄を成美さんのオリジナルデザインで描いていただけないでしょうか？\nこちらからのデザイン上の希望は、\n・河童（日本における悟浄の一般的なイメージ）ではない、なんの妖怪とも言えない正体不明の人型の水怪であること\n・男性（個人的には若い青年の見た目ですと嬉しいです）であること\n・服の色が黄色系であること\n……です。あとはおまかせでお願いします。\n悟浄はそもそも原典西遊記でもキャラ付けが薄めですので、性格上の印象も河童のイメージに引きずられなければあなたのお好きな感じで大丈夫です。\n立ち絵ではなく一枚絵として描いていただきたいので全身の描写は必須ではありません。\nできれば絵の印象はあやしい雰囲気※が漂う感じですと嬉