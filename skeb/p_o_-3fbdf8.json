396cd999-040a-4da8-a0fa-3eb0477ef932?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=dae15a1c76bc68a40008779c16c25a64, https://si.imgix.net/bb32f9ee/uploads/origins/396cd999-040a-4da8-a0fa-3eb0477ef932?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=e1b9713bf21df9ee30831041b7621b6f 2x, https://si.imgix.net/bb32f9ee/uploads/origins/396cd999-040a-4da8-a0fa-3eb0477ef932?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=9cf1ca4abafd2e9f2b9c40da0877257b 3x"}, "body": "李岳伝サイドストーリーはいかがでしょうか？\n下記、一応のイメージです。ご自由に。\n張遼視点\n第十七話　三鍵の計  後\n\n李岳とかいうんが来てから丁原様がおかしい。\n「いや親子やろアレ。なあ？」\n「隊長。声がでけえっす。」\nみたいな？\n\n\n久しぶりに読んで衝撃だったんですが、１話でオカンは笑顔が絶えない人ってあって。\nオカンは鉄面皮のイメージがあったので。\n刺史やってる時は鉄面皮で。\n再開してから人前で笑顔増えたとかなら。\n張遼他軍団の皆さんにバレバレなレベルでニコニコしてたんですかね？\n\n張遼視点で李岳合流前・合流後の丁原について所感をお願い致します。\nお忙しい事と思います。\n難しい場合はまた機会がある時で大丈夫です。\n二巻楽しみにしております。", "nc": 129, "word_count": 4566, "transcoder": "text", "creator_acceptable_same_genre": true}, {"path": "/@p_o_/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "novel", "tipped": false, "creator_id": 35315, "client_id": 1486378, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/5a8c88b7/uploads/origins/c401d5dc-a064-4ae9-a8ed-f9b524bd8578?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=46d99ae75df4c957e2e72751d8f02608", "srcset": "https://si.imgix.net/5a8c88b7/uploads/origins/c401d5dc-a064-4ae9-a8ed-f9b524bd8578?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=46d99ae75df4c957e2e72751d8f02608, https://si.imgix.net/5a8c88b7/uploads/origins/c401d5dc-a064-4ae9-a8ed-f9b524bd8578?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=5436626313fd4c2e42faaace3b5944cc 2x, https://si.imgix.net/5a8c88b7/uploads/origins/c401d5dc-a064-4ae9-a8ed-f9b524bd8578?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=053323c508372f937ddce4a742b92dd2 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/5a8c88b7/uploads/origins/c401d5dc-a064-4ae9-a8ed-f9b524bd8578?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b1696f1063f31204b82fad58292c261f", "srcset": "https://si.imgix.net/5a8c88b7/uploads/origins/c401d5dc-a064-4ae9-a8ed-f9b524bd8578?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b1696f1063f31204b82fad58292c261f, https://si.imgix.net/5a8c88b7/uploads/origins/c401d5dc-a064-4ae9-a8ed-f9b524bd8578?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=b0afacfbd9e9984dc3a4b818b1bd55be 2x, https://si.imgix.net/5a8c88b7/uploads/origins/c401d5dc-a064-4ae9-a8ed-f9b524bd8578?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=c29f2f7d465b07c7b9a55482f3003b96 3x"}, "body": "李岳伝を読み返していて感じたのが\n「李岳伝世界の後世（現代）の評価を見てみたい！」という思いでした。\n\n本編中に宋の時代の見解なんかは記載がありますので、日本にもその活躍が伝わり「今李岳」なんてのが戦国時代やらに現れたりしてたのかな～\n日本でも三國時代のマンガや小説にも登場するのかな～\nなんて妄想が捗っております。\n\nあえて伏せている部分もあるかと思いますので、記載できる範囲での\nウィキペディア的なまとめなんかリクエストさせていただきます！", "nc": 1, "word_count": 2774, "transcoder": "text", "creator_acceptable_same_genre": true}, {"path": "/@p_o_/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "novel", "tipped": true, "creator_id": 35315, "client_id": 43628, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/9496de87/uploads/origins/1bfa7e8c-f1a2-4022-bd97-bb4e9bca7621?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9ce59a10eb2d01ec0bc64b90e68e5c51", "srcset": "https://si.imgix.net/9496de87/uploads/origins/1bfa7e8c-f1a2-4022-bd97-bb4e9bca7621?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9ce59a10eb2d01ec0bc64b90e68e5c51, https://si.imgix.net/9496de87/uploads/origins/1bfa7e8c-f1a2-4022-bd97-bb4e9bca7621?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=3079528e0837c2a2fe1d922db4e861ed 2x, https://si.imgix.net/9496de87/uploads/origins/1bfa7e8c-f1a2-4022-bd97-bb4e9bca7621?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=23389e7af0a1666a89032a14502aaf3b 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/9496de87/uploads/origins/1bfa7e8c-f1a2-4022-bd97-bb4e9bca7621?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=875132f284c2990cb62e2ac73722da5b", "srcset": "https://si.imgix.net/9496de87/uploads/origins/1bfa7e8c-f1a2-4022-bd97-bb4e9bca7621?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=875132f284c2990cb62e2ac73722da5b, https://si.imgix.net/9496de87/uploads/origins/1bfa7e8c-f1a2-4022-bd97-bb4e9bca7621?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=7e302bfc3d043969fcb3ae6ec14764f4 2x, https://si.imgix.net/9496de87/uploads/origins/1bfa7e8c-f1a2-4022-bd97-bb4e9bca7621?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=0d325cc54b920a990895187dfb4dcd27 3x"}, "body": "以前は、素敵な外伝をありがとうございました。\n再び李岳伝の成分を身体が欲し始めたので、リクエストさせていただきます。\n\n生み出していただいたトラマナ族長の3年後を、お願いしたく。\n中央アジア地域で覇権を確保しつつある情勢で、様々な部族を飲み込んで一つの「国」と成した新たな「王」として起ったトラマナは、いよいよクシャナ王朝との決戦に挑む。\n歴史年表的には、その決戦に勝ったトラマナがエフタルという国体を勃興させるに至るんですが、そこの決戦の場を駆け抜けていった李岳と恋とを描いて欲しいです。\n今回は李岳視点で、トラマナ率いる氏族の騎馬兵団と、クシャナ王朝側の精兵とのぶつかり合いを見つめる、というか。\n戦のただ中に没入してくれてもいいですし、軍師的に俯瞰している状態でも構いません。\nしかし、李岳の教えを飲み込んだトラマナ達が、げに精強な騎馬兵団を作り上げ、それで大勢のクシャナ王朝軍をぶち抜いていく様などを描写として入れていただけたら幸いです。\nイメージとしては、北方三国志の呂布率いる黒の騎馬隊。手足のように騎馬隊を操り、相手の方陣を紙を裂くがごときに蹂躙する、そんなイメージです。\n\nつらつらと書いてきましたが、ぽーさんの料理に基本はお任せします。\n素敵な騎馬戦闘が見たい。それもせっかく生み出していただけた自分のツボまみれなトラマナで。という\nそんなリクエストでございます。\n\nご検討いただければ幸いです。\nなお、今回もお受けいただけるのなら、ハーメルンにも掲載をお願いいたします。", "nc": 145, "word_count": 7249, "transcoder": "text", "creator_acceptable_same_genre": true}, {"path": "/@p_o_/works/2", "pri