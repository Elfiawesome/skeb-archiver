at%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=3c3528012ba5726291545291a4e10f95 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/4ab5d484/uploads/origins/edd5a699-df5f-4a2d-8de0-77e493bfe9ad?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6e9635621ba953969c2d9e376a211111", "srcset": "https://si.imgix.net/4ab5d484/uploads/origins/edd5a699-df5f-4a2d-8de0-77e493bfe9ad?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6e9635621ba953969c2d9e376a211111, https://si.imgix.net/4ab5d484/uploads/origins/edd5a699-df5f-4a2d-8de0-77e493bfe9ad?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=6f17664feeb41e82587fb0af536a9c5c 2x, https://si.imgix.net/4ab5d484/uploads/origins/edd5a699-df5f-4a2d-8de0-77e493bfe9ad?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=f0bda516a5bdb61b705ae0b188ac9ef6 3x"}, "body": "もすくぼ先生　お世話になっております。\n ぽんずです。\n今回も、もすくぼ先生にウチのOC「グレア」を描いていただきたく、リクエストさせてくださいませ。\n\n☆衣装\n・大人っぽく花柄の青色の下着(ベルベットブルー)を着用させて欲しいです。\n\n☆シチュエーション\n・朝起きたばかりのグレアがベットの上でぺたん座り。\n・胸を手で持ち上げて、「また大きくなったかも……？」と困惑している表情で独り言を言っている雰囲気で。\n\n☆希望要項\n○胸が特に好きなのでもすくぼ先生のお好きなように盛り盛りに描いていただけると幸いです。  \n○胸が下着に押し込まれつつ、ﾊﾟｯﾂﾊﾞﾂｷﾞﾁｷﾞﾁになって今にも溢れてしまいそうな感を強調気味でお願い致します。 (陥没乳首で)\n◯可能でしたら全裸の差分も欲しいです。\n ◯また、宛名をPSDレイヤーOn\\Offできる様にして貰えると嬉しいです。   \n\nよろしければどうかご検討の程、よろしくお願い致します！！\n\nhttps://drive.google.com/drive/folders/1yvwEmeMIY4kkOsLr3zWs72ymDMef3r2v", "nc": 33, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@moskubo113/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3900301, "client_id": 3313415, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/6694e24f/uploads/origins/da238dfa-dbd7-4c95-90af-2bc620be1021?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5831140ecea127796b15d18e0782ffe8", "srcset": "https://si.imgix.net/6694e24f/uploads/origins/da238dfa-dbd7-4c95-90af-2bc620be1021?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5831140ecea127796b15d18e0782ffe8, https://si.imgix.net/6694e24f/uploads/origins/da238dfa-dbd7-4c95-90af-2bc620be1021?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=4ebcc7d85c88bd0c7f07a3c4c5664f35 2x, https://si.imgix.net/6694e24f/uploads/origins/da238dfa-dbd7-4c95-90af-2bc620be1021?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e84244535c86b23e093f3b14c99dc534 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/6694e24f/uploads/origins/da238dfa-dbd7-4c95-90af-2bc620be1021?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2bcba1bf713cd5f1c98bb75476a27027", "srcset": "https://si.imgix.net/6694e24f/uploads/origins/da238dfa-dbd7-4c95-90af-2bc620be1021?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2bcba1bf713cd5f1c98bb75476a27027, https://si.imgix.net/6694e24f/uploads/origins/da238dfa-dbd7-4c95-90af-2bc620be1021?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=f203762603bae06ddd0ebbfa6933e8c2 2x, https://si.imgix.net/6694e24f/uploads/origins/da238dfa-dbd7-4c95-90af-2bc620be1021?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=41e91f30ebce5c167c4121da01ace0af 3x"}, "body": "もすくぼ先生　お世話になっております。\nぽんずです。\nもすくぼ先生にウチのOC「グレア」をまた描いていただきたく、リクエストさせてくださいませ。\n\n☆OC「グレア」設定\n・狼耳と尻尾あり。グレーアッシュのロング泣き黒子ありの身長高め、実はおっぱいコンプ隠れ爆乳(陥没乳首)でムチムチ明朗快活美人オオカミ娘です。(アンダーバスト70想定)\n・普段は胸の大きさを隠す為に魔法の指輪で胸を活動しやすい大きさ程度まで抑えつけているが、苦しくなるため定期的に魔法をoffにして、休憩する必要がある。\n・収縮時：B90・Eカップ(日中の活動時の大きさ。もっと小さくしたいが魔法の継続や後の反動を考えるとコレが限界)\n・最大時：B128・Tカップ(元の大きさ。収縮時からこの大きさに戻ってゆく)\n・魔法の反動で敏感になってしまったおっぱいが徐々に元の大きさに戻るため、窮屈な衣服にパッツパツのギチギチにおっぱいが押し込められていくのが気持ち良くて、恥ずかしいけれどもちょっと癖になってしまっている。\n・また、魔力や集中力の低下による魔法の持続が難しくなった時や不慮の事故(魔法Onのまま指輪を外す、もしくは指輪の魔法異常など)で魔法のコントロールが出来なくなった時は反動が倍増してしまう。\n\n☆衣装\n・添付資料内にございます、和装スタイルでお願いします。\n\n☆シチュエーション \n・衣装を新しく新調したグレア。しかし、着慣れない服装と緊張にいつもの癖も相まって興奮汗蒸れ状態に。 \n・そのせいで胸が元の大きさになり、衣装が破れて胸が溢れそうになってしまうみたいな感じで。\n\n ☆希望要項 \n○胸が特に好きなのでもすくぼ先生のお好きなように盛り盛りに描いていただけると嬉しいです。 \n○胸が衣装に押し込まれてﾊﾟｯﾂﾊﾞﾂｷﾞﾁｷﾞﾁになってしまっている感とラインを強調気味でお願い致します。 \n○宛名をPSDレイヤーOn\\Offできる様にして貰えると嬉しいです。  \n\nよろしければどうかご検討の程、よろしくお願い致します！！\n\nhttps://drive.google.com/drive/folders/1yvwEmeMIY4kkOsLr3zWs72ymDMef3r2v", "nc": 32, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 18594, "creator": true, "nsfw_acceptable": true, "acceptable": false, "name": "笠木（絵は新垢にて活動）", "screen_name": "kasagland", "avatar_url": "https://pbs.twimg.com/profile_images/1843678887819276288/ws_zrUTI.jpg", "header_url": "https://pbs.twimg.com/profile_banners/302936499/1657554038/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 120, "skills": [{"genre": "art"}, {"genre": "correction"}], "banned": false, "nc": 48}, {"id": 574604, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "ればすと2ndGen🔞＠サブ垢", "screen_name": "rebasuto102702", "avatar_url": "https://pbs.twimg.com/profile_images/1792546161016143872/8xcGDu6g.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1116577413163438081/1608736233/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 10, "complete_expiration_days": 90, "skills": [{"genre": "art"}], "banned": false, "nc": 161}, {"id": 785185, "creator": true, "nsfw_acceptable": true, "acceptable": false, "name": "ててぽ", "screen_name": "rakupote", "a