top&w=200&h=200&blur=200&s=434c2285c664ed3d24a7733a4cb29d21, https://si.imgix.net/00b3d10d/uploads/origins/3b4b3ef7-30e5-4e75-934e-d24d5684500e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=d5f4d53b3fee0bd810e7ab69f74747b4 2x, https://si.imgix.net/00b3d10d/uploads/origins/3b4b3ef7-30e5-4e75-934e-d24d5684500e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=475850c3c807267c00d6819f0563e0cc 3x"}, "body": "こんにちは。\n私のキャラクターのイラストをお願いしたいと思います。\n\n2匹の猫（猫の写真は参照フォルダにあります）と一緒に遊んでいてほしいのですが、ほとんど同じですが、1匹の猫は右目の周りにグレーの毛があります。真っ白な猫はとてもおとなしくて甘えん坊で、灰色の毛が生えている猫はやんちゃです。\n\n普段はクールでセクシーなキャラクターですが、この猫たちをとても愛しているので、遊んでいる時はとても愛くるしい表情をするでしょう。\n\n猫たちの配置はお任せします。ありがとうございました。\n\nhttps://drive.google.com/drive/folders/1Q7XzYSLcX3j0X6VtBkZLBkMGkV56So1y?usp=sharing", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@Emile_FF14/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1133467, "client_id": 1104921, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/f3784695/uploads/origins/0242712c-1c32-4990-aaf1-e32522e9b21a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=149c5a95a5b9d837cf166bc71efc460f", "srcset": "https://si.imgix.net/f3784695/uploads/origins/0242712c-1c32-4990-aaf1-e32522e9b21a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=149c5a95a5b9d837cf166bc71efc460f, https://si.imgix.net/f3784695/uploads/origins/0242712c-1c32-4990-aaf1-e32522e9b21a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=d28cd561420afb2ccb149a86c5df3ed4 2x, https://si.imgix.net/f3784695/uploads/origins/0242712c-1c32-4990-aaf1-e32522e9b21a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=2dddeea66e67ff10c16eef74361ac30d 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_im