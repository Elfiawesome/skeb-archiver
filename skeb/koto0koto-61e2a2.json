imgix.net/911e9c52/uploads/origins/8916f6bf-aa31-4589-b1cf-e6130b325f84?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ce0b51c7c32fc6b148536f70235af3ab, https://si.imgix.net/911e9c52/uploads/origins/8916f6bf-aa31-4589-b1cf-e6130b325f84?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e28aed1b2ceea33b3102ef28b35326cb 2x, https://si.imgix.net/911e9c52/uploads/origins/8916f6bf-aa31-4589-b1cf-e6130b325f84?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b661d60ee6a37483ac3b960125c9c29d 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/911e9c52/uploads/origins/8916f6bf-aa31-4589-b1cf-e6130b325f84?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2f62f61dc2b569df9fcc02d889a850c2", "srcset": "https://si.imgix.net/911e9c52/uploads/origins/8916f6bf-aa31-4589-b1cf-e6130b325f84?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2f62f61dc2b569df9fcc02d889a850c2, https://si.imgix.net/911e9c52/uploads/origins/8916f6bf-aa31-4589-b1cf-e6130b325f84?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=34401b3b9bcd36f5f2de54b055db0a33 2x, https://si.imgix.net/911e9c52/uploads/origins/8916f6bf-aa31-4589-b1cf-e6130b325f84?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=aa53827e4489cf753528c548197243ba 3x"}, "body": "こんにちは！僕のキャラクター、モックを描いてくれたらもっと嬉しいな！\n\n彼女のデザインの特徴とコアは以下の通りです；\n- 彼女は磁器の人形を宿主とした生き物で、そのデザインにはウサギの特徴があります。\n- 細身で小柄。\n- 表情は無表情で、目は鋭いまなざしをしている。\n- 物事に興味津々だが、その探求の仕方は病的である。\n\nあなたが提案してくれたアイデアがとても気に入ったので、構図はあなたに任せるわ！\n\nキャラクターと背景は別レイヤー（PSD形式）にしていただけると助かります。\n\nこの度は私の依頼をご検討いただき、またモックを気に入っていただきありがとうございました！\n\nhttps://drive.google.com/drive/folders/1hJDlwq9Xx1PvxGNImWwaZC7Y21VoevrO?usp=sharing", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/