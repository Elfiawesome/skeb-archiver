・半袖のセーラー服\n・元気な感じ\n■シチュエーション\n・右腕にケガでギプスをしていて、三角巾で首から吊っている\n　‐首と肘のところの三角巾の結び目を見える位置にお願いします(資料URLご参照ください)\n　　(細かいですが…首の方は結び目1つ、三角巾の端が2つ、肘の方は結び目1つ、三角巾の端が1つ、という違いがあります)\n　‐右腕が画面に入るような構図でお願いします\n・ほっぺたに絆創膏１枚\n・ケガをしてても暗くならず、以下のような照れている表情\n　‐片目ウィンク、ペロっと舌を出している、いわゆるてへぺろな表情\n\n包帯に萌えるのと、それでも可愛く元気な姿に萌えるのが個人的なポイントです。\n\nhttps://www.youtube.com/watch?v=iLDkTBdxs4w", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@PZit94/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3562356, "client_id": 967580, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/c4658ec6/uploads/origins/46491b3c-230c-495b-b574-e57a97d375a1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=861a1295b034aed607acdd0be53ed5eb", "srcset": "https://si.imgix.net/c4658ec6/uploads/origins/46491b3c-230c-495b-b574-e57a97d375a1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=861a1295b034aed607acdd0be53ed5eb, https://si.imgix.net/c4658ec6/uploads/origins/46491b3c-230c-495b-b574-e57a97d375a1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=d152bf4b5b184b86989aff0ab62b2722 2x, https://si.imgix.net/c4658ec6/uploads/origins/46491b3c-230c-495b-b574-e57a97d375a1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a9e58e0963711662a6f2422e8120f264 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/c4658ec6/uploads/origins/46491b3c-230c-495b-b574-e57a97d375a1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a526af8817cd6590828cf31ecb10a77a", "srcset": "https://si.imgix.net/c4658ec6/uploads/origins/46491b3c-230c-495b-b574-e57a97d375a1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a526af8817cd6590828cf31ecb10a77a, https://si.imgix.net/c4658ec6/uploads/origins/