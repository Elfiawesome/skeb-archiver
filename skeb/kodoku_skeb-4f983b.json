pr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=7af7e6048fd4fe4c518b8d1a9ed4208f 3x"}, "body": "お久しぶりです。\nVtuberとして活動してます、紅寿ぴけです！\n\n孤独ちゃんたんさんにめっちゃイラスト描いてもらいたいんですが、\nタイミングがなくて、タイミングつくることにしました！\nお酒を飲んで楽しそうに歌う紅寿ぴけを描いていただきたいです！\n衣装構図等はお任せします！\n参考資料を共有します！\n配信サムネや、SNS上にあげる画像として使わせてもらいます！\nもしよければよろしくお願いします！\n\nhttps://drive.google.com/drive/folders/1EWnAqLW3afMn59lH2I7aZxEgHpuwvWBo", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@kodoku_skeb/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2726888, "client_id": 2320685, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/7ae28233/uploads/origins/4b779cea-a134-4d65-9d67-2ee6c39af53b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c2524c78814eecfaebbb66e98edace24", "srcset": "https://si.imgix.net/7ae28233/uploads/origins/4b779cea-a134-4d65-9d67-2ee6c39af53b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c2524c78814eecfaebbb66e98edace24, https://si.imgix.net/7ae28233/uploads/origins/4b779cea-a134-4d65-9d67-2ee6c39af53b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=41155c8f4cd4ff7623fae81388b0be8e 2x, https://si.imgix.net/7ae28233/uploads/origins/4b779cea-a134-4d65-9d67-2ee6c39af53b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=129dc33a5574dc212ac422438e1cf714 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/7ae28233/uploads/origins/4b779cea-a134-4d65-9d67-2ee6c39af53b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=084cf50954d5078942db9df1f3e87e20", "srcset": "https://si.imgix.net/7ae28233/uploads/origins/4b779cea-a134-4d65-9d67-2ee6c39af53b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=084cf50954d5078942db9df1f3e87e20, https://si.imgix.net/7ae28233/uploads/origins/4b779cea-a134-4d65-9d67-2ee6c39af53b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=e56084f4e203a62e813b5309de448b42 2x, https://si.imgix.net/7ae28233/uploads/origins/4b779cea-a134-4d65-9d67-2ee6c39af53b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=55f12528f3f4ccfd11f84464f925b828 3x"}, "body": "こんにちは。あなたの作品を拝見し、素晴らしいと思いました。\n\n私のOCを黒執事シリーズに登場する執事、主にメイン執事のセバスチャン・ミカエリスとして描いていただきたいです。私のOCの絵と、執事のセバスチャンが着る服の絵をお願いします。\n\n私のOCには、セバスチャンが着ているような執事の服装をしてほしい。愛人や主人を待っているようなポーズを取りたい。身を乗り出して \"How may I be of service, Mistress/Master?\" と言う。\n\nと言いながら、OCにいたずらっぽい微笑みを浮かべてほしい。\n\nそれ以外のことはあなたにお任せします。\n\n以下、参考リンク。\n\nhttps://drive.google.com/drive/folders/1x81P6EBoyCM_r04EKJcZQxCJ-xvK6iKT", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@kodoku_skeb/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2726888, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/1e9a570b/uploads/origins/2c5103dc-f12e-4861-875b-99ef44e0ed5c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=867966f20d579e01a20e39db9dc0a217", "srcset": "https://si.imgix.net/1e9a570b/uploads/origins/2c5103dc-f12e-4861-875b-99ef44e0ed5c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=867966f20d579e01a20e39db9dc0a217, https://si.imgix.net/1e9a570b/uploads/origins/2c5103dc-f12e-4861-875b-99ef44e0ed5c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=39f552864efc35433c5c717e40729cc0 2x, https://si.imgix.net/1e9a570b/uploads/origins/2c5103dc-f12e-4861-875b-99ef44e0ed5c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e70acdb3cd830e96b4a7ecfb71de25b3 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/1e9a570b/uploads/origins/2c5103dc-f12e-4861-875b-99ef44e0ed5c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6e770ce0dd0e42550f1bf6227e5981cc", "srcset": "https://si.imgix.net/1e9a570b/uploads/origins/2c5103dc-f12e-4861-875b-99ef44e0ed5c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6e770ce0dd0e42550f1bf6227e5981cc, https://si.imgix.net/1e9a570b/uploads/origins/2c5103dc-f12e-4861-875b-99ef44e0ed5c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=9be64b8f9efe3707ee7cbea1f5f88b2a 2x, https://si.imgix.net/1e9a570b/uploads/origins/2c5103dc-f12e-4861-875b-99ef44e0ed5c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=fcad9724c0ac8cde7e46810de702b621 3x"}, "body": "私のOCを描く？\n壊れた未来世界の兵士。頑固で、かつては強い道徳心を持っていたが、周囲の絶望的な世界に疲れ果ててしまった。彼はいまだに上官の命令やプロパガンダに合わせて行進しているが、それはより良い選択肢が見つからないからにほかならない。彼は内面が空洞であり、より良い選択肢が生まれることを懇願し、より良い世界に影響を与えるチャンスを内心懇願している。\n見た目は40代後半から50代前半、肉体的には健康だが年齢を感じさせる。\n髪型はすぐに乱れる。見栄えを保とうとするが、うまくいかないこともある。\n目は生き生きとしていて、強烈で鋭い。\n服装は、資源が手薄な、近未来的な技術を駆使した独立軍のよう。\n顔の見えない民間人から甘いお菓子（焼いたパン、お菓子、固いお菓子、その他）を受け取りながら行進しているように描いてください。これからの時代への贈り物。花よりも食べ物の方が戦いの準備になる。\n愛国的な楽しい気分、陽気で楽観的な気分？それとも、これから何が起こるかを知っている、沈鬱で疲れた気分？お好きなように。\nその他はお好きなように。\n\nhttps://drive.google.com/drive/folders/1Gpy224Ab73jydjw9K52_b5m8sptQP5i7", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@kodoku_skeb/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2726888, "client_id": 2568944, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/9718e4a1/uploads/origins/61357a0b-d3f3-4c97-9e4a-46200c1c773d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=876f01b2d01a8d872af248dce6f244c2", "srcset": "https://si.imgix.net/9718e4a1/uploads/origins/61357a0b-d3f3-4c97-9e4a-46200c1c773d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop