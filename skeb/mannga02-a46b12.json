age", "creator_acceptable_same_genre": false}, {"path": "/@mannga02/works/13", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2900367, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/860f72fe/uploads/origins/7cee3b5c-2a53-40d7-9173-895896b89ffb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=78e59da1e793d7c79b317b2cf76a77e7", "srcset": "https://si.imgix.net/860f72fe/uploads/origins/7cee3b5c-2a53-40d7-9173-895896b89ffb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=78e59da1e793d7c79b317b2cf76a77e7, https://si.imgix.net/860f72fe/uploads/origins/7cee3b5c-2a53-40d7-9173-895896b89ffb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b93b06a36fd2d08d87bad048803fff19 2x, https://si.imgix.net/860f72fe/uploads/origins/7cee3b5c-2a53-40d7-9173-895896b89ffb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a35ee01cd2d23ad3ea9342e9c3b3e9c7 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/860f72fe/uploads/origins/7cee3b5c-2a53-40d7-9173-895896b89ffb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=93e986a3578d479015279291dbf8154f", "srcset": "https://si.imgix.net/860f72fe/uploads/origins/7cee3b5c-2a53-40d7-9173-895896b89ffb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=93e986a3578d479015279291dbf8154f, https://si.imgix.net/860f72fe/uploads/origins/7cee3b5c-2a53-40d7-9173-895896b89ffb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=132c819a6c66dad183a5586ffc9f3312 2x, https://si.imgix.net/860f72fe/uploads/origins/7cee3b5c-2a53-40d7-9173-895896b89ffb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=1ea30deebc2e427b96de3927e4fb8c23 3x"}, "body": "はじめまして。初めてskebで依頼してみようと思い立ち、Twitterで「#skeb」で検索して、林間宮路様のイラストに惹かれてメッセージを送らせていただきました（色使いも絵柄の雰囲気もとっても好きです！）\n\nリクエスト内容ですが、クトゥルフ神話TRPGというゲームの探索者のコンビ絵になります。\n\n赤い髪の毛の探索者「かせん」\n・26歳168cm\n・市役所職員\n・ネームプレートを首から下げている\n・腕に数珠\n・所謂やれやれ系\n\n黄色い髪の毛の探索者「おかげ」\n・27歳158cm\n・パン屋\n・ぶっ飛び系 店のアンチとsnsでレスバしたりする\n\n2人は友人で、おかげの経営するパン屋に頻繁にかせんが通っています。仲の良い同性同士ですが、かせんはおかげにこっそり惹かれています。\n普段はおかげがとんでもないことをして、かせんが「えぇ…」みたいな態度を取りつつ許容する、と言った感じです。\n\n構図等特に指定ありません。林間宮路様の好きなように描いて頂いて大丈夫です。\n\n初めてskebで依頼するため、不手際等あると思いますが、もし宜しければ、お引き受け頂けましたら幸いです。\n\nhttps://drive.google.com/drive/folders/1amPthGoMmt35CSCjKSJ4UR7mBONK6mk6", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@mannga02/works/12", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2900367, "client_id": 1753954, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/9bb8ad61/uploads/origins/4df22874-d7b9-4fdb-a8a7-1488e3127254?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7d43b36f9c56ef47edab000d8d043473", "srcset": "https://si.imgix.net/9bb8ad61/uploads/origins/4df22874-d7b9-4fdb-a8a7-1488e3127254?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7d43b36f9c56ef47edab000d8d043473, https://si.imgix.net/9bb8ad61/uploads/origins/4df22874-d7b9-4fdb-a8a7-1488e3127254?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e0adb1b126793fc8007764ddc2c57fc0 2x, https://si.imgix.net/9bb8ad61/uploads/origins/4df22874-d7b9-4fdb-a8a7-1488e3127254?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=797764689e7d82d13727c7b50543b784 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/9bb8ad61/uploads/origins/4df22874-d7b9-4fdb-a8a7-1488e3127254?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ea28c53baad537c20ab64870676c65ac", "srcset": "https://si.imgix.net/9bb8ad61/uploads/origins/4d