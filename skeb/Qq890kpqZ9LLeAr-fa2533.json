uration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/b23dc56b/uploads/origins/0691aa8b-cc97-4021-9b7c-da9cc1f8a143?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=fb6db51560b3075df93810fda89e18a4", "srcset": "https://si.imgix.net/b23dc56b/uploads/origins/0691aa8b-cc97-4021-9b7c-da9cc1f8a143?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=fb6db51560b3075df93810fda89e18a4, https://si.imgix.net/b23dc56b/uploads/origins/0691aa8b-cc97-4021-9b7c-da9cc1f8a143?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=558a56ae3bc289c92b28da98b5c23250 2x, https://si.imgix.net/b23dc56b/uploads/origins/0691aa8b-cc97-4021-9b7c-da9cc1f8a143?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=808d11dfa561b8aff9bcc76533f6fd7d 3x"}, "body": "天外魔境第四の黙示録のアイク・クリントンをお願いしたいのですが、若干夢要素のある指定は可能でしょうか。\nシチュエーションは「酒場で軽口のつもりでアイクを煽ったせいでワンパンで床に沈んだゴロツキ(ぼく)に、馬乗りになって(※高身長の人はしゃがむとバランスとれないらしいので座らざるを得ない)胸ぐらを掴み追い討ちをかけるアイク」でお願いできればと思います。\n低い位地に座ったせいであの長い足が余る姿が拝みたいです。\nよろしくお願いします。", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [{"path": "/@Whybe123/works/212", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2285556, "client_id": 1730542, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/526eb273/uploads/origins/7bdafbc6-4ef8-4599-8556-88511b57f6a9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ea66c4902c87d6e72d81819c1949d2f4", "srcset": "https://si.imgix.net/526eb273/uploads/origins/7bdafbc6-4ef8-4599-8556-88511b57f6a9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ea66c4902c87d6e72d81819c1949d2f4, https://si.imgix.net/526eb273/uploads/origins/7bdafbc6-4ef8-4599-8556-88511b57f6a9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ba3fed34ab32ac84443c330ca37d79dd 2x, https://si.imgix.net/526eb273/uploads/origins/7bdafbc6-4ef8-4599-8556-88511b57f6a9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=3c6c7d7d84c0da1bcd349491805fd573 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/526eb273/uploads/origins/7bdafbc6-4ef8-4599-8556-88511b57f6a9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=941c31918c08397dc9dabb38ed071544", "srcset": "https://si.imgix.net/526eb273/uploads/origins/7bdafbc6-4ef8-4599-8556-88511b57f6a9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=941c31918c08397dc9dabb38ed071544, https://si.imgix.net/526eb273/uploads/origins/7bdafbc6-4ef8-4599-8556-88511b57f6a9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=d67d222c54c2889f947a038847f3ce3c 2x, https://si.imgix.net/526eb273/uploads/origins/7bdafbc6-4ef8-4599-8556-88511b57f6a9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=7cb64173debdebbf2971c78eb8b77b1b 3x"}, "body": "はじめまして\nわいびー様のイラストの空間造りに一目惚れして、私も描いて頂きたいと思いリクエストを送信しました\n\n【キャラクター】資料URLにあるキャンディス・ケイン\n\n彼はサーカス団のリーダーを務める男性です\nゾンビの義両親に育てられ、気を抜く度に命を狙われてきた経験から自分を悪辣で手に負えない人間であるかのように装うことで身を守っています\nそのため普段は横柄な態度で無理難題を振り撒く理不尽な人物ですが、本来はとても臆病で、面倒見の良い性格をしています\n\nからい物、特に酸辣湯や酸豆角肉泥等の湖南料理が大好きで、他人には内緒でよく作っています\n\n資料画像はAと名の付くファイルがメインで、残りは雰囲気程度のものになります\n\n【お願い】\n彼はサーカス団の列車の一両に私室を持ち、鍵を掛けて素の自分で過ごす事があります\nそのシーンを描いて頂ければ幸いです\n\n部屋の様子についてはなんとなくのイメージで申し訳ないのですが、キッチンと寝室が一緒になった長方形のワンルームで、レシピ本やメモ、くまのぬいぐるみなどを散りばめて欲しいです\n\n眉毛はなく、たれ目で、その下に5つずつ黒子のある特徴が残っていれば、その他はアレンジして頂いても、そのままでも大丈夫です(クッションのような髪型はカツラなので、取り外せます)\n\n可能であれば、psdで私のキャラクターと背景、宛名を別レイヤーで分けて頂きたいです\n\n\n【使用用途】\n個人的な鑑賞と、作品ページのURLを投稿してSNSのフォロワーに共有します\n\n\n以上の内容で、もしよろしければお引き受け頂けると嬉しいです\nよろしくお願いします\n\nhttps://drive.google.com/drive/folders/19s5LDEjRBobkP2S7d4VRRaegCHtVLknt", "nc": 129,