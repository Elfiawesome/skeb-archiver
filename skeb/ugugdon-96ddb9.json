rop&crop=top&w=200&h=200&s=f0943f1d7f7370078ae5ca52c53e5218 2x, https://si.imgix.net/5c583581/uploads/origins/02320a4d-7827-4917-87db-570729c346b6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=70324ace02aba24e2b395fc8c7db2287 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/5c583581/uploads/origins/02320a4d-7827-4917-87db-570729c346b6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=bf092704ecef8416709b34fbcbe40879", "srcset": "https://si.imgix.net/5c583581/uploads/origins/02320a4d-7827-4917-87db-570729c346b6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=bf092704ecef8416709b34fbcbe40879, https://si.imgix.net/5c583581/uploads/origins/02320a4d-7827-4917-87db-570729c346b6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=d02021a7d6d16ea395d143f2a92507c2 2x, https://si.imgix.net/5c583581/uploads/origins/02320a4d-7827-4917-87db-570729c346b6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=94de16ae51052d25a09523d8db247a6b 3x"}, "body": "ゆぐどら様、もう一度VTuberの沙汰ナキアさんを描いていただきたくご依頼させていただきました。10/9の3周年記念と、もうすぐ迎えそうな登録者33万3333人のお祝いを兼ねてナキアさんに贈りたいと考えています。\n\n【リクエスト内容】 \n・大喜びしてるポーズや表情でお願いします。\n・ドヤ顔の差分があったら嬉しいです。\n・青、紫、オレンジ色の薔薇を何らかの形で含めて欲しいです（手に持たせる、身につける、背景デザインにする等）\n・背景等のレイヤーが分かれているPSDファイルでの納品をお願いします。 \n・沙汰ナキアさん本人が活動の中でSNSやYouTube等でイラストを使用する許可もお願いいたします。\n\n前回お願いしたイラストがとても素敵だったので今回も楽しみにしています！\n\nhttps://drive.google.com/drive/folders/1ClHsJHvwZ4jomvIkKrE2EGrrkEw4QwW3?usp=sharing", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@ugugdon/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1624049, "client_id": 2949890, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/1854fc8e/uploads/origins/871e0e63-13d1-4