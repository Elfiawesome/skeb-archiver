ve/folders/1Ly-IYlximvJvpC6WhSHp4tG8c2MOhI-F?usp=sharing\n\n私の要望を検討していただけると大変ありがたいです。ありがとうございました。", "nc": 129, "word_count": 0, "transcoder": "video", "creator_acceptable_same_genre": true}, {"path": "/@dondontsuna/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "video", "tipped": false, "creator_id": 3176274, "client_id": 2485746, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/27b6ccf5/uploads/outputs/c0ae266a-43d3-48f3-a80c-c9258b857406?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&s=c2bb80e5d41197bf281bf3e8ef9b2ccc", "srcset": "https://si.imgix.net/27b6ccf5/uploads/outputs/c0ae266a-43d3-48f3-a80c-c9258b857406?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&s=c2bb80e5d41197bf281bf3e8ef9b2ccc, https://si.imgix.net/27b6ccf5/uploads/outputs/c0ae266a-43d3-48f3-a80c-c9258b857406?bg=%23fff&fm=webp&auto=compress&dpr=2&fit=crop&crop=top&w=200&h=200&s=48a7947136b4077fe4c4ce4755d6f0c9 2x, https://si.imgix.net/27b6ccf5/uploads/outputs/c0ae266a-43d3-48f3-a80c-c9258b857406?bg=%23fff&fm=webp&auto=compress&dpr=3&fit=crop&crop=top&w=200&h=200&s=7213c7b0b6d6b193d416b4993bd2a56f 3x"}, "duration": 12, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/27b6ccf5/uploads/outputs/c0ae266a-43d3-48f3-a80c-c9258b857406?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&blur=200&s=e3166ba3d267ae745c9cc691594d03aa", "srcset": "https://si.imgix.net/27b6ccf5/uploads/outputs/c0ae266a-43d3-48f3-a80c-c9258b857406?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&blur=200&s=e3166ba3d267ae745c9cc691594d03aa, https://si.imgix.net/27b6ccf5/uploads/outputs/c0ae266a-43d3-48f3-a80c-c9258b857406?bg=%23fff&fm=webp&auto=compress&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=db88366a21188a7287d21fa324872dc8 2x, https://si.imgix.net/27b6ccf5/uploads/outputs/c0ae266a-43d3-48f3-a80c-c9258b857406?bg=%23fff&fm=webp&auto=compress&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=7236986a058aea6af920fd0f8b507f8d 3x"}, "body": "おむ様 \n\nどうも初めまして、アピールいただきありがとうございます！ Xでの作品を拝見致しました、とても素敵なアニメーション作品だと思いぜひ私のアニメーションをご依頼させていただきたいです！\n\n【キャラクター設定』\n遠い星系からやってきたプラネットこと兼守護者です。性格は穏やかで優しい雰囲気の感じです。\n\n『依頼内容』\n配信前の待機画面で使用できるアニメーションですと嬉しいです。内容は：\n\nパソコン(Laptopを使います)の設定をしている\n↓\n画面の視線を気づき微笑んで喋る(もうちょっと待ってね...みたいな)\n↓\nパソコンの設定を続ける\n\nといった感じのループアニメーションは可能でしょうか。\n少し細かくなってしまい申し訳ございません。\n細かい構図等はお任せいたしますので、自由に描いていただければと思います。\n\n・画面サイズは1920×1080でお願いします\n\n・服装はオリジナルのままでも他のにしても構いませんのでお任せいただきたいと思います。\n\n『使用用途』\nSNSでの掲載、ヘッダー、サムネ、配信素材等も今後の活動に使用させていただければと思っております。 \n\n立ち絵資料は下記GoogleドライブURLを参照してください。 \nhttps://drive.google.com/drive/folders/1JScLaJQEZYDdotrWsPVZ9u-XCuDg_Q0P  \n\nご検討のほど宜しくお願い申し上げます。  \n\n星白真命 \n@HoshiroMamori\n\nhttps://drive.google.com/drive/folders/1JScLaJQEZYDdotrWsPVZ9u-XCuDg_Q0P", "nc": 144, "word_count": 0, "transcoder": "video", "creator_acceptable_same_genre": true}, {"path": "/@dondontsuna/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "video", "tipped": false, "creator_id": 3176274, "client_id": 573469, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/5aa95def/uploads/outputs/b2e6bab3-bfdd-48df-a927-7d3c5628b7f1?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&s=9958483342d395e8df8d5c4e32b5df01", "srcset": "https://si.imgix.net/5aa95def/uploads/outputs/b2e6bab3-bfdd-48df-a927-7d3c5628b7f1?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&s=9958483342d395e8df8d5c4e32b5df01, https://si.imgix.net/5aa95def/uploads/outputs/b2e6bab3-bfdd-48df-a927-7d3c5628b7f1?bg=%23fff&fm=webp&auto=compress&dpr=2&fit=crop&crop=top&w=200&h=200&s=d4516616f6b74afd5855b80a25888ccd 2x, https://si.imgix.net/5aa95def/uploads/outputs/b2e6bab3-bfdd-48df-a927-7d3c5628b7f1?bg=%23fff&fm=webp&auto=compress&dpr=3&fit=crop&crop=top&w=200&h=200&s=c4178fe5d6a70fa12741739de5ea180b 3x"}, "duration": 11, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/5aa95de