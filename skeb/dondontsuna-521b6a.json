のタイミングでヘルメットを外してもらうか、ヘルメットなしの別バージョンを添えてもらえないでしょうか。\n\nダークナイトのショーケースを入れておきます。https://youtu.be/UbM8UpPSkgA?si=5jjPCpTCKtaMQp3o\n\nまた、シャドウブリンガー（ノーブラント）の場所については、次元を超えて思いがけず連れて行かれることになるので、そのリファレンスも載せておきます。\n\nさっきも言ったように、これはストリームでも使うし、SNSでも使うし、将来的にはグッズにする可能性もある。\n\nもし過少であったり、詳細が足りなかったりしたら、私に分かるようにアピールしてほしい。\n\nhttps://drive.google.com/drive/folders/11SZisYBdFvs97twc8ycfERz38vG8ZgXw", "nc": 17, "word_count": 0, "transcoder": "video", "creator_acceptable_same_genre": true}, {"path": "/@dondontsuna/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "video", "tipped": true, "creator_id": 3176274, "client_id": 68662, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/e92ae10f/uploads/outputs/04f899a7-0977-4f7f-8e50-a6317d624b7b?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&s=848f01ccdeea3d85770158057f4c9c9a", "srcset": "https://si.imgix.net/e92ae10f/uploads/outputs/04f899a7-0977-4f7f-8e50-a6317d624b7b?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&s=848f01ccdeea3d85770158057f4c9c9a, https://si.imgix.net/e92ae10f/uploads/outputs/04f899a7-0977-4f7f-8e50-a6317d624b7b?bg=%23fff&fm=webp&auto=compress&dpr=2&fit=crop&crop=top&w=200&h=200&s=bf1ddfa5fdcb0b13a64734d10323beda 2x, https://si.imgix.net/e92ae10f/uploads/outputs/04f899a7-0977-4f7f-8e50-a6317d624b7b?bg=%23fff&fm=webp&auto=compress&dpr=3&fit=crop&crop=top&w=200&h=200&s=9dc4b44dfc85e56476ccbc9f5280eeb2 3x"}, "duration": 14, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/e92ae10f/uploads/outputs/04f899a7-0977-4f7f-8e50-a6317d624b7b?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&blur=200&s=5d443f6c79f746cff80b89df162c4408", "srcset": "https://si.imgix.net/e92ae10f/uploads/outputs/04f899a7-0977-4f7f-8e50-a6317d624b7b?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&blur=200&s=5d443f6c79f746cff80b89df162c4408, https://si.imgix.net/e92ae10f/uploads/outputs/04f899a7-0977-4f7f-8e50-a6