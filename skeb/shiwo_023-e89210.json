す。先輩のことが死ぬほど好きです。\n\n・シチュエーションや構図などはお任せします。NG事項はありません！並んでるだけでも大丈夫です！\nかしをさんのイラストはデフォルメ気味のものも等身のものもどちらもとっても可愛いのでどちらでも問題ありません！\n\n以上になります。是非よろしくお願い致します。\n\nhttps://drive.google.com/drive/folders/1lPDLTWzvgXCnabsRvzbWPzBBjDaO9pIL", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@shiwo_023/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1076833, "client_id": 1153581, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/cf13d84c/uploads/origins/7348cdbe-3073-4719-b95a-9feb1cfa2d3a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4ac8766dae16e7e91f5dd1a1d35f02c4", "srcset": "https://si.imgix.net/cf13d84c/uploads/origins/7348cdbe-3073-4719-b95a-9feb1cfa2d3a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4ac8766dae16e7e91f5dd1a1d35f02c4, https://si.imgix.net/cf13d84c/uploads/origins/7348cdbe-3073-4719-b95a-9feb1cfa2d3a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=0bc47ecb747ec0bb2bb02a81c270d9eb 2x, https://si.imgix.net/cf13d84c/uploads/origins/7348cdbe-3073-4719-b95a-9feb1cfa2d3a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=4857f6d7efd45ceff92173911119f965 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/cf13d84c/uploads/origins/7348cdbe-3073-4719-b95a-9feb1cfa2d3a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9226539def66d9c54a579d4ec2fff2a0", "srcset": "https://si.imgix.net/cf13d84c/uploads/origins/7348cdbe-3073-4719-b95a-9feb1cfa2d3a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9226539def66d9c54a579d4ec2fff2a0, https://si.imgix.net/cf13d84c/uploads/origins/7348cdbe-3073-4719-b95a-9feb1cfa2d3a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200