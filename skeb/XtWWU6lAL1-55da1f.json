れなくても、事前に十分検討済みです！実戦も知らない癖に…もっと教育が必要だったみたいね！！！｣\n\n\n以上のようなオーダーでお願いしたいです\nどうぞよろしくお願いします", "nc": 176, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@XtWWU6lAL1/works/5", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/ae0c52ed/uploads/origins/fe467b66-d3b9-420e-b798-2d1a80d4025b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=86e952cf6da2213ef58ce91dc5f39337", "srcset": "https://si.imgix.net/ae0c52ed/uploads/origins/fe467b66-d3b9-420e-b798-2d1a80d4025b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=86e952cf6da2213ef58ce91dc5f39337, https://si.imgix.net/ae0c52ed/uploads/origins/fe467b66-d3b9-420e-b798-2d1a80d4025b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=dce54cc737145bf2bdc0b77ac3246974 2x, https://si.imgix.net/ae0c52ed/uploads/origins/fe467b66-d3b9-420e-b798-2d1a80d4025b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=499d42f8efb86383d5dc8d7481f24013 3x"}, "private": true, "genre": "comic", "tipped": false, "creator_id": 3681972, "nc": 32}, {"path": "/@XtWWU6lAL1/works/4", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/aa052dc0/uploads/origins/8288638a-1d3c-4433-9a30-9ec17adb09d2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=858000fdbb3c6e44b0db5ead219ecc2a", "srcset": "https://si.imgix.net/aa052dc0/uploads/origins/8288638a-1d3c-4433-9a30-9ec17adb09d2?bg=%23fff&auto=format%2Ccompress&fm=webp&f