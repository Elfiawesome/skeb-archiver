命が宿っている差分\n・差分はレイヤーで切り替え可能にしてください\n\n金額内で不可能な場合は金額を再送してくださると幸いです\n\nよろしくお願いします\n\nhttps://drive.google.com/drive/folders/1-aU6Jy4i_0sVRLLUTig1DU3yvjRUiS1K", "nc": 49, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 21993, "creator": true, "nsfw_acceptable": false, "acceptable": false, "name": "青刃-ABSB-", "screen_name": "ABS17", "avatar_url": "https://pbs.twimg.com/profile_images/1524023126446981120/wE3n4C3H.jpg", "header_url": null, "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 5, "complete_expiration_days": 50, "skills": [{"genre": "art"}, {"genre": "correction"}], "nc": 48}, {"id": 475035, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "夢野ゆの💘💭", "screen_name": "yumenoyuno", "avatar_url": "https://pbs.twimg.com/profile_images/1859178760559636480/8YK1hvVK.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1259493136830586882/1769450684/1500x500", "appeal_receivable": true, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "art"}, {"genre": "correction"}], "nc": 129}, {"id": 1477472, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "Garan@ご依頼募集中", "screen_name": "Garan0502", "avatar_url": "https://pbs.twimg.com/profile_images/1941121191298969600/MGjjDg1E.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1426119128952180743/1751604987/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 5, "complete_expiration_days": 30, "skills": [{"genre": "art"}], "nc": 1}, {"id": 248082