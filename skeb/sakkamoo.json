n\n※藤堂志摩子におきましては、白競泳水着の上からアナルやアナルのシワが透けるように描写お願いします。\n\n\n５．表情を★絵とは異なり、３ｐの事後みたいな感じで涙目にしてうっとりさせて下さい。\n\n\n６．可能でしたら、PSDで各キャラや競泳水着尻を、出し入れ出来るように設定お願い致します。\n\n\nそれ以外はねんち先生にお任せ致します。\n何卒よろしくお願い致します。\n\nhttps://skeb.jp/@arikawa44/works/70", "nc": 177, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@sakkamoo/works/14", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/128407e6/uploads/origins/26a6a8c5-fc0c-491f-9d6c-8c9a1717c688?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=e4f593ca99eadfd58e5f0aed25b3050e", "src_set": ""}, "private": true, "genre": "art", "tipped": true, "creator_id": 25660, "client_id": 979742, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 128, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@sakkamoo/works/13", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 25660, "client_id": 2225188, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/845933fc/uploads/origins/d3799431-62ec-4f91-9d09-e53b4c27da0f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=876e5d09558a2fe315c8280cdc8e1377", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/845933fc/uploads/origins/d3799431-62ec-4f91-9d09-e53b4c27da0f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=1167943a555772ebe9b3b8540a327b53", "src_set": ""}, "body": "sakkamooさん、こんにちは！私の新しいVtuberと一緒にアートを注文しようと思っています。\nお好きなポーズを描いてください！\n\n私のVtuberのリファレンスはこちら : https://drive.google.com/drive/folders/1O0_5Awq-q0to-NZ4X0Y1Yonds6M1xQd5?usp=sharing", "nc": 177, "word_count": 0, "transcoder": "image", "creato