クが起こす問題を解決してしまう。  事情が普通でないため、ファウストはアイザックを監視するために一緒にいることにし、2人はあちこちを旅することになる。アイザックはファウストを信頼し、彼の言うことは何でも信じる。当初、ファウストはアイザックを盲目的に信頼するあまりに世間知らずすぎると思っていたが、結局は彼の楽観主義と優しさに惹かれていく。アイザックはファウストの手を握ったり、抱きしめたりする。\n\n自由に描いてください！服装の変更も自由です。\n問題があればキャンセルしてください。\nありがとうございました！\n\nhttps://sta.sh/22d6ciu20d4", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@trens_74/works/7", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/cec0fe72/uploads/origins/43ead98f-49cd-4661-8273-c87db279d509?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=42a97bd28304c6e5828a8bcdb35fea3b", "src_set": ""}, "private": true, "genre": "art", "tipped": false, "creator_id": 2437242, "client_id": 1514525, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 1, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@trens_74/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2437242, "client_id": 503490, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/aefbadb6/uploads/origins/52abc652-2190-48b4-93f6-d6423ed3147d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9433dc82839b6422b1051336f5d6316d", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/aefbadb6/uploads/origins/52abc652-2190-48b4-93f6-d6423ed3147d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5bdabc01cc2cc53c16d0fa963d069ce1", "src_set": ""}, "body": "こんにちは！私のオリジナルキャラクターの絵をお願いしたいです：\nhttps://sta.sh/2vpvw7clai6?edit=1\nミステリアスで芝居がかった魔法を使う怪盗です。\n色とりどりのそばかすがあり、肌、髪、目の色は参考資料と同じでお願いします。\nありがとうございます！\n\nhttps://sta.sh/2vpvw7clai6?edit=1\