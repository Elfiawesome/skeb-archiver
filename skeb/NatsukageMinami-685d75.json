uploads/origins/fc9d992c-9be2-4277-a4c0-830dacf1a389?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=fa648f791100c1377130776cc0263ecb 2x, https://si.imgix.net/047182a2/uploads/origins/fc9d992c-9be2-4277-a4c0-830dacf1a389?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=75683d04c1a3973df7ffbbc4a6d234ad 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/047182a2/uploads/origins/fc9d992c-9be2-4277-a4c0-830dacf1a389?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=4c6cf447c94759a5be9e399647a138a0", "srcset": "https://si.imgix.net/047182a2/uploads/origins/fc9d992c-9be2-4277-a4c0-830dacf1a389?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=4c6cf447c94759a5be9e399647a138a0, https://si.imgix.net/047182a2/uploads/origins/fc9d992c-9be2-4277-a4c0-830dacf1a389?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=3ca7bb8c6fc1365b8cf8642fd9eb93f3 2x, https://si.imgix.net/047182a2/uploads/origins/fc9d992c-9be2-4277-a4c0-830dacf1a389?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=1d5b71e3fa36a1461bf9993e703b40e4 3x"}, "body": "ミスキーの素敵なイラストを見て来ました。温かみのある色使いと優しい眼差しや笑顔が印象的でした。\nリクエスト内容は「お姉さんが両手を広げて迎えてくれる」感じのイラストをお願いします。\nもしよければですがメインとなる色は緑系統や青系統のイラストが見てみたいです。\nその他諸々はやりやすいようにお任せします。\nよろしくお願いします。", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@NatsukageMinami/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2880102, "client_id": 1354188, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/e1e08665/uploads/origins/4e244898-9c9e-46ad-885d-b1485646d583?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=586a4c139e95ccadc10f76b2a44b42d3", "srcset": "https://si.imgix.net/e1e08665/uploads/origins/4e244898-9c9e-46ad-885d-b1485646d583?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=586a4c139e95ccadc10f76b2a44b42d3, https://si.imgix.net/e1e08665/uploads/origins/4e244898-9c9e-46ad-885d-b1485646d583?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=0ac4187948c6afc3d7cc69b9908f5e49 2x, https://si.imgix.net/e1e08665/uploads/origins/4e244898-9c9e-46ad-885d-b1485646d583?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=babd3ea7091c24943c5a487e45ff37f2 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/e1e08665/uploads/origins/4e244898-9c9e-46ad-885d-b1485646d583?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=bc9998289f7656159e5a75b41a98ed26", "srcset": "https://si.imgix.net/e1e08665/uploads/origins/4e244898-9c9e-46ad-885d-b1485646d583?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=bc9998289f7656159e5a75b41a98ed26, https://si.imgix.net/e1e08665/uploads/origins/4e244898-9c9e-46ad-885d-b1485646d583?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=847ff23ce64408130a2d503dd28869d8 2x, https://si.imgix.net/e1e08665/uploads/origins/4e244898-9c9e-46ad-885d-b1485646d583?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=65b0330abd5545ca2803b8f67cb5616c 3x"}, "body": "みなみ様\n\n　初めまして、なしと申します。丁寧かつ温かいアピールをありがとうございました。創作も詳細まで目を通して頂けてとても嬉しいです。是非ご依頼させて頂ければと思います。\n\nキャラ：\n・秋人と美桜、夏野と冬馬のカップリング(以下CP)。全員仲良しで、男性三人は幼馴染。詳細は資料URL参照\n　願います。量が多く流し見程度で構いません。\n\n依頼内容：\n・キャラを気に入って頂けていたので、可能なら四人の中から二人組か、四人全員の「楽しそう、幸せそう\n　な、生き生きとした」シチュ絵をお願いしたいです。ペアはCPでなくとも、みなみ様の好きな組み合わせで　\n　よいです。事前にキャラ一人の構想があればそちらを優先して頂いて問題ないです。\n・「楽しそう、幸せそう」について。怒っていたり、相手をいじっていたり、見ていて仲がいいなと感じる絵\n　を、自由に描いて頂けるとありがたいです。\n\n・CPを表現する場合はそれぞれの近くに配置したり、少し照れつっけんどんになる等、簡単な程度で問題あり\n　ません。恋人らしくハグや互いに触れあっていても嬉しいです。CPに抵抗があれば「仲の良いコンビ」と捉\n　えて頂けるとありがたいです。\n\n・皆の表情が分かる様な構図だと嬉しいです。キャラと分かれば、表情やキャラ色、服装、髪形のアレンジ\n　等、全てお任せ致します。表現方法はできれば等身でお願いしたいですが、ミニキャラでも問題ありませ\n　ん。みなみ様の温かく優しいタッチを存分に生かして頂けますと幸いです。\n\n・負担が多いと思いますので塗り等はラフでシンプルなテイストでも問題ないです。\n\n・個人的嗜好で可能であれば、デフォルトでキャラの頬を少し染めて頂きたいです。\n・お手間でなければ、みなみ様が描いて感じたキャラに対する印象と、描いた際にこだわった点等を記載して\n　頂きたいです。(一言で構いません。創作物として感想が聞きたいという理由です)アナログで難しければ結\n　構です。\n\n作品用途：\n・自己観賞。創作で描いて頂いた設定等に触れることがあるかもしれません。　\n・SNSでみなみ様のクレジットを表記の上、依頼絵を掲載・紹介させて頂きたいです。\n\n飲めない要望は無視して下さい。みなみ様が考えられる金額相応のクオリティーで問題ありません。解釈違い等もないので楽しく描いて頂ければ幸いです。\n\nなし\n\nhttps://www.dropbox.com/scl/fo/bd6lsztko44ar3ww96r4g/ADaVnLs6u-Zjm7E5oxYZWXc?rlkey=od77vrtfa0jfmx8xsblbmad2r&dl=0", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [{"path": "/@freesiays006/works/12", "private_thumbnail_image_urls": null, "private": false, "genre": "correction", "tipped": true, "creator_id": 1535801, "client_id": 2880102, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/161db9a5/uploads/origins/a0dca1fc-7fbc-4dae-9758-c07e2eaafc47?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0671ca8979fac10e9371b7aa60532282", "srcset": "https://si.imgix.net/161db9a5/uploads/origins/a0dca1fc-7fbc-4dae-9758-c07e2eaafc47?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0671ca8979fac10e9371b7aa60532282, https://si.imgix.net/161db9a5/uploads/origins/a0dca1fc-7fbc-4dae-9758-c07e2eaafc47?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=eddff6749ed2581a9f3e9ed5c46cdcc9 2x, https://si.imgix.net/161db9a5/uploads/origins/a0dca1fc-7fbc-4dae-9758-c07e2eaafc47?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=6d6699cb7d58aa03eb3891451e0e6d2c 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/161db9a5/uploads/origins/a0dca1fc-7fbc-4dae-9758-c07e2eaafc47?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=61c41a2ff12e697f72a36675460213f5", "srcset": "https://si.imgix.net/161db9a5/uploads/origins/a0dca1fc-7fbc-4dae-9758-c07e2eaafc47?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=61c41a2ff12e697f72a36675460213f5, https://si.imgix.net/161db9a5/uploads/origins/a0dca1fc-7fbc-4dae-9758-c07e2eaafc47?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=84f69a308d2894f6992327e017a005bb 2x, https://si.imgix.net/161db9a5/uploads/origins/a0dca1fc-7fbc-4dae-9758-c07e2eaafc47?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=d32a36ec09c86b1a7f54875e10de0fe8 3x"}, "body": "なし様\n\nmisskeyやXで、いつもお世話になっております。みなみと申します。\n\n昨年は、『桜夏秋冬』のリクエスト本当にありがとうございました！\n絵を気に入っていただけて、とっても嬉しかったです！！\nまた、沢山の有難い褒め言葉をいただき、幸せな気持ちになりました。\nあのとき、なし様の『ここすきっ』にとっても励まされ、それからは自分の絵に自信がもてるようになりました…！\n\nなし様が『ここすきっ』のskebのアドバイスを始めたことを知ってから、「リクエストさせていただきたい…」と思っていたのですが、「どの絵にしよう…」と悩んでいました。悩んだ結果、昨年完成したこちらの絵をリクエストさせていただきました。\n「初めてのリクエストは、なし様がいい！」と強く思いまして…！！\n\nこちらのイラストのアドバイスをお願いいたします。\n「グリムノーツ」というゲームのキャラクターで、「シャルル・ペロー」さんというお名前です。\n彼には大事な仲間がいて、私もその人たちが大好きなので、こちらのシャルルを含め「肖像画シリーズ」なるものを描きたいなと思ってます。\nただ、人数が多くて、描き始める前から構図などに悩んでしまってペンが止まっている状態です…。\n\nやる気がほしいです…。\n\nそこで、なし様の『ここすきっ』を思い浮かべました。もし、お褒めいただけたら、嬉しくて元気になって…きっと、創作意欲に繋がるに違いないと思い、リクエストさせていただきました…！\nなし様の『ここすきっ』や気に入ったところなど、ご感想をいただけましたら、とても嬉しいです。\n\n工夫したポイントは、\n・彼はとても仲間思いな人なので、優しい表情になるようにと意識して、あたたかな雰囲気にしました。\n・色鉛筆で描き、Photoshopで、人物や背景に水彩で色を重ねました。人物は肖像画風にしたかったので、厚塗りを意識しました。人物が暖色系なので、背景をしっかり描いてしまうと絵が重くなってしまうと思い、背景は、ぽんぽんと色を軽く乗せ、ふんわりと仕上げました。\n\nなし様のお時間に余裕がございましたら、リクエストを受けて下さると幸いです。\n長文失礼しました。\nリクエストやファイルの添付の仕方も初めてなので手探り状態で、至らない点が多いと思いますが、どうぞよろしくお願いいたします。\n\nhttps://www.dropbox.com/scl/fi/wafxlbm7u3xqlkppdngv5/.png?rlkey=oqkmk2s3b86nyepw5wiyhk4io&st=asyinqxu&dl=0", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "similar_creators": [{"id": 827497, "creator": true, "nsfw_acceptable": false, "acceptable": 