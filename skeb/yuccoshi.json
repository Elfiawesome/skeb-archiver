works": [{"path": "/@yuccoshi/works/20", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 15408, "client_id": 0, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/9a5e0628/uploads/origins/8d07dda0-b0c8-46ad-a12c-f555b67fd3b9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=047a9c0e38f4414d240874890aecafc4", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/9a5e0628/uploads/origins/8d07dda0-b0c8-46ad-a12c-f555b67fd3b9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3ce9aea647a81d679b1bfc1a5e92d357", "src_set": ""}, "body": "こんにちは！友人に勧められてファイナルファンタジーのアートワークを依頼しました。FF11を20年近くプレイしています。好きなジョブはレリックアーマーを装備したエルヴァーンビーストマスターです：\n\nhttps://imgur.com/gallery/ffxi-bst-screenshots-ySAf9aY\n\nクーリエのカニペットとエルヴァーンビーストマスターのアクションポーズが好きです。\n\n理想としては、あなたの作品を額に入れてオフィスに飾りたいです。また、FFXIAH.comのウェブサイトのプロフィール写真としても使わせていただきます。  それに応じて価格を調整したり、上げたりするのはご自由にどうぞ。\n\nありがとうございました！\n-イッサ\n\nアメリカ、ニューヨーク州ブルックリン", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@yuccoshi/works/19", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 15408, "client_id": 3359544, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/f8613994/uploads/origins/b2b0c7c3-2670-4f13-b0f0-b945a6bc0ff5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ee9dfb157af4a143205f52d8fac29a5f", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/f8613994/uploads/origins/b2b0c7c3-2670-4f13-b0f0-b945a6bc0ff5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0d5e07823dab7eed62755a26b44736c5", "src_set": ""}, "body": "こんにちは！僕のイラストの依頼を引き受けてくれると嬉しいな。  \n\nファイナルファンタジー11のミスラ、フェイス8Bを描いてください。  彼女は騎士の仕事をしています。   髪の色をピンクにしました。  装備の参考画像を添付します。\n\nポーズはおまかせしますが、「この子を守りたい」という気持ちが伝わってくるような絵にしたいです。  でも、彼女もあなたを守りたいのです！\n\nありがとうございました！\n\nhttps://imgur.com/a/ndB012U", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@yuccoshi/works/18", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 15408, "client_id": 8065, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/75b34063/uploads/origins/4e28e85d-781c-4b56-b066-1e42c9ec6459?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=79eb01910bba689348f6fa33634b4a0d", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/75b34063/uploads/origins/4e28e85d-781c-4b56-b066-1e42c9ec6459?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6c42acde730b70c7868db2a3464ee72d", "src_set": ""}, "body": "ゆっこし様、こんばんは。\n前回（３年前）は素敵なエルメスのイラストを誠にありがとうございました！\n今回はFF14のほうの自キャラで恐縮なのですが、リクエストさせてください。\n\nキャラは黒髪黒目・ショートポニテのヒューラン女子です。左目尻にほくろがあります。\n（FF11のヒューム女子F1・もいんちゃんのイメージで差し支えございません）\n詳しい容姿と衣装につきましては、別添資料もご参照いただければと思います。\n（資料では前髪で左目が隠れ気味ですが、前髪を減らして顔が見えるようになると嬉しいです･･･）\n\n構図等は、自由にお任せいたします。\nもし悩まれた際は、短剣を二刀流で忍者風に抜刀し構えているポーズ、\nあるいは、短剣を持たずにモンク風に格闘の構えのようなポーズで大丈夫です。\n可能であればマスクあり／なしの差分をお願いいたします。\n\n蛇足ですが、別添資料が衣装を描く資料として不足していた場合に備えて装備名も記載いたします。\n　短剣：ミスリルバゼラード\n　頭：メセイル\n　胴手足：ダークライト・ストライカーコースリット\n　（胴の構造はスコハネに似てるかもしれません）\n　脚：シパーヒサルエル\n\nもし描きづらそうな場合には、リクエストキャンセルでも大丈夫ですので、\nぜひ、軽い気持ちでご検討ください。\n（改めてFF11方面でまたリクエストさせていただきます！）\nどうぞよろしくお願いいたします。\n\nhttps://i.gyazo.com/83472fd68976966d29b883e8d3c82ec0.jpg", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@yuccoshi/works/17", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 15408, "client_id": 0, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/d7956283/uploads/origins/90d6e9a3-e7c8-45f5-8035-fd095fe15679?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=581b34383c57aea86940e56167572151", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/d7956283/uploads/origins/90d6e9a3-e7c8-45f5-8035-fd095fe15679?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=8579464f28cc15a5a392a5d8987183d6", "src_set": ""}, "body": "キャラ：ミスラF8B\n装備：ミスラセパレーツ\nポーズ：資料の神絵師の方のF8Bさんのイラストを参考に、グラビア～ンで引き締まったウエストから腰ふともものラインが楽しめるような感じのポーズ\n\n\nご検討のほどよろしくお願いします！\n\nhttps://twitter.com/yuccoshi/status/646423275690676224/photo/1", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@yuccoshi/works/16", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/8d18be60/uploads/origins/22881ab5-1c08-40ad-9d04-fa556a1704d9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=118c6f6a136bf7be7bf91d674a0d3a23", "src_set": ""}, "private": true, "genre": "art", "tipped": true, "creator_id": 15408, "client_id": 0, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 145, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@yuccoshi/works/15", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 15408, "client_id": 113656, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/7ef8e168/uploads/origins/2fa3906f-dd19-4155-aab5-12fff5b40004?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c1e1dba754d30c925a05c1d6d0951183", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/7ef8e168/uploads/origins/2fa3906f-dd19-4155-aab5-12fff5b40004?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0f72d88f22f970db6f2c583672b8ac30", "src_set": ""}, "body": "どうも初めまして ゆっこしさん　アグレットです。\n素敵な褐色ミスラを見て\n今回はうちの子クルエノを描いて頂きたく依頼しました。\n\nクルエノは例えるならFFのモンクで\n満面の笑顔で戦う子だと思っていただければわかりやすいと思います。\nポーズはお任せいたします\n服は資料の「攻の型」で素敵な腰付きとホットパンツを\nお願いしたいと思っております。\n\nよろしくお願いします！੯´｀\\\n\nhttps://www.pixiv.net/artworks/105645402", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@yuccoshi/works/14", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 15408, "client_id": 18708, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/e0983a9a/uploads/origins/90feadf6-6bc2-42c3-8034-ca2d4b609f7a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e65a7c2397e7c8931d3b53b8a08b7706", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/e0983a9a/uploads/origins/90feadf6-6bc2-42c3-8034-ca2d4b609f7a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=adb1fa1cfb465450245dbad078536ff7", "src_set": ""}, "body": "こんにちは。\n\n私の2人のOCのアートをお願いしたいのですが。\n\nhttps://drive.google.com/drive/folders/1o5wVZm2_d96skaWohudJzxVatK2kXtGI\nhttps://drive.google.com/drive/folders/1LUJ26pW96iTvWvY3kWxSPn5rqCq_vNWi\n\n服装の参考:\nhttps://skeb.jp/@mi_na_mi_0619/works/9\nhttps://skeb.jp/@Saori_Kudou_/works/24\nhttps://skeb.jp/@syougaslice/works/7\nhttps://skeb.jp/@AoyuzuAoyuzu/works/18\n\nDIAはメロディーより少し背が高く。DIAはクールなお姉さんという雰囲気で、メロディーはちょっとおてんば娘という感じです。メロンパンを食べながらコーヒーを飲んでいるシーンをお願いしたいです。ゆっくりとした朝の雰囲気になるはずです。\n\nご自由に描いてください。先生にとってかっこいいシーンであればうれしいです。\n\nご検討よろしくお願いします。", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@yuccoshi/works/13", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 15408, "client_id": 177871, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/81b1d19e/uploads/origins/532bff12-8d65-4b73-975f-856f77028a4a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8f1cd3bd8c8b440b070dbcb49095bb4a", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/81b1d19e/uploads/origins/532bff12-8d65-4b73-975f-856f77028a4a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=744789b68d6a651931c6dc8a05fc83e2", "src_set": ""}, "body": "先生、改めましてこんにちは！ 前回あなたがしてくれた仕事が大好きです！ また「ハーゼル」を描いていただき、今回はパートナーの「ソング」と一緒に描いていただけると嬉しいです！ 一緒に料理している2人を自由に描いてください！ 素晴らしい作品をありがとうございました！\n\nhttps://imgur.com/a/Xlc7Xjz\n\nhttps://imgur.com/a/QsJIXPV\n\nhttps://imgur.com/a/EjoTWld", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@yuccoshi/works/12", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 15408, "client_id": 1326651, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/8c8a639a/uploads/origins/fc9057b0-7a72-4998-97dd-bcaa955b21a1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0907c787d98c15637e4494a70118778a", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/8c8a639a/uploads/origins/fc9057b0-7a72-4998-97dd-bcaa955b21a1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6af84dc485fd6d3af85938a0e4c7aa23", "src_set": ""}, "body": "ゆっこし様こんにちわ\n最近のツイッターでの〇曜日のミスラを見て、これはっ！と思いマイキャライラストのリクエストさせていただきました。\n\n最近のskeb作品の様に、\n前面にエントロピーをクールに撃ってるように見える闇曜日の暗黒ミスラ\n背景に、ブドウ大福をもぎゅもぎゅ食べて至福な表情の光曜日の暗黒ミスラ\n光と闇が合わさってジョブが暗黒に見えないこともないアンバランスな感じにしていただけたら嬉しいです。\nマイキャラには軽いつり目設定があります。\n\n装備やモーションなどを資料URLに添付いたします。\n\n可能であればおまけでラフなどもPSDファイルに入れて頂けたらと思います。\nPCの壁紙にしたいので16:9の横長のアスペクト比でお願いいたします。\n\n承認いただけたらとてもとても嬉しいです。\nお時間ありましたらどうぞよろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/1shq09Wqc-9RStHVXLLEdeJlUzKsvBOcE?usp=sharing", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@yuccoshi/works/11", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 15408, "client_id": 1372818, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/5dd2a4f7/uploads/origins/9750c7d8-2a3c-42d6-be41-c1d63436fd18?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8849b4f3981cb14d7e6d271d6b0aa978", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/5dd2a4f7/uploads/origins/9750c7d8-2a3c-42d6-be41-c1d63436fd18?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=fd838f70b37e221ff2df8aebde822245", "src_set": ""}, "body": "こんにちは。私のイラストの依頼を受け入れてくれると嬉しいのですが。\n\nFFXIのミスラ、顔7Aを描いてください。装備の参考画像も添付しておきます。彼女はウォーリアーのジョブにいます。\n\nポーズはお任せしますが、できれば決意を固めつつも可愛らしい表情でお願いします。理想は、強敵との戦闘や今まさに戦おうとしているところで、大斧を構えているところです。ありがとうございました。\n\nhttps://imgur.com/a/D5btosL", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@yuccoshi/works/10", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 15408, "client_id": 694312, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/860db8ae/uploads/origins/a44bb085-a67d-4e4b-b739-ddd056a4c20b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b85f7009f3ee926df072580c80801ea7", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/860db8ae/uploads/origins/a44bb085-a67d-4e4b-b739-ddd056a4c20b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2353c5460af9c2960c14fdea9f84b65d", "src_set": ""}, "body": "はじめまして。素敵な絵でいつもFF11を懐かしんでいます。\n\n早速ですが、今回はFF14のうちの娘でのリクエストです。\n\n・FF11のシーフAF1のローグ装備を頭以外で一式\n・ホーネットニードル系統の青いダガーか盗賊のナイフを二刀流(雰囲気に合わせてどちらかを二刀流で)\n・低姿勢で今にも素早く切り込みそうなポーズ\n\nその他の詳細はおまかせしますが、ゆっこしさんの描かれていたこちらのような雰囲気がほしいです。\nhttps://twitter.com/yuccoshi/status/1089675532323549184?s=20&t=MmheuFtZqhCwwZ6Mlu6c3Q\n\nお願いします。\n\nhttps://photos.app.goo.gl/eQF83nt2fLAFsoLK9", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@yuccoshi/works/9", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 15408, "client_id": 573595, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/d25191f5/uploads/origins/23f770d2-135a-436c-8e49-6d418d70e8cd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f0bee001a478bc43c1fa97cf60c9c7b7", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/d25191f5/uploads/origins/23f770d2-135a-436c-8e49-6d418d70e8cd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e4c86b7656369b47d5cd36d20f8593ff", "src_set": ""}, "body": "いつも素敵なミスラさんをありがとうございます。\n早速ですが、以下でイラストをお願いいたします。\n\nミスラ F6BでLサイズ。\n装備はスコハネ、赤AF1の脚、赤AF2の手と足、ジュワユース、スパイクバックラーで。\nオリジナルと異なってしまいますが、スコハネはSSのように腰左右パーツを外してもらえますでしょうか。\n\n■スクリーンショット\nhttps://drive.google.com/drive/folders/1gzXRA160JLmdRdavsCrmYvVj46dBb9Np?usp=sharing\n\nポーズ・構図はおまかせしますが、スコハネと脚装備の魅力が引き立つような感じだと嬉しいです。", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@yuccoshi/works/8", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 15408, "client_id": 8065, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/0acfa2cd/uploads/origins/b0e27d26-0390-4d30-a0e9-3363756a9f58?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=864f8ad4888b8849d409172f655fed43", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/0acfa2cd/uploads/origins/b0e27d26-0390-4d30-a0e9-3363756a9f58?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d7fcb821c0db0d140bbfbdb1943fd8f0", "src_set": ""}, "body": "はじめまして。ヴァナで冒険をしていた頃から素敵なイラストを拝見しておりました。\nよろしければ、FF11の自キャラ絵をリクエストさせて下さい。\n\n・エル♀（F1b)で、オリハルコンサイズを持った暗黒騎士をお願いします。\n・アレスキュイラス（頭以外）の上から、ボロボロの黒色のクロークを纏った姿\n　（死神をイメージした格好です。鎧は布の隙間から見えれば十分です）\n・フードは被っていても捲れていても大丈夫です。\n・右手で鎌を持ち、左手で暗黒あるいは暗黒魔法を漂わせるようなイメージ\n・ポーズや表情はお任せいたします。\n・作画コストが厳しければ（特に鎌や鎧の象嵌；）必要に応じて簡略化して頂いて大丈夫です。", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@yuccoshi/works/7", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/ec7158e5/requests/171518_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=24dcc5b1f93e97731675f2c23d66a6e9", "src_set": ""}, "private": true, "genre": "art", "tipped": true, "creator_id": 15408, "client_id": 812584, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 0, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@yuccoshi/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 15408, "client_id": 177871, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/0f5a2c52/requests/105090_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ac3c64f58e040c802077bda840862f4e", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/0f5a2c52/requests/105090_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=273f8144b0627bee722e5c3e0f0922d9", "src_set": ""}, "body": "https://twitter.com/_shunao/status/1188208731026317312\n\n彼女をあなたのスタイルで描いてください。 Twitterには#FOX絵を使用してください\n\nhttps://twitter.com/_shunao/status/1188208731026317312", "nc": 32, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@yuccoshi/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 15408, "client_id": 3462, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/2c2934ca/requests/104357_1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e05057a779ad53d9a5f7a88fbf99d7c0", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/2c2934ca/requests/104357_1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d029ae5d7fc3fe47e4ccc578b22e9c13", "src_set": ""}, "body": "こんにちは、もしよろしければFF14の自キャラにFF11のアクウィラ(冥護四衆)の装備で描いていただく事は可能でしょうか？帽子は無くても可、瞳の色は金、肌は薄い灰色です。https://ultimatemahamster.tumblr.com/", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@yuccoshi/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 15408, "client_id": 81953, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/75f84fde/requests/75120_1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6e4727054be33efe5db018e38727847c", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/75f84fde/requests/75120_1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=119b327d6de64571e99210c2d8188934", "src_set": ""}, "body": "はじめまして。\nFF14の自キャラをお願いしたく、リクエストさせていただきました。\nポーズ・構図はおまかせ、服装はFF11のなにかでお願いしたいです。\nアトルガン～アルタナ実装当初くらいが現役でした。\n11での思い入れのあるジョブはナ白狩シです。\n何卒よろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/1zr2iai8aX6Xmu2AMTPOluRLL0wiKq9BQ?usp=sharing", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@yuccoshi/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 15408, "client_id": 118783, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/b1d4bc46/requests/50014_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8ef4a511a1603db33a9d24a40bb8f978", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/b1d4bc46/requests/50014_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=44a9416b914b09bb42388b0052d67972", "src_set": ""}, "body": "こんにちは！イラストのリクエストです。\nFF11のミスラ狩人(2Bフェイス)\n装備はエンピリアン装束、難しいようでしたら通常のAFとアナイアレイター装備で\n銃口が見える斜め正面からのアングルで座りながら射撃した瞬間を！\nまたその時の衝撃でベレー帽が飛びそうになってると嬉しいです\n\nhttps://twitter.com/Nanaco_ff14/status/1233671858840469506?s=20", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@yuccoshi/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 15408, "client_id": 53522, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/b8f20ac6/requests/6134_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4ea8ecd941bb2f8e296339160b06c01a", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/b8f20ac6/requests/6134_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=528fdbf06563fc6943578ed02aad25e4", "src_set": ""}, "body": "初めまして！以前からあなたの絵が大好きで依頼をお願い致します。\nFF11のキャラクターでヒューム男F2の黒髪忍者と、ヒューム女F4黒髪踊り子の2人を描いていただけないでしょうか。\n服装はAF3か、ご無理な様でしたらお任せ致します。パートナーのような2人にしてもらいたいです。", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "similar_creators": [{"id": 786180, "creator": true, "nsfw_acceptable": false, "acceptable": false, "name": "wawa", "screen_name": "wawatiku", "avatar_url": "https://pbs.twimg.com/profile_images/1930047406810509316/scWjWE-1.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1316976623724318720/1729758706/1500x500", "appeal_receivable": false, "popular_creator_rank": 23, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 10, "skills": [{"genre": "art"}], "nc": 161}, {"id": 1185449, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "骨ニギー", "screen_name": "bone_Nig", "avatar_url": "https://pbs.twimg.com/profile_images/1957813613189820419/GJl4sjiK.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1238836529352433664/1719747141/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "skills": [{"genre": "art"}, {"genre": "comic"}, {"genre": "correction"}], "nc": 161}, {"id": 1607903, "creator": true, "nsfw_acceptable": true, "acceptable": false, "name": "すず森", "screen_name": "su2525_", "avatar_url": "https://pbs.twimg.com/profile_images/1625342421373689856/Y-oKuYYy.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1376907585974984708/1680129939/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 4, "skills": [{"genre": "art"}], "nc": 160}, {"id": 1870477, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "フツカ＠Skeb募集中", "screen_name": "queen_elicca", "avatar_url": "https://pbs.twimg.com/profile_images/1706688383190454272/v0qJjQBt