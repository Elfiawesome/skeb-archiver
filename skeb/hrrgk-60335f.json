リジナルキャラクターで、TRPG用のキャラになります。\n※資料中にシナリオのネタバレはありません\n\n■警察内の、狙撃に特化した特殊部隊（シナリオオリジナル）の二人組\n\n■茶髪の方が朗らかでほわほわした笑顔の可愛い優しいサポート上手な先輩（170cm34歳、食べるのが好きで大食漢だけれどもそれを恥ずかしがっている、食べ物を良く配ってくれる）と、\n■真ん中分けの方が生意気で意地悪なツンデレ後輩（171cm27歳、餌付けされている）のバディです！！\n後輩が素直な性格ではありませんが継続を重ねて気の置けない間柄です。\n\nサンプルでは仕事用の制服が多いですが仕事以外でも出かけたりごはんを食べに行ったりいたしますので、服装、構図等全てお任せいたします！先輩が嬉しそうだと嬉しいです！\n\nシナリオ名：若鷲の双眸\n\n御多忙のこととと思います、もし今回は見送りであってもお気になさらずどうぞ！いつもイラスト楽しく拝見しております🌸よきお絵かき＆TRPGライフをお送りくださいませ！\n\nhttps://drive.google.com/drive/folders/13eCyR3k7aTpLptT4CABllMOkGdl2YFb1", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@hrrgk/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3653962, "client_id": 153494, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/69b1e81b/uploads/origins/9f31ee82-ce97-4ac6-b1db-7b84b7033d85?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c3b2b37f460106794d67efd62eea5960", "srcset": "https://si.imgix.net/69b1e81b/uploads/origins/9f31ee82-ce97-4ac6-b1db-7b84b7033d85?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c3b2b37f460106794d67efd62eea5960, https://si.imgix.net/69b1e81b/uploads/origins/9f31ee82-ce97-4ac6-b1db-7b84b7033d85?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=bc75a7e242600b1867d8985d3035ce0c 2x, https://si.imgix.net/69b1e81b/uploads/origins/9f31ee82-ce97-4ac6-b1db-7b84b7033d85?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=468ca02cc48cdd181bea418bea27169b 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/69b1e81b/uploads/origins/9f31ee82-ce97-4ac6-b1db-7b84b7033d85?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=492899cc54678d16bdbcee98f4d8b149", "srcset": "https://si.imgix.net/69b1e81b/uploads/origins/9f31ee82-ce97-4ac6-b1db-7b84