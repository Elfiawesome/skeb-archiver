eceived_works": [{"path": "/@nanaisawa/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3760420, "client_id": 3796010, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/957b6c53/uploads/origins/72ed7bf8-ba4e-4820-b763-5ef06c215206?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=24e8ec364e36cad42e79be8bb50d06d4", "srcset": "https://si.imgix.net/957b6c53/uploads/origins/72ed7bf8-ba4e-4820-b763-5ef06c215206?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=24e8ec364e36cad42e79be8bb50d06d4, https://si.imgix.net/957b6c53/uploads/origins/72ed7bf8-ba4e-4820-b763-5ef06c215206?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=d0a1e7beb0e07ac3e840ed14ac038d86 2x, https://si.imgix.net/957b6c53/uploads/origins/72ed7bf8-ba4e-4820-b763-5ef06c215206?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=35dedcee6b72bbaef49f2059fcc3d742 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/957b6c53/uploads/origins/72ed7bf8-ba4e-4820-b763-5ef06c215206?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=61e3783a257b62b42be1747ec54ecea5", "srcset": "https://si.imgix.net/957b6c53/uploads/origins/72ed7bf8-ba4e-4820-b763-5ef06c215206?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=61e3783a257b62b42be1747ec54ecea5, https://si.imgix.net/957b6c53/uploads/origins/72ed7bf8-ba4e-4820-b763-5ef06c215206?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=b3db85f136249d9cbe93023b836a4049 2x, https://si.imgix.net/957b6c53/uploads/origins/72ed7bf8-ba4e-4820-b763-5ef06c215206?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=35a44809322d674f87d4ad83ea5db661 3x"}, "body": "TRPG用に創作したキャラクターのイラストをお願いしたいです！\n容姿のイメージは参考画像の通りなのですが、特記事項としては\n\n・元々深緑色の髪色で短髪だったが、過度のストレス状態にさらされたことにより色が抜けていて、無気力ゆえに伸ばしっぱなしになっている。髪が短い間はサラサラストレートっぽかったけど伸びてきたらくせっ毛が発覚した、みたいなイメージ。\n（参考画像では色素が強いが、もう少し白髪だと嬉しい）\n・生気がなく、儚げ（「陰鬱」というよりは「無」）\n・片目は隠れているだけで、怪我をしていたりはしない\n・年齢は不詳だが、見た目年齢は24、5を想定\n\n特に髪のイメージが自分ではうまく表現できなくて妥協したので、七井沢さんの透明感のあるイラストではどう表現されるんだろうというところに興味があります！\n\n以前からイラストを拝見していたので、自分でこのキャラクターを描く時に七井沢さんの描かれるあの雰囲気を目指したい！という気持ちで描いていたのもあり、描いていただけたらとても嬉しく思います。\n\n構図や服装などはお任せします。\n（イメージがしにくい場合は、桜に攫われる的な文脈で灰に攫われるイメージでお願いします）\n\n個人観賞目的での依頼です。\n※立ち絵依頼ではありません\n（TRPGというワードを出しているのでもしかしたら行き違いが発生するかも、と思い。意味がわからなければスルーしてください）\n\n（参考画像が見れなかった場合の保険:https://x.com/kb_goji52/status/1980237606299599299?t=Ngz2s8YrnrycjCi-8T_1Ow&s=19）\n\nhttps://drive.google.com/file/d/1dpoawx2j-rz5u9zuy1QkMASBkO-1asEW/view?usp=sharing", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@nanaisawa/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3760420, "client_id": 3767096, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/2b5dce10/uploads/origins/43f93d1e-e411-4adb-9059-0ce549eaa1b1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0ad36c80b7e4680701b67047543eec9a", "srcset": "https://si.imgix.net/2b5dce10/uploads/origins/43f93d1e-e411-4adb-9059-0ce549eaa1b1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0ad36c80b7e4680701b67047543eec9a, https://si.imgix.net/2b5dce10/uploads/origins/43f93d1e-e411-4adb-9059-0ce549eaa1b1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=9f26336a1d4d7ab734216620e3c15f73 2x, https://si.imgix.net/2b5dce10/uploads/origins/43f93d1e-e411-4adb-9059-0ce549eaa1b1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d187d52ba5441d999477a9bb0b858860 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/2b5dce10/uploads/origins/43f93d1e-e411-4adb-9059-0ce549eaa1b1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ab43893da12cf5b05ae83e21ffc741c4", "srcset": "https://si.imgix.net/2b5dce10/uploads/origins/43f93d1e-e411-4adb-9059-0ce549eaa1b1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ab43893da12cf5b05ae83e21ffc741c4, https://si.imgix.net/2b5dce10/uploads/origins/43f93d1e-e411-4adb-9059-0ce549eaa1b1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=78e24e5d1b68e0fcb14a639487150296 2x, https://si.imgix.net/2b5dce10/uploads/origins/43f93d1e-e411-4adb-9059-0ce549eaa1b1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=915c56911c366e6691964ec18dc33d56 3x"}, "body": "こんにちは。\n\nプロフィール固定にあるアカウントから、二次創作も拝見させていただきましたが\nそのうち、ハーバリウム（テラリウム？）のようなイラストの色合いや雰囲気が、とても気に入っています。\nあの雰囲気を再度見られたらいいなと思いましたので、別モチーフのオリジナルとしてリクエストします。\n\n・テラリウムの中に入っている人物をお願いします（オリジナルで、造形は全てお任せ）\n・モチーフは海でお願いします（可能であれば、夜の海or深海のように暗め）\n・人物は眠るような表情だと有難いです。\n・個人観賞・SNS公開（作者クレジット有）目的です。\n\nよろしくお願いします。", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@nanaisawa/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3760420, "client_id": 518535, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/3750c44b/uploads/origins/d0dbf0d4-2f26-4d54-8a07-5f854f85938f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b760796dac891cdc82e0898cac4410d6", "srcset": "https://si.imgix.net/3750c44b/uploads/origins/d0dbf0d4-2f26-4d54-8a07-5f854f85938f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b760796dac891cdc82e0898cac4410d6, https://si.imgix.net/3750c44b/uploads/origins/d0dbf0d4-2f26-4d54-8a07-5f854f85938f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=8a4ca6482e1051495dd6853e1a831d8a 2x, https://si.i