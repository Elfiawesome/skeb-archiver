したら申し訳ありません。料金や資料、依頼文の内容について気になる点がありましたら、再送等対応いたしますので、お気軽にお知らせください。\nどうぞよろしくお願いします！\n\nhttps://drive.google.com/drive/folders/1NE_s1eNl1VYNktLbD_Z6rjclhHOFRv2s", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@mikan_battery/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3770556, "client_id": 3757802, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/17ca3538/uploads/origins/173738c4-6ec1-418f-addd-c33ef196afc4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=aa4e59d4be3c2a410dd42d1d722bcd49", "srcset": "https://si.imgix.net/17ca3538/uploads/origins/173738c4-6ec1-418f-addd-c33ef196afc4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=aa4e59d4be3c2a410dd42d1d722bcd49, https://si.imgix.net/17ca3538/uploads/origins/173738c4-6ec1-418f-addd-c33ef196afc4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=9f1f9040e52711a47fdcccefaa7b64d3 2x, https://si.imgix.net/17ca3538/uploads/origins/173738c4-6ec1-418f-addd-c33ef196afc4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=086c672defa9cd2c966bda0190243aed 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/17ca3538/uploads/origins/173738c4-6ec1-418f-addd-c33ef196afc4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3d5bf2a62c894550b7240f9a517f425f", "srcset": "https://si.imgix.net/17ca3538/uploads/origins/173738c4-6ec1-418f-addd-c33ef196afc4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3d5bf2a62c894550b7240f9a517f425f, https://si.imgix.net/17ca3538/uploads/origins/173738c4-6ec1-418f-addd-c33ef196afc4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=afa99e858c48b89b8e61f9574f289638 2x, https://si.imgix.net/17c