合背景透過の画像もお願いしたいです。\n\n\n指定が多くなってしまい大変申し訳ないです。\nもし可能であれば是非よろしくお願いいたします。", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@haco_mori3/works/8", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 253014, "client_id": 1316597, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/c93af6fa/uploads/origins/ab1d5aec-931d-435b-a9b4-28d8cce826ee?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b82e908fa43fff03eb24ab4bf0c9997f", "srcset": "https://si.imgix.net/c93af6fa/uploads/origins/ab1d5aec-931d-435b-a9b4-28d8cce826ee?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b82e908fa43fff03eb24ab4bf0c9997f, https://si.imgix.net/c93af6fa/uploads/origins/ab1d5aec-931d-435b-a9b4-28d8cce826ee?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=41570b10673cf418a96efea8c9bcd8eb 2x, https://si.imgix.net/c93af6fa/uploads/origins/ab1d5aec-931d-435b-a9b4-28d8cce826ee?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=438051b47725ccd8634be33505565107 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/c93af6fa/uploads/origins/ab1d5aec-931d-435b-a9b4-28d8cce826ee?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9aa7eeed7c3dc50edc0caa61b29c0b0e", "srcset": "https://si.imgix.net/c93af6fa/uploads/origins/ab1d5aec-931d-435b-a9b4-28d8cce826ee?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9aa7eeed7c3dc50edc0caa61b29c0b0e, https://si.imgix.net/c93af6fa/uploads/origins/ab1d5aec-931d-435b-a9b4-28d8cce826ee?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=af991b68bd087b102113fc5f3c95ee66 2x, https://si.imgix.net/c93af6fa/uploads/origins/ab1d5aec-931d-435b-a9b4-28d8cce826ee?bg=%23fff&auto=format%2Ccompress&fm