re": "correction", "default_amount": 500}], "acceptable_only_public": false, "tip_acceptable": true, "yearly_report_client_visible": false, "total_appeals_count": 0, "received_works": [{"path": "/@yonomoriakari/works/45", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 984043, "client_id": 1530478, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/09358672/uploads/origins/674cb811-9ad6-48db-9343-064638a0b0c6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4e98d6a2ef18d0fd2c299d59b12466c9", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": true, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/09358672/uploads/origins/674cb811-9ad6-48db-9343-064638a0b0c6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=401fad21a120809808d8b43171040b55", "src_set": ""}, "body": "今回もスタァライトの服ビリ絵をよろしくお願いします\n\n今までヒロピンや敗北寸前のシチュエーションだったのですが今回は叶美空ちゃんと露崎まひるちゃんの2人が強敵のコロスに打ち勝って喜ぶ感じでお願いします。\n\n二人共に服装はレヴュー服では無く海賊衣装でお願いします。\n\n美空ちゃんの衣装『https://static.wikia.nocookie.net/revuestarlight/images/b/b2/3020002_live2d.png/revision/latest?cb=20210405023521』　\n上はベストがボロボロでブラジャーも千切れておっぱいと乳首が丸出しで下もショーツが見える位破いてください。\nまひるちゃんの衣装\n『https://static.wikia.nocookie.net/revuestarlight/images/4/48/3050002_live2d.png/revision/latest?cb=20210405180255』\nまひるちゃんもブラジャーまでボロボロのおっぱいと乳首が丸出しでスカートもショーツが見える位破いてください。\n\n台詞差分も付けて欲しいです\n美空ちゃん『やったー！やりましたよ!!まひるさん!!』\n\nまひるちゃん『うん…やったね。美空ちゃん!!』\n\n今回もおへそをよろしくお願いします。注文が多くなってしまいすいません。", "nc": 58, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@yonomoriakari/works/44", "private_thumbnail_image_urls": null, "private": false, "genre": "comic", "tipped": true, "creator_id": 984043, "client_id": 0, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/a81f81c6/uploads/origins/c80838cf-fa4a-448c-a8e2-db87679c2d38?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ec6ffaee086c11acf022db2b86c9cfe7", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": true, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/a81f81c6/uploads/origins/c80838cf-fa4a-448c-a8e2-db87679c2d38?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0c0fdc2e9d2ea5c232444a2f5d94eaf2", "src_set": ""}, "body": "もし可能でしたら、レヴュー服を来た愛城華恋が無数の黒塗りの手に捕らえられ、縄で縛り上げられていく内容の漫画をお願いいたします。\n\n黒塗りの手について：https://skeb.jp/@yonomoriakari/works/33に出てくるような手だけの存在として描いていただきますようお願いいたします\n\n展開\n①無数の黒塗りの手に腕や脚を掴まれ、口も塞がれる華恋。\n②手首を後ろにねじり上げられ縄を巻かれる。胸や脚も同様に縄で縛られる様子を各部アップで。\n③体を縛り上げられた後に口にボールギャグを噛まされる華恋\n④床に転がされた状態で縄抜けを試みようともがく華恋の全身図(「ギシッ」のような縄が鳴る効果音とセリフとしてくぐもったうめき声もお願いいたします)\n\n衣装は上掛けのみが無い状態で他は靴も含めて完全着衣、はだけやスカートのめくれもなしでお願いいたします。\n\n体が完全に緊縛された状態のイメージ：https://www.pixiv.net/artworks/115760320\n縛り上げられていく過程のイメージ：https://www.pixiv.net/artworks/116217066\n\n以上です。何卒ご検討よろしくお願いいたします。", "nc": 58, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@yonomoriakari/works/43", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/e839b9d2/uploads/origins/b4e977ef-c03e-4b72-9e97-cbf48e72d931?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=9fae4885d86d78b8540ba8eb44571599", "src_set": ""}, "private": true, "genre": "art", "tipped": true, "creator_id": 984043, "client_id": 3572803, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 16, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@yonomoriakari/works/42", "private_thumbnail_image_urls": null, "private": false, "genre": "comic", "tipped": false, "creator_id": 984043, "client_id": 1530478, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/54a2e451/uploads/origins/8ceee030-a077-4f82-be54-e97404de1b65?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0025d7077395e17b3510bbf23364c62d", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": true, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/54a2e451/uploads/origins/8ceee030-a077-4f82-be54-e97404de1b65?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=cd334d7c68942ce6d5d45d26cc8adfb0", "src_set": ""}, "body": "今回もスタァライトの服ビリの漫画をお願いします\n\nシチュエーションは以前美空ちゃんのイラストで描いて貰った閃乱カグラ SHINOVI MASTER ‐東京妖魔篇‐1話の飛鳥の月光、閃光姉妹にされたヒロピンシーンを漫画で描いてほしいです。\n\nキャラはイラストの時と同じ叶美空ちゃんで服装も同じフロンティア芸術学校のレヴュー服でお願いします。\n\n入れてほしいシーン\n『https://livedoor.blogimg.jp/ryonamoon/imgs/e/1/e1816650.jpg』\n『https://livedoor.blogimg.jp/ryonamoon/imgs/2/b/2b1dba2b.jpg』\n『https://pbs.twimg.com/media/GWwiZ9Ba8AIWmHz?format=jpg&name=medium』\n『https://livedoor.blogimg.jp/ryonamoon/imgs/2/2/22d15557.jpg』\n『https://livedoor.blogimg.jp/ryonamoon/imgs/1/e/1ec29ef1.jpg』\n\n\n今回もおへそもはっきりと描いてくださると嬉しいです。よろしくお願いします。\nそして似たようなリクエストをしてしまい申し訳ございません。", "nc": 187, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@yonomoriakari/works/41", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 984043, "client_id": 86519, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/a4f23aea/uploads/origins/01ad05ea-b802-463a-9b9b-86cc76bd9a5a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3af70b1ee34506247ecd8555efb4b777", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": true, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/a4f23aea/uploads/origins/01ad05ea-b802-463a-9b9b-86cc76bd9a5a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=1864073f1956629372dbdfb90ecfd22a", "src_set": ""}, "body": "「激甘革命！マジパティ」のクリームパフ(白石玉菜ちゃん変身後)の服ビリイラストをお願いします。 なお縞パンのみ無傷かつ愛液で一部濡れている状態でお願いします。 その他全てお任せ致します。", "nc": 58, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@yonomoriakari/works/40", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 984043, "client_id": 1530478, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/7f06770d/uploads/origins/56bc6c06-3479-41d5-98c3-81400f78bff8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b6f4a3bfd608c6c68ebcdd486d5445be", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": true, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/7f06770d/uploads/origins/56bc6c06-3479-41d5-98c3-81400f78bff8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=78d1339cdcedba1d233e8e15e471e13a", "src_set": ""}, "body": "今回もスタァライトの服ビリのイラストを依頼させていただきます。\n\nシチュエーションはRe:キューティーハニーのOPの服ビリシーンで元ネタは乳首が隠れていますが乳首を両胸共にポロリしてください。表情も片目が開いた感じでお願いします。\n『https://livedoor.blogimg.jp/ryonamoon/imgs/0/6/06383f7e.jpg』\n\nキャラは露崎まひるちゃんで格好をスタリラの人魚姫の衣装でお願いします。\n『https://static.wikia.nocookie.net/revuestarlight/images/c/c7/1030012_live2d.png/revision/latest?cb=20210323181341』\n\n今回もおへそもはっきりと描いてください。よろしくお願いします。", "nc": 171, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@yonomoriakari/works/39", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 984043, "client_id": 2809074, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/813a3683/uploads/origins/e96cf267-f483-4346-be06-7defbcfcd308?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=856207952e496c512e47109072bf239a", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/813a3683/uploads/origins/e96cf267-f483-4346-be06-7defbcfcd308?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=bb94d16ff8432a4d2ded44f4f926db7b", "src_set": ""}, "body": "「ぴちぴちピッチ」の七海るちあ、宝生波音、洞院リナのペアイラストを描いていただきたく、三度リクエストをさせていただきました。\n構図については「ぴちぴちピッチピュア」の第39話で、変身したるちあ、波音、リナがドアを蹴破るシーンで、アニメでは見えなかったスカートの中のレオタードが丸見えになるようにお願いします。\n衣装は変身時のライブ衣装(二段変身前)で、可能であればスカート無しのレオタード絵差分もお願いします。\nキャラ配置は左側に波音、中央はるちあ、右側にリナ、表情は怒っている感じでお願いします。\n背景の有無はお任せします。\n構図の参考資料は、リンク先の画像に掲載していますので、そちらを参考にしていただけると幸いです。\n\nhttps://i.imgur.com/lrSS6hr.png", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@yonomoriakari/works/38", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 984043, "client_id": 0, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/79876b0d/uploads/origins/87c404e4-9dab-4fc3-862d-9864091c2d7f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=60603f9ba89c6aab14bff2e8f7e854e3", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": true, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/79876b0d/uploads/origins/87c404e4-9dab-4fc3-862d-9864091c2d7f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=06d736ef6f1793de27bba6ea83e08f2c", "src_set": ""}, "body": "下着水着チャレンジ(下着姿でプールや海に出る露出プレイの意)と称して砂浜を歩かされている伊地知虹夏(ぼっち・ざ・ろっく！)を描いてください。\n\n予算の範囲で構わないので下記の差分をお願いします。\n●一見すると水着と見間違えるデザインのもの\n●どう言い訳しても下着にしか見えないもの\n●下着であることも放棄してるようなスケスケ、もしくは布面積が極小のもの\n●何も身に着けていない全裸", "nc": 187, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@yonomoriakari/works/37", "private_thumbnail_image_urls": null, "private": false, "genre": "comic", "tipped": false, "creator_id": 984043, "client_id": 1530478, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/348205f3/uploads/origins/1533c523-0bf1-45d2-8a74-608a82804a77?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=738676a6c0319a2243831688426a35a7", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": true, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/348205f3/uploads/origins/1533c523-0bf1-45d2-8a74-608a82804a77?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=cde7ac7a5948ce706688608b44257d2c", "src_set": ""}, "body": "設定をミスをして間違えて全年齢対象にしてしまったので改めて送ります。\n\n以前、叶美空ちゃんのヒロピンのイラストの依頼をした者です。\n\n今度は美空ちゃんのヒロピンシーンの漫画を描いて欲しいです。\n\nシチュエーションはクイーンズブレイドグリムワール1話のザラとアリシアの戦闘シーンです。\nアリシアの役を美空ちゃんでザラ役をかぎ爪を装備したコロスでお願いします。\n\n参考資料で入れてほしいアリシアの服ビリシーンはこちらです。\n『https://livedoor.blogimg.jp/ryonamoon/imgs/a/a/aab03043.jpg』\n『https://livedoor.blogimg.jp/ryonamoon/imgs/e/9/e9660630.jpg』\n『https://livedoor.blogimg.jp/ryonamoon/imgs/a/e/ae7bb4b4.jpg』\n『https://livedoor.blogimg.jp/ryonamoon/imgs/9/d/9d415960.jpg』\n\n最後に涙目で『勝てない…強すぎるよ』呟いて気を失っていまうシーンで締めて欲しいです。\n\n美空ちゃんの格好は元ネタに合わせてスタリラのアリス衣装でお願いします\n『https://static.wikia.nocookie.net/revuestarlight/images/2/26/Alice_Misora_Kano.png/revision/latest/scale-to-width-down/1000?cb=20231125015923』\n\n前回のイラストと同じ様に美空ちゃんのおへそをはっきり描いてください。", "nc": 186, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@yonomoriakari/works/36", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 984043, "client_id": 1869675, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/cba367cf/uploads/origins/34ac8fbc-b8a0-4433-bc63-dc65d6b927ba?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=db6e833a18c2bd64fe4fb9abdb338b99", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/cba367cf/uploads/origins/34ac8fbc-b8a0-4433-bc63-dc65d6b927ba?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=bc1fec86f9a739581d6856eae3fc99af", "src_set": ""}, "body": "こんにちは。リクエストを送らせていただきます。\n\nオリジナルキャラクターの「姫鶴（ひめか）」を描いていただきたいです。\n\n・ウェーブした白髪で、一房だけ赤\n・前髪はM字に盛り上がったセンター分け\n・まつ毛なども白っぽい\n・目はつり目。瞳はオレンジの混ざった赤。\n・右目の下に泣きぼくろがある\n・スタイルのいい美女。服装は、鶴のように白、赤、黒がメインにまとめられて