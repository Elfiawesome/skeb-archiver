fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=7ca340013fca6bec1f75d1324eb021a1 2x, https://si.imgix.net/a8049a9b/uploads/origins/d30a8875-6b35-41f1-8362-ab25bd670d4f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=7e849996d653ccace961c3ce62871863 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/a8049a9b/uploads/origins/d30a8875-6b35-41f1-8362-ab25bd670d4f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6948f3488c559e5f73e56d75d7a6024f", "srcset": "https://si.imgix.net/a8049a9b/uploads/origins/d30a8875-6b35-41f1-8362-ab25bd670d4f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6948f3488c559e5f73e56d75d7a6024f, https://si.imgix.net/a8049a9b/uploads/origins/d30a8875-6b35-41f1-8362-ab25bd670d4f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=ecd9a846e7ee4297241b08605049f21a 2x, https://si.imgix.net/a8049a9b/uploads/origins/d30a8875-6b35-41f1-8362-ab25bd670d4f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=e4fd9ae9ba5bcd0c59c2a303238eff67 3x"}, "body": "こんにちは、ファンタジーキャラクターのポートレートをお願いしたいのですが。\n\nキャラクターはヨナといいます。彼は天使のパトロンのもと、修道院にいる若い大人の修道士です。修道院の目的は土地の歴史を記録することで、天使は修道士たちに土地から記憶を取り出し、トーテムマスクに鍛える魔法を教える。\n\nヨナは現場での仕事には熱心で有能だったが、天使は彼に修道院に留まり、若い入門者たちの家庭教師をするように命じた。ヨナは天使の命令を理解できなかったが、邪悪なドラゴンが大陸全体を破壊するまで従った。ヨナは奇跡的に生き延びたが、目的、修道院、パトロン、子供たちの笑顔などすべてを失った。トーテムの魔法は、ヨナと彼の唯一の幸せな記憶をつなぐ最後のものだった。彼はこの地をさまよい始め、新しい仮面を作って嘆き悲しんだ。\n\nこのイラストは、暗い森の中でトーテムの仮面を持っている悲しく孤独なヨナをとらえようとしている。トーテム・マスクは緑色で、デュエル・マスターズに登場するツォルキン種族のクリーチャーをイメージしている。\n\nhttps://photos.app.goo.gl/ch16F4wy5zb85QQcA", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@aililith/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3456392, "client_id": 786547