edb-94ca-036637de585d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=32f3bff961c74ab13f98a5e90e61c7e0", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/8e55f085/uploads/origins/58fdef27-46fb-4edb-94ca-036637de585d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d587371fa82c142fcf1a034e32bbcfd5", "src_set": ""}, "body": "こんにちは！あなたの絵を見て、ぜひデッサンをお願いしたくなりました！^-^\n\n私のオーク、ベジークとローランを描いてくれませんか？ベジークは緑色の髪で、水晶技術の発明家です。ローランは茶色の髪で眼鏡をかけていて、戦争戦略家です。\n\n彼らのルックスについてはgoogle driveに参考資料があります！\n\nまだそんなに仲良しではないけど、二人の間にはロマンチックな緊張感があるんだ！トイハウスのプロフィールを送ります！もっと有益な情報があるはず - キャラクターに関するすべての情報をここに書くことはできないので！）とアートリファレンスはgoogle driveにあります！\n\n各キャラクターの全身サイズなど、好きなように描いてください！^-^\n\nよろしくお願いします！\n\nhttps://toyhou.se/11661368.bezykard-dorenga\nhttps://toyhou.se/11662181.laurent-de-attele\n\nすべての参考文献\nhttps://drive.google.com/drive/folders/1BCVy3qt9M8Quo-_oJNe54R2qPJNkVS_Q\n\nhttps://drive.google.com/drive/folders/1BCVy3qt9M8Quo-_oJNe54R2qPJNkVS_Q", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@ichiyo_ill2/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3580237, "client_id": 3277942, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/0be0b297/uploads/origins/c7c098a5-e547-497e-85aa-3cd3c33cddab?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=cd73e07d0c22366fc60fe8f030d4e39e", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/0be0b297/uploads/origins/c7c098a5-e547-497e-85aa-3cd3c33cddab?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=83a3042779f32c22e35999b86cfead03", "src_set": ""}, "body": "はじめまして！\nツイート拝見しリクエストさせていただきました。\n\nTRPGゲームにて使用する等身全身立ち絵をお願いしたいです。\n\n資料服装に関しましてはイメージですので、お好きに変えていただいて構いません。\nピンク髪の子が青髪の子の腕に一方的に腕を絡めている立ち絵になると嬉しいですが、難しければおまかせします！\n\n下記URLのyarazunoameというシナリオにて遊んだキャラクターです。\n青髪：売れないバンドマン（ベースボーカル）\nピンク髪：メジャーデビューが決定したバンドマン（ギターボーカル）\nhttps://booth.pm/ja/items/5216040\n\n可能であれば1人ずつ人物が分けされたPNGまたはPSDデータですとありがたいです！\n\nPicrewというサイトにてお顔と、\nboothの立ち絵素材にて参考画像作らせていただいています\n\n使用用途\n相方とのTRPG用立ち絵に使用します。\n\nどうぞよろしくお願いします。\n\nhttps://drive.google.com/drive/folders/1gvHlQZnQu4FvL8Rj_G956HgoUg3ssba4?usp=drive_link", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@ichiyo_ill2/works/6", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/7d921731/uploads/origins/a65937b6-b32c-44df-a12d-1fd6d2e8c28f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=9806122d35fcb9b0263a5e968a4c2889", "src_set": ""}, "private": true, "genre": "art", "tipped": false, "creator_id": 3580237, "client_id": 2797202, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 145, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@ichiyo_ill2/works/5", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/cde098fa/uploads/origins/2c22f53f-e19c-4735-9e36-95cfe3e0e3fd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=bfbc414a4b79e02bb917f01c19a25f99", "src_set": ""}, "private": true, "genre": "art", "tipped": false, "creator_id": 3580237, "client_id": 3469061, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 17, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@ichiyo_ill2/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3580237, "client_id": 3527686, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/0a36ab8c/uploads/origins/db1472c6-ae14-4f86-b03d-e741d3b2e4b5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3059ceedb80947c70b697ef2a89b0c96", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/0a36ab8c/uploads/origins/db1472c6-ae14-4f86-b03d-e741d3b2e4b5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e6af9ac2432f24d65fef6997aa100f99", "src_set": ""}, "body": "こんにちは！私のocを描いてくれませんか？\n\n[優・162cm】です。］\nヒールを履いて170cm。優しくて柔らかい女の子ですが、不器用でちょっと天真爛漫。瞳孔は星型。\n\n濃いグレーのスクールベストに膝丈の黒いスカート。ヒールのあるブーツにダークグレーのタイツ。黒い手袋もしている。\n\n全身イラストをお願いします。構図やポーズはお任せします！\n\n使用用途\n個人利用、SNSへの投稿、他のSkeb絵の参考に。\n\n最終的にはレイヤーを分けて描いてください。よろしくお願いいたします！\n\nhttps://drive.google.com/drive/folders/1HcskVsbs8eoVp95ePndDAhKv_re476OF", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@ichiyo_ill2/works/3", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/1d506ba1/uploads/origins/0c54992b-810a-4aa3-baf6-6aa837ef7205?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=23b6d796958ea855f1ca31567d13785a", "src_set": ""}, "private": true, "genre": "art", "tipped": false, "creator_id": 3580237, "client_id": 0, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 145, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@ichiyo_ill2/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3580237, "client_id": 3288607, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/848346c1/uploads/origins/6898db8b-9cc9-49d7-90dc-8123aaeaf537?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=680738cd4b2b8f64901ba97c896822bd", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/848346c1/uploads/origins/6898db8b-9cc9-49d7-90dc-8123aaeaf537?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=adda1ec951068d69fb72816d3cad79f4", "src_set": ""}, "body": "2度目まして！\n先程は本っっっ当に可愛くて素敵なイラストをありがとうございました！\nよめじです(*･ω･)*_ _)\n\nまだ納品されて間もないのですが…\nあまりにも素敵だったのでまたリクエストさせてもらいたく…！\n\n今回は\n【 創作うちよそ用の姿 】\nを男女2人分描いていただきたいのです！\n\n＿＿＿＿＿\n\n【 キャラ資料 】\n\n①男体\nhttps://x.com/_yomeji/status/1916856893227565200?s=46&t=hJ2QD1j0OLxoJCX5IgdJog\n\n②別世界線女体\nhttps://x.com/_yomeji/status/1916863319115530272?s=46&t=hJ2QD1j0OLxoJCX5IgdJog\n\n※どちらもリプに続いて2ツイート画像で資料があります\n\nこちらは配信アプリミラティブ(現在収益化しておりません)というところでのアバターで、\n公式からアバターの衣装参考や改変での二次創作＆利用許可が出てるものになります\n\n※念の為ガイドライン一応貼っておきます\nhttps://helpfeel.com/mirrativ/%E4%BA%8C%E6%AC%A1%E5%89%B5%E4%BD%9C%E3%83%BB%E4%BA%8C%E6%AC%A1%E5%88%A9%E7%94%A8%E3%81%AE%E3%82%AC%E3%82%A4%E3%83%89%E3%83%A9%E3%82%A4%E3%83%B3%E3%81%AB%E3%81%A4%E3%81%84%E3%81%A6-64ca32dff9a1c6001cf6ae4f\n\n＿＿＿＿＿\n\n今後おなじ配信サイトでのリスナーさんと\nうちよそ創作活動をする時用に\nアバター衣装を自分好みに整えたうえで\n同じクリエイターさんに同時に頼みたく\n2度目の依頼でした！(2人分の依頼料です)\n\n＿＿＿＿＿\n\n・今回も動きあるなし、構図等はまるっとお任せします！\n※ただし男体の方は少しある三つ編みが見える形だと助かります💦\n・男女それぞれの特徴を出したいので\n目の形(男横長、女まんまる)はそのまま表現してもらえると助かります！\n・髪色と瞳の色は中の人がおなじ設定なので同じ色で統一してください\n\n\n納品いただいたイラストは\n商用利用にはぜったいに使いません。\nメインは他の人に見せる資料用など利益が発生しない交流に使わせて頂く予定です\n\n\n＿＿＿＿\n\n男女それぞれ単体で使用したり\n並べて使用したりするかと思いますので\n\n・頭上や横髪など切れてない等身全身\n・背景透過\n\nでの納品をお願いします\n\n\nまたご縁がもしありましたら\nよろしくお願いいたします", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@ichiyo_ill2/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3580237, "client_id": 3288607, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/c04bbe73/uploads/origins/b3e3d24a-c6a0-49f2-b226-1c6cb8eed33e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1953bc5e6eb3beb6d14cafe587e37311", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/c04bbe73/uploads/origins/b3e3d24a-c6a0-49f2-b226-1c6cb8eed33e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c639e7b05fd64e878f8a96a206d1980d", "src_set": ""}, "body": "Twitter検索からきました\nよめじと申します！\n\n【 リクエスト 】\nコテキャの等身立ち絵\n\n【 内容 】\nhttps://x.com/_yomeji/status/1819074653195063480?s=46&t=hJ2QD1j0OLxoJCX5IgdJog\n\nコテキャ資料になります\n\n立ち姿や動きあるor無しはまるっとお任せします！\n「等身」「全身」だけはお願いしたいです！\n\nよく間違えられやすい点として\n・目にmっぽいハイライト必須\n・三つ編みはウルフカットの後ろ髪位置\nでおねがいします\n\n★上の白シャツ(特に首回りや腕部分)なんですが\nピッチリではなく少しゆとりある感じで表現してもらえると嬉しいです！\n\n\n使用用途としては\n・イラスト依頼での資料用\n・配信用サムネ\nに使うかもしれないので\n\n・背景透過納品\n・頭上や手先、横髪等切れないイラスト\nをお願いします\n(料金内可能なら表情差分あると嬉しいです！)\n\n\n料金や範囲外でしたら再送ではなく\nキャンセルで大丈夫です⭕️\n\nもしご縁がありましたら\nよろしくお願いいたします", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "similar_creators": [{"id": 1169610, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "こん", "screen_name": "kon_unko", "avatar_url": "https://pbs.twimg.com/profile_images/1904808575891103745/d7B7mz6P.jpg", "header_url": "https://pbs.twimg.com/profile_banners/848154824763768832/1665532510/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "skills": [{"genre": "art"}], "nc": 128}, {"id": 2259523, "creator": true, "nsfw_acceptable": false, "acceptable": false, "name": "彗", "screen_name": "kit_5m", "avatar_url": "https://pbs.twimg.com/profile_images/1196050979130503170/ch9HcE3O.jpg", "header_url": "https://pbs.twimg.com/profile_ba