rop=top&w=200&h=200&blur=200&s=1a69799fd814bb11ef7979a97bac1905", "srcset": "https://si.imgix.net/f46e1721/uploads/origins/eb2676a7-d291-4129-9510-9f09e529d2f7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=1a69799fd814bb11ef7979a97bac1905, https://si.imgix.net/f46e1721/uploads/origins/eb2676a7-d291-4129-9510-9f09e529d2f7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=cfabd3b3d5352eb2fba365419b43be66 2x, https://si.imgix.net/f46e1721/uploads/origins/eb2676a7-d291-4129-9510-9f09e529d2f7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=484bbf8b1d87dae64ef8182b0c8499a2 3x"}, "body": "初めまして、モコ先生にオリキャラの等身イラストを依頼させていただきたいです。\nオリキャラのデザインは参考資料をご覧下さい。帽子はクラゲモチーフ、髪の毛は内側だけグラデーションになっております。\n構図はたぬきを抱っこしている構図でお願いします！\n\n使用用途はスマホ画面の壁紙、SNSでのアイコン使用を考えております。\nよろしくお願いいたします。\n\n資料URLにあるGoogleドライブがもし開けなかったら下にあるTwitterのリンクでお願いいたします。\nhttps://x.com/aina_arei/status/1946453825113739462?t=APbZmcX3VK4rmRpbQ1PVuA&s=19\n\nhttps://drive.google.com/drive/folders/1FcBgQ4-Bt23eM5lP9c_vPt_bJmqOG1Qb\n\nhttps://drive.google.com/drive/folders/1FcBgQ4-Bt23eM5lP9c_vPt_bJmqOG1Qb", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@tanukicawaii/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "correction", "tipped": true, "creator_id": 647664, "client_id": 2278198, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/c3379357/uploads/origins/766f6cb7-7fd8-4bb4-98e4-ec055ceaf63b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f486b2bde7c18f66ee3e33634ebdd8cc", "srcset": "https://si.imgix.net/c3379357/uploads/origins/766f6cb7-7fd8-4bb4-98e4-ec055ceaf63b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f486b2bde7c18f66ee3e33634ebdd8cc, https://si.imgix.net/c3379357/uploads/origins/766f6cb7-7fd8-4bb4-98e4-ec055ceaf63b?bg=%23fff&auto=format%2Ccompress&fm=