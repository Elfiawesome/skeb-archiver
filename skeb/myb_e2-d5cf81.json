0A", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@myb_e2/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2113296, "client_id": 2107178, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/34ae5758/uploads/origins/82acf6bc-3465-4eed-97a3-35946d356ebb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d3348e4b9e33230767aedbe76a658bcc", "srcset": "https://si.imgix.net/34ae5758/uploads/origins/82acf6bc-3465-4eed-97a3-35946d356ebb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d3348e4b9e33230767aedbe76a658bcc, https://si.imgix.net/34ae5758/uploads/origins/82acf6bc-3465-4eed-97a3-35946d356ebb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=5465b64512cd34c10bfe1d041937d7f6 2x, https://si.imgix.net/34ae5758/uploads/origins/82acf6bc-3465-4eed-97a3-35946d356ebb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=56d1ba8c17b8333e1306bad674e9876f 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/34ae5758/uploads/origins/82acf6bc-3465-4eed-97a3-35946d356ebb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=66991d1fdf36b9923d97c92d5faa69b8", "srcset": "https://si.imgix.net/34ae5758/uploads/origins/82acf6bc-3465-4eed-97a3-35946d356ebb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=66991d1fdf36b9923d97c92d5faa69b8, https://si.imgix.net/34ae5758/uploads/origins/82acf6bc-3465-4eed-97a3-35946d356ebb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=8f8017dbec2f96294d6432d43c230ef2 2x, https://si.imgix.net/34ae5758/uploads/origins/82acf6bc-3465-4eed-97a3-35946d356ebb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=809c0ca4a4fb57fcdbe9952f2f1fcfdb 3x"}, "body": "Nice to meet you.\nI am very pleased to see your wonderful illustration.\nMy name is Yorase Natsu, a personal Vtuber.\n\nI saw your illustration of Miku on Twitter and thought it was very cute.\nI was wondering if you could draw an illustration of myself.\n\nI would like to use a mischievous smiling expression.\nI have three views of her on my fixed tweets on Twitter for your reference.\nhttps://twitter.com/N_yorise_V\n\nOther poses and compositions (full body, half body, etc.) are up to you.\n\nWe would like to use your illustration as a thumbnail for SNS or YouTube. (We will also write your name on the illustration.)\n\nTherefore, if possible, we would appreciate it if you could deliver the PSD file with the background and the person on a separate layer.\n(No background is also acceptable.)\n\nThank you in advance for your cooperation.\n\nhttps://twitter.com/N_yorise_V", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@myb_e2/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2113296, "client_id": 2146712, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/5acf7303/uploads/origins/0bf40806-e814-4326-bce3-b1619e9fb9c4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5d57a0892e04db7a67a2f243ea6f0349", "srcset": "https://si.imgix.net/5acf7303/uploads/origins/0bf40806-e814-4326-bce3-b1619e9fb9c4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5d57a0892e04db7a67a2f243ea6f0349, https://si.imgix.net/5acf7303/uploads/origins/0bf40806-e814-4326-bce3-b1619e9fb9c4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ea29d18c7e8245b74f9351529e34ad6c 2x, https://si.imgix.net/5acf7303/uploads/origins/0bf40806-e814-4326-bce3-b1619e9fb9c4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=1d660b856f738c3d0fb5c09a7097