852ccb/uploads/origins/43834a1b-3d15-4a9d-bfa5-11dd7f1f7d79?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=da6a3a069b0db410e89552cc17649872, https://si.imgix.net/99852ccb/uploads/origins/43834a1b-3d15-4a9d-bfa5-11dd7f1f7d79?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=289a894f821d36cbe10a0c6a6b29f5b1 2x, https://si.imgix.net/99852ccb/uploads/origins/43834a1b-3d15-4a9d-bfa5-11dd7f1f7d79?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=eca261c2506d7d9f69e6a5de031d32ed 3x"}, "body": "Hello, I really like your Miku artwork. I would like to ask if you would draw Hatsune Miku with a white doctor's coat and a stethoscope.\n\nIf yes, I would like: a neutral expression and standing up. \"01\" on the upper left arm of the coat in purple color. \"Hatsune Miku, MD\" written on the left upper chest of the coat in black text. Underneath the white doctor's coat she has a purple tie with a collared shirt. Purple background.\n\nOtherwise please do whatever pose you want, other props, hair, etc\n\nThank you!", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@myb_e2/works/8", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2113296, "client_id": 427096, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/475631dd/uploads/origins/0072f756-499d-4952-92c2-34baeec1939a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=666ff62f608adb6d43076f711f3fe981", "srcset": "https://si.imgix.net/475631dd/uploads/origins/0072f756-499d-4952-92c2-34baeec1939a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=666ff62f608adb6d43076f711f3fe981, https://si.imgix.net/475631dd/uploads/origins/0072f756-499d-4952-92c2-34baeec1939a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e7be66f12a65b850abdc9aeb36888da5 2x, https://si.imgix.net/475631dd/uploads/origins/0072f756-499d-4952-92c2-34baeec1939a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=4abae99878e04617ae413741dd5fcbe0 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/475631dd/uploads/origins/0072f756-499d-4952-92c2-34baeec1939a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=7153e3f28da142e6ed74ceae07f7a802", "srcset": "https://si.imgix.net/475631dd/uploads/origins/0072f756-499d-4952-92c2-34baeec1939a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=7153e3f28da142e6ed74ceae07f7a802, https://si.imgix.net/475631dd/uploads/origins/0072f756-499d-4952-92c2-34baeec1939a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=a17276a8e2368aaed02c0ef29896a94b 2x, https://si.imgix.net/475631dd/uploads/origins/0072f756-499d-4952-92c2-34baeec1939a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=089b4fe82aaa343f0c9ec870918212d5 3x"}, "body": "Nice to meet you, myb! I've been looking at all of your wonderful Miku works in the shadows...!\nI'd like to have an illustration of my favorite Vtuber, Mio Nekozuki (@Nekozuki_Mio)!\n\nContents\nIllustration of Vtuber Mio Nekozuki\nI want to see her in twintails! I'd like to see her in twin-tails...!\nAs for the costume, the original is very complicated, so if it's too difficult, feel free to make her wear anything you like.\n\n\nNekotsuki Mio's Guidelines for Secondary Works\nAlthough it is stated that it is for non-commercial purposes, I have received permission from skeb https://www.fanbox.cc/@nekozukimio/posts/2642572\n\nMaterials\nPlease refer to my profile on FANBOX for the initial costume (white with three views) and the new costume (navy blue and black).\nhttps://www.fanbox.cc/@nekozukimio\n\n(2) Additional information on the new costumes\nPlease refer to the SS on the distribution.\nPlease refer to https://drive.google.com/drive/folders/1O4fRMC6pJ9TxToVaNJf5NxfQ_oIMflTB\n\nRequests\nWe would be happy if the address and background can be switched on and off by layers, etc. (transparent difference of individual characters).\nIf possible, I would like to ask for your permission to use it in my Vtuber activities (streaming thumbnails, announcements on SNS, etc.). If you give us your permission, we would appreciate it if you put a star next to the name of the person to whom you are addressing.", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@myb_e2/works/7", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/bf612f43/uploads/origins/f553a40b-b0d3-4d0f-bcdf-80a6e15fe554?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=32e3535fe5fb466560043a7e351b6bb7", "srcset": "https://si.imgix.net/bf612f43/uploads/origins/f553a40b-b0d3-4d0f-bcdf-80a6e15fe554?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=32e3535fe5fb466560043a7e351b6bb7, https://si.imgix.net/bf612f43/uploads/origins/f553a40b-b0d3-4d0f-bcdf-80a6e15fe554?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=64f65c35bffd1b3734266db91299a3e7 2x, https://si.imgix.net/bf612f43/uploads/origins/f553a40b-b0d3-4d0f-bcdf-80a6e15fe554?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=bc303be593bf5c9c353198a1956b0376 3x"}, "private": true, "genre": "art", "tipped": false, "creator_id": 2113296, "nc": 0}, {"path": "/@myb_e2/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2113296, "client_id": 249523, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/7ba530b2/uploads/origins/3154d873-4b6c-4078-99d1-3677a89afd37?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ebaf836743dc1a79ceb28f7e3c50af6e", "srcset": "https://si.imgix.net/7ba530b2/uploads/origins/3154d873-4b6c-4078-99d1-3677a89afd37?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ebaf836743dc1a79ceb28f7e3c50af6e, https://si.imgix.net/7ba530b2/uploads/origins/3154d873-4b6c-4078-99d1-3677a89afd37?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=8481a6b98722763090dc4da0a95c982b 2x, https://si.imgix.net/7ba530b2/uploads/origins/3154d873-4b6c-4078-99d1-3677a89afd37?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=3a4c287338000fec39eda36b4ebb9af8 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/7ba530b2/uploads/origins/3154d873-4b6c-4078-99d1-3677a89afd37?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2a48bc5a639392988bd7b94203044f6a", "srcset": "https://si.imgix.net/7ba530b2/uploads/origins/3154d873-4b6c-4078-99d1-3677a89afd37?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2a48bc5a639392988bd7b94203044f6a, https://si.imgix.net/7ba530b2/uploads/origins/3154d873-4b6c-4078-99d1-3677a89afd37?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=f37d7dacc564eb64ed0ea4a63f45a587 2x, https://si.imgix.net/7ba530b2/uploads/origins/3154d873-4b6c-4078-99d1-3677a89afd37?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=7afdcc6b23f4cf0d16e371f20fb7a631 3x"}, "body": "Nice to meet you! My name is Momomi Kohanai, and I am a Vtuber.\n\nPlease let me request \"Illustration of Vtuber Momomi Kohanai\"!\n\nDetails\nI would like to use it for my Vtuber activities (distribution thumbnails, SNS icons, headers, announcements, etc.).\nI would be happy if you could turn on/off the background and the signature as a PSD file if possible.\n\nPlease contact us for more information.\nhttps://twitter.com/momomi_khni/status/1340464784999735298\nhttps://imgur.com/a/Xoao1Q7\nWe have several kinds of costumes, so if you have a favorite one, we would be happy if you could choose one and write it down for us.\n\nBest regards ✨", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@myb_e2/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2113296, "client_id": 26342, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/198f3a49/uploads/origins/b4f28993-4984-43ca-84b3-f54ab2d8f37f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a4571a8c96bdfb9a693e2b475a610110", "srcset": "https://si.imgix.net/198f3a49/uploads/origins/b4f28993-4984-43ca-84b3-f54ab2d8f37f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a4571a8c96bdfb9a693e2b475a610110, https://si.imgix.net/198f3a49/uploads/origins/b4f28993-4984-43ca-84b3-f54ab2d8f37f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=6d6ecaa3c03d0bbe8568b6c09d3ba9c0 2x, https://si.imgix.net/198f3a49/uploads/origins/b4f28993-4984-43ca-84b3-f54ab2d8f37f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=59b7332cd2b83446357682b25256fd8c 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/198f3a49/uploads/origins/b4f28993-4984-43ca-84b3-f54ab2d8f37f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3903420d6da1ec2b6f34f42cc85af247", "srcset": "https://si.imgix.net/198f3a49/uploads/origins/b4f28993-4984-43ca-84b3-f54ab2d8f37f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3903420d6da1ec2b6f34f42cc85af247, https://si.imgix.net/198f3a49/uploads/origins/b4f28993-4984-43ca-84b3-f54ab2d8f37f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=713fc6214791047367655a391571a21d 2x, https://si.imgix.net/198f3a49/uploads/origins/b4f28993-4984-43ca-84b3-f54ab2d8f37f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=949da4195965dd13bf165a907721f3cf 3x"}, "body": "Hello! Your art style is so cute! I'd like to ask for a drawing of my OC Rokkin tying her hair up. She can have one of her hair pins in her mouth as she tries to put it in her hair. Maybe she can have one eye closed with a neutral facial expression looking at the viewer? I've left some examples in the reference link. If you have any other cute ideas, feel free to do them instead!\n\nPlease make note of her skin tone, body markings, and collar! If a transparent BG version is possible, I'd love that! Thank you!\n\nhttps://imgur.com/a/7nMwkzW", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@myb_e2/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2113296, "client_id": 2009955, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/01944a48/uploads/origins/74b5fe7e-8db0-4f1b-a524-f3f5da71dc99?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5409574cd11c4fbe672bacc56f5f34cb", "srcset": "https://si.imgix.net/01944a48/uploads/origins/74b5fe7e-8db0-4f1b-a524-f3f5da71dc99?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5409574cd11c4fbe672bacc56f5f34cb, https://si.imgix.net/01944a48/uploads/origins/74b5fe7e-8db0-4f1b-a524-f3f5da71dc99?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=6366a6