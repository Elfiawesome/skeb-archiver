sanmaru96/status/1583734762153209856/\n\nふたりとも少し恥ずかしそうな表情でポーズをしている、というイラストをお願いします。\n公式のイラストを見るとゲーム内の全キャラクターの中でも胸が大きく描かれている印象ですので、いちか、レイシスと同様の大きさにしてください。\nまた、衣装が脱げてしまったいわゆるポロリ差分をお願いします。\n\nポーズや構図などはおまかせします。\n以上ご検討いただけますと幸いです。", "nc": 176, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@sanmaru96/works/21", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/883a5daa/uploads/origins/339838b6-549b-4161-8cef-70e1a06fb920?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=0c6b5b727d8ae1cc52c5f9591c483935", "srcset": "https://si.imgix.net/883a5daa/uploads/origins/339838b6-549b-4161-8cef-70e1a06fb920?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=0c6b5b727d8ae1cc52c5f9591c483935, https://si.imgix.net/883a5daa/uploads/origins/339838b6-549b-4161-8cef-70e1a06fb920?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=cac61f3a8c38e091c7e5020992988578 2x, https://si.imgix.net/883a5daa/uploads/origins/339838b6-549b-4161-8cef-70e1a06fb920?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=5c8c34d5d8e29f29da38b795ff4be86c 3x"}, "private": true, "genre": "art", "tipped": false, "creator_id": 1241337, "nc": 49}, {"path": "/@sanmaru96/works/20", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/71ce2b66/uploads/origins/1930d931-7ac1-4ef3-b3eb-286402c6cb6b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=25eb41274c06e98e7afe5bb19695aabc", "s