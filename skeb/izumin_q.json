&h=200&blur=200&s=60b69f81db741bb5683a8ed40b0485c9", "src_set": ""}, "body": "艦これの第四号海防艦と提督の身体が入れ替わり、よつ(中身は提督)が手を上に伸ばして棚の高い位置に頑張って物を置こうとしているイラストをお願いします。\n\n・置こうとしているものは爆雷の入った黄緑色の四角いケース(公式絵参照)を想定しますが別のものでも構いません。\n・よつから吹き出しで中身である提督の顔を描いてください。\n・心の声で(こんな低い位置も届かないのか)とセリフを入れてください", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@izumin_q/works/17", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1322041, "client_id": 582146, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/5c317777/uploads/origins/f67c4847-4d50-4f92-bb71-6509b4a2484f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f70863479898aa29e23033fcdddba3ae", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/5c317777/uploads/origins/f67c4847-4d50-4f92-bb71-6509b4a2484f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=443317e0b0d1e9b4ef4d1c707a1056fa", "src_set": ""}, "body": "前回はとても可愛い大井っちをありがとうございました。\n\n恥ずかしそうに昔の制服(未改装の軽巡)を着てくれる、大井っちをお願いします!\n・ケッコン指輪装備\n\n表情や場所などお任せします、よろしければお願いします!", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@izumin_q/works/16", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1322041, "client_id": 10324, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/20d31f3e/uploads/origins/f6daeedc-f2d3-496f-b034-6e7032c02639?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a6586cf2007e1ef08a3fe586a5e135fc", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/20d31f3e/uploads/origins/f6daeedc-f2d3-496f-b034-6e7032c02639?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3ce36fb6023959ba2070cac439911da2", "src_set": ""}, "body": "2025年カレンダーの浴衣verの大和（艦これ）をお願いします。\n2025年版にある髪飾り（2022年版にはありません）が好きなので、そちらが見えるアングルでお願いします。\nそれ以外はすべてお任せします。", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@izumin_q/works/15", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1322041, "client_id": 582146, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/781cb490/uploads/origins/dc7dd21f-4e50-4554-8f5b-c0da356d1652?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ad2a76eebd2857ec66baac3d85c0417d", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/781cb490/uploads/origins/dc7dd21f-4e50-4554-8f5b-c0da356d1652?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9c671c949917845a20e75020b1229b9f", "src_set": ""}, "body": "はじめまして、こちらの作品の吹雪ちゃん\nhttps://x.com/izumin_q/status/1854820358089560385\nと同じようなシチュエーションで\n\n大井さんをお願いします！\n・改二制服姿で、ケッコン指輪装備でお願いします\n\nその他の点はお任せします、よろしければお願いします！", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@izumin_q/works/14", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1322041, "client_id": 461653, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/2b7f098e/uploads/origins/d2f12c68-850d-4686-a3a4-de61b5f09695?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9f8dcd5ed4a0f4d87415886dfec72a4b", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/2b7f098e/uploads/origins/d2f12c68-850d-4686-a3a4-de61b5f09695?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d63c9cb66fdd1772ee669a6a6b34b2f4", "src_set": ""}, "body": "こんにちは\n外南洋駆逐棲姫の抱き枕風イラストをお願いします\n\n外南洋駆逐棲姫\n・深海棲艦っぽい生もの部分とか艤装とかマスクとかは不要です\n・眼の色は金\n・肌の色は深海成分っぽい真っ白ではなく、色白な早潮というイメージで、頬を染める色も朱色。\n\n服装\n・公式イラストの通り\n・資料不足ならば陽炎型の物でも構いません\n\n表情\n・無表情以外\n・生意気そうな笑顔や、呆れつつも受け入れてる感じの表情など、そのいずれかで描いて欲しい。いずれにせよ好感度はある程度高め\n\nその他の事\n・抱き枕っぽいイラストを描いて欲しいというだけで、実際に抱き枕として印刷するわけではありませんし、縮尺や解像度についても特に指定は有りません。片面で、あくまでイラスト一枚のリクエストです。\n\nご検討願います\n\nhttps://wikiwiki.jp/kancolle/%E5%A4%96%E5%8D%97%E6%B4%8B%E9%A7%86%E9%80%90%E6%A3%B2%E5%A7%AB-%E5%A3%8A", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@izumin_q/works/13", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1322041, "client_id": 461653, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/45ab4d6e/uploads/origins/883e5086-e3bc-44f4-8cfc-ab76ffdc65a1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7c5569bbf3817284621321a12699c651", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/45ab4d6e/uploads/origins/883e5086-e3bc-44f4-8cfc-ab76ffdc65a1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d30df94646a8cbc4421d753ea1c559f7", "src_set": ""}, "body": "お騒がせしてすみません、書き方が不十分だったため再度申請いたします。\n\n初めまして\n艦これのモガドール改がスカートをたくし上げて見せてくれているイラストをお願いします\n・服装は改のもの＋黒のタイツ\n・艤装などは不要です\n・「Admiral、こんなものを見て楽しいですか…？まぁ、良いですけれど。…ふふっ、見たくなったらいつでも私に任せてくださいね♡」みたいに好感度は高めな感じ\n・下着＋タイツ\n・他の御依頼者様の作品で、素敵なUIを見かけたのでそちらを踏襲していただきたい（要はギャルゲ風にして欲しい）\n・下着がまずいようでしたら見えるか見えないか位で十分です\n\nご検討願います\n\nhttps://skeb.jp/@izumin_q/works/12", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@izumin_q/works/12", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1322041, "client_id": 610472, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/1831cc77/uploads/origins/30edb716-f8a3-4986-9243-c