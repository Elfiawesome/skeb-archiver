fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b22b9bad69110b60a928d4b599081b08, https://si.imgix.net/52868a64/uploads/origins/fa4c45db-f0fd-4313-ac6b-5acc45b6022c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=70da9d4b2d1085ea0a26e33275f5e3a1 2x, https://si.imgix.net/52868a64/uploads/origins/fa4c45db-f0fd-4313-ac6b-5acc45b6022c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=1d83564fe139c2ef1fbb3b82786c33ad 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/52868a64/uploads/origins/fa4c45db-f0fd-4313-ac6b-5acc45b6022c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=4437db28c193ef36dd62b012963119ea", "srcset": "https://si.imgix.net/52868a64/uploads/origins/fa4c45db-f0fd-4313-ac6b-5acc45b6022c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=4437db28c193ef36dd62b012963119ea, https://si.imgix.net/52868a64/uploads/origins/fa4c45db-f0fd-4313-ac6b-5acc45b6022c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=fd5be625bff3ace56e2ce291bb87911f 2x, https://si.imgix.net/52868a64/uploads/origins/fa4c45db-f0fd-4313-ac6b-5acc45b6022c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=f881588ce959c29132ccd257e9c8aff0 3x"}, "body": "【自創作のうさ耳メイドを描いていただきたい】\n\noi汰　様。\nこんにちは。\nMisskey.ioで「すてきな水彩絵師さんだ～(^～^)」と眺めていたところにアピールをいただき、驚きつつもずっっとニコニコしていました。\n\n■作品への希望：\n\n画像資料の子のポートレートを描いていただきたいです。\n\n取り入れていただきたい要素は以下の二点。\n\n・2～3色縛り\n・夏の花\n\nMisskeyに直近で投稿されている「シルエットの中に花や雲をあしらったイラスト」（「https://misskey.io/notes/a8fu93p4ozxn04al」など）の雰囲気がとてもすてきなので、それらの雰囲気に寄せていただけると嬉しいです！\n\nポーズや構図など、細かい部分はお任せします…！\n\n■作品の用途：\n\n個人観賞用です。\n\n■参考画像：\n\nhttps://toc-sh.sakura.ne.jp/skref_usa.png\n\n■キャラクター詳細：\n\n本編・ストーリーのない、設定のみの創作キャラクターです。\n「一般的な人間にケモ耳としっぽが生えたタイプ」のゆるい獣人の女の子（人の耳、うさぎのしっぽはついてません）。15歳前後。\n\n名前は「兔」（うさぎ）、一人称は「うさ」。\nうさぎの獣人。ケモ耳は薄紫、垂れ目がちな瞳は赤。\n髪は毛先がうっすらピンクになった金髪です。\n\nhttps://toc-sh.sakura.ne.jp/skref_usa.png", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@oita/works/9", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3279276, "client_id": 761455, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/59e3047c/uploads/origins/089292fb-2c86-42c5-913e-d739ba584828?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0d775ccaa9741ba2692d90064c342702", "srcset": "https://si.imgix.net/59e3047c/uploads/origins/089292fb-2c86-42c5-913e-d739ba584828?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0d775ccaa9741ba2692d90064c342702, https://si.imgix.net/59e3047c/uploads/origins/089292fb-2c86-42c5-913e-d739ba584828?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=1ed4ee39f1cb545af48c85ac401ff444 2x, https://si.imgix.net/59e3047c/uploads/origins/089292fb-2c86-42c5-913e-d739ba584828?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=5c7f0904affd00fd6b62ea12e5fa5222 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/59e3047c/uploads/origins/089292fb-2c86-42c5-913e-d739ba584828?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9c088b3b84dcf68339152e444b38fd4c", "srcset": "https://si.imgix.net/59e3047c/uploads/origins/089292fb-2c86-42c5-913e-d739ba584828?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9c088b3b84dcf68339152e444b38fd4c, https://si.imgix.net/59e3047c/uploads/origins/089292fb-2c86-42c5-913e-d739ba584828?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=d202a80a3a27f8b932b41256a4672aae 2x, https://si.imgix.net/59e3047c/uploads/origins/089292fb-2c86-42c5-913e-d739ba584828?bg=%23fff&auto=forma