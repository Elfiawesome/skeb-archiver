かります。\nよろしくお願いいたします！\n\nhttps://drive.google.com/drive/folders/15QYwA2nvDiVicMFthB13_aFXWYnaOjLq?usp=sharing", "nc": 41, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}], "sent_works": [], "similar_creators": [{"id": 125354, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "めいどう", "screen_name": "meido_u", "avatar_url": "https://proxy.misskeyusercontent.jp/avatar/media.misskeyusercontent.jp%2Fio%2F56d98823-2b14-43f4-96f9-40698d9b78bf.png?avatar=1", "header_url": "https://media.misskeyusercontent.jp/misskey/569e63c3-4703-4c99-8977-e6bb314664b3.png", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 5, "complete_expiration_days": 75, "skills": [{"genre": "art"}], "nc": 32}, {"id": 679730, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "きあ🔞", "screen_name": "kia_0088", "avatar_url": "https://pbs.twimg.com/profile_images/1014125559364780032/h96t_PKg.jpg", "header_url": "https://pbs.twimg.com/profile_banners/864438753313423360/1639795004/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 10, "complete_expiration_days": 100, "skills": [{"genre": "art"}], "nc": 33}, {"id": 817706, "creator": true, "nsfw_acceptable": true, "acceptable": false, "name": "国道12号🍑", "screen_name": "juunigou", "avatar_url": "https://pbs.twimg.com/profile_images/1123169553922514945/I72AsoaR.png", "header_url": "https://pbs.twimg.com/profile_banners/36890891/1680580275/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "art"}], "nc":