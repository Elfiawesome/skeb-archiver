&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=7d5064a2a1e3691056ba541e7a47438c 3x"}, "private": true, "genre": "art", "tipped": true, "creator_id": 1952855, "client_id": 2888394, "nc": 1}, {"path": "/@1000sen_ma/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1952855, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/61c56d41/uploads/origins/935323a1-6a97-4bdd-a8bb-5a850e8f8dda?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e69b3990c2c3b9315f31b2ad540d856e", "srcset": "https://si.imgix.net/61c56d41/uploads/origins/935323a1-6a97-4bdd-a8bb-5a850e8f8dda?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e69b3990c2c3b9315f31b2ad540d856e, https://si.imgix.net/61c56d41/uploads/origins/935323a1-6a97-4bdd-a8bb-5a850e8f8dda?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=46d07640147849bb82768baa826ab4af 2x, https://si.imgix.net/61c56d41/uploads/origins/935323a1-6a97-4bdd-a8bb-5a850e8f8dda?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=8081448e81e6744df43295d37fa0d5f9 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/61c56d41/uploads/origins/935323a1-6a97-4bdd-a8bb-5a850e8f8dda?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ca6afd45151ff119d020af57c6150f91", "srcset": "https://si.imgix.net/61c56d41/uploads/origins/935323a1-6a97-4bdd-a8bb-5a850e8f8dda?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ca6afd45151ff119d020af57c6150f91, https://si.imgix.net/61c56d41/uploads/origins/935323a1-6a97-4bdd-a8bb-5a850e8f8dda?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=205c03b8cf4226bc55fbcc63cc26c22a 2x, https://si.imgix.net/61c56d41/uploads/origins/935323a1-6a97-4bdd-a8bb-5a850e8f8dda?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=65509253a30bec76f1558dce31db2482 3x"}, "body": "I’d like to commission an illustration of my characters.\nThey are the adventurers from CoCTRPG, specifically the characters from Shiroha-san’s scenario titled “The Fall of Love: Rotka Volterra.”\nI’d be delighted if you could draw an interaction scene based on Senkan-san’s interpretation.\nOnce I receive the artwork, I plan to share it with the people I played with,\nas well as enjoy it privately.\n\n\nBelow is the link to the shared folder containing the character designs.\nPlease take a look.\nhttps://drive.google.com/drive/folders/1IwmYfNs2x8T5DOgazrdEc5v8IHKBbahe?usp=sharing\nThere are multiple files in the folder, but please refer to \"Rotoada_Display\" for the basic appearance.\nI’ve included the other files as references in case any information is missing.\n\nAlso, regarding the character information below,\nyou don’t need to read it if it’s not necessary.\nHowever, if you are unsure about composition or structure, I would appreciate it if you could take a look.\n\n\n[About the Characters]\n◇HO1 Yakuza\nName: Kazuchi Ishitake Age: 35 Gender: Male\nHeight: 178 cm Hair Color: Reddish-brown (#a53107) Eye Color: Light blue (#62caf1)\n\nPersonality:\nHe isn’t the type to talk nonstop, but he’s quick to retort and gets into verbal spats.\nHe’s violent but not sadistic, so he doesn’t tend to enjoy one-sided beatings.\nA lawless man who uses force to make money and get what he wants.\n\nHe’s loved rakugo since he was young and frequents traditional comedy theaters.\nPerhaps because of this, his speech is slightly influenced by the Edo dialect.\n\nRegarding HO2:\nWhen they first met, he saw him as a cocky, annoying brat.\nHe had talent for rakugo, but his lack of substance and half-hearted attitude really got on his nerves.\n\nNow, after some twists and turns, they are dating and planning to move in together.\nHe often gets called out by HO2 for making insensitive remarks when he’s in the dominant role.\n(Such as actions or comments that hint at his past relationships with women)\n\nHe likes HO2’s voice and still frequents rakugo venues to enjoy the performances.\n\n\n◇HO2 Rakugo Performer\nName: Tsuchigaya Natsume Age: 26 Gender: Male\nHeight: 159 cm Hair Color: Green Eye Color: Green (Image Color: #e0ffc1)\n\nPersonality:\nHe doesn’t understand human emotions and learned why people laugh, cry, and feel fear through rakugo.\nHe has a playful side but is generally detached; he can be rather cold toward people he isn’t close to.\nHe also has a competitive streak—he won’t back down in an argument and will even hit people with his iron fan.\n\nHe performs under the stage name Torakutei Hakusai.\nHe speaks with a brash, streetwise tone and has a quick tongue.\n\nRegarding HO1:\nWhen they first met, she disliked him because he was the only one who didn’t laugh at her performances.\nIt annoyed her that HO1 would come to listen even though he didn’t seem to find it funny, and she couldn’t stop thinking about him.\n\nCurrently, after many twists and turns, they are dating and plan to move in together.\nEven when she calls HO1 out on his tactless remarks, she ultimately forgives him.\nWhen HO1 asks about the drawbacks and resolve required to spend a lifetime with a yakuza,\nhe responds with words and actions that show he possesses the inner fortitude to remain unshaken to the core.\n\nHO1 pointed out that he is afraid of interacting with people,\nand upon learning that HO1 had always appreciated his rakugo, he developed feelings for him.\n\n\nThank you for reading this far.\nI sincerely appreciate your support.", "nc": 160, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@1000sen_ma/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1952855, "client_id": 201157