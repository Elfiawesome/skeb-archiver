fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=9ec75b4ad661bbba8473b09414e4d0b1, https://si.imgix.net/74b2df75/uploads/origins/b1b7f87a-e9ab-4f82-bcae-a93dadcc97e4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=c75503d40e47b648f0c9a4bf61a47c12 2x, https://si.imgix.net/74b2df75/uploads/origins/b1b7f87a-e9ab-4f82-bcae-a93dadcc97e4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=e4312295f37b6205ecdd769ec82b765e 3x"}, "private": true, "genre": "art", "tipped": false, "creator_id": 2412927, "client_id": 2765982, "nc": 0}, {"path": "/@horurara/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2412927, "client_id": 2498345, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/838592af/uploads/origins/37c8f8e8-eea8-40a0-b99a-7ad42841706c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7d1ed641fe7836620f2e5a1806f6beb2", "srcset": "https://si.imgix.net/838592af/uploads/origins/37c8f8e8-eea8-40a0-b99a-7ad42841706c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7d1ed641fe7836620f2e5a1806f6beb2, https://si.imgix.net/838592af/uploads/origins/37c8f8e8-eea8-40a0-b99a-7ad42841706c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=1c2b2c362ec7458046a74646b20429ca 2x, https://si.imgix.net/838592af/uploads/origins/37c8f8e8-eea8-40a0-b99a-7ad42841706c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=7b547e60319c718d2445348a019d692a 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/838592af/uploads/origins/37c8f8e8-eea8-40a0-b99a-7ad42841706c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f4d0e3cbc9f4bc254e5ff48a475d9c50", "srcset": "https://si.imgix.net/838592af/uploads/origins/37c8f8e8-eea8-40a0-b99a-7ad42841706c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f4d0e3cbc9f4bc254e5ff48a475d9c50, https://si.imgix.net/838592af/uploads/origins/37c8f8e8-eea8-40a0-b99a-7ad42841706c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=06026b6533c68ad89f668d21ca75a79a 2x, https://si.imgix.net/838592af/uploads/origins/37c8f8e8-eea8-40a0-b99a-7ad42841706c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=f030746f83c22445150ad3fc21e0d0b7 3x"}, "body": "蒲さんのskebと聞いて！！！いてもたってもいられずリクエストさせていただきました！\n\n■描いていただきたい内容\nTRPGで作成したキャラクターです。\n身長差、体格差のある二人のためそちらが表れていると嬉しいです！\n構図などはお任せ致します。\n\n\n■キャラクタープロフィール\n◇男性\n28歳　190cm\n髪色：前髪だけシルバーバング、その他黒髪\n瞳の色：藤色\nヘラヘラしつつも内面は冷静で真面目です。\nまた女性に対して優しくありつつも一定の距離感を保って接する人です。\n一方で少女に対しては放っておけないと思いつつも家族愛とは異なる感情を持っています。\n\n◇少女（幼少期と高校生時期の２パターンがあります。描きやすい方をお選びください）\n〇幼少期\n10歳　135cm\n髪色：ピンク\n瞳の色：濃いピンク\n頭のいい天才少女ですがネグレクト親のもと育ったため執着心が強いです。\n男性に対しても無意識に執着を向けていますが本人は愛とも恋とも判別できていない状態です。\n好きなものはくまでくまモチーフのものを見に付けたりしています。\n\n〇高校生時期\n16歳　155cm\n頭の良さは健在で男性に対する感情の中で恋愛感情が大きくなっています。ぐいぐい迫りつつもあしらわれています。\n\n■二人の関係性\nひょんなことから同居をし始めていますが二人に血の繋がりはありません。\n親子とも兄妹とも違うけれど二人で穏やかに日常を送っています。\n\n\n■使用用途\n個人観賞やSNSのヘッダー、もしくはアイコンに使用する場合がございます。その場合はクレジットを併せて記載させていただきます。\n\n\nご検討いただけると助かります。\n\nhttps://drive.google.com/drive/folders/1kHnm0iYDHI58nKg57vXodZuVoCKQ4fyf?usp=drive_link", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@horurara/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2412927, "client_id": 1571955, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/a5ad6d88/uploads/origins/687a1aa7-a4d2-4e57-9ea0-6d088b81d034?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a3139e8cc2bb1a1bb5af1cdcb7faa174", "srcset": "https://si.imgix.net/a5ad6d88/uploads/origins/687a1aa7-a4d2-4e57-9ea0-6d088b81d034?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a3139e8cc2bb1a1bb5af1cdcb7faa174, https://si.imgix.net/a5ad6d88/uploads/origins/687a1aa7-a4d2-4e57-9ea0-6d088b81d034?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c65b8f91b816468b5dbcc04ab31914f0 2x, https://si.imgix.net/a5ad6d88/uploads/origins/687a1aa7-a4d2-4e57-9ea0-6d088b81d034?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=45f543c0484f3bfea938809f914b28f7 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/a5ad6d88/uploads/origins/687a1aa7-a4d2-4e57-9ea0-6d088b81d034?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=87ac5bfa5edfab05063b033b8a400c38", "srcset": "https://si.imgix.net/a5ad6d88/uploads/origins/687a1aa7-a4d2-4e57-9ea0-6d088b81d034?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=87ac5bfa5edfab05063b033b8a400c38, https://si.imgix.net/a5ad6d88/uploads/origins/687a1aa7-a4d2-4e57-9ea0-6d088b81d034?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=4da4860a73b2df44c59f4f5147a19c63 2x, https://si.imgix.net/a5ad6d88/uploads/origins/687a1aa7-a4d2-4e57-9ea0-6d088b81d034?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=28fe2f4e62c5e9cb0c80c87dea4b0e72 3x"}, "body": "はじめまして、蒲さんの絵がとても好きです！\nぜひ私のオリキャラを描いて頂きたくリクエストさせていただきました。\n資料はURLをご覧ください。\n参考としてのキャラクター設定：\nライチ　外見18歳　身長166cm  水色髪の毛の少女\nリンゴ　外見15歳　身長159cm  白髪の無性別\nこのふたりは、とある教会が外なる神を召喚するために生贄として生み出した人工生命双子きょうだい。\nリンゴはライチを一番大事に思い、重い感情を寄せている。\nライチはかなりマイペースで突拍子もない行動が多い。\n二人で教会から逃げ出したあと、いまはお人よしな情報屋さんに拾われて闇の仕事をしている。\nライチの企画でそのお金で旅行したり美味しいものを食べたり人生を楽しんでいた。\n構図などはお任せで、服装の添削と改変