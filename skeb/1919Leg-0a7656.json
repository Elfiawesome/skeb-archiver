します。\n・ペニスの浮き上がりイメージ。竿が1本独立する感じではなく、下記作品のようにお腹にぴったり張り付きながら勃起している感じでお願いします。\n　https://skeb.jp/@TAKIDASHI_a/works/1\n・スーツは液体を通さない設定だが、今回は射精時にふたなりチンポの先から白濁した精液を射精している。\n\n以上、宜しくお願い致します。", "nc": 177, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@1919Leg/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1560082, "client_id": 88832, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/496a187b/uploads/origins/e9cc6a53-f58e-4d62-a13d-45c19ed455a7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f835b06542c0816ab53635c8b19136e4", "srcset": "https://si.imgix.net/496a187b/uploads/origins/e9cc6a53-f58e-4d62-a13d-45c19ed455a7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f835b06542c0816ab53635c8b19136e4, https://si.imgix.net/496a187b/uploads/origins/e9cc6a53-f58e-4d62-a13d-45c19ed455a7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=2d792d9876343553d95af45d39c7ab0e 2x, https://si.imgix.net/496a187b/uploads/origins/e9cc6a53-f58e-4d62-a13d-45c19ed455a7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=0086349681dce55463c154b7d3f2531f 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/496a187b/uploads/origins/e9cc6a53-f58e-4d62-a13d-45c19ed455a7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9b61d4db43298b05359d61b39d5c4d24", "srcset": "https://si.imgix.net/496a187b/uploads/origins/e9cc6a53-f58e-4d62-a13d-45c19ed455a7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9b61d4db43298b05359d61b39d5c4d24, https://si.imgix.net/496a187b/uploads/origins/e9cc6a53-f58e-4d62-a13d-45c19ed455a7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=d724b77c41f74625192b4fbe5ccff2c9 2x, https://si