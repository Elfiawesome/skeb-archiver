　ハーメルンで挿絵として使用する許可を頂きたいです。商業利用等は致しません。\n　また挿絵として使用する関係上、サイズは４MB以下でファイル形式はjpeg,pdf,tifのいずれかでお願いいたします。", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@AK_0929_/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2957933, "client_id": 2596866, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/b81a7aa4/uploads/origins/051a6ddf-f9ff-49bd-8fd4-0c8dfea1db98?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=941ec14519eaba9f3f79f46561bee83c", "srcset": "https://si.imgix.net/b81a7aa4/uploads/origins/051a6ddf-f9ff-49bd-8fd4-0c8dfea1db98?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=941ec14519eaba9f3f79f46561bee83c, https://si.imgix.net/b81a7aa4/uploads/origins/051a6ddf-f9ff-49bd-8fd4-0c8dfea1db98?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=742c1ec96052f3f7355dd682c3265513 2x, https://si.imgix.net/b81a7aa4/uploads/origins/051a6ddf-f9ff-49bd-8fd4-0c8dfea1db98?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f31fdf74fbdb4ac6e6ea8ad10e21c591 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/b81a7aa4/uploads/origins/051a6ddf-f9ff-49bd-8fd4-0c8dfea1db98?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=bc493a25ed2d10ea4f84e43821003940", "srcset": "https://si.imgix.net/b81a7aa4/uploads/origins/051a6ddf-f9ff-49bd-8fd4-0c8dfea1db98?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=bc493a25ed2d10ea4f84e43821003940, https://si.imgix.net/b81a7aa4/uploads/origins/051a6ddf-f9ff-49bd-8fd4-0c8dfea1db98?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=36f8ce9a3858c6112e296d4da46ddf26 2x, https://si.imgix.net/b81a7aa4/uploads/origins/051a6ddf-f9ff-49bd-8fd4-0c8dfea1db98?bg=%2