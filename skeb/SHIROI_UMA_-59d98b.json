fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=624f8294e9950283d233ba12e7183859 2x, https://si.imgix.net/f6331122/uploads/origins/09212f9c-9f71-44eb-be4e-4a7e3618ba53?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=156107a8149ea41714ae57286eccd0fe 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/f6331122/uploads/origins/09212f9c-9f71-44eb-be4e-4a7e3618ba53?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c1e8b7983f54f565e3f0e5cb89e372d5", "srcset": "https://si.imgix.net/f6331122/uploads/origins/09212f9c-9f71-44eb-be4e-4a7e3618ba53?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c1e8b7983f54f565e3f0e5cb89e372d5, https://si.imgix.net/f6331122/uploads/origins/09212f9c-9f71-44eb-be4e-4a7e3618ba53?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=cf23471789b3a66fd0bc334af6fb166e 2x, https://si.imgix.net/f6331122/uploads/origins/09212f9c-9f71-44eb-be4e-4a7e3618ba53?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=8d65f7a47a889e31ebb3abb442c18090 3x"}, "body": "skeb開設ありがとうございます！しろいうま様の絵柄や漫画がとても好きで、よければ自創作のキャラクターを描いていただきたいと思いリクエストお送りしました。\n\n札幌市在住の義兄弟兼恋人の男性二人なのですが、弟の方は普段描かれないタイプのキャラクターだと思いますので、難しければ兄のみで大丈夫です！！自分の絵柄の都合で三白眼気味になっていますが、顔が可愛い設定なので可愛く描いていただけると嬉しいです。\n構図やシチュエーション等は全てお任せいたします！\n\n資料の量がかなり多いので、全てに目を通す必要はありません！最初のページの数枚だけ参照していただければと思います。\n\nご多忙のところ恐れ入りますが、ご検討いただければ幸いです。よろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/12jHWwYGhtQ8CvCkO7TAts_Gbawm3zhCL?usp=sharing", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@SHIROI_UMA_/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3562920, "client_id": 3564116, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/70f6926e/uploads/origins/b694a11c-eae1-4c94-882e-7121e41f11c2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bfa6ff9a84129a1efde95d1b2839b60d", "srcset": "https://si.imgix.net/70f6926e/uploads/origins/b694a11c-eae1-4c94-882e-7121e41f11c2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bfa6ff9a84129a1efde95d1b2839b60d, https://si.imgix.net/70f6926e/uploads/origins/b694a11c-eae1-4c94-882e-7121e41f11c2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a1a8e1566eea2e5520e13a21b74aaa05 2x, https://si.imgix.net/70f6926e/uploads/origins/b694a11c-eae1-4c94-882e-7121e41f11c2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=0fe5cbfce6d04347b9295c31f44002f3 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/70f6926e/uploads/origins/b694a11c-eae1-4c94-882e-7121e41f11c2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=bc92b11f534a20c890404ecaae3653a0", "srcset": "https://si.imgix.net/70f6926e/uploads/origins/b694a11c-eae1-4c94-882e-7121e41f11c2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=bc92b11f534a20c890404ecaae3653a0, https://si.imgix.net/70f6926e/uploads/origins/b694a11c-eae1-4c94-882e-7121e41f11c2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=4a63f7a5e54c9df00cf63b5e6ba6491b 2x, https://si.imgix.net/70f6926e/uploads/origins/b694a11c-eae1-4c94-882e-7121e41f11c2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=62dcdbefdeb7fdfdc8fbed42ce5346cb 3x"}, "body": "初めまして。いつもしろいうまさんの素敵な作品とても楽しみに拝見しております。\nもし可能であれば、オリジナルキャラのイラストをお願いさせていただきたくリクエストしました。\n下記依頼内容になります。\n\n【キャラについて】\n(下記リンクより見た目・設定の参考画像をお送りします)\n・中華、酉年(鶏)、不動明王のモチーフキャラ\n・血の気が多い\n・背後に後光が刺している\n\n【その他構図等】\nしろいうまさんの描かれる体の線が大好きなので、なるべく全身絵に近いと嬉しいです。ポージング等はお任せします。模様・細部は省略でも大丈夫です。\n\n以上になります。\n内容ご確認いただき、金額調整等が必要であれば再送いたします。\nご検討のほど、何卒宜しくお願いいたします。\n\nhttps://drive.google.com/drive/folders/1sLuL-2ta_C8U3sAndwfB2_gPaNeEFGmL", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@SHIROI_UMA_/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3562920, "client_id": 2845078, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/4cb41f9f/uploads/origins/24ad5bae-e9ce-4776-a288-cbddba78f54e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a53cf8399edf68eab188efd7e566c2cf", "srcset": "https://si.imgix.net/4cb41f9f/uploads/origins/24ad5bae-e9ce-4776-a288-cbddba78f54e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a53cf8399edf68eab188efd7e566c2cf, https://si.imgix.net/4cb41f9f/uploads/origins/24ad5bae-e9ce-4776-a288-cbddba78f54e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=d8da7179771d686f83475619e47c3ebc 2x, https://si.imgix.net/4cb41f9f/uploads/origins/24ad5bae-e9ce-4776-a288-cbddba78f54e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f1136b64c3b44fe37ae0d988742e90f9 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/4cb41f9f/uploads/origins/24ad5bae-e9ce-4776-a288-cbddba78f54e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9d5bf62c9f988793c34adabc4873db53", "srcset": "https://si.imgix.net/4cb41f9f/uploads/origins/24ad5bae-e9ce-4776-a288-cbddba78f54e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9d5bf62c9f988793c34adabc4873db53, https://si.imgix.net/4cb41f9f/uploads/origins/24ad5bae-e9ce-4776-a288-cbddba78f54e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=a20bd7e6db14a02b2b341843786aea67 2x, https://si.imgix.net/4cb41f9f/uploads/origins/24ad5bae-e9ce-4776-a288-cbddba78f54e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=770aba5aa69f860c7d5e8d346c409b12 3x"}, "body": "うま先生がSkeb開始したと聞いて！\nうま先生の描いた自キャラが見てぇ…という夢があったので、本当に嬉しいです！夢のようです！開設ありがとうございます！\n\n以下リクエストの詳細になりますが、自分の創作キャラクターの2人を描いていただきたいです。\n資料は添付しているURL(google driveです)にまとめてありますので、そちらにて確認をお願いいたします。\nしかしながらきちんと細部まで描いてある設定画ではないので、デザインに不明な点がありましたら省略または簡略化していただいて大丈夫です。\n中途半端な資料しか準備出来ず申し訳ありません。\n絵柄や構図などは特に指定はありませんので、うま先生の自由に描いていただければと思います。\n\nご都合が合わなければキャンセルしていただいて構いません。\nお忙しい中恐れ入りますが、ご検討のほど何卒よろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/0B8cWAE4K8jqPLUxzRWNFYkNTRlk?resourcekey=0--aA-E7cmV7bXmjA-zCQCvg", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@SHIROI_UMA_/works/3", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/7b31ecd0/uploads/origins/333f20d3-164b-47dd-90d1-b340b9fd9dc0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=6a9da7e00bab9cc38ae82b5f48ab9468", "srcset": "https://si.imgix.net/7b31ecd0/uploads/origins/333f20d3-164b-47dd-90d1-b340b9fd9dc0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=6a9da7e00bab9cc38ae82b5f48ab9468, https://si.imgix.net/7b31ecd0/uploads/origins/333f20d3-164b-47dd-90d1-b340b9fd9dc0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=f3486aa4a3ea74cf7390f0e2406ce247 2x, https://si.imgix.net/7b31ecd0/uploads/origins/333f20d3-164b-47dd-90d1-b340b9fd9dc0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=2cf369fe37b5a438c213f3319529bb90 3x"}, "private": true, "genre"