at%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=71e8cf3eaff1e4cc1463f41931e7129d", "srcset": "https://si.imgix.net/a78687a8/uploads/origins/a8f5584f-6e8e-4d04-9b7c-39ead4d328b8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=71e8cf3eaff1e4cc1463f41931e7129d, https://si.imgix.net/a78687a8/uploads/origins/a8f5584f-6e8e-4d04-9b7c-39ead4d328b8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a8552ea5012dc8e82553300566f774f1 2x, https://si.imgix.net/a78687a8/uploads/origins/a8f5584f-6e8e-4d04-9b7c-39ead4d328b8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=7c1a4e4fe973617713fcb541b6e5ba6c 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/a78687a8/uploads/origins/a8f5584f-6e8e-4d04-9b7c-39ead4d328b8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=651f2691c55b492d52558d4728cd6239", "srcset": "https://si.imgix.net/a78687a8/uploads/origins/a8f5584f-6e8e-4d04-9b7c-39ead4d328b8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=651f2691c55b492d52558d4728cd6239, https://si.imgix.net/a78687a8/uploads/origins/a8f5584f-6e8e-4d04-9b7c-39ead4d328b8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=3a1a73473120acf3b903b77a9db15611 2x, https://si.imgix.net/a78687a8/uploads/origins/a8f5584f-6e8e-4d04-9b7c-39ead4d328b8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=488c8cde52f936640612a6a39c571cd0 3x"}, "body": "しろいうま先生、お疲れ様です。\nイラストのご依頼をさせて頂きたく、\nご連絡差し上げます。\n\nSNS等のヘッダーに使えるような、\n横長のイラストをお願いしたいです。\nビーバー（動物）を描いて頂きたいと思っています。\nリアルな感じでも、デフォルメされていてもどちらでも大丈夫です。\nくたびれた雰囲気があると大変嬉しいです。\n\n現在自分のXアカウント（@hahahajimo）では、\n水面から顔を出すビーバーの写真をヘッダーにしていますが、\n同様の構図でなくても構わないと思っていますので、\nそちらの写真は参考にして頂かなくても大丈夫ですし、\nこちらの写真をイラスト化するということでも問題ありません。\n一応資料にはXアカウントのURLを貼っておきました。\n\nひとまず、ビーバーのイラストであれば構図その他は基本的に全てお任せ致します。\n横長でという依頼ではありますが、\n描いてみたら横長にならなかったらそれはそれで。\nそうした際はヘッダー用に横長のトリミング等はこちらで行ってもよろしければ……\n\nskebでの依頼は初めてで勝手もわからず、\n失礼な内容やご無理を押し付けていたら大変申し訳ありません。\n動物のイラスト依頼は受け付けていないというお話であれば、\n遠慮なくキャンセル頂いて結構です。\n\nしろいうま先生のイラストや漫画が好きで、\nそれが高じて今回のご依頼になりました。\n是非依頼のご検討をよろしくお願い致します。\n\nhttps://x.com/hahahajimo", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@SHIROI_UMA_/works/16", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3562920, "client_id": 979028, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/3c9a553c/uploads/origins/8f0b1234-c45b-40dc-b960-0771ac03af79?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3a9f59a6c459445c01b43f974494f00d", "srcset": "https://si.imgix.net/3c9a553c/uploads/origins/8f0b1234-c45b-40dc-b960-0771ac03af79?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3a9f59a6c459445c01b43f974494f00d, https://si.imgix.net/3c9a553c/uploads/origins/8f0b1234-c45b-40dc-b960-0771ac03af79?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=58abd3eb7b88cf3e25da210ca480d775 2x, https://si.imgix.net/3c9a553c/uploads/origins/8f0b1234-c45b-40dc-b960-0771ac03af79?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=2254f0370ba293e74c6b7412229a2a98 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/3c9a553c/uploads/origins/8f0b1234-c45b-40dc-b960-0771ac03af79?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e4e67fcd82f4aba15809a0748698076e", "srcset": "https://si.imgix.net/3c9a553c/uploads/origins/8f0b1234-c45b-40dc-b960-0771ac03af79?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e4e67fcd82f4aba15809a0748698076e, https://si.imgix.net/3c9a553c/uploads/origins/8f0b1234-c45b-40dc-b960-0771ac03af79?bg=%23fff&auto=format%2C