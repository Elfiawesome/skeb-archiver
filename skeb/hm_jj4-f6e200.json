かな藤色の瞳\n・普段は神官としての装いをしています\n衣装・髪型のアレンジや描き込みは先生の自由に調整いただいて構いません。\n\n【性格・背景】\n半神として生まれながらも自覚を持たず、力の暴走をきっかけに自身の正体を知った少女。\n神殿で回復魔法と杖術を学び、力の制御に励んできました。\n穏やかで優しい反面、神秘的でどこか近寄りがたい雰囲気を纏っています。\n孤独に耐える強さの裏で、本心では寂しがり屋です。\n\n【構図】\n構図、表情、ポーズなどの指定はありません。\nキャラクターのデザインや設定から、先生がふと思い浮かんだシーンやシチュエーションで自由に描いていただければ幸いです。\n\n【納品形式・用途】\n・納品データについてはPNG、PSDでいただけたら嬉しいです。\n・用途：個人鑑賞、SNSでのアイコン・ヘッダー利用、他クリエイター様へ依頼する際の参考資料としての提示を主に考えています。\n\nご検討のほどよろしくお願いいたします。\n\nhttps://photos.app.goo.gl/en3ZSvTLT1fgXAon9", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@hm_jj4/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3451426, "client_id": 3639215, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/d899715c/uploads/origins/f7639582-246b-434f-9d66-09047009df8f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6d56ed913e76c395697815e25f11d3b9", "srcset": "https://si.imgix.net/d899715c/uploads/origins/f7639582-246b-434f-9d66-09047009df8f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6d56ed913e76c395697815e25f11d3b9, https://si.imgix.net/d899715c/uploads/origins/f7639582-246b-434f-9d66-09047009df8f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c14426060a585c5927ef27b4998ec11b 2x, https://si.imgix.net/d899715c/uploads/origins/f7639582-246b-434f-9d66-09047009df8f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=63a0f0cd8763ef0651e46048b2bed7df 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/d899715c/uploads/origins/f7639582-246b-434f-9d66-09047009df8f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=738f01c1bebbde4c12641d25eb2bca8b", "srcset": "https://si.imgix.net/d899715c/uploads/origins/f7639582-246b-434f-9d66-09047009df8f?bg=%23fff&auto=format%2Ccompress&fm=w