23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1e513678c4bf030fbdc7b21517ca8634, https://si.imgix.net/ae42c80d/uploads/origins/7ba5b69e-4c8c-4406-bf7b-b3eb43e4f94b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=cb0e8bb7cf651c97f45c4b5992f1f7ac 2x, https://si.imgix.net/ae42c80d/uploads/origins/7ba5b69e-4c8c-4406-bf7b-b3eb43e4f94b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=5ce7d92cafde3dedf8fe15c681fdeedb 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/ae42c80d/uploads/origins/7ba5b69e-4c8c-4406-bf7b-b3eb43e4f94b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e2d9685a1a68941754c9d27e70e9ddef", "srcset": "https://si.imgix.net/ae42c80d/uploads/origins/7ba5b69e-4c8c-4406-bf7b-b3eb43e4f94b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e2d9685a1a68941754c9d27e70e9ddef, https://si.imgix.net/ae42c80d/uploads/origins/7ba5b69e-4c8c-4406-bf7b-b3eb43e4f94b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=9681593257cb928bb52806f47c3f1e3a 2x, https://si.imgix.net/ae42c80d/uploads/origins/7ba5b69e-4c8c-4406-bf7b-b3eb43e4f94b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=fd57f1e6b5a2520af99d9f7e8399a334 3x"}, "body": "作品:オーバーロード\nキャラ:アルシェ\nシチュエーション:金貨1000枚の借金返済の為に妹達の前でベルコール君とのラブラブ洗体セックス\n\n働き詰めのモモンガの為に帝国観光を企画しその下見のために、イミーナ経由でフォーサイトに2日間の観光案内を依頼した。\n1日目の夜に林檎亭でヘッケランとロバーにこれまでの冒険を聞いていたところ、屋敷に帰ったはずのアルシェが血相を変えて戻ってきて事情を聞くと親が妹2人を人買いに売られたため、買い戻す為にお金が必要になったそう。フォーサイトメンバーの有り金を集めても金貨1000枚という大金には届かなかった。ベルコール君がアルシェにいいとこ見せたいのと子供を助けて上げたいという純粋な好意で手持ちのお金から金貨1000枚(白金貨100枚)出した。そのおかげで無事に妹たちを助けることができた。\nこのまま帝国にいたら親の手が再度伸びる可能性が有るのでは無いかと頭を悩ませていたら、ベルコール君からフォーサイト全員でカルネ村への移住を提案される。全員を誘うのはメンバーたちを気に入ったのと、イミーナも手元に置いておけるという打算も有ってのこと\n•結局全員でカルネ村に移り住む事に。カルネ村には温泉が出来ておりルプスレギナに唆されて腟内射精一発金貨1枚分の扱いで洗体セックスをする事に、妹たちにベルコール君の背中を流してくるため与えられた家で留守番をしてもらおうとしたが、自分たちも行くと駄々をこねられ待たせるわけにもいかないので仕方なく妹達も温泉に連れて行く事になった。\nそして妹達の前で洗体セックスを行う事になった。\n•カルネ村の温泉はベルコール君が来たらすぐに体を清められるように作られた(村人の衛生管理も)感じです(モモンガさんには魔法の持続等の実験として許可取り)\n•ルプスレギナはベルコール君に事後報告されたアルベド、ラナーから指示された感じです。\n•妹sはアルシェのマネして一緒に洗体→ぶっかけ\n•アルシェは洗体セックスには前向き。金貨1000枚躊躇いなく出してくれて、自分の大切な妹と仲間と一緒に穏やかな生活を送れるようにしてくれて感謝しか無いため。\n•村では生活魔法や武技、戦術指導などがフォーサイトの役割\n\n長文と注文多くなってすみません。\n出来れば導入もしっかりとお願いします。", "nc": 184, "word_count": 24200, "transcoder": "text", "creator_acceptable_same_genre": true}, {"path": "/@nigorimaru77/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "novel", "tipped": false, "creator_id": 1452595, "client_id": 1205407, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/b80adb54/uploads/origins/55ffca33-6f77-4ede-836b-959223d7cc43?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=cb1ee63ef34e5e0ec4ffd96dc9cae1fd", "srcset": "https://si.imgix.net/b80adb54/uploads/origins/55ffca33-6f77-4ede-836b-959223d7cc43?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=cb1ee63ef34e5e0ec4ffd96dc9cae1fd, https://si.imgix.net/b80adb54/uploads/origins/55ffca33-6f77-4ede-836b-959223d7cc43?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=5e61d21667341fba72b762a0e5d96d86 2x, https://si.imgix.net/b80adb54/uploads/origins/55ffca33-6f77-4ede-836b-959223d7cc43?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ea0661f31ce658193ebb1e37b84ccbed 3x"}, "duration": null, "nsfw": true, "hardcore": true, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/b80adb54/uploads/origins/55ffca33-6f77-4ede-836b-959223d7cc43?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c263cd6f09f218b9099a67c7ce82d74b", "srcset": "https://si.imgix.net/b80adb54/uploads/origins/55ffca33-6f77-4ede-836b-959223d7cc43?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c263cd6f09f218b9099a67c7ce82d74b, https://si.imgix.net/b80adb54/uploads/origins/55ffca33-6f77-4ede-836b-959223d7cc43?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=37e8d3f8e81608f1bd91fc732a4666a8 2x, https://si.imgix.net/b80adb54/uploads/origins/55ffca33-6f77-4ede-836b-959223d7cc43?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=a36f569a5d868e368a1547de6a77422f 3x"}, "body": "テキストのskeb！　心待ちにしておりました！！\n\nリクエストはオーバーロード。主人公はベルコールさん、もしくはまた別のプレイヤーでお願いしたいです！\n\nキャラクター、シチュエーション：短編というお話なので、主人公がメイドに手を出して気持ちよく性処理するシチュエーションでお願いしたいです。希望するキャラクターは、一般メイド、プレアデス（描きやすいキャラクターで執筆して頂ければ幸いです。プレアデスはみんな大好きなので！）\n\n普段処理をしてくれる相手（アルベド等）が不在、欲求不満な所にスケベな体のメイドが声を掛けた事で決壊。種付けではない快楽本位で精液を搾り出すだけの性処理セックスを覚え、近くのメイドをハメ潰し続ける。話を聞き付けたプレアデスのメンバーにも手を出し、文字通りレベルの違う体を楽しんでオナホ扱いセックスをする。\n\n希望：膣内の名器描写。オマンコが気持ち良すぎて腰が止まらなかったり、何人もセックスする内に膣内の違いや絡みつき、ヒダやツブの具合の違い、オマンコの中がチンポを気持ちよくする描写を頂きたいです！　性処理、オナホみたいに扱う描写が強調されて大好きなんです！！\n\n御一考願います！！", "nc": 59, "word_count": 10847, "transcoder": "text", "creator_acceptable_same_genre": true}, {"path": "/@nigorimaru77/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "novel", "tipped": false, "creator_id": 1452595, "client_id": 2586431, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/6da252d4/uploads/origins/719a7517-b29d-4e1f-bc63-9c5a08d16da8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c07eafebc6d461350f48d4c4b1670c93", "srcset": "https://si.imgix.net/6da252d4/uploads/origins/719a7517-b29d-4e1f-bc63-9c5a08d16da8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c07eafebc6d461350f48d4c4b1670c93, https://si.imgix.net/6da252d4/uploads/origins/719a7517-b29d-4e1f-bc63-9c5a08d16da8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=20aec7ceaf65387a784327b2143cb1a3 2x, https://si.imgix.net/6da252d4/uploads/origins/719a7517-b29d-4e1f-bc63-9c5a08d16da8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=3d78e8f4d52e0e9cb3cab581111bdb62 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/6da252d4/uploads/origins/719a7517-b29d-4e1f-bc63-9c5a08d16da8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c31ff3d8e56da4c0ac1891753a898757", "srcset": "https://si.imgix.net/6da252d4/uploads/origins/719a7517-b29d-4e1f-bc63-9c5a08d16da8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c31ff3d8e56da4c0ac1891753a898757, https://si.imgix.net/6da252d4/uploads/origins/719a7517-b29d-4e1f-bc63-9c5a08d16da8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=51a2132036101a1ae42298ee528e5a46 2x, https://si.imgix.net/6da252d4/uploads/origins/719a7517-b29d-4e1f-bc63-9c5a08d16da8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=709394547039d34cf25e2d3f8e063382 3x"}, "body": "原作：Fate/GrandOrder(FGO)\nキャラクター：アルトリア・アヴァロン(水着霊基第３臨)\n\n〇前編\n\n〇ハワトリアの安全版特異点\n〇夜のビーチには、立香と、その後ろを歩くやや困惑気味のアルトリア・アヴァロン\n〇遡ること数時間前\n〇『孕めるようになる魔術』と『孕んだら直ぐに出産できる魔術』を遂に完成させたキャスターの彼女(第３臨)は、立香の自室にて、報告を兼ねて立香に壁ドンしていた\n「…モルガンやマーリンは沢山受精させているのに……何故っ、私はアレ以来抱いてすらくれないのですかっ！？」\n〇怒りや妬み、そして寂しさから、その瞳には涙が\n〇意を決した立香は彼女の手を取り引き連れ、ダヴィンチちゃんに以前より秘密裏に頼んでいた『聖杯を借りての特異点先での休暇』を実行\n〇其処には二人だけ\n〇期限は１週間\n〇聖杯は何時でも回収可能な状態に\n〇立香の礼装は【サマー・ストリート】\n〇彼女は頼まれて水着霊基(第３臨)に\n〇「何故この様なことを…？」と問う彼女に、止まって振り返り、「渡したい物がある」と、ポケットから『小さな箱』を\n〇中には『指輪』\n〇『理解』して、思考が止まった彼女にプロポーズ\n〇彼女は両手で口許を覆って震え、嬉し涙\n「…ズルい。ズルいですよ。受け取らない訳ないでしょう。バカぁ…」\n〇左手薬指に通してあげ、更に涙を流す彼女を抱きしめる\n〇そしてキスの雨。ただ唇で触れ合うだけのキスの雨を、無数に\n〇この１週間、彼女を独り占め。つまり彼女だけを『抱く』。その為の『プライベートビーチ』\n〇彼女は先達どおり、『例の魔術』を自身に施した\n〇キスをしながら、彼女の全身を撫でたり揉んだり\n〇そのキスのまま、浜辺の上に仰向けに寝かせる\n〇裸になると、彼女の水着の紐を解き、再び全身を触れ回る\n〇彼女はその間、待ちわびていた立香の肉棒を撫でてはフェラを\n〇彼女を寝かせ、正常位で挿れて、子宮を何度も突き回す\n〇彼女は淫らに喘ぐ\n〇途中、彼女は排卵したのを実感\n〇両手を立香に伸ばし、「ください❤」と何度もお願い\n〇覆い被さって抱きしめ、彼女に膣内射精。お腹が膨らみ、受精した\n〇今まで待たせてしまった分、満足以上にさせると誓う立香は、繋がったまま駅弁で直結のホテルの一室まで連行\n「そうでもしないと赦しませんよ、我が命❤」\n〇誓いのキスを交わす二人の休暇は、まだ始まったばかり", "nc": 161, "word_count": 18549, "transcoder": "text", "creator_acceptable_same_genre": true}, {"path": "/@nigorimaru77/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1452595, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/2f492c98/uploads/origins/80eb4521-403e-4167-a35e-a091205c612e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4b45175a75b7a5009da9dfd0f160cea8", "srcset": "https://si.imgix.net/2f492c98/uploads/origins/80eb4521-403e-4167-a35e-a091205c612e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4b45175a75b7a5009da9dfd0f160cea8, https://si.imgix.net/2f492c98/uploads/origins/80eb4521-403e-4167-a35e-a091205c612e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=1184f988689a438b422a8d9f1896998a 2x, https://si.imgix.net/2f492c98/uploads/origins/80eb4521-403e-4167-a35e-a091205c612e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a9270eee4c15bb5941d9ef189be8b4e4 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/2f492c98/uploads/origins/80eb4521-403e-4167-a35e-a091205c612e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=bfb81ef2e25f7f174fbf2b1727ee3e64", "srcset": "https://si.imgix.net/2f492c98/uploads/origins/80eb4521-403e-4167-a35e-a091205c612e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=bfb81ef2e25f7f174fbf2b1727ee3e64, https://si.imgix.net/2f492c98/uploads/origins/80eb4521-403e-4167-a35e-a091205c612e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=ae6408252772f3a03c477b9eb5b51c19 2x, https://si.imgix.net/2f492c98/uploads/origins/80eb4521-403e-4167-a35e-a091205c612e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=20