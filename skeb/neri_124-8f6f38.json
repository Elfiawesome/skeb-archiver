e and pastel color so i would like you to draw baby spica holding a deck of taro cards her one hand and a microphone in her other hand.\n\n- drawing should have at least on layer with only the model separated from the background.\n- please draw 3 different face expressions\n\nhttps://drive.google.com/drive/folders/1d45XEbqGtcQ2ZmlwvgURIiwsQ6bXrv9Z?usp=sharing\n\nhttps://drive.google.com/drive/folders/1d45XEbqGtcQ2ZmlwvgURIiwsQ6bXrv9Z?usp=sharing", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@neri_124/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2813825, "client_id": 68057, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/21073a83/uploads/origins/a67217ac-f78d-47d2-97a8-b0bdfd8e914d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=602d16c1b25b2f76914949eae288c619", "srcset": "https://si.imgix.net/21073a83/uploads/origins/a67217ac-f78d-47d2-97a8-b0bdfd8e914d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=602d16c1b25b2f76914949eae288c619, https://si.imgix.net/21073a83/uploads/origins/a67217ac-f78d-47d2-97a8-b0bdfd8e914d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=176efa679b4a448c5ff0a0bbcb162c17 2x, https://si.imgix.net/21073a83/uploads/origins/a67217ac-f78d-47d2-97a8-b0bdfd8e914d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f4ca507e4286a5cb4cdb7a0c73840589 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/21073a83/uploads/origins/a67217ac-f78d-47d2-97a8-b0bdfd8e914d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ac7905a5f83b96a85d7ece92e8234a89", "srcset": "https://si.imgix.net/21073a83/uploads/origins/a67217ac-f78d-47d2-97a8-b0bdfd8e914d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200