ださい！これは重要です。\n- 最終的なデザインのスタイルと美的感覚はディダリオンに近いものであるべきです！OCは同じようなタイプのスーパーロボットであり、自然な装甲を持つ半機械的な存在に見えるはずだ！\n- 参考アルバムに、OCのスクラップされたデザインのスケッチがあるので、これをデザインの頭のベースとして実装してほしい！最小限の変更でお願いします！また、牙のある口と牙を出した状態と隠した状態を描いてください！EVAユニットが口を隠しているのと同じように！\n\nあなたの才能に全幅の信頼を寄せていますので、細かい変更、追加、ポージングはお任せします。それ以外でも大歓迎です！\n\nhttps://drive.google.com/drive/folders/1XiG5ZBjbquXPw1BR3-HKd4NGzOI8ZgZq?usp=sharing", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@samhoshi7/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2938628, "client_id": 2594413, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/096fa937/uploads/origins/8c024787-68e1-4081-b14f-2c4cb0539708?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4249d5395eadfba3cedc30ada8aeaf60", "srcset": "https://si.imgix.net/096fa937/uploads/origins/8c024787-68e1-4081-b14f-2c4cb0539708?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4249d5395eadfba3cedc30ada8aeaf60, https://si.imgix.net/096fa937/uploads/origins/8c024787-68e1-4081-b14f-2c4cb0539708?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=7aea08560b7aa5345e85e96610ed16a0 2x, https://si.imgix.net/096fa937/uploads/origins/8c024787-68e1-4081-b14f-2c4cb0539708?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e0d2bd46bcb5e3c9071be8e7ae13f322 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/096fa937/uploads/origins/8c024787-68e1-4081-b14f-2c4cb0539708?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=74386736c7791ff1e08d4c1345324e8b", "srcset": "https://si.imgix.net/096fa937/uploads/origins/8c024787-68e1-4081-b14f-2c4cb0539708?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=74386736c7791ff1e08d4c1345324e8b, https://si.imgix