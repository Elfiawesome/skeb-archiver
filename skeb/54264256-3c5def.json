今までの武内Pと新婚のシーンは全て夢だった事に気付く\n\n⑥「なに、今の夢！？なんて夢、見てるの……！？」と恥ずかしさに悶える\n\nセリフは話の流れに合わせて多少変えて頂いても大丈夫です。\n以上、よろしければご検討ください。", "nc": 24, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@54264256/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 930951, "client_id": 1778588, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/620e30dd/uploads/origins/51f80890-3e3f-427f-91b0-ebb12243d581?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6a11f58c7a72821c071490a3f230fe71", "srcset": "https://si.imgix.net/620e30dd/uploads/origins/51f80890-3e3f-427f-91b0-ebb12243d581?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6a11f58c7a72821c071490a3f230fe71, https://si.imgix.net/620e30dd/uploads/origins/51f80890-3e3f-427f-91b0-ebb12243d581?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ddaa61339520080f62be073b2bc7afec 2x, https://si.imgix.net/620e30dd/uploads/origins/51f80890-3e3f-427f-91b0-ebb12243d581?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=cbec50a6fe866c104b431a339a9bef80 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/620e30dd/uploads/origins/51f80890-3e3f-427f-91b0-ebb12243d581?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0029d4f42107c726ddd5cc4eaac3acfe", "srcset": "https://si.imgix.net/620e30dd/uploads/origins/51f80890-3e3f-427f-91b0-ebb12243d581?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0029d4f42107c726ddd5cc4eaac3acfe, https://si.imgix.net/620e30dd/uploads/origins/51f80890-3e3f-427f-91b0-ebb12243d581?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=c83dda19555fefd6130f1f080b644fb0 2x, https://si.imgix.net/620e30dd/uploads/origins/51f80890-3e3f-427f-91b0-ebb12243d581?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=84d07305541c021a6c30a23b5b143c34 3x"}, "body": "いつもお世話になっております。\nアイドルマスターシンデレラガールズの三村かな子と武内Pの漫画をリクエストさせて頂きます。\n希望するシチュエーションは以下の通りです。\n\n①かな子はデレステのSSR［絶品無双］特訓後のチャイナ服姿で、難しいアクションの撮影に挑戦中。\n　アクションの内容はSSRイラストの「ラーメンと岡持ちを持ちながら猫を飛び越える」以外でも構いません。\n②かな子がバランスを崩して転びそうになり、とっさに武内Pが受け止めに走る。\n③武内Pは転んだかな子を受け止めたが、その際に武内Pの顔面にかな子の胸が直撃する。\n④顔を真っ赤にして互いに謝るかな子と武内P。武内Pは（柔らかかった…）とかな子の胸の感触を思い出してしまい、自制して必死に忘れようとする。\n\n以上です。ご検討よろしくお願い致します。", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@54264256/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 930951, "client_id": 670645, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/b1cdc004/uploads/origins/a543e298-d28f-4f78-9b72-a3ab78b8c061?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=dbbc6878dd1631c49c537d12cafd49f1", "srcset": "https://si.imgix.net/b1cdc004/uploads/origins/a543e298-d28f-4f78-9b72-a3ab78b8c061?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=dbbc6878dd1631c49c537d12cafd49f1, https://si.imgix.net/b1cdc004/uploads/origins/a543e298-d28f-4f78-9b72-a3ab78b8c061?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=16ad6c8f8d2e7d2c9e7994f7b8dedd52 2x, https://si.imgix.net/b1cdc004/uploads/origins/a543e298-d28f-4f78-9b72-a3ab78b8c061?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=642188a8dacd383743f2f5d398586716 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/b1cdc004/uploads/origins/a543e298-d28f-4f78-9b72-a3ab78b8c061?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0d33a22c4a6932725bbd7f22312bb90d", "srcset": "https://si.imgix.net/b1cdc004/uploads/origins/a543e298-d28f-4f78-9b72-a3ab78b8c061?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0d33a22c4a6932725bbd7f22312bb90d, https://si.imgix.net/b1cdc004/uploads/origins/a543e298-d28f-4f78-9b72-a3ab78b8c061?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=0d17dfa6f65ceab178d03acc27751b79 2x, https://si.imgix.net/b1cdc004/uploads/origins/a543e298-d28f-4f78-9b72-a3ab78b8c061?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=92181109ef8ed0ffa975fd6c0a17e3d4 3x"}, "body": "再びのリクエスト失礼します。\nアイドルマスターシンデレラガールズの棟方愛海と武内Pで、以下のシチュエーションの漫画をリクエストさせて頂きます。\n\n①棟方愛海が大きな舞台のソロライブの直前で、舞台袖で緊張している\n\n②「お山を揉めば緊張もほぐれるんだけどなぁ……なんちゃって」などと自分の緊張を解こうと軽口を言う愛海\n\n③武内Pが思案の末に大真面目な顔で『私のお山で良ければ、揉んでもよろしいのですよ……？』と提案する\n\n④「そんな真面目な顔で『揉んでもよろしいのですよ』って、あはははは！」と大笑いする愛海\n\n⑤「……緊張はほぐれましたか？」と言う武内P\n\n⑥「……うん。ありがとう、プロデューサー。それじゃ、行ってくるね！」と笑って緊張がほぐれた愛海が笑顔で舞台へ向かう\n\nという流れの漫画をお願いします。\nその際、衣装は[ｼﾝﾃﾞﾚﾗﾄﾞﾘｰﾑ]棟方愛海+（https://imas.gamedbs.jp/cg/idol/detail/22?h=10588a1050f26ef0bb01d54209cc4df3）でお願いしたいです。\nセリフは話の流れに合わせて多少変えて頂いても大丈夫です。\n以上、よろしければご検討ください。", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@54264256/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 930951, "client_id": 670645, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/f6cffebc/uploads/origins/0f92df23-7968-41f2-bdd2-b021cd7fe3e4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=30fd34d6677f3d47d81afb8121f6907c", "srcset": "https://si.imgix.net/f6cffebc/uploads/origins/0f92df23-7968-41f2-bdd2-b021cd7fe3e4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=30fd34d6677f3d47d81afb8121f6907c, https://si.imgix.net/f6cffebc/uploads/origins/0f92df23-7968-41f2-bdd2-b021cd7fe3e4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=2b243c688b13ceda5ed427f612fe7d3d 2x, https://si.imgix.net/f6cffebc/uploa