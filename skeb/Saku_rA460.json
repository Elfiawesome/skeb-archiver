appeals_count": 0, "received_works": [{"path": "/@Saku_rA460/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3656530, "client_id": 0, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/23439af8/uploads/origins/51e958bc-0b61-4461-9333-9716d8b646ca?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=dd57aa43ce4d130d34ea4908b63d1f0a", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/23439af8/uploads/origins/51e958bc-0b61-4461-9333-9716d8b646ca?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b143628eebb450599cc9479acfe0849b", "src_set": ""}, "body": "初めまして！肉感と顔の良さ(可愛い、格好良い含む)に惹かれて…リクエストをお願いしたいです！\n\nさっそくなんですが兎木跳太郎の自慰行為についてより詳しく鮮明にイメージしたく馳せ参じました！お願いします！\n兎木跳太郎はマストスケベボーイズに選抜されるほどのエロ人間な事は皆さん百も承知の上と理解していますがやはり、エロを頼むというのであれば外せない選択だと思います　そう思いますよね\n\nだから兎木跳太郎の勃起が必要なんです、お分かりですね？ありがとうございます\nはい兎木跳太郎の勃起、もしくはパンツ、テント。自慰行為…これらに関係することならばなんでも…見たいです\n制服…放課後…学校…トイレ…おしっこ…自宅…休日…私服…パジャマ…あらゆる可能性がありますね…盛んな年頃でしょうから、自分の意志とは関係なく勃起する事もあるでしょう…ズボンのチャックから出す光景って素敵ですし、兎木跳太郎はトイレの時もそんな出し方はしなさそうですけど、してたらエロイですし、全然ベルトをチャカチャカしながら脱いで抜いてるのもイイですよね…\n道具…も使ったりね…コンドームとか…着けたりさ…オナホ使ったりさ…全部見たいんですけども…描きやすくて　一　等　エ　ッ　チ　なものを求めています\n目的は完全にエロです、表情にエロスを感じるし肉体にも感じます。状況にも感じます。お願いします。エロを描いてください。モブや友人や何を使っても構いませんので…何卒…何卒…\nおかずとかも使ってるのならセットであると嬉しいですが…もちろん今回は抜くだけという事に重きを置いて何も持たずスるというのもまた美しい光景でしょう…\nもしも自室のベット等で抜いてるのなら、生活感がある部屋が見えているともっと興奮します、ベットの上でベットの皺と枕だけというのもまた、エロいので好きですが\n\n要するに、兎木跳太郎の自慰行為をガッツリ浴びたいということなのでよろしくお願いします　お願いします", "nc": 48, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "similar_creators": [{"id": 338002, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "もえぎ", "screen_name": "MO_E_GI1", "avatar_url": "https://pbs.twimg.com/profile_images/1616606044666593280/l3AsA6YQ.jpg", "header_url": "https://pbs.twimg.com/profile_banners/902685875980480512/