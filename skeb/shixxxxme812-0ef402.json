募集されているのを拝見しまして、\nぜひ自分と友人のOCを描いていただきたく依頼を送らせていただきます。\n男性キャラで失礼します...\n\n二人はアイドルユニットでして、アイドルをしているようなシーンでも\n日常生活（同居しています）のシーンでもなんでもまめすず様にお任せします。\n補足としては幼馴染から一緒にアイドルになったような関係性です。\n\n情報が不足していることがありましたら、すべてお任せいたします。\n服装も自由にしていただいてかまいません。\n\n【使用用途】\n鑑賞、自分と友人だけで共有するグッズの作成、XなどのSNS等での使用（ヘッダー、アイコン）可能性あり\n\n難しければ遠慮なくキャンセルしていただいて構いません。\nご検討のほどよろしくお願いします。\n\nhttps://drive.google.com/drive/folders/1EWXRSgxQkUk9VIRPablNAEndd7KsSl-9?usp=drive_link\n\nhttps://drive.google.com/drive/folders/1EWXRSgxQkUk9VIRPablNAEndd7KsSl-9?usp=drive_link", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@kuromatsu_trpg/works/136", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1184964, "client_id": 2948993, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/f21f8503/uploads/origins/e92d8dd4-7171-41fa-9201-94a9c67bb890?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=500f433db9e1b6152ac6acf34c8374b9", "srcset": "https://si.imgix.net/f21f8503/uploads/origins/e92d8dd4-7171-41fa-9201-94a9c67bb890?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=500f433db9e1b6152ac6acf34c8374b9, https://si.imgix.net/f21f8503/uploads/origins/e92d8dd4-7171-41fa-9201-94a9c67bb890?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=719083298dba1d21925b93437e8b17b6 2x, https://si.imgix.net/f21f8503/uploads/origins/e92d8dd4-7171-41fa-9201-94a9c67bb890?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=fd109adc703f05d45e1721ca09944f33 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/f21f8503/uploads/origins/e92d8dd4-7171-41fa-9201-94a9c67bb890?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=58ec7dc89195b0163ba830ac37706cd3", "srcset": "https://si.imgix.net/f21f8503/uploads/origins/e92d8dd4-7171-41f