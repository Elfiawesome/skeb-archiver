972?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=2ea80fed2da3bed71bba4bb9f01ac451", "src_set": ""}, "private": true, "genre": "art", "tipped": true, "creator_id": 2182747, "client_id": 1327892, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 1, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@Baconegg_111/works/79", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2182747, "client_id": 2933154, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/9c5d9ae7/uploads/origins/e4d3b1fd-df45-418f-b1a1-aae5bbe500c0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=752170fed6d530fcb7be1be99b53f8f7", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/9c5d9ae7/uploads/origins/e4d3b1fd-df45-418f-b1a1-aae5bbe500c0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b4d52f9870bb70ed6993e9d659670119", "src_set": ""}, "body": "はじめまして。\nCoCTRPGシナリオ「VOID」の探索者二名（HO1/HO2）を描いて頂きたいです。\n相手の方にはリクエストへの使用許可を頂いています。\n\n構図などすべておまかせします。\n衣装もお任せしますが、迷ったら制服を着せてください。\n\n＊須炭大和（すた やまと）\n職業：刑事\n年齢/性別：22歳/男性\n身長/体重：176cm/70kg\n\n真面目で真っ直ぐ、ドが付くほどの負けず嫌いの新人刑事。\n溌剌としている。短気で時々頑固。\n\n発想は大変柔軟だがそれゆえに飛び出しがち。\n対岸に怪しい人影がいたら川に飛び込むとか。\n証拠が揃っていないのに犯人を尾行するとか。\n\n＊蒼月（そうげつ）\n職業：刑事\n年齢/性別：外見20代前半/男性型\n身長/体重：175cm/85kg\n\n落ち着いていて穏やか、誰にでも丁寧な態度で接する新型アンドロイド。\n人とほとんど変わらない見た目で、飲食や呼吸などを擬似的に行う事も出来る。\n\n周囲が引くほどのチョコミント好きで、\nその狂信具合は共に行動しているバディに限らず、\n先輩や先輩アンドロイドすらも恐怖させた。\n\n外見などは資料URLを参照ください。\n問題があれば再送/キャンセル下さって構いません。\nよろしくお願い致します。\n\nhttps://drive.google.com/drive/folders/1oT0yhmP1GJtzOHxkbMjPqNjx3EVc-Cua?usp=drive_link", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Baconegg_111/works/78", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/7714aa75/uploads/origins/b759c1ec-1d10-4d19-8f8c-37abb9a3fdc1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=e3f5a6c95ef244753a4914ae0adcc7ed", "src_set": ""}, "private": true, "genre": "art", "tipped": false, "creator_id": 2182747, "client_id": 2723173, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 17, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@Baconegg_111/works/77", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2182747, "client_id": 2919960, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/4fb943d3/uploads/origins/67a23b7c-ea05-413a-bd7f-d180525397e2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f625cc79c99c76fe6927439bf2056e3c", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/4fb943d3/uploads/origins/67a23b7c-ea05-413a-bd7f-d180525397e2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=27fd00435dc0caf5e0db481d4c90f617", "src_set": ""}, "body": "めとろさま、こんにちは！渡と申します。いつもイラストや創作を拝見しています。めとろさまの絵柄や色選びがとても好きで、私のOCを描いていただきたいと思いリクエストを送信させていただきました！\n\n【キャラクターについて】\n自創作の2人組を描いていただきたいです。\n二人は同じ研究所に勤めており、上司と部下の関係です。基本的に利己的な上司に常識的な部下が振り回されています。\n詳細はgoogle driveに資料を掲載してあるのでそちらを参考にしていただければと思います\n\n【要望など】\n構図など基本的にお任せいたします！暗い雰囲気だと嬉しいですが、描きやすいようにかいていただきたいです...\n\n【使用用途】\nSNSでプロフィール画像への使用、個人での観賞用を考えております。\n\nもし金額不足や不備、その他問題があった場合は再送申請をしていただければ幸いです。何卒ご検討よろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/1oXq5wtPUSw2SWSNeBQ5F_K5epRPGA_4j?usp=sharing", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Baconegg_111/works/76", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2182747, "client_id": 3324339, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/adf0ed82/uploads/origins/fefd8349-1bc4-4ec3-891d-17fb09459586?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=95213913cac773595d59d2d93744a2ca", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/adf0ed82/uploads/origins/fefd8349-1bc4-4ec3-891d-17fb09459586?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d137ea538023624fc5b65a693d720e8b", "src_set": ""}, "body": "はじめまして、鶏間ねんねと申します。\nめとろ様の描かれる仄暗くもポップな絵柄が本当に大好きで、密かに拝見させて頂いております。\nこの度は私のCoCのオリジナルキャラクターを描いて頂きたくリクエスト致しました。\n料金不足等不都合ございましたら再送申請、またはキャンセルお願いします。\n\n【キャラクターについて】\n写実的な描写に派手な色彩を扱う著名な美術家。メッシュの入ったオレンジの長髪と非常に高い身長、目隠しで隠された黄金色の瞳が特徴の女性。優雅な立ち振る舞いに反し、他者に興味が薄く冷たくこちらを遠ざけてくる。\nネタバレ無しの詳細はGoogleドライブにてまとめています。簡易的なもので申し訳ありません。\nhttps://drive.google.com/drive/folders/1iF-UsW47RWyQeGM8iIUFxFiNRjF--PaG\n\n【使用用途】\nSNSや通話アプリ等のアイコン、Xへの掲載（めとろ様のお名前は表記させて頂きます）に使わせていただければと考えております。\n\n【要望など】\n構図等は全てお任せします…！\n資料に乗せている服装は複数ありますが、どれでも描きやすいもので問題ないです。目隠しの有無もお任せします。\nラフや線画、没ラフなどあればPSDに入れて頂けるととても嬉しいです。\n\nskebを利用するのが初めてのため、不備等ございましたら申し訳ありません。\nご検討の程宜しくお願い致します。", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Baconegg_111/works/75", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2182747, "client_id": 3431528, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/825cb0f6/uploads/origins/0487b856-8b98-4342-9c6b-cac276ce56b5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=19132eb5cbc69884e4c28885bd1c92d5", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/825cb0f6/uploads/origins/0487b856-8b98-4342-9c6b-cac276ce56b5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=1e615a6ef6f79e02ff450e0ba3419710", "src_set": ""}, "body": "こんにちは、UTAUのキャラクターTくんのイラストを描いていただきたいです！\n\n■注意事項\n\n☆小麦色の肌\n\n☆頭の両側に突き出たのアホ毛\n\n☆目はTの字型をしている\n\n■キャラクター\n\n性別：男\n年齢：１９～２２歳くらい\n​身長：１７３ｃｍ\n一人称：俺\n二人称：あなた\n好き：コーヒー味キャンディ、「楽しい」こと\n苦手：真面目なこと、苦いもの\n\nとても衝動的。苦いことをくよくよ考えるのが嫌いで、人生を精一杯生きたいと思っている。よく問題を起こすが、悪い人ではない。実は優しい。\n\nカラオケが好きで、お酒に弱い。\n\n構図はお任せしたい！よろしくお願いいたします！\n\nhttps://static.wikia.nocookie.net/utau/images/d/d2/%E7%AB%8B%E3%81%A1%E7%B5%B5%EF%BC%BF202409.png", "nc": 8, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Baconegg_111/works/74", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2182747, "client_id": 2910843, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/51df693d/uploads/origins/82a1b843-3172-4fbe-85ee-ec33708ce72e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7d3a7c487a87da572ff2be4ced6366f7", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/51df693d/uploads/origins/82a1b843-3172-4fbe-85ee-ec33708ce72e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=aff1e2a8d1a6a19267bddbe12847bc88", "src_set": ""}, "body": "初めまして、やきどうふ。と申します\n\nこの度は私の創作キャラクターを描いていただきたく思いご依頼させていただこうと思います\n\nGoogleドライブにて資料と簡易設定を入れさせていただきましたので見ていただけたらと思います\nわかりにくいところがございましたら申し訳ありません\n\nポーズや構図は全てお任せしますが緑の方がタバコを持っていたら大変うれしく思います\n\n使用用途は個人使用(iPadの壁紙への使用)とXへの共有(描いていただいた旨の投稿、めとろさんの名前は表記します)となっております\n\n最後になりましたが最近とても寒くなってきましたのでお身体に気をつけてお過ごしください\n\nhttps://drive.google.com/drive/folders/1E6HMxmNmYrY3ZEVl523-ZFh_jWA7EH94", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Baconegg_111/works/73", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2182747, "client_id": 0, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/9decab60/uploads/origins/9394e45b-d07c-4864-82e3-64708099370f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e3a76bd41161f9f8fce6113a8e6e79dc", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/9decab60/uploads/origins/9394e45b-d07c-4864-82e3-64708099370f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=59f11d6c1227e6d77038e41d026b6f49", "src_set": ""}, "body": "こんばんは。めとろさんが描かれるイラストの近未来的で壮大な世界観がとても大好きで、密かに応援させていただいています。絵柄が本当に大好きです！\nこの度は私のocを描いていただきたくリクエストをお送りしました。\n【キャラクターについて】\n185cm  112kg(かなり気にしている)、ヒトの意識が入っているアンドロイドの悪役です。\n非常に凶暴で乱暴者。ペットの蛇と常に一緒にいます。自分がアンドロイドであることを知らないので、体内の機械や自身の青い血液を見るとパニックを起こします。\n\nGoogleドライブにその他の資料を載せています。\n構図は全てお任せします！流血表現大歓迎です。\n\n用途は個人鑑賞、アクキーなどのグッズ制作です。もしよろしければ、キャラクターと背景を分けたPSD形式で納品していただけるととても嬉しいです。グッズは非営利かつ配布なしの個人使用です。\n\nご検討の程よろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/1avGZBQginKJYr3NYEzxgNOgWAPWxULQk", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Baconegg_111/works/72", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2182747, "client_id": 3314849, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/97c34c4c/uploads/origins/3857f131-4330-4bcc-ab71-b28f50a0d1cb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1864efc191d4ff74d74f66bb92adff95", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/97c34c4c/uploads/origins/3857f131-4330-4bcc-ab71-b28f50a0d1cb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=8568d60bd339d9022d185823e9a7cdec", "src_set": ""}, "body": "はじめまして、VTuberのらむだと申します。\nいつも素敵な創作やイラスト陰ながら拝見しております。\nskebを再開されたという事で是非イラストをお願いしたいです…！\n描いて頂きたいのは自分自身の代理キャラクターとOCの二人になります。\n\nデザインは下記です\nhttps://drive.google.com/drive/folders/1fXS-fEOeg6L8KDk7w-0Ee___kWl5qtlf?usp=sharing\n\n色合い、髪型、シチュエーション、構図など全ておまかせします。\n二人の関係性が分かるようなイラストだと嬉しいです。\n\n【キャラクターについて】\nらむだ(ピンク髪の方) \n欲に駆られて禁じられた魔術に手を出したために、厳格な法に背いたとして天界から追放された羊の堕天使です。天に復讐するため、今は現実世界で黒魔術を絶賛勉強中。感情豊かで元気な成人男性ですが、精神年齢は１６歳くらいのクソガキです。\n\nデルタ(緑髪の方)\n同じ運命をたどった一角獣の堕天使です。元々は夢の守護者であり、現実世界の人間を悪夢から守っていましたが、らむだを助けるために悪夢の魔術に触れたことで追放。クールで無表情なハイスペック成人男性で、現実世界で危険な状況に陥り続けるらむだの保護者担当です。\n\n【使用目的】\n頂いた作品はTwitter/YouTube等の各種SNSで使用させて頂ければと考えております。（収益化されてません）\n\n何卒、ご検討のほどよろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/1fXS-fEOeg6L8KDk7w-0Ee___kWl5qtlf?usp=sharing", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Baconegg_111/works/71", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2182747, "client_id": 3024264, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/eafdf786/uploads/origins/b6b5512e-00e1-4a46-96c0-0fac15fdf9ff?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c0cc2bafa06bf7ea990e21945457eda8", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/eafdf786/uploads/origins/b6b5512e-00e1-4a46-96c0-0fac15fdf9ff?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f107feb2aea9f787a56ffaf4fc7e2be4", "src_set": ""}, "body": "めとろさんこんにちは。\nめとろさんの描かれる素敵なイラスト、世界観が大好きでいつも楽しく拝見しております。\n絵柄やタッチ、色の塗り方も大好きで、陰ながら応援しております。\n\nもしよろしければ、私のocを描いていただけないでしょうか。\n\n【キャラクターについて】\nテオ(帽子をかぶっている方)\n170センチ　男\n・基本的にいつも笑顔で敬語で話す\n・目の上が隠れるくらい帽子を深くかぶっている\n・言われたことは大体何でもする(逆に指示がないと何もできない)\n・なんでも屋で、クリーンな仕事もするが、殺しや逃がし、運びなどの裏向きの仕事が多い\n・身軽で、銃の扱いが上手い\n\nニーナ(モサモサ頭ヘアピンの方)\n169センチ　女性の格好をしているが男\n・表情があまり変わらない\n・言うことを聞いてくれる人が好き\n・人に対して「〜して」とお願いすることが多い\n・常にテオの近くにおり、主に殺しの仕事を行う\n・殺しの仕事ではバールやトンカチのような工具を用いる\n\n【二人の関係性について】\n・仕事の同僚で、よく行動を共にしている\n・よくテオがニーナのお願いを聞いている\n・歪な関係に見えるが普通に仲は良い\n・ニーナ→テオの距離が近い\n・テオはニーナが男であることを知らないが、知ったとしても特に対応は変わらない\n\n描いていただいたイラストは個人観賞用にしたいと思っております。構図はお任せします。\nご検討いただけると幸いです！🙇🙇\n\nhttps://drive.google.com/drive/folders/1jU7lfB6xlxriOoba_FeHrBiwWrdWkHgc", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Baconegg_111/works/70", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2182747, "client_id": 0, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/9a0a83a5/uploads/origins/cac90f92-6952-4e9a-9e52-2a7e93345d6a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=66fad88f86116eaed96bd501492ee070", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/9a0a83a5/uploads/origins/cac90f92-6952-4e9a-9e52-2a7e93345d6a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c09f35f4f20f143502f1e5742cba8d78", "src_set": ""}, "body": "めとろさんこんにちは！\nいつも陰ながら創作拝見しております。\nめとろさんの描かれるイラスト本当に絵柄や色合い、表情全てが大好きです！\n今回ぜひめとろさんに自創作のキャラクター達を描いてもらいたく、リクエストを送らせて頂きました。\n\n【キャラクター】\n自創作の研究者達を描いて頂きたいです。\n(資料URLに詳しく掲載しています)\n・所長\n絵画捜索研究所　「raison d'être」の所長。フランクで明るい性格だが、快楽主義者の謎多き人物。\n・ロゼ\nraison d'êtreを陰で支える副所長。頭脳明晰。生まれた家系が因習的で父親に過度なトラウマを持つ。\n\n\n金額的に2人が難しければどちらかでも大丈夫です…！\n\n【要望】\n雰囲気、構図は全てお任せします\n\n【使用用途】\n個人鑑賞用(スマホ、タブレット端末のホーム画面など)に使用したいと思っています！\n\n\n最近寒暖差が激しい季節の変わり目ですので体調面お気をつけください！\n\nhttps://drive.google.com/drive/folders/1-8gIzkj_14ms4tK9ajMScv4EymJ5g3pD", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Baconegg_111/works/69", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2182747, "client_id": 2850170, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/8ee5db1e/uploads/origins/0ad7eccd-fb51-4e94-ac81-8803a4db13d0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6ceba92ff791519ca27679a33499c70b", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/8ee5db1e/uploads/origins/0ad7eccd-fb51-4e94-ac81-8803a4db13d0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d0f4d9041e8f7295a1316bac62889aa9", "src_set": ""}, "body": "めとろさん、こんばんは！\n前回は素敵なイラストを本当にありがとうございました。\nまた依頼出来ればと考えておりました…。今回も私のOCをご依頼したく思います。\n\nキャラクターの概要(読み飛ばして頂いても構いません！)\n名前　ケルシー・アバークロンビー\nかなり大雑把な性格で怖いもの知らずな明るい女性です。戦闘が大好きで、とても血の気が多いです。容姿も声も男性のようですが彼女自身自分が女性であることを大事に思っているため\n定期的に可愛い服を着たりしています(可愛い服を着ているときも声が低いことは変わっていません)。\n\n資料には色々な衣装がありますが どの衣装を描いて頂いても大丈夫です！構図やポーズなどもおまかせいたします。\n\n描いていただきましたイラストはスマホのホーム画にして眺めたいと思っています。\nまた彼女の誕生日のためのグッズ制作を密かにしているので、その際めとろさんに描いていただいたイラストもグッズの絵柄に追加したいと考えております。(缶バッジを予定しています)\n\nラフや線画、没ラフなどがありましたらPSDに入れていただけると大変嬉しいです！\n金額不足の場合は遠慮なく再送要請をお願いいたします。\nご検討のほどよろしくお願いいたします！\n\nhttps://drive.google.com/drive/folders/1CByw_rdcVoB56QmPHG2Z66tXkyFp7MB4", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Baconegg_111/works/68", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/0d89ac7d/uploads/origins/f6eff71b-bfc1-4545-b6ef-88f9f074b19b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=0a71a89b173c76520cec8305fc5a6ca7", "src_set": ""}, "private": true, "genre": "art", "tipped": false, "creator_id": 2182747, "client_id": 18462, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 17, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@Baconegg_111/works/67", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2182747, "client_id": 3150572, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/d57eb7b8/uploads/origins/b521a789-446e-41c4-985a-bf82be23f543?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d26629628da139c4696a3a0d1d27f505", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/d57eb7b8/uploads/origins/b521a789-446e-41c4-985a-bf82be23f543?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e076afc0254e52a4714b29fd93494483", "src_set": ""}, "body": "初めまして、skeb失礼致します。\nとあるシナリオを通った探索者達を描いていただきたいです。\n料金不足でしたら再送お願いします！\nhttps://skeb.jp/@Baconegg_111/works/55\nめとろさんの作品の中でこちらの作品がとても好みな為似た雰囲気ですとありがたいです。\nまた、使用用途と致しまして。SNSのアイコン、個人鑑賞用の非売品グッズとして使用させていただきたいです。\n\n\n三色の髪色の方\n柊　紫水（ひいらぎ　しすい）\n24歳\n181cm\n生真面目でプライドの高いキャリア組のエリート刑事、とある事情でカズラのことを気にかけているためあまり強く出れない、が口は悪い。\n過去恋人の椿を亡くしておりそれのせいで大切な人を亡くしたカズラを気にかけているし過保護になっている、が本人は気づいていない。\n最近は自分の知らないところで何かあったらしく、それでカズラが仕事中も休憩中もずっとひっつき虫になっている事に困惑している。\n「…柊紫水、刑事をやっている。挨拶はこれで良いだろ」\n\n「…カズラ、離れろ。書類整理ができないだろ……ぐりぐりしてもダメだ」\n\n\nー\n\n緑髪で蝶のアクセサリーがついている方\n深繞 カズラ（みめぐり　かずら）\n26歳\n188cm\nへらへらとしていて何を考えているのかわからない飄々とした男性、語尾に伸ばし棒がつくことが多い。\n紫水に対しては「おもしろ〜」くらいしか思っていなかったが、最近事故で紫水を失いかけて大切さに気づいた。1日に1回は心臓の音を確認しないと安心しない。\n紫水に執着しているため、仕事が終わった後職場にいる紫水に寄りかかったり抱きついたりしている。\n冬瓜という名前の弟を失っており蝶のアクセは弟の形見。\n\n「オレ〜？俺は深繞カズラ、別に覚えたくないなら覚えなくても良いよ」\n\n「…紫水サン、今日機嫌悪い？いつもだったらもう少しくっついても許してくれるじゃん」\n\n\nー\nシナリオ通過前とシナリオ通過後でどちらとも髪型が変わっているのですが、今回はシナリオ通過後の髪型、仕事服姿でお願いいたします！（服の詳細などはおそらくシナリオ通過前の方を参照すると書きやすいです。）\nおそらくdriveの画像ファイル名を参照するとわかりやすいと思います！細かいデザインや書きずらい所などありましたら簡略化していただいてかまいません！\n\nhttps://drive.google.com/drive/folders/109uYkuDzITySrg1Iqqs-qp2dk6ypvTqF", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Baconegg_111/works/66", "private_thumbnail_image_urls": nul