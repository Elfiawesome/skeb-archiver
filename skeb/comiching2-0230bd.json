_only_public": false, "tip_acceptable": true, "yearly_report_client_visible": false, "total_appeals_count": 0, "received_works": [{"path": "/@comiching2/works/14", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1275399, "client_id": 180981, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/86aefb93/uploads/origins/a3081511-3901-4028-971e-41c9629e4a10?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=159e898d31e7c5449e94bbf7576a72c7", "srcset": "https://si.imgix.net/86aefb93/uploads/origins/a3081511-3901-4028-971e-41c9629e4a10?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=159e898d31e7c5449e94bbf7576a72c7, https://si.imgix.net/86aefb93/uploads/origins/a3081511-3901-4028-971e-41c9629e4a10?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a40b032ad48447401a9f3ed8fbd5323a 2x, https://si.imgix.net/86aefb93/uploads/origins/a3081511-3901-4028-971e-41c9629e4a10?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d488768c2a8c3c064a759c10dbc9bbc3 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/86aefb93/uploads/origins/a3081511-3901-4028-971e-41c9629e4a10?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=4852e360e1f631760a8b057adfddd925", "srcset": "https://si.imgix.net/86aefb93/uploads/origins/a3081511-3901-4028-971e-41c9629e4a10?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=4852e360e1f631760a8b057adfddd925, https://si.imgix.net/86aefb93/uploads/origins/a3081511-3901-4028-971e-41c9629e4a10?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=f12c7f1926c20e3217c4db4a912b664d 2x, https://si.imgix.net/86aefb93/uploads/origins/a3081511-3901-4028-971e-41c9629e4a10?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=3e7d292d3d318218956539af8594c879 3x"}, "body": "今回もアーボックと時津風をお願いします。\n\nアーボックは時津風の首から下を４巻程で隙間なく巻き付け、時津風の頭の上に頭を乗せ鼻の付近まで舌を出して下さい。アーボックの口は閉じて頂き、全身が巻き付かれている構図でお願いします。\nできればアーボックは通常色と色違いをお願いします。\n又、さらに大丈夫ならアーボックの尻尾で首を巻き付けているパターンと巻き付けていないパターン(どちらかでしたら巻き付けていないパターン)をお願いします。\n\n今回はお腹をすかせたアーボックが時津風を獲物と勘違いしてしまい、牙で毒を注入されてしまった後という設定でお願いします。首元に毒牙で噛まれた跡を描いて頂きたいのですが（描きたくない場合は描かなくても大丈夫です）少し青ざめている程度で、流血表現などはなしでお願いいたします。\n\n時津風の表情は\n①「うう・・・」と逃げようと力を入れて抵抗するが全く効果がない。\n②毒が回りはじめ、抵抗する力が弱くなっていく。\n③毒が身体に回ってきて若干意識がもうろうとしてくる。\n④締め付けと毒で体力が尽きそうになり「ああ・・・もうだめ・・・」となる。\n⑤眠るように力尽きてしまう。\nでお願いします。\n表情の追加や導入部分、事後など、追加部分があっても大丈夫です。\n今回もワガママばかり申し訳ございません。ご検討お願い致します。", "nc": 48, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@comiching2/works/13", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/8a0cec24/uploads/origins/e01a5866-e061-416a-a431-81963460dfc2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=7033e83141d80ff518614a53691cbf50", "srcset": "https://si.imgix.net/8a0cec24/uploads/origins/e01a5866-e061-416a-a431-81963460dfc2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=7033e83141d80ff518614a53691cbf50, https://si.imgix.net/8a0cec24/uploads/origins/e01a5866-e061-416a-a431-81963460dfc2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=b90ca82c31fcdb7f2362e3f14bc86720 2x, https://si.imgix.net/8a0cec24/uploads/origins/e01a5866-e061-416a-a431-81963460dfc2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=1a69d1a767586c9c7674cc95cf724645 3x"}, "private": tr