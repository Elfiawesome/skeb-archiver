-a210-89549a016e88?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=732f5a1887ef3fd5e9a444de9794d22e, https://si.imgix.net/eaa5b77f/uploads/origins/43e106b6-ac08-45cc-a210-89549a016e88?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a14494f0dfa3348cc56f35614b8168b6 2x, https://si.imgix.net/eaa5b77f/uploads/origins/43e106b6-ac08-45cc-a210-89549a016e88?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=089e6f1fbc9f5c8a3e3c1256c78f2802 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/eaa5b77f/uploads/origins/43e106b6-ac08-45cc-a210-89549a016e88?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e3efe4e214b784e60803f0bb75d73742", "srcset": "https://si.imgix.net/eaa5b77f/uploads/origins/43e106b6-ac08-45cc-a210-89549a016e88?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e3efe4e214b784e60803f0bb75d73742, https://si.imgix.net/eaa5b77f/uploads/origins/43e106b6-ac08-45cc-a210-89549a016e88?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=0cb7f050f87b4bf33f540a987b0addcd 2x, https://si.imgix.net/eaa5b77f/uploads/origins/43e106b6-ac08-45cc-a210-89549a016e88?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=d2eb9ef872ac10578da3789e3876941b 3x"}, "body": "今回もアーボックと時津風でお願いします。構図は参考URL（https://skeb.jp/@utbutb/works/105 )のように、3~4巻で全身を巻き付けている部分は変わりませんが、横から時津風を睨みつける感じお願いします。 \n\n状況としてはアーボックと時津風は仲が良い設定ですが、時津風がちょっかいを出しすぎて、アーボックが怒って時津風を巻き付けている場面です。\n\nアーボックは舌を出しながら、時津風を睨みつけて威嚇しています。口は閉じてください。また、尻尾は首を絞めていないのとしているもの（どちらかの場合はしていないもの）を頂きたいのですが、締め付けていない場合は時津風の後ろでいつでも追加で巻き付けられるように待機しているような感じでお願いします。また、更に大丈夫でしたら色違いもお願いします。\n\n時津風の表情は（全てが無理でしたら④と③を優先的にお願いします）①「うう・・・巻き付かれちゃった・・・」という感じでアーボックから目線を背けるようにしている。②アーボックの方を見ながら「ねえ・・・許してよ・・・」という感じでアーボックの方に目線を向ける。③しかし、アーボックの締め付けが始まり、いつもより強く長い時間締め付けられて気絶しそうになる。力尽きそうになり必死に意識を保とうとするが、ボーっとしたような表情になっている。④力尽きて寝ているように気絶してしまう。\n\n④のみ目を閉じて、①〜③は目を開けて下さい。表情ですが、大丈夫でしたら④に赤面と青ざめているものをお願いします。", "nc": 177, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@comiching2/works/9", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/3f46a3e1/uploads/origins/a7beb0d4-4405-4e91-b8e5-311bc391fa0e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=a8a588835d1802bc3d7842883c2b5281", "srcset": "https://si.imgix.net/3f46a3e1/uploads/origins/a7beb0d4-4405-4e91-b8e5-311bc391fa0e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=a8a588835d1802bc3d7842883c2b5281, https://si.imgix.net/3f46a3e1/uploads/origins/a7beb0d4-4405-4e91-b8e5-311bc391fa0e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=543d9a7836a37970d1dcf8bd938936eb 2x, https://si.imgix.net/3f46a3e1/uploads/origins/a7beb0d4-4405-4e91-b8e5-311bc391fa0e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=493be6ec72be3282424589afa998ad1d 3x"}, "private": true, "genre": "art", "tipped": true, "creator_id": 1275399, "nc": 161}, {"path": "/@comiching2/works/8", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1275399, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/437c0631/uploads/origins/43b898eb-e67b-439e-bbc4-e63fa86d55d1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8056171f4481c111435c981bff78d35d", "srcset": "https://si.imgix.net/437c0631/uploads/origins/43b898eb-e67b-439e-bbc4-e63fa86d55d1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8056171f4481c111435c981bff78d35d, https://si.imgix.net/437c0631/uploads/origins/43b898eb-e67b-439e-bbc4-e63fa86d55d1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=86c29be4d41be4bff19e7fea59ef7a25 2x, https://si.imgix.net/437c0631/uploads/origins/43b898eb-e67b-439e-bbc4-e63fa86d55d1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b629a2859e852395fb931e8fb58ad10e 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/437c0631/uploads/origins/43b898eb-e67b-439e-bbc4-e63fa86d55d1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c3b2b8fb579f0137eb19bbedb1f24d9b", "srcset": "https://si.imgix.net/437c0631/uploads/origins/43b898eb-e67b-439e-bbc4-e63fa86d55d1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c3b2b8fb579f0137eb19bbedb1f24d9b, https://si.imgix.net/437c0631/uploads/origins/43b898eb-e67b-439e-bbc4-e63fa86d55d1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=e5b151f7c0bd462e396921fa6b99bc12 2x, https://si.imgix.net/437c0631/uploads/origins/43b898eb-e67b-439e-bbc4-e63fa86d55d1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=ca724ce89b153e198cb35221a460cfa6 3x"}, "body": "アーボックに巻き付かれいる東北きりたんをお願いします。\n\nきりたんの表情は\n\n①（まだ締め付けが強くなく）ざあこ♡ざあこ♡とメスガキ感を出して煽る。\n②締め付けが強くなりビクってする。\n③逃げようとするが全身巻き付かれいるので無駄な抵抗になっている。「は、離せ〜」と強がっている。\n④締め付けが強くなり目を瞑って苦しむ。\n⑤だけど癖になったのか、締め付けは続いているのに笑顔になっている。\n\n④だけ目を閉じ、他は目を開けてください。\n\n以下はデビラさんの文章をお借りしています。\n\nアーボックはきりたんの首から下を４巻程で隙間なく巻き付け、時津風の頭の上に頭を乗せ鼻の付近まで舌を出して下さい。\n全身巻き付かれている事を強調する為、きりたんの全身（しつこくて申し訳ございませんが首から下は足も見えないぐらい隙間なく全身巻き付けて下さい）を描いて頂けるとうれしいです。\n又、できればアーボックは通常色と色違いをお願いします。\n又、さらに大丈夫ならアーボックの尻尾で首を巻き付けているパターンと巻き付けていないパターン(どちらかでしたら巻き付けていないパターン)をお願いします。", "nc": 169, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@comiching2/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1275399, "client_id": 180981, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/55f26088/uploads/origins/05d95009-6fdd-4be9-9fee-5ee8ea99abc6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8a481e3c51dc016107d5b68ff3fe0578", "srcset": "https://si.imgix.net/55f26088/uploads/origins/05d95009-6fdd-4be9-9fee-5ee8ea99abc6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8a481e3c51dc016107d5b68ff3fe0578, https://si.imgix.net/55f26088/uploads/origins/05d95009-6fdd-4be9-9fee-5ee8ea99abc6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=1c41ecd7caaff02872d6f40655de51a0 2x, https://si.imgix.net/55f26088/uploads/origins/05d95009-6fdd-4be9-9fee-5ee8ea99abc6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=bad791d2c79b63bd3417159f2ddf5f4c 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/55f26088/uploads/origins/05d95009-6fdd-4be9-9fee-5ee8ea99abc6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=8dc0b1d92a3af19f6b1502f52aac562d", "srcset": "https://si.imgix.net/55f26088/uploads/origins/05d95009-6fdd-4be9-9fee-5ee8ea99abc6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=8dc0b1d92a3af19f6b1502f52aac562d, https://si.imgix.net/55f26088/uploads/origins/05d95009-6fdd-4be9-9fee-5ee8ea99abc6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=bdc2eb49c007b7f92825c01317bca647 2x, https://si.imgix.net/55f26088/uploads/origins/05d95009-6fdd-4be9-9fee-5ee8ea99abc6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=8b6c22b93e554aeab042b1004ce8a0bb 3x"}, "body": "今回もアーボック時津風をお願いしたいのですが、R-18要素が強いので、無理な場合はキャンセルして下さい。\n\nいつものように巻き付かれる時津風ですが、今日はムラムラしていて、全裸でアーボックに締め付けと、尻尾でお股をいじってほしいとお願いしていると想定でお願いします。\n\n構図はいつものような４〜５巻前後で全身隙間なく巻きつく構図ですが、今回はお股の部分だけは巻き付かないで下さい。\n\nシーンとしては\n①全身締め付けに加え、すじの上に尻尾を乗せるように締め付けている。この時お股も締め付けられてる事により、苦しみながらも性的に興奮している。\n②挿入する為に尻尾を動かし始める。その時にすじに沿って動いている為、擦れて気持ちよくなる。\n③尻尾の先っぽをすじの部分にピタっとくっつける。時津風も「入れられる・・・！」と性的にドキドキしている。\n④ゆっくり入り初める。気持ち良すぎて暴れようとするが、全身巻きつかれているのに加えて暴れた事により締め付けが強くなり「やめて・・・！苦しい・・・！」となりながらも興奮している。\n⑤尻尾が一番奥まで入り、適度に強い締め付けにより、笑顔で感じでいる。\n\n表情１枚につき１枚でも漫画形式でも大丈夫ですが、どちらでも大丈夫なら表情１つにつき１枚ずつお願いします。\n\n時津風の目は④以外は開けて下さい。また、感じていると描いてありますが、個人的ですがアヘ顔は苦手なので描かないで頂きたいと思います（ポワーンと気持ちよくなっている感じでお願いします）\n\n又、これは全く違う構図になりますのでご予算に合わない場合は大丈夫ですが、①の前に\n①時津風が全裸にアーボックに抱きついて「お願い・・・締め付けて・・・！」とおねだりする。\n②アーボックが巻き付け初めて「あ、巻き付き始めた・・・！」というシーンもお願いします。\n\nまた、今回大丈夫でしたらアーボックは半透明状態、またアーボックがいない状態（どちらかの場合は半透明状態）があれば嬉しいです。\n\nご予算に見合う範囲内でお願いします。また、もしお値段には見合わないけど別途で描いてある①と②は描いて頂ける場合は再送リクエストなどで値段提示をして頂ければ嬉しいです（お値段により検討いたします）\n\n優先順位としては表情→締め付けられる前の追加→半透明、アーボックのなしですが、ご予算で完結の場合はお任せします。", "nc": 48, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@comiching2/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1275399, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/46137d70/uploads/origins/6a348cf9-6562-4bc5-966e-fc1d768ac1fa?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e12bc8d9632163a428e99b3eee3bce8a", "srcset": "https://si.imgix.net/46137d70/uploads/origins/6a348cf9-6562-4bc5-966e-fc1d768ac1fa?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e12bc8d9632163a428e99b3eee3bce8a, https://si.imgix.net/46137d70/uploads/origins/6a348cf9-6562-4bc5-966e-fc1d768ac1fa?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=47278672a2509fa79e0ec44394c61ddb 2x, https://si.imgix.net/46137d70/uploads/origins/6a348cf9-6562-4bc5-966e-fc1d768ac1fa?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=06c7906976916bb5b6a055a972074b50 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/46137d70/uploads/origins/6a348cf9-6562-4bc5-966e-fc1d768ac1fa?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=84afbb224ef48146db4d552e657ec6ae", "srcset": "https://si.imgix.net/46137d70/uploads/origins/6a348cf9-6562-4bc5-966e-fc1d768ac1fa?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=84afbb224ef48146db4d552e657ec6ae, https://si.imgix.net/46137d70/uploads/origins/6a348cf9-6562-4bc5-966e-fc1d768ac1fa?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=5f789e99b53e68bef3f97de10cf11bc0 2x, https://si.imgix.net/46137d70/uploads/origins/6a348cf9-6562-4bc5-966e-fc1d768ac1fa?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=b7cd7452e112f1d5d882170d787bc250 3x"}, "body": "アーボック時津風のような感じで「アズールレーン」の陸奥をお願いできませんか？\n以降、デビラさんの文章を使わせて頂いております。\n\nアーボックは陸奥の首から下を４巻程で隙間なく巻き付け、陸奥の頭の上に頭を乗せ鼻の付近まで舌を出して下さい。口は閉じて下さい。\n全身巻き付かれている事を強調する為、陸奥の全身（しつこくて申し訳ございませんが首から下は足も見えないぐらい隙間なく全身巻き付けて下さい）を描いて頂けるとうれしいです。\n又、できればアーボックは通常色と色違いをお願いします。\n又、さらに大丈夫ならアーボックの尻尾で首を巻き付けているパターンと巻き付けていないパターン(どちらかでしたら巻き付けていないパターン)をお願いします。\n\n陸奥の表情ですが、大丈夫でしたら（無理なようでしたら①と④を優先でお願いします）又、できればどの表情もアーボックは通常色と色違いをお願いします。\n①締め付けられて涙目で苦しんでいる（目は閉じています）\n②苦しんでいるけど若干感じていて赤面になっている（目は閉じています）\n③苦しいけど若干気持ちよくて恥ずかしがっている（目は開けています）\n④嬉しくて締め付けられているのに笑っている（目は開けています）", "nc": 40, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@comiching2/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1275399, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/6b300ef1/uploads/origins/597d5c12-4675-47dc-b569-9d3af346f78c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=60566abd3d7e787