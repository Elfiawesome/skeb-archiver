s=109924a3a45c7dc39353df5796d1fddf, https://si.imgix.net/1d73ba64/uploads/origins/01338208-641f-4d5f-904a-c91495bc88f4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=135c05b2afc8b661845d461d2cc8cbc7 2x, https://si.imgix.net/1d73ba64/uploads/origins/01338208-641f-4d5f-904a-c91495bc88f4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=fc2e8676982c57a32f1267f5a1de9ab0 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/1d73ba64/uploads/origins/01338208-641f-4d5f-904a-c91495bc88f4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=20300ed1c6bb66f24c42dd69f9795890", "srcset": "https://si.imgix.net/1d73ba64/uploads/origins/01338208-641f-4d5f-904a-c91495bc88f4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=20300ed1c6bb66f24c42dd69f9795890, https://si.imgix.net/1d73ba64/uploads/origins/01338208-641f-4d5f-904a-c91495bc88f4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=ba225724a29093ad9366bd6cc7d879ee 2x, https://si.imgix.net/1d73ba64/uploads/origins/01338208-641f-4d5f-904a-c91495bc88f4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=8608157414b83e08d730602508b52231 3x"}, "body": "さいんさんのアートスタイルが好き!\nよければ私のキャラクターを描いてもらえませんか？どちら服でも構いません。\nできれば両方とも短パンでお願いします!\n表現の差分/ドラフトがあれば、psdに入れてどうもありがとうございました。\n\n茶色の方は現役将校で、「主と神」の存在を信じています（カトリックに似ています）。196cmです。優しくていい人そうに見えますが、実際はとても冷めていて、好きな人以外のことは気にしない人です。お菓子やお菓子作りが好きで、監視カメラなどの安心できるものが好き。スライダーは嫌いです。\n青い髪の方は、大学に通う士官候補生で、教会の聖歌隊に所属していたことがあり、クラシック音楽や光り物が好きで、内向的で陰気で冷静な性格という設定です。そうでなければ、自分よりも他人に生きてもらいたい、だからいつも傷ついている、そんな少し偏執的で本来は狂気に満ちた性格のキャラクターです。\nなお、青の左目は白の瞳、緑の右目は黒の瞳をしています。\n2人はかつて同じ孤児院にいた幼馴染で、茶髪の方は青髪のキャラクターが歌うのをとても気に入っていたそうです。\n今では同志の関係で特殊部隊であり、生涯の友情を持ち、ソウルメイトの関係よりも信頼し合っています。\n茶髪のキャラクターを生かすために、青髪のキャラクターは茶髪のキャラクターに常に血液のようなものを提供していました（輸液バッグの中の赤い血液ではなく、基本的には銀色の液体です）。\n自由に描いてください。\n\n使用について（お名前がクレジットされます。\n*SNSのアイコンとして、個人のオリジナルキャラクターサイトに表示する。\n*個人での使用やライブ配信での壁紙としての使用（非商用）。\n>友人へのグッズ印刷\n\nhttps://drive.google.com/drive/folders/1xgGrhPT58NKZpbVp8lcbx9psCJ0WKfdH?usp=sharing\n\nhttps://drive.google.com/drive/folders/1uUD4tmIAvG_tq3OvBESWxmw1TKbBVgo7?usp=sharing", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@sabi___neko/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 371196, "client_id": 477681, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/2216b788/uploads/origins/9fbf8f35-3e1a-42d4-a5f3-a1b709c8de36?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f05deabb05439fe03f96f5f946fa8a13", "srcset": "https://si.imgix.net/2216b788/uploads/origins/9fbf8f35-3e1a-42d4-a5f3-a1b709c8de36?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f05deabb05439fe03f96f5f946fa8a13, https://si.imgix.net/2216b788/uploads/origins/9fbf8f35-3e1a-42d4-a5f3-a1b709c8de36?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=3b5bbc0d3b797cfd470ee44017fbd8e4 2x, https://si.imgix.net/2216b788/uploads/origins/9fbf8f35-3e1a-42d4-a5f3-a1b709c8de36?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=92adfa422a03141a7890617c95c4e5a2 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/2216b788/uploads/origins/9fbf8f35-3e1a-42d4-a5f3-a1b709c8de36?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=35d901bd6ce32cb56c727371f643825d", "srcset": "https://si.imgix.net/2216b788/uploads/origins/9fbf8f35-3e1a-42d4-a5f3-a1b709c8de36?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=35d901bd6ce32cb56c727371f643825d, https://si.imgix.net/2216b788/uploads/origins/9fbf8f35-3e1a-42d4-a5f3-a1b709c8de36?bg=%23fff&auto=format%2