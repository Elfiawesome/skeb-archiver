i.png?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=14d35916b479ba583996e1c5f9aad5db, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F478555429065076738%2FKFnUiTii.png?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c642f37c3be5ff84f05a4a5ed4915fff 2x, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F478555429065076738%2FKFnUiTii.png?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=6ac56b19482e7f7d3e967c4298e7e3b9 3x"}, "preview_url": "https://fcdn.skeb.jp/uploads/outputs/d3a15a63-44bf-4cbd-935c-a356b7786a56?response-content-disposition=inline&Expires=1784363806&Signature=MR-u-Qbah~1w49sklSFw-efDGneEMImvu0XHPglZWFWImSL2v998bggbmH3Mw7MFsrTi5QsH3SbAp9Ep8zm4qBXNqav91ooDrAOHNH~hXWnU5x1yo0myFeztB-MMD~d9j8Ytz1VG2hAfjjhFWoi7pQQSAIAQHGWdNQyFDra4Su-nZN94CAw3iY~XK4JWx2qJACpL42ZsETxnbEWM8rV7beIi39frXN~GFjVpktKv3P28Vhhn4cGkj27rf5jk2~iVd-ouJPXHOLme8Fs9AJXSbBL13x0BkADV5nIYGshaVy4W1deIwGs9DAX92zaCaEFQQ23FTVdfP2ViHGEz~0pCHg__&Key-Pair-Id=K1GS3H53SEO647", "duration": 83, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F478555429065076738%2FKFnUiTii.png?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=30e72a817231960a36d994d46596bf8e", "srcset": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F478555429065076738%2FKFnUiTii.png?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=30e72a817231960a36d994d46596bf8e, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F478555429065076738%2FKFnUiTii.png?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=ae4e0ec1d34c384583f53afbba2e19df 2x, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F478555429065076738%2FKFnUiTii.png?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=4b09e1a9cc0783ca6aeaf52272638304 3x"}, "body": "napi 様　こんばんは！\nnapi様の切なく綺麗な曲調がとても好きで、ゲーム制作のBGMとしてよく利用させて頂いております。\n\nもしご興味がありましたら、以下のリクエスト内容で曲を書きおろして頂きたいです。\n\n【概要】\n・ゲームの通常戦闘BGM\n・ループogg形式\n・和風・雪がキーワード\n・ピアノ系の音が中心\n\n\n\n【世界観】\n人々が神に敗れ、世界が白く染められようとしている厳しい雪の世界です。\n和風を基調としたとある部族の若者たちが主人公の物語です。\n\n【画像資料】\n（https://photos.app.goo.gl/kMDdWKcyaD3UPNKcA）\n\n【イメージBGM】\n・いけにえと雪のセツナ　より、「BGM　バトル1」\n（https://www.youtube.com/watch?v=vNE8LXfeWNk&list=PLtuWHmQ46-zKTDYAk4TEGC56dfYfO5gkl）\n\n・napi様作曲　戦闘用BGM「ツキカグヤ」・「神様の季節」\n\n（参考補足）\n・厳しい雪の世界観としては「神様の季節」が近いですが、少し激し過ぎるので通常戦闘に合うようマイルドにしたイメージ。\n・和風イメージとしては「ツキカグヤ」が近いですが、少し華やかすぎるので、雪世界に合うよう素朴にしたイメージ。\n・全体のイメージとしては「いけにえと雪のセツナBGM　バトル1」の雰囲気で、流れるような耳に残るメロディーが挟んであるイメージ。\n（0:25～0:27、または0:38～0:45あたりのようなメロディーの流れに強弱のある感じです）\n\n【その他】\n同時に使用させて頂く予定のBGM\n（※世界観のイメージや各場面のシーンのイメージに近いBGMです）\n\nタイトル画面BGM\n→「雪風」\n\n強敵戦\n→「神様の季節」\n\nイベント戦\n→「光彩のクリスティア」\n\n特殊エネミー戦\n→「プシュコマキア」\n　「戦奏歌劇」\n　「月日知らずのターリア」\n　「反魂時計」\n\n最終ボス戦\n→「千の光は全て星」\n\n以上、よろしくお願いいたします。", "nc": 0, "word_count": 0, "transcoder": "audio", "creator_acceptable_same_genre": false}], "sent_works": [], "similar_creators": [{"id": 1145073, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "夜湾/yowan.", "screen_name": "p_yowan", "avatar_url": "https://pbs.twimg.com/profile_images/1939680766125858816/gCDLGgGK.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1270290218747215873/1751344656/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 3, "complete_expiration_days": 10, "skills": [{"genre": "music"}, {"genre": "correction"}], "banned": false, "nc": 17}, {"id": 1299651, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "柴結び(shiba.musubi)", "screen_name": "shiba_musubi", "avatar_url": "https://pbs.twimg.com/profile_ima