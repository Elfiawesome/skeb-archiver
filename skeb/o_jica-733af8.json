3d7cfd7c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c66b86435d6f4b46a53f7d22ea58c3e3, https://si.imgix.net/61473b30/uploads/origins/0b7df255-fb1c-48bb-b042-09633d7cfd7c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=cd064f2bef6a5b66575915581482562e 2x, https://si.imgix.net/61473b30/uploads/origins/0b7df255-fb1c-48bb-b042-09633d7cfd7c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=06c0e32eb138a173c57f5e54bc52bd17 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/61473b30/uploads/origins/0b7df255-fb1c-48bb-b042-09633d7cfd7c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=45c41051f6404b0b1b0695844a7966c5", "srcset": "https://si.imgix.net/61473b30/uploads/origins/0b7df255-fb1c-48bb-b042-09633d7cfd7c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=45c41051f6404b0b1b0695844a7966c5, https://si.imgix.net/61473b30/uploads/origins/0b7df255-fb1c-48bb-b042-09633d7cfd7c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=378697589a588e931ed2b344a452dac6 2x, https://si.imgix.net/61473b30/uploads/origins/0b7df255-fb1c-48bb-b042-09633d7cfd7c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=54dd987caaeba7e9565b7d3674a18a86 3x"}, "body": "初めまして。カッコイイ中年男性を描ける方だとお見受けしましたのでリクエストした次第です。私のOCである「ザムフィール」を描いて頂けますでしょうか。\n\n参考URL　https://drive.google.com/drive/folders/1QooPKSH4PW0eW6gcVSQc7twhEreRzKtL?usp=sharing\n\n【設定】\n若気の至りでやらかした過去への贖罪も兼ねて研鑽を積み、周りからの信頼を勝ち取った結果、今では冒険者ギルドに所属している職員兼冒険者。（年齢は40代後半～50代前半くらい）冒険者を目指す若者達に、冒険者適性を見極める為の試験官をしたり、冒険に関するいろはをレクチャーしたり。人当たりが良く親切丁寧、褒めて伸ばすのが功を奏したのか周りからとても慕われている。副業で情報屋（諜報活動）をしている。滅多に怒らないが、ガチギレしない訳ではない。職業柄もあって基本的には冷静に、何か憤る事があってもアンガーマネジメントで上手く抑えているが、本質的には豪放磊落・熱い男である。得意武器は狙撃系（弓・暗器等飛ぶ系）＆護身体術的なものを少々。大柄な体格に見合わず無駄に大きな力を使わず且つ効率・要領良く急所を狙うようなスタイル。\n\n【衣装】\n具体的な資料が無くて恐縮ですが、要は冒険者っぽい衣装（得物や防具含め）であればデザインは資料の通りでなくとも全然構わないですし、辻褄の合うようにどう改変していただいても補完していただいてもアレンジしていただいても、逆に省いたりしても全然構わないです。\n\n【その他】\n基本は少々タレ気味の一重の糸目ですが、真剣・本気・ガチギレすると開眼する系の糸目です。※ただ開眼させる場合は開き過ぎないようにあくまで細目の開眼で。\n資料だと瞳にはハイライトなしですが、ケースバイケースでハイライト入れても無しでもお好みで。\n\n以上の設定を元に、基本的には描きやすいようにご自由に描いて頂いて構いません。\nご検討の程、宜しくお願いします。", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@o_jica/works/8", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/708f6033/uploads/origins/9e659fe8-b8ef-4a69-b3a7-75a720f1757f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=c7c7642b1fd52c2d387b4aca9ef93197", "srcset": "https://si.imgix.net/708f6033/uploads/origins/9e659fe8-b8ef-4a69-b3a7-75a720f1757f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=c7c7642b1fd52c2d387b4aca9ef93197, https://si.imgix.net/708f6033/uploads/origins/9e659fe8-b8ef-4a69-b3a7-75a720f1757f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=75bc4075c41bb3bc8eb85ddb707d8ada 2x, https://si.imgix.net/708f6033/uploads/origins/9e659fe8-b8ef-4a69-b3a7-75a720f1757f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=42237dbe05ccf236f00e7bce4cd2a59f 3x"}, "private": true, "genre": "art", "tipped": false, "creator_id": 2084529, "client_id": 2858743, "nc": 17}, {"path": "/@o_jica/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2084529, "client_id": 2299353, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/d16eaeef/uploads/origins/c1