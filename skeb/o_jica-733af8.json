-47aa-8bc6-c423cb4a1c32?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1995a40c002fef47f9098426851f0eea, https://si.imgix.net/8cc2b40c/uploads/origins/a80d431f-3d7b-47aa-8bc6-c423cb4a1c32?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=1e4f51418572328046560b6bec70a94a 2x, https://si.imgix.net/8cc2b40c/uploads/origins/a80d431f-3d7b-47aa-8bc6-c423cb4a1c32?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=12433c97090b8d22da6de4566ba74eea 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/8cc2b40c/uploads/origins/a80d431f-3d7b-47aa-8bc6-c423cb4a1c32?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=44eb39d951029cde80082bc5f06bbadf", "srcset": "https://si.imgix.net/8cc2b40c/uploads/origins/a80d431f-3d7b-47aa-8bc6-c423cb4a1c32?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=44eb39d951029cde80082bc5f06bbadf, https://si.imgix.net/8cc2b40c/uploads/origins/a80d431f-3d7b-47aa-8bc6-c423cb4a1c32?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=a4b0c9262265404ff01a01e1777bdf89 2x, https://si.imgix.net/8cc2b40c/uploads/origins/a80d431f-3d7b-47aa-8bc6-c423cb4a1c32?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=8904206f62cdeb3c07236bd92ed99554 3x"}, "body": "はじめまして！(*^^*)あなたの作品、大好きです!\n\nこの二人のオリジナルキャラクターを描いていただけませんか？現代を舞台にしたキャラクターです。親友です。\n\nダニー\n185.4センチ。茶髪の男性。\n探偵小説とポップカルチャーに夢中なFBI捜査官。\n性格は、勇敢で、こだわりが強く、おバカだけど賢い、そして社交的で神経質。普段の表情は笑顔。\n\nアロイス\n180.3センチ。金髪の男性。\nナイフと1980年代のロック音楽とお菓子作りが大好きな犯罪者。\n性格は、おしゃべり、いたずら好き、ずるがしこい。普段の表情は満面の笑み。\n\nシーンとしては、以下のようなものが考えられる（描きたくなければ描かなくてもよい）。\n- 一緒に銃撃戦をしているところ。\n- 銃を持ったアクションポーズ。\n- 二人でふざけている。\n- ダニーがアロイスを抱き上げている、または運んでいる。\n- 血まみれで、片方がもう片方を抱いて「ヤンデレ」な表情をしている。\n- お好きなポーズでどうぞ。\n\nいずれにせよ、読んでくださって本当にありがとうございました\n\nhttps://drive.google.com/drive/folders/1EJCdrnqT4