ガツガツ系にあこがれをもっている\n動物（主に鹿）・モンスターを狩って得られる肉や素材を売ったり、ギルドからの報酬などで生計を立てている\n森に住んでおり、来客は手厚くもてなす\n収集癖があり、家の中はごちゃごちゃしがち\nという設定です。\n構図はお任せします。ねこさんのオリキャラ、メリーちゃんのような明るい笑顔のかわいいイラストでお願いします！\n構図によっては斧などが邪魔になるかと思いますが、省いていただいてかまいません。\nよろしくお願い致します！", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@neko_040/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 903155, "client_id": 2860028, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/65b6fb57/uploads/origins/76046156-7b73-48dd-98e3-f9e729adc2d2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e570c54e950b7e37719e31dd5952b773", "srcset": "https://si.imgix.net/65b6fb57/uploads/origins/76046156-7b73-48dd-98e3-f9e729adc2d2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e570c54e950b7e37719e31dd5952b773, https://si.imgix.net/65b6fb57/uploads/origins/76046156-7b73-48dd-98e3-f9e729adc2d2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=6a76bad9078ff15ca2a7112c1093d179 2x, https://si.imgix.net/65b6fb57/uploads/origins/76046156-7b73-48dd-98e3-f9e729adc2d2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=df37428dd1574e22b789811df4dbb156 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/65b6fb57/uploads/origins/76046156-7b73-48dd-98e3-f9e729adc2d2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=44ca0957e9b58ec515aa3eb1468ba6eb", "srcset": "https://si.imgix.net/65b6fb57/uploads/origins/76046156-7b73-48dd-98e3-f9e729adc2d2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=44ca0957e9b58ec515aa3eb1468ba6eb, https://si.imgix.net/65b6fb57/uploads/origins/76046156-7b73-48dd-98e3-f9e729adc2d2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=2