": true, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/3efc92e2/requests/111249_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f7035308385062dd930f4773335f7141", "srcset": "https://si.imgix.net/3efc92e2/requests/111249_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f7035308385062dd930f4773335f7141, https://si.imgix.net/3efc92e2/requests/111249_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=ac085f1af13ff560be9b3d6df46cc0ec 2x, https://si.imgix.net/3efc92e2/requests/111249_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=5b2e23a2b5c8a1817cb8207ddf9ec131 3x"}, "body": "おしのそさんのえっちなイラストを見て魅力を感じました！ボテ腹好きなのですが色々なシチュエーションが見たいので、マニアックなのも描かれていて嬉しいです。ありがとうございます！\n\nリクエストですが、ラブライブ!サンシャイン!!の国木田花丸ちゃん(https://i.imgur.com/GwSsm1z.jpg)がゴミ捨て場にあお向けで倒れた状態で、かつ出産を終えて力尽きた状態のイラストをお願いします。\n\n背景のゴミ捨て場はたくさんの黒いゴミ袋が山になった感じで、背後はグレーのブロック塀で。これらは簡略化したもので大丈夫です。\n花丸ちゃんは全裸で白目を向いていて、口は半開きで。\n黒くなった乳首からは母乳が垂れ、両腕は力無く真横にだらんと伸びた状態で。\nお腹は羊水と赤ちゃんが出て、萎んだ風船のようにたるんだ状態です。\n両脚はがに股に開かれていて、陰部からは臍の緒が伸びています。その下の地面は羊水で濡れていて、紺色の髪をした赤ちゃんが泣いているのを希望しますが、無理であれば赤ちゃんの映らない範囲まででも大丈夫です。\n\nリクエストは以上です。\n過去にラブライブのイラストを描かれていて、首締めなどのマニアックな絵もあったのでリクエストしました。\nもし大丈夫であれば、是非ともよろしくお願いします。", "nc": 171, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@oshiso_sio/works/11", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 430593, "client_id": 400053, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/f75402fa/requests/109173_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=95fe3faf7f7a31a13b9f59d2bbae9207", "srcset": "https://si.imgix.net/f75402fa/requests/109173_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=95fe3faf7f7a31a13b9f59d2bbae9207, https://si.imgix.net/f75402fa/requests/109173_0?bg=%23fff&a