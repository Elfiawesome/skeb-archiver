m=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=1a4d0213c11c1c2a6fedf509264637f6, https://si.imgix.net/0814e9c4/requests/141474_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=9c77fd6c994aabc810ac756df5dcee37 2x, https://si.imgix.net/0814e9c4/requests/141474_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=6e7f7027ebc2be2c1a39638e8c3babd8 3x"}, "body": "はじめまして。突然のリクエスト失礼します。\n畷さんが描かれた伊勢さんが好きでリクエストしました。\n\n内容\n艦隊これくしょんより、ノーブラ黒インナーとスカートな姿伊勢をお願いします。（姿は改二（畷式伊勢型描き方マニュアルにあるようなインナーでも可です。）、改どちらでもかまいません。）\n\n表情や構図等\n（難しければ、無視していただいて構いません。）\n優しい表情で、すこしローアングル気味な視点からふとももやノーブラインナーおっぱいを見れるような構図でお願いします。\nそのほか、背景有無やインナー無し、着衣差分などはお任せします。\n\nその他\nPSD受領可です。\n\nお構いなければ、よろしくお願い致します。", "nc": 32, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 43569, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "りよ☕️", "screen_name": "Liyocafe", "avatar_url": "https://pbs.twimg.com/profile_images/1910203683641647105/rB76lrWj.jpg", "header_url": "https://pbs.twimg.com/profile_banners/969535290636361728/1761772775/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 90, "skills": [{"genre": "art"}, {"genre": "correction"}], "banned": false, "nc": 176}, {"id": 98711, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "光☆太郎", "screen_name": "ko_taro_PD", "avatar_url": "https://pbs.twimg.com/profile_images/1770536874299494400/_G_gihNn.jpg", "header_url": "https://pbs.twimg.com/profile_banners/98229336/1585329519/1500x500", "appeal_receivable": true, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expirat