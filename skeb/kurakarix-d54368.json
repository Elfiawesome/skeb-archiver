om/bRA1CgB.png\n- https://i.imgur.com/ZK7I3Ql.png\n\n私のリクエストを考慮していただき、ありがとうございます！", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@kurakarix/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1976421, "client_id": 2708812, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/8b179552/uploads/origins/6d961a5d-5222-49b6-adc2-de81a3fd003d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f1abea87dfcc6a5874079a9d114ae5d7", "srcset": "https://si.imgix.net/8b179552/uploads/origins/6d961a5d-5222-49b6-adc2-de81a3fd003d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f1abea87dfcc6a5874079a9d114ae5d7, https://si.imgix.net/8b179552/uploads/origins/6d961a5d-5222-49b6-adc2-de81a3fd003d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ea9ac12e95c4daacf7da964e2ee88c57 2x, https://si.imgix.net/8b179552/uploads/origins/6d961a5d-5222-49b6-adc2-de81a3fd003d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=74651449a3da43fbb034d81fbb31b6e8 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/8b179552/uploads/origins/6d961a5d-5222-49b6-adc2-de81a3fd003d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=38c28cf99a813cf5c5d99b6bfac18f98", "srcset": "https://si.imgix.net/8b179552/uploads/origins/6d961a5d-5222-49b6-adc2-de81a3fd003d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=38c28cf99a813cf5c5d99b6bfac18f98, https://si.imgix.net/8b179552/uploads/origins/6d961a5d-5222-49b6-adc2-de81a3fd003d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=ea341cbeb11d8b8a89d5e280a5ce592d 2x, https://si.imgix.net/8b179552/uploads/origins/6d961a5d-5222-49b6-adc2-de81a3fd003d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=6b07af363a03a9be68612cebe39ce611 3x"}, "body": "初めまして、個人でVtuber活動をしている朝久間はろと申します。\nクラカリ様のドットイラストをお見かけし、可愛くてでもどこか儚い雰囲気のあるイラストが素敵で是非描いて頂きたいと思いリクエストさせて頂きました。\n\nYouTubeやTwitterなどで使用させて頂きたいと思ってます。\n以下詳細です。\n\n\n【使用用途】\n配信のEDに使用予定です。\nSNSでのプロモーションや、アイコンとヘッダーなど。\n収益化しているYouTubeでのサムネイルとしての使用。\n\n\n【内容】\n•朝久間はろのイラスト\n•衣装は参考資料のどちらかお好きな方でお願い致します。\n•配信のEDに使用したい為、可能であれば16:9サイズもしくは1920×1080のサイズでお願い致します。\n•可能であれば料金の範囲内で瞬きや口、手など動いてるGIF、もしくは表情差分を頂けると嬉しいです。\n•背景がありましたらサムネイルにも使用したい為、可能であれば頭や髪は上と左右で切れてない人物人物のみの透過データ(もしくはPSDデータ)を頂けると嬉しいです。\n•使用の際トリミングや、イラストの上に文字を入れる場合があります。\n\n\n【参考資料】\n▽王国衣装(複雑な為装飾や小物は無し、もしくは簡略化して頂いても大丈夫です。)\nhttps://drive.google.com/drive/folders/1n5W99ab8e1ku0iWCeB8a7Gagz3sMNODR?usp=sharing\n\n▽魔界私服(髪型は通常立ち絵かハーフツインテールでお願い致します。)\nhttps://drive.google.com/drive/folders/1vNdwiu7ax1Qbiyab8O-UQIvkym8KWhCG?usp=sharing\n\n【補足】\n姉(ピンク):涙ぼくろが右目と八重歯があります。\n悪魔姉妹のお姉ちゃんです。\n悪魔、熊、ピンクハートモチーフです。\n\nお忙しいと思いますが、ご検討の程よろしくお願い致します。", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@kurakarix/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1976421, "client_id": 2244098, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/d1306f5d/uploads/origins/52c2eafb-3155-4ad8-bd64-74f9387acde5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1ca955b4f878a7b0826bda8d91adb006", "srcset": "https://si.imgix.net/d1306f5d/uploads/origins/52c2eafb-3155-4ad8-bd64-74f9387acde5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1ca955b4f878a7b0826bda8d91adb006, https://si.imgix.net/d1306f5d/uploads/origins/52c2eafb-3155-4ad8-bd64-74f9387acde5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=1e1189f93384692c54c21d1c52559659 2x, https://si.imgix.net/d1306f5d/uploads/origins/52c2eafb-3155-4ad8-bd64-74f9387acde5?bg=%23fff&auto=format%2Cco