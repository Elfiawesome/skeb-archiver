9a04-b17ec7996327?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d7fc2d00677941541b459f41ed8072b9, https://si.imgix.net/d10073e7/uploads/origins/b16ce019-beab-4139-9a04-b17ec7996327?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a55927bdf7b7546c58d0995970dec65c 2x, https://si.imgix.net/d10073e7/uploads/origins/b16ce019-beab-4139-9a04-b17ec7996327?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=131417e53038d6ea684832f6b9727505 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/d10073e7/uploads/origins/b16ce019-beab-4139-9a04-b17ec7996327?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=4f55f5a8505fa8730af38ee7199b37ca", "srcset": "https://si.imgix.net/d10073e7/uploads/origins/b16ce019-beab-4139-9a04-b17ec7996327?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=4f55f5a8505fa8730af38ee7199b37ca, https://si.imgix.net/d10073e7/uploads/origins/b16ce019-beab-4139-9a04-b17ec7996327?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=676d76f3bf9e5caf72b1a102a844b0b2 2x, https://si.imgix.net/d10073e7/uploads/origins/b16ce019-beab-4139-9a04-b17ec7996327?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=2115c07665ec28891d8dd1d195a03fab 3x"}, "body": "初めまして。\n納品絵やpixivに挙げられている豊かな表情のイラストに惹かれてリクエスト致します。\n\n1980年代のレトロゲーム『メルヘンヴェール』に登場するミノス・ムーメのフルカラーの全身イラストを、\nしみずけいたろう様にデザインして頂けますでしょうか。\n\nミノス・ムーメは作中ではSCENE-6「氷の世界」で氷山に閉じ込められており、\n救出するとビジュアルシーンが表示されますが、ドット絵ですので詳細がございません。\nhttps://pbs.twimg.com/media/FUbs9K2aIAAyzWU?format=jpg&name=4096x4096\n\n外見は、資料URLと以下のURLのゲームブック版のデザインをベースにして頂ければと存じます。\nhttps://pbs.twimg.com/media/EncNAixXEAkLob6?format=jpg&name=4096x4096\n\nカラーリングは実際のゲームのビジュアルシーンような、金髪にピンクがかった白いドレス、として頂ければと存じます。\n装飾品はピンクゴールドのティアラを中心に真珠のチェーンや宝石類のイヤリングとして頂けますと幸いです。\n\n……と指定させて頂きましたが、カラーリングや細部のデザインのアレンジはしみずけいたろう様にお任せいたします。\n私の妄想ですが、ミノス・ムーメは『メルヘンヴェール』の世界の海の神ネプトゥーヌスの一人娘で、\n彼女を助けると、海の神が主人公の言うことを聞いてくれるくらい目に入れても痛くない存在ですので、\n18、9歳くらいの、深窓の令嬢的な、清楚ですが世間知らずの箱入り娘の美少女、と考えております。\n\n以上となります。\nお手数をお掛け致しますが、ご検討の程よろしくお願い致します。\n\nhttps://pbs.twimg.com/media/FUbtCNGaMAElfW8?format=jpg&name=large", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@shimizu_keitaro/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2395178, "client_id": 662576, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/ff0aaf54/uploads/origins/3cafde4e-2f9c-4cf0-baa9-2a762cf3a439?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e1d6bb81cac3c497e76b10aedef869f5", "srcset": "https://si.imgix.net/ff0aaf54/uploads/origins/3cafde4e-2f9c-4cf0-baa9-2a762cf3a439?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e1d6bb81cac3c497e76b10aedef869f5, https://si.imgix.net/ff0aaf54/uploads/origins/3cafde4e-2f9c-4cf0-baa9-2a762cf3a439?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=7e5771fd10c8781862b6e2d1acffd58d 2x, https://si.imgix.net/ff0aaf54/uploads/origins/3cafde4e-2f9c-4cf0-baa9-2a762cf3a439?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c7b7e93f560f0815ac9ec35f2d32cfd3 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/ff0aaf54/uploads/origins/3cafde4e-2f9c-4cf0-baa9-2a762cf3a439?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=1050328d76c11ecd9f685ecaf4e707bf", "srcset": "https://si.imgix.net/ff0aaf54/uploads/origins/3cafde4e-2f9c-4cf0-baa9-2a762cf3a439?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=1050328d76c11ecd9f685ecaf4e707bf, https://si.imgix.net/ff0aaf54/uploads/origins/3cafde4e-2f9c-4cf0-baa9-2a762cf3a439?bg=%23fff&au