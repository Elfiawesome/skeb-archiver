=crop&crop=top&w=200&h=200&s=0f2e9a6387e49bf1d1695428a082a378 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/1edacd04/uploads/origins/25e93dbc-2a78-4065-8dac-b106c68497ed?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=4e0dda79ba8e46e7ef34e902c85f3851", "srcset": "https://si.imgix.net/1edacd04/uploads/origins/25e93dbc-2a78-4065-8dac-b106c68497ed?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=4e0dda79ba8e46e7ef34e902c85f3851, https://si.imgix.net/1edacd04/uploads/origins/25e93dbc-2a78-4065-8dac-b106c68497ed?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=7124489e5c28cc3ba7d7262ae992525b 2x, https://si.imgix.net/1edacd04/uploads/origins/25e93dbc-2a78-4065-8dac-b106c68497ed?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=d28e9158efed64cbb65626eee36cf436 3x"}, "body": "あなたのTシャツ花火ちゃんのイラストに惹かれて依頼させていただきました。\n「がんおー　てーくん」とデフォルメ岩神龍が描かれたTシャツを着た、寝起きポヤポヤ甘雨ちゃんを描いていただきたいです。\n\n検討していただけると幸いです。", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@lmi84_/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3614156, "client_id": 1960223, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/b7beb664/uploads/origins/5036a735-88ab-4095-af4f-c46a105b0d59?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=06bdca6e54110b7d1301bb15bdc95c04", "srcset": "https://si.imgix.net/b7beb664/uploads/origins/5036a735-88ab-4095-af4f-c46a105b0d59?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=06bdca6e54110b7d1301bb15bdc95c04, https://si.imgix.net/b7beb664/uploads/origins/5036a735-88ab-4095-af4f-c46a105b0d59?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ad7439b575f633de877ee93cef20866a 2x, https://si.imgix.net/b7beb664/uploads/origins/5036a735-88ab-4095-af4f-c46a105b0d59?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=27588a5e8ca0cbc3546af2c876ce0065 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/b7beb664/uploads/origins/5036a735-88ab-4095-af4f-c46a105b0d59?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=28c9222fa654d5a417736616da593e30", "srcset": "https://si.imgix.net/b7beb664/uploads/origins/5036a735-88ab-4095-af4f-c46a105b0d59?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=28c9222fa654d5a417736616da593e30, https://si.imgix.net/b7beb664/uploads/origins/5036a735-88ab-4095-af4f-c46a105b0d59?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=fc50df4f6c0705953c26ea00b9b220a0 2x, https://si.imgix.net/b7beb664/uploads/origins/5036a735-88ab-4095-af4f-c46a105b0d59?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=b2c75cc99c8db0c353619566f9ef305e 3x"}, "body": "初めまして、蝶々さん。\nたまたま見かけましたショートヘアアルダンさんの綺麗さ＆可憐さに惹かれました所、skeb募集されていたため、この機にご依頼をさせて頂ければと思った次第です！\n正直ダメ元ではありますが、もしよろしければ「ウマ娘のメジロアルダンに、FGOの源頼光／丑御前（アヴェンジャー）・第一再臨のコスプレ」したイラストをお願いできるでしょうか？\n\n参考\n・衣装：源頼光／丑御前（FGO）\nhttps://fgogamemeister.com/archives/39506333.html\n（第一再臨はぴっちりタイツのものです）\n\n発想に至った経緯としましては、ゲーム内のイベントにてメジロアルダンが「源頼光になった空想をする」というエピソードがあったこと。また彼女の衣装が、黒ベースにグリーンをあしらうカラーリングでリンクするなど、こじつけるに足る理由に個人的に盛り上がって、そのまま組み合わせにハマってしまったためです……。\n\n現状アルダンさんを描いて頂けるならこの衣装を着せて欲しい欲が拭えず、しかも蝶々さんの可憐だったり端正だったりな絵柄で再現頂ければ個人的に美味しいとのことで、ここは無茶と欲を押し通させて頂いた次第です……。\nスターレイルの花火ちゃんの衣装の描き込みに耐えられるお方なので、或いは……との期待を込めつつ、しかしながら半分はジャンル違いなので、そちらを理由にお断り頂くのは半ば受け入れておりますので、その上でもよろしければ何卒お願いする次第です。\n\nあくまで「着せ替えしたアルダンさん」を拝みたいので、コスプレ元になりきって描いて頂く必要はないです。（というか衣装元に寄せて暗く病んだ感じになるのは本意ではないです……ｗ）\n衣装は衣装で着せるだけで、「それを着る事になったアルダンさん」の感情や内面のまま、蝶々さんが思うアルダンさんのイメージで表情や構図・ポーズを描いて頂けましたらOKです。\nお茶目だったりお淑やかだったり、時々カッコつけたがったり等、蝶々さんの解釈するアルダンさんの「らしい」振る舞いとリアクション描いて頂ければと思います！\n一応、コスプレ（衣装）がメインなので、なるべくなら全身絵で衣装姿を堪能させて頂ければ特に嬉しく思います……！\n\n無茶は百も承知ですが、それでもよろしければ何卒お願いいたします……！\n\nhttps://www.pixiv.net/artworks/115999216", "nc": 152, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@lmi84_/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3614156, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/534ed740/uploads/origins/294e0f0b-1974-4377-b5ed-142f79145659?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=11c7b22d46ecbf87beca5f9dc3138819", "srcset": "https://si.imgix.net/534ed740/uploads/origins/294e0f0b-1974-4377-b5ed-142f79145659?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=11c7b22d46ecbf87beca5f9dc3138819, https://si.imgix.net/534ed740/uploads/origins/294e0f0b-1974-4377-b5ed-142f79145659?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=282cf5c064a7c61ffda0c00b98d58c1a 2x, https://si.imgix.net/534ed740/uploads/origins/294e0f0b-1974-4377-b5ed-142f79145659?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e61097c36978ed4d4724b8f88dc046a4 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/534ed740/uploads/origins/294e0f0b-1974-4377-b5ed-142f79145659?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b962ca6f7671ce33faf12d15844c8e77", "srcset": "https://si.imgix.net/534ed740/uploads/origins/294e0f0b-1974-4377-b5ed-142f79145659?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b962ca6f7671ce33faf12d15844c8e77, https://si.imgix.net/534ed740/uploads/origins/294e0f0b-1974-4377-b5ed-142f79145659?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=069b370eafe5e57239a6ba08fd542d26 2x, https://si.imgix.net/534ed740