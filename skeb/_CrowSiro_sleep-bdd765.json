200&h=200&blur=200&s=1b6831ef14a70c1717b091caaf720985 3x"}, "body": "城瓜様の一般通過ファンの者です。\n先日「だいたいなんでも」と仰っていたところを拝見し、こうしてリクエストを送らせて頂いた次第です。\nリクエストの内容なのですが、\nザ・スーパーエクセレントウルトラサメ計画の某共通の友人NPCちゃんと他愛のない会話をしているボイスが欲しいです。\n「いつまでも変わらないありふれた日常」感があると尚嬉しいです。\n彼推しとして命が救われるので何卒よろしくお願い致します。", "nc": 0, "word_count": 0, "transcoder": "audio", "creator_acceptable_same_genre": true}, {"path": "/@_CrowSiro_sleep/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "voice", "tipped": false, "creator_id": 1624013, "vtt_url": "https://fcdn.skeb.jp/uploads/outputs/1e77c7c8-d23c-414c-960c-e31a1083395a?response-content-disposition=inline&Expires=1784436626&Signature=ev5djcUQOM6PHikAAmW8f-7j3ex1wXyPRb6JqxmC9FqSYBCp2-ldFfgbO02~OhOMLZFbQtlKABV-x8vtOu6I0eQEyoBQ~Y1owWTmjbsJHfjXaJj1URbPH3NNpzhZ5AIYPlh9bB2gsQcPDOlECK34uN8vtgDGKVxVc22WbLvWs3RYbw~0i2YxJJj22Yf4g6lTwfGrzDGbRa2B6WNlnnBCi-XylKor13UQFFqgIxsfWii9602oph35pLaOAfr5BvNyLzbpj9XJkpcTmzRc4tzjrrzS9mwo8MxnHqk9Jfgr5ChnxZV35u8ulcIOiv75~f3Dxh~iERKj3hjpMEDW20f9eg__&Key-Pair-Id=K1GS3H53SEO647", "thumbnail_image_urls": {"src": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1462475855821930499%2FZDgyxadt.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=55824de0848005446df0c98ef0c19f29", "srcset": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1462475855821930499%2FZDgyxadt.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=55824de0848005446df0c98ef0c19f29, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1462475855821930499%2FZDgyxadt.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=0f7f90cf3aac053caeda697f5e922042 2x, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1462475855821930499%2FZDgyxadt.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e5097cb24036d19faeccf03b6057c392 3x"}, "preview_url": "ht