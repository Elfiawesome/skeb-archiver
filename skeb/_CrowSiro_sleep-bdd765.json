話終わったのち、鼻歌まじりにナイフを取り出してこちらに歩み寄ってくる。\n｢ッ\"……ごめん！！ごめんってば！！俺が悪かったから！！(半狂乱)｣\n｢わかった、お前のいいたいことはわかったから、な？やり直そう俺たち、きっとまた幸せに、だから昔みたいにお前の料理を食べて、話して、朝起きたらコーヒーも、……そうだ旅行、旅行も行けばいいんだろ！？好きに連れてってあげるよ、草津だろ？いいよ行こうか、すぐに用意するか、ら｣\n※ナイフが首に宛てがわれる\n｢ごめんなさいごめんなさいごめんなさい(泣いて声が上擦る)、許してください、好きだよ、好きだから許してください、愛してる、愛してるよお願いだから、あ\"……(喉の奥から押し出されたようなかすれ声)｣\n\n長文の依頼となり大変恐縮ですが、ご一考いただけますと幸いでございます。", "nc": 185, "word_count": 0, "transcoder": "audio", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 410433, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "サメノ", "screen_name": "sameno_38", "avatar_url": "https://pbs.twimg.com/profile_images/1477372116031123456/SpbdFMmO.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1003111483062943744/1530378758/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "art"}, {"genre": "correction"}], "banned": false, "nc": 17}, {"id": 1240636, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "名塚小早太", "screen_name": "kohayata5", "avatar_url": "https://pbs.twimg.com/profile_images/1884890802893316096/MpHM7CTV.jpg", "header_url": "https://pbs.twimg.com/profile_banners/842497029460828160/1738227962/1500x500", "appeal_receivable": true, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "novel"}, {"genre": "correction"}], "banned": false, "nc": 160}, {"id": 1918390, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "ﾝｷｰ", "screen_name": "kitagawaniiru", "avatar_url": "https://pbs.twimg.com/profile_images/1941455309945425920/wrpPLVMK.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1494686741