緒に描いた新しい絵が欲しいです！前に描いてもらった絵はリビングに飾ってあるんだけど、本当に大好きなの！ https://drive.google.com/file/d/1d-qC_eQ2TkjGrywFyhUGxanHsdYVptLM/view?usp=drive_link\n\n今回は3匹の猫！グレーの猫がキキ！丸くて背が低い。年老いた黒猫はビーン！痩せていて背が高い。小さな黒い子猫はダガー！やんちゃでおバカな女の子！参考文献はこちら： https://drive.google.com/drive/u/0/folders/1x2YHbBa5eqtQ7A4tqCwwt4hlgmV6iBP3\n\n装飾として、きれいな緑の植物や白い花を入れてもらえるとうれしいです。私の好きな花はスズランですが、あなたが一番似合うと思うものなら何でも構いません。あまり派手なものでなくても構いません！その他はお任せします！ありがとうございました💕\n\nhttps://drive.google.com/drive/u/0/folders/1x2YHbBa5eqtQ7A4tqCwwt4hlgmV6iBP3", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@6NATARU6/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1433677, "client_id": 655113, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/399b859b/uploads/origins/912c302d-3003-495d-a989-7e20bf64c83e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a1542249f612ed4ec9ce838d81e7d1fc", "srcset": "https://si.imgix.net/399b859b/uploads/origins/912c302d-3003-495d-a989-7e20bf64c83e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a1542249f612ed4ec9ce838d81e7d1fc, https://si.imgix.net/399b859b/uploads/origins/912c302d-3003-495d-a989-7e20bf64c83e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=770e66b99b8bbfae4c874bfb1e1be6dc 2x, https://si.imgix.net/399b859b/uploads/origins/912c302d-3003-495d-a989-7e20bf64c83e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=bb9454d9d71e5cc20954cf6cdd2fd3c6 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/399b859b/uploads/origins/912c302d-3003-495d-a989-7e20bf64c83e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d7f8efc6768f0c910991f4823fb53d77", "srcset": "https://si.imgix.net/399b859b/uploads/origins/912c302d-3003-495d-a989-7e20bf64c83e?bg=%23fff&auto=