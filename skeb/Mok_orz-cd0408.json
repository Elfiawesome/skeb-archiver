=205ed79d0cf92edde0ee2ebdb6e3d4da, https://si.imgix.net/d0c07cdc/uploads/origins/328852a5-14d9-4d6d-8d22-72891aea31d4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=da381293ec364111a60812bc569f940a 2x, https://si.imgix.net/d0c07cdc/uploads/origins/328852a5-14d9-4d6d-8d22-72891aea31d4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ebfbbdefa9d6fc26e6068d8ceee836b4 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/d0c07cdc/uploads/origins/328852a5-14d9-4d6d-8d22-72891aea31d4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=65abe0295f2908fe5bf035d22de4e2bf", "srcset": "https://si.imgix.net/d0c07cdc/uploads/origins/328852a5-14d9-4d6d-8d22-72891aea31d4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=65abe0295f2908fe5bf035d22de4e2bf, https://si.imgix.net/d0c07cdc/uploads/origins/328852a5-14d9-4d6d-8d22-72891aea31d4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=4f9e19efe8e92ba3c80783d4d7625ab0 2x, https://si.imgix.net/d0c07cdc/uploads/origins/328852a5-14d9-4d6d-8d22-72891aea31d4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=60d916273a82ee2aa84ce3959229e064 3x"}, "body": "ご依頼失礼します。\n下記のような参考資料の衣装を、お宅の金髪ロングのよく色んなコスチュームを着られている子…\nこちらの記憶が間違っていなければエルミナちゃんに着せて描いて貰いたいのですがよろしいでしょうか？\n\n衣装はアレンジをしたり小物を付け加えたりしても大丈夫ですが、\nこちらの嗜好上、必ずキャラの手足は先端まで衣装の長い袖や裾に先端まで隠されて見えないように描いていただきたいです。\n\n手と脚全体を隠す指定はしたのとお化けや幽霊っぽい衣装ではあるのですけども、\n幽霊等のように脚や下半身部分が先細りだったり消えているようには描かず、\nあくまで床まで引きずるような長い裾で隠れていて足はあるけど見えないという感じの、まあコスプレに近い感じでお願いしたいです。\n\nまた、可能であれば 裾に隠れたままの足の部分まで見えるように全身を描いていただきたいです。\n上記の手足は隠すと言う所さえそのままである限りはお好きに描いていただければと思いますので、構図やポーズはお任せします。\n\n参考資料↓\nhttps://imgur.com/a/BoRro2t", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Mok_orz/works/1", "private_thumbnail_imag