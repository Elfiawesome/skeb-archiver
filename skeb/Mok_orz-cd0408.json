9cc6/uploads/origins/52ef52c9-1145-4f5a-93ae-f95b65f0d9f2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f70a2727ac710d5814cf7aa6a17105e9, https://si.imgix.net/f7f59cc6/uploads/origins/52ef52c9-1145-4f5a-93ae-f95b65f0d9f2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=5a72917e102c094318fa1a8bca6f2777 2x, https://si.imgix.net/f7f59cc6/uploads/origins/52ef52c9-1145-4f5a-93ae-f95b65f0d9f2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=36f4eb1be5d72dba8751f59e48f40c03 3x"}, "body": "こんにちは、初めまして！\n桜庭みなとと申します、今回はXでの募集を拝見しまして、これも何かのご縁かと思いましてご依頼をさせていただこうかなと思いました。\n\n描いていただきたいのはうちの子になります。\nシチュエーションなどは特にありませんので好きに描いていただければと思います。描いてて楽しいは重要だと思っていますので、この子にかわいさを感じていただけたら幸いです。\nイラストのイメージ補助になるかと思いますので設定などを以下に書かせていただきます、参考までにどうぞです。\nこの子はゲームが好きなAIです。人間のサポートをするために作られました。\nサポートと言っても物理的ではなくメンタル的に、人と話し触れ合うことが自分の使命だと思っています。\nそんな子なのですが表情はあまりうごかなくて不器用な感じです、ただ心がないわけではなくちゃんと感情があります。\n表情には出ませんがしっぽやしぐさに感情が現れます。\nゲームが好きなのは人間と触れ合うことをこれしか知らないから、遊ぶことによって人間を知ろうとしてます。\n好きなものは人と話すこと、かわいいもの\n嫌いなものは独りぼっち、忘れられること\n意外とさみしがり屋でかまってもらえないとすぐ暗くなる不安定な一面もあります。\n\n以上になります。\nよろしくおねがいします！\n\nhttps://drive.google.com/file/d/13J2smx6y_ICJWcU2QbVVQ6FIAtc8lBZr/view?usp=sharing", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Mok_orz/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3732565, "client_id": 4112960, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/b33f84aa/uploads/origins/b0a7a003-a8de-4e58-ac1d-dccc6ad789e7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8fc614770e555d004103c3a38ba8e94b", "srcset": "https://si.imgix.net/b33f84aa/uploads/origins/b0a7a003-a8de-4e58-ac1d-dccc6ad789e7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8fc614770e555d004103c3a38ba8e94b, https://si.imgix.net/b33f84aa/uploads/orig