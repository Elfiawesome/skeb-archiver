てあるものからいくつかお願いできますと幸いです。\n\nその他、記載がない部分につきましてはお任せとなります。\nお忙しいところ恐れ入りますが、ご検討いただけますと嬉しく思います。\n\nhttps://drive.google.com/drive/folders/1AcfgCqM8-dfr2esFYk2koNc8rKxvd8TD?usp=sharing", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@aoz_usg/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1367995, "client_id": 1819693, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/ce2fd796/uploads/origins/db89a0eb-961c-4877-af42-cf416faa6142?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=00cac26ae7cefab1ee236c01b2c6e3ef", "srcset": "https://si.imgix.net/ce2fd796/uploads/origins/db89a0eb-961c-4877-af42-cf416faa6142?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=00cac26ae7cefab1ee236c01b2c6e3ef, https://si.imgix.net/ce2fd796/uploads/origins/db89a0eb-961c-4877-af42-cf416faa6142?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=0b8e91bb07ca130dd017d9ed49101768 2x, https://si.imgix.net/ce2fd796/uploads/origins/db89a0eb-961c-4877-af42-cf416faa6142?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=87c441da71477c1e8547e5c12adfc54f 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/ce2fd796/uploads/origins/db89a0eb-961c-4877-af42-cf416faa6142?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=4c9faafc06051f8ccb0785e2644f0e13", "srcset": "https://si.imgix.net/ce2fd796/uploads/origins/db89a0eb-961c-4877-af42-cf416faa6142?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=4c9faafc06051f8ccb0785e2644f0e13, https://si.imgix.net/ce2fd796/uploads/origins/db89a0eb-961c-4877-af42-cf416faa6142?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=811929b005657e5ef68f7a4a526132ae 2x, https://si.imgix.net/ce2fd796/uploads/origins/db89a0eb-961c-4877-af42-cf416faa6142?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=58f1937ed97a6a35075fe47800333629 3x"}, "body": "初めまして、四ツ井田と申します！いつもイラスト拝見しております！\nのぎこ様の丁寧なタッチと美しい光の表現にいつも憧れております…。\n特に長髪男性が本当に大好きです…！！\n\nお忙しい中大変恐縮なのですが、イラストをご依頼したくメッセージを送らせていただきました。\n\n描いていただきたいのはCoCシナリオ『タナトスは死に何を想う』にて使用した探索者です。\n以下依頼内容と設定を記載しますが、シナリオやHOの内容、ネタバレは一切無いことをここに明記いたします。\n\nイラスト内容としましては、\n「雪の日も小窓を開けてこのひとと光をゆでる暮らしをします(雪舟えま『たんぽるぽる』より)」\nという短歌をイメージに、お送りしたキャラクターを描いていただきたいです。\n服装やシチュエーションなど、そのほかのことは全ておまかせします。\n以下はキャラクターの詳細です。\n\n柳竹 彗\n白髪の方。やなたけすい。\n穏やかで愛情深い青年。蓮のことをなによりも想っている。\n蓮と触れ合うことが好きなので言葉や行動で明確に好意を示すが、もちろん物腰は柔らか。蓮の髪を触らせてもらえるのが嬉しい。\nおしゃべりが好きなので蓮に何でも話す。大学の近くで猫を見たこと、雨が上がった後に空に虹がかかっていたこと、君のことが今日も明日も大好きなこと。\n詩を編むのが趣味。将来は詩作家になりたいと思っている。今は蓮のために詩を編むことに夢中。\n甘いものが好き。\n\n皨川 蓮\n黒髪の方。ほしかわれん。\n穏やかだが陰気な青年。彗を真っ直ぐに愛している。\n姿勢が悪く声が小さい。ひらがな表記の感じでゆっくり喋る。\n所謂天才で驚異的な記憶力があり、大学の蔵書を位置や内容全て把握している。\nその頭脳や挙動、容姿からいじめられた経験があり、だからこそ人に優しくしたいと常に思っている。\n彗の優しい眼差しと言葉が好き。これはすいには内緒だが、彼の口ずさんだ詩を全て覚えている。\n彗に触れられるのが好きなので、お返しとして時折おずおずとだが彗に触れる。\nいつも使う脳のために甘いものは必須。\n\n2人は大学の同級生(22歳)。高校から知り合いで、現在は恋人です。\nふたりのあいだでさまざまなものを分け与え合うような優しいふたりです。\n\nこの2人をどうしてものぎこ様の絵で見たいと思い、依頼させていただきました。\n何卒よろしくお願いいたします！\n\n四ツ井田\n\nhttps://drive.google.com/drive/folders/1-An2POTBcBEC1RRNTiiz92xYZ_bTifQf", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@aoz_usg/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1367995, "client_id": 903546, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/04fae409/uploads/origins/901980f6-5efe-4f00-9c06-83d51ad60eab?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0b0644e83dfdd9242fed65e496520bb3", "srcset": "https://si.imgix.net/04fae409/uploads/origins/901980f6-5efe-4f00-9c06-83d51ad60eab?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0b0644e83dfdd9242fe