fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=cbcaf39498eb5e3d80b8d3f0dde88ada", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/cdab1402/uploads/origins/76d98e35-8520-438f-9d24-96ff4a21cd88?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2a7905c8583bef72f1b8ea559baedcb7", "src_set": ""}, "body": "ひぐさんはじめまして！以前からイラストが好みの絵柄で気になっていたのでこの度リクエストさせていただきました。\n描いていただきたいのはPSO2の自キャラになります。構図やポーズ等はおまかせします。キャラはどちらかと言えば綺麗、セクシー寄りイメージです。\nもし良ければ可能な範囲で表情差分等いただけたら嬉しいです。\n資料はキャラssから、足りない場合はお手数ですがメディア欄から覗いていただければ…と思います。\nいつか依頼したいな〜と思っていたので、描いていただけたら嬉しいです！\n\nhttps://twitter.com/maromonbran/status/1773732571068985696?t=sgtL7EuhQCJUxtw0ZYdx8Q&s=19", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@higuskeb/works/148", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1512855, "client_id": 241183, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/23a4c9a8/uploads/origins/3b6f3825-f7cb-480c-92d1-c9a793a828cb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=25d7061d8893361867144ef9dee4fc4d", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/23a4c9a8/uploads/origins/3b6f3825-f7cb-480c-92d1-c9a793a828cb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=91759f82997431f52d40c31a6ad2e73a", "src_set": ""}, "body": "かたくり粉ひぐさんこんばんは!\n今回はうちの子の新しい服装を描いて頂きたくリクエストさせて頂きます...!\n\n服装と見た目は資料URLをご確認お願いします。\n\n以下詳細を記載させて頂きます。\n\n・キャラについて\nイメージはツンデレの吸血鬼、身長低めの女の子です。\nチャームポイントは身体がすっぽり隠れるくらい大きなマントです。\n\n・服装について\n見た目は資料URLを確認お願いします。\n\n\n・その他\n口元に牙をお願いします。\n胸は小さくお願いします。\n瞳は資料にある姿より赤めでお願いできるとありがたいです。\n\n記載ない箇所はお任せ致します。\n\nご検討のほどよろしくお願いします！\n\nhttps://drive.google.com/drive/folders/1Fyfo8FrIci-7esoyTVNB0vXlmSkvm_DN?usp=s