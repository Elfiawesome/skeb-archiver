ed_thumbnail_image_urls": null, "body": "", "nc": 48, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@watanore/works/40", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 739401, "client_id": 0, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/13be6173/uploads/origins/4139b6d4-14bc-4e9a-a730-d14de5da0283?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c539d1dcc8a4695084bd837ff230d9ad", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/13be6173/uploads/origins/4139b6d4-14bc-4e9a-a730-d14de5da0283?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0cd1d26b48f9a5d9a0209d244f213afc", "src_set": ""}, "body": "リクエスト再開ありがとうございます。\n早速リクエスト送らせていただきます。\n\n艦隊くえすちょんVol.18にあった、私服の大和と雪風のお出かけシーンを描いていただけますか。\n親子のような雰囲気で、仲睦まじい感じでお願いします。\n\nキャンパスサイズはA3等の用紙サイズの比率でお願いします。\nご検討よろしくお願いします。", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@watanore/works/39", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/db4013de/uploads/origins/0885a20b-fcc6-414d-9432-f4cec2c92795?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=4d7e0624e8f8b9afc9ba9373fbcbff6c", "src_set": ""}, "private": true, "genre": "art", "tipped": true, "creator_id": 739401, "client_id": 2227725, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 16, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@watanore/works/38", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/4ec52fdc/uploads/origins/a42e30ee-cfcd-4801-9c50-151fecf2b45b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=89ace095327d3d1f98d80910d3a347f3", "src_set": ""}, "private": true, "genre": "art", "tipped": true, "creator_id": 739401, "client_id": 0, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 176, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@watanore/works/37", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 739401, "client_id": 0, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/9c4c3fd2/uploads/origins/1f5c27ca-e018-40ee-aac4-73b5ee461157?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f67a27aed555db8dfef40cf6e6832912", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/9c4c3fd2/uploads/origins/1f5c27ca-e018-40ee-aac4-73b5ee461157?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=7c7111403fb69b84019f0dd77faeddec", "src_set": ""}, "body": "はじめまして。\n以前より先生の描かれた艦○くえすちょん？を拝読しておりました。\nSkebではえっちな絵も描かれている事に驚くとともに\nいつか御依頼したいな、と思っていたところ\nリクエスト受付が再開されているのを見かけましたので\n早速お願いに参った次第でございます。\n\n【キャラクター】艦これの羽黒\n\n【シチュエーション】騎乗位のえっちシーン\n　他の方がリクエストされた榛名や長波サマのイラストが素晴らしかったので\nあんな感じでお願い致します。\n\n【服装】羽黒は一糸纏わぬ裸姿\n\n竿役は、色白で中性的な少年風の体格。だけど股間の主砲は立派な大人サイズ。\n羽黒も竿役も陰毛は無しで、生挿入されているシーンになります。\n\n【差分について】中出しフィニッシュのシーンもお願いします。\n　できれば結合部の描写は海苔消しで、溢れた精液が竿を伝って零れていると良いです。\n\n（予算内で可能であれば、更なる差分として\n　吹き出しのコマ等で受精の描写も追加していただけると、尚嬉しいです）\n\n背景等の指定はございません、お任せ致します。\n\n長々と条件を書き連ねてしまいましたが\nどうか御一考下さいます様、宜しくお願いします。", "nc": 49, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@watanore/works/36", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "cr