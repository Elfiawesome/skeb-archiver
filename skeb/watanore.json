{"screen_name": "watanore", "first_seen": "2025-10-03T08:59:43.510021+00:00", "last_updated": "2025-10-06T03:54:55.355293+00:00", "profile": {"id": 739401, "acceptable": false, "creator": true, "avatar_url": "https://pbs.twimg.com/profile_images/1027642521604612096/KV6EgiuY.jpg", "name": "わたのれ", "nsfw_acceptable": true, "screen_name": "watanore", "language": "ja", "body_size": 1000, "received_works_count": 45, "received_nsfw_works_count": 33, "appeal_receivable": false, "sent_first_works_count": 0, "sent_public_works_count": 0, "instruction": "unspecified", "description": "このアカウントのつぶやきは【艦これ:ガンダム:空リプ】で構成されています\n\n【メール】watanore0307🍥http://gmail.com(🍥=@)\n【Skeb】http://skeb.jp/@watanore", "busy": false, "url": null, "show_social_profile": true, "accept_expiration_days": 30, "complete_expiration_days": 60, "received_requests_average_response_time": 40753, "completing_average_time": 4116876, "nc": 49, "twitter_uid": "230057846", "user_service_link": [], "banned": false, "banned_by": "", "complete_rate": 0.82, "og_image_url": "https://skeb-avatar.imgix.net/https%3A%2F%2Ffcdn.skeb.jp%2Fassets%2Fv1%2Fcommons%2Fogp.png?auto=format%2Ccompress&fit=crop&crop=top&w=1200&h=630&s=fb919ed2f719addcbe44cbdea9c1851a", "skills": [{"genre": "art", "default_amount": 23000}, {"genre": "correction", "default_amount": 11000}], "acceptable_only_public": false, "tip_acceptable": true, "yearly_report_client_visible": false, "total_appeals_count": 0, "received_works": [{"path": "/@watanore/works/45", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 739401, "client_id": 54332, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/6557ba42/uploads/origins/11bdfe22-0015-4bea-906f-a64ddc2c6713?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=906cce2ee0cfb24eb3eea067610d0702", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/6557ba42/uploads/origins/11bdfe22-0015-4bea-906f-a64ddc2c6713?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b55893e105af32dd9e24a42bcc772c97", "src_set": ""}, "body": "依頼をさせてください。\nキャラ　艦これ　秋月、サラトガ\nシチュエーション　脱衣場で偶然あって話をしているシチュエーションでお願いいたします。\n衣装　下着姿\nアングル　真正面からで膝から上の描写でお願いします。\nポーズ　前屈みになって二人とも両手を後ろに回してブラジャーのホックを外しているようにお願いします。おっぱいがぼろんとはじけているようにお願いします。\n表情　サラトガ余裕のある表情でお願いします。秋月横目でチラチラ見てアメリカの人はすごいなあと言っているような表情でお願いします。\n背景　特に必要ありません。\n差分　私は陰毛が大好きなので黒くて濃い陰毛が生えている差分をお願いします。パンツを太ももまで下げているようにお願いします。\n備考　カラーではなくモノクロでお願いします。\nもし可能でしたらよろしくお願いいたします。", "nc": 32, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@watanore/works/44", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/7aac3d94/uploads/origins/fa697e8a-b180-4f0f-8cf9-8475cf6adf6b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=ca7528f58fcbdbcf3cc781b76dc24d4f", "src_set": ""}, "private": true, "genre": "art", "tipped": true, "creator_id": 739401, "client_id": 0, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 33, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@watanore/works/43", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 739401, "client_id": 2232081, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/d70a27f4/uploads/origins/230ce3ee-ae39-412d-accd-85f490a25d04?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ea579447f80fa2348df901799142630c", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/d70a27f4/uploads/origins/230ce3ee-ae39-412d-accd-85f490a25d04?bg=%23fff&auto=format%2Ccompress&fm=web