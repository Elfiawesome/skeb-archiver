old&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=674963101f3d5443a6468fb0ffff1653", "src_set": ""}, "private": true, "genre": "art", "tipped": false, "creator_id": 1933200, "client_id": 3201331, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 129, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@toitoitoi23/works/365", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1933200, "client_id": 2733508, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/c1079aa3/uploads/origins/15a30c06-8359-4a7a-b009-86b619781210?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b8f5485c9308417c0cc6c61fcaa4fe52", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/c1079aa3/uploads/origins/15a30c06-8359-4a7a-b009-86b619781210?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=cc53c74f6a9e53f5793a13f8a524797e", "src_set": ""}, "body": "といといさんお世話になっております！スピッツかわいいです。いつも温かみのある色味と優しい笑顔のイラストを楽しく拝見させていただいています。今回は私の創作キャラを描いていただきたくリクエストしに参りました。\n\n描いて欲しいキャラクターは以下の2名になります。\nルイス･･･お人好しの画家で、散歩と植物観察が趣味。人のことはもっと大好きで誰にでも真っ直ぐ愛を伝える。\nウィルバート･･･人情深いシゴデキ男。多趣味で、気になったものはとことん突き詰める性格。\n\n詳細は添付の資料をご覧いただければ幸いです。この2人以外にも資料に含まれているキャラクターであればお好きに描いて下さって構いません。\n自由な解釈が見たいので内容はといといさんにおまかせしたいのですが、可能であれば過去のskebリクエストで描かれていたような背景ありの絵本みたいに可愛い作風が拝見したいと、思っています…♡わがまま言ってすみません！💦\n資料や金額に不都合があれば気兼ねなくキャンセルしていただいて構いません。それではご検討よろしくお願いいたします！🍀\n\nhttps://drive.google.com/drive/folders/1dUB2BUGcgo8_SYlgJvCxwssdQt7w9cPR", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@toitoitoi23/works/364", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1933200, "client_id": 3391534, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/87f78749/uploads/origins/6774743d-2794-4de9-82e4-e67673defab7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=08cc2382898768fbc074ec01c4f55629", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/87f78749/uploads/origins/6774743d-2794-4de9-82e4-e67673defab7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=24a9bae597a5f82f009054f7f5ebe915", "src_set": ""}, "body": "魅力をありがとう！最近のイラストはとても魅力的で、温かい雰囲気の空間が大好きです。  ぜひマギーも描いてください！詳細はお任せします。\n\n参考文献\nhttps://drive.google.com/file/d/1GeLX2-mrfo4Ou9lHP4ESrRf42A45dmvS/view?usp=drive_link\nhttps://drive.google.com/file/d/1ODVKrE2kKq_PFg_4AGimT2-JW19f39J3/view?usp=drive_link\n\n私のストリームの背景、もしよろしければ参考にしてください（必須ではありません）。\nhttps://drive.google.com/file/d/1vgJabEkAlYZsKta7bzFVtxAuQ1yznOCo/view?usp=drive_link\n\nこのイラストはSNSで使ったり、youtubeの動画のサムネイルに使ったりする予定です。ありがとうございました！\n\nhttps://drive.google.com/drive/u/1/folders/1AM03gKREXkzK9b9QhPK3AD50HG8Qyomk", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@toitoitoi23/works/363", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1933200, "client_id": 606757, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/08b7dbbf/uploads/origins/c4f5f13d-fd87-4426-ae27-a2fba1d7d34a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4854edd758fed8d0a3a43a4226304d2d", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/08b7dbbf/uploads/origins/c4f5f13d-fd87-4426-ae27-a2fba1d7d34a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=66879b995ce8c95298efae442d39b21b", "src_set": ""}, "body": "はじめまして、ゆこなると申します。\n風景とキャラクターの調和した優しいイラストにグッときて、リクエストをお