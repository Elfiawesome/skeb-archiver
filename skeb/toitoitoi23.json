9d4d38a/uploads/origins/a2d0d2ed-2a64-4b82-b59a-0b34441af77e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3918fecad8b73b63850b18a10c807ae3", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/49d4d38a/uploads/origins/a2d0d2ed-2a64-4b82-b59a-0b34441af77e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f702850f83b024726892315e7fb56046", "src_set": ""}, "body": "こんにちは！お返事が遅くなってしまって申し訳ありません...！もしよろしければ、まだ提出できますか？お忙しいところありがとうございました！\n\nhttps://drive.google.com/drive/folders/1tGF0izbc78Lt1hGm92aJ-XlfFvFDlNpi?usp=drive_link", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@toitoitoi23/works/352", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1933200, "client_id": 105304, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/f31d3282/uploads/origins/d729f5b4-2d71-40c0-acdb-b926882c6ab6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0429262e9b4a0501d74bfa5a78756e89", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/f31d3282/uploads/origins/d729f5b4-2d71-40c0-acdb-b926882c6ab6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0a6b8116b74a9d88bab3a890c30676e7", "src_set": ""}, "body": "リクエスト募集が再開してましたので前回のリクエストをもう一度送らせていただきます！\n\n今回はうちの竜人の神官であるルークをリクエストさせていただきます。\n鱗の代わりに全身が毛で覆われている種族で、女性のような顔と口調ですがちゃんとした大人の男性です。\n若干皮肉屋な所があるものの、根っこが善人寄りなため理由をつけては相手の要求を飲むことが多い人物です。\n\n以上、よろしくお願い致します。\n\n参考\nルーク・マキアート：https://x.com/dafox_reifi/status/1877030520799772840", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@toitoitoi23/works/351", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id"