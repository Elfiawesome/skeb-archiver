ます。\n頬に渦巻きがある。\n腕は4本。\n頭の横の角はまだある。\n髪型はほぼ同じだが、ナナチの髪型のようにふわふわしている。\n\nメイド服は、黒い布が透けて見えるような服装でお願いします。エプロンは普通の布です。\n(他の方の作例 https://imgur.com/5lS243P)\nアニメでナナチがレグに触られたときに見せるような、恥ずかしそうな、赤面しているような表情を希望します。\n\nメイド服はマルルクのドレスのような形がいい。\n\n側頭部にふわふわの耳が生えている。\n(他の絵師さんに描いていただいたキャラの例です。https://imgur.com/M0ge3iq)\n\nドレスの下で片腕でオナニーをしていて、それが恥ずかしくて赤面しているという設定にしてほしい。\n\nメイド服の下に下着はつけていない。\n\nななっちのようなふわっとした感じが出ればいいなと思います。\n\nポーズは立ち姿で、見る人に向かってオナニーで顔を赤らめているような感じでお願いします。\n\n成れの果てのふわふわした可愛らしさを残しつつ、出来るだけ淫靡に仕上げてください。\n\nありがとうございました。\n\nhttps://twitter.com/RorotteRotte/status/1507015845964263425", "nc": 32, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@akio_mstk/works/34", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/fc5ce1de/uploads/origins/785f3b74-6909-48a8-a4d0-d4cc7708ff8b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=dbde03f2779ac8402a504cb589cebd11", "src_set": ""}, "private": true, "genre": "art", "tipped": true, "creator_id": 412972, "client_id": 0, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 48, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}], "similar_creators": [{"id": 618569, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "菓色（かしき）", "screen_name": "kashiki_main", "avatar_url": "https://pbs.twimg.com/profile_images/1651551522168393728/quSn7tZg.jpg", "header_url": "https://pbs.twimg.com/profile_banners/983353739577667588/1703219392/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 21, "skills": [{"genre": "art"}, {"genre": "comic"}, {"genre": "correction"}], "nc": 48}, {"id": 929278, "creator": tru