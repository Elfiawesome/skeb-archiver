_count": 0, "received_works": [{"path": "/@M_Gew_R_18/works/9", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 806818, "client_id": 0, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/bf3e5bfa/uploads/origins/a9ca0537-256f-489e-a1d6-0af37ae229d7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=780a683f56415ea109d45f2b562f307c", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/bf3e5bfa/uploads/origins/a9ca0537-256f-489e-a1d6-0af37ae229d7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0e28939fe22c6370414bd138fc0257a2", "src_set": ""}, "body": "倉さん、以前の芳乃美波スライム敗北ありがとうございました\n今回もペア敗北イラストをお願いしたいと思います\nキャラ\n［花の御庭番］相葉夕美(特訓後)\n［えにしの結び手］道明寺歌鈴(特訓後)\n敗北シチュ\n大量の触手に捕まる(腕を頭の後ろで拘束&M字開脚)、衣装の服ビリ、陰部・口への触手挿入、どちらかの胸に触手が巻き付く、もう一方は乳首を強く引っ張られる、相葉:片目を閉じ、歯をくいしばりながら苦しそうな表情、道明寺:両目を閉じ、涙を流し口を開け嫌がる表情\n以上の内容でお願いします。", "nc": 56, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@M_Gew_R_18/works/8", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/d8fbffe9/uploads/origins/ecc678d6-821f-4ef5-8acc-819c6d24ed19?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=a707be437fbcac06fd73062f00f651f1", "src_set": ""}, "private": true, "genre": "art", "tipped": true, "creator_id": 806818, "client_id": 483069, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 49, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@M_Gew_R_18/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 806818, "client_id": 0, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/c10a950f/uploads/origins/7eb8ac6d-ce2f-4505-98b0-46413ccc9a62?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0ef44d00ea980076fcf032c9ca4ce70f", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/c10a950f/uploads/origins/7eb8ac6d-ce2f-4505-98b0-46413ccc9a62?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0c146461b48c646add978599d66a1318", "src_set": ""}, "body": "倉さんこんにちは。初の投稿失礼します\nわだつみの導き手(特訓後)の依田芳乃とノーブルヴィーナス(特訓後)の新田美波がスライムに苗床敗北してしまうイラストをお願いしたいと思います\n可能であれば、こちらの方(https://skeb.jp/@GAJIRABUTE1016/works/75)が描かれているような感じでお願いしたいです。衣装の破れ、ポーズなどの度合いはお任せします\nどうぞよろしくお願い致します", "nc": 33, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@M_Gew_R_18/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 806818, "client_id": 1223097, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/3c49c7dc/uploads/origins/a833bd1b-1256-4c56-b975-499869ca7799?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4ae358dcf0c7538807426dfc65608085", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/3c49c7dc/uploads/origins/a833bd1b-1256-4c56-b975-499869ca7799?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=85d14d29b78497806e7721b7dda48e6e", "src_set": ""}, "body": "初リクエスト送らせて頂きます。\n  \n■キャラ アイドルマスターシンデレラガールズの藤原肇ちゃん。\n\n  ■シチュエーション \n学校の廊下で誰かとぶつかってしまい、尻もちを着いちゃってパンチラしちゃっているシチュ。 \n\n ■詳細 \n衣装は制服姿（ジャンパースカートの方）で尻もちを着いた時に脚を開いてしまって、パンツが丸見えになってしまっている状態でお願いします。\n パンツの色は白でお願いします。 \n表情は真っ赤な顔で驚いている（目と口が大きく開いている）でお願いします。 \n\n 長くなりましたが、ご検討のほどよろしくお願い致します。", "nc": 49, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@M_Gew_R_18/works/5", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/20ab683b/uploads/origins/538743fb-b599-4273-b7ff-cb604c136787?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=ab4f66914970588cdf71f4a912c148c7", "src_set": ""}, "private": true, "genre": "art", "tipped": false, "creator_id": 806818, "client_id": 0, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 177, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@M_Gew_R_18/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 806818, "client_id": 0, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/7f5135a6/uploads/origins/b3d04ad7-28c3-4489-ab3f-ecfab9c7b23e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e001fe21d319873888941da02c2e09a3", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/7f5135a6/uploads/origins/b3d04ad7-28c3-4489-ab3f-ecfab9c7b23e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=7ec328395cb0acfea58fa7b73bb3ac6e", "src_set": ""}, "body": "以前、超ミニスカ姿で手足を縛られた相葉ちゃん（https://x.com/M_Gew_R_18/status/1741046181072118027）をリクエストした者です。その時のイラストが大変良かったので、今回はへそ出しの短い丈のノースリーブニットに、超ミニスカート、膝下丈の黒のハイソックスのコーデで、手足を縛られ横向きに寝かされた小日向美穂ちゃんのイラストを全身でお願いしたいです。\n\n構図は\n・前回と同じく、こちらと同じ感じ（https://www.pixiv.net/artworks/69621787）でお願いします。前回の相葉ちゃんは膝を曲げていましたが、URLの構図と同じく脚は自然に伸ばした感じにしてほしいです。\n・ふとももと脚が好きなので、なるべくふとももと脚全体が映えるように描いてほしいです。\n・脚とふとももは美脚かつ長めにしてほしいです。\n・背景は無しか、単色のシンプルなもので良いです。\n\n服装は\n・ノースリーブニットは黒で新婚気分愛情エプロンのニットと同じく、袖口が首あたりから大きく開いているデザインでお願いします。丈はおへそが完全に見える丈でお願いします。\n・スカートは前回の相葉ちゃんと同じ丈で、ローウエストで股下がほとんどないギリギリの超ミニ丈にしてほしいです。フレアかプリーツといった裾が広がるデザインで、タイト系は避けてください。色はえんじ色でお願いします。\n・ハイソックスは黒一色の透けないタイプで、膝下を完全に覆う丈。\n・靴は無し。\n・スパッツ、インナーパンツ等は無し。\n・ふとももは生脚。\n・ガーターリング等ふとももの装具や、ふとももにかかるアクセサリーなどはなし。\n\n・縛り方ですが、前回の相葉ちゃんと同じ縛り方で、後ろ手に胸の上下と、脚は両足首のみを縛ってほしいです。膝の上下やふとももは縛らないでほしいです。\n・ロープなど、細い紐状のもので縛ってほしいです。\n・猿轡や目隠しなどは無しで、目と口は見えるようにしてほしいです。\n・胸の下の縄で腕と体の間にある縦の縄、両足の間に縦に入っている縄は省略しないでいただきたいです。\n\n表情は恥ずかしそうにしている感じながらも、未経験のプレイに期待して顔を赤くしている感じでお願いしたいです。\n\n指定が多く恐縮ですが、検討して頂けると幸いです。よろしくお願いいたします。", "nc": 177, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@M_Gew_R_18/works/3", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/950c44f0/uploads/origins/447919e6-9000-4bdd-bf36-7e4452dd9526?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=faef86b587051be7908c078b3a5837fe", "src_set": ""}, "private": true, "genre": "art", "tipped": true, "creator_id": 806818, "client_id": 483069, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 176, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@M_Gew_R_18/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 806818, "client_id": 0, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/2c346e3e/uploads/origins/1789a241-7eb7-47a9-9bb5-4fd682095fae?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b2fb23dfb2b6426121dceb9ff8fc2d33", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/2c346e3e/uploads/origins/1789a241-7eb7-47a9-9bb5-4fd682095fae?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a685cf233994f1ae50b157cb7e3c9e14", "src_set": ""}, "body": "イラストいつも見てます！\n以下リクエストの内容です。\nキャラ:相葉夕美\n服:もこもこルームウェア\nシチュ:大学の仲良し女子会お泊まり会in友人宅で着衣緊縛\nSMが好きと言う友達に、服の上から縄をかけられて恥ずかしそうにしている感じ。\n縛り方:後ろ手。割とガチな縛り方。片足もできれば折り畳むようにして縛り上げてください。\nその他:縛られている場所や姿勢は、どこでも構いません。一応候補としては、ベッドの上で横たわり、クッション(フローリング？)座位、立ちなど、、\n同じ部屋にセリフ出演で縛り師を込みで3人ほどいる雰囲気を出してください。\n「我ながら良いではないか〜！」\n「これはちょっとやりすぎじゃ…」\n「やだ夕美チョー顔が赤いじゃん！笑」\nのようなそれっぽい会話を入れてもらえると嬉しいです。\nお任せ項目:縄の色、服の色と柄、部屋の背景の有無、アングル、\n長くなって申し訳ございません。\nご検討よろしくお願いします。", "nc": 161, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@M_Gew_R_18/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 806818, "client_id": 0, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/86017f35/uploads/origins/c104d1a9-a4cc-47a9-80b5-78e474a26146?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=04781e2ee1290029c50dc0810b2b9f60", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/86017f35/uploads/origins/c104d1a9-a4cc-47a9-80b5-78e474a26146?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=fb824b6bd48e5e3719792423d315c789", "src_set": ""}, "body": "Pの趣味で、胸元が開いておへそが見える短い丈のノースリーブブラウスに、超ミニスカート、膝下丈の黒のハイソックスのコーデで、手足を縛られ横向きに寝かされた相葉ちゃんのイラストを全身でお願いしたいです。\n\n構図は\n・こちらと同じ感じ（https://www.pixiv.net/artworks/69621787）でお願いします。\n・ふとももと脚が好きなので、なるべくふとももと脚全体が映えるように描いてほしいです。構図のURLと同じように、ふとももは前面と側面が見える感じでお願いします。\n・脚とふとももは可能でしたら美脚にしてほしいです。\n・背景は無しか、単色のシンプルなもので良いです。\n\n服装は\n・ノースリーブブラウスはへそ出しで肩を完全に出し、袖口にフリルなどがないシンプルなデザイン。胸元はふんわり花乙女の特訓前くらいに開けてください。色は白でお願いします。\n・スカートは股下がほとんどないくらいのギリギリの超ミニ丈にしてほしいです。フレアかプリーツといった裾が広がるデザインで、タイト系は避けてください。色は黒でお願いします。\n・ハイソックスは黒一色の透けないタイプで、膝下を完全に覆う丈でお願いします。\n・靴は無し。\n・スパッツ、インナーパンツ等は無し。\n・ふとももは生脚。\n・ガーターリング等ふとももの装具や、ふとももにかかるアクセサリーなどはなし。\n\n縛り方ですが\n・後ろ手に胸の上下を縛り、脚は両足首のみを縛り、ふとももや膝の上下などは縛らない。\n・ロープなど、細い紐状のもので縛ってほしいです。縛り方は縄の太さはこちら（https://www.pixiv.net/artworks/92020264）と同じで、ひざ上を縛っている縄がない状態でお願いします。\n・猿轡や目隠しなどは無しで、目と口は見えるようにしてほしいです。\n・胸の下の縄で腕と体の間にある縦の縄、両足の間に縦に入っている縄は省略しないでいただきたいです。\n\n表情は「もう、こういうのが好きなの？」とPに付き合わされ困って恥ずかしそうにしている感じながらも、未経験のプレイに期待して顔を赤くしている感じでお願いしたいです。\n\n倉さんにはいつかリクエストしたいと心待ちにしていました。\n指定が多く恐縮ですが、検討して頂けると幸いです。よろしくお願いいたします。", "nc": 160, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "similar_creators": [{"id": 187735, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "ment@C106土曜 南h36a", "screen_name": "ment50", "avatar_url": "https://pbs.twimg.com/profile_images/1948404810518339584/ncPjkeH7.jpg", "header_url": "https://pbs.twimg.com/profile_banners/18899641/1753370945/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "skills": [{"genre": "art"}], "nc": 177}, {"id": 263749, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "ゼブルン", "screen_name": "Zebulun_", "avatar_url": "https://pbs.twimg.com/profile_images/1384575541110472708/4ywxgI78.jpg", "header_url": "https://pbs.twimg.com/profile_banners/145643540/1740890688/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 7, "skills": [{"genre": "art"}], "nc": 33}, {"id": 872666, "creator": true, "nsfw_acceptable": true, "acceptable": false, "name": "カンパ", "screen_name": "campagne_9", "avatar_url": "https://pbs.twimg.com/profile_images/1690624882684612608/L6Zi6rF2.png", "header_url": "https://pbs.twimg.com/profile_banners/831982900140650496/1537023311/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "skills": [{"genre": "art"}, {"genre": "comic"}], "nc": 176}, {"id": 1024063, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "森ぐる