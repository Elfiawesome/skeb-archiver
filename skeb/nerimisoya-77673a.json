rks/102207745>のわからせイラストを拝見し、大変素敵に感じましたので、似た内容のリクエストをさせていただきました。\n\n恐縮ですが、リクエスト用にデザインいただいたキャラクターでのリクエストになります。\n\nキャラクターが、搾精しようとセックスしているものの、正常位で追い詰められてイかされているイラストをお願いします！\n\n以下、細かい指定等になります\n【キャラ設定想定】\n・精を求めて人を襲うサキュバス\n・サキュバスとしての格は低め\n\n【構図・ポーズ】\n・正常位\n・キャラの身体の前面、表情が見える形の構図・ポーズ\n\n【キャラ】\n・眉八の字で口角の上がらない、イき顔\n・頬染め\n\n【その他】\n・身体に傷や痣や泥などの描写は無し\n・精液など、キャラ自身以外の体液の描写は無し\n\n【キャラ資料】\nhttps://x.com/dodontata/status/1785684763438985674?s=46&t=7ZthkWPVJZaDXgLcKh6AKA", "nc": 161, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@nerimisoya/works/15", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1638334, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/d410ab19/uploads/origins/8504b6d7-4bbb-4395-b427-423546f32cb8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f170ea9910ea580c26b64f48eaa22a12", "srcset": "https://si.imgix.net/d410ab19/uploads/origins/8504b6d7-4bbb-4395-b427-423546f32cb8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f170ea9910ea580c26b64f48eaa22a12, https://si.imgix.net/d410ab19/uploads/origins/8504b6d7-4bbb-4395-b427-423546f32cb8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=7017cacfc6bf0bbc615a40f304e723fa 2x, https://si.imgix.net/d410ab19/uploads/origins/8504b6d7-4bbb-4395-b427-423546f32cb8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=cbc9ad92ddf3b8481871222cba23f609 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/d410ab19/uploads/origins/8504b6d7-4bbb-4395-b427-423546f32cb8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=20364fd8380905b162448ebe02e426a3", "srcset": "https://si.imgix.net/d410ab19/uploads/origins/8504b6d7-4bbb-4395-b427-423546f32cb8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=