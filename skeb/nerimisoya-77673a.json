ふたりとも極力服は着たままだと嬉しいです。\n（金髪の子がつけているクリノリン等、着けたままだと後背位がほぼ不可能になりそうなパーツ等は外してしまって問題ありません。）\n\nまた資料用の絵は他の方にコミッションで描いていただいた絵になりますが、資料用に使用する許可をいただいております\n\nhttps://moo-tyaunen.ssl-lolipop.jp/txiloda/picture.php?user=touhou2008&file=image_prf_full.png", "nc": 56, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@nerimisoya/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1638334, "client_id": 655910, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/20714ddc/uploads/origins/566d46b0-f395-44a9-93d3-2ed5371b55b5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6db77b5796dc2530e6b52875b085adb3", "srcset": "https://si.imgix.net/20714ddc/uploads/origins/566d46b0-f395-44a9-93d3-2ed5371b55b5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6db77b5796dc2530e6b52875b085adb3, https://si.imgix.net/20714ddc/uploads/origins/566d46b0-f395-44a9-93d3-2ed5371b55b5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c7a6757f364ba3fbd3eed0085c3ff61d 2x, https://si.imgix.net/20714ddc/uploads/origins/566d46b0-f395-44a9-93d3-2ed5371b55b5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e15fd5a051df843f087166c3eee929ee 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/20714ddc/uploads/origins/566d46b0-f395-44a9-93d3-2ed5371b55b5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b59b0aa086f734e7fffaf09f6e123763", "srcset": "https://si.imgix.net/20714ddc/uploads/origins/566d46b0-f395-44a9-93d3-2ed5371b55b5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b59b0aa086f734e7fffaf09f6e123763, https://si.imgix.net/20714ddc/uploads/origins/566d46b0-f395-44a9-93d3-2ed5371b55b5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=