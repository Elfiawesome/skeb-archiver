。\n\n宜しくお願い致します。", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 10201, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "某氏屋", "screen_name": "soregasiya", "avatar_url": "https://pbs.twimg.com/profile_images/1591958198918995968/A3JCxfX_.jpg", "header_url": "https://pbs.twimg.com/profile_banners/2321959225/1692330983/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "art"}], "banned": false, "nc": 1}, {"id": 58527, "creator": true, "nsfw_acceptable": false, "acceptable": false, "name": "ディドー", "screen_name": "di_do_di_do", "avatar_url": "https://pbs.twimg.com/profile_images/1343441211453919232/Pwla6QZZ.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1118133159361753090/1619874560/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 90, "skills": [{"genre": "art"}], "banned": false, "nc": 1}, {"id": 100082, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "s", "screen_name": "ebi_04", "avatar_url": "https://pbs.twimg.com/profile_images/1680922411984896001/o1NyN4mU.jpg", "header_url": "https://pbs.twimg.com/profile_banners/964581560568635392/1646628518/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "art"}], "banned": false, "nc": 161}, {"id": 1879501, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "駒ゐ", "screen_