nail_image_urls": {"src": "https://si.imgix.net/3c5b6adb/uploads/origins/a882a78d-4246-4349-bd47-584a7f1ec848?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b7a73edf9e968f9ba2f542281bb5eec4", "srcset": "https://si.imgix.net/3c5b6adb/uploads/origins/a882a78d-4246-4349-bd47-584a7f1ec848?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b7a73edf9e968f9ba2f542281bb5eec4, https://si.imgix.net/3c5b6adb/uploads/origins/a882a78d-4246-4349-bd47-584a7f1ec848?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=791c8fe353b4a80a3a720dd7f1056928 2x, https://si.imgix.net/3c5b6adb/uploads/origins/a882a78d-4246-4349-bd47-584a7f1ec848?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b431f8e8255c11df98a72008d95e8e1d 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/3c5b6adb/uploads/origins/a882a78d-4246-4349-bd47-584a7f1ec848?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=dd88cc3e79104a34e5d79cfe49c773b3", "srcset": "https://si.imgix.net/3c5b6adb/uploads/origins/a882a78d-4246-4349-bd47-584a7f1ec848?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=dd88cc3e79104a34e5d79cfe49c773b3, https://si.imgix.net/3c5b6adb/uploads/origins/a882a78d-4246-4349-bd47-584a7f1ec848?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=70f3d0b155f8ac86a9c99d8503d74ba9 2x, https://si.imgix.net/3c5b6adb/uploads/origins/a882a78d-4246-4349-bd47-584a7f1ec848?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=05182d44298fa375430d35688f433cfc 3x"}, "body": "こんにちは。あなたの作品には驚きました!!!私の友人が双子の子供、フェイトとフェイスを愛しているので、彼らの誕生日プレゼントとして依頼したいと思います。彼らは双子の子供、フェイトとフェイスを愛しているので、彼らへの誕生日プレゼントとしてお願いしたいのですが、彼らがお互いに腹を割って話をすることは可能でしょうか？2人は兄弟で、フェイト（男の子）はフェイス（女の子）にゴーグルを、フェイスはフェイトにリボンを渡しています。離れ離れになった2人は、兄弟がお互いにいることを思い出すために、これらのアイテムを渡しています。私の友人はこれをSNSの写真として使う予定ですが、よろしいでしょうか？このような機会を与えていただき、本当にありがとうございました。\n\nhttps://imgur.com/a/Jn9rgHv", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@mikadorobo/works/8", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 560421, "client_id": 457499, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/015b9042/uploads/origins/60ea3bbd-5238-4225-837c-f97aa1f3100b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3c13be6261f60de73a01adf55ca641cd", "srcset": "https://si.imgix.net/015b9042/uploads/origins/60ea3bbd-5238-4225-837c-f97aa1f3100b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3c13be6261f60de73a01adf55ca641cd, https://si.imgix.net/015b9042/uploads/origins/60ea3bbd-5238-4225-837c-f97aa1f3100b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=decb214c68c0ddd3f0dba00b268a9f4e 2x, https://si.imgix.net/015b9042/uploads/origins/60ea3bbd-5238-4225-837c-f97aa1f3100b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=38a126c5bdcbe8c35711c1a88722d1d7 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/015b9042/uploads/origins/60ea3bbd-5238-4225-837c-f97aa1f3100b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e18e1d601d4ad9f975282276cad0476d", "srcset": "https://si.imgix.net/015b9042/uploads/origins/60ea3bbd-5238-4225-837c-f97aa1f3100b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e18e1d601d4ad9f975282276cad0476d, https://si.imgix.net/015b9042/uploads/origins/60ea3bbd-5238-4225-837c-f97aa1f3100b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=ed94927c6b23aeace0e88e92d25c62d0 2x, https://si.imgix.net/015b9042/uploads/origins/60ea3bbd-5238-4225-837c-f97aa1f3100b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=589fc93b18e8c467d1341f06246b2cd5 3x"}, "body": "ミカドさん\n\nお疲れ様です。新卒社会人です。\n\n趣品評舞踏会（https://w.atwiki.jp/omomuki/index.amp）という企画を連想するイラストを描いていただきたいです。\n\n本番直前、或いは休憩中に舞踏会会場の舞台袖で台本の読み合せをしたり水分補給をしたりしている九条杏子と新卒社会人。\n衣装はお互い普段着用しているもので構いません。\n舞踏会っぽい装いにドレスアップしていただいても面白いかもしれません。\nそれに合わせて髪型もアレンジしてみるのも一興かと存じますが、メガネは外さないようにご留意ください（デザインは変更可）。\n1920×1080pxに収まるサイズでお願いします。\n\n　その他\n・配信の告知やサムネイルなどで使用する想定です\n・本依頼は新卒社会人からのものですが、納めていただいたイラストは新卒社会人、九条杏子の両者が利用させていただきます\n・利用に際しトリミングなどする可能性がございます\n・描いていただく吸血鬼および人間のタッチは原画に寄せる必要はございません\n\n以上、よろしくお願い致します。\n\nhttps://twitter.com/anzu_9jo?s=09", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@mikadorobo/works/7", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/6ca1d411/uploads/origins/5e72fee0-381c-4c6d-ad88-f28a461ee62d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=88fb8a45c97edd27f5aae1ce421bb9b7", "srcset": "https://si.imgix.net/6ca1d411/uploads/origins/5e72fee0-381c-4c6d-ad88-f28a461ee62d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=88fb8a45c97edd27f5aae1ce421bb9b7, https://si.imgix.net/6ca1d411/uploads/origins/5e72fee0-381c-4c6d-ad88-f28a461ee62d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=2052601c323cc682b6541ae4c28637bd 2x, https://si.imgix.net/6ca1d411/uploads/origins/5e72fee0-381c-4c6d-ad88-f28a461ee62d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=9a7c61044a1981a4a172d8eb3294ceaf 3x"}, "private": 