top&w=200&h=200&blur=200&s=7f8c0ff40a7282b2caa0a708dd3ad250", "src_set": ""}, "body": "よろしければ、私の愛するキャラクター、なのはを描いてください。\n\n彼女は未来から来た炎の魔法を得意とするマジシャンで、魔法学校の博士課程に在籍しています。ちょっと背が低くて、傲慢でかわいい女の子です。正しい態度を想像するには、こなた（らき☆すた）や星野（ブルーアーカイヴ）を思い浮かべてください。\n\nイメージの中に炎が浮かび上がらなくてもOK。クールな魔法少女でもいいし、苦学生でもいい。メガネは必須です。ありがとうございました！\n\nhttps://toyhou.se/22176999.nanoha/gallery", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@ryura_san/works/88", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 7358, "client_id": 3046939, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/2159db72/uploads/origins/0cb0dc21-7eb5-45ad-b09b-f822e7a4512b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1e29c940cdc5ca0c0f3e39841e7851bd", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/2159db72/uploads/origins/0cb0dc21-7eb5-45ad-b09b-f822e7a4512b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=35dc02591cb54ad3a2e4320ba8d70807", "src_set": ""}, "body": "りゅうら様\nはじめまして､Vtuber準備中の甘美猫子と申します｡(活動アカウント @amami_nyanko)\nりゅうら様のイラストに一目惚れしたため､是非私「甘美猫子」のことを描いていただきたいと思いリクエストいたしました｡\n\n●使用用途●\nアイコン､ヘッダー､サムネイル､SNSでの宣伝活動など活動全般｡\nまた､将来的にグッズ化することも視野に入れています｡(個人使用のみ)\n\n●キャラクター●\nおっとり､天然｡ちょっぴり不思議ちゃん｡\nいつもニコニコと微笑んでいるorボーッとしている｡\n甘いものに目がない｡ショートケーキが大好き｡\n\n●要望●\n頭が見切れない構図でお願いしたいです｡\n『人間に憧れる猫』という設定なので､耳としっぽはできる限りリアルな猫に近いデザインにしていただけると嬉しいです｡\n人物＋背景､人物のみ(背景透過したもの)という納品形式だと大変有難いです｡\n\n●参考資料●\nhttps://x.com/omgomglub/status/1877757712114888895?s=46&t=CWlF6WYo_uwl-nRN7U7AWQ\n※目はタレ目､目元にホクロあり､八重歯あり(猫の牙)､少しむっちりとした太もも､胸は\"大きめ\"ですが立ち絵より大きくならないようお願いいたします｡\n\nご検討の程よろしくお願いいたします｡\n\nhttps://x.com/omgomglub/status/1877757712114888895?s=46&t=CWlF6WYo_uwl-nRN7U7AWQ", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@ryura_san/works/87", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 7358, "client_id": 463814, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/ec2764e9/uploads/origins/48d63ee2-5d1f-4cec-a0d2-10efd476f4a5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6ad72eb083b70c00300701ff4ab4d42c", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/ec2764e9/uploads/origins/48d63ee2-5d1f-4cec-a0d2-10efd476f4a5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5c63ca24ecb18c30ad056451a2dd0c1a", "src_set": ""}, "body": "以前は素敵なアイコンをありがとうございました！Vsingerのk0y0miです。\nあらためて、次なるご依頼をしたく、リクエストさせていただきます！\n\n当方のアイコンのキャラデザ(衣装自由)で、こちらのようなイラストの雰囲気で、猫口八重歯(ギザ歯)どや顔しいたけ目(✨目)のイラストをお願いいたします！！\nhttps://x.com/ryura_san/status/1611010728768737281\n\n使用用途：\n各種SNS、配信、MV、グッズ\n\nサイズ：\n縦横比指定なし。\n背景透過バージョン有で、上と左右見切れなしですと助かります！\n\n不備等ございましたら、お気兼ねなく再送・キャンセルくださいませ。", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@ryura_san/works/86", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/76df0bf6/uploads/origins/d7f3d914-61ea-442b-b04a-ef6b20869f5d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=8f467a841dc28532d1f07fbf394777df", "src_set": ""}, "private": true, "genre": "art", "tipped": false, "creator_id": 7358, "client_id": 23967, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 176, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@ryura_san/works/85", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 7358, "client_id": 202017, "vtt_url": null, "thumbnail_