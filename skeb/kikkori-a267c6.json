loads/origins/08f587db-5fc4-4215-ae65-5fccf7e1b1e3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f96b3e440a54c56dc6034b94ad6297aa, https://si.imgix.net/047e54c4/uploads/origins/08f587db-5fc4-4215-ae65-5fccf7e1b1e3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=386b943b74aae260aef42768b4f57df8 2x, https://si.imgix.net/047e54c4/uploads/origins/08f587db-5fc4-4215-ae65-5fccf7e1b1e3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=6793e495130116ab7f41a038ed739cdd 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/047e54c4/uploads/origins/08f587db-5fc4-4215-ae65-5fccf7e1b1e3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ffa7b3d984ddc1f8086dab45ce9f7820", "srcset": "https://si.imgix.net/047e54c4/uploads/origins/08f587db-5fc4-4215-ae65-5fccf7e1b1e3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ffa7b3d984ddc1f8086dab45ce9f7820, https://si.imgix.net/047e54c4/uploads/origins/08f587db-5fc4-4215-ae65-5fccf7e1b1e3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=6b2159fdfaf88a7df82feb7b7a1a60a9 2x, https://si.imgix.net/047e54c4/uploads/origins/08f587db-5fc4-4215-ae65-5fccf7e1b1e3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=c9ddca6ba3122d437c160bc261d7e8cd 3x"}, "body": "kiko様、初めまして、アピール有難うございました！\nkiko様の絵柄はとてもかわいいと思います！宜しければ、アピールの中の子と彼の好きな先生と一緒にいるイラストを頼みたいです（ファイル「先生と一緒」参照）。\n\n■キャラクター\n・白くん\n明るくて少しバカな少年。トラブルメーカー。\n心配性だが空気を読めない。いつも身も蓋もないこと言ってるので他人に嫌われる。自分は気づかない。\n憧れの先生の授業中にもぼーっとする。だが意外に理科得意。\nそして、ちょっと厨二病。理由不明で自分がバンパイアかもしれないと思ってる。\n\n・先生\n理科の先生。優しくていつもふわふわしてる。\nのんびりしすぎて、生徒との距離感が全然ない。同僚達に少々変わり者と思われる。自分は気にしない。\nよく生徒にいたずらされる。少し頼りないが、気配りができる。\n好きな子にこっそりひいきにする。その方面は先生としてヤバイかも。\n\n■関係性\nお互い相手の特別な性格や、いじめらるかどうかなどを心配してる。先生から時々相談してる。\nそして、白くんは先生がとても好きで、授業中もいつも先生の顔を見てるだけ、授業の内容が聞き取れない。\n先生はそれを少し困っていて、補習も手伝う。実は両方もこの二人きりの時間を楽しんでいる。\n前は両片想いだが、白くんから感情を告白して、それから秘密に付き合ってる。\n\n■Tips\n白くんの前髮の上にアホ毛があり（三日月型）、右側の耳前の髮を小さい三つ編みにする。\n\n特に指定はありません。衣装も好きな方を選んでください。構図等はお任せ致したいです。\n可能であれば、宛名がpsdのレイヤーでon/offできると幸いです。\n何卒ご検討お願いいたします。\n\nhttps://drive.google.com/drive/folders/1-5YL5keV9k4EgVMeWL1pxD5fD_Mg0Cv4?usp=sharing", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@kikkori/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 121853, "client_id": 2651749, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/22426a11/uploads/origins/8b40ac47-5aa3-4b21-9610-1ff9d8f0c528?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d1157ff0ffafcad7c9929e96a598c0dc", "srcset": "https://si.imgix.net/22426a11/uploads/origins/8b40ac47-5aa3-4b21-9610-1ff9d8f0c528?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d1157ff0ffafcad7c9929e96a598c0dc, https://si.imgix.net/22426a11/uploads/origins/8b40ac47-5aa3-4b21-9610-1ff9d8f0c528?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=65a25d56848e7ec801556af455391ae4 2x, https://si.imgix.net/22426a11/uploads/origins/8b40ac47-5aa3-4b21-9610-1ff9d8f0c528?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=57a1ca9b588cf1cdf93d4a2ef6b8544e 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/22426a11/uploads/origins/8b40ac47-5aa3-4b21-9610-1ff9d8f0c528?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2e8a7ca7f4863ca8e904c567069b9cf7", "srcset": "https://si.imgix.net/22426a11/uploads/origins/8b40ac47-5aa3-4b21-9610-1ff9d8f0c528?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2e8a7ca7f4863ca8e904c567069b9cf7, https://si.imgix.net/22426a11/uploads/origins/8b40ac47-5aa3-4b21-9610-1ff9d8f0