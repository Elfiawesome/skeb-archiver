fff&fm=webp&auto=compress&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=70d90f7bf00b2bfafc4e8fc0017b3997 2x, https://si.imgix.net/9ecb74e9/uploads/outputs/28d622d6-82fa-4f26-acda-41b1780e942a?bg=%23fff&fm=webp&auto=compress&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=02e23493c3702d9d8e9ed31e0570a98d 3x"}, "body": "またまたこんにちはユニ。恐竜VtuberのMawgです！\nhttps://x.com/Mawg_VT\n\nまたお仕事募集しているようなので、またリクエストを送ろうと思います。\nhttps://skeb.jp/@yunibox/works/1\n恐竜のクリスマスパーティーがしたいです！\n\n多分サンタモーグとチャンプはちょっとした助っ人で、いろんな恐竜にアニメのお肉を届けるんだと思います！\nどんな風にするかは、皆さんの想像にお任せします！\n\nありがとうございました！\n\nhttps://imgbox.com/g/eLe2VmkKH6", "nc": 128, "word_count": 0, "transcoder": "video", "creator_acceptable_same_genre": false}, {"path": "/@yunibox/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "video", "tipped": false, "creator_id": 3263789, "client_id": 2403555, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/f2cacd3f/uploads/outputs/275a30ce-a6f1-4293-96b4-04f60e878f93?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&s=6bf346b6e1c4d909dd47a917bcd5ada3", "srcset": "https://si.imgix.net/f2cacd3f/uploads/outputs/275a30ce-a6f1-4293-96b4-04f60e878f93?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&s=6bf346b6e1c4d909dd47a917bcd5ada3, https://si.imgix.net/f2cacd3f/uploads/outputs/275a30ce-a6f1-4293-96b4-04f60e878f93?bg=%23fff&fm=webp&auto=compress&dpr=2&fit=crop&crop=top&w=200&h=200&s=b4bbf96a2527c76132be10c3f5eb5db4 2x, https://si.imgix.net/f2cacd3f/uploads/outputs/275a30ce-a6f1-4293-96b4-04f60e878f93?bg=%23fff&fm=webp&auto=compress&dpr=3&fit=crop&crop=top&w=200&h=200&s=53aa058e596a748db7367e75f439e680 3x"}, "duration": 15, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/f2cacd3f/uploads/outputs/275a30ce-a6f1-4293-96b4-04f60e878f93?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&blur=200&s=3352e2655369641db2b6928934418f3e", "srcset": "https://si.imgix.net/f2cacd3f/uploads/outputs/275a30ce-a6f1-4293-96b4-04f60e878f93?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&blur=200&s=3352e2655369641db2b6928934418f3e, https://si.imgix.net/f2cacd3f/uploads/outputs/275a30ce-a6f1-4293-96b4-04f60e878f93?bg=%23fff&fm=webp&auto=compress&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=5b89f608d3379c144565b8120fa1d414 2x, https://si.imgix.net/f2cacd3f/uploads/outputs/275a30ce-a6f1-4293-96b4-04f60e878f93?bg=%23fff&fm=webp&auto=compress&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=c4c11ade90486ddb19b7043543088441 3x"}, "body": "初めまして、skeb内でムービーを見掛け、とても素敵でしたのでリクエストさせて頂きました。\n以下、ご確認ご検討お願い致します。\n\n■キャラクター\n資料の２名をお願いしたいのですが、厳しければ片方のみで大丈夫です。\n自作ゲーム（ファンタジーRPG）のキャラクターで、兄弟です。\n歳が離れていて、兄弟というよりは親子に近い関係です。一緒に晩酌をしたり、夜に散歩をしたり、弟が演奏して兄が音楽鑑賞したり等で過ごしています。\n\n・ラベンダー\n親代わりだった兄を敬愛しているブラコンな弟。\nジト目の微笑がデフォルト。さっぱりした飾り気のない性格。兄以外には関心が薄く、飄々としています。\n「兄が住む街を守る」という動機で自警団に所属する剣士。戦闘スタイルは防御無視でスピードで突っ込む猪突猛進型。\n剣以外では楽器演奏を得意としており、兄の趣味が音楽鑑賞のため練習している。本人が特別音楽好きな訳ではない。自宅にピアノがある。\n何でもかんでも兄優先。\nモチーフや関連小物：風、剣、酒（酒豪）、楽器（何でも出来る）\n\n・銀髪\n気怠げな様子がデフォルトのダウナーな兄。親代わりでもあります。\n仕事はしっかりしているけど、その反動で家では怠惰。親しい相手の前だと特に露骨。\n弟のことは大事だが、ダウナーな性格のため態度に出にくい。その結果、弟と擦れ違っていた時期があり、解消後は過保護になった。\n教師だが、戦うことも出来る。\nモチーフや関連小物：氷、ナイフ、カードゲーム、酒（酒豪）、音楽（聴く方）\n\n他の方へのリクエストで恐縮ですが、以下も参考になるかと思います。\nhttps://skeb.jp/@moga/works/6\nhttps://skeb.jp/@uninosono/works/169\nhttps://skeb.jp/@sakana_etc/works/3\nhttps://skeb.jp/@utoto_12/works/44\nhttps://skeb.jp/@sikiso_soso/works/97\n\n■シチュエーションなど\nすみません、どの程度表現が出来るのかなど分からなくて、なのでおまかせでお願いしたいと思います。\n\n■利用用途\n個人鑑賞です。\n他、skebの規約でデフォルト許可されている範囲の利用（SNSでのアイコン・ヘッダー利用、シェア）をする場合があります。\n\n以上、ご検討よろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/1kiEAllGSokqsxFkg_YBx73Nx7N1M8UzY?usp=sharing", "nc": 129, "word_count": 0, "transcoder": "video", "creator_acceptable_same_genre": false}, {"path": "/@yunibox/works/4", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/fd873d00/uploads/outputs/eef4862c-aec9-47d9-b5ed-b5ba708df42b?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&