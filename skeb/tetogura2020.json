&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=dbb467cee813598569e57086e4a5e1c1", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/d7f5bef1/uploads/origins/1293150f-755e-4d70-9a18-556761b6ccab?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=7aa45c15f5a406f7baa56f92c6efb903", "src_set": ""}, "body": "アバターのジル（https://booth.pm/ja/items/6519856）をあおいさんの絵柄で描いていただけませんか？ポーズや衣装はお任せします。\n参考につけた写真は、ある程度私の好みに色々盛ってあり、お気に入りの衣装を着せております可愛いオオカミの女の子に仕上がっていると思います。このイメージから感じるところをあおいさんの画力で形にしていただきたいのです。\nいかがでしょうか？\n\nhttps://www.dropbox.com/scl/fi/g4z4kfwi1atyio327y9av/VRChat_2025-03-06_20-19-31.788_1440x2560.png?rlkey=4j3hyao9qvltqfeja5t2ohz8h&st=hhchjr3e&dl=0", "nc": 177, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@tetogura2020/works/68", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/5f18c571/uploads/origins/abaac8fa-6409-4855-b51f-f9a4a0c7a1f5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=d771d1c249c88c234a8f5f2ec47aed57", "src_set": ""}, "private": true, "genre": "art", "tipped": true, "creator_id": 825762, "client_id": 3302849, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 33, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@tetogura2020/works/67", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 825762, "client_id": 1005208, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/44ab94bb/uploads/origins/e3cfd432-4fe5-4d07-8012-f75db48a0558?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c2b58046a31e096fc1ec60af445d5053", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/44ab94bb/uploads/origins/e3cfd432-4fe5-4d07-8012-f75db48a0558?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2deb1e1a6248f0e0a75500059258a755", "src_set": ""}, "body": "久しぶりにカノとマイの双子をお願い出来ますか？\n内容\n18禁\nたまたまお兄ちゃんの隠してたエロ本を見つけその本の真似をしお互いのマ○コを舐め合ってる様子\n自分達の部屋の床かベッドの上で裸か下半身だけ脱いでおり近くに参考にしたエロ本が開かれてる\n69で横になってるか上下に重なってマン○を舐めてる\nアングルは上から見下ろしで\nちなみに当の本人達は遊びだと思っている", "nc": 161, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@tetogura2020/works/66", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 825762, "client_id": 1034109, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/d600d0de/uploads/origins/c4d51692-f0f3-400a-b5b4-073ddd0a5ee9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=62abb63f8f7610984a86d4503639ab44", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/d600d0de/uploads/origins/c4d51692-f0f3-400a-b5b4-073ddd0a5ee9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=8fea84a39fb4fae1f0c58edbbcfa833e", "src_set": ""}, "body": "こんにちは。あなたの作品に興味を持ちましたので、リクエストさせていただきます。私のocのリリーを描いてほしいです。彼女は毛皮を持っていないのですが、毛皮のある彼女を見てみたいです。ベッドに寝そべって、両足をM字に開いてアソコが見えるようにしてほしい。彼女の口にはコンドームがあり、セックスを望んでいることを示している。これでお分かりいただけたでしょうか？ありがとうございました。\n\nhttps://drive.google.com/file/d/1Zn9rHhFV6L-hlBainxUI1Y3DM29Lrb2w/view", "nc": 49, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@tetogura2020/works/65", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 825762, "client_id": 134098, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/e3362fc4/uploads/origins/bd9d976c-3ced-4d7e-afce-6d5f2bf32f4a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=43fb3165a3e47bf62a563bf09debe591", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/e3362fc4/uploads/origins/bd9d976c-3ced-4d7e-afce-6d5f2bf32f4a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=764978455b21dea88439e361d91ac7cf", "src_set": ""}, "body": "実はあおいさんちの子たちの中ではクルミちゃんが最推しでして……今回のはその子達にちょっと癖な内容を依頼しようと思います。\nめちゃくちゃ巨大化したクルミちゃんのこれまたでかいおっぱいの谷間に挟まれてしまうリクくんをお願いしたいです！\nテトリぐらし本編52話直後くらいに、デカい胸と言ってしまった後悔と脳裏に焼き付いたおっぱいの光景からリクくんが見てしまった悪夢……的なオチで！\nクルミちゃんの表情は、この時はリクくんにとってはまだ知らない女の子のはずなので『失礼な！』って怒りながらおっぱいで捕まえているのもいいですし、高い母性から慈悲深い微笑みで包み込んでいるのもありですね……選びきれないのでさかもとあおいさんにお任せします！\n服装は全裸で！", "nc": 33, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@tetogura2020/works/64", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 825762, "client_id": 134098, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/a1e6e030/uploads/origins/58075617-f1de-4d17-bc31-12f7d452cf9b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=749ccbc0542976f7156fc6acada40b85", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/a1e6e030/uploads/origins/58075617-f1de-4d17-bc31-12f7d452cf9b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3a2dd6ca2a5f01cbd3470a9c3812d5bb", "src_set": ""}, "body": "久々にライラ（https://www.dropbox.com/scl/fo/cs3fl4yrsg8x2yp85nep1/ANevgfop9zCjcAfDcc1qCS0?rlkey=jk4dz5k53mc795hy9t1lz7t2x&dl=0）を描いていただけませんか？ガッツリえっちなのはそういえば描いていただいたことがなかったと思うので、今回は『オナニーし終わって息が上がったまま、股間をティッシュ等でぐしゃぐしゃと拭いている』事後シチュエーションでお願いします！\n 近場に何故か粘液まみれで膣に向かって糸を引いている東京タワーかスカイツリーのような大型建造物が乱雑に転がっていると助かります。\n\nhttps://www.dropbox.com/scl/fo/cs3fl4yrsg8x2yp85nep1/ANevgfop9zCjcAfDcc1qCS0?rlkey=jk4dz5k