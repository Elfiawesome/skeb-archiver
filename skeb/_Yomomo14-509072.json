んにちは、夜桃🍑さまのミク等とても素敵なイラスト拝見させていただいております、よろしければ推しのVのファンアートを依頼させてください\n個人VTuberの「月火さらダ」さんと言う方で\n\nおもに人狼や\nドレッドハンガーというゲームを中心に活動しています(もしゲームを調べる際はグロテスクな表現がある所があるため注意です)\n\n用途）\nYouTubeのサムネイル等にも使えるように\n背景無しのキャラクターのみのイラストも頂けると嬉しいです。\nまた、頭や手が途中で切れてないものだと助かります。\n\n依頼）\nポージングや衣装についてはお任せいたします\n宜しければプロセカでいう咲希ちゃんのような明るい感じでお願いしたいです\n\nお忙しいところ恐縮ですが\n改めてよろしくお願いします\n\nVTuber本人へのプレゼントとYouTube、Twitter等SNSで使用することを想定しています。\nご検討のほどよろしくお願いします。\n\nhttps://x.com/sarada_tsukihi", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@_Yomomo14/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2024414, "client_id": 3643427, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/346f886c/uploads/origins/783d57d6-7282-43fe-89ff-c9e6455717f1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d0bb42876ab634ef0060094ae6bdea45", "srcset": "https://si.imgix.net/346f886c/uploads/origins/783d57d6-7282-43fe-89ff-c9e6455717f1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d0bb42876ab634ef0060094ae6bdea45, https://si.imgix.net/346f886c/uploads/origins/783d57d6-7282-43fe-89ff-c9e6455717f1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f73630deda712303df1174ede98a9ff7 2x, https://si.imgix.net/346f886c/uploads/origins/783d57d6-7282-43fe-89ff-c9e6455717f1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=2528f17ffc109b907e9d270cb48e9f2f 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/346f886c/uploads/origins/783d57d6-7282-43fe-89ff-c9e6455717f1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c7db7b17be0d353457d90b688f317586", "srcset": "https://si.imgix.net/346f886c/uploads/origins/783d57d6-7282-43fe-89ff-c9e6455717f1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c7db7b17be0d353457d90b688f317586, https://si.imgix.net/346f886c/uploads/origins/783d57d6-7282-43fe-89ff-c9e6455717f1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=12ee7b3313e0a10d7aa950f610804d17 2x, https://si.imgix.net/346f886c/uploads/origins/783d57d6-7282-43fe-89ff-c9e6455717f1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=434b82f70d65fe16ef6ca03e138ed0c2 3x"}, "body": "夜桃様\n\n初めまして。\nいつもとても素敵なミクちゃん達のイラストをありがとうございます。\n今回は、私の推しVtuberさんのイラストをお願いしたいです。\n\n【キャラクター】\n個人EN/JP Vtuberで 狼少女の「marichanduhh」さんのイラストをお願いいたします。\nファンアートの許可はご本人よりいただいております。\nhttps://x.com/marichanduhh\n\n【イラスト内容】\n雨の中傘を差しながら、手を差し伸べてるような構図を見てみたいです。\n他に合いそうなものがあればお任せでも構いません。\n\n【用途】\n自分の観賞用+ご本人へのプレゼントとして、TwitchやSNS等の配信活動で使用できる許可をいただければ嬉しく思います。\n人物や背景がレイヤー分け出来るPSDデータでいただけると大変助かります。\n\nhttps://drive.google.com/drive/folders/17VVNCa4e8MDCtpuqA2fI9qzQ9VgRXZmL?usp=sharing", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@_Yomomo14/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2024414, "client_id": 103289, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/d1c88f08/uploads/origins/0844f0cf-9739-4364-9cac-078b05701ae3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=071ef9911634f21aaa1b95a094d853c6", "srcset": "https://si.imgix.net/d1c88f08/uploads/origins/0844f0cf-9739-4364-9cac-078b05701ae3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=071ef9911634f21aaa1b95a094d853c6, https://si.imgix.net/d1c88f08/uploads/origins/0844f0cf-9739-4364-9cac-078b05701ae3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c5298fdbf0b5b00e3ecb29c0b8d41b51 2x, https://si.imgix.net/d1c88f08/uploads/origins/0844f0cf-9739-4364-9cac-078b05701ae3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=57241ecd94b986bdc475f3f40e72cafc 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/d1c88f08/uploads/origins/0844f0cf-9739-4364-9cac-078b05701ae3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=7dfdce67f0805a64dcf013447b2a0dad", "srcset": "https://si.imgix.net/d1c88f08/uploads/origins/0844f0cf-9739-4364-9cac-078b05701ae3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=7dfdce67f0805a64dcf013447b2a0dad, https://si.imgix.net/d1c88f08/uploads/origins/0844f0cf-9739-4364-9cac-078b05701ae3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=742b3c50b419645412ea2220b2322c28 2x, https://si.imgix.net/d1c88f08/uploads/origins/0844f0cf-9739-4364-9cac-078b05701ae3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=ebb6ae4848337770be038b16a1f94553 3x"}, "body": "怠惰な初音ミクを描いてください。ソファに寝転がってお菓子を食べていたり、ふかふかの椅子に座っていたり。衣装は何でも構いません。\n\nもっと元気な初音ミクを描きたい方は、疲れている（ダラダラしている）初音ミクではなく、嬉しそうに迎えている表情の初音ミクを描いてください。もしかしたらミクは、見る人が家に着くことに安堵しているかもしれない。\n\n細部はすべてあなたの自由です。\n\nありがとうございました。", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@_Yomomo14/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2024414, "client_id": 1345972, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/1a796a33/uploads/origins/7a13bff2-47cf-4a12-b05c-97ed9c7c2555?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=372371bb217f43750f2e47c210f2290a", "srcset": "https://si.imgix.net/1a796a33/uploads/origins/7a13bff2-47cf-4a12-b05c-97ed9c7c2555?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=372371bb217f43750f2e47c210f2290a, https://si.imgix.net/1a796a33/uploads/origins/7a13bff2-47cf-4a12-b05c-97ed9c7c2555?bg=%23fff&auto=format%2C