6/uploads/origins/6ef98e23-37d5-408d-a6e0-5df3a9e5ed46?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=02ff5434e9dd80febb142a5a0c2fdf3a 3x"}, "body": "はじめてのリクエストをいたします。\n以前りゅうたまのイラストを描いていらっしゃった際、なんてりゅうたまらしい素敵なイラストだろう！と感銘を受けておりました。\nBOOTHで公開してくださっている、りゅうたまアイコンも大変ありがたく使わせていただいております。\n\n●リクエストの内容\nTRPG「りゅうたま」のGM用キャラクター（竜人）。名称は「ミスラ」。\nステータス的には、カンテラを所有する緑竜です。ブレス「フォーチュン」「ミスフォーチュン」を用いて、新人旅人さんたちを翻弄、あるいは導く光明神……というイメージです。\n容姿はURLを参考になさってください。\n\n●使用目的\n眺めて楽しみます。（商用利用の予定はありません）\n絵の上手い人が描いた、自分のキャラクターを見てみたい。\n\n●その他\nこういったリクエストの作法に疎いため、詳細はお任せいたします。よいように/あるいはやりやすい形式で。\n\nhttps://drive.google.com/drive/folders/1yo5hihSV-8tXxOBlZWmZrMXlDF4GGZY6", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@BlandocoPaloma/works/8", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 119649, "client_id": 2049553, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/901da526/uploads/origins/d17abd33-7f74-4005-bfae-7e45f81d364d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1d60dc2e0e28b95488e0a4a9211975d0", "srcset": "https://si.imgix.net/901da526/uploads/origins/d17abd33-7f74-4005-bfae-7e45f81d364d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1d60dc2e0e28b95488e0a4a9211975d0, https://si.imgix.net/901da526/uploads/origins/d17abd33-7f74-4005-bfae-7e45f81d364d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=021197a58f8817afecb07eb62b7c7bbd 2x, https://si.imgix.net/901da526/uploads/origins/d17abd33-7f74-4005-bfae-7e45f81d364d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b993b6e571930de8d8788d6847270b1f 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/901da526/uploads/origins/d17abd33-7f74-4005-bfae-7e45f81d364d?bg=%23fff&auto=format%2Ccompress&fm=webp&