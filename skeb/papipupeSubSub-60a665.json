-christian/\n\n長々と書いてしまいましたが自由に描いて頂けましたら幸いです。言い回しが変に聞こえたら申し訳ありません。 良い日をお過ごし下さいませ！よろしくお願いします！\n\nhttps://shenyanigans.notion.site/christian-references", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@papipupeSubSub/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3872806, "client_id": 3656283, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/00c5ae53/uploads/origins/4f08df8f-a613-47ad-988d-c54bb151d867?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=75b5114060b1d6f9d8a2f3c45c0dba83", "srcset": "https://si.imgix.net/00c5ae53/uploads/origins/4f08df8f-a613-47ad-988d-c54bb151d867?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=75b5114060b1d6f9d8a2f3c45c0dba83, https://si.imgix.net/00c5ae53/uploads/origins/4f08df8f-a613-47ad-988d-c54bb151d867?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=1884d5987706ef9091418439b0a45315 2x, https://si.imgix.net/00c5ae53/uploads/origins/4f08df8f-a613-47ad-988d-c54bb151d867?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=215f0a87027a0dbe617f314852349967 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/00c5ae53/uploads/origins/4f08df8f-a613-47ad-988d-c54bb151d867?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3258e4792c09b89bd2a050818b0f2e42", "srcset": "https://si.imgix.net/00c5ae53/uploads/origins/4f08df8f-a613-47ad-988d-c54bb151d867?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3258e4792c09b89bd2a050818b0f2e42, https://si.imgix.net/00c5ae53/uploads/origins/4f08df8f-a613-47ad-988d-c54bb151d867?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=108c893b7dc9167861e5464ff0ac5b96 2x, https://si.imgix.net/00c5ae53/upl