461eb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=045f0e38e7b27022da2c90e9e7ce8f44", "srcset": "https://si.imgix.net/047775c5/uploads/origins/3ddbc058-009b-4c96-89da-b459657461eb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=045f0e38e7b27022da2c90e9e7ce8f44, https://si.imgix.net/047775c5/uploads/origins/3ddbc058-009b-4c96-89da-b459657461eb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=32749bb903604335e5c093b5f6808e69 2x, https://si.imgix.net/047775c5/uploads/origins/3ddbc058-009b-4c96-89da-b459657461eb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=51a041cd86b9d177cbc958e13143ffe1 3x"}, "body": "超時空要塞マクロス愛おぼえていますか\nのリン・ミンメイが着用していた衣装と\n髪型を似せたふたなりコスプレ姉さんが\n騎乗位で逆レしながら、己の昂りに従い\n段々と彼女のふたなりチンポがスカート\nの前面を怒張させてゆく様子を是非とも\n描いて頂きたいのですが。\n尚、勃起したふたなりチンポや結合部は\nスカートの陰に隠れてると嬉しいです。\nでは以上の通り宜しくお願い致します。\n\nhttps://x.com/LMP500/status/1757379294396022932", "nc": 169, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Sankakusukeb/works/8", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1067476, "client_id": 73101, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/d091b927/uploads/origins/a2806e56-d0a1-4a0b-bf10-5566cfddd075?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6557ff3394ca3b351fe7000e0d6bd250", "srcset": "https://si.imgix.net/d091b927/uploads/origins/a2806e56-d0a1-4a0b-bf10-5566cfddd075?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6557ff3394ca3b351fe7000e0d6bd250, https://si.imgix.net/d091b927/uploads/origins/a2806e56-d0a1-4a0b-bf10-5566cfddd075?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a2bcb6062be5f50c8cbf6208f68dd7c8 2x, https://si.imgix.net/d091b927/uploads/origins/a2806e56-d0a1-4a0b-bf10-5566cfddd075?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=134e63a31670c7527f006d8222eef0ae 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/d091b927/uploads/origins/a2806e56-d0a1-4a0b-bf10-5566cfddd075?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6997cb1d1bfc217c7c004e1d60836380", "srcset": "https://si.imgix.net/d091b927/uploads/origins/a2806e56-d0a1-4a0b-bf10-5566cfddd075?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6997cb1d1bfc217c7c004e1d60836380, https://si.imgix.net/d091b927/uploads/origins/a2806e56-d0a1-4a0b-bf10-5566cfddd075?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=54640343adde63838f084daef3755482 2x, https://si.imgix.net/d091b927/uploads/origins/a2806e56-d0a1-4a0b-bf10-5566cfddd075?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=56a089728cdc0c5b93b3dedaba3fd6cb 3x"}, "body": "機材トラブルの件、心中お察し致します。\n\n改めて同様の内容にて再送させて頂きますが、条件的・状況的に厳しいようでしたら、遠慮なくキャンセルなさって大丈夫ですので、お気軽にご判断下さいませ。\n\n①大人なふたなりお姉さん×思春期ふたなりっ娘のシチュエーション\n\n②ふたなりっ娘のおちんちん成長ビフォーアフターの構図\n・可能であれば、思春期頃→数年後→更に数年後の３段階で描写頂けると幸いです。\n　（２～３年刻みが理想ですが、お好みでＯＫです）\n\n・いずれの段階も２人とも全裸で、おちんちんは勃起していない平常時の描写でお願いできればと思います。\n\n③１段階目では、色々と貧相な身体に悩む思春期ふたなりっ娘（陥没乳首の貧乳・短小包茎の可哀想なおちんちん・皮の上から亀頭の形も分からないレベル・玉も小さめ）が、大人のふたなりお姉さん（爆乳とまではいかないがしっかり巨乳で乳首はしっかり飛び出た大人な乳首、ズル剥けカリ高、玉もしっかりしている、使い込み感のある浅黒の大人ちんちん）に悩みを相談している場面\n\n④2段階目では、お姉さんの手ほどき（行為の描写等は不要です）により少し成長した段階。胸はいくらか成長し陥没していた乳首も少し顔を覗かせるようになっている、短小包茎だったおちんちんも普通レベルにまで成長、まだ包茎ではあるものの亀頭は半分ほど顔を出しており、亀頭のカリ首の形も少し確認できるレベルに成長）\n\n⑤3段階目では、お姉さんほどまではいかないが、胸もしっかり成長（陥没乳首も完全に卒業し、飛び出てビンビンになっている）、おちんちんはお姉さんより少し小さいくらいにまで追い付き、皮は完全に剥けてズル剥け、2段階目よりは少し色も黒くなっている。\nお姉さんはしっかり成長した（させた）おちんちんを感慨深そうに見ている。\n\n※いずれの段階も、ふたなりお姉さんの身体は変化なしでＯＫです\n※指定していない描写のディティール等はさんかく様のお好みで描写して下さってＯＫです", "nc": 185, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Sankakusukeb/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1067476, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/571f427f/uploads/origins/0d31d017-780f-4ef9-ba06-b1919c1aedcf?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b42597cbede819af8b68721e996c225d", "srcset": "https://si.imgix.net/571f427f/uploads/origins/0d31d017-780f-4ef9-ba06-b1919c1aedcf?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b42597cbede819af8b68721e996c225d, https://si.imgix.net/571f427f/uploads/origins/0d31d017-780f-4ef9-ba06-b1919c1aedcf?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=960cbeba72d2a2b0a0cae21632db99ad 2x, https://si.imgix.net/571f427f/uploads/origins/0d31d017-780f-4ef9-ba06-b1919c1aedcf?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e34b659ec85b50d902b1c9daee90c740 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/571f427f/uploads/origins/0d31d017-780f-4ef9-ba06-b1919c1aedcf?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a863db0f380f3f7140b98a05f27242cb", "srcset": "https://si.imgix.net/571f427f/uploads/origins/0d31d017-780f-4ef9-ba06-b1919c1aedcf?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a863db0f380f3f7140b98a05f27242cb, https://si.imgix.net/571f427f/uploads/origins/0d31d017-780f-4ef9-ba06-b1919c1aedcf?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=e834e6190f2f4d8dbca9cfd1b340249d 2x, https://si.imgix.net/571f427f/uploads/origins/0d31d017-780f-4ef9-ba06-b1919c1aedcf?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=7f89db5abe3b3dbcff2ab66e6a5abd26 3x"}, "body": "はじめまして、オリキャラの立山さんを拝見して依頼をさせて頂きたいと思いました。\n\nアズールレーンのふたなり吾妻さんをお願いします。\n衣服は通常の白いブラウス、白いコートの様な物を肩にかけている、紺のスカート、パンストをはいてるコスで。\nシチュエーションは着衣で立っている状態、ガチガチにフル勃起させた男性生殖器を手コキして射精してる物をお願いします。\n\n以下詳細ですが、イチモツは胸元まで届きそうな巨根で、血管がバキバキに浮き上がっていて、亀頭の傘が大きく開いたエグい物をお願いします。\nまた、勃起しているイチモツでパンストが引っ張られて大きなテントを張っている様な状態にしてください。\n精液は濃いクリーム色になっているくらいの濃い物を大量に射精させてください。\n射精前、射精後とイチモツにパンストが被っていない物を差分でお願い致します。", "nc": 161, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Sankakusukeb/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1067476, "client_id": 989786, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/0240a155/uploads/origins/b3f6066e-4114-4be5-814a-f6b2b7dbb18b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2c54aacaee5fc02052ba715a9029bc80", "srcset": "https://si.imgix.net/0240a155/uploads/origins/b3f6066e-4114-4be5-814a-f6b2b7dbb18b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2c54aacaee5fc02052ba715a9029bc80, https://si.imgix.net/0240a155/uploads/origins/b3f6066e-4114-4be5-814a-f6b2b7dbb18b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ff190105cd265204d675cf32edd6f058 2x, https://si.imgix.net/0240a155/uploads/origins/b3f6066e-4114-4be5-814a-f6b2b7dbb18b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=0ac734e2cf408994960cd745398d4fb8 3x"}, "duration": null, "nsfw": true, "hardcore": true, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/0240a155/uploads/origins/b3f6066e-4114-4be5-814a-f6b2b7dbb18b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=908e3c72b58260b55c370caa4e1e216d", "srcset": "https://si.imgix.net/0240a155/uploads/origins/b3f6066e-4114-4be5-814a-f6b2b7dbb18b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=908e3c72b58260b55c370caa4e1e216d, https://si.imgix.net/0240a155/uploads/origins/b3f6066e-4114-4be5-814a-f6b2b7dbb18b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=21eaa6af9316e723956d171f03daf6ed 2x, https://si.imgix.net/0240a155/uploads/origins/b3f6066e-4114-4be5-814a-f6b2b7dbb18b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=35cc999e07197a9d37818ce2a1fed085 3x"}, "body": "お世話になっております。\nまた今回も麻里さんｘしずくちゃんのイラストをお願いしたく思います。\nhttps://skeb.jp/@Sankakusukeb/works/3の後のお掃除イラマのような内容で、urlのような構図で、スケベイスに座った麻里さんがボテ腹しずくちゃんの喉を容赦なく犯していく様子を考えています。\nしずくちゃんはされるがままで、以下の流れをお願いできますでしょうか。\n\n見せ槍状態。頭に麻里さんの金玉が乗るくらいの状態\n→一気にぶち込まれ、喉ボコ。えずいて吐きそうになるしずくちゃん\n→喉奥で射精。ザーゲロをまき散らし痙攣しながら失禁アクメする。アクメの影響で子宮から精液が噴き出し、お腹が少しだけへこむ\n→ちんぽを抜かれ、床に降ろされ、舌を出して精液を吐きぐったり脱力状態。顔～股間にかけて麻里さんの精液が降りかかる。\n\nいつも変態シチュを申し訳ありませんが、ご検討お願いいたします。\n\nhttps://top-fans.com/wp-content/uploads/2020/06/nanase_hina-3.jpg", "nc": 171, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Sankakusukeb/works/5", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/da4a1eb5/uploads/origins/60853e45-844a-4619-85fe-034d51c1fca3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=68759c14b92de9b80a9d5620f1849ca2", "srcset": "https://si.imgix.net/da4a1eb5/uploads/origins/60853e45-844a-4619-85fe-034d51c1fca3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=68759c14b92de9b80a9d5620f1849ca2, https://si.imgix.net/da4a1eb5/uploads/origins/60853e45-844a-4619-85fe-034d51c1fca3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=b2a5d94c5a8302f173fe1132978f03df 2x, https://si.imgix.net/da4a1eb5/uploads/origins/60853e45-844a-4619-85fe-034d51c1fca3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtf