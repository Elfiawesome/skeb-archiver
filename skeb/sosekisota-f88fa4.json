s&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=33d422f8988241820a397b6f1836a02d, https://si.imgix.net/5baed27f/uploads/origins/1211e639-2f6d-4ec5-9e6e-e9db4688321c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=1d151468e869b19fb32d12f632694cf5 2x, https://si.imgix.net/5baed27f/uploads/origins/1211e639-2f6d-4ec5-9e6e-e9db4688321c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=65272c2be2014fc16988786121ea27b8 3x"}, "private": true, "genre": "art", "tipped": false, "creator_id": 2843418, "client_id": 1289616, "nc": 129}, {"path": "/@sosekisota/works/11", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2843418, "client_id": 1029245, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/bc78c138/uploads/origins/8df3397f-c63d-42f4-b54a-7ad639f04630?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8b38f1ab5e0b49074d314fdf7b5271b6", "srcset": "https://si.imgix.net/bc78c138/uploads/origins/8df3397f-c63d-42f4-b54a-7ad639f04630?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8b38f1ab5e0b49074d314fdf7b5271b6, https://si.imgix.net/bc78c138/uploads/origins/8df3397f-c63d-42f4-b54a-7ad639f04630?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=07c28e07343e48615934141ac8589408 2x, https://si.imgix.net/bc78c138/uploads/origins/8df3397f-c63d-42f4-b54a-7ad639f04630?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b24f5df6a015f63fef092163899e7128 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/bc78c138/uploads/origins/8df3397f-c63d-42f4-b54a-7ad639f04630?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=57f919c941eecb431f1a80bb38bbda4e", "srcset": "https://si.imgix.net/bc78c138/uploads/origins/8df3397f-c63d-42f4-b54a-7ad639f04630?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=57f919c941eecb431f1a80bb38bbda4e, https://si.imgix.net/bc78c138/uploads/origins/8df3397f-c63d-42f4-b54a-7ad639f04630?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=53be50557a9e150091e2c2116c53951a 2x, https://si.imgix.net/bc78c138/uploads/origins/8df3397f-c63d-42f4-b54a-7ad639f04630?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=8f575bbb881137e18ff83590fa6116d7 3x"}, "body": "茶太郎さんこんにちは、メ=ルックレイです\n茶太郎さんが描かれたイラストや立ち絵をTLで拝見する度に素敵だなと思っておりました……この機会にリクエストさせて頂きます！！\n※もし金額等に不備がありましたら再送いただけると幸いです。  \n良ければ是非よろしくお願いします！\n\n◾︎使用用途 \n個人観賞用 \nSNS等のアイコン・ヘッダー \nココフォリアでの使用(※自陣のみ) \n自陣用グッズ作成  \n\n◾︎依頼内容 \n・私とフォロワーのCoCで使用している探索者キャラクター計2名のイラストをお願いしたいです。※相手許可済み\n・探偵と助手という関係性の2人なので、ミステリー小説の表紙のような雰囲気のイラストでお願いしたいです…！\n・椅子に腰かける探偵に寄り添っている助手みたいなの雰囲気をイメージしていますが、構図や細かい部分はお任せします……お好きに描いていただけると嬉しいです！\n\n◾︎関係性の雰囲気など \n・互いのことは「徒枝さん」「先生」呼び\n・2人とも感情が大きく出るタイプではなく、淡々としている感じです。※たまに幽寂の発言に困惑する徒枝みたいなのもあり\n・雰囲気が2人とも探偵モノのシリーズ小説の登場人物のような感じです。探偵だけでなく助手にも一癖ある。\n\n◾︎探索者 \n探偵：幽寂 飛白(ゆうじゃく かすり)\n年齢不明(20代)／女(中性的)／身長150cm前半台\n性格▶︎端的に言うとダウナーな変人探偵。絶望的に愛想がなく表情変化にも乏しく、助手をこき使ういい加減な生活をしているが頭脳はホンモノ。趣味は書を認めることだが、いい加減な字体のため毎度読みづらく、服に墨がつくこともしばしば。趣味は羽根突きと〇✕ゲーム(※いつも羽子板を持っている)好きなものは利益。かなり貧弱。\n詳細なCS▶︎ https://charasheet.vampire-blood.net/4825247\n\n助手：徒枝 叶召(かちえだ かなめ)\n19歳／女／身長160cm後半台？\n性格▶︎ 幽寂を先生と呼び、熱心に付き随っている。\n俗に言う恋愛感情は持ち合わせておらず、「一つのものに熱意を注ぎ込み、結果を得る」事を最大の歓びとする。\n基本的に出しゃばらず、飛白の意見に口出ししない。黙々と振られた仕事をこなし、必要であれば家事も行う。事務所の助手は自分一人で良いと思っている。\n現在は探偵社が入るテナントビルの2階に住み込む形で働いている。\n詳細なCS▶︎ https://iachara.com/view/5507547\n\n◾︎資料 \nhttps://drive.google.com/drive/folders/1-17rgIuTePHwJw9507-Yx36zmFVItg6W\n\n※添付CSや資料等に特にネタバレ等はありません。\n\nhttps://drive.google.com/drive/folders/1-17rgIuTePHwJw9507-Yx36zmFVItg6W\n\nhttps://drive.google.com/drive/folders/1-17rgIuTePHwJw9507-Yx36zmFVItg6W", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@sosekisota/works/10", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/3b126188/uploads/origins/437a44a5-3a41-4559-8117-10a8be29f9a6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=cc425e7132121274404eeeb1247e2d10", "srcset": "https://si.imgix.net/3b126188/uploads/origins/437a44a5-3a41-4559-8117-10a8be29f9a6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=cc425e7132121274404eeeb1247e2d10, https://si.imgix.net/3b126188/uploads/origins/437a44a5-3a41-4559-8117-10a8be29f9a6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=75d3efa5f982c676a38712a386da0d19 2x, https://si.imgix.net/3b126188/uploads/origins/437a44a5-3a41-4559-8117-10a8be29f9a6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=9349483bcb6fc8f1ad81b14906065883 3x"}, "private": true, "genre": "art", "tipped": true, "creator_id": 2843418, "client_id": 2079622, "nc": 17}, {"path": "/@sosekisota/works/9", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2843418, "client_id": 3475110, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/97aac6c5/uploads/origins/1a0dc471-b16f-4b6c-9763-1d1d0467a6f6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3762c8a39b23e776d2b81cad1d38fcba", 