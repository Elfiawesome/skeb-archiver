ルほど　天井まで2.5mほどの円柱状の真っ白い空間\nベット・浴槽・栄養液が出て来る管がある。\n二人の体や部屋の汚れは部屋そのものに自然と吸収される仕組み\n息子が出産した物体は床を透過していく仕組み\n\n出産される物体\n小さいメロンほどの大きさ。\nテラフォーミングする用の有機物を含んでいる。\n\nその他要望\nダークな描写よりも性的な描写を重視してください。(その他設定の宇宙人などのSF要素の描写はあくまで舞台設定程度でお願いします。)\n挿げ替え後も口調は元のままでお願いします。\nプレイ内容はひょっとこフェラなどの、喘ぎ声や台詞内容は濁点や淫語まみれなど徹底的に下品な内容でお願いします。\n以上です。よろしくお願いします。", "nc": 169, "word_count": 9845, "transcoder": "text", "creator_acceptable_same_genre": false}], "sent_works": [{"path": "/@AZ66847058/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 69328, "client_id": 6082, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/ca14a939/requests/111524_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=370426c104e84d1107f3e14324658034", "srcset": "https://si.imgix.net/ca14a939/requests/111524_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=370426c104e84d1107f3e14324658034, https://si.imgix.net/ca14a939/requests/111524_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=7a561f8770ddd2fbc00463be87a1d94e 2x, https://si.imgix.net/ca14a939/requests/111524_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e502f285dd975b542e5c0ebd6a1fbba8 3x"}, "duration": null, "nsfw": true, "hardcore": true, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/ca14a939/requests/111524_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ef9a1d127442443dda01bd993997dc1b", "srcset": "https://si.imgix.net/ca14a939/requests/111524_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ef9a1d127442443dda01bd993997dc1b, https://si.imgix.net/ca14a939/requests/111524_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=f521b53a04f8e9e1812bbc481c7149ed 2x, https://si.imgix.net/ca14a939/requests/111524_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&