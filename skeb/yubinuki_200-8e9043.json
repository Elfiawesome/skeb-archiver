学生\n性格はクールでやや近寄りがたい雰囲気\n本人は何も考えていない\n\n服装ですがメーカーで作成させて頂いたものでも別のデザインでも構いません\n見えていない所のデザインはお任せします\n\n■+α\n舌にピアスあります\nピアスあるのが分かるように舌を出したものを描いて頂きたいです\n\nhttps://www.dropbox.com/sh/r0hsulzpm42q2m1/AAAcFW5SOrSm-EmA_oJzj6u3a?dl=0", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@yubinuki_200/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2402224, "client_id": 49341, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/12e141b7/uploads/origins/cd66ba26-5e15-43d7-ad62-9cda3092b5d0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=28a433b52928c245169d3aaff4902f86", "srcset": "https://si.imgix.net/12e141b7/uploads/origins/cd66ba26-5e15-43d7-ad62-9cda3092b5d0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=28a433b52928c245169d3aaff4902f86, https://si.imgix.net/12e141b7/uploads/origins/cd66ba26-5e15-43d7-ad62-9cda3092b5d0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=d8ee404c2956d4f1f8d48b019a0711cc 2x, https://si.imgix.net/12e141b7/uploads/origins/cd66ba26-5e15-43d7-ad62-9cda3092b5d0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e107778a8e7955dc6a0fc114c6a872a8 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/12e141b7/uploads/origins/cd66ba26-5e15-43d7-ad62-9cda3092b5d0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a527208fddc8f4907eddb390c51f2f72", "srcset": "https://si.imgix.net/12e141b7/uploads/origins/cd66ba26-5e15-43d7-ad62-9cda3092b5d0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a527208fddc8f4907eddb390c51f2f72, https://si.imgix.net/12e141b7/uploads/origins/cd66ba26-5e15-43d7-ad62-9cda3092b5d0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=1fe90eb1348d92baf9daf19a63387bac 2x, https://si.imgix.net/12e141b7/uploads/origins/cd66ba26-5e15-43d7-ad62-9cda3092b5d0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=b768345fb1ce56bd11a9c0679088db47 3x"}, "body": "サンミ様、初めまして\n以前から素敵なイラストをお見掛けしており、キャンペーン期間中にお願いできたらと思いリクエスト致します\nTRPGの自分の探索者のイラストをお願いしたいです\nご検討宜しくお願い致します！\n\n■容姿等\n資料URLに過去に立ち絵や過去にコミッションで依頼したイラストがございます\n容姿についてはそちらを参考にしてください\n以下、補足\n・ヒューゴ・グリフィン\nイギリス人、年齢17歳\n髪は紫、襟足少し長め\n目はアイスブルー、つり目\n肌は色白\n体格は身長176cm、手足長めでそれ以外は標準\n筋肉はあるものの脂肪がない細マッチョ\n性格はクールで知的、思いやりがないのでぶっきらぼう\n勉強すること、本を読むことが好きで集中すると食事も睡眠も忘れる\n\n■構図\nお任せします\n立ち絵でも日常の1コマのような1枚絵でも構いません\n\n服装はイギリス人なので英国紳士っぽくして頂けると嬉しいです\n基本は無表情、気持ちが和らいだ際に表情が柔らかくなります\n\nhttps://www.dropbox.com/sh/ijmlznmtp77uh4x/AABQhtRqShiUagcBxXHLHp_Sa?dl=0", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@yubinuki_200/works/3", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/d65b82b9/uploads/origins/35b2fd54-cae7-46a1-8d90-89b58c3c2a58?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=201415474dad771dacb818c996264c7a", "srcset": "https://si.imgix.net/d65b82b9/uploads/origins/35b2fd54-cae7-46a1-8d90-89b58c3c2a58?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=201415474dad771dacb818c996264c7a, https://si.imgix.net/d65b82b9/uploads/origins/35b2fd54-cae7-46a1-8d90-89b58c3c2a58?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=d99587c7b0ee24d8b4060afe8a9812f5 2x, https://si.imgix.net/d65b82b9/uploads/origins/35b2fd54-cae7-46a1-8d90-89b58c3c2a58?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=50addefabdbcf3a7ff19fa81667682e9 3x"}, "private": true, "genre": "art", "tipped": true, "creator_id": 2402224, "nc": 128}, {"path": "/@yubinuki_200/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2402224, "client_id": 461604, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/a9240e39/uploads/origins/ebe01aaa-8c97-48b3-81fe-d3fb5b7d4cc3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=27c53f0584b621f0cab6fd4a741016e1", "srcset": "https://si.imgix.net/a9240e39/uploads/origins/ebe01aaa-8c97-48b3-81fe-d3fb5b7d4cc3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=27c53f0584b621f0cab6fd4a741016e1, https://si.imgix.net/a9240e39/uploads/origins/ebe01aaa-8c97-48b3-81fe-d3fb5b7d4cc3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=62a514707f709dc43727b88c435a7497 2x, https://si.imgix.net/a9240e39/uploads/origins/ebe01aaa-8c97-48b3-81fe-d3fb5b7d4cc3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=03798c709c882e484de6ccf62f99bc75 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/a9240e39/uploads/origins/ebe01aaa-8c97-48b3-81fe-d3fb5b7d4cc3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b52edf63fe0abc361d1f6e787849e863", "srcset": "https://si.imgix.net/a9240e39/uploads/origins/ebe01aaa-8c97-48b3-81fe-d3fb5b7d4cc3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b52edf63fe0abc361d1f6e787849e863, https://si.imgix.net/a9240e39/uploads/origins/ebe01aaa-8c97-48b3-81fe-d3fb5b7d4cc3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=a143c4f995d74ecb749d18b94181c5cd 2x, https://si.imgix.net/a9240e39/uploads/origins/ebe01aaa-8c97-48b3-81fe-d3fb5b7d4cc3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=e0276d9658e970a62ba44b09cc339092 3x"}, "body": "サンミちゃん、あけましておめでとうございます！\n\nTRPGで使う予定の立ち絵を頼もう！と思って機会を伺っていました\nよければ私のOCのキャラデザと、立ち絵をお願いできませんか？\n\n❖概要\nTRPG「クトゥルフの呼び声」で使用するキャラクターイラストです\n・セッションツール「ココフォリア」にてコマとして\n・各種SNSにてアイコンとして\n・今後絵の依頼サイトで出す参考絵として\n上記3点で使用します。いずれも非商用、個人用です\n\n描写範囲は半身/全身構いません\n思いつくようでしたら何点か表情差分があると嬉しいです！\n\n❖キャラの設定\n大学二年生。20歳。大経済学部学生。\n遊ばせた短め茶髪、緑の瞳。よく見せるのは快活な笑顔。\n左目下に泣き黒子のある男子。\nあまり自信のない態度を見せず、楽天家で、楽しめることを全力で楽しむタイプ。\n\nクラスカーストでいうと上位の方のチームにそれとなく所属しているが、\n本人に所属意識はそんなになく、男女問わず誰とでも分け隔てなくしゃべる。\n小学校の時は足が早く、中学ではクラス内ではサッカーが上手く、高校では女子に優しく、\n常に程良くモテてている。彼女はいつも居たり居なかったり。\n\n中高はサッカー部。\n中高とも、なんとか県大会に進めるぐらいのチームの、なんてことはないエース。\n大会の一週間前だけ土日に練習するぐらいのお遊びチームで、よく合コンとかしてた。\nサッカー部の卒業記念に部のみんなで耳に穴を開け、以来ピアスをしている。\n本人曰く「遅い高校デビュー」。\n\n服は現代私服でお任せ。\nというか指定していないところは全部お任せです！\n\n❖\nめちゃくちゃ自分設定詰込みキャラを投げるの緊張しますが、\n見たい気持ちの方が勝ったのでシューーーーットします！\nご都合や何か思いつくものがありましたら、検討してもらえると嬉しいです。\n\nそれでは、今年も良い年でありますように！", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@yubinuki_200/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2402224, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/ea7b8854/uploads/origins/5fc840c0-c0ec-43da-90e2-fe39e27fcb0f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=220ab6b921405114bb4901c45d361637", "srcset": "https://si.imgix.net/ea7b8854/uploads/origins/5fc840c0-c0ec-43da-90e2-fe39e27fcb0f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=220ab6b921405114bb4901c45d361637, https://si.imgix.net/ea7b8854/uploads/origins/5fc840c0-c0ec-43da-90e2-fe39e27fcb0f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=01aa221f4857e87bf1892b5f05ef55d6 2x, https://si.imgix.net/ea7b8854/uploads/origins/5fc840c0-c0ec-43da-90e2-fe39e27fcb0f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=1fa994d4143dd40cd579f75ebdba9569 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/ea7b8854/uploads/origins/5fc840c0-c0ec-43da-90e2-fe39e27fcb0f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2e5b5090c2e45265847a397cb81f61a0", "srcset": "https://si.imgix.net/ea7b8854/uploads/origins/5fc840c0-c0ec-43da-90e2-fe39e27fcb0f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2e5b5090c2e45265847a397cb81f61a0, https://si.imgix.net/ea7b8854/uploads/origins/5fc840c0-c0ec-43da-90e2-fe39e27fcb0f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=f80024e0086eeab59c4ec7db5a245b52 2x, https://si.imgix.net/ea7b8854/uploads/origins/5fc840c0-c0ec-43da-90e2-fe39e27fcb0f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=b8665f38106da1fac83107cd830222fb 3x"}, "body": "こんにちは。\n今回、オリジナルキャラクターのデザインをお願いしたいと思い、リクエストさせて頂きました。\n（本文を見られるのを恥ずかしく感じてしまうため非表示でリクエストさせて頂いております、ご容赦ください。）\n\n剣あり魔法ありの中世風ファンタジー世界のキャラクターです。\n・外見年齢20代前半の女性\n・ゆるやかなウェーブの銀髪、ピンクの瞳、色白の美人。\n・身長は165～170cmくらいで、スタイルがよい。美胸。\n・魔法的な能力で顔や姿を変えることができる。\n・田舎の村出身で、都会に出て諜報/暗殺関連の活躍をした後、郷里に戻ってきた人\n・武装は何の変哲も無い地味なロングソード\n・おしゃれと流行り物が大好き\n・酸いも甘いも見てきて、「絶望になんか負けてやらないから」と挑戦的に艶笑するタイプの女\n\n上記から連想される範囲で、他は自由に描いて頂けたら嬉しいです。\nご検討よろしくお願い致します。", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}], "sent_works": [{"path": "/@gyuunyu_0141/works/11", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1941436, "client_id": 2402224, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/ec059f68/uploads/origins/72b2c75c-185e-4d1c-96e4-fab7a63a33f0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0375467fd2ba93596aebba5d65146424", "srcset": "https://si.imgix.net/ec059f68/uploads/origins/72b2c75c-185e-4d1c-96e4-fab7a63a33f0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0375467fd2ba93596aebba5d65146424, https://si.imgix.net/ec059f68/uploads/origins/72b2c75c-185e-4d1c-96e4-fab7a63a33f0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=3f9c3a65e6e1471596e052db1788ecff 2x, https://si.imgix.net/ec059f68/uploads/origins/72b2c75c-185e-4d1c-96e4-fab7a63a33f0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=36bcf7c7bdd744e2be8fba234081c943 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/ec059f68/uploads/origins/72b2c75c-185e-4d1c-96e4-fab7a63a33f0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=1524f9c0b2e3f543ab31054b36ea319a", "srcset": "https://si.imgix.net/ec059f68/uploads/origins/72b2c75c-185e-4d1c-96e4-fab7a63a33f0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=1524f9c0b2e3f543ab31054b36ea319a, https://si.imgix.net/ec059f68/uploads/origins/72b2c75c-185e-4d1c-96e4-fab7a63a33f0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=8a15f9bf961b99c68ed0c2c04e508609 2x, https://si.imgix.net/ec059f68/uploads/origins/72b2c75c-185e-4d1c-96e4-fab7a63a33f0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=034920c8764144fd03b5e03af58ca67c 3x"}, "body": "はじめまして。\nいつもすばらしいイラストを拝見しております。\n\n今回はTRPGで使用しているキャラクターのイラストをお願いしたくリクエストさせていただきました。\n\n希望は新規衣装の姿です。\nその他の内容はお任せしますので、\nどうぞ気の向くままに描いていただければ幸いです。\n\n使用目的は観賞用です。他、SNSで自慢します。\n\n以下、シナリオに関するネタバレはありません。\n\nキャラクター\n・34歳日本人男性\n・癖毛のロン毛\n・元ムエタイ選手で怪我を機に引退\n・表向きは自動車修理工として働いている前科者で、裏稼業にどっぷり手を染めている\n・根は真面目で、行動指針として金を基準にものを決める\n・低い学歴を補完するため読書を趣味としている\n・ぶっきらぼうで友だちが少ない\n\n外見の詳細は以下のURLをご参照ください\n\nhttps://twitter.com/yubinuki_00/status/1618137440728010753?s=46&t=2bv5G-yd_7zAXMH-8ujLuQ", "nc": 1, "word_count": 0, "transcoder": "image", "creator_accepta