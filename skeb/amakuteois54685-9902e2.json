n\n◆キャラクター◆\nDOA　霞\n\n◆シチュエーション◆\n雑魚敵姦。\n罠にはめられ、雑魚敵になぶられる霞。\n全身を拘束されて抵抗を許されないまま嬲られます。\n\n画面の右側にはキャラクターの立ち絵やエッチな雰囲気の演出があります。\n画面の左側には単身で敵地に乗り込んでいるような背景。\n文章ボックスには感度上昇やバッドステータスなどの表現があり、言葉では抵抗を示すも、彼女が感じさせられていることは筒抜けになってしまいます。\n感度上昇のステータス表記、乳首の開発レベルが1上がった。絶頂回数＋1回。などの文章が好ましいです。\n\nエロゲーがとても大好きです。\nエロゲーはオリジナルのキャラクターで展開されていることが多いです。\nもし好きなキャラクターでゲーム画面に描いてもらうことができたら、私は非常に嬉しいです。\n\nもし失礼な依頼でしたら申し訳ございません。\nセリフやステータス変更の文章差分などが可能であればとても嬉しいです。\n\n難しい依頼かもしれません。もし受けてくだされば恐縮です。", "nc": 169, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 3755, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "華夜ありす/Skeb受付中", "screen_name": "tryline_kaya", "avatar_url": "https://pbs.twimg.com/profile_images/827474743796211712/ltyi1o6Q.jpg", "header_url": "https://pbs.twimg.com/profile_banners/827470698226470913/1487167698/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 120, "skills": [{"genre": "art"}, {"genre": "correction"}], "banned": false, "nc": 49}, {"id": 57428, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "緋蓮れみぃ", "screen_name": "RemmyEcarlate", "avatar_url": "https://pbs.twimg.com/profile_images/1907182312925904896/QNlo_Np2.jpg", "header_url": "https://pbs.twimg.com/profile_banners/2988680537/1648774704/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 120, "skills": [{"genre": "art"}], "banned": false, "nc": 161}, {"id": 147972, "creator": true, "nsfw_acceptable": true, "acceptable": false, "name": "チサト", "screen_name": "tesimene", "avatar_url": "https://pbs.twimg.com/profile_images/1554062911550541824/u1Q