alent-inuyama/\n\n■希望納品形式\nキャラクターと背景がレイヤー分けされているpsdデータで頂戴出来ますと嬉しいです。\n\n■用途\nYouTubeのサムネイルへの使用、Twitterで活動の際に使用させて頂きたいです。\n使用の際は、先生のTwitterアカウントをYouTubeの概要欄、もしくはTwitterのツイート文にクレジットさせて頂きます。\n\n■構図や要望など\nYouTubeのサムネイルに使用する為、お顔が良く見える構図だと嬉しいです。\n頭の先や髪の毛などは、先端まで切れないように作画頂けますと大変嬉しいです。\n\n何卒、よろしくお願いします！", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@sususajioka/works/4", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/380c97a8/uploads/origins/86c3ed14-5a01-47c7-85d9-553b7b2b14b0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=62e1bf6e0ab6695b201303b32ffc17f6", "srcset": "https://si.imgix.net/380c97a8/uploads/origins/86c3ed14-5a01-47c7-85d9-553b7b2b14b0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=62e1bf6e0ab6695b201303b32ffc17f6, https://si.imgix.net/380c97a8/uploads/origins/86c3ed14-5a01-47c7-85d9-553b7b2b14b0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=5c1aab4270c9a0d1eb852fda7efb82f3 2x, https://si.imgix.net/380c97a8/uploads/origins/86c3ed14-5a01-47c7-85d9-553b7b2b14b0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=3949c8fa046eabb529f48de0c8509ca3 3x"}, "private": true, "genre": "art", "tipped": false, "creator_id": 3774901, "nc": 129}, {"path": "/@sususajioka/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3774901, "client_id": 3305063, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/8168fb6e/uploads/origins/b4f98414-f649-4b8f-ab1e