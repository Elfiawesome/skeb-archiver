cf/uploads/origins/06378adc-4936-4032-a255-67fe7a516fce?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=99cf6911680a29c2244b8d56a3daa45a", "srcset": "https://si.imgix.net/209291cf/uploads/origins/06378adc-4936-4032-a255-67fe7a516fce?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=99cf6911680a29c2244b8d56a3daa45a, https://si.imgix.net/209291cf/uploads/origins/06378adc-4936-4032-a255-67fe7a516fce?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=2632387730a256b35022788cb1c3186d 2x, https://si.imgix.net/209291cf/uploads/origins/06378adc-4936-4032-a255-67fe7a516fce?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c38e01414e4b833c0d0b2b015af1bd47 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/209291cf/uploads/origins/06378adc-4936-4032-a255-67fe7a516fce?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=317d484ff70987f2fd2204aa509a21f2", "srcset": "https://si.imgix.net/209291cf/uploads/origins/06378adc-4936-4032-a255-67fe7a516fce?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=317d484ff70987f2fd2204aa509a21f2, https://si.imgix.net/209291cf/uploads/origins/06378adc-4936-4032-a255-67fe7a516fce?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=f60da9836a45d1d4f40d783322d796dc 2x, https://si.imgix.net/209291cf/uploads/origins/06378adc-4936-4032-a255-67fe7a516fce?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=48c43a93665c8e15ef8bbaecfdcda8c2 3x"}, "body": "造花束様\n初めまして、この度Xにて大変素敵なイラストをお見かけし、この度skebリクエストさせて頂きました。\n(https://x.com/zoukataba/status/1972613877226754160?s=46&t=Bwvx1cs3oN6qkGqx-P6V5g\nこちらのイラストが大変タイプで、心臓に刺さってしまいました。雰囲気も何もかもが本当に素敵です！)\n\n私のTRPGのOCのリクエストをお願いします。\n可能であれば、新しく衣装を変更したイラストをお願いできますと幸いです。\n\n容姿：https://drive.google.com/drive/folders/1BIuYkCIYVhi80rr5qqfpiH0hlsM86Abm\nジト目気味の赤目、多少のクマ。\n白髪ショートカット、片目隠れ。\n歯はギザギザになっています。\n\n無性別だが、男性寄りの容姿。\nご参考までにですが、「アイホート」という神話生物(クリーチャー)の擬人化のため、表情差分に人外の要素が入っています。\n蜘蛛の缶バッジも「アイホート」という神話生物の要素になります。\n(もしアイホートを検索される場合、少々グロテスクかつ集合体の要素がございますので、お気をつけください)\n\n▶可能であれば、皇子系ロリータのような系統のお洋服を着せて頂けますと大変嬉しいです。\nイメージとしては、https://grimoire-jp.com/collections/ouji?page=1 などの中の、中性風なお衣装です。\nあくまでイメージですので、こちらの系統であれば大変嬉しいです。\n\n\n外見年齢：15歳くらい\n身長：153cm\n性格：キョドりがち、目が泳ぎがち。\nかと思えばえへえへ笑っている。\n趣味は毒物研究と、自作の下手なぬいぐるみを配り歩くこと。\n勝手にぬいぐるみを渡して来るくせに、雑に扱われると「なんでですかぁ！」とぷんすこ怒っている。\n\n\n▼お願い出来ると嬉しいこと\n・造花束さんのダークメルヘンな世界観に大変惹かれたため、造花束さんの作られる世界観にこのキャラクターを入らせて頂けると大変嬉しいです。\n\n・立ち絵や差分は元気めな顔をしていますが、もう少しローテンション気味で構いません。\n大体の容姿の要素がそのままであれば、イメージ等崩してくださって構いません。\n\n\n長々と大変失礼致しました。\n画像サイズや構図、またデザインの簡略化や変更等は造花束様の描きやすい形で、お好きにして頂ければと思います。\n\n内容や金額等に不備がございましたら、お気軽に再送申請等頂けますと幸いです。\nご検討頂けますと幸いです、よろしくお願い致します。", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Zoukataba/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3530530, "client_id": 3635560, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/47ad1207/uploads/origins/aac4b9f4-2950-4e26-9036-0c9e2dabf309?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2c0a073b0a91fbcf362d25e7664d2f0f", "srcset": "https://si.imgix.net/47ad1207/uploads/origins/aac4b9f4-2950-4e26-9036-0c9e2dabf309?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2c0a073b0a91fbcf362d25e7664d2f0f, https://si.imgix.net/47ad1207/uploads/origins/aac4b9f4-2950-4e26-9036-0c9e2dabf309?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=1a745929bc11e6fee206d3aa5b7a39ce 2x, https://si.imgix.net/47ad1207/uploads/origins/aac4b9f4-2950-4e26-9036-0c9e2dabf309?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d858df607df3665211eeb91eaa9eed3f 3x"}, "duration": null, "nsfw": false, "hardcore": fal