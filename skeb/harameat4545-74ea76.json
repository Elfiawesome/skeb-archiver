p&w=200&h=200&blur=200&s=e682643c9409b9642a30badba7fa472d 2x, https://si.imgix.net/98623849/uploads/origins/a9412c18-ea2b-4e42-bfb2-f18f76ad7456?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=01b982a2015a892bdad61bbd57531845 3x"}, "body": "はらみーとさんお世話になっております。先日おくさんの沖田恭子のお題を描いていただきありがとうございました。今回依頼という形でまたおくさんの沖田恭子をお願いしたいと思います。\n前回のお題箱の寝取られの導入、1コマ目の近況報告と2コマ目の落ちが素晴らしかったのでまた同じ様な導入でおっさんによる寝取られをお願いします。\n内容\n1コマ目、キャミソールとパンツ姿の恭子が背後からおっさんに爆乳を揉まれながら長期出張中の旦那に気遣いの言葉。最近エッチなビデオにスカウトされそうになったがまたおっさんに助けられた事と出張から帰るまで旦那の代わりに守ると言われたと近況報告。でもやはり少し寂しいと心境報告。\n2コマ目、ベッドの上で大の字に拘束されてマンコにバイブを挿入られ周りに脱ぎ捨てられた下着と玩具、まだ封を開けてない避妊具があり撮影をされながら旦那の助けを呼びながらのあえぎ声をお願いします。", "nc": 49, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@harameat4545/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "comic", "tipped": false, "creator_id": 2606274, "client_id": 432237, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/b2d2c7b1/uploads/origins/949755ed-fc52-4952-a51a-c302b852b942?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3f291002e878a4c15d50cae5d820ecf4", "srcset": "https://si.imgix.net/b2d2c7b1/uploads/origins/949755ed-fc52-4952-a51a-c302b852b942?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3f291002e878a4c15d50cae5d820ecf4, https://si.imgix.net/b2d2c7b1/uploads/origins/949755ed-fc52-4952-a51a-c302b852b942?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=afe6cc51204e7a88e1e4b3b562750a28 2x, https://si.imgix.net/b2d2c7b1/uploads/origins/949755ed-fc52-4952-a51a-c302b852b942?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a32562cf08ae5db28fa1a7891558b1be 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/b2d2c7b1/uploads/origins/949755ed-fc52-4952-a51a-c302b852b942?bg=%23fff&auto=format%2Ccompress&fm=webp&f