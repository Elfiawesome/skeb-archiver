8fb-8361-2e27319dfe5c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3237c127320dd22aa3fb9c737e650892, https://si.imgix.net/8fc4422b/uploads/origins/cff058b2-7912-48fb-8361-2e27319dfe5c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=e607f826e02d329f96d3c773b707bdc3 2x, https://si.imgix.net/8fc4422b/uploads/origins/cff058b2-7912-48fb-8361-2e27319dfe5c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=b7b24633f8fba9f1c67593d7513d1574 3x"}, "body": "初めまして！\n先生のイラストが気になり、リクエスト連絡させていただきました。\n\n友人と遊ぶゲームのキャラクター絵をお願いしたいです。\n普段は優男を演じてる、中身はクズキャラの予定です。\nビジュアルとしてはURL先となります。\n\nhttps://drive.google.com/file/d/1r0Rj0tqhv76xMEPViaPuTCT6YMf4GkaC/view?usp=drivesdk\n\n服装は中華系の服装が希望です。\n\nまた可能であれば、表情差分(優男とクズ顔の時)をお願いしたいです。\n\n注文が多く大変恐縮ですが、ご検討よろしくお願いします。\n\nhttps://drive.google.com/file/d/111aNtOne9DC0HGT1xFu0kTcFTZY9LhjD/view?usp=drivesdk", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@ochamamemame/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3114788, "client_id": 2684242, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/08257226/uploads/origins/465b5edd-dd0b-47a2-93a2-2c84f7d00b71?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=efa4e8cc1ae98d645673a6e0fd0243e6", "srcset": "https://si.imgix.net/08257226/uploads/origins/465b5edd-dd0b-47a2-93a2-2c84f7d00b71?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=efa4e8cc1ae98d645673a6e0fd0243e6, https://si.imgix.net/08257226/uploads/origins/465b5edd-dd0b-47a2-93a2-2c84f7d00b71?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ebd47abe4a7daf6da84aaafef2fdee59 2x, https://si.imgix.net/08257226/uploads/origins/465b5edd-dd0b-47a2-93a2-2c84f7d00b71?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=4cba069493f56ffd4a6ba7505d43a194 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/08257226/uploads/origins/465b5edd-dd0b-47a2-93a2-2c84f7d00b71?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=78882e512679b4e50946463bf2b5da86", "srcset": "https://si.imgix.net/08257226/uploads/origins/465b5edd-dd0b-47a2-93a2-2c84f7d00b71?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=78882e512679b4e50946463bf2b5da86, https://si.imgix.net/08257226/uploads/origins/465b5edd-dd0b-47a2-93a2-2c84f7d00b71?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=6d3d7f5e546b3f964ebd71fed96a8fd4 2x, https://si.imgix.net/08257226/uploads/origins/465b5edd-dd0b-47a2-93a2-2c84f7d00b71?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=221ff254db64be98c492bae4d451a430 3x"}, "body": "ちゃめちゃんこんにちは🌷🤍\n再度イラスト依頼をしたく、Skeb送信失礼します💌\n\n▍希望描写…特に無し。バストアップ/膝上/等身など問いません。\n▍希望等身…無し。等身でもデフォルメでもなんでも。\n▍差分有無…気にしないです！\n▍キャンバスサイズ…指定無し。描きやすいサイズでお願いします！\n▍納品ファイル…差分の有無に関わらず、透過verも送付希望です。\n▍その他…SNSアイコンやヘッダーや、SNSへの投稿に使用する場合があります。\n\nちゃめちゃんの描く三つ編みが大好きなので、もし余裕があれば承認して描いてくれると嬉しいです…♡\n\n\n▼以下、描いて欲しいキャラ（探索者）詳細▼\n（シナリオはまだ未通過ですが、秘匿HOネタバレは避けています）\n\n🗨名前…薛 雷恩（シュエ　レイエン）\n📕シナリオ…煉獄街の夜（HO3 饕餮）\n└ 中華街の料理人のHOです🔪\n👤身長…SIZ 15/ 182cm\n🌟年齢…28歳\n💟その他詳細↓\n中華料理店「青蘭」(せいらん)を営んでいる。\n人を喜ばせる料理を作りたいのではなく、自分が作りたくて料理人をしている。そのため、あまり客からの評価にこだわっていない。\n「美味かった？そりゃあ良かった」\n「口に合わない？そりゃ残念、運が悪かったな」\n愛用の肉切り包丁を大事にしている。ムカつく人がいれば時には投げる。治安の悪さには慣れっこ。\n「ちぇっ、外したか。てか瞬時に避けるなんて凄いなぁ？反射神経どうなってんだ？」\n料理の評価にこだわらないところから察せるように、人の顔色を気にすることはあまりない。\n\nhttps://drive.google.com/drive/folders/13Hc6gz8VzUbFybBy2_wUiQUTAOCjhdUd?usp=share_link", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@ochamamemame/works/3", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/383f9767/uploads/origins/6702181d-c3ec-4544-87b