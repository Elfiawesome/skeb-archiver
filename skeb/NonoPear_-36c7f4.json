auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ccfbd9b127642b2cbb56633d5f742baf, https://si.imgix.net/8b43dc02/uploads/origins/ec366392-9254-4002-8feb-9b50762fc766?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=caf752e08945cdd53b85703c4a788701 2x, https://si.imgix.net/8b43dc02/uploads/origins/ec366392-9254-4002-8feb-9b50762fc766?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=c39f12c3f3174652e8aac43838bdb878 3x"}, "body": "梨の様、初めまして。\n銀治（誠刀）と申します。\n\n素敵なDQ１０のキャラクターを描かれており、さらに透明感のあるキャラシを拝見し、是非ともリクエストしたくメッセージを送りました。\n\n自機の「ミオ」の立ち絵をお願いします。\n隠者（ウェディの姿、審判の天使服とロードリーコサージ、アクセルギアが特徴）の方単体でお願いします。\n\n構図としては、隠者特有の精霊（緑色の光）を手元に浮かべ、表情はクールだが憂いを帯びた感じでお願いします。\n\n背景と武器や盾は描かなくて構いません。\n\n資料はURLに載せておりますが、万が一貼れていなかったり等ございましたらスルーして構いません。\n\n長文、駄文失礼しました。\n\nhttps://drive.google.com/drive/u/0/folders/1-lam6h591WAnN8SUaYAVAGd24nzRFyxQ\n\nhttps://drive.google.com/drive/u/0/folders/1-lam6h591WAnN8SUaYAVAGd24nzRFyxQ", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@NonoPear_/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3535216, "client_id": 3557608, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/891fa6d0/uploads/origins/9c85e288-74d1-4bc9-b9c5-6237d1682ad3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b7189d0b5e0e3f33375b31b1392adaca", "srcset": "https://si.imgix.net/891fa6d0/uploads/origins/9c85e288-74d1-4bc9-b9c5-6237d1682ad3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b7189d0b5e0e3f33375b31b1392adaca, https://si.imgix.net/891fa6d0/uploads/origins/9c85e288-74d1-4bc9-b9c5-6237d1682ad3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ade44102c1f59d15e91a09144d6887e0 2x, https://si.imgix.net/891fa6d0/uploads/origins/9c85e288-74d1-4bc9-b9c5-6237d1682ad3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=61c7c35d076a147b1f2fe69209255c3a 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/891fa6d0/uploads/origins/9c85e288-74d1-4bc9-b9c5-6237d1682ad3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2ce938367e2f0c80491e08ef1c5f9d47", "srcset": "https://si.imgix.net/891fa6d0/uploads/origins/9c85e288-74d1-4bc9-b9c5-6237d1682ad3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2ce938367e2f0c80491e08ef1c5f9d47, https://si.imgix.net/891fa6d0/uploads/origins/9c85e288-74d1-4bc9-b9c5-6237d1682ad3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=56193c9e34e821d17e4c4d7f37aad076 2x, https://si.imgix.net/891fa6d0/uploads/origins/9c85e288-74d1-4bc9-b9c5-6237d1682ad3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=933fe439cc483a0d120bad2830e4ff98 3x"}, "body": "初めまして。\nXのTLにてイラストを拝見し、描いていただきたいイラストと絵柄がマッチしたのでご依頼させていただきます。\n\nDQ10の自キャラなんですが、シチュエーションは「10年後の成長したエルフ」です。\n以下、細かいポージングについて箇条書きしていきます。\n※依頼文の最後にデッサンアプリにてポージングのスクショを添付致しますが、一応文字起こしします\n\n・視点はほぼ正面で\n\n・表情は優しく微笑む\n(口元は少し開いて微笑む感じで)\n\n・目線はこちら向き\n(ニッコリとした目で。半開きのような)\n\n・頭は少し小首をかしげた様子\n\n・髪は添付資料より少し伸びた様子\n(だいたい肩甲骨辺りまで)\n\n・右手はこちらに差し伸べている\n(手のひらはガッと開くというより、優しく開いている感じで)\n\n・左手は胸元に\n(抑えているというより、添えている感じで)\n\n・左足を曲げて、右足は少し曲げた様子\n(浮遊しているような感じで)\n\n・服装は下記に添付した資料通りでお願いします\n\n・年齢の設定は本来11歳ですが、21歳くらいに成長した姿で\n(顔つきや体つきも年相応に成長した様子でお願いします)\n\n・背景の指定は特にありませんが、できたら神々しい感じで\n\n説明が下手で申し訳ありませんが、以上のシチュエーションでよろしくお願いします。\n\nキャラの髪型や服装等の詳細及びデッサンアプリによるざっくりとしたポージングのイメージ図(画角含む)は以下のURLに添付しています。\nご査収ください。\nアプリの仕様上、体勢に無理があったり依頼文と齟齬があると思いますが、依頼文のシチュエーションの方を優先でお願いします。\n\nイラスト資料\nキャラのスクリーンショット\nhttps://ibb.co/VYMmmRp8\nhttps://ibb.co/M55CGDLf\nhttps://ibb.co/Kz5K9Qns\nhttps://ibb.co/NnmJ2XhG\n\nデッサンアプリでのポージング資料\nhttps://ibb.co/wZVVhdkS\n\n描いていただきたいのは正面からのイラストですが、資料として左右からのスクショも添付します\nhttps://ibb.co/zW71cN9g\nhttps://ibb.co/rKjSwtw4", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@NonoPear_/works/2", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/85aff321/uploads/origins/1da8b9c4-c595-4d46-8337-005cbbcf2a34?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=87e655b92c80ab23a98207737350db42", "srcset": "https://si.imgix.net/85aff321/uploads/origins/1da8b9c4-c595-4d46-8337-005cbbcf2a34?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=87e655b92c80ab23a98207737350db42, https://si.imgix.net/85aff321/uploads/origins/1da8b9c4-c595-4d46-8337-005cbbcf2a34?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=2ad24020fc2d15d24c5024094361682a 2x, https://si.imgix.net/85aff321/uploads/origins/1da8b9c4-c595-4d46-8337-005cbbcf2a34?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=b04b870f46d56d2dd6fc3a1cecbd1251 3x"}, "private": true, "genre": "art", "tipped": true, "creator_id": 3535216, "client_id": 2829716, "nc": 0}, {"path": "/@NonoPear_/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3535216, "client_id": 2206121, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/1c1a6f52/uploads/origins/df94f484-df29-4e13-968b-b41f25c89465?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=946f99b9c553446481802e69bdf5d8e8", "srcset": "https://si.imgix.net/1c1a6f52/uploads/origins/df94f484-df29-4e13-968b-b41f25c89465?bg=%23fff&auto=format%2