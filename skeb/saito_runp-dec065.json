分かれている透過PNGにてお願いします。\n\nご検討のほど、よろしくお願いいたします。\n\nhttps://lit.link/momoshiro1108", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@saito_runp/works/13", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/b6e7a6e6/uploads/origins/b379a0ff-60a1-4edd-8b28-27a0876eb1ac?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=1b340ec35da30428e9b8d604a86e1871", "srcset": "https://si.imgix.net/b6e7a6e6/uploads/origins/b379a0ff-60a1-4edd-8b28-27a0876eb1ac?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=1b340ec35da30428e9b8d604a86e1871, https://si.imgix.net/b6e7a6e6/uploads/origins/b379a0ff-60a1-4edd-8b28-27a0876eb1ac?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=84fc8a9753fa3c10842c480bb96f4189 2x, https://si.imgix.net/b6e7a6e6/uploads/origins/b379a0ff-60a1-4edd-8b28-27a0876eb1ac?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=be83ed6061223769a1f0c8b8c1a75923 3x"}, "private": true, "genre": "comic", "tipped": false, "creator_id": 3868472, "nc": 48}, {"path": "/@saito_runp/works/12", "private_thumbnail_image_urls": null, "private": false, "genre": "comic", "tipped": false, "creator_id": 3868472, "client_id": 2313253, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/21ea29bb/uploads/origins/f9b29191-e121-473c-ad80-e867b7840bfe?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ddffd4e9dbce5387c7f149247874864d", "srcset": "https://si.imgix.net/21ea29bb/uploads/origins/f9b29191-e121-473c-ad80-e867b7840bf