o=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=bb57d751ce0b2b6d84ca8dc7f091078d 3x"}, "body": "はじめまして。\n個人vtuberとして活動をしております。hikichanと申します。\nMaria Rose様にうちの子のイラストを描いていただきたくリクエストさせていただきました。\n\nASMRやシチュエーションボイス動画などに利用したいので、魅力的でちょっとダークな雰囲気をお願いしたいと思います。構図などはお任せにしたいと思います。\n\n性格的・雰囲気的に、この子はちょっと無口でストーカーみたいな要素もあります。エルフなので、人間観察と研究が趣味です。ダウナー系・地雷系女子みたいな要素がありましたら幸いです。\n\n全身資料などはこちらです。必要でしたら、部屋の資料もあります。\nhttps://drive.google.com/drive/folders/1bB3zO0N5e5HNwRqFmdjsRH_kPCUfHfGF?usp=sharing\n\n可能でしたら、キャラクターと背景をレイヤー分けのPSDもお願いしたいと思います。可能でしたら幸いです。\n\n使用用途は、YouTubeのサムネやSNSへの投稿です。\n\n金額不足でしたらご遠慮なく再送要請いただいたら幸いです。\n\nご検討をよろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/1bB3zO0N5e5HNwRqFmdjsRH_kPCUfHfGF?usp=sharing\n\nhttps://drive.google.com/drive/folders/1bB3zO0N5e5HNwRqFmdjsRH_kPCUfHfGF?usp=sharing", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@mravwx/works/8", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1231084, "client_id": 2137559, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/3ddc0d8e/uploads/origins/1cbf02cf-0291-453d-84b6-d2181258d5f6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=aed70f5a83eb89349fd4bec8638eb5b3", "srcset": "https://si.imgix.net/3ddc0d8e/uploads/origins/1cbf02cf-0291-453d-84b6-d2181258d5f6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=aed70f5a83eb89349fd4bec8638eb5b3, https://si.imgix.net/3ddc0d8e/uploads/origins/1cbf02cf-0291-453d-84b6-d2181258d5f6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=6a6310ac9e9b4ca37f3fd4758f3a096b 2x, https://si.imgix.net/3ddc0d8e/uploads/origins/1cbf02cf-0291-453d-84b6-d2181258d5f6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=64fd34a323e03427cd15d10aacdc018f 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_url