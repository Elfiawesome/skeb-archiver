-4235-8504-883432ca003f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=79028d6c250f1378f32e6092f95c937b", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/66f2b498/uploads/origins/8143fd36-cee0-4235-8504-883432ca003f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=014f66dd253e7693d8626900887ff51f", "src_set": ""}, "body": "こんばんは。\n大変急ですが、次のような絵をリクエストします。\n「ラ・ピュセル(魔法少女育成計画)の衣装を着た女体化FEセリス」\nラ・ピュセルについては参考資料リンクを見てください。\n角・尻尾は生やしたままでお願いします。\n胸の大きさは普通大きめ〜巨乳が理想的ですが、そこはあずささんが似合うと思っている大きさでOKです。\nそれ以外の要素(背景やポーズなど)はお任せします。\nよろしければご検討のほうお願いします。\n\nhttp://mahoiku.jp/chara/lapucelle.html", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@azchemist63/works/50", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1069019, "client_id": 1610749, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/a33918a3/uploads/origins/8537c299-3d00-4fd9-ba96-946d077a1bcb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6b534d20b6ddb2a8009298f587520d1a", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/a33918a3/uploads/origins/8537c299-3d00-4fd9-ba96-946d077a1bcb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e2c18ba256da03e98c62dd0927a3657b", "src_set": ""}, "body": "あずささんこんにちは。\n\nスーパークリークをお願いします。\n構図ですが、ひざ枕をしてもらっている状態で、\nスーパークリークを見上げている形にしてください。\n\nママ感全開で、いいこいいこーって撫でてくれてる感じで手をかざしてください。\n\n服装等はお任せします。\n\nよろしくお願いいたします！", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@azchemist63/works/49", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/5279100a/uploads/origins/73b957fa-886f-47ec-bcbd-f558b6de06e3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=2028483afd91ef5cbea43202a7e5a243", "src_set": ""}, "private": true, "genre": "art", "tipped": true, "creator_id": 1069019, "client_id": 0, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 1, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@azchemist63/works/48", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1069019, "client_id": 1158300, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/303fa91c/uploads/origins/6c8f563c-d9ab-4e35-9da9-69606bcc1c7a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e020bc623dd0ba71a981047d1dccd8bb", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/303fa91c/uploads/origins/6c8f563c-d9ab-4e35-9da9-69606bcc1c7a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=75c51f6b5a8090e8056d9869d3863acd", "src_set": ""}, "body": "初めまして！\n先生の描く可愛らしいキャラやイラストが好きで、このたび依頼させて頂きました！\n\n\n＜依頼内容＞\n依頼するイラストはVsingerである凪乃ましろさんのクリスマスイラストです。\n\n\n<使用用途>\nVsingerとしての活動で動画やサムネイル、SNS等で使用される可能性があります。\n個人的にPC壁紙や個人鑑賞グッツの作成として使用する場合もあります。\n\n\n＜構図＞\n・凪乃ましろさんのクリスマスイラスト\n・服装はクリスマスらしい服装で構図等はお任せします。\n\n※ましろさんの特徴\n(食べることと歌うことが好きで、品はありつつ表情豊かな性格です。海辺の町に住んでいます。)\n\n\n＜こうしてほしい点・お願い＞\n・サムネイルに使用することがあるため、頭部が切れていないキャラクターのみの透過データ(もしくはPSD)をいただけますと幸いです。\n\n・お手数だと思うのでこちらは可能であればお願いしたいのですが、ましろさんには通常の白髪青目Verと、黒髪赤目Verがあります。今回通常の白髪青目Verを依頼させて頂くのですが、可能であればで大丈夫なので黒髪赤目Verの差分もいただけると大変嬉しいです。\n\n\n＜その他＞\nhttps://lit.link/naginomashiro\nガイドラインにてファンによるskebへの依頼が許可されています。\n\nお忙しいと思いますが、何卒よろしくお願い致します。\n\n\n\n＜参考資料・補足＞\n・左目下の泣きほくろ\n・髪は寒色の銀髪というより、あたたかみのある白髪寄りです。\n・ハイライトがオーロラになっており、前髪の毛先のみ、ほんのり桃色です。\n\n通常衣装　三面図\nhttps:/