103e15a/uploads/origins/d8fc7de3-5e5e-4b5b-9dc6-e99c0a87fbd5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=1ac380d914ea98fbcc0d0bc6dd344bac", "src_set": ""}, "body": "いつも素敵なイラストをありがとうございます。\n今回はファイアーエムブレムエンゲージのセリーヌ王女を忍者衣装で依頼させてください。\nhttps://guide.fire-emblem-heroes.com/14002005001163-2/\n\n椅子やベンチなど何処かに座り、ニーソックスを直したりひと休みしていたりなど笑顔で何気なく過ごしているイメージで、足をある程度開いて片方の足は立て膝をしてもう片方の足は身体を隠さない様に下ろす体勢で座らせ、スカートが捲れてパンツが見えてしまっているセリーヌ様のイラストをお願いします。\n前の方からの構図で、いつもの服装とは違うアクティブな衣装とお祭りの雰囲気で無防備になってしまいパンツが見えていることにまだ気づいていない楽しそうに過ごしてる様子と、見えていることに前にいる相手の反応で気づき(もしくは見えてしまってることを指摘され)、恥ずかしさで顔を赤くして固まってる、スカートを抑えて隠す前の様子を描いて頂きたいです。目の前の相手は神竜様や兄など、仲が良く信頼している男性のイメージで、怒ったりするわけではなくただ恥ずかしがる可愛らしい反応を描いて頂ければと思います。\n背景は屋外でも屋内でもシチュに合うものをお任せします。パンツの見え方は違和感のない範囲で可能な限り見える形を、パンツの色やデザインについては似合いそうなものをお任せします。今回は構図のイメージ画像はなしで、シチュを表現しやすい形で描いて頂ければと思います。\nその他はお任せします、よろしければお願いします。", "nc": 176, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@azchemist63/works/54", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/9f624fd0/uploads/origins/f2812055-db50-49f2-9bee-c23c4616630a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=ef5967f4cb216869f3bb397626adbc90", "src_set": ""}, "private": true, "genre": "art", "tipped": false, "creator_id": 1069019, "client_id": 0, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 33, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@azchemist63/works/53", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/da782536/uploads/origins/7b3cf0fa-b121-42ad-99e3-21504c54e4eb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=ecec2622012d