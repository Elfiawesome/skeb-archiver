く好きでして、三者三葉に可愛くキラキラと魅力的に描かれているのを見て、すごく良い絵を描かれる方だと一目惚れしました！構図やポーズも動きがあって何度見ても素敵です。\n\nもしよければ私のオリジナルキャラクターをお描きいただけないでしょうか？\n蛇を擬人化させたようなコンセプトの森の神様で、普段は人里離れた森にいるけれど現代を楽しむべく都会に溶け込むような姿でいる、年齢も性別も不詳でどこか掴み所がないというキャラクターです。\n女の子が好きなので、今は女子高生の姿になっているという設定になっています。\n\nnayuさんが考えられた構図や表情、ポーズが好きなので全ておまかせしてもよろしいでしょうか？\n髪や服はアレンジ、別衣装でも問題ございませんのでよろしくお願いいたします！\n\nhttps://drive.google.com/drive/folders/1ibwLFeil4wvCpvN-ur4HwoEnY-kDUEXP", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@nayu_tao/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 4075685, "client_id": 4071995, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/d24e6f26/uploads/origins/6619f24a-929a-4718-89c6-cd8cbb70bf38?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5b429bbc3642dbdb68fd7f88e2d13c8b", "srcset": "https://si.imgix.net/d24e6f26/uploads/origins/6619f24a-929a-4718-89c6-cd8cbb70bf38?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5b429bbc3642dbdb68fd7f88e2d13c8b, https://si.imgix.net/d24e6f26/uploads/origins/6619f24a-929a-4718-89c6-cd8cbb70bf38?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=bc909d27b66a878b4b74e72da2407ce8 2x, https://si.imgix.net/d24e6f26/uploads/origins/6619f24a-929a-4718-89c6-cd8cbb70bf38?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=39eb7c2dacbb9b30a90cb992e65c20fe 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/d24e6f26/uploads/origins/6619f24a-929a-4718-89c6-cd8cbb70bf38?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d734138736a0d060a3a5f06f9d6c0cbf", "srcset": "https://si.imgix.net/d24e6f26/uploads/origins/6619f24a-929a-4718-89c6-cd8cbb70bf38?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d734138736a0