.net/c659b4e9/uploads/origins/af70e419-19c1-429c-8563-ea571f3a72bc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=8d51a9f7a60e8520773d8a4ce0aca7d2", "src_set": ""}, "body": "こんにちは！\nいつも素敵なイラストを見させていただいております…！\n\nもしよければうちのマイハンターのエンジと圭斗さん宅のハンターさんのレヴァリスさんとの絡み絵が見てみたいです…！\nなお圭斗さんご本人からは、コミッション等に関して一切の許諾を得ています。\n\n以下指定です。\n・レヴァリスさんが攻めでエンジが受け側です。\n・レヴァリスさんもエンジもチンコは大きめで描写してください。またレヴァリスさんの方が体格もチンコもエンジより一回り大きいです。\n・シチュエーションはレヴァリスさんがエンジに覆面越しでイラマチオか、チンコを顔面に擦り付けてぶっかけてる感じの構図でお願いします。\n・資料にある通り、エンジには乳首ピアスとチンコピアスを付けてください。\n・もし構図に余裕があればエンジのチンコが見えるような構図だと嬉しいです。\n・射精前後の差分が欲しいです。\n\n以上長くなりましたがよろしくお願いします…！\n\nhttps://drive.google.com/file/d/1OQ3FogKOwZFNCAhooAaL2lhYh8KFZGko\n\nhttps://drive.google.com/file/d/1OQ3FogKOwZFNCAhooAaL2lhYh8KFZGko", "nc": 48, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@blue_mach_b/works/99", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/891d36c7/uploads/origins/31d26d43-240a-4427-bf3f-89138bf01807?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=32acbbb193d6fe6ad4fd1ef65f7d73cd", "src_set": ""}, "private": true, "genre": "art", "tipped": true, "creator_id": 1396795, "client_id": 27727, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 178, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@blue_mach_b/works/98", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/cdcd6f23/uploads/origins/f35fbb02-df43-4dbc-8922-f6c7b62d27a5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=02bcf5f439c4137eeabae44b95c802dc", "src_set": ""}, "private": true, "genre": "art", "tipped": true, "creator_id": 1396795, "client_id": 30094, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 176, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@blue_mach_b/works/97", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1396795, "client_id": 2155743, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/92d16861/uploads/origins/0fe597e9-505f-4bc7-8f06-7f1493c6115c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a8eb6af13b96c91a97c5359eb0ec4e7b", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/92d16861/uploads/origins/0fe597e9-505f-4bc7-8f06-7f1493c6115c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=294f04998b97bf6017516ab312d59b2c", "src_set": ""}, "body": "以前他の方のリクエストで描いていらしたスレイプモンがとてもよかったので、スレイプモン♂×ベルフェモンRM♂の、それぞれ受けと攻めをしているエロ絵をお願いしたいです。\n\n◯ベルフェモン攻め\n・ベルフェモンがスレイプモンの馬部分の胴体あたりを片手で掴み、スレイプモンの背に上半身をもたれかけながらぶっとい♂を挿入\n・スレイプモンのビンビンになった馬チン♂をベルフェモンがもう一方の手でしごき、ベルフェモンが大量中出しするのと同時にスレイプモンも大量射精\n・差分で、よくあるイラストの端側で中出ししている様子がわかる絵も見れると良いです。\n\n◯スレイプモン攻め\n・仰向けになったベルフェモンの両腕をスレイプモンの前足で押さえ付ける\n・馬並みの♂をベルフェモンに挿入し中でゴリゴリ攻め続ける\n・スレイプモンは空いている右腕で胸にある顔のような鎧の口部分から自身の乳首をイジり恍惚としながらも激しくベルフェモンを掘り続ける\n・その後、スレイプモンの♂が脈打つのがわかるぐらいの勢いでベルフェモンに大量中出し\n・ベルフェモンもつられて涙目になり喘ぎながらスレイプモンの馬部分の腹や自身の顔がドロドロかかるぐらい大量射精\n・こちらも、スレイプモンが中出ししてる様子を上記ベルフェモン攻めのと同様に差分で見れるといいです。\n\n背景やセリフはおまかせします。\nスレイプモンの♂のイメージですが、Biaさんが以前ピクシブにアップされていたものと同じか、気持ちもう少しだけ太く長くしてほしいですが、バランスが崩れそうであれば、同じ程度で大丈夫です。\nスレイプモンの盾や弓矢が、描く上で邪魔になるようでしたら無くても構いません。\nまた、スレイプモンの鎧などの資料についてはゲーム画面から確認できたので、以下のグーグルドライブから確認をお願いします。\nhttps://drive.google.com/drive/folders/1ez1k_J_SDxRRAjCjRINwgyoukJLo5Fvv", "nc": 168, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@blue_mach_b/works/96", "private_th