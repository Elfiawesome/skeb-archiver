ただけますと幸いです。  \n\nhttps://lit.link/shimotsukinagi \n\n以上、ご都合がよろしければどうぞよろしくお願いいたします。", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@criyokan/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 389339, "client_id": 154813, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/d5935e92/uploads/origins/cc1c1b08-e98b-4d80-ab46-a58ea9e40df1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0bb9ba4ab2f43ee8f0aa69c66215bd53", "srcset": "https://si.imgix.net/d5935e92/uploads/origins/cc1c1b08-e98b-4d80-ab46-a58ea9e40df1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0bb9ba4ab2f43ee8f0aa69c66215bd53, https://si.imgix.net/d5935e92/uploads/origins/cc1c1b08-e98b-4d80-ab46-a58ea9e40df1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=4d2c4d9189c1b1b78329d92a4f9565a0 2x, https://si.imgix.net/d5935e92/uploads/origins/cc1c1b08-e98b-4d80-ab46-a58ea9e40df1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=935999e71856048ad1d152ff0676c337 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/d5935e92/uploads/origins/cc1c1b08-e98b-4d80-ab46-a58ea9e40df1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=69edb3c36b2209c7ef80c4a44fbfaa5e", "srcset": "https://si.imgix.net/d5935e92/uploads/origins/cc1c1b08-e98b-4d80-ab46-a58ea9e40df1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=69edb3c36b2209c7ef80c4a44fbfaa5e, https://si.imgix.net/d5935e92/uploads/origins/cc1c1b08-e98b-4d80-ab46-a58ea9e40df1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=e9143be2d083ea461f86719d747c5b8d 2x, https://si.imgix.net/d5935e92/uploads/origins/cc1c1b08-e98b-4d80-ab46-a58ea9e40df1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=7e96e70709cff312ade54754d860636a 3x"}, "body": "はじめまして、Xで募集を見掛けまして、pixivを拝見したところ、可愛い絵柄が好みだったのでリクエストさせていただきます！\n\n描いて欲しいのは、桜弥（おうみ）というOCです。\nこの子に、ホイップあん様が可愛いと思うコスプレをさせてあげて欲しいなと思っています。\n出来れば全身で見たいですが、描ける範囲で描いてくれたら嬉しいです！\n資料に大量に詰め込んであるので、その中からでもいいですし、全く関係なくても大丈夫です。\n※三つ目の資料は千件以上あるので見なくても全然大丈夫です。\n構図やシチュエーションもお任せいたします。\n\n桜弥（おうみ）\n17歳、166cm、Dカップ。ボブヘアー。姉がいるが、姉が巨乳で自分が普通なのがコンプレックス。その割にオシャレのためなら胸をアピールすることも忘れない。姉がコスプレ好きで、それに付き合っていろんな服を着させられたりしている。髪が短いのは姉にアレンジさせられまくるのを回避するため。\n髪にインナーカラーが入っている（三面図参照）目の色はインナーカラーと同じで緑ではないです（AIで資料を制作しているためややこしいですが、三面図参考でお願いします）\n\nもしご縁がありましたら、よろしくお願いします。\nhttps://drive.google.com/drive/folders/1ldnQ85FiD2bewf2m3tZyI8EBekVtrdmj\nhttps://drive.google.com/drive/folders/1vEsUUbtBMMe0u8itbaKtlOKZw4UYNphw\nhttps://drive.google.com/drive/folders/1umL6bP_qJsYGhPLdkkSpP8bRMCBOUqkK", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@criyokan/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 389339, "client_id": 3731180, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/f1956be7/uploads/origins/35efe70c-243f-4005-bbb6-0d1006d8dd67?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=593213656934437678c14a9603a274d6", "srcset": "https://si.imgix.net/f1956be7/uploads/origins/35efe70c-243f-4005-bbb6-0d1006d8dd67?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=593213656934437678c14a9603a274d6, https://si.imgix.net/f1956be7/uploads/origins/35efe70c-243f-4005-bbb6-0d1006d8dd67?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=38ae9c795d4286dd953b68c4169c04a5 2x, https://si.imgix.net/f1956be7/uploads/origins/35efe70c-243f-4005-bbb6-0d1006d8dd67?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=64086d562e75f3f12d718d223f3d8357 3x"}, "duration": null, "nsfw": false, "har