ろな表情\n\n包帯に萌えるのと、それでも可愛く元気な姿に萌えるのが個人的なポイントです。\n\nhttps://www.youtube.com/watch?v=iLDkTBdxs4w", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@memechi_66/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3261271, "client_id": 3274064, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/f5fb396e/uploads/origins/1f5c3e8f-c67a-49fe-a11f-f5650969d128?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8d0f4e2dc0f593faabfaa300128a631e", "srcset": "https://si.imgix.net/f5fb396e/uploads/origins/1f5c3e8f-c67a-49fe-a11f-f5650969d128?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8d0f4e2dc0f593faabfaa300128a631e, https://si.imgix.net/f5fb396e/uploads/origins/1f5c3e8f-c67a-49fe-a11f-f5650969d128?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=33a97822b09566f68e68cad26dd97cb4 2x, https://si.imgix.net/f5fb396e/uploads/origins/1f5c3e8f-c67a-49fe-a11f-f5650969d128?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=49d1de6a3e4557f5b68a35771c0b50da 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/f5fb396e/uploads/origins/1f5c3e8f-c67a-49fe-a11f-f5650969d128?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b8efb4e5ac83efdbe939818606ed3f6c", "srcset": "https://si.imgix.net/f5fb396e/uploads/origins/1f5c3e8f-c67a-49fe-a11f-f5650969d128?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b8efb4e5ac83efdbe939818606ed3f6c, https://si.imgix.net/f5fb396e/uploads/origins/1f5c3e8f-c67a-49fe-a11f-f5650969d128?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=0448d19a6b024e4852ad68bb47816b8c 2x, https://si.imgix.net/f5fb396e/uploads/origins/1f5c3e8f-c67a-49fe-a11f-f5650969d128?bg=%23fff&