=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1ce9fb181be999eb37ac8141ed1ea508", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/3b1d99c8/uploads/origins/896b4f01-60d5-4855-8b75-ba6c40d86bbd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=17ab9ee5d96944a45697cdaee88b6562", "src_set": ""}, "body": "こんにちは、ポロさん！僕のキャラクターを描いてもらえませんか？\n\n彼は私のオリジナル・キャノンの「創造主」として、その宇宙の神として崇拝されています。\n\n彼はこれらの魂を操り、彼らの苦しみに無関心で、自分のイメージ通りに存在を形作ることだけを追求する。\n\n彼は冷淡で計算高く、生命を自分のビジョンを実現するための単なる道具として扱う。彼は存在を、自分が究極の演出家である壮大な「劇」と見なしている。彼の唯一の喜びは、生命（宝石）のコレクションがますます輝きを増していくのを見ることである。\n\n好きな服装で彼を描くことができる！\n\n構図は好きなようにすればいい。\n\nよろしくお願いします！\n\nhttps://drive.google.com/drive/folders/1PbpnmX90rgdKtRBwKqWQDk-c577scicN?usp=drive_link", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@poro06625649/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 957505, "client_id": 303754, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/242072de/uploads/origins/bbfd28e9-7c9b-42cd-8740-e5d5f212fde3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e833cfa911c3fca0a94ae84f1623921d", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/242072de/uploads/origins/bbfd28e9-7c9b-42cd-8740-e5d5f212fde3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b86696ad791ee5b1f3e5f6477b9d851a", "src_set": ""}, "body": "こんにちは！\n\n私はあなたの男性の描き方がとても好きで、私のOCの一人を描いてほしいと思っています。以下から選んでください。\n\nhttps://drive.google.com/file/d/1r1TT5iP13IIl6aqgC6KNdbj3Hy4v_YNi/view?usp=drive_link\nhttps://drive.google.com/file/d/1mG-WxE1LDX4yVS6zstn6sHuHsf5kKcje/view?usp=drive_link\nhttps://drive.google.com/file/d/1SfxXsbyhVtsdnGKjVYkTvaG3Cc7zO5jm/view?usp=drive_link