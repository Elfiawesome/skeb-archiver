je.xn--wiki-4i9hs14f.com/index.php?%E3%83%8A%E3%83%AB%E3%82%B3%E3%83%A6%E3%83%AA\n\n今度、「りっく☆じあーす」が10周年を迎えます。…ということは置いておいて、はにかみ笑顔の伊織と、ジト目無表情のナルコユリが手を繋いでこちらを見ている感じでお願いします。\n\n伊織の服装は制服で、ナルコユリは「りっく☆じあーす」の久居真津梨の制服(参考のドライブの中に参考資料あります)で、共に武器は無しでお願いします。\n\nまた、差分として２人の下着バージョンをお願いします。どんなものかは先生にお任せしますので、２人それぞれに合いそうなものをお願いします(竹松伊織はガーターベルトを着けたままでお願いします)。金額が足りなければ訂正をお願いします。また、念のためNSFW入れておきます。\n\n可能であれば、自分で差分を作ってみようと思いますので、ある程度レイヤーが別れた状態のPSD等のデータでいただけると助かります。無理そうなら無くて大丈夫です。\n\n注文が多くて申し訳ないですが、検討よろしくお願いします。\n\nhttps://drive.google.com/drive/folders/1HJ9m8aOxTmYh6Py14l_t1j6XtFbDc3xi", "nc": 33, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@aka_sak4/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3450685, "client_id": 61245, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/4be93d9b/uploads/origins/3df14487-0b05-4824-9a12-5437709e3a93?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=61e472d57d3eaf9475832938bb678c65", "srcset": "https://si.imgix.net/4be93d9b/uploads/origins/3df14487-0b05-4824-9a12-5437709e3a93?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=61e472d57d3eaf9475832938bb678c65, https://si.imgix.net/4be93d9b/uploads/origins/3df14487-0b05-4824-9a12-5437709e3a93?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c587ecee019953c593f3058b409066f8 2x, https://si.imgix.net/4be93d9b/uploads/origins/3df14487-0b05-4824-9a12-5437709e3a93?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=af4d4fcb9db2024509cd26f90f6b5021 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/4be93d9b/uploads/origins/3df14487-0b05-4824-9a12-5437709e3a93?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2809e2ade193242be25c8c03cea2f033", "srcset": "https://si.imgix.net/4be93d