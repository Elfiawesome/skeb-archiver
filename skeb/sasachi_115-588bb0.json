型]\n・立ち絵の髪型\n・ショートカットの三つ編み\n・お団子\n・おまかせ\n前髪は自由で大丈夫です\n\n[色]\nライラック色\n水色\n青色\n白色\n\n[モチーフ]\n(入れてもいれなくてもok。なんかさみしいなって時はこのモチーフを入れてくれると嬉しいです！)\n\n青よりのライラックの花\nくじら\nシャチ\nイルカ\nクラゲ\nタコ\nタツノオトシゴ\nクリオネ\nミジンコ\n🫧あわ\n\n✔ 使用用途：\nX（Twitter）での投稿や、アイコン、YouTube・Twitchのサムネイル・ASMR配信のサムネイル・配信画面などで使用させていただく予定です！\n\nよろしくお願いいたします！🙇‍♂️🫧🤍\n\nhttps://drive.google.com/drive/folders/135kPFVWF2SpnCSmRAn3t92aOwdwXPq8D?usp=sharing", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@sasachi_115/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2457122, "client_id": 3142423, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/82edf353/uploads/origins/d7f58659-698a-4125-8361-65a0a09618c5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=50dc480e0c18d7b5f3d4b3a65604d681", "srcset": "https://si.imgix.net/82edf353/uploads/origins/d7f58659-698a-4125-8361-65a0a09618c5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=50dc480e0c18d7b5f3d4b3a65604d681, https://si.imgix.net/82edf353/uploads/origins/d7f58659-698a-4125-8361-65a0a09618c5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=8f752da48deb31c910dd39515db7b5aa 2x, https://si.imgix.net/82edf353/uploads/origins/d7f58659-698a-4125-8361-65a0a09618c5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=04ddef81817df9543c7941e92861bed2 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/82edf353/uploads/origins/d7f58659-698a-4125-8361-65a0a09618c5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d395aad56c5f1baeb04f476fe8626ca3", "srcset": "https://si.imgix.net/82edf353/uploads/origins/d7f58659-698a-4125-8361-65a0a09618c5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d395aad56c5f1baeb04f476f