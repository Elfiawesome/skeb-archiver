4-47ba-a7bf-b0da63a9b3e0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b8a956ce90f0457aa02d15f7e8d12388", "srcset": "https://si.imgix.net/8d816fa6/uploads/origins/4b9115b7-8504-47ba-a7bf-b0da63a9b3e0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b8a956ce90f0457aa02d15f7e8d12388, https://si.imgix.net/8d816fa6/uploads/origins/4b9115b7-8504-47ba-a7bf-b0da63a9b3e0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=c55a08cdfe7304ca3380c1049bf2d4b9 2x, https://si.imgix.net/8d816fa6/uploads/origins/4b9115b7-8504-47ba-a7bf-b0da63a9b3e0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=ef58a0ae1d3b169e989ab48125089604 3x"}, "body": "綿雨さま、初めまして。暮宮右京と申します。　noteの記事でイラストをお見かけした際、可愛らしい絵柄とポップな塗りにとても心惹かれました。\nぜひ、一次創作小説のオリジナルキャラクター（ヒロイン）を描いていただければと思い、このたびリクエストをお送りしました。\n\n名前：ノクティア\n年齢：16歳\n属性：第二王女、闇魔法の使い手\n・銀色の髪、紫色の瞳\n・色白\n・つり目、下がり眉\n\n添付資料はざっくりとしたイメージとなります。\n衣装の色・詳細、装飾品、資料に描かれていない部分（腰から下、足元など）は綿雨さまの描きやすいように変えていただいても問題ありません。お任せいたします。\n\nもし可能でしたら、イラストをSNSのアイコン画像として使用できれば嬉しいです。\nご検討いただければ幸いです。\n\nhttps://drive.google.com/drive/folders/1ydS8HTqyf456uyYftDUmqYSHxB58Bbix", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@wata_ame033/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3876024, "client_id": 2094135, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/6670abea/uploads/origins/8e0355e4-efef-4c67-ba80-5b7f40d3f1bf?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8650b7ab3dab1ab1fced859cb03933ee", "srcset": "https://si.imgix.net/6670abea/uploads/origins/8e0355e4-efef-4c67-ba80-5b7f40d3f1bf?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8650b7ab3dab1ab1fced859cb03933ee, https://si.imgix.net/6670abea/uploads/origins/8e0355e4-efef-4c67-ba80-5b7f40d3f1bf?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=49851c913c72ca886dce4d6436f68f31 2x, https://si.imgix.net/6670abea/uploads/origins/8e0355e4-efef-4c67-ba80-5b7f40d3f1bf?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=0efe3603463de0849c8f14367dc57ce4 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/6670abea/uploads/origins/8e0355e4-efef-4c67-ba80-5b7f40d3f1bf?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=133abaa924b4bd677ab2d4f643851fef", "srcset": "https://si.imgix.net/6670abea/uploads/origins/8e0355e4-efef-4c67-ba80-5b7f40d3f1bf?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=133abaa924b4bd677ab2d4f643851fef, https://si.imgix.net/6670abea/uploads/origins/8e0355e4-efef-4c67-ba80-5b7f40d3f1bf?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=87cb8ad300a9a1660eb5844b74bb5c81 2x, https://si.imgix.net/6670abea/uploads/origins/8e0355e4-efef-4c67-ba80-5b7f40d3f1bf?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=7ea7f81e9ac350c7c243672ff14c37ce 3x"}, "body": "初めまして、シマバラと申します。\n綿雨さんのもちもちでかわいいイラストに惹かれ、リクエストを送信させていただきました。\n\n【依頼内容】\n描いていただきたいのは、クトゥルフ神話TRPGのシナリオで作成したキャラクター、べレムです。\nもしよろしければ、彼女に綿雨さんデザインでかわいいロリータ系の服を着せてあげていただきたいです。髪型もお任せいたしますが、ヘッドドレスは固定でお願いします。難しければ、添付資料内の衣装でも構いません。\n構図、表情などは全てお任せいたします。\n\n【べレムについて】\nモチーフ…猫、天使、星(ベツレヘムの星)\nとある政治家の汚れ仕事の実行役をしている10歳の少女です。\n猫のように気高く、優雅で上品、自由気ままで時々寂しがり屋。基本ムスッとした表情ですが、キラキラしたものや育ての親の前、褒められたときはニコニコしています。\n好物は魚料理です。\n\n【使用用途】\n個人での鑑賞の他、趣味の範囲でのヘッダー、アイコンとして使用させていただきたいです。\n\nご検討をよろしくお願いします。\n\nhttps://drive.google.com/drive/folders/1KcTC0MymBoYSf1ubvs3TSCR151pMLvKF", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 727013, "creator": true, "nsfw_acceptable": false, "acceptable": tr