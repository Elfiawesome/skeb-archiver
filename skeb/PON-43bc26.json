s://si.imgix.net/62331839/uploads/origins/995d9051-7c41-450f-a000-e4b5514b008d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=cb641ff86a74d10e7084003a5f1cdc15 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/62331839/uploads/origins/995d9051-7c41-450f-a000-e4b5514b008d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=8a75f97f86898c3b7338ccd420758cbf", "srcset": "https://si.imgix.net/62331839/uploads/origins/995d9051-7c41-450f-a000-e4b5514b008d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=8a75f97f86898c3b7338ccd420758cbf, https://si.imgix.net/62331839/uploads/origins/995d9051-7c41-450f-a000-e4b5514b008d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=5572ea2ccfb1ab1579b16a26029ecc10 2x, https://si.imgix.net/62331839/uploads/origins/995d9051-7c41-450f-a000-e4b5514b008d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=7d9825dae839d7b1b507ea46cdf24183 3x"}, "body": "こんにちは。先生の作品の大ファンです!この度、私のキャラの性別を変えたバージョンをお願いしたいのですが、いかがでしょうか？赤い髪と黄色い瞳はそのままに、こちらの参考資料のようなハイテクな服装で。ジャケットを肩から落として、胴体のストラップが見えるように描いていただけると嬉しいです。髪に花をつける必要はありません。\n\n参考：https://drive.google.com/drive/folders/1Ld0vOZYEhiZ37Flm7V793-VXi_ZaSWAa?usp=sharing\n\nhttps://drive.google.com/drive/folders/1Ld0vOZYEhiZ37Flm7V793-VXi_ZaSWAa?usp=sharing", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@PON/works/9", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2058197, "client_id": 684693, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/090865cc/uploads/origins/6ca75a87-0ef3-4c51-95dc-31d37a5ddd07?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=dfa946c97729ba6e35766ad8270ec42f", "srcset": "https://si.imgix.net/090865cc/u