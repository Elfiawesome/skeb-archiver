と思います(よく壁画などであるもの)。出来れば祈っているような仕草もあると嬉しい所存です。\n服装は自由に変えていただいて構いません。Kiaさんが美しいと思う服を着せてあげていただけますと幸いです。背景など細かな装飾もお任せいたします！\n\n写真として家で飾りたいので、イラストのサイズは2L版サイズでお願いできればと思います。\n\nイラストの資料は下記になります。\n\nhttps://drive.google.com/drive/folders/1UJj71I-LRrKadhCHw7LGtw19PvcUKfJa?usp=drive_link\n\n依頼内容が複雑で大変申し訳ないのですが、ご検討の程よろしくお願いします。\n\nhttps://drive.google.com/drive/folders/1UJj71I-LRrKadhCHw7LGtw19PvcUKfJa", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@kirakiralond/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 37423, "client_id": 3603003, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/5f613ebd/uploads/origins/b778b557-5fcb-4c13-a693-b0109c1d1a31?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a35a8ca47d5ae28a16d57f2f3a3cb245", "srcset": "https://si.imgix.net/5f613ebd/uploads/origins/b778b557-5fcb-4c13-a693-b0109c1d1a31?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a35a8ca47d5ae28a16d57f2f3a3cb245, https://si.imgix.net/5f613ebd/uploads/origins/b778b557-5fcb-4c13-a693-b0109c1d1a31?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=dab7e44f198b16e9654556921d95eefc 2x, https://si.imgix.net/5f613ebd/uploads/origins/b778b557-5fcb-4c13-a693-b0109c1d1a31?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=4ef03701682a036de46369d95628670c 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/5f613ebd/uploads/origins/b778b557-5fcb-4c13-a693-b0109c1d1a31?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=09c64aa43243c7aa85b3e5d687dbbc71", "srcset": "https://si.imgix.net/5f613ebd/uploads/origins/b778b557-5fcb-4c13-a693-b0109c1d1a31?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=09c64aa43243c7aa85b3e5d687dbbc71, htt