の方を向いていると嬉しいです！  \n元デザが2人とも可愛い寄りのテイストなので絶対ごつめさまの絵柄が合うと思いまして……   \n\nイラストのテイストはもう全然いつも投稿していらっしゃるような、白黒のラフに少し色があるかないか(なくたっていい！！)くらいの落書き具合で大丈夫です🙆‍♀️人のラフっぽい描き方してる絵が大好きな妖怪です() 、好きに描いてください……  \n\n〈サイズ設定〉 3000pixel以上、350dpi以上あれば嬉しいです。 \n\n  〈使用用途〉  個人鑑賞、個人用の印刷の可能性あり、またクレジット付きで他サイトに載せる可能性があります。\n\nhttps://drive.google.com/drive/folders/1vaa9-MASGdAczVhKc7tGI1MFLrRD21B-", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 249319, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "ちみどろ🌹skeb募集中", "screen_name": "Futa__TIMAMIRE", "avatar_url": "https://pbs.twimg.com/profile_images/1483007603332751368/ZrorIvZP.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1147718598447648768/1690368994/1500x500", "appeal_receivable": true, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 10, "complete_expiration_days": 30, "skills": [{"genre": "art"}, {"genre": "correction"}], "banned": false, "nc": 145}, {"id": 1466913, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "めだかＨ2", "screen_name": "killifish_", "avatar_url": "https://pbs.twimg.com/profile_images/1959306089717248000/k3r7BBey.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1029339481122295808/1749563042/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "art"}, {"genre": "correction"}], "banned": false, "nc": 49}, {"id": 1481029, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "croma:いろわ", "screen_name": "cloa132", "avatar_url": "https://pbs.twimg.com/profile_images/1502891053182906373/Yn5EaNI3.jpg", "header_url": "https://pbs.twimg.com/profile_b