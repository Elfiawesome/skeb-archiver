imgix.net/5e4ae0df/uploads/origins/ffb36147-84dc-4778-a9d1-25da7d39ad1c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=44b32ed513befcc8cd446aca71d48fbe", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/5e4ae0df/uploads/origins/ffb36147-84dc-4778-a9d1-25da7d39ad1c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=342b8c2276216075cd0fa118a6ee9f78", "src_set": ""}, "body": "こんにちは、当方のオリジナルキャラでリクエストさせていただきたいと思います。\nご検討いただければ幸いです。\n\n拳法や法術で妖怪退治をする美少女道士的なイメージです。\n特に臀部や太もも周りの肉付きが良くむちむちな感じで、脚線美が目立つ感じに希望。\n詳細な描写範囲や構図は全ておまかせでお願いしたいと思います。\n\nhttps://ibb.co/album/WgKLH5", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@marumarukopan/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2963244, "client_id": 3387316, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/a32e956e/uploads/origins/201f1f03-4f92-4c79-a524-702cd19c2fed?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e86f546758ee537dc6a35766d917a017", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/a32e956e/uploads/origins/201f1f03-4f92-4c79-a524-702cd19c2fed?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=734f2f6a5afd78a2b20a0754ad831e1f", "src_set": ""}, "body": "こんにちは！\nアトノマツリ様の素敵なイラストをいつも拝見しております。\nぜひオリジナルキャラクターのイラストをお願いしたく、リクエストを送らせていただきました。\n\n描いていただきたいのは、「ミカド」という名前のオリジナルキャラクターです。\n外見の資料につきましては、URLをご参照いただけますと幸いです。\n\nキャラクターの簡単な説明\n性別：男\n性格：アウトローに憧れる厨二病\n少しイキった言動が目立ちますが、どこか憎めない一面もあるキャラクターです。\nご依頼内容\n全身絵でもバストアップでもお任せいたします！\n細かい部分のデザインや構図などは、アトノマツリ様の解釈にお任せいたします。\n素敵なイラストを楽しみにしておりますので、どうぞよろしくお願いいたします！\n\nhttps://drive.google.com/drive/folders/1SaMYWzw1y7eHVVTJaH6b4WAAcVaWCu9o?usp=sharing", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@marumarukopan/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2963244, "client_id": 3083483, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/7df24cda/uploads/origins/f9667132-fc20-407d-b725-03d1583b2895?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=87da75a57cbfc3a66ee3aebc1e603e01", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/7df24cda/uploads/origins/f9667132-fc20-407d-b725-03d1583b2895?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=eaa40a330c0359ed7cfd560028b99907", "src_set": ""}, "body": "アトノマツリさんこんにちは！募集再開ありがとうございます！！マツリさんのかっこよくてすてきなイラストが大好きなのでリクエストできて嬉しいです。\nいつもお世話になっております、七時間睡眠です。\n今回はマツリさんに自創作2人の衣装を仕立てていただきたく、リクエストを送らせていただきます。\n\n・TS、過度な露出、カップリングやそれに近い描写以外でご自由にデザインしていただきたいと考えております。\n・世界観は気にせず2人が並んだ際に統一感を感じるイメージ(同じモチーフ)でデザインしていただけるととても嬉しいです。\n\nまた、デザインしていただいた衣装をイラストに使用する場合があります(マツリさんのイラストのトレス・使用、商用利用はしません)。都合が悪い場合は差分レイヤーに一言お願いします。\n金額が低い等不備がございましたらキャンセル・再送申請お願いいたします。\n\nhttps://drive.google.com/drive/folders/1MnUFYXeYfItjcfUszTzzSbB3wIf-p7pC", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "similar_creators": [{"id": 2410256, "creator": true, "nsfw_acceptable": false, "acceptable": false, "name": "ごいち", "screen_name": "goichi0521", "avatar_url": "https://pbs.twimg.com/profile_images/1903630403950567424/gXk_Z3Sj.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1792754039517753344/1735034194/1500x500", "appeal_receivable": true, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "skills": [{"genre": "art"}], "nc": 145}, {"id": 2624874, "creator": true, "nsfw_acceptable": false, "accept