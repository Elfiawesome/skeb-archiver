なお良い。\n・潮が霧状ではなく棒状。\n---\n\nもし可能であれば、潮吹きに加えて射精前差分、潮吹き後差分があるとありがたいです。\n※射精時差分は任意で大丈夫です。\n\nまた、下記の用途でイラストを利用することをお許し頂けますと幸いです。\n・台詞、効果音、効果エフェクト等を追加した上で、\n　当サークルのパトロンサイト(Ci-en等)にて掲載すること\n\nご検討のほど、よろしくお願い致します。\n\n資料URL:\nhttps://drive.google.com/file/d/1bUjpw8igVLYZqK2wpOaCRbvA9sslpLj7/view?usp=sharing", "nc": 160, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@fuzinoe13b/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 391333, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/837d58b3/uploads/origins/761e580b-7ee1-407f-9c6b-185ba13565bc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b4fb91f3a211e732122438b8bed0ace5", "srcset": "https://si.imgix.net/837d58b3/uploads/origins/761e580b-7ee1-407f-9c6b-185ba13565bc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b4fb91f3a211e732122438b8bed0ace5, https://si.imgix.net/837d58b3/uploads/origins/761e580b-7ee1-407f-9c6b-185ba13565bc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=3fe70bcea9c27c054643fffdb7f75f03 2x, https://si.imgix.net/837d58b3/uploads/origins/761e580b-7ee1-407f-9c6b-185ba13565bc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=9363ade5795af5b2573c7fde908ac81a 3x"}, "duration": null, "nsfw": true, "hardcore": true, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/837d58b3/uploads/origins/761e580b-7ee1-407f-9c6b-185ba13565bc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=81c51d3f0296119f4d90853617004987", "srcset": "https://si.imgix.net/837d58b3/uploads/origins/761e580b-7ee1-407f-9c6b-185ba13565bc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=81c51d3f0296119f4d90853617004987, https://si.imgix.net/837d58b3/uploads/origins/761e580b-7ee1-407f-9c6b-185ba13565bc?bg=%23fff&auto=format%2Ccompress&fm=w