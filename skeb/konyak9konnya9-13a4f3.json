系からカットイン系、はたまた互いに苦戦ボロボロ系まで！\nとにかく楽しく描いて頂ければそれでＯＫです！\nアドリブ投げします！\n凛々しくも可愛い二人を描いて頂ければそれでＯＫです！\n\n◆【使用用途】\n　①Twitter(X)及びmisskey含む外部SNSのアイコン・ヘッダー使用予定\n　②今回納品予定のイラスト紹介（Twitter(X)掲載）\n　③絵師様へ紹介ツイート\n　④２次創作の資料、及び他リクエストする際に引用。\n\n■以上になります。\nもし今回のリクエスト内容及び掲載理由で厳しい。\n作業量に対して金額が合わない！（値上げが必要）\n他等、何か理由が御座いましたら\n遠慮なくキャンセルして頂いて構いません。\n　\n何かとお忙しい中、大変恐縮ではございますが\n何卒御確認、御検討の程宜しくお願い致します。\n\nhttps://x.com/brave_akane/status/1890851527469813806?s=20", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@konyak9konnya9/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3933291, "client_id": 232801, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/d40aaf9f/uploads/origins/093047fd-2058-4512-81f9-cf196dd3222c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=454b03dd95aa34429e7e3fcffc0e594a", "srcset": "https://si.imgix.net/d40aaf9f/uploads/origins/093047fd-2058-4512-81f9-cf196dd3222c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=454b03dd95aa34429e7e3fcffc0e594a, https://si.imgix.net/d40aaf9f/uploads/origins/093047fd-2058-4512-81f9-cf196dd3222c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c9b534a3c5dcaf89f816d9d8308e5861 2x, https://si.imgix.net/d40aaf9f/uploads/origins/093047fd-2058-4512-81f9-cf196dd3222c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=2c95aa0892867030c52679250354605a 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/d40aaf9f/uploads/origins/093047fd-2058-4512-81f9-cf196dd3222c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=cbc08881db3d30a3f4b79b872d02b88c", "srcset": "https://si.imgix.net/d40aaf9f/uploads/origins/093047fd-2058-4512-81f9-cf196dd3222c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur