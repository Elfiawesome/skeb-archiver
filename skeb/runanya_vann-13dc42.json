r=200&s=1e3367c45b78a3d3dab8c56bdc6331a4", "srcset": "https://si.imgix.net/ad69eee6/uploads/origins/2dfa5ac0-9359-40e3-b27f-4b0de169295c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=1e3367c45b78a3d3dab8c56bdc6331a4, https://si.imgix.net/ad69eee6/uploads/origins/2dfa5ac0-9359-40e3-b27f-4b0de169295c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=f23b7dd628c7eeeb640803a800e2c57a 2x, https://si.imgix.net/ad69eee6/uploads/origins/2dfa5ac0-9359-40e3-b27f-4b0de169295c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=83df90e49509430e69aebdc80edafdf0 3x"}, "body": "こんにちは。あなたの作品のスタイル、大好きです！私のキャラクター「キュウ」のイラストを描いていただけると嬉しいです。 \n\nキュウは、自信満々で魅惑的なヴァンパイア・ウルフで、褐色の肌と豊満な体型をしています。細かい特徴としては、牙、キラキラしたリボン、そして金色の王冠とピアスがあります。右目は赤く、左目は金色で、参考画像に載せたセプティグラムの虹彩をしています。\n\nお好きなように描いてください！\nリクエストを検討してくださり、本当にありがとうございます。\n\nhttps://drive.google.com/drive/u/0/folders/1eTKrYpW9XHPex1VW41RYzECQziXZa7kC", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@runanya_vann/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 4088162, "client_id": 4029110, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/19819675/uploads/origins/74bb4dc9-adff-47db-a9e9-4a8944918762?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b6f3bae9eb247c1c71fb2e9890ff5c32", "srcset": "https://si.imgix.net/19819675/uploads/origins/74bb4dc9-adff-47db-a9e9-4a8944918762?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b6f3bae9eb247c1c71fb2e9890ff5c32, https://si.imgix.net/19819675/uploads/origins/74bb4dc9-adff-47db-a9e9-4a8944918762?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=49baeebfbb34ddaa67665c959502e626 2x, https://si.imgix.net/19819675/uploads/origins/74bb4dc9-adff-47db-a9e9-4a8944918762?bg=%23fff&auto=form