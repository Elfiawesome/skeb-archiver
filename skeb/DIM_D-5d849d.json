頂に達するまで続く官能的な夢を見ます。夢から目覚めた彼女は疲れ果て、二度とサキュバスとは戦わないと誓うのです。 \n\n未知の快楽に抗いながらも身をよじるヨルガの様々な表情を描いていただきたいです。もしDIM先生に、このストーリーについてより良い提案があれば、ぜひお聞かせください！\n\nこれは非商用・個人利用を目的としています。\nもし問題があれば、再提出可能です！よろしくお願いします！\n\nhttps://drive.google.com/drive/folders/1_3m-9gKWfZZOUn8lkX42BqizSwQy8zpF?usp=sharing", "nc": 40, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@DIM_D/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "comic", "tipped": false, "creator_id": 2672001, "client_id": 3154071, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/a50d681e/uploads/origins/094d602f-3a80-4adf-8816-3a9f1dc400ea?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=73c44eecf9f68e1b63e5e7fb38621141", "srcset": "https://si.imgix.net/a50d681e/uploads/origins/094d602f-3a80-4adf-8816-3a9f1dc400ea?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=73c44eecf9f68e1b63e5e7fb38621141, https://si.imgix.net/a50d681e/uploads/origins/094d602f-3a80-4adf-8816-3a9f1dc400ea?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=877b9013a27b370aa7658f4856af2a4e 2x, https://si.imgix.net/a50d681e/uploads/origins/094d602f-3a80-4adf-8816-3a9f1dc400ea?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=fd4c37c84b1e2c84f30a37a41397cf86 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/a50d681e/uploads/origins/094d602f-3a80-4adf-8816-3a9f1dc400ea?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=137491d426c9236424b3df9818ed3524", "srcset": "https://si.imgix.net/a50d681e/uploads/origins/094d602f-3a80-4adf-8816-3a9f1dc400ea?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=137491d426c9236424b3df9818ed3524, https://si.imgix.net/a50d681e/uploads/origins/094d602f-3a80-4adf-8816-3a9f1dc400ea?bg=%23fff&auto=format%2Ccompres