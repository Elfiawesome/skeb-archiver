たの\n陽の当たる優しい世界\n2人で歩きたい光の街\nきっといつか\n声が枯れるまで歌い続ける\nあなたに、届くまで\nたとえ泡になってきえたとしても\n後悔しないわ\nもしも歩けたなら\n迷わず貴方の手を\n引いて飛び出すの輝く世界\nあなたと歌う\n夢に見てたあなたとの\n手を繋いで歩く\n光溢れる優しい世界\nきっといつか\nあなたのためだけに歌い続ける\nこの熱が冷めるまで\nたとえ歌えなくなってしまっても\n後悔しないわ\nたとえ声がかれてしまったとしても\nたとえあなたに歌が届かなくても\nたとえ泡になって消えてしまっても\nきっと、後悔しないわ\n貴方を愛しているわ\n\n童話のように人間に恋をした曲で\n｢もしも｣人間とこんなことができたら...\nという妄想してます！\n声をかけることはできないけど\nあなたを思って歌っていることに気づいてほしい\nという願望もあります！\n\n妄想通りのことがあなたとできるなら\nたとえ幸せになれなくて泡になって消えても\n後悔はしない\n\nそんな曲となってます！！！\nよろしくお願いします🙇‍♀️", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@original_only_/works/12", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2669664, "client_id": 2558266, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/5b30a9c6/uploads/origins/6d93d091-83e9-4b7e-b21c-2d37dc518669?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b121dab418d8bc74cfc95e7a099ff294", "srcset": "https://si.imgix.net/5b30a9c6/uploads/origins/6d93d091-83e9-4b7e-b21c-2d37dc518669?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b121dab418d8bc74cfc95e7a099ff294, https://si.imgix.net/5b30a9c6/uploads/origins/6d93d091-83e9-4b7e-b21c-2d37dc518669?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=4b8219d2609b01322aabb214ea3b3507 2x, https://si.imgix.net/5b30a9c6/uploads/origins/6d93d091-83e9-4b7e-b21c-2d37dc518669?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=cfcae1463925874bfa7a611b040d6547 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/5b30a9c6/uploads/origins/6d93d091-83e9-4b7e-b21c-2d37dc518669?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=1414e52c402eece2cd3eb8c830ee76bd", "srcset": "https://si.imgix.net/5b30a9c6/uploads/origins/6d93d091-83e9-4b7e-b21c-2d37dc518669?bg=%23fff&auto=forma