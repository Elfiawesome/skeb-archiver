fit=crop&crop=top&w=200&h=200&blur=200&s=1471194f56c884daf63f00fbe319c8b5 3x"}, "body": "にがりちゃんさんはじめまして！\n\nにがりちゃんさんの描かれるかわいいイラストで自創作カプの二人がみたく、リクエストさせていただきます。\n暁ここねは八重歯、宵闇あおいは下唇の線があると嬉しいです。\n資料URLに衣装が2パターンありますが、この資料通りではなくにがりちゃんさんオリジナルでも大丈夫です！\n\nサイズ、構図はおまかせしますが、二人の距離が近いと嬉しいです！よろしくお願いします。\n\nhttps://twitter.com/pipipi_toge/status/1570049445995384833?s=46&t=8HPFZyAJTWMvR8EswRSjag", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@babu_unchi/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 90844, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/055e3135/uploads/origins/f094f781-35ad-4c8f-b09c-91da2b152d20?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f85b704c1aa77b4d2b2f274f8ff0705b", "srcset": "https://si.imgix.net/055e3135/uploads/origins/f094f781-35ad-4c8f-b09c-91da2b152d20?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f85b704c1aa77b4d2b2f274f8ff0705b, https://si.imgix.net/055e3135/uploads/origins/f094f781-35ad-4c8f-b09c-91da2b152d20?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=22b98675d7a5584692eb02b622680603 2x, https://si.imgix.net/055e3135/uploads/origins/f094f781-35ad-4c8f-b09c-91da2b152d20?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=092a2b7625a836b030c1ac61f3aee614 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/055e3135/uploads/origins/f094f781-35ad-4c8f-b09c-91da2b152d20?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=040a7e381e67864c31dc1e6be71f2905", "srcset": "https://si.imgix.net/055e3135/uploads/origins/f094f781-35ad-4c8f-b09c-91da2b152d20?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=040a7e381e67864c31dc1e6be71f2905, https://si.imgix.net/055e3135/uploads/origins/f094f781-35ad-4c8f-b09c-91da2b152d20?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=3e62232c0df86b30bbefebcce3abf9d3 2x, https://si.imgix.net/055e3135/uploads/origins/f094f781-35ad-4c8f-b09c-91da2b152d20?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=64e2f8091380299039152b747fb23e84 3x"}, "body": "にがりちゃんさんこんにちは！♡　いつも可愛いイラスト楽しませて頂いてます🥰\n私の創作キャラ「ねむ子」ちゃんをリクエストさせて下さい✉✨\n衣装は資料のものでも、にがりちゃんオリジナルのお洋服を着せて頂いてもどちらでもOKです！描きやすい方で構いません🙆◎\n（オリジナルの場合、天使の輪や羽、月や星などの天使っぽいモチーフを入れて頂けるとすごく嬉しいです…！👼✨）\n眠そうなタレ目&小さい片キバ　が特徴です。\n\n※設定が分かりやすいかと思い資料には他のキャラを色々載せているのですが、イラストはねむ子ちゃん（カラー付きの立ち絵の子です）のみ単体でお願いいたします🙏　紛らわしく申し訳ありません…！\n\n是非是非にがりちゃんさんの絵柄で自キャラが見てみたいです…🌙　よろしくお願い申し上げます🙏\n\nhttps://drive.google.com/drive/folders/1l9FfhfcdB6b11DkjUS27UvRpKEPqgeML?usp=sharing", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@babu_unchi/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 90844, "client_id": 1233864, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/60f10c8e/uploads/origins/98067e16-17db-4049-993b-cd510a85a990?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=84fcf57c2f07f8da502cd951f15dc2d8", "srcset": "https://si.imgix.net/60f10c8e/uploads/origins/98067e16-17db-4049-993b-cd510a85a990?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=84fcf57c2f07f8da502cd951f15dc2d8, https://si.imgix.net/60f10c8e/uploads/origins/98067e16-17db-4049-993b-cd510a85a990?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=0c194bc1ef4bc4469b266cdf87232213 2x, https://si.imgix.net/60f10c8e/uploads/origins/98067e16-17db-4049-993b-cd510a85a990?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=8594fbc49e988f2af3345fcb8a642111 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail