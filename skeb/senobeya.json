e_only_public": false, "tip_acceptable": true, "yearly_report_client_visible": false, "total_appeals_count": 0, "received_works": [{"path": "/@senobeya/works/67", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 5162, "client_id": 35829, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/4d36f97d/uploads/origins/00f0d043-1a2a-431d-a90f-1f927ad99a1f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3824861112dc1f5687a8c4de2c948785", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/4d36f97d/uploads/origins/00f0d043-1a2a-431d-a90f-1f927ad99a1f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6681b32b0679a9a55311da9a1237a815", "src_set": ""}, "body": "水着姿の梅ちゃんの依頼です。\n2022年に依頼した梅サンタと同様のムチムチ。\n具体的な水着デザインはお任せしますが、ある程度以上布面積が少ない水着かつ、以前依頼した下記フレッチャーさん&ヘイウッドさんの水着濡れ透けシャツ乳合わせの時の様に濡れ透けシャツ状態もお願いします。\nhttps://skeb.jp/@senobeya/works/43\nポーズはお任せしますが、片乳ないしは両乳が何かによって上記乳合わせと同レベル以上に変形してる状態を希望します。\n\n以上、よろしくお願いします。", "nc": 33, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@senobeya/works/66", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 5162, "client_id": 35829, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/7e0601d6/uploads/origins/d58900e5-85da-4df3-a5f6-de65410cc276?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a1cef619f5d503c409ae7fe1d297ccda", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/7e0601d6/uploads/origins/d58900e5-85da-4df3-a5f6-de65410cc276?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=642f697facd3a8dcda10dfd12425ae2a", "src_set": ""}, "body": "水着姿のフレッチャーさんの依頼です。\nフレッチャーは乳合わせフレッチャー,梅サンタ同様のスタイル。(結婚指輪有,眼鏡差分希望)\n具体的な水着デザインはお任せします。\n\nポーズは寝そべっている系を希望します。\n前回の水着ヘイウッドさんと同系統か、真上からのアングルで、お尻と寝そべって変形してるお胸がある程度以上見える状態を希望します。\n出来れば、サンオイルを塗られる前後というのが分かる絵を希望します。\n\n以上、描き慣れてないポーズかもしれませんがよろしくお願いします。", "nc": 161, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@senobeya/works/65", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 5162, "client_id": 35829, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/225fa196/uploads/origins/d4feeeab-ea7c-4b60-851e-f8e5bbc27c77?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=57b8db755bb5172e450748af6f3efa8a", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/225fa196/uploads/origins/d4feeeab-ea7c-4b60-851e-f8e5bbc27c77?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=897c6382fdbacbb3582dd82acad3a6d0", "src_set": ""}, "body": "水着姿のヘイウッドさんの依頼です。\n23年8月依頼の、乳合わせヘイウッドさんと同様のムチムチスタイル。\n具体的な水着デザインはお任せします。\nポーズは寝そべっている系を希望します。\nお尻と寝そべって変形してるお胸がある程度以上見えるアングルを希望します。\n出来れば、サンオイルを塗られる前後というのが分かる絵を希望します。\n\n以上、描き慣れてないポーズかもしれませんがよろしくお願いします。", "nc": 177, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@senobeya/works/64", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 5162, "client_id": 35829, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/a09f3762/uploads/origins/71f17bb2-7066-482e-82b9-f3ba4f213862?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=438dfe4a5d7db5f79be0333487c8fade", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/a09f3762/uploads/origins/71f17bb2-7066-482e-82b9-f3ba4f213862?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d4589f51858350dc1445a068a945845f", "src_set": ""}, "body": "島風の格好をした梅ちゃんの依頼です。\n2022年に依頼した梅サンタと同様のムチムチ。\nお尻がとてもよく目立つアングルを希望します。\n何時もお顔全体が見えるような絵ですが、今回はある程度見えて表情が分かればいいです。\nお尻の描写の方を優先させてください。\n上着の方はサイズが合ってなくてピチピチ気味、スカートは短くて普通に島風パンツが見えてる状態を希望。\n\n以上、よろしくお願いします。", "nc": 177, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@senobeya/works/63", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 5162, "client_id": 35829, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/300b2853/uploads/origins/4193edff-bda0-4ab3-a01f-564109cdc55d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8f901b4327016b4d35ab0a9d77bcf5b3", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/300b2853/uploads/origins/4193edff-bda0-4ab3-a01f-564109cdc55d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b0e357ba3df67091b3694e229c651e23", "src_set": ""}, "body": "(改造前の)ヘイウッド巫女服モードの恰好をしたフレッチャーさんの依頼です。\nフレッチャーは乳合わせフレッチャー,梅サンタ同様のスタイル。(結婚指輪有,眼鏡差分希望)\n髪型的に問題が無ければ、改造後の巫女服ヘイウッドさんの頭についてる大きいリボンもついてる状態が希望です。\n\nなおポーズとしては、「お前それ次やったらマジで〝これ〟だからな」という(パイズリ)ポーズで、両手で巫女服越しにお胸がしっかりと持ち上がってるのが分かる状態でお願いします。\n表情はお任せします。\n\nお鼻はそれほど目立たない状態を希望します。\n\n以上、よろしくお願いします。", "nc": 32, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@senobeya/works/62", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 5162, "client_id": 35829, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/c862711e/uploads/origins/1d12d001-5d18-4e47-8801-407dae75f547?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4b587a95367ac34f51b9327f26bb5de5", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/c862711e/uploads/origins/1d12d001-5d18-4e47-8801-407dae75f547?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ec2758785bf523aa10efb9f7783d7aa9", "src_set": ""}, "body": "米駆逐棲姫の格好をしたヘイウッドさんの依頼です。\n23年8月依頼の、乳合わせヘイウッドさんと同様のムチムチスタイル。\nカラーリングはお任せします。\nお尻がよく目立つアングルを希望します。\n何時もお顔全体が見えるような絵ですが、今回はある程度見えて表情が分かればいいです。\nお尻の描写の方を優先させてください。\n\n以上、よろしくお願いします。", "nc": 48, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@senobeya/works/61", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 5162, "client_id": 35829, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/3bc2ee0a/uploads/origins/02c2cae5-3b14-436e-9eb5-e3f3774c4b8b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=af2c8708576a732676f228fd0dc8f018", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/3bc2ee0a/uploads/origins/02c2cae5-3b14-436e-9eb5-e3f3774c4b8b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0b3aa3f4091546783612f71a13c83bed", "src_set": ""}, "body": "何時もは毎月依頼してますが、今回は依頼内容が多いので1,2月分の依頼です。\nバレンタインに提督にチョコを渡すノーザンプトンさん絵の依頼です。\nバレンタインモードの服装。\nスタイルは以前依頼した魔法少女絵の時よりもムチムチを希望。\n昨年同様に背景漫画も希望。(せのんさん漫画と同様のキャラ設定)\n出来れば、裸リボン差分も希望。この衣装差分は、メイン絵のみでok。\n\n出来れば、\n・チョコの周りに原型が分からない何かの破片がある状態。\n・チョコがはにわ型ケースに包まれてる状態。\nの2パターンを希望。\n\n以上、よろしくお願いします。", "nc": 48, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@senobeya/works/60", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 5162, "client_id": 35829, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/f4a51bf4/uploads/origins/04da91a3-9fed-4c28-9cc0-0f93ce08d4c3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b7ddfe01400bbf5013f50cbe49426e9b", "src_set": ""}, "duration": null, "nsfw": 