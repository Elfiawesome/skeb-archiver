om/file/d/1pFqDFtygk0tddvs5Rv6Cjj-A4pgEfxtU/view?usp=sharing\n\n●リクエスト詳細\n椅子またはソファーに腰かけている武内Pの膝に、バニーガール姿の美嘉が乗って誘惑しているイラストをお願いします\n構図はお任せしますが、女性の脚線美が映えるものだと嬉しいです\nバニーガール衣装は一般的な黒いハイレグ状のもの。足はストッキングでも網タイツでもお好みの方で\n武内P×美嘉のイラストを求めているため、モブ男ではなく武内Pであることがわかるようにしてください", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@hiyo_nnn/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 243628, "client_id": 256019, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/3f6c4c82/uploads/origins/ac9a3e27-3318-4cc5-9c2a-c01360f2d6bb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c8912f0b732563bf6c8fc1bf63bed841", "srcset": "https://si.imgix.net/3f6c4c82/uploads/origins/ac9a3e27-3318-4cc5-9c2a-c01360f2d6bb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c8912f0b732563bf6c8fc1bf63bed841, https://si.imgix.net/3f6c4c82/uploads/origins/ac9a3e27-3318-4cc5-9c2a-c01360f2d6bb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e980b175046ae20f3639385961ad35cd 2x, https://si.imgix.net/3f6c4c82/uploads/origins/ac9a3e27-3318-4cc5-9c2a-c01360f2d6bb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=32337b6de1c4fb10200be9a47e7ce23b 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/3f6c4c82/uploads/origins/ac9a3e27-3318-4cc5-9c2a-c01360f2d6bb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d9afd353e4bbbd8c2880f7bc2f99f69c", "srcset": "https://si.imgix.net/3f6c4c82/uploads/origins/ac9a3e27-3318-4cc5-9c2a-c01360f2d6bb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d9afd353e4bbbd8c2880f7bc2f99f69c, https://si.imgix.net/3f6c4c82/uploads/origins/ac9a3e27-3318-4cc5-9c2a-c01360f2d6bb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop