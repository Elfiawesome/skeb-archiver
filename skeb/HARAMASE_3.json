c7/uploads/origins/3229709d-912f-4c79-8714-19da06d4fda5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=631aa8dec97a802f9f65b1f36ed9ccbd 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/31174cc7/uploads/origins/3229709d-912f-4c79-8714-19da06d4fda5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=7c7a9d976e551a7d390a1e38049fb93f", "srcset": "https://si.imgix.net/31174cc7/uploads/origins/3229709d-912f-4c79-8714-19da06d4fda5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=7c7a9d976e551a7d390a1e38049fb93f, https://si.imgix.net/31174cc7/uploads/origins/3229709d-912f-4c79-8714-19da06d4fda5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=ab4896e12474aa22abc9948bc6b9e52e 2x, https://si.imgix.net/31174cc7/uploads/origins/3229709d-912f-4c79-8714-19da06d4fda5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=703e57a663de8a8bbce220ceb0ae0aec 3x"}, "body": "自分の持ち主であるマスターの見抜き用オナペットになっていたら魔法カード｢巨乳化｣と罠カード｢強制絶頂装置｣を使われ、その効果で爆乳化アへ顔アクメをキメる遊戯王OCGのRAI-MEIをリクエスト致します。\n\n・キャラクターの頭から膝上まで真正面から写して下さい\n・ほぼ白目を剥いた状態のアへ顔で潮吹き絶頂している\n・ウエストと同じくらいの太さの太もも\n・バストサイズは頭より大きく、へそが隠れて下腹部がギリギリ見えるくらい(大きければ大きいほど良いです)\n・コスチュームは元のカードのイラストと同じ物で、布越しに乳首と乳輪(どちらも大きめ)がくっきりと浮き出ている\n\nといった要素を指定致します。\n\n加えて、以下のシチュに沿った台詞のテキストを付けて頂きたいです。\n\n・目の前で｢巨乳化｣と｢強制絶頂装置｣を発動され訳も分からぬまま間抜けな叫び声を上げて絶頂する。\n・微かに残った意識で止めさせようとするも快楽に負け更に汚い淫語を満載したアへオホ声で絶叫しながらイキっぱなしになる。\n\n…といった内容で、キャラクターの性格や口調はお好きなイメージで構いませんので、とにかく下品で無様なワードで画面を埋め尽くして欲しいです。\n\nまた、絶頂する直前の表情とセリフを一枚目として付けて頂きたいです。こちらはニヤニヤした顔で自分の事をエッチな目で見てくるマスターを小馬鹿にするような態度(好感度は高め)でお願いします。\n\nhttps://drive.google.com/drive/folders/1jUv87DsnPJO7pNY_UW8SRfyrto7lmJwm", "nc": 168, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 64579, "creator": true, "nsfw_acceptable": true, "acceptab