5fdeb/uploads/origins/d0ceedcc-9a4b-4ee5-93a1-bbb7c8298176?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8c557725c6c92e73e775a165b471a5c4, https://si.imgix.net/f685fdeb/uploads/origins/d0ceedcc-9a4b-4ee5-93a1-bbb7c8298176?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=fda0c7e527e44d5511d226fd050255ae 2x, https://si.imgix.net/f685fdeb/uploads/origins/d0ceedcc-9a4b-4ee5-93a1-bbb7c8298176?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=10c7708ff9e715455ae29a328253f67e 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/f685fdeb/uploads/origins/d0ceedcc-9a4b-4ee5-93a1-bbb7c8298176?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3237cadafa0a8160f41bb06241adddff", "srcset": "https://si.imgix.net/f685fdeb/uploads/origins/d0ceedcc-9a4b-4ee5-93a1-bbb7c8298176?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3237cadafa0a8160f41bb06241adddff, https://si.imgix.net/f685fdeb/uploads/origins/d0ceedcc-9a4b-4ee5-93a1-bbb7c8298176?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=8425ede0561c490f63f1b0b13805bca0 2x, https://si.imgix.net/f685fdeb/uploads/origins/d0ceedcc-9a4b-4ee5-93a1-bbb7c8298176?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=54991f31481556ac669660162cd29d63 3x"}, "body": "すあ　様\n\n初めまして。\nこのたびは、OCイラストについてご相談させていただきたく、ご連絡いたしました🌳\n\n●ご依頼内容\nCoCシナリオ『ⅶ・ᴘᴇᴄᴄᴀᴛᴀ』に登場する、私と友人のOCを描いていただきたいと考えております。\n\n【憤怒｜館の主人／現当主】\n烏枢森 字（うすもり あざな）\n\n納棺師であり、父の跡を継いだ青年です。\n占い、特にタロットカードを好み、家族によく占術を行っています。\n表向きは冷静沈着で礼節を重んじる人物ですが、その胸の内には抑えきれない苛立ちや猜疑心が常に燻っています。当主としての責務と誇りを背負っており、使用人に対しても対等に接し、大切に思っています。\n\n【暴食｜忠実な門番】\n葛城 万葉（かつらぎ まよ）\n\nよく笑う、明るい性格の青年です。\n本人なりに仕事には真面目に励んでいますが、少し抜けているところがあり、叱られがちな一面もあります。\n\n■関係性\n家族のように親しく、慎ましやかながらも温かな関係性です。\n同い年で、身長差も1cm程度です。万葉は字の言動を気にかけることが多く、字もまた彼のことを案じています。友人のような親しさがありながらも、当主と使用人という立場ゆえに、常に対をなすような関係でもあります。\n\n◯ご希望の構図・雰囲気\n詳細な構図指定はございませんので、強いて言うなら、ダークな雰囲気のイラストを拝見できましたら嬉しいです。すあ様の描きやすい形やご解釈を優先していただき、自由にアレンジしていただけますと幸いです。\n\n▼イメージキーワード\n・山羊の目（暴食の片目は憤怒の瞳になります）\n・「吊るされた男」の逆位置（タロットカード）\n・タロットカード\n\n◯使用目的\n・スマホの壁紙\n・X（旧Twitter）のアイコン、ヘッダー\n・個人での観賞用\n\n長文となってしまい恐縮ですが、ご検討いただけましたら幸いです。\nどうぞよろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/1gpp7K3wxfZIHT3Ssq7F63M2iLqxogXIK?usp=sharing", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@sua_a_su/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3917362, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/5427be30/uploads/origins/4c6f822d-7c17-4429-9150-b83449e90fa6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=df790c66cdbb9250e6f1706dcdf16dd0", "srcset": "https://si.imgix.net/5427be30/uploads/origins/4c6f822d-7c17-4429-9150-b83449e90fa6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=df790c66cdbb9250e6f1706dcdf16dd0, https://si.imgix.net/5427be30/uploads/origins/4c6f822d-7c17-4429-9150-b83449e90fa6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=0528de0f483dedd011aba7467c210f47 2x, https://si.imgix.net/5427be30/uploads/origins/4c6f822d-7c17-4429-9150-b83449e90fa6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=2aa2bb6d85f8c832cc912ef01128fdd1 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/5427be30/uploads/origins/4c6f822d-7c17-4429-9150-b83449e90fa6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=7ac6e66e78d9787c1dc419f7bce1120a", "srcset": "https://si.imgix.net/5427be30/uploads/origins/4c6f822d-7c17-4429-9150-b83449e90fa6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=7ac6e66e78d9787c1dc419f7bce1120a, https://si.imgix.net/5427be30/uploads/origins/4c6f822d-7c17-4429-9150-b83449e90fa6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=08b3e9f6765637fd7a170b874a5b22bb 2x, https://si.imgix.net/5427be30/uploads/origins/4c6f822d-7c17-4429-9150-b83449e90fa6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=4b41a5c90c98e9ce34b732f66c4e95d0 3x"}, "body": "こんにちは。あなたの作品、本当に大好きです。\n\nこちらは私が考案したオリジナルキャラクターです。ぜひあなたのスタイルで描いていただけると嬉しいです。もしよろしければ、印刷して壁に飾りたいと思っています。彼は穏やかな物腰で、魅力的な笑顔の持ち主です。 マスクを外した姿で描いていただけると嬉しいです。顔中傷跡だらけですが、それでもとてもハンサムな男性です。彼はちょっと悪党な錬金術師なので、毒やガスを使います。でも、すごくかわいいので、犯罪を犯しても大丈夫なんです！！！年齢は29歳です。 描く際は、自由にアレンジしていただいて構いません。服装も厳密に再現する必要はありません。キャラクターに関する追加情報は以下をご覧ください。 よろしくお願いします！ \n\n名前：リース・レヴィン \n年齢：29歳 \n身長：5'10'' / 178CM \n誕生日：2月14日 \n性格タイプ：ESTP-A \nキャラクター説明： 一見すると、リースは陽気で風変わりな巡回医師であり、常にマスクを着用しています。しかし、無害な医療従事者のふりをしている一方で、その明るい笑顔と親しみやすい人柄は、薬物や毒物を専門とする工作員という彼の正体を隠しています。 仮面を偽装として用いるリースは、行く先々で混乱を引き起こし、決して自分の痕跡を残さない。その混乱はしばしばレイブのようなパーティーの形をとっており、大勢の人々が恍惚状態や幻覚に襲われるが、彼らは「研究」という名のもとにリースが調合した最新の薬物を、知らず知らずのうちに投与されているのだ。 彼は「マッドサイエンティスト」という典型的なキャラクターに似ていますが、誘惑や欲望、親密さを操作の手段として体現しています。私は、ピンクの煙や血のような鮮やかな色がアクセントになった、ダークな雰囲気が好きです。彼は悪役ですから、そういった要素はどれも美しく映えるでしょう。ただ一点、彼は狂気じみていたり、大げさな振る舞いをするタイプではありません。 彼には地に足がついた、親しみやすい一面があり、それが彼を危険な存在にしているのです。つまり、狂気じみた様子や笑い声を上げるようなタイプではない、ということです（もしそれが伝わるなら）。お時間をいただきありがとうございました！！！！\n\nhttps://drive.google.com/drive/folders/1GvfFvkBEVMeiYwcH3Z5tsJC-OZwLQQVx\n\nhttps://drive.google.com/drive/folders/1GvfFvkBEVMeiYwcH3Z5tsJC-OZwLQQVx", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@sua_a_su/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3917362, "client_id": 3597371, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/d07d6636/uploads/origins/ca8ecc8c-b268-4067-a409-b155307c2d5d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h