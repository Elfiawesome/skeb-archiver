igins/e3c402bb-28f3-4335-883e-20111e885056?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=04b70f3ee4786b89995ac4e492093d7b 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/ae3e4dfb/uploads/origins/e3c402bb-28f3-4335-883e-20111e885056?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c817ec8988a1678997427b4a8ebeec98", "srcset": "https://si.imgix.net/ae3e4dfb/uploads/origins/e3c402bb-28f3-4335-883e-20111e885056?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c817ec8988a1678997427b4a8ebeec98, https://si.imgix.net/ae3e4dfb/uploads/origins/e3c402bb-28f3-4335-883e-20111e885056?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=4a9f32a715bf8f4c0d45b28a8eb5cd68 2x, https://si.imgix.net/ae3e4dfb/uploads/origins/e3c402bb-28f3-4335-883e-20111e885056?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=ba6857678535b42ded38b92bbfdfd6b0 3x"}, "body": "https://skeb.jp/@jYq0zUnl0yRY109/works/8 の依頼をさせていただいた者です\nその節はどうもありがとうございました\n\nこの数年後、雫が売れ残ってしまっていたらというテーマで小説をお願い出来ないでしょうか？\n\n舞や同期はもうみんな異動してしまっていて、周りには年の離れた後輩ばかり\n少し寂しいけれど、可愛い後輩達に頼られて責任感を持って仕事に打ち込んでいます\nそんな雫の客からの反応は芳しくなく、最新機種と比べ反応速度や人間の再現性が劣るとして雫は試供中に放置され、新しく連れて来られた後輩の購入される様を無感情に眺めます\n\n店のシステムは雫に対して最終処分セールを行います\n販売価格が大幅に下がり、ゴールド会員でなくても自由に試供できる上に、好き勝手しても追加費用がかかりません\n様々な客に犯され続け、完全な修理もされず接客業務もこなします\n見るからに様子がおかしくなっていく雫を後輩たちが心配しています\n複数の客から同時に試供され、ついに致命的なダメージを受けてしまった雫はまともに動かなくなります\nうわごとのように過去の言動を繰り返す雫の元に、先ほどまで心配していた後輩たちがやって来ます\n最終処分セールでも売れなかった彼女はバラされて、リサイクルパーツコーナーに並ぶことになりました\nパーツを外される衝撃でもイってしまうほど壊れている雫を尻目に後輩たちは黙々と作業を続けます\nそうして主幹パーツも抜き取られた雫は機能停止します\n\n雫が居なくなった翌日、後輩たちは変わらない生活を送ります\n接客し、試供され、購入される\nその毎日を繰り返すのでした", "nc": 169, "word_count": 12773, "transcoder": "text", "creator_acceptable_same_genre": true}, {"path": "/@jYq0zUnl0yRY109/works/9", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/56c6e15f/uploads/origins/c0986970-ea18-45a4-ac72-e025d3381b2f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=135e1a04a52646297f1adfa4f3aae5ef", "srcset": "https://si.imgix.net/56c6e15f/uploads/origins/c0986970-ea18-45a4-ac72-e025d3381b2f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=135e1a04a52646297f1adfa4f3aae5ef, https://si.imgix.net/56c6e15f/uploads/origins/c0986970-ea18-45a4-ac72-e025d3381b2f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=c6bf7e44de95825967726a4ba81c677a 2x, https://si.imgix.net/56c6e15f/uploads/origins/c0986970-ea18-45a4-ac72-e025d3381b2f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=697896f431f85ef271de3f70cf2e9e5c 3x"}, "private": true, "genre": "art", "tipped": false, "creator_id": 2476117, "client_id": 600058, "nc": 160}, {"path": "/@jYq0zUnl0yRY109/works/8", "private_thumbnail_image_urls": null, "private": false, "genre": "novel", "tipped": true, "creator_id": 2476117, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/f94cfa74/uploads/origins/ac296d72-ee67-4814-bd8a-6963eb37930e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=773956e1a4db67e9b5fc9119bfee5ac8", "srcset": "https://si.imgix.net/f94cfa74/uploads/origins/ac296d72-ee67-4814-bd8a-6963eb37930e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=773956e1a4db67e9b5fc9119bfee5ac8, https://si.imgix.net/f94cfa74/uploads/origins/ac296d72-ee67-4814-bd8a-6963eb37930e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=2b0c08ac0abd6c2f0253f2c93d7660db 2x, https://si.imgix.net/f94cfa74/uploads/origins/ac296d72-ee67-4814-bd8a-6963eb37930e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e1e5077b5acfb9180cd04174726e267f 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/f94cfa74/uploads/origins/ac296d72-ee67-4814-bd8a-6963eb37930e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=52264f05eb96e899adc803bc537525c4", "srcset": "https://si.imgix.net/f94cfa74/uploads/origins/ac296d72-ee67-4814-bd8a-6963eb37930e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=52264f05eb96e899adc803bc537525c4, https://si.imgix.net/f94cfa74/uploads/origins/ac296d72-ee67-4814-bd8a-6963eb37930e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=8da5203e02268c9a75ba7363e82c8313 2x, https://si.imgix.net/f94cfa74/uploads/origins/ac296d72-ee67-4814-bd8a-6963eb37930e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=7fea47c5bb6bcc6b322d2bbf57a46146 3x"}, "body": "店員の入れ替わりが激しいアンドロイド専門店\nその理由は店員も店で売られている展示品だからで…という小説をお願いします\n\nこの店で働いている店員はすべてアンドロイドです\n彼らには通常モードと試供モードというモードが搭載されています\n通常モード中の彼らは人間と同じように振る舞い、彼ら自身もロボットであるという自覚がありません\n来客から「試したい」と言われると試供モードに切り替わります\n試供モードに切り替わった彼らは来客をバックヤードに連れ込み、セックスを行いながら自身の機能やスペックを説明します\nまた、渡される端末を使ってモードを切り替えたり、高感度などの設定を変更できたりします\n気に入った店員がいればその場で購入することもできますが、購入されなかった場合は自ら洗浄を行いまた店内に戻っていきます\n\n主人公は店員で、他の店員と同様アンドロイドという自覚なく働いています\n小説内でも試供モードに切り替えられるまでは彼女を人間として描写してほしいです\n主人公ははつらつとした女性で、通常モード中の彼女は機械らしい面は一切ありません\n店によく来る男性がいて、主人公は彼のことを気になっていました\n彼女は彼が別の店員とバックヤードでセックスをしているところを目撃してしまいます\nショックを受ける彼女ですが、次の日からその店員は出勤してきませんでした\n彼はまた別の日に来店し、今度は彼女をバックヤードに連れ込みます\n抵抗する彼女でしたが、彼女たちの使い方を思い出した彼が「お前を試させろ」と伝えると打って変わって自ら服を脱ぎ、皮膚どころか自分の体内の構造を晒して宣伝を行います。\nあまり買う気のない男は無理なパーツの引き抜きや設定変更を繰り返します\n彼女は試供モードの時は機械的に、一時的に通常モードに戻された時は懇願するように断ろうとしますが男の「試したい」という言葉が来るたびにそれを受け入れます\nバグっておかしくなり意味不明な言葉の羅列しか話せない状態になった彼女をただのザーメンタンクのように使い、自分のモノだけを綺麗にしてバックヤードから出ていきます\n彼女はしばらくバグった状態でしたが再起動がかかり、自身とバックヤードの清掃を行い、何事もなかったかのように店内に出ていきます\n他の店員が試供モードに切り替えられバックヤードに向かうことに気づかず、彼女は元気に接客を行います", "nc": 161, "word_count": 16673, "transcoder": "text", "creator_acceptable_same_genre": true}, {"path": "/@jYq0zUnl0yRY109/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "novel", "tipped": true, "creator_id": 2476117, "client_id": 187172, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/cc193e82/uploads/origins/e2b099bb-d170-49ff-a631-1fef610dc782?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=dd51e07e9a475fbcd20a5d3fae5681cd", "srcset": "https://si.imgix.net/cc193e82/uploads/origins/e2b099bb-d170-49ff-a631-1fef610dc782?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=dd51e07e9a475fbcd20a5d3fae5681cd, https://si.imgix.net/cc193e82/uploads/origins/e2b099bb-d170-49ff-a631-1fef610dc782?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=80202a0bb678b1e6c6546c5eb7c6751d 2x, https://si.imgix.net/cc193e82/uploads/origins/e2b099bb-d170-49ff-a631-1fef610dc782?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b200e5a73516121086fb8a6900d1c41b 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/cc193e82/uploads/origins/e2b099bb-d170-49ff-a631-1fef610dc782?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=17bc364e288c77797bce07e23ae57ef1", "srcset": "https://si.imgix.net/cc193e82/uploads/origins/e2b099bb-d170-49ff-a631-1fef610dc782?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=17bc364e288c77797bce07e23ae57ef1, https://si.imgix.net/cc193e82/uploads/origins/e2b099bb-d170-49ff-a631-1fef610dc782?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=3f6baf854152e9a757bb5f6c42a4bb1b 2x, https://si.imgix.net/cc193e82/uploads/origins/e2b099bb-d170-49ff-a631-1fef610dc782?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=7a27ef4bbdc185bee0bdf72a4ed963fb 3x"}, "body": "自分が操り手だと思って居る人形はとても可愛いのです。\nというわけで、女性と家事が面倒な女性の為にその夫が買ってきたメイドロボ、というガワを被せたメイドロボとメイドロボに管理される家電の一つ(セクサロイド)というシチュの小説をお願いします。\nたまには自分が夫の食事を作ると料理をするけれどその実態はメイドロボの調理プログラムを遠隔で実行して居るだけだったり、\nメイドロボにマッサージをさせている認識だけど実際は使用の為に潤滑液を補充されているだけだったり、\nそんな具合に頭の中までがっつり操られているけど認識上は自分の方が操り手だと思っている感じで。\n練りがまだ甘い気はしますが、大丈夫だったらよろしくお願いします。", "nc": 48, "word_count": 12925, "transcoder": "text", "creator_acceptable_same_genre": true}, {"path": "/@jYq0zUnl0yRY109/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "novel", "tipped": true, "creator_id": 2476117, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/187df07f/uploads/origins/439ed318-794e-4f49-a367-a7ea19d40ad0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=481d54b5fa5d6781c82d5a41fe25e8e5", "srcset": "https://si.imgix.net/187df07f/uploads/origins/439ed318-794e-4f49-a367-a7ea19d40ad0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=481d54b5fa5d6781c82d5a41fe25e8e5, https://si.imgix.net/187df07f/uploads/origins/439ed318-794e-4f49-a367-a7ea19d40ad0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=da2ed3af8b8e43e294e150bdecd11f0a 2x, https://si.imgix.net/187df07f/uploads/origins/439ed318-794e-4f49-a367-a7ea19d40ad0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=632a310c0e34b30b9584d0f90ccd2a01 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/187df07f/uploads/origins/439ed318-794e-4f49-a367-a7ea19d40ad0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=cd2acb85aaaa0e27c0a1bf49aee11eb6", "srcset": "https://si.imgix.net/187df07f/uploads/origins/439ed318-794e-4f49-a367-a7ea19d40ad0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=cd2acb85aaaa0e27c0a1bf49aee11eb6, https://si.imgix.net/187df07f/uploads/origins/439ed318-794e-4f49-a367-a7ea19d40ad0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=f6ca1dac9e35438dd8f6738ecd0e827a 2x, https://si.imgix.net/187df07f/uploads/origins/439ed318-794e-4f49-a367-a7ea19d40ad0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=640f1c962f01df5d152993d8b2221934 3x"}, "body": "家族同然で長年一緒に暮らしてきた女性型アンドロイドがバイヤーに盗まれ、パーツを交換されたりデータを消されたりして今までの痕跡を消された挙げ句、博物館に売り飛ばされてしまう小説を書いていただけないでしょうか\n\n\n○人物設定（キャラ名称はお任せします）\n・女性型アンドロイド\n家事から夜のお供まで対応可能な生活補助アンドロイド\n成人女性くらいの体格\n少年を抱きかかえられるくらい小さな頃に購入された\nかなり古い型式のためいくつかの機能が壊れて使えない\n例えば少年が幼いときに使用した（本当はプレイ用の）母乳機能など\n左腕がたまに痙攣してしまうことがある。これは少年が幼い頃、誤って壊してしまい泣きながら修理したが素人修理のため完全には治らなかったから。彼女はこれも思い出としていてメーカーの修理には行っていない\n女性器ユニットは未使用\n大きくなった少年から向けられる恋愛感情にどう応えるか迷っている\nメーカーの保守対応リストから外れて久しくバージョンアップがされておらず、クラッキングが比較的容易な機種となってしまっている\n少年へはタメ口で話す\n\n・少年\n母親を物心が付く前に亡くしていて、父も仕事であまり家に居ない家庭で生まれた\nアンドロイドへは母親とも姉とも説明できない感情を抱いていたが、自分の背丈が女性型アンドロイドを追い越す頃には恋愛感情を抱くようになっていった\n簡単な修理のため彼女の取扱説明書を読んだことがあり、そこでsex機能が付いていることを知る\n女性型アンドロイドのことを母さんや姉さんではなく名前で呼ぶ\n\n・男\n古いアンドロイドを収集、リストアしコレクターや博物館に売ったりして生計を立てている\n合法な手段でアンドロイドを手に入れることが多いが、貴重な機種を手に入れるためには違法行為を行うこともある\n手に入れたアンドロイドが女性型だったときは、売り飛ばす前にオナニー代わりに使用したりする\nアンドロイドのリストアの腕はピカイチで、ハードウエアの修理から、前の持ち主のデータを一切消したりとソフトウエアの変更まで出来てしまう\n女性型アンドロイドのことを型番で呼ぶ\n\n\n○ざっくりとした話の流れ（大筋に変更がなければ話を前後したり追加したり省いたりしていただいてもかまいません）\n・女性型アンドロイドは少年と二人で生活している。少年には母親がおらず、父親は仕事でほとんど家に居ない。思春期真っ只中な少年は、幼い頃から育ててくれた彼女に恋愛感情を抱いている\n・二人で出かけたときにバイヤーの男と遭遇する。男はこんな貴重な機種がまだ稼動状態にあるのか！と興奮した様子でセクハラまがいのことを行う。車が買えるほどの金額で買い取ろうと提案するも少年はすぐに拒否する\n・男は立ち去る前に密かにアンドロイドをクラッキングし、家を特定する。少年が不在の時を狙って訪問し機能停止させて連れ去る\n・男はすぐさま営業を開始。都心部で家を建てられるほどの金額で博物館に売ることを決める\n・男はアンドロイドを起動させて検品を行う。最近は男性型ばかりで溜まっていた男は同時に性欲を満たそうとする\n・部屋を出ようとすると自動的にベッドに戻るようにプログラムされたり、嫌がる姿が飽きられると男を少年と誤認識するように書き換えられたりしながら男と性行為を行う女性型アンドロイド\n・検品を終えた男はようやく少年と結ばれ偽りの幸福感に浸っている女性型アンドロイドにリストア作業の手始めとしてデータのフォーマットを開始する\n・女性型アンドロイドは少年（男）に対してなぜそんなことをするのか驚き戸惑いやめるように懇願するも、次第に少年とは誰か分からなくなり、直前にした行動も忘れ、感情が消え、思考することも出来なくなり、『立つ』という動作すら消去されたためその場に崩れ落ち、問いかけにただ応じることしか出来ない空っぽな状態になってしまう\n・男は母乳機能が壊れていることや、少年が見よう見まねで修理したことでたまに挙動がおかしかった左腕を交換したりして、女性型アンドロイドを新品同様まで修理する\n・正しく動作するかを確認するために胸を触られたり、遭遇したときと同じようにセクハラ行為をされてもされるがまま\n・全て確認して性的にも満足した男は梱包して博物館へ送る\n・十数年後、女性型アンドロイドはかつて稼動していた物として展示されていた。人間的な振る舞いを見せる物ではなく、ボタンを押されると反応し自分の型番やスペックなどの定型文を読み上げるだけの物\n・そこへ子どもを連れて博物館に遊びに来た成長した少年がやってくる。少年はハッとするも、子どもにボタンを何度押されても同じ自己紹介を行うことしかできない女性型アンドロイドが自分の初恋相手とは気付けない\n・飽きた子どもが別の展示に駆けていくのを叱りながら追いかける。その後も何人かが横切るも、決して面白い展示とは言えない古びた骨董品の前に立ち止まる者はいなかった\n\n以上です。\nここまでお読みいただきありがとうございました。\nご検討お願いいたします。", "nc": 40, "word_count": 15737, "transcoder": "text", "creator_acceptable_same_genre": true}, {"path": "/@jYq0zUnl0yRY109/works/5", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/88078959/uploads/origins/b3a42368-561b-4838-b20a-e59d1d324e64?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=305461d0579450db397c64526e0b0a1f", "srcset": "https://si.imgix.net/88078959/uploads/origins/b3a42368-561b-4838-b20a-e59d1d324e64?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=305461d0579450db397c64526e0b0a1f, https://si.imgix.net/88078959/uploads/origins/b3a42368-561b-4838-b20a-e59d1d324e64?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=a69b2aea6c8721c8d640c6e520606151 2x, https://si.imgix.net/88078959/uploads/origins/b3a42368-561b-4838-b20a-e59d1d324e64?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=ede1730f1