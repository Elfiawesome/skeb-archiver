げて、パンツごと股間に食い込ませます。\n\n軽くでいいので、2人のセリフをお願いします。\n母親は勝つ気マンマン。ふんどし女の子は恥ずかしさなどなどで涙目な具合です。\n\nどうか宜しければ。", "nc": 32, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@SukePotato/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2869076, "client_id": 2656612, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/abfd230e/uploads/origins/e2daa7c8-2137-4e7a-828e-2092a5706d26?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a8c15ecc32c0baaddf3b520d14042ff7", "srcset": "https://si.imgix.net/abfd230e/uploads/origins/e2daa7c8-2137-4e7a-828e-2092a5706d26?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a8c15ecc32c0baaddf3b520d14042ff7, https://si.imgix.net/abfd230e/uploads/origins/e2daa7c8-2137-4e7a-828e-2092a5706d26?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=0667bb0a4b0d9d8ee7cb01bd1b3bd130 2x, https://si.imgix.net/abfd230e/uploads/origins/e2daa7c8-2137-4e7a-828e-2092a5706d26?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=30ad13cfe0f5183f1323952d6433b563 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/abfd230e/uploads/origins/e2daa7c8-2137-4e7a-828e-2092a5706d26?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6168b84d8eb6d85b2c94007b11358079", "srcset": "https://si.imgix.net/abfd230e/uploads/origins/e2daa7c8-2137-4e7a-828e-2092a5706d26?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6168b84d8eb6d85b2c94007b11358079, https://si.imgix.net/abfd230e/uploads/origins/e2daa7c8-2137-4e7a-828e-2092a5706d26?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=1f57677259fd085590b1793326a5e42c 2x, https://si.imgix.net/abfd230e/uploads/origins/e2daa7c8-2137-4e7a-828e-2092a5706d26?bg=%23f