うな男。\n多くの女性と一夜限りの関係を持っており、自分本位で高圧的。\n\n【身体的特徴】\n体格ががっしりとしており、手が大きく指が長い。喉仏がくっきりと浮き出ている。\n右眼元に黒子。両耳にピアス。\n服装はシンプルなスリーピーススーツの中に白シャツを着ており、革靴や靴下、ネクタイまで全てが黒です。\n\n【キャラクターモチーフ】コーヒ、煙草、眼鏡、モノクロ。\nシチュエーション等お任せ致しますが、煙草を吸っていると大変ありがたいです。\n\n不備がございましたら申し訳ございません。何卒宜しくお願い致します。\nhttps://drive.google.com/drive/folders/1M3EsX-hUp8D7sZrvrOa4bA6j0TcDsSst?usp=sharing", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@_nnwnoiros/works/550", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 115915, "client_id": 2235078, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/d5d3a9c3/uploads/origins/479f5ea2-bdca-4f31-802a-eaec93306f11?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=64315449e32d0014ada40b4e86700458", "srcset": "https://si.imgix.net/d5d3a9c3/uploads/origins/479f5ea2-bdca-4f31-802a-eaec93306f11?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=64315449e32d0014ada40b4e86700458, https://si.imgix.net/d5d3a9c3/uploads/origins/479f5ea2-bdca-4f31-802a-eaec93306f11?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e439c87ec3bae49bb590db415a4b6d51 2x, https://si.imgix.net/d5d3a9c3/uploads/origins/479f5ea2-bdca-4f31-802a-eaec93306f11?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=5ec8f524a8565f21a981fe9d1c69c99e 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/d5d3a9c3/uploads/origins/479f5ea2-bdca-4f31-802a-eaec93306f11?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f4a73f8feeab7222e1159a4b9a96144c", "srcset": "https://si.imgix.net/d5d3a9c3/uploads/origins/479f5ea2-bdca-4f31-802a-eaec93306f11?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f4a73f8feeab7222e1159a4b9a96144c, https://si.imgix.net/d5d3a9c3/uploads/origins/