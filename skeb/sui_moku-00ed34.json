置はお任せします。この作品は横長で、背景のあるバージョンとないバージョンを希望します！全身バージョンとチビバージョンがあれば最高です！ストリーミング、ソーシャルメディア、マーチャンダイズに使用する予定です！ありがとうございました！\n\nhttps://drive.google.com/drive/folders/115dlGsM4RYYGyX6mkaZ8FDuryRV77LlU?usp=drive_link", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@sui_moku/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2235078, "client_id": 1301326, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/b3d64392/uploads/origins/3a2b4b3e-5d70-45ef-a839-96e448ab1924?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=43c86605b2250a88857793468ab69fe3", "srcset": "https://si.imgix.net/b3d64392/uploads/origins/3a2b4b3e-5d70-45ef-a839-96e448ab1924?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=43c86605b2250a88857793468ab69fe3, https://si.imgix.net/b3d64392/uploads/origins/3a2b4b3e-5d70-45ef-a839-96e448ab1924?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=55ada12e56bec9a53e9cbf17e5d4e121 2x, https://si.imgix.net/b3d64392/uploads/origins/3a2b4b3e-5d70-45ef-a839-96e448ab1924?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=43e08d4b3cf4b5e76f8f1669aaeb7d9d 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/b3d64392/uploads/origins/3a2b4b3e-5d70-45ef-a839-96e448ab1924?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5120b12a3714f996905b4ef146bbc5e8", "srcset": "https://si.imgix.net/b3d64392/uploads/origins/3a2b4b3e-5d70-45ef-a839-96e448ab1924?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5120b12a3714f996905b4ef146bbc5e8, https://si.imgix.net/b3d64392/uploads/origins/3a2b4b3e-5d70-45ef-a839-96e448ab1924?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=e093712616301ecf4a