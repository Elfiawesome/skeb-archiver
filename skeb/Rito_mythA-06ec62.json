どいことをすること。上記と似た理由です。\n・幼児化や少年化、下方向への年齢改変。\n長寿にするのはOKです。\n・一人称の改変。演技など特殊な理由がある時以外は「オレ」でお願いします。\n\n\n最後に……\n私の創作は他作者様による女体化二次創作が存在し、楽しく読ませていただいております。これを根拠に、お気軽に書いて頂けますと幸いです。\n\nhttps://drive.google.com/drive/folders/1x72tn3nFyjaqAsIQv-YGLlsQ-pDPHz_E", "nc": 57, "word_count": 4165, "transcoder": "text", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 13908, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "もやしうどん", "screen_name": "moyashi_udon", "avatar_url": "https://pbs.twimg.com/profile_images/1983816386553274368/d4eUwatP.jpg", "header_url": "https://pbs.twimg.com/profile_banners/595418343/1713771127/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 7, "complete_expiration_days": 30, "skills": [{"genre": "art"}], "banned": false, "nc": 176}, {"id": 237722, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "みつり🌺skeb受付中", "screen_name": "MTR_913", "avatar_url": "https://pbs.twimg.com/profile_images/1929555059232378880/EyCauNeP.jpg", "header_url": "https://pbs.twimg.com/profile_banners/357619911/1720316721/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "art"}, {"genre": "correction"}], "banned": false, "nc": 160}, {"id": 306134, "creator": true, "nsfw_acceptable": true, "acceptable": false, "name": "デルタ🔞", "screen_name": "triangle_dek", "avatar_url": "https://pbs.twimg.com/profile_images/1152677937289633792/oxgjzxrK.png", "header_url": "https://pbs.twimg.com/profile_banners/989894048486907904/1687003934/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "de