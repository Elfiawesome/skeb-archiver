4c7-7cd5e9b47a6d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1a0577e8ad56b885ee6474aa62ddf940, https://si.imgix.net/3eb563b3/uploads/origins/a064a1f0-6d8e-4463-84c7-7cd5e9b47a6d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=5f4841958e52ad7c7786effe6b54ae17 2x, https://si.imgix.net/3eb563b3/uploads/origins/a064a1f0-6d8e-4463-84c7-7cd5e9b47a6d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=225b32e0bec55f562539f1d0d8208ae7 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/3eb563b3/uploads/origins/a064a1f0-6d8e-4463-84c7-7cd5e9b47a6d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=58f3ea40149e3a56ac70f9cd3917a730", "srcset": "https://si.imgix.net/3eb563b3/uploads/origins/a064a1f0-6d8e-4463-84c7-7cd5e9b47a6d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=58f3ea40149e3a56ac70f9cd3917a730, https://si.imgix.net/3eb563b3/uploads/origins/a064a1f0-6d8e-4463-84c7-7cd5e9b47a6d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=bf3e7e7abd271e558b31344edd2866fb 2x, https://si.imgix.net/3eb563b3/uploads/origins/a064a1f0-6d8e-4463-84c7-7cd5e9b47a6d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=5f9b274954daed6303d56dd93a99df1e 3x"}, "body": "先生のスタイルがとても好きです。細部の処理方法はMr. さんのアートを思い起こさせますね。\n\n全体としては巨大娘が小さな女の子を優しく弄んでいるような絵が欲しいです。変だと思われたらご遠慮なくボツにしてください。\n【厳密にはこうである必要はありません】\n\nキャラ（素足、できるだけロリっぽい感じがいいです）\n\n主なキャラ：\n服はすごく薄くて軽いです。歩くと服が風になびく。上品でありながら子供っぽいです。派手な装飾のついた艶やかな塗り下駄を履いている。装飾は彼女が普段着ているものと同じようなものです（エビのマスコットもついているかもしれません）。\n参照：imgur.com/a/M0DHyIu\n\n小人（足指サイズ）：\n翼は植物のような形をしており、光ることができる\n参照：imgur.com/a/xzcbZh9\n\nその他の参照：\nポーズ．視点．足．下駄\nimgur.com/a/dwM4JwB\n\nシナリオ：\nピンク髪の子は酔っ払って無造作に水辺をさまよっている。背景が少し暗いので（夕暮れ時かな）遠くで見える祭りの光がある。下駄がすでに落ちている（鼻緒が壊れた）。鼻緒を指で引っ掛け、下駄をぶら下げている。もう片手には艶やかなぐい呑みが握られている。\n\n片足を上げもう片方の太ももの裏を掻くと、忘れていた小さな子が見た（足の小指にぶら下がっている）。振り返り、小人優しく無邪気に微笑みながら、小指をくねくねさせながら「そこで何をしているのですか」と尋ねた。足指に細かい砂が少しついているのかもしれない。\n小さな子が光り輝く翼を羽ばたいています。ずっと振り落とされないように必死で、本当に疲れていました。\n\n視点：\n視点とポーズは先生の絵（参照に含む）に少し似ているが、全く同じではありません（視点はより低く、足に焦点を当て、遠近感を強くしている）。もう片方の足で太ももやふくらはぎを掻いているのは一枚目の参照絵と似ている。\n\n理想を言えば低いアングルから見上げている。視点は足と小人の近く（遠近感が強い）にあります。足指の細部や微妙な動きもはっきりと見えている。酔っていることを示すために少し歪みを持たせるのも効果的かもしれない（任意）。\n\nもしこれを受け入れればサインと宛名入りがどうしても欲しいです。可能であればレイヤー結合しないpsdとラフもお願いできますか？\n\nどうもありがとうございます！", "nc": 9, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@KOJIKIGAZOU/works/15", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/dcff6014/uploads/origins/87c6d775-ff04-4ee7-951e-48852a522eae?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=75d8cbe78bbe097b468d65c154020846", "srcset": "https://si.imgix.net/dcff6014/uploads/origins/87c6d775-ff04-4ee7-951e-48852a522eae?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=75d8cbe78bbe097b468d65c154020846, https://si.imgix.net/dcff6014/uploads/origins/87c6d775-ff04-4ee7-951e-48852a522eae?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=db5723e791985c206acfac1094f80983 2x, https://si.imgix.net/dcff6014/uploads/origins/87c6d775-ff04-4ee7-951e-48852a522eae?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=0e78ad36eb768519b50595180c3bc052 3x"}, "private": true, "genre": "art", "tipped": false, "creator_id": 422734, "nc": 163}, {"path": "/@KOJIKIGAZOU/works/14", "private_thumbnail_image_urls": null, "private": false, "genr