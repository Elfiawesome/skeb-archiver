visible": false, "total_appeals_count": 0, "received_works": [{"path": "/@lupohappening/works/100", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 13272, "client_id": 353492, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/459f99a7/uploads/origins/59d1d728-ff35-436b-94b8-4f9fc3e7f4b4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=37e06ce4c3b5ab907804af6fa36cc2cc", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/459f99a7/uploads/origins/59d1d728-ff35-436b-94b8-4f9fc3e7f4b4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=dc9cc90724d4cb841f2376ad1ad6bc18", "src_set": ""}, "body": "今回もオリジナルキャラクターのイラストをお願いします。\n私のキャラクター「もも」をフルーツに変身させてほしいです。\n\n2コマでお願いします：\n1.1.危険なジャングルを探検しているモモ。\n2.モモがフルーツに変身する。照れながらも微笑んでいるような表情。\n\n赤い果実。また、変身後のモモの横にはメガネを置いてほしい。\n参考：https://imgchest.com/p/agyvrd99978\nありがとうございました！", "nc": 160, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@lupohappening/works/99", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 13272, "client_id": 27187, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/f769f33e/uploads/origins/d65c9660-1a7f-4323-a7af-419feb0da01e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2be00507b6d191e94b32a764bbff1b63", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/f769f33e/uploads/origins/d65c9660-1a7f-4323-a7af-419feb0da01e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ae3589c3caf61898e0bfaf92032070eb", "src_set": ""}, "body": "お久しぶりの依頼になりますがよろしくお願い致します。\n\n風羽とTS影也のハンバーガー化(パテ化)のイラストをお願い致します。\n\n・風羽とTS影也が肉プレスに挟まれて潰されまいと上のプレスを押さえている。(参考①)\n・結局潰されてしまい重なった上下のプレスの間から2人の尻尾がはみ出て肉の焼ける煙が出ている。\n・焼目のついたパテになった2人がパンズに挟まれて陳列されている。(参考②)風羽はチキンタッタ風のパンズに挟まれグルグル涙目、TS影也は普通のパンズに挟まれ普通涙目希望です。\n\n【参考①②】\nhttps://drive.google.com/drive/folders/1G6zvqePoNe7LI27IpwXqijpxO-V5h9AN?usp=sharing\n\nパテになった2人は完全に焼いた肉の色になっているのではなくうっすら焼き目がついているくらいが希望です。\n可能であれば(https://skeb.jp/@lupohappening/works/63）のイラストのように顔に大きなおっぱい（ブラ着用）がついているパテになっていると嬉しいです。\n\n注文多いですが受けて頂ければ幸いです。", "nc": 49, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@lupohappening/works/98", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 13272, "client_id": 41683, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/42834e8b/uploads/origins/1f946a70-e7e3-4c41-aa4f-d6397432486b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6cd75581a2f63f0a667c751c94a2ca57", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/42834e8b/uploads/origins/1f946a70-e7e3-4c41-aa4f-d6397432486b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c4261313403cd42a576f2f3ba54ecc9c", "src_set": ""}, "body": "お久しぶりの依頼をお願いします。\n\n以前と同じく自キャラの他者変身と状態変化のイラストをお願いしたいです。 \n\n自キャラの“しろクラゲ”が、何らかの要因で狼雲さんのキャラの“ワーフム”の姿になってしまい、本物のワーフムの起こしたトラブルに巻き込まれる、その後ワーフム本人と勘違いされ、術や罠などにより、ワーフムの姿のまま風船にされてしまう。\n\n・風船化は狼雲さんのよく描かれる肌色の風船化で顔は落書きのように笑顔で描かれるアレでよろしくお願いします。\n・風船化の際に顔の下に落書きのようなピースサイン✌️✌️を描かれるとエッチだと思うのでおねがいします\n・ワーフムになったしろクラゲは装飾やクラゲ帽子も描写しないで大丈夫です、目の色も含め完全にワーフムにしていただいて結構です。\n・色々と指示をしましたが何となくでOKです、難しい部分は自由に変えてください。\n・可能あればキャプションをつけていただけると嬉しいです。 \n\nhttps://www.pixiv.net/artworks/110059190\n\nhttps://drive.google.com/drive/folders/1GoxFCj30umysQkQOsEyB8ip2dnOGl2-A", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@lupohappening/works/97", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 13272, "client_id": 3588335, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/ef1023da/uploads/origins/ba4ad54d-c16f-4f54-96ac-a68857491cd6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4a2755e5dc398e3c43a26634f16c9c6e", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/ef1023da/uploads/origins/ba4ad54d-c16f-4f54-96ac-a68857491cd6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c36dd708105b76a75589079a597ae2b9", "src_set": ""}, "body": "こんにちは！\n\n初めてリクエストを出します。翻訳が下手なのはご容赦ください。\n\n私のキャラクターである恵美を、振動するディスプレイに張り付いているオナホールとして描いていただきたいです。ディスプレイには変身前の絵も表示してほしいです。\n\n自由な発想でお願いします。\n\nありがとうございました！\n\nhttps://drive.google.com/file/d/101CCgL4hVtKAlFkOgRWCosII_KKWzMXa/view?usp=drive_link", "nc": 48, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@lupohappening/works/96", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/20dbd082/uploads/origins/8666bafb-3c77-4710-b808-79b0875d6e7c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=9858fdaea198fb2b88fac305b89aed7d", "src_set": ""}, "private": true, "genre": "art", "tipped": false, "creator_id": 13272, "client_id": 0, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 32, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@lupohappening/works/95", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/a0c16e60/uploads/origins/0f2b52b4-7697-4585-a5be-913c0d0c4781?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=4668a0d678fab43843b09d9e0593398e", "src_set": ""}, "private": true, "genre": "art", "tipped": false, "creator_id": 13272, "client_id": 2447254, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 176, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@lupohappening/works/94", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 13272, "client_id": 0, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/9261aa29/uploads/origins/718dc76c-8561-4f82-96ac-e70686d88a73?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=62369376aa4986d435f6ac4b8e08cb22", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/9261aa29/uploads/origins/718dc76c-8561-4f82-96ac-e70686d88a73?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ec9ba3112b47a73132261191b27124b8", "src_set": ""}, "body": "狼雲様初めまして！\n\n狼雲様の状態変化物が好みで今回依頼させて頂きました...！\n\n前回別の方が依頼していましたバスタオル化に因んで\n今回は風羽とワーフムが其々お互いを着ている獣耳フードパーカー化をお願いしたいです...！\n\nフードパーカーに変化されている時は基本の服装をモチーフに顔も見えている状態が嬉しいです！\nシチュエーションとしては２つの内容でお願い致します...！\n\n①獣耳フードパーカーに変化させられてしまったワーフム。\n敵は倒したが風羽はそれを見て自身の手を塞ぐ訳にも行かないので顔を赤くしながらも仕方なくワーフムパーカーを着てしまう形に...\n一方ワーフムは風羽に着られて喜んでいる表情だった...\n\n②獣耳フードパーカーに変化させられてしまった風羽。\n敵を倒したワーフムはそれを見るなりゾクゾクとした表情しながら見事に着こなしてルンルンと帰還しようと\n風羽は恥ずかしい様に顔を赤らめる表情しか出来なかった...\n\nの２つの絵があればとても嬉しいです...！\n\n以上。少し長い内容になりましたが是非お受け頂ければ嬉しいです！宜しくお願い致します！", "nc": 32, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@lupohappening/works/93", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 13272, "client_id": 0, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/eb78a616/uploads/origins/450703a4-ddbe-4da4-a808-e6804373a2d4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=c