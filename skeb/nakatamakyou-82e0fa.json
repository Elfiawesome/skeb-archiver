": false, "creator_id": 246921, "client_id": 2360052, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/d7ba02ca/uploads/origins/8a1b69ef-0b24-443e-94df-79066c4d05c6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1df09fb9f80a89882fc2b6018f0ee676", "srcset": "https://si.imgix.net/d7ba02ca/uploads/origins/8a1b69ef-0b24-443e-94df-79066c4d05c6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1df09fb9f80a89882fc2b6018f0ee676, https://si.imgix.net/d7ba02ca/uploads/origins/8a1b69ef-0b24-443e-94df-79066c4d05c6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e32301f5fe8d8998fc0fada6cf5f3565 2x, https://si.imgix.net/d7ba02ca/uploads/origins/8a1b69ef-0b24-443e-94df-79066c4d05c6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=1c96473a7c2bcc14798dd2b52312c929 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/d7ba02ca/uploads/origins/8a1b69ef-0b24-443e-94df-79066c4d05c6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0e1507aaa61b7ad7a78abf2911098a0a", "srcset": "https://si.imgix.net/d7ba02ca/uploads/origins/8a1b69ef-0b24-443e-94df-79066c4d05c6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0e1507aaa61b7ad7a78abf2911098a0a, https://si.imgix.net/d7ba02ca/uploads/origins/8a1b69ef-0b24-443e-94df-79066c4d05c6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=a12d44dcc51d1ec7bbbe007d02460cf7 2x, https://si.imgix.net/d7ba02ca/uploads/origins/8a1b69ef-0b24-443e-94df-79066c4d05c6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=cb2266cec3235dfc9f05c6d68106031e 3x"}, "body": "kyou 様\n初めましての者です\nあなたのイラストがとても好きです!\n特には【azurlane】zara・ザラ\n\n◆キャラクター&衣装\n【azurlane】zara・ザラ\n(https://neokyou.fanbox.cc/posts/2652105)\n◆竿役\n25歳の男性(指揮官)無表情＆影みたいな感じでＯＫです 。全裸\n(https://www.pixiv.net/artworks/103334961)\n◆場所\nベッドの上で\n描きたいものを選んでください((1) or (2))\n\n(1)\n◆シチュエーション・構図\n・視点、体位:密着騎乗位(https://www.pixiv.net/artworks/108760922)\n・差分:事後(陰茎は勃起を終了します（ただし、膣内に残ります))・再び勃起(指揮官の\n陰茎は膣内で直接再勃起します、ザラが水着を脱ぐ)・ 射精・射精後 4種\n・状況:\nこの時、指揮官はザラの優しい余韻で既に射精していた(女性優位)。陰茎は勃起を終了します（ただし、膣内に残ります)。\nザラは誘惑、扇情的笑顔を見せた、柔らかなおっぱいを指揮官の胸に押し当て、二人の体はぴったりと密着する。その後すぐに、指揮官 は ザラ の誘惑で再び勃起しました。しかし、射精したばかりの指揮官はすでに腰を振ることができません。したがって、ザラは指揮官の体に優しく横たわり、柔らかい乳房と柔らかい膣で指揮官の性欲とペニスを常に刺激します(ザラは腰を振らなかった)。しばらくすると、指揮官は腰を振らずに2回目の射精をする!\n(2)\n◆シチュエーション・構図\n・視点、体位:密着した正常位 (https://www.pixiv.net/artworks/104067750)\n・差分:插入・ 行為中(男性青年が優しく腰を振る)・ 射精・射精後(ザラは指揮官にキスします) 4種\n\n\n乳首の分を露出させず。断面図もお願いしたい。\n個人的には(2)の方が好き\nご検討いただければ幸いですが\n割りに合わなければキャンセルください", "nc": 176, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@nakatamakyou/works/8", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 246921, "client_id": 28537, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/8b9baddc/uploads/origins/19444408-8bd8-4c7d-bf58-0c19d19b5821?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=66cd768219ff28c0598dd9bafb23ff77", "srcset": "https://si.imgix.net/8b9baddc/uploads/origins/19444408-8bd8-4c7d-bf58-0c19d19b5821?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=66cd768219ff28c0598dd9bafb23ff77, https://si.imgix.net/8b9baddc/uploads/origins/19444408-8bd8-4c7d-bf58-0c19d19b5821?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=feef0090cc8e9c39a60627a760528b19 2x, https://si.imgix.net/8b9baddc/uploads/origins/19444408-8bd8-4c7d-bf58-0c19d19b5821?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ee6e9efe1717a317da61e18f67bbad44 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/8b9baddc/uploads/origins/19444408-8bd8-4c7d-bf58-0c19d19b582