de6d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4022c32090dff5f601cafb71915655ac", "srcset": "https://si.imgix.net/dea221a7/uploads/origins/cd803d22-b545-4631-868a-bcdd3ecbde6d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4022c32090dff5f601cafb71915655ac, https://si.imgix.net/dea221a7/uploads/origins/cd803d22-b545-4631-868a-bcdd3ecbde6d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=297d0d86ed7e7c7e91588468f94466f3 2x, https://si.imgix.net/dea221a7/uploads/origins/cd803d22-b545-4631-868a-bcdd3ecbde6d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=60545308a7dbaeec47536ebd65d71a9b 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/dea221a7/uploads/origins/cd803d22-b545-4631-868a-bcdd3ecbde6d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=68e9d82509e4e324e3117533fe618533", "srcset": "https://si.imgix.net/dea221a7/uploads/origins/cd803d22-b545-4631-868a-bcdd3ecbde6d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=68e9d82509e4e324e3117533fe618533, https://si.imgix.net/dea221a7/uploads/origins/cd803d22-b545-4631-868a-bcdd3ecbde6d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=254b82ec5f0d57dc52932ecac6cb3d36 2x, https://si.imgix.net/dea221a7/uploads/origins/cd803d22-b545-4631-868a-bcdd3ecbde6d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=2814b1d087b60834506f14e6942cebda 3x"}, "body": "干し粉さんこんにちは、厚塗りのようなやんわりした塗りに引かれてイラスト見てまわってました…それでこういう女の子見たいなと思うことがあったので詳細を載せます。もしよろしければ描いたものを見てみたいです…\n\nこういう白のオフショル着た女の子で、https://www.lettuce.co.jp/products/detail/13065\nボトムスはさびあさぎ色、もしくは縹色の青いプリーツスカートでお願いします。\n\nさびあさぎ色https://irocore.com/sabiasagi/\n縹色https://irocore.com/hanada-iro/\n\n足は白いサンダルでお願いします。装飾は自由です。\n\n髪の毛は黒髪か、金髪に近い茶髪で…おでこが隠れる前髪であれば髪型は問いません。帽