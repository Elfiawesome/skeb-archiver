fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5130a2929a26c6ea2e369d32ef49e999, https://si.imgix.net/a509d896/uploads/origins/9f02d994-610f-4877-a4ec-451755224af3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=afaefa5a4c3a706c1d1b7c13e1b8c9d0 2x, https://si.imgix.net/a509d896/uploads/origins/9f02d994-610f-4877-a4ec-451755224af3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=0699d0eefcffad490f46dfed0b4a434c 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/a509d896/uploads/origins/9f02d994-610f-4877-a4ec-451755224af3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d1bd51b71c76765a475c5f78f48fae88", "srcset": "https://si.imgix.net/a509d896/uploads/origins/9f02d994-610f-4877-a4ec-451755224af3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d1bd51b71c76765a475c5f78f48fae88, https://si.imgix.net/a509d896/uploads/origins/9f02d994-610f-4877-a4ec-451755224af3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=a73261d844c05b6e6092a92b2388473c 2x, https://si.imgix.net/a509d896/uploads/origins/9f02d994-610f-4877-a4ec-451755224af3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=f70a576b65606a670bf21fc1de7505c2 3x"}, "body": "デルタ信号さん、こんばんは。前回は素敵な作品をありがとうございます。大きなタペストリーにさせていただきまして、お部屋に飾って毎日眺めております。とっても美しいです……。\n\n同じ人物でたいへん忍びないのですが、今回もサスライを描いていただきたいのです……。彼は誠実で愛情深い性格をしており、甘いお菓子が大好物です。同居人のような特別な存在で、嬉しいときも、苦しいときも、変わらずそばに居てくれます。そんな優しさにいつも救われています。\n\n構図は一人称視点と言いますか、一緒に居るような感じにしていただきたいです……。優しく微笑んでいて、甘くて穏やかな空気感に描いていただけると嬉しいです。笠を被っていて和装であれば、衣装は描きやすいよう改変いただいて構いません。\n\nPSDデータ希望で、画面を見つめたり印刷して眺めたいと思っております。ご検討いただけますと幸いです。寒くなってまいりましたので、どうかお身体にはお気をつけくださいね。今後のご活動も応援しております。\n\n資料 https://drive.google.com/file/d/1093V57u30sH-bG0C8mUmAllfapesRQGh\n\nhttps://drive.google.com/file/d/1093V57u30sH-bG0C8mUmAllfapesRQGh", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@FL0Ra_oo0/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1994986, "client_id": 3036642, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/033a34a8/uploads/origins/c5a8431d-6b99-4952-8629-47702f351a1e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=26ae89e7838a147bec82ddaa42d8153d", "srcset": "https://si.imgix.net/033a34a8/uploads/origins/c5a8431d-6b99-4952-8629-47702f351a1e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=26ae89e7838a147bec82ddaa42d8153d, https://si.imgix.net/033a34a8/uploads/origins/c5a8431d-6b99-4952-8629-47702f351a1e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ab9c8701a7635280a8b8a7f1ad3ba079 2x, https://si.imgix.net/033a34a8/uploads/origins/c5a8431d-6b99-4952-8629-47702f351a1e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ea6ec4c477bdcbcf5ca4aee75148f07c 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/033a34a8/uploads/origins/c5a8431d-6b99-4952-8629-47702f351a1e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6c066d602167ac0323dd68a2fbf87709", "srcset": "https://si.imgix.net/033a34a8/uploads/origins/c5a8431d-6b99-4952-8629-47702f351a1e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6c066d602167ac0323dd68a2fbf87709, https://si.imgix.net/033a34a8/uploads/origins/c5a8431d-6b99-4952-8629-47702f351a1e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=fe04b45d0fd6a6a66049a3f656c1da0a 2x, https://si.imgix.net/033a34a8/uploads/origins/c5a8431d-6b99-4952-8629-47702f351a1e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=881af771a7bcffc8ebe65e66440ddb59 3x"}, "body": "こんにちは！\nいつも素敵な作品拝見させていただいております。作品を初めて見たとき、心臓に電流が走ったように衝撃を受けたのを覚えています！美しさというものを最大限にまで表現された作品たちが好きです。\n今回は自創作の子をデルタさんの絵で見てみたく、リクエストさせて頂きます。\n\nリクエストさせていただくのは創作の丸顔人外のふたりで、ふたりが仲良く恋人らしくいるところを描いていただきたいです。デルタさんの解釈で自由に描いていただければと思います。\n灰色の子は160cmほど、その地域のあまり厳しくない自衛隊につとめています。成人しています。\n控えめな性格ですが、水色の子にくっつかれたり、恋人として一緒にいる時間が好きです。\n水色の子は160cmほど、灰色の子の同僚です。成人しています。トラウマを抱えているため普段人と話さずクールですが、灰色の子にのみ心を開き、くっつきたがります。\n\n資料につきましてはリンクを添付させていただきましたのでそちらをご参照ください。(見せられるほどの絵があまり無くすみません！)今とデザインが違う絵を一枚添付させていただいておりますが、資料が正しいです。よろしくお願いします。\nデルタさんの絵柄が大好きなので、ぜひ描いていただけたら嬉しいです。\n\nhttps://drive.google.com/drive/folders/1-4xRHlz4HY_33KNJvfoNdzi4FzD1tMs7", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@FL0Ra_oo0/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1994986, "client_id": 1094398, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/56492230/uploads/origins/e91e01c5-8931-4063-9758-a4f58c0c5be2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4ef3d5732b1352ff81269349e1948b57", "srcset": "https://si.imgix.net/56492230/uploads/origins/e91e01c5-8931-4063-9758-a4f58c0c5be2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4ef3d5732b1352ff81269349e1948b57, https://si.imgix.net/56492230/uploads/origins/e91e01c5-8931-4063-9758-a4f58c0c5be2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=4d7f08d1d197fbfd52838352d4cf2faa 2x, https://si.imgix.net/56492230/uploads/origins/e91e01c5-8931-4063-9758-a4f58c0c5be2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=3102d24c2cd5dab950018be444e425e9 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/56492230/uploads/origins/e91e01c5-8931-4063-9758-a4f58c0c5be2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=07a35cee990650827c6d29fe83c53acb", "srcset": "https://si.imgix.net/56492230/uploads/origins/e91e01c5-8931-4063-9758-a4f58c0c5be2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=07a35cee990650827c6d29fe83c53acb, https://si.imgix.net/56492230/uploads/origins/e91e01c5-8931-4063-9758-a4f58c0c5be2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=dd9126f4e0aa085d42ffe8995d59818c 2x, https://si.imgix.net/56492230/uploads/origins/e91e01c5-8931-4063-9758-a4f58c0c5be2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=f2c24826f5f9a24b63b28273135341d0 3x"}, "body": "デルタ信号さん、こんばんは！夢みたいに揺らめいて輝く色や、描かれる皆様の生き生きとした表情がたまらなく好きです。一度見ると、唯一無二の美しい空気感に吸い込まれてしまいます。かわいいぬいぐるみ達のお写真や普段の呟きも楽しく拝見しております。\n\nこれまで漠然と描いていただきたい…と思っていたものの勇気が出ませんでした。skebを暫くお休みされるとのことで、今だ！と思い切って初めて依頼させていただくことにしました。何か不手際がありましたら申し訳ございません。\n\n描いていただきたいのは、サスライというドラゴンです…… 実直で少々世話焼きで甘いお菓子が大好きです。口数は少ないですが優しいであろうことは分かります。身長は約210cmあって大太刀を片手で振るう程力は強いですが、所作は綺麗です。と、いう感じの奴です……\n\n笠を被っていて和装であれば衣装はアレンジしていただいて構いません。目を少し細めてこちらに微笑んでいるところを描いていただけると嬉しいです…… ほんのちょっとだけ、どこか怖さを感じられる雰囲気だともっと嬉しいです…… 他はデルタ信号さんにおまかせします！\n\nPSDデータ希望で、画面と印刷した実物を眺めたいな、と思っております。ご検討いただけますと幸いです。とても暑いので、どうかお身体にはお気を付けくださいね。これからも応援しております。\n\n資料\nhttps://www.tumblr.com/para-c/724996185627181056/%E3%82%B5%E3%82%B9%E3%83%A9%E3%82%A4\n\nhttps://www.tumblr.com/para-c/724996185627181056/%E3%82%B5%E3%82%B9%E3%83%A9%E3%82%A4", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@FL0Ra_oo0/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1994986, "client_id": 2707942, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/d0209568/uploads/origins/1c807725-b36e-4dfb-a8d3-466153c11452?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3f0c37a5b515e1f27704c4ac2add4715", "srcset": "https://si.imgix.net/d0209568/uploads/origins/1c807725-b36e-4dfb-a8d3-466153c11452?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3f0c37a5b515e1f27704c4ac2add4715, https://si.imgix.net/d0209568/uploads/origins/1c807725-b36e-4dfb-a8d3-466153c11452?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=167c3e9248cc2797b0201366cd3e0c1d 2x, https://si.imgix.net/d0209568/uploads/origins/1c807725-b36e-4dfb-a8d3-466153c11452?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a504898269fa303ccba1db1ccdebc145 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/d0209568/uploads/origins/1c807725-b36e-4dfb-a8d3-466153c11452?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c635dc073cf9bb5bc6b6ce3eb64bad0a", "srcset": "https://si.imgix.net/d0209568/uploads/origins/1c807725-b36e-4dfb-a8d3-466153c11452?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c635dc073cf9bb5bc6b6ce3eb64bad0a, https://si.imgix.net/d0209568/uploads/origins/1c807725-b36e-4dfb-a8d3-466153c11452?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=c4b09a83e13a1a426c877e1f1811acab 2x, https://si.imgix.net/d0209568/uploads/origins/1c807725-b36e-4dfb-a8d3-466153c11452?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=a908cbb625d687733aa60435af97caa0 3x"}, "body": "初めまして、ずっと絵が大好きな者です。\n機械種族の創作キャラクターなのですが、どうしてもΔ信号様のイラストで見たくて依頼させて頂きました。\n\n【設定など】\n肉体生物が絶滅してしまった遠い未来に暮らす機械人類。空の無い閉鎖都市に暮らしています。\n滅びた肉体人類の文化を復元して面白いものが見つかったら自由に自分たちの文化に取り入れています。\n【キャラクター】\n・196cm、眼帯に長いケーブルの髪の人物。穏やかな顔つきだが他人に対して容赦なく印象を話す差別的・高圧的な性格。しかし一度打ち解けた人間とは長続きしやすい。\n・200cm、アポストルニクのような外見の人物。顔に一切表情が出ずクールな人物だと思われているが、実際は面白いことやワクワクすることが大好き。DJやモデルとして一部界隈では有名人。\n【外見の特徴など】\n・無性別\n・シリコーンの真っ白な顔。顔以外に白い部分がなく首から下が真っ黒\n・髪と服と肌の区別が無い種族\n\n私の絵柄だと等身が高くなってしまっているのですが、鼻を省略したりデフォルメ強めな丸めの顔の絵柄も大好きなので、可能であればデフォルメされた絵柄でお願いしたいです。\n色のイメージはこちらのイラストのような彩度低め+アクセントカラーの雰囲気だと嬉しいです。\nhttps://www.foriio.com/works/469187\n何卒よろしくお願いします。\n\nhttps://drive.google.com/drive/folders/1SAasa8wNB3w-6SE-ql1Nsi3ojSaOKCY7", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@FL0Ra_oo0/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1994986, "client_id": 2182747, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/1bca34d8/uploads/origins/bdd6345b-edae-46e5-b619-9882dd7bf485?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=433aecb4fe5ccd60431366075a87a0a8", "srcset": "https://si.imgix.net/1bca34d8/uploads/origins/bdd6345b-edae-46e5-b619-9882dd7bf485?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=433aecb4fe5ccd60431366075a87a0a8, https://si.imgix.net/1bca34d8/uploads/origins/bdd6345b-edae-46e5-b619-9882dd7bf485?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ab9c6c1a104008ff84a4cd2d1c64c70b 2x, https://si.imgix.net/1bca34d8/uploads/origins/bdd6345b-edae-46e5-b619-9882dd7bf485?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=db32c085d822d33e7e98178b331d7ccd 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/1bca34d8/uploads/origins/bdd6345b-edae-46e5-b619-9882dd7bf485?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=838ffbf739d2c600c1a83ea9e1c309ef", "srcset": "https://si.imgix.net/1bca34d8/uploads/origins/bdd6345b-edae-46e5-b619-9882dd7bf485?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=838ffbf739d2c600c1a83ea9e1c309ef, https://si.imgix.net/1bca34d8/uploads/origins/bdd6345b-edae-46e5-b619-9882dd7bf485?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=0e96bbd57f5f9ec2685ec891b30429ff 2x, https://si.i