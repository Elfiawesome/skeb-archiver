レオタードでミニスカート付き\n　あまりハイレグ過ぎないほうが好みです。\n●ニーハイソックスで絶対領域がある嬉しいです。\n\n【シチュエーション案】\n●首と腹回りにはガッチリと触手を巻き付けてください。\n　腕、脚にも適宜お願いします。\n●触手の太さは“中～太め”ぐらいにしてください。\n●レオチラもお願いします。\n\n【その他】\n●同じようなリクエストを他の方にもしていますが、ご了承ください…\n\n以上となります。\nよろしくお願いいたします。", "nc": 57, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@runachia_s/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1651263, "client_id": 544327, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/e078c8af/uploads/origins/dbacceeb-da19-49ab-ae98-11effa859db6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e9e391809eb1cfc562a9068114a719c3", "srcset": "https://si.imgix.net/e078c8af/uploads/origins/dbacceeb-da19-49ab-ae98-11effa859db6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e9e391809eb1cfc562a9068114a719c3, https://si.imgix.net/e078c8af/uploads/origins/dbacceeb-da19-49ab-ae98-11effa859db6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c262b4a5fbd33d015f8d9f7544d13722 2x, https://si.imgix.net/e078c8af/uploads/origins/dbacceeb-da19-49ab-ae98-11effa859db6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b4b3c297d02fc565ab431d039c41c661 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/e078c8af/uploads/origins/dbacceeb-da19-49ab-ae98-11effa859db6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0d46268f27ddf34890117cac229ecad5", "srcset": "https://si.imgix.net/e078c8af/uploads/origins/dbacceeb-da19-49ab-ae98-11effa859db6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0d46268f27ddf34890117cac229ecad5, https://si.imgix.net/e078c8af/uploads/origins/dbacceeb-da19-49ab-ae98-11effa859db6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blu