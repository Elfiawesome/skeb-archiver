と幸いです\n\n資料 URL にキャラデザや二次創作ガイドラインへのURLがございますのでご参考にしていただければと思います。\n\nどうぞよろしくお願いいたします。\n\nhttps://twitter.com/nasu_VB/status/1443530091691081730", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@runachia_s/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1651263, "client_id": 157240, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/7de261f0/uploads/origins/633d9773-ef45-42f5-b5ee-f245109b97b3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ed752dfb587d27f91155930eb014c7f6", "srcset": "https://si.imgix.net/7de261f0/uploads/origins/633d9773-ef45-42f5-b5ee-f245109b97b3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ed752dfb587d27f91155930eb014c7f6, https://si.imgix.net/7de261f0/uploads/origins/633d9773-ef45-42f5-b5ee-f245109b97b3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=169b010d5640e8459259baa73a9b1cf4 2x, https://si.imgix.net/7de261f0/uploads/origins/633d9773-ef45-42f5-b5ee-f245109b97b3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=8879e5dd93240bc5f656285372bca455 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/7de261f0/uploads/origins/633d9773-ef45-42f5-b5ee-f245109b97b3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=900f6ae608bcba33a47669def497c7d6", "srcset": "https://si.imgix.net/7de261f0/uploads/origins/633d9773-ef45-42f5-b5ee-f245109b97b3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=900f6ae608bcba33a47669def497c7d6, https://si.imgix.net/7de261f0/uploads/origins/633d9773-ef45-42f5-b5ee-f245109b97b3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=a8829ce57c4cfdadf1c2eecefdac1358 2x, https://si.imgix.net/7de261f0/uploads/origins/6