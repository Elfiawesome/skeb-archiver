7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=95ad1633c0060baf174814a95676e81a", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/de0a1369/uploads/origins/8a087716-592c-4c74-b319-2ffb72b02327?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=726abe4e0069249a32f9ca8e6f488be9", "src_set": ""}, "body": "男の娘アンドロイドのビビ君をメンテナンスするシズク君をお願いします。\n\n○内容\nビビ君がお腹を開けて、シズク君にメンテナンスするように迫る。\nシズク君に知識がなくても、ビビ君が指示してその通りにするように言う。\nビビ君はお腹の中の大事なところをシズク君にいじられて気持ちよくなっている。", "nc": 161, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@2usagino/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "comic", "tipped": true, "creator_id": 3647815, "client_id": 0, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/3138b85b/uploads/origins/73c57fc3-fd74-4048-beb0-31f2c08ea3a3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bceab45c28bda9546ce82ef9250dae4b", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/3138b85b/uploads/origins/73c57fc3-fd74-4048-beb0-31f2c08ea3a3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a084ff23872cf5e6347a942cc614797e", "src_set": ""}, "body": "以前書いていらっしゃった男の娘デビューのカナデ君がかわいかったので彼がいじめの標的になった後の話を描いていただきたいです。事後の写真等で脅されて今後女子制服で登校するよう命じられる。今回のいじめで女装がトラウマになっているが命令に従ったことで周囲からは好奇の目にさらされ、両親は性同一性障害だったのかと考え普段着も女物にしてしまう。男として生活できなくなったこと、エスカレートしていく虐め、周囲の目に苦しみ続けていくという流れでお願いします。\nもしも可能でしたら初の女装登校に怯えながら下着（ブラ）をつけているシーン、性的ないじめシーンを入れていただけると幸いです。\nよろしくお願いします。", "nc": 176, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@2usagino/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3647815, "client_id": 0, "vtt_url": null, "thumbnail_i