じめの標的になった後の話を描いていただきたいです。事後の写真等で脅されて今後女子制服で登校するよう命じられる。今回のいじめで女装がトラウマになっているが命令に従ったことで周囲からは好奇の目にさらされ、両親は性同一性障害だったのかと考え普段着も女物にしてしまう。男として生活できなくなったこと、エスカレートしていく虐め、周囲の目に苦しみ続けていくという流れでお願いします。\nもしも可能でしたら初の女装登校に怯えながら下着（ブラ）をつけているシーン、性的ないじめシーンを入れていただけると幸いです。\nよろしくお願いします。", "nc": 48, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@2usagino/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3647815, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/4586dec7/uploads/origins/f37d0ff1-c3eb-450e-a908-fe6a404b7820?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0ff5b0d26582cd0e635618237c94968d", "srcset": "https://si.imgix.net/4586dec7/uploads/origins/f37d0ff1-c3eb-450e-a908-fe6a404b7820?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0ff5b0d26582cd0e635618237c94968d, https://si.imgix.net/4586dec7/uploads/origins/f37d0ff1-c3eb-450e-a908-fe6a404b7820?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=64fc4130393cd2caa82f8f00704dee17 2x, https://si.imgix.net/4586dec7/uploads/origins/f37d0ff1-c3eb-450e-a908-fe6a404b7820?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=627ad4e8c1dbe929b22ba79435a8bd72 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/4586dec7/uploads/origins/f37d0ff1-c3eb-450e-a908-fe6a404b7820?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2c3f270e94eee938189969b104aa25c1", "srcset": "https://si.imgix.net/4586dec7/uploads/origins/f37d0ff1-c3eb-450e-a908-fe6a404b7820?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2c3f270e94eee938189969b104aa25c1, https://si.imgix.net/4586dec7/uploads/origins/f37d0ff1-c3eb-450e-a908-fe6a404b7820?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=20