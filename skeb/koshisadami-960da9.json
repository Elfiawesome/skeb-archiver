gix.net/62763155/uploads/origins/0ef681e9-8a20-4a9f-b7f8-2c5e65400e49?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f893212a091478b5e3377b2df5bb0d86 2x, https://si.imgix.net/62763155/uploads/origins/0ef681e9-8a20-4a9f-b7f8-2c5e65400e49?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=539f1ed8f7f4e12972e5d5d4162fb1fc 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/62763155/uploads/origins/0ef681e9-8a20-4a9f-b7f8-2c5e65400e49?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=7a36ce82bbec316833f6fae3fc07b3a3", "srcset": "https://si.imgix.net/62763155/uploads/origins/0ef681e9-8a20-4a9f-b7f8-2c5e65400e49?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=7a36ce82bbec316833f6fae3fc07b3a3, https://si.imgix.net/62763155/uploads/origins/0ef681e9-8a20-4a9f-b7f8-2c5e65400e49?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=48aa42938b8e08c13426a97a41e24fd6 2x, https://si.imgix.net/62763155/uploads/origins/0ef681e9-8a20-4a9f-b7f8-2c5e65400e49?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=e4f88f545ac9779da4d965da159107d9 3x"}, "body": "koshi様\n\n初めまして。Skebで納品されていたイラストの絵柄がとても好みだったため、リクエストさせていただきます。\nVTuberの綵(あやぎぬ)てまりさんのファンアートを描いていただきたいです。\n\nご本人様の参考画像\nhttps://pbs.twimg.com/media/E7KuY84VEAAj-oZ?format=jpg&name=4096x4096\n\n【構図】\nゲーム「Apex Legends」に登場する拳銃「ウィングマン」をキリッとした表情でカッコよく構える様子をお願いします。\n\nウィングマン参考画像\nhttps://encrypted-tbn0.gstatic.com/images?q=tbn:ANd9GcR-vMQCjM7ep9Fi3bw231M_j9UvK-3CRrYsYQ&usqp=CAU\n\n構え方イメージ\nhttps://encrypted-tbn0.gstatic.com/images?q=tbn:ANd9GcTNP2nJX2umVrFYhaBmSmlfAOjlRHhoTc_HYg&usqp=CAU\n\nまた、勝手なお願いで申し訳ないのですがもう1枚別パターンのイラストもお願いできますでしょうか。\n\n同じくAPEXに登場するアサルトライフル「R-301」を自信に満ちた余裕を感じさせるような表情で持っている様子も合わせてお願いいたします。こちらの持ち方はおまかせいたします。\n\nR-301参考画像\nhttps://encrypted-tbn0.gstatic.com/images?q=tbn:ANd9GcTaNieOchpCuhw4mJNTztyveiQSmnt5pfgVSg&usqp=CAU\n\n【使用用途】\n綵てまりさんご本人に限り使用許可を頂きたいです。※Twitter、配信サムネイル等に使用\n\n【納品形式】 \n人物・宛名・背景等がレイヤー分けされたPSDで頂けるとありがたいです。 Twitterで納品報告をされる場合は「#てまーじゅ」のタグを付けていただけますと幸いです。\n\n要望が多くなってしまい申し訳ございません。可能な範囲で構いませんので、ご検討よろしくお願いいたします。", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@koshisadami/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1992647, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/9061f5a0/uploads/origins/fbe49b07-e4a0-42eb-958c-30e2bae05d24?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=abaa0115da6f330c097ca95acc9e783e", "srcset": "https://si.imgix.net/9061f5a0/uploads/origins/fbe49b07-e4a0-42eb-958c-30e2bae05d24?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=abaa0115da6f330c097ca95acc9e783e, https://si.imgix.net/9061f5a0/uploads/origins/fbe49b07-e4a0-42eb-958c-30e2bae05d24?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=922e57d5f3228b17cfb86b2607e2906d 2x, https://si.imgix.net/9061f5a0/uploads/origins/fbe49b07-e4a0-42eb-958c-30e2bae05d24?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=8a29c8a67acca30831be836e103ff5c0 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/9061f5a0/uploads/origins/fbe49b07-e4a0-42eb-958c-30e2bae05d24?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=37924ef2fa3504b3aa7bdb6b00610475", "srcset": "https://si.imgix.net/9061f5a0/uploads/origins/fbe49b07-e4a0-42eb-958c-30e2bae05d24?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=37924ef2fa3504b3aa7bdb6b00610475, https://si.imgix.net/9061f5a0/uploads/origins/fbe49b07-e4a0-42eb-958c-30e2bae05d24?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=20