ラしたイラストで、ゴモリーちゃんを描いて頂きたいと思い、リクエストいたしました。\n\nゴモリーちゃんは堕天使で、少しあどけない幼さがある女の子です。\n（@ fallenAngel_gm）\n服装は地雷系で、そちらが難しければ\nゴモリーちゃんの堕天使の衣装でお願いします。\nポーズや表情は、お任せします。\n\n使用用途ですが、YouTubeサムネイルやTwitterの広報などで使用してもらい為、使用許可はゴモリーちゃんにのみお願いいたします。\nゴモリーちゃん本人は、ファンアートのsbeb依頼を許可しております。\nサムネイルなどに使用できるように、\n可能でしたら、キャラクターと背景をわけたPSDデータ、もしくはPSDをいただければ嬉しいです。\nご検討の程、何卒よろしくお願いいたします。\n\nhttps://i.imgur.com/eNYg7lY.jpg\n\nhttps://lit.link/gomory1211", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Hx9cJ/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1738219, "client_id": 2925161, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/d707e157/uploads/origins/90607756-96aa-4281-9259-d434fd6d301c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=452a10c01de954a564be206027410a70", "srcset": "https://si.imgix.net/d707e157/uploads/origins/90607756-96aa-4281-9259-d434fd6d301c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=452a10c01de954a564be206027410a70, https://si.imgix.net/d707e157/uploads/origins/90607756-96aa-4281-9259-d434fd6d301c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=4874b5cd5662fdb9fe1f9cc2fac45797 2x, https://si.imgix.net/d707e157/uploads/origins/90607756-96aa-4281-9259-d434fd6d301c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=78ac93ecc684ed72ccb6e6069ec00364 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/d707e157/uploads/origins/90607756-96aa-4281-9259-d434fd6d301c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=001b5ce4db1645b347f25866a0367268", "srcset": "https://si.imgix.net/d707e157/uploads/origins/90607756-96aa-4281-9259-d434fd6d301c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=001b5ce4db1645b