10913613（肉感）\nhttps://www.pixiv.net/artworks/111934903（肉感）\n\n\n●用途\n・PC壁紙、SNSアイコン、個人のものに印刷（Tシャツとか）など。\n商法利用やイラストを源に利益を上げる行為などは一切行わず、個人的のみに使用します。\n\n●形式\n・キャラクターをレイヤー分けしていただけると幸いです。\n・ファイル形式はpsdでお願いします。\n・解像度は350dpiでアスペクト比は一任します。\n\n改めてになりますが、ご検討のほどよろしくお願いします。", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Hx9cJ/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1738219, "client_id": 2616430, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/05038df1/uploads/origins/339d4f4a-e722-4fb1-ae0c-adb6bc611f6b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=402be09c0143e05f3fb1af8ac3e219ab", "srcset": "https://si.imgix.net/05038df1/uploads/origins/339d4f4a-e722-4fb1-ae0c-adb6bc611f6b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=402be09c0143e05f3fb1af8ac3e219ab, https://si.imgix.net/05038df1/uploads/origins/339d4f4a-e722-4fb1-ae0c-adb6bc611f6b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=74436b8000d821a5590fd37fbb7ce199 2x, https://si.imgix.net/05038df1/uploads/origins/339d4f4a-e722-4fb1-ae0c-adb6bc611f6b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f9a9dd1e3b11d4f2c62efff6d51bb073 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/05038df1/uploads/origins/339d4f4a-e722-4fb1-ae0c-adb6bc611f6b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=4f2a2841e092e0e53cc11a7f48eb4b99", "srcset": "https://si.imgix.net/05038df1/uploads/origins/339d4f4a-e722-4fb1-ae0c-adb6bc611f6b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=4f2a2841e092e0e53cc11a7f48eb4b99, https://si.imgix.net/05038df1/uploads/origins/339d4f4a-e722-4fb1-ae0c-adb6bc611f6b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&