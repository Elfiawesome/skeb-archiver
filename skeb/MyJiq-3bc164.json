87828-a819-411b-aa7d-0c3170eb4486?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=6c59be72b32398f44198ff7eab1bd007 2x, https://si.imgix.net/873bcb67/uploads/origins/13587828-a819-411b-aa7d-0c3170eb4486?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=d8efa06b3bcafb572831759434d934d9 3x"}, "body": "こんにちは。次のような内容をお願いしてもよろしいでしょうか。\n\n基本的な設定\n\n・登場人物は、千反田えると入須冬実。\n\n・以下のように、片方が風船を頭に被りもう片方が息を吹き込むという内容。\nhttps://skeb.jp/@orca_buteo/works/12\n\n・千反田えるは風船を被る側。無邪気に笑う、ウィンクをするなど、楽しそうで余裕のある表情や仕草をしている。\n\n・入須冬実は息を吹き込む側で、ホースを口に咥えた状態。汗を垂らし戸惑った表情をしている。千反田えるの体に手を添える、抱き着くなどして、体の一部を密着させている。\n\n・どちらか一方は、風船の膨らみ具合を確認するかのように風船に手を添えている。", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@MyJiq/works/12", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 60965, "client_id": 1340707, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/fa97a7cf/uploads/origins/b935775c-9382-40cd-815d-3869ba60ec15?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c1ecdfdd15ccbd94808363a6b3564ecb", "srcset": "https://si.imgix.net/fa97a7cf/uploads/origins/b935775c-9382-40cd-815d-3869ba60ec15?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c1ecdfdd15ccbd94808363a6b3564ecb, https://si.imgix.net/fa97a7cf/uploads/origins/b935775c-9382-40cd-815d-3869ba60ec15?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=391ad20e15304410ffc0876e4a92a547 2x, https://si.imgix.net/fa97a7cf/uploads/origins/b935775c-9382-40cd-815d-3869ba60ec15?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c1f9679a59dcdf479c3f4a40499176cf 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/fa97a7cf/uploads/origins/b935775c-9382-40cd-815d-3869ba60ec15?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=57f2430b2aaf9d8e008ff1d393d9d176", "srcset": "https://si.imgix.net/fa97a7cf/uploads/origins/b935775c-9382-40cd-815d-3869ba60ec15?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=57f2430b2aaf9d8e008ff1d393d9d176, https://si.imgix.net/fa97a7cf/uploads/origins/b935775c-9382-40cd-815d-3869ba60ec15?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=c07e977906084795aae75c080ca51678 2x, https://si.imgix.net/fa97a7cf/uploads/origins/b935775c-9382-40cd-815d-3869ba60ec15?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=25612995bc12c2d45fcf3a9129c4ae54 3x"}, "body": "こんにちは！先日はありがとうございました！\n\n今回は私の考えているオリキャラを描いていただきたくリクエストさせていただきました。\n\nキャラクターは水泳部の女の子というイメージです。\n・髪型は参考画像の「髪型」でお願いします\n・髪色はユーフォの小笠原晴香部長の髪色\n・瞳の色は青色系でキリッとした顔つき\n・身長は160cm強のイメージ\n・体つきは引き締まった感じで胸C〜Dカップ程度のイメージでお願いします\n・衣装の競泳水着は参考画像の「競泳水着」のデザインでお願いします。\n・アングルが正面でポーズはお任せします。\n\n参考画像: https://drive.google.com/drive/folders/1u2luwPbm1Fua3rYjUBC5M826yrLD-7YE\n\n要望が多くなってしまいましたがこんな感じです。\n用途はSNSのアイコンや個人鑑賞等です。\n難しいようでしたらキャンセルしていただいて大丈夫です。ご検討していただけたら幸いです。よろしくお願いします。", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@MyJiq/works/11", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 60965, "client_id": 1340707, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/295fa2a8/uploads/origins/e07d1b16-2ec3-4cb8-9d69-f036acd52fdf?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0eb4fe150965747724f6e00ed5906e58", "srcset": "https://si.imgix.net/295fa2a8/uploads/origins/e07d1b16-2ec3-4cb8-9d69-f036acd52fdf?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0eb4fe150965747724f6e00ed5906e58, https://si.imgix.net/295fa2a8/uploads/origins/e07d1b16-2ec3-4cb8-9d69-f036acd52fdf?bg=%23fff&auto=format%2Ccompress&fm=webp&