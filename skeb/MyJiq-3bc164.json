=200&h=200&s=5e1561405433284054624ab6173f9702", "srcset": "https://si.imgix.net/6c3a33b1/uploads/origins/ab8da563-a853-4af8-aaea-459eec0bd6ec?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5e1561405433284054624ab6173f9702, https://si.imgix.net/6c3a33b1/uploads/origins/ab8da563-a853-4af8-aaea-459eec0bd6ec?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e9f572921aac84123a5fd9cecec5b6e2 2x, https://si.imgix.net/6c3a33b1/uploads/origins/ab8da563-a853-4af8-aaea-459eec0bd6ec?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=89980f95d6bb991bafdb38727cbc4605 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/6c3a33b1/uploads/origins/ab8da563-a853-4af8-aaea-459eec0bd6ec?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c8e3c3629654a602ade6642acef48b44", "srcset": "https://si.imgix.net/6c3a33b1/uploads/origins/ab8da563-a853-4af8-aaea-459eec0bd6ec?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c8e3c3629654a602ade6642acef48b44, https://si.imgix.net/6c3a33b1/uploads/origins/ab8da563-a853-4af8-aaea-459eec0bd6ec?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=a3f871a1a4488ad7c91e78976ff68058 2x, https://si.imgix.net/6c3a33b1/uploads/origins/ab8da563-a853-4af8-aaea-459eec0bd6ec?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=2f3ccf97ac7d63cfb500cff89ec53f98 3x"}, "body": "以前、久美子の水着姿を依頼した者です。\n続きが見たくなったので、今回新規に依頼しました。\n\n今回も前回と同じく、響け！ユーフォニアムの黄前久美子をお願いします。\n\n衣装は、縁輝が着ていた私服。サイズの関係でヘソ出し。頭につけているリボンもつける。劇中では違いますが、靴は緑のハイヒールでお願いします。\n\n表情は目を開いてにやにやとにやけた表情。\n\n髪型はいつもの水着を着ていないときの髪型。\n\n自分が着ていた元の私服は縁輝が着ることになるので、ハンガーで綺麗にたてかけてある。\n\n構図は正面向きの全身絵で、両腕は後ろでお願いします。\n\n以下シチュエーション。\n川島緑輝に自分の着ていた私服を羨ましそうにしていたので、水着を貰ったお礼に私服を交換することになりました。\n髪は乾いた状態。更衣室のロッカーの鍵をもらって先に久美子が着替えて、縁輝に自分の着ていた私服を手渡しであげるつもり。\n着てみると着心地がよく交換して良かったと思っており、自分がこれからこの私服を着ることが出来るので、表情がにやけてしまう。\n\n\n私服の参考資料\nhttps://cdn-ak.f.st-hatena.com/images/fotolife/a/aritsuidai/20161017/20161017172145.jpg\n\n検討よろしくお願いします。", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@MyJiq/works/8", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 60965, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/0329dfaa/uploads/origins/baaaec27-15ed-49e9-9995-e0dce6058d82?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9b0bfdbc3987e5459f1e379c323aa7ad", "srcset": "https://si.imgix.net/0329dfaa/uploads/origins/baaaec27-15ed-49e9-9995-e0dce6058d82?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9b0bfdbc3987e5459f1e379c323aa7ad, https://si.imgix.net/0329dfaa/uploads/origins/baaaec27-15ed-49e9-9995-e0dce6058d82?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=4d65e2f83054496b8b2cf16d5f199b79 2x, https://si.imgix.net/0329dfaa/uploads/origins/baaaec27-15ed-49e9-9995-e0dce6058d82?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f622db299e9a3d93334264eb2e4b4666 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/0329dfaa/uploads/origins/baaaec27-15ed-49e9-9995-e0dce6058d82?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3d367ff27e6f50d0605a3441d7006f91", "srcset": "https://si.imgix.net/0329dfaa/uploads/origins/baaaec27-15ed-49e9-9995-e0dce6058d82?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3d367ff27e6f50d0605a3441d7006f91, https://si.imgix.net/0329dfaa/uploads/origins/baaaec27-15ed-49e9-9995-e0dce6058d82?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=ccc98a5c9096ddef803d9bc690cae215 2x, https://si.imgix.net/0329dfaa/uploads/origins/