ことは大事で、裏切ったUGNのことは許せない、許したらいけない、と強く思っています。\nただ、UGN時代では弔さんを慕っており、恋心にも近い気持ちを持っていまいた（というか恋心を持っていました）\nそのため、複雑な気持ちを抱えたまま今に至り、作戦に挑んでいました。\n\nモノクロでの表現は自由にして頂いて構いませんし、服などのアレンジ、表情の解釈なども思うままにして頂ければと思います。\nご一考頂ければ幸いです………！！\n\nhttps://bramble-swallow-470.notion.site/a0d62ed140bc4720ad3eb3e491b9e6fd", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@sgnn_nnsg/works/6", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/59a8b387/uploads/origins/da782c52-d93a-446b-b016-16d94411df6b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=9cca70ac703f605448c178bc1467e116", "srcset": "https://si.imgix.net/59a8b387/uploads/origins/da782c52-d93a-446b-b016-16d94411df6b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=9cca70ac703f605448c178bc1467e116, https://si.imgix.net/59a8b387/uploads/origins/da782c52-d93a-446b-b016-16d94411df6b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=02650b2ee46b146c85cabc96edc3993c 2x, https://si.imgix.net/59a8b387/uploads/origins/da782c52-d93a-446b-b016-16d94411df6b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=84abdd230ab70b43694b4fb3d1a89cfe 3x"}, "private": true, "genre": "art", "tipped": true, "creator_id": 1044510, "client_id": 894363, "nc": 1}, {"path": "/@sgnn_nnsg/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1044510, "client_id": 611775, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/cf47fd56/uploads/origins/5ba5711b-9664-45