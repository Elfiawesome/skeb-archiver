している\n・ひつじのぬいぐるみに腰かけて空を見ている\n\n設定　能力\nめぇは人々の記憶に住み着く妖精や悪魔のようなもので\n体の縁が淡く発光しており、普段は浮遊しています\n桃、アルコール、ミルク、干した布団　等に近しい\n相手の警戒を解くような薄甘い香りを纏ってます\n\n抱き着いたりして肌に触れ続けた相手に眠気を植えつけて夢を見せ\n夢に干渉して自分の情報を滑り込ませることで存在を保ちます\n分泌される体液や血液は練乳やミルクのようで、\n飲ませた相手を強壮し、軽い依存性をもちます\n\n資料は以下のURL、Skebの過去の納品を参考にお願いします\nhttps://www.pixiv.net/artworks/99333545\n\nhttps://www.pixiv.net/artworks/70796264", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@hndr_chita/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3450011, "client_id": 153686, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/9ac442e2/uploads/origins/da7a9fcd-2746-4ce2-a84f-35d9112a972f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=436d7015582b5ffc34ffe9a7e2d29282", "srcset": "https://si.imgix.net/9ac442e2/uploads/origins/da7a9fcd-2746-4ce2-a84f-35d9112a972f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=436d7015582b5ffc34ffe9a7e2d29282, https://si.imgix.net/9ac442e2/uploads/origins/da7a9fcd-2746-4ce2-a84f-35d9112a972f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=382826ba6f0f970fa65da156a784452a 2x, https://si.imgix.net/9ac442e2/uploads/origins/da7a9fcd-2746-4ce2-a84f-35d9112a972f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=37980d586861a1c4c5194cf9183bdaf6 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/9ac442e2/uploads/origins/da7a9fcd-2746-4ce2-a84f-35d9112a972f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f49863c202677e0807e1abf2cfe7263f", "srcset": "https://si.imgix.net/9ac442e2/uploads/origins/da7a9fcd-2746-4ce2-a84f-35d9112a972f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f49863c202677e0807e1abf2cfe7263f, https://si.imgix.net/9ac442e2