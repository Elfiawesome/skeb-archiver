18ce34/uploads/origins/096b43c9-adbe-4aca-a366-583c5fc736dc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=54cee0ad9fc62bd41f312b6a5a752053 2x, https://si.imgix.net/9e18ce34/uploads/origins/096b43c9-adbe-4aca-a366-583c5fc736dc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=91fc585e44e98df4571d1cb6aeba11ac 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/9e18ce34/uploads/origins/096b43c9-adbe-4aca-a366-583c5fc736dc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5c0daea1138dc741137849bf51160b3f", "srcset": "https://si.imgix.net/9e18ce34/uploads/origins/096b43c9-adbe-4aca-a366-583c5fc736dc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5c0daea1138dc741137849bf51160b3f, https://si.imgix.net/9e18ce34/uploads/origins/096b43c9-adbe-4aca-a366-583c5fc736dc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=fb8a2bd3704815a93130231193f0c90e 2x, https://si.imgix.net/9e18ce34/uploads/origins/096b43c9-adbe-4aca-a366-583c5fc736dc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=8e9099b4a8c23ff71e8a9515bf969b58 3x"}, "body": "こんにちは、先生！ 先生の手描きのスタイルがとても好きです！ 私の3人のオリジナルキャラクターを描かせていただきたいのですが、別々に描いても、同じ構図で描いても構いません！\n\n彼らは物語の悪役で、狩りをし、霊物質を集め、より強力な能力を得るために人体実験をします。 3人が出会う前、彼らの物語は悲劇的だった。\n過去については、リンク先の「過去」フォルダを参照してください。\n\n1、第犬（红髪の方）\n男 / 184cm / 24歳/74KG\n特徴 垂れ目、犬歯、食べるのが好き、馬鹿、色男、個性的、声が大きい。\nキーワード：再生可能な手足 嬉しい。 跪いて祈れ。 鋭い歯。 腹部のタトゥー。\n\n2、永冢伊春（绿髪の方）\n男 / 161cm / 16歳/44KG\n特徴：目の下にクマ、毒舌、弱い、チャラい、中二病\nキーワード：暴力的傾向 暗さ。 包帯。 太ももの傷跡。 血を味わう。 怪しげな目。\n\n3、佐仓（黄髪の方）\n男性／176cm／24歳／64kg\n特徴：つり目、猫口、女性的、上品、偽善的、暗い\nキーワード: コーヒー; お金; 傘; ダンス\n\nトリオの関係図を簡単に言うと\n情緒不安定でクズな主人と抜け目のない執事猫＋バカで元気な道具犬\n\nチームの中心にいる緑髪のキャラクターは現在学生で、最年少だが異常な超能力を持っている。 一方、赤毛のキャラクターは、通常、最も暴力的で直接的なアプローチをとり、彼の体はアンデッドのように何度でも再生することができる。 一方、黄色い髪のキャラクターは、裏の黒幕のように振る舞い、年齢は不明で、常に利益を最優先している。\n\n 風景：実験的な屠殺場／荒廃した街並み／古い外国の家（とても奇妙なコレクションがある）\n\nキーワード不死; 輪廻転生; 犯罪\n\nアイデアは先生にお任せします！ 先生のキャラクター解釈が楽しみです。\n\n参考リンクでは、キャラクターの設定など、絵の参考情報をご覧いただけます。\nhttps://drive.google.com/drive/folders/1yloGC6DOqXy26_MFC8P_fIaxZ03ROEm5?usp=sharing\n\n以上になります。\nご多忙だったり、複数人ですので難しい部分がありましたら遠慮なくキャンセルください！\n（金額が足りない場合は再送要請頂けましたら嬉しいです）\nご検討頂けましたら幸いです。", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@mizo_167/works/3", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/ae6ddb8c/uploads/origins/53c38056-f4f8-4d41-afa5-a33a24ec8b63?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=88b98104a061768b2924fe87af3782a9", "srcset": "https://si.imgix.net/ae6ddb8c/uploads/origins/53c38056-f4f8-4d41-afa5-a33a24ec8b63?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=88b98104a061768b2924fe87af3782a9, https://si.imgix.net/ae6ddb8c/uploads/origins/53c38056-f4f8-4d41-afa5-a33a24ec8b63?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=3fb8b944e67ae951ba92bb36ad03bb91 2x, https://si.imgix.net/ae6ddb8c/uploads/origins/53c38056-f4f8-4d41-afa5-a33a24ec8b63?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=4ffa9181acb471d364680b0f3549ef7a 3x"}, "private": true, "genre": "art", "tipped": false, "creator_id": 2657748, "client_id": 3179306, "nc": 144}, {"path": "/@mizo_167/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2657748, "client_id": 3319057, "vtt_url": null, "thumbnail_image_urls": {"src": "http