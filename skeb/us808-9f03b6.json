gins/311a10e0-125a-4bfd-b6b1-d7624bbdc2b0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c3b1d59a063389c77c324e21a0c81db3 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/a611166f/uploads/origins/311a10e0-125a-4bfd-b6b1-d7624bbdc2b0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b51cd0b85e97be3840f85cddfa1454c4", "srcset": "https://si.imgix.net/a611166f/uploads/origins/311a10e0-125a-4bfd-b6b1-d7624bbdc2b0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b51cd0b85e97be3840f85cddfa1454c4, https://si.imgix.net/a611166f/uploads/origins/311a10e0-125a-4bfd-b6b1-d7624bbdc2b0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=556bc572cb2cf540de0e2b31dbfb01bb 2x, https://si.imgix.net/a611166f/uploads/origins/311a10e0-125a-4bfd-b6b1-d7624bbdc2b0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=ac8e20aee47dbc41a17aaa6c361ffdac 3x"}, "body": "お疲れ様です！蟷螂です。\nいつもお世話になっております。\n\n以前うすいさんに回してもらったCoCシナリオに連れてった自PC「綾部小雨」をお願いしたいです。\n彼女は宮城県出身という設定があるのですが、宮城県石巻市には「田代島」という猫がいっぱいいる、所謂「猫島」と呼ばれる島がございます。\nシチュエーションとしては「撮影の為に田代島を訪れたところ、漁港で大勢の猫に囲まれて困り顔だけど満更でもない小雨」を描いていただきたいです。\nポーズや猫の量はお任せいたします。神話的事象に巻き込まれてばかりの彼女を癒やしてあげてください。\n\nキャラデザの参考立ち絵も置いておきます。\nhttps://1drv.ms/i/s!AvGWx01XiMMnnQRSg_y-3qdJ9Y1h?e=4sZC7G\n\n以上、よろしくお願いします！", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@us808/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1812892, "client_id": 347208, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/825bcff5/uploads/origins/94d8a5f9-0991-4920-9199-485d7e730856?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=befed8e5546f75830c8dcb9cbc51f770", "srcset": "https://si.imgix.net/825bcff5/uplo