n\n加えて、ちょっとしたセリフもあったらいいなと思います。 \nどんなセリフを入れるかはお任せします。ありがとうございます！", "nc": 49, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@koizumo_/works/9", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/5d5329f0/uploads/origins/4ea809e1-d706-4c92-97ab-6400c7735041?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=f59144249cb43085ec7452aa08a67d3f", "srcset": "https://si.imgix.net/5d5329f0/uploads/origins/4ea809e1-d706-4c92-97ab-6400c7735041?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=f59144249cb43085ec7452aa08a67d3f, https://si.imgix.net/5d5329f0/uploads/origins/4ea809e1-d706-4c92-97ab-6400c7735041?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=a06cd0feea131ea7a3a0adf3779bc7d1 2x, https://si.imgix.net/5d5329f0/uploads/origins/4ea809e1-d706-4c92-97ab-6400c7735041?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=d3cac151d42213bc2b2eb5f69d81f45e 3x"}, "private": true, "genre": "art", "tipped": false, "creator_id": 463783, "nc": 129}, {"path": "/@koizumo_/works/8", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 463783, "client_id": 148523, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/474855cd/uploads/origins/7bd57995-bbd0-4104-9d2b-e62333a2c3ba?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9cf0f19f42ad69dbd1814244636ca1aa", "srcset": "https://si.imgix.net/474855cd/uploads/origins/7bd57995-bbd0-4104-9d2b-e62333a2c3ba?bg=%23fff&auto=format%2Ccom