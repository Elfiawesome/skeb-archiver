g=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=1377b722324e3d805fa1b16eff76e00e, https://si.imgix.net/955027fe/uploads/origins/1096cc73-1eb5-43d1-920e-e1a426d915af?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=73fa1e69953212c3a9145bd8d4116ff7 2x, https://si.imgix.net/955027fe/uploads/origins/1096cc73-1eb5-43d1-920e-e1a426d915af?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=c458ac9b07502a99cf1ac92e25c36378 3x"}, "body": "小出雲先生\n初めまして。黒檜と申します。\n和風な作風がとても好きで、リクエストさせて頂きました。\nもしよろしければ、雷雲に棲み激しい雷雨をもたらす雷神が、もし可愛らしい少女だったら…という内容で、先生の好きなように描いていただけませんでしょうか。\n二本角で黒髪の姿ですと有り難いです。\nもし可能であれば、以前先生が描かれていた屠自古ちゃんのイラストのようなイメージで、その雷神娘ちゃんが雷雲の中で雷をもたらすのを、少し嗜虐的に楽しんでいる様子だと有り難いです。\n是非ご検討頂けますと幸いです。", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@koizumo_/works/13", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 463783, "client_id": 104478, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/353ede13/uploads/origins/f4266a0e-cfe3-45c9-877c-d5879325bdf2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3e29ed5b1f1e82e86b225875f8af9aa6", "srcset": "https://si.imgix.net/353ede13/uploads/origins/f4266a0e-cfe3-45c9-877c-d5879325bdf2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3e29ed5b1f1e82e86b225875f8af9aa6, https://si.imgix.net/353ede13/uploads/origins/f4266a0e-cfe3-45c9-877c-d5879325bdf2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=061c16de2898d33407c91c99262d6824 2x, https://si.imgix.net/353ede13/uploads/origins/f4266a0e-cfe3-45c9-877c-d5879325bdf2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=805be1c35039abdf219bf58c0a4ad7b2 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/353ede13/uploads/origins/f4266a0e-cfe3-45c9-877c-d5879325bdf2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=741c8533a1291b8a18b681770487b1d5", "srcset": "https://si.imgix.net/353ede13/uploads/origins/f4266a0e-cfe3-45c9-877c-d5879325bdf2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=741c8533a1291b8a18b681770487b1d5, https://si.imgix.net/353ede13/uploads/origins/f4266a0e-cfe3-45c9-877c-d5879325bdf2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=a9fb2e019dfc31d0d7f0eb49f77bba4b 2x, https://si.imgix.net/353ede13/uploads/origins/f4266a0e-cfe3-45c9-877c-d5879325bdf2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=0617b0bf8aaaf7a2383f93b80484c001 3x"}, "body": "和風創作のイラストに惚れました。オオゲツヒメなどストーリー性のあるイラストも描けることを見込んでお願いします。\n\n自創作『Project Nilarth』より農耕神ミホノメ（御穂之女）とクシケノイナリ（奇食之稲荷）の2柱のデザインをお願いします。\n以前自分でデザインしてみたはいいものの、色合いやデザインに納得がいかず、依頼させていただいた次第です。\n\n二柱は和風の世界観を持つ大陸「アケトキワ」の農耕神であり、お互いがお互いの伴侶です。\n\nミホノメは優しくも威厳があり、清廉で包容力のある女性です。\n元は泥の精霊でしたが、人々が望むのならと、現在は巫女をより豪華にしたような姿をとっています。\n\nミホノメは自身を象徴するアイテムとして、「斉意宝珠」を持っています。\nこれは如意宝珠のようですが、同じ願いを持つ人数に比例して願いを叶えられる規模や精度が上昇するというものです。\nこれはミホノメとクシケの家紋的なシンボルにもなっています（これも何かよい案があればデザインしていただけるとありがたいです）。\nただし、宝珠の力は乱発できないため、それ以外の時は神楽鈴を使います。ただし、紐は薄黄、緑、紫の3色です（アケトキワの設定と関連するものです）。\n\nクシケノイナリは白い毛並みの、オスの九尾の狐です。\nミホノメとセットで祀られる神であり、農耕神の遣いとしての狐の始祖です。\n9本の尻尾を寄せた間から様々な穀物が湧き出ると伝えられていますが、実際はこうｍ…ｹﾞﾌﾝｹﾞﾌﾝ\n伝えられる話はオブラートに包んでいますが、少年たちはこの事を知ると堂々と話したくなるのが世の常です。\n\n背景は地平線まで稲穂が広がる農地です。アケトキワは現実の日本より平坦な地形であるという設定だけ理解していただければ、他に何かあっても構いません。\n雰囲気は二柱が存在するだけで何か特別な事が起こるといった感じです。例えば、エ霞文や瑞雲のような柄が現実の雲や霞として出現しているかもしれません。\n\n背景と各人物を分けたファイルがあると嬉しいです。\n\n資料は2つあります。↓は彼らの世界観のイメージ、もう一方はミホノメとクシケ本人のものです。\n必要な設定も一通り説明しているため、しっかりご確認ください。\nhttps://imgur.com/a/6RJm8J0\n\nhttps://imgur.com/a/DUAqo2O", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@koizumo_/works/12", "private_thumbnail_image_url