11ccf6-fa8f-45b9-8069-b0f5e76f934d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b3a4d77b25791c66887a3b6418d7102b, https://si.imgix.net/8f77064b/uploads/origins/6811ccf6-fa8f-45b9-8069-b0f5e76f934d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=767ca5d2301f95d346087ffee7329645 2x, https://si.imgix.net/8f77064b/uploads/origins/6811ccf6-fa8f-45b9-8069-b0f5e76f934d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d669739a677139db7253f2448d4058d0 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/8f77064b/uploads/origins/6811ccf6-fa8f-45b9-8069-b0f5e76f934d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f336eacc5efdc7a51e7938a675da4f75", "srcset": "https://si.imgix.net/8f77064b/uploads/origins/6811ccf6-fa8f-45b9-8069-b0f5e76f934d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f336eacc5efdc7a51e7938a675da4f75, https://si.imgix.net/8f77064b/uploads/origins/6811ccf6-fa8f-45b9-8069-b0f5e76f934d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=18b4627a1d8315446c12c0e7923baabc 2x, https://si.imgix.net/8f77064b/uploads/origins/6811ccf6-fa8f-45b9-8069-b0f5e76f934d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=5ddfc5d1972a2fb40a1acb1b0f73ab75 3x"}, "body": "はじめまして。先日Xにポストなさったカシアキちゃんのイラストがとてもかわいくて私も描いてほしい…！！ ”ぽりぽり乙女”とのギャップすごい…！すき…！と感激し依頼させていただきました。\n\n「乙女タロットカード「愚者」のヒデアキちゃん」をお願いします。\n\n・もし戦国乙女がタロットカードになったら…夢見て旅する若者である「愚者」が、まだまだ成長の過程にあるヒデアキちゃんにぴったりな気がする！という妄想です。(愚か者という事ではないです！汗)最近よく聞いている徳永のヒデアキさんの曲「夢を信じて」からも着想を得ました。\n\n・全年齢です。\n・タロットカードの愚者にあてはめてヒデアキちゃんをいただければ幸いです。ヒデアキちゃんが胸(気持ちを)を弾ませながら旅をしているイメージです。\n\n・衣装　いつものピンクの花柄の着物が好みです。複雑で大変なので柄の簡略化、又は他の衣装を着せる等描きやすくしていただいて結構です。\n・兜のカチューシャを装着していると嬉しいです。\n・表情　ヒデアキちゃんがえへへ〜とにっこりしている(呑気、気が緩んでいる)表情だと嬉しいです。\n・小物　愚者の持っている棒と鞄を持たせてあげてください。鞄の色は黒と赤がい