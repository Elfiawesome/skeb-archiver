oads/origins/a2e1c5a7-57ae-4c64-8b60-8f2d35613d6e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=88228b24d9a45f88a19cda44325bab6c", "src_set": ""}, "body": "玲架様初めまして、猫田ネコ丸と申します。\nTwitterの募集ツイートを拝見し是非お願いしたいと思い依頼しました\n\n今回描いていただきたいキャラクターは私のアイコンになっている子をお願いします。\n参考資料として私のアイコンや送信したリクエストのページを見ていただけると幸いです、またキャラクターの特徴の参考として青系色のマニキュア、眼鏡着用(形や色は固定の指定無し)、基本的には明るいイメージが主なものとしてあります。\n\n玲架様のツイートにある「キャラクターの抽象CG」の作成をお願いします、明るい雰囲気で自由に作ってもらえると嬉しいです。\n\n主な利用用途としてスマホやPCでの壁紙として使用します。\n\nご検討よろしくお願いします。", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@rei__k/works/7", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/4c689cfc/uploads/origins/09ffb180-6770-4feb-a5d5-6258a7e7c007?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=5458c5bb5b16ece6b722f259c90f9598", "src_set": ""}, "private": true, "genre": "art", "tipped": false, "creator_id": 227061, "client_id": 0, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 144, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@rei__k/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 227061, "client_id": 3690480, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/186ab398/uploads/origins/9b0d6080-285c-4799-b330-5fa35f79649a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8c942de58893d1c779ac1ef03d5f09b7", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/186ab398/uploads/origins/9b0d6080-285c-4799-b330-5fa35f79649a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9d4f771a124c47e33d215cfd6dc98923", "src_set": ""}, "body": "はじめまして。いつも素敵な作品を拝見しております。\n玲架さんの作品に漂う空気感や色使い、世界観が本当に好きで、ずっとファンです。\n\n実は、玲架さんの作品に強く憧れて、自分もCinema4Dを使い始め、現在はライブ映像の背景演出の仕事に携わっています。\nいつかご一緒できるようなクリエイターになれるよう、日々努力を重ねています。\n\n今回、Xでのポストを拝見し、ぜひお願いしたくSkebにて依頼させていただきました。\n\nVtuberの「一ノ瀬うるは」さんをモチーフにした、抽象的なCG壁紙を制作いただけないでしょうか？\n\n・構図・背景は自由にお任せいたします\n\n大好きなうるはさんと、尊敬する玲架さんの表現が重なる一枚をぜひ拝見してみたいです。\nご検討いただけましたら幸いです。どうぞよろしくお願いいたします。", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@rei__k/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 227061, "client_id": 178504, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/dd5f3495/uploads/origins/cdc871d5-75d8-4bd8-bf48-2be5617fb048?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5116182bf0f6ebf9b0b5c3519ba4eaf0", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/dd5f3495/uploads/origins/cdc871d5-75d8-4bd8-bf48-2be5617fb048?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a406ad886d2b21014e3d0d180ba3235c", "src_set": ""}, "body": "玲架様\n\nはじめまして。kaitoyamaと申します。\nいつも、作成されるCG、本当に大好きです!\n\n□希望\n本当にどの作品も大好きなのですが、\nhttps://x.com/rei__k/status/1867483940396900858/photo/1\nhttps://x.com/rei__k/status/1646738761613729797/photo/1\nhttps://x.com/rei__k/status/1613863081691738113/photo/1\n\nのような明るくカラフルというよりは、黒にいくつかの色でスタイリッシュのような方向性でお願いできると嬉しいです。\n\n□用途\nPCの壁紙\n\nご検討よろしくお願いいたします！", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@rei__k/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 227061, "client_id": 3690190, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/3ceb53cc/uploads/origins/c75f969e-dcb7-4508-aca9-745a761666bd?bg=%23fff&auto=format%2Ccompress