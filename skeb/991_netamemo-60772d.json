ble_same_genre": true}, {"path": "/@991_netamemo/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 117414, "client_id": 1627706, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/6ab1307f/uploads/origins/62c7b180-5a48-4b2c-a418-21cc5bba02db?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=30db408f68d70c58d946e55eb1a250ac", "srcset": "https://si.imgix.net/6ab1307f/uploads/origins/62c7b180-5a48-4b2c-a418-21cc5bba02db?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=30db408f68d70c58d946e55eb1a250ac, https://si.imgix.net/6ab1307f/uploads/origins/62c7b180-5a48-4b2c-a418-21cc5bba02db?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=3325906c8c188702d9557bfbc6a2bf78 2x, https://si.imgix.net/6ab1307f/uploads/origins/62c7b180-5a48-4b2c-a418-21cc5bba02db?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c9a5871958a32db5769a1ae7e99d4496 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/6ab1307f/uploads/origins/62c7b180-5a48-4b2c-a418-21cc5bba02db?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=621d0eaaa4288bd48e090c498364de15", "srcset": "https://si.imgix.net/6ab1307f/uploads/origins/62c7b180-5a48-4b2c-a418-21cc5bba02db?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=621d0eaaa4288bd48e090c498364de15, https://si.imgix.net/6ab1307f/uploads/origins/62c7b180-5a48-4b2c-a418-21cc5bba02db?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=87c1273d376e396d5f4009d958c4155c 2x, https://si.imgix.net/6ab1307f/uploads/origins/62c7b180-5a48-4b2c-a418-21cc5bba02db?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=b7a53b2dc86cd2feaab6f85498d9c5cd 3x"}, "body": "平素よりお世話になっております。くくいち様にリクエストしたいイラストがあり、ご連絡をいたしました。内容等は以下の通りです。\n\n[リクエスト内容]\n・フルカラーイラスト：1点\n　∟クトゥルフ神話TRPGのPCである四名（華厳 鬼百合、華厳 桐、華厳 穂、華厳 マキ）が描かれているイラスト。（※各プレイヤー様方にはご自身のPCの使用について予め承諾を頂いております。\n\n[イラストのシチュエーション]\n・華厳 鬼百合、華厳 桐、華厳 穂、華厳 マキの四名が共同生活をしている場合の朝の風景。（4人とも同じ空間にいる体です。また、各PCの行動例は以下に記しております）\n・可能であればイラストのどこかに4人分のお弁当箱を添えて頂けたら、と思います。ただ、視点の関係等で難しい場合は、なくとも問題ありません。\n \n[四名の朝の行動例]\n・華厳 鬼百合：お皿の準備、穂さんの手伝い、新聞を見ている。\n・華厳 桐：桐さんにつきましては、くくいち様が考える朝の桐さんの様子を描いていただけますと幸いです。\n・華厳 穂：朝食を作っている、食器に料理を盛り付けている、盛り付けた料理を食卓に並べている。\n・華厳 マキ：寝ぼけ眼で食卓に座っている、苦手な食べ物と睨めっこしている、いずれかの兄に寄りかかって寝ている。\n\n※これらはあくまで例ですので記載のない行動をしていても問題ありません。\n\n　以上となります。ご検討のほど、よろしくお願いいたします。", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 130379, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "𝕤𝕚𝕟𝕠*┊", "screen_name": "yoiyami_c", "avatar_url": "https://pbs.twimg.com/profile_images/1756195348299845632/2styIiOE.jpg", "header_url": "https://pbs.twimg.com/profile_banners/3265522058/1697083882/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 120, "skills": [{"genre": "art"}], "banned": false, "nc": 161}, {"id": 436404, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "くりおね", "screen_name": "kurione0608", "avatar_url": "https://pbs.twimg.com/profile_images/3607544053/4cf7ddd890da0f277750f1eae6344c74.jpeg", "header_url": null, "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "art"}, {"genre": "correction"}], "banned": false, "nc": 177}, {"id": 1104723, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "タヌキマン@skeb募集中🌏", "screen_name": "sakanam