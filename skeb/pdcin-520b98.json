fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=86d63a276abfea2e1d5baaa88255d550", "srcset": "https://si.imgix.net/5556515e/requests/124610_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=86d63a276abfea2e1d5baaa88255d550, https://si.imgix.net/5556515e/requests/124610_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=640988515b8f31829f9f54098dd28a46 2x, https://si.imgix.net/5556515e/requests/124610_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=0a1fe5b3f786b9c786f8a9e626500773 3x"}, "body": "初めまして、凄く繊細かつ美しいアレキくんに惚れリクエストしました！\nウチの子案件なのですが、良ければお願いします。\n\n●ウチの子\n資料URLの朗くん。\n女装が趣味の美少年（年齢や体格は先生のお好みな感じで描写してください）で、母親に隠れてコスプレや時には同性愛も楽しんでいる。\nエッチな事が大好き。\n\n●衣装\nこちら↓の衣装（魔境のスカサハ）をコスプレしている、ウィッグは無しで髪型は普段のまま。\nhttps://auctions.c.yimg.jp/images.auctions.yahoo.co.jp/image/dr000/auc0406/users/5f61ba61adbe92f4f5653a342f99b9515997714c/i-img399x500-15282860847qjxyk431577.jpg\n\n●シチュ\n下記の２つから、先生のお好きな方を\n1・コスプレをして、モブおじさんに後ろからスカートの中に手を入れられペニスを手で扱かれ悦んでいる。\n2・自室でポーズをつけ、可愛い自分に恍惚としている。\n\nよろしくお願いします。\n\nhttps://twitter.com/er114_k/status/1296568378312675328?s=21", "nc": 48, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@pdcin/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 17823, "client_id": 76621, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/9086f9b1/requests/97256_1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fdf0f3a84c37669d8ce77afdee85f51c", "srcset": "https://si.imgix.net/9086f9b1/requests/97256_1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fdf0f3a84c37669d8ce77afdee85f51c, https://si.imgix.net/9086f9b1/requests/97256_1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=971918259bf163b2ea69466116de7a1f 2x, https://si.imgix.net/9086f9b1/requests/97256_1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=678673ff94862af87b810205e2456a50 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/9086f9b1/requests/97256_1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=fb7b7a88976cc9c98aaa9e0435de0ade", "srcset": "https://si.imgix.net/9086f9b1/requests/97256_1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=fb7b7a88976cc9c98aaa9e0435de0ade, https://si.imgix.net/9086f9b1/requests/97256_1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=ccf01dd8dda114b08e4649e541ace5ff 2x, https://si.imgix.net/9086f9b1/requests/97256_1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=f6b86c22d2f0167b3c0978c19d15e88a 3x"}, "body": "はじめまして。HRSと申します。\nFGOのアレキくんがセーラーマーズのスーツ姿で騎乗位しているところをリクエストしたいのですが、可能でしょうか？\n下記のリクエスト内容をご確認頂き、ご判断下さい。\nどうか宜しくお願い致します。\n\n【リクエスト内容】\nFGOのアレキくんがセーラーマーズのスーツ姿で背面騎乗位している姿を正面から見た構図。\n①足はM字開脚のような感じ。つま先まで入りきらなくても大丈夫です。\n②セーラースーツは本来、レオタードにスカートが付いているデザインですが、少し変更して頂きたいです。\n・上半身は胸の下辺りから腰までのお腹周りは露出している。\n・スカートの下は白い下着になっていて、丸まった下着が左足の太ももに巻き付いている。\n※セーラースーツのデザイン変更の資料URLを貼っておきますので、ご参照頂ければと思います。\n③右手は自分のペニスを扱いていて、左手は後ろについて状態を反らしているような感じ。\n　ペニスは少し大きめで、先っぽからカウパーが垂れている状態にしてほしいです。\n④表情は気持ち良くて堪らない感じで、瞳の中にハートマークを入れてほしいです。\n　また、少し顔を赤らめている感じにしてほしいです。\n⑤背面騎乗位なので下に男性がいますが、その男性の姿はほぼ入り込まなくていいです。\n　ただ、アレキくんのしなやかな腰を掴んでいる両手は描いてほしいですが、構図的に難しければ無くても構いません。\n⑥もし可能であれば、セリフも入れて頂けると大変ありがたいです。\n　あくまでも「もし可能であれば」で無くても全く問題ありませんので、無理に入れて頂く必要はございません。\n\nhttps://www.pixiv.net/artworks/76992137", "nc": 185, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@pdcin/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 17823, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/005325ae/