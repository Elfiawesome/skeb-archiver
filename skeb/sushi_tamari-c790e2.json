e93/uploads/origins/a3daeb2b-52c6-4c57-9acb-479d16572079?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=31d273a2f065698f3889a3cede806441", "srcset": "https://si.imgix.net/d8761e93/uploads/origins/a3daeb2b-52c6-4c57-9acb-479d16572079?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=31d273a2f065698f3889a3cede806441, https://si.imgix.net/d8761e93/uploads/origins/a3daeb2b-52c6-4c57-9acb-479d16572079?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=5d167360d73a867ceea6ddcc56c76ca4 2x, https://si.imgix.net/d8761e93/uploads/origins/a3daeb2b-52c6-4c57-9acb-479d16572079?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=6e4f7501835572d237a4b2c14f03d1b0 3x"}, "body": "初めまして、某discordサーバーから来ました。\nニーアオートマタのパスカルを描いていただきたいです。\n背景は描いていただけるのであればこちら https://www.jp.square-enix.com/nierautomata/#world から好きな場所を選んでもらえたらと思います。全然違っても大丈夫です。\n\nhttps://www.jp.square-enix.com/nierautomata/character/#id08", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": []}, "price_history": {"art": [{"amount": 9000, "recorded_at": 1757819332.159619}, {"amount": 15000, "recorded_at": 1771230299.426315}], "correction": [{"amount": 5000, "recorded_at": 1757819332.159619}, {"amount": 3000, "recorded_at": 1771230299.426315}]}, "custom": {"from_archive": true}}