h=200&blur=200&s=bcf69c76f8601d8291f3da110500b7ef", "srcset": "https://si.imgix.net/0994e302/uploads/origins/601b1ea3-5bfa-43b5-ba02-6f0e45d37b58?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=bcf69c76f8601d8291f3da110500b7ef, https://si.imgix.net/0994e302/uploads/origins/601b1ea3-5bfa-43b5-ba02-6f0e45d37b58?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=e77bc67310a527baed14865da0777fd7 2x, https://si.imgix.net/0994e302/uploads/origins/601b1ea3-5bfa-43b5-ba02-6f0e45d37b58?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=32a687ab9491a817776ae78199b619db 3x"}, "body": "長岡キヘイ様\n\nはじめまして。Discordにてお見かけし、リクエストさせて頂きました。\n\n【依頼内容】\n背景メインでオリジナルキャラクターのイラストをお願いしたいです。\n\n(背景、構図)\n背景は廃ホテルでお願いします。屋内、建物外観、どちらでも大丈夫です。人が立ち寄らず、荒れ果てた廃ホテルでキャラクターがタバコを吸っている…といったイメージです。細かい構図やポーズ等はお任せします。\n\n(キャラクターの外観)\n・男性\n・青いスーツ、水色のベスト、緑のネクタイ\n・ジャケットの前は閉めない\n・黒髪、センター分け\n・喫煙者\n\n背景メインのため、キャラクターはオマケ程度でも構いません。(シルエットのレベルでも可)\n参考資料を下記リンクに添付しております。ご参考になりましたら幸いです。\n\n【使用用途】\n個人での鑑賞\n\n依頼に際して長岡キヘイ様のX、Pixivを拝見し、描き込まれた背景の立体感、空気感の表現がとても素敵だったため背景メインでの依頼とさせて頂きました。\nこれは余談なのですが、以前よりキヘイ様のLINEスタンプを愛用しております。 無表情で意思疎通するマン、ユニークで使いやすくてかわいいです! Discordでお見かけした時、まさかこんな形で作者様にお会いできるとは…! と嬉しくて、今回リクエストさせて頂きました。\n何か問題がありましたら、再送依頼またはキャンセルにてご対応お願いします。\n\n長くなりましたが、ここまでお読みくださりありがとうございました。\n何卒ご検討の程よろしくお願い致します。\n\nhttps://drive.google.com/file/d/1apOcd-nlp8NwaylXida1aNusXI3F-x1E/view?usp=drivesdk", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@sushi_tamari/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "correction", "tipped": false, "creator_id": 2803110, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/f16c5fbe/uploads/origins/373cc73e-3fa3-43ad-9d88-5a6e0bddbd1a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=536c176e8c30a6864033462f4e66a39f", "srcset": "https://si.imgix.net/f16c5fbe/uploads/origins/373cc73e-3fa3-43ad-9d88-5a6e0bddbd1a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=536c176e8c30a6864033462f4e66a39f, https://si.imgix.net/f16c5fbe/uploads/origins/373cc73e-3fa3-43ad-9d88-5a6e0bddbd1a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=4dddda98a44d5d8e72d4ddef992ce523 2x, https://si.imgix.net/f16c5fbe/uploads/origins/373cc73e-3fa3-43ad-9d88-5a6e0bddbd1a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e509daec3bd747dcd9c6e879f7519592 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/f16c5fbe/uploads/origins/373cc73e-3fa3-43ad-9d88-5a6e0bddbd1a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e964e5d9906e9626fbced13d35618683", "srcset": "https://si.imgix.net/f16c5fbe/uploads/origins/373cc73e-3fa3-43ad-9d88-5a6e0bddbd1a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e964e5d9906e9626fbced13d35618683, https://si.imgix.net/f16c5fbe/uploads/origins/373cc73e-3fa3-43ad-9d88-5a6e0bddbd1a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=8c89f4e21589ef7f210dddadb1fdc2ed 2x, https://si.imgix.net/f16c5fbe/uploads/origins/373cc73e-3fa3-43ad-9d88-5a6e0bddbd1a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=9f329970f3100609d38b9fa58dcf2d29 3x"}, "body": "長岡キヘイ様\n\n某鯖でお世話になっております。\nイラストに関するアドバイスをお願いしたくご連絡いたしました。特定のイラストではなく、全体的な絵柄や特徴についてご意見をいただければ幸いです。イラストは資料URLに添付しております。\n\n①現在の状況\nデジタルイラストを描き始めて11年、イラストオーダーサイトでの活動は約2年になります（実質活動期間は1年ほど）。趣味として楽しんでおり、TRPGの立ち絵やオリジナルキャラクターを描いています。時々フリー素材としてイラストを配布しています。X（旧Twitter）のフォロワーは約60名で、投稿頻度は低く、あまり積極的には活動していません。\n\n②目指すところ\n自分の理想に近いイラストを描けるようになりたいです。描きたいものを自由に描ける画力をつけたいえす。また一方で誰かの役に立てたり、見た方が少しでも嬉しくなるような絵を描けたら嬉しいです。仕事として絵を描く意向はなく、フォロワーを増やすことにもあまり関心はありません。\n\n③お聞きしたいこと\n絵柄のジャンルについて\n私の絵柄を一言で表すと、どのようなジャンルになるでしょうか？（少女漫画風、BL風、GL風、特定のSNS風など）また、どのような層に好まれやすいでしょうか？\n\n作風について\n厚塗りと線画ありのアニメ塗りの2つの作風がありますが、どちらの方が魅力的に感じられますか？　線画が苦手なため厚塗りの方が得意ですが、好きなイラストはアニメ塗りの傾向が強く、上達したいと考えています。\n\n絵柄の長所と短所\n私の絵柄の長所と短所はどこにあると思われますか？　他者からは「色使いや世界観が素敵」と言われることが多く長所として捉えています。また短所ですが自己評価として光と影、肩周りのデッサンに苦手意識があります。\n\n完成度を高めるためには\n更にクオリティを上げるための具体的なポイントや、意識すべき点について教えていただけると嬉しいです。（長所短所と重複するようでしたら無視してください）\n\nオリジナリティの磨き方について\n私の強みや特徴をさらに引き出し自分だけの表現を確立するためには、どのようなことを意識すると良いでしょうか。\n\n以上、どうぞよろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/1eN6MeDEilFHyEI9HKhqd7J5BfQWLIP8g?usp=drive_link", "nc": 17, "word_count": 6952, "transcoder": "text", "creator_acceptable_same_genre": true}, {"path": "/@sushi_tamari/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2803110, "client_id": 634023, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/cb5af823/uploads/origins/211ca1fd-43ff-4897-9bb9-6df20bb8e2e9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0ad075b9adade6204c6df0ec66ce7a1d", "srcset": "https://si.imgix.net/cb5af823/uploads/origins/211ca1fd-43ff-4897-9bb9-6df20bb8e2e9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0ad075b9adade6204c6df0ec66ce7a1d, https://si.imgix.net/cb5af823/uploads/origins/211ca1fd-43ff-4897-9bb9-6df20bb8e2e9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=2dedf972a876268f6f2ada8a36529a8d 2x, https://si.imgix.net/cb5af823/uploads/origins/211ca1fd-43ff-4897-9bb9-6df20bb8e2e9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=183d6f6cbaaff6c9869ba38855f81576 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/cb5af823/uploads/origins/211ca1fd-43ff-4897-9bb9-6df20bb8e2e9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=917fd18ccde368223f016eac0125f6eb", "srcset": "https://si.imgix.net/cb5af823/uploads/origins/211ca1fd-43ff