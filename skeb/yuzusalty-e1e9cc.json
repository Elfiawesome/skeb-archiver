可能であれば、私たちの永遠の絆を記念する肖像画を描いていただけたら光栄です。夫は私たちが知り合ってからずっとFFXIVをプレイしていますが、私は昨年始めたばかりです。最近、ゲーム内で結婚式を挙げられるように、夫のサーバーにサーバー移転しました！愛し合う私たちの躍動感あふれる肖像画を描いていただけたら嬉しいです。リンク先にポーズのアイデアをいくつか載せていますが、最終的なポーズはお任せします。また、可能であれば、彼女の狐耳とベールも描いていただけるとありがたいです（どちらもゲーム内の頭部アクセサリーなので、両方を同時に写したスクリーンショットを撮ることができません）。\n\nhttps://drive.google.com/drive/folders/1idf_O0Q9sYHgxonUJeN1NhL6qWfISNIb\n\nhttps://drive.google.com/drive/folders/1WGPgQHK4YTV4mLV6sxcslrr9S4KCZlPb\n\nhttps://drive.google.com/drive/folders/1WGPgQHK4YTV4mLV6sxcslrr9S4KCZlPb", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@yuzusalty/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 4047388, "client_id": 2880416, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/61796081/uploads/origins/77517336-0ddb-41bb-8a1d-0caa08e53a92?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c28bdfd2955b0e1ddc932d9c57f40271", "srcset": "https://si.imgix.net/61796081/uploads/origins/77517336-0ddb-41bb-8a1d-0caa08e53a92?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c28bdfd2955b0e1ddc932d9c57f40271, https://si.imgix.net/61796081/uploads/origins/77517336-0ddb-41bb-8a1d-0caa08e53a92?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=32ec7ba7e95bed58d30f762c7927cb49 2x, https://si.imgix.net/61796081/uploads/origins/77517336-0ddb-41bb-8a1d-0caa08e53a92?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f68db163b0a27e18d9988eee103c7b87 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/61796081/uploads/origins/77517336-0ddb-41bb-8a1d-0caa08e53a92?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c8ac6ee9102a8d4029bb6919a000ab7b", "srcset": "https://si.imgix.net/61796081/uploads/origins/77517336-0ddb-41bb-8a1d-0caa08e5