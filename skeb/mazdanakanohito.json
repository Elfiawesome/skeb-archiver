//si.imgix.net/7e7150b2/uploads/origins/b096981c-6ae3-446d-8607-ab5301cbe962?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6b5b97bfc0756ca0c8e589ecf5c7b970", "src_set": ""}, "body": "またうちの子のイラストをお願いしたいです\n今回はおねショタ搾精シチュです\nうちの子がショタの顔を胸で挟みながら太ももコキしている\n胸は盛って欲しいです\nショタはモブです\nそれ以外はお任せしたいです\n\n資料\n\nhttps://xfolio.jp/portfolio/misaho_mi/works/1280627\nhttps://xfolio.jp/portfolio/misaho_mi/works/1280591\n\nよろしくお願いします", "nc": 184, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@mazdanakanohito/works/357", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 117490, "client_id": 19252, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/6159b453/uploads/origins/a225e7d7-7687-4c13-af66-37767cb55fd8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d26ea829184517b40788050eb6ddaf87", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": true, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/6159b453/uploads/origins/a225e7d7-7687-4c13-af66-37767cb55fd8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=7c6c8397cd11c108616e8d6d92ca4a04", "src_set": ""}, "body": "お久しぶりです！\n前々回の召喚失敗苗床をシリーズ化してもらいたいと思います！\nまたまた召喚に失敗して、馬の魔獣に襲われてしまい、孕まされた状態で発見！\nその後、出産を手伝うという感じのシーンをお願いします！\n〇いつものヨメちゃん\n〇大股開きで（所謂エロ蹲踞）\n〇あそこから馬の魔獣が生まれる瞬間（頭が出てる）\n〇できれば出産後の開ききったおまんこも欲しいです\nよろしくお願いします！", "nc": 43, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@mazdanakanohito/works/356", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 117490, "client_id": 238975, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/92c491f1/uploads/origins/6d0f673a-fecd-4d2c-a80e-2948a2b1a337?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=56b8e4c49723b9d12b3b3ac1b4d5440b", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/92c491f1/uploads/origins/6d0f673a-fecd-4d2c-a80e-2948a2b1a337?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c5c63c18ef6dbc751f6591082bbf294c", "src_set": ""}, "body": "お世話になっております\n\nジョロウさんのオスヨメちゃんマッサージネタが大変良かったので\nよろしければ最後のページのような構図で蟹ちゃんをのけぞり射精させるショタ淫魔君のイラストをお願いします\n\n蟹ちゃんを淫魔具羅や粘液手袋で玩具のように扱っておねだり声をいっぱい出させてほしいです\n\nよろしくお願いします", "nc": 40, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@mazdanakanohito/works/355", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/59eb2696/uploads/origins/bb5fef84-dba6-4c7b-a109-076ea240ddf1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=6aaa7c9f661af3cb0a40e7f07dd188f0", "src_set": ""}, "private": true, "genre": "art", "tipped": false, "creator_id": 117490, "client_id": 0, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 176, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@mazdanakanohito/works/354", "private_thumbnail_image_urls": null, "private": false, "genre": "comic", "tipped": true, "creator_id": 117490, "client_id": 0, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/f5169b42/uploads/origins/28949d58-7ed9-4a02-9b8c-78274a5283b1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=969f597c70f833aaa5ab977407b1068c", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/f5169b42/uploads/origins/28949d58-7ed9-4a02-9b8c-78274a5283b1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=26c53e6c05061a3db2cd9cbd0fcf7594", "src_set": ""}, "body": "お世話になっております。見せ合いNTR最高です！\n妻が夫と二人きりの状況で、人見知りもなく本気で夫にひょっとこフェラしまくる所をお願いしたいです。\nマツダ先生の許容の最上限の全力ひょっとこフェラをいっぱい見たいです！\n途中でイマラも（夫に頭を掴まれて強引にではなく、妻が夫の腰に抱き着いて自力で喉奥に根本まで突っ込んでいる感じで）挟んでもらえると嬉しいです。夫を何度も射精させて鼻や口から精液が漏れている感じで、口を窄めて唇の形が分かるのが大変エロかったので、唇強調の場面が多めだとありがたいです。\n夫目線の妻と目が合うカットがあると嬉しいです。よろしくお願いいたします。", "nc": 49, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@mazdanakanohito/works/353", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 117490, "client_id": 398841, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/1c6ef4ce/uploads/origins/b293f53f-b3c0-4fa3-95d7-0a70b71b3bf8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9961d680c31a2a7fe8d3b72cc6ec6116", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/1c6ef4ce/uploads/origins/b293f53f-b3c0-4fa3-95d7-0a70b71b3bf8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=60ac102557a9b3649453a4844e7d45f5", "src_set": ""}, "body": "◯キャラ\nhttps://x.com/er450935/status/1891778144744386988?s=46&t=XZhK0QAD7iWUFRfjngt36w\n\n◯イラスト\n全裸くぱぁ\nhttps://pbs.twimg.com/media/GnMf3mVbUAA_oju?format=jpg&name=large", "nc": 161, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@mazdanakanohito/works/352", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/a3b7bcea/uploads/origins/d1ee1b38-4fc0-4241-a896-acf92ef1d91d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=081ac48bb90e629475ceb84a183f454e", "src_set": ""}, "private": true, "genre": "comic", "tipped": false, "creator_id": 117490, "client_id": 0, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumb