うちの子は第五人格のオリジナルキャラハンターです。(OC x Canon です、フレデリックさんと)\n\nこの子　「熱心者」のキャラクターは落ち着いて大人ぶった態度を好み、誰に対しても優しく、人助けが大好きです。どんな問題でも、彼は常に耳を傾け、よく聞く「神のささやき」に基づいて助言を与えます。他人の心を操ることが大好きで、非常に独占欲が強いのです。\n彼の関係　:　ナザニールとイタカの遠い親戚(兄)です。\n\n彼の目は強膜がないです(マリーさんみたいな)\nそして彼の顔はひび割れたタイルのようです。\n\nSkepはじめてなのでどっち間違えたら申し訳ありません。\n\nhttps://drive.google.com/drive/folders/1xRaDZIEh4Pw1KuWgKaPEGLDmrTuYBhmF", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@hirrune/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3154763, "client_id": 3746027, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/d9986c65/uploads/origins/ab479ea3-d500-455c-b38d-8b254d50bc55?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=61335c9fe53ae34b4b8dfeb33b3ebbba", "srcset": "https://si.imgix.net/d9986c65/uploads/origins/ab479ea3-d500-455c-b38d-8b254d50bc55?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=61335c9fe53ae34b4b8dfeb33b3ebbba, https://si.imgix.net/d9986c65/uploads/origins/ab479ea3-d500-455c-b38d-8b254d50bc55?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=faf9ce9dc1c99d8740d9ee2b1809ee1c 2x, https://si.imgix.net/d9986c65/uploads/origins/ab479ea3-d500-455c-b38d-8b254d50bc55?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=cc6c7bcd6b26f974db02603bd2016367 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/d9986c65/uploads/origins/ab479ea3-d500-455c-b38d-8b254d50bc55?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5ecfcfb9a395d9a35b031a4942840025", "srcset": "https://si.imgix.net/d9986c65/uploads/origins/ab479ea3-d500-455c-b38d-8b254d50bc55?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5ecfcfb9a395d9a35b031a4942840025, https://si.imgix.net/d9986c65/upl