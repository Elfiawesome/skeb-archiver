0-568eb553ad7a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5686c41b1dcbc61ffd4e371aff683b05, https://si.imgix.net/1116a5d6/uploads/origins/e2e42084-664d-483a-8e50-568eb553ad7a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=3420e2ba989b43eb294c65b7e35300ff 2x, https://si.imgix.net/1116a5d6/uploads/origins/e2e42084-664d-483a-8e50-568eb553ad7a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b527bfbea78d53cb5b8e2bf36888c26a 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/1116a5d6/uploads/origins/e2e42084-664d-483a-8e50-568eb553ad7a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5589cec43923a837ebdcd3efb081b9c9", "srcset": "https://si.imgix.net/1116a5d6/uploads/origins/e2e42084-664d-483a-8e50-568eb553ad7a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5589cec43923a837ebdcd3efb081b9c9, https://si.imgix.net/1116a5d6/uploads/origins/e2e42084-664d-483a-8e50-568eb553ad7a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=12907fef0e6feab90b7a8961024f135a 2x, https://si.imgix.net/1116a5d6/uploads/origins/e2e42084-664d-483a-8e50-568eb553ad7a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=6801e20c605d3343a7255146ac161ac3 3x"}, "body": "先日は素晴らしいイラストをありがとうございました。イラストの依頼をさせて下さい。\n\n今回は『トゥルーラブストーリー』からみさきと君子の妹コンビの体操服姿（公式の体操服＆ブルマー）をお願いします。\n\n元気いっぱいで飛び跳ねているイラストを描いて下さい。\nいつも通り、ブルマーのサイズは少し小さめで、お尻に食い込みぎみにして下さい。お尻がよく見える構図でお願いします。\nお尻が見えてても気にしない！というような可愛らしい表情で描いて下さい。\n\nどうかよろしくお願いします。", "nc": 137, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@katsuramori/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1181430, "client_id": 2915207, "vtt_url": null, "thumbnail_image_urls": {"