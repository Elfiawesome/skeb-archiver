うか。\n早速ですが、本日は、リクエストがしたくお便り差し上げました。\n\nとか言いつつこれとこれとこれとこれとこれの中からどれ描いてもらおう…………で悩みまくって数日経ちそうな勢いだったのであみだくじで決めました。\n拙宅の野木風希が休日に杜若暮月時くんを遊びに連れ出しているところが見たい！！！です！！！！！愚息は休日色んな場所に出掛けるため場所の指定は致しません。細かいシチュエーション等お任せします。\n\n日ごとに暑さも増しておりますが、我々もお互い死なない程度に夏を迎えそして乗り切りましょう。Have a nice day.\n敬具", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@4ma_0806/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1223656, "client_id": 1249315, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/9ed492e6/uploads/origins/e72cd7de-c527-4f6a-9240-acd9b386ca8e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ec05d2abf66880b7f46fe8b33642b3e9", "srcset": "https://si.imgix.net/9ed492e6/uploads/origins/e72cd7de-c527-4f6a-9240-acd9b386ca8e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ec05d2abf66880b7f46fe8b33642b3e9, https://si.imgix.net/9ed492e6/uploads/origins/e72cd7de-c527-4f6a-9240-acd9b386ca8e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=26739118db030f174b7960b8bb012a30 2x, https://si.imgix.net/9ed492e6/uploads/origins/e72cd7de-c527-4f6a-9240-acd9b386ca8e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d5e4b633e4d5ef2043fbeddeea10ab0b 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/9ed492e6/uploads/origins/e72cd7de-c527-4f6a-9240-acd9b386ca8e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3125c42222d0654af4dbaafa5f21e0af", "srcset": "https://si.imgix.net/9ed492e6/uploads/origins/e72cd7de-c527-4f6a-9240-acd9b386ca8e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3125c42222d0654af4dbaafa5f21e0af, https://si.imgix.net/9ed492e6/uploads/origins/e72cd7de-c527-4f6a-9240-acd9b386ca8e?bg=%23fff&auto=format%2Ccompress&fm=webp