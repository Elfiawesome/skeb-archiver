e7e7-4780-9057-64c4169b2bc4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=86feaaf3cb0c6f33f77649713443b63d, https://si.imgix.net/28e478f4/uploads/origins/f5cafede-e7e7-4780-9057-64c4169b2bc4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=a0eedc85db56e1ab1b9a8d327e51e4b3 2x, https://si.imgix.net/28e478f4/uploads/origins/f5cafede-e7e7-4780-9057-64c4169b2bc4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=00c494545b868fca836966d79be2ea7c 3x"}, "body": "艦隊これくしょんのボテ腹イラストをお願いします。\n\n・キャラは海防艦の鵜来または稲木（見た目が好みな方、描きやすい方で構いません）\n・服装は公式グラの青い制服、もしくはマイクロビキニ\n・背中に背負っている船のパーツや持っている砲塔などは描写不要です\n・作中の触手敵キャラである深海忌雷の卵を妊娠しボテ腹の状態\n・妊娠に伴い乳首から母乳が漏れている（制服の場合、乳首の周りが濡れている）\n・女の子座りで、荒く息を吐きながら蠢く卵がもたらす感覚に耐えている\n・表情はお任せします（ボテ腹で快感を得ているのか、苦しい顔をしているのか等）\n\nよろしくお願いします。", "nc": 40, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Nagatatuzin/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 4087238, "client_id": 3179181, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/89672cf1/uploads/origins/3bf11dae-54f2-4fff-b281-80107e111fc3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0126004f31a87555cdb8e54f04c04038", "srcset": "https://si.imgix.net/89672cf1/uploads/origins/3bf11dae-54f2-4fff-b281-80107e111fc3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0126004f31a87555cdb8e54f04c04038, https://si.imgix.net/89672cf1/uploads/origins/3bf11dae-54f2-4fff-b281-80107e111fc3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=007bc4941d016114e2782326199c5ca1 2x, https://si.imgix.net/89672cf1/uploads/origins/3bf11dae-54f2-4fff-b281-80107e111fc3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c5f2c663313e633a8f8133d676bae72c 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/89672cf1/uploads/origins/3bf11dae-54f2-4fff-b281-80107e111fc3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=8a3edd5b74ccb380fc488ce336fdc3a2", "srcset": "https://si.imgix.net/89672cf1/uploads/origins/3bf11dae-54f2-4fff-b281-80107e111fc3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=8a3edd5b74ccb380fc488ce336fdc3a2, https://si.imgix.net/89672cf1/uploads/origins/3bf11dae-54f2-4fff-b281-80107e111fc3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=81258355bf26d966fee73fa5239b6ee3 2x, https://si.imgix.net/89672cf1/uploads/origins/3bf11dae-54f2-4fff-b281-80107e111fc3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=ff52fde8806d524f1f622db6302e3c90 3x"}, "body": "こんにちは！あなたの作品が大好きで、お願いがあるのですが。アニメ『アクアトープ』のククルとフウカが、ヴァキータの赤ちゃんを妊娠している姿を描いていただけませんか？ フウカはすごく恥ずかしがって、顔を赤らめています。ククルは汗をかきながら、緊張した笑顔を浮かべています。生まれたばかりのヴァキータの体重は9kgあるため、お腹は五つ子の妊娠が予定日を過ぎた状態と同じくらい、非常に大きくなっています。通常版とレントゲン版の2種類を描いてください。その他の詳細はご自由に。背景は不要です。\n\nククル：https://drive.google.com/file/d/1Onp43e5tXzcdpSoKAsGb1iq4ub03k0Ru/view?usp=sharing\nフウカ：https://drive.google.com/file/d/1ZEFYOV_zCmZ_4kiHUcbpXAkYEQ5ILv5m/view?usp=sharing\nヴァキータ：https://drive.google.com/file/d/1otsjmNBuF5I5yq8IJcJXzli2qVsT5zMD/view?usp=sharing", "nc": 40, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Nagatatuzin/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 4087238, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/93736f44/uploads/origins/1d9b2413-a56d-4348-baf2-9afd4c612aae?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=79c36123795a6a3f61a2f7dcfa88ccc5", "srcset": "https://si.imgix.net/93736f44/uploads/origins/1d9b2413-a56d-4348-baf2-9afd4c612aae?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=79c36123795a6a3f61a2f7dcfa88ccc5, https://si.imgix.net/93736f44/uploads/origins/1d9b2413-a56d-4348-baf2-9afd4c612aae?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f92270f47bfab9b57ee896ab6b29f0d9 2x, https://si.imgix.net/93736f44/uploads/origins/1d9b2413-a56d-4348-baf2-9afd4c612aae?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=4d6691d028d2ef2dea7c1759c84b93ad 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/93736f44/uploads/origins/1d9b2413-a56d-4348-baf2-9afd4c612aae?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=07361daf5fa4d8bb7d999c26708da0df", "srcset": "https://si.imgix.net/93736f44/uploads/origins/1d9b2413-a56d-4348-baf2-9afd4c612aae?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=07361daf5fa4d8bb7d999c26708da0df, https://si.imgix.net/93736f44/uploads/origins/1d9b2413-a56d-4348-baf2-9afd4c612aae?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=e7290ea3910601964f7668373cc3193c 2x, https://si.imgix.net/93736f44/uploads/origins/1d9b2413-a56d-4348-baf2-9afd4c612aae?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=c04d8c45eaf509afb9ed82e0ba6ba0ec 3x"}, "body": "またこんにちは！\n\n前回のナルマヤのリクエスト、本当にありがとうございました。とても気に入りました！彼女に私のお気に入りの衣装を選んでくださり、お腹がぽっこりしたバージョンも最高でした！2つ目のリクエストをしてもいいでしょうか？まだ1つしか依頼していないので、もしダメなら理解します。 マリオシリーズのロザリーナを描いていただけませんか？お腹の中にルマを1匹、あるいは複数匹妊娠している姿を想像しています。お風呂のシーンで、裸の彼女が湯船に浸かり、体が湯で濡れている状態で、石鹸の泡がほんのり股間を覆っているような描写だと最高です。 あるいは、服を着た状態やシリーズに登場する他の衣装でも構いませんが、可能であればお腹が露出している姿が見たいです。あるいは、前回のリクエストで提案したジュノのアイデアを優先して描いてくださっても構いません！いずれにせよ、私のリクエストをご検討いただきありがとうございます！\n\nロザリーナのリファレンス：\nhttps://drive.google.com/file/d/16lCVEgiwqEnufBr5DQPfRuiN9SPwKHz1/view?usp=sharing", "nc": 32, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Nagatatuzin/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 4087238, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/35512d23/uploads/origins/f2cb97ad-441f-488a-b45e-0a7034b74c17?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f97dcad4b693b18481aee1cf4ad07d42", "srcset": "https://si.imgix.net/35512d23/uploads/origins/f2cb97ad-441f-488a-b45e-0a7034b74c17?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f97dcad4b693b18481aee1cf4ad07d42, https://si.imgix.net/35512d23/uploads/origins/f2cb97ad-441f-488a-b45e-0a7034b74c17?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=dbfe10dc8e3e76589d718ecb304c2a15 2x, https://si.imgix.net/35512d23/uploads/origins/f2cb97ad-441f-488a-b45e-0a7034b74c17?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=2e0fc33025a3a0cf8c71afbbcd4de989 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/35512d23/uploads/origins/f2cb97ad-441f-488a-b45e-0a7034b74c17?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=7e3de742eb0dd39d2c4aadb85f504619", "srcset": "https://si.imgix.net/35512d23/uploads/origins/f2cb97ad-441f-488a-b45e-0a7034b74c17?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=7e3de742eb0dd39d2c4aadb85f504619, https://si.imgix.net/35512d23/uploads/origins/f2cb97ad-441f-488a-b45e-0a7034b74c17?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=b564115323b424aa225fb58cd86ee9b8 2x, https://si.imgix.net/35512d23/uploads/origins/f2cb97ad-441f-488a-b45e-0a7034b74c17?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=cc445cdcc6f90c169d7cc07c67504668 3x"}, "body": "こんにちは！\n\n以前、他のユーザーさんのために描いてくださったSkebのリクエストイラストが本当に素敵だったので、私もぜひお願いしたいと思っています。お描きになりやすい方のキャラクターを選んでいただけるよう、2つの候補をご用意しました。どちらのキャラクターをお選びになっても、妊娠をテーマにしたイラストにしていただきたいです。1つ目の候補は、『グランブルーファンタジー』シリーズのナルマヤです。 彼女はとても母性あふれる性格なので、大きな妊婦のお腹を抱えた姿を見てみたいです。お腹の中で子馬が育っている様子を描いた別バージョンも描いていただけませんか？2つ目の候補は『オーバーウォッチ』のジュノです。彼女は火星出身で、地球の文化についてほとんど知らない、とても無邪気で天然な性格です。 彼女を選ばれる場合、お腹を膨らませていただけませんか？また、お腹の中で子犬が育っているという別バージョンも描いていただけないでしょうか？私が考えた設定では、彼女は「かわいい」と思って犬と交尾し、地球では動物と交尾してはいけないことを知らずに妊娠してしまったというものです。 どちらの衣装を選んでも構いませんが、私の個人的な好みも記載しておきます。ポーズは自由にお任せしますが、妊娠中のお腹が強調されるものがあれば嬉しいです。ご検討いただきありがとうございます！\n\n（オプション1）ナルマヤ：\nhttps://drive.google.com/file/d/1IYseuz1OhS3Minhb30DHFBFCuG7FQWUq/view?usp=sharing\n衣装の希望1：\nhttps://drive.google.com/file/d/191gMrQCzr7kcOrwOaAoSGRZ0Zp1Q2Crw/view?usp=sharing\n希望の衣装2：\nhttps://drive.google.com/drive/folders/1LtPw_cCJIrkzhSACztIsA--7J0cGmMej?usp=sharing\n\n（オプション2）ジュノ：\nhttps://drive.google.com/file/d/1DBHfruKl5-B1g2EmiRVjUaNPqyz05gBD/view?usp=sharing\n服装の好み:\nhttps://drive.google.com/file/d/1UjyiaGguI_-RXqgl_DMnHW0f4Ho6bi1K/view?usp=sharing", "nc": 32, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Nagatatuzin/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 4087238, "client_id": 1621813, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/db31f4d5/uploads/origins/e7a5e5a7-b77e-455f-adf5-a329b2070daa?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a908bd0172d8a5d6fd213626b1906256", "srcset": "https://si.imgix.net/db31f4d5/uploads/origins/e7a5e5a7-b77e-455f-adf5-a329b2070daa?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a908bd0172d8a5d6fd213626b1906256, https://si.imgix.net/db31f4d5/uploads/origins/e7a5e5a7-b77e-455f-adf5-a329b2070daa?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=7ea9af56ecc13ad4bb40422a505bf1df 2x, https://si.imgix.net/db31f4d5/uploads/origins/e7a5e5a7-b77e-455f-adf5-a329b2070daa?bg=%23fff&auto=format%2Ccompres