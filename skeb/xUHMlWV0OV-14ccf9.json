ると嬉しいです！\n---\n用途は個人での観賞のみです。\nご検討のほどよろしくお願いいたします！\n\nhttps://drive.google.com/drive/folders/14TIIYTFYFiROpZMzQL1CQ8CcuR2KXPrz?usp=drive_link", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 160848, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "akihiyo", "screen_name": "AKlHlYO", "avatar_url": "https://pbs.twimg.com/profile_images/1441376757479661570/xVyRBah4.jpg", "header_url": "https://pbs.twimg.com/profile_banners/157371813/1565536383/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 10, "complete_expiration_days": 45, "skills": [{"genre": "art"}], "banned": false, "nc": 48}, {"id": 1193539, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "鮨村", "screen_name": "sushimura10", "avatar_url": "https://pbs.twimg.com/profile_images/1935874862892929024/Udww1g0P.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1762152960031928320/1763729569/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 2, "complete_expiration_days": 15, "skills": [{"genre": "art"}, {"genre": "correction"}], "banned": false, "nc": 161}, {"id": 1619466, "creator": true, "nsfw_acceptable": false, "acceptable": false, "name": "🌼🌻💛", "screen_name": "_pajamas_party", "avatar_url": "https://pbs.twimg.com/profile_images/1424137541062598660/jEiU5WMr.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1007918642447544321/1636899280/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 