ただきたく、リクエスト送らせていただきます。\n\n●キャラクターについて●\n名前：波照間　宇海（ハテルマ　ウミ）中～高校生くらい\nイメージカラーは白群（#83ccd2）　差し色は明るめのイエロー（#f7fbaf）\n海洋生物のマンタをモチーフにしています。\n世界各地に散らばる異世界を探索し、サンプルを回収する研究チームのお手伝いをしています。\n\n・持ち物は透明っぽいもの、海洋生物モチーフを好みます。\n・カセットテーププレーヤーがキーアイテムです。\n・瞳孔がキャラクター資料から見て左側のみ、差し色のイエローになっています。\n・泣きぼくろあり、両耳に１個ずつピアスがあいてます。\n・髪型はアシンメトリー、白のインナーカラーです。\n・感情表現は少なめですがムスっとしているよりかは「無」かボーっとしている感じです。\n\n●構図について●\nデスクトップの壁紙にしたいので、できれば横向きに描いていただけると大変嬉しいです。\nイメージカラーをメインに、服装はキャラクターシートを参考にしてください。（アレンジ可）\nポーズ指定は特にないのですが、カセットテーププレーヤーを一緒に描いてもらえたらと思います\n（上記、無理そうであれば無視していただいても全然大丈夫です！）\n\n資料はgoogledriveに格納しています。↓↓\nhttps://drive.google.com/drive/folders/1anudRIAM9rJ0i-PF-DlxeMAXiM3T7Pyn?usp=sharing\n\nご検討いただけますと幸いです。よろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/1anudRIAM9rJ0i-PF-DlxeMAXiM3T7Pyn?usp=sharing", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@_kszknmkj/works/22", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2617433, "client_id": 3178913, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/15fceda0/uploads/origins/509f0133-ee46-447c-b669-0cbf5eeb5777?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fefa6b4cbd34999eb59a034aaaea7b83", "srcset": "https://si.imgix.net/15fceda0/uploads/origins/509f0133-ee46-447c-b669-0cbf5eeb5777?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fefa6b4cbd34999eb59a034aaaea7b83, https://si.imgix.net/15fceda0/uploads/origins/509f0133-ee46-447c-b669-0cbf5eeb5777?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=dfb45b4d07539e27f9fddc4eafaa7832 2x, https://si.imgix.net/15fceda0/uploads/origins/509f0133-ee46-447c-b669-0cbf5eeb5777?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=1d0e9cbdf95450f15628d3c9f705e63d 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/15