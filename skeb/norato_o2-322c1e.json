=200&blur=200&s=2ff73ac07dc6e555e4096f091d2f04f2, https://si.imgix.net/d29bd266/uploads/origins/f8a57ca6-c6da-47be-b45d-375d9741de4f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=ed0010d7794a7234a62159ea5f5dc36e 2x, https://si.imgix.net/d29bd266/uploads/origins/f8a57ca6-c6da-47be-b45d-375d9741de4f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=644cc10bd3312dd4ca4386994365acb4 3x"}, "body": "のらとさんこんにちは、いつも素敵なイラストや素晴らしいアレコレありがとうございます！\nリクエストですがオリキャラののらとちゃんを尿道責めするシチュをお願いしたいです。\n\n◆キャラ\nのらとちゃん\n◆服装\nおまかせします\n◆シチュエーション／構図\n・まんぐり返し＆バンザイポーズで拘束\n・フック付きベルト（ガーターやサスペンダーのような）をおま○こに引っ掛けてくぱぁ\n・イボイボが無数に生えた極細のバイブ（シリコンブラシのような）で尿道を残像が見えるほど高速ピストン責め\n・おしっこや潮、愛液を撒き散らして絶頂\n\n痛みに苦しんでる感じではなく、不安や恥ずかしさや気持ちよさに悶えてる表情をお願いしたいです\n\n※↓みたいな感じの責めをのらとちゃんにも味わわせてやってほしいです\n※https://skeb.jp/@gnk4649/works/36\n\nマニアックですがぜひよろしくお願いします。", "nc": 185, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@norato_o2/works/16", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1605294, "client_id": 21603, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/18bca142/uploads/origins/7ecc94e9-86e9-4739-98bc-b9f07945e15f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=73a699dd71f8837f0afb47c86bafabb4", "srcset": "https://si.imgix.net/18bca142/uploads/origins/7ecc94e9-86e9-4739-98bc-b9f07945e15f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=73a699dd71f8837f0afb47c86bafabb4, https://si.imgix.net/18bca142/uploads/origins/7ecc94e9-86e9-4739-98bc-b9f07945e15f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c3a3ceff78b883362cc9046a69091b64 2x, https://si.imgix.net/18bca142/uploads/origins/7ecc94e9-86e9-4739-98bc-b9f07945e15f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b00a55082fdeae6200f62d55210c0fcb 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/18bca142/uploads/origins/7ecc94e9-86e9-4739-98bc-b9f07945e15f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6e267e5dbbc563ee89e4344fbe0f7d4b", "srcset": "https://si.imgix.net/18bca142/uploads/origins/7ecc94e9-86e9-4739-98bc-b9f07945e15f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6e267e5dbbc563ee89e4344fbe0f7d4b, https://si.imgix.net/18bca142/uploads/origins/7ecc94e9-86e9-4739-98bc-b9f07945e15f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=46c735ecb0f335ce8520a893c8c6ea7e 2x, https://si.imgix.net/18bca142/uploads/origins/7ecc94e9-86e9-4739-98bc-b9f07945e15f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=a4ef4e158de40d7b6ea9c6339c26af60 3x"}, "body": "元々フォローさせて頂いてましたが、最近イラスト見返してのらとちゃんのプリン頭やダボっとしたパーカーで下履いてない、26歳、ちょっと退廃的な雰囲気など、キャラデザと設定が改めてツボにハマり、描いてみてほしいネタがあり依頼させて頂きました\n\n\n生活感のあるちょっとエッチな雰囲気という感じで、下着を干してるのらとちゃんの立ち姿をお願いできますでしょうか？\n\n部屋干しのピンチハンガーにパンツが4〜6枚吊るされ、手にも一枚持って干してる所を男に見られてたのに気付いた、みたいなシチュエーション\n\n宅飲みでたまたま居合わせた男友達とか、例えば同棲相手(妄想)みたいな気を許した相手に恥ずかしい所を目撃されるも、\n怒るでもなく「何見てんだよすけべー」みたいなノリで悪戯っぽくニヤッと笑い、\nパンツのゴムや紐を両手人差し指で摘んだり引っ掛けたりしてみょーんと広げ、むしろ見せつけるようにからかってくる感じ(簡単なフキダシや書き文字で台詞もお願いします　内容は作者の解釈で変更OK)\n\n立ち姿をやや下アングルから写したような感じで、いつもの部屋着パーカーの裾からチラッとパンツが見えててほしいです\n(ギャルっぽいテカテカ系、ゼブラ柄とかお正月メガネちゃんみたいな虎縞https://www.pixiv.net/artworks/95343150)\n\n背景とかは拘らないので室内っぽいアセット等でできるだけローコストに、\n作画コストはのらとちゃんの可愛さとパンツに注力してもらう感じで\n\nパンツは手に持ったのがセクシー系且つのらとちゃんのデザインとキャラ解釈に一番似合いそうなデザインや色で\n\n干してる物は普段穿きっぽいちょっとくたびれた綿系とか、セクシー系(サテン、Tバック、紐パン、透けてるやつとか)とかを半々ぐらいに、柄とか色とかバリエーション豊かに生々しい感じにお願いします\n(パンツだけそんないっぺんに洗って干さねぇだろリアルじゃねーよ、みたいなツッコミはご都合ということで・・・)\n\n\n\n以上です\n性癖出てて恐縮ですが、ご検討頂けると幸いです！", "nc": 32, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@norato_o2/works/15", "private_thumbnail_image_urls": null, "private": false, "gen