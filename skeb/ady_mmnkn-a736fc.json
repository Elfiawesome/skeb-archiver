前やTwitterアカウントは明記します）\n\nhttps://kakuyomu.jp/works/16816700427904390753\n\nご縁がございましたらよろしくお願いします", "nc": 25, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}], "sent_works": [], "similar_creators": [{"id": 508335, "creator": true, "nsfw_acceptable": false, "acceptable": false, "name": "泡", "screen_name": "noone_oO", "avatar_url": "https://pbs.twimg.com/profile_images/1426403873367891970/X1QXyhlM.png", "header_url": "https://pbs.twimg.com/profile_banners/57929072/1534956203/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "art"}], "banned": false, "nc": 17}, {"id": 1153245, "creator": true, "nsfw_acceptable": true, "acceptable": false, "name": "𝚔𝚜𝚝𝚛𓃮", "screen_name": "1kstrrrrrrr", "avatar_url": "https://pbs.twimg.com/profile_images/1681005353813811200/yu0LkcEA.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1379797905167413250/1754158169/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 7, "complete_expiration_days": 120, "skills": [{"genre": "art"}], "banned": false, "nc": 33}, {"id": 1293386, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "泉チカ(CHIKA)", "screen_name": "shumizoku", "avatar_url": "https://pbs.twimg.com/profile_images/703891980/_____-2.png", "header_url": "https://pbs.twimg.com/profile_banners/115438625/1614946440/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "art"}, {"genre": "correction"}], "banned": false, "nc": 144}, {"