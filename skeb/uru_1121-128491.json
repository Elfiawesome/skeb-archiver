mat%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=259e2e2c1adfcb14b0ee906286ff7595 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/d99c25ff/uploads/origins/532eb5b9-59b7-45fc-8a4b-7b152348e9e6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6d818e993109d3e015420919f187ee02", "srcset": "https://si.imgix.net/d99c25ff/uploads/origins/532eb5b9-59b7-45fc-8a4b-7b152348e9e6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6d818e993109d3e015420919f187ee02, https://si.imgix.net/d99c25ff/uploads/origins/532eb5b9-59b7-45fc-8a4b-7b152348e9e6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=c20581696832ec668c3f042baf69361a 2x, https://si.imgix.net/d99c25ff/uploads/origins/532eb5b9-59b7-45fc-8a4b-7b152348e9e6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=5802eef6390fc973462244f35d3495dd 3x"}, "body": "https://skeb.jp/@uru_1121/works/1\nこの依頼のクライアントが別のポエットちゃんの依頼をしていると聞いたのでそれらを元に依頼したいと思いまして!\n\nポエット (pop'n music 20 fantasia・センチ)がマリオパーティ９のミニゲーム「ふわふわ風船あつめ」のシャボン玉に入って空中散歩する1枚絵をお願いします。\n\nキャラの外見\nhttps://popnmusic.fandom.com/wiki/Poet/Gallery?file=Poet_20_1P.png\nhttps://popnmusic.fandom.com/wiki/Poet/Gallery?file=Poet_20_1P_Great.gif\nhttps://popnmusic.fandom.com/wiki/Poet/Gallery?file=Poet_20_1P_Win.gif\n\nポエットちゃんが入っているシャボン玉の直径は、彼女の身長の2倍くらい。その中に30個にもなるパステルカラー風船が入っています。\nその周りにも５個くらいの風船。\nポエットちゃんの表情はとにかく嬉しそうな感じでお願いします。\n障害物のトゲトゲボールの配置はご自由に。\n\n参考のプレイ動画\nhttps://youtube.com/watch?v=L6jhPFPjNJ8", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@uru_1121/works/9", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 271627, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/38144dc5/uploads/origins/6ec09337-298b-4809-9ce1-3e630dea25a2?bg=%23f