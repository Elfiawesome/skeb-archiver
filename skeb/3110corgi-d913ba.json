のだ。突然グラが恥ずかしそうに赤面するのは、彼がそのスーパーヒーローだからである（グラとルームメイトはゲイである）。\n\nスーパーヒーローのコスチュームのキツさなど、ソフトなエッチさを加えてもいい。\n\nhttps://drive.google.com/drive/folders/1suw3cRO00toqq8nx8puWrS48gL1dL7uN?usp=sharing", "nc": 176, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}], "sent_works": [], "similar_creators": [{"id": 15879, "creator": true, "nsfw_acceptable": true, "acceptable": false, "name": "たかすけ けもケJ-66", "screen_name": "oneko_takasuke", "avatar_url": "https://pbs.twimg.com/profile_images/1966096891831308289/WmYx817k.jpg", "header_url": "https://pbs.twimg.com/profile_banners/742324885/1762687162/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "art"}, {"genre": "correction"}], "nc": 145}, {"id": 22382, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "がむ", "screen_name": "gintyatyatyatya", "avatar_url": "https://pbs.twimg.com/profile_images/1987229239419281414/osLvWWxc.jpg", "header_url": "https://pbs.twimg.com/profile_banners/2314734742/1762627347/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "art"}, {"genre": "correction"}], "nc": 160}, {"id": 29867, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "カサコ🫠お仕事募集中", "screen_name": "kasakasako", "avatar_url": "https://pbs.twimg.com/profile_images/1755115477519720449/9kvR6WlP.jpg", "header_url": "https://pbs.twimg.com/profile_banners/68173151/1690614892/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days