bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2e7800a4bd01aa9fc321577d5326351d, https://si.imgix.net/ebded3d2/uploads/origins/4d25ef04-6d49-4424-b3ff-475e9ea5daba?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=509766d448addc2c2cc38d0b5a91e996 2x, https://si.imgix.net/ebded3d2/uploads/origins/4d25ef04-6d49-4424-b3ff-475e9ea5daba?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=65c5e00efaba62b8f74f633ca9b9e844 3x"}, "body": "初めまして！雪白抹茶と申します。\nお見かけした霞原先生の詰め込みイラストに一目惚れしてしまいました…！もし良ければうちよそPCの詰め込みイラストを描いて頂きたいです！相方に許可は頂いてます。\n\n〇キャラクタープロフィール\n(より詳しいことはURL内の資料に載せています)\n▪️東雲楓 (27)178cm\n探偵。兄弟の兄の方。\n頭が良すぎてこの世が退屈で、死のスリルを求めている。楓音(弟)に執着しており、よくからかっている。\n\n▪️東雲楓音(21)174cm\n探偵助手を兄弟の弟の方。\n死にたがりの兄に手を焼いている。昔はツンデレブラコンだったが、最近兄を生かすために必死。よく兄にわからかわれて真っ赤になっている。\n\n\n[関係性] \n探偵業をしている兄弟です。両親が早くに他界し兄が弟を育てる形で二人で生きてきました。兄は弟が本当は大事。故に頭のネジが外れている自分から遠ざけようとし、弟は兄が大好きなので必死に近くに繋ぎ止めようとしています。\n\n霞原先生のお好きなように2人を描いて頂けると嬉しいです！\nちびキャラを描いて頂ける場合はグッズ化をしたいので、可能でしたら個別データを頂けると嬉しいです……！\n \n\n金額や資料に不備等あれば再送頂けると幸いです！是非ご検討よろしくお願いします。\n\nhttps://drive.google.com/drive/folders/1-DiV2VMaT8QaZYkcBHul0IG5XH6pitUL", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Pan_tabe64/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2410782, "client_id": 838157, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/eb6bbc4a/uploads/origins/36ae8e26-70e1-4181-b5bf-4d3bb5e8ce8d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d058532aaba95e04010d75ec5712cd5b", "srcset": "https://si.imgix.net/eb6bbc4a/uploads/origins/36ae8e26-70e1-4181-b5bf-4d3bb5e8ce8d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d058532aaba95e04010d75ec5712cd5b, https://si.imgix.net/eb6bbc4a/uploads/origins/36ae8e26-70e1-4181-b5bf-4d3bb5e8ce8d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=6a5b3cd76cdd9083227aa945ccd33744 2x, https://si.imgix.net/eb6bbc4a/uploads/origins/36ae8e26-70e1-4181-b5bf-4d3bb5e8ce8d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=383d182cc8c248a323ecb194432fc46c 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/eb6bbc4a/uploads/origins/36ae8e26-70e1-4181-b5bf-4d3bb5e8ce8d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=fb76316083a3f17fdf2cf61e034ce5a4", "srcset": "https://si.imgix.net/eb6bbc4a/uploads/origins/36ae8e26-70e1-4181-b5bf-4d3bb5e8ce8d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=fb76316083a3f17fdf2cf61e034ce5a4, https://si.imgix.net/eb6bbc4a/uploads/origins/36ae8e26-70e1-4181-b5bf-4d3bb5e8ce8d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=e997a90124369151d13ab810061f3c66 2x, https://si.imgix.net/eb6bbc4a/uploads/origins/36ae8e26-70e1-4181-b5bf-4d3bb5e8ce8d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=465471b29f27c067f15e6fe668554f63 3x"}, "body": "ピコ様\nお世話になっております。きむらやです。\nこの度はピコ様にTRPGのキャラクターを描いていただきたいと思い、リクエスト致しました。\nイラストの構図やシーンなどはお任せ致します。\nもし難しければキャンセルして頂いて大丈夫です。\nCoCの「お前のせいだよ」というシナリオの探索者になります。秘匿のあるシナリオですが、説明文にネタバレはございません。\n以下、キャラクターの説明になります。\n\n☆HO1 天才教授:黄金 解(こがね さとる)\n某大学数学科の天才教授。日々数々の難題を解き明かしている。黄金比を見ると思わず写真を撮ってしまう癖がある。\n一人称：私/俺\n相手の呼び方：陽、お前\n\n☆HO2 天才教授の助手:晶納 陽(きょうのう ひなた)\n黄金の助手。普段はカタコト(語尾がカタカナ)で喋るが日本人。チャイナ服は趣味。黄金解のことが好きだが嫌い。\n一人称：ボク/僕\n相手の呼び方：教授\n\n☆会話例①\n黄金解 :「人待たせて煙草？ いい身分してんなァ……」\n晶納陽 :「まだ時間前ですヨ」\n黄金解 :取って灰皿にぽいっと\n晶納陽 :「あ！？おい！」\n晶納陽 :「チョット、なにするんですカ」\n黄金解 :「俺が『着いた』って連絡しただろ」\n晶納陽 :「まだ見てマセ～ン」\n\n☆会話例②\n黄金解 :「はいはい。冗談だよ、じょーだん。そんなマジトーンにならなくてもいいだろ」\n晶納 陽 :「…」\n晶納陽 :「アハ、そんなにマジに聞こえましタ？」\n黄金解 :「否定してやりたいのは山々なんだがな。\n生憎、あの時に散々聞いてるし、俺は記憶力が良くてね」\n晶納陽 :「…だから何」\n黄金解 :「取り繕う余裕がないお前は見てて面白いよ」\n晶納陽 :「……………僕の気持ち全部わかってそれを言ってるなら本当にタチ悪いですね」\n晶納陽 :「…まあだからって別に何もしないし、この先も何も無いですよ。だってあなたは僕の大好きな黄金解であって大嫌いな黄金解なんですから」\n黄金解 :「他人の気持ち全てがわかるわけないだろ。\n数式の方がよほど単純で素直だ」\n黄金解 :「ただ……」\n黄金解 :「お前の複雑な等式を崩せるのが、世界でただ俺ひとりなコトくらいは理解してるつもりだ。……今はそれでいいだろ」\n黄金解 :「……柄にもないこと言った。ほら、行くぞ」\n\n以上となります。\nもし可能でしたらよろしくお願い致します。\n\nhttps://drive.google.com/drive/folders/105ZjjXnnZTDKWwZDVC_wMqPK6a2dxvRc", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Pan_tabe64/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2410782, "client_id": 1449475, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/49bb1d13/uploads/origins/67e698bc-a0fe-46d0-bd4e-343596838524?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=805d0d310524b5bca50d8d26eed80cd0", "srcset": "https://si.imgix.net/49bb1d13/uploads/origins/67e698bc-a0fe-46d0-bd4e-343596838524?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=805d0d310524b5bca50d8d26eed80cd0, https://si.imgix.net/49bb1d13/uploads/origins/67e698bc-a0fe-46d0-bd4e-343596838524?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=681745de3bca0b8db241e528b48c5920 2x, https://si.imgix.net/49bb1d13/uploads/origins/67e698bc-a0fe-46d0-bd4e-343596838524?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=59c67349d224607c79dd13cbc196a5d5 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/49bb1d13/uploads/origins/67e698bc-a0fe-46d0-bd4e-343596838524?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=656389aa4d5ce8f497de0c6740fd040c", "srcset": "https://si.imgix.net/49bb1d13/uploads/origins/67e698bc-a0fe-46d0-bd4e-343596838524?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=656389aa4d5ce8f497de0c6740fd040c, https://si.imgix.net/49bb1d13/uploads/origins/67e698bc