4d8-5994-46e4-96ab-051167fa4d3d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=1e2c25da6c10ff6e0d71459b0ea91ce7, https://si.imgix.net/3a3de35d/uploads/origins/293074d8-5994-46e4-96ab-051167fa4d3d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=1319ec9598868e800d77af368171d966 2x, https://si.imgix.net/3a3de35d/uploads/origins/293074d8-5994-46e4-96ab-051167fa4d3d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=86b61f2a45c46d7a0b9945884a58d6bb 3x"}, "body": "はじめまして、こちらの御陵ナグサの煌めく透明感に惹かれてリクエストさせていただきました。\nhttps://x.com/shirasukuretaka/status/2071700730621423990?s=46&t=HLREpzYaC7QiLr5yd12ZQg\n以下リクエスト内容です。(再送させていただきます)\n\nキャラクター：\nブルーアーカイブの御陵ナグサ(水着)\n\nコスチューム：\n公式水着衣装を下記のように改変した物\n・ロングニーソックス追加\n・水着、羽織物、ロングニーソックスとも艶々テカテカな無色透明シースルー ラテックス素材化\n　そのため恥部は丸見えな状態\n・サンダルデザインはヒール高の高いピンヒールスタイルへ変更\n\nシチュエーション：\n先生にシャーレのどこかにエロコス着用で呼び出されたナグサなイメージ\n不適な笑みでこちらを見つめ、机に片手を付き、もう片手で自らの太もも裏あたりを掴んで持ち上げて股間見せつけなポーズ(参考イメージ、アングルhttps://www.pixiv.net/artworks/131965966#manga )\n全身絵でお願いします\n\n下記差分をお願いいたします。\n・口を少し開け舌なめずり\n・先生とセックス(先生の笹や手のみの描写で構いません。\n・先生との事後で多数使用済みコンドームを水着にくくりつけたり、ニーソックスの裾口に挟んだりした状態\n・汗だくでかなり艶やかな肌質感差分を上記差分それぞれとも合わせたもの\n\nマニアックな内容ですが、何卒よろしくお願いいたします。", "nc": 48, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@ShirasuKuretaka/works/11", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/f3208a7d/uploads/origins/197ae884-7886-4bb7-b1fd-048728a5bd49?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=4d2a8ff5367db81d5d6e382b5b2e9b82", "srcset": "https://si.imgix.net/f3208a7d/uploads/origins/197ae884-7886-4bb7-b1fd-048728a5bd49?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=4d2a8ff5367db81d5d6e382