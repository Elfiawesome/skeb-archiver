ると暗室が想定されがちですが、\nキャラクターの配色が暗くなるのは望んでいないので、\n明るい配色を希望します。\n\nもし可能であれば媚薬を飲まされて紅潮した顔になり\n胸当てがズリ下げられて大きな胸の膨らみが全て露出、\n乳首が膨れて勃起、ショーツに縦長楕円の大きな濃いシミ\n（モザイクは回避）が入ったイラストを併せて希望します。\n\n背景は無しか簡単なもので構いません。\n作品はPNG形式、原画ファイルはPSD形式を希望します。\nよろしくお願いします。", "nc": 161, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@akatukidoumei/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 104288, "client_id": 82663, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/f6c7789a/requests/79788_2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=76e95d95fa6321e6f90905dd31630aff", "srcset": "https://si.imgix.net/f6c7789a/requests/79788_2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=76e95d95fa6321e6f90905dd31630aff, https://si.imgix.net/f6c7789a/requests/79788_2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=7e4a409309a2dac6861b03e6a49ba85f 2x, https://si.imgix.net/f6c7789a/requests/79788_2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=7e9d7824f41eb1f7efa82bd3de60ad13 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/f6c7789a/requests/79788_2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5dece8be918d64ab77feeccbf11818d1", "srcset": "https://si.imgix.net/f6c7789a/requests/79788_2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5dece8be918d64ab77feeccbf11818d1, https://si.imgix.net/f6c7789a/requests/79788_2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=08203f85650a14a550ec1f6e6ad38c53 2x, https://si.imgix.net/f6c7789a/requests/79788_2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=205231d158a4ba0e49d23f8942a5856d 3x"}, "body": "RO女性デフォルトコスチューム青色アークビシ