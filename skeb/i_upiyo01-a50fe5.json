[{"path": "/@i_upiyo01/works/12", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2704382, "client_id": 3739910, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/5e3d9410/uploads/origins/8f590134-4209-4a0b-a4dc-ec5c2998b700?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f054093d2fee1aab478b0dfff6370a6a", "srcset": "https://si.imgix.net/5e3d9410/uploads/origins/8f590134-4209-4a0b-a4dc-ec5c2998b700?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f054093d2fee1aab478b0dfff6370a6a, https://si.imgix.net/5e3d9410/uploads/origins/8f590134-4209-4a0b-a4dc-ec5c2998b700?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b57161212c914c30a1876ebb32003151 2x, https://si.imgix.net/5e3d9410/uploads/origins/8f590134-4209-4a0b-a4dc-ec5c2998b700?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=5fafe74c6f7269abd3158feefb5f6552 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/5e3d9410/uploads/origins/8f590134-4209-4a0b-a4dc-ec5c2998b700?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=cd6010b7a7c862cbfd1381a03346944b", "srcset": "https://si.imgix.net/5e3d9410/uploads/origins/8f590134-4209-4a0b-a4dc-ec5c2998b700?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=cd6010b7a7c862cbfd1381a03346944b, https://si.imgix.net/5e3d9410/uploads/origins/8f590134-4209-4a0b-a4dc-ec5c2998b700?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=cb559f1fc7077358d938931da1dfa721 2x, https://si.imgix.net/5e3d9410/uploads/origins/8f590134-4209-4a0b-a4dc-ec5c2998b700?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=c73aff5751dc3558eeee5fa92bc4173e 3x"}, "body": "いう先生、こんにちは！\nXで先生がSkebリクエストを開始されたツイートを拝見しました（以前から先生をフォローしていたので！！）\n先生の精巧で可愛いちびキャラクターの画風がとても好きで、ぜひイラストを依頼させていただきたいです。お願いしたいのは「アズールレーン」のパーミャチ・メルクーリヤです。もしお引き受けいただけるなら、以下が詳細な説明です：\nキャラクター： パーミャチ・メルクーリヤ\n服装： サクランボ・ブイ\n構図：\n俯瞰アングルで、パーミャチ・メルクーリヤが体全体を豆袋ソファに沈めて寝そべっています。両手でNintendo Switch（モデルは最も標準的な赤と青のJoy-Conが付いたもの！）を高く掲げ、目は画面をじっと見つめています。右足を高く上げていて、右足のスリッパが今にも落ちそうな状態です。左足は内側に曲げており、左足のスリッパはもう適当に脱ぎ捨てられて横に転がっています。ゲームに夢中で時の経つのも忘れてしまい、窓の外はもう夕焼けの時間帯です！\n参考リンクには画面のイメージがありますが、人物以外の物はあくまで雰囲気の参考であり、必ずしも描く必要はありません。先生が描きやすいように自由にアレンジしていただいて大丈夫です！\nよろしくお願いいたします！\n……………………\nいう老师您好，我刚刚在x上看到了您开启skeb请求的推文（因为之前关注了老师！！）\n我很喜欢您这种精致又可爱的Q版画风，所以想向您进行委托。想要您画的是碧蓝航线的水星纪念！如果您能接受的话以下是要求说明：\n角色：水星纪念\n服装：サクランボ・ブイ\n构图：俯视视角，水星纪念整个身体都躺进懒人沙发里，双手高高举起Switch游戏机（款式是最经典的标准版的红蓝手柄！）她的眼睛盯着屏幕，右腿高高举起，右脚上的拖鞋摇摇欲坠，左腿向内弯曲，左脚的拖鞋已经被随便地甩到了一边，因为游戏打的太忘我连时间的流逝都没有感受到，此时窗外已经是黄昏了！\n在链接里有画面的参考，画面中人物以外的物体仅作为示意，并不一定就要全部画出来，请以您觉得舒服的方式进行作画！\n\nhttps://drive.google.com/drive/folders/1HWfI06DBkSAc_ot_-S7VYcbo6jToKEr_?usp=sharing", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@i_upiyo01/works/11", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2704382, "client_id": 3678163, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/70526eb3/uploads/origins/fd8cbcaf-bbc0-4706-8c71-eceb060cb47b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c10c3fd1ff10af781aa92fd88a5a5bcc", "srcset": "https://si.imgix.net/70526eb3/uploads/origins/fd8cbcaf-bbc0-4706-8c71-eceb060cb47b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c10c3fd1ff10af781aa92fd88a5a5bcc, https://si.imgix.net/70526eb3/uploads/origins/fd8cbcaf-bbc0-4706-8c71-eceb060cb47b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=03f314f0a65945f354c4ed806c9d9fdb 2x, https://si.imgix.net/70526eb3/uploads/origins/fd8cbcaf-bbc0-4706-8c71-eceb060cb47b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=14da7e5322a0dc335d1c4f89