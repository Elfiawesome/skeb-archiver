13eccf?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=234cc9bfabf5f62db229b861c0d362bc", "srcset": "https://si.imgix.net/039c028e/uploads/origins/b5ed27d9-3389-45d2-b3ef-3f642313eccf?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=234cc9bfabf5f62db229b861c0d362bc, https://si.imgix.net/039c028e/uploads/origins/b5ed27d9-3389-45d2-b3ef-3f642313eccf?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=105f148933a3de5c17188c11ea040095 2x, https://si.imgix.net/039c028e/uploads/origins/b5ed27d9-3389-45d2-b3ef-3f642313eccf?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=65c6e271102b5eff3454c2794d868a3a 3x"}, "body": "募集再開お待ちしておりました！\n\nおがくず御殿さんのノベル作品『体臭娘！』の『足臭カノジョッ！！』からリクエストさせて下さい。\n作中に靴を嗅ぐシーンが無かったのが唯一の心残りだったので、兎野夜月ちゃんのランニングシューズをマネージャー遠藤くんが自主的に嗅ぐイラストをお願いします。遠藤くんは兎野ちゃんのシューズを手に持ち顔に押し付けて消臭しています。夜月ちゃんは遠藤くんを応援しながら優しく見守っています。\n\n足臭王女VS後輩マネージャーのエキシビションマッチ\n夜月ちゃんの靴を消臭できたら遠藤くんは夜月ちゃんの体を好きにしていい。\n消臭できなければ遠藤くんは夜月ちゃんの消臭人に永久就職。\nという約束で始めた消臭バトル。\n靴から漏れ出た臭いだけで遠藤くんの顔の周りが足臭で包まれている。遠藤くんはガクガクと震えてながらも、夜月ちゃんにも聞こえるほど大きな鼻呼吸をする。応援する夜月ちゃん。\n必死に嗅いでいた遠藤くんだったが限界を迎え呼吸が弱くなってしまう。もちろん靴の臭いはまだまだ健在。\n勝利した夜月ちゃんはワクワクしながら頭皮、腋、へそ、股間、肛門、足裏と、毎日全身の臭いを嗅がせてあげると遠藤くんに宣言するのだった。", "nc": 49, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@ogakuzugoten/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 448820, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/50b412a8/uploads/origins/57801dd7-5570-4de1-955b-5ac2400a2afc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c9d46a7c918a15113654a06c5c4f64b5", "srcset": "https://si.imgix.net/50b412a8/uploads/origins/57801dd7-5570-4de1-955b-5ac2400a2afc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c9d46a7c918a15113654a06c5c4f64b5, https://si.imgix.net/50b412a8/uploads/origins/57801dd7-5570-4de1-955b-5ac2400a2afc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=9d9f93cef6ef589f46d4cc62582f32ba 2x, https://si.imgix.net/50b412a8/uploads/origins/57801dd7-5570-4de1-955b-5ac2400a2afc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c49bca78db41bbadf52b487d8c4206b9 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/50b412a8/uploads/origins/57801dd7-5570-4de1-955b-5ac2400a2afc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2bbe2d7b793b234b8ec0b2eb2b7bf26b", "srcset": "https://si.imgix.net/50b412a8/uploads/origins/57801dd7-5570-4de1-955b-5ac2400a2afc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2bbe2d7b793b234b8ec0b2eb2b7bf26b, https://si.imgix.net/50b412a8/uploads/origins/57801dd7-5570-4de1-955b-5ac2400a2afc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=2a7958b36ea5f05bce3438a962064f9a 2x, https://si.imgix.net/50b412a8/uploads/origins/57801dd7-5570-4de1-955b-5ac2400a2afc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=89775a263947959c4555d1d8e6411113 3x"}, "body": "初めましてリクエストさせていただきます。\n内容はお姉さん→少年のオナラ＋スカ責め\nお姉さんは酷いお便秘持ちです。\n①お姉さんが少年に顔面騎乗、ひどーいお便秘中のせいでここ最近は常にイライラ、えぐいストレスを解消すべく少年にえげつない毒ガスオナラ責め。\n②ここにくる途中便秘薬を飲んできたが便秘薬なんかどんなに飲んでも効く気配がないと呟くお姉さん。今回は相当ヤバいやつを飲んできた様です。その甲斐もあってかお姉さんのお腹の大腸が動いた様でお腹の中からえげつない音がし始めて…\n③お姉さん久しぶりにうんちを催す。\n少年の事などお構いなしに溜まりに溜まったお便秘を解消すべく、気持ちよさそうに排泄。\n台詞やキャラデザなどは書きやすい範囲で自由で構いません。\nよろしければ是非お願い致します。", "nc": 161, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@ogakuzugoten/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 448820, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/0c6c6ed8/uploads/origins/cb4d2aff-7bec-4f9c-9650-a37f07c95656?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=70391a16b1b2514db9aaa583128925ec", "srcset": "https://si.imgix.net/0c6c6ed8/uploads/origins/cb4d2aff-7bec-4f9c-9650-a37f07c95656?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=70391a16b1b2514db9aaa583128925ec, https://si.imgix.net/0c6c6ed8/uploads/origins/cb4d2aff-7bec-4f9c-9650-a37f07c95656?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=7998b6cf1c69f55c808ca0935f25dbdc 2x, https://si.imgix.net/0c6c6ed8/uploads/origins/cb4d2aff-7bec-4f9c-9650-a37f07c95656?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=4a664acac7fe171b598fc26328987b9a 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/0c6c6ed8/uploads/origins/cb4d2aff-7bec-4f9c-9650-a37f07c95656?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=eafa2fa2956a33aefc7a56dd0f661f63", "srcset": "https://si.imgix.net/0c6c6ed8/uploads/origins/cb4d2aff-7bec-4f9c-9650-a37f07c95656?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=eafa2fa2956a33aefc7a56dd0f661f63, https://si.imgix.net/0c6c6ed8/uploads/origins/cb4d2aff-7bec-4f9c-9650-a37f07c95656?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=e1db8a8b61b76021f45e8bdcce685471 2x, https://si.imgix.net/0c6c6ed8/uploads/origins/cb4d2aff-7bec-4f9c-9650-a37f07c95656?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=63a1564bd589fdf1832edd60463bad73 3x"}, "body": "オリジナルの女の子のイラストをお願いします。\n設定としては人体改造により放屁（と排泄物）を有毒物にした戦闘員という設定で\nハイティーンくらいの雰囲気で髪型は茶髪のショートカット、\nにやけたような目つきをしており、首から足先までを覆うラバースーツにガスマスクを着用\n（デザインは　https://www.dcm-ekurashi.com/images/goods/fujiwara/4984596235151_3.jpg　風）\nして、ラバースーツの肛門のところがホースのようになり手に持って前に向けている。\n\nシチュエーションとして\n①台詞で「さて、これからアンタに毒ガスぶっかけるわけなんだけどどう？今どんな気持ち？\n毒ガスって言ってもアタシのオナラなんだけどさ。\nもしかして興奮してる？メスガキに屁ぇぶっかけられる経験なんて無いでしょ？\nまー楽しんどきなよ。出るまでなにかわかんないし。\nひょっとしたら気持ちよーーーーーくおねむになるかもよ？\nじゃあいこっか、5、4、3、2、1…」\nと言いつつ、ニヤニヤしている。\n②台詞で「ゼロ！！\nオラっありがたくいただけよアタシのご褒美をさ！\nもっと嬉しそうな顔しなよオイ、鼻と口おっ広げて味わえよ。\nお？もう限界か？イッちゃいそう？逝っちゃいそうなの？\n最期の想い出にとびっきりのくれてあげようか？」\nガスが発生しているような演出で、表情はより相手を舐めているような顔でお願いします。\n③イきかけたような目つきになり、ホースから排泄物（液便混じりで、少し固形便も含まれているもの）が噴き出す。\n台詞で「はーいご褒美はアタシの黄金様でした！\nよかったねえ！最期にうれしーい想い出できたねえ！！\nどう？感想どう？気持ちい？嬉しい？ん？反応無し？\n\n…状況終了。直ちに帰還します」\nといった状況ごとの差分をお願いいたします。\n長い文章で失礼いたしました。", "nc": 168, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@ogakuzugoten/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 448820, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/5181da2e/uploads/origins/ee7f7547-2bc1-4cdf-a642-0d004beb298d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3122c882f43c2aef85cdd1c97a8e1383", "srcset": "https://si.imgix.net/5181da2e/uploads/origins/ee7f7547-2bc1-4cdf-a642-0d004beb298d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3122c882f43c2aef85cdd1c97a8e1383, https://si.imgix.net/5181da2e/uploads/origins/ee7f7547-2bc1-4cdf-a642-0d004beb298d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=07127ffd9d0366080cccf25f79ba10d7 2x, https://si.imgix.net/5181da2e/uploads/origins/ee7f7547-2bc1-4cdf-a642-0d004beb298d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=8462c5a2f8456a9a207dabd883ab54d7 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/5181da2e/uploads/origins/ee7f7547-2bc1-4cdf-a642-0d004beb298d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f0c4eca1089eedc5a66369f8562af5ba", "srcset": "https://si.imgix.net/5181da2e/uploads/origins/ee7f7547-2bc1-4cdf-a642-0d004beb298d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f0c4eca1089eedc5a66369f8562af5ba, https://si.imgix.net/5181da2e/uploads/origins/ee7f7547-2bc1-4cdf-a642-0d004beb298d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=7d7c148cf7f7cf039b90c151da192d54 2x, https://si.imgix.net/5181da2e/uploads/origins/ee7f7547-2bc1-4cdf-a642-0d004beb298d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=a4e3b54194a4eb77b8ce1924a6625641 3x"}, "body": "おがくず御殿さんの『お姉ちゃんたちの臭い責めっ！』から優花お姉ちゃんのシューズの臭い責めイラストをお願いします！\n　作中から一年後の設定。優花ちゃんと祐介君が勝負する。\n《勝負内容》\n・優花ちゃんが数年間一度も洗わなかったランニングシューズを祐介に嗅がせる。50回嗅いで消臭できれば祐介の勝ち。消臭できなければ優花ちゃんの勝ち。チンチンに触れてはいけないが、射精は何回してもいい。\n・勝負開始後、おもいっきり鼻で息を吸い込む祐介。全身が跳ねるように震えて射精してしまう。それを見てニヤニヤしながら応援する優花ちゃん。\n・鼻で50回深呼吸したがシューズの臭いは全く薄まっていなかったため優花ちゃんの勝利。祐介はびくびくと痙攣し、ぐったりしている。おちんちんからはだらだらと精液が垂れ流しの状態。\n優花ちゃんが「お鼻もおちんちんも限界みたいね。残念でした」と告げる。\n　優花お姉ちゃんは体操服か陸上ウェア姿で、祐介君はパンツだけはかせた姿でお願いします。", "nc": 185, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@ogakuzugoten/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 448820, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/3ba0b52e/uploads/origins/1b0a239f-4be0-41b5-8781-d720d4efcd27?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3707537545f5d278715eb536c96bd87b", "srcset": "https://si.imgix.net/3ba0b52e/uploads/origins/1b0a239f-4be0-41b5-8781-d720d4efcd27?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3707537545f5d278715eb536c96bd87b, https://si.imgix.net/3ba0b52e/uploads/origins/1b0a239f-4be0-41b5-8781-d720d4efcd27?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=76361f4af8ae5976c6a8961ac08c3414 2x, https://si.imgix.net/3ba0b52e/uploads/origins/1b0a239f-4be0-41b5-8781-d720d4efcd27?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=79bd3a38cf0c868d04b088e25a406a53 3x"