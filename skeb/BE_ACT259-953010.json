1-54ab-49b3-91ab-ea4b3c25cae6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9bea1634923d11de6d8fc36e418f984f", "srcset": "https://si.imgix.net/838da656/uploads/origins/c2780341-54ab-49b3-91ab-ea4b3c25cae6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9bea1634923d11de6d8fc36e418f984f, https://si.imgix.net/838da656/uploads/origins/c2780341-54ab-49b3-91ab-ea4b3c25cae6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=12f409dee2fe1c0a9245c6b2da042e3e 2x, https://si.imgix.net/838da656/uploads/origins/c2780341-54ab-49b3-91ab-ea4b3c25cae6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=b05c1340a337f2266d2fb7d93b22054c 3x"}, "body": "こんにちは あるいは こんばんは\n今回、宇和さんに描いていただきたいのは あびん娘 No.6 の室賀礼音というキャラです。\n低身長(160cm以下)、貧乳、犬歯、丸眼鏡、ウルフカットが主な特徴です。\n笑うとおバカっぽくも澄ましていたらそれなりに美人っぽくも見えるそんなキャラです。\nあまりスカートははかずパンツすたいるばかりですが、衣装はおまかせいたします。\n\n宇和さんの画風で描かれる礼音、楽しみにしておりますッ！\n\nhttps://x.com/AbhainnDeargsan/status/1934260084290498680?t=qgXSvkunM1ez-4E43Z_aYg&s=19", "nc": 177, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@BE_ACT259/works/11", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2622591, "client_id": 1845511, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/6d96230f/uploads/origins/f3f96f53-632e-420c-ad9a-b10cd843a13e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=80e8aa86b6f955e86ea6a18ec60ac9c4", "srcset": "https://si.imgix.net/6d96230f/uploads/origins/f3f96f53-632e-420c-ad9a-b10cd843a13e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=80e8aa86b6f955e86ea6a18ec60ac9c4, https://si.imgix.net/6d96230f/uploads/origins/f3f96f53-632e-420c-ad9a-b10cd843a13e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=d83d26cd245b695f085886b9c199d3ba 2x, https://si.imgix.net/6d96230f/uploads/origins/f3f96f53-632e-420c-ad9a-b10cd843a13e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=4bac442fa0b1fb910e82a765a548408b 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/6d96230f/uploads/origins/f3f96f53-632e-420c-ad9a-b10cd843a13e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=466b82ae17d94337f16b13633445f0c9", "srcset": "https://si.imgix.net/6d96230f/uploads/origins/f3f96f53-632e-420c-ad9a-b10cd843a13e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=466b82ae17d94337f16b13633445f0c9, https://si.imgix.net/6d96230f/uploads/origins/f3f96f53-632e-420c-ad9a-b10cd843a13e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=2259c327167e14dd2e053c63edd50049 2x, https://si.imgix.net/6d96230f/uploads/origins/f3f96f53-632e-420c-ad9a-b10cd843a13e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=9781eb6df45e1e69638efd10190b2cf8 3x"}, "body": "初めまして、しとろんと申します。\n\n【描いてほしいイラスト】\nピンク髪蒼目の女の子を描いて欲しいです。\n服装や髪型、絵の雰囲気、背景などはお任せします。\n自分の好みはくらげ・アイス・ピンクなのでそこからイメージしたものでも大丈夫です。\n\n【画像サイズ】\n描きやすいサイズで構いませんが、1280×720、800×800が好ましいです。\n\n【使用用途】\n私のYouTube(https://youtube.com/@cheese12280)の動画、生配信、サムネイル、アイコンでの使用を考えております。\nプリントアウトして大切に保管もしたいです。\n\n【その他備考】\nサインが有ると嬉しいです。\n\n急ぎのものではないので、体調や他にやる事優先で大丈夫です☺️\n宇和様の自由に描いていただければいいなと思っております！\nご検討いただけますと幸いです。\nよろしくお願いします。", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@BE_ACT259/works/10", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2622591, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/7a24b70a/uploads/origins/c81a57b2-c91d-4b43-917d-2e906d97f374?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=62920bb703e31c2ed682041a992c43