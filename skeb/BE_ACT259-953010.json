だいて大丈夫です)\nかなり個人的な癖での依頼ではありますがもう一度宇和さんの描かれる触手とナギサの絵が見たいのでもし可能でしたらどうかよろしくお願いいたします...！\n\nhttps://ek1mem0.wiki.fc2.com/upload_dir/e/ek1mem0/3c74447da2110f12d26773fb144df61c.jpeg", "nc": 168, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@BE_ACT259/works/9", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2622591, "client_id": 70074, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/ba0dbb97/uploads/origins/3390f1cd-f248-45ab-ba34-1a2d8acad8ba?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d4fc711e83f87f9887bca3c45bc16403", "srcset": "https://si.imgix.net/ba0dbb97/uploads/origins/3390f1cd-f248-45ab-ba34-1a2d8acad8ba?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d4fc711e83f87f9887bca3c45bc16403, https://si.imgix.net/ba0dbb97/uploads/origins/3390f1cd-f248-45ab-ba34-1a2d8acad8ba?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=9fc2e1da922e8087b3af6bd64ed3f03f 2x, https://si.imgix.net/ba0dbb97/uploads/origins/3390f1cd-f248-45ab-ba34-1a2d8acad8ba?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=fb95e700e96d0927d4f09b47ebbded04 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/ba0dbb97/uploads/origins/3390f1cd-f248-45ab-ba34-1a2d8acad8ba?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=35457a9f014e2abb55741e2b989a086a", "srcset": "https://si.imgix.net/ba0dbb97/uploads/origins/3390f1cd-f248-45ab-ba34-1a2d8acad8ba?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=35457a9f014e2abb55741e2b989a086a, https://si.imgix.net/ba0dbb97/uploads/origins/3390f1cd-f248-45ab-ba34-1a2d8acad8ba?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=66f78932dd10d920f274480888ed378e 2x, https://si.imgi