-85a5-f15ac0b48497?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=aed6d9488b7850e3a640117572d9ac46 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/94adea18/uploads/origins/f040e9f4-f041-4cb1-85a5-f15ac0b48497?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=34bbf79b98cc3730274d5bff28ab1953", "srcset": "https://si.imgix.net/94adea18/uploads/origins/f040e9f4-f041-4cb1-85a5-f15ac0b48497?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=34bbf79b98cc3730274d5bff28ab1953, https://si.imgix.net/94adea18/uploads/origins/f040e9f4-f041-4cb1-85a5-f15ac0b48497?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=2bebad5c22fecb47e4406324e6d395b6 2x, https://si.imgix.net/94adea18/uploads/origins/f040e9f4-f041-4cb1-85a5-f15ac0b48497?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=94769c429acbf50076abaa72aac53eb4 3x"}, "body": "こんにちは、手裏剣丸さん！私のキャラクターを描いていただけませんか？あなたの作品がとても好きで、私にぴったりだと思うんです！私はオニキス・オーロラという小さな新人VTuberです。ビクトリア朝ゴス時代を基にしたウサギの吸血鬼です。 よく焼き菓子、特にゼリー入りのものと関連付けられ、血やチェリーとも結びついています！普段は暗い風景の中にいることが多いです。ツンデレ気味で、気になる相手に対してはヤンデレになることもあります！ 驚くと耳がピンと立ちます！とても甘えん坊で、おちゃめな性格なので、普段の表情は得意げな顔！牙と大きな耳を自慢するのが大好きで、ほくろも大切な特徴です！キャラクターは、大きな耳をした彼女がマスコットと寝ている姿、または何かを食べている姿で描いていただけると嬉しいです。より良いアイデアがあれば自由にアレンジしてください！モルニエ、ザニ、イウノのようなキャラクターが好きです！\n\nご検討いただき誠にありがとうございます！以下にオリジナルキャラクターのデザインシートを添付します；https://drive.google.com/drive/folders/1Vr1PIIIu9x-KNtanhFXaeZiMs932r7BO?usp=drive_link", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@syurikenmaru/works/10", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3803226, "client_id": 1568943, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/6eae2970/uploads/origins/e15cee5c-e90b-4371-92be-434d034119a