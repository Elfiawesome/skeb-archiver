n\n元々ゲームのキャラクターなのですが、擬人化して頂きたいと思っております。\n普段はセーラー服を着ているのですが、下の設定以外はおまかせで、お洋服などぜひ自由に描いて欲しいです。\n全体的な雰囲気はピンク・キラキラ・リボンだと嬉しいです。\n髪の毛もツインテールの子なのですが、これより伸ばしていただいても構いません！\n\n 細かい設定 \n女の子（19歳くらい）\n首のチョーカー \nうさぎのヘアゴム\n 耳ピアス（色はピンクでも黒でも大丈夫です） \nまつ毛バッチリ\nその他表情、ポーズなどご自由に描いてほしいです。 \n\n何卒ご検討よろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/1-2A8WrV1S25q54TO2Wt5yY58-urrxbqB", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Raika_555/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3524967, "client_id": 3463393, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/cadce2ab/uploads/origins/17edb604-759c-4174-ae52-967ccbf744cc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=918317d96c7504dda1ed664d345b99b7", "srcset": "https://si.imgix.net/cadce2ab/uploads/origins/17edb604-759c-4174-ae52-967ccbf744cc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=918317d96c7504dda1ed664d345b99b7, https://si.imgix.net/cadce2ab/uploads/origins/17edb604-759c-4174-ae52-967ccbf744cc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=760fcfdcaa66afa2a081c74052cecbc8 2x, https://si.imgix.net/cadce2ab/uploads/origins/17edb604-759c-4174-ae52-967ccbf744cc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=bfcb2989ea3e79fc359007af8a98e68f 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/cadce2ab/uploads/origins/17edb604-759c-4174-ae52-967ccbf744cc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b40b95b59bb5f0f6f263adae3342ddb0", "srcset": "https://si.imgix.net/cadce2ab/uploads/origins/17edb604-759c-4174-ae52-967ccbf744cc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b40b95b59bb5f0f6f263adae3342ddb0, https://si.imgix.net/cadce2ab/