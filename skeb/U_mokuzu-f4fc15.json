どです。\n納品のデータサイズはお任せ致します。\n納品形式はPSDファイルで、背景と人物、文字は別レイヤーにしていただけるととても助かります。\n\n金額不足などの場合は再送要求、依頼がうみもの様の意図にそぐわない場合はキャンセルをお願いします。\nご縁がありましたら、是非よろしくお願いします。\n\nhttps://x.com/hoshikage_yu_\nhttps://x.com/hoshikage_yu_/status/1835823940415168895", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@U_mokuzu/works/2", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/c8a77c27/uploads/origins/f9544818-6295-42f5-b65a-4d3138253ce4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=922f1b2f9140adcb389cea35ec0d9459", "srcset": "https://si.imgix.net/c8a77c27/uploads/origins/f9544818-6295-42f5-b65a-4d3138253ce4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=922f1b2f9140adcb389cea35ec0d9459, https://si.imgix.net/c8a77c27/uploads/origins/f9544818-6295-42f5-b65a-4d3138253ce4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=f5ff8b437fbfb736e327e5f1f2b02707 2x, https://si.imgix.net/c8a77c27/uploads/origins/f9544818-6295-42f5-b65a-4d3138253ce4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=33505196b0616d2b429d95fb225d8b76 3x"}, "private": true, "genre": "art", "tipped": false, "creator_id": 2241087, "nc": 129}, {"path": "/@U_mokuzu/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2241087, "client_id": 460270, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/9f6b6cb3/uploads/origins/2922a715-a872-45a9-8956-44c0f0cadf11?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&cr