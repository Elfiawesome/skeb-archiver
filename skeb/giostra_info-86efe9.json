=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=076bb2cdcf1d210d64c0bcfbda183802", "srcset": "https://si.imgix.net/44f2a2b8/uploads/origins/3a0e95c1-75f6-464e-98c2-a302a9de508b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=076bb2cdcf1d210d64c0bcfbda183802, https://si.imgix.net/44f2a2b8/uploads/origins/3a0e95c1-75f6-464e-98c2-a302a9de508b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=137c813c755cf80c6711c8656b3d595c 2x, https://si.imgix.net/44f2a2b8/uploads/origins/3a0e95c1-75f6-464e-98c2-a302a9de508b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=90420cb5f14ad07c98ea3291359af453 3x"}, "body": "こんにちは、背景写真をお願いしたいのですが。\n\n架空の島の航空写真を描いていただけませんか？\n\n巨大なモンスターを操る力を持った人間を養成する全寮制の学校がある架空の島。世界設定は、現在の世界よりもある程度技術が進んでいた世界。\n\n島には次のようなものが欲しい。\n-ドック。\n-空港。\n-アカデミーエリア\n-居住エリア（寮、家、広場）。\n-大型モンスターバトルスタジアム\n-ビーチ、森など\n\n私のOC学生デザイン\n\nhttps://drive.google.com/drive/folders/1NLA2Ot4DiHZ1cP10n_lgxSpXI5fxDRQ7?usp=sharing", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@giostra_info/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 373624, "client_id": 32470, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/581bacf6/uploads/origins/2845dd13-32a6-451e-9d2d-04a918489997?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=691f44b30ccf48b6c6525a23b1b5247f", "srcset": "https://si.imgix.net/581bacf6/uploads/origins/2845dd13-32a6-451e-9d2d-04a918489997?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=691f44b30ccf48b6c6525a23b1b5247f, https://si.imgix.net/581bacf6/uploads/origins/2845dd13-32a6-451e-9d2d-04a918489997?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=430e6efc50c84994934d5bf90245bb0b 2x, https://si.imgix.net/581bacf6/uploads/origins/2845dd13-32a6-451e-9d2d-04a918489997?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e8dae7f1d78e67d5bf7c1b2974c17c13 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/581bacf6/uploads/origins/2845dd13-32a6-451e-9d2d-04a918489997?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=1d0d6de32fc0da01e22edefe138cc8cc", "srcset": "https://si.imgix.net/581bacf6/uploads/origins/2845dd13-32a6-451e-9d2d-04a918489997?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=1d0d6de32fc0da01e22edefe138cc8cc, https://si.imgix.net/581bacf6/uploads/origins/2845dd13-32a6-451e-9d2d-04a918489997?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=2580d91bd43990d22e19315a7300ffb5 2x, https://si.imgix.net/581bacf6/uploads/origins/2845dd13-32a6-451e-9d2d-04a918489997?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=3a8d00c6f3aba1debad9dc603fd2074e 3x"}, "body": "先ほどの依頼、ありがとうございました！とても気に入りました！\n\n別の背景も依頼したい。マッドサイエンティストと錬金術師の研究所をイメージした背景です。\n\n・人がいない \n・ファンタジーな錬金術とハイテクな近代設備が混在している\n・サイズ：教室程度の大きさ\n・色：白い壁、滑らかな中間色の床（ほとんどきれいですが、以前の事故による変色箇所があります）、青いキャビネットと引き出し（color scheme reference.jpeg)\n・実験を行う主なテーブル\n　・ビーカー、小瓶、塩の入ったガラス瓶、紙、ブンゼンバーナー\n　・机に取り付けられた大きなメカニカルアームの先にはランプとコンピューターの画面がある（mechanical arms reference.jpeg、ただしアームは天井ではなく机に取り付けることができる）\n　・机の下の床に刻まれた魔法陣\n・部屋の周囲長\n　・本棚\n　・シンクの近くに試験管乾燥用のラックを設置 (color scheme reference.jpeg)\n　・予備の備品を収納したキャビネット（color scheme reference.jpeg）\n　・錬金術師の邪魔にならないように観察者が部屋を覗けるようにするためのガラス窓（glass window reference.jpg）\n　・特定の道具や大きな機械を置くためのステーション（stations reference.jpg）\n\nよろしくお願いいたします！\n\nhttps://ln5.sync.com/dl/0f9d5d780/xyifnqet-mmgmkvjb-d8yq6g4p-pi2wqv8g", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@giostra_info/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art",