の悪い実験用マウスですが、それでも可愛く見せようと頑張っています。お好きな服装を選んでください。ポーズと構図はご自由に決めていただいて結構です。ご検討いただきありがとうございます！\n\nhttps://drive.google.com/drive/folders/1VK6UlwJKZKA_SLjKywsiRlC6SqpgeEfd?usp=sharing", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@zz_0100/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3496098, "client_id": 3787177, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/fd4bfc15/uploads/origins/0d75ea03-224a-4b01-b440-bc6326021337?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=135c5bd574e4eaa711273e00282594ad", "srcset": "https://si.imgix.net/fd4bfc15/uploads/origins/0d75ea03-224a-4b01-b440-bc6326021337?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=135c5bd574e4eaa711273e00282594ad, https://si.imgix.net/fd4bfc15/uploads/origins/0d75ea03-224a-4b01-b440-bc6326021337?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=0dfc233a18efea789a2de8dbe78e4a4d 2x, https://si.imgix.net/fd4bfc15/uploads/origins/0d75ea03-224a-4b01-b440-bc6326021337?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=80322879570f9d2563fe206b5866e35b 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/fd4bfc15/uploads/origins/0d75ea03-224a-4b01-b440-bc6326021337?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a047e67c1007a4c93963a676299f9578", "srcset": "https://si.imgix.net/fd4bfc15/uploads/origins/0d75ea03-224a-4b01-b440-bc6326021337?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a047e67c1007a4c93963a676299f9578, https://si.imgix.net/fd4bfc15/uploads/origins/0d75ea03-224a-4b01-b440-bc6326021337?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=54b13ac6082b63b515519853d46a1a2a 2x, https://si.imgix.net/fd4bfc15/uploads/origins/0d75ea03-224a-4b01-b440-bc6326021337?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=d2e9468e889ede0cc7211ae1c4ff7aa5 3x"}, "body": "こんにちは！\nはじめまして！\n\n「HempieVT」というVTuberのイラストをお願いしたいです。\n彼女は普段から眠そうで、少しぼんやりとした雰囲気をしており、目の下にクマがあります。\nまた、髪に赤いストライプがあり、瞳の中にはX（エックス）型の模様があります。\n添付の参考画像のどの衣装を使っていただいても大丈夫です。\n\nポーズや構図、雰囲気などはすべておまかせします。\n自由に、あなたの思うままに描いていただけると嬉しいです。\n\nHempieは、上官の命令に逆らったためにチェルノブイリの立入禁止区域に追放されたスリーパーエージェントです。\n放射線の影響で彼女自身も放射性を帯びており、孤独の中で廃墟の建築や放棄された軍用車両、武器（SVD、DP-27など）を研究しながら静かに暮らしています。\nまた、酒に酔うのが好きで、時々飲みすぎてしまうこともありますが、それでも楽しんでおり、よく飲んでは物思いにふけり、時々タバコを吸うこともあります。\n\n彼女のそばには、放射能の影響で変異したマスコットの「Pyp（ピップ）」がいます。\nPypは小さな粘性のある生物で、手足がなく、頭上に光る輪（ハロー）が浮かんでおり、いつもHempieの頭の上や近くにいます。\n\nこのキャラクターは、『serial experiments lain（シリアルエクスペリメンツ・レイン）』や『少女終末旅行』のような作品に影響を受けています。\n静けさ、不安定さ、そして虚無感を感じるトーンで表現していただけると嬉しいです。\n\nどうぞよろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/1HKpUvqulI6HbCdDdFmdSel-kAK-mqZ6k?usp=drive_link", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 502032, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "リャク@じそ10 後日通販準備中", "screen_name": "ryaku_i", "avatar_url": "https://pbs.twimg.com/profile_images/1642178593399934977/zKiyVah1.jpg", "header_url": "https://pbs.twimg.com/profile_banners/717645010515038208/1636878472/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "art"}, {"genre": "comic"}], "nc": 17}, {"id": 732869, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "升由るむ🍄", "screen_name": "Masuyu_rumu", "avatar_url": "https://proxy.misskeyusercontent.jp/avatar.webp?url=https%3A%2F%2Fmedia.misskeyusercontent.jp%2Fio%2F05e01b1d-20dd-49db-a138-f12f6cb5f2bf.