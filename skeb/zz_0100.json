正体を知るようになる。\n\n赤は釣りや宝探しが好きです(釣り竿を使うことも、手で捕まえることもできる)。野外でキャンプする時は、キャンプの準備から薪集め、採集、料理まで全て自分でこなす。王族だから、青はたいてい本を読みながら準備が終わるのを待っている。赤は気にしない。彼らは夕食後、魚の骨でミカドをよく遊ぶ。\n\n人間の姿でも非人間的な姿でも、先生にお任せします。背景は屋外を希望しますが、構図はご自由に決めてください。没ラフや下描きなどがあればPSDに残したままにしていただけると嬉しいです。ご配慮ありがとうございます！\n\nhttps://drive.google.com/drive/folders/12NJnudxFS-vrH-gcPVmDeka7cw8J451t?usp=sharing", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@zz_0100/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3496098, "client_id": 1593571, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/6985f7e5/uploads/origins/957b9b7c-8016-4287-acaa-2f683c582232?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=15de67a214b9308bf81c1065d27122f1", "srcset": "https://si.imgix.net/6985f7e5/uploads/origins/957b9b7c-8016-4287-acaa-2f683c582232?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=15de67a214b9308bf81c1065d27122f1, https://si.imgix.net/6985f7e5/uploads/origins/957b9b7c-8016-4287-acaa-2f683c582232?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=19eecb0df070ce7cfe48ee1118c1c83a 2x, https://si.imgix.net/6985f7e5/uploads/origins/957b9b7c-8016-4287-acaa-2f683c582232?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=3be9894cb0e772a0627a9277c552deee 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/6985f7e5/uploads/origins/957b9b7c-8016-4287-acaa-2f683c582232?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=578af21b79441a836532d47b76acf4f1", "srcset": "https://si.imgix.net/6985f7e5/uploads/origins/957b9b7c-8016-4287-acaa-2f683c582232?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=578af21b79441a836532d47b76acf4f1, https://si.imgix.net/6985f7e5/uploads/origins