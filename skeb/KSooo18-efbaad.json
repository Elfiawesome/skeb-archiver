f-2ec3235b8e4f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e4517dcb867e19b286bd012eeb1f3393, https://si.imgix.net/b771b8ea/uploads/origins/5e66f9c6-7578-4564-8d3f-2ec3235b8e4f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=b05765c32c21b1dbc2f47b486f063931 2x, https://si.imgix.net/b771b8ea/uploads/origins/5e66f9c6-7578-4564-8d3f-2ec3235b8e4f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=18d6630530e5dad003af502a11998362 3x"}, "body": "せき様、初めまして。\nYouTubeで配信活動をしております、月映りこ（つきは りこ）と申します。\n\nせき様のナイトレイン関連のイラストを拝見し、どの作品もとても素敵で、ぜひ私のオリジナルキャラクターもせき様に描いていただけたらと思い、ご依頼させていただきました。\n\n◆依頼内容\n私のオリジナルキャラクターを、ナイトレインの「復讐者」をイメージした雰囲気で描いていただけましたら嬉しいです。\n\n構図、背景、キャラクターの髪型・衣装・ポーズなどは、すべてせき様にお任せいたします。\nぜひ、せき様の世界観や解釈で自由に描いていただけましたら幸いです。\n\n◆使用用途\n・YouTube配信のサムネイル、配信画面などの配信素材\n・Xなど各種SNSでの使用\n・グッズへの使用販売（Tシャツ等を含む商用利用）\n商用利用をする際には、せき様に描いていただいたイラストであることを分かる形で明記いたします。\n\n◆希望納品形式\n可能でしたら、\n・人物のみの透過データ\n・背景\nなどを分けた状態で納品いただけますと大変助かります。\nただし、こちらは必須ではございませんので、難しい場合はご放念ください。\nデータ形式はPNG、もしくはPSDを希望しております。\n\n◆その他\n添付資料や依頼内容、金額などに不都合がございましたら、リクエストの再送をお願いいたします。\n\nどうぞよろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/113o0rCZV3lrI_3eRSvCzPd6F6YS5S1kl?usp=drive_link", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@KSooo18/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3483716, "client_id": 2763377, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/dcbe05c6/uploads/origins/f09014ed-a20a-466b-a5d0-4d6ede21b451?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=71ad7549aa678a7b4e7b2823b1d8f0ce", "srcset": "https://si.imgix.net/dcbe05c6/uploads/origins/f09014ed-a20a-466b-a5d0-4d6ede21b451?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=71ad7549aa678a7b4e7b2823b1d8f0ce, https://si.imgix.net/dcbe05c6/uplo