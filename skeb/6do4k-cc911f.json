nろく 原稿さんの雰囲気があり、色彩も綺麗なイラストを拝見し、ぜひイラストを描いていただけないかと思いご連絡させていただきました。下記ご検討くださいませ！\n\n▶依頼内容\n・クレア（女性）とアニエス（妖狐の男性）のイラストをそれぞれご依頼したいです\n・髪型、ポーズ、表情などお任せします。クレアについては可能であれば口を開ける、手を上げるなどして元気なイメージが伝わってくると嬉しいです。\n・サムネで使用したいため、2人のデータは個別、かつ頭や手などキャラクターが切れないようなデータですと嬉しいです。\n\n▶︎使用用途\n・Twitter等のSNSでの使用（アイコン・宣伝ツイート等）\n・YouTubeで配信する際の動画・サムネイル（収益化済）\n・メンバーシップの返礼（壁紙配布など）\n\n▶︎サイズや解像度について \n・サムネイル（1600px×900px）に使用した際に粗くならないサイズが希望です。\n\n▶︎希望の納品形式について\n・PSD\n・背景、人物、サインはレイヤー分けいただけると幸いです。\n\n▶参考YoutubeCH\nhttps://www.youtube.com/@Inanari\n\nご縁がありますように。よろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/1f_lukt44ChhR4FdEl9Olfx272k2VFodz?usp=sharing", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@6do4k/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1557453, "client_id": 2297374, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/ab6ae986/uploads/origins/12b28245-41cd-43c0-b05b-48068098f6ce?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2617a6c59705585a0e28fe8a9ffe7f9f", "srcset": "https://si.imgix.net/ab6ae986/uploads/origins/12b28245-41cd-43c0-b05b-48068098f6ce?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2617a6c59705585a0e28fe8a9ffe7f9f, https://si.imgix.net/ab6ae986/uploads/origins/12b28245-41cd-43c0-b05b-48068098f6ce?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=eaf7e81eb660d8e9497c72ebe25d94fb 2x, https://si.imgix.net/ab6ae986/uploads/origins/12b28245-41cd-43c0-b05b-48068098f6ce?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=961ade6a7f2bad90ddf5bdcba3f8cd93 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/ab6ae986/uploads/origins/12b28245-41cd-43c0-b05b-48068098f6ce?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=40c59d0ed1ce