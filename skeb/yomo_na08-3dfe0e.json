haracter! 🦑\n\nCould you draw my Inkling character? Her name is Isabella. She is a very brave and confident girl who loves Anarchy Battles. She also loves her Forge Splattershot Pro, it is her favorite weapon.\n\nI'll leave the pose and details up to you, you can draw her however you like! Thank you!\n\nHer picture and outfit is here: https://drive.google.com/drive/folders/1zQC8sywKHxlicJVxIVAn6hae2T4sZtVY?usp=sharing", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@yomo_na08/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1986445, "client_id": 1071279, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/7a7f41c9/uploads/origins/486b09cf-3324-4bd3-9254-660022822cf5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7a4a9047fc32f6c549bf18b8fe556b70", "srcset": "https://si.imgix.net/7a7f41c9/uploads/origins/486b09cf-3324-4bd3-9254-660022822cf5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7a4a9047fc32f6c549bf18b8fe556b70, https://si.imgix.net/7a7f41c9/uploads/origins/486b09cf-3324-4bd3-9254-660022822cf5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b0665ef1c3d4916164d1a3872bfb5656 2x, https://si.imgix.net/7a7f41c9/uploads/origins/486b09cf-3324-4bd3-9254-660022822cf5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c3c544ecefe8c6b62888587ea5b1a0b5 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/7a7f41c9/uploads/origins/486b09cf-3324-4bd3-9254-660022822cf5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=7f812c9f1839678c62ced236b419d45d", "srcset": "https://si.imgix.net/7a7f41c9/uploads/origins/486b09cf-3324-4bd3-9254-660022822cf5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=7f812c9f