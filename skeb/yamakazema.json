ジョ=アサヒを見下ろす様に、その暴獣は綾香市に君臨するのだった」\nというイメージで描いて頂きたいです。\n\n以上です。\nご検討のほど、何卒宜しくお願い申し上げます！", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@yamakazema/works/35", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 257825, "client_id": 0, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/3626624d/uploads/origins/a852ed46-ab44-45dc-9233-3f385dd6e1d7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=06aa51d686bcad51b2cd0b7e841379f8", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": true, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/3626624d/uploads/origins/a852ed46-ab44-45dc-9233-3f385dd6e1d7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=1ff76be39e568e105e15d6488398ac66", "src_set": ""}, "body": "金栗さんのデルタンダルさんとアースガロンさんで後背位ふたなりレズセックスイラストをお願いします。\n\nデルタンダルさんは脱皮したてで全身粘液まみれの全裸でアースガロンさんがふたなりでスカートだけ脱いだ状態でデルタンダルさんのお尻を鷲掴みしながらふたなりオチンチン(亀頭はピンクで陰茎はアースガロンさんの肌と同色で玉無し)をデルタンダルさんのパイパンマンコに挿入して精液中出し。\n\nリクエスト内容は以上となります。\n是非ともお願いいたします。", "nc": 43, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@yamakazema/works/34", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 257825, "client_id": 67033, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/ff2a6324/uploads/origins/524eceb0-7250-4d54-8260-1ee77e053a09?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=73d31ac5e4dc46fc28ebbc045dc0c474", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/ff2a6324/uploads/origins/524eceb0-7250-4d54-8260-1ee77e053a09?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=21f93f2c45f002f08d83cef122d257b6", "src_set": ""}, "body": "スターヴに続きグリーディーの女体化を描いていただきありがと