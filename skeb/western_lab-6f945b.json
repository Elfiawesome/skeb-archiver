ヘッダーなどに使用させていただく可能性があります。\nアピールに記載されていた金額でリクエストさせていただきました。金額調整や不明点があれば再送要請を頂ければ対応いたします。\n不慣れな部分もあるかと思いますが、どうぞよろしくお願いいたします！\n\nhttps://drive.google.com/drive/folders/17lDpu7_o3KTML0mINdeSK9Sq1NoUNtEC?usp=sharing", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@western_lab/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3553458, "client_id": 3202353, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/117734f5/uploads/origins/266b30cc-3712-40dd-9140-14d9092cb6ee?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6194aa44f91ac6262456e7f5eab55aad", "srcset": "https://si.imgix.net/117734f5/uploads/origins/266b30cc-3712-40dd-9140-14d9092cb6ee?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6194aa44f91ac6262456e7f5eab55aad, https://si.imgix.net/117734f5/uploads/origins/266b30cc-3712-40dd-9140-14d9092cb6ee?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=0d3f2475fa08e2123707fadf4e5b207a 2x, https://si.imgix.net/117734f5/uploads/origins/266b30cc-3712-40dd-9140-14d9092cb6ee?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=2802bf659f9ae3094989742beb8bfbcb 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/117734f5/uploads/origins/266b30cc-3712-40dd-9140-14d9092cb6ee?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3e791c7f452474823374cbb99795d1c7", "srcset": "https://si.imgix.net/117734f5/uploads/origins/266b30cc-3712-40dd-9140-14d9092cb6ee?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3e791c7f452474823374cbb99795d1c7, https://si.imgix.net/117734f5/uploads/origins/266b30cc-3712-40dd-9140-14d9092cb6ee?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=2eab905097732