913f-0c87b9ebb30d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=51996d2651e1c8303a2eeca425d78673, https://si.imgix.net/a8f4d8bf/uploads/origins/1b9b0060-6521-453f-913f-0c87b9ebb30d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=dd693fa98497128b64a7918cd13754be 2x, https://si.imgix.net/a8f4d8bf/uploads/origins/1b9b0060-6521-453f-913f-0c87b9ebb30d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=13ad78d1dd4cae70fd9169650297ed4c 3x"}, "body": "よろしく！リクエストするお願いしたいです。\n\nグラブルのクビラです。\n最近のイベントから、スケベな温泉の状況を見たくなりました。\nシナリオはクビラが自分で温泉に行く。クビラは一人だけど、スケベ男が女性のエリアに忍び込む。抗議と混乱にもかかわらず、男はクビラにレイプする。\n・ポーズは胸と挿入されたオマンコが見える限り何でも構いません。たとえば、足を持ち上げた状態で壁や岩に押し付けられます。 または下から見た後背位。\n・危ない日だからクビラが心配。パニックになった顔を描いてください。\n・胸の下に引っ張られたタオルを着ているのを見るのは素晴らしいことです。そうでなければ全裸も良いです。\nありがとうございます！", "nc": 169, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@f_tera222/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 927725, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/e519232c/requests/276218_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=35b7fa549e6a393e90fb9b4859abb35f", "srcset": "https://si.imgix.net/e519232c/requests/276218_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=35b7fa549e6a393e90fb9b4859abb35f, https://si.imgix.net/e519232c/requests/276218_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=4a9e6c0bca26b38cb016292940c49db1 2x, https://si.imgix.net/e519232c/requests/276218_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=fb531b7d9d61b28db542791ee6a947af 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/e519232c/requests/276218_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=45a1026705e67952a2f724a2bbcfd76a", "srcset": "https://si.imgix.net/e519232c/requests/276218_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=45a1026705e67952a2f724a2bbcfd76a, https://si.imgix.net/e519232c/requests/276218_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=f9786fdcef6c68fd95ecc03080cd4fae 2x, https://si.imgix.net/e519232c/requests/276218_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=22d49329345322ab03f714597488980d 3x"}, "body": "はじめまして。リクエストをお願いします。\nキャラクターはグランブルーファンタジーのイルノート\nイルノートは絵を描くつもりの町に到着しますが、この町には非常に厳しい破壊行為法があります。すぐに逮捕されます。イルノートの厳しい罰は公共の肉便器として役立つことです。\n・何らかの身体拘束があります。 たとえば、ギロチンボード、晒し台、またはロープ。 顔、胸、挿入されたオマンコが見える限り、ポーズは裁量です。\n・全裸にしてください。ただし、メガネとヘッドバンドは外さないでください。\n・イルノートには反抗の表情 があります\nどうもありがとうございました！", "nc": 185, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}], "sent_works": [], "similar_creators": []}, "price_history": {"art": [{"amount": 53000, "recorded_at": 1783254986.847706}]}, "custom": {}}