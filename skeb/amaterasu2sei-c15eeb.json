 and the other is round raccoon.\n\n I have attached the details in the Google Drive. Hope it's possible to follow the pose reference. \n\nCould you provide data (PSD, etc.) that is layered with the background and the character. if possible? Thank you!\n\nThe art will be used as follows:\n・ SNS Posting / Promotion\n・ SNS icons and headers\n・ YouTube / Twitch \n\nThank you for your time and for considering me.\n\nhttps://drive.google.com/drive/folders/1TFMOAQS-YFi-IT08fdmCkcpvEGSnrXZZ?usp=sharing", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@amaterasu2sei/works/14", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3977814, "client_id": 677909, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/2317120c/uploads/origins/7450a76e-5812-4b43-8fc3-607514c8a878?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=de0abf942581734e718008ad761ee98e", "srcset": "https://si.imgix.net/2317120c/uploads/origins/7450a76e-5812-4b43-8fc3-607514c8a878?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=de0abf942581734e718008ad761ee98e, https://si.imgix.net/2317120c/uploads/origins/7450a76e-5812-4b43-8fc3-607514c8a878?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=fd3618431eb2cbacc2b9a9846d0caae7 2x, https://si.imgix.net/2317120c/uploads/origins/7450a76e-5812-4b43-8fc3-607514c8a878?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=09b80d5d79ef5064f3fe3e32069e824c 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/2317120c/uploads/origins/7450a76e-5812-4b43-8fc3-607514c8a878?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=4730fa976b4ef64068f405b72fae1390", "srcset": "https://si.imgix.net/2317120c/uploads/origins/7450a76e-5812-4b43-8fc3-607514c8a878?bg=%23ff