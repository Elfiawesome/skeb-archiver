切ってご依頼させていただきました。\n\nもしご縁がございましたら、とても嬉しいです。\nまた、金額や依頼内容について問題がございましたら、キャンセルまたは再送のご要請をいただけますと幸いです。\n\nどうぞよろしくお願いいたします。\n\n参考資料：https://drive.google.com/drive/folders/1sj0snrIvtCiY-umbSgfvObfsCVvYMEEr?usp=sharing\n\nhttps://drive.google.com/drive/folders/1sj0snrIvtCiY-umbSgfvObfsCVvYMEEr?usp=sharing", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}], "sent_works": [], "similar_creators": [{"id": 438601, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "ツキノワグマ三世　@頑張るぞ能登💪", "screen_name": "tsukikumathird", "avatar_url": "https://pbs.twimg.com/profile_images/1902740995885993984/7Kt6r82w.jpg", "header_url": "https://pbs.twimg.com/profile_banners/715398786/1742483955/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "art"}], "banned": false, "nc": 16}, {"id": 2800607, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "徳井淡青", "screen_name": "tansei_tokui", "avatar_url": "https://pbs.twimg.com/profile_images/1797145576242614272/OIdSXWoS.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1199993541428015107/1752328430/1500x500", "appeal_receivable": true, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "art"}], "banned": false, "nc": 49}, {"id": 3310799, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "佐々木憂凪", "screen_name": "sasaki_youna", "avatar_url": "https://pbs.twimg.com/profile_images/1945902092368949248/4a97lKlf.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1179797836545683456/1744512313/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_maste