dpr=3&fit=crop&crop=top&w=200&h=200&s=535ada0122d56de10c638d0695c93238 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/c4a2c76d/uploads/origins/895e95d6-f05a-4f29-9bc1-16ffbbead31b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=99a6a8b14fa052c9be083c9ba4e1d06d", "srcset": "https://si.imgix.net/c4a2c76d/uploads/origins/895e95d6-f05a-4f29-9bc1-16ffbbead31b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=99a6a8b14fa052c9be083c9ba4e1d06d, https://si.imgix.net/c4a2c76d/uploads/origins/895e95d6-f05a-4f29-9bc1-16ffbbead31b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=cc3777fdf59873908ea4b23560746e72 2x, https://si.imgix.net/c4a2c76d/uploads/origins/895e95d6-f05a-4f29-9bc1-16ffbbead31b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=60ba6c689d873decd6ffd2d161d2dd49 3x"}, "body": "ぴめちゃんのイラストかわいくて大好きです！！\nぴめちゃんに描いていただきたいと思い、リクエスト送らせていただきました！\n\n〇イラスト詳細\n髪色：ピンク（青み系ではないです）\n\n〇使用用途\nSNSや配信活動での使用\nFANBOXへの掲載\n可能であれば人物のみのデータもいただけると嬉しいです。\n\n検討のほどよろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/1vPgekDKvH-CBpNDiN9cbd_EIDwqbG1Gz?usp=sharing", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@akaru_ronron/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 4008948, "client_id": 2739171, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/953cb761/uploads/origins/f4628ed7-4a33-49ee-a81b-906ace732238?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=80cb4ca2c5727b0057d187a050052d88", "srcset": "https://si.imgix.net/953cb761/uploads/origins/f4628ed7-4a33-49ee-a81b-906ace732238?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=80cb4ca2c5727b0057d187a050052d88, https://si.imgix.net/953cb761/uploads/origins/f4628ed7-4a33-49ee-a81b-906ace732238?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=41d11cc28866e4084b976ca18e5ae42a 2x, https://si.imgix.net/953cb761/uploads/origins/f4628ed7-4a33-49ee-a81b-906ace732238?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=6dbdce18704df630666ffba6a2ab5450 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/953cb761/uploads/origins/f4628ed7-4a33-49ee-a81b-906ace732238?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=586a436480d9cc07a175607f4331ea13", "srcset": "https://si.imgix.net/953cb761/uploads/origins/f4628ed7-4a33-49ee-a81b-906ace732238?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=586a436480d9cc07a175607f4331ea13, https://si.imgix.net/953cb761/uploads/origins/f4628ed7-4a33-49ee-a81b-906ace732238?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=5930bf924d0e0917196fc54d8e4c4d56 2x, https://si.imgix.net/953cb761/uploads/origins/f4628ed7-4a33-49ee-a81b-906ace732238?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=bf56979d2fb1313438325a3e6de2e441 3x"}, "body": "個人VTuberとして活動しております、あるばいとしまむらと申します。\n\nいつもあかる様のイラストを拝見しており、女の子の表情や雰囲気がとても可愛らしく、ぜひ描いていただきたいと思い、リクエストを送らせていただきました。\n\n－－－－－－－－－－－－－－－－－－－－\n\n【使用用途】\n・収益化済みの配信サイトでの使用\n・SNSでのPR全般\n・活動用サムネイルなど\n\n【キャラクター】\n参考資料を添付いたします。\n\n【依頼内容】\n参考資料のジャージメイド衣装ではなく、あかる様のお好みで、別のお洋服を着たイラストを描いていただきたいです。\n\n私服・ロリータ・学生服・アイドル衣装風など、あかる様が描きやすい衣装や、お好きな衣装をあるばいとしまむらに着せていただけましたら嬉しいです。\n\n構図や表情なども、基本的にあかる様におまかせしたいです。\nもし「完全おまかせだと描きづらい」という場合は、メスガキ・いたずらっ子っぽい雰囲気で描いていただければと思います…！\n\nアバウトなお願いとなってしまい恐縮ですが、どうぞよろしくお願いいたします。\n\n－－－－－－－－－－－－－－－－－－－－\n\nあかる様の描かれる、魅力的な表情の女の子のイラストが大好きで、今回思い切ってご依頼させていただきました。\n\nもしご縁がございましたら、とても嬉しいです。\nまた、金額や依頼内容について問題がございましたら、キャンセルまたは再送のご要請をいただけますと幸いです。\n\nどうぞよろしくお願いいたします。\n\n参考資料：https://drive.g