d6-d919-49a7-a6bd-f54d0f0901ca?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c0034e5c95e61425a74618fcaa3cd91b, https://si.imgix.net/9b4b45a0/uploads/origins/2238f0d6-d919-49a7-a6bd-f54d0f0901ca?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=cbc4ad8b8590faafc73ee264aa212994 2x, https://si.imgix.net/9b4b45a0/uploads/origins/2238f0d6-d919-49a7-a6bd-f54d0f0901ca?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=cc239b0bb066d2382d87d7e792eed870 3x"}, "body": "작가님, 늦어서 죄송합니다 .ㅠㅠ. 약속해주신 대로 커미션 신청합니다. 이번에는 신데마스 웨딩 비키니 하야테와 제 최애캐이자 프로필 캐인 이누야샤의 키라라(빨간 스카프 버전)의 커플 원 샷을 신청하고 싶습니다.\n\n밑의 링크는 주소입니다.\n\n하야테 예시 이미지는 01-22, 키라라 예시 이미지는 44-52입니다.\n\n이번 코스튬은 웨딩 비키니(22-43) 입니다. 기본적으로 디자인은 자유입니다. 색상도 기본 흰색이지만 만약 보조색이나 악세사리들은 파란색이나 혹은 흰색과 어울리는 다른 색 넣고 싶으시면 됩니다. 어디까지나 작가님 여유가 있을 때 해주시면 되요.\n대신 의상 레이어는 같은 이미지에 여러개 부탁드리겠습니다.\n\n예시로 브라와 속옷 입어 누드 없는 sfw(31, 36)\n브라와 팬티 없이 맘마통이랑 소중이 다 보이는 nsfw(32, 33, 37, 38)\n그 외에 작가님이 원하시면 편한 레이어 더 넣으셔도 됩니다.\n\n키라라 의상은  빨간 스카프 매고 있는 걸로 해주세요(44, 45, 50-52)\n\n일단 키라라와 하야테의 커플 원샷이니(53-62)처럼 한 이미지에 서로 사랑하는 느낌을 부탁드리겠습니다.\n\n배경은 웨딩 비키니와 결혼 느낌 나는 밝은 공간의 침대(31, 36, 58) 느낌으로 해주세요. 주변에 장미 같은 꽃잎들이 뿌려져 있거나 다른 악세사리 추가 해도 됩니다.\n\n카메라와 캐릭터 포즈 예시 이미지는  31-33, 36-38, 58-62 처럼 정면(하야테 가슴과 소중이 다 보이기 위해)으로 하이 앵글 혹은  아이 레벨 앵글 같은 느낌으로 침대에 서로 행복하게 누워 있는 느낌 부탁드리겠습니다.\n\n이미지는 가로 이미지 부탁드립니다. 일단 구도나 포즈 카메라나 다른 것들 중 좀 더 좋은 아이디어 있으시면 희망 사항 남겨주세요.\n\n감사합니다.", "nc": 48, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Sutoroa_/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3212368, "client_id": 2068846, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/e07320f8/uploads/origins/a1d739b7-f010-4850-936d-ca11cd5309a3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=949851d4b67b870f5f22c97c3007e5a7", "srcset": "https://si.imgix.net/e07320f8/uploads/origins/a1d739b7-f010-4850-936d-ca11cd5309a3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=949851d4b67b870f5f22c97c3007e5a7, https://si.imgix.net/e07320f8/uploads/origins/a1d739b7-f010-4850-936d-ca11cd5309a3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f8a545cc151e39a9d0c78bcb2c27cc63 2x, https://si.imgix.net/e07320f8/uploads/origins/a1d739b7-f010-4850-936d-ca11cd5309a3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=3076120e5d3fda4f62e997fcff656ecd 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/e07320f8/uploads/origins/a1d739b7-f010-4850-936d-ca11cd5309a3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e6daebb5a2a08cbe9c096a767ba05b41", "srcset": "https://si.imgix.net/e07320f8/uploads/origins/a1d739b7-f010-4850-936d-ca11cd5309a3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e6daebb5a2a08cbe9c096a767ba05b41, https://si.imgix.net/e07320f8/uploads/origins/a1d739b7-f010-4850-936d-ca11cd5309a3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=82129fba979e8a591556102766877a9b 2x, https://si.imgix.net/e07320f8/uploads/origins/a1d739b7-f010-4850-936d-ca11cd5309a3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=9080e7cd5d619dc070c9a36fe7fc6eb0 3x"}, "body": "네, 이번에는 신데마스의 하야테를 신청하고 싶습니다. 밑에는 링크입니다.\n(https://drive.google.com/drive/folders/1_hO1EAQDSDvYXPMvNOHCs4cetvh3slP7?usp=sharing)\n\n하야테 머리 스타일과 의상 디자인은 02-05번의 바니걸입니다. 타작가님들께 신청했었던 의상입니다. 사타구니 부각하는 노출 강한 하늘색과 은색 섞인 바니걸 의상입니다. 머리는 기존 생머리이고요.\n그리고 바니걸 의상은 4 레이어 버전으로 받고 싶습니다.\n하나는 기존 예시 이미지의 버전이고, 두번째는 그냥 기존에서 보이는 치마가 없어서 사타구니랑 옆트임 노출 높인 버전으로 하고 싶습니다.\n나머지 두 개는 간단하게 위의 레이어버전에서 하체부분에 도끼 자국 추가한 간단한 수정 버전만 하시면 됩니다.\n\n카메라 옵션과 거리, 캐릭터 포즈는 셋 중 하나 고르시면 됩니다. 사타구니 부각이라 저번 미카 커미션이랑 달리 하체도 다 보이는 이미지를 원합니다.\n\n01: 정면샷, 그리고 아이(eye) 레벨 각도의 미디엄 롱 샷 이미지. 포즈는 자유.(01, 06)\n02: 아주 약간의 하이, 그리고 사이드 앵글의 미디엄 롱 샷. 포즈는 기본적으로 저렇게 앉아 있기.(07)\n03: 기본 조건(하야테 전신 다 나오는 거)만 갖춘 채 작가님이 더 좋은 구도랑 포즈가 있으면 그걸로 하셔도 됩니다. 대신 카메라 거리는 기존대로 미디엄 롱 샷 정도.\n\n감사합니다.\n\nhttps://drive.google.com/drive/folders/1_hO1EAQDSDvYXPMvNOHCs4cetvh3slP7?usp=sharing", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Sutoroa_/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3212368, "client_id": 2068846, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/e0e9b931/uploads/origins/7edab53a-00b6-4674-a00f-95a23fe6abfb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=53e726b1cdd3bdc0ab648be31beacacc", "srcset": "https://si.imgix.net/e0e9b931/uploads/origins/7edab53a-00b6-4674-a00f-95a23fe6abfb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=53e726b1cdd3bdc0ab648be31beacacc, https://si.imgix.net/e0e9b931/uploads/origins/7edab53a-00b6-4674-a00f-95a23fe6abfb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=7230e6f7abbc8ed5ffdc41e861cbce0e 2x, https://si.imgix.net/e0e9b931/uploads/origins/7edab53a-00b6-4674-a00f-95a23fe6abfb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e3ed6752fd10e6455d9e2b51b8d247bf 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/e0e9b931/uploads/origins/7edab53a-00b6-4674-a00f-95a23fe6abfb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=60a0185f18358b51bff88c3bf6bcec1b", "srcset": "https://si.imgix.net/e0e9b931/uploads/origins/7edab53a-00b6-4674-a00f-95a23fe6abfb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=60a0185f18358b51bff88c3bf6bcec1b, https://si.imgix.net/e0e9b931/uploads/origins/7edab53a-00b6-4674-a00f-95a23fe6