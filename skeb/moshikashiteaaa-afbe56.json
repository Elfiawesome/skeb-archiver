f-927f-a1fb8b259b01?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=935153b69ae4a74b55cac3e50b0a321b", "srcset": "https://si.imgix.net/896ba83d/uploads/origins/e916558c-0d12-45df-927f-a1fb8b259b01?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=935153b69ae4a74b55cac3e50b0a321b, https://si.imgix.net/896ba83d/uploads/origins/e916558c-0d12-45df-927f-a1fb8b259b01?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=933872c691f8c0f35cadafa0ca20ed0b 2x, https://si.imgix.net/896ba83d/uploads/origins/e916558c-0d12-45df-927f-a1fb8b259b01?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=f00d360b063dcfcfdb13cc631dd2fe8a 3x"}, "body": "こんばんは。僭越ながらキャンペーンのためリクエストいたします。\n\n「『ミストトレインガールズ』のフュッセンが、『ガールズクリエイション』のヴィルヘルミナ・ブグロー（以下ブグロー）にえっちな目で見られて恥じらってる」のをお願いします。\n\n・フュッセンは軍事国家アイゼングラートのロリコン貴族キャラ、ブグローは小柄な塾講師ながらえっちでかわいい女の子が好きな藝術家です（資料URLのサムネイルに映ってるキャラです）。\n・フュッセンをブグローが全身を舐め回すように見ており、最初は互いに美少女っぷりにニコニコしているが、フュッセンはだんだん恥ずかしい感じになっていき、ブグローはだんだん興奮していくような感じになるように（スタイルの良さと容姿に「えっちだ」とテンション爆上がりになるように）。\n・フュッセンお嬢ちゃまの可愛い表情が見たいので、愛らしさを感じさせる恥じらい方でお願いします。ポーズはおっぱいや太ももを強調するようなポーズだと望ましいです。\n・ブグローはフュッセンの太もも（というか下着）を覗き込むような感じになるようにしつつ、ブグロー本人にも隙があるように。顔は眉毛が特徴的なのでそこに注意してくだされば。\n・2人の衣装はおまかせで（特に思いつかない場合はフュッセンがAレイヤー［わがまま王侯貴族］の、ブグローは★5の藝術家スタイル【美少女画会の至宝】で）。\n・一応リクエスト的にキャラがキャラなのと下着が見えるなどの構図も想定し、NSFWにしておりますがR-18でなくても構いません（もちろんR-18であっても大歓迎です）。\n・もしも可能であればブグローも一緒に恥じらっている表情の差分もいただけると幸いです（ブグロー自身が自分の体型に自身を持っていないため）。\n\n以上です。気になる点があったので再送いたしましたが、どうぞよろしくお願いいたします。\n\nhttps://www.youtube.com/watch?v=nc8qlUt0CfE", "nc": 56, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@moshikashiteaaa/works/9", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3259056, "client_id": 180981, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/05a5e090/uploads/origins/68985e08-5fe8-40fb-836f-256