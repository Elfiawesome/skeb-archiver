をお願いします。\n一枚（又は複数枚）でまとめて頂くか、一枚づつかはご負担が少ない方で(同じなら一枚づつ)お願いします。", "nc": 32, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@moshikashiteaaa/works/8", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3259056, "client_id": 465001, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/c5e733d9/uploads/origins/95438941-6ee2-4357-9b9d-1540d0410882?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=cee1d65a32e6dccdcfb0346ded10db45", "srcset": "https://si.imgix.net/c5e733d9/uploads/origins/95438941-6ee2-4357-9b9d-1540d0410882?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=cee1d65a32e6dccdcfb0346ded10db45, https://si.imgix.net/c5e733d9/uploads/origins/95438941-6ee2-4357-9b9d-1540d0410882?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=8db23f88d97b0f05861592fbce80e6ae 2x, https://si.imgix.net/c5e733d9/uploads/origins/95438941-6ee2-4357-9b9d-1540d0410882?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=60fdbf139735b9506ca37cc9f0c08f5d 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/c5e733d9/uploads/origins/95438941-6ee2-4357-9b9d-1540d0410882?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=30b0b401f174d902f4ac07400e2a0c4d", "srcset": "https://si.imgix.net/c5e733d9/uploads/origins/95438941-6ee2-4357-9b9d-1540d0410882?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=30b0b401f174d902f4ac07400e2a0c4d, https://si.imgix.net/c5e733d9/uploads/origins/95438941-6ee2-4357-9b9d-1540d0410882?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=cc53ffcce47596a04d471efd13931760 2x, https://si.imgix.net/c5e733d9/uploads/origins/95438941-6ee2-4357-9b9d-1540d0410882?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=84f9d2c88e63fb3f1dedd22b00a6e138 3x"}, "body": "こんばんは。先日は誠にありがとうございました。\nというわけで早速リクエストです。\n「『フラワーナイトガール』のシャボンソウとオオバコの衣装交換」をお願いします！\n\n・ブロッサムヒルの花騎士シャボンソウと、バナナオーシャンの花騎士オオバコ、双方の開花衣装の交換でお願いします。2人の人選は至極個人的な趣味です。\n・シャボンソウは露出度の高いオオバコの衣装で動きやすそうに思いつつもちょっと恥じらってるように。\n・オオバコはもこもこふわふわなシャボンソウの衣装に心地よさそうな感じで。\n・ヘアアレンジは交換先に合わせるのを希望しますが、難しければそのままでも構いません。\n・2人共おっぱいはそこそこ以上を意識していただければと思います（可能であればポーズやアングルなどで谷間が見えるようにしていただければ…）。\n・一応オオバコの衣装の露出度を顧みてNSFW指定にしてあります。ポロリやパンチラなど、えっちい感じにするかどうかはお任せします。\n\n以上です。2名同時というリクエストとなりますが、もし可能であればよろしくお願いいたします。", "nc": 32, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@moshikashiteaaa/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3259056, "client_id": 180981, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/531fb4eb/uploads/origins/69bedb78-4333-4cb8-9871-279290c8347e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=02f8320c28ef02649657027a993277cf", "srcset": "https://si.imgix.net/531fb4eb/uploads/origins/69bedb78-4333-4cb8-9871-279290c8347e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=02f8320c28ef02649657027a993277cf, https://si.imgix.net/531fb4eb/uploads/origins/69bedb78-4333-4cb8-9871-279290c8347e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=d8df76d2dddb4b62c973c1cbd49d0784 2x, https://si.imgix.net/531fb4eb/uploads/origins/69bedb78-4333-4cb8-9871-279290c8347e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=8156589a55ba6c676bcb3f990a47fba6 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/531fb4eb/uploads/origins/69bedb78-4333-4cb8-9871-279290c8347e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5f184d3dbfdae603e129bae423bfaf16", "srcset": "https://si.imgix.ne