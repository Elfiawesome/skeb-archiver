-b6bc-cfbb769d7f6c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=8d6c2e8ff8916385f2cc59a27f792b58 2x, https://si.imgix.net/cde65f7b/uploads/origins/dea51010-6679-4622-b6bc-cfbb769d7f6c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=fd36e244af9b8602f1a5775bef2bf1c0 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/cde65f7b/uploads/origins/dea51010-6679-4622-b6bc-cfbb769d7f6c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3200e7a3cfdd69da02f3a57b527565df", "srcset": "https://si.imgix.net/cde65f7b/uploads/origins/dea51010-6679-4622-b6bc-cfbb769d7f6c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3200e7a3cfdd69da02f3a57b527565df, https://si.imgix.net/cde65f7b/uploads/origins/dea51010-6679-4622-b6bc-cfbb769d7f6c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=b4b696c264001683c0db490e2ad5447b 2x, https://si.imgix.net/cde65f7b/uploads/origins/dea51010-6679-4622-b6bc-cfbb769d7f6c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=b4f0dbfb99c0fdabedf067c79ec2a855 3x"}, "body": "はじめまして。Ｘのアイコン用にモモイのイラストをお願いしたいです。\n以下、箇条書きにさせていただきます。\n・メイド体験をしているモモイが飲み物を先生に持ってくるんですが、着なれていない服のせいで飲み物ひっくり返しちゃって慌ててる。というシチュエーション\n・和装メイド服でメインの色はピンク色。差し色で緑色を入れて貰って、ワンポイントで緑色の猫のキーホルダー(モモイの固有武器に付いてるやつ)を付けて欲しいです。いつもの猫耳ヘッドフォンは無しで猫耳ヘッドドレスがいいです。和装メイド服の袖は長めでだぼだぼさせて欲しいです。(モモイが動きにくそうにしてほしい)\n・以前、購入させて頂いたシュエリン、ココナちゃん、サヤのバイト本の服がとっても可愛かったのとリクエストさせて頂いたモモイの色紙がとっても可愛かったので依頼させていただきました。\n・納期については指定しません。\n\nアイコン使用許可を頂けましたら、プロフィール欄に先生の名前等を記載させていただきます。ご検討よろしくお願いします。", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@hu_nin1216/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2134317, "client_id": 2637857, "vtt_url": null, "thumbn