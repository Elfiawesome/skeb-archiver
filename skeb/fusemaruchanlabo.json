MmkMn66J8ok516RzUAjtXe5iR?usp=sharing\n\n全体的にMALIBU様の描きやすい感じ、テイストで描いていただければ幸いです。\n\n背景は無しでもアリでもどちらでも大丈夫です。\nただ、サムネイル等に使用する透過画像(拡張子png)をお願いいたします。\n\n長いご依頼内容、細かい指定となってしまい申し訳ございませんが、どうかご検討の程何卒よろしくお願いいたします。", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "similar_creators": [{"id": 263850, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "えんがわ🍣skeb open!", "screen_name": "engawa110", "avatar_url": "https://proxy.misskeyusercontent.jp/avatar.webp?url=https%3A%2F%2Fmedia.misskeyusercontent.jp%2Fio%2F8f728b08-19a2-4105-829a-adbe7b98fa1f.gif&avatar=1", "header_url": "https://media.misskeyusercontent.jp/io/fabc4d71-23dc-476a-8210-af0e559474b3.webp", "appeal_receivable": false, "popular_creator_rank": 12, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 5, "complete_expiration_days": 60, "skills": [{"genre": "art"}, {"genre": "video"}], "nc": 48}, {"id": 546847, "creator": true, "nsfw_acceptable": false, "acceptable": false, "name": "うろた👾", "screen_name": "PKurotein", "avatar_url": "https://pbs.twimg.com/profile_images/1632254699008327681/jy_oEMBM.jpg", "header_url": "https://pbs.twimg.com/profile_banners/977824128672530432/1679239605/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 15, "complete_expiration_days": 60, "skills": [{"genre": "art"}], "nc": 177}, {"id": 579655, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "アカババァ", "screen_name": "0725akaba", "avatar_url": "https://pbs.twimg.com/profile_images/1908822583866515456/bJXaD4I6.jpg", "header_url": "https://pbs.twimg.com/profile_banners/3324339390/1652011079/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at"