press&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=91f315573cefddf635c9a7e82003ee9c 2x, https://si.imgix.net/57f5d8c2/uploads/origins/54ced6b3-22ca-4b59-bf4e-a01937eb21c4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ec9b8de94ab8523cc50f2761e4faa0e8 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/57f5d8c2/uploads/origins/54ced6b3-22ca-4b59-bf4e-a01937eb21c4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=39ca1d09530b799963dd88d1a38ae297", "srcset": "https://si.imgix.net/57f5d8c2/uploads/origins/54ced6b3-22ca-4b59-bf4e-a01937eb21c4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=39ca1d09530b799963dd88d1a38ae297, https://si.imgix.net/57f5d8c2/uploads/origins/54ced6b3-22ca-4b59-bf4e-a01937eb21c4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=c28423880b9fe1769bc7fd5fb27d6e63 2x, https://si.imgix.net/57f5d8c2/uploads/origins/54ced6b3-22ca-4b59-bf4e-a01937eb21c4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=1e1eabbf8a61efd3af5b5410c0e48dae 3x"}, "body": "原/神の宵/宮が太った身体に法被を着ているものの、胴回りの寸法が足りておらず引っ張っているところを見られて焦っている状況をお願いしたいです！\n\n立ち姿を正面から見た構図で、ポーズとしては「ちょっ、ちょい待って！まだ準備がーー（宵/宮のセリフ）」と言いながら、入ってきた主人公を慌てて止めるように片手をこちらに突き出し、もう片方は法被のへその高さあたりを強く引っ張っているもののへそが隠れていない程度には法被の幅が足りていない感じで、胸元は開いていると嬉しいです。\n下着はシンプルな白の胸のさらしとふんどしです。（ゲーム内のように手足に巻かなくて問題ないです）\n法被の色に関しては自分ではイメージが難しいのですが、肌とのコントラストを考えると宮川大輔（芸人）のような青色かなと思いました。もっと似合いそうな色があればお任せします！\n\nhttps://mosotomasutrain.fanbox.cc/posts/12051934 こちらの作品の肉付きが大好きなので、体型と汗はこれに近い形でお願いいたします。\n脱衣差分はご負担にならなければでかまいません。\n\n受けるのが難しいキャラ・内容でしたら遠慮なく再送依頼・キャンセルいただいて差し支えありませんので、ご検討いただけると幸いです！\n\n資料： https://wiki.hoyolab.com/pc/genshin/entry/15?lang=ja-jp の「ギャラリー」", "nc": 160, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@mosoTOMASUtrain/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2061905, "client_id": 3833910, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/08f25a16/uploads/origins/56a3a7c4-3684-4ffc-9707-4cce2a027c4e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=319caf23132f6c091e9e85f38e9b5401", "srcset": "https://si.imgix.net/08f25a16/uploads/origins/56a3a7c4-3684-4ffc-9707-4cce2a027c4e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=319caf23132f6c091e9e85f38e9b5401, https://si.imgix.net/08f25a16/uploads/origins/56a3a7c4-3684-4ffc-9707-4cce2a027c4e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=85d169ba9d1afec0ac9bd0c89fe702c5 2x, https://si.imgix.net/08f25a16/uploads/origins/56a3a7c4-3684-4ffc-9707-4cce2a027c4e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d5f0cb8ed263d413bc266ae3d88e975b 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/08f25a16/uploads/origins/56a3a7c4-3684-4ffc-9707-4cce2a027c4e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=38c5735a573f6131af11b5f9a428e9e5", "srcset": "https://si.imgix.net/08f25a16/uploads/origins/56a3a7c4-3684-4ffc-9707-4cce2a027c4e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=38c5735a573f6131af11b5f9a428e9e5, https://si.imgix.net/08f25a16/uploads/origins/56a3a7c4-3684-4ffc-9707-4cce2a027c4e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=0f252d9a34b5d145c8b1a58a50890dbe 2x, https://si.imgix.net/08f25a16/uploads/origins/56a3a7c4-3684-4ffc-9707-4cce2a027c4e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=362de24325b2418aceb505e84cb3a28e 3x"}, "body": "こんにちは！あなたの作品、大好きです！\n\n『ラブライブ！』の西木野真希（https://i.idol.st/u/idol/10Nishikino-Maki-85vaOk.png）を、こんな風に (https://x.com/mosoTOMASUtrain/status/1908144663019855903) のような、ほとんど動けないほど極度に肥満した女の子、あるいはそれよりもさらに太った姿にしてほしいです！もうほとんど着られないほどきつくなった制服を着て、歩くのに苦労している様子で描いてください。\n\nよろしくお願いします！", "nc": 168, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@mosoTOMASUtrain/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2061905, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/67413271/uploads/origins/5195d80c-c7ee-4ebd-971e-ce62003f71a6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fae46004d229b5b73054fc2885ac8932", "srcset": "https://si.imgix.net/67413271/uploads/origins/5195d80c-c7ee-4ebd-971e-ce62003f71a6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fae46004d229b5b73054fc2885ac8932, https://si.imgix.net/67413271/uploads/origins/5195d80c-c7ee-4ebd-971e-ce62003f71a6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=918da5ab4a49ea7646e64b4fcf9f3be7 2x, https://si.imgix.net/67413271/uploads/origins/5195d80c-c7ee-4ebd-971e-ce62003f71a6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=8718d702dc973185e7d512ce11ce53de 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/67413271/uploads/origins/5195d80c-c7ee-4ebd-971e-ce62003f71a6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c7e70381c2999dc8c443bbdf0e4ea5f7", "srcset": "https://si.imgix.net/67413271/uploads/origins/5195d80c-c7ee-4ebd-971e-ce62003f71a6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c7e70381c2999dc8c443bbdf0e4ea5f7, https://si.imgix.net/67413271/uploads/origins/5195d80c-c7ee-4ebd-971e-ce62003f71a6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=2a997516780373e91436d954c3a1f02c 2x, https://si.imgix.net/67413271/uploads/origins/5195d80c-c7ee-4ebd-971e-ce62003f71a6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=991f2186fedf1e363d3407a16ab13150 3x"}, "body": "お世話になっております。納品後立て続けのリクエストで申し訳ありませんが、ただいま受信0ということでいてもたってもいられず、再びお願いさせていただきます…！！\n今回は、「ボンバーガール」より「おはぎ」ちゃんのでっぷり肥満化イラストをお願いしたいです！\n見た目の参考はこちらのツイート( https://x.com/bombergirl573/status/2022143696800768499?s=46 )を見ていただければと思います。そこまで装飾が細かいキャラではないですが、面倒そうなパーツは省略してもらっても全然構いません。\n体型のイメージとしては、毎度のことながら顔肉をたっぷり盛り盛りでお願いしたく、顔から下はお胸はまったく成長していないけど肩幅はお肉でもっちりと膨らみ、お腹はでぶでぶ、下半身もでっぷりと育ったリンゴ型な肥満児体型で描いていただけたらと思います。シチュエーションとしては、マスターに甘やかされまくりでぶでぶに太り、忍ぶこともできずただ幸せそうなとろんとした顔でバターを丸かじりする「あんバター」なでぶだぬきになってしまったおはぎちゃんの姿が見たいなと思っています。\n前回のバター差分がほんとうにえっちだったので、今回も近いシチュエーションで申し訳ありません！マイナーなジャンルですが、描いていただけたらとっても嬉しいです！よろしければぜひ、お願いいたします！！", "nc": 41, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@mosoTOMASUtrain/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2061905, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/cb3f9f0e/uploads/origins/3fb0aceb-1a35-4779-9b60-e3a97fab21f2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6d39eb6ee75faf82b180c636f977c5a5", "srcset": "https://si.imgix.net/cb3f9f0e/uploads/origins/3fb0aceb-1a35-4779-9b60-e3a97fab21f2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6d39eb6ee75faf82b180c636f977c5a5, https://si.imgix.net/cb3f9f0e/uploads/origins/3fb0aceb-1a35-4779-9b60-e3a97fab21f2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=622c2b66b58688257525c12cbf9a4e1b 2x, https://si.imgix.net/cb3f9f0e/uploads/origins/3fb0aceb-1a35-4779-9b60-e3a97fab21f2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a967e7dd50b5b0406d8d772e4382da64 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/cb3f9f0e/uploads/origins/3fb0aceb-1a35-4779-9b60-e3a97fab21f2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c571199b83fb009bcf9b914fe5ad0139", "srcset": "https://si.imgix.net/cb3f9f0e/uploads/origins/3fb0aceb-1a35-4779-9b60-e3a97fab21f2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c571199b83fb009bcf9b914fe5ad0139, https://si.imgix.net/cb3f9f0e/uploads/origins/3fb0aceb-1a35-4779-9b60-e3a97fab21f2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=63454e1021336a3733f5fde73df76faf 2x, https://si.imgix.net/cb3f9f0e/uploads/origins/3fb0aceb-1a35-4779-9b60-e3a97fab21f2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=eb1c00a27f03bd109bd997c2f18f71e6 3x"}, "body": "お世話になっております。前回のイラスト最高でした…！！今回もアズールレーンよりエルドリッジちゃんの肥満化絵を描いていただきたくお願いにあがりました。前回のイラストよりも増量し、よりでっぷり巨大に肥えた肥満児体型で描いてくださると嬉しいです。\nシチュエーションは、着せ替え衣装「ニャンニャンアイドル？」の格好( https://azurlane.wikiru.jp/?%E3%82%A8%E3%83%AB%E3%83%89%E3%83%AA%E3%83%83%E3%82%B8 こちらの「着せ替え」より閲覧できます)で、自力で立てない体をどっしりと座り込ませ、「がんばれ…♡がんばれ…♡」とお肉を揺らして仕事中の指揮官を応援してる(＋絵はそのままで、指揮官の手で口元にバターブロックを差し出され丸齧りして喜んでいる「応援してくれたごほうび」差分)のようなイメージでお願いしたいです。\n服ですが、猫耳カチューシャ+猫手袋+上半身部分の衣装(ジャケットは不要です)+縦縞の長手袋とソックスは着せていただいて、ほかジャケットや艤装、スカート等は省略していただいて構いません。描いていただく部分でも、細かい装飾などは省略していただいて大丈夫です。背景なしでも構いません。猫手袋は、普通体型では大きく見えたのに今やぶよぶよの腕肉に圧倒されて小さく見えるような感じだとえっちかなと思います。\n体型のイメージとしましては、このあたり( https://x.com/mosotomasutrain/status/1882005290947662177?s=46 https://x.com/mosotomasutrain/status/1926326384852345117?s=46 )のイラストのようなどっしりとした重量感のある体型で、顔肉も前回以上にたっぷりと盛った、二重〜三重顎で描いていただきたいです。目も前回以上に肉で圧迫され、目自体のサイズが小さくなった感じにしていただけるととても助かります。\nリクエストは以上となります。お忙しいところ恐縮ですが、もし描いていただければとてもとても嬉しいです。よければぜひ、よろしくお願いいたします…！", "nc": 56, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@mosoTOMASUtrain/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2061905, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/b511e6c6/uploads/origins/7be44d7c-4cc1-41e2-a90d-ae7871750a78?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0e3d2b81cf84464bab163527e119122c", "srcset": "https://si.imgix.net/b511e6c6/uploads/origins/7be44d7c-4cc1-41e2-a90d-ae7871750a78?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0e3d2b81cf84464bab163527e119122c, https://si.imgix.net/b511e6c6/uploads/origins/7be44d7c-4cc1-41e2-a90d-ae7871750a78?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=25daa3873a79c6286e0afa266fe52474 2x, https://si.imgix.net/b511e6c6/uploads/origins/7be44d7c-4cc1-41e2-a90d-ae7871750a78?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=cb91310fa96081f93327ac668e0e0745 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/b511e6c6/uploads/origins/7be44d7c-4cc1-41e2-a90d-ae7871750a78?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=013c58f3b6eff8fcca9bb30ea6f33574", "srcset": "https://si.imgix.net/b511e6c6/uploads/origins/7be44d7c-4cc1-41e2-a90d-ae7871750a78?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=013c58f3b6eff8fcca9bb30ea6f33574, https://si.imgix.net/b511e6c6/uploads/origins/7be44d7c-4cc1-41e2-a90d-ae7871750a78?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=c880c8f9d6361c9ae72e00f4dfb0feeb 2x, https://si.imgix.net/b511e6c6/uploads/origins/7be44d7c-4cc1-41e2-a90d-ae7871750a78?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=640e14424f2ce73b08e29d1d05254a56 3x"}, "body": "はじめまして。顔肉もっちりなイラストが好きでよくお世話になっております。直近の納品物にてskeb開設していらっしゃることを知り、依頼させていただきました。\n依頼内容ですが、アズールレーンより「エルドリッジ」ちゃんの肥満化イラストを描いていただきたく思います。\n構図としては、正面からの構図でベッドに寝転がっているのを真上から写したような構図でお願いします。(抱き枕カバーの構図のようなイメージ)\n肉量的にも、全体的な雰囲気としては以前描かれていたヒナの全裸イラストのような感じでお願いしたいです。赤ちゃんのような自然な(全身が贅肉に圧迫されて、力を抜くと勝手にそうなってしまうような)がに股とゆったり曲げて投げ出した腕の姿勢でお願いします。\n描写のお願いとしては、衣服は前掛け部分のみで、膨らみ切った体を全く隠せておらずちょこんと乗っかってるだけのような感じです。貧乳で太った男性のような印象のおっぱいが丸見えになっている感じでお願いしたいです。また、顔肉をたっぷりと盛っていただき、元来のジト目とせり上がる頬肉で目が細まっているのを描いていただけると嬉しいです。\nもしよろしければ受けていただけると嬉しいです。よろしくお願いします！", "nc": 185, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@mosoTOMASUtrain/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2061905, "client_id": 3450665, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/5c26a0a4/uploads/origins/99d4caeb-49df-4b0d-9684-c80652adc030?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=38007bae29be7068b8b39af9db688dcd", "srcset": "https://si.imgix.net/5c26a0a4/uploads/origins/99d4caeb-49df-4b0d-9684-c80652adc030?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=38007bae29be7068b8b39af9db688dcd, https://si.imgix.net/5c26a0a4/uploads/origins/99d4caeb-49df-4b0d-9684-c80652adc030?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=9506376f765d6dcdce17acf47ed78af1 2x, https://si.imgix.net/5c26a0a4/uploads/origins/99d4caeb-49df-4b0d-9684-c80652adc030?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=9fac06987e44d3fcbb88e72c74e6188a 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/5c26a0a4/uploads/origins/99d4caeb-49df-4b0d-9684-c80652adc030?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=cc591f060d20abc21fe0f7397be66844", "srcset": "https://si.imgix.net/5c26a0a4/uploads/origins/99d4caeb-49df-4b0d-9684-c80652adc030?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=cc591f060d20abc21fe0f7397be66844, https://si.imgix.net/5c26a0a4/uploads/origins/99d4caeb-49df-4b0d-9684-c80652adc030?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=20