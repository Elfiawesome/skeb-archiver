日の様子を一枚お願いしたく存じます。\n普段からラフな装いなので服装につきましてはこちらにしたいはございません。\n何卒よろしくお願い致します。\n（データをお載せした方がいいかと思い以前いただいたものを資料としてお送りしています）\n\nご検討のほどよろしくお願いします。\n\nhttps://cdn.discordapp.com/attachments/962359726815989790/1289860865054609418/HO3__.png?ex=66fa5c0a&is=66f90a8a&hm=e6756761407dfd1e9413e1e3227524134ae4c53c6816ace8854260c4a272f2f6&", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@mkn_392/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1518754, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/24f19d9e/uploads/origins/e91e638c-2a61-4672-9e4b-9082186df5e9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=133fad2b32311000f1a98a64ec96584a", "srcset": "https://si.imgix.net/24f19d9e/uploads/origins/e91e638c-2a61-4672-9e4b-9082186df5e9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=133fad2b32311000f1a98a64ec96584a, https://si.imgix.net/24f19d9e/uploads/origins/e91e638c-2a61-4672-9e4b-9082186df5e9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f5f6accb4522a3e5d969beaad980b7b4 2x, https://si.imgix.net/24f19d9e/uploads/origins/e91e638c-2a61-4672-9e4b-9082186df5e9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=213dcce91465c6165a2965cb5dcb10b1 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/24f19d9e/uploads/origins/e91e638c-2a61-4672-9e4b-9082186df5e9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=92983aed22021567a06f6ce7be96320d", "srcset": "https://si.imgix.net/24f19d9e/uploads/origins/e91e638c-2a61-4672-9e4b-9082186df5e9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=92983aed22021567a06f6ce7be96320d, https://si.imgix.net/24f19d9e/uploads/origins/e91e638c-2a61-4672-9e4b-9082186df5e9?bg=%23fff&auto=fo