_report_client_visible": false, "total_appeals_count": 0, "received_works": [{"path": "/@fuyori_mofufu/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 808140, "client_id": 2691079, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/ec9816cf/uploads/origins/6b970a28-b76e-48d6-aa0e-9f06afad3d1f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=52d595d9f0f23842826bb9e002ff460e", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/ec9816cf/uploads/origins/6b970a28-b76e-48d6-aa0e-9f06afad3d1f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f59740045e496c24a7a4b14a0ef38e2e", "src_set": ""}, "body": "水野ユズ様はじめまして！\n今回わたしの推し様を描いて頂きたく依頼させていただきました！\n\n描いて頂きたいのはゆらさん(@ yura_vsinger)になります。\n\n少し秋らしい雰囲気のイラストにして頂けるとありがたいです。\n\n何卒よろしくお願いいたします\n\n参考画像\n立ち絵---https://x.com/yura_vsinger/status/1730991300617671136?s=46\n\nhttps://x.com/yura_vsinger/status/1730991300617671136?s=46", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@fuyori_mofufu/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 808140, "client_id": 434036, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/af20b607/uploads/origins/57c9c7cd-510b-4860-ba79-2abc7eb5a7fd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0970e39ba21d944e72bd5b6de508a693", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/af20b607/uploads/origins/57c9c7cd-510b-4860-ba79-2abc7eb5a7fd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2423e6c05a2e962ccf0bbadf41585a12", "src_set": ""}, "body": "初めまして！ 儚く優しいイラストに惹かれ、大切なVライバーに思い出に残る1枚をプレゼントしたくお願いしに参りました。 ご多忙かと思いますが都合が合いましたら、お引受け下さると嬉しいです\n 【使用用途】 IRIAMで収益化され活動されてるVライバーの叶守ユメ様と黒百合ももね様、またその2人のママ様であるゆずっぴ様にお渡しするためのファンアートです。\nライバー様2人はファンアート大丈夫ですが、ゆずっぴ様がイラストレーター様のためコテキャラの使用の許可を貰ってます。\nイラストはライバーとママ様にプレゼント後、それぞれのSNS(X、Instagram)にあげる可能性があります。また上記の3名と私に私的に使用する範囲で部屋に飾れるように印刷やアクリルブロックまでお許し頂けますと嬉しいです。\n\n\n 【内容】 3人が描かれた思い出写真の様な1枚をお願いしたいです。髪型、衣装、構図につきましてはおまかせ致します。\n親子な関係ですが3人とも仲がよく、互いに大切にされているので三人姉妹な感じです\nそして水野ユズ様のイラストが好きなので、水野様が描いて下さいましたら嬉しく存じます。\n\n\n\n\n キャラクターの参考として各種URLをご確認お願いします \n\n\n条件が難しい場合や金額に不足がある場合、変更再送依頼を頂ければ変更いたしますので、ご検討の程よろしくお願いします \n叶守ゆめ様  (姉)\nhttps://www.vertexlivedistel.com/properties/%E5%8F%B6%E5%AE%88%E3%83%A6%E3%83%A1\n黒百合ももね様  (妹)\nhttps://www.vertexlivedistel.com/vertex%E9%BB%92%E7%99%BE%E5%90%88%E3%82%82%E3%82%82%E3%81%AD\nゆずっぴ  様  (2人のママ様)\nhttps://xfolio.jp/portfolio/yuzupipi/works/523709", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@fuyori_mofufu/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 808140, "client_id": 2398119, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/cad44b2a/uploads/origins/0ee58e09-1b00-4324-bd17-0c062c89bc22?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a36ff9b9772f76553b8cc781733b825c", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/cad44b2a/uploads/origins/0ee58e09-1b00-4324-bd17-0c062c89bc22?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0aae060c758c316977d317e34f90e188", "src_set": ""}, "body": "初めまして。アリババと申します🙇\n\nオリキャラを描いて頂きたいのでリクエストします。\n\n・ギャル系\n・雰囲気はフワフワしてる\n・ピンク髪でセミロング\n・前髪はおでこがちょっとだけ見えてる感じ\n・肌は色白\n・瞳の色は紫系\n・服装は制服。サイズちょい大きめでベージュのニットカーディガンをダボッと着こなしている。ボタンは留めている。\n・ピンクのガチャベルトを垂らしている(長さは膝のちょい上くらいまで)\n・ポーズ、背景等はお任せします。\n\n【使用用途】\nスマホの壁紙に使わせて頂きたいと考えています。\n\n以上、宜しくお願い致します🙇", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@fuyori_mofufu/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 808140, "client_id": 2914296, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/adb64a7f/uploads/origins/fe15fd58-1ecf-4b75-be7a-0dda9c675ddb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=574060f3bd683c3b90e12193523c8d13", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/adb64a7f/uploads/origins/fe15fd58-1ecf-4b75-be7a-0dda9c675ddb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=08cfa4f1867e961b98d225a8bf3b8c59", "src_set": ""}, "body": "はじめまして\n柔らかく優しいタッチのイラストに惹かれまして是非リクエストお願いできればと思いました\n\n【内容】\nVtuber実栞るかさんのファンアートをお願いします\nポーズや構図についてはおまかせ致します\n（できましたら頭頂部や髪等が切れていない形ですと助かります\n水野ユズさまのタッチでかわいく描いて頂けたらと思います\n\n【使用用途】\n・個人的な観賞用や壁紙\n・ファンアートとしての投稿\n・実栞るかさんご本人へのプレゼント\n※実栞るかさんご本人に限り配信や動画・サムネイル・各種SNS投稿での使用を許可いただけますと幸いです\nこのためキャラクターのみを透過したpngかpsdもいただけますと助かります\n\n【参考資料】\n・二面図\nhttps://twitter.com/miloilka/status/1553745344457895936?s=21&t=WiVnXLbaEZzSSFnf9LjRpw\n・lit.link内の【二次創作について】にskebへのご依頼許可があります\nhttps://lit.link/miloilka\n\nご検討のほどよろしくお願いいたします\n\nhttps://twitter.com/miloilka/status/1553745344457895936?s=21&t=WiVnXLbaEZzSSFnf9LjRpw", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@fuyori_mofufu/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 808140, "client_id": 261332, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/222d45f9/uploads/origins/ad2c2f34-81b7-430d-a84b-33b08e1fc7b0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2969153e340af9d0994745d43a01b3e1", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/222d45f9/uploads/origins/ad2c2f34-81b7-430d-a84b-33b08e1fc7b0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9fdfb7d6d743ecff9c14df03b818a5d5", "src_set": ""}, "body": "はじめまして。いつも素敵なイラスト拝見しております。\n\n私が普段SNSで使用している、おさげ髪と赤いリボン、赤い目が特徴のオリジナルキャラクターを描いて頂けますでしょうか。\nテーマや服装としては夏っぽい感じでお願いしたいです。キャラクターの細かい部分やその他の点についてはおまかせいたします。かわいい感じにして頂けますと幸いです。\n使用用途としては私のSNSアカウントのプロフィール画像として使用させて頂きたい他に、私的利用としてスマホの壁紙やSkebの印刷してお届け機能を使用させて頂きたいです。\n\nよろしくお願いいたします。\n\nhttps://photos.app.goo.gl/7KbV8fHBbLVxve697", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "similar_creators": [{"id": 328716, "creator": true, "nsfw_acceptable": false, "acceptable": false, "name": "はのるの", "screen_name": "hano_luno", "avatar_url": "https://pbs.twimg.com/profile_images/1902908293250682880/-WC9ziJJ.jpg", "header_url": "https://pbs.twimg.com/profile_banners/2322230635/1689418993/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "skills": [{"genre": "art"}], "nc": 16}, {"id": 598815, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "水口ゆのん🐣", "screen_name": "yu_non_non", "avatar_url": "https://pbs.twimg.com/profile_images/1739255771681177600/m4ITtqfR.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1946966353/1682705614/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "skills": [{"genre": "art"}], "nc": 144}, {"id": 1229136, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "麻mia◇", "screen_name": "mamia_14", "avatar_url": "https://pbs.twimg.com/profile_images/1622947986987945984/knmB-Nuw.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1357860198518464514/1705712239/1500x500", "appe