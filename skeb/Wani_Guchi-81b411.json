200&blur=200&s=139bcc36f631b69bffdc41b86d6395e6, https://si.imgix.net/51c84301/uploads/origins/67c2f243-bd2b-444f-9d41-19ebc5ec8885?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=ffa508c75f9fe6b5ba98bdb8b24bc51b 2x, https://si.imgix.net/51c84301/uploads/origins/67c2f243-bd2b-444f-9d41-19ebc5ec8885?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=9311ab37f8da6fc728ef8e09f50ccfe7 3x"}, "body": "鰐口さんこんにちは！\n鰐口さんの描かれる可愛いキャラクターくんたちや、むちむちでっかい絵柄とても大好きです！\n\n今回は僕が制作している漫画『シェアハウス創作 2MDK』シリーズに登場するOCである『亥岡 大成』のイラストを描いていただきたく、リクエストを送らせていただきました。\n資料URLにてキャラクター資料をまとめた記事を添付しておりますので、ご確認いただけますと幸いです。\n\n服装は参考画像にある『半袖Tシャツ+エプロン+ジャージズボン』の姿でお願いいたします。\n表情や構図などは全て鰐口さんにお任せいたします。\n\nご検討の程、何卒よろしくお願いいたします！\n\nhttps://zuma-daihuku.fanbox.cc/posts/10479559", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Wani_Guchi/works/9", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3483298, "client_id": 2775669, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/452b0a0d/uploads/origins/b7dff1c9-eee3-4513-b6be-ddd61ae1462e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ce470600d92dfd78eb87530d2e180ade", "srcset": "https://si.imgix.net/452b0a0d/uploads/origins/b7dff1c9-eee3-4513-b6be-ddd61ae1462e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ce470600d92dfd78eb87530d2e180ade, https://si.imgix.net/452b0a0d/uploads/origins/b7dff1c9-eee3-4513-b6be-ddd61ae1462e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=db42b3c5ca226fd81efd0493ee32d813 2x, https://si.imgix.net/452b0a0d/uploads/origins/b7dff1c9-eee3-4513-b6be-ddd61ae1462e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=4a9c843fa13d06b1c11107140e4c6a8f 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_url