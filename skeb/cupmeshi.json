eals_count": 0, "received_works": [{"path": "/@cupmeshi/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2552958, "client_id": 2592670, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/2ae7825f/uploads/origins/939c7d35-c1d6-4c0d-b9b9-e3c42adeab9c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c1492036456c5a5612106e14c4c4f19e", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/2ae7825f/uploads/origins/939c7d35-c1d6-4c0d-b9b9-e3c42adeab9c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9714ca1fe249c34041b7d5ef74ba3bda", "src_set": ""}, "body": "こんにちは！\nもし宜しければ、うちの子のホープフルシャインを描いて頂きたいです！\n場面としては、レース終盤、最後方からトップスピードで先頭目掛けて駆けている感じでお願いします！\n一応レースとしては福島レース場のGⅢですが、服装は勝負服でお願いしたいです！\n表情はゾーンに入った感じの真剣な表情でお願いします！\nぜひ描いて頂けたら嬉しいです…！\n\nhttps://x.com/pyonpyon0723uma/status/1860640106270667151?t=bG6LZyTHF4qgf9Lt3g2eEw&s=19", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@cupmeshi/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2552958, "client_id": 2592670, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/3a17087f/uploads/origins/39e0739c-5192-4f68-a9bb-ce0554989e71?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6a65cff00dd3613e1dc64e43e9957f3c", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/3a17087f/uploads/origins/39e0739c-5192-4f68-a9bb-ce0554989e71?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f74217c1ca64b32d706cbf82eab7b470", "src_set": ""}, "body": "こんにちは！\n今回は、以前描いて頂いた運動会の続きとして、綱引きをしてるモブウマ娘ちゃん達を描いて頂きたいです！\n今回は、イッツコーリング、エクセレンシー、サンセットグルーム、サンバイザー（アニメ）の4人でお願いします！\nチーム分けはお任せで、勝敗に関してはほぼ拮抗状態、又はリードしてても大きな差ではない状態でお願いします！\n表情は慌て顔、ムッとした表情、一生懸命な表情（片方は><顔）でお願いします！\nそれぞれ誰がどの表情かはお任せします！\nまた、得点板（得点はお任せ）等も描いて頂けたら嬉しいです！\nぜひ描いて頂けたら嬉しいです…！\n\nhttps://photos.app.goo.gl/EPjvfvo1zPyVbbVK6", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@cupmeshi/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2552958, "client_id": 3458312, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/9a82126a/uploads/origins/a14af895-bddb-4b89-86d5-faf9be5337ff?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fa1986b608c1b0a153658ea3f385fa15", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/9a82126a/uploads/origins/a14af895-bddb-4b89-86d5-faf9be5337ff?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=1da963c16bac17ded08cf4c0453dad3e", "src_set": ""}, "body": "初めまして！\nこんにちは。\n\n「ウイニングザソウル」を熱唱する メジロマックイーン、トウカイテイオー、ナイスネイチャ の3人がステージでパフォーマンスしている場面をお願いしたいです。ただし、トウカイテイオーのマイクが不調で、上手く声が出ていない様子を描いてください。\n\nキャラクターのイメージ\n\n\t•\tメジロマックイーン\n優雅で堂々とした雰囲気で歌っています。困っているトウカイテイオーに気づきながらも、冷静に歌い続けているような表情をお願いします。\n\t•\tトウカイテイオー\nマイクの不調に気づいて焦ったり、困ったりしている表情でお願いします。歌おうとしているけど声が出ていない仕草があると嬉しいです。\n\t•\tナイスネイチャ\n明るく楽しそうに歌っていますが、トウカイテイオーの様子に少し気づいているような、微妙に戸惑った表情を描いていただけると助かります。\n\nその他のポイント\n\n\t•\tステージの雰囲気は華やかで、観客が盛り上がっている様子も少し描いていただけると嬉しいです。\n\t•\tキャラクターの衣装は自由ですが、5thの金色の奴だと助かる。\n\t•\t色合いは明るく、ライブのエネルギー感が伝わるようにお願いします。\n\nあとセンターはもちろんマックイーンでお願いします。", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@cupmeshi/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2552958, "client_id": 2592670, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/fce42bf2/uploads/origins/0e4a82bf-489c-4073-8eae-71033767abf0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=64af4ddb1935075f1e720716b0ab71f2", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/fce42bf2/uploads/origins/0e4a82bf-489c-4073-8eae-71033767abf0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3f52496b49228d924070457de1dff1db", "src_set": ""}, "body": "こんにちは！\nもしオリウマちゃんとか描くの大丈夫でしたら、うちのホープフルシャインちゃんを描いて頂けないでしょうか？\nポーズとか大体全部お任せ致しますので、とにかく良い感じに描いて頂けたら嬉しいです…！\nぜひご検討頂けたら嬉しいです！\n\nhttps://x.com/pyonpyon0723uma/status/1860640106270667151?t=RuTQ4r2eGvN8k3zw5hkGgQ&s=19", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@cupmeshi/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2552958, "client_id": 2592670, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/96be9230/uploads/origins/46263786-f0a8-4988-a75d-d49f4603f72b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5e81a46679a0471dc1b7278807590a8a", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/96be9230/uploads/origins/46263786-f0a8-4988-a75d-d49f4603f72b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=410e417fcff68a129a0b5df842059710", "src_set": ""}, "body": "こんにちは！\nもしよかったら、自分の新アカウントに使用するヘッダーを描いていただきたいです！\nキャラはアイネスフウジン（バレンタイン）ちゃん、ゼンノロブロイちゃん、ノーリーズンちゃん、エクセレンシーちゃん（モブ）の4人をお願いしたいです！\n衣装は全員勝負服、構図はお任せでお願いしたいです！\nぜひ描いて頂けたらありがたいです…！", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@cupmeshi/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2552958, "client_id": 2592670, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/91fd922d/uploads/origins/e7c11ec3-bffb-4a5e-bd92-84da0bb922e3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8a280803b84f27ebfc24fd9c5fd849ef", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/91fd922d/uploads/origins/e7c11ec3-bffb-4a5e-bd92-84da0bb922e3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ecfc94cc09c69a9121e103e5c6f4eada", "src_set": ""}, "body": "こんにちは！\nもしよかったら、モブウマ娘達が４人で運動会のかけっこをしてるイラストを描いて欲しいです！\n\n走るキャラはお任せで構図としては、\n１位の子(白組)が嬉しそうな笑顔でゴールしてる、\n２位の子(赤組)があと少し届かなくて悔しそうな表情をしてる\n３位の子(赤組)が転んでるorバランスを崩して涙目になってる\n最下位の子(白組)が前と離されてヘトヘトになりながら涙目で走ってる\nこんな感じでお願いします！\nぜひご検討頂ければありがたいです…！", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@cupmeshi/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2552958, "client_id": 2592670, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/cd89e862/uploads/origins/c33f2b29-8380-45de-b7d8-52d1c9cbfefe?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=08eaf7dc69fb060cd429abe50dc9539c", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/cd89e862/uploads/origins/c33f2b29-8380-45de-b7d8-52d1c9cbfefe?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=065e5009ea1aa56e0f8ac3ce2b0bf055", "src_set": ""}, "body": "こんにちは！\nもしよかったら、アイネスとファル子のイラストをお願いできないでしょうか？\n内容としては、アイネスがファル子の脇or脇腹をくすぐっているというもので、\n表情は、アイネスがニヤニヤ、ファル子がビックリしている表情でお願いします！\n服装は、トレセン学園の制服以外なら、私服でも勝負服でもなんでも大丈夫です！\nまた、可能ならアイネスがすごく楽しそうな表情、ファル子が涙目で笑ってる等の表情差分等もあれば嬉しいです！\n何か不都合があればキャンセルして頂いて構いませんが、ぜひ検討して頂けたら幸いです…！", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "similar_creators": [{"id": 558007, "creator": true, "nsfw_acceptable": false, "acceptable": true, "nam