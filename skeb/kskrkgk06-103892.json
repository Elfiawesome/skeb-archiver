ix.net/40818f2d/uploads/origins/6b83bb31-b335-4716-9a66-62110f5189e8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f9cffba1274aa013a37420389ca0569b 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/40818f2d/uploads/origins/6b83bb31-b335-4716-9a66-62110f5189e8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2bb885eb99288abb438476390c0c2450", "srcset": "https://si.imgix.net/40818f2d/uploads/origins/6b83bb31-b335-4716-9a66-62110f5189e8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2bb885eb99288abb438476390c0c2450, https://si.imgix.net/40818f2d/uploads/origins/6b83bb31-b335-4716-9a66-62110f5189e8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=7a405fa9b6808a74ed969007ca884eca 2x, https://si.imgix.net/40818f2d/uploads/origins/6b83bb31-b335-4716-9a66-62110f5189e8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=cd6b19bed45254a4755aa19735c27c85 3x"}, "body": "新着クリエイターリストからくさか様の素敵なイラストを見かけ、是非依頼をお願いしたいと思います\n\nくさか様が普段描かれないような特殊な内容になってしまうのですが、\nポケモン剣盾より「怒ったデデンネから電撃攻撃を受けてしまう女主人公（ユウリ）」\nといったイラストをお願い出来たらと思います\n\n○設定\n・野生のデデンネが食べようとしていた木の実をユウリが誤って拾ってしまい怒らせてしまう\n\n○容姿\n・服装、髪型共にデフォルトのもの\n・少し胸を盛っていただいて\n\n○内容\n・背中から電撃を受けて体を仰け反らせて苦しむユウリ\n・片足を後ろに上げながら女の子らしいポーズで\n・片目を閉じて辛そうな表情\n・攻撃で少し服が破けてる様子や鞄が破けて木の実が零れ落ちてる様子\n・スカートが捲れあがってパンチラ（中は白パンツで\n\n○可能であれば（無くても大丈夫です\n・デデンネを怒らせる前の木の実を拾うシーンを小さく漫画のコマのように\n・前屈みの姿勢で木の実を拾うユウリの後ろ姿とそれを見ているデデンネの後ろ姿\n・スカートの中が見えそうな際どいアングルで\n\n女の子のやられ要素を含むニッチな内容になりますが、よろしければご検討お願いします", "nc": 184, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@kskrkgk06/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2395085, "client_id": 2142607, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/a5a5aec9/uploads/o