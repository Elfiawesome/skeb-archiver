xtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=a6d06d4061048a4005611258b4462f6b 3x"}, "private": true, "genre": "art", "tipped": false, "creator_id": 2395085, "client_id": 797301, "nc": 33}, {"path": "/@kskrkgk06/works/16", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2395085, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/b7f4b3f1/uploads/origins/77742b34-4372-4145-9eb6-2c0d8ea3f1e4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5fcea25cc35ee045991ec39a44f4428e", "srcset": "https://si.imgix.net/b7f4b3f1/uploads/origins/77742b34-4372-4145-9eb6-2c0d8ea3f1e4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5fcea25cc35ee045991ec39a44f4428e, https://si.imgix.net/b7f4b3f1/uploads/origins/77742b34-4372-4145-9eb6-2c0d8ea3f1e4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=2695d24c24e40469011f2c310d0c919a 2x, https://si.imgix.net/b7f4b3f1/uploads/origins/77742b34-4372-4145-9eb6-2c0d8ea3f1e4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c8e0b7a0ea1d0a74bd4cdd6e46f0d39c 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/b7f4b3f1/uploads/origins/77742b34-4372-4145-9eb6-2c0d8ea3f1e4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9b4b330b306145995c4a0b27d21e3f02", "srcset": "https://si.imgix.net/b7f4b3f1/uploads/origins/77742b34-4372-4145-9eb6-2c0d8ea3f1e4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9b4b330b306145995c4a0b27d21e3f02, https://si.imgix.net/b7f4b3f1/uploads/origins/77742b34-4372-4145-9eb6-2c0d8ea3f1e4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=161cf74e165f0389f39379840b3d31a3 2x, https://si.imgix.net/b7f4b3f1/uploads/origins/77742b34-4372-4145-9eb6-2c0d8ea3f1e4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=3f1bb36cc7c807cd3eae7a0f8e7c18f5 3x"}, "body": "「デデンネに襲われるユウリ」の依頼をした者です\nリクエストの再会、心待ちにしておりました…！\n前回の作品がとても素晴らしかったため、また依頼をお願い出来たらと思います\n\n今回もポケモン作品の女の子のやられ要素のある依頼になるのですが\nポケモン金銀より「街の男達の前でボロボロにされてしまうジムリーダーのミカン」\nといったストーリー物の作品を漫画の形式で2枚ほどお願いしたいと思います\n\n○ストーリー設定\nアサギシティに突如現れたロケット団にやられてしまう船乗りの男達\nそこにジムリーダーのミカンが現れ、船乗りの男達を守ろうとするが…\n\n○登場人物\n・ミカン―容姿は最新のHGSSの物ではなく金銀世代の白いワンピース姿。\n・船乗りの男達―５～６人ぐらいのゲーム内のデザインと同じ船乗りの男達。\n・ロケット団―３人ぐらいの全員男。\n船乗りやロケット団らの男達は適当なモブ表現（目元を描かない等）で再現してもらって構いません\n\n①街のポケモンを庇い炎の渦に飲み込まれるミカン\n１、「ミカンさん…！」「これ以上街の人達に手出しはさせません！」\n　・ボロボロになったニョロモを抱きかかえるミカンとその後ろで見守っている船乗りの男達\n　・男達の足元にもやられたニョロゾやワンリキーの姿も\n２、「今度はジムリーダーがお相手か…！」「俺たちロケット団に逆らったらどうなるか教えてやるぜ…！！」\n　・不敵な笑みを浮かべたロケット団員達とヘルガーの姿\n３、「ヘルガー！あの女にほのおのうず！！」「！？」\n　・驚くミカン\n４、「きゃあああっ！！」「ミカンさん！！」「トレーナーに攻撃するなんて！！」\n　・ニョロモを抱きかかえながら炎の渦に巻き込まれるミカンとその様子を血相を変える男達\n　・スカートが大きく捲れて太股が見えてるようにしつつ下着は見えないように\n５、「ミカンさん、早くポケモンを出さないと！」「ダメだ、あのニョロモを庇ってて両手が使えないんだ…！」「このままじゃミカンちゃんが……」\n　・炎の中のミカンの後ろ姿のアップ\n　・“４”と同じように下着が見えないようにスカートが捲れてる状態\n\n②炎の渦の中でボロボロにされるミカン\n１、「あっ…ミカンさんのスカートがっ…！」「あぁ、下着が見えちゃうよ！」「ミ、ミカンちゃんのパンツが……！」\n　・捲れあがったスカートからパンチラしている下半身を後ろからアップで\n　・レースの付いた清楚で綺麗な感じの純白の下着\n　・炎で焼かれてスカートが少し焦げたり破けてたりしている感じに\n２、「ハハハ！パンツ丸見えじゃねぇか！！」「おぉ…エロい下着履いてやがるぜ…！」「ギャハハ！街の奴らにも見られてるぞ！！」\n　・“１”の正面側のアングル\n３、「ストリップショーの開幕だ！！」「このまま丸焼きにしてやれ！！」\n　　「おぉっ……ミカンちゃんのパンツが丸見えに…！」「み、みんなに見られちゃってるよ…！」「ミ、ミカンさんの生パンツ……！」\n　・ニョロモを抱きかかえたまま炎の中で苦しむミカンとその様子を頬を染めて興奮した様子で見る船乗りの男達\n　・服が炎でボロボロにされてスカートがほとんど焼け落ち、下着が丸見えの状態に\n４、「ミ、ミカンさんがあんな姿にされてるのに……」「俺たちには見ることしか…おぉっ……」「やば…お尻エッロ…」\n　・炎の中のミカンの後ろ姿のアップ\n　・お尻を突き出した体勢で強調させてしまっているように\n\n細かいコマ割りやセリフ等描きやすいように調整して頂いて構いません\nお忙しい中かなり要望の細かい漫画形式の依頼になってしまうのですが、よろしければご検討お願いします", "nc": 33, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@kskrkgk06/works/15", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2395085, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/041287cc/uploads/origins/bec55162-ed30-4952-b26d-27e8f379575f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=be064504c010d9783ddea954a884e2e4", "srcset": "https://si.imgix.net/041287cc/uploads/origins/bec55162-ed30-4952-b26d-27e8f379575f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=be064504c010d9783ddea954a884e2e4, https://si.imgix.net/041287cc/uploads/origins/bec55162-ed30-4952-b26d-27e8f379575f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=06781b33daf7c5794779d77caccdd96b 2x, https://si.imgix.net/041287cc/uploads/origins/bec55162-ed30-4952-b26d-27e8f379575f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=99bbb06226ef8ed84aeccdfb687a0bf2 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/041287cc/uploads/origins/bec55162-ed30-4952-b26d-27e8f379575f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=866d0a5b5bd8ce0610af1727c3e30e50", "srcset": "https://si.imgix.net/041287cc/uploads/origins/bec55162-ed30-4952-b26d-27e8f379575f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=866d0a5b5bd8ce0610af1727c3e30e50, https://si.imgix.net/041287cc/uploads/origins/bec55162-ed30-4952-b26d-27e8f379575f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=26a41bf285bdecc5bdbae053b69557b6 2x, https://si.imgix.net/041287cc/uploads/origins/bec55162-ed30-4952-b26d-27e8f379575f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=b58e8e9dc400c8582064a9a9bdc2034e 3x"}, "body": "キハダ先生お願いします\n\n男性主観 \n女性主導(女性優位)男性受け\n女性上位(騎乗位)\n膣内射精\n\n表情は\n説明が難しいですが強気、クール、ジト目、女性優位なので勝ってる、リード的な\n口は閉じてください\n\n胸は丸型で(大きめに盛ってもらえると嬉しいです)\n胸は外に流れないように\n\n女性は両膝を床についてください\n男性は女性の両方の胸を弱く揉んでください\n乳首は男性のてのひらで隠れる感じで\n乳首描写をする場合小さめで\n\n女性は男性の腕を掴んで胸元に引き寄せる感じで\n\n他の方の作品で申し訳ないですが、イメージに近いのを資料URLとして\n\n男女とも股間部毛無し\n\n背景は気にしないのでなくても構いません。\n差分とかあまり気にしないので、衣服の着脱はお任せしたいと思います。\nめんどくさかったら全裸でも\n\n胸と鼠蹊部や股間部あたりは見えたほうが嬉しいかなと…\nスマホ閲覧用に縦画像でお願いします。\n\nhttps://www.pixiv.net/artworks/91623930#big_0", "nc": 32, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@kskrkgk06/works/14", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/f21791d2/uploads/origins/cd4ef9bc-9c55-4cde-acb9-6ea8ae2ae560?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=2cc91f3a8a240fe8dab6277bca61c3de", "srcset": "https://si.imgix.net/f21791d2/uploads/origins/cd4ef9bc-9c55-4cde-acb9-6ea8ae2ae560?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=2cc91f3a8a240fe8dab6277bca61c3de, https://si.imgix.net/f21791d2/uploads/origins/cd4ef9bc-9c55-4cde-acb9-6ea8ae2ae560?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=dff0518a5bb192502f3a163affd3a346 2x, https://si.imgix.net/f21791d2/uploads/origins/cd4ef9bc-9c55-4cde-acb9-6ea8ae2ae560?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=133bd3e4c658037083eec94d612ea6d5 3x"}, "private": true, "genre": "art", "tipped": false, "creator_id": 2395085, "client_id": 73945, "nc": 48}, {"path": "/@kskrkgk06/works/13", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/2f337407/uploads/origins/5105d149-bf19-4bde-be62-9fcefcc4aedb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=2270b7df29f45f2a325b368fa9fbed42", "srcset": "https://si.imgix.net