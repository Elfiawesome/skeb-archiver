s://ja.m.wikipedia.org/wiki/%E7%B9%94%E7%94%B0%E4%BF%A1%E9%95%B7 )\n・首元より少し上程度の長さ\n・二重と涙袋と下睫毛で派手な印象の猫目\n・上がり眉(整えている)\n・両耳、耳輪に金・黒のイヤカフと耳朶にピアス(金)\n・ブランド物のネックレスを複数(イメージ:　 https://www.black-symphony.com/smp/item/chromehearts_babyfat_cross_charm-BK_d.html \n\nhttps://www.viviennewestwood-tokyo.com/f/dsg-2400984 )\n・瞳は紫(#B88ED1)、フチが#7C4A9B\n・てらてらしたシャツとスーツ、シャツは濃い紫(#2A1C35)、スーツは薄紫(#CBBCCE)\n・顔色は悪い(#E2DCDE)\n・爪は黒のマニキュア\n\nhttps://drive.google.com/file/d/1x0V2DQ-4MYaPPwRgQPFSCYU5L2m2-cPX/view?usp=drivesdk", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Fe2O3_sankatetu/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1357838, "client_id": 241957, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/ed0bb095/uploads/origins/12b8e447-6ee0-4898-80bb-916efb3646e0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=45eb3afe30d232b2cd429bef2f181c9b", "srcset": "https://si.imgix.net/ed0bb095/uploads/origins/12b8e447-6ee0-4898-80bb-916efb3646e0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=45eb3afe30d232b2cd429bef2f181c9b, https://si.imgix.net/ed0bb095/uploads/origins/12b8e447-6ee0-4898-80bb-916efb3646e0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ed31dce56a8e084e4997c86ddf804875 2x, https://si.imgix.net/ed0bb095/uploads/origins/12b8e447-6ee0-4898-80bb-916efb3646e0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=6857ccd779382769e2273f978a36ee98 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/ed0bb095/uploads/origins/12b8e447-6ee0-4898-80bb-916efb3646e0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e3e208abeb89f9329263011c7b2c40c8", "srcset": "https://si.imgix.net/ed0bb095/uploads/origins/12b8e447-6ee0-4898-80bb-916efb3646e0?bg=%23