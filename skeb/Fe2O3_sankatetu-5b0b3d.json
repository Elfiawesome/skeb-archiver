si.imgix.net/7f20b503/uploads/origins/2b0d8bc5-e335-48fb-849a-faecaaed051f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=1ab435351fd5b2bf66d8616b1e853724 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/7f20b503/uploads/origins/2b0d8bc5-e335-48fb-849a-faecaaed051f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=df80b87f76a1a4c09bc8d059ee78ab6a", "srcset": "https://si.imgix.net/7f20b503/uploads/origins/2b0d8bc5-e335-48fb-849a-faecaaed051f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=df80b87f76a1a4c09bc8d059ee78ab6a, https://si.imgix.net/7f20b503/uploads/origins/2b0d8bc5-e335-48fb-849a-faecaaed051f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=39c01c6c498d2bcc4a22a28ea3556d6b 2x, https://si.imgix.net/7f20b503/uploads/origins/2b0d8bc5-e335-48fb-849a-faecaaed051f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=079fe3b3a9cf001b015fb1879b2ef012 3x"}, "body": "新規リクエスト失礼致します。\nクトゥルフ神話TRPGのセッション内で使用する、NPCのウエストアップの立ち絵をお願いしたく思います。\n以下、リクエスト内容の詳細となります。\n\n◼️キャラ・設定：リンク先のNPC1( https://skeb.jp/@Fe2O3_nine/works/8 )\n※ リンク先のコミッション主様から、キャラデザと設定をお借りしたコミッション依頼の許可を得ています。\n◼️構図：正面\n◼️立ち絵1：のっぺりと暗い雰囲気。両腕を横に下ろして立っている。少し俯いている。\n◼️立ち絵2：立ち絵1と同じ構図で、目を閉じている表情差分。\n◼️立ち絵3：顔を逸らして斜め下を見ている。眉根を寄せている。少し苦しげな表情。\n片手でもう片方の二の腕を掴んでいる。\n◼️立ち絵4：顔を上げて、驚いた表情。汗を垂らしている。体を守るように片腕を身体の前に出している。\n◼️立ち絵5：立ち絵4と同じ構図で、少し声を荒らげている表情差分。", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Fe2O3_sankatetu/works/8", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1357838, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/2471e99b/uploads/origins/4cb0706b-7483-4adf-90f1-2170fc7ca0af?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h