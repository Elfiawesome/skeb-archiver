11Vjkj4jvFYB2g2XQj9wlUCvkt37UsE81/view?usp=drivesdk", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Fe2O3_sankatetu/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1357838, "client_id": 466897, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/0fb52921/uploads/origins/dd6637c2-10fa-460d-a9ae-a4f2c50d98c2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0b72a1567b56c190e3b6cb0d111293b6", "srcset": "https://si.imgix.net/0fb52921/uploads/origins/dd6637c2-10fa-460d-a9ae-a4f2c50d98c2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0b72a1567b56c190e3b6cb0d111293b6, https://si.imgix.net/0fb52921/uploads/origins/dd6637c2-10fa-460d-a9ae-a4f2c50d98c2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=34542cff78f913f3cdb0a5b761a0f115 2x, https://si.imgix.net/0fb52921/uploads/origins/dd6637c2-10fa-460d-a9ae-a4f2c50d98c2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=994a48bb1026d80818551307ee927422 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/0fb52921/uploads/origins/dd6637c2-10fa-460d-a9ae-a4f2c50d98c2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2acf74a89511422aaefc4148a764fec1", "srcset": "https://si.imgix.net/0fb52921/uploads/origins/dd6637c2-10fa-460d-a9ae-a4f2c50d98c2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2acf74a89511422aaefc4148a764fec1, https://si.imgix.net/0fb52921/uploads/origins/dd6637c2-10fa-460d-a9ae-a4f2c50d98c2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=229ee917da013fd3e6db6f36452cf1ee 2x, https://si.imgix.net/0fb52921/uploads/origins/dd6637c2-10fa-460d-a9ae-a4f2c50d98c2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=a573c459613ebb5f4e09778fbc2919da 3x"}, "body": "こんにちは、初めて依頼させていただきます！\n今回描いていただきたいのは、2004年夏にリリースされて2013年冬に配布終了となった【魍魎の館】という架空のツクール製フリーホラーゲームに登場するキャラクターの「墨波 遼河」です！\nゲーム中では、ペン型ライトを手に持ったり口に咥えたりして明かりに使い、館の中にいる敵を主にかなづち(元々持ってる固有アイテム)で撃退する青年です。\nこのキャラクターが、幽霊が跋扈する薄暗く古びた洋館の中を探索するイラストを描いてください！\n構図やシチュエーションはおまかせします。\n頂いたイラストは、印刷して自分の部屋に飾りたいと思います。\nよろしくお願いいたします！\n【資料】\n・ゲーム設定メモ\nhttps://www.charasuji.com/users/kamuy_ikor/book/book_2022121016333117870/memo\n・キャラクター詳細\nhttps://www.charasuji.com/users/kamuy_ikor/character/ch_2022121017283273456/profile", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Fe2O3_sankatetu/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1357838, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/fa545b3e/uploads/origins/dc3f7d97-3d60-4a19-9ab1-fdbdf76d2884?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4ab0e5e8939231f51f6f77700fe0e4d4", "srcset": "https://si.imgix.net/fa545b3e/uploads/origins/dc3f7d97-3d60-4a19-9ab1-fdbdf76d2884?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4ab0e5e8939231f51f6f77700fe0e4d4, https://si.imgix.net/fa545b3e/uploads/origins/dc3f7d97-3d60-4a19-9ab1-fdbdf76d2884?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c1d6a97ed19a8c0dac4ecc0589ad8942 2x, https://si.imgix.net/fa545b3e/uploads/origins/dc3f7d97-3d60-4a19-9ab1-fdbdf76d2884?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=0e7f3d8662ca1875e1c178e450f10a3d 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/fa545b3e/uploads/origins/dc3f7d97-3d60-4a19-9ab1-fdbdf76d2884?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=127d5bb42a5a66458bdd28085ec878ec", "srcset": "https://si.imgix.net/fa545b3e/uploads/origins/dc3f7d97-3d60-4a19-9ab1-fdbdf76d2884?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=127d5bb42a5a66458bdd28085ec878ec, https://si.imgix.net/fa545b3e/uploads/origins/dc3f7d97-3d60-4a19-9ab1-fdbdf76d2884?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=fae4c4b66cc31f3a7ae3f2027cbe31a2 2x, https://si.imgix.net/fa545b3e/uploads/origins/dc3f7d97-3d60-4a19-9ab1-fdbdf76d2884?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=616e93779d6256fa58b40f1f77a58df8 3x"}, "body": "いつもお世話になっております、へかと申します。\nクトゥルフ神話TRPGで使用しているキャラクター二人のイラストをどうにか酸化鉄さんの絵柄で見てみたいです。\n以下が二人のイメージとなります。\n参考程度ですので、酸化鉄さんの描きやすいように適宜変更して頂いて構いません。\nよろしくお願いいたします。 \n\n【構図イメージ】 \n・キャラクターが二人(兄:174cmホスト、弟:160cm小説家)\n・兄(ホスト)の方が黒塗りに金文字で『織田』と書かれた湯飲みでニコニコ飲んでいる\n・弟が死んだ目でそれを見ている\n・背景:特に考えつかず\n\n【キャラクター(PC)の特徴・服装等】 \n※イメージのため詳細に書いていますが、全てを反映させる必要はありません \n※ホスト兄は前回依頼して描いていただいた人物ですので、文字数制限の都合上省かせていただきます、スーツや胸元のアクセ無くて大丈夫です\n\n《弟:小説家》\n・160cm\n・職業小説家の20歳、ペンネームは『相互不可 侵之助』(本人のセンスではない)\n・ふわふわとした黒髪(#281C36)のセンター分け、かなり適当に切られている\n・太眉の一重、涙袋とクマが一緒になっている\n・睫毛が下向き\n・肌が白く(#FFEFF0)女性のような細い骨格\n・瞳の色は(#BE98D5)だが瞳孔(#7025B4)が丸く大きいのでそっちの印象が強い、目の下側は薄くいろんな色がある(普段はきらきらしていないがいいものを見るときらきらする)\n・左半分に火傷跡あり(資料添付してます)\n・ぴったりとした紺のタートルネック(#101039)\n・陰気そう\n\nhttps://drive.google.com/drive/folders/157MyUvC50ViTp80U6Y0paU9cnHPpSUIb", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Fe2O3_sankatetu/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1357838, "client_id": 241957, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/e685ca12/uploads/origins/44813065-578c-4bbe-ae25-3e570da870fc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b38de88d6357a3b79b4c2f301df4ae23", "srcset": "https://si.imgix.net/e685ca12/uploads/origins/44813065-578c-4bbe-ae25-3e570da870fc?bg=%23fff&auto=fo