tipped": false, "creator_id": 860366, "client_id": 1168586, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/0da955b3/uploads/outputs/102fc80c-48d2-40b9-b11d-a4031694f9e7?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&s=5a12e65cbcad321d06efecd6948dc242", "srcset": "https://si.imgix.net/0da955b3/uploads/outputs/102fc80c-48d2-40b9-b11d-a4031694f9e7?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&s=5a12e65cbcad321d06efecd6948dc242, https://si.imgix.net/0da955b3/uploads/outputs/102fc80c-48d2-40b9-b11d-a4031694f9e7?bg=%23fff&fm=webp&auto=compress&dpr=2&fit=crop&crop=top&w=200&h=200&s=57b8cc817ff4940d5cccbb960ca08625 2x, https://si.imgix.net/0da955b3/uploads/outputs/102fc80c-48d2-40b9-b11d-a4031694f9e7?bg=%23fff&fm=webp&auto=compress&dpr=3&fit=crop&crop=top&w=200&h=200&s=e8eed052bdcf39066baafe93e12ebad0 3x"}, "duration": 664, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/0da955b3/uploads/outputs/102fc80c-48d2-40b9-b11d-a4031694f9e7?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&blur=200&s=2d63bbfeb514c6f56f9f4261702bc303", "srcset": "https://si.imgix.net/0da955b3/uploads/outputs/102fc80c-48d2-40b9-b11d-a4031694f9e7?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&blur=200&s=2d63bbfeb514c6f56f9f4261702bc303, https://si.imgix.net/0da955b3/uploads/outputs/102fc80c-48d2-40b9-b11d-a4031694f9e7?bg=%23fff&fm=webp&auto=compress&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=33962bd04ad1d3f2ba738f8a4154d110 2x, https://si.imgix.net/0da955b3/uploads/outputs/102fc80c-48d2-40b9-b11d-a4031694f9e7?bg=%23fff&fm=webp&auto=compress&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=01de74b018dd1f3eed7d9ad4123e5893 3x"}, "body": "なかんにゃ！！！\nこんにちは、あなたのバーチャルお友達、居眠りメイです。\n今回のお便りは、兵庫県の悩める羊さんからのお便りです。\n「私はVtuberでもなければ、ネットアイドルを目指しているわけでもなく、\n　歌も下手で踊りも踊れず、VRChatで自撮りをするのすら億劫になってきた、\n　ただのバ美肉ボイチェンおじさん大好きおじさんです。\n　そんな私ですが、オリジナルソングや自分だけのイントロみたいなのに強烈なあこがれがあり、\n　いつかお友達の作曲家さんにSkebで依頼をしたいと思っています。\n　そこで相談なのですが、Skebのミュージックの依頼って、どういう風に出せばいいでしょうか。\n　音楽知識ほぼゼロの私でも、作曲家さんが方向性に困ったり、作業中に悩まないように、\n　的確な依頼を出すには、どんなことを書いたらいいでしょうか」\nということです。あー、わかります。こういう悩みありますよね〜。\n依頼を出すのって実は結構難しくて、自分の中にあるイメージを固めたり、\n要求を文章にしたりするのって、絶対必要になるけれどもなかなか大変なんですよねー。\nシステム開発でも、要件定義は肝で、ここが駄目だと「顧客が本当に求めていたもの」みたいに、\nまったく求めてなかったものができちゃったりするんですよね。\nとはいいつつ、最初の依頼で思い通りのものを頼むっていうのはちょっとハードルが高いですよねぇ。\n大抵クリエイターさんは、依頼者の思っているよりも上のクオリティのものを出してきてくれますし、\nイメージを固めすぎずに、好きに作ってもらえるように丸投げするっていうのも手ですよね。\nもちろん、核となるイメージが有ると作りやすいので、ほんとに丸投げじゃ駄目だと思いますが（笑）\nなかにゃんさんはどう思います？", "nc": 145, "word_count": 0, "transcoder": "video", "creator_acceptable_same_genre": false}, {"path": "/@naca_nyan/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "music", "tipped": false, "creator_id": 860366, "client_id": 219602, "vtt_url": null, "thumbnail_image_urls": {"src": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1761448148437012480%2F5uqFczQd.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=65b603ed26257e9ee9ee8676c0343142", "srcset": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1761448148437012480%2F5uqFczQd.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=65b603ed26257e9ee9ee8676c0343142, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1761448148437012480%2F5uqFczQd.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=07d2cb535e3a928ce3e9abbf7fe57f7a 2x, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1761448148437012480%2F5uqFczQd.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=6d1f67dd876e9426a0069f1813705edf 3x"}, "preview_url": "https://fcdn.skeb.jp/uploads/outputs/7904f7ea-cf52-4cb0-ba0d-d46dbbc1dd63?response-content-disposition=inline&Expires=1781942557&Signature=A7mCOZKqpzEnEHRD4Kp4zVa3kM0qAseKHF7ptKPG2trun9-QbK8Ax5GD762hlhjGd3824gBGYZcVUgl6m~lFNtaOa9CCRn3g