もお任せします\n\n指定が細かくて恐縮ですが、是非よろしくお願いします。", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 805031, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "無職ロリ@お仕事募集中", "screen_name": "0_shusi_", "avatar_url": "https://pbs.twimg.com/profile_images/2062865805218619392/4M29TAHn.jpg", "header_url": null, "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 7, "complete_expiration_days": 30, "skills": [{"genre": "art"}], "banned": false, "nc": 168}, {"id": 936968, "creator": true, "nsfw_acceptable": true, "acceptable": false, "name": "もち@受かれば夏コミ", "screen_name": "riku_mochiduki", "avatar_url": "https://pbs.twimg.com/profile_images/1932892763437346816/5HKVahjZ.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1529071433024176133/1760719158/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 3, "complete_expiration_days": 60, "skills": [{"genre": "art"}], "banned": false, "nc": 161}, {"id": 1001966, "creator": true, "nsfw_acceptable": false, "acceptable": false, "name": "ねーじゅ", "screen_name": "snowss__", "avatar_url": "https://pbs.twimg.com/profile_images/1681301832172462082/zTL4eKSp.jpg", "header_url": "https://pbs.twimg.com/profile_banners/226545459/1644402620/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 90, "skills": [{"genre": "art"}], "banned": false, "nc": 160}, {"id": 2639061, "creator": true, "nsfw_acceptable": false, "acceptable": false, "name": "江", "screen_name": "edogawam", "avatar_url