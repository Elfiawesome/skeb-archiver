ーパーハイレグでTバック、サイハイストッキングとハイヒール有り、バストは両方さらけ出して乳首に搾乳機が付けられて、母乳を搾乳\nされてます。バストサイズはRカップ以上です。位置は真横からで、頭が左側です。トキの表情は何十日も犯された為、完全に快楽落ち。乳首の大きさは普通であり堅く勃起してます。搾乳機のホースは別の部屋へ続くとわかればよいです。\nバニー服とうさ耳の色は紺色、尻尾と襟は白、蝶ネクタイは水色。頭のリボンも紺色でよろしくお願いします。", "nc": 187, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@zp_R/works/164", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 34000, "client_id": 0, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/b022f29d/uploads/origins/a460dc2b-ab2c-4f03-88b9-c25269d3b92b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0b3d353f71f5ed37adfead5e0cba9c08", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/b022f29d/uploads/origins/a460dc2b-ab2c-4f03-88b9-c25269d3b92b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=01125ec039e539e061e30de6c0ece7f7", "src_set": ""}, "body": "スーパーロボット大戦より「ヴァルシオーネR」をお願いします。\nロボットですが操者と表情や動きがリンクしているため、人間にかなり近い機体です。\n\nシチュエーションは\n全身を触手でからめとられて、口と秘部と尻に挿入され射精されている状態。\n胸にも触手が張り付いていて強烈にエナジードレインされている状態。\n犯されてからかなりの時間が経過しており、全身は精液まみれで\n表情は疲弊している感じで。\n装甲の破損や傷、出血は無しでお願いしたいのですが、\n秘部装甲および胸装甲は生身の人間のような感じでお願いしたいので\nその部分は破損している状態で大丈夫です。\n\n体勢はお任せします。背景もお任せします。触手の形状もお任せします。\n陰毛は無しで。", "nc": 41, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@zp_R/works/163", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 34000, "client_id": 912144, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/d298b421/uploads/origins/125127f0-6314-44ac-adac-723cf74e7a13?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4f97d5d563cb9cf11749e6ddbef2dfac", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/