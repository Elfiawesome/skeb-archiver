it=crop&crop=top&w=200&h=200&s=64f252f6e47232fa70b282b9f3edd470 2x, https://si.imgix.net/324b986b/uploads/origins/1bd21f48-6101-47dc-9ab1-80c1072b985f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=73ebc5f3d807e6bac7512c69e1f645b9 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/324b986b/uploads/origins/1bd21f48-6101-47dc-9ab1-80c1072b985f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2fdfd6ba3d913c5500da25927eacdc2a", "srcset": "https://si.imgix.net/324b986b/uploads/origins/1bd21f48-6101-47dc-9ab1-80c1072b985f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2fdfd6ba3d913c5500da25927eacdc2a, https://si.imgix.net/324b986b/uploads/origins/1bd21f48-6101-47dc-9ab1-80c1072b985f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=97340f24bfe467801cd52e6cb2e21fd6 2x, https://si.imgix.net/324b986b/uploads/origins/1bd21f48-6101-47dc-9ab1-80c1072b985f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=ddaa6ece82b65645af3f8fecf47c2344 3x"}, "body": "初めまして！いつも作品を楽しませて頂いてます！\nぷんこさんのイラストは宝石のようにキラキラしていて、まるでお気に入りのアクセサリーやコスメを見ている時のような気持ちになれて、とっても大好きです✨️\n\n早速ですが、今回の依頼の内容についてです。\n\n・用途\nスマホの壁紙、鑑賞など\n\n・イラストの概要\n赤い口紅を塗っている女性の絵をお願いしたいです。\n\n・女性の外見について\n髪型は黒髪でストレートのロング。\n顔立ちは、ややつり目で三白眼気味。\nあと、下まつげがバサバサ生えていると嬉しいです…！\n細かい服装や構図や色合い等については、ぷんこさんにお任せしたいです！\n\n私にとって今回が初めてのSkebの依頼なので、何か失礼な点や至らないところがありましたら、大変申し訳ございません。\n何卒よろしくお願い致します🙏", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 2308707, "creator": true, "nsfw_acceptable": true, "acceptable": false, "name": "さかなお嬢様", "screen_name": "ousakana0325", "avatar_url": "https://pbs.twimg.com/profile_images/2013207616248487936/i_Deax00.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1331204998345068544/17688