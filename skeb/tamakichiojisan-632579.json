視線は徐々に熱っぽくなるし、そこかしこで吹き上がる乳の香りはやがて街中に満ちて……みたいな感じのお話を見てみたいです。\nかなり具体的に指定してしまいましたけど、おっぱい出るぽっちゃりケモショタが屋外で裸スニーカーとかでえっちなことする姿がとにかく見たいです。\n登場人物は全員力強くひとちん仮性包茎絶倫仕様がいいです。ちょっと優しくも天然なノリを期待しております。\nちょっと熱がこもってしまいましたけど、よろしくお願いします……！", "nc": 58, "word_count": 6916, "transcoder": "text", "creator_acceptable_same_genre": false}, {"path": "/@tamakichiojisan/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "novel", "tipped": true, "creator_id": 34890, "client_id": 436504, "vtt_url": null, "thumbnail_image_urls": {"src": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1378860591620583424%2Fmv-KlZgt.jpg?blend64=aHR0cHM6Ly9za2ViLWF2YXRhci5pbWdpeC5uZXQvfnRleHQ_&blendalpha=100&blendalign=center&blendmode=normal&blendsize=inherit&bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fca1d36fd624835a3b460ddb311ea6f6", "srcset": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1378860591620583424%2Fmv-KlZgt.jpg?blend64=aHR0cHM6Ly9za2ViLWF2YXRhci5pbWdpeC5uZXQvfnRleHQ_&blendalpha=100&blendalign=center&blendmode=normal&blendsize=inherit&bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fca1d36fd624835a3b460ddb311ea6f6, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1378860591620583424%2Fmv-KlZgt.jpg?blend64=aHR0cHM6Ly9za2ViLWF2YXRhci5pbWdpeC5uZXQvfnRleHQ_&blendalpha=100&blendalign=center&blendmode=normal&blendsize=inherit&bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=310f279b73b3c0f347169d289bdec154 2x, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1378860591620583424%2Fmv-KlZgt.jpg?blend64=aHR0cHM6Ly9za2ViLWF2YXRhci5pbWdpeC5uZXQvfnRleHQ_&blendalpha=100&blendalign=center&blendmode=normal&blendsize=inherit&bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=8e86804732f80be57132d945c4bf924a 3x"}, "duration": null, "nsfw": true, "hardcore": true, "consored