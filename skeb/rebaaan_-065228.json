いません。かわいくてロマンチックなものなら何でもOKです。\n\nキャラクター1\n164cm、赤毛、ティールアイ。\n服装は参考資料の中から自由に選んでください。服のディテールは自由に縮小してください。\nhttps://toyhou.se/14993505.mira-delphinium/gallery\n\nキャラクター2。\n159cm、赤毛、赤目。\n服のディテールを自由に縮小してください。\nhttps://imgur.com/a/WlAQWnb\n\n二人の関係動態は参考URLでも紹介されています。\n\n私の要望を考慮していただき、本当にありがとうございました", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@rebaaan_/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1957254, "client_id": 667554, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/7d3eec4a/uploads/origins/62409cc5-fe10-4997-a903-6b57224d771d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=93457f9c4d46383a29d1f0955a695a9e", "srcset": "https://si.imgix.net/7d3eec4a/uploads/origins/62409cc5-fe10-4997-a903-6b57224d771d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=93457f9c4d46383a29d1f0955a695a9e, https://si.imgix.net/7d3eec4a/uploads/origins/62409cc5-fe10-4997-a903-6b57224d771d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a619f261419dd6717a57b3e31be60f7d 2x, https://si.imgix.net/7d3eec4a/uploads/origins/62409cc5-fe10-4997-a903-6b57224d771d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=3b213fe1a57283aff9ee0459b86cff4a 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/7d3eec4a/uploads/origins/62409cc5-fe10-4997-a903-6b57224d771d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=bc3c78e49ed646d4ce80870520cd4f68", "srcset": "https://si.imgix.net/7d3eec4a/uploads/origins/62409cc5-fe10-4997-a903-6b57224d771d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=bc3c78e49ed646d4ce80870520cd4f68, https://si.imgix.net/7d3eec4a/uploads/origins/62409cc5-fe10-4997-a903-6b57224d771d?bg=%23fff&auto=format%