tus/2064890363278680126?s=20\n\n特にNGもなく、ねむやまさんのさんのセンスが大大好きなので上記で記載した要素よりねむやまさんセンスを優先して、お任せしたいです！\n\n✦使用用途\n・TRPGで遊ぶ際に立ち絵として使用\n・今後のキャラクター資料としての使用\n　−もしかしたら行う事\n・アイコン・ヘッダーとしての使用\n・個人利用範囲での印刷やグッズ化\n\nデータはPSDで頂けると嬉しいです。\n\n内容が合わなければキャンセルしていただいて大丈夫です！\nお忙しいなか恐れ入りますが、ご検討よろしくお願いいたします！", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@_nemnem/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3627034, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/5cad3f04/uploads/origins/50bd5ead-f0a6-46dc-aee4-e4b4d4b0e356?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a9943e4df2c112cbd5cddd5eda48fc55", "srcset": "https://si.imgix.net/5cad3f04/uploads/origins/50bd5ead-f0a6-46dc-aee4-e4b4d4b0e356?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a9943e4df2c112cbd5cddd5eda48fc55, https://si.imgix.net/5cad3f04/uploads/origins/50bd5ead-f0a6-46dc-aee4-e4b4d4b0e356?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=8b7bfa859d18d184747c53a559b63bcb 2x, https://si.imgix.net/5cad3f04/uploads/origins/50bd5ead-f0a6-46dc-aee4-e4b4d4b0e356?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=897ee130e9cfec43d4530b060d8a0bb9 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/5cad3f04/uploads/origins/50bd5ead-f0a6-46dc-aee4-e4b4d4b0e356?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=fc0c9930790795311c62d04b5e30b4bf", "srcset": "https://si.imgix.net/5cad3f04/uploads/origins/50bd5ead-f0a6-46dc-aee4-e4b4d4b0e356?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=fc0c9930790795311c62d04b5e30b4bf, https://si.imgix.net/5cad3f04/uploads/origins/50bd5ead-f0a6-46dc-aee4-e4b4d4b0e356?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop