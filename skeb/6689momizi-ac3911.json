e4-8252-4ab4-abff-6a7d055e30e6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c7eacae71971a529b8ef1881d78d0469, https://si.imgix.net/f1c7b121/uploads/origins/0a8ec5e4-8252-4ab4-abff-6a7d055e30e6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=f9b8169993d91cdff9eaa9decf6ab98d 2x, https://si.imgix.net/f1c7b121/uploads/origins/0a8ec5e4-8252-4ab4-abff-6a7d055e30e6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=7d5e7af8a40bea6c62e78c471db98a94 3x"}, "body": "この度はお世話になります。\nML1Tyanと申します。\n\n当方のメインアカウントにて、ゐともみじ様の咲季お姉ちゃんの誕生日イラストが流れて参りまして、絵柄等好みと一致いたしましたため、是非イラストの作成をご依頼させていただきたい次第でございます。用途、デザイン等の詳細につきましては、下記のとおりでございます。当方Skebを利用するのが初めて故、不備等あるかと存じますが、何卒ご検討賜りたくお願いいたします。\n\n【依頼事項】\n・スマートフォンのホーム画面にて使用するイラストの作成\n\n【内容】\n・アイドルマスターシャイニーカーラーズの桑山千雪、学園アイドルマスターの姫崎莉波、アイドルマスターシンデレラガールズの三船美優の３名が描かれている縦長のイラスト１枚を納品いただきたい。立ち位置については、左から三船美優、桑山千雪、姫崎莉波といたしたい。\n（参考）\n桑山千雪\nhttps://shinycolors.idolmaster-official.jp/idol/alstroemeria/chiyuki/\n\n姫崎莉波\nhttps://gakuen.idolmaster-official.jp/idol/rinami/\n\n三船美優\nhttps://idollist.idolmaster-official.jp/detail/20160\n\n・衣装について、桑山千雪については「剥がされて、虚ろ」、姫崎莉波については「clumsy trick」のステージ衣装（特訓４以降衣装）、三船美優については「ルージュクチュール」を着用しているイラストにしていただきたい。\n\n剥がされて、虚ろ\nhttps://campaign-shinycolors-song-for-prism.idolmaster-official.jp/283prostyle/collection/chiyuki-hagasare/\n\nclumsy trick\nhttps://seesaawiki.jp/gakumasu/d/%A1%DAclumsy%20trick%A1%DB%C9%B1%BA%EA%E8%BD%C7%C8\n\nルージュクチュール\nhttps://dere-ken.com/?p=11625\n\n・立ち位置以外のポーズ、表情、背景色については一任する\n\n【仕様】\n・納品については.jpgもしくは.pngでの納品とする。ただしSkebの仕様上難しければ、他の種類でも可能とする。\n\n・ピクセル数については一任するが、美麗さを損なわない程度の画質以上とされたい。\n\n【付記事項】\n・当方が使用しているスマートフォンは、SONYのXperia1 Ⅳにつき、画面比が21:9と通常の16:9と異なることから、イラストの縦横比についてはこれを考慮されたい。\n\n・納品されたイラストについては、Skebの利用規約、また社会通念上許容される範囲にてX（旧Twitter）のアイコン等での使用など流用する可能性がある。\n\n・納品されたイラストについて、Skebの利用規約に基づく限りにて、クリエイター側が公表、使用その他広報活動に使用することについて、一切の制限を設けない。\n\n・その他疑義事項については、Skeｂの利用規約に従うものとする。\n\n\n以上、大変不躾な依頼ではございますが、ご検討賜れますと幸甚でございます。\n何卒よろしくお願いいたします。", "nc": 161, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@6689momizi/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 851616, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/d055edd0/uploads/origins/9ccecc07-0fad-4caa-ad1f-a5cae078b5ee?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4d4c2a473ce28f7a83871d4f804ec888", "srcset": "https://si.imgix.net/d055edd0/uploads/origins/9ccecc07-0fad-4caa-ad1f-a5cae078b5ee?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4d4c2a473ce28f7a83871d4f804ec888, https://si.imgix.net/d055edd0/uploads/origins/9ccecc07-0fad-4caa-ad1f-a5cae078b5ee?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=16a802a7bff3244fccd689b2412356fd 2x, https://si.imgix.net/d055edd0/uploads/origins/9ccecc07-0fad-4caa-ad1f-a5cae078b5ee?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=339f3d7f09e912a23cafc6114fa4f42b 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/d055edd0/uploads/origins/9ccecc07-0fad-4caa-ad1f-a5cae078b5ee?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=31ee2ab70648e9a7f96fb092932e3b99", "srcset": "https://si.imgix.net/d055edd0/uploads/origins/9ccecc07-0fad-4caa-ad1f-a5cae078b5ee?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=31ee2ab70648e9a7f96fb092932e3b99, https://si.imgix.net/d055edd0/uploads/origins/9ccecc07-0fad-4caa-ad1f-a5cae078b5ee?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=9d8d68a1dc18a26c9895bec31c5c9815 2x, https://si.imgix.net/d055edd0/uploads/origins/9ccecc07-0fad-4caa-ad1f-a5cae078b5ee?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=05e0a43a287ca411ca2ea65b4bb8a79b 3x"}, "body": "学マスの姫崎莉波をお願いします。\n\nシチュエーションは、花梅姉妹とPにプロデュースされて\n妹系キャラアイドルになった莉波さんがみたいです。\n\n咲季の妹になって莉波さんに咲季と佑芽の要素を足したイメージでお願いしたいです。\n\n髪型は元の髪型を残しつつ、咲季の髪型のツーサイドアップだけを真似て咲季風の髪型を足す。\n(髪の毛をもとよりも伸ばして元の髪型とボリュームも維持する。ややツインテ風) \n\n莉波さんの地毛の髪色の大部分は変えずに残しつつ、佑芽のように先の部分だけ赤みに染める。(髪色全体を変えるのではなく部分染め)\n\n表情は瞳の開け方を元の自分の開け方のまま、佑芽のように眉毛だけを吊り上げるよう意識して口を大きくあけて元気いっぱいな表情。(キャラは佑芽のような妹系キャラ)\n\n衣装は、花海佑芽のレッスンウェアと全く同じ衣装を着てへそ出し丈に調整された衣装。\n(レギンスとかは着ないで靴なども佑芽のものにする)\n\n背景無しで構いません。\n全身絵の正面絵でお願いします。\nご検討よろしくお願いします。", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@6689momizi/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 851616, "client_id": 2685499, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/7f7ae3ef/uploads/origins/da638e19-17e7-4794-8ba5-f07df301b201?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8eecd450d1bc3041eacb2a9c141fa322", "srcset": "https://si.imgix.net/7f7ae3ef/uploads/origins/da638e19-17e7-4794-8ba5-f07df301b201?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8eecd450d1bc3041eacb2a9c141fa322, https://si.imgix.net/7f7ae3ef/uploads/origins/da638e19-17e7-4794-8ba5-f07df301b201?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=bb3a2aab474f93820e5f39a21813d3f5 2x, https://si.imgix.net/7f7ae3ef/uploads/origins/da638e19-17e7-4794-8ba5-f07df301b201?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=56f3b7f2e45dd60dd7614684fcfbcd4b 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/7f7ae3ef/uploads/origins/da638e19-17e7-4794-8ba5-f07df301b201?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a1b0b5acc442b3e3f7e4cd479b6c6c0a", "srcset": "https://si.imgix.net/7f7ae3ef/uploads/origins/da638e19-17e7-4794-8ba5-f07df301b20