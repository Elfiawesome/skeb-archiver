si.imgix.net/bf179613/uploads/origins/94876260-62df-440b-a98d-0846f1c0c41f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=bfd2c236c63148f43256526079235d87 3x"}, "body": "以前は素晴らしいイラストありがとうございました！\n今回、改めて悪魔聖歌隊シチュでコミックをお頼みしたくリクエストしました\n\n【内容イメージ】 \n狼崎様が描かれていた変身ヒロインと女科学者の漫画(https://www.pixiv.net/artworks/112938882)にて女科学者のミーテさんが悪魔聖歌隊にされてしまい秋奈や滝を苦しめるような展開で\n・ミーテさんが敵に捕まり化粧をされて操られる\n・他の操られた女性と一緒に人間を苦しめる合唱をして秋奈達を苦しめる\n・秋奈たちから正気に戻ってと懇願されても表情を変えず歌を続けむしろ追い詰めていく\n上記のような展開を盛り込んでいただけると幸いです\n\nミーテを操る怪人などの要素はアレンジ・省略していただいても大丈夫です。 \n\n  【デザインなど希望】 メイク、装飾物（カチューシャ）は資料URL参考。多少不気味な感じとなってもよいのでメイク(濃い紫の口紅、鼻の根本から目尻を広く覆う紫のノーズ/アイシャドウ、キツいアイライン)とリボンカチューシャは元デザインに近い形でお願いします。  \n\nその他参考URL： \nhttps://m.youtube.com/watch?v=oPnvJIf-6zA\nhttp://blog.livedoor.jp/k_nishikwi/archives/6389134.html\n\nhttps://cavaba.hatenablog.com/entry/2019/05/05/151351", "nc": 160, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@rusknora_so/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 759432, "client_id": 26072, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/a40a79f1/uploads/origins/780fb061-66ee-4e0f-9ea2-c3f05012dc4b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6c659088708d5c6f5a20584c71f6da20", "srcset": "https://si.imgix.net/a40a79f1/uploads/origins/780fb061-66ee-4e0f-9ea2-c3f05012dc4b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6c659088708d5c6f5a20584c71f6da20, https://si.imgix.net/a40a79f1/uploads/origins/780fb061-66ee-4e0f-9ea2-c3f05012dc4b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=acced1a2c500a804fbb8237656786468 2x, https://si.imgix.net/a40a79f1/uploads/origins/780fb061-66ee-4e0f-9ea2-c3f05012dc4b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=237e19fd185da4bef436645803cacaac 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/a40a79f1/uploads/origins/780fb061-66ee-4e0f-9ea2-c3f05012dc4b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=4de39c3536b21c9f14506d5875d93a7b", "srcset": "https://si.imgix.net/a40a79f1/uploads/origins/780fb061-66ee-4e0f-9ea2-c3f05012dc4b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=4de39c3536b21c9f14506d5875d93a7b, https://si.imgix.net/a40a79f1/uploads/origins/780fb061-66ee-4e0f-9ea2-c3f05012dc4b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=6eb6f5db774d71af55fee253e486bc65 2x, https://si.imgix.net/a40a79f1/uploads/origins/780fb061-66ee-4e0f-9ea2-c3f05012dc4b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=3efae71bf08406c7bfe2671cb0068ad5 3x"}, "body": "次のような設定の物語を狼崎 野良様の世界観で展開していただければと思います。\n\n登場人物は変身ヒロイン2人と彼女たちをサポートする女性科学者。\n変身アイテムの開発者である科学者は裏で既に敵の手に堕ちていて、変身ヒロイン2人の変身アイテムに因子を仕込んで堕とそうとする。\n片方のヒロインは何も知らずに改造変身アイテムを使用し変身を試み、相方の目の前で堕ち、邪悪な姿へと変貌してしまう。\n相方は変身アイテムが改造されていることに気づいて変身せずにいるが、変身できない非力な少女である彼女は、邪悪な力を手に入れた変身ヒロインを相手に苦戦。\nさらに科学者の挟み撃ちにあって退路を絶たれ、最終的に2人の前に屈してしまう。\n2人の手によって改造変身アイテムを使用させられ強制変身した彼女は、先に堕ちたヒロインよりも邪悪で美しい姿へと変貌する。", "nc": 25, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@rusknora_so/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 759432, "client_id": 638155, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/a3aa86cb/uploads/origins/5bfe5d93-050c-4197-af76-7b50764c8dcf?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3d49834c217c7606f5131aeb66a23903", "srcset": "https://si.imgix.net/a3aa86cb/uploads/origins/5bfe5d93-050c-4197-af76-7b50764c8dcf?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3d49834c217c7606f5131aeb66a23903, https://si.imgix.net/a3aa86cb