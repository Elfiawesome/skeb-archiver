ount": 0, "received_works": [{"path": "/@sushi_human_P/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "novel", "tipped": true, "creator_id": 264782, "client_id": 1562358, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/042532be/uploads/origins/69e3c6a2-bf95-4347-849d-3740b3820907?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8d56b6fc4f73ceefab4119dd631d44d0", "srcset": "https://si.imgix.net/042532be/uploads/origins/69e3c6a2-bf95-4347-849d-3740b3820907?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8d56b6fc4f73ceefab4119dd631d44d0, https://si.imgix.net/042532be/uploads/origins/69e3c6a2-bf95-4347-849d-3740b3820907?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=12790d699229b69283e6c07023b18012 2x, https://si.imgix.net/042532be/uploads/origins/69e3c6a2-bf95-4347-849d-3740b3820907?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=952120a96fdb76feb8c96afd90a03b8c 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/042532be/uploads/origins/69e3c6a2-bf95-4347-849d-3740b3820907?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f0594a24befdfb8b5ed3319bd3f03b16", "srcset": "https://si.imgix.net/042532be/uploads/origins/69e3c6a2-bf95-4347-849d-3740b3820907?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f0594a24befdfb8b5ed3319bd3f03b16, https://si.imgix.net/042532be/uploads/origins/69e3c6a2-bf95-4347-849d-3740b3820907?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=bc11a750c319425a633dcd88d3cb251f 2x, https://si.imgix.net/042532be/uploads/origins/69e3c6a2-bf95-4347-849d-3740b3820907?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=9af8969f324ea7186a4f55d87dd6ae08 3x"}, "body": "前回は城ヶ崎美嘉のめっちゃエロいAV撮影をありがとうございました。今回は前作の続きという形で城ヶ崎莉嘉の青姦旅行ものをお願いしたいです。\nお姉ちゃんがエッチなビデオを撮っててずるい、あたしもやりたい！とPにおねだりしてAV参加(Pともセックスしてるが文字数が厳しいようならここは省略して、後述のインタビュー時にちらっと話に出てくるくらいでかまいません)。ハイエースなどのワゴン車で1泊2日の撮影旅行、スタッフ兼竿役の男優達と色々な場所で野外プレイを撮影する。\n·移動中の車内でインタビューされながら胸を揉まれたり手マンされたり、窓を開けて外から見られそうになりながら本番も(気づかれても気づかれなくてもどちらでも大丈夫です)\n·人気のないパーキングエリアにある公衆便所(男性側)でバイブやディルドでオナニー、個室に入ってセックス。射精したちんこをお掃除フェラ\n·森の中や橋の下に車を止め、野外で青姦。壁や木に手をついて立ちバック。男優がスパート中に莉嘉の腰を掴み、足がブラブラ浮いた状態で激しくピストン。出した精液が尻や太ももを伝って地面にボトボト垂れてると興奮します\n·宿泊旅館の温泉(室内銭湯、露天風呂どちらでも大丈夫)でスタッフ全員で輪姦。正常位で突かれてる莉嘉の上に跨りイラマチオ。全員の中出しや口内射精で膣や口の中が泡立っている\n·寝てる莉嘉に睡姦。温泉浴衣を着ているがその下はノーブラノーパン。莉嘉は寝ているが体はめっちゃ反応している。口の前にちんこをだすと寝ながら舐めてくる。最後まで寝ていても寝たフリでもよし\n·旅行の帰りに旅館近くの海でスク水か[夏休み]城ヶ崎莉嘉の水着を着ての青姦。水着は脱がずに股間部をずらして挿入したり肩紐だけ外して胸が丸出しの格好にしてください。最後に全身精液まみれでベタベタの顔や手でクパァした腟内を見せつけて終了\nこれらのセックスシーンでどくまぐろさんが書けるものをお願いします。優先順位としては\n温泉輪姦＞野外青姦＞海での青姦＞公衆便所でセックス＞車内インタビュー＆セックス＞睡姦＞撮影前のPとのおねだりセックス\nです。詰め込めれるだけお願いします。\n莉嘉の体型ですが、胸は公式より少し大きめ(エッチばかりしてたら大きくなり谷間ができるようになったと自慢げ。美嘉よりはまだまだ小さい)、陰毛薄めのスジマンでお願いします。\n細かい内容や場所はどくまぐろさんが書きやすいように変えてしまって構いません。\nこれらの設定で問題なければよろしくお願いします。", "nc": 184, "word_count": 8493, "transcoder": "text", "creator_acceptable_same_genre": false}, {"path": "/@sushi_human_P/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "novel", "tipped": true, "creator_id": 264782, "client_id": 1562358, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/93a5577d/uploads/origins/1c6d9df5-01e6-4b5d-8e66-6b0391e59e00?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4990dc712e2c3db17df2c07474c12707", "srcset": "https://si.imgix.net/93a5577d/uploads/origins/1c6d9df5-01e6-4b5d-8e66-6b0391e59e00?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4990dc712e2c3db17df2c07474c12707, https://si.imgix.net/93a5577d/uploads/origins/1c6d9df5-01e6-4b5d-8e66-6b0391e59e00?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=24aff3082e2bc2a1851f0946bf7de860 2x, https://si.imgix.net/93a5577d/uploads/origins/1c6d9df5-01e6-