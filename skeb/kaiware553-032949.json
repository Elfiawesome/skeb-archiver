(下半身が大きなスカートで隠れていてどういう構造か分からないのですが、実はレオタード的なものだったら良いなぁと常々思っているので、ここではそういうことで)、差分により色々なポージングを用意して貰えると捗ってありがたいです。\nその為値段を少し上げましたが、それでも複数のイラストは大変でしょうから、値段相応に一枚分のクオリティを落として貰って構いません(台詞やシチュエーションの有無等は任せます)。\n\n先生自身も惚れ惚れするような最高にセクシーな外來レミリアをお願いします！！！！🙇", "nc": 33, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@kaiware553/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1415080, "client_id": 80610, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/6bd1f36a/uploads/origins/d334915b-87b6-49be-8302-63762b55e338?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=418ebeae05617352b8b093e461287481", "srcset": "https://si.imgix.net/6bd1f36a/uploads/origins/d334915b-87b6-49be-8302-63762b55e338?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=418ebeae05617352b8b093e461287481, https://si.imgix.net/6bd1f36a/uploads/origins/d334915b-87b6-49be-8302-63762b55e338?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c542444fe098c97acfb2a6e7a532e63d 2x, https://si.imgix.net/6bd1f36a/uploads/origins/d334915b-87b6-49be-8302-63762b55e338?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=aee445230d423b21e6e9d6049f096f31 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/6bd1f36a/uploads/origins/d334915b-87b6-49be-8302-63762b55e338?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d997fdc6f1f070393b73023fff63263a", "srcset": "https://si.imgix.net/6bd1f36a/uploads/origins/d334915b-87b6-49be-8302-63762b55e338?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d997fdc6f1f070393b73023fff63263a, https://si.imgix.net/6bd1f36a/uploads/origins/d334915b-87b6-49be-8302-63762b55e338?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200