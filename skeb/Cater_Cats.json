src_set": ""}, "body": "はじめまして。\n依頼をお願いしたく連絡差し上げました。\n\nVTuberの「リリィ＝クロフォード」さんのイラストをお願いします。\nhttps://x.com/Lily__Crawford/status/1491382224104861696\n\nシチュエーション等はおまかせいたします。\n\nご検討いただけますと幸いです。", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Cater_Cats/works/9", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1480970, "client_id": 532093, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/01faca05/uploads/origins/73806c73-6448-4404-959e-ff1089b93be6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f33ba41eba3e21a3a5be8ad7c256c165", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/01faca05/uploads/origins/73806c73-6448-4404-959e-ff1089b93be6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3609a305830a6149b322d381d8c12288", "src_set": ""}, "body": "こんにちは、Skebであなたの絵を見て、そのアートスタイルがとても気に入りました！\n\nSNSのPFPのマッチング用に）2キャラの絵をお願いしたいです。\n\nポーズはhttps://safebooru.org/index.php?page=post&s=view&id=5688428。\n\n目は開いていて、キャラクターと背景のレイヤーが分かれているPSDファイルを希望します。\n\nパシ・スターダストというキャラクターは、性別がないので胸が平らです。\n\nありがとうございました！\n\nhttps://drive.google.com/drive/folders/1jwmHw3AFLtS8ZIID5mkngrcUJaFj5SWl?usp=sharing", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Cater_Cats/works/8", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/f21027e4/uploads/origins/2a09b080-ce5d-4dbf-96b2-6da51b84e842?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=f8c1fd99ffad5f48d83902f96946f17d", "src_set": ""}, "private": true, "genre": "art", "tipped": false, "creator_id": 1480970, "client_id": 0, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardc