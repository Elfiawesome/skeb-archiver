e2af7fd38b0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e7933d690c727a724daf2f4fb95ef2c5 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/ac2102df/uploads/origins/c484a98b-d203-4bed-8cd4-9e2af7fd38b0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=20567a2526b4ff56334bd14c1f3840fe", "srcset": "https://si.imgix.net/ac2102df/uploads/origins/c484a98b-d203-4bed-8cd4-9e2af7fd38b0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=20567a2526b4ff56334bd14c1f3840fe, https://si.imgix.net/ac2102df/uploads/origins/c484a98b-d203-4bed-8cd4-9e2af7fd38b0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=f5dd1187a1967dfa2989c3440d8ab4de 2x, https://si.imgix.net/ac2102df/uploads/origins/c484a98b-d203-4bed-8cd4-9e2af7fd38b0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=945c38cfcab4841fec12dda5013628ce 3x"}, "body": "篠 様\n\n初めまして。\n素敵なイラストを拝見しご縁あればと思いご依頼させていただきます。\nアズールレーンのロドニーと艦これの鹿島さんのお二人をお願いいたします（人選の理由は後述）\n\n◎ロドニー\n・服装：公式のローソン服（参考資料）\n・髪型：公式準拠の黒リボン＋ポニテ\n・表情及び構図：二人で仕事中のイメージなのでスマイルor忙しそうにパタパタしている感じ\n\n◎鹿島\n・服装：公式のローソン服\n・髪型：公式準拠\n・表情及び構図：上記（鹿島さんが先輩なイメージ）\n\n両作品のローソンコラボ繋がりの依頼となります。\n細かい部分は描きやすいように変えていただいて大丈夫です。\nお目通り叶えば幸いです。\n\nhttps://encrypted-tbn0.gstatic.com/images?q=tbn:ANd9GcRSuXT3HzfbWYeb61k8Aa1ZUOqZNf_yJbl-zg&usqp=CAU", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@shinoorikoshi/works/8", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 15333, "client_id": 1464908, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/eb24c664/uploads/origins/f3e42321-404a-43ed-8f2f-1fe9d0a1e6a7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fb704b3688f58636f3511458d4385195", "srcset": "https://s