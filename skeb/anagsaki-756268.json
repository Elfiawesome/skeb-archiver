i.imgur.com/O3D2Lt2.png\n\n[シチュエーション]\nベンチに座っている所を描いて頂きたいです。\nまた、可能であれば(タイツを穿いた)脚を強調させて頂きたいです。\n\n[その他希望]\n・椎奈の全身が写るように(見切れ無しで)描写願います。\n・(可能であれば)胸は大きめに描写頂きたいです。\n\n指定が多くお手数おかけしますが、どうか依頼を受けて頂きたく存じます。", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@anagsaki/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1487617, "client_id": 207733, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/c536a7ba/uploads/origins/cb33d543-167d-4746-9744-38689736dde7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0289ff3fb4a5621a7bc458d2d07fcb52", "srcset": "https://si.imgix.net/c536a7ba/uploads/origins/cb33d543-167d-4746-9744-38689736dde7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0289ff3fb4a5621a7bc458d2d07fcb52, https://si.imgix.net/c536a7ba/uploads/origins/cb33d543-167d-4746-9744-38689736dde7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=d71180f5c4f719309758a1880b1fb839 2x, https://si.imgix.net/c536a7ba/uploads/origins/cb33d543-167d-4746-9744-38689736dde7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=63baf4e23ecca17f54bdb3587ec04f0e 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/c536a7ba/uploads/origins/cb33d543-167d-4746-9744-38689736dde7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f18d39282d7b960368ec4b35aa727b11", "srcset": "https://si.imgix.net/c536a7ba/uploads/origins/cb33d543-167d-4746-9744-38689736dde7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f18d39282d7b960368ec4b35aa727b11, https://si.imgix.net/c536a7ba/uploads/origins/cb33d543-167d-4746-9744-38689736dde7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=67a1dcd7123ef7e0a0fcfee9e43