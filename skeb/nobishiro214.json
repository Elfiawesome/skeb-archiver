m=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=5f6ba8a2fbe5f79fdd746faa5773ebfb 3x"}, "body": "こんにちは、あなたの作品が大好きです。\n\n私のオリジナルキャラクター2人が有名な「ジャスティン・ウォン」ポーズを決めているクローズアップを描いていただけませんか？\n\nユキ：\nhttps://drive.google.com/file/d/1hFgflnH7TlI9HnrSwG-XG0uoZSpfK0Ot/view?usp=drivesdk\nルパ：https://drive.google.com/file/d/1Pa_dyh6B5pjjcCS8JntLn6LbyK01wt3_/view?usp=drivesdk\n\n左側にハートサインを作るルパを描いてください。右側には親指を立てるユキを描いてください。\n\nルパは目を閉じ、牙をむき出しにしてニヤリと笑っている姿で描いてください。ユキはポニーテールに眼帯、イライラした表情にしてください。\n\n今回のリクエストでは、ルパの大きな首輪は描かなくて結構です。省略してください。ただしチョーカーは忘れずに！私のストーリーでルパは右胸に傷を負っていますので、必ず描いてください。ユキは小さな襟付きのカジュアルでスタイリッシュなジャケットを着ているように描いてください！\n\n本当にありがとうございます！\n\nhttps://drive.google.com/drive/folders/11ujaJsnJxGg5BP4Ow3R5XabEBvYTJSfg", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@nobishiro214/works/11", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3647272, "client_id": 2518139, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/36a3c138/uploads/origins/188e3d98-8f7c-4d28-9dc4-6fe835779e40?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6d88de9cd378730acad08047250f038d", "srcset": "https://si.imgix.net/36a3c138/uploads/origins/188e3d98-8f7c-4d28-9dc4-6fe835779e40?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6d88de9cd378730acad08047250f038d, https://si.imgix.net/36a3c138/uploads/origins/188e3d98-8f7c-4d28-9dc4-6fe835779e40?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=70253f0d4e5475b1418d2f0e94689b28 2x, https://si.imgix.net/36a3c138/uploads/origins/188e3d98-8f7c-4d28-9dc4-6fe835779e40?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=16031e2c6127e69c080d466c3a793133 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/36a3c138/uploads/origins/188e3d98-8f7c-4d28-9dc4-6fe835779e40?bg=