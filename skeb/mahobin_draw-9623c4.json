ラは普段の服のままでいいです。\n-チョーカー。\n-ピアス。\n-ケツにQOSのタトゥー。\n\nポーズ：\n-お尻を向けて立っている。\n-頭は視聴者の方を向いている。\n-お尻にあるタトゥーに見とれている。\n-彼女の表情は、恥ずかしさと興奮が混在している。\n-黒ぶちメガネをお願いします！\n\n参考画像へのリンクを貼っておきます。\n\n私の要望を聞いてくれてありがとう！\n\nhttps://www.dropbox.com/scl/fo/9n6pi4euulyf1ch8h3zhg/h?dl=0&rlkey=vheitqpuqe4bahec27nokm03h", "nc": 48, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@mahobin_draw/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2046843, "client_id": 1825060, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/3e68bba8/uploads/origins/3d5af231-2d4f-4536-890a-7c25d14c1463?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d037e65094e0e7430bb44d99cbf251fc", "srcset": "https://si.imgix.net/3e68bba8/uploads/origins/3d5af231-2d4f-4536-890a-7c25d14c1463?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d037e65094e0e7430bb44d99cbf251fc, https://si.imgix.net/3e68bba8/uploads/origins/3d5af231-2d4f-4536-890a-7c25d14c1463?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=d57b858f474e0f5896c58b36a3cac211 2x, https://si.imgix.net/3e68bba8/uploads/origins/3d5af231-2d4f-4536-890a-7c25d14c1463?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=6b92e702ceaa833cac415286e2bdc822 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/3e68bba8/uploads/origins/3d5af231-2d4f-4536-890a-7c25d14c1463?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a839c7e03bc17348cce33623ca94983b", "srcset": "https://si.imgix.net/3e68bba8/uploads/origins/3d5af231-2d4f-4536-890a-7c25d14c1463?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a839c7e03bc17348cce33623ca94983b, https://si.imgix.net/3e68bba8/uploads/origins/3d5af231-2d4f-4536-890a-7c25d14c1463?bg=%23fff&auto=format%