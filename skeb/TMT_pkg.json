5e96-4cf9-9083-01f8ecab0754?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=9e2d63e8eb98a36d7087821353cce703", "src_set": ""}, "private": true, "genre": "art", "tipped": false, "creator_id": 850968, "client_id": 444135, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 49, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@TMT_pkg/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 850968, "client_id": 0, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/fc564118/uploads/origins/8b443a8f-2278-497c-be7e-b89f2bca771d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=02d3976876ec1be6ab2f35be3110d699", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/fc564118/uploads/origins/8b443a8f-2278-497c-be7e-b89f2bca771d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b49acbcb41f73671a9ccc2ede16920b9", "src_set": ""}, "body": "3年前はスズナを描いていただいて、ありがとうございました。\n今回は、本日よりポケマスに実装された季節衣装のスズナをお願いいたします。\n\n・ブーツを脱いで、靴下は履いたままの足裏をアップで見せて下さい。3年前に描いていただいたスズナと同じような構図で、蒸れ蒸れで靴下の足裏が汚れている感じでお願いします。\n・バレンタインということで、片足の親指と人差し指の間に、ハート型のチョコを挟んで下さい。\n・股を開いて、縞々パンツを見せて下さい。\n・私の誕生日が近いので、スズナの手にプレゼント箱を持たせて下さい。\n・スズナは公式通り眉毛太めでお願いします。\n\nhttps://twitter.com/poke_times/status/1756588888854761645?t=VDcUMOKmtb28TU1KeIaiDw&s=09", "nc": 49, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@TMT_pkg/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 850968, "client_id": 116502, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/eed5a8b6/uploads/origins/05c97d12-55b4-4618-a762-e001958ff735?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2de4abda1852c16ef0dbbda1ec669bc9", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/eed5a8b6/uploads/origins/05c97d12-55b4-4618-a762-e001958ff735?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2a1f6e97e76591f8aa830b4b598f0e7e", "src_set": ""}, "body": "こんにちは。可愛らしくセンスを感じるポケモン擬人化を拝見し、うちのポケモン擬人化も描いていただけたらと思いリクエストを送りました。\n\nキャラ:ロッカク(ジガルデ擬人化)(下記URL参照)\nシチュエーション:50%とパーフェクトの二形態を同じ画面に入れて欲しい(配置はお任せします)\n50%は可愛らしく、パーフェクトはカッコよさを出して欲しいです。とはいえ元気なキャラでは無いので、あまりはしゃいだポーズにはしないで欲しいです。\n他には特に希望はありませんが、もし良ければ縦長のイラストに仕上げていただけると嬉しいです(厳しいなら横長でも全く問題ありません)\n\n以上の条件でご一考いただけたら幸いです。よろしくお願いします。\n\nhttps://drive.google.com/drive/u/1/folders/1-iuH1OCByrn1QnEKPlML-fsiKrXmNYqQ", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@TMT_pkg/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 850968, "client_id": 2103897, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/a927b4ef/uploads/origins/15fe19ea-bd79-4c24-aef0-5968cdd056ad?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=14b1206ded5da68b0a5d3df6de207090", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/a927b4ef/uploads/origins/15fe19ea-bd79-4c24-aef0-5968cdd056ad?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=241fb2ff982b5d31978fce206501524d", "src_set": ""}, "body": "はじめまして、普段Twitchでゲーム実況をしております碧井梨乃と申します。\n（https://twitter.com/AoiRino_game）\n今後、ゲーム実況以外にYoutuberにてシチュエーションボイスを投稿しようと考えております。\nそこで、多面体先生にサムネイルイラストを描いていただきたくご連絡いたしました。\n\n以前先生が、描かれていた\n「黒のパンストを履いているがパンティーを履いていない女子高生の衣装\n彼女の足の裏をズーム」\nこちらのイラストすごく気に入っておりご依頼させていただければと思いリクエストしました。\n\n\n【キャラクター】\n・女子高生\n・髪の毛は紺色でインナーが水色か青\n・胸はD~Eカップくらいが希望です。\n\n【表情】\n・顔は私、碧井梨乃をイメージできるような表情だと助かります(タレ目です)\n・恥ずかしい表情\n\n【ポーズ】\n足は組んでいて、下着は見えないようにしていただきたいです(Youtube BAN防止の為)\nイメージとして足を組んで相手(イラストを見た人)に匂いを嗅がせているけど恥ずかしい感じでお願いします。\n\nよろしくお願いいたします。", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@TMT_pkg/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 850968, "client_id": 0, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/6f37ea9a/uploads/origins/30262b69-0492-4ca8-aad8-4080d1ab54f9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b8db7e7bec006b49bb28a35a5a77f820", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": true, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/6f37ea9a/uploads/origins/30262b69-0492-4ca8-aad8-4080d1ab54f9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2ea5ed0fead18935356d9dbc58f467ec", "src_set": ""}, "body": "資料画像のキャラを巨乳で描いてもらいたいです。\nあとはお任せします。\nhttps://twitter.com/rpbwz5owkythrls/status/1534969024160727040?s=21&t=J5ehGVdnKeOLrhMsXoMSEQ", "nc": 170, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@TMT_pkg/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 850968, "client_id": 990613, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/c6b294b5/requests/242479_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bcb3a312ec1be5ec4a456d494a34f451", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/c6b294b5/requests/242479_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3ddf4d33f14e10eb7a2b00e88ac9cdc4", "src_set": ""}, "body": "VTuberキャラクター（MOSHIE DRAWS）\n黒のパンスト