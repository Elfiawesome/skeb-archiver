efault_amount": 3000}], "acceptable_only_public": false, "tip_acceptable": true, "yearly_report_client_visible": false, "total_appeals_count": 387, "received_works": [{"path": "/@ruugapp/works/85", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 394905, "client_id": 523983, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/8f20bee3/uploads/origins/86fd5cdb-c6db-467f-b51b-56dfcc801d6b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ef48b951b21d7dd7a041c23ed5a10f22", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/8f20bee3/uploads/origins/86fd5cdb-c6db-467f-b51b-56dfcc801d6b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=26a5bcee30744174a340d4b7481c0e37", "src_set": ""}, "body": "いつもお世話になっております。今回も宜しければお願い致します。\n今回は長女ひめりと次男ヒカルの緑髪似た者同士のペアで母親にバレエレッスンをさせられてるイラストをお願い致します。\nお互いに装飾が無く練習用的な女子物のレオタードと白のバレエタイツを身に着けています。\n顔は母親譲りの可愛い顔をしていますが、ひめりは身長174cmで肉付きは女の子特有の程よい肉付き。レオタードの色は薄ピンク色。\nヒカルは成長して身長は185cmの長身ですが、骨格は男の子です。肉付きは身長に比べて軽いのですが筋肉はそこそこ付いています。レオタードの色は薄水色。母親の希望で女の子としてレッスンを受けている。\n子供達は皆身体が柔らかい。\n構図は2人一緒に（全身で）映り、お互いレッスンバーで立ち、脚を使いレッスンをしている。（ひめりは普通だが、ヒカルは女の子の格好なので恥ずかしがっている）長い髪は結んで踊り易い様にしている。練習用レオタード（筋肉の動きを見やすくする為）なので生地は薄く、レオタードの下に穿いているバレエタイツはレオタード越しに履き口やセンターシーム、ダイヤマチなど浮び上がっている。男女の身体の違いがわかる感じでヒカルはレオタード越しに男性器がぴょこんと立って描いて頂けると嬉しいです。（ママにっこり）\nまた余力があれば設定画集もあると嬉しいです。\nこちらの条件で大丈夫ならばお願い致します。", "nc": 48, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@ruugapp/works/84", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 394905, "client_id": 523983, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/acb6ef51/uploads/origins/5f970395-5e4a-4758-b6ab-c0893336e72c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=61e1f2aebda7299bd483e2d2b6beffe9", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/acb6ef51/uploads/origins/5f970395-5e4a-4758-b6ab-c0893336e72c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3ff80dd0f98bd9ce8df19a16e34a496f", "src_set": ""}, "body": "お久ぶりです！新たに誕生した執事のけいいち\nhttps://skeb.jp/@kinetamu/works/432\nと長女ひめりの絡みでお願いします。\n自分に自身が持てないひめりが執事のけいいち（年齢不詳）に頼んで、\nこっそり隠れてお付き合いセックスをするものをお願いします。\nお互いのタイツを破っての行為での、熱いセ◯クスをお願いします", "nc": 32, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@ruugapp/works/83", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 394905, "client_id": 523983, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/fc35241c/uploads/origins/6fedae72-9349-453a-8a2f-de6ed3485d14?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5280b732e70239592b368836c210d42c", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/fc35241c/uploads/origins/6fedae72-9349-453a-8a2f-de6ed3485d14?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5a5d3554bc05125dc07af0ba1d837238", "src_set": ""}, "body": "いつもお世話になっております。\n今回はお祝いを込めての依頼です。\n以前依頼をした顔出し着ぐるみみたいな内容でお願いします。\n龍の顔出し着ぐるみを着ているのは次男ヒカルです。龍的な着ぐるみを着ており下半身は緑のタイツを穿いています。（下半身丸出しで緑タイツ越しの白のブリーフが透けている）蛇の顔出し着ぐるみを着ているのは母のひめゆりです。蛇的な着ぐるみを着ており純白なタイツを穿いております。（下半身丸出しで白タイツ越しに下着を身に着けてなく、薄っすら陰毛が透けています）ヒカルは恥ずかしながらも、台詞は『今日は創造主様の記念日だよ！』と嬉しそうに騒ぎます。ひめゆりは羞恥を気にせずニッコリな笑顔で、台詞は『皆で私達の主様を祝いましょう！』と言います。\n今回は全身が、映る感じで、可能でしたら、また設定集みたいなのをお願いします。\nとてつもない癖がある内容なのですが、大丈夫でしたらお願いします。。。", "nc": 48, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@ruugapp/works/82", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 394905, "client_id": 523983, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/9995d85c/uploads/origins/6adec7ab-e909-4775-942a-59e1c36bbeda?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=052fa6d2b48e12f5b3259f54b55e23d2", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/9995d85c/uploads/origins/6adec7ab-e909-4775-942a-59e1c36bbeda?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=89dbb376eed985eb48678eb9ebedb03d", "src_set": ""}, "body": "バレンタインデーが近づいて来ましたのでお願いします。次男ヒカルが母親と姉妹達と一緒にチョコを作らされてしまった為に、兄のリクルに渡す事になってしまったシーンをお願いします！？チョコを渡されそうになっているリクルの表情はえぇ…引きつっています。ヒカル（王子様ver）は「あの...兄様、何も言わず受け取ってください…」と女の子の様な仕草ではにかみながら言い、リクルの手にチョコを渡そうとします。（ママはこっそり覗いてニッコリしており、ヒカルは恥ずかしさのあまり半ズボンの下で白タイツ越しにこっそり射精してしまっているズボン内描写をお願い出来ますでしょうか...？）\nいつもと違う兄弟同士での事なのですが、宜しければお願いします！", "nc": 33, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@ruugapp/works/81", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 394905, "client_id": 523983, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/6a908070/uploads/origins/be6d60dd-f97d-4085-a4b1-44dbed563c07?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0e0c2e879836688258eefdb345f2f154", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/6a908070/uploads/origins/be6d60dd-f97d-4085-a4b1-44dbed563c07?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=82b53960a44b70f90aa94030e48208e4", "src_set": ""}, "body": "いつもお世話になっております。リグル＆ひめゆりファミリーでクリスマスか年末年始向けのイラストをお願いできますでしょうか！？シチュ内容は龍我様にお任せ致します。\nこちらの条件で宜しければお願いします！", "nc": 177, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@ruugapp/works/80", "private_thumbnail_image_urls": null, "private": false, "genre": "comic", "tipped": true, "creator_id": 394905, "client_id": 523983, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/30060002/uploads/origins/1484b3ec-3cee-4c10-b71f-74d0289b9adf?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=330a4cd40031ed3006f16f695bd62163", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": true, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/30060002/uploads/origins/1484b3ec-3cee-4c10-b71f-74d0289b9adf?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=53fe486e6e9d70b948891712c675c30a", "src_set": ""}, "body": "いつもお世話になっております。\nハロウィンの時期が近づいて来たので、コスプレシチュエーションでお願いします。\n今回は次男ヒカルと次女ヒカリでお願いします。\n\n1コマ目はピチャピチャと（ヒカリの舌使いの）音を立てて、ヒカルの突起した物が奉仕されています。（ヒカリが手前でヒカルの物を舐めている物がよく見えない描写でお願いします）\n2コマ目はヒカリが突起した物を奉仕しつつ罵倒します。ヒカリ（うっ…くっさぁ…、ねぇ、ちゃんと定期的に洗ってんの？）ヒカル（あっ…洗ってるよ！？）と言いつつ喘いでいます。（2コマ目も見えそうで見えないです。別視点でヒカリの唾液でヒカルの白タイツ越しに包まれている物が唾液でベトベトになっています。）\n3コマ目は椅子に座りながら奉仕を受けてたヒカルが涙目でスカートをたくし上げながら「もう止めようよ…」とヒカリの奉仕を早く止めさせようとしています。\n4コマ目は、実はずっとヒカリに左足を舐め続けられたヒカルは、経験が無い為に敏感になっており、悶絶して、たくし上げたスカートの中身はタイツ越しでもおちんちんが立てに勃起し、タイツ越しで射精してしまいます。（ヒカリはヒカルってチンコだけはリク兄より大きいのに…と思いながらちょっと呆れ気味ですが、悪い子なので奉仕は続けます。）\n衣装はヒカルは不思議の国のアリスのような水色衣装で白タイツ着用しています。今回のヒカルのタイツはダイヤマチやつま先やかかとに補強が入っているタイツでお願いします。突起部分表記は左足です。（念の為）\nヒカリは赤頭巾ちゃんのような衣装を着て白タイツを着用しています。\nまた癖強案件ですが、宜しければお願いします。", "nc": 163, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@ruugapp/works/79", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 394905, "client_id": 3185039, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/a1eca73d/uploads/origins/1120cfcd-3180-4fcd-b065-29e59368eae3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fa4ad67cdf7f71d209b20cecb9e6da88", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/a1eca73d/uploads/origins/1120cfcd-3180-4fcd-b065-29e59368eae3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=8978acc58af093ea577f8960422b6aaf", "src_set": ""}, "body": "はじめまして。アピールありがとうございます。\n\nリクエスト内容\n当方オリジナルキャラのダナス(資料URLの「ダナス=アカティーク」の項をご参照ください)とダナスの反転キャラがいがみ合っているというか、反転キャラに襲われて抵抗しているダナスのような構図のちょっとえっちなイラストをお願いいたします。\n反転攻めの本体受けです。本体の貞操危機一髪くらいの未遂シチュエーションだと嬉しいです。\n\nふたりの関係性\n本体ダナス：反転ダナスに対して存在を認めたくない、直視したくないと思っている。拒否的感情が先に立つ。\n反転ダナス：ダナスの無意識下のインモラルな部分の具現。本体ダナスに一方的に執着的(加虐的)好意を寄せていて、本体ダナスを取り込みたいと思っている。\n反転キャラについては資料等ありませんが、同じ顔だけど色も性格も逆で、反転目のイメージです。(ご参考までにダナスはおっとりめ事なかれ主義的、反転キャラは神経質めで攻撃的な感じです)\n\n利用目的\n個人的な鑑賞およびSNS(ioの当方アカウント)への掲載\n\nやや細かいリクエストで恐縮ですがご検討いただけますと幸いです。\nよろしくお願いいたします。\n\nhttps://misskey.io/@kyoka_h/pages/1717201985095", "nc": 176, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@ruugapp/works/78", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 394905, "client_id": 523983, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/fcd2dddd/uploads/origins/16730755-3cbb-45db-bdcd-5c38a9da2a31?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3a817ae51cbe7bd9a9e8505f6558c736", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/fcd2dddd/uploads/origins/16730755-3cbb-45db-bdcd-5c38a9da2a31?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c16ef9afd5435eb7a04ff3c44bd20b11", "src_set": ""}, "body": "いつも大変お世話になっております！次男ヒカルのオン（表向きのすがた）の時の王子様verと、オフ（裏向きのすがた）の時の女の子verで、切り替えた時のイメージが欲しいので、龍我様の思った通りに新しく描いて貰えないでしょうか？", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@ruugapp/works/77", "private_thumbnail_image_urls": null, "private": false, "genre": "comic", "tipped": true, "creator_id": 394905, "client_id": 523983, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/2099f2a8/uploads/origins/6ad2c36a-8aae-4499-b157-5510a28de321?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d89395359f06d2a88c5dae6e715d2dab", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/2099f2a8/uploads/origins/6ad2c36a-8aae-4499-b157-5510a28de321?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=cccaaf9791d8ea397538c6ee82e9814b", "src_set": ""}, "body": "いつもお世話になっております！今回は好奇心大生な本来の歳の2年が進んだ、長男リクルと次女ヒカリの身体の混じり合い（セ◯クスをお願いします。）ヒカリの作業工房での出来事で、ヒカリは作業台で手をつき受け止めている。（ヒカリは半ズボンショーツ脱いで所々黒タイツは破られている）、リクルはヒカリの腰を右手で掴み、髪を左手で掴んで、乱暴にヒカリのアソコにペニスを突いている（カボチャズボンブリーフは脱ぎ、白タイツはペニス部分が破れている）。ポーズは描き易い用に変えて頂いても構いません。台詞でヒカリは悶えながらも「リク兄ったら18にもなって可愛い容姿して女の子誑かしてヤリチンだよねーｗ）と愉しそうに馬鹿にしています。リクルも台詞で「お前も機械オタクのその手のヤツと愉しくやってんだろｗ」と貶し合いながら、お互いがプライドが高く実は兄妹で意識している物をお願いします。正直とても癖が強い内容だと思いますので、可能でしたらでお願いします…（そしてパパに見つかり怒られ、姉と弟が顔を真っ赤にして意識しあい、ママが何故かご満悦表情があれば嬉しいです…）", "nc": 49, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@ruugapp/works/76", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 394905, "client_id": 1626960, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/29a81cda/uploads/origins/ca7435c6-959b-4dda-8bd4-e3bdf7072013?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=58e03cada376b32a9b659ae4e48892f8", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/29a81cda/uploads/origins/ca7435c6-959b-4dda-8bd4-e3bdf7072013?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e4925af11a1d0d232b18e05f5962576e", "src_set": ""}, "body": "僕のVtuber OCのスケブをやってほしいというリクエストに応えるよ。\n\nhttps://drive.google.com/drive/folders/1-1R7Qz6QpK9tOg5nMSUphTwy4swsFXJ1?usp=sharing", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@ruugapp/works/75", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 394905, "client_id": 523983, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/d5bcc091/uploads/origins/35d62ceb-f1e1-4392-a8b3-a829a2519894?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4fccf97d83b2636b4947ea7819251401", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/d5bcc091/uploads/origins/35d62ceb-f1e1-4392-a8b3-a829a2519894?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=47dfcdad6025af26ebe6111acfe781c4", "src_set": ""}, "body": "いつもお世話になっております姫百合です。実は私は、今ままでひめゆりと名乗ってたのですが、本来のお花のヒメユリのカラーリングがオレンジで、どうも私のカラーリングはヒメサユリらしいんです…（自分も知らなかった）なので…謝罪とお詫びに、お花のヒメサユリの仮装したひめゆりをお願いします…（以前のキグルミを依頼した感じで）ヒメサユリの（お花のコスプレした感じ）でお願いします。花びらは自身の髪でライオンのように立たせた感じで、お顔はオレンジに塗っています。立たせた髪にもいつものリボンは付いています。上着は緑で葉っぱが付いたドレス状な物を着ていますが丈が短く、下半身は丸見えで緑のタイツ越しの白のショーツが薄っすら見えています。曲強いのはいつもの事ですが、恥を偲んでお願いします…", "nc": 48, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@ruugapp/works/74", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 394905, "client_id": 523983, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/e623b32f/uploads/origins/bae3333a-7f75-4dd8-83e2-c7bbe5fbef34?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b3a67a06502fb3a58116a8a8e5112350", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/e623b32f/uploads/origins/bae3333a-7f75-4dd8-83e2-c7bbe5fbef34?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ccd535029dd2f776e3f683f0915667ac", "src_set": ""}, "body": "龍我さんのお誕生日がそろそろだったと思うので、お願いします。今回はひめりとヒカルのペア