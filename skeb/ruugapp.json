.imgix.net/6c2c24cb/uploads/origins/efe67867-d801-4974-9565-e91184fa7eb1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=98a3338cfeb1be33be6efde4280479f7", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/6c2c24cb/uploads/origins/efe67867-d801-4974-9565-e91184fa7eb1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5455aa97df9365b29bb6dc36e7b81b0e", "src_set": ""}, "body": "今回もよろしくお願いします。前回のリクルとヒカルの光景を見た後の女子達の話でお願いします。姉のひめりが弟達の光景を見てしまい、ソワソワしています。それに気づいた妹のひかりが姉に落ち着かせてあげようか…？という展開をお願いします（？）ご依頼内容してはひめりとひかりのアレです！二人とも裸でタイツだけを穿いた姿です。戸惑っているひめりのピンクのタイツを破り、ひかりが電動バイブを、ひめりのアソコに入れて蕩けさせてひかりが楽しんでいる姉妹物をお願いします。ひかり自身も黒タイツを破りアソコにディルドを入れて、気持ちよくなっています。台詞がOKでしたら、ひかりがひめりに『ひめ姉もリク兄みたいにエッチなんだねっ…』と付けていただけると嬉しいです。こちらで大丈夫でしたらよろしくお願いします…", "nc": 49, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@ruugapp/works/57", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 394905, "client_id": 860127, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/8d2b8bb5/uploads/origins/f7f9e8bd-980b-4066-aad1-68004735e9be?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5ffd959d23319b6e31e7f4d4c400e9d6", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/8d2b8bb5/uploads/origins/f7f9e8bd-980b-4066-aad1-68004735e9be?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ed7d83528aeae784639a89aff0c48cfe", "src_set": ""}, "body": "いつもお世話になっております。\nしきろうをお願いしたいです。\n数日悩んだのですが、シチュエーションが思いつかなかったので、お任せいたします。\n可能であればイチャイチャしていると有り難いです。", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@ruugapp/works/56", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 394905, "client_id": 523983, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/71b888ac/uploads/origins/c03cbb37-d9f8-4698-b6bf-9189f47fa5d4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=58e28fa5b8c1f2fd7c98e6340ad58f5e", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/71b888ac/uploads/origins/c03cbb37-d9f8-4698-b6bf-9189f47fa5d4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=374e0d283639e70fa3632f38d5b0ab76", "src_set": ""}, "body": "いつもお世話になっております！この度の依頼はうちの子の子供の、リクル（16歳歳の姿）とヒカル（15歳の姿）です。以前の子供達が少し成長している物をお願いしたいです。内容としては、男の子特有の（タイツ越し？）おちん○ん見せ合いっこです。リクルはカボチャパンツを脱ぎ、腰に両手を当て、自慢げな表情で白タイツ越し下半身を見せ付けているものをお願いします。（ペニスを見せるのは抵抗が無いのでボ○キしてません）弟のヒカルは兄のいきなりの発言におどおどしています。逆らうと虐められるのでヒカルは涙目ながらに両手でワンピースドレスをたくし上げ、内股な白黒のボーダータイツの下半身を曝け出します。（ペニスは恥かしさのあまりボ○キしています）此処から別のお願いです…パンツやショーツの有り無しはお任せします。差分でデフォルトでも構いませんので、この光景を見てしまった姉のひめりが顔を赤くしながらリクルを怒り、妹のひかりは、兄のヒカルを見てダッサーと思って冷めてる表情があったらお願いします。毎度変わったお願いですけど、よろしくお願いします…", "nc": 185, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "similar_creators": [{"id": 23717, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "ぱんだ🐼いっぱい", "screen_name": "anko_panda", "avatar_url": "https://pbs.twimg.com/profile_images/1971184684001525762/E_sKolKd.jpg", "header_url": "https://pbs.twimg.com/profile_banners/78320188/1638095008/1500x500", "appeal_receivable": true, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "skills": [{"genre": "art"}, {"genre": "correction"}], "nc": 33}, {"id": 260622, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "ゆめまねねこ《依頼受付中》", "screen_name": "umemaneneco", "avatar_url": "https://pbs.twimg.com/profile_images/1971554387366719488/vWeLJJzR.jpg", "header_url": "https://pbs.twimg.c