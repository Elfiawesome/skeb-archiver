op&crop=top&w=200&h=200&s=3ffc23d7ee050e5e57f422d3de939c74 2x, https://si.imgix.net/7287cbf0/uploads/origins/250c93ce-fbea-41b4-8a1d-77d8c7f43d5e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=001a81025c1e28100389bc88957ea413 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/7287cbf0/uploads/origins/250c93ce-fbea-41b4-8a1d-77d8c7f43d5e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=68759ec71b39e7fa0ba3cae0545cb290", "srcset": "https://si.imgix.net/7287cbf0/uploads/origins/250c93ce-fbea-41b4-8a1d-77d8c7f43d5e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=68759ec71b39e7fa0ba3cae0545cb290, https://si.imgix.net/7287cbf0/uploads/origins/250c93ce-fbea-41b4-8a1d-77d8c7f43d5e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=0889b4c7f6bc98f40860591f290b187f 2x, https://si.imgix.net/7287cbf0/uploads/origins/250c93ce-fbea-41b4-8a1d-77d8c7f43d5e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=cabe95df5ee3f5359cd1ec8acb873e0c 3x"}, "body": "もちもちお茶さんこんにちは、woollyと申します\nいつも素敵なイラストを楽しく拝見しております！\n\nリクエスト失礼いたします。\nぜひ私のOCを描いていただきたくリクエストを送らせていただきました。\n\nお団子ドリルツイン、オッドアイの女の子です！\n個人的には眼帯ありのデザインが好みなので、眼帯をつけた姿で描いていただけますと嬉しいです！\nその他の部分につきましては、解釈は自由にしていただいて構いませんので、もちもちお茶さんのお好きなように、楽しく描いていただけましたら幸いです。\n\n使用用途につきましては、完全個人鑑賞用となります。商用利用等が発生することはございません。\n\nまた、もし可能でしたら人物や背景などをレイヤー分けしたPSD形式で納品していただけますと、とても嬉しいです。\n\nどうぞよろしくお願いいたします！\n\nhttps://drive.google.com/drive/folders/1VYf10Brb_sk3Xaeb13EAoEWEkGTt00zn", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@m0chi0cha/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3947594, "client_id": 1990799, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/c006b1e4/uploads/orig