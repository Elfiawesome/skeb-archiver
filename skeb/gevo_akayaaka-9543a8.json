すので、そういう関係性が表す様に、賑やかで楽しい雰囲気の一枚をお願い致します。\n・「山登り、真冬、オーロラ、夜明け・夕焼け、地平線、民族風」のモチーフをどちらでもご自由に使って大丈夫です。\n・ポーズや構図は他は何でも構いませんので、お気軽に描いてください！\n\n依頼内容に何か難しい点か問題点があれば、お気になさらずこの依頼をキャンセルしてください。ご検討のほど、何卒よろしくお願いします。\n\nhttps://www.deviantart.com/stash/2pujvqo32as", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 2595064, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "ZO1", "screen_name": "ZO198469474", "avatar_url": "https://pbs.twimg.com/profile_images/1881658986849763328/dSjAwl2k.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1375885350296449025/1737457437/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "art"}], "banned": false, "nc": 49}, {"id": 3445335, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "もんの", "screen_name": "monmonjaano", "avatar_url": "https://pbs.twimg.com/profile_images/1985004266411769857/tNGm1S70.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1985003331413278720/1762097161/1500x500", "appeal_receivable": true, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 120, "skills": [{"genre": "art"}, {"genre": "video"}, {"genre": "correction"}], "banned": false, "nc": 17}, {"id": 3448413, "creator": true, "nsfw_acceptable": false, "acceptable": false, "name": "電波障害さん", "screen_name": "denpawarukunai4", "avatar_url": "https://pbs.twimg.com/profile_images/1860612615376150528/gkBA9boF.jpg", "header_url": null, "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by