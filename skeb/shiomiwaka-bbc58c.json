MjJFRvsJX/?igshid=MTc4MmM1YmI2Ng==)\n\n以上となります。\n\n使用用途はX(旧Twitter)でのプロモーション、SNSでのアイコン(サブアカウントである@wakakintvで使わさせていただきたいです。)Youtubeでのサムネイル　になります。\n\n可能でしたら背景・キャラクターでのレイヤー分けをお願いしたいです。\n\n長文失礼致しました。ご検討のほどよろしくお願いいたします。\n\nhttps://lit.link/shiomiwaka", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@monokichi8/works/381", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 196279, "client_id": 632689, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/480552d0/uploads/origins/cb3fffef-af50-4940-80d5-0199011f8485?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=471ec125d670bbea5a6db289e3e9366b", "srcset": "https://si.imgix.net/480552d0/uploads/origins/cb3fffef-af50-4940-80d5-0199011f8485?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=471ec125d670bbea5a6db289e3e9366b, https://si.imgix.net/480552d0/uploads/origins/cb3fffef-af50-4940-80d5-0199011f8485?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=0e7122d30406ed547f5142c4d724a0c0 2x, https://si.imgix.net/480552d0/uploads/origins/cb3fffef-af50-4940-80d5-0199011f8485?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d74e55eacbb7a53162d71ea13ee7c632 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/480552d0/uploads/origins/cb3fffef-af50-4940-80d5-0199011f8485?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a3be3bcf72a868a566273fbb48540203", "srcset": "https://si.imgix.net/480552d0/uploads/origins/cb3fffef-af50-4940-80d5-0199011f8485?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a3be3bcf72a868a566273fbb48540203, https://si.imgix.net/480552d0/uploads/origins/cb3fffef-af50-4940-80d5-0199011f8485?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&