とがあるのでサムネイルに使用させていただきたいです。\n用途の都合上頭頂部や横髪が見切れていないと助かります。\n\nhttps://drive.google.com/file/d/1K0BGRSK0gGQW2V8uJHdHUpqbz-pq1tqr/view?usp=sharing\nhttps://drive.google.com/file/d/14HJmSPKJVxGKtsdDs7286J5RrH26Ni61/view?usp=sharing\n\nその他：用途の都合としてサイン無し背景のない透過PNGデータを含んだデータ（同様の内容でのPSDデータでも可です）で頂けたら嬉しいです。\n\n＝＝＝＝＝＝＝＝＝＝\n\nご検討をよろしくお願いいたします。\n\nhttps://drive.google.com/file/d/14HJmSPKJVxGKtsdDs7286J5RrH26Ni61/view?usp=sharing", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}], "sent_works": [{"path": "/@yng__091/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1227903, "client_id": 2979493, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/ea421fa7/uploads/origins/62f7e771-936f-4bd3-8265-0d00e95446d7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b49fd3e944936d87c63f0d6c34ec43c9", "srcset": "https://si.imgix.net/ea421fa7/uploads/origins/62f7e771-936f-4bd3-8265-0d00e95446d7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b49fd3e944936d87c63f0d6c34ec43c9, https://si.imgix.net/ea421fa7/uploads/origins/62f7e771-936f-4bd3-8265-0d00e95446d7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=71e9a3f4beb6da29421f24f49e171e3a 2x, https://si.imgix.net/ea421fa7/uploads/origins/62f7e771-936f-4bd3-8265-0d00e95446d7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=0c4f4b45276b4d7098bbfc5933ddf00d 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/ea421fa7/uploads/origins/62f7e771-936f-4bd3-8265-0d00e95446d7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a063fd9440940186be713d84ec2bb30f", "srcset": "https://si.imgix.net/ea421fa7/uploads/origins/62f7e771-936f-4bd3-8265-0d00e95446d7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200