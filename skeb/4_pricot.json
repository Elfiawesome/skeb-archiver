b-53c9-480a-b482-56bc592e8db6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6377183b5c022156b22e5e4462be664c, https://si.imgix.net/8e30bf3e/uploads/origins/290f834b-53c9-480a-b482-56bc592e8db6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e6470fa16a1a9614e1e47f7710e3f22b 2x, https://si.imgix.net/8e30bf3e/uploads/origins/290f834b-53c9-480a-b482-56bc592e8db6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=7da718a278557577dec5ea7714dd4f29 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/8e30bf3e/uploads/origins/290f834b-53c9-480a-b482-56bc592e8db6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=26d6231353a7dd1db019584f170037fc", "srcset": "https://si.imgix.net/8e30bf3e/uploads/origins/290f834b-53c9-480a-b482-56bc592e8db6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=26d6231353a7dd1db019584f170037fc, https://si.imgix.net/8e30bf3e/uploads/origins/290f834b-53c9-480a-b482-56bc592e8db6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=b2d7db63618043d46cb178bb5b09d2d0 2x, https://si.imgix.net/8e30bf3e/uploads/origins/290f834b-53c9-480a-b482-56bc592e8db6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=3dd987598e3079c03da7116b4f64df31 3x"}, "body": "はじめまして。\nVtuber準備中の絲乃ノアと申します。 \nあぷりこっと様の可愛いイラストに心惹かれたので依頼のほうさせていただきます。\n\n\n ●依頼内容\n絲乃ノアのイラスト\n\n・キャラ詳細（特徴）\nつり目 八重歯 ゴスロリ衣装のダウナー\n 耳は少し尖っている ピアス有\n黒ネイル\n右口元と左目元にほくろ（書き手から見て）\n・性格\n超人見知り超インドア\n\n●資料（下記にURL添付済） \n髪型はハーフツインと、猫耳ヘアがありますがどちらでも構いません（服装３面図がないので見えない部分は想像で描いて頂いて大丈夫です）\nまた服装はかなり細かいですので簡易的に描いていただいても構いません。髪飾りは全て描かずにヘアピンのみやなくても大丈夫です。\n（ゴスロリ以外にもレースキャミソールにダボパーカーや、Y2Kファッションが大好きなので、お好きに描いていただいても大丈夫です…！）\n\n ●リクエスト内容\n 気だるげでかわいいイラストをお願いします。（ポージングや表情はあぷりこっと様にお任せします）\n\n照れ顔、困り眉で笑っている顔（見下すような）が特に好きです。\n\nサムネイル等に使用したいため、髪の毛や頭、手（上、左右）は切れていないものが望ましいです。 \n\n背景をもし描いていただける場合は背景と人物のレイヤー分けをしていただけると尚嬉しいです。\n\n   ●使用用途 \n・収益化予定のYouTubeなどの動画,配信サイト及びXなどの各SNSでの利用（サムネイル、ムービー等、歌ってみた、宣伝画像）\n\n Xなどに投稿する際はAI学習禁止のウォーターマークを付けさせていただく場合や文字を上から被せる可能性があります。\nsns等のサムネイルや投稿に使用する場合はトリミング、コラージュさせていただく場合がございます。\n\n 使用範囲に限りがあったりする場合は再送いただけますとありがたいです。\n \n不慣れなskeb依頼ですので何かと不備あるかもしれませんが、ぜひよろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/1d0Rd4vZJSuFzKnYho1jizyXNLgEvj0CO", "nc": 8, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@4_pricot/works/8", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3844087, "client_id": 3324878, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/b7635db8/uploads/origins/5f66f1e5-6f5c-48c9-a9f0-5ea01413c834?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d3a62e055331919a35f85153912e6ccf", "srcset": "https://si.imgix.net/b7635db8/uploads/origins/5f66f1e5-6f5c-48c9-a9f0-5ea01413c834?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d3a62e055331919a35f85153912e6ccf, https://si.imgix.net/b7635db8/uploads/origins/5f66f1e5-6f5c-48c9-a9f0-5ea01413c834?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=63f90575bc6d8dc97abed50d181207ed 2x, https://si.imgix.net/b7635db8/uploads/origins/5f66f1e5-6f5c-48c9-a9f0-5ea01413c834?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=dfb05db8261a305eff0b3e47cefb5379 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/b7635db8/uploads/origins/5f66f1e5-6f5c-48c9-a9f0-5ea01413c834?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e5a211d4c1ced07f71a721a9445f7a3e", "srcset": "https://si.imgix.net/b7635db8/uploads/origins/5f66f1e5-6f5c-48c9-a9f0-5ea01413c834?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e5a211d4c1