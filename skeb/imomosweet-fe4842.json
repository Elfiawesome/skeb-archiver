黒中心で現代的なもの（デザイン上の問題で難しい・他に良いものがある場合は変更どうぞ）\n・印象は「敵なら嬉々としてバール振り回してぶん殴ってきそう」\n\n以上、どうかよろしくお願いいたします。", "nc": 9, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@imomosweet/works/11", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 581849, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/f00d4a40/uploads/origins/7083f414-5a26-4fde-a00b-c5474b8b4bd3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ae36526095b9b7c07172d6af6f87a8e8", "srcset": "https://si.imgix.net/f00d4a40/uploads/origins/7083f414-5a26-4fde-a00b-c5474b8b4bd3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ae36526095b9b7c07172d6af6f87a8e8, https://si.imgix.net/f00d4a40/uploads/origins/7083f414-5a26-4fde-a00b-c5474b8b4bd3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=880e30177c9c449c23b7fb6a9b66b515 2x, https://si.imgix.net/f00d4a40/uploads/origins/7083f414-5a26-4fde-a00b-c5474b8b4bd3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=dddcda51042b647c8e3d46d2d411a32b 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/f00d4a40/uploads/origins/7083f414-5a26-4fde-a00b-c5474b8b4bd3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=24285ec290309d530c9d825643dc7686", "srcset": "https://si.imgix.net/f00d4a40/uploads/origins/7083f414-5a26-4fde-a00b-c5474b8b4bd3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=24285ec290309d530c9d825643dc7686, https://si.imgix.net/f00d4a40/uploads/origins/7083f414-5a26-4fde-a00b-c5474b8b4bd3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=6d9c65ddc063e5b58076eaf18cf51594 2x, https://si.imgix.net/f00d4a40/uploads/origins/7083f414-5a26-4fde-a00b-c5474b8b4bd3?bg=%23fff&auto=format%2Ccompre