。このキャラクターの誕生日の写真が見たい!彼は私の coctrpg キャラクターです\n夕来寒江: 顔の右半分が崩れた清楚な青年。髪の色はピンク、瞳の色は銀色\n職業はエリート警察官、武器は大太刀、性格は敏感コンプレックスで、どこか女性的に見える\nキーワード: 枯れた椿、孤独な蛾\n私はあなたにこのキャラクターの衣装を提供しました、そして、あなたが彼の5番目の衣装（服装リファレンス5）\n具体的な構図、姿勢、シチュエーションはお任せ致します、色を塗るとなお良いです！基本好きなように描いてもらえればなと思います！\nhttps://postimg.cc/gallery/nth4WK6J\n\nhttps://postimg.cc/gallery/nth4WK6J", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@hs_mog/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1237825, "client_id": 2714967, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/86d27579/uploads/origins/ecde3ff7-f8b1-4562-ad2a-c30e3f73afb3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f94c89c3cd41cee288c1f729b963fea6", "srcset": "https://si.imgix.net/86d27579/uploads/origins/ecde3ff7-f8b1-4562-ad2a-c30e3f73afb3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f94c89c3cd41cee288c1f729b963fea6, https://si.imgix.net/86d27579/uploads/origins/ecde3ff7-f8b1-4562-ad2a-c30e3f73afb3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=6efe5ed8f9f99016126c4c241ca058af 2x, https://si.imgix.net/86d27579/uploads/origins/ecde3ff7-f8b1-4562-ad2a-c30e3f73afb3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=02714d5ddab35bd1d9317c34283cd04d 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/86d27579/uploads/origins/ecde3ff7-f8b1-4562-ad2a-c30e3f73afb3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9fd7e5bfdd86d913894115abb917d0d8", "srcset": "https://si.imgix.net/86d27579/uploads/origins/ecde3ff7-f8b1-4562-ad2a-c30e3f73afb3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9fd7e5bfdd86d913894115abb917d0d8, https://si.imgix.net/86d27579/uploads/origins/ecde3ff7-f8b1-4