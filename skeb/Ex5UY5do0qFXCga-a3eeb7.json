gle.com/drive/folders/1YcZa7BLaR-8X_tiYEixs92S8f63Rjjbv\n\nその他資料はお手数ですが私のTwitterのメディア欄などから拾っていただければと思います。\n━━━━━━━━━━━━━━━\nご検討の程よろしくお願いいたします！", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Ex5UY5do0qFXCga/works/9", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3867272, "client_id": 3782624, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/4a66af6b/uploads/origins/3a448cb9-2d1b-4954-90d2-cac97e0c6c9a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f36c5d2166eb5eb5939e73ca48c050cf", "srcset": "https://si.imgix.net/4a66af6b/uploads/origins/3a448cb9-2d1b-4954-90d2-cac97e0c6c9a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f36c5d2166eb5eb5939e73ca48c050cf, https://si.imgix.net/4a66af6b/uploads/origins/3a448cb9-2d1b-4954-90d2-cac97e0c6c9a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=2f7df39f842f7823c83bc2f5ce256bf1 2x, https://si.imgix.net/4a66af6b/uploads/origins/3a448cb9-2d1b-4954-90d2-cac97e0c6c9a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=8fed3abfcc26a158f0a70dc410771fa4 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/4a66af6b/uploads/origins/3a448cb9-2d1b-4954-90d2-cac97e0c6c9a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=046c3f8b1c08ce3ad22bba1c85efb817", "srcset": "https://si.imgix.net/4a66af6b/uploads/origins/3a448cb9-2d1b-4954-90d2-cac97e0c6c9a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=046c3f8b1c08ce3ad22bba1c85efb817, https://si.imgix.net/4a66af6b/uploads/origins/3a448cb9-2d1b-4954-90d2-cac97e0c6c9a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=4e188a502565665bb64d4764cf383cbc 2x, https://si.imgix.net/4a66af6b/uploads/o