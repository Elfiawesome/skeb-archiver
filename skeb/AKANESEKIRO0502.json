ormat%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9ab13b2c4cad70d7917a5fa5208efe42", "src_set": ""}, "body": "初めてのリクエスト失礼します。\n排泄を操る能力を持ったおっさんに絡まれてうんちを漏らすJKをお願いします。\n\n【キャラクター】\nJK・・・金髪でギャルっぽい見た目の制服姿でお願いします。\nおっさん・・・声だけの出演でお願いします。\n\n【シチュエーション】\n3～4ページの構成の漫画形式でお願いします。\n\n①｢やぁ、こんにちは♡｣とおっさんに話しかけられ｢え？なっなんですか…？｣と困惑した顔でこちらを見るJK。\n\n②体内を透過すると腸内にたっぷりうんちが詰まっておりそれを見たおっさんに｢おや？うんちいっぱい溜まってるね♡｣｢出すの手伝ってあげるよ♡｣と言われ｢は？何言って…｣と返すJK。\n※便秘10日目のテロップがほしいです。\n\n③おっさんの｢ほいっ♡｣と合図と共にJKが｢お\"っ？！｣と声と共に爆音のおならを漏らす。\n※おならの勢いでスカートがめくれる。\n\n④そのままの勢いで｢んお\"お\"お\"ぉぉぉ！！！｣と声を上げながら大量のうんちをひり出すJK。\n※うんこ座りでパンツは脱げている。\n※うんちは粒が集まったような感じの便秘うんち\n※お尻の穴が見える構図\n\n⑤お尻を上に突き出した姿で膝を着いて倒れるJK。おっさんが｢いっぱい出たね♡｣と呟く。\n\n⑥ぽっかり開いたお尻の穴の奥に見えるうんちを見て｢おや？まだうんちがいるみたいだね？｣と呟く。\n※お尻の穴ドアップの構図でお願いします。\n\n⑦｢それっ！｣と合図と共に｢んほぉぉぉぉぉ！！！｣と声を上げながら再びうんちをひり出すJK。\n※体勢はそのまま放物線を描くようにうんちをひり出す。\n※最初よりも柔らかめのうんち\n\n⑧ビクビク震えながら気を失うJK。おっさんは｢ふふっご馳走様でした♡｣と言っておしまい。\n\n\n以上です。\nよろしくお願い致します。", "nc": 171, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@AKANESEKIRO0502/works/244", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/1c44bd79/uploads/origins/f9092b88-22c9-43ca-9443-80dc969c8c06?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=31b7d99aa064f41f25a1f4976f6b2522", "src_set": ""}, "private": true, "genre": "art", "tipped": false, "creator_id": 342362, "client_id": 0, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 50, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@AKANESEKIRO0502/works/243", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 342362, "client_id": 0, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/383adef2/uploads/origins/87100f2f-ace0-4128-b9ec-06d6b0388517?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f3bd2ac0eeaf1449be770fb6006c5abf", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/383adef2/uploads/origins/87100f2f-ace0-4128-b9ec-06d6b0388517?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=32580a887fbc5bdd468152c900b47123", "src_set": ""}, "body": "pixivの「冤罪逮捕カンカン踊り」がとても良かったので派生をリクエストさせて頂きます。\n\n現代の現実の刑務所ではカンカン踊りは廃止されて、現代の現実の女子刑務所では全裸四つん這い検査が採用されているのでそれを描いて頂きたいです。\n\n現実は女子刑務所によって千差万別で、裸にして穴を広げて目視だけの所もあるのですが、標準的な内容を以下に書きます。\n\n①全裸になって乳房検査。\n②手形足形に手足を置く事で四つん這いにさせられる。\n③女性器の外陰部を女性刑務官がゴム手袋で触って検査。(女子刑務所は自慰行為禁止なので刺激が結構辛い)\n④膣に太さ直径2cmのガラス棒を挿入して検査。\n⑤膣に女性刑務官がゴム手袋で指を挿入して検査。\n⑥肛門の表面を女性刑務官がゴム手袋で触って検査。\n⑦肛門に太さ直径2cmのガラス棒を挿入して検査。\n⑧肛門に女性刑務官がゴム手袋で指を挿入して検査。\n\n女囚経験者に聞くとこんな感じでした。\n\n工程が多いのでリクエスト労力も勘案してどこまで細かく表現するかはお任せ致しますので、お気に召しましたら採用頂けると嬉しいです。", "nc": 169, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@AKANESEKIRO0502/works/242", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 342362, "client_id": 0, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/dcc079ac/uploads/origins/185974c6-161b-4804-93be-6833421d05f0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4d7551d56463455789c41ff96652cc11", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/dcc079ac/uploads/origins/185974c6-161b-4804-93be-6833421d05f0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a5bc257351850d5bda442dbb072d9dd5", "src_set": ""}, "body": "はじめまして。リクエストをお願いいたします。\n以下のようなオリジナルキャラとシチュエーションで３つのシーンの描写をお願いしたいです。\n\n■キャラ設定\n・黒髪ロングで太眉、制服姿の退魔系女子高生\n・非常に真面目で堅物、清楚、プライドが高い\n・眉毛の太さは「戦隊レッド異世界で冒険者になる（アニメ）」のイドラや、「学園アイドルマスター」の雨夜\n　燕を参考にしてください\n\n■登場する魔物\n・メカっぽい小型の魔物\n・女性の恥ずかしい姿を生配信して尊厳を破壊することを楽しむ\n・女性の服を「DOAのピスタチオ水着」のようなセクシー水着に変え、両手を頭上で拘束し\n　口でブラを咥えさせ、両腋をくすぐり、笑いをこらえる様子を配信する\n\n■シーンの流れ\n① 魔物との対峙\n　・スケベな言葉で挑発する魔物に対し、敵意をあらわにして立ち向かうJK\n　・きりっとした表情で毅然とした態度を見せる\n②即オチ 敗北\n　・すでに拘束されており、水着姿にされ、口でブラを咥えてくすぐられているJK\n　　→魔物が出した小さい手に両腋の下や体を好き放題くすぐられている\n　　→魔物が煽りながら生配信\n　　→JKは顔を真っ赤にし、目に涙をためながら、歯を食いしばって耐える\n　　　無様な笑い声で笑っている\n③ ポロリ\n　・誰も耐えられないとっておきのくすぐり方として、腋の下を親指で揉むようにくすぐる魔物\n　・たまらず大笑いするJK。咥えていたブラが外れポロリ\n\n■描写について\n　・ブラを咥えながらも、口角がしっかり上がっていて「口を開けてないのに笑っている」のが分かる\n　・拘束されながらも、体を大きくよじって逃れようとする、もしくは足を無様にバタつかせている\n　　描写があると嬉しいです\n　・セリフもぜひお願いします。\n\n以上です。資料はくすぐる手のイメージです。\nご一考いただけますと幸いです。\n\nhttps://imgur.com/a/rywx1Jw", "nc": 168, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@AKANESEKIRO0502/works/241", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/3f9c2f03/uploads/origins/e70cfb84-a29c-4b03-bf65-533875905ae8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=1fc978739124945ef931c9d96f5c2118", "src_set": ""}, "private": true, "genre": "art", "tipped": false, "creator_id": 342362, "client_id": 0, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 162, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@AKANESEKIRO0502/works/240", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 342362, "client_id": 678477, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/06d79595/uploads/origins/f62b6161-8638-4b74-9f6e-ebdea0f26f6e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0cc1e0783ded9db3dc77975651703390", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": true, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/06d79595/uploads/origins/f62b6161-8638-4b74-9f6e-ebdea0f26f6e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=1dce6233e4824fc1f99904937d05796f", "src_set": ""}, "body": "いつも素敵な作品拝見させていただいております！漫画風に制作していただけると嬉しいです！\n\n内容\n・にじさんじの周央サンゴと天宮こころが街を歩いているところを、時間停止能力を持った男が発見。二人の顔が好みだった男は早速時間停止をして服を脱がせてみると、そこには二人のロリボディには似つかわしくない奇乳が。期待を裏切られ怒った男は改変能力で二人の頭を粘土のように押しつぶします。時間停止を解除し、その場を立ち去る男。その場には頭を潰され即死し、立ったまま足をガクガクさせ糞尿を撒き散らす二人の姿だけがあった…という内容でお願いします。\n\n奇乳のデザインに関してはお任せしたいのですが、巨乳という訳ではなく小さい垂れ乳全てが乳輪で先端に大きい乳首がついてる、とか乳輪に毛が生えてる、などできる限り最もグロい乳首にして欲しいです。性癖対象外であればエグい垂れ乳とかにしてもらえると嬉しいです。\n他にも、できればイカ腹・ちょいグロマン・頭が潰れた後痙攣に合わせて乳が大きく揺れる描写・できれば男の姿は少なめ・などをお願いしたいのですが、これらはできればで大丈夫です。\n\n作品の完成楽しみにしております！よろしくお願いします！", "nc": 42, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@AKANESEKIRO0502/works/239", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/0a3532e4/uploads/origins/a724a65d-714c-4a9c-9d9c-4275b9451b1e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=1b54d9aba29a8dd1bd3e9d9025df7515", "src_set": ""}, "private": true, "genre": "art", "tipped": false, "creator_id": 342362, "client_id": 3756, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 35, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@AKANESEKIRO0502/works/238", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 342362, "client_id": 401289, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/df22d79f/uploads/origins/3358242d-9789-48ec-93a6-784cddff2afa?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b51125539aae6382d1b6e268ff5d4a02", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": true, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/df22d79f/uploads/origins/3358242d-9789-48ec-93a6-784cddff2afa?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=7da7f7d83f21c2854b260a9d684b3a18", "src_set": ""}, "body": "今回も特殊な内容ですが、お願いできますでしょうか。\n\n◆オリキャラちゃんが1人は衣服を残して石化\n　もう1人は縦平面化\n\n◆内容\nダンジョンから戻って来ない行方不明者を捜索して連れて帰る冒険者ギルドの職員2人が、オリキャラ2人を発見\n・リストを確認後、先輩職員が「新入り今日はついてるな！」って言うと平面化された方のピッタリ張り付いたパンツを脱がしてヤリ始める。\n\n・新入り職員は「何やっているんですか⁈」驚く\n\n・先輩職員は「この階層は、レベルが高い階層だからあまり人が来ないお前も石化した方を好きにして良いぞ蘇生させた後、記憶の処理もするから」と言う\n\n・新入りは、石化した方の首から下に石化解除の薬品をかけて胸を揉むなどヤリます。\n\n最終的には、蘇生させて冒険者ギルドに連れ帰りますが、オリキャラちゃん2人はモンスターに敗北後の記憶がないので、お詫びと感謝して帰ります。\n\n◆回収担当のギルド職員について\n先輩30代前半くらいののイメージ、\n新入り20代前半くらいのイメージ、\n\n◆オリキャラちゃんについて\n1人目のイメージ\nhttps://skeb.jp/@tk8d32/works/73\n\n魔法使い\n\nhttps://x.com/bluerhombusmk2/status/1908334234156359943?s=46&t=1RuaUN2aN3RzBuJvEV3jBA\n\n前に茶巾絞りや皮モノを依頼した子です。\nhttps://skeb.jp/@AKANESEKIRO0502/works/106\n\nhttps://skeb.jp/@AKANESEKIRO0502/works/169\n\n◆オリキャラちゃん2 盗賊\nhttps://x.com/bluerhombusmk2/status/1933542166674165892?s=46&t=1RuaUN2aN3RzBuJvEV3jBA\n\nhttps://x.com/bluerhombusmk2/status/1908740779394425187?s=46&t=1RuaUN2aN3RzBuJvEV3jBA\n\n◆平面化イメージ\n\nhttps://www.pixiv.net/artworks/128754875\n\nどちらが石化でも平面化するかは、お任せします。\n細かい内容はお任せいたします。\n\n長々とすみません。", "nc": 58, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@AKANESEKIRO0502/works/237", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/99bbd9c8/uploads/origins/ed768904-5213-492a-a375-f7f42eb95ecd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=9e8dab991266c107b42eca34bf0d1d10", "src_set": ""}, "private": true, "genre": "art", "tipped": false, "creator_id": 342362, "client_id": 0, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 51, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@AKANESEKIRO0502/works/236", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/6237fc4c/uploads/origins/665174fb-5cdd-49cf-b0a2-d4dd84414ecf?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=9d8243dfaeb9572724e861a7f6ea9b8f", "src_set": ""}, "private": true, "genre": "art", "tipped": true, "creator_id": 342362, "client_id": 0, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 163, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@AKANESEKIRO0502/works/235", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 342362, "client_id": 0, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/55ba8126/uploads/origins/14560675-8d41-4d38-a628-73f6e02652a3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=af78b5a1685a141c0a0daa0cabbcefd6", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": true, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/55ba8126/uploads/origins/14560675-8d41-4d38-a628-73f6e02652a3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=befd0954748b699b993bd08afbaf125e", "src_set": ""}, "body": "明るくて可愛い学校のアイドル的な存在の女子高校生が学校で排便する様子(友達バレ)を漫画形式でお願いします。\n①朝家で排便し損ね、我慢していたが、食後に昼休みに便意が強まり意を決してトイレに行こうとするが、友達が私も行くと一緒に来てしまう。\n②空いてた友達の隣の和式で、パンティーをおろして排尿する。排便はなんとか我慢しようとするが、お尻を突き出し和式でする体勢になった事で、便意がさらに強まり、おならをしてしまう。\n③これ以上我慢なんて絶対無理と腹を決め、羞恥心たっぷりな表情でバナナ状の健康的なうんちを何本もする\n④友達に『食べた後だもんね！大丈夫？スッキリした？どのくらい出た？どれくらい我慢してたの？普段学校でもしてるの？』と矢継ぎ早に聞かれいきみ声や音でバレており、赤面しながらカミングアウトする。\nアングルは正面からで金隠し等透過させ、排泄の様子と便器内と表情が見える様に。\n友達の容姿はおまかせですが、こちらも明るくモテるタイプで！可能なら友達の排便シーンもお願いします。(時間帯とトイレの場所はおまかせで)", "nc": 59, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@AKANESEKIRO0502/works/234", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 342362, "client_id": 0, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/748cf3b6/uploads/origins/fbe1c71f-5625-4c43-880f-92c3218681a9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2e5db064f315f48dd6333acc94111ede", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": true, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/748cf3b6/uploads/origins/fbe1c71f-5625-4c43-880f-92c3218681a9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=58980b705e75902edfd902a10461873e", "src_set": ""}, "body": "先日は野薔薇ちゃんやマキマさんの最高な漫画ありがとうございました！\nトロトロマ○コ調理教室も最高でした！\nバイオハザードRE4のエイダが潜入に失敗し教団に囚われ、邪教の信徒に洗脳される漫画をお願いしたいです。よろしくお願いいたします。\n\n①猿轡を噛まされ後ろ手に拘束され床に転がされながらもサドラーたちを睨み付けるエイダ\n➁肉の壁に手足を飲み込まれ土の字に拘束されているエイダ。顔下半分を覆うマスクから流し込まれるガスと怪しい液体を虚ろな目で無意識に吸い込み嚥下する。頭に刺さった無数のチューブが光る度にくぐもった声を上げている。\n➂マスクは取り除かれ、流し込まれた液体でパンパンに膨れた腹の中心、ヘソに奪取する筈だったアンバーを押し付けられる。ズブズブと結晶がエイダの腹に侵入していく。\n「の゛お゛お゛っ゛　ぎん゛も゛ぢぃ゛いっ゛」\n「復唱しなさい、エイダ・ウォン、お前の中の教団以外の下らない物は一切消えた」\n涙、鼻水、涎を垂らしがくんがくんと体を揺らしサドラーの言葉に反応する。\n「おっ　お゛お゛っ゛　きっ　きえ゛たっ！！」「サドラー様こそが正しい」「ただしぃ゛っ゛！！お゛ぉ゛っ゛」「教団に絶対の忠誠を誓え」「お゛ぁ゛あ゛～゛～゛っ゛　ちゅっ　ちゅうせいっ゛！！ちかう゛！！」\n「教団の邪魔者を殺せ」「あ゛っ゛こっ゛　ころ゛すぅ゛っ゛！！私がぁ゛っ　ほお゛ぉ゛っ゛　じゃっ　邪魔者ぉ゛っ゛！！ころすぅ゛っ゛！！！！」\n④触手と肉の絨毯に気を付けの姿勢で取り込まれたエイダ。肉の絨毯が盛り上がり、ボディラインがくっきりと浮かんでいる。妖しくドクンドクン──と脈動しながら肉繭の中で邪教の尖兵として造り替えられていく。\n➄サドラーの前でハイレグセクシー下着で膝立ちのエイダ。エイダの額に指を滑らすと額に縦筋が入り、瞳が開くように孔がくぱりと開く。思考する性器に改造されたエイダの脳内にサドラーが肉棒を挿し込むと、ぐるんと目を上向かせがくんがくんと体を震わせる。「お゛っ゛お゛っ゛　お゛お゛っ゛」\nサドラーが脳内に精を放つと体をピーーン！と強張らせた後、かくん、と脱力し白目を剥くエイダ\n「ぉ゛～～～………────」\n⑥「サドラー様の仰せのままに……♡」\nI字開脚でサドラーのモノを肛門で咥え込みながら、サドラーの舌をひょっとこアヘ顔で吸うエイダ。額の孔はぴったり閉じて教団の紋章が刻印されている。", "nc": 171, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@AKANESEKIRO0502/works/233", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/d04bab2a/uploads/origins/0af0863f-8f61-44e2-9cfc-097ad5497264?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=d26c48b276168a04f16292ec6e1b4f86", "src_set": ""}, "private": true, "genre": "art", "tipped": false, "creator_id": 342362, "client_id": 0, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 179, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@AKANESEKIRO0502/works/232", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 342362, "client_id": 1551891, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/20697363/uploads/origins/505617d2-9e23-43ca-b3f1-5f3f15798e5d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8f5764e848a48df7356e36c02b9e423e", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": true, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/20697363/uploads/origins/505617d2-9e23-43ca-b3f1-5f3f15798e5d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9223a1002ca0516cb9ba5d523694d208", "src_set": ""}, "body": "こんにちは、\n催眠術とグロテスクを同じテーマで依頼する人はあまり見たことがないので、そのテーマで3ページのマンガを依頼します。\nA. キャラクターの概要\n- 究極の催眠術を持つ魔王(1)：その力は、その目を直視した者をマインドコントロールすることである；\n- ブロードソードを持つ女騎士（2）：王女の護衛。王女より少し年上で、王女の安否を気遣う表情をしているはずだ；\n- 癒しの力を持つ小さな王女： モンスターがたくさんいるダンジョンでは、この女の子は天真爛漫で経験不足に見えるはずだが、それでも態度は大きい。\nB. コミックページの詳細\n- ページ目：\nダンジョンの最終階層で（2）と（3）が （1）と対決するとき、2人とも自分たちがダンジョン最強のコンビであることをまだにやにやしている。しかし、彼らはすでに（1）の目を直視し、催眠術にかかっていることを知らない。彼らの瞳孔は開き、そして表情は落ち、目はうつろになり、手足はぐったりする。\n- 2ページ目： \n(1）は次に（2）に命じて （3）の 首を切り落とし、次に自分の首を切り落とす。首は2つとも地面に落ちるが、(1)の 暗黒魔法が首の切り口から体に渦巻き、その場に留まらせるため、体はまだその場に留まっている。そして、(1)は 地面から首を取り出し、首をネックレスに変える（首は縮んで土台となり、頭の上に紐でくくりつけられる）。https://www.pixiv.net/en/artworks/128046943\n- 3ページ： \n(2)も(3) も(1)の魔法でダラハンになった。(2)は(3)の頭から作った首飾りをつけ、(3)は(1)がつけた(2)の頭から作った首飾りをつけている。そして二人とも武器を手にまっすぐ立つように命じられ、彼らは今、専ら①の 玉座の間を守るダンジョンの下級ミニオンになっている。最後のコマでは、（1）が玉座に座り、2人の手下が玉座の両側に立って守っている。\n\n補足：\n-名前と衣装はお好みで考えてください（衣装はやはりダンジョン衣装のビキニバージョンでお願いします）。最後は裸になり、ネックレスだけを身につける。\n- 二人とも首を切り落とされたときでさえ、無表情だった。ネックレスが闇の魔法で光り、舌を思い切り出していたら最高だ。でも、それがこの漫画の雰囲気に合うかどうかは、あなた次第。", "nc": 186, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@AKANESEKIRO0502/works/231", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 342362, "client_id": 0, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/95116885/uploads/origins/c5ec3d29-8619-4958-b1c6-d4ac4349ff12?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4253c23192f0716908863845515785f2", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": true, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/95116885/uploads/origins/c5ec3d29-8619-4958-b1c6-d4ac4349ff12?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=1f1ecd7f9ba0c478be7496da1450c954", "src_set": ""}, "body": "リクエストさせて頂きます。\nキャラ:名探偵コナンの灰原哀。\nシチュエーション:\n①小学6年生の女子達のイジメ現場をスマホで撮影し、「先生に怒られたくなければさっさとこんな低俗なことやめなさい、6年生にもなってみっともないわよ」と呆れ顔で説教する灰原。\n\n②しかし自分より大きな女子達に捕まり、服を脱がされ大の字に寝かされてしまう。\n手足を掴まれている状態で、全身をくすぐられてしまう。あまりのくすぐったさに顔を歪め爆笑しながら許しを乞うも、全く聞き入れられない。\n\n③不細工な顔で失神してう⚪︎こを漏らすまで容赦なくくすぐられた灰原。さらにその無様な姿を写真で撮られ、「次はこの生意気なガキンチョをオモチャにしよう！何させる？。」「肛門に栓してう⚪︎ち限界まで我慢させるなんてどう？」「それ良いね！面白そう笑」と残酷な会話を繰り広げる女子達。\n\n要望:くすぐられてる時に灰原に「あひゃひゃ！\nくすぐりやめで、う⚪︎ち漏れぢゃう！」と必死で情けないセリフもお願いします。\nくすぐられている構図・表情のイメージはこんな感じです。: https://www.pixiv.net/artworks/70582022\n\n\n先生の描きやすいようにセリフ等改変して頂いて構いません、よろしくお願いします。", "nc": 43, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@AKANESEKIRO0502/works/230", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 342362, "client_id": 2851557, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/c5d68278/uploads/origins/cefac5c3-d3af-4278-a419-63ae4989bcff?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4a160de16c9b9e077f6d943d24442f3b", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": true, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/c5d68278/uploads/origins/cefac5c3-d3af-4278-a419-63ae4989bcff?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=798a1b73137ec0ab33d3a7b3db9211cc", "src_set": ""}, "body": "初めまして！他サイトで作品拝見しまして、少しハードな内容ですがこの方なら！と思い依頼させていただきます。\n【概要】人間を虐殺している女悪魔の元に男が現れ、女悪魔は男に襲い掛かるが、返り討ちに合いレイプの後殺害される　というストーリーをお願いします。\n\n・女悪魔は美女の姿していて、褐色の肌に長身爆乳、明るい髪色ストレートのショートヘアで、常に薄ら笑いを浮かべながら人間を虐殺する凶悪な魔物です。顔つきや表情は「チェンソーマン」の「マキマ」のイメージです。服装はレザーのベルトを身体に巻き付けたような露出度の高い恰好でお願いします（細かい装飾などは不要です）その他の身体的特徴として、悪魔の尻尾とヤギのような角を持っています。\n\n・男は筋肉質でめちゃくちゃ強いこと以外はお任せします（描写自体も最小限でOKです）\n\n以下が詳細なシチュエーションです。\n１．路地裏のような場所で、女悪魔が血の滴る女性の生首を持ちながら、首を失った女性の遺体を踏みつけて笑っています。\n２．そこに男が現れると、女悪魔は生首を捨てて男に飛び掛かります。\n３．男は女悪魔の攻撃を易々とかわし、腹パンで反撃します。女悪魔の身体はくの字に折れ曲がり、「おぼぉッ！？」といった無様な声をあげながら嘔吐し、崩れ落ちます。\n４．怯えきった女悪魔は這いずりながら逃げ出そうとしますが、捕らえられて寝バックで男に犯されます。\n５．歯を食いしばって絶頂する女悪魔。そのまま男はキャメルクラッチをかけ、女悪魔の身体を真っ二つにへし折り、上半身と下半身に両断します。\n６．上半身と下半身がそれぞれ痙攣する女悪魔の遺体の描写で終了です。\n（大小問わずスカの描写は無しでお願いします）\n\n長くなってしまいましたが、どうぞご検討のほどよろしくお願いします。", "nc": 58, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@AKANESEKIRO0502/works/229", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/a8da6302/uploads/origins/193fe564-612b-4694-9e60-8c0dd247d3d7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=9658a03fd7f48a5802f1d40e5da97f8a", "src_set": ""}, "private": true, "genre": "art", "tipped": true, "creator_id": 342362, "client_id": 0, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 162, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@AKANESEKIRO0502/works/228", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 342362, "client_id": 0, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/bab35659/uploads/origins/2fd0d270-4040-4d44-b276-00e9b13f62e5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=310d4cd3b724c78b98d079d6ae51f2ce", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": true, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/bab35659/uploads/origins/2fd0d270-4040-4d44-b276-00e9b13f62e5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=617415ec051c2121013442f27c281c4b", "src_set": ""}, "body": "クール系長身女教師の排便をお願いします。\n巫女のトイレシーンと同じような構成で４ページお願いします。\np.1　スーツ姿で排便\n①授業中、生徒に問題を教えている最中、軽く便意を催し「んっ…」と微かに切ない声が出る\n②休み時間洋式トイレで切なげな表情で排便、ペーパーを巻き取りながら。音は「ブッ！ブリブリブリッ！ブリュッ」と汚めの音。足はがばっと広げ、下着は両ひざ下あたり。下着には縮れた陰毛が１本。長めの一本糞。便器内には硬めの１本目。隅には出し終わったウンチのコマ（明日２本と汚れのついたペーパー）\n③お尻を突き出し気味に肛門をぐりぐり拭く\n\np.2　デート前の排便\n①年下彼氏とデート中に排便。洋式トイレで足をがばっと広げガチガチの便秘うんちを汚い声でひりだす＋勢い強く放尿。表情は巫女のブス顔のように顔を真っ赤にして排便。隅に便器内のウンチが出るアングル\n「ゥン…チ…硬っ…ん゛い゛ッッ！」排便とばれたくないという心の中\n②「すまない、お手洗いが混んでて…」と排便と悟られないよう優しい微笑で出てくる。＋出し終わった便器内（黒めのゴーヤ状の塊と拭いた汚れのついたペーパー。念入りに肛門を拭いたため、汚れのべたっとついたものと、かすれた汚れがついたもの）\n\np.3　いちゃらぶシーン\n①切なげな表情で彼氏とのぶちゅキス（レースの入った白系の下着姿）\n②唇を引き延ばしたエグイひょっとこフェラ＋脱いだ下着のアップ（クロッチ部には縮れた陰毛１本と、べったりついた粘り気のある愛液＋薄い尿シミ）\n③アナルセックスで獣のようなオホ声「おごッ！お゛ッんお゛っ」「クソ穴キクッ！！」「も゛うウンコッ…ウンゴでぢゃうがらぁッッ！」\n④舌を垂らして仰け反り絶頂。肛門からは精液とともに「ブッ！」と放屁\n　小声で「好き…オ゛ッ、大、好き…だ」\n③と④では腋の露出（濃いジョリ腋）\np.4 アナルセックス後\n　①腸内に中出しされたため急に便意を催す。「ッッ、ちょっとトイレっ！」\n　②洋式トイレでブリブリと一本糞をひりだす。\n　③ドアを開けられ恥じらう「ちょっと！ゥ…ウンチしてるんだッ！」\n　④シャワーで恥じらい＋少し怒った顔「恥ずかしかったんだぞ…今夜はずっと抱きしめてくれ…」とイチャイチャ感\n\n陰毛や尻毛は縮れた濃いめ。腋も濃いジョリ腋\nクールさと甘々な感じ、下品さのギャップが出ると嬉しいです。\n\n以下参考\n\nhttps://sites.google.com/d/1QpLZmOJZxXdRcCMEtKHMJEokXLRRHdJb/p/1gWiR717jboiYo9UymFje8OhUM-lgaFHJ/edit", "nc": 42, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@AKANESEKIRO0502/works/227", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/9128c339/uploads/origins/02dd483e-3ae8-4880-a84e-2d768eadc122?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=fca33604ac1531deb1a3eeca3a7750e7", "src_set": ""}, "private": true, "genre": "art", "tipped": false, "creator_id": 342362, "client_id": 0, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 34, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@AKANESEKIRO0502/works/226", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/0eefa612/uploads/origins/581fd134-701f-46af-a98c-d6642878e3c7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=04a78693bc9c451437a7a905a699f18f", "src_set": ""}, "private": true, "genre": "art", "tipped": false, "creator_id": 342362, "client_id": 0, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 50, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@AKANESEKIRO0502/works/225", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 342362, "client_id": 3171107, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/11117d42/uploads/origins/35521c10-4fce-447f-b095-80805bf72957?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a9552083675baeb018aaf56f932ebe9f", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": true, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/11117d42/uploads/origins/35521c10-4fce-447f-b095-80805bf72957?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d2cc8bf28c44e01e13354a6a0f8cc178", "src_set": ""}, "body": "監禁された女の子がおむつ替えのついでに犯される漫画をモノクロでお願いします。\n\n具体的には\n・女の子は先生の以下作品の子。\n　https://www.pixiv.net/artworks/100860398\n　仰向けで目隠しとボールギャグ（または猿轡）をつけられ手足も縛られている。足はM字開脚の状態で縛られている。\n　まだ監禁されて日が浅く涙を流している。\n　服装は上記作品と同じでさらに紙オムツを履かされている。\n　紙オムツは以下の動画に出てくるもので、大きさやギャザーなどリアルに近づけていただけると嬉しいです。（紙オムツ好きなのでよろしくお願いします）\n　https://youtu.be/4fFuhxbbF1E?t=19\n・見たいシーンは以下２つです。\n　・脱糞したオムツを監禁犯に開けられたシーン。\n　　オムツの中を見たいのでアングルは真上などでお願いします。\n　・開けたオムツをお尻に敷いたまま犯されて中出しされるシーン。\n　　女の子は犯されながら追加で脱糞している。\n\nご多忙の中恐縮ですがよろしくお願いします。", "nc": 187, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@AKANESEKIRO0502/works/224", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 342362, "client_id": 1607603, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/a7862f3a/uploads/origins/e2c08f57-45c7-4b31-9e31-d4d69a57dcf9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=76a892f9ae798e8736b341ac8fcdfaae", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": true, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/a7862f3a/uploads/origins/e2c08f57-45c7-4b31-9e31-d4d69a57dcf9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=85c7508fe149d5087251819451356cd1", "src_set": ""}, "body": "こんにちは。ご無沙汰しております。\nいつもお世話になっております。\nこの度はFANBOX開設おめでとうございます！\n心ながらお祝いとご依頼をさせていただきます。\n\n以前ご依頼した作品\nhttps://www.pixiv.net/artworks/109564175\nの後日談となります。\n\n【キャラクター】\n前回のリーフとスターチスとリーフに加えて朝霧神楽の3人になります。\n【流れ】 \n前回の2人を十分煮込んで薬を作ったのち、薬を瓶詰めして撤収しようとした場面から。\n【1ページ目】\n①満足げな竿役のモンスターは出涸らしを処分しようと拾い上げて袋に詰めようとしていた。(頭は最後に)\n②その最中に見回りをしていた神楽が現場を目撃。\n2人の無惨な姿を目の当たりにしてあっけに取られながらも震える足を押さえて問い詰める。\n③竿役は見つかっちゃったとおどけながらあざわらい笑みを浮かべて神楽の時間停止し、服を奪い取る。\n【2ページ目】\n④新しい獲物を捕まえた竿役は調理を始め、神楽の首と手足を切り落とし、そのまま先ほどまで鍋を置いていた焚き火で丸焼きにする。\n勿体無いからとついでのようにリーフとスターチスの四肢と胴体も串に刺して炙る。\n⑥その後、腹も満たされた竿役は食べた骨と可食部が少ない頭を置いてその場を去っていく。\n(最後のカットがこの骨と頭部のみで、ぶっかけられたり口内を汚されている)\n\n以上の内容となります。\nページ配分は目安程度にお考えいただいて大丈夫です。\nよろしくお願いいたします！\n\nhttps://ihenkakiketsudan.memo.wiki/d/", "nc": 171, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@AKANESEKIRO0502/works/223", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/b18ab39e/uploads/origins/d81a4a7e-5387-409e-884e-e507263a9952?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=50c8b39c932da15811a301bd22ad0f6f", "src_set": ""}, "private": true, "genre": "art", "tipped": true, "creator_id": 342362, "client_id": 0, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 35, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@AKANESEKIRO0502/works/222", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/a1c13713/uploads/origins/f287d290-b88e-4311-b391-fe3bc03dc946?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=604c0a80e8b1974ec25d6348f968aa8f", "src_set": ""}, "private": true, "genre": "art", "tipped": true, "creator_id": 342362, "client_id": 0, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 163, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@AKANESEKIRO0502/works/221", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/ac806c6c/uploads/origins/a80b414c-00bf-4d0e-91a8-41dcf41f6a09?bg=