、見下ろすような感じで手（または前足）を伸ばし襲いかかってきてるような場面を描いて欲しいです。\nアングル的には↓のイラストが近いです。\nこんな感じでズイッと顔と手を近づけて来てる感じが好みです\nhttps://x.com/i/status/1712150152562299217\n\nシュイの表情はTFさせられて恥ずかしそうに顔を真っ赤にしながら涙を浮かべつつ怒ってるっぽい感じでお願いします。\n（ぐるぐる目にして気持ちの整理がついてなくて「早く戻して〜！」って感じで結果的に襲おうとしてる感じになってても好きなので、余裕があったら差分をいただけると嬉しいです。）\n\n金額に余裕があれば手前側にシュイの彼氏のガイヤを置いて体格差が分かるようにしてくれると嬉しいです。\nガイヤの姿は獣人、人間はお任せします。\n\nよろしくお願いします。\n\nhttps://drive.google.com/drive/folders/1daafD-ePuTOfJrwaORDkL2QLU-v5ugkA", "nc": 49, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [{"path": "/@merunmohu/works/323", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 358876, "client_id": 69636, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/951fdfbd/uploads/origins/42a792b0-966d-41e4-94c4-e5da509d9394?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e12c5983475731419e2285e8db30e9e6", "srcset": "https://si.imgix.net/951fdfbd/uploads/origins/42a792b0-966d-41e4-94c4-e5da509d9394?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e12c5983475731419e2285e8db30e9e6, https://si.imgix.net/951fdfbd/uploads/origins/42a792b0-966d-41e4-94c4-e5da509d9394?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=3159c9c6de6c5fafc082fbe4c257f1de 2x, https://si.imgix.net/951fdfbd/uploads/origins/42a792b0-966d-41e4-94c4-e5da509d9394?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=3a45ecca44ce798da0f5e3856b421e73 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/951fdfbd/uploads/origins/42a792b0-966d-41e4-94c4-e5da509d9394?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=630bbd1e4ccab8f9a3c60e1f5b4ce1e1", "srcset": "https://si.imgix.net/951fdfbd/uploads/origins/42a792b0-966d-41e4-94c4-e5da509d9394?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=