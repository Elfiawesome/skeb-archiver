とめたものです。\n※参考画像は理解を助けるために用意したもので、詳細に確認する必要はありません。解釈や表現方法は自由にお任せします。\n\nもしこの依頼にご興味をお持ちでしたら、自由に解釈・調整していただければと思います。\nまた、このような内容のお引き受けが難しい場合や、今回ご縁がなかったとしても全く問題ありませんので、そのままスルーしていただいて構いません。\nお手間ににならない範囲で、少しでもご検討いただけたら嬉しいです。\nよろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/1wtE_zvCmJ8FYWomS8CHO-J9WxdOZOicD?usp=sharing", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@harugakita85/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2284824, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/116c4e88/uploads/origins/dc7fa1fb-ede9-46df-af9c-94a714b07120?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=29352b008455c9069333691b32249e23", "srcset": "https://si.imgix.net/116c4e88/uploads/origins/dc7fa1fb-ede9-46df-af9c-94a714b07120?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=29352b008455c9069333691b32249e23, https://si.imgix.net/116c4e88/uploads/origins/dc7fa1fb-ede9-46df-af9c-94a714b07120?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=2f24454fc106c3e513ef357da71fb2b4 2x, https://si.imgix.net/116c4e88/uploads/origins/dc7fa1fb-ede9-46df-af9c-94a714b07120?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=63cb5d753305027a6e3300baea1473c2 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/116c4e88/uploads/origins/dc7fa1fb-ede9-46df-af9c-94a714b07120?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=812e09dfba7dc7374c3c6292c26317a1", "srcset": "https://si.imgix.net/116c4e88/uploads/origins/dc7fa1fb-ede9-46df-af9c-94a714b07120?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=812e09dfba7dc7374c3c6292c26317a1, https://si.imgix.net/116c4e88/uploads/origins/dc7fa1fb-ede9-46df-af9c-94a714b07120?bg=%23fff&au