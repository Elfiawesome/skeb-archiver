fc7e-a8dc-421d-9a50-9d2c740cab6d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f410c26760943e76d4951c00f5918a1b", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/254c1167/uploads/origins/0aa8fc7e-a8dc-421d-9a50-9d2c740cab6d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=85c5ab5b3d269e8928213dce8248823a", "src_set": ""}, "body": "ねこのて(る) さん！はじめまして🍀\nすてきなイラスト拝見しました🎨✨\nぜひ！イラストの依頼をさせていただきたいです！\n\n◆テーマとしては、\n季節は『秋』紅葉舞う中で\nほっこりと温かい飲み物を飲んでる雰囲気で\n\n◆人物の特徴としては、\n髪色に『茜色』の風味を混ぜていただければ、\nもしでしたら頭に『ハンチング帽』を被せてほしいです。\n性別や服装は中性的な雰囲気であればありがたいです。\n表情やポーズはおまかせします。\n\n◆イラストの使用用途としては、\nSNSのアイコンや配信等をもし行う際の\nサムネなどで使用させていただきたいと思います。\n\n◆人物と背景を分けたPSDファイル、\nもしくは人物のみの透過データ(頭部や髪型が見切れていない状態)も\nよければ分けて納品していただけたら大変ありがたいです。\n\nご検討いただけたらと思います。\nよろしくお願いいたします🍁\n\nhttps://drive.google.com/drive/folders/1sZCDHvSK1kH92Su2weD_zuKCla9h7Wum?usp=sharing", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@nekonote_014/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3392275, "client_id": 0, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/341f18f7/uploads/origins/5ed6cf17-37bc-4c85-8528-0f2c2a147d37?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=182cb1dd08f03035700b21159f71c661", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/341f18f7/uploads/origins/5ed6cf17-37bc-4c85-8528-0f2c2a147d37?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=841fefda7b2cfbcae941d0317a465079", "src_set": ""}, "body": "前作の農家少女のイラストが気に入りましたので\nまた、リクエストさせてください。\n\nオリジナルキャラの全身立ち絵で、昭和初期の農家の20代半ばの\n黒髪女性のイラストをリクエストしたいです。\n顔だち、表情、体型、髪型、ポーズ等は全てお任せします。\n\n恰好\n野良着に、もんぺ、地下足袋履きで、手には農作業用の紺の手甲をつけています。\n野良着の色は紺、模様は適当にいれてほしいです。\nもんぺはへその辺りで紐を結ぶ袴式、長さはくるぶしまでで、色は紺、模様は絣柄、\n脇は袴の様にスリットを開けてほしいです。\n地下足袋はくるぶしの上までの長さ、色は黒にしてほしいです。\nもんぺイメージ\nhttps://www.dropbox.com/scl/fi/h4p33213dntcur7za8ds1/yukim.jpg?rlkey=6r2m26o0r2ypvk1c9m3cyf3wt&st=glypa70x&dl=0\n地下足袋イメージ\nhttps://www.dropbox.com/scl/fi/0dlq0el8hrwkh15ocjvm7/tb.png?rlkey=id9szwe2vs7xqr6f46enheggn&st=gqb9dkf7&dl=0\n\n以上ご検討の程宜しくお願い致します。\n\nhttps://www.dropbox.com/scl/fi/2vyuaw0il2i8gmijijb2w/ka.png?rlkey=6hkn15i1simyraxzz4i268wwu&st=5wpfsckt&dl=0", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@nekonote_014/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3392275, "client_id": 2242285, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/8aa08673/uploads/origins/0740e23e-4a62-49e6-9918-5473439c0a1f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=67f3df1ffb071b0a6eebd2eef8b8ade0", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/8aa08673/uploads/origins/0740e23e-4a62-49e6-9918-5473439c0a1f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=60174579735b6ed2bf137a7587531dba", "src_set": ""}, "body": "こんにちは、はじめまして！\n\n私はあなたの作品が大好きです！\n\n私のキャラクター「せっか」を描いていただけませんか？\n彼女は穏やかで可愛らしいドラゴンの女の子で、人と一緒に過ごすのが大好きです。\n自然や花、動物も大好きです。\n\n服装は、https://sta.sh/21sj8zn7p01f。\nまた、リファレンスにない服でも、好きな服装で描くことができます。\nポーズや表情については、自由にやってください！\n\nリクエストに応えてくれてありがとう。\n\nhttps://sta.sh/21sj8zn7p01f.", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@nekonote_014/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3392275, "client_id": 0, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/be6d1d93/uploads/origins/e576e7bb-b2d5-40b1-992f-a3b7bb997d17?bg=%23fff&auto=format%2Ccompress&fm=webp&fi