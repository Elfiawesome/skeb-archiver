&txt=PRIVATE&s=1be4e43c97e4347913b848cec2e7f57c 2x, https://si.imgix.net/1a5a7d6a/uploads/origins/98c502ba-7d7e-4873-9c7b-49f632d2edf8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=46d857e187aa82f3f2df6bc06cee1b2f 3x"}, "private": true, "genre": "art", "tipped": false, "creator_id": 3352299, "client_id": 4004025, "nc": 129}, {"path": "/@mac_4229/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3352299, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/c640d857/uploads/origins/6c0cbad2-cd05-4f92-a8fb-f9127f9d6a29?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=714090e113cef842082cf0321085ee80", "srcset": "https://si.imgix.net/c640d857/uploads/origins/6c0cbad2-cd05-4f92-a8fb-f9127f9d6a29?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=714090e113cef842082cf0321085ee80, https://si.imgix.net/c640d857/uploads/origins/6c0cbad2-cd05-4f92-a8fb-f9127f9d6a29?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c002befdfee4bfa9e1ad7cecdf99774d 2x, https://si.imgix.net/c640d857/uploads/origins/6c0cbad2-cd05-4f92-a8fb-f9127f9d6a29?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a9047de4f0cd090b610690dc7ba5b84e 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/c640d857/uploads/origins/6c0cbad2-cd05-4f92-a8fb-f9127f9d6a29?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c845392cb79b69be046ac30fdd1a55eb", "srcset": "https://si.imgix.net/c640d857/uploads/origins/6c0cbad2-cd05-4f92-a8fb-f9127f9d6a29?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c845392cb79b69be046ac30fdd1a55eb, https://si.imgix.net/c640d857/uploads/origins/6c0cbad2-cd05-4f92-a8fb-f9127f9d6a29?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=83ac076bfc4dbf2c9d616660ce3b21cd 2x, https://si.imgix.net/c640d857/uploads/origins/6c0cbad2-cd05-4f92-a8fb-f9127f9d6a29?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=f6ec372de5f27d666c36411e04e1719a 3x"}, "body": "こんばんは。\n匿名でリクエストをさせていただきます。\n\n弦巻マキと宮舞モカの百合絵をお願いします。\n\nシチュエーションは、\n・肩を寄せ合ってぺたん座りか横座りで座っていて、寄せ合った肩同士の手を重ね頬を染めた顔も寄せ合っているキス寸前（キス顔になる前）の姿\n・「2人ともタチになりたいリバでこの後のキスで主導権握った方がその直後のイチャイチャでタチになる」といった雰囲気\n・2人のほぼ真正面からの視点で全身絵で（描写上難しいようであれば2人のへそ辺りまででも可）\n\nマキ\n・赤色のビキニ（スタンダードな形状のタイプ）姿\n・水着の上側は背中のホックを外していて、空いている方の手で自分の水着の肩紐を肩からずらしている\n・重ねている方の手ではこっそりモカのタイサイドビキニの腰部分（片側）の紐をほどいて背中側の方の紐を持っている（上半身までの絵でしたら省略可）\n\nモカ\n・水色のタイサイドビキニ（上側を留める部分がカップ部分同士をつなぐ紐でそこを結んで留める以外はスタンダードな形状のタイプ）姿\n・空いている方の手で自分の水着の胸部分のリボン結びをほどきかけている\n・水着の下側はマキに紐をほどかれている側がややめくれている（上半身までの絵でしたら省略可）\n\n\n以上でお願いいたします。", "nc": 161, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@mac_4229/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3352299, "client_id": 3857761, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/500f9549/uploads/origins/27687139-92b7-4f5e-8555-195221d4e845?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c105af947c3757ef7b139428afedb2fd", "srcset": "https://si.imgix.net/500f9549/uploads/origins/27687139-92b7-4f5e-8555-195221d4e845?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c105af947c3757ef7b139428afedb2fd, https://si.imgix.net/500f9549/uploads/origins/27687139-92b7-4f5e-8555-195221d4e845?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f0398f0177068eed6ac9baafc51502bc 2x, https://si.imgix.net/500f9549/uploads/origins/27687139-92b7-4f5e-8555-195221d4e845?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=9fe9171bf03ca6c0489f8e33ac4e0398 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/500f9549/uploads/origins/27687139-92b7-4f5e-8555-195221d4e845?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=556308333268638533b042e44a453e32", "srcset": "https://si.imgix.net/500f9549/uploads/origins/27687139-92b7-4f5e-8555-195221d4e845?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=556308333268638533b042e44a453e32, https://si.imgix.net/500f9549/uploads/origins/27687139-92b7-4f5e-8555-195221d4e845?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=1c49f77180d6615ae389a9c5c5a83bb8 2x, https://si.imgix.net/500f9549/uploads/origins/27687139-92b7-4f5e-8555-195221d4e845?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=ee7e4094d1947973e5ab6769a57141c1 3x"}, "body": "宮舞モカのイラストをお願いします。\nロングヘアーアレンジ（普段より髪が長い状態）で、\n左手で髪を耳にかける仕草のワンシーンを描いていただきたいです。\n\n雰囲気はやや大人っぽく、落ち着いた表情だと嬉しいです。服装は可能であれば制服（公式）が良いです。\n\nモカちゃんの魅力が伝わる一枚を楽しみにしています！\n\n・アイコンに使用する予定です。他の使用はありません。", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@mac_4229/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3352299, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/2e7d66a9/uploads/origins/b469bbd9-848a-48bb-aa63-82bb239287e0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e48f13a75724876bf4e9a5e78329ea1d", "srcset": "https://si.imgix.net/2e7d66a9/uploads/origins/b469bbd9-848a-48bb-aa63-82bb239287e0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e48f13a75724876bf4e9a5e78329ea1d, https://si.imgix.net/2e7d66a9/uploads/origins/b469bbd9-848a-48bb-aa63-82bb239287e0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ebd34318ff74f10fecb470554aca7cb8 2x, https://si.imgix.net/2e7d66a9/uploads/origins/b469bbd9-848a-48bb-aa63-82bb239287e0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d3ccb3472b7362952c65114af6b851b9 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/2e7d66a9/uploads/origins/b469bbd9-848a-48bb-aa63-82bb239287e0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=92e4c1212027ac2305a8b5db80b9ffff", "srcset": "https://si.imgix.net/2e7d66a9/uploads/origins/b469bbd9-848a-48bb-aa63-82bb239287e0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=92e4c1212027ac2305a8b5db80b9ffff, https://si.imgix.net/2e7d66a9/uploads/origins/b469bbd9-848a-48bb-aa63-82bb239287e0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=7876bd0cbc0083d8286b3398b58a1832 2x, https://si.imgix.net/2e7d66a9/uploads/origins/b469bbd9-848a-48bb-aa63-82bb239287e0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=28c1342b5210fee3a917d61fd8de92d8 3x"}, "body": "東方Project（東方紺珠伝）の稀神サグメのパンチラ絵を描いてください。\n\n・シチュエーションは風パンチラもしくはスカートの切れ込みが深くて普通に見えてしまっている（両方の混合でもOK）。\n・ちょっと格好つけてるけど見えちゃってる感じの雰囲気と構図。\n・表情はサグメ様らしく澄ました雰囲気で、見えている事に気づいていないか気にしていない表情。\n・パンツは白系でフロントリボン付き、クロッチの縫い目の線が描かれている（スジと紐パンはNG）。\n\n以上、ご検討の程よろしくお願いいたします。", "nc": 177, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@mac_4229/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3352299, "client_id": 768267, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/56a93942/uploads/origins/162ca490-56f5-4a26-8493-dc17aaa9c63d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=509e96aae01af6d9a067a5cb8f245ce9", "srcset": "https://si.imgix.net/56a93942/uploads/origins/162ca490-56f5-4a26-8493-dc17aaa9c63d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=509e96aae01af6d9a067a5cb8f245ce9, https://si.imgix.net/56a93942/uploads/origins/162ca490-56f5-4a26-8493-dc17aaa9c63d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=922da58bb3876cb374a0de808ffad76d 2x, https://si.imgix.net/56a93942/uploads/origins/162ca490-56f5-4a26-8493-dc17aaa9c63d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ac472038aa09aa55352fc7ebd74d1a0e 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/56a93942/uploads/origins/162ca490-56f5-4a26-8493-dc17aaa9c63d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=8727ba7ccfc6a339e9a72b2b67c803c7", "srcset": "https://si.imgix.net/56a93942/uploads/origins/162ca490-56f5-4a26-8493-dc17aaa9c63d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=8727ba7ccfc6a339e9a72b2b67c803c7, https://si.imgix.net/56a93942/uploads/origins/162ca490-56f5-4a26-8493-dc17aaa9c63d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=fff94048bc5d9c8bf15fbcea005745b8 2x, https://si.imgix.net/56a93942/uploads/origins/162ca490-56f5-4a26-8493-dc17aaa9c63d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=e4c7accb7cfca31d67bf1acc89444a67 3x"}, "body": "紡乃世詞音ちゃんが超常現象で突然10歳から16歳に急成長してしまう、というシチュエーションのカラーイラストを描いていただきたいです。\n参考URL[1]のように、変身前・変身途中・変身後の姿を並べて描く形式でお願いします。顔つきがだんだん大人っぽくなっていく様子・身長や手足がすらりと長く綺麗になっていく様子・華奢だった身体がムチムチに変わっていく様子・サイズに余裕のあった服がパツパツになっていく様子などを一望して楽しみたいです！\n背景は無くても構いません。\n\n【ビジュアル】\n・変身前\n設定画通りの服装・体格・顔つき・髪型の「紡乃世詞音(蕾)」\n身長135.5cm\nカバンは不要\n純真無垢で明るい性格\n全身がムズムズするのを感じ、慌てている\n\n・変身途中\n13歳くらいまで成長した詞音ちゃんをイメージ\n顔つきの大人っぽさ・身長の高さ・腕や指の長さ・胸や尻や太もものムチムチ度合い・服のパツパツ度合い等は変身前と変身後の中間くらい\n髪型は「蕾」のもののまま\n身長や腕・指が伸びる様子、胸や尻や太ももが膨らむ様子などを「すらあっ」「ぐんっ」「むくむく」などのような擬音で表現\n顔を赤らめた表情で嬌声を漏らしている（急な体の成長により、痛みのような快感のような不思議な感覚を味わっている）\n\n・変身後\n身長（157.7cm）や体格・顔つきは16歳の詞音ちゃんのもの（まっくさんが普段描かれている通り）で、服のデザインとサイズは「紡乃世詞音(蕾)」のもののまま\n髪型は「蕾」のもののまま\n精神年齢や意識・性格は10歳のまま\n参考URL[2]のように、服のサイズが合わずパツパツになっている（大きく膨らんだ胸でシャツが埋め尽くされている、身長が伸びたことでお腹が露出している、大きく膨らんだ尻と太ももがズボンにギチギチに詰まっている）\n疲れた表情で息を切らしながら、頭の周りにハテナマークを浮かべている（自分の身に何が起こったのか理解しきれず困惑している）\n精神年齢は10歳のままなので、お腹丸出しの恰好を恥ずかしがったりはしていない\n\n【参考URL】\n[1]　https://pixiv.net/i/51374325\n[2]　https://pixiv.net/i/99351991", "nc": 32, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 71367, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "薪春", "screen_name": "catvillage168", "avatar_url": "https://pbs.twimg.com/profile_images/2074574350796439552/DWjYdBTc.jpg", "header_url": "https://pbs.twimg.com/profile_banners/613549829/1753790578/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 100, "skills": [{"genre": "art"}, {"genre": "correction"}], "banned": false, "nc": 32}, {"id": 822931, "creator": true, "nsfw_acceptable": false, "acceptable": false, "name": "二兎きょう@21日で5周年", "screen_name": "iaiaia28", "avatar_url": "https://pbs.twimg.com/profile_images/2112562754481721344/gu4qEs8w.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1516092733/1792858538/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 120, "skills": [{"genre": "art"}, {"genre": "correction"}], "banned": false, "nc": 0}, {"id": 1984528, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "ヒト試", "screen_name": "hitoishi_14n2i5", "avatar_url": "https://proxy.misskeyusercontent.jp/avatar.webp?url=https%3A%2F%2Fmedia.misskeyusercontent.jp%2Fio%2F5