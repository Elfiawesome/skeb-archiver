のドミネーターみたいに展開している状態にしてください(できれば展開前の差分も欲しいですが、難しければ無くても大丈夫です)。\n必殺技を放つ前のようなイメージで、銃の周りに何かを吸うようなエフェクトを付けてください。\nhttps://skeb.jp/@LCbutter/works/7\nhttps://skeb.jp/@19_raven_91/works/2\nのような感じです。\n\n背景\n・赤黒い光が渦巻く、禍々しくもかっこいいもの\n・青空等、正義の変身ヒロインらしいヒロイックなもの\n\n差分(可能であれば)\n①バイザー着脱\n②バイザー下の目透過・未透過\n③表情(苦戦・無表情・格好いいニヤリなど)\n④装備や衣装のダメージ有無\n⑤銃のエフェクト\n赤黒い光が渦巻くものと白い光のもの\n⑥必殺技発射シーン\n\nその他\n3840×2160程度の横長キャンバスのレイヤー未統合PSDでお願いします。\nその他はお任せします。\n描きにくいところ、難しい点は省略・変更していただいて構いません。\nよろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/1-V9kbfUNUEsXgROyVLS1IBTcqtnYdHbH?usp=sharing", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 654746, "creator": true, "nsfw_acceptable": true, "acceptable": false, "name": "朱音ゆうひ", "screen_name": "practica_nnu2", "avatar_url": "https://pbs.twimg.com/profile_images/1978800052777967617/2EsqxFBD.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1643797666915323910/1765799611/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 7, "complete_expiration_days": 30, "skills": [{"genre": "art"}, {"genre": "correction"}], "nc": 33}, {"id": 659710, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "千石千鵆🐶", "screen_name": "sengokuchidori", "avatar_url": "https://pbs.twimg.com/profile_images/1782651654426542080/F12flTJP.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1667411346/1758220267/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 14, "complete_expiration_days": 45, "skills": [{"genre": "art"}], "nc": 33}, {"id": 1255567, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "aiju@【SDイラストお仕事募集中】", "screen_name": "NcKak9RJ