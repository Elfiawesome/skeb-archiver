c459cb30?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=516fb7649abc684e29e7c8f3c5b7d4d6", "srcset": "https://si.imgix.net/b527c27c/uploads/origins/f13da6ef-da8e-4495-96ca-9b17c459cb30?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=516fb7649abc684e29e7c8f3c5b7d4d6, https://si.imgix.net/b527c27c/uploads/origins/f13da6ef-da8e-4495-96ca-9b17c459cb30?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=e8540f65424060993e0b22a927e2f478 2x, https://si.imgix.net/b527c27c/uploads/origins/f13da6ef-da8e-4495-96ca-9b17c459cb30?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=9fa2a28dae894dcbd1c90c6dd966f282 3x"}, "body": "はじめまして！\n\nこのキャラクターたちを描いていただけませんか？毛皮の姿で描いてください。ヒーローと悪役の動きがあります。\n\nアロイス\nディンゴ\n180センチ。金髪のオス。とても痩せている。\n性格はおしゃべりでいたずら好き。普段の表情は満面の笑み。\n超常現象探偵事務所のメンバー。\nゲイブが悪役であるにもかかわらず、アロイスは彼に夢中になっている。\n\nゲイブ\nシロクマ\n186センチ。灰色の髪のオス。筋肉質。\n普段の表情は笑顔。不遜でカジュアルな性格だが、内心は非常に危険。\nエイリアン・テクノロジーの研究開発会社を率いる悪役軍人。\n\n服装や体型の参考として、人間バージョンのみを掲載した。\n\nゲイブがアロイスにエイリアンの研究所を冷静に案内しているイラストを描いてください。アロイスは好奇心旺盛だが、神経質で警戒しているようにも見える。\n研究室には謎めいたテクノロジーや試験管の中のエイリアンなどがいてもかまいません。\n\nいずれにせよ、僕のリクエストを読んでくれて本当にありがとう！\n\nhttps://drive.google.com/drive/folders/1Zovag9J6SWh0jPvzh-SwAMHRSSJlVgUV?usp=sharing", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@sudadegi/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1966607, "client_id": 17413, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/f4fb71cf/uploads/origins/526a5d56-aabe-4a75-899b-989923b208e2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6a7986bbe3a4f19338ee784b21a6b1f6", "srcset": "https://si.imgix.net/f4fb71cf/uploads/origins/526a5d56-aabe-4a75-899b-989923b208e2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6a7986bbe3a4f19338ee7