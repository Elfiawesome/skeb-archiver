かネックレスを首にお願いしたいです。\n・くまのぬいぐるみを持ちたいのですが、可能でしょうか。さめない様が2023/12/11にツイートされている、ねこちゃんと女の子のイラストのような感じでも問題ございません。\n\n上記、沢山になってしまいましたがお願い出来ますでしょうか。\n\nお忙しいかと思いますのでご無理はなさらず\n3月中旬くらいまでにいただけると嬉しいです。\n\n何卒よろしくお願い致します。\n\nhttps://drive.google.com/drive/folders/1OYhNzSHxXpWOkpG1Ud1gUfOvqY_26bJc", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}], "sent_works": [], "similar_creators": [{"id": 115681, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "ねねな", "screen_name": "nenena217", "avatar_url": "https://pbs.twimg.com/profile_images/1095193287403626497/8JyPMVez.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1612476535/1558325462/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 120, "skills": [{"genre": "art"}], "banned": false, "nc": 129}, {"id": 1241555, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "mgsr_2nd", "screen_name": "MagicOshiri", "avatar_url": "https://pbs.twimg.com/profile_images/1963580043357294593/soIRnjhC.png", "header_url": "https://pbs.twimg.com/profile_banners/1952562981549813761/1758172894/1500x500", "appeal_receivable": true, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 120, "skills": [{"genre": "art"}], "banned": false, "nc": 16}, {"id": 1366068, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "お、", "screen_name": "ooo_0926", "avatar_url": "https://pbs.twimg.com/profile_images/1976456505617678337/k4n0GrRE.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1393369213792751620/1768864254/1500x500", "appeal_receivable": true, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank":