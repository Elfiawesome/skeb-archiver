変更・簡略化していただいて大丈夫です。全体の構図や演出もお任せいたします。\n\n内容不備や金額が不足している場合は、アピールをお送りください。デザインメモ、没ラフや下描きなどがあればPSDに残したままにしていただけると嬉しいです。\n\n長いお願いをお読みいただき、またご検討いただきありがとうございます！\n\nhttps://drive.google.com/drive/folders/1_7wTl6FJONAFtQdBVHH4NZrUZuTNs3xx?usp=sharing", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 1306948, "creator": true, "nsfw_acceptable": false, "acceptable": false, "name": "昏", "screen_name": "ujika3", "avatar_url": "https://pbs.twimg.com/profile_images/1891423504970797059/_F3KUEpF.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1359385359109378048/1747664914/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 90, "skills": [{"genre": "art"}], "banned": false, "nc": 16}, {"id": 1813966, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "猋ポチ︎︎☁/ｴﾁﾞ", "screen_name": "eziezi_", "avatar_url": "https://pbs.twimg.com/profile_images/2054510231972151296/vEVgn6kF.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1934484693984112640/1777567837/1500x500", "appeal_receivable": true, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "art"}, {"genre": "video"}], "banned": false, "nc": 144}, {"id": 2017661, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "セリザワ4%(2)", "screen_name": "0u0_mgmgtime", "avatar_url": "https://pbs.twimg.com/profile_images/1647393638614437888/RPsZXMzy.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1521119675358228482/1781015054/1500x500", "appeal_receivable": true, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": nu