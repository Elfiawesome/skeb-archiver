ormat%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=582759d01c2a7dbe734835690dfb8a87 2x, https://si.imgix.net/c44d3b59/uploads/origins/8d827413-cb45-49ce-b9d7-989087e0f37a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=e54050409ece2ea80f2c5710c5189833 3x"}, "body": "はじめまして\nゲーム実況者のLiaqN【りあん】と申します！\n\n綺平様のとても素敵でかわいらしい作品を拝見しまして、是非私のキャラクターをを描いて頂けないかと思いリクエストさせて頂きました。\n\n【使用用途】\n・YoutubeやTwitter等のアイコンやサムネに使用させていただく予定です。\n\n【依頼内容】\nポーズ・背景は綺平様におまかせいたします。\n服装や装飾などはアレンジしていただいても問題ございません。\n頭や髪の毛が切れない。また、人物や背景やサイン等レイヤー分けをしていただけると大変嬉しいです。\n\nどうぞ宜しくお願いいたします。\n\nhttps://drive.google.com/drive/folders/1k9_CN8WFd6hCE0bk3LCV04sN4-hUvOzL?usp=sharing\n\nhttps://drive.google.com/drive/folders/1k9_CN8WFd6hCE0bk3LCV04sN4-hUvOzL?usp=sharing", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@ayahira_kogi/works/15", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2447756, "client_id": 2830926, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/4c215699/uploads/origins/5e53bb0a-b57c-4dc0-9654-6863fd0a92df?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a58bf5a61ca7cdc7bee63f93ac6ce7a6", "srcset": "https://si.imgix.net/4c215699/uploads/origins/5e53bb0a-b57c-4dc0-9654-6863fd0a92df?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a58bf5a61ca7cdc7bee63f93ac6ce7a6, https://si.imgix.net/4c215699/uploads/origins/5e53bb0a-b57c-4dc0-9654-6863fd0a92df?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b315de0aafb1a13438e5aed87d5ff27c 2x, https://si.imgix.net/4c215699/uploads/origins/5e53bb0a-b57c-4dc0-9654-6863fd0a92df?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=faf9d78a7920f413220a6ac90f05de91 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/4c215699/uploads/origins/5e53bb0a-b57c-4dc0-9654-6863fd0a92df?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=83c04867865a1efe9d1e4b1f270ef688", "srcset": "https://si.imgix.net/4c215699/uploads/origins/5e53bb0a-b57c-4dc0-9654-6863fd0a92df?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=83c04867865a1efe9d1e4b1f270ef688, https://si.imgix.net/4c215699/uploads/origins/5e53bb0a-b57c-4dc0-9654-6863fd0a92df?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=5f40fd5c91ee4f8dce05069e3a4ecbe0 2x, https://si.imgix.net/4c215699/uploads/origins/5e53bb0a-b57c-4dc0-9654-6863fd0a92df?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=2e00c6b9d4fcebfaaf191a34a2a445b8 3x"}, "body": "綺平 様\n\nはじめまして。\nVTuber準備中の猫電（めうでん）と申します。\n\n以前から綺平様の大空スバルさんのイラストが大好きで、\n今回VTuber活動のため、ご依頼のリクエストをお送りさせて頂きました。\n\n【使用用途】\n◾︎SNS・ブログの\nアイコン・ヘッダー・投稿画像\n◾︎Youtubeのサムネイル\n\n【イラスト】\n人物は以下、資料のご確認お願いいたします\n\nポーズ・背景は綺平様におまかせいたします\n大空スバルさんのように元気・可愛さを出していただけると嬉しいです\n\n▼資料\nhttps://drive.google.com/drive/folders/1WcOm7oxiY7p-38VRAHuz8D9FHk2Ucc_A\n\n【サイズ】\n縦A4サイズ\n\n【備考】\n\n~データについて～\n・サムネイル使用したいため、透過人物と背景等をレイヤーで分けたPSDデータで頂けると幸いです\n\n～イラストについて~\n・人物の横に浮いている三角は生き物のように動きます（Live2D動画があります）\nできれば描いてくださるとありがたいです\n\n上記、お手隙の際にご検討よろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/1WcOm7oxiY7p-38VRAHuz8D9FHk2Ucc_A", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@ayahira_kogi/works/14", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2447756, "client_id": 1008404, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/fc197939/uploads/origins/ab56b716-c4c5-45ca-a4c0-cc7307780f3e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bd3e6ee459fb8d8a4d379cdc4a064aa8", "srcset": "https://si.imgix.net/fc197939/uploads/origins/ab56b716-c4c5-4