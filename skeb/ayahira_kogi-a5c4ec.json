容をまとめさせていただきましたのでご検討のほどよろしくお願いいたします。\n（参考資料）\nhttps://drive.google.com/file/d/1kopGhC3xXt50WWuSjAvWtn2uADNPHbyi/view?usp=sharing\n\n\n【使用用途】\n〇SNSなどのvtuber活動におけるプロモーション\n〇SNSのアイコン、ヘッダー\n〇YouTubeのサムネイル使用\n（商用利用は致しません）\n\n【イラストについて】\n〇参考資料にあるメイド服で腰あたりまでのイラスト、構図やポーズなどはおまかせさせていただきたいです。\n〇サムネイルへの使用を考えておりまして、左右上の髪の毛をイラスト内に収めていただきたいと思っております。\n\n【服装や髪型】\n三面図にあるキャラクターデザインで描いていただきたいです\n\n【サイズ】\n3840px～ほど\n\n【その他】\n・できれば宛名・人物・背景等がレイヤー分け出来るPSDデータで頂けると有難いです。\n\nお手すきの際に是非ご検討いただけますと幸いです。\n何卒よろしくお願い致します。\n\nhttps://drive.google.com/file/d/1kopGhC3xXt50WWuSjAvWtn2uADNPHbyi/view?usp=sharing", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@ayahira_kogi/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2447756, "client_id": 1670345, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/94069d2a/uploads/origins/0ea66902-02c8-4b51-9bb5-7863a67848c0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c3d8dba6203bd2a5f0fe207d7737d1b3", "srcset": "https://si.imgix.net/94069d2a/uploads/origins/0ea66902-02c8-4b51-9bb5-7863a67848c0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c3d8dba6203bd2a5f0fe207d7737d1b3, https://si.imgix.net/94069d2a/uploads/origins/0ea66902-02c8-4b51-9bb5-7863a67848c0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=8f06018c5f128880f7f3b9fe5072418d 2x, https://si.imgix.net/94069d2a/uploads/origins/0ea66902-02c8-4b51-9bb5-7863a67848c0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=00841c3a61d9b79d7f3bad9d595c03f6 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/94069d2a/uploads/origins/0ea66902-02c8-4b51-9bb5-7863a67848c0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=1b7c1d37d1899d0b534174864c72a22f", "srcset": "https://si.i