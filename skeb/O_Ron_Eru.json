たが、手足がなく、ゆっくりと這うしかなかった。\n\n猫はスライムを見て、「どこに行きたいの？」と言い、魔法と印でスライムを従順にし、猫の使い魔にした。\n猫の指示に従い、スライムは持ち運びしやすい小さな道具の形に変わった（オナホール）。\n\n最後に猫は使用後、満足し、オナホールを片付けた\n\nReference:\nhttps://drive.google.com/drive/folders/1hl4DCMHWM7o-lf53aTNsyKjrrt09oKnp", "nc": 32, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@O_Ron_Eru/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3728846, "client_id": 333632, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/522e1047/uploads/origins/f2733378-4cfa-4866-9b7b-781ca03d50aa?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=92ac636e1612914c1f52f2269332d432", "srcset": "https://si.imgix.net/522e1047/uploads/origins/f2733378-4cfa-4866-9b7b-781ca03d50aa?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=92ac636e1612914c1f52f2269332d432, https://si.imgix.net/522e1047/uploads/origins/f2733378-4cfa-4866-9b7b-781ca03d50aa?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e835d3157b7d88c58baeca3ae7c8e069 2x, https://si.imgix.net/522e1047/uploads/origins/f2733378-4cfa-4866-9b7b-781ca03d50aa?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ec39840779612b6d6936ddbb44b8e285 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/522e1047/uploads/origins/f2733378-4cfa-4866-9b7b-781ca03d50aa?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ee2c2a93c7c524ff20fce89d721446a9", "srcset": "https://si.imgix.net/522e1047/uploads/origins/f2733378-4cfa-4866-9b7b-781ca03d50aa?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ee2c2a93c7c524ff20fce89d721446a9, https://si.imgix.net/522e1047/uploads/origins/f2733378-4cfa-4866-9b7b-781ca03d50aa?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&bl