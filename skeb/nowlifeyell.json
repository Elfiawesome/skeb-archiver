00&h=200&blur=200&s=5b7bac1c26cf872a7be867811b4d67de", "src_set": ""}, "body": "火タイプのポケモントレーナー3人による対戦が見たい。\n1 - 第9世代よりメラ [メロコ] https://imgur.com/aKS0TzZ\n2 - マルバ [パキラ] 第6世代より https://imgur.com/tj0tCdx\n3 - 第2世代からフラナリー[アスナ] https://imgur.com/XsvihaF\n\n誰が一番長くサウナに入っていられるかを競う。\n\nマルバが汗をかかずに涼しいふりをしているところを描いてください。彼女は倒れて気絶する。メガネが落ち、目に『X』がつく。彼女が最初に負ける\nフラナリーとメラはサウナに耐え続け、大量の汗をかく。\n次にフラナリーが負ける\nフラナリーは現在位置をキープするが、目の前が真っ白になり、魂が体から抜け出そうとする。\n\nメラ[メロコ]の勝利\n\nパネル1：3人ともサウナに座っている。\nパネル2：マルバが負ける\nパネル3：メラとフラナリーの対決\nパネル4：フラナリーの負け\nパネル5：メラの勝ち\nパネル6：勝利後、メラは熱い石に水を加え、さらに蒸気を出す\n必要に応じてパネルを追加してください。", "nc": 33, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@nowlifeyell/works/9", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/50274658/uploads/origins/4ad5a61b-9d2e-453c-9f25-a61f4468c71e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=a329b92ef573f32b4c42e877fe413dab", "src_set": ""}, "private": true, "genre": "comic", "tipped": false, "creator_id": 3407738, "client_id": 758832, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 176, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@nowlifeyell/works/8", "private_thumbnail_image_urls": null, "private": false, "genre": "comic", "tipped": true, "creator_id": 3407738, "client_id": 0, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/e3c37ec7/uploads/origins/c09f51d0-2e99-4609-b4a7-42706a9504e7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=24d2faed772fcffba1cd9e8ea0b8a5a1", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/e3c37ec7/uploads/origins/c09f51d0-2e99-4609-b4a7-42706a9504e7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6016de22ca3fe6d168f15e3b02b12284", "src_set": ""}, "body": "先日「スカートの中が見えちゃうヒカリ」のエッチなハプニングシチュエーションの作品を依頼した者です\n連続の依頼となってしまうのですが、よろしければ再び依頼をお願い出来たらと思います\n\n「野生のポケモンを庇いながらスカートの中を見られちゃうリーリエ」\nといったエッチなピンチシチュエーションの作品をお願いしたいと思います\n\n〇キャラ\n・リーリエ　序盤のロングヘアーのワンピース姿で、スカートの中は白い下着で\n・男の子とお爺さん　見た目等は自由におまかせします\n・ピチュー\n・オニスズメ\n\n〇内容\n１、「このままではあのポケモンが…」「あのピチューやられちゃうよ…！」「ダメじゃ、近づくのは危険じゃ…！」\n・オニスズメに襲われているピチューと、それを遠くから見守る3人\n２、「きゃっ…！」「あ、リーリエちゃんが！」「や、やめるんじゃお嬢ちゃん！」\n・ピチューを両手で抱きかかえてオニスズメから守るリーリエ\n・オニスズメに風を起こされて、帽子を飛ばされてスカートを捲られながら苦しそうな表情\n３、「リーリエちゃんスカートが…！」「ダメじゃ、両手が塞がってて隠すことが……！」\n・オニスズメの攻撃に必死に耐えながら、スカートが捲れ上がって下着が丸見えになってる後ろ姿\n４、「リ、リーリエちゃんのパンツが……」「ダ、ダメじゃ…下着まで丸見えにされて…」\n・丸見えにされてるお尻のアップ\n\nセリフ等は自由に変更してもらって構いません\n再び要望の多い依頼になりますが、よろしければご検討お願い致します", "nc": 49, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@nowlifeyell/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "comic", "tipped": false, "creator_id": 3407738, "client_id": 0, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/308f875f/uploads/origins/99fa96af-624d-484d-929d-8f019090788f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f68776722965b604a2cd07eea9bf11de", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/308f875f/uploads/origins/99fa96af-624d-484d-929d-8f019090788f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=1f4d6522fbc78f4c3157778545cbd78f", "src_set": ""}, "body": "初めまして、Noah様の描かれるポケモン女の子キャラの可愛さ、そして納品速度の迅速さに惹かれて依頼しました。\n私は、粘着拘束という、女の子がネバネバしたものに足や体がくっついてしまい、身動き取れなくなるというシチュエーションが好きなので、以下のような漫画をリクエストしたいです。\n\nキャラ：ポケモンのセレナ、服装はスカートであればなんでもいいです。\n詳細な流れ\n道を歩いている。その先にはピンクのネバネバ溜まりがある。\n→右足でネバネバ溜まりを踏み、そのまま進もうとするも足が地面から離れず、「えっ？」と下を向く。\n→「何これ！？」と足をあげてもがく。\n→太ももを掴んで、必死に足を剥がそうともがく。パンツが見えるくらい足を上げていると、なりふり構わなさが伝わってきて嬉しいです。\n→ネバネバに足を引き戻される。\n→なんとかネバネバから脱出しようと、足の上げ下げを繰り返す。\n→体勢を崩し、前に倒れ込む。\n→くっついた服を剥がそうと腕を突っ張るが、伸びた服からブラが見える。\n→服は引っ張りに耐えきれず破れ、下着姿になってしまう。\n→「こんな姿誰かに見られたら…！」と恥ずかしがる。\n セリフ等はお任せします。 よろしくお願いします。", "nc": 32, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@nowlifeyell/works/6", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/a5ccdc69/uploads/origins/17a86e0a-09c5-4227-af41-7dc4e786a902?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=3992028e2acd2566c3705e21becda291", "src_set": ""}, "private": true, "genre": "art", "tipped": false, "creator_id": 3407738, "client_id": 0, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 32, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@nowlifeyell/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "comic", "tipped": true, "creator_id": 3407738, "client_id": 0, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/0d4a2576/uploads/origins/d5e05963-6250-47bb-b319-04c2f1cf8fd3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=be50765e9231a51a76592c0fa530deea", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/0d4a2576/uploads/origins/d5e05963-6250-47bb-b319-04c2f1cf8fd3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9fd096335d82a2083f349403738b3756", "src_set": ""}, "body": "新着リストからNoah様の描かれた可愛らしいポケモンキャラの作品を見かけ、是非依頼をお願い出来たらと思います\n\n「コンテストに参加するもスカートの中が映されちゃうヒカリ」\nといったちょっとエッチなハプニングシチュエーションの作品をお願いします\n\n〇キャラや背景\n・ヒカリとポッチャマ\n下記URLのイラストと同じようなコンテスト会場と同じコンテスト衣装\nスカートの中の下着は白地にレースやリボンのついた可愛らしいデザインで\n\n〇内容\n・ステージの上で手を振りながら後ろのモニターにも大きく映し出される二人\n・司会に紹介されながらモニターに大きく映されるヒカリ\n・カメラが切り替わり、足元のポッチャマをローアングルから映しながら紹介\n・そのままローアングルからヒカリのスカートの中も見えてしまってる様子\n・モニターに大きく映されたスカートの中にざわつく会場と気づかずに笑顔で手を振るヒカリ\n\n要望も多くニッチなシチュエーションの内容になりますがよろしければご検討お願い致します\n\nhttps://www.pokemon.co.jp/ex/bdsp/assets/img/features/ja/img_features_210818_05_01.jpg", "nc": 48, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@nowlifeyell/works/4", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/f1a076e2/uploads/origins/8ed76848-2271-456b-aa97-7cdea443fb8a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=dd09a81ad591b9afb4cfc63b525933fc", "src_set": ""}, "private": true, "genre": "comic", "tipped": true, "creator_id": 3407738, "client_id": 0, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 176, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@nowlifeyell/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "comic", "tipped": false, "creator_id": 3407738, "client_id": 2891147, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/c304a9b7/uploads/origins/82979898-ab60-4ddf-a710-343c8ed1a838?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=86db6a93e3eeaaa9c868bfe940484b10", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/c304a9b7/uploads/origins/82979898-ab60-4ddf-a710-343c8ed1a838?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9ce556fcb4b1e8d725ff39e576a520e6", "src_set": ""}, "body": "私のリクエストは、セレナちゃんとユリーカちゃんがパラシュートで空を飛んでいるところです。彼女たちが地上に降り立つと、パラシュートにすっぽり覆われてしまい、もがき苦しむ。その後、彼女たちは幽霊になったつもりで笑い合う。そして、彼女たちはパラシュートにくるまって寄り添う。\nセレナのパラシュートはピンクと白、ユリーカのパラシュートは黄色と白だ。\nセレナは2枚目のメイン衣装と短いヘアスタイルを着用する。\nパラシュートと一緒に使えるブランケットで、彼女たちがそれぞれ身を包む例を紹介しよう：\nhttps://1drv.ms/i/s!AvsEDH0kEzsHgdhYW4VkHtRbriohiw?e=ZDwfMN\n\nパラシュートの例：\nhttps://1drv.ms/a/s!AvsEDH0kEzsHgdgi55_U4gLlN0swBw?e=UWghz7\nhttps://1drv.ms/x/s!AvsEDH0kEzsHgc8SVzboEam8oieloQ?e=FGkHgz\nパラシュートに覆われたキャラクターの例：\nhttps://1drv.ms/f/s!AvsEDH0kEzsHgb007YzWZTj7sW7omQ?e=Kvrtfr", "nc": 153, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@nowlifeyell/works/2", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/5db82ffc/uploads/origins/2ad9133c-13c0-46d6-b996-3f91d80f0c5d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=f9d53a6dbf1bb2e2cd31597fcb55fa4d", "src_set": ""}, "private": true, "genre": "art", "tipped": false, "creator_id": 3407738, "client_id": 0, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 160, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@nowlifeyell/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "comic", "tipped": false, "creator_id": 3407738, "client_id": 2891147, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/a1cfcdae/uploads/origins/8b8898bb-fc33-4a89-9a58-56b1a6e1a401?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5c822532824eaf2ca43cc38d7b445eea", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/a1cfcdae/uploads/origins/8b8898bb-fc33-4a89-9a58-56b1a6e1a401?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=546a9ce767d09e2dd33f3f6c348f6d98", "src_set": ""}, "body": "こんにちは、\nマンガのリクエストですが、サイトウがトレーニングを終えて昼休みを取っていると、上空からパラシュートで飛んでくるコルニの叫び声が聞こえます。サイトウが身をかわすと、コルニがパラシュートにすっぽりと覆いかぶさる。そしてサイトウに謝り、マラサダの袋を渡す。サイトウは甘いものが大好きなので、コルニ以外の誰にも気づかれないようにしたい。そこで二人はサイトウのパラシュートの下に隠れ、一緒にマラサダを食べる。\n\nコルニのパラシュートはこんな感じ：(真っ白でも可）\nhttps://1drv.ms/i/s!AvsEDH0kEzsHgaduKHTD6Z7IWfHU4Q?e=h6T7VE\n\n参考文献\nパラシュートの他の例：\nhttps://1drv.ms/x/s!AvsEDH0kEzsHgc8SVzboEam8oieloQ?e=BJnSeK\nhttps://1drv.ms/a/s!AvsEDH0kEzsHgdd9joSj1_0anCOmVg?e=LJdwdy\nサイトウ\nhttps://archives.bulbagarden.net/wiki/File:Sword_Shield_Bea.png\nコルニ\nhttps://archives.bulbagarden.net/wiki/File:XY_Korrina.png", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "similar_creators": [{"id": 1721009, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "ろひち@ご依頼募集中", "screen_name": "wonder_bba", "avatar_url": "https://pbs.twimg.com/profile_images/1931375194117173248/dn-JKjPb.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1377907406110289921/1750365410/1500x500", "appeal_receivable": true, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "skills": [{"genre": "art"}, {"genre": "comic"}, {"genre": "novel"}], "nc": 160}, {"id": 1972152, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "いぬぬん skeb○", "screen_name": "ml_ffc111", "avatar_url": "https://pbs.twimg.com/profile_images/1609409885657247745/GRLGC_M4.jpg", "header_url": "https://pbs.twimg.com/profile_banners/848432137934036992/1709796062/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "skills": [{"genre": "art"}], "nc": 33}, {"id": 2812336, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "あきと", "screen_name": "akitoktkt", "avatar_url": "https://pbs.twimg.com/profile_images/1903680203366481920/LADPEd-l.jpg", "header_url": null, "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at