p=top&w=200&h=200&s=1b1eeada4c504955a5d33c4caea1a940", "srcset": "https://si.imgix.net/6710e30d/uploads/origins/40a0eb56-9099-48ac-9194-e83bdcbacdf4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1b1eeada4c504955a5d33c4caea1a940, https://si.imgix.net/6710e30d/uploads/origins/40a0eb56-9099-48ac-9194-e83bdcbacdf4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=7a5ee8538625c4505881934eb7c12b1e 2x, https://si.imgix.net/6710e30d/uploads/origins/40a0eb56-9099-48ac-9194-e83bdcbacdf4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f7fca50f0603044e6cd3f07dfca9a0f1 3x"}, "duration": null, "nsfw": true, "hardcore": true, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/6710e30d/uploads/origins/40a0eb56-9099-48ac-9194-e83bdcbacdf4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2953e728b0d0b038c43592429a13a10d", "srcset": "https://si.imgix.net/6710e30d/uploads/origins/40a0eb56-9099-48ac-9194-e83bdcbacdf4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2953e728b0d0b038c43592429a13a10d, https://si.imgix.net/6710e30d/uploads/origins/40a0eb56-9099-48ac-9194-e83bdcbacdf4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=c831dbbaecea9f260d3b3d65acbe8a09 2x, https://si.imgix.net/6710e30d/uploads/origins/40a0eb56-9099-48ac-9194-e83bdcbacdf4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=1826c113a1cdd20d2cacc6b670e8c8bf 3x"}, "body": "はいんちゅ(Skeb)様こんにちは\nこーほく(古山)と申します\n\nURLの様なキャラのフィギュアを販売中で、新作モチーフを必要としています\nオリジナルキャラを描ける事と絵柄が好みの方でしたので今回リクエストさせていただきました\n\n南国の無邪気な薄着少女のキャラを、等身は12歳くらい、裸足の全身画をお願いします\n\nキャラデザ的なリクエストなのですが\nもしよろしければご検討下さい。\n\n着衣は下記イラストくらいの、裸に布をまとって結んだくらいのごくシンプルな感じでお願いします\nイメージとしては奴隷服とか原始人服くらいのざっくりしたデザインで。\n完全な水着やズボン形状は避けて下さい\n\nhttps://skeb.jp/@TN_D75/works/11\nhttps://skeb.jp/@hommakai910/works/29\nhttps://skeb.jp/@tibiMALINO/works/11\nhttps://skeb.jp/@173_trpg/works/1\nhttps://skeb.jp/@natou3wari/works/2\nhttps://skeb.jp/@heibonkaeru/works/5\nhttps://skeb.jp/@e_crsm/works/5\nhttps://skeb.jp/@miyakon22/works/27\nhttps://skeb.jp/@618kazeman/works/7\n\n10cmくらいのフィギュアを予定しており、細かいディテールは再現できないので全体のシルエット・表情・ポーズ等でキャラクターが表現されているとありがたい感じです\n\nシチュやポーズで「はいてない」「腋乳」等フェチポイントの表現もあると嬉しいです。\n\nはいんちゅ様作品ですと2-①「ザ・フラッシュ」の扉のように右足を台に乗せてちょっと不敵な感じにしてくれると面白いかと思います。足を強調気味に、股間は裾でギリギリ隠す感じで。\n\n衣服とフェチポイント以外の、キャラそのものはお任せします。\n迷ったらお好み・お得意なもの・マイキャラ等を当てはめて下さい\n\n背景はありでもなしでもOK\n\n衣装や髪の見えない方向(背中等)からのごく簡単なラフ画もあると嬉しいです\n\nよろしければご検討お願い致します\n\nhttps://drive.google.com/file/d/1nwJ55U55jM8KS5ACtXndjRf7x9bagzGA/view?usp=sharing", "nc": 42, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}], "sent_works": [], "similar_creators": [{"id": 1045043, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "chicora", "screen_name": "wasabi22600110", "avatar_url": "https://pbs.twimg.com/profile_images/1395707299008712706/inmGhfT-.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1313351170660814848/1675250785/1500x500", "appeal_receivable": true, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "art"}, {"genre": "comic"}], "banned": false, "nc": 176}, {"id": 1854969, "creator": true, "nsfw_acceptable": true, "acceptable": false, "name": "ゆでいと", "screen_name": "kandis_milk", "avatar_url": "https://www.gravatar.com/avatar/?d=identicon", "header_url": null, "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "art"}], "banned": false, "nc": 176}, {"id": 2066722, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "わーっ",