=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6495464e1ef51d6494deb8485e0939ee", "src_set": ""}, "body": "Ren Riliyさんこんにちは。天使羽ニアちゃんのイラストありがとうございました。\nリピート依頼をさせていただきます。\n\n　キャラクター\n褐色の天使羽ニアちゃん（水着）\n水着のデザインは、資料URL先のようなギャルっぽい豹柄でお願いしたいです。\nへそピアス付き\n肌はテカリ強めでお願いしたいです。\n\n　希望のイメージ\nニアちゃんが動画を見せてくれる。反応を見てからかっている\n\n　希望のポーズ\n・ベッドに寝転がっているポーズ。\n・おへそ上くらいまででも大丈夫です。\n\n・胸と鎖骨の間あたりに横向きスマホを置いてスマホ画面で動画を見せつけている。\n\n・肘を曲げて両腕で胸を抱え込み、両手指で胸上のスマホを軽く抑えている。（胸下のほくろが隠れずに見えるようにお願いします）\n\n・スマホ画面の動画の１シーンにはニアちゃんと知らない男性が映っている。（男性はチャラ男っぽい目が髪で隠れた感じでお願いします）\n\n　表情\n①照れている風（演技）\n②からかっている、意地悪っぽい表情\n③　②の表情で舌をぺろっと出している\n\nhttps://www.pixiv.net/artworks/126423112", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@riliy_riliy/works/3", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/b98d2072/uploads/origins/5bfdd9e4-4084-4564-8149-203f8f7f025b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=7b31bcce80d19f2d1e08a8d5cb31236f", "src_set": ""}, "private": true, "genre": "art", "tipped": false, "creator_id": 3246710, "client_id": 0, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 145, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@riliy_riliy/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "voice", "tipped": false, "creator_id": 3246710, "client_id": 0, "vtt_url": "https://fcdn.skeb.jp/uploads/outputs/37de0989-08c6-4d28-accc-a53430dab69c?response-content-disposition=inline&Expires=1758730157&Signature=NfM0cglu9qqZG9jC8BxCf6Xs0IG83-VXN5W~75pLnfUl2ljgS9eYGpsjHXDe3PDmRIcGceeuvwcufb0y5tpFUScPPTikJIhrTL5FxQtuTuMXAYaif0yHnZn5CFzGYc5LMMFeOlhj6TJTeh-ttelEuVlzNBzpy4WU9~SHEiUMIjNC3M~q7x6AKefhbb2gHKjaZwJF3AuyZ0tsg4~lfZ9iuWU73k9or-SH71wBQivxwbeghj8rZ2etjftt9385dYy9sXQVmDb0IDWS0RA~bcHpczNxJAYuj7bLETKIrMi2YT0HDk6BiDp7b2tEiM7NJx-5T9Im2MTg1OHRynDA9cjHMw__&Key-Pair-Id=K1GS3H53SEO647", "thumbnail_image_urls": {"src": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1780470193854296064%2FAcEktQV8.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=34beccc880538e15b515d994484011ef", "src_set": ""}, "duration": 241, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1780470193854296064%2FAcEktQV8.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=bfcfce60f7728187e65e3d87c1480f44", "src_set": ""}, "body": "Ren Riliyさんこんにちは！\n今回は、ボイスジャンルにてリクエストを送信させていただきます。\nボイス収録していただきたいシチュエーションを用意してきましたので、よろしくお願いします！！ \n\n以下希望のシチュエーション \n\n・ゲーム友達(男)とボイスチャット・通話をよくしていることに対して嫉妬してしまう彼。\n\n・しかし、怒るでもなくしつこく聞きたがる彼の態度から、実は彼にそういった癖(NTR癖)があるとわかり、過去の経験談を話してほしいと迫られ、渋々要望に応えるために他の異性たちとのエピソードを話してあげるシチュエーション音声をお願いします。(内容はお任せします) \n\n・話していくうちに聞き手の反応が面白く、乗ってきてしまい、彼(聞き手)が初彼氏だと言っていたことに矛盾が生じ始めたり、過去にたくさん遊んでいたことをカミングアウトし出したりどんどん不穏な流れになっていき、今現在、それらの男性関係は既に無く(現在浮気はしてないが)、これらの話は全て過去のことだと分かりつつも悔しくて心がザワザワしている彼に対してあまあまなセリフをかけてENDという感じでお願いします。\n \n・話している途中で「大丈夫？辛くない？」や「聞いて後悔しない？」「私のこと嫌いになったりしない？」など確認を入れてほしいです。 \n途中からは「どうだと思う？」「この後どうなったと思う？」など焦らして妄想を掻き立ていじわるする感じでお願いします。\n\n・最初は乗り気ではなく、聞きたがっているから嫌々語っているが、後々反応が面白くなってきて、焦らしや囁きで緩急つけつつ最後はあまあまになる感じでお願いします。\n(途中で聞き手から主導権を奪うイメージです)\n\n 特殊なシチュエーションで再現が難しいと思いますが何卒よろしくお願いいたします。", "nc": 0, "word_count": 0, "transcoder": "audio", "creator_acceptable_same_genre": true}, {"path": "/@riliy_riliy/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3246710, "client_id": 0, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/cd5b3132/uploads/origins/fdf4e252-6fb6-43d2-b61a-0a5d097764ac?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=85252e470ae1bf5b355a846fa88e9e98", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/cd5b3132/uploads/origins/fdf4e252-6fb6-43d2-b61a-0a5d097764ac?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6456fc830281c56a7cdaf93dac8a3ae7", "src_set": ""}, "body": "いつぞやの配信で褐色の天使羽ニアちゃんがめちゃくちゃ好みだったので褐色の天使羽ニアちゃんのイラストをお願いします\n\n・衣装\n金ビキニ\nへそピアス\n\n・イラストの雰囲気\nギャルっぽい\nおへそをピースで広げている\n\n口元と脚以外のほくろの位置(通常衣装で隠れていた箇所)はお任せでお願いします\n可能であれば水着用のほくろの設定図も付けていただけると助かります\n\n褐色じゃない通常カラーの差分もあると嬉しいです", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "similar_creators": [{"id": 67600, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "もつに", "screen_name": "Doxxvz", "avatar_url": "https://pbs.twimg.com/profile_images/1829152935256961025/tEz0c4FR.jpg", "header_url": "https://pbs.twimg.com/profile_banners/4926361315/1751986094/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "skills": [{"genre": "art"}, {"genre": "correction"}], "nc": 49}, {"id": 850706, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "ふうま ちい(Huuma-Chii)", "screen_name": "huumachii", "avatar_url": "https://pbs.twimg.com/profile_images/1934885112648486914/H70j4cj0.jpg", "header_url": "https://pbs.twimg.com/profile_banners/151036821/1727383911/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "skills": [{"genre": "art"}], "nc": 161}, {"id": 1219293, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "ken　Skeb受付中", "screen_name": "shutenndouji1", "avatar_url": "https://pbs.twimg.com/profile_images/1757756153721942016/m7