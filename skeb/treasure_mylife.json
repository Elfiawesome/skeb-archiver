p&fit=crop&crop=top&w=200&h=200&s=ca7a8d3579367dc5da9f3093a4e12bee, https://si.imgix.net/2007e5b0/uploads/origins/60d4ad67-beec-4e22-b882-16f07b584407?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=650ac5de7681d67cd1c35bccdd86150c 2x, https://si.imgix.net/2007e5b0/uploads/origins/60d4ad67-beec-4e22-b882-16f07b584407?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=3d8b47bf04d336634c001b55b3cd7d2e 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/2007e5b0/uploads/origins/60d4ad67-beec-4e22-b882-16f07b584407?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=71cfb72b75997b4b833f645794d298f8", "srcset": "https://si.imgix.net/2007e5b0/uploads/origins/60d4ad67-beec-4e22-b882-16f07b584407?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=71cfb72b75997b4b833f645794d298f8, https://si.imgix.net/2007e5b0/uploads/origins/60d4ad67-beec-4e22-b882-16f07b584407?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=41b5b682fe527be301b760c7baa1eb86 2x, https://si.imgix.net/2007e5b0/uploads/origins/60d4ad67-beec-4e22-b882-16f07b584407?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=867a71e14ea2462c5e0f37863a9b31d2 3x"}, "body": "skebの依頼を失礼いたします。東北きりたんの絵を描いていることを知っていますが、ずんだもんも描くことはできますでしょうか？\n\nあの子をいつもの男の子っぽい服装(白の半袖ブラウスにグリーンのサスペンダー付きのハーフパンツ)と女の子の服装(ハーフパンツをスカートにする)にしてみたいです。\n\n○男の子っぽい服装の場合\n・男の子らしくやんちゃする\n・元気よく右手を上げている\n・左目をウインクする\n\n○女の子っぽい服装の場合\n・女の子らしくかわいらしくする\n・髪型をロングヘアにする\n・右手の指を口元に当てて、口は微笑んでいる\n\n\nそんな感じでお願いします", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@treasure_mylife/works/14", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1336595, "client_id": 3342082, "vtt_url": null, "thumbnail_image_urls": {"s