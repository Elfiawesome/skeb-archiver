&w=200&h=200&blur=200&s=1111c942932b942ce0dc5008ff753bea", "srcset": "https://si.imgix.net/acb6b5bc/uploads/origins/8316c67c-1fb6-48bb-a6b3-c399d4e6b565?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=1111c942932b942ce0dc5008ff753bea, https://si.imgix.net/acb6b5bc/uploads/origins/8316c67c-1fb6-48bb-a6b3-c399d4e6b565?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=ea0ac0822167515ef3c7d16dbe1cda43 2x, https://si.imgix.net/acb6b5bc/uploads/origins/8316c67c-1fb6-48bb-a6b3-c399d4e6b565?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=03362fa015ee5d2d03f66e6e7592887f 3x"}, "body": "きゅうりさん、はじめまして！リクエスト失礼します。うちの子「ユキノ子」の絵をお願いしたいです。\n\n* 身体特徴として、146㎝、14歳頃の体型。\n* 可能であれば、太ももとタイツのランガードまで見えるイラストだと嬉しいです。\n* そして、細かい部分アレンジして頂いて欲しいです。\n* また可能でしたらPSDでキャラと背景のレイヤーを分けて頂けますと幸いです。\n\n資料はお手数ですが下記のURLから参照お願いします。\n\nhttps://drive.google.com/file/d/1ZIG_0DDSUO4PYIxY3wrVsPpLE1QlOMjZ/view?usp=sharing", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@kyuri_senbei/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1851692, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/8fd3f767/uploads/origins/8f1d3d34-067d-45de-a141-e675d2111f77?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=cb3188e4f3fdf59639a837eb2640967b", "srcset": "https://si.imgix.net/8fd3f767/uploads/origins/8f1d3d34-067d-45de-a141-e675d2111f77?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=cb3188e4f3fdf59639a837eb2640967b, https://si.imgix.net/8fd3f767/uploads/origins/8f1d3d34-067d-45de-a141-e675d2111f77?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=9857367e49fbc2d8d5303cc941650d83 2x, https://si.imgix.net/8fd3f767/uploads/origins/8f1d3d34-067d-45de-a141-e675d2111f77?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=3d534f6367837abcd0b539e21e44e473 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/8fd3f767/uploads/origins/8f1d3d34-067d-45de-a141-e675d2111f77?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=10b72e31be5c8743c71517c3da077316", "srcset": "https://si.imgix.net/8fd3f767/uploads/origins/8f1d3d34-067d-45de-a141-e675d2111f77?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=10b72e31be5c8743c71517c3da077316, https://si.imgix.net/8fd3f767/uploads/origins/8f1d3d34-067d-45de-a141-e675d2111f77?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=3cad9c372c796e6418297a9fa2c8ae6f 2x, https://si.imgix.net/8fd3f767/uploads/origins/8f1d3d34-067d-45de-a141-e675d2111f77?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=59a754ff6d268807be6071ef48803a51 3x"}, "body": "先日は、とても素晴らしいオリジナルキャラを本当にありがとうございました！\nすごく素敵でしたので、追加でお友達キャラの女の子も作ってくださいませんでしょうか？\n設定としましては\n・前回の子と同じぐらいの歳（12歳ぐらい）\n・前回の子と対比になるように、少し明るそうなイメージ（明るいといっても、強気系ではなく、無邪気に明るい感じが好きです）\n・八重歯がチャームポイント\n・日本育ちだけど、フィンランドとのクォーターで、目の色だけは青い（髪は黒い）\n・子供向けアニメが好きで、魔女っ子に憧れている\n・好きな食べ物は、わたあめ\n・学校の成績は実は優秀（でも自慢はしない。普段の言動はアホっぽい）\n・前回の子が好きなお兄さんには、よく懐いている。実は内心ちょっと好きなのだが、友達の手前、その気持ちは前には出さない（あくまで前回の子を応援するつもり）\nこんな感じのイメージで、描いていただけますでしょうか？\n今回も、お手数おかけしますが、キャラクターデザインと、何か一つイメージイラスト的なものをつけてくださるとすごく嬉しいです！", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@kyuri_senbei/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1851692, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/a9c0de64/uploads/origins/14c9697c-30c8-4ba5-9242-89ea347ee332?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d474f7971c47b6f98715a46d56b81b49", "srcset": "https://si.imgix.net/a9c0de64/uploads/origins/14c9697c-30c8-4ba5-9242-89ea347ee332?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d474f7971c47b6f98715a46d56b81b49, https://si.imgix.net/a9c0de64/uploads/origins/14c9697c-30c8-4ba5-9242-89ea347ee332?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=71c9a94b0749398748f0c5b0e3cbc07c 2x, https://si.imgix.net/a9c0de64/uploads/origins/14c9697c-30c8-4ba5-9242-89ea347ee332?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=0a27f67e2e3579e4ce5a59beeef5b1e6 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/a9c0de64/uploads/origins/14c9697c-30c8-4ba5-9242-89ea347ee332?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=be5526668596c768cb2b6540ef196534", "srcset": "https://si.imgix.net/a9c0de64/uploads/origins/14c9697c-30c8-4ba5-9242-89ea347ee332?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=be5526668596c768cb2b6540ef196534, https://si.imgix.net/a9c0de64/uploads/origins/14c9697c-30c8-4ba5-9242-89ea347ee332?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=1e238af4ddc5416a36dc9bc0232a71bc 2x, https://si.imgix.net/a9c0de64/uploads/origins/14c9697c-30c8-4ba5-9242-89ea347ee332?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=d93dc61cac373aafe89b48c67122749a 3x"}, "body": "以前から先生のイラスト拝見して可愛いなと思っていました！\nskebを始められたのを知って、何か描いていただきたいとずっと考えていました。\nオリジナルで描いていただいても大丈夫でしょうか？\n抽象的ですが、以下のようなイメージの女の子を描いていただけませんか？\n先生に、こんな子を描いていただけたら嬉しいなと考えてみました！\n\n・12歳ぐらい\n・少し大人しめで無口な感じ\n・感情表現が苦手なだけで、内面はちゃんと感情豊か\n・近所に住んでいる大学生のお兄さんのことが好き。人見知りだけど、お兄さんにはちょっぴり甘えたい\n・少し無口で感情表現が下手だから、おしゃべりも上手じゃないけど、お兄さんはいつもちゃんと話を聞いてくれるから、好きになった\n・お兄さんがバイトしている雑貨屋さんにいつも遊びに行っている（お兄さんに会いたいから）\n・大人になったらお兄さんと一緒にバイトしたいな、と夢見てる\n・好物はホットケーキとチョコレート\n・お料理は歳の割には上手（いつかお兄さんに食べてほしいな……）\n・髪型はお任せ（前髪は下ろしている方が好きです。あと、ポニーテールはあまり好きじゃないので、ポニーテール以外でお願いします。他には、髪が外ハネしすぎていない普通にさらりとした感じが好きです）\n・メガネは無し\n\n以上のようなイメージで、キャラクターデザインしてくださると、すごく嬉しいです！\nもし可能でしたら、キャラクターデザインと、この子のイラスト（キャラクターのイメージにあったポーズやシーン）を一枚つけてくださるとすごく嬉しいです！\n一枚絵でも、ラフな感じで色んなポーズを散りばめた感じでも、先生にお任せいたします！\nどうかお願いいたします！", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@kyuri_senbei/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1851692, "client_id": 1461403, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/22a61b89/uploads/origins/ac84bc93-2421-40e4-a626-d27835fb3372?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8c0670eae4bef1517ab40021ee55be97", "srcset": "https://si.imgix.net/22a61b89/uploads/origins/ac84bc93-2421-40e4-a626-d27835fb3372?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8c0670eae4bef1517ab40021ee55be97, https://si.imgix.net/22a61b89/uploads/origins/ac84bc93-2421-40e4-a626-d27835fb3372?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=5a89e41074e96ea3d33d63ec8ef0a880 2x, https://si.imgix.net/22a61b89/uploads/origins/ac84bc93-2421-40e4-a626-d27835fb3372?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=4d360b2071d4c78dfdb0b399ad528ff9 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/22a61b89/uploads/origins/ac84bc93-2421-40e4-a626-d27835fb3372?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6e805a5eeeb9e9763cf26812f06d5713", "srcset": "https://si.imgix.net/22a61b89/uploads/origins/ac84bc93-2421-40e4-a626-d27835fb3372?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6e805a5eeeb9e9763cf26812f06d5713, https://si.imgix.net/22a61b89/uploads/origins/ac84bc93-2421-40e4-a626-d27835fb3372?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=2