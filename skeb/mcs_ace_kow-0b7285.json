3f/uploads/origins/ee47ea80-960c-4319-987d-abc2ec7b70a9?bg=%2523fff&auto=format&fm=webp&w=800&s=dd3d148a4390fa621e41392a6fa2704f%0A\n・右腕は二の腕から先が無く、引きちぎられた事が伺えるメカバレ。\n・左腕は銃弾を数発喰らった上でハンマーか何かで潰されたような壊れ方でメカバレ。\n・シチュ設定としては『戦闘中に腕を損傷して捕虜になり、連れ帰られた敵の基地で更に腕を破壊された上で全裸にされレイプされている』という状態。\n・腕を壊され、何度も中出しされ身体や顔に多数の精液をかけられても心は折れておらず「もう終わりかフニャチンども。オレ様のショットガンで穴だらけになって死んだお前のお仲間は最期までギンギンにおっ勃てて逝っちまったぞ？」と下品な憎まれ口を叩いているシーンのイメージです。\n\nよろしくお願いします。", "nc": 170, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@mcs_ace_kow/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1231096, "client_id": 12378, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/a25669ff/uploads/origins/df620b0f-dfd4-4822-bacf-91d039f5207c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8ecf0291798f3df15ed3e5ce81d12f70", "srcset": "https://si.imgix.net/a25669ff/uploads/origins/df620b0f-dfd4-4822-bacf-91d039f5207c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8ecf0291798f3df15ed3e5ce81d12f70, https://si.imgix.net/a25669ff/uploads/origins/df620b0f-dfd4-4822-bacf-91d039f5207c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=833eba7f40de664b4f3f1dd4f8eac236 2x, https://si.imgix.net/a25669ff/uploads/origins/df620b0f-dfd4-4822-bacf-91d039f5207c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b790c3777a638610f43b237c51e3b841 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/a25669ff/uploads/origins/df620b0f-dfd4-4822-bacf-91d039f5207c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=cc81ed528e66b2f5b55a74e68cc8119d", "srcset": "https://si.imgix.net/a25669ff/uploads/origins/df620b0f-dfd4-4822-bacf-91d039f5207c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=cc81e