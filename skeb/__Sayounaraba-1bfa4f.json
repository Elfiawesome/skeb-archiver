=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=b3acabee70e248915b230dec0f43d3b3, https://si.imgix.net/4fec2535/uploads/origins/b785d039-6661-4902-90ec-bc12e9fb861d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=09bbab3165fb9f565d486dd6799bf18f 2x, https://si.imgix.net/4fec2535/uploads/origins/b785d039-6661-4902-90ec-bc12e9fb861d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=32a9dc1c90e462b1df8eb748cce8b292 3x"}, "private": true, "genre": "art", "tipped": false, "creator_id": 3958036, "client_id": 2378340, "nc": 145}, {"path": "/@__Sayounaraba/works/15", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3958036, "client_id": 326249, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/9d60ba67/uploads/origins/891b959e-6125-4dc7-ae7a-3666fb7a4788?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9bda31b6be5135ff71ff62aca61a1bca", "srcset": "https://si.imgix.net/9d60ba67/uploads/origins/891b959e-6125-4dc7-ae7a-3666fb7a4788?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9bda31b6be5135ff71ff62aca61a1bca, https://si.imgix.net/9d60ba67/uploads/origins/891b959e-6125-4dc7-ae7a-3666fb7a4788?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ba19c9206d4a6a2003b1e79be9fafcca 2x, https://si.imgix.net/9d60ba67/uploads/origins/891b959e-6125-4dc7-ae7a-3666fb7a4788?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=84715d8503aae2ee5d46f06eb874b061 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/9d60ba67/uploads/origins/891b959e-6125-4dc7-ae7a-3666fb7a4788?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5f2cdd1b1b197d5674ae8636ced966e3", "srcset": "https://si.imgix.net/9d60ba67/uploads/origins/891b959e-6125-4dc7-ae7a-3666fb7a4788?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5f2cdd1b1b197d5674ae8636ced966e3, https://si.imgix.net/9d60ba67/uploads/origins/891b959e-6125-4dc7-ae7a-3666fb7a4788?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=32f2ecaf4b2fc26adce41db1735d952b 2x, https://si.imgix.net/9d60ba67/uploads/origins/891b959e-6125-4dc7-ae7a-3666fb7a4788?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=5e3d6a820aa06c417805efc77cf58705 3x"}, "body": "こんにちは、先生！お会いできて光栄です。Xで先生の最新作を拝見し、その美しい画風に驚きました🥺❤️。\nOCのイラストをリクエストすることは可能でしょうか？\n\nファンタジーの世界が舞台です。   \n\n\nNormad(ノーマッド): \n17歳の少年。身長176cm。太い眉毛と素直で子犬のような目が特徴。自分に厳しく厳しいが、友人（特にアルタラ）には温かく優しい。\nアルタラとは幼なじみで、共に育った。ノーマッドは自分のアルタラへの想いが家族以上のものであることを知っているが、同時にアルタラがより大きな運命に向かっており、自分と同じ気持ちではないことも分かっている。それでもノーマッドはそれを受け入れ、ただアルタラのそばにいて、アルタラのために身を捧げることに静かな喜びを見出している。\nノーマッドは過剰なまでの自己犠牲の美徳を持ち、強い道徳的良心も持っている。彼は心から、世界は素晴らしい場所であり、誰もが心の中に善を持っていると信じており、困っている人がいれば必ず手を差し伸べる。彼はガーデニングが好きで、英雄が登場する冒険の本をとても好んで読み、また童話も好んで読みます。\n\n\nAltara(アルタラ)：\n15歳の少年で、銀髪、銀のまつげ、紫の瞳を持つ。柔らかな形の目をしている。人懐っこく、好奇心旺盛。身長は166cm。神話に登場する紫の瞳の魔道士だが、その力をコントロールするのが難しい。エレメンタル・マジックの正しい使い方を学ぼうと、仲間とともに他の4種族が支配する王国を旅している。\n紫瞳の魔法使いの力は、生まれつき極端な欲望に突き動かされる性質を持っています。 それは両刃の剣のように、持ち主を救世主へ押し上げることもあれば、同時に破滅・狂気へと導き、やがて最も大切な存在さえも自らの手で壊してしまうことがあります。Altaraも例外ではありません。彼の心の奥底には、貪欲で傲慢で、欲望に飢えた落ち着きのない一面が潜んでいます。彼はその部分を認めようとせず、必死に抑え込み、いつか消えてなくなることを願っています。 \nノーマッドの存在は彼に多くの安らぎと情緒の安定を与え、ノーマッドを家族、親友、そしてその存在が呼吸をするように自然なものと見なしている。  \nそうだ、このままでいなければならない――とアルタラは自分に言い聞かせる。家族以上になってはいけない。\n* 右手に四つの指輪をつけています（URLの “Altara Outfit 1” とラベルされた衣装にてご確認いただけます）。\n\n\n一つの、アルタラが語らない真実：\n実はアルタラは自ら進んであの四つの指輪をはめたのです。八歳のとき、強い欲望によって大切なものを壊してしまうかもしれない自分を消し去りたくて、Normadを自分自身から守りたくて、指輪をはめることを選びました。指輪は彼の能力を（欲望を抑圧するとともに）封じる役割を果たしていました。\n\n\nまた、URLに＜First Sight＞というラベルの付いた、より詳しい幼少期のバックストーリーフォルダーを追加しました！よろしければご覧いただけますが、ご覧にならなくても全く問題ございません🥺\n\n\n自由に描いてください！  \nご配慮ありがとうございました> <❤️\n\nhttps://drive.google.com/drive/folders/1-_qZdBiVePV8nzgM3PQsl8YW2mZ7xrCF", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@__Sayounaraba/works/14", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3958036, "client_id": 555266, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/3d3d9ce1/uploads/origins/2fba57a5-a1e7-4fb7-97ee-0ea20647b5fb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=cae23405f13528e93493750985a0db2d", "srcset": "https://si.imgix.net/3d3d9ce1/uploads/origins/2fba57a5-a1e7-4fb7-97ee-0ea20647b5fb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=cae23405f13528e93493750985a0db2d, https://si.imgix.net/3d3d9ce1/uploads/origins/2fba57a5-a1e7-4fb7-97ee-0ea20647b5fb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a0febed291ccf24b339fc6ccfcc3c162 2x, https://si.imgix.net/3d3d9ce1/uploads/origins/2fba57a5-a1e7-4fb7-97ee-0ea20647b5fb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=07c199814930c86d75d20f2d1821a8cc 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/3d3d9ce1/uploads/origins/2fba57a5-a1e7-4fb7-97ee-0ea20647b5fb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2131a405031b8fc77276d34d663019a7", "srcset": "https://si.imgix.net/3d3d9ce1/uploads/origins/2fba57a5-a1e7-4fb7-97ee-0ea20647b5fb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2131a405031b8fc77276d34d663019a7, https://si.imgix.net/3d3d9ce1/uploads/origins/2fba57a5-a1e7-4fb7-97ee-0ea20647b5fb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w