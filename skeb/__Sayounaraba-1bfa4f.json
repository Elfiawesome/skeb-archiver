c": false, "tip_acceptable": true, "yearly_report_client_visible": false, "total_appeals_count": 0, "received_works": [{"path": "/@__Sayounaraba/works/18", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3958036, "client_id": 3522115, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/c6f4ab7c/uploads/origins/31bf19d4-79bb-4133-be13-311e4433c809?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=acbc2a75635c25b6509ab9c74a19fbae", "srcset": "https://si.imgix.net/c6f4ab7c/uploads/origins/31bf19d4-79bb-4133-be13-311e4433c809?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=acbc2a75635c25b6509ab9c74a19fbae, https://si.imgix.net/c6f4ab7c/uploads/origins/31bf19d4-79bb-4133-be13-311e4433c809?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=6acb23f1becee9865abe8c5f48bbdc3b 2x, https://si.imgix.net/c6f4ab7c/uploads/origins/31bf19d4-79bb-4133-be13-311e4433c809?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=85f572d594799492f868f77be84e9ae1 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/c6f4ab7c/uploads/origins/31bf19d4-79bb-4133-be13-311e4433c809?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c2a8c71192f6a6805d9db11e1a38315d", "srcset": "https://si.imgix.net/c6f4ab7c/uploads/origins/31bf19d4-79bb-4133-be13-311e4433c809?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c2a8c71192f6a6805d9db11e1a38315d, https://si.imgix.net/c6f4ab7c/uploads/origins/31bf19d4-79bb-4133-be13-311e4433c809?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=1d14904bcaa38d80a516275c68f9ab02 2x, https://si.imgix.net/c6f4ab7c/uploads/origins/31bf19d4-79bb-4133-be13-311e4433c809?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=30828029a118495c10aaa9dc92c4b8f7 3x"}, "body": "砂世 海原様、初めまして！\n\nskeb内であなたの作品を拝見し、あなたが描かれるキャラクター同士のインタラクションがとても素敵だと思い、依頼をお送りしました！\n\n私のOC三人組のイラストをご依頼したいです。彼らは多くの異常が発生したゲーム世界に住んでおり、今はその世界を救うために奮闘しています。\n\n「キャラクター1:月見里汐」\nモチーフは蝶。年齢17歳、身長168cm。\n· 外見は冷淡で、近づきがたい印象を与える少女。\n· 本人はあまり自覚していないが、多くの人や物事に対して強い支配欲を持っている。\n· 心は強く、一度やると決めたことは絶対に諦めない。\n\n「キャラクター2:伊藤信一郎」\nモチーフは蜘蛛。年齢16歳、身長175cm。\n· 情熱的で外向的、他人とすぐに友好的な関係を築ける少年、感情がすぐに顔に出る。\n· 物事は結果だけを重視し手段は気にしないため、時にとんでもない行動をとる。\n· 汐に惹かれており、彼女の付き人的存在としてサポートを提供する一方、裏では終日彼女をストーキングし写真を撮っている。\n\n「キャラクター3: 照輝」\nモチーフはハチドリ。ゲーム内年齢17歳、現実年齢21歳、身長179cm。\n·外面は明るく内面は冷めているタイプで、物事への熱しやすく冷めやすい性格。\n· 初印象は少し軽そうなタイプで、どんな気持ちの時も笑顔を浮かべている。ただし、笑顔の弧度に変化があり、感情の起伏が大きすぎるときは無表情になる。\n·汐に一目惚れし、彼女の全ての面を愛している。今は二人は別れているが、それでも友達として彼女に協力している。\n\nOCたちの詳しい設定や関係性については、Google Driveをご参照ください。彼らの日常的な絡みや、世界で発生している異常を調査しているシーンを描いていただきたいです。また、もし何か他のアイデアがございましたら、どうぞ自由に描いていただいても構いません。\n\nこれらのイラストは商用利用はせず、主に個人で鑑賞する目的で、作者名を明記した上で友人と共有させていただきます。\n\n最後までお読みいただき、ありがとうございます！\n\nhttps://drive.google.com/drive/folders/13GUOOcwWQNiU-RgH495G6XbQfPbc5M6I", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@__Sayounaraba/works/17", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3958036, "client_id": 3521932, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/e0f04430/uploads/origins/a93f2d87-192e-49e1-9bd1-1674ec877f01?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f24427854b7bf92c5be3d8a55d86d613", "srcset": "https://si.imgix.net/e0f04430/uploads/origins/a93f2d87-192e-49e1-9bd1-1674ec877f01?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f24427854b7bf92c5be3d8a55d86d613, https://si.imgix.net/e0f04430/uploads/origins/a93f2d87-192e-49e1-9bd1-1674ec877f01?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=3ef818f95419805a3594eadcb40d3cf0 2x, https://si.imgix.net/e0f04430/upload