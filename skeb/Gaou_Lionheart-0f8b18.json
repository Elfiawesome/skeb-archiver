366909c/uploads/origins/5b1a753b-4819-4d21-81e1-fa3acbd5ea28?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6468bd88fd82779077590dbb892aba04, https://si.imgix.net/5366909c/uploads/origins/5b1a753b-4819-4d21-81e1-fa3acbd5ea28?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=9bbc7dcb7782b81903be6065507e8680 2x, https://si.imgix.net/5366909c/uploads/origins/5b1a753b-4819-4d21-81e1-fa3acbd5ea28?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=53528254e4ce310d17fabe2197e9395a 3x"}, "body": "ガオウ・ライオンハート様\n\nお世話になります。灰江　渚です。\n前回はかっこよくて素敵なイラストをありがとうございました！\nこの度、イラストの制作をお願いしたくリクエストをお送りいたします。以下に詳細を記載いたしますのでご確認を宜しくお願い致します。\n\nー詳細ー\n・私、灰江　渚が、ゲーム「League of Legends」で使用しているキャラクター「フィオラ」の格好をしたイラストになります。\n・フィオラには、普段愛用している「バトルクイーン　フィオラ」という名のスキンがあり、そちらの服装を指定させていただきます。\n・ポーズですが、フィオラの立ち姿のように左手を背中に回し、右手で剣を持っているものになります。立ち姿に関して、簡単なラフを提示させていただきます。拙いもので恐縮ですが参考に宜しくお願いいたします。\n・私に関しまして、髪形に変更はございません。表情ですが、鋭い目つきでこちらを見ている物でお願いいたします。\n\n詳細については以上になります。資料URL中のドライブにて資料及び簡単なラフをご確認いただけます。参考に宜しくお願いいたします。\n長文になりましたが、今回のご依頼についてご検討いただけますと幸いです。宜しくお願いいたします。\n\nhttps://drive.google.com/drive/folders/1lpLT8c9HF-HHe_nZt4r2yyOymqklhTZ9?usp=sharing", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Gaou_Lionheart/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1318468, "client_id": 108387, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/d64705cb/uploads/origins/3fb2bcea-6ca7-46ab-bb44-e1e6c9e826c9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2c1e4e1c7dda5ef62bf1958e0529490e", "srcset": "https://si.imgix.net/d64705cb/uploads/origins/3fb2bcea-6ca7-46ab-bb44-e1e6c9e826c9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2c1e4e1c7dda5ef62bf1958e0529490e, https://si.imgix.net/d64705cb/uploads/origins/3fb2bcea-6ca7-46ab-bb44-e1e6c9e826c9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b01e30456f669e16f85ed94db6d447f8 2x, https://si.imgix.net/d64705cb/uploads/origins/3fb2bcea-6ca7-46ab-bb44-e1e6c9e826c9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=9790531b2d4ad4d06f56764a78986050 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/d64705cb/uploads/origins/3fb2bcea-6ca7-46ab-bb44-e1e6c9e826c9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2ccd136769983cd5cd29927441682eee", "srcset": "https://si.imgix.net/d64705cb/uploads/origins/3fb2bcea-6ca7-46ab-bb44-e1e6c9e826c9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2ccd136769983cd5cd29927441682eee, https://si.imgix.net/d64705cb/uploads/origins/3fb2bcea-6ca7-46ab-bb44-e1e6c9e826c9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=62821d33a12e3490f62bf576091218af 2x, https://si.imgix.net/d64705cb/uploads/origins/3fb2bcea-6ca7-46ab-bb44-e1e6c9e826c9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=a93006e6dc52af8f95cd1944c7703c94 3x"}, "body": "ガオウ さん\n\nいつもお世話になっております。ミセキです。\n今回もイラストの依頼をさせていただきたく、ご連絡いたしました。\nお忙しいところ恐れ入りますが、お目通しいただけますと幸いです。\n\n早速ですが、依頼させていただきたいイラストの内容・詳細について箇条書きで失礼いたします。\n\n☆イラストの主な使用用途:創作活動の進捗動画 等\n☆サイズ:3840×2160px 4K\n☆形式:PNG形式\n☆描画キャラクター:初音ミクと私(アクシスジカの姿) 添付資料のとおり\n☆キャラクターの表情:2人とも笑顔で楽しそうな表情\n☆キャラクターの服装:私→グレーのパーカー・青と白のボーダーシャツ・ジーンズ\n初音ミク→V4Xのビジュアル 添付資料のとおり\n☆キャラクターの描画範囲:全身\n☆キャラクターの構図:背中合わせ 添付資料のとおり\n☆イラスト背景:青空 添付資料のとおり\n☆こだわり:創作の作業風景のひと場面のような、2人で一緒に青空の下で「こんなフレーズはどう？」って歌いながらひとつの曲を創りあげていく感じをイメージしています。\n\n参考資料はGoogleドライブの共有を使用させていただきます。お手数をおかけしますが、ご確認よろしくお願いいたします。\n\n最後に、以前ポストをお見掛けして依頼の際にあると嬉しいとのことだったので、何故ガオウさんに依頼したのかを添えさせていただきます😊\n\n☆ガオウさんの描く初音ミクがとても大好きだから。\n☆ガオウさんの描く表情が素敵だから。\n☆以前に依頼させていただいた時に、次回以降もガオウさんに依頼させていただこうと思ったから。\n\n以上になります。\n\n依頼の内容・詳細は、Skeb依頼での許容範囲・ガオウさんがこうした方が良さそうだな・描きやすいなと思われた場合、変更していただいて構いません🙇\n\nご検討いただけますと幸いです。\nよろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/1fWEiCtO7YiMh6EdEhiKPPXKCTYOw-qHK", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Gaou_Lionheart/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1318468, "client_id": 1049723, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/f639e39d/uploads/origins/4351d5e4-9be1-44e1-968b-5d99ca87b1d7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0096fa7520abc49c61fec14fb5cfed11", "srcset": "https://si.imgix.net/f639e39d/uploads/origins/4351d5e4-9be1-44e1-968b-5d99ca87b1d7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0096fa7520abc49c61fec14fb5cfed11, https://si.imgix.net/f639e39d/uploads/origins/4351d5e4-9be1-44e1-968b-5d99ca87b1d7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=179dbd617b18ebaa3df780614c183492 2x, https://si.imgix.net/f639e39d/uploads/origins/4351d5e4-9be1-44e1-968b-5d99ca87b1d7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=43e5b50e8879d9282784c45cf6a67332 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/f639e39d/uploads/origins/4351d5e4-9be1-44e1-968b-5d99ca87b1d7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=24ffeadbe3bcb3504a6abc6cc0d409bd", "srcset": "https://si.imgix.net/f639e39d/uploads/origins/4351d5e4-9be1-44e1-968b-5d99ca87b1d7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=24ffeadbe3bcb3504a6abc6cc0d409bd, https://si.imgix.net/f639e39d/uploads/origins/4351d5e4-9be1-44e1-968b-5d99ca87b1d7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=8d787a6563ef69e77181c787abc9b288 2x, https://si.img