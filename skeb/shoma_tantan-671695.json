で、ナナッコベアー（ミニオン）と共にかいていただけると嬉しいです！\n\n◆使用用途\n配信活動をしておりますので、サムネイルやSNSでの告知などに使用させていただければと思っています。また、それにともなってお手数ですが、キャラクターイラストの透過データもいただけるととても嬉しいです。\n\nずっとヒカセンの姿を描いていただけたらと思っていた事、そして最近またFF14を再開し、暁月のフィナーレ（今は漆黒のヴィランズ途中）まで走り切りたいと思っていますので、そのパワーをいただければと思います。\nご検討、どうぞよろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/1SX8eSLFxRWzT6njf-6D9gvbLiz2RXZH7?usp=sharing", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@korukoruno/works/53", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1519162, "client_id": 1928491, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/4ebb49e3/uploads/origins/a75efc0a-6fcb-42ce-9dfb-2b933198d6d0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=90a013c877c631915547d6ea1c8097e7", "srcset": "https://si.imgix.net/4ebb49e3/uploads/origins/a75efc0a-6fcb-42ce-9dfb-2b933198d6d0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=90a013c877c631915547d6ea1c8097e7, https://si.imgix.net/4ebb49e3/uploads/origins/a75efc0a-6fcb-42ce-9dfb-2b933198d6d0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=51fde23c3a8a3e71d6fb38ff5159c931 2x, https://si.imgix.net/4ebb49e3/uploads/origins/a75efc0a-6fcb-42ce-9dfb-2b933198d6d0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=eadbc6a91e857dc5cac107c79c40e2d3 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/4ebb49e3/uploads/origins/a75efc0a-6fcb-42ce-9dfb-2b933198d6d0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=01ad612ff94fb87fe0937e2435e8882c", "srcset": "https://si.imgix.net/4ebb49e3/uploads/origins/a75efc0a-6fcb-42ce-9dfb-2b933198d6d0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=01ad612ff94fb87fe0937e2435e8882c, https://si.imgix.net/4ebb49e3/uplo