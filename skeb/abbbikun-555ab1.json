07dc571b01c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=85c7a3c18866ebb032c9affcd29fd02d, https://si.imgix.net/816070d6/uploads/origins/f1e3ef1c-e735-4103-9b94-f07dc571b01c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=7b22ba76d86b6a013a6a0f0b1cadeaff 2x, https://si.imgix.net/816070d6/uploads/origins/f1e3ef1c-e735-4103-9b94-f07dc571b01c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=d1292451a7bc295340bae7e271c4631a 3x"}, "body": "Hello, Mr. Ebi!\nIt's nice to meet you!\nI saw your illustration of Rimuru-chan from Tensura by chance, and I was so fascinated that I even started watching the anime I had stopped watching again, so I requested it!\nhttps://x.com/abbbikun/status/1861303611097260104\nhttps://x.com/abbbikun/status/1719368234665947400\n\nThe character I'd like to request is my original character \"Abyss-kun\"!\n\nCharacter\nAbyss-kun\nMotiv is a character based on the monster \"Water Abyss Magician\" from the game \"Hara-Kami\", who was branded as a traitor for saving a human girl who had saved him at one point. After being branded a traitor for saving the human girl who saved him at one point, he became disillusioned with the cult and fled, only to be transformed into a human by a god.\nhttps://kamigame.jp/genshin/page/127012493011779521.html\nhttps://www.youtube.com/watch?v=D0a86CmDzOQ&t=1s\nHe is a water elementalist and his special skill is the ability to create large soap bubbles.\nShe enjoys playing with soap bubbles with her children when she leaves her part-time job or on her days off, and sometimes she likes to get into mischief and keep her sisters trapped in large soap bubbles.\nI would like her pose to be sitting on a cushion made of soap bubbles.\nHer body shape is similar to Liam's.\nIf possible, it would be helpful if you could pay attention to the surface and luster of the soap bubbles.\n\nI have included the character's materials here.\nhttps://www.dropbox.com/scl/fo/g1sk24w20sjma3zf53ytk/AIrP2Ns9qFfMFYqhihYigk8?rlkey=xtoralw48fni3kgpvw9csdfwn&st=j5e30exq&dl=0\n\nBest regards!", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@abbbikun/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2558028, "client_id": 2010254, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/cc6c1c5a/uploads/origins/571c080d-87da-4715-b489-1c9435a3e5e5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2ee0257c5d64f9fda239d3cb9cacddc4", "srcset": "https://si.imgix.net/cc6c1c5a/uploads/origins/571c080d-87da-4715-b489-1c9435a3e5e5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2ee0257c5d64f9fda239d3cb9cacddc4, https://si.imgix.net/cc6c1c5a/uploads/origins/571c080d-87da-4715-b489-1c9435a3e5e5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=6842e58677d84c29409850f211f38d50 2x, https://si.imgix.net/cc6c1c5a/uploads/origins/571c080d-87da-4715-b489-1c9435a3e5e5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=2dad6b5cf3684cdda8fde7dd1821e552 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/cc6c1c5a/uploads/origins/571c080d-87da-4715-b489-1c9435a3e5e5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6e8510a4bb82769542c6e98eac2af2fa", "srcset": "https://si.imgix.net/cc6c1c5a/uploads/origins/571c080d-87da-4715-b489-1c9435a3e5e5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6e8510a4bb82769542c6e98eac2af2fa, https://si.imgix.net/cc6c1c5a/uploads/origins/571c080d-87da-4715-b489-1c9435a3e5e5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=cb20c1543829080425548509749e4e6a 2x, https://si.imgix.net/cc6c1c5a/uploads/origins/571c080d-87da-4715-b489-1c9435a3e5e5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=398a6f5fd74f9a08bcd7e56b928e4486 3x"}, "body": "はじめまして！(｀・ω・´)ゞ\n先生の転スラファンアートの大ファンなので、私のVtuberの絵をお願いしたいです。\n\nリムルスライムのぬいぐるみと一緒に描いたら可愛いと思うのですが、お好きなように描いていただいて構いません。できれば、好きな服を着て描いていただけませんか？シュナとシオンのラフがとてもかわいいです！\n\nデザイン、髪型は自由ですが、金のかんざしは外さないでください。髪を束ねたとき、顔の左側の髪が右側より長くなっています。髪を下ろしているときは、右側が長くなっています。もし不可能なら、「衣装2」にあるような黒いインナードレスを着て描いてください。手袋も忘れずに。\n\n魔女として異世界を旅していた、猫のような性格のツンデレ司書。本が好きで魔法が使え、珊瑚色のメンダコが相棒。猫の口と牙が特徴。目には蝶、背中には蝶のマークがあります。\n\nよろしくお願いします！\n\nhttps://drive.google.com/drive/folders/1mQthL8lGixCjzeqaPpSvQIHFT_Ad75po", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 138817, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "壽@skeb募集中", "screen_name": "bukitikikaku", "avatar_url": "https://pbs.twimg.com/profile_images/1377123448569307146/iebZ7W4B.jpg", "header_url": "https://pbs.twimg.com/profile_banners/938843350160982016/1677470029/1500x500", "appeal_receivable": true, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 7, "complete_expiration_days": 25, "skills": [{"genre": "art"}, {"genre": "comic"}, {"genre": "correction"}], "banned": false, "nc": 48}, {"id": 2355206, "creator": true, "nsfw_acceptable": false, "acceptable": false, "name": "やちし", "screen_name": "yachishi_orca", "avatar_url": "https://pbs.twimg.com/profile_images/1554025246587748352/H3x5ncIR.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1554018060197314565/1690096050/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 10, "complete_expiration_days": 90, "skills": [{"genre": "art"}], "bann