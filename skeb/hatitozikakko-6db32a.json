lient_visible": false, "total_appeals_count": 0, "received_works": [{"path": "/@hatitozikakko/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1130630, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/7ea2e4ba/uploads/origins/a1813394-8113-49e1-b106-84e469d6a134?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=37681b0d9231b0a20c6210bd3835da8e", "srcset": "https://si.imgix.net/7ea2e4ba/uploads/origins/a1813394-8113-49e1-b106-84e469d6a134?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=37681b0d9231b0a20c6210bd3835da8e, https://si.imgix.net/7ea2e4ba/uploads/origins/a1813394-8113-49e1-b106-84e469d6a134?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=aa5bc9fbe77ff5b6e5c42b914e87d788 2x, https://si.imgix.net/7ea2e4ba/uploads/origins/a1813394-8113-49e1-b106-84e469d6a134?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=fda06a25da0a4d35f25132742189c68d 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/7ea2e4ba/uploads/origins/a1813394-8113-49e1-b106-84e469d6a134?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d7cd5f8ff856e77869f44bc34ed68c06", "srcset": "https://si.imgix.net/7ea2e4ba/uploads/origins/a1813394-8113-49e1-b106-84e469d6a134?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d7cd5f8ff856e77869f44bc34ed68c06, https://si.imgix.net/7ea2e4ba/uploads/origins/a1813394-8113-49e1-b106-84e469d6a134?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=7a73cd806092c253395398c3617003f4 2x, https://si.imgix.net/7ea2e4ba/uploads/origins/a1813394-8113-49e1-b106-84e469d6a134?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=6816cd0d52efaf8047e23b0e90aced89 3x"}, "body": "システム:クトゥルフ神話TRPG6版\nプレイ人数:1人\nタイトル:あの子、スーサイド\n\nあらすじ:あの子が自殺したらしい。\nなんでも首つり自殺なんだとか。\n露雪村にて葬儀が行われる。\n寝ずの番をしてほしい。\nそんな連絡を受けたのは、冬のある日だった。\n\n――あれ、あの子の名前は、なんだっただろう。\n推奨技能:＜目星＞＜聞き耳＞＜図書館＞＜運転技能＞\n準推奨技能:＜オカルト＞又は＜人類学＞＜隠す＞\n\nシナリオ概要:　露雪村は、イタクァを昔より信仰している山奥の村だった。\n　イタクァをいとは様と呼び、四足二足を食することを禁じ特に鶏精進の習俗のあった村の中で、唯一外からやってきて鶏を飼っていた荻原一族を神の使いとして扱い、彼らが亡くなったときにイタクァへと返しながら、その肉を飢餓のためから口にするという因習が根付いた。\n　ただし、人の肉を食うことに抵抗のあった露雪村の人々は、名前が分からなければ罪悪感も薄れるのではないかと思い立ち、荻野一族が死んだ際に記憶を曇らせる呪文を繰り返し使って罪の意識を薄れさせていた。\n　長い間呪文をかけられ続けた遺伝子は、体が死んだ際に自動的に荻野一族の存在自体を秘匿するようになり、探索者の知り合いであった荻野紅華の認識までもを曇らせた。\n　荻野紅華が次の鶏飼いを産まないままにこの世を去ったため、一番荻野紅華と近しい存在である探索者を次の鶏飼いにしようと露雪村に呼び立てたのがシナリオの開始である。\n\nトレーラーイメージ:因習と血と雪のイメージなので、白と赤、黒がイメージカラーです。\nモチーフとしては冬という季節にそぐわないもの(ひまわりなど)です。", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@hatitozikakko/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1130630, "client_id": 1229799, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/8b6a61ba/uploads/origins/f9c70d24-3b54-45c1-a63b-66331806861a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=99b02bdb3ede3461c44dfc02c18b6391", "srcset": "https://si.imgix.net/8b6a61ba/uploads/origins/f9c70d24-3b54-45c1-a63b-66331806861a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=99b02bdb3ede3461c44dfc02c18b6391, https://si.imgix.net/8b6a61ba/uploads/origins/f9c70d24-3b54-45c1-a63b-66331806861a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=7e080e762bcaf9dcc19bc76ebd1b5407 2x, https://si.imgix.net/8b6a61ba/uploads/origins/f9c70d24-3b54-45c1-a63b-66331806861a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ece58be4ec0238f543fe1e623fcb652b 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/8b6a61ba/uploads/origins/f9c70d24-3b54-45c1-a63b-66331806861a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9e62616f82dcfe3c93d7497eb31194bc", "srcset": "https://si.imgix.net/8b6a61ba/uploads/origins/f9c70d24-3b54-45c1-a63b-66331806861a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9e62616f82dcfe3c93d7497eb31194bc, https://si.imgix.net/8b6a61ba/uploads/origins/f9c70d24-3b54-45c1-a63b-66331806861a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=2bb8bcb466dc6dc6308d7cd15fc176e7 2x, https://si.imgix.net/8b6a61ba/uploads/origins/f9c70d24-3b54-45c1-a63b-66331806861a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=70f37d0834092e9460ce852a19a4114c 3x"}, "body": "トレーラーリクエスト\n【文字情報】\n「拝啓 ―――」（Call of Cthulhu　の文字も入れる）\n\nプレイ人数：1人\nプレイ時間：約1時間\n推奨技能：特になし\n\n貴方はいつも通りの日常を過ごしている。\nご飯を食べ、風呂に入り、歯を磨き、そして寝る。\n幾度となく繰り返してきたそれに意味なんてものはない。\nただ、生きていく為にしていることだ。\nそして今日もまた、繰り返すのだろう。\n心に隙間を空けながら。\n\n\n【シナリオ概要】\nhttps://www.pixiv.net/novel/show.php?id=20601995\n\n亡くなった友人や疎遠になった知人に手紙を書くシナリオです。\nできるだけ、儚い雰囲気だと助かります。\n漠然としていてすみません💦\n\n【メモ】\n大変申し訳ございません。\n文字情報が抜けていたので再度送らせていただきます。\n\nhttps://www.pixiv.net/novel/show.php?id=20601995", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@hatitozikakko/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1130630, "client_id": 1221466, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/f79a99db/uploads/origins/c1168ee9-75c0-4c36-bba1-ba0c31f72fc9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=af8f86e65e904d39f27ab102c1b1af9b", "srcset": "https://si.imgix.net/f79a99db/uploads/origins/c1168ee9-75c0-4c36-bba1-ba0c31f72fc9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=af8f86e65e904d39f27ab102c1b1af9b, https://si.imgix.net/f79a99db/uploads/origins/c1168ee9-75c0-4c36-bba1-ba0c31f72fc9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=14f460dd489b1b554cf8dc5be029d81c 2x, https://si.imgix.net/f79a99db/uploads/origins/c1168ee9-75c0-4c36-bba1-ba0c31f72fc9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c98fd21f2ecd5f1381a18a877f04251d 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/f79a99db/uploads/origins/c1168ee9-75c0-4c36-bba1-ba0c31f72fc9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9fd5bda817906b5e4bc46d64c9921d3e", "srcset": "https://si.imgix.net/f79a99db/uploads/origins/c1168ee9-75c0-4c36-bba1-ba0c31f72fc9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9fd5bda817906b5e4bc46d64c9921d3e, https://si.imgix.net/f79a99db/uploads/origins/c1168ee9-75c0-4c36-bba1-ba0c31f72fc9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=513a9fd8b9c7bcd913c06d77d0f7e56a 2x, https://si.imgix.net/f79a99db/uploads/origins/c1168ee9-75c0-4c36-bba1-ba0c31f72fc9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=4c87b16aa7eea57223f858e0a71717d2 3x"}, "body": "システム:クトゥルフ神話TRPG6版\nプレイ人数:2〜4人\nタイトル:「あんぎゃ」\nコピー:行脚\n１ 仏道修行のために、僧侶が諸国を歩き回ること。\n２ ある目的で諸地方を巡り歩くこと。\nあらすじ:探索者達はオカルトサークルの活動の一環として、とある村を訪れることとなる。\nその村にはお盆の季節になると灯籠を流す燭光祭と呼ばれる祭りがあり、何でも流された灯籠は「あんぎゃ様」のために流されているらしい。\n探索者達が灯籠を流し、民宿へ泊まっていた夜のこと。短宅者達は自分達が船に乗って灯籠と共に川を下る夢をみる——。\n推奨技能:＜目星＞＜聞き耳＞＜図書館＞\n準推奨技能:＜オカルト＞\n\nシナリオ概要:\n遠い昔に別の村を追い出され、いくあてもなく放浪していた身重の女性が異国の神を呼び出す巫女として探索者達が訪れた村の神官に見初められ、村へと迎え入れられる。\nしかし命は名ばかりで、生贄として出産したばかりの胎児を捧げられてしまい、村はシュブ＝ニグラスの召喚を成功させ、その加護を得ることとなる。\nしかしそれを許さなかったのが村へ迎え入れられた女性であり、女性はシュブ＝ニグラスとの契約に一遍の呪いを混ぜ込んだ。\nその呪いとは、お盆の時期に帰ってくる先祖の霊を生贄としてシュブ＝ニグラスに捧げ続けるというものであり、それで手打ちにすると狂死した。\nその呪いが今も効力を発揮しており、灯籠を流した探索者はお盆終わりに魂をシュブ＝ニグラスへと捧げられてしまうというシナリオ。\nシナリオ途中に着物姿の古風な少女の登場を予定しており、この少女こそが村へ迎え入れられた女性であり、「あんぎゃ様」と呼ばれてる女性です。\n\nトレーラーイメージ:呪いと因習が関わるシナリオのため。全体的に彩度も明度も低いイメージです。\nイメージカラーは黒と赤、鳥居やしめ縄などの神社を彷彿とさせるもの、もしくは民宿での夢から始まるシナリオなので襖や障子、または川を流れる灯籠がイメージです。", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@hatitozikakko/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1130630, "client_id": 1229799, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/0de40881/uploads/origins/4722ee09-7a66-4165-946b-1ed80b740437?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=177efc7cf199c44bca58cd2af1b008c1", "srcset": "https://si.imgix.net/0de40881/uploads/origins/4722ee09-7a66-4165-946b-1ed80b740437?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=177efc7cf199c44bca58cd2af1b008c1, https://si.imgix.net/0de40881/uploads/origins/4722ee09-7a66-4165-946b-1ed80b740437?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=731280e272adbd6b679c573b419186ea 2x, https://si.imgix.net/0de40881/uploads/origins/4722ee09-7a66-4165-946b-1ed80b740437?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=29222a42c68d1bcf8c587349f243a100 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/0de40881/uploads/origins/4722ee09-7a66-4165-946b-1ed80b740437?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=77e551f9a76c35112addedcd22004aff", "srcset": "https://si.imgix.net/0de40881/uploads/origins/4722ee09-7a66-4165-946b-1ed80b740437?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=77e551f9a76c35112addedcd22004aff, https://si.imgix.net/0de40881/uploads/origins/4722ee09-7a66-4165-946b-1ed80b740437?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=ad28b82acdc0e3844d4fe84d8f561e24 2x, https://si.imgix.net/0de40881/uploads/origins/4722ee09-7a66-4165-946b-1ed80b740437?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=9b9478bb7961a8843afbc33404258320 3x"}, "body": "先日の依頼では大変お世話になりました！\nTwitterでも言わせていただいたのですが、過去の作品が流れてきた時に8)様の作品に一目惚れしてしまいました。\nよろしければ、またご依頼させていただけたらと思います。\n\n\n\nトレーラーリクエスト\n【文字情報】\n「亡霊にさよならを」（Call of Cthulhu　の文字も入れる）\n\nHO1：人間\nHO2：亡霊\n\nプレイ人数：2人\nプレイ時間：約3時間\n推奨技能：夏を楽しめる技能\n年齢：夏休みが堪能できる年齢\n\n\n貴方たちは親友だ。\n\n幼いころ、HO1とHO2の家族でキャンプに来ていた。\nその道中、貴方たちの車は崖から転落し、海へと投げ出された。\n気が付くと、貴方たちは白い天井を見上げていた。\n体を起こせば、両親が貴方の目覚めを成大に喜んでいるだろう。\nしかし、隣のベッドにいる彼方の目覚めを喜ぶものは、どこにもいない。\nただ、そこにあったのは、一輪の花だけだった。\n\n\nこれは、貴方たちだけの、夏の物語。\n\n【シナリオ概要】\nhttps://www.pixiv.net/novel/show.php?id=17387079\n\n【トレーラーイメージ】\n夏を感じさせるようなトレーラー。\n海のイメージが強い為、海を使っていただけると助かります。\nシリアス、というよりは夏を満喫するようなシナリオです。\n最後だけはシリアスになるかもしれません。\n\n【メモ】\nHO1が貴方、HO2が彼方という表記にしています。", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@hatitozikakko/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1130630, "client_id": 1360681, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/01b65e57/uploads/origins/2ea45a72-8763-489d-9e7b-c37e3926705d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=30796032f309c5d7b60bd00e76cda95e", "srcset": "https://si.imgix.net/01b65e57/uploads/origins/2ea45a72-8763-489d-9e7b-c37e3926705d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=30796032f309c5d7b60bd00e76cda95e, https://si.imgix.net/01b65e57/uploads/origins/2ea45a72-8763-489d-9e7b-c37e3926705d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=210832b20043cd67a1148bad17a7d528 2x, https://si.imgix.net/01b65e57/uploads/origins/2ea45a72-8763-489d-9e7b-c37e3926705d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d31c74134efed19e1d98d115d272b10d 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.