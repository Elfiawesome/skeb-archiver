ly\nあなたは気がついたらこの場所にいた。\nある夜、知らない森でHO1と出会った。\nあなたには『記憶』と『■■』がない。\n\n\n\n\n\n【トレーラーイメージ】\n月と百合がモチーフの儚げで綺麗なトレーラー。\n清純で綺麗なイメージでまとめていただく中に、ほんの少しだけ、電子的・サイバーチックな要素を潜ませてもらえると嬉しいです。\nコピーは『運命なんて、言わせない』です。\n文字情報が多い上に抽象的な要望ですみません。\n\n以上よろしくお願いいたします。", "nc": 32, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@hatitozikakko/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1130630, "client_id": 502029, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/256f5a1c/uploads/origins/18d45d12-c415-4fea-b388-84cac9172319?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0e80848d3efe8fbf5e354285ffbdce06", "srcset": "https://si.imgix.net/256f5a1c/uploads/origins/18d45d12-c415-4fea-b388-84cac9172319?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0e80848d3efe8fbf5e354285ffbdce06, https://si.imgix.net/256f5a1c/uploads/origins/18d45d12-c415-4fea-b388-84cac9172319?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=2c7f2fbf062cec7d1d6b1a81eabd9255 2x, https://si.imgix.net/256f5a1c/uploads/origins/18d45d12-c415-4fea-b388-84cac9172319?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=416115835e0dc2b5a20dd2da39e84601 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/256f5a1c/uploads/origins/18d45d12-c415-4fea-b388-84cac9172319?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ebb4e6049dd289055a105829717ab6e5", "srcset": "https://si.imgix.net/256f5a1c/uploads/origins/18d45d12-c415-4fea-b388-84cac9172319?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ebb4e6049dd289055a105829717ab6e5, https://si.imgix.net/256f5a1c/uploads/origins/18d45d12-c415-4fea-b388-84cac9172319?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&