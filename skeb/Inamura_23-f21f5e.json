彼女はオラクルで、タロットカードに似た「ハローカード」を使って未来を見通すことができます。また、これらのカードを使って様々な呪文を唱えることも可能です。\n\nオラクルという性質上、ヴェセラの瞳は完全に緑色ですが、フクロウのように暗闇で光ります。また、力を使いすぎたせいで、肌の色は青くなってしまいました。 長時間にわたり能力を使い続けると、呪いにかかり、破滅的な未来の幻視が見え始める。身長は183cmとかなり背が高い。好きな色は緑と青だ。\n\n構図やポーズについては、あなたの腕に任せます！\n\nご検討いただきありがとうございます！", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Inamura_23/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3942640, "client_id": 2486459, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/7c61188a/uploads/origins/84bea918-d0cb-4625-afa3-a5e7cf3bdbb9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2dff21f517e2950356d595184987d6cd", "srcset": "https://si.imgix.net/7c61188a/uploads/origins/84bea918-d0cb-4625-afa3-a5e7cf3bdbb9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2dff21f517e2950356d595184987d6cd, https://si.imgix.net/7c61188a/uploads/origins/84bea918-d0cb-4625-afa3-a5e7cf3bdbb9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e95bc01629e38cb17f9ed4abe3b60ca6 2x, https://si.imgix.net/7c61188a/uploads/origins/84bea918-d0cb-4625-afa3-a5e7cf3bdbb9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=72e4facb4c9a57d0a109497b0d8dd2dc 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/7c61188a/uploads/origins/84bea918-d0cb-4625-afa3-a5e7cf3bdbb9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a086429bd74f862e962cba88c119ffd9", "srcset": "https://si.imgix.net/7c61188a/uploads/origins/84bea918-d0cb-4625-afa3-a5e7cf3bdbb9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a086429bd74f862e962cba88c119ffd9, https://si.imgix.net/7c61188a/uploads/origins/84bea918-d0cb-4625-afa3-a5e7cf3bdbb9?bg=%23fff&auto=format%2Ccompress&fm=webp