るのが好きなので、抱っこを催促したり、座っている時に膝に乗ったり、足元にくっついたりしています。\n\n…ぐらいの情報があれば大丈夫かな?と思うので、あとは想像にお任せします。\n\nサイズは350dpi、A4サイズ以上のものだと嬉しいです。\n用途はSNS、インターネット上の掲載、ヘッダーなどに使用するかもしれません。\n\nよろしくお願いします!\n\nhttps://twitter.com/pofutta/status/1426954407157981188?s=21", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "similar_creators": [{"id": 2811101, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "🌹みる🧸", "screen_name": "Mi_qqq_Ru", "avatar_url": "https://pbs.twimg.com/profile_images/1942965603519918081/JNLAudYR.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1514823866782482434/1744171258/1500x500", "appeal_receivable": true, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "art"}], "banned": false, "nc": 17}, {"id": 2812049, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "キネタム-skeb募集中", "screen_name": "kinetamu", "avatar_url": "https://pbs.twimg.com/profile_images/1733137866791018496/O_07JH4C.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1675747415041900544/1720133427/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 50, "skills": [{"genre": "art"}, {"genre": "correction"}], "banned": false, "nc": 32}, {"id": 3249524, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "○ @skeb募集中です", "screen_name": "maru_m_ru", "avatar_url": "https://pbs.twimg.com/profile_images/1735342762495754241/Wj7CWah8.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1672003287502168064/1726840966/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "del