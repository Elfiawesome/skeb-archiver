あれば、イメージ等崩してくださって構いません。\n\n\n長々と大変失礼致しました。\n画像サイズや構図、またデザインの簡略化や変更等は造花束様の描きやすい形で、お好きにして頂ければと思います。\n\n内容や金額等に不備がございましたら、お気軽に再送申請等頂けますと幸いです。\nご検討頂けますと幸いです、よろしくお願い致します。", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Zoukataba/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3530530, "client_id": 3635560, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/47ad1207/uploads/origins/aac4b9f4-2950-4e26-9036-0c9e2dabf309?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2c0a073b0a91fbcf362d25e7664d2f0f", "srcset": "https://si.imgix.net/47ad1207/uploads/origins/aac4b9f4-2950-4e26-9036-0c9e2dabf309?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2c0a073b0a91fbcf362d25e7664d2f0f, https://si.imgix.net/47ad1207/uploads/origins/aac4b9f4-2950-4e26-9036-0c9e2dabf309?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=1a745929bc11e6fee206d3aa5b7a39ce 2x, https://si.imgix.net/47ad1207/uploads/origins/aac4b9f4-2950-4e26-9036-0c9e2dabf309?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d858df607df3665211eeb91eaa9eed3f 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/47ad1207/uploads/origins/aac4b9f4-2950-4e26-9036-0c9e2dabf309?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=94e89e9d0daaec434938d29db1036426", "srcset": "https://si.imgix.net/47ad1207/uploads/origins/aac4b9f4-2950-4e26-9036-0c9e2dabf309?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=94e89e9d0daaec434938d29db1036426, https://si.imgix.net/47ad1207/uploads/origins/aac4b9f4-2950-4e26-9036-0c9e2dabf309?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=5e59198358bd6b36c12e46981087aecc 2x, https://si.imgix.net/47