fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=599091d14af9430a51653607b867ac8d 3x"}, "body": "こんにちは！あなたのアートスタイルがとても気に入ったので、画像をリクエストしたいと思いました。  もし、あなたのこの作品からインスピレーションを得ることができたら、最高です。\nhttps://skeb.jp/@kuki1628/works/3\n\nガールズフロントラインのSSG3000をこの衣装で描いてください：\nhttps://iopwiki.com/images/7/7c/SSG_3000_costume1.png\n\n元画像より胸を大きくしてください。また、ドレスは片足が見えるように描いてください。ドレスの一部を破って脚を見せることもできます。遊び心のある表情をしてください。あとはあなた次第です。\n\nよろしくお願いします。", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@kuki1628/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3107936, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/46ecf0bc/uploads/origins/2c6edfd5-559c-4901-bb1d-c000924f4220?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6102d29b7af431997293bdf35fa5809b", "srcset": "https://si.imgix.net/46ecf0bc/uploads/origins/2c6edfd5-559c-4901-bb1d-c000924f4220?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6102d29b7af431997293bdf35fa5809b, https://si.imgix.net/46ecf0bc/uploads/origins/2c6edfd5-559c-4901-bb1d-c000924f4220?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=3a8ba4cc177b6c88301b61ad09898785 2x, https://si.imgix.net/46ecf0bc/uploads/origins/2c6edfd5-559c-4901-bb1d-c000924f4220?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=053c78772b04c60d3417bbb83c2be85a 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/46ecf0bc/uploads/origins/2c6edfd5-559c-4901-bb1d-c000924f4220?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=753501fc2b4e6972007e280fceaad575", "srcset": "https://si.imgix.net/46ecf0bc/uploads/origins/2c6edfd5-559c-4901-bb1d-c000924f4220?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=753501fc2b4e6972007e280fceaad575, https://si.imgix.net/46ecf0bc/uploads/origins/2c6edfd5-559c-4901-bb1d-c000924f4220?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=c86215a11264d93850c673b287180dd3 2x, https://si.imgix.net/46ecf0bc/uploads/origins/2c6edfd5-559c-4901-bb1d-c000924f4220?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=2dce04e3b8034b5ccdd0a3c75956ac83 3x"}, "body": "初めまして。\n氷の魔女VTuberの熨斗目メナ(のしめめな)と申します。\nクキ様のイラストの絵柄が好みでしたので描いて頂きたく今回リクエストの方させて頂きました。\n\n▼イラストについて\n熨斗目メナのイラストをお願いします。\n秋の紅葉を見に来ているようなイラストをお願いします。\nまた衣装や髪型などもアレンジしていただけたらなと思います。\n構図など自由に書いていただけたら嬉しいです。\n頭や髪の毛、手などが切れないように描いていただけると嬉しいです。\n\n\n\n▼参考資料\n立ち絵資料と、Twitter、YouTubeのリンクを添付させていただきます。\n\n・資料\nhttps://drive.google.com/drive/folders/17960Snvo57OjSAy_booEcuTde2TmMuAJ?usp=sharing\n\n・Twitter\nhttps://twitter.com/noshime_mena \n\n・YouTube\nhttps://www.youtube.com/@noshime_mena\n\n▼納品方法\n納品の際ですが可能であれば、背景、人物、サインで分けていただきたいのと透過したものもいただけますとありがたいです。\nもし可能であればPSDデータを頂けると幸いです。\n\n▼使用用途\nTwitterなどのSNSのアイコンやヘッダー\nFANBOXやグッズ制作。\nYouTubeのサムネやED、また最近ポスター掲載や雑誌掲載などが多くなっているのでそういった配信活動にも可能であれば使用したいと思っております。\n\n使用範囲の有無を、教えて頂けると幸いです。\n\nお忙しい中だと思いますがどうぞよろしくお願い致します。", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@kuki1628/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3107936, "client_id": 2720661, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/e441500a/uploads/origins/f05a04c6-9098-4d2b-8c53-7339e7e67420?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fca8d5ce4e9d87b9ead8e3d1cd0b728f", "srcset": "https://si.imgix.net/e441500a/uploads/origins/f05a04c6-9098-4d2b-8c53-7339e7e67420?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fca8d5ce4e9d87b9ead8e3d1cd0b728f, https://si.imgix.net/e441500a/uploads/origins/f05a04c6-9098-4d2b-8c53-7339e7e67420?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=3322d0982ea3a85cd5fe2a95e0631e06 2x, https://si.imgix.net/e441500a/uploads/origins/f05a04c6-9098-4d2b-8c53-7339e7e67420?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e4fedb76fa2ae167431114fb17584a55 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/e441500a/uploads/origins/f05a04c6-9098-4d2b-8c53-7339e7e67420?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=753b3d938e71a90c5ebd06db0684aa15", "srcset": "https://si.imgix.net/e441500a/uploads/origins/f05a04c6-9098-4d2b-8c53-7339e7e67420?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=753b3d938e71a90c5ebd06db0684aa15, https://si.imgix.net/e441500a/uploads/origins/f05a04c6-9098-4d2b-8c53-7339e7e67420?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=ecaa3710d819291756b5d150dc327612 2x, https://si.imgix.net/e441500a/uploads/origins/f05a04c6-9098-4d2b-8c53-7339e7e67420?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=8f89344ca903186e83244bf478fdf3bd 3x"}, "body": "初めまして。\nYouTubeにてASMR/シチュエーションボイスを投稿して活動しているあいせです。\n\n※ボイスの雰囲気は\nこちらでご確認下さい↓\nhttps://www.youtube.com/@Aise_ASMR\n\n先生の描かれるイラストの世界観が大好きで、新着で見た瞬間ビビッと来てしまいました…\n先生を知ったばかりですがファンです。\n\n是非当方の活動用イラストを描いて頂きたく思い今回ご連絡いたしました。\n\n«使用用途»\n・YouTubeの動画やサムネイル(収益化済)\n・Twitterアイコンやツイート等での使用\n・可能であれば有料ファンサイトでの使用\n\n※不可の場合御手数ですが依頼のキャンセルをお願いいたします。\n※腕や髪等イラストの端が切れていないようにして頂けると嬉しいです。\n※透過素材を頂けますと幸いです。\n\n«キャラクターデザイン»\n当方の既存のデザインを使用して頂きたいです。\n\n参考資料URL↓\nhttps://drive.google.com/drive/folders/1AoKxe5sXzfx5hhPJMNTVHZd86SyBa3am?usp=sharing\n\n« 構図»\n・先生の描かれるイラストが好きなので、ポーズや構図は先生にお任せいたします。\n・服装に関しては衣装を変える場合は露出はそこまで多くないものでお願いいたします。\n・雰囲気は色気のある感じあざとい感じにして頂きたいです。\n\n以上になります。\nご検討頂けますと幸いです。\n\nよろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/1AoKxe5sXzfx5hhPJMNTVHZd8