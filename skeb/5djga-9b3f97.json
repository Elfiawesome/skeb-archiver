ビクビクしながら過ごしています。氷室落はその反対で毎日一緒に居られることが心底嬉しく、絶対に離してやらないとも思っています。\n氷室落→→→→→→→→→→←青羽るり\nのような感情構成です。\n\n服装\nおまかせでお願いしたいのですが\n青羽るり｢ボーイッシュ スキニー｣\n氷室落｢サブカル 地雷｣\nと検索すると出てくるような服装が希望です。\nまた、氷室落の服装が半袖の場合、見える左腕には\"手首から肩までのアムカ跡\"の描写をお願いしたいです。\n\n描写範囲について\nできれば見切れがないと嬉しいです…！\n\n雰囲気\n暗め、絶望、救いようのないような……\n\nふたりのモチーフ\n氷室落\nカミソリ、美少女アニメのグッズ、小説\n青羽るり\nノートPC、青いバラ\n\n指定がありましても、難しければ本当になんでも大丈夫です。また、細かいものはすべておまかせします。買い物帰りでも、鼻血を垂らしていても、汚くても、なんでも大丈夫です！\n長々と失礼しました。ご検討の程よろしくお願いします！\n\nhttps://imgur.com/a/D2Deabp", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@5djga/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2606657, "client_id": 1314790, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/addd34a9/uploads/origins/40d5fbc0-b1e6-4442-8caf-ccee89b68043?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a1f19e48b32e6f7401a9adf9f547a746", "srcset": "https://si.imgix.net/addd34a9/uploads/origins/40d5fbc0-b1e6-4442-8caf-ccee89b68043?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a1f19e48b32e6f7401a9adf9f547a746, https://si.imgix.net/addd34a9/uploads/origins/40d5fbc0-b1e6-4442-8caf-ccee89b68043?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=6a40933f36a22ee7338c87e90fa57f4d 2x, https://si.imgix.net/addd34a9/uploads/origins/40d5fbc0-b1e6-4442-8caf-ccee89b68043?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c7664b5db64e54454d910a571795eca6 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/addd34a9/uploads/origins/40d5fbc0-b1e6-4442-8caf-ccee89b68043?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3e80ba18780e932729ac899184d6c142", "srcset": "https://si.imgix.net/addd34a9/uploads/origins/40d5fbc0-b1e6-4442-8caf-ccee89b68043?bg=%23fff&auto=format%2Ccom