&fm=webp&auto=compress&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=5fab1d27ebe0d8f506b27fe06756bd11 3x"}, "body": "先日はリクエストに応えて頂きましてありがとうございました。\nまた依頼させて頂きたいのですが、とっとこハム太郎のかぶるくんとパンダくんが兜合わせをしてるイラストをお願いします。構図はお任せしますが、別窓やアングル等でなるべく性器部分（性器はかぶるくんの方がやや小さめで、先端部分が同じくらいの位置になるようにお願いします）と二人の表情が見えるようにお願いします。表情は以前依頼しましたかぶるくんと同じような感じでお願いします。そして差分としまして、二人が同時にイク場面をお願いします。かぶるくんは前回同様空イキ、パンダくんは射精（かぶるくんの顔面等にかかる）でお願いします。また、イッた後かぶるくんは射精を目の当たりにして「すごーい」と目を輝かせ、パンダくんは照れくさそうな表情でお願いします。\n以上の内容で、細かくなってしまいましたがお願いします。", "nc": 169, "word_count": 0, "transcoder": "video", "creator_acceptable_same_genre": false}, {"path": "/@harusupu/works/8", "private_thumbnail_image_urls": null, "private": false, "genre": "video", "tipped": true, "creator_id": 2887363, "client_id": 1010849, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/1d172c8d/uploads/outputs/430672e0-e459-4098-9ba2-8bb3f3c7da0a?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&s=999f4242e6ab9cbecb1f31f6db2d053e", "srcset": "https://si.imgix.net/1d172c8d/uploads/outputs/430672e0-e459-4098-9ba2-8bb3f3c7da0a?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&s=999f4242e6ab9cbecb1f31f6db2d053e, https://si.imgix.net/1d172c8d/uploads/outputs/430672e0-e459-4098-9ba2-8bb3f3c7da0a?bg=%23fff&fm=webp&auto=compress&dpr=2&fit=crop&crop=top&w=200&h=200&s=bd4695c9044098124cb1f72ddd01ca92 2x, https://si.imgix.net/1d172c8d/uploads/outputs/430672e0-e459-4098-9ba2-8bb3f3c7da0a?bg=%23fff&fm=webp&auto=compress&dpr=3&fit=crop&crop=top&w=200&h=200&s=cba2166be043e83de911efa3e88d3e4c 3x"}, "duration": 19, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/1d172c8d/uploads/outputs/430672e0-e459-4098-9ba2-8bb3f3c7da0a?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&blur=200&s=e23565fb0fc0c7164e92c73eeaf9161f", "srcset": "https://si.imgix.net/1d172c8d/uploads/outputs/430672e0-e459-4098-9ba2-8bb3f3c7da0a?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&blur=200&s=e23565fb0fc0c7164e92c73eeaf9161f, https://si.imgix.net/1d172c8d/uploads/outputs/430672e0-e459-4098-9ba2-8bb3f3c7da0a?bg=%23fff&fm=webp&auto=compress&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=64670818a0a36adb5395a1795c0b6bd3 2x, https://si.imgix.net/1d172c8d/uploads/outputs/430672e0-e459-4098-9ba2-8bb3f3c7da0a?bg=%23fff&fm=webp&auto=compress&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=6e598eefa02b34604d596f6ae49b8cda 3x"}, "body": "体格差の大きなものになってしまいますが、ポジフォルムのチェリム♀がグラードン♂とセックスしているところをお願いします。\n\nグラードンの視点から見ているイメージで、グラードンの身体はちんちんと下腹部の灰色の部分、手の爪だけが映っています。\nちんちんの大きさはチェリムの身長くらいあり、先端部分がチェリムの膣内に入っていて、チェリムの足はグラードンの身体に届いていない状態です。\nグラードンは両手の爪でチェリムの手を摘むようにして持ち、チェリムもグラードンの爪を手を繋ぐようにして掴んでいます。\n\n【ムービーの流れ】\n①\nグラードンが腰を動かし、チェリムは涙目になりながら気持ち良さそうにグラードンの動きに身を任せている様子です。\n↓\n②\nグラードンの動きが早くなり、チェリムは気持ち良さに両目を閉じて喘いでいます。\n↓\n③\nグラードンがチェリムに深く挿入して射精し、チェリムは嬉しそうに精液を受け入れています。\n精液の量が多くチェリムは全部受け止めきれず、外に溢れてしまっています。\n\n以上です、よろしくお願い致します。", "nc": 177, "word_count": 0, "transcoder": "video", "creator_acceptable_same_genre": false}, {"path": "/@harusupu/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "video", "tipped": true, "creator_id": 2887363, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/b8c5264b/uploads/outputs/02f6ff00-819c-437d-9a5c-4d3ea7bd5281?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&s=52ae4c6d9a74e272b2ddd070b5b3e323", "srcset": "https://si.imgix.net/b8c5264b/uploads/outputs/02f6ff00-819c-437d-9a5c-4d3ea7bd5281?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&s=52ae4c6d9a74e272b2ddd070b5b3e323, https://si.imgix.net/b8c5264b/uploads/outputs/02f6ff00-819c-437d-9a5c-4d3ea7bd5281?bg=%23fff&fm=webp&auto=compress&dpr=2&fit=crop&crop=top&w=200&h=200&s=1d4b7fe7a95a7d39ccb0c68ad3abb459 2x, https://si.imgix.net/b8c5264b/uploads/outputs/02f6ff00-819c-437d-9a5c-4d3ea7bd5281?bg=%23fff&fm=webp&auto=compress&dpr=3&fit=crop&crop=top&w=200&h=200&s=1f2fc3eaff685cbbbcf80496937e8636 3x"}, "duration": 1, "nsfw": tru