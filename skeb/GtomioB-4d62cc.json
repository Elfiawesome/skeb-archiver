について不確かなところがありましたら、自由に書き直して創作してください。\n可能でしたら宛名とサイン、漫画のセリフなど文章の部分はpsdレイヤーでon/offできると嬉しいです。\nまた、先生が下書きや未使用のrkgkなどを作品に残しておいてくださると、アイデアの変遷を見ることができるのでありがたいです！（ただし、これは必須ではありません）\n\nご依頼をお読みいただき、ご検討くださり誠にありがとうございます！\nお気に召さない場合は、遠慮なく直接キャンセルしてください。\n\nhttps://drive.google.com/drive/folders/1QPGw2z6F0JgM2FK8NcxRZzZWxwDb5wzG?usp=sharing", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@GtomioB/works/8", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/bf238c49/uploads/origins/4b290a02-a9c0-48e9-90d5-76758043ce49?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=0e8acfee6eed92e68c927a9111fe8492", "srcset": "https://si.imgix.net/bf238c49/uploads/origins/4b290a02-a9c0-48e9-90d5-76758043ce49?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=0e8acfee6eed92e68c927a9111fe8492, https://si.imgix.net/bf238c49/uploads/origins/4b290a02-a9c0-48e9-90d5-76758043ce49?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=4e38efaec6ba0378045092079bc2a163 2x, https://si.imgix.net/bf238c49/uploads/origins/4b290a02-a9c0-48e9-90d5-76758043ce49?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=9bbc3eb266a9b7146f39927da93c7608 3x"}, "private": true, "genre": "art", "tipped": true, "creator_id": 3423856, "nc": 144}, {"path": "/@GtomioB/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3423856, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/f29f73a5/uploads/origins/d78d4529-7cac-40ec-9997-40