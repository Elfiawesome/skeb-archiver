らない範囲でご判断いただければと存じます。\n\n上記内容でご検討いただき、もしお受けいただけるようでしたら大変幸いに存じます。\nこうちゃん🍃様にご縁をいただけましたら、これ以上嬉しいことはございません。\n宜しくお願い致します。\n\nhttps://drive.google.com/drive/folders/1CIGdZlqzpUOSynzE21vmH-3uprR0oSaR?usp=drive_link", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@kouchanthree/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3171123, "client_id": 2690863, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/9fcb4242/uploads/origins/8b069617-1418-40ae-b432-c27ce663cf7c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8f8fd45e0de00bac32917efb70bfc63a", "srcset": "https://si.imgix.net/9fcb4242/uploads/origins/8b069617-1418-40ae-b432-c27ce663cf7c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8f8fd45e0de00bac32917efb70bfc63a, https://si.imgix.net/9fcb4242/uploads/origins/8b069617-1418-40ae-b432-c27ce663cf7c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=cf8330ccdbc4d7224f007ee671f1d258 2x, https://si.imgix.net/9fcb4242/uploads/origins/8b069617-1418-40ae-b432-c27ce663cf7c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=114a30b95f12df63a8117e5bd7c14915 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/9fcb4242/uploads/origins/8b069617-1418-40ae-b432-c27ce663cf7c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b8e75547faf9f6537901ffbf7c55591f", "srcset": "https://si.imgix.net/9fcb4242/uploads/origins/8b069617-1418-40ae-b432-c27ce663cf7c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b8e75547faf9f6537901ffbf7c55591f, https://si.imgix.net/9fcb4242/uploads/origins/8b069617-1418-40ae-b432-c27ce663cf7c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=94adacc18a416bb