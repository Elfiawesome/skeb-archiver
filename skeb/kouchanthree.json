n\nもしご縁がございましたら、こうちゃん🍃様の絵柄でぜひ描いていただければと思います！\n\nご検討よろしくお願いいたします！", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 378323, "creator": true, "nsfw_acceptable": false, "acceptable": false, "name": "🌸井", "screen_name": "CATS_NAL", "avatar_url": "https://www.gravatar.com/avatar/?d=identicon", "header_url": null, "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "art"}, {"genre": "correction"}], "nc": 129}, {"id": 665527, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "いよかん椛", "screen_name": "momomomomiZ", "avatar_url": "https://pbs.twimg.com/profile_images/1722122298487087104/u6dY9Uuj.jpg", "header_url": "https://pbs.twimg.com/profile_banners/763339935965335554/1655865470/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 10, "complete_expiration_days": 60, "skills": [{"genre": "art"}], "nc": 145}, {"id": 882528, "creator": true, "nsfw_acceptable": false, "acceptable": false, "name": "ほっとけ虚無太郎", "screen_name": "kyomutaro___", "avatar_url": "https://www.gravatar.com/avatar/?d=identicon", "header_url": null, "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 90, "skills": [{"genre": "art"}], "nc": 176}, {"id": 1232726, "creator": true, "nsfw_acceptable": false, "acceptable": false, "name": "真白いのり🐟", "screen_name": "Masiro_Inori", "avatar_url": "https://pbs.twimg.com/profile_images/1431668155978436615/Yi95fn9_.jpg", "header_url": "https://pbs.twimg.co