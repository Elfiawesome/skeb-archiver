si.imgix.net/7d84c23c/uploads/origins/c5189bf1-694d-42f3-b147-11b6540fc14f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=aa8765f639866916663b02c43ae3fb34, https://si.imgix.net/7d84c23c/uploads/origins/c5189bf1-694d-42f3-b147-11b6540fc14f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=eec9e44b198edbc5a483d64cfa00fb5e 2x, https://si.imgix.net/7d84c23c/uploads/origins/c5189bf1-694d-42f3-b147-11b6540fc14f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=b0e2f1bf185e025e39349deb9de4f119 3x"}, "body": "初めまして。\nリクエスト失礼します。\n良ければ私の創作キャラを描いていただきたいです…！\n\n以下簡単な説明になります。\n\n名前:シャクヤク\nフリーターを経て裏社会に転がり込んだ、明るい性格の男性。\n・どこか掴みどころがなく、謎に包まれている節がある。\n・まだまだ転がり込みたてなので、組織の下っ端(構成員の数十人をまとめあげる程度)だがボスのお気に入りでもある。\n・服に無頓着なためボスが買ってきた服を何となく着ている。\n・隠し持ったナイフと銃を仕事で使うのが好き。\n・夜〜明け方に活動している。\n\n絵師様のキャラの魅力を引き出す表情の描き方や構図、光の表現がとても好きです…！\nぜひ好きなように描いてください！\n服の着方等も変えて大丈夫です。\n\n使用用途 : 鑑賞用、スマホの壁紙\n\n検討していただけますと幸いです。\nよろしくお願いします。\n\nhttps://drive.google.com/drive/folders/1JysAHA3BjtK1JV4uUiy1CEI5cmRC--uu", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@kouchanthree/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3171123, "client_id": 2850616, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/ceb17c00/uploads/origins/93b1ca5b-1253-4d2f-935d-731b2c0928d7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9be24850e6f5907ddbc48722721c068e", "srcset": "https://si.imgix.net/ceb17c00/uploads/origins/93b1ca5b-1253-4d2f-935d-731b2c0928d7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9be24850e6f5907ddbc48722721c068e, https://si.imgix.net/ceb17c00/uploads/origins/93b1ca5b-1253-4d2f-935d-731b2c0928d7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=8ffe3ed206a96b0ef9bf11cd402602e4 2x, https://si.i