r&txtsize=30&txt=PRIVATE&s=b345616ca15b12aad220556b0e5d32e7 3x"}, "private": true, "genre": "art", "tipped": false, "creator_id": 2008544, "nc": 17}, {"path": "/@ne_rucobig/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2008544, "client_id": 2156831, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/41fe4883/uploads/origins/e5eddf69-4dcc-4410-bae2-d65fde079584?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6417962431dff5eaa1328de4ee7c088c", "srcset": "https://si.imgix.net/41fe4883/uploads/origins/e5eddf69-4dcc-4410-bae2-d65fde079584?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6417962431dff5eaa1328de4ee7c088c, https://si.imgix.net/41fe4883/uploads/origins/e5eddf69-4dcc-4410-bae2-d65fde079584?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=2aa78b5ae134c98f8034aec19159a97e 2x, https://si.imgix.net/41fe4883/uploads/origins/e5eddf69-4dcc-4410-bae2-d65fde079584?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=9a7683368e1237f4d94de1981133afa8 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/41fe4883/uploads/origins/e5eddf69-4dcc-4410-bae2-d65fde079584?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=88b8a2878cf5f1985031bfb90832cde7", "srcset": "https://si.imgix.net/41fe4883/uploads/origins/e5eddf69-4dcc-4410-bae2-d65fde079584?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=88b8a2878cf5f1985031bfb90832cde7, https://si.imgix.net/41fe4883/uploads/origins/e5eddf69-4dcc-4410-bae2-d65fde079584?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=60eda1e82f8d4411fc11c23d1887ca8e 2x, https://si.imgix.net/41fe4883/uploads/origins/e5eddf69-4dcc-4410-bae2-d65fde079584?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=8f1ead7f28a9cd0a23e41773734bef46 3x"}, "body": "こんにちは！お邪魔します。あなたの画風にとても好きです、COCTRPGをベースにした私のオリジナルキャラクターを描いていただけないかと思い、このスケブ依頼を送らせていただきました。\n\nキャラクター1-アルベリヒ(男)\n彼は真の天才である。生体測定研究所のリーダーであるだけでなく、何千もの非道徳的な実験も手がけてきた。しかし、これは彼が最先端の科学研究者であり、未知の技術を探求することを何よりも、命よりも重要視していることを示しているに過ぎない。科学研究になると道徳心を失う。\n自分の理論を批判されたキャラクター2に一目惚れし、すぐに結婚。登場人物2に実験のことをどう伝えるか考えており、きちんと説明すれば科学者として受け入れてもらえると信じている。\n\n登場人物2-カラン（女）\n伝統的で古風な学者で努力家。心の底から、世の中の生活をより良くするために研究をしている。同時に夫を心から愛しており、2人はかなり幸せな生活を送っていた。科学という名の怪物に支配されたキャラクター1が、非人道的な実験を繰り返してきたことを受け入れられない。同時に、夫を救えなかった自分を許せず、自殺を選んだ。\n\n今回の依頼では、何でも自由に描いてください！\nリクエストを読んでいただき、ありがとうございました！\n\nhttps://drive.google.com/drive/folders/1-hkV5fyKmrAMYDAAviNfh28psqwlC8wk", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@ne_rucobig/works/6", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/f22520bf/uploads/origins/07029f6f-9586-467b-8712-9916eb762c58?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=53e35efa9e636a20ba3e2fd8f5cee0ab", "srcset": "https://si.imgix.net/f22520bf/uploads/origins/07029f6f-9586-467b-8712-9916eb762c58?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=53e35efa9e636a20ba3e2fd8f5cee0ab, https://si.imgix.net/f22520bf/uploads/origins/07029f6f-9586-467b-8712-9916eb762c58?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=bde6370c941a1d69e9210a3460fec14e 2x, https://si.imgix.net/f22520bf/uploads/origins/07029f6f-9586-467b-8712-9916eb762c58?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&t