eptable_same_genre": false}, {"path": "/@ne_rucobig/works/12", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2008544, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/706589bc/uploads/origins/87a1bffc-af1d-497e-8f32-a7bea56c1c4b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7a78ea572f66c8d9fea9770ce5a0dabe", "srcset": "https://si.imgix.net/706589bc/uploads/origins/87a1bffc-af1d-497e-8f32-a7bea56c1c4b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7a78ea572f66c8d9fea9770ce5a0dabe, https://si.imgix.net/706589bc/uploads/origins/87a1bffc-af1d-497e-8f32-a7bea56c1c4b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=3eaa5f1e35a8a21a0c452ed160c09e56 2x, https://si.imgix.net/706589bc/uploads/origins/87a1bffc-af1d-497e-8f32-a7bea56c1c4b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d54fded64272e976c2cea89ec3ec59b7 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/706589bc/uploads/origins/87a1bffc-af1d-497e-8f32-a7bea56c1c4b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=96d5237e18ff151e6c0dce5d47f2a906", "srcset": "https://si.imgix.net/706589bc/uploads/origins/87a1bffc-af1d-497e-8f32-a7bea56c1c4b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=96d5237e18ff151e6c0dce5d47f2a906, https://si.imgix.net/706589bc/uploads/origins/87a1bffc-af1d-497e-8f32-a7bea56c1c4b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=9ace80300fbf76f4e56ca708e6319211 2x, https://si.imgix.net/706589bc/uploads/origins/87a1bffc-af1d-497e-8f32-a7bea56c1c4b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=a6110021afe367fa3e6ee2369d69a864 3x"}, "body": "はじめまして。skeb再開を楽しみにしておりました！是非自分と友人のOCたちのワンシーンを描いていただきたく、リクエストさせていただきます。\n使用用途は個人観賞/個人のみで持つ冊子への印刷のほか、友人に作品を共有させていただけたら嬉しいです。（自作発言や商用利用はしません）\n\n外見情報含め資料がありますが、こちらでも記載させていただきます。\n特に複数人で描かれるものが空気感含めとても好きなので、TRPGの探索者たちをぜひリクエストさせていただければと思います。（私とフォロワーさんの探索者の二人です）\n\n二人は恋人同士で、それぞれ怪奇小説家とそのアシスタントをしています。\n共依存的な関係にあり、お互い過去や家族に対しての後ろめたい気持ちを持っていますが、二人きりの時間を大切にしています。\n\n具体的な資料は下記をご参照いただけますと幸いです。\nhttps://drive.google.com/drive/folders/12mIfaiDWfLcHIzzic_UefunrF3Chg0pZ?usp=sharing\n\n衣服の仔細や不明点などはお好きにご変更くださって構いませんし、描きにくければオリジナルの衣装にしていただいても嬉しいです。\nサイズ等も特に指定はございませんので、お好きに描いてくださればと思います。\n\nここまでお読みくださりありがとうございます。今後ともこっそり楽しみにしております！\n\nhttps://drive.google.com/drive/folders/12mIfaiDWfLcHIzzic_UefunrF3Chg0pZ?usp=sharing", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@ne_rucobig/works/11", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2008544, "client_id": 1641782, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/f36dd994/uploads/origins/2c3a8e62-7406-4aa2-8db3-c680a209ae22?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=281129bdd9982b5b12f049bb9a4d9b17", "srcset": "https://si.imgix.net/f36dd994/uploads/origins/2c3a8e62-7406-4aa2-8db3-c680a209ae22?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=281129bdd9982b5b12f049bb9a4d9b17, https://si.imgix.net/f36dd994/uploads/origins/2c3a8e62-7406-4aa2-8db3-c680a209ae22?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=37d4791cedd674c531ebf01e1aed2a9f 2x, https://si.imgix.net/f36dd994/uploads/origins/2c3a8e62-7406-4aa2-8db3-c680a209ae22?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e5edc20f852b53bb48cf491cc491b7a3 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/f36dd994/uploads/origins/2c3a8e62-7406-4aa2-8db3-c680a209ae22?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h