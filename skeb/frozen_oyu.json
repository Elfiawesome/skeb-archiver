b-8c7a-e439e8c9a94b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9c77e3b5fa0e5a6c4854c78d413bf005", "src_set": ""}, "body": "こんにちは。\n\n運動後にスポーツブラ姿でセックスしている我が子JDちゃんを描いてください。\n\nリクエストをお読みいただきありがとうございます。\n\nhttps://drive.google.com/drive/folders/1HXx8iJMNTdIX2ey0yWje1tzmPthmaN2h", "nc": 160, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@frozen_oyu/works/267", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1314461, "client_id": 0, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/68f3a4b1/uploads/origins/bec19638-02ec-446e-91c5-2be141d1431e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=66fb81284395c98bebdd62354f4c579f", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/68f3a4b1/uploads/origins/bec19638-02ec-446e-91c5-2be141d1431e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=387c310888c95ec3a40088a177f1734f", "src_set": ""}, "body": "前回うちの子(https://skeb.jp/@frozen_oyu/works/249)をありがとうございました……\nドチャシコで最高でしたので良ければまたリクエストさせてください！\n\nこちらの作品(https://skeb.jp/@frozen_oyu/works/211)の様な体勢でじっくりねっとり手マンされ続けて野太い声をあげながらイッてしまう様子をお願いしたいです！\n最初は「うっ……おっ……♡」等感じ初めて、続けて獣の様な喘ぎ声を出し続けて最後は溜まりに溜まった物を全て吐き出す様な手マンでイキ乱れる様子をお願いしますー！！\n\n名前:アヤネ　\n職業:公安警察(警部)\n年齢:26歳　身長171cm 体重60kg\nアヤカの姉であり警察のキャリア組で若くして公安で警部になったバリキャリ女性。アヤカが海外で拉致られ行方不明になったりテロに巻き込まれ恋人(同僚)を亡くしたりと心苦しく過ごしていた。\nアヤカが公安管轄の仕事に就き一緒に日本の治安を守っていく事を望んでいたが、現在アヤカが傭兵組織の一員として働いている事を知り袂を分つ。\n警察官の柔道大会では女性全国1位の実力者で射撃も上手い武闘派の人間。\n\n人物像:右目に泣きぼくろアリ。部下や上司から信頼されているが、武闘派寄りな人間であり犯人には容赦しない一面もある。\n\nhttps://skeb.jp/@pitwpitw1111/works/133\n\nhttps://skeb.jp/@is_eeeee/works/6", "nc": 49, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@frozen_oyu/works/266", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1314461, "client_id": 747378, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/cdfe6520/uploads/origins/ed49232f-0f7c-4fea-bcb1-9381ccf362b0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=663f34b54c0db0c2a037b68f9f368e53", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/cdfe6520/uploads/origins/ed49232f-0f7c-4fea-bcb1-9381ccf362b0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=78a92ccd25981cbcb00ac66adffc4472", "src_set": ""}, "body": "冷凍お風呂様\n \nお世話になっております。\nツイ・・・X、pixivならびにニジエでのイラストを拝見させていただいております。\n \n前回はイチカちゃんと大河先生のイラストをありがとうございました。自分の衝動にアクセル全開で逃がす気ゼロのイチカちゃんが見られてよかったです。\nリクエストを募集いただいているということで、弊シャーレの女先生こと大河先生のR18イラストをまたお願いさせていただきたく思います。\n \n私、過去skebでお描きいただいているベレス先生などの事前事後のイラストたちが好きでして、同様のことを大河先生でできないかと考えておりました。\n \n \n【依頼】\n・いわゆる事前事後のイラストをお願いしたいです。\n・相手は水着の月雪ミヤコちゃんでお願いします。\n \n・先生は今後の対策として「尋問の訓練を体感させてほしい」とミヤコちゃんに依頼しており、ラッシュガードに競泳水着を着ています。「ところでなんで水着・・・？」なんてセリフが端のほうにあると嬉しいです。\n水着は以下のリンクに資料を追加しておりますので、ご確認いただければ幸いです。\n\n・ミヤコちゃんは事前の段階でNSFWな尋問をする気満々で、もじもじしていてほしいです。\n \n・事後ではミヤコちゃんにめちょめちょにされた大河先生が「もうちょっと勉強しておきたい」と言っています。顔やら髪やら胸やら股の間やら遠慮なくベトベトにしていただけると嬉しいです。\n・ミヤコちゃんはツヤツヤしていて、RABBIT隊員に何をしたか察されていると嬉しいです。\n \n女先生と生え徒概念に共感するものとして、冷凍お風呂様の手で具現化いただき、またご賞味いただければ幸いです。ご検討をよろしくお願いします。\n\nhttps://drive.google.com/drive/folders/1YFnbXx-KSrAnQTOGpmjffUgpQq1YoP_A?usp=sharing", "nc": 40, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@frozen_oyu/works/265", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/fdbf1f41/uploads/origins/2ea28d1a-a4c4-453c-9623-697f397b4add?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=0dff39c567240af11c9b4b6818632a6a", "src_set": ""}, "private": true, "genre": "art", "tipped": true, "cr