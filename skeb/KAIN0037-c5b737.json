ue}, {"path": "/@KAIN0037/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 372201, "client_id": 1169960, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/9f94d9b4/uploads/origins/fc94edad-6048-4644-99b9-71146b61f33c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b843b07bbb38013d2c31139242f81771", "srcset": "https://si.imgix.net/9f94d9b4/uploads/origins/fc94edad-6048-4644-99b9-71146b61f33c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b843b07bbb38013d2c31139242f81771, https://si.imgix.net/9f94d9b4/uploads/origins/fc94edad-6048-4644-99b9-71146b61f33c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=665eeb901ffb32839a86a76f1330df58 2x, https://si.imgix.net/9f94d9b4/uploads/origins/fc94edad-6048-4644-99b9-71146b61f33c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=57591422c2b515664c3f6f28253b734d 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/9f94d9b4/uploads/origins/fc94edad-6048-4644-99b9-71146b61f33c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f2ebe60bc738d28841f61dfae174b977", "srcset": "https://si.imgix.net/9f94d9b4/uploads/origins/fc94edad-6048-4644-99b9-71146b61f33c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f2ebe60bc738d28841f61dfae174b977, https://si.imgix.net/9f94d9b4/uploads/origins/fc94edad-6048-4644-99b9-71146b61f33c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=3173478e20432cbc2f744447944725a0 2x, https://si.imgix.net/9f94d9b4/uploads/origins/fc94edad-6048-4644-99b9-71146b61f33c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=e3b7bc114f30538a229eac20fa471160 3x"}, "body": "こんにちは。ラブライブの矢澤にことRe:ステージの長谷川みいのツーショットイラストを依頼させてください。衣装は\n・矢澤にこ … 「僕らのlive 君とのlife」衣装\n　（参考：https://i.kfs.io/album/global/41643675,0v1/fit/500x500.jpg ）\n・長谷川みい … キービジュアル衣装\n　（参考：https://ogre.natalie.mu/media/news/comic/2019/0602/KeyVisual02web.jpg　)\nでお願いします。\n\n場面設定は、μ'sとKiRaReの合同ライブ後に、ステージを背景に二人が肩を組んでいるというものでお願いします。\n構図は、舞台袖の後ろからステージの光が差し込んでいるというものでお願いします。ごく簡単でよいので、光は二人のサイリウムの光の色（グリーン、ピンク）が入っていると嬉しいです。\nポージングは基本的にお任せしますが、矢澤にこの片手はいわゆる「にこにこにー」のポーズにしてください。長谷川みいはピースでもグーを上げているポーズでもよいです。\n\n用途は主にスマホの壁紙を想定しておりますので、縦書き16:9でお願いします。\n\n念の為、追加の参考資料のリンクを添えておきます。リステは、以下１つ目のリンクで公式原画が参照できます。長谷川みいの当該衣装のものもあります(リンク２つ目)。\n・https://twitter.com/i/events/1146382292924817408\n・https://twitter.com/rst_project/status/1155470517530517507\n\n以上、よろしくお願いいたします。", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@KAIN0037/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 372201, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/f9539211/uploads/origins/1339ea7b-cb72-4d4a-a743-76b03b52959c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5a67b4865adbddf9eec3c06de7d71938", "srcset": "https://si.imgix.net/f9539211/uploads/origins/1339ea7b-cb72-4d4a-a743-76b03b52959c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5a67b4865adbddf9eec3c06de7d71938, https://si.imgix.net/f9539211/uploads/origins/1339ea7b-cb72-4d4a-a743-76b03b52959c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b8e2f5a2b2cec8e9f2255bf679050ac4 2x, https://si.imgix.net/f9539211/uploads/origins/1339ea7b-cb72-4d4a-a743-76b03b52959c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=79685adfa4df9e898eede25a28eea29f 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/f9539211/uploads/origins/1339ea7b-cb72-4d4a-a743-76b03b52959c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=20