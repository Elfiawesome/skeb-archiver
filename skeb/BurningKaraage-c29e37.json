ee-393a-4498-a936-23596db6f88d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d9822e2c92589a692030a21fb9d316b4", "srcset": "https://si.imgix.net/14ecf778/uploads/origins/2c82b7ee-393a-4498-a936-23596db6f88d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d9822e2c92589a692030a21fb9d316b4, https://si.imgix.net/14ecf778/uploads/origins/2c82b7ee-393a-4498-a936-23596db6f88d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=d2f1b7f4e376822aed1456998467e952 2x, https://si.imgix.net/14ecf778/uploads/origins/2c82b7ee-393a-4498-a936-23596db6f88d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=16b31b17aa48c0a8672ef64420c9a78e 3x"}, "body": "リクエストさせていただきます。\nこちらのオリキャラのイラスト【https://x.com/burningkaraage/status/1895045347317293162?s=46&t=qgSRMREM-yMCKXqN2PG5aw】みたいな感じの立ち絵＋ローアングル視点のイラストが大好きなんで、同じような構図で続きのプチイラスト集みたいなやつを作ってくれませんか？\nローターとアナルプラグを仕込んだ状態で学校生活している感じの内容で、パンツの染みが徐々に増えていく感じでお願いしたいです。\n平然と日常生活しているのにスカートの中はえぐいことになっている感じが好きです！\nよろしくお願いします。", "nc": 32, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@BurningKaraage/works/10", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1146667, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/c63feeef/uploads/origins/7b29134e-41b4-4033-9158-c04173b5a0b7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c229cb42b6ced68383ebb15dcfe8ca48", "srcset": "https://si.imgix.net/c63feeef/uploads/origins/7b29134e-41b4-4033-9158-c04173b5a0b7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c229cb42b6ced68383ebb15dcfe8ca48, https://si.imgix.net/c63feeef/uploads/origins/7b29134e-41b4-4033-9158-c04173b5a0b7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c7bd904b666323a7ff9bdc2320afa358 2x, https://si.imgix.net/c63feeef/uploads/origins/7b29134e-41b4-4033-9158-c04173b5a0b7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=4aee3d300adaf274c7866ede2cf3f1e9 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/c63feeef/uploads/origins/7b29134e-41b4-4033-9158-c04173b5a0b7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=7c17d0245929d6697d4cb689f7ffa9aa", "srcset": "https://si.imgix.net/c63feeef/uploads/origins/7b29134e-41b4-4033-9158-c04173b5a0b7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=7c17d0245929d6697d4cb689f7ffa9aa, https://si.imgix.net/c63feeef/uploads/origins/7b29134e-41b4-4033-9158-c04173b5a0b7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=1625b0079b328494a16fff66fa1fb4ea 2x, https://si.imgix.net/c63feeef/uploads/origins/7b29134e-41b4-4033-9158-c04173b5a0b7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=f7dc51e22b027dd8f75e2dbc98e4fa27 3x"}, "body": "この度はアヤメと不知火の素晴らしいイラストありがとうございます。あまりのエロさに思わず昇天してしまいました。\n\nさて、リピート依頼で恐縮ですが、お描きいただいたアヤメと不知火のイラスト左下コマの、「眠り姫のように寝かせられるアヤメ。その傍で満足気な表情で添い寝をする不知火。」を全体が描かれた1枚絵で作成をお願い致します。お描きいただいたイラストが素晴らしすぎて、全体絵でぜひ見たいと思った次第です。\nなお、アヤメの顔と身体が見えるよう、以下参考画像の角度でお願い致します\nhttps://skeb.jp/@Nin18U/works/100\n\nまた、アヤメの衣装差分で水着姿をお願い致します。\nillust/97246587\n（１枚目の水着姿）\n\nご多忙の所恐縮ですが、ご検討頂ければ幸いです。", "nc": 160, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@BurningKaraage/works/9", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1146667, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/5542c797/uploads/origins/224eb160-5198-4bfd-8abc-679d5c660c11?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6e2b623d7ec068d5e1915c9b3f5e4ebc", "srcset": "https://si.imgix.net/5542c797/uploads/origins/224eb160-5198-4bfd-8abc-679d5c660c11?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6e2b623d7ec068d5e1915c9b3f5e4ebc, https://si.imgix.net/5542c797/uploads/origins/224eb160-5198-4bfd-8abc-679d5c660c11?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=db19edc8240e8564c93a483a78c4ad31 2x, https://si.imgix.net/5542c797/uploads/origins/224eb160-5198-4bfd-8abc-679d5c660c11?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=782a0d6b532f9b9ee732be9fc3158602 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/5542c797/uploads/origins/224eb160-5198-4bfd-8abc-679d5c660c11?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c58725b159285b67849012979872c43e", "srcset": "https://si.imgix.net/5542c797/uploads/origins/224eb160-5198-4bfd-8abc-679d5c660c11?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c58725b159285b67849012979872c43e, https://si.imgix.net/5542c797/uploads/origins/224eb160-5198-4bfd-8abc-679d5c660c11?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=5ed80d8fad8877996ecd18c73f5f8b9c 2x, https://si.imgix.net/5542c797/uploads/origins/224eb160-5198-4bfd-8abc-679d5c660c11?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=3c6ce8ba7702e5cea913d9c586b7f84b 3x"}, "body": "いつも素晴らしいイラストありがとうございます。\nリクエスト失礼致します。 『忍者戦隊カクレンジャー 』の花のくノ一組のアヤメと、対魔忍シリーズの水城不知火のレズ風カラーイラストをお願いいたします。  \nシュチュエーションはくノ一同士の生死をかけたレズバトルで勝者は不知火。敗者はアヤメ。  \n\nシーン① アヤメの背後から、乳首をもみトドメを刺す不知火。アヤメはスーツ越しに母乳を吹き出し絶頂して昇天。  \n\nシーン② アヤメの身体をベッドに寝かせて、アヤメと身体を重ねsexをする不知火。皮肉にも仕留めた獲物に完全に恋をしてしまった。 （アヤメの身体は不知火の忍法で朽ちることなく永遠の美と肌の温もりが保たれているという設定）  \n\nシーン③最後は、死化粧を施され、眠り姫のように寝かせられるアヤメ。その傍で満足気な表情で添い寝をする不知火。  \n\nグロではなく、ソフトリョナの百合・レズ的なイメージでお願いいたします。\n ・基本的に両者とも着衣のまま \n・アヤメは変身後のバトルスーツでマスクオフ。\n ・可能であればシーンに応じてセリフを入れて頂ければ幸いです。\n\nアヤメ参考  https://x.com/vogts43267024/status/1812497578426335447?s=46&t=OyqJzg1psdkivfOPYdLE-Q \nご検討頂ければ幸いです。", "nc": 57, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@BurningKaraage/works/8", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1146667, "client_id": 1366155, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/07e397ad/uploads/origins/9742ab77-a791-4141-8c43-0b2c4399ebf8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1ccf2e62cd97285ed35e2d4af2694225", "srcset": "https://si.imgix.net/07e397ad/uploads/origins/9742ab77-a791-4141-8c43-0b2c4399ebf8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1ccf2e62cd97285ed35e2d4af2694225, https://si.imgix.net/07e397ad/uploads/origins/9742ab77-a791-4141-8c43-0b2c4399ebf8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=91b87cb6c3f426c96dddaf63f8a1598c 2x, https://si.imgix.net/07e397ad/uploads/origins/9742ab77-a791-4141-8c43-0b2c4399ebf8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=db19e5dfe896e2611b4e84683bc22d7d 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/07e397ad/uploads/origins/9742ab77-a791-4141-8c43-0b2c4399ebf8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=513191d0218450af23bab8dad074aa7d", "srcset": "https://si.imgix.net/07e397ad/uploads/origins/9742ab77-a791-4141-8c43-0b2c4399ebf8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=513191d0218450af23bab8dad074aa7d, https://si.imgix.net/07e397ad/uploads/origins/9742ab77-a791-4141-8c43-0b2c4399ebf8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=4200b8ddd1f2f5f1fd9876cef0057bc1 2x, https://si.imgix.net/07e397ad/uploads/origins/9742ab77-a791-4141-8c43-0b2c4399ebf8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=c2e019cf48c21932c630654cd6a517de 3x"}, "body": "遊戯王のRAI-MEIとトリックスター・ノーブルエンジェルのフタナリレズセックスをリクエストさせて頂きます\n\n受け:RAI-MEI。生えてない。全身むちむちで乳のサイズは頭より大きく上半身を目一杯覆い、股間がギリギリ見えるくらいの超乳(可能な限り盛って下さい)。ツインテールは腰に届く位の長さ。\n\n竿役:ノーブルエンジェル。RAI-MEIと同様の体型かつ腹ボコ出来そうなサイズの巨根付。\n\n服装は2人とも元のカードのイラストで着ている物で、RAI-MEIは股間が♡型の穴空きで露出勃起した乳首と盛り上がった乳輪が布越しにくっきり浮かび上がっており、ノーブルエンジェルは陰茎がスカートを持ち上げて露出した状態です。体位はRAI-MEIの正面が良く見えるアングルでの正常位で、ノーブルエンジェルの様子はバストアップのワイプをRAI-MEIの横に別枠で写すようお願いします。\n\n挿入前。ノーブルエンジェルが挿入を焦らし、RAI-MEIがそれに対し完全に堕ちきった様子で媚びながら挿入を懇願する。\n↓\n挿入時。ノーブルエンジェルがSッ気のある表情で一気に挿入し、RAI-MEIはその衝撃で間抜けな叫び声を上げ即堕ちアへ顔アクメを晒す。\n↓\n挿入後。激しくピストンしながら二人とも軽めのアへ顔でオホ声混じりの淫語を連発しよがっている。\n↓\n膣内射精&絶頂。二人とも汚い口調で淫語を絶叫しながらイき、白目を剥いたここ一番の変顔に片足突っ込んだアへ顔になる。\n｢トリックスタートークン｣型の精子が卵子に受精するカットインあり。\n\n…という流れで、それぞれに二人のセリフを付けて頂きたいです。キャラの性格や口調はRAI-MEIがくっ殺の似合う隠れマゾなお姉さん系、ノーブルエンジェルはドSでオラつきながらも言葉遣いが上品で、バブみを感じさせるお姉さんといったイメージです。\n\n細かく指定してしまいましたが何卒宜しくお願い致します。\n\nhttps://drive.google.com/drive/folders/1jUv87DsnPJO7pNY_UW8SRfyrto7lmJwm", "nc": 32, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@BurningKaraage/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1146667, "client_id": 1202629, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/80aab227/uploads/origins/cdcf51be-249a-48b5-b526-0b04b67f6166?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5edfeeeb1b4b93d8c691104bb11a999a", "srcset": "https://si.imgix.net/80aab227/uploads/origins/cdcf51be-249a-48b5-b526-0b04b67f6166?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5edfeeeb1b4b93d8c691104bb11a999a, https://si.imgix.net/80aab227/uploads/origins/cdcf51be-249a-48b5-b526-0b04b67f6166?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=5b4ef1afa3c1f1b2a26c6c174c590c46 2x, https://si.imgix.net/80aab227/uploads/origins/cdcf51be-249a-48b5-b526-0b04b67f6166?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e01956e10ef772e045ff849253e5a297 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/80aab227/uploads/origins/cdcf51be-249a-48b5-b526-0b04b67f6166?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5ff61131a3c4db835d86278c8bea0d69", "srcset": "https://si.imgix.net/80aab227/uploads/origins/cdcf51be-249a-48b5-b526-0b04b67f6166?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5ff61131a3c4db835d86278c8bea0d69, https://si.imgix.net/80aab227/uploads/origins/cdcf51be-249a-48b5-b526-0b04b67f6166?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=aa7c2b8798a6bf005741b66665db644b 2x, https://si.imgix.net/80aab227/uploads/origins/cdcf51be-249a-48b5-b526-0b04b67f6166?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=2b841938d96bc7767c61cb91d7099934 3x"}, "body": "初めまして。よろしければリクエストお願いします。\nキャラクター\n対魔忍シリーズより水城不知火\n\nシチュエーション\nふうま（竿役）のフェラチオ後、\n真夏の夜の淫夢４章パロディで野獣先輩が絶頂するところのシーンを水城不知火でお願いします。\n\n詳細\n・竿役は描かなくて良いです\n・フェラチオの際の不知火の表情は臭チンポに顔をしかめながら睨んでる感じで\n・セリフもよろしければお願いします\n・不知火の対魔忍スーツは片胸が破れており、胸が露出している\n・枕はクソデカ枕で\n・挿入時は全身が見える構図でお願いします\n・表情は快楽に屈しない感じで「ハァハァ、アアッ、さっきからイきっぱなしで・・・ンンッ、イキスギイクッ、イクイクイクイク・・・・」\n\n要望\n・可能であればニコニコのコメント風に「頑張れー」、「イキスギィ」「ンアッー(≧д≦)」といった感じのコメントリスト枠もお願いします\n・絶頂時のンアッーの台詞とともに(≧д≦)の顔文字のような表情差分もよろしければお願いします。\n\nhttps://drive.google.com/drive/folders/1jYZcah3AaXDpnqo9W6KCW2oGo_bgnXBH?usp=drive_link", "nc": 49, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@BurningKaraage/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1146667, "client_id": 82839, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/ad691717/uploads/origins/a38bc67c-656b-4c19-8d06-5e014131b9dc?bg=%23fff