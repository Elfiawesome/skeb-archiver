んみたいなイメージです）\n画像はPicrewの「OC Creator」から https://picrew.me/share?cd=kfYd7rFkqT\n\nミア：\n不老不死で年齢不詳の美女。自分に関する記憶が一切なく、ゆく当てもなく世界を放浪している。\n楽観的な性格で死なないこともありなんにでも積極的に首を突っ込む。\nまた放浪中に色々体験したせいか、並大抵以上のことが起きても動揺しない。\n自分のことを忘れている以外は知能が高く、様々な言語を理解し魔術が使える。", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@hekisa_ametrine/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1274937, "client_id": 3464730, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/5f8cda86/uploads/origins/4323a959-a6ff-4878-b5be-ec877deea3b4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4b322cc0782ffa8ab414ee4b9d5ee18e", "srcset": "https://si.imgix.net/5f8cda86/uploads/origins/4323a959-a6ff-4878-b5be-ec877deea3b4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4b322cc0782ffa8ab414ee4b9d5ee18e, https://si.imgix.net/5f8cda86/uploads/origins/4323a959-a6ff-4878-b5be-ec877deea3b4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=07390f952d574309af535f473d6e1161 2x, https://si.imgix.net/5f8cda86/uploads/origins/4323a959-a6ff-4878-b5be-ec877deea3b4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=844acda0a5b4cda85529c4c1424634ff 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/5f8cda86/uploads/origins/4323a959-a6ff-4878-b5be-ec877deea3b4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0536eae3e0e5c98ecf7a4234bd3263c3", "srcset": "https://si.imgix.net/5f8cda86/uploads/origins/4323a959-a6ff-4878-b5be-ec877deea3b4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0536eae3e0e5c98ecf7a4234bd3263c3, https://si.imgix.net/5f8cda86/uploads/origins/4323a959-a6ff-4878-b5be-ec877deea3b4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=20