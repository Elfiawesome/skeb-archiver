8-9b7dea4fa2b6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=55577c2dd0749ead31cefd783b76b73b", "srcset": "https://si.imgix.net/581331a2/uploads/origins/b88d173f-5dcc-48c7-80e8-9b7dea4fa2b6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=55577c2dd0749ead31cefd783b76b73b, https://si.imgix.net/581331a2/uploads/origins/b88d173f-5dcc-48c7-80e8-9b7dea4fa2b6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=a851eda9c4b5e8e8e4939c495fb58b40 2x, https://si.imgix.net/581331a2/uploads/origins/b88d173f-5dcc-48c7-80e8-9b7dea4fa2b6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=1c280116383c24843599eccb24209765 3x"}, "body": "こんにちは。私の友達2人と私はそれぞれ違う遊戯王アニメから好きな女の子がいるので、その3人が一緒に写っている写真をお願いしたいです。キャラクターはArc-Vのセレナ、ゼクサルの神代璃緒、GXの天上院明日香です。一緒にビーチにいるところを描いてください。\nリオは81話で着ていたスポーツビキニを着てください。他の2人は好きな水着を選んでください。\n第79話でリオはスポーツが非常に得意なことがわかり、第81話でちらっと見えたお腹は引き締まって見えました。できれば、リオのお腹を他の2人よりも引き締めてもらえないでしょうか？添付の参考画像を参考にしてください。\nあすかの身長は170センチ、りおの身長は160センチです。セリーナの身長は、私が知る限りでは公表されていないが、おそらくリオと同じくらいだろう。\nhttps://postimg.cc/vg2cBmTL\n\nhttps://postimg.cc/vg2cBmTL", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@tokiwajing/works/11", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2773489, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/72ff8ed4/uploads/origins/6816e47f-2834-45ee-a4c1-b3fd4cbd47af?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1a4b50ede1b7891a591b45d9a9cb5336", "srcset": "https://si.imgix.net/72ff8ed4/uploads/origins/6816e47f-2834-45ee-a4c1-b3fd4cbd47af?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1a4b50ede1b7891a591b45d9a9cb5336, https://si.imgix.net/72ff8ed4/uploads/origins/6816e47f-2834-45ee-a4c1-b3fd4cbd47af?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=c