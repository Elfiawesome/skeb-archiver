nまた、骨格は小さめですが、意外にも胸は大きいです。\n\n顔のデザインについては、以下のリンクをご参照ください。\n\nhttps://drive.google.com/drive/folders/1DVNfISF5VsB-CV6iKA4S1Zoxfys971GT?usp=drive_link\n\n\n服は自由に描いていただいて構いません。もし金額が足りない場合は、追加でプレゼントさせてください！", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@9U_trpg/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3006311, "client_id": 2915774, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/4352e59a/uploads/origins/f21d7599-be57-4885-82ec-05528098acaf?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a8f1526a06bcbe873d15c59c9aad37c2", "srcset": "https://si.imgix.net/4352e59a/uploads/origins/f21d7599-be57-4885-82ec-05528098acaf?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a8f1526a06bcbe873d15c59c9aad37c2, https://si.imgix.net/4352e59a/uploads/origins/f21d7599-be57-4885-82ec-05528098acaf?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=984e17dc5e740ecc1642345e30bd3019 2x, https://si.imgix.net/4352e59a/uploads/origins/f21d7599-be57-4885-82ec-05528098acaf?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=9ca0556cb68e5cbc0cd41a4da1ea2e71 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/4352e59a/uploads/origins/f21d7599-be57-4885-82ec-05528098acaf?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=53561a87e788c0e8cdcda7c44d5ee97e", "srcset": "https://si.imgix.net/4352e59a/uploads/origins/f21d7599-be57-4885-82ec-05528098acaf?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=53561a87e788c0e8cdcda7c44d5ee97e, https://si.imgix.net/4352e59a/uploads/origins/f21d7599-be57-4885-82ec-05528098acaf?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=3c5f6e9891ae2ab0737148fa