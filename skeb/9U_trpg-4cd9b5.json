自由に描いていただいても構いません。\nそれ以外はお任せします…！\n\nよろしくお願いします。\nここまで目を通していただきありがとうございました！", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@9U_trpg/works/4", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/44fa8b73/uploads/origins/71953768-829a-4e2c-bd63-7c1041018244?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=bf3b25081cc69b607c442d3a5f871e66", "srcset": "https://si.imgix.net/44fa8b73/uploads/origins/71953768-829a-4e2c-bd63-7c1041018244?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=bf3b25081cc69b607c442d3a5f871e66, https://si.imgix.net/44fa8b73/uploads/origins/71953768-829a-4e2c-bd63-7c1041018244?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=c9d1972d2df0761a7243371fc76c908f 2x, https://si.imgix.net/44fa8b73/uploads/origins/71953768-829a-4e2c-bd63-7c1041018244?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=d2b0af5be35da26d4958f6f3b9036628 3x"}, "private": true, "genre": "art", "tipped": true, "creator_id": 3006311, "client_id": 2392753, "nc": 17}, {"path": "/@9U_trpg/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3006311, "client_id": 1208881, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/9b5aa658/uploads/origins/5bbc9ae6-c1fd-430f-b329-730e681da3e6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9396862429230d0e3a49a37c7411c341", "srcset": "https://si.imgix.net/9b5aa658/uploads/origins/5bbc9ae6-c1fd-430f-b329-730e68