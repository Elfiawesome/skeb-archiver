ドーンの唇に情熱的なキス（ほとんど彼女の顔を吸う）をしてほしいです。また、2枚目のアングルか、余韻を暗示する画像が欲しい。地面に押し付けられたシンシアの尻に挟まれたドーンの顔の裏側。枚目は2人の顔が見えるような横からのアングルで、シンシアは甘い表情、ドーンは催眠術にかかったような目を見開いた表情。\n\n参考資料：https://i.imgur.com/vvFbRR9.png\n\nPrevious piece: https://x.com/BC6060/status/1587077401728544768\n\nありがとうございました！", "nc": 185, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@BC6060/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 332902, "client_id": 106442, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/9e9f28c0/uploads/origins/f36019db-2791-4957-b4c4-39392e260f42?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=dda3945f0752bd50362ef55a93ab767b", "srcset": "https://si.imgix.net/9e9f28c0/uploads/origins/f36019db-2791-4957-b4c4-39392e260f42?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=dda3945f0752bd50362ef55a93ab767b, https://si.imgix.net/9e9f28c0/uploads/origins/f36019db-2791-4957-b4c4-39392e260f42?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=24ff475999c2b96adb9af5544a2bb6f7 2x, https://si.imgix.net/9e9f28c0/uploads/origins/f36019db-2791-4957-b4c4-39392e260f42?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a35f79833809e0990df1ae86ba90cd98 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/9e9f28c0/uploads/origins/f36019db-2791-4957-b4c4-39392e260f42?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=7b9e54d85714fb2f3f86668aed393703", "srcset": "https://si.imgix.net/9e9f28c0/uploads/origins/f36019db-2791-4957-b4c4-39392e260f42?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=7b9e54d85714fb2f3f86668aed393703, https://si.imgix.net/9e9f28c0/uploads/origins/f36019db-2791-4957-b4c4-39392e260f42?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2