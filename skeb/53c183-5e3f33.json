33744214927511554?s=20\n\n絵柄や塗りの指定はないため、綾鷹さんの描きやすいものでお願いできれば幸いです。\nよろしくお願いいたします。", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@53c183/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2613027, "client_id": 2625383, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/63ee17b2/uploads/origins/0a45602a-f940-4f39-a480-9bf397c05253?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2c96e26b70366eef3416c2a959517df6", "srcset": "https://si.imgix.net/63ee17b2/uploads/origins/0a45602a-f940-4f39-a480-9bf397c05253?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2c96e26b70366eef3416c2a959517df6, https://si.imgix.net/63ee17b2/uploads/origins/0a45602a-f940-4f39-a480-9bf397c05253?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=d983c21fb3702235ce3dee6c01c3fdb4 2x, https://si.imgix.net/63ee17b2/uploads/origins/0a45602a-f940-4f39-a480-9bf397c05253?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=00ee5e39f5af14639489625fa914852e 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/63ee17b2/uploads/origins/0a45602a-f940-4f39-a480-9bf397c05253?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d1c88af283e69c21ab035a17a25b2ef3", "srcset": "https://si.imgix.net/63ee17b2/uploads/origins/0a45602a-f940-4f39-a480-9bf397c05253?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d1c88af283e69c21ab035a17a25b2ef3, https://si.imgix.net/63ee17b2/uploads/origins/0a45602a-f940-4f39-a480-9bf397c05253?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=f69de4597c4718ab8143c50f6ade812e 2x, https://si.imgix.net/63ee17b2/uploads/origins/0a45602a-f940-4f39-a480-9bf397c05253?bg=%23fff&auto=format%2Ccompr