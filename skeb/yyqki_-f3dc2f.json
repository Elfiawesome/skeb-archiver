少し濃いピンクの髪色、前髪ぱっつんのウルフカットです。ウルフ部分は胸ぐらいまで長めになります。\n目の中はエメラルドグリーンで、ハイライトがまつ毛の影でハートに見えるようになっています。\nふわふわカワイイ系ではなく、ニコニコ元気な配信スタイルです。\n郵便屋さんなので、服は制服的なものになります。\n資料の中にある郵便屋さん(ミニキャラ)の服装にしていただけると助かります。\n\n【用途・納品データ】 \n・イリアムやXのアイコン \n・Xへの投稿 \n・イリアムでのパネル開けなどの企画\n・イリアム特典としての、返礼品(ヘッダー・アイコンリング)\n\nリアグなどには使用しません。\nデジタルグッズのみになりますが、ギフトが発生するものになりますので、商用利用もさせていただきたいです。\n\nskeb利用、リクエストが初めてなので不明点や失礼がありましたら申し訳ございません。\n\nぜひご検討よろしくお願いします。\n\nhttps://drive.google.com/drive/folders/1j99bxWzRCvioXi14TCYqMNfQb87ED6lW", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@yyqki_/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 4113550, "client_id": 3891499, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/71b0ce78/uploads/origins/fdb33206-4442-4004-87b4-4aa55a235aaf?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d760bf3cd1d3a8e8eb90b3812fa3c645", "srcset": "https://si.imgix.net/71b0ce78/uploads/origins/fdb33206-4442-4004-87b4-4aa55a235aaf?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d760bf3cd1d3a8e8eb90b3812fa3c645, https://si.imgix.net/71b0ce78/uploads/origins/fdb33206-4442-4004-87b4-4aa55a235aaf?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=4d842850b2959cd41e7097e8cfbe1021 2x, https://si.imgix.net/71b0ce78/uploads/origins/fdb33206-4442-4004-87b4-4aa55a235aaf?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=20c59421d14746c32775fbdd95a4943d 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/71b0ce78/uploads/origins/fdb33206-4442-4004-87b4-4aa55a235aaf?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=8f245206fd9d752e8cdf672a387e9d32", "srcset": "https://si.imgix.net/71b0ce78/uploads/origins/fdb33206-4442-4004-87b4-4aa55a235aaf?bg=%23fff&auto=format%2