しているので、身体は全く動いていません。\n\n【表情】\nボールは青白く光っているので、ボール持っている手に近い方の目を眩しそうに少し細めている。\n｢最後のポケモンになっちゃった。強くて……楽しい！｣と言わんばかりの不敵な笑み。\n\n\n\n\nサインなし、背景透過のファイルを入れていただけたらとても有難いです。\nよろしくお願いします。\n\nhttps://twitter.com/alalmimi_/status/1609366892799746048?t=tZTqDSHiddCZwWctAHpgwg&s=19", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@ioiohin2/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 776472, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/5bfb3e5f/uploads/origins/ad787cde-a867-45c1-a2a7-360700e97be6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=73d706ea19e5fcf07d9cd6a6daafeba8", "srcset": "https://si.imgix.net/5bfb3e5f/uploads/origins/ad787cde-a867-45c1-a2a7-360700e97be6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=73d706ea19e5fcf07d9cd6a6daafeba8, https://si.imgix.net/5bfb3e5f/uploads/origins/ad787cde-a867-45c1-a2a7-360700e97be6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b7f27b88873d1e76c4c1333a3cffe2c3 2x, https://si.imgix.net/5bfb3e5f/uploads/origins/ad787cde-a867-45c1-a2a7-360700e97be6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ddcd11e5111bff77f1de7de84058a6f3 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/5bfb3e5f/uploads/origins/ad787cde-a867-45c1-a2a7-360700e97be6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=32faa50ea70414f827a659f7283d4e44", "srcset": "https://si.imgix.net/5bfb3e5f/uploads/origins/ad787cde-a867-45c1-a2a7-360700e97be6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=32faa50ea70414f827a659f7283d4e44, https://si.imgix.net/5bfb3e5f/uploads/origins/ad787cde-a867-45c1-a2a7-360700e97be6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=