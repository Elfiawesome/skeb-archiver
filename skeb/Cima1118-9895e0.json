50b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c0dd94e440da3682eab9735468b29f6b 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/c2a71d62/uploads/origins/4a8c8a7f-ce4b-4268-b9cf-9db33a88450b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9a0186fa2ccdee826ae643965d95fcef", "srcset": "https://si.imgix.net/c2a71d62/uploads/origins/4a8c8a7f-ce4b-4268-b9cf-9db33a88450b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9a0186fa2ccdee826ae643965d95fcef, https://si.imgix.net/c2a71d62/uploads/origins/4a8c8a7f-ce4b-4268-b9cf-9db33a88450b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=115da2730db2eee367593490d38801cb 2x, https://si.imgix.net/c2a71d62/uploads/origins/4a8c8a7f-ce4b-4268-b9cf-9db33a88450b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=4ad892a0ed5f1ffe5451712f7f8c2508 3x"}, "body": "はじめまして。Xに掲載されているホロメンのイラスト、特にさくらみこさんのイラストがとても素敵でしたので、イラストをお願いしたいと思いご連絡させていただきました。\n私はプレイステーションのゲーム「グランツーリスモ７」の中でゲーム仲間と一緒に痛車を作っているのですが、これに使用するイラストをぜひお願いしたいと思い、今回ご連絡させていただきました。\n\n１　依頼内容\n(1)　ホロライブのVtuber「輪堂千速」のイラスト。描画範囲はおまかせしますが、上と左右は見切れなしでお願いします。\n(2)　輪堂千速が公式企画又はYouTubeの配信で着用していた衣装でお願いします。\n\n２　使用目的\nゲームの中で遊ぶために使用します。\n\n３　その他\n背景は無くともいいです。痛車素材なので人物と背景をレイヤーで分けていただけると使いやすいです。", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Cima1118/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3752023, "client_id": 2752312, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/a0397b35/uploads/origins/ca3641a0-ecc8-4633-9f6f-0569fd71126b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3f49365769b0336f5444eabbd51e2650", "srcset": "https://si.imgix.net/a0397b35/uploads/origins/ca3641a0-ecc8-