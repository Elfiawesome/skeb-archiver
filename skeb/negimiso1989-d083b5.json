rop&crop=top&w=200&h=200&s=bc5ddd7e44f9caefe6403c5d2be11f52, https://si.imgix.net/ed64390a/uploads/origins/293c58d8-35d8-4032-97b2-aa45a782319f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=1f7e850af71d3662256866d442174718 2x, https://si.imgix.net/ed64390a/uploads/origins/293c58d8-35d8-4032-97b2-aa45a782319f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=9deb67b97785e3fe0e43f146631a68a7 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/ed64390a/uploads/origins/293c58d8-35d8-4032-97b2-aa45a782319f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3c73c77018155ffb8ca87d027bf157aa", "srcset": "https://si.imgix.net/ed64390a/uploads/origins/293c58d8-35d8-4032-97b2-aa45a782319f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3c73c77018155ffb8ca87d027bf157aa, https://si.imgix.net/ed64390a/uploads/origins/293c58d8-35d8-4032-97b2-aa45a782319f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=8b65d6042cf75fde730d1865aabf344f 2x, https://si.imgix.net/ed64390a/uploads/origins/293c58d8-35d8-4032-97b2-aa45a782319f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=91f559f8a802fce466cbcb378209750a 3x"}, "body": "アニポケのリコとアンをお願いします。\n\nシチュエーションは、学園で授業を受けるリコとアン。授業のテーマはコスプレ。\n二人はガラル地方のジムリーダールリナのコスプレをすることになり、更衣室で着替え終わる二人をお願いします。\n\nルリナがしているイアリング、首飾り等も二人ともつけてください。髪飾りとダイマックスバンド以外の装飾品を全てつけるようにしてもらいたいです。\n二人の顔の眉毛の化粧はルリナのマスカラ化粧にしてください。\n\nリコとアンの髪型と髪飾りは元のまま。\nリコの髪はメガボルテージ編でお願いします。\n\n二人とも胸がかなり大きめで、衣装下側の隙間からほんの少し胸がはみだすぐらいの大きさにしてください。(ブラではなく実際の乳がはみだす)\n\n二人とも並んで、正面に立ち、全身絵でお願いします。\n\nリコもアンもボトムスに親指だけをボトムスに入れて履き終わる仕草。\n(ほぼコスプレ完了している姿)\n\n二人の表情は恥ずかしくもなく、嬉しそう。コスプレ衣装に興味津々で、ルリナの衣装に着替えることに夢中になっている。\n瞳は開けて、口は閉じている表情。\n\n真後ろの床には自分達が元から着ていた衣装が後先考えずに、脱ぎ捨てられており、アンが着ていたセキエイ学園の制服とリコが着ていた私服が一緒に混じって山になっている。\n\n可能なら差分でボトムスの代わりにパンツの差分が欲しいです。デザインはおまかせします。\n\nご検討よろしくお願いします。", "nc": 48, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@negimiso1989/works/13", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 899725, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/a618ed97/uploads/origins/beefee84-95dd-48c8-946b-aeef6ea4604d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d63fc84c2fcf1ef1e691fd729899393e", "srcset": "https://si.imgix.net/a618ed97/uploads/origins/beefee84-95dd-48c8-946b-aeef6ea4604d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d63fc84c2fcf1ef1e691fd729899393e, https://si.imgix.net/a618ed97/uploads/origins/beefee84-95dd-48c8-946b-aeef6ea4604d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a148002095da6b4f105ee0ca23875d8b 2x, https://si.imgix.net/a618ed97/uploads/origins/beefee84-95dd-48c8-946b-aeef6ea4604d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=bc11503931330bdbb863db9acfc2789f 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/a618ed97/uploads/origins/beefee84-95dd-48c8-946b-aeef6ea4604d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=91708b1d1ef42dfa85eab90f372792d5", "srcset": "https://si.imgix.net/a618ed97/uploads/origins/beefee84-95dd-48c8-946b-aeef6ea4604d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=91708b1d1ef42dfa85eab90f372792d5, https://si.imgix.net/a618ed97/uploads/origins/beefee84-95dd-48c8-946b-aeef6ea4604d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=0c1db5a324271ecddf0ba8bf5af465eb 2x, https://si.imgix.net/a618ed97/uploads/origins/beefee84-95dd-48c8-946b-aeef6ea4604d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=ca47c7b903021b6145257b5c7388c73c 3x"}, "body": "いつも素敵なイラスト楽しみにしてます。\n　今回もアニポケのリーリエとリコを描いて欲しくリクエストさせていただきました。\n\nイラストは2パターン描いて欲しく\n①シチュエーションは、教室の窓際(窓は全開で開いている)で横並びに立った状態で談笑していたら突風が入ってきて、スカートが捲れ上がってパンツが丸見えになっている。\n　身体の向きは2人とも窓の外側を向いて背中側をこちらにしていて、顔は振り向いて表情は驚きながら恥ずかしそうにしている。\n　衣装は2人とも半袖の白い制服ブラウスと、丈が膝上辺りまでの制服スカート。2人とも赤い眼鏡をかけている。パンツは2人ともレースのTバックで、色はリーリエがピンクでリコが水色。\n\n②教室の黒板の前に身体を正面にして横並びに立って、パンツあやとりをしている。手とパンツの位置は胸から首の高さ辺り。\n　制服は①のイラストと同じ。パンツはリーリエが白とピンクでリコが白と水色のストライプ柄。\n　表情は2人とも上目遣いで、ものすごく恥ずかしそうにこちらを見つめている。\n\n髪型はリーリエはアニメの普段の衣装と同じで、リコはアニメの制服姿の時と同じで。\n\nまた、\n①イラストのノーパンでお尻が丸出し\n②イラストのスカートを下ろして股の割れ目が丸見え\nの差分もそれぞれ描いて欲しいです。", "nc": 49, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@negimiso1989/works/12", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 899725, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/95512e3b/uploads/origins/27399666-952d-47c8-a276-22fa6133b56e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8bf948a5271c29b9ef9ca7ec09c6ed67", "srcset": "https://si.imgix.net/95512e3b/uploads/origins/27399666-952d-47c8-a276-22fa6133b56e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8bf948a5271c29b9ef9ca7ec09c6ed67, https://si.imgix.net/95512e3b/uploads/origins/27399666-952d-47c8-a276-22fa6133b56e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=360d65da4eee1b690c4699159084327c 2x, https://si.imgix.net/95512e3b/uploads/origins/27399666-952d-47c8-a276-22fa6133b56e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ba434c6bb99988fcbdfcbca75a3ddfe2 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/95512e3b/uploads/origins/27399666-952d-47c8-a276-22fa6133b56e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0d11202ce6a0b080e23f672f2833749b", "srcset":