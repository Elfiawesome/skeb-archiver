at%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=08835b0c7602fea8a36c6841e395da17 3x"}, "body": "こんにちは。お元気ですか？あなたの作品が大好きで、お願いがあるのですが。\n\nアニメ『Re:ゼロ』のフェルトを描いていただけませんか？（参考画像：https://imgur.com/a/AAHjgkU）\n\nかわいい下着姿でポーズをとっているところを見てみたいです。スタイルや色は、無地の白以外なら何でも構いません。表情は、からかうような、あるいは色っぽい感じにしてください。ポーズやその他の詳細は、お任せします。本当にありがとうございます！！", "nc": 48, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@negimiso1989/works/17", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 899725, "client_id": 2801467, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/e2334c63/uploads/origins/f667cb58-c419-405f-a97d-e840afb58bae?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=913b847589451b4c62ef83a782b2f6e1", "srcset": "https://si.imgix.net/e2334c63/uploads/origins/f667cb58-c419-405f-a97d-e840afb58bae?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=913b847589451b4c62ef83a782b2f6e1, https://si.imgix.net/e2334c63/uploads/origins/f667cb58-c419-405f-a97d-e840afb58bae?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a1706b0de05e5c8666cfe834c352591e 2x, https://si.imgix.net/e2334c63/uploads/origins/f667cb58-c419-405f-a97d-e840afb58bae?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=de76759b365b33f13ec2cac47bd1e5f6 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/e2334c63/uploads/origins/f667cb58-c419-405f-a97d-e840afb58bae?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5b457c6173d7bf7217809baeeee62e69", "srcset": "https://si.imgix.net/e2334c63/uploads/origins/f667cb58-c419-405f-a97d-e840afb58bae?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5b457c6173d7bf7217809baeeee62e69, https://si.imgix.net/e2334c63/uploads/origins/f667cb58-c419-405f-a97d-e840afb58bae?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=fff3cfd49ce9560bd986dd477f4fe01d 2x, https://si.imgix.net/e2334c63/uploads/origins/f667cb58-c419-405f-a97d-e840afb58bae?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=d141e78b85b04896337e24f77b7b8715 3x"}, "body": "こんにちは！前回の納品、ありがとうございました。私のキャラクター「モニカ」のイラストをお願いしたいのですが。身長は150cmです。\nhttps://drive.google.com/drive/folders/1f0LrUQnNFwA1w9esRogQm3i_k_mEjO0m\n\nこちらの画像のように、ケーキやチョコレート、イチゴまみれで横たわっているシーンを描いていただけると嬉しいです。\nhttps://drive.google.com/file/d/1kihCY2Ioo5yz7bKuwymMAMEabK7w8cMm/view\n\n彼女は指を口元に持っていき、その指についたクリームを舐めている様子にしてください。また、色気のある表情にしてください。胸がクリームで覆われているバージョンと、胸が露出しているバージョンの2種類を作成していただけると幸いです。アスペクト比は16:9でお願いします。ご検討いただきありがとうございます。", "nc": 161, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@negimiso1989/works/16", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 899725, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/33f39506/uploads/origins/ab0f88ae-dfba-45f1-b49d-2f8c222379e8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8e2a9186ce3f5899582f89a50d2d2878", "srcset": "https://si.imgix.net/33f39506/uploads/origins/ab0f88ae-dfba-45f1-b49d-2f8c222379e8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8e2a9186ce3f5899582f89a50d2d2878, https://si.imgix.net/33f39506/uploads/origins/ab0f88ae-dfba-45f1-b49d-2f8c222379e8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=3f07e879697e204be50256224e37548e 2x, https://si.imgix.net/33f39506/uploads/origins/ab0f88ae-dfba-45f1-b49d-2f8c222379e8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=6062a2b0e95bd654e59d12c66b4c6826 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/33f39506/uploads/origins/ab0f88ae-dfba-45f1-b49d-2f8c222379e8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e9ebe3383f4012a6caccf3b9b5d484d8", "srcset": "https://si.imgix.net/33f39506/uploads/origins/ab0f88ae-dfba-45f1-b49d-2f8c222379e8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e9ebe3383f4012a6caccf3b9b5d484d8, https://si.imgix.net/33f39506/uploads/origins/ab0f88ae-dfba-45f1-b49d-2f8c222379e8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=c8d1d51a8420fa6638d08725cc27e90b 2x, https://si.imgix.net/33f39506/uploads/origins/ab0f88ae-dfba-45f1-b49d-2f8c222379e8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=0fe5dacb376d88bb92b867f45bc6f550 3x"}, "body": "以前に日めくりを依頼したものです。\nいつも素敵なイラストありがとうございます。\n\n葱味噌様はポケモンがお好きみたいですが、\nもし可能なら、葱味噌様のお好きなブイズをイメージした下着姿の女の子を描いて頂けないでしょうか。\nブースターなら赤色の燃えるような下着、シャワーズなら水のような下着、みたいな。\nどのブイズでも大丈夫ですし、キャラクターもオリジナルでもポケモンキャラでも何でも構いません。\n\n良ければ描いて頂けると嬉しいです。\nよろしくお願いします。", "nc": 176, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@negimiso1989/works/15", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 899725, "client_id": 3541354, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/7f5147c4/uploads/origins/7be1fdea-e1a9-49ff-aa38-3c96ecc9570f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=42cf41e34e2b60c728a2681a60056642", "srcset": "https://si.imgix.net/7f5147c4/uploads/origins/7be1fdea-e1a9-49ff-aa38-3c96ecc9570f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=42cf41e34e2b60c728a2681a60056642, https://si.imgix.net/7f5147c4/uploads/origins/7be1fdea-e1a9-49ff-aa38-3c96ecc9570f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=66cb76c7068d8f3cd7d08d6af90a066b 2x, https://si.imgix.net/7f5147c4/uploads/origins/7be