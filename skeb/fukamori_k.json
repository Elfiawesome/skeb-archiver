client_visible": false, "total_appeals_count": 0, "received_works": [{"path": "/@fukamori_k/works/10", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3411414, "client_id": 3450283, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/17a350b0/uploads/origins/8f5f0a55-64cd-4acb-8b65-0675086037df?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=94a95cfb0f85987660014fab18f10999", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/17a350b0/uploads/origins/8f5f0a55-64cd-4acb-8b65-0675086037df?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=95e137d80a7943034b569ce33be14fc4", "src_set": ""}, "body": "お世話になっています。冴樹と申します。\n深森さんのモノクロの深い奥行きのある絵に筋肉隆々な絵柄に惚れ、ウチの子を描いていただきたく依頼しにきました。\n\n自創作のキャラクター「河賀犬志」をリクエストします。\n世界観としては現代からファンタジーな異世界に行ってしまったキャラクターの1人で、ギャグ漫画のような創作設定でございます。\nキャラクターは誠実で優しい寡黙のポーカーフェイスのむっつりドスケベな性格をしております。\n構図などは資料見た際閃いたものでお任せ致します。\n\n描きあげた作品に深森さんのサインを少し大きめに入れていただきたいです。\n\nどうぞ宜しくお願い致します。\n\nhttps://drive.google.com/drive/folders/1LSZv7VqOCoBNhJcm94Lsy8WSIHPEVL7V", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@fukamori_k/works/9", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3411414, "client_id": 2362651, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/1ab8966f/uploads/origins/89b9dd76-5558-4eb2-8c29-2cd0cd262303?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b64ee16d855ba13b4f7bf6f24549bccd", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/1ab8966f/uploads/origins/89b9dd76-5558-4eb2-8c29-2cd0cd262303?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=27c90567666b64e1b0605e0c5fa1a1a7", "src