i.imgix.net/69a09965/uploads/origins/9e21b879-b5ea-4355-adcc-d77701ce792a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f50cb38153a97f4811c89316b760950b 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/69a09965/uploads/origins/9e21b879-b5ea-4355-adcc-d77701ce792a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3843b3616bbf71826725b1ebd3f7f581", "srcset": "https://si.imgix.net/69a09965/uploads/origins/9e21b879-b5ea-4355-adcc-d77701ce792a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3843b3616bbf71826725b1ebd3f7f581, https://si.imgix.net/69a09965/uploads/origins/9e21b879-b5ea-4355-adcc-d77701ce792a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=25e18fdc20dd0574fe6ba1b864d8aa3c 2x, https://si.imgix.net/69a09965/uploads/origins/9e21b879-b5ea-4355-adcc-d77701ce792a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=c8a7418a3bbce88c2317fbbc8034e7ae 3x"}, "body": "大原ロロンさんのイラスト、漫画が大好きで、いつも凄く癒やされてます。\nそんな大原ロロンさんに、個人VTuberの「夢咲ゆん」さんを描いて頂きたいです。\nこのゆんさんが、大原ロロンさんの可愛らしく和やかで癒される作風にぴったりだと以前から思っており、是非とも見てみたいと思ってましたので、今回初めてですが依頼をさせて頂きました。\n\n衣装は資料URLの、右側(お団子ヘアー)の方をお願いします。\n\n構図は、お手数ですが漫画風にして頂きたく、\n\n1：外を歩いてたら、何かに気付く\n2：ショーケースに沢山のスイーツが並んでいて、「わぁ…！」と目を輝かせる\n3：スイーツを買ってきて、1つのシュークリームを両手で持ちながら満面の笑みを浮かべる\n4：シュークリームを頬張ると、反対側からクリームが出て来てこぼれてしまい、「あっ…」となってしまう\n\nというシチュエーションをお願いします(1と4はデフォルメ調希望、3は一番大きなコマで描いて頂きたいです)\nコマの割り方はお任せします。\n\nまた、背景の方もお任せしますが、可能でしたら3のシチュエーション部分だけの背景透過版も頂けると幸いです。\n\n以上、指定が多くて申し訳ありませんが、宜しくお願い致します！\n\nhttps://twitter.com/yumesaki_yun/status/1585818821658435585?t=CpzeQjPhBME67dCaKfHTig&s=19", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@roron34/works/14", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2195707, "vtt_ur