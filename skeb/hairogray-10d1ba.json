3ed", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@hairogray/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 4054067, "client_id": 3424280, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/c0adaa64/uploads/origins/7f2228a4-4675-4faf-89ac-e2cc35e4505e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a51e162a325507dac8802866ff31983b", "srcset": "https://si.imgix.net/c0adaa64/uploads/origins/7f2228a4-4675-4faf-89ac-e2cc35e4505e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a51e162a325507dac8802866ff31983b, https://si.imgix.net/c0adaa64/uploads/origins/7f2228a4-4675-4faf-89ac-e2cc35e4505e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=254212ad7b8eeda8ef2a5dd1de697acd 2x, https://si.imgix.net/c0adaa64/uploads/origins/7f2228a4-4675-4faf-89ac-e2cc35e4505e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=140c70785894b3887fa9bb84eade6a9d 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/c0adaa64/uploads/origins/7f2228a4-4675-4faf-89ac-e2cc35e4505e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f57cb5d34d49fa38260b71f8c411b3f1", "srcset": "https://si.imgix.net/c0adaa64/uploads/origins/7f2228a4-4675-4faf-89ac-e2cc35e4505e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f57cb5d34d49fa38260b71f8c411b3f1, https://si.imgix.net/c0adaa64/uploads/origins/7f2228a4-4675-4faf-89ac-e2cc35e4505e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=5f09fc5048339466fedea8a4800fae5b 2x, https://si.imgix.net/c0adaa64/uploads/origins/7f2228a4-4675-4faf-89ac-e2cc35e4505e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=49e61d86bd7168d321ae87ddcf2f7aea 3x"}, "body": "仄様\n\n初めまして！絵描きのVTuberとして活動しております都良と申します🙇‍♀️\nいつも仄様のTRPG立ち絵などを拝見して、あまりの美しさと細さに惚れ惚れし、憧れております😭\n\nサブskebの開設おめでとうございます✨️\n早速ですが、是非私のイメージ小物をお願いしたいです！\n\n【活動内容/自己紹介】\n・お絵描き雑談\n・朗読\n・歌ってみた\n・のんびりゲーム\nなどをメインとして活動しており、男装Vとして一人二役をしていることも多いです…！\n好きな食べ物はトマトですので、マークは🍅🐯を使用しております。\n人ですので、名前の割に虎の要素は黄色と頭のお団子(耳)のみとなっております。虎は好きです…！\n配信ではしょっちゅうご飯の話をしております。男装という特性上、コスプレ等も好きなため化粧品もとても好きです✨️\n\n【使用用途】\n・SNSのヘッダーや立ち絵の横に添える\n・YouTube配信にて画面上背景・小物で使用\n・個人観賞用としてシールを作成\nと考えております！\nYouTubeは現在収益化はしておりませんが、いずれ収益化の可能性がありますので、その分の追加等ありましたら御手数ですか再送頂けますと幸いです🙇‍♀️\nまた、手持ちマイクなどの手で持てる小物の場合、上から持つ手の加筆を行うなどさせて頂く場合がございます(資料配信画面②参照)\n\n長々と申し訳ありません。\nマイクやペンの場合は加筆許可のお願いも添える形ですので、NGの場合はスタンドをつけて頂く、もしくは2点以外の思いつくイメージの小物をお願いできますでしょうか？\nまた、小物のみの透過データも頂けますと助かります。\nご縁がありましたら是非よろしくお願いいたします！\n\n資料: https://drive.google.com/drive/folders/1XnIBGUgM09Br58rSVOt6YUcJZLq8Hwwo\nYouTube: https://youtube.com/@toma_tora23?si=OxF8sa0xr458AJDT\n\nhttps://drive.google.com/drive/mobile/folders/1XnIBGUgM09Br58rSVOt6YUcJZLq8Hwwo", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 199797, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "あすたら", "screen_name": "Astala_AUC", "avatar_url": "https://pbs.twimg.com/profile_images/1958832009108946944/wfO3CoI5.jpg", "header_url": "https://pbs.twimg.com/profile_banners/767006741108133889/1735607783/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "art"}], "banned": false, "nc": 160}, {"id": 1860363, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "稲荷梵⛩️🐍", "screen_name": "licorisu_", "avatar_url": "https://pbs.twimg.com/profile_images/1897527633132576768/DCmqnHUN.jpg", "header_url": "https://pbs.twimg.com/profile_banners/72810