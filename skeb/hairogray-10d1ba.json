it=crop&crop=top&w=200&h=200&blur=200&s=64022164198193e205b99b0aed8556f7", "srcset": "https://si.imgix.net/3b65f56c/uploads/origins/8a636deb-176f-4207-a23e-a1058c8a868a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=64022164198193e205b99b0aed8556f7, https://si.imgix.net/3b65f56c/uploads/origins/8a636deb-176f-4207-a23e-a1058c8a868a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=6eb5bdd684890acba3b055a2932cd958 2x, https://si.imgix.net/3b65f56c/uploads/origins/8a636deb-176f-4207-a23e-a1058c8a868a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=cd271194ee021d94f2d1f347e29ee445 3x"}, "body": "初めまして、個人Vtuberの夢見めいと申します。\n仄様の描かれるイメージ小物にとても魅力を感じたので、この度リクエストをお送りさせていただきました。\n\n【イメージ小物】 \n ・服装の指定は特にございませんので、仄様の好みのものを描いて頂きたいです。\n・可愛いより大人のお姉さんイメージであると嬉しいです\n・もし可能であれば小物単体の背景透過画像も用意していただきたいです。\n\n資料はURLをご参照ください。\n\n【使用用途】 \nSNS活動や収益化済のチャンネルのサムネイルとしての使用、可能であればステッカーなどのグッズ化に使用したいと考えております。(グッズ化に関しましては不可であれば致しません！)\nお忙しいところ大変恐縮ですが何卒ご検討いただけますと幸いです。\n\nhttps://drive.google.com/drive/folders/1CL2IAJiVyJZutMFFH1b1uySuyjxutojG", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@hairogray/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 4054067, "client_id": 1949046, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/3c3cfdcc/uploads/origins/31169c5d-6042-4b3c-ad14-7f5349927a05?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f0545549c19d3390d949ef6d0d00486a", "srcset": "https://si.imgix.net/3c3cfdcc/uploads/origins/31169c5d-6042-4b3c-ad14-7f5349927a05?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f0545549c19d3390d949ef6d0d00486a, https://si.imgix.net/3c3cfdcc/uploads/origins/31169c5d-6042-4b3c-ad14-7f5349927a05?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c5d26