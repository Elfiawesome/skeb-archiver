o=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ade514ce3d14027ab216924ed0619bfd", "srcset": "https://si.imgix.net/15fbe711/uploads/origins/3545c5d1-fd36-4710-9ac6-b107db20dd3a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ade514ce3d14027ab216924ed0619bfd, https://si.imgix.net/15fbe711/uploads/origins/3545c5d1-fd36-4710-9ac6-b107db20dd3a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=2e42ca4834250c65ecc7f98882db499d 2x, https://si.imgix.net/15fbe711/uploads/origins/3545c5d1-fd36-4710-9ac6-b107db20dd3a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=59a36269ff66877d95fc52f25f1aa4b3 3x"}, "body": "てるる先生、初めまして！\n優しい雰囲気のイラストが大好きです。\nオリジナルキャラクターをリクエストさせてください！  \n\n【使用用途】 \n観賞用、個人SNSアイコン\n\n・元気な女の子\n・髪型はミディアムレイヤー、色はピンク系、少しくせ毛で外側にはねてる感じ\n・八重歯\n・猫耳\n・その他、服装や構図などはお任せいたします   \n\nよろしくお願いいたします。", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Teruru_painting/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2878024, "client_id": 347078, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/3f98a34d/uploads/origins/4d49e6e0-66c6-477a-9462-b978d95e587a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c3891d86b3a7903a14560d345c1c51b6", "srcset": "https://si.imgix.net/3f98a34d/uploads/origins/4d49e6e0-66c6-477a-9462-b978d95e587a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c3891d86b3a7903a14560d345c1c51b6, https://si.imgix.net/3f98a34d/uploads/origins/4d49e6e0-66c6-477a-9462-b978d95e587a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=cc8595b2e1d41d9443e12a8c29eed993 2x, https://si.imgix.net/3f98a34d/uploads/origins/4d49e6e0-66c6-477a-9462-b978d95e587a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=db9cd82f899eebcf3306a48dbd256d18 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/3f98a34d/uploads/origins/4d49e6e0-66c6-477a-9462-b978d95e587a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c5ff82e27b9068bdb4dfc543a848b1ff", "srcset": "https://si.imgix.net/3f98a34d/uploads/origins/4d49e6e0-66c6-477a-9462-b978d95e587a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c5ff82e27b9068bdb4dfc543a848b1ff, https://si.imgix.net/3f98a34d/uploads/origins/4d49e6e0-66c6-477a-9462-b978d95e587a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=69dfbc3a36b9795783821a4252dd5f1e 2x, https://si.imgix.net/3f98a34d/uploads/origins/4d49e6e0-66c6-477a-9462-b978d95e587a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=21af593d219942bd13ae72deded696fd 3x"}, "body": "先刻はお世話になりました。\nリクエストを失礼いたします。\nキャラクターはXのアイコンにしているOC（原画イラストレーター様から二次創作許可済み）を描いていただきたいです！\n\n全体絵(私のXの固定ツイートURLになります。)\n\nhttps://x.com/yzrham/status/1530390928653168640?s=46&t=8Gl_ZQmEMULN6z9FdVrxUg\n\nキャラクター詳細：\n・狐耳(しっぽ)の女の子(15〜17歳くらい)\n・髪色：白(銀)+青(比率自由で構いません)\n・元イラストは長髪ですが、短くなっても大丈夫です。(描きたいと思う方でお描き下さい。)\n・目の色：青眼\n\nイラスト内容の希望：\nてるる様の淡いイラストにとても惹かれまして、興味を持ちました！\nてるる様の画風にあわせご自由にアレンジいただけますと幸いです。\n(元のイラストは少し大人びてますが、少し幼く、胸も小さく描いていただけると嬉しいです。)\n\n構図：ベッドの上で自分のしっぽを抱いて寝ている姿を描いて欲しいです。\n（雰囲気として、普段はクールだけど寝ている姿は可愛いみたいな感じを想像してます。）\n\n衣装の希望：てるる様の制服姿の女の子や、パーカー姿の女の子のイラストがとても刺さった為、制服かパーカー1枚(に見える姿)などで描いていただければとても嬉しく思います。\n\n使用用途：スマホ、PC等の壁紙、snsのアイコン等（商用利用無し）\n\nその他希望：\n・スマホの壁紙をメインに考えているため、イラストの比率を16：9(に近い比率)で描いていただけると助かります。(縦長に近ければ問題ありません。)\n・キャラクターを全体の真ん中に描いて頂き、多少の背景余白があるとなお嬉しいです。(壁紙としてサイズ調節する為)\n・お手数でなければ、右目：赤、左目：青のオッドアイの差分を描いていただけますと大変嬉しいです。(金額に見合わない際は差分なしでも勿論構いません。)\n\n以上となります。\n長くなりまして申し訳ございません。\nご興味がありましたら、ぜひご一考いただけますと幸いです。\n\nリクエストがてるる様の作風に会わないと感じる際や、ご都合が難しい際は、ご遠慮なくお見送りくださいませ。\nよろしくお願いいたします。", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Teruru_painting/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2878024, "client_id": 2175157, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/9580ac74/uploads/origins/ee7208e8-fc8f-4b6c-bfe2-f12c5768eec8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6497856d047e3b67db71f8a36b857146", "srcset": "https://si.imgix.net/9580ac74/uploads/origins/ee7208e8-fc8f-4b6c-bfe2-f12c5768eec8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6497856d047e3b67db71f8a36b857146, https://si.imgix.net/9580ac74/uploads/origins/ee7208e8-fc8f-4b6c-bfe2-f12c5768eec8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=899b9a2ecbd145beec567fe8ba2c090b 2x, https://si.imgix.net/9580ac74/uploads/origins/ee7208e8-fc8f-4b6c-bfe2-f12c5768eec8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=56df81bdaae7ae6b2f0058359e5f6307 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/9580ac74/uploads/origins/ee7208e8-fc8f-4b6c-bfe2-f12c5768eec8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d9598b292388e4f1ae41e22d6a44d274", "srcset": "https://si.imgix.net/9580ac74/uploads/origins/ee7208e8-fc8f-4b6c-bfe2-f12c5768eec8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d9598b292388e4f1ae41e22d6a44d274, https://si.imgix.net/9580ac74/uploads/origins/ee7208e8-fc8f-4b6c-bfe2-f12c5768eec8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=a3fbe06b72359c3812f652ccc0e45e2e 2x, https://si.imgix.net/9580ac74/uploads/origins/ee7208e8-fc8f-4b6c-bfe2-f12c5768eec8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=e2692a211de2db1c4759b4bb4980f0c4 3x"}, "body": "てるる様