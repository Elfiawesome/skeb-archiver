ジのような、静かでしっとりした空気感も似合う子です。\n\n今回は、水着姿のイラストをお願いしたいと考えています。水着のデザインや配色の希望は添付資料にまとめていますので、そちらを参考にしていただけますと幸いです。\n\nポーズや構図については、描きやすい形でお任せできればと思います。\n\n参考資料はこちらになります：\nhttps://drive.google.com/drive/folders/1ROCN4gQtpJR5TSRYstYCG46sh167i_Te\n\n制作いただいたイラストは、Vチューバー活動（SNSでのスケジュール投稿や配信サムネイルなど）に使用させていただく可能性があります。", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@motthi0711/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2930609, "client_id": 1074147, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/555e2975/uploads/origins/cf431eb5-5a85-449d-a974-a15bffc71b83?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7252f17521fae06e809abc3f832246d3", "srcset": "https://si.imgix.net/555e2975/uploads/origins/cf431eb5-5a85-449d-a974-a15bffc71b83?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7252f17521fae06e809abc3f832246d3, https://si.imgix.net/555e2975/uploads/origins/cf431eb5-5a85-449d-a974-a15bffc71b83?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=20f7ff8b41a811311ac9b840c1ec84e2 2x, https://si.imgix.net/555e2975/uploads/origins/cf431eb5-5a85-449d-a974-a15bffc71b83?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e5876de35664e764a4847b8fb5e785f1 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/555e2975/uploads/origins/cf431eb5-5a85-449d-a974-a15bffc71b83?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2744567ae34b1281e707690b3fc5ab93", "srcset": "https://si.imgix.net/555e2975/uploads/origins/cf431eb5-5a85-449d-a974-a15bffc71b83?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2744567ae34b1281e707690b3fc5ab93, https://si.imgix.net/555e2975/uploads/origins/cf431eb5-5a85-449d-a974-a15bffc71b83?bg=%23