者です！いつも可愛いイラスト拝見させていただいてます！\n\n今回は自分のオリジナルキャラを描いていただきたくリクエストさせていただきました！\n\n ◯使用用途 \n・各種SNSでのアイコン、ヘッダーなどでの使用 \n・スマホ、PCの壁紙での使用 \n\n ◯キャラクターの詳細  \n・髪型　ロングで三つ編みハーフアップ/横髪が片方三つ編み \n・髪色　グレーに近い黒で薄ピンクのグラデーション\n ・猫のけもみみと尻尾  可能であれば尻尾にリボンを巻いていただきたいです。\n・ベレー帽 　\n・服装は変えていただいても構いません。お腹を見せたり露出を増やしていただいて結構です。\n\n ・目は猫目にしていただきたいです。\n\n○構図指定などはなくお任せでお願いしたいです。\n\nお忙しいところ恐縮ですが、ご縁ありましたらよろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/1UNOdy4aCYJlTPwq-uMjXqWnmbi6I6xyN", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@ill66661/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3954914, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/47c566cf/uploads/origins/43203609-d751-4fd9-a2e1-b4d5083cfb26?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3dacc51ba071cb2d46b8c5910afcb514", "srcset": "https://si.imgix.net/47c566cf/uploads/origins/43203609-d751-4fd9-a2e1-b4d5083cfb26?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3dacc51ba071cb2d46b8c5910afcb514, https://si.imgix.net/47c566cf/uploads/origins/43203609-d751-4fd9-a2e1-b4d5083cfb26?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a14d9f9241c8889b1924a99818c84db5 2x, https://si.imgix.net/47c566cf/uploads/origins/43203609-d751-4fd9-a2e1-b4d5083cfb26?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=8ee66409e207725c6620d302c5d90b1a 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/47c566cf/uploads/origins/43203609-d751-4fd9-a2e1-b4d5083cfb26?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=053709b82c1a71de7a0e3448da3ce5e6", "srcset": "https://si.imgix.net/47c566cf/uploads/origins/43203609-d751-4fd9-a2e1-b4d5083cfb26?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200