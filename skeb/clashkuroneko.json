名前の天使か女神を描いてください！金髪、天使の羽、後光、右目は金色、左目は銀色！彼女の身長は220cmです。\n胸のサイズは...183cmで、Z-CUPです。髪型や服装はこの2人からヒントを得るべきだろう：\nhttps://7-virtues.net/chara/kindness.html\nhttps://www.pixiv.net/artworks/99577546 （最初の絵）\n百合の女神」（人間は彼女をそう呼ぶ）または「百合の女神」と書くかキャプションを付けてください！手に百合漫画を持ち、長い笏を持っている。\nhttps://skeb.jp/@clashkuroneko/works/100 の亡き母であり、https://skeb.jp/@clashkuroneko/works/102 の亡き元妻である。", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@clashkuroneko/works/113", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/7120ed86/uploads/origins/e5534ea6-ec96-44dc-81f6-170c6d3abf51?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=d6cf5b2da18da24efe41354bad22f1b5", "src_set": ""}, "private": true, "genre": "art", "tipped": false, "creator_id": 347524, "client_id": 53412, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 49, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@clashkuroneko/works/112", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 347524, "client_id": 1509886, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/b706ac35/uploads/origins/9aa83e7f-5c3f-496b-8b68-ad27e5805c2b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2df3baf2f7c4b92b212e18dcb7d5634f", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/b706ac35/uploads/origins/9aa83e7f-5c3f-496b-8b68-ad27e5805c2b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2f44ef3a2aca17f500759cd759894b4c", "src_set": ""}, "body": "初めて制服姿のオリジナルキャラクターをリクエストします。ミカ（DOB：1997/05/01、175cm/53kg）はこちらhttps://skeb.jp/@nisikiyuno/works/4、妹と一緒に女子校に通う高校生として描いてください。2011年秋から2015年春まで高校生だった（アメリカの学校はそんな感じ）。制服は黒のローファーにパンスト、赤と青のチェック柄のプリーツスカート、白のシャツ、赤い紐タイ、黒のカーディガン（黒のカーディガンは制服ではない。）姫カットで黒いチョーカーもつけている。表情は険しい。\n妹の名前はミアで、155cm、40kg、2歳年下。ヘアスタイルはミカに似ているが、前髪を右に流し、日焼けしたセーターのベストを着て、ニーハイソックスをはいている。\n胸は平らで色白。\n学校名は「聖マドレーヌ女学院」。", "nc": 152, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@clashkuroneko/works/111", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/25f35e47/uploads/origins/dddf8592-2a8f-4bfe-b7f2-bffd964946d0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=fd2189e97a480a627bce35ee37144b26", "src_set": ""}, "private": true, "genre": "comic", "tipped": true, "creator_id": 347524, "client_id": 1184664, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 33, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@clashkuroneko/works/110", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/7c4bbe6a/uploads/origins/8b9c157d-6746-48fc-b321-1715ba11f1e6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=b017a33a14daeba74d625c7244f015f5", "src_set": ""}, "private": true, "genre": "comic", "tipped": true, "creator_id": 347524, "client_id": 1184664, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 51, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}], "similar_creators": [{"id": 41825, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "流水あるも/Arumo🐩", "screen_name": "rumi_arumo", "avatar_url": "https://pbs.twimg.com/profile_images/145258