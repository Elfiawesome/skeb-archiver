デアがあれば自由に描いてください！\n\nどうもありがとうございます！https://humorous-fibula-b01.notion.site/Moonlit-Crows-13ae4e67dd83801f8daeff49213479fc", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@makarongo/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3794379, "client_id": 2748296, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/a55840b4/uploads/origins/30be6e0a-4d30-4571-9ff2-4bf171e88b5d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=31b45622ad22184ac1db0d3a041fcfa4", "srcset": "https://si.imgix.net/a55840b4/uploads/origins/30be6e0a-4d30-4571-9ff2-4bf171e88b5d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=31b45622ad22184ac1db0d3a041fcfa4, https://si.imgix.net/a55840b4/uploads/origins/30be6e0a-4d30-4571-9ff2-4bf171e88b5d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=44909bb5afad2e59cdb2d2161340053b 2x, https://si.imgix.net/a55840b4/uploads/origins/30be6e0a-4d30-4571-9ff2-4bf171e88b5d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ab7973a7a741b787aa44b585625f008c 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/a55840b4/uploads/origins/30be6e0a-4d30-4571-9ff2-4bf171e88b5d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9a7d16512eba61ae554cf41191d66e6a", "srcset": "https://si.imgix.net/a55840b4/uploads/origins/30be6e0a-4d30-4571-9ff2-4bf171e88b5d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9a7d16512eba61ae554cf41191d66e6a, https://si.imgix.net/a55840b4/uploads/origins/30be6e0a-4d30-4571-9ff2-4bf171e88b5d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=5ecbd009b5f803b79f947af952430cfd 2x, https://si.imgix.net/a55840b4/uploads/origins/30be6e0a-4d30-4571-