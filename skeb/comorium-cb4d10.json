t=JIWmfnoZMTuQTCuD0swPZg", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@comorium/works/13", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2445369, "client_id": 2310068, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/7a7c193d/uploads/origins/a447aa98-99bb-4549-9ca9-b3f0843e361e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=340a45bd24f01d9db04387c9d1b27ba2", "srcset": "https://si.imgix.net/7a7c193d/uploads/origins/a447aa98-99bb-4549-9ca9-b3f0843e361e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=340a45bd24f01d9db04387c9d1b27ba2, https://si.imgix.net/7a7c193d/uploads/origins/a447aa98-99bb-4549-9ca9-b3f0843e361e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=29f1f31286d7d85cb394f908adebdc36 2x, https://si.imgix.net/7a7c193d/uploads/origins/a447aa98-99bb-4549-9ca9-b3f0843e361e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=3fb8c6a3e62adaed7d060620a9ce94c3 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/7a7c193d/uploads/origins/a447aa98-99bb-4549-9ca9-b3f0843e361e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ec0b63efeba6d53c8b1bb49123876cb2", "srcset": "https://si.imgix.net/7a7c193d/uploads/origins/a447aa98-99bb-4549-9ca9-b3f0843e361e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ec0b63efeba6d53c8b1bb49123876cb2, https://si.imgix.net/7a7c193d/uploads/origins/a447aa98-99bb-4549-9ca9-b3f0843e361e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=45a59e43e714bc8846cc272e3511e762 2x, https://si.imgix.net/7a7c193d/uploads/origins/a447aa98-99bb-4549-9ca9-b3f0843e361e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=8247d1b39f430aefe5b7d87bbe98918c 3x"}, "body": "はじめまして。\nこの度は、アイドルグループeNのメンバー、立花けいな(@eN_keina)さんのイラストをお願いしたくご連絡いたしました。\n以下、詳細です。\n\n【使用用途】生誕ライブ開催を祝したフラワースタンドにcomo様のイラストを設置したいです。また、イラストを立花さんご本人にプレゼントしたいです(como様が描いてくださったことはもちろんお伝えします)\n\n【構図】腰上〜を描いていただきたいです。\nポーズはよろしければcomo様にお任せしたいです。また、お誕生日のお祝いということで、背景にオレンジ色のお花(ブーケのような感じ)を描いていただきたきたいです。2023.4.12に投稿されているミクちゃんのイラストの背景がとても素敵でした…！\n\n【表情】😄😆(にっこり！！！)よりは☺️(ニコ)がいいと考えています。分かりずらく申し訳ありません。\n\n【服】難しいかもしれませんが、ステージ衣装でお願いしたいです。\n⬇️衣装全身\n\nhttps://twitter.com/en_11_11/status/1712441864463544677?s=46&t=MKxWy2CvOgSd3YFDgCvUEg\n⬇️ヘッドパーツなど参考になれば\n\nhttps://twitter.com/en_keina/status/1717898572182814880?s=46&t=MKxWy2CvOgSd3YFDgCvUEg\n\nhttps://twitter.com/en_keina/status/1715222204009554244?s=46&t=MKxWy2CvOgSd3YFDgCvUEg\n\n\n【髪型】ゆるく巻いたロングヘアでお願いしたいです。\n⬇️触覚(こだわりがあるそうです)･髪色(明るすぎない茶髪)\n\nhttps://twitter.com/en_keina/status/1703033702803243063?s=46&t=MKxWy2CvOgSd3YFDgCvUEg\n\n【顔･ピアス･ネイルなど】右目下(外カメラで撮った場合左側)に小さくほくろがあります。ネイルはコーラルオレンジ(透け感あり)のマニキュアをいつも塗っています。\nピアスは右耳に3つついています。左も開いていますが耳たぶだけかもしれません。右のハートのピアスは位置に変動あれどいつも着けているので、よろしければ描いていただけるとうれしいです(触覚など髪とのバランスで難しければ大丈夫です！)\n⬇️右ピアス参考ツイート(軟骨はシルバーのファーストピアスです)\n\nhttps://twitter.com/en_keina/status/1711353565661540444?s=46&t=MKxWy2CvOgSd3YFDgCvUEg\n\n\nお忙しい中お目通しいただきありがとうございます。ご検討いただけますと幸いです。\nよろしくお願いいたします。", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@comorium/works/12", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2445369, "client_id": 2932951, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/5ae86612/uploads/origins/9a3a7b00-165d-4bb3-bd9f-98be991d38a2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3e2a2d4cb68a4f97d89a7480b35acf6c", "srcset": "https://si.imgix.net/5ae86612/uploads/origins/9a3a7b00-165d-4bb3-bd9f-98be991d38a2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3e2a2d4cb68a4f97d89a7480b35acf6