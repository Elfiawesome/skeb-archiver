mage_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2445369, "client_id": 1249073, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/7c5c9e8c/uploads/origins/ad13b4ea-7c85-423c-9679-30e7c901d14b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=460aa7399d672388f09d3ddc24ef964a", "srcset": "https://si.imgix.net/7c5c9e8c/uploads/origins/ad13b4ea-7c85-423c-9679-30e7c901d14b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=460aa7399d672388f09d3ddc24ef964a, https://si.imgix.net/7c5c9e8c/uploads/origins/ad13b4ea-7c85-423c-9679-30e7c901d14b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=6720e04975874ecdc10a3f6093b6cf95 2x, https://si.imgix.net/7c5c9e8c/uploads/origins/ad13b4ea-7c85-423c-9679-30e7c901d14b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=90b7680cb8d24644930ac0a4345dff73 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/7c5c9e8c/uploads/origins/ad13b4ea-7c85-423c-9679-30e7c901d14b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3ddad5ded8b57125fb1c991a1dccce63", "srcset": "https://si.imgix.net/7c5c9e8c/uploads/origins/ad13b4ea-7c85-423c-9679-30e7c901d14b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3ddad5ded8b57125fb1c991a1dccce63, https://si.imgix.net/7c5c9e8c/uploads/origins/ad13b4ea-7c85-423c-9679-30e7c901d14b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=f92b283f8615d1c1ce5efc9900db2d08 2x, https://si.imgix.net/7c5c9e8c/uploads/origins/ad13b4ea-7c85-423c-9679-30e7c901d14b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=37b60d9552a8461f1aa065bbca11f0ea 3x"}, "body": "フリルの質感、中でもメイド服の美しさに目が止まりました。\n私のキャラクターのメイド姿を描いていただけないでしょうか。\n\n\n◆全体イメージ\n私のLive2D姿のイラストをお願いします。\n衣装は過去の納品物のようなスタンダード・クラシカル寄りのメイド服で、「全身図」で描いて欲しいです。\n（パニエでふわふわのスカート～タイツのラインが大好きなので、ぜひそのあたりを見たいです…！）\n\nスカート丈は膝下、白タイツ、黒のメリージェーンなどを身にまとっている姿が見たいです。\nもし元衣装の要素で入れたいパーツやモチーフがあればご自由に使用してください。\n頭物ですが、ヘッドドレスやフリルのついた可愛すぎるものは似合わない気がするので、リボンやカチューシャが合うかなと思ったのですが、𝐜𝐨𝐦𝐨さん的にいかがでしょうか…！\n\n髪型はショートとロングお好きな方を選択してください。\nまた性別がない設定なので、お胸はぺったんこでお願いします。（※キャラ自体は、気にせず可愛さ寄りで描いて大丈夫です！！）\n\n\n◆キャラクター：ケモ耳の人物\n基本のんびりほのぼの、たまにちょっと天然な白い狼です。\n身長はケモ耳込みで152cmで、星・リボン・お昼寝・おとぎ話の世界が好きです。\n口は\"〰\"のような形になっていて、小さな牙、狼の耳と尻尾があります。※人の耳はありません。\n\n\n◆作品について\n主に観賞用ですが、SNS・Youtubeの限定配信で使用する可能性があります。\nデータは背景透過済みのPNGを別途添付するか、キャラと背景がレイヤー分けされた状態のPSDが希望です。\n\n\nご検討よろしくお願いします。\n\nhttps://drive.google.com/drive/folders/1ivr9tYobW90GyOg--RRQIwcA6xEMrwRm?usp=sharing", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@comorium/works/10", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2445369, "client_id": 1779662, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/161067b5/uploads/origins/7a49cfe1-dc5c-43b9-803c-0359caf8ec17?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1df6c9efd56b147e6858c1d7cf327c2e", "srcset": "https://si.imgix.net/161067b5/uploads/origins/7a49cfe1-dc5c-43b9-803c-0359caf8ec17?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1df6c9efd56b147e6858c1d7cf327c2e, https://si.imgix.net/161067b5/uploads/origins/7a49cfe1-dc5c-43b9-803c-0359caf8ec17?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=5c2e2b6164ecf1346595e33214f8c115 2x, https://si.imgix.net/161067b5/uploads/origins/7a49cfe1-dc5c-43b9-803c-0359caf8ec17?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=10ea823ec132a068bdacf1065cf7131c 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/161067b5/uploads/origins/7a49cfe1-dc5c-43b9-803c-0359caf8ec17?bg=%23fff&auto=format%2Ccom