入ったキャラクタースタンプ\n→片手をあげてやっほーと振っている様子\n\n2.「ＮＩＣＥ」の文字が入ったキャラクタースタンプ\n→親指をぐっと立てて、片目をウインクしている様子\n\n3.「おつかれん」(退出、終了挨拶)の文字が入ったキャラクタースタンプ\n→眠そうに目をこすっている様子\n\n【バッジ】\n魚のイラスト\n※参考資料のリンク内にさかなのぬいぐるみを抱っこしているものがありますので、\nそちらのような水色の魚でお願いしたいです。\n\n【バッジ差分】\n1.普通のおさかな\n2.おさかなの尾びれ部分のクビレに赤いリボン\n3.おさかなの尾びれ部分のクビレに金色のリボン\n\n\n◆参考資料\nリンク：https://lit.link/renren22ieneko\nこちらのオリジナルlive2Dモデルを参考にしていただけると幸いです。\n※リンク内からGoogleドライブへも移行できます\nサイズ大きめの資料、DLが必要な場合にご利用ください。\n\n\n△▼△\nのてぃ様の描かれるキャラクターは一枚絵もスタンプ絵も目がとてもきれいで、背景なども含め色使いが魅力的な方だなと拝見しておりました！\nもしよろしければぜひスタンプをお願いしたく思っております！\n\nご検討いただけますと幸いです。\nよろしくお願いいたします！\n\nhttps://lit.link/renren22ieneko", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@nottyanko2233/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1962883, "client_id": 1745100, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/cbe8e2b7/uploads/origins/baf11700-cbc3-4fa1-a276-59ebac189667?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3f6c22d825a8a6f69df852e31db042fa", "srcset": "https://si.imgix.net/cbe8e2b7/uploads/origins/baf11700-cbc3-4fa1-a276-59ebac189667?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3f6c22d825a8a6f69df852e31db042fa, https://si.imgix.net/cbe8e2b7/uploads/origins/baf11700-cbc3-4fa1-a276-59ebac189667?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=d1988102a387159556d84ae492f5cbfc 2x, https://si.imgix.net/cbe8e2b7/uploads/origins/baf11700-cbc3-4fa1-a276-59ebac189667?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f0eda122ff1c92277553e21313e925d5 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/cbe8e2b7/uploads/origins/baf11700-cbc3-4fa1-a276-59ebac189667?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f6a6ca26af9662cf184cad