92088f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=bf680d1a758f1f6fa765948802352967, https://si.imgix.net/e5a2e8d5/uploads/origins/24610e10-9157-4a43-b3df-e2f92c92088f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=41c625c41173ed38be8449df83205108 2x, https://si.imgix.net/e5a2e8d5/uploads/origins/24610e10-9157-4a43-b3df-e2f92c92088f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=07d8cda664188979921aa9a185332f35 3x"}, "body": "よしばさん\n\n悠雪華です。\nよしばさんが描かれる人物は、可愛らしくて表情や仕草が生き生きしていて、とても素敵だなぁと常々思っております。\nなかでも私自身の最推しということもあり、よしばさん宅の李斯さん(+秦関連の人物たち)が大好きです。\n\nこの度、リクエストさせていただきたいのは、｢斯非｣です。時期や内容については、どのようなものでも構いません。\n厚かましいお願いではありますが、拙宅の斯非もよろしければ混ぜていただけたら幸いです。\n\nひたすら斯非を拝みたいです。\nよろしくお願いいたします。\n\nhttps://x.com/setukadou/status/1906557542869733656?t=hkxvZIlv435obsafXklpWQ&s=19", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@yoshiba_sousaku/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "comic", "tipped": false, "creator_id": 1225954, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/2b04b38f/uploads/origins/7c1e59df-de36-4379-bd70-fbe90d83dd87?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=920855e8c6676dc16ee6971a1350b952", "srcset": "https://si.imgix.net/2b04b38f/uploads/origins/7c1e59df-de36-4379-bd70-fbe90d83dd87?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=920855e8c6676dc16ee6971a1350b952, https://si.imgix.net/2b04b38f/uploads/origins/7c1e59df-de36-4379-bd70-fbe90d83dd87?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ac02f04557c0f09721a9b6d420bb5e9f 2x, https://si.imgix.net/2b04b38f/uploads/origins/7c1e59df-de36-4379-bd70-fbe90d83dd87?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f8f8eec1b722578456e83cdbfba241db 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/2b04b38f/uploads/origins/7c1e59df-de36-4379-bd70-fbe90d83dd87?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=decd3240d41f9fa3cff9f2eba46485d8", "srcset": "https://si.imgix.net/2b04b38f/uploads/origins/7c1e59df-de36-4379-bd70-fbe90d83dd87?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=decd3240d41f9fa3cff9f2eba46485d8, https://si.imgix.net/2b04b38f/uploads/origins/7c1e59df-de36-4379-bd70-fbe90d83dd87?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=28552eae740f8500723178b6b1bd13ba 2x, https://si.imgix.net/2b04b38f/uploads/origins/7c1e59df-de36-4379-bd70-fbe90d83dd87?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=b47fe55fb2aee8cf878657600251e2bf 3x"}, "body": "胡乱さま\n\n胡乱さんの歴史創作や二次創作をいつもたのしく拝見しております。いつも投稿ありがとうございます。\n当方、百合が好きです。そして歴史創作百合に飢えております。\n\n胡乱さんが取り組んでおられる時代のなかで、百合になりそうな痕跡がある文人詩人から百合を錬成していただけないでしょうか?\n女性の詩歌が現存している周辺に、百合が埋まってませんでしょうか。よろしくお願いします🙏\n\n(※当方の百合観が日本式のため、中華百合において百合判定されて流通している「同じ男に嫁ぐ女二人」は日本式百合禁じ手「百合に挟まる男がいる」になってしまうため、今回はできればNGとさせてください。)", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@yoshiba_sousaku/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "comic", "tipped": true, "creator_id": 1225954, "client_id": 1830017, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/09987b9c/uploads/origins/e518ecf4-5bb3-4044-a8f5-a6cab1e7b28f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e6273f536a8048ae0e61aae9dcacd960", "srcset": "https://si.imgix.net/09987b9c/uploads/origins/e518ecf4-5bb3-4044-a8f5-a6cab1e7b28f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e6273f536a8048ae0e61aae9dcacd960, https://si.imgix.net/09987b9c/uploads/origins/e518ecf4-5bb3-4044-a8f5-a6cab1e7b28f?bg=