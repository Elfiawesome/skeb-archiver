9-a0d2-4de7-b57d-cdedc1c4ac6d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ad40ecb2560587ae1dac18a4beb3063c", "srcset": "https://si.imgix.net/98062d17/uploads/origins/63b85d19-a0d2-4de7-b57d-cdedc1c4ac6d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ad40ecb2560587ae1dac18a4beb3063c, https://si.imgix.net/98062d17/uploads/origins/63b85d19-a0d2-4de7-b57d-cdedc1c4ac6d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=6d5ead3390e3d339a388038f338b8fe1 2x, https://si.imgix.net/98062d17/uploads/origins/63b85d19-a0d2-4de7-b57d-cdedc1c4ac6d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=fe843ffa07036ea20d58479e273a82e4 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/98062d17/uploads/origins/63b85d19-a0d2-4de7-b57d-cdedc1c4ac6d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=36e589927390bdd3866f25a92383ac7c", "srcset": "https://si.imgix.net/98062d17/uploads/origins/63b85d19-a0d2-4de7-b57d-cdedc1c4ac6d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=36e589927390bdd3866f25a92383ac7c, https://si.imgix.net/98062d17/uploads/origins/63b85d19-a0d2-4de7-b57d-cdedc1c4ac6d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=07bb4ebdf39dd901b440db0e4d7120b2 2x, https://si.imgix.net/98062d17/uploads/origins/63b85d19-a0d2-4de7-b57d-cdedc1c4ac6d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=22070421dd6730cbd35a21a23ba3dea0 3x"}, "body": "たか埜様\n\n初めまして！\nXにてたか埜様のイラストを拝見し、鮮やかな色遣いに一目でとても惹かれました……！\nぜひOCをお描きいただきたく今回依頼を送らせていただきます。\n\nお忙しいところ恐縮ですが、お手すきの際にご確認いただけますと幸いです。\n\n下記、今回ご依頼したいキャラクターの簡易的なキャラ設定およびイラストの用途です\n\n\n▼キャラクター設定\n性別：女性\n年齢：21\n身長：161cm\n職業：大学生(超心理学専攻)\n好き：超常現象、ホラー、妖怪、神話、バナナチョコクレープ\n嫌い、苦手：時間に追われること\n容姿：緑がかった黒髪ロングのストレートヘア。\n前髪は斜めにカットしている。\n瞳は緑。\n性格/詳細：黙っていれば美人、口を開けば変人。\n幼少期に見たドラマの影響で超心理学に傾倒しており、\nわざわざ超心理学を専攻できる大学を探した。\n体力がなく、運動神経もそこそこだがなぜか根性だけがある。\n根性だけがあるせいで、大抵のことを気合で何とかしてしまうため厄介。\n時間に追われることが苦手なので、制限時間や締め切りが大嫌い。\n一人称は「ボク」\n台詞サンプル：「ボクは滅多に誘われないから困らないな！なにせあまり人が寄り付かない」\n「……あれが超常現象というやつか」「ならば科学で解決して卒論のテーマにでもしてやろう」\n\n服装や表情は添付リンクを参考にしていただけますと幸いです。\n縦長キャンパスで、出来れば全身を入れていただけますでしょうか！\n他詳細はお任せいたしますので、自由にお描きいただけますと嬉しいです。\n\n▼使用用途\n・個人的な鑑賞\n・個人鑑賞の範囲内のグッズ制作\n・SNSでのアイコンやヘッダーでの使用\n\n金額足りなければお手数ですが再送をお願いいたします。\nぜひ、ご検討いただけますと幸いです！何卒宜しくお願いいたします。\n\nhttps://drive.google.com/drive/folders/1GbYNZJ3ZnRyoX4M1TPKkXMFaJ_TQTou3?usp=drive_link", "nc": 153, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 994855, "creator": true, "nsfw_acceptable": true, "acceptable": false, "name": "うちみ", "screen_name": "uchimi_0116", "avatar_url": "https://pbs.twimg.com/profile_images/1741339408505376768/a6-1bpYb.jpg", "header_url": null, "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "art"}], "banned": false, "nc": 32}, {"id": 1166238, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "瀬戸", "screen_name": "ebi_oishiiii", "avatar_url": "https://pbs.twimg.com/profile_images/1680886966345412608/8RWeXDJG.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1382099772966805507/1771244744/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 80, "skills": [{"genre": "art"}], "banned": false, "nc": 16}, {"id": 2165528, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "toriten", "screen_name": "toriten20", "avatar_url": "https://pbs.twimg.com/profile_images/2064583802