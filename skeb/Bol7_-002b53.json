8-a2f3-4f82-8a93-b49e0429a0be/i/1901960/183aa0b9-4dc8-4dcb-908e-6b3bc2dd5c58_base_resized.jpg\n\n構図：背後から男性に乳房を揉みしだかれ、同時に挿入。\n女性は片手で自分の尻を抑えながら必死に加えられる衝撃に耐えようとする\n表情でお願いします。\n妊娠しており、かつ着衣の破損なしでお願いします。\n\n詳細：\nシャドンランナーは企業に雇われる傭兵です。\n彼らは遺伝子操作。サイボーグ手術などにより驚異的な力をもって任務を遂行するでしょう。\nしかし実態は捨て駒に過ぎません。\n敗北、死亡した場合はどうなるか？彼らの遺体から勝利者が戦利品として、\n銃、防具、サイボーグパーツでできた「内臓」などを売り捌く事となり、\n闇に葬られるのです。ファンタジー世界と変わりませんね。\nどうやら雇い主に見捨てられてしまった女性ランナーがいるようです。\n彼女は気絶している間に足を、「逃亡できない」サイバーレッグ。\n腕を自分を玩具にしている男を「攻撃できない」サイバーアームへと交換され\nセックスサイボーグにされてしまったようです。\n着衣越しにわかる勃起乳首と臨月ボテ腹を揺らしつつ、\n妊婦を弄ぶ変態に対し侮蔑の言葉を浴びせますが\nそれは戦闘服の生地越しに挿入される男性器の射精を促す効果しかないのです。", "nc": 32, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@Bol7_/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1285374, "client_id": 71755, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/06a820a5/uploads/origins/e171760e-082a-4c01-a26e-acffd891af95?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=19bbb300031fa0e9f9c5fed5d85cbe2f", "srcset": "https://si.imgix.net/06a820a5/uploads/origins/e171760e-082a-4c01-a26e-acffd891af95?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=19bbb300031fa0e9f9c5fed5d85cbe2f, https://si.imgix.net/06a820a5/uploads/origins/e171760e-082a-4c01-a26e-acffd891af95?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c48ac7bac2bf6fb4ee009bc4b1edf5fb 2x, https://si.imgix.net/06a820a5/uploads/origins/e171760e-082a-4c01-a26e-acffd891af95?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e5cc67f1735717419da7f5520bdcd8ec 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/06a820a5/uploads/origins/e171760e-082a-4c01-a26e-acffd891af95?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f68cc23a55cb54a93c5ba5bf0386672a", "srcse