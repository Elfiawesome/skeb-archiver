てたりして穏やかに微笑んだり、逆にキリっと考え事してたりしています。\n・身長は低め\n・髪はセミロングのユニコーンカラー\n・左耳にピアス\n・資料のいる「ユニコーンの子」を描いてもらいたいです\n・ユニコーンの子はおっとりとした性格でこの子にぴったりとくっついたりするのが基本位置です。何でも食べます。\n\n【イラストイメージ】\n・ポーズや表情、雰囲気、背景等はお任せいたします。\n・顔回り（顔や帽子、髪の毛など）が画像端で切れないと嬉しいです。\n・衣装はお送りする資料でお願いしたいです。\n\n【使用用途】\n・IRAMやX(旧Twitter)など、配信サイトやSNSのPR活動に使用させていただきたいです。\n・イラストは返礼品に使用したいとおもってます。\n\n【データについて】\n・画像サイズはお任せいたします。\n・金額上可能なら宛名/人物/背景を分けた、psdまたはpngデータの納品を希望したいです。\n\n【参考資料】\nhttps://drive.google.com/drive/u/2/folders/1zTHKVZCp21w7Al2L-O0df5EpJ9W9jyD4\n\nご検討の程よろしくお願いいたします。", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@tsuji444/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3873032, "client_id": 806358, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/b147c93c/uploads/origins/146358a6-6513-45a3-9349-1b3a1ee27ed3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=cfd7ca7ea1ca92e92eb50811ffbeb6a4", "srcset": "https://si.imgix.net/b147c93c/uploads/origins/146358a6-6513-45a3-9349-1b3a1ee27ed3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=cfd7ca7ea1ca92e92eb50811ffbeb6a4, https://si.imgix.net/b147c93c/uploads/origins/146358a6-6513-45a3-9349-1b3a1ee27ed3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=229aff0fda414649f62d3175825f3213 2x, https://si.imgix.net/b147c93c/uploads/origins/146358a6-6513-45a3-9349-1b3a1ee27ed3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=61c3e21d8272b33fd12ac0ece5024a60 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/b147c93c/uploads/origins/146358a6-6513-45a3-9349-1b3a1ee27ed3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e4087a1f9b461d8673ba7cadf81e5ae0", "srcset": "https://si.imgix.net/b147c93c/uploads/origins/146358a6-6513-45a3-9349-1