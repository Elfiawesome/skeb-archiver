るか悩んでしまったので、おの様のお好きな子をどちらか選んで描いてもらえたら嬉しいです🙇‍♂️\n\n⬇️ 🫖\nhttps://drive.google.com/drive/folders/13IPPja0fITpKD1TSWtWuQZglNUGVyF7F\n\n⬇️ 🐙\nhttps://drive.google.com/drive/folders/1KtS5OB71vAI2bnVIj416-0hMLnhAXFp3\n\n\n構図などはすべてお任せいたします。\n衣装や細部も描きやすいように描いていただいて構いません…！\n使用用途はアイコンなどの個人の範囲で使わせていただきます！\n\n料金不足や難しい内容でしたらキャンセルや再送などしてください🙇‍♂️ よろしくお願いいたします…😭🌸", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@okayugohaaaaaan/works/146", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1002479, "client_id": 2864356, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/fb943774/uploads/origins/fb838742-ea36-413a-9a69-2c4b2972db8d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=88553a295dfa5e47e8b9d7c94771eedf", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/fb943774/uploads/origins/fb838742-ea36-413a-9a69-2c4b2972db8d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=78f97f3bdc828e000932c6acea4dfe60", "src_set": ""}, "body": "お疲れ様です!!\n配信活動をしている真灯シークです!\nskebを眺めてたら刺さる絵師さん居るなと思いそのまま勢いでリクエストさせていただきます!!\n\n【イラストイメージ】\n・メイド服でお願い致します。\n・ギザ歯で不敵な笑みでお願い致します。\n・中性なので胸はぺったんこでお願い致します。\n・角と羽は見切れない様にお願い致します。\n・羽は折り畳んでも大丈夫です。\n・それ以外の細部はお任せ致します!!\n\n【使用用途】\n主に配信のサムネイルやX等での宣伝に使用致します。\n\n【三面図】\nhttps://x.com/matou_seek/status/1946013970797936835?s=46&t=ZW6C-OlJtFv7t9aUu-Onxw\n\n【画像形式】\n背景透過PNGでお願い致します。\n\n以上の内容で、何卒ご検討のほどよろしくお願いいたします。\n\nhttps://x.com/matou_seek/status/1946013970797936835?s=46&t=ZW6C-OlJtFv7t9aUu-Onxw", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@okayugohaaaaaan/works/145", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1002479, "client_id": 3241149, "vtt_url": null, "thumbnail_image_urls": {"src": "https: