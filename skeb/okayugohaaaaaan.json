互いを大事にしており、唯一だと思っています。\n\nシチュエーションや構図は思いついたもの、並んでいるだけでも構いません。自由に描いて頂けたら嬉しいです。\n金額や資料に不足がありましたら、御手数ですが再送やキャンセルをお願いします。\nご検討いただけましたら幸いです。よろしくお願いします🌸\n\nhttps://drive.google.com/drive/folders/111kRGmP6v_AFBO3cugMlfi8DGK7YMVYD", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@okayugohaaaaaan/works/123", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1002479, "client_id": 1274498, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/c85f4623/uploads/origins/0f65acf4-8d19-4257-82b6-3e5745f0012f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5c8246d7d99fb0930bc6a72d78c97d7a", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/c85f4623/uploads/origins/0f65acf4-8d19-4257-82b6-3e5745f0012f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=1facca66d473ed94b8c921d37fe60aeb", "src_set": ""}, "body": "こんにちは！あなたの作品の大ファンです！\n\n私のキャラクター、エリアスのアートワークをお願いしたいです！彼女は宇宙飛行士で、エイリアンや奇妙なものが大好きです！しかめっ面をしていたり、怒っているように見えることが多いのですが、それは彼女の顔がそう見えるだけです。彼女は無口な傾向がありますが、とても意見が強く、粗野です。\n\nポーズや構図はお任せします。あなたが楽しいと思うことを何でもしてください！\n\nhttps://drive.google.com/drive/folders/1LpXOcFPiqfALeEvc2CrUL8VijocygZ43?usp=sharing", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@okayugohaaaaaan/works/122", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/34a85521/uploads/origins/d5d5dd9f-d4d3-4065-9353-3cfa4ee32eb7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=a6e49a0d688f3d6a478c5fd51249fc58", "src_set": ""}, "private": true, "genre": "art", "tipped": false, "creator_id": 1002479, "client_id": 619606, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": fals