46ab2a-539d-41ae-8828-c5aac030cf01?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=43371c93f6f0decde339eb55c276d710", "srcset": "https://si.imgix.net/d18a8b51/uploads/origins/ef46ab2a-539d-41ae-8828-c5aac030cf01?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=43371c93f6f0decde339eb55c276d710, https://si.imgix.net/d18a8b51/uploads/origins/ef46ab2a-539d-41ae-8828-c5aac030cf01?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=d70374338bd5b4d2028d872ccaaf7646 2x, https://si.imgix.net/d18a8b51/uploads/origins/ef46ab2a-539d-41ae-8828-c5aac030cf01?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=f407a6df7f703da6f1b008c7c10e364c 3x"}, "body": "氷織賀様、はじめまして。\n以前投稿されていた「パンを食べている女の子」のイラストが本当に可愛らしくて一目惚れし、ぜひ個人VTuber『剣城まひる』のイラストを描いていただきたくリクエストいたしました。\n\n【依頼内容】\nキャラクター：剣城まひる様\nシチュエーション：何かを食べている様子。\n食べているものは、以下の候補の中から氷織賀様が描きやすいと感じるものを一つお選びいただけますでしょうか。(上から希望順です)\n・メロンパン\n・トースト（ハムと目玉焼きが乗ったもの）\n・ポテト\n・お寿司\n・たこ焼き\n\n【構図・仕様】\n・YouTubeのサムネイルに使用したいため、頭の先（髪の毛など）が画面外に切れないような構図でお願いしたいです。\n・可能であれば、背景透過画像（または背景と人物が分かれたPSDデータ）も併せて納品いただけますと大変助かります。\n\n【使用用途】\n・SNSでの活動報告（背景の差し替えや、上に文字を重ねて投稿する場合があります）\n・収益化済みYouTubeチャンネルでのサムネイル\n・案件等の告知画像（※グッズ化には使用いたしません）\n【資料URL】\nキャラクター参考：https://x.com/turugi_mahiru/status/1734197083442483285\n使用感の参考：https://x.com/turugi_mahiru/status/2050379745783910791　https://x.com/turugi_mahiru/status/1998887953322618913?s=20\n氷織賀様の描く「美味しそうに食べる女の子」のタッチで、私の姿が見られるのを楽しみにしております。\nご検討のほど、よろしくお願いいたします。", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@cogamoon/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3859729, "client_id": 3393927, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/24b07135/uploads/origins/97df5991-72ff-486e-98e4-d092e614258e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c895a641e877a628798c01901d08bd50", "srcset": "https://si.imgix.net/24b07135/uploads/origins/97df5991-72ff-486e-98e4-d092e614258e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c895a641e877a628798c01901d08bd50, https://si.imgix.net/24b07135/uploads/origins/97df5991-72ff-486e-98e4-d092e614258e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=9d6c9894d818a610500f1ec20b52094a 2x, https://si.imgix.net/24b07135/uploads/origins/97df5991-72ff-486e-98e4-d092e614258e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=4b0c9e2b664071d543c532cd94185a13 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/24b07135/uploads/origins/97df5991-72ff-486e-98e4-d092e614258e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f990d7a1deb75fdb4cfada168f1b8639", "srcset": "https://si.imgix.net/24b07135/uploads/origins/97df5991-72ff-486e-98e4-d092e614258e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f990d7a1deb75fdb4cfada168f1b8639, https://si.imgix.net/24b07135/uploads/origins/97df5991-72ff-486e-98e4-d092e614258e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=fd66ff52fbe218454ddfb4c8a06171a3 2x, https://si.imgix.net/24b07135/uploads/origins/97df5991-72ff-486e-98e4-d092e614258e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=146cb6edba7c38681419d0f5656fee9e 3x"}, "body": "こーが様\nはじめまして。\n個人で活動している春乃みこと申します。\n\nXでイラストを拝見し、ふんわりとした優しい雰囲気や柔らかいタッチがとても素敵で、ぜひ依頼させていただきたいと思いご連絡いたしました。\n\n【キャラクターについて】\n・20代前半の女の子\n・元気だけど癒し系\n・ピンクがテーマカラー\n・髪色は桜色系のピンク\n・目の色は小豆色に近い紫色\n・目のハイライトが桜型\n※頭のいちご耳のヘッドドレスは着脱式なので外して頂きたいです。\n\n\n【ご依頼内容】\n・パジャマ姿のキャラクター\n・パンをもぐもぐ食べているようなシーン（拝見したイラストの雰囲気がとても可愛かったため、同じようなもぐもぐ表現をお願いできれば嬉しいです）\n・全体的にふんわり・やわらかい雰囲気での制作を希望しております\n・髪型や構図はお任せいたします。\n・可能であれば背景等とレイヤー分けして頂けると助かります。\n\n【使用用途】\n配信活動におけるサムネイル・配信画面・アイコン・SNS投稿など、配信活動全般で使用させていただきたいと考えております。\n※グッズ化・販売用途での使用は予定しておりません。\n\nもし金額不足等ございましたら、再送して頂けたら幸いです。\nご検討いただけましたら幸いです。どうぞよろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/1R3gZEiiLCjjjPQROANdGSkXLN6u-6RU1", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@cogamoon/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3859729, "client_id": 3315053, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/1f9e282e/uploads/origins/0d7e24bf-72c9-41ab-86e3-c1b6ea34fca0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0d4f02ef3dbbcefa6334a42a47c37ab3", "srcset": "https://si.imgix.net/1f9e282e/uploads/origins/0d7e24bf-72c9-41ab-86e3-c1b6ea34fca0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0d4f02ef3dbbcefa6334a42a47c37ab3, https://si.imgix.net/1f9e282e/uploads/origins/0d7e24bf-72c9-41ab-86e3-c1b6ea34fca0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c3d94a60bb1b87ec6aaf4adccb3f78db 2x, https://si.imgix.net/1f9e282e/uploads/origins/0d7e24bf-72c9-41ab-86e3-c1b6ea34fca0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=2a2135d4e384ea69a1315a255b7b6850 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/1f9e282e/uploads/origins/0d7e24bf-72c9-41ab-86e3-c1b6ea34fca0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=697a5c43c6588cfdc1c118b0326f1732", "srcset": "https://si.imgix.net/1f9e282e/uploads/origins/0d7e24bf-72c9-41ab-86e3-c1b6ea34fca0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=697a5c43c6588cfdc1c118b0326f1732, https://si.imgix.net/1f9e282e/uploads/origins/0d7e24bf-72c9-41ab-86e3-c1b6ea34fca0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=53832da6934e20840e6f9c24948e3cf2 2x, https://si.imgix.net/1f9e282e/uploads/origins/0d7e24bf-72c9-41ab-86e3-c1b6ea34fca0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=56f39fc8c5810161629f72cd50268963 3x"}, "body": "氷織賀様\n\n初めまして！氷織賀様の素敵なイラストを拝見し、ぜひ描いていただきたいと思いリクエストさせていただきました✨️\n\nイラストはSNSのアイコン・ヘッダー、個人観賞用として使用させていただきます。\n各種SNSへの投稿に加え、個人観賞目的での印刷をさせていただく場合がございます。商用利用はございません。\nOC資料はリンクからご確認お願いいたします。\n\n氷織賀様の描く食べ物がとてもおいしそうで、もし可能であればキャラクターがハンバーガーを頬張っているようなイラストを描いていただきたいです！ポテトなどのジャンクフードが周りにあるととてもうれしいですが、もし難しければ描いていただかなくても大丈夫です！\n\n顔周りは見切れなしでお願いいたします。\n要望が多く申し訳ございませんが、氷織賀様の描ける範囲で調整していただいて構いません。\n\nお忙しいとは思いますが、ご検討いただけますと幸いです。よろしくお願いいたします！\n\nhttps://drive.google.com/drive/folders/1t6Ng8-zihbHiMAeKBxFbc7WvDF36WQus", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 2136579, "creator": true, "nsfw_acceptable": false, "acceptable": false, "name": "時任 藤@💬", "screen_name": "t_fujigame", "avatar_url": "https://pbs.twimg.com/profile_images/1907091501018214400/z1u2-ddC.jpg", "header_url": "https://pbs.twimg.com/profile_banners/2197532514/1738334263/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 10, "complete_expiration_days": 40, "skills": [{"genre": "art"}], "banned": false, "nc": 161}, {"id": 2956376, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "ねさむま", "screen_name": "YzgHbpMVbQmjzfh", "avatar_url": "https://pbs.twimg.com/profile_images/1803449745945587712/qksy6WYx.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1283755758446768128/1713272694/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 3, "complete_