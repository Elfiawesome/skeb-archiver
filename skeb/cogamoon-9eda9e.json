5bda978-b6db-4441-a7a2-af956dbc4fb9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a60de0590a3c56279a56181e8e7a9fcc", "srcset": "https://si.imgix.net/af692243/uploads/origins/e5bda978-b6db-4441-a7a2-af956dbc4fb9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a60de0590a3c56279a56181e8e7a9fcc, https://si.imgix.net/af692243/uploads/origins/e5bda978-b6db-4441-a7a2-af956dbc4fb9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=95972e33234f86c21ea82e29731f2c6c 2x, https://si.imgix.net/af692243/uploads/origins/e5bda978-b6db-4441-a7a2-af956dbc4fb9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=7c1f0a75069b57125b0a7d057949b861 3x"}, "body": "氷織賀様\n\n初めまして、YouTubeにてVTuberとして活動しております、朝星リオと申します。\n\nXにて可愛らしいもぐもぐイラストを拝見したため、ぜひ私も描いていただきたいと思いリクエストさせていただきました。\n\n以下、キャラクター等の詳細になります。\n\n・描いていただきたいキャラクター\n朝星リオ \n\n・構図\n眠そうな顔で朝ごはんを頬張っている感じ\n(食べるものはおまかせいたします！)\n\n・服装\n資料内のパジャマイラストの半袖バージョンで描いていただけますと幸いです。\n細かいアレンジなどしていただいても構いません。\n目の中の星と水色のネイルをしています\n\n・髪型\n資料内のパジャマイラストのような髪型でお願いします\n寝癖など寝起きっぽくアレンジしていただいても構いません。\n髪色につきましては、黒髪×インナーカラー青色でお願いいたします。\n\n・使用用途\nYouTubeサムネイル、配信、動画内への使用(YouTube収益化済みです)\nXでの画像添付\n各種SNSアイコン\n\n・要望\nサムネイル等に使用したいため、上左右見切れなしで制作していただけますと幸いです。\n人物のみの透過もいただけますと幸いです。\n基本は氷織賀様のお好きに描いていただければと思います。\n\nお忙しい中とは思いますが、ご検討の程よろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/1lKd4ripsfLgnpF0RpYB87H-P3gfW3M-j", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@cogamoon/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3859729, "client_id": 3880179, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/456dcfd7/uploads/origins/dfcbdc58-1c3c-4861-9c33-566c45892ec4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2812900b7b2ccfe266f87dc997965160", "srcset": "https://si.imgix.net/456dcfd7/uploads/origins/dfcbdc58-1c3c-4861-9c33-566c45892ec4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2812900b7b2ccfe266f87dc997965160, https://si.imgix.net/456dcfd7/uploads/origins/dfcbdc58-1c3c-4861-9c33-566c45892ec4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=cbf5b1f0f68115246b7f1426f6fc49eb 2x, https://si.imgix.net/456dcfd7/uploads/origins/dfcbdc58-1c3c-4861-9c33-566c45892ec4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=7bb2b58e8c0130390fb45032781d2cd1 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/456dcfd7/uploads/origins/dfcbdc58-1c3c-4861-9c33-566c45892ec4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=4397bc6ddb850986a7bb491eabf67b3e", "srcset": "https://si.imgix.net/456dcfd7/uploads/origins/dfcbdc58-1c3c-4861-9c33-566c45892ec4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=4397bc6ddb850986a7bb491eabf67b3e, https://si.imgix.net/456dcfd7/uploads/origins/dfcbdc58-1c3c-4861-9c33-566c45892ec4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=d1b686bcef36e3bc7ad7e5c5c53c3f54 2x, https://si.imgix.net/456dcfd7/uploads/origins/dfcbdc58-1c3c-4861-9c33-566c45892ec4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=81d33f1aa4393f80da187ae2d077e234 3x"}, "body": "氷織賀さま\n\nはじめまして！むと申します🌷\nこの度はTLにて先生のとっても素敵なイラストをお見かけし、もぐもぐイラストの食べ物のリアルな質感やキラキラした塗りの質感が本当に魅力的で、ぜひうちの子を描いて頂きたく、リクエストの方失礼致します🙌🏻\n\nお姿に関しましては添付させていただく資料を参考にしてください！(服装や髪型など思いのままに、先生が好きなようにデザインしてくださったりアレンジを加えてくださったりしても構いません◎)\n\nキャラクターのモチーフデザインは\nあざらし✖️青いお花(ブルースター)✖️雪です！\n\n見づらいお顔周りの特徴に関する追記です！\n・まろ眉\n・八重歯\n・瞳の瞳孔が雪の結晶の形\n・前髪と横髪に白メッシュ\n\n構図やポーズ、描写範囲も全ておまかせ致します！\nせっかくなのでもぐもぐシリーズ(食べ物の種類に指定はございませんが、色んな種類のスイーツなど少しモリモリ系でぜひ先生の美味しそうな料理をたくさん見たく存じます🤤)の仲間入りしたいということだけはご要望として記入しておきます🎶\n\n料金や内容等、合わないもしくは不備がある等ございましたら、お手数お掛けしますが、キャンセルして頂ければ幸いです🥲\n\nどうぞ素敵なご縁がありましたらよろしくお願い致します！\n\nhttps://www.dropbox.com/scl/fo/csunmc1ao1ke5khgvoe3h/AAmm5Fg7--LuQ3ubDrDnpxY?rlkey=xj1x7pd7ytwlgmpjyag4sxdcx&st=m1ctb81k&dl=0", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@cogamoon/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3859729, "client_id": 1983560, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/d18a8b51/uploads/origins/ef46ab2a-539d-41ae-8828-c5aac030cf01?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a0f43d18fab7024771a1b3c0f12a8cc1", "srcset": "https://si.imgix.net/d18a8b51/uploads/origins/ef46ab2a-539d-41ae-8828-c5aac030cf01?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a0f43d18fab7024771a1b3c0f12a8cc1, https://si.imgix.net/d18a8b51/uploads/origins/ef46ab2a-539d-41ae-8828-c5aac030cf01?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=597541add26a01d4c536e9a4fc9245dc 2x, https://si.imgix.net/d18a8b51/uploads/origins/ef46ab2a-539d-41ae-8828-c5aac030cf01?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=1103d10b455b98eef3af16b7cede0991 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/d18a8b51/uploads/origins/ef46ab2a-539d-41ae-8828-c5aac030cf01?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=43371c93f6f0decde339eb55c276d710", "srcset": "https://si.imgix.net/d18a8b51/uploads/origins/ef46ab2a-539d-41ae-8828-c5aac030cf01?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=43371c93f6f0decde339eb55c276d710, https://si.imgix.net/d18a8b51/uploads/origins/ef46ab2a-539d-41ae-8828-c5aac030cf01?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=d70374338bd5b4d2028d872ccaaf7646 2x, https://si.imgix.net/d18a8b51/uploads/origins/ef46ab2a-539d-41ae-8828-c5aac030cf01?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=f407a6df7f703da6f1b008c7c10e364c 3x"}, "body": "氷織賀様、はじめまして。\n以前投稿されていた「パンを食べている女の子」のイラストが本当に可愛らしくて一目惚れし、ぜひ個人VTuber『剣城まひる』のイラストを描いていただきたくリクエストいたしました。\n\n【依頼内容】\nキャラクター：剣城まひる様\nシチュエーション：何かを食べている様子。\n食べているものは、以下の候補の中から氷織賀様が描きやすいと感じるものを一つお選びいただけますでしょうか。(上から希望順です)\n・メロンパン\n・トースト（ハムと目玉焼きが乗ったもの）\n・ポテト\n・お寿司\n・たこ焼き\n\n【構図・仕様】\n・YouTubeのサムネイルに使用したいため、頭の先（髪の毛など）が画面外に切れないような構図でお願いしたいです。\n・可能であれば、背景透過画像（または背景と人物が分かれたPSDデータ）も併せて納品いただけますと大変助かります。\n\n【使用用途】\n・SNSでの活動報告（背景の差し替えや、上に文字を重ねて投稿する場合があります）\n・収益化済みYouTubeチャンネルでのサムネイル\n・案件等の告知画像（※グッズ化には使用いたしません）\n【資料URL】\nキャラクター参考：https://x.com/turugi_mahiru/status/1734197083442483285\n使用感の参考：https://x.com/turugi_mahiru/status/2050379745783910791　https://x.com/turugi_mahiru/status/1998887953322618913?s=20\n氷織賀様の描く「美味しそうに食べる女の子」のタッチで、私の姿が見られるのを楽しみにしております。\nご検討のほど、よろしくお願いいたします。", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@cogamoon/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3859729, "client_id": 3393927, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/24b07135/uploads/origins/97df5991-72ff-486e-98e4-d092e614258e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c895a641e877a628798c01901d08bd50", "srcset": "https://si.imgix.net/24b07135/uploads/origins/97df5991-72ff-486e-98e4-d092e614258e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c895a641e877a628798c01901d08bd50, https://si.imgix.net/24b07135/uploads/origins/97df5991-72ff-486e-98e4-d092e614258e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=9d6c9894d818a610500f1ec20b52094a 2x, https://si.imgix.net/24b07135/uploads/origins/97df5991-72ff-486e-98e4-d092e614258e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=4b0c9e2b664071d543c532cd94185a13 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/24b07135/uploads/origins/97df5991-72ff-486e-98e4-d092e614258e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f990d7a1deb75fdb4cfada168f1b8639", "srcset": "https://si.imgix.net/24b07135/uploads/origins/97df5991-72ff-486e-98e4-d092e614258e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f990d7a1deb75fdb4cfada168f1b8639, https://si.imgix.net/24b07135/uploads/origins/97df5991-72ff-486e-98e4-d092e614258e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=fd66ff52fbe218454ddfb4c8a06171a3 2x, https://si.imgix.net/24b07135/uploads/origins/97df5991-72ff-486e-98e4-d092e614258e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=146cb6edba7c38681419d0f5656fee9e 3x"}, "body": "こーが様\nはじめまして。\n個人で活動している春乃みこと申します。\n\nXでイラストを拝見し、ふんわりとした優しい雰囲気や柔らかいタッチがとても素敵で、ぜひ依頼させていただきたいと思いご連絡いたしました。\n\n【キャラクターについて】\n・20代前半の女の子\n・元気だけど癒し系\n・ピンクがテーマカラー\n・髪色は桜色系のピンク\n・目の色は小豆色に近い紫色\n・目のハイライトが桜型\n※頭のいちご耳のヘッドドレスは着脱式なので外して頂きたいです。\n\n\n【ご依頼内容】\n・パジャマ姿のキャラクター\n・パンをもぐもぐ食べているようなシーン（拝見したイラストの雰囲気がとても可愛かったため、同じようなもぐもぐ表現をお願いできれば嬉しいです）\n・全体的にふんわり・やわらかい雰囲気での制作を希望しております\n・髪型や構図はお任せいたします。\n・可能であれば背景等とレイヤー分けして頂けると助かります。\n\n【使用用途】\n配信活動におけるサムネイル・配信画面・アイコン・SNS投稿など、配信活動全般で使用させていただきたいと考えております。\n※グッズ化・販売用途での使用は予定しておりません。\n\nもし金額不足等ございましたら、再送して頂けたら幸いです。\nご検討いただけましたら幸いです。どうぞよろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/1R3gZEiiLCjjjPQROANdGSkXLN6u-6RU1", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@cogamoon/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3859729, "client_id": 3315053, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/1f9e28