mat%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=3fa61d7e154620abb27aa7f9ecd7fbc9 2x, https://si.imgix.net/adf5ebed/uploads/origins/d65b8763-2a12-464c-86f2-e345d87d9db0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=baa7e9c29196a6f224f18361e3248656 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/adf5ebed/uploads/origins/d65b8763-2a12-464c-86f2-e345d87d9db0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=021b2b4369b587db6a43ebac3c873c5b", "srcset": "https://si.imgix.net/adf5ebed/uploads/origins/d65b8763-2a12-464c-86f2-e345d87d9db0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=021b2b4369b587db6a43ebac3c873c5b, https://si.imgix.net/adf5ebed/uploads/origins/d65b8763-2a12-464c-86f2-e345d87d9db0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=4c9f9c66ba99426217b30711f73daebb 2x, https://si.imgix.net/adf5ebed/uploads/origins/d65b8763-2a12-464c-86f2-e345d87d9db0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=9802087bbd228c9b5cbe95a0e022969d 3x"}, "body": "初めまして。すなじろと申します。\n涼川あめのさんの描かれるソラミド、かたつむりの創作ちゃんなどいつも楽しみにしております！\nパステルな色使いと服のデザイン、お顔の描き方がものすごく好みで、ぜひよろしければうちの子であるノラちゃんをお願いしたいと思いリクエストを送信しました。\n\nノラちゃんは、狐をモチーフとしたけもみみとしっぽのある、10代半ばのやや小柄な女の子です。\n（設定上は普通の人間耳も存在する四つ耳っ子ですが、描写はお任せします）\nふさふさの金髪に、眠たげな青い目をしていて、口元には八重歯があります。\nトレードマークの青い眼鏡をおでこにひっかけています。\n性格は寝たりのんびりしたりなど、だらけることが好きで、休むために努力をするタイプです。\n\n服装は青いパーカー+黒のハーフパンツという服装をしていることが多いですが、ぜひ自由な発想で衣装のデザインをしていただければ嬉しいです。\n元の衣装を参考にしてアレンジしても、大幅に変えてしまっても大丈夫です。\nソラミドちゃんたちのように動きやすそうな服装でも、創作ちゃんが着ている服装のような女の子らしい服装でも、お好きなお洋服を着せてください。\n勿論デフォルト衣装でも構いませんので、楽しく描いていただければ何よりです！\n\nその他の事項、構図やポーズなどはお任せします。\n納品形式は、背景の透過が可能なPSDファイルがありますと嬉しいです。\n\n資料が過去のSkebリクエストのみであることをご容赦ください。\n頂いたイラストは、私の所有するSNS等のアカウントにてアイコン・ヘッダーとして使用することがあります。\nよろしくお願いします！\n\nhttps://skeb.jp/@sunajiro8", "nc": 17, "word_count