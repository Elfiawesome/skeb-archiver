1/uploads/origins/3d4f1343-1907-4709-8a4a-720a56a82352?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b287f5a021eb76ddac30b62e1d8a8e60 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/4ae26b91/uploads/origins/3d4f1343-1907-4709-8a4a-720a56a82352?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=02359437fc0eca83e74cfc90e50ec10b", "srcset": "https://si.imgix.net/4ae26b91/uploads/origins/3d4f1343-1907-4709-8a4a-720a56a82352?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=02359437fc0eca83e74cfc90e50ec10b, https://si.imgix.net/4ae26b91/uploads/origins/3d4f1343-1907-4709-8a4a-720a56a82352?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=777f5fb068421225caad8ec646148332 2x, https://si.imgix.net/4ae26b91/uploads/origins/3d4f1343-1907-4709-8a4a-720a56a82352?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=f3657776f531b68c7c6dd6c17f9af827 3x"}, "body": "再びこんにちは！こんなイラストを考えています：\nヲ級と駆逐棲姫が映画館でウマ娘を見ている。\n二人ともとても興奮した様子でマンハッタンカフェを応援しています。\n二人とも「ゴー！ゴー！マンハッタンカフェ！\"\n\n登場人物\n-ヲ級｜ヲ級\n-駆逐艦姫｜駆逐棲姫", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Sakuccccchi/works/8", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2206452, "client_id": 23850, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/ca85b768/uploads/origins/c8e082dc-bf51-4706-9bef-70199d932796?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c02839a21f2d3879391c35d307d873f9", "srcset": "https://si.imgix.net/ca85b768/uploads/origins/c8e082dc-bf51-4706-9bef-70199d932796?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c02839a21f2d3879391c35d307d873f9, https://si.imgix.net/ca85b768/uploads/origins/c8e082dc-bf51-47