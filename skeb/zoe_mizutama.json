": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/639b5c61/uploads/origins/b208725d-372e-44a1-803e-2becde17060d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ee4a5c553470f821cb22e6776c3ef6a0", "srcset": "https://si.imgix.net/639b5c61/uploads/origins/b208725d-372e-44a1-803e-2becde17060d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ee4a5c553470f821cb22e6776c3ef6a0, https://si.imgix.net/639b5c61/uploads/origins/b208725d-372e-44a1-803e-2becde17060d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=bd56937921d253002a4ede1c8b00c1d8 2x, https://si.imgix.net/639b5c61/uploads/origins/b208725d-372e-44a1-803e-2becde17060d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=5ae3b933c50297067b20634373921b58 3x"}, "body": "こんにちは！神楽坂さんのファンアートには以前からとても憧れていました！もしよろしければ、私の2つのキャラクターを描いてほしいです。\n\n一人目は物静かな剣の使い手で、かわいい性格と彼女が振るう巨大な剣（https://photos.app.goo.gl/oGYh3HQnJ3chbRqU7）とのコントラストがきつい。彼女は刀に恋していると言っても過言ではなく、刀を振るうことへの欲望と強い正義感だけが彼女を支えている。\n\nもう一人はヴァンパイア（https://photos.app.goo.gl/FfmEpSDYWAkMwTUQ6）。一種冷徹で残酷なタイプだが、モンスターハンターに深い興味を抱いている。彼女は驚異的な再生能力を持ち、殺すことは不可能であるため、自由時間のほとんどすべてをモンスターハンターをもてあそび、いかにして彼女の神経を逆なでできるかに費やしている。\n\n私が考えていたのは、ハンターが受けた戦いの傷を、ヴァンパイアが戯れに抱きしめたり舐めたりするシーンだ。天敵であることを禁じられた二人の奇妙な、敵対的な、時には愛情深い関係を示すような何か。服装やシーンの改変はご自由にどうぞ。どんなものが出来上がるか、ぜひ見てみたいです\n\nありがとうございました！", "nc": 40, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}], "sent_works": [], "similar_creators": [{"id": 19297, "creator": true, "nsfw_acceptable": false, "acceptable": false, "name": "宇野山 むじ", "screen_name": "uimss", "avatar_url": "https://pbs.twimg.com/profile_images/1833036325219614720/bpzc2qBP.jpg", "header_url": "https://pbs.twimg.com/profile_banners/80830269/1749634563/1500x500", "appeal_receivable": true, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted