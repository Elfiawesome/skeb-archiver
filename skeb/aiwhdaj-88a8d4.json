事務補助員という関係でもある。\n\n\nどうぞお好きなように描いてください！いくつかの衣装セットがありますので、自由に選んでいただけます！特別な要件はありません。\n金額が合わなければ再送してもらうことも可能です。お読みいただきありがとうございました！\n\n・参考URL:\nhttps://drive.google.com/drive/folders/1zvwiSSK-yH9T7Jps08AVp6ZH7_npQe8k?usp=sharing", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@aiwhdaj/works/8", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3948861, "client_id": 3632098, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/e1b14637/uploads/origins/075c6e49-2579-4c3f-90bd-75f4094d9712?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4de56d2ddd82b6fd8b1501f916eaadc5", "srcset": "https://si.imgix.net/e1b14637/uploads/origins/075c6e49-2579-4c3f-90bd-75f4094d9712?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4de56d2ddd82b6fd8b1501f916eaadc5, https://si.imgix.net/e1b14637/uploads/origins/075c6e49-2579-4c3f-90bd-75f4094d9712?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=2682269876ad4c7b9df3fa71ccecb868 2x, https://si.imgix.net/e1b14637/uploads/origins/075c6e49-2579-4c3f-90bd-75f4094d9712?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=1ad5bfd990ed3939b3155b1245796079 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/e1b14637/uploads/origins/075c6e49-2579-4c3f-90bd-75f4094d9712?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=30f5d77088d93c21a408c50cc8f6d73a", "srcset": "https://si.imgix.net/e1b14637/uploads/origins/075c6e49-2579-4c3f-90bd-75f4094d9712?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=30f5d77088d93c21a408c50cc8f6d73a, https://si.imgix.net/e1b14637/uploads/origins/075c6e49-2579-4c3f-90bd-75f4094d9712?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=a