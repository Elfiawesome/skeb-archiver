なキャラクターです。彼の右目（金色で星が散りばめられた目）は、どんなに凄惨であれ、あるいは輝かしいものであれ、彼が見ている人々の未来の可能性を常に映し出しています。 この能力は自分自身には効かないため、彼は夢を持たず、自分の健康を顧みずに、愛する人たちが最良の結果にたどり着けるよう手助けすることを決意しています。表面的には夢見がちでロマンチックに見えますが、実は深く自己認識しており、自分自身の夢は持っていません。\n\n彼のコートはマントを彷彿とさせるデザインで、杖の中にはレイピアを隠しています。\n\n構図については、星の目（アイ・オブ・スター）を少し強調していただけるとありがたいですが、描く際はご自由に、お好きなように描いてください！\n\nご検討いただきありがとうございます！\n\nhttps://imgur.com/a/accidia-DKSue1y", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@aiwhdaj/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3948861, "client_id": 1924231, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/0a7f42b1/uploads/origins/6fd2e3c6-86cc-4e68-94b2-c1fa2e3a50c8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4a42ef60a1a3895820a826c98a696800", "srcset": "https://si.imgix.net/0a7f42b1/uploads/origins/6fd2e3c6-86cc-4e68-94b2-c1fa2e3a50c8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4a42ef60a1a3895820a826c98a696800, https://si.imgix.net/0a7f42b1/uploads/origins/6fd2e3c6-86cc-4e68-94b2-c1fa2e3a50c8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=690b1922751c97573272f1cb417c0def 2x, https://si.imgix.net/0a7f42b1/uploads/origins/6fd2e3c6-86cc-4e68-94b2-c1fa2e3a50c8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c1173f54f1c3dec38fc73d82d94d970e 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/0a7f42b1/uploads/origins/6fd2e3c6-86cc-4e68-94b2-c1fa2e3a50c8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=efc104a7617d9cd4f3bf2009e8facc28", "srcset": "https://si.imgix.net/0a7f42b1/uploads/origins/6fd2e3c6-86cc-4e68-94b2-c1fa2e3a50c8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=efc104a7617d9cd4f3bf2009e8facc28, https://si.i