": "こんにちは\n\n先日はステキなイラストをありがとうございました。\n\nまた赤いメガネの女の子のイラストをリクエストします。\n\n・水色のジャンパースカートの制服（スカートはひざ丈）\n・普段あまり表情が変わらない女の子がしゃがみ込んで猫をなでていて、控えめに笑顔になっているイメージです\n\n・今回の子はロングの髪にしてください。耳が見えると嬉しいです。\n\nよろしくお願いします。", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@harusame0104/works/9", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1116199, "client_id": 882456, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/75346e20/uploads/origins/fa223fee-7edd-4c0a-bc62-5645fbfa9805?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e3e19e22004d7668629eeba271191126", "srcset": "https://si.imgix.net/75346e20/uploads/origins/fa223fee-7edd-4c0a-bc62-5645fbfa9805?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e3e19e22004d7668629eeba271191126, https://si.imgix.net/75346e20/uploads/origins/fa223fee-7edd-4c0a-bc62-5645fbfa9805?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=69b2c577fbb91980f1fb716f9b2b6f27 2x, https://si.imgix.net/75346e20/uploads/origins/fa223fee-7edd-4c0a-bc62-5645fbfa9805?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e971e3ffc6f5425e12703eee86a7a1d2 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/75346e20/uploads/origins/fa223fee-7edd-4c0a-bc62-5645fbfa9805?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=af678caf4ab048a114707fa586c21d2b", "srcset": "https://si.imgix.net/75346e20/uploads/origins/fa223fee-7edd-4c0a-bc62-5645fbfa9805?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=af678caf4ab048a114707fa586c21d2b, https://si.imgix.net/75346e20/uploads/origins/fa223fee-7edd-4c0a-bc62-5645fbfa9805?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=1d136eae1053890da318bde