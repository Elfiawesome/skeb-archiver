-be9a-4b10-9c77-2bc5d2ea7ab9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e2ecc7ee45a4dac0c7eddce9d64fb02a, https://si.imgix.net/af4fa221/uploads/origins/629378cd-be9a-4b10-9c77-2bc5d2ea7ab9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=993ce7b2b4470871b523e3e2bdcdea71 2x, https://si.imgix.net/af4fa221/uploads/origins/629378cd-be9a-4b10-9c77-2bc5d2ea7ab9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=02f21544b6b10217c345529e9aeaf030 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/af4fa221/uploads/origins/629378cd-be9a-4b10-9c77-2bc5d2ea7ab9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=01d9b175d957a30f95a875c86e49eaa7", "srcset": "https://si.imgix.net/af4fa221/uploads/origins/629378cd-be9a-4b10-9c77-2bc5d2ea7ab9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=01d9b175d957a30f95a875c86e49eaa7, https://si.imgix.net/af4fa221/uploads/origins/629378cd-be9a-4b10-9c77-2bc5d2ea7ab9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=58e13ecf5bac898029af413206dbdbf7 2x, https://si.imgix.net/af4fa221/uploads/origins/629378cd-be9a-4b10-9c77-2bc5d2ea7ab9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=9fd4957f0cc6990b3e916fc7d6288ac9 3x"}, "body": "霧田ろじ様\n\n以前イラストを頂きました、秋田蕗ミオと申します。\nその節はありがとうございました！\n頂いたイラストは今でもお気に入りです。\n\n霧田ろじ様のXアカウントをお見かけしまして、スケブの募集もされていたので、よければイラストをまた描いていただきたいなと思いご連絡いたしました。\n下記リクエスト内容になります。\nご無理のない範囲で、ご検討いただけますと幸いです。\n\n【描いていただきたいキャラクター(自分について)】\n〇名前\n秋田蕗ミオ\n…VTuberとして活動しております。秋田蕗の葉(よく傘代わりに使われる大きな葉)がイメージモチーフです。\n〇容姿\nリンク先の立ち絵をご参照ください\n〇性格\n・マイペースで基本ふわふわしているおっとり系\n・たまに鋭い発言をする\n\n【使用用途】\n・Xでの投稿\n・X、YouTubeのヘッダー\n・YouTube配信、動画のサムネイル\n上記を検討しております。\n\n【ファイル形式】\npng\n\n【イラスト詳細】\n〇ポーズ、表情\nお任せいたします。\n\n〇背景\nお任せいたしますが、背景を透過したものも頂けますと嬉しいです。\n\n以上になります。\nどうぞよろしくお