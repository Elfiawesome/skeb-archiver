bp&fit=crop&crop=top&w=200&h=200&blur=200&s=7e12577fd6f1c8d564263e410f148470", "src_set": ""}, "body": "こんばんは、いつもお世話になっております。\n\n【Fate/Grand Order】のキングプロテアオルタ（黒色のヴェール？を取った方の姿）でイラスト依頼させて頂きたく、リクエスト送らせていただきました。\n構図等お任せでお願い致します。\nお忙しいところ恐れ入りますが、ご検討頂けますと幸いです。", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@emoillu/works/62", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 267, "client_id": 3536147, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/75212ed7/uploads/origins/2fc4bbba-65b5-47e7-adc3-b5fc000dd754?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3e1bb55eaea870043cf268408ed39e81", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/75212ed7/uploads/origins/2fc4bbba-65b5-47e7-adc3-b5fc000dd754?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=cffd44db1bc21886dd2f1082391d031b", "src_set": ""}, "body": "FGOの北斎or馬琴を描いていただきたいです(どちらか一方のキャラのみで大丈夫です)\nもし他に描きたいキャラがいましたら、そちらで全く問題ありません。\n構図や衣装なども全てお任せします。\nリクエストを送るのは初めてなので、何か不備がありましたら申し訳ございません。", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@emoillu/works/61", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 267, "client_id": 0, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/c5b06920/uploads/origins/a40e55ae-f4c6-41bc-9f95-5744f35c7bc0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bacd84d634ad2e7b53198e960c7cdbcb", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/c5b06920/uploads/origins/a40e55ae-f4c6-41bc-9f95-5744f35c7bc0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=71ff3e92d6188d0