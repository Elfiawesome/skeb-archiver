drive.google.com/drive/folders/1bJxCkJ-_1fYbhUNi7cy-yz_durVy6_CF\n\n昼間の明るく賑わった感じというよりは、黄昏～真夜中時のサーカスをイメージしていただけますと幸いです。(説明下手ですみません💦🙏)\nサーカステント内の薄暗い空間に照明の反射で艷めく赤い重厚なカーテン、紙吹雪がキラキラ舞っているような……\nイメージカラーはワインレッドと青色です。(必ずしも重要な色ではありません)\n\nイラストはパソコンの壁紙にしたいと考えているので、横向き(もし可能であればアスペクト比16:9)で描いて頂きたいです。\nよろしくお願いします。\n\nhttps://drive.google.com/drive/folders/1--0mo5_MD50MQy1cKTSrkB4imE5eMa7l", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@kakarichokacho/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1509110, "client_id": 2621542, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/c948079c/uploads/origins/abf05a89-4891-4781-9b4c-f152dfeabca7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0f352b9700afd6c12d42480cdb5cece5", "srcset": "https://si.imgix.net/c948079c/uploads/origins/abf05a89-4891-4781-9b4c-f152dfeabca7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0f352b9700afd6c12d42480cdb5cece5, https://si.imgix.net/c948079c/uploads/origins/abf05a89-4891-4781-9b4c-f152dfeabca7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=82120d917a74ee7712ec0c7fe4177276 2x, https://si.imgix.net/c948079c/uploads/origins/abf05a89-4891-4781-9b4c-f152dfeabca7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c7f6d7dfbea2743dded1cd1a25b12156 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/c948079c/uploads/origins/abf05a89-4891-4781-9b4c-f152dfeabca7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=234eb954943ad387e3403f53f0405f53", "srcset": "https://si.imgix.net/c948079c/uploads/origins/abf05a89-4891-4781-9b4c-f152dfeabca7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=234eb954943ad387e3403f53f0405f53, https://si.i