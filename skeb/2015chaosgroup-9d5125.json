t/71353cf6/uploads/origins/a1efd813-49ef-4ad1-99a8-63942dc9a99c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=1a9a83ce0b4d235810c376b34cd23fd8 3x"}, "body": "上村なびあさん、こんにちは。\nあらた伊里(@aratairi)先生の百合漫画『とどのつまりの有頂天』、『雨でも晴れでも』の二次創作イラストを依頼したいです。ジャンルは百合でお願いします。\n\n【キャラクター】\n・熊倉タクヤ\n・兎田夜空\n\n【シチュエーション】\n二人の仲睦まじい様子が描かれていれば、後はお任せいたします\n距離は近めで\n\n【衣装】\n下記に記載のURL一つ目にある制服姿でお願いします。\nただ夜空の髪は、『雨でも晴れでも』3巻表紙のような長髪・水色寄りでお願いします。\n\n【資料】\nこちら、作者さんのTwitterに掲載されている分です。\n一つ目のURLのツイートに立ち絵があります。\nhttps://twitter.com/aratairi/status/1009526303572123649\nhttps://twitter.com/aratairi/status/1038879715988303875\n\nただし、何分用意できる資料が少ないのもあるので、\nいつでもキャンセルして下さっても構いません。\nご検討の程、よろしくお願い致します。", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@2015chaosgroup/works/12", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 669364, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/3dbc76a7/uploads/origins/8a080877-bcdc-4467-8d09-c9c81fbd56c8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=87960ce506775385d8532b77fc52fc01", "srcset": "https://si.imgix.net/3dbc76a7/uploads/origins/8a080877-bcdc-4467-8d09-c9c81fbd56c8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=87960ce506775385d8532b77fc52fc01, https://si.imgix.net/3dbc76a7/uploads/origins/8a080877-bcdc-4467-8d09-c9c81fbd56c8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=420b712199a3275bc5944a71032cb9a5 2x, https://si.imgix.net/3dbc76a7/uploads/origins/8a080877-bcdc-4467-8d09-c9c81fbd56c8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=280f508752b04cef6615c50160e3d46e 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/3dbc76a7/uploads/origins/8a080877-bcdc-4467-8d09-c9c81fbd56c8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5e1a18070672dbe888f75edafcb98d8f", "srcset": "https://si.imgix.net/3dbc76a7/uploads/origins/8a080877-bcdc-4467-8d09-c9c81fbd56c8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5e1a18070672dbe888f75edafcb98d8f, https://si.imgix.net/3dbc76a7/uploads/origins/8a080877-bcdc-4467-8d09-c9c81fbd56c8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=e1199a26034e9e315c67f5ca03b5f471 2x, https://si.imgix.net/3dbc76a7/uploads/origins/8a080877-bcdc-4467-8d09-c9c81fbd56c8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=7527d9a6a15906a90547361f036c7293 3x"}, "body": "イラストのリクエストをお願いしたいです。\n\n①作品＆キャラ\nFE風花雪月無双の主人公（女性）とリシテア=フォン=コーデリア\n②イラストのシチュエーション\n・主人公（女性）がリシテアを自分の膝の上に座らせてお菓子を食べさせている。\n・さり気なく、主人公（女性）のもう片方の手がリシテアのスカートの中にinしている。\n・それ以外のことについてはお任せしたいです。\n\nよろしくお願いします。\n\nhttps://www.gamecity.ne.jp/fe_fs/", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@2015chaosgroup/works/11", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 669364, "client_id": 1306623, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/d7dc0f0f/uploads/origins/8015de00-6fc4-46f0-ac63-5ecc03ffdabc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=95344094172fc9223baa9cfbcea948c8", "srcset": "https://si.imgix.net/d7dc0f0f/uploads/origins/8015de00-6fc4-46f0-ac63-5ecc03ffdabc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=95344094172fc9223baa9cfbcea948c8, https://si.imgix.net/d7dc0f0f/uploads/origins/8015de00-6fc4-46f0-ac63-5ecc03ffdabc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=919f81f07305e615fed7a61de25cee4e 2x, https://si.imgix.net/d7dc0f0f/uploads/origins/8015de00-6fc4-46f0-ac63-5ecc03ffdabc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=bed41f46f46813ad017dbe4cbec09f97 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/d7dc0f0f/uploads/origins/8015de00-6fc4-46f0-ac63-5ecc03ffdabc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=cd686a7ddeae8aeafa10c3726a22a1a2", "srcset": "https://si.imgix.net/d7dc0f0f/uploads/origins/8015de00-6fc4-46f0-ac63-5ecc03ffdabc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=cd686a7ddeae8aeafa10c3726a22a1a2, https://si.imgix.net/d7dc0f0f/uploads/origins/8015de00-6fc4-46f0-ac63-5ecc03ffdabc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=61053a1b71b9b72c9d2b7843297dd29e 2x, https://si.imgix.net/d7dc0f0f/uploads/origins/8015de00-6fc4-46f0-ac63-5ecc03ffdabc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=0bcfebf3ea9a5c7f5515283c0a7997fa 3x"}, "body": "こんにちは、@_master117です。百合をテーマにしたお絵描きをお願いしたいです。恋する超新人VTuber2人を応援したいです。\n\nhttps://twitter.com/WalkyriaLiora\nhttps://i.imgur.com/WSQSZ9V.jpeg\n#ウォーキーリアート\n\nhttps://twitter.com/LofiWiseman\nhttps://i.imgur.com/sWC5ozU.jpeg\n#ペネット\n\n作画では、好きな百合ポーズで見てみたいです。でも、手加減は必要です。最近のリコリス反動のアートワークに近いかも。\n\nお花畑の中に立っていて、髪には夏のイメージで花をつけてほしいです。もし必要であれば、彼らはサマードレスや普段の服装を身につけることができます。\n\nもし可能であれば、完成後、私のpixivのページで作品を使用したいです。もちろん、あなたのページへのリンク付きで。\n\n金額は十分かどうか教えてください。", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@2015chaosgroup/works/10", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 669364, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/545324cb/uploads/origins/639fe65d-d09b-417f-97f2-8287b0843ed6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7cae76496be905ef08571b26c87c762b", "srcset": "https://si.imgix.net/545324cb/uploads/origins/639fe65d-d09b-417f-97f2-8287