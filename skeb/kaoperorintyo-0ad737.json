f11c1d1 3x"}, "duration": null, "nsfw": true, "hardcore": true, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/66c6daee/uploads/origins/ae8cb514-454b-4dff-8e1f-521da91569ee?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a9e3e9bbf771c35048f4c29f3ea19e59", "srcset": "https://si.imgix.net/66c6daee/uploads/origins/ae8cb514-454b-4dff-8e1f-521da91569ee?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a9e3e9bbf771c35048f4c29f3ea19e59, https://si.imgix.net/66c6daee/uploads/origins/ae8cb514-454b-4dff-8e1f-521da91569ee?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=7dff797290335ac2470f0efeaaa7ffb7 2x, https://si.imgix.net/66c6daee/uploads/origins/ae8cb514-454b-4dff-8e1f-521da91569ee?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=ac3ea4b8c3456f92132ae73301c5c4a6 3x"}, "body": "こんにちは！今回も幼稚園キサキでお世話になりました！長くなってしまいましたが、またのご依頼をご検討いただければ幸いです。\n\nキャラクターはBlue Archiveの丹花イブキです。キサキの仕上がりがとても気に入ったので、同じような感じでお願いします。太った年上の男性、妊娠前と妊娠後の彼女を見る、腹ヘイロー、怪しい同意（催眠術はお任せします）。また、イブキの無邪気さを強調していただけるとありがたいです。それ以外の細かいことはお任せします。\n\n機械翻訳で不鮮明でしたら申し訳ありません。よろしくお願いします！", "nc": 59, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@kaoperorintyo/works/15", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 306755, "client_id": 166544, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/6faf6eb1/uploads/origins/f5dd55f0-5c8e-496c-b153-11abc6755e48?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7a76a95e388aeb08e92fe8b551117aed", "srcset": "https://si.imgix.net/6faf6eb1/uploads/origins/f5dd55f0-5c8e-496c-b153-11abc6755e48?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7a76a95e388aeb08e92fe8b551117aed, https://si.imgix.net/6faf6eb1/uploads/origins/f5dd55f0-5c8e-496c-b153-11abc6755e48?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c09631be1a7fa017b0a6e105966a8872 2x, https://si.imgix.net/6faf6eb1/uploads/origins/f5dd55f0-5c8e-496c-b153-11abc6755e48?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=cec88fc9d56ccaf7452c6c4f463ca57f 3x"}, "duration": null, "nsfw": true, "hardcore": true, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/6faf6eb1/uploads/origins/f5dd55f0-5c8e-496c-b153-11abc6755e48?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=02b2242c553230a4baa21888db640f30", "srcset": "https://si.imgix.net/6faf6eb1/uploads/origins/f5dd55f0-5c8e-496c-b153-11abc6755e48?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=02b2242c553230a4baa21888db640f30, https://si.imgix.net/6faf6eb1/uploads/origins/f5dd55f0-5c8e-496c-b153-11abc6755e48?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=b7b38417416d6280505de87940b356c3 2x, https://si.imgix.net/6faf6eb1/uploads/origins/f5dd55f0-5c8e-496c-b153-11abc6755e48?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=be96f25340d158273fbfc458a66be975 3x"}, "body": "ブルーアーカイヴの木崎（竜華キサキ）の作品をお願いします。幼稚園の衣装を着て、年上の男性と催眠セックスをしています。視点は男性です。\n\n体位は種付けプレス。木崎のシャツは胸とへそを見せるために持ち上げられる。スカートは太もものあたりで、パンティは横に引っ張られている。彼女の口からは唾液の跡が垂れており、ディープキスをされていることを暗示している。男は彼女の中で射精し、彼女の腹をさすりながら、彼女との子作りに興奮しているかのようだ。可能であれば、受胎を示す2つ目の後光が彼女の腹の上に現れている様子を描いてください。\n\nどうかよろしくお願いします！", "nc": 42, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@kaoperorintyo/works/14", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 306755, "client_id": 442, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/5c513a4f/uploads/origins/b19cce8d-6e31-4ed4-a612-c1f984724dc2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bb997f96b3d14997b53ef7195d420414", "srcset": "https://si.imgix.net/5c513a4f/uploads/origins/b19cce8d-6e31-4ed4-a612-c1f984724dc2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bb997f96b3d14997b53ef7195d420414, https://si.imgix.net/5c513a4f/uploads/origins/b19cce8d-6e31-4ed4-a612-c1f984724dc2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=353650bc20623c89af420c7a26f31c4c 2x, https://si.imgix.net/5c513a4f/uploads/origins/b19cce8d-6e31-4ed4-a612-c1f984724dc2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=3bbb06a39c1c448b8534081a827f5f1e 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/5c513a4f/uploads/origins/b19cce8d-6e31-4ed4-a612-c1f984724dc2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f571d265b8dc7e97986e89646773b8fc", "srcset": "https://si.imgix.net/5c513a4f/uploads/origins/b19cce8d-6e31-4ed4-a612-c1f984724dc2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f571d265b8dc7e97986e89646773b8fc, https://si.imgix.net/5c513a4f/uploads/origins/b19cce8d-6e31-4ed4-a612-c1f984724dc2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=ea06adf2cb0f1fb9cd144798ec3e48e1 2x, https://si.imgix.net/5c513a4f/uploads/origins/b19cce8d-6e31-4ed4-a612-c1f984724dc2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=d8fadba53f4d82212e48cbf4b3a5ce7f 3x"}, "body": "こんにちは、マヴ・ルヴのリセ・ホーエンシュタインに会いたいです。\n\n彼女が大きな男性と騎乗位セックスしているところが見たい。\n例：https://twitter.com/narusan_beam/status/1754880010052075739/photo/1\n\nできれば、大柄な男性がリセの大きなお尻をつかんで唇にキスするところを見てみたい。彼が彼女の子宮に精液を注ぎ込むところを見てみたい。\n\nリゼがだらしない表情をしていたらいい。\n\n白いランジェリーを着せてください。\nExample: https://twitter.com/Throtem_/status/1700371016210604223/photo/1\n\nありがとうございました。", "nc": 49, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@kaoperorintyo/w