無いのですが、ツノの位置はツインテールの手前で、耳とつむじを結んだライン上についています\nツインテールの結び目は後頭部の上側にあります\n目は右目がピンク、左目がミントのオッドアイで、目の中にカラフルなタピオカがあります！チャームポイントなので、描きこんでもらえると非常に嬉しいです！\nまた、トップスにはきちんと袖があるのでノースリーブではありません（よく袖が無くなるので念の為…！）\n\n 【表情】\nオッドアイとギザ歯がチャームポイントなので、ウインクや口閉じはしないで頂けると非常に嬉しいです！\n\nサムネイルへの使用を考えているため、人物のみの透過pngを含む状態、又はpsdファイルで納品頂けると嬉しいです\n\nご検討の程よろしくお願いします！\n\nhttps://karma25ymkw.wixsite.com/my-site", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@MaroronMaro/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3214542, "client_id": 3245441, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/53af0478/uploads/origins/378dd9d5-9527-4f88-870f-f1f8aac38f20?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=193fa7dd405dd2b8ede23a7819c64d61", "srcset": "https://si.imgix.net/53af0478/uploads/origins/378dd9d5-9527-4f88-870f-f1f8aac38f20?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=193fa7dd405dd2b8ede23a7819c64d61, https://si.imgix.net/53af0478/uploads/origins/378dd9d5-9527-4f88-870f-f1f8aac38f20?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a13bdfa833d260c328b0d446da4498de 2x, https://si.imgix.net/53af0478/uploads/origins/378dd9d5-9527-4f88-870f-f1f8aac38f20?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e602e52a3ddf5544f75b6bcfb127caf1 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/53af0478/uploads/origins/378dd9d5-9527-4f88-870f-f1f8aac38f20?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=7e314bbac2d0720fba6e661f125624b4", "srcset": "https://si.imgix.net/53af0478/uploads/origins/378dd9d5-9527-4f88-870f-f1f8aac38f20?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=7e314bbac2d0720fba6e661f125624b4, https://si.imgix.