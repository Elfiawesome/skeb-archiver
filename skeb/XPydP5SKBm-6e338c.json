3-44c3-88e7-b6446d414244?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a00c2cd3595f22c1acd461a02692b857 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/7843c78a/uploads/origins/fb348db8-a593-44c3-88e7-b6446d414244?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d6e3606f3495c2acfee6ac26b05ff7dc", "srcset": "https://si.imgix.net/7843c78a/uploads/origins/fb348db8-a593-44c3-88e7-b6446d414244?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d6e3606f3495c2acfee6ac26b05ff7dc, https://si.imgix.net/7843c78a/uploads/origins/fb348db8-a593-44c3-88e7-b6446d414244?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=1474977e1b7dda1e482415bc3f639400 2x, https://si.imgix.net/7843c78a/uploads/origins/fb348db8-a593-44c3-88e7-b6446d414244?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=7d5282fdd6a3eb2b0546ef7bc69ed4bd 3x"}, "body": "えっちなイラストの依頼です\n自キャラのマリィちゃんhttps://misskey.io/notes/9z90013zzgfb08ca\nのイラストを描いていただきたいです\n\nシチュはおっきいゴブリンと裸で並んで　おまんこVSちんちん\nみたいになってる感じで\n〇の部位を刺したえっちな説明文がある感じでお願いします\n\n・マリィちゃんは腰に手を当てて尻尾立てたドヤァってポーズで\nおまたから愛液垂らしてる感じでお願いします\n身長差あるので椅子に乗せたり　能力で浮くとかしてもらって大丈夫です\n\n〇頭周辺(思考)　自信満々！お友達になれると思ってる！！\n〇身体周囲のむわむわ　オスを誘惑するフェロモン！無意識に垂れ流してる！\n〇淫紋　キザマレの証！トレードマーク！！\n〇おまんこ　とろとろぷにぷにおまんこ！いつでも準備万端！！\n\n\n・ゴブリンはイボイボちんちんを勃起させて精液垂らしてるえっちな感じで描いて欲しいです！\n\n〇頭周辺(思考)　優秀なメスを孕ませる事しか考えていない\n〇鼻　半径10km 妊娠可能なメスを嗅ぎ分ける優秀な嗅覚\n〇イボイボ　メスを徹底的にマーキングする液体を分泌する臭腺 フェロモンは非常に強力でメスを強制的に発情させる \n〇精液　受精・着床率100％のつよつよ精液 7日で出産のサイクル 媚薬効果もあり中毒性が非常に高い\n\nなんかえっちそうな説明文思いついたら追加してほしいです！！\n\n以上の内容でご検討よろしくお願いいたします", "nc": 184, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@XPydP5SKBm/works/8", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1571423, "client_id": 180981, "vtt_url": null,