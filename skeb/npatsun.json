eator_id": 3723539, "client_id": 3734425, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/8e645cda/uploads/origins/f80ef58f-a158-4a20-9c44-55aa6bd1ce2b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d058973d0ff9834b878e9a083c7788b6", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/8e645cda/uploads/origins/f80ef58f-a158-4a20-9c44-55aa6bd1ce2b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b1e1ed50b19bdfc5aff2cb34d437d258", "src_set": ""}, "body": "はじめまして。突然の連絡失礼致します。\nDiscordにてunpacking様のイラストをお見かけし、リクエストさせて頂きました。\n\n(依頼内容)\nオリジナルキャラクターの二人のイラストをお願いしたいです。\nキャラの参考資料を下記リンクに添付しておりますので、ご確認頂けますと幸いです。\n\n【主人公】\n・警察官(刑事)\n・長袖シャツを捲っている。黒いズボンとネクタイ\n・タレ目、眠そうな重いマブタ、青緑の瞳\n・緑がかった黒髪、くせっ毛、襟足長め\n・イメージカラーは青緑\n\n【相棒】\n・詐欺師(訳あって警察と協力関係)\n・青いスーツ、水色のベスト、緑のネクタイ\n・ジャケットの前は閉めない\n・細いタレ目、小さい青い瞳\n・青がかった黒髪、センター分け\n・喫煙者(表現してもしなくても大丈夫です)\n・イメージカラーは青\n\n構図、ポーズ等につきましては、二人セットで\"相棒\"感があればどんなものでも構いません。また、キャラデザインについても、ある程度の特徴を押さえていれば自由にアレンジを加えて頂いて大丈夫です。unpacking様の絵柄、センス、手癖で描かれた自キャラがぜひ見たいです!\n\n(使用用途)\n個人での鑑賞\n\n長くなりましたが、unpacking様のカートゥーン調でポップなイラストがとても好みで可愛らしかったため依頼させていただきました。\nリクエストに問題がありましたら、再送依頼またはキャンセルにてご対応お願いします。\n\n何卒ご検討の程よろしくお願い致します。\n\nhttps://drive.google.com/file/d/17oPWiBqyMeY1zqXK5WcFRXifFwyj0dyM/view?usp=drivesdk", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "similar_creators": [{"id": 87127, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "またんごむ💙", "screen_name": "superganglion", "avatar_url": "https://pbs.twimg.com/profile_images/1965379054636597249/U1pHNeDZ.jpg", "header_url": "https://pbs.twimg.com/profile_banners/922795613816635392/1737897699/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "skills":