ーフです。\n胸部は平らです。\n爪が付いた水色の手袋をしています。\nVTuberです。\n\n【使用用途】\n・X等のSNSで使用\n・YouTubeのサムネなど動画内で使用\n\n【納品形式】\nレイヤーが分かれているPSDデータ\n\nhttps://x.com/uradagui/status/1852122126360449494\n\nhttps://x.com/uradagui/status/1852122126360449494", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@LipMiyn/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2419890, "client_id": 531818, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/92d72a42/uploads/origins/5a387c3f-5b04-45cd-b7c3-59501b023c55?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=16e43846a7f4edecd480a15fb7ef4f25", "srcset": "https://si.imgix.net/92d72a42/uploads/origins/5a387c3f-5b04-45cd-b7c3-59501b023c55?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=16e43846a7f4edecd480a15fb7ef4f25, https://si.imgix.net/92d72a42/uploads/origins/5a387c3f-5b04-45cd-b7c3-59501b023c55?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a92f40bad6f61cabe56fc2646ffc1390 2x, https://si.imgix.net/92d72a42/uploads/origins/5a387c3f-5b04-45cd-b7c3-59501b023c55?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=659235d719e8470adf8b8251eab9c205 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/92d72a42/uploads/origins/5a387c3f-5b04-45cd-b7c3-59501b023c55?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5d9f4decd6167408573bc3d88b335d4f", "srcset": "https://si.imgix.net/92d72a42/uploads/origins/5a387c3f-5b04-45cd-b7c3-59501b023c55?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5d9f4decd6167408573bc3d88b335d4f, https://si.imgix.net/92d72a42/uploads/origins/5a387c3f-5b04-45cd-b7c3-59501b023c55?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=91