375eb07-f2d2-416b-99e7-5393a90f6200?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=b17241bbdb728a8af46d3f7884830040 2x, https://si.imgix.net/d54e561b/uploads/origins/7375eb07-f2d2-416b-99e7-5393a90f6200?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=c869139832d488078255112cf5badcf7 3x"}, "private": true, "genre": "art", "tipped": true, "creator_id": 667980, "client_id": 2792903, "nc": 184}, {"path": "/@bubupan3/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 667980, "client_id": 93103, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/9acac132/uploads/origins/35229202-2809-44c6-b0f4-6846e23e4750?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c14d6439f5f457489b33b4c3ac40e0dd", "srcset": "https://si.imgix.net/9acac132/uploads/origins/35229202-2809-44c6-b0f4-6846e23e4750?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c14d6439f5f457489b33b4c3ac40e0dd, https://si.imgix.net/9acac132/uploads/origins/35229202-2809-44c6-b0f4-6846e23e4750?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=4e8da88bc21ad069dd125881123e6413 2x, https://si.imgix.net/9acac132/uploads/origins/35229202-2809-44c6-b0f4-6846e23e4750?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a646737a0947cf2833223f3a767b67be 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/9acac132/uploads/origins/35229202-2809-44c6-b0f4-6846e23e4750?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d0e4fab9f37dfaf71f56e794728a7e0e", "srcset": "https://si.imgix.net/9acac132/uploads/origins/35229202-2809-44c6-b0f4-6846e23e4750?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d0e4fab9f37dfaf71f56e794728a7e0e, https://si.imgix.net/9acac132/uploads/origins/35229202-2809-44c6-b0f4-6846e23e4750?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=be2c5bfa89f1e12d1e7a456a973fc636 2x, https://si.imgix.net/9acac132/uploads/origins/35229202-2809-44c6-b0f4-6846e23e4750?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=0d08ee7a837bd15c065ce2e3a7f47bdf 3x"}, "body": "ご無沙汰しております。\n先日は眼福すぎる東郷さん＆須美ちゃんにて大変お世話になりました！！\n\n兼ねてよりbubupan先生の描かれるひふみんもめちゃくちゃイイな…と感じておりまして。\n本件はひふみんにてお送りさせていただきます。お手数お掛けしますがお目通しだけでもいただけますと有難いです。\n\n『ｼﾁｭｴｰｼｮﾝ内容』\n以前、先生にお届けいただいたメイド東郷さん作品（https://www.pixiv.net/artworks/102145149）\nと同様のキス➕乳責めシチュを花嫁ひふみんに置き換えた形でリクエストさせてください\n\n『衣装』\nhttps://drive.google.com/drive/folders/1A710bJxN6LUTZiyggaeLM_JEcjGm7mhk\n※初めはもっとエチエチ露出衣装だったとの事でして。本件は股下の衣装は外し白色パンツとガーターベルトが見えている状態に魔改造していただけたら嬉しいです…!(ブーケは描写せずとも大丈夫です)\n\n『ひふみん』\n・メイド東郷さん作品と同等のバストサイズ\n・絡み相手とは懇意の仲\n・弱点の胸を責められ困り眉で激しめに喘いでいる\n・舌を絡ませ合い唾液が口元から垂れている(イラスト上部)\n・太ももや肩など身体中の至る所がビクッと反応\n・胸を愛撫する絡み相手の手首付近を掴む(イラスト下部)\n・目を瞑る開くなどの表情差分をお願いいたします\n・台詞や描き文字などを添付していただける場合有り無し両パターンいただけますと有難いです\n\n『絡み相手』\n・ひふみんの胸を揉みしだきながらディープキス(イラスト上部)\n・東郷さん作品同様に片乳は鷲掴むように揉み、もう片乳はしゃぶり尽くす\n・表情などは描写せず最低限人間と認識出来る程度の書き込みで構いません。前回の透過描写凄く良かったです！\n\n最後に。もし構図的に可能であればキスカットインひふみんの方は男性の首へ両腕を回して受け入れるような形で描写していただけると嬉しいです。\n\n以上の内容でお送りいたします。\nご多忙の折、大変恐縮ではございますがご検討いただければ幸いです。", "nc": 49, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@bubupan3/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 667980, "client_id": 2104757, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/748d0f4e/uploads/origins/0f0705eb-cef7-4200-8722-e444c6851113?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=39bc662dc4c6b46f56c99698dc191bbb", "srcset": "https://si.imgix.net/748d0f4e/uploads/origins/0f0705eb-cef7-4200-8722-e444c6851113?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=39bc662dc4c6b46f56c99698dc191bbb, https://si.imgix.net/748d0f4e/uploads/origins/0f0705eb-cef7-4200-8722-e444c6851113?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e96ef7363b3855670715b7ddb80d248a 2x, https://si.imgix.net/748d0f4e/uploads/origins/0f0705eb-cef7-4200-8722-e444c6851113?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=97dad754b24c1fb6d2eed7d63dfebc6f 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/748d0f4e/uploads/origins/0f0705eb-cef7-4200-8722-e444c6851113?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e78734c7b96c8105511df88c066436ec", "srcset": "https://si.imgix.net/748d0f4e/uploads/origins/0f0705eb-cef7-4200-8722-e444c6851113?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e78734c7b96c8105511df88c066436ec, https://si.imgix.net/748d0f4e/uploads/origins/0f0705eb-cef7-4200-8722-e444c6851113?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=e814339102aa802bdc884046be9e371f 2x, https://si.imgix.net/748d0f4e/uploads/origins/0f0705eb-cef7-4200-8722-e444c6851113?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=682134ca8bbfa995fb2cde4b40e8d083 3x"}, "body": "初めまして！\n東郷さん絵が大変魅力的なので依頼したく思います\n\n○キャラクター\n結城友奈は勇者であるの東郷美森\n\n○衣装\nこちらのバニー姿\nhttps://medicos-e-shop.net/products/detail/10754\n乳は露出させつつ盛ってください\n○シチュエーション\n男と後背位セックス\n上リンクと似た構図でお願いします\n彼女の方は振り返りつつ男と舌先キス\n差分は射精前中後と受精カットインをお願いします\n\n①射精前激しくピストン\n東郷「そのまま出してっ♡……あなたの子供っ♡欲しいっ♡」\n②喘ぐ美森\n③\n東郷「おくっ♡満たされてっ♡あっ♡…今っ♡授かってる♡」\nみたいな感じの受精を感じ取る台詞\n\n台詞は好きに膨らませたり改変してもらって大丈夫です", "nc": 32, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@bubupan3/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 667980, "client_id": 93103, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/dee67139/uploads/origins/f000129f-8013-4f57-9bac-6bf3923e8498?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c99c00c8d8e0aaf976a720255752c508", "srcset": "https://si.imgix.net/dee67139/uploads/origins/f000129f-8013-4f57-9bac-6bf3923e8498?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c99c00c8d8e0aaf976a720255752c508, https://si.imgix.net/dee67139/uploads/origins/f000129f-8013-4f57-9bac-6bf3923e8498?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=29dbbd113363be72bfa08f100fbda024 2x, https://si.imgix.net/dee67139/uploads/origins/f000129f-8013-4f57-9bac-6bf3923e8498?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=0ecea0e72263d8aab8c87d3e70b29484 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/dee67139/uploads/origins/f000129f-8013-4f57-9bac-6bf3923e8498?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=eaa4c1731746445432844be074e161b0", "srcset": "https://si.imgix.net/dee67139/uploads/origins/f000129f-8013-4f57-9bac-6bf3923e8498?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=eaa4c1731746445432844be074e161b0, https://si.imgix.net/dee67139/uploads/origins/f000129f-8013-4f57-9bac-6bf3923e8498?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=39473915c8c11d1a7469b33d1a2e63bc 2x, https://si.imgix.net/dee67139/uploads/origins/f000129f-8013-4f57-9bac-6bf3923e8498?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=b31e9e04225a2bf2123f168dae542ce9 3x"}, "body": "ご無沙汰しております…！\n昨年度もチャイナ東郷さんにて大変お世話になりました！\n兼ねてよりタイミングを伺っていまして…。\nお手数お掛け致しますがお目通しだけでもいただけると有難いです。\n\n『ｼﾁｭｴｰｼｮﾝ内容』\n主観視点からの東郷美森＆鷲尾須美W乳首舐め手コキシチュ(水着メイド)…にてリクエストさせてください\nhttps://drive.google.com/drive/folders/1VCJwDeEElcZIebU_8TBmJqD9tEnwVSas\n\n『美森＆須美』\n・男性の乳首を舌先で転がすよう(動線付き)に舐めまわす\n・主従関係にあり主人に奉仕している\n・悩ましげ(困り眉)で頬を紅潮させながら尽くしている表情\n※以前描かれていたひふみん誕生日イラストの差分表情が凄く良かったので近い表情をいただけると嬉しいです…！\n( https://x.com/bubupan3/status/1752654216965881996?t=TozwADJWfO8VTMqOmKlceA&s=19 )\n・片方が陰茎を、もう片方が亀頭先端を指で刺激する責め方\n・主人が射精後、ハート目になっている表情差分をお願いいたします\n\n『絡み相手』\n・二人に責められ身を震わせながら呻き声をあげている\n・ドピュッ♡と勢いよく射精する差分をお願い致します\n\n※もし台詞などを添付していただける場合、台詞アリ無しパターン両方いただけますと助かります🙏\n\n以上の内容でお送りいたします。\nご多忙の折、大変恐縮ではございますがご検討いただければ幸いです。", "nc": 169, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@bubupan3/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 667980, "client_id": 1349275, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/af66f8d7/uploads/origins/5d58bab7-3575-4e18-b604-34c688e4b0ae?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d8244ac7de6ca4441a5b81ad9466d0c6", "srcset": "https://si.imgix.net/af66f8d7/uploads/origins/5d58bab7-3575-4e18-b604-34c688e4b0ae?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d8244ac7de6ca4441a5b81ad9466d0c6, https://si.imgix.net/af66f8d7/uploads/origins/5d58bab7-3575-4e18-b604-34c688e4b0ae?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=40dab5fd6a49124ada09042ba33a4dba 2x, https://si.imgix.net/af66f8d7/uploads/origins/5d58bab7-3575-4e18-b604-34c688e4b0ae?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=0aad1125b0d9d463042b45da88584662 3x"}, "duration": null, "nsfw": true, "hardcore": true, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/af66f8d7/uploads/origins/5d58bab7-3575-4e18-b604-34c688e4b0ae?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=59ee5f4b9ba8c6424532cfa73c92c434"