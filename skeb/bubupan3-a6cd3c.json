%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ce031faa206f0a780108c1daf0de71fb", "srcset": "https://si.imgix.net/9a11abf1/uploads/origins/9c85947e-e8c3-4c0f-8411-454664bace3f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ce031faa206f0a780108c1daf0de71fb, https://si.imgix.net/9a11abf1/uploads/origins/9c85947e-e8c3-4c0f-8411-454664bace3f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=e95efd41aed6530f15ebc013bdc1a72b 2x, https://si.imgix.net/9a11abf1/uploads/origins/9c85947e-e8c3-4c0f-8411-454664bace3f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=7806d80e32f96f5c4519bd32af154404 3x"}, "body": "こんにちは！マイ・バレンタインが、腕と脚を拘束された状態でプラズマウナギに快楽を与えられ、さらに屈辱を味わわされるイラストを希望します。マイはバトルシティの衣装を着ていて、大きな胸と豊かな谷間があるように描いてください。 マイは抵抗しようとしますが、最終的には我を忘れてしまい、お腹がふくらんでしまうような描写にしてください。もっとエッチな作品にするために、お好きなディテールを自由に追加してください。\nhttps://www.pixiv.net/en/artworks/136416825\nhttps://skeb.jp/@honotomo7/works/106\nhttps://www.pixiv.net/en/artworks/140055496\nhttps://skeb.jp/@warukuriboo/works/121\n\nhttps://skeb.jp/@bara_no_oniku/works/102\n\nその他の「マイが腕を抱きしめる」参考画像：\nhttps://skeb.jp/@Kta_osushi/works/160", "nc": 168, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@bubupan3/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 667980, "client_id": 529560, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/d0b91075/uploads/origins/a3bc19f3-9464-4711-b084-52465fcb0606?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0168390a9414e5a7c7090f34f30c53b2", "srcset": "https://si.imgix.net/d0b91075/uploads/origins/a3bc19f3-9464-4711-b084-52465fcb0606?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0168390a9414e5a7c7090f34f30c53b2, https://si.imgix.net/d0b91075/uploads/origins/a3bc19f3-9464-4711-b084-52465fcb0606?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=05d404add6753c57b4c78254a28e10d3 2x, https://si.imgix.net/d0b91075/uploads/origins/a3bc19f3-9464-4711-b084-52465fcb0606?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c56927d52af61b397d2807d9e4db1ba5 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/d0b91075/uploads/origins/a3bc19f3-9464-4711-b084-52465fcb0606?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ed2c0e4c36e51828c097637c6fb0b86a", "srcset": "https://si.imgix.net/d0b91075/uploads/origins/a3bc19f3-9464-4711-b084-52465fcb0606?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ed2c0e4c36e51828c097637c6fb0b86a, https://si.imgix.net/d0b91075/uploads/origins/a3bc19f3-9464-4711-b084-52465fcb0606?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=a644fbfb5d15296a76fbf0a9eefcab2a 2x, https://si.imgix.net/d0b91075/uploads/origins/a3bc19f3-9464-4711-b084-52465fcb0606?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=3698b77d9e77f2e834f5a4c36d8138f3 3x"}, "body": "こちらでははじめまして。\n依頼させていただきます。\n\nキャラクター：浦和ハナコ（ブルーアーカイブ）\nシチュエーション：\n別の方にセックスの前後を描いていただいた（https://skeb.jp/@SukoYugiri/works/125）、裏垢で募集した相手との初体験セックスのシーン。\n先生以外にも人間の大人の男性がいるキヴォトスです。\n内容：\n・公園の芝生の上での正常位。\n・ハナコは制服の上をブラごと捲って胸を露出し、竿役はハナコのふとももの辺りを持って足を広げさせている状態。\n　パンツは脱がしてください。\n・胸のサイズは、以前描いていただいたアスナやノノミよりは小さめでお願いします。\n・破瓜の痛みより「今日会ったばかりの名前も知らない男に純潔を捧げる」と言う背徳感による快感が上回っている表情。\n・差分として、挿入前の見せ槍、亀頭部分までの挿入、根本までの挿入、腰を前後しているところ、射精、事後。\n　それぞれ破瓜の血の有り・無し、挿入以降は断面図の有り・無しの切り替えを可能にしてください。\n　断面図は、身体に透過するタイプ、別コマや背景に描写するタイプどちらでも構いません。\n　事後差分は、精液を全部腟内に注ぎこまれ、そこから粘度の高いものがドロっと垂れている感じでお願いします。\n　服や身体には極力付着させないでください。\n・黒海苔修正でお願いします。\n\n以上、細かくて恐縮ですがよろしくお願いします。", "nc": 49, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@bubupan3/works/6", "private