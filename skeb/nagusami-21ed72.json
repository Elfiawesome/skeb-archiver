&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=d38e27ca10c9302f038572a346b4710d 3x"}, "body": "巨乳の紡乃世詞音さんが、なぜかマイクロビキニを着て、朝にお寝坊さんの布団の上に乗って起きるよう促してくれる、そんな夢のような場面のイラストをお願いします。", "nc": 49, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@nagusami/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 454631, "client_id": 1282864, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/5e7ea302/uploads/origins/508cb743-1ce9-4c39-8709-c28d4c9e09f2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7d2a6ab5315fc964654bfaba956984fd", "srcset": "https://si.imgix.net/5e7ea302/uploads/origins/508cb743-1ce9-4c39-8709-c28d4c9e09f2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7d2a6ab5315fc964654bfaba956984fd, https://si.imgix.net/5e7ea302/uploads/origins/508cb743-1ce9-4c39-8709-c28d4c9e09f2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=9c9506a05415d1d1fd5417ad89fb4795 2x, https://si.imgix.net/5e7ea302/uploads/origins/508cb743-1ce9-4c39-8709-c28d4c9e09f2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=05562817a72566b5a9d13187afb00c2d 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/5e7ea302/uploads/origins/508cb743-1ce9-4c39-8709-c28d4c9e09f2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=80d59a017559fa155264d4bcbd66ab97", "srcset": "https://si.imgix.net/5e7ea302/uploads/origins/508cb743-1ce9-4c39-8709-c28d4c9e09f2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=80d59a017559fa155264d4bcbd66ab97, https://si.imgix.net/5e7ea302/uploads/origins/508cb743-1ce9-4c39-8709-c28d4c9e09f2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=4de8033a4a855ff6219253d28778cee2 2x, https://si.imgix.net/5e7ea302/uploads/origins/508cb743-1ce9-4c39-8709-c28d4c9e09f2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=e0f8257a87f4de17611ce17522661911 3x"}, "body": "ロングスカートのメイド服を着た紡乃世詞音のイラストを描いていただきたいです。\nデザインは申し訳ないのですがあまり詳しくなく、おかませすることになります。\nポーズは可能であれば、スカートの内側(ふともも等に)から刃物を取り出して手入れしているようなものが、かっこいいかな……と思いました。\n(モンスターハンターシリーズのレニガンという装備の足が刃物の収納？の参考になるかもしれません。)\n表情はキリッとしたものでも笑顔でも紡乃世詞音であれば素晴らしいと思います。\nご主人様ラブラブな笑顔でも、どうやって監禁してやるか……みたいな悪い笑顔でもかわいいと思います。\n絵柄が大好きなので依頼した部分も大きく、なにもかも任せてしまってもやったぁぁぁぁぁってなること間違いないと思います。\n普段描かれている紡乃世詞音の体格などについても解釈一致なので最高です。\n公式立ち絵からしてなかなか大きいですよね……\n使用用途ですが、一枚絵として劇場動画などで使いたいとも思っていますし、スマホ壁紙にもしたいなーとも思っていますし……アイコンなんかにもしちゃいたいなー……なんて贅沢なことを思っています。\n顔面ガチ恋距離まで拡大しても画質がいい感じというのが難しいかもしれませんね。\nメイド服というだけならいざ知らず、ロングスカートとなると、全身を描く必要がある(のかな？)ので、大変な仕事になると思います。\nどうぞよろしくお願いいたします。", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@nagusami/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 454631, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/3551d083/uploads/origins/f74d47b3-51cf-42a2-8fbb-1a6fd0e9168b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=084dfa4388b08e249f1cb3b40453d032", "srcset": "https://si.imgix.net/3551d083/uploads/origins/f74d47b3-51cf-42a2-8fbb-1a6fd0e9168b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=084dfa4388b08e249f1cb3b40453d032, https://si.imgix.net/3551d083/uploads/origins/f74d47b3-51cf-42a2-8fbb-1a6fd0e9168b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a2e2bef71331868122c548dd1f93ed54 2x, https://si.imgix.net/3551d083/uploads/origins/f74d47b3-51cf-42a2-8fbb-1a6fd0e9168b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=155bd58fd0a49783dc3a498ce6b6445d 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src