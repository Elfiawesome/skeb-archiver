ixiv.net/artworks/70796264", "nc": 137, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@0402maguro/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3735521, "client_id": 731954, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/17087559/uploads/origins/12fbed3c-5ebc-43e2-9b9c-dd5379d0f865?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=351a59213f65975564e20a92c366fda7", "srcset": "https://si.imgix.net/17087559/uploads/origins/12fbed3c-5ebc-43e2-9b9c-dd5379d0f865?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=351a59213f65975564e20a92c366fda7, https://si.imgix.net/17087559/uploads/origins/12fbed3c-5ebc-43e2-9b9c-dd5379d0f865?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=7c02d23693fd892d75dc59e3afc0a138 2x, https://si.imgix.net/17087559/uploads/origins/12fbed3c-5ebc-43e2-9b9c-dd5379d0f865?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d199090768c05a2b04cdca2b75c03171 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/17087559/uploads/origins/12fbed3c-5ebc-43e2-9b9c-dd5379d0f865?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=517456460bf6de6e74fccc07a578b067", "srcset": "https://si.imgix.net/17087559/uploads/origins/12fbed3c-5ebc-43e2-9b9c-dd5379d0f865?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=517456460bf6de6e74fccc07a578b067, https://si.imgix.net/17087559/uploads/origins/12fbed3c-5ebc-43e2-9b9c-dd5379d0f865?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=1ea3c4dce064ef0b4d23c06af3c68b44 2x, https://si.imgix.net/17087559/uploads/origins/12fbed3c-5ebc-43e2-9b9c-dd5379d0f865?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=65bd22264ddb7ba1465e379e8614606d 3x"}, "body": "アピールありがとうございます、極寒着膨れについて興味を持って下さったとのことで大変嬉しく思っています！\n素敵な絵柄も相まって、是非とも極寒着膨れのイラストをお願いしたいと思います！以下、依頼文になります\n\nアズールレーンの加賀が、物凄く寒い場所で、全身を防寒着でモッフモフに着膨れながら凍って行くイラストをお願いします。\n例えば今から想像もつかない極寒の地に放り出されると言われ、凍えないように暖かそうな防寒着をひたすら重ねて着込んだような、モフモフの着膨れ姿の凍結をお願いします。\n\nGoogleドライブに資料を纏めています\nそちらの資料を参考に、雪国のような分厚く耐寒性の高い、ふわふわな防寒着と言うイメージで着込ませて欲しいです。資料には様々な種類がごちゃ混ぜになっていますが、全体的なデザインはお任せします。\n着込ませ過ぎだと思うその8割増しくらいのモフモフ着膨れ加減でお願いしたいです。凄く寒い所で、モフモフした防寒着を大量に着込む女の子が大好きなので……\n\nまた、描写が可能であれば場所は凄く寒そうな場所、雪や氷に覆われた世界観でお願いします、寒さの表現として防寒着にはつららや霜、体に雪等を積もらせて頂ければ嬉しいです\n可能な限りの防寒着を着込んでもなお凍りつくような寒さ、そんなイメージが大好きなので……\n吐息が凍りつく程の寒さで、口や目から唾液や涙のつらら等の描写も入れて下さると嬉しいです\n\n加賀に生えた狐の耳と尻尾についてですが、耳は防寒着を邪魔しない程度に描写をお願いします。\n九本の尻尾は可能であればかなり大きく描いて頂けるととても喜びます。モフモフ尻尾が大好きなので……\n\nまた、可能であれば、凍えきって身体を包む雪と氷が増え、全身がつららと氷に包まれ、樹氷のように青白く全身が凍りついてしまった様子までお願いしたいです。\n\n長々と描いてしまい申し訳ないです、とにかく徹底した防寒着の盛りと全身モフモフの着膨れ、しかし、それでもガチガチに凍りついた加賀さんの姿を見たいです。どうか宜しくお願いします。\n\nhttps://drive.google.com/drive/folders/1vTkYM1PpXEa8XHPTXIs4rT4CAYyMToXN\n\nhttps://drive.google.com/drive/folders/1vTkYM1PpXEa8XHPTXIs4rT4CAYyMToXN", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@0402maguro/works/1", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/3bf65f08/uploads/origins/1dcf8749-6362-4d78-a300-9e88f1eb11db?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=c4da3bc2cb53c7d5c729ce5d711ed850", "srcset": "https://si.imgix.net/3bf65f08/uploads/origins/1dcf8749-6362-4d78-a300-9e88f1eb11db?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=c4da3bc2cb53c7d5c729ce5d711ed850, https://si.imgix.net/3bf65f08/uploads/origins/1dcf8749-6362-4d78-a300-9e88f1eb11db?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&