yearly_report_client_visible": false, "total_appeals_count": 0, "received_works": [{"path": "/@mitirutuki/works/9", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3791416, "client_id": 3908400, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/a043cf95/uploads/origins/e09b8b90-cc83-48cb-93c1-d25f2738df5d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e387c0c591898869aade457201801f79", "srcset": "https://si.imgix.net/a043cf95/uploads/origins/e09b8b90-cc83-48cb-93c1-d25f2738df5d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e387c0c591898869aade457201801f79, https://si.imgix.net/a043cf95/uploads/origins/e09b8b90-cc83-48cb-93c1-d25f2738df5d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=126ef74ce84d95d97e9e69643b5f347a 2x, https://si.imgix.net/a043cf95/uploads/origins/e09b8b90-cc83-48cb-93c1-d25f2738df5d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=8b418824a9f172e3201f1c20d483ca7c 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/a043cf95/uploads/origins/e09b8b90-cc83-48cb-93c1-d25f2738df5d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=dab46af3e85f95af18880044d5cb0e0c", "srcset": "https://si.imgix.net/a043cf95/uploads/origins/e09b8b90-cc83-48cb-93c1-d25f2738df5d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=dab46af3e85f95af18880044d5cb0e0c, https://si.imgix.net/a043cf95/uploads/origins/e09b8b90-cc83-48cb-93c1-d25f2738df5d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=73e4d6908dd6600fcf1610948b50dbb3 2x, https://si.imgix.net/a043cf95/uploads/origins/e09b8b90-cc83-48cb-93c1-d25f2738df5d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=4c7ee2beb37448da2968fb4f56bdcf41 3x"}, "body": "こんにちは！　いつもアシカワ様のイラスト拝見している者です。\n今回、アクスタ写真を見て、是非オリジナルで清純な女の子を描いていただきたいと思い、ご依頼いたしました！\n以下、キャラクターの概要になります！\n\n希望納品形式：透過PNG\n希望カット：おまかせ\n使用用途：個人観賞用、別垢アイコン用（アイコンに使用するかはまだ確定ではないのですが、一応……）\n\n（以下、詳細）\n\n女の子／18~26歳くらい／研究室所属\n152cm／少し痩せ型\n\n髪色：青に近い紺色（瑠璃色）\n瞳の色：マリンブルー。瞳孔は黒寄りの紺、ハイライトは上。 \n\n肌の色：ブルベな感じ。東アジア系統だけど、白い。\n\n髪：前髪はパッツン。前髪に沿った横髪が胸あたりまで垂れています。肩甲骨あたりまでおろした髪に、三つ編みで後ろ髪を編み込んでいます。ハーフアップにした時のハーフアップ部分が三つ編み、という感じです。\n\n目：タレ目気味ですが、睫毛が長い。大人の女性らしさよりも、素で美人、化粧をしなくてもあどけなく可愛らしいイメージです。\n\n服装：グレーのカッターシャツに、紐が黒、石の色がコバルトブルーかセルリアンブルーあたりのループタイをしており、その上に白衣を着ています。下は膝丈タイトスカートです。\nグレーのメガネをかけています。\n\n表情：春の木漏れ日のような微笑\n\n18~21歳、と年齢の枠を広げたのですが、個人的には18くらいの想定の場合は少女性が目立つ、26歳想定の場合はこの清純な女の子がそのまま清楚で綺麗なお姉さんという感じになる、という感じでイメージしています。\nどちらの採用でも嬉しいです。\n\n性格：（参考程度に）\n基本的に誰に対しても丁寧で人当たりの良い子です。\nただ、研究に熱中すると時間を忘れて、よく相手に叱られがちです。ズボラではなく、研究熱心すぎるきらいがあります。\n18~26の年齢で既に人格が成熟しているタイプです。年齢に反して大人らしいというのが特徴です。\n\n\n【リクエスト】\n\n相手に呼ばれて振り返った彼女。\n日常のさなかに、想い人からプロポーズを受けたような、それでいてあくまでもその日常の延長を最初から待ち望んでいたような、というシーンを柔い笑顔の瞬間を見られたら、と思います。\n\n\n長々と失礼しました！\n細かく書きましたが、正直是非この機会にアシカワ様のイラストを見たい気持ちが強いだけなので、詳細は参考程度に……！\nよろしくお願いいたします！", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@mitirutuki/works/8", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3791416, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/b45c21e4/uploads/origins/ea3ac8f5-f053-4cef-be94-b363814739b9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=26a4ee636700f6372a39e2f289b4f398", "srcset": "https://si.imgix.net/b45c21e4/uploads/origins/ea3ac8f5-f053-4cef-be94-b363814739b9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=26a4ee636700f6372a39e2f289b4f398, https://si.imgix.net/b45c21e4/uploads/origins/ea3ac8f5-f053-4cef-be94-b363814739b9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=0bc9b3f22bed63b1b6806c42d569ef0a 2x, https://si.imgix.net/b45c21e4/uploads/origins/ea3ac8f5-f053-4cef-be94-b363814739b9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ce63af26be7745928f4f56c864beeccf 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/b45c21e4/uploads/origins/ea3ac8f5-f053-4cef-be94-b363814739b9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=7b9108928eff2f333ef2ac4189cad8e4", "srcset": "https://si.imgix.net/b45c21e4/uploads/origins/ea3ac8f5-f053-4cef-be94-b363814739b9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=7b9108928eff2f333ef2ac4189cad8e4, https://si.imgix.net/b45c21e4/uploads/origins/ea3ac8f5-f053-4cef-be94-b363814739b9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=8252b00ae57afc065897c6ef26a6a0b0 2x, https://si.imgix.net/b45c21e4/uploads/origins/ea3ac8f5-f053-4cef-be94-b363814739b9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=d1657021f06a7458763051245a190760 3x"}, "body": "いつも楽しくイラストを拝見させていただいております。今回はアシカワさんに自創作のOCを描いていただきたいと思い、リクエストさせてもらいました。\n画像での参考資料がほとんどなく、文章のみの説明となっているので長くなっておりますが、見た目の特徴以外シチュエーションなどを考える際の参考程度に記述しておりますので目を通さなくても大丈夫です。\nまた、キャラを2人分描ける場合は下記に詳細を書いている2人を描いていただけると幸いです。1人のみ描かれる場合は詳細①のキャラを描いていただきたいです。\n\n【キャラ詳細①】\n髪型:腰までのロングストレートに前髪は眉毛辺りで揃えられているものです\n髪色:白髪\n目:二重のアーモンド型(垂れ目でもツリ目でもないぱっちりとしたもの)\n目の色:緑(ライトグリーンなどの淡い色合い)\n表情:基本的に真顔なのですがキャラ②の子がそばにいる時は表情豊かになります(1人だけ描く際は無表情で描いていただけると嬉しいです)\n身長:175cm\n体重:57kg\n体型:細身だけど胸はしっかりあるもの\nバスト:D程度\n服装:ワンピースのような服装であればなんでも構いません(世界観のイメージとしては中世ヨーロッパが一番近いものになっています)\n性格:物事への関心があまりなく、感情的になることがほとんどない。しかし、自分の婚約者に関しては感情的になることの方が多い\n\n【キャラ詳細②】\n髪型:耳がほんの少し隠れるくらいの長さで少しだけ癖があり、前髪は目の上あたりまでのもの(コンマバングという髪型が一番イメージに近いです)\n髪色:クリーム色(薄い色素の色合いだと嬉しいです)\n目:二重のアーモンド型(少し垂れ目気味)\n目の色:\n表情:常に優しげや笑みを浮かべている好青年のようなもの\n身長:186cm\n体重:77kg\n体型:筋肉質だけどガタイが良いわけではない、どちらかというと細身\n服装:キャラ①と同じくズボンとシャツの要素がある服装であるならばなんでも構いません(世界観も同様のものです)\n性格:人当たりがよく優しいと呼ばれるものだが実際は冷静で自らの立場上そのように見せている\n\n\n【構図】\n・キャラクターを2人描いてくださる場合\n2人が桜が沢山(複数本であれば何本でも構いません)咲いている山の中の野原のような場所で笑い合っているもの、背景で桜の花びらが舞っていると嬉しいです\n\n・キャラクターを1人描いてくださる場合\n上記と同じ場所で俯きながら無表情で涙を流しているキャラ①\n\n記載していない部分はもちろん、記載した部分もキャラの外見の特徴的(髪や目の色など)部分以外アシカワさんが良いと思ったものにしても大丈夫です！好きなように描いてもらえたらそれが一番嬉しいです！\n長文になりましたが改めてよろしくお願いします🙇‍♀️\n\n\n【自創作の設定など(具体的なキャラ性を掴むための説明に近いのでここをご覧にならなくても依頼には差し支えないと思っています)】\n神様が存在している世界で、キャラ①と②が出会った星は中世ヨーロッパのような世界観をしています(いわゆる異世界転生ものの世界観が近いです)、生活水準なども中世ヨーロッパの時代とほとんど一緒となっています\nキャラ①は命令を聞くロボットのような生き方をしていましたがキャラ②と出会ってから自我が出来始めてやりたい事をやるようになりました。キャラ②もまた一国の王子であるが故に本音を隠して生きていましたが、キャラ①と出会ってから自由に生きるようになりました。\n最終的にキャラ①が死にかけているキャラ②を自ら刺して2人の物語は一つの区切りを迎えます。その後キャラ②がいる場所に行くために神様でも死ぬことのできる方法を探して現在は色んな星を旅しています。", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@mitirutuki/works/7", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/496e33d2/uploads/origins/ce329452-cda2-44e3-ad3f-2bf90e2776cf?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=fc9ce9c798ac795fca5489feac1c6150", "srcset": "https://si.imgix.net/496e33d2/uploads/origins/ce329452-cda2-44e3-ad3f-2bf90e2776cf?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=fc9ce9c798ac795fca5489feac1c6150, https://si.imgix.net/496e33d2/uploads/origins/ce329452-cda2-44e3-ad3f-2bf90e2776cf?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=a85404921a38cc3de60cdb55226b09d0 2x, https://si.imgix.net/496e33d2/uploads/origins/ce329452-cda2-44e3-ad3f-2bf90e2776cf?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=a