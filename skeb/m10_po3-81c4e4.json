、距離が近いのは大丈夫です◎\n\n♥キャラクター資料\nhttps://drive.google.com/drive/folders/1PrWlyrxEPVvIT6huTjQp3e8xDqbP22mJ\n\n♥キャラクターについて\n🎀寧ちゃん(性別無 身体のベースは男)\n・感情、発話、自由意志ほぼなし\n・身の回りの世話はすべてお供のうさぎがしている\n・赤子~幼児のようにぼーっとしていたり本能的に動いたりする 思考は不明\n🐰うさぎ(ぬいぐるみ時性別無 人型時は男)\n・寧ちゃんが所持するうさぎのぬいぐるみ 人型にもなれる\n・寧ちゃんの全ての世話をしている 過保護で世話焼き 振り回されがち\n・自発意思の少ない寧ちゃんの自我を大切にしている\n\n♥モチーフ、チャームポイント、大切にしていること\n・うさぎとリボン\n・🎀頭の横のピヨ毛\n・🎀ニコニコや大きく口を開ける表情はしない\n・🐰×瞳孔(ボタン)\n・🐰デカインテークとそれに繋がる横髪、リボン(うさみみ)\n\n♥使用用途\n・SNSへの掲載\n・アイコン、ヘッダーへの使用\n・クリエイター様へ依頼時の参考資料\n・個人用グッズ作成(非営利)\n・個人鑑賞\n\nskebに不慣れなため、不備やNGありましたらお手数お掛けしますが再送要請/キャンセルをお願いします。\nお忙しいと思いますが、ご縁がありましたら嬉しいです。ご検討よろしくお願いいたします🎀\n\nhttps://drive.google.com/drive/folders/1PrWlyrxEPVvIT6huTjQp3e8xDqbP22mJ", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@m10_po3/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 4105915, "client_id": 3243853, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/bbccb59a/uploads/origins/98b64d53-aa8f-4297-80c6-63c0f43f7dc6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=32a920e37294ca16354cc4d58712dbe0", "srcset": "https://si.imgix.net/bbccb59a/uploads/origins/98b64d53-aa8f-4297-80c6-63c0f43f7dc6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=32a920e37294ca16354cc4d58712dbe0, https://si.imgix.net/bbccb59a/uploads/origins/98b64d53-aa8f-4297-80c6-63c0f43f7dc6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=412262b6e0ab48ecd3373196c722575c 2x, https://si.imgix.net/bbccb59a/uploads/origins/98b64d53-aa8f-4297-80c6-63c0f43f7dc6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=fe386031138e0e675a58656bdcde475c 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/bbccb59a/uploads/origins/98b64d53-aa8f-4297-80c6-63c0f43f7dc6?bg=%23fff&auto=format%2Ccomp