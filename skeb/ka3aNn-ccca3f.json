6235e8a33f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8bd532abe0a4812a093e596961f6aebb", "srcset": "https://si.imgix.net/8d79f3d4/uploads/origins/852b3fe8-2cb1-49df-b64a-456235e8a33f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8bd532abe0a4812a093e596961f6aebb, https://si.imgix.net/8d79f3d4/uploads/origins/852b3fe8-2cb1-49df-b64a-456235e8a33f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c5824285308f63c4b2b16228812ff3f5 2x, https://si.imgix.net/8d79f3d4/uploads/origins/852b3fe8-2cb1-49df-b64a-456235e8a33f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e07bc29eaa5a5f6b01377533ca054e02 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/8d79f3d4/uploads/origins/852b3fe8-2cb1-49df-b64a-456235e8a33f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=491e2ba319ff810ee817bbe088b49277", "srcset": "https://si.imgix.net/8d79f3d4/uploads/origins/852b3fe8-2cb1-49df-b64a-456235e8a33f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=491e2ba319ff810ee817bbe088b49277, https://si.imgix.net/8d79f3d4/uploads/origins/852b3fe8-2cb1-49df-b64a-456235e8a33f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=405d4862e8b895b68751ec2bfd9c35a9 2x, https://si.imgix.net/8d79f3d4/uploads/origins/852b3fe8-2cb1-49df-b64a-456235e8a33f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=2d5b0866a48178d7936969f223ed1751 3x"}, "body": "加算さん初めまして。早速ではありますが、あなたは佐藤雅彦 著の「指を置く」という本を読まれたことがあるでしょうか。この本は図版に指を置くことで解釈が変わる、もしくは、意図が分かるようになる作品が多数掲載されたものであり、本来動くことのない図版に読者を関与させることで、図版中の出来事を自分事として扱わせ、動的な鑑賞を促すことを目的とした内容となっています。私はこの本を読んでいる途中、芹沢あさひとの相性がいいのではないかと思い、私なりに案を練った結果イメージが固まりましたので、あさひのよき理解者であるあなたに形にして頂きたく依頼致します。かなり複雑な内容ではありますが、受託して頂ければ幸いです。\n\n題名(仮)「6-6-3」変更可\n前提として、画面に指を置く都合上、縦長の作品として制作するようお願いいたします。\n作品の概要　芹沢あさひが階段にて「じゃんけんグリコ」をして遊んでいる風景\n場所　月岡恋鐘【風吹く丘にはよ来んね】などに登場する、いつもの公園近くの階段(聖蹟桜ヶ丘いろは坂階段)\n詳細\n・階段の下中央から見上げている画面にする\n・階段上部に私服姿のあさひを配置し、階段下のこちらを見て「やったっす！」と言わんばかりの表情をさせる(台詞は書かない)　この時あさひは画面正面やや下に向けてじゃんけんのグーを出している\n・画面最下部左に記号のiを、右にmをそれぞれ指先より少し小さく書き、その場所に鑑賞者がじゃんけんのチョキを出した状態で正しく指を置けるよう配置する(i=人差し指　m=中指)\n・記号の下にテロップを記入できるスペースを作り、そこに「iの上に右手の人差し指を、mの上に右手の中指を置いてください」と書き込む\n・影などを除き、鑑賞者を直接描くことは避けること\n・あくまでも作品の主役は芹沢あさひであることを忘れないこと\n\n作品の意図として\n1　画面上部のあさひを見て「芹沢あさひが階段にてガッツポーズをしている風景」と勘違いする\n2　画面下部の記号に気づき、指を置く\n3　その状態で再度画面上部を見て、あさひの手がグーであることと、自分の手がチョキになっていることに気づき「芹沢あさひと『じゃんけんグリコ』をして遊んでいる風景」であることを理解する\nこのことが鑑賞者に伝われば完璧です。\n\n最後になりますが、これからも加算さんの素敵な作品を見られますことを楽しみにしております。", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@ka3aNn/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1273255, "client_id": 1142469, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/37300497/uploads/origins/edae0be3-e5cf-455a-bec9-b237a7e60d32?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7d9934c775a1382f799da89d53541886", "srcset": "https://si.imgix.net/37300497/uploads/origins/edae0be3-e5cf-455a-bec9-b237a7e60d32?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7d9934c775a1382f799da89d53541886, https://si.imgix.net/37300497/uploads/origins/edae0be3-e5cf-455a-bec9-b237a7e60d32?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=2e40a4c24c1c6e6a1db603d836c24bf8 2x, https://si.imgix.net/37300497/uploads/origins/edae0be3-e5cf-455a-bec9-b237a7e60d32?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=3bda5e7082d91b8515f574abf6e6da9a 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/37300497/uploads/origins/edae0be3-e5cf-455a-bec9-b237a7e60d32?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop