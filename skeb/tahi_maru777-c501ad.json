ff427 3x"}, "body": "こんにちは！  あなたのダイナミックなアートスタイルが好きなので、私のキャラクター、ヴェリンを描いてほしいです！  彼はエルフで錬金術師です。仕事中は慎重で真面目ですが、仕事が終わると遊び心満載でドヤ顔します。  友達とおしゃべりすること、ジョークを言うこと、パズルを解くこと、そしてボバでお茶を飲むことが大好きです。\n\n好きなように彼を描いてください！  この画像はソーシャルメディアや、場合によってはTwitchのストリームで使いたいと思います。\n\n私の要望を考慮していただき、ありがとうございました！\n\nhttps://drive.google.com/drive/folders/18Qditc-s7w1YDNTY8lNtYP4Ky0JX-Vrj", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@tahi_maru777/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1733964, "client_id": 2444155, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/90105a8f/uploads/origins/d11c3720-22b2-494e-b0cd-98c1a8938657?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=344ca1f2098a06c785aac7a1825d69f7", "srcset": "https://si.imgix.net/90105a8f/uploads/origins/d11c3720-22b2-494e-b0cd-98c1a8938657?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=344ca1f2098a06c785aac7a1825d69f7, https://si.imgix.net/90105a8f/uploads/origins/d11c3720-22b2-494e-b0cd-98c1a8938657?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=6d3554c1365f8baf1dda4d0716a9440c 2x, https://si.imgix.net/90105a8f/uploads/origins/d11c3720-22b2-494e-b0cd-98c1a8938657?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=11fc48ba3488495f1088bad32c0a6c10 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/90105a8f/uploads/origins/d11c3720-22b2-494e-b0cd-98c1a8938657?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=919823d9cd6c066b8c3139fdebab769e", "srcset": "https://si.imgix.net/90105a8f/uploads/origins/d11c3720-22b2-494e-b0cd-98c1a8938657?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=919823d9cd6c066b8c3139fdebab769e, https://si.imgix.net/90105a8f/uploads