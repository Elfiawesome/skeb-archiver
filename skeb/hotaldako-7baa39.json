=200&blur=200&s=d01f439c480cdcf3e93f47587c244265", "srcset": "https://si.imgix.net/15a31e62/uploads/origins/46a2bf7b-af9a-4d65-89ac-a002d055539f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d01f439c480cdcf3e93f47587c244265, https://si.imgix.net/15a31e62/uploads/origins/46a2bf7b-af9a-4d65-89ac-a002d055539f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=914c5f34b7ca216e33d2e5dc29bc8890 2x, https://si.imgix.net/15a31e62/uploads/origins/46a2bf7b-af9a-4d65-89ac-a002d055539f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=8ba7f676032a1beee14456f905b962ae 3x"}, "body": "先日はありがとうございました。\nまた続けてリクエストお願いします\n\n・キャラクター\n異世界転移ファンタジーTRPG『幻奏戦記RU.LI.LU.RA』のパートナーキャラの歌姫『「唯我独尊」な歌姫クノッセ』\n容姿は資料URLを参照\nキャラクターイメージはキャッチフレーズ通り勝気で男嫌いの武闘派\n本来は転移者の英雄に使える歌姫でありながら、反転移者組織に所属し「自由にしたければ力づくでこい！」と息巻く暴力ヒロイン\n\n・シチュエーション\nじゃあ力づくで自由にするか、という事で暴力的な輪姦レイプでわからせ。\n前後貫通＋強制イマラチオ射精で精液逆流、息もできなくなるほど容赦なくやってしまってください。\n今回もイラストのみで、台詞や効果音などは不要です。\n\nhttps://drive.google.com/file/d/18nXDrCMGH7wYq8hbauRJ02v-mm8meKHP/view?usp=drive_link", "nc": 168, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@hotaldako/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 4012425, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/db668e5f/uploads/origins/cfee4eb3-a57a-4378-a7bc-3265ba14a059?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8f274ed4cbaaea76d4e64423df4055ec", "srcset": "https://si.imgix.net/db668e5f/uploads/origins/cfee4eb3-a57a-4378-a7bc-3265ba14a059?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8f274ed4cbaaea76d4e64423df4055ec, https://si.imgix.net/db668e5f/uploads/origins/cfee4eb3-a57a-4378-a7bc-3265ba14a059?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b049b61a15c54e5e90a14724d1579047 2x, https://si.imgix.net/db668e5f/uploads/origins/cfee4eb3-a57a-4378-a7bc-3265ba14a059?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=cf4c45eb685aa3bb41b84c8db0f2699a 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/db668e5f/uploads/origins/cfee4eb3-a57a-4378-a7bc-3265ba14a059?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=29ada277ca1a0bbd7e0bfbc15e539a4f", "srcset": "https://si.imgix.net/db668e5f/uploads/origins/cfee4eb3-a57a-4378-a7bc-3265ba14a059?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=29ada277ca1a0bbd7e0bfbc15e539a4f, https://si.imgix.net/db668e5f/uploads/origins/cfee4eb3-a57a-4378-a7bc-3265ba14a059?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=a6e431147e355a63c1699312e9b02a59 2x, https://si.imgix.net/db668e5f/uploads/origins/cfee4eb3-a57a-4378-a7bc-3265ba14a059?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=be4438b550d442d995a58a6c3599203c 3x"}, "body": "先日はカタリナありがとうございました\nたて続けですが、よければまたリクエストお願いします\n\n・キャラクター\n異世界転移ファンタジーTRPG『幻奏戦記RU.LI.LU.RA』のパートナーキャラの歌姫『「メイド」な歌姫リノン』\n容姿は資料URLを参照ですが、見た目通りの貞淑なメイド系ヒロインです\n\n・シチュエーション\n前回のカタリナ同様、敗北して捕らわれ輪姦レイプ希望。イラストのみで、台詞や効果音などは不要です\n構図については全開が素晴らしかったので、今回はお好みでお任せします\n（カタリナ同様バックでも、３Pなどほかの構図でもOKです）\n\nhttps://drive.google.com/file/d/1rx97byWJz27cmwdsZuRA9FTgsLh1wrET/view?usp=drive_link", "nc": 168, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@hotaldako/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 4012425, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/1c9bf1d4/uploads/origins/7bc6ec59-0b2e-4458-8df0-4efcd12afdaa?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=67306e3e9cdfe09e83660e2d6ae24e8b", "srcset": "https://si.imgix.net/1c9bf1d4/uploads/origins/7bc6ec59-0b2e-4458-8df0-4efcd12afdaa?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=67306e3e9cdfe09e83660e2d6ae24e8b, https://si.imgix.net/1c9bf1d4/uploads/origins/7bc6ec59-0b2e-4458-8df0-4efcd12afdaa?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=68bc04a52c0c809870929d21a8cb2f4e 2x, https://si.imgix.net/1c9bf1d4/uploads/origins/7bc6ec59-0b2e-4458-8df0-4efcd12afdaa?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=5ce7fbdf37fa69afec489767dd092227 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/1c9bf1d4/uploads/origins/7bc6ec59-0b2e-4458-8df0-4efcd12afdaa?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a702a58be71d1b99f19d32db85050a9a", "srcset": "https://si.imgix.net/1c9bf1d4/uploads/origins/7bc6ec59-0b2e-4458-8df0-4efcd12afdaa?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a702a58be71d1b99f19d32db85050a9a, https://si.imgix.net/1c9bf1d4/uploads/origins/7bc6ec59-0b2e-4458-8df0-4efcd12afdaa?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=7a64f9ff4a4f03a5dedd63f94bba4552 2x, https://si.imgix.net/1c9bf1d4/uploads/origins/7bc6ec59-0b2e-4458-8df0-4efcd12afdaa?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=6b8be1e94b35a7a5170edc76f4b0069d 3x"}, "body": "はじめまして失礼します\n絵柄とハードな作風に惹かれてリクエストよろしいでしょうか\n\n・キャラクター\n異世界転移ファンタジーTRPG『幻奏戦記RU.LI.LU.RA』のパートナーキャラの歌姫『「困ったちゃん」な歌姫カタリナ』\n容姿は資料URLを参照\nキャラクターイメージは『明るい、ちょっとドジっ子な町娘』\n地方から都市に出てきた十代半ばくらいの子。髪と目は茶～赤茶くらいのイメージ。髪は解くと胸元にくるくらい（頭の後ろに見えるのは半被りの帽子です）\nアイテムを貰えたり、強化したり（たまに壊したり）してくれる道具屋の娘さんといった感じ\n（作品はロボットものだったり処女を失うと魔法が消えるとか色々設定ありますが、とりあえず王道異世界ファンタジーな認識で大丈夫です。電書版が試し読みできますので気になりましたらそちらでも・・・）\n\n・シチュエーション\n敗北して捕らわれ輪姦レイプ\nNTR要素はあまり好みではないので台詞などは不要です\n構図は過去作品より https://www.pixiv.net/artworks/140881560 のようなバック＋手コキ強制ぶっかけのような感じが好みですが、他に希望あればそちらでも構いません。\nその他不明な処は全てお任せしますので、よろしくお願いします\n\nhttps://drive.google.com/file/d/1oo-7cY4_Fej7DDxQ5_rzAzykC3pUZM2z/view?usp=drive_link", "nc": 57, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 264861, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "ユヅキ", "screen_name": "yuduki_nh", "avatar_url": "https://pbs.twimg.com/profile_images/2044767924905480192/UOOdTDCU.jpg", "header_url": "https://pbs.twimg.com/profile_banners/3071225964/1716744378/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 7, "complete_expiration_days": 60, "skills": [{"genre": "art"}, {"genre": "comic"}, {"genre": "video"}], "banned": false, "nc": 177}, {"id": 2257946, "creator": true, "nsfw_acceptable": false, "acceptable": false, "name": "あおえ*🐾おえかき", "screen_name": "aoe_oekaky", "avatar_url": "https://pbs.twimg.com/profile_images/1978890741263863808/-c8Mu4Z3.jpg", "header_url": "https://pbs.twimg.com/profile_banners/854774290578759680/1766367365/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "art"}], "banned": false, "nc": 17}, {"id": 2357230, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "Toyo＠イラストレーター", "screen_name": "Toyo59347", "avatar_url": "https://pbs.twimg.com/profile_images/1572950009435521025/kC7Ca7dj.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1462646205075230723/1637558383/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 