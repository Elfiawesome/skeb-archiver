手腕在手腕上的伤口即可。表情偏冷淡、郁闷、不是很开心，但需要让画看起来很可爱呢。\n立绘姿态可爱，气场偏俏皮。请自由发挥。\n身形纤细柔和，整体色调干净舒服\n贴合画师日常画风，细节合理自由发挥，仅个人收藏使用。\n\n下面的链接是人物设定图：https://cdn.discordapp.com/attachments/1437735112505692172/1505400212720451785/44.jpg?ex=6a0a7cb3&is=6a092b33&hm=9f4e52450c3c4ae66bbb52d59bcc768abdb191449c4468996ece016284b5bff1&", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@mochiko_0343/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3737472, "client_id": 3866549, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/26dd2cca/uploads/origins/7e2ae7fc-5f10-432d-8f97-0c6d52d58137?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b74db2e8b12b40ee2520423c0d428321", "srcset": "https://si.imgix.net/26dd2cca/uploads/origins/7e2ae7fc-5f10-432d-8f97-0c6d52d58137?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b74db2e8b12b40ee2520423c0d428321, https://si.imgix.net/26dd2cca/uploads/origins/7e2ae7fc-5f10-432d-8f97-0c6d52d58137?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ccfe9bdcf88bd585e604044a305327c5 2x, https://si.imgix.net/26dd2cca/uploads/origins/7e2ae7fc-5f10-432d-8f97-0c6d52d58137?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=3a0ff8036f313570b9f1bb497fc9a440 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/26dd2cca/uploads/origins/7e2ae7fc-5f10-432d-8f97-0c6d52d58137?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=1594773b25329fa8194081b627dfbcb7", "srcset": "https://si.imgix.net/26dd2cca/uploads/origins/7e2ae7fc-5f10-432d-8f97-0c6d52d58137?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=1594773b25329fa8194081b627dfbcb7, https://si.imgix.net/26dd2cca/uploads/origins/7e2ae7fc-5f10-432d-8f97-0c6d52d58137?bg=%23fff&