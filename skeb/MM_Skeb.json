/1SksLkaDhtyIMCCaiep3ELI1FSLZHHS9-/view?usp=drivesdk\n\nもし宜しければご検討の程よろしくお願いいたします。", "nc": 8, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@MM_Skeb/works/15", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3363041, "client_id": 320760, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/3d9c9458/uploads/origins/9b1fbe88-9af2-4567-9cc7-004c36cd910f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0576df14e2f538e4b556d8f71d5ac997", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/3d9c9458/uploads/origins/9b1fbe88-9af2-4567-9cc7-004c36cd910f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=1a48b7151e11085945ee2db2f4b67c40", "src_set": ""}, "body": "こんにちは。\nアヤナを描いてほしい。\nアヤンナは気まぐれなゴシック王国を支配しているので、彼女のポーズについては全面的にクリエイティブに任せます。キュートでロマンチックな感じで。\n\n\n参考資料\nhttps://sta.sh/0jue9itus3a\nhttps://sta.sh/0pb7jnrysok", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@MM_Skeb/works/14", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3363041, "client_id": 1713283, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/8f22df21/uploads/origins/4dbe1061-e9bc-4700-a4ae-303dd7b84813?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=20d4984daaf0d754a8dda1b68dc07a60", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/8f22df21/uploads/origins/4dbe1061-e9bc-4700-a4ae-303dd7b84813?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=674260e3094fe65cb108767644d6e056", "src_set": ""}, "body": "初めまして、先生の可愛いミニキャラの絵柄の惹かれました！\n男性キャラは可能でしょうか…？\nもし可能であれば私のOCのシラヌイさんを描いて頂けないでしょうか？\n\nシラヌイさんは黒に近い紫の