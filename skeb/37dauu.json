1b6e779b0fd4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=084b913d8fbadf93c20c96d5f8977d15", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/66004dc8/uploads/origins/db84e1fd-0936-4ca8-a651-1b6e779b0fd4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c8bc3a25ac19983b7b126008c81be666", "src_set": ""}, "body": "こんにちは、はじめまして！OCのルカをお願いしたいのですが、彼は7歳の王子です。ルカは釣りが好きだが、魚を釣る代わりに騎士の兜を釣る。\n\nhttps://imgur.com/a/64fwWW3", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@37dauu/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3511426, "client_id": 3128770, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/6ae57915/uploads/origins/a3106a38-6259-4573-b64a-33add3016d18?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d0ed1abee8c0e108b9b0b81d2e644f50", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/6ae57915/uploads/origins/a3106a38-6259-4573-b64a-33add3016d18?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=288fc688ff7a25ac2ea8c959b9683f05", "src_set": ""}, "body": "A: 稗田阿求。\nB：ギャル男キャラ。\n\n庭や屋外で。A'は荒く彫られた木片を調べている。A'は面白くなさそうで、軽くイライラしている。B」は包帯を巻いている。B」はニヤニヤしている。\n\nリファレンスリンクのフォルダはキャラクターごとに分けられている。\nA'のフォルダ。1'はキャラクター、'2-4'は表情の例、'5'+は彼女の追加描写。\nB'フォルダ。1」はキャラクターの特徴。'2'〜'4'は似たようなキャラクターの一般的な描写。5'は服装の種類。その他は雑学です。\n\n現在の関係レベルは、'B'は'A'の最近雇われた使用人である。\n\nB'が無謀にも'A'を魅了しようとしているというテーマに合うようであれば、自由に変更してください。もし値段が適切でなければ、お好きな値段で再送してください。\n\nhttps://drive.google.com/drive/folders/1aDRZcnGWCRkGcpcsDYxdkGFLN4vtfbXN?usp=sharing", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@37dauu/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3511426, "client_id": 2752312, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/c0d7bb9a/uploads/origins/2c4fec72-f30b-4427-bcaf-37f7f8e6971e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3132ac10b716f285fbacb4d14b7cb985", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/c0d7bb9a/uploads/origins/2c4fec72-f30b-4427-bcaf-37f7f8e6971e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=8c589bb5cbdd21386ffeaaae880b28b9", "src_set": ""}, "body": "こんにちは！今回は、@_mpmbl さんのウェブ小説「奇跡の探求にほかならない」 https://drive.google.com/drive/folders/1nxSurpHU4p-OVKi3cSfU3iVzfjC2GaLG?usp=sharing に登場する「ステラ」を描いていただきたいと思います。\n庭（https://files.catbox.moe/gxgjbk.jpg）でノームが何か気まぐれなことをしているところに、ステラが突然出くわすところを描いてください。詳細はお任せします。ありがとうございました！", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@37dauu/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3511426, "client_id": 851537, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/facd413f/uploads/origins/dce6cd14-3be5-4354-8609-217a8717779a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=799723da7ecca9ffc39bd835d55fe885", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/facd413f/uploads/origins/dce6cd14-3be5-4354-8609-217a8717779a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0cc25e3e2d739ae52db742951539bcbe", "src_set": ""}, "body": "眞田先生、こんにちは。Pixivで私のために描いてくれた美しい輝夜姫に改めて感謝します。\n\n今回は私のオリジナルキャラクター花月美也をお願いします。\nキャラクターリファレンス\nmega.nz/folder/cSdHDIhQ#CrEdR3wClmepvzRHxSaGqw\n\nhttps://www.pixiv.net/artworks/115646007 こんなポーズでお願いします。\n\n性格 - 物腰が柔らかく、高慢な巫女。\n昼寝好き。\nちょっと生意気な大和撫子。\n金髪で両目を隠したメカクレヘアーで、ミディアムレングスの乱れたハイポニーテール。\n気分を表す短いアホ毛がある。\n太陽をモチーフにしたヘアピンをつけている。\n目の色は秘密。\n身長 - 144cm前後。\n口を開けると白い牙が1本見える。\n愛媛の田舎の神社に住み、働いている。\n\nご配慮ありがとうございました。", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "similar_creators": [{"id": 1145074, "creator": true, "nsfw_acceptable": false, "acceptable": false, "name": "ベタス/Betas", "screen_name": "Betabetamaru_77", "avatar_url": "https://pbs.twimg.com/profile_images/1823677044993196032/jOtaKRCo.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1015172655509434369/1733810693/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "skills": [{"genre": "art"}, {"genre": "correction"}], "nc": 1}, {"id": 1688710, "creator": true, "nsfw_acceptable": true, "acceptable": false, "name": "KiiKo @アニメ原画風skeb", "screen_name": "Kiiko_clip", "avatar_url": "https://proxy.misskeyusercontent.jp/avatar.webp?url=https%3A%2F%2Fmedia.misskeyusercontent.jp%2Fio%2Fd4b360a8-1c07-44f9-b59a-94c6982e2227.gif&avatar=1", "header_url": "https://media.misskeyusercontent.jp/io/fb207f67-3c6c-47bb-9795-c6d4b3977f4a.webp", "appeal_receivable": false, "popular_creator_rank": 32, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "none", "accept_expiration_days": 8, "skills": [{"genre": "art"}], "nc": 49}, {"id": 1894899, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "ショウマ", "screen_name": "shomaueha", "avatar_url": "https://pbs.twimg.com/profile_images/1064466263001329664/VIfPFkWS.jpg", "header_url": "https://pbs.twimg.com/profile_banners/586299622/1642319208/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "skills": [{"genre": "