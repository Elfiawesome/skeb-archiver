s://imgur.com/HLx5amR\n\n公式サイト\nhttps://www.toei-anim.co.jp/tv/crayon/character/\n\n可能であればで結構です\nよろしくお願いいたします", "nc": 49, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@van_hooo10/works/8", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 157951, "client_id": 244927, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/921b7d0f/uploads/origins/3c4b8495-e55d-4e11-9b1b-a6f72a66bd27?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5181b37cb723250cd5b10dcb7dfb57d9", "srcset": "https://si.imgix.net/921b7d0f/uploads/origins/3c4b8495-e55d-4e11-9b1b-a6f72a66bd27?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5181b37cb723250cd5b10dcb7dfb57d9, https://si.imgix.net/921b7d0f/uploads/origins/3c4b8495-e55d-4e11-9b1b-a6f72a66bd27?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=909cde18c06f0b133e35c3ef9d48b735 2x, https://si.imgix.net/921b7d0f/uploads/origins/3c4b8495-e55d-4e11-9b1b-a6f72a66bd27?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=4ccbdf649a99286feb0aed742a172de5 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/921b7d0f/uploads/origins/3c4b8495-e55d-4e11-9b1b-a6f72a66bd27?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d0c700c01ea74e2b6ba5e5da7298638e", "srcset": "https://si.imgix.net/921b7d0f/uploads/origins/3c4b8495-e55d-4e11-9b1b-a6f72a66bd27?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d0c700c01ea74e2b6ba5e5da7298638e, https://si.imgix.net/921b7d0f/uploads/origins/3c4b8495-e55d-4e11-9b1b-a6f72a66bd27?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=5a204bd335d575f7eb671b5844e4a058 2x, https://si.imgix.net/921b7d0f/uploads/origins/3c4b8495-e55d-4e11-9b1b-a6f72a66bd27?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=f981a0b9342fe87c33ec3a7d15f91ba2 3x"}, "body": "リクエストです！\n\n資料ＵＲＬ中のコロン(ウサギ耳娘)がシエル(ふたなり)を押し倒しスカートをたくし上げ、おちんちんを露出しタマズリをしようとするというイラストをお願いします。\n参考資料にはない悪魔のような小さな蝙蝠の翼、かぎ状の尻尾の付与もお願いしたいですが着衣の具合・構図によってこれらが映らなくても構いません。\nまた画面内にシエルが登場しなくても構いません。\n\n【シチュエーション】\nコロンはシエルの見えない場所でふたなり淫魔に敗北し、ふたなり淫魔の仲間入りをしていた。\nコロンはシエルにその事実を明かして、半ば淫魔になりかけているシエルを完全に淫魔に堕とそうとする。\n愛の詰まったタマタマで淫魔の愛に目覚めちゃえ！\nのような台詞があると嬉しいです\n\nhttps://drive.google.com/drive/folders/1KdtiGYw01a1cjymV-_sNobwtz4i8mN-l?usp=sharing", "nc": 161, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@van_hooo10/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 157951, "client_id": 804110, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/7636a0d6/uploads/origins/6141b9a7-5806-4052-83cd-ddbf9c81d379?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5f9f0de74a826f80cac5d0f4b34b5897", "srcset": "https://si.imgix.net/7636a0d6/uploads/origins/6141b9a7-5806-4052-83cd-ddbf9c81d379?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5f9f0de74a826f80cac5d0f4b34b5897, https://si.imgix.net/7636a0d6/uploads/origins/6141b9a7-5806-4052-83cd-ddbf9c81d379?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f27a28980eaef62e247a4545cc854e2a 2x, https://si.imgix.net/7636a0d6/uploads/origins/6141b9a7-5806-4052-83cd-ddbf9c81d379?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b1cd9f860f1d174969fc7a2f7c75fc5c 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/7636a0d6/uploads/origins/6141b9a7-5806-4052-83cd-ddbf9c81d379?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=4b5ef10a9572459bd774eb456bf9829c", "srcset": "https://si.imgix.net/7636a0d6/u