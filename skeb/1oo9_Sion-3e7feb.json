ージ↓)\nhttps://twitter.com/arukarider/status/1458977039541628930 \n〈肌〉\n不健康な色白、クマあり、\nスナッグに埋まりかけのピアス穴\n〈衣装〉\n銀色の丸眼鏡(フレームは華奢で大きめ)\n〈設定〉\n女装癖のあるメンヘラ男\n(女装時はツインテやピンクエスクテ、アホ毛など)\n\nhttps://twitter.com/sakusak_u_sa_gi/status/1716444910251868605", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [{"path": "/@damage_so39/works/31", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1512971, "client_id": 1413712, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/d3319848/uploads/origins/79926d34-383f-45ef-9d14-80d7277f3a8b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9bd935fb98b04390257e48b1a9277671", "srcset": "https://si.imgix.net/d3319848/uploads/origins/79926d34-383f-45ef-9d14-80d7277f3a8b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9bd935fb98b04390257e48b1a9277671, https://si.imgix.net/d3319848/uploads/origins/79926d34-383f-45ef-9d14-80d7277f3a8b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=df6c3b7a16b8670a81a39d2ec43a92c8 2x, https://si.imgix.net/d3319848/uploads/origins/79926d34-383f-45ef-9d14-80d7277f3a8b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=0c8d0a8507ba4818a383b00adbc5269b 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/d3319848/uploads/origins/79926d34-383f-45ef-9d14-80d7277f3a8b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=8a48f5a9c5d1ab27de1c6e4a95c9c963", "srcset": "https://si.imgix.net/d3319848/uploads/origins/79926d34-383f-45ef-9d14-80d7277f3a8b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=8a48f5a9c5d1ab27de1c6e4a95c9c963, https://si.imgix.net/d3319848/uploads/origins/79926d34-383f-45ef-9d14-80d7277f3a8b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&c