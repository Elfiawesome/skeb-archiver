た\nもしよろしければリクエストを受けていただけないでしょうか\nサービス終了したネットゲームのマイキャラクターがモデルのうちの子になります\nお淑やかな性格でむっつりスケベ、胸は控えめのスレンダーな子で、お尻が性感帯です\n\n・希望する内容を箇条書きで\n「依頼衣装（ドレスまたは夏服）」というファイルの衣装を着せてあげてください\n（もしくは「その他衣装」から飛べるフォルダの中にお好みの衣装があれば、そちらを着せてあげてください）\n犬耳を着け、尻尾付プラグをお尻に挿入した状態（付け根のプラグが見えないような、尻尾だけお尻から伸びているような形状）\n恋人とのいちゃらぶセックス、または尻尾は無しでアナルセックス、その他オナニー、アナルオナニー、誘惑する様子…等々お好みのシチュエーションで\n犬になりきりながらorお尻で気持ちよさそうにしているイメージ\nとろとろで気持ちよさそうな表情\n相手の描写は無くても構いません\n胸の大きさは控えめ（Bカップ程度～つるぺたまでお好みで）\n服装は着衣～半脱ぎくらいでお願いします\n顔が見える内容で、その他構図などは描きたいものでお任せします\n\nご検討をお願いいたします\n\nhttps://drive.google.com/drive/folders/1gXZVDfcsl66QZ8VxPLKFXERqQXKioNsJ", "nc": 161, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 122739, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "のーむX", "screen_name": "gbc_adp", "avatar_url": "https://pbs.twimg.com/profile_images/1979907302162374656/2YsXAhCh.jpg", "header_url": "https://pbs.twimg.com/profile_banners/976004486522007552/1661779688/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 30, "skills": [{"genre": "art"}], "banned": false, "nc": 48}, {"id": 2119274, "creator": true, "nsfw_acceptable": true, "acceptable": false, "name": "ⓜⓐⓒⓐⓡⓞⓝⓨ@FANBOX", "screen_name": "macaronyyyyyyy", "avatar_url": "https://pbs.twimg.com/profile_images/1541124680119386113/7X-UoF5F.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1535581625932980224/1746371051/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 3, "complete_expiration_days": 45, "skills": [{"genre": "art"}, {"genre": "comic"}], "banned": false, "nc": 48}, {"id": 2428418, "creator": true, "nsfw_acceptable": true, "accept