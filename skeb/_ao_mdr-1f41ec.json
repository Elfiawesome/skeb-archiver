compress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f020b57f9b53d2bf170ad22b801b1359, https://si.imgix.net/c4a42074/uploads/origins/14ffce47-f9dd-465c-bed7-4ee2103f6de1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=4ea1fe0c91e87d070678f76146ef789e 2x, https://si.imgix.net/c4a42074/uploads/origins/14ffce47-f9dd-465c-bed7-4ee2103f6de1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=db621b2572900d3bc3ffdc435dcf0022 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/c4a42074/uploads/origins/14ffce47-f9dd-465c-bed7-4ee2103f6de1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6d9c5158fc3bf560ae5d29fa9380b9c2", "srcset": "https://si.imgix.net/c4a42074/uploads/origins/14ffce47-f9dd-465c-bed7-4ee2103f6de1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6d9c5158fc3bf560ae5d29fa9380b9c2, https://si.imgix.net/c4a42074/uploads/origins/14ffce47-f9dd-465c-bed7-4ee2103f6de1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=f303d3943788e023b87c4c57fdceb188 2x, https://si.imgix.net/c4a42074/uploads/origins/14ffce47-f9dd-465c-bed7-4ee2103f6de1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=90a29ff9c21e0237211808958b5a8d8e 3x"}, "body": "碧翠鳥様 \n\n初めまして、セルフ受肉Vtuberの白梅ルイ(しろうるい)と申します。\n先程 碧翠鳥様の素敵なイラストを拝見しまして、透明感や可愛さが本当に好みの絵柄で…、碧翠鳥様の描く白梅ルイを見てみたくて依頼リクエストを送らせて頂きました。\n\n【キャラクターの特徴】\n正面で見て、左側のインテーク、前髪の左側と右目の上の毛先に白メッシュがあります。\n瞳の瞳孔は花の形です。\nパッツン前髪ではなくアーチ状になっています。\n今回2枚見た目の参考画像を添付させて頂きましたが、どちらでも大丈夫です。\n\n【使用用途】\nX（旧Twitter）やYouTube(将来的に収益化の可能性有り)\n各種SNSのサムネイルやアイコン、ヘッダー等\n※使用例として、#おはようVtuber等で、イメージを損なわない範囲で軽微加工をする場合があります。\n\n構図等お任せしますが、かわいいpop調に描いて頂きたいです。顔周りに手があるほうが可愛くて好きなので出来れば…！\n碧翠鳥様の許可が頂けたら、ショート動画で沢山活用させて頂きたいと思っているので、本日あげていたようなミクちゃんのイラストのように顔周り〜バストアップが見切れない形でお願いしたいです。\nまた、可能であれば表情差分(例:笑顔 ウインク等 ポーズによってお任せします)も頂けると有難いです。\n要望が多すぎて申し訳ございません…。\n\nまた納品形式の希望として、\nお姿単体のpng形式か、もし背景があるようでしたらpsd形式でお願いいたします。\n\nご検討の程よろしくお願いいたします。\n\nhttps://drive.google.com/file/d/1l4LbDaOZ0LsNBjVuXxqCZeFRMIh-UByi/view?usp=drivesdk", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 141, "creator": true, "nsfw_acceptable": false, "acceptable": false, "name": "八朔つき", "screen_name": "starlet_moon", "avatar_url": "https://pbs.twimg.com/profile_images/1753761717090390016/hHqUAEkO.jpg", "header_url": "https://pbs.twimg.com/profile_banners/934399416928051201/1671350960/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 3, "complete_expiration_days": 60, "skills": [{"genre": "art"}], "banned": false, "nc": 145}, {"id": 41895, "creator": true, "nsfw_acceptable": true, "acceptable": false, "name": "へいわ", "screen_name": "heiwwwwwwa", "avatar_url": "https://pbs.twimg.com/profile_images/1945482134166147072/IvEYAufe.jpg", "header_url": "https://pbs.twimg.com/profile_banners/737376162167422976/1637222612/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 10, "complete_expiration_days": 120, "skills": [{"genre": "art"}], "banned": false, "nc": 49}, {"id": 2873339, "creator": true, "nsfw_acceptable": false, "acceptable": false, "name": "✉️", "screen_name": "nneiro_", "avatar_url": "https://pbs.twimg.com/profile_images/2061752886795849728/g1-RDQHZ.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1488528071863181314/1716131022/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 20, "complet