mage", "creator_acceptable_same_genre": false}, {"path": "/@noya_hu9ro/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2552022, "client_id": 473292, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/17825b97/uploads/origins/015a405c-bb37-4c6a-8bc6-55f5e1f7a875?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=17815b20d0addab8f29d15eed74f5676", "srcset": "https://si.imgix.net/17825b97/uploads/origins/015a405c-bb37-4c6a-8bc6-55f5e1f7a875?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=17815b20d0addab8f29d15eed74f5676, https://si.imgix.net/17825b97/uploads/origins/015a405c-bb37-4c6a-8bc6-55f5e1f7a875?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=719e514240ba9737ad957a3eee6d09ba 2x, https://si.imgix.net/17825b97/uploads/origins/015a405c-bb37-4c6a-8bc6-55f5e1f7a875?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b756cc59bbb71d35cf9d56eb3b4a7c1b 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/17825b97/uploads/origins/015a405c-bb37-4c6a-8bc6-55f5e1f7a875?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6d7a655ade7968568b5f0b4a1c919194", "srcset": "https://si.imgix.net/17825b97/uploads/origins/015a405c-bb37-4c6a-8bc6-55f5e1f7a875?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6d7a655ade7968568b5f0b4a1c919194, https://si.imgix.net/17825b97/uploads/origins/015a405c-bb37-4c6a-8bc6-55f5e1f7a875?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=4b463513148ec04b54470a92037b95f4 2x, https://si.imgix.net/17825b97/uploads/origins/015a405c-bb37-4c6a-8bc6-55f5e1f7a875?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=2172d6a0a9aeb3cd9cabb6817747458c 3x"}, "body": "Nice to meet you!\nI have been reading your SNS. I love the way the folds of the male character's clothes flow and the shading.\nI especially like the atmosphere of this picture!\nhttps://twitter.com/noya_hu9ro/status/1664209839541854209\nI'd like to have one of your characters in my BL novel \"Rei-Adulteration\" if you don't mind.\n\nCharacter\nChakura Ren\nA 26-year-old young man\nA psychic with a Kansai accent and a penny-pinching attitude, he is the grandson of a worshipper and has been possessed by a haunting god (visualized as an earth-colored tentacled earthworm-derived land deity) for generations.\nBlack hair with silver mesh on both sides Neat looking, host-like suit\nSlightly fished eyes\nHeight: 177cm\nHis special skill is a straight right hand with a bead sack. He physically expels evil spirits with a single punch.\nA talkative impostor according to Riichi, who has a rotten relationship with him\nWears black prayer beads on his left hand\nYoung president of Chakura Spiritual Services (abbreviated TSS)\nA master of Kyudo (Japanese archery)\nA pragmatist, cynical, and cynical person\n\nAttributes as a selfish, dominant, and aggressive person, but can also be a passive aggressor depending on the person he is playing with.\n\nThe following is a basic illustration by another artist.\nhttps://estar.jp/novels/26029651/viewer?page=1\n\nDesired Atmosphere\nJapanese horror/fantasy, bizarre, yokai\nI really like the world of SNS, so I would be happy if you could give me a similar taste.\nPlease dress in Japanese style.\nArrangements are welcome.\nI will leave any questions or details to you.\n\nI would like to use the finished work as a cover, illustration, or advertisement for the following pages or for an online novel.\nYour name and Twitter account will be clearly indicated.\nhttps://novel18.syosetu.com/xs8324a/\nhttps://www.pixiv.net/novel/series/9772542", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@noya_hu9ro/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2552022, "client_id": 982135, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/affaabbb/uploads/origins/4f00baa5-1a7d-48e0-b30c-649e210776ae?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1b623ed02ede688d135d062b7ffe58b7", "srcset": "https://si.imgix.net/affaabbb/uploads/origins/4f00baa5-1a7d-48e0-b30c-649e210776ae?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1b623ed02ede688d135d062b7ffe58b7, https://si.imgix.net/affaabbb/uploads/origins/4f00baa5-1a7d-48e0-b30c-649e210776ae?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=38a5e4e5b37522ee9c97c876b8ed663a 2x, https://si.imgix.net/affaabbb/uploads/origins/4f00baa5-1a7d-48e0-b30c-649e210776ae?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d0d97c97a04fa2fe18feed95e11afefa 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/affaabbb/uploads/origins/4f00baa5-1a7d-48e0-b30c-649e210776ae?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=4102ae4498f93cdefa12acb2c0515d2c", "srcset": "https://si.imgix.net/affaabbb/uploads/origins/4f00baa5-1a7d-48e0-b30c-649e210776ae?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=4102ae4498f93cdefa12acb2c0515d2c, https://si.imgix.net/affaabbb/uploads/origins/4f00baa5-1a7d-48e0-b30c-649e210776ae?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=d564c63c6d7650c3822d6bb59782c465 2x, https://si.imgix.net/affaabbb/uploads/origins/4f00baa5-1a7d-48e0-b30c-649e210776ae?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=05fe9ed0c940e4f9d424ab96073d7e8a 3x"}, "body": "Hello, my name is Mengyoshiyuki, and I am a private Vtuber.\nI love the darkness and saturation of your illustrations, so I was wondering if I could request your help!\n\nIntended use\nFor Vtuber activities\nI would like to use it for my Vtuber activities, thumbnails, videos, twitter, and other SNS.\n\nComposition\nI would like to ask you to use the Chinese costume shown in the URL as a reference for the outfit.\nIf you don't change the hairstyle, you can arrange the costume as you like.\nI would like the character to be nihilistic and cool, like the Chinese mafia.\nI love the coloring and atmosphere of the jigsaw previously drawn.\nI would appreciate it if you could deliver a PSD with the person and background separated, as I would like to use it for my Vtuber activities.\nThank you very much for your time and consideration.\n\nhttps://twitter.com/tsurayoshisachi/status/1570068581467197444?s=46&t=3EJ2UOnIKAd2MMyhDoorGw", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@noya_hu9ro/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2552022, "client_id": 1229857, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/19f806bd/uploads/origins/53796e03-bd9c-4c36-85d7-d7a3b9af3a14?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5bcff0f10ab7e9d33488ca1b43670c8a", "srcset": "https://si.imgix.net/19f806bd/uploads/origins/53796e03-bd9c-4c36-85d7-d7a3b9af3a14?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5bcff0f10ab7e9d33488ca1b43670c8a, https://si.imgix.net/19f806bd/uploads/origins/53796e03-bd9c-4c36-85d7-d7a3b9af3a14?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c4cad3acce77b80be728068898ad56b9 2x, https://si.imgix.net/19f806bd/uploads/origins/53796e03-bd9c-4c36-85d7-d7a3b9af3a14?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d6663d5163532139148218642ebccf9f 3x"}, "duration": null, "nsfw": false, "hardcore": false, "co