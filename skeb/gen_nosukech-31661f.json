ます。\n・オレンジ色のネイルを両手にしています。\n・両サイドの後ろ髪の一部がレイヤーカットになっていて前に流しています。\n・両サイドの耳裏当たりからぴょこっと髪の毛がはねています。\n\n【使用用途】\nYouTubeサムネイル、ショート動画、Xでのツイート\n\n【納品データ】\nPSDデータまたはPNGデータで背景透過したものも一緒に頂けると有難いです。\n\nお忙しいところ大変恐れ入りますが、よろしくお願いいたします。\n\nhttps://x.com/yukuri_kimama?s=21&t=QhmhnbzAu1LN8cyWphD8SQ", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@gen_nosukech/works/3", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/5ce27109/uploads/origins/4d786cbc-5136-4849-a88e-ccb71f3807d9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=828c6537b354a8df558ea72cdbb52ac4", "srcset": "https://si.imgix.net/5ce27109/uploads/origins/4d786cbc-5136-4849-a88e-ccb71f3807d9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=828c6537b354a8df558ea72cdbb52ac4, https://si.imgix.net/5ce27109/uploads/origins/4d786cbc-5136-4849-a88e-ccb71f3807d9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=a6b808401452c6bed46b0eabc16ae239 2x, https://si.imgix.net/5ce27109/uploads/origins/4d786cbc-5136-4849-a88e-ccb71f3807d9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=826dbcd864996d5047d4d9a4e9938169 3x"}, "private": true, "genre": "art", "tipped": false, "creator_id": 3914876, "client_id": 3376305, "nc": 17}, {"path": "/@gen_nosukech/works/2", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/b23de80d/uploads/origins/45ab7129-1661-4878-93d4-6ac598e2a540?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=