acceptable": true, "yearly_report_client_visible": false, "total_appeals_count": 0, "received_works": [{"path": "/@100_fan_sarasa/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3088700, "client_id": 0, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/006efd57/uploads/origins/c5292884-86c1-4c68-a2dc-7f42d3a4e5c5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=26f63debe4f461b39e1e6f23d2a246ab", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/006efd57/uploads/origins/c5292884-86c1-4c68-a2dc-7f42d3a4e5c5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d4347fee5a418524c75e7637b6896b06", "src_set": ""}, "body": "はじめまして。以下のような見た目のキャラの触手責めイラストをリクエストします。\n\n○キャラ（あまり凝ったものでなくて大丈夫です）\n・競スク姿（肩紐が細いタイプ）\n・髪型はツーサイドアップ。ウェーブがかったふわっふわの銀髪。後ろ髪は腰まで届く長さ。\n・身長は140cmくらい。腰は細いがロリ巨乳(Eカップくらい)。13、4歳くらいのイメージ。\n・青い垂れ目、童顔。性的なことに疎いオドオド系なイメージ。\n\n・○シチュエーション\n・触手の怪物に捕まって身動きが取れず、スク水の肩紐をずらされて両胸を露わにさせられ、先端が花弁のように開く触手に吸い付かれる（中が見えないタイプ）。吸われ続けるうちに何故か出るはずの無い母乳が出てしまい、ひたすら母乳を吸われて泣きながら喘ぐ。\n・表情は常に涙目で、望まない快楽を与えられて嫌がりながらも感じてしまう感じ。\n・触手の吸い口から母乳が少し漏れている。\n・もし金額的に可能なら、責めが始まる前の水着で胸が隠れている差分もお願いします。\n・秘部は露出させない。もし秘部への責めを描かれる場合は、水着を着たまま中に侵入してきた触手に挿入されて突かれる形で。\n・流血、アへ顔、陰毛、快楽堕ちはなし。\n\nいろいろ願望を書きましたが、とにかく胸責め重視で、えちかわな感じでお願いします。\nご検討よろしくお願いします。\n\nhttps://drive.google.com/drive/folders/1JU3Ms_Bt_80iax56i1iLEe4Ec64fTEBk?usp=sharing", "nc": 56, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@100_fan_sarasa/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3088700, "client_id": 3324026, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/32d76862/uploads/origins/41525b2d-f607-4e19-a1dc-694b0ac0ce1c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=850ed30a200088340235c05c4843c632", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/32d76862/uploads/origins/41525b2d-f607-4e19-a1dc-694b0ac0ce1c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0ec7a7e56794004c0fc1637f0dc84055", "src_set": ""}, "body": "ささらさ様\n\nお世話になっております。\n何笑天然と申します。 ささらさ様のイラスト、いつも楽しく拝見しております。  \n\n早速ではございますが、今回はささらさ様に以下の条件でイラストを一枚描いていただきたくご依頼の連絡を差し上げます。 \nご都合よろしければで構いませんので、ご一考いただけますと幸いです。  \n\n以下、条件になります。  \n\n・シチュエーション \n　海に遊びに来た女の子が、楽しそうに水かけ遊びをしている\n\n・女の子の外見 \n　→髪型\n　　色は紫寄りの白で長さは肩にかかるくらい\n　　後ろの髪は外に跳ねている\n　　前髪はそろってると嬉しいです。\n　→表情\n　　薄く目を開けて笑ってる表情\n　　垂れ目\n　　頬が少し赤くなってる\n　→服装\n　　海なので水着着用\n　　ワンピースタイプだと助かります\n　→体形\n　　色白でふくよかな体形\n　　多少、ほんのちょっとでいいので太ももをムッチリさせてもらえると本当に助かります\n\n・構図\n　正面から（水をかけられている人間から見た図）\n　手ですくった水を相手にかけた直後の、指を下に向けて手のひらをこちらに向けているポーズ\n　若干前かがみになっている\n　頭から膝上まで画角におさまっている\n\n・背景\n　舞台が海であることが伝われば特に指定ございません　\n\n・塗りイメージ\n　アニメ塗りでお願いします\n\n以上になります。 可能な限り詳細な条件を記載したつもりですが、観点漏れがあった場合はささらさ様の描きやすいように書いていただけますと幸いです。また、条件の中で描写が難しい部分があった場合はそちら無視して描いていただいて構いません。\n\nよろしくお願いいたします。", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "similar_creators": [{"id": 189726, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "茶糖さちこ", "screen_name": "happahrappa", "avatar_url": "https://pbs.twimg.com/profile_images/1826269055856377856/snFcO0Xa.jpg", "header_url": "https://pbs.twimg.com/profile_banners/3245237544/1755675928/1500x500", "appeal_receivable": true, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "skills": [{"genre": "art"}, {"genre": "correction"}], "nc": 177}, {"id": 301057, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "NIN.zip", "screen_name": "d_omis", "avatar_url": "https://pbs.twimg.com/profile_images/1256255468231524354/K8czN-UG.jpg", "header_ur