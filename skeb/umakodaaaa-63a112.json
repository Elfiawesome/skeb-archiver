t%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=074a776b92b06e96b0aba95dfb7e958c, https://si.imgix.net/f7f0f0e7/requests/147643_1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=6b7031c2aa3705b6903b1afb94f736bd 2x, https://si.imgix.net/f7f0f0e7/requests/147643_1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=c3b864148e39ec4e504694b2a1ee8af1 3x"}, "body": "初めまして！ツイッターでアイコンセットのものを見かけて、リクエストを送らせていただきました！  \n\nもし宜しければ、私の創作キャラのでアイコンを描いて頂かないでしょうか？ \n キャラの性格や容姿は資料URLから見て頂けたらなと…！！  \n可能であればデフォルメのものも描いて頂けると嬉しいです！\n\nキャラの設定は以下の通りのものです。\n・男性キャラ、何でも楽しむ快楽主義者。基本は笑顔 。\n  ・長くぼさぼさした長髪赤目/眼鏡/顎髭(普段は糸目,テンションが上がると開眼)  \n・白い上着に白のベスト、シャツは黒 \n・好奇心の旺盛で細かい事を考えず生きてるので、精神年齢が子供に近い\n・武器である刀を恋人あつかいしている変わり者。\n\n髪型がとても説明しづらいものなので、独自解釈等して頂ければなと。\n  改めてまして、よろしくお願い致します…！\n\nhttps://twitter.com/muginantoka/status/1200079909328023552?s=20", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@umakodaaaa/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 265913, "client_id": 304367, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/0cb4997a/requests/46338_2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=84bd3e4c2644ea72ec46d343388dc7cf", "srcset": "https://si.imgix.net/0cb4997a/requests/46338_2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=84bd3e4c2644ea72ec46d343388dc7cf, https://si.imgix.net/0cb4997a/requests/46338_2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=9a68631a074f52e42d76cf301ae06208 2x, https://si.imgix.net/0cb4997a/requests/46338_2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a71875afae32eae94ade12bfbab985ec 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/0cb4997a/requests/46338_2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2ae39b2ac8782caf99d82c220b561588", "srcset": "https://si.imgix.net/0cb4997a/requests/46338_2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2ae39b2ac8782caf99d82c220b561588, https://si.imgix.net/0cb4997a/requests/46338_2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=2d5a653042cd6f820b455365c3dba6d0 2x, https://si.imgix.net/0cb4997a/requests/46338_2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=ec9173309dc23f649bec92dd778b441f 3x"}, "body": "英 俊(はなぶさ すぐる)という多重人格のキャラクターの、戦闘狂の人格が相手方に啖呵を切っている所あたりをお願いしたいです。\nあたりと曖昧に言うのは、とにかくカッコいい所を見たいですだと曖昧過ぎるかなととりあえずある程度具体的にした形なので、とにかくカッコいい所が見たいですの方が描ける場合はそちらでお願いしたいです。\n得物として槍を扱いますが、必須ではないです。画面に入れる場合でも見切れていて構いません。\n\n36歳。要人の護衛職。180cm台前半。筋肉質。\n右目に眼帯。両耳に黒スギライトのピアスを一個ずつ。\n\n分かり辛いですが、黒髪に白髪交じりのキャラです。\n資料では忘れているのもありますが、01で言うと髪の白線はハイライトではありません。\n左側のグレーの部分は刈り上げています。あとは後ろに流している感じの。\n自身も雰囲気で描いていて毎回変わります( ˘ω˘)\n\n瞳の色は加工やらでまちまちになっていますが、グレーです。若干、目元に隈があります。\n\n戦闘狂の人格は、参考資料の、01_02、02_01の右上、07の真ん中(聞かざる)の雰囲気です。\n以下に参考台詞。\n\n・決闘に近い雰囲気のものを受けた時の口上。\n「あい承知した。某は英、英 俊だ」\n「名に恥じぬよう参ろうか」\n\n・大勢の刺客が待ち構えている場所に出て行かざるを得ず、出て行った時の口上。\nくつくつわらって\n「やあやあさてさて！ 命を惜しまぬ者から掛かって参れ！」\n「私は逃げも隠れもせぬぞ」\n「某は知り得ぬがなぁっ！！」\n（私(主人格)は正々堂々勝ちに行くけど、某(戦闘狂)は狡い手を使ってでも兎に角殺しに行くの意）\n（この後殲滅した）\n\n・不思議ぱわーで自己評価底辺の主人格に相対した時の口上。\nたんっ、柄で軽く地面を突いて相手方を見据えて\n「目耳を塞ぐな、双眸を見開け、両の耳を研ぎ澄ませよ！」\n「貴公もあれも某も！ 英俊(えいしゅん)の名を冠した者ぞ！！」\n「生きる為に為した事の何を恥じようか、何を憂おうか嘆こうか」\n「何を背負おうと道を進む事に変わりはせぬ」\n「歩みを止めるな、望むのならば押し通せ！！」\n（罪を犯したから愛される価値がないと卑屈になっていないで、やりたいことがあるなら通していけやぶっ飛ばすぞ）\n（この後ぶっ飛ばした）\n\n\nリクエスト文章ってこんなでいいんでしょうか、よろしくお願いします！！！！\n\nhttps://www.dropbox.com/sh/eda8ra3u5lbxols/AADfuEpw_YRwFgo-q4rYaAm7a?dl=0", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}], "sent_works": [], "similar_creators": [{"id": 611, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "🀄️ちゅん🀄️", "sc