23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=6e98768e06394685e1c250cf57e65f1b 3x"}, "body": "こんにちは。いつもお世話になっております、白紙あざれです。\n\n今回は定期更新ゲームStroll GreenのEno.16のキャラクター、\n弊PCのヤズマイアの戦闘用カットインをお願いしたく、\n連絡させていただきました。\n\n構図や状況はおまかせしますが、\n現在は支援・攻撃を中心としたビルドとなっているため、\nそういう使用を想定したものだとありがたいです。\n\n枠を付け加えるなど加工を行う可能性があります。\n\n金額はおまかせそのままですが、過不足ありましたら\n申し訳ないですがいい感じに雑にしたり付け加えたりして下さい。\n\n上記の条件でよければ、よろしくおねがいします！\n\nhttps://twitter.com/hack_b_/status/1423630622828875785?s=20", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@umakodaaaa/works/10", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 265913, "client_id": 920234, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/d14c9c34/uploads/origins/55ff54b4-2d4e-4841-838a-d6ad1af50f1f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8bd1c16e9aaded866d1c33e30bcbf31f", "srcset": "https://si.imgix.net/d14c9c34/uploads/origins/55ff54b4-2d4e-4841-838a-d6ad1af50f1f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8bd1c16e9aaded866d1c33e30bcbf31f, https://si.imgix.net/d14c9c34/uploads/origins/55ff54b4-2d4e-4841-838a-d6ad1af50f1f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=266fef3d0f7304975433e2f6e5d9dd76 2x, https://si.imgix.net/d14c9c34/uploads/origins/55ff54b4-2d4e-4841-838a-d6ad1af50f1f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ed356ec7c9d25b0a7357d88e754dede3 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/d14c9c34/uploads/origins/55ff54b4-2d4e-4841-838a-d6ad1af50f1f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=bcb45e01397d4f13d6676f7c264a9ab8", "srcset": "https://si.imgix.net/d14c9c34/uploads/origins/55ff54b4-2d4e-4841-838a-d6ad1af50f1f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=bcb45e01397d4f13d6676f7c264a9ab8, https://si.imgix.net/d14c9c34/uploads/origins/55ff54b4-2d4e-4841-838a-d6ad1af50f1f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=83cdb92c44ee71dec011d0fee421665b 2x, https://si.imgix.net/d14c9c34/uploads/origins/55ff54b4-2d4e-4841-838a-d6ad1af50f1f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=316cf7c0eb21c4f830e5c74f96bc74d4 3x"}, "body": "我が家の創作キャラのヅヌアィロスを馬子さんに描いていただきたく、依頼を出させていただきました！\n定期更新ゲームに使用するアイコン用等としてではなく、鑑賞用としてイラストを一枚お願いさせていただきたいです。\n\nキャラの外見・性格等について、参考までに下記に記載させていただきます。\nまた外見の参考資料として画像URLも併せて記載いたしますが、描く上で違和感が出る点等があれば無視していただいて問題ありません！\n\n構図や表情などお任せとなってしまいますが、もしよろしければお願いいたします……！\n\n\n■キャラについて\n[体格など]\n・背丈152cmほどの小柄な男、25歳。\n・肌色は褐色、筋肉質だが身軽に動くためのしなやかな体つき。\n・髪はくすんだ赤、硬めで尖りがちな髪質。首にかかるくらいの後ろ髪を後頭部で結び、前髪も後ろに流している。\n・目は薄い水色の三白眼、釣り目。瞳孔は黒く縦長。\n・歯はギザギザと尖った歯\n\n[服装]\n・裾がボロボロの黒地のシャツと、フード付きの濃紺マント。\n・茶色のズボン、両太ももにそれぞれナイフホルダーとポーチをつけるための黒いベルト。\n・靴は黒い編上靴\n\n[性格や振る舞い等]\n・不敵な笑み、悪い笑みやへらへら笑いをよく浮かべる軽薄さ。\n・戦うことや喧嘩が大好き、自分より大きな獲物を狩るハンター。接近戦を好むスピード型。\n・得物は不定だが『骨』の武器を扱い、『触れた骨の形状変化』という異能を用いて様々な形状で用いる。好むのは骨を連ねた鞭・鉤爪・刺突剣等。\n※参考情報としてですので、描く上で省いてしまって問題ありません。\n\n[参考画像URL]\nhttps://dl.dropboxusercontent.com/s/k9gpt7jydo48l6a/20210103_Zne.png", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@umakodaaaa/works/9", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 265913, "client_id": 13725, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/bb425d37/uploads/origins/7768a2dc-dd42-4348-8dcd-2283bda987fd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9bbb669080374520329c0f78af249467", "srcset": "https://si.imgix.net/bb425d37/uploads/origins/7768a2dc-dd42-4348-8dcd-2283bda987fd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9bbb669080374520329c0