あるのですが\n是非セーラー服で描いて頂きたいです！\n個人的にはでありますが以前公開されていたEagleMk1ちゃんやMONOちゃんがとても良いと思っているので\nその雰囲気やイメージで描いて頂ければと思います。\n\nもし難しいようでしたらナース服で描いて頂ければと思います。\nリンクを記載しますので確認いただければ幸いです。\n\n・ナース服\n（https://twitter.com/kohanaisii/status/1209771624947314689）\n髪型は白髪のツインテールで、\n濃紺とワンピースに白のエプロン、ウエストに巻いた大きなリボンが特徴です。\n頭に乗っているのはマスコットのもにゅぴょんです。\n\n表情や背景はお任せします！\nお手数お掛けしますが、どうぞよろしくお願い致します。", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@K6Azokusuki/works/11", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 963833, "client_id": 1333635, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/fbae9e65/uploads/origins/a41253cb-335e-43ee-9ec9-3b6d602806bb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=19f25555f84d0585cbed72ba8d60aa13", "srcset": "https://si.imgix.net/fbae9e65/uploads/origins/a41253cb-335e-43ee-9ec9-3b6d602806bb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=19f25555f84d0585cbed72ba8d60aa13, https://si.imgix.net/fbae9e65/uploads/origins/a41253cb-335e-43ee-9ec9-3b6d602806bb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=2034a6d1849732e42012392984beb768 2x, https://si.imgix.net/fbae9e65/uploads/origins/a41253cb-335e-43ee-9ec9-3b6d602806bb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=29ceeac996eedf3eda2592bc85f6681b 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/fbae9e65/uploads/origins/a41253cb-335e-43ee-9ec9-3b6d602806bb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=919f34174d1fc89378440461230d8041", "srcset": "https://si.imgix.net/fbae9e65/uploads/origins/a41253cb-335e-43ee-9ec9-3b6d602806bb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=919f34174d1fc89378440461230d8041, https://si.imgix.net/fbae9e65/up