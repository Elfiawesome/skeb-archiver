つり眉/日本人/179cm/38歳/喫煙者/苦労人/Aの保護者枠\n\nAとBは2人で赤いオープンカーに乗り、旅をしてる関係性です。Bが運転手です。AはBをよく揶揄ってたくさん話しかけます。Bは揶揄いに対してはやれやれと対応をしますが、話しかけた内容に対しては丁寧に接し、仲の良い関係性です。2人が親密そうであればどんな状況でも構いません。 ポーズや構図、服装などはお任せ致します。  依頼内容等に何か問題があれば、遠慮なくお断りください。 以上よろしくお願いします。\n\nhttps://drive.google.com/drive/folders/1-TqGFCj_jNgXJw7QNOyyrsNtfifjeD22", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 40399, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "しろかび🦹🏻", "screen_name": "Hi_ak10", "avatar_url": "https://pbs.twimg.com/profile_images/1640976807691452422/QBax_pI5.jpg", "header_url": "https://pbs.twimg.com/profile_banners/308334322/1707214125/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 80, "skills": [{"genre": "art"}], "nc": 48}, {"id": 50964, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "日雀", "screen_name": "hi_gara", "avatar_url": "https://pbs.twimg.com/profile_images/2032464887973281792/KFuG-gW4.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1029967108820455424/1775729776/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 120, "skills": [{"genre": "art"}, {"genre": "comic"}], "nc": 49}, {"id": 371733, "creator": true, "nsfw_acceptable": false, "acceptable": false, "name": "み", "screen_name": "miifa24", "avatar_url": "https://proxy.misskeyusercontent.jp/avatar.webp?url=https%3A%2F%2Fmedia.misskeyusercontent.jp%2Fio%2Faabf016b-e1e9-4330-ac31-841b57c5f648.webp&avatar=1", "header_url": "https://media.misskeyusercontent.jp/io/a87c8ee9-7cab-4d7f-86c5-abaaf97976af.png", "appeal_receivable": tru