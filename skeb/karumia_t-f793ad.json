a4384676?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=00b5d2f1567244666a3c098973631b9a, https://si.imgix.net/c5e542b6/uploads/origins/c8482eec-e328-4925-97b9-4ddda4384676?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=635823b145ccc0bdb27ea7df278d8288 2x, https://si.imgix.net/c5e542b6/uploads/origins/c8482eec-e328-4925-97b9-4ddda4384676?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=db1724f4e8c43af175a8bfb830f8681f 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/c5e542b6/uploads/origins/c8482eec-e328-4925-97b9-4ddda4384676?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f0164966e7713ee0279a69232f730400", "srcset": "https://si.imgix.net/c5e542b6/uploads/origins/c8482eec-e328-4925-97b9-4ddda4384676?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f0164966e7713ee0279a69232f730400, https://si.imgix.net/c5e542b6/uploads/origins/c8482eec-e328-4925-97b9-4ddda4384676?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=22fde21ef83e94219472df940fafbd8a 2x, https://si.imgix.net/c5e542b6/uploads/origins/c8482eec-e328-4925-97b9-4ddda4384676?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=3238710bb9a8c4b37b54a0448663d17d 3x"}, "body": "かるみあ様こんばんは、いつも本当にお世話になっております！\n別のリクエストをお願いしている中恐縮ですが、かるみあ様にデフォルメしていただきたい探索者がまた現れてしまったので重ねてリクエストを送信いたしました…！\n※本文に参加シナリオのネタバレは含まれておりません。\n\n\n■ OC詳細\n身長180cm／体重77kg／27歳／男性\n\n髪：前髪をかきあげて額を見せていますが、右目側の前髪が少しだけ下りていて、全体的に毛先が少しだけハネています。髪色は少し暗めでくすんだ青色。\n\n瞳：タレ目＋太めなツリ眉。笑うと少し可愛くなるなど、体格の割にはやや童顔寄りです。瞳色は黄色。\n\n体：STR16で筋力に自信あり、な服の上からでも胸筋などがうっすら分かるくらいのソフトマッチョです。肌色は標準より少し濃いめなうすだいだい色。\n\n服装：パイロットの制服(シャツの両肩にある肩章の黄色い線は3本)です。\n\n性格：仕事も遊びも全力で楽しむタイプのThe・光属性。純粋で気前の良い性格をしていて、喜怒哀楽の表現が豊かな男性です。\n幼いころから漫画が大好きで、「パイロットになれば俺も漫画のような冒険ができる！」と思ったことがきっかけでパイロットを将来の夢にした…というロマンチストな一面があります。\n\n\n■ その他\n服装のアレンジ(制服の袖の長さや帽子・ジャケットの有無)や構図・表情などはかるみあ様にお任せいたします。かるみあ様が好みだと思ったり、描きやすいと思った姿で描いていただけると嬉しいです。\n※可能であれば制服の帽子を脱いで髪が見えている状態だと嬉しいですが、それ以外でも大歓迎です❀\n\n\n■ イラストの使用先\nPCの壁紙などの個人鑑賞に使用いたします。また、SNSでアイコンとして使用する際はbioなどにかるみあ様のお名前を記載いたします。\n※以前描いていただいたソプスクHO1先生と並べて鑑賞する予定なので、HO1先生よりガッシリめに描いていただけると嬉しいです❀\n\n\n今回も私のリクエストをお読みいただきありがとうございました。お手すきの際にご検討いただけますと幸いです、何卒よろしくお願いいたします。\n※金額や内容的に難しい、または重ねてのリクエストが不可であれば遠慮なくリクエストをキャンセルしていただけますと幸いです…！\n\nhttps://drive.google.com/drive/folders/1FUl1mPNWquIX5sE4yFu14NCsf-R6VnB7", "nc": 24, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@karumia_t/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2533564, "client_id": 2721276, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/3c9337eb/uploads/origins/25780f87-7867-4f81-8015-63f37b7a32f6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=34fc1226368cfd7baf3dd28eb1163c3e", "srcset": "https://si.imgix.net/3c9337eb/uploads/origins/25780f87-7867-4f81-8015-63f37b7a32f6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=34fc1226368cfd7baf3dd28eb1163c3e, https://si.imgix.net/3c9337eb/uploads/origins/25780f87-7867-4f81-8015-63f37b7a32f6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=fbe592a74ea5c982a21d9e32b41f6f2c 2x, https://si.imgix.net/3c9337eb/uploads/origins/25780f87-7867-4f81-8015-63f37b7a32f6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=19b8db94ca76ede95ca7f700c536b885 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/3c9337eb/uploads/origins/25780f87-7867-4f81-8015-63f37b7a32f6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=120feeafcb704a6c6dcc02d0df88c3f7", "srcset": "https://si.imgix.net/3c9337eb/uploads/origins/25780f87-7867-4f81-8015-63f37b7a32f6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=120feeafcb704a6c6dcc02d0df88c3f7, https://si.imgix.net/3c9337eb/uploads/origins/25780f87-7867-4f81-8015-63f37b7a32f6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=60ab92f16be92464eb0236460fc6fe70 2x, https://si.imgix.net/3c9337eb/uploads/origins/25780f87-7867-4f81-8015-63f37b7a32f6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=871e187f7d67ab149c4287154b78b41e 3x"}, "body": "かるみあ様こんにちは、いつもお世話になっております！\n今回も私の探索者のSDイラストを描いていただきたいと思い、リクエストを送信させていただきました。\n(こちらのキャラクターはCoCシナリオ『キルキルイキル』の自探索者です。本文にシナリオのネタバレは含まれておりません)\n\n-------------------\n\n◆ キャラクター詳細\n身長175cm／体重58kg／28歳／男性\n【髪】右目側の額が見えるようになっている前髪で、全体的に少し外ハネっぽいところがあります。色は暗めのピンク色。\n【瞳】ややタレ目寄りで穏やかそうな雰囲気。右目は青寄りの水色でハイライト有り、左目は視力が無いので灰色でハイライト無し＋縫い傷があります。\n【特徴】左足は義足です。\n【性格】大学病院勤務の整形外科医。漫画家 兼 同居人である幼馴染(同卓PC)が描いた漫画が大好きで穏やかな男性ですが、裏の顔は闇医者です。\n医者に匙を投げられた患者たちや自分の目を治すために狂気的な治療や実験を繰り返していますが、それらを幼馴染に秘密にしていることに対して後ろめたさを感じているので、普段は幼馴染に過剰なほど優しく接しながら美味しい手料理を振舞っています。(実質、幼馴染を養っているような状態です)\n\n\n◆ 構図案\n① 紺色の医療用スクラブと白衣に赤色のネックストラップ・白色の安全スニーカーを着用していて、紫色の薬剤が入った注射器などの医療器具を持って穏やかに笑っている姿(資料URL内の『参考資料.png』に似た雰囲気)\n\n②上下スウェットにエプロン・スリッパを着用していて、おたまなどの調理器具を持って嬉しそうに笑っている姿(資料URL内の『一枚絵.png』に似た雰囲気)\n\nのどちらかで描いていただきたいと考えておりますが、それ以外の構図・服装でも大歓迎です。\nかるみあ様がこれだ！と思ったものを描いていただけたら嬉しいです❀\n\n\n◆ イラストの使用先\n個人観賞・SNSのアイコンとして使用させていただきます。SNSで使用する際はbioにかるみあ様のお名前を記載いたします。\n\n-------------------\n\n今回も私のリクエストをお読みいただきありがとうございました。お手すきの際にご検討いただけますと幸いです。何卒よろしくお願いいたします❀\n\nhttps://drive.google.com/drive/folders/1-dVWteZhIoDgErvWYLCXqP0cKJihox1V", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@karumia_t/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2533564, "client_id": 2286248, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/b1f07564/uploads/origins/1dcc0c43-044f-4345-9d5e-fc6cef0efcc1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a888c2e50a045ce484b17ad1006b4e22", "srcset": "https://si.imgix.net/b1f07564/uploads/origins/1dcc0c43-044f-4345-9d5e-fc6cef0efcc1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a888c2e50a045ce484b17ad1006b4e22, https://si.imgix.net/b1f07564/uploads/origins/1dcc0c43-044f-4345-9d5e-fc6cef0efcc1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f84fb8651469e786806c80ee94cf00be 2x, https://si.imgix.net/b1f07564/uploads/origins/1dcc0c43-044f-4345-9d5e-fc6cef0efcc1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=19efec32a38b17bed4e1cd83074f1853 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/b1f07564/uploads/origins/1dcc0c43-044f-4345-9d5e-fc6cef0efcc1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e7d3d3b5b087d5f1352e227e3eec058e", "srcset": "https://si.imgix.net/b1f07564/uploads/origins/1dcc0c43-044f-4345-9d5e-fc6cef0efcc1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e7d3d3b5b087d5f1352e227e3eec058e, https://si.imgix.net/b1f07564/uploads/origins/1dcc0c43-044f-4345-9d5e-fc6cef0efcc1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=bf8c118c5c3cbeb5ea7e76dc5956051b 2x, https://si.imgix.net/b1f07564/uploads/origins/1dcc0c43-044f-4345-9d5e-fc6cef0efcc1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=5f61179a5f728e314026ba513bcdd996 3x"}, "body": "かるみあ先生の絵いつもとっても素敵です！\n再び是非とも友人と自分のTRPG探索者のイラストを描いて頂きたいです。\n\n【用途】\nSNSへの掲載、アイコンやヘッダーへの使用、アクリルキーホルダーなどの個人グッズです。\n\n【キャラクター】\n資料URL先の2名のキャラを描いてほしいです。\n双方とも美術大学生で男性です。\n\nＡ：灰色がかった青紫髪で赤ピンクのハイライトの髪/タレ目/目にクマ/左目下にほくろ/左目に傷/ダウナー/175cm/絵画科油彩/大学3年生\nC：黒髪に緑のインナーカラー/眼鏡/オーバオールを腰のベルトで止めている/カチューシャ/後輩属性/ちょっと頑固/178cm/彫刻科/大学2年生\n\n形式的には恋人関係と呼ばれるような2人で肉体関係もありますが、歪な関係性であり、Aは孤独かつ依存体質で真面目で素直な後輩のCを自分の方へ引き摺り込もうとしますが今繋ぎ止めておければよく最後までCを縛ろうとはしようとしません。またCは人としてAを好いているので出来る限りAのそばにいたいと願っています。AがCに酒もタバコも教えており、CはAと同じ銘柄のタバコを吸っています。2人で映画を見に行ったり、Aの家で一緒に映画を見たりします。\n\n2名のキャラ単品ずつでも構いません。キャラ同士が被っている構図でも大丈夫ですが、レイヤー分けされているとありがたいです。\n\n依頼内容等に何か問題があれば、遠慮なくお断りください。\n以上よろしくお願いします。\n\nhttps://drive.google.com/drive/folders/1btOxSPgBX-SuKAlZ5yUus8QHYWqLF36j?usp=sharing", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@karumia_t/works/5", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/0ad23d23/uploads/origins/f72d33fe-f109-4c60-bafa-98f7ef79f84c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=976b1371ac8ad43771383725c04cfed5", "srcset": "https://si.imgix.net/0ad23d23/uploads/origins/f72d33fe-f109-4c60-bafa-98f7ef79f84c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=976b1371ac8ad43771383725c04cfed5, https://si.imgix.net/0ad23d23/uploads/origins/f72d33fe-f109-4c60-bafa-98f7ef79f84c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=d326c9089cc83ae209ea5bae319703db 2x, https://si.imgix.net/0ad23d23/uploads/origins/f72d33fe-f109-4c60-bafa-98f7ef79f84c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=e63774cf3613fe03fa8f7b64fbd75052 3x"}, "private": true, "genre": "art", "tipped": true, "creator_id": 2533564, "client_id": 2721276, "nc": 16}, {"path": "/@karumia_t/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2533564, "client_id": 2019076, "vtt_url": null, "