be配信（収益化済）のサムネイル \n・XやFANBOXでの投稿など \n・グッズ化の可能性（企業案件など）\n\n ご縁がありましたら、よろしくお願いいたします。", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@kiyu5733/works/9", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3912270, "client_id": 3225444, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/b44caf97/uploads/origins/8721e2d1-0f79-486f-b8e5-f4f70c5592c3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=cb3a6087183f37003512bfa511b77f83", "srcset": "https://si.imgix.net/b44caf97/uploads/origins/8721e2d1-0f79-486f-b8e5-f4f70c5592c3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=cb3a6087183f37003512bfa511b77f83, https://si.imgix.net/b44caf97/uploads/origins/8721e2d1-0f79-486f-b8e5-f4f70c5592c3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=9e986284f6e0b93bbb7c7544143716a0 2x, https://si.imgix.net/b44caf97/uploads/origins/8721e2d1-0f79-486f-b8e5-f4f70c5592c3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=76b5b8a044089468f50620f651bf6249 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/b44caf97/uploads/origins/8721e2d1-0f79-486f-b8e5-f4f70c5592c3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=8daf3e34814a6e3f99545e2c2a1e6eff", "srcset": "https://si.imgix.net/b44caf97/uploads/origins/8721e2d1-0f79-486f-b8e5-f4f70c5592c3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=8daf3e34814a6e3f99545e2c2a1e6eff, https://si.imgix.net/b44caf97/uploads/origins/8721e2d1-0f79-486f-b8e5-f4f70c5592c3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=f5430dd29670118c5209975037041a4d 2x, https://si.imgix.net/b44caf97/uploads/origins/8721e2d1-0f79-486f-b8e5-f4f70c5592c3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=497107504c680f76829472ab9161f0ba 3x"}, "body": "ゆきだるま様\n\n初めまして！個人Vtuberとして活動しております、みらいと申します。\nskebを閲覧していたところ、ゆきだるま様の透明感のあるイラストがとても目を惹き、\nぜひご依頼させていただきたく連絡いたしました。\n\n【使用用途】\n・youtubeのサムネや動画、配信での使用\n・Xへの投稿\n・印刷(ネットプリントなど)\n・グッズ制作\n\n【描いていただきたいキャラクター】\nみらいちゃん\n\n【服装、ポーズ】\n構図等はお任せいたします。\n\n頭に生えている花とリングは必ず入れて頂きたいです。\nサムネイルに使用したいため、上半身は見切れていないととても助かります。\n\n【イラストサイズ、ファイル形式】\nPNGまたはPSD\n・PNG形式の場合、背景のあるものと人物のみの透過データを頂きたいです。\n・PSD形式の場合背景と人物をレイヤー分けした状態で頂きたいです。\n\n長くなりましたが何か不備、不都合があれば申しつけていただきたいです。\nご検討いただけますと幸いです。\n\nhttps://drive.google.com/drive/folders/1xIZpe1OlyaJhvwCtYFKcq8x9iBjGPqve?usp=sharing", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@kiyu5733/works/8", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3912270, "client_id": 1300698, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/b84fc613/uploads/origins/1bfc936e-b028-45a2-9a4e-0c7b4cf38b5d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6d5368c107c38fc3adf02e076db4aa2a", "srcset": "https://si.imgix.net/b84fc613/uploads/origins/1bfc936e-b028-45a2-9a4e-0c7b4cf38b5d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6d5368c107c38fc3adf02e076db4aa2a, https://si.imgix.net/b84fc613/uploads/origins/1bfc936e-b028-45a2-9a4e-0c7b4cf38b5d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=130301c4f0e802a819299944adf77d77 2x, https://si.imgix.net/b84fc613/uploads/origins/1bfc936e-b028-45a2-9a4e-0c7b4cf38b5d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=bb76f7852e3e4c6e200fbbefe662bb44 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/b84fc613/uploads/origins/1bfc936e-b028-45a2-9a4e-0c7b4cf38b5d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w