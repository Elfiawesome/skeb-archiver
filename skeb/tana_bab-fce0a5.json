二律背反的な状態。\n\n空韻 百世(そらおと ももよ)\n//プロフィール\n一人称：わたし\n16歳/155cm\nSTR18/SIZ12/APP13\n//詳細\n幼少期から親に虐待を受けて育つ。基本的に大真面目、かつやや世間知らず。\n泣き虫、人見知り、気弱。弱々しい性格とは裏腹に祖母譲りの怪力と格闘センスを持つが、暴力を人へ振るわないことを徹底している。\n//十全に関して\n母性を擽られており、つい構ってしまう相手。珍しく踏み込んだ結果pvpを発生させまくったが、今ではこの人は脆い人なのだなと認識している。1人にならないようにとそばに居る。\n最近恋心を自覚した。\n\n以上になります。長文失礼致しました🙇‍♂️\n資料の方添付させていただきます‼️\nどうぞよろしくお願いいたします〜〜‼️‼️\n\nhttps://drive.google.com/drive/folders/1-0_JB673dMPBIZmzurrl6IBK9hBU54Qy", "nc": 153, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@yonimaru/works/39", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 454273, "client_id": 1782290, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/c2b830e9/uploads/origins/0e008710-acaa-49f1-aa71-cc519a57f2e9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b0ccac1b433f2d532919a26c762a3706", "srcset": "https://si.imgix.net/c2b830e9/uploads/origins/0e008710-acaa-49f1-aa71-cc519a57f2e9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b0ccac1b433f2d532919a26c762a3706, https://si.imgix.net/c2b830e9/uploads/origins/0e008710-acaa-49f1-aa71-cc519a57f2e9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=0375c6b0e833c17a33ccce1bbbdfbad2 2x, https://si.imgix.net/c2b830e9/uploads/origins/0e008710-acaa-49f1-aa71-cc519a57f2e9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f2e09351a51438486f87568da49df00c 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/c2b830e9/uploads/origins/0e008710-acaa-49f1-aa71-cc519a57f2e9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b6fe5a0addad47aad007d59da27ebc12", "srcset": "https://si.imgix.net/c2b830e9/uploads/origins/0e008710-acaa-49f1-aa71-cc519a57f2e9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=