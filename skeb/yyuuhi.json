9b1b629d-6a01-40bd-b5eb-a02469ff05c1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=61e1161177d4ef5b08f4e48985ce94bb", "src_set": ""}, "private": true, "genre": "art", "tipped": true, "creator_id": 450467, "client_id": 0, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 51, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@yyuuhi/works/40", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 450467, "client_id": 538669, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/e02b1f85/uploads/origins/1a417062-3eed-4089-b3f0-ba5721017958?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bd2e6149931fd2922a699aaa0e88663d", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/e02b1f85/uploads/origins/1a417062-3eed-4089-b3f0-ba5721017958?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e65a334518f137003529c6004de9e506", "src_set": ""}, "body": "チアガールの異種姦絵をお願いします。\n\n・女の子\n黒髪セミロング～ショートボブの巨乳美少女\n二次元ドリームノベルス的なチア衣装退魔士\n\n・衣装\n資料URLのかなり昔のチア衣装\n白ショート手袋&白ショート靴下&白スニーカー着用\nアンスコは前面背面共にフリフリ＆お腹まで覆うブルマ位の布面積タイプ\n企業ロゴは削除\n衣装破れはクロッチ部分のみ\n\n・相手\nゴツい類人猿的な亜人型の怪物\n\n・シチュ\n正常位でレイプ(腋が見えるように腕を頭の方に上げる感じで)\nアンスコと白パンツのクロッチに空けた穴からペニス挿入\n中出しで妊娠させられる恐怖・嫌悪感に目を見開きながら号泣絶叫するも、特濃熱々精子で子宮を満たされて絶頂\nその後受精したことを魔力的なやつで感じてレイプ目でボロ泣き\n\nhttps://imgur.com/2973uNJ", "nc": 41, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@yyuuhi/works/39", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 450467, "client_id": 0, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/78515fc4/uploads/origins/ac1b58ef-8865-469e-bd06-96d366c901db?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f3b859ca873948c6f8953364660df3d5", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/78515fc4/uploads/origins/ac1b58ef-8865-469e-bd06-96d366c901db?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=467c5f23814cb198f1ef8a8410c7b7a3", "src_set": ""}, "body": "吉飛雄馬 様\nリクエストの再送をさせていただきます。\n他制作等のスケジュールに空きがありそうな場合。是非ご検討いただけますと幸いです！\n\n先生作画の作品「ブレイブハンターあおい」が非常に好きで今回リクエストさせていただきます！\n\n■概要\nブレイブフェンサーが触手にアナルをエナジードレインされ犯されているイラスト\n\n■詳細\n●キャラクター\n・ブレイブフェンサー（作品名:ブレイブハンターあおい）\n\n●希望シチュエーション等\n・戦闘に破れ、傷つきながら触手に拘束されている\n・ポーズは、触手にまんぐり返しのような形でがっちりと拘束されてしまっている\n・衣装は部分的に破られ、その隙間から触手が侵入してしまっている\n・アナルの周りのスーツが破られ、アナルに太めな触手が挿入され、エナジードレインをしている（エナジーを吸って触手が光っているようなエフェクトがあると嬉しいです）\n・秘部周辺のスーツは感じさせらてしまい、おもらしをしているかのように愛液で大きく染みができてしまっている\n・表情は堕とされている感じではなく、感じさせられつつも必死に抵抗しているようなイメージでお願いします。\n・その他の要素つきましてはお任せいたします。\n\n●差分等\n価格内で可能でしたら以下のような物があると嬉しいです。\n・エナジーを吸われた影響で髪や目の色が変身前の葉月のものに戻ってしまっている差分\n・いくつかの表情差分\n\n以上となります。\n他作業等に差支えございませんでしたら是非ご検討いただけますと幸いです。\nよろしくお願いいたします。", "nc": 168, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@yyuuhi/works/38", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/b9762dda/uploads/origins/3a9752c9-6a2c-48c5-a0cf-ddb857af370a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=ce30ca1365329bf9cea50a655e7e6db2", "src_set": ""}, "private": true, "genre": "art", "tipped": false, "creator_id": 450467, "client_id": 0, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 161, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path