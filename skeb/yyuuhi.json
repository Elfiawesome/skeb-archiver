talign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=3cf4c7f054aa4ebbe956e5f2db999bd7", "src_set": ""}, "private": true, "genre": "art", "tipped": true, "creator_id": 450467, "client_id": 97761, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 176, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@yyuuhi/works/28", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 450467, "client_id": 789132, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/8d564720/uploads/origins/aebf5201-2020-40dd-ab85-3d4af50a27c9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=63cb7d7c73b0ee73c6cb8ffcec740069", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/8d564720/uploads/origins/aebf5201-2020-40dd-ab85-3d4af50a27c9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=639eff7e08c1925e4d9fdb6f2e2c0ffe", "src_set": ""}, "body": "初めまして。\nよろしければオリキャラのイラストの依頼をお願いします。\n\n・キャラクター\nskebにて描いて頂いたオリジナルキャラクターです。\n\nhttps://skeb.jp/@tuki_nami/works/43\nhttps://imgur.com/XDwhH6T\n\n・触手との戦闘に敗れ装備は所々損壊。こぼれた乳房に触手が纏わりつき嬲っている。\n・手足は触手に絡めとられており。両足は大きく開かれ、その股間を特別に太い触手の先端が狙っている。\n・触手やナメクジのようなヌメヌメしたものが嫌いな娘なので涙目で狼狽えている。\n・なお触手の形状や質感などはおまかせします。\n\n以上です。\nよろしければどうぞよろしくお願いいたします。", "nc": 41, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@yyuuhi/works/27", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/044cf612/uploads/origins/0566590d-d0e9-49c3-a189-6c18f6be6312?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=893d36f549d7f86369b57124c5f4cc28", "src_set": ""}, "private": true, "genre": "art", "tipped": tr