e, "genre": "art", "tipped": false, "creator_id": 3514372, "client_id": 3123390, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/afecec36/uploads/origins/2ed4df82-c733-4857-923b-173244aac0c4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=658b0e75377a83b02600e7941b2b22e7", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/afecec36/uploads/origins/2ed4df82-c733-4857-923b-173244aac0c4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=46149de6d5a5282f464057018e8f40e1", "src_set": ""}, "body": "こんにちは！私のVtuberキャラクターのアートワークをお願いしたいです。SNSへの投稿や配信での使用など、Vtuber活動のサポートとして使用させていただきたいです。背景透過など、追加で入れられるものがあればお願いします！   \n\n私のキャラクターが普段着・メイン服を着て、両目を開けて喜んでいる姿や、彼女の美意識に合った背景を描いていただけるとありがたいです。とてもかわいくお願いします！  https://skeb.jp/@wabu_mement/works/463 こちらの例がとても気に入っています。\n\n私のキャラクターの細部に注目してください。例えば、クマの耳の縫い目や、髪の2つの異なるピンクの色合い（色合いの間にコントラストがあることが重要です！あまり似せすぎないでください！)\n\n添付のファイルを参考に、インスピレーションを得てください。ありがとうございました！\n\nhttps://drive.google.com/drive/folders/1Ow3vUoEmgDFWvMq_q2lUDdliytlBG5xC", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@wabu_mement/works/555", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3514372, "client_id": 2504001, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/e80a79da/uploads/origins/bbd8609c-91ed-4fee-be2e-9ec509c4227a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0a47fe84a284d4bb1fe78aeb25e6a6d9", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/e80a79da/uploads/origins/bbd8609c-91ed-4fee-be2e-9ec509c4227a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ec8bf766b37ee7fb87501910112062ca", "src_set": ""}, "body": "こんにちは、突然のリクエスト失礼します！🙇‍♀️ あなたの絵がとても素敵なので、2人のキャラクターをお願いしたいです！どちらもFFXIVのOCです。\n\n彼氏と彼女です。ポーズはロマンチックかキュートな感じでお願いします。どちらのキャラクターもとても明るくて外向的で、それぞれ満面の笑みを浮かべて光を放っています。\n\n細かいところはお任せしますので、自由に描いてください！アルカディアのオッドカラーの目と顔のマークに注目してください。二人とも大きなウサギの耳を持っています。\n\nよろしくお願いします。🩵\n\nアルカディア\nhttps://drive.google.com/drive/folders/1cjt4EIwN8LVJQoOhtW-DsjTYUjBVG3Uy\n\nチャンドラー\nhttps://drive.google.com/drive/folders/1-eq-JbA_4PDgDF4moyqYYTjDc93bciWF\n\nカップル・コミッション\nhttps://drive.google.com/drive/folders/1-jRgzWKgGUWOfTO6TE_BCuA8gysAhOUz", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@wabu_mement/works/554", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/a301d2db/uploads/origins/ba27bfa8-61cb-4bd8-b9bb-1fbf097230ec?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=4d658faeb0636ded1321164284ee1410", "src_set": ""}, "private": true, "genre": "art", "tipped": false, "creator_id": 3514372, "client_id": 3433839, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 145, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@wabu_mement/works/553", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/3533084e/uploads/origins/e194c77f-42aa-4768-9a9a-137807e1d42c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=b5ebeb83d9f0a4c5aaf1e9c3fd57a23d", "src_set": ""}, "private": true, "genre": "art", "tipped": false, "creator_id": 3514372, "client_id": 3726697, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 144, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@