il_image_urls": {"src": "https://si.imgix.net/c66d527e/uploads/origins/18b5991b-24f2-41f1-829c-bf6fc53c0803?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=cf98da26de41b82b338d858d39fce648", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/c66d527e/uploads/origins/18b5991b-24f2-41f1-829c-bf6fc53c0803?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=96c1af7025c14595223b009de0d5e14b", "src_set": ""}, "body": "前回はお世話になりました\n\nKasa blancaの新作「ミッドナイトブルーワンピ」がデレステに実装されましたので、前回のルビーカウンテスにブルーワンピを着せて頂きたいと思います。\n構図の変更があっても構いません。\n\nいかがでしょうか？", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@puka_0507/works/72", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1777951, "client_id": 0, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/e2038809/uploads/origins/3939f3b2-f98c-4146-8f59-d7d7a9c734de?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=cc546a86353691836a05b59076483eec", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/e2038809/uploads/origins/3939f3b2-f98c-4146-8f59-d7d7a9c734de?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2d0f337b4ea80151abeec6fdf8988e23", "src_set": ""}, "body": "こんにちは。\n山下七海が好きななのでリクエストしました。\n\nキャラクター\n久海菜々美\n\n服装\n下記の中国選手のレオタード\nhttps://www.gettyimages.co.jp/search/2/image?events=775655430&family=editorial&phrase=Team%20China%20Tokyo%202020%20Olympic%20gymnast%20&sort=best&page=2\n\nポーズはお任せします。\n頭から爪先の全身でレオタードは際どいハイレグ、ムチムチボディて。\n\n宜しくお願いします。", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@puka_0507/works/71", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1777951, "client_id": 3623442, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/6fe31425/uploads/origins/da092809-00fc-41e2-80ab-a66a2728a64a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f961560a2dfad7b5df856280decdd388", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/6fe31425/uploads/origins/da092809-00fc-41e2-80ab-a66a2728a64a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=7ac71235bd553bfaa29c9f78e8105c21", "src_set": ""}, "body": "はじめまして。\n他の方のリクエストで美希を描いているのをみて、他の美希も見たいと思いリクエストさせていただきました。\n\n早速ですが、アイドルマスターに登場する「星井美希」をお願いしたいです。\n\n詳細としては、仕事が終わりプロデューサーと二人で事務所でひっそりとお祝いをしてくれている場面をプロデューサーの主観（美希が正面にいる）で描いていただきたいです。\n服装は私服（特に指定はありません）でお願いします。\n\nお忙しいとは思いますが、描いていただけると大変嬉しいです。", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@puka_0507/works/70", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/fd7c3e41/uploads/origins/b602315d-1bd2-4fb9-9036-966fe03dbd3a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=dc9110aff706e99591b9c766b4803822", "src_set": ""}, "private": true, "genre": "art", "tipped": true, "creator_id": 1777951, "client_id": 600058, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 177, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@puka_0507/works/69", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1777951, "client_id": 2392196, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/c10e03e4/uploads/origins/419e3745-ad00-45ae-9418-01d1497d6b6f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6048ddaf78a6cd7df5a12330709d0075", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/c10e03e4/uploads/origins/419e3745-ad00-45ae-9418-01d1497d6b6f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e89741adfb41ac7043bf50f28a39b417", "src_set": ""}, "body": "こんにちは、日番さん。東方プロジェクトの霧雨魔理沙の魔女の格好をした大槻唯を描いていただけませんか？満面の笑みでウインクしているような、そんな可愛らしい感じだと嬉しいです。あと、ハートがいっぱいで、かわいいものが飛び交っているような、呪文を唱えているような絵もお願いします。いつもありがとうございます。\n\nサンプル：https://drive.google.com/drive/folders/1cWcoEQWGg8SS2umcQbpxJGWE6xyqo7Nc?usp=sharing", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@puka_0507/works/68", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/99f625c1/uploads/origins/93996c3d-59fb-4819-a6e4-e46eb5991d9e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=7c780e46cac80483c6b1466ad8920599", "src_set": ""}, "private": true, "genre": "art", "tipped": false, "creator_id": 1777951, "client_id": 0, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 33, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@puka_0507/works/67", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/740c88dd/uploads/origins/266d52f1-8886-4273-9377-f95726de43e3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=2e2bf8dbb0616940a6142e7cb2c4187c", "src_set": ""}, "private": true, "genre": "art", "tipped": true, "creator_id": 1777951, "client_id": 600058, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": fa