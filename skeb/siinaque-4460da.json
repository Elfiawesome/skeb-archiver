=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=6e217189e54135b9ac4749878f4459fb 3x"}, "body": "はじめまして。\nオリキャラの糸織紡久を書いて頂きたいと思いリクエストします\n構図、テーマ等おまかせします\n単色、カラー、モノクロ等もお任せです\n思いついた構図等をお好きなように描いていただければと思います\n\n設定\n死にたがりだけど好きな人と心中するまでは絶対に死ねない子\n\n好きな色黒、白、緋褪色、赤\n嫌いな色、黄色、緑、黄緑\n\n性格\n物静かで読書をよくしている\nあやとりが好き\n人の行為を勝手に解釈し妄想して自分に好意があると突っ走る自己中心的な性格\n相手からの行動を好意と誤認し更に話を広げて自分の中で確定する厄介さがある\n非常に素直で聞かれれば答える\n孤児院育ちで都会はあまり好かない\n\n使用用途\n個人的な観賞用\n\nhttps://x.com/shiroha_san/status/1821523925895147548?t=bUF5B3QM5wSFbV0cfinoZQ&s=19", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}], "sent_works": [{"path": "/@UenoYamui/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 852783, "client_id": 2267896, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/ad70fc72/uploads/origins/bee21b9a-cae1-4c48-b232-d8fc2dc42fb8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c3dc972e8cfe6f17b57f86e700ae5775", "srcset": "https://si.imgix.net/ad70fc72/uploads/origins/bee21b9a-cae1-4c48-b232-d8fc2dc42fb8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c3dc972e8cfe6f17b57f86e700ae5775, https://si.imgix.net/ad70fc72/uploads/origins/bee21b9a-cae1-4c48-b232-d8fc2dc42fb8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=94981771c7a000ed2377fab0c6d2df0a 2x, https://si.imgix.net/ad70fc72/uploads/origins/bee21b9a-cae1-4c48-b232-d8fc2dc42fb8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e3b1c5dc4097c43b9de72f6d5419f60a 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/ad70fc72/uploads/origins/bee21b9a-cae1-4c48-b232-d8fc2dc42fb8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=91d2ebb7bc8bdb2cd47b5396c4227c69", "srcset": "https://si.imgix.net/ad70fc