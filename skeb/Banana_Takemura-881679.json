origins/d7735b67-0dcf-49e6-a4d6-1bdc6c6274df?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ec86d19edfdad75f4d8ed96b5e28539d", "srcset": "https://si.imgix.net/7fe2155a/uploads/origins/d7735b67-0dcf-49e6-a4d6-1bdc6c6274df?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ec86d19edfdad75f4d8ed96b5e28539d, https://si.imgix.net/7fe2155a/uploads/origins/d7735b67-0dcf-49e6-a4d6-1bdc6c6274df?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=87fe0408f736213f72cd4df94b0c11fe 2x, https://si.imgix.net/7fe2155a/uploads/origins/d7735b67-0dcf-49e6-a4d6-1bdc6c6274df?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=8ed898119bb07b4fbdc9784d2f5455d3 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/7fe2155a/uploads/origins/d7735b67-0dcf-49e6-a4d6-1bdc6c6274df?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d890be24fe4ccd1a8092911f9f8c1f05", "srcset": "https://si.imgix.net/7fe2155a/uploads/origins/d7735b67-0dcf-49e6-a4d6-1bdc6c6274df?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d890be24fe4ccd1a8092911f9f8c1f05, https://si.imgix.net/7fe2155a/uploads/origins/d7735b67-0dcf-49e6-a4d6-1bdc6c6274df?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=a89416a7365760118d32ba645638821d 2x, https://si.imgix.net/7fe2155a/uploads/origins/d7735b67-0dcf-49e6-a4d6-1bdc6c6274df?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=2ccb5ceea802427f9d953bfb6fa53e9d 3x"}, "body": "ばななさん、こんにちは参考リンクの一番上に載せているワンピースとサングラスをかけたアンダーテールのマフェットの全身絵をお願いしたいのです靴は服に合うものなら何でも構いません。サングラスのグラデーションやリム、ワイヤーなどは色味に合わせて自由に変更してください\n\nポーズは是非選んで欲しいです!少し躍動感がありつつも、もう少しリラックスした感じにしてほしいです。少し前かがみになって、両手を腰に当てたり、ピースサインをしたり、頭の後ろに置いたり、いろいろなポーズで写真を撮ります。基本的には、幸せそうな顔と熱狂的なジェスチャーによって、エネルギッシュに見えるように作られたシンプルなポーズなのです。\n\nかわいいと思うところ、描きやすいと思うところは、自由に変更してください。\n\nメガネなしバージョンや、bgを透過させたバージョンの入手方法もあると嬉しいです。本当にありがとうございました。\n\nhttps://imgur.com/a/3CD7OHP", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@Banana_Takemura/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 257597, "client_id": 1629647, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/fefc8f79/uploads/origins/23f3da40-b2fa-480e-ae99-afef42f867c6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bc6b02d595abb9969eafbff3a7b96ef2", "srcset": "https://si.imgix.net/fefc8f79/uploads/origins/23f3da40-b2fa-480e-ae99-afef42f867c6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bc6b02d595abb9969eafbff3a7b96ef2, https://si.imgix.net/fefc8f79/uploads/origins/23f3da40-b2fa-480e-ae99-afef42f867c6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=d41f1d58f0b64aa0de811c694959941f 2x, https://si.imgix.net/fefc8f79/uploads/origins/23f3da40-b2fa-480e-ae99-afef42f867c6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=74d83a99f964bde21dc3c3d083bd9755 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/fefc8f79/uploads/origins/23f3da40-b2fa-480e-ae99-afef42f867c6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=bb12b30b259f6a8a8a3323bfe42d452d", "srcset": "https://si.imgix.net/fefc8f79/uploads/origins/23f3da40-b2fa-480e-ae99-afef42f867c6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=bb12b30b259f6a8a8a3323bfe42d452d, https://si.imgix.net/fefc8f79/uploads/origins/23f3da40-b2fa-480e-ae99-afef42f867c6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=824d50b4c1823289b3380f92ad6e21ee 2x, https://si.imgix.net/fefc8f79/uploads/origins/23f3da40-b2fa-480e-a