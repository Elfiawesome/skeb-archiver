64-4d77-a3cb-453df0652bed?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=1a919b4c4ed69ae55cde48523b83d8e5 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/df9d1683/uploads/origins/3698ce14-3064-4d77-a3cb-453df0652bed?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f91f02173e704e49c77daab3496ae097", "srcset": "https://si.imgix.net/df9d1683/uploads/origins/3698ce14-3064-4d77-a3cb-453df0652bed?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f91f02173e704e49c77daab3496ae097, https://si.imgix.net/df9d1683/uploads/origins/3698ce14-3064-4d77-a3cb-453df0652bed?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=941d2fa7d386942275f5b5e3cc3f5d06 2x, https://si.imgix.net/df9d1683/uploads/origins/3698ce14-3064-4d77-a3cb-453df0652bed?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=35d20b3889572ab8d7411a5ff02c4280 3x"}, "body": "またお会いできて嬉しいです。お元気でいらっしゃいますか。\n私のスライムガール「グウェラティス」を描いていただけないでしょうか。彼女は少し気取っていて、家の中にいるのが好きで、インターネットで時間を浪費するのが好きなんです。\n\n服装は好きなもので描いていただいて構いません。\n\nまた、体形はもっと曲線的で、ヒップが広めな感じで描いていただけると嬉しいです。\nhttps://cdn.imgchest.com/files/654b4570ef0d.png\n\nグウェラティスの参考画像\nhttps://imgchest.com/p/9p4nvxk3lyn\n\nリクエストを読んでいただき、ありがとうございます", "nc": 32, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@hiiragiRagnarok/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2782288, "client_id": 68662, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/10009a3e/uploads/origins/0d823bf0-105b-4edc-98fe-85982930d587?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=411dfe9dd0b666f2587bb98efc7a8150", "srcset": "https://si.imgix.net/10009a3e/uploads/origins/0d823bf0-105b-4edc-98fe-85982930d587?bg=%23fff&auto=for