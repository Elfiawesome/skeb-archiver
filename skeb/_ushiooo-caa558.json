s! They also have peaceful moments too! I will leave the composition to sensei!\n\nFeel free to raise the price or cancel! Thank you!\n\nhttps://sta.sh/29tjzjlqkvg", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@_ushiooo/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2238703, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/f53983a2/uploads/origins/f9dcdda2-e674-4413-8a2c-1f8dc4578fac?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=34f8ab8dcdc1ea9dc1a0e49b88935d8d", "srcset": "https://si.imgix.net/f53983a2/uploads/origins/f9dcdda2-e674-4413-8a2c-1f8dc4578fac?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=34f8ab8dcdc1ea9dc1a0e49b88935d8d, https://si.imgix.net/f53983a2/uploads/origins/f9dcdda2-e674-4413-8a2c-1f8dc4578fac?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f4205fd981a6eb14b36214cc9ae69e43 2x, https://si.imgix.net/f53983a2/uploads/origins/f9dcdda2-e674-4413-8a2c-1f8dc4578fac?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=9358ab623bafc47fa332598299ea4705 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/f53983a2/uploads/origins/f9dcdda2-e674-4413-8a2c-1f8dc4578fac?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6d452317d64cba5be6c2ab43e6749f1b", "srcset": "https://si.imgix.net/f53983a2/uploads/origins/f9dcdda2-e674-4413-8a2c-1f8dc4578fac?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6d452317d64cba5be6c2ab43e6749f1b, https://si.imgix.net/f53983a2/uploads/origins/f9dcdda2-e674-4413-8a2c-1f8dc4578fac?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=4d9ba9db47f2599d69f8ac00bd302864 2x, https://si.imgix.net/f53983a2/uploads/origins/