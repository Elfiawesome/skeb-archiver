"discover": {"nsfw": true}, "american_express": {"nsfw": true}}}, "acceptable_only_public": false, "tip_acceptable": true, "yearly_report_client_visible": false, "total_appeals_count": 0, "received_works": [{"path": "/@minomarusteak/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3918655, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/bf20e0cf/uploads/origins/d94d252d-e7c4-482c-bb04-57714405344c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b964aff41a924632b43ae3a9720719a4", "srcset": "https://si.imgix.net/bf20e0cf/uploads/origins/d94d252d-e7c4-482c-bb04-57714405344c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b964aff41a924632b43ae3a9720719a4, https://si.imgix.net/bf20e0cf/uploads/origins/d94d252d-e7c4-482c-bb04-57714405344c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=0699b36b011712bb4a39641a0c395157 2x, https://si.imgix.net/bf20e0cf/uploads/origins/d94d252d-e7c4-482c-bb04-57714405344c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b3ea439513604ad35d7417b0f8ab846b 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/bf20e0cf/uploads/origins/d94d252d-e7c4-482c-bb04-57714405344c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2444631d181340eeaea3fe339d120cb0", "srcset": "https://si.imgix.net/bf20e0cf/uploads/origins/d94d252d-e7c4-482c-bb04-57714405344c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2444631d181340eeaea3fe339d120cb0, https://si.imgix.net/bf20e0cf/uploads/origins/d94d252d-e7c4-482c-bb04-57714405344c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=09c95ef4b24c89445f0207e37c041bf7 2x, https://si.imgix.net/bf20e0cf/uploads/origins/d94d252d-e7c4-482c-bb04-57714405344c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=d2b8f938ac4332037bf134d99170bb62 3x"}, "body": "またお会いしましたね。\n\n前回の「ショアキーパー」の作品、ありがとうございました。とてもセクシーでした。\n\n『原神』の「スキルク」をリクエストしたいです。ヒリチャールたちが戦闘でスキルクを倒し、その後、彼女を集団レイプするシーンをお願いします。\n\n注：スキークの腕と脚は、彼女自身の深淵のエネルギーで覆われています。ストッキングや手袋ではありません。そのため、それらの部分は衣装の一部であるかのように破れてはいけません。翻訳を通してもこの説明が伝わることを願っています。衣装の他の部分が破れていても構いません。\n\nヒリチャール\n参考：https://genshin-impact.fandom.com/wiki/Hilichurl\n\nポーズは自由です。\n\n射精の描写に違いがあると嬉しいです。ヒリチャールたちが彼女の中に射精する間、彼女が絶頂に達する様子に合わせて、表情がわずかに変化するといった表現もあれば尚良しです。\n\nヒリチャールのマークが彼女に付いているバージョンも作成してください（どちらが見えるかによって、胸のどちらか、またはお尻のいずれかに）。マークはヒリチャールの仮面のデザインと同じものです。\n\nその他の詳細はすべてお任せします。\n\nご検討いただきありがとうございます。\n\nhttps://genshin-impact.fandom.com/wiki/Skirk/Gallery?file=Shattered_Star_Turnaround.png", "nc": 40, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@minomarusteak/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3918655, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/9c54fafd/uploads/origins/af849208-e81f-4bad-9e54-4e78df9ba2f8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=232f3709cc055900ca2ffc9f96d64912", "srcset": "https://si.imgix.net/9c54fafd/uploads/origins/af849208-e81f-4bad-9e54-4e78df9ba2f8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=232f3709cc055900ca2ffc9f96d64912, https://si.imgix.net/9c54fafd/uploads/origins/af849208-e81f-4bad-9e54-4e78df9ba2f8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e59b9d582641667cfd9f4ac8aa4b8ae7 2x, https://si.imgix.net/9c54fafd/uploads/origins/af849208-e81f-4bad-9e54-4e78df9ba2f8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b36127221de5c1a3c86fb7abdf39eb10 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/9c54fafd/uploads/origins/af849208-e81f-4bad-9e54-4e78df9ba2f8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=746fdd0ace33d11bf5a63ff00617812a", "srcset": "https://si.imgix.net/9c54fafd/uploads/origins/af849208-e81f-4bad-9e54-4e78df9ba2f8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=746fdd0ace33d11bf5a63ff00617812a, https://si.imgix.net/9c54fafd/uploads/origins/af849208-e81f-4bad-9e54-4e78df9ba2f8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=4660d55e2931d913f1fb735d771329c8 2x, https://si.imgix.net/9c54fafd/uploads/origins/af849208-e81f-4bad-9e54-4e78df9ba2f8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=0a7008851d10f0519390dde2f26bfa2e 3x"}, "body": "過去作がよかったので依頼させていただきます。\n\n鳴潮のダーニャをお願いします。\n\n・キャラ\n鳴潮のダーニャ\nhttps://x.com/WW_JP_Official/status/2055845763687620777\n\n・シチュ\n主観視点のパイズリフェラの体勢で黒い巨根に媚びるようにキスしている。\n胸にQOSのマークをいれてください。\n瞳を閉じている差分をお願いします。\n髪飾りは必須で着衣・全裸はお任せします。\n\n可能であれば射精差分もお願いします。\n\n構図参考\nhttps://skeb.jp/@xN8XRA2JAU12YCB/works/71\nhttps://skeb.jp/@shinshin_ki/works/131\nhttps://skeb.jp/@kirin_shiritori/works/3\n\nご一考の上対応していただけると幸いです。", "nc": 33, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@minomarusteak/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3918655, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/da444b59/uploads/origins/cf876cf2-561b-436b-b74b-a9bdcf3bdc06?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e4e08f7352b83644e85c8e9583f2290d", "srcset": "https://si.imgix.net/da444b59/uploads/origins/cf876cf2-561b-436b-b74b-a9bdcf3bdc06?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e4e08f7352b83644e85c8e9583f2290d, https://si.imgix.net/da444b59/uploads/origins/cf876cf2-561b-436b-b74b-a9bdcf3bdc06?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=833855969a08b9d3287422221e8d4f4c 2x, https://si.imgix.net/da444b59/uploads/origins/cf876cf2-561b-436b-b74b-a9bdcf3bdc06?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=70fe1fb79b44acfa219a8a4a8a46961f 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/da444b59/uploads/origins/cf876cf2-561b-436b-b74b-a9bdcf3bdc06?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=1a905643ebe950bc5a0f30d2ef044221", "srcset": "https://si.imgix.net/da444b59/uploads/origins/cf876cf2-561b-436b-b74b-a9bdcf3bdc06?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=1a905643ebe950bc5a0f30d2ef044221, https://si.imgix.net/da444b59/uploads/origins/cf876cf2-561b-436b-b74b-a9bdcf3bdc06?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=dd9830d4c35092b8484a1e850ba609d1 2x, https://si.imgix.net/da444b59/uploads/origins/cf876cf2-561b-436b-b74b-a9bdcf3bdc06?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=3cc175bc6b1d1adf85fa1aa4fe43cde9 3x"}, "body": "はじめまして\n\n「ショアキーパー（Wuthering Waves）」を描いてください\n\nベールも描いてください\n\n彼女と複数の黒人男性（できれば3～4人）がセックスしている様子を描いてください\n\nポーズは自由ですが、男性たちが彼女のマンコや口を使っている様子が見たいです。\n\n彼女の胸の片方にQoSのタトゥーを入れてください\n\nイヤリング、チョーカー、指輪などのQoSのアクセサリーを身につけてください\n\nオーガズムの描写も入れてください。あなたの描く精液の表現がとても好きなので、オーガズムの描写にはたっぷりの精液が入っていると嬉しいです。\n\nもし指定が可能であれば、このようなモザイク処理を希望します\n\nhttps://www.pixiv.net/en/artworks/147651166\n\n以上が私のリクエストです\n\nご検討いただきありがとうございます\n\nhttps://wutheringwaves.fandom.com/wiki/Shorekeeper", "nc": 33, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@minomarusteak/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3918655, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/d47a286b/uploads/origins