fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=475098ae2ec3115e2a87ad7c2eb5bd92 3x"}, "body": "つるぎ輝さん、こんにちは！\n以前はこころちゃん&瑠唯さんの誕生日イラスト描いてくださりありがとうございました！\n\n今回、クリスマスに合わせて描いてもらえないかなと思い、ご連絡させていただきました。\n\nキャラクターを倉田ましろちゃんと悩んだのですが、朝日六花ちゃんでお願いしたいです。\n\nバニーサンタさんにプレゼントもらいたいなと思っています。\n\n日程や内容に問題あればキャンセルいただいて結構です。\nご検討よろしくお願い致します。", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@tsurugihikaru/works/15", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 392365, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/74f2c0f8/uploads/origins/edaa3f20-d87d-47bd-943f-8a77e464f224?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=91ab6ce14e659396191a9795e643c10f", "srcset": "https://si.imgix.net/74f2c0f8/uploads/origins/edaa3f20-d87d-47bd-943f-8a77e464f224?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=91ab6ce14e659396191a9795e643c10f, https://si.imgix.net/74f2c0f8/uploads/origins/edaa3f20-d87d-47bd-943f-8a77e464f224?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=87fd728c77638b36f3a302d047a6460d 2x, https://si.imgix.net/74f2c0f8/uploads/origins/edaa3f20-d87d-47bd-943f-8a77e464f224?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=72e6d2d8a8be027aee6f4620838b4b62 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/74f2c0f8/uploads/origins/edaa3f20-d87d-47bd-943f-8a77e464f224?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=4c4134a3c1b0eb6064cbb6019e5338e5", "srcset": "https://si.imgix.net/74f2c0f8/uploads/origins/edaa3f20-d87d-47bd-943f-8a77e464f224?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=4c4134a3c1b0eb6064cbb6019e5338e5, https://si.imgix.net/74f2c0f8/uploads/origins/edaa3f20-d87d-47bd-943f-8a77e464f224?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=50c141ce5a59fa40af2b031ecf643534 2x, https://si.imgix.net/74f2c0f8/uploads/origins/edaa3f20-d87d-47bd-943f-8a77e464f224?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=e2f152bfbf2d02b14669c7444a0b5340 3x"}, "body": "前回、アイリス部族化をリクエストしたものです。今回も部族化ものをリクエストさせていただきます。\n\n内容:白猫プロジェクトで登場する「カスミ」褐色部族化\n\n・肌色は前回のアイリスよりもさらに濃い褐色化でお願いします。(思いっきり濃くしてください。白猫プロジェクトのラズィーヤくらい隠していただけると嬉しいです。)\n・アングルは正面又は斜め前から(前回のような感じでも構いません。)\n・服装はほとんど全裸で、前回より、きわどい感じだと大変嬉しいです。\n・ボテ腹、鼻ピアス、口ピアス(他のピアスは全然構いません。)は無しでお願いします。\n・表情は自信ありげな感じか、少し悪そうな感じだと嬉しいのですが、お任せします。\n\n＊差分をお願い致します。\n・全裸差分、髪型差分(部族化後更に時が経った設定、前回のアイリスのように額のタトゥーをつけていたり、ショートヘアでガサツに切った状態でお願い致します。又、ショートヘアに限らず、部族っぽい髪型だったり、いろんな差分があると大変嬉しいです。元のキャラクターが分からないくらい自由に変化させていただけると嬉しいです。)\n\nいろいろ多くなってしまいましたが、是非ご検討の程宜しくお願い致します。", "nc": 33, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@tsurugihikaru/works/14", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 392365, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/d22cc58d/uploads/origins/f92c4b76-87ea-478c-a7ce-6b4790cae18b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bb266a6fd6ca4e93f5556f563d6e429d", "srcset": "https://si.imgix.net/d22cc58d/uploads/origins/f92c4b76-87ea-478c-a7ce-6b4790cae18b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bb266a6fd6ca4e93f5556f563d6e429d, https://si.imgix.net/d22cc58d/uploads/origins/f92c4b76-87ea-478c-a7ce-6b4790cae18b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=eb97327901c8c1aea268eb2bee801fc3 2x, https://si.imgix.net/d22cc58d/uploads/origins/f92c4b76-87ea-478c-a7ce-6b4790cae18b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=27aabbb1b60a29b58f9fe3111551b271 3x"}, "duration": null, "nsfw": false, "hardcore": fal