のプレゼントに、とご依頼に参りました。\n\nつり目または猫目、黒髪ぱっつんのお洒落をした女の子で、\n色合いや紙吹雪など明るい賑やかな雰囲気、\nあとたくほさんの文字の入れ方が好きなので、何か大きめに文字を入れて欲しいです！\n曖昧なリクエストですみません！よろしくお願いします。", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@naraiica/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 872183, "client_id": 921785, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/dc2e6ff9/requests/212702_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7de9827a3f01a858ca1296019c4281c3", "srcset": "https://si.imgix.net/dc2e6ff9/requests/212702_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7de9827a3f01a858ca1296019c4281c3, https://si.imgix.net/dc2e6ff9/requests/212702_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=95872b35ac15cad34277229d910004a9 2x, https://si.imgix.net/dc2e6ff9/requests/212702_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=364bd62ccc03def21a3cfb439f8bf898 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/dc2e6ff9/requests/212702_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b96543417c72abfea4b9964e229359c4", "srcset": "https://si.imgix.net/dc2e6ff9/requests/212702_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b96543417c72abfea4b9964e229359c4, https://si.imgix.net/dc2e6ff9/requests/212702_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=ae0d1f7ecb46e823132f778381fc66c2 2x, https://si.imgix.net/dc2e6ff9/requests/212702_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=45b86f16d116ecabfb7c82bc3fa147b5 3x"}, "body": "Nice to meet you Takuho-san. Can you please draw me in a sitting position with my chin resting in both hands? I'd like a cheeky or sweet smile.\n\nFor reference:\nhttps://twitter.com/coloursof_KaLRZ/status/1332815532870004736?s=20\n\nThank you in advance.", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@naraiica/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 872183, "client_id": 634319, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/9e113d0f/requests/207236_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e6a2fb91068adf5d68f7bc0608e2a793", "srcset": "https://si.imgix.net/9e113d0f/requests/207236_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e6a2fb91068adf5d68f7bc0608e2a793, https://si.imgix.net/9e113d0f/requests/207236_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=6f813288304af6522aaf4bad5d402c6d 2x, https://si.imgix.net/9e113d0f/requests/207236_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=09377468bfe7e2ffc3445e00bcf6e6fb 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/9e113d0f/requests/207236_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3e911d9f26b335afdec7c7422c52a3f6", "srcset": "https://si.imgix.net/9e113d0f/requests/207236_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3e911d9f26b335afdec7c7422c52a3f6, https://si.imgix.net/9e113d0f/requests/207236_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=3ca1a9ea84a8381dfd344be32ea62900 2x, https://si.imgix.net/9e113d0f/requests/207236_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=81cb40c6243e58d24c20c84adf4be8c3 3x"}, "body": "Hello!\n\nI'd like to request an illustration of my character in casual winter clothing, including a turtleneck shirt. I'll leave the rest of the details to you.\n\nよろしくお願いします！\n\nhttps://drive.google.com/file/d/1Z6JDwQhP6rurkWMp9z_C3wChjRh6fjJW/view", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@naraiica/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 872183, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/7aeacd6a/requests/200144_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ddd17dadf5a8974169c9b6c94a17c342", "srcset": "https://si.imgix.net/7aeacd6a/requests/200144_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ddd17dadf5a8974169c9b6c94a17c342, https://si.imgix.net/7aeacd6a/requests/200144_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=fcd4581724e6926a4315ce286d9c1dd4 2x, https://si.imgix.net/7aeacd6a/requests/200144_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=52ab59086d46d6e09e837a7428abe9dc 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/7aeacd6a/requests/200144_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a69601a2b07420fddd5c76455fbd7093", "srcset": "https://si.imgix.net/7aeacd6a/requests/200144_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a69601a2b07420fddd5c76455fbd7093, https://si.imgix.net/7aeacd6a/requests/200144_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=3b5c100da329f82764d9e91c5a456369 2x, https://si.imgix.net/7aeacd6a/requests/200144_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=30a4721df421e3aa7cd1e7943353cd1d 3x"}, "body": "ひなたくほさんのイラストが好きで、いつもTwitterから拝見しております！\nSkebのようなツールを利用したことがなかったため、リクエストするかとてもとても悩んだのですが、来年に悔いを残さないよう依頼を決意致しました。\nリクエスト内容がふわっとしていて申