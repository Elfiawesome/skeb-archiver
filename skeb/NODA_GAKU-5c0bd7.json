5/uploads/origins/aad9833e-27c5-4cd8-a5d6-6862678a9a07?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=6aad4f183d9643229fa27ec5e15e085d 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/8ea25fc5/uploads/origins/aad9833e-27c5-4cd8-a5d6-6862678a9a07?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=fe044f68df029fbe95017f2d891992a5", "srcset": "https://si.imgix.net/8ea25fc5/uploads/origins/aad9833e-27c5-4cd8-a5d6-6862678a9a07?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=fe044f68df029fbe95017f2d891992a5, https://si.imgix.net/8ea25fc5/uploads/origins/aad9833e-27c5-4cd8-a5d6-6862678a9a07?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=2fdc4f06e12adf00b31f74be3e6ca05c 2x, https://si.imgix.net/8ea25fc5/uploads/origins/aad9833e-27c5-4cd8-a5d6-6862678a9a07?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=5f71aafd1e254ee47401171b26663d95 3x"}, "body": "いつも御世話になっております。\n\n4番目の課題が終了した記念に……となれたら良かったのですが、それにはまだ時間が掛かりそうなので、再度「ヘラクレスによるレルネーのヒュドラー退治」を題材にしたイラストをリクエストさせて頂きます。\n\nヒュドラーが1本の首を切り落とされると、そこから2本の首が再生するという場面を、「ネメアの獅子退治」と「ケリュネイアの鹿の生け捕り」の時のような絵柄でお願いします。\n\n首を切り落とされた傷口から、先が膨らんだ2本の肉茎がムクムクと膨張して蛇の首になっていく様子を見たヘラクレスが何かを連想してしまい、その股間の大蛇が対抗心を燃やして鎌首をもたげ、腰巻きの前垂れを大きく持ち上げるという状況設定でよろしくお願い致します。\n性器部の露出は無い構図を希望しますが、念の為にNSFW設定で。", "nc": 49, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@NODA_GAKU/works/12", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 467375, "client_id": 48871, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/45255ee4/uploads/origins/6434e251-e9ad-49b0-ba80-ca3264294e54?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f859584060684e65cff8e0e0a0d6f03c", "srcset": "https://si.imgix.net/45255ee4/uploads/origins/6434e251-e9ad-49b0-ba80-ca3264294e54?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f859584060684e65cff8e0e0a0d6f03c, https://si.imgix.net/45255ee4/uploads/origins/6434e251-e9ad-49b0-ba80-ca3264294e54?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=469772791f5c96e47dae22c8b63ddb5a 2x, https://si.imgix.net/45255ee4/uploads/origins/6434e251-e9ad-49b0-ba80-ca3264294e54?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=eb2ca65af7afdb413df0e3ca33bcc9e1 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/45255ee4/uploads/origins/6434e251-e9ad-49b0-ba80-ca3264294e54?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e55762a2a737e9556bf866b90da9b987", "srcset": "https://si.imgix.net/45255ee4/uploads/origins/6434e251-e9ad-49b0-ba80-ca3264294e54?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e55762a2a737e9556bf866b90da9b987, https://si.imgix.net/45255ee4/uploads/origins/6434e251-e9ad-49b0-ba80-ca3264294e54?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=2bd49e6082a7431d5b877cef2f4e495a 2x, https://si.imgix.net/45255ee4/uploads/origins/6434e251-e9ad-49b0-ba80-ca3264294e54?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=84d25ec47dba21863779666b3d880eaf 3x"}, "body": "3つめの課題が片付いた記念に、ヘラクレスの12の難業の3つめ「ケリュネイアの鹿の捕獲」を題材としたイラストを依頼させて頂きます。\n\n青銅の蹄と黄金の角を持つ、狩猟の女神アルテミスの聖獣である駿足の鹿を追いかけ、獅子の毛皮をはためかせて全力疾走するヘラクレスの姿をお願い致します。", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@NODA_GAKU/works/11", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 467375, "client_id": 48871, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/72d6b2e6/uploads/origins/e2a08f61-d07d