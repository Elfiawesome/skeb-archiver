る\n\n女の子  身長160cm前後  17歳\n・顔はクールめな印象だが何かと世話焼き\n・上記の男の子は数少ない甘えられる対象\n\nこの二人は「庭騎士のスクールライフ」というフリーゲームのキャラでファンタジーな世界観の学生（同級生）です\n可能でしたら背景参考資料内の場所で二人が楽しそうに雑談している暖かい雰囲気のイラストをお願いしたいです\n背景の参考資料は雰囲気の把握程度で大丈夫なので自由にアレンジして下さい\n服装や装飾など分かりにくい部分も自由にアレンジして下さい\n御検討頂けましたら幸いです", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@mituhati8/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2205136, "client_id": 1106711, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/16ac0256/uploads/origins/78bfca2f-ec94-40b3-a0b3-c89fd3469d38?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9d666e649d64bd239c0b566ce11bb5fd", "srcset": "https://si.imgix.net/16ac0256/uploads/origins/78bfca2f-ec94-40b3-a0b3-c89fd3469d38?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9d666e649d64bd239c0b566ce11bb5fd, https://si.imgix.net/16ac0256/uploads/origins/78bfca2f-ec94-40b3-a0b3-c89fd3469d38?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=1d457eb38f1973fad680cc948325d191 2x, https://si.imgix.net/16ac0256/uploads/origins/78bfca2f-ec94-40b3-a0b3-c89fd3469d38?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=7a6c0d206ec95e174a2b586cff76f856 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/16ac0256/uploads/origins/78bfca2f-ec94-40b3-a0b3-c89fd3469d38?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=8e7094a2be4db24fc35709def5a900f9", "srcset": "https://si.imgix.net/16ac0256/uploads/origins/78bfca2f-ec94-40b3-a0b3-c89fd3469d38?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=8e7094a2be4db24fc35709def5a900f9, https://si.imgix.net/16ac0256/uploads/origins/78bfca2f-ec94-40b3-a0b3-c89fd3469d38?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=cro