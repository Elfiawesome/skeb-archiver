が露わになります。\n\nご一読いただき、誠にありがとうございます。\nもし機会がございましたら、ぜひ先生に描いていただけますと幸いです。\nhttps://drive.google.com/drive/folders/1aiYbL9sxpyqhtVlc67FmrnzSQfjaLnCH\n\nhttps://drive.google.com/drive/folders/1qNBGV-o-T5qFbBmJphu3aSKeeiilGbhq", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Nartr_0610/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3311095, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/4950383e/uploads/origins/2138cbef-631f-4221-a01a-50358f3ed3a7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=958c326083decaaa4a9743ebd5ffd152", "srcset": "https://si.imgix.net/4950383e/uploads/origins/2138cbef-631f-4221-a01a-50358f3ed3a7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=958c326083decaaa4a9743ebd5ffd152, https://si.imgix.net/4950383e/uploads/origins/2138cbef-631f-4221-a01a-50358f3ed3a7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b60dbb023f242134ece126367cae5818 2x, https://si.imgix.net/4950383e/uploads/origins/2138cbef-631f-4221-a01a-50358f3ed3a7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=dea9733aead95f850652904682b67d22 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/4950383e/uploads/origins/2138cbef-631f-4221-a01a-50358f3ed3a7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=efc877a40b6e9173fff7615ed5afd78d", "srcset": "https://si.imgix.net/4950383e/uploads/origins/2138cbef-631f-4221-a01a-50358f3ed3a7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=efc877a40b6e9173fff7615ed5afd78d, https://si.imgix.net/4950383e/uploads/origins/2138cbef-631f-4221-a01a-50358f3ed3a7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=96663560c7ae0455613ab321399