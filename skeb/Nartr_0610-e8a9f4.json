注意してほしいです。体格は細い)\n\n黒髪：180cm、冷淡そうに見えるが実は優しい子です。 ピンク髪へのいじめを見ていたため、ピンク髪に罪悪感を抱いている。そのため、ピンク髪に利用されている。\n（いくつのピアスをつけている。背は高いが、体格は細いタイプです）\n\n＜依頼＞\n指定シーンは特にないです。ダークな雰囲気に限らず、日常っぽいのも好きなので、気軽にお描きください！衣装も自由に選んでください🙇🏻リンク内には別のパロやTS設定もありますので、興味があればどちらを選んでも大歓迎です～\n\n\nもしこのリクエストが不快に感じられるようでしたら、キャンセルしても構いません。金額が足りない場合、お手数ですが再送要請をお願いします🙇🏻\n\nご多忙のところ恐縮ですが、ご検討のほど何卒よろしくお願い申し上げます。\n\nhttps://drive.google.com/drive/folders/1WN_Ccn42_xESB1V4oqnukCRi9LmG6KTM", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [{"path": "/@_wnut/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2274198, "client_id": 3311095, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/52cd09f1/uploads/origins/0a3092dc-05cc-487d-af21-3cb1ff89b164?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ae6cd9d20e8a91c8f19f7d4768b10ae8", "srcset": "https://si.imgix.net/52cd09f1/uploads/origins/0a3092dc-05cc-487d-af21-3cb1ff89b164?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ae6cd9d20e8a91c8f19f7d4768b10ae8, https://si.imgix.net/52cd09f1/uploads/origins/0a3092dc-05cc-487d-af21-3cb1ff89b164?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=3742c6def533ffe0473ee1287eb6618a 2x, https://si.imgix.net/52cd09f1/uploads/origins/0a3092dc-05cc-487d-af21-3cb1ff89b164?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=647a18573c0f9be8e0b87f9a9a5147b2 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/52cd09f1/uploads/origins/0a3092dc-05cc-487d-af21-3cb1ff89b164?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=dc2dae640ed66083a9e13b9c276eafe8", "srcset": "https://si.imgix.net/52cd09f1/uploads/origins/0a3092dc-05cc-487d-af21-3cb1ff89b164?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=