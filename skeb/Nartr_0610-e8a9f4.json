見里が役者として二人目：十という役を演じています。\nつまり、二人の人間ではなく同一人物です。\nですが、二人の人として描いて頂いても構いません！\n月見里は十と嫌いな弟を重ねて見ていて劣等感を抱いています。十はそれに気づいていません。\n十は盲目のピアニストで、いつも誰かの介助を必要としています。結構有名なピアニストです。\n\n【キャラクター資料】\n▼一人目、月見里 明慈\nhttps://drive.google.com/file/d/1W_5RwsFxAmko3Ob8qE9nzZgEhG6M7JXO/view?usp=drive_link\n本当はもっと服のセンスが良くあってほしいので、服装を改変して描いて頂きたいです...；；私のセンスが終わっているので...\n\n▼二人目、十 寧音\nhttps://drive.google.com/file/d/1eyWuS5dYUEB9UdGdE2BvWfsUJXDxYP1P/view?usp=drive_link", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Nartr_0610/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3311095, "client_id": 2850616, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/d2f1c603/uploads/origins/118ed7ce-83d2-451c-8d86-c7895f06417a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=504fd62ea390b1f3d1a71cc6e26fc747", "srcset": "https://si.imgix.net/d2f1c603/uploads/origins/118ed7ce-83d2-451c-8d86-c7895f06417a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=504fd62ea390b1f3d1a71cc6e26fc747, https://si.imgix.net/d2f1c603/uploads/origins/118ed7ce-83d2-451c-8d86-c7895f06417a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=563a843e6fd87816decc3b2f9e128526 2x, https://si.imgix.net/d2f1c603/uploads/origins/118ed7ce-83d2-451c-8d86-c7895f06417a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=9a61e607cd3fefbde3f4adcb45251ec0 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/d2f1c603/uploads/origins/118ed7ce-83d2-451c-8d86-c7895f06417a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=12e7d5624ff25da08099e61c77837163", "srcset": "https://si.imgix.net/d2f1c603/uploads/origins/118ed7ce-83d2-451c-8d86-c7895f06417a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&