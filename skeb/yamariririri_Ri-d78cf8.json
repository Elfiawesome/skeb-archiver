n=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=a0d4e267c501ae3b24a9007197d64d94 3x"}, "private": true, "genre": "art", "tipped": false, "creator_id": 204641, "client_id": 357123, "nc": 35}, {"path": "/@yamariririri_Ri/works/17", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 204641, "client_id": 316915, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/13ecbc68/uploads/origins/bec07be6-44e8-42d0-a47a-1ad86a3df932?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9b25ce1868d1def715e96c4ebe71010e", "srcset": "https://si.imgix.net/13ecbc68/uploads/origins/bec07be6-44e8-42d0-a47a-1ad86a3df932?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9b25ce1868d1def715e96c4ebe71010e, https://si.imgix.net/13ecbc68/uploads/origins/bec07be6-44e8-42d0-a47a-1ad86a3df932?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=7b4db9be260b65e97f20528a9c760559 2x, https://si.imgix.net/13ecbc68/uploads/origins/bec07be6-44e8-42d0-a47a-1ad86a3df932?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=6262ead6b53f7271b1bd7d82d3d50d60 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/13ecbc68/uploads/origins/bec07be6-44e8-42d0-a47a-1ad86a3df932?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=421b18d292acb9489567d65d23146cf8", "srcset": "https://si.imgix.net/13ecbc68/uploads/origins/bec07be6-44e8-42d0-a47a-1ad86a3df932?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=421b18d292acb9489567d65d23146cf8, https://si.imgix.net/13ecbc68/uploads/origins/bec07be6-44e8-42d0-a47a-1ad86a3df932?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=337d21845b9387ddfc95e72113d378d4 2x, https://si.imgix.net/13ecbc68/uploads/origins/bec07be6-44e8-42d0-a47a-1ad86a3df932?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=ce7dd3d19e191b5767deaf78dd523a86 3x"}, "body": "こちらでははじめまして\nガルパン界隈で情報発信アカウントを運用している「灰色服のプリン」と申します。\n今回、ガルパンに関心がありSkeb募集されているという事で、リクエストさせて頂ければと思います。\nもちろん内容は好き勝手に書いてるので、承認されるかはお気軽にご判断くださいませ。\n\nテーマはズバリ『私たちの分も戦いなさい！黒森峰愚連隊の応援団！』\n\nさて最終章第4話では残念ながら黒森峰まさかの敗退という衝撃の結末でありました。\nエリカ隊長の悔しい！という魂の叫びが劇場に響き、黒森峰ファンのヘコむコメントも結構見られました。\nしかし負けてしまったのはしょうがない。負けて黒森峰は黙っているのか。いや違う！\n時は無限軌道杯決勝戦、聖グロと大洗の戦いが繰り広げられていると想像してください。\nそっちはもはやどうでもいい！\n観客席には黒森峰勢がいるはず！\nそしてノンアルコールビールを片手にぐびぐび飲みながら、吹っ切れた黒森峰一行は愚連隊と化してドンシャン大騒ぎの観戦・応援をしているのでした。隣の一般観客者もドン引きレベルの、負けたという結果を応援という形で発散しているのです。\nしかもなんか自分らを負かした聖グロに１ミリくらい敬意を表してパンク風のトゲトゲ腕輪とか首輪とかつけて、マイクでオラオラ問答やら拡声器やら持って完全に愚連隊！暴走！よくも私たちの思い描いていた大洗VS黒森峰を潰してくれやがりましたわね！というファンの思いすら込めた応援という建前の圧力！プレッシャー！確実に味方ではない！でも応援はしてくれている！\nダー様も見て見ぬふりをするレベルの黒森峰最後の叫びを想像して描いてください。\n例えばマイクを持ってシャウトしてたり、フランクフルトをギザギザの歯でバリボリ食べてたり、ハチマキを巻いて今にも乱入しそうな人もいたり、ぶっ壊れたティーカップで飲んでるフリしてたり…どのキャラをどう描くかはヤマリウムさんのお任せです。\n\n黒森峰の魂の叫びを表現してください！\n\n完成作品には設定にもあるように必ず「灰色服のプリンさんへ」とサインをお願いします。\nよろしくご検討くださいまし", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@yamariririri_Ri/works/16", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 204641, "client_id": 396932, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/23147894/uploads/origins/be4c12e7-7144-47b8-b4e9-33d1ef593b78?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2fc4b2e9dcf4921464a021bf2470fde3", "srcset": "https://si.imgix.net/23147894/uploads/origins/be4c12e7-7144-47b8-b4e9-33d1ef593b78?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2fc4b2e9dcf4921464a021bf2470fde3, https://si.imgix.net/23147894/uploads/origins/be4c12e7-7144-47b8-b4e9-33d1ef593b78?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=0efd1b0ea34e465342bb640ad0412b95 2x, https://si.imgix.net/23147894/uploads/origins/be4