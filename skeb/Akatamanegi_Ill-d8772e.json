%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=7fdabb5cd8c7ed164d2e185bcadb9255 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/1c1b2e26/uploads/origins/e75231a4-eb3b-49b7-840a-6d778d60fe56?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5d4a5cef1350bb908b1931553559563a", "srcset": "https://si.imgix.net/1c1b2e26/uploads/origins/e75231a4-eb3b-49b7-840a-6d778d60fe56?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5d4a5cef1350bb908b1931553559563a, https://si.imgix.net/1c1b2e26/uploads/origins/e75231a4-eb3b-49b7-840a-6d778d60fe56?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=391d7d9a806e390ca2d6c876955b347e 2x, https://si.imgix.net/1c1b2e26/uploads/origins/e75231a4-eb3b-49b7-840a-6d778d60fe56?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=3cb0eb137544a2f6c054cc7f045eda38 3x"}, "body": "先生、お忙しいところ申し訳ありませんが、もし可能であれば、私のオリジナルキャラクター2体の交流シーンを描いていただけないでしょうか（可能であれば、画像7の衣装で描いていただけると幸いです）。以下が彼らの簡単な紹介です↓\n\nWagner（1）：アメリカ人、警察官。29歳、身長186cm、ドイツ系、栗色の髪、灰青色の瞳。厳格な印象で、頭の回転が速く、法律を遵守する。保守的な処世術を持ち、物質欲は低い。典型的なドイツ系刑事のステレオタイプに極めて合致し、厳格で抑制的、無秩序を嫌い、法律と論理を信奉する。ただし社交下手ゆえ寡黙→寡黙ゆえ交流が生まれない悪循環に陥りがち。ユーモアの理解度は評価困難（自らは妙だと自負）。Talonronanへの現在の態度：安心できず、協力しつつ監視、相手の言動に疑問（理解しようとはせず）、微妙な警戒心（親しげな態度に対して）。象徴動物はハイイログマ🐻\n\nタロンロナン（0）：作家、殺し屋。31歳、身長178cm、米中ハーフ、黒髪に薄緑色の瞳、見た目は非常に若く見える。性格はやや変わり者で、非常に穏やかで謙虚、人当たりが良いが、本質的にはやや冷淡で、決断力に優れ、容赦ない。養父に育てられた後、ずっと利用され、操られてきたが、養母を守るためにリスクを冒して彼女の離婚を手助けすることを選んだ。成長後、故郷を離れて家族から離れようとしたが、依然として養父に支配され続けたため、彼と徹底的に対立することを決意した。一連の事件を起こした後、警察に自首し、ワグナーを自分の後見人に仕立て上げた。\n現在のWagnerに対する態度：気遣い、好奇心、友好、保護、支配から逃れる希望として見ている彼の象徴動物はカワウソ🦦金額が合わない場合、再送リクエストをしていただけると大変助かります！今回のご依頼をお引き受けいただけたら本当に感謝します！\n\nhttps://drive.google.com/drive/folders/1H_KP1SbKS3V5HggDbwvkZRe1QVk2Z6aj?usp=share_link", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Akatamanegi_Ill/works/12", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3496436, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/d585ea6c/uploads/origins/e4b36687-f417-410b-adb5-cd56e9455283?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c007b16f748eb282973be4b01bb1f536", "srcset": "https://si.imgix.net/d585ea6c/uploads/origins/e4b36687-f417-410b-adb5-cd56e9455283?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c007b16f748eb282973be4b01bb1f536, https://si.imgix.net/d585ea6c/uploads/origins/e4b36687-f417-410b-adb5-cd56e9455283?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=0cb973a7790a475ac21fe5a907259320 2x, https://si.imgix.net/d585ea6c/uploads/origins/e4b36687-f417-410b-adb5-cd56e9455283?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=8c9479e5b4ca279712a0af4486b5b5f9 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/d585ea6c/uploads/origins/e4b36687-f417-410b-adb5-cd56e9455283?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9f78aa1165dc388ddeac3cdd039729a4", "srcset": "https://si.imgix.net/d585ea6c/uploads/origins/e4b36687-f417-410b-adb5-cd56e9455283?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9f78aa1165dc388ddeac3cdd039729a4, https://si.imgix.net/d585ea6c/uploads/origins/e4b36687-f417-410b-adb5-cd56e9455283?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=40b41c1db07fdd0c44d314e6ec0ad2ca 2x, https://si.imgix.net/d585ea6c/uploads/origins/e4b36687-f417-410b-adb5-cd56e9455283?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=282c3604cf0291500e63a7974d32f68d 3x"}, "body": "こんにちは！はじめまして！\nあなたのアートワークがとても好きなので、私の2人のヴァンパイアキャラクターをフィーチャーしたアートのリクエストをしたいと思います。\n最初のキャラクターはベンジャミンです。痩せ型で運動神経抜群。身長186cm。外向的で優しく賢いですが、無謀で反抗的でもあるヴァンパイアです。ヴァンパイアになってまだ日が浅く、新しい現実を受け入れるのに苦労している。2人目はオリバー。スリムな体格。身長184センチ。知的で創造的、冷静な人物だが、かなりおとなしく、不安な面もある。彼もまたヴァンパイアになったばかりで、血の渇きを抑えるのに苦労している。\nオリバーはベンジャミンがヴァンパイアになった理由であり、当然のことながら、ベンジャミンは最初オリバーのことを全く好きではなかった。オリバーは自分のしたことに計り知れない罪悪感を感じ、ベンジャミンと一緒にいることでさらに気分が悪くなった。ベンジャミンはオリバーに多くの憤りを感じていたが、彼を恨んでいても本当に憎む気にはなれなかった。オリバーを引き取った同じヴァンパイア一族がベンジャミンも引き取ったため、2人はお互いのそばにいることを余儀なくされた。しばらくの間、2人の関係はうまくいかなかったが、やがて2人は自分たちが当初考えていた以上に似ていることに気づいた。結局、2人は友人になった。\n\n彼らの友情のどの部分を描きたいか、彼らの関係の激動の初期か、最終的な友情か、自由に選んでください。ポーズ、構図、表情はお任せします。\n\nご検討、本当にありがとうございました！\n\nhttps://drive.google.com/drive/folders/1-7aqR7LbT7goXUZ1bqxMSNH7B9LUg1HL?usp=sharing", "nc": 9, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Akatamanegi_Ill/works/11", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/e12676f1/uploads/origins/22251737-7f4a-4303-b85c-080d07577687?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=1529018677394a5a550ac7c7d5e1ddb5", "srcset": "https://si.imgix.net/e12676f1/uploads/origins/22251737-7f4a-4303-b85c-080d07577687?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=1529018677394a5a550ac7c7d5e1ddb5, https://si.imgix.net/e12676f1/uploads/origins/22251737-7f4a-4303-b85c-080d07577687?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=c91f76ddc810fa128fb382b73f8d1211 2x, https://si.imgix.net/e12676f1/uploads/origins/22251737-7f4a-4303-b85c-080d07577687?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=bbd7b2c3455222363aac5d49ff6826d4 3x"}, "private": true, "genre": "art", "tipped": false, "creator_id": 3496436, "client_id": 3433329, "nc": 16}, {"path": "/@Akatamanegi_Ill/works/10", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3496436, "client_id": 2380580, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/bf17a741/uploads/origins/ae517256-6cf1-446f-8986-8d98b64d1ace?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0677ec22b15e06b572940ac6d8be0b49", "srcset": "https://si.imgix.net/bf17a741/uploads/origins/ae517256-6cf1-446f-8986-8d98b64d1ace?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0677ec22b15e06b572940ac6d8be0b49, https://si.imgix.net/bf17a741/uploads/origins/ae517256-6cf1-446f-8986-8d98b64d1ace?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ec981eb57e5421fab26d236026065eb5 2x, https://si.imgix.net/bf17a741/uploads/origins/ae517256-6cf1-446f-8986-8d98b64d1ace?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=aa0881ef1c359e19b2254c94ba60c013 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/bf17a741/uploads/origins/ae517256-6cf1-446f-8986-8d98b64d1ace?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9e0cfb34248a6f352174cd040616fd6c", "srcset": "https://si.imgix.net/bf17a741/uploads/origins/ae517256-6cf1-446f-8986-8d98b64d1ace?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9e0cfb34248a6f352174cd040616fd6c, https://si.imgix.net/bf17a741/uploads/origins/ae517256-6cf1-446f-8986-8d98b64d1ace?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=6ea4990146d6a4e9eb1d405d75aab61d 2x, https://si.imgix.net/bf17a741/uploads/origins/ae517256-6cf1-446f-8986-8d98b64d1ace?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=01d96580a7a6710143049bb2bfed779e 3x"}, "body": "こんにちは、私はランダムにあなたの仕事を見つけ、私は本当にそれが大好きです！\n特にこの作品 : https://skeb.jp/@Akatamanegi_Ill/works/2\nもし可能なら、KHIIIのソラのように星空を見つめる私のキャラクターで同じようなものを作りたいです : https://i.pinimg.com/1200x/33/ca/d3/33cad3f952d5a57e8f779095932e9b29.jpg\n\n私のキャラクター : https://drive.google.com/file/d/1Jxq4-4vCvnijelFo_F3b_RXG9S8ylB72/view?usp=drive_link\n\n私の要望を考慮していただき、本当にありがとうございます！", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Akatamanegi_Ill/works/9", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3496436, "client_id": 3440399, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/6e550026/uploads/origins/146a3ffd-e389-47ae-ba81-7843262c5037?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d0166a854db079521bc0b95640114962", "srcset": "https://si.imgix.net/6e550026/uploads/origins/146a3ffd-e389-47ae-ba81-7843262c5037?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d0166a854db079521bc0b95640114962, https://si.imgix.net/6e550026/uploads/origins/146a3ffd-e389-47ae-ba81-7843262c5037?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=1fdeba539e6a8b1e1fc28688f4189bb1 2x, https://si.imgix.net/6e550026/uploads/origins/146a3ffd-e389-47ae-ba81-7843262c5037?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=56fbe3459345845765b3d23b671290f7 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/6e550026/uploads/origins/146a3ffd-e389-47ae-ba81-7843262c5037?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=97344d39bb42acf5158820c34daadc57", "srcset": "https://si.imgix.net/6e550026/uploads/origins/146a3ffd-e389-47ae-ba81-7843262c5037?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=97344d39bb42acf5158820c34daadc57, https://si.imgix.net/6e550026/uploads/origins/146a3ffd-e389-47ae-ba81-7843262c5037?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=bc1bcc1c3588ce51be3dc071477a34a0 2x, https://si.imgix.net/6e550026/uploads/origins/146a3ffd-e389-47ae-ba81-7843262c5037?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=dc4c85b4444b255c835d3b52cab00a7c 3x"}, "body": "こんにちは、あかねたまねぎ先生！\n昨年から先生のFF零式や他のFFファンフィクスの絵を拝見させていただいて、とても楽しかったので、私の零式の2人のオクを描いていただきたく、依頼させていただきました～！\n\nキャラクターA\nクワイエット・プロスペクト\n16歳。ヴァーミリオン魔法学院2組のアギト候補生。\n実践的な才能にあふれた2班の中でも特に優秀な生徒の一人で、特に魔力のコントロールと既存の魔法の分析が得意。\nノートを持ち歩き、起こったことや出会った人を書き留める習慣がある。\n自由時間は墓地の近くで休んでいる。\n\n\nキャラクターB\n微笑む朱雀\n25歳。柔軟な指揮統制を担当する軍人。\nその騒々しすぎる性格から主戦場にはあまり派遣されず、補欠部隊とともに前線で活動することが多い。年齢とともに魔力は衰えたが、強敵であることに変わりはない。\nいつもボロボロのモーグル人形をベルトに下げている。\n人望が厚く、特に若い候補生には好意的。暇さえあれば魔法学校内を徘徊し、人を騙して飲み食いしている。\n\n\n\nふたりの関係／RELATIONSHIP\n友人であり同僚。戦場では共に戦い、上司と部下のような指揮官関係ではあるが、2人ともあまり身分を意識しないので、かなり対等な関係。\n一緒にいるときは基本的に2人でいて、それぞれのことをしたり、ぶらぶらしたりする。\n\nB】は「子供のような大人」、つまり考え方は大人だが行動は子供っぽい人であり、【A】は「子供のような大人」、知恵が早く経験も比較的浅いにもかかわらず、行動は大人でしっかりしている。\n両者の性格は、生活面でも戦闘面でも基本的に相補的である。しかし、オリエンスの高圧的な世界観では、2人が友人やパートナーとして過ごすことはほとんどない。\n普段は、一方が他方のストレスや痛みを分かち合うという原則に従っている。何があっても人間には解決できないことに関しては、この2人は互いに手を取り合い、最後まで一緒に立ち向かうことを選ぶのではないだろうか？\n\nリクエスト\n気軽にプレイしていただければと思います、よろしくお願いします！skebを使うのは初めてなので、依頼内容に難点や問題があれば遠慮なくキャンセルしてください。よろしくお願いします！\n\nhttps://drive.google.com/drive/folders/1afb_wnDr7_Mw0IsHuV65-6pF0Il7QoOF?usp=sharing", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Akatamanegi_Ill/works/8", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3496436, "client_id": 187493, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/3ebfd5ef/uploads/origins/5a0f311b-cab7-46c9-a661-542a9c1a4a5f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a8eed36c40850be9c27aaf0c29e9fbdd", "srcset": "https://si.imgix.net/3ebfd5ef/uploads/origins/5a0f311b-cab7-46c9-a661-542a9c1a4a5f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a8eed36c40850be9c27aaf0c29e9fbdd, https://si.imgix.net/3ebfd5ef/uploads/origins/5a0f311b-cab7-46c9-a661-542a9c1a4a5f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=461ba2bc7a21ed991456fdd4f7dce5b1 2x, https://si.imgix.net/3ebfd5ef/uploads/origins/5a0f311b-cab7-46c9-a661-542a9c1a4a5f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=3d50b101b23aa39339af6681df4241cf 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/3ebfd5ef/uploads/origins/5a0f311b-cab7-46c9-a661-542a9c1a4a5f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=06add03d0bee561fb63295f6559d3e18", "srcset": "https://si.imgix.net/3ebfd5ef/uploads/origins/5a0f311b-cab7-46c9-a661-542a9c1a4a5f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=06add03d0bee561fb63295f6559d3e18, https://si.imgix.net/3ebfd5ef/uploads/origins/5a0f311b-cab7-46c9-a661-542a9c1a4a5f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=ff4a2e21a26b2d424e2ad80c8bb2c5c8 2x, https://si.imgix.net/3ebfd5ef/uploads/origins/5a0f311b-cab7-46c9-a661-542a9c1a4a5f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=ba828bb92de14ced303d2a113aebf574 3x"}, "body": "はじめまして。\nこの2人のオリジナルキャラクターのイラストを描いていただけませんか？\n\n中世ファンタジーの世界で、人間はルーファスとローハンだけ。二人は一緒に世界を探検するラブラブな新婚夫婦です。\n\nルーファスは魔道士で昆虫学者。エイリアンの野生動物に関する世界初のネイチャーガイドを編纂している。彼は学者で、不器用で、飄々としていて、めったに笑わない元仙人だ。ルーファスはローハンに美しいものを見せて笑顔にさせようとする。ルーファスは虫の研究と甘いデザートを食べるのが大好き。ペットにキツネを飼っている。\n\nロハブは冒険者ギルドで働く黒ヒョウのシェイプシフター戦士。穏やかで、内気で、上品で、思いやりがあり、知的で、英雄的で、礼儀正しい。ルーファスの髪をとかしたり、料理を作ったりと、ルーファスの日常の世話を喜んでする。悲劇的な過去に悩まされているが、ルーファスと幸せに暮らしたいと思っており、全力で彼を守っている。\n\nどんなシーンでもOK！例えば\n- 新しい幻想的な風景を探索する。冒険的な雰囲気。\n- ローハンがルーファスを危険から救うアクションシーン。\n- キャンプや雨宿り。\n- 雪のような天候や、カエルの雨が降る嵐のようなファンタジーの天候をナビゲートする。\n- 家で静かな愛情を楽しむ。\n- ローハンが悲しんでいるときに、ルーファスがローハンを慰める。\n- キツネが問題を起こすコミカルなシーン。\n\n使用用途：SNS、OC活動、個人的な閲覧のみを目的とした画像の印刷の可能性。\nいずれにせよ、このリクエストを読んでいただきありがとうございます。\n\nhttps://drive.google.com/drive/folders/15Za0-L6j3mKiLR0vFr6zx-c6bvEJgIyJ?usp=drive_link", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Akatamanegi_Ill/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3496436, "client_id": 187973, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/30dc9325/uploads/origins/6d6ef353-c77e-411a-8bf7-29143608a15c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3153d79158680382cffc3effab79f54a", "srcset": "https://si.imgix.net/30dc9325/uploads/origins/6d6ef353-c77e-411a-8bf7-29143608a15c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3153d79158680382cffc3effab79f54a, https://si.imgix.net/30dc9325/uploads/origins/6d6ef353-c77e-411a-8bf7-29143608a15c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e625aeffd8587b25d66019d913f082ab 2x, https://si.imgix.net/30dc9325/uploads/origins/6d6ef353-c77e-411a-8bf7-29143608a15c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=23eb93b7cc5ef6bf1bc2ce9251c2edf5 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/30dc9325/uploads/origins/6d6ef353-c77e-411a-8bf7-29143608a15c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3c5d191e59bdb95d38c19e9ea1ff714c", "srcset": "https://si.imgix.net/30dc9325/uploads/origins/6d6ef353-c77e-411a-8bf7-29143608a15c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3c5d191e59bdb95d38c19e9ea1ff714c, https://si.imgix.net/30dc9325/uploads/origins/6d6ef353-c77e-411a-8bf7-29143608a15c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=59d84b2acaec63971eff29cf3faca0c0 2x, https://si.imgix.net/30dc9325/uploads/origins/6d6ef353-c77e-411a-8bf7-29143608a15c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=bc763a46f27defcf4b6dcad0cd54c612 3x"}, "body": "こんにちは！あなたの絵はとてもきれいですね！\n\nこの二人のオリジナルキャラクターのイラストを描いていただけませんか？\n中世のゴシックホラーのような設定です。\n\nフォルダにあるモダンな衣装は無視してください。\nフォルダーにある衣装のどれかを使うか、自分でデザインしてください。\n\nアロイス\n旅するヴァンパイアハンター\n180センチ。金髪の男性。痩せ型。\nおしゃべり、いたずら好き、ずるい性格。\n\nゲイブ\nヴァンパイア\n186センチ。灰色の髪の男性。筋肉質。\n普段の表情は笑顔。不遜でカジュアルな性格だが、密かに非常に危険。\n天文学者。\n尖っていない普通の耳をしている。\n\nヴァンパイアであるにもかかわらず、アロイスはゲイブに好意を寄せている。彼らは怪物や吸血鬼と戦うために一緒に旅をする。\n\n夜の不思議で不気味な村を一緒に探検しているシーンを描いてください。\nミステリアスで冒険的な雰囲気です。\n\n使用目的OC活動、SNS、個人で閲覧するための印刷のみ\n\nリクエストを読んでいただきありがとうございます！\n\nhttps://drive.google.com/drive/folders/1Fbbu_xaIu2Om7r4oH4BxG5OzxqK-qHC7?usp=drive_link", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Akatamanegi_Ill/works/6", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/10725f02/uploads/origins/c984fc8f-5e05-4898-9119-b0ba10055156?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=546c3155f1b43e2ed5d9aa8fb34fb168", "srcset": "https://si.imgix.net/10725f02/uploads/origins/c984fc8f-5e05-4898-9119-b0ba10055156?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=546c3155f1b43e2ed5d9aa8fb34fb168, https://si.imgix.net/10725f02/uploads/origins/c984fc8f-5e05-4898-9119-b0ba10055156?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=725c3c9fdcf566918684cd716f047d81 2x, 