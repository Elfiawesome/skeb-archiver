Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=62b49aa29a22452a5fbd48c8b5b03418 2x, https://si.imgix.net/0d1b6e87/uploads/origins/0e7d8a77-7d99-45e3-90c0-fa93d495f161?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=ac8906903a1a4d14ea7745618f396189 3x"}, "body": "ガルパンのレズセックスイラストに惹かれたのでリクエストしたいと思います。\nご興味がなかったり解釈違いであれば気兼ねなく却下お願いします。\n\nカップリングは西住姉妹×逸見エリカの3Pで、\n布団に仰向けになったエリカがまほみほにサンドされるシチュエーション。\nまほがエリカの唇を奪って意識を引き付けている間に、\nみほが手指を存分に駆使してエリカをイかせます。\nカトマコで描かれていた手マンや潮吹きの描写がとても良かったので、\n膣内を執拗に責めて連続絶頂を狙っていくエロ軍師みほをお願いしたいです。\nみほの指で感じさせられまくったエリカは思わず背を仰け反らせようとしますが、\nまほに顔をグッッと引き寄せられてキスで釘付けにされ、\n上のお口と下のお口をそれぞれ姉妹の舌と指で蹂躙されて更なる高みへと達してしまいます。\n\n3人はそれぞれラブラブな関係で、テクニシャンな二人にエリカが堕とされている感じです。\n脱衣度はお任せしたいと思います。エリカさんのぱんつは完脱ぎで。\n潮吹きや、潮を吹いて布団に染みが広がっている描写もよろしければお願いします。\n\nご検討頂ければ幸いです。", "nc": 32, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@7654_dog/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 206793, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/59915212/uploads/origins/4cf0666d-6d15-4dfb-80fe-4518f5e565a8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b7082c4c6e21f0cf62bd6603694892f4", "srcset": "https://si.imgix.net/59915212/uploads/origins/4cf0666d-6d15-4dfb-80fe-4518f5e565a8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b7082c4c6e21f0cf62bd6603694892f4, https://si.imgix.net/59915212/uploads/origins/4cf0666d-6d15-4dfb-80fe-4518f5e565a8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a1c446380e7a5136ea1721b60a8ffb71 2x, https://si.imgix.net/59915212/uploads/origins/4cf0666d-6d15-4dfb-80fe-4518f5e565a8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b25727007c65b6e5654e17097c39d5a9 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/59915212/uploads/origins/4cf0666d-6d15-4dfb-80fe-4518f5e565a8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3efb42290e8b74ac84af5af486bf4ba8", "srcset": "https://si.imgix.net/59915212/uploads/origins/4cf0666d-6d15-4dfb-80fe-4518f5e565a8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3efb42290e8b74ac84af5af486bf4ba8, https://si.imgix.net/59915212/uploads/origins/4cf0666d-6d15-4dfb-80fe-4518f5e565a8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=758017a5289ba571b2b297b1fd4abcb9 2x, https://si.imgix.net/59915212/uploads/origins/4cf0666d-6d15-4dfb-80fe-4518f5e565a8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=f44761ead6eaf81bed848377f2006d84 3x"}, "body": "カト麻子のレズセックスイラストをリクエストいたします。\n・服装は麻子が大洗女子の制服、カトラスがバーテン姿\n・タイが緩んでいたりブラウスのボタンが外れていたりと互いの服装は乱れているが、上半身の服は完全に脱いではいない（スカート、下着、カトラスのカチューシャやエプロンは状況に応じて脱がしてください）\n・ふたなりではない\n・シーンは大きく分けて3つ、複数の描写を1枚にまとめて描いていただく場合は、レイヤーを選択することで単体の描写を閲覧可能にしていただけると幸いです\n・シーン③については、それだけで1枚にしてください\n※各シーンの細かな描写については、マヌル犬さんの判断で描きやすいようにアレンジまたは省略していただいてかまいません\n\nシーン①\nカトラスが麻子を攻めている。\n布団の上に座り、向かい合っている２人。\n互いに舌を絡め、唾液が糸を引いている。\nカトラスの右手は麻子の膣を執拗に攻める。\n何かを思い付いた様子のカトラスは、麻子の右肩に顎を載せ、左手を伸ばして麻子の背後にある酒瓶とショットグラスを手繰り寄せた。\nそして左手だけで器用にボトルの栓を開け、ショットグラスにトクトクと注いでいく。\n背後で何が起きているのか分からず困惑する麻子。\nカトラスが注いでいたのは、ハバネロクラブだった。\n麻子の肩越しにハバネロクラブを一気に口に含んだカトラスは、そのまま麻子にキスをしてハバネロクラブを麻子の口に流し込んでいく。\n麻子の体はビクリと動き、まさぐられていた膣は締め付けを強め、潮を噴いた。\n\nシーン②\n攻守交代、今度は麻子がカトラスを攻める。\n麻子はカトラスを押し倒した状態。\n麻子もまた、右手でカトラスの膣を深くまさぐる。\nそして麻子はカトラスの乳首を執拗に舐める。\n舌に残ったハバネロクラブのせいか、乳首がひりついていつも以上に勃ってしまうカトラス。\nカトラスの感じている表情を見ながら、麻子は舌をチロチロさせながら徐々に胸の下、みぞおちと舐める位置を下げていく。\n麻子の下はへそに到達した。\nその瞬間、カトラスの体はビクンと跳ねる。\nそれを見た麻子は、カトラスのへそに照準を定める。へそに唾液を溜め、舌の先でほじくるように舐める。\n焦ったカトラスは麻子を引きはがそうと麻子の頭を両手で押さえるが、快感に抗えず手に力が入らない。\nやがてカトラスは仰け反りながら絶頂する。\n\nシーン③\n布団の上に並んで寝転がる2人を正面から俯瞰する。\n着衣はぐしゃぐしゃに乱れ、互いに攻め合った唇、乳首、へそ、陰唇は唾液でべちゃべちゃになっている。\nカトラスはぐったりした様子で、目の焦点が定まらない。\n麻子は満足そうに少し笑みを浮かべ、そのまま眠りにつこうとしていた。\