a70-83e4-b7e43bfe04b1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6ceaf49d0eabdf8310c346a1dc7fb7d0, https://si.imgix.net/0ef061b5/uploads/origins/1a1e3e8a-130d-4a70-83e4-b7e43bfe04b1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=a34e9a7d4bc43af5c8aac92db9dbc3bf 2x, https://si.imgix.net/0ef061b5/uploads/origins/1a1e3e8a-130d-4a70-83e4-b7e43bfe04b1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=b809a17eca16dd51ac2afe9718cbf880 3x"}, "body": "skebを開設したとお聞きして、是非イラストをお願いしたくリクエストを送らせて頂きました！\n【キャラクター詳細】\n綴くんという私の代理として描いていただいた子です。下記の添付資料につきましては許可は頂いております。\n【イラスト詳細】 \n服装や装飾を大きく変更する事がなければ、何でも大丈夫です！例としましては、似合いそうな物を持たせる〜とか、首飾りを首に下げずに手に持つ〜などそういった変更は全然大歓迎です！\n背景は和風が好みではありますが、”こんな場所でこんなものを持ってたら良い！”みたいなのがあればどんなものでも構いませんし、ご負担であれば簡素なものでも構いません。\nもし余力があったり隅の方が寂しい！とかがございましたら、完成イラストの隅などにミニキャラを添えていただけると嬉しいです。 が勿論無くてもOKです！\n【ファイル形式】\n・完成イラスト\n・キャラ単体で背景透過\n・背景単体\n・（もしミニキャラを描いていただけた場合）ミニキャラ単体（背景透過）\n・(同じく描いていただけた場合)ミニキャラ無しverの完成イラスト\nで分けていただけると嬉しいですが、作業量が大変でしたら完成品のみでも大丈夫です！\n【使用用途】\nスマホなどの壁紙、SNSやDiscordのアイコンやヘッダー等への使用を主としております。\nまた、もし可能でしたら完成品を今後他のクリエイター様へ資料として見せることや、私的使用の範囲内でのグッズ制作を考えております。\n条件が難しければお気軽に再送・キャンセルください、何卒よろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/1G_NiR79bv0u7NAuMDvQq5uU2ufX3jMer", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Setosuou1008/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 4019779, "client_id": 4065491, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/08d3c0d2/uploads/origins/55d5467d-6146-4f42-9498-53eb44a0f1d8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8988f9ea85ee97d5f475b1d034869ddb", "srcset": "https://si.imgix.net/08d3c0d2/uploads/origins/55d5467d-6146-4f42-9498-53eb44a0f1d8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8988f9ea85