だいて差し支えありません（夏なので）。\nセクシーな感じだと嬉しいです！！！\n\n納品いただいたイラストを、描いていただいたうちの子のイラストとしてXでアップさせていただくことがあります。\nまた、作成時のラフや別構図案等がもしあれば、レイヤーに残していただけると嬉しいです。\n\n何卒、ご検討ください！", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 751607, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "Sakiki", "screen_name": "Sakiki400", "avatar_url": "https://pbs.twimg.com/profile_images/976617017393360897/0nTRBWxf.jpg", "header_url": "https://pbs.twimg.com/profile_banners/976616735347417088/1521732449/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "art"}, {"genre": "video"}], "banned": false, "nc": 17}, {"id": 2628876, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "つみと/skeb", "screen_name": "tuum0031", "avatar_url": "https://pbs.twimg.com/profile_images/1863218951473250304/FBHHh_t_.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1603404220723593216/1725500619/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 10, "complete_expiration_days": 60, "skills": [{"genre": "art"}], "banned": false, "nc": 16}, {"id": 2639777, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "mochi @skeb募集中", "screen_name": "oyasumunemui", "avatar_url": "https://pbs.twimg.com/profile_images/2052336771162337280/k4NdbwaV.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1612799042223996929/1678092403/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 1