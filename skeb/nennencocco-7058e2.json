rop&crop=top&w=200&h=200&blur=200&s=05137a712e923f77b1412b689651528b, https://si.imgix.net/b17a8c4e/uploads/origins/944a9234-65ef-4bd7-afbf-3b8b6e3ee0ae?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=23c84a43e4bc5d6931416c8860af28f3 2x, https://si.imgix.net/b17a8c4e/uploads/origins/944a9234-65ef-4bd7-afbf-3b8b6e3ee0ae?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=486fcea047e6f02cb27e727bcf40f761 3x"}, "body": "こんにちは！あなたのイラストはとても美しいですね！\nオリジナルキャラクターを2体お願いしたいです。\n男の子は赤面しながらも恥ずかしそうに笑っている表情、女の子はクールな表情でも中性的な表情でも構いません。服装や髪型は自由に変えていただいて構いません！姿勢や雰囲気、背景などもお任せします。\nお忙しい中、ありがとうございました！\n\nhttps://drive.google.com/file/d/1K39bvdKZ7NHf1HYiD59nN758MdBKERkH/view?usp=drivesdk", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@nennencocco/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2295937, "client_id": 2405074, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/098fb518/uploads/origins/3cbf39f3-829e-4436-810e-b4ae54dc6bf3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b06da89dc3358bef7dcb8f059d05ed96", "srcset": "https://si.imgix.net/098fb518/uploads/origins/3cbf39f3-829e-4436-810e-b4ae54dc6bf3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b06da89dc3358bef7dcb8f059d05ed96, https://si.imgix.net/098fb518/uploads/origins/3cbf39f3-829e-4436-810e-b4ae54dc6bf3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e3be41122d5abb87f264c4910c0b6963 2x, https://si.imgix.net/098fb518/uploads/origins/3cbf39f3-829e-4436-810e-b4ae54dc6bf3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=85cdd1acf65a9a4fcc97b9b44376e163 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/098fb518/uploads/origins/3cbf39f3-829e-4436-810e-b4ae54dc6bf3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=73b0f7eac86865a42f02202c7fc6f167", "srcset": "https://si.imgix.net/098fb518/uploads/origins/3cbf39f3-829e-4436-810e-b4ae54dc6bf3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=73b0f7eac86865a42f02202c7fc6f167, https://si.imgix.net/098fb518/uploads/origins/3cbf39f3-829e-4436-810e-b4ae54dc6bf3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=9d56d28d85e7e69a87031f47a576bc3e 2x, https://si.imgix.net/098fb518/uploads/origins/3cbf39f3-829e-4436-810e-b4ae54dc6bf3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=47ef679c7c2b1b50af2d50d113c5bab0 3x"}, "body": "またまたこんにちは！今回は私の2体の人形、エルサとマリアの作品をお願いしたいと思います！\n\nエルサ：https://drive.google.com/drive/u/0/folders/1Zxl9UzMMJMEHZzmdhzl15dO2Y3iAFmEZ\n\nマリア： https://drive.google.com/drive/u/0/folders/1XOc7TXADhAa4s9HBnh0Zss1mB39n30wc\n\n二人並んで、あるいは背中合わせで、視線は見る人を見つめてほしい。エルサは左側で、クールな笑顔とポーズ。マリアは右側で、口にVサインをつけ、舌を出し、よりおちゃめでキュートな雰囲気。\n\nその他は皆さんのご判断にお任せします。ご検討のほど、よろしくお願いいたします！\n\nhttps://drive.google.com/drive/u/0/folders/1ZL48vW7vtCfc1Ze0j_835oxQaXFB98QT", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@nennencocco/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2295937, "client_id": 2288180, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/42ceafb3/uploads/origins/a511de5e-c0b2-4ceb-be3a-af5e3056988b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=502cb6298a319f09f1794afacb050ef9", "srcset": "https://si.imgix.net/42ceafb3/uploads/origins/a511de5e-c0b2-4ceb-be3a-af5e3056988b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=502cb6298a319f09f1794afacb050ef9, https://si.imgix.net/42ceafb3/uploads/origins/a511de5e-c0b2-4ceb-be3a-af5e3056988b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=dbc1bcbf75abc3a7e920d30d6fa32e9b 2x, https://si.imgix.net/42ceafb3/uploads/origins/a511de5e-c0b2-4ceb-be3a-af5e3056988b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=759727d23284297c4986ea9fbbcfc289 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/42ceafb3/uploads/origins/a511de5e-c0b2-4ceb-be3a-af5e3056988b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=cf4607b4b94e20c207fcff6a48bc0e57", "srcset": "https://si.imgix.net/42ceafb3/uploads/origins/a511de5e-c0b2-4ceb-be3a-af5e3056988b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=cf4607b4b94e20c207fcff6a48bc0e57, https://si.imgix.net/42ceafb3/uploads/origins/a511de5e-c0b2-4ceb-be3a-af5e3056988b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=a0e889597627fa19641ccb641ea6e298 2x, https://si.imgix.net/42ceafb3/uploads/origins/a511de5e-c0b2-4ceb-be3a-af5e3056988b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=8e9d52f7440662e80a5c5157bc583356 3x"}, "body": "こんにちは、初めまして。\n先日はフォローバックいただきありがとうございました。\nK森様にオリジナルキャラのイラスト描いていただきたく連絡させていただきました、三甘オミと申します。\n\n先日拝見したイラストの絵柄に一目惚れしてしまい、K森様にどうしても描いていただきたい双子がおりましてご相談に参りました。\n\n依頼したいのはTRPGというゲームで使用しているオリジナルキャラクターです。\n\n一卵性双生児の姉と弟で顔が非常に似ています。\nその二人が幼少期に楽しそうに遊んでいる姿が見たいです…。\n性格的には姉の方がぐいぐい弟の手を引っ張るようなタイプで、弟は”姉ちゃんはほんとに元気だなぁ”とやれやれしながらも笑って引っ張られるようなタイプです。\n\n詳細下記に添付させていただきます。\n\n・キャラクター設定、（性別、年齢、外見など）\nー1人目ー\n名前：ロータス・コックス\n年齢：28\n関係性：双子の姉\n肌色：褐色\n髪色：アッシュグレー・ピンク\n目の色：ブルーグレー\n\nー2人目ー\n名前：フレイ・コックス\n年齢：28\n関係性：双子の弟\n肌色：褐色\n髪色：アッシュグレー\n目の色：ブルーグレー\nhttps://drive.google.com/drive/folders/15nTbjbwtUhE0hdhZXYOu9FsgBmZs8fR3?usp=sharing\n\n・使用用途\n個人鑑賞、Twitterアイコン、アプリアイコン等…\nよければチェキなどにして持ち歩きたいと考えております。\n\n・希望の画像サイズとファイル形式\n特にないのですが、チェキ化OKの場合は印刷に耐えられる画素数ですととても嬉しいです…＞＜\n\n・背景/構図\n良いようにご調整ください。幼少期とはいいましたが、18歳くらいまでならいつでも問題ありません！\n\n・その他\n幼少期のため、姉のロータスのピンクメッシュ、弟のフレイの刺青と顔・体の傷は無しでお願いします！\n\n\n上記内容でお願いしたいです。非常に長くなってしまい申し訳ありませんが、ご確認いただけますと幸いです！\nどうかご縁がありますように！", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@nennencocco/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2295937, "client_id": 2616430, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/01969c77/uploads/origins/59c534b5-b32e-4664-8e6d-ca55d0d5c707?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bb6337edd9ce2d13a09b885479cb5acf", "srcset": "https://si.imgix.net/01969c77/uploads/origins/59c534b5-b32e-4664-8e6d-ca55d0d5c707?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bb6337edd9ce2d13a09b885479cb5acf, https://si.imgix.net/01969c77/uploads/origins/59c534b5-b32e-4664-8e6d-ca55d0d5c707?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e997b543499c11385e1a9107f9cc5d29 2x, https://si.imgix.net/01969c77/uploads/origins/59c534b5-b32e-4664-8e6d-ca55d0d5c707?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=6bb4a419aa2217be902802b2750dc313 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/01969c77/uploads/origins/59c534b5-b32e-4664-8e6d-ca55d0d5c707?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=55d5b4d0af82784df3498e3d8acb28e4", "srcset": "https://si.imgix.net/01969c77/uploads/origins/59c534b5-b32e-4664-8e6d-ca55d0d5c707?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=55d5b4d0af82784df3498e3d8acb28e4, https://si.imgix.net/01969c77/uploads/origins/59c534b5-b32e-4664-8e6d-ca55d0d5c707?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=75833ad14266ce828db85da5ac880692 2x, https://si.i