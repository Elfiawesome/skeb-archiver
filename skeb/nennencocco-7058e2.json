=200&h=200&s=6bcca11fcc54d5c5f43828325947aac3", "srcset": "https://si.imgix.net/f940aa54/uploads/origins/207c3364-43e4-4d14-8752-a05917afd70d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6bcca11fcc54d5c5f43828325947aac3, https://si.imgix.net/f940aa54/uploads/origins/207c3364-43e4-4d14-8752-a05917afd70d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e5488d61aed589cdd0ca3806cebf673e 2x, https://si.imgix.net/f940aa54/uploads/origins/207c3364-43e4-4d14-8752-a05917afd70d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=cfcb4b6a01ec3b982f96c8090feecc57 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/f940aa54/uploads/origins/207c3364-43e4-4d14-8752-a05917afd70d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f039775e6bab3349d62869c4a51d09a4", "srcset": "https://si.imgix.net/f940aa54/uploads/origins/207c3364-43e4-4d14-8752-a05917afd70d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f039775e6bab3349d62869c4a51d09a4, https://si.imgix.net/f940aa54/uploads/origins/207c3364-43e4-4d14-8752-a05917afd70d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=e89185acd105fbb9a4c71322697bc56f 2x, https://si.imgix.net/f940aa54/uploads/origins/207c3364-43e4-4d14-8752-a05917afd70d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=8e82ba78cc4621c2d0b79b1d590ea213 3x"}, "body": "はじめまして！\n絵柄に興味があったのでご依頼しました。\nもしよろしければ、うちのOCの「キィ」をお願いすることは可能でしょうか？ \n参考までに設定は末尾のとおりですが、自由に描いていただいて構いません。\n\n使用用途は個人活動全般(小説の挿絵等、SNSや個人サイト等でのキャラクター紹介・個人活動の告知等)を考えています。\nもしご都合が合えばよろしくお願いします。\n\n███\nχ／Keely Beatrix Albireo\nコードネーム：χ (キィ)\n本名：キーリ・ベアトリクス・アルビリオ／Keely Beatrix Albireo\n\n緋色の瞳に銀髪ショートカットの華奢な少女。\nファッション感覚で体のあちこちを包帯でぐるぐる巻きにしている。包帯の位置はその日の気分で変わる。\nデザイナーベビーであり、育て親である研究員から譲られた茶色のキャスケットがトレードマーク。\n運動は得意で昆虫のように素早く動き、天井や壁にもよく張り付いている。特に蹴り技が得意。\n\n今回は教会から派遣された霊能者という設定で来日している。だが前回の来日の際には国際機関のエージェントという設定であり、更にはアンドロイドの振りまでしていた。前回に限らず来日の度に設定が変わるので、既に周りからは単なる「電波ちゃん」だと認識されてしまっている。\n今回の霊能者設定についても「実は自分はリヴィングデッドだ」という裏設定もきちんと用意しているが、最早周りが全く正体を怪しんでくれないので、表には出さないが寂しがっている。\n\nそもそもの設定が胡乱な上に、来日の度に別の胡乱な設定へとコロコロ変わるので、本当のほんとーの正体については最早誰も気にしていない。デザイナーベビーというのも、どこまで本当の話かは不明。\nただキャスケットだけは常に大切そうにしている。\n███\n\nhttps://drive.google.com/file/d/10R-eueFoLsDHyLFlOmVCCi8UKZzsfi40/view?usp=sharing", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 187902, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "京谷", "screen_name": "kyouya0514", "avatar_url": "https://pbs.twimg.com/profile_images/1446497345835732992/bbXwiAst.jpg", "header_url": "https://pbs.twimg.com/profile_banners/875540238/1712058252/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "art"}], "banned": false, "nc": 161}, {"id": 1022090, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "yellowtail🌸Skeb⭕️VGen⭕️", "screen_name": "yellowtail", "avatar_url": "https://pbs.twimg.com/profile_images/1875254080991588353/_RLM3OFE.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1329218740139921408/1775304751/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 3, "complete_expiration_days": 30, "skills": [{"genre": "art"}, {"genre": "comic"}], "banned": false, "nc": 161}, {"id": 1070603, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "灯台", "screen_name": "Motokrs0531", "avatar_url": "https://pbs.twimg.com/profile_images/1481596792789962758/sZVE67b