、動画投稿の際の挿入\n・リスナーへのアイコンや壁紙配布\n\n上部と左右が見切れず、キャラのみの透過イラストもいただけると幸いです。\nお忙しいところ恐縮ですが、よろしくお願いいたします。\n\nhttps://x.com/mizunokazunari/status/1941933428720419316", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@yuri_fuwari/works/8", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3947988, "client_id": 3799826, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/31ffc961/uploads/origins/2df95cdd-1c58-4d17-a0a2-62d68ddec4d5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=27dff8b98ff7153cab294814233217e6", "srcset": "https://si.imgix.net/31ffc961/uploads/origins/2df95cdd-1c58-4d17-a0a2-62d68ddec4d5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=27dff8b98ff7153cab294814233217e6, https://si.imgix.net/31ffc961/uploads/origins/2df95cdd-1c58-4d17-a0a2-62d68ddec4d5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=6cccc4c8294b81ae8450d1a4a30f91a4 2x, https://si.imgix.net/31ffc961/uploads/origins/2df95cdd-1c58-4d17-a0a2-62d68ddec4d5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=1a29c599e58f192a6c2a2dd3c51dc582 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/31ffc961/uploads/origins/2df95cdd-1c58-4d17-a0a2-62d68ddec4d5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3b54b8b59dce9358dd2be1a6c7dabd38", "srcset": "https://si.imgix.net/31ffc961/uploads/origins/2df95cdd-1c58-4d17-a0a2-62d68ddec4d5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3b54b8b59dce9358dd2be1a6c7dabd38, https://si.imgix.net/31ffc961/uploads/origins/2df95cdd-1c58-4d17-a0a2-62d68ddec4d5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=294c059853fb2220cf2d88abd51f4c0b 2x, https://si.imgix.net/31ffc961/