i.imgix.net/33601c57/uploads/origins/24a633c6-e31a-4d5e-9146-2c61897febe2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fb66fdf9dbcba2f4f6677607f355c1e2", "srcset": "https://si.imgix.net/33601c57/uploads/origins/24a633c6-e31a-4d5e-9146-2c61897febe2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fb66fdf9dbcba2f4f6677607f355c1e2, https://si.imgix.net/33601c57/uploads/origins/24a633c6-e31a-4d5e-9146-2c61897febe2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=73a6777f8fc64a4b6f0351c44e0d12f4 2x, https://si.imgix.net/33601c57/uploads/origins/24a633c6-e31a-4d5e-9146-2c61897febe2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=4f30cda65cf93835cb20cbc2c479e2d8 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/33601c57/uploads/origins/24a633c6-e31a-4d5e-9146-2c61897febe2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6dacb0d7181ac73d3cea228ebb747b4a", "srcset": "https://si.imgix.net/33601c57/uploads/origins/24a633c6-e31a-4d5e-9146-2c61897febe2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6dacb0d7181ac73d3cea228ebb747b4a, https://si.imgix.net/33601c57/uploads/origins/24a633c6-e31a-4d5e-9146-2c61897febe2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=789768ad4af521cf4588ef9e93fffef0 2x, https://si.imgix.net/33601c57/uploads/origins/24a633c6-e31a-4d5e-9146-2c61897febe2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=5caa6f8e27b59882c52da3f937784300 3x"}, "body": "はじめまして。\n素敵なイラストに惹かれてリクエストさせていただきました。\n\nオリジナルキャラクターのイラストをお願いしたいです。\n\n【キャラクター】\nhttps://drive.google.com/file/d/1vmRA4DQ12Hr4X72IUR5njjrDv6ByHcau/view?usp=sharing\n\n明るくて太陽のような雰囲気の女の子です。\n少しいたずらっぽい一面もありますが、本当はとても優しい性格です。\n甘いものやふわふわしたもの、動物、ひまわりが好きです。\n\n【用途】\n個人利用です。\n将来的に動画制作（例：YouTube等）やSNS投稿などに使用させていただく可能性があります。\n※収益化予定はございません。\n\n構図はお任せいたします。\n楽しく描いていただけましたら嬉しいです。\nよろしくお願いいたします。", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@ra_mentanaka/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3914514, "client_id": 2971312, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/42b8cf0b/uploads/origins/5a6b0a9d-b38e-4f15-a46c-6d75a992dfd7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f5a8e4ecd2a4a09c3c82ce91845531c2", "srcset": "https://si.imgix.net/42b8cf0b/uploads/origins/5a6b0a9d-b38e-4f15-a46c-6d75a992dfd7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f5a8e4ecd2a4a09c3c82ce91845531c2, https://si.imgix.net/42b8cf0b/uploads/origins/5a6b0a9d-b38e-4f15-a46c-6d75a992dfd7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=493b6d4407700501d01303de2e040509 2x, https://si.imgix.net/42b8cf0b/uploads/origins/5a6b0a9d-b38e-4f15-a46c-6d75a992dfd7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=3a32511be7c848b78c692a40294dbf1b 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/42b8cf0b/uploads/origins/5a6b0a9d-b38e-4f15-a46c-6d75a992dfd7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=433fa1b23e2341d7302a44d27bd3a798", "srcset": "https://si.imgix.net/42b8cf0b/uploads/origins/5a6b0a9d-b38e-4f15-a46c-6d75a992dfd7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=433fa1b23e2341d7302a44d27bd3a798, https://si.imgix.net/42b8cf0b/uploads/origins/5a6b0a9d-b38e-4f15-a46c-6d75a992dfd7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=7db2de45008c136e8217a1d79d656940 2x, https://si.imgix.net/42b8cf0b/uploads/origins/5a6b0a9d-b38e-4f15-a46c-6d75a992dfd7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=f523f952ea19fd70b18a0612f3ccb94e 3x"}, "body": "初めまして。\n素敵なイラストに一目惚れしまして今回依頼をさせていただきました。\n\n<内容>\nCoCシナリオ「GODARCA」の私と友人2名の創作キャラクターのイラスト。(友人には許可を得ております。)\n構図、サイズはお任せ致します。\n\n<使用用途>\n・ヘッダーやアイコンなどSNSでの使用\n・友人へdiscordやSNSの鍵アカウントでのイラストの共有\n・待受けやステッカー等個人で楽しむ範囲での利用やグッズ作成\n\n<キャラクター詳細>\n【HO:皇帝】\n名前:コルドラントス・レジスタ・レオナリオス\n年齢:32歳 身長:233cm 体重:130kg\nイメージカラー:ロイヤルブルー(#1955A6)\n\n細事を気にせず失敗も笑い飛ばす豪胆で率直な性格。直感的に行動し、誰にでも分け隔てなく友好的に接する気さくな人物。大きな声と長身の体格から威圧的な見えるが、相手の言葉を待つ思慮深さも持つ。自らを駒と認識しつつも皇帝として退かず、仲間の背中を押し続ける存在。\n\n【HO:教皇】\n名前:アーディク・リンディ\n年齢:37歳 身長:188cm 体重:76kg\nイメージカラー:アンティークグリーン(#54917F)\n\n黒いバイザー状の仮面で目元を覆い、常に着用している料理好きの男性。近隣住民や仲間へ自作の料理や菓子を差し入れる温厚で気さくな人物。最愛の妻を事故で失った出来事をきっかけに仮面は基本的に外さなくなった。仲間の心と輪を繋ぐ存在。\n\n\n【HO:戦車】\n名前:阿栖馬 大雅\n年齢:28歳 身長:191cm 体重:83kg\nイメージカラー:強烈な赤みの黄色(#FFEB3B)\n\n人当たりの良い関西弁を話す男性。多数のピアスを身につけ、アジアにルーツを持つ。裏表がなく率直で、誰に対しても呼び捨てで接し、冗談も言う親しみやすい性格。普段は平凡な思考だが、戦闘時には本能により判断力と第六感が鋭敏に高まる生粋の戦闘狂。\n\n【三人の関係】\n「原初のアルカナ」の能力が同時期に発現した同期であり、互いを無くてはならない戦友かつ仲間と認識している。様座な場面で互いに鼓舞し合い支え合ってきた過去を持つ。任務外では教皇のもとへ食事に集まったり、鍛錬を重ねるたりなど、私的にも深い信頼で結ばれている関係。\n\nhttps://drive.google.com/drive/folders/1JjEjJhx8Vg6_oDGJpJScWa9tX1ilEcUt", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@ra_mentanaka/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3914514, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/c3f3bea7/uploads/origins/cc65f424-9bc2-49c5-9e25-39f1ddea98d0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=566ae26f19a573dcefb995f9282baf2a", "srcset": "https://si.imgix.net/c3f3bea7/uploads/origins/cc65f424-9bc2-49c5-9e25-39f1ddea98d0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=566ae26f19a573dcefb995f9282baf2a, https://si.imgix.net/c3f3bea7/uploads/origins/cc65f424-9bc2-49c5-9e25-39f1ddea98d0?bg=%23fff&auto=format%2Ccompress&fm=webp&dp