il_image_urls": {"src": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1783442269636534272%2FyqddY339.jpg?blend64=aHR0cHM6Ly9za2ViLWF2YXRhci5pbWdpeC5uZXQvfnRleHQ_&blendalpha=100&blendalign=center&blendmode=normal&blendsize=inherit&bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b320e2a0a49d9d52eee0e266623ad967", "srcset": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1783442269636534272%2FyqddY339.jpg?blend64=aHR0cHM6Ly9za2ViLWF2YXRhci5pbWdpeC5uZXQvfnRleHQ_&blendalpha=100&blendalign=center&blendmode=normal&blendsize=inherit&bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b320e2a0a49d9d52eee0e266623ad967, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1783442269636534272%2FyqddY339.jpg?blend64=aHR0cHM6Ly9za2ViLWF2YXRhci5pbWdpeC5uZXQvfnRleHQ_&blendalpha=100&blendalign=center&blendmode=normal&blendsize=inherit&bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=23951da65f7aa7d5327633b6152717fb 2x, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1783442269636534272%2FyqddY339.jpg?blend64=aHR0cHM6Ly9za2ViLWF2YXRhci5pbWdpeC5uZXQvfnRleHQ_&blendalpha=100&blendalign=center&blendmode=normal&blendsize=inherit&bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=44d0d1e3eab2d3b50d8c64e573bcad67 3x"}, "body": "お世話になっております。カリウムです。\n\n以前に書いていただいた小説がとてもよかったので、続きの話を書いてほしいと思ってリクエストに参りました。大鷲さんが白金さんに遊ばれて、あえてしっかりした制服を着せられた上で『マゾポリス強○アクメ』を模したハメ○りを撮られる回をお願いしたいです。\n\n◆入れてほしい内容(上に書いてあるものほど優先度高です！全部入らなくても全然大丈夫です、にのまえさんのご性癖にお任せします)\n・乳首責め\n実はにのまえさんの乳首責めの描写、とても好きなので入れていただけると嬉しいです！\n\n・我慢、焦らしプレイ\n「ご褒美のために我慢する」シチュエーションが健気で好きです。また、AVを模したハメ○りというプレイの性質上、堕ちる前の演技をしつつ「堕ち」の片鱗がちらちら伺えるような描写があると嬉しいです。\n\n・執拗な手マン\n前作後半の会場を抜け出したあとのプレイがめちゃめちゃよかったです。引き続き執拗に大鷲さんを泣かせてください……！\n\n・陰姦\n言わずもがなです。\n\n前回、とても読み応えのあるド迫力のセクシーシーンを読ませていただいて本当に嬉しかったです。新作の便利屋さんのお話も、一見真面目そうな受けの方がどうしようもない淫乱というギャップがとてもよかったです！　お忙しいかとは思いますが、他の作品の更新も楽しみにしています。", "nc": 168, "word_count": 32225, "transcoder": "text", "creator_acceptable_same_genre": false}, {"path": "/@nino_mae_bl/works/7", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/7721ac93/uploads/origins/c1e7a368-00e2-4be7-8012-b598b3ecddab?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=c79677cbe7aa8e90e5112ae79b1f5774", "srcset": "https://si.imgix.net/7721ac93/uploads/origins/c1e7a368-00e2-4be7-8012-b598b3ecddab?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=c79677cbe7aa8e90e5112ae79b1f5774, https://si.imgix.net/7721ac93/uploads/origins/c1e7a368-00e2-4be7-8012-b598b3ecddab?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=8c74904ca9f7078b4f33fdf5722ea589 2x, https://si.imgix.net/7721ac93/uploads/origins/c1e7a368-00e2-4be7-8012-b598b3ecddab?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=fab248dbf4b714967242e8bd258791bd 3x"}, "private": true, "genre": "novel", "tipped": true, "creator_id": 1223774, "nc": 160}, {"path": "/@nino_mae_bl/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "novel", "tipped": false, "creator_id": 1223774, "client_id": 1340725, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/4fdb528e/uploads/origins/1ee972c0-29d2-43a9-8bf3-2e8790605119?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fe2e54e3035cf9c2c4d9f9b16125f98d", "srcset": "https://si.imgix.net/4fdb528e/uploads/origins/1ee972c0-29d2-43a9-8bf3-2e8790605119?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fe2e54e3035cf9c2c4d9f9b16125f98d, https://si.imgix.net/4fdb528e/uploads/origins/1ee972c0-29d2-43a9-8bf3-2e8790605119?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=cb37c4c8a38632c4b9cd1033e29902cd 2x, https://si.imgix.net/4fdb528e/uploads/origins/1ee972c0-29d2-43a9-8bf3-2e8790605119?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=afea0ed7ecbed94cd4d30ce3bc37c261 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/4fdb528e/uploads/origins/1ee972c0-29d2-43a9-8bf3-2e8790605119?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=cc6061b5f6af4c542b4c9b918396670d", "srcset": "https://si.imgix.net/4fdb528e/uploads/origins/1ee972c0-29d2-43a9-8bf3-2e8790605119?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=cc6061b5f6af4c542b4c9b918396670d, https://si.imgix.net/4fdb528e/uploads/origins/1ee972c0-29d2-43a9-8bf3-2e8790605119?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=ece6b74e3fb70fe0e33b25a309758087 2x, https://si.imgix.net/4fdb528e/uploads/origins/1ee972c0-29d2-43a9-8bf3-2e8790605119?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=418371d0d33b659143cb0108769fd355 3x"}, "body": "いつもにのまえさんの小説を楽しみにしています。今回、skebが開いているということで依頼に参りました。\n創作BLの小説で、以下のようなシチュエーションのものを書いていただきたいです。\n\n◆おおまかなあらすじ\n信頼していた上司に裏切られ、捜査を取り潰されて自暴自棄の刑事さん(受け)が、弱っているところに付け込まれて反社の男(攻め)に堕とされる(実は捜査を潰す圧力をかけたのは攻めで、上司と癒着している)。\n受けはこんなことはやめなければと思いつつ、表面上は優しい攻めのところへずるずる通いつづけてしまうが、ある日エグい責め方で甘やかされた上で実は上司と攻めが癒着していてことを聞かされて心が折れて完堕ちしてしまう。\n\n◆入れてほしい内容(上に書いてあるものほど優先度高です！書き出したら多くなってしまったので、全部入らなくても全然大丈夫です)\n・受けの嫁入り宣言/肉オナホ宣言\n「完堕ち」の象徴として取り入れていただけると嬉しいです。どちらかでも、合体させていただいてオナホ嫁宣言でも大丈夫です。\n・執拗な手マン\n受けが泣くまで手マンをする攻め最高！泣いてもやめなくていい。\n・衆人環視シチュ\n攻めが部下を集めて会議をしている途中などに、受けだけ着衣を乱されてエッチなことをされているシチュエーションが好きです。\n・疑似排泄\n本当に大好きなプレイなんですが、「流れ」が割と難しい方かなと思うので優先度低めにしています。ゼリー系かアナルパールが好きです。\n・コスチュームプレイ\n刑事さんに安っぽいミニスカドスケベポリスコスをしてもらうのは最高なので……\n・身体に何らかの痕跡が残る\nプレイの痕跡が残っているのを誰かに見られる不安と期待で穏やかでいられない受け、非常にエッチだと思います。\n\n◆お願い\nにのまえさんの堕ち描写が大好きなので、受けの完堕ちをメインで書いていただきたいと思っています。ふたりの出会いや過去のエッチなどは回想で簡潔にしていただいて大丈夫です。\n\n以上の内容で大丈夫でしたら、よろしくお願いします。ゆっくり書いていただいて大丈夫ですので、お体にお気をつけてお過ごしください。", "nc": 56, "word_count": 29501, "transcoder": "text", "creator_acceptable_same_genre": false}, {"path": "/@nino_mae_bl/works/5", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/1d300b8c/uploads/origins/883dd920-a5bb-42f7-8c7d-cfc2e737c009?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=da3556e008f4735d6b24aa3aae79a074", "srcset": "https://si.imgix.net/1d300b8c/uploads/origins/883dd920-a5bb-42f7-8c7d-cfc2e737c009?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=da3556e008f4735d6b24aa3aae79a074, https://si.imgix.net/1d300b8c/uploads/origins/883dd920-a5bb-42f7-8c7d-cfc2e737c009?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=07e764d65c55fb9ad37e30e13eacad7c 2x, https://si.imgix.net/1d300b8c/uploads/origins/883dd920-a5bb-42f7-8c7d-cfc2e737c009?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=4cef01444ce1c80dbb779ba1be6b1625 3x"}, "private": true, "genre": "novel", "tipped": true, "creator_id": 1223774, "nc": 176}, {"path": "/@nino_mae_bl/works/4", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/1b900f93/uploads/origins/c0b794ed-4065-4ca9-a907-21cee64c21b8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200