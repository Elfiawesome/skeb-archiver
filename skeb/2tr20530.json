keb.jp/@2tr20530/works/8）同様、\n出撃前などで何かに腰掛けて話している感じのイラストでお願いいたします。\nいつもにぎやかで口数の多いじゃじゃ馬タイプなので、表情や細かな手振りはお任せします！\n\n以上、ご検討何卒よろしくお願い申し上げます。", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@2tr20530/works/10", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2357769, "client_id": 73576, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/34629453/uploads/origins/554fa8d0-19b6-4db7-ad8d-1751c4ebfec9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=074067400040cacd7d643ed58ccb2a14", "srcset": "https://si.imgix.net/34629453/uploads/origins/554fa8d0-19b6-4db7-ad8d-1751c4ebfec9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=074067400040cacd7d643ed58ccb2a14, https://si.imgix.net/34629453/uploads/origins/554fa8d0-19b6-4db7-ad8d-1751c4ebfec9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b9f0922c5b998ec6632ba29c420688a0 2x, https://si.imgix.net/34629453/uploads/origins/554fa8d0-19b6-4db7-ad8d-1751c4ebfec9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=bac7f258e65c901679565d4b9919fdc5 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/34629453/uploads/origins/554fa8d0-19b6-4db7-ad8d-1751c4ebfec9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=8310ed5853e3e67e2f0c2373eb31ae7e", "srcset": "https://si.imgix.net/34629453/uploads/origins/554fa8d0-19b6-4db7-ad8d-1751c4ebfec9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=8310ed5853e3e67e2f0c2373eb31ae7e, https://si.imgix.net/34629453/uploads/origins/554fa8d0-19b6-4db7-ad8d-1751c4ebfec9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=09cf0494059c549cb7faa0e49b28ec89 2x, https://si.imgix.net/34629453/uploads/origins/554fa8d