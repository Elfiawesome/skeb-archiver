0代半ば、身長170cm強\n髪の長さや髪型および色（青みのある黒）、瞳の色（金色っぽいヘーゼル）、プロポーションは上記イラストをご参照ください。ポニテのゴムやリボンはその日の気分で変える人なので、お任せします。\n\n衣　装：国連軍仕様 99式衛士強化装備\n若い頃一時期出向していたという設定で、この衣装にしました。\n\nポーズ：下記のイラストが格好良かったので、もしよろしければバックショットでお願いします。\nhttps://www.pixiv.net/artworks/101677303\n\n以上、ご検討何卒よろしくお願い申し上げます。", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@2tr20530/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2357769, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/17a9fc9b/uploads/origins/8882d8c8-8923-4751-94de-56babf5a359d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=369afe58d6635da82856b6278dd8ea9b", "srcset": "https://si.imgix.net/17a9fc9b/uploads/origins/8882d8c8-8923-4751-94de-56babf5a359d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=369afe58d6635da82856b6278dd8ea9b, https://si.imgix.net/17a9fc9b/uploads/origins/8882d8c8-8923-4751-94de-56babf5a359d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f6cf77ef5b52d728bab5a7244e98298c 2x, https://si.imgix.net/17a9fc9b/uploads/origins/8882d8c8-8923-4751-94de-56babf5a359d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=46b33babe02ac7e150b6ef7ae137c383 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/17a9fc9b/uploads/origins/8882d8c8-8923-4751-94de-56babf5a359d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0d185658bd303e6795664f7558902a96", "srcset": "https://si.imgix.net/17a9fc9b/uploads/origins/8882d8c8-8923-4751-94de-56babf5a359d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0d185658bd303e6795664f7558902a96, https://si.imgix.net/17a9fc9b/uploads/origins/8882d8c8-8923-4751-94de-56babf5a359d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&cro