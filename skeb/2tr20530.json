a1-4610-9a01-2fe32bfa890d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=c8988608b2014b957149cfd00f391caf 2x, https://si.imgix.net/9939f58a/uploads/origins/1c70f1a1-2da1-4610-9a01-2fe32bfa890d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=d99bd154ed1c4d1c40ce6918624aa206 3x"}, "body": "お久しぶりです、つーたろうさん。\nお大事になさってください\n\nリクエスト依頼させていただきます\n\nキャラ\n・私のOC\n野付牛 ミルヴァーナ（18）\nhttps://skeb.jp/@kaia_ran01/works/105\nhttps://skeb.jp/@kaia_ran01/works/59\nhttps://skeb.jp/@naminori3220/works/14\nhttps://skeb.jp/@samesame_thang/works/36\nhttps://skeb.jp/@samesame_thang/works/69\nhttps://skeb.jp/@NeMg1012/works/24\nhttps://skeb.jp/@kaia_ran01/works/158\nhttps://skeb.jp/@kaia_ran01/works/139\nhttps://skeb.jp/@kaia_ran01/works/80\nhttps://skeb.jp/@kaia_ran01/works/152\nhttps://skeb.jp/@kaia_ran01/works/172\nhttps://skeb.jp/@kaia_ran01/works/191\nhttps://skeb.jp/@drops_mint/works/22\nhttps://skeb.jp/@misonikomi01/works/414\nhttps://skeb.jp/@ym_ill/works/41\nhttps://skeb.jp/@AkiAkane104/works/574\n作成にあたっては『セーラー服と機関銃』(1981) の星泉さん(演 - 薬師丸ひろ子) を参考にさせていただきました。\n\n衣装\n衣装\n『マブラヴ オルタネイティヴ トータル・イクリプス』のソ連軍強化スーツ\nhttps://imgur.com/a/XPidebs\nhttps://skeb.jp/@bananasiriz/works/28\nhttps://skeb.jp/@bananasiriz/works/18\nhttps://skeb.jp/@bananasiriz/works/14\n\nポーズに関しては、映画のポスターのポーズでも、最後の銃を撃っているポーズでも、どんなポーズでもとらせていただいて結構です。\nhttps://www.tbs.co.jp/tbs-ch/item/m1202/\nhttps://www.youtube.com/watch?v=uJszYxe8YwY\nhttps://pixta.jp/illustration/116438626\n\n彼女の武器\nAKMS-K\nhttps://imgur.com/a/AGwqWt3 (真ん中の小銃)\nAKMS-K は AK47 を短縮して軽量化したカービン銃バージョンで、この銃には古典的なオレンジと赤の木製部品が残っていることを願っています。\n\n指定していない部分はお任せいたします\n\nお好みに合わせて自由に修正してください。\n\nご検討よろしくお願いいたします！！\n\nhttps://www.youtube.com/watch?v=uJszYxe8YwY", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@2tr20530/works/13", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2357769, "client_id": 164716, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/2127cbc9/uploads/origins/783cfbfa-b5bd-48fa-bf4a-500eb13347ce?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8fc2532addded257a6dc4ce975bb8d00", "srcset": "https://si.imgix.net/2127cbc9/uploads/origins/783cfbfa-b5bd-48fa-bf4a-500eb13347ce?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8fc2532addded257a6dc4ce975bb8d00, https://si.imgix.net/2127cbc9/uploads/origins/783cfbfa-b5bd-48fa-bf4a-500eb13347ce?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=2a5c9eeb2c41e35436059c372a64ebdd 2x, https://si.imgix.net/2127cbc9/uploads/origins/783cfbfa-b5bd-48fa-bf4a-500eb13347ce?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a971e416c6d1975c047ea12f31a653ed 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/2127cbc9/uploads/origins/783cfbfa-b5bd-48fa-bf4a-500eb13347ce?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=eec3fdf056db11f730eef3f61516c35a", "srcset": "https://si.imgix.net/2127cbc9/uploads/origins/783cfbfa-b5bd-48fa-bf4a-500eb13347ce?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=eec3fdf056db11f730eef3f61516c35a, https://si.imgix.net/2127cbc9/uploads/origins/783cfbfa-b5bd-48fa-bf4a-500eb13347ce?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=c906d389c534405dc227ef9acd44d03f 2x, https://si.imgix.net/2127cbc9/uploads/origins/783cfbfa-b5bd-48fa-bf4a-500eb13347ce?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=55b1648e9b3a48f4255e5f83a4dc4392 3x"}, "body": "こんにちは、いかがお過ごしでしょうか。\nSkebにログインしたら受付を再開されていたので、先日描いていただいたデジデリウスさん（https://skeb.jp/@2tr20530/works/8）の、ある世界線での5年後くらいの姿をご依頼申しあげます。\nちょっと変わったネタですが、ご検討よろしくお願いいたします。\n\n【キャラ】\nディアーノチカ・ジェルトワ大尉（デジデリウス愛）\nプロポーションは一緒（177cm、88-59-90くらい）で、ポニテのリボンは赤色\n髪と瞳の色はイーニァやクリスカと一緒\n2006年以降の姿なので20代後半ですが、強い老化防止処置の影響ゆえ、若めに描いていただいて結構です。\n※下記参照\nhttps://skeb.jp/@sunpay_opi/works/91\n【衣装】\nイーニァ・シェスチナ（トータル・イクリプス）の衛士強化装備\n※上記参照イラストと同じ強化装備です。一応資料を準備しましたのでURLよりダウンロードください。\n【ポーズ】\nある日の演習後、ボコボコにしてやったのに怒らず笑顔で助言を求めてきた他国の衛士に対し、冷たく微笑みながらも助言をしているところ\n何かに座ってる感じで、表情は少し冷たい微笑みでお願いします。その他、背景はお任せします。\n\n2006年頃の異動時、相方ともども日ソ共同研究の老化防止処置の対象として選ばれるも、事故で昏睡\n証拠隠滅に動く日本側の要請で昏睡状態のふたりをソ連が引き取り、彼らがオルタ3等の知見を利用して治療した結果、相方共々、見た目が変わって微弱なESP能力を得てしまったうえで九死に一生を得てしまう。\nそのままソ連で特別かつ優秀な開発衛士として運用され、貴重なデータを提供中、といったところです。\nソ連にとっては拾い物の熟練強化衛士なので、存在を秘匿せず国際演習等にバンバン出して自国戦術機の宣伝隊長的なこともやらせています。\n（ちなみにソ連から与えられた名前は「月の女神」、名字は「生け贄・犠牲」の意）\n本人は相方と一緒で衛士として生きられるなら、と、えらいことになってますが意外と前向きに生きてます。\nなお、仲間想いで笑みを浮かべているところは日本時代と一緒ですが、ソ連の衛士として振る舞うべく、ちょっと冷たい微笑みになっています。\n\n小生からは以上です。ご検討何卒よろしくお願い申し上げます。\n\nhttps://www.dropbox.com/s/bal93snxew0taos/reference0703.zip?dl=0", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@2tr20530/works/12", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2357769, "client_id": 1408081, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/b912ca2d/uploads/origins/6dc8e277-74f5-44c9-932a-db198b658136?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ff2decd57f6202214440657b84f8f2a9", "srcset": "https://si.imgix.net/b912ca2d/uploads/origins/6dc8e277-74f5-44c9-932a-db198b658136?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ff2decd57f6202214440657b84f8f2a9, https://si.imgix.net/b912ca2d/uploads/origins/6dc8e277-74f5-44c9-932a-db198b658136?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=6e7d14d8fc5f2f10b0b098c59da93717 2x, https://si.imgix.net/b912ca2d/uploads/origins/6dc8e277-74f5-44c9-932a-db198b658136?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=283770a43bdfa4d83ecfd58ce424ef24 3x"}, "duration": null, 