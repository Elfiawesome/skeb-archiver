all", "accept_expiration_days": 30, "skills": [{"genre": "art"}, {"genre": "comic"}, {"genre": "correction"}], "nc": 32}]}, "price_history": {"art": [{"amount": 13000, "recorded_at": "2025-09-21T18:01:12.996257"}]}, "works": [{"path": "/@mulletccub110/works/8", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 388136, "client_id": 0, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/407fd63d/uploads/origins/304d4f46-a999-4137-8646-a1aa0f007817?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=53e5c227dce3d8260b5303779ab42398", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/407fd63d/uploads/origins/304d4f46-a999-4137-8646-a1aa0f007817?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=73151d6c12dfb60f6764b868591b41fc", "src_set": ""}, "body": "まれっとさん、はじめまして。\n\nPixiv等でいつも素敵なイラストを拝見させていただいております。\nご多忙のところ恐れ入りますが、是非ともリクエストをお願いしたくご連絡いたしました。\nご検討いただけますと幸いです。\n\nSynthesizer V衣装を基にしたバニーガールの琴葉葵ちゃんをお願いします。\n\nhttps://skeb.jp/@kimutomo_2/works/12\nまず、こちらのURL先のイラストをご覧いただけますとイメージがしやすいと思われます。\n（過去に他のクリエイター様にお描きいただいたイラストです）\nこのイラストの衣装と同じような造形でお願いします。\n\n・シンセVのワンピ衣装をジャケットのように羽織る衣装へ改変し、バニースーツの上から着用\n・バニースーツの色は元衣装にもある蛍光スカイブルーを\n・手足と頭のアクセサリー類は元衣装のままで、うさ耳を追加\n・うさ耳は耳の穴も再現した2色使うタイプで、色は白ベースに、耳穴を蛍光スカイブルーで（ブーツと同じように）\n・タイツやパンストなどは不要\n\n【・葵ちゃんはメカクレ巨乳で】\n\nご検討のほどよろしくお願いします。", "nc": 33, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@mulletccub110/works/7", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/afdb6bbe/uploads/origins/566d19ed-0aa2-4d50-9328-ed54acd6444c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=5e7e47b5cf98d469335fa120b50e544c", "src_set": ""}, "private": true, "genre": "art", "tipped": true, "creator_id": 388136, "client_id": 1331158, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 162, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@mulletccub110/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 388136, "client_id": 0, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/43dda826/uploads/origins/2cb88801-6478-49fa-a24e-5037ccde0c04?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e9bdbeab557d3750f2bccbf0f1c37270", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/43dda826/uploads/origins/2cb88801-6478-49fa-a24e-5037ccde0c04?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ace8c9b30f651fc3144d833373abafed", "src_set": ""}, "body": "こんにちは、いつも素敵なイラストを楽しませていただき有難うございます。再開を聞きご連絡いたしました。\n\nチーパオ衣装を着たすずきつづみさんが、I字バランスで脚を片手で支えて綺麗に上げて立っている。大人びた目で誘うように目を細め、バランス感覚と体のラインの美しさを見せつけている状況。マスターに煽られた事に端を発しており、得意げに見ている。つづみさんから見たマスターは弟のような存在。\n\n条件に合えば以下の差分をお願いいたします。\n1:背後から乳首周りをくりくりと弄って焦らされ、快感を堪えている。可能なら汗と愛液で乳房や股間周りの布は透けている。\n2:弄られ終わり、息を荒げつつ立ち続けましたよ？と悪戯者を誘うように微笑んでいる。絶頂可否はお任せいたします。\n3:バック又は横から腰を支えられ挿入・絶頂している。秘部が見えると嬉しいです。\n4:何度もして白濁液でべとべとのまま、余韻に微笑んでいる。\n5.可能なら胸が見える又は全裸差分\n\nご検討をいただければ幸いです。", "nc": 177, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@mulletccub110/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 388136, "client_id": 768267, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/4ad32e2d/uploads/origins/6f50d62f-c194-4aa2-9aa9-fb7727ae7f38?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=90f462532cf407b2d80d4785464944ed", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/4ad32e2d/uploads/origins/6f50d62f-c194-4aa2-9aa9-fb7727ae7f38?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0fb345d923a114256fa9500590bf05dc", "src_set": ""}, "body": "15歳サイズの服を着た「紲星あかり 蕾」のイラストを描いていただきたいです。\n・超常現象で突然15歳から10歳に若返ってしまった、というシチュエーションをイメージしています。なお、精神年齢や意識は15歳のままという想定です。\n・身長や体格・顔つきは「蕾」のもので、服のデザインとサイズは15歳のあかりちゃんのもの、という形です。\n・服装は参考URL[1]のルームウェアでお願いします。\n・髪型や毛量は「蕾」のもの（参考URL[2]参照）にしてください。ただし、おさげは無しでお願いします。\n・参考URL[3]のテトさんのように、服のサイズが合わずブカブカになっている感じにしてください（小さくなった手がシャツの袖に隠れている、ズボンが床までずり落ちている、パンツがひざの辺りに引っ掛かっている、股やお尻はシャツに隠れている、髪が短くなったことで黒いリボンが外れて床に落ちている、オレンジ色の髪飾りはそのまま）\n・参考URL[4]のゆかりさんのような苦しそうな表情で、息切れを起こさせてください。身体の変化により、苦痛のような快感のような不思議な感覚を味わっているイメージです。\n・頭の周りにハテナマークを浮かべてください。自分の身に何が起こったのかわからず困惑しているイメージです。\n・身体が縮んだ様子・服のサイズが合わなくなった様子が「しゅうううう・・・」「だぼっ」などのような擬音で表現されていると嬉しいです。\n・背景は無くても構いません。\n・もし可能であれば、変身前の姿（身も心も15歳）も描いていただけると有難いです。参考URL[5]のように変身前の姿と変身後の姿を矢印で繋ぐ形式が理想です。変身前のムチムチな体つき・可愛らしくも少し大人びた顔つき・サイズの合った服と変身後の華奢な体つき・大人っぽさが薄れた顔つき・ブカブカな服を見比べてギャップを楽しみたいです！\n\n参考URL\n[1]　https://vocalomakets.com/archives/6521\n[2]　https://vocalomakets.com/configuration-aivoice-akari-tsubomi\n[3]　https://www.pixiv.net/artworks/123147084\n[4]　https://x.com/mulletccub110ui/status/1899777893141737756\n[5]　https://www.pixiv.net/artworks/90705888", "nc": 33, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@mulletccub110/works/4", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/98979518/uploads/origins/12185e21-26df-47f5-9444-5f0713ba57b7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=0e707a8240a736407f0a62706dde50e5", "src_set": ""}, "private": true, "genre": "art", "tipped": true, "creator_id": 388136, "client_id": 1331158, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 160, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@mulletccub110/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 388136, "client_id": 0, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/4cfc2160/uploads/origins/4afb3dcd-7955-498a-a511-2a455b488cfa?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=70931af317f3e8d1ca872105cbe924e9", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": true, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/4cfc2160/uploads/origins/4afb3dcd-7955-498a-a511-2a455b488cfa?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=048e3106a00da18f4aa7ef662ee8ce38", "src_set": ""}, "body": "水着＋パーカー姿の結月ゆかりが、騎乗位でマスターの精液を搾り取っているイラストをお願いします。\n水着は着たまま、下はずらして挿入、上はちょっとはだけて胸が見えている感じです。\nイラスト内にちょっとしたセリフなどがあると嬉しいです。\n背景（屋外or室内）や雰囲気などの具体的なシチュエーションなどはお任せします。\n可能であれば中出しされている瞬間の差分をお願いします。", "nc": 187, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@mulletccub110/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 388136, "client_id": 0, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/45bf3c60/uploads/origins/11e6dd5d-cfaf-4d36-8683-205ceacadfe6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7c5859876660a3d069f8b6ec1bfad5af", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": true, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/45bf3c60/uploads/origins/11e6dd5d-cfaf-4d36-8683-205ceacadfe6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e44eb45a0c4ef53d1f74774927e422e7", "src_set": ""}, "body": "こんばんは、いつも素敵なイラストを楽しませていただいております。\n条件に合えば弦巻マキさんをお願い出来ますでしょうか。\n\n◼️状況\n夜の貸切露天風呂で、岩に腰掛けて脚を大きく開き、上目遣いで恥ずかしそうに笑みを浮かべてマスターを誘っている。瞳にハートを浮かべ、可憐ながら淫靡に発情している。\n両手は後ろについて体を起こしていて、自分の顔、胸からお腹・秘部や太ももを見せつけている。\nお風呂なので髪はアップに纏めているか、行為で乱れて解けているか…お任せいたします。\n女性らしいしなのある様子だと嬉しいです。距離感は高めでお願いいたします。\n\n条件が合いましたら以下の差分をお願い出来ますでしょうか。\n・秘部を弄られて潮吹き\n・挿入&中出し絶頂\n・引き抜かれて蕩けた笑みを浮かべている。何度も交わり秘部からは白濁液が溢れ出ており、陰茎とアーチを作っている。胸や顔、お腹周りにも幾らか液が付着している。\n\nご検討をいただければ幸いです。\n何卒宜しくお願いいたします。", "nc": 50, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@mulletccub110/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 388136, "client_id": 1417523, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/c303c51e/uploads/origins/ee24c30f-5f1e-4069-bb49-2e10346dfeab?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5136e96d2eeabd42ebf9e2934bcd7019", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/c303c51e/uploads/origins/ee24c30f-5f1e-4069-bb49-2e10346dfeab?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0656b4a617c4064c9ec317c1430f3384", "src_set": ""}, "body": "初めまして。\nいつも素敵なイラストを見させていただいております。\nskeb開設されていたのでご依頼させていただきました。\n\n裏アカウントがバレてしまい、\n琴葉葵に脅されて雌犬扱いされる結月ゆかり(雫)を描いていただきたいです。\n\n■キャラクター\n結月ゆかり(雫)、琴葉葵\n\n■シチュエーション\n最初は恥ずかしがっていたものの、段々興奮し始めてしまう雫ちゃん。\n\n■要望(可能であれば)\n・ハート目差分をお願いします\n\n以上の内容でお願いいたします。\n指定していない部分はお任せいたします。", "nc": 33, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}], "from_archive": true}