1c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=069d0d58bbb2adcfba5501f623a7c6a6 2x, https://si.imgix.net/f180d66a/uploads/origins/b394f36a-aaf9-42e8-ae48-1ae702b5cb1c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=43322072b82d274b330a84fa597bcf07 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/f180d66a/uploads/origins/b394f36a-aaf9-42e8-ae48-1ae702b5cb1c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=eb7a46eb23a1c2448f400f9bad55dee4", "srcset": "https://si.imgix.net/f180d66a/uploads/origins/b394f36a-aaf9-42e8-ae48-1ae702b5cb1c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=eb7a46eb23a1c2448f400f9bad55dee4, https://si.imgix.net/f180d66a/uploads/origins/b394f36a-aaf9-42e8-ae48-1ae702b5cb1c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=2aec92496b1ec091491ae9cb37f1e0c8 2x, https://si.imgix.net/f180d66a/uploads/origins/b394f36a-aaf9-42e8-ae48-1ae702b5cb1c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=c50737926daf2efaddf77f10e3b82510 3x"}, "body": "どうもこんばんわ！ンモエザゴです！\n今回はぜひ、川越ぽち先生にイラストをお願いしたく依頼しました！\n\n【依頼内容】\nキャラクター：ンモちゃん (人型の方)\nチューリップ、野良ンモの方は描いても描かなくても大丈夫です！\n\n画角としては、全身か、股下ぐらいまで映ってる構図が希望です。\n元気いっぱいに楽しそうにしてる姿が見れると幸いです！\n\nまた、可能であれば表情差分も1，2種程度あると大変うれしいです！\n\n【用途】\nTwitterで自慢したり、youtubeのサムネ用に使用したいため、\n背景付きの場合はレイヤー別のPSDで頂けると幸いです。\n\n【資料】\n・設定画\nhttps://drive.google.com/file/d/1U-X6y4PExqoEpyiYh2Q2Td6yj4mQE1t8/view?usp=sharing\n\n・FA関連\nhttps://twitter.com/i/events/1487768061562159108\n\n・活動場所\nhttps://www.youtube.com/channel/UCC1NHc8URNA7krL6iXosEog", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@ki8ya/works/82", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 83994, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/e61314ee/uploads/origins/5b896264-50af-405c-9c9a-9d83631119b8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9950e72d9d8d6c8fdfa227e21941270d", "srcset": "https://si.imgix.net/e61314ee/uploads/origins/5b896264-50af-405c-9c9a-9d83631119b8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9950e72d9d8d6c8fdfa227e21941270d, https://si.imgix.net/e61314ee/uploads/origins/5b896264-50af-405c-9c9a-9d83631119b8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=362f187868a0ff6eadbd2444adc1417c 2x, https://si.imgix.net/e61314ee/uploads/origins/5b896264-50af-405c-9c9a-9d83631119b8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=1358129c64084f2c8cc5fcd24f955aa3 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/e61314ee/uploads/origins/5b896264-50af-405c-9c9a-9d83631119b8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c94d650117d0045fca03b9a317e1942f", "srcset": "https://si.imgix.net/e61314ee/uploads/origins/5b896264-50af-405c-9c9a-9d83631119b8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c94d650117d0045fca03b9a317e1942f, https://si.imgix.net/e61314ee/uploads/origins/5b896264-50af-405c-9c9a-9d83631119b8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=65055dead8e486d6c7d3d05f14f9b217 2x, https://si.imgix.net/e61314ee/uploads/origins/5b896264-50af-405c-9c9a-9d83631119b8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=297cd796b8c8ee6fbba76c1ce6f94fcc 3x"}, "body": "匿名で失礼します。\n薄布センパイソーサラーさん時代から、川越ぽちさんの色気のあるイラストが好みで読ませて頂いてました。\nFantia[3月skeb納品]にて投稿されていた[Ro マジ娘さんとペスト]をみて、同じく産卵シーンをお願いしたくなったので、Skebの依頼しました。\n\nhttps://fantia.jp/posts/1883869\n\n卵を植え付ける子は、同じくペストでお願いします。\n\n・キャラクターは、ROセカコス青ソーサラーさん。髪は白髪希望です。頭のアクセサリーはリボン系でしたら何でも良いのでお任せします。\n\n・マジ娘さんみたいにな流れで卵を産み付けられて、産卵する様子をお願いします。\n\n・場所は暗いところより、青空と草木があるような背景が好ましいです。\n\n・胸のサイズはDくらいで、足はあまり広げずに立っている状態にして下さい。\n\n・今から犯されるのを受け入れたように、青ソーサラーさんの白い前掛を、自分でおへそが見えるくらい託し上げて、膨れたお腹が見える構図でおねがいします。腰のアクセサリーが邪魔だったら外してください。\n\n・卵のサイズもマジ娘さんの時より大きめで、生んでいる最中の状態でお願いします。\n（すでに産み落とした卵もあると嬉しいです）\n\n可能であれば犯される前の、白い前掛けが下りている健全な立ち絵も見てみたいですが、予算に会わない場合は諦めます。\n\n今後もFantia応援しています。よろしくお願いします。", "nc": 40, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@ki8ya/works/81", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/d7d4f16b/uploads/origins/60d136f9-71a2-47fb-979d-30c200fa6872?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=699542379bc7ed7aaa572689f6836206", "srcset": "https://si.imgix.net/d7d4f16b/uploads/origins/60d136f9-71a2-47fb-979d-30c200fa6872?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=699542379bc7ed7aaa572689f6836206, https://si.imgix.net/d7d4f16b/uploads/origins/60d136f9-71a2-47fb-979d-30c200fa6872?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=47d85a830d78ff1c91bb98371abdd88c 2x, https://si.imgix.net/d7d4f16b/uploads/origins/60d136f9-71a2-47fb-979d-30c200fa6872?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=600ecc575fb11674e26f29d87e5a9d9d 3x"}, "private": true, "genre": "art", "tipped": true, "creator_id": 83994, "client_id": 73945, "nc": 32}], "sent_works": [], "similar_creators": [{"id": 41571, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "カヲスシコウ@Skeb募集中", "screen_name": "will