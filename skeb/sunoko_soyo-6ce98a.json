blur=200&s=6df3c0251e971f6eadd7b6fe89916050 3x"}, "body": "アイカツスターズ第67話の七倉小春の水着姿をリクエストします。同エピソードに登場した薄緑色のローブを着て、典型的なビーチの設定でお願いしたいです。ポーズは自由です。ありがとうございました。\n\nhttps://drive.google.com/drive/folders/1D7aShLcq8YRq_N2M7QhuQCZ81PMfXg-N", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@sunoko_soyo/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2899557, "client_id": 3343318, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/3f98ca5d/uploads/origins/0479b498-b5fd-4cf3-8b57-c9e8e05a1ab2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b3da060f52f48be72eb7b2e5461662e2", "srcset": "https://si.imgix.net/3f98ca5d/uploads/origins/0479b498-b5fd-4cf3-8b57-c9e8e05a1ab2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b3da060f52f48be72eb7b2e5461662e2, https://si.imgix.net/3f98ca5d/uploads/origins/0479b498-b5fd-4cf3-8b57-c9e8e05a1ab2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=5e476c51eed0f2ffbec27066659e8246 2x, https://si.imgix.net/3f98ca5d/uploads/origins/0479b498-b5fd-4cf3-8b57-c9e8e05a1ab2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=06aa5ea93b9c2f26600cf16bd7542670 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/3f98ca5d/uploads/origins/0479b498-b5fd-4cf3-8b57-c9e8e05a1ab2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3f96e839993f8dc89ee5f3e4ca5b20eb", "srcset": "https://si.imgix.net/3f98ca5d/uploads/origins/0479b498-b5fd-4cf3-8b57-c9e8e05a1ab2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3f96e839993f8dc89ee5f3e4ca5b20eb, https://si.imgix.net/3f98ca5d/uploads/origins/0479b498-b5fd-4cf3-8b57-c9e8e05a1ab2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=