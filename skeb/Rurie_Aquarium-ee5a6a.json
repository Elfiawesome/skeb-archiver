のような状態になって顔固定になって、二人の頭の中で慌てたり恥ずかしいという考えだが、二次変化でオナホ＆ディルドが付着 となり、手足の姿勢が固定され、体がより豊かな姿のフタナリみたいな姿に改造され、顔もハート型が目に入り、さらにエッチな姿に変化し、二人の頭の中も完全に改造された姿のようにピンク色に洗脳されて 体も心も完全にエッチラブドール化になる様子を見たいです。\n\nその後の状況は...NortherNさんに任せたいです。 二人が使われて汚れたり、包装されて商品になったり、エッチラブドール化になった二人が一緒にセックスする様子とか、なんでもいいようです。ふふふ...よろしくお願いします。", "nc": 56, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Rurie_Aquarium/works/2", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/369046bc/uploads/origins/21a6a931-f391-4468-b3a6-97f0e54e6b07?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=744983d6900811b60df8c29f641521f0", "srcset": "https://si.imgix.net/369046bc/uploads/origins/21a6a931-f391-4468-b3a6-97f0e54e6b07?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=744983d6900811b60df8c29f641521f0, https://si.imgix.net/369046bc/uploads/origins/21a6a931-f391-4468-b3a6-97f0e54e6b07?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=cd03177be2bccb2dd53caf18e6f7c128 2x, https://si.imgix.net/369046bc/uploads/origins/21a6a931-f391-4468-b3a6-97f0e54e6b07?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=78cb6b3bd0c994a3bb8c7d1fee0c0da7 3x"}, "private": true, "genre": "art", "tipped": true, "creator_id": 2059166, "client_id": 529823, "nc": 49}, {"path": "/@Rurie_Aquarium/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2059166, "client_id": 122067, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/a0c4bf86/uploads/origin