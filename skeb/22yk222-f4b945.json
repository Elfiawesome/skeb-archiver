丈夫です〇\n\n髪型衣装につきましては参考イラストが入ってるのでそちらを確認してください🙇🏻‍♀️\nまた参考イラストにモザイクしてますがグロが入っております💦\n\n使用用途\nSNSでのアイコンまたはヘッダー・SNS投稿等・詳細での使用\n\n料金につきまして、もし不足等感じましたら追加で払わしていただきます。\nお忙しい中検討頂けますと幸いです。\nご縁がありましたら何卒よろしくお願いします（ ;  ; ）！\n\nhttps://drive.google.com/drive/folders/1QpjKj-akcIuW3UP22V1cj4I-rVsYWbdK", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@22yk222/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 4075951, "client_id": 1116701, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/afd3928b/uploads/origins/9c3759b5-f300-496e-8250-0d04dcc5f05c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=296954760ff07941783a9fa2aab08c8b", "srcset": "https://si.imgix.net/afd3928b/uploads/origins/9c3759b5-f300-496e-8250-0d04dcc5f05c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=296954760ff07941783a9fa2aab08c8b, https://si.imgix.net/afd3928b/uploads/origins/9c3759b5-f300-496e-8250-0d04dcc5f05c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=88091e4a502d42d07e182682e72a8a59 2x, https://si.imgix.net/afd3928b/uploads/origins/9c3759b5-f300-496e-8250-0d04dcc5f05c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=2bd2efa9ce24d3e2340a7204d046b491 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/afd3928b/uploads/origins/9c3759b5-f300-496e-8250-0d04dcc5f05c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=98764ca7ac0ea5bbf17997955d48c6bb", "srcset": "https://si.imgix.net/afd3928b/uploads/origins/9c3759b5-f300-496e-8250-0d04dcc5f05c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=98764ca7ac0ea5bbf17997955d48c6bb, https://si.imgix.net/afd3928b/uploads/origins/9c3759b5-f300-496e-8250-0d04dcc5f05c?bg=%23fff&auto=format%2Ccompre