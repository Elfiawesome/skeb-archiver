200&s=9c0ba66d19733977b6b1fb8cbbad6b6b, https://si.imgix.net/05bb2282/uploads/origins/972464f5-569a-4d4b-b823-fe7b8d2f5506?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=405f4f8697766f5cf2c691bdb347a82e 2x, https://si.imgix.net/05bb2282/uploads/origins/972464f5-569a-4d4b-b823-fe7b8d2f5506?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=4961b9ec3723e91cfb1851013854f7e4 3x"}, "body": "血みどろお遊戯会様\n\n初めまして。いつきと申します。素敵な絵柄に惹かれ、ぜひ自探索者(OC)のイラストを依頼したくリクエストを送らせていただきました。以下の詳細やリンク先の資料にネタバレは含まれておりませんのでご安心くださいませ。\n\n依頼内容\n出身シナリオ「異能警察は、英雄じゃない」\n\nHO4 疑念/男/28歳/身長176cmで細身\nプライドが高く捻くれた刑事。基本的には誰とでも壁を作るような態度で接し、必要以上に近づこうとしない。潔癖症でいつも黒い革の手袋をしており、突然肩を組まれたりするとアルコールスプレーを相手と自分にかけまくるほど。笑顔を見せることは滅多になく、自分も他人も信用しない。\n\n構図や雰囲気は可能であればお任せしたく存じます。服装などの装飾は描きやすいようデフォルメしていただいて問題ありません。\n\n使用用途：個人観賞用。お名前やIDを記載の上X等のSNSでアイコンやヘッダーに使用、自陣への共有\n\n資料や金額不備がございましたらお手数をお掛けいたしますが再送申請をお願いできますと幸いです。ご検討よろしくお願いいたします…！\n\nhttps://drive.google.com/drive/folders/1s-mnl2Wh1tK2CoOtofbjzJIUfyNFUlJ7", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@22yk222/works/12", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 4075951, "client_id": 2818383, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/6343331f/uploads/origins/b0a1b3fd-fa01-4323-8348-012c4da883b0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ad3ad7918ffd4f8648a77a887ae63290", "srcset": "https://si.imgix.net/6343331f/uploads/origins/b0a1b3fd-fa01-4323-8348-012c4da883b0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ad3ad7918ffd4f8648a77a887ae63290, https://si.imgix.net/6343331f/uploads/origins/b0a1b3fd-fa01-4323-8348-012c4da883b0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=36a6a13ec11d0f9fa0300f1218726212 2x, https://si.imgix.net/6343331f/uploads/origins/b0a1b3fd-fa01-4323-8348-012c4da883b0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=577d3fd0c04b4beef0b4fee82ad4051f 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/6343331f/uploads/origins/b0a1b3fd-fa01-4323-8348-012c4da883b0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=64e58fda460d30236a21eb5643dd40b2", "srcset": "https://si.imgix.net/6343331f/uploads/origins/b0a1b3fd-fa01-4323-8348-012c4da883b0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=64e58fda460d30236a21eb5643dd40b2, https://si.imgix.net/6343331f/uploads/origins/b0a1b3fd-fa01-4323-8348-012c4da883b0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=c7c4baf8c93ab0e46548512eaf862aff 2x, https://si.imgix.net/6343331f/uploads/origins/b0a1b3fd-fa01-4323-8348-012c4da883b0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=244f6fdd6dfcfa04bed1075f827671b7 3x"}, "body": "こんにちは、私のオリジナルキャラクター（OC）のイラストを描いていただけませんか！\n彼は傲慢で好奇心旺盛な人物で、いつも笑顔を絶やさず、非常に自己中心的な性格です。\nネガティブな表情をほとんど見せず、自分の好みを最優先に行動し、自分が好きなものや他者にとって大切なものを手に入れることに強い執着を持っています。彼は極めて貪欲で、気に入ったものなら何でも手に入れずにはいられません。\nリンク先の衣装はどれでも自由に選んでください！\n関連する要素：宝石、月、鏡、触手。\n\nhttps://www.mihuashi.com/character-card/f4bd6cfd86f6cf8014c989a2cb3d3d01e6fd51f1?utm_source=direct&utm_campaign=character_card&utm_medium=share&utm_content=ordinary", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@22yk222/works/11", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 4075951, "client_id": 4051244, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/22273340/uploads/origins/d270ee04-0aeb-4b06-bcd1-0fb1e26b0bcd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e6968be916d6c059acb4850011b11469", "srcset": "https://si.imgix.net/22273340/uploads/origins/d270ee04-0aeb-4b06-bcd1-0fb1e26b0bcd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e6968be916d6c059acb4850011b11469, https://si.imgix.net/22273340/uploads/origins/d270ee04-0aeb-4b06-bcd1-0fb1e26b0bcd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=fff1b7fa0c21f630e69f54ac9d133aee 2x, https://si.imgix.net/22273340/uploads/origins/d270ee04-0aeb-4b06-bcd1-0fb1e26b0bcd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=db9c09874024601fd88ad999f20dd612 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/22273340/uploads/origins/d270ee04-0aeb-4b06-bcd1-0fb1e26b0bcd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a705664bc15d83e9f3858b72f0dbe067", "srcset": "https://si.imgix.net/22273340/uploads/origins/d270ee04-0aeb-4b06-bcd1-0fb1e26b0bcd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a705664bc15d83e9f3858b72f0dbe067, https://si.imgix.net/22273340/uploads/origins/d270ee04-0aeb-4b06-bcd1-0fb1e26b0bcd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=1f8d81eed5dc2b746c56687b55ee9c9b 2x, https://si.imgix.net/22273340/uploads/origins/d270ee04-0aeb-4b06-bcd1-0fb1e26b0bcd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=99d8516a61028e25431b8648016a1847 3x"}, "body": "血みどろお遊戯会様\nお初にお目にかかります。\nTwitterにて素敵なイラストをお見かけし、ご依頼受付中との事でリクエストさせて頂きました。\n\n【用途】\n個人範囲内での使用(主にデスクトップ背景、アイコン使用)\nリットリンクのアイコンなどに使用する可能性も有り\n\n【キャラ詳細・ご依頼】\nモチーフ：性別不詳の堕落天使\n基本ポーカーフェイス(退屈そうな顔)\n\n当方のocは従来『やる気のない天使』をモチーフにしているのですが\n先生の、彩度低めな儚げな雰囲気と、少し闇を感じさせるようなイラスト等にとても惹かれまして\nもし承諾頂ければ当方のキャラクターも\n少し闇に触れてしまったor堕ちきってしまったかような雰囲気でお願いしたいです…（ ; ; ）\nイメージは全て先生にお任せ致します…！\n\n現在、即席で用意した資料しか無いため\n部分部分が大まかなデザインになりますが、\n曖昧な部分は血みどろお遊戯会様がアレンジしてしまって構いません(アレンジ方法も問いません)\n\n何卒よろしくお願い致します…！\n\n不備がございましたら再送信致しますので、キャンセルをお