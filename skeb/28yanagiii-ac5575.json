compress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=cced7bee7f2c816c60a427faf7b66292 2x, https://si.imgix.net/eb7cff65/uploads/origins/52442c78-13e0-45fa-8cf5-4bdbc30134c9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=d18e47d90ce7692c8552b304121dcaa3 3x"}, "body": "はじめまして。個人でVTuberをしております、半島キタと申します。\nヤナギ様の繊細で可愛らしいイラストをお見かけし、ぜひ以下の内容でイラストを描いていただければと思い、リクエストさせていただきました。\n\n【使用用途】\n・Twitter活動で使用(ヘッダー、アイコン、ツイート等)。\n・YouTubeにて配信サムネイルに使用。\n\n【描いていただきたい内容】\nVTuber半島キタをお願い致します。島役場で島長として働いている、明るく元気な猫モチーフの女の子です。\n細かい構図等はお任せします！\nサムネイルに使用する関係で、頭が切れていない構図で描いていただけたら嬉しいです。\n\n容姿は以下のリンクを御参照ください。\nhttps://drive.google.com/drive/folders/1afoaBSTEXilSoGCGFEE33sCEGhf7z_3y?usp=drive_link\n\n【サイズ、形式】\nサイズはお任せいたします。\n可能でしたらキャラクター、背景等が別れているPSDファイルを希望いたします。\n難しい場合は人物のみ透過したものをいただければと思います。\n\nお忙しい中大変恐縮ですが、御検討頂けたら幸いです。よろしくお願い致します。", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@28yanagiii/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2981816, "client_id": 1815882, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/53ce4408/uploads/origins/cd895611-f47e-4dec-b1a8-e7c13c71642d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5e00e4c0adc15913bd7c598d66a1fcac", "srcset": "https://si.imgix.net/53ce4408/uploads/origins/cd895611-f47e-4dec-b1a8-e7c13c71642d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5e00e4c0adc15913bd7c598d66a1fcac, https://si.imgix.net/53ce4408/uploads/origins/cd895611-f47e-4dec-b1a8-e7c13c71642d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=8b4e246bf53b721724831a5ccacb4333 2x, https://si.imgix.net/53ce4408/uploads/origins/cd895611-f47e-4dec-b1a8-e7c13c71642d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=34b9b07c6974f3ff6af4fc0239031505 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/53ce4408/uploads/origins/cd895611-f47e-4dec-b1a8-e7c13c71642d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=50117bc3aaf11b2980b285faa0a9cf40", "srcset": "https://si.imgix.net/53ce4408/uploads/origins/cd895611-f47e-4dec-b1a8-e7c13c71642d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=50117bc3aaf11b2980b285faa0a9cf40, https://si.imgix.net/53ce4408/uploads/origins/cd895611-f47e-4dec-b1a8-e7c13c71642d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=c5a1bc631637b2723d42b7601ae25161 2x, https://si.imgix.net/53ce4408/uploads/origins/cd895611-f47e-4dec-b1a8-e7c13c71642d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=11b59d87b441af908fa753e1df092401 3x"}, "body": "初めまして、\n突然のリクエスト失礼いたします。\n香港の個人vtuber 皇咲レイナです。ヤナギさんの作品を拝見しました、ほんとに素敵と思います。\n依頼内容やコストに見合わない場合、より高いコストでリクエストすることが大丈夫です。\n\nキャラクターデザインは資料URLからご参考ください。キャラクターは異世界から来た王様です。\n衣装、背景、ポージング等は全てお任せします。細かい部分はアレンジして頂いて構いません。\nキャラクターのみでも透過で利用出来るよう、人物と背景のレイヤーを分けたPSDファイルをいただけるととても助かります。\n\nTwitterプロモーション、動画サイトのサムネイル、グッズ/メンバシップの特典として使用する可能性があります。\n利用させていただく際、メンションをつけて通知いたします。\n\nお忙しい中大変恐縮ですが、ご検討いただけますと幸いです。\nよろしくお願いいたします。\n\n\n\nhttps://drive.google.com/drive/folders/10pxuE4GB9l_w5d5l_fP0P_5R6T3dKIjS\n\nhttps://drive.google.com/drive/folders/10pxuE4GB9l_w5d5l_fP0P_5R6T3dKIjS", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@28yanagiii/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2981816, "client_id": 2146860, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/863e89c3/uploads/origins/e6c7d6ae-62aa-4f43-b6ff-631ce1023547?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=84f74fd82fa8b25d021d36470906ef5f", "srcset": "https://si.imgix.net/8