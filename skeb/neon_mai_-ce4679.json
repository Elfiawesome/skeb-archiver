に変更\n・上記同様の谷間\n・裸足\n\n◯表情差分※目と口のレイヤーを分けてください\n1.口を開けてこちらを見ている笑顔\n\n2.口を閉じてこちらを見ている笑顔\n\n3.【⑦https://www.pixiv.net/artworks/144197752#manga　2枚目】やアニメのようなギャグ顔寄りの泣き顔\n\n\n\n差分ごとにレイヤーを分けたPSDファイルがあると非常に助かります。\n\n今回も要望が多く長文で申し訳ありませんが、是非描いていただきたいです。\nご検討のほどよろしくお願いいたします。\n\nhttps://www.pixiv.net/artworks/90389372", "nc": 49, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@neon_mai_/works/4", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/cff4e638/uploads/origins/a6a9c5ef-bea6-40d1-9731-b26ba5c90260?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=ae72309f3ff6e554567d38a287f6ddee", "srcset": "https://si.imgix.net/cff4e638/uploads/origins/a6a9c5ef-bea6-40d1-9731-b26ba5c90260?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=ae72309f3ff6e554567d38a287f6ddee, https://si.imgix.net/cff4e638/uploads/origins/a6a9c5ef-bea6-40d1-9731-b26ba5c90260?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=f7bd7167329c5497deb51cee9484e3ee 2x, https://si.imgix.net/cff4e638/uploads/origins/a6a9c5ef-bea6-40d1-9731-b26ba5c90260?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=525bcb14d513993e1ed798bcd672d50c 3x"}, "private": true, "genre": "art", "tipped": true, "creator_id": 2311609, "nc": 176}, {"path": "/@neon_mai_/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2311609, "client_id": 3342082, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/cc06ffa9/uploads/origins/6649b5f4-4cc1-41d9-a