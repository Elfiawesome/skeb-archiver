ns/f64aade2-22a7-4f7c-8625-89843c91f512?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f1a8ceb599b22b6163765cf6bcd3a26c, https://si.imgix.net/ec4c765a/uploads/origins/f64aade2-22a7-4f7c-8625-89843c91f512?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=49ce0678a3c602dec9cb9d5eb56f4939 2x, https://si.imgix.net/ec4c765a/uploads/origins/f64aade2-22a7-4f7c-8625-89843c91f512?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=9deed5b3466f04013c33fa855880638a 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/ec4c765a/uploads/origins/f64aade2-22a7-4f7c-8625-89843c91f512?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=1934a4cf4b7588eadd85a9723eec8b5a", "srcset": "https://si.imgix.net/ec4c765a/uploads/origins/f64aade2-22a7-4f7c-8625-89843c91f512?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=1934a4cf4b7588eadd85a9723eec8b5a, https://si.imgix.net/ec4c765a/uploads/origins/f64aade2-22a7-4f7c-8625-89843c91f512?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=3d24bdbd539e553602189590bd393e10 2x, https://si.imgix.net/ec4c765a/uploads/origins/f64aade2-22a7-4f7c-8625-89843c91f512?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=7eddb7a1b8b2e9ec91a2cede0c45a43f 3x"}, "body": "前回はめちゃくちゃ素敵なイラストありがとうございました(ㅜ.ㅜ)\n今回は、前に描いていただいたうちの子と友達のキャラクターとのペアイラストをお願いしたいです。\n\n\nうちの子も含めて特徴など書いてます。\nうちの子↓\n目に光が無いタレ目/ウルフぽい髪型/ダークな雰囲気/可愛いものが好き\n服装はメイド服やリボン、フリフリなど可愛い感じが多め\n\n友達の子↓\nジト目（ハイライトはあんまり無くても大丈夫です。）/焦げ茶色でぱっつんの髪型/割とローテーションで無表情気味\n服装はパーカーなどカジュアルな物が多め\n\n2人とも女の子で仲良し、距離近めの子達です。\n服装は今回も2人分おまかせでお願いしたいです。\nゆえにさん(お名前間違えてたらすみません…)の肌の質感がめちゃくちゃ好きなので、露出多めの夏っぽい感じで描いていただけると嬉しいです。\n\nhttps://drive.google.com/drive/folders/1nqxrycuq2DyMpHQSFuFeU1F7vAEAM3lH\n↑参考画像デフォルメ多めですみません…\n\n\n今回お願いするイラストで自分用に1〜2個アクスタを作りたいな〜と思っているので、追加料金等必要であれば再度送り直します…！ダメであれば依頼却下して頂けると助かります。\n（もし大丈夫な場合は背景有り無し、うちの子と友達の子で分けたパターンも納品お願いしたいです……(ㅜ.ㅜ)面倒ですみません…。）\n\nまた、前回同様デスクトップの壁紙やアイコンに使ったり、描いていただいたコテキャイラストとしてツイッターに載せたりしたいです。\n\n毎回長々とすみません(ㅜ.ㅜ)\n検討よろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/1nqxrycuq2DyMpHQSFuFeU1F7vAEAM3lH", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@there_4e/works/22", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2034307, "client_id": 2970798, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/5e24d951/uploads/origins/308f8966-427c-4528-b190-58ac83e11f29?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4f9f41d6d5ff86abd8ae5b62ad65b501", "srcset": "https://si.imgix.net/5e24d951/uploads/origins/308f8966-427c-4528-b190-58ac83e11f29?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4f9f41d6d5ff86abd8ae5b62ad65b501, https://si.imgix.net/5e24d951/uploads/origins/308f8966-427c-4528-b190-58ac83e11f29?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=249d001a539cbbfc95a305f85488d05f 2x, https://si.imgix.net/5e24d951/uploads/origins/308f8966-427c-4528-b190-58ac83e11f29?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=65310593c8af742dbaef36687459880b 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/5e24d951/uploads/origins/308f8966-427c-4528-b190-58ac83e11f29?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=71fa640eeb9fe011552564c3fe6e7745", "srcset": "https://si.imgix.net/5e24d951/uploads/origins/308f8966-427c-4528-b190-58ac83e11f29?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=71fa640eeb9fe011552564c3fe6e7745, https://si.imgix.net/5e24d951/uploads/origins/308f8966-427c-4528-b190-58ac83e11f29?bg=%23fff&auto=format%2Cc