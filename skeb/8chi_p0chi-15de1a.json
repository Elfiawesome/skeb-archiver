い友人との交遊はアクティブに活動。\n意中の男性には積極的に話しかけるも、若干のツンデレ気味な行動で機会を逸することも時々あり。\n\nhttps://imgur.com/a/iXPBMwl", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [{"path": "/@qibgip/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3706165, "client_id": 2970798, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/2327338e/uploads/origins/08c10023-7f2a-446c-aea0-e6aeb0577775?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=609cd7bf8077c388a64d1faaebcf0129", "srcset": "https://si.imgix.net/2327338e/uploads/origins/08c10023-7f2a-446c-aea0-e6aeb0577775?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=609cd7bf8077c388a64d1faaebcf0129, https://si.imgix.net/2327338e/uploads/origins/08c10023-7f2a-446c-aea0-e6aeb0577775?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=6d37530833c0db61d5c2b59cf36b4d5f 2x, https://si.imgix.net/2327338e/uploads/origins/08c10023-7f2a-446c-aea0-e6aeb0577775?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=601fa03465ba9968c4a7fadc80030d65 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/2327338e/uploads/origins/08c10023-7f2a-446c-aea0-e6aeb0577775?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ecfc8c293423cdfad50a4e5362ee6a89", "srcset": "https://si.imgix.net/2327338e/uploads/origins/08c10023-7f2a-446c-aea0-e6aeb0577775?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ecfc8c293423cdfad50a4e5362ee6a89, https://si.imgix.net/2327338e/uploads/origins/08c10023-7f2a-446c-aea0-e6aeb0577775?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=237462fc1eeb1ceccbd4626ede33863b 2x, https://si.imgix.net/2327338e/uploads/origins/08c10023-7f2a-446c-aea0-e6aeb057