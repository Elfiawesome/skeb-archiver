Ccenter&txtsize=30&txt=PRIVATE&s=3654639c856342d08f6ffbc87c45c872, https://si.imgix.net/574c11e1/uploads/origins/9a92b541-1943-4504-acbb-7a05879087ff?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=c67413b1bb78d54bb0b70f19024b2ed7 2x, https://si.imgix.net/574c11e1/uploads/origins/9a92b541-1943-4504-acbb-7a05879087ff?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=5c20bc82d679f622a2ee1a66097c16d8 3x"}, "private": true, "genre": "comic", "tipped": true, "creator_id": 3818308, "client_id": 3606722, "nc": 16}, {"path": "/@o_4_a_5/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "comic", "tipped": false, "creator_id": 3818308, "client_id": 1977204, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/a9908d0d/uploads/origins/fc7d584e-5804-4ec0-82ab-ae923444f556?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b5d60ddf176a25db823168ce0d772787", "srcset": "https://si.imgix.net/a9908d0d/uploads/origins/fc7d584e-5804-4ec0-82ab-ae923444f556?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b5d60ddf176a25db823168ce0d772787, https://si.imgix.net/a9908d0d/uploads/origins/fc7d584e-5804-4ec0-82ab-ae923444f556?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c301b1539a40b9c21680757b93e6a17d 2x, https://si.imgix.net/a9908d0d/uploads/origins/fc7d584e-5804-4ec0-82ab-ae923444f556?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=7eb234e8a9b4b66e46fc6c4e6e29a51d 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/a9908d0d/uploads/origins/fc7d584e-5804-4ec0-82ab-ae923444f556?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=8a1686ed6ce25f8befea4285c5b516f3", "srcset": "https://si.imgix.net/a9908d0d/uploads/origins/fc7d584e-5804-4ec0-82ab-ae923444f556?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=8a1686ed6ce25f8befea4285c5b516f3, https://si.imgix.net/a9908d0d/uploads/origins/fc7d584e-5804-4ec0-82ab-ae923444f556?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=bcd6786c8866988762e26646c19fcaa2 2x, https://si.imgix.net/a9908d0d/uploads/origins/fc7d584e-5804-4ec0-82ab-ae923444f556?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=aacb477e61b09144dc3bf5c479ac6f3a 3x"}, "body": "先生こんにちは！私はあなたが描いたキャラクターが大好きです。私のオリキャラたちの漫画をお願いしたいです。\n\n今回はIF線の物語に関連するキャラクターの漫画を描いていただきたいのですが、リンクの中に「IF 線のストーリー 【黒宝珠の魔女】」と名付けられた画像をご覧いただけます。\n\n【IF 線のストーリー 】\n龍の国にはかつて、あらゆる願いを叶える宝珠が秘められていた——それが夜白の本来の姿である。しかし、この至宝を覚醒させたのは森の魔女「銀」ではなく、黒魔法の魔女「華」である。華は狠辣な計略を用いて宝珠を奪い、飲み込んだ後、赤ん坊の姿の夜白を産み出しました。そして、自分のどんな欲望でも叶える黒宝珠の魔女に夜白を育てる計画を立てたのです。\n \n夜白は元々活発でいたずら好きな性格で、しばしば母親である華を困らせ、華にその前で偽装した高雅さを脱がせます。しかし直感が鋭い夜白は、いつも母のいらいらした言葉の中から、隠された感情を感じ取り、だからいつも母に甘えます。\n \n夜白は幼い頃から森の魔女である銀とその娘と息子の忍月、忍斗の姉弟と知り合います。華と銀の関係が良くないことを知りながらも、夜白は銀の優しさから彼女が好きで、華に内緒で彼らと親しんでいます。にこにこしていて本音がわからない忍月に対しては、夜白は親近感を感じながらも警戒心を持ち、恥ずかしがりやすい忍斗に対しては興味を持ち、しょっちゅうからかっています。\n \nしかし、その明瞭な性格の裏には、無邪気さと残忍さという相反する特質が共存しています。自身の欲望を満たすため、特に母親の利益を脅かす者に対しては、ためらうことなく命を奪います。ただし、銀に対しては例外です。\n \n華の夜白に対する感情は極めて複雑で、その力を利用するという核心的な目的のほか、言い難い母性に似た感情も混じっています。二人の関係はまるで貝と真珠のように、相互に依存しながらも、切り離せない絆を持っています。\n \nなお、銀はかつて夜白を連れて華から逃れようと試みたが、計画が露見した結果、最終的に華の手によって命を奪われてしまった。忍斗と忍月のこの姉弟にとって、夜白は間違いなく正視すべき、本物の強敵である。\n \n\n主要な登場人物を「華」と「夜白」と「銀」の三人にしたいと考えています。その他の登場キャラクターは、ストーリーの内容に合わせて自由に選んでいただいて構いません！\n\nPSDに線画や練習絵等があれば入れてくれると嬉しい！\n\n金額が合わない場合は、新しい価格で再送することができます。\n\nありがとう!\n\nhttps://drive.google.com/drive/mobile/folders/12ztY7YIJIHLGJtDf_9UNpkvqn9r2M41Y", "nc": 153, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@o_4_a_5/works/5"