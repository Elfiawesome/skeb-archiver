at%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=aa3cded7648d74c1af279d504d0e8e4b 2x, https://si.imgix.net/155a5d98/uploads/origins/49ac4189-8cb6-448d-b59f-7934a352b106?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=65eb3e10953ce974e58db4f3a5f8b751 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/155a5d98/uploads/origins/49ac4189-8cb6-448d-b59f-7934a352b106?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d413018a3fa78bf0746231826aba3ded", "srcset": "https://si.imgix.net/155a5d98/uploads/origins/49ac4189-8cb6-448d-b59f-7934a352b106?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d413018a3fa78bf0746231826aba3ded, https://si.imgix.net/155a5d98/uploads/origins/49ac4189-8cb6-448d-b59f-7934a352b106?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=b78a99c8b06e20bfdd21dae1666ae9fa 2x, https://si.imgix.net/155a5d98/uploads/origins/49ac4189-8cb6-448d-b59f-7934a352b106?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=1ab7207983888349cb10d21c295bc429 3x"}, "body": "こんにちは、HAPPY DREAMさんの素敵なコミックを他の方のリクエストでお見かけし、リクエストにまいりました！\n\n◾️内容\n資料先のOCのコミックをお願いしたいです。フォロワーさんと自分のTRPGのキャラクターで、探偵の男と探偵助手の女の子です。お互い大切にし合っている関係で、現在はお付き合いを経て結婚し、同じ家で暮らす家族です。\n\n男性：探偵・30代半ばくらい・いつもへらへら・謎の財力があり愛車はフェラーリ・可愛いお菓子作りやぬいぐるみ作りにチャレンジしがち・特技は手品・体を動かすのは得意・拳銃が使える・愛情は重い・しばらく記憶喪失になっていたが戻った\n\n女性：助手・10代後半・嫉妬深く寂しがり・頭が良く法の抜け穴を探すタイプ・かわいい服は自分では選ばない・努力家で負けず嫌い・戦闘能力はないが前に出たがり・子どもっぽい少女のような部分と大人びた部分がある・愛情は深い\n\n探偵と助手らしくとんでもない事件に巻き込まれていたり、事件に巻き込まれた帰りの夜に二人で歩いていたり、探偵らしいことしつつも恋人っぽい雰囲気もあったりすると嬉しいです。\nHAPPY DREAMさんが描かれていたコミックの雰囲気が好きなので、どのようなものでも好きに描いていただけると嬉しいです。\n\nどちらかをメインに描いて頂いても構いません。パーツの省略・着脱、構図・シチュエーションなどはお任せいたします。（顔の見えない構図などでも大丈夫です。）無理のない範囲でご検討&ご金額など合わない場合再送要請いただけたらと思います。\n\n◾️資料\n①ネタバレなしキャラクター資料\nhttps://www.dropbox.com/scl/fo/j7jnytxoq5y7v5mjn6ys6/h?dl=0&rlkey=53k8fyc4kmo42zekrf4qry10d\n\n②TRPGシナリオのネタバレあり資料（主にセプテム・ペッカータのネタバレが大丈夫であれば閲覧ください）\nhttps://www.dropbox.com/scl/fi/7mjxml3t1bd0jdy5n5lam/.pdf?rlkey=84ptwv147xakfkvyc6zc5hxwy&st=p013fx7g&dl=0\n\nネタバレありの場合ワンクッションしていただけると助かります🙏ご縁があればよろしくお願いします。", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@o_4_a_5/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "comic", "tipped": false, "creator_id": 3818308, "client_id": 3702637, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/4753b0e7/uploads/origins/639cea74-198f-4c0f-8c46-c8fbb7631dcd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fa652be6e4fbb76d6adf906d4cdb2081", "srcset": "https://si.imgix.net/4753b0e7/uploads/origins/639cea74-198f-4c0f-8c46-c8fbb7631dcd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fa652be6e4fbb76d6adf906d4cdb2081, https://si.imgix.net/4753b0e7/uploads/origins/639cea74-198f-4c0f-8c46-c8fbb7631dcd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b4ffd63d7adab1e7592a42eda2556cf8 2x, https://si.imgix.net/4753b0e7/uploads/origins/639cea74-198f-4c0f-8c46-c8fbb7631dcd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=8ff296abd7c36f821fc4d51f5f0fb352 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/4753b0e7/uploads/origins/639cea74-198f-4c0f-8c46-c8fbb7631dcd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=eb78f798c4a44e90cb27ef5766a7b380", "srcset": "https://si.imgix.net/4753b0e7/uploads/origins/639cea74-198f-4c0f-8c46-c8fbb7631dcd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=eb78f798c4a44e90cb27ef5766a7b380, https://si.imgix.net/4753b0e7/uploads/origins/639cea74-198f-4c0f-8c46-c8fbb7631dcd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=2a714a53b097615787b3827c6052fb2b 2x, https://si.imgix.net/4753b0e7/uploads/origins/639cea74-198f-4c0f-8c46-c8fbb7631dcd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=63d6d1d92813abd7c966315376f4682c 3x"}, "body": "こんにちは！\n\n可能であれば、私の3人のキャラクターの漫画をお願いしたいです：マヤ、アヤメ、ガネーシュです。\n\nマヤ\nhttps://drive.google.com/drive/folders/1nF3jcZ6Nccx9_sDnMCgFQcaJtB-9787Y\n年齢：24\n(ショートヘアのデザインでお願いします）\n\nマヤはストイックで物静か。感情をあまり表に出さず、ぶっきらぼう。\n\nあやめ：\nhttps://drive.google.com/drive/folders/1PMuO8t8AXEHNBG7K2YYW50SGzMUY0unn?usp=sharing\n身長：189cm\n年齢：28歳\n\nアヤメはエネルギッシュで遊び心のある若い女性。反抗的で面白く、ファッショナブル。フィールドホッケーの選手。\n\nガネーシュ\nhttps://drive.google.com/drive/folders/1bbu8Tvw1R_v0OyKiVt87Vt91_s3p9wkD\n身長：176cm\n年齢： 26\n\nガネーシュは演劇俳優。短気で真面目だが、すぐに慌てふためく。\n\n幼なじみで、近所に住んでいる。ガネーシュはマヤの兄である。アヤメは二人の姉のように振る舞っている。\n\nマヤは社交的ではありません。他人と接することを好まず、口数も少ない。不親切に見えたり、意地悪に見えたりすることもある。勉強もあまりできず、才能もない。その結果、家では両親と喧嘩をする。喧嘩が激しくなり、家を飛び出すこともしばしば。ガネーシュはそんな彼女を見つけ、家に連れ帰る。\n\n子供の頃、マヤはアヤメの家に逃げ込んで遊んでいた。大人になった今でも、マヤは逃げ出したくなるとアヤメの家に行く。\n\n漫画のアイデア\n\nマヤはアヤメの家に行き着くが、そこにいる理由を明かさない。あやめはマヤが両親と喧嘩したのだろうと推測する。あやめはマヤを部屋に連れて行き、マヤは毛布の下に潜り込む。マヤはあやめの部屋にある水槽を見つめる。マヤはいつも水を見るのが好きで、誰にも見つからない海の中にいることを想像していた。彼女は静かな世界で一人になりたいと願う。\n\nあやめはマヤに、いつでも歓迎するよと言う。あやめは毛布の下でマヤと一緒になる。あやめはマヤに、大人でいることは難しいことなのかと尋ねます。マヤは自分の責任や悩みから逃れたいと言います。子供でいる方がずっと楽だと。あやめは同意します。\n\nガネーシュはマヤを探しにあやめの家を訪れます。ガネーシュは疲れていて、真剣そのもの。彼はマヤを連れ戻したいと思っており、イライラしています。アヤメは彼を毛布の下に引きずり込み、「今は大人しくしていなさい」と言う。3人は静かに水槽を見つめ、微笑む。\n\nこのアイデアが気に入らなければ、他に好きなことを自由にやってください！漫画は日本語でもOKです。\n\nありがとうございました！", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@o_4_a_5/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3818308, "client_id": 3818357, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/514b32b9/uploads/origins/8242dcd8-26a4-413d-9406-14fb58000947?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6d0e5d0b93f3ed41c0b2658b97e42958", "srcset": "https://si.imgix.net/514b32b9/uploads/origins/8242dcd8-26a4-413d-9406-14fb58000947?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6d0e5d0b93f3ed41c0b2658b97e42958, https://si.imgix.net/514b32b9/uploads/origins/8242dcd8-26a4-413d-9406-14fb58000947?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e8b67510198f08dbfcd33ff584997530 2x, https://si.imgix.net/514b32b9/uploads/origins/8242dcd8-26a4-413d-9406-14fb58000947?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=070a86204c37c3cc49d1be98ad515f85 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/514b32b9/uploads/origins/8242dcd8-26a4-413d-9406-14fb58000947?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e40bd42f887e047f9dc6d3db4dc07436", "srcset": "https://si.imgix.net/514b32b9/uploads/origins/8242dcd8-26a4-413d-9406-14fb58000947?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e40bd42f887e047f9dc6d3db4dc07436, https://si.imgix.net/514b32b9/uploads/origins/8242dcd8-26a4-413d-9406-14fb58000947?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=20c0fb48824ec4afe82ec1903d108c31 2x, https://si.imgix.net/514b32b9/uploads/origins/8242dcd8-26a4-413d-9406-14fb58000947?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=663fe538ee808b82d41146e00adc2aa8 3x"}, "body": "スケブ初めてで、失礼があったら申し訳ございません。うぶ葬さんの櫂ちゃんが大好きです。櫂ちゃんと私の本名の由来でもあるあんずの実を描いて頂くことは可能でしょうか。難しければ櫂ちゃんのみでも幸せです。", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@o_4_a_5/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "comic", "tipped": true, "creator_id": 3818308, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/98410a06/uploads/origins/f9502b54-e8ab-45d4-bccd-9