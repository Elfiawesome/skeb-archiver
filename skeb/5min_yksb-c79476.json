cdaf848f1ba6a3c0320f0d85e426af16 2x, https://si.imgix.net/86faf42e/uploads/origins/0ca7a869-640b-4501-8d51-c998191c10dc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=664c77d9aa2479b893acf786d7a6daf2 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/86faf42e/uploads/origins/0ca7a869-640b-4501-8d51-c998191c10dc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=341778f72506280338d09ac0c91e8529", "srcset": "https://si.imgix.net/86faf42e/uploads/origins/0ca7a869-640b-4501-8d51-c998191c10dc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=341778f72506280338d09ac0c91e8529, https://si.imgix.net/86faf42e/uploads/origins/0ca7a869-640b-4501-8d51-c998191c10dc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=50da6e66deb4add81a191ff62abec13c 2x, https://si.imgix.net/86faf42e/uploads/origins/0ca7a869-640b-4501-8d51-c998191c10dc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=74e3da1f87d000fc7611da4a76591ce8 3x"}, "body": "カップ焼きそば様\n\nこんにちは。つくもです。\nいつも素敵なイラストや漫画をご投稿下さって、誠に有り難う御座います。\nこの度は、ご要望がありますので、初めてSkebのリクエストをお送りさせて頂きます。\n\nお尻が好きなので、体育の水泳の授業後の男子更衣室で、陽介くんが自分のお尻を出して、恒輔くんと朔真くんが陽介くんのお尻の特徴について語る場面をカラーイラストで拝見してみたいです。\n\nイメージとしましては、\n恒輔くんが何気なく陽介くんのお尻を誉めた事から始まります。\n誉められて嬉しくなった陽介くんは、スクール水着を降ろしてお尻を出して、自分のお尻を自慢します。\n\n陽介くんがお尻を出す瞬間に、お尻の隣に、お手数では御座いますが、手書きの文字などで『ぷり～ん』や『ぷりっ』などとお尻を出した事が伝わる表現をお書き頂ければ幸いです。\n\nお尻をただ見るだけでなく、スキンシップとして、恒輔くんと朔真くんが陽介くんのお尻を触ったり揉んでみたりする描写があればとても嬉しいです。\n\nこれは私のイメージなのですが、陽介くんのお尻はぷりっとしていて、柔らかくて触り心地の良いイメージがあります。\n恒輔くんのお尻は柔らかめと固めの中間のイメージ、朔真くんのお尻は固めのイメージがあります。\nもしもカップ焼きそば様が抱かれているイメージと違っていましたら、誠に申し訳御座いません。\n\nそしてもしも機会がありましたら、恒輔くんと朔真くんのお尻（生尻）のイラストも拝見してみたいです。\n\n最後に、恒輔くんと朔真くんが陽介くんのお尻を触って揉んでいる所に、山センさんが登場してその光景に突っ込みを入れる描写がありましたら、こちらもとても嬉しいです。\n\nイメージの文章が長くなりまして、誠に申し訳御座いません。詳細に書かせて頂きましたが、こちらで大丈夫でしょうか。\nもしも宜しかったらですが、何卒宜しくお願い申し上げます。", "nc": 176, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@5min_yksb/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2081164, "client_id": 75041, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/712d6e26/uploads/origins/390c2f3b-ec38-47c1-927e-a300f870cc9d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3d8e2b5f54ef1e896fa8b401fd338966", "srcset": "https://si.imgix.net/712d6e26/uploads/origins/390c2f3b-ec38-47c1-927e-a300f870cc9d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3d8e2b5f54ef1e896fa8b401fd338966, https://si.imgix.net/712d6e26/uploads/origins/390c2f3b-ec38-47c1-927e-a300f870cc9d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=1bf8f15cfae6f2e4622b0d30809d7e1c 2x, https://si.imgix.net/712d6e26/uploads/origins/390c2f3b-ec38-47c1-927e-a300f870cc9d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=1bd435250ee36c0f316c0f5975defff4 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/712d6e26/uploads/origins/390c2f3b-ec38-47c1-927e-a300f870cc9d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a946505e383a77d50f1441617eaf8524", "srcset": "https://si.imgix.net/712d6e26/uploads/origins/390c2f3b-ec38-47c1-927e-a300f870cc9d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a946505e383a77d50f1441617eaf8524, https://si.imgix.net/712d6e26/uploads/origins/390c2f3b-ec38-47c1-927e-a300f870cc9d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=449ca67ab0276afe4eae8ccd1b8108ce 2x, https://si.imgix.net/712d6e26/uploads/origins/390c2f3b-ec38-47c1-927e-a300f870cc9d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=44cf25586d82f58a10541a198fc571a4 3x"}, "body": "はじめましてよかったらリクエストしたいです\n\nキャラは、陽介くんが好きなので彼でお願いします\n内容は、へそフェチなのでへそに関するカラーイラストをお願いします\n学校企画でへそに関する動画を撮影したいと依頼され\n出来がいいとお小遣いがもらえると聞いてノリノリで答えている姿がいいです\n\n構図は、ヘッダーの格好でへそは可能ならちょっとでべそがいいです\n以下の答えをセリフとして入れてください\n・へその形について教えてください\n・へそ見られて恥ずかしいか\n・へそは誰と元々つながっているか\n・へその中身はどんな感じか　豆やしわはどのくらい\n・へそに関する経験したエピソードを教えてください\n・お母さんからは自分のへその形　どんなか言われたことあるか\n\nマニアックなリクエストですが、陽介くんがへそについて語ってる姿がぜひ見たいです！\n彼のセリフにへそやでべその発言多めだと嬉しいです\nよろしくお願いいたします", "nc": 33, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}], "sent_works": [], "similar_creators": [{"id": 2566, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "赤口ユウダ@次は冬コミ", "screen_name": "magmayuuda", "avatar_url": "https://pbs.twimg.com/profile_images/2089274874217037824/5PkNfEf7.jpg", "header_url": "https://pbs.twimg.com/profile_banners/4849088167/1786956922/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 7, "complete_expiration_days": 120, "skills": [{"genre": "art"}, {"genre": "comic"}], "banned": false, "nc": 161}, {"id": 347763, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "ぽっち", "screen_name": "pocchipocchi", "avatar_url": "https://proxy.misskeyusercontent.jp/avatar.webp?url=https%3A%2F%2Fmedia.misskeyusercontent.jp%2Fmisskey%2F1bd74a93-96b0-4951-b621-daad16027745.png&avatar=1", "header_url": "https://media.misskeyusercontent.jp/misskey/b723f7d7-8c49-41f3-a2c9-ca4567cef44a.png", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "art"}, {"genre": "comic"}], "banned": false, "nc": 176}, {"id": 366515, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "秋空広樹", "screen_name": "akizor