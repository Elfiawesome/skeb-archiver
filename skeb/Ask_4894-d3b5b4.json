_4894/status/1527140869597691904?s=20&t=qoVNshZObc-SDxd24QH7LQ\n\n出来るだけ細かく記載しましたが、不備がありましたら申し訳ありません。\n宜しくお願いいたします。", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@neginko_fox/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1757888, "client_id": 1151042, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/ac7bd9ca/uploads/origins/cf35aaf2-8fb5-47d1-b370-2367f34871cc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=16fd6128891cfe5ad15b8d35150c166e", "srcset": "https://si.imgix.net/ac7bd9ca/uploads/origins/cf35aaf2-8fb5-47d1-b370-2367f34871cc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=16fd6128891cfe5ad15b8d35150c166e, https://si.imgix.net/ac7bd9ca/uploads/origins/cf35aaf2-8fb5-47d1-b370-2367f34871cc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=21520a3a4c98ce96f0838a95a0cd8740 2x, https://si.imgix.net/ac7bd9ca/uploads/origins/cf35aaf2-8fb5-47d1-b370-2367f34871cc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=107e6e6f7f2137acb5fd566b8a644441 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/ac7bd9ca/uploads/origins/cf35aaf2-8fb5-47d1-b370-2367f34871cc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=bf952b136be547b8b60fb02dd15ca935", "srcset": "https://si.imgix.net/ac7bd9ca/uploads/origins/cf35aaf2-8fb5-47d1-b370-2367f34871cc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=bf952b136be547b8b60fb02dd15ca935, https://si.imgix.net/ac7bd9ca/uploads/origins/cf35aaf2-8fb5-47d1-b370-2367f34871cc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=3b5447bbad2d292f150ff96286fb8617 2x, https://si.imgix.net/ac7bd9ca/uploads/origins/cf35aaf2-8fb5-47d1-b370-23