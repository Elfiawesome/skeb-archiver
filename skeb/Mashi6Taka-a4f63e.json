ng", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Mashi6Taka/works/11", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3603576, "client_id": 98869, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/b4b42430/uploads/origins/daa9fb24-33f0-49ec-ad6e-8faa927979a0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4c93f577c57be2a60bdb9dcd978512ff", "srcset": "https://si.imgix.net/b4b42430/uploads/origins/daa9fb24-33f0-49ec-ad6e-8faa927979a0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4c93f577c57be2a60bdb9dcd978512ff, https://si.imgix.net/b4b42430/uploads/origins/daa9fb24-33f0-49ec-ad6e-8faa927979a0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=d25007d98ee294ed106a0361c57c2ede 2x, https://si.imgix.net/b4b42430/uploads/origins/daa9fb24-33f0-49ec-ad6e-8faa927979a0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c75a9e978c1d0b15a3d21a440a8cc562 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/b4b42430/uploads/origins/daa9fb24-33f0-49ec-ad6e-8faa927979a0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0889fb22adfccfa627fdc467e1890931", "srcset": "https://si.imgix.net/b4b42430/uploads/origins/daa9fb24-33f0-49ec-ad6e-8faa927979a0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0889fb22adfccfa627fdc467e1890931, https://si.imgix.net/b4b42430/uploads/origins/daa9fb24-33f0-49ec-ad6e-8faa927979a0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=ac519648263c9048cf90c7ffb8de5937 2x, https://si.imgix.net/b4b42430/uploads/origins/daa9fb24-33f0-49ec-ad6e-8faa927979a0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=a7dcb61a08eae6851bb78a0296c8e7fd 3x"}, "body": "タカハシマシロ様、初めまして。\n貴方の描く獣人がカッコ良くて好きです（特にルーカスさんが好きです。同人誌の方も購入させて頂きました！）。\n\n自分はケモノの着ぐるみの活動をしている者です。今回、自分のOCである「聖痕（せいこん）」という白い狼の獣人の名刺用イラストを依頼したいです（以下URL内に設定画あり）。\n「青空」と「光（太陽）」をイメージした背景で、ポーズや表情はおまかせします。\nOCは明朗快活、楽しいことに目がないがやる時はやるヒーロー気質な性格の子です。\n衣装はURL内の写真にあります、灰色のロングベストと首元に青いスカーフを着用したものをお願いします。\nまた名刺作成にあたり、イラストの四隅のいずれかにタカハシ様のサインを小さく描いたものも頂けると幸いです（サイン入りのものを名刺に使用致します）。\n\nSKIMAの方では背景ありのオプションが見当たらず、こちらで依頼させて頂きました。何卒宜しくお願い致します。\n\nhttps://drive.google.com/drive/folders/1rb2JllQ8GlLMXhF0W7uretYtCPfd_jtO", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Mashi6Taka/works/10", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3603576, "client_id": 2715417, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/e4f51f90/uploads/origins/afb173a5-394e-4ae9-8623-ddbb5220f51d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a4cea0d766902b48b15b67f75f7e3ef1", "srcset": "https://si.imgix.net/e4f51f90/uploads/origins/afb173a5-394e-4ae9-8623-ddbb5220f51d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a4cea0d766902b48b15b67f75f7e3ef1, https://si.imgix.net/e4f51f90/uploads/origins/afb173a5-394e-4ae9-8623-ddbb5220f51d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=74e4302650b7a2b709da3de2bf724f59 2x, https://si.imgix.net/e4f51f90/uploads/origins/afb173a5-394e-4ae9-8623-ddbb5220f51d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f9b03af7c0df3258d6e384cd243a3a92 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/e4f51f90/uploads/origins/afb173a5-394e-4ae9-8623-ddbb5220f51d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5591a891d1e18c7ac49045b8d962a984", "srcset": "https://si.imgix.net/e4f51f90/uploads/origins/afb173a5-394e-4a