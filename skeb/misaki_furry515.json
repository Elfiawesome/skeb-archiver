/uploads/origins/8455d736-eb15-4000-a522-7e25a6f939ae?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=f03cb4a879850cad33d56e100238bf65", "src_set": ""}, "private": true, "genre": "comic", "tipped": false, "creator_id": 14834, "client_id": 0, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 160, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@misaki_furry515/works/329", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 14834, "client_id": 3397415, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/395e0be2/uploads/origins/403747cd-d09d-4b10-8244-3ff49a3954e3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=88251b3678cfdab267df1fe29dcc880f", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/395e0be2/uploads/origins/403747cd-d09d-4b10-8244-3ff49a3954e3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=bc005abe2a13d27a9146f0655b8044fe", "src_set": ""}, "body": "再びこんにちは！私のキャラクター \"ココ \"の全身アートワークを依頼したいと思っています。背景は無地で構いません（ピンクかパープル、どちらでも構いません）。キャラクターの姿勢や表情はお任せします。可能であれば薬指に結婚指輪もお願いします。\nCharacter - https://x.com/kitsunecoconut/status/1841993456027107811/photo/1\n\nファーストバリエーション：（妊娠していない）全身・前面・背面・全裸・服なし\n\n第2バリエーション：（妊娠中）全身 - 前後から見た図 - 全裸 - 服なし\n\n第3のバリエーション（あなたが描きたい場合）：私のキャラクターをどうしたいか、楽しんで選んでほしい。あなたの好みに合わせて、自由に変更、追加、削除してください。\n\nありがとうございました！", "nc": 177, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@misaki_furry515/works/328", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 14834, "client_id": 70456, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/28ea47b5/uploads/origins/327a1d34-e5d9-46f1-bfa1-5ff3197d38f5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c0e36fd21f77f2b18970af581d9347c0", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": true, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/28ea47b5/uploads/origins/327a1d34-e5d9-46f1-bfa1-5ff3197d38f5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ef023e35d1fb46a1721c67f3aa8fc938", "src_set": ""}, "body": "こんにちは\nいつもイラストお世話になっております。\nみさき@けもケ A-23さんの描くうちのエルナトの異形化が見たいです。\nかなりフェチが入っていますが検討よろしくお願いします\n\nシチュエーションとしては研究室のような場所でエルナトが立っていると粘液が垂れてきて変異が始まるのを\nガラス越し視点で眺めている感じです。\n\n１．研究室で着る白衣のような服を着たエルナトが研究室に立っていると天井から毒々しい粘液が垂れて翼や尻尾に付着する。\n\n２．背中の翼が触手に変異して服が破かれ、身体に触手が巻き付いてガラスに押さえつけられる。\n背後では変色した変異しかけの尻尾がのたうっている。\n\n３．完全に変異した尻尾が前方に来てエルナトのヴァギナに舌を挿入している。\n変異しかけの胸を触手が絡みついてまさぐっている。\n\n４．全身が完全に変異して顔つきの変わったエルナトがガラス越しに誘惑するような表情をしながら\n勃起したクリチンポでガラスに先走りを付着させている。\n(変異した胸や尻尾、触手が映っていると嬉しい)\n\n粘液の色はエルナトの元の体色の蛍光版←変異して不要になった残りカスを排出している感じです。\nなるべく粘液などで修正を行ってもらえると嬉しいです。\n\nhttps://drive.google.com/drive/folders/13f7uqlgLZtHuIGawbg9Po1gRfgykiufL?usp=drive_link", "nc": 58, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@misaki_furry515/works/327", "private_thumbnail_image_urls": null, "private": false, "genre": "comic", "tipped": false, "creator_id": 14834, "client_id": 0, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/5fc5ec39/uploads/origins/9ea35b5e-756c-4e7a-bc1a-22094bc4c184?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=eb8b7c2c46aa824e630d7f3984dc1550", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/5fc5ec39/uploads/origins/9ea35b5e-756c-4e7a-bc1a-22094bc4c184?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0c29645ccc758dcdf25228ec8d8a