。）\n\n特徴\n・眉上のぱっつん前髪\n・髪はほぼ黒くらいの、暗い茶髪のボブ\n・黒縁のメガネ（ボストン型）\n・左目尻に泣きぼくろ\n・両耳にシルバーの小さい輪っかのピアス\n・左耳の軟骨に1つ粒のピアス（透明な石付きです。画像参照）\n\n要望\n・シンプルな白い襟付きシャツを着せてください。\n・バストアップでお願いします。\n\n構図はお任せしたいのですが、思いつかない場合は証明写真のように描いて頂ければ嬉しいです。\n\nイラストはSNSアイコンに使用させていただきたいです。\n楽しく描いていただけたらと思います。\nご検討のほど何卒よろしくお願いいたします！\n\nhttps://photos.app.goo.gl/717YRyysk7dvKR1Q7", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@sanada_jp/works/11", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 4110717, "client_id": 3253874, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/9ecd8441/uploads/origins/911640a3-db7d-470d-93d1-3cf8dd04bdc9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6c9e103e00d1e2b62f2ce463d5bc47bb", "srcset": "https://si.imgix.net/9ecd8441/uploads/origins/911640a3-db7d-470d-93d1-3cf8dd04bdc9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6c9e103e00d1e2b62f2ce463d5bc47bb, https://si.imgix.net/9ecd8441/uploads/origins/911640a3-db7d-470d-93d1-3cf8dd04bdc9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b5979b75ba5d0d6a41afe3f6c8afcc01 2x, https://si.imgix.net/9ecd8441/uploads/origins/911640a3-db7d-470d-93d1-3cf8dd04bdc9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=645999329971c6aa50411eacc467fce5 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/9ecd8441/uploads/origins/911640a3-db7d-470d-93d1-3cf8dd04bdc9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e0cfc8bb0c5042308267be648f5d5d91", "srcset": "https://si.imgix.net/9ecd8441/uploads/origins/911640a3-db7d-470d-93d1-3cf8dd04bdc9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e0cfc8bb0c5042308267be648f5d5d91, https://si.imgix.net/9ecd8441/uploads/origins/911640a3-db7