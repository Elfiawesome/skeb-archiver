一方で大切な間柄の人以外には無関心な面があるため、死体蹴りも余裕でする。新人として先輩方についていこう！のスタンス。（資料にある羽装備はフレーバーのため基本は付いてないです）\n◇共通設定\n皆犯罪組織のメンバー\n狼はかなり静かで表の姿で交流することが一切ないため、謎に包まれている部分が多い。\n魔女と天使は波長が合うのか、プライベートでも交流があるらしい。\n鬼も積極的に他と交流していないが、来るもの拒まずのためよく遊びに来る天使なんかとはよくお茶をする。\n\nご検討宜しくお願い致します。\n\nhttps://drive.google.com/drive/folders/1TSZO_VahiNr7kuVRT7uHOYEcQG5aUYkE?usp=sharing", "nc": 176, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}], "similar_creators": [{"id": 1176998, "creator": true, "nsfw_acceptable": false, "acceptable": false, "name": "ふゐ", "screen_name": "huipi___pi", "avatar_url": "https://pbs.twimg.com/profile_images/1622776474767073280/Ykum6qAe.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1391627382121852932/1670857051/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "art"}], "banned": false, "nc": 129}, {"id": 1509110, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "社長", "screen_name": "kakarichokacho", "avatar_url": "https://pbs.twimg.com/profile_images/2038909766551179265/v7jDheIv.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1134357158751956992/1776343663/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 5, "complete_expiration_days": 60, "skills": [{"genre": "art"}, {"genre": "comic"}, {"genre": "correction"}], "banned": false, "nc": 160}, {"id": 2181630, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "遠藤ヒョウガ", "screen_name": "hyouga617", "avatar_url": "https://pbs.twimg.com/profile_images/1672246410241273859/dG2Z86OH.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1290569802/1687530437/1500x500", "appeal_receivable"