path": "/@toumei_yu/works/19", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3181943, "client_id": 3102516, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/641ac528/uploads/origins/48cf433b-be55-4d53-91e7-392ce7d308a6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6060474305ef1046f72610d73ddc9813", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/641ac528/uploads/origins/48cf433b-be55-4d53-91e7-392ce7d308a6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=4201086765402ee30229f31354225695", "src_set": ""}, "body": "Hello!\n\nI would like an artwork (game texture) to put into my level for a video game. It is for a free level I am making for Counter-Strike: source (20 year old game with small community). I want to put the image as a billboard advertisement sign on a wall in the level to make it interesting.\n\nI would like a character with a 'T Pose (Tポーズ)' \n\nIn my head I imagine a person flying through the sky with their arms stretched out\n\nAnd the text 'Let go...' (in English or Japanese)\n\nThe reason for the phrase is because the player has to let go of the keys on their keyboard at this moment to progress\n\nOf course, you don't have to do that, I will take any artwork and accept it", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@toumei_yu/works/18", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3181943, "client_id": 3675796, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/53727d6d/uploads/origins/c3f6a23f-85fd-4154-98e8-58b7ee72a108?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0c0ff5c42f91b51f3267be0e2f984682", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/53727d6d/uploads/origins/c3f6a23f-85fd-4154-98e8-58b7ee72a108?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=28751094a7f4634e5c456e1632172ad4", "src_set": ""}, "body": "生きていてつらいとき寄り添ってくるような\nイラストが欲しいです\n\n私はとろめりさんの普段の自然な絵が好きなので\nこちらの依頼についてもそんな感じだとうれしいです\n\nＳｋｅｂの依頼は個人的に初めてで少し緊張します\nよろしくおねがいします", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@toumei_yu/works/17", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3181943, "client_id": 0, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/799e018d/uploads/origins/706f1a1c-f28e-4f99-b6bd-df751a60dc35?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=906112648ce0267287ace8bb2b407059", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/799e018d/uploads/origins/706f1a1c-f28e-4f99-b6bd-df751a60dc35?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b56792ef0476e1cf28a94ef917ca6df4", "src_set": ""}, "body": "ご依頼失礼します。\n下記資料のかたつむりな感じの衣装を着た女の子を描いてみて頂けますか？\n指定は着せる衣装のみですので、中の女の子のデザインや触角や殻などの色といった細部はそちらにお任せします。\n\n衣装についてはアレンジや要素の付け足し等も歓迎ですのでお好きなようにやって頂けると幸いですが、\n手は先端まで完全に覆われ、足も長い裾で完全に隠れるローブや着ぐるみっぽい服ですので 手先や足先まで露出させないようにお願いします。\n\nそれから、衣装の手先部分のデザインに関してなのですが 先細りの先端が完全に閉じた形状と、ローブのようにたるみのある感じを両立した感じに描いて貰いたいです。\n衣装自体の資料とは別でその下に作例をご用意しましたので 可能であればこちらを参考に描いてみて頂きたいです。\n\nまた、頭の触覚の部分の解釈も自由ですので、そのまま触覚付きのカチューシャのように描いても、カチューシャ部分を省いて頭から直接触覚が生えてる感じに解釈してもどちらでも良いものとします。\n\n構図やポーズ等はそちらにお任せします。\n\n参考資料(衣装本体資料)↓\nhttps://imgur.com/a/qmGUT0v\n\n参考資料↓(衣装の手先部分資料)\nhttps://imgur.com/a/pgwjiMN", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@toumei_yu/works/16", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3181943, "client_id": 3596309, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/8445652d/uploads/origins/47cc7018-fe61-4ada-89d4-74a82e11fefe?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bcf31f107a66e1b99a5adad7e8585d1d", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/8445652d/uploads/origins/47cc7018-fe61-4ada-89d4-74a82e11fefe?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=18ce2a80f434db9ba2c67d06f2e7d891", "src_set": ""}, "body": "はじめまして。先程あなたの絵を見かけて一目惚れしました。ハーフツインの女の子をかいていただきたいです。他の部分はおまかせします。skebを利用するのが初めてなので、失礼があったらすみません。SNSアイコンでの使用を考えております。よろしくお願いいたします。", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@toumei_yu/works/15", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/bcb454f0/uploads/origins/e40bf15b-b4af-4f78-addd-1a4c11456360?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=7b3cf2b46e1e0076247546058fb88d0c", "src_set": ""}, "private": true, "genre": "art", "tipped": false, "creator_id": 3181943, "client_id": 0, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 16, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@toumei_yu/works/14", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3181943, "client_id": 2344098, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/176fe828/uploads/origins/97cb1121-c591-46b6-b364-a8dc7dd87d27?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6bfb00f5c6a067a6949dab08f5084b4d", "src_set": ""}, "duration": null, "nsfw": false, "ha