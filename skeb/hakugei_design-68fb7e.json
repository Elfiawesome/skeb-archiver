mat%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f400fe3a7dc526560298cac95b7587c1", "srcset": "https://si.imgix.net/338fb6df/uploads/origins/5373946a-dfb0-4d09-b655-b5e46e1e6d2a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f400fe3a7dc526560298cac95b7587c1, https://si.imgix.net/338fb6df/uploads/origins/5373946a-dfb0-4d09-b655-b5e46e1e6d2a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=414039f5a8a12e907ddc2561069a98c8 2x, https://si.imgix.net/338fb6df/uploads/origins/5373946a-dfb0-4d09-b655-b5e46e1e6d2a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=0a2779d5eb501472d770633e999d6238 3x"}, "body": "こんばんは！\n前回とっても可愛い栞の妖精ちゃんを描いていただきありがとうございました！白鯨さんに考えていただいたお出かけ衣装お気に入りです☺️💓\n\n耽美でどこか冬の雰囲気がする白鯨さんの画風がとても好みです…！💐 雪とツリーの女の子イラストとドレッシングルームのイラストすごく素敵でした✨️\nそんな白鯨さんの世界観で描かれる等身サイズのうちの子(エモモ)が見たくて今回リクエストを送らせていただきました✨️\nシチュエーションやポーズ、表情など全てお任せで…!!‪💓💭\n\nミラティブの規約上個人で楽しむ分には有償リクエストOKとの事でしたので、マイエモモをそのまま資料として送らせていただきます🙇🏻\n(もしこちらの把握ミスによる問題や不備がございましたらお手数をお掛けしますがリクエストキャンセルお願いします😭💦)\n\n目を通していただきありがとうございます✨️\nご縁がありますように…✨️\nよろしくお願いいたします！\n\nhttps://photos.app.goo.gl/yW4FnQEURZUhRy3W8", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@hakugei_design/works/9", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3161497, "client_id": 3449232, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/94fe21cd/uploads/origins/9e56aefb-3265-48f6-9118-adf4f8decb38?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d5bafe1e765b95f306d1d7644d70ad60", "srcset": "https://si.imgix.net/94fe21cd/uploads/origins/9e56aefb-3265-48f6-9118-adf4f8decb38?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d5bafe1e765b95f306d1d7644d70ad60, https://si.imgix.net/94fe21cd/uploads/origins/9e56aefb-3265-48f6-9118-adf4f8decb38?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=4f2a1a0288da5b1cfd79ec714952962b 2x, https://si.imgix.net/94fe21cd/uploads/origins/9e56aefb-3265-48f6-9118-adf4f8decb38?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=1030d2fea8d8d29c5b328be571d6a799 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/94fe21cd/uploads/origins/9e56aefb-3265-48f6-9118-adf4f8decb38?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c2945b59fec0bf388cfcb7363a036172", "srcset": "https://si.imgix.net/94fe21cd/uploads/origins/9e56aefb-3265-48f6-9118-adf4f8decb38?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c2945b59fec0bf388cfcb7363a036172, https://si.imgix.net/94fe21cd/uploads/origins/9e56aefb-3265-48f6-9118-adf4f8decb38?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=e399d4c883c0e340a87a6e0695455649 2x, https://si.imgix.net/94fe21cd/uploads/origins/9e56aefb-3265-48f6-9118-adf4f8decb38?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=66e4670514df56f169acfe237b202798 3x"}, "body": "初めまして、以前はアピール頂きありがとうございました🌸\n\nかなり以前に頂いたアピールのため金額の方こちらで難しければ再送頂けますと幸いです。\n\nぜひ、ご提示頂いた構図での当方のOCが見てみたいと思いリクエストを送らせて頂きました💎🪽\n\n  【構図等】 \n構図・表情等はおまかせ致します。 \n衣装については下記に記載させていただきます。 \n描写範囲の方は腰上や胸上等の全身に近い物だと嬉しいですがお好きにしていただいて構いません。 \nまた、背景の方は有りましたら非常に嬉しいです。  \n\n【容態等の中で特殊な点】 \n・モチーフ：白色ヤモリの妖精 \n・性別：♂︎︎ ♀(雌雄同体)\n・ヘッドホンor頭冠 ・歯・耳・爪 \n・アイメイク \n・ピアス・フェイスピアス \n・妖精の為地面から浮く事が可能 \n・ヤモリの特性があるためまばたきを滅多にしない \n・武器：タンザナイトの宝石＋黒羽の杖 又はタンザナイトの双杖  \n\n《衣装》 \n記載のもの\n\n過去の容姿・現在の容姿のどちらでも構いません。\n\n【使用用途】 \nアイコンやSNSでの投稿等個人使用のみ(非商用)  \n\n【ファイル形式】 \n特に指定はございません \n背景のある場合人物のみの透過も頂けたら嬉しいです。 \n\n 【参考資料】 \n詳細イラストがございます。\n参考にして頂けましたら幸いです 。\n\n【その他】 \n参考程度に性格等を記載させていただきます。  \n\n・夜行性\n・宝石が大好き。お金も時間も長い生涯のその殆どを宝石に費やしている。 (特に寒色系統の宝石) \n・感情の起伏が乏しく見えるが実際はそんなことは無い。戦闘スキルは頭1つ抜けている。 得意な魔法は氷系。ものづくりの魔法も得意 \n・誕生色：ブライト・アクア \n優しさと力強さを併せもつ創造者 \n・イメージカラー：白縹(しろはなだ)  \n\nお忙しいところ恐縮ですがご検討いただけますと幸いです。  \n\n【キャラクター詳細】  \nhttps://drive.google.com/drive/folders/1-3VHKyttDxo8XvcGAX7116RLqfDECPFJ", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@hakugei_design/works/8", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3161497, "client_id": 3148356, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/b949f9e7/uploads/origins/3cfa2f4e-7f04-4b43-8537-7c6a4f90ca07?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7cba76baddd8d372333280fc290251b9", "srcset": "https://si.imgix.net/b949f9e7/uploads/origins/3cfa2f4e-7f04-4b43-8537-7c6a4f90ca07?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7cba76baddd8d372333280fc290251b9, https://si.imgix.net/b949f9e7/uploads/origins/3cfa2f4e-7f04-4b43-8537-7c6a4f90ca07?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=dece3df5b58ce6ff569fd6a41316c7f1 2x, https://si.imgix.net/b949f9e7/uploads/origins/3cfa2f4e-7f04-4b43-8537-7c6a4f90ca07?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=4ec5ef2fd3a555547c3f8e78c8db50e6 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/b949f9e7/uploads/origins/3cfa2f4e-7f04-4b43-8537-7c6a4f90ca07?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=10970416bc298bd6b7ff11d91b5a12a5", "srcset": "https://si.imgix.net/b949f9e7/uploads/origins/3cfa2f4e-7f04-4b43-8537-7c6a4f90ca07?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=10970416bc298bd6b7ff11d91b5a12a5, https://si.imgix.net/b949f9e7/uploads/origins/3cfa2f4e-7f04-4b43-8537-7c6a4f90ca07?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=1e519d2162914b8b8dfd33ea41941f0f 2x