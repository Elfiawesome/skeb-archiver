る。\n\n\nGoogleドライブに参考画像を載せております\n通過シナリオのネタバレ等はございません\n\n―――――\n▼リクエスト内容\n\n4人全員描写された1枚絵と、\n可能であれば、SDイラストもそれぞれ4体お願い出来たら嬉しいです。\nグッズ化できるようなもののイメージですが、簡単なもので大丈夫です。\n\n・服装は描きやすいように簡略化して頂いて大丈夫です。またはお任せいたします。\n・イラストの構図もお任せいたします。1枚絵の方は、バストアップ以上であれば、描写範囲などもおまかせ致します。アウトローな雰囲気があるとうれしいです。\n\n・使用用途: 個人利用(鑑賞・アイコンなどの個人利用・グッズ化)\n\n―――――\n\n長文失礼致しました。\n大人数のため、金額が見合わなければ、ご遠慮なく金額の再送やキャンセル等のご対応をしてくださればと思います。\n宜しければご検討頂けますと幸いです！\n\nhttps://drive.google.com/drive/folders/1D3wgxTbuGwZbAuh5BaLn05I77pvybLC1", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@tontototoooon/works/11", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 247005, "client_id": 2135549, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/62a516aa/uploads/origins/592da5e3-b52e-45ef-9ea5-dfde8aa46d5e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=50205b105293a9bb021147a35bc75408", "srcset": "https://si.imgix.net/62a516aa/uploads/origins/592da5e3-b52e-45ef-9ea5-dfde8aa46d5e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=50205b105293a9bb021147a35bc75408, https://si.imgix.net/62a516aa/uploads/origins/592da5e3-b52e-45ef-9ea5-dfde8aa46d5e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=2f05bbeec15f2c7255d4c926d459c1a3 2x, https://si.imgix.net/62a516aa/uploads/origins/592da5e3-b52e-45ef-9ea5-dfde8aa46d5e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f01ce9d337dda4da9cf0776906a8a580 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/62a516aa/uploads/origins/592da5e3-b52e-45ef-9ea5-dfde8aa46d5e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f4787fe24656cb1f65ecd940c38f8980", "srcset": "https://si.imgix.net/62a516aa/uploads/origins/592da5e3-b52e-45ef-9ea5-dfde8aa46d5e?bg=%23fff&auto=forma