fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=2bfa854e5c80b1b8c68d81ea374aaaf2 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/091d8929/uploads/origins/55c41d71-852d-49f4-960b-677e8ac48ff0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=234a718884428fb2d67c796ff06dbf60", "srcset": "https://si.imgix.net/091d8929/uploads/origins/55c41d71-852d-49f4-960b-677e8ac48ff0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=234a718884428fb2d67c796ff06dbf60, https://si.imgix.net/091d8929/uploads/origins/55c41d71-852d-49f4-960b-677e8ac48ff0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=fff3500e8ea199955833252f85d19cb9 2x, https://si.imgix.net/091d8929/uploads/origins/55c41d71-852d-49f4-960b-677e8ac48ff0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=b2d26c29ceb569dc1805d53255d87c00 3x"}, "body": "はじめまして、いつもイラストなど拝見させていただいております。今回初めてskebにて依頼させていただきます。\n依頼内容ですが、「ゼノブレイド2」より、着物姿のヒカリをお願いしたいと思います(初詣を楽しんでいるイメージ)。\nお引き受けしていただけましたら、是非よろしくお願いいたします。", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@wing223s/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3826124, "client_id": 2686604, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/d63e3f7f/uploads/origins/4f3b0ed2-5ed1-482c-b64a-e97003704d52?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c55afabca315287c9cd78452cecb171f", "srcset": "https://si.imgix.net/d63e3f7f/uploads/origins/4f3b0ed2-5ed1-482c-b64a-e97003704d52?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c55afabca315287c9cd78452cecb171f, https://si.imgix.net/d63e3f7f/uploads/origins/4f3b0ed2-5ed1-482c-b64a-e97003704d52?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c2cdd4fd4fa5d1db85ef50e98f3f001a 2x, https://si.imgix.net/d63e3f7f/uploads/origins/4f3b0ed2-5ed1-482c-b64a-e97003704d52?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=0529130bc522e8f529f0eb3f9c2c6979 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/d63e3f7f/uploads/origins/4f3b0ed2-5ed1-482c-b64a-e97003704d52?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=bf5cc39a60606a6dd0d43f2e990a13af", "srcset": "https://si.imgix.net/d63e3f7f/uploads/origins/4f3b0ed2-5ed1-482c-b64a-e97003704d52?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=bf5cc39a60606a6dd0d43f2e990a13af, https://si.imgix.net/d63e3f7f/uploads/origins/4f3b0ed2-5ed1-482c-b64a-e97003704d52?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=316e3c6e0141666325203bb662918181 2x, https://si.imgix.net/d63e3f7f/uploads/origins/4f3b0ed2-5ed1-482c-b64a-e97003704d52?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=9e0c9edfd8d146be432a085bd928b087 3x"}, "body": "こんにちは、はじめまして！以前あなたのアートを見て、スタイルがとても気に入りました。そして、あなたがセールをやっているのを見て、あなたがskebを持っていることに気づいたので、私はリクエストをすることに決めました :3 。ゼノブレイドクロニクル2(https://www.mariowiki.it/images/thumb/0/05/SSBU-Mythra.png/1200px-SSBU-Mythra.png)のマイスラがクリスマスの衣装(こんな感じ: https://x.com/novasvr/status/1995598785163018746?s=20)を着て、顔を赤らめながらプレゼントを渡しているところ(こんな感じ: https://encrypted-tbn0.gstatic.com/images?q=tbn:ANd9GcSDMs6eA7uOJ3WSXLc8QTT0tRc9lXzkQhgjJQ&s)を描いてほしいです。できれば、長い髪をなびかせて、胸の谷間を大きく見せてほしい。その他、表情（冷静を装っている、迷惑そうに目をそらしている、慌てているなど）や別シーンなど、バリエーションがあれば自由に追加してください。よろしくお願いします！❤️", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@wing223s/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3826124, "client_id": 2412059, "vtt_url": null, "th