-4b50-8c82-46932dadfb9b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d2dcc30cd8cfcf4610f4f807b3a1b6e2", "src_set": ""}, "body": "こんにちは、\n\nあなたのイラストが本当に大好きです！私のOCを描いていただけたらとても嬉しいです。\n\n私のocは、角と長い巻き毛を持った人間ではない女の子です。彼女の存在は人間の痛みに基づいており、「痛み」という概念そのものであるとも言えます。テーマは「血と肉の花」「痛み」「心の虜」。自由に描いてください！また、服装はシンプルな方がいいなら、調整しても構いません。\n\n彼女の詳しい外見は添付のリンクにあります。\n\nこのリクエストを読んでいただき、本当にありがとうございます。\n\nhttps://drive.google.com/drive/folders/1WvCC84lpiVWahpDmlE5elardOUwiE2Zt", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@wonderworldwood/works/277", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 556371, "client_id": 2529104, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/8d3a468d/uploads/origins/61df6271-ff08-4681-834e-cd7ac6c70722?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ecd99f6e2b152b48fa69d32bd5943b7a", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/8d3a468d/uploads/origins/61df6271-ff08-4681-834e-cd7ac6c70722?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f409bdc3a283d243c10117c28d0dc2aa", "src_set": ""}, "body": "chivaさま、こちらでははじめまして。\nchivaさまのGOAや美しい街、某刀の二次創作を拝読させていただいております。\n美しい街や刀などの戦闘シーンもとても好きですが、chiva様の持つ筆遣いの独特の絵の雰囲気で是非描いていただきたいと思い、わたしのOCの九尾の狐をリクエストさせてください。\n\n白面銀毛九尾の狐、永きを生きた妖狐であり、天狐。良くもあらば悪くもある。\n普段は狐の耳と九つの尾が出た半人半妖の姿で、中性的な見目に長い銀の髪（前髪あり）と銀の瞳をもち、白銀の如き肌に豪奢で繊細な柄入りの朱の着物を着ています。性別はありません。しかし、人間の姿、半人半妖の姿、九尾の狐、銀色にきらめく霧の姿を持ち、男女にも自在に変化出来ます。\nジル、爾留(ちかる)、爾(あきら)、ギンコ(銀炬)、野狐禅(やこぜん)、などの複数名を持ち、複数の世界線を生きてきました。\n他人をからかうこと、面白そうなことが好きで、自由気ままに暮らしています。\n管狐という竹筒の管を通るような細長い手乗りの狐を複数匹従えています。\n風を操る扇子を持ち、幻術を繰り、狐火を飛ばし、変幻し、浮遊したりは出来るが、戦いは避けがちで好戦的ではありません。屁理屈で相手を言い負かすことが好きです。\n\n無性別感を出して、女物の着物を着ているが、男でもあり女でもあり、男でもなく女でもないというイメージがいいです。\n出来上がった画像はほぼ個人観賞用で身内で見回したいです。よろしくお願いします。\n\nhttps://drive.google.com/drive/folders/1xOVGZb2l_kx_JJeNVbFIdsc6T3orZ7du", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@wonderworldwood/works/276", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/de0a1dde/uploads/origins/3e6167b7-3bdd-4d7a-b8f4-260a31fc37c8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=75a122305cf1ef4b9d42f87692c4a035", "src_set": ""}, "private": true, "genre": "art", "tipped": true, "creator_id": 556371, "client_id": 965897, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 129, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@wonderworldwood/works/275", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/9315029a/uploads/origins/fca351cc-53e3-4e43-a1ea-48bd6f9d3b48?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=d7af84e9e4d05049c50ac072c6fc8b92", "src_set": ""}, "private": true, "genre": "art", "tipped": false, "creator_id": 556371, "client_id": 3527041, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 16, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@wonderworldwood/works/274", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/ae65531c/uploads/origins/e474afbc-cb43-44e6-bf53-6acf149613c2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=a728a720994d4058228ca1f54b0f9cd3", "src_set": ""}, "private": true, "genre": "art", "tipped": true, "creator_id": 556371, "client_id": 1227592, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 128, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@wonderworldwood/works/273", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 556371, "client_id": 3406385, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/3211b42f/uploads/origins/979c3bfc-a4df-476a-9129-771e8986dc7a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4049168e3d3aefcbfba79092a78c598e", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/3211b42f/uploads/origins/979c3bfc-a4df-476a-9129-771e8986dc7a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=099ab7701981572390f9d6c34109572c", "src_set": ""}, "body": "こんにちは、先生！\n\n 先生のアートスタイルが本当に大好きです！ぜひ先生にイラストのご依頼をさせていただきたいです。作品はSNSのアイコンやスマホの壁紙として個人利用する予定です。\n\nキャラクターは16歳の少年で、身長は174cmです。幼少期の困難な経験から、冷静で控えめな性格をしていますが、かわいらしく柔らかい一面もあります。短い黒髪で、低彩度の紫色の目を持っています。また、黒い動物の耳と尻尾もあります。\n\nデザインの変更は自由ですので、先生が描きたいように描いてください！\n\nお忙しい中、リクエストを読んでいただき本当にありがとうございます。もし内容が不適切であれば、いつでもキャンセルしてください。 どうぞよろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/1d9oP0RPpqfe9dnNXSDFQQA8iUmcUiLdJ?usp=sharing", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@wonderworldwood/works/272", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 556371, "client_id": 3032600, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/7101e719/uploads/origins/37324edd-9b6d-4528-9890-8a9e6027be77?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=20397c4cd64fd2a8a34a5521e6f80a91", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/7101e719/uploads/origins/37324edd-9b6d-4528-9890-8a9e6027be77?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a2ec0ffda7675bf561bfb7ca31779bb3", "src_set": ""}, "body": "こんにちは！\nChiva先生のイラスト作品が本当に大好きです！あの夢のような雰囲気のスタイルはとても美しく、魅力的でたまりません！\n先生の全体的な構図や、様々な小物や要素の組み合わせ方も本当に好きです。\n\n今回はオリジナルキャラクター（OC）のイラストをお願いしたいです。\nポーズや構図などの細かい部分はすべて先生にお任せします。衣装も自由に決めてください（先生のデザインされた服のスタイルが大好きです）。\nキャラクターのイメージを自由に解釈して描いていただければ嬉しいです。\n\nOCについて：\n彼女は妖怪であり、死に関する神の血を引いています。幽霊や式神を操る能力を持っています。\n性格は静かで、好奇心旺盛です。\n特徴は、緑色の目と黒い髪、整った前髪です。\n額の緑色のリボンはとても重要なポイントです。\nまた、狐のように大きな耳と尻尾があります（尻尾は隠せるため、描かなくても構いません）。\n\nOCの要素：\n百合、縄結び、白いベール、浮遊、喪服、花嫁、死装束、祭祀\n\n先生のことが本当に大好きです！\n\nhttps://drive.google.com/drive/folders/18q-f0wPs64NxyW1C0Ydr2nFXdtW2_v-r?usp=sharing", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@wonderworldwood/works/271", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 556371, "client_id": 2829634, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/d3648a00/uploads/origins/aa0cf025-d653-4429-bfc0-a86169e740d8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ee3796cfc09a3a6e6a583d91e4bcedd6", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/d3648a00/uploads/origins/aa0cf025-d653-4429-bfc0-a86169e740d8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9c8fafa626274b3294ec8137e979fd55", "src_set": ""}, "body": "こんにちは！あなたの絵がとても好きです。できれば僕のOCも描いてくれませんか？\n\n設定は参考リンクにありますので、ご自由にご覧ください。\n\nすべてお任せします。できれば大太刀も描いてほしい。また、彼女の服装や髪型をアレンジすることも可能だ。\n\n何を描こうか迷ったら、以下のモチーフを参考にしてください。\n\n月（月の満ち欠けなど）、花（キキョウなど）、狩猟、輪廻転生、鳥居など。\n\n可能であれば、psdファイルに署名のないバージョンも欲しいです。不要なリクエストでしたら、遠慮なくキャンセルしてください。\n\nありがとうございました！\n\nhttps://drive.google.com/drive/folders/18cod56p12I6XC-A-pMlQwLS-Qnl-Ab1h", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@wonderworldwood/works/270", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 556371, "client_id": 602179, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/2354e026/uploads/origins/512ff940-392b-429a-9ffd-f7ffadb25e30?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=acdf982d8bc4dc60dc8eb95665204e9c", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/2354e026/uploads/origins/512ff940-392b-429a-9ffd-f7ffadb25e30?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b690b5e522b03b7e617f8c5a126d8de6", "src_set": ""}, "body": "こんにちは！いつもリクエストばかりですみません。chivaさんのイラスト本当に大好きです。ぜひご検討いただけたら嬉しいです！\n\nhttps://toyhou.se/9417064.takashi/11871675.future/gallery\n人形の体に閉じ込められた人間の魂。不老不死となった彼は食べることも眠ることもできず、死ぬ方法を探すために錬金術を学ぶ。それでもうまくいかないため、現在は旅の錬金術師として活動している。\n\n皮膚の見えるところに関節があるので注意。\n\nテーマ：白百合、天文学（星と夜空）、etc.\n\n服のデザインは自由に変更してください！よろしくお願いします。キャンセルは可能です。", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@wonderworldwood/works/269", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/7305457e/uploads/origins/940d8793-701f-4981-bd57-f896ecfe62c3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=5657447264ea9d168d79625f0cd08187", "src_set": ""}, "private": true, "genre": "art", "tipped": true, "creator_id": 556371, "client_id": 2622609, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 129, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@wonderworldwood/works/268", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 556371, "client_id": 3472962, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/8f0ae756/uploads/origins/9c28c92b-75cc-4bb2-acee-eb185299b61d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2d8394482726692e37512da6a2f7cd2d", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/8f0ae756/uploads/origins/9c28c92b-75cc-4bb2-acee-eb185299b61d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ee8f9d9e11742a2330d48ef8e6044464", "src_set": ""}, "body": "chivaさま\nはじめまして、月來と申します。\nこの度はリクエストの受付再開ありがとうございます！\nもしよろしければ、私のOCの「ティメア」のイラストをお願いしたいです…！\n物理的・精神的な鍵開けの術を得意とする、気ままな大人の女性です。\n⇒https://7aconit.notion.site/1d2565fcc5b980d59e29fb206272756b?pvs=4\n\n構図等はお任せできればと思います。chivaさまの作風がとても好きなので、自由に描いてくださると嬉しいです！\nご縁がありましたら何卒よろしくお願いいたします…！", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@wonderworldwood/works/267", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 556371, "client_id": 3173637, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/e9908a23/uploads/origins/b899a6d1-29ce-4b9a-9367-fe30d087f800?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5a8ad370fc16e4d32d794949b2bd647d", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/e9908a23/uploads/origins/b899a6d1-29ce-4b9a-9367-fe30d087f800?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b8812e5b753e1cad145a2c650c49a84b", "src_set": ""}, "body": "こんにちは、はじめまして。あなたのエレガントで芸術的な画風がとても好きです！もしよろしければ、私のOCであるスカディを描いていただけませんか？彼女はヴァンパイアです！どんな風に描いても構いません。よろしくお願いします！\n\nhttps://drive.google.com/drive/folders/1JgbZYKZITlw1uQYV4qOSyJewLXiU7B1G", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@wonderworldwood/works/266", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 556371, "client_id": 3009954, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/c691ea7b/uploads/origins/e4d57b0d-52bb-4817-bf70-d99b3c04bccf?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0a76ff4108eadab13a726dea7ebf46b9", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/c691ea7b/uploads/origins/e4d57b0d-52bb-4817-bf70-d99b3c04bccf?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=01a779b3d0c3cec87fe13d73c58a11cb", "src_set": ""}, "body": "こんにちは、はじめまして！あなたの絵が大好きです！できれば私のオリジナルキャラクターを描いていただけないでしょうか。ティーンエイジャーのような風貌の内向的で優しい研究者です。\n\n服装は自由です。読んでくださってありがとうございました！リクエストに応えていただけると嬉しいです！\n\nhttps://drive.google.com/drive/folders/18wYjxWB7Fao4DWBOlT0cVUVOvOZNYmBE?usp=sharing", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@wonderworldwood/works/265", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/c7e239e0/uploads/origins/5b226d42-4333-4eb4-bd08-478f49c6a49e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=732a545f99244a65bb773a537f1530a5", "src_set": ""}, "private": true, "genre": "art", "tipped": false, "creator_id": 556371, "client_id": 2771361, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 17, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@wonderworldwood/works/264", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 556371, "client_id": 2056925, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/0e720081/uploads/origins/f4326ec0-f9bf-46da-9638-4d080148a64e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=11032446fb138feeb5eca8e18d4dc7a1", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/0e720081/uploads/origins/f4326ec0-f9bf-46da-9638-4d080148a64e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ddaa4936ad10eb369520950d7ffc4771", "src_set": ""}, "body": "chivaさま初めまして。\nいつも素敵な世界観とタッチのイラストを拝見しております…！\n\nもし宜しければ、TRPGで使用している私のキャラクターを描いていただきたいです。\nシチュエーション、構図等は全てchivaさまにお任せします。\n金額に見合う範囲で、よきように楽しんで描いていただけますと幸いです。\n\n\n◆アンリ\n34歳/185cm/プラチナブロンド/葡萄色の瞳\n1982年のスペイン・アルテアに住む画家\n\n水彩や色鉛筆など繊細な画風の絵を描く\nフランス出身の画家\n物静かで穏やか　偏屈だが紳士的　貧しいが教養はある\nあらゆることを器用にこなすが、生きることは不器用\n\n同棲している女性のことを「お嬢さん/レディ」と呼んで花のように大切にしているが、恋愛感情はない\n親友と呼ぶにはロマンチックで、恋人と呼ぶには性愛の絡まない不思議な関係\n\n所謂アルビノで先天的な視覚障害（乱視、羞明）を抱えており\n基本的には夜に作業をする\nまた、外出の際には紫外線を避け、キャスケット帽に髪を仕舞い込みサングラスを着用する\n\n\n◆用途\n個人観賞、アイコンなどSNSでの一部使用\n（非商用の範囲で使用させて頂きたいです）\n\n\nお手数ですが、ご検討いただけますと幸いです。\nどうぞ宜しくお願いいたします。\n\nhttps://drive.google.com/drive/folders/10OUc0ZYl0gGuLYnnXiucrSCf3-w1-2n7?usp=sharing", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@wonderworldwood/works/263", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 556371, "client_id": 0, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/2156ecd3/uploads/origins/c441b270-ebb7-493a-939a-2098b782fa7b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b3eecd11398a3602992221190eab4562", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/2156ecd3/uploads/origins/c441b270-ebb7-493a-939a-2098b782fa7b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=4acac15c82eba4b419e75b30ddf7a226", "src_set": ""}, "body": "はじめまして。chivaさんのイラストがとても好きです。\nよろしければ私の創作キャラクターを描いていただきたいです。\n\n色素の薄い髪に赤い瞳、黒いワンピースに黒のショートブーツを履いたキャラクターで、\n眉は並行でイマイチ何を考えているのかわからない顔（微笑んだりすることもあるが無表情寄り）をしています。\n頭の中央にぴょんとしたクセのある毛があり、右手側の髪は耳にかけてませんが、左手側の髪は耳にかけています。\nポーズはおまかせでお願いしたいと思います。\n\n背景に赤い花のモチーフをマストで、プラスもう一つモチーフをおまかせでお願いします。\n\nよろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/1SfkPoL7_d7R7kqOxSxLfuE8VYKHZ95L6?usp=sharing", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@wonderworldwood/works/262", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 556371, "client_id": 837221, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/d8739984/uploads/origins/b92691ac-ec96-4dab-bfad-c2c75d976aa6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4f90fb150087fba34dd444a0387cf745", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/d8739984/uploads/origins/b92691ac-ec96-4dab-bfad-c2c75d976aa6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e6171e114648a4dc462f2c53de1d4d25", "src_set": ""}, "body": "こんにちは、海外から送ります。\nもしよかったら、私のOCたちの絵をお願いしたいです。\nTRPGダブルクロス3rdのキャラたちです。\n\n▼資料\nhttps://drive.google.com/drive/folders/1v-Id1dR19GbRGcr71uggqgz3LbutSpSp?usp=sharing\n\n\n▼キャラ説明\n・Aキャラ（黒髪）\n外見30代くらいの女性で、背が高く（176cm）不穏な雰囲気を纏ったキャラです。\nヤクザのような犯罪組織のリーダーで、ラスボス系の女。優雅で静的。どこか倦怠感が漂っている。\n武器は日本刀。ヘビースモーカー。\n衣装は赤く黒い着物（訪問着）の上に白い上着（ショール）を。洋装も時々着ます。\n笑っている顔と無表情、どちらでもOKです。\n\n・Bキャラ（金髪）\n外見30代くらいの女性で、背が高く（176cm）おしゃれな美人です。\n牡丹の刺青が特徴的。器用な性格で、見た目より誠実でいい人。\n武器は割れた鏡の破片を思わせる大剣。\n実はAキャラのクローン（複製、そして影武者）で、彼女から逃げ出した過去があります。今は敵対関係。\n\n宿敵であり、最も似た存在でありながら、一生分かり合えない他人でもあります。\n衣装や髪型はご自由にどうぞ。（お任せします）\n\n象徴・モチーフ：割れた鏡、赤い牡丹の花\n華麗で装飾的な雰囲気を持ち、和風ノワールのようなテイストを好みます。\n\nもし宜しければ、ご検討頂けると幸いです。", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@wonderworldwood/works/261", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 556371, "client_id": 839128, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/ae57a8c0/uploads/origins/f800b0d2-67c7-4432-8227-9bcc3481960f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a2c62905aee67243af49786ba576f11b", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/ae57a8c0/uploads/origins/f800b0d2-67c7-4432-8227-9bcc3481960f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=db5e028002f51a9f3edeafddc8f886a9", "src_set": ""}, "body": "こんにちは！以前からあなたの作品が大好きで、ついにあなたに依頼するチャンスが来ました！私のTTRPG/パスファインダーのOCを描いていただけませんか？\n\nvaris: https://f2.toyhou.se/file/f2-toyhou-se/images/80086028_le8G1G2w6ALg32N.png\n\nヴァリスはとても優しくて、王子のように立派な人です。彼は公平に戦い、いつも助けられる人を助けます。彼は現在、騎士団長として、全世界を飲み込もうとする悪魔やモンスターと戦う十字軍に仕えています。世界の重荷を背負っているにもかかわらず、彼は \"希望は勝つ \"というモットーで生きています。\n\n彼からは紫、金、黒、白を連想することが多いが、一番使いやすいものを使ってほしい。\n\n自由に描いてください！アイデアがあれば、短剣で遊んでいる姿とか、軍隊の指揮官のように堂々と立っている姿とか！\n\nよろしくお願いします。", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@wonderworldwood/works/260", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/16c98aa8/uploads/origins/ab82d7f5-f392-4cd0-b9f1-bcaa89bddce7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=bebde70cc459bff0ad1305d9fda5f2d2", "src_set": ""}, "private": true, "genre": "art", "tipped": true, "creator_id": 556371, "client_id": 300885, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_