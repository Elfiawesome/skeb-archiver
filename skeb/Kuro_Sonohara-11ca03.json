crop&crop=top&w=200&h=200&blur=200&s=d8a25e11e0e96c4ca84f39b19e2d8bcf 3x"}, "body": "こんにちは、クロさん。前回のアートありがとうございました。\n妖精vtuberのユマネア(https://x.com/yumanea_/status/1920222111781826950?s=19)のアートをお願いしたいです。可愛くてちょっとシャイな女の子なので、自信満々のコギャル女子高生(https://catmiimi.com/wp-content/uploads/2020/01/gal0065.jpg)を描けたら楽しいと思います。\nSNSに投稿する予定です。ありがとうございました。", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@Kuro_Sonohara/works/15", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3401495, "client_id": 1698798, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/e57d929d/uploads/origins/aa6ebd1e-4646-43b0-ab2b-0f5f9748be9a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b9456815c623f924ab40bd6a3e84ea53", "srcset": "https://si.imgix.net/e57d929d/uploads/origins/aa6ebd1e-4646-43b0-ab2b-0f5f9748be9a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b9456815c623f924ab40bd6a3e84ea53, https://si.imgix.net/e57d929d/uploads/origins/aa6ebd1e-4646-43b0-ab2b-0f5f9748be9a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=bed4150467c6ba3e1a53a3e43b08e242 2x, https://si.imgix.net/e57d929d/uploads/origins/aa6ebd1e-4646-43b0-ab2b-0f5f9748be9a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=82b160249f15b23c6f8df3b4778ffb43 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/e57d929d/uploads/origins/aa6ebd1e-4646-43b0-ab2b-0f5f9748be9a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=df8dff47aeaf46f5eca1d5f78a96549c", "srcset": "https://si.imgix.net/e57d929d/uploads/origins/aa6ebd1e-4646-43b0-ab2b-0f5f9748be9a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=df8dff47aeaf46f5eca1d5f78a96549c, https://si.imgix.net/e57d929d/uploads/origins/aa6ebd1e-4646-43b0-ab2b-0f5f9748be9a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=50c55a7959bf2af8ed3938d3086e763c 2x, https://si.imgix.net/e57d929d/uploads/origins/aa6ebd1e-4646-43b0-ab2b-0f5f9748be9a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=9a556cc6c355a37b51361fd1223193e9 3x"}, "body": "あなたの絵は美しいですね。ぜひリクエストさせてください！\n私のバーチャルストリーマーのクレアを描いてください！https://drive.google.com/drive/folders/1ukkOFeWXqkGI1OkRwTywNovgAglacwpe?usp=sharing。クレアはお天気の魔女（雲、雨、雷、雪などを操る）で、髪は雲でできているので、とても軽くてふわふわしています。彼女は優しくて自信家。ポーズと背景はあなた次第です。\nあなたのアートを私のストリーミング・ソーシャルメディア（Twitch、Twitter、Patreonなど）に使用したいです。このアート作品の商用権をお願いしたいです。ありがとうございました。", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@Kuro_Sonohara/works/14", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3401495, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/1737e7b6/uploads/origins/c1f17461-c300-4414-808c-2fd2b5a50e23?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ecc3a82f732970a183f4a646d6ce55c7", "srcset": "https://si.imgix.net/1737e7b6/uploads/origins/c1f17461-c300-4414-808c-2fd2b5a50e23?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ecc3a82f732970a183f4a646d6ce55c7, https://si.imgix.net/1737e7b6/uploads/origins/c1f17461-c300-4414-808c-2fd2b5a50e23?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=caa500013412fdc4aef0b477c45c58ac 2x, https://si.imgix.net/1737e7b6/uploads/origins/c1f17461-c300-4414-808c-2fd2b5a50e23?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=9ef838d264c0bda3ae99a68711c164e7 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/1737e7b6/uploads/origins/c1f17461-c300-4414-808c-2fd2b5a50e23?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=08c247d7e8edc5a77a0ddbe18f5718e7", "srcset": "https://si.imgix.net/1737e7b6/uploads/origins/c1f17461-c300-4414-808c-2fd2b5a50e23?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=08c247d7e8edc5a77a0ddbe18f5718e7, https://si.imgix.net/1737e7b6/uploads/origins/c1f17461-c300-4414-808c-2fd2b5a50e23?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=5ae0678c749da2aacb6740ebeb8b65b5 2x, https://si.imgix.net/1737e7b6/uploads/origins/c1f17461-c300-4414-808c-2fd2b5a50e23?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=ba75985c387149bf564b8db28be46400 3x"}, "body": "はじめまして、リクエスト失礼します。\n\nキャラクター\nにじさんじの酒寄颯馬と雲母たまこ\n\nキャラクター参考\nhttps://x.com/sakayori_soma/status/1824451161409327513\nhttps://x.com/kirara_tamako/status/1824459141781524839\n\n衣装は二人とも私服姿でお願いします。衣装の色、着脱の仕方や髪型の種類はおまかせします。\n衣装参考\nhttps://www.youtube.com/watch?v=804OSlqZFbM\nhttps://www.youtube.com/watch?v=mb_5xYjZ2CQ&t=1893s\n\nシチュエーション\n二人で街中を飲食や買い物しながら散策している\n\n・恋愛的なカップリングのイラストで、たまこちゃんから颯馬くんへの好意の方が強い感じのイラストにしてほしいです。\n・表情やポーズ、背景などはお任せします。\n・条件が合わなければ再送願います。\n\nよろしくお願いいたします。", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@Kuro_Sonohara/works/13", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3401495, "client_id": 3434973, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/daac63c2/uploads/origins/fe47400b-68cb-42c0-977f-23c9b3c3d0a3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9a57f5fca32f710373554e82c6106239", "srcset": "https://si.imgix.net/daac63c2/uploads/origins/fe47400b-68cb-42c0-977f-23c9b3c3d0a3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9a57f5fca32f710373554e82c6106239, https://si.imgix.net/daac63c2/uploads/origins/fe47400b-68cb-42c0-977f-23c9b3c3d0a3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=cbdddf0673e32f31650d3bf167f4e7ea 2x, https://si.imgix.net/daac63c2/uploads/origins/fe47400b-68cb-42c0-977f-23c9b3c3d0a3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=38803bc51920e2fb2a4c919714d9cd63 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/daac63c2/uploads/origins/fe47400b-68cb-42c0-977f-23c9b3c3d0a3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3ad60903f6fe11cbc88fd037482fbf62", "srcset": "https://si.imgix.net/daac63c2/uploads/origins/fe47400b-68cb-42c0-977f-23c9b3c3d0a3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3ad60903f6fe11cbc88fd037482fbf62, https://si.imgix.net/daac63c2/uploads/origins/fe47400b-68cb-42c0-977f-23c9b3c3d0a3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=11851afc043049f58c587363b120ab2c 2x, https://si.imgix.net/daac63c2/uploads/origins/fe47400b-68cb-42c0-977f-23c9b3c3d0a3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=a14189df8a35045890957c61d347bd00 3x"}, "body": "園原クロ様\n\n初めまして、Vtuberの夢月みとと申します。\n夜の雰囲気がとても素敵だと思い、是非イラストを描いて頂ければとリクエストの方お送りさせて頂きました。\n\n【描いて頂きたい内容】\n・ハロウィンの夜に水色の三日月の乗り物に腰かけて空を飛んでいる夢月みと\n\n【資料】\n・三面図等( https://x.com/Mutsuki_mito_v/status/1903750455898906851 )\n\n【服装について】\n・ハロウィン用のイラストですので、仮装したいかな？と考えております。\n・魔女風アレンジをしつつ、シンデレラのような水色のドレス(水色の魔女帽子つけて魔女っぽさをお願いします)。\n・片足はガラスの靴を履いて、もう片足は裸足でお願いします(履いてない方のガラスの靴は人差し指を踵の部分に突っ込んで、軽く持ち上げているみたいな感じで)。\n\n【表情】\n・ハロウィンですので、いたずらっぽくお願いします(ちょっぴり生意気な感じで)。\n\n【一緒に描いて欲しい動物】\n・仲良くさせて頂いておりますVtuberの妹ちゃん達のモチーフ動物で「コウモリと猫」をお願いします。\n・コウモリの方は右目が赤で左目のオッドアイで夜空を飛んでいるような感じにお願いします。\n・猫の方は三日月の乗り物に一緒に乗っているor夢月みとの肩もしくは膝の腕でお願いします。\n\n【サイズ】\n・9:16の比率で全身が収まるようにお願いします。\n\n【使用用途】\n・サムネイル、動画内、配信\n・X(旧Twitter)での宣伝\n・その他Vtuber活動に関わる内容(一応グッズなども)\n\n【納品形式】\nPDF形式で背景と人物を分けてお願いします(透過された人物だけの物がありますととても助かります)\n\nお忙しい中かと思われますが、ご検討宜しくお願い致します。", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@Kuro_Sonohara/works/12", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3401495, "client_id": 1668612, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/c932127b/uploads/origins/0dca3b2b-8499-40d9-8af0-69891da98793?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=503ce5c300fbbb62eb79d4614220f04a", "srcset": "https://si.imgix.net/c932127b/uploads/origins/0dca3b2b-8499-40d9-8af0-69891da98793?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=503ce5c300fbbb62eb79d4614220f04a, https://si.imgix.net/c932127b/uploads/origins/0dca3b2b-8499-40d9-8af0-69891da98793?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f43eb788894c6c41424aec299bc14562 2x, https://si.imgix.net/c932127b/uploads/origins/0dca3b2b-8499-40d9-8af0-69891da98793?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c7db020413d6e239675a18c9170dbf05 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/c932127b/uploads/origins/0dca3b2b-8499-40d9-8af0-69891da98793?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=721a8b3f69a45deda84c82adf6c80c91", "srcset": "https://si.imgix.net/c932127b/uploads/origins/0dca3b2b-8499-40d9-8af0-69891da98793?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=721a8b3f69a45deda84c82adf6c80c91, https://si.imgix.net/c932127b/uploads/origins/0dca3b2b-8499-40d9-8af0-69891da98793?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=99b8d08b1f0ee81471a1cbc9541386d0 2x, https://si.imgix.net/c932127b/uploads/origins/0dca3b2b-8499-40d9-8af0-69891da98793?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=6db2f21e2721c3386e1a5bbd6dc168bd 3x"}, "body": "園原様、初めまして。\n\n今回Skebで上がっていたイラストを拝見させていただきまして、ぜひ私のキャラのファンアートを描いて頂きたく、ご依頼させて頂きました。\n\n以下依頼内容となります。\n\n■キャラ資料\nhttps://drive.google.com/drive/folders/1RTFr9uYGukv5vTEiudiyEfXPnXYuHdy-?usp=drive_link\n\n■使用目的\n配信及びSNSやグッズ使用など\n\n■テーマ、構図やポージング\n上記の資料キャラを元にガンダムのGジェネレーションエターナルというガンダムのゲーム向けのイラストをお願いしてもいいでしょうか？\n\n主にサムネ用でも使う予定でして、このゲームに合いそうなポーズで基本お任せできればと思います！\n万が一、思いつかなければ以下の画像ポーズのようなアレンジでも大丈夫です\nhttps://pbs.twimg.com/media/DtQM5ovVAAAlr7q?format=jpg&name=large\n\n服については現在放送中の機動戦士Gundam GQuuuuuuXの主人公であるマチュの制服コスでお願いします！\nhttps://s.animeanime.jp/imgs/zoom/738935.jpg\n\n髪型は以下のどちらかの合いそうな形式でお願いします！\nhttps://drive.google.com/file/d/1TKP07pB9HW8KYdgX9jHOzuCPMDQ1p2hT/view?usp=drive_link\nhttps://drive.google.com/file/d/1nW0hFaJSOS3Y6zD7k5pmix66Vo6SM7S0/view?usp=drive_link\n\n以下、簡単な設定になります\n・男の娘（基本極貧乳の女の子ベースで大丈夫です）\n・小悪魔系+メスガキ要素\n・外見とは裏腹の艶めかしさ\n\n■その他\n\nサムネ以外でも活動目的で使わせて頂きたいとも思っています\nそのため、頭の先や横の髪の毛などは先が切れないように書いて頂ければ幸いです\n\nまたキャラのみの透過でも利用できるようPSDのデータでキャラのレイヤーだけが分かれていると非常に助かります。\n\nガンダムが苦手であれば遠慮なくキャンセル頂いて構いません！\n条件に問題なければ、何卒よろしくお願いいたします！", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@Kuro_Sonohara/works/11", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3401495, "client_id": 3363100, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/ce468098/uploads/origins/28422020-3c41-4650-90c3-f4e65c3537ac?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3fc92976a21f5f6e83da7b0e7235929d", "srcset": "https://si.imgix.net/ce468098/uploads/origins/28422020-3c41-4650-90c3-f4e65c3537ac?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3fc92976a21f5f6e83da7b0e7235929d, https://si.imgix.net/ce468098/uploads/origins/28422020-3c41-4650-90c3-f4e65c3537ac?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=cbaca57ca8d6f7ffe7d8f28d72e05185 2x, https://si.imgix.net/ce468098/uploads/origins/28422020-3c41-4650-90c3-f4e65c3537ac?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f91e7d4c8a18cf213bfdeaaf530beb43 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/ce468098/uploads/origins/28422020-3c41-4650-90c3-f4e65c3537ac?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f4a19a5850682fb03ad4e62376662e72", "srcset": "https://si.imgix.net/ce468098/uploads/origins/28422020-3c41-4650-90c3-f4e65c3537ac?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f4a19a5850682fb03ad4e62376662e72, https://si.imgix.net/ce468098/uploads/origins/28422020-3c41-4650-90c3-f4e65c3537ac?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=c1239e3c39dd8a3ad9a804805f82758c 2x, https://si.imgix.net/ce468098/uploads/origins/28422020-3c41-4650-90c3-f4e65c3537ac?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=55b82c7650d5a82be5b5598eba9abda7 3x"}, "body": "こんにちは、クロさん。あなたのカラフルなスタイルがとても気に入ったので、画像をお願いしたいです。\n狐娘のVtuber、Rena Dreamstar (https://imgur.com/a/rena-QSZG5NK)が浴衣を着ている写真が欲しいです。夏祭りを楽しんでいるか、縁側でくつろいでいるか。ポーズはお任せします。\nSNSに投稿したいです。", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@Kuro_Sonohara/works/10", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3401495, "client_id": 2549593, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/e6ca0fc5/uploads/origins/38a2eea4-08d5-4a8f-8d38-7a5880148485?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=41224af4a912cf589a9dce3673e00f1c", "srcset": "https://si.imgix.net/e6ca0fc5/uploads/origins/38a2eea4-08d5-4a8f-8d38-7a5880148485?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=41224af4a912cf589a9d