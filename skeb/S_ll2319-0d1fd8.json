用含む)\n\n【納品時の希望】\nキャラクター単体の透過データをいただけたら嬉しいです✨️\n\n✦┈┈┈┈┈┈┈┈┈┈┈┈┈┈┈✦\n\nさとうはる様の描く男性キャライラストが見たかったので、是非是非ご検討をよろしくお願いいたしますなのん🩷՞⸝⸝> ̫ <⸝⸝՞", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@S_ll2319/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3444010, "client_id": 3433249, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/7a0400f0/uploads/origins/68325196-8ec1-4487-ae04-f206cb1278f8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6a433652ecbba2dfa883ba2abe70fdd9", "srcset": "https://si.imgix.net/7a0400f0/uploads/origins/68325196-8ec1-4487-ae04-f206cb1278f8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6a433652ecbba2dfa883ba2abe70fdd9, https://si.imgix.net/7a0400f0/uploads/origins/68325196-8ec1-4487-ae04-f206cb1278f8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=1117ea5024dd88d1dc6c83e9bda5dcd6 2x, https://si.imgix.net/7a0400f0/uploads/origins/68325196-8ec1-4487-ae04-f206cb1278f8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ee6fcf1949aaa7dbbf27922c07b964e9 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/7a0400f0/uploads/origins/68325196-8ec1-4487-ae04-f206cb1278f8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=852bd3dc4a2175a5287c6ac37482a2b4", "srcset": "https://si.imgix.net/7a0400f0/uploads/origins/68325196-8ec1-4487-ae04-f206cb1278f8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=852bd3dc4a2175a5287c6ac37482a2b4, https://si.imgix.net/7a0400f0/uploads/origins/68325196-8ec1-4487-ae04-f206cb1278f8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=21c83437396cee1b5516ce7ae395967d 2x, https://si.imgix.net/7a0400f0/uploads/origins/68325196-8