-4d65-8d66-10a58ba1b22a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=05dc9338481737652563450d067550c3, https://si.imgix.net/f33cbc71/uploads/origins/b3bdc294-5543-4d65-8d66-10a58ba1b22a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=89d24b7b24102ba6f177b8ec68d9397d 2x, https://si.imgix.net/f33cbc71/uploads/origins/b3bdc294-5543-4d65-8d66-10a58ba1b22a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=fb1b9be3118521fff9a8fa15a9b8e0c4 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/f33cbc71/uploads/origins/b3bdc294-5543-4d65-8d66-10a58ba1b22a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ee7267b86abe40c89a558b317443e9d3", "srcset": "https://si.imgix.net/f33cbc71/uploads/origins/b3bdc294-5543-4d65-8d66-10a58ba1b22a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ee7267b86abe40c89a558b317443e9d3, https://si.imgix.net/f33cbc71/uploads/origins/b3bdc294-5543-4d65-8d66-10a58ba1b22a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=c3bc38c32d2c743974f75b7bcefa8bb6 2x, https://si.imgix.net/f33cbc71/uploads/origins/b3bdc294-5543-4d65-8d66-10a58ba1b22a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=9815f7ff988b141c3da4d8f8ca63c48b 3x"}, "body": "はじめまして。\n私のオリジナルキャラクター、テアのイラストを描いていただけませんか？\n\nヨーロッパの中世ファンタジーの世界です。\nテアは悪役令嬢で、チャーミングで媚びない、ずる賢く戦略的な性格の魔女です。その魅力で周囲の男性を意のままにすることで有名です。テアは欲張りな客に魅力的な呪文やポーションを差し出すが、その呪文は実は呪いであり、買い手に破滅をもたらす。\n彼女は、とげとげしたつるを操ったり、眠っている人の夢を覗き見したりと、さまざまな魔法の呪文を唱えることができる。\nテアは宝石、金や宝石、ドラゴンの卵、ユニコーンの角など、珍しい宝物を好む。\nモチーフは赤いバラといばら。\n\n構図はお好みで自由にデザインしてください。\n\nテアは首と胸にほくろがあります。\n\n使用用途：sns、oc活動、個人的な閲覧のみを目的とした画像の印刷の可能性。\nいずれにせよ、このリクエストを読んでくれてありがとう！\n\nhttps://drive.google.com/drive/folders/1i7dZe2JW2RYsGn_dZSbVbeAyz1NeAQuf?usp=sharing", "nc": 0, "word_count": 0, "transc