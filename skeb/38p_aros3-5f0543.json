-43d0-9d19-e1119b824ce5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6e3f1bcb33ca6b8501aa1ed4eb258916", "srcset": "https://si.imgix.net/1bd75ed8/uploads/origins/06daa157-8cc1-43d0-9d19-e1119b824ce5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6e3f1bcb33ca6b8501aa1ed4eb258916, https://si.imgix.net/1bd75ed8/uploads/origins/06daa157-8cc1-43d0-9d19-e1119b824ce5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=30cc21299550db22a99d5ebd34839b76 2x, https://si.imgix.net/1bd75ed8/uploads/origins/06daa157-8cc1-43d0-9d19-e1119b824ce5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=46cd6a06402e587d5b12b8c865d9d16d 3x"}, "body": "こんばんは、\nメッセージありがとうございます…！\n\nぜひ描いて頂ければ嬉しく思います…！\nキャラクターは有栖川純夏という女の子をお願いしたいです…！\n\n▽キャラについて\n好奇心や探究心が旺盛。面白いことが好き。\n何事もやってみるのが大事と考え、手を出した事や出そうとした事が沢山ある。\n日々楽しい事や心踊る事を探している。\n\n▽シチュエーション\n澄んだ青い空の下(朝かな…)、前を歩いていた彼女が振り返って、笑顔で、だけど少し眉尻を下げて、なにか一言呟いている感じでお願いしたいです…！\n(可能であれば周りにクラゲが浮かんでいると嬉しいです…！)\n\n資料URLに参考画像をお送りします。\nお手すきになられましたら、よろしくお願いします…！\n\n▽仕様用途\n個人的な鑑賞\n友人との鑑賞\nSNSのアイコンなど\nキャラの参考画像としてドロップボックスへの保存\n\nhttps://www.dropbox.com/sh/8s39086chf145v7/AACNwGm7s953fk50BEAyfk1Oa?dl=0", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@hu__________san/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2123003, "client_id": 2636387, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/d7f88997/uploads/origins/6b33a147-1534-4385-bbfb-d5aa68f0c6ec?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fc1fae4f506554af718fccb311dafbbc", "srcset": "https://si.imgix.net/d7f88997/uploads/origins/6b33a147-1534-4385-bbfb-d5aa68f0c6ec?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fc1fae4f506554af718fccb311dafbbc, https://si.imgix.net/d7f88997/uploads/origins/6b33a147-1534-4385-bbfb-d5aa68f0c6ec?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a228b9ea3277d8a46c442ada38b84cc2 2x, https://si.imgix.net/d7f88997/uploads/origins/6b33a147-1534-4385-bbfb-d5aa68f0c6ec?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=7011eb943c6c2a940e6f8ee797afd520 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/d7f88997/uploads/origins/6b33a147-1534-4385-bbfb-d5aa68f0c6ec?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=36cc3bd801431624ff2dfa8eed829137", "srcset": "https://si.imgix.net/d7f88997/uploads/origins/6b33a147-1534-4385-bbfb-d5aa68f0c6ec?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=36cc3bd801431624ff2dfa8eed829137, https://si.imgix.net/d7f88997/uploads/origins/6b33a147-1534-4385-bbfb-d5aa68f0c6ec?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=a5e3ab5ad523ac5a58039f92e7300b93 2x, https://si.imgix.net/d7f88997/uploads/origins/6b33a147-1534-4385-bbfb-d5aa68f0c6ec?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=aead77203ba091c45bb6839864c9d065 3x"}, "body": "はじめまして、こんにちは。\nいつもイラスト拝見しています！\nとても好みの絵柄をされていて、メーカーではとてもお世話になっています…！\n\n今回は昔さんに私のPCを描いて頂けたらと、リクエストさせて頂きました！\n\n▼キャラについて\n出身は『庭師は何を口遊む』のHO4で、\n明るく元気な僕っ娘です。\n同じ班員の事を心から大切にし、守りたいと願っています。\n興味ある事にはまっすぐで一生懸命だが、時々周りが見えなくなり先を案じなくなるのが短所。\n長所は笑顔と明るさと、物事から目を逸らさずにまっすぐ向き合う所。\n\n▼シチュエーション\n7月7日生まれの夏が似合いそうな子だと思っており、誕生花は梔子の花で似合いそうな花はひまわりかなと個人的に思っていまして…\nそんな花や植物たちに囲まれて笑っている彼女を見たく思います…！\n構図などはおまかせしたいです。\n\n資料URLに参考画像をお送りします。\nお時間が作れましたら、ぜひともよろしくお願いいたします…！\n\n▼使用用途\n個人的な鑑賞\n友人との鑑賞\nキャラの参考画像としてドロップボックスへの保存\n\nhttps://www.dropbox.com/sh/yavqbyr57k67kf9/AADQIwnTXImeJNHWjpIDfozMa?dl=0\n\nhttps://www.dropbox.com/sh/yavqbyr57k67kf9/AADQIwnTXImeJNHWjpIDfozMa?dl=0", "nc": 129, "word_count": 0, "transcoder": "image", "creator_ac