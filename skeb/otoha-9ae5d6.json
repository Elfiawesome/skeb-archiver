-476b-a77c-cbf6733ca961?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=8bf5fcb43eb0ffb51ee76273d088c445 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/6a053ebf/uploads/origins/1b0930ff-9d71-476b-a77c-cbf6733ca961?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=30716e0d6b99a5508ed417595dcc6678", "srcset": "https://si.imgix.net/6a053ebf/uploads/origins/1b0930ff-9d71-476b-a77c-cbf6733ca961?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=30716e0d6b99a5508ed417595dcc6678, https://si.imgix.net/6a053ebf/uploads/origins/1b0930ff-9d71-476b-a77c-cbf6733ca961?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=08197ee2867fbf4ec012aa2d2d0f237e 2x, https://si.imgix.net/6a053ebf/uploads/origins/1b0930ff-9d71-476b-a77c-cbf6733ca961?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=81210e742a63e56d0ead5d8d5695a893 3x"}, "body": "Otoha(鳴深)さま、ココナラではお世話になりました。こちらでははじめまして、JINKOと申します。イラストリクエストのお願いです。ゲーム「ワンダープロジェクトJ」シリーズの続編の内容を想像する同人誌のカラー挿絵のご依頼をさせていただきたくメッセージいたしました。ある夜の草原で、12〜13歳の栗色のポニーテールに鳶色の瞳の少女(IMG_8632.PNGの右）が涙を流していると、命を散らした意中の少年ロボットの全てのパーツが、たくさんのモルフォ蝶（普通のモルフォ蝶よりも脚が少し長い）のような小型ロボットたちと、少しのネオンのような光の蝶8匹になって（赤、黄色、紫、黄緑、ピンク、白、オレンジ色、エメラルド色）現れ、慰めるように飛んでくるという内容です。少女のどちらかの肩にエメラルド色の蝶がとまり、真っ赤なまま炎のように燃えている蝶が少女のくちびるにとまっている（でも風邪をひいた人肌程度の温かさ）感じでお願いいたします。ネオン蝶はIMG_9502.PNGのような感じで描線を光らせるようにお願いしたいのですが、ご負担でしたら9430.jpgや9431.jpgのように単純化していただいて大丈夫です。 何卒よろしくお願い申し上げます。 https://drive.google.com/drive/folders/1xB9GcLWq5zia5RDIId8oy4xOcoQI-hgZ\n\nhttps://drive.google.com/drive/folders/1xB9GcLWq5zia5RDIId8oy4xOcoQI-hgZ", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@otoha/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 135788, "client_id": 89253, "vtt_u