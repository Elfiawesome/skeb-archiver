ウェイトレス衣装（上の段、左から３番目）で全身、立ち姿で\nバレンタインチョコをこちらにプレゼントしているイラストを描いて\nいただけないでしょうか。\n目線はカメラ目線でこちら向き、サービス精神旺盛な感じでウェイトレスをしている\nしゅうかがチョコをお客にプレゼント、というイメージです。\n\nまたもし可能でしたら、チョコを持つ代わりにスカートを持ち上げて\nたくし上げにしてパンチラ（おへそ見えるぐらいパンモロぎみ）\nしている差分のレイヤーを描いていただけるととても嬉しいです。\nお金をはずんだ上客に、パンチラをサービスといったイメージです。\n流石に恥ずかしそうな表情差分で描いていただけるととても\n嬉しいです。\n\npsd納品していただければと\nいろいろリクエスト恐縮なのですが、ご検討よろしくお願いいたします。\n\n大変お忙しいところ申し訳ありません。難しいようでしたら、本リクエストは拒否していただいて構いませんのでよろしくお願い致します。", "nc": 33, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@kshmtyan/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 250523, "client_id": 814883, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/47d3f210/uploads/origins/c9bcfd75-8046-45a8-92a4-348436c72c67?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fde870be2e65a758a974524dd816c793", "srcset": "https://si.imgix.net/47d3f210/uploads/origins/c9bcfd75-8046-45a8-92a4-348436c72c67?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fde870be2e65a758a974524dd816c793, https://si.imgix.net/47d3f210/uploads/origins/c9bcfd75-8046-45a8-92a4-348436c72c67?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=1eab0f20768801d716c9795b66f247ee 2x, https://si.imgix.net/47d3f210/uploads/origins/c9bcfd75-8046-45a8-92a4-348436c72c67?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=703a9ba6b75ee1f5b4b5ffffc406e25c 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/47d3f210/uploads/origins/c9bcfd75-8046-45a8-92a4-348436c72c67?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=803e12ebe49e89b1e6e3143b43be5428", "srcset": "https://si.imgix.net/47d3f210/uploads/origins/c9bcfd75-8046-45a8-92a4-348436c72c67?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s