sored_thumbnail_image_urls": {"src": "https://si.imgix.net/0d732355/uploads/origins/954b0147-7ab8-4557-b1e6-6e01d3020444?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c5453f4749d54dcf9662c3d0492c86a4", "srcset": "https://si.imgix.net/0d732355/uploads/origins/954b0147-7ab8-4557-b1e6-6e01d3020444?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c5453f4749d54dcf9662c3d0492c86a4, https://si.imgix.net/0d732355/uploads/origins/954b0147-7ab8-4557-b1e6-6e01d3020444?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=74120789eb8f9474de48b2e104269bcf 2x, https://si.imgix.net/0d732355/uploads/origins/954b0147-7ab8-4557-b1e6-6e01d3020444?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=1499f073a0f93f1445254ea6f196f56c 3x"}, "body": "初めまして、個人でVtuber活動をしているまろやか牛乳と申します。\nSkebの新着アカウント一覧を吟味している際に、どしたん亭話聞こかさんの事を見つけました。\nそこからtumblrとTwitterのイラストを見させていただき、ほんわかした雰囲気と顔の可愛さに惹かれリクエストを送らせていただきました。\n今回は自分のVtuberモデルのイラストを描いていただきたいと思っております。\n\n【キャラクターデザイン】\nむちむち体系の牛耳の女の子です。\n片手か両手に腰に付けている牛乳瓶を持たせていただけますでしょうか。\n背景を書き込まれる場合は牧場にしていただきたいです。(※背景は描きこまなくても問題ございません。)\nそれ以外のポーズやシチュエーションに関しては特に指定はございません。\n資料URLに立ち絵を掲載しておりますので、そちらを参考に描いてください。\n\n【使用用途】\n・Youtubeの動画サムネイル\n・Twitterに掲載するスケジュール\n・どしたん亭話聞こかさんの描かれるお顔が大好きなので、\n　SNSのヘッダー等にも使用する可能性がございます。\n\n【データの内容】\n1920×1080以上であればサイズ指定はございません。\nサムネイル等に使用する可能性もあるため、髪の毛の先や指の先が切れていない構図ですと大変助かります。\nまた、納品データはPSDファイルでお願いしてもよろしいでしょうか。\nPSDの中身に関しまして、文字・人物・背景で分けていただけますと幸いです。\n\n上記問題ございませんでしたら是非ご検討ください。\n何卒よろしくお願いいたします。\n\nhttps://drive.google.com/file/d/1VP-_wf9phy0h6xM0nx3uzjijxmIQUug5/view?usp=sharing", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 373990, "creator": true, "nsfw_acceptable": false, "acceptable": false, "name": "ソウヘイ", "screen_name": "dokoka_me", "avatar_url": "https://cdn.bsky.app/img/avatar/plain/did:plc:nqva6j3mogdn73zg