=200&blur=200&s=55154c58be963fa2fd19e66cecc9399d", "srcset": "https://si.imgix.net/40e53b72/uploads/origins/9edc3046-8d97-4470-8ec5-1ab6af66cc6d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=55154c58be963fa2fd19e66cecc9399d, https://si.imgix.net/40e53b72/uploads/origins/9edc3046-8d97-4470-8ec5-1ab6af66cc6d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=83195072b8580617b1443bd8fedff5a1 2x, https://si.imgix.net/40e53b72/uploads/origins/9edc3046-8d97-4470-8ec5-1ab6af66cc6d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=bd44f6197929b5b892946edb293bad4d 3x"}, "body": "初めまして。 \nアピールありがとうございます！\n\nVtuberとして活動している犬間アネモネと申します。  \n絵柄がほんとにとても素敵で！ \n私、犬間アネモネのイラストを描いて頂きたいと思いご連絡いたしました。  \n\n\n ▷イラストの希望 \n戦闘ぽいイラストをお願いしたいです。\n腰に剣があるのでそちらで戦っているようなイメージがいいです。\n可愛いというよりはかっこいい、妖艶\nな雰囲気を希望いたします。\n髪の毛、衣装は長い方でも短い方でもどちらでも大丈夫です。\n\n▷使用目的 \nXでのポスト、ネップリ、配信にてサムネイル等に使用したいと考えております。 \n\n\n\nまた、キャラと背景を分けていただけますと幸いです。   \n\nご検討の程よろしくお願いいたします  \n\nhttps://x.com/inumaane/status/1887971569793999258?s=46&t=GjDId296NbdOUx-ckzZTmw\n\nhttps://x.com/inumaane/status/1649606468596023298?s=46&t=GjDId296NbdOUx-ckzZTmw", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@aida_ranran/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3599867, "client_id": 2611601, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/af6f8b5e/uploads/origins/21d29771-4e99-43f8-852f-9ebdbe8c8d51?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a09b7cda7fc4ad088c0f020f1f9101c4", "srcset": "https://si.imgix.net/af6f8b5e/uploads/origins/21d29771-4e99-43f8-852f-9ebdbe8c8d51?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a09b7cda7fc4ad088c0f020f1f9101c4, https://si.imgix.net/af6f8b5e/uploads/origins/21d29771-4e99-43f8-852f-9ebdbe8c8d51?bg=%23f