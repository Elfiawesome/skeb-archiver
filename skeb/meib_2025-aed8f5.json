rop=top&w=200&h=200&blur=200&s=cb1ad0534bf00067d6d5d5018c2ca708 2x, https://si.imgix.net/ac62f6a8/uploads/origins/a6a11d67-e084-4005-8df2-3e6fbf47bdc7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=8a9c767bda615d211483576d81917bae 3x"}, "body": "こんにちは。私のキャラクターを描いていただけないでしょうか。\n\n彼女の名前はマーゲで、40歳の元研究者です。普段は冷静で厳格な印象ですが、実は可愛いものが大好きで、暇な時はぬいぐるみを集めています。\n\nマーゲはパジャマ姿で、スライムのぬいぐるみを抱えている姿にしてください。\n\nキャラクターの参考画像⮟\nhttps://imgchest.com/p/5xy22pmonyl\n\nご依頼をご検討いただき、ありがとうございます。", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@meib_2025/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3939980, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/aeb27a48/uploads/origins/662583d9-6586-4015-ba58-8364265a4551?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e35ee42a4666775f54d59f374b458c07", "srcset": "https://si.imgix.net/aeb27a48/uploads/origins/662583d9-6586-4015-ba58-8364265a4551?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e35ee42a4666775f54d59f374b458c07, https://si.imgix.net/aeb27a48/uploads/origins/662583d9-6586-4015-ba58-8364265a4551?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f203157b3a813f0818e30b88f3f93aa4 2x, https://si.imgix.net/aeb27a48/uploads/origins/662583d9-6586-4015-ba58-8364265a4551?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=613a9e6323c174f6ea63160bd2c05a36 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/aeb27a48/uploads/origins/662583d9-6586-4015-ba58-8364265a4551?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=8af052b5488868cfe977d19a9a6331c3", "srcset": "https://si.imgix.net/aeb27a48/uploads/origins/662583d9-6586-4015-ba58-8364265a4551?bg=%23fff&auto=format%2Ccom