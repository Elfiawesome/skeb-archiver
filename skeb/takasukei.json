s/26", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1214268, "client_id": 3603517, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/bb27af38/uploads/origins/05060c4e-bd58-475b-a39f-80bee8c03b1a?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&s=964b6a531c68ecacbfedf3817845f348", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/bb27af38/uploads/origins/05060c4e-bd58-475b-a39f-80bee8c03b1a?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&blur=200&s=2643d188e6b0aebe7d9fc2ce61e0ec08", "src_set": ""}, "body": "はじめまして！あなたのピクセルアートが大好きです！\n\n私のVtuberアバターのループアニメーションをお願いしたいです。今後の配信の待ち受け画面として使いたいです。\n\n彼女はサイバーパンクの世界の出身で、半分メカで半分人間です。彼女の衣装、ポーズ、表情は自由にデザインできます。完全に自由な創作が可能です。\n\nキャラクター\nhttps://drive.google.com/file/d/1orl7j28mIe_fFSktf3z_81d1krzMjcaW/view?usp=sharing\n\nありがとうございました！", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@takasukei/works/25", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1214268, "client_id": 0, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/ca53bf36/uploads/origins/7f64d779-b8be-44d7-8cce-9611e8b10046?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&s=076b21b921e8fb4607a79de04739fb79", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/ca53bf36/uploads/origins/7f64d779-b8be-44d7-8cce-9611e8b10046?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&blur=200&s=180e84283c67df98f96dd501c1787c4c", "src_set": ""}, "body": "こんにちは、先生\nあなたのピクセルワークが好きで、できればループ可能なgif/ビデオのリクエストを送りたかったのです。\n\n背景は透明かブランクかグリーンスクリーンで、どちらでも構いません。  画面サイズに合わせて1920x1080で。もしもっとJPYが必要なら、アピールしてください！\n\nこの動画のランサイクルのように、5人のキャラクターが走る（ループする）のをお願いしたい。https://x.com/trinitymul53186/status/1898514789325840553\n\nセーラームーン、セーラーマーキュリー、セーラーマーズ、セーラージュピター、セーラーヴィーナスの衣装とヘアスタイルで、私のocがループビデオでこのように走っているように黒い肌をして欲しい https://x.com/trinitymul53186/status/1898514789325840553\n\n私のocはこちら https://x.com/Tninity_/status/1895977021286875409\nsailor scouts https://x.com/trinitymul53186/status/1898516135877972081", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@takasukei/works/24", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/9e22b932/uploads/origins/afe1097d-ff2f-444d-a77f-f41f92e6602a?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=26d3c9501a1a6d8787339969b2617e69", "src_set": ""}, "private": true, "genre": "art", "tipped": true, "creator_id": 1214268, "client_id": 0, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 48, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@takasukei/works/23", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/a560e875/uploads/origins/177550d9-df96-4a1b-9b74-b4afbb1e9e98?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=15b78440fbf7fd108b06c2375332a2ea", "src_set": ""}, "private": true, "genre": "art", "tipped": true, "creator_id": 1214268, "client_id": 0, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 128, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@takasukei/works/22", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/853c2e95/uploads/origins/c5320b78-3fde-491a-8e87-b8c9e3ce592e?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&