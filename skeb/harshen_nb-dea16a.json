2d-f0e2-488d-a34d-ef45ef4f6de3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=355afc248a30c68d767e943952e78865", "srcset": "https://si.imgix.net/3590b671/uploads/origins/89a36a2d-f0e2-488d-a34d-ef45ef4f6de3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=355afc248a30c68d767e943952e78865, https://si.imgix.net/3590b671/uploads/origins/89a36a2d-f0e2-488d-a34d-ef45ef4f6de3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=8eb74f5c252bf07832597618fc7b057f 2x, https://si.imgix.net/3590b671/uploads/origins/89a36a2d-f0e2-488d-a34d-ef45ef4f6de3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=af8cd8e085003dab255e731ea10c6b64 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/3590b671/uploads/origins/89a36a2d-f0e2-488d-a34d-ef45ef4f6de3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=078c0bcfe0e168f6441f451b79403436", "srcset": "https://si.imgix.net/3590b671/uploads/origins/89a36a2d-f0e2-488d-a34d-ef45ef4f6de3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=078c0bcfe0e168f6441f451b79403436, https://si.imgix.net/3590b671/uploads/origins/89a36a2d-f0e2-488d-a34d-ef45ef4f6de3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=b1f8a684b7c9fa0fee992f9f2dcd04ae 2x, https://si.imgix.net/3590b671/uploads/origins/89a36a2d-f0e2-488d-a34d-ef45ef4f6de3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=57e0ffd0c848478116106e0a81cf3f2a 3x"}, "body": "こんにちは。 受けていただけるか分かりませんが、リクエストをさせていただきます。  \n\n概要 \n下の画像の女の子(朝倉由夢)が、ポケモンのルージュラのあくまのキッス(キスして眠らせる技)で眠らされるテキスト。  \n\n細かなとこ \n由夢は段ボールに入って道に捨てられている(本来はこの子の登場作品の主人公に拾われるのを待っている)のですが、そこへルージュラが来て、捨て猫と勘違いして連れ帰ろうとするけれど由夢が抵抗、拒否するので、眠らせるために、がっちり掴んで無理矢理あくまのキッスをする…みたいな感じでお願いしたく存じます。  \n\nルージュラは人の言葉を発さず鳴き声のみで、ぬぼーっと無表情、由夢よりもだいぶ体がおっきくて力も強い感じ、唇も由夢の顔面を丸ごと包み込めるくらいおっきく分厚い感じで…真正面から包み込んだ顔面を思い切りバキュームするようなキスをお願いしたく思います。  \n\nこの由夢は性格的には特に特徴などはないと言いますが、いわゆる普通の子だと思います…。 人の言葉は話せず、にゃーとかふしゃーとか猫語のみを発するキャラです。\n\n …もし可能であれば、迫る気持ちの悪い唇に由夢が怯える描写や、ルージュラの唇にルージュが塗られている描写もいただけると嬉しいです…可能であれば…。   \n\n以上になります。申し訳ありません、テキストの依頼が初めてで至らぬ点もあるかも知れませんが…どうかご一考いただければ幸いと存じます。  \n\n 由夢\n https://thup.work/miniup/?mode=dl&id=9673  \n\nhttps://thup.work/miniup/?\nmode=dl&id=9672  \n\nhttps://thup.work/miniup/?mode=dl&id=9671", "nc": 41, "word_count": 3500, "transcoder": "text", "creator_acceptable_same_genre": true}, {"path": "/@harshen_nb/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "novel", "tipped": true, "creator_id": 89012, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/57bf91c2/uploads/origins/165d07e6-839c-49ae-ab71-3d75361897af?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d1671d8a139728ceaec8ea20dd531064", "srcset": "https://si.imgix.net/57bf91c2/uploads/origins/165d07e6-839c-49ae-ab71-3d75361897af?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d1671d8a139728ceaec8ea20dd531064, https://si.imgix.net/57bf91c2/uploads/origins/165d07e6-839c-49ae-ab71-3d75361897af?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=9cfc2a94be1dc1a19dbba0c761223037 2x, https://si.imgix.net/57bf91c2/uploads/origins/165d07e6-839c-49ae-ab71-3d75361897af?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=9a07ec0c3b07d8800611ef7d345adb63 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/57bf91c2/uploads/origins/165d07e6-839c-49ae-ab71-3d75361897af?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=fe95bba15913837f538aeae8f32822aa", "srcset": "https://si.imgix.net/57bf91c2/uploads/origins/165d07e6-839c-49ae-ab71-3d75361897af?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=fe