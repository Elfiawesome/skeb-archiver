=200&h=200&blur=200&s=a144aec8d7c2f449289979fc30a84907", "srcset": "https://si.imgix.net/b7a42316/uploads/origins/7d7e270a-201f-44ca-9081-003126b67d9d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a144aec8d7c2f449289979fc30a84907, https://si.imgix.net/b7a42316/uploads/origins/7d7e270a-201f-44ca-9081-003126b67d9d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=0ae8869d73b970f748d4aead682e8a5c 2x, https://si.imgix.net/b7a42316/uploads/origins/7d7e270a-201f-44ca-9081-003126b67d9d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=6ef86f36a0a4fcf646751a74cb7def47 3x"}, "body": "初めまして❀\n配信アプリ｢IRIAM｣で活動中の ぴてやん と申します。 \nYurayura様のイラストを拝見し、絵のタッチや可愛らしい雰囲気がとても素敵で惹かれ、ぜひお願いしたくリクエストを送らせていただきました。\n\n  【リクエスト内容】 \n金額の範囲内でイラストをお願いしたいです(⋆ᴗ͈ˬᴗ͈)” 基本の服装は参考画像のものになりますが、服の着脱・アレンジ・構図・比率などは自由にしていただいて大丈夫です。\n\n 【キャラクター詳細】 \n・髪：薄ピンク＋右手側に薄黄色メッシュ、ゆるめ三つ編み→ツインテール \n・瞳：黄色、ややタレ目 ・カラー：メイン・ピンク／サブ・水色・白\n ・FM：🎀💕🎶 \n・体型：胸は控えめ \n・雰囲気：可愛い系、歌メインで活動するキャラ \n\n 【使用用途】\n 配信活動全般で使用します。 \n・IRIAM（アイコン、サムネイル） \n・配信上の返礼品（デジタルグッズ、アイコンリング、ヘッダー、リアルグッズ など）  (サイトでの販売は行いません)\n\n【納品形式】 \n･背景と人物を分けたデータもご用意いただけると助かります。\n ･サムネイル等での使用も想定しているため、頭頂部や端が見切れないようにしていただけると大変ありがたいです。 \n\n【その他】 \n・料金が不足する場合や、使用用途で不可の点がある場合は、再送リクエストしていただければ対応いたします。 \n・クレジット表記は、X投稿の際に @Pite_02_yaan を明記します。  \n\nご検討いただけますと幸いです✨ どうぞよろしくお願いいたします。\n\nhttps://drive.google.com/file/d/1lkowcisiwDnSQ8uq-Uk3Bn-veEhX6ofe/view?usp=", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@yuragikasuka/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3787729, "client_id": 3148464, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/15b04b17/uploads/origins/43e57cdd-f242-4544-9c3c-aaa5746e9634?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=13ab0964df3990ef6ec9dd147488a9d3", "srcset": "https://si.imgix.net/15b04b17/uploads/origins/43e57cdd-f242-4544-9c3c-aaa5746e9634?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=13ab0964df3990ef6ec9dd147488a9d3, https://si.imgix.net/15b04b17/uploads/origins/43e57cdd-f242-4544-9c3c-aaa5746e9634?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=31d5f6d4ade9cba1a09de204caabce46 2x, https://si.imgix.net/15b04b17/uploads/origins/43e57cdd-f242-4544-9c3c-aaa5746e9634?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=139f7153a2ad86425015c2e302e1ad3b 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/15b04b17/uploads/origins/43e57cdd-f242-4544-9c3c-aaa5746e9634?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ccad277347b58e00299ad2ed798cce77", "srcset": "https://si.imgix.net/15b04b17/uploads/origins/43e57cdd-f242-4544-9c3c-aaa5746e9634?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ccad277347b58e00299ad2ed798cce77, https://si.imgix.net/15b04b17/uploads/origins/43e57cdd-f242-4544-9c3c-aaa5746e9634?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=9749cb1525bb5c7c4948b3b9158c351a 2x, https://si.imgix.net/15b04b17/uploads/origins/43e57cdd-f242-4544-9c3c-aaa5746e9634?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=243be29bc8bd6eae175ddf5f1b2369df 3x"}, "body": "𝕐𝕦𝕣𝕒𝕪𝕦𝕣𝕒 様\nはじめまして、みつなつと申します。\nＸで可愛らしい女の子のイラストが目にとまり、私のVtuberの姿も描いていただきたくてリクエストをいたします！\n私は読書系の個人VtuberとしてYouTubeで活動しています。\n穏やかで落ち着いたほのぼのタイプのキャラクターです。\n\nこのたび新しいＶモデルが完成したので、ぜひ描いていただけると嬉しいです。\nマーガレットとひまわりの２つのモチーフのデザインがあるので、お好きな方をお願いします。\nhttps://drive.google.com/file/d/1lk1mBgWtdT1KfK-IjMt_wwE-tPYZE_Rr/view?usp=sharing\nhttps://drive.google.com/file/d/1ZB-ZV20rFe58FCB2Jpb4Z7FVSBHO-S_J/view?usp=sharing\n\n【服装など】\n・服装はマーガレットでもひまわりでも、お好みの方をお願いします。\n・髪型はツインテール・お団子などバリエーションあるのでお好みのものを。\n・マスコットのオバケもつけていただけるととっても嬉しいです。\n\n【使用用途】\nYouTubeのサムネイルや動画、企画告知画像や週間スケジュールでの使用、SNSのアイコンなど活動用\n\n【構図・ポーズ・表情・背景など】\nポーズ等はすべてお任せします。\n背景透過の人物のみのデータもいただけると嬉しいです。\n\nご検討いただければ幸いです！", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@yuragikasuka/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3787729, "client_id": 2921851, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/eaf187fc/uploads/origins/1427db46-4396-47ff-ae34-67fc76d25c3f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=945e3785706fd4bef54f88ef93912ecf", "srcset": "https://si.imgix.net/eaf187fc/uploads/origins/1427db46-4396-47ff-ae34-67fc76d25c3f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=945e3785706fd4bef54f88ef93912ecf, https://si.imgix.net/eaf187fc/uploads/origins/1427db46-4396-47ff-ae34-67fc76d25c3f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=95cbb506cbc921cd76ec227f482a3194 2x, https://si.imgix.net/eaf187fc/uploads/origins/1427db46-4396-47ff-ae34-67fc76d25c3f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c02b82b86851e76411438833b469e72c 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/eaf187fc/uploads/origins/1427db46-4396-47ff-ae34-67fc76d25c3f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=bf394aff101c9e0d5715cb8cc00d14d6", "srcset": "https://si.imgix.net/eaf187fc/uploads/origins/1427db46-4396-47ff-ae34-67fc76d25c3f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=bf394aff101c9e0d5715cb8cc00d14d6, https://si.imgix.net/eaf187fc/uploads/origins/1427db46-4396-47ff-ae34-67fc76d25c3f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=9180020ec911e2f16b241c5e427bf68c 2x, https://si.imgix.net/eaf187fc/uploads/origins/1427db46-4396-47ff-ae34-67fc76d25c3f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=fb06e53372504c63ce093f1c4b206a2a 3x"}, "body": "初めまして\nYouTubeとツイッチで個人配信活動をしているチャナと申します。\n新着イラストでお見掛けした、ゆらゆら様の描かれる女の子がとっても可愛く、目を惹かれました。\nかわいいが画面全体にちりばめられたようなデザインや、キャラクターがとても素敵で、ぜひ私自身のキャラクターも描いていただきたく思い、リクエストをお送りしました。\n\n【使用用途】\n･SNSでの掲載\n･動画･配信内での使用、サムネイル画像としてなど、配信活動での使用\n･リスナーへのネットプリント配布\n･グッズ販売等の商用利用\n\nを予定しており、許可を頂きたいです。YouTube、ツイッチ共に収益化済です。\n\n【イラストについて】\n･描いていただきたいのはチャナ自身のキャラクター\n･水色(青色)の髪に、三日月形の黒メッシュが特徴になっています。\n\nゆらゆら様の描かれる女の子の雰囲気や衣装がとても可愛いので、髪型、服装、構図等すべてをおまかせいたします。\nひとつお願いがあり、頭の被り物（帽子系）を被っていないイラストをお願いします、リボン等の髪飾りは問題ありません。\nサムネイル等に使用する都合により、可能であれば人物の上左右が見切れていないものですと助かります。\n\n【参考資料】\n明確な資料がなくお手数をおかけします。\n\n❶https://x.com/cha_na_ch/status/2022836797068153177/photo/1\n❷https://x.com/ano80712/status/1812775324234719376\n❸https://x.com/cha_na_ch/status/1800714603351228593/photo/1\n❹https://x.com/ano80712/status/1880631242808340708\n\n不明な点はすべておまかせいたしますので、何卒お願いいたします。\n\n【ファイル形式】\nPSDまたはPNGで、 文字、背景を分けた人物のみの状態（背景は透過）　も納品いただけますと大変助かります。\n金額等に 不足があればお手数ですが、キャンセルまたは再送頂けますと幸いです。", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@yuragikasuka/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3787729, "client_id": 136055, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/6a6d2739/uploads/origins/1afe4f7d-52cc-4286-a778-b76c75f6d2a1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=85d6784732a31c999db4ba2b5c0cd51a", "srcset": "https://si.imgix.net/6a6d2739/uploads/origins/1afe4f7d-52cc-4286-a778-b76c75f6d2a1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=85d6784732a31c999db4ba2b5c0cd51a, https://si.imgix.net/6a6d2739/uploads/origins/1afe4f7d-52cc-4286-a778-b76c75f6d2a1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c