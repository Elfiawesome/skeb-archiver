%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=05ae6852fcec8635d5e17096eecff88a", "src_set": ""}, "body": "はじめまして。\n以前描かれていた武装JKイラストを拝見し、興味を惹かれたのでこの度依頼させていただきます。\n\n今回描いて欲しい内容は次の通りです。\n・キャラ\n可愛らしい感じのオリジナルキャラクターで、デザインなどはお任せします。\n・衣装\nセーラー服感のあるスク水や競泳水着を着用し、セーラー帽を被っている。\n防弾チョッキやマガジンポーチなどの装備は着けていない平時の状態でお願いします。\nまた水着のイメージとしては下記のとおりです。\nhttps://www.pixiv.net/artworks/95026369\nhttps://www.pixiv.net/artworks/97015495\nイメージとしては海上での作戦に従事する武装JKちゃんで、海での活動を考慮して制服兼水着としての衣装として採用された感じです。\n\n・ポージング\nアサルトライフルを立て銃の姿勢で構えている状態。\nただ何か訓練で号令がある状態ではなく、無意識にビシッとしてしまっているだけで特に緊張感がある場面ではない雰囲気でお願いします。\n（なので表情とかニコっとした笑顔とかでも全然大丈夫です）\n\n・背景\n海などの水辺っぽい雰囲気であれば大丈夫です。（海辺や船の上など特に指定はありません）\nなんなら青色系の無地の背景でも問題ないです。\n\n以上の内容で、特に指定のない部分などについてはお任せします。\n以上の内容で依頼させていただきますので、よろしくお願いします。", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Lv729798641/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 299608, "client_id": 253119, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/40096c4c/uploads/origins/6c4350d6-78b4-44bf-abeb-73d511c2c640?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=82d283300e27084a3a2fb04c36fa4515", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/40096c4c/uploads/origins/6c4350d6-78b4-44bf-abeb-73d511c2c640?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=83655866fc426fc0eb188e94d15507b4", "src_set": ""}, "body": "はじめまして、新着作品に惹かれましてリクエストいたします。\n参考資料のキャラクターを描いていただけますでしょうか?。\n\n○キャラクターの設定\n・武装JKという設定のキャラクターです。\n・制服の下に戦闘用のインナーを着ております。\n・黒髪ロングで、髪の裏側は碧色になっております。\n\n構図といたしましては、銃を持っている立ち姿や構えている姿をお願いできますでしょうか。\n衣装つきましては、ご自由にご変更ください。\nいかがでしょうか、ご検討の程をよろしくお願いいたします。\n\nhttps://imgur.com/a/HSnjn01", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Lv729798641/works/2",