ーツの代わりにノワールは白、ルビーは黒ののスリングショット(Ｖ字水着)を着せてください。\n\n参考\nhttps://skeb.jp/@0000ong/works/23\nhttps://skeb.jp/@allA_kgk/works/18\nhttps://skeb.jp/@HuVZO3HVziY76xS/works/4\n\n二人とも巨乳ですが、爆乳に割り増しをして巨乳輪のパフィーニップル化させてスリングショットに収まり切らずほとんど乳輪がはみ出してしまってるようにお願いします。\nまた可能であれば裸差分などは可能でしょうか。\n\n個人的趣味優先のリクエストでご面倒おかけいたしますが御一考の程お願い致します。", "nc": 177, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@bnnn0508/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1125404, "client_id": 459617, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/83e0d463/uploads/origins/216c7aa9-7894-45b5-a16f-9e28b4649d29?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5de7ad9173e5008499a4ab398a07cd7b", "srcset": "https://si.imgix.net/83e0d463/uploads/origins/216c7aa9-7894-45b5-a16f-9e28b4649d29?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5de7ad9173e5008499a4ab398a07cd7b, https://si.imgix.net/83e0d463/uploads/origins/216c7aa9-7894-45b5-a16f-9e28b4649d29?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=13111b00c868e246aaae1b3f4376dcb3 2x, https://si.imgix.net/83e0d463/uploads/origins/216c7aa9-7894-45b5-a16f-9e28b4649d29?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e0f05a7154ae4d7506dedd6ccd82df62 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/83e0d463/uploads/origins/216c7aa9-7894-45b5-a16f-9e28b4649d29?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3b5c6b0ebdffbd02f73daa854afea183", "srcset": "https://si.imgix.net/83e0d463/uploads/origins/216c7aa9-7894-45b5-a16f-9e28b4649d29?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3b5c6b0ebdffbd02f73daa854afea183, https://si.imgix.net/83e0d463/uploads/origins/216c7aa9-7894-45b5-a16f-9e28b4649d29?