unt": 0, "received_works": [{"path": "/@milotot_/works/9", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2424813, "client_id": 101271, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/7566a51f/uploads/origins/ac21a89d-f654-41b7-bce1-0ad2aed8f7ef?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e876cd5c7d2bf94c2d4c1d0d1bd4ab73", "srcset": "https://si.imgix.net/7566a51f/uploads/origins/ac21a89d-f654-41b7-bce1-0ad2aed8f7ef?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e876cd5c7d2bf94c2d4c1d0d1bd4ab73, https://si.imgix.net/7566a51f/uploads/origins/ac21a89d-f654-41b7-bce1-0ad2aed8f7ef?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=6a3aae3a96cae2aa63f9d7ba89980c2e 2x, https://si.imgix.net/7566a51f/uploads/origins/ac21a89d-f654-41b7-bce1-0ad2aed8f7ef?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=09da6776a3291a933533678c25d2c3fb 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/7566a51f/uploads/origins/ac21a89d-f654-41b7-bce1-0ad2aed8f7ef?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3d845d4804be04421856155bd1a1111a", "srcset": "https://si.imgix.net/7566a51f/uploads/origins/ac21a89d-f654-41b7-bce1-0ad2aed8f7ef?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3d845d4804be04421856155bd1a1111a, https://si.imgix.net/7566a51f/uploads/origins/ac21a89d-f654-41b7-bce1-0ad2aed8f7ef?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=6a22bc71016bd7fabf63bdeb77b7d8fa 2x, https://si.imgix.net/7566a51f/uploads/origins/ac21a89d-f654-41b7-bce1-0ad2aed8f7ef?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=fb3016b375f97fbbdbd3463859a700a6 3x"}, "body": "mimoeさん、前回の依頼の時は素敵なイラスト、本当にありがとうございました。\n\n2度目のリクエストとなるのですが、『ウマ娘 シンデレラグレイ』より遊佐よし子（コミックス第13巻第115Rから出てきた藤井泉助の後輩の人）のイラストをお願いできますでしょうか？\nシチュエーションとしては、彼女がアプリゲームの方の楽曲「めにしゅき・ラッシュっしゅ！」の専用衣装を着用の上で、同楽曲を踊っている（or踊らされてる）、という感じのシチュエーションを希望します。\n要望としては、遊佐よし子は多少ピキりながらも割とノリノリで踊っている感じにしてほしいのと、ギャラリーでペンライトを振ってノリノリで応援している藤井泉助も描いて欲しいこと（依頼のメインでは無いので作画カロリーを考慮して簡略化したりデフォルメされても大丈夫です）、参考出典の公式動画の中にも出てくるぬいぐるみを遊佐よし子を模したものとして小道具として配置してほしい点ですが、それ以外の細かいシチュエーション、背景、構図、その他の有無やアレンジなどについては完全にmimoeさんの裁量にお任せします。\nイラストの中で遊佐よし子に取らせる「めにしゅき・ラッシュっしゅ！」の振り付けについても、公式動画を見てmimoeさんが良さそうだと思ったものに一任します。\nあと遊佐よし子は現状、公式媒体におけるカラーイラストの類が無いキャラクターなので（もし何処かで既出でしたら済みません）、彩色についてもmimoeさんのセンスにお任せします。\n\n色々と忙しい日々を送られてると思われますが、もし良ければご検討して頂けると幸いです。\n\n↓参考出典\nゲーム【ウマ娘 プリティーダービー】ライブ動画「めにしゅき・ラッシュっしゅ！」ゲームサイズVer. - YouTube\nhttps://www.youtube.com/shorts/H4e2PiERauQ", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@milotot_/works/8", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2424813, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/d7cdd146/uploads/origins/40f17eea-6abb-4994-8287-62e8ad7eed5c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e0c9a0752f904c4e7b852d9bbd119d6c", "srcset": "https://si.imgix.net/d7cdd146/uploads/origins/40f17eea-6abb-4994-8287-62e8ad7eed5c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e0c9a0752f904c4e7b852d9bbd119d6c, https://si.imgix.net/d7cdd146/uploads/origins/40f17eea-6abb-4994-8287-62e8ad7eed5c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=adb59e72f4f4419f400471f503d6e4b6 2x, https://si.imgix.net/d7cdd146/uploads/origins/40f17eea-6abb-4994-8287-62e8ad7eed5c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d6818b5061f101875ce1b9de010e01f4 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/d7cdd146/uploads/origins/40f17eea-6ab