s/f281f097-5840-48fd-aad0-da0c619fcc2d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=b6795a8474dd5388e6f85e31f092fff4 3x"}, "body": "初めまして、個人VTuberをしております陽向こまと申します。skebで依頼先を探していたところ、雪臣様のイラストを拝見しまして、ぜひご依頼させて頂きたいと思いご連絡させて頂きました…！\n\n\n使用用途はYouTubeでの配信用サムネイルやＸなどでの広報、SNSでのアイコン使用等です。サムネイルなどに使用させて頂く兼ね合いで、上部と左右の身体は見切れていないと有難いです。また、もし背景も描いて頂いた場合は背景と人物を分けたファイルも頂戴出来れば幸いです。\n\n構図や表情に関しては、雪臣さんにお任せ致しますのでお好きに描いて頂きたいです。参考資料を添付致しますので、性格や衣装などはそちらを参考にご覧下さい。ケープや帽子を脱いだり、衣装をアレンジ頂いても構いません。\nまた、もしも可能であれば表情の差分をお願いする事は可能でしょうか。御検討頂けましたら幸いです。\n\nたくさんのご依頼があってご多忙かとは思いますが、何卒御検討の程お願い申し上げます。\n\nhttps://drive.google.com/drive/folders/1CFq9qsj1ok5FH-WFu2-YGyKb4zOyaG7N", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@yukiomi_frog/works/9", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3248540, "client_id": 1312932, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/a6a50257/uploads/origins/b32c4c63-9ca9-4a90-8bed-a7d463658591?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bb1193accfbbf2511af1584f516ec086", "srcset": "https://si.imgix.net/a6a50257/uploads/origins/b32c4c63-9ca9-4a90-8bed-a7d463658591?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bb1193accfbbf2511af1584f516ec086, https://si.imgix.net/a6a50257/uploads/origins/b32c4c63-9ca9-4a90-8bed-a7d463658591?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=9a9c4600725dbfbc6caf8425ed2b8978 2x, https://si.imgix.net/a6a50257/uploads/origins/b32c4c63-9ca9-4a90-8bed-a7d463658591?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=8e61f57820c4ab53b6b0690033337af5 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/a6a50257/uploads/origins/b32c4c63-9ca9-4a90-8bed-a7d463658591?bg=%23fff&auto=format%2Ccompress&fm