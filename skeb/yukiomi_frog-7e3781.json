2dc/uploads/origins/74b0657c-db91-48a4-8c1b-c6e528ee005d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b3f11bf3f1c5b8559d29a27c84ababa9 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/542952dc/uploads/origins/74b0657c-db91-48a4-8c1b-c6e528ee005d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b909709a571b0c94161df06286ee7b6b", "srcset": "https://si.imgix.net/542952dc/uploads/origins/74b0657c-db91-48a4-8c1b-c6e528ee005d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b909709a571b0c94161df06286ee7b6b, https://si.imgix.net/542952dc/uploads/origins/74b0657c-db91-48a4-8c1b-c6e528ee005d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=c1adfe3f9827111fcebd5ed0e847fa11 2x, https://si.imgix.net/542952dc/uploads/origins/74b0657c-db91-48a4-8c1b-c6e528ee005d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=c5cf271d8e4c761de3bd2b93d91fb9eb 3x"}, "body": "雪臣様、はじめまして。\n以前からSNSで雪臣様のイラストを拝見しておりました。綺麗な絵柄は勿論ですが一枚一枚のイラストにおける幅広い雰囲気作りが素敵で、いつも投稿を楽しみにしております。\n本題に移りますが……もし宜しければ、私のCoC探索者のイラストを描いていただきたく思います。\n依頼内容の詳細は下記に記載しております。\nご検討いただけますと幸いです。\n\n∞ ------------- ∞\n\n▼キャラクター情報\n名前／甲斐 新九郎(かい しんくろう)\nプロフィール／22歳、男性、とある教団の信者\n元不良で、後に教団の教祖となる人物との出会いをきっかけに改心する。\n現在は教団内で、教祖や他の信者たちと仲良く暮らしている。\n\n▼キャラクター資料\n※CoCシナリオのネタバレになる資料はありません。\nhttps://drive.google.com/drive/folders/1E56oEbehFEUSFFTrR6iIJLIIIHE6Djuv?usp=drive_link\n\n∞ ------------- ∞\n\n▼こちらからの指定\n資料内に服装差分があります。「私服」の方で描いていただけると幸いです。\nサイズ、シチュエーション、表情、構成など全てお任せ致します。\n\n▼使用用途\n個人鑑賞用です。", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@yukiomi_frog/works/6", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/2dd8b697/uploads/origins/9185681a-58a1-412a-a139-b2acdd5a6f9c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&