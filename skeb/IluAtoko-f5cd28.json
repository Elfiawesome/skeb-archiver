200&h=200&blur=200&s=52e6cb98e7195c115a4ceca82ae47611 3x"}, "body": "こんにちは！Juvlarです。この蛾の女性を描いてくれませんか？\nhttps://drive.google.com/drive/folders/1cAM8FphCzd3FZVfOFfUqSxeu3jWPl8Wv\nあなたがキャラクターを置くために選んだ創造的なシナリオと環境を楽しんでいます。どれも目覚めた夢のような感覚を与え、現実のように感じられますが、それが現実なのかどうか確信が持てません。この蛾の女性を、あなたが彼女に最も合うと思う環境に置いていただけませんか？彼女の目（赤い強膜、白い瞳孔、灰色の虹彩）と、服装の毛皮の面はそのままにしていただけませんか？彼女の性格を少し説明すると、彼女は夜に歩き回るミステリアスな蛾の女です。あとはあなた次第です！ありがとう", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@IluAtoko/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3538877, "client_id": 3659550, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/e73ee36a/uploads/origins/f72cc306-3f0c-4427-87a4-2a4a299e2a9f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=201abc979aabed7f5d9d488cbbfb358c", "srcset": "https://si.imgix.net/e73ee36a/uploads/origins/f72cc306-3f0c-4427-87a4-2a4a299e2a9f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=201abc979aabed7f5d9d488cbbfb358c, https://si.imgix.net/e73ee36a/uploads/origins/f72cc306-3f0c-4427-87a4-2a4a299e2a9f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=29ab737371745dd0410c2c1e4621d087 2x, https://si.imgix.net/e73ee36a/uploads/origins/f72cc306-3f0c-4427-87a4-2a4a299e2a9f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=4bf4d9e4c71c92feef5ea795ea57ffc9 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/e73ee36a/uploads/origins/f72cc306-3f0c-4427-87a4-2a4a299e2a9f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=792e9923529a9bbd6ae7772bc4e2eec1", "srcset": "https://si.imgix.net/e73ee36a/uploads/origins/f72cc306-3f0c-4427-87a4-2a4a299e2a9f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=792e9923529a9bbd6ae7772bc4