hara.com/sns/2295992/view\n\n\n【外的特徴】\n・ピンクの髪、紫ではなく赤寄りのピンク\n・肩くらいまでの長さ\n・眉毛は細すぎず、目はぱっちり\n・ニコニコ穏やか\n→Picrewの「달조각 공장」さんで https://picrew.me/share?cd=4d2QvHGDyZ #Picrew #달조각_공장　\n\n→ Picrewの「にこっと！おんなのこメーカー」で https://picrew.me/share?cd=UonuzZb9Ex #Picrew #にこっとおんなのこメーカー\n\n\n【ポーズ】\n指定はありません！\n\n\n【服装】\n・シナリオの雰囲気から、ラフな私服をイメージしてます\n・私服の中でも、かっちりしすぎてないところ\n・パンツスタイル\n・シナリオの季節指定がなければ、夏より春あたりがいいです\n・ざっくりなトップスに、スキニー／柔らかい素材のセーターに綺麗めパンツ、とかにローファーが合わせてるような私服のイメージです\n・気合の入ったデート着ではなく、結婚間近の同居しているカップルが、一緒に買い物行くっていうイメージ\n\n\n\n【最後に】\n以上の希望を書きましたが、\"全面的に\"シロ子ちゃんのご意向に沿う形でお願いします！\nシナリオセッションで立つことを今から楽しみにしております！", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@raKugKi7_7/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2164463, "client_id": 1318453, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/46ff8f59/uploads/origins/30ff6231-f44f-4602-ba56-32e63d22fd38?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8064d2b845008b1659dd42ddd1c6ffbb", "srcset": "https://si.imgix.net/46ff8f59/uploads/origins/30ff6231-f44f-4602-ba56-32e63d22fd38?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8064d2b845008b1659dd42ddd1c6ffbb, https://si.imgix.net/46ff8f59/uploads/origins/30ff6231-f44f-4602-ba56-32e63d22fd38?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=db33846b939be7765816576cc75be02e 2x, https://si.imgix.net/46ff8f59/uploads/origins/30ff6231-f44f-4602-ba56-32e63d22fd38?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=fcd1516cd5865bbcce7cffb3c9dc5cbf 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/46ff8f59/uploads/origins/30ff6231-f44f-4602-ba56-32e63d22fd38?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=91cb45f961f9c8be3654f14344668efd", "srcset": "ht