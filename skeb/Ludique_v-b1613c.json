boxなどでの限定公開\n・ネットプリントへの利用\n・自分のホームページでの掲載利用\n・その他活動時のPR等\n※使用時に文字などを被せる可能性がございます。\n\n◇依頼内容◇\n私のイラストを描いていただきたいです。\n傘原イジ様の描く顔のパーツのぷっくり感のある塗りがとても好きで\n男性ではありますが中性的な顔立ちなので、下まつ毛などバシバシにしていただいて大丈夫です！\n\n※詳細資料は下記URLをご参照下さいませ。\n\n◇構図希望◇\nキャラクターは髪の毛等、「上」「左右」が見切れないものでお願いしたいです。\n傘原イジ様の世界観が好きですので表情や構図はお任せいたします。\n\n◇データの種類◇\n350dpi以上で人物以外の物がある場合はレイヤー分けされた「PSDファイル」\n人物のみでしたら「PNGファイル」でお願いしたいです。\n\n普段あまり依頼をしないので、至らない点がございましたら申し訳ありません。\n長文失礼いたしました。\nお忙しいところ恐れ入りますが、ご検討よろしくお願いいたします。\n\n【参考資料】\n普段着である黒いコートを着ている方でお願いいたします！\n\nhttps://drive.google.com/drive/folders/1cfHWOiBuiVEeZ9-_XkUQS572RQuMWjRq?usp=drive_link", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@AyanaSuzuno/works/21", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3076987, "client_id": 2065386, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/19db7007/uploads/origins/d27fde60-53d7-4ccd-8ea5-98d1d89a6637?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0599e591a6e933a010efe4f5b679e815", "srcset": "https://si.imgix.net/19db7007/uploads/origins/d27fde60-53d7-4ccd-8ea5-98d1d89a6637?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0599e591a6e933a010efe4f5b679e815, https://si.imgix.net/19db7007/uploads/origins/d27fde60-53d7-4ccd-8ea5-98d1d89a6637?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=216a48af6aea171a54728cd4098b786b 2x, https://si.imgix.net/19db7007/uploads/origins/d27fde60-53d7-4ccd-8ea5-98d1d89a6637?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f56a323b731944932ba41373f7f12bb5 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/19db7007/uploads/origins/d27fde60-53d7-4ccd-8ea5-98d1d89a6637?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=4fd29affb633b86bf23656cbfe66bcaf", "srcse