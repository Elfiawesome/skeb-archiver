=sharing", "nc": 185, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@tyomotyo/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2803289, "client_id": 3722593, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/295bcce5/uploads/origins/2296a500-511a-4423-a7ea-63c29c93b55f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b2f05ce4115ee95142b9ca15353f3ba9", "srcset": "https://si.imgix.net/295bcce5/uploads/origins/2296a500-511a-4423-a7ea-63c29c93b55f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b2f05ce4115ee95142b9ca15353f3ba9, https://si.imgix.net/295bcce5/uploads/origins/2296a500-511a-4423-a7ea-63c29c93b55f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=78a2304061d95b0f0a6f0c4c8ad78036 2x, https://si.imgix.net/295bcce5/uploads/origins/2296a500-511a-4423-a7ea-63c29c93b55f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=1e67ec3933be2eb701fbda41603be054 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/295bcce5/uploads/origins/2296a500-511a-4423-a7ea-63c29c93b55f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=cd387dcb2061d18af95847c93b67d5de", "srcset": "https://si.imgix.net/295bcce5/uploads/origins/2296a500-511a-4423-a7ea-63c29c93b55f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=cd387dcb2061d18af95847c93b67d5de, https://si.imgix.net/295bcce5/uploads/origins/2296a500-511a-4423-a7ea-63c29c93b55f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=7fed60af359f4177261919e0d46cc5f9 2x, https://si.imgix.net/295bcce5/uploads/origins/2296a500-511a-4423-a7ea-63c29c93b55f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=a44908e5df55f00050e51d5d0cdb225c 3x"}, "body": "ちょもちょ先生、こんにちは。先生の作品をずっと拝見させていただいており、可愛くて表情豊かなキャラクターの描き方が本当に大好きです！\n\n私のオリジナルキャラクター――愛らしい魔法使いの猫娘――のイラストを依頼させていただきたいです。彼女は胸が平らで、この作品では恥ずかしがり屋で動揺したような表情を想像しています。\n\nシーンについては、胸を使って自慰行為をしている姿を描いていただきたいです。構図やポーズは完全に先生にお任せします。\n\nご依頼をご検討いただきありがとうございます。素敵な一日をお過ごしください！\n\nhttps://drive.google.com/drive/folders/19z1r-48VRXuJNV_5WlellxcPPEVami_q?usp=sharing", "nc": 161, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@tyomotyo/works/5", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/dd30654c/uploads/origins/bf22bdd9-41b2-4096-a71e-24dbde45a031?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=21b83711500bbff5004ba451f523fb31", "srcset": "https://si.imgix.net/dd30654c/uploads/origins/bf22bdd9-41b2-4096-a71e-24dbde45a031?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=21b83711500bbff5004ba451f523fb31, https://si.imgix.net/dd30654c/uploads/origins/bf22bdd9-41b2-4096-a71e-24dbde45a031?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=5c63af19a388189f5473a34727c4aa41 2x, https://si.imgix.net/dd30654c/uploads/origins/bf22bdd9-41b2-4096-a71e-24dbde45a031?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=3e69ef038e432e359556e6d9c0b1ed90 3x"}, "private": true, "genre": "art", "tipped": true, "creator_id": 2803289, "nc": 49}, {"path": "/@tyomotyo/works/4", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/25f7a7bf/uploads/origins/16830e94-f8c6-432b-bdb9-5c4ed66b9cfe?bg=%23fff&auto=format%2Ccompress&fm=webp&fi