45f6-a2e6-8b01c2063ec1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e3656279b30db0f2f1b3901d3db176e5 2x, https://si.imgix.net/421a79dc/uploads/origins/d0a3414a-c4e4-45f6-a2e6-8b01c2063ec1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d057241002ee34a52bb3c772558d4a09 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/421a79dc/uploads/origins/d0a3414a-c4e4-45f6-a2e6-8b01c2063ec1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2bb6a0dc9a1922a300367cab4fb70535", "srcset": "https://si.imgix.net/421a79dc/uploads/origins/d0a3414a-c4e4-45f6-a2e6-8b01c2063ec1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2bb6a0dc9a1922a300367cab4fb70535, https://si.imgix.net/421a79dc/uploads/origins/d0a3414a-c4e4-45f6-a2e6-8b01c2063ec1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=bb0deba2a86681e202bcb6afb8e5a28a 2x, https://si.imgix.net/421a79dc/uploads/origins/d0a3414a-c4e4-45f6-a2e6-8b01c2063ec1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=0fbd4e8e245b48c5f8608fcc60fcc646 3x"}, "body": "はじめまして、新着クリエイター一覧から過去作品に惹かれてきました\nもしよろしければリクエストを受けていただけないでしょうか\nサービス終了したネットゲームのマイキャラクターがモデルのうちの子になります\nお淑やかな性格でむっつりスケベ、胸は控えめのスレンダーな子で、お尻が性感帯です\n\n・希望する内容を箇条書きで\n「依頼衣装」とついたファイルのいずれかの衣装を着せてあげてください\n（もしくは「その他衣装」から飛べるフォルダの中にお好みの衣装があれば、そちらを着せてあげてください）\n犬耳を着け、尻尾付プラグをお尻に挿入した状態（付け根のプラグが見えないような、尻尾だけお尻から伸びているような形状）\n恋人とのいちゃらぶセックス、または尻尾は無しでアナルセックス、その他オナニー、アナルオナニー、誘惑する様子…等々お好みのシチュエーションで\n犬になりきりながらorお尻で気持ちよさそうにしているイメージ\nとろとろで気持ちよさそうな表情\n相手の描写は無くても構いません\n胸の大きさは控えめ（Bカップ程度～つるぺたまでお好みで）\n服装については着衣～半脱ぎくらいでお好みで\nランジェリーの場合は着たままでお願いします（シチュエーションによってクロッチを開いてください）\n顔が見え、衣装が映えるよう正面から見た構図ですと嬉しいです\n\nご検討をお願いいたします\n\nhttps://drive.google.com/drive/folders/1gXZVDfcsl66QZ8VxPLKFXERqQXKioNsJ", "nc": 185, "word_count": 0, "transcoder": "image", "creator