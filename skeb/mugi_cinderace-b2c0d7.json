g=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=4abf29753697026b6b0ab43f989c7fac, https://si.imgix.net/0935577a/uploads/origins/03b0eef4-ffd5-46f4-ab31-1aa38e768d63?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=15429ca46e1fdea3a4a3043b824143da 2x, https://si.imgix.net/0935577a/uploads/origins/03b0eef4-ffd5-46f4-ab31-1aa38e768d63?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=83f0cdee0817a5b1324a027c12c6e196 3x"}, "body": "こんにちは！次の冒険に向かうラプラス、リオル、ラティオスのイラストをお願いします。ラプラスは水の中を楽しそうに泳ぎ、リオルはラプラスの背中に乗って、冒険者のかばんを持ちながら風を楽しんでいます。ラティオスはラプラスの隣で楽しそうに飛んでいる。3人ともスカーフを巻いているはずですが、スカーフの色や柄はお任せします！その他、あなたが適切だと思うものを自由に盛り込んでください！ありがとうございました！", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@mugi_cinderace/works/14", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1264872, "client_id": 2739652, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/dffab519/uploads/origins/d745f9c4-a7b1-439c-bf57-23db5eae1bc8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1f1d1c930c52c4f1f738901ea4795f69", "srcset": "https://si.imgix.net/dffab519/uploads/origins/d745f9c4-a7b1-439c-bf57-23db5eae1bc8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1f1d1c930c52c4f1f738901ea4795f69, https://si.imgix.net/dffab519/uploads/origins/d745f9c4-a7b1-439c-bf57-23db5eae1bc8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=d625198dfa178cd834699234a279f015 2x, https://si.imgix.net/dffab519/uploads/origins/d745f9c4-a7b1-439c-bf57-23db5eae1bc8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d22936376606a32d39fc4ccb6af7852d 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/dffab519/uploads/origins/d745f9c4-a7b1-439c-bf57-23db5eae1bc8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=45dc21d8195061cf968d601cc0149cd4", "srcset": "https://si.imgix.net/dffab519/uploads/origins/d745f9c4-a7b1-439c-bf57-23db5eae1bc8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=45dc21d8195061cf968d601cc0149cd4, https://si.imgix.net/dffab519/uploads/origins/d745f9c4-a7b1-439c-bf57-23db5eae1bc8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=ccbb38cbfd8fd2b63d17aec37fa9cba2 2x, https://si.imgix.net/dffab519/uploads/origins/d745f9c4-a7b1-439c-bf57-23db5eae1bc8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=c0d854a2fa23662312d775a3d656e80c 3x"}, "body": "ウィーテさんこんにちは！！私は以前からあなたの描くエースバーンのセルフセットのインタラクティブイラストが大好きです。 あなたの描くエースバーンはとてもセンセーショナルなので、私とエースバーンのインタラクティブイラストもお願いしたいです。 もし、依頼内容に難点や問題があれば、この依頼をキャンセルすることもできますので、よろしくお願いします。マージンが足りない場合でも変更できます。\n\n私の自設定です、活発でおおらかで親切で、ちょっと気取った女子大生です。 家には5匹のウサギがいて、その設定や人物像は下のリンクに描かれています。https://drive.google.com/drive/folders/1-VWzlaW_-K9BWaRcyur5n_8bWw7pAHVZ?usp=sharingショートヘアの2着は1.2.点で自在に使え、ダブルポニーテール姿はUNITEな場面で使えます。\n\n\n1.ソファやベッドに座ってSwitchをプレイする私を囲むように炎晴と晴香が座り、喧嘩っ早い弟2人を日和が見守るという、家族ぐるみの付き合いになればいいなと思います\n\n2.森でキャンプピクニック、みんなで鍋からカレーが出てくるのを待つ（みんなお皿を片手に待ってもいいんです）\n\n3.ユナイトのフィールドで、ヤンチンやハルカを指揮しながら戦う\n\n上記は参考として、自由に選んで描いてください\n\nイラストは個人的な鑑賞用としてのみ使用し、商業目的には使用しませんので、ご安心ください。 できれば、レイヤーサインもお願いしたいです。\n\nhttps://drive.google.com/drive/folders/1-VWzlaW_-K9BWaRcyur5n_8bWw7pAHVZ?usp=sharing", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@mugi_cinderace/works/13", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/8f28896e/uploads/origins/5dec713f-66c7-47fb-a971-12d855916c78?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=797ef76cc8c94ff4e6008a01e454d703", "src