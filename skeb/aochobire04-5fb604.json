定は一切ございません。\nもし可能でしたら、背景なしの透過データも併せて納品いただけますと大変ありがたく存じます。\n今回は二人分のリクエストのため、追加料金や価格設定の調整などをしていただいて構いません。\n\nhttps://www.dropbox.com/scl/fi/zd9p964ov4nut1za4kqqe/.pdf?rlkey=7mntnp83k2kpsu9bf08yi3fv6&st=467duw9z&dl=0", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@aochobire04/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3731596, "client_id": 3098683, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/0e57f2bf/uploads/origins/3cd43db4-e968-4656-ab2c-6aa8123199fe?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&s=02edff8da16b6656ab44f3700eb7d823", "srcset": "https://si.imgix.net/0e57f2bf/uploads/origins/3cd43db4-e968-4656-ab2c-6aa8123199fe?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&s=02edff8da16b6656ab44f3700eb7d823, https://si.imgix.net/0e57f2bf/uploads/origins/3cd43db4-e968-4656-ab2c-6aa8123199fe?bg=%23fff&fm=webp&auto=compress&dpr=2&fit=crop&crop=top&w=200&h=200&s=9d980d4db54c4af219b5d0f810fe9149 2x, https://si.imgix.net/0e57f2bf/uploads/origins/3cd43db4-e968-4656-ab2c-6aa8123199fe?bg=%23fff&fm=webp&auto=compress&dpr=3&fit=crop&crop=top&w=200&h=200&s=dde2c4b10292c19515653fea14ef1e12 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/0e57f2bf/uploads/origins/3cd43db4-e968-4656-ab2c-6aa8123199fe?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&blur=200&s=83a0c4cd5865bd87fe49b3f2e6afc35a", "srcset": "https://si.imgix.net/0e57f2bf/uploads/origins/3cd43db4-e968-4656-ab2c-6aa8123199fe?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&blur=200&s=83a0c4cd5865bd87fe49b3f2e6afc35a, https://si.imgix.net/0e57f2bf/uploads/origins/3cd43db4-e968-4656-ab2c-6aa8123199fe?bg=%23fff&fm=webp&auto=compress&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=9ce8e46100110bf659bae7e52b58b936 2x, https://si.imgix.net/0e57f2bf/upload