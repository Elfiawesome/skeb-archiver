the main one for just chatting with people during stream (most important), and (a slower) version for after the stream ends. The before and after songs can be shorter. \n\nThanks!\n\nhttps://www.youtube.com/watch?v=iuyCQmxEZzg&ab_channel=MIGA", "nc": 24, "word_count": 0, "transcoder": "audio", "creator_acceptable_same_genre": true}, {"path": "/@Garin_c_s/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "music", "tipped": true, "creator_id": 1386874, "client_id": 50573, "vtt_url": null, "thumbnail_image_urls": {"src": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1642798568200359937%2FD7138wWY.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6df419fe5f9dba752c230f99a5d87d07", "srcset": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1642798568200359937%2FD7138wWY.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6df419fe5f9dba752c230f99a5d87d07, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1642798568200359937%2FD7138wWY.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=8893e791e829d1df135e72d45e37c7b0 2x, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1642798568200359937%2FD7138wWY.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e9c876e5eb9557c26c617a1013899783 3x"}, "preview_url": "https://fcdn.skeb.jp/uploads/outputs/d0300cdb-ebd9-4bcf-8ec8-80946ed78c30?response-content-disposition=inline&Expires=1784432158&Signature=j4QYBGEL0USJVoCRk9nUrKXnN3qoKxoKtCEgiqZkeJlnalIFGoj~WulX1BO5LDQW0CcsSZcSfE8XHYIdPGIzyYceedC8RM5bDu-p1pwPZjbVHA7n3soMik796e7jeBScTwpvFKlVUtt~ZwhTjgjgyohk1PMa10tsmk4SiDnHccwu82NVRR7xZRCopTMMC97P5Tw6R0m9Bg6fDkun4GmChppu9tdbcuVUnvZVWL~AW3D9oX7eRdpTukwSequ61Xa6d2Lejcd5XWs9DSVRdpm03xex21Nv2yNj2JTYPSQeG6nI1Ge~0FdrpM5aktIwxoo-wk2zv0gApHVxjgND7gzpSQ__&Key-Pair-Id=K1GS3H53SEO647", "duration": 7