t! You can experiment with whatever you like and it can be any genre. I'm curious what you can come up with, I want to hear the sounds you ideally enjoy. There's a few art on my skeb but I'm still waiting for more.. You can look for inspiration if you need.\n\nI'll be waiting patiently. ♡♡♡\n\nhttps://drive.google.com/drive/folders/1rOYlbQigFTXFinl9Z6JO4Wfg_Wbtfaqn?usp=sharing", "nc": 144, "word_count": 0, "transcoder": "audio", "creator_acceptable_same_genre": true}, {"path": "/@Garin_c_s/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "music", "tipped": true, "creator_id": 1386874, "client_id": 2092296, "vtt_url": null, "thumbnail_image_urls": {"src": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1642798568200359937%2FD7138wWY.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6df419fe5f9dba752c230f99a5d87d07", "srcset": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1642798568200359937%2FD7138wWY.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6df419fe5f9dba752c230f99a5d87d07, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1642798568200359937%2FD7138wWY.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=8893e791e829d1df135e72d45e37c7b0 2x, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1642798568200359937%2FD7138wWY.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e9c876e5eb9557c26c617a1013899783 3x"}, "preview_url": "https://fcdn.skeb.jp/uploads/outputs/7962afaf-818f-4a75-a905-35d1bcdbe282?response-content-disposition=inline&Expires=1784432158&Signature=c1Nyd5JU~NdUJGfYZ-6X6tw59ofEPO7mAN7Xttg7D0CK4tDxWDazMM7sSEiDcTyaKG9UBImODMr~SWuwG8QvhFP-XNx3EVVpKUe66v-pkbSBeWKm0tOR2ECWsejIfrqhOsOB~O4lnHVEatURG0xI0enbee5ggB-xdlPoSBCHLDIlIdeZVvcba2wmSgAF-uZKtHHvQyfSpX4hK05RNv0QvO8kdyBwjYv4hunYgwPeGgSvy8Sc2y9HETG