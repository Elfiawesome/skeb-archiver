_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2480821, "client_id": 460489, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/80de6d90/uploads/origins/5447bc1c-8ba2-4ec9-afd1-54d95d659e12?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c541b53a274f7b4ef758611f86b9a04e", "srcset": "https://si.imgix.net/80de6d90/uploads/origins/5447bc1c-8ba2-4ec9-afd1-54d95d659e12?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c541b53a274f7b4ef758611f86b9a04e, https://si.imgix.net/80de6d90/uploads/origins/5447bc1c-8ba2-4ec9-afd1-54d95d659e12?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=be5b4f294a14d6ca301abf4b2e09009c 2x, https://si.imgix.net/80de6d90/uploads/origins/5447bc1c-8ba2-4ec9-afd1-54d95d659e12?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a6153f22e1cfca05d1b5b383e4c6c0d3 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/80de6d90/uploads/origins/5447bc1c-8ba2-4ec9-afd1-54d95d659e12?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=13e1282c593e9109d4a1aae9023bd2c0", "srcset": "https://si.imgix.net/80de6d90/uploads/origins/5447bc1c-8ba2-4ec9-afd1-54d95d659e12?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=13e1282c593e9109d4a1aae9023bd2c0, https://si.imgix.net/80de6d90/uploads/origins/5447bc1c-8ba2-4ec9-afd1-54d95d659e12?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=96f328f236e0e02003ea8ce7c391de4f 2x, https://si.imgix.net/80de6d90/uploads/origins/5447bc1c-8ba2-4ec9-afd1-54d95d659e12?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=b3a0650b41a79bd6b8374494682bab2c 3x"}, "body": "はじめまして\nえすと申します。\n\nうちの子と友達のうちの子の単漫画を依頼したいと思います\nあらすじ\n朝にメイドであるミュウはネージュを起こしに行く。\nネージュは寝相が悪く、眠っているときはガードが緩んでいる。\nミュウはその時彼女を殺して自由を取り戻そうと考えたが、そうしないことにした。どうせガードが緩んでも殺すのは出来ないですから。\nネージュは起こされ、ミュウは彼女の髪をとかし、身なりを整える。\n\nよろしくお願いします。\n\nhttps://drive.google.com/drive/folders/1GPsqMlWpwQBJ0UMbX1qomWtZdpP_NzUx?usp=sharing", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@afrody123/works/14", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2480821, "client_id": 1824395, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/3562c223/uploads/origins/561de64e-ddfb-4530-8d9f-4f9201c673ad?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c2f6fcaf197261a6ac06ef048cc701e0", "srcset": "https://si.imgix.net/3562c223/uploads/origins/561de64e-ddfb-4530-8d9f-4f9201c673ad?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c2f6fcaf197261a6ac06ef048cc701e0, https://si.imgix.net/3562c223/uploads/origins/561de64e-ddfb-4530-8d9f-4f9201c673ad?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=92807b88121ed0f676ef30aae84ec916 2x, https://si.imgix.net/3562c223/uploads/origins/561de64e-ddfb-4530-8d9f-4f9201c673ad?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=33d4ed68a08c9b1515809fb9fa59e333 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/3562c223/uploads/origins/561de64e-ddfb-4530-8d9f-4f9201c673ad?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3de3b5de1d8d2b34060a90d90e69226a", "srcset": "https://si.imgix.net/3562c223/uploads/origins/561de64e-ddfb-4530-8d9f-4f9201c673ad?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3de3b5de1d8d2b34060a90d90e69226a, https://si.imgix.net/3562c223/uploads/origins/561de64e-ddfb-4530-8d9f-4f9201c673ad?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=18d1fe9b5cd601b0360424d770b9e7f6 2x, https://si.imgix.net/3562c223/uploads/origins/561de64e-ddfb-4530-8d9f-4f9201c673ad?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=b4755bf7eaf10d4eccb6180c2bf8a8c1 3x"}, "body": "前回のリクエストに応えてくれてありがとう。\n\n先生は、人形を返してもらう前に、後で優香と食事に行く約束をしてしまう。シーンは、センセイがyuukaと食事に行くときに移り、Noaはオフィスで一人で仕事をしている。外は小雨が降り、Noaは仕事をしながらyuukaと先生の関係について考えている。Noaはyuukaと先生の関係がより良いものになることを切に願うが、同時に先生がいなくて寂しいという気持ちもあった。Noaが寂しさを感じているその時、ドアをノックする音が彼女の思考を中断させた。先生はドアの前に立ち、笑顔でNoaを見つめ、パーティーに誘った。Yuukaも先生の後ろから体を出し、恥ずかしそうにNoaを誘った。Noaは一瞬固まったが、Yuukaを抱きしめた。先生は笑顔で2人を見つめ、ラストシーンはドアの後ろに隠れる人形たちだった！ラストシーンは、ドアの後ろに隠れて二人を見送る人形たち\n (かわいい人形を描いてください）", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@afrody123/works/13", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2480821, "client_id": 1824395, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/28d059fd/uploads/origins/fa22a5ce-54e1-4bb7-a6f2-f01f2acb6d9f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2eff6883a08f05e03a8a6a026080a9fa", "srcset": "https://si.imgix.net/28d059fd/uploads/origins/fa22a5ce-54e1-4bb7-a6f2-f01f2acb6d9f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2eff6883a08f05e03a8a6a026080a9fa, https://si.imgix.net/28d059fd/uploads/origins/fa22a5ce-54e1-4bb7-a6f2-f01f2acb6d9f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=4edb36b02a97fb0458c77bcbe06fb4fc 2x, https://si.imgix.net/28d059fd/uploads/origins/fa22a5ce-54e1-4bb7-a6f2-f01f2acb6d9f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=5f0df0451bbb0322384d6140cc799dd1 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/28d059fd/uploads/origins/fa22a5ce-54e1-4bb7-a6f2-f01f2acb6d9f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&