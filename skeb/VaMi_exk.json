が気持ち多めだとありがたいです\nもちろん見せたいわけじゃなくて、本人がオシャレとしてしてる感じ\n例えば、シャツの第二ボタンまで開けているとか、腹チラしているとか…\n・可能であればメガネ差分をいただけると幸いです！\n不可であればメガネ無しでお願いします", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@VaMi_exk/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1433510, "client_id": 1714873, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/eda79fd0/uploads/origins/46c04bb1-e0db-48dc-b115-57a902ace663?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a891b7a1d96bb73d99670c50b99a6eae", "srcset": "https://si.imgix.net/eda79fd0/uploads/origins/46c04bb1-e0db-48dc-b115-57a902ace663?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a891b7a1d96bb73d99670c50b99a6eae, https://si.imgix.net/eda79fd0/uploads/origins/46c04bb1-e0db-48dc-b115-57a902ace663?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f96fe9f5ef5a67aff317e5ebac0ce090 2x, https://si.imgix.net/eda79fd0/uploads/origins/46c04bb1-e0db-48dc-b115-57a902ace663?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=4a253eb3f286e9d7817aa133f0d23a7d 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/eda79fd0/uploads/origins/46c04bb1-e0db-48dc-b115-57a902ace663?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5256915112229f0d0e9a907c25473de0", "srcset": "https://si.imgix.net/eda79fd0/uploads/origins/46c04bb1-e0db-48dc-b115-57a902ace663?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5256915112229f0d0e9a907c25473de0, https://si.imgix.net/eda79fd0/uploads/origins/46c04bb1-e0db-48dc-b115-57a902ace663?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=9c9325b613b6c0853d540c3f09f977b4 2x, https://si.imgix.net/eda79fd0/uploads/origins/46c04bb1-e0db-