imotsukinagi\n\n以上、ご都合がよろしければどうぞよろしくお願いいたします。", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Kyouka_Abi/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3623138, "client_id": 3195926, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/18f8ab93/uploads/origins/b86e50b1-eaa6-4c77-b4e2-de82133e3aaa?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b1413c8e673d31739e8dd5f20df5786a", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/18f8ab93/uploads/origins/b86e50b1-eaa6-4c77-b4e2-de82133e3aaa?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9c20fea8bf0e58512871921fded05e20", "src_set": ""}, "body": "アピールありがとうございます！\n是非描いていただきたいです！\nポーズは躍動感ある感じであとはお任せいたします！", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "similar_creators": [{"id": 14136, "creator": true, "nsfw_acceptable": false, "acceptable": false, "name": "セカイメグル【アカウント移行いたします】", "screen_name": "sekamegu", "avatar_url": "https://pbs.twimg.com/profile_images/1530488232521043975/Twe8l9RO.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1603596296/1704460335/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "skills": [{"genre": "art"}, {"genre": "correction"}], "nc": 144}, {"id": 58767, "creator": true, "nsfw_acceptable": false, "acceptable": false, "name": "チヨ丸", "screen_name": "yumichiyo0606", "avatar_url": "https://pbs.twimg.com/profile_images/1907094501111615489/lKN1-z_t.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1001307643/1704372104/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_r