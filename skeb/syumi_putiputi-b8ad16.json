の想像力を存分に活かして描いてください！私が用意したラフな参考画像では、官能的な雰囲気が十分に伝わっていなかったようです――あなたの他の作品は、それよりもずっと私の心をときめかせてくれます。本当にありがとうございます！\n\nhttps://drive.google.com/file/d/1db_DRp0IIJMAX3GYTY_YquVvxUpAIm3F/view?usp=drive_link", "nc": 176, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@syumi_putiputi/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3828787, "client_id": 4153962, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/e573ee58/uploads/origins/0b6b4e24-6bf4-498d-87ff-d85864fb44bb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1986f6d02400ae9c9eeb3b84856b0789", "srcset": "https://si.imgix.net/e573ee58/uploads/origins/0b6b4e24-6bf4-498d-87ff-d85864fb44bb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1986f6d02400ae9c9eeb3b84856b0789, https://si.imgix.net/e573ee58/uploads/origins/0b6b4e24-6bf4-498d-87ff-d85864fb44bb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=3874acd3929f802de2efc1fa0e64ee82 2x, https://si.imgix.net/e573ee58/uploads/origins/0b6b4e24-6bf4-498d-87ff-d85864fb44bb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=2e1e782b6d1a9033378570afd1ccd072 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/e573ee58/uploads/origins/0b6b4e24-6bf4-498d-87ff-d85864fb44bb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e3fcd317805fd3db91214f7c131116f4", "srcset": "https://si.imgix.net/e573ee58/uploads/origins/0b6b4e24-6bf4-498d-87ff-d85864fb44bb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e3fcd317805fd3db91214f7c131116f4, https://si.imgix.net/e573ee58/uploads/origins/0b6b4e24-6bf4-498d-87ff-d85864fb44bb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=3bcc195fad28e30bf17b1