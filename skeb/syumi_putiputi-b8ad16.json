、ふざけて照れくさそうなふりをする（ウケをからかうために、わざと恥ずかしがっているふりをしている）。\nウケ： かわいいちびキャラ風で描かれ、コーヒーを飲んでいる最中に、あまりの衝撃でドラマチックにコーヒーを吹き出す！\n\n参考までに、物語からの参考画像を添付しました。キャラクターの表情やポーズは、お好きなように変更していただいて構いません。あなたのクリエイティブなアイデアが大好きなので、ぜひご自身の想像力を存分に発揮してください！ 本当にありがとうございます！\n\nhttps://drive.google.com/file/d/1qFUGY1ZIAuxD0ygcLLscyWN5Cu_F2L6O/view?usp=drive_link", "nc": 33, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@syumi_putiputi/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3828787, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/ff4f9ece/uploads/origins/cac22628-329a-495b-8550-b59e5ad08dda?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=cb8cdf0da372ec39a3703abf1b909ce3", "srcset": "https://si.imgix.net/ff4f9ece/uploads/origins/cac22628-329a-495b-8550-b59e5ad08dda?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=cb8cdf0da372ec39a3703abf1b909ce3, https://si.imgix.net/ff4f9ece/uploads/origins/cac22628-329a-495b-8550-b59e5ad08dda?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=d1653ca13231cd398119c555057652b4 2x, https://si.imgix.net/ff4f9ece/uploads/origins/cac22628-329a-495b-8550-b59e5ad08dda?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=221a772a2b96f4c1868bedcc7d1981cb 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/ff4f9ece/uploads/origins/cac22628-329a-495b-8550-b59e5ad08dda?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e610cd4dc5582b33ceb91b95e5eebaf2", "srcset": "https://si.imgix.net/ff4f9ece/uploads/origins/cac22628-329a-495b-8550-b59e5ad08dda?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e610cd4dc5582b33ceb91b95e5eebaf2, https://si.imgix.net/ff4f9ece/uploads/origins/cac22628-329a-495b-8550-b59e5ad08dda?bg=%23f