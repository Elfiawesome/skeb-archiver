ません。\n\n①待機モーション:お任せします。\n②動き:片手で帽子の唾を下に下げるような(軍帽を深く被る)、抑えるような動き。この際に顔に帽子のつばの影が入ると嬉しいです。\n\n他要望\n口は小さめか、なしでお願いしたいです。\n\n服装等:資料をご覧下さい。\n(武器資料も一応入れましたが、描写が大変だと思いますので有無はお任せします。)\n\n目はぱっちりとしたつり目ですが、とろーさんの描き方が好きなのでタレ目にならなければ大丈夫です。\nドットで表現できない部分やマント裏地の柄は簡略化しても問題ありません。また、瞼の色も絵柄によるものなので勝手に茶色や黒などに変えてしまって大丈夫です。ハイライトや目の描き方も同様です。\n\nhttps://drive.google.com/drive/folders/17uU3yPdf1VkFv_gJydgTE2DUfsbg3WPO", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "similar_creators": [{"id": 3058190, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "えび永日", "screen_name": "to____EX", "avatar_url": "https://pbs.twimg.com/profile_images/1936076613340610564/LPUrSo9y.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1452626883422478345/1738845507/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "art"}], "banned": false, "nc": 1}, {"id": 3645386, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "はちかい", "screen_name": "hakabawara", "avatar_url": "https://pbs.twimg.com/profile_images/1937917786262781952/naLDy12q.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1759526692492853248/1770378345/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 10, "complete_expiration_days": 70, "skills": [{"genre": "art"}], "banned": false, "nc": 16}, {"id": 3728498, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "縫包", "screen_name": "gurumi0088", "avatar_url": "https://pbs.twimg.com/profile_images/1966449704973320192/iJfaZywB.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1748863530672218112/1757675657/1500x500", "appeal_