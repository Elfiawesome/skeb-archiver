にちは、夜詩です。\n探索者の1枚絵を…依頼したくご連絡しました。\n\n資料というか、アップでスクショ撮っていたのを資料として添付させていただきます。\n探索者はPLPCが同一の特殊なタイプのシナリオに行きましたので、小さい方がアリア本体で背の高いの方がアルドリックさんだとおもって…いただければ…。\n\nアリア\n右目茶色  左目黒 左目下涙ボクロ\n\nアルドリックさん側\n右目黒  左目茶色\nが少し分かりにくいかな？ と思ったので文章記載します。\n\n特に構図などは指定がありませんが、もしあった方が描きやすい！ というのがあれば多分アリアがアルドリックさんに飛びつきに行ってなだめられている…とかですかね…\n\n\n使用用途はTwitterのヘッダー等に利用する予定もあります。宜しくお願いします\n\nhttps://twitter.com/Youta_Aria/status/1690167302258593792?t=NHnTEQ5bdP_yLWu6gpzIGA&s=19", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@escape_rabbit_8/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2725348, "client_id": 2872903, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/d533236f/uploads/origins/8e60cc08-e373-4c10-a9af-21381039b011?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3715b11e82a8c3bd351d683cdc438b63", "srcset": "https://si.imgix.net/d533236f/uploads/origins/8e60cc08-e373-4c10-a9af-21381039b011?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3715b11e82a8c3bd351d683cdc438b63, https://si.imgix.net/d533236f/uploads/origins/8e60cc08-e373-4c10-a9af-21381039b011?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=7c78679572dcec8d3918bdb8da4c4b9b 2x, https://si.imgix.net/d533236f/uploads/origins/8e60cc08-e373-4c10-a9af-21381039b011?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=72d035d187f85c6af81c335d1080dd84 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/d533236f/uploads/origins/8e60cc08-e373-4c10-a9af-21381039b011?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=61208a6ca8c3a68ac90b3b3d1e131229", "srcset": "https://si.imgix.net/d533236f/uploads/origins/8e60cc08-e373-4c10-a9af-21381039b011?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=t