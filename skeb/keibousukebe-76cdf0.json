9b0a4b613823?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=4389d9477da67ee32cc829d5e6a566a4", "srcset": "https://si.imgix.net/f9595655/uploads/origins/894b2c5a-d307-4baf-8d22-9b0a4b613823?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=4389d9477da67ee32cc829d5e6a566a4, https://si.imgix.net/f9595655/uploads/origins/894b2c5a-d307-4baf-8d22-9b0a4b613823?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=aec90f31c3ecdd2165fe983149047585 2x, https://si.imgix.net/f9595655/uploads/origins/894b2c5a-d307-4baf-8d22-9b0a4b613823?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=5cc7055c43bf8d95d01a0cecfa0fd304 3x"}, "body": "初めまして。いつもイラスト楽しみに拝見させていただいております。とくにpixivで拝見しましたおま〇こ図鑑シリーズでは、キャラクターのバストアップと女性器のどアップというフェティシズムをくすぐる構図に加え、初々しさを感じさせる整った女性器から色素沈着と肥大化で見事に使い込まれたグロマンまで非常に幅広く、様々なバリエーションで描き分けられておられるのに非常に拘りを感じ、感銘を受けております。ぜひこのおま〇こ図鑑シリーズのイラストをお願いしたくリクエストを送らせていただきました。今回、女性器のアップに資料の子（うちの子）のバストアップ又は立ち絵を添えてたイラストをお願いしたいと考えております。\n\n【キャラ設定】\n陰キャのJK。特徴は、太眉、一重瞼、黒子と雀斑多めのあばた面、大きな鼻に厚い下唇。雑にまとめたポニーテールの結び目は耳より下、長さは解くとセミロング位。平均以下の容姿を自覚しており、化粧っ気もなく本人は異性に好意を抱かれることはないと思っている。見た目は真面目そうな優等生だがむっつりスケベ。非モテゆえに異性に縁がないが、男性器やセックスに興味津々で性欲を発散できずに持て余している。自慰行為はJC1の頃に直接性器を刺激することを覚えてからほぼ毎日している。最近は自慰行為の回数と激しさは増す一方。度重なる自慰行為の影響で徐々にグロマン化していることに気づいているがそれでもやめられない。無駄に巨乳で陥没乳首。\n外見は資料URLをご参照ください。\n\n\n【女性器】\n処女膜が開口部が小さめの二つ穴状処女膜のため、男性器や異物の挿入が困難で、指すら挿入したことがないにも関わらず処女膜が場違いなグロマンでお願いします。指を挿入しようとすると痛みを伴うため、自慰行為は主に性器をなぞったり、クリトリスの刺激がメイン。そのため、クリトリスと小陰唇は肥大化、色素の沈着も著しい。大陰唇が閉じている状態でも小陰唇がはみ出るようになっている。\n以下①～③の段階別でお願いできると捗ります。\n①大陰唇が閉じた状態\n②大陰唇、小陰唇を開いた状態（所謂くぱぁ状態）。処女膜の描写をお願いします。\n③処女喪失直後。引き裂かれた処女膜痕と出血、膣内射精された精液が溢れている描写。\n\n\n【陰毛】\n濃いめの陰毛が全く手入れがされておらず湿っぽい。性器の周りのみならず、肛門の周りにもびっしり。\n\n\n指定にないところや内容の改変、オミットはお任せします。金額に見合う範囲でお願いできればと思います。\npixivでケイボウ様の描かれるイラストを初めて拝見した際に、グロマンスキーとして理想のイラストに出会うことができて非常に感銘を受けたのを覚えております。今回、skeb募集をされていることを知り、微ブサのうちの子のグロマンという組み合わせをおま〇こ図鑑として見ることができたらとても嬉しいです。\n\nあれこれと注文の多いリクエストで申し訳ありませんがぜひともご検討の程よろしくお願いします。\n\nhttps://drive.google.com/drive/folders/1CNyU8k4KBHaMRrOBZlYX8jGAOnLfQDZ4?usp=sharing", "nc": 186, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@keibousukebe/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 527945, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/4b35c6bf/uploads/origins/56c25a8b-9cfe-4821-a32d-65a15879cdff?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=79097a856d86b5a07d543e81445a2412", "srcset": "https://si.imgix.net/4b35c6bf/uploads/origins/56c25a8b-9cfe-4821-a32d-65a15879cdff?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=79097a856d86b5a07d543e81445a2412, https://si.imgix.net/4b35c6bf/uploads/origins/56c25a8b-9cfe-4821-a32d-65a15879cdff?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=570ec8dd5d94b6d2f119aa1d0ecde1e8 2x, https://si.imgix.net/4b35c6bf/uploads/origins/56c25a8b-9cfe-4821-a32d-65a15879cdff?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=2d4daeeb9f29ca91d6d6b207b92eb3af 3x"}, "duration": null, "nsfw": true, "hardcore": true, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/4b35c6bf/uploads/origins/56c25a8b-9cfe-4821-a32d-65a15879cdff?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=7fca1a848382a0806f4a32923691af7d", "srcset": "https://si.imgix.net/4b35c6bf/uploads/origins/56c25a8b-9cfe-4821-a32d-65a15879cdff?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=7fca1a848382a0806f4a32923691af7d, https://si.imgix.net/4b35c6bf/uploads/origins/56c25a8b-9cfe-4821-a32d-65a15879cdff?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=c9c731bc36caaf2382d8b0374dc2c500 2x, https://si.imgix.net/4b35c6bf/uploads/origins/56c25a8b-9cfe-4821-a32d-65a15879cdff?bg=%23fff