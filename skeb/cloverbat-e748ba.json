9ff-acd8-e0ad3600c829?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&blur=200&s=d921e810effd36be0b64c9bce55d6575, https://si.imgix.net/c3e56f07/uploads/outputs/566212d5-4713-49ff-acd8-e0ad3600c829?bg=%23fff&fm=webp&auto=compress&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=4784b0057340059837304d8af300c17d 2x, https://si.imgix.net/c3e56f07/uploads/outputs/566212d5-4713-49ff-acd8-e0ad3600c829?bg=%23fff&fm=webp&auto=compress&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=7c0f9a7311e91d761d6e8b4162166f3f 3x"}, "body": "たろべぇちゃん先生、初めまして。先生のアニメーションを見て、とても素敵なスタイルだと思いました。TRPGで使用している私と友人のキャラクターも描いていただきたいと思いリクエストをお送りいたしました。\n\n【依頼内容】\n二人が一緒にタバコを吸っていて、ハールがイネスに腕を回している様子を描いていただけると嬉しいです。一本のタバコを分け合って、順番に吸っているような場面なら良いですが、必ずしもそうである必要はありません。二人とも、少し疲れたような笑みを浮かべているのがいいと思います。\n\n【キャラクター詳細】\nイネスは気難しい映画監督で、見た目ほどには冷酷ではなく、実はとても優しい人物です。彼の顔にはいつも疲れと緊張がにじんでいます。\n\nハールは元軍人で、非常に冷酷な性格ですが、芸術とイネスに対しては優しい一面を見せます。彼は散らかし屋で、無頓着なところもあります。また、イネスよりもかなり背が高いです。\n\n\n【使用用途】\n・友人への共有\n・SNS等での個人利用\n\nもしリクエストに何か問題があれば、再送やキャンセルしていただいても構いません。リクエストをご検討いただきありがとうございます。よろしくお願いいたします。😊\n\nhttps://drive.google.com/drive/folders/1rlQwqam7R5IC6Gmb-VQHjvlw0hr1TStg?usp=sharing", "nc": 129, "word_count": 0, "transcoder": "video", "creator_acceptable_same_genre": true}, {"path": "/@IT_ONO_/works/150", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 938132, "client_id": 2206301, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/c923f2d4/uploads/origins/a068efbb-e220-470d-86ff-52e8f36a8487?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=aced81bfca718b57334013ba138cc495", "srcset": "https://si.imgix.net/c923f2d4/uploads/origins/a068efbb-e220-470d-86ff-52e8f36a8487?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=aced81bfca718b57334013ba138cc495, https://si.imgix.net/c923f2d4/uploads/origins/a068efbb-e220-470d-86ff-52e8f36a8487?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top