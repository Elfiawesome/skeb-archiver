。\n\n\n以上になります。\nこれからも応援しています。\n宜しくお願い致します。\n\nhttps://x.com/koguma_choko/status/2020096380392600031?s=46&t=cqdyqHixf27cVFiOYuIJcA", "nc": 9, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 2662938, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "霜月", "screen_name": "mis0ka1130", "avatar_url": "https://pbs.twimg.com/profile_images/1900461460985204736/bGD5A8hN.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1638515224239292417/1744618788/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 15, "complete_expiration_days": 60, "skills": [{"genre": "art"}], "nc": 145}, {"id": 2748826, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "迅瀬ツナ", "screen_name": "_Tokise", "avatar_url": "https://pbs.twimg.com/profile_images/1948404696076689408/eXBMBSrD.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1654957537870086144/1753519778/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 120, "skills": [{"genre": "art"}, {"genre": "comic"}, {"genre": "correction"}], "nc": 17}, {"id": 3272794, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "_KTTL_@Kindleにてエッセイ配信中！", "screen_name": "_kttl_", "avatar_url": "https://pbs.twimg.com/profile_images/1636649098844737536/tdcqKtj8.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1618857800482041856/1709553133/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, 