\n超常現象の調査員で、いつも笑顔で人付き合いがいい。普段はとても友好的だが、必要に応じて真剣になることもある。妹のことを気にしすぎることは、時に妹を困らせることもある。\n\n妹\n大学生で、兄と2人暮らし。彼女は無邪気で優しい少女で、兄に依存している。\n\n二人とも青い目の黒猫を飼っていて、二人とも黒猫が大好きだ。\n\n衣装が2セット以上ある場合は、好きなのセットを選んで描いてください。具体的な構図やポーズ等はまた先生にお任せしたいと思いますので、ご自由に描いて頂けたら幸いです。\nお読みいただき、ありがとうございました！\n\nhttps://drive.google.com/drive/folders/1sBQJik9Sjd-wZO2SsG_h3X1I6TGsv8C8", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@henpenkene_2/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3739673, "client_id": 2178819, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/fa34ccc9/uploads/origins/40675f13-44e9-4bf1-acef-f55ef3c79abc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=06cbaf773bb8e081138d93b99ca01c4f", "srcset": "https://si.imgix.net/fa34ccc9/uploads/origins/40675f13-44e9-4bf1-acef-f55ef3c79abc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=06cbaf773bb8e081138d93b99ca01c4f, https://si.imgix.net/fa34ccc9/uploads/origins/40675f13-44e9-4bf1-acef-f55ef3c79abc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=863ab634f3d0e253240a26ca949dd27c 2x, https://si.imgix.net/fa34ccc9/uploads/origins/40675f13-44e9-4bf1-acef-f55ef3c79abc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b6f026fee59aa7104ebad3abd8461ceb 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/fa34ccc9/uploads/origins/40675f13-44e9-4bf1-acef-f55ef3c79abc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=649939c8642ab6669836b7a9e1053780", "srcset": "https://si.imgix.net/fa34ccc9/uploads/origins/40675f13-44e9-4bf1-acef-f55ef3c79abc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=649939c8642ab6669836b7a9e1053780, https://si.imgix.net/fa34ccc9/uploads/origins/4