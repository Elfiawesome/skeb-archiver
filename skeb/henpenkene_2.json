rop=top&w=200&h=200&blur=200&s=03fdf35f32d2cdd574772f1ee47ecca0", "srcset": "https://si.imgix.net/232d220b/uploads/origins/21c1f45f-d005-49af-99d6-c5be511291f0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=03fdf35f32d2cdd574772f1ee47ecca0, https://si.imgix.net/232d220b/uploads/origins/21c1f45f-d005-49af-99d6-c5be511291f0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=1e04b520f2ce65645a80e282c118d53b 2x, https://si.imgix.net/232d220b/uploads/origins/21c1f45f-d005-49af-99d6-c5be511291f0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=4defdc647bccc33fdae62ede91aa712b 3x"}, "body": "こんにちは、えびよ先生！ この2人のキャラクターをお願いしたいです。男の子は「ベンムソン」で、女の子は「シャノール」です。 男は普段表情がなく冷静で落ち着いた人ですが、女と一緒にいると笑顔を浮かべます。女は活発で少し悪魔な感じがします。時々男をからかいます。\n 二人は輪廻者で、各時間と世界に輪廻し、二人は一緒に旅に出る勇者で、冒険の中で成長し、茶楼で一緒に生活し、お茶を歌いながら芝居の幼馴染で、日本料理店で食べ物を作って猫を飼っているウェイター、忙しい中で暇を探して、妖と伴って邪祟を除いた陰陽師で、世間の太平のために各地を走り回って、写真と紙で物語を記録した大正カメラマンと古書店のオーナー、桜の小雨の中で出会い、一緒に各銀河を行き来して一緒に探索する宇宙開拓者、一緒に輝かしい星河などを見て、二人は異なる身分を持ち、一緒に異なる物語を創造します。 \n構図は全部あなたに任せて、自由に発揮できます。もし金額が足りないようでしたら、お手数ですが指定の後再送要請を送っていただけると嬉しいです。 よろしくお願い致します。\nhttps://drive.google.com/drive/folders/105FC6bR0yj42TfgSDE0E0Jtzl_sPMHgc", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@henpenkene_2/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3739673, "client_id": 3517246, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/2bef9d56/uploads/origins/952da30d-687d-4023-b268-713fb184e3a0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c8488ffd601b8811d63afd4acfd0f0a9", "srcset": "https://si.imgix.net/2bef9d56/uploads/origins/952da30d-687d-4023-b268-713fb184e3a0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c8488ffd601b8811d63afd4acfd0f0a9, https://si.imgix.net/2bef9d56/uploads/origins/952da30d-687d-4023-b268-713fb184e3a0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c3c6cfaa2388a455a766303d66470888 2x, https://si.imgix.net/2bef9d56/uploads/origins/952da30d-687d-4023-b268-713fb184e3a0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=941e352891613e64d8afd6b2743a164d 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/2bef9d56/uploads/origins/952da30d-687d-4023-b268-713fb184e3a0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=97aa4cab097b03fbb9ab6ec932e9d9fb", "srcset": "https://si.imgix.net/2bef9d56/uploads/origins/952da30d-687d-4023-b268-713fb184e3a0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=97aa4cab097b03fbb9ab6ec932e9d9fb, https://si.imgix.net/2bef9d56/uploads/origins/952da30d-687d-4023-b268-713fb184e3a0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=d9a8e8cc314449b94152de9aff51ecb7 2x, https://si.imgix.net/2bef9d56/uploads/origins/952da30d-687d-4023-b268-713fb184e3a0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=9803278690d284c27a92639ab7e60d66 3x"}, "body": "こんにちは、えびよ様！！あなたの作品がとても好きです。私のオリジナルキャラクターの絵を描いていただきたいのですが。\n\n⚪白い髪の子：15歳で、ずっと昔に死んでしまったが、黒髪の男によって蘇らされた。コミュニケーションが苦手で、現在のすべてのものに興味を持っている。黒髪の男の血を食べて生きている。\n\n⚫黒髪の子：18歳で、右目は瞳孔の色が赤い義眼（片目として描ける）をしており、顔には自分でナイフで切った傷がある。いつも笑顔を浮かべており、自分が長くは生きられないことを知っていてもなお楽観的である。\n\n二人の感情：白はとても名高い宗師であるにも関わらず、生涯の記録を一切残していない。黒は、白があまりにも高い位置に立ち、真にこの世界を見たことがないため、死をもって現実の世界から逃れていると考えています。そのため、白を復活させ、彼にこの現実の世界をしっかりと見せたいと思っています。同時に、黒自身も真の白を見たいという願望を持っています。白も黒の行動や考えが面白いと感じたので、二人は名を隠して平凡で騒がしい生活を送っている。黒は白に対して非常に直接的で、ほとんど何でも話すが、ただ一つだけどう切り出せばいいかわからないことがある。それは、彼らの命が繋がっているということ、黒はほとんど自分の命を燃やし尽くして白を復活させたため、彼らには残り二年しか生きられないということだ。\n\n\n\n\n閲覧お疲れ様でした！私は日本语があまり得意ではない…以上の文章は流暢ではないかもしれません、ご容赦ください…！依頼を引き受けていただけると嬉しいです。ありがとうございます！もし金額が希望に添えない場合調整していただけたら幸いです！(｡´-ω)(ω-｀｡)\n\n参考：https://drive.google.com/drive/folders/1WNCJj6XgV_BkphsF5X3juknxjnvEw_sq?usp=sharing", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@henpenkene_2/works/3", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/d292c703/uploads/origins/a7bb6fad-453e-42eb-97b4-845d6a1685b7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=dd0a51b07a376e5fb8bd409c52387b2f", "srcset": "https://si.imgix.net/d292c703/uploads/origins/a7bb6fad-453e-42eb-97b4-845d6a1685b7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=dd0a51b07a376e5fb8bd409c52387b2f, https://si.imgix.net/d292c703/uploads/origins/a7bb6fad-453e-42eb-97b4-845d6a1685b7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=9cf6e885f5bdd511c527ec2c380cedd1 2x, https://si.imgix.net/d292c703/uploads/origins/a7bb6fad-453e-42eb-97b4-845d6a1685b7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=961516f9e55dfaacd1cf050e4aa17fb6 3x"}, "private": true, "genre": "art", "tipped": false, "creator_id": 3739673, "client_id": 2217313, "nc": 17}, {"path": "/@henpenkene_2/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3739673, "client_id": 234985, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/33322601/uploads/origins/8d8c61c2-c379-42c3-ab66-5b4882aa711c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0ba764f06f66d6c8bfc647a563d77ae2", "srcset": "https://si.imgix.net/33322601/uploads/or