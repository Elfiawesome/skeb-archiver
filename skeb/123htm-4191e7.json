op&w=200&h=200&s=7f137d67fe580768c0d41577121b5b37", "srcset": "https://si.imgix.net/01422896/uploads/origins/815a067a-5a0b-42d4-8cd1-2653b879421b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7f137d67fe580768c0d41577121b5b37, https://si.imgix.net/01422896/uploads/origins/815a067a-5a0b-42d4-8cd1-2653b879421b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=5f9d078f146756cbdfc9ce5f9e721fd6 2x, https://si.imgix.net/01422896/uploads/origins/815a067a-5a0b-42d4-8cd1-2653b879421b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f1bf01663dd06ca0dd8d90577ac4a4e6 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/01422896/uploads/origins/815a067a-5a0b-42d4-8cd1-2653b879421b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=383f41c4f24f82048a651ea3112ca4c1", "srcset": "https://si.imgix.net/01422896/uploads/origins/815a067a-5a0b-42d4-8cd1-2653b879421b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=383f41c4f24f82048a651ea3112ca4c1, https://si.imgix.net/01422896/uploads/origins/815a067a-5a0b-42d4-8cd1-2653b879421b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=9a3ce6e8e462ca89958a825c15695408 2x, https://si.imgix.net/01422896/uploads/origins/815a067a-5a0b-42d4-8cd1-2653b879421b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=8b149b772cf4fb1076e6d516224183d9 3x"}, "body": "321123先生、こんにちは。\n先生の絵が好きです。\nもしよろしければ、うちのオリジナルキャラクターの描き下ろしをお願いしたいと思います。\n\nこの子は旅の召喚士です。無邪気で、好奇心が強い、たいてい純真で、明るく、優しい女の子。本質的には無意識の、魔物に似た混沌とした性質を持つ(意識的な悪意ではない)が、普段はコントロールできる状態。\nファンタジーJRPGのような世界観の中にいるキャラクターです。\n平和な時代、とある小さな異界の全ての魔物の代理外交官として、皆の食費を稼ぐために雇われて各国を渡り歩いていた。「伝説の一人兵団」と呼ばれる。\n彼女がもともと所属していた異界「タロエルム」は、資源に乏しく単調で狭い、魔物しかいないの世界だった。そのため境界のないほど広い世界、人間やその他さまざまな種族が共に生きる世界に対して、探究心に満ちている。\n\nフードをかぶっているかどうか、リュックを肩にかけているかどうか、好きな状態を選んでください。フードをかぶっていない状態では、背中の長いおさげが見えてしまうので注意してください。黒い羽は彼女のシュシュです。\n人間の若い女の子のようにはつらつとした明るい一面もあれば、魔物の集合意識の塊としての混沌な一面もあるキャラクターです。どんな形で描いてもOKです。\n構図やポーズは、ご自由に決めてください。\nご検討よろしくお願いします！\n\nhttps://drive.google.com/drive/folders/1kFCz6id6FcZqEA5VTOul-LnzQvY6KqHj?usp=share_link", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@123htm/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 52485, "client_id": 2248464, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/e51018ed/uploads/origins/a1b11881-f0b8-4c19-8086-2c96df5d1be0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7e43723b648e504fda2026e5001345c6", "srcset": "https://si.imgix.net/e51018ed/uploads/origins/a1b11881-f0b8-4c19-8086-2c96df5d1be0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7e43723b648e504fda2026e5001345c6, https://si.imgix.net/e51018ed/uploads/origins/a1b11881-f0b8-4c19-8086-2c96df5d1be0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=2b2ec047d8f8ccbd25b59d5ec8fc3dd2 2x, https://si.imgix.net/e51018ed/uploads/origins/a1b11881-f0b8-4c19-8086-2c96df5d1be0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=26e9c614704a92934d0d47a929fcd704 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/e51018ed/uploads/origins/a1b11881-f0b8-4c19-8086-2c96df5d1be0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ed2ef83ecb6343b48f32cca4af5bedf7", "srcset": "https://si.imgix.net/e51018ed/uploads/origins/a1b11881-f0b8-4c19-8086-2c96df5d1be0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ed2ef83ecb6343b48f32cca4af5bedf7, https://si.imgix.net/e51018ed/uploads/origins/a1b11881-f0b8-4c19-8086-2c96df5d1be0?bg=%23fff&auto=format%2Ccompress&fm=webp&