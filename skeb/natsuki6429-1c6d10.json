s&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=15dc465f54ece7be0cb6a137a6152f71 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/2b543b02/uploads/origins/226c3e58-414c-4ac7-8621-b3a6d199a15c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=bbcb63bfaab53b306522acdabca1a620", "srcset": "https://si.imgix.net/2b543b02/uploads/origins/226c3e58-414c-4ac7-8621-b3a6d199a15c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=bbcb63bfaab53b306522acdabca1a620, https://si.imgix.net/2b543b02/uploads/origins/226c3e58-414c-4ac7-8621-b3a6d199a15c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=2ff35ccce457503eadb6cd3d261f70e9 2x, https://si.imgix.net/2b543b02/uploads/origins/226c3e58-414c-4ac7-8621-b3a6d199a15c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=80fd8d68c5ec09e32c6bdbbcd2cfb9c7 3x"}, "body": "菜月様、はじめまして。\n個人VTuberの光りりあと申します。\n主にサッカーの同時視聴などで活動しております。\n\n先生が描いておられた少女のイラストがかわいいと思い、ぜひ私もお願いしたいです。\n特にこちらの雰囲気が素敵です。\nhttps://skeb.jp/@natsuki6429/works/12\n\n【お願いしたい内容】\n今回はチャンネル内で行っていた「ファンタジープレミアリーグ」(以下FPL)の優勝者とり天さんへの記念イラストを描いてほしいです。\n（※FPLとは、ゲーム内で実在選手を選び、その選手が現実の試合で活躍すると、ゲーム内でポイントが入るので、その得点を年間で競うゲームです）\n\n【ポーズの指定など】\n光りりあが、笑顔でとり天さんにトロフィーを両手で手渡ししてる図を描いてください。\n光りりあは基本装備のジャケット羽織ってます。\nトロフィーは実際のプレミアリーグのトロフィーを参考にした形で\"Riria League\"と刻まれていて、赤と黒のリボンがついています。\n参考：https://dentsu-ho.com/articles/905\nとり天さんは、いらすとやの人物のような顔で、マンチェスター・ユナイテッド24-25ホームデザインのようなユニフォームを着せてください。\n参考：https://www.sskamo.co.jp/adidas/club/mufc.html\n\n【光りりあの性格・設定など】\n・バーチャル12歳！身長は139㎝くらい。年齢より幼い雰囲気\n・プリキュアのようなアニメの女の子を目指してます。\n・大人しい性格ですが、サッカー好き\n・やや天然ボケ\nYoutube：https://youtu.be/iC-DaUK8B0g\n\n描いて頂けた場合、Youtubeのサムネイルや、TwitterなどSNSで使いたいなと思っています。\nその際、PSD形式でレイヤー分けをいただければ幸いです。\nまた、優勝記念用イラストとしてプレゼントしたいので「とり天」さんのSNSでも使用許可を頂けたらと思います。\n\nもし上記内容で可能でしたら、ぜひお願いいたします。\n光りりあ\n\n参考\nhttps://riria-hikari.fanbox.cc\nhttps://twitter.com/Riria_Hikari/status/1598465783692431360?s=20\n\nhttps://x.com/Riria_Hikari/status/1796465638535537008", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@natsuki6429/works/15", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 496204, "client_id": 594446, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/e381bd2b/uploads/origins/ff9f04b5-5410-4804-a450-9336852dcef2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e486775b91347229da9bd6f7c373bba8", "srcset": "https://si.imgix.net/e381bd2b/uploads/origins/ff9f04b5-5410-4804-a450-9336852dcef2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e486775b91347229da9bd6f7c373bba8, https://si.imgix.net/e381bd2b/uploads/origins/ff9f04b5-5410-4804-a450-9336852dcef2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=0b11548174b96807db804862405281d2 2x, https://si.imgix.net/e381bd2b/uploads/origins/ff9f04b5-5410-4804-a450-9336852dcef2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=da5a6c624bc0e889c8093f0d58ec56ea 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/e381bd2b/uploads/origins/ff9f04b5-5410-4804-a450-9336852dcef2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=00909d2b4efe368d6727f8a8a662ed79", "srcset": "https://si.imgix.net/e381bd2b/uploads/origins/ff9f04b5-5410-4804-a450-9336852dcef2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=00909d2b4efe368d6727f8a8a662ed79, https://si.imgix.net/e381bd2b/uploads/origins/ff9f04b5-5410-4804-a450-9336852dcef2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=9eb4f254b314823a8404d01e84030f84 2x, https://si.imgix.net/e381bd2b/uploads/origins/ff9f04b5-5410-4804-a450-9336852dcef2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=4e09ffda7e252666685029500aaf9447 3x"}, "body": "こんにちは、期限超過キャンセルされてたみたいなので再送します。ご都合上問題ありましたらキャンセルでも構いません。\n※以下同文です。\n\n菜月様初めまして。Jakshaと申します。\n可愛らしいづほちゃんのイラストを見かけたので、依頼しようと思いました。\nマイナーキャラですが、がんばれゴエモン 東海道中大江戸天狗り返しの巻でプレイヤーキャラになる予定だった女剣士の鈴ちゃんを描いてほしいです。\nhttps://web.archive.org/web/20060509060543/http://www.konami.jp/gs/game/goegoe/library/0722_i_05.html\nポーズ、構図等はおまかせしますが、モチーフとかイメージを取り入れるなら風とか竜巻とかにしてほしいですね（赤胴〇之助的な意味で）\nhttps://0685816eae.seesaa.net/article/a9237860.html\n\nついでにプレイ動画も貼っておきます（登場するシーンは開始から13：00辺りまで2分半程度）\nストーリー的には封印を解いてからそれっきりなので、この動画だけ見ておけばいいかと。\nhttps://www.youtube.com/live/Bn4SfKs93zg?feature=share&t=638\n\nご検討宜しくお願いします。\n\nhttps://drive.google.com/drive/folders/1odvRKR9L72mNdqKZQbTa0ukez7ZvRZs-?usp=sharing", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@natsuki6429/works/14", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 496204, "client_id": 2570738, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/6f672a48/uploads/origins/2f574c9d-acb0-4a5e-b383-cf7999392443?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=502e8b0c5347d8fd05cb432dde474097", "srcset": "https://si.imgix.net/6f672a48/uploads/origins/2f574c9d-acb0-4a5e-b383-cf7999392443?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=502e8b0c5347d8fd05cb432dde474097, https://si.imgix.net/6f672a48/uploads/origins/2f574c9d-acb0-4a5e-b383-cf7999392443?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=4fb240581f0fbc83b48a5dce0d2a3926 2x, https://si.imgix.net/6f672a48/uploads/origins/2f574c9d-acb0-4a5e-b383-cf7999392443?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=1fa703aa7edbc4921c519dcf38b56840 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_