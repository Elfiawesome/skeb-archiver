fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=9a0c9df0ccb30f2b21e4186888451739 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/247b614f/uploads/origins/6461776d-34be-4160-921e-c28bca23fcd5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=88b7ae93ef498b37f2c2cd932c41f6b6", "srcset": "https://si.imgix.net/247b614f/uploads/origins/6461776d-34be-4160-921e-c28bca23fcd5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=88b7ae93ef498b37f2c2cd932c41f6b6, https://si.imgix.net/247b614f/uploads/origins/6461776d-34be-4160-921e-c28bca23fcd5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=2e3fc7bcd7bce691883d481ca4ef5ef6 2x, https://si.imgix.net/247b614f/uploads/origins/6461776d-34be-4160-921e-c28bca23fcd5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=507897b694312052024c2289c7a22584 3x"}, "body": "マスターの眼前で射精機能付き双頭ディルドハメ責め4Pレズセックスでアへ顔絶叫受精アクメを披露する遊戯王の《RAI-MEI》、《教導の聖女エクレシア》、《重騎士プリメラ》、《教導の騎士フルルドリス》をリクエストさせて頂きます\n\n受け:プリメラとエクレシア\n\n竿役:RAI-MEIとフルルドリス。極悪サイズの双頭ディルドを装着(自分達も片側を挿入済み)している。ディルドは玉袋の造形付きでそこにマスターの精液が充填されている設定です。\n\n体型は全員全身むちむちの頭身高めで、乳のサイズは頭より大きく上半身を目一杯覆い、股間がギリギリ見えるくらいの超乳で、可能な限り大きくして下さい。乳首と乳輪はともに大きめでパフィーニップル状。\n服装は全員元のカードのイラストで着ている物で、RAI-MEIとは股間が穴空きで乳首と乳輪が衣装の布地越しにくっきりと浮かんでいる。プリメラ・エクレシア・フルルドリスは鎧の胸部分と腰の前垂れなどを外して乳房と股間を完全に露出した状態\n\nRAI-MEIとフルルドリスが二人並んで寝ており、その上にプリメラとエクレシアの二人がそれぞれ跨がり騎乗位で攻められている構図で、受け二人を正面から写し、攻め役二人の様子は顔から股間までを収めたワイプを別枠で写すようお願いします。\n\n挿入前。攻め二人が挿入を焦らし、受け二人はそれに対し完全に堕ちきった様子で媚びながら挿入を懇願しつつ、全員でマスターに自分達の痴態を見てもらうよう声を掛ける。\n↓\n挿入時。攻め二人が同時に挿入し、受け二人はその衝撃で間抜けな叫び声を上げ即堕ちアへ顔アクメを晒す。\n↓\n挿入後。激しくピストンしながら全員とも軽めのアへ顔でオホ声混じりの淫語を連発しよがっている。\n↓\n同時絶頂&膣内射精。全員ディルドが子宮口を突破子宮の奥深くまで突き刺さる。そのまま子宮に直接精液が発射され、断面図に卵子と精子が受精するカットインが付く。\n三人とも汚い口調で淫語と妊娠宣言を絶叫しながらイき、白目を剥いたここ一番の変顔に片足突っ込んだアへ顔になる。\n\n…という流れで、4人それぞれにセリフを付けて頂きたいです。キャラの性格や口調はお好きなイメージでおまかせ致します。\n\n何卒宜しくお願い致します。\n\nhttps://drive.google.com/drive/folders/14yhwCzNly1V-U9cFag4hy2Gl7y6BvWs3", "nc": 49, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Kotone_Madoka/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 427654, "client_id": 3378477, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/ac000cd5/uploads/origins/e45fbf50-9961-4732-aad1-264f599af01b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=971e64d023a537d164727763ee10eec9", "srcset": "https://si.imgix.net/ac000cd5/uploads/origins/e45fbf50-9961-4732-aad1-264f599af01b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=971e64d023a537d164727763ee10eec9, https://si.imgix.net/ac000cd5/uploads/origins/e45fbf50-9961-4732-aad1-264f599af01b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=2a4d418097565ab57a278df2d4b59b20 2x, https://si.imgix.net/ac000cd5/uploads/origins/e45fbf50-9961-4732-aad1-264f599af01b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=dce6499cecfe46e3522ddf50d4844d22 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/ac000cd5/uploads/origins/e45fbf50-9961-4732-aad1-264f599af01b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=33a6aaa463dbae12be9fa045b39d5a5c", "srcset": "https://si.imgix.net/ac000cd5/uploads/origins/e45fbf50-9961-4732-aad1-264f599af01b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=33a6aaa463dbae12be9fa045b39d5a5c, https://si.imgix.net/ac000cd5/uploads/origins/e45fbf50-9961-4732-aad1-264f599af01b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=7a1d2790ff03588e4124a2403ac09dd5 2x, https://si.imgix.net/ac000cd5/uploads/origins/e45fbf50-9961-4732-aad1-264f599af01b?bg=%23fff&auto=format%2Cco