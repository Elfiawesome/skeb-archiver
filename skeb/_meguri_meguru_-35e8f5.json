.net/fb9136d1/uploads/origins/989e636f-408b-408e-8c83-e40da26bd81a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5c02bce4ab7b7061529ec4c75525fdba", "srcset": "https://si.imgix.net/fb9136d1/uploads/origins/989e636f-408b-408e-8c83-e40da26bd81a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5c02bce4ab7b7061529ec4c75525fdba, https://si.imgix.net/fb9136d1/uploads/origins/989e636f-408b-408e-8c83-e40da26bd81a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=119bcffb0ad34bcf6ac6d09a336d35ce 2x, https://si.imgix.net/fb9136d1/uploads/origins/989e636f-408b-408e-8c83-e40da26bd81a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=6b8117832577b9d911a05a8426f390df 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/fb9136d1/uploads/origins/989e636f-408b-408e-8c83-e40da26bd81a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e472d283c998bd61f2cd30f8f68d1545", "srcset": "https://si.imgix.net/fb9136d1/uploads/origins/989e636f-408b-408e-8c83-e40da26bd81a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e472d283c998bd61f2cd30f8f68d1545, https://si.imgix.net/fb9136d1/uploads/origins/989e636f-408b-408e-8c83-e40da26bd81a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=251827e69110f65eeb86119f85557519 2x, https://si.imgix.net/fb9136d1/uploads/origins/989e636f-408b-408e-8c83-e40da26bd81a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=41b170ffaa81ecc9adafe61acdcea658 3x"}, "body": "こんにちは！\nこれまでの作品を見て、すっかりファンになってしまいました。ぜひ、私のVTuberキャラクター「Neexith」で、あなたのスタイルを活かしたイラストを描いてほしいです！\n\n彼女は「生きたパラドックス」です。Neexithがパラドックスである理由は、魂を持たないにもかかわらず、魂こそが存在の手段であるこの世界で生きており、感情を見せているように見えるからです！通常、パラドックスは人間の姿をしていないものですが、彼女は例外……というか、まあ、ある意味では！\n\nNeexithは優しく、少し内気で不安がりなため、あまり外に出ません。しかし、とても前向きで、人や状況