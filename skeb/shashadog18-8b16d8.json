a-84b997f7a9e6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e1d6a16dc4bfa7e795eabcfdb482dc71 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/2a4baa05/uploads/origins/7c7c4d98-0e9d-495a-9e8a-84b997f7a9e6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=1a01572b5540f96a606051a1b952cc65", "srcset": "https://si.imgix.net/2a4baa05/uploads/origins/7c7c4d98-0e9d-495a-9e8a-84b997f7a9e6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=1a01572b5540f96a606051a1b952cc65, https://si.imgix.net/2a4baa05/uploads/origins/7c7c4d98-0e9d-495a-9e8a-84b997f7a9e6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=0c458657a55cf2ec4db52bfbc6e60d8c 2x, https://si.imgix.net/2a4baa05/uploads/origins/7c7c4d98-0e9d-495a-9e8a-84b997f7a9e6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=a00823686da2827601bd3ce0360a9eef 3x"}, "body": "初めまして\n\n内容がハードですので気のりしなければキャンセルしていただいて構いません。\n\nオリジナルキャラで、昔の農家の20代前半、\n純朴そうな黒髪女性の緊縛イラストをリクエストしたいです。\n髪型、顔だち、体型はお任せします。\n\n恰好\n野良着、もんぺ、足袋履きで、\n胸をだしてM字開脚縛りされています。\n表情は縛られて、泣いている感じにしてほしいです。\n頭から爪先まで全身を描いてほしいです。\n\n服装\n野良着の色は紺、模様は適当に、\nもんぺはへその下辺りで紐を結ぶ袴式、長さはくるぶしまでで、色、模様は濃い紫系の縞、\n足袋はくるぶしの上までの長さ、色は赤、足袋底は白にしてほしいです。\nできれば、もんぺと足袋の間から脚の地肌が少し見えるようにしてほしいです。\nもんぺイメージ\nhttps://www.dropbox.com/s/27dregu6fv4xgh3/ms.jpg?dl=0\n\nまた\n股間部分を破られ、陰部に極太の張型が挿入され\n表情も痛さで苦しそうに目をつぶり涙を流して絶叫している状態もお願いします。\n\nつたない説明で恐縮ですが説明不足な点、ポーズ、構図など自由に\n変更、アレンジしていただいて構いませんが、\n必ずもんぺが破れていない状態と破れた状態の2種を描いていただきたいです。\n\n以上ご検討の程宜しくお願い致します。\n\nhttps://www.dropbox.com/s/shhirdcz5xps18w/sm01.png?dl=0", "nc": 176, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@shashadog18/works/3", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/585da230/uploads/origins/abafd87b-c96b-453d-b16c-79c71e5c2c4c?bg=%23fff&auto=format%2Ccompr