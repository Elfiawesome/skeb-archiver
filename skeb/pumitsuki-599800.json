てもOKですがもちろん見えててもOKです\n\n・レオタードについてですがふんわりとした質感にして欲しいです下記のリンクのレオタードのようなイメージです\nhttps://image.rakuten.co.jp/dancenets/cabinet/leotard/02821061/cc101c_main.jpg\n\n・使用用途ですが他の人に依頼する際の服装の参考画像して使用したいです\n\n以上です", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@pumitsuki/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3279811, "client_id": 287388, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/a36080b5/uploads/origins/5da87287-ab01-4a98-b484-7bdbbf6f0012?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3ce7f90564b1d3b089657d5671026abd", "srcset": "https://si.imgix.net/a36080b5/uploads/origins/5da87287-ab01-4a98-b484-7bdbbf6f0012?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3ce7f90564b1d3b089657d5671026abd, https://si.imgix.net/a36080b5/uploads/origins/5da87287-ab01-4a98-b484-7bdbbf6f0012?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=5702a8ed084e207ecf555b99b1200abf 2x, https://si.imgix.net/a36080b5/uploads/origins/5da87287-ab01-4a98-b484-7bdbbf6f0012?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=fcdef9567264c88a69dd76a1871b5ce1 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/a36080b5/uploads/origins/5da87287-ab01-4a98-b484-7bdbbf6f0012?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=8c8d5af4e59db57eb0dc0b1a2d88477f", "srcset": "https://si.imgix.net/a36080b5/uploads/origins/5da87287-ab01-4a98-b484-7bdbbf6f0012?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=8c8d5af4e59db57eb0dc0b1a2d88477f, https://si.imgix.net/a36080b5/uploads/origins/5da87287-ab01-4a98-b484-7bdbbf6f0012?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=c848cc3a9a185a2baef6e8