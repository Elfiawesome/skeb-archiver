いて人懐っこい性格です。犬の角度は難しければ後ろ姿でも見切れていても構いませんし、難しければカットしていただいてもいいです。\nメインはオルダブの二人でお願いします。", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "similar_creators": [{"id": 57404, "creator": true, "nsfw_acceptable": true, "acceptable": false, "name": "そごう", "screen_name": "Coltwing", "avatar_url": "https://pbs.twimg.com/profile_images/1452765627400142851/ypzxUASK.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1289024912/1635201337/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 15, "complete_expiration_days": 30, "skills": [{"genre": "art"}, {"genre": "correction"}], "banned": false, "nc": 177}, {"id": 103723, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "けのもの", "screen_name": "__Mas9", "avatar_url": "https://pbs.twimg.com/profile_images/1842602030382362625/rCUtgrsx.jpg", "header_url": "https://pbs.twimg.com/profile_banners/2546324824/1647522385/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 7, "complete_expiration_days": 90, "skills": [{"genre": "art"}, {"genre": "correction"}], "banned": false, "nc": 144}, {"id": 236230, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "あきと七つの🐏SDイラスト仕事募集中", "screen_name": "akito_nanatsuno", "avatar_url": "https://pbs.twimg.com/profile_images/2020857160859885568/Y1sMMVC5.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1021268411190468609/1745043550/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "art"}, {"genre": "comic"}