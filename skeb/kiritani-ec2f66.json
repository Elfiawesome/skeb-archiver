8a-4144-bb53-5bbba2b25d91?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=914f4e6f33a813d0e92f87b8d6b9f665", "srcset": "https://si.imgix.net/4c4e6cf5/uploads/origins/17a6cd08-8a8a-4144-bb53-5bbba2b25d91?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=914f4e6f33a813d0e92f87b8d6b9f665, https://si.imgix.net/4c4e6cf5/uploads/origins/17a6cd08-8a8a-4144-bb53-5bbba2b25d91?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=ea395d529cbd5116d3f8d4cfcf6b782c 2x, https://si.imgix.net/4c4e6cf5/uploads/origins/17a6cd08-8a8a-4144-bb53-5bbba2b25d91?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=6e23b522227ed1ec272a0a9f21a0f2cc 3x"}, "body": "こんにちは。Twitterでいつも性癖に刺さるヤンデレを見ておりました。\n\nVtuberの星降あめるがヤンデレナースになって主人公を監禁するイラストをお願いします。\n\n<シチュエーション>\n・ヤンデレナースの星降あめるが、入院と称して廃病院で主人公を監禁する\n・主人公は若干違和感を抱きつつも監禁されていることに気づいていない\n\n<内容>\n・ナースの服は薄いピンク\n・ベッドに寝た状態でナースを見る視点\n・ナースは主人公の腕を掴んで胸に当てさせる（揉ませる感じ）\n・主人公は腕だけ映っている\n・主人公の腕は男女かわからない中性的な感じでお願いします\n・廃墟感のある背景(ひび割れた壁、割れたガラス窓などで明らかにわかる形で表現いただけるとありがたいです）\n・ピンク色の点滴がある\n\n<セリフ>\n主人公（ナースのあめるさん優しい人だなぁ。こんなに丁寧に面倒を見てくれるなんて。ただちょっとおかしいな。軽いケガのはずなのにもう半年も入院してる..）\nナース「XXXさん、『リハビリ』の時間ですよ」\n主人公(あっ、もうリハビリの時間か。あめるさんも応援してくれるし、頑張らないと)\n\n立ち絵は下記URL参照ください\nhttps://twitter.com/ameru_hoshifuru/status/1366312255910862852?s=20&t=Cmgw4z1yPB9YFPWiRIqlkA\n\nなお、タグは「星降あめる」「星降あーと」がよく使われていますのでご参考までに\n\nhttps://twitter.com/ameru_hoshifuru/status/1366312255910862852?s=20&t=Cmgw4z1yPB9YFPWiRIqlkA", "nc": 8, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@kiritani/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 19473, "client_id": 1642620, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/8131577e/uploads/origins/2b5c573b-a239-4ba9-b08d-b3faea5c9722?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2