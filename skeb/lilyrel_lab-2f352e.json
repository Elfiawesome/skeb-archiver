rop&crop=top&w=200&h=200&s=b55b3f77a36e26afd1563b20659a49e6 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/701034a2/uploads/origins/f2dd26d3-c91f-4fd8-b047-3faf1c04436f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b563d439b72256a8365aa77eb214dcbf", "srcset": "https://si.imgix.net/701034a2/uploads/origins/f2dd26d3-c91f-4fd8-b047-3faf1c04436f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b563d439b72256a8365aa77eb214dcbf, https://si.imgix.net/701034a2/uploads/origins/f2dd26d3-c91f-4fd8-b047-3faf1c04436f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=2a320521f11bc9cdaeb2d3d7c53d8828 2x, https://si.imgix.net/701034a2/uploads/origins/f2dd26d3-c91f-4fd8-b047-3faf1c04436f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=13f61961c66fd456d0b13f26f737c6f4 3x"}, "body": "はじめまして、個人Vtuberの夜桜シエルと申します。\n鉾立まな様の描く性癖に刺さるイラストを見て、ぜひとも依頼したいと思い今回送らせていただきました。\n\n今回描いてほしいものは\n首チンコ\n目チンコ\n舌チンコ\n奇数の複乳(5か3)＋乳首チンコ(玉がついてると嬉しいです)\n股間のチンコ(玉あり、複数あると嬉しいです)\nの要素が入った僕のイラストをお願いしたいです。\n\n特徴として青肌、青緑の目、桜色と紫のグラデ髪、粘膜の色が紫となっております。\n体色は普通の人間の色の方でも問題ありません。\nちんちんがたくさんあれば嬉しいです。あればあるほどお得だと思ってます。\n\nもしよろしければ、よろしくお願いします。\n\nhttps://drive.google.com/drive/folders/1ysYgbXNT4i_0R9rHnmLvrDSu-N20vnIw?usp=sharing", "nc": 160, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@lilyrel_lab/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2305869, "client_id": 182552, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/9ce0ddd1/uploads/origins/5a7bdbe0-945c-4100-9ad9-af26baba059d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=dd298bfb01dbeca1fbf98a5a30c1a07b", "srcset": "https://si.imgix.net/9ce0ddd1/uploads/origins/5a7bdbe0-945c-4100-9ad9-af26baba059d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=dd298bfb01dbeca1fbf98a5a30c1a07b, https://si.imgix.net/9ce0ddd1/uploads/origins/5a7bdbe0-945c-4100-9ad9-af26baba059d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e779f795806a27e425e483431414624d 2x, https://si.imgix.net/9ce0ddd1/uploads/origins/5a7bdbe0-945c-4100-9ad9-af26baba059d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=df849d72643dc063d75f0b5290b818d3 3x"}, "duration": null, "nsfw": true, "hardcore": true, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/9ce0ddd1/uploads/origins/5a7bdbe0-945c-4100-9ad9-af26baba059d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=53dfc85820faae970cba0e429428c88c", "srcset": "https://si.imgix.net/9ce0ddd1/uploads/origins/5a7bdbe0-945c-4100-9ad9-af26baba059d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=53dfc85820faae970cba0e429428c88c, https://si.imgix.net/9ce0ddd1/uploads/origins/5a7bdbe0-945c-4100-9ad9-af26baba059d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=07cc1a664cca044f5513aa3c61b90d38 2x, https://si.imgix.net/9ce0ddd1/uploads/origins/5a7bdbe0-945c-4100-9ad9-af26baba059d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=7a1abc8d951dab7e3264eeb6f5c66cbe 3x"}, "body": "初めまして。\n下記の通り依頼させて頂きます。\n\nテーマとしては、『もしも日本神話の八岐大蛇が、異形な8つのチンポを持った女性だったら』です。\nまず女性の特徴ですが、見た目は10代～20代で、黒髪ロングの姫カットの髪をしています。\n服装は出来れば薄手の白装束を、帯で結ばず前をオープンにした状態で羽織って頂きたいですが、難しければ裸でも全然構いません。\n胸のおっぱいは超乳サイズになっていますが、その上金玉までもおっぱいになっています。\n(下記URLの様な感じ)\nhttps://www.pixiv.net/artworks/108033775\nまた、金玉の大きさは数人程度なら余裕で乗っかれる位超巨大です。\nそして、股間には2本のチンポが生えていますが、初期段階では普通より少し大きい位です。\n\n以上の特徴を踏まえて、以下のシチュエーションをお願いしたいです。\n①女性は金玉の上にペタン座りで座っており、妖艶な笑みを浮かべています。この時、胸と金玉の乳首、そして2本のチンポに封印のお札が貼られています。\n②それぞれの部位にあったお札がなくなります。\n③股間のチンポが大きくなっていくと同時に、胸と金玉のおっぱいの乳首の穴が大きく開かれ、中にしまわれている大きな亀頭が露になります。\n　また、イラストには描けないと思いますが、この時アナルとおマンコからも亀頭が現れてきています。この時の彼女は頬を赤くし、少し興奮気味です。\n④両胸、両玉、おマンコ、アナル、そして複根の計8本の巨大チンポが出現します。それらはどれも蛇の様に太長でうねうねしていますが、これらのチンポが出る際に彼女は絶頂し、\n　イキ顔を晒しながらすべてのチンポから大量の精液を射精します。\n⑤全身精液塗れになり、金玉の下半分まで精液で埋め尽くした彼女は、うっとりと蕩ける様な顔をしながらこちらを見つめつつ、8本の大蛇チンポををこちらに向けてきます。\n　また、それらの中には尿道口から精液を涎の様に垂らしていたり、尿道口を口の様に大きく開けていたり、尿道口から蛇の舌を伸ばしている物があったりします。\n\n以上、ご検討頂けると幸いです。", "nc": 187, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@lilyrel_lab/works/1", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/78c47b38/uploads/origins/5206dd77-3aee-4bd2-8fcd-d9ff69393562?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=dcf0736c01c2bf5b92d03da713f22c0e", "srcset": "https://si.imgix.net/78c47b38/uploads/origins/5206dd77-3aee-4bd2-8fcd-d9ff69393562?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=dcf0736c01c2bf5b92d03da713f22c0e, https://si.imgix.net/78c47b38/uploads/origins/5206dd77-3aee-4bd2-8fcd-d9ff69393562?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=7092288d178ce868c47efaa30dcc657c 2x, https://si.imgix.net/78c47b38/uploads/origins/5206dd77-3aee-4bd2-8fcd-d9ff69393562?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=b671b0dd272d2a5f7fffa707377db0bc 3x"}, "private": true, "genre": "art", "tipped": false, "creator_id": 2305869, "client_id": 1853984, "nc": 32}], "sent_works": [{"path": "/@sushikunsu/works/13", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 294326, "client_id": 2305869, "vtt_url": null, "thumbna