を使うのは初めてなので、言葉遣いに失礼なところがあったら、申し訳ありません。\n\n翔さん，你好💗\n想找您来绘制梦主和狮子王司的双人梦图。希望您可以绘制全人类复兴之后的、时间在现代的甜蜜的恋爱故事，您可以随意设计服装和动作。\n梦主：经常微笑、温柔、直球、隐藏肉食系的姐姐系，总是被司くん宠爱。\n这是我第一次使用skeb，如果我的用词有不礼貌的地方，我深感抱歉。\n\nhttps://x.com/bandaotiehe1018/status/1620632273845620738?s=46\n\nhttps://x.com/bandaotiehe1018/status/1625150033074221059?s=46\n\nhttps://x.com/bandaotiehe1018/status/1757962046237515905?s=46\n\nhttps://x.com/bandaotiehe1018/status/1620632273845620738?s=46", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@kakeru_0404/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2908044, "client_id": 454284, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/dcae9a0d/uploads/origins/fbffa32f-5b9d-402c-9a27-36c9a7e95a78?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=14458764e7d9504704d4530b2cfdda2e", "srcset": "https://si.imgix.net/dcae9a0d/uploads/origins/fbffa32f-5b9d-402c-9a27-36c9a7e95a78?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=14458764e7d9504704d4530b2cfdda2e, https://si.imgix.net/dcae9a0d/uploads/origins/fbffa32f-5b9d-402c-9a27-36c9a7e95a78?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=64590faee734840a11a7c7aaf3475f15 2x, https://si.imgix.net/dcae9a0d/uploads/origins/fbffa32f-5b9d-402c-9a27-36c9a7e95a78?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ddfd02515f484ad95c5296be9b96b3d6 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/dcae9a0d/uploads/origins/fbffa32f-5b9d-402c-9a27-36c9a7e95a78?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=242526348e5d66c174969d91ab8000c9", "srcset": "https://si.imgix.net/dcae9a0d/uploads/origins/fbffa32f-5b9d-402c-9a27-36c9a7e95a78?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h