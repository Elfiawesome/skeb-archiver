e_only_public": false, "tip_acceptable": true, "yearly_report_client_visible": false, "total_appeals_count": 4, "received_works": [{"path": "/@schzEM/works/24", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 956830, "client_id": 461653, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/3a8de086/uploads/origins/bcc74f13-1277-479e-94fa-2eab2e5eece6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=515f54ae261600921ac37f61a6b7a11b", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/3a8de086/uploads/origins/bcc74f13-1277-479e-94fa-2eab2e5eece6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9732907e495f068f03cf8a310202f088", "src_set": ""}, "body": "ドーモ、こんにちは\n参考動画のゲームをモチーフにニンジャスレイヤー＝サン（フジキド）を描いて下さい\n・リアルな競技場なのか、電脳空間なのかはお任せします\n・他７人のニンジャをいなしたりネギトロにしたり壁走ったり跳んだりしながら高速で駆け抜けているイメージ（描いて欲しいのはあくまでもフジキド一人だけです）\n・教育に良いゲームさまのファンアートではない\n\nゲームのアトモスフィアがあまりにも奥ゆかしいので、このイメージで描いて欲しい\nご検討願います\n\nhttps://www.youtube.com/watch?v=d80TZxDQjPE", "nc": 176, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@schzEM/works/23", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 956830, "client_id": 0, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/97aabf6b/uploads/origins/a3f763a8-1747-4e40-8b0f-8dd20e3e309d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ba6710dbdada0bc68f67d2a00749a4bc", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/97aabf6b/uploads/origins/a3f763a8-1747-4e40-8b0f-8dd20e3e309d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e2cc4d009cd0b1a603bb09a5fb94e7d5", "src_set": ""}, "body": "はじめまして。忍殺TRPGのキャラクター立ち絵を描いてらっしゃるのを見たので、自分も依頼させていただきます。\n\n性別∶男\n年齢∶不詳（少なくとも30〜40代）\n職業∶連続放火殺人犯\n外見∶一見ドルイドの僧侶の様だが、頭部が常に炎に包まれており、ローブの短い袖からはサイバネティクス置換された両腕が確認出来る。\n装備∶両腕に火炎放射器が内蔵されており、掌に開いている１円玉ほどの穴から爆炎を噴出して対象を焼き殺す。\nよく見ると頭部も機械化されており、ドクロのような、鉄仮面のような表情のない顔をしている。口は咀嚼可能。\n胴体はオカルティックな暗い緑のローブを着ており、フードは被っておらず後ろに垂らしている。胸元にはケルト紋様のペンダントが下がっていて、足は近代的なデザインの金属製ブーツを履いている。\n特技∶頭部の炎や両腕の火炎放射を火の鳥の姿にして相手に飛ばす事が可能。また、触れた相手の体内へ直に炎を流し込んで内側から燃やす。その際相手は両眼が白く発光し、口からは火炎が噴き出る。\n※個人的なイメージとしては、ターミネーターのT-800、ゴーストライダー、悪魔博士、テッドブロイラーを混ぜたような感じです。\n\nポーズやスタイル、細かい部分はお好きな様に描いて下さい。\n長くなってしまいましたが、どうか宜しくお願い致します。", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@schzEM/works/22", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 956830, "client_id": 569003, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/b8787170/uploads/origins/4aebe1fb-97fb-451f-8ee8-cd2e4bcc31a6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=00e3de20cb6f0648fdca11f615d257e1", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/b8787170/uploads/origins/4aebe1fb-97fb-451f-8ee8-cd2e4bcc31a6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3bb04f18f5c567e704b5c08145249d85", "src_set": ""}, "body": "ドーモ、いつもお世話になっております！\n今回は私が使用するニンジャスレイヤーTRPGのPCの立ち絵を依頼したいと思います。\n\n名前：ファブルム（ローマ工兵隊と言う意味）\n\n概要：「全ての道はローマに通ず。つまり全てのカラテは古代ローマカラテに通ず。全てのカラテ・アーツを修め、以て私は古代ローマカラテを極める」\n古代ローマカラテ会に所属する戦士だが、実戦の機会を求めて傭兵をしている。\nまたスパルカタスのことを俗物と嫌っており、秘匿されし「一角獣の構え」と「龍の構え」を欲してやまない。\nしかしどうあっても伝授されることはないと見切りをつけており、様々なカラテを極めることで古代ローマカラテの真髄へ辿り着こうと研鑽を積んでいる。\n\nゲーム的には色んなスキルを習得して古代ローマカラテっぽくするニンジャ。\n\n特徴：若い男性。短髪。筋肉質。厳しい目つき。身動きが阻害されるため手甲足甲以外に鎧は着けていない。メンポは金色でシンプルなデザイン。\n以上ですが、記載されていない部分についてはお任せします。", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@schzEM/works/21", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 956830, "client_id": 2185527, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/7a549893/uploads/origins/2820e099-df9c-44b6-804d-193e7f4c6f20?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a0eb2dc62ae27cf42654fba0f9b50bf6", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/7a549893/uploads/origins/2820e099-df9c-44b6-804d-193e7f4c6f20?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=7f0dc0ce6e179f391bcd5a0d146d401f", "src_set": ""}, "body": "ドーモ、前回のドローイングに感謝，今回は私がマスタリングするニンジャスレイヤーTRPGキャンペインに登場するPCの立ち絵を依頼したいと思います。\n名前： K-03-012 \n概要： ケイムショの代理戦士。 サツガイとは接触がある。 事故現場でケイムショに回収された多重人格の謎のニンジャス。 餓鬼、骸骨、剣の山など地獄のような光景や、鳥、獣、巨大な十字架など怪奇な光景が現れる「ゲン・ジツ」を使いこなそう。 サツガイと接触し、コトダマ空間認識能力を授かった。 サツガイの黒いマガタマを持っている。\n外観：本体はビンの中の脳であり、グイン・ジツを使って普通の人のように見せ、性格によってさまざまなポーズで登場する。 その正体や来歴は不明である。 記憶とアイデンティティの喪失により、エゴも強固なものではない。 松葉杖をついた虚弱な老人、詩を読む少年、純白のドレスに身を包んだ少女、異食症の青年などの姿が使われる。 \n\nPLが本体は脳だけだと言っても、このままではグラフィックが単調すぎる。 ここから何か要素を選んで追加できるといいのだが。\n\n以上ですが、記載されていない部分についてはご自由にアイデアを作ってください。 ありがとう。", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@schzEM/works/20", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/091fc977/uploads/origins/00d3d179-1a1c-4e80-9731-a8c56f7a2f1b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=99ec16cf60137f098d25aa6251d60ce6", "src_set": ""}, "private": true, "genre": "art", "tipped": true, "creator_id": 956830, "client_id": 461653, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 32, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@schzEM/wor