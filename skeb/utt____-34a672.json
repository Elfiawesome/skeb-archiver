1/uploads/origins/c0b943d2-3b8e-4a51-a352-748a23442775?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e2261f5db2f941cb43fa9f15d4f16201 2x, https://si.imgix.net/d818f931/uploads/origins/c0b943d2-3b8e-4a51-a352-748a23442775?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=9a6a9bbe43e42a632a3e0b8709239fa4 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/d818f931/uploads/origins/c0b943d2-3b8e-4a51-a352-748a23442775?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a57cc9e854cbe2d19a88cc255abb9dc8", "srcset": "https://si.imgix.net/d818f931/uploads/origins/c0b943d2-3b8e-4a51-a352-748a23442775?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a57cc9e854cbe2d19a88cc255abb9dc8, https://si.imgix.net/d818f931/uploads/origins/c0b943d2-3b8e-4a51-a352-748a23442775?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=6a9a9ebc2bbeadf8144e2e5801ef8ff7 2x, https://si.imgix.net/d818f931/uploads/origins/c0b943d2-3b8e-4a51-a352-748a23442775?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=abcb9ef7f04298480c57e94fe2a9adea 3x"}, "body": "Uka.様、はじめまして、芹凪と申します。\nいつも素敵なイラストを拝見しております。\nUka.様の暖かいイラストの雰囲気が大好きなので、是非イラストを描いて欲しいと思い、リクエストさせていただきました。\n\n◇キャラクターについて\n基本的なデザインはこちらです\n・耳上から編み込まれた腰あたりまでの三つ編みツインテール\n・ミルクティー色の髪の毛\n・髪の毛よりも少し赤い瞳\n・三つ編みの結び目にリボン\nhttps://drive.google.com/drive/folders/1RdnXRCf-xWs5-WHp7-70auM4l4RtV5h-\n\n◇構図について\n正面を向いたイラストでお願いいたします。\n細かい構図・服装などはUka.様にお任せ出来ればと思います。\n配信にも使用したいので、16:9の縦長サイズだと嬉しいです。\n\n\n◇ 使用用途\nSNSのアイコンやヘッダー、活動に関するポスト、配信アプリで使用させていただきたいと考えております。\n\nお忙しい中すみません。\nご縁がありましたらよろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/1RdnXRCf-xWs5-WHp7-70auM4l4RtV5h-", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@utt____/works/5", "private_thumbnai