40cmです。\n\n\n【使用用途】\nTwitterへの掲載、アイコンとしての使用、YouTube活動におけるサムネなどを考えております。\nまた、サムネ等へ使用できるように背景透過のデータ(レイヤー分けされたpsdファイルなど)もいただけると幸いです。\n\nご検討よろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/1473xPFsg3nV3LY0Lb2iuN_mV8KAwcZ9C?usp=share_link", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@RukuRukuLand/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2241032, "client_id": 116715, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/b921b4db/uploads/origins/01861719-6bdf-4687-9da8-1d1058064259?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5dc69de9be97ed2bdfed464d59386775", "srcset": "https://si.imgix.net/b921b4db/uploads/origins/01861719-6bdf-4687-9da8-1d1058064259?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5dc69de9be97ed2bdfed464d59386775, https://si.imgix.net/b921b4db/uploads/origins/01861719-6bdf-4687-9da8-1d1058064259?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=aa8b51793c68bdca53a4e7d5e023cfd2 2x, https://si.imgix.net/b921b4db/uploads/origins/01861719-6bdf-4687-9da8-1d1058064259?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=abe06166d31f58a4606c0a6d19221621 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/b921b4db/uploads/origins/01861719-6bdf-4687-9da8-1d1058064259?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f96b0240e6414c50b421ed5525456f9c", "srcset": "https://si.imgix.net/b921b4db/uploads/origins/01861719-6bdf-4687-9da8-1d1058064259?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f96b0240e6414c50b421ed5525456f9c, https://si.imgix.net/b921b4db/uploads/origins/01861719-6bdf-4687-9da8-1d1058064259?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200