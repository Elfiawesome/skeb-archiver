&dpr=2&fit=crop&crop=top&w=200&h=200&s=fb10a2cb12a1f33e076d0f255c8f6b5b 2x, https://si.imgix.net/60d686d6/uploads/origins/c75e3fec-2042-4b46-9dcc-beaa19b28359?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=fb2c0e52cf9e81296c89febd96db77f1 3x"}, "duration": null, "nsfw": true, "hardcore": true, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/60d686d6/uploads/origins/c75e3fec-2042-4b46-9dcc-beaa19b28359?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=45ecfe735c3be38f3429c8529a4b0106", "srcset": "https://si.imgix.net/60d686d6/uploads/origins/c75e3fec-2042-4b46-9dcc-beaa19b28359?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=45ecfe735c3be38f3429c8529a4b0106, https://si.imgix.net/60d686d6/uploads/origins/c75e3fec-2042-4b46-9dcc-beaa19b28359?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=a67c1389d99048f0457ab9f96bf6e4ce 2x, https://si.imgix.net/60d686d6/uploads/origins/c75e3fec-2042-4b46-9dcc-beaa19b28359?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=f4bc375858a4881fc2b75da52d112021 3x"}, "body": "夜中に新作アイスを代理人に食べさせようと部屋に押し掛けた水着コルセア\n代理人を襲っていたヘルキャット達と遭遇してしまう\n逃げようとするが捕まったコルセア、たわわなその胸で縛られた代理人のペニスを挟み込む（水着は脱がさない、代理人は口を塞がれている）\n中二台詞をしゃべりながら恥ずかしがるコルセアの胸を勝手に使ってパイズリするヘルキャット\n代理人が我慢できず射精、胸の間で精液をどくどくと吐き出す\n胸の谷間をどろどろにされたコルセア、呆然としている\n数日後、ヘルキャット達の仲間入りをしたコルセア\n水着から胸を露出させ自らパイズリしている\n射精した精液を顔で受け止める、顔をどろどろにされてうれしそう", "nc": 186, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@kuzyou_nunn/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 917812, "client_id": 435000, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/1503a193/uploads/origins/e0bcb23c-589e-4236-b8db-e83ece125146?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=735761e582bc128f99c4a3425ef19606", "srcset": "https://si.imgix.net/1503a193/uploads/origins/e0bcb23c-589e-4236-b8db-e83ece125146?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=735761e582bc128f99c4a3425ef19606, https://si.imgix.net/1503a193/uploads/origins/e0bcb23c-589e-4236-b8db-e83ece125146?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=247cd0e8c2a0ae5d8d3979da7cc06d07 2x, https://si.imgix.net/1503a193/uploads/origins/e0bcb23c-589e-4236-b8db-e83ece125146?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=78611385056cc073093a7351a44b2a22 3x"}, "duration": null, "nsfw": true, "hardcore": true, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/1503a193/uploads/origins/e0bcb23c-589e-4236-b8db-e83ece125146?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=1cb26b37199cfe93a7074873b70ed5f7", "srcset": "https://si.imgix.net/1503a193/uploads/origins/e0bcb23c-589e-4236-b8db-e83ece125146?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=1cb26b37199cfe93a7074873b70ed5f7, https://si.imgix.net/1503a193/uploads/origins/e0bcb23c-589e-4236-b8db-e83ece125146?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=02f3744dc19802d25a0cc1df0da37db8 2x, https://si.imgix.net/1503a193/uploads/origins/e0bcb23c-589e-4236-b8db-e83ece125146?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=4f416bbab49c0c0a8050294b12f6bd00 3x"}, "body": "水着のT-26、AT-1、SU-26、普段着のカチューシャが洞窟から脱出できず岩堀ワームに飲み込まれ犯される絵\n\n体内に取り込まれた4人は肉壁から生える無数の触手に拘束される\nワームは飲み込んだ獲物に種付けして子孫を残そうとする\n産卵用の触手が4人の穴を犯しどろどろした精液を吐き出す\nしかし人ではない4人は孕むことはなく触手が満足しないまま延々と犯され続けるのだった\n\n犯され始めと時間経過差分とお願いします。\n服はできるだけ脱がさないようにお願いします。\n\nカチューシャ\n手足を拘束されM字開脚、触手に犯される\n希望を捨てず抵抗している感じ、ずらし挿入\n\n犯され続けてレイプ目、胸元が開かれて着やせしていた巨乳が露出している\n顔や髪の毛に精液汚れ、中出しされながら犯されて精液でどろどろ\n\nT-26\n顔が下になるマンぐり返しの体勢でずらし挿入\n\n触手が引き抜かれ中に出された精液が噴き出している\n水着は半脱ぎで乳首が見えている\nレイプ目、あふれ出した精液が体や顔に飛んでしまっている\n横には彼女を犯していた触手がいる、挿入されていたところまで精液で汚れている\n\nAT-1\n両手首を触手に縛られ手を上にして拘束されている\nお尻をこっちに向けている、水着の尻の部分を破られて尻が露出\n膣とお尻の二穴を犯され困惑している感じ\n\n裸にされレイプ目で口も犯されて3穴責めされている\n精液まみれで脱力し一切抵抗していない\n\nSU-26\n腰のあたりを触手に巻き付かれ持ち上げられている（顔はこっち向き）\n口を無理やり犯されている、膣も犯されている（見えない構図）\n\n無理やり飲まされた精液を床に吐いている\n半脱ぎで乳首が見えている\n\nよろしくお願い致します。", "nc": 58, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@kuzyou_nunn/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 917812, "client_id": 435000, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/7d471fc6/uploads/origins/4857c772-1efa-4524-a9db-fecf5014f9ab?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=54246051ec8be839730a895985aed7d6", "srcset": "https://si.imgix.net/7d471fc6/uploads/origins/4857c772-1efa-4524-a9db-fecf5014f9ab?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=54246051ec8be839730a895985aed7d6, https://si.imgix.net/7d471fc6/uploads/origins/4857c772-1efa-4524-a9db-fecf5014f9ab?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=60cdc3b99615ffbb1c13f9f7b29730ca 2x, https://si.imgix.net/7d471fc6/uploads/origins/4857c772-1efa-4524-a9db-fecf5014f9ab?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=5023288cab981ce546d8691d5c789a77 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/7d471fc6/uploads/origins/4857c772-1efa-4524-a9db-fecf5014f9ab?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=4c7420fc33a30f9805f991f49542f1f4", "srcset": "https://si.imgix.net/7d471fc6/uploads/origins/4857c772-1efa-4524-a9db-fecf5014f9ab?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=4c7420fc33a30f9805f991f49542f1f4, https://si.imgix.net/7d471fc6/uploads/origins/4857c772-1efa-4524-a9db-fecf5014f9ab?bg=