gix.net/50a6b656/uploads/origins/3edfe1de-85eb-40bd-bd94-e9188397f926?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=880ee55b14de8ba18991c364ec6b9dff", "srcset": "https://si.imgix.net/50a6b656/uploads/origins/3edfe1de-85eb-40bd-bd94-e9188397f926?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=880ee55b14de8ba18991c364ec6b9dff, https://si.imgix.net/50a6b656/uploads/origins/3edfe1de-85eb-40bd-bd94-e9188397f926?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=4a2081291d60fbb05840415fac85aa29 2x, https://si.imgix.net/50a6b656/uploads/origins/3edfe1de-85eb-40bd-bd94-e9188397f926?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=8fd46767e168d390486a24546d56e555 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/50a6b656/uploads/origins/3edfe1de-85eb-40bd-bd94-e9188397f926?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=8a501d55e1e01dac04e9591b27f19935", "srcset": "https://si.imgix.net/50a6b656/uploads/origins/3edfe1de-85eb-40bd-bd94-e9188397f926?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=8a501d55e1e01dac04e9591b27f19935, https://si.imgix.net/50a6b656/uploads/origins/3edfe1de-85eb-40bd-bd94-e9188397f926?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=3b2f84d0e335f5ae3ea272202776bc24 2x, https://si.imgix.net/50a6b656/uploads/origins/3edfe1de-85eb-40bd-bd94-e9188397f926?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=11538b7fb73a294de2a76dff322593d3 3x"}, "body": "Vtuberの夜玖虎子です。RimWorldのMOD本当にありがとうございました…！\n久嬢ぬんさんのアイコンで描かれているマウスちゃんのデフォルメ絵もとても好きです。\nそこで依頼なのですが、私のYoutubeチャンネルのメンバーシップで使用するカスタム絵文字、いわゆるスタンプのイラストを描いて頂けないでしょうか。\n私をモチーフとしたデフォルメ＋文字のイラストを6種類お願いしたいです。\n\nイラストの指定は以下のとおりです。\n■１．こんにちは！の挨拶\n右手を小さく挙げている感じ。アイコンのマウスちゃんに近いイメージで！\n文字は「こんとら～」でお願いします\n\n■２．グッジョブ\nサムズアップでGJ！というスタンプ。\n文字は「さすとら」でお願いします\n\n■３．煽り\nリスナーが煽りで使えるスタンプ。目に影を入れてざまぁ～という表情。\n🦄←のようなユニコーンのアイコンorデフォルメを入れて欲しいです。\n文字で「UC」\n※私のチャンネルではガチャのせいでユニコーンが煽りの象徴になっています。\n\n■４．泣き顔\n目は＞＜でデフォルメした表現でお願いします。\n文字は小さく「しくしく」。\n※青空Kamiya先生の泣きパンターをイメージしています：https://twitter.com/aosorakamiya/status/1238812740841385986\n\n■５．赤面顔\nセンシティブな発言があったときに使用するスタンプ。\n文字で小さく「センシティブ」。\n\n■６．喜び顔\n喜びを表現するときに使用するスタンプ。\nハートマークが飛んでる感じでお願いします。\n\n■サイズについて\n各絵文字イラストは正方形でお願いします。\nサイズは480px × 480pxを目安でお願いできれば幸いです。\n\n■参考資料\n私の姿は以下のURLをご参照ください。\n三面図が無くて申し訳ありません。。資料不足で不明な点は好きにアレンジして頂いて構いません！\n・ベース\nhttps://twitter.com/YakToraNW/status/1373891246284963844\n・脱帽＆眼鏡\nhttps://twitter.com/YakToraNW/status/1438911771331293187\n・イラスト１\nhttps://twitter.com/YakToraNW/status/1379207226229854209\n・イラスト２\nhttps://twitter.com/YakToraNW/status/1426194596187439108\n\n以上です。ご検討よろしくお願い致します！", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@kuzyou_nunn/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 917812, "client_id": 53854, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/96e4e462/uploads/origins/a0477c6a-3c5e-4cd0-8024-ae591ade3fac?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=055c7ac3be16a4cad76550639c840658", "srcset": "https://si.imgix.net/96e4e462/uploads/origins/a0477c6a-3c5e-4cd0-8024-ae591ade3fac?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=055c7ac3be16a4cad76550639c840658, https://si.imgix.net/96e4e462/uploads/origins/a0477c6a-3c5e-4cd0-8024-ae591ade3fac?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=07c2acbe18b6df8443d25ce8667bea81 2x, https://si.imgix.net/96e4e462/uploads/origins/a0477c6a-3c5e-4cd0-8024-ae591ade3fac?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f529edf2cd21bb8f439d44f4d1339f14 3x"}, "duration": null, "nsfw": false, "hardcore": fals