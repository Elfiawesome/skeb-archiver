いします！\n(資料URLの他にも、「むったん日譚」のタグにも絵を置いてます。)\n\nhttps://x.com/T_masoppu/status/1800476196528160854?t=ycx7E2yphJAQUI0ryQE75A&s=19", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@koguma_0310/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3612450, "client_id": 2629511, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/6473cd2c/uploads/origins/ab74153a-d806-4b58-9bdc-fc7faef64c45?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=54392242096ca6dad0687444fbfe2706", "srcset": "https://si.imgix.net/6473cd2c/uploads/origins/ab74153a-d806-4b58-9bdc-fc7faef64c45?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=54392242096ca6dad0687444fbfe2706, https://si.imgix.net/6473cd2c/uploads/origins/ab74153a-d806-4b58-9bdc-fc7faef64c45?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=114c7f592de7fc8c67586287f8fdf29b 2x, https://si.imgix.net/6473cd2c/uploads/origins/ab74153a-d806-4b58-9bdc-fc7faef64c45?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=60c5824d12dc8d8cf4920f3babc6991d 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/6473cd2c/uploads/origins/ab74153a-d806-4b58-9bdc-fc7faef64c45?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a1da45e20b19e9e8c43edd73edfb89b0", "srcset": "https://si.imgix.net/6473cd2c/uploads/origins/ab74153a-d806-4b58-9bdc-fc7faef64c45?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a1da45e20b19e9e8c43edd73edfb89b0, https://si.imgix.net/6473cd2c/uploads/origins/ab74153a-d806-4b58-9bdc-fc7faef64c45?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=ab2f80c028e9a108636c24aefc6b6371 2x, https://si.imgix.net/6473cd2c/uploads/origins/ab74153a-d806-4