す。\n参考資料として銃や装備を身に付いた画像を挙げさせていただいてありますが、銃・装備の有無につきましてはお任せいたします。(我儘を言わせていただければ、描いて頂きたいです・・・)\n\nご多忙の折、注文の多いご依頼となってしまい大変申し訳ございませんが、何卒よろしくお願いいたします。\nリオン様の素晴らしい作品が見れることを楽しみにさせていただきます。", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@LionFeachild/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 507759, "client_id": 241183, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/d724594c/uploads/origins/2b863ebe-dc78-4177-abd5-ac5cdaea7fb3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6193ffb7279598cf471abce1ceffd0c3", "srcset": "https://si.imgix.net/d724594c/uploads/origins/2b863ebe-dc78-4177-abd5-ac5cdaea7fb3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6193ffb7279598cf471abce1ceffd0c3, https://si.imgix.net/d724594c/uploads/origins/2b863ebe-dc78-4177-abd5-ac5cdaea7fb3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b74828f36ab962e2dd05499d163989af 2x, https://si.imgix.net/d724594c/uploads/origins/2b863ebe-dc78-4177-abd5-ac5cdaea7fb3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f8166b00f65515f039510f9040adabca 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/d724594c/uploads/origins/2b863ebe-dc78-4177-abd5-ac5cdaea7fb3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=8fa75dbf7fad90509b4603636c183c80", "srcset": "https://si.imgix.net/d724594c/uploads/origins/2b863ebe-dc78-4177-abd5-ac5cdaea7fb3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=8fa75dbf7fad90509b4603636c183c80, https://si.imgix.net/d724594c/uploads/origins/2b863ebe-dc78-4177-abd5-ac5cdaea7fb3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=4eb5bd4f3cef093a01ed99dda0c7d9fa 2x, https://