、ありがとうございます。難しければキャンセルして頂いても構いません。\n\nhttps://drive.google.com/drive/u/0/folders/1VeMf-RuZc6_UKQNxgljZw3OHLzLwlgwL", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Yozakura_ra/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3338336, "client_id": 2639506, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/163db2d9/uploads/origins/040c3f8c-738b-4581-b36e-b80c020b8a79?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=963b3d195cf81859485cf33d1f500571", "srcset": "https://si.imgix.net/163db2d9/uploads/origins/040c3f8c-738b-4581-b36e-b80c020b8a79?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=963b3d195cf81859485cf33d1f500571, https://si.imgix.net/163db2d9/uploads/origins/040c3f8c-738b-4581-b36e-b80c020b8a79?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=7b9be6fd62f852f70156ba0a659bb521 2x, https://si.imgix.net/163db2d9/uploads/origins/040c3f8c-738b-4581-b36e-b80c020b8a79?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=cbf2adb7790057396e26157d2b8cef4f 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/163db2d9/uploads/origins/040c3f8c-738b-4581-b36e-b80c020b8a79?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0ceae1c207aad7b0d6f023b654a2779e", "srcset": "https://si.imgix.net/163db2d9/uploads/origins/040c3f8c-738b-4581-b36e-b80c020b8a79?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0ceae1c207aad7b0d6f023b654a2779e, https://si.imgix.net/163db2d9/uploads/origins/040c3f8c-738b-4581-b36e-b80c020b8a79?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=163ff3b04f9a4f3ddc509592e7aa9592 2x, https://si.imgix.net/163db2d9/uploads/origins/040c3f8c-738b-4581-b36e-b80