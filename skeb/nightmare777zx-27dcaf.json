絵柄で描かれる明るく可愛いなぎこちゃんや、艶テカ質感を期待できそうなドレスの高級感、そしてお肌の魅せ方等々、ないとめあさんに期待されるお手前を発揮して頂ければ、大変嬉しく存じます……！　何卒よろしくお願いいたします！\n\nhttps://www.pixiv.net/artworks/88419852", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 13987, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "ブラニン", "screen_name": "buraninn", "avatar_url": "https://pbs.twimg.com/profile_images/1381521033379733504/EzJcJtjq.jpg", "header_url": "https://pbs.twimg.com/profile_banners/525039013/1732346355/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "art"}], "banned": false, "nc": 128}, {"id": 659370, "creator": true, "nsfw_acceptable": false, "acceptable": false, "name": "村雲ジンザ", "screen_name": "murakumojinza", "avatar_url": "https://pbs.twimg.com/profile_images/1013333734286811137/Vb736va5.jpg", "header_url": "https://pbs.twimg.com/profile_banners/774983875848081408/1474981087/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 20, "complete_expiration_days": 50, "skills": [{"genre": "art"}, {"genre": "correction"}], "banned": false, "nc": 0}, {"id": 866060, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "KYT", "screen_name": "i_kemeeeeen", "avatar_url": "https://pbs.twimg.com/profile_images/2061883864369553408/ASNjyj16.jpg", "header_url": "https://pbs.twimg.com/profile_banners/2023277012555853824/1777641757/1500x500", "appeal_receivable": true, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_d