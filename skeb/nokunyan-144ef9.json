bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=734197d5f877e63a51839aefb15fd783, https://si.imgix.net/76b08187/uploads/origins/3b843330-f980-40c9-8770-1e7582c84251?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=546bb151f934678987ef51671aee6672 2x, https://si.imgix.net/76b08187/uploads/origins/3b843330-f980-40c9-8770-1e7582c84251?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=1004dbad8846bf39a25e1938fce4acab 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/76b08187/uploads/origins/3b843330-f980-40c9-8770-1e7582c84251?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9fb12489b6299924c61cb965771b970c", "srcset": "https://si.imgix.net/76b08187/uploads/origins/3b843330-f980-40c9-8770-1e7582c84251?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9fb12489b6299924c61cb965771b970c, https://si.imgix.net/76b08187/uploads/origins/3b843330-f980-40c9-8770-1e7582c84251?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=54d5d85758ae057e9b056fd5298a5dbd 2x, https://si.imgix.net/76b08187/uploads/origins/3b843330-f980-40c9-8770-1e7582c84251?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=9e4d7e91764c6e982db021e5a0f25d22 3x"}, "body": "こんにちは、はじめまして！Twitterにてのくなさんのご活躍を陰ながら見守らせてもらっているものです。\nのくなさんのイラストは明るく、ほのぼのした作品ばかりで、もっちりとした肌の感じがとてもかわいくいつも助けられています。\n最近ですと琴葉姉妹の誕生日にあげられていた姉妹ちゃんの距離感！\nのくなさんのふわふわで柔らかそうな姉妹ちゃんが密着しているのはまさしく最高の1枚でした。\nまた琴葉姉妹の立ち絵を2タイプも出されており、ニコニコでよく使われている投稿者さんを見ます。\n琴葉界隈の盛り上がりをまさに担っているのくなさんには感謝と尊敬でいっぱいです！\n今回はそんなのくなさんにまた尊い琴葉姉妹ちゃんを描いていただきたく依頼させていただきました。\n\n以下依頼内容\n琴葉姉妹を描いていただきたいです。状況ですが、葵ちゃんが茜ちゃんに引っ付いてキスしようとして茜ちゃんが\nちょっとうっとおしそうに、されど嬉しそうに笑っているところです。\n姉妹ちゃんの密着面積は大きければ大きいほどいいです。\nお互いの表情やポーズですが以下のコンセプトに則ったものにしていただきたいです。\n\nコンセプトですが、茜ちゃんは嫌がってはいないです。甘えてくる葵ちゃんに対して「もぉ～この子はまた～」みたいな感じで\nあしらっているところです。葵ちゃんも何か下心があるのではなく、お姉ちゃんのことが好きで愛情表現の一種としてキスをしようとしているところです。\nほっぺにキスぐらいならよくやる姉妹ちゃんです。\nやや百合よりのほのぼの世界観で琴葉姉妹は愛し合っています。\n\n他細かいところや表記されていないものに関しては、のくなさんにお任せします。\n依頼を受けていただけること、また最高の姉妹ちゃんを描いていただけることを心より願っています。", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@nokunyan/works/6", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/b07b6923/uploads/origins/bd1e7b89-8220-4c07-ac1f-447430c8c37f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=e04f1bd3f9ab60570218329c6aba51fe", "srcset": "https://si.imgix.net/b07b6923/uploads/origins/bd1e7b89-8220-4c07-ac1f-447430c8c37f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=e04f1bd3f9ab60570218329c6aba51fe, https://si.imgix.net/b07b6923/uploads/origins/bd1e7b89-8220-4c07-ac1f-447430c8c37f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=3c700d6e1d7f34c4f5f2e1d39554e879 2x, https://si.imgix.net/b07b6923/uploads/origins/bd1e7b89-8220-4c07-ac1f-447430c8c37f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=bed5bd889a3f3a31253b419cf9170596 3x"}, "private": true, "genre": "art", "tipped": true, "creator_id": 1197234, "client_id": 2655454, "nc": 0}, {"path": "/@nokunyan/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1197234, "client_id": 1486707, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/6d4a67da/uploads/origins/cf8b1021-f854-48a4-a006-9f99abb758a3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top