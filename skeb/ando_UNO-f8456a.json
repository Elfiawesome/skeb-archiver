リフの枠はトゲトゲした感じで文字も理性をなくした感じでお願いします！\n「オ‘‘…オ‘‘ォ‘‘…♡」\n【その他】\nルーク君の陰毛の濃さの参考(これより濃いめでも大丈夫です！)\nhttps://drive.google.com/file/d/1UdNK7DcYOghxSfyXIqV0LbLZ-tnbi5_H/view?usp=sharing\n\n2枚目の大まかな構図の参考\nhttps://drive.google.com/file/d/1vwpLAj41jnkaFw4p0nAUBzB8G1WAOBu7/view?usp=sharing", "nc": 33, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@ando_UNO/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1536921, "client_id": 1564308, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/286eabfa/uploads/origins/08d5f8d6-2be5-474b-95a5-2b5a630a6622?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a2d246bbd8a690bcb6decd355f8511ba", "srcset": "https://si.imgix.net/286eabfa/uploads/origins/08d5f8d6-2be5-474b-95a5-2b5a630a6622?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a2d246bbd8a690bcb6decd355f8511ba, https://si.imgix.net/286eabfa/uploads/origins/08d5f8d6-2be5-474b-95a5-2b5a630a6622?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=7893db81616ad35139b15a8f4104cc0a 2x, https://si.imgix.net/286eabfa/uploads/origins/08d5f8d6-2be5-474b-95a5-2b5a630a6622?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=bc63584299b27a5e3692e38ac30b5693 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/286eabfa/uploads/origins/08d5f8d6-2be5-474b-95a5-2b5a630a6622?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b6743d8acdb74df0755c593210bc3937", "srcset": "https://si.imgix.net/286eabfa/uploads/origins/08d5f8d6-2be5-474b-95a5-2b5a630a6622?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b6743d8acdb74df0755c593210bc3937, https://si.imgix.net/286eabfa/uploads/origins/08d5f8d6-2be5-474b-95a5-2b5a630a6622?bg=%23fff&auto=format%2Ccompress&fm=webp