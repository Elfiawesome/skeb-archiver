ーにて表記いただけますと幸いです )\n\n背景とキャラクターと署名を分離したファイルを頂ければ幸いです。\n\nもし金額が足りないのであれば、適当な金額でのアピールをお願いします。\n内容など不適切な場合はキャンセルしても大丈夫です！\nご検討のほどよろしくお願いいたします。\n\nhttps://drive.google.com/drive/u/0/folders/12Fm4etCnCeEJnay9_dV6JWHdQOmNmi1o", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Mojika_sora/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2558012, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/059ec450/uploads/origins/4529cc58-a7c7-4b5f-8e14-e78ede935c73?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=101352f3ad4750b6771f4a9f06f3f8ff", "srcset": "https://si.imgix.net/059ec450/uploads/origins/4529cc58-a7c7-4b5f-8e14-e78ede935c73?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=101352f3ad4750b6771f4a9f06f3f8ff, https://si.imgix.net/059ec450/uploads/origins/4529cc58-a7c7-4b5f-8e14-e78ede935c73?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f05f302cf412f21e8c0e50e8d8848cc8 2x, https://si.imgix.net/059ec450/uploads/origins/4529cc58-a7c7-4b5f-8e14-e78ede935c73?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=afc21f8d0fe74d25dd174435da939886 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/059ec450/uploads/origins/4529cc58-a7c7-4b5f-8e14-e78ede935c73?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2022fdb4f878a6e4a9ac9e3fff9fb3e2", "srcset": "https://si.imgix.net/059ec450/uploads/origins/4529cc58-a7c7-4b5f-8e14-e78ede935c73?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2022fdb4f878a6e4a9ac9e3fff9fb3e2, https://si.imgix.net/059ec450/uploads/origins/4529cc58-a7c7-4b5f-8e14-e78ede935c73?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=56fb4d4496cb15f785b82b35