}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/adc4565c/uploads/origins/c36bee1c-50f6-4840-a563-99512f6c12b3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=47ddd0b30934fa15fb0ed791d267d7b0", "srcset": "https://si.imgix.net/adc4565c/uploads/origins/c36bee1c-50f6-4840-a563-99512f6c12b3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=47ddd0b30934fa15fb0ed791d267d7b0, https://si.imgix.net/adc4565c/uploads/origins/c36bee1c-50f6-4840-a563-99512f6c12b3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=2818ef703f9fae24a0befe17b77b5eda 2x, https://si.imgix.net/adc4565c/uploads/origins/c36bee1c-50f6-4840-a563-99512f6c12b3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=70e1895479f40598f1d812c491f766e7 3x"}, "body": "こんにちは！あなたのアートワークが本当に大好きなので、私の2人のOCを描いてもらえると嬉しいです！彼らは2007年から2009年のアメリカの高校生です。ウィリアム（金髪、下）はいつも神経質でシャイで、ドレイク（黒髪、上）はとてものんびりしていて、クールに振る舞っています。リンク先で彼らの詳しい説明を見ることができる。彼らの交流はたいていカジュアルでリラックスしたものだが、おバカでぎこちなく、遊び心があって親密なこともある（そういう交流は大歓迎）。彼らはまた、YTにアップロードするためにクリンチビデオを録画するという共通の趣味を持っている。\n\n自由に描いてください！お支払い金額が合わない場合は、再送させてください。ご検討よろしくお願いします\n\nhttps://drive.google.com/drive/folders/1BMUJSifzatiifzgp53Cs2ZLggEcvOeMa?usp=sharing", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@popo722apo/works/11", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3641904, "client_id": 2756201, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/0b13ce61/uploads/origins/3c6a42e3-45ab-464f-aa60-427019fe8dbc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=019dcd65d7d9fd2ef229c5a1f7d65558", "srcset": "https://si.imgix.net/0b13ce61/uploads/origins/3c6a42e3-45ab-464f-aa60-427019fe8dbc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=