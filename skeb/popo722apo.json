イメージです！）\n\n◻︎可能であれば避けて頂きたいもの\n・表情が豊かすぎる\n・ピンク、赤、オレンジなどの暖色系のお洋服\n・半袖\n\n参考画像URLも添付致します。\nhttps://drive.google.com/drive/folders/1G8nhBOF7Fi11lIUIQ9Y7d_XZAsxiTfYf\n\nお洋服や構図、雰囲気などアポリ様のお好きなように描いて頂けると嬉しいです！\n資料や金額に不備がございましたら再送頂けますと幸いです。\n承認して頂けた際にはどうぞよろしくお願いいたします！\n\nhttps://drive.google.com/drive/folders/1G8nhBOF7Fi11lIUIQ9Y7d_XZAsxiTfYf", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@popo722apo/works/13", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3641904, "client_id": 3470905, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/626d0338/uploads/origins/ea679854-2210-41fd-bfe8-64335fcb3653?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b01832850708fbad409e461e5e2c226d", "srcset": "https://si.imgix.net/626d0338/uploads/origins/ea679854-2210-41fd-bfe8-64335fcb3653?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b01832850708fbad409e461e5e2c226d, https://si.imgix.net/626d0338/uploads/origins/ea679854-2210-41fd-bfe8-64335fcb3653?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=7112dc960881e9068ddd24a9195fa6bf 2x, https://si.imgix.net/626d0338/uploads/origins/ea679854-2210-41fd-bfe8-64335fcb3653?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=fa56cb30e1c9128f16a492019d194206 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/626d0338/uploads/origins/ea679854-2210-41fd-bfe8-64335fcb3653?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9c5225117f71b0d5da3697a77d6b7f0b", "srcset": "https://si.imgix.net/626d0338/uploads/origins/ea679854-2210-41fd-bfe8-64335fcb3653?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9c5225117f71b0d5da3697a77d6b7f0b, https://si.imgix.net/626d0338/uploads/origins/ea679854-