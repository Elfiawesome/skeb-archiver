blur=200&s=231b2f94340c45fcb3028119d6851635 2x, https://si.imgix.net/ed74a112/uploads/origins/1ba2dc1a-4db5-44e9-a78d-d89e2db5d433?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=80c09ac68302867cd49ed4fa5e5f7a56 3x"}, "body": "しろまるさん、こんにちは\n最近、あなたのシャボン玉の作品を見つけ、その出来栄えに感動したので、それを絡めたR18の作品を期待していたのです。\n\n今回のリクエストは、ランジェリー姿のアンとグレア（共にミステリアフレンズ）が巨大シャボン玉の中に入って、お互いを喜ばせるというのを目指しています。その際、二人とも横向きに寝て、竜の女の子（グレア）が尻尾を足に通して、体の間に挟んで欲しいです。できれば、アンとグレアが潮を吹いている絵も追加でお願いします。\n\n私のリクエストにご理解をいただき、楽しんでいただければ幸いです。\n\nhttps://www.dropbox.com/sh/xnzdg7zslv666gs/AABfiwZPkvaVj8oOtSgqIeBha?dl=0", "nc": 32, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@shiromaru_5st/works/11", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 730487, "client_id": 775050, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/fbd9fe10/uploads/origins/03316fa5-0975-4dd3-b64d-038a5db2cd04?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=580803460fe9d9ca62b225e24d8ab62b", "srcset": "https://si.imgix.net/fbd9fe10/uploads/origins/03316fa5-0975-4dd3-b64d-038a5db2cd04?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=580803460fe9d9ca62b225e24d8ab62b, https://si.imgix.net/fbd9fe10/uploads/origins/03316fa5-0975-4dd3-b64d-038a5db2cd04?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=2d6b07666dc851ea78e0fdecb4dfd251 2x, https://si.imgix.net/fbd9fe10/uploads/origins/03316fa5-0975-4dd3-b64d-038a5db2cd04?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=75d5c73cac2f9f004d06d9305099397b 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/fbd9fe10/uploads/origins/03316fa5-0975-4dd3-b64d-038a5db2cd04?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d2852c33bfed6b6caada073f89d9caad", "srcset": "https://si.imgix.net/fbd9fe10/uploads/origins/03316fa5-0975-4dd3-b64d-038a5db2cd04?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d2852c33bfed6b6caada073f89d9caad, https://si.imgix.net/fbd9fe10/uploads/origins/03316fa5-0975-4dd3-b64d-038a5db2cd04?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=d7fecb28dd84011a813a1d80fc6ab834 2x, https://si.imgix.net/fbd9fe10/uploads/origins/03316fa5-0975-4dd3-b64d-038a5db2cd04?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=c7b5946d75e4e54eb25e7e20f4697d14 3x"}, "body": "こちらでははじめまして\nTwitterでいつも可愛らしいイラストを拝見しております\n\n早速ですが今回お願いしたいイラストは\n『泡の中に入ったSDミニキャラ化したまいんちゃんを抱きしめてかわいがるユメノさん』\nといううちの子2人のイラストです\n\nまいんちゃん、ユメノさんの資料はこちらです↓\nhttps://twitter.com/yachi0_081/status/1478363420538060800?s=21\nhttps://twitter.com/yachi0_081/status/1454484456673140741?s=21\n\nイメージとしては2番目の資料のハロウィンイラストの状態から胸元でぬいぐるみや抱き枕のように泡ごとむにゅっと抱きしめている様子をお願いします\n\n二人の表情やリアクションは\nまいんちゃん：むがーっ！という表情でなす術なく抱きしめられている（衣装は1番目の資料のセーラー服のような服でお願いします）\nユメノさん：楽しそうに可愛がっている（ハロウィンイラストでは吸血鬼のコスプレのため尖り耳になっていますが今回は普通の耳でお願いします）\n\n構図や二人のサイズ差はお任せします、また背景も白背景や簡易的なもので大丈夫です\n服装も不明なところを自由に補完したりアレンジして大丈夫です\n\nしろー。さんの描くむちむちな女の子とSDミニキャラがどちらも好きなので今回はその2つを組み合わせたリクエストを送らせて頂きました\n長文になりましたがよろしくお願い致します\n（露出の多い衣装のため念の為NSFWにしています）", "nc": 177, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@shiromaru_5st/works/10", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 730487, "client_id": 88668, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/1906d9e5/uploads/origins/4157d151-a3ff-4204-8bcd-1c8738cf7bbf?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=47d987ad871282c8cc61750aa75526b9", "srcset": "https://si.imgix.net/1906d9e5/uploads/origins/4157d151-a3ff-4204-8bcd-1c8738cf7bbf?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=47d987ad871282c8cc61750aa75526b9, https://si.imgix.net/1906d9e5/uploads/origins/4157d151-a3ff-4204-8bcd-1c8738cf7bbf?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=91e216f7252825ef581f005ee31885d4 2x, https://si.imgix.net/1906d9e5/uploads/origins/4157d151-a3ff-4204-8bcd-1c8738cf7bbf?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c3dc85a740e69793f22d27e8fe716347 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/1906d9e5/uploads/origins/4157d151-a3ff-4204-8bcd-1c8738cf7bbf?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=70be1a41220487514d1512d9b474ada2", "srcset": "https://si.imgix.net/1906d9e5/uploads/origins/4157d151-a3ff-4204-8bcd-1c8738cf7bbf?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=70be1a41220487514d1512d9b474ada2, https://si.imgix.net/1906d9e5/uploads/origins/4157d151-a3ff-4204-8bcd-1c8738cf7bbf?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=707ba61b50a77680d7b02793cf9dc483 2x, https://si.imgix.net/1906d9e5/uploads/origins/4157d151-a3ff-4204-8bcd-1c8738cf7bbf?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=93e3641d24bab518c0e190bb75088681 3x"}, "body": "リクエストでは初めまして、ルミナスタジオのバーチャルビデオクリエイターの輝鳴紅葉です。早速ではございますがTwitterでお伝えした通りリクエストをさせて頂きます！\n\nリクエスト内容はそのまま『バーチャルビデオクリエイター輝鳴紅葉』をお願いいたします。以下が大まかなキャラクター設定です。\n----------\nシャボン玉の体でできている彼女はその身こそある程度人の形を成しているものの、その大半はシャボン玉のまま。僅かに見える肌身はシャボン膜のようにツルツルでぷにぷにとしています。男口調なのにシャボン玉ゆえの女性的で軽やかなふわふわとした物腰はまさに優しい混沌とも言えるでしょう。\nシャボン玉の体は触られるのが好きなので、誰でも頼めばその体に埋めてくれること間違いなし。膨らむのが性癖で、自身で膨らむのも良いし『膨らませてもらう』のはもっと好き。シャボン玉は人間とは違う不思議な嗜好を持っているようです。\n常にシャボン玉が周りで生まれ、触れても割れないそれは好きな人に不思議で楽しいシャボン玉遊びをもたらしてくれます。飛び跳ねてもよし、飲み込んでもよし、そして包まれるのもよし。でも飲み込んだり包まれたりするとその夢の力がその人を取り込んで『シャボン化』してしまいますが、それもまた楽しいシャボン玉遊び。気持ちよく楽しんでもらえるのがシャボン玉の日常なのです。\n----------\n資料URLにアートワークや三面図がございますのでぜひご確認くだ