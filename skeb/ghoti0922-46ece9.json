先生のお好きなように描いていただければと思います。\n\nご検討をお願いします。\n\nhttps://drive.google.com/drive/folders/1zl3OIzED5qj-WAzJVOj5C4fYeKdniHI1?usp=sharing", "nc": 25, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 1059353, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "なな獅子/なるねし", "screen_name": "M8Ea3", "avatar_url": "https://pbs.twimg.com/profile_images/1878266198078734336/t2igSZ6f.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1043875663826976769/1767193508/1500x500", "appeal_receivable": true, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 62, "skills": [{"genre": "art"}], "banned": false, "nc": 160}, {"id": 1238012, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "KCC🍭SDSkeb", "screen_name": "KCC_014", "avatar_url": "https://pbs.twimg.com/profile_images/1883826696467746816/psBH9OK3.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1275415982819864578/1665908823/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 100, "skills": [{"genre": "art"}], "banned": false, "nc": 161}, {"id": 1650340, "creator": true, "nsfw_acceptable": false, "acceptable": false, "name": "ヨジマエ", "screen_name": "0359_am", "avatar_url": "https://pbs.twimg.com/profile_images/1403141495528431616/iUxJ_AD6.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1403131816530178050/1652538601/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 90, "skills": [{"genre": "