&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=471565b7ba21f10769974f0b8dfaca51, https://si.imgix.net/648d7b11/uploads/origins/28ed5af4-cde0-4170-a338-3dc276ee15e4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c5703bae16489b3c3660b01be6498040 2x, https://si.imgix.net/648d7b11/uploads/origins/28ed5af4-cde0-4170-a338-3dc276ee15e4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a087f7c22aa42e8432dac5b93603c5ad 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/648d7b11/uploads/origins/28ed5af4-cde0-4170-a338-3dc276ee15e4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3bccaac5cc262c0c93b4ec478faae343", "srcset": "https://si.imgix.net/648d7b11/uploads/origins/28ed5af4-cde0-4170-a338-3dc276ee15e4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3bccaac5cc262c0c93b4ec478faae343, https://si.imgix.net/648d7b11/uploads/origins/28ed5af4-cde0-4170-a338-3dc276ee15e4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=865f9abe875886d7e62d5ef55dfd19da 2x, https://si.imgix.net/648d7b11/uploads/origins/28ed5af4-cde0-4170-a338-3dc276ee15e4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=e6f9dc520678f3b9f9d011c710f90f8d 3x"}, "body": "こんにちは。デザイナー兼動画投稿者として活動している四ノ宮と申します。Twitterにて、いつもとても素敵な絵を拝見させていただいております。Skebを開いていただけてとても嬉しいです。今回、私（四ノ宮）のキャラクターを描いていただきたく思い、リクエストさせていただきます。\n\n【お願いしたいこと】\n資料では、目にひし形のハイライトが入っていますが、よろしければ通常通り（ひし形のハイライトは無し）の目で描いていただきたいです。\n【雰囲気】\n最近🎄というタイトルで投稿されていたイラストや、morning❕🍳 というタイトルで投稿されていた絵のようなキラキラとした表現が好きなので可能でしたらこのような雰囲気でお願いしたいです。（雰囲気の違うイラストを2点挙げてしまいすみません。）\n【表情】\n基本的に全てお任せします。少しすました顔や微笑むくらいの表情が好きです。\n【構図・背景・衣装】\n構図、背景共にお任せします。サムネイルにて使用させていただきたい為、なるべく正面を向いている構図に近いと嬉しいです。\n衣装に関しても、資料に載せている衣装は装飾の増減等問題ありません。描きやすいように描いていただけましたら幸いです。\n【使用用途】\nSNSでの活動（Youtube等動画のサムネイル、xのアイコンや告知画像等)\n\n\n【納品形式】\n透過画像かPSDデータがいただけたら大変嬉しいです。\n\nお忙しい中、長文失礼致しました。\nキャラの詳細は資料を見ていただけますと幸いです。\nご検討よろしくお願いします。\n\nリクエスト金額等不備がございましたら、お手数ですが再送要請を送っていただけますと幸いです。\n\n↓キャラクターの設定画です。\nhttps://drive.google.com/file/d/1-_MkwjzlUDHd2GK8N3mKQzf0MM7QtQf9/view?usp=share_link", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@sasi_sasi_222/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2947498, "client_id": 261332, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/f61ae7cb/uploads/origins/1b5921b5-b444-4f64-975e-ab661a20494d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=21d373e906c67b3353ab36e3c8a624f9", "srcset": "https://si.imgix.net/f61ae7cb/uploads/origins/1b5921b5-b444-4f64-975e-ab661a20494d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=21d373e906c67b3353ab36e3c8a624f9, https://si.imgix.net/f61ae7cb/uploads/origins/1b5921b5-b444-4f64-975e-ab661a20494d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=6fa40c33f8e2b95b30dc76963f1b4f43 2x, https://si.imgix.net/f61ae7cb/uploads/origins/1b5921b5-b444-4f64-975e-ab661a20494d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=45bc3b7a47e788053dc16ae484000ce9 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/f61ae7cb/uploads/origins/1b5921b5-b444-4f64-975e-ab661a20494d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2f23e43afdb6a4fd140ae1608c0e3532", "srcset": "https://si.imgix.net/f61ae7cb/uploads/origins/1b5921b5-b444-4f64-975e-ab661a20494d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2f23e43afdb6a4fd140ae1608c0e3532, https://si.imgix.net/f61ae7cb/uploads/origins/1b5921b5-b444-4f64-975e-ab661a20494d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop