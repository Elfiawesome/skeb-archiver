y much, i hope you consider my request!\n\nhttps://drive.google.com/file/d/1rBWmLHxTLaA1Tq54II6FCS6OxUU9sfjG/view?usp=sharing", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@NYAsan/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3906024, "client_id": 3725612, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/f8b0e380/uploads/origins/251301dc-9a78-4688-babb-942a05a3c46e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fabad2d005c1ef407deabf4b36e85a96", "srcset": "https://si.imgix.net/f8b0e380/uploads/origins/251301dc-9a78-4688-babb-942a05a3c46e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fabad2d005c1ef407deabf4b36e85a96, https://si.imgix.net/f8b0e380/uploads/origins/251301dc-9a78-4688-babb-942a05a3c46e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c770b922b6242965e296a3f88091fa8c 2x, https://si.imgix.net/f8b0e380/uploads/origins/251301dc-9a78-4688-babb-942a05a3c46e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=cd114dfc11e01671118e1c9e8733d6a6 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/f8b0e380/uploads/origins/251301dc-9a78-4688-babb-942a05a3c46e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=cd61fff7a03990f31864993614a5778a", "srcset": "https://si.imgix.net/f8b0e380/uploads/origins/251301dc-9a78-4688-babb-942a05a3c46e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=cd61fff7a03990f31864993614a5778a, https://si.imgix.net/f8b0e380/uploads/origins/251301dc-9a78-4688-babb-942a05a3c46e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=2d4776bfb40e3d7d73d7ac15239045af 2x, https://si.imgix.net/f8b0e380/uploads/origins/251301dc-9a78-4688-