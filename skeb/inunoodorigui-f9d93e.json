ix.net/69aafd4a/uploads/origins/3c0cf9cf-d5e1-4d23-b79f-0ae054d6782f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d1a5e72e43a048ed2781250daba28321", "srcset": "https://si.imgix.net/69aafd4a/uploads/origins/3c0cf9cf-d5e1-4d23-b79f-0ae054d6782f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d1a5e72e43a048ed2781250daba28321, https://si.imgix.net/69aafd4a/uploads/origins/3c0cf9cf-d5e1-4d23-b79f-0ae054d6782f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=c26ce24f689e617d85bb93403ad4612e 2x, https://si.imgix.net/69aafd4a/uploads/origins/3c0cf9cf-d5e1-4d23-b79f-0ae054d6782f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=2550fac40580b6e9d0840c8fad26a38c 3x"}, "body": "👋こんにちは！あなたのアートスタイルにすっかり魅了されちゃいました！！私は「Liffeh」という名のVTuberです！\n\n私のオリジナルキャラクターを描いていただけないか、ご興味があるかお伺いしたくて！ 彼は、ポンチョという名前のカピバラの森の精霊に取り憑かれた、混沌としていてエネルギッシュで、おどけた人間なんです！デザインコンセプトは温泉と自然をモチーフにしています。\n\n🎨 クリエイティブな方向性や構図は、すべてあなたにお任せします！！カッコいいポーズや面白いポーズで描いていただけたら嬉しいです！ キャラクターにはいくつかの重要な特徴があります：細身ですが服の下は筋肉質で、頭には人間の耳に加えて、幽霊のように半透明なカピバラの耳がついています。メガネは金色のフレームで、レンズは赤色で同じく半透明です。髪の色は、参考画像と同じ緑の色合いにしてください！\n🔗 参考画像はこちらです：https://drive.google.com/drive/u/0/folders/1ddjSGAGg1C0AnDjcK8HENOYUO9zbNXOP\n\n使用目的は、XなどのSNS（投稿、アイコン、グラフィック）です。ご依頼をご検討いただきありがとうございます！\n\nhttps://drive.google.com/drive/u/0/folders/1ddjSGAGg1C0AnDjcK8HENOYUO9zbNXOP", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@inunoodorigui/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 4093495, "client_id": 514418, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/5bab3b89/uploads/origins/effbe6a2-486c-4e68-94d2-d881d77fbcef?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1f42040bce24ffe2d7b0eb8595e04a27", "srcset": "https://si.imgix.net/5bab3b89/uploads/origins/effb