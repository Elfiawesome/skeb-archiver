ormat%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=2ca380d7c3597db922b2e48313d0136e 2x, https://si.imgix.net/cec216a5/uploads/origins/1e4f1990-40ef-45a3-8757-79678e51b2b3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=11f7809e0341ee8c25adffaf3defc0ec 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/cec216a5/uploads/origins/1e4f1990-40ef-45a3-8757-79678e51b2b3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9b3b233085384863969e003461717cbd", "srcset": "https://si.imgix.net/cec216a5/uploads/origins/1e4f1990-40ef-45a3-8757-79678e51b2b3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9b3b233085384863969e003461717cbd, https://si.imgix.net/cec216a5/uploads/origins/1e4f1990-40ef-45a3-8757-79678e51b2b3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=0b386d6d8a027041adee2cf79e37b5f4 2x, https://si.imgix.net/cec216a5/uploads/origins/1e4f1990-40ef-45a3-8757-79678e51b2b3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=ccc38ea00ae9c6280acad4157f09e6f5 3x"}, "body": "きゅうさん初めまして！\n普段からお世話になってます、貴方の描く絵がとても大好きです。人を1発で射止めれる絵をかけるところに尊敬を覚えます。\nそんなきゅうさんに是非お金を落としたく、リクエスト送らせてもらってます。\n金額や内容に不備などあれば再送して下さると幸いです！\n\n\n【使用用途】\n個人利用/鑑賞用/自慢\n\n【依頼内容】\n✧︎双子or3人組の漫画\n↪︎簡易的で構いません。描きやすい形で描いていただければ幸いです\n\n✧︎BL/CP表現の有無\n↪︎全てお任せします。左右も決まりがないので、描かれる場合はお好みでお願いします！\n\n✧︎NG\n↪︎特にございません、強いて言うなら赤面が大好物です。 \nキャラ解釈で言うと、両方とも善性/常識 がある子です。\nそれを踏まえた上で 描いていただけると助かります……！\n\nシチュエーション等お任せします。\n\n【キャラクター詳細】\n\n◾︎1人目🐱︰神山 猫也\n「犬みたいな猫」\n・年齢:21歳/男性/176cm/ENFP/双子の弟\n趣味▶旅、酒、交流！\n\n・口数が多く 動 である、フレンドリーな性格で周りを明るくする。\nリアクション豊富。\n・大学生で アウトドアサークルに入っている。\n・フォロワー多めの男   \n\n「おお……おお！おーい！また会ったねー！俺のこと覚えてる？猫也だよ！忘れたとは言わせないよ〜？」\n\n「エッ、……なに。乗ってやれるほどの恋愛話なんて持ち合わせてないからね俺……。」\n\n◾︎2人目🐶︰神山 犬也\n「猫みたいな犬」\n・年齢:21歳/男性/177cm/双子の兄/ISTP\n趣味▶読書、習字、平穏\n\n・口数が少なく静である。心身ともに堅物だが情に厚い。\n落ち着きがあるとも言える。\n・実家が神社で、長男の為 跡継ぎとして磨きあげられている。\n・交流は狭く深く。\n\n「俺に何か用か。手短に…しなくてもいい、こっちでどうにかする。」\n\n「寝不足は身体に支障をきたす。寝れないなら茶でも用意しよう。」\n\n\n◾︎3人目📖︰神山 祝良\n「血統書付きみたいな野良」\n・年齢:19歳/女性/171cm/義理の妹(従兄弟)/ENTJ\n\n・性格:気高く物怖じしない性格。好奇心が高く、時たまブレーキが聞かない。六法全書を常に持ち歩いている。\n・神山家 分家の長女。\n・大学生で法学部法律学科を専攻。\n\n「ふぅん…君、非常に面白いことを言う。その知見を是非とも借りたい」\n\n「なに？事件？…ポルターガイストは専門外だ。犬也に祓ってもらえ。」\n\n\n▫関係値\n\n3人組▶自由奔放な野良猫達と苦労犬\n\n双子▶正反対だけど、馬が合う。阿吽の呼吸。両方童貞です。\n\nhttps://drive.google.com/drive/folders/1D5nP59jhrQ7txbIovxDQlJ8hbFY_8UkY", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@kyutyan009/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "comic", "tipped": false, "creator_id": 3600047, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/b8094089/uploads/origins/06346904-ddf2-4b59-85d4-32a495946c75?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bcf92af401148ef5cb1b4d84bd0d4d03", "srcset": "https://si.imgix.net/b8094089/uploads/origins/06346904-ddf2-4b59-85d4-32a495946c75?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bcf92af401148ef5cb1b4d84bd0d4d03, https://si.imgix.net/b8094089/uploads/origins/06346904-ddf2-4b59-85d4-32a495946c75?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c8ce77a91f440c17e3976ea855dfe275 2x, https://si.imgix.net/b8094089/uploads/origins/06346904-ddf2-4b59-85d4-32a495946c75?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=792ceea9fc9cf716cc7237d1dd139168 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/b8094089/uploads/origins/06346904-ddf2-4b59-85d4-32a495946c75?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f8309cd6798b112852ccda1b2045c401", "srcset": "https://si.imgix.net/b8094089/uploads/origins/06346904-ddf2-4b59-85d4-32a495946c75?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&c