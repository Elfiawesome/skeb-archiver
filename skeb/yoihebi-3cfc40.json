&crop=top&w=200&h=200&s=1c83e8eddb8132a7437a982d96454f2c 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/f5defe7b/uploads/origins/7ff3f297-ab57-488b-9d69-3dc9784a39c1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ab8d494592d813e3ccdc5f5ee265a5e9", "srcset": "https://si.imgix.net/f5defe7b/uploads/origins/7ff3f297-ab57-488b-9d69-3dc9784a39c1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ab8d494592d813e3ccdc5f5ee265a5e9, https://si.imgix.net/f5defe7b/uploads/origins/7ff3f297-ab57-488b-9d69-3dc9784a39c1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=4eed0f5d772afc3d16abca60990494e1 2x, https://si.imgix.net/f5defe7b/uploads/origins/7ff3f297-ab57-488b-9d69-3dc9784a39c1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=3faf099e9ee605b989a28b9b244b66de 3x"}, "body": "はじめまして！主にニコニコ静画やシブで認知しておりました\nあなたの書くなにかやさしい絵に魅力を感じ私も依頼したいと思い至りました、絵の話をしていきたいと思います\n\n東方智霊奇伝に出てくる幽谷響子(in宮出口瑞霊)を描いてほしいのです\n\n端霊が憑依ってない通常の響子も欲しいです\n\n可能ならいろんな場所に…\nやさしい絵が魅力～と言っておきながら悪そうな響子の依頼ですが…ご検討よろしくお願いいたしますわ", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@yoihebi/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 66366, "client_id": 41262, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/daf680a1/uploads/origins/6a80306c-ba29-460e-a208-53ec535dfa4d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0ecad029f76fbfb0465228f244f904b0", "srcset": "https://si.imgix.net/daf680a1/uploads/origins/6a80306c-ba29-460e-a208-53ec535dfa4d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0ecad029f76fbfb0465228f244f904b0, https://si.imgix.net/daf680a1/uploads/origins/6a80306c-ba29-460e-a208-53ec535dfa4d?bg=%23fff&auto=forma