の描かれる金属の表現が大好きなので...😭)\n\n*ピアス:記載されていませんがインダスが無い方にアンテナを2つ追加でお願いいたします。\n猫耳みたいな感じです。\n\n\n以上となります、よろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/1-wQ8PoCe3Qifu3jcubbcarhRk_vlZGH_", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}], "similar_creators": [{"id": 828572, "creator": true, "nsfw_acceptable": false, "acceptable": false, "name": "ゆち🦄", "screen_name": "OREKASASASUKEDO", "avatar_url": "https://pbs.twimg.com/profile_images/1970904912440721412/Pwvd_ygS.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1290454080599490562/1646709861/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 10, "complete_expiration_days": 120, "skills": [{"genre": "art"}], "banned": false, "nc": 145}, {"id": 2729188, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "たたた", "screen_name": "setanuinui", "avatar_url": "https://pbs.twimg.com/profile_images/2028821668446285824/ndne0wZO.jpg", "header_url": "https://pbs.twimg.com/profile_banners/781797139429019648/1685352846/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 10, "complete_expiration_days": 120, "skills": [{"genre": "art"}], "banned": false, "nc": 0}, {"id": 2753664, "creator": true, "nsfw_acceptable": false, "acceptable": false, "name": "ふあんㄘゃん🧸", "screen_name": "Fuan_xxx", "avatar_url": "https://pbs.twimg.com/profile_images/1510050329315840005/klVv9oAL.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1291153140360699906/1723878309/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 3, "complete_e