ttps://si.imgix.net/bb06b2f3/uploads/origins/65e7db6f-fcb6-4658-b8e7-98bcc9ba86f0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=46bef6fb40477b9e053352e56efaf61c, https://si.imgix.net/bb06b2f3/uploads/origins/65e7db6f-fcb6-4658-b8e7-98bcc9ba86f0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=39c9c8e88fbc44a68c3467d1287ac26c 2x, https://si.imgix.net/bb06b2f3/uploads/origins/65e7db6f-fcb6-4658-b8e7-98bcc9ba86f0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=37e35005a8ba77b372f868c336952cf8 3x"}, "body": "こんにちは！サムネやSNSなどの配信活動に使うイラストをお願いしたいと思いリクエストさせて頂きました！\n\n添付資料のキャラクターで構図や表情はおまかせしたいのですが背景透過のデータがあるとうれしいです！\n\nskebに慣れていないので至らぬ点ございましたら申し訳ないのですがお時間あればご検討下さい！\n\nhttps://drive.google.com/drive/folders/1-3eFWV8yzcQmT0MoMOYCQh69pRxa1Kid", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@fenoru_8503/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 910542, "client_id": 1055192, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/f4f81872/uploads/origins/4f46e01a-21a9-4cc3-9a17-8ea4cdd45cec?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a699c2686ea00e3ab1046df4051d51c5", "srcset": "https://si.imgix.net/f4f81872/uploads/origins/4f46e01a-21a9-4cc3-9a17-8ea4cdd45cec?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a699c2686ea00e3ab1046df4051d51c5, https://si.imgix.net/f4f81872/uploads/origins/4f46e01a-21a9-4cc3-9a17-8ea4cdd45cec?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a5aed118c6ace16c10998c9d1ad4e741 2x, https://si.imgix.net/f4f81872/uploads/origins/4f46e01a-21a9-4cc3-9a17-8ea4cdd45cec?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=96c75e2e7fef66aecb2269dfdf064239 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/f4f81872/uploads/origins/4f46e01a-21a9-4cc3-9a17-8ea4cdd45cec?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d6443dc820c62ad82fc95c9d46256271", "srcset": "https://si.imgix.net/f4f81872/uploads/origins/4f46e01a-21a9-4cc3-9a17-8ea4cdd45cec?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d6443dc820c62ad82fc95c9d46256271, https://si.imgix.net/f4f81872/uploads/origins/4f46e01a-21a9-4cc3-9a17-8ea4cdd45cec?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=a48283ada2706eb6f99badfe977087f0 2x, https://si.imgix.net/f4f81872/uploads/origins/4f46e01a-21a9-4cc3-9a17-8ea4cdd45cec?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=24c8b7d06fec505154bdf9c26a534658 3x"}, "body": "こんにちは、私のオリジナルキャラクター「アイナ」の全身イラストをお願いしたいのです。巨大ロボットに乗って戦う女ゴブリンです。\n\n髪の色は銀色で、髪型はポニーテールです。髪の真ん中が薄っすらと青みがかった色をしています。瞳の色は金色。また、参考画像のように顔にバンドエイドを貼っています。\nhttps://imgur.com/V7juI5O\n\n身長90cmほどの小柄な緑色のゴブリンです。笑顔の中に牙がある。\nhttps://imgur.com/IILis9h\n\nピンク色の短いオーバーオールを着ている。\nhttps://imgur.com/a/AzMlkSa\n\nこの服はもっと可愛くなるように、自由にアレンジしてください。靴や靴下は履いていません。\n\n首からかけるゴーグルを追加してください。ロボットのメンテナンスをしているのですが、レンチや工具箱などの小物を追加してください。\n\n自信家でケンカが大好き。ポーズや細かいところはお任せします。カッコよくてカワイイをテーマにしたいです。\n\nhttps://imgur.com/a/j3NgGls", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@fenoru_8503/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 910542, "client_id": 793877, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/9b9b734b/uploads/origins/9e1b8117-730b-43ab-87e3-56125ffa8871?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2c8ee7bf34b8e57a470b1218a304fb09", "srcset": "https://si.imgix.net/9b9b734b/uploads/origins/9e1b8117-730b-43ab-87e3-56125ffa8871?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2c8ee7bf34b8e57a470b1218a304fb09, https://si.imgix.net/9b9b734b/uploads/origins/9e1b8117-730b-43ab-87e3-56125ffa8871?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=83eb756e6effe6644aa7a818c6170210 2x, https://si.imgix.net/9b9b734b/uploads/origins/9e1b8117-730b-43ab-87e3-56125ffa8871?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=8f33967ac460e0aa6c32431822f12ef5 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/9b9b734b/uploads/origins/9e1b8117-730b-43ab-87e3-56125ffa8871?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d5b36fc548e435021e8e80a4237237fc", "srcset": "https://si.imgix.net/9b9b734b/uploads/origins/9e1b8117-730b-43ab-87e3-56125ffa8871?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d5b36fc548e435021e8e80a4237237fc, https://si.imgix.net/9b9b734b/uploads/origins/9e1b8117-730b-43ab-87e3-56125ffa8871?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=fffc2525581797d946c381a660d698b9 2x, https://si.imgix.net/9b9b734b/uploads/origins/9e1b8117-730b-43ab-87e3-56125ffa8871?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=d5e2765febf628c03c81f3857aea344a 3x"}, "body": "宝生フェノル様お世話になっております。前回お願いしましたこーほく(古山)です\nURLの様なキャラのフィギュアを販売中で、新作モチーフを必要としています\n前回がほぼ理想に近かったので、またべつの感じでお願いいたします。\n\n無邪気な薄着少女のキャラを、等身はJCくらい、裸足の全身画をお願いします\nhttps://drive.google.com/file/d/1nwJ55U55jM8KS5ACtXndjRf7x9bagzGA/view?usp=sharing\n\n衣装：フィギュアのように布をまとって縛っただけのようなシンプルかつ面積少な目な感じで\n形状は前回のような感じで、もう少し裾を短く、背中の布を省略して前面を首の後ろで結ぶ等、多少変化をさせて下さい。\n完全な水着やズボン形状は避けて下さい\nその他、腋乳、はいてない風などのアクセントやケモノ記号も歓迎です\n\nポーズ：お得意なポーズ等、映えると思われるポーズをお好みで。前回のような活発な感じが嬉しいです\nキャラ・表情・髪型等・配色等：お任せします\n\n衣装や髪の見えない方向(背中等)からのごく簡単なラフ画もあると嬉しいです\n迷ったらお好み・お得意なもの・マイキャラ等を当てはめて下さい\n背景はありでもなしでもOK\n\n宜しくご検討願います\n\nhttps://drive.google.com/file/d/1nwJ55U55jM8KS5ACtXndjRf7x9bagzGA/view?usp=sharing", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@fenoru_8503/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 910542, "client_id": 793877, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/3fdf2e88/uploads/origins/dbdaa784-adf4-41bd-bf62-afc093c6351c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9d4579fa8bc5c5e8512ff1816c70d0ca", "srcset": "https://si.imgix.net/3fdf2e88/uploads/origins/dbdaa784-adf4-41bd-bf62-afc093c6351c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9d4579fa8bc5c5e8512ff1816c70d0ca, https://si.imgix.net/3fdf2e88/uploads/origins/dbdaa784-adf4-41bd-bf62-afc093c6351c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=d3d4dc5e3e39ededafa87e2e7266ddb9 2x, https://si.imgix.net/3fdf2e88/uploads/origins/dbdaa784-adf4-41bd-bf62-afc093c6351c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ae2d183ff98cae0dd71af5acb830392f 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/3fdf2e88/uploads/origins/dbdaa784-adf4-41bd-bf62-afc093c6351c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=98381def88e7e4a659f0531ca87f405d", "srcset": "https://si.imgix.net/3fdf2e88/uploads/origins/dbdaa784-adf4-41bd-bf62-afc093c6351c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=98381def88e7e4a659f0531ca87f405d, https://si.imgix.net/3fdf2e88/uploads/origins/dbdaa784-adf4-41bd-bf62-afc093c6351c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=3225b349a625eb30f9d55cd253f7541e 2x, https://si.imgix.net/3fdf2e88/uploads/origins/dbdaa784-adf4-41bd-bf62-afc093c6351c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fi