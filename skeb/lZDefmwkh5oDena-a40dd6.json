mat%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=a8eac5a49c985bfb344b493830ecb9eb 3x"}, "body": "砂浜のさめさんこんにちは！スケブ再開をずっと待っていました！\n今回頼みたいのは、さめさんが結構むかしに描いた、らくがき形式のFGOの酒呑童子ですが、\n改めて完成品としてぜひ描いていただきたいです！\n\nシチュは同じく以前あなたが描いた「生志摩ちゃん」と同様、逆NTRボテ腹プレイでお願いします。\n設定はマシュ視点で、マスターが酒呑に寝取られ、二人が堕胎セックスをみせている。\nそして酒呑はマシュに、今マスターの性癖は彼女によって変わっていて、\nもう堕胎セックスじゃないといけない体になったと言いつつ、\n彼に満足できるのは、体が頑丈な鬼族しかないから、マスターは一生彼女のものだとマシュをバカにして煽っている。\n構図やセリフ、堕胎マークの数はさめさんにお任せします。\n（堕胎マークは多めでお願いしたいですが、酒呑ちゃんのボテ腹がどのように描いていただくのかわからないので、できる範囲で大丈夫です）\nぜひよろしくお願いします！", "nc": 59, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@lZDefmwkh5oDena/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 968882, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/167c693f/uploads/origins/ff17f1f2-3125-4c1a-b295-dc1060a39068?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ff3ec41bce788f08d5ebdbdb7a4fc191", "srcset": "https://si.imgix.net/167c693f/uploads/origins/ff17f1f2-3125-4c1a-b295-dc1060a39068?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ff3ec41bce788f08d5ebdbdb7a4fc191, https://si.imgix.net/167c693f/uploads/origins/ff17f1f2-3125-4c1a-b295-dc1060a39068?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=28155d70a527c59354e6f13a77fd14ad 2x, https://si.imgix.net/167c693f/uploads/origins/ff17f1f2-3125-4c1a-b295-dc1060a39068?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=5275d0bcf70aad66dc1bc6f1cf3b0c99 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/167c693f/uploads/origins/ff17f1f2-3125-4c1a-b295-dc1060a39068?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c4566bd0fb9dc5ffd00b26191e98bbc2", "srcset": "https://si.imgix.net/167c693f/uploads/origins/ff17f1f2-3125-4c1a-b295-dc