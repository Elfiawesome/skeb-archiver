gix.net/23d77258/uploads/origins/ffb4a931-869c-4fec-92a7-ab011f347036?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=2510fd98e29760b57e87a524a6fadb14 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/23d77258/uploads/origins/ffb4a931-869c-4fec-92a7-ab011f347036?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=33c59162c6ed80358e0c81518d123f97", "srcset": "https://si.imgix.net/23d77258/uploads/origins/ffb4a931-869c-4fec-92a7-ab011f347036?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=33c59162c6ed80358e0c81518d123f97, https://si.imgix.net/23d77258/uploads/origins/ffb4a931-869c-4fec-92a7-ab011f347036?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=a0ac8c3d145c71578dd7a3d198927d8b 2x, https://si.imgix.net/23d77258/uploads/origins/ffb4a931-869c-4fec-92a7-ab011f347036?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=7aeecb75759542aa623b0128b1eaa0c8 3x"}, "body": "こんにちは！あなたの画風で私のキャラクターを描いていただけないでしょうか。参考画像はありませんが、普段私が彼女をデザインする際はこんな感じです。\n\n【使用目的】 ソーシャルメディアのプロフィール画像やバナーなど、表示用（クレジット表記あり）\n【キャラクター説明】 長い黒髪、色白の肌、少し尖った耳（エルフのような）、そして小さな吸血鬼の牙を持つ女性\n【瞳の色】 異色瞳：片方が灰色、もう片方が濃い赤色\n【配色】 黒の服に、白、灰色、または赤のアクセントやアクセサリー\n【アクセサリー】 ジュエリーがある場合は、銀製\n\n参考になるかもしれない詳細はこちらです：\n\n【性格】 彼女は半分悪魔で、どちらにも完全に属しているわけではありません。 人間社会で暮らそうとしているが、周囲に馴染めないことを恐れて内気で臆病だ。典型的な内気なキャラクターというわけではないが、意図せず冷たく距離を置いているように見えてしまう。しかし心の中では、どこかに居場所を見つけたいと願っている。\n【テーマ】 家で過ごす気楽な一日、または友人とくつろぐ様子（彼女のみを描いてください）\n【ポーズ】 顔アップまたは上半身。髪を整えている様子でもよい。\n【スタイル】このテーマにはモダンな雰囲気が合います。カーディガン、ショール、またはフーディを着ているイメージです。アクセサリーは、繊細な月のネックレスと、指が見える場合はどの指にでも良いので細い指輪を。また、剣の形をしたイヤリングを、同じ耳の別のピアス穴とチェーンでつなぐのも良いでしょう。メガネをかける場合は、どんな形でも良いので細い金属フレームが彼女に似合います。\n【髪型】 よりエレガントな雰囲気を演出するため、ストレートヘアではなく、毛先を少しウェーブやカールさせたデザインにすることもあります。前髪の有無に迷う場合は、彼女の内気な性格に合わせて前髪を入れても良いでしょう。このテーマでは、髪をラフに結んだスタイルもおすすめです。\n\nこれらの詳細はあくまで参考としてください。不明な点や別のアイデアがあれば、遠慮なく調整してください。\n\nお時間をいただきありがとうございます。ぜひこの依頼をお引き受けいただけますと嬉しいです！❤️", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@n5_neko/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1978649, "client_id": 2143204, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/8badd71a/uploads/origins/f841c419-b2df-4382-b022-51b5529e50a5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=88f3ee9b477b0935b6ed8f1e9bfe8ee0", "srcset": "https://si.imgix.net/8badd71a/uploads/origins/f841c419-b2df-4382-b022-51b5529e50a5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=88f3ee9b477b0935b6ed8f1e9bfe8ee0, https://si.imgix.net/8badd71a/uploads/origins/f841c419-b2df-4382-b022-51b5529e50a5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ca4c253a5ef2aef5245974e3266b1475 2x, https://si.imgix.net/8badd71a/uploads/origins/f841c419-b2df-4382-b022-51b5529e50a5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=26bf32803f9fd2bbe8b78c31ae0ffe18 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/8badd71a/uploads/origins/f841c419-b2df-4382-b022-51b5529e50a5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=8b27c71b0faf03efcd4746ee05aa7456", "srcset": "https://si.imgix.net/8badd71a/uploads/origins/f841c419-b2df-4382-b022-51b5529e50a5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=8b27c71b0faf03efcd4746ee05aa7456, https://si.imgix.net/8badd71a/uploads/origins/f841c419-b2df-4382-b022-51b5529e50a5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=d7e6f902b9045c99e3e7b04a5b947649 2x, https://si.imgix.net/8badd71a/uploads/origins/f841c419-b2df-4382-b022-51b5529e50a5?bg=%23fff&auto=format%2Ccompress&fm=web