8b880e-9fc2-4f7f-945c-6e9025d6816e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=24efe00349bb90e2725d8ccf1c51bf59 3x"}, "body": "おはようございます。朝早くに失礼します。依頼をお願いします。\n内容はドラクエ3の二次作品で、女勇者のごうけつぐま化です。\n\n女勇者が以前見逃したカンダタの罠にはまり、囚われる。\nカンダタは相手を下僕にする呪いの腕輪を持っており、勇者にはめる。すると、女勇者がごうけつぐまに変わる(カンダタにとっても予想外)。\n女勇者はカンダタを主と認めて情婦のようにすり寄り、カンダタも安心する。しかし、女勇者はそのままカンダタを性的に襲い、同族化する。\n魔物となったカンダタは力に溺れ、女勇者と二人で手下のすべてを魔物化。一行は魔物の盗賊団として暴れ回る。\n\n以上、おおまかな流れを書かせていただきました。まくまで目安ですので、白アン山さんの書きやすいように改変してくださって構いません。\nただし、魔物化した女勇者がカンダタを同族化する理由は、主をより強くしたいという善意の暴走だという点だけ指定させていただきます。\nよろしくお願いします。", "nc": 48, "word_count": 4208, "transcoder": "text", "creator_acceptable_same_genre": false}, {"path": "/@kameino_nanashi/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "novel", "tipped": false, "creator_id": 3509657, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/d4b122ca/uploads/origins/c994617f-3cb7-40b4-aa88-43ef0ed75051?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6a451f750125ab855929193cf7079200", "srcset": "https://si.imgix.net/d4b122ca/uploads/origins/c994617f-3cb7-40b4-aa88-43ef0ed75051?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6a451f750125ab855929193cf7079200, https://si.imgix.net/d4b122ca/uploads/origins/c994617f-3cb7-40b4-aa88-43ef0ed75051?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a0d8dda203199aa6b4bc5d5397c61d30 2x, https://si.imgix.net/d4b122ca/uploads/origins/c994617f-3cb7-40b4-aa88-43ef0ed75051?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=311f42a515fec47e1b065a490775b352 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/d4b122ca/uploads/origins/c994617f-3cb7-40b4-aa88-43ef0ed75051?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=761412c6227245bb88e30ae017d1e835", "srcset": "https://si.imgix.net/d4b122ca/uploads/origins/c994617f-3cb7-40b4-aa88-43ef0ed75051?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=761412c6227245bb88e30ae017d1e835, https://si.imgix.net/d4b122ca/uploads/origins/c994617f-3cb7-40b4-aa88-43ef0ed75051?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=da3c7ad6f5a3e5fb916c61b1ab6198b5 2x, https://si.imgix.net/d4b122ca/uploads/origins/c994617f-3cb7-40b4-aa88-43ef0ed75051?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=2f04ad4740bc1725e68eecaaf2bdd429 3x"}, "body": "こんにちは。先日のライブ・ア・ライブのベヒーモスTF作品、とてもよかったです。アンケートにあった西部編のネタを読んでみたく思い、リクエストさせていただきます。\nサンダウンの牝馬獣人化に加えて、ディオとサンダウンの二人が新たなクレイジー・バンチを組織するために人間を馬獣人に変える内容も入れてくれるとありがたいです。\n気に入りましたら、よろしくお願いします。", "nc": 41, "word_count": 4093, "transcoder": "text", "creator_acceptable_same_genre": false}, {"path": "/@kameino_nanashi/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "novel", "tipped": false, "creator_id": 3509657, "client_id": 251120, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/e388622b/uploads/origins/31a70f7a-a24d-4744-92b0-88a98d3d4265?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=75eaabdcbf38181b936cbab2c7057f5b", "srcset": "https://si.imgix.net/e388622b/uploads/origins/31a70f7a-a24d-4744-92b0-88a98d3d4265?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=75eaabdcbf38181b936cbab2c7057f5b, https://si.imgix.net/e388622b/uploads/origins/31a70f7a-a24d-4744-92b0-88a98d3d4265?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=783ce8414fca5518674e3ce9e8787c0e 2x, https://si.imgix.net/e388622b/uploads/origins/31a70f7a-a24d-4744-92b0-88a98d3d4265?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=25896661ce2e79d6d6ec75de4a7987a1 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/e388622b/uploads/origins/31a70f7a-a24d-4744-92b0-88a98d3d4265?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=023a0304c6bbb6a779ccb3dceeddfd78", "srcset": "https://si.imgix.net/e388622b/uploads/origins/31a70f7a-a24d-4744-92b0-88a98d3d4265?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=023a0304c6bbb6a779ccb3dceeddfd78, https://si.imgix.net/e388622b/uploads/origins/31a70f7a-a24d-4744-92b0-88a98d3d4265?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=b438e58a71ea65ad30cbfc6c39b1301d 2x, https://si.imgix.net/e388622b/uploads/origins/31a70f7a-a24d-4744-92b0-88a98d3d4265?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=50e8a0938a4644ad124d19e20c84f776 3x"}, "body": "こんばんは、以前あったライブアライブの悪堕ちストーリーがとても良かったので、あんな感じのでＳＦ編をお願いしたくなりました。\n内容は\nゲーム中盤付近でパワージャッキ入手後にキューブがベヒーモスに襲われる場面でキューブではなくカトゥーが襲われてしまいパワージャッキが無い状態により逃げることができずベヒーモスに捕食されてしまう(口に含んだだけ)\n\nその後コンテナエリアのベヒーモスが格納されていた場所でベヒーモスに犯されてベヒーモス化してしまうカトゥー(可能であればカトゥーは中だしされた影響で産卵してしまい仲間を増やそうと伍長考えると良い(完全に悪堕ち))\n\nカトゥーは助からないから早くメインコンピュータを何とかしようと話を進める伍長とキューブだが、伍長が端末室で操作している最中にベヒーモスとベヒーモス化したカトゥーに犯されて伍長もベヒーモス化してしまいカトゥーと一緒に卵を産むメスにされてしまう(ベヒーモスに犯される二人の喜びがあると良い)\n\nキューブはＯＤ-10に敗北してベヒーモスの繁殖支援ユニットとされて卵を各部屋に運ぶ役割を与えられる。また、ベヒーモスから接種した精液をレイチェルとヒューイに注ぎ込み蘇生及びベヒーモス化して二人は愛し合っていると良い。\n\n\nその後地球にたどり着いた宇宙船から現れた多数のベヒーモスにより地球は襲われてしまいニュース番組で惨劇を報道中に報道者が犯されてしまいその様子(犯されてベヒーモス化して悪堕ちするまで)が放送されてしまうという終わり方のを作って欲しいです。\n\n話が始まるまでは大まかな話で省略して大丈夫なのと、色々付け加えている話になっていて、襲われる場面や交尾シーンや産卵シーンとか大好きなのでよろしくお願いします。", "nc": 57, "word_count": 5834, "transcoder": "text", "creator_acceptable_same_genre": false}, {"path": "/@kameino_nanashi/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "novel", "tipped": false, "creator_id": 3509657, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/31c1cd57/uploads/origins/5a8447c3-f5e0-401c-b976-556ecfe83c97?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=59b6170555f75269ee8cf1e415603abd", "srcset": "https://si.imgix.net/31c1cd57/uploads/origins/5a8447c3-f5e0-401c-b976-556ecfe83c97?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=59b6170555f75269ee8cf1e415603abd, https://si.imgix.net/31c1cd57/uploads/origins/5a8447c3-f5e0-401c-b976-556ecfe83c97?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=0c649cf6ddebdaaac6dfaaa68bf135c3 2x, https://si.imgix.net/31c1cd57/uploads/origins/5a8447c3-f5e0-401c-b976-556ecfe83c97?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f6aa534889eda8f24cfc7e4e64d9579a 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/31c1cd57/uploads/origins/5a8447c3-f5e0-401c-b976-556ecfe83c97?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=20d818cf0298de76e79ee80f0d633a36", "srcset": "https://si.imgix.net/31c1cd57/uploads/origins/5a8447c3-f5e0-401c-b976-556ecfe83c97?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=20d818cf0298de76e79ee80f0d633a36, https://si.imgix.net/31c1cd57/uploads/origins/5a8447c3-f5e0-401c-b976-556ecfe83c97?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=e82082b8b965d28f2d38454fc5d08d5e 2x, https://si.imgix.net/31c1cd57/uploads/origins/5a8447c3-f5e0-401c-b976-556ecfe83c97?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=64d40a6b58bf6a69aedb5f59e27c8514 3x"}, "body": "こんにちは、お久しぶりです。リクエストの募集を再開したようなので、一つリクエストさせていただきます。\n内容はドラゴンクエストⅤのマーサの悪堕ちです。\n\nパパスの死を悲しむマーサに対し、ミルドラースがパパスの魂を人質に妻となることを強いる。\n仕方なく受け入れるマーサだが、ミルドラースの魔力を流し込まれるうちに身も心も闇に染められ、魔族となってミルドラースに忠誠を誓う。\nミルドラースにパパスの魂の処遇を委ねられたマーサはパパスをヘルバトラーとして再生させ、魔王夫婦の付き人として使役する。\nその後、マーサは人間の世界を見渡しながら、息子とついでにヘンリーをどのようにして引き入れるかを考えながらほくそ笑む。\n\nと、このような流れです。描写は全年齢対象で構いません。お気に召しましたら、よろしくお願いします。", "nc": 137, "word_count": 5511, "t