外見は人間年齢で15歳前後 身長150cm \n𓐄 基本は人間の姿だが、寝てる時や驚いた時など気が緩むと耳としっぽが出てしまう \n𓐄 ばなな(味のもの)が大好き  \n𓐄 お胸はぺったんこ  \n\n🍼おとも\n𓐄 喋らないけれど表情豊か  \n\n\n髪や頭の先が切れていない画角ですと嬉しいです！ \nまた三面図では耳としっぽが付いていますが、付いていないものが通常になります！ \n差分として生やしていただけたら幸いです🙇🏻⋱  \n背景がある場合、人物とレイヤーを分けいただけますと幸いです🙇🏻⋱\n\nご検討の程よろしくお願いいたします.ᐟ.ᐟ\n\nhttps://drive.google.com/drive/folders/1hIuEmX_qcq4YgTjSGZQGQe5kgVqcfPMT", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@qo_uz8/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 4018162, "client_id": 3313133, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/f3b30c43/uploads/origins/77378fca-74a3-432d-8ceb-a0a6b5d53ae4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9cd3a7a6865be4ac1607c800fa3c8391", "srcset": "https://si.imgix.net/f3b30c43/uploads/origins/77378fca-74a3-432d-8ceb-a0a6b5d53ae4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9cd3a7a6865be4ac1607c800fa3c8391, https://si.imgix.net/f3b30c43/uploads/origins/77378fca-74a3-432d-8ceb-a0a6b5d53ae4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=beb618e528a8bc68da309a4d42530620 2x, https://si.imgix.net/f3b30c43/uploads/origins/77378fca-74a3-432d-8ceb-a0a6b5d53ae4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=1e6590c4989e570fa715419951014113 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/f3b30c43/uploads/origins/77378fca-74a3-432d-8ceb-a0a6b5d53ae4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=343006729ca885c8c1a3b559a4714dff", "srcset": "https://si.imgix.net/f3b30c43/uploads/origins/77378fca-74a3-432d-8ceb-a0a6b5d53ae4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=343006729ca885c8c1a3b559a4714dff, https://si.imgix.net/f3b30c43/uploads/origi