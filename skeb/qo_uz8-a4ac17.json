0038958653699?s=46\n\nhttps://x.com/qo_uz8/status/2068142271388893471?s=46\n\nこのイラストが特に好きです！宝石のように瞳が綺麗なのに、色遣いが優しく雰囲気が可愛らしくてとても好きです！\n\n【リクエスト内容】\n・お誕生日イラストとしてお祝い感のあるもの\n(お洋服はうめちゃんさまのお好きなように変えていただけると嬉しいです)\n・人物のみの透過ver・頭部などが見切れていない状態だと嬉しいです。\n\n【希望の髪型や衣装】\n・髪型おまかせ(耳は髪から生えている)\n・お祝いの雰囲気にあった衣装\n(デザインや色味はうめちゃん様にお任せ致します。)\n・目の中のハイライトはハート\n【使用用途】\n・収益化済の配信にて利用 \n・SNS各種での利用(アイコンやポスト)\n・ ネットプリント\n・サムネイル\n・FANBOXやサブスク限定限定壁紙として配布\n\n【キャラクター詳細】\n参考画像をお送りします。\nうさみみがチャームポイントのメイドです。\n・白ベースにピンクかかった髪のハーフアップ\n・目の色はピンク\n感情豊かでよく笑い、少しポンコツな所も…！\nモチーフ:桃、天使の羽、うさぎ、メイド、リボン\n\nご縁がありましたら何卒よろしくお願いします。\n不可な部分があればキャンセルをお願い致します。\n\nhttps://drive.google.com/drive/folders/14pQo6Gn-wnkVeoeoQevd2oziEHwhoo3b", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@qo_uz8/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 4018162, "client_id": 4029633, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/ef3e143c/uploads/origins/73de6b4a-1250-44fa-b021-abba10390157?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=29c30556048b305e45074529e5eba25e", "srcset": "https://si.imgix.net/ef3e143c/uploads/origins/73de6b4a-1250-44fa-b021-abba10390157?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=29c30556048b305e45074529e5eba25e, https://si.imgix.net/ef3e143c/uploads/origins/73de6b4a-1250-44fa-b021-abba10390157?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=2675ad8fce76cfacf3659d1724b8d534 2x, https://si.imgix.net/ef3e143c/uploads/origins/73de6b4a-1250-44fa-b021-abba10390157?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=53eac9abc089fb18b730e5e461bd029d 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/ef3e143c/uploads/origins/73de6b4a-1250-44fa-b021-abba10390157?bg=%23fff&auto=format%2Ccompress&fm=webp&f