7cc72a2-3560-4d1d-8b71-30c10464d801?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c13be81c37c1e374ab800b6627013896", "src_set": ""}, "body": "はじめまして。\n\nイラスト検索していて、とても魅力的なイラストだと思い、ぜひ依頼したく筆をとりました。\n\nToloveるのヒロイン、「西連寺春菜」がおねしょをしてしまっているイラストなど可能でしょうか。\n\nベットで上半身を起こしている状態で掛布団ははだけて、目の前にあらわになっている自分のおねしょのシミを恥ずかしそうに顔を真っ赤にし涙目で見下ろしている。 おねしょのシミは背中から膝裏くらいまで濡らしているでサイズ、シーツの色は純白でお願いしたいです。  \n彼女はかなりのおねしょ常習犯という設定で、シーツはシミだらけで「またやっちゃった……」みたいな吹き出しが欲しいです。 \n\nそれ以外の仔細は作者様にお任せします\n何卒よろしくお願いします。", "nc": 48, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@tikuwasawasabi/works/17", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/5d339b2c/uploads/origins/8c8b4eb7-bbe8-4f51-95da-68b8d8d21907?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=db88eae9345eb7fbbf29555ea9cf5eb8", "src_set": ""}, "private": true, "genre": "art", "tipped": true, "creator_id": 434896, "client_id": 210770, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 33, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@tikuwasawasabi/works/16", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 434896, "client_id": 0, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/3ad7a436/uploads/origins/d76e1991-d6aa-4e1f-a5e0-cf6879cfca1f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a14dd565e67e26424629667b10742ac5", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/3ad7a436/uploads/origins/d76e1991-d6aa-4e1f-a5e0-cf6879cfca1f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=99ed988dffce182a3fd2b2dead6eea29", "src_set": ""}, "body": "こんばんは\n先日のマラリヤのイラストがとても良かったのでまたリクエストさせてください\n\nキャラクターは前回同様のマラリヤで、続きのイメージです\n前回のイラストに写っていた男子生徒二人とセックスしているマラリヤでお願いします\n後ろから膣に挿入しているのと、前からマラリヤの口に挿入しているところを描いてください\n出来れば触手がマラリヤの肛門を拡げて中に挿入しているところもお願いします\n触手が動かして無理やり挿入しているか、触手の媚薬的な効果で興奮してマラリヤを犯しているかどっちかのイメージでお願いします\nマラリヤも大きく勃起した同級生の陰茎を見てしゃぶりついている感じで描いてください\n\n今回はマラリヤのお尻を強調して描いていただけると嬉しいです\n男子生徒の陰茎もガチガチに勃起して上を向いているような感じでお願いします\n今回も射精と放尿があると嬉しいです\n\nよろしくお願いします", "nc": 40, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@tikuwasawasabi/works/15", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/92de7c66/uploads/origins/10ab5195-96bb-4a40-bf10-90725e3b69f8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=6d0bb30a0d56aa35d10e54e625764f93", "src_set": ""}, "private": true, "genre": "art", "tipped": true, "creator_id": 434896, "client_id": 0, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 163, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}], "similar_creators": [{"id": 10598, "creator": true, "nsfw_acceptable": true, "acceptable": false, "name": "《道糞》", "screen_name": "michi_kuso", "avatar_url": "https://pbs.twimg.com/profile_images/1206775367651868673/Fgw13oBS.png", "header_url": "https://pbs.twimg.com/profile_banners/845111990590713856/1678978146/1500x500", "appeal_receivable": true, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "skills": [{"genre": "art"}, {"genre": "correction"}], "nc": 33}, {"id": 122825, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "梔子", "screen_name": "__kuchinashi02", "avatar_url": "https://pbs.twimg.com/profil