Z2XWt-v1gG0qA3a/view?usp=drivesdk", "nc": 160, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@tikuwasawasabi/works/37", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 434896, "client_id": 456509, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/e9d83056/uploads/origins/9216b18f-7667-41ba-af21-910568bc2eab?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=97d46cba68280740a646008807d2b554", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/e9d83056/uploads/origins/9216b18f-7667-41ba-af21-910568bc2eab?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9a05e0bd6c1d90ad9f607a804c6b95bd", "src_set": ""}, "body": "男性器から触手が精液吸引のイラストを過去に描かれているので男性器描写OKでしょうか？\n女湯を覗きor望遠なり直接で盗撮しながらオナニーしている男シチュエーションをお願い致します。\n\n男オナニーは\n資料URLに上げたような横からみた男性器断面図アップ\n精巣で精子が作られ精巣上体に溜まり\n精子が精巣上体から出て前立腺で精液となり勃起した陰茎の尿道から排泄されている、と言う流れで。\n精液量多め。\n\n女湯は先生オリジナルの女の子達が露天風呂に入っているところで\nあくまで女の子です！\nhttps://twitter.com/tikuwasawasabi/status/1574767632460713985?t=XHDj8acKPL0fhUDVeBlZnQ&s=19\n\nhttps://x.com/tikuwasawasabi/status/1736006987576688917?t=18tV-qz4u386y4LhEhTQ9w&s=09\n\n上記でご検討お願い致します。\n\nhttps://drive.google.com/file/d/1C5ucfCXNsY7vZ5k3Xcgfjty5u5DhRb8e/view?usp=drivesdk", "nc": 33, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@tikuwasawasabi/works/36", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/01139fa8/uploads/origins/79cf9454-42e0-4bfc-a2cb-8cce38ee81b4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=0439c75d6091b42fefb49b29390f9daf", "src_set": ""}, "private": true, "genre": "art", "tipped": true, "creator_id": 434896, "client_id": 913861, "vtt_url": "", "thumbnail_ima