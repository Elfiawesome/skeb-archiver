】\n・魔法図書館で使い魔猫に囲まれて暮らす白猫\n・身長150センチ（耳を含まない）\n・猫耳としっぽがあり、人間の耳がありません\n\n【参考資料】\nhttps://drive.google.com/drive/folders/12YJ1-uparnq_s7hCfYaCiP4sSk9bZMpW?usp=sharing\n\nご検討いただけますと幸いでございます。\nどうぞよろしくお願いいたします。", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@Bx7Waf8/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3796900, "client_id": 3806877, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/8002b1d9/uploads/origins/03d8064e-3100-404e-b8a9-1edd58f8f008?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a8be89ef50660864f630e608aefde353", "srcset": "https://si.imgix.net/8002b1d9/uploads/origins/03d8064e-3100-404e-b8a9-1edd58f8f008?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a8be89ef50660864f630e608aefde353, https://si.imgix.net/8002b1d9/uploads/origins/03d8064e-3100-404e-b8a9-1edd58f8f008?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=69af5d811124fe39c57076ef1525082a 2x, https://si.imgix.net/8002b1d9/uploads/origins/03d8064e-3100-404e-b8a9-1edd58f8f008?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=77282434c62a0b19e9e26db227ac12b0 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/8002b1d9/uploads/origins/03d8064e-3100-404e-b8a9-1edd58f8f008?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d2283f66f4a80d427fafd882571be87f", "srcset": "https://si.imgix.net/8002b1d9/uploads/origins/03d8064e-3100-404e-b8a9-1edd58f8f008?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d2283f66f4a80d427fafd882571be87f, https://si.imgix.net/8002b1d9/uploads/origins/03d8064e-3100-404e-b8a9-1edd58f8f008?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=f370651cac8009af0f45f