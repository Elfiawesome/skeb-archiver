eなどのSNS・動画・配信での使用\n　・FANBOXでの返礼品やネットプリントやグッズなどVtuber活動範囲内での使用(商用利用含む)\n　（商用利用が不可の場合、別途レイヤーにご記載頂けますと幸いです。）　\n\n◆希望納品形式\n　人物と背景(ある場合)のレイヤーを分けたPSDで納品頂けれるとうれしいです！\n\nよろしくお願いいたします！！", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Put_away_6/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3429088, "client_id": 3346132, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/6da857b2/uploads/origins/2ee2e810-a261-4dbd-b598-08bdb6fa4392?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0c3fe311875a47b534eb60e337671592", "srcset": "https://si.imgix.net/6da857b2/uploads/origins/2ee2e810-a261-4dbd-b598-08bdb6fa4392?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0c3fe311875a47b534eb60e337671592, https://si.imgix.net/6da857b2/uploads/origins/2ee2e810-a261-4dbd-b598-08bdb6fa4392?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e886f76b5697b93262d551e3bcdee662 2x, https://si.imgix.net/6da857b2/uploads/origins/2ee2e810-a261-4dbd-b598-08bdb6fa4392?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=5b591a5b20c60cda1ebc3a3386e3eecd 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/6da857b2/uploads/origins/2ee2e810-a261-4dbd-b598-08bdb6fa4392?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=1431d736326c101e91bad992ccc78070", "srcset": "https://si.imgix.net/6da857b2/uploads/origins/2ee2e810-a261-4dbd-b598-08bdb6fa4392?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=1431d736326c101e91bad992ccc78070, https://si.imgix.net/6da857b2/uploads/origins/2ee2e810-a261-4dbd-b598-08bdb6fa4392?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=5a15d6f0ecf6f3dd972e1555d3a98578 2x, https://s