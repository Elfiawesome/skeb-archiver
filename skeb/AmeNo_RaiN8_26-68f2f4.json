=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=d02e6cd9984e401ae03b842cd55b5b60 3x"}, "body": "ガンダムビルドダイバーズのモモちゃんのイラストをお願いします！\n\nゲームの世界で自分の作ったガンプラに乗って戦うという作品なのですが、このキャラクターの現実世界で姿とゲームの中のアバターの姿を描いてほしいです\n可愛いものが大好きで若干お転婆気味なキャラクターです\n\nイラストの内容はアバターでの姿と現実での姿の2人が画面に向かって猫のポーズ(招き猫みたいな手を上げる感じです)をしているものをお願いします。\n背景はゲームの画面をイメージした様な感じでお願いします\n\nご検討を頂ければ幸いです\nよろしくお願いいたします。\n\nhttps://www.tv-tokyo.co.jp/anime/gundam-bd/chara/", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@AmeNo_RaiN8_26/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2931089, "client_id": 811237, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/78013622/uploads/origins/c6200aa5-6425-4a90-8d2f-d873efb61a87?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=04a54f3dc9d8f72c589bc019e3d7e0fd", "srcset": "https://si.imgix.net/78013622/uploads/origins/c6200aa5-6425-4a90-8d2f-d873efb61a87?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=04a54f3dc9d8f72c589bc019e3d7e0fd, https://si.imgix.net/78013622/uploads/origins/c6200aa5-6425-4a90-8d2f-d873efb61a87?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=fccae2c0ffa9c31d0c99eaaf9b181300 2x, https://si.imgix.net/78013622/uploads/origins/c6200aa5-6425-4a90-8d2f-d873efb61a87?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f0e885f509a513f99cf9aca43361a57e 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/78013622/uploads/origins/c6200aa5-6425-4a90-8d2f-d873efb61a87?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=aec8303663d6f925b3e6804e352ec0da", "srcset": "https://si.imgix.net/78013622/uploads/origins/c6200aa5-6425-4a90-8d2f-d873efb61a87?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&c