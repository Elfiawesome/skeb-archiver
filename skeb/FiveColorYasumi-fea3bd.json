8b22e7cb530?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2dcdffabf68ec0d744f9f9c61248cca9", "srcset": "https://si.imgix.net/c42f7dc2/uploads/origins/0a288e04-58a0-40b7-8729-88b22e7cb530?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2dcdffabf68ec0d744f9f9c61248cca9, https://si.imgix.net/c42f7dc2/uploads/origins/0a288e04-58a0-40b7-8729-88b22e7cb530?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=4470ada144789e6a5e064d824704e65e 2x, https://si.imgix.net/c42f7dc2/uploads/origins/0a288e04-58a0-40b7-8729-88b22e7cb530?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=3edfb2b53a8025c9c861b7d017548408 3x"}, "body": "こんにちは。私はあなたの作品の大ファンで、このキャラクターたちを気に入っていただけると嬉しいです！以下のアイデアをもとに、この二人を恋人同士として描いていただけないでしょうか。\n1. ヒマワリがニヤリと笑いながら、カポエイラのキックで鑑賞者に向かって突進してくる様子。その上空を、6枚の翼を広げて風を巻き上げながら飛ぶナディア。 ナディアの髪は雷雨のようで、そこから稲妻が降り注いでいる。\n2. ナディアとヒマワリが雨の中を歩いている。ナディアが光の棒を作り、雲でできた自分の髪を刺して一部を引きちぎることで、即席の傘を作っている。\n3. ヒマワリとナディアが歯を磨いている場面。ナディアは疲れきって目を閉じているが、髪の毛の先から大量の霧が立ち上り、ヒマワリの体がその霧に包まれている。\n4. 冬、ナディアがヒマワリにマフラーを差し出す。ヒマワリは戸惑った様子でそれを見つめ、周りを見回して自分にはナディアに贈れるものが何もないことに気づく。そこでヒマワリは、自分の髪をマフラーのようにナディアの首に巻きつける\n5. ヒマワリが本を高速で読み飛ばし、1秒もかからずに読み終えてしまう。そこでナディアが1冊の本を勧める。するとヒマワリはナディアの膝の上に横たわり、のろのろとしたペースで読み始める\n6. ベッドにいるナディアとヒマワリの1コマ。ナディアはヒマワリの胸に頭を乗せて眠り、枕の夢を見ている。 2枚目のコマでは、ナディアがうつ伏せで寝ており、ヒマワリはナディアの髪の上で寝て、枕の夢を見ている。\nhttps://imgur.com/a/zuDvJpk（ナディア。彼女の髪は、参考画像よりも雲のような質感にすること）\nhttps://imgur.com/a/fbogdKQ（ヒマワリ。服装はどちらでも構いません：https://imgur.com/a/aTKvZ2B）\nよろしくお願いします！", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@FiveColorYasumi/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3182895, "client_id": 2060511, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/fc670c0b/uploads/origins/e268a1b6-7c62-4a8f-8e24-0779213b09ce?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f8a3d2d2c838ff2ef42a9db7289d2080", "srcset": "https://si.imgix.net/fc670c0b/uploads/origins/e268a1b6-7c62-4a8f-8e24-0779213b09ce?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f8a3d2d2c838ff2ef42a9db7289d2080, https://si.imgix.net/fc670c0b/uploads/origins/e268a1b6-7c62-4a8f-8e24-0779213b09ce?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=81cd0b85f183d23413176e4034e5b378 2x, https://si.imgix.net/fc670c0b/uploads/origins/e268a1b6-7c62-4a8f-8e24-0779213b09ce?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=56fe3430d54c2b8adcd089e55ee59965 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/fc670c0b/uploads/origins/e268a1b6-7c62-4a8f-8e24-0779213b09ce?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=91e3069efc3b5f09e95b08a937283b3e", "srcset": "https://si.imgix.net/fc670c0b/uploads/origins/e268a1b6-7c62-4a8f-8e24-0779213b09ce?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=91e3069efc3b5f09e95b08a937283b3e, https://si.imgix.net/fc670c0b/uploads/origins/e268a1b6-7c62-4a8f-8e24-0779213b09ce?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=531f8464d11465321f5b12489d8da5fe 2x, https://si.imgix.net/fc670c0b/uploads/origins/e268a1b6-7c62-4a8f-8e24-0779213b09ce?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=06c36de5a29110acc8270211ca386d19 3x"}, "body": "あなたの作品が大好きです。私のNLオリジナルキャラクター（OC）のイラストを描いていただけないでしょうか。ぜひ、あなたのスタイルで私のOCを描いてください。\n私のOCには、お好きな服装を着せていただいて構いません。もしよろしければ、新しい衣装をデザインしていただいても結構です。\n\nキャラクター紹介\nハーマン：身長208cm、薄茶色の髪、赤みがかった茶色の瞳\n大佐で、仕事中毒です。軍内では非常に有力で、数々の勲章を授与され、尊敬されています。任務中に負った傷で顔に傷跡があります。普段は感情をあまり表に出さない、真面目な男性です。アナに深く恋しており、彼女の明るく純粋な魂に惹かれています。\nアナ：身長154cm、黒みがかった茶色の髪、琥珀色の瞳、明るいブロンズ色の肌\n小柄でスレンダーな体つき、甘く優しい性格。とても美しく、料理も得意。かつてマフィアから虐待を受け、人身売買の被害者だったが、ハーマンに救われた。ハーマンの優しい支えのもと、新しい人生を歩み始めた。ハーマンの優しさに惹かれ、彼に深く恋している。\n二人は恋人であり、魂の伴侶だ。互いに癒し合っている。\n\nハーマンの顔の傷は簡略化しないでください。戦術装備を描きたい場合：ヘルメットについては、暗視ゴーグルを描いても描かなくても構いません。ボディアーマーの空きスペースについては、弾倉で埋めてください。描く際は「Herman-other」のアートワークを参考にしてください。 彼にはタトゥーがあります。タトゥーを描く場合は、自由に簡略化して構いません。\nアナは小柄でスレンダー、肌色は明るいブロンズ色です。衣装を描く際は「Ana-衣装」を参考にしてください。\nありがとうございます。\n\nhttps://drive.google.com/drive/folders/1Lc4tSw9sMCEBC7heb4-mwrZ4niX3vTmX", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@FiveColorYasumi/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3182895, "client_id": 177871, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/d3185273/uploads/origins/36de840c-880c-41ba-8c9d-d290951fb187?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9ac50b51431addf90a614693591a8f00", "srcset": "https://si.imgix.net/d3185273/uploads/origins/36de840c-880c-41ba-8c9d-d290951fb187?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9ac50b51431addf90a614693591a8f00, https://si.imgix.net/d3185273/uploads/origins/36de840c-880c-41ba-8c9d-d290951fb187?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=7c81b954b8c9367bef0f365e5fc86423 2x, https://si.imgix.net/d3185273/uploads/origins/36de840c-880c-41ba-8c9d-d290951fb187?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=da657d3fef36517aa48b4540476fda48 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/d3185273/uploads/origins/36de840c-880c-41ba-8c9d-d290951fb187?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=89bd3856f31a6be364706ea3e09b7f87", "srcset": "https://si.imgix.net/d3185273/uploads/origins/36de840c-880c-41ba-8c9d-d290951fb187?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=8