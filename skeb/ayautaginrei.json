などは私の技術的に複雑なのは描けない！という感じでシンプルにしちゃってますし。\nゲームで使用するものとして、背景が透明のものも用意して頂けると助かります。", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@ayautaginrei/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 813479, "client_id": 482437, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/7a395c2c/uploads/origins/fff9819e-785a-4b47-9763-bf7f4a71f190?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=166aa6ff16fd264f301bee033f4c5d9f", "srcset": "https://si.imgix.net/7a395c2c/uploads/origins/fff9819e-785a-4b47-9763-bf7f4a71f190?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=166aa6ff16fd264f301bee033f4c5d9f, https://si.imgix.net/7a395c2c/uploads/origins/fff9819e-785a-4b47-9763-bf7f4a71f190?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=0f748db3db4e9653ee570bca30eed0b7 2x, https://si.imgix.net/7a395c2c/uploads/origins/fff9819e-785a-4b47-9763-bf7f4a71f190?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=5253d3c02d1d45af4d39f1c146436116 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/7a395c2c/uploads/origins/fff9819e-785a-4b47-9763-bf7f4a71f190?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=03995d012074733d42139bd033265189", "srcset": "https://si.imgix.net/7a395c2c/uploads/origins/fff9819e-785a-4b47-9763-bf7f4a71f190?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=03995d012074733d42139bd033265189, https://si.imgix.net/7a395c2c/uploads/origins/fff9819e-785a-4b47-9763-bf7f4a71f190?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=49988f8cfe5c067aed4f1c7b74c9dc1c 2x, https://si.imgix.net/7a395c2c/uploads/origins/fff9819e-785a-4b47-9763-bf7f4a71f190?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=ccf3f533df02380ddfe1a92c0f861a5a 3x"}, "body": "こんにちは。\n以前綾歌さんが描かれたアルノさん\nhttps://skeb.jp/@ayautaginrei/works/3\nと、うちのディーヴェルのツーショットを描いていただけたらとても嬉しいです。\nアルノさんのPLさんからは許可をいただいております。\n\n【ディーヴェルの情報】\n年齢：14歳\n身長：152cm\n性別：女性\n髪色：生成色～鴇鼠色？　暖かみのある淡い灰色。\n虹彩：紅紫と杏色のダイクロイックアイ\n資料：https://nigellard.daynight.jp/data/data-divel/\n歌の天使というコンセプトのアバター。\n魔力から鎖や檻を具現化して戦うヒラタン。\nアルノさんとは兄と妹のような関係から恋仲に。歳の差カップル。\n\n【内容】\n共闘シーン。\n剣を構えるor振って戦ってるアルノさんと、微笑んでサポートしてるディーヴェル、というイメージでお願いします。\n騎士と天使ということで、神聖な雰囲気があると美味しいです。\n構図やディティール等は一切お任せします。\n\n用途は鑑賞です。\nご検討いただけましたら幸いです。", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@ayautaginrei/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 813479, "client_id": 189707, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/8dfc4a71/uploads/origins/ce8d330b-0407-42d0-95ac-03711dacc02c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=90b17b7debd17538c9ee542b6d9e597f", "srcset": "https://si.imgix.net/8dfc4a71/uploads/origins/ce8d330b-0407-42d0-95ac-03711dacc02c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=90b17b7debd17538c9ee542b6d9e597f, https://si.imgix.net/8dfc4a71/uploads/origins/ce8d330b-0407-42d0-95ac-03711dacc02c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e15b989610c2dc852fa48a1b746d90d9 2x, https://si.imgix.net/8dfc4a71/uploads/origins/ce8d330b-0407-42d0-95ac-03711dacc02c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b9e0b99f51c8fc857719acd57524a22d 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/8dfc4a71/uploads/origins/ce8d330b-0407-42d0-95ac-03711dacc02c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e9227f013cbfd695e5fa3b6ad51ae300", 