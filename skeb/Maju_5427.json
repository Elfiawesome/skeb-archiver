者です。普段は真剣で少し怒っているように見えます。大切な人々の安全のために戦いたいと思っていますが、その思いが少し行き過ぎることがあります。  注意点として、傷ついた目は失明しており白く見えます。また軍用ドッグタグも装着しています。酒場で旅の記録を見直し、見逃した情報がないか確認している龍玄のイラストを希望します。ポーズはご自由にお任せしますが、常に少し怒っているような表情で、おそらく記録に没頭しすぎている様子を表現してください。\n\nご依頼をご検討いただき誠にありがとうございます。楽しみにしております！https://imgur.com/a/B0tVlwQ", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Maju_5427/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1978333, "client_id": 3007987, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/8f527f21/uploads/origins/78620c3a-c045-48c9-97b2-4dce2d96efa0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=53b2b98fec309f7b230420f3745edf20", "srcset": "https://si.imgix.net/8f527f21/uploads/origins/78620c3a-c045-48c9-97b2-4dce2d96efa0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=53b2b98fec309f7b230420f3745edf20, https://si.imgix.net/8f527f21/uploads/origins/78620c3a-c045-48c9-97b2-4dce2d96efa0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=0bb4bac1c9c9e3b40786366ade751232 2x, https://si.imgix.net/8f527f21/uploads/origins/78620c3a-c045-48c9-97b2-4dce2d96efa0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ead405dabbf27dec2a52f57bdcf44169 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/8f527f21/uploads/origins/78620c3a-c045-48c9-97b2-4dce2d96efa0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2a286b70247f2f9e202955b75e850ad2", "srcset": "https://si.imgix.net/8f527f21/uploads/origins/78620c3a-c045-48c9-97b2-4dce2d96efa0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2a286b70247f2f9e202955b75e850ad2, https://si.imgix.net/8f527f21/uploads/origins/78620c3a-c045-48c9-97b2-4dce2d96efa0?bg=%23fff&auto=format%2Ccompress