26594%2F2wtAea-b.jpg?blend64=aHR0cHM6Ly9za2ViLWF2YXRhci5pbWdpeC5uZXQvfnRleHQ_Ymc9NjAwMDIyMjgmdHh0NjQ9S09pX3ZlaW9tQ2tnTWpBeU15OHdOaTh3TmlBd01UbzBOQTBLNDRHSzZhS281WkdDNDRHcjVZV2w0NEtLNDRHcTQ0R000NEtKNDRDQjQ0RzE0NEdvRFFvdUxpNCZ0eHRzaXplPTMwJnR4dGFsaWduPWNlbnRlciUyQ21pZGRsZSZ0eHRjbHI9ZmZmJnc9MzYwJmg9MzYwJnM9OWZhMWI3ODJmZWNlN2YyNzRmZDliMDM0NWQ1ODRmZDU&blendalpha=100&blendalign=center&blendmode=normal&blendsize=inherit&bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=280847955f7fed327d31f9e8e02e5eba 3x"}, "body": "こんにちは、いつも応援しています。助言を頂けるということで、何卒よろしくお願いします。\n\n少し贅沢な悩みかもしれませんが、IIDXの上達速度が緩やかで、上手くなる前にサ終か老衰が先に来てしまうのではないかと思っています。(INFINITASを1年間プレーして☆12のAAAが20曲から200曲に増えた程度)\n\n例えば1年前にスコアレートがAA以上AAAマイナス表記未満だった、天空の夜明け、Almagestといった曲が最近になってAAAは出ましたが、じゃあ現在そのスコアレートに位置する曲(X-DEN、駅猫、灼熱pt2など)を1年後にAAA出せるのかと言われたら、とても出せるとは思えません。出せるなら出したいです。\n\n現状のプレー内容としては、とりあえず地力がないと何も始まらないと思い、最近は難しい譜面を多めに選曲しています。(灼熱pt2、マレ、pp、X-DEN、GuNGNiRを選曲しがち)\nプレー頻度と回数は1日3時間前後を週に5~6日程度です。\n(一応毎回☆10~12で少なくとも1曲ずつ自己ベストを更新するようにしていますが、とんでもなく調子の悪いときに雪月花を1点更新しただけ、という日もあったので正直1日1自己べに意味があるのか知りません)\n\n上記の練習内容(本当は練習という言葉を使いたくないですけど)に付け加えてすべきこと、やめた方がいいこと、地力上げにおすすめの曲(INFINITASで選曲可能だと嬉しいです)などがあれば教えてください。\n☆12のAAAが200曲を超えてから、今までよりも地力上げを意識していますが、今のところ地力が上がったという実感はありません。\n\nまた、自分のような軟弱者は3時間のプレー(☆12の割合は1.5~2時間)で腕に疲労が蓄積されてしまい、難しい譜面が露骨に押せなくなってしまいます。このとき、難しい譜面を押せないなりに取り組むべきか、それともそのときにスコアをある程度狙える譜面を選曲すべきか、どちらがいいのか分かりません。\nそれと、時間の取れる日に本当は8時間ほどプレーし続けたいのですが、頑張っても4時間ほどで限界が来てしまいます。長時間☆12をやり込む際の秘訣などがあれば教えてくださると嬉しく思います。\n\nとりあえず以上になります。一言で言ってしまうと「上達してない訳じゃないけど、もっと手っ取り早く上手くなりたい」という訳分からん内容となってしまい、申し訳ありません。\nここまで読んでくださり、ありがとうございました。", "nc": 17, "word_count": 4684, "transcoder": "text", "creator_acceptable_same_genre": true}, {"path": "/@norimisoIIDX/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "correction", "tipped": false, "creator_id": 2495195, "client_id": 2738996, "vtt_url": null, "thumbnail_image_urls": {"src": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1657305536482926594%2F2wtAea-b.jpg?blend64=aHR0cHM6Ly9za2ViLWF2YXRhci5pbWdpeC5uZXQvfnRleHQ_&blendalpha=100&blendalign=center&blendmode=normal&blendsize=inherit&bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=657fd5b4e49d57ea95c38686f5787f0a", "srcset": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1657305536482926594%2F2wtAea-b.jpg?blend64=aHR0cHM6Ly9za2ViLWF2YXRhci5pbWdpeC5uZXQvfnRleHQ_&blendalpha=100&blendalign=center&blendmode=normal&blendsize=inherit&bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=657fd5b4e49d57ea95c38686f5787f0a, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1657305536482926594%2F2wtAea-b.jpg?blend64=aHR0cHM6Ly9za2ViLWF2YXRhci5pbWdpeC5uZXQvfnRleHQ_&blendalpha=100&blendalign=center&blendmode=normal&blendsize=inherit&bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=1045a5b3a7f93e78ba68b45086e0491c 2x, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1657305536482926594%2F2wtAea-b.jpg?blend64=aHR0cHM6Ly9za2ViLWF2YXRhci5pbWdpeC5uZXQvfnRleHQ_&blendalpha=100&blendalign=center&blendmode=normal&blendsize=inherit&bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=7bbbf0ad2598700d7092f90ed6c3a3bf 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1657305536482926594%2F2wtAea-b.jpg?blend64=aHR0cHM6Ly9za2ViLWF2YXRhci5pbWdpeC5uZXQvfnRleHQ_&blendalpha=100&blendalign=center&blendmode=normal&blendsize=inherit&bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=42d813fd7acb01e1b2b8d7f51bd84e33", "srcset": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1657305536482926594%2F2wtAea-b.jpg?blend64=aHR0cHM6Ly9za2ViLWF2YXRhci5pbWdpeC5uZXQvfnRleHQ_&blendalpha=100&blendalign=center&blendmode=normal&blendsize=inherit&bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=42d813fd7acb01e1b2b8d7f51bd84e33, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1657305536482926594%2F2wtAea-b.jpg?blend64=aHR0cHM6Ly9za2ViLWF2YXRhci5pbWdpeC5uZXQvfnRleHQ_&blendalpha=100&blendalign=center&blendmode=normal&blendsize=inherit&bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=d16f00625010fabeba65d7acfa536dbf 2x, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1657305536482926594%2F2wtAea-b.jpg?blend64=aHR0cHM6Ly9za2ViLWF2YXRhci5pbWdpeC5uZXQvfnRleHQ_&blendalpha=100&blendalign=center&blendmode=normal&blendsize=inherit&bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=3fb7791d3fe15e92442e5ab3d54bfca4 3x"}, "body": "初めまして、あーばんという者です。ビートマニアのアドバイスを頂けるということで、よろしくお願いします。\nお題としては「目線と緑数字」についてアドバイスを頂けたら嬉しいです。色々と相談したいことはあるのですが、絞って質問したいと思います。\n「目線と緑数字」に関しては、早急になんとかしたいことで、長年悩み続けていることです。\n\n自分のスキルを書いておくと初心者とかではなく皆伝は取れており、本格的に始めたのは、SIRIUSからで仕事等で離れたりしていましたが今も現役でやっています。\n☆12 (レジェンダリア含む)未ハードは10曲以下です。中途半端な量産型皆伝かなと思っております。アリーナで例を出すと、低難易度いわゆる単発は、満足に光らせることはできず負けますし、かといって☆12は格上相手または同等には勝てないといった弱点が多いプレイヤーだと自負しております。\n\n下記が緑数字やSUD＋やLIFTなどを何故そう変えたのか理由を述べますので、参考にしてください。未だに適正な緑数字や目線について分からないままでいます。一番困っております。なので、NORIさんの緑数字の合わせ方や設定について教えてもらうとよろしくお願いします。\n\n現在のLIFTやSUD+の詳細設定は下記の通りになります。\nLIFT　201\nSUD+　199\n緑数字　288\n判定調整+1.2\n\n⇒緑数字について\n緑数字（NOTES-TIME）についてで、以前は緑数字を小さくしていました。それに合わせてSUD+やLIFT等も下げ気味でやっていました。\n\n一例あげると、\nLIFT　200、\nSUD+　260\n緑数字　256\n判定調整　-1.8\n　でやっていました。何故、この設定でやろうと思ったのかBPL選手や上手い人の記事等を見るといわゆる、うぃろうメソッドを採用していましたので、取り入れてみました。\nメリットもあったのですがデメリットが致命的になりやめてしまいました。\nこの設定にしては大体3年以上はやりました。\n\nやめた理由としては、\n・☆12のBPM160以下の入門曲（Brokenなど）は、AAAを出せるが一向にConfiserieや天空の夜明けなどといった高難度曲に満足にスコアが出せないかといって、☆11や☆10といった中難度もできていたかというと微妙で、頭打ちを感じやめました。\n\n・LM筐体によっていつもやっているハイスピにもかかわらず速く感じるため\n\n・単発や低難度寄りに合わせているにもかかわらず、アリーナとかでは投げられ負けてしまうため\n\nすべてが中途半端で自分には合わなかったのかなと割り切り、認識しやすくするために緑数字を大きくして現在のプレイスタイルになりました。多少、高難度系は気持ち見えやすくなった程度で、低難度は思った以上に光らせることはできず、早く感じることがしばしばあり中途半端な状況が続いているのが現状です。\n\n視線についてで、本来画像を用いてアドバイスをもらいたかったのですが、skebの利用規約に抵触（ＤＬリンクなど）するらしいので、文章で説明させてもらいます。\n\n下記がプレイオプションです。\nボム　Lincle\n判定文字　スマート\nキービーム　ベリーショート\n爆発サイズ設定　70%\n\n改めて、視線に関して文章で書きますと、\n単発や低難度をやる際は、判定ラインとコンボ表記の間を必死に凝視するようにしています。\n☆10や☆11の時は、BPMにもよるのですが判定文字の下から判定文字のすぐ上を凝視しています。\n☆12は、判定文字の上を見るようにしてBPMや難易度によって見ているところを変えています。傾向的に、高BPMや密度が濃ければ濃いほど判定文字のSUD+寄りになっていきます。\n\n何故、このようになったかというと緑数字の時に書きましたが、うぃろうメソッドを用いて、SUD＋もガン下げ気味で頑張って判定文字とSUD+の間を凝視しました。\nしかし、緑数字の時にも書きましたが、Chrono Diver -PENDULUMs-、Elemental Creationsといった高BPMで物量になるとSLOW乱発してしまい負けてしまいます。必死に食らいつけるように頑張りましたが、やり方が悪かったのかダメでした。\nSLOW乱発したときに、高難度のほうに判定調節すればいいかなと思ったのですが、そうすると今度は低難度でFASTが乱発するといった状況に陥ったので、改善が見られず思い切って緑数字を大きくしました。\nやっていくうちに自分の癖として判定文字と判定ラインの間を見ると比較的にピカグレが出るので設定を今のようになりました。\n\n結果は、高難度系は比較的できるようになりましたが低難度や単発が光らなくなりました。また、SUD＋を上げてしまったことによって視線のブレが酷くなり、デメリットを改善しようとした結果、デメリットが更に増えてしまい、自分の最適な視線や緑数字が全然分からなくなった次第です。自動判定調節機能を常にONにしてやればこの悩みも解消されるとは思うのですが、昔話になり長くなるので、省略しますがこの自動判定調節機能で嫌というほど痛い目にあいました。正直、この機能に依存しすぎたせいでbeatmaniaが嫌になるほどでした。\n以上が、今に至る緑数字や視線の経緯です。\n\n現状で自分が考えていることで、質問になります。なので、アドバイス及びNORIさんの意見も頂けると嬉しいです。\n\n・現状のように難易度によって視線を変えるべきか？それとも鋼の意思で再びSUD＋や判定文字の間を凝視するようにすべきか、また、自分の癖、判定ラインとコンボ表記の間をみる癖は直すべきか。\n⇒　コンボ表記とSUD+の間を見続けるように練習していましたが、無理そうで自分の癖(判定ラインとコンボ表記の間を見ること)を信じたら思いのほかうまくいって今のようなプレイになりました。今では複数の視線を用いているためブレがデメリットになってしまいました。\nなので、自分の癖を信じて今のスタイルを継続すべきか、それともすべて投げ捨てて、それとも判定文字とSUD＋の間を凝視するスタイルにすべきかアドバイスを頂けると嬉しいです。\n勿論、どちらかにしたら多少のデメリットも出てくるとは思いますが、よければそのスタイルにした際の考えられるデメリット及び克服方法を教えて頂けると嬉しいです。\n\n・最適な緑数字の合わせ方について、\n⇒今一度緑数字を考える上記の内容と被るとは思うのですが、一度うぃろうメソッドに挫折はしたもののやはり取り入れた方がいいか。何故、そう思ったかというと今は、判定調整は+1.2でやっています。抽象的になってしまいますが、緑数字が小さかったころうぃろうメソッドを取り入れたときは、若干ながら判定が甘くなっているなと感じる部分がありました。今は判定調整を+に寄せていますが、判定が厳しくなっているなと感じたためです。とはいえ、一度は挫折したうぃろうメソッドを着手すべきか悩んでおります。緑数字になると正直、その人の感覚によるとは思うので緑数字を合わせるのに適している曲など教えて頂けると嬉しいです。\n\n簡単にですが、自分なりのSUD+、LIFT、緑数字の合わせ方を書いておきます。\nSUD+やLIFTの合わせ方に関しては、姿勢など考慮して見やすいように設定しています。\nここでプレイ環境を述べますとINFINITASは、43型モニター(FV43U )でやり、完全再現とはいかないのですが立ち環境でやっていますので、INFINITASの環境が良ければ設定を参考にしてLM筐体に反映させたりしています。\n\n緑数字や判定調整に関しては、ハイスピードは低難度で合わせています。（例としては、NORMAL譜面でBPM150前後）、感覚的な話にはなりますが自分が適度に感じるハイスピードに合わせて、LM筐体やINFINITASの自動判定調節機能を用いてある程度ぶれが生じないところで自動判定調節機能を外してやっています、\n\n以上が、自分がやっているLIFTやSUD＋、緑数字の合わせ方です。\n\n・低難度やNORMAL譜面いわゆる単発の上達方法について\n⇒アリーナで投げられるため逃げることが出来なくなった分野で、目標としては初見な曲(ソフランや尖っている曲は除く)でもMAX-がでるように頑張ってきました。練習方法としては、身近に低難度のスコアラーがいたので、教えてもらったら取り敢えず、AAAを出すように頑張るといわれ、それを信じてかれこれ3作品以上続けましたが、これも一向に伸ばすことが出来ず悩んでおります。\n\n以上になります。どれぐらいの文量が適しているか分からず、長文になってしまいました。多少分かりにくいところがあるかもしれません。申し訳ございません。\n何卒よろしくお願いします。", "nc": 145, "word_count": 5807, "transcoder": "text", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 352960, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "ginkiha", "screen_name": "ginkiha", "avatar_url": "https://proxy.misskeyusercontent.jp/avatar.webp?url=https%3A%2F%2Fmedia.misskeyusercontent.jp%2Fmisskey%2Fe81335c2-3c2d-4805-aa15-e79340721283.jpg&avatar=1", "header_url": "https://media.misskeyusercontent.jp/misskey/1687e527-fb7f-4868-b449-75bb66190f91.png", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "music"}, {"genre": "art"}, {"genre": "correction"}], "banned": false, "nc": 128}, {"id": 1254164, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "兵六@skeb", "screen_name": "rokurokugo11", "avatar_url": "https://pbs.twimg.com/profile_images/1793119540509122560/jEVv8Zzs.jpg", "header_url": "https://pbs.twimg.com/profile_banners/501649469/1654688923/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 50,