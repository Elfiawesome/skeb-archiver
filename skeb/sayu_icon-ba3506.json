/8395b75e/uploads/origins/45d2cbb7-aae6-4840-a863-29c9d4fe50c8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=1b7d5abce987e107ff8336026ebf1963 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/8395b75e/uploads/origins/45d2cbb7-aae6-4840-a863-29c9d4fe50c8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=90bb2b27cc8e613bedfa6723cec84ff5", "srcset": "https://si.imgix.net/8395b75e/uploads/origins/45d2cbb7-aae6-4840-a863-29c9d4fe50c8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=90bb2b27cc8e613bedfa6723cec84ff5, https://si.imgix.net/8395b75e/uploads/origins/45d2cbb7-aae6-4840-a863-29c9d4fe50c8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=0a98c293365d2224a31e294a60d5325e 2x, https://si.imgix.net/8395b75e/uploads/origins/45d2cbb7-aae6-4840-a863-29c9d4fe50c8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=8fbb2faf38c1e05329c27ea931dfb55f 3x"}, "body": "こんにちは。\n先生のイラストが大好きでいつもイラストを楽しみにしています。\nよろしければ私のオリジナルキャラクターのSDイラストを描いていただきたいです！\n構図等は全てお任せでお願いしたいです。\n使用用途はSNS等のアイコン、個人用グッズ等(商用利用なし)\nPSDデータまたは背景透過PNGでお願いしたいです。\n\n参考資料が1枚しかなくて申し訳ございません。(またとても雑で申し訳ないです)\n\nよろしくお願いいたします……！\n\nhttps://drive.google.com/file/d/1Gl3UDPDvFrDCWY3je7FvN99OS7lHtcUQ/view?usp=drivesdk", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@sayu_icon/works/8", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2707350, "client_id": 3445407, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/abfbf2a3/uploads/origins/ed6cd589-78bf-465e-b9b7-0870d3d557fc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=041432da319a754609791647cd649308", "srcset": "https://si.imgix.net/abfbf2a3/uploads/origins/ed6cd589-78bf-465e-b9b7-0870d3d557fc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=041432da319a754609791647cd649308, https://si.imgix.net/abfbf2a3/uploads/origins/ed6cd589-78bf-465e-b9b7-0870d3d557fc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=4f789a914d771815abc9680c8a1b4a6c 2x, https://si.imgix.net/abfbf2a3/uploads/origins/ed6cd589-78bf-465e-b9b7-0870d3d557fc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=aaf6ca39958c5f10deefbfc25dd6ef6d 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/abfbf2a3/uploads/origins/ed6cd589-78bf-465e-b9b7-0870d3d557fc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e33617394e3016a2b86a14f610290713", "srcset": "https://si.imgix.net/abfbf2a3/uploads/origins/ed6cd589-78bf-465e-b9b7-0870d3d557fc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e33617394e3016a2b86a14f610290713, https://si.imgix.net/abfbf2a3/uploads/origins/ed6cd589-78bf-465e-b9b7-0870d3d557fc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=f97daa36596cc014d712ba8129e81c4e 2x, https://si.imgix.net/abfbf2a3/uploads/origins/ed6cd589-78bf-465e-b9b7-0870d3d557fc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=5f8d9ba948596941850c94941d0c8cf8 3x"}, "body": "初めまして。めうめの。と申します。Twitterにて音楽活動を行なっております。アイコン等のイラストをお願いしたく、ご連絡させて頂きました。\n\n使用用途:\nアイコンの使用、SNSへの掲載\n\n背景をつけて頂ける場合、人物のみの透過イラストのデータも頂きたいです。\nまた表情の差分もいただければ嬉しいです。\n\n\n希望のイメージ:\n\n・猫耳付きの黒色のフードを被った女の子。黒色の猫フードを被っていれば肩より下の服装はお任せいたします。\n\n・髪は可能であれば黒色。前髪ぱっつんの肩くらいのボブ。耳にピアスがいっぱい空いているため、片方の耳に髪をかけてピアスが見えるようにしていただけると嬉しいです。\n\n・現twitterのアイコンのヘッドホンの猫ちゃんを抱くようなポーズ\n\n以上の内容でお願い致します。\n\n\n要望が多く申し訳ございません。その他の装飾品、背景などはお任せいたします。猫ちゃんも現アイコンよりもデフォルメ化して可愛くしていただいて大丈夫です。\n音楽活動を行っているため、そのイメージで自由に描いていただければ幸いです。\n\n\nお忙しい中ご検討のほどよろしくお願いします。\n\n以下手書きイメージで分かりにくく申し訳ございませんが、参考資料