=crop&crop=top&w=200&h=200&s=e3d6e42d4e0d1d96164293eb727dd4dd 2x, https://si.imgix.net/1a3e518c/uploads/origins/83a0b588-d806-4dff-904e-6faa4fb3eb2d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=af38a530a02dcefb59f9524e1a42f29c 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/1a3e518c/uploads/origins/83a0b588-d806-4dff-904e-6faa4fb3eb2d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=4c3fb93e2afd56bc8e649843aa341a36", "srcset": "https://si.imgix.net/1a3e518c/uploads/origins/83a0b588-d806-4dff-904e-6faa4fb3eb2d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=4c3fb93e2afd56bc8e649843aa341a36, https://si.imgix.net/1a3e518c/uploads/origins/83a0b588-d806-4dff-904e-6faa4fb3eb2d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=78920865a31b7bb3120c6411ecace5b1 2x, https://si.imgix.net/1a3e518c/uploads/origins/83a0b588-d806-4dff-904e-6faa4fb3eb2d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=bc8fbf2c9021049542cf3fba61242fb0 3x"}, "body": "初めまして、友人にオススメされて刺激系マイヒーローを購入させていただきました！\nどハマりしてしまい、購入してからは毎日のように読み返しています！\nもっとこの2人のお話が読みたいと妄想する中、こちらで依頼をすることができると知りいてもたってもいられず今回ご連絡をさせていただきました！\n\nとても見たいシチュエーションがありまして、小さなお子様達に「ヤクモだ！ブルーナイトだっ！」と囲まれている宏斗くんを少し離れたところから誇らしげに見つめている今城さんのイラストが見たいです！\n\n友人に話したら、後方彼氏面だねって言われたので、無意識に後方彼氏面してる今城さんが欲しいですwww\n\n今後また漫画のご依頼もしたいのですが、同じように刺激系マイヒーローの漫画のご依頼は可能でしょうか？\n\n初めてのことで無作法や解釈違いがありましたら、申し訳ありません。\nもしも難しいようであれば、断っていただいても構いません！\n応援しております！", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@Blaze_ped/works/6", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/d41b0562/uploads/origins/c1dcf936-782e-497c-b020-c5685a05fd52?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=mi