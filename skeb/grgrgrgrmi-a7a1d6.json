アップ\n\n\n色々と書き込みましたが、ワッサン様の絵柄や 表現が本当に大好きな為、可能であればスタンスを崩さず 描きやすいように描いていただくことが何より嬉しいです…。長々と失礼しました、よろしくお願いします！\n\nhttps://drive.google.com/drive/folders/17i25njnRWGWDLn544CpQiukSpWWqs6OU", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "similar_creators": [{"id": 709431, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "あさごはん🍳", "screen_name": "asagohan_28", "avatar_url": "https://pbs.twimg.com/profile_images/1584598663623770113/LuVKKdf4.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1286940147515187200/1757957063/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "art"}], "banned": false, "nc": 16}, {"id": 766695, "creator": true, "nsfw_acceptable": false, "acceptable": false, "name": "IZ（あいぜっと）@『Witch's Heart』の中の人。", "screen_name": "blueiziz", "avatar_url": "https://pbs.twimg.com/profile_images/1704769743725666304/1Cf7deKu.png", "header_url": "https://pbs.twimg.com/profile_banners/962013116765675521/1734268894/1500x500", "appeal_receivable": true, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "art"}], "banned": false, "nc": 161}, {"id": 2471317, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "和", "screen_name": "kazz8_", "avatar_url": "https://pbs.twimg.com/profile_images/1604866384944451584/GA2iOLNQ.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1577166385825783811/1716622829/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 15, "c