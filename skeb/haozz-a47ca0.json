.net/2c3e39f3/uploads/origins/1b322fb0-60b3-4cf8-b3cf-74f6b09b9ecd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=5ce7ab4cf668370a6b8878228dd86505 2x, https://si.imgix.net/2c3e39f3/uploads/origins/1b322fb0-60b3-4cf8-b3cf-74f6b09b9ecd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ba5218d21e25e6dab9fffd275f65d23d 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/2c3e39f3/uploads/origins/1b322fb0-60b3-4cf8-b3cf-74f6b09b9ecd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d841694dee4d4d1d4d633e4d5110541c", "srcset": "https://si.imgix.net/2c3e39f3/uploads/origins/1b322fb0-60b3-4cf8-b3cf-74f6b09b9ecd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d841694dee4d4d1d4d633e4d5110541c, https://si.imgix.net/2c3e39f3/uploads/origins/1b322fb0-60b3-4cf8-b3cf-74f6b09b9ecd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=3c8b69c22304c0d9888d3e9d82eb154e 2x, https://si.imgix.net/2c3e39f3/uploads/origins/1b322fb0-60b3-4cf8-b3cf-74f6b09b9ecd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=16625e9d814bb95ac36de9eb77c89c4f 3x"}, "body": "いつもはおさんの素敵な筋肉男子の絵を拝見させてもらっていて、先日の啓太君の体育倉庫のオナニーイラストとかは特に最高でした…！\n\n今回依頼させていただきたいのは、ヒーローが敵組織に捕まって拘束されている絵をお願いしたいです。\n拘束は台に磔にされているか、立った状態で鎖などでX字に拘束されている感じでお願いします。\nもし可能であれば、敵に乳首や股間を触って弄られている描写を入れてもらえればありがたいです。（表現的に何もない空間から手だけ出して弄ってるとかでも大丈夫です）\n\nヒーローの容姿は、スーパー戦隊のように全身ピッチリしたスーツでヘルメットは無く、顔を出している状態。\n基本色はレッドで、配色についてはお任せします。デザインについて困るようでしたら、ガオレンジャーやデカレンジャーみたいなデザインが好きなのでそのような感じを参考にしていただければ幸いです。（画像検索していただければすぐに出てくると思います）\n顔は熱血漢のような感じで髪は啓太くんやレオ君くらいの短髪でツンツンしている感じで全体的に逆毛で額が出ている感じでお願いしたいです。\n\n構図などの問題もありますので、はおさんの描きやすいように設定の変更していただいて大丈夫です。\n個人的性癖を詰め込んで恐縮ですが、受けていただければ幸いです。\nよろしくお願いします！", "nc": 161, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@haozz/works/9", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 395757, "client_id": 43394, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/dc0c318e/uploads/origins/a2a6ecdb-c91f-43bc-aab4-85bdb0226e6e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c2ec8fd8b033fe59860137aa60c58591", "srcset": "https://si.imgix.net/dc0c318e/uploads/origins/a2a6ecdb-c91f-43bc-aab4-85bdb0226e6e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c2ec8fd8b033fe59860137aa60c58591, https://si.imgix.net/dc0c318e/uploads/origins/a2a6ecdb-c91f-43bc-aab4-85bdb0226e6e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ddabfb3dbecad34a7fe7fe5321f4abdc 2x, https://si.imgix.net/dc0c318e/uploads/origins/a2a6ecdb-c91f-43bc-aab4-85bdb0226e6e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d78f37a9ed8b33c6555184de1d61eb12 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/dc0c318e/uploads/origins/a2a6ecdb-c91f-43bc-aab4-85bdb0226e6e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=32446ac8b7caa9c70526cf83ba1ae7f1", "srcset": "https://si.imgix.net/dc0c318e/uploads/origins/a2a6ecdb-c91f-43bc-aab4-85bdb0226e6e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=32446ac8b7caa9c70526cf83ba1ae7f1, https://si.imgix.net/dc0c318e/uploads/origins/a2a6ecdb-c91f-43bc-aab4-85bdb0226e6e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=2c51ae615c29bf1389ef87ba73c8dcfd 2x, https://si.imgix.net/dc0c318e/uploads/origins/a2a6ecdb-c91f-43bc-aab4-85bdb0226e6e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=04a856c97dfc06d2fd0bb512b915a873 3x"}, "body": "先日はDK時代の啓太くん、素晴らしい作品をありがとうございました。\n同じDK時代の啓太くんで別シチュエーションをお願いできますか？\n\n・DK時代の啓太、部活中(サッカーでしたよね？)の一コマ。\n・夏の練習の後汗だく泥だらけで、水飲み場で水浴び中orした後。\n・ウェアやスパイクは脱いで、インナースパッツのみの半裸。\n・勝手ながらスパッツは参照URLのミズ⚪︎のデザインでお願いします。(丈は画像のより少し長めにしていただいて…)\n\nポージング、表情などお任せします。\n水も滴る何とやら！\n\nよろしくお願いいたします。\n\nhttps://www.mizunoshop.net/f/dsg-469758\n\nhttps://michioshop.co.jp/pic-labo/33732jb4010-2.jpg", "nc": 48, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@haozz/works/8", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 395757, "client_id": 718703, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/33c255cf/uploads/origins/4bf25d23-c28e-44ac-9660-ba1a3d747137?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c08f1b8f5760b560a7b8c7100253c572", "srcset": "https://si.imgix.net/33c255cf/uploads/origins/4bf25d23-c28e-44ac-9660-ba1a3d747137?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c08f1b8f5760b560a7b8c7100253c572, https://si.imgix.net/33c255cf/uploads/origins/4bf25d23-c28e-44ac-9660-ba1a3d747137?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=3ecf9a72ea4ee1e12a848eabbf1c4841 2x, https://si.imgix.net/33c255cf/uploads/origins/4bf25d23-c28e-44ac-9660-ba1a3d747137?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=05aabc2851ba3ad764c533683ac769fb 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/33c255cf/uploads/origins/4bf25d23-c28e-44ac-9660-ba1a3d747137?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=708bcc9e7c63a0b21c8da5f5e2534412", "srcset": "https://si.imgix.net/33c255cf/uploads/origins/4bf25d23-c28e-44ac-9660-ba1a3d747137?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=708bcc9e7c63a0b21c8da5f5e2534412, https://si.imgix.net/33c255cf/uploads/origins/4bf25d23-c28e-44ac-9660-ba1a3d747137?bg=%23fff&auto=format%2Ccompress&fm=