fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=91cdf6df47672f68dd7073cbd6b3f4e5", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/f5742496/uploads/origins/4bffa499-7180-4676-8dc7-ef0a65a85efe?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3be4171c345517d3f88e1b8f62c15b5d", "src_set": ""}, "body": "こんにちは、まちさん！お元気ですか？またあなたに依頼できるのが楽しみです！\n\nOCのJ'khalaをお願いできますか？彼女は高名な学者になることを夢見る、ヒーリング・マジックを学ぶ若い学生です。陽気で明るく、前向きな性格。他の人にはナイーブに見えるかもしれませんが、J'khalaはベテランの戦略家の頭脳を持つ、とても知的な女の子です！\n\n1.全身、ポーズは自由に選んでください。妖精のセレネも一緒にお願いします。彼女とは切っても切れない関係なのだ！\n\n2.担任のランヴァル先生、クラスメイトのラザロ先生と記念撮影。ピースピース✌️😄✌️\n\n3.友達のエドマーとフルーツサンドを食べている！二人ともとても美味しそうに食べている。フルーツサンドはJ'khalaの大好物！\n\nすべての参考資料は添付のフォルダにあります。2.と3.はポーズをざっと描いてみたが、いつものようにラフなアイデアなので、まちさんが自由に変更したり編集したりできる。私はまちさんを全面的に信頼しています！いつもありがとうございます！❤️\n\nhttps://drive.google.com/drive/u/0/folders/1te94y--elwctPAPrYEO-uK4NfiCnjrPm", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@suamachi/works/183", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 121519, "client_id": 457576, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/e01eab74/uploads/origins/e966a981-fb48-4ad7-91d5-e40ecd46898b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6dca649ad00f550bfb4d48386102ad1c", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/e01eab74/uploads/origins/e966a981-fb48-4ad7-91d5-e40ecd46898b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ab5332e964b65388dbe7ac89d3a3f0ae", "src_set": ""}, "body": "まち先生お疲れ様です！ いつも可愛いイラストを拝見させていただいております。\n リクエストは、パンダを着たオリキャラをお願いしたいです。（着ぐるみとかパーカーみたいな感じ）　ナルメアお姉ちゃんがとても好きなのでお姉ちゃん感のある感じが嬉しいです！\nまち先生が考えたオリキャラでお願いします。\n 使用用途はXやディスコード等のアイコンで使用させていただきます。\n よかったらよろしくおねがいします！", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@suamachi/works/182", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 121519, "client_id": 1975676, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/5a8185a7/uploads/origins/cdf01467-f844-441c-b7d8-1e446232c903?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=60c9387946bd01782af280a9b9abd58b", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/5a8185a7/uploads/origins/cdf01467-f844-441c-b7d8-1e446232c903?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=dfd22de374c7f970722914df16f8ef93", "src_set": ""}, "body": "こんにちは、まちさん！まちさんのイラストはとてもとてもかわいいです！\n私の友人と私のキャラクターを使ったイラストをお願いしたいです：ヨミとイヴです。\nこの二人は恋人同士であり、冒険家でもあり、一緒に世界を旅しています。\n\nヨミ（海竜娘、160cm）：エレガントなイメージの海から来た陽気な女の子。イヴとイチャイチャするときは、ふわふわしたかわいらしい一面を見せる。\nイヴ（バニーボーイ、180cm）：雪山出身の控えめなバニーボーイ。\"メガネのイクメン \"のイメージ(笑)。どちらかというとシャイなので、イチャイチャに関してはヨミほど積極的ではない。\n\nポーズとしては、以下のようなものが欲しい：\n1）ヨミがイヴに抱きつき、イヴが面倒くさそうに顔をしかめる。頬を赤らめたイヴが本音を見せる。\n2）休憩中のイヴがタバコを吸う。\n3) イヴが作ってくれた小さな狼の人形を抱きしめているヨミ。 (類似: https://drive.google.com/file/d/1Cl1hjXZCubj4TgX5CB8SZoG7xnFid5yw/view)\n\nご清聴ありがとうございました！\n\nhttps://drive.google.com/drive/folders/1OFSXk9z310vai_QFU5QCCnX4qeAGcZHY?usp=drive_link", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@suamachi/works/181", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 121519, "client_id": 1127908, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/a0c466e8/uploads/origins/ae1c799e-833d-4dcf-872f-b5b53893920e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2200670842ad9b9e9ab30d27e9e0c010", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/a0c466e8/uploads/origins/ae1c799e-833d-4dcf-872f-b5b53893920e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b2cb3cb0a18fe2a85d5908a105c332d5", "src_set": ""}, "body": "グラブルのジータちゃん＋グランくんな格好の、団長のわっち自身（赤髪ツインテールのアバター）を描いて欲しいです！　今後も自分はグラブルを長く続けると思いますので、大好きなまちさんのイラストで団長になりたいのと、個人アカウントのSNSのアイコンに用いさせていただければ、と…。そうした利用がNGであればこのリクエストを蹴ってください。顔を洗って個人観賞用の依頼で出直します！\n\n以下、リクエストを受け取って頂いた場合の外観情報・依頼内容になります。\n\nhttps://drive.google.com/file/d/1Gxh16V7Y1ZuHe0dLGyakDf12B1QpiCJS/view?usp=sharing\n\n上記URLの共有画像が素体になる自分のアバターの参考外観です。\n身長は160センチほど・髪はサイドヘアを結っている感じで、後髪もツインテールも概ね肩口で揃っています。髪色はこちらの参考画像くらいの赤さ～グラブルのケルベロス（最終解放後）がよく似ていると思います。目の色は青色です。\n\n衣装ですが、ベースはジータちゃんの「ファイター」衣装に、スカートの下には黒いすべすべした素材のスパッツを履かせてください！　その上から、グランくんの「ファイター」が着用してる青のパーカーを羽織らせるようお願いします。\nパーカーはグラン君と違って前を開ききって羽織っており、そこからジータちゃんの衣装が覗けるイメージです。（グラン君のパーカーに前を開けるファスナー等付いていなければ、お手数ですがファスナーで開くようにしてください…）\nパーカーの前を開けている都合、グラン君のように鎧は着用は出来ませんが、右手の小手はグラン君同様、パーカーの上からお願い致します。\n\nポーズ等はお任せ致します…が、他のアバターを描いて頂いている皆さん同様、全身姿＋腰から上くらいが描かれた2枚ほどのイラストが付けて頂ければ幸いです。まちさんの描かれるにこやかな笑顔がもう大好きで…！　あのにこやかで幸せな笑顔で毎日を過ごせるよう　1枚は目を閉じてにこにこに笑うイラストだと嬉しいです！", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@suamachi/works/180", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 121519, "client_id": 2174537, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/53e60c95/uploads/origins/ec43bd57-1f78-43e8-838f-8cd2330b9f80?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7e3df8911f4b8ed6f1e3c21d2c6e9cbe", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/53e60c95/uploads/origins/ec43bd57-1f78-43e8-838f-8cd2330b9f80?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=8623d33b209ee14c2524202b6cc0b20a", "src_set": ""}, "body": "こんにちは、マチさん！マチさんの絵が大好きで、ffxivのocのミネルバをまたお願いしたいです！\n上品で心優しいお姉さんタイプのキャラクターです。いつも穏やかで温かみのある表情で、飄々とした一面も可愛いです。\n肌の色は薄いグレー！\n瞳はシルバーで、虹彩の周りに真っ白なリングがある。\n白いショートヘア。\n鱗と角は黒く、人魚の尾のように黒から銀のグラデーションがある！\nアイシャドウと口紅はモーブ色で、右目の下のビューティーマークと銀色の角のリングもお忘れなく！牙もあります！\n\n1:キュートでエレガントな立ちポーズ～ 白魔道士の杖を背中に背負ったり、持っているポーズもありますが、必須ではありません！\n2: ペットの鳥と一緒に座っているポーズ。\n3.ワインや日本酒を飲みながら、口を開けて牙を見せて微笑み、顔に手を当てている！\n\nありがとうございました！\n\nhttps://drive.google.com/drive/folders/116BfSkrQJEMLDdcqJFxtXFKC6Fcx9JNm?usp=drive_link", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@suamachi/works/179", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 121519, "client_id": 3259119, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/b8456225/uploads/origins/346346bd-3ce4-4ba9-9f18-4514b379922f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5923d574739ece3a5948df109d992557", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/b8456225/uploads/origins/346346bd-3ce4-4ba9-9f18-4514b379922f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6d22fd2fa3c9297c6638d021e50dbf84", "src_set": ""}, "body": "こんにちは！はじめまして！まち先生\nあなたの絵はとてもかわいいです！グラブルのベリアルを描いていただきたいのですが\n服装も動作も表情もお好きなように手当たり次第に描いてください\nありがとうございます！", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@suamachi/works/178", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 121519, "client_id": 602993, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/968afe60/uploads/origins/424ba67d-448e-41d0-90d8-1207d328421e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fa9ac1feece19a0b03f24a9b3ceca0f8", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thu