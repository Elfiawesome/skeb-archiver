あ…😌💦\n\n長くなってごめんなさい\nジンくん大好きです", "nc": 1, "word_count": 0, "transcoder": "audio", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 101432, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "⛩御先 蔵馬🦊🐾skeb・依頼募集中🎨", "screen_name": "kuramaosk", "avatar_url": "https://pbs.twimg.com/profile_images/1945308158336917504/0fuy8Cil.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1148568716931551232/1573250318/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 15, "complete_expiration_days": 60, "skills": [{"genre": "art"}, {"genre": "comic"}, {"genre": "voice"}, {"genre": "novel"}, {"genre": "music"}, {"genre": "correction"}], "nc": 129}, {"id": 205619, "creator": true, "nsfw_acceptable": false, "acceptable": false, "name": "レイニール・ベイカー♦︎3/28ライブ参加🔥", "screen_name": "Reinier_Baker", "avatar_url": "https://pbs.twimg.com/profile_images/1948081055061495808/jXOyfxIF.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1150325212052725760/1564131377/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "voice"}], "nc": 16}, {"id": 504075, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "ライザ・フォン・ガルファンゼール16世😈👑", "screen_name": "Liza_16sugoi", "avatar_url": "https://pbs.twimg.com/profile_images/1774703600494931968/kIlml17o.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1051153269492305922/1745796370/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 6