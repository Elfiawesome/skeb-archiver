als_count": 403, "received_works": [{"path": "/@nekokitiyorio/works/277", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 32550, "client_id": 50473, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/3b3f0d74/uploads/origins/168e088f-1864-45b3-ad9a-dbc65cafd759?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a6926491406d96ec9a906c2357637e09", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/3b3f0d74/uploads/origins/168e088f-1864-45b3-ad9a-dbc65cafd759?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=12d7f4065bb9df1c859d8409ce79c9c6", "src_set": ""}, "body": "アピールありがとうございます。\nそれではお言葉に甘えて依頼させて頂きます。\n\nお願いしたいものは疾風ウルトラ忍法帖という作品に登場する「邪鬼姫」のイラストになります。\n古い作品ですので資料を用意しましたのでご確認ください。\n\n邪鬼姫は作中で「Ｔバック幻術」というお尻を使った幻術で巨大な桃で押し潰す幻をマンに見せておりますが、\nこれを巨大な邪鬼姫のお尻で押し潰す幻を見せるようにしたイラストを作成して頂けないでしょうか。\n\n詳細な構図はおまかせしますが、幻術による桃やお尻が浮かんでいる空間で邪鬼姫がお尻を向けて座っているようなイメージでお願いします。\n\n内容に問題などがございましたらキャンセルして頂いて構いませんので、ご検討のほどをよろしくお願いします。\n\nhttps://drive.google.com/file/d/1V82d9_CoL4Ro-vLEeJmVJjs9gV85Uh5l/", "nc": 33, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@nekokitiyorio/works/276", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 32550, "client_id": 328819, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/685858f0/uploads/origins/ac61875d-775d-49f3-8701-74f801fc8cb3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5aa66a2211008e9a8cb8fb7d5dfe1328", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/685858f0/uploads/origins/ac61875d-775d-49f3-8701-74f801fc8cb3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=40630aaaa9a3f51a1dd8614749171613", "