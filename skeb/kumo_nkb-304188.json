pologize if it's too detailed.", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@kumo_nkb/works/9", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1930957, "client_id": 1104107, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/cf3fc9af/uploads/origins/fd678a4c-95f2-45af-aefc-e9ab24585fe6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f98c46147d39a9730c0d9745350f7249", "srcset": "https://si.imgix.net/cf3fc9af/uploads/origins/fd678a4c-95f2-45af-aefc-e9ab24585fe6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f98c46147d39a9730c0d9745350f7249, https://si.imgix.net/cf3fc9af/uploads/origins/fd678a4c-95f2-45af-aefc-e9ab24585fe6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=8fe84ab9a9e8b69f1d62fb70a2ef8e4b 2x, https://si.imgix.net/cf3fc9af/uploads/origins/fd678a4c-95f2-45af-aefc-e9ab24585fe6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a75a55416d0396add8879bf722ea4534 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/cf3fc9af/uploads/origins/fd678a4c-95f2-45af-aefc-e9ab24585fe6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b01e80855b146964b27b6ee2f24e5a00", "srcset": "https://si.imgix.net/cf3fc9af/uploads/origins/fd678a4c-95f2-45af-aefc-e9ab24585fe6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b01e80855b146964b27b6ee2f24e5a00, https://si.imgix.net/cf3fc9af/uploads/origins/fd678a4c-95f2-45af-aefc-e9ab24585fe6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=8e4f79695f56da6e0de637c21f0693c1 2x, https://si.imgix.net/cf3fc9af/uploads/origins/fd678a4c-95f2-45af-aefc-e9ab24585fe6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=7cac562f8d6da9a007bd80dedca3c1a7 3x"}, "body": "こんにちは。先生のイラストの色使いや目の描き方がとても好きです。できれば、私のFFXIVのキャラクターの絵をお願いしたいです。  \n\nhttps://drive.google.com/drive/folders/1RQ98RPa8neWIYeU8FY91ggl_xiUpRND7\n\nお姉さんタイプの性格。他人の世話を焼くのが得意。普段は温厚な性格だが、時々とても冷たい印象を受けることがある。\n\n服装は参考写真のどちらかを選んでください。服装や髪型は自由に変更できます。例えば、帽子を脱いだり、新しい服を着せたり。表情やポーズはお任せします。\n\nこの度はご検討いただき、誠にありがとうございました。", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@kumo_nkb/works/8", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1930957, "client_id": 2342032, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/e84dbc7e/uploads/origins/e371368a-07db-4696-a300-ecd3d8392800?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f392289786fdd4a74378c97ca085b3b3", "srcset": "https://si.imgix.net/e84dbc7e/uploads/origins/e371368a-07db-4696-a300-ecd3d8392800?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f392289786fdd4a74378c97ca085b3b3, https://si.imgix.net/e84dbc7e/uploads/origins/e371368a-07db-4696-a300-ecd3d8392800?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=17f130e4392173eb321edc5f199d433b 2x, https://si.imgix.net/e84dbc7e/uploads/origins/e371368a-07db-4696-a300-ecd3d8392800?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=44ea424210a2544148d17883fee3b9a2 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/e84dbc7e/uploads/origins/e371368a-07db-4696-a300-ecd3d8392800?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2bb425799732149ce7798e396e9bd65b", "srcset": "https://si.imgix.net/e84dbc7e/uploads/origins/e371368a-07db-4696-a300-ecd3d8392800?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2bb425799732149ce7798e396e9bd65b, https://si.imgix.net/e84dbc7