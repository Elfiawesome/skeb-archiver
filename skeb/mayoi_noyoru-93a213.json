 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@mayoi_noyoru/works/18", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3874824, "client_id": 2197913, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/4fba3bc5/uploads/origins/e1f35375-345e-44d9-b4cc-e5dea5aca9c6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8b7088d54425bc4aeaab8c406abed377", "srcset": "https://si.imgix.net/4fba3bc5/uploads/origins/e1f35375-345e-44d9-b4cc-e5dea5aca9c6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8b7088d54425bc4aeaab8c406abed377, https://si.imgix.net/4fba3bc5/uploads/origins/e1f35375-345e-44d9-b4cc-e5dea5aca9c6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=22c67e76fb7a915207388b6468421216 2x, https://si.imgix.net/4fba3bc5/uploads/origins/e1f35375-345e-44d9-b4cc-e5dea5aca9c6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=0ea0da3913660b2616f09739596e2cbe 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/4fba3bc5/uploads/origins/e1f35375-345e-44d9-b4cc-e5dea5aca9c6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=12d8b534cb13ea98db662b2bb74fb491", "srcset": "https://si.imgix.net/4fba3bc5/uploads/origins/e1f35375-345e-44d9-b4cc-e5dea5aca9c6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=12d8b534cb13ea98db662b2bb74fb491, https://si.imgix.net/4fba3bc5/uploads/origins/e1f35375-345e-44d9-b4cc-e5dea5aca9c6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=bfd2eff69ffa7aac559dcbe85791a3ff 2x, https://si.imgix.net/4fba3bc5/uploads/origins/e1f35375-345e-44d9-b4cc-e5dea5aca9c6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=3e9bcf6af89f0c6c972665d9929374ee 3x"}, "body": "前回も完璧な素晴らしい絵をありがとうございました！\n非常に面倒くさい妄想を立派な作品へと昇華して下さり感謝にたえませぬ\n助けに来た筈の相手に嬲られ 追い詰められていく正義の剣士サマ(*´Д`)ﾊｧﾊｧ\n特にブリッジで痙攣するキャロンは大変に自分のツボでございましたm(__)m\n\n並外れた精神力で悪への屈服を拒絶し続けている勇者ですが、\n前回の快感リンク無限ループに打ちのめされ、気力が低下し始めています。\n今回はそんな彼女から理力を奪い 搾り尽くし、反撃の力を失わせ\n無力化しようという魔王の策謀をお願い致します\n\nシチュ：\n感覚リンクサンドイッチで嬲られ続けるキャロン⇒\n無限ループ責めに哭き喘ぎ 苦しむ剣士の肢体が発光⇒\n侍女らの股間を覆う触手パンツ＆ディルドに理力が流れ 浄化・消滅⇒\n『ほぅ、まだそんな力を隠しておったか…\n理力を溜め、犯しに来た敵を討つ 奥の手…という訳だな？\n必死に隠し 練り上げた理力… 侍女どもを見捨て、\n不意を衝けば 我に一矢報いる事も出来たであろうに。\n自分を犯す裏切者を救い チャンスを自ら手放すとは… バカめ♡』\n\n秘かに研いでいた牙をあばかれ 反撃の機をツブされた聖剣士。\nまだ諦めていない事を悟られた戦士の尻穴に、\n特大注射器からスライムが獄注される！\n\n跳ねのたうつ牝尻に容赦なく注がれ続ける淫毒妖。\n潜り込んだ粘魔が理力を吸い 何倍にも膨張する！\n絶叫と共に暴れ狂うが 四つ這いで触手台に拘束され\n叫ぶ事しか出来ない。\n\n『特注の理力吸奪スライムよ♡\n忌々しい光の力を糧とし膨れ上がる♪\nだが安心せい。そ奴らは無理やり付与した理力耐性のせいで\n極端に寿命が短い。漏らしさえしなければ やがて\n溶け崩れ 消滅する。吸われた理力も再び貴様の力となろう♡』\n\n嘲ける悪魔の囁きが 獄炎に灼かれる脳髄に響き渡る。\n恥辱から固く閉ざされていた菊門が、更に引き締まり 窄まる。\n八方塞がりの中 微かに見えた一抹の希望、それがより強大な\n絶望の呼び水であるとしても、縋りつく以外 選択肢など無い。\n\nなけなしの気力を振り絞り 締め閉ざされる桃色の秘菊に、\n肉イボまみれの触手ブラシが宛がわれ、摺り削るかの如く\n勢いよく擦過する！！\n\n悶え哭き 獣声をあげながら尻丘を振りたくる聖剣士は、\n忍び寄り 窄まりを狙う 何十もの凶悪な造形の触手らに\nまだ気付ていなかった…", "nc": 168, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@mayoi_noyoru/works/17", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3874824, "client_id": 2197913, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/5776dc73/uploads/origins/2bc5272a-e759-4951-b36c-1ee8ffae9655?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a71f20680e81062285f72b32bfcacdea", "srcset": "https://si.imgix.net/5776dc73/uploads/origins/2bc5272a-e759-4951-b36c-1ee8ffae9655?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a71f20680e81062285f72b32bfcacdea, https://si.imgix.net/5776dc73/uploads/origins/2bc5272a-e759-4951-b36c-1ee8ffae9655?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c107442cf9d4d4824240987a2a1d5e8c 2x, https://si.imgix.net/5776dc73/uploads/origins/2bc5272a-e759-4951-b36c-1ee8ffae9655?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=8482e8c9c283f6fadbf5986fb9bd7471 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/5776dc73/uploads/origins/2bc5272a-e759-4951-b36c-1ee8ffae9655?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=03b8a179401ac4cfc9caced99ac7049b", "srcset": "https://si.imgix.net/5776dc73/uploads/origins/2bc5272a-e759-4951-b36c-1ee8ffae9655?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=03b8a179401ac4cfc9caced99ac7049b, https://si.imgix.net/5776dc73/uploads/origins/2bc5272a-e759-4951-b36c-1ee8ffae9655?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=744cb6d3164fc88fd5a6155a4636f1ad 2x, https://si.imgix.net/5776dc73/uploads/origins/2bc5272a-e759-4951-b36c-1ee8ffae9655?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=29179bdeafe543c043d816fa253d14fe 3x"}, "body": "前回はとても素敵な凌辱絵をありがとうございました！\nシーン3-1の、気丈に剣を構えている姿とか本当に最高でした！！\n侍女たちまで描いて頂き ストーリーが垣間見えて とてもエロかったです♪\n恐縮ですが 今回もキャロンを触手でイヂめてあげて下さいませ\n\nキャラ：くりいむれもん　超次元伝説ラル　キャロン\nhttps://www.pixiv.net/artworks/114270343\nhttps://www.pixiv.net/artworks/126639696\n\nシチュ：\n触手鎧を着せられ ラモーに嬲られたキャロン。\n大量中出しされ 胎内で蠢く魔粘塊に苛まれ、悶え続けていた。\n苦しむ剣士の四肢を拘束し、動けぬ剣士の目の前で\n見せつけるかの如く 侍女たちを犯す魔王。\nロメロ拘束に苦しんでいたキャロンが、突如 痙攣し喘ぎだす。\n\n侍女の尻谷に顔を埋ずめ、穿じくり廻す太舌の感触が\nキャロンの肛内で再生される。\n大量に注ぎ込まれたゲル状の粘妖が、感覚を伝播する\n特殊能力を有していたのだ！\n侍女のケツ穴を、舌で 指で 触手で嬲り尽くすラモー。\n助けを求める侍女たちの顔前で、二人分の肛悦に苛まれ\n剣士が身悶える。\n触手をフル活用し 存分に侍女たちの肉体を堪能したラモーが\nトドメとばかりに深々と貫き 侍女らを絶頂させる。\n二人分の絶頂を叩き込まれ ブリッジで潮を噴く敗北戦士に\n何者かが覆い被さる。\n\n意識をトバされ失神した侍女の体を、装着された\n触手ビキニが操り 動かしていたのだ！\n幽鬼の如く フラフラと剣士の身に覆い被さる失神侍女たち・・・\nその股間に着けられた触手パンツの股ぐらが隆起し、\n太く 逞しい凶悪なイボ根ディルドを形成させる。\n動けないキャロンに淫棒を圧しつけ 女体の柔らかさを愉しむ触妖魔。\n淫根と接続リンクしたクリに刺激が伝わり、焦点の合わない瞳に\n獣欲の灯を燈し 喘ぐ 乱心侍女たち。\nディルドで唇を犯し パイ摺りの柔らかさを堪能し 素股で擦り立てた\n二人は、ついに肉棒を突き立て 前後からキャロンを犯し 嬲る！\nサンドイッチで責められ 同時突きで挟まれる悶絶勇者の胎内で\n怪しく光るスライムが、侍女らの味わう触手棒の快楽で\nキャロンの脳髄を灼き焦がし 蹂躙し尽くす！\n無限ループで際限なく膨れ上がっていく悪魔の辱悦に、\n伝説の勇者はただただ哭き叫び 悶え狂うしかなかった…", "nc": 168, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@mayoi_noyoru/works/16", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/a7d160a1/uploads/origins/d38adeab-320d-4258-ab6f-317388a0c3f8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=1f66d73e543039ad504a2059e7664971", "srcset": "https://si.imgix.net/a7d160a1/uploads/origins/d38adeab-320d-4258-ab6f-317388a0c3f8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=1f66d73e543039ad504a2059e7664971, https://si.imgix.net/a7d160a1/uploads/origins/d38adeab-320d-4258-ab6f-317388a0c3f8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=d35c8211084f3342a130dc472038d447 2x, https://si.imgix.net/a7d160a1/uploads/origins/d38adeab-320d-4258-ab6f-317388a0c3f8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=cf578823dd87332435febe6751a0ae35 3x"}, "private": true, "genre": "art", "tipped": false, "creator_id": 3874824, "client_id": 2197913, "nc": 57}, {"path": "/@mayoi_noyoru/works/15", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/4d20a0c5/uploads/origins/7b0ff8c8-c66d-4dff-b329-17563ee792b1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=ff07745310d75773b85c65602adf3cde", "srcset": "https://si.imgix.net/4d20a0c5/uploads/origins/7b0ff8c8