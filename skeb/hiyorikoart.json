1f-a622-4660-ac02-7aedeb58b848?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9c78386e731ba4ce97545bee65d2add4", "srcset": "https://si.imgix.net/2c4e096f/uploads/origins/d973d71f-a622-4660-ac02-7aedeb58b848?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9c78386e731ba4ce97545bee65d2add4, https://si.imgix.net/2c4e096f/uploads/origins/d973d71f-a622-4660-ac02-7aedeb58b848?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=f9ef15803d048cd1860d71b0f2147607 2x, https://si.imgix.net/2c4e096f/uploads/origins/d973d71f-a622-4660-ac02-7aedeb58b848?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=19b18cc1b86016c05f5e1e32e578f2ee 3x"}, "body": "私のオリジナルキャラクターを描いてください。彼女は軍属のエンジニアです。装備や施設の設計訓練を受けていますが、日常業務は主に保守と修理です。普段は感情を表さず、真面目で、あらゆることに注意を払いますが、周囲に好印象を与えようとはしません。公の場では機械のように振る舞い、仕事以外では冷たく人を遠ざけるような態度で、仕事以外の交流では不器用でぎこちないのです。\n先進的な未来兵器へのアクセス権はあるものの、純粋な機械式火器を好む。個人用PTR91を使用中または整備中の姿で描いてください：https://drive.google.com/drive/folders/1AWCrHT8L0aXDruYqLUAWYPXAcPZRzMq3価格が気になる場合はご相談ください。\n\nhttps://drive.google.com/drive/folders/1rUENhktpBwV3wW0taxNdJlxXB5k29V-Y", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@hiyorikoart/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3108901, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/43472d37/uploads/origins/9cc62900-2a1f-4590-9c89-1665803b54ce?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e536aa0a70fa8a4bb596aa010c2e69be", "srcset": "https://si.imgix.net/43472d37/uploads/origins/9cc62900-2a1f-4590-9c89-1665803b54ce?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e536aa0a70fa8a4bb596aa010c2e69be, https://si.imgix.net/43472d37/uploads/origins/9cc62900-2a1f-4590-9c89-1665803b54ce?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=4b6aa0a3ee58bc155a11d518d31d221e 2x, https://si.imgix.net/43472d37/uploads/origins/9cc62900-2a1f-4590-9c89-1665803b54ce?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ffe37f2fdf292eecc407cc594c295be8 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/43472d37/uploads/origins/9cc62900-2a1f-4590-9c89-1665803b54ce?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=241f5eea4b454e3cb3da54422444f6d8", "srcset": "https://si.imgix.net/43472d37/uploads/origins/9cc62900-2a1f-4590-9c89-1665803b54ce?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=241f5eea4b454e3cb3da54422444f6d8, https://si.imgix.net/43472d37/uploads/origins/9cc62900-2a1f-4590-9c89-1665803b54ce?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=d71f17bbefea1be7c6f4366068882b6b 2x, https://si.imgix.net/43472d37/uploads/origins/9cc62900-2a1f-4590-9c89-1665803b54ce?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=0bcc42641eb2ec12a0a29292b9856e06 3x"}, "body": "私の OC を描いてください?\n\n頑固で、かつては強い道徳心を持っていたが、周囲の絶望的な世界に疲れ果ててしまった。彼はいまだに上官の命令やプロパガンダに合わせて行進しているが、それはよりよい選択肢が見つからないからにほかならない。彼は内面が空洞であり、より良い選択肢が生まれることを懇願している。時々 怒りや嫌悪感をコントロールできず、その感情が表面化することもある。時にはその感情が爆発し、攻撃的になることもある。彼は同僚や部下との日々のやり取りの中に、ささやかな楽しみを見つけることができる。しかし、他人の楽観主義を観察するのは苦痛だ。彼はどのような交流においても、このことをできる限り隠そうとしている。髪型は状況に応じてきちんとしていることもあれば、乱れていることもある。彼は髪をきれいに保とうとしているが、時々失敗する。日が経つにつれて髪は乱れがちになる。彼の日々の活動は軍事的任務、警護、パトロール、そして部下への指揮である。戦闘は頻繁で、常に地平線上に浮かんでいる。彼の主な仕事はコンバット・ソルダーの仕事ですが、それだけではありません。彼は装備品のメンテナンスや修理の基本的なスキルも持っている。彼は自分の武器や、時々使わなければならないサービスカーの基本的な手入れができる。また、自分の好みに合うように改造することもある。ダウンタイムや活動の合間を縫って、装備の整備を行うことも多い。彼はまた、ガーデニングにも妙な関心を寄せている。柔らかなユリの世話は、普段の仕事とは対照的だ。彼は普段、直接的に成長を助けるのではなく、積極的な生活の障害となるものを取り除き、植物の生命に安らぎを感じている。疲労や痛みを隠して、アルコールに隠れようとすることもある。時にはアルコールで自分自身から隠れることに成功し、その方が幸せになれることさえある。\nシナリオは問わない。平凡なもの、ドラマチックなもの、カジュアルなもの、戦闘、リラックスしたもの、あるいはまったく異なるコンセプトのもの? \nお好きなようにどうぞ。\n\nhttps://drive.google.com/drive/folders/1D7-ZRSejcyCHLr-rsMH5SeF-96xOdlfy", "nc": 177, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 1445328, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "るな", "screen_name": "zadddrunaaa", "avatar_url": "https://pbs.twimg.com/profile_images/1615660260982951937/2Hzk6D9K.jpg", "header_url": null, "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "art"}, {"genre": "correction"}], "nc": 49}, {"id": 1674316, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "虎とら🔞", "screen_name": "toradoraneko00", "avatar_url": "https://pbs.twimg.com/profile_images/1816511857223712769/MYbgIEqt.jpg", "header_url": "https://pbs.twimg.com/profile_banners/353297752/1721925107/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 7, "complete_expiration_days": 50, "skills": [{"genre": "art"}, {"genre": "comic"}], "nc": 177}, {"id": 1827110, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "ういの@Skeb募集中", "screen_name": "uino", "avatar_url": "https://pbs.twimg.com/profile_images/1580922383908540418/xiWtfmKo.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1488232492452569091/1716755384/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 5, "complete_expiration_days": 50, "skills": [{"genre": "art"}], "nc": 49}, {"id": 2398186, "creator": true, "nsfw_a