 "received_works": [{"path": "/@Tombieeez/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2086775, "client_id": 253939, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/ccb9c87b/uploads/origins/aa01f0ea-5777-4672-966c-166c4a2a9eba?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=202c8c04850a164e70688e82fd22af2a", "srcset": "https://si.imgix.net/ccb9c87b/uploads/origins/aa01f0ea-5777-4672-966c-166c4a2a9eba?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=202c8c04850a164e70688e82fd22af2a, https://si.imgix.net/ccb9c87b/uploads/origins/aa01f0ea-5777-4672-966c-166c4a2a9eba?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=cbc7a6aa7fba34114db2156dc14f01f9 2x, https://si.imgix.net/ccb9c87b/uploads/origins/aa01f0ea-5777-4672-966c-166c4a2a9eba?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=0d4720cae6244afdb26ea6c82e64da7e 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/ccb9c87b/uploads/origins/aa01f0ea-5777-4672-966c-166c4a2a9eba?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=4e1f089a6a9bb2182eab7b6deab60c3d", "srcset": "https://si.imgix.net/ccb9c87b/uploads/origins/aa01f0ea-5777-4672-966c-166c4a2a9eba?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=4e1f089a6a9bb2182eab7b6deab60c3d, https://si.imgix.net/ccb9c87b/uploads/origins/aa01f0ea-5777-4672-966c-166c4a2a9eba?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=c4259795af39032917d8b83d4d05ea5f 2x, https://si.imgix.net/ccb9c87b/uploads/origins/aa01f0ea-5777-4672-966c-166c4a2a9eba?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=be1a97a587518dea0cfdd7803bd9a0de 3x"}, "body": "Tombie様こんにちは！\n以下の要件にてリクエストをお送り致します。自由に描いていただければ幸いです。\n\n●概要\nサイバーパンク系のTRPGで使用しているキャラクターです。\n\n●外見特徴\n・登記上18歳、外見年齢15～6歳、精神年齢5さい\n・感情が出やすい\n・釣り目\n・八重歯\n・癖毛長髪\n・元気無さそうな細さ\n　元気は元気ですが、自分で自分の身体をハッキングする要領で無理矢理動かしています。\n\n●服や銃のデザイン\n　強いこだわりはないのでお任せします\n　しいていえば上着はオーバーサイズのものが多いかなと思います（武器・装備を隠すため）\n\n●設定\nハッカー/ドローン使い/元少年兵\n　戦争の後遺症として「肉体が眠り続け、精神だけが電脳ネットワーク上で活動している」状態でした。\n　自分の体が目を覚ましたのはつい最近で、\n　それまではドローンや人の携帯端末をハッキングして他者とコミュニケーションを取っていました。\n　今も割とそのクセが残っており、よく他人のものを気軽にハッキングして動かして遊びます。\n　「センサー越しではない、自分の五感で世界に触れられること」がもの珍しく、毎日楽しく能天気に暮らしています。\n　職業はフリーランスの傭兵、他者を銃で撃ったりドローンで轢いたりすることに躊躇がありません。\n\n●その他\n・URL先のファイルはSKIMAでデザイン及び制作を依頼したものです。\n・サインについてはお任せしますが、できればいただけると嬉しいです！\n\nご縁いただけましたら幸いです！\n\nhttps://drive.google.com/drive/u/0/folders/1RbkSl5vFDw8-CursiB5ZHcQuD3QskMfi", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@Tombieeez/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2086775, "client_id": 1035701, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/96407f22/uploads/origins/d734612c-239f-43ef-86ca-0b006a2abcb7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c742faff1c506a7c293e8e5c015b2e36", "srcset": "https://si.imgix.net/96407f22/uploads/origins/d734612c-239f-43ef-86ca-0b006a2abcb7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c742faff1c506a7c293e8e5c015b2e36, https://si.imgix.net/96407f22/uploads/origins/d734612c-239f-43ef-86ca-0b006a2abcb7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=2117de7fa3b98623c1812aa98be0f678 2x, https://si.imgix.net/96407f22/uploads/origins/d734612c-239f-43ef-86ca-0b006a2abcb7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=6725e821d7e3f91f6e2e5cb46583c5bd 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/96407f22/uploads/origins/d734612c-239f-43ef-86ca-0b006a2abcb7?bg=%2