b-62cd39b9ae2f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=29609745f3d389dfaae16d66997df523", "src_set": ""}, "body": "チアガールの異種姦絵をお願いします。\n\n・女の子\n黒髪セミロング～ショートボブの巨乳美少女\n二次元ドリームノベルス的なチア衣装退魔士\n真面目で正義感の強い性格\n過去に異種姦レイプ孕ませ経験あり\n化け物相手に感じまくるも絶対に堕ちない\n一人称は「私」\n\n・衣装\n資料URLのかなり昔のチア衣装\n白ショート手袋&白ショート靴下&白スニーカー着用\nアンスコは前面背面共にフリフリ＆お腹まで覆うブルマ位の布面積タイプ\n企業ロゴは削除\n衣装破れ・脱がしはクロッチ部分のみ\n\n・相手\nゴツい類人猿的な黒系な毛色の亜人型怪物\n\n・シチュ\n正常位でレイプ(腋が見えるように腕を頭の方に上げる感じ)\nアンスコと白パンツのクロッチに空けた穴からペニスを挿入されてかはっと息を詰まらせる\n中出しで妊娠させられる恐怖・嫌悪感に目を見開きながら号泣絶叫するも、特濃熱々精子で子宮を満たされて絶頂\nその後退魔士の力で受精を感じてレイプ目ボロ泣き\n\nhttps://www.dropbox.com/scl/fo/ma93e1xzfc799mwz1uh3t/ADVOfFY3SjIoPJomnyFHAO8?rlkey=085h8bkz6e9m25wtf55ra6np2&dl=0", "nc": 185, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}], "similar_creators": [{"id": 16718, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "こぼ", "screen_name": "cobo_0609", "avatar_url": "https://pbs.twimg.com/profile_images/1821101884180189184/s1R6CXX3.jpg", "header_url": "https://pbs.twimg.com/profile_banners/2970904200/1654911316/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "skills": [{"genre": "art"}, {"genre": "comic"}], "nc": 161}, {"id": 47972, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "日賀紀夫", "screen_name": "higanorio", "avatar_url": "https://pbs.twimg.com/profile_images/1672233732097601536/3FhbCJ7T.jpg", "header_url": "https://pbs.twimg.com/profile_banners/3098094950/1751947627/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 9, "skills": [{"genre": "art"}], "nc": 160}, {"id": 104254, "creator": true, "nsfw_acceptable": true, "acceptable": false, "name": "パンダィン＠C106合同誌