の胸元や結合部が見えるようなアングルだととても嬉しいです。\n構図的に違和感が生じるようでしたら、描きやすいように変えていただいて大丈夫です。\nお目通り叶えばたいへん嬉しく思います。\nよろしくお願いいたします。\n\n参考資料\n空門藍（左の子です）\nhttps://key.visualarts.gr.jp/summer_rb/common/image/ouen_illust_asahina_l.png\nhttps://pbs.twimg.com/media/EE4DonbUUAIKW5l?format=jpg&name=small", "nc": 177, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}], "sent_works": [], "similar_creators": [{"id": 3379, "creator": true, "nsfw_acceptable": true, "acceptable": false, "name": "CMY子👁️👓🖌️／藤島製１号", "screen_name": "sei1go", "avatar_url": "https://pbs.twimg.com/profile_images/1332885165081722882/pvebxF4f.jpg", "header_url": "https://pbs.twimg.com/profile_banners/111403548/1612034109/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "art"}, {"genre": "comic"}, {"genre": "correction"}], "nc": 176}, {"id": 131093, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "鈴村 淳@お絵描きSkeb募集中！", "screen_name": "jun_suzumura", "avatar_url": "https://pbs.twimg.com/profile_images/1606612032346034178/9aWWk2Ex.jpg", "header_url": "https://pbs.twimg.com/profile_banners/65005129/1650081197/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "art"}], "nc": 161}, {"id": 269285, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "ZEN", "screen_name": "ZEN_KAMURO", "avatar_url": "https://pbs.twimg.com/profile_images/1987162171860787201/KjMGbd29.jpg", "header_url": "https://pbs.twimg.com/profile_banners/115044354/1762611357/1500x500", "appeal_receivable": false, "popular_creator_rank": 5, "request_master_rank": null, "first_requester_rank": 