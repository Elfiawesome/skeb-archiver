n\n青い人(「Good night,Judas.」探索者)\n・30歳/171cm52kg\n・自他共に厳しい性格\n・どちらかというと寡黙\n・ムスッとした表情が多い\n・右目は出していても出していなくても構いません\n\n二人に共通してるもの\n・同じ金髪\n・吊り目\n・普段隠れている方の瞳は同じ水色\n\n以上です、よろしくお願いします。\n\nhttps://drive.google.com/drive/folders/1ZXtfLUj3HQ5PSVWD1duBuK8NVpUwkfFY", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@wonemu_trpg/works/2", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/931e0cac/uploads/origins/22bddf36-8fa4-43d0-9c6a-529b2b8709a8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=d2a6e5129420b0948d38726cdecc2edb", "srcset": "https://si.imgix.net/931e0cac/uploads/origins/22bddf36-8fa4-43d0-9c6a-529b2b8709a8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=d2a6e5129420b0948d38726cdecc2edb, https://si.imgix.net/931e0cac/uploads/origins/22bddf36-8fa4-43d0-9c6a-529b2b8709a8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=ea7a17fec75b19a05a0494a29291a498 2x, https://si.imgix.net/931e0cac/uploads/origins/22bddf36-8fa4-43d0-9c6a-529b2b8709a8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=096ec6488379b45301c1a011498ba6ad 3x"}, "private": true, "genre": "art", "tipped": true, "creator_id": 2844448, "nc": 128}, {"path": "/@wonemu_trpg/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2844448, "client_id": 995229, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/59d92723/uploads/origins/72fbb8e1-215d-4d45-b340-005c1adf2399?bg=%23fff&auto=format%2Ccompress