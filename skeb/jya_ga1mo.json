fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=37f00af1bdfc3dda56475870c9a7bfb3", "src_set": ""}, "body": "Hi! Im really in love with your art! You are absolutely one of my favorites!\nI would love to see my new character by your hands!\n\nShe is an Oni Shark that just joined a villain arc, I am going to debut soon so I am in needed of some new artpieces of her ♥\n\nRefs: https://imgur.com/a/oni-shark-6jG3HiH\nTheme: KPop demon hunters inspiration, there is a moodboard inside of what I like, feel free to get some inspiration from it\n\nThank chu so much and please stay safe! ♥", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@jya_ga1mo/works/10", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3359603, "client_id": 3507139, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/6e9a813f/uploads/origins/a94081a2-ad3a-4977-946b-82194d2ff69f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6dee853d30e956a93772466b1fcc9121", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/6e9a813f/uploads/origins/a94081a2-ad3a-4977-946b-82194d2ff69f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0ccf9e39b0229297b87a4327cdc6dbf7", "src_set": ""}, "body": "こんにちは！ツイッターであなたの作品を見つけ、とても気に入りました。\n\n私のバジリスクVTuber（蛇娘）の絵をお願いしたいです！\n彼女は少しおどけたところがあるのですが、嵐の中の静けさを表現するような、もっと厳かな作品を期待しています。\n\n彼女は獣のような人型の形をしていて、人間とモンスターの中間のような感じです（参考資料にもある完全な獣の形ではありません）。\nあなたのスタイルなら、そのハーフモンスターの側面が美しく見えると思いますが、その解釈は完全にあなたに委ねます。\n\n眼鏡をかけ、髪には黄色と青の筋があり、顔と体には青い鱗がある。\n\nSNS（Twitter、Twitchなど）で使用したいです。グッズには使用しません。\n\nお好きなようにイラストを作成してください！\nありがとうございました！\n\nhttps://drive.google.com/drive/folders/1ifqtRoNyDWEPJZZ1Ox7iHMsGYLcDEIhf?usp=sharing", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@jya_ga1mo/works/9", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3359603, "client_id": 3560498, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/d4968da6/uploads/origins/eb271603-1b12-4f71-bf09-e1bddaab3346?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=90b3710629977c692a2d961447d7dae3", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/d4968da6/uploads/origins/eb271603-1b12-4f71-bf09-e1bddaab3346?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=32ec29a7429c7e69674a48619e023d36", "src_set": ""}, "body": "こんにちは！Xであなたの作品を見て、あなたのアートスタイルが大好きになりました。\nアゼリアは森の妖精で、ちょっと気が強く、気取ったいたずら好きで、ペットの蜂フレイムとよく一緒にいます。できれば蜂も一緒に描いてほしいです。ポーズや表情はお任せします。\nアザは、歯が露出していれば牙があり、通常、おちゃめな表情やドヤ顔をしている。フレイムのサイズは変更可能なので、アーティストの解釈次第。\n\nSNS用に使う予定です。ご配慮ありがとうございました！私のリクエストに楽しんでいただけると嬉しいです\n\nhttps://drive.google.com/drive/folders/1A6qTZ-7LnoUjBtkfdCD1MDNgRV6tWYhz?usp=sharing", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@jya_ga1mo/works/8", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3359603, "client_id": 2705440, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/255cada2/uploads/origins/8bed973e-feda-4de1-9eb9-735b4768ac65?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=294361fedc928cf7ba5f61e5672780ec", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/255cada2/uploads/origins/8bed973e-feda-4de1-9eb9-735b4768ac65?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a2547ebdec36de40c06886eb0a5f355e", "src_set": ""}, "body": "こんにちは！私のVtuberがあなたのスタイルでシンプルなハンフーを着て、湖の近くで穏やかな表情をしているアートを手に入れたいと思っていました。ありがとうございます！\n\nhttps://drive.google.com/file/d/1TmWRS1OXcelO5TMNdC7u5wSflbXbyGMf/view?usp=drive_link", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@jya_ga1mo/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3359603, "client_id": 1078827, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/014795b0/uploads/origins/c6d39cb2-15af-45af-914a-aaf90638eff6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b917c9fba0282b61fdf84014713e54bc", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/014795b0/uploads/origins/c6d39cb2-15af-45af-914a-aaf90638eff6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c139fe7820870b0cd6f67e04cc44b567", "src_set": ""}, "body": "こんにちは！僕のエルフのOCを描いてくれたら嬉しいな！\n\n私はあなたの描くもの全てが本当に好きなので、ぜひ彼女のチャラチャラした姿を描いてほしいです。\n彼女に着せたいドレスを添付しました。\nまた、彼女のタトゥーとその見え方も添付します！\n\nあとは、あなたが自分で考えたものを見てみたいです！\n\nhttps://imgur.com/a/xgUx9AZ", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@jya_ga1mo/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3359603, "client_id": 1305113, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/1403e9c5/uploads/origins/60fb9942-0b1b-4f26-a761-2407c6fdb5f8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a7a3f158128ff4831c6858b8d8259697", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/1403e9c5/uploads/origins/60fb9942-0b1b-4f26-a761-2407c6fdb5f8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e1c5ed58c0c6ad0de8626046e6d23d58", "src_set": ""}, "body": "こんにちは！僕のtrpgキャラクター「アズラエル」の絵をお願いします。\n\n- 性別はないが、とても美しい。\n- 以前はエルフ族で、今は堕天使。\n- 彼らの翼は骸骨のようで、しばしば血と血糊で覆われています。翼は自由に動かすことができるので、翼を描かないのも自由です。\n- いつも優しく微笑んでいる。\n- キセルパイプを吸う。\n- とてものんびりしていて、軽薄。\n- 密かに人を操る。\n- 毒や薬を使う。耐性があるので、パイプの毒煙を使って人の顔に吹きかけることが多い。\n- マッドドクター／科学者。\n- 少し黒目の袋がある。\n- 手のひらに呪文の丸が刻まれている。\n- その縫い目は笑顔の傷跡のようになっている。\n- ミステリアスでちょっと怪しい。\n\nモチーフ : 喫煙, カルトのテーマ, 聖書の天使, 宗教, 医学, 薬物, 毒物, 実験, リコリス・ラディアータの花.\n\nリコリス・ラディアータの花で何かできないかと思っていました。\n\nご検討ありがとうございます！\n\nhttps://f2.toyhou.se/file/f2-toyhou-se/images/95283275_wg7AbAstxd1Bm1L.png", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@jya_ga1mo/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3359603, "client_id": 2801599, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/85ca0da6/uploads/origins/669e6315-3efc-4f55-8719-849d7f84ca5f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7c63c001f812075c0c21f03c872e1d44", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/85ca0da6/uploads/origins/669e6315-3efc-4f55-8719-849d7f84ca5f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=16ca185182ba2bd73572366c83abc3b5", "src_set": ""}, "body": "こんにちは！\n\nこれは私のキャラクターで、一人はオス（角）、もう一人はメス（ウサギ）です。\n\n彼らは闇の力を持つカップルです。私の唯一のリクエストは、彼らの周りにたくさんの黒いインクやしずくで、愛の中で彼らを描くことです。\n\n男性の方は、ピンク・ブルーのグラデーションか、ブルー・ピンクのグラデーションで描いてください。あなたの好みにお任せします。\n\n服のディテールはあまり気にしなくていい。作ってもいいし、シンプルにしてもいい。私は自分のキャラクターを一貫して描くことはないし、他の人にもそれを期待しない🙏🖤。\n\nありがとうございます ！\n\nhttps://x.com/dayflite/status/1840092890258718834?s=46", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@jya_ga1mo/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3359603, "client_id": 1349802, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/3705bbea/uploads/origins/b32abf56-8465-4540-8ff1-61ce4dbe2be8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=72c314b67b71c64c0cfff9d50e982cf1", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/3705bbea/uploads/origins/b32abf56-8465-4540-8ff1-61ce4dbe2be8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=96fef20a1aac5bf1814b8e900293c040", "src_set": ""}, "body": "先生、こんにちは！\n新作で先生の絵を見て、一目惚れしました！だから、私のOCを先生に作ってもらいたいので、リクエストします。\n\nhttps://sta.sh/225rzdub1t3j?edit=1\nミーシャは雪の森を彷徨う魔道士で、魔法は主に火！体はかなり細身でアンドロイドっぽいです。イラストは寒色系でお願いします。\n\nよろしくお願いします！", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@jya_ga1mo/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3359603, "client_id": 3301168, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/a944e74c/uploads/origins/124399a9-602d-4610-ae74-d4a57205f8c3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8135ec66c1874303683aa0120321f422", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/a944e74c/uploads/origins/124399a9-602d-4610-ae74-d4a57205f8c3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d8f369a3d44a6c6f379d49d1ea4660ff", "src_set": ""}, "body": "初めまして、京と申します。\n skebにてKj先生の素敵なイラストを拝見し、是非描いていただきたくリクエストを送らせていただきます。\n Kj先生に描いていただきたいのはオリジナルのキャラクターです。\n 以下が依頼内容になります。\n\nキャラクターの容姿:\n・腰くらいまである長い黒髪\n・前髪は古風な少女漫画のように立ち上げられた真ん中分け\n・瞳の色は暗い菫色\n・年齢は15～16歳くらい\n・性別は男性\n・長身ですらりとしている\n・表情は静かでどこか孤独を感じさせる\n\n衣服のイメージ:\n・アメジストのペンダント\n・装飾は少なくシンプルなデザイン\n・魔法使いのローブのような古風なスタイル（フード等は被らない）\n・露出は少なめ\n・裸足\n\nシチュエーション:\n・浜辺を静かに歩いている\n 夜の暗い海でも、日の出の明るい海でも、Kj先生のお心のままに書いていただきたいです。\n 裾が濡れないように、ちょっとつまんでいてほしいです。\n\n構図:\nお任せいたします。\n\n使用用途:\n 個人的な鑑賞目的です。\n\nファイル形式:\n PSDだと開き方がよく分からないので、PNGでお願いしたいです。\n\nご縁がありますように🙏🏻\n\n資料はピクルーで生成してみました。アメジストのペンダントがなく、服のイメージのものがなかったので、あくまでも顔のイメージとして活用してください。\nまた、１週間で自動削除される仕様になっております。必要がありましたらスクリーンショットをなさってください。\n\nhttps://ibb.co/0jbKF9v", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@jya_ga1mo/works/2", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/1c5ca24f/uploads/origins/c282ee2a-fa3f-49d5-a3e6-7909422f3147?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=1fc59fcdf47a714355d031b4b272e550", "src_set": ""}, "private": true, "genre": "art", "tipped": false, "creator_id": 3359603, "client_id": 2458042, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 128, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@jya_ga1mo/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3359603, "client_id": 1500785, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/629b53e4/uploads/origins/632dc9ff-6959-48ab-9bca-e9f3115f1b8a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=682fed8a42d117aaa2f75653684d7d4f", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/629b53e4/uploads/origins/632dc9ff-6959-48ab-9bca-e9f3115f1b8a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=257583dcc15327aa71d810e7cb640122", "src_set": ""}, "body": "先生、こんにちは！先生の絵が大好きなので！この男性を描いていただきたい\n\nJoseph-29歳。英国ロンドンの裕福な家庭に生まれた。法医学者出身、現在は英国ロンドンの檢察官。優雅な紳士。\nhttps://drive.google.com/drive/folders/1Rb6WFQ1OvcQH4_apWvkFit2gYx4iOWxT\n\nぜひ、自由に描いてみてください\n\n服装は自由に変更可能、服装の例については、フォルダを参照してください。（でも、【法廷衣装】をお選びの場合は、フード付きとフードなしの2種類をご用意ください）\n\n申し訳ありませんが、私は外国人です、文面に変なとこ