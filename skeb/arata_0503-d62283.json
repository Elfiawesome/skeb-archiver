a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=c60ab9bac02383773ae805eee37da2bd 3x"}, "body": "あら太くんさん先生、お世話になっております。のんりずと申します。\nケモみあるデフォルメイラストがお得意とお聞きしましてここぞとばかりにリクエストをさせて頂きたく馳せ参じました。\n\nのんりずのアバター兼本来の姿である「ゲーミングパンダ」のイラストをお願いしたいです。\n\n【構図】\n待機ポーズのような感じでお願いをしたいです。\n細かい体の向きや姿勢、腕・手のポーズ、座り立ち、表情や目線の向きなどについてはお任せいたします。\n\n【使用用途】\n・動画配信サイトの配信画面レイアウトおよびプロフィール画面への掲載\n・Twitter画像投稿時、他素材や背景と組み合わせての使用\n　　⇒部分掲載（例：腰より上など）、切り取り（円・四角などの枠に収めるため）の可能性があります\n　　⇒イラスト自体への追記加工はいたしません\n・配信中やSNSで自慢してしまう可能性があります\n\n【デザインについて】\n資料URLに記載しましたのでご確認をお願いいたします。\n（イラストのイメージに合わない場合、服などの細かい柄は省略いただいても構いません）\n\n可能であればですが、上記使用用途を検討しているため背景透過された画像だと助かります。\nそれでは、ご検討の程よろしくお願いいたします。\n\nhttps://drive.google.com/file/d/17EKpRSsjtCtZH3Vk10a50739w4h46R26/view?usp=sharing", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@arata_0503/works/12", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 749648, "client_id": 2327026, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/31995028/uploads/origins/456d42dc-8095-4ac7-9f0d-c36e94c4082a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fb31f9e115dcf68bb45baea73efdd2e1", "srcset": "https://si.imgix.net/31995028/uploads/origins/456d42dc-8095-4ac7-9f0d-c36e94c4082a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fb31f9e115dcf68bb45baea73efdd2e1, https://si.imgix.net/31995028/uploads/origins/456d42dc-8095-4ac7-9f0d-c36e94c4082a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ec56cc3458165467941a64d7603bfba6 2x, https://si.imgix.net/31995028/uploads/origins/456d42dc-8095-4ac7-9f0d-c36e94c4082a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=619c0b777c90284476606d509a164748 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/31995028/uploads/origins/456d42dc-8095-4ac7-9f0d-c36e94c4082a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ff7f8b6411a067a50664f5fac03bd447", "srcset": "https://si.imgix.net/31995028/uploads/origins/456d42dc-8095-4ac7-9f0d-c36e94c4082a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ff7f8b6411a067a50664f5fac03bd447, https://si.imgix.net/31995028/uploads/origins/456d42dc-8095-4ac7-9f0d-c36e94c4082a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=239212fec6935e2629e9867834e60300 2x, https://si.imgix.net/31995028/uploads/origins/456d42dc-8095-4ac7-9f0d-c36e94c4082a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=231d2704b1dcef5309b8e48938d94891 3x"}, "body": "あら太様初めましてこんにちは！\n個人VTuberの美澄ぽるたと申しますのじゃ。\n\n新着イラストにてかわえらしいデフォルメイラストを拝見し\n是非ハチさんの絵柄で我を描いて頂きたい！と思いリクエストさせて頂きました。\n\n【雰囲気·構図】\n全ておまかせでお願いします。\n服装の変更やアレンジ等も大丈夫です！\n\n【美澄ぽるたについて】\n·異世界出身の舞台役者主婦魔族\n·笑うと止まらない、元気\n·常にポンコツ\n·首のジャボに付いている装飾はカニ\n\n【使用用途】\n動画·配信サイトでのサムネイル/配信·動画内使用\nFUNBOXサムネイル\nツイッターでの宣伝や他素材と合わせたハッシュタグへの使用\nアイコンやヘッダー、予定表画像\nLit.Link(上から文字入れ等の加工を行うかもしれません)\n\n【可能であれば】\nチャンネルが収益化した場合、収益化後のチャンネルでも使用させて頂きたいです。\n\n上記使用のため可能であれば背景やサイン、人物が別れたPSDか別に人物のみの透過された物を頂きたいです。\n不可の項目(特に収益が関わる部分)がある場合は別レイヤーなどにご記載いただけると幸いです。\n\n内容や金額に問題がありましたら再送やキャンセルしていただいても大丈夫ですので、ご検討よろしくお願い致します…！\n\nhttps://twitter.com/Actorportan0707/status/1560985800590127106?t=y0b-ILazuaghWVCy9rciag&s=19", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@arata_0503/works/11", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 749648, "client_id": 1737039, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/afecfdb9/uploads/origins/cfb83d56-73f0-4a36-bf00-b16ab162e1d8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e17306906c3df3462900c924aa5009a4", "srcset": "https://s