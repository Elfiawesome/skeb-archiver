xFdK189pvwuVvfuhGi1oKsyVP~Q~Flwqrl5Wmyuc2zV7rDTBB6Q__&Key-Pair-Id=K1GS3H53SEO647", "duration": 144, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1697134195561353216%2Fts3PjvFU.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=1a1c3d1a8b82b26c74fe04a10f9fac54", "srcset": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1697134195561353216%2Fts3PjvFU.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=1a1c3d1a8b82b26c74fe04a10f9fac54, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1697134195561353216%2Fts3PjvFU.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=18ecb80fbdc5e3121444562fbba35b63 2x, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1697134195561353216%2Fts3PjvFU.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=527df0ceea8332eb8112a31ba9cd78e6 3x"}, "body": "いつも配信や配信のアーカイブで柚萌さんのASMRシチュエーションを聴いて元気を貰ってます！\n様々なキャラのシチュを聴く中で浮かんだイメージを台詞リクエストさせて頂きます！\nお節介な死神ちゃん（ダウナー系女の子）に慰められるというか、諭される……みたいなシチュです。\n\n下記の台詞は、主人公が自身の人生をなげうってしまい、意識を失う中で死神ちゃんに出会い色々言われる様子をイメージしました。\nもし、琴線に触れましたら演じて頂けますと幸いです！\n\n◇◆◇\n（△夢の中？にて）おーい、ぺちぺち。あ、やっぱ助かってるみたいだねー。\nよぉー死に損ない。……あれ？　もしかして、覚えてない？\nまあ、アンタ相当きてたみたいだし、ほとんど無意識だっただろうねぇ。\nでもまぁ、あのやり方は手軽なんだけど、なっかなか意識飛ばないからきっついよー？\n後処理だってたーいへんなんだから。首も痛くて苦しかったでしょ。\nはぁ（△ため息）。とは言え、そのお陰でこうして猶予も与えられて……ウチら死神の出番ってワケね。\n\nアンタ、最期の瞬間、頭に誰か浮かんだでしょ？\nふぅ（△軽くため息）。アンタが思っている以上に、いなくなったら悲しむ人はたくさんいるものよ。いつもそばに居なくたっても……ね。\nさしあたって意識が戻ったらさ、その人に言えなかった「ありがとう」や「ごめんなさい」を相手がドン引きするぐらい伝えてあげなさい。\nいつかきっといいことあるさ！　みたいな無責任なことは言えないけれど、そいつのためぐらいには生きてあげてもいいんじゃない？\n\nさーて！　そろそろ足も動かせるようになってきたんじゃない？　ほら！　さっさと帰った帰った！\nん？　ところでなぜ「自分は助かっているんだ？」ですって？\nアンタのためを想うそいつが、アンタを助けたからに決まってるじゃない。\nじゃあね――、私みたいにはならないでよね？（△少し小声）\n◇◆◇", "nc": 0, "word_count": 0, "transcoder": "audio", "creator_acceptable_same_genre": true}, {"path": "/@co1080245/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "voice", "tipped": false, "creator_id": 768117, "client_id": 3033458, "vtt_url": "https://fcdn.skeb.jp/uploads/outputs/06f4cead-4036-40db-9480-8dea742e5f02?response-content-disposition=inline&Expires=1780451122&Signature=Qh9RQMcheBrnN0eRCO~jWQhpjvM2iReQLdokYLKXk8luKs9i34EJPYg3vvUgTWXAykqKW9LuUyDG7E2jS9wyhQEgJ2EUvwyTyHW~2RqbAonZuv4It7zXvpHhKn3zyYI88rxNc6HKuR6BTmk2UGT6PzjoVkkCkAwkFPAebJQGQnZJhphGG0K9w8S1jhQqpnU9aB-V7LNEzO-k6bo~q3G7ER-pN9nUX5SPWe6Nt5LfuunMdaKxqX5~0LBXy61jwF3yc4L8IurUuvRW3ct7aTDS85PFSDEhRgF0U1vs2eZhkiii9spRYdG9fOZKIjNGJLfZ6S65wbK0dh9RxAL-krGpsA__&Key-Pair-Id=K1GS3H53SEO647", "thumbnail_image_urls": {"src": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1697134195561353216%2Fts3PjvFU.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6b7cc25282581f0bc9065c8511e08990", "srcset": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1697134195561353216%2Fts3PjvFU.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6b7cc25282581f0bc9065c8511e08990, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1697134195561353216%2Fts3PjvFU.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=958aaf0fd9122b78b1960de3dbd4bada 2x, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1697134195561353216%2Fts3PjvFU.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=85f572b182f92a67d2dc1750b908a858 3x"}, "preview_url": "https://fcdn.skeb.jp/uploads/outputs/e75dd734-75ec-4a2a-8335-e9fb23b91470?response-content-disposition=inline&Expires=1780451122&Signature=fFpsy99OzMy4hrgwkPuXbSjEImcFm4Uen4zAM5sqvzNZJ~y2hnhl8OowxQ265Btx~5k9E54bIODp0Ve8m7h4gXLhD73QfpQwRcKdLWyXL3i~NkYf1~oFqeGoLKvs0Lh557qvn475eD0yeIOMUiJaLB3dqBEeNwrDsjgAs9G