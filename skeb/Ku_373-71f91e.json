-8792-739f1960a2ed?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=d2a705e70d036dbd8f9e8840e46a8bfe 2x, https://si.imgix.net/a1f06441/uploads/origins/4f8d39d9-0e2a-48a5-8792-739f1960a2ed?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=dd8fa90ab87d8deead31e5ea269d92a2 3x"}, "private": true, "genre": "novel", "tipped": false, "creator_id": 1224680, "client_id": 50927, "nc": 178}], "sent_works": [{"path": "/@delta_spats/works/12", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 933047, "client_id": 1224680, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/9f496483/uploads/origins/58c00224-0283-46f5-96b2-4a5c3583fd5f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4b586b31ac4c2e7985a0e049e9668ac9", "srcset": "https://si.imgix.net/9f496483/uploads/origins/58c00224-0283-46f5-96b2-4a5c3583fd5f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4b586b31ac4c2e7985a0e049e9668ac9, https://si.imgix.net/9f496483/uploads/origins/58c00224-0283-46f5-96b2-4a5c3583fd5f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=43f8dcbb438afdaa8c2813577aac8ddb 2x, https://si.imgix.net/9f496483/uploads/origins/58c00224-0283-46f5-96b2-4a5c3583fd5f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=5cf508820c19e21871ff1ee385100153 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/9f496483/uploads/origins/58c00224-0283-46f5-96b2-4a5c3583fd5f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=4b7fc61a589dac738d5dd71ee31d02b9", "srcset": "https://si.imgix.net/9f496483/uploads/origins/58c00224-0283-46f5-96b2-4a5c3583fd5f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=4b7fc61a589dac738d5dd71ee31d02b9, https://si.imgix.net/9f496483/uploads/origins/58c00224-0283-46f5-96b2-4a5c3583fd5f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=2cc9a048397959b5b3fca9e6f43ae3be 2x, https://si.imgix.net/9f496483/uploads/origins/58c00224-0283-46f5-96b2-4a5c3583fd5f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=e668c4c60524f81d0c763c6114adb003 3x"}, "body": "破壊狼 様\n\nいつもお世話になっております。\n\n以前デザインしていただいたキャラクターを用いて、以下の内容についてイラストをお願いしたく存じます。\n\nキャラクターの描写：\nムチムチとした体つきの牝狼魔獣である「珊瑚」を描いてください。彼女は現在、二本の巨根を挿入されており、その表情には限界を超えた苦痛と絶望が見えます。このシーンでは、珊瑚は苦しみながらも耐え抜く姿を強調してください。珊瑚は四肢を踏ん張って二匹分の巨大な牡たちを支えつつ、その重さにも耐えており、かつ、珊瑚のお腹は挿入されている二本の巨根によりこれまでにないほどに大きくされてしまっています。それこそ、過去に描いていただいた珊瑚に巨狼が大量射精を放ったイラストよりも、大きくされてしまっています。\n\n挿入しているキャラクターについて：\n\n「ラクト」：珊瑚よりも一回り大柄な魔獣です。彼は珊瑚の背中にマウンティングしており、その力強い体格が強調されるようにお願いします。ラクトの巨根は珊瑚の身体からしたらやや物足りないですが、黒狼と比較するとさらに小さく見えてしまうでしょう。\n「黒狼」：圧倒的なサイズ感を持つ巨獣であり、ラクトの背中にマウンティングしています。黒狼はラクトよりもさらに大きく、その圧倒的な存在感を描写してください。ただし、黒狼の体重がラクトや珊瑚に過剰にかからないように配慮してください。珊瑚の身体の大きさに比べ、あまりにも大きな巨根を持っており、その一本だけでも珊瑚が悲鳴を上げるほどに巨大なものとします。\n\nシーンの設定：\nこのシーンは、ラクトと黒狼が精力の勝負を行っているという設定です。珊瑚はその勝負の場で、二匹の挿入を受けている状況です。もし可能であれば、ラクトも黒狼との勝負に張り合っているものの、劣勢に立たされている様子を描いてください。ラクトの表情には、負けたくないと踏ん張るものの、苦しさと負けてしまうかもしれないという敗北感がわずかに見えるようにしていただけると嬉しいです。\n\n差分について：\nまた、可能であれば、ラクトと黒狼が射精する瞬間の差分も描いていただけると大変ありがたいです。二匹の射精のタイミングや表情の変化が伝わるような描写をお願い致します。ただでさえ許容量を遥かに超えてしまった珊瑚のお腹は、まるで地面に接してしまいかねないほどに膨らんでしまうでしょう。\n\n以上、詳細なご説明となりますが、何卒よろしくお願い申し上げます。\n\nイラストの完成を心より楽しみにしております。", "nc": 176, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@tonosukedx/works/131", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1529144, "client_id": 1224680, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/039f93b4/uploads/origins/b80a778e-f844-4d5e-99c9-c563b3e2242b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=304b220998a5b898c5a04824c319229c", "srcset": "https://si.imgix.net/039f93b4/uploads/origins/b80a778e-f844-4d5e-99c9-c563b3e2242b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=304b220998a5b898c5a04824c319229c, https://si.imgix.net/039f93b4/uploads/origins/b80a778e-f844-4d5e-99c9-c563b3e2242b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=72be517bc80850297706ad4fb56066ae 2x, https://si.imgix.net/039f93b4/uploads/origins/b80a778e-f844-4d5e-99c9-c563b3e2242b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=61e8172a8c2162973c3f1001e6d70591 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/039f93b4/uploads/origins/b80a778e-f844-4d5e-99c9-c563b3e2242b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=43aeddfebd79c50863157b27ddb9493a", "srcset": "https://si.imgix.net/039f93b4/uploads/origins/b80a778e-f844-4d5e-99c9-c563b3e2242b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=43aeddfebd79c50863157b27ddb9493a, https://si.imgix.net/039f93b4/uploads/origins/b80a778e-f844-4d5e-99c9-c563b3e2242b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=7974fac0067e1bebf1b1549230f65d50 2x, https://si.imgix.net/039f93b4/uploads/origins/b80a778e-f844-4d5e-99c9-c563b3e2242b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=f896c7928f275be07dc4f7b22980dc9e 3x"}, "body": "トオノスケさん、こんにちは。\n初めてのリクエストです。\nお願いしたいのは、うちの牝の狼獣人である珊瑚が美味しそうな食事を楽しんでる姿のイラストです。\n\n【珊瑚の特徴】（参考資料あり）\n身長275センチの超大柄でむちむちとした大きなお腹を持っており、ぽっちゃり系の牝の狼獣人です。\n胸は彼女の顎よりも突き出すほどの大きな爆乳です。\n年齢は10代後半～20代前半くらいです。\n全身がピンクの毛並みに包まれており、ぱっちりとした目。瞳は赤です。\n首元から2本のリボンのようなものが伸びているのが特徴です。\n手脚は大きくしていただき獣のようなスタイルにしてください。\n無邪気で天然な性格をしていて、どんなことも楽しむポジティブ思考をしています。初めてすることも失敗を恐れずに笑顔で嬉々として楽しむことができる子です。\n\n\n【イラストのポーズと表情】\n珊瑚は楽しそうに大量の食事やお菓子を食べています。お腹や大きな胸が強調されていると嬉しいです。\n天真爛漫でどこまでも前向きなキラキラとした満面の笑みを浮かべててくれると嬉しいです。\n\nもしも可能でしたら、差分もお願いしたいです。\n珊瑚は食べすぎてお腹が膨大に膨れ上がってしまいます。\nその量の多さにさしもの珊瑚は恥ずかしそうな表情を浮かべてしまいます。\n\n【珊瑚の参考イラスト】\nhttps://www.dropbox.com/scl/fi/0b05jjg0fp290qz16c00h/1.jpg?rlkey=8c0xf0hnxnxcywaumipveral6&dl=0\n\n\n以上です。長々と書いてしまいましたが、トオノスケさんの手癖にそって描いてくれると嬉しいです。\n応援しています！よろしくお願いします。", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@krnekodr/works/28", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2672441, "client_id": 1224680, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/3a1bffd8/uploads/origins/52b52fd6-2555-4706-9502-89bffb16c380?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2e412822dc29c7ce24375770824f4ca9", "srcset": "https://si.imgix.net/3a1bffd8/uploads/origins/52b52fd6-2555-4706-9502-89bffb16c380?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2e412822dc29c7ce24375770824f4ca9, https://si.imgix.net/3a1bffd8/uploads/origins/52b52fd6-2555-4706-9502-89bffb16c380?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=0ee8280814f7c400cda441d65b63bb53 2x, https://si.imgix.net/3a1bffd8/uploads/origins/52b52fd6-2555-4706-9502-89bffb16c380?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=20c384818ae8401dc7d8b9780c75890f 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/3a1bffd8/uploads/origins/52b52fd6-2555-4706-9502-89bffb16c380?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=56343cfeafa5d7645c7e595ce8dc640a", "srcset": "https://si.imgix.net/3a1bffd8/uploads/origins/52b52fd6-2555-4706-9502-89bffb16c380?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blu