願いします。\n\nhttps://drive.google.com/drive/folders/1u7n2gDgfGARhLfSDkxhArboEKtitnqd8", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@rdml_chashi02/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3194788, "client_id": 66065, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/ffff2295/uploads/origins/80b6051e-a3a8-423a-81ae-2fd716d3abef?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7a53260db83fa006075d6607b3742681", "srcset": "https://si.imgix.net/ffff2295/uploads/origins/80b6051e-a3a8-423a-81ae-2fd716d3abef?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7a53260db83fa006075d6607b3742681, https://si.imgix.net/ffff2295/uploads/origins/80b6051e-a3a8-423a-81ae-2fd716d3abef?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=9e5230bfb2359061f39dc256bd0cebd6 2x, https://si.imgix.net/ffff2295/uploads/origins/80b6051e-a3a8-423a-81ae-2fd716d3abef?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=dfb7f3b0107d064ae4b66f80ffe20258 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/ffff2295/uploads/origins/80b6051e-a3a8-423a-81ae-2fd716d3abef?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6e3dbd7c3b4b2db7834a3b1296359699", "srcset": "https://si.imgix.net/ffff2295/uploads/origins/80b6051e-a3a8-423a-81ae-2fd716d3abef?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6e3dbd7c3b4b2db7834a3b1296359699, https://si.imgix.net/ffff2295/uploads/origins/80b6051e-a3a8-423a-81ae-2fd716d3abef?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=7c6107745c913c394aede1cbb6f5ad50 2x, https://si.imgix.net/ffff2295/uploads/origins/80b6051e-a3a8-423a-81ae-2fd716d3abef?bg=%23fff&auto=format