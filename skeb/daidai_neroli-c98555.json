図でお願いします\n・ほっぺたに絆創膏１枚\n・ケガをしてても暗くならず、以下のような照れている表情\n　‐片目ウィンク、ペロっと舌を出している、いわゆるてへぺろな表情\n\n包帯に萌えるのと、それでも可愛く元気な姿に萌えるのが個人的なポイントです。\n\nhttps://www.youtube.com/watch?v=iLDkTBdxs4w", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@daidai_neroli/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3527325, "client_id": 300145, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/6c9023ac/uploads/origins/374970de-3cec-40bf-add4-2eac8be342af?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=65fbc1415e507629adaacd8c986be006", "srcset": "https://si.imgix.net/6c9023ac/uploads/origins/374970de-3cec-40bf-add4-2eac8be342af?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=65fbc1415e507629adaacd8c986be006, https://si.imgix.net/6c9023ac/uploads/origins/374970de-3cec-40bf-add4-2eac8be342af?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=0ba2c7af0760e3c4a04b18b5dcde8831 2x, https://si.imgix.net/6c9023ac/uploads/origins/374970de-3cec-40bf-add4-2eac8be342af?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=2b6e97ab7bcd1cf78510a73be45c97c9 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/6c9023ac/uploads/origins/374970de-3cec-40bf-add4-2eac8be342af?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e0b11bd01bed4e5ea273eaad15abeafb", "srcset": "https://si.imgix.net/6c9023ac/uploads/origins/374970de-3cec-40bf-add4-2eac8be342af?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e0b11bd01bed4e5ea273eaad15abeafb, https://si.imgix.net/6c9023ac/uploads/origins/374970de-3cec-40bf-add4-2eac8be342af?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=096126fd3ca88b4659fce1788c4e80a2 2x, https://si.