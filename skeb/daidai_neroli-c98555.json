re": true}, {"path": "/@daidai_neroli/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3527325, "client_id": 2653440, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/980b1c24/uploads/origins/51d8a312-edbf-4839-ac92-81e5edbc2999?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4057ba591b02c3ed964425097b53e80b", "srcset": "https://si.imgix.net/980b1c24/uploads/origins/51d8a312-edbf-4839-ac92-81e5edbc2999?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4057ba591b02c3ed964425097b53e80b, https://si.imgix.net/980b1c24/uploads/origins/51d8a312-edbf-4839-ac92-81e5edbc2999?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=15690159bb0848dc98fb1c2a052330a4 2x, https://si.imgix.net/980b1c24/uploads/origins/51d8a312-edbf-4839-ac92-81e5edbc2999?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c684969bd25bd2abb42afbada791273b 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/980b1c24/uploads/origins/51d8a312-edbf-4839-ac92-81e5edbc2999?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=324bb64d7e04b88f38131430c8f2e578", "srcset": "https://si.imgix.net/980b1c24/uploads/origins/51d8a312-edbf-4839-ac92-81e5edbc2999?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=324bb64d7e04b88f38131430c8f2e578, https://si.imgix.net/980b1c24/uploads/origins/51d8a312-edbf-4839-ac92-81e5edbc2999?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=14305f672cd38311e88c7c0a00d8e7c5 2x, https://si.imgix.net/980b1c24/uploads/origins/51d8a312-edbf-4839-ac92-81e5edbc2999?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=407c226bdf87d1706cc5d1c7b5fee091 3x"}, "body": "橙様\nはじめまして。Vtuberの桃瀬とわると申します。\n配信のサムネイラストを描いていただける方を探しているときに、橙様のイラストを拝見し、ぜひお願いしたいと思いご連絡させていただきました。\nお手数ですが、下記内容ご確認いただけます様お願いいたします。\n\n・使用用途\n配信サムネイル用（NIKKE)\n\n・ポーズ\nNIKKE用で使用したいため、銃を持っていると助かります。(銃はどんなものでも大丈夫です）\n外見の資料につてはURLの資料からご確認いただければと存じます。\nメイド服と私服がありますので、お好きなほうで描いていただけますと幸いです。\n\n・その他\nキャラクターのみで使用する場合がございますので、可能であれば\n背景あり、背景なし（背景透過）、もしくはPSDのデータでいただけますと大変助かります。\n\nお忙しいところ恐れ入りますが、\nご検討のほど、何卒よろしくお願いいたします。\n\nhttps://drive.google.com/file/d/1-Gc1-EGLLV79_sp40O16ZJfozNIu5lVr/view?usp=sharing\n\nhttps://drive.google.com/drive/folders/1Ia6KrEZQsQ3RcqsOaLF5neWjR4xNe0E3?usp=sharing", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@daidai_neroli/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3527325, "client_id": 2993640, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/c9c5f122/uploads/origins/cd039788-aa66-4577-a70e-ef504a6c080c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6b174b4b7f498d3cb2ac287868ac94fc", "srcset": "https://si.imgix.net/c9c5f122/uploads/origins/cd039788-aa66-4577-a70e-ef504a6c080c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6b174b4b7f498d3cb2ac287868ac94fc, https://si.imgix.net/c9c5f122/uploads/origins/cd039788-aa66-4577-a70e-ef504a6c080c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=952593bc17497e4ee607b70f89b73fac 2x, https://si.imgix.net/c9c5f122/uploads/origins/cd039788-aa66-4577-a70e-ef504a6c080c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a6417c33425539218f14e327bfd8c62d 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/c9c5f122/uploads/origins/cd039788-aa66-4577-a70e-ef504a6c080c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=7b810a6cf2a860252d324700f08ba8a7", "srcset": "https://si.imgix.net/c9c5f122/uploads/origins/cd039788-aa66-4577-a70e-ef504a6c080c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=7b810a6cf2a860252d324700f08ba8a7, https://si.imgix.net/c9c5f122/uploads/origins/cd039788-aa66-4577-a70e-ef504a6c080c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=ef3a85f8c63aab6a748d5b60ed2358d3 2x, https://si.imgix.net/c9c5f122/uploads/origins/cd039788-aa66-4577-a70e-ef504a6c080c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=a2afcfc76658014f0f04908b716d7b79 3x"}, "body": "橙 | Tohka先生はじめまして！Vtuberとして活動しております、シンドーナナイロと申します。\n先生のイラストを拝見し、今回依頼させていただきたいと思い立ちました！お忙しいところ恐縮ですが、ご一考のほどよろしくお願いいたします。今回は配信のサムネイルとしての使用を前提として、私、シンドーナナイロのイラストを描いていただきたいと思っております。\n　\n【概要】\n配信用のサムネイル用イラストを希望します。\n当該配信は今後も収益化を行いません、また使用の際には概要欄に先生のお名前を記載させていただければと思います。これらを含めた条件に問題がある場合は気兼ねなく依頼を断っていただければと思います！\n　\n銃を構えた、もしくは携えたシンドーナナイロを描いて頂きたいです。\n服装は普段の黒セーラー服を希望します。人物のポーズについてはお任せします。また、背景に関しては簡単なものでもかまいません、お任せいたします。可能であれば人物と背景を分けたバージョンもいただければとてもありがたいです！\nEscape from Tarkovというゲームの実況配信サムネイルへの使用を想定しています。描いて頂く銃器に関してはどのような種類でも構いません、同ゲームに登場する銃器を参考にしていただけたら嬉しいです！\n\n背景まで含めた依頼ということで、料金に不足がある場合お伝えいただければ対応いたします。\n\n【使用用途】\n・Xへの投稿\n・youtubeでの配信サムネイルや動画への使用\n(使用の際は先生のお名前を表記させていただきます）\n\nご検討よろしくお願いいたします！\n\nhttps://drive.google.com/drive/folders/1daDNr9VZ9_VXN1ZEd3uuEwFtcQI9wX61\n\nhttps://drive.google.com/drive/folders/1daDNr9VZ9_VXN1ZEd3uuEwFtcQI9wX61", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@daidai_neroli/works/4", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/2f52d8f4/uploads/origins/7b4bf362-23a5-4b09-adbe-5d3a21a41728?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=6e1076ac5e5d920afc33102d41e98fc3", "srcset": "https://si.imgix.net/2f52d8f4/uploads/origins/7b4bf362-23a5-4b09-adbe-5d3a21a41728?bg=%23fff&auto=format%2Ccompress