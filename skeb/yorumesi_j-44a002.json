be6e-e27ddafeb375?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=75296a7d865dc091574dbe594f87e2aa", "srcset": "https://si.imgix.net/07286e77/uploads/origins/7b7cf16f-0925-42fe-be6e-e27ddafeb375?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=75296a7d865dc091574dbe594f87e2aa, https://si.imgix.net/07286e77/uploads/origins/7b7cf16f-0925-42fe-be6e-e27ddafeb375?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=2df77a564a958fe56d5393be4ad75056 2x, https://si.imgix.net/07286e77/uploads/origins/7b7cf16f-0925-42fe-be6e-e27ddafeb375?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=f93e1783352badc20a75eb7d894f67a8 3x"}, "body": "こんにちは、あなたのアートスタイル、すごく好きです！ \n\nアービターは、できる限り善行や慈善活動に尽力しようとする自警団員です。彼は対人関係の核心となるスキルに重点を置き、善良な人間であろうと努めていますが、その姿勢は、道徳的・名誉的・礼儀正しい方法ではなく、「より楽な」方法で物事を進めようとする他の人々の理想としばしば衝突してしまいます。 それにもかかわらず、彼が下すあらゆる選択には、それが正しいか間違っているかにかかわらず、何らかの結果が伴うように見えるにもかかわらず、彼は前進し続け、耐え抜いています。\n\nこれは、私が披露したいと思っている新しい衣装のためのものです。できればハーフフェイスマスクのバージョンが望ましいですが、もしハーフフェイスマスクとフルフェイスマスクの両方を組み合わせたバージョンも描いていただけたら、大変ありがたいです。  \n\n可能であれば、16:9の構図でお願いします。Twitterに投稿されたサンジのアートで、彼が視点を下に見下ろしているアングルが気に入りましたが、ポーズは自由にお選びください。SkebやTwitterの最近の投稿で見られる、あなたの配色のセンスが大好きです。 背景については、街並みの背景にしていただいてもいいですが、それはお任せします。サンジの雰囲気は、集中していて決意に満ちたものです。\n\nhttps://imgur.com/gallery/arbitervt-reference-P8V5HIC", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@yorumesi_j/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 4014003, "client_id": 4071356, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/b65d3614/uploads/origins/f98d4968-71f3-41cf-b0ee-6316386e5b6c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=77f8f18246500cb419edab32afed08a7", "srcset": "https://si.imgix.net/b65d3614/uploads/origins/f98d4968-71f3-41cf-b0ee-6316386e5b6c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=77f8f18246500cb419edab32afed08a7, https://si.imgix.net/b65d3614/uploads/origins/f98d4968-71f3-41cf-b0ee-6316386e5b6c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=730da6e25142f19e8d2ea00eb0184efe 2x, https://si.imgix.net/b65d3614/uploads/origins/f98d4968-71f3-41cf-b0ee-6316386e5b6c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d074df4358e8042a7477854629899a4e 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/b65d3614/uploads/origins/f98d4968-71f3-41cf-b0ee-6316386e5b6c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e339db863b7c511a8427da7bcd3723bf", "srcset": "https://si.imgix.net/b65d3614/uploads/origins/f98d4968-71f3-41cf-b0ee-6316386e5b6c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e339db863b7c511a8427da7bcd3723bf, https://si.imgix.net/b65d3614/uploads/origins/f98d4968-71f3-41cf-b0ee-6316386e5b6c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=b5120625690afe34055ff8cffb3960ae 2x, https://si.imgix.net/b65d3614/uploads/origins/f98d4968-71f3-41cf-b0ee-6316386e5b6c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=549f51872a1678a0b094c5ead2491ff0 3x"}, "body": "あなたの絵の彩色スタイルが大好きなので、私のキャラクターのイラストを描いてほしいです！！\n\nキャラクターの左側の腐食部分から、炎のような火花や炎が飛び出している様子を描いてほしいです。まるで左腕から何かを放とうとしているように見えるので。\n\n背景の時間帯は夜にしてください。血の月のように、月は赤く染まっています。\n\n彼は背筋を伸ばして自信に満ちた姿で、左腕を前に突き出して呪文を唱えています。それ以外はあなたにお任せします。頑張ってください！きっと素敵な作品になると思います！！\n\nhttps://imgur.com/a/quads-oc-uJotANP", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@yorumesi_j/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 4014003, "vtt_url": null, "thumbnail_image_