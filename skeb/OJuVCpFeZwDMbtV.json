97352#big_22)\n\n台詞や擬音等の吹き出しの有無はお任せします\n(あってもなくてもどちらでも構いません)\nよろしくお願い致します", "nc": 41, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@OJuVCpFeZwDMbtV/works/2", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/17decda1/uploads/origins/fd5978a0-abe7-499a-aaee-f4e06f85c224?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=11d36c3b6615f225b7c042db9c7beb81", "src_set": ""}, "private": true, "genre": "art", "tipped": false, "creator_id": 3097590, "client_id": 1691003, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 160, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@OJuVCpFeZwDMbtV/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3097590, "client_id": 0, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/778e5f28/uploads/origins/e5525acc-9e48-4f84-a60f-ed8f865bad67?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d9b7a4b4c9b76b46802c3dd370adeca2", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/778e5f28/uploads/origins/e5525acc-9e48-4f84-a60f-ed8f865bad67?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=91984b6c6ebcb3f8d35ddea03946fd80", "src_set": ""}, "body": "募集開始と聞いて飛んできました。\nもし２キャラの構図が可能でしたら、資料URLの作品を参考に「W乳首舐め手コキ主観視点」の作品を、以下のようにお願いしたいです。\n\n【キャラ】\nずんだもん、月読アイ\n【シチュエーション】\n資料URLの作品ように、２人に添い寝されて挟まれるような格好で、左右から乳首舐め+手コキをされているのを、主観視点で見ている構図\n他の方の作品引用ですいませんが、視点はこちらの作品（https://skeb.jp/@ikn_wdr/works/24）のようなイメージです\n【詳細】\n・２人とも全裸\n・２人とも、乳首とペニスをいじめながら、反応を楽しむようにじーっとこちらを見つめている\n・ずんだもんは「れろぉ～♥」と見せつけるように舌を出して乳首を舐め上げ、ペニスを握ってしごいている\n・アイは乳首に吸い付き「あむあむ♥」と