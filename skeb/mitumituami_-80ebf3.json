003, "client_id": 235785, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/53556977/uploads/origins/b7052e16-0421-4130-967e-8daca2956a9b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6c7abe1ce8258849c4fc92dff93a949a", "srcset": "https://si.imgix.net/53556977/uploads/origins/b7052e16-0421-4130-967e-8daca2956a9b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6c7abe1ce8258849c4fc92dff93a949a, https://si.imgix.net/53556977/uploads/origins/b7052e16-0421-4130-967e-8daca2956a9b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=34a879e861904d26b27f319a9589e492 2x, https://si.imgix.net/53556977/uploads/origins/b7052e16-0421-4130-967e-8daca2956a9b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d048e6ed2d55745f70c17c24eafcc5db 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/53556977/uploads/origins/b7052e16-0421-4130-967e-8daca2956a9b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e714bf59ec9f7b78d5d15f678bcf8e77", "srcset": "https://si.imgix.net/53556977/uploads/origins/b7052e16-0421-4130-967e-8daca2956a9b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e714bf59ec9f7b78d5d15f678bcf8e77, https://si.imgix.net/53556977/uploads/origins/b7052e16-0421-4130-967e-8daca2956a9b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=15149596409fb0264480b03f2447b169 2x, https://si.imgix.net/53556977/uploads/origins/b7052e16-0421-4130-967e-8daca2956a9b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=f516df1b443cee5ffbb30810e0c3e71b 3x"}, "body": "初めまして、リョナ絵に興味があるため、リクエストよろしくお願いします。\n\n天崎涼子の首吊りイラストを描いてください。\nこんな感じの首吊りで苦しんでいるイラストを描いてください。\n\nhttps://www.pixiv.net/artworks/104951756\n\n要望として、手と足は縄で縛らないでいただき、足を含めた全身を描いてください。\n差分で全裸版も描いてください。\n背景は廃墟ビルの一室という感じにしてください。\n\nご検討のほど、よろしくお願いします。", "nc": 40, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@mitumituami_/works/1", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/eca10eea/uploads/origins/a8acfd86-6d2a-4bf7-b61f-c5beff70a70f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=56d0b2dbc0530f5156a3f0a3f0ba07d7", "srcset": "https://si.imgix.net/eca10eea/uploads/origins/a8acfd86-6d2a-4bf7-b61f-c5beff70a70f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=56d0b2dbc0530f5156a3f0a3f0ba07d7, https://si.imgix.net/eca10eea/uploads/origins/a8acfd86-6d2a-4bf7-b61f-c5beff70a70f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=1687f36039bd246c4438f7e6a83a2b75 2x, https://si.imgix.net/eca10eea/uploads/origins/a8acfd86-6d2a-4bf7-b61f-c5beff70a70f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=bf1c77a33d84c599647f57e775291139 3x"}, "private": true, "genre": "art", "tipped": true, "creator_id": 828003, "client_id": 223164, "nc": 32}], "sent_works": [], "similar_creators": [{"id": 177842, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "hOi たおさんです＠skeb再開", "screen_name": "tao_5757", "avatar_url": "https://pbs.twimg.com/profile_images/1384099124459413506/CYqh_w3J.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1170539519424131073/1691160062/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "acc