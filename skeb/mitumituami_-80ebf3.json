=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=476eba3d2ddcc10684fa6550f73e76e6 2x, https://si.imgix.net/764730cf/uploads/origins/4473a223-f2df-47fc-b430-1a8b733fcf3d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=d011f93267103d55ed56fe41f49b7ef1 3x"}, "body": "お久しぶりです。前回はありがとうございました。今回もよろしくお願いします。\n\n今回はアニポケのリコの首吊りを描いてください。\nhttps://pbs.twimg.com/media/FviJZGzaUAE2YjO?format=jpg&name=large\n\n要望\n前回と同じようなイラストにしてください。\n今回も手と足は縄で縛らないでいただき、足を含めた全身を描いてください。\n 差分で全裸版も描いてください。\n背景は森の中で木に吊るしてください。\n\nhttps://skeb.jp/@mitumituami_/works/2\n\nご検討のほど、よろしくお願いします。", "nc": 48, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@mitumituami_/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 828003, "client_id": 335896, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/f932dca8/uploads/origins/57f64aa3-f2ee-40b3-844e-23502db3bdd3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d4a8142bba01188e2db8ce440635c39f", "srcset": "https://si.imgix.net/f932dca8/uploads/origins/57f64aa3-f2ee-40b3-844e-23502db3bdd3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d4a8142bba01188e2db8ce440635c39f, https://si.imgix.net/f932dca8/uploads/origins/57f64aa3-f2ee-40b3-844e-23502db3bdd3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=d81b816ab71604af8683ed99832f8c45 2x, https://si.imgix.net/f932dca8/uploads/origins/57f64aa3-f2ee-40b3-844e-23502db3bdd3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=57cb250d0431a971ab757f509cfb505f 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/f932dca8/uploads/origins/57f64aa3-f2ee-40b3-844e-23502db3bdd3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d71e1d38f34bcfe1fe6cb6378523b6c9", "srcset": "https://si.imgix.net/f932dca8/uploads/origins/57f64aa3-f2ee-40b3-844e-23502db3bdd3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d71e1d38f34bcfe1fe6cb6378523b6c9, https://si.imgix.net/f932dca8/uploads/origins/57f64aa3-f2ee-40b3-844e-23502db3bdd3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=c35e89c35b8cb7561e5f8bf4fcc6deea 2x, https://si.imgix.net/f932dca8/uploads/origins/57f64aa3-f2ee-40b3-844e-23502db3bdd3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=aa6e761a1e5a923f672972e2858faedc 3x"}, "body": "◯キャラクター\nマルタ(Fate/Grand Order)\nhttps://img.gamewith.jp/article_tools/fatego/gacha/ascension_030_1.jpg\nhttps://img.gamewith.jp/article_tools/fatego/gacha/ascension_135_2.jpg\n\n◯シチュエーション\nモンスターに孕み袋にされているBADEND的なシチュエーションをお願いします。\n・四肢切断され、孕んでボテ腹状態で犯されている\n・休みなく妊娠出産させられ続けて精神崩壊しており、レイプ目で涙を流していて魂の抜けた抜け殻のようになってしまった様子\n・服装はおまかせ、肌露出多めを希望(全裸歓迎)\n・おっぱい、乳輪、乳首大きめを希望(https://skeb.jp/@mitumituami_/works/2 こちらの作品くらいのサイズ感)、陥没乳首NG\n・モンスターの外見についてはエルダーグール(https://fategrandorder.fandom.com/wiki/Elder_Ghoul)を希望しますが、描くのが大変であれば外見はおまかせします(原作にいないモンスターでもOK)。モンスターの全身を描写する必要はなく、見切れた簡素な描写で構いません", "nc": 56, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@mitumituami_/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 828003, "client_id": 223164, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/bbc0f73d/uploads/origins/8ce6415d-06b9-47e2-86e6-424bcf8ffbe7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2c18c8e21b8b9545a8312a30c9086596", "srcset": "https://si.imgix.net/bbc0f73d/uploads/origins/8ce6415d-06b9-47e2-86e6-424bcf8ffbe7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2c18c8e21b8b9545a8312a30c9086596, https://si.imgix.net/bbc0f73d/uploads/origins/8ce6415d-06b9-47e2-