もらって構いません\n前回のがとても気に入りましたので在原様のデザインで、いじってもらえたら嬉しいです\n\n前回の子と違う聖属性\n資料の子が救世主の器になる儀式で器となり(状態変化)となったわけですが\n\nこうなると、世を救うだけの存在になり\n人の被害など関係なく、世界に敵体すると判断したものを消し去るまで戦う  \nその際の性格はシステム的かつ、次元の違う生き物の見下したような高圧的な感じ \n 今までこの宿してきた者の技術・知恵を使える\n前回依頼した子と戦った事がありますが、今は仲良く暮らしてます\n\nわかりづらい様でしたら抑えて欲しいポイントさえ抑えてもらえれば\n在原様の自由にやられて構いません\nPSD切り替え等でサイン等ON/OFFできると嬉しいです\nよろしくお願いします\nよろしくお願いします\n\nhttps://drive.google.com/drive/folders/1-16aziN1rfbsj7P8UtveL2HWPFc9vui9", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@a_hara888/works/8", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1224284, "client_id": 1157610, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/564b446b/uploads/origins/26147fc4-5ed2-401a-8bb6-388a85122184?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8390d7c7f94cd4055fde9cf17183e366", "srcset": "https://si.imgix.net/564b446b/uploads/origins/26147fc4-5ed2-401a-8bb6-388a85122184?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8390d7c7f94cd4055fde9cf17183e366, https://si.imgix.net/564b446b/uploads/origins/26147fc4-5ed2-401a-8bb6-388a85122184?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=9a0b8ea0d2d15df056b37095713ccec9 2x, https://si.imgix.net/564b446b/uploads/origins/26147fc4-5ed2-401a-8bb6-388a85122184?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=23d9138626a2a865e806e70000a2dd94 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/564b446b/uploads/origins/26147fc4-5ed2-401a-8bb6-388a85122184?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a0dcb304b710d13531fd8afa40927cd7", "srcset": "https://si.imgix.net/564b446b/uploads/origins/26147fc4-5ed2-401a-8bb6-388a85122184?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a0dcb304b710d13531fd8afa40927cd7, https://si.imgix.net/564b446b/uploads/origins/26147fc4-5ed2-401a-8bb6-388a85122184?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=5831bcfeae44b33008fe0d7db8d66a7c 2x, https://si.imgix.net/564b446b/uploads/origins/26147fc4-5ed2-401a-8bb6-388a85122184?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=e85b26d2189e2124d5ef47e118e70aea 3x"}, "body": "こんにちは、ツイッターであなたの作品を拝見しましたが、とても美しいですね。私の作品もお願いしたいと思っています。\n\n白髪は悪魔ですが、とてもエレガントで、よく笑っています。黒髪はハンターでとても真面目です。二人は敵同士ですが、カップルなので、両方描いてもいいし、片方だけ選んでもいいです。\n\n自由に描いていただいて構いませんので、よろしくお願いします。ありがとうございました。\n\nhttps://drive.google.com/drive/folders/14FnkpKBwkJH5linwAaS8ueydj7lUQeGM?usp=sharing", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@a_hara888/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1224284, "client_id": 667554, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/16fe9201/uploads/origins/65164730-1327-43cc-9e36-58b7d4d96771?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=cfc943cdc60faf296a2d094f85c7aca4", "srcset": "https://si.imgix.net/16fe9201/uploads/origins/65164730-1327-43cc-9e36-58b7d4d96771?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=cfc943cdc60faf296a2d094f85c7aca4, https://si.imgix.net/16fe9201/uploads/origins/65164730-1327-43cc-9e36-58b7d4d96771?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=6ea1527d4a0533aedf669cdd60b179dd 2x, https://si.imgix.net/16fe9201/uploads/origins/65164730-1327-43cc-9e36-58b7d4d96771?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=eb67c5cdfe8afa595968e3c4ccd93484 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/16fe9201/uploads/origins/6516