fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=eb495206f2f580154c364be9fd52257b 2x, https://si.imgix.net/cb21b7a4/uploads/origins/f8a5c27b-d5ec-4aad-aa33-340bf7055186?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=1f15824ea9369187a9ed2c9d96582194 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/cb21b7a4/uploads/origins/f8a5c27b-d5ec-4aad-aa33-340bf7055186?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=518ca9f547cd0d51b749edf5bfdb4b02", "srcset": "https://si.imgix.net/cb21b7a4/uploads/origins/f8a5c27b-d5ec-4aad-aa33-340bf7055186?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=518ca9f547cd0d51b749edf5bfdb4b02, https://si.imgix.net/cb21b7a4/uploads/origins/f8a5c27b-d5ec-4aad-aa33-340bf7055186?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=21c2cee514fe59ed45183067de15bdbe 2x, https://si.imgix.net/cb21b7a4/uploads/origins/f8a5c27b-d5ec-4aad-aa33-340bf7055186?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=7e3ecad6552a13e0d0a0d47d1028109b 3x"}, "body": "はじめまして！新着から素敵なコミックを拝見して一目惚れしましてリクエストの方失礼させていただきましたㅠㅠ！\n拙い文章と資料で大変恐縮ですがお手隙の際にご検討頂けましたら幸いです。\n\n┊ご依頼内容┊\n\n✦︎資料先の創作BL2名のコミックをお願いさせていただきたいです。\n内容や服装等全ておまかせします。\nご自由に描いていただけたら嬉しいです。\n(NGは黒髪のほくろ忘れ、茶髪のピアス忘れ程度です🙇🏻‍♀️)\n\n✦︎もしストーリー悩ませてしまう場合、\n甘々な話、茶髪が赤面するような話、少し重たい雰囲気の話、黒髪が茶髪にたくさん世話を焼いてもらうような話\n等だと嬉しいです。\n(もちろんフルおまかせ希望なので無視して頂いても構いません！)\n\n✦︎資料には色々と記載しておりますが解釈違い等深く気にしておりませんので、先生の解釈やスタイルでご自由に遊んで頂けたらとても嬉しいです。\n料金不足の場合お手数おかけしますが再送要請して頂けましたら幸いです。\n好みの内容でなければお気軽にキャンセルして頂いて構いません🙇🏻‍♀️\nご検討のほどよろしくお願いします。\nご確認くださり誠にありがとうございました！\n\n\n✦︎以下は資料要約です。\n読み飛ばして頂いて構いません🙇🏻‍♀️\n\n┊攻め┊風見帆希(黒髪)\n仮面優等生、無気力、生意気\nモチーフ熱帯夜(サブモチーフ夏、風)\n┊受け┊城月煌(茶髪)\n勤勉、世話焼き、人気者\nモチーフ月(サブモチーフ秋)\n\n・雪月風花の\"夏の風\"と\"秋の月\"からとった2人です。\n・高校生、付き合っていません。\n・受けが唯一の心の支えの甘えたがりな後輩攻めと、精神的に追い詰められながら過ごしている攻めに目を離せない世話焼き先輩受けです。\n\nhttps://drive.google.com/drive/folders/1-6AuIBjoRp5pCYKQfrG3gqfNBZVYvjIz", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@96ka3hshs/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 93700, "client_id": 3396404, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/92d6fafc/uploads/origins/2b620864-9a90-4eed-9140-debd31a44d0e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1115a7a80616d484a011a36d9438d934", "srcset": "https://si.imgix.net/92d6fafc/uploads/origins/2b620864-9a90-4eed-9140-debd31a44d0e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1115a7a80616d484a011a36d9438d934, https://si.imgix.net/92d6fafc/uploads/origins/2b620864-9a90-4eed-9140-debd31a44d0e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=122a521cc24991cd1ee4b53cc4b88910 2x, https://si.imgix.net/92d6fafc/uploads/origins/2b620864-9a90-4eed-9140-debd31a44d0e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=cf6f2bfa8a6c83711c69fc0812b1fb18 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/92d6fafc/uploads/origins/2b620864-9a90-4eed-9140-debd31a44d0e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=db164b545ad894651c56ea6464053863", "srcset": "https://si.imgix.net/92d6fafc/uploads/origins/2b620864-9a90-4eed-9140-debd31a44d0e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=db164b545ad894651c56ea6464053863, https://si.imgix.net/92d6fafc/uploads/origins/2b620864-9a90-4eed-9140-debd31a44d0e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=892b9019166a330ed62093c609308ad6 2x, https://si.imgix.net/92d6fafc/uploads/origins/2b620864-9a90-4eed-9140-debd31a44d0e?bg=%23fff&auto=format