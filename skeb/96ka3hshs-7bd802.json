がありますので、ぜひご覧ください！\n\nご依頼をご検討いただき誠にありがとうございます。必要に応じて金額の調整も遠慮なくお願いいたします！\n\nhttps://drive.google.com/drive/folders/1LC9wogOPoynA-kD3QH82fN1uxj9FOrWx?usp=sharing", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@96ka3hshs/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "comic", "tipped": true, "creator_id": 93700, "client_id": 2545687, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/f895f9f5/uploads/origins/18906774-b18b-445b-b37f-32b220b41aec?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d701a09eb37290505babcc0a322f6601", "srcset": "https://si.imgix.net/f895f9f5/uploads/origins/18906774-b18b-445b-b37f-32b220b41aec?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d701a09eb37290505babcc0a322f6601, https://si.imgix.net/f895f9f5/uploads/origins/18906774-b18b-445b-b37f-32b220b41aec?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b86a049bac239e89f01ba91f89931695 2x, https://si.imgix.net/f895f9f5/uploads/origins/18906774-b18b-445b-b37f-32b220b41aec?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a171da45297fd60acf8020c18f602c49 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/f895f9f5/uploads/origins/18906774-b18b-445b-b37f-32b220b41aec?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=1b74e197d75892c91a58f582b2af1682", "srcset": "https://si.imgix.net/f895f9f5/uploads/origins/18906774-b18b-445b-b37f-32b220b41aec?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=1b74e197d75892c91a58f582b2af1682, https://si.imgix.net/f895f9f5/uploads/origins/18906774-b18b-445b-b37f-32b220b41aec?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=d2ffb0631988a01bba58132d65b6fd05 2x, https://si.imgix.net/f895f9f5/u