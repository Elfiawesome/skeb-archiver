んか？2～3ページほど描いていただけると最高ですが、もちろんご自由に描いていただいて構いません。\n\n金額を変更することもできます\n\nhttps://drive.google.com/drive/folders/1IMIlL4OdPnNkqdXw81DI7H4Vo4I-f72i", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@96ka3hshs/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "comic", "tipped": false, "creator_id": 93700, "client_id": 2977687, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/894eeb35/uploads/origins/a0e7ab3f-1f2a-40ba-873b-ea5607cd88b2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a338adcad6ac82075530117329ad2ef5", "srcset": "https://si.imgix.net/894eeb35/uploads/origins/a0e7ab3f-1f2a-40ba-873b-ea5607cd88b2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a338adcad6ac82075530117329ad2ef5, https://si.imgix.net/894eeb35/uploads/origins/a0e7ab3f-1f2a-40ba-873b-ea5607cd88b2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=d37ee4e6a7709970879a8d4f23f47eb7 2x, https://si.imgix.net/894eeb35/uploads/origins/a0e7ab3f-1f2a-40ba-873b-ea5607cd88b2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=7382b9fca7b2991d0fa2c825effc468b 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/894eeb35/uploads/origins/a0e7ab3f-1f2a-40ba-873b-ea5607cd88b2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f0871981b90b88e318e31ab15caa786d", "srcset": "https://si.imgix.net/894eeb35/uploads/origins/a0e7ab3f-1f2a-40ba-873b-ea5607cd88b2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f0871981b90b88e318e31ab15caa786d, https://si.imgix.net/894eeb35/uploads/origins/a0e7ab3f-1f2a-40ba-873b-ea5607cd88b2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=604f35644ea0c44cf53bd2fb992e62f3 2x, https://si.imgix.net/894eeb35/uploads/origi