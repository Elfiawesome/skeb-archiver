n・同厩舎の女の子（ポニー・人間だと10代くらい）のことを何かと気にかけてるが\n　相手には煙たがられている。\n・若く見えるほうだが、おじさん扱いされることを少し気にしている\n\nその他参考画像\nhttps://twitter.com/F11_L23/status/1543926083506294784\nhttps://twitter.com/Takenoko_gohane/status/1566750700247613440 （2枚目）\n\nhttps://twitter.com/F11_L23/status/1584156909720211462", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@_yakou_/works/12", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 12495, "client_id": 1232524, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/35e36269/uploads/origins/e5926d71-0ca1-4855-b3ec-2714b145d1a9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1f99d70301d670f882a55e07dc71422c", "srcset": "https://si.imgix.net/35e36269/uploads/origins/e5926d71-0ca1-4855-b3ec-2714b145d1a9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1f99d70301d670f882a55e07dc71422c, https://si.imgix.net/35e36269/uploads/origins/e5926d71-0ca1-4855-b3ec-2714b145d1a9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=4b8ecea3aecd8176f5ac2b3721652962 2x, https://si.imgix.net/35e36269/uploads/origins/e5926d71-0ca1-4855-b3ec-2714b145d1a9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=df3a2f22e43e0c6ac4e93728b9497f23 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/35e36269/uploads/origins/e5926d71-0ca1-4855-b3ec-2714b145d1a9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=22a38a5f5324f6883e4f1a632c82db34", "srcset": "https://si.imgix.net/35e36269/uploads/origins/e5926d71-0ca1-4855-b3ec-2714b145d1a9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=22a38a5f5324f6883e4f1a632c82db34, https://si.imgix.net/35e36269/uploads/origins/e5926d71-0ca1-4855-b3ec-2714b145d1a9?bg=%23fff&auto=format%2Ccompress