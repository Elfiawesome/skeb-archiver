origins/41e0be56-8c32-4de1-beda-8eb312e04171?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=97b14f6f1da58b4a3445cdf659a774ae", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/4b37cb36/uploads/origins/41e0be56-8c32-4de1-beda-8eb312e04171?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=62060394ed3a13fed057bb58cc683c75", "src_set": ""}, "body": "こんにちは！\n\nお元気ですか？「夫婦以上、恋人未満」の渡辺明里と桜坂詩織のリクエストをお願いします。\nhttps://www.deviantart.com/stash/21snfngfq71f\n\nこの https://www.deviantart.com/stash/0fubif16wpd のような下着を着けてほしいです。明里はピンクで黒のディテール、詩織は黄色です。服は下/横に引っ張られて胸と膣が露出しています。\n\nこの画像と同じ状況で、詩織が左、明里が右にいるようにしてほしいです。レイプされた後、二人ともベッドの上でぐったり疲れ果てており、股間からは精液が滴り、ベッドには複数の玩具とバイブレーターが置かれている。\nhttps://www.deviantart.com/stash/0satqy0uimy\n\n二人とも首輪を付けられ、怯えて泣いているような表情をしている。\n\nあまり無理なお願いではないといいのだが。", "nc": 57, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@ohguro_mariya/works/138", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 744286, "client_id": 0, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/e28551b9/uploads/origins/97725e6c-d5b4-4ae8-8063-ae957968d873?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d937f716c7bff12b836389131b0033f9", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/e28551b9/uploads/origins/97725e6c-d5b4-4ae8-8063-ae957968d873?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f50635d7562a748885d206db90ee2748", "src_set": ""}, "body": "はじめまして。\n大黒です様にVtuberの紫月かなでさん(https://X.com/kanade_shizuki）のイラスト制作をお願いしたいです。\n\n\n【イラスト詳細】\n・紫月かなで\n・見せつけエッチ\n・陰毛などは解釈違いなので不要\n・おっぱいは大きめでムチムチさせて欲しいです。\n・精液が垂れていると嬉しいです\n\n全身資料\nhttps://downloads.fanbox.cc/images/post/4356974/P2tOKpMz7F1tdFQyv5rHcJPv.png\nキャラクターだけの背景透過画像も頂ければ幸いです。\n\n【使用用途】\n・個人鑑賞\n・FAとして贈りたいので以下の利用を彼女が出来るようにしてほしいです。\n※本人が使用するかは別ですが\n　★Twitter等のSNSへの掲載\n　★YouTube等のサムネイルへの利用\n\n\n\n紫月さんのFA作品に対するガイドラインはこちらになっています。\nhttps://kanadeshizuki.fanbox.cc/manage/posts/3551466\nお忙しいところ大変恐縮ですが何卒ご検討のほどよろしくお願いします。", "nc": 32, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@ohguro_mariya/works/137", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 744286, "client_id": 0, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/5657e889/uploads/origins/f04816b6-0b9d-49f5-802c-d05b4e245f72?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2a54542df484f7f197b1d3ee7862479a", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/5657e889/uploads/origins/f04816b6-0b9d-49f5-802c-d05b4e245f72?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=cfc47cf415d160479b689f5a5373c0e2", "src_set": ""}, "body": "よろしければリクエストお願いします\n\nキャラ：艦これ　ワシントン\nコスチューム：埼玉鎮守府コラボのときの私服\nhttps://i.imgur.com/LhjUaOX.jpg\n\nシチュエーション\n外でムラムラきてしまったので駅弁姿勢で挿入してセックスしているシーンをお願いします。背景、竿役は特に指定ありません。\n体位は下記みたいな後ろで足を組む駅弁でお願いいたします。　↓\nhttps://ibb.co/6Rh6264T\n\n服は着たまま、ブーツは履いたまま、胸だけだしてズボンのチャックを下ろしてそこに挿入するような感じでお願いいたします。\n可能であれば攻めているときと、絶頂時の差分あるとうれしいです。\n\nご検討のほどよろしくお願いします。", "nc": 48, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@ohguro_mariya/works/136", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/5dcacf2d/uploads/origins/f418bc81-a7a7-4fc8-b3fa-a12ea4e7ae00?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=d1bd6cd80b0aa90326fc4e798474bf75", "src_set": ""}, "private": true, "genre": "art", "tipped": true, "creator_id": 744286, "client_id": 2063185, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 160, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@ohguro_mariya/works/135", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 744286, "client_id": 0, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/712ca713/uploads/origins/e7fee134-745d-43cc-9329-12265b60fb64?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ab3484ecf673fadbcbf955a468016bfa", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/712ca713/uploads/origins/e7fee134-745d-43cc-9329-12265b60fb64?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=4f6ef302f6194fad6fe79e11527e4990", "src_set": ""}, "body": "はじめまして\nアクアの作品大好きです\nURL参照\nこのすばのアクアが巨根の色黒男子に69ポーズで座っているのを描いてください。後ろから見ても前から見てもお尻が見えるパネル付きで。\nフェラチオをしたり、マンコやアナルを舐められたり拝まれたりして射精しているところ。\n胸が露わになり、白い太ももでノーパンの普段着姿。\n汗だくで、湯気が立ち、愛液が溢れている。\nお好みに合わせて自由に調整してください。\n背景は何でも結構です。\nありがとうございました。\n\nhttps://catbox.moe/c/zeuqta", "nc": 32, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@ohguro_mariya/works/134", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/5ef4b4fd/uploads/origins/1109ef20-e5b8-4efe-945d-c2b0a0a673be?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=bf44a5130b72c3b619b7a2141cc48f48", "src_set": ""}, "private": true, "genre": "art", "tipped": false, "creator_id": 744286, "client_id": 1369057, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 49, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@ohguro_mariya/works/133", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 744286, "client_id": 450719, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/d204f503/uploads/origins/29c763a5-dc80-4756-9c58-26d015f718c3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d732ca211a8a62dad015a107e56f9702", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/d204f503/uploads/origins/29c763a5-dc80-4756-9c58-26d015f718c3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=270d759d051643a1f84da7b77666c43e", "src_set": ""}, "body": "またリクエストをしたい。今回はダークストーカーズのフェリシアを描いてくれるなら。\n\n彼女が膝をついて前かがみになり、爪を伸ばして猫のひっかき棒で遊んでいるところを見てみたい。彼女は見る人に向かってお尻を突き出し、遊び心や魅惑的な表情で振り返る。\n\n彼女の性器と乳首を毛皮が覆っているバージョンと、それらが露出しているバージョンが欲しい。\n\nhttps://drive.google.com/file/d/10Ciu4sKfnL_JmK9vWR5dG6lGUbxMmsP8/view?usp=sharing", "nc": 176, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@ohguro_mariya/works/132", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 744286, "client_id": 2050281, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/d1f6c85c/uploads/origins/67cf16ad-72a9-4174-a5b8-778fc3ecb1fc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1e117184ac2152c22a36435e8d11e7f5", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/d1f6c85c/uploads/origins/67cf16ad-72a9-4174-a5b8-778fc3ecb1fc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ba99876458264e83d249437647a8468d", "src_set": ""}, "body": "お久しぶりです。またイラストの依頼をさせていただきます\n作品名：艦隊これくしょん\nキャラクター：筑摩改二\n衣装：黒のマイクロビキニ。端を紐で結ぶタイプ\n構図：提督が下の状態の騎乗位での行為シーンを所望します。提督から下から突き上げられながら両胸も揉みしだかれて筑摩は防戦一方。という状況でお願いします。水着の着乱れ具合はお任せいたします\n引き受けて頂けたら幸いです。", "nc": 49, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@ohguro_mariya/works/131", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 744286, "client_id": 8151, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/a2aa1081/uploads/origins/48c9b5b0-6f82-4db9-a7ff-135f0f9a68e0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3370aa9e7ebb314401660948a9cf19bd", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/a2aa1081/uploads/origins/48c9b5b0-6f82-4db9-a7ff-135f0f9a68e0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=7de830e04ddce2961226e54527748ee0", "src_set": ""}, "body": "御世話になります。\n「ドラゴンクエスト　ダイの大冒険のマァムがクロロホルムを嗅がされて眠らされるシーン」をお願いします。\nマァムは初登場～僧侶戦士時代を想定してます(髪型等)\n・基本表情に「驚き」差分に「もがき」「目がとろーん」「薬が効き目の焦点が合わない」「白目をむき気絶寸前」「目を閉じ気絶」「ハンカチ無しで寝顔が見える」をお願いします。\n・乳やスジ（陰毛）が見える構図でお願いします。\n・犯人は腕など一部分やシルエットで大丈夫です。背景もこだわりません。\n・犯人に抱きしめられる感じで眠らされます。(最初は抵抗するも、段々と薬の匂いに負けて、感じてしまい、気持ち良さそうに眠ってしまいます。）\n・よければ台詞や効果音の有無差分もよろしいでしょうか。", "nc": 57, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@ohguro_mariya/works/130", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 744286, "client_id": 2967661, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/98a3f847/uploads/origins/5ea1503a-599b-40c1-acee-c9d3ef076432?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b002e4e56f46176a58c75b0814c655c6", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/98a3f847/uploads/origins/5ea1503a-599b-40c1-acee-c9d3ef076432?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&