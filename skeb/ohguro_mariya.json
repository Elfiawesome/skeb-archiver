": 744286, "client_id": 0, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/9b4672e2/uploads/origins/012e91a0-f9a8-4555-bff4-dc7806d176b2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=020a00e92fe1681ccd25289537eda46e", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/9b4672e2/uploads/origins/012e91a0-f9a8-4555-bff4-dc7806d176b2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d6dc6c68c1ae1fe38b9d0cba3efca736", "src_set": ""}, "body": "初めまして\n\nオリジナルキャラの全身立ち絵で、昭和初期の農家の20代中ごろ、\n両腕を高手小手に縛られ胸を露出した\nむせ返るような大人の女性の魅力たっぷりな感じの\n黒髪女性のイラストをリクエストしたいです。\n表情は羞恥で涙ぐんでいるような感じにしてほしいです。\n体型、髪型、ポーズ等はお任せします。\n\n恰好\n野良着に、もんぺ、地下足袋履を履いています。\n野良着の色は紺、模様は絣模様にしてほしいです。\nもんぺはへその辺りで紐を結ぶ袴式、長さはくるぶしまで、\n色、模様は濃い紫系の縞模様で脇は袴の様にスリットを開けてほしいです。\n地下足袋はくるぶしの上までの長さ、色は黒にしてほしいです。\n服装の大まかなイメージは資料urlをご参照ください。\nもんぺイメージ\nhttps://www.dropbox.com/scl/fi/6vbchf5jfox7oizm9ishf/simam.png?rlkey=f9jko40b8laofmj4ycfsrgqa9&st=kbh2hfv1&dl=0\n\n以上ご検討の程宜しくお願い致します。\n\nhttps://www.dropbox.com/scl/fi/s6470qhlwdftz8kzbg16s/nk.jpg?rlkey=ve4te44hezclvf9gbnn6zsiw2&st=mglg9oaa&dl=0", "nc": 32, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@ohguro_mariya/works/122", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/8af74d48/uploads/origins/c35517ad-5aa6-42e7-aac8-e93580ee76db?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=1e0f0fe245a0d7705b256bb8a707d518", "src_set": ""}, "private": true, "genre": "art", "tipped": false, "creator_id": 744286, "client_id": 0, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 176, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}], "similar_cre