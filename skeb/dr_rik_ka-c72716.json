fdRTY13f-KN9?usp=drive_link\n\nThank you in advance!", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@dr_rik_ka/works/6", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/eb2a94d3/uploads/origins/639adcc6-dc96-4c81-9dd4-303b52f27f25?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=d8b42891183150ffb3096135d9d332bd", "srcset": "https://si.imgix.net/eb2a94d3/uploads/origins/639adcc6-dc96-4c81-9dd4-303b52f27f25?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=d8b42891183150ffb3096135d9d332bd, https://si.imgix.net/eb2a94d3/uploads/origins/639adcc6-dc96-4c81-9dd4-303b52f27f25?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=085fbb92a7b39af03ddbbf769e13ffe9 2x, https://si.imgix.net/eb2a94d3/uploads/origins/639adcc6-dc96-4c81-9dd4-303b52f27f25?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=761b8e3eda85801a1a2df45fb81456f3 3x"}, "private": true, "genre": "art", "tipped": false, "creator_id": 3904794, "nc": 17}, {"path": "/@dr_rik_ka/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3904794, "client_id": 951419, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/1a0ef2c2/uploads/origins/14269412-8110-46c4-8475-e0b8a48cc1dd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ac50688177b22cf81cf94cfeb0d5d4fe", "srcset": "https://si.imgix.net/1a0ef2c2/uploads/origins/14269412-8110-46c4-8475-e0b8a48cc1dd?bg=%23fff&auto=format%2Ccompress&