、救済系青春ストーリーのような感じです。  \n\n【服装】  \nもし学校のシーンで描いていただく場合は制服でお願いします。もし校外のシーンの場合、服装は先生のご自由にお任せします。または、「服装」フォルダ内の「私服参考 3.png」をご参考にしていただいても大丈夫です。デザインのアレンジも自由にしていただいて構いません！\n\nリンクの中には、二人の参考画像が含まれています！長文を最後までお読みいただき、心より感謝申し上げます。  何卒ご検討いただけますと幸いです！よろしくお願いいたします！\n\nhttps://drive.google.com/drive/folders/113AoibP9rHwH8Ctz9rBuf6c5iNiklw4-", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@camonegi_/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3589987, "client_id": 656043, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/7e1d448d/uploads/origins/1af2aeff-b9f4-4132-8a50-02bfdfe67e78?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2c0024194e7d083a6ee8d67da41ec8e7", "srcset": "https://si.imgix.net/7e1d448d/uploads/origins/1af2aeff-b9f4-4132-8a50-02bfdfe67e78?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2c0024194e7d083a6ee8d67da41ec8e7, https://si.imgix.net/7e1d448d/uploads/origins/1af2aeff-b9f4-4132-8a50-02bfdfe67e78?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=97953f5ab506b05032d6efb06aee9e22 2x, https://si.imgix.net/7e1d448d/uploads/origins/1af2aeff-b9f4-4132-8a50-02bfdfe67e78?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=cf026330cd72f35d3ee4f71cd4644fe1 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/7e1d448d/uploads/origins/1af2aeff-b9f4-4132-8a50-02bfdfe67e78?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=43cfe9f2f46d44a91ed591bd227df30b", "srcset": "https://si.imgix.net/7e1d448d/uploads/origins/1af2aeff-b9f4-4132-8a50-02bfdfe67e78?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=43cfe9f2f46d44a91ed591bd227df30b, https://si.imgix.net/7e1d448d/uploads/origins/1af2aeff-b9f4-4132-8a50-