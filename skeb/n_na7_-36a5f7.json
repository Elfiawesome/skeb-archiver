リュウとアムドゥスキアス（アムブスキアス）です。今回の依頼のアイデアは、キリューとアムドゥスキアスが一緒に歌をレコーディングしているところです。背景・シーンは参考資料のようなスタジオの中です。両キャラクターはスタジオの中で座っていても立っていても構いません。マイクに向かって歌っています。KyruとAmdusciasはカジュアルな服を着て、ヘッドホンをしています。もしよろしければ、もっと詳細をお書きください。いつもありがとうございます！\n\n参考文献：https://drive.google.com/drive/folders/1hDYdagPIVBKfrCyx6uhhuRVG5tLkXqL2", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@n_na7_/works/14", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1356546, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/0437644f/uploads/origins/54730715-0fa2-4e88-9fdc-cfadcb14c281?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=83cce9d66e413cc70bebd4bea733109d", "srcset": "https://si.imgix.net/0437644f/uploads/origins/54730715-0fa2-4e88-9fdc-cfadcb14c281?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=83cce9d66e413cc70bebd4bea733109d, https://si.imgix.net/0437644f/uploads/origins/54730715-0fa2-4e88-9fdc-cfadcb14c281?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=896bdcbf2f8b24bcbeeb0e0bda6aa630 2x, https://si.imgix.net/0437644f/uploads/origins/54730715-0fa2-4e88-9fdc-cfadcb14c281?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e8817dee2d98d26da28450f8330e6dfc 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/0437644f/uploads/origins/54730715-0fa2-4e88-9fdc-cfadcb14c281?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9a71c3396505d6889d2eeb80a34effab", "srcset": "https://si.imgix.net/0437644f/uploads/origins/54730715-0fa2-4e88-9fdc-cfadcb14c281?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9a71c3396505d6889d2eeb80a34effab, https://si.imgix.net/0437644f/uploads/origins/54730715-0fa2-4e88-9fdc-cfadcb14c281?bg=%23fff&auto=format%2Ccompress&fm