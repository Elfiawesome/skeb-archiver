u/works/13", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3787472, "client_id": 587738, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/a7b68e08/uploads/origins/126bfb0f-8773-4a59-a182-797f8573f664?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4489b24c51364ec173ac7ecca0ac7d4d", "srcset": "https://si.imgix.net/a7b68e08/uploads/origins/126bfb0f-8773-4a59-a182-797f8573f664?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4489b24c51364ec173ac7ecca0ac7d4d, https://si.imgix.net/a7b68e08/uploads/origins/126bfb0f-8773-4a59-a182-797f8573f664?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=3c9db892a150e5ea9e3d6c4a09869fed 2x, https://si.imgix.net/a7b68e08/uploads/origins/126bfb0f-8773-4a59-a182-797f8573f664?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=1c179ad1791aba69fbc1ee34944651bb 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/a7b68e08/uploads/origins/126bfb0f-8773-4a59-a182-797f8573f664?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b73c225fe3c9561c4b95a74354334db8", "srcset": "https://si.imgix.net/a7b68e08/uploads/origins/126bfb0f-8773-4a59-a182-797f8573f664?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b73c225fe3c9561c4b95a74354334db8, https://si.imgix.net/a7b68e08/uploads/origins/126bfb0f-8773-4a59-a182-797f8573f664?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=376e0601a8ea4bc79b8d12156045392e 2x, https://si.imgix.net/a7b68e08/uploads/origins/126bfb0f-8773-4a59-a182-797f8573f664?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=10e414a3879c29b932813ad140066c0e 3x"}, "body": "Vtuberのまさるドット子と申します！\n是非とも私のことを描いていただきたいと思いましてリクエストを送らせて頂きました！\n\n【用途】\nYoutube(収益