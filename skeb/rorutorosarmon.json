rivate": true, "genre": "art", "tipped": true, "creator_id": 1660274, "client_id": 2262859, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 0, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@rorutorosarmon/works/86", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/df3e1ee7/uploads/origins/920948a6-e8d5-4a35-89df-7e9bc373325a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=f40de4b489fa00623661c3f6c1ae0193", "src_set": ""}, "private": true, "genre": "art", "tipped": false, "creator_id": 1660274, "client_id": 0, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 49, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@rorutorosarmon/works/85", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1660274, "client_id": 1197748, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/e60bb971/uploads/origins/7ad12fa8-3ac0-4f55-9b70-bf3d6fa90e4a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=98454cc4186c7f8139ebef9e65ad44cf", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/e60bb971/uploads/origins/7ad12fa8-3ac0-4f55-9b70-bf3d6fa90e4a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9469a8d29ca188940192ec714590efed", "src_set": ""}, "body": "こんにちは\n前々回(https://skeb.jp/@rorutorosarmon/works/70)描いていただいた姉妹が今度は小学生の男の子と女子高生の着ぐるみを着たけど、男の子着ぐるみ(中身は妹ちゃん)に無断で全頭面の鍵を閉めた上に8時間後にセットしたタイムロッキングコンテナに鍵を入れてしまって怒られている…というシチュエーションのイラストをお願いします。\n向かい合った2人を脇から見た感じです。\n男の子の方が若干身長は低いです。\n\n以下、着ぐるみのデザインの指定です\n\n男の子着ぐるみ(中身妹ちゃん)\n・癖っ毛のある黒髪ショート\n・表情は口閉じ笑顔、眉毛太め\n・青いパーカー\n・半ズボン\n・黒のランドセルを背負っている\n・コンテナを見せながらぷんすか怒っている\n\n女子高生着ぐるみ(中身お姉ちゃん)\n・茶髪ロング、前髪は斜め分け\n・表情は口を開けた笑顔\n・ワイシャツの上にベージュのスクールカーディガン、第一ボタンは開けている\n・ミニスカ+ニーソックス\n・全体的にギャルっぽい感じ\n・男の子を「怒っているのもかわいいな〜❤︎」といった感じで見つめている\n\nまた、それぞれの着ぐるみの上に中の人の表情の吹き出し(妹ちゃん：怒りながら怒鳴っている顔、お姉ちゃん：ニヤケながら見ている顔)を描いてもらいたいです。\n\n指定されていない所はそちらにお任せします。\nよろしくお願いします。", "nc": 24, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@rorutorosarmon/works/84", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1660274, "client_id": 128546, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/4d446d0a/uploads/origins/e7281db6-8b1d-48ce-8523-c8499251583f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=985b69647258d9dccb660751864d5965", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/4d446d0a/uploads/origins/e7281db6-8b1d-48ce-8523-c8499251583f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=61fc891bd92ab587559ba39f0353bebe", "src_set": ""}, "body": "神社の着ぐるみ体験コーナーにてロントンさんのこの過去絵 https://twitter.com/rorutorosarmon/status/1832335426516144509 と同じ様な黒いインフレータブルお狐様着ぐるみを着た妹ちゃんを所望します\n妹ちゃんは撮影ブースの「お狐様の台座」の前でノリノリでポーズ(何故かやや猫っぽい)を取っており、着ぐるみは資料URLの動画の着ぐるみの様に喉元が開口していて妹さんの顔が出ています。また、赤い布は着ぐるみが咥えている棒に引っかかってめくれ上がっています\n\nhttps://youtu.be/4hiW5Fr_PEs", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@rorutorosarmon/works/83", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1660274, "client_id": 100428, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/8fdd7d05/uploads/origins/b5f14fcd-0453-40df-9145-87cb7ad67e2e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1350ad3a19b9fe1c24e17d4eaf591694", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/8fdd7d05/uploads/origins/b5f14fcd-0453-40df-9145-87cb7ad67e2e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=fb72ca185d4eb3945bc1c3d975f43568", "src_set": ""}, "body": "こんにちは。好きなCDジャケットがあるのですが、それを着ぐるみさんで再現したイラストを依頼させていただきたいです。\n\n参考URL内の「参考画像.jpg」を元に、以下をお願いしたく存じます\n　・元のイラストと異なり、面の表情は笑顔\n※他、背景・構図等に関しては大まかな雰囲気が合っていれば問題ございません。\n\n以上、よろしくお願いいたします。\n\nhttps://drive.google.com/drive/u/0/folders/1PHq2VNTKJm-3bjcCtcmvbeR5box3Gh2I", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@rorutorosarmon/works/82", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1660274, "client_id": 0, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/882da774/uploads/origins/79e9ad25-c537-463a-8e2f-92fa611537df?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1bf90734622fe037bb3187116a7b968b", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/882da774/uploads/origins/79e9ad25-c537-463a-8e2f-92fa611537df?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0ec2887e2df2d1a77b051112fa16dd65", "src_set": ""}, "body": "はじめまして、リクエストを送らせていただきます！\n\nVOICEROIDの月読アイの着ぐるみを着た男性マスターが、月読アイ本人に手をひかれながら夜中の散歩に無理やり付き合わされている感じの絵をお願い致します。\n\n月読アイ本人は普通に楽しんでいるものの、マスターの方は意図せずに外に出る事になったために恥ずかしさを感じているという感じでお願いします。\n\nマスターの方は平均男性程の身長で本人とは子供と大人程の身長差があると嬉しいです。\n\n月読アイはボイスロイドのキャラクター(https://www.ah-soft.com/voiceroid/ai/index.html)になりますが、服装はスモックではなく、付け袖で肩を出している服装です。", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@rorutorosarmon/works/81", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1660274, "client_id": 1448465, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/289df00a/uploads/origins/6288e5ef-253c-460f-8c48-2bb37a9a2a4c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fed02f1fcad026bc9441577edf130ec7", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/289df00a/uploads/origins/6288e5ef-253c-460f-8c48-2bb37a9a2a4c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=36abbde70bf2588a103cb7089b849d2c", "src_set": ""}, "body": "もしお時間ありましたら、Piaキャロット2の日野森あずさ(メイドタイプ)の着ぐるみを着た,\n金髪ちゃんを描いていただけませんでしょうか。", "nc": 177, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@rorutorosarmon/works/80", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1660274, "client_id": 296565, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/16a30593/uploads/origins/235e33d4-2ad9-4cc1-a77a-0e2b1f456526?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bcdc2eccc80a0aafb29653f87e8d0344", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/16a30593/uploads/origins/235e33d4-2ad9-4cc1-a77a-0e2b1f456526?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e6e8f3d9f989379b0c0a7f3a6106a3ba", "src_set": ""}, "body": "こんにちは、リクエスト送らせていただきます。\n\n「後藤ひとりの着ぐるみを着た喜多郁代」と「喜多郁代の着ぐるみを着た後藤ひとり」のイラストをお願いします。\n服装はメイド服でお願いします。\n差分はマスクを被る前と被った後で全身タイツからは少し前髪が出ている感じでお願いします。\nシチューエーションは初めての着ぐるみに不慣れなひとりちゃんを喜多ちゃんがフォローしている感じでお願いします。\n背景や表情などはお任せします。\n\nご検討のほど、よろしくお願いいたします。", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "similar_creators": [{"id": 117851, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "Ehime Mikan🍊", "screen_name": "mikan_