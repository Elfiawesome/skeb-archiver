4/uploads/origins/c1f40b9b-427a-4d12-ba68-4f9608db34f1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b8521a04536a5233c10494eda3e698dc, https://si.imgix.net/92f7d6d4/uploads/origins/c1f40b9b-427a-4d12-ba68-4f9608db34f1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=96056ec80c456ef77a81a587d04370c4 2x, https://si.imgix.net/92f7d6d4/uploads/origins/c1f40b9b-427a-4d12-ba68-4f9608db34f1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=b834e7a55442debdadee4df785e8d9a2 3x"}, "body": "voda様\n\n先日はオリジナルキャラクターのイラストありがとうございました。\nvoda様の描かれる人外イラストを大変魅力的に感じており、また別のオリジナルキャラクターのイラストをお願いしたいです。\n今回はTRPG（ネクロニカ）のキャラクターをお願いできますでしょうか。\n\n【概要】\n・名前はシタノコ\n・羽織っているパッチワークのマントが本体の化け物\n・黄色いボタンのような部分が本体の目\n・人間のように見える部分はただの死体、下半身がなく、腕で歩く\n・本体が死体（意識はない）を操っている（ヤドカリに近いイメージ？）\n・腕には包帯を巻いている\n・凶暴な性格で好戦的\n\n【参考URL】\nhttps://drive.google.com/drive/folders/1FuIT3vCxEhT6s6PDW562wxUk_gAmCOOr\n\nご検討のほど、よろしくお願いいたします。", "nc": 33, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@voda_6od61/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3594870, "client_id": 3711637, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/f0cf66fe/uploads/origins/d508f87f-abea-426e-914b-d0e5fcdf794f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d308bd2e368d820456dacc566c69fe66", "srcset": "https://si.imgix.net/f0cf66fe/uploads/origins/d508f87f-abea-426e-914b-d0e5fcdf794f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d308bd2e368d820456dacc566c69fe66, https://si.imgix.net/f0cf66fe/uploads/origins/d508f87f-abea-426e-914b-d0e5fcdf794f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=263b5d91c1f8ad88d3758f3902b30322 2x, https://si.imgix.net/f0cf66fe/uploads/origins/d508f87f-abea-426e-914b-d0e5fcdf794f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=0a4911330f4f788b8dff97b1e69a8d01 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/f0cf66fe/uploads/origins/d508f87f-abea-426e-914b-d0e5fcdf794f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=19365fb852631f880b032cedd69d3a2e", "srcset": "https://si.imgix.net/f0cf66fe/uploads/origins/d508f87f-abea-426e-914b-d0e5fcdf794f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=19365fb852631f880b032cedd69d3a2e, https://si.imgix.net/f0cf66fe/uploads/origins/d508f87f-abea-426e-914b-d0e5fcdf794f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=5df7ed5ba609a08aa2b53fccc58498df 2x, https://si.imgix.net/f0cf66fe/uploads/origins/d508f87f-abea-426e-914b-d0e5fcdf794f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=410ee273bf340d3bea0c3857a1249b00 3x"}, "body": "vodaさん、はじめまして\nたまたまイラストを拝見して異形のキャラデザ素敵だと思いリクエストをお送りいたしました。\nもしよろしければ、私のオリジナルキャラクターの「センジュサマ」を描いていただけないでしょうか。\n\nセンジュサマは昔は人々から救いを求められる高僧でした。\nしかしたった一度だけ自分に救いを求める手を取らずに小さな子供を見殺しにしてしまいます。\n大層心を痛めた彼は百日百夜泣き明かし、気が付いたら芋虫のような化け物になっていたのです。\nもはや人間だった頃の記憶はありません。\nしかし、「手を取れなかった」という後悔だけは自覚できずとも心に居座り続けたままでした。\n正常な判断のできない彼はいつしか自分に近づく人間を見境なく腕を引きちぎり集め始めます。\nいくら腕を集めても心は満たされず、その行いは数百年にも及ぶことになります。\nいつしかセンジュサマの住む廃寺は「断肢寺」と呼ばれ、誰も近寄らなくなってしまいました。\n\n非常に作画コストの高いキャラクターですので、\nどうぞ資料をご確認いただいてからご検討くださいませ。\n\nhttps://drive.google.com/drive/folders/1ESYwA-jxW-KaVPxbU1OuwL3seXTKv4uW", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@voda_6od61/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3594870, "client_id": 2120257, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/5e9ee3fe/uploads/origins/aa30c3d7-4c9d-4524-944e-763d6c20f864?bg=%23fff&auto=form