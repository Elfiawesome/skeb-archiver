ことが多いため、たまに相手から反応が返ってくると照れる。\n意外と押しに弱い。\n\n▮関係\nツンツン天才狙撃手とへらへらベテラン観測手\nバディ名は「CROWS」（カラスモチーフ）\n大事な相棒であり恋人\n\n▮使用用途\n友人への共有・SNSアイコンとしての使用（友人含む）\n個人での鑑賞目的の印刷・グッズ作成など\n＿\nおまかせする点が多く恐縮ですが、ご検討いただければ幸いです…！\n難しそうでしたらキャンセルや再送いただいて問題ございません！\nよろしくお願いいたします！\n\nhttps://drive.google.com/drive/u/1/folders/1QIRtw7lL_8_MsPFENHCzYsXdrSdm6P7E", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Kurehashi_main/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3798489, "client_id": 2829876, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/a11a5ad9/uploads/origins/a9f5a220-ce36-4ffd-a735-51703aa36938?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=16d755213cf58a8886cb35cad53378e9", "srcset": "https://si.imgix.net/a11a5ad9/uploads/origins/a9f5a220-ce36-4ffd-a735-51703aa36938?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=16d755213cf58a8886cb35cad53378e9, https://si.imgix.net/a11a5ad9/uploads/origins/a9f5a220-ce36-4ffd-a735-51703aa36938?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ac3a074a07495b63070a6a334e0f46ca 2x, https://si.imgix.net/a11a5ad9/uploads/origins/a9f5a220-ce36-4ffd-a735-51703aa36938?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=125df5d8e464b29122384ef8236c2fe3 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/a11a5ad9/uploads/origins/a9f5a220-ce36-4ffd-a735-51703aa36938?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a124b30650d6741f50069c5eec7b9fe2", "srcset": "https://si.imgix.net/a11a5ad9/uploads/origins/a9f5a220-ce36-4ffd-a735-51703aa36938?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a124b30650d6741f50069c5eec7b9fe2, https://si.imgix.net/a11a5ad9/uploads/origins/a9f5a220-ce36-4ffd