d": 0, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/9fa3ce51/uploads/origins/0c7d7a0d-d9b4-4641-8051-1aa2f1305327?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c98b8dfb1edfc809fbe59bd474e54322", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/9fa3ce51/uploads/origins/0c7d7a0d-d9b4-4641-8051-1aa2f1305327?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=751afa6b183307344c86b050b098eb59", "src_set": ""}, "body": "はじめまして\n何時も素晴らしいイラストをありがとうございます\nエルデンリングの妄想ルートを依頼させてください\n\n導きに従い影の地でメスメル公からその右目ごと火を奪った褪せ人が\n狭間の地に戻ってメリナを押し倒し隠された左目を抉り出そうとしてるシーンをお願いします\nメリナは褪せ人が正気を失ったと思い本気で怖がって、褪せ人はそんなメリナに大丈夫、コレでずっと一緒に旅を続けられると絶妙にズレた会話もお願いします\n\n以下裏設定的な\n褪せ人\n・放浪騎士のメリナガチ勢。王になり得た褪せ人が達が自分の巫女を焼く運命に狂ってしまった為にメリナがあまり関わらないようにしているのは知っているがすでに手遅れ\n・滅びの山に至って入るがメリナを焼く事など出来るわけもなくずっと立ち止まっていた\n・新たな導きに従い惰性で影の地に来たがメスメル公と彼の火に見え天啓を得る\n・そのままメスメル公を倒して右目を抉り出しその火を奪う\n・グレートソードを持った脳筋ビルド。火を奪った影響で身体が常に燻っている\n・本来は寡黙だがメリナを救う手段が見つかった為テンションが爆上がりしたせいで言動がかなり危険に\n\n絵面は最悪だがメスメル公は火から解放されレラーナに確保されて隠居\nメリナも種火の運命から解放され新たな時代を生きれるので良い方向に向かっている\n\n以上のような感じでお願いします！", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@RvySZdQLYgdo6Db/works/11", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3139699, "client_id": 3067221, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/98f2a523/uploads/origins/a086eae9-c649-4ed0-818c-47e7348728ef?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5a67137d396fe458a1dc56807ce1d942", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/98f2a523/uploads/origins/a086eae9-c649-4ed0-818c-47e7348728ef?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=eedd6a9d23cfe58cfac63f1e871982e1", "src_