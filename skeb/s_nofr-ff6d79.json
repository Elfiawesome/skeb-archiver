合は、ご自由にリクエストを進めてください。\n\nご検討いただきありがとうございます！\n\nhttps://imgur.com/a/tactical-sexy-tomoe-upN5GL3\nhttps://x.com/UmariTomoe/status/1966865327402222034?s=20", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 24244, "creator": true, "nsfw_acceptable": true, "acceptable": false, "name": "脳廻", "screen_name": "pozesuke", "avatar_url": "https://pbs.twimg.com/profile_images/1995517063281115136/y8rMwlFB.jpg", "header_url": "https://pbs.twimg.com/profile_banners/4253235073/1764600841/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 10, "complete_expiration_days": 30, "skills": [{"genre": "art"}], "banned": false, "nc": 48}, {"id": 3116893, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "こちトラ🦴🩶 お仕事募集中", "screen_name": "kochitora_9", "avatar_url": "https://pbs.twimg.com/profile_images/1883372515869007872/iaSct5vU.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1426927392442908676/1743941133/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "art"}], "banned": false, "nc": 128}, {"id": 3368545, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "Tsukasa.M🎨OPEN FOR COMM", "screen_name": "tsukasa12598", "avatar_url": "https://pbs.twimg.com/profile_images/1913120097566326784/RfsxxnhJ.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1805118083050418176/1785292291/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expir