ガモス(エンブ)\n・リーフィア(ジル)\n・エネコ(りん)\n・ニャスパー系統\n・ニャヒート等(猫ポケモンたち)\n\n神社に生息している、私の手持ちとして活躍しいるポケモンたちです。\nイメージの共有のために記載しました。\n\n【使用用途】\n主に、X及びYouTubeのヘッダーに使用させていただけたらと思います。\n他、収益化済みの配信サムネイルや動画などの活動に使用させて頂きたいです。\n(Xにポストする場合は学習阻害の加工を施す予定です)\n(グッズなどによる商用利用の予定はございません)\n\n【納品形式について】\n主にヘッダーに使用させていただきたいため、少し横長のキャンバスサイズだとうれしいです！\n\nお忙しいところ恐れ入りますが、ご検討の程よろしくお願い致します。", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@nitrocharge25/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3396471, "client_id": 3404885, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/8bc7638b/uploads/origins/ddf41a0b-f51c-4401-8b6e-5cf91b2eefd9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=33716a1ad3f9a1331d76e5acac8e294a", "srcset": "https://si.imgix.net/8bc7638b/uploads/origins/ddf41a0b-f51c-4401-8b6e-5cf91b2eefd9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=33716a1ad3f9a1331d76e5acac8e294a, https://si.imgix.net/8bc7638b/uploads/origins/ddf41a0b-f51c-4401-8b6e-5cf91b2eefd9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=73b3bfc7314b6cbc54ab94c26135aad2 2x, https://si.imgix.net/8bc7638b/uploads/origins/ddf41a0b-f51c-4401-8b6e-5cf91b2eefd9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=9e402173eb1081edea798e2a47b3da2f 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/8bc7638b/uploads/origins/ddf41a0b-f51c-4401-8b6e-5cf91b2eefd9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=4fcad9f04d8816f9fb4e542c1398f3b0", "srcset": "https://si.imgix.net/8bc7638b/uploads/origins/ddf41a0b-f51c-4401-8b6e-5cf91b2eefd9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=4fcad9f04d8816f9fb4e542c1398f3b0, https://si.imgix.net/8bc7638b/uploads/ori