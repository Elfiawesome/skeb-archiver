を籠絡して主神に奉じて仲間を増やしたりしています。\n\n［シチュエーション］\n波打ち際の神殿跡、あるいは礒の岩場で一休みしながら、人間を誘惑している雰囲気でお願いします。\n自作イラストは生まれ変わった直後なのでポニテを結っただけですが、髪飾り等、何かアクセサリーを足していただいても構いません。\n細部は先生にお任せしますので、可愛らしくも色っぽくてちょっぴり怖い人魚さんにしていただければありがたく存じます。\n\n不要とは思いますがイラストの大サイズ版と小噺のPDFはURLよりダウンロードいただければ幸いです。\n上、ご検討何卒よろしくお願い申し上げます。\n\nhttps://www.dropbox.com/scl/fi/6taqg1t40mm95x5bu05g8/mat20251128mizua.zip?rlkey=0r0l1zvgn0osfkl0kdmkg32kj&st=5n5jl193&dl=0", "nc": 49, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@_mizuaoi_/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3122217, "client_id": 3242139, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/75c3cc09/uploads/origins/bfa0da96-48cb-42d4-9b76-73449b4d1663?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f0bea21b4a398fa7e8658252af34785c", "srcset": "https://si.imgix.net/75c3cc09/uploads/origins/bfa0da96-48cb-42d4-9b76-73449b4d1663?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f0bea21b4a398fa7e8658252af34785c, https://si.imgix.net/75c3cc09/uploads/origins/bfa0da96-48cb-42d4-9b76-73449b4d1663?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=bb54bfd4acf6436ff41d53b79033ac9a 2x, https://si.imgix.net/75c3cc09/uploads/origins/bfa0da96-48cb-42d4-9b76-73449b4d1663?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=12a377572f0f3fd7e1a5797a799d801d 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/75c3cc09/uploads/origins/bfa0da96-48cb-42d4-9b76-73449b4d1663?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e22e3edd2d79639022df19bb7e44ba85", "srcset": "https://si.imgix.net/75c3cc09/uploads/origins/bfa0da96-48cb-42d4-9b76-73449b4d1663?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e22e3edd2d79639022df1