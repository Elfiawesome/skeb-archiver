_id": 90499, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/78160a1b/uploads/origins/aae77eee-eb3a-4088-ae06-b245ef372bc8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0d44041c8e9fcf23e85adbc97f5a395c", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/78160a1b/uploads/origins/aae77eee-eb3a-4088-ae06-b245ef372bc8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=067eef1ec05047907ef6c5bd50e83af3", "src_set": ""}, "body": "こんにちはシャモモさん! Dobar dan!\n\n私のキャラクター、サブリナのデッサンを依頼したい。\n\nクロアチアのザグレブでは、気温が37度を超え、湿度も高く、私はエアコンを設置していないので、冷房は換気扇1台だけだ。\n\nそれで, 暑さと戦うサブリナの絵が見たい。\n\n適切と思われる服装を自由に選ぶことができる（あるいは、服装がない場合もある）。下着が見える場合はレースでお願いします。\n\nサブリナの写真 - https://imgur.com/a/SsBPpjD\n\nHvala puno!\n\nhttps://imgur.com/a/SsBPpjD", "nc": 160, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@shamom0_/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2465721, "client_id": 3308459, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/53f46486/uploads/origins/c97a5f5f-440e-4489-9122-3b36f454a050?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ce742888a7e6c2021e939c08aa457a3c", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/53f46486/uploads/origins/c97a5f5f-440e-4489-9122-3b36f454a050?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=320eae857066ef689e1d5806a79eb6ae", "src_set": ""}, "body": "しゃももさん、初めまして。\nSkebの新規投稿一覧（https://skeb.jp/@shamom0_/works/6）でお見掛けし、\n素敵なイラストだなと思いましたため、私もお願いできないかご相談です。\n\n【リクエスト】\n私がVRChatというゲームで使用しているアバターです。\nポーズや構成はお任せいたします。また衣装やデザインの簡略化・変更・差し替えなどOKです。\n\n・キャラクター（桔梗）\n　⇒https://ponderogen.booth.pm/items/3681787\n　\n・参考資料\n　⇒https://drive.google.com/drive/folders/1-0BFlEyfH942oAaJOqzGXD8fvfSDQJd0?usp=drive_link\n　\n・補足事項\n　①表情は明るい感じで描いていただけると嬉しいです。\n　②クリエイター様の趣味嗜好をブレンドしていただいて構いません。\n\n【データ】\n・PSDで頂けると嬉しいです。\n　VRchat内で使用する場合、ライティングの影響でイラストの色合いが大きく変わる可能性があるため、\n　PSDデータをもとにこちらで光度・彩度等を調整できるとありがたいためです。\n\n・背景/イラスト本体/文字はレイヤーを分けていただけるとありがたいです。\n　※イラスト本体を透過pngとして出力し、組み合わせてアイコン等に使うことを想定しています。\n\n・縦向き/横向きのどちらでもOKです。おまかせします。\n\n【使用用途】\n　・VRChat内でのアイコン・ヘッダー・ポスター等\n　・各種SNS・Youtube・Twitch等での利用\n\n是非、ご検討のほどよろしくお願いいたします。", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "similar_creators": [{"id": 7280, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "クール禅濯機☄️雑煮", "screen_name": "kinokozaru", "avatar_url": "https://pbs.twimg.com/profile_images/1878360514574868480/rWuwV4m_.jpg", "header_url": "https://pbs.twimg.com/profile_banners/109181382/1756059952/1500x500", "appeal_receivable": true, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "skills": [{"genre": "art"}], "nc": 33}, {"id": 180983, "creator": true, "nsfw_acceptable": false, "acceptable": false, "name": "たまふ りん🐍", "screen_name": "2__5_____", "avatar_url": "https://pbs.twimg.com/profile_images/1509730313362370568/bXGQTC79.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1022478007070380037/1727243314/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "skills": [{"genre": "art"}, {"genre": "correction"}], "nc": 48}, {"id": 292087, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "10分で描けるだけ🔞🎨", "screen_name": "10min500_4649", "avatar_url": "https://pbs.twimg.com/profile_images/1353226736989691906/gD_FBXKj.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1353225873265106944/1686027601/1500x500", "ap