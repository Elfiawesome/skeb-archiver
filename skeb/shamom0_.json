_image_urls": null, "body": "", "nc": 33, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@shamom0_/works/23", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2465721, "client_id": 0, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/0a5459dd/uploads/origins/081f4de9-b3f1-4662-8bf3-12e6f212842c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e456ab70c95ba823ec9406d7d2ea6dbd", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/0a5459dd/uploads/origins/081f4de9-b3f1-4662-8bf3-12e6f212842c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ad2aba7468c85c4d2ecf520e58a9f978", "src_set": ""}, "body": "シャモモさん、いつも素敵な作品をありがとうございます。もしよろしければ、「新聞を読んでいる浦風さん(艦隊これくしょん)」を描いていただけないでしょうか？\n\n①\t衣装はデフォルトのものでお願いします。衣装の長手袋は両手に着用していてほしいです。\n②\t両袖ですが、肩までの腕まくりはせずに、谷風さんや浜風さんのような半袖の状態だと嬉しいです。\n③\t新聞は両手で広げて持っていてほしいです。\n④\tよろしければ、立って読んでいると嬉しいです。\n⑤　もし可能でしたら、両袖を従来通りに肩まで腕まくりしている差分を描いていただけないでしょうか？ご都合等、厳しいという場合は、⑤は気にしないでいただければと思います。\n\nその他、表情や構図等につきましては、シャモモさんにお任せをさせていただければと思います。\n\n差し支えなければ、ご検討いただけると幸いです。何卒よろしくお願い致します。", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@shamom0_/works/22", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2465721, "client_id": 663243, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/9c9f8782/uploads/origins/3c700c0f-15c2-4d0b-a1b9-2adc7a31d03c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=64fa64ade29237f79bdbd27a5d884a75", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/9c9f8782/uploads/origins/3c700c0f-15c2-4d0b-a1b9-2adc7a31d03c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=7856ed3975239e2aaa35c55d76fc9e0e", "src_set": ""}, "body": "ショタ提督と利根\n下記の流れでお願いできますか\nそれっぽいセリフも、それぞれにシーンに入れて欲しいです\n\n・ショタ提督が利根の衣装を着せられて遊ばれている\n利根はショタ提督が恥ずかしがっているのを見て楽しんでいる\nうしろから抱き着いていてからかっている\n\n・ショタ提督、思わずおちんちんが勃起してしまっていて、衣装の前たれの部分が盛り上がる\n（ショタのくせに物は立派で、力強く押し上げます）\n\n・それを見た利根が「しょうがないの～」という感じで\nショタ提督の乳首をいじりながらおちんちんを手コキしてあげる", "nc": 41, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@shamom0_/works/21", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/699d4ddd/uploads/origins/86c0db71-4412-460b-b38f-bf49d0289816?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=e4af5c13a789d7e24bb50f31b7cb460c", "src_set": ""}, "private": true, "genre": "art", "tipped": true, "creator_id": 2465721, "client_id": 0, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 49, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@shamom0_/works/20", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/a698bc76/uploads/origins/8c4acafc-0c9d-40ed-9311-34b91d3cd45d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=a6dd82f56c7f70c4d4c1ee936ac1e05f", "src_set": ""}, "private": true, "genre": "art", "tipped": false, "creator_id": 2465721, "client_id": 461653, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 32, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@shamom0_/works/19", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2465721, "client_id": 826