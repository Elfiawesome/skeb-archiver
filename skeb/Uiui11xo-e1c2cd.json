folders/1afoaBSTEXilSoGCGFEE33sCEGhf7z_3y?usp=drive_link\n\n衣装や髪型は描きやすい形でアレンジしていただいても大丈夫ですが、帽子はかぶった状態でお願いいたします。\n\n【サイズ、形式】\nサイズはお任せいたします。\n可能でしたらキャラクター、背景等が別れているPSDファイルを希望いたします。\n難しい場合は人物のみ透過したものをいただければと思います。\n\nお忙しい中大変恐縮ですが、御検討頂けたら幸いです。よろしくお願い致します。", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Uiui11xo/works/5", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/5deb84a5/uploads/origins/9c101215-74a2-43dc-9b34-b2fd11571fa7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=c4128099ee3b0b6f58ca063cd42f8994", "srcset": "https://si.imgix.net/5deb84a5/uploads/origins/9c101215-74a2-43dc-9b34-b2fd11571fa7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=c4128099ee3b0b6f58ca063cd42f8994, https://si.imgix.net/5deb84a5/uploads/origins/9c101215-74a2-43dc-9b34-b2fd11571fa7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=0e59a956bf5676aaf14188a6ba028c93 2x, https://si.imgix.net/5deb84a5/uploads/origins/9c101215-74a2-43dc-9b34-b2fd11571fa7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=c2ae22a789af12a1a0d7a9b680419468 3x"}, "private": true, "genre": "art", "tipped": false, "creator_id": 2528410, "nc": 129}, {"path": "/@Uiui11xo/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2528410, "client_id": 2618819, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/a19080f7/uploads/origins/50cdf34d-3f8d-4ab9-bb49-e14f0b58a88b?bg=%23fff&auto=format%2Ccompress&fm=we