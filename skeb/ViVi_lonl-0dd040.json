】\n特に決まっておりませんのでお任せでお願いします🙌🏻距離近めだと嬉しいです🥹\n\n【服装】\nこちらも希望は特にありません、資料内にある物から選んでいただければなと思っておりますㅠㅠ\n以前と同じ服装でも大丈夫です❤︎\n\n\n【NG】\n詩乃🚺\n口を大きく開けて笑う\n暁人🚹に対して威圧的な態度(喧嘩シチュ等はok)\n露出の多い服装\n\n暁人🚹\n詩乃を嫌っているような表情\n暗めの表情\n\n┈┈┈┈┈┈┈┈┈┈┈┈┈┈┈┈┈┈┈\n【使用用途】\nSNSのアイコン/個人使用\n\n【ファイル形式】\n指定等ございません🙌🏻人物の透過頂けたら幸いです！\n\n【資料】\nhttps://drive.google.com/drive/folders/1OsmcNotHyhnUU_ctKz5Ozw6jXYADBB6i\n\n┈┈┈┈┈┈┈┈┈┈┈┈┈┈┈┈┈┈┈\n\n金額や詳細等で不足な点ございましたら再送お願いします🙏🙇‍♀️\nお忙しい所恐れ入りますが良ければご検討お願いします🍀︎\n\nhttps://drive.google.com/drive/folders/1OsmcNotHyhnUU_ctKz5Ozw6jXYADBB6i", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@ViVi_lonl/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3723932, "client_id": 2282841, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/ebca6c2d/uploads/origins/02ed9321-b2f7-4a31-977a-e07d68733e2d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=eda6deb17ccb8bd5650e86c886c194d9", "srcset": "https://si.imgix.net/ebca6c2d/uploads/origins/02ed9321-b2f7-4a31-977a-e07d68733e2d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=eda6deb17ccb8bd5650e86c886c194d9, https://si.imgix.net/ebca6c2d/uploads/origins/02ed9321-b2f7-4a31-977a-e07d68733e2d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=bb58dd09f35b6f5e75843400281ceb0e 2x, https://si.imgix.net/ebca6c2d/uploads/origins/02ed9321-b2f7-4a31-977a-e07d68733e2d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=0368a90218f75a1128e11e18ef4c2a15 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/ebca6c2d/uploads/origins/02ed9321-b2f7-4a31-977a-e07d68733e2d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=da062064605887c4c02c53eeea3dfd5c", "srcset": "https://si.imgix.net/ebca6c2d/uploads/origins/02ed9321-b2f7-4