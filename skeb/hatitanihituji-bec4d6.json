i/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3305853, "client_id": 3664480, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/8effa302/uploads/origins/53641a51-8437-4031-a8aa-50010fcbf2d2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d76a0882190a47536b571cee3ca18825", "srcset": "https://si.imgix.net/8effa302/uploads/origins/53641a51-8437-4031-a8aa-50010fcbf2d2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d76a0882190a47536b571cee3ca18825, https://si.imgix.net/8effa302/uploads/origins/53641a51-8437-4031-a8aa-50010fcbf2d2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=984130edcd7a440253649d89177e7b86 2x, https://si.imgix.net/8effa302/uploads/origins/53641a51-8437-4031-a8aa-50010fcbf2d2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=43e4fdbbd462d83587c3703ac40b76eb 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/8effa302/uploads/origins/53641a51-8437-4031-a8aa-50010fcbf2d2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0f25fbc6f434324620acc4f672a09ee4", "srcset": "https://si.imgix.net/8effa302/uploads/origins/53641a51-8437-4031-a8aa-50010fcbf2d2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0f25fbc6f434324620acc4f672a09ee4, https://si.imgix.net/8effa302/uploads/origins/53641a51-8437-4031-a8aa-50010fcbf2d2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=baccae3a050db5c8f84e6157b5066123 2x, https://si.imgix.net/8effa302/uploads/origins/53641a51-8437-4031-a8aa-50010fcbf2d2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=6feb206090a4b101742e68100ab24c9e 3x"}, "body": "あなたの絵が大好きです。この画像のように、私のオリジナルキャラクターを、アニメ『ちいかわ』のモモンガの着ぐるみ姿で描いていただけませんか？ポーズと着ぐるみのデザインは、こちらのあなたの作品と同じ感じでお願いします：https://skeb.jp/@hatitanihituji/works/1\n\n\nキャラクターリンク/参考画像: https://toyhou.se/27195219.rika", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@hatitanihituji/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3305853, "client_id": 1763248, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/bdf83eaa/uploads/origins/1ae87d4b-5110-4cb5-86d7-f254bb76e1f6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1e931ffea69422e1c8e6451f3ffc899a", "srcset": "https://si.imgix.net/bdf83eaa/uploads/origins/1ae87d4b-5110-4cb5-86d7-f254bb76e1f6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1e931ffea69422e1c8e6451f3ffc899a, https://si.imgix.net/bdf83eaa/uploads/origins/1ae87d4b-5110-4cb5-86d7-f254bb76e1f6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=998f1139596206197f43f5e02066e174 2x, https://si.imgix.net/bdf83eaa/uploads/origins/1ae87d4b-5110-4cb5-86d7-f254bb76e1f6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=bfc9096d75d9080039dcea43d9d73f62 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/bdf83eaa/uploads/origins/1ae87d4b-5110-4cb5-86d7-f254bb76e1f6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=23c79d9fe2586a87c667e94f19da3fd7", "srcset": "https://si.imgix.net/bdf83eaa/uploads/origins/1ae87d4b-5110-4cb5-86d7-f254bb76e1f6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=23c79d9fe2586a87c667e94f19da3fd7, https://si.imgix.net/bdf83eaa/uploads/origins/1ae87d4b-5110-4cb5-86d7-f254bb76e1f6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=f658e2f3d630e3dd87842bd29ab7e264 2x, https://si.imgix.net/bdf83eaa/uploads/origins/1ae87d4b-5110-4cb5-86d7-f254bb76e1f6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=cb22ca004a156ddb7f97e8d516269a65 3x"}, "body": "お世話になります。\n突然ですがピクシブの絵を拝見してて惹かれました。\nまだリクエストを募集されてましたらお願いを聞いて頂けますか？\n\n以下は詳細になります。\n\n【キャラクター】ブルーアーカイブから「銀鏡イオリ」\n【内容】イオリに先生の包茎チンポを皮フェラをしてもらって大量にぶっかけをするシチュをお願いします！\nシチュとしては…\n俯瞰視点でお願いします。\n激務に追われてる先生に対して軽い罵声と叱咤激励を交えつつ、奉仕する感じで先生の包茎マラの皮の中に舌を入れたり、亀頭を口に含んだりして丁寧にフェラチオする。\nその後はイオリの褐色肌に白濁とした精液を大量にぶっかけるという感じで。\n\nぶっかけ描写がとても素晴らしかったのでリクエストさせて頂きました。\nご都合が悪かったりした場合は遠慮なくキャンセルしていただいて構いません。\nご検討をお願いします。", "nc": 48, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@hatitanihituji/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3305853, "client_id": 360823, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/b2b5c862/uploads/origins/a49cbffd-41f6-4c72-81de-fe35c0135c6b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c04d8347128410a71c8010c3480a77ee", "srcset": "https://si.imgix.net/b2b5c862/uploads/origins/a49cbffd-41f6-4c72-81de-fe35c0135c6b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c04d8347128410a71c8010c3480a77ee, https://si.imgix.net/b2b5c862/uploads/origins/a49cbffd-41f6-4c72-81de-fe35c0135c6b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f703114651adfb606221a11bf60a4623 2x, https://si.imgix.net/b2b5c862/uploads/origins/a49cbffd-41f6-4c72-81de-fe35c0135c6b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e5843dbb806e5a0cce707994a37813a3 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/b2b5c862/uploads/origins/a49cbffd-41f6-4c72-81de-fe35c0135c6b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=cbeacdd4c03bea98dd15829f5a51aa1d", "srcset": "https://si.imgix.net/b2b5c862/uploads/origins/a49