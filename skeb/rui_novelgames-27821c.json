s/origins/f57e3011-b631-4154-b06c-d61411b07e39?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=09dd52f48c9996dc01460bcd42fcd200 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/141ad3ab/uploads/origins/f57e3011-b631-4154-b06c-d61411b07e39?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6b8f2c874ef79dddf8346757f1f2503c", "srcset": "https://si.imgix.net/141ad3ab/uploads/origins/f57e3011-b631-4154-b06c-d61411b07e39?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6b8f2c874ef79dddf8346757f1f2503c, https://si.imgix.net/141ad3ab/uploads/origins/f57e3011-b631-4154-b06c-d61411b07e39?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=a11544e22cf5380ed2d0263c7aee311b 2x, https://si.imgix.net/141ad3ab/uploads/origins/f57e3011-b631-4154-b06c-d61411b07e39?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=c2d00d6d4bba938593c156608f2172d7 3x"}, "body": "ねえ、キャラクターをデザインしてくれない？\n\n詳細はこちら\n外見。\nこのキャラクターはヴォイドの深部から来た存在で、ヴォイドを取り囲む虚無と闇から産み落とされたものである。彼は純粋な悪のクリーチャーで、青白い肌と輝く真紅の目を持ち、まさに現実の布を突き通すかのようです。悪魔の翼を持つ人間のような姿をしており、長く鋭い、半分壊れたような悪魔の角を1本（右側）持っている。\n\n服装\nこのキャラクターの服装は、その外見と同様に暗く不吉なものである。彼は光を吸収するような黒く輝く素材でできた長く流れるようなローブを着ている。ローブには複雑な模様と記号が描かれており、別世界のエネルギーが脈打つように見える。\n\n武器\n彼の主な武器は、暗い悪魔のエネルギーが込められた巨大な両手剣である。剣は夜のように黒く、周囲の光を吸い込むかのようである。非常に悪魔的で威圧的な印象を与える。\n\nあなたが好きなもの、またはふさわしいと思うものを自由に追加してください。\nありがとうございました。", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 2415168, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "ゴライアス", "screen_name": "susakuttko1", "avatar_url": "https://pbs.twimg.com/profile_images/2030613314234191872/nxqW9IDn.jpg", "header_url": "https://pbs.twimg.com/profile_banners/2169684474/1692106889/1500x500", "appeal_receivable": tru