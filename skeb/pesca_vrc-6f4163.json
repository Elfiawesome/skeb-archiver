今のは違くて……！\nわ、私は別に……その……！\nっっ〜〜！\nもうっ！　何言わせるのっ、ばかぁ〜！\n\n以上です。\nご多忙であるかと存じますので、納品までのお日にちはゆっくりで大丈夫です。\nよろしくお願いします！", "nc": 129, "word_count": 0, "transcoder": "audio", "creator_acceptable_same_genre": true}, {"path": "/@pesca_vrc/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "voice", "tipped": true, "creator_id": 556010, "client_id": 864827, "vtt_url": "https://fcdn.skeb.jp/uploads/outputs/c61f2cbe-a80b-4552-8c91-88d9ce913328?response-content-disposition=inline&Expires=1781022885&Signature=UzidK2hNZPunIgRPM1VFMQL1w2UfubBnVgAqzLeuI6wrNry6d2F3rz8Mv3-~LDSnZ3H3dxiYm5P9uJiUlbY~WcrueDINfRnyjSugtlB2-h02slKRUFnoLj41maKwg-KQtR-tGJkNlc~1shPYDThZCJmyn6A46TMRMDqavQG26rGds89F15uF6OnXS-kjUKMdF7a2ylVGdEGGDEl46am6l9uKm-543dfDNNAfLxX-TsN5QvZYXfS0j7dwIcVkWxcdAyAXJAlHqzS-3pN1AJtsh1kv5daa9yMysSKD-71OewiVmPAWKUyG9uKXaCY2L3~CUkS4L0Q--0eg9V4t6UPt7Q__&Key-Pair-Id=K1GS3H53SEO647", "thumbnail_image_urls": {"src": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1921769434798317568%2FarIABPyZ.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5cbac6775dc08341650c8d0d4aa61bf2", "srcset": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1921769434798317568%2FarIABPyZ.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5cbac6775dc08341650c8d0d4aa61bf2, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1921769434798317568%2FarIABPyZ.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=8ca2812cffa0f0ef7d9b751b2e56800c 2x, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1921769434798317568%2FarIABPyZ.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e74738285d06564f4cf5062ab0e6545c 3x"}, "preview_url": "https://fcdn.skeb.jp/uploads/outputs/c8c59bba-48dc-4f1c-84e1-bae0a4e8ff7f?response-content-disposition=inline&Expires=1781022885&Signature=gO4jovkkq