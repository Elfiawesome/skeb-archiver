て使いたいので画像は明るめだと嬉しいです。\n\n画像のサイズはスマホの壁紙にしたいので1334 x 750だと嬉しいですが、難しいようなら縦に長いなら何でも構いません。\n\nどんな絵が欲しいかについてですが、基本的にはおまかせいたします。もし可能であれば表情は悪戯っぽくお姉さんだけど可愛い感じでお願いいたします！色気のあるポーズだと嬉しいです。\n\nちなみに写真だと分かりづらいかもしれないので補足ですが、光っているのはアクセサリー類です。(特にイヤリングは分かりにくいかも知れません)私のアバターの写真以外に元の衣装のリンクを貼っておきますので、良かったら参考になさってください。\n\n最後になりますが、いつも素敵な絵をありがとうございます。未だに頂いた絵は定期的に見て元気を頂いてます！\n\nまたご縁があったらとても嬉しいです！\n\nhttps://extension.booth.pm/items/5114918\n\nhttps://drive.google.com/drive/folders/1sikBWpqyQ2vZQLnUl-iTrCsL4zGQWQW0", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@takoyakitakonu/works/29", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1857970, "client_id": 556010, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/29f3c984/uploads/origins/e1a982c0-3683-4fcb-a6e4-94aa51d1e967?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f9277732bf4528c7f12b9dbdc493f95e", "srcset": "https://si.imgix.net/29f3c984/uploads/origins/e1a982c0-3683-4fcb-a6e4-94aa51d1e967?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f9277732bf4528c7f12b9dbdc493f95e, https://si.imgix.net/29f3c984/uploads/origins/e1a982c0-3683-4fcb-a6e4-94aa51d1e967?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a0e7798d4c5dfae534e2d796e335a57c 2x, https://si.imgix.net/29f3c984/uploads/origins/e1a982c0-3683-4fcb-a6e4-94aa51d1e967?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=884382680e1fea78e998b8d7814a81fb 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/29f3c984/uploads/origins/e1a982c0-3683-4fcb-a6e4-94aa51d1e967?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=8223f4b4d5165a5bdd5536f775636428", "srcset": "https://si.imgix.net/29f3c984/uploads/origins/e1a982c0-3683-4fcb-a6e4-94aa51d1e967?bg=%23fff&aut