特徴で、イメージカラーは白・水色・青色です。\nネモフィラがモチーフで、ぱっつん前髪、ピンクと雲のヘアピン、毛先に少し青紫が入った髪色が特徴です。\n\n【キービジュアル等】\nhttps://lit.link/hakkaasmr\n\n【使用用途】\n・はっかちゃんへのファンアートとしてプレゼント\n・SNSでの使用\n・収益化しているYouTubeチャンネルでのサムネイル使用\n\n【納品形式】\n可能でしたら、キャラクターや背景などを分けたレイヤー構成の透過PNGデータをご用意いただけますと幸いです。\n（難しい場合は通常の納品形式でも問題ございません。）\n\n以上がご依頼内容となります。\nご検討いただけますと幸いです。\nよろしくお願いいたします。\n\nhttps://lit.link/hakkaasmr", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@u_e_o_o/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2797006, "client_id": 2042944, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/13cc805e/uploads/origins/89601c69-8a6c-499d-b594-b26314aaf1eb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4d197bfc748492c5dcd47c9ff947aa5f", "srcset": "https://si.imgix.net/13cc805e/uploads/origins/89601c69-8a6c-499d-b594-b26314aaf1eb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4d197bfc748492c5dcd47c9ff947aa5f, https://si.imgix.net/13cc805e/uploads/origins/89601c69-8a6c-499d-b594-b26314aaf1eb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a6f26ad51093ec0e94f3f1fcbbd90d14 2x, https://si.imgix.net/13cc805e/uploads/origins/89601c69-8a6c-499d-b594-b26314aaf1eb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=59a931495464c0f789b20737504cce8b 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/13cc805e/uploads/origins/89601c69-8a6c-499d-b594-b26314aaf1eb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a54db99232c0de51444cf7f31b726b00", "srcset": "https://si.imgix.net/13cc805e/uploads/origins/89601c69-8a6c-499d-b594-b26314aaf1eb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a54db99232c0de51444cf7f31b726b00, https://si.imgix.net/13cc805e/upl