a6e/uploads/origins/393d9913-e742-4087-9096-7be41440cbd9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=4d58f58ec7ef65d813360d7f401e9133, https://si.imgix.net/a5b98a6e/uploads/origins/393d9913-e742-4087-9096-7be41440cbd9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=37bc92d439b02c7d36758c66fccec292 2x, https://si.imgix.net/a5b98a6e/uploads/origins/393d9913-e742-4087-9096-7be41440cbd9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=d4ca438ee5e77a3b1a87ac9deda3dd7a 3x"}, "body": "上尾アイ様 初めまして。\n上尾アイ様の可愛らしく素敵なイラストが上がるのをいつもXで楽しみにさせてもらっています。\n今回は上尾アイ様に個人Vtuber『かなめうと』のイラストを依頼させていただきたく、ご連絡いたしました。\n\n ⚫︎かなめうとについて \n眠ることとおしゃべりが大好きな、垂れ耳うさぎのお姉さん。雑談配信をメインにYouTubeで活動しております。\n\n ⚫︎参考資料 \nかなめうと公式ホームページ\nhttps://kanameu10works.wixsite.com/kanameuto\n\n\n ⚫︎依頼内容 \nファンアートとして本人にプレゼントしたいなと考えております。\nお部屋でゆったりとくつろいでいるかなめうとさんを描いていただきたいです。\n細かな構図や背景は上尾アイ様にお任せいたします。柔らかで可愛らしさのある笑顔または微笑んでいる表情でお願い致します。\n\n\n ⚫︎使用用途\n ・依頼者本人の私的範囲での個人利用 \n・かなめうとの活動での使用（収益化済みYouTubeチャンネルでのサムネイルやSNSでの宣伝活動など）\n\n ⚫︎納品形式 \n可能であればpsd、または人物のみの透過pngにてお願いいたします。人物と背景のレイヤーは分けて制作いただけますと幸いです。\n\n 以上、お忙しい中恐れ入りますがご検討のほどよろしくお願いいたします。", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@u_e_o_o/works/8", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2797006, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/ef76071a/uploads/origins/da26b0ff-e374-46a0-9494-2ef348a515c3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=75e216f041dd93df82f984c254fc47f0", "srcset": "https://si.imgix.net/ef76071a/uploads/origins/da26b0ff-e374-46a0-9494-2ef348a515c3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=75e216f041dd93df82f984c254fc47f0, https://si.imgix.net/ef76071a/uploads/origins/da26b0ff-e374-46a0-9494-2ef348a515c3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=37e88b7683eace8770c5e5b0aa8bf27d 2x, https://si.imgix.net/ef76071a/uploads/origins/da26b0ff-e374-46a0-9494-2ef348a515c3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ac91ff514b1adff5e753d581d1abb904 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/ef76071a/uploads/origins/da26b0ff-e374-46a0-9494-2ef348a515c3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=66091559da643fde88381aa91a4459b1", "srcset": "https://si.imgix.net/ef76071a/uploads/origins/da26b0ff-e374-46a0-9494-2ef348a515c3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=66091559da643fde88381aa91a4459b1, https://si.imgix.net/ef76071a/uploads/origins/da26b0ff-e374-46a0-9494-2ef348a515c3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=7e6365edf744bb5f1caefdf26945a62b 2x, https://si.imgix.net/ef76071a/uploads/origins/da26b0ff-e374-46a0-9494-2ef348a515c3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=06fb0cc2b904aaf7236ea89d69e42cf1 3x"}, "body": "いつも素敵な作品を拝見しております！\n先生の描かれる空気感や、キャラクターのやわらかい雰囲気が本当に大好きです！\nこのたびはお時間をいただき、誠にありがとうございます。\n今回は、OC「宇宙（Uchuu）」の単体イラストをご依頼したいです。\n\n宇宙は160cmの人間女性で、動物医学を専門とする医学研究者です。やさしく静かな性格です。\n詳しい外見資料は添付画像をご参照いただけますと幸いです。\n構図は横長で、背景付きの一枚絵を希望しております。\n雰囲気としては、居家で一緒に過ごしているような恋人感、または優しく落ち着いた学姐・先輩感のあるイラストにしていただけますと嬉しいです。\n日常の中に少し特別な空気があるような、あたたかく柔らかいシーンを希望しております。\nもし元の衣装が複雑すぎる場合は、無理にそのまま描いていただかなくても大丈夫です。\n場面や背景の雰囲気に合わせて、宇宙らしさを残した新しい衣装にアレンジ・デザインしていただけますと幸いです。\n構図、表情、ポーズ、背景、衣装の細部などは、ぜひ先生のご感性にお任せしたいです。\n\n使用用途：本人のVTuber活動全般（配信サムネイル、SNSアイコンやヘッダー・告知、ファンクラブ特典など）\n\n可能でしたらPSD形式での納品を希望しております！\nまた、もし表情差分や表情パーツの分けが可能でしたら大変嬉しいですが、難しい場合はまったく問題ございません。\n\nもし現在の金額では難しい場合は、お手数をおかけしますが、いつでも金額変更をご提案いただけますと幸いです。\nお忙しいところ恐れ入りますが、ご検討いただけますと幸いです。\n何卒よろしくお願いいたします。\n\n参考：\nhttps://skeb.jp/@u_e_o_o/works/4\nhttps://x.com/u_e_o_o/status/1994710952965804364/photo/1\n\nhttps://drive.google.com/drive/folders/1vJQszoBKSYnjkYbXFW0Jg3tJP2fzaLkm?usp=drive_link", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@u_e_o_o/works/7", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/04c56160/uploads/origins/20fd76a6-dfff-4c2f-b03b-e02a7cc7df42?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=ac38cdff843488640d0212976097d0d6", "srcset": "https://si.imgix.net/04c56160/uploads/origins/20fd76a6-dfff-4c2f-b03b-e02a7cc7df42?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=ac38cdff843488640d0212976097d0d6, https://si.imgix.net/04c56160/uploads/origins/20fd76a6-dfff-4c2f-b03b-e02a7cc7df42?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=ab49302ca5241cb0b331e58c5d0794c6 2x, https://si.imgix.net/04c56160/uploads/origins/20fd76a6-dfff-4c2f-b03b-e02a7cc7df42?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=0bf6dca021f3e05983faf2ad698d636f 3x"}, "private": true, "genre": "art", "tipped": false, "creator_id": 2797006, "client_id": 2493595, "nc": 0}, {"path": "/@u_e_o_o/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2797006, "client_id": 3828348, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/149173f8/uploads/origins/b38bb5df-9cf6-4fbe-bd27-5486a8110677?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=64bbb78d34f1acab37b642cb9fb732bc", "srcset": "https://si.imgix.net/1