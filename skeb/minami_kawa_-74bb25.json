d4a-4766-928e-3cc139ecbaeb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=aab84169de1ad695266882b7ecb72abf 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/4f43b1b3/uploads/origins/8080b17a-5d4a-4766-928e-3cc139ecbaeb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=86106649d25b0c508e8e6cf5cf5ec00d", "srcset": "https://si.imgix.net/4f43b1b3/uploads/origins/8080b17a-5d4a-4766-928e-3cc139ecbaeb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=86106649d25b0c508e8e6cf5cf5ec00d, https://si.imgix.net/4f43b1b3/uploads/origins/8080b17a-5d4a-4766-928e-3cc139ecbaeb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=cdae32a60983cfec816506158e5263ea 2x, https://si.imgix.net/4f43b1b3/uploads/origins/8080b17a-5d4a-4766-928e-3cc139ecbaeb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=23e533032265176816764446046fc5ca 3x"}, "body": "Hello!\n\nWe love your art and style. We have been following you for a while and finally decided to make a request!.\n\nPlease draw Witch Mawy (@NekoWitchMary) as a miko maiden. She really loves catgirls and one day wants to build a secret shrine of her own.\nAny style will do, but make her smile brightly and widely! If it is better, you can also draw her hair in a light color or even light blue, completely up to you.\n\nWe wish you a great luck and thanks!\nFuki and Mawy\n\nWitch Mawy reference: https://imgur.com/a/HUVbBIg\n\nこんにちは！\n\nあなたのアートとスタイルが大好きです。しばらくあなたをフォローしていましたが、ついにリクエストすることにしました！\n\n魔女マウィ（@NekoWitchMary）を巫女として描いてください。彼女は猫娘が大好きで、いつか自分の秘密の神社を建てたいと考えています。\n\nどんなスタイルでも構いませんが、明るく大きく笑ってください！もっと良い場合は、彼女の髪を明るい色や水色で描くこともできます。完全にあなた次第です。\n\n幸運をお祈りします。ありがとうございます！\nフキちゃんとマウイ\n\nWitch Mawy reference: https://imgur.com/a/HUVbBIg\n\nhttps://imgur.com/a/HUVbBIg", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@minami_kawa_/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 5971, "client_id": 2652, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/0b898ba5/uploads/origins/a2632796-f411-4d49-8836-be1aa7a310ad?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3607c46a3dce55da8598600249f4de11", "srcset": "https://si.imgix.net/0b898ba5/uploads/origins/a2632796-f411-4d49-8836-be1aa7a310ad?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3607c46a3dce55da8598600249f4de11, https://si.imgix.net/0b898ba5/uploads/origins/a2632796-f411-4d49-8836-be1aa7a310ad?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=40bcbadc67f2a1e0efafec3ba0ae3448 2x, https://si.imgix.net/0b898ba5/uploads/origins/a2632796-f411-4d49-8836-be1aa7a310ad?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=5818aece2ed52106ee1b6642c7b9c8b3 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/0b898ba5/uploads/origins/a2632796-f411-4d49-8836-be1aa7a310ad?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2672535d842f9744b600e8224c771ad1", "srcset": "https://si.imgix.net/0b898ba5/uploads/origins/a2632796-f411-4d49-8836-be1aa7a310ad?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2672535d842f9744b600e8224c771ad1, https://si.imgix.net/0b898ba5/uploads/origins/a2632796-f411-4d49-8836-be1aa7a310ad?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=97c0177c1238c64f474b18335adfbbde 2x, https://si.imgix.net/0b898ba5/uploads/origins/a2632796-f411-4d49-8836-be1aa7a310ad?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=40bc22cd70ba807fd8e0758c59d79a82 3x"}, "body": "こんにちは。\n\n懐かしキャラですが、小百合ちゃんは可能でしょうか？\nお請けいただけるようでしたら、内容は\"メイド服を着ていること\"以外は全てお任せします。\nメイド服も、定番の紺や黒以外でも緑とか他の色もありましたので、色もご自由で。\n\nよろしくお願いします。", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@minami_kawa_/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 5971, "client_id": 1547770, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/99a4eb41/uploads/origins/62f1889c-c899-455e-bb49-013907232862?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d61ad94c7667631f74124f89e4e21676", "srcset": "https://si.imgix.net/99a4eb41/uploads/origins/62f1889c-c899-455e-bb49-013907232862?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d61ad94c7667631f74124f89e4e21676, https://si.imgix.net/99a4eb41/uploads/origins/62f1889c-c899-455e-bb49-013907232862?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a18d53e28627369742e286a8b70e4155 2x, https://si.imgix.net/99a4eb41/uploads/origins/62f1889c-c899-455e-bb49-013907232862?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=383b2c4e263b9206c380be790da3e786 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/99a4eb41/uploads/origins/62f1889c-c899-455e-bb49-013907232862?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=84aec26465065527d21058125282fab4", "srcset": "https://si.imgix.net/99a4eb41/uploads/origins/62f1889c-c899-455e-bb49-013907232862?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=84aec26465065527d21058125282fab4, https://si.imgix.net/99a4eb41/uploads/origins/62f1889c-c899-455e-bb49-013907232862?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=4637405f4bc36cc52d200b9a323618d6 2x, https://si.imgix.net/99a4eb41/uploads/origins/62f1889c-c899-455e-bb49-013907232862?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=37ba65844ab80d2dbe7702c91c1ba762 3x"}, "body": "狐の嫁入りイラストをお願いします\n\n表情　結婚式を控え、はにかみつつも嬉しそう、又は幸せそうに微笑んでる\n(上記に限らず、幸せそうな感じであれば嬉しいです。嬉し泣き等も可)\n\n特徴　けもみみ(キツネ耳)\n\n髪のスタイル　おまかせします\n髪の色　おまかせします\n\n服装　白無垢\n服の色　白　又は少し黄色味のある白色等　(お好きな他色を薄く混ぜ可。模様等もご自由に)\n\n使用しないで欲しい物のお願い(小物や背景、装飾品で使用は可)\n綿帽子(頭の被り物)　なし　(ケモミミが隠れるため。半透明のものは可)\n赤色和傘の所持　なし　(人物より目立つため)\n狐のお面の装着　なし　(顔が隠れるため。斜め掛けや所持は可)\n\nその他の装飾品や小物等はおまかせします\n\n季節　春～秋\n　　　（本榊の花を装飾品に使用する場合は７月設定で。)\n天候　天気雨又は、雨上がりの晴れ\n（季節と天候は参考情報です。季節と天候は気にせず自由に描いてください）\n\n構図、解像度はおまかせします。大サイズのイラストだと嬉しいです\n展覧用のため、宛名はナシでお願いします\n\n使用用途\nSkeb規約に準拠、キツネ関連の振興で使用(広報・地域の祭り等、非商用に限る)\n\n参考資料等\nhttps://twitter.com/pinsuke_m/status/1459135013924978694\n（着物等の参考に）\n\nポストカードに登場していた小さな狐さん等も歓迎です\n装飾等、綺麗に飾り付けしてただけると嬉しいです\n\nご検討お願いします", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 490057, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "平賀まつり", "screen_name": "hiraga_matsuri", "avatar_url": "https://pbs.twimg.com/profile_images/1869399924431073281/6LKgxcV6.jpg", "header_url": "https://pbs.twimg.com/profile_banners/18073825/1643924537/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 5, "complete_expiration_days": 60, "skills": [{"genre": "art"}, {"genre": "video"}], "banned": false, "nc": 161}, {"id": 615988, "creator": true, "nsfw_acceptable": false, "acceptable": false, "name": "RIRIPOINYA", "screen_name": "riripoinya", "avatar_url": "https://pbs.twimg.com/profile_images/1996849940447088644/A3CWXKzv.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1222600105879990272/1764921472/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "