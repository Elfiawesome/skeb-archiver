et/4f43b1b3/uploads/origins/8080b17a-5d4a-4766-928e-3cc139ecbaeb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0b07ef399e5f5aa50f8285eea80d8cd8, https://si.imgix.net/4f43b1b3/uploads/origins/8080b17a-5d4a-4766-928e-3cc139ecbaeb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=2e7ecda558874c905159813e61d85b09 2x, https://si.imgix.net/4f43b1b3/uploads/origins/8080b17a-5d4a-4766-928e-3cc139ecbaeb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=aab84169de1ad695266882b7ecb72abf 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/4f43b1b3/uploads/origins/8080b17a-5d4a-4766-928e-3cc139ecbaeb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=86106649d25b0c508e8e6cf5cf5ec00d", "srcset": "https://si.imgix.net/4f43b1b3/uploads/origins/8080b17a-5d4a-4766-928e-3cc139ecbaeb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=86106649d25b0c508e8e6cf5cf5ec00d, https://si.imgix.net/4f43b1b3/uploads/origins/8080b17a-5d4a-4766-928e-3cc139ecbaeb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=cdae32a60983cfec816506158e5263ea 2x, https://si.imgix.net/4f43b1b3/uploads/origins/8080b17a-5d4a-4766-928e-3cc139ecbaeb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=23e533032265176816764446046fc5ca 3x"}, "body": "Hello!\n\nWe love your art and style. We have been following you for a while and finally decided to make a request!.\n\nPlease draw Witch Mawy (@NekoWitchMary) as a miko maiden. She really loves catgirls and one day wants to build a secret shrine of her own.\nAny style will do, but make her smile brightly and widely! If it is better, you can also draw her hair in a light color or even light blue, completely up to you.\n\nWe wish you a great luck and thanks!\nFuki and Mawy\n\nWitch Mawy reference: https://imgur.com/a/HUVbBIg\n\nこんにちは！\n\nあなたのアートとスタイルが大好きです。しばらくあなたをフォローしていましたが、ついにリクエストすることにしました！\n\n魔女マウィ（@NekoWitchMary）を巫女として描いてください。彼女は猫娘が大好きで、いつか自分の秘密の神社を建てたいと考えています。\n\nどんなスタイルでも構いませんが、明るく大きく笑ってください！もっと良い場合は、彼女の髪を明るい色や水色で描くこともできます。完全にあなた次第です。\n\n幸運をお祈りします。ありがとうございます！\nフキちゃんとマウイ\n\nWitch Mawy reference: https://imgur.com/a/HUVbBIg\n\nhttps://imgur.com/a/HUVbBIg", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@minami_kawa_/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 5971, "client_id": 2652, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/0b898ba5/uploads/origins/a2632796-f411-4d49-8836-be1aa7a310ad?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3607c46a3dce55da8598600249f4de11", "srcset": "https://si.imgix.net/0b898ba5/uploads/origins/a2632796-f411-4d49-8836-be1aa7a310ad?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3607c46a3dce55da8598600249f4de11, https://si.imgix.net/0b898ba5/uploads/origins/a2632796-f411-4d49-8836-be1aa7a310ad?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=40bcbadc67f2a1e0efafec3ba0ae3448 2x, https://si.imgix.net/0b898ba5/uploads/origins/a2632796-f411-4d49-8836-be1aa7a310ad?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=5818aece2ed52106ee1b6642c7b9c8b3 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/0b898ba5/uploads/origins/a2632796-f411-4d49-8836-be1aa7a310ad?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2672535d842f9744b600e8224c771ad1", "srcset": "https://si.imgix.net/0b898ba5/uploads/origins/a2632796-f411-4d49-8836-be1aa7a310ad?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2672535d842f9744b600e8224c771ad1, https://si.imgix.net/0b