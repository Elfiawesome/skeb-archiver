は自由に（ピンク、緑、白、赤、青など何でもOK）。髪の色は自然な黒で、根元を入れたり、少し伸ばしたりしたい場合は。日焼けした肌にご注目ください。\n\n仕事中は上品な服装が多いが、オフの時はカジュアルな服装も厭わない。服装の例は「服装」にあります。\n\n気遣いは人一倍深いが、わがままな面もある。よくデートをするが、すぐに別れてしまう。本当は愛されたいと思っているが、それを恐れている。人といても孤独を感じるタイプ。\n\n趣味はお化粧、ゲーム、バー通い。\n\nテーマとモチーフ：ワイン、夜更かし、孤独、自分に嘘をついているようで怖い。\n\n彼女に一番似合うと思うものを自由に描いてください。\n\nhttps://drive.google.com/drive/folders/1xcDA7818kEDbil5KyeU3M3eVlIdsLuew?usp=sharing", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@ARUKADIA1210/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3106548, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/5a675c1b/uploads/origins/f1c384fc-3a4d-42c8-9c5c-39f161711be1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3ffb2f1e6f4217cc1438838ba78dc7c2", "srcset": "https://si.imgix.net/5a675c1b/uploads/origins/f1c384fc-3a4d-42c8-9c5c-39f161711be1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3ffb2f1e6f4217cc1438838ba78dc7c2, https://si.imgix.net/5a675c1b/uploads/origins/f1c384fc-3a4d-42c8-9c5c-39f161711be1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=53a65f11c0aa8fcadc399279b0b9b5b6 2x, https://si.imgix.net/5a675c1b/uploads/origins/f1c384fc-3a4d-42c8-9c5c-39f161711be1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e4e3456927af8c53152cd261774a803e 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/5a675c1b/uploads/origins/f1c384fc-3a4d-42c8-9c5c-39f161711be1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=7ba8ac0888bb2686a9658b7e0d32eae3", "srcset": "https://si.imgix.net/5a675c1b/uploads/origins/f1c384fc-3a4d-42c8-9c5c-39f161711be1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=7ba8ac0888bb2686a9658b7e0d32eae3, https://si.imgix.net/5a675