ns/9d695d1b-2ecd-442e-976d-a8f2338d4eb7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=0f96132153f6595cfe7a4cb8dfead1d8 2x, https://si.imgix.net/1085d90c/uploads/origins/9d695d1b-2ecd-442e-976d-a8f2338d4eb7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=20d5430fb72c8384b333befd402545bc 3x"}, "body": "あーさんが以前描かれていた、ゆき、日曜、一突の漫画を読んでみたいです！\n\n気になっていたので(リクエスト‪‪では無い)\n･3人の関係性\n･ゆきちゃんと日曜くんは仲良しさん？\n･何者！家庭的な怪しいお兄さん一突さん(モテてそう\n\n我欲(という名の感想寄り)\n･個人的にゆきと日曜の会話もっと聞いてたい\n･もし仲良しさんなら日曜くん一突さんふみふみありですか\n･家族(血の繋がりなくても)のあったけえ話大好物\n\nふわっとした感じなんですが\nあーさんが描きたいもの描いてできた創作漫画読んでみたい侍なので以前考えてた子と変わったり今描きたい子とかでも大変美味しいです\n\n気が乗らなければぺっぺしてください！\nよろしくお願いします", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@ARUKADIA1210/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3106548, "client_id": 1958832, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/ab6fda72/uploads/origins/7944d6e6-c3ad-439d-9330-ad7875df3607?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=60fa177730b46f6b967c6feb10d8d0bd", "srcset": "https://si.imgix.net/ab6fda72/uploads/origins/7944d6e6-c3ad-439d-9330-ad7875df3607?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=60fa177730b46f6b967c6feb10d8d0bd, https://si.imgix.net/ab6fda72/uploads/origins/7944d6e6-c3ad-439d-9330-ad7875df3607?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c65900e7671f87f3301f82ee7994f8bc 2x, https://si.imgix.net/ab6fda72/uploads/origins/7944d6e6-c3ad-439d-9330-ad7875df3607?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=3b5485dcd7302630e577386f153a476f 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/ab6fda72/uploads/origins/7944d6e6-c3ad-439d-9330-ad7875df3607?bg=%23f