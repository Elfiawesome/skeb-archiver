して活動しております珈乃琲ノ樹（この ひのき）と申します。\n唐揚げだいちゃん様のポップでカラフルなイラストがとても可愛らしく、ぜひ私自身のイラストを描いていただきたいと思いご連絡いたしました。\n\n参考URLに私のキャラクターデザイン資料を添付いたしました。\n構図など詳細はお任せいたしますので、こちらを元にキャラクターイラストを制作いただけますでしょうか。\n唐揚げだいちゃん様のキュートな世界感で彩っていただきたいです。\nまた、可能であればポケットモンスターのキャラクター\"クワッス\"も添えてただけると大変嬉しいです。\n\n制作いただいたイラストはYoutube配信のサムネイル、Twitterへの投稿画像として使用させていただきたいと思っております。\nご無理でなければ背景が透過されたキャラクターイラストもいただけると幸いです。\n\nご検討の程何卒よろしくお願いいたします。\n\nhttps://www.dropbox.com/sh/p25r1i8q0i53jnb/AADSKxEZJy2KNaBcN6mySv4Ga?dl=0", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@miyabi_589/works/10", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1280375, "client_id": 2082896, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/68a042e1/uploads/origins/43cd6875-5242-4e8c-a71d-e0b9043557d9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=93c6b87c155be3c225255dbf92227dfa", "srcset": "https://si.imgix.net/68a042e1/uploads/origins/43cd6875-5242-4e8c-a71d-e0b9043557d9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=93c6b87c155be3c225255dbf92227dfa, https://si.imgix.net/68a042e1/uploads/origins/43cd6875-5242-4e8c-a71d-e0b9043557d9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=352a9ef77ec2fe1d76c22f4bc7c8ebf1 2x, https://si.imgix.net/68a042e1/uploads/origins/43cd6875-5242-4e8c-a71d-e0b9043557d9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=3339a4d3e106154de2eef0a09d437271 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/68a042e1/uploads/origins/43cd6875-5242-4e8c-a71d-e0b9043557d9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e16fcfd4f6062f21eed18c8f8046c926", "srcset": "https://si.imgix.net/68a042e1/uploads/origins/43cd6875-5242-4e8c-a71d-e0b9043557d9?bg=%23fff&auto=format%2Ccompress