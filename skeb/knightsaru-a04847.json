好\n野良着に、もんぺ、地下足袋履きで、手には紺の農作業用の手甲をつけています。\n野良着の色は紺で絣模様、\nもんぺはへその辺りで紐を結ぶ袴式、長さはくるぶしまでで、色、模様は濃い紫系の縞、\n脇は袴の様にスリットを開けてほしいです。\n地下足袋はくるぶしの上までの長さ、色は黒にしてほしいです。\n服装の大まかなイメージは資料urlをご参照ください。\nもんぺイメージ\nhttps://www.dropbox.com/s/27dregu6fv4xgh3/ms.jpg?dl=0\n地下足袋イメージ\nhttps://www.dropbox.com/scl/fi/0dlq0el8hrwkh15ocjvm7/tb.png?rlkey=id9szwe2vs7xqr6f46enheggn&st=gqb9dkf7&dl=0\n\n以上ご検討の程宜しくお願い致します。\n\nhttps://www.dropbox.com/scl/fi/wg5lyu8hc19bmf7ox91ll/si.png?rlkey=bqx1xzta6w4chhlusi4y5li7w&st=ifp4o0d9&dl=0", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@knightsaru/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3360234, "client_id": 806358, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/afb82190/uploads/origins/a011e87a-c95d-4b7a-b03a-136473ff5a3d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c1f11bcd97d9c4e097431a1373f33fa1", "srcset": "https://si.imgix.net/afb82190/uploads/origins/a011e87a-c95d-4b7a-b03a-136473ff5a3d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c1f11bcd97d9c4e097431a1373f33fa1, https://si.imgix.net/afb82190/uploads/origins/a011e87a-c95d-4b7a-b03a-136473ff5a3d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b3aed0e26036cf8ec42da57c90093ba2 2x, https://si.imgix.net/afb82190/uploads/origins/a011e87a-c95d-4b7a-b03a-136473ff5a3d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b00b3b9038fa0f886ce2dc4626b14ce4 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/afb82190/uploads/origins/a011e87a-c95d-4b7a-b03a-136473ff5a3d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=35e2c23b352e1d9a2a050bbf865309c7", "srcset": "https://si.imgix.net/afb82190/uploads/origins/a011e87a-c95d-4b7a-b03a-136473ff5a3d?bg=%23fff&auto=