b06b-414d-4ca0-979a-f4f42c6471fd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ea5caa7f4752b9c1444c7bc9cf80e7ed", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/dac5f055/uploads/origins/6360b06b-414d-4ca0-979a-f4f42c6471fd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0ed6dfb15aafe9a59fba5da81a153782", "src_set": ""}, "body": "タイキKAMEN Wlofと申します。この度は改めて私のXのアイコンイラストとくる次郎さん(@kuru4ru4)のアイコンイラストを使ったイラストをお願いしたくご依頼させていただきました。\n内容は仮面ライダーアマゾンズシーズン2に出てくる仮面ライダーの千翼（タイキKAMEN Wolf）と水澤悠（くる次郎）の変身前の格好をした私達のイラストをお願いしたいのですが。二人とも変身ベルトネオアマゾンズドライバーを付けてこれから2人並んで変身するような場面ででよろしくお願いします。2人とも両目が光ってる感じで、背後にはバイクをお願いします。\nくる次郎さんには許可をいただいております。\nもし可能であれば、どうかよろしくお願いいたします。", "nc": 32, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Asakura_kento/works/14", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/e916b8a8/uploads/origins/85b100a3-3729-44bc-bce8-8698f137c662?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=fbe3b23e21e423c5eb9fd013a7c3042f", "src_set": ""}, "private": true, "genre": "art", "tipped": false, "creator_id": 931879, "client_id": 0, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 161, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@Asakura_kento/works/13", "private_thumbnail_image_urls": null, "private": false, "genre": "comic", "tipped": true, "creator_id": 931879, "client_id": 2512996, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/d6bd24bc/uploads/origins/816db4cc-b55b-4e90-be3f-31716dc5eea3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=45d995215282f8cb3bc71006c797768a", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/d6bd24bc/uploads/origins/816db4cc-b55b-4e90-be3f-31716dc5eea3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9235760e1d2ba9bd75fdfeb875bce72a", "src_set": ""}, "body": "はじめまして。\n「もっちりノーマッド」の肉感が素晴らしかったので肥満化ものをリクエストいたします。\n検討のほどよろしくお願いします。\n\n【描いてほしい内容】\n巨漢ばかりの相撲部屋のような異界に迷い込んでしまったノーマッド\n相撲取りの生活をとらされるうちにむくむくと太っていく自身の体に焦りながらも\nデカくなっていく肉体に比例してチンポや金玉もデカくなり、食欲と性欲に溺れてしまう\n\n\n\n【入れてほしい内容・描写】\n■段階的な肥満化\n　しっかり筋肉がつきながらもどんどん脂肪も乗っていくパンパンに張った巨体にしてほしいです\n　ガッシリ体型→ガチデブ体型→「もっちりノーマッド」のようなもっちり体型→元の３人分以上は体積のあるでっぷり体型\n\n■最終段階のでっぷり体型\n　　自身の下半身にも満足に手が届かなさそうな巨体\n　　常に息荒く汗をかいておりむわりとくさい（住人たちはその体臭で興奮している）\n　　元の脚ぐらいありそうなデカチン\n　　常時精液を増産してムラムラしっぱなしのデカ玉\n　　肉の揺れや体のぶつけ合いで気持ちよくなり、四股踏みや相撲を取るだけで射精してしまう\n\n■（可能であれば）エロシーンを１枚描いてほしいです。\n　案１；先輩力士に根性注入として後ろから犯されて喘ぎながら「ごっつあんです」と感謝する。突かれるたび噴き出すような大量射精。\n　案２：蹲踞の姿勢をとり、デカディルドでデカ尻を犯しながら、乳首オナニーで噴水のような大量射精。\n　案３：どすこいと叫びながらの全裸四股踏み耐久中に大量射精。四股踏みをやめられず、喘ぎながら精液を噴き続ける。", "nc": 184, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Asakura_kento/works/12", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 931879, "client_id": 0, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/ef967645/uploads/origins/045a03c9-fac7-4908-9f93-6556e12bd721?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1de85a1c79271adda4331dd295964072", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/ef967645/uploads/origins/045a03c9-fac7-4908-9f93-6556e12bd721?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=472e5906acbf480328da01700022350f", "src_set": ""}, "body": "初めましてこんにちは。\n今回初めてskebのご依頼をさせて頂きます。\n自分は相撲オスケモが好みですので、下記のキャラをお願いします。\n \n描いていただきたいキャラ\n  \nzzz(ゼンゼロ)燃油改tvcmの虎・白熊力士\n二人ともアンコ型体型\nど