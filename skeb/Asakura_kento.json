%2Ccenter&txtsize=30&txt=PRIVATE&s=af08a673dfdbff9700810cb70c316106", "src_set": ""}, "private": true, "genre": "art", "tipped": false, "creator_id": 931879, "client_id": 29090, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 49, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@Asakura_kento/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 931879, "client_id": 436504, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/b30b9bbc/uploads/origins/6cbe1217-9a43-4d63-a426-ad267ee0761f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0568880f80d432bce095b73f3498d995", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/b30b9bbc/uploads/origins/6cbe1217-9a43-4d63-a426-ad267ee0761f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=24d260597d8017835ad572d2a1504392", "src_set": ""}, "body": "こんにちは〜\nヤクモくんの巨デブ化良かったので追随してまた可哀想な目に遭ってほしいのでリクエスト送ってみます\n\n過去改変攻撃とか催眠で夢を見させられてるみたいな設定で、なんかジュウくんと一緒に相撲やってるヤクモくんみたいな感じでお願いします\n\n巨デブ体型ではあるのですが、相撲やってるのでいちおう筋肉もちゃんとありつつ、競技特性上がっつり脂肪載せてるみたいな感じの肉体だと嬉しいです\nまわしを締めてるととてもいいですね。\n\n汗臭そうで動くとすぐフーフー言っちゃうようなデブ化してるし本人はなんか不思議だな？俺こんなんだっけ？って思っちゃうけど何もできない、みたいなそんなシチュエーションだといいかな\n肥満化&力士化みたいな感じで…\nなんか過去の上塗りされちゃって運命改変サれちゃうみたいなの萌えるんですよね\n\nシチュ的にはなんか相撲部の部室やら屋外やらで、俺なんでこんなことしてるんだろ？みたいに思いつつも相撲の稽古をしてる、みたいな感じがいいかな\nとりあえず拾えるところだけ拾っていただければ、シチュは自由にしていただいて構いません\nヤクモくんの肥満化と力士化が入ってると助かります、ってことで\nご一考ください〜", "nc": 56, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Asakura_kento/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 931879, "client_id": 0, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/d21447fd/uploads/origins/e5665abc-9172-4a6a-83c9-6a3247dca565?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5b0cff8feaeb892a90f04ea9b309a275", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/d21447fd/uploads/origins/e5665abc-9172-4a6a-83c9-6a3247dca565?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2683799c0814918c7b3a1661702ee64e", "src_set": ""}, "body": "タイキKAMEN Wlofと申します。この度は改めて私のXのアイコンイラストとくる次郎さん(@kuru4ru4)のアイコンイラストを使ったイラストをお願いしたくご依頼させていただきました。\n内容は仮面ライダーアマゾンズに出てくる仮面ライダーの水澤悠と鷹山仁の変身前の格好をした私達のイラストをお願いしたいのですが。二人とも変身ベルトを付けてこれから変身するような場面で、服装と顔は傷と返り血を浴びて汚れてるかたちで、二人とも向かい合わせの立ち位置でよろしくお願いします。\nくる次郎さんには許可をいただいております。\nもし可能であれば、どうかよろしくお願いいたします。", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Asakura_kento/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 931879, "client_id": 949153, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/7ee498b6/uploads/origins/7bfdc122-8446-4dbf-a9fb-50417c9645af?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=449326452388d1e6b0401988ca58e5f9", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/7ee498b6/uploads/origins/7bfdc122-8446-4dbf-a9fb-50417c9645af?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5bfb3b41955181190c54f9d233157a6b", "src_set": ""}, "body": "こんにちわ、あさくらけんとさん。\n登場人物の外見上の特徴は以下の通り：\nウルフ：緑色の目、灰色の舌、長い三つ編み、頭から三つ編みの端まで白い縞模様。\nポーラー：目を細め、青い舌と乳首とパッド。\n\nシーンとしたい：\n高校生のとき、若いシロクマが学校代表として格闘大会に出場し、オオカミはラウンジスペースに座って応援した。\n当時のオオカミは平均的な体格で、筋肉もあまりなかった。シロクマは背が高く筋肉質だったが、脂肪も厚かった。\n\nありがとうございました！\n\nhttps://drive.google.com/drive/folders/1uNIMaR2B7Qvv0cmLTFt1tZSaSik-WHBD?usp=drive_link", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Asakura_kento/works/3", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/0d050409/uploads/origins/20afe87b-8171-4424-8f9b-f9deff48f2bb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=c585e3487ae9c37786a1d0c2ce201177", "src_set": ""}, "private": true, "genre": "art", "tipped": true, "creator_id": 931879, "client_id": 1147726, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 177, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@Asakura_kento/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 931879, "client_id": 500267, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/bf07587e/uploads/origins/1dad6a97-8d65-4bcb-a3d7-e7df08948cfe?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3d8c431e6cdfca1095f6498a0d0fc12e", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/bf07587e/uploads/origins/1dad6a97-8d65-4bcb-a3d7-e7df08948cfe?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f975af7658edbc41afed0040b13c9e6d", "src_set": ""}, "body": "はじめまして。今回は、めちゃめちゃ太っちゃってとても恥ずかしがっているヤクモくんをお願いしたいです。\nシーサイドパニックの増量後ハルカくんよりもさらに1〜2段階くらい太らせてほしいです(目安は、元の身体能力貯金があっても走ったり跳んだりが全然できなくなるくらい)。頭からお腹が全部見えていれば、全身を描かなくても構いません。\nポーズはこちら向きのダブルバイセップスみたいな感じがいいです(左右の腕の高さが違ったり、首や体が真正面を向いていなかったり、多少崩してあっても大丈夫です)。昔の服を無理やり着ようとしていて、丈が足りずお腹が丸見えになっていたり、ズボンが太ももから上がらなかったりしてほしいです。自慢の肉棒はお腹で隠れているか、土手肉に根元が埋まって短くなっているのが見たいです(状態は問いません)。\nキャンバスの右下か左下に自慢げに同じポーズをとる増量前ヤクモくんの写真(と、任意で写真を持つハルカくんの指)を添えておいてほしいです。手間でなければセリフをつけて1コマ漫画みたいにしてもらえたら嬉しいです。写真、フキダシの有無で差分をお願いしたいです。\nたくさん要望を書いてしまいましたが、解釈違いでなければご検討いただけたら幸いです。よろしくお願いします。", "nc": 176, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Asakura_kento/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 931879, "client_id": 0, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/20f222cb/uploads/origins/435af3da-af01-4ead-a0e8-ae05c82bce3b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bbf8b5ba8e8c2fc0a1636fbf3e208487", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/20f222cb/uploads/origins/435af3da-af01-4ead-a0e8-ae05c82bce3b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b417089a61f5780e1374a80963e8a920", "src_set": ""}, "body": "初めてイラストのご依頼させていただきます。タイキKAMEN Wlofと申します。この度は私のXのアイコンイラストとくる次郎さん(@kuru4ru4)のアイコンイラストを使ったイラストをお願いいたします。\n服装はアイコンの同じパーカーでキャップ帽子を被り、スボンはダボダボの七分丈のズボンにNIKEのスニーカーを履いてる姿で、グレー色の日産スカイラインR32型のスポーツカーの前に背中合わせで立っている形でよろしくお願いいたします。\nくる次郎さんには許可をいただいております。\n長くなりましたが、よろしくお願いいたします。", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "similar_creators": [{"id": 12149, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "もりたち", "screen_name": "mochi_m", "avatar_url": "https://pbs.twimg.com/profile_images/1775175977271980032/KCOfBoZg.jpg", "header_url": "https://pbs.twimg.com/profile_banners/14522664/1561048762/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "skills": [{"genre": "art"}], "nc": 49}, {"id": 13745, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "甘辛猫*10/19関西コミティア【L-36】", "screen_name": "ekk_latek", "avatar_url": "https://pbs.twimg.com/profile_images/1913150388255223808/SY2LbPSm.jpg", "header