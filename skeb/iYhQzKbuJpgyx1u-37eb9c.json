す！\n\n◾️使用用途: Xや動画のサムネイルなど\n\n可能でしたらキャラクターの背景透過版をいただけると幸いです。\nよろしくお願いいたします😊\n\nhttps://drive.google.com/file/d/1THcEsM0BiJmcohoGE3M02eC64TFpYw5A/view?usp=drivesdk\n\nhttps://drive.google.com/file/d/1THcEsM0BiJmcohoGE3M02eC64TFpYw5A/view?usp=drivesdk", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@iYhQzKbuJpgyx1u/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3724208, "client_id": 64110, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/b186080e/uploads/origins/8714d032-ee2b-4adf-9b09-b43149fe08df?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e5d3d3e4e5e1035c322a7c78649c832d", "srcset": "https://si.imgix.net/b186080e/uploads/origins/8714d032-ee2b-4adf-9b09-b43149fe08df?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e5d3d3e4e5e1035c322a7c78649c832d, https://si.imgix.net/b186080e/uploads/origins/8714d032-ee2b-4adf-9b09-b43149fe08df?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=1655a23e23a585b948b26f03c9d044ec 2x, https://si.imgix.net/b186080e/uploads/origins/8714d032-ee2b-4adf-9b09-b43149fe08df?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=fb2fe35a8dff608f973fe97f622572db 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/b186080e/uploads/origins/8714d032-ee2b-4adf-9b09-b43149fe08df?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=547310d082c62cf611beadd37c6d1dbf", "srcset": "https://si.imgix.net/b186080e/uploads/origins/8714d032-ee2b-4adf-9b09-b43149fe08df?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=547310d082c62cf611beadd37c6d1dbf, https://si.imgix.net/b186080e/uploads/origins/8714d032-ee2b-4adf-9b09-b43149fe08df?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&c