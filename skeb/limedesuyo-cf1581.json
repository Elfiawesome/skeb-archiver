察した椛は今日は危険日と伝えますが\n興奮した恋人からこのまま中に出すと言われてしまいます。\n妊娠したらお仕事(哨戒任務)ができなくなると口では言う椛ですが\n内心では満更でもなく、中出しされるのをドキドキと期待しています。\nその後、中出しされて絶頂した椛は責任取ってくださいねと嬉しそうです。\n\n今回も擬音や喘ぎ声等ありで、挿入中の絵を基本として\n中出し絶頂や挿入したまま中出しの余韻中等の差分をお願いします。\n\n服は胸と結合部が見えていれば全裸でも半脱ぎでもＯＫです。\n\n局部の修正は過去絵のような海苔修正でも前回のモザイク修正のどちらでもＯＫです。\n\n以上、ご検討ください。", "nc": 176, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@limedesuyo/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1701137, "client_id": 462930, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/f8ca9dfd/uploads/origins/2165ac1f-98d0-489c-a227-719d0a3c31be?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ec4bddc5ab38e32068f9367bca77015a", "srcset": "https://si.imgix.net/f8ca9dfd/uploads/origins/2165ac1f-98d0-489c-a227-719d0a3c31be?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ec4bddc5ab38e32068f9367bca77015a, https://si.imgix.net/f8ca9dfd/uploads/origins/2165ac1f-98d0-489c-a227-719d0a3c31be?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=507938f0506bb190a06e22969cfcadc3 2x, https://si.imgix.net/f8ca9dfd/uploads/origins/2165ac1f-98d0-489c-a227-719d0a3c31be?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=7bafefe0307475e7804dbafeaaf62051 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/f8ca9dfd/uploads/origins/2165ac1f-98d0-489c-a227-719d0a3c31be?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a033ce78ffc213b61208e44702505ee3", "srcset": "https://si.imgix.net/f8ca9dfd/uploads/origins/2165ac1f-98d0-489c-a227-719d0a3c31be?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a033ce78ffc213b61208e44702505ee3, https://si.imgix.net/f8ca9dfd/uploads/origins/2165ac1f-98d0-489c-a227-719d0a3c31be?bg=%23fff&a