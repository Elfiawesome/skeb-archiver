ff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=17e881c9e34213b28941485acdacfc1f, https://si.imgix.net/b4f108fe/uploads/origins/c07523cc-815d-4e72-b01a-903aca423c26?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=6f675281ea68d0e05aeb4651282f175a 2x, https://si.imgix.net/b4f108fe/uploads/origins/c07523cc-815d-4e72-b01a-903aca423c26?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c1d69f6015c7b1eeb2f8b98300f0455b 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/b4f108fe/uploads/origins/c07523cc-815d-4e72-b01a-903aca423c26?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=8db5ffb6a0e75444e4f2245bd002df6b", "srcset": "https://si.imgix.net/b4f108fe/uploads/origins/c07523cc-815d-4e72-b01a-903aca423c26?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=8db5ffb6a0e75444e4f2245bd002df6b, https://si.imgix.net/b4f108fe/uploads/origins/c07523cc-815d-4e72-b01a-903aca423c26?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=0ba0d1c172d9e288628f6393a1f887f4 2x, https://si.imgix.net/b4f108fe/uploads/origins/c07523cc-815d-4e72-b01a-903aca423c26?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=e938fe1867e6e4c3eb634e5ddee32435 3x"}, "body": "こんにちは、ロストさん！VTuberさんでBLユニットというのはあまり見かけないので、プロフィールに惹かれました！もしよろしければ、OCのイラストを描いていただけると嬉しいです。\n\n[キャラ紹介]\nシモミヤは名家の後継者で、兄と父が数年違いで「不幸な」死を遂げた後、一族の当主となりました。繊細で物静かな性格をしており、感情を隠すのがあまり得意ではありません。周囲からは礼儀正しく、誠実で努力家な人物として知られており、常に場の平和を保とうとしています。\n\nしかし、内面には狡猾で人を操るような一面が潜んでいます。無害そうな印象で相手を油断させる、「羊の皮を被った狼」です。悪魔的な魅力を持つ恋愛対象タイプような存在であり、その冷酷で利己的な面も、憂いで愛情深い反面も、どちらも本質です。 結局のところ、彼が行うすべてのことは、その繊細な心のためなのです。\n\n髪はきちんと分けて整えているつもりですが、前髪が目にかかり、耳にかけてもすぐに落ちてきてしまいます。また、腕時計と結婚指輪は常に身につけており、頻繁にそれらに触れたり、位置を直したりする癖があります。これらは彼にとって重要な品ですので、必ず含めてください。年齢は25歳、身長は175cmです。彼と最も強く結びつけられるモチーフは、赤い紅葉、葬儀、淵といったものなどです。\n\n…要するに、陰険さと純粋な愛情を併せ持つファムファタール男の攻めなんです。お好きなように描いてください。よろしくお願いします！ \n\nhttps://drive.google.com/drive/folders/1F4UXSmzbN7TqQT0Y-o9B_TeVLQ55ulZc", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 1131928, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "帰路 / kiro", "screen_name": "ke_ro_lingual", "avatar_url": "https://pbs.twimg.com/profile_images/1648537064689004544/kskPXMic.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1198244411835969537/1749399362/1500x500", "appeal_receivable": true, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 120, "skills": [{"genre": "art"}], "banned": false, "nc": 49}, {"id": 1332784, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "曽井そーす@skeb募集中", "screen_name": "so_su_umauma", "avatar_url": "https://pbs.twimg.com/profile_images/1955318399611047938/DwgH8lZJ.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1252080120975613952/1690201105/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 5, "complete_expiration_days": 20, "skills": [{"genre": "art"}, {"genre": "comic"}], "banned": false, "nc": 1}, {"id": 2515630, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "剣士", "screen_name": "graffitiGW", "avatar_url": "https://pbs.twimg.com/profile_images/1889970344657846272/JjIYko4F.jpg", "header_url": "https://pbs.twimg.com/profile_banners/870348734147608576/1780078021/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 2, "com