c": "https://si.imgix.net/5ccc88f9/uploads/origins/4676db20-c14b-41d1-8dea-35c87c35eba0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=04205bb1b58d4515a1b12b510b15067d", "srcset": "https://si.imgix.net/5ccc88f9/uploads/origins/4676db20-c14b-41d1-8dea-35c87c35eba0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=04205bb1b58d4515a1b12b510b15067d, https://si.imgix.net/5ccc88f9/uploads/origins/4676db20-c14b-41d1-8dea-35c87c35eba0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=3eff59e97d75309da7e993eadb984401 2x, https://si.imgix.net/5ccc88f9/uploads/origins/4676db20-c14b-41d1-8dea-35c87c35eba0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=eb5f608c4e8812430996dc1502e3d2c6 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/5ccc88f9/uploads/origins/4676db20-c14b-41d1-8dea-35c87c35eba0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=eff01abc6c9a968dcd425914412ef4d1", "srcset": "https://si.imgix.net/5ccc88f9/uploads/origins/4676db20-c14b-41d1-8dea-35c87c35eba0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=eff01abc6c9a968dcd425914412ef4d1, https://si.imgix.net/5ccc88f9/uploads/origins/4676db20-c14b-41d1-8dea-35c87c35eba0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=6b2e1b84c274cec64b63aeae21e11a26 2x, https://si.imgix.net/5ccc88f9/uploads/origins/4676db20-c14b-41d1-8dea-35c87c35eba0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=75efcd280e7d13b25fcef344ebd7425c 3x"}, "body": "初めまして、Antaresと申します。\nかくす様が描いだ絵Twitterで拝見致しましだ、すごく好きでしだ。線も色も爽やかな感じがする、キャラ個性をよく掴めている。(特にこのピースがとても好きです！https://www.pixiv.net/artworks/97688805#big_17)\nよろしければ、私の創作キャラを描いて欲しいと思い、リクエストを送りました。\n(初めてのリクエストなので、料金足りない場合は、遠慮なくお断りして下さっても構いませんです。まだ今度でリクエスト送ります。)\n\n\n▽詳細\n同じキャラの二面で、二人です。\n黒髪のショートカーリーで、赤いハイライトが入っている。背面には長めの細い三つ编みがあります（後頭部下部から、ショートヘアパートとはレイヤーがあります）。\n目は赤く、瞳孔にハート形がある。\n印象メイン色は赤白／赤黒。\n\n①作家\n彼女はいつも疲れだ印象がする、口が悪い（言う事抑えられない)。外剛内弱な感じです。ニート作家。作品にすべてをかける。\n\n②異世界の魔法使い\nデザインてきに“ハートのクイーン”、“孤独的な性格悪い人物”、“ちょと人外感”という印象です。\nこの子は魔法使いであると同時に作家です。自分の作品に対してとても狂熱でした。\n\n\n▽その他\n二人関係はChara-Frisk、背後霊。\nDRIVE中の衣装に従う必要はありません、制限なし、お好きに描かれて頂きましたら嬉しいですが。\nポーズや構図、雰囲気などに不明確な所は全部お任せ。\n絵の用途は個人楽しみ、キャラクター次リクエストの画像例どして。Icon使用もありますかもしれないので、もし行けないならお断りしても大丈夫です。\n\nリクエストを読んでくださてありがとうございます。ご検討宜しくお願い致します。\n\nhttps://drive.google.com/drive/folders/1uCb2L9IRXMgo9gFYWolGlq5hhgr3e83c?usp=sharing", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}], "sent_works": [], "similar_creators": [{"id": 1072654, "creator": true, "nsfw_acceptable": false, "acceptable": false, "name": "しと", "screen_name": "citrow_krm", "avatar_url": "https://pbs.twimg.com/profile_images/1858477663847096320/SlBbRmTH.jpg", "header_url": "https://pbs.twimg.com/profile_banners/939040785407795201/1757245239/1500x500", "appeal_receivable": true, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "art"}], "banned": false, "nc": 17}, {"id": 1745580, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "pipio", "screen_name": "pipioo08", "avatar_url": "https://pbs.twimg.com/profile_images/1277191250903351298/Dm2HQyO7.jpg", "header_url": "https://pbs.twimg.com/profile_banners/3308863488/1777695866/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "art"}], "banned": false, "nc": 16}, {"id": 2610607, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "蓮/はす", "scre