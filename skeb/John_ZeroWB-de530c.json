00&s=267b2447a6966cf7b622fe9de8703f30", "srcset": "https://si.imgix.net/db7f0b44/uploads/origins/9bfb27dc-e5e1-42f0-ac6e-44e2708238e8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=267b2447a6966cf7b622fe9de8703f30, https://si.imgix.net/db7f0b44/uploads/origins/9bfb27dc-e5e1-42f0-ac6e-44e2708238e8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=fe0892ee50d61e669d0a3e376a5cd6e6 2x, https://si.imgix.net/db7f0b44/uploads/origins/9bfb27dc-e5e1-42f0-ac6e-44e2708238e8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e60cd84548fc21a3142ae79b69acaf78 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/db7f0b44/uploads/origins/9bfb27dc-e5e1-42f0-ac6e-44e2708238e8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ef380e659a95c35da2894bc750dbc5c8", "srcset": "https://si.imgix.net/db7f0b44/uploads/origins/9bfb27dc-e5e1-42f0-ac6e-44e2708238e8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ef380e659a95c35da2894bc750dbc5c8, https://si.imgix.net/db7f0b44/uploads/origins/9bfb27dc-e5e1-42f0-ac6e-44e2708238e8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=a48a48130a83b0d2f9fee4f8c4dab420 2x, https://si.imgix.net/db7f0b44/uploads/origins/9bfb27dc-e5e1-42f0-ac6e-44e2708238e8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=9c6c90b9285f6e6bdcc22472692fd20c 3x"}, "body": "お邪魔します先生\n今回はクリスマステーマのイラストを頼みたい\n\nキャラは前回のリクエストで登場した藤倉ウルカさんです：\nhttps://phase-connect.com/wp-content/uploads/2021/08/Uruka-Ref-4k.jpg\nそして今回は彼女の髪型を変わりたい、新衣装の髪型を使う：\nhttps://x.com/fujikurauruka/status/1773654318542942236\n\n衣装の参考はまたクリスマステーマのランジェリー：\nhttps://cdn-img.prettylittlething.com/f/7/4/2/f7429cc795c29968d26b29f07b978f48d29406e5_cnb5282_3.jpg?imwidth=1024\nウルカさんは生足要素ありのイラストが嫌いなので、今回もニーソックスを付けてください\n色は先生に任せたい\n\nポーズは：”セクシーの横臥ポーズ”\n概念はこんな感じ、具体のポーズも先生に任せたい：\nhttps://www.pixiv.net/artworks/63946362\nhttps://www.pixiv.net/artworks/51624317\nhttps://www.pixiv.net/artworks/57880102\nポーズを調整し、両足を見えるの方が好きです\n\nそしてエッチの差分も頼む\n今回はウルカさんは、こちらのエリナさんのしっぽ：\nhttps://x.com/ErinaMakina/status/1933554314565571020/photo/1\nに責められる、でも体は出てない\nしかし、エリナさんの影があれば多分面白いと思います\n\nしっぽたちが触手のような、ウルカさんのブラとパンツを脱ぐ、二穴責める、胸をいじめるとか\n\nウルカさんは潮吹き、表情はトロ顔になる\n背景の要求はない\n\nでは今回もよろしくお願いします！", "nc": 160, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@John_ZeroWB/works/16", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2174269, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/5a625920/uploads/origins/ac9b9b9a-f80a-4dec-a323-15d6a8d22775?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4a799e2492ca54fe62079e36c0e38453", "srcset": "https://si.imgix.net/5a625920/uploads/origins/ac9b9b9a-f80a-4dec-a323-15d6a8d22775?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4a799e2492ca54fe62079e36c0e38453, https://si.imgix.net/5a625920/uploads/origins/ac9b9b9a-f80a-4dec-a323-15d6a8d22775?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=d643d568c8f8a94b31d38a8f9a331562 2x, https://si.imgix.net/5a625920/uploads/origins/ac9b9b9a-f80a-4dec-a323-15d6a8d22775?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=2d56ae00bd91629b9612a650d473df3c 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/5a625920/uploads/origins/ac9b9b9a-f80a-4dec-a323-15d6a8d22775?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c9d7f3ab2bc2364f3de31e52d99a13f6", "srcset": "https://si.imgix.net/5a625920/uploads/origins/ac9b9b9a-f80a-4dec-a323-15d6a8d22775?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c9d7f3ab2bc2364f3de31e52d99a13f6, https://si.imgix.net/5a625920/uploads/origins/ac9b9b9a-f80a-4dec-a323-15d6a8d22775?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=e072aeb3d6b29f28ba5e6150f8781c2e 2x, https://si.imgix.net/5a625920/uploads/origins/ac9b9b9a-f80a-4dec-a323-15d6a8d22775?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=fe9b6b0d77e06cb2885e42febe96b0df 3x"}, "body": "またまたこんにちは！今回もスクちゃんhttps://files.catbox.moe/titit9.jpg（左端のヘアスタイル）、でも今回はイエンコーズhttps://files.catbox.moe/u0mf4c.jpg。シナリオは、ビーチでのMFF3P：スクちゃんはこのビキニhttps://files.catbox.moe/5fr4el.png、イェンコスは参考画像のもの（サンドレスはなし）で、右下の画像のように髪を短くする。ポーズはスクちゃんが騎乗位で（男の上に乗って）、右側にいる円光がスクちゃんを触る。https://files.catbox.moe/27pync.png。また、男の乳首（円光は右、スクチャンは左）を弄らせるが、舐めない。シナリオは8つ：1つ目は、男なしでビキニ姿（SNSに投稿するため）、2つ目は、前回と同じように男がジーンズと紫のシャツを着ている状態、3つ目は、ビキニから胸を出し、男が全裸で勃起している状態（セックスしようとしているような状態）、4つ目、全裸でセックスし、2人とも乳首プレイをしているところ、5番目はセックスの熱さで汗だくになっているところ、6番目は男がスクチャンの中に射精し、円光がその様子を見て反応しているところ（2人とも心臓の瞳孔が開いている）、7番目はX線バージョン、そして最後はセックスの後；ペニスを出したスクチャンがペニスを掴み、舌を出した円子。長文失礼しました。", "nc": 161, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@John_ZeroWB/works/15", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2174269, "client_id": 1646568, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/7e7fca70/uploads/origins/4188bff4-5ce9-4500-ab65-ffe0f7e507af?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=255d1d795130e939c32958998b4de62b", "srcset": "https://si.imgix.net/7e7fca70/uploads/origins/4188bff4-5ce9-4500-ab65-ffe0f7e507af?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=255d1d795130e939c32958998b4de62b, https://si.imgix.net/7e7fca70/uploads/origins/4188bff4-5ce9-4500-ab65-ffe0f7e507af?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=32b395aaa4bc257c9c270eebe2d99dab 2x, https://si.imgix.net/7e7fca70/uploads/o