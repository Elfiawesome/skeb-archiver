ient_visible": false, "total_appeals_count": 0, "received_works": [{"path": "/@nijinomaya/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3386961, "client_id": 3273138, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/891a4ba9/uploads/origins/ae442597-8571-4513-bacb-98c9e5232849?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9cd9121d988520479bc5d568b3239a91", "srcset": "https://si.imgix.net/891a4ba9/uploads/origins/ae442597-8571-4513-bacb-98c9e5232849?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9cd9121d988520479bc5d568b3239a91, https://si.imgix.net/891a4ba9/uploads/origins/ae442597-8571-4513-bacb-98c9e5232849?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b1251ee0b1ba68b1a85c0411e178a1a3 2x, https://si.imgix.net/891a4ba9/uploads/origins/ae442597-8571-4513-bacb-98c9e5232849?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=87442d95d59e29e66c5de67ac4a5b9d8 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/891a4ba9/uploads/origins/ae442597-8571-4513-bacb-98c9e5232849?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3de75c5f048ae29a41419ca745d754b5", "srcset": "https://si.imgix.net/891a4ba9/uploads/origins/ae442597-8571-4513-bacb-98c9e5232849?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3de75c5f048ae29a41419ca745d754b5, https://si.imgix.net/891a4ba9/uploads/origins/ae442597-8571-4513-bacb-98c9e5232849?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=61df5a8a11db929a79564ed9adc00cb0 2x, https://si.imgix.net/891a4ba9/uploads/origins/ae442597-8571-4513-bacb-98c9e5232849?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=54fc224b18925a0731690feac9bf6f13 3x"}, "body": "虹野真耶先生、こんにちは！先生の絵の雰囲気が惹きつけました。うちよそをリクエストさせて頂きたいです。 \n\n設定は魔女狩りの時代です。\n\n🧊前任者で(母親)が不可解な失踪を遂げた後、町の市長職を引き継いだ若い女性。優しい微笑みを湛え、町民失踪事件の真相解明に尽力する姿勢で尊敬を集めている。 その微笑みの裏には、彼女は町民が消えた理由の一つである、自邸の秘密の部屋で凍結状態に置くという趣味が隠されている。犠牲者を解凍する際、混乱状態を利用した再配線を行う。これにより新たな人格と願望を植え付け、その瞬間の彼女の欲望に適合した人物へと変貌させる。この過程は犠牲者の脳に危険を伴うため、一人につき一度しか再配線を実施できていない。 人狼のような超自然的な怪物が存在する世界にいながら、彼女は武器を携えていない。なぜなら、常に👓が傍にいる。 \n\n👓市長の忠実な助手。その忠誠心の理由は不明である。この科学者風のタイプは普段はのんびりした様子だが、気分の変動や感情の突然の爆発を起こしやすい。忍耐が尽きる時、銃（ルガーP08）に語らせる。👓は他人を愛称で呼び、市長を「チャンセラー」と呼ぶ。ほぼ毎日、性格が劇的に変化しているように見える。 実際には、記憶の大部分が毎日リセットされており、ノートを参照して記憶を回復している。 👓には知らされていないが、その手帳は実は🧊によって書かれ選ばれたものであり、そもそも👓の記憶喪失の原因も🧊である。眼鏡は市長からの贈り物だが、👓が毎日忘れてしまう事実の一つだ。👓は専用の「部屋」があるにもかかわらず、毎日目を覚ますのは市長の秘密の庭だ、そこにはガラスの棺が置かれている。イメージソング：she’s purity/凋叶棕 \n\n市長は忠実な助手を道具のように扱い、人形のように弄びながらも、👓がも目を覚ますまで常にその傍らに寄り添い、二人だけの空間（ガラスの棺の部屋）で優しく世話を焼く。もしも最愛の👓に危害が及んだなら、翌日までにその原因を確実に始末する。 \n\n内容不備や金額が不足している場合は、アピールをお送りください。没ラフや下描きなどがあればPSDに残したままにしていただけると嬉しいです。長いお願いをお読みいただき、またご検討いただきありがとうございます。\n\nhttps://drive.google.com/drive/folders/1Vz9VJgbr_KRfxzL-UUaPkFHFz-kA_p9j?usp=sharing", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@nijinomaya/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3386961, "client_id": 3427631, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/fe7255bf/uploads/origins/22422971-cf6f-4670-b0fb-627595492004?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=755eb53b533e310598d3c4ccb7d78755", "srcset": "https://si.imgix.net/fe7255bf/uploads/origins/22422971-cf6f-4670-b0fb-627595492004?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=755eb53b533e310598d3c4ccb7d78755, https://si.imgix.net/fe7255bf/uploads/origins/22422971-cf6f-4670-b0fb-627595492004?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=3023c6a2aecc70e2c202fcf1aafdb2e0 2x, https://si.imgix.net/fe7255bf/uploads/origins/22422971-cf6f-4670-b0fb-627595492004?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=71bf2ce588ded88d4e2e167336cdad32 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/fe7255bf/uploads/origins/22422971-cf6f-4670-b0fb-627595492004?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=4e3349fd1163cab6fcc07dcd8773e0fa", "srcset": "https://si.imgix.net/fe7255bf/uploads/origins/22422971-cf6f-4670-b0fb-627595492004?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=4e3349fd1163cab6fcc07dcd8773e0fa, https://si.imgix.net/fe7255bf/uploads/origins/22422971-cf6f-4670-b0fb-627595492004?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=28115b550484c90f4e6b59a25fb87fc8 2x, https://si.imgix.net/fe7255bf/uploads/origins/22422971-cf6f-4670-b0fb-627595492004?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=e5dea206d976dd0fefe47b36c9d9c970 3x"}, "body": "虹野真耶さん、こんにちは。SkebやX（旧Twitter）であなたの作品を見ましたが、手描きのイラストやその色使いがとても気に入りました。私のVTuber「nvyna」のオリジナル曲のキーアートを描いていただけないでしょうか？\n\n彼女の名前はnvynaで、男の子がアンドロイドの女の子に変身したキャラクターです。身長は155cm（耳を含む）で、明るく子供っぽい性格です。また、ゲームとお菓子が大好きです。\n\nイラストについては、解像度を1920x1080にしていただき、「時間との戦い」というコンセプトに基づいて描いていただきたいです。 ただし、曲のテーマに合うと思えば、基本的に自由に制作していただいて構いません。\n\n楽曲はこちらです：https://drive.google.com/drive/folders/1FDKzJAmhTRlMzVK-9czznb6NQhQjbpJd?usp=sharing\n\nそれ以外の構成については、すべてお任せします。\n\nこのイラストは、楽曲のミュージックビデオ、アルバムカバー、SNS用として使用します。もし報酬額に納得いただけない場合は、ご希望の金額で再依頼することも可能です。\nよろしくお願いします！\n\nhttps://drive.google.com/drive/folders/1GaInxxW9BnKIV8yUiwwmJjnJ70vQWW_B", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@nijinomaya/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3386961, "client_id": 2937535, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/277ec0b2/uploads/origins/7acdb353-3c29-4b52-bd41-9d2499161c25?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=04c914fd2ca90ed38cc2307e2dd5f353", "srcset": "https://si.imgix.net/277ec0b2/uploads/origins/7acdb353-3c29-4b52-bd41-9d2499161c25?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=04c914fd2ca90ed38cc2307e2dd5f353, https://si.imgix.net/277ec0b2/uploads/origins/7acdb353-3c29-4b52-bd41-9d2499161c25?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=fd8e346ae8dff5a22cdd7d75eb21a2ca 2x, https://si.imgix.net/277ec0b2/uploads/origins/7acdb353-3c29-4b52-bd41-9d2499161c25?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b469360bec08fbd2142b397d28cf7944 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/277ec0b2/uploads/origins/7acdb353-3c29-4b52-bd41-9d2499161c25?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=be4f370a65c9ea7da8aeee7a2c833211", "srcset": "https://si.imgix.net/277ec0b2/uploads/origins/7acdb353-3c29-4b52-bd41-9d2499161c25?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=be4f370a65c9ea7da8aeee7a2c833211, https://si.imgix.net/277ec0b2/uploads/origins/7acdb353-3c29-4b52-bd41-9d2499161c25?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=e0652783fe386ad7ed007b498bd19ac3 2x, https://si.imgix.net/277ec0b2/uploads/origins/7acdb353-3c29-4b52-bd41-9d2499161c25?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=3576627b1cc103a366bf968a56cfd590 3x"}, "body": "ニジノマヤさん、またお会いできて嬉しいです！最近SNSにはあまりログインしていなかったので、お元気でいらっしゃったでしょうか。リクエストを受け付けているのを見かけましたが、特に具体的なイメージはありません。自由なテーマでお願いしたいので、ぜひご自身の作りたいものを自由に創作してください。\nもしそれが広すぎるなら、もうすぐ訪れる春をイメージした作品でもいかがでしょうか？ 希望に満ちたもの、ワクワクするもの、物悲しいもの、あるいはそれとは全く違うものでも構いません。私のいる場所はまだ寒いので、自分が何を望んでいるのかよく分かりません。でも