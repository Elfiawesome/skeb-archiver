Jm56YeO55yf6IC2&txtclr=fff&txtfont64=QXZlbmlyLUJsYWNr&txtfit=max&txtalign=middle%2Ccenter&txtsize=60&txtshad=10&auto=format%2Ccompress&fit=crop&crop=top&w=1200&h=630&s=0c0a4d49e5b4d4414b690d0e95963d46", "skills": [{"genre": "art", "default_amount": 15000}], "payment_methods": {"credit_cards": {"jcb": {"nsfw": true}, "master_card": {"nsfw": true}, "visa": {"nsfw": true}, "discover": {"nsfw": true}, "american_express": {"nsfw": true}}}, "acceptable_only_public": false, "tip_acceptable": true, "yearly_report_client_visible": false, "total_appeals_count": 0, "received_works": [{"path": "/@nijinomaya/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3386961, "client_id": 326249, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/b4bf747d/uploads/origins/87598316-cea1-402d-9ad1-c5dd0da8c598?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d5d0baf872a8de7e6e94ac4e40142237", "srcset": "https://si.imgix.net/b4bf747d/uploads/origins/87598316-cea1-402d-9ad1-c5dd0da8c598?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d5d0baf872a8de7e6e94ac4e40142237, https://si.imgix.net/b4bf747d/uploads/origins/87598316-cea1-402d-9ad1-c5dd0da8c598?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=510fb0b81019f32ec5510c8d607394a2 2x, https://si.imgix.net/b4bf747d/uploads/origins/87598316-cea1-402d-9ad1-c5dd0da8c598?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c6a3f5793d36459d5225d588bf3c1224 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/b4bf747d/uploads/origins/87598316-cea1-402d-9ad1-c5dd0da8c598?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=dcb235d2d30694df25556b63a4f154de", "srcset": "https://si.imgix.net/b4bf747d/uploads/origins/87598316-cea1-402d-9ad1-c5dd0da8c598?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=dcb235d2d30694df25556b63a4f154de, https://si.imgix.net/b4bf747d/uploads/origins/87598316-cea1-402d-9ad1-c5dd0da8c598?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=edb1d76aa875864ebfc92dceac2b27f4 2x, https://si.imgix.net/b4bf747d/uploads/origins/87598316-cea1-402d-9ad1-c5dd0da8c598?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=36eac26a7e86dc80af03870db128e105 3x"}, "body": "こんにちは先生!\nもしご都合がよろしければ、私のOC二人のイラストをお願いしてもよろしいでしょうか？   \n\n<ゼンバー>：\n若き廃墟の妖精。見た目は魅力的な17歳の少女で、身長は167cm。警戒心のある猫のような琥珀色の瞳、尖った歯（毒蛇のような牙）、そして爪を持つ。胸には古い傷跡が走っている。   \nこの世界において、廃墟の妖精は妖精界の境界を守る責務を負い、時が来た普通の妖精に死をもたらす。妖精族は美しくないものや欠陥のあるものを強く嫌悪し、中でも暴力やいわゆる「死」は最も耐え難い。このため廃墟の妖精の評判は妖精界で常に悪く、その存在は歓迎されず孤立している。  \nゼンバーは全く意に介さない。妖精女王の暗殺者として働く彼女の忠誠は揺るぎない。他の妖精同様、性格は風変わりで軽薄、予測不能。口からは蜜のように甘い言葉が滴るが、任務遂行時は真剣かつ冷酷だ。彼女にとって殺戮は、食うこと眠ることと同じくらい自然な行為である。   \n「妖精界の永遠の繁栄のためなら、何でも、全てを」―これが彼女の口癖である。    \n\n<エトワール>：\n優雅で高慢な妖精。16～17歳の美少年のような外見で、感情を映す翼のある耳、猫のような目、鋭い歯を持つ。身長は175cm。   \nエトワールは現在妖精の国に居住している。任務で頻繁に人間界へ出向く廃墟妖精とは異なり、彼のような通常の妖精は誕生から死まで妖精の国に留まる運命にある。   \n幼い頃、エトワールは土の魔法に驚異的な才能を示したが、共感能力と繊細な感情ゆえに仲間から疎まれた。普通の妖精たちは遊び好きで、無邪気な子供のような残酷さを持ち、悲しみや憎しみといった負の感情を抱くことができない。彼らは妖精の国に魅せられた人間（彼らにとっては単なる遊び道具に過ぎない）に対してエトワールが示す優しさを嘲笑し、親友ゼンバーが任務で旅立つたびにエトワールが彼女のマントを引っ張り泣きじゃくる様子を冷ややかな嫌悪の眼差しで見つめていた。   \n彼が妖精国の心臓部である精霊の樫の大いなる癒し手として任命された時、全てが変わった。それ以来、妖精たちから称賛され、崇められる存在となった。周囲に溶け込みたいという強い願望（そしてもはや友人ではないあの黒髪の廃墟妖精を忘れたいという思い）から、エトワールは次第に心を閉ざし、他の者たちのように「冷たい」存在へと変貌していった。かつての共感的な自分や外界への好奇心を深く埋葬したのだ。幼い頃から渇望していた他者からの承認をようやく得たにもかかわらず、彼はどこか空虚さを感じていた。おそらくそれは孤独感なのだろうが、それを認めるくらいなら死を選ぶ。   \nエトワールは実はツンデレで、すぐに顔を赤らめる、心の底では純粋な人物だ。褒められすぎると、反射的に片手を口元に当てて、得意げな大げさな笑い声を上げる。  \n*エトワールの鼻には薄いそばかすがある。 \n\n二人の関係性：\nゼンバーがこの関係においてより強い立場（攻め）である。   \nエトワールとゼンバーは幼い頃親しい友達だったが、ある事件をきっかけにエトワールは破滅の妖精と普通の妖精であるゼンバーの違いを悟った。それ以来エトワールは距離を置こうとするが、ゼンバーは彼の冷たさを無視し、機会あるごとにふざけてまとわりつく。\nゼンバーがエトワールを好きな理由はいくつかある。可愛らしいし、大切な友人だし、からかうのが楽しい。特に彼女のそばでは、あの端正で落ち着いた姿を保てないところがたまらない。しかし何より、彼女は精霊の樫の癒し手として妖精の国に捧げる彼の献身を尊敬していた。ゼンバーにとって、妖精国の繁栄のために義務感を持って行動する者ほど美しいものはない。\nエトワールのゼンバーへの感情はもっと複雑だ…彼は彼女が外の世界を探検する自由を羨み、ゼンバーの甘い愛情表現に苛立つ。それらは嘘だからだ。彼女は他の者たちと同じだ：人間らしさの対極にある感情しか持たず、「あの種の愛」を感じることはできない。心の奥底では、彼は無意識に、そして自ら望まずに、彼女が常に自分らしさを貫く姿勢を尊敬している――それは彼自身が果たせなかったことだ。エトワールは彼女を少し憎んでいるが、最も憎んでいるのは自分自身だ。なぜなら、こうした疲弊し、歪んだ感情にもかかわらず、彼は常にゼンバーを「あの種の愛」で好きだったからだ。\n（エトワールのナルシシズムは、彼の内なる不安と、自分を密かに劣っていると見なす気持ちから来ていると思う。他の者たちとは上手くやれるのに、ゼンバーはただ豊かに、そして美しく存在するだけで、彼の劣等感を増幅させてしまう。ゼンバーはまるで鏡のようで、エトワールの醜さと、彼自身の真実を映し出す存在なのだ。）\n\n自由に描いてください！ ご配慮ありがとうございました❤️\n\nhttps://drive.google.com/drive/folders/106xixSd3OingKlPoSPhM6QpgLEXIrGvO", "nc": 25, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@nijinomaya/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3386961, "client_id": 3273138, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/891a4ba9/uploads/origins/ae442597-8571-4513-bacb-98c9e5232849?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9cd9121d988520479bc5d568b3239a91", "srcset": "https://si.imgix.net/891a4ba9/uploads/origins/ae442597-8571-4513-bacb-98c9e5232849?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9cd9121d988520479bc5d568b3239a91, https://si.imgix.net/891a4ba9/uploads/origins/ae442597-8571-4513-bacb-98c9e5232849?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b1251ee0b1ba68b1a85c0411e178a1a3 2x, https://si.imgix.net/891a4ba9/uploads/origins/ae442597-8571-4513-bacb-98c9e5232849?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=87442d95d59e29e66c5de67ac4a5b9d8 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/891a4ba9/uploads/origins/ae442597-8571-4513-bacb-98c9e5232849?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3de75c5f048ae29a41419ca745d754b5", "srcset": "https://si.imgix.net/891a4ba9/uploads/origins/ae442597-8571-4513-bacb-98c9e5232849?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3de75c5f048ae29a41419ca745d754b5, https://si.imgix.net/891a4ba9/uploads/origins/ae442597-8571-4513-bacb-98c9e5232849?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=61df5a8a11db929a79564ed9adc00cb0 2x, https://si.imgix.net/891a4ba9/uploads/origins/ae442597-8571-4513-bacb-98c9e5232849?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=54fc224b18925a0731690feac9bf6f13 3x"}, "body": "虹野真耶先生、こんにちは！先生の絵の雰囲気が惹きつけました。うちよそをリクエストさせて頂きたいです。 \n\n設定は魔女狩りの時代です。\n\n🧊前任者で(母親)が不可解な失踪を遂げた後、町の市長職を引き継いだ若い女性。優しい微笑みを湛え、町民失踪事件の真相解明に尽力する姿勢で尊敬を集めている。 その微笑みの裏には、彼女は町民が消えた理由の一つである、自邸の秘密の部屋で凍結状態に置くという趣味が隠されている。犠牲者を解凍する際、混乱状態を利用した再配線を行う。これにより新たな人格と願望を植え付け、その瞬間の彼女の欲望に適合した人物へと変貌させる。この過程は犠牲者の脳に危険を伴うため、一人につき一度しか再配線を実施できていない。 人狼のような超自然的な怪物が存在する世界にいながら、彼女は武器を携えていない。なぜなら、常に👓が傍にいる。 \n\n👓市長の忠実な助手。その忠誠心の理由は不明である。この科学者風のタイプは普段はのんびりした様子だが、気分の変動や感情の突然の爆発を起こしやすい。忍耐が尽きる時、銃（ルガーP08）に語らせる。👓は他人を愛称で呼び、市長を「チャンセラー」と呼ぶ。ほぼ毎日、性格が劇的に変化しているように見える。 実際には、記憶の大部分が毎日リセットされており、ノートを参照して記憶を回復している。 👓には知らされていないが、その手帳は実は🧊によって書かれ選ばれたものであり、そもそも👓の記憶喪失の原因も🧊である。眼鏡は市長からの贈り物だが、👓が毎日忘れてしまう事実の一つだ。👓は専用の「部屋」があるにもかかわらず、毎日目を覚ますのは市長の秘密の庭だ、そこにはガラスの棺が置かれている。イメージソング：she’s purity/凋叶棕 \n\n市長は忠実な助手を道具のように扱い、人形のように弄びながらも、👓がも目を覚ますまで常にその傍らに寄り添い、二人だけの空間（ガラスの棺の部屋）で優しく世話を焼く。もしも最愛の👓に危害が及んだなら、翌日までにその原因を確実に始末する。 \n\n内容不備や金額が不足している場合は、アピールをお送りください。没ラフや下描きなどがあればPSDに残したままにしていただけると嬉しいです。長いお願いをお読みいただき、またご検討いただきありがとうございます。\n\nhttps://drive.google.com/drive/folders/1Vz9VJgbr_KRfxzL-UUaPkFHFz-kA_p9j?usp=sharing", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@nijinomaya/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3386961, "client_id": 3427631, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/fe7255bf/uploads/origins/22422971-cf6f-4670-b0fb-627595492004?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=755eb53b533e310598d3c4ccb7d78755", "srcset": "https://si.imgix.net/fe7255bf/uploads/origins/22422971-cf6f-4670-b0fb-627595492004?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=755eb53b533e310598d3c4ccb7d78755, https://si.imgix.net/fe7255bf/uploads/origins/22422971-cf6f-4670-b0fb-627595492004?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=3023c6a2aecc70e2c202fcf1aafdb2e0 2x, https://si.imgix.net/fe7255bf/uploads/origins/22422971-cf6f-4670-b0fb-627595492004?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=71bf2ce588ded88d4e2e167336cdad32 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/fe7255bf/uploads/origins/22422971-cf6f-4670-b0fb-627595492004?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=4e3349fd1163cab6fcc07dcd8773e0fa", "srcset": "https://si.imgix.net/fe7255bf/uploads/origins/22422971-cf6f-4670-b0fb-627595492004?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=4e3349fd1163cab6fcc07dcd8773e0fa, https://si.imgix.net/fe7255bf/uploads/origins/22422971-cf6f-4670-b0fb-627595492004?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=28115b550484c90f4e6b59a25fb87fc8 2x, https://si.imgix.net/fe7255bf/uploads/origins/22422971-cf6f-4670-b0fb-627595492004?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=e5dea206d976dd0fefe47b36c9d9c970 3x"}, "body": "虹野真耶さん、こんにちは。SkebやX（旧Twitter）であなたの作品を見ましたが、手描きのイラストやその色使いがとても気に入りました。私のVTuber「nvyna」のオリジナル曲のキーアートを描いていただけないでしょうか？\n\n彼女の名前はnvynaで、男の子がアンドロイドの女の子に変身したキャラクターです。身長は155cm（耳を含む）で、明るく子供っぽい性格です。また、ゲームとお菓子が大好きです。\n\nイラストについては、解像度を1920x1080にしていただき、「時間との戦い」というコンセプトに基づいて描いていただきたいです。 ただし、曲のテーマに合うと思えば、基本的に自由に制作していただいて構いません。\n\n楽曲はこちらです：https://drive.google.com/drive/folders/1FDKzJAmhTRlMzVK-9czznb6NQhQjbpJd?usp=sharing\n\nそれ以外の構成については、すべてお任せします。\n\nこのイラストは、楽曲のミュージックビデオ、アルバムカバー、SNS用として使用します。もし報酬額に納得いただけない場合は、ご希望の金額で再依頼することも可能です。\nよろしくお願いします！\n\nhttps://drive.google.com/drive/folders/1GaInxxW9BnKIV8yUiwwmJjnJ70vQWW_B", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@nijinomaya/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3386961, "client_id": 2937535, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/277ec0b2/uploads/origins/7acdb353-3c29-4b52-bd41-9d2499161c25?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=04c914fd2ca90ed38cc2307e2dd5f353", "srcset": "https://si.imgix.net/277ec0b2/uploads/origins/7acdb353-3c29-4b52-bd41-9d2499161c25?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=04c914fd2ca90ed38cc2307e2dd5f353, https://si.imgix.net/277ec0b2/uploads/origins/7acdb353-3c29-4b52-bd41-9d2499161c25?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=fd8e346ae8dff5a22cdd7d75eb21a2ca 2x, https://si.imgix.net/277ec0b2/uploads/origins/7acdb353-3c29-4b52-bd41-9d2499161c25?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b469360bec08fbd2142b397d28cf7944 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/277ec0b2/uploads/origins/7acdb353-3c29-4b52-bd41-9d2499161c25?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=be4f370a65c9ea7da8aeee7a2c833211", "srcset": "https://si.imgix.net/277ec0b2/uploads/origins/7acdb353-3c29-4b52-bd41-9d2499161c25?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=be4f370a65c9ea7da8aeee7a2c833211, https://si.imgix.net/277ec0b2/uploads/origins/7acdb353-3c