tps://si.imgix.net/fce45ac3/uploads/origins/507c3719-e537-4f53-83fe-d13223a75679?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ce5956806ea6839e1d44ae498eee26dd 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/fce45ac3/uploads/origins/507c3719-e537-4f53-83fe-d13223a75679?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5afda2dbc9f5d0104f81bcec1f693715", "srcset": "https://si.imgix.net/fce45ac3/uploads/origins/507c3719-e537-4f53-83fe-d13223a75679?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5afda2dbc9f5d0104f81bcec1f693715, https://si.imgix.net/fce45ac3/uploads/origins/507c3719-e537-4f53-83fe-d13223a75679?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=0c543abb3398eee7ecb7f0dfbe223b15 2x, https://si.imgix.net/fce45ac3/uploads/origins/507c3719-e537-4f53-83fe-d13223a75679?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=ef6b89690c0c48cbb179a4d4a6483f61 3x"}, "body": "始めまして、Xを見ていたところ可愛らしいイラストに目が惹かれ、\nちょうどskebを募集していた為、リクエストを送らせて頂きました。\n\n構図等指定はありません。\n全身写っているイラストでお願いしたいです。\n服装は好きに変えて頂いて大丈夫です。\n画像はPSDでいただけると幸いです。\n\nキャラクターのデザイン\n\nモチーフ→おばけ、夜空（雨）\n\n特徴→ツーサイドアップにインナーカラーに夜空が入っています。\n　　　月や星のモチーフが多めです（これは服装を変える際に反映して頂けると嬉しいです。）\n　　　胸元、髪飾りにおばけがあり、手に持っているおばけを常に連れているイメージです。\n\n\nよろしくお願いします。\n\nhttps://drive.google.com/drive/folders/15HWD9cRZXcwxUh8D_DEYwUpVdjzFyx25?usp=drive_link", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@qyupuu/works/11", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3143920, "client_id": 3188636, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/d329199c/uploads/origins/d15376be-f6bb-41be-8b93-5765351bb88d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=