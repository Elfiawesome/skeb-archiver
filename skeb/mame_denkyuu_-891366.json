めております。 https://drive.google.com/drive/folders/1x2ExG6zseLlADplEry-IJODOFO3F567l?usp=share_link  \n\nボイス有りのストーリーPVも参考にして頂ければ幸いです。\n 【Teaser PV】白狼ルフ ティザーPV【#新人vtuber 】 https://youtu.be/Eb5v6YZ1PRQ  \n\nよろしくお願い致します。", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@mame_denkyuu_/works/8", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3626499, "client_id": 1103855, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/062ef1a0/uploads/origins/daf94d7a-e26f-4ca7-b325-b2295a4bcb52?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=90de9fc4d81d722412d0f28e1d95ccc4", "srcset": "https://si.imgix.net/062ef1a0/uploads/origins/daf94d7a-e26f-4ca7-b325-b2295a4bcb52?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=90de9fc4d81d722412d0f28e1d95ccc4, https://si.imgix.net/062ef1a0/uploads/origins/daf94d7a-e26f-4ca7-b325-b2295a4bcb52?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=9d4c7add4893e873700cfab3fb672f79 2x, https://si.imgix.net/062ef1a0/uploads/origins/daf94d7a-e26f-4ca7-b325-b2295a4bcb52?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=3ebdde1a91e3dc3ac64e116efe2728f2 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/062ef1a0/uploads/origins/daf94d7a-e26f-4ca7-b325-b2295a4bcb52?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=95e391cceffa7d74c0e1c307b2962069", "srcset": "https://si.imgix.net/062ef1a0/uploads/origins/daf94d7a-e26f-4ca7-b325-b2295a4bcb52?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=95e391cceffa7d74c0e1c307b2962069, https://si.imgix.net/062ef1a0/uploads/origins/daf94d7a-e26f-4ca7-b325-b2295a4bcb52?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=5723085af