05430/uploads/origins/f447a83a-113a-42f0-8547-3374a815c743?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=cbc983e68f1b8bdd16e41a4289c0c112 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/3e805430/uploads/origins/f447a83a-113a-42f0-8547-3374a815c743?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=39fa5eb5a7fed0daa8ed698d17a129b0", "srcset": "https://si.imgix.net/3e805430/uploads/origins/f447a83a-113a-42f0-8547-3374a815c743?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=39fa5eb5a7fed0daa8ed698d17a129b0, https://si.imgix.net/3e805430/uploads/origins/f447a83a-113a-42f0-8547-3374a815c743?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=a81e370fb2bf2e66f240f5d43339cea0 2x, https://si.imgix.net/3e805430/uploads/origins/f447a83a-113a-42f0-8547-3374a815c743?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=1c201d218595bf7eca2d079603dc56d2 3x"}, "body": "アピールすごく嬉しいです...！\nぜひ、うちのOCの「鮫氷しゃち」をお願いできますか？ \nテーマや構図等は自由に決めていただいて構いません。\n███\n鮫氷 しゃち（さめすが しゃち）\n細身かつ色白の黒髪ロングストレート。\n白と黒を基調にしたセーラー服にセーラーキャップを着こなす。\nアイドル的な元気さと明るさに加え、清楚で可憐な容姿をしている。 \n好奇心旺盛で趣味はテーマパーク巡りと人間観察。\nかなりの偏食家で、気に入ったものはヘビロテする。その一方で飽きるのも早い。  \n親しい間柄の相手でさえ巧みに感情を操って都合よく利用する。\nその言動はどこか演技的で大げさ。\n先天的に共感性が欠落しており、一見感情のように見えるものは人間観察の結果身に着けたものでしかない。\n███\n宛名・背景はpsdでon/offできると幸いです。\n使用用途は個人活動全般（動画配信の待機画面等、個人サイトやSNS等での小説の挿絵、キャラ紹介、個人活動の告知、トリミング加工を伴うアイコン・ヘッダー・バナーとしての使用等、コミッションでのイラスト等依頼時に参考資料等）を考えています。\n\nhttps://drive.google.com/drive/folders/15QcfblJ6ABjLUrKZ3ijKi-ncxD6c6GKd", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@ameame_nj/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2899581, "client_id": 154813, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.i