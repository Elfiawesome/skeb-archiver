\n\nもしご縁がありましたら先生の一筆を楽しみにしております。\nここまで読んでいただきありがとうございました！\n\nhttps://x.com/Jiangshi_Jis/status/1631648116947701761?s=20", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@_azhr_/works/8", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 328, "client_id": 2851674, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/b933e5f1/uploads/origins/967c08d0-5332-4b63-803d-3ab8665bec66?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=95dc53d1602b9b363220d18d92a922b4", "srcset": "https://si.imgix.net/b933e5f1/uploads/origins/967c08d0-5332-4b63-803d-3ab8665bec66?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=95dc53d1602b9b363220d18d92a922b4, https://si.imgix.net/b933e5f1/uploads/origins/967c08d0-5332-4b63-803d-3ab8665bec66?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=3af32c243dbbfbd2468ccc2acf80faf7 2x, https://si.imgix.net/b933e5f1/uploads/origins/967c08d0-5332-4b63-803d-3ab8665bec66?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=eff007c46ea75711de7f990c83c7ceda 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/b933e5f1/uploads/origins/967c08d0-5332-4b63-803d-3ab8665bec66?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9357a478b3d30daea7852d4674e68cbd", "srcset": "https://si.imgix.net/b933e5f1/uploads/origins/967c08d0-5332-4b63-803d-3ab8665bec66?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9357a478b3d30daea7852d4674e68cbd, https://si.imgix.net/b933e5f1/uploads/origins/967c08d0-5332-4b63-803d-3ab8665bec66?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=e73eb7e0e7ecc1dc99b8bc33d0293df0 2x, https://si.imgix.net/b933e5f1/uploads/origins/967c08d0-5332-4b63-803d-3ab866