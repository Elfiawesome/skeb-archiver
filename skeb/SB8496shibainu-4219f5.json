剣を握ると安定感と力強さを感じさせる。\n\n[服装]\n戦闘用：黒の、体にぴったりとフィットした戦闘スーツ。\n普段着：ミニマルでタクティカルなスタイル（黒のTシャツ、カーゴパンツ、タクティカルブーツ）。\n\n[雰囲気と重要な特徴]\nオーラ：超合理的な一匹狼。身も凍るような、近づきがたい雰囲気を放っている。\n個性（視覚効果）：身体的な接触を深く嫌う。誰かが近づきすぎると、警告として足元の地面に氷の棘が音もなく現れる。\n設定（雰囲気の参考）：失われた過去を取り戻すため、自らの限界まで追い込む記憶喪失の生存者。\n外見はこちらを参照：\n（https://drive.google.com/drive/folders/1es2228-_oylkJaHeiLTlw-qwL8tKxovs）\n\nありがとうございます！", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@SB8496shibainu/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 4013944, "client_id": 2103927, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/9edcc699/uploads/origins/6c5f8903-0f9b-44e4-a9cb-749e5ffefdac?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=aeb2b879b30a4475714c4ab664ee083e", "srcset": "https://si.imgix.net/9edcc699/uploads/origins/6c5f8903-0f9b-44e4-a9cb-749e5ffefdac?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=aeb2b879b30a4475714c4ab664ee083e, https://si.imgix.net/9edcc699/uploads/origins/6c5f8903-0f9b-44e4-a9cb-749e5ffefdac?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=eafebde0178c9894656202ea9e1a27b6 2x, https://si.imgix.net/9edcc699/uploads/origins/6c5f8903-0f9b-44e4-a9cb-749e5ffefdac?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=739828ce1df2e5d684126e27daead96e 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/9edcc699/uploads/origins/6c5f8903-0f9b-44e4-a9cb-749e5ffefdac?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=776d32186d5b30557b755c26423bfcb7", "srcset": "https://si.imgix.net/9edcc699/uploads/origins/6c5f8903-0f9b-44e4-a9cb-749e5ffefdac?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=776d32186d5b30557b755c26423bfcb7, https://si.imgix.net/9edcc699/uploads/origins/6c5f8903-0f9b-44e4-a9cb-749e5ffefdac?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=d47ae5ef1e849d042f129f522e256b91 2x, https://si.imgix.net/9edcc699/uploads/origins/6c5f8903-0f9b-44e4-a9cb-749e5ffefdac?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=52f054bab7fb7918a393370586174768 3x"}, "body": "先生、またお会いできて嬉しいです。\n\nリクエストを再提出させていただきたいと思います。\n\n私のオリジナルの狼女キャラクターを、ショートヘアでエキゾチックなギリシャ風のドレスを着た姿で描いてください。前回と同様、背景はシンプルなものにしていただき、昼間の海辺の崖の上に、ギリシャの遺跡を背景にキャラクターが立っている様子を描いてください。また、彼女のイヤリングも描いてください。\n\n髪の参考画像：https://files.catbox.moe/l7qak9.png\n衣装の参考画像：https://files.catbox.moe/u4r5jb.jpg\n背景の参考画像：https://files.catbox.moe/804wus.PNG\n\nすべての参考画像をGoogleドライブのリンクにまとめておきました。今回はぜひうまくいくことを願っています。\n\n改めてありがとうございます。\n\nhttps://drive.google.com/drive/folders/1pLnRTBXyK0qAlf0ERNsnJi4Tt9odbJiu?usp=drive_link", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@SB8496shibainu/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 4013944, "client_id": 1266690, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/e409fbc6/uploads/origins/7c02bd29-b839-449b-9832-3232657d021f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9027ebc159cdc4fb33013aa579896b49", "srcset": "https://si.imgix.net/e409fbc6/uploads/origins/7c02bd29-b839-449b-9832-3232657d021f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9027ebc159cdc4fb33013aa579896b49, https://si.imgix.net/e409fbc6/uploads/origins/7c02bd29-b839-449b-9832-3232657d021f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c1212a866dfbb42687947d239dd4fbc6 2x, https://si.imgix.net/e409fbc6/uploads/origins/7c02bd29-b839-449b-9832-3232657d021f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=2ba1e7a272635fe01474efad670708f6 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/e409fbc6/uploads/origins/7c02bd29-b839-449b-9832-3232657d021f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=69247cdf75b95d7e6a2b2144d7dd9e5a", "srcset": "https://si.imgix.net/e409fbc6/uploads/origins/7c02bd29-b839-449b-9832-3232657d021f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=69247cdf75b95d7e6a2b2144d7dd9e5a, https://si.imgix.net/e409fbc6/uploads/origins/7c02bd29-b839-449b-9832-3232657d021f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=64ccb73c9b1ae2269c4674c24bf4cac1 2x, https://si.imgix.net/e409fbc6/uploads/origins/7c02bd29-b839-449b-9832-3232657d021f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=4f9014adce6d0c27a7e1b8c466457396 3x"}, "body": "こんにちは！\n\n私のエルフのオリジナルキャラクター、リンタラを描いていただけないでしょうか。\n参考画像：https://drive.google.com/drive/u/2/folders/1ebWZpIThveNJQjgqS4DMg-IKcKfnw_Am\n性格：道徳観に疑問符がつくような人物です。\n\n職業は錬金術師で、新しいポーションを開発するのが大好きです。\n\n実験室で、怪しげなポーションが入ったフラスコを掲げている彼女を描いていただけませんか？構図は自由に工夫して、調整もしてください。\n\n彼女の隣で、使い魔がクスクスと笑っている様子も描いてください。\n\nよろしくお願いします。", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@SB8496shibainu/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 4013944, "client_id": 505726, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/7c978866/uploads/origins/e7fe3298-f875-470b-9b32-507bc34b5832?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=73c3a86fd5c8dd597e81229f51744374", "srcset": "https://si.imgix.net/7c978866/uploads/origins/e7fe3298-f875-470b-9b32-507bc34b5832?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=73c3a86fd5c8dd597e81229f51744374, https://si.imgix.net/7c978866/uploads/origins/e7fe3298-f875-470b-9b32-507bc34b5832?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=98eca3b348c43412436e3c327d11bb57 2x, https://si.imgix.net/7c978866/uploads/origins/e7fe3298-f875-470b-9b32-507bc34b5832?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=eb913c6bce78b4f8cfa0bd237fbda691 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/7c978866/uploads/origins/e7fe3298-f875-470b-9b32-507bc34b5832?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=1368ac1f611c437b8c67b33ce54943be", "srcset": "https://si.imgix.net/7c978866/uploads/origins/e7fe3298-f875-470b-9b32-507bc34b5832?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=1368ac1f611c437b8c67b33ce54943be, https://si.imgix.net/7c978866/uploads/origins/e7fe3298-f875-470b-9b32-507bc34b5832?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=a4c501d81fd05efe7c64042d678f3c16 2x, https://si.imgix.net/7c978866/uploads/origins/e7fe3298-f875-470b-9b32-507bc34b5832?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=ce7d283e72908f81a4ce3a0bb681bff5 3x"}, "body": "あなたの絵、すごく素敵ですね！ぜひ私のキャラクターを描いてほしいです！ 私のオリジナルキャラクターである「スリッピー」という馬の女の子を描いていただけませんか？身長は約200cmです。彼女は短気な戦士で、競争が大好きです。普段は戦闘かレースに明け暮れていますが、時には大自然の中でくつろぐこともあります。絵のポーズやシチュエーションは、お任せします。\nご依頼をご検討いただき、ありがとうございます！\n\nhttps://drive.google.com/drive/folders/1x2GyjCMTj6kt15VCRaC2OSAMp8jSqtSv?usp=sharing", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@SB8496shibainu/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 4013944, "client_id": 2103927, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/3d31e459/uploads/origins/8fd5ad2d-778b-459b-8679-2e69255c1ecc?bg=%23fff&auto=format%2Ccompress&fm=w