bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=379c5bfaaaac6dd574dc87984e7ff53e 3x"}, "body": "はたほまめ様\n\nこんにちは、潤野ねむです。\n以前個人依頼にてこちらの大変素敵な記念イラストをご制作いただきました。その節はありがとうございました！\nhttps://x.com/i/status/1700704165910172052\n\nとても可愛くてお気に入りなので、同じお衣装でミニキャラをお願いしたくてskebの再開をずっと心待ちにしておりました。\n今回ミニキャラ専門でのskeb新設とのことで、まさにお願いしたい内容だったので早速リクエスト送らせていただきました。\nご検討いただけましたら幸いです。\n\n使用用途：\nSNS、YouTube等動画サイト(収益化の可能性あり)、支援サイトにてVTuber活動としての使用\n\nリクエスト内容：\n大きなツノが自慢の羊の女の子です。\n衣装は以前デザインしていただいたもので、構図や表情などはお任せでお願いします。\n前にご依頼した時と現在のLive2Dモデルが変わっております。参考画像を添えておりますが、無理に現在の方に寄せていただかなくて大丈夫です。はたほまめ様の当時のままの解釈でご制作いただけたらと思います。\n\n形式：\nPSDかPNG希望です。背景がある場合は人物のみの透過データと分けていただけると助かります。\n\nよろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/1dmHAOd9mZLYaHM1DAuBvgL3i55WiaxOq?usp=sharing", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@hatahomame/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3964220, "client_id": 3047244, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/e2555832/uploads/origins/db435eab-319e-438f-b73b-7a6fac3d78e9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4b812af48c0c6cd00c5af269eedc6de3", "srcset": "https://si.imgix.net/e2555832/uploads/origins/db435eab-319e-438f-b73b-7a6fac3d78e9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4b812af48c0c6cd00c5af269eedc6de3, https://si.imgix.net/e2555832/uploads/origins/db435eab-319e-438f-b73b-7a6fac3d78e9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=8f6a139d2991ce6297b52877f0bc5267 2x, https://si.imgix.net/e2555832/uploads/origins/db435eab-319e-438f-b73b-7a6fac3d78e9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b14d49e546923c6c5489f88e04ac0feb 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/e2555832/uploads/origins/db435eab-319e-438f-b73b-7a6fac3d78e9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=8ddf021a1933cd83db71dcdf39032db5", "srcset": "https://si.imgix.net/e2555832/uploads/origins/db435eab-319e-438f-b73b-7a6fac3d78e9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=8ddf021a1933cd83db71dcdf39032db5, https://si.imgix.net/e2555832/uploads/origins/db435eab-319e-438f-b73b-7a6fac3d78e9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=21247975d4560a42066e7ecc25ce340b 2x, https://si.imgix.net/e2555832/uploads/origins/db435eab-319e-438f-b73b-7a6fac3d78e9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=8156bc51e23db5563a005e6be392a3f7 3x"}, "body": "はたほまめ様\n\nはじめまして、個人で活動しております常寝（とこね）はなと申します。\nぎんちゃんフィギュアから先生の事を知り、柔らかな色合いや可愛らしい表情に引き込まれました！\n是非とも私自身も描いて頂きたくリクエストを送らせて頂きます！\n\n依頼内容≫\n・ポスト時サイズのデフォルメイラスト\n・お誕生日要素があると嬉しいです！\n・夏がお誕生日なので、ダークな雰囲気よりも明るい雰囲気でお願いしたいです！\n先生のインスピレーションで別のものがありましたら、こちら関係なく自由に描いて頂きたいです！！\n\nキャラクター設定≫\nいつまでも寝ていられたらな～！うさぎとたのしいことがすきな明るくのんびりマイペースなお寝坊さん！\nヘアカラーのピンクという要素のみ残して頂ければ、髪型・服装も全て自由に変えて楽しんで頂いて構いません！\n参考程度にモチーフ、すきなものをいくつか記入しておきます！\n　→　小花（さくら・ネモフィラ・ラグランジア）、うさぎ、リボン、レース、おえかき、寝ることがすき\n\n\n使用用途≫\n・SNS投稿,アイコン使用\n・Youtube、Twitch等配信上での使用\n・グッズ化での商用利用\n\n\n希望納品形式≫\nPNG or PSD、背景と人物のレイヤーを分けて納品いただけますと嬉しく存じます。\n\n\nご参考資料≫\nhttps://drive.google.com/drive/folders/1LHplwIqPZ4YUreRH322fZP1qVrse2V-9?usp=sharing\n\nご検討の程よろしくお願い致します！", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@hatahomame/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3964220, "client_id": 336465, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/76a7bc88/uploads/origins/e37c04eb-0715-4192-972f-86e672b13ecf?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d3fe9b8540ff9a0