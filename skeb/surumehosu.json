ult_amount": 8800}, {"genre": "comic", "default_amount": 12000}, {"genre": "video", "default_amount": 18000}], "acceptable_only_public": false, "tip_acceptable": true, "yearly_report_client_visible": false, "total_appeals_count": 281, "received_works": [{"path": "/@surumehosu/works/72", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1118579, "client_id": 3620563, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/1ef8b97b/uploads/origins/1a60a247-85ee-420d-8e49-a5bdf04f5221?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f33f87984c76be9db8fccb88dd80e189", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/1ef8b97b/uploads/origins/1a60a247-85ee-420d-8e49-a5bdf04f5221?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=1d963673aa46ae8c0bdb5a0d0bad3394", "src_set": ""}, "body": "ちくわの天ぷら様、初めまして。\n漫画家Vtuberをしております、甘宙ぺたと申します。\n\nやわらかくほんわかした絵柄と、美味しそうな食べ物や背景、そして動物たちに魅力を感じ、ぜひご依頼させて頂きたい……！と思った所存です。\n\n＊概要\n可能であれば1920×1080サイズ\n髪などが見切れていない（可能な範囲で大丈夫です）人物や小物のみの透過データ別途希望\nこちらでデータを元に横長にデザインして宜しければ縦長や正方形等でも問題ございません！\n\n＊キャラクター資料、衣装\nhttps://www.youtube.com/live/nR-U51mcfRk?si=a1Wc4YO2G5OLcBp_&t=9950\n（URL先、写真撮影タイムに時間指定をしております）\n動いた際に見える箇所がある事と、差分で小物が色々あるため、お手数ですがこちらをご覧いただけますとわかりやすいかと思います。ほか、別途URLは新規衣装として実装した制服です。\nお衣装の指定はございませんので、ちくわの天ぷら様が「可愛い」と思うものを既存のものからチョイス、もしくはデザインして着せて頂けましたら嬉しいです。\n\n＊構図、ポージングなど\nお任せいたします\n相方のうさぎのぬいぐるみがいるのですが（資料あり）、物として置くのではなく、生き物として動いて二人でなにかしているふう……になっていると嬉しいです。\n\n＊イラストの使用用途\n横長一枚絵はPC用、スマホ用それぞれの壁紙として、メンバーシップの返礼品にしたく考えております（データのサイズ等、こちらでさわらせて頂くことになります）。\n背景透過状態のデータはサムネイル等の活動に使わせていただく予定です。ほか　未定ではありますが、可能であればグッズ化させていただきたいです。\n\nご都合が合うようでしたらご検討いただけましたら幸いです。\nご予算が足りない場合は、お手数ですが一度お戻し頂けましたら助かります。\nお忙しいところ、ここまでお目通しいただきありがとうございました。\n何卒よろしくお願いいたします。\n\nhttps://drive.google.com/file/d/1tv-JGMQ0P20ryHVs4U2nxNMLeYuTSsIG/view?usp=sharing", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@surumehosu/works/71", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1118579, "client_id": 1765810, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/b55b5e23/uploads/origins/49ea9b0c-0069-404b-928d-a061918375f1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=14342228c04892c9e650d90067d49311", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/b55b5e23/uploads/origins/49ea9b0c-0069-404b-928d-a061918375f1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6847ff52d005679db2c3fdb1b96e19e1", "src_set": ""}, "body": "こんにちは！あなたのスタイルはとてもかわいいですね！彼はとてもフワフワしたライオンヘッドのウサギで、名前はバンストン（オス）です。性格はやや怠け者ですが、時々エネルギーが爆発して、とても速く走ったりジャンプしたりします。好奇心旺盛で、探検するのが大好き。好きな食べ物はバナナで、猫のようにゴロンと寝るのが大好き。\n\n背中の模様が同じでなくても大丈夫で、角度によっては目の斑点のひとつがハートのように見えることがよくあります。彼のいろいろな写真を載せましたが、さらに参考になるものが必要なら、他の人が描いた絵のギャラリーもここにあります： https://toyhou.se/20733520.bunston/gallery\n\nご検討ありがとうございました！\n\nhttps://drive.google.com/drive/folders/1n4iE15xAedw_IB1K-A2TgWXs5jjJHVb8?usp=sharing", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@surumehosu/works/70", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1118579, "client_id": 1685426, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/eb488af0/uploads/origins/f4f3b4bf-39d2-43d5-a591-c316e40230fb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b37ec018fbf787db6a76f6b6831e2856", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/eb488af0/uploads/origins/f4f3b4bf-39d2-43d5-a591-c316e40230fb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur