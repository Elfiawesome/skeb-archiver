oder": "image", "creator_acceptable_same_genre": false}, {"path": "/@MUMIN0_00/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2769200, "client_id": 1934866, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/279ef68d/uploads/origins/bd55ba89-41af-481e-9456-2855e984c431?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ac5466c1f92803822eaf4aca84d7d7cc", "srcset": "https://si.imgix.net/279ef68d/uploads/origins/bd55ba89-41af-481e-9456-2855e984c431?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ac5466c1f92803822eaf4aca84d7d7cc, https://si.imgix.net/279ef68d/uploads/origins/bd55ba89-41af-481e-9456-2855e984c431?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=6995fe30f47236090d7b02cf531d1c29 2x, https://si.imgix.net/279ef68d/uploads/origins/bd55ba89-41af-481e-9456-2855e984c431?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=3fcb485a8dbaabbaff4a9919a7c66b44 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/279ef68d/uploads/origins/bd55ba89-41af-481e-9456-2855e984c431?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9423f683853c4280853355ce22c03dcf", "srcset": "https://si.imgix.net/279ef68d/uploads/origins/bd55ba89-41af-481e-9456-2855e984c431?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9423f683853c4280853355ce22c03dcf, https://si.imgix.net/279ef68d/uploads/origins/bd55ba89-41af-481e-9456-2855e984c431?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=fd33291ba114296836fd88a146652ea7 2x, https://si.imgix.net/279ef68d/uploads/origins/bd55ba89-41af-481e-9456-2855e984c431?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=5cfc993347a9c2ba517bf9cc6a3567fe 3x"}, "body": "こんにちは！私の悪魔のキャラクター、Vhelのアートをお願いしたいのですが、いかがでしょうか？\n\nVhelは静かで思慮深い人です。彼女は対話するのではなく、観察するのが好きです。彼女は背景で物事をセットアップし、すべてがどのように再生するかを見ることを好む。彼女は邪悪に見えるが、公平である。彼女は善にも悪にも味方せず、ただ自分のしたいことをする。\n\n彼女の主な特徴は、赤い肌、金の目、4本の角、黒い鱗、とがった尻尾です。\n(鱗と角は全部黒にしてください。参考画像をまだ更新できていません。すみません！)\n\nVhelに合うテーマ：ゴシックでダークなもの、有毒で致命的な植物、不気味でホラーなもの、地獄の猟犬、蛇、彼岸花、骨や骸骨など。\n彼女は強いテーマが似合うと思います。それは伝統的なものでもモダンなものでもよいでしょう。\n伝統的なテーマでは、フォークロア、浮世絵風アート、神話的なテーマなどを使用することができます。\nモダンは、ゴシックファッションやパンクファッションのような、クリエイティブでより楽しいものになります。\nVhelは以前、不良少女として描かれたことがあるので（助番）、それも使えるテーマです。\nテーマやアイデアのピンタレストボードはこちらです： https://www.pinterest.pt/9birds/vhel/\n\n参考URLの衣装やアイデアを使ってもいいし、自分で作ってもいいし、自由に工夫してください。\nあなたのスタイルで彼女を見るのが楽しみです！\n\nご検討のほど、よろしくお願いいたします！\n\nhttps://drive.google.com/drive/folders/16Wd2nRAMP7OctIp8GAC_VZtD4xU7cJVp?usp=sharing", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}], "sent_works": [], "similar_creators": [{"id": 256, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "筆禍＠ぴかすすちゃん発売中", "screen_name": "hikka06", "avatar_url": "https://pbs.twimg.com/profile_images/2062499802882232320/REN7JKt9.jpg", "header_url": "https://pbs.twimg.com/profile_banners/85097065/1737786245/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 14, "complete_expiration_days": 90, "skills": [{"genre": "comic"}], "banned": false, "nc": 177}, {"id": 601314, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "818/yaiba", "screen_name": "YAIBA818", "avatar_url": "https://pbs.twimg.com/profile_images/1931397024282525696/S4HfgPxB.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1260432729168130048/1760865897/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expirat