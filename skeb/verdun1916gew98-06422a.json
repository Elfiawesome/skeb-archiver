慣れているが、ときどき足が抜けなくなる。\n　　　◇泥沼を歩くと「グチュ」「ズボッ」と音がする。\n　　　◇他のメンバーは泥沼の外で後方支援（イラストはめぐみのみ、ストーリーで他メンバーが登場）\n　　　◇めぐみの心情を含める。（ストーリー）\n背景　◇地下の泥沼（詳細はおまかせ）\nオプション　◯『今日は田植えです！』のようなストーリー\n差分　○ロングブーツを同色のHUNTERの長靴に変更\n　　　◇背景のみ、人物のみのレイヤー（可能であれば）\n他サイト掲載　○希望する\n\n※イメージが合わない場合は上記に関わらず、適宜変更。\n\nhttps://www.pixiv.net/artworks/93577745", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@verdun1916gew98/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3660312, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/9d990458/uploads/origins/a785e64a-341e-412c-b520-149a8018cf3f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3506376c3dd87f09542bb09aea899961", "srcset": "https://si.imgix.net/9d990458/uploads/origins/a785e64a-341e-412c-b520-149a8018cf3f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3506376c3dd87f09542bb09aea899961, https://si.imgix.net/9d990458/uploads/origins/a785e64a-341e-412c-b520-149a8018cf3f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=24d9892dccd0441132198c05d48acfeb 2x, https://si.imgix.net/9d990458/uploads/origins/a785e64a-341e-412c-b520-149a8018cf3f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=59ec7576e0605bf07b174e097966fbce 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/9d990458/uploads/origins/a785e64a-341e-412c-b520-149a8018cf3f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=50df2597e46d727aa22e81cb59778d7c", "srcset": "https://si.imgix.net/9d990458/uploads/origins/a785e64a-341e-412c-b520-149a8018cf3f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=50df2597e46d727aa22e81cb59778d7c, https://si.imgix.net/9d990458/uploads/origins/a785e64a-341e-412c-b520-149a8018cf3f?bg=%23fff&auto=