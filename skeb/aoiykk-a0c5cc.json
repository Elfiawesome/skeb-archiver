16419549-d4b8-40b9-bfc6-de27ae77f59d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=ac42e59650755e442063753ee5a54407 3x"}, "body": "はじめまして。\nいつもイラストを拝見しております。淡く優しい感じの女性イラストがとても好みで、是非イラストを描いていただきたいと思い、リクエストさせていただきます。\n\nオリジナル小説のイラストをご依頼したいです。\n描いていただきたいのは「トラウマを抱えていたひねくれ者の少女が、友人に祝福の言葉を言われて、泣き笑いの表情になっている」というシーンになります。\n\n少女の特徴は下記のとおりです。\n・十代半ば\n・小柄で痩せ型\n・淡い金色のセミロングの髪、軽いウェーブ\n・碧眼\n\n夏の夜のシーンという設定で、服装や背景、構図などお任せしたいです。\n\n小説は下記のとおり公開しております。\nエピローグのシーンですので、その部分読んでいただければイメージしやすいかもしれません。\nhttps://www.pixiv.net/novel/show.php?id=16591303\n\nご検討何卒よろしくお願いいたします。", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@aoiykk/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1939464, "client_id": 1209973, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/9f6f7f25/uploads/origins/b5a116b8-6b1e-4a14-8d98-cf3ea80cc88d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=13e7a67bdc79241a497c63b7e81a4fb3", "srcset": "https://si.imgix.net/9f6f7f25/uploads/origins/b5a116b8-6b1e-4a14-8d98-cf3ea80cc88d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=13e7a67bdc79241a497c63b7e81a4fb3, https://si.imgix.net/9f6f7f25/uploads/origins/b5a116b8-6b1e-4a14-8d98-cf3ea80cc88d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=6924c271e700d7d3ba5349eb9b3870e1 2x, https://si.imgix.net/9f6f7f25/uploads/origins/b5a116b8-6b1e-4a14-8d98-cf3ea80cc88d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=fcfdd8a19df51e45b85437e65eb43a28 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/9f6f7f25/uploads/origins/b5a116b8-6b1e-4a14-8d98-cf3ea80cc88d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ba5dca81210fd08ee1af56ac30feda08", "srcset": "ht