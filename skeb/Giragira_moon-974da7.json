e/folders/1E_Sr7LPt15qcSCECw2RirzRcy2xQ4EYG", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Giragira_moon/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2917691, "client_id": 1224605, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/f75e8f85/uploads/origins/b89c21ce-6eed-4289-89db-9964dfddaa1c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4031f91d76dca00a11c9927e1707b1ad", "srcset": "https://si.imgix.net/f75e8f85/uploads/origins/b89c21ce-6eed-4289-89db-9964dfddaa1c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4031f91d76dca00a11c9927e1707b1ad, https://si.imgix.net/f75e8f85/uploads/origins/b89c21ce-6eed-4289-89db-9964dfddaa1c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=2e7ed998166f10a7c3b4b61a7d01e9af 2x, https://si.imgix.net/f75e8f85/uploads/origins/b89c21ce-6eed-4289-89db-9964dfddaa1c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=befde256eb89805ce142973da81434ff 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/f75e8f85/uploads/origins/b89c21ce-6eed-4289-89db-9964dfddaa1c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d187084d33ce03be82c193f28c10cf74", "srcset": "https://si.imgix.net/f75e8f85/uploads/origins/b89c21ce-6eed-4289-89db-9964dfddaa1c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d187084d33ce03be82c193f28c10cf74, https://si.imgix.net/f75e8f85/uploads/origins/b89c21ce-6eed-4289-89db-9964dfddaa1c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=be50dffe1fcecc1d82a04a1aefc06431 2x, https://si.imgix.net/f75e8f85/uploads/origins/b89c21ce-6eed-4289-89db-9964dfddaa1c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&cro