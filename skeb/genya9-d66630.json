ndalign=center&blendmode=normal&blendsize=inherit&bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=5e0dbe69fd7dbd593bfbfdfa8be335ee 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1961591604902498304%2FgKQ1eqWf.jpg?blend64=aHR0cHM6Ly9za2ViLWF2YXRhci5pbWdpeC5uZXQvfnRleHQ_&blendalpha=100&blendalign=center&blendmode=normal&blendsize=inherit&bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=13a5dc7b2960fe8a673ff3061fbf69fb", "srcset": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1961591604902498304%2FgKQ1eqWf.jpg?blend64=aHR0cHM6Ly9za2ViLWF2YXRhci5pbWdpeC5uZXQvfnRleHQ_&blendalpha=100&blendalign=center&blendmode=normal&blendsize=inherit&bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=13a5dc7b2960fe8a673ff3061fbf69fb, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1961591604902498304%2FgKQ1eqWf.jpg?blend64=aHR0cHM6Ly9za2ViLWF2YXRhci5pbWdpeC5uZXQvfnRleHQ_&blendalpha=100&blendalign=center&blendmode=normal&blendsize=inherit&bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=d182a05bf03507fb53e57e4836a4f6f6 2x, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1961591604902498304%2FgKQ1eqWf.jpg?blend64=aHR0cHM6Ly9za2ViLWF2YXRhci5pbWdpeC5uZXQvfnRleHQ_&blendalpha=100&blendalign=center&blendmode=normal&blendsize=inherit&bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=b203d6e9f44056ab746e6885be2ddd0a 3x"}, "body": "PBWチェインパラドクスの新宿島にて再会した3人の短いお話を書いて頂けないでしょうか。ご検討お願いします。22年9月に依頼しましたお話の続きになります。\n\n■シチュエーション：2023年7月31日、リディルとドラウはなんか聞いた事がある歌声を耳にしたのでそちらへ向かうと、やっぱり姿が違うけど間違いなく自分たちの仲間である“ロード・ヴァッサー”を見つけたのであった。\nロードは新宿島に漂着して、とにかく不安で怖くて自分を落ち着かせるために大好きな歌を歌っていた所を発見された。\n☆コメディ、日常チックな話だと嬉しいです。シリアスが似合わない人達なので。\n\n■登場人物\n全員お互いを名前呼び捨てで。\n○リディル・ヴェント　\nhttps://tw7.t-walker.jp/character/status/g00550\n明るくて勝ち気で自信家。カツ丼好き。スーパー音痴だが本人は全く自覚していない。\n口調：アタシ、ね、よ、なの、かしら？\n\n○ドラウ・スオーロ　\nhttps://tw7.t-walker.jp/character/status/g07947\n真面目で物静かで正義感が強い。メンバー1の天然キャラ。\n口調：私、だ、だな、だろう、なのか？、む…、ふむ…\n\n○ロード・ヴァッサー\nhttps://tw7.t-walker.jp/character/status/g10141\nウェアキャットになっていた仲間。\n大人しくて優しくて可愛らしい少年。争い事が苦手。七曜の戦とかいう謎の戦いにビビりまくっている。\n音楽が大好きで特に歌う事が好き。\nそんな彼は実は二重人格で表ロードが馬鹿にされたりピンチになると庇う様に出てきてケンカ腰になる。ディアボロスになってからはどうもネメシス時に出てくるようになったっぽい。仲間達はこの彼の事を“裏ロード”と呼び、一応表ロードには裏ロードの事を内緒にしている。それもあって表ロードは裏ロードの存在を知らない。\nリディルとドラウは「あれ？裏ロードは？」とヒソヒソ話をするが、後々裏ロードもいる事に気付く事になる。\n裏ロードは表ロード想いの良い奴ではある。\n口調：ボク、だね、だよ、だよね、なのかな？\n裏の口調：オレ、なんだコラおいてめぇ！…みたいな。\n（この2重人格設定は深い意味や過去等があるというわけではなく、性格が豹変するそういうキャラという位置づけです）", "nc": 137, "word_count": 1878, "transcoder": "text", "creator_acceptable_same_genre": true}, {"path": "/@genya9/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "novel", "tipped": true, "creator_id": 519975, "client_id": 2296228, "vtt_url": null, "thumbnail_image_urls": {"src": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1961591604902498304%2FgKQ1eqWf.jpg?blend64=aHR0cHM6Ly9za2ViLWF2YXRhci5pbWdpeC5uZXQvfnRleHQ_&blendalpha=100&blendalign=center&blendmode=normal&blendsize=inherit&bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4924332848e7ab20cfdbc727311aeea3", "srcset": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1961591604902498304%2FgKQ1eqWf.jpg?blend64=aHR0cHM6Ly9za2ViLWF2YXRhci5pbWdpeC5uZXQvfnRleHQ_&blendalpha=100&blendalign=center&blendmode=normal&blendsize=inherit&bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4924332848e7ab20cfdbc727311aeea3, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1961591604902498304%2FgKQ1eqWf.jpg?blend64=aHR0cHM6Ly9za2ViLWF2YXRhci5pbWdpeC5uZXQvfnRleHQ_&blendalpha=100&blendalign=center&blendmode=normal&blendsize=inherit&bg=%23fff&a