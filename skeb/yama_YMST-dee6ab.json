ま様はダボッとしたパーカーとか制服が描き慣れていらっしゃいそうなので、オリジナルの服装ではなく、そんな感じでお願いできれば幸いです。\n\n〇要望\n飴望にぃなさん本人のVTuber活動での使用許可(配信用のサムネやSNSでの利用等)を頂ければ幸いです。\nまたもし可能でしたら.PSDデータ、もしくは透過PNGにて背景や小物などを非表示した人物のみの透過版を頂けますとありがたいです。\n\n何卒よろしくお願いいたします!!\n\n※ご参考までのガイドライン：ファンアート歓迎とされています\nhttps://varium.jp/guide_line.html", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@yama_YMST/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2796861, "client_id": 113383, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/65b8a6d3/uploads/origins/988d4822-aafb-4bf6-8d0f-24fe738c4c7d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=aa214c76fca6c2454ab43ad37e8d68ed", "srcset": "https://si.imgix.net/65b8a6d3/uploads/origins/988d4822-aafb-4bf6-8d0f-24fe738c4c7d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=aa214c76fca6c2454ab43ad37e8d68ed, https://si.imgix.net/65b8a6d3/uploads/origins/988d4822-aafb-4bf6-8d0f-24fe738c4c7d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=fdc61e4c402dc0450d716929b07aefaa 2x, https://si.imgix.net/65b8a6d3/uploads/origins/988d4822-aafb-4bf6-8d0f-24fe738c4c7d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=33610a2f1618ba2487b8ae6cbf9617ec 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/65b8a6d3/uploads/origins/988d4822-aafb-4bf6-8d0f-24fe738c4c7d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=230e339b55524cd98eb2f159f73bab21", "srcset": "https://si.imgix.net/65b8a6d3/uploads/origins/988d4822-aafb-4bf6-8d0f-24fe738c4c7d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=230e339b55524cd98eb2f159f73bab21, https://si.imgix.net/65b8a6d3/uploads/origins/988d4822-aafb-4bf6-8d0f-24fe738c4c7d?bg=%23fff&auto=format%2Ccompress