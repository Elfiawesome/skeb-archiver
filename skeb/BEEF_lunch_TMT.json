eacd/uploads/origins/e0524a8e-55c7-4c17-8423-daaab5296821?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=06d87907e89a6de477e5f1933cdeecf7 2x, https://si.imgix.net/4354eacd/uploads/origins/e0524a8e-55c7-4c17-8423-daaab5296821?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=14d7238f3c726b9ca36f68b2c3c1da02 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/4354eacd/uploads/origins/e0524a8e-55c7-4c17-8423-daaab5296821?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9dee0ac8bde8252495e740dadb829604", "srcset": "https://si.imgix.net/4354eacd/uploads/origins/e0524a8e-55c7-4c17-8423-daaab5296821?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9dee0ac8bde8252495e740dadb829604, https://si.imgix.net/4354eacd/uploads/origins/e0524a8e-55c7-4c17-8423-daaab5296821?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=240b262b336c206fb6509d75e1e49cbf 2x, https://si.imgix.net/4354eacd/uploads/origins/e0524a8e-55c7-4c17-8423-daaab5296821?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=2e274ca1ee3bcbe889b3f8ec7c72db3f 3x"}, "body": "【牛肉定食】先生、こんにちは！\n先生の素晴らしいイラスト作品が大好きです🥰🫶🏻💕\nぜひ先生と素敵なお取引ができればと思っています！\n\n【基本設定】\n・原作：COCTRPG関連\n・時代背景：1720年代の海賊時代\n・キャラクター：海を冒険する海賊たち\n\n━━━━━━━━━━━━\n【レーガン・ロバーツ】\n■外見：\n- 赤髪、身長189cm\n- 見た目年齢25～30歳\n- 海賊船「セントアン号」船長\n■性格：\n- 短気で普段は不機嫌そうな猫系男子\n- 派手好きだが礼儀正しい\n- 情に厚い大男\n- 成金趣味のイケてる服装が好み\n■特徴：\n- 抱きつくと狼のように温かい\n- 皮肉屋だがすぐカッとなる\n- 意外とロマンチストで悩みが多い\n- 葉巻と酒が大好き\n- 恋愛観は保守的で少し男尊女卑的\n\n━━━━━━━━━━━━\n【リオ・グランジャー】\n■外見：\n- 白髪（染め）、身長162cm\n- 見た目年齢16～20歳\n■性格：\n- 活発な子猫のような性格\n- 内心は冷静で演技派\n- 旧名「リオーラ」、元お嬢様\n■特徴：\n- 性別を隠し男性航海士として活動\n- レーガンが好きだが絶対に告白しない\n- からかわれると慌てて照れる\n- 酒好きだが弱く、酔うとセクハラ魔化\n- お腹が弱点\n\n━━━━━━━━━━━━\n【2人の関係性】\n・「犬猿の仲」のような日常\n・「今日こそ勝負だ！」と張り合う\n・たまに見せるドギマギした姿も最高に可愛い\n\n【特別リクエスト】\n先生、ぜひこの2人を\n「マフィアのボス」＆「新人刑事」\nの衣装で描いていただけませんか？\n関係性は\n【キューピッドの悪戯矢で余計な感情を抱いてしまった不器用な宿敵同士？！】\nという感じでお願いします！\n\n設定の追加・修正は大丈夫🙆\nどうぞよろしくお願いいたします！💕\n\nhttps://weibo.com/5978808231/5179419024425715", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@BEEF_lunch_TMT/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3628884, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/bbdf00ae/uploads/origins/4f518c04-15ea-4b0c-9e8e-32b3c2e393a3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5a6c79a0daeb98575c28e12986d2289b", "srcset": "https://si.imgix.net/bbdf00ae/uploads/origins/4f518c04-15ea-4b0c-9e8e-32b3c2e393a3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5a6c79a0daeb98575c28e12986d2289b, https://si.imgix.net/bbdf00ae/uploads/origins/4f518c04-15ea-4b0c-9e8e-32b3c2e393a3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ed34f441caa4459fb313ee26d8e89ed3 2x, https://si.imgix.net/bbdf00ae/uploads/origins/4f518c04-15ea-4b0c-9e8e-32b3c2e393a3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c36a56e3af068ebf41d8f29809fa3a2a 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/bbdf00ae/uploads/origins/4f518c04-15ea-4b0c-9e8e-32b3c2e393a3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2ae5f75f2e4dbdd46df4f91e8e54dec2", "srcset": "https://si.imgix.net/bbdf00ae/uploads/origins/4f518c04-15ea-4b0c-9e8e-32b3c2e393a3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2ae5f75f2e4dbdd46df4f91e8e54dec2, https://si.imgix.net/bbdf00ae/uploads/origins/4f518c04-15ea-4b0c-9e8e-32b3c2e393a3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=268b1acc07048f622ac4a5d7c24ccd88 2x, https://si.imgix.net/bbdf00a