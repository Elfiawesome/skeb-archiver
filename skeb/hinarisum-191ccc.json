ad61836630?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=fc1f73c86e5e61cf9dba48faeba41ad8", "srcset": "https://si.imgix.net/e8ec3f58/uploads/origins/42480f77-2fa8-4a82-a00d-69ad61836630?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=fc1f73c86e5e61cf9dba48faeba41ad8, https://si.imgix.net/e8ec3f58/uploads/origins/42480f77-2fa8-4a82-a00d-69ad61836630?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=46929e21ae1baa8767c432fca226b1ac 2x, https://si.imgix.net/e8ec3f58/uploads/origins/42480f77-2fa8-4a82-a00d-69ad61836630?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=11d18cd19d0e09f434b03b99e4ea3010 3x"}, "body": "アピールありがとうございます！\nご提案いただいたセクシーなチャイナ服を着た赤髪くんを是非とも見たい！と思い、リクエストさせていただきました！\n\n\n是非とも赤髪くんにセクシーなチャイナ服を着せていただきたいです…！\n日也様の考えた素敵なお洋服を着ている姿、見るのがとても楽しみです〜！！\n\n\n一応の補足として、以下に簡単なキャラ設定を書きますのでご参考にしてください。\n\n＊キャラの簡単な設定\n【赤髪くん】\n　武国(日本と中国を混ぜたような国)で薬の研究をしている16歳の中性的な少年。豊富な知識とずば抜けた頭脳で、幼いながらに一財産築いている天才。ガラの悪い言葉遣いをしたり、気に入らない相手を挑発したりする。腕っぷしは5歳児並みなので、ひたすら避けて逃げて挑発しまくるタイプ。\n　犯罪組織で育ち、組織の人間を家族のように思って懐いている。懐いた人にはすごく子供っぽくなる。\n\n・見た目\n赤髪ストレートの長髪で、ポニーテールをしている。瞳は緑色。タイトで黒っぽい服をよく好んで着る。\n\n\n資料URL\nhttps://drive.google.com/drive/folders/1--EzjDpvct60ZR8Y6KHSNW955V3wu8iA\n\n\nアピール本当にありがとうございました！本文を読んですぐに「セクシー？！脇？！見たい！！！」と思いリクエスト文をしたためています…\n納品とても楽しみにしております！よろしくお願いいたします！", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@hinarisum/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1218348, "client_id": 2011777, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/56304fb2/uploads/origins/ff924185-7036-43d8-86d9-6c06ec002b21?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5ac5034d4508981626666a1e34418b0d", "srcset": "https://si.imgix.net/56304fb2/uploads/origins/ff924185-7036-43d8-86d9-6c06ec002b21?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5ac5034d4508981626666a1e34418b0d, https://si.imgix.net/56304fb2/uploads/origins/ff924185-7036-43d8-86d9-6c06ec002b21?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=3f299fccf06a4e8c5765379be920ad81 2x, https://si.imgix.net/56304fb2/uploads/origins/ff924185-7036-43d8-86d9-6c06ec002b21?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=391b711712b7999a492d64ab35edc19d 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/56304fb2/uploads/origins/ff924185-7036-43d8-86d9-6c06ec002b21?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=dbf9b67faaa3b88ff0e5828edb3558af", "srcset": "https://si.imgix.net/56304fb2/uploads/origins/ff924185-7036-43d8-86d9-6c06ec002b21?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=dbf9b67faaa3b88ff0e5828edb3558af, https://si.imgix.net/56304fb2/uploads/origins/ff924185-7036-43d8-86d9-6c06ec002b21?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=b6ae9babe243bd8bfe903c966409f393 2x, https://si.imgix.net/56304fb2/uploads/origins/ff924185-7036-43d8-86d9-6c06ec002b21?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=a93a05ffc58ada4ecb1e16fae1ab671b 3x"}, "body": "日也 様\n\n初めて依頼させて頂きます、甕下 星辰と申します。\nこの度はアピールして頂きありがとうございます。\nCSや拙作、過去のリクエスト文に眼を通して下さり、また拙宅の六連とヒツキにご興味を持って下さったのは大変嬉しい限りです。\n\n今回はご提案を踏まえ、拙宅の篝 六連と日像 ヒツキのイラストをお願いしたく思います。\n\nシチュエーション・雰囲気は個人的に感じた日也様の作風の様にふわっと和やか・仲良さげに話し合っている親友同士の姿を描いて下さい。\nその他には特に指定はありません。お好きな様に描いて頂けるとありがたく思います。\n\nまた可能でありましたら、Xなど他サイトにてSKEBでの依頼を明記・日也様のIDを記載の上で紹介させて頂きたく思います。\n\nよろしくお願い致します。", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@hinarisum/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": f