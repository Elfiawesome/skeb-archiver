uploads/origins/0cc2b793-5156-4052-9ecc-04fe57cfb9b6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9681327207c07e76b2ba1262dc174a7a", "srcset": "https://si.imgix.net/fd6dce4e/uploads/origins/0cc2b793-5156-4052-9ecc-04fe57cfb9b6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9681327207c07e76b2ba1262dc174a7a, https://si.imgix.net/fd6dce4e/uploads/origins/0cc2b793-5156-4052-9ecc-04fe57cfb9b6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=8467cec8b3ce39ed9a718b228dba3544 2x, https://si.imgix.net/fd6dce4e/uploads/origins/0cc2b793-5156-4052-9ecc-04fe57cfb9b6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c299cd7bfe8586c495c2123951c06bc7 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/fd6dce4e/uploads/origins/0cc2b793-5156-4052-9ecc-04fe57cfb9b6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a96874dc5eac4b3e9223ac55e4b5abae", "srcset": "https://si.imgix.net/fd6dce4e/uploads/origins/0cc2b793-5156-4052-9ecc-04fe57cfb9b6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a96874dc5eac4b3e9223ac55e4b5abae, https://si.imgix.net/fd6dce4e/uploads/origins/0cc2b793-5156-4052-9ecc-04fe57cfb9b6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=21c3061d9136298733660c669877fc2e 2x, https://si.imgix.net/fd6dce4e/uploads/origins/0cc2b793-5156-4052-9ecc-04fe57cfb9b6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=3d47bd55aec447e2218d6bbdd53c7326 3x"}, "body": "よち様、初めまして！\n創作のアカウントの方も拝見させて頂いております。絵柄の雰囲気が好みでとっても大好きです…！\n\nお忙しいとは思いますが、自創作の幼馴染カップルを描いてほしいと思い依頼させて頂きました。\n\n2人が仲良くラブラブしているような1枚絵を描いていただけたらと思います。\nそれ以外はおまかせします！\n\n〈キャラクター説明〉\nダーク→黒髪黒目の男の子。16歳程度。基本的にクールで素っ気なく怖いと思われがち。他の人といる時は余り笑わないが、ミルーアと2人きりでいる時はよく笑うしミルーアをよく抱きしめたりほぼ常にくっついている。\n\nミルーア→紫髪紫目の女の子。15歳程度(誕生日が早生まれなだけでダークとは同級生です)。天然でふわふわした雰囲気。誰にでも明るい。ダークにはどこでも抱きついたりして甘えてる。\n\nスマホの壁紙等に使わせていただきたいので出来れば縦長の絵にして頂けると嬉しいです。\n宛名は有りと無しがあるとありがたいです！\n\n資料は2人の立ち絵とイラスト(ミルーアのみですみません…こっちの方が帽子とか見やすいかなと思い…服はぬいぐるみに隠れてて申し訳ないです)になってます。\n\nhttps://www.dropbox.com/sh/a7ewz8g35km80gt/AAC1npJU1-zBd1z8pIGMNoUia?dl=0", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@00snt00/works/8", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1323181, "client_id": 936274, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/03fa3a17/uploads/origins/1c6fcec6-c97b-473c-be33-8adbcc0aa341?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e644c26d2ed0b0d0ad78cccca53347ed", "srcset": "https://si.imgix.net/03fa3a17/uploads/origins/1c6fcec6-c97b-473c-be33-8adbcc0aa341?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e644c26d2ed0b0d0ad78cccca53347ed, https://si.imgix.net/03fa3a17/uploads/origins/1c6fcec6-c97b-473c-be33-8adbcc0aa341?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ac7918acd16f3ee1db5fbc4fc1a0be37 2x, https://si.imgix.net/03fa3a17/uploads/origins/1c6fcec6-c97b-473c-be33-8adbcc0aa341?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=85065d16663a6d240141c69ab723e2cf 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/03fa3a17/uploads/origins/1c6fcec6-c97b-473c-be33-8adbcc0aa341?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=7039b6d75faed99bb7dc14773abde6f8", "srcset": "https://si.imgix.net/03fa3a17/uploads/origins/1c6fcec6-c97b-473c-be33-8adbcc0aa341?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=7039b6d75faed99bb7dc14773abde6f8, https://si.imgix.net/03fa3a17/uploads/origins/1c6fcec6-c97b-473c-be33-8adbcc0aa341?bg=%23fff&auto=format%2Ccompres