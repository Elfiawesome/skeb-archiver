n３人は全裸ですがそれぞれメイのサンバイザー、セレナのサングラス付きの帽子、ショウの頭に着けている巾着は被ったまま\n\n陰毛は３人とも生え揃っている状態でお願いします\n\n\nご検討の程よろしくお願いいたします", "nc": 160, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@letusgomaki/works/14", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2377257, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/dc199aac/uploads/origins/0871f324-2c25-4641-ba38-99b56afe0864?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=308b514648a5a33f39497b377b3da544", "srcset": "https://si.imgix.net/dc199aac/uploads/origins/0871f324-2c25-4641-ba38-99b56afe0864?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=308b514648a5a33f39497b377b3da544, https://si.imgix.net/dc199aac/uploads/origins/0871f324-2c25-4641-ba38-99b56afe0864?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=8fd0f8b4644f2da2b43d5473e6214723 2x, https://si.imgix.net/dc199aac/uploads/origins/0871f324-2c25-4641-ba38-99b56afe0864?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=094de0f4f73d5d97b3d35f61f9473338 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/dc199aac/uploads/origins/0871f324-2c25-4641-ba38-99b56afe0864?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=99a6b2f55a90c459a2c97c211a009743", "srcset": "https://si.imgix.net/dc199aac/uploads/origins/0871f324-2c25-4641-ba38-99b56afe0864?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=99a6b2f55a90c459a2c97c211a009743, https://si.imgix.net/dc199aac/uploads/origins/0871f324-2c25-4641-ba38-99b56afe0864?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=cc0c054575e273463e6e16963a37dff0 2x, https://si.imgix.net/dc199aac/uploads/origins/0871f324-2c25-4641-ba38-99b56afe0864?bg=%23fff&auto=