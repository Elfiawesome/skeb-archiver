n性格：明るい、優しい\n髪型：短髪以外の髪型で\n服装：カジュアル\nポーズ：動きがあるというよりは落ち着いた感じで\n背景：縁側、河川敷、昼のマンションなど何か明る目の場所\nその他：マイクやヘッドフォンなど配信の要素を1つどこかに入れてください\n\n5/18日にtwitterで投稿されていたイラストのペンを持ってる子がドンピシャのイメージです！\n\n髪色や服装はお任せします！\n\n上のイメージは、もし変えた方がいい感じになるんでしたらどんどん変えてもらっても大丈夫です！\n------------------------------------------------------------\n\nお忙しいとは思いますが、ご検討いただけますと嬉しいです。どうぞよろしくお願いいたします。", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 16028, "creator": true, "nsfw_acceptable": false, "acceptable": false, "name": "のりた", "screen_name": "morittam", "avatar_url": "https://pbs.twimg.com/profile_images/1705065378022617088/EHeqTlul.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1941533977/1468344435/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 120, "skills": [{"genre": "art"}], "banned": false, "nc": 128}, {"id": 1057632, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "07", "screen_name": "sobakonattou07", "avatar_url": "https://pbs.twimg.com/profile_images/1844812683226619904/4AKjeuiK.jpg", "header_url": "https://pbs.twimg.com/profile_banners/2552540090/1728678149/1500x500", "appeal_receivable": true, "popular_creator_rank": 18, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "art"}], "banned": false, "nc": 176}, {"id": 2129953, "creator": true, "nsfw_acceptable": false, "acceptable": false, "name": "sakosan", "screen_name": "sakosan", "avatar_url": "https://pbs.twimg.com/profile_images/1527158962314833920/4bdlQSk7.jpg", "header_url": null, "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "de