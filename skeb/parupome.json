a1cfec0-1615-45ed-b279-826bc7782adb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b820aaddeae98120c6154108312ee1e4", "src_set": ""}, "body": "こんにちは。\nいつもTwitterとpixivで拝見しています。\n\n今回初めて依頼したいのが最推しのFE暁の女神の\nネフェニー(兜なし)を水着姿でお願いします。\n\nシチュエーションは\nヘザーから絶対に似合うからと渡された水着が思ってた以上に際どくて恥ずかしがるネフェニーをお願いします。\n\nご検討してもし承認していただけたらどうかよろしくお願いします。\n\n\n※\n風花雪月以外のFEはキャラプロフィールが無いので個人的なネフェニーのキャライメージは\n\n絶対に長身巨乳美人だと思うので\n\n身長175cmで胸がリンディスと同じくらい(\n推定Gカップ)位だと思っています。", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@parupome/works/8", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 910260, "client_id": 906729, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/57a1cdc0/uploads/origins/78b24a72-36e5-40bc-a043-4fa39338d389?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8764a7c46fedad4eecb656c18ca7900e", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/57a1cdc0/uploads/origins/78b24a72-36e5-40bc-a043-4fa39338d389?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b19e68e95c8a5bb6ab74ba9e39257973", "src_set": ""}, "body": "風花雪月のメルセデスビキニイラストフロントバージョンをお願いしたいです(^^)\nビキニはアプリ版の物で顔は無双バージョンを使用して下さい(^_^ゞ\n楽しみに待っています♪", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@parupome/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 910260, "client_id": 1854804, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/056d56d2/uploads/origins/2079890d-88e2-483c-8fa2-bba643fc040b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c21cd99223d849d3f8d3a90bd1b91357", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src