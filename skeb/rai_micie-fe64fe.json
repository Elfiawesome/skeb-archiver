い）、体も幼女のまま。最後リリックちゃんは微小な希望もない、永遠強くなれない弱い獣人に存在固定する。大体こんな感じです\n細かい点はご自由にどうぞ、ありがとうございます。", "nc": 168, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@rai_micie/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 69033, "client_id": 386071, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/28830d1a/uploads/origins/460f5b48-bd23-4e1c-8964-3f6bb4a8b1c0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5640ba2db581da7361a070e637f5d8c4", "srcset": "https://si.imgix.net/28830d1a/uploads/origins/460f5b48-bd23-4e1c-8964-3f6bb4a8b1c0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5640ba2db581da7361a070e637f5d8c4, https://si.imgix.net/28830d1a/uploads/origins/460f5b48-bd23-4e1c-8964-3f6bb4a8b1c0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=41ba2d87f6e239b87f32e058ff977112 2x, https://si.imgix.net/28830d1a/uploads/origins/460f5b48-bd23-4e1c-8964-3f6bb4a8b1c0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=bb917caa7e1e02ecf0512e124dbceaa9 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/28830d1a/uploads/origins/460f5b48-bd23-4e1c-8964-3f6bb4a8b1c0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=4cd72291a7b2c8656a1c694d515fefc1", "srcset": "https://si.imgix.net/28830d1a/uploads/origins/460f5b48-bd23-4e1c-8964-3f6bb4a8b1c0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=4cd72291a7b2c8656a1c694d515fefc1, https://si.imgix.net/28830d1a/uploads/origins/460f5b48-bd23-4e1c-8964-3f6bb4a8b1c0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=da88ca1da498086f3e127ab810499737 2x, https://si.imgix.net/28830d1a/uploads/origins/460f5b48-bd23-4e1c-8964-3f6bb4a8b1c0?bg=%23fff&auto=format%