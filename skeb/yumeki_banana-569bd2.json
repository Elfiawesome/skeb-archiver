s=b41fd691b245a03c3bea17afc4a4c010 2x, https://si.imgix.net/f57a47b1/uploads/origins/50248f3c-c829-49b9-9cf1-cb29a50f10c5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=372a468ca6b72ba1e8260d05b3f6b43c 3x"}, "body": "先生の作品の「あなたが望むなら」「妻の痴態」に出てくる佳織さん似の女性が不倫相手に授乳手コキプレイをしているイラストをお願いします。衣装は「妻の痴態」で佳織さんが着ていたエロメイドでお願いします。詳細は竿役は女性の片乳を揉みながら赤ちゃんのようにおっぱいを吸っている。女性は母のような優しい笑みを浮かべ頭を撫でつつ手コキをしてくれる。また、妊娠したわけでもないのに母乳がちょっと出てしまっている）と言う感じです。射精前後の差分とセリフと擬音もお願いします。細かい要望ですが婚約指輪が見えるようお願いします。詳しい内容はお任せしますが内容的には「女性の夫婦関係は既に破綻している」「竿役はダメ人間だが性格はいい」「女性はそんなダメ人間を自分が何とか支えてあげなきゃいけない。面倒見てあげないといけない。」と母性と使命感のような愛情を見出してしまっている。これらを参考にしていただければ幸いです。冒頭にも書きましたがあくまで佳織さん似の女性です。よろしくお願いします。", "nc": 32, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@yumeki_banana/works/14", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 263485, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/71cdc991/uploads/origins/fbfdb498-d9dc-49ad-9c58-fe54fda5452c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=08f765162f3539ab6e19c7bae336efc5", "srcset": "https://si.imgix.net/71cdc991/uploads/origins/fbfdb498-d9dc-49ad-9c58-fe54fda5452c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=08f765162f3539ab6e19c7bae336efc5, https://si.imgix.net/71cdc991/uploads/origins/fbfdb498-d9dc-49ad-9c58-fe54fda5452c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=fe24b5f80ad71687a3d11693e76b1c69 2x, https://si.imgix.net/71cdc991/uploads/origins/fbfdb498-d9dc-49ad-9c58-fe54fda5452c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=928d1737bf02524f4c0d5cb54b0a02ed 3x"}, "duration": null, "nsfw": true, "hardcore": true, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/71cdc991/uploads/origins/fbfdb498-d9dc-49ad-9c58-fe54fda5452c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&cro