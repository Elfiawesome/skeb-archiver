7797_1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=ee552c4307731a8bb90250e6621e152a 3x"}, "body": "Twitter拝見しました！\nドスケベチアガールを依頼した者です、その節は大変失礼を……。\n改めて、差分の方を依頼させて頂きますね。\n先生の描かれるヒップアタック、是非見たいので・・・！\n金額はこれで足りるのかちょっと不安ですが……\nもしご不満なら遠慮なく断ってしまってください。\n\n一応、内容を再掲します。\n\n（前略）\n\nまた、よろしければ、差分にヒップアタックしているものをお願いできないでしょうか。\nおちんちんにトドメのヒップアタック、たまらず射精してしまいます。\nおしりを後ろに突きだすヒップアタックで、\n竿役は柔らかい尻肉に包まれて射精してしまう・・・というイメージで、\n是非ともお願いします。\n\nセリフ\n「ぷぅ！❤」「あんっ❤出てる出てる❤」「おしり、柔らかかった？❤んもぉ、エッチ❤」\n効果音\n「ぱっふぅう～～～ん❤❤」（ヒップアタックの音）\n「ビュルル！❤ビュク！❤ビュ～～～～❤❤」（射精音）", "nc": 48, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@yumeki_banana/works/8", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 263485, "client_id": 65900, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/22bc6e90/requests/67430_6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=42463d351062e62d8e8b755c5c9c5dbd", "srcset": "https://si.imgix.net/22bc6e90/requests/67430_6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=42463d351062e62d8e8b755c5c9c5dbd, https://si.imgix.net/22bc6e90/requests/67430_6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=8dd95d2d27dacd55758c69d7c3c08f12 2x, https://si.imgix.net/22bc6e90/requests/67430_6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e776b5a12516ae4f095def77db6e4244 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/22bc6e90/requests/67430_6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=45b4f9c0a5c8a7324f512e7241f51524", "srcset": "https://si.imgix.net/22bc6e90/requests/67430_6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=45b4f9c0a5c8a7324f512e7241f51524, https://si.imgix.net/22bc6e90/requests/67430_6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=c63a86176206e1fa4c98cfe86d5c0628 2x, https://si.imgix.net/22bc6e90/requests/67430_6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=ba8c3d6d3091c8304cc1a3e8f3ff3d98 3x"}, "body": "エッチなポニーテールチアガールの、エッチな応援というシチュをお願いします。\n\nパンツ丸出しの巨尻をぷりんぷりん振っているチアガールでお願いします。\n目の前にはギンッギンに勃起したちんぽがあって、\n既にこのチアガールの応援によって勃起してしまっています。\n（竿役はこのちんぽだけでいいです）\n\nチアガールは黒髪ポニテの、ドスケベな感じでお願いします。\n出来れば資料URLの左側の子みたいな感じに・・・\n\n衣装について、おしり(パンツ)が一切隠れないような、\n意味を成してないような短さのスカートにしてください。\nパンツの色は純白にしてください。\n\n真ん中におしりの実体、右と左におしりの残像を描いて欲しいです。\nおしりや股から、汗と愛液が飛び散り、\n尻肉が揺れてぷりんぷりん震えている感じも出してもらえればうれしいです！\n手は腰に当てて、脚を閉じた状態でおしりを振っているものを。\n女の子は全身でなく、描画範囲はふとももまでで、\n画面の半分ほどをおしりで埋め尽くす感じでお願いします。\nおしりは肉感たっぷりに、かなりのムチムチっぷりで。\n\n超ドスケベな、誘惑する感じの表情で。\n具体的には、ハート目で、「ﾆﾀｧ…❤」とした表情。\n口は「う」の形にすぼめさせ、「ぷぅ❤ぷぅ❤」と言ってる感じを。\n\nセリフ\n「ぱんつぷぅ！❤」「ぱんつぷぅ！❤」「ぱんつぷ～ぅぷぅ！❤」\n効果音\n「ぷりん！❤」「ぷりん！❤」「むちっ！❤」「むちっ！❤」\n（おしりのムチムチ音）\n\n\nまた、よろしければ、差分にヒップアタックしているものをお願いできないでしょうか。\nおちんちんにトドメのヒップアタック、たまらず射精してしまいます。\nおしりを後ろに突きだすヒップアタックで、\n竿役は柔らかい尻肉に包まれて射精してしまう・・・というイメージで、\n是非ともお願いします。\n\nセリフ\n「ぷぅ！❤」「あんっ❤出てる出てる❤」「おしり、柔らかかった？❤んもぉ、エッチ❤」\n効果音\n「ぱっふぅう～～～ん❤❤」（ヒップアタックの音）\n「ビュルル！❤ビュク！❤ビュ～～～～❤❤」（射精音）\n\nhttps://skeb.jp/works/54338", "nc": 49, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@yumeki_banana/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 263485, "client_id": 264212, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/ae8e7e9e/requests/54338_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9448e3d4602bda31e0a1297d01716ad9", "srcset": "https://si.imgix.net/ae8e7e9e/requests/54338_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9448e3d4602bda31e0a1297d01716ad9, https://si.imgix.net/ae8e7e9e/requests/54338_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=to