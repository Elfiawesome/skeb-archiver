-8659-2894f2f01602?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=0045ff041798079692a9874eb6faba56 2x, https://si.imgix.net/7c5ff28d/uploads/origins/bdb67419-6626-4263-8659-2894f2f01602?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=526b24eda793886295de4937bed0439c 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/7c5ff28d/uploads/origins/bdb67419-6626-4263-8659-2894f2f01602?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e1672ef7d482ddda9f3be4e1d24c3710", "srcset": "https://si.imgix.net/7c5ff28d/uploads/origins/bdb67419-6626-4263-8659-2894f2f01602?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e1672ef7d482ddda9f3be4e1d24c3710, https://si.imgix.net/7c5ff28d/uploads/origins/bdb67419-6626-4263-8659-2894f2f01602?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=7b340d71ba7d37ad0e076fdae8337fe9 2x, https://si.imgix.net/7c5ff28d/uploads/origins/bdb67419-6626-4263-8659-2894f2f01602?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=e909f4215e7504db5f64e32a2cc452a9 3x"}, "body": "こんにちは。\n先日は素敵なイラストを手掛けていただき誠にありがとうございました。\n\n可能であればまたイラストをお描きいただきたく、リクエストをお送りいたします。\n今回お描きいただきたいのは、『Cult of the Lamb』の待ち受けし者、アイム、バアルの三体で、可能であればデザイン違いの二組でお描きいただけたら大変嬉しいです。\n\nなお、このリクエストは一枚目のみの希望です。\n二枚まとめてリクエストしたら納期がえらいこっちゃになりそうなので分けています。\n二枚目のリクエスト金額も本件と同額にてお願いする想定です。\n\nいずれ対になる構図がわかった方が良いと思い、二枚まとめて構図を書いています。\nとはいえ、このリクエストでは一枚目をお描きいただきたい旨、お含みおきいただけますと幸いです。\n\n=== === ===\n【一枚目】\n◆構図\n待ち受けし者の前にやってきたアイムとバアルをお願いします。\n正面やや遠めに、大きく待ち構える待ち受けし者に対して二匹で手をつなぎながら見上げるアイムとバアルの背中をお願いできたら嬉しいです。\n\n待ち受けし者はアイムとバアルを見下ろし、二匹の価値を見定めているような感じだと嬉しいです。\n\nアイムとバアルのデフォルメについては、以前お描きになっていたイラストの一番右にてお願いいたします。\nhttps://x.com/2_3up/status/2045272181870076120?s=20\n\nアイムとバアルの服装は以前お描きになっていたような衣装で、Tシャツはそれぞれ白黒だととても嬉しいです。\nhttps://x.com/2_3up/status/2034510730599469143?s=20\n\n【二枚目】 ※一枚目をご納品後に依頼する予定です。あくまでこのタイミングではご参考までに…！\n待ち受けし者の手前に立ち、待ち受けし者の使者としてこちらに向かって立ちはだかるアイムとバアルをお願いします。\n\n待ち受けし者は１枚目と同じポーズでも問題ございません。\nただ、表情は作中で子羊と相対している時同様、不敵に笑っていたらとても嬉しいです。\n\nアイムとバアルは成長した姿（もとい中ボスとして戦う姿）でお願いいたします。\n等身のデフォルメは以前お描きになっていたイラストの一番左くらいだととても嬉しいです。\nhttps://x.com/2_3up/status/2026785006816047208?s=20\n\n武器も持っていたらめちゃくちゃ嬉しいですが、作画大変だと思うのでご無理なさらずにて…。\n=== === ===\n\nなお、細かい指定なんか知らねぇ！おれは好きなように描くぜ！みたいなときはそれでも大丈夫です。\nその際は二枚目の依頼の際、それに合わせたリクエストを考えます。\n\n長々と失礼しました。\nご検討のほど、何卒よろしくお願いいたします。", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@2_3up/works/14", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3964900, "client_id": 1115441, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/38839809/uploads/origins/c110b413-345f-42fb-9a56-6b77f2624588?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4a307fba575776d1ef16a9da740c98b8", "srcset": "https://si.imgix.net/38839809/uploads/origins/c110b413-345f-42fb-9a56-6b77f2624588?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4a307fba575776d1ef16a9da740c98b8, https://si.imgix.net/38839809/uploads/origins/c110b413-345f-42fb-9a56-6b77f2624588?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=659d43f5627098adedfe94cc479eda8b 2x, https://si.imgix.net/38839809/uploads/origins/c110b413-345f-42fb-9a56-6b77f2624588?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=180c7ca054be3deb7dbbd76f04e7fdaa 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/38839809/uploads/origins/c110b413-345f-42fb-9a56-6b77f2624588?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=955d55add7260b27d3af3c05ffc62410", "srcset": "https://si.imgix.net/38839809/uploads/origins/c110b413-345f-42fb-9a56-6b77f2624588?bg