b5b1a8a0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=224aa8b75a822033a4575eb5a5876be4", "srcset": "https://si.imgix.net/a79cc86f/uploads/origins/d731a094-5e89-40e1-a680-9c12b5b1a8a0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=224aa8b75a822033a4575eb5a5876be4, https://si.imgix.net/a79cc86f/uploads/origins/d731a094-5e89-40e1-a680-9c12b5b1a8a0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=f0c0f43811cbe672db13ba84581c338d 2x, https://si.imgix.net/a79cc86f/uploads/origins/d731a094-5e89-40e1-a680-9c12b5b1a8a0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=3de24187c90ecd2805f4d9a63899a61e 3x"}, "body": "初めまして！宵雨様の作品を拝見させて頂きぜひクトゥルフ神話TRPGのうちの子を依頼させていただきたくリクエストさせていただきました！\n\n雛瀬 杏梨（ひなせ あんり）\n25歳／158cm／女性\n怪異事件を扱う組織所属の刑事\n\n穏やかで柔らかな物腰をしており、感情的になることは少ない。\nしかし判断は冷静かつ的確で、必要な場面では迷わず行動できる人物。\n戦闘・支援どちらもそつなくこなす。\n\n人の感情の機微を読むことに長けており、優しさを大切にしている。\n大切な相手には深い情を向けるタイプ。\n外見イメージ\n暖色系の柔らかな雰囲気\nイメージカラー：#ff8a4f\n植物や花が似合う印象\n清潔感のある服装\n可愛いものが好きそうな柔らかさ\n\nモチーフ：\n杏の花／春／植物／ぬいぐるみ\n\n性格\n優しく穏やか\n柔らかな敬語\n面倒見が良い\n感情表現は控えめ\n静かな芯の強さがある\n「優しさを選べる人」\n少し世話焼き\n自陣や仲間への情が深い\n\nイメージとしては、\n「春の日差しのような柔らかさ」と「静かな覚悟」が同居している感じです。\n描写イメージ\n優しく微笑む表情\n少し困ったような柔らかい顔\n仲間を見る時だけ少し感情が出る\n戦闘時は静かに真剣\n\nセリフイメージ\n「大丈夫です。ここにいますから。」\n「……ここで止めます。これ以上は、見過ごせません。」\n「あまり、無茶はしないでください。」\n「雛瀬杏梨です。怪事庁に所属しています。」\n\n希望のイラスト\n構図はおまかせします。\n服装も難しければおまかせします。\n\n使用用途\nSNSアイコン・ヘッダー・サムネ・壁紙（非営利／個人利用）、個人間でのグッズ化（アクスタ・アクキー等）。\n\n難しければお気軽にキャンセルしていただいて問題ありません。\n\nhttps://drive.google.com/drive/folders/1Vpv3t44TLbXRMMFD5ruLCUGg7qSLJNHK?usp=drive_link", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@SousakuAme072/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3980587, "client_id": 3748783, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/23d1059c/uploads/origins/7b478f6c-bb51-48c1-9c37-71a32b7382cb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=aed01bf57e7af06ac394f7bc03103c19", "srcset": "https://si.imgix.net/23d1059c/uploads/origins/7b478f6c-bb51-48c1-9c37-71a32b7382cb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=aed01bf57e7af06ac394f7bc03103c19, https://si.imgix.net/23d1059c/uploads/origins/7b478f6c-bb51-48c1-9c37-71a32b7382cb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=72cfe27d507be93e2046fa5bfa0f8bc0 2x, https://si.imgix.net/23d1059c/uploads/origins/7b478f6c-bb51-48c1-9c37-71a32b7382cb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=0751a2f678e3a3e740e89dd8f763168c 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/23d1059c/uploads/origins/7b478f6c-bb51-48c1-9c37-71a32b7382cb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a89524798cbad19bc64bee71a3228db6", "srcset": "https://si.imgix.net/23d1059c/uploads/origins/7b478f6c-bb51-48c1-9c37-71a32b7382cb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a89524798cbad19bc64bee71a3228db6, https://si.imgix.net/23d1059c/uploads/origins/7b478f6c-bb51-48c1-9c37-71a32b7382cb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=a05fe04b51fb52a64f762f36a5ca32a7 2x, https://si.imgix.net/23d1059c/uploads/origins/7b478f6c-bb51-48c1-9c37-71a32b7382cb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=e2705148a012d8b389729d348546cd7e 3x"}, "body": "お疲れ様です。\n\n今回、クトゥルフ神話TRPGのシナリオ「エンジェル‎・デビル‎・インプロパー」のHO悪魔の弊自探索者であり、過去に創作企画で参加した際に製作した「ショコラ‎・リリィ」のキャライラストをお願いしたく依頼させていただきます。\n\n​───────\n\n‎・使用用途\nSNSのアイコンに使用したいと思っております。また、それに伴う友人間での共有(みてみて)をしたいです。\n\n‎・構図など\n特に指定はありません。以下のキャラ説明から、‎宵雨さんの感じ取られたイメージで簡易Skebをお願いしたいです。\n\n​───────\n\n‎・モチーフ\n黒百合、黒い炎\n\n‎・性格/特徴\n墓守の家系に生まれた子。\n人と会話するのにあまり慣れていなく、ルールなどに厳格なため真面目な面が目立つが、根は人と話すのが好きで感情豊かな優しい子。\n色々と周りに振り回されがちで、あわあわとしてたりすることもある。\n生まれつき視力が人より数倍強く、その影響で目を使い過ぎたり日差しを受けると目/頭が痛くなってしまうために、普段傘を常備している。\n手に持つ短い棒から先述の傘や、武器(大鎌や剣、槍など自由)などを生み出す/変形させることが出来る。\n大型の武器を扱うことが多いからか、力がかなり強い(TRPG用語でわかりやすく言うなら、STRが16あります)。\n\n以下は本編TRPGシナリオとは無関係ですが、元創作企画の設定では、\n【生まれつき視力が他より非常に優れているが、代わりに翼を持たない悪魔で、幼い頃に自分の領地を歩いている時、死にかけている目がない小竜を見つけ、「あなたに世界を見るための目をあげる代わりに、私が空を飛ぶための翼になって」という契約を行い、一緒に育った黒い竜の相棒がいる】\nというものがありました。\n片目がない設定もそちらが理由のものです(自分の片目を分けたため)。\n\n​───────\n\nいつも綺麗なイラストをありがとうございます。\nどうぞよろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/1vRuwnBcYnk86POuP9cofXi-inJcGovPI", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@SousakuAme072/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3980587, "client_id": 238384, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/bad09b99/uploads/origins/bf97ecda-2a92-4c9c-9c80-9a6ed6e30b10?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=38481bd51acbe89dd1be216308576288", "srcset": "https://si.imgix.net/bad09b99/uploads/origins/bf97ecda-2a92-4c9c-9c80-9a6ed6e30b10?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=38481bd51acbe89dd1be216308576288, https://si.imgix.net/bad09b99/uploads/origins/bf97ecda-2a92-4c9c-9c80-9a6ed6e30b10?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=cfb722fc9c143a2fa3e8ba823e8a489c 2x, https://si.imgix.net/bad09b99/uploads/origins/bf97ecda-2a92-4c9c-9c80-9a6ed6e30b10?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a78799970a689fbf970b35c323e1bd6d 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/bad09b99/uploads/origins/bf97ecda-2a92-4c9c-9c80-9a6ed6e30b10?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b125bfc0fe8