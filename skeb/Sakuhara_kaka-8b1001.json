-b764-cc9b6c0d4577?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=1dc0a4f449661954a9e22512135ac1fe 2x, https://si.imgix.net/bc5ded77/uploads/origins/9e683806-49c3-4470-b764-cc9b6c0d4577?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=e5bc0a8b3b96a1dd1cfb6989bed4c8fc 3x"}, "body": "こんにちは～！古明地姉妹のイラストをお願いしたいのですが。姉妹で階段に座っている姿も見てみたいです。さとりは、一段高く、こいしの後ろに座っているはずです。さとりは後ろからこいしを抱きしめているはずです。こいしの両手は、さとりの手の上に置いてください。こいしは首を後ろに傾けて、さとり（こいしは帽子をかぶっていない）のほうを見ているはずです。こいしは、やわらかく微笑んでいるはずです。さとりはこいしを真下から見ているはずです。さとりも柔らかく微笑んでいるはずです。彼らの衣装はいつものものであるべきです。それ以上の詳細は、あなた次第です。", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Sakuhara_kaka/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1906891, "client_id": 27685, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/98fd99d9/uploads/origins/2a357b83-f880-4644-b630-d1b252b9db85?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=adcbdd6f2ff33e0c3b02ff2e39ea2563", "srcset": "https://si.imgix.net/98fd99d9/uploads/origins/2a357b83-f880-4644-b630-d1b252b9db85?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=adcbdd6f2ff33e0c3b02ff2e39ea2563, https://si.imgix.net/98fd99d9/uploads/origins/2a357b83-f880-4644-b630-d1b252b9db85?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=5ad2fd2411cb5dcd1727e2916f90d8ab 2x, https://si.imgix.net/98fd99d9/uploads/origins/2a357b83-f880-4644-b630-d1b252b9db85?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=aede57ba4fdea17b7448969585cc5964 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/98fd99d9/uploads/origins/2a357b83-f880-4644-b630-d1b252b9db85?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=383143e