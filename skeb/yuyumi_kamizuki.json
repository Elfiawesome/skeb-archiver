を元にこちらで描き起こしたイラストを使用させて頂きます。\n※描いて頂いたデザインを一部アレンジさせて頂く場合があります。\n※SNSなどでの初公開時には霞三月様のお名前を記載し、霞三月様のイラスト自体に金銭が発生するような使用(グッズ化など)はしない事をお約束します。\n\n\n以上になります。お目を通して頂きありがとうございました。\nご検討頂ければ幸いです。\n\nhttps://x.com/papermoon_game/status/2016823404046012691", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 2110419, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "𝐧𝐢𝐤𝐮", "screen_name": "nikudnk_trpg", "avatar_url": "https://pbs.twimg.com/profile_images/2003066462941159424/GEkswfwC.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1455530479357206530/1752076061/1500x500", "appeal_receivable": true, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 90, "skills": [{"genre": "art"}], "nc": 128}, {"id": 2780641, "creator": true, "nsfw_acceptable": false, "acceptable": false, "name": "Ʒりぽっぷ🍭", "screen_name": "poyopoyoppu", "avatar_url": "https://pbs.twimg.com/profile_images/1696326752690429952/PmPDFHyU.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1599026046208049153/1743415321/1500x500", "appeal_receivable": true, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 120, "skills": [{"genre": "art"}], "nc": 32}, {"id": 3077802, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "あけの あめ🫧お仕事募集中", "screen_name": "4ken___o", "avatar_url": "https://pbs.twimg.com/profile_images/2017906632714571776/MKaaCs9S.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1712800080716279808/1764378677/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by":