format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a7441af5048e77450b4e1f7d1cef8384, https://si.imgix.net/b4050da7/uploads/origins/de6de726-ec0b-4ec4-9e6e-f9d48d83129a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=86f19b92c9e895f7e139aad7fffe55bf 2x, https://si.imgix.net/b4050da7/uploads/origins/de6de726-ec0b-4ec4-9e6e-f9d48d83129a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=024d7dcb1182789d9cb5574213644f21 3x"}, "body": "Twitter（現：X)で再始動宣言をいただきましたので、リクエストを送らせていただきます。\n\nキャラはFGOのカーマちゃん（第2再臨）\nいつものように藤丸を誘惑してからかっていたら、不意打ちの壁ドンをされてしまい顔を真っ赤にしてそれ以上何も言えず、「ひょっとして私、わからせられちゃいます？」とテンパってしまっている、というようなシチュで。\nなお、藤丸も意図的な壁ドンではなく、振り向いたらバランスを崩したとかそんな感じです。\n\nカーマの衣装は水着、アサシン衣装どちらでもみすとさんにお任せしたいと思います。\nよろしくお願いします。", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@mistnmist/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2593318, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/8f61e499/uploads/origins/8f0c7fff-2d82-44e8-b53f-47328c5f4667?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=cdf8f9c7d103cd3f6dfba9d76b63b7a2", "srcset": "https://si.imgix.net/8f61e499/uploads/origins/8f0c7fff-2d82-44e8-b53f-47328c5f4667?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=cdf8f9c7d103cd3f6dfba9d76b63b7a2, https://si.imgix.net/8f61e499/uploads/origins/8f0c7fff-2d82-44e8-b53f-47328c5f4667?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=5681db56005bc4ec5682c14dbdf0c92f 2x, https://si.imgix.net/8f61e499/uploads/origins/8f0c7fff-2d82-44e8-b53f-47328c5f4667?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=16b8cfa8a008bd98226c45508b7d250e 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/8f61e499/uploads/origins/8f0c7fff-2d82-44e8-b53f-47328c5f4667?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a163209876beb3239913fb6dd7244fe6", "srcset": "https://si.imgix.net/8f61e499/uploads/origins/8f0c7fff-2d82-44e8-b53f-47328c5f4667?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a163209876beb3239913fb6dd7244fe6, https://si.imgix.net/8f61e499/uploads/origins/8f0c7fff-2d82-44e8-b53f-47328c5f4667?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=37963fbe62564b28903acfa992e9eb68 2x, https://si.imgix.net/8f61e499/uploads/origins/8f0c7fff-2d82-44e8-b53f-47328c5f4667?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=4804e9fdd5a68c9e7893a44529bbe1c5 3x"}, "body": "現在手数料無料キャンペーンということで、予定を前倒しでリクエストをさせていただきます。\n\n今回お願いしたいのは、個人VTuberとして活動されている宮秋まどかさんのバニー衣装の立ち姿イラストになります。\nアネス先生が主催する奥行きなき医師団に所属されているICU看護師配信者さんです。\n\n昨年末の配信中の流れで、あまりセクシー過ぎなければいいよというお話をもらいましたのでこの機会にリクエストをさせていただきます。\n通常のバニー衣装ですと胸元や足元など露出が多くなりますので、今回は俗にいう燕尾バニー衣装にスカート付きでお願いしたいと思います。\nポーズについては、片手をあげているよく見る「いらっしゃいませ」のポーズ（？）でお願いします。\n\n作品については、後ほどまどかさんへお渡しすることを想定しています。\n\nご検討のほどよろしくお願いします。", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@mistnmist/works/6", "private_thumbnail_image_urls": {"src": "https://skeb-avatar.imgix.net/https%3A%2F%2Fproxy.misskeyusercontent.jp%2Favatar.webp%3Furl%3Dhttps%253A%252F%252Fmedia.misskeyusercontent.jp%252Fio%252F4be56d1a-ad44-44aa-ae49-6d7e36e08b27.png%26avatar%3D1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=cb36d30cf15442cab6a1b9dcb19b1786", "srcset": "https://skeb-avatar.imgix.net/https%3A%2F%2Fproxy.misskeyusercontent.jp%2Favatar.webp%3Furl%3Dhttps%253A%252F%252Fmedia.misskeyusercontent.jp%252Fio%252F4be56d1a-ad44-44aa-ae49-6d7e36e08b27.png%26avatar%3D1?bg=%23fff&au