f&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=01083ea2c18cecac0996c3f05a584e06", "srcset": "https://si.imgix.net/f0f28da7/uploads/origins/1ebfd8e0-71ea-4b5b-850f-8e1d48d4110b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=01083ea2c18cecac0996c3f05a584e06, https://si.imgix.net/f0f28da7/uploads/origins/1ebfd8e0-71ea-4b5b-850f-8e1d48d4110b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=72781deb5fff41d74d7db7bea6562e8a 2x, https://si.imgix.net/f0f28da7/uploads/origins/1ebfd8e0-71ea-4b5b-850f-8e1d48d4110b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=334e375198b9b3d936ac4846eb148d31 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/f0f28da7/uploads/origins/1ebfd8e0-71ea-4b5b-850f-8e1d48d4110b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=60d3befa409a3a0a68024581c3f92ee2", "srcset": "https://si.imgix.net/f0f28da7/uploads/origins/1ebfd8e0-71ea-4b5b-850f-8e1d48d4110b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=60d3befa409a3a0a68024581c3f92ee2, https://si.imgix.net/f0f28da7/uploads/origins/1ebfd8e0-71ea-4b5b-850f-8e1d48d4110b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=5a1b110deb11ca24c704677e0aa0a0eb 2x, https://si.imgix.net/f0f28da7/uploads/origins/1ebfd8e0-71ea-4b5b-850f-8e1d48d4110b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=511f6cb7c0f9fec533b82f091d016759 3x"}, "body": "リクエスト失礼します！\nるじゅ先生の幻想的でコントラストの効いた絵柄に惹かれ、ご依頼させていただきたいと思います。\n\nSTELLA GLOW（ステラグロウ）というゲームに登場するキャラ、ヒルダを描いて頂きたいです。\n\n\nhttps://drive.google.com/drive/folders/147Gy79I-uQppIT4PyOZn3rpZx26U29Gy?usp=sharing\n\nhttps://stellaglow.sega.jp/chara/witch_05/\n\n\n能力：時を操る魔女\n武器：鎌（デフォルトでは虹色の水晶が生えた鎌）\n年齢 :千歳以上（肉体の時間を止めている） \n性格:クール、ミステリアス。若干厨二病気味で、自分の魔女っぽいイメージを保とうとするやや残念属性も持っている。\