origins/90b88b9c-23c2-4969-a2aa-6a2870843e81?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fa2126eae7a5f95c29093f7980f5b2b0, https://si.imgix.net/19238c98/uploads/origins/90b88b9c-23c2-4969-a2aa-6a2870843e81?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=4ac03e5384a8626b821521b41f148dc3 2x, https://si.imgix.net/19238c98/uploads/origins/90b88b9c-23c2-4969-a2aa-6a2870843e81?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=36194a002c336fe5c58c6adedb388e76 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/19238c98/uploads/origins/90b88b9c-23c2-4969-a2aa-6a2870843e81?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=70d098f808d3b8adc7b415ca72cc1e74", "srcset": "https://si.imgix.net/19238c98/uploads/origins/90b88b9c-23c2-4969-a2aa-6a2870843e81?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=70d098f808d3b8adc7b415ca72cc1e74, https://si.imgix.net/19238c98/uploads/origins/90b88b9c-23c2-4969-a2aa-6a2870843e81?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=ade9d4524f5e6e1197a6e35c2e3d85ea 2x, https://si.imgix.net/19238c98/uploads/origins/90b88b9c-23c2-4969-a2aa-6a2870843e81?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=5c7243c0ee094163c2b4b80ea2a84cbc 3x"}, "body": "yagine様\n\nこんばんは、yagine様。\nツイッターからイラストを拝見させて頂いてファンになったものです。\nバクシンオーと色んなウマ娘達の個性の表現、そしてかっこよさと可愛さが描かれてることに惚れちゃいました！特に、表情での表現が最高です！！\nそんなyagine様がスケブを開いていらっしゃることを知り、もしよろしければこちらのオリキャラのことを依頼したいです。\n\nお願い申し上げたいのはこちらのオリキャラ狐娘の万里香（まりか）という子です。\n狐耳と尻尾・赤メガネ・アホ毛、そしてちょっぴりツリ目な目つきが特徴的な、160cmくらいの身長の子です。\n本とか、動物や花、星空のような自然をぼーっと見るのが大好きな子です。\n性格的には、ちょっと人見知りで照れ屋ですので人前では余計にクールっぷりしてるけどまた寂しがり屋のちょっと面倒くさい感じです。一人の時や知り合いの前では表情が緩めてちょっと豊かになる感じです。\nこれだけではちょっと説明が足りないと思いますので設定と設定画など、ご参考できそうなものを下のURLにまとめております。\n\nこの娘でyagine様の絵柄でのイラストをどうかお願いしたいです。\n衣装は設定画のうちの一つで、食べ物を前にしてうっかり笑顔になってしまう姿がみたいです。どうでしょうか？ご検討くださいませ！\n\nお忙しい中、要件のみで申し訳ありません。\n応援しております！\n\nhttps://drive.google.com/drive/folders/1kVcp6B8dzGYFGpFb9spMTyDnz0TzyM7Q?usp=sharing", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@trainchicken/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 835171, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/d28837e2/uploads/origins/5960d6eb-3cd9-4507-b7a7-78738e3fe80c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a3378590e61689a4efddedf0c196b6c5", "srcset": "https://si.imgix.net/d28837e2/uploads/origins/5960d6eb-3cd9-4507-b7a7-78738e3fe80c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a3378590e61689a4efddedf0c196b6c5, https://si.imgix.net/d28837e2/uploads/origins/5960d6eb-3cd9-4507-b7a7-78738e3fe80c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ef5469bd5bee7a5cf5a418e637d17dde 2x, https://si.imgix.net/d28837e2/uploads/origins/5960d6eb-3cd9-4507-b7a7-78738e3fe80c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=fc55164bbb849f87df2b00e0c12bf069 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/d28837e2/uploads/origins/5960d6eb-3cd9-4507-b7a7-78738e3fe80c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=8231d7153f0882af56eb8a594121fca8", "srcset": "https://si.imgix.net/d28837e2/uploads/origins/5960d6eb-3cd9-4507-b7a7-78738e3fe80c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=8231d7153f0882af56eb8a594121fca8, https://si.imgix.net/d28837e2/uploads/origins/5960d6eb-3cd9-4507-b7a7-78738e3fe80c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=9c126338764e329b2572763dcb236b81 2x, https://si.imgix.net/