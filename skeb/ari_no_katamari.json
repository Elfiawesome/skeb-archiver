ress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=799fc8a6428e69d1f87a342f74445e45 3x"}, "body": "愛すべきヨスさんへ\n先日はAlice is main.を一緒に回ってくれてありがとうございます。本当に本当に楽しすぎて...ずっと思い出してはニヤニヤしています。\n\nさて今回は三月うさぎの1枚絵を依頼したいと思いリクエストを送らせて頂きました。\n以下に要素を連ねるのでご参考までにお読み下さい。\n\n○シチュエーション\nお茶会をしているシーンが良いです。本編に出てきたお菓子が画面内に入ってると嬉しい。他の同卓PC達（いもむし、チェシャ猫、帽子屋）と楽しく戯れてて欲しい。ですが作画コストとか色々アレなので描くのが大変であれは画面内に入れる必要は無いです。雰囲気あればOK！\n\n・時間帯とか場所とか\nあの世界に朝とか夜とかあるのか分からないんですけど、場所は薄暗い森の中のお茶会会場で背景は暗めの色使いが良いです。木の枝とかテーブルの上とかにランタンがあってそれが光源となって顔とかが見えてて欲しい。怪しい雰囲気が欲しい。\n\n○その他\n自由に描いて頂いて構いません！構図の指定も画像の縦横比の指定もありません！なんなら上記のリクエストをガン無視しても構いません。とにかく三月ウサギが見たいんです。好きすぎるんです。自陣大好きなんです。三月ウサギ、髪型が好きなんです。長めで横に流れてる所とか最高すぎる。目も好き。瞳孔が黒くて大きい所とか、瞳の端に若干オレンジ色が入ってるのとかめっちゃ好きなんです。左耳に切れ込みが入ってるのとか安全ピン着いてるのとかデザイン天才だし、服も好みすぎる。\nどんなイラストが来てもめそめそになって喜ぶのでどうかよろしくお願いします🙏\n\nありんこ🐜🐜より", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}], "similar_creators": [{"id": 852565, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "ぐじゃ太🍼", "screen_name": "NrU6c", "avatar_url": "https://pbs.twimg.com/profile_images/1611751118153093120/vq6gsoGB.jpg", "header_url": "https://pbs.twimg.com/profile_banners/775633948697202688/1680187723/1500x500", "appeal_receivable": true, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 100, "skills": [{"genre": "art"}], "nc": 49}, {"id": 1671227, "creator": true, "nsfw_acceptable": false, "acceptable": false, "name": "ᙏ̤̫🌈返信遅", "screen_name": "niziiro_trpg", "avatar_url": "https://pbs.twimg.com/profile_images/1742064339069308928/NInm31DI.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1432684544847585280/1732593372/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 