to=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a96afe74fc6b7e4432b4a666690fd523, https://si.imgix.net/abeb5784/uploads/origins/e58187cf-caaf-4e4d-ba7b-5c82178ae387?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=1b6bb4df90ade24a131d2bfeb8919e83 2x, https://si.imgix.net/abeb5784/uploads/origins/e58187cf-caaf-4e4d-ba7b-5c82178ae387?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=1785b8df834f915a74ba3b356b22193f 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/abeb5784/uploads/origins/e58187cf-caaf-4e4d-ba7b-5c82178ae387?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=352465cecad010190e0b8078c1bd4587", "srcset": "https://si.imgix.net/abeb5784/uploads/origins/e58187cf-caaf-4e4d-ba7b-5c82178ae387?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=352465cecad010190e0b8078c1bd4587, https://si.imgix.net/abeb5784/uploads/origins/e58187cf-caaf-4e4d-ba7b-5c82178ae387?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=5d7619aff65a988db89186fa07d2709a 2x, https://si.imgix.net/abeb5784/uploads/origins/e58187cf-caaf-4e4d-ba7b-5c82178ae387?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=20b8014131b25b1dae096bcf3db730e2 3x"}, "body": "大秦国王安敦先生はじめまして、牛の王子さまでち＠８６ｋと申します。\n以前から先生の描かれる漫画のファンでコミックスも買わせてもらっております。\nこの度、先生がskebを受け付けていらっしゃると知り、これはぜひ私の推しでも描いていただかねば！と思ってのリクエストです。\n恐らくは先生がご存じないであろうキャラクターで恐縮ですが、リクエストをお受けいただけたら幸いです。\n\n【作品】フラワーナイトガール\n【キャラクター】ハツユキソウ（花騎士）\n【参考】通常衣装（進化前）\nhttps://i.imgur.com/b2FNAPo.png\n正面首元はこちらになります\nhttps://i.imgur.com/HWi038U.png\n※キャラクターの体型、髪型は以下の方がわかりやすいと存じます\nクリスマス衣装進化後\nhttps://i.imgur.com/ketEKFQ.png\n腰まである白髪ストレートロングでやや小ぶりのおっぱいに大きめのお尻の子です。\n下は無毛でおねがいします。\n\n【シチュエーション】\n団長さん(竿役の主人公です)に睡眠いたずらえっちをされているハツユキソウを描いてください、お願いいたします。\n\n具体的な要望は以下の通りです\n・衣装につきましてはこの（https://skeb.jp/@scarfy_chang/works/14）ような感じで大胆にはだけさせてくださって結構です\n・導入等は不要で、えっちシーンを重点的に描いてください\n・キャラクター性の不要な簡単な喘ぎ声と擬音のみの構成でお願いします\n※寝言で主人公を呼ぶ場合は「団長さん」でお願いします\n・フィニッシュは中出し後におまんこから精液が溢れるアップでお願いします\n・開脚や股間が良く見えるシーンがあると嬉しいです\n\n以上が私の要望ですが、わかりにくい点や難しい点等ございましたら先生のやりやすいようにアレンジしていただいて構いません。\nよろしくお願いいたします。\n\nhttps://xn--eckq7fg8cygsa1a1je.xn--wiki-4i9hs14f.com/index.php?%E3%83%8F%E3%83%84%E3%83%A6%E3%82%AD%E3%82%BD%E3%82%A6", "nc": 41, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@taisinkoku/works/10", "private_thumbnail_image_urls": null, "private": false, "genre": "comic", "tipped": true, "creator_id": 2569479, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/d7ba2428/uploads/origins/5f06b267-e922-4026-a4bc-b960d6043be3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bc9c2997117b225a33ba02aacc31d290", "srcset": "https://si.imgix.net/d7ba2428/uploads/origins/5f06b267-e922-4026-a4bc-b960d6043be3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bc9c2997117b225a33ba02aacc31d290, https://si.imgix.net/d7ba2428/uploads/origins/5f06b267-e922-4026-a4bc-b960d6043be3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=3c8203687a8002ae7b575664337e5223 2x, https://si.imgix.net/d7ba2428/uploads/origins/5f06b267-e922-4026-a4bc-b960d6043be3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=81ba1d527a2f527a6f4b2742ff08c631 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/d7ba2428/uploads/origins/5f06b267-e922-4026-a4bc-b960d6043be3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=18c52b092e28cddf3ac8c5b444a3bc74", "srcset": "https://si.imgix.net/d7ba2428/uploads/origins/5f06b267-e922-4026-a4bc-b960d6043be3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=18c52b092e28cddf3ac8c5b444a3bc74, https://si.imgix.net/d7ba2428/uploads/origins/5f06b267-e922-4026-a4bc-b960d6043be3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=4207385d99f7ab3e43ff706820117649 2x, https://si.imgix.net/d7ba2428/uploads/origins/5f06b267-e922-4026-a4bc-b960d6043be3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=04773efc2c53f9e4e6c480bfb719c236 3x"}, "body": "こんにちは！前回のリクエストの漫画版をお願いしたいです。\nhttps://skeb.jp/@taisinkoku/works/2\n\n妹たちのパンツを嫌々履かされた兄は、妹たちとレスリングごっこをしています。妹たちも兄も女の子のパンツしか履いていません。パンツのデザインは前回と同じで、シンプルな無地の柄に小さなリボンが付いています。兄のパンツも妹たちのパンツも同じデザインです。前回同様、妹のパンツが小さいため、兄の性器が丸見えです。\n\nもちろん、兄ははるかに力持ちで、少しの力で妹たちを力ずくで圧倒することができます。しかし、髪の短い妹が兄の後ろに回り込み、背後から睾丸を蹴り、瞬時に兄を倒します。そして、地面にしがみついて地面にしがみつく兄を、妹たちはからかいます。\n\n皆様の素敵なメスガキ表現を期待しています！ありがとうございます！", "nc": 184, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@taisinkoku/works/9", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/5d25b3ac/uploads/origins/5c824787-03c8-4962-a27c-ea3dbd83031b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=40d87f866e46f12a02c77567e47e902b", "srcset": "https://si.imgix.net/5d25b3ac/uploads/origins/5c824787-03c8-4962-a27c-ea3dbd83031b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=40d87f866e46f12a02c77567e47e902b, https://si.imgix.net/5d25b3ac/uploads/origins/5c824787-03c8-4962-a27c-ea3dbd83031b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=36813919cb6d93b0d8f7a81b73ce454a 2x, https://si.imgix.net/5d25b3ac/uploads/origins/5c824787-03c8-4962-a27c-ea3dbd83031b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=29d94e0591fc9c619cee3f0ad0ec9433 3x"}, "private": true, "genre": "comic", "tipped": false, "creator_id": 2569479, "nc": 49}, {"path": "/@taisinkoku/works/8", "private_thumbnail_image_urls": null, "private": false, "genre": "comic", "tipped": true, "creator_id": 2569479, "client_id": 1913383, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/ec5ce993/uploads/origins/dbd6ccc8-9255-46e4-8684-faf82e9e5684?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=be206f9de5bc592d49741ef5cbdcb075", "srcset": "https://si.imgix.net/ec5ce993/uploads/origins/dbd6ccc8-9255-46e4-8684-faf82e9e5684?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=be206f9de5bc592d49741ef5cbdcb075, https://si.imgix.net/ec5ce993/uploads/origins/dbd6ccc8-9255-46e4-8684-faf82e9e5684?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=7887fa29907fde8fe29d78d812c6a659 2x, https://si.imgix.net/ec5ce993/uploads/origins/dbd6ccc8-9255-46e4-8684-faf82e9e5684?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c459f27099f4539cdef400cfefe06107 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/ec5ce993/uploads/origins/dbd6ccc8-9255-46e4-8684-faf82e9e5684?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=934b516282773861c9981e078573ec0a", "srcset": "https://si.imgix.net/ec5ce993/uploads/origins/dbd6ccc8-9255-46e4-8684-faf82e9e5684?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=934b516282773861c9981e078573ec0a, https://si.imgix.net/ec5ce993/uploads/origins/dbd6ccc8-9255-46e4-8684-faf82e9e5684?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=c8ac9bc6c81e4354f404fac161d10e4e 2x, https://si.imgix.net/ec5ce993/uploads/origins/dbd6ccc8-9255-46e4-8684-faf82e9e5684?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=0bb05216a7cde0c03fc81a23763b7c8d 3x"}, "body": "※前回依頼時よりおまかせ金額が変更されておりましたので、金額調整して再度お送りさせて頂いております\n\n大秦国王先生こんにちは。以前納品されてました\n伊澄さんが痴漢されている漫画がドツボにぶっ刺さっております。\n\nよければアリスギアアイギスというゲームより、\n相河愛花ちゃんという少女がおじさん（伊澄さんの漫画のような少し太目な体型）に\n人気のないところで身体をお触りされたり悪戯される漫画をお願いできませんでしょうか。\n\n▼キャラ：相河愛花\nhttps://i.imgur.com/9Opsgeh.png\n\n※参考画像下部のように太ももやお尻が意外に健康的な少女なので、\n　お尻や太腿が目立つシーンがあると嬉しく思います）\n\n委細はお任せしたいのですが、未来ちゃんの本番は描かず最後に事後なイラストで終わってる構成が\nその間の出来事が色々想像できて本当に素晴らしい内容でしたので、\nできれば本番描写は入れる直前位までで最後に事後っぽい感じの締めですと嬉しいです。\n\n内容細かく恐縮ですが、何卒ご検討の程よろしくお願い致します。", "nc": 184, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@taisinkoku/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "comic", "tipped": false, "creator_id": 2569479, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/2b5d05f6/uploads/origins/e62cdb58-efb9-4c42-b6ce-56d03e9d9918?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d0443192ed71d2ba82b8bc54b772c17d", "srcset": "https://si.imgix.net/2b5d05f6/uploads/origins/e62cdb58-efb9-4c42-b6ce-56d03e9d9918?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d0443192ed71d2ba82b8bc54b772c17d, https://si.imgix.net/2b5d05f6/uploads/origins/e62cdb58-efb9-4c42-b6ce-56d03e9d9918?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=983bff5e1cf9274830e89bc747af2a13 2x, https://si.imgix.net/2b5d05f6/uploads/origins/e62cdb58-efb9-4c42-b6ce-56d03e9d9918?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d7c65af90552c92c339e0c573a1ebb68 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/2b5d05f6/uploads/origins/e62cdb58-efb9-4c42-b6ce-56d03e9d9918?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f5b08d337fa4dbd409c7f1440650d44f", "srcset": "https://si.imgix.net/2b5d05f6/uploads/origins/e62cdb58-efb9-4c42-b6ce-56d03e9d9918?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f5b08d337fa4dbd409c7f1440650d44f, https://si.imgix.net/2b5d05f6/uploads/origins/e62cdb58-efb9-4c42-b6ce-56d03e9d9918?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=d65187ec0ab09d492f9befdc5c354210 2x, https://si.imgix.net/2b5d05f6/uploads/origins/e62cdb58-efb9-4c42-b6ce-56d03e9d9918?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=99797d3b8526ef90f3b6580350106796 3x"}, "body": "初めまして、描かれる女の子が可愛くて気に入りました。良ければリクエストしたいです。\n可能であれば、ドールズフロントラインのG11をお願い致します。  \n参考 : https://wikiwiki.jp/dolls-fl/Gr%20G11 \n胸控えめで少し小柄な子です。下は無毛でお願いします。\n頭の帽子も何も無しの銀髪のみで、上インナー下パンツか、あるいは全裸でお願いします。\n簡単な喘ぎセリフと擬音の有り・無しをお願いします。\n\n色々な体位で行うセックスで中出しで終わる漫画を描いて欲しいです。\nねちゃねちゃの愛液が糸引く描写や、開脚や股間が良く見えるシーンがあると嬉しいです。\nめちゃくちゃ発汗し、涙流して激しく感じて余裕がない表情でお願いします。\n\n良ければご検討下さい。", "nc": 160, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@taisinkoku/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "comic", "tipped": true, "creator_id": 2569479, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/8556eb4e/uploads/origins/d0c7bed2-a875-4e46-ab8b-1db8ef4c8ae7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=64645f3ef5f16444b3741453a879c546", "srcset": "https://si.imgix.net/8556eb4e/uploads/origins/d0c7bed2-a875-4e46-ab8b-1db8ef4c8ae7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=64645f3ef5f16444b3741453a879c546, https://si.imgix.net/8556eb4e/uploads/origins/d0c7bed2-a875-4e46-ab8b-1db8ef4c8ae7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=5d238f0278dfc9a78fdb306eaad2b061 2x, https://si.imgix.net/8556eb4e/uploads/origins/d0c7bed2-a875-4e46-ab8b-1db8ef4c8ae7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=0b6e2f575de46330f5c49e6db2470d47 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/8556eb4e/uploads/origins/d0c7bed2-a875-4e46-ab8b-1db8ef4c8ae7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c9be610a8e4cc9cbc75f590d76621b5d", "srcset": "https://si.imgix.net/8556eb4e/uploads/origins/d0c7bed2-a875-4e46-ab8b-1db8ef4c8ae7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c9be610a8e4cc9cbc75f590d76621b5d, https://si.imgix.net/8556eb4e/uploads/origins/d0c7bed2-a875-4e46-ab8b-1db8ef4c8ae7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=32bad2a8ad026373b2936a06d1ac3907 2x, https://si.imgix.net/8556eb4e/uploads/origins/d0c7bed2-a875-4e46-ab8b-1db8ef4c8ae7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=af3882e6bccc21ceaacea452c4da9c23 3x"}, "body": "貴方様のとてもえっちで素晴らしいモノクロのコミックをお見かけして来ました。\n知らないキャラかと思いますが、SCHOOLMATEという漫画の藍川未来というキャラを依頼させて頂きます。\nコミック1巻4話で未来が輩に絡まれて裸に剥かれかけすんでのとこで助かるシーンがあるのですが、助けが入らずそのまま裸に剥かれて興奮した男たちに犯されそうになるifを描いて欲しいです。\n（コミック一巻URL：https://bookwalker.jp/de36094b41-b614-48a2-9478-64bccdba2144/\n依頼金の端数はコミック代のつもりです）\n一点、襲う男は原作ではヤンキーみたいな連中ですが、未来ガチファンのロリコンキモオタのデブに変えてもらいたいです。興奮したキモオタたちに両手を後ろで縛られ、体を触られたり、見せ槍されて怯えたり、すじに擦りつけられ処女喪失直前というシーンを描いてもらいたいです。\n男は顔などは無しでシルエットのような適当な感じでも大丈夫です。\nもし受けてもらえたらとても嬉しいです。", "nc": 40, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@taisinkoku/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "comic", "tipped": false, "creator_id": 2569479, "client_id": 403792, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/c76386bf/uploads/origins/da4c4ad7-ab08-44f6-bc35-5ca36886ff17?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=57df7e782c0ca06ac1748ef551081430", "srcset": "https://si.imgix.net/c7