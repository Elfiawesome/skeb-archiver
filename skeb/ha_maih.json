=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=f2130d11361b3946d8825f132c88c902", "src_set": ""}, "private": true, "genre": "art", "tipped": false, "creator_id": 2260338, "client_id": 0, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 17, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@ha_maih/works/22", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2260338, "client_id": 2792903, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/f1ba93c2/uploads/origins/6ba91ab2-bf8d-4db4-9e27-a60fbf5939dc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7463fea5cbae04a8ccc9a14e5ea25e89", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/f1ba93c2/uploads/origins/6ba91ab2-bf8d-4db4-9e27-a60fbf5939dc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=8f0404fa45431674e24e79f050645337", "src_set": ""}, "body": "こんにちは、アピールありがとうございます！遊戯王のマイ・バレンタインを自信に満ちた美しいポーズで描いてほしいです。センスの良い作品にしつつ、とても好ましい特徴を持った舞をお願いします。\n\nhttps://skeb.jp/@kisi0024/works/137\n\nhttps://skeb.jp/@ozucat/works/112\n\nhttps://skeb.jp/@umagaobanana/works/5\n\nhttps://www.pixiv.net/en/artworks/123924149\n\n彼女の衣装はバトルシティのユニフォームでも構いません。コルセットは白に紫の紐でお願いします！\nよろしくお願いします。", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@ha_maih/works/21", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2260338, "client_id": 3277624, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/bc2ca40f/uploads/origins/fc6cfccc-a57a-4da4-b372-9f670eba8118?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&