uto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=5fad78c8a7b6f752471c52d010cab4c7 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/7262b51f/uploads/origins/0b8ca986-ac0e-46cd-bedd-34dc279bcc4a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d4f95c879d127f7a84327980ed474ce5", "srcset": "https://si.imgix.net/7262b51f/uploads/origins/0b8ca986-ac0e-46cd-bedd-34dc279bcc4a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d4f95c879d127f7a84327980ed474ce5, https://si.imgix.net/7262b51f/uploads/origins/0b8ca986-ac0e-46cd-bedd-34dc279bcc4a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=73c89eb5dfc5226cd168cce9a187ae56 2x, https://si.imgix.net/7262b51f/uploads/origins/0b8ca986-ac0e-46cd-bedd-34dc279bcc4a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=315362efbb29319348541656c755a922 3x"}, "body": "リクエスト失礼します。 \nキャラは音吹奏。パワ体ではなくリア体で巨乳でお願いします。 \nシチュエーションは海で白いマイクロビキニを着ており、その上に鳴響高校のジャージを羽織っておりジャージはチャックを閉めておらず全開。\nこちらに身体を見せつけているようなキャラ単体のイラストをお願いします。", "nc": 32, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@akira_myo/works/13", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1295383, "client_id": 1695922, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/6f88f69f/uploads/origins/5463c213-d097-4ed2-a469-b719a99335b4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a266431a300fe8acc3ca778a2f90ad14", "srcset": "https://si.imgix.net/6f88f69f/uploads/origins/5463c213-d097-4ed2-a469-b719a99335b4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a266431a300fe8acc3ca778a2f90ad14, https://si.imgix.net/6f88f69f/uploads/origins/5463c213-d097-4ed2-a469-b719a99335b4?bg=%23fff&auto=format%2Ccompres