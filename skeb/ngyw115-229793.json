1-a030-14553b49f52c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=5f5d7edf8c52ecd0b1e29bbe887ef595 2x, https://si.imgix.net/233b13bf/uploads/origins/09363a7a-cf84-4301-a030-14553b49f52c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=9188a73aedabb5ae3cda389ff50fcce2 3x"}, "body": "初めまして、禰画手文さんの絵柄に惹かれ依頼させて頂きました。\n 以下が内容となります。  \n\nキャラクター:プルメリア（ゴシックは魔法乙女）\n\n体・資料1の日焼けで、少し胸を盛ってください。\n\n衣装・資料1のビキニでお願いします。\n\nシチュエーション\nナンパされ、事前で黒い巨根を見せつけられる。\n目を丸くし、乳首が立ち、股が濡れ、少し恐怖入り混じる興奮。\n胸が高まり「こんなものを入れられたら…」みたいな感じでお願いします。\n\n可能であれば以下の差分が欲しいです\n事後で使用済みゴムが複数ビキニにくくりつけられ、快楽落ち。\n竿無しのプルメリア単体。\n\n以上となります。\nご存じないキャラクターとは思いますが、よろしければご承認のほどお願い致します。\n\n資料１  \nhttps://gomaotsu.jp/archives/characters/2901\n資料2　\nhttps://gomaotsu.jp/archives/characters/32\n資料3\nhttps://gomaotsu.jp/archives/characters/534\n資料4\nhttps://gomaotsu.jp/archives/characters/2133\n資料5 絞り込みでプルメリア\nhttps://gomaotsu.jp/index_character?otome%255B0%255D=%E3%83%97%E3%83%AB%E3%83%A1%E3%83%AA%E3%82%A2&otome_sub%255B0%255D=%E3%83%97%E3%83%AB%E3%83%A1%E3%83%AA%E3%82%A2&otome_sub%255B1%255D&otome_sub%255B2%255D&otome_sub%255B3%255D&radioSortmethod=character_id&radioOrder=desc&paged=1", "nc": 48, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@ngyw115/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 4024780, "client_id": 2231946, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/580ca14b/uploads/origins/85a88676-a399-4c96-abfe-508fe09fff92?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fcdd5a354143985c843e7bc6bcf927f3", "srcset": "https://si.imgix.net/580ca14b/uploads/origins/85a88676-a399-4c96-abfe-508fe09fff92?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fcdd5a354143985c843e7bc6bcf927f3, https://si.imgix.net/580ca14b/uploads/origins/85a88676-a399-4c96-abfe-508fe09fff92?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f6796fea80b2f67bea6ae7eca16e2556 2x, https://si.imgix.net/580ca14b/uploads/origins/85a88676-a399-4c96-abfe-508fe09fff92?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=92fb813c7730a6e14273e168639ddf1d 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/580ca14b/uploads/origins/85a88676-a399-4c96-abfe-508fe09fff92?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b0ba0875073081f92e75de14033f8268", "srcset": "https://si.imgix.net/580ca14b/uploads/origins/85a88676-a399-4c96-abfe-508fe09fff92?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b0ba0875073081f92e75de14033f8268, https://si.imgix.net/580ca14b/uploads/origins/85a88676-a399-4c96-abfe-508fe09fff92?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=00052985adfbc54a96a945987800951b 2x, https://si.imgix.net/580ca14b/uploads/origins/85a88676-a399-4c96-abfe-508fe09fff92?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=ef88d150a511fd4ded82fdb0e0afce2d 3x"}, "body": "はじめまして、新着クリエイター一覧から過去作品に惹かれてきました\nもしよろしければリクエストを受けていただけないでしょうか\nサービス終了したネットゲームのマイキャラクターがモデルのうちの子になります\nお淑やかな性格でむっつりスケベ、胸は控えめのスレンダーな子で、お尻が性感帯です\n\n・希望する内容を箇条書きで\n「依頼衣装」と付いたファイルでお好みの衣装を着せてあげてください\n（もしくは「その他衣装」から飛べるフォルダの中にお好みの衣装があれば、そちらを着せてあげてください）\n犬耳を着け、尻尾付プラグをお尻に挿入した状態（付け根のプラグが見えないような、尻尾だけお尻から伸びているような形状）\n恋人とのいちゃらぶセックス、または尻尾は無しでアナルセックス、その他オナニー、アナルオナニー、誘惑する様子…等々お好みのシチュエーションで\n犬になりきりながらorお尻で気持ちよさそうにしているイメージ\nとろとろで気持ちよさそうな表情\n相手の描写は無くても構いません\n胸の大きさは控えめ（Bカップ程度～つるぺたまでお好みで）\n服装は着衣～半脱ぎくらいでお願いします\n顔が見える内容で、その他構図などは描きたいものでお任せします\n\nご検討をお願いいたします\n\nhttps://drive.google.com/drive/folders/1gXZVDfcsl66QZ8VxPLKFXERqQXKioNsJ", "nc": 32, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@ngyw115/works/1", "private_thumbnail