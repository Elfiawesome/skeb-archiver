fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=63bdbd4dd9f8dd67d2a6586df5d29862", "src_set": ""}, "body": "プリコネのコッコロちゃんをお願いしたいです。\n衣装や構図等はお任せします。", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@AoichanChokomin/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1828202, "client_id": 1250371, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/6a41267c/uploads/origins/9ef5fe96-f191-4220-b282-e3aefdbad679?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=da2629215ee811c241cf7c1760e4d4d0", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/6a41267c/uploads/origins/9ef5fe96-f191-4220-b282-e3aefdbad679?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=8ab3cbe7a3e222cf2db9404685f8e6f5", "src_set": ""}, "body": "ちょこみん先生、前回はうちの子のリクエストを描いて頂きありがとうございます。\nまたうちの子では有りますが、ちょこみん先生に再度描いて欲しくリクエストいたします。\n\n再掲ですがうちの子の資料は下記のツイートの通りです\nhttps://twitter.com/littlenight_sh/status/1414542351125471232\nキャラ詳細\n・黒髪ロングストレート\n・緑かかった黒い瞳\n・胸部は薄目\n・中高生くらいのイメージ\n資料からの追加事項で・銀色の狐耳・尻尾をお願いいたします。\n性格は明るく素直純真元気な甘えたがりな子となります\n\n服装のリクエストとして\n・競泳水着(色は白を基調に青系のライン)\n・髪の毛は泳ぐのに邪魔にならないよう結ってください\n・可能であればアイス(味(色)はお任せ)を持たせてください\n・シチュエーションとしては、海やプール等からあがって、水がしたたっている状態で休憩でアイスを頂いて居る、そんなイメージでお願いいたします\n\nポーズ・構図についてはちょこみん先生にお任せいたします。\nご検討のほどよろしくお願いいたします。\n\nhttps://twitter.com/littlenight_sh/status/1414542351125471232", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@AoichanChokomin/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1828202, "client_id": 1250371, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/7b69d158/uploads/origins/a2b59685-e4c9-4597-bc50-c4b3099fe5a0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&