応コスプレがメインなので、なるべく衣装姿を拝める全身絵で描いてくだされば非常にありがたいです。\nまた、なぎこちゃんは第一再臨の髪（青・赤・黒のマーブルのやつ）を希望ですが、もっとセンスを光らせる神託が下りてくださったのならその限りではないです！\nそれ以上の表情や構図・ポーズなどについては、桜居さんのセンスをそのまま光らせて頂ければOKです！　おまかせでも極上の物ができあがる信頼感……！\n元々表情豊かななぎこちゃんを、抜群の表情力を描かれる桜居さんのお手前で爆誕するのをとても期待しております！\n\n無茶な注文とは存じますが、何卒よろしくお願いいたします！\n\nhttps://www.pixiv.net/artworks/88419852", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@Halsak/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 400006, "client_id": 173648, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/69fd7b76/uploads/origins/ba6d5c90-5c15-4509-a324-05a6ce42e32b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b9ee5b7b84806ed360195c74c64e8564", "srcset": "https://si.imgix.net/69fd7b76/uploads/origins/ba6d5c90-5c15-4509-a324-05a6ce42e32b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b9ee5b7b84806ed360195c74c64e8564, https://si.imgix.net/69fd7b76/uploads/origins/ba6d5c90-5c15-4509-a324-05a6ce42e32b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=56bf2fb4fa067826a3c8df8f010bf579 2x, https://si.imgix.net/69fd7b76/uploads/origins/ba6d5c90-5c15-4509-a324-05a6ce42e32b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=fb6a8ba4939e2333746f2f28fabdbe3f 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/69fd7b76/uploads/origins/ba6d5c90-5c15-4509-a324-05a6ce42e32b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3285a8ab8b99dfa1cb12c26b330e176f", "srcset": "https://si.imgix.net/69fd7b76/uploads/origins/ba6d5c90-5c15-4509-a324-05a6ce42e32b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3285a8ab8b99dfa1cb12c26b330e176f, https://si.imgix.net/69fd7b76/uploads/origins/ba6d5c90-5c15-4509-a324-05a