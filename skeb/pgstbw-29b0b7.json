おはようVtuber画像など）   \n\n収益化を含むYouTubeでのサムネイル、配信内での画面配置、歌ってみた動画など\n\n  【その他】  \n\n個人で依頼する形になりますが、私は所属する団体があり、個人勢Vtuberではありません。\n\nご検討のほどよろしくお願いします。\n\nhttps://drive.google.com/file/d/1JdGZdbsXWa3YzfzQ2yvHHHKOUOqOh49x/view?usp=drivesdk\n\nhttps://drive.google.com/file/d/1JdGZdbsXWa3YzfzQ2yvHHHKOUOqOh49x/view?usp=drivesdk", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@pgstbw/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3955698, "client_id": 3886996, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/572d98e5/uploads/origins/6ef0c764-3594-4d58-a196-1668eb63290f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2a2e3d3f6d810aa35ecc25dbeb07e0fe", "srcset": "https://si.imgix.net/572d98e5/uploads/origins/6ef0c764-3594-4d58-a196-1668eb63290f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2a2e3d3f6d810aa35ecc25dbeb07e0fe, https://si.imgix.net/572d98e5/uploads/origins/6ef0c764-3594-4d58-a196-1668eb63290f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=2bdc930b82e1903d6185b8a75168c523 2x, https://si.imgix.net/572d98e5/uploads/origins/6ef0c764-3594-4d58-a196-1668eb63290f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=050e72cdd1189a15a49c887658955461 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/572d98e5/uploads/origins/6ef0c764-3594-4d58-a196-1668eb63290f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=dbd206852f633ec3049bd9f85ec09a3f", "srcset": "https://si.imgix.net/572d98e5/uploads/origins/6ef0c764-3594-4d58-a196-1668eb63290f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=dbd206852f633ec3049bd9f85ec09a3f, https://si.imgix.net/572d98e5/uploads/origins/6ef0c764-3594-4d58-a196-1668eb632