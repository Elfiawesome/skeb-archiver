%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c8a971c452fc4fdf7e32928192741b25", "srcset": "https://si.imgix.net/1e3b6c1d/uploads/origins/33fd98d7-bac4-4493-8157-aa89f2f65baf?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c8a971c452fc4fdf7e32928192741b25, https://si.imgix.net/1e3b6c1d/uploads/origins/33fd98d7-bac4-4493-8157-aa89f2f65baf?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=2c9f873a477bee6408f2791dc586ec78 2x, https://si.imgix.net/1e3b6c1d/uploads/origins/33fd98d7-bac4-4493-8157-aa89f2f65baf?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=4e8944c84a130b7e40d90300825614ea 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/1e3b6c1d/uploads/origins/33fd98d7-bac4-4493-8157-aa89f2f65baf?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9d04bf677ce9f3e2d32abc8fa32230e1", "srcset": "https://si.imgix.net/1e3b6c1d/uploads/origins/33fd98d7-bac4-4493-8157-aa89f2f65baf?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9d04bf677ce9f3e2d32abc8fa32230e1, https://si.imgix.net/1e3b6c1d/uploads/origins/33fd98d7-bac4-4493-8157-aa89f2f65baf?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=3247fb09a334548058a0c730168bc6dc 2x, https://si.imgix.net/1e3b6c1d/uploads/origins/33fd98d7-bac4-4493-8157-aa89f2f65baf?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=1309a1826213bef141de814e64afd135 3x"}, "body": "はじめまして\nXにて黒豆らくとぅー様の描かれたイラスト\n特に肉感的な体つきと塗りの表現に強い魅力を感じ依頼させて頂きました。\n\n自分のオリジナルキャラクターを、胸と特に乳輪を出来る限り巨大なサイズで、陵辱されているようなイラストに描いて頂けませんでしょうか。\n\n<<イラストの内容>>\n自分より背丈の小さい子供に人ではなく性処理用の家畜として扱われ、人並より巨大で敏感な両胸(乳輪)を徹底的に責め抜かれ、激しく陵辱されながら胸や尻に手の跡が残るぐらい叩かれ愛撫され、羞恥と嫌悪に頬を赤く染め涙を流し表情を歪めながらも襲い来る快楽に抗えず何度も繰り返し絶頂させられる一部始終\n\nその他の細かい要素はおまかせします\n敗北陵辱や胸責めが好きで、キャラクターが酷い目に合っていればいる程、エロければエロい程嬉しいので、黒豆らくとぅー様の裁量で遠慮なくエロく描いて下さい。\n\n<<備考>>\n・胸と特に乳輪はふっくらした形で大きければ大きいほど嬉しいです、資料よりも大きければ嬉しいので限界まで大きく描いて下さい\n・顔は特徴が合っていれば似ている程度で構いませんので、黒豆らくとぅー様の絵柄で描いて頂けると嬉しいです。\n・胸のビキニは半脱ぎにしてください\n\nもし募集の意図にそぐわない･条件が合わないなど、\n何か問題があるようでしたら遠慮なくキャンセルして頂いて構いません\n\nよろしくお願い致します\n\nhttps://drive.google.com/drive/folders/1n4YxwneaVfcClcTUF1-YGk9Ti1rN0TaY?usp=sharing", "nc": 184, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@BaconRakuTuu/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3426179, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/228e27d2/uploads/origins/199f2286-ce42-4568-a3f5-3fa0365f6a99?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=057a0abafa19df1c0adc1c4d70f321b4", "srcset": "https://si.imgix.net/228e27d2/uploads/origins/199f2286-ce42-4568-a3f5-3fa0365f6a99?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=057a0abafa19df1c0adc1c4d70f321b4, https://si.imgix.net/228e27d2/uploads/origins/199f2286-ce42-4568-a3f5-3fa0365f6a99?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=7ada6a08549d61c58410430a61a55954 2x, https://si.imgix.net/228e27d2/uploads/origins/199f2286-ce42-4568-a3f5-3fa0365f6a99?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=036ac7ad00d1c0ac43bb9734c6e21288 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/228e27d2/uploads/origins/199f2286-ce42-4568-a3f5-3fa0365f6a99?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=337b18736b5af9b69b2eed6544eff1f2", "srcset": "https://si.imgix.net/228e27d2/uploads/origins/199f2286-ce42-4568-a3f5-3fa0365f6a99?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=337b18736b5af9b69b2eed6544eff1f2, https://si.imgix.net/228e27d2/uploads/origins/199f2286-ce42-4568-a3f5-3fa0365f6a99?bg=%23fff&a