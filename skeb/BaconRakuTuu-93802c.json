9d-8124-96aa4db3c2e5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=4b7c4f9adfde2c12d721e46d1d6ff9b0 2x, https://si.imgix.net/cf75c969/uploads/origins/4e9da210-3aaa-4d9d-8124-96aa4db3c2e5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=e7ceb65655b510a58dc07512f5f11e60 3x"}, "body": "BaconRakuTuuさん、こんにちは！『モンスターガールクエスト パラドックス』のルカとカゲツムギのイラストをリクエストしてもいいでしょうか？\n\n基本イメージは、ソファの上でルカとカゲツムギが騎乗位でセックスしている場面です。カゲツムギはルカの背中に腕を回し、ルカは彼女の腰を抱えています。ルカはズボンを履いたままですが、ファスナーは開いています。カゲツムギはルカの耳元で愛の言葉を囁き、頬を赤らめてニヤリと笑っています。 ルカはシャツを脱いで背中にある引っかき傷を見せている（URLの画像にあるような傷）。\n\n2枚目の画像は、ルカがカゲツムギの膣内に射精するシーン。\n\n3枚目は、可能であれば、終わった後にルカがカゲツムギの膝の上に頭を乗せているシーン。カゲツムギはルカの顔を撫でながら「よくやった」と言う。ルカはシャツを着ている。\n\nhttps://drive.google.com/file/d/1hl3iU46yM5vYoxZk6a4ra4gVwQKeoGq_/view?usp=sharing", "nc": 161, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@BaconRakuTuu/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3426179, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/60b2b476/uploads/origins/02df0496-1dbd-412b-8335-ba314915117c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f3648bf8686de5739cf26c1584ef4842", "srcset": "https://si.imgix.net/60b2b476/uploads/origins/02df0496-1dbd-412b-8335-ba314915117c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f3648bf8686de5739cf26c1584ef4842, https://si.imgix.net/60b2b476/uploads/origins/02df0496-1dbd-412b-8335-ba314915117c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=06c630cd87c08d676fff4943d2e8f5e1 2x, https://si.imgix.net/60b2b476/uploads/origins/02df0496-1dbd-412b-8335-ba314915117c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=469b894e21cae8348139fdb2e06a7d4c 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src":