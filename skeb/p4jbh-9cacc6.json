ン &カレンブーケドール同上\n★計9ファイル\n他に差分もいくつか納品していただきたいです。\n\n★♦PSDはレイヤー統合前でファイル内で差分・宛名が個別に切り替えられる形式でお願いいたします。\n\nご検討の程何卒宜しくお願い致します。", "nc": 57, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@p4jbh/works/5", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/6402038e/uploads/origins/8c374589-5bcb-46e9-a2c8-8faa7fb6a7b6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=91d7ee72a208461ca4da4a0535c2622c", "srcset": "https://si.imgix.net/6402038e/uploads/origins/8c374589-5bcb-46e9-a2c8-8faa7fb6a7b6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=91d7ee72a208461ca4da4a0535c2622c, https://si.imgix.net/6402038e/uploads/origins/8c374589-5bcb-46e9-a2c8-8faa7fb6a7b6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=1cd56ca93662761ba4c0f3237bda5e75 2x, https://si.imgix.net/6402038e/uploads/origins/8c374589-5bcb-46e9-a2c8-8faa7fb6a7b6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=0a73c7d5ce11917d1f08b21036aba3e9 3x"}, "private": true, "genre": "art", "tipped": true, "creator_id": 4003326, "client_id": 207086, "nc": 177}, {"path": "/@p4jbh/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 4003326, "client_id": 160793, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/9bc6c82b/uploads/origins/222fd3e5-1230-4b3d-8efa-473a3b6efc74?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=615a88135cfe2e81ba87bc58baa49789", "srcset": "https://si.imgix.net/9bc6c82b/uploa