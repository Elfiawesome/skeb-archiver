いします。\nこれからも活動を応援しています。\nありがとうございました！", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 1228629, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "メ・バヂス・バ名言bot", "screen_name": "GRONGIKBTIT", "avatar_url": "https://pbs.twimg.com/profile_images/2107834927190519808/UssFUL2W.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1736000677133119488/1791561114/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "art"}], "banned": false, "nc": 33}, {"id": 2693265, "creator": true, "nsfw_acceptable": true, "acceptable": false, "name": "nzzzn/いまは不在！", "screen_name": "zunzunMozun", "avatar_url": "https://pbs.twimg.com/profile_images/1880335089802088448/5JeR4ZGr.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1611180608570658817/1726593574/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 80, "skills": [{"genre": "art"}, {"genre": "comic"}], "banned": false, "nc": 48}, {"id": 3166423, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "ホトルーナ　Photo Luna", "screen_name": "4_k01555553", "avatar_url": "https://pbs.twimg.com/profile_images/1934590957984665600/cYBqjbfI.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1397464935815290883/1653736563/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "video"}, {"genre": "art"}, {"genre": "comic