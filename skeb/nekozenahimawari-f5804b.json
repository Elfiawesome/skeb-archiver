ましたらぜひよろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/1oGTcKMRvVcCKY69aytkUsomuIURVSgt8", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@nekozenahimawari/works/2", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/818f8c8f/uploads/origins/7113b2a9-68ab-4aac-9366-b735f682874a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=2c40c7c84bfc9ac99c3463f409d76c29", "srcset": "https://si.imgix.net/818f8c8f/uploads/origins/7113b2a9-68ab-4aac-9366-b735f682874a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=2c40c7c84bfc9ac99c3463f409d76c29, https://si.imgix.net/818f8c8f/uploads/origins/7113b2a9-68ab-4aac-9366-b735f682874a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=50da3c51e02c62115657fa61c9dee557 2x, https://si.imgix.net/818f8c8f/uploads/origins/7113b2a9-68ab-4aac-9366-b735f682874a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=7cbb1bde97b298391c43b2a4ef9797cd 3x"}, "private": true, "genre": "art", "tipped": false, "creator_id": 3996101, "client_id": 3691895, "nc": 0}, {"path": "/@nekozenahimawari/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3996101, "client_id": 2918895, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/9db0fd78/uploads/origins/978645ba-f003-4ae8-82c5-ae4805369f2a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=60b68e4029459390a1b6a3c69a35fd8a", "srcset": "https://si.imgix.net/9db0fd78/uploads/