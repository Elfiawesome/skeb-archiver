p=top&w=200&h=200&blur=200&s=2afd0cd4dd2d28cbf1aa30f53d6ac90a 2x, https://si.imgix.net/01c975cd/uploads/origins/43c79a1a-6a49-4b12-bf71-ef25db265b79?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=3f28823a5fe3e2e69f2b461a593dac02 3x"}, "body": "こんにちは。私のキャラクターの絵をお願いしたいです。\n\nhttps://sta.sh/28kx6pj3i2j?edit=1\n星座や雲の模様は正確でなくても構いません。ベルトにご注意ください\n\n目や表情はこんな感じでお願いします。https://twitter.com/qcl06/status/1580517972246147075?s=20&t=rAyLiwFladaZUxN24BN11g\n\nご検討のほど、よろしくお願いいたします。", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@qcl06/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2237931, "client_id": 2278220, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/b2c78e5f/uploads/origins/7501cd45-0797-46d3-b27e-dd206af9b247?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a9d713e192f29bb385c75b4359bd1af5", "srcset": "https://si.imgix.net/b2c78e5f/uploads/origins/7501cd45-0797-46d3-b27e-dd206af9b247?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a9d713e192f29bb385c75b4359bd1af5, https://si.imgix.net/b2c78e5f/uploads/origins/7501cd45-0797-46d3-b27e-dd206af9b247?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=1e1d1f50a45b0627207dc00bc1e110ad 2x, https://si.imgix.net/b2c78e5f/uploads/origins/7501cd45-0797-46d3-b27e-dd206af9b247?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=cd87c15a21d5e34c64b6392d96137553 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/b2c78e5f/uploads/origins/7501cd45-0797-46d3-b27e-dd206af9b247?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6697c8f8c979d2bc818b4af821cd7a7e", "srcset": "https://si.imgix.net/b2c78e5f/uploads/origins/7501cd45-0797-46d3-b27e-dd206af9b247?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6697c8f8c979d2bc818b4af821cd7a7e, https://si.imgix.net/b2c78e5f/uploads/origins/7501cd45-0797-46d3-b27e-dd206af9b247?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=36cc3e7ef7bbcd58cc63baf775ade25f 2x, https://si.imgix.net/b2c78e5f/uploads/origins/7501cd45-0797-46d3-b27e-dd206af9b247?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=6139b307dae36ebe69243b671e593fdd 3x"}, "body": "こんにちは。邪悪オジサンと言います。\n\n依頼内容...創作キャラクターのイラスト\n使用用途...鑑賞目的。印刷して家で飾りたいです。ことさんのイラストが大好きなので、自分の創作のキャラクターイラストを描いていただきたいです。\n\n依頼するイラストの内容\n・サイズはA4を希望。\n・解像度は300dpiを希望。\n・PNG、JPG両方のデータで納品を希望。(片方のみであればPNG形式を希望です)\n\nキャラクターの詳しい依頼指示\n・資料の配色はだいたいで大丈夫です。\n髪の毛→白\n目やアクセサリー→黄色\nマント→紫系\n洋服→緑系\n洋服のライン→赤系\n\n・洋服は切り替えのついたワンピース、タイトな感じ\n・メガネは細縁\n・神経質さを感じる表情\n・目や眉は垂れ気味\n\n背景やシーンに関して\n・人＋1モチーフで依頼したいです。\n・モチーフは「鈴蘭」でお願いします。用途やサイズはお任せします。\n・全身を描いていただけると嬉しいです。ポーズはお任せします。\n・人とモチーフ以外の背景は無地で大丈夫です。\n・貼って飾ろうと思っているので作品の上部分に1cmほど余裕があると嬉しいです。\n\nよろしくお願いします！", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}], "sent_works": [], "similar_creators": [{"id": 1060636, "creator": true, "nsfw_acceptable": false, "acceptable": false, "name": "ワンコインスケブくん（停止中）", "screen_name": "nyo7111", "avatar_url": "https://www.gravatar.com/avatar/?d=identicon", "header_url": null, "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 7, "complete_expiration_days": 60, "skills": [{"genre": "art"}], "nc": 161}, {"id": 1313067, "creator": true, "nsfw_acceptable": false, "acceptable": false, "name": "シエリル", "screen_name": "shieriru_55", "avatar_url": "https://pbs.twimg.com/profile_images/1484130984211922944/5dOvdL6Q.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1052938084948439046/1760458607/1500x500", "appeal