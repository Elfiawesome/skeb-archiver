3-ef6b-4304-9264-d0c70cc85296?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a3f3f9cdbaf30691b11b2396803f541c 2x, https://si.imgix.net/0e2f9d05/uploads/origins/caaa7123-ef6b-4304-9264-d0c70cc85296?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=bf904df26939ff5587c1d1a665302b9f 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/0e2f9d05/uploads/origins/caaa7123-ef6b-4304-9264-d0c70cc85296?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=7f27b1527ca5bc848b2acfbdfa5c53c1", "srcset": "https://si.imgix.net/0e2f9d05/uploads/origins/caaa7123-ef6b-4304-9264-d0c70cc85296?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=7f27b1527ca5bc848b2acfbdfa5c53c1, https://si.imgix.net/0e2f9d05/uploads/origins/caaa7123-ef6b-4304-9264-d0c70cc85296?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=40ee2556b3c31ef7a23c909682f5b519 2x, https://si.imgix.net/0e2f9d05/uploads/origins/caaa7123-ef6b-4304-9264-d0c70cc85296?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=bf86eb3d8ff9a3597a0c9ecf94a9ac23 3x"}, "body": "https://x.com/blue_green/status/2070055435856699862\n↑大体のイメージとしてはこちらです。\n水着の零ちゃんが海中で漂ってて、目の前を通るでっかいクラゲ（無害）と遭遇しておお～ってなってる感じでお願いします。\n零ちゃんは特に装備品はつけてませんが、水中なので尻尾はふわふわになっています。\nでっかいクラゲは適当に海流に流されていますが、差し伸べられた零ちゃんの手を巧妙によけています。", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@haruri_poino/works/16", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 76096, "client_id": 261393, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/805919d7/uploads/origins/b52001a1-1ddb-453c-8385-d7a3fcea88c9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=15b24291ed0237951800ac664b1e5a09", "srcset": "https://si.imgix.net/805919d7/uploads/origins/b52001a1-1ddb-453c-8385-d7a3fcea88c9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=15b24291ed0237951800ac664b1e5a09, https://si.imgix.net/805919d7/uploads/origins/b52001a1-1ddb-453c-8385-d7a3fcea88c9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ab59b1acea0f64976324b0c41872d10f 2x, https://si.imgix.net/805919d7/uploads/origins/b52001a1-1ddb-453c-8385-d7a3fcea88c9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a25fccbc78178f4f01a59d3b6bf63312 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/805919d7/uploads/origins/b52001a1-1ddb-453c-8385-d7a3fcea88c9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=38f97f13e3f9b1558bd416c097574fd9", "srcset": "https://si.imgix.net/805919d7/uploads/origins/b52001a1-1ddb-453c-8385-d7a3fcea88c9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=38f97f13e3f9b1558bd416c097574fd9, https://si.imgix.net/805919d7/uploads/origins/b52001a1-1ddb-453c-8385-d7a3fcea88c9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=6de656af9020afa060977bfc1dfbd7a6 2x, https://si.imgix.net/805919d7/uploads/origins/b52001a1-1ddb-453c-8385-d7a3fcea88c9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=9cbe1116d481a77038b08e196736727e 3x"}, "body": "こんにちは、極みんとと申します！いつもお世話になっております\n今回は僕が使用させていただいている「yog」の改変アバターのイラストをお願いしたいです\n何卒よろしくお願いします！\n\n【希望する構図】\n星が煌めく宇宙をバックに、巨大なアバターが一つの銀河系を両の掌で包み込んでいるバストアップイラスト\n(資料URLに一枚絵ですがイメージ画像がございますので、そちらを基にして頂けると幸いです)\n\n【雰囲気・表情】\n全体の神々しさと、茶目っ気のあるいたずらっぽい表情を浮かべていると良い\n\n【キャラクター外見設定】\n性別：12~15歳程度の少年\n髪色：ミントグリーン\n瞳の色：オッドアイ、右目が赤で左目が緑\n髪型：右目隠れのショート　サイドから後ろに所々ハネがあり、耳はほとんど見えない\n備考：左目元に瞳をモチーフにした赤いタトゥーが入っている（雰囲気で描写して頂いて大丈夫です）\n\n【服装】\n白のクロップドTシャツ\n→ シャツには左肩から腰にかけてモノクロのパズル柄の縦ライン、隣に『EXTREME_MI