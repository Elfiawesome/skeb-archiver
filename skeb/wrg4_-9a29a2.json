e7f-4d01-8c07-f221c1e3c41a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=aacfceaae7a9049d1b2db3d36e5ddb66", "srcset": "https://si.imgix.net/dce6cfc3/uploads/origins/156980b8-0e7f-4d01-8c07-f221c1e3c41a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=aacfceaae7a9049d1b2db3d36e5ddb66, https://si.imgix.net/dce6cfc3/uploads/origins/156980b8-0e7f-4d01-8c07-f221c1e3c41a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=2aecdb9ec519693508c0ec81a5e38936 2x, https://si.imgix.net/dce6cfc3/uploads/origins/156980b8-0e7f-4d01-8c07-f221c1e3c41a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=c4b46b6eb5d558353b286d96c9827301 3x"}, "body": "はじめまして、せんたそまると申します！\n 鳩戸宮様の描くイラストに一目惚れしぜひ私の探索者で見たいと思いリクエストを送らせて頂きました！  \n\n「探索者について」\n クトゥルフ神話TRPG レプリカントの葬列 HO 怪盗 を描いて頂きたいです。\n以下設定です(ネタバレなし)\n\n名前  フラン\n\n一人称/二人称/三人称\n俺/お前/お前ら\n\n■性格\n甘え上手で人懐っこい 寂しがり屋\n女の子が大好き 強いて言うならば乳のでかい女が好き どんな女の子でもおれは愛すとか言ってる 1人に絞れないからという理由で4人の女の子と付き合っている 女の子全員は知っている 話が上手い どんな相手でも5分あればみんなお友達になれる ヘラヘラしてる反面、本心はとても寂しがり屋 お酒を飲むと泣き上戸になり、とてもうざい 抱きついてくるしキス魔になる カッコつけたがりだが元々ヘタレ\n\n「別に全員と付き合ってもよくな〜い それって犯罪なの？」\n「1人だとさみしいからさぁ…うち来なよぉ〜(酔っぱらい)」\n「振られたんだけど…なにあいつ 俺の方が絶対いいのに…」\n\n⬛︎怪盗としての設定\n身バレ防止のため女装をしてる❌\n女の子が好きすぎて女装したくなった⭕️\n自分の顔が元々好きで、女の子も好きだから女装すれば良くね！？となった(一応身バレ防止もある)\n変装は得意なため色々な子に似せられる\n口調も若干女の子らしいけど一人称は俺\n\n「見惚れている間に終わっちゃった？」\n「追いかけるなら優しくしてね？俺お姫様だからさ」\n「華麗なるショーをお楽しみください 警部さん？」\n\n「構図について」 \n服装等おまかせでお願いしたいです！ 自由に描いて頂けると幸いです……！  \n\n「使用用途」\n\n 個人鑑賞 snsアイコン等にて使わせて頂きたいです……！  \n\nskeb不慣れなため、金額不足ありましたらお手数お掛けしますが再送していただけると幸いです。 ご検討よろしくお願いいたします……！\n\n「資料用」\nhttps://drive.google.com/drive/folders/1H4gm-OILZRQ907FfNzrhAWAR9Wp9bHpy", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@wrg4_/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 4068198, "client_id": 3944458, "vtt_url": 