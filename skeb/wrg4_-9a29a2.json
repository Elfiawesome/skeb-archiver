物\n耀莉にのん(@ninonchan1215) \n・エルフ(耳が少しだけとんがっていますが、普段は髪の毛でなるべく耳を隠しています。） ・雰囲気：明るくて少し生意気、でも可愛らしい印象 ・モチーフ：リボン、ぬいぐるみ職人見習い \n相棒のうさぎのぬいぐるみ(ちゃる)\n\n●ポーズや表情\nお任せします\n●使用用途 \n・IRIAMの配信のサムネイル ・Twitterのアイコン ・SNSでの告知などの投稿 \nIRIAM特典配布 (商用利用)\n\n●その他\n もし可能であれば背景透過のものも一緒にいただけると幸いです。 何卒よろしくお願いします\n\nhttps://drive.google.com/file/d/1mImuH0gYxagUP4xA4j9mID1aKzUSlVdp/view?usp=drivesdk\n\nhttps://drive.google.com/file/d/1mImuH0gYxagUP4xA4j9mID1aKzUSlVdp/view?usp=drivesdk", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@wrg4_/works/9", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 4068198, "client_id": 1072414, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/c4131445/uploads/origins/2bcd4f6d-b719-41f4-9ac5-5139da5c7b8f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=88652239ce31fd93d75dc06119a6b833", "srcset": "https://si.imgix.net/c4131445/uploads/origins/2bcd4f6d-b719-41f4-9ac5-5139da5c7b8f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=88652239ce31fd93d75dc06119a6b833, https://si.imgix.net/c4131445/uploads/origins/2bcd4f6d-b719-41f4-9ac5-5139da5c7b8f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=28d9dadaa42358d8b9014ab1b562eba0 2x, https://si.imgix.net/c4131445/uploads/origins/2bcd4f6d-b719-41f4-9ac5-5139da5c7b8f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=4c0752521195b6a11b30f471411883ac 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/c4131445/uploads/origins/2bcd4f6d-b719-41f4-9ac5-5139da5c7b8f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=18c7dc9fd1d93fb7231db2be5a6dab4b", "srcset": "https://si.imgix.net/c4131445/uploads/origins/2bcd4f6d-b719-41f4-9ac5-5139da5c7b8f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&