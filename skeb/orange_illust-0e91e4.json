らを向き、こちらを見ている。\n\n・背景\n\n参考②と同じような、白いベッドの上を希望しますが、金額やイラスト作成にかけられる時間的に困難ならば、よりシンプル化した背景でお任せします。キャラクターの描画品質を最優先でお願いします。\n\n・データ形式\n\nキャラクターとそれ以外が綺麗に分離できる原寸サイズのPSD一個。\nこれが不可ならば、綺麗には分離できない原寸サイズのPSD一個。\nこれも不可ならば、原寸サイズのpng一個。\nこれも不可の場合、済みませんが本依頼はキャンセルをお願いします。\n\n・指定していないことや、指定の中でおれんじ先生の判断に悩むこと\n\nおれんじ先生の好みで決めて/描いて頂いて構いません。\n\n\nお忙しいところ済みませんが、ご検討をお願いします。", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@orange_illust/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 340077, "client_id": 222862, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/476deed1/requests/113681_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f89a197d236662978947d80efaa98639", "srcset": "https://si.imgix.net/476deed1/requests/113681_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f89a197d236662978947d80efaa98639, https://si.imgix.net/476deed1/requests/113681_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=87d7c26b9a42a95ab480a483a5ef855c 2x, https://si.imgix.net/476deed1/requests/113681_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=464055e00354a7f74911d52c7a838087 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/476deed1/requests/113681_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=45e45f13416e978f53cc1f2cab81359e", "srcset": "https://si.imgix.net/476deed1/requests/113681_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=45e45f13416e978f53cc1f2cab81359e, https://si.imgix.net/476deed1/requests/113681_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=d63a70d83825bec03e01d2df790f361e 2x, https://si.imgix.net/476deed1/requests/113681_0?bg=%23fff&auto=format%2Ccompress&