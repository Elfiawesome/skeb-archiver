か猫服とかお好みで！今回もアピールありがとうございました。\n\nそして、彼女の服が片方の肩から少しずり落ちるようにしてください。\nかわいいセラフィムの天使で、名前はセラフィナ！\n130cmの小柄な女の子です。胸もぺったんこです。\n性格は気立てがよく、表情豊か！みんなにかわいい笑顔を見せるのが大好き。ウミガメが大好き。\n\n見逃したくない重要な情報があります：\n彼女は3つの後光とその周りに星を持っています。\nそばかすがあります！彼女のそばかすを忘れないでください。\n彼女の髪の右側には白い三つ編みがある。\n右目は琥珀色、左目は茶色。\n\nhttps://drive.google.com/drive/folders/1GylA-VMCl-9_BMNonWvQQxarkqYYDfHy?usp=share_link", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@kyoroniki/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3297950, "client_id": 1388897, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/880a4910/uploads/origins/4bd156b1-8d36-4257-88f0-05fcc744ed3b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1516bcea23da2eeeaf8077eb54498924", "srcset": "https://si.imgix.net/880a4910/uploads/origins/4bd156b1-8d36-4257-88f0-05fcc744ed3b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1516bcea23da2eeeaf8077eb54498924, https://si.imgix.net/880a4910/uploads/origins/4bd156b1-8d36-4257-88f0-05fcc744ed3b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=7e46a16cdbe7f1dc38750f6666f6c715 2x, https://si.imgix.net/880a4910/uploads/origins/4bd156b1-8d36-4257-88f0-05fcc744ed3b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b69c4a099aa58f60e8f73564b6bca71e 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/880a4910/uploads/origins/4bd156b1-8d36-4257-88f0-05fcc744ed3b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=8b4c3d9c10fea58c7ee61e6a1ba30054", "srcset": "https://si.imgix.net/880a4910/uploads/origins/4bd156b1-8d36-4257-88f0-05fcc744ed3b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=8b4c3d9c10fea58c7ee61e6a1ba30054, https://si.imgix.net/880a491