format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=e8aa3f4485601e404b32dcd9867d3c1b 3x"}, "body": "こんにちは！以前お願いした件（SA-KU-RAと彼女の姉妹たちが合体するあのリクエスト）について、改めてお礼を申し上げます。\n\nSA・KU・RA、TSU・BA・KI、A・SA・GIが登場するイラストをもう1枚お願いします。\n\nその場面：SA・KU・RAが、準備していたシリアルが入ったボウルが自然発火したため、両手で顔を覆っている。\n\nTSU・BA・KIは、SA・KU・RAを慰めようと彼女の背中をポンポンと叩いている（とはいえ、この滑稽な状況に、TSU・BA・KIは依然として少し笑いをこらえているようだが）。\n\nA・SA・GIは、SA・KU・RAがうっかり火をつけてしまったシリアルボウルの上で、マシュマロを焼いている。\n\n可能であれば、背景に消火器を持って駆け寄ってくるA・YA・MEも描いていただけると幸いです。\n\nhttps://www.pixiv.net/en/artworks/124159375\n\nお時間を割いてご検討いただき、ありがとうございます。\n\nhttps://www.pixiv.net/en/artworks/124159375", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@MDO_nankyoku/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2412721, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/d36af0b6/uploads/origins/1b75850c-b5d3-4d21-867b-7beddac65a19?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=60626499c4b0f5a6826a8c55f93d472d", "srcset": "https://si.imgix.net/d36af0b6/uploads/origins/1b75850c-b5d3-4d21-867b-7beddac65a19?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=60626499c4b0f5a6826a8c55f93d472d, https://si.imgix.net/d36af0b6/uploads/origins/1b75850c-b5d3-4d21-867b-7beddac65a19?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=306b40dea3c36a16f5761cf993038c7a 2x, https://si.imgix.net/d36af0b6/uploads/origins/1b75850c-b5d3-4d21-867b-7beddac65a19?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c2edd720be49f61b3c050730e0274c03 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/d36af0b6/uploads/origins/1b75850c-b5d3-4d21-867b-7beddac65a19?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0796f8ec1af5d0d648da93821d372a49", "srcset": "https://si.imgix.net/d36af0b6/uploads/origins/1b75850c-b5d3-4d21-867b-7beddac65a19?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0796f8ec1af5d0d648da93821d372a49, https://si.imgix.net/d36af0b6/uploads/origins/1b75850c-b5d3-4d21-867b-7beddac65a19?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=9e66dc5b191bc7ca87153704aa8cd50b 2x, https://si.imgix.net/d36af0b6/uploads/origins/1b75850c-b5d3-4d21-867b-7beddac65a19?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=6e66c2f76522d5c595141da0a3138bdf 3x"}, "body": "こんにちは、リクエストさせてください。\n\nSA・KU・RA、TSU・BA・KI、A・YA・ME、A・SA・GIという4人のキャラクターを合体させ、ロボットウーマンにしたシークエンスを描いてほしい。\n\nA-YA-MEが脚、SA-KU-RAが胴体、TSU-BA-KIが腕、A-SA-GIが頭になる。それぞれのパートで変身し始める様子をパネルで見せる（例えば、頭や手足が引っ込んだり変化したりする様子を見せる）。\n\n私は推奨された金額を支払いに充てるつもりだ。低すぎると感じたら、私にアピールを送ってください。\n\n登場人物の参考文献のリンクを貼っておく。:https://www.pixiv.net/en/artworks/124159375", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@MDO_nankyoku/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2412721, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/b09a1638/uploads/origins/5c7da9b7-27e5-45f4-b412-b4d24227f19e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9c83b617ba8851e2880c9a0f248d52db", "srcset": "https://si.imgix.net/b09a1638/uploads/origins/5c7da9b7-27e5-45f4-b412-b4d24227f19e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9c83b617ba8851e2880c9a0f248d52db, https://si.imgix.net/b09a1638/uploads/origins/5c7da9b7-27e5-45f4-b412-b4d24227f19e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=04eb70f8b68d2e443edcd7429329c44d 2x, https://si.imgix.net/b09a1638/uploads/origins/5c7da9b7-27e5-45f4-b412-b4d24227f19e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e504f5d95f9fc57a7c952d6c3ec0785e 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/b09a1638/uploads/origins/5c7da9b7-27e5-45f4-b412-b4d24227f19e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2a80da328532a2058290528061fa8e85", "srcset": "https://si.imgix.net/b09a1638/uploads/origins/5c7da9b7-27e5-45f4-b412-b4d24227f19e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2a80da328532a2058290528061fa8e85, https://si.imgix.net/b09a1638/uploads/origins/5c7da9b7-27e5-45f4-b412-b4d24227f19e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=ad3476a86bcce2c963cfaf9316aae484 2x, https://si.imgix.net/b09a1638/uploads/origins/5c7da9b7-27e5-45f4-b412-b4d24227f19e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=4bd456c30f72cd187f78680137337862 3x"}, "body": "よろしくお願いします。 古いアニメですが\n高橋留美子先生　ザ・超女　maris　the　chojo　青長髪のスーと赤毛のマリスの真剣勝負で\n①マリスがスーの片足を上げてピンフォールしてる構図またはキャメルクラッチ\n②スーとマリスの大喧嘩\n③描きやすいプロレスの技\nこのどれかの構図で　背景はいりません。\n両者の表情が見えるとありがたいです。\n\n受け　スー　　非常に苦戦してる喘いでる表情　\n攻め　マリス　少し余裕ある表情 \nコスチュームは原作のビキニでおねがいします。 マリスのゴテゴテしたギブスはいりません。\nどうかよろしくお願いします。\nhttps://saudi-otoko.com/2021/02/03/the-supergal-ova/\n\nhttps://www.ashitanowalter.moe/pages/the-choujo.html", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@MDO_nankyoku/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2412721, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/7cce192f/uploads/origins/9ab7d8ab-6e97-4c6d-8c3e-0070a1ff7cbe?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0bec1701bfc1890c32ef1660edc56a30", "srcset": "https://si.imgix.net/7cce192f/uploads/origins/9ab7d8ab-6e97-4c6d-8c3e-0070a1ff7cbe?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0bec1701bfc1890c32ef1660edc56a30, https://si.imgix.net/7cce192f/uploads/origins/9ab7d8ab-6e97-4c6d-8c3e-0070a1ff7cbe?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=9ce5a54e0f095207765a10992c05a236 2x, https://si.imgix.net/7cce192f/uploads/origins/9ab7d8ab-6e97-4c6d-8c3e-0070a1ff7cbe?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=17a9efa138e2a7bcb4e0f3079130f300 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/7cce192f/uploads/origins/9ab7d8ab-6e97-4c6d-8c3e-0070a1ff7cbe?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=bb1fd77fcd7a84c6de8b22d3e4547502", "srcset": "https://si.imgix.net/7cce192f/uploads/origins/9ab7d8ab-6e97-4c6d-8c3e-0070a1ff7cbe?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=bb1fd77fcd7a84c6de8b22d3e4547502, https://si.imgix.net/7cce192f/uploads/origins/9ab7d8ab-6e97-4c6d-8c3e-0070a1ff7cbe?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=0585dcd7530dc0a14a2ba91761ba7bf1 2x, https://si.imgix.net/7cce192f/uploads/origins/9ab7d8ab-6e97-4c6d-8c3e-0070a1ff7cbe?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=a04050b46e6bda3aa818f176e2a9638e 3x"}, "body": "こんにちわ\n\n前回もんぺ姿の農婦のイラストを依頼したものですが、\n前作が気に入りまして、再度リクエストさせてください。\n\n今度は前作の農婦が立っている全身イラストをお願いしたいです。\n恰好は前作と同じ\n野良着に、もんぺ、地下足袋履きで、手には紺の農作業用の手甲をつけています。\n野良着の色は紺で絣模様にしてほしいです。\nもんぺはへその辺りで紐を結ぶ袴式、長さはくるぶしまでで、色、模様は濃い紫系の縞、\n脇は袴の様にスリットを開けてほしいです。\n地下足袋はくるぶしの上までの長さ、色は黒にしてほしいです。\nもんぺイメージ\nhttps://www.dropbox.com/s/27dregu6fv4xgh3/ms.jpg?dl=0\n地下足袋イメージ\nhttps://www.dropbox.com/scl/fi/0dlq0el8hrwkh15ocjvm7/tb.png?rlkey=id9szwe2vs7xqr6f46enheggn&st=gqb9dkf7&dl=0\n\n以上ご検討の程宜しくお願い致します。\n\nhttps://skeb.jp/@MDO_nankyoku/works/1", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@MDO_nankyok