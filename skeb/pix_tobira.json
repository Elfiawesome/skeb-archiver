F&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=9d3dc1695a73054162bf7eda6c9d3041", "src_set": ""}, "private": true, "genre": "art", "tipped": true, "creator_id": 1559237, "client_id": 0, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 161, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@pix_tobira/works/236", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1559237, "client_id": 0, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/ebac8ec0/uploads/origins/0ca56c4d-367e-454d-a7a2-6c10127435f0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4f41af9cc2f5ddb5f82462596d173004", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/ebac8ec0/uploads/origins/0ca56c4d-367e-454d-a7a2-6c10127435f0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2a373686d64cdfaead45aff7e5b41c91", "src_set": ""}, "body": "FANBOX価格\nこんにちは匿名でリクエストさせていただけますか。\n\nドラゴンボールSD6話のブルマとチチの入浴を覗くシーンを原作寄りの画風で描いていただけませんか。\nhttps://www.youtube.com/watch?v=NdRWKOegHHY\n\n胸を揉むように洗うブルマ\n股間にシャワーのお湯を当てて洗うチチ\n原作の世界で一番凄いものを見てしまったという台詞を入れていただければ幸いです。\n\nご検討のほどよろしくお願いします。", "nc": 160, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@pix_tobira/works/235", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1559237, "client_id": 2558933, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/b47dd19a/uploads/origins/ec5dea4b-5ab4-41cf-abc4-baeac5346ab0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=08c2466f89bcbe4ff0c4f2aabee224a7", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/b47dd19a/uploads/origins/ec5dea4b-5ab4-41cf-abc4-baeac5346ab0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b84a7730f58e774e16ff94f2f0d8a0b1", "src_set": ""}, "body": "リクエストさせてください。FANBOX価格からです。\n以前も描いていただきましたがナミ✕カヤの展開絵を3ページでお願いします\n時系列はクロネコ海賊団撃退後〜出航の間\nナミの服装はバラティエ編あたりで着ていた衣装＋靴下＋スリッパでお願いします\n①クロネコ海賊団撃退後、カヤの屋敷内で1人考え後をするナミ。あのときルフィ達が来なかったらあたしどんな目にあってたの？怖かった…と状況を振り返ります。すると後ろからカヤが抱きついてきます。驚くナミ\n②突然ナミの乳首をシャツの上から弄りだすカヤ。皆さん大活躍でしたけどナミさんだけあまり役に立ってなかったですねとナミをからかいます。感じながらそんなこと言わないであたしだって…と声を振り絞るナミ。ナミさん乳首気持ちいいんでしょ？とさらにからかうカヤ。それに対して感じてないわよとさらに声を振り絞るナミ。しかし嫌なら抵抗すればいいのにと返されてしまいます。\n③愛液が垂れてしまうナミ。ナミさんこの液体はなーに？とからかうカヤ。やめて聞かないでと声を振り絞るナミ。靴下びっしょびしょよ履き替える？とからいながら乳首弄りを続けるカヤ。最後は乳首で逝ってしまうナミとそれを笑うカヤでお願いします。\nナミは着衣でなるべく全身をお願いします。\nどうかよろしくお願いします。", "nc": 49, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@pix_tobira/works/234", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1559237, "client_id": 0, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/18635e51/uploads/origins/56c136c6-1a35-4e58-b2c9-0342b889c8e3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fa65db00faed3798fef7b03e6ce2d14c", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/18635e51/uploads/origins/56c136c6-1a35-4e58-b2c9-0342b889c8e3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a6f0cc9fa4bf6653c1c52a460504eaf9", "src_set": ""}, "body": "「つきあってよ五月ちゃん」より\n主人公の女の子がカポエラ男に剥かれてしまうシーンを元に毛利蘭が悪漢から攻撃を受けて服をビリビリに破られる漫画をお願いします。\n着ているものについては元ネタの柔道着、学校の制服、作中に出てきた私服等どれでも構わないのでお任せとさせていただきます。\n\n五月ちゃんについては資料URLを参照お願いします。\n\nhttps://twitter.com/xianghua_love/status/1300569698828861440", "nc": 49, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@pix_tobira/works/233", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1559237, "client_id": 0, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/941b0116/uploads/origins/15d51b20-8de8-4257-bc72-5f994702b33b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6be262b40624e155757dfd96aeb1e657", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/941b0116/uploads/origins/15d51b20-8de8-4257-bc72-5f994702b33b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=632743eb978e4c07beb7e313a7029b50", "src_set": ""}, "body": "夏のシコフェスとのことなのでFANBOX価格で是非お願いします！\nあ、アリーナVSビビアンの者です。\n\n前回の試合の後のシーンです。\n潮吹きまでさせられまたまた無様に負けてしまったビビアン＆マヨネー。\n更衣室で「また負けちゃったね。あんなに滅茶苦茶にされたの初めて」「ああもう、色んなお汁でブルマびちゃびちゃ」と二人ともお互いのぐちょぐちょブルマを見て再び勃起。\nちょっと恥ずかしがりながら「ねえ、ちょっと修行しよっか・・」と言ってお互いのぐちょぐちょブルマ越しにシコシコし合う。\n「もうダメ～こんなの耐えられないよ！」「ほらほらもっとがんばって！」\n『いっく～！』と二人で昇天。", "nc": 176, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@pix_tobira/works/232", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1559237, "client_id": 0, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/bf793be8/uploads/origins/e2e5425f-07e1-4f5c-908b-f05a9ac6009b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=da535a6ecf6c717c7977615fb18b7267", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/bf793be8/uploads/origins/e2e5425f-07e1-4f5c-908b-f05a9ac6009b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=97a44e0f37da42ac7d8ec88820fab1a9", "src_set": ""}, "body": "「FANBOX価格」\n\n○ワンピースのナミで、\n・空島ウェザリアのところで\n・ハレダス達(ウェザリアの住人達)【※１一番下に参考リンクを載せました。】があまりにも風呂を覗きにくるので、2度と覗きに来ない代わりに、１度だけ風呂に入っているところを好きなだけ写真や動画を撮らせることになり、無防備な風呂に入ってる様子を恥ずかしがりつつ怒っているような感じで撮影されてしまうシチュエーションをお願いします。\n\n内容は、\n①ナミが風呂に入ってるときに、覗きにきているジジイ達に気付き「コラ！変態クソシジイ共！」という感じで怒り、皆をボコボコに。\n②何度ボコボコにされてもやめない様子に(こいつら絶対やめないだろうな…)と呆れたナミが「好きなだけ撮影させる代わりに2度と覗きに来ないこと」をジジイ達に提示。(照れつつちょっと怒りつつみたいな表情で)\n→即刻了承するじーさん達\n　「オッケーじゃ♥️♥️♥️」\n③翌日の風呂の時間になり…\nいつもどおりに風呂に入るナミ。\n(ただし風呂の扉は誰でも覗けるように全開)\nそこへやってくるじーさん達。\n(グラビア撮影という感じより、覗きにきて扉から撮影しているような感じでお願いします。）\n約束どおりに、シャワーを浴びてる様子や、体を洗っている様子などの無防備な裸の状態を撮影されるナミ。\n(撮影されてる時のナミは怒り+照れのような感じでお願いします。)\n\n\n\n分かりづらい文や、この描写は不要だなと思った文については、もちろんですが、描きやすいように変えていただいて構わないです。\n\n長文で分かりづらいところがあるかもしれませんが、検討いただけると嬉しいです。\n\n\n【※１】\nハレダスはこのキャラクターになります。\nhttps://one-piece.com/character/Haredasu/index.html", "nc": 49, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@pix_tobira/works/231", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1559237, "client_id": 0, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/2620c789/uploads/origins/36c40577-a7f1-451d-b504-c80b6616dc1b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4f9488e94a45f495865a073be1eacc64", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/2620c789/uploads/origins/36c40577-a7f1-451d-b504-c80b6616dc1b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2a13cc9a7cc23294d1713e4dfa408fa0", "src_set": ""}, "body": "FANBOX価格\n\nこんにちは、夏のシコフェス感謝です\n\n今回ドラクエ3の女遊び人が、夜のご奉仕でパーティにとどまっているシチュを漫画にしていただきたいと思っております。\n\nビジュアルは最近出たリメイク版よりは、昔の金髪バニーちゃんだと嬉しいです。\n\n\n下記のプロットでお願いしたいです\n\n\n◎1P\n\n宿屋の1室で、パーティの女僧侶と女魔法使いが話している\n\n魔法使い「あーー！！もう！！！今日もあの遊び人、戦闘ほっぽりだして！！なんで勇者はあんなやつパーティに入れてるのよ！！」\n僧侶「まぁまぁ…神様に選ばれた勇者様ですもの、きっと何か考えがあってのことなんですよ」\n\n…\n\n一方その頃という感じで、宿屋の別室のベッドの上に雑多に脱ぎ散らされた下着やバニースーツと、勇者/遊び人の嬌声\n「あ、遊び人さん、好きぃ♡　好きですぅ♡」\n\n◎2P\n\n騎乗位で、手をおっぱいに誘導させて揉ませてる感じで\n\n「もう、勇者様が私みたいな女に好き好き言っちゃだめよ♡……本気にしちゃうんだから♡」\n「ほ、本気にしていいです！！僕のものになってくださいぃ♡」\n「もうっ♡……じゃあだーいすきなお姉さんに、勇者ちゃんの精液いっぱい注いで♡」\n\n◎3P\n\n射精\n\n「あはっ♡情けない顔～♡　だめよ勇者様がそんな顔晒しちゃ♡」\n「…あんっ♡中でまたビクビクしてる♡もうっ、こっちは本当に勇者様ね♡」\n「それじゃあ……もう一戦イっちゃおっか？勇者ちゃん♡」\n「は、はひぃ♡」\n\n\n---終わり---\n\n\nと、遊び人的な感じでありつつ、ちょっとお姉さん的な雰囲気もある遊び人(lv上がってきており賢者的要素が少し出てる的な)と\nすっかり遊び人にメロメロにされてしまった勇者という感じの雰囲気でお願いしたいです\n\nもしよろしければお願いします", "nc": 49, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@pix_tobira/works/230", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1559237, "client_id": 0, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/11581ff1/uploads/origins/473a1b04-c219-4119-a285-737747091dd6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a51888972bca2a5a10de630c714fccdb", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/11581ff1/uploads/origins/473a1b04-c219-4119-a285-737747091dd6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=508be54e37998320040c9346b23a469b", "src_set": ""}, "body": "はじめまして！匿名で失礼します\n扉さんの描かれる作風が素晴らしくご依頼させて頂きたく思います、もしいけるのであればFANBOX価格でリクエストさせてください。\nご依頼させていただくキャラはケロロ軍曹から大人の日向夏美で服装は制服姿でお願いします。\n\nシチュとしましては\n1ページ目\nケロロの不注意のやらかしによって新･夢成長促進銃（オトナノカイダンノボル銃）で大人に成長した夏美\n制服は急成長によって各所のサイズが合わなくなりパツパツな状態で\n夏美は「ボケガエル？」と表情はジト目で不機嫌そうな顔で\nケロロも「事故であります！事故であります！」と必死で弁明\n（ケロロはセリフのみでも姿付きでもどっちでも）\n2ページ目\n当然怒ってる夏美がケロロをとっ捕まえようとするが\n急成長してパツパツになった制服で無理に動いた結果耐え切れなくなり\n制服のボタンやスカートのホックが弾けておっぱいがはみ出てポロリしたり制服の肩幅の縫い目などが破けたりしてしまったという絵をお願いできますでしょうか？\n夏美の表情は胸ポロリとかで顔赤くなって「わーっ！」と大慌てした表情でお願いします。\n\n以下は吉祥学園制服の資料URLですので確認いただければ幸いです\nhttps://mikuri10030.yukigesho.com/puyopuyofever/sel_natsumi.png\nhttps://www.deviantart.com/magumama/art/Koyuki-Azumaya-Sgt-Frog-988831093\n\nもしも記載が不足している要素や、アレンジを加えたい箇所がございましたら、ご自由にさせていただいて構いません。\nつきましては以上の記載で受けて頂けると幸いです。御一考のほどよろしくお願いします。", "nc": 32, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@pix_tobira/works/229", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1559237, "client_id": 0, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/3e6b3b71/uploads/origins/3fd596fc-739e-4386-adf6-dd7ac9d362cd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d3c5566c237153464d8d6bacac164518", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/3e6b3b71/uploads/origins/3fd596fc-739e-4386-adf6-dd7ac9d362cd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=aef7d8e4ad440cfc17f108fce543f303", "src_set": ""}, "body": "ToLOVEるの古手川唯さんが「黒髪ロング爆乳眼鏡ドジっ子教師」になったパラレルワールドの漫画をリクエストさせていただきます。\n古手川さんは原作から一段と成長し、Mカップのグラマーになっています。\nティアーユ先生の見た目を意識しつつ、ブラウスに上着、ミニのタイトスカート、眼鏡の姿で仕事します。\n4ページのボリュームでお願いします。\n\n以下内容のイメージです。\n原作の「迷惑暴走？」を意識した内容があります。ToLOVEる18巻冒頭が該当ですので、資料URLの試し読みページをご確認お願いします。\n\n・(ナレーション)新任教師、古手川唯。熱心な風紀指導が評判である。\n教師姿で腰に手を当て指をビシッと出す。「風紀を乱すことは許しません！」\n・(ナレーション)しかし噂では自身が風紀を乱すこともあるとか……\nブラウスのボタンが外れ、おっぱいが見えてしまうハプニングの回想。\nパンツが何かに引っかかって引っ張られ、スカートがめくれてお尻を突き出してしまってるハプニングの回想。\nたまたま周りに人はいない。\n・(古手川唯)次は体育の授業の補助ね\n更衣室でジャージに着替える。下着姿が映る。ジャージのファスナーは上げきれないため、胸の下まで。自身の胸を見てちょっと恥ずかしいような気持ち。\n・(古手川唯)授業を始めるわよ―――　って　きゃああっ？\n古手川さんの周りを黒い翼(ペケから出たもの)が囲み、服がエロ下着に早変わり。さらに翼は古手川さんの太もも、手首、腰のような要所に軽く巻き付いて拘束し、胸をだぷんだぷんっと揺らして揉む。\n・(古手川唯)だっ　だめ～～～～っ！\n翼が弄ぶうちに、下着はあっさりずれてしまった。翼は乳房を寄せて持ち上げて谷間を強調させ、翼の先で乳首を弄ぶ。絶頂する古手川さん。\n\n描いていただきやすいように適宜内容を増減いただけますと幸いです。\n何よりも、真面目な古手川唯さんが妙なシチュエーションに巻き込まれて仕方なくハレンチな姿を見せてしまう様子を描いていただけないでしょうか。\n好き勝手な内容で恐縮ですが、ご検討をよろしくお願いいたします。\n\nhttps://www.s-manga.net/items/contents.html?jdcn=08870022874278325501", "nc": 176, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@pix_tobira/works/228", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1559237, "client_id": 0, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/cbfc4728/uploads/origins/031d84bd-cd89-44ea-831f-23c87653cb44?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0fae75d00cd996d1e8521d9ebe146df6", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/cbfc4728/uploads/origins/031d84bd-cd89-44ea-831f-23c87653cb44?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=92d1ae0cf125c96fb0fc88dae37fd7f7", "src_set": ""}, "body": "はじめまして！\n今回初めてリクエストさせていただく者です！\n名探偵コナンからでアースレディースのイラストをお願い致します\n内容はアースレディースのメンバーが、汗だくで歌を歌っているシチュエーションの1枚絵でお願い致します。\n\n\nイラストのポイントとして、アースレディースのメンバーは1人だけ、四人のうちどれかは主様のランダムで決めていただいてOKです。\nhttps://encrypted-tbn0.gstatic.com/images?q=tbn:ANd9GcS7D9o-PULfs26Wf8Gvpw8j-pyQ8PItPMTgvhij9W4YMfPLgyFyDsK8wn8&s=10\nこの中から1人だけでお願い致します。\n\n\nhttps://encrypted-tbn0.gstatic.com/images?q=tbn:ANd9GcSnnG8DrQULJVqSkvqgNh_uiLOSseR3i-aWFGHx474ZU7sj18nLewnWVDw&s=10\n衣装はこんな感じです。\n\nまた、見てみたいシチュエーションとして、汗だくで身体から湯気が発せられている、この衣装に脇や密着している部分は広範囲に汗染みができている、へその描写ありという描写をお願い致します。", "nc": 49, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@pix_tobira/works/227", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1559237, "client_id": 1882070, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/8dda72e3/uploads/origins/1cb2b7e0-863a-4484-bc9b-fe58089ad230?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b87e86a6ad32383dae33f8ab8fe98a50", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/8dda72e3/uploads/origins/1cb2b7e0-863a-4484-bc9b-fe58089ad230?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=bee6b9ed1480bcd1c209001a3fec11f5", "src_set": ""}, "body": "いつも素晴らしいイラストをありがとうございます！\n\nキャラクター\n・コナンの世良真純\n・新一っぽいガキ\n\nシチュ\n・①ホテル連続爆破事件(動画参照）の流れでコナンと間違えてコーラで濡れさせてしまうが、可愛いので結局ホテルに