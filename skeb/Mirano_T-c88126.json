5-ad85-559379d5a347?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=8d186fdf7ad1c7e490b95b1c1a069275", "srcset": "https://si.imgix.net/50a6915b/uploads/origins/e3041da0-d8ff-4f75-ad85-559379d5a347?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=8d186fdf7ad1c7e490b95b1c1a069275, https://si.imgix.net/50a6915b/uploads/origins/e3041da0-d8ff-4f75-ad85-559379d5a347?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=ba07cc187cbd7e28c880babbcce037b5 2x, https://si.imgix.net/50a6915b/uploads/origins/e3041da0-d8ff-4f75-ad85-559379d5a347?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=64e195ce0301dccd80759273422f9ba6 3x"}, "body": "前回の短めの漫画のシチュエーション(優吾くんが保奈美ちゃんを助けるシーン)の続きが思いつきましたのでまたリクエストいたします。\nキャラクター\n優吾くんURL\nhttps://pbs.twimg.com/media/FlBJ2kpagAAO_2z?format=jpg&name=large\n優吾くんに着せて欲しい衣装URL\nhttps://www.idolish7.com.tw/vendor/unit_more/img/profile/nanase/chara_001.png\n保奈美ちゃんに着せて欲しい衣装URL\nhttps://i.pinimg.com/originals/b9/19/19/b91919d993bccb42848e535d98d35476.jpg\nhttps://i.pinimg.com/originals/0a/ed/95/0aed951a68347115aea41841ba492b27.jpg\nシチュエーション\n「劇場を脱出する寸前、劇場を爆破させた張本人である「オペラ座の怪人の再来」なる仮面伯爵が現れ、優吾くんに対し「美しきプリマドンナ達の抹殺を止めたければ私と決闘しろ」と挑戦状をたたきつける。その後、怪人は立ち去り再び劇場は爆破され揺れ出す。二人は崩落の一途をたどる劇場を脱出する」シチュエーションでお願いします。\n「オペラ座の怪人の再来」なる仮面伯爵のイメージとしては仮面の下は美男子というイメージです。前回同様セリフなどはお任せします。", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Mirano_T/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1734081, "client_id": 1591546, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/f4a498d3/uploads/origins/0a975b8d-5a3a-43cc-b0c9-ffa4d456baba?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f626f71c60ec829312f9df6723927a1f", "srcset": "https://si.imgix.net/f4a498d3/uploads/origins/0a975b8d-5a3a-43cc-b