く描いて頂ければ嬉しいです！\nお忙しいとは思いますが、もしお受け出来る様であればよろしくお願いします。\n\n【参考資料】\n・https://drive.google.com/drive/folders/1iyzJF7rdpOptTq1fmJ2tWCgKVeiO0luf?usp=sharing\n・https://drive.google.com/drive/folders/1lbeV_J3SPKReUkkfrh4w2PPXg1HU9tdB?usp=sharing", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@heroism0_0/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 623292, "client_id": 3592644, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/54d795c3/uploads/origins/051d23e0-6e52-4379-8898-c72928f9f9de?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b6d26a55b1db666c4bc0232592bb9222", "srcset": "https://si.imgix.net/54d795c3/uploads/origins/051d23e0-6e52-4379-8898-c72928f9f9de?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b6d26a55b1db666c4bc0232592bb9222, https://si.imgix.net/54d795c3/uploads/origins/051d23e0-6e52-4379-8898-c72928f9f9de?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=450a98756384f90835f164eb04093226 2x, https://si.imgix.net/54d795c3/uploads/origins/051d23e0-6e52-4379-8898-c72928f9f9de?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=2d3511442fa9be629ef17a7c63ac7fce 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/54d795c3/uploads/origins/051d23e0-6e52-4379-8898-c72928f9f9de?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=27c67e6a7d31b470e58e41bb002e7d09", "srcset": "https://si.imgix.net/54d795c3/uploads/origins/051d23e0-6e52-4379-8898-c72928f9f9de?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=27c67e6a7d31b470e58e41bb002e7d09, https://si.imgix.net/54d795c3/uploads/origins/051d23e0-6e52-4379-8898-c72928f9f9de?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200