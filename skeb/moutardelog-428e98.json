tus/1434329815209824260\n\n【世界観】\n耽美な中世ヨーロッパ風の世界観で、太陽を悪としており、夜しか存在しない世界です。「ゴシックで耽美な吸血鬼の世界」と言ったら近いかも知れません。\n赤い月が崇拝対象となっています。\n\n【職業】\n騎士兼領主。普段は土地を治めたり、魔獣の討伐やトラブル解決等を行っています。", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "similar_creators": [{"id": 308560, "creator": true, "nsfw_acceptable": false, "acceptable": false, "name": "クラコ", "screen_name": "ashiokakuraco", "avatar_url": "https://pbs.twimg.com/profile_images/1444138920027901953/2OQIwBbd.jpg", "header_url": "https://pbs.twimg.com/profile_banners/877025019523616768/1731585063/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 3, "complete_expiration_days": 120, "skills": [{"genre": "art"}], "banned": false, "nc": 0}, {"id": 436822, "creator": true, "nsfw_acceptable": false, "acceptable": false, "name": "🦃", "screen_name": "MEN_cho7", "avatar_url": "https://pbs.twimg.com/profile_images/1499747284417859585/M5Wmo0nv.jpg", "header_url": "https://pbs.twimg.com/profile_banners/997402941685284864/1690020219/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "art"}], "banned": false, "nc": 48}, {"id": 2353910, "creator": true, "nsfw_acceptable": false, "acceptable": false, "name": "定規❤️‍🔥", "screen_name": "vat0uq", "avatar_url": "https://pbs.twimg.com/profile_images/2072943955218726912/k6He2kV2.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1362461502540709889/1693425254/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 120, "ski