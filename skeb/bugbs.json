ff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=340cf50316b1891a41e0cc51ec3a6dd4", "src_set": ""}, "body": "こんにちは！前の絵がとても気に入ったので、また戻ってきました！今回は僕のOCのセリスを描いてくれませんか？以下は彼女の参考資料です！\n\nhttps://wondernyan.notion.site/Cerise-Traveler-ef03bb1bc8cc4d0ab861afba0cb39027\n\nセリーズは暗黒魔法を使う暗殺者でスパイ！彼女にはタトゥーがあり、後に傷跡に置き換えられます。もし可能なら、PSDに両方のバージョンのトグルを追加してもらえますか？もしそれが面倒なら、好きな方を選んでください！彼女のテーマは、闇、カラス、赤い月、夜空、悪魔です。\n\nデッサンの詳細はお任せします。とにかく綺麗でかっこよくお願いします！ありがとうございます🥰\n\nhttps://wondernyan.notion.site/Cerise-Traveler-ef03bb1bc8cc4d0ab861afba0cb39027", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@bugbs/works/26", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 190745, "client_id": 2454072, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/fbfa9fbe/uploads/origins/61809a66-b0a2-4681-8509-5c4b1e62a7bc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c60f6487994718fabffbf89173b3f362", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/fbfa9fbe/uploads/origins/61809a66-b0a2-4681-8509-5c4b1e62a7bc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=783775715f3800c6d362b6bc28778442", "src_set": ""}, "body": "BugBsさん、こんにちは！\n\n以前描いていただいた作品がとても気に入りました。私のVTuberのキャラクターに新しい服を着せたのですが、また別の作品を描いていただけないでしょうか？\n\n今回は鎧を着たキャラクターです。もし鎧を描かないのであれば、リクエストは無視していただいて構いません。髪型は2種類、ポーズや構図は自由です！ポイントは青い目と左目の下のホクロです。\n\n私のリクエストを読んでくれてありがとう！\n\nhttps://i.imgur.com/PeZcZ63.jpeg", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@bugbs/works/25", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 190745, "client_id": 82293, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/d9cf1b96/uploads/origins/6a84fa91-2d3a-4df8-866d-761e03e260bf?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ac1700e6661087081d76aaff543fcddb", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/d9cf1b96/uploads/origins/6a84fa91-2d3a-4df8-866d-761e03e260bf?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=4592fc41c077c6c3addc9890810d99de", "src_set": ""}, "body": "BugBsさん、こんにちは⁂😴さん！このキャラクターも描いてもらえますか？\n\n彼女は彼らの宇宙の創造神と対をなす存在で、彼の「心」に対する「心」を体現しています。彼女は彼と対等な存在として彼から分割されましたが、彼の期待に反し、彼自身の延長として機能するようになりました。\n\n彼が命を道具として扱うのに対し、彼女はそれぞれの魂（宝石として描かれている）を唯一無二のものとして大切にし、彼の支配欲よりも彼らの経験を重視する。\n\n彼女は共感的でありながら激しく自立しており、操るのではなく、育て、理解しようと努め、それぞれの人生を尊ぶに値する物語とみなしている。\n\nあなたは好きな服装で彼女を描くことができる！\n\n彼女の瞳孔の形と色に注意してください！\n\nよろしくお願いします！\n\nhttps://drive.google.com/drive/folders/1qrgOt39imeo9p_KZN6B8bz8L8mnJx777?usp=drive_link", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@bugbs/works/24", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 190745, "client_id": 655113, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/e8828914/uploads/origins/408265ee-2439-4092-bd1a-6704756dc760?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d13214c867752ad9092abcc2dbe8010c", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/e8828914/uploads/origins/408265ee-2439-4092-bd1a-6704756dc760?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=273042988e654f764952e275751a8ad9", "src_set": ""}, "body": "こんにちは！あなたの絵はとても美しいです！私のOCオデットを描いてくれませんか?以下は彼女の参考資料です！\n\nhttps://wondernyan.notion.site/Odette-b6e906fa882a47ec8a87fb09e698ce6b\n\nオデットの服装は何種類かありますが、好きな方を選んでください！\n\nオデットは天使と人間のハーフ！穏やかでエレガントだが、戦うのが大好き。戦っているときはとても負けず嫌いで、楽しみのために相手を見せつけたり嘲笑ったりするのが好き。彼女のテーマには、天使、翼、羽、光、剣、白鳥、十字架などがある。\n\n聖なるものや天使のモチーフなら何でもOK！詳細はお任せします！お好きなように描いてください！ありがとうございました！\n\nhttps://wondernyan.notion.site/Odette-b6e906fa882a47ec8a87fb09e698ce6b", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@bugbs/works/23", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 190745, "client_id": 82293, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/a0ab6ae2/uploads/origins/19e26089-6c19-4885-b030-33ed74fc3da0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5832fd068a196d115d6c2d142f3ae68e", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/a0ab6ae2/uploads/origins/19e26089-6c19-4885-b030-33ed74fc3da0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=fb1e5a16322fafda21240cdaf2095b24", "src_set": ""}, "body": "こんにちは、bugbsさん！僕のキャラクターを描いてもらえませんか？\n\n彼は私のオリジナル・キャノンの1つの「創造主」として行動し、彼の宇宙の神として崇拝されています。彼はどの魂が世界に入るのを許すかについて非常に厳格です。\n\n彼はこれらの魂を操り、彼らの苦しみに無関心で、自分のイメージ通りに存在を形作ることだけを追求する。\n\n彼は冷淡で計算高く、生命を自分のビジョンを実現するための単なる道具として扱う。彼は存在を、自分が究極の演出家である壮大な「劇」と見なしている。彼の唯一の喜びは、生命（宝石）のコレクションがますます輝きを増していくのを見ることである。\n\n好きな服装で彼を描くことができる！\n\n構図は好きなようにすればいい。\n\nよろしくお願いします！\n\nhttps://drive.google.com/drive/folders/1PbpnmX90rgdKtRBwKqWQDk-c577scicN?usp=drive_link", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@bugbs/works/22", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 190745, "client_id": 786547, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/fa5d288d/uploads/origins/413c2b02-01bf-4d50-bba0-23638501b157?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1e887923ff910543c24342c955c16564", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"s