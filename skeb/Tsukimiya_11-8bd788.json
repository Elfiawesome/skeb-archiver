せいで身体が排泄していると感じおしっこを漏らしそうになる\n・止めてと懇願するが聞き入れてもらえらない\n・引き抜かれた瞬間に力を入れて我慢しようとするも先生に頭を撫でられたせいで身体が緩んでしまいおもらし\n・緩みすぎてアナルに中出しされた精液も出してしまう(下品な音の描写があると嬉しいです)\n・全部出し切ったキサキはあまりの恥ずかしさに顔を手で隠す\n長々と申し訳ありません。\nその他の部分はお任せいたします。\n何卒、よろしくお願いします。", "nc": 42, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Tsukimiya_11/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3388553, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/552e09fc/uploads/origins/e2e10dbd-6698-496f-9180-41f56abe866b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f6a92d2e084bc41fb696f03448c049e2", "srcset": "https://si.imgix.net/552e09fc/uploads/origins/e2e10dbd-6698-496f-9180-41f56abe866b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f6a92d2e084bc41fb696f03448c049e2, https://si.imgix.net/552e09fc/uploads/origins/e2e10dbd-6698-496f-9180-41f56abe866b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=0d2e6a56e50e8a5e17a0f7d4311a6bdd 2x, https://si.imgix.net/552e09fc/uploads/origins/e2e10dbd-6698-496f-9180-41f56abe866b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=8546cd1f43802381def5bcee57950384 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/552e09fc/uploads/origins/e2e10dbd-6698-496f-9180-41f56abe866b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=858198ca7b50ae9ed51f8d1222799bfb", "srcset": "https://si.imgix.net/552e09fc/uploads/origins/e2e10dbd-6698-496f-9180-41f56abe866b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=858198ca7b50ae9ed51f8d1222799bfb, https://si.imgix.net/552e09fc/uploads/origins/e2e10dbd-6698-496f-9180-41f56abe866b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=4c59b258777d8b5023