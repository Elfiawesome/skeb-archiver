ui1135 )\n\nhttps://drive.google.com/drive/folders/1Fj-SBtIl-FY7P4sWA13Tz5hUJZSbKb-4", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@cottonplum__/works/1", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/a33c5a69/uploads/origins/468ca15a-8b1e-4199-a7b6-5413b224e29e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=929450f2f32c26b3dd33dc9bb3cc2777", "srcset": "https://si.imgix.net/a33c5a69/uploads/origins/468ca15a-8b1e-4199-a7b6-5413b224e29e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=929450f2f32c26b3dd33dc9bb3cc2777, https://si.imgix.net/a33c5a69/uploads/origins/468ca15a-8b1e-4199-a7b6-5413b224e29e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=4f85ffd598f43dbbe8e78854109545bc 2x, https://si.imgix.net/a33c5a69/uploads/origins/468ca15a-8b1e-4199-a7b6-5413b224e29e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=94d499d782358eb15f68158d6576255c 3x"}, "private": true, "genre": "art", "tipped": false, "creator_id": 2488676, "nc": 145}], "sent_works": [], "similar_creators": [{"id": 317109, "creator": true, "nsfw_acceptable": false, "acceptable": false, "name": "らい", "screen_name": "hirakecinnamon", "avatar_url": "https://pbs.twimg.com/profile_images/2039252968730755072/Ureyco85.jpg", "header_url": "https://pbs.twimg.com/profile_banners/932859437097684992/1690987410/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptab