で自分の母親を殺してしまったらしい。\n非常にツンデレで、好きな人がいても認めようとしない。自分の感情をうまく表現できず、心に闇を抱えることもある。\n\n身長157cm！\n\nそんな巴の手について、かっこよかったり、ほほえましかったり、クレイジーなところを描いていただけたら嬉しいです。\nこのイラストはソーシャルメディア（TwitterやTwitchなど）で使いたいと思っています。できれば16:9のフォーマットを希望します。\n\nこれで大丈夫でしょうか？\n\nhttps://drive.google.com/file/d/1LfEm5OT7VxkIyanfLZN9xmCGypyN4Nmf/view?usp=drive_link\nhttps://drive.google.com/file/d/1LcSOsMiHmzxF8XCSB2BVyhvtnDY2lL6S/view?usp=drive_link\nhttps://drive.google.com/file/d/14e4CVwFtCevLFFQGzqwGEmvFWw24yzb9/view?usp=sharing", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@cho_kuuki/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3077792, "client_id": 2299646, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/268ecacf/uploads/origins/f8772942-251a-48f8-809f-98643bef733d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=750786ac5ee2c02def5233950b417c90", "srcset": "https://si.imgix.net/268ecacf/uploads/origins/f8772942-251a-48f8-809f-98643bef733d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=750786ac5ee2c02def5233950b417c90, https://si.imgix.net/268ecacf/uploads/origins/f8772942-251a-48f8-809f-98643bef733d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c82d4429ee640de1f160afbbe92e3a7d 2x, https://si.imgix.net/268ecacf/uploads/origins/f8772942-251a-48f8-809f-98643bef733d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=9465fd4b767b7676b91e508cd7b101b1 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/268ecacf/uploads/origins/f8772942-251a-48f8-809f-98643bef733d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9fc6270ef6ec2a9c6f30f24e0bd45dd4", "srcset": "https://si.imgix.net/268ecacf/uploads/origins/f8772942-251a-48f8-809f-98643bef733d?bg=%23fff&auto=forma