い！\n\n今度は腰から上、スクール水着を着て、お互いの肩に腕を回しながら潜っているところを見てみたい。スキューバダイビング用の深いプールの底にいる。\n\n2つのバージョンを見たい。1つ目は、頬を大きく膨らませて息を止めている（例：https://x.com/bongorei192/status/1438499774857035783）。二人の顔は労作で赤くなり始めているが、彼らはまだ陽気で快適だ。\n\n2枚目では、いつものようにスキューバギアを使っています。レギュレーターに巻かれた分厚いリップ、そして目には分厚いマスクをつけてあげてください (例: https://i.imgur.com/zzy804C.png)", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@pp_kousei/works/59", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1240796, "client_id": 328819, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/7a74d6f6/uploads/origins/27b714f0-24a3-43f9-bd51-3f32bfbe5b81?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e1961d0c7a2f9341451c6dfe8af27d85", "srcset": "https://si.imgix.net/7a74d6f6/uploads/origins/27b714f0-24a3-43f9-bd51-3f32bfbe5b81?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e1961d0c7a2f9341451c6dfe8af27d85, https://si.imgix.net/7a74d6f6/uploads/origins/27b714f0-24a3-43f9-bd51-3f32bfbe5b81?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=6d1b80d7adeb2bb5f7976a369476a452 2x, https://si.imgix.net/7a74d6f6/uploads/origins/27b714f0-24a3-43f9-bd51-3f32bfbe5b81?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=840df79b12dcae7fc5f70e6e9f777229 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/7a74d6f6/uploads/origins/27b714f0-24a3-43f9-bd51-3f32bfbe5b81?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=94a82869d9291a3b557099422fb59d3a", "srcset": "https://si.imgix.net/7a74d6f6/uploads/origins/27b714f0-24a3-43f9-bd51-3f32bfbe5b81?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=94a82869d9291a3b557099422fb59d3a, https://si.imgix.net/7a74d6f6/uploads/origins/27b714f0-24a3-43f9-bd51-3f32bfbe5b8