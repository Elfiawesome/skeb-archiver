にも注目してください。\n\nここにすべての参照があります。\nhttps://refsheet.net/Neogareboshi\nhttps://drive.google.com/folderview?id=1-Wt0pCta8lwrL_2spngXcoPP8nUXOPwV\n\nありがとうございました。🙏✨\n\nhttps://drive.google.com/folderview?id=1-Wt0pCta8lwrL_2spngXcoPP8nUXOPwV", "nc": 176, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@nzuuure/works/13", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 23552, "client_id": 13781, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/e3663b88/uploads/origins/2bbea6ba-97fb-49b7-a07c-d283f5bbfbaa?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5d3303c07882c8aa1983ab466e7cfa96", "srcset": "https://si.imgix.net/e3663b88/uploads/origins/2bbea6ba-97fb-49b7-a07c-d283f5bbfbaa?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5d3303c07882c8aa1983ab466e7cfa96, https://si.imgix.net/e3663b88/uploads/origins/2bbea6ba-97fb-49b7-a07c-d283f5bbfbaa?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b589ead243290581ae8ea09a8c19f22a 2x, https://si.imgix.net/e3663b88/uploads/origins/2bbea6ba-97fb-49b7-a07c-d283f5bbfbaa?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a9b1540e81a64cf032f7a0924a7b7ec1 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/e3663b88/uploads/origins/2bbea6ba-97fb-49b7-a07c-d283f5bbfbaa?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f002b6dbec11eced4a70e5b6e696a77d", "srcset": "https://si.imgix.net/e3663b88/uploads/origins/2bbea6ba-97fb-49b7-a07c-d283f5bbfbaa?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f002b6dbec11eced4a70e5b6e696a77d, https://si.imgix.net/e3663b88/uploads/origins/2bbea6ba-97fb-49b7-a07c-d283f5bbfbaa?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=b5160761b808b63aca5272175a660a71 2x, https://si.imgix.net/e3663b88/uploads/origins/2bbea6ba-97fb-49b7-a07c-d283f5bbfbaa?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=f4b1f62d9972bf66f077ec6d3ebc7388 3x"}, "body": "どうもこんにちは、初めて依頼させていただきます。\nうちの子のホルスタインメスケモを描いていただきたく存じます。\nうちの子の特徴ですが、以下の通りになります。\n\n・髪を後ろ一つで編んでいて前に垂らしている\n・服を脱いでるときや水着のときなどは髪を解いてることが多い\n・上の前歯はない（奥歯はある）\n・左目の下あたりにほくろがある\n・手の指は先端が蹄になっており、使える指が三本で、うち親指のようになってるのが一本、そして小指側に小さい蹄がある\n・足は牛の蹄のようで、二本の蹄で支えておりその後方に二本副蹄がある\n・尻尾の先は白色\n・乳房は毛が薄く薄いピンク色（血管がうっすら浮いてるとありがたい）\n\nリンク先にうちの子の資料を用意しましたので参照してください。\n服装やポーズ等についてはお任せしますが、服装についてはお腹が出ているような服装でお願いします（薄着の方がいいかも？）。\nよろしくお願いいたします。\n\nhttps://www.dropbox.com/s/zirypzhhepqzfdb/mikahoreference.zip?dl=0", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@nzuuure/works/12", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 23552, "client_id": 1048391, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/4d8282d9/uploads/origins/d2266af3-2607-4ecd-828a-96c78bc20c08?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=964caac4979dea44d1398944355f9c79", "srcset": "https://si.imgix.net/4d8282d9/uploads/origins/d2266af3-2607-4ecd-828a-96c78bc20c08?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=964caac4979dea44d1398944355f9c79, https://si.imgix.net/4d8282d9/uploads/origins/d2266af3-2607-4ecd-828a-96c78bc20c08?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e8f40873828354669884e5b2ca3cf4e9 2x, https://si.imgix.net/4d8282d9/uploads/origins/d2266af3-2607-4ecd-828a-96c78bc20c08?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f8d6f3d69ff3c7bd1e38f50f2ac3876e 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/4d8282d9/uploads/origins/d2266af3-2607