s://si.imgix.net/f95c2b89/uploads/origins/69928cf5-d54d-4f8e-b754-74014084d4f0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a336a51d871f3063eeec4b40ebf2a2ea", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/f95c2b89/uploads/origins/69928cf5-d54d-4f8e-b754-74014084d4f0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=34ab276228019e8abaae1de5f93b52f1", "src_set": ""}, "body": "参宝くん可愛すぎておねしょして欲しい（欲望）\n\nたまらん…あの性格超絶ちょうど良い…\n\n家賃の代わりに恥ずかしいことしてやりたい…\n\n参宝くんのふぇちい絵が描きたくて仕方ないんですけど\n\n私も作品発表時から気になっていたんですよね。。\n参宝くん可愛い…。まだめっちゃ序盤ですが久々に\nゲームも手を出してみまして、どのキャラも可愛い\nですが、参宝くんですね。浄飯さんも良いですが…\nやはり、参宝くんです…！\n\nというわけ（？）で、最近流行の丸投げ案件です。\nどうか欲望のままに筆を執っていただけますと…！", "nc": 56, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Satuki_rabbit/works/173", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/f75ad069/uploads/origins/faa646ed-416a-482e-bb80-474a2f7e76e1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=5ee0f2ba8dce116048ba9427709e5ac4", "src_set": ""}, "private": true, "genre": "art", "tipped": true, "creator_id": 462750, "client_id": 456596, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 177, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@Satuki_rabbit/works/172", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/b2aa1735/uploads/origins/3100faea-0103-4d67-881c-372d0c1c24ad?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=75db13f68160ec5db3602d20dbc6ba91", "src_set": ""}, "private": true, "genre": "art", "tipped": true, "creator_id": 462750, "client_id": 893818, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 176, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@Satuki_rabbit/works/171", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 462750, "client_id": 456596, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/3812578e/uploads/origins/5879dc34-87af-4408-aa29-a23bbb25dfed?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=917f68412d0da8dd4b0c77890b02c64d", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/3812578e/uploads/origins/5879dc34-87af-4408-aa29-a23bbb25dfed?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=4e24bd0512de66017fd812bf5807d79b", "src_set": ""}, "body": "親愛なる、皐月ウサギさま。\nりおると申します。いつもお世話に\nなっております。\n\n『落第』幼稚園のイラスト等、大変…\nお世話になりました。本当に、本当に\nありがとうございました！\n\n今回の依頼は、大人のレオンくんが\n失敗をする姿になりまして…。\n\n実は、小説を読んでいただいた方から\nいただいた感想の中に気になるものが\nありまして…。\n\n作中にタヌキ獣人の園児と並んでトイレで\n用を足すシーンがあるのですがその場面を\nイラストにしていただけないかと…！！\n\nその部分が良いと言っていただけたことと\nレオンくん大人姿の失敗シーンイラストが\nなかったなと…思いつつ、私も見たい！と\nなり、ご依頼を差し上げる流れに…。\n\n抜粋して書き出しますと…\n\n幼稚園のトイレ、立ちション用の壁に\n向かって大人姿のレオンくんと園児が\n並んで用を足している。\n\nレオンくんは立ちションをしていて\nおしっこを暴発させて壁を打つように\n発射してしまってる状態です。\n\nそれを並んで立ちションしてる男の子は\n「すげーっ！」っと目をキラキラさせて\n見ている状態になります。\n\nこの場面のレオンくんは少し小さめの黒い\nズボン（学ランの下）を穿いていて上着は\n私服になるかと思います。胸元が開いてる\nＹシャツのような気もするのですが…もし\n他に似合いそうなものがあれば、差し替え\nでも良いと思います…。私の服のセンスの\nなさがうらめしい…。一緒にいるタヌキの\n男の子はスモック姿で膝まで下着を降ろし\nてる小さい子がよくしている立ちションの\nスタイルですがタヌキの男の子については\nキラキラしている顔が画角に入っていれば\n全身でなくてもいいです。メインはやはり\n粗相をしてるレオンくんでお願いします！\n\nアングル等につきましては、ウサギ先生に\nお任せしたいと思います。その他の記述が\nない部分の表現についても、自由に表現を\nしていただけたらと思っています。\n\nご都合悪くなければ、ご検討いただければと\n思っています。何卒よろしくお願いいたします。", "nc": 184, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "similar_creators": [{"id": 23914, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "瀬井虎男", "screen_name": "seitora", "avatar_url": "https://pbs.twimg.com/profile_images/1966417082641428484/nHkzHElw.jpg", "header_url": "https://pbs.twimg.com/profile_banners/28040540/1757665342/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "skills": [{"genre": "art"}, {"genre": "correction"}], "nc": 176}, {"id": 38668, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "クルトガ@けもケ　A-26", "screen_name": "whity___paria", "avatar_url": "https://pbs.twimg.com/profile_images/1962109663572570112/kn_SnIW8.jpg", "header_url": "https://pbs.twimg.com/profile_banners/137005212/1699940402/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "skills": [{"genre": "art"}, {"genre": "comic"}], "nc": 32}, {"id": 77488, "creator": true, "nsfw_acceptable": true, "acceptable": false, "name": "うごうゴウ", "screen_name": "ugou", "avatar_url": "https://pbs.twimg.com/profile_images/1509902109482889286/uQN9KKIh.jpg", "header_url": "https://pbs.twimg.com/profile_banners/20214566/1488645814/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "skills": [{"genre": "art"}], "nc": 32}, {"id": 1876093, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "ばれる🔞", "screen_name": "RePLOT_MIDY", "avatar_url": "https://pbs.twimg.com/profile_images/1710547160037818368/D_bwqCCV.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1710545263939698688/1696661212/150