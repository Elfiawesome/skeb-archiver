のようにお願いします。-> https://ibb.co/sqq72hz\nエタニティラルバの下着色は平凡な白でお願いします。\n\n複数枚差分ごとにパンツの状態が現れるといいですね, \nそして複数枚差分をお願いしたく、それぞれの希望差分を書かせて頂きます。\n\n1. お茶をたくさん飲んだのでちょっとした尿意を感じ始めたエタニティラルバ, まだ我慢できるのか、もじもじしています\n\n2. 尿意が限界間近に迫り、大事なところをぎゅっと押さえ息を荒くしながら、\nがくがくと身体を震わせながら必死に我慢しています。\n\n3. ついに我慢しきれなくなったおしっこが、ショーツに少しずつ滲んでいきます。(服の表面にまではまだ濡れてない感じ）\n\n4. もう少しやらかしてしまい、今度はスカートまで濡れてしまいます。\n\n5. ついに気力が尽きてしまい、おもらしをしてしまいます。\n下着や服の股の中心部分を濡らしながら、我慢しきれなかったおしっこがあふれ出ています。\n\n加えて、ちょっとしたセリフもあったらいいなと思います。 \nどんなセリフを入れるかはお任せします。ありがとうございます！", "nc": 49, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@koizumo_/works/9", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/5d5329f0/uploads/origins/4ea809e1-d706-4c92-97ab-6400c7735041?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=f59144249cb43085ec7452aa08a67d3f", "src_set": ""}, "private": true, "genre": "art", "tipped": false, "creator_id": 463783, "client_id": 0, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 16, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@koizumo_/works/8", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 463783, "client_id": 148523, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/474855cd/uploads/origins/7bd57995-bbd0-4104-9d2b-e62333a2c3ba?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9cf0f19f42ad69dbd1814244636ca1aa", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/474855cd/uploads/origins/7bd57995-bbd0-4104-9d2b-e62333a2c3ba?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=45045f21a011443cd54bf7f5a8f97bfe",