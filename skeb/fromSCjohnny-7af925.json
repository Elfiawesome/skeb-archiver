e": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/cdc05230/uploads/origins/7a1b5bea-c91a-4274-bbe6-9d4775c12fe0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d9cb907e4d203ed11390eb4aafb52eb7", "srcset": "https://si.imgix.net/cdc05230/uploads/origins/7a1b5bea-c91a-4274-bbe6-9d4775c12fe0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d9cb907e4d203ed11390eb4aafb52eb7, https://si.imgix.net/cdc05230/uploads/origins/7a1b5bea-c91a-4274-bbe6-9d4775c12fe0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=0f26d794f1d359ff47394a1434900e47 2x, https://si.imgix.net/cdc05230/uploads/origins/7a1b5bea-c91a-4274-bbe6-9d4775c12fe0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=0a70ba3324402ddf06434946e086e5c8 3x"}, "body": "前回ありがとうございました。続きになりますが、再びリクエストを依頼させていただきたいと思います。\n\n■キャラ\n紅美鈴\n\n■シチュ\n睡姦がバレたショタが逆レイプされる\n\n■服装\n前回と同じチャイナ服の上のみ+帽子\n\n■内容\n組み伏せスパイダー騎乗位\n\n■補足・要望\n・美鈴お姉ちゃんに容赦なく犯される内容でお願いします。セリフ、オノマトペはお任せします。\n・ショタ主観、または美鈴正面の構図で結合部が見えるようお願いします。\n・挿入の導入から射精までお願いします。\n\n■内容に組み入れられるなら入れて欲しい内容(余裕がある場合のみ\n・目閉じながらのがっつきベロチュー表情\n・乳首舐めしながらの騎乗位\n・断面図、又はお尻からの結合部カット\n\n想像し難い部分に関しては全てお任せします。\n指定が複数ございますが、\nぜひご検討の程、よろしくお願いします。", "nc": 169, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@fromSCjohnny/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2715948, "client_id": 1233826, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/4263c518/uploads/origins/975da7bc-2bb8-4db9-b6ee-971146262ac7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f711d58fdfcdfb321842ac058a6be523", "srcset": "https://si.imgix.net/4263c518/uploads/origins/975da7bc-2bb8-4db9-b6ee-971146262ac7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f711d58fdfcdfb321842ac058a6be523, https://si.imgix.net/4263c518/uploads/origins/975da7bc-2bb8-4db9-b6ee-971146262ac7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=470ae273d07d3e43434638835e510242 2x, https://si.imgix.net/4263c518/uploads/origins/975da7bc-2bb8-4db9-b6ee-971146262ac7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=5c3c59bddc3b719c0435026b1b980cce 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/4263c518/uploads/origins/975da7bc-2bb8-4db9-b6ee-971146262ac7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=05075ed5e9e56bd487a10e10a859d2c8", "srcset": "https://si.imgix.net/4263c518/uploads/origins/975da7bc-2bb8-4db9-b6ee-971146262ac7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=05075ed5e9e56bd487a10e10a859d2c8, https://si.imgix.net/4263c518/uploads/origins/975da7bc-2bb8-4db9-b6ee-971146262ac7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=01ef54d0ea9c177507dc220d8919d16e 2x, https://si.imgix.net/4263c518/uploads/origins/975da7bc-2bb8-4db9-b6ee-971146262ac7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=8081de041ea9617f02cd15b8826ecb43 3x"}, "body": "じょにー先生はじめまして\n「アズールレーン」からおねショタイラストをリクエストしたいのですが可能でしょうか？\n\n・ヴォシーロフ（アズールレーン）とショタ指揮官のイチャイチャセックス\n\n・ヴォシーロフは通常衣装のレオタードとストッキングのみ(コート、腰布などは脱いだ状態)\nhttps://twitter.com/azurlane_staff/status/1637740902717468672\nhttps://azurlane.wikiru.jp/index.php?ヴォロシーロフ\n先生の描きやすいように細かい部分の省略、アレンジしてもらっても構いません\n\n・ショタ指揮官は顔（目元）を描いていただき、色白な美少年\n\n・体位は胸を揉みながらの正常位\n　ずらし挿入で胸がはだけた状態\n　お互い見つめあっている\n　ヴォシーロフが優位で顔をやや赤らめつつ、嬉しそう\n\n・効果音、お互いの喘ぎ声(んっ、あっ等)等の描写もお願いします\nその他、シチュエーションに合ったセリフがあると嬉しいですが、無しでも全然構いません\n\n・可能であれば、射精差分もお願いします\n\n以上になります\n先生のご都合がよろしければ、是非ともよろしくお願い致します", "nc": 56, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@fromSCjohnny/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2715948, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/1b93d3e1/uploads/origins/eb936ec0-0564-4cce-81f2-b3d6c7e67e0a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5de45465657ee1dba3b45c97110e296a", "srcset": "https://si.imgix.net/1b93d3e1/uploads/origins/eb936ec0-0564-4cce-81f2-b3d6c7e67e0a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5de45465657ee1dba3b45c97110e296a, https://si.imgix.net/1b93d3e1/uploads/origins/eb936ec0-0564-4cce-81f2-b3d6c7e67e0a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=9be2abcb2375dece73722085c54437bc 2x, https://si.imgix.net/1b93d3e1/uploads/origins/eb936ec0-0564-4cce-81f2-b3d6c7e67e0a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=20af8a866478c519cb78a04b5d1daf20 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/1b93d3e1/uploads/origins/eb936ec0-0564-4cce-81f2-b3d6c7e67e0a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=1a9fd3d804773d81704fa65c1fe452ea", "srcset": "https://si.imgix.net/1b93d3e1/uploads/origins/eb936ec0-0564-4cce-81f2-b3d6c7e67e0a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=1a9fd3d804773d81704fa65c1fe452ea, https://si.imgix.net/1b93d3e1/uploads/origins/eb936ec0-0564-4cce-81f2-b3d6c7e67e0a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=16e9615823f44aeff15d92ac40ec8c52 2x, https://si.imgix.net/1b93d3e1/uploads/origins/eb936ec0-0564-4cce-81f2-b3d6c7e67e0a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=db8efcbb7419e4a71a677b5e92dd37aa 3x"}, "body": "はじめてのリクエスト失礼します。\nあなたの『乳式ラブノーレッジ』が、ヒロイン4人全員が魅力的で好きです。\n特に冒頭の、火乃さんと水姫さんのキスシーンがお気に入りです。\n今回は、他2人のキスシーンも見たいと思い、依頼させていただきました。\n3ページ前後のモノクロ漫画形式でお願いしたいです。\n\n《キャラクター》\n・焔さん（攻め）\n・京香さん（受け）\n\n《内容》\n催眠を乱用して空君を独り占めしすぎた結果、しばらく立ち入り禁止になった京香さん。\n反省せずに忍び込みますが、それを予想して部屋で待っていた焔さんに捕まります。\nそして焔さんは京香さんを抱きしめ、「そんなに我慢できないならおばさんが相手してあげる」と、お仕置きとして本気のレズキス責めを開始します。\n\n唇を吸われ・舌を吸われ・唾液を啜られ・口の中を舐め回され・下唇をしゃぶられ…。\n焔さんの熟練のキステクにより、京香さんはキスだけで何回もイッてしまいます。\n最後に口元全体をバキュームキスで吸われ続け、京香さんは絶頂・気絶してしまいます。\n焔さんが唾液ブリッジと共に唇を離し、舌なめずりして終了です。\n\nキスシーンは2人の口元が見える構図で、キス音多めでお願いします。\n長くなってすみません。どうかよろしくお願いします。", "nc": 177, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@fromSCjohnny/works/3", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/0362f989/uploads/origins/c1fe50ed-68db-4fa1-9fa2-8bdcedc42079?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=48d4f51256db3eba902f2605f7d1b8a4", "srcset": "https://si.imgix.net/0362f989/uploads/origins/c1fe50ed-68db-4fa1-9fa2-8bdcedc42079?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=48d4f51256db3eba902f2605f7d1b8a4, https://si.imgix.net/0362f989/uploads/origins/c1fe50ed-68db-4fa1-9fa2-8bdcedc42079?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=b824a307f01e352648c4cf6d20684618 2x, https://si.imgix.net/0362f989/uploads/origins/c1fe50ed-68db-4fa1-9fa2-8bdcedc42079?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=06ccd7a4e4ffaf7a4a0911ae17545f21 3x"}, "private": true, "genre": "art", "tipped": true, "creator_id": 2715948, "client_id": 51540, "nc": 49}, {"path": "/@fromSCjohnny/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "cre