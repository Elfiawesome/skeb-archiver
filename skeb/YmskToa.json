eator_acceptable_same_genre": true}], "sent_works": [{"path": "/@Yuk1_08/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3779324, "client_id": 3714552, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/ad449299/uploads/origins/3baf706e-d32c-498d-8e08-6a5decb790d2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=59bca6735bac6f0a3dd5e3f6c4a0dd30", "srcset": "https://si.imgix.net/ad449299/uploads/origins/3baf706e-d32c-498d-8e08-6a5decb790d2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=59bca6735bac6f0a3dd5e3f6c4a0dd30, https://si.imgix.net/ad449299/uploads/origins/3baf706e-d32c-498d-8e08-6a5decb790d2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c3faa1542c01817f20d172883376b0f6 2x, https://si.imgix.net/ad449299/uploads/origins/3baf706e-d32c-498d-8e08-6a5decb790d2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=41a568806d5d05ce1b3a285d8fcec349 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/ad449299/uploads/origins/3baf706e-d32c-498d-8e08-6a5decb790d2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=401a9e65fa7d639d7ac917727946f381", "srcset": "https://si.imgix.net/ad449299/uploads/origins/3baf706e-d32c-498d-8e08-6a5decb790d2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=401a9e65fa7d639d7ac917727946f381, https://si.imgix.net/ad449299/uploads/origins/3baf706e-d32c-498d-8e08-6a5decb790d2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=a90ff3329fae70c27b89040ae6924b85 2x, https://si.imgix.net/ad449299/uploads/origins/3baf706e-d32c-498d-8e08-6a5decb790d2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=4983aec67ca81d664a31256cb64e833d 3x"}, "body": "透葉さま\n\nはじめまして。\nセルフ受肉VTuber準備中の 夢咲透彩 (ゆめさきとあ) と申します！\n創作することが大好きな電脳世界出身のアンドロイドVTuberです。\n\n新着クリエイターのページから透葉さまを見つけ、アイコンと投稿されているイラストと絵柄が大変気に入ったため、今回ぜひわたしの姿を描いていただきたくリクエストいたしました！\n\n\n【構図】\n\n・等身腿上～腰上くらい (金額で難しければ胸上でお願いします)\n・キュートさ・元気さを前面に押し出す感じ\n・可能であれば動きのある構図だと嬉しいです。\nふわっとしたイメージでごめんなさい...！\n\n┋詳しい構図はお任せします。\n┋上と左右が見切れない、背景とキャラクターと文字などが分離されたバージョンのPSDがあるとありがたいです。\n\n\n【使用用途】\n\n・YouTubeの配信 / 動画 / コミュニティ投稿のサムネイル\n・SNS (X(旧Twitter)､Misskey.io､Bluesky) への掲載\n・プロフィールサイト(Lit.link的なもの)への掲載\n\n┋今回のイラストについて、イラストを使用したグッズなど、YouTubeサムネイルの使用以外において収益が直接的に発生するものには今後も含め一切使用しません。\n┋YouTubeは現在収益化していませんが、今後収益化する可能性があります。\n┋その他で収益化コンテンツに使用したい際は、機会があれば別途個人でご依頼させていただこうと思います！窓口を設置いただけると大変うれしいです。\n\n\n【その他のお願い】\n\n・キャラクター/背景/テキスト等の分離がされたPSDもしくは各PNG画像ファイルがあればありがたいです。\n・イラストには文字入れや素材と重ねるなどの軽微な加工をすることがあります。\n・背景について。よろしければある程度描きこみはある方が嬉しいですが、難しければ簡易背景でも構いません！\n・上と左右が見切れていないファイルがあると、サムネイル等に使用しやすくてとても助かります！\n\n・イメージしている透葉さまのイラスト\nhttps://x.com/Yuk1_08/status/1931155673657819366\n\n\n【最後に】\n金額に見合わない内容であれば遠慮せずキャンセルしてください！\n現在はやや余裕がないため、またの機会にお願いしようと思います！\n\nhttps://ymsktoa-vcreator.notion.site/Skeb-28e5d0293c4880c59e4cfeba8dc4958e", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@neko4ta/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3670203, "client_id": 3714552, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/1f4eaa14/uploads/origins/813228e1-b879-41d5-aa98-54e613184af3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b72636262aa390d39bdc425325360e54", "srcset": "https://si.imgix.net/1f4eaa14/uploads/origins/813228e1-b879-41d5-aa98-54e613184af3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b72636262aa390d39bdc425325360e54, https://si.imgix.net/1f4eaa14/uploads/origins/813228e1-b879-41d5-aa98-54e613184af3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=03c96518f9faf61dd4f4e508e866c1d6