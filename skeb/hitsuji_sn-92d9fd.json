mgix.net/cd590d98/uploads/origins/6c7578d1-2926-468c-bab1-2aeaf007b090?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=772e7c601e1a8e134110d0cf8d45ce05 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/cd590d98/uploads/origins/6c7578d1-2926-468c-bab1-2aeaf007b090?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e2a3775ba7fdee317082ed9864073fec", "srcset": "https://si.imgix.net/cd590d98/uploads/origins/6c7578d1-2926-468c-bab1-2aeaf007b090?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e2a3775ba7fdee317082ed9864073fec, https://si.imgix.net/cd590d98/uploads/origins/6c7578d1-2926-468c-bab1-2aeaf007b090?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=43e7e774993d280599c7cf44c5d961f6 2x, https://si.imgix.net/cd590d98/uploads/origins/6c7578d1-2926-468c-bab1-2aeaf007b090?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=ccb26679d918b9b8eaeed00c26c47049 3x"}, "body": "真夜中のヨーロッパの街で妖精のニンフとデートする話を書いてます。主人公は18歳の掃除夫でイメージはエディ・レッドメイン（俳優）です。物語ではニンフが噴水の彫刻になって石に閉じ込められています。彼女は魔法のネックレスを手渡されたときだけ、その持ち主の願いを叶える代わりに6時間だけ自由になれます。主人公はある女の子に恋をしていてそのネックレスを使ってデートするお金を出してもらうようにニンフに頼みます。それでその願いを聞く前に、ニンフが予行練習といって彼をデートに誘うのです。そのデートをしていくうちにそのニンフの真意やネックレスの正体、そして街の言い伝えの謎を解いていく…というストーリーです。\n主人公を描いて頂きたく思っています。主人公はお金に頓着がなくお人好しですが頭は悪くありません。ただ社交的ではなく、周りに馴染みにくい性格です。繊細なところがあり、いつも相手に向き合おうとする純朴さがあります。その純朴なところに女の子たちが惹かれるような展開なのでその魅力を出していただけると嬉しいです。格好は舞台が1900年初頭なので白シャツにベストもしくはサスペンダーをしている…となんとなく思ってます。（曖昧ですみません）\n女の子の手を取って、優しい表情でその手にネックレスを渡すポーズだと嬉しいです。\n絵柄はタロットの絵に寄せていただきたいです\n髪の毛は茶髪で目の色は薄い青です。\nネックレスは金色の台座にラピスラズリがはめ込まれていて、チェーンも金色です。\nよろしくお願いします", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@hitsuji_sn/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3234132, "client_id": 2369791, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/2bfb3b68/uploads/origins/abd327e6-fb03-4531-99ce-e137dfbd01e8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2d55d182c3a41a784f306394c8140862", "srcset": "https://si.imgix.net/2bfb3b68/uploads/origins/abd327e6-fb03-4531-99ce-e137dfbd01e8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2d55d182c3a41a784f306394c8140862, https://si.imgix.net/2bfb3b68/uploads/origins/abd327e6-fb03-4531-99ce-e137dfbd01e8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a1dd7b16758ec2f0df39a3e059f8a015 2x, https://si.imgix.net/2bfb3b68/uploads/origins/abd327e6-fb03-4531-99ce-e137dfbd01e8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f9af939b7679583586248bbefbc24791 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/2bfb3b68/uploads/origins/abd327e6-fb03-4531-99ce-e137dfbd01e8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=11d7df5323561e20439b79f796261f66", "srcset": "https://si.imgix.net/2bfb3b68/uploads/origins/abd327e6-fb03-4531-99ce-e137dfbd01e8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=11d7df5323561e20439b79f796261f66, https://si.imgix.net/2bfb3b68/uploads/origins/abd327e6-fb03-4531-99ce-e137dfbd01e8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=1c8547a9648592dbf98a63cdf17dca0d 2x, https://si.imgix.net/2bfb3b68/uploads/origins/abd327e6-fb03-4531-99ce-e137dfbd01e8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=968ccbf5e1d39926d2fcea3da604fcf4 3x"}, "body": "初めまして。リンリンと申します～\n佐野羊様のイラストが好きで素敵だと思いました！\nイラストをお願いできれば幸いです。\n\nポーズ・構図等はお任せいたします！必要に応じて、服や髪も変更できも良い～　٩(*•͈ ꇴ •͈*)و ̑̑\nカリスマ性のあるまたはお姉さんっぽい色気が出るような雰囲気だと嬉しいです。\nできればイラスト内にあやとり要素も入れてほしいです。\n\n人物と背景別レイヤーのPSDファイルも頂くことは可能でしょうか。\n\n使用した際は佐野羊様のツイッターの方を引用させていただきます。\nご検討の程何卒よろしくお願いいたします。\n\nhttps://drive.google.com/drive/u/1/folders/1JZ7B-aP9tYKS2AEJbeBUt7dGeWpzu0TM\n\nhttps://drive.google.com/drive/u/1/folders/1JZ7B-aP9tYKS2AEJbeBUt7dGeWpzu0TM", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@hitsuji_sn/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3234132, "client_id": 2634693, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/073f8642/uploads/origins/72c759c4-1c26-40f9-94a7-ae12c892f7d4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ca7092319374f4b1a86ec0963bcbd57f", "srcset": "https://si.imgix.net/073f8642/uploads/origins/72c759c4-1c26-40f9-94a7-ae12c892f7d4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ca7092319374f4b1a86ec0963bcbd57f, https://si.imgix.net/073f8642/uploads/origins/72c759c4-1c26-40f9-94a7-ae12c892f7d4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=8a672ca046bf5a76a85e67271b799ea1 2x, https://si.imgix.net/073f8642/uploads/origins/72c759c4-1c26-40f9-94a7-ae12c892f7d4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=48c8bddd4b44892ed1f297fa7ab6777b 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/073f8642/uploads/origins/72c759c4-1c26-40f9-94a7-ae12c892f7d4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=1e2344f00916ca8bd6847cdb0b16e2f9", "srcset": "https://si.imgix.net/073f8642/uploads/origins/72c759c4-1c26-40f9-94a7-ae12c892f7d4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=1e2344f00916ca8bd6847cdb0b16e2f9, https://si.imgix.net/073f8642/uploads/origins/72c759c4-1c26-40f9-94a7-ae12c892f7d4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=0c6302e24b1464883e6605f73c706043 2x, https://si.imgix.net/073f8642/uploads/origins/72c759c4-1c26-40f9-94a7-ae12c892f7d4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=fb96803049cabc246b90c47170a0e5f8 3x"}, "body": "またまた先生！こんにちは！この二人のキャラクターを描いていただけませんか？］\n\n1.シリカ【177cm、46歳\nシリカは戦士の女王です。威厳があり、力強く、自惚れが強い。常に自分の思い通りにすることに慣れていて、権力に酔っている。シリカは今にも襲いかかろうとする蛇のようで、危険だが落ち着いている。何があっても人や物を支配し、所有したいという欲求がある。彼女は反抗的な精神で成長し、力への飽くなき渇望を持っている。金色のアイシャドーを施した蛇のような瞳にご注目！普段は半眼である。\n\nモチーフ：金色の蛇、砕けた鏡、爪、繊細な剣とレイピア、騎士、ステンドグラス、首輪の手！！献身的なものなら何でも...（彼女にとっては！）。\n\n2.インナ【177センチ、45歳\n鳥とともに戦う戦士。多くの弟子を持ち、恐ろしい鳥の武器庫を指揮する（主な鳥のパートナーはイヌワシ）。鷹のように冷徹でストイック。過激で偏執的、そして頑固な女性。シリカとの戦争で失った人々の亡霊に負い目を感じている。イナは驚くほど厳格で、威厳があり、厳格で、プライドが高い。彼女が微笑むとき、その微笑みはしばしば険しいと形容される。\n\nモチーフ：ハゲワシ／タカ、草原と青い空、帰郷、オデッセイ、旅、猛禽類、黒い刃、黒い毛皮と血まみれの羽を持つ手\n\nあるタイムラインでは恋人同士になれるが、どのタイムラインでも互いに敵対して戦ってきた。彼女たちのダイナミズムは押し合いへし合いであり、まるで2匹の肉食獣が互いの周囲を取り囲んでいるようだ。生涯同じ空間にいながら、お互いを憎み、殺そうとすることしかしてこなかった2人の女性。\n\n彼女たちの年老いた姿でも、若い頃（20代半ば）の姿でも、自由に描いてください！ギクシャクした恋人同士でも、憎み合わずにはいられない敵同士でも構いません。衣装の変更も大歓迎です。］\n\nhttps://drive.google.com/drive/folders/1E0ZclVNuqmu7Zo0_BBNLjDOv3DVZO3XJ?usp=sharing", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@hitsuji_sn/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3234132, "client_id": 82293, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/65d7181c/uploads/origins/9d42e630-5225-49b3-b795-fe4ac072fbd6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f5e9fa6dc0439bba3a9a6eb7b590782f", "srcset": "https://si.imgix.net/65d7181c/uploads/origins/9d42e630-5225-49b3-b795-fe4ac072fbd6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f5e9fa6dc0439bba3a9a6eb7b590782f, https://si.imgix.net/65d7181c/uploads/origins/9d42e630-5225-49b3-b795-fe4ac072fbd6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w