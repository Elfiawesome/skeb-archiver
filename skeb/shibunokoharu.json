200&blur=200&s=d6fc50818b5f36298c5210e8d99c7a86 3x"}, "body": "はじめまして、個人Vtuberのらきあすと申します。Xで澁ノ小春先生のイラスト\nを拝見し、ぜひ私も描いて頂きたいと思いリクエストさせて頂きました！\n\n[使用用途] Xのポストや配信待機画面などのSNS運用等で使用させていただきたいです。その為、許可をいただける場合、承認をしていただければと思います。 また、可能であれば背景、サインを透過した人物だけの差分も頂きたいです。\n[キャラクター]\nらきあす (Vtuber)\n服装・容姿はドライブを確認お願い致します 三面図はため見えない部分はご想像におまかせしますします\n[構図]\n構図、雰囲気全ておまかせ致します！\n服装なども変えて大丈夫です！\n[サイズ]特に指定ありません\nskeb依頼が初めてため無作法がありましたら申し訳ございません💦\nよろしくお願いいたします！\n\nhttps://drive.google.com/drive/folders/1VipvzehllJWLKgqdefr00I7hZYGzL8Nq", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@shibunokoharu/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3869716, "client_id": 3239524, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/aa73d309/uploads/origins/6b3088cd-fa13-4d5a-a3a5-2c29672f4c0f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5272a1e49e433a32e9ca6d0c8f8f040d", "srcset": "https://si.imgix.net/aa73d309/uploads/origins/6b3088cd-fa13-4d5a-a3a5-2c29672f4c0f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5272a1e49e433a32e9ca6d0c8f8f040d, https://si.imgix.net/aa73d309/uploads/origins/6b3088cd-fa13-4d5a-a3a5-2c29672f4c0f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=0ceb711703cb6e78c33ef1720a9ca809 2x, https://si.imgix.net/aa73d309/uploads/origins/6b3088cd-fa13-4d5a-a3a5-2c29672f4c0f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ee1d59a281c07d5dfc5c7d0ec13604a9 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/aa73d309/uploads/origins/6b3088cd-fa13-4d5a-a3a5-2c29672f4c0f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f89ffbe0653e74f546ee2592063ae648", "srcset": "https://si.imgix.net/aa73d309/uploads/origins/6b3088cd-fa13-4d5a-a3a5-2c29672f4c