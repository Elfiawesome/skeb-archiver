t=crop&crop=top&w=200&h=200&blur=200&s=8a5c7b2b274621132b4fff3ea63b8916", "srcset": "https://si.imgix.net/2c3b770e/uploads/origins/877debe1-47cc-400b-bf93-421b649710ac?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=8a5c7b2b274621132b4fff3ea63b8916, https://si.imgix.net/2c3b770e/uploads/origins/877debe1-47cc-400b-bf93-421b649710ac?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=2c54e7bf6fea8142c6649f0f14ba5fdc 2x, https://si.imgix.net/2c3b770e/uploads/origins/877debe1-47cc-400b-bf93-421b649710ac?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=71c0a8792bd501929ae2ae46e44b8784 3x"}, "body": "Hello Elm snow, thank you very much for your wonderful bunny girl illustration last time!\nI would like to ask you to illustrate Rino Hyohana, an individual vtuber, this time as well.\nI would like to see her in a yukata (summer kimono).\nIf possible, I'd like to see her and Yukino enjoying the summer festival.\nIf you have a background, I would appreciate it if you could separate the layers and give me a PSD of the background.\nHow we can use it\nI would appreciate it if you could give me permission to use it for commercial purposes such as uploading to social networking sites, YouTube thumbnails that are monetized only by the artist, and merchandise.\nWe would appreciate it if you could indicate in a separate layer where it is difficult to do so.\nWe wish you the best of luck!", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@elmsnow/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3209918, "client_id": 3275704, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/2dd264bf/uploads/origins/d354244f-ec35-4b64-bfb2-57b0254070fb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=cad0ef8633626576d5da1cebe3e8d391", "s