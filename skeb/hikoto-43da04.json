fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=32364c4669f6bf5785fc0a8e5d292c14 3x"}, "body": "こんばんは。再びのリクエストをさせていただきます。\n都合や内容が合わなければキャンセルしてください。\n\nリクエストの内容としましては\n・私のオリジナルキャラクターである｢いちごちゃん｣のNSFWなイラスト\nキャラクター参照URL:https://www.pixiv.net/artworks/113721204\n(わからない部分など解釈による変更、アレンジの問題はありません)\n\n・シチュエーション:岩陰やシャワー室など、海でデート中、後にこっそりとHする。\n\n・髪型、服装:参照URLを参考にしてほしいです。\n参照URL:https://misskey.io/notes/a8gvrlbeheuh00ur\n(わからない部分など解釈による変更、アレンジの問題はありません)\n\n・私の好みについてのチェックシートがあるのでよければ参照ください。\nURL:https://misskey.io/notes/9xczy5yst6c4068o", "nc": 43, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@hikoto/works/8", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3184646, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/8c2338fa/uploads/origins/12c01ce6-6a1f-473b-b888-e1b173f38662?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=03f71eb6ea06c7f596ff073694320c20", "srcset": "https://si.imgix.net/8c2338fa/uploads/origins/12c01ce6-6a1f-473b-b888-e1b173f38662?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=03f71eb6ea06c7f596ff073694320c20, https://si.imgix.net/8c2338fa/uploads/origins/12c01ce6-6a1f-473b-b888-e1b173f38662?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=7ace8d041063313010255114d745993f 2x, https://si.imgix.net/8c2338fa/uploads/origins/12c01ce6-6a1f-473b-b888-e1b173f38662?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e365e6137193d8fc141b3bd16720e878 3x"}, "duration": null, "nsfw": true, "hardcore": true, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/8c2338fa/uploads/origins/12c01ce6-6a1f-473b-b888-e1b173f38662?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3344bcccd06d55510b0c8b6974d5ff0a", "srcset": "https://si.imgix.net/8c2338fa/uploads/origins/12c01ce6-6a1f-473b-b888-e1b173f38662?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3344bcccd06d55510b0c8b6974d5ff0a, https://si.imgix.net/8c2338fa/uploads/origins/12c01ce6-6a1f-473b-b888-e1b173f38662?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=52ef7b81fd702ebd77ed7b213bd37bb9 2x, https://si.imgix.net/8c2338fa/uploads/origins/12c01ce6-6a1f-473b-b888-e1b173f38662?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=e4c52685b53ec631e62f06a24b96915c 3x"}, "body": "リクエストさせていただきます。\nご検討のほど、よろしくお願いいたします。\n\nキャラクター\n三ノ輪銀（鷲尾須美は勇者である）\n\nシチュエーション\nこちら（ https://www.pixiv.net/artworks/118872297 ）のように、仰向けで押し倒されている構図で\n「ロリコンの男（モブ）に誘拐され、見知らぬ部屋のベッドの上でレ〇プされてしまう三ノ輪銀」をお願いします。\n\n描いていただきたいシーンにつきましては、\n\n①\nズボン・パンツを脱がされ、上着もたくし上げられて、胸やおまんこが丸見えの状態の銀。\n恐怖で涙目になりながらも、銀はこちらを睨んでいる。\n\n②（差分1）\n銀のおまんこに挿入する男。\n処女喪失の痛みで顔を歪め、嫌がっている銀。\n\n※この時、こちら（ https://www.pixiv.net/artworks/59185746 ）と同様に、銀は「どちらかの手で、男の挿入を制止しようとしている」ようにお願いします。\n\n③（差分2）\n抵抗虚しく、中出しされてしまう銀。\n中に出された恐怖で、銀は顔面蒼白になっている。\n\n④（差分3）\n事後。\n男はいなくなり、ベッドの上でそのまま放置される銀。\nおまんこからは精液（破瓜の血混じり）が溢れ、銀のお腹や胸などにも精子がぶっかけられている。\n\n※この時、こちら（ https://www.pixiv.net/artworks/112382066 ）と同様に、銀の表情は「目を両手で覆い、歯を食いしばりながら泣いている」ようにお願いします。\n\n…といった感じで、それぞれお手数をおかけしますがお願いします。\n\n\n銀の服装（私服）については、下記URLをご参照ください。\n※なお「髪型・髪飾り」については、そのまま（着用）でお願いします。\n\nまた、銀の胸のサイズは「つるぺた」もしくは「ちっぱい」。\nおまんこは「無毛」でお願いします。\n\n\nキャラクター参照\nhttps://yuyuyu.tv/washio/character/img/chara_gin_natsu.png\n\n服装（私服）参照\nhttps://img.atwiki.jp/yyyigame/attach/14/21/minowaginSR01.png\nhttps://img.atwiki.jp/yyyigame/attach/14/578/minowaginSSR06a.png", "nc": 59, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@hikoto/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3184646, "client_id": 2668955, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/7dc03a20/uploads/origins/762cd77d-fee7-45b3-bb72-55b4f3fcedf9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a12ddae49fc5fcd0d8170334a7d620ed", "srcset": "https://si.imgix.net/7dc03a20/uploads/origins/762cd77d-fee7-45b3-bb72-55b4f3fcedf9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a12ddae49fc5fcd0d8170334a7d620ed, https://si.imgix.net/7dc03a20/uploads/origins/762cd77d-fee7-45b3-bb72-55b4f3fcedf9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=1794adf559827e5c625a725a8c567a1f 2x, https://si.imgix.net/7dc03a20/uploads/origins/762cd77d-fee7-45b3-bb72-55b4f3fcedf9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=1149783a626eb398574c4e838b71438e 3x"}, "duration": null, "nsfw": true, "hardcore": true, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/7dc03a20/uploads/origins/762cd77d-fee7-45b3-bb72-55b4f3fcedf9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=99fa96608602793d9cc59f627c0df9b0", "srcset": "https://si.imgix.net/7dc03a20/uploads/origins/762cd77d-fee7-45b3-bb72-55b4f3fcedf9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=99fa96608602793d9cc59f627c0df9b0, https://si.imgix.net/7dc03a20/uploads/origins/762cd77d-fee7-45b3-bb72-55b4f3fcedf9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=67efd21505de61ccbe6dadefff71643b 2x, https://si.imgix.net/7dc03a20/uploads/origins/762cd77d-fee7-45b3-bb72-55b4f3fcedf9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=9d65d0fb39db53ecffd15b475aae3b4a 3x"}, "body": "こんにちは。つるぺたな女の子が独房のような拘束部屋で裸にされ両腕を鎖に繋がれて膝立ちの姿勢を強いられ、中指を挿入されているところのイラストをお願いします。\n\n女の子\n服装：全裸\n髪：こげ茶色の髪、ショートカット\n肌：日焼けしてない色白、殴打とか傷跡はない\n体つき：胸はまだ膨らんでいなく真っ平、陰毛はまだ生えてない\n目つき：茶色い瞳\n表情：赤面して恥ずかしがる\n\n背景:鎖手錠(鉄枷)が壁から吊り下がった薄暗い独房のような拘束部屋\n壁は黒に近いグレー。\n左右の幅は2ｍくらい\n\n姿勢\n両腕:手首は頭より高い位置に後背の壁から吊り下がった鎖手錠をはめられてバンザイのように強いられる。両手の指はグーッと握らず外向きでダランとする。\n両足:膝立ちの姿勢を強いられる(膝から下が床に接触する)。両膝の間は40cmくらい広げ、両足首の間は50cmくらい広げる(膝から下がハの字になる)。足の甲は床に接触する。膝から下の足首くらいに床の金具で固定する。\n膝から上の胴体は垂直になるようにする(前後に傾かない)。\n\nアングル:拘束されて膝立ちの姿勢を強いられた女の子を真っ正面から向き合う(両腕と両足ははみ出さないようお願いします)。上端は後背の壁にある鎖を吊り下げる金具を、左右に壁が見えるようお願いします。\n\n補足図\nhttps://dl.hstorage.io/20240627064457_6d634d55.jpg\n\nプレイ\n責め役は手腕のみの描写とする\n責め役の右手の中指を女の子の膣内に挿入する。\nこのとき責め役の右手は手のひらをこちらに向けるようにする。\n\n以上よろしくお願いします。\n\nhttps://dl.hstorage.io/20240627064457_6d634d55.jpg", "nc": 186, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@hikoto/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3184646, "client_id": 2116662, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/ff26619c/uploads/origins/10c2ad29-b903-4e15-a20a-eb045e88888e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3e70613255c3f915bb13a43d0f677352", "srcset": "https://si.imgix.net/ff26619c/uploads/origins/10c2ad29-b903-4e15-a20a-eb045e88888e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3e70613255c3f915bb13a43d0f677352, https://si.imgix.net/ff26619c/uploads/origins/10c2ad29-b903-4e15-a20a-eb045e88888e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=d6777fb7096659ebe2ba5382edce92bd 2x, https://si.imgix.net/ff26619c/uploads/origins/10c2ad29-b903-4e15-a20a-eb045e88888e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=91286cf2753ab454ba93de5217a37392 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/ff26619c/uploads/origins/10c2ad29-b903-4e15-a20a-eb045e88888e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=8768f6d2427f3fe5f604c6334793d8de", "srcset": "https://si.imgix.net/ff26619c/uploads/origins/10c2ad29-b903-4e15-a20a-eb045e88888e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=8768f6d