bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3207f264e960c161d8c0a12b1112b0b2, https://si.imgix.net/5ee2d5d4/uploads/origins/ff2ef6eb-2e6e-41de-bee2-a82fe82235c0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=70c8e950ef222d4935d358d2319bcb67 2x, https://si.imgix.net/5ee2d5d4/uploads/origins/ff2ef6eb-2e6e-41de-bee2-a82fe82235c0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=a2ddec72ec371a3f1e5f7a18df0a0717 3x"}, "body": "はじめまして。偶然見た貴方の絵が線の先まで綺麗な曲線で見惚れてしまいました。\n髪の動きだけでなく細かく描きこまれた艶の表現にグラデーションによる色の変化も綺麗ですし、衣装の描き込みや難しい指の描き方も上手に描けてるなと思いました。\n\nウェディングドレスが好きなので、青い髪の長髪の女性でウェディングドレス姿のバストアップ絵をリクエストさせて頂きたいです。是非ともサンプルに使ってください。\n素敵な絵を描く貴方の助けになれば幸いです。よろしくお願い致します。", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@yeog1_/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3642739, "client_id": 3834277, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/f2c22e48/uploads/origins/6e7da039-294a-4170-b3a1-702ccd01f6e1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2775de3c5ee2b56cc54c0a1091b4bf6a", "srcset": "https://si.imgix.net/f2c22e48/uploads/origins/6e7da039-294a-4170-b3a1-702ccd01f6e1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2775de3c5ee2b56cc54c0a1091b4bf6a, https://si.imgix.net/f2c22e48/uploads/origins/6e7da039-294a-4170-b3a1-702ccd01f6e1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=2b4e0ae95a86b07c92a3781d522ecd04 2x, https://si.imgix.net/f2c22e48/uploads/origins/6e7da039-294a-4170-b3a1-702ccd01f6e1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=47b5d1a31968cf983cca1b81e0dcb603 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/f2c22e48/up