ン」を用意していただけると嬉しいです！瞳の液体ハートはあなたのスタイルに合わせてアレンジしてください。\n\n素足で優雅かつ繊細に踊る姿を表現し、無垢で優しい表情が伝わり、穏やかでありながら膨大な魔力を上手く表現し、腰の適度な部分を見せる構図がデザインできれば本当に可愛いです。よく見るとパンティを履いていないことに気づくかもしれない、そんな絶妙なバランスをお願いします。よろしくお願いいたします！\n\nhttps://cdn.rue.moe/rue-ref-v1.4.1.png", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@kisaragi_byakko/works/2", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/78fed19d/uploads/origins/af8c8422-cadf-431a-a499-007bee31b147?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=9fa25368b722265a703e149b516ad4f3", "srcset": "https://si.imgix.net/78fed19d/uploads/origins/af8c8422-cadf-431a-a499-007bee31b147?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=9fa25368b722265a703e149b516ad4f3, https://si.imgix.net/78fed19d/uploads/origins/af8c8422-cadf-431a-a499-007bee31b147?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=9ce7144dd6c2d615c86194118ecdd9fb 2x, https://si.imgix.net/78fed19d/uploads/origins/af8c8422-cadf-431a-a499-007bee31b147?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=6e2314e77cad1c10673113fb0c10cf25 3x"}, "private": true, "genre": "art", "tipped": false, "creator_id": 3881647, "client_id": 3762229, "nc": 128}, {"path": "/@kisaragi_byakko/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3881647, "client_id": 377196, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/75a9b442/uploads/origins/4f4616e5-8fdd-49e7-ba53-27cecc5686c6?bg=%23fff&a