ipped": true, "creator_id": 452447, "client_id": 1300586, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 177, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@kamokatatsumuri/works/19", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/a0918c28/uploads/origins/aefeb6e5-cbf9-420e-adf5-d067bfe2bd96?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=53abdbf6d80186a722c62985e40e4e3d", "src_set": ""}, "private": true, "genre": "art", "tipped": true, "creator_id": 452447, "client_id": 201181, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 33, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@kamokatatsumuri/works/18", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 452447, "client_id": 1980630, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/fe7d4f69/uploads/origins/32ab9f15-e1e9-433e-b82a-54dcb0e5d83c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=08560ed87416b1697f70e15a6e372412", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/fe7d4f69/uploads/origins/32ab9f15-e1e9-433e-b82a-54dcb0e5d83c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6199978b9530722242c55ce614ff8c07", "src_set": ""}, "body": "こんにちは。  私はあなたの作品が大好きです。\n\n私のキャラクターをここに描いてほしいのですが、https://imgur.com/a/yC5w3xy。\n彼女は裸でベッドの端に座り、フタナリチンポを出しているはずです。\n彼女はとても大きな胸と大きなペニス、そしてぷっくりとしたタマを持っているはずです。\n片方の手でチンコを持ち、もう片方の手で乳房を触っているはずです。\n彼女は自分のペニスを見下ろしながら、興奮した表情をしているはずです。\n\n可能であれば、大きな射精の2枚目の画像もお願いします。\n\nお忙しい中、ありがとうございました。", "nc": 177, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@kamokatatsumuri/works/17", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 452447, "client_id": 1300586, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/45392a97/uploads/origins/239fae00-5720-4914-88b7-c11f09a70761?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a169d973d5155c387fec1d67114ef879", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/45392a97/uploads/origins/239fae00-5720-4914-88b7-c11f09a70761?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f3775a607b023742eb7c23e3171c2788", "src_set": ""}, "body": "お久しぶりです。以前リクエスト絵がとてもエロくもう一度リピートをしたくてリクエストをお願いしたりです。こちらは少しリクエスト変えてます。\n今回は友人と自キャラでのゴム射精+アナルゼリーをお願いしたいです。\n身体つきは以前と同じで\nふたちんぽ（玉つきで玉と竿の大きさは竿はそちらがいつも書かれてる巨根より一回り大きめ、玉袋は二回り大きめのソフトボールほどを希望ですが、書きにくければ竿も玉も書きやすい巨根巨玉でお願いします。）をレオタードのちんぽ出す為の穴から丸出し（あるいはずらして丸出し）にして、コンドーム（既にゴムの中で射精済みでソフトボール～サッカーボールぐらいの大きさに膨らんでる状態）つけてる状態でお願いしたりです。お尻や胸はＳSよりも垂れない張り具合で一回りか二回り程大きくしても大丈夫です。（もし服を透けさせるのでしたら乳首と乳輪は少し小さめな感じで。）\n使用済みのゴムやザーメンゴム風船（水風船みたいなの）を自分の服に挟んでいたりする感じでお願いしたいです。\n\n\n自キャラ　https://gyazo.com/5121e2fe4f4047f2162132ed62605b0c\n友人　https://gyazo.com/5f14412b5238848c633c805fd7873194\n\n自キャラ友人の並びは此方の作品（https://katatsumurikissa.fanbox.cc/posts/5067931）を左右反転対象（向きはお任せします）になるようにお願いしたいです。\nできるのであれば差分は資料と同じ感じで（男の竿は無しで）、それと一緒に地面に2人そろってアナルゼリーをたっぷりひり出しちゃってください。出した後はコンドームの中に出した大量の精液風船が重みで引っ張られてどっぷんといった感じになっている感じでお願いしたいです。\n\n例のごとくマニアックかつ要望の多いリクエストですが、ご一考してくれると嬉しいです。\n\nhttps://katatsumurikissa.fanbox.cc/posts/5067931", "nc": 176, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@kamokatatsumuri/works/16", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 452447, "client_id": 0, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/d5095966/uploads/origins/a63c5d7f-35e6-47f6-a9d2-c4257ee84439?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=881dd5dff6272d5a81270d3818e1941c", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/d5095966/uploads/origins/a63c5d7f-35e6-47f6-a9d2-c4257ee84439?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9c591652b6c190621c16f65ddbb372a4", "src_set": ""}, "body": "遊戯王OCGの風霊使いウィンのイラストをお願いします。\nウィンはエロ蹲踞ポーズ、左右に男性が横向きで立っている状態（チンポだけでも大丈夫です）で、ウィンの顔の横くらいにチンポがある感じで、チンポは長めでお願いします。ウィンの表情は以前描いていたパープルシスターのように舌を出して欲しがっているような表情で両手はピースしている、服は着たまま（上着は無し）でパンツが見えている状態、パンツの色は白でお願いします！", "nc": 33, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@kamokatatsumuri/works/15", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 452447, "client_id": 0, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/12547f83/uploads/origins/34dda7e6-ea87-494a-b225-de18ef081ca3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=31bfef63d60bc478ec773a5247d10c35", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/12547f83/uploads/origins/34dda7e6-ea87-494a-b225-de18ef081ca3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3e23250dc2afc0c1418117a8f270b674", "src_set": ""}, "body": "こんにちわ。\n以前のノワールはとても良い物を納品して頂き、ありがとうございました！\n今回はPSO２シリーズからジェネをお願いしたいです。\n今回もふたなりで真性包茎と巨玉をお願いいたします。\n\n構図は真正面からで、気を付けしたように脚は閉じて立ってほしいです。\n（丁度こんな感じです→https://www.pixiv.net/artworks/101888084）\n閉じた脚から竿と玉はこちら側に張りだしていて、視点から見える様にして下さい。\n竿は勃起し、上向きの斜め。玉はぷっくりと大きくおねがいします。\n片方の手で竿の中央位を２～３本の指で摘まんで、鈴口をこちらに向ける様にして下さい。\nもう片方の手は口元に宛がったり、耳元の髪を描き上げる等、照れ隠しで落ち着かない様子にして下さい。\n表情は恥ずかしがっている様子か、ニヤリと目を細めて加虐心が見える表情のどちらかが欲しいです。\nジェネは裸で、ムチムチの巨乳だと嬉しいです。\n\n差分\n今回は条件が条件なので、出来ればで結構です。\n①上記\n②包茎を向き、露になった亀頭とたっぷりのチンカスと湯気\n（表情が恥ずかしがっている場合は視線を泳がせたり、不安そうにこちらを見つめたりさせて下さい。）\n（加虐的な表情の場合はﾆﾋﾋ顔で汗を追加して内心ドキドキな感じを表現して下さい。）\n③アヘ顔で射精。トロトロ垂れるトコロテン射精でも良いです。\n④たっぷりと出され、水風船の様に大きく膨らんだコンドームが竿から垂れさがっている。\n\n差分は順序通りにして頂かなくても結構です。\nまた①以外はどれか気に入ったものだけでも結構です。\n宜しければお願いいたします。", "nc": 161, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@kamokatatsumuri/works/14", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 452447, "client_id": 0, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/1246c074/uploads/origins/96a163f5-bfeb-4d10-ba97-676b02aa78ae?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=628bffe4a1547cdb91630850ba09c7ff", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/1246c074/uploads/origins/96a163f5-bfeb-4d10-ba97-676b02aa78ae?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=28d9410cb8f480bc621db58ee0dae1c2", "src_set": ""}, "body": "はじめまして。\npixivで以前から投稿されていた玉有りのふたなり絵が好きだったのですが綺麗に描かれたパープルハートのふたなり絵でskebに登録されていることを今日知り、是非描いていただきたくご依頼いたします。\n\nキャラクターは超次元ゲイムネプテューヌからノワール。\nシーンシチュはノワールが胸とふたなりを改造されて、そこからシェア（女神の力の源）を搾り取られるといった内容です。\n胸やふたなりの大きさはこちらの（https://skeb.jp/@kamokatatsumuri/works/12）パープルハートと同じにして下さい。\nまた構図もパープルハート同様に拘束されたエロ蹲踞でお願いします。\n腕は後ろで拘束されているため、肘あたりまで描いていただければ結構です。\n視点は斜め前からか真正面からでお願いします。\nURLの服装のまま、胸とふたなりを露出させてください。\n下着は脱がされて脚にかかっている状態でお願いいたします。\nパープルハート同様にムチッとした肉体に描いていただけるとありがたいです。\nぷりっとしたデカ玉と短小で真性包茎のアンバランス、またカワイイ女の子が溜めたチンカスが好きなので、デカタマと包茎とチンカスをお願いいたします。\n\n・欲しい要素、差分等（金額的に可能であればお願いいたします）\n①くっ殺の悔しそうな表情と「よくもこんな身体に改造してくれましたわね！」等の台詞\nふたなりの竿は包茎で垂れさがり、非勃起なので皮が被っている。\n\n②画面外から伸びたアームの先からレーザーや注射等で膨乳&膨れる玉&勃起で皮が剥け、チンカスが露出する。表情は耐えるような表情、または刺激に抗えずオホ顔で無様な表情\n\n③アヘ顔になり、噴乳&射精。量は多い方が良いです。\n\n④③の続きでシェア回収のために（https://www.pixiv.net/artworks/97165598）の様な大きな精液風船が垂れさがり、胸には搾乳機が付いている\n表情は蕩けたアヘ顔\n\nセリフや欲しい要素等は一例でセリフ無しでも結構です。\n子細な部分は先生にお任せいたします。\n\nどうぞよろしくお願いいたします。\n\nhttps://www.compileheart.com/neptune/nepsis/chara/noire.php", "nc": 161, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@kamokatatsumuri/works/13", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 452447, "client_id": 1528406, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/e02ee898/uploads/origins/0d08bea5-ba22-4a26-95a2-17dbb5e40d6b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f6089ccd142f50a09b7834afac5ef592", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/e02ee898/uploads/origins/0d08bea5-ba22-4a26-95a2-17dbb5e40d6b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=af9a9cf009e24f2c134aef0998f45da1", "src_set": ""}, "body": "こんにちは。大きなサイズのキャラクターを描くのにとてもいい感じですね。\nこの2人のキャラクターを一緒に、見る人を見下ろしながら、まるで遠近法で背が高いかのように描いていただけないでしょうか。\nまた、背の低いキャラクターが地面から見上げているような視点で、絵の下の方にちんこを付けてください。\n風呂の背景で、キャラクターの周りに湯気が立ち込め、キャラクターが顔を赤らめながら濡れて息が荒くなっているように見えるようにする。\n以下は、2つのキャラクターの参考リンクです。\nhttps://drive.google.com/drive/folders/1WLrZ6trJo-TylOGClPepkUt8x7kna8ed?usp=sharing\nhttps://drive.google.com/drive/folders/1E1uXvoBcAJE9uygw3ngQOpiL6SBzoRgN?usp=sharing", "nc": 161, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@kamokatatsumuri/works/12", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 452447, "client_id": 0, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/ca13164b/uploads/origins/8dd84c97-2269-4054-8787-0692353fb162?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3ad25aa0ea75004a85c530d18d3db6a3", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/ca13164b/uploads/origins/8dd84c97-2269-4054-8787-0692353fb162?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=37c6e5a4a92bf853d79dc8366e8d024b", "src_set": ""}, "body": "こんばんは。\nパープルハートのふたなりエッチ絵をお願いします。\n\nキャラクター\nネプテューヌのパープルハート（変身）\n・おっぱいふとももなどムチムチな感じ\n・爆乳化したおっぱいがはみ出て乳首はくっきり勃ってる\n・ふたなり　サイズは（https://www.pixiv.net/artworks/97165598）くらい\n・コンドーム装着\n\nポーズ\n（https://www.pixiv.net/artworks/66822815）のようなエロ蹲踞ポーズ\n・頭上（天使っぽく浮いてる）、首、手首、ペニスの根本とカリに卑猥なピンク色に発光する輪（もしくは手錠）\n・頭の飾りと耳にURLのようにコードをつないでほしいです（ほかの部分はお任せします）\n\nシチュエーション\n敵に捕まって肉体に改造を施されたパープルハートが洗脳調教されていくというもの。\n\n上乗せした分で可能なら差分をお願いしたいです。\n・くっ殺な表情と萎えちんぽ状態\n・装着された輪っかと衣装の青いラインがピンクに発光、勃起と「あっ」みたいな表情\n・呆けた表情で射精\n・目がピンク色に変化、目の中にハート。さらに射精、水風船みたいな感じに。\n・舌だし媚び顔でさらに射精、コンドームの中に出した大量の精液風船が重みで引っ張られてどっぷんといった感じで床に着地して半球状になっている。\n\nこのような内容でよろしければご検討宜しくお願い致します。", "nc": 184, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@kamokatatsumuri/works/11", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 452447, "client_id": 1426264, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/eb993ed8/uploads/origins/24740a19-9cf5-435f-a092-c19afd589239?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bc5280accd44425c58bd68e05eac1a6d", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/eb993ed8/uploads/origins/24740a19-9cf5-435f-a092-c19afd589239?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=1dba0df37f504487f001d469d96f44a9", "src_set": ""}, "body": "はじめまして\nPSO2NGSの自キャラのイラストをお願いします\n\n資料↓\nhttps://twitter.com/beasan_ship03/status/1563787428522967040?s=21&t=PkptcBQ8B6btdenQqs34_Q\n\n髪型\nエアリーツインテール\n\n髪の色\n銀色\n\n目\nイラスティカアイ/C\n\n目の色\n緑\n\nコスチューム\nアライアクォーツ/D［Se］\n\nポーズや体型\n以下のイラストの様な感じにして頂きたいです\nhttps://www.pixiv.net/artworks/99171777\n\nコスチュームのアレンジ\n胸と陰部にある白いアーマーを省いて頂きたいです\n省いたら浮き出た乳首とマンスジを入れて頂きたいです\n可能であればコスチュームはNGS仕様らしくテカテカにして頂きたいです\n\n自キャラの見た目\n爆乳\nムチムチ\nぶっともも\n浮き出た乳首\nへそが浮き出ている\nマンスジ\n\n以上になります、よろしくお願いいたします\n\nhttps://twitter.com/beasan_ship03/status/1563787428522967040?s=21&t=PkptcBQ8B6btdenQqs34_Q", "nc": 32, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@kamokatatsumuri/works/10", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 452447, "client_id": 462930, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/d57a962d/uploads/origins/1a4271cb-aa83-471a-930e-fe6349ac1f55?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6660905d4de09119f01d4865a5efe3ad", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/d57a962d/uploads/origins/1a4271cb-aa83-471a-930e-fe6349ac1f55?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=14b70e1de6e85959f084ac6c0e22d27f", "src_set": ""}, "body": "前回は影狼のイラストをありがとうございました。\nとても良かったのでまたリクエストします。\n\n■キャラクター\n東方Projectの犬走椛\n\n椛は公式絵がなくデザインが人によるため\n他の方への依頼絵やソシャゲの絵を外見参考としています。\n特に髪の長さは①ぐらいでお願いします。\n\n①個人的に好きな椛\nhttps://skeb.jp/@nagana/works/8\n②二次創作でよく見る椛\nhttps://wikiwiki.jp/toho_lw/%E7%8A%AC%E8%B5%B0%E6%A4%9B\n\nおっぱいや身体の肉付きは\n前回の影狼と同程度か少し小さいぐらいでお願いします。\n\n前回の影狼の依頼絵\nhttps://skeb.jp/@kamokatatsumuri/works/9\n\n■シチュエーション\n発情期を迎えた椛が恋人の家にお泊りして\n布団(ベット)の上で激しくエッチをしています。\n体位は正常位か騎乗位で両腋が見えるようお願いします。\n\n発情期＆哨戒任務(お仕事)終わりのため\n全身からむわぁと汗やフェロモンに匂いを漂わせる椛に\n恋人の男性は興奮し、二人は激しくセックスをしています。\n発情期(危険日)なので中出しはお仕事に支障が出るのでダメな反応をしつつも、\n実は成事実欲しいので迫る中出しに期待はしているようで\nその後、中出しされた際には責任取ってくださいねと嬉しそうです。\n\n挿入中を基本として挿入前やピストン中、\n中出しや中出し後の余韻中等の差分をお願いします。\n\n服は大きな胸と結合部が見えていれば全裸でも半脱ぎでもＯＫです。\n頭の赤い頭巾も省略してＯＫです。\n\n前回の影狼のように濃い目の腋毛や陰毛を生やしてください。\n毛の色は髪の色に近いのが好みですが黒でもＯＫです。\n\n以上、ご検討ください。", "nc": 49, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "similar_creators": [{"id": 12229, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "朝風あびす", "screen_name": "asakaze_abyss", "avatar_url": "https://pbs.twimg.com/profile_images/1759012097839759360/88PhS1CM.jpg", "header_url": "https://pbs.twimg.com/profile_banners/2850107466/1686090946/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 10, "skills": [{"genre": "art"}, {"genre": "comic"}], "nc": 49}, {"id": 98022, "creator": true, "nsfw_acceptable": true, "acceptable": false, "name": "きゅんもふ🎈", "screen_name": "mofuumoff", "avatar_url": "https://pbs.twimg.com/profile_images/1677000653758160896/-mDrmCbX.jpg", "header_url": "https://pbs.twimg.com/profile_banners/2231323826/1752684710/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 5, "skills": [{"genre": "art"}], "nc": 48}, {"id": 123863, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "如月なな", "screen_name": "nana_kisaragi", "avatar_url": "https://pbs.twimg.com/profile_images/1959949738629005312/Z1PmHcqG.jpg", "header_url": null, "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 3, "skills": [{"genre": "art"}, {"genre": "comic"}], "nc": 32}, {"id": 742720, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "５３", "screen_name": "gosann53", "avatar_url": "https://pbs.twimg.com/profile_images/1302934090522324993/XLRRHAKV.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1301189794530078721/1621700890/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "fir