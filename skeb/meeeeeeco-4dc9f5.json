屋ですので人前では余計にクールっぷりしてるけどまた寂しがり屋のちょっと面倒くさい感じです。一人の時や知り合いの前では表情が緩めてちょっと豊かになる感じです。\nこれだけではちょっと説明が足りないと思いますので設定と設定画など、ご参考できそうなものを下のURLにまとめております。\n\nこの娘でmeeeeeeco様の絵柄でのイラストをどうかお願いしたいです。\n衣装は設定画のうちの一つで、他はどうかご自由にお願いします。\nご検討くださいませ！\n\nお忙しい中、要件のみで申し訳ありません。\n応援しております！\n\nhttps://drive.google.com/drive/folders/1kVcp6B8dzGYFGpFb9spMTyDnz0TzyM7Q?usp=sharing", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@meeeeeeco/works/12", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3266135, "client_id": 1298926, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/d3298f02/uploads/origins/dde375d0-e1e8-442e-a0c6-fddb11aca388?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7867067bf353c0176ddcac5da7aea0b9", "srcset": "https://si.imgix.net/d3298f02/uploads/origins/dde375d0-e1e8-442e-a0c6-fddb11aca388?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7867067bf353c0176ddcac5da7aea0b9, https://si.imgix.net/d3298f02/uploads/origins/dde375d0-e1e8-442e-a0c6-fddb11aca388?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ed19d9eb7277de0cb9dba5c52d3cdbd1 2x, https://si.imgix.net/d3298f02/uploads/origins/dde375d0-e1e8-442e-a0c6-fddb11aca388?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=99c2717f9186227eb0928fe6faeb0e5f 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/d3298f02/uploads/origins/dde375d0-e1e8-442e-a0c6-fddb11aca388?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c49e857cc259e7838dfd8bc5d5e7fe0d", "srcset": "https://si.imgix.net/d3298f02/uploads/origins/dde375d0-e1e8-442e-a0c6-fddb11aca388?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c49e857cc259e7838dfd8bc5d5e7fe0d, https://si.imgix.net/d3298f02/uploads/origins/d