手に拘束されて身体を起こされ、Ｍ字開脚で吊り上げられているか、膝立ちくらいの状態で全身を触手に犯されている感じでお願いします。\n前回の後ということで全身の精液も増え、太い触手を挿入されて中出しされ、泣き叫んでいる姿をお願いします。\n\n差分が可能であれば、口に触手をねじ込まれて射精されている様子や\n股間の方を見ながら怯えて歯を食いしばっている様子もお願いします。\n\n画像資料は見つかったので記載しておきます。\n\n■プリマヴェーラパンテーラ前面\nhttps://pbs.twimg.com/media/CdXSqObVIAA_QZ9?format=jpg&name=medium\n\n■プリマヴェーラパンテーラ背面\nhttps://pbs.twimg.com/media/CdXSqQXUsAA0ppy.jpg\n\n■山吹凛\nhttps://rei.animecharactersdatabase.com/uploads/chars/11498-1567129297.png", "nc": 40, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@SUNSON_/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 56237, "client_id": 404193, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/0ed86525/requests/125109_1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ce4ff47b5d492aee36b8abb4eacc9d0f", "srcset": "https://si.imgix.net/0ed86525/requests/125109_1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ce4ff47b5d492aee36b8abb4eacc9d0f, https://si.imgix.net/0ed86525/requests/125109_1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=905d5aa4f794f47f42cc1279c96c7ff1 2x, https://si.imgix.net/0ed86525/requests/125109_1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=5973d46cb9cbf2c10a4b94a2b0a1a138 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/0ed86525/requests/125109_1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=7eae680021a48a8e84cd6bd8abbac8b8", "srcset": "https://si.imgix.net/0ed86525/requests/125109_1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=7eae680021a48a8e84cd6bd8abbac8b8, https://si.imgix.net/0ed86525/requests/125109_1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=16b40e1ac915fd8d7214271104