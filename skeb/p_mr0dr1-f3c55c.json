いただいても大丈夫です。(髪型も変更可能です！)\n\n金額が足りない場合は可能な範囲で対応します。内容に不備があるか、難しい場合にはキャンセルしていただいて大丈夫です。\n\n長々とした文章になってしまって申し訳ありませんが、ご検討宜しくお願い致します。\n\nhttps://drive.google.com/drive/folders/1TcAeoGzARUrlRo3fYusFGljwZiYUL0xX", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}], "sent_works": [], "similar_creators": [{"id": 700457, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "potato(ぽたと)", "screen_name": "popopopopo623", "avatar_url": "https://pbs.twimg.com/profile_images/1493520569085886465/lymE--Fd.jpg", "header_url": "https://pbs.twimg.com/profile_banners/909380549696905216/1644918027/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 3, "complete_expiration_days": 10, "skills": [{"genre": "art"}], "nc": 16}, {"id": 2175717, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "あ", "screen_name": "uaneay", "avatar_url": "https://pbs.twimg.com/profile_images/1841512427864915971/-kZ6S-7Z.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1242656542786084864/1773123502/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "art"}, {"genre": "comic"}, {"genre": "correction"}], "nc": 129}, {"id": 2561461, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "檜宮しょう", "screen_name": "Ly05YY", "avatar_url": "https://proxy.misskeyusercontent.jp/avatar/media.misskeyusercontent.jp%2Fio%2Ffc3ff1e2-1304-4225-b463-df87c2a5f26c.png?avatar=1", "header_url": "https://media.misskeyusercontent.jp/io/webpublic-8c000a79-c9e6-4826-aec8-7a08652fca3c.png", "appeal_receivable": true, "popular_creator_rank": null, "request_master_rank": null, "first_re