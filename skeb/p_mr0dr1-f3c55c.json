ただきます。\nSNSでは初公開時にツイートさせていただきます。\n（現状収益化はしておりません）\n\n\n\nたくさん指定があり、長くなってしまい大変申し訳ございません。\n\nまるゐ様がskeb開始されているのを拝見し、\nいつかご依頼したいとずっと思っておりましたので送らせていただきました。\n\n大変難しい内容もあるかと思います。\nご不快に思われましたらもちろんお断りいただいて大丈夫ですので、\n上記問題などございませんでしたら、お受けいただけますと幸いです。\n\nお忙しい中大変恐れ入りますが、何卒よろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/1yBdvvxkhGBY9Ut0Jg7fwa-dhOi0nZKEj?usp=sharing", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@p_mr0dr1/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2394180, "client_id": 53759, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/94569a9b/uploads/origins/15bcf7b3-4feb-4e01-af68-18743e7e05be?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6bca7aaadf4aa84161eb242b63032806", "srcset": "https://si.imgix.net/94569a9b/uploads/origins/15bcf7b3-4feb-4e01-af68-18743e7e05be?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6bca7aaadf4aa84161eb242b63032806, https://si.imgix.net/94569a9b/uploads/origins/15bcf7b3-4feb-4e01-af68-18743e7e05be?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=79c347050f614a37a4af99ef8ac0061a 2x, https://si.imgix.net/94569a9b/uploads/origins/15bcf7b3-4feb-4e01-af68-18743e7e05be?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b95c086fd2238e505d3c4c7b9218c736 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/94569a9b/uploads/origins/15bcf7b3-4feb-4e01-af68-18743e7e05be?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=065243bfae1a807e06d9f4bb05a85c48", "srcset": "https://si.imgix.net/94569a9b/uploads/origins/15bcf7b3-4feb-4e01-af68-18743e7e05be?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=065243bfae1a807e06d9f4bb05a85c48, https://si.imgix.net/94569a9b/uploads/