=crop&crop=top&w=200&h=200&s=10a7dba860765fd56e1653e7ffeeb812", "srcset": "https://si.imgix.net/996f9f40/uploads/origins/cd0d62f6-207b-4dd7-8582-e04772a32d05?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=10a7dba860765fd56e1653e7ffeeb812, https://si.imgix.net/996f9f40/uploads/origins/cd0d62f6-207b-4dd7-8582-e04772a32d05?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=2b16d252bc9dd456f6b929e5d43750c2 2x, https://si.imgix.net/996f9f40/uploads/origins/cd0d62f6-207b-4dd7-8582-e04772a32d05?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=047a4da28225bab29896cfe58ec76455 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/996f9f40/uploads/origins/cd0d62f6-207b-4dd7-8582-e04772a32d05?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2ffbc59b7a37ae9f653ca042c3f7075f", "srcset": "https://si.imgix.net/996f9f40/uploads/origins/cd0d62f6-207b-4dd7-8582-e04772a32d05?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2ffbc59b7a37ae9f653ca042c3f7075f, https://si.imgix.net/996f9f40/uploads/origins/cd0d62f6-207b-4dd7-8582-e04772a32d05?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=7c7169e106a3354d0dea115e339d431b 2x, https://si.imgix.net/996f9f40/uploads/origins/cd0d62f6-207b-4dd7-8582-e04772a32d05?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=9db41e9ed61926713e9f0f6168e15bf3 3x"}, "body": "くらおかしょうさん、初めまして。\nウマ娘にてご依頼を掛けられそうな方を探して、くらおかしょうさんのことをお見つけさせて頂きました。\nもしよろしければ、ウマ娘の「ファインモーション」に格闘ゲーム「ヴァンパイア」シリーズの「モリガンの衣装をコスプレ」をさせたイラストをお願いできるでしょうか？\n\n衣装参考：モリガン・アーンスランド\nhttps://statue.prime1studio.co.jp/dks-morrigan-remdks-01s.html\n\nファインモーションちゃんの進化スキルに 「モリガンの矛戟」というものがありまして、この組み合わせに発想が辿り着いてしまった次第です。\nくらおかしょうさんの可愛らしい絵柄と、ヘッダーにもなっているファインちゃんの良い表情の描き味にグッと来ましたため、是非ファインちゃんでご依頼を掛けさせて頂ければと思った次第です。\n\n表情や構図・ポーズ、あと多少のアレンジなどについては、くらおかしょうさんが良いと思ったまま、ご想像されるままのファインちゃんのリアクションで描いて頂ければOKです。\nちょっとセクシーな衣装を前に恥じらうファインちゃんでも、お祭りごとやジャパニーズコスプレ文化に興味津々とノリノリに着こなすでも。\nなりきりよりはあくまでファインちゃんの「らしさ」の方をメインに欲しいので、くらおかしょうさんのイメージされるファインちゃんのリアクションで描き出して頂ければ幸いです。\n（それにくらおかしょうさんの明るく可愛い絵柄で描き出されるセクシー衣装とのギャップも期待のひとつですｗ）\n\n一応コスプレ（衣装）姿がメインとなるため、できればの範囲で十分ですが、なるべく全身の衣装姿を拝めるような構図で描いてくれれば嬉しいです。\n\nやや無茶なご依頼とは存じますが、それでもよろしければ、何卒お願いいたします！\n\nhttps://www.pixiv.net/artworks/120933262", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 698136, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "セキキザキ", "screen_name": "nos_tsn", "avatar_url": "https://pbs.twimg.com/profile_images/1765323589375676416/2DgldCTz.jpg", "header_url": null, "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "art"}], "banned": false, "nc": 176}, {"id": 837146, "creator": true, "nsfw_acceptable": false, "acceptable": false, "name": "まてる💐COMITIA156【M03b】", "screen_name": "materu_2532", "avatar_url": "https://pbs.twimg.com/profile_images/1636732884232052738/-BDkaNqS.jpg", "header_url": "https://pbs.twimg.com/profile_banners/922716426/1766038868/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 20, "complete_expiration_days": 120, "skills": [{"genre": "art"}], "banned": false, "nc": 144}, {"id": 870402, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "実川葦", "screen_name": "ztk_ashi", "avatar_url": "https://pbs.twimg.com/profile_images/1990727484158115840/xRwTOwzx.jpg", "header_url": "https://pbs.twimg.com/profile_banners/3298964574/1702260445/1500x500", "appeal_receivable": tru