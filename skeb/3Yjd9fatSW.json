tps://si.imgix.net/19a11246/uploads/origins/7b8a8e3a-1931-4842-bbae-2cfe85499ed7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e1db2845e01aba608b9765e5d04f85d4", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/19a11246/uploads/origins/7b8a8e3a-1931-4842-bbae-2cfe85499ed7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=4c76b4a1c03b6c11b9b046a5d0027fef", "src_set": ""}, "body": "洲澄様  \n\nはじめまして。 \nSHOWROOMとTwitchにて活動中のVliverリリィ・プリュムと申します。  \n\n偶然お見かけしたのですが本当に素敵で可愛いくて線の感じとかとても好きです…！\n是非描いていただれけばと思いリクエスト入れさせていただきました。\n\n⋆꙳依頼内容 ︎ \n✧リリィ・プリュムの全身イラスト\n(ペポ(うさぎ)はいてもいなくても大丈夫です！)\n\n是非！洲澄様の思うまま！描いていただきたいです！\n\n⋆꙳キャラクター詳細 \n竹から生まれた箱入り娘の元神様 元気いっぱい天真爛漫でことある事に爆発させて解決させる爆竹娘 \n毎日小さな幸せをペポと共に探している。 \n地球が終わったら全人類をペポに作り替えてみんなで異星に移住しようとしている。 \n好きな物：お花、ペポ、星、甘いもの \n配信内容：お絵描き、雑談、朗読、占い(タロット) \n見た目は12~14歳程度 ︎ \n\n✧モチーフ \nかぐや姫  \nペポ：リリィのお世話係兼お目付け役。/リスナー名\n\n ⋆꙳使用用途  \nSNSや各種告知、配信、short動画等での使用 、グッズ購入時の特典などでの使用、ネットプリント等幅広く許可いただきたいです。\n\n  ⋆꙳納品データ \n背景、キャラクター、宛名が別々になっているデータでの納品希望です。\n\n 金額が見合わない場合は再リクエスト要請していただきたいです。  \n\n何卒よろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/1lU_HDogDxNJWPxeLalJS02co_jdcrwNs", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@3Yjd9fatSW/works/2", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/b4595cd1/uploads/origins/4b5bbc5b-0916-43ad-ae30-b3c6841c1852?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=979079b8f92b5aaa0ee449ebb227d23d", "src_set": ""}, "private": true, "genre": "art", "tipped": false, "creator_id": 3659676, "client_id": 3168243, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 129, "word_count": 0, "transcoder": "", "c