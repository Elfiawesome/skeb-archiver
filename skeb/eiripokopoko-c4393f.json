目 \n自分の漫画のキャラクターで、\n名前は夕暮 真善太(ゆうぐれ まぜんた)\nといいます。\n\n ・髪の毛 ピンク、襟足だけ青。 目 青 \n\n童顔の大学生。モチーフは「てんとう虫」できたら背中にてんとう虫の羽根を付けてください。\n\n 笑っているか真顔かわからないアンニュイな表情 こちらのキャラをメインに描いてほしいです。 21歳で174センチです。\n\n\n 2人目 「幼虫くん」という名前です。 \n\n・髪の毛と目 黒 上のキャラの高校生時代です。 \n\nモチーフは「てんとう虫の幼虫」 \n\n笑顔以外を希望。背中に黒とオレンジのボコボコがあります(画像参照) \n\nこちらのキャラは上のキャラよりは目立たせず、ややサブ的に入れてほしいです。 \n\nそのほか\n\n ・まるみさんの作品の「水の中の君」「偽りの愛」 のような少し仄暗くて背景がミッチリある感じの絵がとても好きなので、 料金内で可能な範囲で背景多めに書き込んでいただけたら嬉しいです。\n\n 構図やシチュエーションみたいなものは完全にお任せいたします。 後暗いことがあるキャラなので、明るいイメージではなく全体的に仄暗いイメージで描いていただけると嬉しいです。 \n\nよろしくお願いします。\n\nhttps://x.com/eiripokopokon/status/1833699506535506359?t=22Enq1ep0VYpYWTVVBSxPA&s=19", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@shall0099/works/13", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2596251, "client_id": 738760, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/746a2e36/uploads/origins/3309ea8b-7a8c-46d0-b436-e2555abad9a3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d8c7e5aea4a955973d710b2b2b8c2377", "srcset": "https://si.imgix.net/746a2e36/uploads/origins/3309ea8b-7a8c-46d0-b436-e2555abad9a3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d8c7e5aea4a955973d710b2b2b8c2377, https://si.imgix.net/746a2e36/uploads/origins/3309ea8b-7a8c-46d0-b436-e2555abad9a3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=473f058de83076964060231aa52c1379 2x, https://si.imgix.net/746a2e36/uploads/origins/3309ea8b-7a8c-46d0-b436-e2555abad9a3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e47f28aa884d93b2d67857a6c624f32f 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/746a2e36/uploads/origins/3309ea8b-7a8c-46d0-b436-e2555abad9a3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f33e2