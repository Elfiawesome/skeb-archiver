23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e2d7a243cd3a2d61209c34a37210f66e, https://si.imgix.net/223b7390/uploads/origins/4cd522b9-f4c0-4e1b-93ab-50f8b5aca090?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=e1704edd0b9aa62103bbbe7d77351436 2x, https://si.imgix.net/223b7390/uploads/origins/4cd522b9-f4c0-4e1b-93ab-50f8b5aca090?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=f3889baf3a2304b7cc115fbd86bc4cf1 3x"}, "body": "こんにちは。高坂ニナさんの作品を拝見しましたが、とても可愛くて気に入りました。私のVチューバーのアニメーションでないスタート画面もあなたからお願いします。私のVチューバーは、二匹のしっぽを持つ狐のような女性的な男性で、アイテムショップを経営しており、物腰は柔らかいですが、甘く遊び心のある性格をしています。ファッションやメイク、可愛いおもちゃやチャームといったものに興味があるようです。\n\nスタート画面には、高坂ニナ（狐坂ニナ）の時のように、アイテムや私のVチューバーを登場させてほしいです。ポーズや表情は問いませんし、彼に似合いそうなアイテムもお願いします。参考になればと思い、自分で作った画面もいくつか持っているので、そちらも参考にしてください。作品が複雑なため、推奨金額より多く支払っています。\n\nどうもありがとうございました。翻訳機を使っているので、失礼や誤解がありましたら、申し訳ありません。\n\nVチューバー： https://imgur.com/a/RhesBfI\nアイテム・画面： https://imgur.com/a/2BHGHzj", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@nito210ni/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1961314, "client_id": 765666, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/3fa18040/uploads/origins/44409705-dbf7-4e9c-b375-9a725aa5df07?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=154580c47f013ab2138aa04a02a4a2d5", "srcset": "https://si.imgix.net/3fa18040/uploads/origins/44409705-dbf7-4e9c-b375-9a725aa5df07?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=154580c47f013ab2138aa04a02a4a2d5, https://si.imgix.net/3fa18040/uploads/origins/44409705-dbf7-4e9c-b375-9a725aa5df07?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=08a464c2c60343d6f3a974b9530c6fcb 2x, https://si.imgix.net/3fa18040/uploads/origins/44409705-dbf7-4e9c-b375-9a725aa5df07?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=36cf1eb908e6856389738c153b00d56a 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/3fa18040/uploads/origins/44409705-dbf7-4e9c-b375-9a725aa5df07?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0092d87214b8985f7d3732d4f25013e3", "srcset": "https://si.imgix.net/3fa18040/uploads/origins/44409705-dbf7-4e9c-b375-9a725aa5df07?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0092d87214b8985f7d3732d4f25013e3, https://si.imgix.net/3fa18040/uploads/origins/44409705-dbf7-4e9c-b375-9a725aa5df07?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=c4d2f8178ddd2271f61c6445264c2a88 2x, https://si.imgix.net/3fa18040/uploads/origins/44409705-dbf7-4e9c-b375-9a725aa5df07?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=14d423e7e2b8de6c6eefa2c394e00323 3x"}, "body": "こんにちは。あなたの画風が大好きです。私のオリジナルキャラクターを描いていただけませんか？\n\n猫が大好きで、猫をモチーフにした小物をたくさん身につけている、クールでオシャレな女の子です。いつもクールで穏やかな表情をしていて、ジャケットをきちんと肩にかけることは「自分のスタイルだから」といってほとんどしない。\n\nリボンのついた襟付きチョーカーに、ごく短いタンクトップ、ごく短いショートパンツを履いている。ジャケットはバギーでオーバーサイズ、ジャケットの袖はホログラムで透けている。ショートパンツの花柄と後ろのフリル生地もホログラムになっている。猫のカチューシャとヘアクリップはメタリックでホログラフィック。また、彼女は指なし手袋とヒールの高いブーツを履いている。猫の形をしたイヤリングも描いてください。\n\n一番重要なのは、まつ毛と、衣装のホログラムデザイン、猫耳型の髪の毛、そしていつもバブルガムを噛んでいるところなので、できればこれらを描いてください\n\nご検討のほど、よろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/1WA3duvKiBY2TY-He3OUhDJFohJ2ej833?usp=sharing", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@nito210ni/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1961314, "client_id": 1878969, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/e3ffa10d/uploads/origins/4810b7df-b729-4726-a251-b30be1e55c8c?bg=%23fff&a