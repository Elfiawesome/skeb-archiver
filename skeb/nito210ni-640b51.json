1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=31e124871baf04e8bc2aad33b98ab7c0 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/d27f9c67/uploads/origins/ad0891f3-b5f5-41b6-b393-58f78bcac8e1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=91a6729184b1311ac726022f6d84d9f2", "srcset": "https://si.imgix.net/d27f9c67/uploads/origins/ad0891f3-b5f5-41b6-b393-58f78bcac8e1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=91a6729184b1311ac726022f6d84d9f2, https://si.imgix.net/d27f9c67/uploads/origins/ad0891f3-b5f5-41b6-b393-58f78bcac8e1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=11618df4eaa25f3caa3a5b1ccb07cdd3 2x, https://si.imgix.net/d27f9c67/uploads/origins/ad0891f3-b5f5-41b6-b393-58f78bcac8e1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=e92693ffa94c3f7a00429ccbfb20b76c 3x"}, "body": "こんにちは。私はあなたの作品の大ファンで、ぜひ私のキャラクターを描いて頂きたいと思っています\n\nダンディという名前で、私のマスコット的存在です!天の川の外側の星の海から来たアンドロイドの宇宙人です!髪の毛は水のような、虹色のような、星の粉のような質感です。日焼けした肌と、ダイヤモンドのような瞳が特徴です。性格は、好奇心旺盛で、興奮しやすい。\n\nこの作品を見てから、ずっと好きで、同じようなものが欲しいと思っていました。壁紙にしたいくらいです！ https://skeb.jp/@nito210ni/works/5\n\n ポーズは、流れ星(星型キャンディ)を手に持って、ウインクして笑っているところを描いてほしいです!^^\n\nビジュアル面では、星飴、宇宙、宝石、流れ星、流星、海、プリズム、月うさぎをダンディから連想しています。\n\nご検討のほど、よろしくお願いいたします\n\nhttps://drive.google.com/drive/folders/1bOWwiZY2csM4sZcQnGbTYRyeBEQK77Li?usp=sharing", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@nito210ni/works/12", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1961314, "client_id": 243436, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/e7e3780e/uploads/origins/8a26e72a-8cef-4b08-8e6f-f44882ab35ac?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7be