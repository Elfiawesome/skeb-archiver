youtube.com/channel/UC0SZd1145fV25pUTuJ4y5jA\n\n●おまかせしたい箇所\n・髪色と髪型のチョイス\n髪色はデフォルトがピンク、別バージョンでミルクティカラーと、髪型はショートと結びのそれぞれ2パターンあります。\nどの色、どの長さにするかは晴様のイラストが映えるものでおまかせしたいです。\n\n・服装や構図、表情\n服装は晴様のイメージでのおまかせでも、参考資料のアイドル衣装やジャケット着用私服、ベスト私服のいずれかでも歓迎です。\n\n・アクセサリー(可能であれば)\nイメージに合わせて、ピアスとイヤーカフ、指輪など、メンズライクなアクセサリーをつけていただけるとより嬉しいです。\n--- \nお忙しいところ最後までお目を通していただき誠にありがとうございました。 \nご都合がよろしければ、何卒ご検討の程よろしくお願いいたします。", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@yurusare_ojo/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2316790, "client_id": 484686, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/c07dc6d2/uploads/origins/69b77891-dae1-450d-b890-8bfe443297f0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=be41b82f4b073471a9f4b26b753ef4af", "srcset": "https://si.imgix.net/c07dc6d2/uploads/origins/69b77891-dae1-450d-b890-8bfe443297f0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=be41b82f4b073471a9f4b26b753ef4af, https://si.imgix.net/c07dc6d2/uploads/origins/69b77891-dae1-450d-b890-8bfe443297f0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=1240d0c1a11adc22c46c258f5f22b899 2x, https://si.imgix.net/c07dc6d2/uploads/origins/69b77891-dae1-450d-b890-8bfe443297f0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=cbddd425af28d167805a65fbc1e15877 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/c07dc6d2/uploads/origins/69b77891-dae1-450d-b890-8bfe443297f0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3f60b764ca00b0f3555d74990afeafd5", "srcset": "https://si.imgix.net/c07dc6d2/uploads/origins/69b77891-dae1-450d-b890-8bfe443297f0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3f60b764ca00b0f3555d74990afeafd5