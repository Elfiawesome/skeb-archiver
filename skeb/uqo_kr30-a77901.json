n\nhttps://drive.google.com/drive/folders/1WO-QmK_j8m4ww_qSmO8aaBSQVICuq1cf?usp=sharing", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@uqo_kr30/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2277689, "client_id": 2168110, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/c4d2e1cb/uploads/origins/e389d70c-f7f1-4dbf-92bd-3ee695e7eaa7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c9c902165310ed86a49129fc87186592", "srcset": "https://si.imgix.net/c4d2e1cb/uploads/origins/e389d70c-f7f1-4dbf-92bd-3ee695e7eaa7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c9c902165310ed86a49129fc87186592, https://si.imgix.net/c4d2e1cb/uploads/origins/e389d70c-f7f1-4dbf-92bd-3ee695e7eaa7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=7fa246c1a6e2bc4e04202c0138f6bb70 2x, https://si.imgix.net/c4d2e1cb/uploads/origins/e389d70c-f7f1-4dbf-92bd-3ee695e7eaa7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c3ea4caa36ad04fa99dfb0122b392192 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/c4d2e1cb/uploads/origins/e389d70c-f7f1-4dbf-92bd-3ee695e7eaa7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=aa3b687867b8059953c5b94769dc2017", "srcset": "https://si.imgix.net/c4d2e1cb/uploads/origins/e389d70c-f7f1-4dbf-92bd-3ee695e7eaa7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=aa3b687867b8059953c5b94769dc2017, https://si.imgix.net/c4d2e1cb/uploads/origins/e389d70c-f7f1-4dbf-92bd-3ee695e7eaa7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=62b074ed38ca9ffb89a2b41f60ed2daa 2x, https://si.imgix.net/c4d2e1cb/uploads/origins/e389d70c-f7f1-4dbf-92bd-3ee695e7eaa7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=a39e1b3eacd6cdd862c3bf5d15bd904b 3x"}, "body": "はじめまして！\n絵柄に興味があったのでご依頼しました。\nもしよろしければ、うちのOCの「蓮柄まどか」をお願いすることは可能でしょうか？ \n参考までに設定は以下のとおりですが、自由に描いていただいて構いません。\n\n███\n蓮柄 円(はちすがら まどか)。\n\n白いフードつきのパーカーを着た、黒髪ボブで切れ長の目をした、ボーイッシュな女の子。\nかつて怪異に巻き込まれて命を落とした。\n現在は亡霊として自身と同じように怪異に巻き込まれた人々を導く水先案内人をしている。\n\n生前の特殊能力『モータル・アンダーテイカー』は、死体を収拾して自身の心象世界に安置（保存）する能力。収集した死体は好きな時に取り出し可能で、相手に落としたり、死体でバリケードを張ったりできた。\n\n家族関係は一人親の母子家庭。\nまだ物心がつく前に母に連れられて家を出た。そのためか父や姉の存在を知らずに育った。\n\n父方に残された同形異音の名をもつ実姉の「蓮柄 円（はちすがら つぶら）」とは双子の関係。姉のつぶらは長い銀髪の碧眼で長身痩躯であり、双子とは言っても顔の作りを除けば、性格も含めて似てるところはあまりない。\n███\n\n使用用途は個人活動全般(小説の挿絵等、SNSや個人サイト等でのキャラクター紹介・個人活動の告知等)を考えています。\nもしご都合が合えばよろしくお願いします。\n\nhttps://drive.google.com/file/d/13ni0TtyZHhTVNKzvePM8lUM4N0LA0KiP/view?usp=sharing\nhttps://drive.google.com/file/d/1bejRtqW8-1VhXwEgmWM4BdXjC0a2qlyU/view?usp=sharing", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 1228629, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "メ・バヂス・バ名言bot", "screen_name": "GRONGIKBTIT", "avatar_url": "https://pbs.twimg.com/profile_images/1779803760140955648/6JwJposC.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1736000677133119488/1732719093/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "art"}], "banned": false, "nc": 49}, {"id": 2452565, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "あるかんじゅ", "screen_name": "PM_DRAWING", "avatar_url": "https://pbs.twimg.com/profile_images/1682997812534054913/XkDwVB4z.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1262772128333496321/1717910338/1500x500", "appeal_receivable": true, "popular_creator_rank": null, "request_master_rank