=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0b3245c6ccb11b01ad482337b4ec9344, https://si.imgix.net/f77eede2/uploads/origins/b5ed88ac-2956-49a2-b5a4-2c6470186513?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=2c2cf746bf1c709ede24b365cd232acd 2x, https://si.imgix.net/f77eede2/uploads/origins/b5ed88ac-2956-49a2-b5a4-2c6470186513?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=bc7ca0daf15bb96f96d3939eb6063e0d 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/f77eede2/uploads/origins/b5ed88ac-2956-49a2-b5a4-2c6470186513?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3c483cb5ec89905876317a99ba25a7ac", "srcset": "https://si.imgix.net/f77eede2/uploads/origins/b5ed88ac-2956-49a2-b5a4-2c6470186513?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3c483cb5ec89905876317a99ba25a7ac, https://si.imgix.net/f77eede2/uploads/origins/b5ed88ac-2956-49a2-b5a4-2c6470186513?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=cb0b88e5de9c6864174cbf3a44f6d823 2x, https://si.imgix.net/f77eede2/uploads/origins/b5ed88ac-2956-49a2-b5a4-2c6470186513?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=11176886d23a30639c8aca8308b4d63e 3x"}, "body": "はじめまして。\nリクエストを依頼する絵師の方を探していたところ、ふらっとらいとさんのところにたどり着き、素敵なロリ爆乳イラストに辛抱たまらず依頼をさせて頂きました。\nマニアックな内容ですので気に入らない場合は断って頂いて構いません。\nですが受けて頂けたら大変嬉しく思います、ぜひよろしくお願いしますm(_ _)m\n\n【シチュエーション】\nロリ爆乳化したけものフレンズのライオンとベンガルトラの相手を孕ませたら勝利のふたなり(玉あり)バトルファック。\n\n(1枚目)\nがに股のライオンがジャックオーチャレンジの体勢のベンガルトラの尻を鷲掴みにして中出しし、ベンガルトラはところてん射精。\nライオンは意地悪な感じの笑顔で、ベンガルトラは涙を流しながら切なそうに喘いでいる感じでお願いします。\n\n(2枚目)\nベンガルトラが撞木反りの体勢でライオンの両乳房を鷲掴みにして噴乳させながら中出しし、ライオンがところてん射精しながら妊娠(受精)してベンガルトラの勝利。\nベンガルトラは勝利を確信した笑顔で、ライオンは感じながらも目をギュッと閉じて泣き叫んでいる感じでお願いします。\n\n【衣装】\n全裸に原作のニーハイソックス。\nライオンは原作の首のファー、ベンガルトラは原作の長手袋もお願いします。\n\n【その他】\nおっぱい、尻、ちんぽは可能な限り大きくお願いします。\n\n細かくなってしまい、大変申し訳ありません💦\nどうかよろしくお願いします。", "nc": 169, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Stephenflatrigh/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2397396, "client_id": 600508, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/b3058d2e/uploads/origins/b6f5080d-2a9d-476a-bf55-6369bf7366dc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=43347b46a038bbfde7ab41c3ddb9ca22", "srcset": "https://si.imgix.net/b3058d2e/uploads/origins/b6f5080d-2a9d-476a-bf55-6369bf7366dc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=43347b46a038bbfde7ab41c3ddb9ca22, https://si.imgix.net/b3058d2e/uploads/origins/b6f5080d-2a9d-476a-bf55-6369bf7366dc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=19dac106bf0ceb9d0efa9b915e2ddb09 2x, https://si.imgix.net/b3058d2e/uploads/origins/b6f5080d-2a9d-476a-bf55-6369bf7366dc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d4760b19962846619840196fa6fd380e 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/b3058d2e/uploads/origins/b6f5080d-2a9d-476a-bf55-6369bf7366dc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3e3946a2f60ae558848b0c8d5aad253e", "srcset": "https://si.imgix.net/b3058d2e/uploads/origins/b6f5080d-2a9d-476a-bf55-6369bf7366dc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3e3946a2f60ae558848b0c8d5aad253e, https://si.imgix.net/b3058d2e/uploads/origins/b6f5080d-2a9d-476a-bf55-6369bf7366dc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=410e40b1275b44d469a27b34809d3ad6 2x, https://si.imgix.net/b3058d2e/uploads/origins/b6f5080d-2a9d-476a-bf55-6369bf7366dc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=00a2932a0ad8db24a6453fa82b36ba33 3x"}, "body": "こんにちは。日頃より可愛らしい画の数々楽しませて頂いています。フォローを頂いたのも何かの縁…と言いますか、正直以前より依頼しようか迷っていたところに良いきっかけと思って依頼させていただきます。\nドマイナーなネタで恐縮ですが、「11eyes cross over」というゲームの『黒芝かなえ』さんをお願いします。 CVや背丈的にはお姉さんですが、元のキャラデザとお顔立ち的にはロリキャラだと思います。ついでにおっぱい大きくてややネタバレになりますがBBAキャラでもあります！\n劇中の学園制服とエッチな方とありますが、お好きな服装で描いてください。他の描きたい服装やいっそ下着や水着、全裸でも一向に構いません！ 妖艶な感じの表情やポーズで、細かいシチュエーション、背景等はお任せします。\nポーズや表情、汁等のエフェクト差分あると悦びますが余裕があれば、で結構です。\nその他、基本的にはスマホ壁紙を想定しているので縦長の画で、各所存分に\"盛って\"貰えると捗ります。\nご検討頂ければ幸いです。\n\n ※今やお亡くなりになっているメーカーなので資料になりそうなサイトを貼っておきます。見れなかったらごめんなさい; https://yande.re/post?tags=kuroshiba_kanae+", "nc": 48, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Stephenflatrigh/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2397396, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/f951d384/uploads/origins/22b7173e-090c-4f59-81c1-9490b9b2fd20?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=065f4fa4d67b43003cce144d6143d9aa", "srcset": "https://si.imgix.net/f951d384/uploads/origins/22b7173e-090c-4f59-81c1-9490b9b2fd20?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=065f4fa4d67b43003cce144d6143d9aa, https://si.imgix.net/f951d384/uploads/origins/22b7173e-090c-4f59-81c1-9490b9b2fd20?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=996ccfaed943c921555cf138306ee12f 2x, https://si.imgix.net/f951d384/uploads/origins/22b7173e-090c-4f59-81c1-9490b9b2fd20?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=27cccd2b4e000ce9029f8d8aa3cdb006 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/f951d384/uploads/origins/22b7173e-090c-4f59-81c1-9490b9b2fd20?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=302e85c5a2f25776ec0fd0f8bda42444", "srcset": "https://si.imgix.net/f951d384/uploads/origins/22b7173e-090c-4f59-81c1-9490b9b2fd20?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=302e85c5a2f25776ec0fd0f8bda42444, https://si.imgix.net/f951d384/uploads/origins/22b7173e-090c-4f59-81c1-9490b9b2fd20?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=0ff863cff371ea1458d28980cd693b51 2x, https://si.imgix.net/f951d384/uploads/origins/22b7173e-090c-4f59-81c1-9490b9b2fd20?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=dd73cb5650c5559db33bd524fd91e46e 3x"}, "body": "初めまして。ふらっとらいとさんのオリキャラ・八重花さんが大好きで、彼女のイラストをリクエストさせていただきたく今回参りました。\n\n描いていただきたいのは、牛柄ビキニ姿の八重花さんとのラブラブ授乳プレイイラストです。\n基本となるイラストに、セリフ等の差分で表現していただきたく思います。\nビキニのデザインや構図などはお任せします。\n\n【具体的なシチュエーション】\n\n・「こんなものどっから用意するんじゃ…？」と、ビキニを着て恥ずかしがっているが、満更でもなさそうな八重花さん\n・「今日も美味いか？たっぷり飲むがよいぞ」と母乳を飲ませてくれる八重花さん\n・母乳を飲まれまくってイキまくる八重花さん\n・2時間後。「たっぷり飲んでよいとは言ったが…吸いすぎじゃ…ばかもの」とつぶやく八重花さん。\n・「でも…おぬしとこのビキニのせいで、何だか今日はひたすら母乳を飲んでほしい気分になってしもうた…。空っぽになるまで飲んでくれるかの…？」とおねだりする八重花さん\n・さらにイキまくる八重花さん。最後に「どうじゃ…？もうちょっと飲むかのう…？」\n\nという流れでセリフ等をお願いしたいのですが、ここで書いたセリフのままでなくてもよいので適宜変更したり足したり引いたりしていただければと思います。相手のセリフはここでは書きませんでしたが、書いていただいても構いません。\n乳輪の色はこれまでのイラストのように、濃いめでお願いします。\n母乳量は多めでお願いします。\n\nお忙しい中恐縮ですが、ご検討のほどよろしくお願い申し上げます。", "nc": 48, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Stephenflatrigh/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2397396, "client_id": 50765, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/0c8be261/uploads/origins/9e435d14-a5f2-4a96-96a5-61af796b14fd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ac3116553cac0ce867632b6118b06e77", "srcset": "https://si.imgix.net/0c8be261/uploads/origins/9e435d14-a5f2-4a96-96a5-61af796b14fd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=t