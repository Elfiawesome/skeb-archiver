, https://si.imgix.net/617255eb/uploads/origins/7af06edc-edb0-4094-956c-338498c3a949?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=bedae8b061a6472da985ce66d723536c 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/617255eb/uploads/origins/7af06edc-edb0-4094-956c-338498c3a949?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c53b8cf4e0b4d850d0df0af1874e9556", "srcset": "https://si.imgix.net/617255eb/uploads/origins/7af06edc-edb0-4094-956c-338498c3a949?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c53b8cf4e0b4d850d0df0af1874e9556, https://si.imgix.net/617255eb/uploads/origins/7af06edc-edb0-4094-956c-338498c3a949?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=4a6f642f84f35c94daae2900898544de 2x, https://si.imgix.net/617255eb/uploads/origins/7af06edc-edb0-4094-956c-338498c3a949?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=0322e4c7a9466a7d73c6ebfca55b7d15 3x"}, "body": "初めまして。\nアズレンキャラのバニーガールイラストを拝見し、素敵と感じ今回依頼させていただきました。\nお忙しい中だと存じますが、もしよろしければ以下の内容でお願いいたします。\n\nキャラはアズレンの三笠で、衣装はバニーガールでお願いします。\n黒色のタイツ着用で衣装の色はお任せします。前から見た構図で可愛らしい表情、仕草のポージングでお願いします。\n背景などは特に指定はありません。その他指定の無い部分についてはお任せします。\n\n以上の内容で問題なければ作成お願いいたします。\nよろしくお願いいたします。", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@2O7Dg8Er/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3395497, "client_id": 2973566, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/bd0934ed/uploads/origins/3f3c84d0-73ec-453b-80ee-0f7e6319408c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=016b485fc20a746a469612f88134deb9", "srcset": "https://si.imgix.net/bd0934ed/uploads/origins/3f3c84d0-73ec-453b-80ee-0f7e6319408c?bg=%23fff&au