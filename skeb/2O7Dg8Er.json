\n\n 配信のサムネイルに使う可能性があるので頭が見切れないように描いていただけますと幸いです。\n\nわたしのモデルは以下リンクをご参照いただけますと幸いです。  \n\nhttps://lit.link/shimotsukinagi \n\n以上、ご都合がよろしければどうぞよろしくお願いいたします。", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@2O7Dg8Er/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3395497, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/008633a5/uploads/origins/6c43d168-dbf7-4658-8048-f95c4e3c0212?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5e2476dd7bd2caeec8630977d4663761", "srcset": "https://si.imgix.net/008633a5/uploads/origins/6c43d168-dbf7-4658-8048-f95c4e3c0212?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5e2476dd7bd2caeec8630977d4663761, https://si.imgix.net/008633a5/uploads/origins/6c43d168-dbf7-4658-8048-f95c4e3c0212?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ccd48b9361393f5442359d1a11f4cf5e 2x, https://si.imgix.net/008633a5/uploads/origins/6c43d168-dbf7-4658-8048-f95c4e3c0212?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f88aff3cb891ce5a8dff212eeb892452 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/008633a5/uploads/origins/6c43d168-dbf7-4658-8048-f95c4e3c0212?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=717255d35e47529a0bf2cedb920dd08a", "srcset": "https://si.imgix.net/008633a5/uploads/origins/6c43d168-dbf7-4658-8048-f95c4e3c0212?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=717255d35e47529a0bf2cedb920dd08a, https://si.imgix.net/008633a5/uploads/origins/6c43d168-dbf7-4658-8048-f95c4e3c0212?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=2ac75e5dfec97c6483c206d5e2e2458b 2x, https://si.imgix.net/008633a5/uploads/origins/6c43d168-d