rs/1U1y0pSpTJqdqss-kxRBcof7Vi5eIcfy0\n\n◆女：シルク（14歳くらい）\n特殊な慣習のある小里で蝶よ花よと育てられたキャラクターです\n天真爛漫で可愛らしい性格です\n纏足で、ソハクに抱えられることが多いです\n\n◆男：ソハク（14歳くらい）\n同じ場所で勉学に励むよう育てられたキャラクターです\n大人しく表情もほとんど変えません\nシルクとともにお互いを大切にするよう生きてきました\n\n特殊な育ちのためややダークな雰囲気でも、ほのぽのした雰囲気でも\n描きやすい形でお願いできると嬉しいです！\n生まれたときから2人で寝食を共にして、それが当たり前だと思っている共依存の側面を持ちつつ\n小さな学校に通い、ときにはお祭りを楽しむなど年齢らしい生活を送っています\n\n御縁がありましたら何卒よろしくお願いいたします！\n\nhttps://drive.google.com/drive/folders/1U1y0pSpTJqdqss-kxRBcof7Vi5eIcfy0", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Ni__22_/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3379333, "client_id": 667554, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/1ff2d486/uploads/origins/3fa11e24-c721-48d1-8fba-67a82f8dcdca?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=aa7076e9ddbff92b4ad336239ae47e3f", "srcset": "https://si.imgix.net/1ff2d486/uploads/origins/3fa11e24-c721-48d1-8fba-67a82f8dcdca?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=aa7076e9ddbff92b4ad336239ae47e3f, https://si.imgix.net/1ff2d486/uploads/origins/3fa11e24-c721-48d1-8fba-67a82f8dcdca?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=0378e52361861cbc333120402166c3f3 2x, https://si.imgix.net/1ff2d486/uploads/origins/3fa11e24-c721-48d1-8fba-67a82f8dcdca?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=614a2329d95eea95b5958167f651cd08 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/1ff2d486/uploads/origins/3fa11e24-c721-48d1-8fba-67a82f8dcdca?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a4815e2963602694847cf671dbacec8e", "srcset": "https://si.imgix.net/1ff2d486/uploads/origins/3fa11e24-c721-48d1-8fba-67a82f8dcdca?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=