": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/05a9254a/uploads/origins/edec07e7-0215-407d-b5d6-a83b95a224f4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=70f63d242f93329673f0d57f4e65680a", "srcset": "https://si.imgix.net/05a9254a/uploads/origins/edec07e7-0215-407d-b5d6-a83b95a224f4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=70f63d242f93329673f0d57f4e65680a, https://si.imgix.net/05a9254a/uploads/origins/edec07e7-0215-407d-b5d6-a83b95a224f4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=1c54a741a82c152bfbc423cffa317dff 2x, https://si.imgix.net/05a9254a/uploads/origins/edec07e7-0215-407d-b5d6-a83b95a224f4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=a49c8d6c7c1de1dbd0326f1b394dd680 3x"}, "body": "こんにちは。\n『NIKKE』に登場するインディヴィリア、クラウン、チャイムを主人公にした漫画を依頼したいのですが。\n\nクラウンとチャイムには普段の服装で、インディヴィリアには参考画像を基にしたメイド服を着せてほしいです。\n\nストーリー：クラウンとチャイムがメイドカフェを訪れたところ、そこでインディヴィリアが働いているのを見て驚きます。\n\n漫画全体を1ページに収めていただきたいです。ストーリーを伝えるには4コマあれば十分だと思います。\n\n1コマ目：クラウンとチャイムがテーブルに座って注文を待っています。\n2コマ目：インディヴィリアは、二人が客だと気づき、驚きと照れくささを隠せない。\n3コマ目：インディヴィリアが接客することになると知り、クラウンとチャイムはいつものお決まりの変な顔をする。\n4コマ目：まだ照れくさそうなインディヴィリアが、料理をより美味しくする魔法の呪文を唱えながら、両手でハートのジェスチャーを作っている。インディヴィリアの手から小さなハートが飛び出し、クラウンとチャイムは嬉しそうに微笑む。\n\nhttps://drive.google.com/drive/u/0/folders/1N6JAeGTaXNZQNptJVB4sscQMMgpRFTLV", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 56382, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "(公)", "screen_name": "hamu_koutarou", "avatar_url": "https://pbs.twimg.com/profile_images/1440298249546465286/9co6n6UP.jpg", "header_url": "https://pbs.twimg.com/profile_banners/2272801422/1623562527/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_reque