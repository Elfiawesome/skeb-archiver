a3/uploads/origins/68ec2c06-c0bf-427e-8ed3-cd0c267d8de8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=dd3a76ac6874921eda916372a1ae2a32", "srcset": "https://si.imgix.net/a7d893a3/uploads/origins/68ec2c06-c0bf-427e-8ed3-cd0c267d8de8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=dd3a76ac6874921eda916372a1ae2a32, https://si.imgix.net/a7d893a3/uploads/origins/68ec2c06-c0bf-427e-8ed3-cd0c267d8de8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=0ae03afa5661d8ca4974943ea5bd1098 2x, https://si.imgix.net/a7d893a3/uploads/origins/68ec2c06-c0bf-427e-8ed3-cd0c267d8de8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=b8d7fe349339c712a45984f6bbdd3d68 3x"}, "body": "はじめまして。\nいつもAssassin先生の素晴らしい絵を拝見しております。\n2025年4月10日に先生が投稿された小鈴の絵にはいつも元気をもらっています。\nまた、先日の膕絵に関してもかねてからの膕好きとしては感動を覚えました。\n\n今回は、蓮ノ空女学院スクールアイドルクラブから徒町小鈴の絵をお願いします。\n\n服装はスクール水着で、髪型はブルウモーメント衣装のおさげのような感じです。（髪飾りは不要です）\n着用しているスクール水着の種類に関しては旧スク（水抜き穴があるタイプ）になります。\n\nシチュエーションは恥ずかしそうに膕を見せてくれている感じでお願いします。\nこれに沿っていれば、ポーズはお任せします。かわいくもちょっと微エロな雰囲気だと嬉しいです。\n（送信する際にSkeb側から注意が入ったので一応NSFWにしていますが、そこまでハードなエロでなくて大丈夫です）\n\n以上、ご多忙かとは存じますが、何卒よろしくお願いします。", "nc": 177, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@PENCILBLOOD76/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "video", "tipped": false, "creator_id": 2835159, "client_id": 1281893, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/50dc528f/uploads/outputs/8dfe140a-ab26-4b64-842f-a45eddfe4b02?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&s=2f65a504fb5b0586ddd4b948f9f8f663", "srcset": "https://si.imgix.net/50dc528f/uploads/outputs/8dfe140a-ab26-4b64-842f-a45eddfe4b02?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&s=2f65a504fb5b0586ddd4b948f9f8f663, https://si.imgix.net/50dc528f/uploads/outputs/8dfe140a-ab26-4b64-842f-a