しました。何度も読み返しています。\n可愛いの在り方、自己表現について確固としたアイデンティティを持つみるきとドロシーが、ゆめのころな様の本を読んでさらに好きになりました！あのときはありがとうございました！\n\nhttps://vir.jp/OmaLily0225", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@ymncrn/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 646785, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/be9b3ea2/uploads/origins/137db894-25af-4b07-ac8e-040b1cef63a1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e6d55a8178c625b1be14af6f6b950a61", "srcset": "https://si.imgix.net/be9b3ea2/uploads/origins/137db894-25af-4b07-ac8e-040b1cef63a1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e6d55a8178c625b1be14af6f6b950a61, https://si.imgix.net/be9b3ea2/uploads/origins/137db894-25af-4b07-ac8e-040b1cef63a1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=3b88fc93a6aa5e3a1542fd9fd7413cb1 2x, https://si.imgix.net/be9b3ea2/uploads/origins/137db894-25af-4b07-ac8e-040b1cef63a1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f5c8db3343d79c9a72fd8d74f7055e1b 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/be9b3ea2/uploads/origins/137db894-25af-4b07-ac8e-040b1cef63a1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=28d809fc89b0838f4a1f98a9bb6cd7bd", "srcset": "https://si.imgix.net/be9b3ea2/uploads/origins/137db894-25af-4b07-ac8e-040b1cef63a1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=28d809fc89b0838f4a1f98a9bb6cd7bd, https://si.imgix.net/be9b3ea2/uploads/origins/137db894-25af-4b07-ac8e-040b1cef63a1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=b0668333f17df30edd768ac2465f1cdd 2x, https://si.imgix.net/be9b3ea2/uploads/origins/137db894-25af-4b07-ac8e-040b1cef63a1