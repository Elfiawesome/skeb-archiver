2-3cb4cfd16dd5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=fc1e68862c9c22af2b4237b091f4bea7", "srcset": "https://si.imgix.net/b0bc08ba/uploads/origins/0406e77d-0df2-43da-9722-3cb4cfd16dd5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=fc1e68862c9c22af2b4237b091f4bea7, https://si.imgix.net/b0bc08ba/uploads/origins/0406e77d-0df2-43da-9722-3cb4cfd16dd5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=4ff4c9aa5090b2347a1f47fd74a21cb8 2x, https://si.imgix.net/b0bc08ba/uploads/origins/0406e77d-0df2-43da-9722-3cb4cfd16dd5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=2a7d59416a4105b818ecd1ab2c1501ee 3x"}, "body": "お久しぶりです！\n　今回も曲のイメージイラストをお願いします。 \n　お題は、FELTの「Stellar Flower」のイメージイラストです。 \n　構図は、\n　「数多の彗星が降り注ぎ、満天の星が輝く夜空。\n　輝く夜空に照らされる、一面に赤く咲き広がる彼岸花。\n　そんな彼岸花の地に1人佇む、四季映姫(体は横向き)\n　映姫は、過去に巡り合った\"名もなき魂たち\"へ鎮魂の想いを捧げている(夜空を見上げ、瞳を閉じている)\n　そんな映姫の想いに答えるかのように、彼女の周りで、儚く風に舞い散る\"名もなき花びら\"」\n\n　よろしくお願いします！", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@Last7story/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1348013, "client_id": 619172, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/5f52f538/uploads/origins/a3d03de3-bb97-49ff-9cf5-c794f0562169?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7e4467fd92ed6057d97bf0feed669fb8", "srcset": "https://si.imgix.net/5f52f538/uploads/origins/a3d03de3-bb97-49ff-9cf5-c794f0562169?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7e4467fd92ed6057d97bf0feed669fb8, https://si.imgix.net/5f52f538/uploads/origins/a3d03de3-bb97-49ff-9cf5-c794f0562169?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=58e401593da057f744f668cc3a23f11e 2x, https://si.imgix.net/5f52f538/uploads/origins/a3d