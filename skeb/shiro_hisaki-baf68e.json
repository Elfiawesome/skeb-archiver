c21c12c42e8860f73238236e06a124a 2x, https://si.imgix.net/931716ee/uploads/origins/85df7183-939a-421c-9c28-3ee39bde1524?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=150585092bf7b6f596b9fe0790d11ed4 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/931716ee/uploads/origins/85df7183-939a-421c-9c28-3ee39bde1524?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5c7ce4ae870824cf0f519b860ebe3495", "srcset": "https://si.imgix.net/931716ee/uploads/origins/85df7183-939a-421c-9c28-3ee39bde1524?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5c7ce4ae870824cf0f519b860ebe3495, https://si.imgix.net/931716ee/uploads/origins/85df7183-939a-421c-9c28-3ee39bde1524?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=cfe0baa57d16decb869d6b75f8d7eb74 2x, https://si.imgix.net/931716ee/uploads/origins/85df7183-939a-421c-9c28-3ee39bde1524?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=f53284b90d89cb3fbbfe672d857999e7 3x"}, "body": "前回は素敵なイラストをありがとうございました！\nまたリクエストさせていただきます！\n\n〇依頼内容\nもう一度私のオリキャラ「サリーナ」をお願いいたします！\n\n〇キャラクターの詳細\n冒険者ギルド所属で、穏やかで優しく、礼儀正しい正統派ヒロイン。\n落ち着きがあり、困った人を放っておけない慈しみ深さや周囲を和ませる優しさを持ち合わせている。\n\n〇シチュエーション\n落ち着いた穏やかな雰囲気の可愛いサリーナを、色っぽく描いていただけると嬉しいです！\n衣装については細かい部分はアレンジして頂いて構いません。\n細かい構図、背景等はおまかせします。\n\n〇使用用途\n観賞、SNS等でアイコンや紹介に使用します。\nまた成人向け音声作品に登場予定のキャラクターなので、Ci-en等の宣伝サイトで金銭の発生しない範囲で公開させていただく場合があります。\n\nもし背景があり、可能であればpsdまたは背景を透過したキャラクターのみのファイルも同梱していただけると嬉しいです。\n\nよろしくお願いいたします！\n\nhttps://drive.google.com/drive/folders/1_rEc3mG-xVqVs2Is2PdU0HF-WeKEqFWq", "nc": 33, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@shiro_hisaki/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3471756, "client_id": 2115643, "vtt_url": null, "thumbnail_image_