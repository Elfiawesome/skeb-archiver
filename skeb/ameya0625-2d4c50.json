 \n・可能であれば人物のみの背景透過データも頂けると嬉しいです。 \n・耳や顔回りの髪の毛などが切れないように描写して頂けますと助かります。", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@ameya0625/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 948737, "client_id": 2512743, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/780a455a/uploads/origins/51b53464-41d1-488c-8b09-33893e9e1684?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a60d1ba76d578afd6bd764cce3fb2324", "srcset": "https://si.imgix.net/780a455a/uploads/origins/51b53464-41d1-488c-8b09-33893e9e1684?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a60d1ba76d578afd6bd764cce3fb2324, https://si.imgix.net/780a455a/uploads/origins/51b53464-41d1-488c-8b09-33893e9e1684?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=310f75034cf047605be5857184a01879 2x, https://si.imgix.net/780a455a/uploads/origins/51b53464-41d1-488c-8b09-33893e9e1684?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f1d273e14f0f1a100ee3c0c22c40f13f 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/780a455a/uploads/origins/51b53464-41d1-488c-8b09-33893e9e1684?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f9196c530e174f15393270e3d233e3d4", "srcset": "https://si.imgix.net/780a455a/uploads/origins/51b53464-41d1-488c-8b09-33893e9e1684?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f9196c530e174f15393270e3d233e3d4, https://si.imgix.net/780a455a/uploads/origins/51b53464-41d1-488c-8b09-33893e9e1684?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=e74e17618a0a645d6054682f8e52e04a 2x, https://si.imgix.net/780a455a/uploads/origins/51b53464-41d1-488c-8b09-33893e9e1684?bg=%23fff&auto=format%2Ccompress&fm