たものもいただけますとありがたいです。\nまたPSDデータを頂けると幸いです。 \n\n ▼使用用途\nTwitterなどのSNS、アイコンやヘッダー。 \nFANBOX \nサムネイル\n配信活動全般に使用\n商用利用\n\nお忙しい中だと思いますがどうぞよろしくお願い致します。", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@wankosoradayo/works/13", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/2a07108d/uploads/origins/4f7d06c9-9ed0-468d-9785-a2ac1f3e72c3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=2633ea78eb96ec175d46422147ff1a20", "srcset": "https://si.imgix.net/2a07108d/uploads/origins/4f7d06c9-9ed0-468d-9785-a2ac1f3e72c3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=2633ea78eb96ec175d46422147ff1a20, https://si.imgix.net/2a07108d/uploads/origins/4f7d06c9-9ed0-468d-9785-a2ac1f3e72c3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=c0bad1a0e194fa18a5e112b870e85710 2x, https://si.imgix.net/2a07108d/uploads/origins/4f7d06c9-9ed0-468d-9785-a2ac1f3e72c3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=3b7188ed00758cec82adbb946c3aa9e9 3x"}, "private": true, "genre": "art", "tipped": false, "creator_id": 2245423, "client_id": 2469545, "nc": 129}, {"path": "/@wankosoradayo/works/12", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2245423, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/4f8132ce/uploads/origins/76133468-51b8-498d-b18f-4e78a4523e5c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=30a7c45de61adf19bc2f559dd47034b6", "srcset": "https://si.imgi