://skeb.jp/@rs_isd/works/1）のような感じで、全身のイラストをお願いしたいです。\n・背景は薄いピンクですとうれしいです。\n・服装は三面図通りでも別の服を着せていただいても問題ございません。\n・髪型は、参考資料内「髪型差分.png」から選んで描いていただきたいです。\n\n■モデルについて\n・イメージカラーは薄めのピンク、白となります。\n\n■納品形式について\n・PSDファイルでの納品、もしくは文字と人物を分けたファイル（人物のみの透過ファイル）も納品いただけますと大変助かります。\n\nご検討いただけますと幸いです。\n\nhttps://drive.google.com/drive/folders/1xBk-nwdcolIO-MQazfE7Gw5APQXv7PIF?usp=sharing", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@rs_isd/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3728500, "client_id": 2551683, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/38eaa76d/uploads/origins/eccdc086-af32-485b-8bcd-b7587ba80bc8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e77632d4fc0e5777641e34b0e1c78d6c", "srcset": "https://si.imgix.net/38eaa76d/uploads/origins/eccdc086-af32-485b-8bcd-b7587ba80bc8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e77632d4fc0e5777641e34b0e1c78d6c, https://si.imgix.net/38eaa76d/uploads/origins/eccdc086-af32-485b-8bcd-b7587ba80bc8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=6bf444fb4aa0f31b221e83a1c9837e89 2x, https://si.imgix.net/38eaa76d/uploads/origins/eccdc086-af32-485b-8bcd-b7587ba80bc8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=70df6e6859311e9752342fe72b5cc33f 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/38eaa76d/uploads/origins/eccdc086-af32-485b-8bcd-b7587ba80bc8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ec64b16f3935357de1506a8cf5ddc31b", "srcset": "https://si.imgix.net/38eaa76d/uploads/origins/eccdc086-af32-485b-8bcd-b7587ba80bc8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ec64b16f3935357de1506a8cf5ddc31b, https://si.imgix.net/38eaa76d/u