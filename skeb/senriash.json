るかはお任せします。\n特徴：ぐいぐいと距離感を縮めたりする、気さくで明るく、友達思いなアホっぽい優しい女の子。内気な友人の手を引っ張っていくタイプ。\n\n\nまたＴＲＰＧでの使用も浮く手があるため表情差分もありで\n表情\n・通常顔\n・笑顔\n・にやり顔\n・泣き顔\n・怒り顔\n・ションボリ顔\n・慌てた顔\n・真剣な顔\n・驚き顔\n・目閉じ顏\n・テレ顔\n・ーωーな顔\n服装\n・フード被り\n・フード脱ぎ\nとなります。\n\nまたもしもつけれるのでしたら、アサルトライフル（形状や銃の種類に関してはお任せいたします）を持った差分を付けれるのでしたら付けていただけると嬉しいです。\n\n割に合わないと感じたら差分は削っていただいて構いません。\n\nどうかよろしくお願いいたします。", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@senriash/works/16", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/7aecdbd5/requests/171693_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=332fe2c1ff65bd661128ac523186e192", "src_set": ""}, "private": true, "genre": "art", "tipped": true, "creator_id": 23105, "client_id": 783019, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 128, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@senriash/works/15", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/6cb86c04/requests/109296_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=fd5bedba5e45a996baeb6f1410398e6d", "src_set": ""}, "private": true, "genre": "art", "tipped": false, "creator_id": 23105, "client_id": 593261, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 0, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@senriash/works/13", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 23105, "client_id": 9148, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/a7a1e2f3/requests/111006_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=46073e0414403cb4c05893c6e82467ea", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/a7a1e2f3/requests/111006_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ddc819e83aec0a0f6b40fbbb2733886f", "src_set": ""}, "body": "（納品時期はさておき）夏なので、水着の藍夜ちゃんお願いします！\n水着の形状については一任します、似合いそうなものを見繕ってください。\n背景は額面に応じて、可能なら海辺の砂浜とか夏っぽいイメージで。\nポーズや表情は（背景によるところもあると思いますが）どこか照れ臭げだけど快活そうな雰囲気でまとめてもらえればと思っています。\nその他全般、細部で不明な点等はお手数ですが自由に描いて頂いて構いませんのでせんりさんに一任します。\nどんな風に描かれるのか、今回も楽しみにしてのんびり待っています！", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@senriash/works/12", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 23105, "client_id": 20325, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/1d62ac48/requests/94697_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=41763ba3f415dbae16234bf09e2e1ce3", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/1d62ac48/requests/94697_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=49324470e7b863f46c4d0e91bbafd168", "src_set": ""}, "body": "一度リクエストを送りましたが内容を変更してもう一度送らせていただきます。\n\n今回は2人の子を描いて頂きたいです。\n描いて頂きたい子\n拡張少女系トライナリーに登場するガブリエラ・ロタルィンスカ\nロードオブヴァーミリオンに登場する咲山小梅\n服装ですがガブリエラはドールズフロントラインのGr MG4のデフォルトの服装。\n参考情報　https://gamewith.jp/dollsfrontline/article/show/116428\n小梅はHK416のメンタルアップグレード姿で描いて欲しいです。\n参考情報　 https://wikiwiki.jp/dolls-fl/416%20MOD\n背景　シチュエーション的にはコスプレしている状況ですが背景はドルフロの世界観に合わせて廃墟や暗い感じのがいいです。\n表情　ガブリエラは結構ノリノリで楽しんでる感じで小梅はジト目な感じがいいです。\n髪型なのですがガブリエラと小梅の髪型のままを希望したいです。\nできましたら銃器も描いて頂けたら嬉しいです。\n使用目的　モニターの壁紙にしたり鑑賞のために\n要望が多いですがよろしくお願いします。", "nc": 17, "word_count": 0, "transcoder": "imag