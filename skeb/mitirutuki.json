m=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=5fa4321470b2f8e68ee3970485e1ebe4 2x, https://si.imgix.net/068b9d2e/uploads/origins/606658aa-b43c-4f38-b2ae-09774855ec1c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=104cde633dd7e7567eeab1158d51f279 3x"}, "body": "いつも素敵なイラストを見させて頂いています。この度、アシカワさんにskebにて依頼をできること、とても嬉しい限りです。\n\n使用目的は個人閲覧用&CoC探索者イメージ用。Xでのヘッダーやアイコンにも使わせて頂きたく思います。\n\n以下、依頼内容です。\n資料などがないので、文章だけになってしまうこと、ご容赦ください。\n\n【依頼内容】\n145㎝くらいの少女。腰くらいまでの白髪ロングヘア。左前髪に雪の結晶の髪飾り。感情表現に乏しくクール系な印象。\nそんな少女が仄かに笑ってる感じのイラストでお願いしたいです。\n\n構図や雰囲気、服装などはお任せしたいと思います。\n描いてもらえるだけで嬉しいので、アシカワさんの自由に描いて頂いて大丈夫です！\nSkeb依頼初めてなので不慣れな部分ありますが、何卒宜しくお願い致します！！", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@mitirutuki/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3791416, "client_id": 3141045, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/a1210d65/uploads/origins/89ef6c2f-f108-460c-ba49-003128e9a8a4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=64fcdfa7e3fde3fe98a7d2ff341bfdfd", "srcset": "https://si.imgix.net/a1210d65/uploads/origins/89ef6c2f-f108-460c-ba49-003128e9a8a4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=64fcdfa7e3fde3fe98a7d2ff341bfdfd, https://si.imgix.net/a1210d65/uploads/origins/89ef6c2f-f108-460c-ba49-003128e9a8a4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=30b6cd8589ad0bf78f07d43c073f65fb 2x, https://si.imgix.net/a1210d65/uploads/origins/89ef6c2f-f108-460c-ba49-003128e9a8a4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=9eef1aa4008f87782ce53cf643fd8479 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/a1210d65/uploads/origins/89ef6c2f-f108-460c-ba49-003128e9a8a4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=7ee257a2cb7939a0b1bc0d0958a5b394", "srcset": "https://si.imgix.net/a1210d65/uploads/origins/89ef6c2f-f108-460c-ba49-003128e9a8a4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=7ee257a2cb7939a0b1bc0d0958a5b394, https://si.imgix.net/a1210d65/uploads/origins/89ef6c2f-f108-460c-ba49-003128e9a8a4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=e14ea162c4b4231f00723b25905ae8c2 2x, https://si.imgix.net/a1210d65/uploads/origins/89ef6c2f-f108-460c-ba49-003128e9a8a4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=7bfe0d09262cef51917e7625911619dd 3x"}, "body": "私(TwitterID▶︎@totoi_imasu)の擬人化医院長を描いていただきたいです。\n以下、詳細です。\n\n･服装はいつもの格好＋頭に花かんむり(花の種類はアシカワさんにおまかせしたいです。)\n･腕の一部が苔むしている\n･表情はいつもの笑顔\n･春の陽気の中、芝生(草原でも可)に直接三角座りし、カットされたタルトケーキ(何が乗っているかはおまかせしたいです。ケーキの断面が好きなので、断面が見えるように描いていただけると嬉しい)を手掴みして自分の口に近付けている(食べようとしている)\n･長い黒髪は重力を感じるように垂れていて欲しい(風に靡きすぎない程度が好み)\n･アングルはやや正面(横を向きすぎない程度)\n･顔から三角座りをした時の膝の1部にかけてが見えるくらいの寄り(ズーム？)\n\n以上です。\n色々と細かくて申し訳ないのですが、是非アシカワさんの絵柄で描いていただきたく思い、リクエストを送らせていただきます。\n\nよろしくお願いいたします。", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@mitirutuki/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3791416, "client_id": 3810659, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/df7ca37d/uploads/origins/e0842194-e19e-47a6-b345-c427a4648979?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a495567dc6521cfc22b347597cc0d077", "srcset": "https://si.imgix.net/df7ca37d/uploads/origins/e0842194-e19e-47a6-b345-c427a4648979?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a495567dc6521cfc22b347597cc0d077, https://si.imgix.net/df7ca37d/uploads/origins/e0842194-e19e-47a6-b345-c427a4648979?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=t