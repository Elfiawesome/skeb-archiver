cd/uploads/origins/946aebe4-98b2-4306-94c7-7e1c9be55071?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f2cdc777bbfbf5509803a734c5b8a5b3 2x, https://si.imgix.net/ef7e02cd/uploads/origins/946aebe4-98b2-4306-94c7-7e1c9be55071?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=1685adbe70c1f41959dc78110ac426ab 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/ef7e02cd/uploads/origins/946aebe4-98b2-4306-94c7-7e1c9be55071?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a811c40d63315590b0c1e0642b426f12", "srcset": "https://si.imgix.net/ef7e02cd/uploads/origins/946aebe4-98b2-4306-94c7-7e1c9be55071?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a811c40d63315590b0c1e0642b426f12, https://si.imgix.net/ef7e02cd/uploads/origins/946aebe4-98b2-4306-94c7-7e1c9be55071?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=ae9c718b1813c59306bbf58e9905d0b9 2x, https://si.imgix.net/ef7e02cd/uploads/origins/946aebe4-98b2-4306-94c7-7e1c9be55071?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=184fa23da2e944a5593cf63245068229 3x"}, "body": "お世話になっております、いつも素敵なイラストをありがとうございます！blueskyや動画を拝見する度、構図や配色、細部までの丁寧さに感動し、憧れています。\n　そこでこの度、ぜひdedeenさんにオリキャラを描いていただきたい……！と強く思い、依頼させていただきました。\n\n🍁参考資料\nhttps://drive.google.com/drive/folders/18AowARiPJZRQEaSguefEphl2NOCC95Ok\n\n🍁キャラクター設定\n紅葉（もみじ）\nイメージカラー→#b77b57（櫨色）\n旧型アンドロイド/20代男性型だが童顔\n特徴:頭頂部の跳ね毛、コンセント、ヘッドギア\n🍁\n　調査/戦闘任務には忠実かつ真面目に取り組み、勤務態度も模範的ですが、機体設定のせいで口調が侍に固定されています。\n　それ故に違和感がないよう、自ら侍の格好をしています。\n　使用武器の改造拳銃はカートリッジが刀の鞘のようになっており、その鞘で敵の攻撃を受け流すこともできます。\n　植物や動物などを眺めたり、世話したりするのが好きです。感情の変化は激しくありませんが、感性は人並みです。\n\n🍁シチュエーション設定\n拳銃を構えている様子か、紅葉の葉を眺めている様子のどちらかでお願いします。（参考例参照）\nどちらでも嬉しいので、dedeenさんの描きやすいシチュエーションを選択していただけると嬉しいです！構図や配色、表情などはお任せいたします。\n\n　初めてのskebリクエストなため、細かすぎたり足りなかったりしたら申し訳ありません。\n　金額不足やリクエスト内容に問題がある場合は、場合は遠慮なく再送要請/キャンセルしていただけたらと思います。\n　何卒よろしくお願いします……！\n\nhttps://drive.google.com/drive/folders/18AowARiPJZRQEaSguefEphl2NOCC95Ok", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "similar_creators": [{"id": 5500, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "by4co🐾土曜東2ソ07a", "screen_name": "_by4co", "avatar_url": "https://pbs.twimg.com/profile_images/2053857358481362944/dUm5xSXc.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1014439178317193216/1772116258/1500x500", "appeal_receivable": false, "popular_creator_rank": 64, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "art"}], "banned": false, "nc": 176}, {"id": 751970, "creator": true, "nsfw_acceptable": true, "acceptable": false, "name": "がむてん", "screen_name": "GMT441", "avatar_url": "https://proxy.misskeyusercontent.jp/avatar.webp?url=https%3A%2F%2Fmedia.misskeyusercontent.jp%2Fio%2F0b3f5d94-7719-45e4-96c6-4fb728825387.png%3Fsensitive%3Dtrue&avatar=1", "header_url": "https://media.misskeyusercontent.jp/io/webpublic-a96b794a-9741-4708-8f4c-2ed09ba589f0.png?sensitive=true", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 120, "skills": [{"genre": "art"}], "banned": false, "nc": 49}, {"id": 1137937, "creator": true, "nsfw_acceptable": false, "acceptable": false, "name": "歌川", "screen_name": "sui5Utagawa", "avatar_url": "https://pbs.twimg.com/profile_images/1964699451819470848/2NLA-jAm.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1893084094638202880/1740499339/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": 