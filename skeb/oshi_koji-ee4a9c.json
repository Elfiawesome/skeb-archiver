e", "creator_acceptable_same_genre": false}, {"path": "/@oshi_koji/works/7", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/20867a8f/uploads/origins/00c3838f-7e60-46a1-9528-914847dcab01?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=624756c7f894294ca1e0b3b7dba4e210", "srcset": "https://si.imgix.net/20867a8f/uploads/origins/00c3838f-7e60-46a1-9528-914847dcab01?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=624756c7f894294ca1e0b3b7dba4e210, https://si.imgix.net/20867a8f/uploads/origins/00c3838f-7e60-46a1-9528-914847dcab01?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=720c78b0dcce5d0f65890a612352cf47 2x, https://si.imgix.net/20867a8f/uploads/origins/00c3838f-7e60-46a1-9528-914847dcab01?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=0cbbcdca27dca02e9694ce3383e0f091 3x"}, "private": true, "genre": "art", "tipped": true, "creator_id": 2650036, "nc": 161}, {"path": "/@oshi_koji/works/6", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/55244cf9/uploads/origins/1b6fa672-48f7-4bb5-b836-fc46e14126c2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=5db2745bc64c2634dfcf9093883de7f2", "srcset": "https://si.imgix.net/55244cf9/uploads/origins/1b6fa672-48f7-4bb5-b836-fc46e14126c2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=5db2745bc64c2634d