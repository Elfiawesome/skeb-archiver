b7da/uploads/origins/5a5116df-74b8-4dc8-a83e-d67f4c3e642d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=ebed9f346277b7288b277670c18f5799 3x"}, "body": "はじめまして。山羊骨様の絵が大好きです。  今回は私の活動に使うイラストを描いていただきたくskebを送らせていただきました。  \n\n可能であればこちらのポストのような雰囲気で描いていただきたいです(イマジナリーフレンドな設定の為、流血表現はなしでお願いします)\nhttps://x.com/yaginohone/status/2062543754054254796?s=46&t=Qp56CoCBoNSgR3w1Vo54IQ\n\n小学生くらいに見える、イマジナリーフレンドの女の子\nぼんやりとした雰囲気で、表情が少ない(たまに笑います)  \n\n上着と帽子は着脱どちらでも大丈夫ですが脱ぐ場合猫耳の耳穴は描かないでください。  \n\n構図はおまかせします。  \n\nリンクにキャラクターの詳細があるのでご覧下さい。  山羊骨様がよろしければよろしくお願いします！   \n\nhttps://drive.google.com/drive/folders/1010Nks-hASpCRZ7XGyOmvFadAXx6gsUB", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@yaginohone/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3776840, "client_id": 2355517, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/a8c52625/uploads/origins/de846455-e96b-42bd-b723-fb592c2baa06?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5e4d6fe2222b242cfaa8626707a47c23", "srcset": "https://si.imgix.net/a8c52625/uploads/origins/de846455-e96b-42bd-b723-fb592c2baa06?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5e4d6fe2222b242cfaa8626707a47c23, https://si.imgix.net/a8c52625/uploads/origins/de846455-e96b-42bd-b723-fb592c2baa06?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=71774d12b5ecc8c303e333b003557a6b 2x, https://si.imgix.net/a8c52625/uploads/origins/de846455-e96b-42bd-b723-fb592c2baa06?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=85199df1d23b9243c0d8c80802f3a84c 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/a8c52625/uploads/origins/de846455-e96b-42bd-b723-fb592c2baa06?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0709d0a085754a72e4e5929902d56f44", "srcset": "https://si.imgix.net/a8c52625/uploads/origins/de846455-e96b-42bd-b723-fb592c2baa06?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0709d0a085754a72e4e5929902d56f44, https://si.imgix.net/a8c52625/uploads/origins/de846455-e96b-42bd-b723-fb592c2baa06?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=8384429c702d6e7afe3d83296d5011c7 2x, https://si.imgix.net/a8c52625/uploads/origins/de846455-e96b-42bd-b723-fb592c2baa06?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=439a692c3a75f797dba70f275ce15457 3x"}, "body": "やぎのほねさん、こんにちは！！Twitterであなたのイラストを見て、すっかり虜になってしまいました。あなたの作品は本当に最高で、私のオリジナルキャラクター兼VTuberの「トモシ」のイラストを依頼したいです。\n \n彼女はウイスキー、ピクセルアート、ビデオゲーム、奇妙な映画が大好きなサイバーエンジェルです。多重人格を持っていて、時には面白くてエネルギッシュ、陽気でいたずら好きですが、時には気難しく、陰鬱で、不安や憂鬱に苛まれています。また、現実とのつながりを失っているような感覚もあります。\n\nでも今回のイラストでは、可能であれば「感情の屠殺天使」というテーマを表現してほしいんです。まるで彼女が邪悪で、みんなを殺し、肉や血が飛び散っているような感じですが、デジタルな要素も少し取り入れてほしいです。 服装や髪型などは、お好きなように自由に変更してください！参考画像を送りましたので、どうぞお好きなように描いてください！\n\n可能であれば、ピクセル風の翼、尾、耳、光輪、そして青い目は、元のデザインに近い形にしていただけると嬉しいです。\n\nご依頼をご検討いただき、本当にありがとうございます！(ᗒ⩊ᗕ)\n\nhttps://drive.google.com/drive/folders/1zpbhYspaeK02dd0eXb-kp1RyVaUTNh0Y?usp=sharing", "nc": 185, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@yaginohone/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3776840, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/94020ebd/uploads/origins/6e870cbb-4d1e-4e6f-bbda-68e6bb2db9d7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d127dafb4aec7a3f152e30efcc593f89", "srcset": "https://si.imgix.net/94020ebd/uploads/origins/6e870cbb-4d1e-4e6f-bbda-68e6bb2db9d7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d127dafb4aec7a3f152e30efcc593f89, https://si.imgix.net/94