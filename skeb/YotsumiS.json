: "https://si.imgix.net/cbad8f3b/uploads/origins/a47502cd-5c9d-4fe2-954d-dc603fd4fb43?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6f7591565984a72b68b64c3e5e4ce5d1", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/cbad8f3b/uploads/origins/a47502cd-5c9d-4fe2-954d-dc603fd4fb43?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=1c85a7d92a1a5468abb105512dd81cc6", "src_set": ""}, "body": "こんにちは！\nダンジョンズ＆ドラゴンズのセッションのために、トークンに作品を依頼したいんだ。\n \n私のセッションでは、ミンジと呼ばれるハーフドラゴンを演じます。\n彼女は身長1メートル近く、王冠のような形をした左右非対称の銀の角があり、翡翠色のドラコニックな目、尖った耳、軽く日焼けした肌、大きな三つ編みの白髪だが先端は黒く、かなり魅力的な女性的な顔立ちで、上半身と肩、左腕の大部分に竜の鱗の刺青があり、左手は墨で黒く染まり、右腕には指のない長い手袋をはめています。\n服装は、短いチャイナドレスにバギーパンツ、ポーチ付きの帯を締め、ビーズのブレスレットと木製の下駄を履いている。\n\n自由に改変してください。\nリクエストに応えてくれてありがとう！", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "similar_creators": [{"id": 8495, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "トモヨヒ@Skeb募集中", "screen_name": "M_tomoyohi", "avatar_url": "https://pbs.twimg.com/profile_images/1245195931756060673/exbKxDpK.jpg", "header_url": "https://pbs.twimg.com/profile_banners/96759835/1742519308/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "skills": [{"genre": "art"}], "nc": 128}, {"id": 122407, "creator": true, "nsfw_acceptable": true, "acceptable": false, "name": "月川🪼🦀", "screen_name": "tsuki_kawa", "avatar_url": "https://pbs.twimg.com/profile_images/1731166231645036544/GNS0e5Eo.png", "header_url": "https://pbs.twimg.com/profile_banners/710058073268719618/1634665488/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_d