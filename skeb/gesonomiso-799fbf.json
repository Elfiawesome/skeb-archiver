の白玖ウタノです。\nげそみ様のイラストが気になっておskebが空いた通知が来たのでこの度依頼させて頂きました。\n\nもしご縁があれば、ぜひよろしくお願いいたします。\n\n○使用用途\nSNSでの投稿\nYouTubeのサムネイル\nファンクラブ会員様への壁紙配布等\n\n○内容\n歌枠のサムネイルで使えるような、かっこかわいい1枚になると嬉しいです。\nサムネで使いやすいよう、psdデータで人物のみ背景透過で保存できるようにしていただけるととても助かります。\n\nご検討、よろしくお願いいたします✨️\n\nhttps://drive.google.com/drive/folders/1-BRt7iuEqVbDMMWAQN5bv6xJUAhz4pOB", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@gesonomiso/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2943559, "client_id": 3240523, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/2affa67e/uploads/origins/33b53230-76ab-474d-92be-6d3ad592df24?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=25402bc1e879284c6668ead05076a6f3", "srcset": "https://si.imgix.net/2affa67e/uploads/origins/33b53230-76ab-474d-92be-6d3ad592df24?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=25402bc1e879284c6668ead05076a6f3, https://si.imgix.net/2affa67e/uploads/origins/33b53230-76ab-474d-92be-6d3ad592df24?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=7670431441056ed42902cde094857e52 2x, https://si.imgix.net/2affa67e/uploads/origins/33b53230-76ab-474d-92be-6d3ad592df24?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=9ba692c4a1d7d55193c9509b32dd93dc 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/2affa67e/uploads/origins/33b53230-76ab-474d-92be-6d3ad592df24?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=34dac0b1c178afb0488f8b7f89baf534", "srcset": "https://si.imgix.net/2affa67e/uploads/origins/33b53230-76ab-474d-92be-6d3ad592df24?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=34dac0b1c178afb0488f8b7f89baf534, https://si.imgix.net/2affa67e/uploads/origins/33b53230-76ab-