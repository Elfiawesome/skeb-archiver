=200&blur=200&s=3475dba650998e93c1370dfabd35b483", "srcset": "https://si.imgix.net/f1d04b39/uploads/origins/4424cb29-4529-4957-a735-26a0e19eefb9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3475dba650998e93c1370dfabd35b483, https://si.imgix.net/f1d04b39/uploads/origins/4424cb29-4529-4957-a735-26a0e19eefb9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=d944b4739f88b9f6e051dc15b3cda7c6 2x, https://si.imgix.net/f1d04b39/uploads/origins/4424cb29-4529-4957-a735-26a0e19eefb9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=3eef064c840f1a70eb09e1acc8f31d18 3x"}, "body": "何度も依頼を受けていただいてありがとうございます。\n\n今回はうちの子の七五三掛九十九のアメリカ編の話を作っていただきたく依頼しました。\n\n存在しない海外ドラマの１話という感じで作ってもらいたいです。日常でも良いですし、事件が起こった所でも構いません。書きやすいものをお願いします。", "nc": 1, "word_count": 3706, "transcoder": "text", "creator_acceptable_same_genre": true}, {"path": "/@konainu_dog/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "novel", "tipped": false, "creator_id": 284294, "client_id": 1182929, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/8c0b89fa/uploads/origins/4499f120-6636-434f-8fad-15b149b0b72c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3a44c28cc052d434908d2f127e9fab81", "srcset": "https://si.imgix.net/8c0b89fa/uploads/origins/4499f120-6636-434f-8fad-15b149b0b72c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3a44c28cc052d434908d2f127e9fab81, https://si.imgix.net/8c0b89fa/uploads/origins/4499f120-6636-434f-8fad-15b149b0b72c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a71efb0ff705a1ce974a738101188beb 2x, https://si.imgix.net/8c0b89fa/uploads/origins/4499f120-6636-434f-8fad-15b149b0b72c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=8bd671513a4ef6297065d90a0da19db3 3x"}, "duration": null, "nsfw": true, "hardcore": true, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/8c0b89fa/uploads/origins/4499f120-6636-434f-8fad-15b149b0b72c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=cfad109f1980dc7a905efa92bcb9fac1", "srcset": "https://si.imgix.net/8c0b89fa/uploads/origins/4499f120-6636-434f-8fad-15b149b0b72c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=cfad109f1980dc7a905efa92bcb9fac1, https://si.imgix.net/8c0b89fa/uploads/origins/4499f120-6636-434f-8fad-15b149b0b72c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=1b40951aa064aa40c54f22debfd0a19a 2x, https://si.imgix.net/8c0b89fa/uploads/origins/4499f120-6636-434f-8fad-15b149b0b72c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=3c667ae993be219798f4494e4e66a445 3x"}, "body": "お世話になっております！\nいつも素晴らしい作品を世に送り出してくださりありがとうございます！\n粉犬大先生の作品をまた読みたいと思い、リクエストを送ります！\n\n▼以下、依頼したいものの説明となります\n\n\n書いていただきたいシチュエーションですが、結論から言うと『精神を元の肉体から切り離され ジージックス・エイブラムスの死体を被せられ彼の人格や記憶を植え付けられ 自身をジージックスだと思い込んでいる紫藤麗一が九十九と暖かい日常を過ごすが、最終的には九十九に全部バレてしまいバッドエンド』というものです。\n\n拙作の二次創作の続き物のようなリクエストで心苦しいのですが\n事の発端は、謎の浅黒い肌の男が病床にある紫藤の夢枕に立ち「幸せになりたいとは思いませんか」と尋ねたことです。\nこれに対し紫藤は不信感や正義感などから断るかもしれないし、または、記憶喪失という愍然たる自身の立場から、つい幸せになりたいと願ってしまうかもしれません。\nあるいは、最初に断ったとしても口八丁な浅黒男に上手く乗せられて首を縦に振るかもしれないし、最後まで断っても結局紫藤の意思は尊重されないかもしれません。\nここは書きやすいものでお任せします！\nまた、このシーンは最初の方に持ってきても最後の方に回想として持ってきて後から真相が分かるようにしても構いません。\n後者の場合は、作品の冒頭で「この作品は依頼文にネタバレを含み、また、展開に胸糞要素を含む可能性があります」という旨の文を付けた上で描写の際は(精神は紫藤のものですが外見はジージックス氏なので)真相が分かるまでは一貫してエジーもしくはジージックスと表記して頂けると嬉しいです！\n\n死体の提供は謎の浅黒肌の男でお願いします。\nジージックスの容貌は事故以前と変わらない完全な綺麗なものでなく、痛々しい火傷痕や手術痕を残した\"事故に巻き込まれたが地点から距離があったおかげで辛うじて九死に一生を得た\"と納得できる程度のもので、ジージックス氏が生きていることに高い信憑性を与えるようにしていただきたいです。綺麗なままだと九十九ちゃんに不審に思われるかもしれないので\n\nジージックス氏が自分の前に現れてから数日後、九十九ちゃんは\"紫藤さんが昏睡状態となった、理由は不明、前のように目を開くこともない\"と入間ちゃんから報せを受け、一瞬だけ「何故だろうか」と思いますが、それ以上は特に気になることはありません。そんなことよりも、死別したはずの恋人が生きていたという有り得ない事が起きたことで、この時点で九十九ちゃんの紫藤への関心は無くなっています。病室に訪れることももうないでしょう。\n\n▼できれば作中に入れてほしい描写や台詞です\n⓪前提として、九十九がアメリカで見た死体は形が変わってしまっていて間違えられたらしい別の人物だった。現代でこんなミスが起きるのは考えにくいが、死体から検出して調べられた遺伝子情報の資料が入れ違ったとのこと。\n①『久しぶりに会ったら九十九の背が伸びた気がする』という旨の台詞\n②『事故に遭ってから最近自分が自分じゃないような感じがする』旨の台詞\n③『自分はもっと◻️◻️だった気がする』『九十九と話している時に自身に違和感がある』という悩む心理描写\n④九十九と話している時 咄嗟に『私』という一人称が出て混乱する\n⑤『七五三掛くん』と呼んでしまい自分でも驚き焦って反射的に手で口元を抑える\n⑥『お前もしかして紫藤か』という旨の言及を受けたことにより自分の本来の名前を思い出し同時に記憶を取り戻す\n⑦他人に成りすましてまで自分に近づくという倫理的に一線を超えた行為に そんなことしてまで・人の気持ちを踏み躙ってまで自分の願望を叶えたかったのか と九十九ちゃんの怒りに触れる\n⑧『二度と俺の前に現れるな』と九十九ちゃんに罵倒される\n⑨今すぐ死んでしまいたくても他人の体なので傷はつけられない・自分の身体への戻り方もわからずそのまま生きていくしかない紫藤\n\n①〜②はラフな、本当にただの些細な他愛ないやり取りで、③〜④は微不穏、⑤からは完全に凍りついた修羅場な感じだと良いなと思います！入れられたら、というだけなのでこの通りにならなくても構いませんし、肉付けも全てお任せします！\n前半は甘々な日常みたいな感じだと嬉しいです！\n\n要望が多く大変かとは思いますがご検討のほどよろしくお願いいたします……！", "nc": 187, "word_count": 7922, "transcoder": "text", "creator_acceptable_same_genre": true}, {"path": "/@konainu_dog/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "novel", "tipped": false, "creator_id": 284294, "client_id": 144699, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/1ba7df67/uploads/origins/19bfd1a9-f266-4031-9620-437cdac9df82?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1dbaa640cd076f0cb2c96344e5c5c7e0", "srcset": "https://si.imgix.net/1ba7df67/uploads/origins/19bfd1a9-f266-4031-9620-437cdac9df82?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1dbaa640cd076f0cb2c96344e5c5c7e0, https://si.imgix.net/1ba7df67/uploads/origins/19bfd1a9-f266-4031-9620-437cdac9df82?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=3c690d5228e768fffffa1750db338346 2x, https://si.imgix.net/1ba7df67/uploads/origins/19bfd1a9-f266-4031-9620-437cdac9df82?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=037ebcc7147b317880a1b6d8ac036b69 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/1ba7df67/uploads/origins/19bfd1a9-f266-4031-9620-43