b-f99d68e57a60?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c6ddc89f6d2ef8c4647a1de60145af62 2x, https://si.imgix.net/1b3d2452/uploads/origins/065376f9-eed6-42ec-a6bb-f99d68e57a60?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=54ab1b26ae4228fe3dc4696f84f04b0d 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/1b3d2452/uploads/origins/065376f9-eed6-42ec-a6bb-f99d68e57a60?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=df8f8c5c9dece31143b71e41ca5ddfcf", "srcset": "https://si.imgix.net/1b3d2452/uploads/origins/065376f9-eed6-42ec-a6bb-f99d68e57a60?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=df8f8c5c9dece31143b71e41ca5ddfcf, https://si.imgix.net/1b3d2452/uploads/origins/065376f9-eed6-42ec-a6bb-f99d68e57a60?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=0a881743804ea0e8418c1e4a929b31e4 2x, https://si.imgix.net/1b3d2452/uploads/origins/065376f9-eed6-42ec-a6bb-f99d68e57a60?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=1d14619faecef73e9b65dc481476e569 3x"}, "body": "初めまして。 \n可愛らしいイラストを見かけてリクエストさせていただきました。\n\nセクシーというよりマニアックな内容で恐縮なのですが、 絆創膏フェチなので、身体中あちこちに絆創膏を貼ってる若林智香ちゃんをお願いします。 \n\n以下、主な希望になります。 \n・絆創膏は普通サイズのもの(指に巻くようなやつ)で、色も普通でテープ部分が茶色～肌色、ガーゼ部分はクリーム色っぽいものでお願いします。\n\n・顔（頬骨のあたり）、首筋、鎖骨、胸元、指(何なら全部の指に)、内腿には是非貼っていただきたいです。\n普通に怪我しそうな場所から、キスマークでも隠してるかのような場所、脇や鼠蹊部といったちょっとマニアックな場所まで貼ってれば貼ってるほど嬉しいです。 \n\n・髪型はデフォルトのポニテで、表情はお任せします。\n・貼れる場所を増やすため、衣装は露出多めなものを希望です。  \n勿論チアガール衣装でも全然OKです。\n\n難しかったらキャンセルしてください。 可能な内容でしたら何卒よろしくお願いいたします。", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@usotuki_mannjyu/works/16", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 305084, "client_id": 1125178, "vtt_url": null