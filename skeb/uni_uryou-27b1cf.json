です。\n\nhttps://drive.google.com/drive/folders/1_EmRoPZRILqoV8YMwTc-q09CJx_m_Zjq", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@uni_uryou/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3325612, "client_id": 282559, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/6cfda8b2/uploads/origins/d611d659-2303-4b8e-818c-dde92a1dbfb5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=018bd8cd287aa66e5a0ae07fa46b51d8", "srcset": "https://si.imgix.net/6cfda8b2/uploads/origins/d611d659-2303-4b8e-818c-dde92a1dbfb5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=018bd8cd287aa66e5a0ae07fa46b51d8, https://si.imgix.net/6cfda8b2/uploads/origins/d611d659-2303-4b8e-818c-dde92a1dbfb5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=2fb217bbccc11cc0dca08e572632ec3b 2x, https://si.imgix.net/6cfda8b2/uploads/origins/d611d659-2303-4b8e-818c-dde92a1dbfb5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=7a11b0a710527bfb1adb3c758eaf7c6b 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/6cfda8b2/uploads/origins/d611d659-2303-4b8e-818c-dde92a1dbfb5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5c5273b28e0310713663db08f97e60e9", "srcset": "https://si.imgix.net/6cfda8b2/uploads/origins/d611d659-2303-4b8e-818c-dde92a1dbfb5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5c5273b28e0310713663db08f97e60e9, https://si.imgix.net/6cfda8b2/uploads/origins/d611d659-2303-4b8e-818c-dde92a1dbfb5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=de25d85f86bd930bbfc774457711197b 2x, https://si.imgix.net/6cfda8b2/uploads/origins/d611d659-2303-4b8e-818c-dde92a1dbfb5?bg=%23fff&auto=format%2Cco