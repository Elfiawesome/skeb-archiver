r=200&s=affaae3d06934f66e3901289c0174b2f", "srcset": "https://si.imgix.net/a9113763/uploads/origins/8b973c6a-d236-4146-a275-c2e6892d5185?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=affaae3d06934f66e3901289c0174b2f, https://si.imgix.net/a9113763/uploads/origins/8b973c6a-d236-4146-a275-c2e6892d5185?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=6e801b5a3b86f15bf748cc9f3540d1ee 2x, https://si.imgix.net/a9113763/uploads/origins/8b973c6a-d236-4146-a275-c2e6892d5185?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=d1021c34a6bea97faa7a2dcc7951185c 3x"}, "body": "前回はとても素敵なバニーのおりょうさんをありがとうございました。ひろプリのソラちゃんを髪を下ろして前回と同じ燕尾にレオタードのバニー姿にてお願いしてもよろしいでしょうか？前回と同じく両目を開いた表情の中でお好きな表情で、顔と胴体が前向き若しくは斜め前向きにてお願いいたします。衣装の形状は同じものにてお願いしたいのですがレオタードや蝶ネクタイのカラーはソラちゃんなスカイなブルーにてお願いいたします。太もも部分は以前と同じく生足にてお願いいたします。以前描いていただいたバニーなおちゃんイラストと並べて例のなおちゃんソラちゃんの２ショットにしてみたく思いまして、左側に太ももまでのイラストを、右側に全身イラストをお願いしてよろしいでしょうか？(最初のあかねちゃんバニーの時の様な構図です)背景素材もよろしければ同じ柄の青バージョンにてお願いいたします。ソラちゃんの下ろし髪は公式位もしくはそれより長めにてお願いいたします。psd未対応のために前回と同じくpng若しくはjpgにてお願いいたします。", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@r_a_m_u_n_e/works/16", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 884854, "client_id": 20240, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/8c1e3acc/uploads/origins/d4528d96-9e54-46a7-a14f-a857434f4f0a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2074281722199e11c3f9c82260d225f1", "srcset": "https://si.imgix.net/8c1e3acc/uploads/origins/d4528d96-9e54-46a7-a14f-a857434f4f0a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2074281722199e11c3f9c82260d225f1, https://si.imgix.net/8c1e3acc/uploads/origins/d4528d96-9e54-46a7-a14f-a857434f4f0a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=243b087fa