&w=200&h=200&s=09d00eb5c1a5ce634c7e70506a54bfd5", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/dfa8e9af/uploads/origins/39679b24-5c0a-4a7f-807e-ea35afe739cb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d5c892b599593226468fc98fc9c1af05", "src_set": ""}, "body": "中砂へ\n\n僕のOCのジークを描いてほしい。普段は穏やかでおっちょこちょいだけど、悪役っぽい魅力を出してほしい。\n\nポーズや細かいところはお任せします！\n\nよろしくお願いします。\nジーク\n\nhttps://drive.google.com/drive/folders/1qI1DVCJeTTJrcn7dbMzUSrwInwjcZm-I", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@3Nakasago5/works/151", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2635934, "client_id": 300951, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/01598247/uploads/origins/8b397cf9-3f6f-4542-a920-7c3ada384c98?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b9e9322c40af6f6fd9c00168bb9ff25f", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/01598247/uploads/origins/8b397cf9-3f6f-4542-a920-7c3ada384c98?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b6028310f68cefa3dedae94fda954e04", "src_set": ""}, "body": "Nakasagoさん、初めまして。\n新着でお見受けしたイラストの作風がとても好みでリクエストを送らせてもらいました！\nもしよろしければ、うちの子を描いて頂きたいです。\n\nイメージカラーは青、クールな一面も持ちつつ、基本うるさくて戦闘狂なおてんばお姉さんです。\n武器は銃を持っていますが、なしでも大丈夫です。\n右ツノにカボチャのイヤリング（https://jp.finalfantasyxiv.com/lodestone/playguide/db/item/8931cefcffd/）を付けています。\n帽子はなしverもあると嬉しいです。\n\n表情は構図は\nhttps://skeb.jp/@3Nakasago5/works/93\nhttps://skeb.jp/@3Nakasago5/works/64\nのイラストが好きなので似た雰囲気で描いて頂きたいです。\n\nSNSアイコンにも使用したいので、宛名とキャラ単体をPSDのレイヤーでon/offできると助かります。\n下書きやラフもあれば入れて頂けると嬉しいです。\n細かい要望のリクエストになってしまいましたが、ご検討のほどよろしくお願い致します！\n\nhttps://imgur.com/a/brpOvuL", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@3Nakasago5/works/150", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2635934, "client_id": 1057810, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/3e698519/uploads/origins/784915b2-48cd-4bca-a2b1-d866688c99c9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8fef0e7f9a1cbbaf1f6fdd311fa8aafb", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/3e698519/uploads/origins/784915b2-48cd-4bca-a2b1-d866688c99c9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2665a2f15e264354ddc00342bb12a535", "src_set": ""}, "body": "こんにちは！あなたの絵に惚れました！私のキャラクターを描いていただけませんか？\n彼女の名前はアイ・マンチャで、全身にそばかすがあり、牙があるキューピッドのアクソロトルです！牙もある！目の下に一つ、唇の上下に一つ！\n彼女の性格をもっと狂気的にして、ヤンデレみたいにしてほしい！ポーズはあなた次第ですが、できれば血まみれのバージョンと血のないバージョンを見てみたいです！そうでなければ、血まみれバージョンだけでも構いません！\n一緒に仕事ができるのを楽しみにしています！\n彼女のリファレンスはこちら：https://drive.google.com/drive/u/1/folders/19jwDzG_C7DuVaBrY5o2rjJvkZZr2FqUN\n彼女を描くことを楽しんでください！\nありがとうございました！", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "similar_creators": [{"id": 1043418, "creator": true, "nsfw_acceptable": false, "acceptable": false, "name": "ﾋﾟﾋﾟｺ🐥8月本でます！", "screen_name": "p_p_twst", "avatar_url": "https://www.gravatar.com/avatar/?d=identicon", "header_url": null, "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 10, "skills": [{"genre": "art"}, {"genre": "correction"}], "nc": 32}, {"id": 2374965, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "おでん党💘skeb", "screen_name": "odentou69", "avatar_url": "https://pbs.twimg.com/profile_images/1603383335459311616/o26gCdAB.jpg", "header_url": "https://pbs.twimg.com/profile_banners/15398