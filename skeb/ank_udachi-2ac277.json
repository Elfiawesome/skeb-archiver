152/uploads/origins/1d8a01dc-e5e9-43c2-87cb-df836c8ac4e4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=34c188b75d4b1dd7b1f2f4a2c5577e8a", "srcset": "https://si.imgix.net/1bd02152/uploads/origins/1d8a01dc-e5e9-43c2-87cb-df836c8ac4e4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=34c188b75d4b1dd7b1f2f4a2c5577e8a, https://si.imgix.net/1bd02152/uploads/origins/1d8a01dc-e5e9-43c2-87cb-df836c8ac4e4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=386b0361cd06ebde0379267bb3c93264 2x, https://si.imgix.net/1bd02152/uploads/origins/1d8a01dc-e5e9-43c2-87cb-df836c8ac4e4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a7d9965f7c83157329a4a464c66ae88a 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/1bd02152/uploads/origins/1d8a01dc-e5e9-43c2-87cb-df836c8ac4e4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=17030cc61684901568c2209c664afa85", "srcset": "https://si.imgix.net/1bd02152/uploads/origins/1d8a01dc-e5e9-43c2-87cb-df836c8ac4e4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=17030cc61684901568c2209c664afa85, https://si.imgix.net/1bd02152/uploads/origins/1d8a01dc-e5e9-43c2-87cb-df836c8ac4e4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=857d0795fd4d7943f902d6cafee4aec8 2x, https://si.imgix.net/1bd02152/uploads/origins/1d8a01dc-e5e9-43c2-87cb-df836c8ac4e4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=e8407396512a4da9d1be20a94a94aced 3x"}, "body": "こんにちは！バンドガールのコミックをお願いしたいです :3！もし値段が間違っていたら再送をお願いします。\n\nキャラクター\nエミ：ボーカル＆リズムギター。元気で不器用でおバカ。不器用なところもある。\nセイユウ：リード・ギタリスト。中性的な表情で、ほとんど無関心。(優しいふりをするが、実は少し意地悪）。\nリナ（Rina）：ベーシスト＆作曲家。ツンデレ。厳しいが、すぐに振り回される。\nチュウ（Chu）：ドラマー＆リーダー。のんびり屋。姉御肌。\n\nストーリー\n何度もリハーサルをやり直し、疲れている。リナはリハーサルを続けるように勧めるが、エミーとチュウはリハーサルを今日で終わりにして、その代わりにぶらぶらしてほしいと懇願する。莉奈は我慢できず、受け入れることに。西友はただ見ている。(最後に莉奈をからかうかも）。\n何か違うものを描きたい方は、ご自由にどうぞ！\n\n文章は日本語でも構いません！リクエスト考えてくれると嬉しいです💕 よろしくお願いします\n\nhttps://drive.google.com/drive/u/0/folders/1oXq61n7qqXmnU9p4nRksgCvB5imvI61Q", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@ank_udachi/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1988444, "client_id": 1331406, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/ba3ba77e/uploads/origins/0e3b38d8-895a-478b-8205-029ec501342b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5977b5511b250eaf6930345a689e0a4d", "srcset": "https://si.imgix.net/ba3ba77e/uploads/origins/0e3b38d8-895a-478b-8205-029ec501342b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5977b5511b250eaf6930345a689e0a4d, https://si.imgix.net/ba3ba77e/uploads/origins/0e3b38d8-895a-478b-8205-029ec501342b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=58b321821338f27146bb18c1f2ef067a 2x, https://si.imgix.net/ba3ba77e/uploads/origins/0e3b38d8-895a-478b-8205-029ec501342b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f3aae658c9f4055a0b4bef112ceca418 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/ba3ba77e/uploads/origins/0e3b38d8-895a-478b-8205-029ec501342b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a1c8b51bc2df61749204f1b126d21639", "srcset": "https://si.imgix.net/ba3ba77e/uploads/origins/0e3b38d8-895a-478b-8205-029ec501342b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a1c8b51bc2df61749204f1b126d21639, https://si.imgix.net/ba3ba77e/uploads/origins/0e3b38d8-895a-478b-8205-029ec501342b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=a9d6558893d5c9366b0dadff225fe8cb 2x, https://si.imgix.net/ba3ba77e/uploads/origins/0e3b38d8-895a-478b-8205-029ec501342b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=4d4fe02c772fd268ff81f59f881baf2f 3x"}, "body": "またまたこんにちは！前回の作品がとても気に入ったので、またお願いしたいです。\n\n今回は、前回と同じキャラクターで、主に2人くらいで。最低でも2コマでお願いしたいです。足りなければ調整して再送してください。\n\nシナリオ\nシューとミハイは放課後、猫カフェに行く。シューはミハイに、新しい猫カフェがあると聞いて行ってみたいと話していた。二人はそこに行き、楽しい時間を過ごす。\n\n翌日、二人が学校にいると、シオが自分たちを置いて行ったことに腹を立てた様子で文句を言う。\n\nどうぞ、お好きなようになさってください。日本語の文章でも大丈夫です。\n\nhttps://toyhou.se/17887801.vtube-shoe-era/23279206.school - ブレザーは描かないでください。https://toyhou.se/23498222.mihai/24257342.school#73153380 - 性別に関係なく、表情があまり出ないように。 https://toyhou.se/24222652.shio#73055471 - 参考にならないので、ユニフォームを着たままジャケットを羽織ってください。\n\nありがとうございました！", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@ank_udachi/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1988444, "client_id": 1331406, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/7ba0f4d2/uploads/origins/d054ced7-b0b8-465f-906f-cecbf9289114?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6102ccd954f3d15697bc163bd30d94f0", "srcset": "https://si.imgix.net/7ba0f4d2/uploads/origins/d054ced7-b0b8-465f-906f-cecbf9289114?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6102ccd954f3d15697bc163bd30d94f0, https://si.imgix.net/7ba0f4d2/uploads/origins/d054ced7-b0b8-465f-906f-cecbf9289114?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=1c48eea9eb861f272ca39916cb5d4aaa 2x, https://si.imgix.net/7ba0f4d2/uploads/origins/d054ced7-b0b8-465f-906f-cecbf9289114?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=fb0d21dca3a0568552a699844a98ea96 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/7ba0