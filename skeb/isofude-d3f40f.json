す。\n\n・輿水幸子の服装は、「［自称・カワイイ］輿水幸子+（特訓後）」のものです。(資料URL参照)\n・Pの体長は10cm程度で、Pヘッドではなく人間の頭です。衣服ごと小さくなっているので服は普通に着ています。\n・サディスティックな笑みを浮かべる幸子が、へたり込んで怯える小さなPを踏みつけようと靴底を向けているところを大きく描いてほしいです。加えて、実際に踏みつけている足元(靴とP)の様子も絵の中に入れてください。踏みつけるといっても、潰してしまう訳ではなく、せいぜい圧迫していじめる程度のイメージです(なので、血が出たり、身体がバキバキいったりするようなことはない)\n\n以上です。\nもしよろしければ、お願いいたします。\n\nhttps://seesaawiki.jp/imascg/d/%A1%CE%BC%AB%BE%CE%A1%A6%A5%AB%A5%EF%A5%A4%A5%A4%A1%CF%CD%C1%BF%E5%B9%AC%BB%D2\n\nhttps://seesaawiki.jp/imascg/d/%A1%CE%BC%AB%BE%CE%A1%A6%A5%AB%A5%EF%A5%A4%A5%A4%A1%CF%CD%C1%BF%E5%B9%AC%BB%D2", "nc": 56, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@isofude/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 256453, "client_id": 2395892, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/162d22a5/uploads/origins/23020c1a-ad81-4640-b496-d6c06cf3b065?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b5a6f4462405cf46e18d89df502009dd", "srcset": "https://si.imgix.net/162d22a5/uploads/origins/23020c1a-ad81-4640-b496-d6c06cf3b065?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b5a6f4462405cf46e18d89df502009dd, https://si.imgix.net/162d22a5/uploads/origins/23020c1a-ad81-4640-b496-d6c06cf3b065?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b78dcf792e628bd5f6fe3abae1d26314 2x, https://si.imgix.net/162d22a5/uploads/origins/23020c1a-ad81-4640-b496-d6c06cf3b065?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=9dfafa57261675df6c8c7a27c9e51695 3x"}, "duration": null, "nsfw": true, "hardcore": true, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/162d22a5/uploads/origins/23020c1a-ad81-4640-b496-d6c06cf3b065?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9ef2646d3d729cd7a3d7caf6890df56f", "srcset": "https://si.imgix.net/162d22a5/uploads/origins/23020c1