gins/576ecec0-5c05-4010-8d6d-174043559811?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=aac0a13ff6a34b88091dcb274403b428", "srcset": "https://si.imgix.net/cd0d6b4f/uploads/origins/576ecec0-5c05-4010-8d6d-174043559811?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=aac0a13ff6a34b88091dcb274403b428, https://si.imgix.net/cd0d6b4f/uploads/origins/576ecec0-5c05-4010-8d6d-174043559811?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=8a1733badb08e7f714838be7e592d8d7 2x, https://si.imgix.net/cd0d6b4f/uploads/origins/576ecec0-5c05-4010-8d6d-174043559811?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=41a6ade5ef20253b3b2618d5d48ae1d3 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/cd0d6b4f/uploads/origins/576ecec0-5c05-4010-8d6d-174043559811?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=904ec6be90308601116b1f6cedad05f1", "srcset": "https://si.imgix.net/cd0d6b4f/uploads/origins/576ecec0-5c05-4010-8d6d-174043559811?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=904ec6be90308601116b1f6cedad05f1, https://si.imgix.net/cd0d6b4f/uploads/origins/576ecec0-5c05-4010-8d6d-174043559811?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=6745d8d7f0e561935b635e01beaa0188 2x, https://si.imgix.net/cd0d6b4f/uploads/origins/576ecec0-5c05-4010-8d6d-174043559811?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=1fcdcbb6c3fb28d751f98c6338177667 3x"}, "body": "六Pこと六水条 剣さんへ。\n毎度です。ライツ（の中の人）です。\n\n以前に描いていただいたウチの子「紅 烈火」・・・ではなく、\nその友人「御舟 牡丹」のイラストについて、依頼させてください。\n\nキャラ設定\n名前：御舟 牡丹（みふね　ぼたん）\n設定：紅 烈火のクラスメート。とある神社の娘で巫女さん。\n「～ですの」口調で話し、しっかりもの＆恋愛脳。\n男勝りな烈火に惹かれるものはありつつも世話を焼いているので、周りからは烈火の保護者のように思われてる。\n\nだが実は1000年も前から代が続く「異変」に備えた一族の末裔にあたる。\n自分の代で封印が解かれるため、それに備えて弓術を鍛えている。\n「異変」後は「鳴神の眼」という能力に目覚め、発動時には眼帯が現れ、\n見えないはずの眼から敵をターゲティングし、雷の弓矢で射る。\n\n折しも「異変」で烈火まで斬馬刀を生成する能力を得てしまい、流れのまま行動を共にする。\n自分達の戦いに巻き込まれたことに後ろめたさもあるが、全然関係なく斬馬刀で暴れる烈火には二重の意味で頭を痛めている。\n\n\n参考画像\n1：https://x.com/lights_chainsaw/status/1675868169297330176\n2：https://x.com/lights_chainsaw/status/1917188166521590195\n3：https://x.com/lights_chainsaw/status/1917188488388370766\n\n\n画像や設定を参考にイラスト内容・構図はおまかせしますが、\n可能であれば弓矢を構えた姿だと嬉しいです\nただし設定に準じて眼帯を加える場合、目の中の瞳が変化しますのでご注意ください（ターゲットサイトのようなものが現れます）\n\n補足：\n・黒髪、ゆるふわ気味の髪、瞳は青色です。\n・全体的にそれほど大きくはありません。（上も下も）\n・巫女服、制服以外の設定は今のところありません。制服は烈火のものと同じです。\n取り敢えず巫女服なら、多少画像と違うデザインでもOKです。\n・イラストに烈火を加えても構いませんが、2キャラ依頼になってしまうのでいなくても大丈夫です。", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@rokusuijo/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1870026, "client_id": 7900, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/f1b4725f/uploads/origins/66867266-c3c8-4abd-be28-31df5e765a56?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b2625a64938bea28a9faec6810d7787e", "srcset": "https://si.imgix.net/f1b4725f/uploads/origins/66867266-c3c8-4abd-be28-31df5e765a56?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b2625a64938bea28a9faec6810d7787e, https://si.imgix.net/f1b4725f/uploads/origins/66867266-c3c8-4abd-be28-31df5e765a56?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=dd5b3a02611986a0d194ef8d344571a3 2x, https://si.imgix.net/f1b4725f/uploads/origins/66867266-c3c8-4abd-be28-31df5e765a56?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=0d1089e8c7924af43de00376f040e242 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/f1b4725f/uploads/origins/66867266-c3c8-4abd-be28-31df5e765a56?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=baf