de-87f8-88bd80f3691a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=512b09556ea88d2c970ddf8b2a330273", "srcset": "https://si.imgix.net/4732d186/uploads/origins/44194685-ba1d-4fde-87f8-88bd80f3691a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=512b09556ea88d2c970ddf8b2a330273, https://si.imgix.net/4732d186/uploads/origins/44194685-ba1d-4fde-87f8-88bd80f3691a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=3f4b82d0d085ed8cbc69f9a3c263341c 2x, https://si.imgix.net/4732d186/uploads/origins/44194685-ba1d-4fde-87f8-88bd80f3691a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=ce409bdd8ce5c95e260cdac95eaecf8a 3x"}, "body": "着衣おっぱいが最高だったので可能な範囲でお願いします！\n特殊シチュなので難しそうでしたら普通のオナホコキで構いません。\n\nキャラ/慈照寺 さゆり(https://imgur.com/a/MGANXED)、橋場美世子(https://imgur.com/a/iO8jwrJ)\nシチュ：\n着衣超乳&着衣ボテ腹姿の二人に嘲笑・侮蔑されながら、ペニスがモザイク不要レベルで見えなくなる程の触手オナホ丸呑みコキで大量搾精されるドMホイホイシチュ。\n二人とももうこのマゾ豚(お兄ちゃん)ほんとしょうがないわねみたいな母性交じりの嘲笑・侮蔑の表情でお願いします。\n身長はさゆり＞美世子(美世子の方が年下のため)でお願いします。\n\n二人とも手が簡単に沈む程で顔以上のサイズかつ服の上からでも乳首がわかる感じの着衣超乳&特大着衣ボテ腹衣装の中にギチギチに押し込まれ強調されており、\n衣装は着衣超乳や着衣ボテ腹用に調整して、肌は服で隠れてしまっている完全着衣状態希望です。\n\n触手オナホは内部に複数のブラシ触手と無数の肉襞を備え、モザイク不要レベルでペニスを丸呑みにして内部で蹂躙。\n大量射精させる構造で、吐き出された大量の精子をオナホ先端部に精液水風船として貯蔵するデザインを希望します。\nまたオナホの挿入部から花状に開いた触手がM男の下半身をがっちりと拘束して決して逃げられないような構造になっており、\nペニスとの結合部から精子交じりの大量の粘液が内部触手と共に溢れ出ている様子と苦痛を感じない範囲で圧迫するよう強めに握っている表現ができましたら希望します。\n\n背景は触手肉壁もしくは禍々しい感じでお願いします。\nまたpsd形式希望で粘液まみれの触手が蠢く水音(効果音)の有り/無し、各キャラの瞳のハイライト有り/無し差分(優先度低で射精の有無差分)希望です。\n\n以下は優先度最低でお願いします。\n男性を捕縛して苗床にしているのは自身の身体の一部で男性の理想の女性型疑似餌を作って捕らえる巨大な肉塊の怪物で、\nあくまでも彼女たちは男性の好みを模して造られた意思なき肉人形に過ぎず、足や下半身等が肉壁や肉床などと融合しているという設定で作成して頂ければ幸いです。\n可能な範囲で構いませんので何卒宜しくお願いします！\n\n疑似餌参考：https://imgur.com/a/MQNHvSy\n触手オナホ参考：\n\nhttps://imgur.com/a/I02AVSy", "nc": 187, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}], "sent_works": [], "similar_creators": [{"id": 12106, "creator": true, "nsfw_acce