c59-9d4f-177bca8b87f4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=822b624d2e0312fba725c92c12f57d31, https://si.imgix.net/a3f6b6c9/uploads/origins/66925f8b-3d71-4c59-9d4f-177bca8b87f4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=6f86c3c8917ecb2baad51e9ac078ab98 2x, https://si.imgix.net/a3f6b6c9/uploads/origins/66925f8b-3d71-4c59-9d4f-177bca8b87f4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=2aa0842469b82d171e50fb9293201681 3x"}, "body": "またお会いできて嬉しいです。素敵なイラストをお願いしたいです。\n描いていただきたいのは、私のオリジナルキャラクター「Nullawhy」です。 - https://skeb.jp/@monamomm/works/68\n大きな焚き火のそばで、Nullawhyが楽しそうに座っている姿を描いてください。\nNullawhyが穏やかに座り、そのそばで炎が激しく燃え盛っている様子を描いてください。\nNullawhy（炎タイプのドラゴン）は、そばの熱を楽しんでいます。\nポーズやアングル、その他の詳細は、すべてお任せします。（テキストは不要です。）\n本当にありがとうございます！ 💕", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@mocotane/works/9", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3867933, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/89bb92b7/uploads/origins/1b78c006-ee50-4ae2-aa0c-64da077b409a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=49b62e994355994bad9a7db4ea9bb96d", "srcset": "https://si.imgix.net/89bb92b7/uploads/origins/1b78c006-ee50-4ae2-aa0c-64da077b409a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=49b62e994355994bad9a7db4ea9bb96d, https://si.imgix.net/89bb92b7/uploads/origins/1b78c006-ee50-4ae2-aa0c-64da077b409a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=96be28f02329fbf952d8a0212a522e6a 2x, https://si.imgix.net/89bb92b7/uploads/origins/1b78c006-ee50-4ae2-aa0c-64da077b409a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=acdc39fdf6a1ae06b115793858a64f16 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/89bb92b7/uploads/origins/1b78c006-ee50-4ae2-aa0c-64da077b409a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=7203113ed65ed5fa6e2df4a861b22743", "srcset": "https://si.imgix.net/89bb92b7/uploads/origins/1b78c006-ee50-4ae2-aa0c-64da077b409a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=7203113ed65ed5fa6e2df4a861b22743, https://si.imgix.net/89bb92b7/uploads/origins/1b78c006-ee50-4ae2-aa0c-64da077b409a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=421b8061150cebe008455f5442d6231f 2x, https://si.imgix.net/89bb92b7/uploads/origins/1b78c006-ee50-4ae2-aa0c-64da077b409a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=42195b104e1d38b4d67ae4e32ab7c07b 3x"}, "body": "もこたね︎︎☁⟡.·様\n\nはじめまして！香港で活動しております、個人勢VTuberの伊藤優希（いとう ゆうき）と申します。\nいつも素敵な作品を拝見しており、ぜひ私のイラストを描いていただきたいと思いリクエストいたしました。\n\n［キャラクター設定］\n春のある日、お地蔵様にお参りをした際、その無欲な性格から神様に選ばれた人間の女の子です。「永生の桜」と「幽霊を浄化する力」を授かりました。\n\n［要望・モチーフ］\n今回は「真夏」の雰囲気と「海」でお願いしたいです！\n服装、ポーズ、背景、構図などはすべてお任せいたします。\n\n※一点だけ、髪飾りの「桜の花（花のみ）」はキャラクターの重要な目印ですので、どのような形でも構いませんので絵に取り入れて（残して）いただけますと幸いです。リボンなどの装飾は自由に変更していただいて大丈夫です。\n\n［構図・形式］\n・サイズ： パソコン用壁紙（横長）\n・構成： キャラクターと背景が分かれた状態（PNG等）でいただけますと助かります。\n・注意点： 頭や髪の先が切れないように描いていただけますと幸いです。\n\n［使用用途］\n・個人利用（PC・スマホの壁紙、印刷して観賞など）\n・SNSでの公開\n・収益化済みYouTubeチャンネルでのサムネイル使用\n・ファンの方々（メンバーシップ等）への配布\n\nご検討いただけますと幸いです。\n\nhttps://drive.google.com/drive/folders/1-OyCSyoVX49aJtQrBEka2zvufaubPNRW", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@mocotane/works/8", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3867933, "client_id": 3709960, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/1e089b0a/uploads/origins/1849ce78-2f7c-46f5-8047-3cedcbbd32b1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a720196c89debe7960c28ed927cdac37", "srcset": "https://si.imgix.net/1e089b0a/uploads/origins/1849ce78-2f7c-46f5-8047-3cedcbbd32b1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a720196c89debe7960c28ed927cdac37, https://si.imgix.net/1e089b0a/uploads/origins/1849ce78-2f7c-46f5-8047-3cedcbbd32b1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c3e89ebe2c5463d68f0de7a867f26758 2x, https://si.imgix.net/1e089b0a/uploads/origins/1849ce78-2f7c-46f5-8047-3cedcbbd32b1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=274112e2c287d2bfe0e2ddbf74b95c7f 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/1e089b0a/uploads/origins/1849ce78-2f7c-46f5-8047-3cedcbbd32b1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=dd3adfaf0908602abe004b552962de11", "srcset": "https://si.imgix.net/1e089b0a/uploads/origins/1849ce78-2f7c-46f5-8047-3cedcbbd32b1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=dd3adfaf0908602abe004b552962de11, https://si.imgix.net/1e089b0a/uploads/origins/1849ce78-2f7c-46f5-8047-3cedcbbd32b1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=5d14166df185d04db242b524d76e0c1a 2x, https://si.imgix.net/1e089b0a/uploads/origins/1849ce78-2f7c-46f5-8047-3cedcbbd32b1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=474e7e5cf31137d7db58d4b3286add6a 3x"}, "body": "もこたね︎︎☁⟡.·様\n\n初めまして。\nVtuber事務所「ゆにふぃ！所属」のVtuber「風魔小宵」と申します。\n作品一覧の素敵なイラストの数々に魅力を感じ今回リクエストを送らせていただきました。\n\n【リクエスト内容】\n私自身（小宵）のイラストをお願いしたいです。\n用途の都合上、髪の毛や獣耳などが見切れない形で描いていただけますと大変助かります。\n\n【使用用途】\n・収益化済みYoutubeチャンネルでの利用（販促用途ではないですがメン限コンテンツのサムネイルの可能性使用あり）\n・X（旧Twitter）での告知・プロモーション\n※立体物での使用などの形での利用はございません。\n\n【構図について】\nポーズや背景描画については、金額に応じお任せで描いていただければ幸いです。\nサムネイル用途がメインの為ある程度16:9を意識したポージングだと助かります。\n\nまた、描画の際の注意事項として\n①瞳孔の形はデフォルトでひし形、泣きぼくろ有\n②袖の水色のレースは透け感のあるレースとなっております\n③Live2Dモデルにおいて獣耳と人耳は同時に表示されないので人耳の描写は不要です\n\n【希望納品形式】\nお任せですが、人物のみの透過pngデータをいただけると助かります\n\n【参考資料】\n下記URLに資料を添付しております。描画時のご参考にしていただければ幸いです。\nhttps://drive.google.com/file/d/1GTuH7WA0WBDWolQdmLvjC7CmRSU2coIb/view?usp=sharing\n\nご多忙のところ恐れ入りますが、ぜひご検討いただけましたら幸いです。\nどうぞよろしくお願いいたします。\n\nhttps://drive.google.com/file/d/1GTuH7WA0WBDWolQdmLvjC7CmRSU2coIb/view?usp=sharing\n\nhttps://drive.google.com/file/d/1GTuH7WA0WBDWolQdmLvjC7CmRSU2coIb/view?usp=sharing", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@mocotane/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3867933, "client_id": 3971815, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/c499de72/uploads/origins/c03e415d-4453-43a3-b7c2-e9dd1117cf8a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3fd011cef3e5f16ff0008cdd64a727ef", "srcset": "https://si.imgix.net/c499de72/uploads/origins/c03e415d-4453-43a3-b7c2-e9dd1117cf8a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3fd011cef3e5f16ff0008cdd64a727ef, https://si.imgix.net/c499de72/uploads/origins/c03e415d-4453-43a3-b7c2-e9dd1117cf8a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=791788e82b1a38881a2c591dd877ef2f 2x, https://si.imgix.net/c499de72/uploads/origins/c03e415d-4453-43a3-b7c2-e9dd1117cf8a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b83740b5021e3d33370ab568de260282 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/c499de72/uploads/origins/c03e415d-4453-43a3-b7c2-e9dd1117cf8a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b366f868b24a088aa6a1d6d26d881f0b", "srcset": "https://si.imgix.net/c499de72/uploads/origins/c03e415d-4453-43a3-b7c2-e9dd1117cf8a?bg=%23fff&auto=form