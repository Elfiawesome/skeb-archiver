4cad06367c2b 2x, https://si.imgix.net/c48b2fb4/uploads/origins/e08f6c9a-c030-4ace-84ef-fe10f9e5b867?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=78d532b551d92b0a7a34073df46f651d 3x"}, "body": "お世話になっております、メープルです！\n  ﾎ ﾁｬ！様の素敵なイラストを拝見し、 ぜひ自分の姿を描いていただきたいと思いリクエストを送らせていただきました！  \n【依頼内容】 \n私のイラストを描いていただきたいです。  構図やポージング等について指定はありません。 また服装や髪型をアレンジいただいても大丈夫ですので、ﾎ ﾁｬ！様のインスピレーションでお願いできればと思います。 顔周りが切れていないと嬉しいです。  後述の用途のため背景透過かPSDもいただけますと幸いです。  \n【参考資料】\n 外観については資料URLのGoogleドライブを参照いただければと思います。\n【使用用途】\n ・SNSでのアイコン\n・おはようVTuberポストでの使用\n・IRIAMでのアイコンリング、ヘッダーでの使用\n\nhttps://drive.google.com/file/d/11o5Q9-ESjyzsVyh_b1YYKwLZbPHqfbvG/view?usp=drivesdk", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@hota_sketch/works/10", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3895503, "client_id": 2265910, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/ea300525/uploads/origins/d7d498c7-8912-4c79-8479-6fe11e554f26?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=dfbfe32a4ef0a1078c340e9f40400176", "srcset": "https://si.imgix.net/ea300525/uploads/origins/d7d498c7-8912-4c79-8479-6fe11e554f26?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=dfbfe32a4ef0a1078c340e9f40400176, https://si.imgix.net/ea300525/uploads/origins/d7d498c7-8912-4c79-8479-6fe11e554f26?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=1f48f2c2e80548f49726b34ad149bc3d 2x, https://si.imgix.net/ea300525/uploads/origins/d7d498c7-8912-4c79-8479-6fe11e554f26?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=bed38c257b4cd62e800de4dc76b25976 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/ea300525/uploads/origins/d7d498c7-8912-4c79-8479-6fe11e554f26?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=53d3b93e807406cb485177753d808114", "srcset": "https://si.imgix.net/ea300525/uploads/origins/d7d498c7-8912-4c79-8479-6fe11e554f26?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=53d3b93e807406cb485177753d808114, https://si.imgix.net/ea300525/uploads/origins/d7d498c7-8912-4c79-8479-6fe11e554f26?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=dbe747ef4616ed32758a2018c4274ac4 2x, https://si.imgix.net/ea300525/uploads/origins/d7d498c7-8912-4c79-8479-6fe11e554f26?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=9168c9d687f9e30ebfa62f965f2ee017 3x"}, "body": "海猫ほたて様\n\nお世話になっております！\n素晴らしいイラストの数々を拝見いたしまして、ぜひ依頼させていただきたくご連絡申し上げました！\n描いていただきたいのは私のVTuberモデルです。\n何卒よろしくお願いいたします。\n\nポーズ・構図・背景・サイズ等については特段の指定はございませんが、下記の通りサムネイル等にも使用できるとありがたく、頭(耳)が切れていないと大変助かります。\n服装は普段と違うものを着ているところを個人的に見てみたく、似合いそうだな…と思うものを着せていただけますと嬉しいです！\n利用範囲は下記を想定しておる都合、背景透過かPSDも添付いただけますと助かります。\n\n【使用用途】\n1.個人観賞(ホーム画面等)\n2.Xへの投稿\n→Vtuber活動の一環として納品された次の平日にSNSへ投稿させていただきます。投稿の際は(#TwitterID)のように、タグ化し、通知の邪魔にならないようにする予定です。\n3.YouTube配信での使用\n→エンドカード等で使用させていただけますと幸甚です。\n\n【資料】\nXに立ち絵他を載せておりますので、よろしければご参考にご覧ください。\nよろしくお願いいたします。\n\nhttps://twitter.com/Fuwa_Aruto/status/1541022517246119938?s=20", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@hota_sketch/works/9", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3895503, "client_id": 1376497, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/b0da4413/uploads/origins/e2439010-e296-4017-b380-782ac41cf6ab?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=838ad626e598473a7d9b09282164534c", "srcset": "https://si.imgix.net/b0da4413/uploads/origins/e2439010-e296-4017-b380-782ac41cf6ab?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=838ad626e598473a7d9b09282164534c, https://si.imgix.net/b0da4413/uploads/origins/e2439010-e296-4017-b380-782ac41cf6ab?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=301ba94186e78a7bbed17cdd70312bcb 2x, https://si.imgix.net/b0da4413/uploads/origins/e2439010-e296-4017-b380-782ac41cf6ab?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=4a8c72c4c522bde41f8fdf04e5360492 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/b0da4413/uploads/origins/e2439010-e296-4017-b380-782ac41cf6ab?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a2d089984418aae570d08ca46736c533", "srcset": "https://si.imgix.net/b0da4413/uploads/origins/e2439010-e296-4017-b380-782ac41cf6ab?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a2d089984418aae570d08ca46736c533, https://si.imgix.net/b0da4413/uploads/origins/e2439010-e296-4017-b380-782ac41cf6ab?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=2a3703db0139b98325a6ee9a70eeaa0d 2x, https://si.imgix.net/b0da4413/uploads/origins/e2439010-e296-4017-b380-782ac41cf6ab?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=39be79a7c20d6d3564f0edf2b6be6e2f 3x"}, "body": "お世話になっております、秋世です。\nいつもとてもかわいらしくて魅力的なイラストを描かれているなと思っており是非私も描いて頂きたいと考えていたので、この機会にリクエストさせて頂きました。\n\n依頼内容\n私が活動に使用しているオリジナルキャラクターのイラストを描いて頂きたいです。\nゲーマーでクールに見えますが、ゲーム中にやらかしたり真剣なのにズレたことを言ってしまうような、どこかポンコツな変人キャラです。\n詳しくはリンク先をご参考にして頂けますと幸いです。\nhttps://lit.link/akise3\n\n服装等はそのままでもアレンジや別の衣装にするなどの変更を加えて頂いても問題ございませんが、可能であれば別のデザインでも持っている等でもよいので眼鏡的なものを描いて頂けると嬉しいです。\nポーズや構図等はお任せいたします。\n後記の使用用途があるため、全身が映っているものや髪の毛の先や指の先等が見切れていないものだと嬉しいです。\n\n使用用途\nYoutubeなどの活動やSNSで使用したいため（コラボ含むサムネイル、動画・配信内、アイコン、グッズ作成、壁紙・ネットプリント頒布等）、可能でしたらキャラクターやサインでのレイヤー分けされたpsd形式か透過画像ファイルなどのキャラクターを透過出来るファイル形式でも納品頂けますと幸いです。\n※利用時に加工（彩度や明度等の色調補正、印刷向けの色味調整、クリッピングやエフェクト、シルエット化、フィルター、フレーム付け等）が行われる可能性があります。\n\nご許可頂けない用途や至らぬ点等ございましたら、お気軽にお断り下さい。\nイラスト楽しみにしております。\n\n参考資料\nhttps://drive.google.com/file/d/1sqztMjL67ykWfoMrbqOIIDtndmtuLaRv/view?usp=sharing\n\nhttps://drive.google.com/file/d/1X13vnipw7jur45AL2yY5w2dEr8PbKdfA/view?usp=sharing", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@hota_sketch/works/8", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3895503, "client_id": 3719554, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/6c22ce88/uploads/origins/564019b1-7de3-48ce-bb2e-9a6c4a9095a1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1ae8e798dfd8cdea6e0aa36d513b616d", "srcset": "https://si.imgix.net/6c22ce88/uploads/origins/564019b1-7de3-48ce-bb2e-9a6c4a9095a1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1ae8e798dfd8cdea6e0aa36d513b616d, https://si.imgix.net/6c22ce88/uploads/origins/564019b1-7de3-48ce-bb2e-9a6c4a9095a1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=25d7228877b5a609d7a32dbed8d0d634 2x, https://si.imgix.net/6c22ce88/uploads/origins/564019b1-7de3-48ce-bb2e-9a6c4a9095a1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=389420cd4496e10af5d15306d62b8c3a 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/6c22ce88/uploads/origins/564019b1-7de3-48ce-bb2e-9a6c4a9095a1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=fb9a6735c0fbdee2a7bfd47a6eda3ee8", "srcset": "https://si.imgix.net/6c22ce88/uploads/origins/564019b1-7de3-48ce-bb2e-9a6c4a9095a1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=fb9a6735c0fbdee2a7bfd47a6eda3ee8, https://si.imgix.net/6c22ce88/uploads/origins/564019b1-7de3-48ce-bb2e-9a6c4a9095a1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w