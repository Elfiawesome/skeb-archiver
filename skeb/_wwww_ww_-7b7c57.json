nとにかくかっこいい感じで、思わずついていきたくなるような印象をお願いしたいです。その他(構図や背景など)はお任せします。\n\n(キャラクターの詳細です)\n神に次ぐ尊い位である大天使でありながら、神をも凌ぐほどの魔法を扱える大天才です。\n自信家で口調が荒く粗暴な行動も多い反面、根は真面目で人間の善性を信じており、それに従って生きています。強いカリスマ性と数々の偉業で、人々からの支持は絶大です。\n\n(他にも参考になりそうな要素をいくつか挙げておきます)\n・魔法を司っている\n・あらゆる魔法が使えるが火魔法、光魔法が特に得意\n・太陽の化身として見られる\n\n(使用用途：個人鑑賞、壁紙・プロフィール画像への設定)\n\n長くなってしまいましたが、何卒よろしくお願いします……！\n\nhttps://drive.google.com/file/d/14pNnpIZqVP49bgbbx6iH8sgkcxU4ruMq/view?usp=drivesdk", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@_wwww_ww_/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3272002, "client_id": 1825355, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/a46d3d01/uploads/origins/65ea64ef-99ea-4ff8-9c76-ed27fad20cb7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=00d6c914723210a002cf4e9ad60aa2f3", "srcset": "https://si.imgix.net/a46d3d01/uploads/origins/65ea64ef-99ea-4ff8-9c76-ed27fad20cb7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=00d6c914723210a002cf4e9ad60aa2f3, https://si.imgix.net/a46d3d01/uploads/origins/65ea64ef-99ea-4ff8-9c76-ed27fad20cb7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=9026960b9cc79fc0e66e4ebfd628c1dd 2x, https://si.imgix.net/a46d3d01/uploads/origins/65ea64ef-99ea-4ff8-9c76-ed27fad20cb7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ff9385f89739c16eb32c5045b0365dad 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/a46d3d01/uploads/origins/65ea64ef-99ea-4ff8-9c76-ed27fad20cb7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=bd386a5cc22f29af18ba03e820cbfdbd", "srcset": "https://si.imgix.net/a46d3d01/uploads/origins/65ea64ef-99ea-4ff8-9c76-ed27fad20cb7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=2