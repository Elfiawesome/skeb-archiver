何でもやってくれると思う\n\n\n▼二人の関係性\n親友兼恋人\n距離感はかなり近め。鶴城は他者との接触を好まないが、日辻くんにだけは好きな様にさせている。\n\n【資料】\n色々増えたりなんか入れてありますが全て見る必要はないです！\n\n\n以上となります。\n金額の不備等ございましたら、お手数お掛け致しますが宜しければ再送の方へ回して頂ければ幸いです。\nよろしくお願いいたします❣️❣️❣️\n\nhttps://drive.google.com/drive/folders/1mS2Ws2wypYle4U0JE5T4E9CwMFuNP5_R", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@__no0/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3352787, "client_id": 3204050, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/34835dc2/uploads/origins/49f31d9d-5244-4ba6-9407-5fd42a4c3fef?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=92f9d32fc87df3c7e30ba86a319c415f", "srcset": "https://si.imgix.net/34835dc2/uploads/origins/49f31d9d-5244-4ba6-9407-5fd42a4c3fef?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=92f9d32fc87df3c7e30ba86a319c415f, https://si.imgix.net/34835dc2/uploads/origins/49f31d9d-5244-4ba6-9407-5fd42a4c3fef?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=407bc80ada6aa813867d3d3921893e4b 2x, https://si.imgix.net/34835dc2/uploads/origins/49f31d9d-5244-4ba6-9407-5fd42a4c3fef?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=2c04113424e20c3330034aadfae10cea 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/34835dc2/uploads/origins/49f31d9d-5244-4ba6-9407-5fd42a4c3fef?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=63e67b9da47273d105a05590b6221b53", "srcset": "https://si.imgix.net/34835dc2/uploads/origins/49f31d9d-5244-4ba6-9407-5fd42a4c3fef?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=63e67b9da47273d105a05590b6221b53, https://si.imgix.net/34835dc2/uploads/origins/49f31d9d-5244-4ba6-9407-5fd42a4c3fef?bg=%23fff&auto=format%2Ccompress&fm=we