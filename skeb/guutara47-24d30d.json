%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=cbb1070abef63d7084ab28df79981140 3x"}, "body": "ぐう鱈様、こんにちは。前回はうちの子のイラストを描いて頂きありがとうございました。今回は同じキャラクターのコミックを依頼させて頂きたいです！\n\n・キャラクター資料\n(https://x.com/urapanskb/status/1725212404878098914?s=46&t=CKJ0Q1Z6AoRT86bK_dQRLQ)\n体型・服装は資料の2枚目を参考にお願いします。\nもしくは頭部のパーツだけ残して全裸でも大丈夫です！\n\nシチュエーションとしましては、おあずけされていたアルエットが我慢できずにマスターを誘惑して...というようなイメージです！\n\nページやコマ割りなどはこちらのマンガ(https://www.pixiv.net/artworks/113502146#manga)のようなイメージで、導入→挿入→ピストン→中出し→事後の流れをお願いしたいです。\nセリフは前回描いて頂いたイラスト(https://skeb.jp/@guutara47/works/7)に付けて頂いたセリフ有り差分を参考にラブラブな雰囲気のものを入れて頂けると幸いです...！！\n\n以上が依頼内容となります。色々と要望が多くなってしまい申し訳ありませんが、ご検討の程よろしくお願いいたします。", "nc": 177, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@guutara47/works/8", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2859826, "client_id": 20982, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/06cdeb3e/uploads/origins/ec4d0a21-1751-4dbb-8bf7-0cb6693d9cfb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b5fb421bc9a9d90f9d4954702bd6a6f7", "srcset": "https://si.imgix.net/06cdeb3e/uploads/origins/ec4d0a21-1751-4dbb-8bf7-0cb6693d9cfb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b5fb421bc9a9d90f9d4954702bd6a6f7, https://si.imgix.net/06cdeb3e/uploads/origins/ec4d0a21-1751-4dbb-8bf7-0cb6693d9cfb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=0be9dbe0528e84cb7b452440400fb7cb 2x, https://si.imgix.net/06cdeb3e/uploads/origins/ec4d0a21-1751-4dbb-8bf7-0cb6693d9cfb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=931046b7d24336a8a075154841385657 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/06cdeb3e/uploads/origins/ec4d0a21-1751-4dbb-8bf7-0cb6693d9cfb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=69cb0f3f35c2f1b5a891df976a8f5b5a", "srcset": "https://si.imgix.net/06cdeb3e/uploads/origins/ec4d0a21-1751-4dbb-8bf7-0cb6693d9cfb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=69cb0f3f35c2f1b5a891df976a8f5b5a, https://si.imgix.net/06cdeb3e/uploads/origins/ec4d0a21-1751-4dbb-8bf7-0cb6693d9cfb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=e2cc2f7d35587aa60a0fbe4a13171bd8 2x, https://si.imgix.net/06cdeb3e/uploads/origins/ec4d0a21-1751-4dbb-8bf7-0cb6693d9cfb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=93d8c96739374682e49c3440da95a830 3x"}, "body": "初めまして。\n乳まるだし(https://www.pixiv.net/artworks/110886195)やニクトリス(https://www.pixiv.net/artworks/114695136)の乳にグッと来ましてリクエストです。\n\nFGO、ジャック・ド・モレーの乳出しイラストをお願いします。\n自分でちょっと揉んでたり後ろから揉まれたりしてるとありがたいです。\n\nよろしくお願いします。", "nc": 177, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@guutara47/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2859826, "client_id": 1193931, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/3f2cd4b2/uploads/origins/e4c21275-9f5e-47dd-8ceb-9dad299dbb64?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0d0225b4d9c792caa8e5fb4a68a31e3d", "srcset": "https://si.imgix.net/3f2cd4b2/uploads/origins/e4c21275-9f5e-47dd-8ceb-9dad299dbb64?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0d0225b4d9c792caa8e5fb4a68a31e3d, https://si.imgix.net/3f2cd4b2/uploads/origins/e4c21275-9f5e-47dd-8ceb-9dad299dbb64?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=0b1fd48dfec90faef9ad693087ff45ac 2x, https://si.imgix.net/3f2cd4b2/uploads/origins/e4c21275-9f5e-47dd-8ceb-9dad299dbb64?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=4fa2a94a8161465ac75016dfa77adb75 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/3f2cd4b2/uploads/origins/e4c21275-9f5e-47dd-8ceb-9dad299dbb64?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=da26c5e0616eda7010ba15d00256275b", "srcset": "https://si.imgix.net/3f2cd4b2/uploads/origins/e4c21275-9f5e-47dd-8ceb-9dad299dbb64?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=da26c5e0616eda7010ba15d00256275b, https://si.imgix.net/3f2cd4b2/uploads/origins/e4c21275-9f5e-47dd-8ceb-9dad299dbb64?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=21daa5be0d23582ad86a3539cb1568af 2x, https://si.imgix.net/3f2cd4b2/uploads/origins/e4c21275-9f5e-47dd-8ceb-9dad299dbb64?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=c409914a3c9ac16ef4e4a6dbf56f2a23 3x"}, "body": "ぐう鱈様、はじめまして。とても好みな絵柄でしたのでリクエストさせて頂きます！\n\n今回は私のオリジナルキャラクターのアルエットがセックスしているイラストを依頼させて頂きたいです。\n\n・資料1\n(https://x.com/urapanskb/status/1653029691517976577?s=46&t=CKJ0Q1Z6AoRT86bK_dQRLQ)\n\n・資料2\n(https://x.com/urapanskb/status/1725212404878098914?s=46&t=CKJ0Q1Z6AoRT86bK_dQRLQ)\n\n服装や体型は資料2の1〜2枚目を参考にお願いします。構図はこちらのイラスト(https://www.pixiv.net/artworks/108864369)を参考にズラし挿入されているようにお願いします。\nもし服装や構図などが難しい場合はぐう鱈様の描きやすいようアレンジして頂ければと思います！\nまた、可能であれば中出しなどの差分を付けて頂けますと幸いです...！！\n\n以上が依頼内容となります。お忙しい中とは存じますが、ご検討の程よろしくお願いいたします。", "nc": 48, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@guutara47/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2859826, "client_id": 147489, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/3ea85061/uploads/origins/204ab014-fb6b-4a36-b96a-22307f3f8e25?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=90848cedd4502989543ec3528cb4421d", "srcset": "https://si.imgix.net/3ea