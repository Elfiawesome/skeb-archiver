46ef-90da-37a973e11b32?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&blur=200&s=8b3015fb03862e7fdf4e8b532b9ca7ab, https://si.imgix.net/e7119474/uploads/origins/7d56e3c8-24ac-46ef-90da-37a973e11b32?bg=%23fff&fm=webp&auto=compress&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=9630c3251fff8fab1d7724ac3dedd526 2x, https://si.imgix.net/e7119474/uploads/origins/7d56e3c8-24ac-46ef-90da-37a973e11b32?bg=%23fff&fm=webp&auto=compress&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=c9d4ebdad4aef280c1128d2c57681665 3x"}, "body": "くいだむい様\n\n初めまして！\nIRIAMというプラットフォームで配信活動をしています\n悠月というものです。\n\nむい様のまるっこくて大変かわいらしいSDキャラに一目ぼれしまして、もしよろしければ私を描いてほしくリクエストを送らせていただきます。\n\n■リクエスト内容\n私、悠月をSDキャラで描いてほしいです。\n衣装は下記ドライブの中にある通常衣装でお願いしたいです。\nポーズの指定はありません、描きやすいように描いてほしいです。\n\n■キャラクター詳細\n名前：悠月/ゆうげつ\n種族：クラゲ×クリオネ\n中性的なクラゲでゆったりとしたトーンでお話をします。\n感情表現が豊かなクラゲです。\n\n頭にクリオネの名残である触覚が生えている。ぷにぷにしている。\n大きな瞳に四つ葉の瞳孔(ミズクラゲの要素)\n腕や足に青いあざのような模様がある。\n｜右腕は上腕から肘にかけて。\n｜左腕は手首周辺\n｜脚は太ももと右足のすねに\n胸元に赤いジュエリーのブローチをつけている。つやつや。\n\n羽織は半透明でクラゲの触手がモチーフです。\n中の服は立ち絵の中に羽織をオフにした差分を入れているのでそちらを参照してください。\n服のデザインは簡略したり変更したりしてもらっても大丈夫です。描きやすいようにお願いします。\n\n■使用用途\n配信用のサムネイル画像、SNS上でのプロモーション画像(Xでのポスト、アイコンやヘッダーへの使用)\nYouTubeshortでの動画としての使用、支援者へ頒布するデジタルグッズ(アイコンリング、ヘッダー、ネットプリント画像など)\n※リアルグッズには使用しません。\n\n納品の際にSD本体のPNG画像データと、可能であれば宛名(サインなど)や作成されたPSDデータを合わせて納品していただけますと幸いです\n\n大変長文になってしまいましたがご検討いただけますと幸いです！\n\nhttps://drive.google.com/drive/folders/1iEI_yACHTS_T3-sqfTV__LDnnNQK2X1v?usp=sharing", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@91d4_00/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3977946, "client_id": 4008441, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/8cbd57c9/uploads/origins/57c82727-0e7e-489d-bbcf-ed251251f7d8?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&s=595f65a864147add5ee4930809216422", "srcset": "https://si.imgix.net/8cbd57c9/uploads/origins/57c82727-0e