好きなように描いて頂きたいです。\n\n時代背景は、現代日本と変わらない文化圏を想定してくださればと思います。\n幼馴染で仲が良いので、2人の楽しそうなところが見られれば、もう他には何も望みません。\n（本当に気の向くままお好きに描いていただければと思いますが、万が一構図やポーズなどでお困りのことがあれば、食べ歩きしている様子を見たいと思った事もあります）\n\n金額や内容に不備・問題等ございましたら、お手数ですがこの依頼はキャンセルして下さい。\nご検討のほど宜しくお願い致します。\n\nhttps://erla.jp/g3k/page/249075/", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@139_cheri/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3885891, "client_id": 22342, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/91b22a91/uploads/origins/e0349208-98ca-41f0-9f03-db362bf76193?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=dadc7aa82ee1db7c75420b6d1ae84e60", "srcset": "https://si.imgix.net/91b22a91/uploads/origins/e0349208-98ca-41f0-9f03-db362bf76193?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=dadc7aa82ee1db7c75420b6d1ae84e60, https://si.imgix.net/91b22a91/uploads/origins/e0349208-98ca-41f0-9f03-db362bf76193?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=21d7a9435f64de4738abf6d9a6943aa9 2x, https://si.imgix.net/91b22a91/uploads/origins/e0349208-98ca-41f0-9f03-db362bf76193?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=00ed6d5872c18e15b1a9859e541d3a8d 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/91b22a91/uploads/origins/e0349208-98ca-41f0-9f03-db362bf76193?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c48dd4c85b451079ebbe8f7c9ccc63cf", "srcset": "https://si.imgix.net/91b22a91/uploads/origins/e0349208-98ca-41f0-9f03-db362bf76193?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c48dd4c85b451079ebbe8f7c9ccc63cf, https://si.imgix.net/91b22a91/uploads/origins/e0349208-98ca-41f0-9f03-db362bf76193?bg=%23fff&auto=format%2Ccompress