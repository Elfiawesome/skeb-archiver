": true, "creator_id": 345868, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/a97ed258/uploads/origins/7945b893-3083-4018-aeba-2a451eaa2c69?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d80af001628ff0e95e6a5fbea6a9da0f", "srcset": "https://si.imgix.net/a97ed258/uploads/origins/7945b893-3083-4018-aeba-2a451eaa2c69?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d80af001628ff0e95e6a5fbea6a9da0f, https://si.imgix.net/a97ed258/uploads/origins/7945b893-3083-4018-aeba-2a451eaa2c69?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=3f613fcfe2634e8eada7d8014574f73e 2x, https://si.imgix.net/a97ed258/uploads/origins/7945b893-3083-4018-aeba-2a451eaa2c69?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=4ce616ff66d935f18a0490366a4f4735 3x"}, "duration": null, "nsfw": true, "hardcore": true, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/a97ed258/uploads/origins/7945b893-3083-4018-aeba-2a451eaa2c69?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=4df2e3123d7c7a3ab327cf889d858ed1", "srcset": "https://si.imgix.net/a97ed258/uploads/origins/7945b893-3083-4018-aeba-2a451eaa2c69?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=4df2e3123d7c7a3ab327cf889d858ed1, https://si.imgix.net/a97ed258/uploads/origins/7945b893-3083-4018-aeba-2a451eaa2c69?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=ac86f86001da9ebfde126b67fc6b3a0b 2x, https://si.imgix.net/a97ed258/uploads/origins/7945b893-3083-4018-aeba-2a451eaa2c69?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=2aa64b53ebec4dde42aab640dd56b2a7 3x"}, "body": "触手に頭を飲み込まれるイラストを依頼したものです。以前は素敵なイラストありがとうございました。もし良ければ前回のキャラクターの別シチュエーションのイラストをお願いします。\n【依頼内容】\n オリジナルキャラクターのR-18Gイラスト\n【シチュエーション】\nシュレッダーのような粉砕機に頭を顔面からぐちゃぐちゃに破壊されるシチュエーション。\n ・拘束台の上に手足を拘束され仰向けに横たわっている。頭は拘束台からはみ出ており、すぐ真下で粉砕機が稼働している。\n・少しでも頭を下げると粉砕機に呑み込まれるため、首の筋肉で頭を支えている。\n・性的な拷問を受け、大量の媚薬を注入され、全身の筋肉が膨張し汗をかき大きく勃起している。\n・最初は真上を向き敵を睨みつけ、快楽に必死に耐えていたが尿道に杭を差し込まれ刺激に耐えきれず首を反らして仰け反り大きく痙攣する。\n首を反らしてしまったせいで顔面が粉砕機に切り刻まれて破壊されてしまう。首が大きく仰け反って真上に顎の裏や喉仏や首筋を大きく晒しながら頭部が砕かれる。\n顎の先端から全身が見おろせる真上からの視点。\n【キャラ設定】 \nファンタジー世界で暮らす伝統的な部族の戦闘部門の族長。とても声が低く外見から少し怖がられることもあるが本人は非常に豪快で気さくな男らしい性格。優しく仲間思いだが、考えるよりも行動することが早く、自分の命を大切にしない行動が度々見られる。 \n 【外見設定】 \n35歳 185 cm 90kg 深い紺色の短髪。男らしい顎のガッシリした輪郭で顎の先に少し髭を生やしている。顔立ちも非常に男らしい顔をしており、目は少しタレ目気味だが大きく、瞳は少し小さく少し鋭い印象を覚える。眉毛はキリッと角度のついたつり眉。 筋肉質で特に背中と首を鍛えているためシルエットが大きく顔立ちも相まって少し威圧的に見える。胸元に巨大な何かで刺し貫かれたような大きな傷跡が残っている。 基本的な服装は紐パンツのような形状の露出度の高い下着と右腕のシンプルな腕輪のみ。\n\nhttps://skeb.jp/@sleeper_is_mine/works/55", "nc": 42, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@ukufiaD_emaM/works/13", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 345868, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/57cb33bf/uploads/origins/e71a8a0f-8f16-493e-8d5c-fb4423b4e068?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2454944d573da93d2ebba28501c0f81d", "srcset": "https://si.imgix.net/57cb33bf/uploads/origins/e71a8a0f-8f16-493e-8d5c-fb4423b4e068?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2454944d573da93d2ebba28501c0f81d, https://si.imgix.net/57cb33bf/uploads/origins/e71a8a0f-8f16-493e-8d5c-fb4423b4e068?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=cc44922e2c9c80b453bb27174dda3d2d 2x, https://si.imgix.net/57cb33bf/uploads/origins/e71a8a0f-8f16-493e-8d5c-fb4423b4e068?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=2ba1dd1abce407d70739c73d4973b45d 3x"}, "duration": null, "nsfw": true, "hardcore": true, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/57cb33bf/uploads/origins/e71a8a0f-8f16-493e-8d5c-fb4423b4e068?bg=%23fff&auto=format%2Ccompress&