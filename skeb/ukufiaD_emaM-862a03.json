どうなるかな」「女の怖さをたっぷりと思い知るがいい」と言う。\n男性は悔し涙を流しながら叫び声をあげる。", "nc": 171, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@ukufiaD_emaM/works/16", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/f1e07c63/uploads/origins/ed36e973-3939-4b3f-a508-c2c3b6a91a86?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=3dc2cf8a40dca0c8cf48afa01e980612", "srcset": "https://si.imgix.net/f1e07c63/uploads/origins/ed36e973-3939-4b3f-a508-c2c3b6a91a86?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=3dc2cf8a40dca0c8cf48afa01e980612, https://si.imgix.net/f1e07c63/uploads/origins/ed36e973-3939-4b3f-a508-c2c3b6a91a86?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=05d7a959f187e6755833cd5a0deae938 2x, https://si.imgix.net/f1e07c63/uploads/origins/ed36e973-3939-4b3f-a508-c2c3b6a91a86?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=1d987b2ffacf7c991b8b49815b9c25de 3x"}, "private": true, "genre": "art", "tipped": true, "creator_id": 345868, "nc": 48}, {"path": "/@ukufiaD_emaM/works/15", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 345868, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/76fcbbc2/uploads/origins/73a8109c-9620-42c6-8d5c-ed44d5d8230a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=dceef8ad520e72c93cb8a8296ad791bb", "srcset": "https://si.imgix.net/76fcbbc2/uploads/origins/73a8109c-9620-42c6-8d5c-ed44d5d8230a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop