=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=67ec96b7cdf2749e988da899483a0abc 3x"}, "duration": null, "nsfw": true, "hardcore": true, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/557e8efb/uploads/origins/61cf0992-9aff-4241-b214-43b94449e661?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f92e4924cca9d606cb80c594dcc3267a", "srcset": "https://si.imgix.net/557e8efb/uploads/origins/61cf0992-9aff-4241-b214-43b94449e661?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f92e4924cca9d606cb80c594dcc3267a, https://si.imgix.net/557e8efb/uploads/origins/61cf0992-9aff-4241-b214-43b94449e661?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=a104cbb7cd269a37df721fc7c5b70699 2x, https://si.imgix.net/557e8efb/uploads/origins/61cf0992-9aff-4241-b214-43b94449e661?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=8847914df133199f35d6e1d3c4d083d6 3x"}, "body": "いつもお世話になっております。かずだよ。\n\n今回はトムさん家のがぜ（カフカ）に、顔面騎乗されておなら責めされるうちの子かずを描いていただきたいです。\n\n顔騎の構図は斜め後ろアングル（僕がよく描いてたりリクエストする構図です）にてお願いします。好きなんです。あれ。\n\nがぜは煮豆を食べてるイメージが強く残っていて一番好きなので煮豆缶を散らばせてください。背景は適当でいいです。\n\nおならは特大特濃、オノマトペはどでかめでお願いします。\n\n可能であれば差分を3枚お願いしたく、（通常顔騎、おなら責めシーン、出し切ってもわぁなシーン）を描いていただきたいです。\n更にわがまま言うと表情差分もほ、欲しいのですが...可能であればで大丈夫です。（もし描写あれば、おなら責め後のかずの顔はおめめぐるぐるでお願いします）\n\n随分長い間仲良くさせていただいておりますので僕の好みはご存知かと思います。\n僕のちんちんを爆裂させる最高にドえっちなイラスト心の底からお待ちしております！\n\nhttps://www.pixiv.net/artworks/70447177", "nc": 170, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Re_gassy_gasser/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 685281, "client_id": 3442939, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/56c646d4/uploads/origins/69848f20-6ded-48f4-996f-d056a830b907?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=20