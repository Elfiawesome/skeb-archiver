rop=top&w=200&h=200&s=920f71e18cd6b83feb5d6d92d9960e56", "srcset": "https://si.imgix.net/6e797fcf/uploads/origins/7ea6fda3-137c-415b-81d2-f521bc46d037?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=920f71e18cd6b83feb5d6d92d9960e56, https://si.imgix.net/6e797fcf/uploads/origins/7ea6fda3-137c-415b-81d2-f521bc46d037?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=4a57f866a5aeff1f9945b238b0978670 2x, https://si.imgix.net/6e797fcf/uploads/origins/7ea6fda3-137c-415b-81d2-f521bc46d037?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f215a7d767f481903be8953b1357904a 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/6e797fcf/uploads/origins/7ea6fda3-137c-415b-81d2-f521bc46d037?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=73d00c4ee43990eeb66f2e32acde97c5", "srcset": "https://si.imgix.net/6e797fcf/uploads/origins/7ea6fda3-137c-415b-81d2-f521bc46d037?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=73d00c4ee43990eeb66f2e32acde97c5, https://si.imgix.net/6e797fcf/uploads/origins/7ea6fda3-137c-415b-81d2-f521bc46d037?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=3aa47f23cac0f7d7b4460fae4ed95f92 2x, https://si.imgix.net/6e797fcf/uploads/origins/7ea6fda3-137c-415b-81d2-f521bc46d037?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=77aac1fe274c45814c51d90133be6331 3x"}, "body": "かゆ様\n\nはじめまして！\nかゆ様のイラストをXで拝見しておりました。絵柄やキャラデザ、衣装デザインがとても好きで、ぜひ活動用のキャラクターを描いていただきたいと思い、募集再開の通知を見てリクエストさせていただきました！\n\n○名前\nサナ（Sana）\n\n○外見\n髪型：青みがかった黒髪(真っ黒で、光が当たると青く見えるくらい)のロングストレート。ぱっつんめの前髪。横髪は頭頂部からふわっと大きめのエアインテークで、頬下くらいで切りそろえた姫カット。\n頭頂部にぴょんとしたアホ毛が1本あります。髪は腰より長いさらさらストレート。\n瞳の色：鮮やかなロイヤルブルー（#0903A6付近）\n目元：かなり猫目ですが、丸くて大きい目\n耳：小さく尖ったエルフ耳の先から小さなサファイアのピアスを吊り下げている\n肌：色白\n体型：163cm。細身で華奢ですが胸はそこそこ、太もももニーハイに少し肉が乗るくらい。\n\n○服装\n・白いフリルブラウスに、黒いベストとプリーツミニスカート(上下繋がっていて、高めの位置にベルトをしている)\n・袖はふんわりとボリュームがあり、袖口には大きなフリル。\n・黒を基調に、鮮やかな青の差し色やリボン\n・ベルトや金具(シルバー)には少しハートモチーフ\n・左右非対称の靴下（左脚は長くて薄い白のニーハイ、右脚は同じ布の膝下までの靴下で、太ももにベルト）\n・厚底の編み上げブーツ(膝下まで)\n\n○性格\n魔法が存在する世界から来て、魔法を追い求めている。\n「魔法にいちばん近いものはなんだろう？→音楽とプログラミングだ！」と思い、音楽大学に通ったのちプログラマーになった。\n歌うことや音楽、ゲームが好きです。\n普段はマイペースで、好きなことにはとことん夢中になるタイプです。\n少しクールに見える外見ですが、のんびりした一面もあります。\n\n○その他\n外見の参考画像を添付させていただきます！(片方はハロウィン衣装のため、狼耳や衣装は参考になさらずで大丈夫です)\nhttps://drive.google.com/drive/folders/15jrl7TLouvj5cboaqRtcz1Ormd9mOHNt\n\nポーズや構図はシンプルな全身立ち絵を希望しております。イメージカラーが青なこと、髪型や瞳、衣装の特徴を大切にしていただけましたら、その他の部分はかゆ様の絵柄に合わせてアレンジしていただいて大丈夫です！\nかゆ様がかわいいと思うように自由に描いていただけましたらとても嬉しいです…！\n可能でしたら人物のみの透過データもいただけますと幸いです！\n\n○使用用途\n個人で行う予定のYouTubeでの歌・配信活動（将来的な収益化を含む）、今後のイラスト依頼の際のキャラクター・衣装資料として使用させていただく可能性がございます。\n\nご検討いただけますと幸いです。\nどうぞよろしくお願いいたします！", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@kayu_35/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2192116, "client_id": 2321627, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/0c29b558/uploads/origins/3fa02cba-6e86-4116-9a2f-69e2b6530d09?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=aedb98d5227e11aac1791a8b79d237e5", "srcset": "https://si.imgix.net/0c29b558/uploads/origins/3fa02cba-6e86-4116-9a2f-69e2b6530d09?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=aedb98d5227e11aac1791a8b79d237e5, https://si.imgix.net/0c29b558/uploads/origins/3fa02cba-6e86-4116-9a2f-69e2b6530d09?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=37779c82fedb73047f7ece6694d998fc 2x, https://si.imgix.net/0c29b558/uploads/origins/3fa02cba-6e86-4116-9a2f-69e2b6530d09?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=7665306c7658167459e7ebb029dc5552 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/0c29b558/uploads/origins/3fa02cba-6e86-4116-9a2f-69e2b6530d09?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=de5e912a217dd08d1c5cdbbcdb452da1", "srcset": "https://si.imgix.net/0c29b558/uploads/origins/3fa02cba-6e86-4116-9a2f-69e2b6530d09?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=de5e912a217dd08d1c5cdbbcdb452da1, https://si.imgix.net/0c29b558/uploads/origins/3fa02cba-6e86-4116-9a2f-69e2b6530d09?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=2b5eb03931864040ab811f30ba31e496 2x, https://si.imgix.net/0c29b558/uploads/origins/3fa02cba-6e86-4116-9a2f-69e2b6530d09?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=b381704f4f74cea2c931af950841444f 3x"}, "body": "かゆ様\n\nはじめまして、かゆ様の衣装デザインがとてもかわいいと思いましたので、リクエストさせていただきます。\n\n以下のキャラクターのイラストをお願いいたします！\n\n○名前\n　とりも\n\n○外見\n　髪型：ミルクティーベージュの前髪ありボブ\n　　　　くま耳がついている\n　瞳の色：エメラルドグリーン\n　服装：くまモチーフが散りばめられている\n　　　　上着は、だぼっとした感じ\n　　　　厚底のスニーカー\n　　　　エメラルドグリーンが入っている\n\n○性格\n　ゲームが好き\n　寝るのが好きで、のんびりしている\n\n人物のみの透過データもいただけましたら嬉しいです。\nその他は特に指定なく、かゆ様がかわいいと思うように描いていただければと思っております。\n\n使用用途は、趣味で行っているゲーム配信(収益化済)に載せたり、今後のイラスト依頼の衣装資料とする可能性があります。\n\nご検討よろしくお願いいたします。", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@kayu_35/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2192116, "client_id": 1232696, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/fb2b467d/uploads/origins/9af6cb19-f3f6-4790-9b9e-bcf726653fe8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f69fac3d410249b62826e078d97b99e4", "srcset": "https://si.imgix.net/fb2b467d/uploads/origins/9af6cb19-f3f6-4790-9b9e-bcf726653fe8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f69fac3d410249b62826e078d97b99e4, https://si.imgix.