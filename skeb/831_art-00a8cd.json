n\n■ 希望納品形式\n\n・PSDデータ\n・背景／人物／サインをレイヤー分け\n\n⸻\n\nご多忙のところ恐れ入りますが、\nご検討いただけますと大変嬉しく存じます。\n\n何卒よろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/17xgBji2d4WzWNvN-HDv0rLIlJxYHuQun", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@831_art/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2523491, "client_id": 11129, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/9cb10460/uploads/origins/85728d80-b08b-4b19-ba71-c4f5efe1df55?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3655412a05f3c8ca3413e9002ec605b2", "srcset": "https://si.imgix.net/9cb10460/uploads/origins/85728d80-b08b-4b19-ba71-c4f5efe1df55?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3655412a05f3c8ca3413e9002ec605b2, https://si.imgix.net/9cb10460/uploads/origins/85728d80-b08b-4b19-ba71-c4f5efe1df55?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=91b5c2ebf2cbe6342406f81956a6228c 2x, https://si.imgix.net/9cb10460/uploads/origins/85728d80-b08b-4b19-ba71-c4f5efe1df55?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=9f0a76a7379a65145c5015e7bc943fd4 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/9cb10460/uploads/origins/85728d80-b08b-4b19-ba71-c4f5efe1df55?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=23df34d80d77d8c71e96930bf806016c", "srcset": "https://si.imgix.net/9cb10460/uploads/origins/85728d80-b08b-4b19-ba71-c4f5efe1df55?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=23df34d80d77d8c71e96930bf806016c, https://si.imgix.net/9cb10460/uploads/origins/85728d80-b08b-4b19-ba71-c4f5efe1df55?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=bbfa75bbbc15afaa066965312d97ca14 2x, https://si.