30dc/uploads/origins/63eb4f60-6b52-4ced-b5cb-a248e5a78944?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a0bf79cdb85888d15b895c36f8ed8990 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/145d30dc/uploads/origins/63eb4f60-6b52-4ced-b5cb-a248e5a78944?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=918debff9e6cc548f2c83af1c6871616", "srcset": "https://si.imgix.net/145d30dc/uploads/origins/63eb4f60-6b52-4ced-b5cb-a248e5a78944?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=918debff9e6cc548f2c83af1c6871616, https://si.imgix.net/145d30dc/uploads/origins/63eb4f60-6b52-4ced-b5cb-a248e5a78944?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=db4b7e791b6b944718fed68b8afbbed6 2x, https://si.imgix.net/145d30dc/uploads/origins/63eb4f60-6b52-4ced-b5cb-a248e5a78944?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=eeb04cb3f66de269d36736e42e8f49e4 3x"}, "body": "竹の市様、初めまして！竹の市さんのシナリオのエンデュミオンの輪郭線で遊ばせて頂いてとても胸に残るセッションになりました。そこで、是非、エンデュミオンのPCたちを描いて頂きたくご依頼に参りました。相方さんには許可を得ております。\n\n写真家\n23歳男性、180cm\nいつも眉間に皺の寄っている男。これがデフォルトの表情で、怒っているわけではない。口数が少なく言葉選びが不穏なため周りの人間には怖がられているが、その実人にキレていることはほとんどない。態度を改めろと言われたら直そうと努力はする。反省はしている。\nセリフ例\n「……邪魔。(訳：少し横にずれて頂いてもよろしいでしょうか)」\n\n被写体\n19歳女性、150cm（大学生）\nいつも誰かしらが側にいて人に囲まれて生き、常に誰かに愛情を向けられて育ち、明朗快活な子に育った。ただ過ぎた好意も悪意も対等な人間としてみてもらえず、憧れなどで距離を取っていない一番になりたいという願望が少しだけあった。そのため、被写体として特別扱いしてくれた写真家に年上に対する憧れもあり好意を抱いている。\nセリフ例\n「せんせ、私先生の写真が一番好きよ」「知ってるよ、センセのそれってこう言う意味でしょう？」\n\n関係性\nコミュニケーションが不得意で身長も高く威圧感のある男性に対し物怖じもせず笑いかけ、言葉足らずの男性の言葉の真意を的確に読み取ってお互いの距離を深めていきました。全てが解決したあと「いつ俺の家に引っ越してくるんだ？」と独占欲や愛情の隠しきれない彼の言葉で同居することになり、大食いの彼のために料理を作ったり平和に暮らしてます。\n\n\n構図\n海で写真を撮影しており、写真家の方がカメラを構えていて被写体が振り向いている構図。写真家が困ったように笑いながら、秘めていようと思った好意を思わず「好きだ」と口に出し、被写体がまさかそんなことを言われるとは思わず驚いて少し照れているシーンをお願いできたら嬉しいです。難しい場合は好きに設定して頂けたら幸いです！\n\n金額が不足の場合は再送して頂けたら幸いです。どうぞよろしくお願いします。\n\n\nhttps://drive.google.com/drive/folders/1p90G--ivbnkUTF8VHSdHsblFycYFHS1X?usp=sharing\n\nhttps://drive.google.com/drive/folders/1p90G--ivbnkUTF8VHSdHsblFycYFHS1X?usp=sharing", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@lobuko/works/8", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2744496, "client_id": 1144752, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/543d7c12/uploads/origins/d817177a-e92e-44b5-af09-e974b9617c85?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bb72757c7f9eb4ecfa42559c6fe7e2bb", "srcset": "https://si.imgix.net/543d7c12/uploads/origins/d817177a-e92e-44b5-af09-e974b9617c85?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bb72757c7f9eb4ecfa42559c6fe7e2bb, https://si.imgix.net/543d7c12/uploads/origins/d817177a-e92e-44b5-af09-e974b9617c85?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=4ea8da7684c74676e4b3496d7a5d3f71 2x, https://si.imgix.net/543d7c12/uploads/origins/d817177a-e92e-44b5-af09-e974b9617c85?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=358cf9653ff7355b19cb7648aa51cce6 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/543d7c12/uploads/origins/d817177a-e92e-44b5-af09-e974b9617c85?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d52f2cdc2614f73ce322b1c8026e70b2", "srcset": "https://si.imgix.net/543d7c12/uploads/origins/d817177a-e92e-44b5-af09-e974b9617c85?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d52f2cdc2614f73ce322b1c8026e70b2, https://si.imgix.net/543d7c12/uploads/origins/d817177a-e92e-44b5-af09-e974b9617c85?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=8325857d1b339c2b509dcc706d3980ce 2x, https://si.imgix.net/543d7c12/uploads/origins/d817177a-e92e-44b5-af09-e974b9617c85?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=41e43370bbe47a368b5eaf0280aa1b8a 3x"}, "body": "竹の市先生こんばんは！描いていただいたものがとっても素敵だったのでまた先生にOC二人の一枚絵を描いていただきたくリクエスト失礼します。\n\n【キャラクター①】\n名前：錦織茜\n年齢：17歳(高校2年生)\n性格：文句を言いつつも手助けしてくれる、世話焼きのしっかり者。コミュニケーション能力が高い。なんでもそつなくこなす器用さが取り柄。困り顔で「仕方ないなあ」が口癖。人から頼りにされることで安心感を得るタイプ。所謂\"ワーカホリック\"と似た部類。自己肯定感が低く承認欲求が高い。八方美人。他人に対し面倒見がとてもいいが、自分のことになるとつい後回しにしてしまう。\n\n【キャラクター②】\n名前：乾千紘\n年齢：17歳(高校2年生)\n性格：クラスの人気者で常に周りに人がいる。所謂一軍陽キャ。いつもニコニコなのんびりとマイペースな人柄。基本的に誰にも分け隔てなく優しいが、本心を表に出さずどこか掴みどころのない一面もある。顔の良さとスマートな立ち振る舞いが女子の間で人気。告白されることも多いがやんわりと断っている。警戒心が強く、いつも1歩引いて話しており自分のことを詮索されるのを嫌う。\n\n【関係性】\n錦織→乾 片思いの相手。叶わないと諦めきっているが好きなものはしょうがない。友達にこんな邪な感情を抱いている自分に嫌気がさしている。何か抱えているものがあるなら力になりたいなと思っている。\n乾→錦織 隣の席の友人。周りに面倒ごとを押し付けられてもヘラヘラ笑っている錦織を不器用な人だなと思って見ていた。ちょっとほっとけない。錦織の隣ではなんだか少し息がしやすい気がする。\n\n彼らは同じクラスの隣の席の同級生です。構図等は先生にお任せしたいのですが、案に困れば下記や前回リクエスト案を参考にしてください。寒いので暖かい服を着せてあげてくれると嬉しいです…♬\n\n・お正月に神社に初詣に行く二人\n・コンビニで肉まんを食べる様子\n・休日に映画を見に行く二人\n・乾家のこたつで温まる二人(乾家は家族写真や似顔絵などが飾られている陽だまりのような暖かい空間です)\n\nhttps://drive.google.com/drive/folders/1TBebKrHtJrOKopgm9VPfSoqhletgK_PP\n\n以上となります。忙しいかと思われますがご縁がありましたらよろしくお願いいたします！", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@lobuko/works/7", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/77f6d927/uploads/origins/ca73fbcc-6a94-477c-9f78-cc2c0aabdb35?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=8ee7cb700fbb3a93d3882f3746e7e44e", "srcset": "https://si.imgix.net/77f6d927/uploads/origins/ca73fbcc-6a94-477c-9f78-cc2c0aabdb35?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=8ee7cb700fbb3a93d3882f3746e7e44e, https://si.imgix.net/77f6d927/uploads/origins/ca73fbcc-6a94-477c-9f78-cc2c0aabdb35?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=00cdb9c305e4ac94b1585c7064464a2f 2x, https://si.imgix.net/77f6d927/uploads/origins/ca73fbcc-6a94-477c-9f78-cc2c0aabdb35?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=2cd795226d4dda44243cc9b3616bcfd1 3x"}, "private": true, "genre": "art", "tipped": false, "creator_id": 2744496, "client_id": 1752592, "nc": 160}, {"path": "/@lobuko/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2744496, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/c941fa23/uploads/origins/586b3926-bcdf-4fe2-a913-6acaac7cce78?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4c8301ad8561317d9d171ac754482c82", "srcset": "https://si.imgix.net/c941fa23/uploads/origins/586b3926-bcdf-4fe2-a913-6acaac7cce78?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4c8301ad8561317d9d171ac754482c82, https://si.imgix.net/c941fa23/uploads/origins/586b3926-bcdf-4fe2-a913-6acaac7cce78?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=284ee5991b43cc4feaad06a962b67f26 2x, https://si.imgix.net/c941fa23/uploads/origins/586b3926-bcdf-4fe2-a913-6acaac7cce78?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=bb8f3d59a675a3766ed2fd9d05246eb7 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/c941fa23/uploads/origins/586b3926-bcdf-4fe2-a913-6acaac7cce78?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=de08f907a9c3e29d169718aec1cf7975", "srcset": "https://si.imgix.net/c941fa23/uploads/origins/586b3926-bcdf-4fe2-a913-6acaac7cce78?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=de08f907a9c3e29d169718aec1cf7975, https://si.imgix.net/c941fa23/uploads/origins/586b3926-bcdf-4fe2-a913-6acaac7cce78?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=64dcae9c6bf21ad545f5f50d47e13e55 2x, https://si.imgix.net/c941fa23/uploads/origins/586b3926-bcdf-4fe2-a913-6acaac7cce78?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=a6793095cb1ed305328f2bc83e7a044d 3x"}, "body": "竹の市様、お世話になっております。\n美しい立ち絵や、構図の素晴らしい一枚絵などを拝見し、是非竹の市様に依頼させていただきたいと思いリクエストを送らせていただきました。\n\n今回お願いしたいのはOC(TRPG)の探索者の一枚絵となります。\n以下、依頼内容となります。\n\n【キャラクターについて】\n・出身シナリオ\n「GODARCA」HOXII 吊るされた男\n\n・概要\n年齢不詳　186cm\nナルシストで風変わり。自分のことを「この世は自分だけで事足りる」と考えるほど美しいと思っている。\n自分の奇天烈な行動で周りが被害を被ろうが「私は美しいから」と全く反省はしない。\n考古学者で古今東西の様々な知識に詳しい。奇人・変人・知識人。トリックスターとマッドサイエンティストを足して二で割り、悪いところばかり集めました。みたいな人物。\n人生で唯一愛した人を死から自分の手元に取り戻すために、冒涜的な魔術に手を染める。\n\n他、外見的情報や細かな設定はメッセージ最後のGoogleドライブにて共有させていただきます。\n\n\n【構図、雰囲気などについて】\n①当キャラクターはタロットの大アルカナ「吊るされた男」をモチーフにしております。そちらを取り入れていただければ幸いです。\n②表情は黒幕や策士的キャラがしがちなものであると幸いです。\n③当キャラクターは女性ですが、顔、身体共に男性に近い身体付きで描いていただけると本当に嬉しいです。\n\nまた構図、雰囲気の要望に関しましては必ずではございません。\n竹の市様が描きやすい方を優先していただければと思います。\n\n\n【使用用途】\n①非営利のグッズ作成\n(チェキ風カード、アクリルパネル、タペストリー等になる可能性がございます)\n②鑑賞用、待ち受け用\n③友人との共有用\n\n以上が依頼内容となります。\n\nSkebの依頼は今回初めてで、金銭面、情報面共に相場がわかっておらず、ご迷惑をおかけしてしまっているかもしれません。何か不足している点や、間違いがありましたら再送申請いただければ幸いです。\n\nご検討のほどよろしくお願いします。\n\nGoogleドライブ:https://drive.google.com/drive/folders/1Iz1A4bgGB34agT8ZXnYVH4i7SXSOkxZl?usp=sharing", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@lobuko/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2744496, "client_id": 32760, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/18a8899a/uploads/origins/80729bd0-845f-4010-9953-84c21ba94855?bg=%23fff&auto=forma