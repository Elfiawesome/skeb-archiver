/other.html?id=9885\n・カトリーヌ\nhttps://www.nintendo.com/jp/switch/anvya/pc/characters/other.html?id=9641\nのお二人。\n\n\n▽内容\n以下の3カットを描いて頂きたいです。\n\n・横からの構図で、\n　シャミアさんがカトリーヌさんにキスをしようとしているイラスト。\n　（顎クイ、壁ドンなどのアクションが伴っていると嬉しいです）\n\n・二人それぞれの正面顔のカット\n　余裕のある感じでキメ顔のシャミアさん。\n　照れまくっているカトリーヌさん。\n\n\n▽その他\n・細かいシチュエーション（二人の関係性、衣装など）は\n　先生のイメージにお任せ致します。\n\n・背景等は無しで大丈夫です。\n\n\n以上、ご検討頂けましたら幸いです。\n宜しくお願い致します。", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@ito_katsumi/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 109599, "client_id": 43932, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/8eac24b9/uploads/origins/38b83ebe-3224-4e50-98c8-ccf99012a0c1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=518e6294cbb19aa380964448223c5c76", "srcset": "https://si.imgix.net/8eac24b9/uploads/origins/38b83ebe-3224-4e50-98c8-ccf99012a0c1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=518e6294cbb19aa380964448223c5c76, https://si.imgix.net/8eac24b9/uploads/origins/38b83ebe-3224-4e50-98c8-ccf99012a0c1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=979ed0722616950e48dc9aaf861a1031 2x, https://si.imgix.net/8eac24b9/uploads/origins/38b83ebe-3224-4e50-98c8-ccf99012a0c1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=aae908603b25d2771c51f7a9e34f0a01 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/8eac24b9/uploads/origins/38b83ebe-3224-4e50-98c8-ccf99012a0c1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=207e7d61e75fdecd892c00255cc8ca6d", "srcset": "https://si.imgix.net/8eac24b9/uploads/origins/38b83ebe-3224-4e50-98c8-ccf99012a0c1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=207e7d61e75fdecd892c00255cc8ca6d, https://si