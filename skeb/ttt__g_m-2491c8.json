%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a6a2b8ba711343fe7350f5ced4045166, https://si.imgix.net/de855c2a/uploads/origins/8fb16b6a-3f59-47b5-94f7-99b9e129a853?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=b1c5e143068a11bf1d37bee0a1ec0c21 2x, https://si.imgix.net/de855c2a/uploads/origins/8fb16b6a-3f59-47b5-94f7-99b9e129a853?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=6fba521e72c1a2b2eb8ffd51272f7777 3x"}, "body": "とさんこんにちは。\nよければ私のOCを描いていただきたいです！\n\n以前あげられていたカフェで描いたイラスト（https://twitter.com/ty_nis_/status/1606938098365263872）がとても好きなので、こちらのイラストのような普段のラフな絵柄だと嬉しいです！\n\nいただいたイラストは、商用利用を含まない個人観賞用のグッズ製作に使用させていただきたいと考えております。\nそのため、背景と人物を別レイヤーで納品していただけると幸いです！人物レイヤーが透過されていれば背景はなくてもかまいません。\n\nご検討よろしくおねがいします！\n\nhttps://drive.google.com/drive/folders/1-6tSpbOGtXznlu30CPjAgsC_G-RFPNcx?usp=sharing", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@ttt__g_m/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2915395, "client_id": 1533554, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/c5bef5dd/uploads/origins/34678210-66d3-4602-9bdf-f2ff15c4a53d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e6fc11e629fe34cd1d98d9239b6b31d8", "srcset": "https://si.imgix.net/c5bef5dd/uploads/origins/34678210-66d3-4602-9bdf-f2ff15c4a53d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e6fc11e629fe34cd1d98d9239b6b31d8, https://si.imgix.net/c5bef5dd/uploads/origins/34678210-66d3-4602-9bdf-f2ff15c4a53d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=d3340a0c581e00e71bd79934a2c87f0f 2x, https://si.imgix.net/c5bef5dd/uploads/origins/34678210-66d3-4602-9bdf-f2ff15c4a53d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=1773e8f5a50eff3042977ada7edf51d4 3x"}, "