200&h=200&blur=200&s=b7b5b1b55fbc66d173f2b0ec6c58a120 3x"}, "body": "こんにちは！あなたの作風が大好きです。私のVTuberキャラクター「Existential Bread」のイラストをお願いしたいです。ポーズや表情はお任せします。このキャラクターはツンデレで、少し得意げなところや生意気なところがあります。 このイラストは配信やサムネイル、将来的にはステッカーやキーホルダーなどのグッズにも使いたいと思っています（まだ配信を始めたばかりなので、実現するとしてもかなり先のことになると思いますが）。そのため、背景がある場合は、背景抜きでも保存できるよう、ファイル内で背景を別ファイルにしていただくようお願いいたします。 キャラクターデザインの詳細について、一部のアーティストに見落とされがちな点があります：肩の上まで伸びるストラップはなく、あれは単なる髪です。よろしくお願いします！参考画像はすべてこちらからご覧いただけます：\n\nhttps://drive.google.com/drive/folders/1ikfh-iY1eoIZYn4BMvezvQYZpx151rZM?usp=sharing", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@yotoi_sub/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3585342, "client_id": 3697760, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/74594fa1/uploads/origins/9cd359e8-a8a0-4933-a4d4-8caf1cde4e80?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ffe05e0dda7f1490a93f8e14c7d35b4a", "srcset": "https://si.imgix.net/74594fa1/uploads/origins/9cd359e8-a8a0-4933-a4d4-8caf1cde4e80?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ffe05e0dda7f1490a93f8e14c7d35b4a, https://si.imgix.net/74594fa1/uploads/origins/9cd359e8-a8a0-4933-a4d4-8caf1cde4e80?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=3a4279803863f15f0ddda7dee2a94a56 2x, https://si.imgix.net/74594fa1/uploads/origins/9cd359e8-a8a0-4933-a4d4-8caf1cde4e80?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=103296c163d7aceadc6a2974df705ffa 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/74594fa1/uploads/origins/9cd359e8-a8a0-4933-a4d4-8caf1cde4e80?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=52acc51516ff29d214def1ddde435619", "srcset": "https://si.imgix.net/74594fa1/uploads/origins/9cd359e8-a8a0-4933-a4d4-8caf1cde4e80?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=52acc51516ff29d214def1ddde435619, https://si.imgix.net/74594fa1/uploads/origins/9cd359e8-a8a0-4933-a4d4-8caf1cde4e80?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=96db5826336901e4e49929288cb48955 2x, https://si.imgix.net/74594fa1/uploads/origins/9cd359e8-a8a0-4933-a4d4-8caf1cde4e80?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=2cd409f0600a5314878f19924914038a 3x"}, "body": "こんにちは！あなたの作品が大好きです。ぜひ私のVTuber、トゥワイラを描いていただけないでしょうか！\n\nポーズや表情は、お任せします！\n\n彼女の種族は、半分ペンギン（色やふわふわした小さなペンギンのしっぽが特徴です）で、半分インプ（耳や小さなインプの角が特徴です）。 彼女はかつて、霊界で魂が幸せを見つけられるよう導く「スピリットガイド」として働いていた過去があり、その頃の亡霊に悩まされています。とても神経質で内気ですが、不気味なものなら何でも大好きです。名前「トゥワイラ」は「トワイライト（黄昏）」に由来しており、そのイメージもデザインに多く反映されています。\n \n主なデザインの特徴：\n- 頬にある星や月の形をしたそばかす\n- 尖った耳\n- 短い角 - 紫から黄色へのグラデーション、白いドットや星模様\n- 小さな牙\n- 小さくてふわふわしたペンギンのしっぽ\n- 袖の下半分は白（裏側）\n- ツインテールの下半分は白（裏側）\n- 前髪は白\n- サイドの髪は白から黄色へのグラデーション\n\nトゥワイラを一言で表すと：\n幽霊に憑かれた、トワイライト、ペンギン、小悪魔、内気、不安がり、不器用、エッジの効いた、怪談好き、ホラー映画好き、ビデオゲーム好き（あらゆるジャンル）、可愛いもの好き、ペンギン好き、アイスモカ好き、ホットチョコレート好き、ホットソース好き、猫好き\n\nどうもありがとうございます！\n\nhttps://drive.google.com/drive/folders/1b8fMBCQ6GWLWp3jCvCT0avkseH7CTCcB?usp=sharing", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@yotoi_sub/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3585342, "client_id": 3980297, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/cc1d84f3/uploads/origins/94dd7b47-5afb-4778-a3e3-bd522a89d083?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=25860bfc1db38e6b0ebfcf485beea60e", "srcset": "https://si.imgix.net/cc1d84f3/uploads/origins/94dd7b47-5afb-4778-a3e3-bd522a89d083?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=25860bfc1db38e6b0ebfcf485beea60e, https://si.imgix.net/cc