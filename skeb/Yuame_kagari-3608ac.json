urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2453939, "client_id": 2168110, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/938395c0/uploads/origins/dd88992c-e0e9-410c-bb44-072266071722?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d56096f706e67b360f348a5206067857", "srcset": "https://si.imgix.net/938395c0/uploads/origins/dd88992c-e0e9-410c-bb44-072266071722?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d56096f706e67b360f348a5206067857, https://si.imgix.net/938395c0/uploads/origins/dd88992c-e0e9-410c-bb44-072266071722?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b99278fcf3a323d7d54e8054f5fe3da9 2x, https://si.imgix.net/938395c0/uploads/origins/dd88992c-e0e9-410c-bb44-072266071722?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=3545ec9e8df43d68700e715f6b0a2632 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/938395c0/uploads/origins/dd88992c-e0e9-410c-bb44-072266071722?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=11387fb96eb371b6581ed33975df04a0", "srcset": "https://si.imgix.net/938395c0/uploads/origins/dd88992c-e0e9-410c-bb44-072266071722?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=11387fb96eb371b6581ed33975df04a0, https://si.imgix.net/938395c0/uploads/origins/dd88992c-e0e9-410c-bb44-072266071722?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=b592318888578cd9d82e44070cd6a938 2x, https://si.imgix.net/938395c0/uploads/origins/dd88992c-e0e9-410c-bb44-072266071722?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=9a73a448c0bbf6e712c303588ff861a9 3x"}, "body": "はじめまして！\n絵柄が気になったのでご依頼しました。\nもしよろしければ、うちのOCの「朝日奈ヒナ」をお願いすることは可能でしょうか？ \n参考までに設定は以下のとおりですが、自由に描いていただいて構いません。\n███\n朝日奈 陽夏（あさひな ひなつ）【姉】/ 朝日奈 陽葵（あさひな ひまり）【妹】/ヒナ【愛猫】\n年子の瓜二つの姉妹。幼い頃から共に育った愛猫のネコマタでメイクーンのヒナとは姉妹同然の仲。\n\n桜色の長髪に日の光にきらきら光る水面のような瞳を持つ。\n銀のロザリオとルビーをあしらったブローチを身につけている。\n\nどのような生き物にも変身できる他に、命の在り方に干渉する能力を持つ。\n（例えば、自他の回復力･再生力を高める、生命体の活動（知的生命体であれば思考も含む）に干渉する、命そのものを分けたりくっつけたり与えたり奪ったりする、粘土のように生命体をこねくり回して新たな生命体を創る等）\n両親も敬虔な信徒だったこともあり、信心深く育った二人は、生命を冒涜するようなやたらな能力使用を自ら禁じている。\n開闢のスピカ、アニメーター等の異名を持つ。\n\n悪魔との戦いが本格化する1年前に何者かによって愛猫共々姉妹そろって殺されている。\n愛猫の方は姉妹から命と能力を分け与えられた事で息を吹き返すが、姉妹はそのまま力尽きる。（蘇生が間に合わずに姉妹は死が確定する。）\n姉妹そっくりの姿で蘇ったヒナは、残された姉妹の死体と残留していた姉妹の魂をこねくり回して、蘇る前の自分の猫だった時の姿を象り、使い魔の猫「ヒマ」（赤い毛色をしたメイクーン）を創り出した。\n\n姉妹を殺した能力者に復讐するべく、ヒマに探らせている。\n切金茜のトラウマ克服に協力するが、能力を解放した切金茜を仇と思い込み、背後から瀕死の重症を与えてしまった。\n\n蘇ってヒトの姿になった愛猫のヒナは、自分の事を朝日奈ヒナと名乗っている。\n元が猫だったからか、能力使用時には気を抜くと猫耳と2本の尻尾が生えてくる。\n███\n使用用途は個人活動全般(小説の挿絵等、SNSや個人サイト等でのキャラクター紹介・個人活動の告知等)を考えています。\nもしご都合が合えばよろしくお願いします。\n\nhttps://drive.google.com/drive/folders/1--CcvU3rwxKlDDytmDmMlUS4PIy8aDmL", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 18270, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "あんな┊ANNA", "screen_name": "ANNA_dndntic", "avatar_url": "https://pbs.twimg.com/profile_images/2014275432217276416/CqicYrK0.jpg", "header_url": "https://pbs.twimg.com/profile_banners/2460639438/1780440483/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 10, "complete_expiration_days": 60, "skills": [{"genre": "art"}], "banned": false, "nc": 160}, {"id": 178212, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "赤井剣", "screen_name": "ken_akai__", "avatar_url": "https://pbs.twimg.com/profile_images/1514967609199845378/1sX5cxe0.jpg", "header_url": "https://pbs.twimg.com/profile_banners/970879376756695041/1641899037/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_