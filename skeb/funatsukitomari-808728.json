?s=20\n\nこちらに黒田猫助の立ち絵と三面図がございます。恐れ入りますがご確認をお願いします\n服装は和服でお願いします\n\nお忙しいところ恐縮ですが、ご検討のほどどうぞよろしくお願い致します。\n\n黒田猫助\n\nhttps://x.com/V_nekosuke/status/1875621096936165471\n\nhttps://x.com/V_nekosuke/status/2020626195772281285?s=20", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@funatsukitomari/works/8", "private_thumbnail_image_urls": null, "private": false, "genre": "comic", "tipped": false, "creator_id": 1908168, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/5b3b3437/uploads/origins/4b42ed00-68bc-4b66-b6dd-68380c1b218d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=381e71d307dbbb43561e8f38f0696e4c", "srcset": "https://si.imgix.net/5b3b3437/uploads/origins/4b42ed00-68bc-4b66-b6dd-68380c1b218d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=381e71d307dbbb43561e8f38f0696e4c, https://si.imgix.net/5b3b3437/uploads/origins/4b42ed00-68bc-4b66-b6dd-68380c1b218d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=525bddedff23f63dff8a524f5426dfb2 2x, https://si.imgix.net/5b3b3437/uploads/origins/4b42ed00-68bc-4b66-b6dd-68380c1b218d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ed35c5aabdb8e447d5fa84ba43940ca6 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/5b3b3437/uploads/origins/4b42ed00-68bc-4b66-b6dd-68380c1b218d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6bf0c386bc73282a2d6d0101cf4d3d7f", "srcset": "https://si.imgix.net/5b3b3437/uploads/origins/4b42ed00-68bc-4b66-b6dd-68380c1b218d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6bf0c386bc73282a2d6d0101cf4d3d7f, https://si.imgix.net/5b3b3437/uploads/origins/4b42ed00-68bc-4b66-b6dd-68380c1b218d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=01a7d14754cc0