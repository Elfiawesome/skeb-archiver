ieGauge.png\n\nThe idea is that Kyoko likes to eat food a lot, and Sin Kiske has a food gauge mechanic. I also think Axl and I-NO have a similar relationship to Kyoko and Sayaka.\n\nPlease provide a transparent background version. If possible, make it a full-body illustration.\n\nThank you!\n\nhttps://drive.google.com/drive/folders/1z8pZCSj2INxPBc79TvoqHwOO9fgym0tc?usp=sharing", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@UXU_sunao/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2205308, "client_id": 1398617, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/42283c69/uploads/origins/27f93071-97bf-4f64-853d-f7a19ede5dde?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a4d7dd20d326edb429a4e7f9de32498a", "srcset": "https://si.imgix.net/42283c69/uploads/origins/27f93071-97bf-4f64-853d-f7a19ede5dde?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a4d7dd20d326edb429a4e7f9de32498a, https://si.imgix.net/42283c69/uploads/origins/27f93071-97bf-4f64-853d-f7a19ede5dde?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=310a1874ee50a9f1515c5bc54430b63d 2x, https://si.imgix.net/42283c69/uploads/origins/27f93071-97bf-4f64-853d-f7a19ede5dde?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=9ec88d7005a34c64f53e536ce34c385b 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/42283c69/uploads/origins/27f93071-97bf-4f64-853d-f7a19ede5dde?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=627bfd536bd1ecb86dfe57fed5063fee", "srcset": "https://si.imgix.net/42283c69/uploads/origins/27f93071-97bf-4f64-853d-f7a19ede5dde?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=627bfd536bd1ecb86dfe57fed5063fee, https://si.img