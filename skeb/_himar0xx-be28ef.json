8f-4c39-9e79-8a82c78828a0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=dd5322e09f74432e89feeda94a27d774", "srcset": "https://si.imgix.net/d3c691eb/uploads/origins/548dc7b2-cc8f-4c39-9e79-8a82c78828a0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=dd5322e09f74432e89feeda94a27d774, https://si.imgix.net/d3c691eb/uploads/origins/548dc7b2-cc8f-4c39-9e79-8a82c78828a0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=4669920c88dbab844410c7ffbe104e44 2x, https://si.imgix.net/d3c691eb/uploads/origins/548dc7b2-cc8f-4c39-9e79-8a82c78828a0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=b324050c1cd38b91c4ba331f9738d02b 3x"}, "body": "himaro🌻様、はじめまして。\nhimaro🌻の作品から感じる日常の雰囲気や、生き生きとしたキャラクターが大好きで、今回はぜひOCのモノクロ漫画を描いていただきたく、リクエストをお送りいたしました。\n日常の中の可愛らしいワンシーンをお願いいたします。具体的なシチュエーションにつきましては、先生の自由な発想で完全にお任せしたいです。\n\n【キャラクター】\n一族の因習に縛られながらも、対照的な生き方を見せる14歳の双子の兄妹。\n\n■浅井秋葉（妹🐱）\n・外見：身長152cm / 少し丸顔で大人びた表情\n・設定：幼い頃から離れに幽閉されて育った病弱な少女。青い瞳は他人の心を読む異能の証で、「呪いの子」として忌み嫌われている。\n・性格： 普段は毒舌を振るって自分を守っているが、根は優しい。自分の境遇には達観していて、悪意に動じぬ胆力を持っている。唯一の願いは「海を見ること」。\n　兄をからかうのは好きだが、まっすぐな愛情表現には弱い。\n　普段は大人びて包容力があるが、実は甘党の寂しがり屋。体調を崩すと年相応に甘えん坊になる。\n\n■浅井冬弥（兄🐶）\n・外見：身長167cm / 黒い瞳 / 細マッチョ\n・設定：幼少から鍛えられた並外れた剣術を持つ、表向きは優秀な跡取り。\n　計算高いが根性はあり、内心はツッコミと愚痴だらけ。\n　妹には心の声が筒抜けなため、彼女の前でだけ猫を被るのをやめ、子犬のように素の自分をさらけ出す。衝動的で我を忘れたり、泣きべそをかいたりと未熟な一面も。\n　妹を連れて逃げ出す方法を探している。\n\n■二人の日常\n・「どっちが年上か」を子供っぽく張り合う\n・兄が距離を詰める→妹が塩対応でかわす→兄がめげずにまた寄る、のループ\n・子供のころの兄は時々妹をドラえもん扱いし、宿題や分からないことを相談する。妹は呆れながらも丁寧に教えてくれる\n・妹が体調を崩すと、兄が世話焼きモード全開で甲斐甲斐しく構う\n・兄が満面の笑みで、妹に嫌いな野菜を無言の圧で食べさせようとする\n\n【使用用途】\n・創作活動の資料として\n\n金額が不足している場合は、お手数ですが再送していただけますと幸いです。\nお忙しいところ恐縮ですが、ご検討のほどよろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/17tQDBF69RE3fHJNug9cT_Bm_JvAlnCzD?usp=drive_link", "nc": 153, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@_himar0xx/works/2", "private_thumbnail_image_urls": null,