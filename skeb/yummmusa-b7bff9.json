n・キャラ\n資料添付しています。自作フリーゲームのキャラクターです。\n20歳、183cm、普通体型、飾り気がなくさっぱりした性格の男性です。\n髪はラベンダー、後頭部で結った状態で腰まで。瞳は赤のジト目。\nパーカーは自分の体格より一回り大きいものを着ています。\n\n・構図など\n体は横向き～斜め（左右どちらでも良いです）、顔と視線はカメラ側を向いている、という構図をお願いしたいです。\nもし可能であれば、髪は風に靡いている感じを希望です。\n口は薄く開いている又は閉じているのどちらかでお願いします。（大きくは開けない）\nまた、パーカーがオーバーサイズのため袖口が大きく、そこから生える手首がちょっとした拘りなので、片腕でいいので手が描画されていると嬉しいです。\nあまり格好付けたポーズをするタイプではないので、腕ははただ下ろしている、軽く肘を折ってる、腰に当てている等、シンプルなポーズでお願いします。\nその他細部や描画範囲、背景の有無はお任せでお願いしたいと思います。\n\n■利用用途\n個人鑑賞のみです。\nそのためサイズや形式に希望はありません。描きやすいサイズにしていただければと思います。\n\n以上、よろしくお願いいたします。\n\nhttps://drive.google.com/file/d/11tRW0UFnNNoeFBUVePpdS-_WU15MceyP/view?usp=drive_link", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@yummmusa/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 770622, "client_id": 780278, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/d5150f89/requests/159210_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=39bfaca3614e2fc59e22519ae40edc8f", "srcset": "https://si.imgix.net/d5150f89/requests/159210_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=39bfaca3614e2fc59e22519ae40edc8f, https://si.imgix.net/d5150f89/requests/159210_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e98f593f3c247aa3ac32408a340407c3 2x, https://si.imgix.net/d5150f89/requests/159210_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=6c744ce52f4a0dd919d6c2d904104d98 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/d5150f89/requests/159210_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=06c34efa04adf31e7b5973bf727ecde8", "srcset": "https://si.imgix.net/d5150f89/requests/159210_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=06c34efa04adf31e7b5973bf