ウラ 前角」にて画像検索をお願いします。\n\n②フェアリー\n優しくて聡明な妖精です。\nサイズはピーターパンに登場するティンカーベルくらいです。\n\n\nデータは、キャラクター単体の背景透過済みデータ（PSD・CLIP・PNGのいずれか）も欲しいです。\n宛名は不要ですが、どこかにサインをいただけると嬉しいです。\n\nご検討よろしくお願いします。\n\nhttps://drive.google.com/drive/folders/1jc2gQ-xH1dcaiOgzIU19_O-Tol8Xsr26?usp=sharing", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@HwFdx/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2489070, "client_id": 1793501, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/05d165fa/uploads/origins/17303dda-2431-469d-9e53-ffb31d4edbb0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5bdc5d425ce4aa7823bca36ab449b037", "srcset": "https://si.imgix.net/05d165fa/uploads/origins/17303dda-2431-469d-9e53-ffb31d4edbb0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5bdc5d425ce4aa7823bca36ab449b037, https://si.imgix.net/05d165fa/uploads/origins/17303dda-2431-469d-9e53-ffb31d4edbb0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=76bfce02d01fb8d82efed9de4e99ddf2 2x, https://si.imgix.net/05d165fa/uploads/origins/17303dda-2431-469d-9e53-ffb31d4edbb0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=05f079124db0591bf019f1448c63ec08 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/05d165fa/uploads/origins/17303dda-2431-469d-9e53-ffb31d4edbb0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ed0db0141c95bc32dcb066473f58d41c", "srcset": "https://si.imgix.net/05d165fa/uploads/origins/17303dda-2431-469d-9e53-ffb31d4edbb0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ed0db0141c95bc32dcb066473f58d41c, https://si.imgix.net/05d165fa/uploads/origins/17303dda-2431-469d-9e53-ffb31d4edbb0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit