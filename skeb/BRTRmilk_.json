 "correction", "default_amount": 500}], "acceptable_only_public": false, "tip_acceptable": true, "yearly_report_client_visible": false, "total_appeals_count": 0, "received_works": [{"path": "/@BRTRmilk_/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3734401, "client_id": 3735527, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/9650cfd3/uploads/origins/dc68730f-9b19-4a46-915a-adfb8c645114?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2dfe6c8266146d57c157daa87eb3ef86", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/9650cfd3/uploads/origins/dc68730f-9b19-4a46-915a-adfb8c645114?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=39b536b5cb6fa343c4910682cdc62c52", "src_set": ""}, "body": "こんばんは。\nはじめまして。\n先生の書くイラストや漫画が大好きでリクエストをさせていただきました。\n私も健全なものもエッチなものも大大大好きです(改めて言葉にすると恥ずかしいですが…)\n・若い男性\n・メイドさんのお洋服(ミニスカート)\n・構図や背景はおまかせ\n一人暮らしの部屋でこっそり観賞用として大切に保管致します。\nお忙しいとは思いますがリクエストを受けていただけたら嬉しいです。", "nc": 33, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@BRTRmilk_/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3734401, "client_id": 3023923, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/07d01041/uploads/origins/3e9a6e09-3e61-42bb-ada5-6d2bb5c19c83?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=312926aa12bb21e9e783d5ae1c5a2ea1", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/07d01041/uploads/origins/3e9a6e09-3e61-42bb-ada5-6d2bb5c19c83?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=98644c0da285e0132fc97dbad3e73fe2", "src_set": ""}, "body": "とじょさか先生、skebリクエスト受付開始してください有難うございます！先生の生み出される全てが大好物です！\n早速ですが、以下にリクエストを記させていただきます。\n\n人物は2名、片方は男性、もう片方の性別は先生にお任せしたく思います。\n以下を取り入れていただきたいです。\n\n・褐色肌×ベージュ肌\n・片方は傷を負っている\n・もう一方は、傷を負っている相手を守る・慈しむ感じ\n\n先生の作品では、特に楽園性スウィートルームのアムスイのような関係性、世界観が大好きなので、そのような雰囲気が感じられると嬉しいです。\nskebリクエスト不慣れなためわかりづらい点や応え難い点がありましたら申し訳ありません。その場合は、お手数おかけしますが、先生が楽しく描けるようお任せしたく思います。もちろん、キャンセルいただいても構いません。", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@BRTRmilk_/works/5", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/4e19d7d7/uploads/origins/3e99e0ab-8a6e-4363-b9f8-ba3a00af2a27?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=9f78063dedf8989b3099aa320ea1f3af", "src_set": ""}, "private": true, "genre": "comic", "tipped": true, "creator_id": 3734401, "client_id": 0, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 32, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@BRTRmilk_/works/4", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/b2f1eea2/uploads/origins/76ceb472-73ed-420e-97e4-dc84d0bbd6b0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=f7922af8ebc380fc9407ce1dcd5ab849", "src_set": ""}, "private": true, "genre": "art", "tipped": false, "creator_id": 3734401, "client_id": 0, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 16, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@BRTRmilk_/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3734401, "client_id": 3268399, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/35e47457/uploads/origins/0ec725a2-17d8-4e55-ae58-6a1d88a352fc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e75cf614518597bce2e3576da6019e14", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/35e47457/uploads/origins/0ec725a2-17d8-4e55-ae58-6a1d88a352fc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=891e4515f085d4c16cb10a7ead4982ff", "src_set": ""}, "body": "はじめまして。\nいつも陰ながら作品を拝見しております。\n\nこの度はskebの開設ありがとうございます。\n私と友人の創作（TRPG）キャラクターを描いていただきたく思い、リクエストを送らせていただきます。\n\n以下、依頼内容になります。\n\n▼画像資料\nhttps://drive.google.com/drive/u/3/folders/1PPiNQqOojSoMHXku8fcphowv9gZLwkKU\n\n見えていない部分や装飾等描きやすいように自由にしていただいて構いません。\n\n▼キャラクター補足\nレシピ（茶髪）\n・20代後半/男\n・余裕のある態度だが、押しに弱いのでぐいぐいくる相手には動揺する\n・からかっているような表情か嬉しそうに微笑んでいる表情をよくする\n\nラム（金髪）\n・20代前半/男\n・明るく素直で人懐っこい、積極的\n・喜怒哀楽をしっかり表情に出す\n\n▼リクエスト\n2人の仲が良さそうな雰囲気もしくは、かっこいい雰囲気で描いていただけると嬉しいです。\n衣装（および設定）が複数ありますので、お好きなものを選択していただけますと幸いです。\n\n▼使用用途\n・個人鑑賞（友人への共有）\n\n\n苦手な要素や内容がございましたら遠慮なくキャンセルしていただいて構いません。\n料金不足等ありましたら再送要請をしていただければと思います。\n\nここまで読んでいただきありがとうございます。\nご縁がありましたら何卒よろしくお願いいたします。", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@BRTRmilk_/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3734401, "client_id": 3083466, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/bed6fb97/uploads/origins/fa41fc2f-2ac7-4d35-b6fe-4307c19992a1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=072635a2db9d21f28edbd25a42e33bc6", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/bed6fb97/uploads/origins/fa41fc2f-2ac7-4d35-b6fe-4307c19992a1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a3c478d388ee1306115c699d9b7b079b", "src_set": ""}, "body": "さかな先生こんばんは！！先生がskebを始められたとの事で、大変驚いております！\n猫でも愛して！と言う作品から先生の事を知り、気になる作品をいくつか購読させていただいております。\n\n早速ではありますが、私のオリジナルキャラクターを描いていただけませんか…！\n1人の高校生の女子です。(資料が分かりにくかったらすみません…)\nご自由に仕上げてくださったらとても嬉しいです(*´˘`*)\n\n猛暑が続きます。熱中症にはくれぐれもお気をつけください。\n何か内容や金額に不備がありましたら、遠慮なくキャンセルくださいませ。\nよろしくお願いいたします…！\n\nhttps://drive.google.com/drive/folders/1hMe4xuxhUb81O7SICciR_9Q37uPziGNq", "nc": 9, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@BRTRmilk_/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3734401, "client_id": 858272, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/68788727/uploads/origins/f2e02596-f603-4537-9831-d4460a23bc41?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5869fa6abcab8126103bef9841377988", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/68788727/uploads/origins/f2e02596-f603-4537-9831-d4460a23bc41?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=aebab5107a4ab5acaa35c6505d37dd0a", "src_set": ""}, "body": "はじめまして！\nSkeb開設ありがとうございます！\nとじょさか様のきらきらした女の子のイラストが大好きです！\n\nもしよろしければ私のオリキャラを夏っぽいイメージで描いていただけませんか？\n金髪/水色か青の瞳/幼い顔つき/セーラーっぽい服装の要素を入れてもらえると嬉しいです。\n服装、アクセサリー等のアレンジは全然していただいて大丈夫です！\n\n描いていただいたイラストはSNSアイコン/ヘッダー/配信画面等に使わせていただこうと思っています。\nどうぞよろしくおねがいします！\n\nhttps://drive.google.com/drive/folders/1sRcQH1ecOHqbE0aYB0xrzYtx8FQzpYnE?ths=true", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "similar_creators": [{"id": 6923, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "NATSU🚬🎆", "screen_name": "natsumikannats2", "avatar_url": "https://pbs.twimg.com/profile_images/1856238888198832128/5RR0mDz8.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1351169341/1756717757/1500x500", "appeal_receivable": false,