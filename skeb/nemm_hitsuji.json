ess&fm=webp&fit=crop&crop=top&w=200&h=200&s=d56692da602efde50e4cd76b16335715", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/fc89cea3/uploads/origins/6af9c2c3-2e86-4f7e-8609-f81c55279e0a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c72706463a0c8d39eb55586817b7e1d2", "src_set": ""}, "body": "はの様\nチャイナの姿が好きすぎるので、リクエストさせて頂きました！\n\n◾︎使用用途\nsns等のアイコン\n\n◾︎内容\n・表情、構図はお任せいたします\n\n希望として、背景なし透過データも一緒に頂けると嬉しいです🙇🏻‍♀️\n\n◾︎参考資料\nhttps://drive.google.com/file/d/1RTSf_3fdrtqrd7jH7mFt3pWBJV8pTwI3/view?usp=drivesdk\n\nご検討の程よろしくお願いいたしますっ", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@nemm_hitsuji/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3568140, "client_id": 2964762, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/8311f554/uploads/origins/5aa8f62a-f501-44f9-925d-91488b5d4783?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b6a88213116287fa6fcae183c3508b9c", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/8311f554/uploads/origins/5aa8f62a-f501-44f9-925d-91488b5d4783?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c4f235fbdf9d9b2b093fac44a160140c", "src_set": ""}, "body": "かわいい恰好をしたわたしの探索者を描いてほしいです！\n\nファッションにこだわりがないひとなので、本人に服を選ばせたらスウェットやパーカーといったどう着てもかたちになるゆるっとしたものになってしまうのですが、それはそれとしてかわいい恰好をさせてください。特に嫌がる性格ではありません。\n少しは伸びたと思うので、髪の長さを10〜15cmほど盛っていただいてもかまいません。ヘアアレンジ可。巻いても編んでも結んでもなんでも。\n\n●考えられる使用用途\n・個人のSNSでの掲載やアイコンなどとしての使用\n・悪意のない加工を施しての動画化\n・ココフォリアの装飾や立ち絵など、TRPGの場で\n・ステッカーにしてスマホに挟むといった非営利目的の印刷\n・依頼やリクエストの際、キャラクターの参考資料としての提示\n\nあなたは好きに描けば描くほど作品にみずみずしさみたいなものが宿るタイプだと思うので、好きに描いてほしいな〜と思います。お金が関わるので難しい部分もあるでしょうが、できる範囲で！\n立ち絵としても使用する可能性があるなどと書いていますが、それもあくまでも可能性の話なので気にしないでください。立ち絵っぽい構図や線、表情などじゃなくてかまわないし、着色はあってもなくてもいいと思います。好きにしてください！\n\nhttps://drive.google.com/file/d/1esDaxW2dm4nDR5IYD9Zdb5IM2EN2icJ5/view?usp=drivesdk", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@nemm_hitsuji/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3568140, "client_id": 2187622, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/fe7b621f/uploads/origins/f01812c3-9698-4113-aa34-6686c3dd1489?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=61d38abb6d801a489e470e4a0db962a2", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/fe7b621f/uploads/origins/f01812c3-9698-4113-aa34-6686c3dd1489?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=23e19e1b8879653bb4d6e53f2ec604eb", "src_set": ""}, "body": "こんにちは、いつも色々お描きいただきありがとうございます、ユウキ*です。\n\n好きなTRPG探索者(あなたのでも他の方のでもわたしのでも)の落書き、2-3人、あるいは好きな人数、好きに描いていただけないでしょうか。\n\nただあなたの絵が見たいだけなので何か難しいことがあれば再送等していただいて構いません。\n\nもしも悩むことがあれば、「春」っぽいものだと季節らしく楽しみにしてます。\n\nいつも応援してます。", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@nemm_hitsuji/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3568140, "client_id": 3503342, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/97fee537/uploads/origins/064ca5fb-0606-4c6e-aba0-2ebd3390776a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bea36d398c9f57d22ce83a280c674b57", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/97fee537/uploads/origins/064ca5fb-0606-4c6e-aba0-2ebd3390776a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=812981591561c00274982dc267da209f", "src_set": ""}, "body": "こんにちは！はのさんのふわふわとした可愛らしい雰囲気のイラストが大好きで、つきましては私のオリジナルキャラクターを描いて頂きたく思っております！\n\n【イラストについて】 \n\n資料のURL先が描いて欲しい女の子になります。  \n腰上辺りまで髪があり毛先は巻いています。 \n\n譲れないポイントとして \n・どのような構図でも左右の赤いリボンが見える形であること \n・画像1の緑の矢印部分の外ハネを忘れずに描いて欲しいこと\n\nのみ、お願いさせていただけたらと思います。  \n\n構図はお任せ致します。 \n表情は少し照れたものですと嬉しいですが、他の形でも大丈夫です。 \n恋に盲目な女の子という性格かつ、大人しめな女の子な為、大きく笑うような表情や大胆なポーズのみ避けていただけますと嬉しいです。  \n私服のデザインについても希望はなく、はのさんのセンスにおまかせさせて頂けたら幸いです！\n\n【使用用途について】 \n個人のスマホのホーム画面や、SNSでのアイコンなどに使用させていただく予定です。   \n細々と申し訳ございません。 \n色々と記載させて頂きましたが、何より描きやすい形で描いていただけたらと思っております。 \n宜しくお願い致します！\n\nhttps://drive.google.com/drive/folders/1Rl40gbjPR1cGxgsNgQjBalkIn3VchNjp", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "similar_creators": [{"id": 316504, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "🌋イコミ🌋依頼募集中", "screen_name": "MIOU_3O", "avatar_url": "https://pbs.twimg.com/profile_images/1975877075300167680/VTw_pNUH.jpg", "header_url": "https://pbs.twimg.com/profile_banners/763245532613480448/1575983591/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "skills": [{"genre": "art"}, {"genre": "correction"}], "nc": 0}, {"id": 1353365, "creator": true, "nsfw_acceptable": true, "acceptable": false, "name": "っmn", "screen_name": "pogpa47985618", "avatar_url": "https://pbs.twimg.com/profile_images/1561795190238879744/1Nd1l1Md.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1391293374133465090/1703783693/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "skills": [{"genre": "art"}, {"genre": "correction"}], "nc": 176}, {"id": 1684532, "creator": true, "nsfw_acceptable": false, "acceptable": false, "name": "るいきゅう", "screen_name": "