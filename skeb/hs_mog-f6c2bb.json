06a\u304c\u3089\u982d\u4e0a\u306e\u30a6\u30a8\u30c7\u30a3\u30f3\u30b0\u30c9\u30ec\u30b9\u3092\u5f15\u3063\u5f35\u3063\u3066\u3044\u308b\u69d8\u5b50\u3092\u63cf\u3044\u3066\u6b32\u3057\u3044\u3068\u306e\u3053\u3068,2\u4eba\u3068\u3082\u6307\u306b\u7d50\u5a5a\u6307\u8f2a\u3092\u306f\u3081\u3066\u3044\u308b\u2192\u3053\u3093\u306a\u30a4\u30e9\u30b9\u30c8!\uff01\n\nCain \u30fb G \u30fb Blemish (\u653b) : \u7f8e\u4eba\u3067\u653b\u6483\u7684\u3001\u9752\u3044\u76ee\u3068\u8d64\u9ed2\u3044\u9aea\u3092\u6301\u3064\u7537\u6027\u3002\n\u8077\u696d\u306f\u30a8\u30ea\u30fc\u30c8\u30a8\u30fc\u30b8\u30a7\u30f3\u30c8\u3001\u6027\u683c\u306f\u51b7\u9177\u3001\u7121\u60c5\u3001\u751f\u610f\u6c17\u3001\u6c17\u96e3\u3057\u3044\u304c\u4e0d\u5feb\u306a\u611f\u60c5\u3092\u96a0\u3057\u3001\u8868\u60c5\u306f\u5e38\u306b\u4f5c\u308a\u7b11\u3044/\u4e0d\u6a5f\u5acc\u3002\u305a\u308b\u8ce2\u304f\u3066\u5f37\u5f15\u306a\u4e0a\u4f4d\u652f\u914d\u8005\u306f\u3001\u76f8\u624b\u3092\u6bb4\u3063\u3066\u30b3\u30f3\u30c8\u30ed\u30fc\u30eb\u3059\u308b\u306a\u3069\u306e\u884c\u70ba\u3092\u884c\u3044\u3001\u611f\u60c5\u7684\u306b\u652f\u914d\u3057\u307e\u3059\u3002\n\u5e74\u9f62\u306f31\u6b73\u3001\u8eab\u9577\u306f160cm\uff0c\u4f53\u3064\u304d\u304c\u307b\u3063\u305d\u308a\u3057\u3066\u3044\u308b\u3002\n\u30ad\u30fc\u30ef\u30fc\u30c9: \u9283\u5668\u3001\u8d64\u9ed2\u3044\u6bd2\u86c7\u3001\u9752\u3044\u708e\u3001\u8d64\u9ed2\u3044\u8718\u86db\nAbel\u00b7Leros(\u53d7) : \u6e05\u695a\u306a\u3001\u30a2\u30eb\u30d3\u30ce\u3068\u7570\u8272\u306e\u77b3\u3092\u6301\u3064\u80cc\u306e\u9ad8\u3044\u9752\u5e74\u3002\n\u8077\u696d\u306f\u533b\u5e2b\u3067\u3001\u6027\u683c\u306f\u51b7\u6de1\u3067\u920d\u611f\u3001\u5f93\u9806\u3067\u9759\u304b\u3001\u3069\u3053\u304b\u6697\u3044\u3088\u3046\u306b\u898b\u3048\u308b\u304c\u5b9f\u306f\u512a\u3057\u3044\u5b50\u4f9b\u3067\u3001\u305f\u3044\u3066\u3044\u306e\u3053\u3068\u306b\u5bfe\u3057\u3066\u3068\u3066\u3082\u51b7\u305f\u3044\u3088\u3046\u306b\u898b\u3048\u308b\u3002\u