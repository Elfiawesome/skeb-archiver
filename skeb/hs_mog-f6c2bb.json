07e\u305b\u3093\u3067\u3057\u305f\u3002\nCain \u30fb G \u30fb Blemish (\u653b) : \u7f8e\u4eba\u3067\u653b\u6483\u7684\u3001\u9752\u3044\u76ee\u3068\u8d64\u9ed2\u3044\u9aea\u3092\u6301\u3064\u7537\u6027\u3002\n\u8077\u696d\u306f\u30a8\u30ea\u30fc\u30c8\u30a8\u30fc\u30b8\u30a7\u30f3\u30c8\u3001\u6027\u683c\u306f\u51b7\u9177\u3001\u7121\u60c5\u3001\u751f\u610f\u6c17\u3001\u6c17\u96e3\u3057\u3044\u304c\u4e0d\u5feb\u306a\u611f\u60c5\u3092\u96a0\u3057\u3001\u8868\u60c5\u306f\u5e38\u306b\u4f5c\u308a\u7b11\u3044/\u4e0d\u6a5f\u5acc\u3002\u305a\u308b\u8ce2\u304f\u3066\u5f37\u5f15\u306a\u4e0a\u4f4d\u652f\u914d\u8005\u306f\u3001\u76f8\u624b\u3092\u6bb4\u3063\u3066\u30b3\u30f3\u30c8\u30ed\u30fc\u30eb\u3059\u308b\u306a\u3069\u306e\u884c\u70ba\u3092\u884c\u3044\u3001\u611f\u60c5\u7684\u306b\u652f\u914d\u3057\u307e\u3059\u3002\n\u5e74\u9f62\u306f31\u6b73\u3001\u8eab\u9577\u306f160cm\uff0c\u4f53\u3064\u304d\u304c\u307b\u3063\u305d\u308a\u3057\u3066\u3044\u308b\u3002\n\u30ad\u30fc\u30ef\u30fc\u30c9: \u9283\u5668\u3001\u8d64\u9ed2\u3044\u6bd2\u86c7\u3001\u9752\u3044\u708e\u3001\u8d64\u9ed2\u3044\u8718\u86db\nAbel\u00b7Leros(\u53d7) : \u6e05\u695a\u306a\u3001\u30a2\u30eb\u30d3\u30ce\u3068\u7570\u8272\u306e\u77b3\u3092\u6301\u3064\u80cc\u306e\u9ad8\u3044\u9752\u5e74\uff0c\u76ee\u306f\u8d64\u304f\u3001\u53f3\u306e\u76ee\u306f\u8d64 + \u9752\u306e\u6e26\u5dfb\u304d\u3067\u3059\u3002\n\u8077\u696d\u306f\u533b\u5e2b\u3067\u3001\u6027\u683c\u306f\u51b7\u6de1\u3067\u920d\u611f\u3001\u5f93\u9806\u3067\u9759\u304b\u3001\u3069\u3053\u304b\u6697\u3044\u3088\u3046\u306b\u898b\u3048\u308b\u304c\u5b9f\u306f\u512a\u3057\u3044\u5b50\u4f9b\u3067\u3001\u305f\u3044\u3066\u3044\u306e\u3053\u3068\u306b\u5bfe\u3057\u3066\u3068\u3066\u3082\u51b7\u305f\u3044\u3088\u3046\u306b\u898b\u3048\u308b\u3002\u4e0d\u5b89\u969c\u5bb3\u304c\u3042\u308a\u3001\u4e0d\u5b89\u3084\u7dca\u5f35\u306b\u306a\u308a\u3084\u3059\u3044\u3002\u4e0d\u660e\u77ad\u306a\u30de\u30be\u30d2\u30b9\u30c6\u30a3\u30c3\u30af\u306a\u50be\u5411\u304c\u3042\u308a\u3001 cain \u306b\u6bb4\u3089\u308c\u3066\u3057\u3064\u3051\u3089\u308c\u305f\u3068\u304d\u306b\u559c\u3073\u3092\u611f\u3058\u3001\u8868\u60c5\u306f\u901a\u5e38\u7121\u8868\u60c5\u3001\u4e0d\u5b89\u3001\u307c\u3093\u3084\u308a\u3057\u3066\u3044\u307e\u3059\u3002\u611f\u60c5\u306b\u304a\u3044\u3066\u306f\u88ab\u652f\u914d\u65b9\u3002\n\u5e74\u9f62\u306f19\u6b73\u3001\u8eab\u9577\u306f190cm \u3067\u3001\u5f37\u304f\u306f\u306a\u3044\u304c\u75e9\u305b\u3066\u3082\u3044\u306a\u3044\u3002\n\u30ad\u30fc\u30ef\u30fc\u30c9: \u96ea\u306e\u30d1\u30ea\u3001\u6559\u4f1a\u3001\u767d\u30d0\u30e9\u3001\u767d\u30d0\u30e9\u3001\u9ce5\u304b\u3054\n\u30d2\u30f3\u30c8: \u4e8c\u4eba\u306e\u4f53\u578b\u5dee\u304c\u5927\u304d\u304f\u3066\u3001\u3057\u304b\u3082\u82e5\u3044\u5dee\u3082\u5927\u304d\u304f\u3066\u3001 cain (\u9ed2\u8d64\u9aea\u8272)(\u5236\u5fa1\u65b9)(\u653b)\u3082\u3063\u3068\u304d\u308c\u3044\u3067\u5c0f\u67c4\u3067\u3001\u5e74\u9f62\u304c\u5927\u304d\u3044\nAbel (\u767d\u9aea)(\u88ab\u652f\u914d\u8005)\u306f\u3082\u3063\u3068\u30cf\u30f3\u30b5\u30e0\u3067\u80cc\u304c\u9ad8\u304f\u3001\u5e74\u9f62\u304c\u4f4e\u3044\n\u30a8\u30fc\u30d6\u306f\u30b1\u30a4\u30f3\u306b\u5bfe\u3057\u3066\u660e\u3089\u304b\u306a\u611b\u60c5\u3092\u6301\u3063\u3066\u304a\u308a\u3001\u30b1\u30a4\u30f3\u3082\u30a8\u30fc\u30d6\u306b\u5bfe\u3057\u3066\u660e\u3089\u304b\u306a\u611b\u60c5\u3092\u6301\u3063\u3066\u3044\u307e\u3059\u304c\u3001\u305d\u308c\u3092\u8868\u73fe\u3059\u308b\u3053\u3068\u306f\u3067\u304d\u305a\u3001\u76f8\u624b\u3092\u6bb4\u3063\u3066\u4fae\u8fb1\u3059\u308b\u3053\u3068\u3067\u305d\u308c\u3092\u5426\u5b9a\u3057\u307e\u3059\n\u3057\u304b\u3057\u4e8c\u4eba\u3068\u3082\u76f8\u624b\u306b\u5bfe\u3059\u308b\u611b\u60c5\u306f\u6df1\u304f\u3001\u7d14\u611b\u3067\u3042\u308a\u3001 cain (\u653b)\u306f abel (\u53d7)\u306b\u5bfe\u3057\u3066\u5144/\u8eab\u5185/\u65b0\u5a66/\u604b\u4eba/\u7236/\u4e3b\u4eba\u3067\u3042\u308b\n\u5177\u4f53\u7684\u306a\u69cb\u56f3\u3001\u59ff\u52