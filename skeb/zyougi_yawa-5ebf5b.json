お願いしたいです。\n・笑顔強制で敗北宣言させられる\n・次第に金玉が蒸れて痒くなるが両手が使えず掻くこともできないため我慢させられ、情けなく空中に腰ヘコ\n・痒みだけで射精してしまうが短小包茎粗チンのため垂れる様な情けない射精しかできない\nと言った様な感じで描いていただけると嬉しいです。\nよろしければ承認のほどお願いいたします。", "nc": 56, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 9454, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "おりぷ", "screen_name": "door_error", "avatar_url": "https://pbs.twimg.com/profile_images/2072782225897394176/DojIfnyD.jpg", "header_url": null, "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "art"}, {"genre": "correction"}], "banned": false, "nc": 160}, {"id": 726789, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "マクジラ@海鮮堂", "screen_name": "makuzira364", "avatar_url": "https://pbs.twimg.com/profile_images/1577896206692278272/l-21tN4I.jpg", "header_url": "https://pbs.twimg.com/profile_banners/3221912630/1780232908/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 2, "complete_expiration_days": 15, "skills": [{"genre": "art"}], "banned": false, "nc": 48}, {"id": 897652, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "神楽優人＠秋仕事中", "screen_name": "yuutokagura", "avatar_url": "https://pbs.twimg.com/profile_images/2076702665107742720/cTSIg5kR.jpg", "header_url": "https://pbs.twimg.com/profile_banners/104319546/1783959474/1500x500", "appeal_receivable": false, "popular_creator_rank": 84, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 5, "complete_expiration_days": 115, "skills": [{"genre": "art"}, {"genre": "correction"}]