nail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 389264, "client_id": 383741, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/1ead98af/uploads/origins/1d35d7b4-d164-4bf9-8de5-da0154c6824f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=73e9e68013606cdf1a5239fc4defaafd", "srcset": "https://si.imgix.net/1ead98af/uploads/origins/1d35d7b4-d164-4bf9-8de5-da0154c6824f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=73e9e68013606cdf1a5239fc4defaafd, https://si.imgix.net/1ead98af/uploads/origins/1d35d7b4-d164-4bf9-8de5-da0154c6824f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=0ecb2f86a53c1d680c0a3e2ec826cb3c 2x, https://si.imgix.net/1ead98af/uploads/origins/1d35d7b4-d164-4bf9-8de5-da0154c6824f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ef9e5f03498c3dc31dde8e86676ebca9 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/1ead98af/uploads/origins/1d35d7b4-d164-4bf9-8de5-da0154c6824f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=12e98918fba4f6e34e56c16929bb05b3", "srcset": "https://si.imgix.net/1ead98af/uploads/origins/1d35d7b4-d164-4bf9-8de5-da0154c6824f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=12e98918fba4f6e34e56c16929bb05b3, https://si.imgix.net/1ead98af/uploads/origins/1d35d7b4-d164-4bf9-8de5-da0154c6824f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=a328bf01c092d310f4b755cf164e1cd1 2x, https://si.imgix.net/1ead98af/uploads/origins/1d35d7b4-d164-4bf9-8de5-da0154c6824f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=c2d4c0507b7e5eca8fed26f9d9a0fe21 3x"}, "body": "魔法少女リリカルなのはシリーズに出てくるキャラ\n『レヴィ』と言う青髪ツインテボクっ娘少女(渡す側)から\n『ユーノ・スクライア』と言う金髪翡翠目少年(渡される側)にイヤリング(ハートの下に青い雫がついてるデザイン)をプレゼント\nその時にレヴィから\n『つけてあげるから目を瞑っていて』\nと促されるユーノ、少し不思議に思いながらも目を瞑る。\nそしてレヴィは\n右手で『ユーノの左耳』にイヤリングを付ける\n同時に左手で『ユーノの右手』を引っ張りキスをする\n「な、な……な！？」\n「ボク、ユーノの事が好き。友だちとしてじゃなくて、恋としてキミが…好き」\n\nその後少し離れて\n\n「返事は今聞かない、次会った時にその答えを聞くから…だから、早く来てね？」\n\nって笑うレヴィ\n\nキスするシーンでは目元を『慈しみ、相手を求める』ようなしっとりとした雰囲気だと嬉しいです\nこちらは、魔法少女リリカルなのはdetonationのラストシーンを元に考えているのでそちらも参考に見ていただけたらと思います\n衣装の資料はURLの方に\n\nhttps://twitter.com/kaiouga2/status/1609816191195054080?s=46&t=cpQHrkSjImnbgK6rSgnOjg", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 15943, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "doz🔞", "screen_name": "ddnzerd", "avatar_url": "https://pbs.twimg.com/profile_images/988827479069478912/AjgQ2pg2.jpg", "header_url": null, "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 90, "skills": [{"genre": "art"}], "nc": 161}, {"id": 39649, "creator": true, "nsfw_acceptable": true, "acceptable": false, "name": "🔞horosuke🔞", "screen_name": "horosuke_", "avatar_url": "https://pbs.twimg.com/profile_images/2035618008228589568/B215R-oS.jpg", "header_url": "https://pbs.twimg.com/profile_banners/631040869/1749292559/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 120, "skills": [{"genre": "art"}, {"genre": "correction"}], "nc": 49}, {"id": 1313737, "creator": true, "nsfw_acceptable": true, "acceptable": false, "name": "まっさんR-18🔞", "screen_name": "massan001", "avatar_url": "https://pbs.twimg.com/profile_images/1996968576323112960/YcF5SxrO.jpg", "header_url": "https://pbs.twimg.com/profile_banners/274802196/1710114077/1500x500", "appeal_receivable": false, "po