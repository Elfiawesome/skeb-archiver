ff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ea84bfbbf5b2f4b0b70d0ab43a43fa56 2x, https://si.imgix.net/6b2474fb/uploads/origins/948a7035-a64f-4869-8c94-246b4b8953ac?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=372446820efd9f9c2ad26ecfaa020523 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/6b2474fb/uploads/origins/948a7035-a64f-4869-8c94-246b4b8953ac?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ca239c378c1783594f4978ccaaaf968a", "srcset": "https://si.imgix.net/6b2474fb/uploads/origins/948a7035-a64f-4869-8c94-246b4b8953ac?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ca239c378c1783594f4978ccaaaf968a, https://si.imgix.net/6b2474fb/uploads/origins/948a7035-a64f-4869-8c94-246b4b8953ac?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=7411be6e0b97f05cc8d38b7789be25f3 2x, https://si.imgix.net/6b2474fb/uploads/origins/948a7035-a64f-4869-8c94-246b4b8953ac?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=0b58d6bd84138c9f82733e86783df4d9 3x"}, "body": "外道なカルデアにてマスターが食あたりか何か(きっかけは世界線に沿う形で変更してもらって結構です)で突然の便意を催して野外で用を足しているところをアルに見られて首を吹っ飛ばされるのをお願いします。首を吹っ飛されて終わりではなく飛ばされて着地した後に何かマスターが一言(出来るだけ下品な言葉)を発して終わりという形で。また用を足しているところのディテールは描かなくても結構ですモザイクをかけたり、草で上手い具合に隠れてる感じにしてもらえれば(もし可能でしたら描いて頂きたいです！)また、台詞はお任せで大丈夫ですが、マスターは出来るだけ下品な言葉ずかいでお願いします。また、マスターの尻は出来るだけ見える形でお願いします。あと絵柄は割とラフな感じで大丈夫です。", "nc": 49, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@DEOTAMA_FGO/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 389264, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/83a96a41/uploads/origins/b83bef7a-af18-4eb3-a660-38f2ae25e761?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=20