=200&s=46aee314a57d433f94d948bb3a4920d0 3x"}, "body": "外道のカルデアのマスターが敵への挑発みたいな感じでふざけて尻を出した後に呆気なくやられてバラバラになってる漫画をお願いします！詳細は先生にお任せしたいのですが、出来るだけ下品な感じでお願いしたいです！絵は結構ラフな感じでも大丈夫です。", "nc": 160, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@DEOTAMA_FGO/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "comic", "tipped": false, "creator_id": 389264, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/045dbd93/uploads/origins/e3b0d35a-cdd2-484d-8136-fca014b09f8c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3157f8c769e1758b23e115441d17ca35", "srcset": "https://si.imgix.net/045dbd93/uploads/origins/e3b0d35a-cdd2-484d-8136-fca014b09f8c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3157f8c769e1758b23e115441d17ca35, https://si.imgix.net/045dbd93/uploads/origins/e3b0d35a-cdd2-484d-8136-fca014b09f8c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e48208f61a34d55ea744ed0e2bd879f4 2x, https://si.imgix.net/045dbd93/uploads/origins/e3b0d35a-cdd2-484d-8136-fca014b09f8c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=629677e2bfbcc83a56182f55972fd9dd 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/045dbd93/uploads/origins/e3b0d35a-cdd2-484d-8136-fca014b09f8c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a6b8330540215ec36379383064e2535e", "srcset": "https://si.imgix.net/045dbd93/uploads/origins/e3b0d35a-cdd2-484d-8136-fca014b09f8c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a6b8330540215ec36379383064e2535e, https://si.imgix.net/045dbd93/uploads/origins/e3b0d35a-cdd2-484d-8136-fca014b09f8c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=07125d64398215fcabf76ef842e35515 2x, https://si.imgix.net/045dbd93/uploads/origins/e3b0d35a-cdd2-484d-8136-fca014b09f8c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=d2c2dceeefccd777eb52dbf724d0b6bd 3x"}, "body": "失礼します。台詞ありの漫画を数ページお願いします。\nモノクロでも構いませんので、ページ数多めだと嬉しいです。\n\nキャラ　FGO ブーディカ、インドラ\n※インドラはモブっぽい感じで構いません。\n\nシチュエーション\n『1週間夫婦の様に過ごし、毎日必ずSEXをしないと出られない部屋（毎日必ずキス、射精する時は必ず子宮に）』にたまたま閉じ込められてしまったブーディカとインドラ。ブーディカは乗り気ではないが何故かインドラはノリノリ。仕方ないので致すことにした。\n\n1週間もの間、普通でいる時よりもSEXの時間が長く立ち方を忘れるくらいエっっグい交尾をさせられるブーディカ。料理中にセクハラされてそのまま…や入浴中でもお構いなし。\n\n1週間後、むせかえる様な獣臭と湿気ムンムンの部屋から出てきてマスターに会ったヤりたてホヤホヤのブーディカとインドラは、今までやってた事を色々誤魔化した。（誤魔化しているのは主にブーディカ）\n明らかにHなことしてました感溢れるブーディカの姿にマスターは悔しくてしこたま抜いた。\n\n\n出来れば会話やSEXシーン多めでお願いします。\n射精量がかなり多め、粘度濃いめ、射精音下品め激しめだと更に嬉しいです。ブーディカは見た事ないくらいだらしないメスイキ顔と激しいイキ声を晒してください。\n\nねっとりしつこいおっぱい愛撫描写、時間経過がわかる定点カメラ視点などがあると嬉しく思います。ですが、構図や台詞の内容や大まかな流れなどの細かい所はお任せします。\n\n人妻らしくデカ乳首にデカ乳輪、陰毛濃いめでお願いします。爆乳の長乳で、それを垂れ乳と弄られる会話もあると嬉しく思います。\n\n最後マスターとばったり会った時は、ホットパンツにタンクトップというラフな格好でキスの跡とかあると嬉しいです。\n\nよろしくお願いします。\n\n※実はインドラがブーディカを抱きたくて仕組んだ罠だったなどの設定でお願いします。それ以外の理由でも構いません。\n※ブーディカは認めたくないものの、インドラとのSEXが良すぎてちょっと堕ちかけてる感じです。たった1週間だけど終わる頃にはまぁまぁ仲良くなってます。少々強引なキスも仕方なく受け入れます。", "nc": 160, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@DEOTAMA_FGO/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 389264, "client_id": 62494, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/0e630967/uploads/origins/967f3660-f271-4e5d-ad36-765f563df3b8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=11610137c9e73137269fb2ac80ddc6c5", "srcset": "https://si.imgix.net/0e630967/uploads/origins/967f3660-f271-4e5d-ad36-765f563df3b8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=11610137c9e73137269fb2ac80ddc6c5, https://si.imgix.net/0e630967/uploads/origins/967f3660-f271-4e5d-ad36-765f563df3b8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=81859aa7e9