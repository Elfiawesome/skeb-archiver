耳もあります。\n\n表情や体勢は、目をつぶって笑顔で片耳のヘッドホンのみ片手で押さえながら収録しているイメージです。\nまた、もし可能であれば全身(髪の毛なども含む)を画角内に納めていただければ幸いです。\n\n使用用途はすずさんへのプレゼントで、\nすずさん本人限りで配信活動などでの使用許可をいただきたいです。\n（配信内、Xでの告知、サムネイルなどで使用する可能性があります）\n\nまた、宛名・人物・背景でレイヤー分けされたPSDファイルも頂けますと幸いです。\n\nその他参考資料：\nhttps://www.youtube.com/@NekoneSuzu\nhttps://twitter.com/Nekone_Suzu\n\n規約など：\nhttps://twpf.jp/Nekone_Suzu\n\nお忙しいところ恐縮ですが何卒よろしくお願い申し上げます！", "nc": 32, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@saya_TRPG/works/86", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/5c211185/uploads/origins/dbb85a6b-5488-4ce4-a4e0-d3383c50bcd2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=4df2440d9c496f57f70a6a1b019d41aa", "srcset": "https://si.imgix.net/5c211185/uploads/origins/dbb85a6b-5488-4ce4-a4e0-d3383c50bcd2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=4df2440d9c496f57f70a6a1b019d41aa, https://si.imgix.net/5c211185/uploads/origins/dbb85a6b-5488-4ce4-a4e0-d3383c50bcd2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=89c80391db819b20711735056de2a2ee 2x, https://si.imgix.net/5c211185/uploads/origins/dbb85a6b-5488-4ce4-a4e0-d3383c50bcd2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=bc43ead1e2e8e1bd661cac442c2a2db1 3x"}, "private": true, "genre": "art", "tipped": false, "creator_id": 675792, "client_id": 2208409, "nc": 128}, {"path": "/@saya_TRPG/works/85", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 675792, "client_id": 115484, "vtt_url": 