ive.google.com/drive/folders/1I-kzIWJTKriSG1jH7jTGO4e_tFVxwrJv?usp=sharing", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@saya_TRPG/works/69", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 675792, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/b43b6d73/uploads/origins/b56bd28c-36bc-43f5-a9a0-8e353c167ee0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7400d99182a39ae09c0aa066bf95a811", "srcset": "https://si.imgix.net/b43b6d73/uploads/origins/b56bd28c-36bc-43f5-a9a0-8e353c167ee0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7400d99182a39ae09c0aa066bf95a811, https://si.imgix.net/b43b6d73/uploads/origins/b56bd28c-36bc-43f5-a9a0-8e353c167ee0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=8a451d4e45e37a12b21583d70ab4322b 2x, https://si.imgix.net/b43b6d73/uploads/origins/b56bd28c-36bc-43f5-a9a0-8e353c167ee0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=588a63634f6650b312bd2545fccd515e 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/b43b6d73/uploads/origins/b56bd28c-36bc-43f5-a9a0-8e353c167ee0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9949623a3f5e72c0319d927f47208eea", "srcset": "https://si.imgix.net/b43b6d73/uploads/origins/b56bd28c-36bc-43f5-a9a0-8e353c167ee0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9949623a3f5e72c0319d927f47208eea, https://si.imgix.net/b43b6d73/uploads/origins/b56bd28c-36bc-43f5-a9a0-8e353c167ee0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=e67e6da99405b51087f1c51341fab40e 2x, https://si.imgix.net/b43b6d73/uploads/origins/b56bd28c-36bc-43f5-a9a0-8e353c167ee0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit