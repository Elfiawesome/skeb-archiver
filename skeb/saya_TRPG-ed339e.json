関係性など\n舞台はイタリアのミラノ。\n同じ新興宗教組織に所属しており、HO2がHO1を連れて逃げ出した過去を持つ。\n現在は2人で追っ手から逃げながら一緒に暮らしている。\n\n・普段の様子\n移動する時は手を握ったりお姫様抱っこしている。\n朝HO2がHO1を起こしたり、髪の毛乾かしたり、寝る前に絵本を読み聞かせて一緒に寝たりなど。\n\n\n▽使用用途\n個人鑑賞用\nアイコン、ヘッダーなどに使用させていただくこともあります！\n（自作発言などは行いません、使用する際はお名前記載させていただきます）\n\n┈┈┈┈┈┈┈┈┈┈\n\nこちら受理可能か御検討いただけると幸いです！\nご縁がありましたらよろしくお願い致します。\n\nhttps://drive.google.com/drive/folders/1-JgoyA12IDPHtcbAaGt9vdERS0GgHrju?usp=sharing", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@saya_TRPG/works/79", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/6aa2908b/uploads/origins/d8a2145e-58ba-4d39-92e7-f1f01f588bf6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=39762f6a635f855322fc10849ce56962", "srcset": "https://si.imgix.net/6aa2908b/uploads/origins/d8a2145e-58ba-4d39-92e7-f1f01f588bf6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=39762f6a635f855322fc10849ce56962, https://si.imgix.net/6aa2908b/uploads/origins/d8a2145e-58ba-4d39-92e7-f1f01f588bf6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=7fee1b7a43e72e471eb734d36dac5e2a 2x, https://si.imgix.net/6aa2908b/uploads/origins/d8a2145e-58ba-4d39-92e7-f1f01f588bf6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=41d1560cdcee5ce94c37325aebecac12 3x"}, "private": true, "genre": "art", "tipped": true, "creator_id": 675792, "client_id": 526664, "nc": 144}, {"path": "/@saya_TRPG/works/78", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 675792, "client_id": 