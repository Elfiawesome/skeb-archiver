1f-d65de31dbf52?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bc59a11f247570a1db2157d44feef167", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/bd3c7755/uploads/origins/9dbbaf4f-1fd8-4a70-bc1f-d65de31dbf52?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=39de6eabce3349b5dd5981366c32dc22", "src_set": ""}, "body": "こんにちは、リクエスト失礼します🌸\nMoji様の描く女の子の可愛さに一目惚れしリクエストを送らせていただきました。\n\n今回私と友人の創作キャラのうちよそを描いていただきたいです…！\nいたずらっ子な猫のような暗殺者（紫髪）×落ち着いていてクールなお姉さん （茶髪）\n\n▼\nhttps://drive.google.com/drive/folders/1Zh9c1ZCsy-ufTAlsSYLj7UJrjFh4HbpS\n\n▼\n服装はリンク内にある黒ナースの衣装でお願いしたいです。構図はお任せしますが、少し暗めの雰囲気で描いていただきたいです☺️\n注射器や点滴、カルテ、聴診器、薬など（全てじゃなくて構いません）の医療器具が描写してあると嬉しいです💉💊\n\n金額が足りなければ再送要請を送ってください。\nよろしくお願いします🍒◎", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@moji0105/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2584258, "client_id": 3001397, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/5dde994f/uploads/origins/a4cb07f5-f524-473c-a412-400d8ab8b768?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0355d1d5afdf4b7218daf0aa9252dea6", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/5dde994f/uploads/origins/a4cb07f5-f524-473c-a412-400d8ab8b768?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=413fc74fb42c9cd4a87d0de111c063cc", "src_set": ""}, "body": "初めまして、犬貴族と申します。\n\n新着でMoji様のイラストを拝見し、大変可愛らしく素敵で一目惚れいたしました…！\nもしよろしければ、私のOCを描いていただけますでしょうか？\n\n円\nhttps://drive.google.com/drive/folders/1-RwmEMVQ32S5Pj5aKe14NzK31zq3OWjt\n\nスズ\nhttps://drive.google.com/drive/folders/1XGthuV4ORoo6UCGiAXM1OSuPZLDn4XOP\n\n2人に関係性などの設定はありませんが、個人的に絡んでいるところを見てみたいです。\n距離感は遠すぎなければなんでも好きです！\n\n2人にペアルックの何か(制服でもコスプレでもなんでも大好きです)をお願いできますでしょうか？\n\nそのほか、構図や雰囲気などお任せいたします。\n\nご縁があれば嬉しいです。\nよろしくお願いいたします🙇‍♀️", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@moji0105/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2584258, "client_id": 0, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/bc459f47/uploads/origins/9e166e34-dbed-4c53-81ea-a4cd810fe468?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=665257b3b44927159e04a3dd19a16776", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/bc459f47/uploads/origins/9e166e34-dbed-4c53-81ea-a4cd810fe468?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2a57606edb4d806a118d60a1e4120c16", "src_set": ""}, "body": "Moji様はじめまして、素敵なイラストに一目惚れし送らせて頂きました😭✨️\n\n内容：私と私の友達のOCを描いて頂きたいです。\n希望範囲：膝上希望ですが金額内でできる限りで大丈夫です❕\n希望構図/表情/雰囲気：距離が近めの構図/表情はおまかせでお願い致します/リボンやレースなどの女の子のような甘々なの雰囲気\n資料：OC①... https://x.com/idxail4ltt7248/status/1730196307174957288?s=46\nOC②... https://x.com/idxail4ltt7248/status/1730351857065980291?s=46\nもし膝上可能な場合はOC①には白のニーハイ、OC②には黒のニーハイを履かせてやってください😭🖤ニーハイと服の間の太ももが見えているととても嬉しいです❕\nその他：色味は4/17のような色味でお願いしたいです🙏🏻\nOC①にはOC②を模した猫のぬいぐるみ、OC②にはOC①を模したうさぎのぬいぐるみを持たせてくださりますと嬉しいです😭🖤\n\n希望が多くて申し訳ございません🙇🏻‍♀️‪‪是非ご検討の方くださりますと大変幸いです😭🖤これからも活動の方応援させてください...🖤", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@moji0105/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2584258, "client_id": 1035701, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/2051f25d/uploads/origins/135f037f-125c-4686-a752-9254310380e3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d70fdc2c463f93f1521201e4b403abcb", "src_set": ""}, "duration": null, "nsfw": fa