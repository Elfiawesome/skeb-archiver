a77e1b261ac4 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/d19a52b7/uploads/origins/3fb9f6f9-4b71-4663-9f3c-59f917c26471?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6b88ad2a2b3daa00eccb21e3426a4c20", "srcset": "https://si.imgix.net/d19a52b7/uploads/origins/3fb9f6f9-4b71-4663-9f3c-59f917c26471?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6b88ad2a2b3daa00eccb21e3426a4c20, https://si.imgix.net/d19a52b7/uploads/origins/3fb9f6f9-4b71-4663-9f3c-59f917c26471?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=8c4fd3a79309efbda0c42c5e0e7aa52e 2x, https://si.imgix.net/d19a52b7/uploads/origins/3fb9f6f9-4b71-4663-9f3c-59f917c26471?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=530f65bd2505c3854642fd7937f91cc5 3x"}, "body": "どうも、ほのぼのとした心温まるスピキの日常の様子を大変楽しく拝見させていただいております。\nスピキ描きたいさんの優しいイラストが大好きなので依頼させていただきます。\nお願いしたいのはウイのまねっこをするスピキです。\n四葉のクローバーの代わりにかぼちゃの葉っぱを手にし、\nエルの代役は顔を描いたかぼちゃに務めてもらい、\n教主様に自信満々でまねっぷりをアピールするスピキを描いてほしいです。\nご検討宜しくお願い致します。", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@speakikakitai/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "comic", "tipped": true, "creator_id": 3908029, "client_id": 3740181, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/dca0e381/uploads/origins/cf032d87-5c0e-486a-a090-3c9d2441f0df?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7751818bb3ea8f3d95a368a141e17942", "srcset": "https://si.imgix.net/dca0e381/uploads/origins/cf032d87-5c0e-486a-a090-3c9d2441f0df?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7751818bb3ea8f3d95a368a141e17942, https://si.imgix.net/dca0e381/uploads/origins/cf032d87-5c0e-486a-a090-3c9d2441f0df?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2