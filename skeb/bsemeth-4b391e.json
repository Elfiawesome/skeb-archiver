45/uploads/origins/64250c5a-79d1-4b2e-bf17-83c261f91264?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=7cd8c53e8dde068e0e3917fe26a16241 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/78c93c45/uploads/origins/64250c5a-79d1-4b2e-bf17-83c261f91264?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=fcc3e2fee8a72a1a99e3f2220287e954", "srcset": "https://si.imgix.net/78c93c45/uploads/origins/64250c5a-79d1-4b2e-bf17-83c261f91264?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=fcc3e2fee8a72a1a99e3f2220287e954, https://si.imgix.net/78c93c45/uploads/origins/64250c5a-79d1-4b2e-bf17-83c261f91264?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=44713406fdbca3b4c15b40f1e0ceba75 2x, https://si.imgix.net/78c93c45/uploads/origins/64250c5a-79d1-4b2e-bf17-83c261f91264?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=0822b647739b02fa7cc982c3cbf33d5a 3x"}, "body": "はじめまして、新着クリエイター一覧から過去作品に惹かれてきました\nもしよろしければリクエストを受けていただけないでしょうか\nサービス終了したネットゲームのマイキャラクターがモデルのうちの子になります\nお淑やかな性格でむっつりスケベ、胸は控えめのスレンダーな子で、お尻が性感帯です\n\n・希望する内容を箇条書きで\n「依頼衣装（ランジェリー）」というファイルの衣装を着せてあげてください\n（色はお好みで選択してください、胸のスリットの開閉もお好みで、細かい装飾はアレンジしていただいても構いません）\n犬耳を着け、尻尾付プラグをお尻に挿入した状態（付け根のプラグが見えないような、尻尾だけお尻から伸びているような形状）\n恋人とのいちゃらぶセックス、または尻尾は無しでアナルセックス、その他オナニー、アナルオナニー、誘惑する様子…等々お好みのシチュエーションで\n犬になりきりながらorお尻で気持ちよさそうにしているイメージ\nとろとろで気持ちよさそうな表情\n相手の描写は無くても構いません\n胸の大きさは控えめ（Bカップ程度～つるぺたまでお好みで）\nランジェリーは着たままでお願いします（シチュエーションによってクロッチを開いてください）\n顔が見え、衣装が映えるよう正面から見た構図ですと嬉しいです\n\nご検討をお願いいたします\n\nhttps://drive.google.com/drive/folders/1gXZVDfcsl66QZ8VxPLKFXERqQXKioNsJ", "nc": 168, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 826989, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "2120", "screen_name": "new