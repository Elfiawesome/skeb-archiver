ress&fm=webp&fit=crop&crop=top&w=200&h=200&s=002ab388c8d8c2d8970b0e2981191ea0", "srcset": "https://si.imgix.net/397ec481/uploads/origins/3c48bd1b-7f61-4b70-bc66-cedb06bce3c6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=002ab388c8d8c2d8970b0e2981191ea0, https://si.imgix.net/397ec481/uploads/origins/3c48bd1b-7f61-4b70-bc66-cedb06bce3c6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=6a34d2b914f07e7cdfd781898a104172 2x, https://si.imgix.net/397ec481/uploads/origins/3c48bd1b-7f61-4b70-bc66-cedb06bce3c6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=52bed915e02277bcaa04061b74ea4b17 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/397ec481/uploads/origins/3c48bd1b-7f61-4b70-bc66-cedb06bce3c6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=7a422d85c9d376c71e4fa816e10a92d2", "srcset": "https://si.imgix.net/397ec481/uploads/origins/3c48bd1b-7f61-4b70-bc66-cedb06bce3c6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=7a422d85c9d376c71e4fa816e10a92d2, https://si.imgix.net/397ec481/uploads/origins/3c48bd1b-7f61-4b70-bc66-cedb06bce3c6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=d21ac6bd61be646f794089b7b2050907 2x, https://si.imgix.net/397ec481/uploads/origins/3c48bd1b-7f61-4b70-bc66-cedb06bce3c6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=429f709d3aa96a425cb0c6f50904f26a 3x"}, "body": "Dear Ebatan\nThank you very much for your kind attention.\nI would like to take advantage of your commission-free campaign and make a thick request for you to draw my guess again!\n\nThis time, I would like to request an illustration to celebrate the 7th anniversary of Shido Rio's delivery.\n\nPlease leave it to me to choose either \"idol costume\" or \"maid costume\" as the costume!\nHappy 7th anniversary! We would be very happy if you could draw it in a bright and happy atmosphere, full of the congratulatory mood of \"Congratulations on your 7th anniversary!\n\nWe would be very happy if you could draw it in a bright and happy atmosphere with a celebratory mood.\nThank you in advance for your consideration.\n\nAs a side note, the bunny girl illustration you drew last time\nI have made a tapestry of it and displayed it on my \"Pidana\ud83e\udd81\"!\nI look at it every day and am cheered up by the cheerful atmosphere. I am truly grateful.\n\nhttps://hub.vroid.com/characters/9160865399901412974/models/7765297067968533361", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@evanstan_/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 209341, "client_id": 464074, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/2d0abe19/uploads/origins/d244ed79-e9b1-48c7-8311-7a6d3aadc5e2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=aad4677491394534fdd77fb5ee156ce6", "srcset": "https://si.imgix.net/2d0abe19/uploads/origins/d244ed79-e9b1-48c7-8311-7a6d3aadc5e2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=aad4677491394534fdd77fb5ee156ce6, https://si.imgix.net/2d0abe19/uploads/origins/d244ed79-e9b1-48c7-8311-7a6d3aadc5e2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=9f8a6aabe062c5a1572186e05c473e5c 2x, https://si.imgix.net/2d0abe19/uploads/origins/d244ed79-e9b1-48c7-8311-7a6d3aadc5e2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=5e222cfb92176fe1e83237fd7c6d74e7 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/2d0abe19/uploads/origins/d244ed79-e9b1-48c7-8311-7a6d3aadc5e2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2fcbd4fc3838e45ef3cacabf4ba5c57d", "srcset": "https://si.imgix.net/2d0abe19/uploads/origins/d244ed79-e9b1-48c7-8311-7a6d3aadc5e2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2fcbd4fc3838e45ef3cacabf4ba5c57d, https://si.imgix.net/2d0abe19/uploads/origins/d244ed79-e9b1-48c7-8311-7a6d3aadc5e2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=321346ecc3caa493f647862745212b6f 2x, https://si.imgix.net/2d0abe19/uploads/origins/d244ed79-e9b1-48c7-8311-7a6d3aadc5e2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=cfbc3ea5ac07b9279f66434bf7911b0c 3x"}, "body": "Dear Ebatan, nice to meet you.\nI am pleased to see that you are looking for a skeb and would like to make a request.\n\nI would like to request you to create a fan art of Rio Shido.\n\nCharacter] Rio Shido (Personal Vtuber)\n\nPurpose of use\u3011Fan art, smartphone/PC wallpaper, SNS icon, header\n\nTheme] We would like you to create one of the following themes that Ebatan-sama says, \"You may draw! I would like you to create one of the following themes.\n\n1. Smiling face in bunny girl outfit.\nWear a bunny ear catsuit between your lion ears!\n*We wanted to have a drawing of the Super Bingo people celebrating their Super Bingo people from the bingo tournament that was delivered.\n\n2. A figure happily waving a penlight in a live T-shirt.\nT-shirt reference: https://stellamagna-goods.stores.jp/\nWe wanted to depict Stella Magna's live concert scheduled in February, and we wanted to depict them enjoying the live concert.\n\n3. A figure dressed as a maid making sweets.\nWe would like to see a scene where she is boiling chocolate and tasting it!\nWe wanted to draw a scene that reminds us of Valentine's Day chocolates in February.\n\n\nI got to know Ebatan-sama from Shido Rio's fan art.\nIllustration in idol costume! It was soooooo cute!\nI would like to send a request to Ebatan-sama to draw more guesses.\n\nIf the content of the request is against your will, please cancel the request.\n\nhttps://hub.vroid.com/characters/9160865399901412974/models/7765297067968533361", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@evanstan_/works/2", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/59ee3b64/uploads/origins/f3537f12-944c-4c51-beba-49c20aa3758b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=1a7b6173df5873fc2cac5b393e06f751", "srcset": "https://si.imgix.net/59ee3b64/uploads/origins/f3537f12-944c-4c51-beba-49c20aa3758b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=1a7b6173df5873fc2cac5b393e06f751, https://si.imgix.net/59ee3b64/uploads/origins/f3537f12-944c-4c51-beba-49c20aa3758b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=137fdf45c41fe3546b3ac1eca3cc50a0 2x, https://si.imgix.net/59ee3b64/uploads/origins/f3537f12-944c-4c51-beba-49c20aa3758b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=5fb1fbf4eef7b0273ba3911e4b83f970 3x"}, "private": true, "genre": "art", "tipped": true, "creator_id": 209341, "client_id": 562713, "nc": 0}, {"path": "/@evanstan_/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 209341, "client_id": 18962, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/e40f7af2/uploads/origins/d822f2a1-093c-4353-ae6a-1c2f21bb5b86?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=86dec1c7bd474f7882909bcb199d9429", 