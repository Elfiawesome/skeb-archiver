て。\n\nオサムライス様のイラストが大好きで、ぜひOCイラストの依頼をしたくご連絡させて頂きました。\n詳細下記にて添付させていただきます。\n\n服装は資料の中に何パターンか用意していますがお好きなように変えていただいても大丈夫です◎\n\n構図などはおまかせさせていただければと思うのですが、ケーキやクッキーなどの甘いお菓子を美味しそうに食べている表情や、好きな人のことを考えて｢わ〜！｣と照れてるような表情が似合う子なのでそんな雰囲気だと嬉しいです…！\n\nイラストは個人利用の範囲でアイコン等に使用させていただければと思っております。\n何か不備ございましたら再送いただけますと幸いです。\nよろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/1hZwoQzRWTZS87dOtBFilNXFgPUlz-7yW", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@osamu_rice/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "comic", "tipped": true, "creator_id": 3474461, "client_id": 948123, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/ce1891ff/uploads/origins/b7a81e31-de65-4752-aad0-7eb20fdc0ac9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2db818cde7f4abb64c1cd51d91d93e5f", "srcset": "https://si.imgix.net/ce1891ff/uploads/origins/b7a81e31-de65-4752-aad0-7eb20fdc0ac9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2db818cde7f4abb64c1cd51d91d93e5f, https://si.imgix.net/ce1891ff/uploads/origins/b7a81e31-de65-4752-aad0-7eb20fdc0ac9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=39a59ae48461b6c713fa1ce669616f47 2x, https://si.imgix.net/ce1891ff/uploads/origins/b7a81e31-de65-4752-aad0-7eb20fdc0ac9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=3dbe2975d7ac7f4a7994fac280076d10 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/ce1891ff/uploads/origins/b7a81e31-de65-4752-aad0-7eb20fdc0ac9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=cf324cb5d49e46f1573907cf22902735", "srcset": "https://si.imgix.net/ce1891ff/uploads/origins/b7a81e31-de65-4752-aad0-7eb20fdc0ac9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=cf324cb5d49e46f1573907cf22902735, ht