ive.google.com/drive/folders/18SAK8vqdnVGbrOQAcWBBoaGGyWKvn3Ha?usp=drive_link", "nc": 153, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@osamu_rice/works/7", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/b144171d/uploads/origins/a0979543-792a-47d0-8cf7-6b7c47b0f6ec?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=378a221a60728f45a8721d3228b76106", "srcset": "https://si.imgix.net/b144171d/uploads/origins/a0979543-792a-47d0-8cf7-6b7c47b0f6ec?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=378a221a60728f45a8721d3228b76106, https://si.imgix.net/b144171d/uploads/origins/a0979543-792a-47d0-8cf7-6b7c47b0f6ec?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=62f0a2f2551c290f16c6dca86cf55b47 2x, https://si.imgix.net/b144171d/uploads/origins/a0979543-792a-47d0-8cf7-6b7c47b0f6ec?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=9addd39abce9767ac12599a3d55e3003 3x"}, "private": true, "genre": "comic", "tipped": false, "creator_id": 3474461, "client_id": 1515256, "nc": 144}, {"path": "/@osamu_rice/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "comic", "tipped": false, "creator_id": 3474461, "client_id": 1077120, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/f3a3e4e5/uploads/origins/3b0a2cf3-ea88-424c-9193-7eeb96685351?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0eb13007669a43d8eeaf08cf68aedad6", "srcset": "https://si.imgix.net/f3a3e4e5/uploads/origins/3b0a2cf3-ea88-4