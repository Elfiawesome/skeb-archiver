っています。大食いです。\n\n②見た目10歳未満のアンドロイドの男の子です。髪の毛には桜色のアッシュが入っています。身長は135cmほどです。真面目で好奇心旺盛な性格をしています。また、①のことを世界で１番大事にしてくれています。人間ではありませんが①と一緒にご飯を食べたりしてくれます。\n\n—\n\n承認可能なリクエストであれば、何卒よろしくお願いします。", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}], "similar_creators": [{"id": 179744, "creator": true, "nsfw_acceptable": false, "acceptable": false, "name": "てかとり", "screen_name": "tktk_tori", "avatar_url": "https://pbs.twimg.com/profile_images/1342822049786470401/gL0aZPui.png", "header_url": "https://pbs.twimg.com/profile_banners/1193107349134643200/1626785480/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 14, "complete_expiration_days": 35, "skills": [{"genre": "art"}], "banned": false, "nc": 1}, {"id": 973484, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "22", "screen_name": "22work", "avatar_url": "https://proxy.misskeyusercontent.jp/avatar.webp?url=https%3A%2F%2Fmedia.misskeyusercontent.jp%2Fio%2Fa162dc9b-9967-466e-893f-a7c69045474f.webp&avatar=1", "header_url": null, "appeal_receivable": true, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 14, "complete_expiration_days": 60, "skills": [{"genre": "art"}], "banned": false, "nc": 144}, {"id": 1581731, "creator": true, "nsfw_acceptable": false, "acceptable": false, "name": "みずたに", "screen_name": "tupi900", "avatar_url": "https://pbs.twimg.com/profile_images/1471736266689753089/lyVNydtW.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1426092423067754497/1648927121/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_da