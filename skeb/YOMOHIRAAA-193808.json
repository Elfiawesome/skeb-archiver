ix.net/d4d652da/uploads/origins/65865320-9618-417a-b680-f0095d08ee36?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=6307ed8b738367fe6e5afae4f04fce82 2x, https://si.imgix.net/d4d652da/uploads/origins/65865320-9618-417a-b680-f0095d08ee36?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=55c642060a5385878aa740a04523aaa8 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/d4d652da/uploads/origins/65865320-9618-417a-b680-f0095d08ee36?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b0a5039d255abd4bbbd0a674ad8705be", "srcset": "https://si.imgix.net/d4d652da/uploads/origins/65865320-9618-417a-b680-f0095d08ee36?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b0a5039d255abd4bbbd0a674ad8705be, https://si.imgix.net/d4d652da/uploads/origins/65865320-9618-417a-b680-f0095d08ee36?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=7856edf35f479942362fe06863a56379 2x, https://si.imgix.net/d4d652da/uploads/origins/65865320-9618-417a-b680-f0095d08ee36?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=63a1b871d19b74bca4b02c98ef66438a 3x"}, "body": "はじめまして！\n個人VTuberの彩羽のあと申します。以前からかわいいイラストを拝見しており、この機会にご依頼させていただきました！\n今回は私彩羽のあと、一緒に活動している夏萌うなの2人を描いていただきたくリクエストしました。\n\n服装はお任せします\n構図はお任せしますが、友達の距離間で描いていただけると嬉しいです！ラブラブしすぎていなければ大丈夫です！\n表情差分があると嬉しいです…！\n\n✦使用用途\nSNSの投稿、サムネイル、配信・動画内、ファンクラブ\n(彩羽のあ・夏萌うなそれぞれの個人チャンネルやSNSで使用予定ですが、共有不可でしたら2人のチャンネルのみで使用いたします。)\n✦納品ファイル形式\n\"人物のみの透過PNG\"または\"レイヤーの分かれたPSD\"\n✦構図\n頭のアホ毛が切れないようにしていただくとサムネイルに使用しやすいです\n\nキャラクター説明\n【彩羽のあ】\n・天使ですが、羽は生えていません。アホ毛が天使の輪っかの名残です。\n・胸元の露出は控えめだと助かります！デコルテや足はいっぱい見えてても大丈夫です✨\n・イメージカラーはパープル\n・ねこちゃんが好きです\n\n【夏萌うな】\n・まーめいどなので左足のにピンクの鱗があります。\n・こちらも胸元の露出は控えめだと助かります！\n・イメージカラーはミントグリーン\n・まぐろが好きです\n\n不備があれば再送依頼をしていただけたらと思います。\n何卒宜しくお願い致します🙏🙏\n\nhttps://drive.google.com/drive/f