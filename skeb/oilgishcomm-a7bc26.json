x.net/8b789cb4/uploads/origins/97fbe80a-3f6d-4ea0-92cf-bb318084db49?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=21100f4ec2b7cd5fcb5bccf03b84bbd8", "srcset": "https://si.imgix.net/8b789cb4/uploads/origins/97fbe80a-3f6d-4ea0-92cf-bb318084db49?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=21100f4ec2b7cd5fcb5bccf03b84bbd8, https://si.imgix.net/8b789cb4/uploads/origins/97fbe80a-3f6d-4ea0-92cf-bb318084db49?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=529f29d469b15f28c638c84af69798fb 2x, https://si.imgix.net/8b789cb4/uploads/origins/97fbe80a-3f6d-4ea0-92cf-bb318084db49?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=5a94c2b0fa008fdf16fa4464e83befa0 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/8b789cb4/uploads/origins/97fbe80a-3f6d-4ea0-92cf-bb318084db49?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=430b3237a0915f5bff550d2c0c15daa4", "srcset": "https://si.imgix.net/8b789cb4/uploads/origins/97fbe80a-3f6d-4ea0-92cf-bb318084db49?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=430b3237a0915f5bff550d2c0c15daa4, https://si.imgix.net/8b789cb4/uploads/origins/97fbe80a-3f6d-4ea0-92cf-bb318084db49?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=05748abe88ccecbcd146b230ff3699be 2x, https://si.imgix.net/8b789cb4/uploads/origins/97fbe80a-3f6d-4ea0-92cf-bb318084db49?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=96679e0b30c2e2b1a31387cb5617e6dc 3x"}, "body": "ぎっしゅ様\n\nはじめまして。たぬまろと申します。\n今回、ぎっしゅ様のイラストを拝見し、是非一枚絵を依頼させていただきたく、リクエストお送りさせていただきました。\n以下、依頼内容となります。\n\n【依頼内容】\n・使用用途\n→個人利用、個人鑑賞用、SNSでのアイコン、ヘッダー利用、非商用グッズ作成(印刷等)\n\nイラストの内容といたしましては、大きな土鍋を温泉に見立てて、参考資料にいるたぬきが頭に手拭いなどを乗せて気持ちよさそうに浸かっている。その横で、水着を着た少女の方が浮き輪の上に仰向けに乗りジュース等を飲みながら楽しんでいる、と言った内容のものをお願いしたいです。周りにフロート感覚で鍋の具になりそうな魚や野菜が浮いていてもいいなと思っております。食べる方の鍋を温泉やプールに見立ててたぬきと少女が遊んでると言ったイメージです。\n少女が着る水着は、緑系統の色味でお願いしたいです。上にパーカーのようなラッシュガードを羽織ってたり、サングラスかけてても面白いと思っているのでお願いしたいです。デザインは、ぎっしゅ様にお任せいたします。\n参考資料に、イメージしてる構図も同封させていただきましたが、あくまでイメージなので、描きにくいところなどあったら変えていただきいて大丈夫です。\n\nお願いしたい内容としては以上になります。お忙しい中かと思いますが、何卒ご検討いただけますと幸いです。よろしくお願いいたします。\n\n【参考資料】\nhttps://drive.google.com/drive/folders/1-IfNgFNifnbONWKEq3TE9NuR0qN85SYr\n\nhttps://drive.google.com/drive/folders/1-IfNgFNifnbONWKEq3TE9NuR0qN85SYr", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@oilgishcomm/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 48755, "client_id": 2897774, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/394b8ccc/uploads/origins/9700b505-4d59-4c19-8bfb-173435269de6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=64f2ec170512aaac65e0080ffbb17095", "srcset": "https://si.imgix.net/394b8ccc/uploads/origins/9700b505-4d59-4c19-8bfb-173435269de6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=64f2ec170512aaac65e0080ffbb17095, https://si.imgix.net/394b8ccc/uploads/origins/9700b505-4d59-4c19-8bfb-173435269de6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=45c6661fc650bb3c33958a5c6ead07f9 2x, https://si.imgix.net/394b8ccc/uploads/origins/9700b505-4d59-4c19-8bfb-173435269de6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=3aeb42819fe014f16f80d80f07803ffa 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/394b8ccc/uploads/origins/9700b505-4d59-4c19-8bfb-173435269de6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=03f11075ecb55bba9e246057f914cba2", "srcset": "https://si.imgix.net/394b8ccc/uploads/origins/9700b505-4d59-4c19-8bfb-173435269de6?bg=%23fff&auto=format%2Cco