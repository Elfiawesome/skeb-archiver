haring", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@myk0ssk/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 4100488, "client_id": 1068142, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/b16302d8/uploads/origins/f8d0c22a-8209-481b-9d08-eb42ff7f0056?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=099370806e238bb4c766b1e5c30e0d77", "srcset": "https://si.imgix.net/b16302d8/uploads/origins/f8d0c22a-8209-481b-9d08-eb42ff7f0056?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=099370806e238bb4c766b1e5c30e0d77, https://si.imgix.net/b16302d8/uploads/origins/f8d0c22a-8209-481b-9d08-eb42ff7f0056?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=2af70785e138fe9eac0f49435f4bcde0 2x, https://si.imgix.net/b16302d8/uploads/origins/f8d0c22a-8209-481b-9d08-eb42ff7f0056?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=1c5e3198fcb21925f8204e50b84392b4 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/b16302d8/uploads/origins/f8d0c22a-8209-481b-9d08-eb42ff7f0056?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=fcf1a5b35a1ae7dde7ac0519804e149c", "srcset": "https://si.imgix.net/b16302d8/uploads/origins/f8d0c22a-8209-481b-9d08-eb42ff7f0056?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=fcf1a5b35a1ae7dde7ac0519804e149c, https://si.imgix.net/b16302d8/uploads/origins/f8d0c22a-8209-481b-9d08-eb42ff7f0056?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=fec37eb5b099b5cf6b1537b32658a6cb 2x, https://si.imgix.net/b16302d8/uploads/origins/f8d0c22a-8209-481b-9d08-eb42ff7f0056?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=36b983434f475bd2f7f6727677d29945 3x"}, "body": "こんにちは！先生、あなたの作風が大好きです！私のオリジナルキャラクターのイラストを描いていただけませんか？\n\nALEK | ♂️ | 46歳 | 181cm\n\n多くの悲しみを経験してきた男性。双子の兄弟を亡くし、長年付き合っていた恋人に見捨てられてしまった。 かつては明るくエネルギッシュだった彼だが、今はかつての面影を完全に失った空っぽの殻と化している。大男にしては泣き虫すぎる。サングラスの裏で、哀れな表情や不機嫌そうなしかめ面を隠していることが多い。筋肉質で日焼けした肌、黒く乱れた髪。ストレスのせいで白髪が混じり始めている。アホ毛あり。長いまつげと美しい虹色の瞳。疲れた様子。ハローは任意！\n\n苦難に直面しているにもかかわらず、彼は非常に幸運な男だ。昼間はオフィスで働き、夜は痛みを紛らわすために罪深い欲望（酒、ギャンブル、ドラッグ、情欲）にふけることが多い。生きる新たな理由を見つけたいと願っている。\n \nテーマ：喪失、保護、盾、献身的で忠実な犬のような存在。\n青い炎や稲妻に親和性があり、その感情のように不安定で強烈だ。\n\n正直なところ、彼は本当に哀れな存在だ。悲しい。上半身裸でも服を着ていても、どちらでも構いません！ありがとうございます！\n\nhttps://drive.google.com/drive/folders/1cf0AqeqAu2dO4xCH2DNJ7BVVmUzpO-11?usp=sharing", "nc": 8, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 8495, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "トモヨヒ@1日目(火)東7 R-02b", "screen_name": "M_tomoyohi", "avatar_url": "https://pbs.twimg.com/profile_images/1245195931756060673/exbKxDpK.jpg", "header_url": "https://pbs.twimg.com/profile_banners/96759835/1742519308/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "art"}], "banned": false, "nc": 176}, {"id": 120238, "creator": true, "nsfw_acceptable": true, "acceptable": false, "name": "かふん", "screen_name": "kafun", "avatar_url": "https://pbs.twimg.com/profile_images/574595511488921601/CQx_r8Kq.png", "header_url": "https://pbs.twimg.com/profile_banners/39225451/1426871684/1500x500", "appeal_receivable": false, "popular_creator_rank": 2, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 1, "complete_expiration_days": 28, "skills": [{"genre": "art"}], "banned": false, "nc": 177}, {"id": 938132, "creator": true, "nsfw_acceptab