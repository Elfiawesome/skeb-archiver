39-bf805860af41?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b85bb2be04186df97ca26a9e37eaacaf, https://si.imgix.net/51e44c21/uploads/origins/f773dfdc-6b05-42b7-8d39-bf805860af41?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=1a20a5839da5348331b4d1a858a23640 2x, https://si.imgix.net/51e44c21/uploads/origins/f773dfdc-6b05-42b7-8d39-bf805860af41?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=7eb98000f3cefa8c116925bf7fec4d2b 3x"}, "body": "オオクボユウ様\nはじめまして、Vライバー事務所Razzプロダクション所属の星那 柚花と申します。\n\nオオクボユウ様の描かれるイラストがとても可愛く綺麗で、ぜひ私 星那 柚花を描いていただきたいと思いご連絡いたしました。\n\n【使用用途】\n投げ銭機能付配信アプリ、YouTube、ツイキャスでのサムネイル(アイコン)やヘッダー\nSNS(X、Wick)での使用\nデジタル・リアルグッズの制作、頒布、販売\n外部案件での使用\n\n※トリミングや影つけなどの加工を行う場合がございます。\n\n【内容】\n衣装は秋の大人っぽ可愛い感じでお願いします。\n(カフェラテコーデ、チェック柄など)\n他は全てオオクボユウ様に一任させていただければと思います。\n好きにアレンジ、デザインしていただけると嬉しいです。\nぜひ、オオクボユウ様の得意な雰囲気で描いていただけると嬉しいです。\n難しければ衣装モチーフなども全て一任いたします。\n\n＊髪は頭頂部が黒で毛先に行くに連れ紫になるグラデーション\n＊モチーフは柚子の花、星\n＊左目下に泣きぼくろがあります。\n\n【性格や設定】\n天真爛漫だが少し抜けているところがある。\n一生懸命で頑張り屋だがすぐ病みがちなメンヘラな一面も。\n流花群(流星群のように花弁が降る)観測所の管理人だが、観測所自体は閑古鳥が鳴いているため実質ニートな生活を送っている。\n\n【お願い】\n頭部や髪、服が途切れていない(上と左右の途切れていない)キャラクターのみの透過データをいただけますと幸いです。\n\nご検討いただけますと幸いです。\nよろしくお願いいたします。\n\nhttps://www.dropbox.com/scl/fi/y6blan475ju5chq0c19rf/.png?rlkey=iu0l1ccisheufo6m2g5bn3r55&st=ocm319p0&dl=0", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Am01gn/works/10", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2436739, "client_id": 3091504, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/09adf592/uploads/origins/324c1c93-500a-4e26-8438-129b233de0bb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2a8eca18a8223c5e128df8c23c2a6a9e", "srcset": "https://si.imgix.net/09adf592/uploads/origins/324c1c93-500a-4e26-8438-129b233de0bb?bg=%23fff&auto=format%2Ccompress&