ぎの豊穣の女神です。\n（デザインのモチーフは月兎とエジプトのウェネト神です）\n・基本はゲラで元気いっぱい。\nゲームが下手なポンコツですが、\n物語の感想のお喋りなどを楽しんで沢山遊んでます。\n\n曲のイメージテーマは\n\n1曲目はパジャマパーティの様な、　\n可愛い部屋着とパジャマで\nのんびりくつろぎ女子会トーク\nの様な雰囲気でお願いしたいです。\n「きまぐれちゃん」や\n「金木犀の香り」の\nような、のんびりくるくる\n行ったり来たりな曲だと嬉しいです！\n\n2曲目は深夜の森の舞踏会のような、\nあやしさありつつも\nアリスのティーパーティのような\nトンチキ楽しそうな\n雰囲気の曲をお願いしたいです。\n「ひとりぼっち姫」が好きなので\n似た空気感の曲だと嬉しいです！\n\n\n\n《使用用途》\n収益化済みの YouTubeの配信、動画で、\nBGMとして使用させていただきたく思っております。\n\nご検討いただけると幸いです！\nよろしくお願いいたします。\n\nhttps://x.com/nechetoa/status/1841121158877626808?s=46&t=Oa4ZKTCLf4v-MQwGGYFJGA\n\nhttps://x.com/nechetoa/status/1841121271335305336?s=46&t=Oa4ZKTCLf4v-MQwGGYFJGA", "nc": 128, "word_count": 0, "transcoder": "audio", "creator_acceptable_same_genre": true}, {"path": "/@sarixbgm/works/10", "private_thumbnail_image_urls": null, "private": false, "genre": "music", "tipped": false, "creator_id": 3599501, "client_id": 2211417, "vtt_url": null, "thumbnail_image_urls": {"src": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1624729267698548736%2Ft5nrruNC.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b820afb36a9691cfd35647dd47037ca5", "srcset": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1624729267698548736%2Ft5nrruNC.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b820afb36a9691cfd35647dd47037ca5, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1624729267698548736%2Ft5nrruNC.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=3e8a401fb4bc1660dd2955fe2c901e51 2x, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1624729267698548736%2Ft5nrruNC.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c48c49ea8135acd6a47ad0f8c5459144 3x"}, "preview_url": "https://fcdn.skeb.jp/uploads/outputs/57e28e58-faa5-4555-ac8f-57fcff4e99e7?response-content-disposition=inline&Expires=1780475430&Signature=foe883ObA~GEA