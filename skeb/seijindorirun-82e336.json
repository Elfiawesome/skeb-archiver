ic", "tipped": false, "creator_id": 3279093, "client_id": 3178556, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/fac021d8/uploads/origins/c650a576-55cd-4dbb-9ac2-6855533a534c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=11e9d8138b5c22b5b639151c1a7f0af9", "srcset": "https://si.imgix.net/fac021d8/uploads/origins/c650a576-55cd-4dbb-9ac2-6855533a534c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=11e9d8138b5c22b5b639151c1a7f0af9, https://si.imgix.net/fac021d8/uploads/origins/c650a576-55cd-4dbb-9ac2-6855533a534c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=3262f2bc94748c2d759a45477cf4306a 2x, https://si.imgix.net/fac021d8/uploads/origins/c650a576-55cd-4dbb-9ac2-6855533a534c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f77d4e4a664806c1638d044cd10c0bcf 3x"}, "duration": null, "nsfw": true, "hardcore": true, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/fac021d8/uploads/origins/c650a576-55cd-4dbb-9ac2-6855533a534c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9dfb9627c781d2f5fba566aee0fb1d8f", "srcset": "https://si.imgix.net/fac021d8/uploads/origins/c650a576-55cd-4dbb-9ac2-6855533a534c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9dfb9627c781d2f5fba566aee0fb1d8f, https://si.imgix.net/fac021d8/uploads/origins/c650a576-55cd-4dbb-9ac2-6855533a534c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=878d43bbeae385c79601e8718646444d 2x, https://si.imgix.net/fac021d8/uploads/origins/c650a576-55cd-4dbb-9ac2-6855533a534c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=df4e2866a41b152177df29a09d88c288 3x"}, "body": "再びどりるんさん、こんにちは！前回リクエストさせていただいた娘を主人公にした漫画をリクエストさせていただきます。名前は未定なので、とりあえず「むらさき」と呼ぶことにします。\n\nカリスマ教師で、若々しく、生徒からの人気も高い。服装はブレザーにスカート。ある日、内気な男子が授業中に告白してきた。恥ずかしくなった村崎は、授業が終わった後、その男の子に泊まっていくように頼む。他の生徒たちは彼が困っていると思い、馬鹿にする。紫は彼をいい子と呼び、\"ご褒美 \"を与える。彼女は自分の胸を見せ、少年を興奮させる。服を汚さないように、彼のペニスを撫でたり、しゃぶったりする。彼女は病みつきになり、少年に一緒に家に帰ろうと誘う。彼女の家で、紫は彼に着替えて待っているように言う。彼女はJ○の制服を着て、彼に好きかどうか尋ねる。少年はすぐにまた硬くなる。二人は何度もセックスを繰り返し、射精するたびに淫らになっていく。あとはあなた次第。🙇‍♂️\n\nhttps://imgur.com/a/zUHd3Zg", "nc": 170, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@seijindorirun/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "comic", "tipped": false, "creator_id": 3279093, "client_id": 3178556, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/7df78de4/uploads/origins/4b4b10db-ca2d-41a3-9528-06e6ea0c502d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ecc5ecfa2a204e939a272663981dd238", "srcset": "https://si.imgix.net/7df78de4/uploads/origins/4b4b10db-ca2d-41a3-9528-06e6ea0c502d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ecc5ecfa2a204e939a272663981dd238, https://si.imgix.net/7df78de4/uploads/origins/4b4b10db-ca2d-41a3-9528-06e6ea0c502d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=bdd3f256f18767b8836130d31ef6e6bf 2x, https://si.imgix.net/7df78de4/uploads/origins/4b4b10db-ca2d-41a3-9528-06e6ea0c502d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=8ec87e6585b6491870dc4a20cbc69617 3x"}, "duration": null, "nsfw": true, "hardcore": true, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/7df78de4/uploads/origins/4b4b10db-ca2d-41a3-9528-06e6ea0c502d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d33ef56f5ccf5f082a22f95389109494", "srcset": "https://si.imgix.net/7df78de4/uploads/origins/4b4b10db-ca2d-41a3-9528-06e6ea0c502d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d33ef56f5ccf5f082a22f95389109494, https://si.imgix.net/7df78de4/uploads/origins/4b4b10db-ca2d-41a3-9528-06e6ea0c502d?bg=%23fff&auto=forma