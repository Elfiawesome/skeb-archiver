意識が残っている侑々溜の身体をしばらく弄んだあと、強烈なパンチを頬に喰らわせる。侑々溜は凄まじい勢いでリングに叩きつけられ、尻を突き上げた土下座のような大股開きで2人の足元に転がる格好に。拳の跡が頬にくっきり残る無惨な姿を嘲られながら完全に意識を失う。", "nc": 185, "word_count": 7768, "transcoder": "text", "creator_acceptable_same_genre": true}], "similar_creators": [{"id": 122407, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "月川🪼🦀", "screen_name": "tsuki_kawa", "avatar_url": "https://pbs.twimg.com/profile_images/2023242826545537024/8jbgkgt_.jpg", "header_url": "https://pbs.twimg.com/profile_banners/710058073268719618/1634665488/1500x500", "appeal_receivable": true, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "art"}, {"genre": "novel"}, {"genre": "video"}, {"genre": "correction"}], "banned": false, "nc": 161}, {"id": 1305033, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "✦ MEIGUU ✦", "screen_name": "meiguu_Skeb", "avatar_url": "https://pbs.twimg.com/profile_images/2030518945896415232/28ingiuF.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1326171097255956480/1771993906/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 7, "complete_expiration_days": 60, "skills": [{"genre": "art"}], "banned": false, "nc": 0}, {"id": 1491581, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "sasa_ki____", "screen_name": "sasa_ki____", "avatar_url": "https://pbs.twimg.com/profile_images/2040182738498842624/fn3-f9AY.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1325338097257598976/1775252455/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 3, 