62129f/uploads/origins/dbec926d-92bc-4799-8351-a4feaeb427e7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=dd2b6cb57e1635b286bf59cc17a0f7be", "srcset": "https://si.imgix.net/0662129f/uploads/origins/dbec926d-92bc-4799-8351-a4feaeb427e7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=dd2b6cb57e1635b286bf59cc17a0f7be, https://si.imgix.net/0662129f/uploads/origins/dbec926d-92bc-4799-8351-a4feaeb427e7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=cd4fe072595647a493e97e80efa68d33 2x, https://si.imgix.net/0662129f/uploads/origins/dbec926d-92bc-4799-8351-a4feaeb427e7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=6e3c26bb4e698bc413f111f7d70dee8d 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/0662129f/uploads/origins/dbec926d-92bc-4799-8351-a4feaeb427e7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=8835c2c3a947b250febb0fdd6e483d84", "srcset": "https://si.imgix.net/0662129f/uploads/origins/dbec926d-92bc-4799-8351-a4feaeb427e7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=8835c2c3a947b250febb0fdd6e483d84, https://si.imgix.net/0662129f/uploads/origins/dbec926d-92bc-4799-8351-a4feaeb427e7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=02ec58c7cfa3e095806c14e8fdba2d0e 2x, https://si.imgix.net/0662129f/uploads/origins/dbec926d-92bc-4799-8351-a4feaeb427e7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=08534a2cb927bcba69fe6e4770b5b409 3x"}, "body": "こんにちはa先生！\nX先生が描いた男と女は本当に可愛かったです……もし可能であれば、私の創作男女を描いていただけないでしょうか。\n金額になにか問題があれば再送要請してください。\n難しければキャンセルして大丈夫です～\n\n▼参考リンクでは、キャラクターの設定など、絵の参考情報をご覧いただけます。\n\n▼キャラクターなど：\n男=D，女=R\n『ハンガー・ゲーム』や『バトル・ロワイアル』のようなサバイバルゲームを舞台にした物語です。 二人はチームメイト。 (ちょっと曖昧かもしれませんが...)\nロケ地は主に森の中です。\nどちらも30歳前後成熟した大人! Dは筋肉質（ロシア人）、Rはぽっちゃり系。\nDは活発な善人を装った殺人鬼、Rは人見知りしやすく、生き残るために苦労している外科医。\n\n要するに、犬のふりをした悪い猫D & 働き者の子犬R。真面目に地獄から抜け出そうとする善良な女が、一見無害だが実はかなり悪質な男に取り憑かれる\n\nどちらもちょっと間抜けに見えるんだろうな...（Dが偽装しているにもかかわらず。） だから、どんなかわいいやりとりでもいいんです。\n\n▼内容など：\nもし可能であれば、落書き詰め込みが欲しいです...！\n\n二人よりも、女性キャラクター(R)の単人をもう少し描いていただいても大歓迎です！\n私が見てみたいと思うものをいくつか挙げてみます：\n- バニーガール衣装を着た二人\n- メイド服を着た二人: https://drive.google.com/drive/folders/1p1djpsmOeGTOJ87Pyu9aP3GeJeeyacjz\n- このイラストの服を着たR: https://drive.google.com/file/d/1VBcvzs9vkYCo7gxADX-IoJnRMKfJub_O/view?usp=drivesdk\n- NSFWなRが胸を露出しているシーン\n- その他、思いつくあらゆる状況\n\n服のデザインは自由に変えることができます。ポーズや表情も自由です～\n\n没ラフや下描きなどがあれば残したままにしていただけると嬉しいです。\n私の依頼を考慮していただき、ありがとうございました！><\n\nhttps://drive.google.com/drive/folders/1Bf64h9wMoueFd43YA-UAL-PjWzrUGVRE?usp=sharing", "nc": 176, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@usagiluv/works/11", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/49612c22/uploads/origins/8d51fea3-51f8-4e44-a1c1-5551b06ce971?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=48546788d0b0207c9394def1db74c7f7", "srcset": "https://si.imgix.net/49612c22/uploads/origins/8d51fea3-51f8-4e44-a1c1-5551b06ce971?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=48546788d0b0207c9394def1db74c7f7, https://si.imgix.net/49612c22/uploads/origins/8d51fea3-51f8-4e44-a1c1-5551b06ce971?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=8ee8e9f990ecd0fad30cdced1ff5d3b1 2x, https://si.imgix.net/49612c22/uploads/origins/8d51fea3-51f8-4e44-a1c1-5551b06ce971?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Cc