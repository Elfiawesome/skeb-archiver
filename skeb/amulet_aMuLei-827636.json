ミュレイちゃんらしい言い方でお願いします。\nカット：空いているスペースのところにアミュレイちゃんの顔のアップと、赤ちゃんが出てくるところのアップをそれぞれカットインでいれてください。\n顔・表情：前述のセリフが合う感じでお願いします。\n他：「ずりゅ」「ぐぐぐ」などの効果音も入れてくださいましたら嬉しいです。\n差分：文字なし差分もいただけましたらお願いします。\n\nよろしくお願いします。また、このリクエストを機にお近づきになれましたら僥倖です。", "nc": 40, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@amulet_aMuLei/works/6", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/8f53c5f4/uploads/origins/4966bc10-8625-448b-af14-809adf280bf8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=894903d70f11b05f3004bf2a644b0ba2", "srcset": "https://si.imgix.net/8f53c5f4/uploads/origins/4966bc10-8625-448b-af14-809adf280bf8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=894903d70f11b05f3004bf2a644b0ba2, https://si.imgix.net/8f53c5f4/uploads/origins/4966bc10-8625-448b-af14-809adf280bf8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=7db08dd8dc15b7c8bd1b21acc746919e 2x, https://si.imgix.net/8f53c5f4/uploads/origins/4966bc10-8625-448b-af14-809adf280bf8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=86c7a2e6a933192e8572ff52d4e78715 3x"}, "private": true, "genre": "art", "tipped": false, "creator_id": 261516, "nc": 160}, {"path": "/@amulet_aMuLei/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 261516, "client_id": 131679, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/3ac834ec/uploads/origins/eaff58ba-6aea-487a-9662-fe74502fcdfa?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop