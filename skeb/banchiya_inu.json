ます\n\n・場所は平原のド真ん中（明るさは普通）\n・ゴブリンに抱きつかれて立位で犯される美波。資料では肩辺りがおっぱいに挟まっている感じですが、ちょうど顔が美波のおっぱいの谷間に挟まる感じでお願いします\n・美波はカメラ目線で、表情やおっぱいも楽しめる構図（資料と同じような構図でも構いません）\n・大量膣内射精されても悦んでイってしまうほど異種姦快楽に堕ちている\n・事後の受精描写もあると嬉しいです\n・衣装は半脱ぎ。剣や盾は不要です\n・資料のような昔ながらの露出度の高いビキニアーマー装備。色は美波のイメージカラーである青が基調の物\n・鎧やアクセサリーの細かいデザインや装飾はお任せします\n・陰毛は無し\n・竿役はオーソドックスな容姿のゴブリン。女を犯すことしか頭に無くイボイボまみれ巨根＋絶倫設定\n・セリフを入れていただけるのであれば、美波は男性器の事を「おちんちん」呼び\n\n衣装の細かい装飾や、細かい構図についてはばんちやさんにお任せ致します\nお忙しい中かとは思いますが、何卒宜しくお願い致します\n\nhttps://x.com/kak_155555/status/1911401133722984645", "nc": 168, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@banchiya_inu/works/70", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/4b54b292/uploads/origins/7fe3c9b3-efb5-4b0f-b175-bb6c4e916893?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=1241a481a242fb4656126365d5c00009", "src_set": ""}, "private": true, "genre": "art", "tipped": true, "creator_id": 2544845, "client_id": 0, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 160, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@banchiya_inu/works/69", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/4e377139/uploads/origins/8f2597fd-045c-4616-aeeb-b1e6140aca63?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=e07736ae1583b08dbc1673c0daefaec8", "src_set": ""}, "private": true, "genre": "art", "tipped": true, "creator_id": 2544845, "client_id": 0, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 160, "word_count": 0, "transcoder": "", "creator_acceptable_same_genr