{"screen_name": "banchiya_inu", "first_seen": "2025-09-26T16:57:18.937589+00:00", "last_updated": "2025-09-26T16:57:18.937589+00:00", "profile": {"id": 2544845, "acceptable": false, "creator": true, "avatar_url": "https://pbs.twimg.com/profile_images/1622600900396351489/eb4q6VLB.jpg", "name": "ばんちやさん🔞", "nsfw_acceptable": true, "screen_name": "banchiya_inu", "language": "ja", "body_size": 1000, "received_works_count": 82, "received_nsfw_works_count": 82, "appeal_receivable": false, "sent_first_works_count": 0, "sent_public_works_count": 0, "instruction": "unspecified", "description": "Ｒ１８有であれこれ描いています。\n\nSkebを始めました、よろしくお願いいたします。\n【Skeb】http://skeb.jp/@banchiya_inu\n【Pixiv】http://pixiv.net/users/84330199", "busy": false, "url": null, "show_social_profile": true, "accept_expiration_days": 20, "complete_expiration_days": 50, "received_requests_average_response_time": null, "completing_average_time": null, "nc": 177, "twitter_uid": "1607205076543901696", "user_service_link": [], "banned": false, "banned_by": "", "complete_rate": 0.97, "og_image_url": "https://skeb-avatar.imgix.net/https%3A%2F%2Ffcdn.skeb.jp%2Fassets%2Fv1%2Fcommons%2Fogp.png?auto=format%2Ccompress&fit=crop&crop=top&w=1200&h=630&s=fb919ed2f719addcbe44cbdea9c1851a", "skills": [{"genre": "art", "default_amount": 7000}], "acceptable_only_public": false, "tip_acceptable": true, "yearly_report_client_visible": false, "total_appeals_count": 0, "received_works": [{"path": "/@banchiya_inu/works/82", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2544845, "client_id": 0, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/6a3652d1/uploads/origins/0b00a435-249e-4cc5-9697-d1dcc86fe66d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5e9af8bad10743a29109c7da73d5cb9c", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/6a3652d1/uploads/origins/0b00a435-249e-4cc5-9697-d1dcc86fe66d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=cbdbd52830ebfc751706bf7f7920f6da", "src_set": ""}, "body": "艦これ\nホーネット\n\n前回と同じ蝿とイチャラブ交尾\n\n片足を上げスカートを持ち上げ股間に張り付いた蝿と交尾を見せつけ潮吹き\n表情\n以前のまんぐり返しホーネットの1枚目時と同じ表情\n\n差分1\n中出しされる\n表情\n開口笑顔\n断面図\n前回と同じ卵鞘と精液を中出し\n\n差分2\n蝿を出産しながら潮吹き\n太腿に数匹の蝿\n表情\n片面閉じ笑顔\n断面図\n蝿だらけ(数匹でも可能\n\n服装\n中破時のもの\n\n\n前回と同じ体位は此方の一枚目を参考\nスカート内部を下から覗く様なアングルでお願いします\nまたウォースパイトの片足上げのイラストと左右対照に近いアングルでお願いします\n\nhttps://www.pixiv.net/artworks/132824086\n\nホーネット資料\nhttps://blog-imgs-142-origin.fc2.com/k/c/w/kcwiki/No403_0_CD.jpg\n\nhttps://www.youtube.com/watch?v=XJU2smeOvsM\n\n検討よろしくお願いします。", "nc": 168, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@banchiya_inu/works/81", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/a92eb6dd/uploads/origins/06de35ae-ccfd-41d1-b7d4-398e9133bb02?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=d4f9251e48d55c8238f7cb4759e3b17e", "src_set": ""}, "private": true, "genre": "art", "tipped": false, "creator_id": 2544845, "client_id": 96169, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 49, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@banchiya_inu/works/80", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2544845, "client_id": 0, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/01d23eb3/uploads/origins/93960f7a-844e-4be3-a28e-f7a01b0d7140?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=20de48c01119d931c6a1fbc9dfb7ff22", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.