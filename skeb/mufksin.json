ん兼不動産管理もしてる大家さん\n・動く仕事もしてるので脂はありつつしっかり鍛えたカラダつきをしている\n…という感じです！上記に資料URLには書いてないものはありますが、資料に目を通していただければ大丈夫な内容になっております。\n\n○イラストのシチュエーション\n夢絵\n→夢主描写はありなしはお任せします！\nなんでも大丈夫なので好きにどうぞ…！！\nシチュエーションについてはお任せします！前回は昭和のイメージとありましたが、ルールも法則も無用のなんでもアリで大丈夫です！！\n※設定は現代+昭和特化の地域にいる設定なので、ほんとうになんでもOKです！！\n\n○使用用途\n画像の保存や妄想などの個人利用を原則として、もし可能であればX(Twitter)にてマフ様の絵を紹介・共有をしたいなと考えております！(skebリンク付き・著名付きなど確実に描いてもらったという明記をします)\n\n以上になります！再度の依頼でも長文になってしまいました…もしよろしければ承諾のほどよろしくお願いします。\n\nhttps://drive.google.com/drive/folders/1_vd_eXtGIGJ0PpJ8-y7QQLZ3ZB8mSKCW", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@mufksin/works/10", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/e9e8d63f/uploads/origins/1bdf50c4-e6b6-4b44-a702-4ab1a2c3501f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=e4e8a6e95f9f02e4f836e0a6b9a2f36e", "src_set": ""}, "private": true, "genre": "art", "tipped": false, "creator_id": 33878, "client_id": 0, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 0, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@mufksin/works/9", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 33878, "client_id": 2890578, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/763563ed/uploads/origins/30e181e7-9c2e-441b-ac18-758a3d4d3172?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8995fe3bf32f9d19dc618b2cc298199f", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/763563ed/uploads/origins/30e181e7-9c2e-441b-ac18-758a3d4d3172?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=cd110cb68