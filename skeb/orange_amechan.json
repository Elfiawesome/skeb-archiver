ーの参考\n下記URLに、見た目の詳細、髪色目色の参考などを記載した画像がございますので、そちらを参考に描いていただきたいです。\n衣装について、アレンジや変更も歓迎ですので、お任せいたします。\nhttps://drive.google.com/drive/folders/1oCMEnuUinCsVPVfv1Sv0fUFFwNYsbx5r?usp=sharing\n\n歌うことが大好き。青色と水色が好き。穏やかでマイペース。\nモチーフとして蝶々を描いて欲しいです。\n\n歌声の雰囲気の参考：https://youtu.be/ztDhicBw1ao\n\n\nご検討のほど、よろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/1oCMEnuUinCsVPVfv1Sv0fUFFwNYsbx5r?usp=sharing", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@orange_amechan/works/8", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3649644, "client_id": 3443339, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/c4ae7288/uploads/origins/586e83b3-8c92-4f39-9bc3-9c4bc8472c35?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ebf90cf0d6ab908bf45574f1bdc14e75", "srcset": "https://si.imgix.net/c4ae7288/uploads/origins/586e83b3-8c92-4f39-9bc3-9c4bc8472c35?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ebf90cf0d6ab908bf45574f1bdc14e75, https://si.imgix.net/c4ae7288/uploads/origins/586e83b3-8c92-4f39-9bc3-9c4bc8472c35?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=565dd8b88c26fd64f74c613a28e04424 2x, https://si.imgix.net/c4ae7288/uploads/origins/586e83b3-8c92-4f39-9bc3-9c4bc8472c35?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c558190cc147b5e6a1ec8fd1bbaef0a2 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/c4ae7288/uploads/origins/586e83b3-8c92-4f39-9bc3-9c4bc8472c35?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5b6ac4bb0c0632110e08bcac45eaa3c4", "srcset": "https://si.imgix.net/c4ae7288/uploads/origins/586e83b3-8c92-4f39-9bc3-9c4bc8472c35?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5b6ac4bb0c0632110e08bcac45eaa3c