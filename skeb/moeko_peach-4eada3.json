8\n\n\u521d\u3081\u307e\u3057\u3066\uff01\n\u500b\u4eba\u52e2\u3067Vtuber(\u6e96\u5099\u4e2d)\u914d\u4fe1\u8005\u3068\u3057\u3066\u6d3b\u52d5\u3057\u3066\u3044\u308b\u3001zer0\u96f6,(\u30bc\u30ed)\u3068\u7533\u3057\u307e\u3059\u3002\n\u3082\u3048\u516c/MOEKO\u69d8\u306e\u63cf\u304b\u308c\u308b\u30a4\u30e9\u30b9\u30c8\u306e\u30d5\u30a1\u30f3\u3054\u3056\u3044\u307e\u3059\uff01\u30ea\u30af\u30a8\u30b9\u30c8\u306e\u53d7\u4ed8\u306e\u518d\u958b\u3092\u697d\u3057\u307f\u306b\u3057\u3066\u304a\u308a\u307e\u3057\u305f\uff01\n\u3082\u3057\u3088\u308d\u3057\u3051\u308c\u3070\u3001 \u79c1\u306e\u30d0\u30fc\u30c1\u30e3\u30eb\u306e\u59ff\u306e\u30a4\u30e9\u30b9\u30c8\u3092\u304a\u9858\u3044\u3067\u304d\u307e\u305b\u3093\u3067\u3057\u3087\u3046\u304b\uff1f\n\n\n\u25cf\u6027\u683c\u30fb\u8a2d\u5b9a\u30fb\u898b\u305f\u76ee\u7b49\n\u898b\u305f\u76ee\u306f\u5e7c\u5150\u4f53\u578b(\u30ed\u30ea)\u3060\u3051\u3069\u3001\uff15\u5104\u6b73\u3002\n(\u5927\u4eba\u306a\u306e\u3067\u30d4\u30a2\u30b9\u3084\u30cd\u30a4\u30eb\u3092\u3057\u3066\u304a\u308a\u307e\u3059)\n\u81ea\u79f0\u4eba\u9593\uff01\u660e\u308b\u304f\u53ef\u611b\u3089\u3057\u304f\u7b11\u3046\u5973\u306e\u5b50\u3002\n\u30a4\u30e1\u30fc\u30b8\u30ab\u30e9\u30fc\u306f\u6c34\u8272\u3002\n\u77b3\u306e\u8272\u306f\u6de1\u304f\u6f84\u3093\u3060\u7d2b\u8272\u3002\n\u8eab\u9577\u306f150cm\u5f31\u3002\u80f8\u306f\u307a\u305f\u3093\u3053\u306e\u307e\u306a\u677f\u3002\n\u592a\u3082\u3082\u306e\u7d76\u5bfe\u9818\u57df\u304c\u3048\u3061\u8981\u7d20\u3002\n\u3082\u3075\u3082\u3075\u306e\u732b\u8033\u3068\u3001\u5815\u5929\u4f7f\u306e\u7ffc\u304c\u4ed8\u5c5e\u3057\u3066\u3044\u308b\u3002\n\u30d8\u30a2\u30d4\u30f3\u306f\u9ec4\u7dd1\u306e\u300c\uff10\u3068\u30ab\u30f3\u30de\u300d\u3092\u30e2\u30c1\u30fc\u30d5\u306b\u3057\u305f\u5f62\u3002\n\u5c11\u3057\u3068\u3093\u304c\u3063\u305f\u30a8\u30eb\u30d5\u8033\u3068\u6ce3\u304d\u307c\u304f\u308d\u304c\u30c1\u30e3\u30fc\u30e0\u30dd\u30a4\u30f3\u30c8\u3002\n\u9aea\u306e\u6bdb\u306f\u5c11\u3057\u30c8\u30fc\u30f3\u30c0\u30a6\u30f3\u3057\u305f\u6c34\u8272\u306e\u80a9\u4e0b\u30dc\u30d6\u30d8\u30a2\u30fc\u3002\u524d\u9aea\u306b\u8d64\u7d2b\u8272\u306e\u6bdb\u675f\u304c\u4e00\u3064\u3042\u308b\u3002\n\u670d\u306f\u30a8\u30e1\u30e9\u30eb\u30c9\u30b0\u30ea\u30fc\u30f3\u306e\u71d5\u5c3e\u670d\u3092\u4e0a\u306b\u306f\u304a\u3063\u3066\u304a\u308a\u3001\u4e0b\u306f\u30a2\u30b7\u30f3\u30e1\u30c8\u30ea\u30fc\u30b9\u30ab\u30fc\u30c8\u3092\u306f\u3044\u3066\u3044\u308b\u3002\u30d1\u30c3\u3068\u898b\u3001\u8ecd\u670d\u30ef\u30f3\u30d4\u30fc\u30b9\u307d\u3044\u3002\n\u9774\u4e0b\u306f\u30a2\u30b7\u30f3\u30e1\u30c8\u30ea\u30fc\u306a\u767d\u30cb\u30fc\u30cf\u30a4\u3002\u9774\u306f\u9752\u7d2b\u3068\u8d64\u7d2b\u8272\u3002\u30cd\u30b3\u306e\u30e2\u30c1\u30fc\u30d5\u4ed8\u304d\u3067\u3001\u9774\u5e95\u306b\u306f(\u898b\u3048\u3066\u3044\u306a\u3044\u304c)\u3077\u306b\u3077\u306b\u306e\u8089\u7403\u304c\u4ed8\u3044\u3066\u3044\u308b\u3002\n\n\u25cf\u8cc7\u6599\n\u4e0b\u8a18\u306bURL\u3042\u308a\u3002\n\u304a\u624b\u6570\u3067\u306f\u3054\u3056\u3044\u307e\u3059\u304c\u3001\u3088\u308d\u3057\u3051\u308c\u3070\u3054\u53c2\u8003\u304f\u3060\u3055\u3044\u307e\u305b\u3002\n\n\u25cf\u30a4\u30e9\u30b9\u30c8\u306e\u96f0\u56f2\u6c17\n\u5168\u8eab\u304c\u5165\u3063\u3066\u3044\u3066\u3001\u5c11\u3057\u52d5\u304d\u306e\u3042\u308b\u7acb\u3061\u7d75\u3060\u3068\u5b09\u3057\u3044\u3067\u3059\uff01\u3053\u3061\u3089\u3068\u76ee\u304c\u5408\u3046\u611f\u3058\u306b\u53ef\u611b\u304f\u63cf\u3044\u3066\u3044\u305f\u3060\u3051\u305f\u3089\u5e78\u3044\u3067\u3059\u3002\n\u4e0a\u8a18\u306e\u8868\u60c5\u5dee\u5206\u3067\u300c\u6ce3\u304d\u9854\u300d\u3068\u300c\u6012\u3063\u305f\u9854\u300d\u3082\u63cf\u3044\u3066\u3044\u305f\u3060\u3051\u308b\u3068\u3042\u308a\u304c\u305f\u3044\u306e\u3067\u3059\u304c\u3001\u96e3\u3057\u3051\u308c\u3070\u3053\u3061\u3089\u306f\u306a\u304f\u3066\u3082OK\u3067\u3059\uff01\n\u80cc\u666f\u3084\u30b5\u30a4\u30f3\u3092\u9802\u3051\u308b\u5834\u5408\u306f\u3001\u30ec\u30a4\u30e4\