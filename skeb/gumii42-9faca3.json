fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=11344149e52d616c9734879c779eef02", "srcset": "https://si.imgix.net/eef4b5e1/uploads/origins/d91cac64-b968-4f17-a9b3-8d9135cb3321?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=11344149e52d616c9734879c779eef02, https://si.imgix.net/eef4b5e1/uploads/origins/d91cac64-b968-4f17-a9b3-8d9135cb3321?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=417f8a4f825acb1f7d0de3740950eb98 2x, https://si.imgix.net/eef4b5e1/uploads/origins/d91cac64-b968-4f17-a9b3-8d9135cb3321?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=5b14a9f2acc3c2e20debc571129cf108 3x"}, "body": "四葉ぐみぃさんの素敵なイラストを拝見し、依頼させていただきたいと思いました！\n吸い込まれるような瞳が素敵です！\n\n\n私は「ぶいぞっかん」というVtuberグループを制作しており、\nもしよろしければ所属Vtuberネルカ・オキルカのイラストを描いていただけますでしょうか？\n\n\n参考\n・3D\nhttps://hub.vroid.com/characters/2211243112788837897/models/7919891965219622511\n・ネルカ・オキルカのTwitter\nhttps://twitter.com/neruka_okiruka?s=20\n\n紫のアイメイクと左目の泣きぼくろが特徴です。\n\n構図やシチュエーションなどはおまかせします。\nディティールが多い箇所は省略していただいて構いません。\nまた、絵柄も四葉ぐみぃさんの個性が出ていると嬉しいので、自由にしていただいて大丈夫です。\n\nまた、当人のTwitterや配信サムネなどで使わせていただく可能性があるのですが、ご了承いただけますでしょうか。\nお任せのところが多くて恐縮ですが、\nもしよろしければリクエストをお受けいただけると嬉しいです。\n\nご検討のほど、よろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/137LpunaE1wFPF80k4zKHilXqacJa5lUe?usp=sharing", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@gumii42/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1414002, "client_id": 1550991, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/d0d9bf07/uploads/origins/4b949bee-6b70-4d05-90bc-1186f100ad69?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=20495f2a1d4439a57533bfc461a20595", "srcset": "https://si.imgix.net/d0d9bf07/uploads/origins/4b949bee-6b70-4d05-90bc-1186f100ad69?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=20495f2a1d4439a57533bfc461a20595, https://si.imgix.net/d0d9bf07/uploads/origins/4b949bee-6b70-4d05-90bc-1186f100ad69?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=0715cf21b201b4a260e8b3a84a03970e 2x, https://si.imgix.net/d0d9bf07/uploads/origins/4b949bee-6b70-4d05-90bc-1186f100ad69?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=900f73277d6a78ab140fcff56538c621 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/d0d9bf07/uploads/origins/4b949bee-6b70-4d05-90bc-1186f100ad69?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5a878a27fda5db4c8850afbd98fa323e", "srcset": "https://si.imgix.net/d0d9bf07/uploads/origins/4b949bee-6b70-4d05-90bc-1186f100ad69?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5a878a27fda5db4c8850afbd98fa323e, https://si.imgix.net/d0d9bf07/uploads/origins/4b949bee-6b70-4d05-90bc-1186f100ad69?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=bafc23e9d54506b0eac6fb1ae93732f5 2x, https://si.imgix.net/d0d9bf07/uploads/origins/4b949bee-6b70-4d05-90bc-1186f100ad69?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=2d2aed5f1d3993a07fbdf59adc357e41 3x"}, "body": "こんにちは。YouTubeにて配信活動をしておりますVTuberの生流湊海(いきりゅう みなみ)と申します。四葉ぐみぃ様のTwitterに投稿されていた初音ミクさんの作品を見かけ、綺麗な色でとても素敵なイラストだと思い、是非描いて欲しいと思いこの度はリクエストを送らせて頂きました。\n\n○お願いしたい内容\n2つ結びの白衣衣装の私(生流湊海)を描いて欲しいです。ポーズや構図、背景などは四葉ぐみぃ様の好きに描いていただければ幸いです。\n可能であればサムネイルに使用したいと思っており、頭は切れていないものだと嬉しいです。\nまた、資料URLにTwitterの固定ツイートにある3面図を添付させて頂きました。画質があまり良くないため瞳孔が「＋」の形に見えますが瞳の中は花の形をした瞳孔になっております！\n\n○使用用途\nTwitter、YouTubeのサムネイルに使用したく思っており、可能であれば人物のみと背景が透過されたデータも用意して貰えるととても助かります。\n\nまたぐみぃ様のTwitterに絵の進捗やリクエスト報告で完成したイラストを投稿するのは問題ありませんのでおまかせします。\n\nここまで読んでくださりありがとうございました！skebリクエストが不慣れなため失礼な点がありましたら申し訳ございません。\nご検討頂けますと幸いです。\n\nhttps://twitter.com/ikiryuminami/status/1624339515027636224?s=46&t=rdS961gYrWzHW4pxNHvl5w", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@gumii42/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1414002, "client_id": 1034095, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/b27ad0d8/uploads/origins/ed43c2b7-6711-4e97-be79-c5a59d75fde8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b513135a18a51edfec0c3a9ac5d5af0e", "srcset": "https://si.imgix.net/b27ad0d8/uploads/origins/ed43c2b7-6711-4e97-be79-c5a59d75fde8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b513135a18a51edfec0c3a9ac5d5af0e, https://si.imgix.net/b27ad0d8/uploads/origins/ed43c2b7-6711-4e97-be79-c5a59d75fde8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=06500971019937c79f116469c944cf66 2x, https://si.imgix.net/b27ad0d8/uploads/origins/ed43c2b7-6711-4e97-be79-c5a59d75fde8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=6cb0abfdc71dffaf3d1dd43d9f696086 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/b27ad0d8/uploads/origins/ed43c2b7-6711-4e97-be79-c5a59d75fde8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b0d05c3fcf0b41cf37bc1720b40c8c46", "srcset": "https://si.imgix.net/b27ad0d8/uploads/origins/ed43c2b7-6711-4e97-be79-c5a59d75fde8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b0d05c3fcf0b41cf37bc1720b40c8c46, https://si.imgix.net/b27ad0d8/uploads/origins/ed43c2b7-6711-4e97-be79-c5a59d75fde8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=7603edce7c3d5798ab07d9ae5fc60068 2x, https://si.imgix.net/b27ad0d8/uploads/origins/ed43c2b7-6711-4e97-be79-c5a59d75fde8?bg=%23fff&aut