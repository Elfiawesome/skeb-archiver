別テーマの案もございますので、そちらをご使用いただくか、先生のお好きなように新しくデザインしていただけますと嬉しいです。\n\n衣装や髪型（エクステの追加・長さ変更など）については、作家様のお好みに合わせて自由に変更・簡略化していただいて大丈夫です。全体の構図や演出もお任せいたします。\n\n内容不備や金額が不足している場合は、アピールをお送りください。デザインメモ、没ラフや下描きなどがあればPSDに残したままにしていただけると嬉しいです。\n\n長いお願いをお読みいただき、またご検討いただきありがとうございます！\n\nhttps://drive.google.com/drive/folders/1_7wTl6FJONAFtQdBVHH4NZrUZuTNs3xx?usp=sharing", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Kamome_umsakana/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3965253, "client_id": 2203238, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/19323c1a/uploads/origins/8e890903-dec1-426e-b9ec-161dbdde2226?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=08c5cf3f111a6321e53576454dd0e312", "srcset": "https://si.imgix.net/19323c1a/uploads/origins/8e890903-dec1-426e-b9ec-161dbdde2226?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=08c5cf3f111a6321e53576454dd0e312, https://si.imgix.net/19323c1a/uploads/origins/8e890903-dec1-426e-b9ec-161dbdde2226?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=6319678ddc8e39145adf198ad430203e 2x, https://si.imgix.net/19323c1a/uploads/origins/8e890903-dec1-426e-b9ec-161dbdde2226?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c1567f34e39791e5f4e8a8e6a0be054c 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/19323c1a/uploads/origins/8e890903-dec1-426e-b9ec-161dbdde2226?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=873ed87040304bb4b78936839c76986b", "srcset": "https://si.imgix.net/19323c1a/uploads/origins/8e890903-dec1-426e-b9ec-161dbdde2226?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=873ed87040304bb4b78936839c76986b, https://si.imgix.net/19323c1a/uploads/origi