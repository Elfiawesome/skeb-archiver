d_thumbnail_image_urls": {"src": "https://si.imgix.net/db015220/uploads/origins/0c64bd2f-f0c1-4bff-8638-bf2fb779fb47?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=fd9b3a2baaed1f6438eda855e23e0d11", "srcset": "https://si.imgix.net/db015220/uploads/origins/0c64bd2f-f0c1-4bff-8638-bf2fb779fb47?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=fd9b3a2baaed1f6438eda855e23e0d11, https://si.imgix.net/db015220/uploads/origins/0c64bd2f-f0c1-4bff-8638-bf2fb779fb47?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=2347bd85af5d93290b57ad09d122b2c5 2x, https://si.imgix.net/db015220/uploads/origins/0c64bd2f-f0c1-4bff-8638-bf2fb779fb47?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=da7219efe38dae98e7da117f90009c83 3x"}, "body": "Hello, Kamome-sensei! I was hoping you could draw my OC! Your art is so beautiful and cute, and I love your pieces are so moody and atmospheric! I would be so happy if you could draw my character! Her name is Jade, she's 8 years old and she's a strange but sweet kid! She likes kiwi birds and cats, and likes to spend her time outdoors hving fun and getting dirty! Any pose or composition is fine with me, but I'd be very happy if you drew her in a cute raincoat :-)!! I apologize that my references aren't very good, and understand if you cant take my request because of that! Thank you so much for the opportunity(^^♪!\n\nhttps://drive.google.com/drive/folders/1vKuBsOFW2JH3vZFzEEoz_vdWPtfWiYTi", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Kamome_umsakana/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3965253, "client_id": 3874100, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/310af26b/uploads/origins/7446d073-6ce4-4c24-bc6c-e4cf730fc883?bg=%23fff&auto=format%2Ccompress&f