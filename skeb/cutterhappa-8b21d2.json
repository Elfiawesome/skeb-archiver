200&h=200&blur=200&s=ef5835f7141131531a42abdf34654797", "srcset": "https://si.imgix.net/0a957038/uploads/origins/f08dde2f-246c-431b-ae93-0b2ce6c157b5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ef5835f7141131531a42abdf34654797, https://si.imgix.net/0a957038/uploads/origins/f08dde2f-246c-431b-ae93-0b2ce6c157b5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=5078081a2ccae90991c31b58dcff403a 2x, https://si.imgix.net/0a957038/uploads/origins/f08dde2f-246c-431b-ae93-0b2ce6c157b5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=fa3abac56b803a97d31f119debe3669c 3x"}, "body": "先生、こんにちは。ワンピースのドレスローザ編に登場するヴィオラがウェディングドレスを着ているファンアートを描いていただけたら嬉しいです。先生の創造性を存分に発揮してください。美しく幸せそうに見えればそれで構いません。", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@cutterhappa/works/9", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3340877, "client_id": 3971766, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/24c03f0f/uploads/origins/dd05b4d6-0e5c-4ba7-83fe-53a141ca26c6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1c15218e2c8204eb1725fc9269e48580", "srcset": "https://si.imgix.net/24c03f0f/uploads/origins/dd05b4d6-0e5c-4ba7-83fe-53a141ca26c6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1c15218e2c8204eb1725fc9269e48580, https://si.imgix.net/24c03f0f/uploads/origins/dd05b4d6-0e5c-4ba7-83fe-53a141ca26c6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=eb7fcf2dc245fca641d7b54f03095536 2x, https://si.imgix.net/24c03f0f/uploads/origins/dd05b4d6-0e5c-4ba7-83fe-53a141ca26c6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ff6624372db737761ecd25f8c38a93b2 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/24c03f0f/uploads/origins/dd05b4d6-0e5c-4ba7-83fe-53a141ca26c6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d8269f1544cb1fd0229b48a2bc385757", "srcset": "https://si.imgix.net/24c03f0f/uploads/origins/dd05b4d6-0e5c-4ba7-83fe-53a141ca26c6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d8269f1544cb1fd0229b48a2bc385757, https://si.imgix.net/24c03f0f/uploads/origins/dd05b4d6-0e5c-4ba7-83fe-53a141ca26c6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=403df951744789c50aaab43bb42538c6 2x, https://si.imgix.net/24c03f0f/uploads/origins/dd05b4d6-0e5c-4ba7-83fe-53a141ca26c6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=f3c3c23b46b78fc67f66ac30fd42980a 3x"}, "body": "こんにちは！私のオリジナルキャラクター「アタン」を描いていただけませんか？キュートでセクシーなポーズで描いてください！\n重要なポイント：ギャル風、日焼けした肌、光輪、そして白い悪魔のしっぽ。\n\n幸せそうで甘い表情にしてほしいです。\n衣装は『ゼロスーツサムス』のコスチュームにしてください。こんな感じのものです：https://skeb.jp/@cutterhappa/works/8\nその作品で描かれた絵が本当に大好きなんです。官能的なプロポーションと、甘い表情や明るい背景とのコントラストが素晴らしいです。 私のキャラクターも、大人っぽく豊満な体つきという点でかなり似ています。ですから、あのように背が高く、曲線美があり、適切な場所にボリュームのある姿にしていただきたいです。\n可能であれば、乳首やアソコの輪郭がもっとはっきり見える別バージョンも描いていただけると嬉しいです。 \n\nAtan: https://drive.google.com/drive/folders/1-mdLk165SohKEhFZMrI4BbGh3ru81om8\n\n彼女を気に入っていただき、描くのを楽しんでいただければ幸いです。ありがとうございます！", "nc": 160, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@cutterhappa/works/8", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3340877, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/1a5a2b8b/uploads/origins/6f199e70-690d-4e02-b639-2724d3e493a4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d78cd25362bb5c16f7ee1fc194761b7f", "srcset": "https://si.imgix.net/1a5a2b8b/uploads/origins/6f199e70-690d-4e02-b639-2724d3e493a4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d78cd25362bb5c16f7ee1fc194761b7f, https://si.imgix.net/1a5a2b8b/uploads/origins/6f199e70-690d-4e02-b639-2724d3e493a4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e0577f82c5e5d28737a240111c43d7f0 2x, https://si.imgix.net/1a5a2b8b/uploads/origins/6f199e70-690d-4e02-b639-2724d3e493a4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=8c20b1470aea19083b1f57f6c2b5c871 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/1a5a2b8b/uploads/origins/6f199e70-690d-4e02-b639-2724d3e493a4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=223279008659cb0730a6abaaa66b9202", "srcset": "https://si.imgix.net/1a5a2b8b/uploads/origins/6f199e70-690d-4e02-b639-2724d3e493a4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=223279008659cb0730a6abaaa66b9202, https://si.imgix.net/1a5a2b8b/uploads/origins/6f199e70-690d-4e02-b639-2724d3e493a4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=cfab7d7ce4fbf086be6890264d1c6a27 2x, https://si.imgix.net/1a5a2b8b/uploads/origins/6f199e70-690d-4e02-b639-2724d3e493a4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=a47ec93ed3ad7240bd2a4b08480f6b6b 3x"}, "body": "こんにちは。前々から描いてもらいたいものがあったため、依頼させていただきます。\n\n今回依頼するのは知らない作品だとは思いますがイナズマイレブンgoという作品に出てくる黄名子のイラストで、\n衣装はゼロスーツサムスというキャラの衣装でお願いします。 \n (一応、今回依頼するキャラは女性キャラクターであることはふまえて描いていただきたいです。)\n(黄名子に関してですが、補足としてですが子供の姿と大人の姿の2通りの姿があるキャラなので、今回は黄名子　資料と書いてある画像の方の大人の姿でお願いします。)\n\nまた、自分が大人っぽいキャラが好きなので、頭身と胸の大きさは参考資料として載せたようになるべく高めの頭身であることと胸のサイズも大きめにしていただきたいです。\nまた、衣装を着せた際に胸の谷間は見えないような形にしていただきたいです。\n\n 後、補足ですが、髪型などに関しては元のキャラのイメージが崩れるため、手を加えず資料の通りでお願いします。また、衣装に関しても色変えやアレンジはせずに資料通りの色と衣装にして着せてください。\nまた、口元は隠れないようにしてください。\n\n構図に関してですが、\n顔や体が横向きにならないように、正面か斜めになるようにしてもらえると幸いです。\n資料　URL\nhttps://drive.google.com/drive/folders/1kNbA_30rR3PM0b5-cz2XM2UTIEb8036n?usp=sharing", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@cutterhappa/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3340877, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/4129e5f7/uploads/origins/e52252eb-919c-4577-8873-b76aa9a50cd9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1e469b139019ac7fc64474536b9512ab", "srcset": "https://si.imgix.net/4129e5f7/uploads/origins/e52252eb-919c-4577-8873-b76aa9a50cd9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1e469b139019ac7fc64474536b9512ab, https://si.imgix.net/4129e5f7/uploads/origins/e52252eb-919c-4577-8873-b76aa9a50cd9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=01b04dd8b1a8cbe473a70f66ae45cf89 2x, https://si.imgix.net/4129e5f7/uploads/origins/e52252eb-919c-4577-8873-b76aa9a50cd9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=27a20cf44808f98f12d116e85b394aff 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/4129e5f7/uploads/origins/e52252eb-919c-4577-8873-b76aa9a50cd9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c6a08bfe8d1825912889283e0034ec2d", "srcset": "https://si.imgix.net/4129e5f7/uploads/origins/e52252eb-919c-4577-8873-b76aa9a50cd9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c6a08bfe8d1825912889283e0034ec2d, https://si.imgix.net/4129e5f7/uploads/origins/e52252eb-919c-4577-8873-b76aa9a50cd9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=aa0fd0e56b08d267a266887edf96aac0 2x, https://si.imgix.net/4129e5f7/uploads/origins/e52252eb-919c-4577-8873-b76aa9a50cd9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=147d4d69ee311abdffd62b5b40b84289 3x"}, "body": "こんにちは！『ONE PIECE』のヴィオラを描いていただけると嬉しいです。最初に登場した時の、いつもの水玉模様のフラメンコドレスを着た姿で描いてください。両手を空中に掲げて、色気のあるポーズをとっている様子にしてほしいです。こんなポーズに近い感じで：https://files.catbox.moe/xptrpy.jpg \n\nまた、口にバラを咥えながら、ニヤリと笑い、見る人に向かってウインクしている姿も描いていただけると嬉しいです。\n\n念のため、ヴィオラの参考画像をいくつか添付します：\nhttps://files.catbox.moe/jel087.png\nhttps://files.catbox.moe/el8i11.jpg\nhttps://files.catbox.moe/wme28g.jpg", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@cutterhappa/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3340877, "client_id": 2744230, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/d9441377/uploads/origins/f3af7ed9-839e-4d68-8196-7c7ef86064b2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d08c01bcc59ca0cb193c78397abdd2e3", "srcset": "https://si.imgix.net/d9441377/uploads/origins/f3af7ed9-839e-4d68-8196-7c7ef86064b2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d08c01bcc59ca0cb193c78397abdd2e3, https://si.imgix.net/d9441377/uploads/origins/f3af7ed9-839e-4d68-8196-7c7ef86064b2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=3929747fb27d427417e6180033deb2b3 2x, https://si.imgix.net/d9441377/uploads/origins/f3af7ed9-839e-4d68-8196-7c7ef86064b2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=842c0523a4fabc4b695c7f1a5250a4b3 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/d9441377/uploads/origins/f3af7ed9-839e-4d68-8196-7c7ef86064b2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f04d248ed33c1ca4905766b52fadbbc0", "srcset": "https://si.imgix.net/d9441377/uploads/origins/f3af7ed9-839e-4d68-8196-7c7ef86064b2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f04d248ed33c1ca4905766b52fadbbc0, http