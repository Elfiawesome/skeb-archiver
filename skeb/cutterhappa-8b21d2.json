ラストになってしまった気がします。どうすれば安っぽさが抜けるでしょうか。また、右上辺りを光源にして影を入れたつもりですが、影をどこに置いて良いのかわからず大分悩んでしまいました。かつたさんであればどこに影を入れるかぜひ教えていただきたいです。\n人体の模写なども始めましたが依然首から下には自信がなく、どこかおかしい所ありましたらその点の修正もお願いしたいです。\nよろしくお願いします。\n\nhttps://drive.google.com/file/d/1AWsH-SsgJY7PhLwkEQAVCg0QUbFM2mhB/view?usp=drivesdk", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@cutterhappa/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "correction", "tipped": false, "creator_id": 3340877, "client_id": 3347407, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/8a004605/uploads/origins/baa0b82a-6f62-4027-8956-f0e0f5e9e091?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8db1eade2fec6adbc91c46fdac09b140", "srcset": "https://si.imgix.net/8a004605/uploads/origins/baa0b82a-6f62-4027-8956-f0e0f5e9e091?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8db1eade2fec6adbc91c46fdac09b140, https://si.imgix.net/8a004605/uploads/origins/baa0b82a-6f62-4027-8956-f0e0f5e9e091?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=47d7666706568ef5e5187b817f8a32ba 2x, https://si.imgix.net/8a004605/uploads/origins/baa0b82a-6f62-4027-8956-f0e0f5e9e091?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a0322f5e1f362c93c4d91b5e54b15457 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/8a004605/uploads/origins/baa0b82a-6f62-4027-8956-f0e0f5e9e091?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=8dbc8dfbb0a046a6236d768d150e8266", "srcset": "https://si.imgix.net/8a004605/uploads/origins/baa0b82a-6f62-4027-8956-f0e0f5e9e091?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=8dbc8dfbb0a046a6236d768d150e8266, https://si.imgix.net/8a004605/uploads/origins/baa0b82a-6f62-4027-8956-f0e0f5e9e091?bg=%23fff&auto=format