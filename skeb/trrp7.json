さい。(三面図はリンク先の下の方にあります)\n一般人Vtuber、イメージカラーは紅鶸色、一見ミステリアスでクールなイメージ、敬語キャラ、実はヤンデレ、配信ではよく笑いよく喋るというのが六原小森の概要になります。\n\n用途としまして、SNSや収益化済みのYouTubeのサムネイル、配信、動画、メンバー限定配布の壁紙に使用予定です。  \n不可の用途があれば、別レイヤーに記載いただければ幸いです。\n\n内容はおまかせします。\nヤンデレっぽい雰囲気のものだと嬉しいですが、可能であればで大丈夫です。\n服や髪型なども、資料にあるものどちらでも大丈夫です。あるいは自由にデザインしていただいても構いません。\nただし三角形の髪飾り（△▽）はつけていただけると幸いです。\n\n構図・背景などもおまかせします。可能であれば頭や髪の先が切れずに入っているととてもありがたいです。 \n\n また、背景や差分が別レイヤーになったpsdデータでいただけると大変嬉しいです。\n\n  ご検討いただけますでしょうか。何卒よろしくお願いいたします。\n\nhttps://lit.link/666haraK", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@trrp7/works/19", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/dd5048c1/uploads/origins/febe408f-fdc5-4c5a-8a0e-dea72154f026?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=c17abbb625b1de3e6bac4c3a1a438ad8", "src_set": ""}, "private": true, "genre": "art", "tipped": true, "creator_id": 543029, "client_id": 0, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 161, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@trrp7/works/18", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 543029, "client_id": 3424742, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/30040983/uploads/origins/14e5cb73-fb95-4617-b0ee-ff84ecfedb6e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fc19de5730b0470bc1a74e1a17179722", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/30040983/uploads/origins/14e5cb73-fb95-4617-b0ee-ff84ecfedb6e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=1552a2e66f49d4f3f7974ed396e94e03", "sr