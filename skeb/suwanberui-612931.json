9a4-95cb-87d1e1190a6d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=0b3f164b573c8421c95988f0f9701312 2x, https://si.imgix.net/2d0b863c/uploads/origins/daae5656-7fa5-49a4-95cb-87d1e1190a6d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=3beeddf978e5e3ee76898d47dcd13bec 3x"}, "duration": null, "nsfw": true, "hardcore": true, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/2d0b863c/uploads/origins/daae5656-7fa5-49a4-95cb-87d1e1190a6d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9b75d2bb9d29888e2ff86bc0d310f9e6", "srcset": "https://si.imgix.net/2d0b863c/uploads/origins/daae5656-7fa5-49a4-95cb-87d1e1190a6d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9b75d2bb9d29888e2ff86bc0d310f9e6, https://si.imgix.net/2d0b863c/uploads/origins/daae5656-7fa5-49a4-95cb-87d1e1190a6d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=5a8bc18e32aaf9bb2d633e30e95c62a1 2x, https://si.imgix.net/2d0b863c/uploads/origins/daae5656-7fa5-49a4-95cb-87d1e1190a6d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=bfd70467f179ed9349089fcff3ea52b7 3x"}, "body": "はじめまして\n\n「超昂閃忍ハルカ」より鷹守ハルカのイラストをお願いします\n\nシチュエーション\n・モブ男たちによる恥辱野外散歩\n\n・衣装はこちらのレオタード姿（資料：https://eftg.gamerch.com/%E3%83%8F%E3%83%AB%E3%82%AB%20%E3%83%AC%E3%82%AA%E3%82%BF%E3%83%BC%E3%83%89）\n\n・肩紐を下げておっぱいを露出している（参考：http://img.oppai-paipai.com/post_img/366/b/04.jpg）\n\n・手は後ろ手に縛られている\n\n・アングルは正面からの構図\n\n・マンコからはたくさんのローターがぶら下がっており，アナルにはアナルフックが挿入されている\n\n・アナルフックにひもが付けられ、散歩を強制させられている感を出してほしいです（指定構図的にフック自体は見えなくても問題ないです。あくまでその辺りにリードをつけられていることが分かればと思います…）\n\n・表情は顔を真っ赤にして恥ずかしがっている\n\n・目，口，眉を未統合にしていただき以下の状態を入れていただきたいです\n目：通常開き，目閉じ，大きく見開き\n眉：通常，ハの字眉\n口：通常開き，キュッと口を閉じ，大きく開き\n\n・お値段的に可能でしたら、取り外し可能な目隠し，ギャグボール差分を入れていただけますと嬉しいです\n\nたくさんの注文になってしまいますが、ご検討いただければ嬉しいです", "nc": 186, "word_count": 0, "transcoder": "image", "creator_acceptable_sam