c36def5b3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=4e3071d5606d9218245b841172ec5449, https://si.imgix.net/8c7df5b6/uploads/origins/8d8eb140-3f3b-423c-912a-fd0c36def5b3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=7dfbd2f24244e9a45df8f11d9f69c70a 2x, https://si.imgix.net/8c7df5b6/uploads/origins/8d8eb140-3f3b-423c-912a-fd0c36def5b3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=5ef7ba33144aac0062ee05be7f81c46b 3x"}, "body": "こんにちは、サブカカ、\n\nあなたの作品を拝見し、そのアートスタイルを楽しんでいます。\n\n私の友人のために絵をお願いしたいのですが。彼のキャラクターであるカズは、このバージョンではキャットボーイです。\n\n性格についてはあまり情報がありません。どちらかというと悪役的なキャラクターで、心の奥底では悪知恵を働かせているアイドルです。\n音楽と自然、そして甘いコーヒーが大好き。\n鮮やかな色の服を着ているが、コスチュームを着せるかどうかはあなた次第だ。\n\nハロウィンのような設定で見てみたいが、ポーズや詳細はお任せしたい。\nムーディーな森の図書館に住んでいて、ひどい睡眠不足。\n\n私のキャラクターではないので、公開されているリファレンスにしかアクセスできないため、悲しいことにほとんどリファレンスを提供できません。\n\nよろしくお願いします。\n\nhttps://hidrive.ionos.com/share/5skpx1assu", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@v1x1w/works/17", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2923150, "client_id": 472094, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/d75f6301/uploads/origins/feb0f2d1-dc8d-4030-8c18-0b53f9c19a0e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=efc5ee8c7fdfdecffc4d947a9916c1b9", "srcset": "https://si.imgix.net/d75f6301/uploads/origins/feb0f2d1-dc8d-4030-8c18-0b53f9c19a0e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=efc5ee8c7fdfdecffc4d947a9916c1b9, https://si.imgix.net/d75f6301/uploads/origins/feb0f2d1-dc8d-4030-8c18-0b53f9c19a0e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=693fb5fde536ac625a6cb2462413748e 2x, https://si.imgix.net/d75f6301/uploads/origins/feb0f2d1-dc8d-4030-8c18-0b53f9c19a0e?bg=%23fff&auto=format%2Ccompress&fm=webp&dp