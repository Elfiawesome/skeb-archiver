/1FrQLoKvoMpT7TvHqk5mpxvh81Op1DudU/view?usp=sharing\n\n凛の友達です。カタツムリと丸いやつ（カービィみたい）がお気に入り。\nhttps://drive.google.com/file/d/1-zjcG6OtyqafZvsbokpZo9O9Z23JibrF/view?usp=sharing\n\n設定やポーズは自由に描いてください。\n\nこのアートはソーシャルメディア（Youtube、X/Twitter）で使いたいと思います。\nありがとうございました！\n\nhttps://drive.google.com/drive/folders/1pVR-4mZuJ6eV7MkX2ShmlKdYza2KFZ7c?usp=sharing", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@v1x1w/works/14", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2923150, "client_id": 3057298, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/359004ec/uploads/origins/4f74ce14-6d89-4eb9-9cfc-21a71538f888?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=68a141af59df036d02ab8aef9c0f06b0", "srcset": "https://si.imgix.net/359004ec/uploads/origins/4f74ce14-6d89-4eb9-9cfc-21a71538f888?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=68a141af59df036d02ab8aef9c0f06b0, https://si.imgix.net/359004ec/uploads/origins/4f74ce14-6d89-4eb9-9cfc-21a71538f888?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=7d8b5a34195bf96fa3e3dcea3d9d14ce 2x, https://si.imgix.net/359004ec/uploads/origins/4f74ce14-6d89-4eb9-9cfc-21a71538f888?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=25ba793849db8de431e46fd124953110 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/359004ec/uploads/origins/4f74ce14-6d89-4eb9-9cfc-21a71538f888?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3ddf0de7c2361bb1bb17f1d8afca6143", "srcset": "https://si.imgix.net/359004ec/uploads/origins/4f74ce14-6d89-4eb9-9cfc-21a71538f888?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3ddf0de7c2361bb1bb17f1d8afca6143, https://si.imgix.net/359004ec/uploads/origins/4f74c