sfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/59ca7022/uploads/origins/b6fd5fd1-946e-40fd-b049-7a6e29a7d5d4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=cf6eeb700dfe56de1f493722e860fc67", "srcset": "https://si.imgix.net/59ca7022/uploads/origins/b6fd5fd1-946e-40fd-b049-7a6e29a7d5d4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=cf6eeb700dfe56de1f493722e860fc67, https://si.imgix.net/59ca7022/uploads/origins/b6fd5fd1-946e-40fd-b049-7a6e29a7d5d4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=5b2994f0d75e166e3f962af1848d71b2 2x, https://si.imgix.net/59ca7022/uploads/origins/b6fd5fd1-946e-40fd-b049-7a6e29a7d5d4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=78e9d7d1d8336314e94bc6fcb07212e1 3x"}, "body": "またまた、こんにちは、すやすやび、\n\n秋に飼っていた猫が亡くなりました。人懐っこくて賢い子だったので、とても寂しいです。\n\n長毛の黒猫で、目は緑、胸に小さな白い斑点がありました。\n\n雲の中で穏やかに座っている彼を描いていただけませんか？秋に亡くなったので、秋の要素も加えて。\n\n雲から生えた秋の木の下で、秋の葉が風に乗って舞い、星空や夕焼けの雰囲気の中で座っているかもしれない。\n\n私が想像しているものと似たような背景の参考資料と、亡くなった猫の画像を載せておきます。\n\nデスクトップの背景として使いたいので、3200x1800など、16:9の横長比率にしていただけるとありがたいです。\n\nご検討のほど、よろしくお願いいたします！\n\nhttps://drive.google.com/drive/folders/1bnu8TqnusihCLYoMA3AdzWQnxjZ1yUAM?usp=drive_link", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@v1x1w/works/12", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2923150, "client_id": 1136144, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/95d212d5/uploads/origins/6dd4ae23-51a8-40e5-967f-82eec1483fdb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8c66dfc83561ff1d1af56f66fa87942a", "srcset": "https://si.imgix.net/95d212d5/uploads/origins/6dd4ae23-51a8-40e5-967f-82eec1483fdb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8c66