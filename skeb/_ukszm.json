/uploads/origins/1d784813-584a-4b16-8dac-60f0eccabca0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ef36d2010943fd2c6adbe9cc0e6386a1", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/37079e9c/uploads/origins/1d784813-584a-4b16-8dac-60f0eccabca0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=7a83983f4aa390c3d5950b4e0c35e588", "src_set": ""}, "body": "ukishizumi先生、はじめまして。\n\n個人vtuberとして活動している惑世いと(@wakuse_ito)さんのイラストを描いていただきたくリクエストさせていただきました。\n\n惑世いとさんはskeb等でのイラストのご依頼を許可しております。(https://lit.link/en/wakuseito)\n\n・依頼内容\n構図や表情等は全てお任せいたします。\n\n・使用用途\n惑世いとさんのYouTubeのサムネイル、ツイッターへの掲載等vtuber活動全般での使用\n\n・備考\n可能でしたら納品の際に人物、宛名等のレイヤー分けをしたPSDデータでお願いいたします。\n\nよろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/1yJVa2AI1p7em7Hzg9OFuwzwE7x-f_DgF?usp=drive_link", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@_ukszm/works/170", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/73a2e6a3/uploads/origins/39d12bc8-28d3-4aa0-b965-d565ea6df3d4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=515481e83524ff0a03153859d163e9b7", "src_set": ""}, "private": true, "genre": "art", "tipped": true, "creator_id": 696701, "client_id": 999178, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 1, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@_ukszm/works/169", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 696701, "client_id": 2391402, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/46fcd998/uploads/origins/e50b5cee-c289-4104-87f9-6e62c576d14e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1b8709ef34061c2678e547564c4f1671", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/46fcd998/uploads/origins/e50b5cee-c289-4104-87f9-6e62c576d14e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=00884a5178a5f162545534927acbec48", "src_set": ""}, "body": "初めてご依頼させていただきます。\nホロライブデバイス所属の一条莉々華ちゃんのイラストをukishizumi先生に描いていただきたいです。\nukishizumi先生のイラストを拝見させていただいて素敵なイラストだったのでよろしければと思いリクエストさせていただきました！\n\nお部屋でゲームして楽しそうな様子の莉々華ちゃんを書いてもらうことはよろしいでしょうか。\n\nまたイラストを描いていただいた際にはFAタグでご本人様にお渡ししたいと思っています。その際、配信素材として使用される場合がありますのでご了承いただければと思います。そのため背景透過のPSDデータもいただけると嬉しいです。そのほか個人的に先生に描いていただけたらアクスタにして自分のコレクションケースに飾ったりしたいなと思っています。\n\nukishizumi先生にぜひ莉々華さんを描いていただければと思うのでお願いいたします。\n\nいろいろとご要望して申し訳ないのですが、ご検討いただけると幸いです。長文失礼いたしました。\n\n下のリンクは一条莉々華さんの三面図と配信で使用しているお部屋の画像図になります。\n\nhttps://pbs.twimg.com/media/F5osLW3agAADwpd?format=jpg&name=large\n\nhttps://pbs.twimg.com/media/GIOVzqfbQAA8foQ?format=jpg&name=medium", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@_ukszm/works/168", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 696701, "client_id": 2705819, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/6ce9edb6/uploads/origins/f2789ce9-4d6f-4780-9ea8-78af0e3dfb18?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5ceb21eaa0902100f2da79fc9b08e852", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/6ce9edb6/uploads/origins/f2789ce9-4d6f-4780-9ea8-78af0e3dfb18?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a93b2de90367753df784b20f7e0b68f4", "src_set": ""}, "body": "ukishizumi様のイラストがとっても可愛くて好みだったので最推しであるVarium１期生の七瀬えるちゃんを描いて欲しくてリクエストしました！\n\n【リクエスト内容】\n10/26が七瀬えるちゃんの活動2周年記念日なのでその日をお祝いしたいです。\n季節が秋なのでえち可愛い秋服コーデをリクエストしてみたいです。\n頭の上にある特徴的な天使のわっかもお願いします。\n\n\n\n【参考資料】\nhttps://varium.jp/talent/eru/\n\n【使用用途】\n\nご本人様の配信活動（配信内や、配信のサムネ、Twitter等で使用する可能性があります）での使用許諾を頂きたいです。\n\n透過のデータも含めて納品いただけますと大変助かります。", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@_ukszm/works/167", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 696701, "client_id": 203749, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/9684892c/uploads/origins/afaee9a9-7b16-4741-91a6-ffc5a67e3654?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7748b0102da3acf4276ca7a41e35e754", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/9684892c/uploads/origins/afaee9a9-7b16-4741-91a6-ffc5a67e3654?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=74592664bbb3c110a5ff4cad27d05b3d", "src_set": ""}, "body": "はじめまして。\n\nukishizumi様の描くミコッテのイラストを素晴らしく思っており、\n今回ご依頼させていただきたくご連絡いたしました。\n\n・依頼内容\nすぺしゃりて所属のVtuber ミーニャ・スコットさんのイラストをリクエストいたします。\n現在休止中ですがFPSゲーム配信をメインに活動されている方で、雨上がりをイメージしたイラストを希望したく、構図、ポーズ等はお任せいたします。\n\n・使用用途\n壁紙としての個人利用および、FAとしてプレゼントを考えており、描いていただいた報告をタグ付きツイートにて投稿いたします。\nご本人に限りSNSやサムネ等での使用承諾と使用可能なように背景透過のデータもいただけますと幸いです。\n\n・参考資料\n3面図：https://x.com/minya_scott/status/1747534187245293876\n自己紹介、ティザー動画：https://www.youtube.com/watch?v=bq42nT8fKoI\n\nご検討のほどよろしくお願いいたします。", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@_ukszm/works/166", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 696701, "client_id": 3300835, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/b7e7c4e3/uploads/origins/edb0dfea-2afd-413e-a30b-d97f91aa976f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e2b7c879cd7d2345c6b4985fb19e2968", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/b7e7c4e3/uploads/origins/edb0dfea-2afd-413e-a30b-d97f91aa976f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6bd0642fbd373e703d648a1177a50ffb", "src_set": ""}, "body": "ukishizumiさま\n\nお世話になっております。以前別垢(みしおすい)でのFA依頼で素晴らしいイラストを仕立てていただき、有難うございました。\n今回は自キャラのイラストをリクエストさせて頂ければと思います。\n\n【依頼したいもの】\nVTuber御汐かずさのイラストをお願いします。\n構図はお任せしたいと考えておりますが、「ストーリーテリング（魔導書+羽ペン）」の要素を入れていただきたいです。\n\n【用途】\n① SNSでの利用：XやBlueskyでのアイコン、ヘッダ、ポストへの添付画像での利用（他素材と合わせる等、イメージを損なわないレベルでの加工を伴います）\n② 配信や動画での利用：YouTubeならびに他配信媒体でのサムネイル画像、動画内・配信内での画像使用\n③ ファンサイトでの利用：pixivFANBOXやクリエイティアでのイラスト使用\n\n【用途に関する依頼事項】\n・キャラと背景を分けたPSDファイルや透過PNGファイルでの納品を希望します\n・サムネイルなどで利用する可能性を想定し、横方向16:9での納品を希望します\n\nお忙しいところ恐縮ですが、是非ご検討いただけますと幸いです。\nどうぞよろしくお願い致します。\n\nhttps://drive.google.com/drive/folders/1lpOsSBezbsi3JSVDDPtFuOca1SLDj5Ev?usp=drive_link", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@_ukszm/works/165", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 696701, "client_id": 1212461, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/d6abed58/uploads/origins/c7f64314-16ea-4609-a348-1383197c78be?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1c5f9a118c7a5f3206f41a3705c61ce1", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/d6abed58/uploads/origins/c7f64314-16ea-4609-a348-1383197c78be?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5b90d73b34ccb7cac0b42eefa8a37d05", "src_set": ""}, "body": "ukishizumi様\n\n初めまして、Vtuberの眞白かのんと申します。\nイラストがとても素敵だと思いリクエストを送信させて頂きます。\n\n・リクエスト内容\n眞白かのん のイラストをお願いします。\n\n資料URL\nhttps://drive.google.com/drive/folders/1Pmaz7ht4SloMsTx_AwDMS5V0OM