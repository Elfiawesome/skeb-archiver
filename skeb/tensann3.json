n「うせつ」、「ぴりから」のイラストが繋がっている1枚　\n\n背景等を描いて頂ける場合、人物、背景でレイヤー分けされたPSDファイルまたは透過データを頂けますと幸いです。\n\n要望を詰め込んでしまったので合わないと感じられましたらキャンセルしてください。\n\nよろしくお願いします。", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@tensann3/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3151286, "client_id": 1353090, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/8821e554/uploads/origins/639b881e-63f0-41c2-a858-dd72052571f5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c3395bd29410d628bb76fd853c49b7bb", "srcset": "https://si.imgix.net/8821e554/uploads/origins/639b881e-63f0-41c2-a858-dd72052571f5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c3395bd29410d628bb76fd853c49b7bb, https://si.imgix.net/8821e554/uploads/origins/639b881e-63f0-41c2-a858-dd72052571f5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=25aea44673ff7efb73ce3511855978bf 2x, https://si.imgix.net/8821e554/uploads/origins/639b881e-63f0-41c2-a858-dd72052571f5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=50b7668872dda1464bd43d37f2df32c5 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/8821e554/uploads/origins/639b881e-63f0-41c2-a858-dd72052571f5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0b99042a34eb65d2cc2cf5397cec64d1", "srcset": "https://si.imgix.net/8821e554/uploads/origins/639b881e-63f0-41c2-a858-dd72052571f5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0b99042a34eb65d2cc2cf5397cec64d1, https://si.imgix.net/8821e554/uploads/origins/639b881e-63f0-41c2-a858-dd72052571f5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=57efe84674c3a4ad7ae522b43d97bc1d 2x, https://si.imgix.net/8821e554/uploads/origi