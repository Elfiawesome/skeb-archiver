e_only_public": false, "tip_acceptable": true, "yearly_report_client_visible": false, "total_appeals_count": 83, "received_works": [{"path": "/@Ars_RG0412/works/20", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1587816, "client_id": 3567178, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/4a4c1cb0/uploads/origins/861c1a19-b1a7-428a-acf1-f77caf90d6a4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=06d05eea811b47bfcee770bfb06cc429", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/4a4c1cb0/uploads/origins/861c1a19-b1a7-428a-acf1-f77caf90d6a4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=bd8cc89b25b3b08195869f2c59f60504", "src_set": ""}, "body": "あ～す様\n\nいつもお世話になっております。\n\n今回はXのプロフィール用に\nあなたのイメージする『豚トロとろろ』を\nSDキャラっぽく書いていただきたいです。\n\n片手にキーボードを持っていて\n表情は少し怒っている感じに\nしていただけると嬉しいです。\n\nお忙しい中大変恐縮ですが\n何卒よろしくお願い致します。", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Ars_RG0412/works/19", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1587816, "client_id": 3567178, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/0a23fec7/uploads/origins/6406cd59-55af-439e-8f09-840f7be9dad8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=827b44fbbab8eb910586e8f7092c42c0", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/0a23fec7/uploads/origins/6406cd59-55af-439e-8f09-840f7be9dad8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=8a0e1de2247f9760bb3e6f15ffc5f881", "src_set": ""}, "body": "平素より大変お世話になっております。\n\nこの度は、この金額で『†無料†』で絵を描いて頂きたくリクエスト致しました。\n\nイラストの内容としましては\n\nアニメ『青春ブタ野郎はバニーガール先輩の夢を見ない』の\n映画『青春ブタ野郎はゆめみる少女の夢を見ない』の\n本編19:20～20:40頃に出てくるヒロイン+衣装で\n背景は七里ヶ浜でお願いします。\n\n表情や構図などはお任せ致します。\n\nアニメ未視聴だと思うのでアニメ見るところから始めて下さい＾ｐ＾\n\n内容が合わない場合は泣く泣くキャンセルを受けます。\n一度ご検討のほど宜しくお願い致します。\n\nhttps://animestore.docomo.ne.jp/animestore/ci_pc?workId=22406", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Ars_RG0412/works/18", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1587816, "client_id": 2706859, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/6a85f544/uploads/origins/6180c8f7-3641-48e7-8308-fbb519028095?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1808c7c8a35fba31871b3ebbc28169fa", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/6a85f544/uploads/origins/6180c8f7-3641-48e7-8308-fbb519028095?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6b87a434b2fda8defe676f3e84f01aaf", "src_set": ""}, "body": "こんにちは、ホロライブのパヴォリア・レーヌを描いていただきたいと思います。ポーズ、衣装、背景は自由です！でも、可愛くセクシーに描いていただけると嬉しいです！\n\nまた、玲音アートのハッシュタグをつけてTwitterに投稿したいと思います。その際、必ずあなたの名前をクレジットします！\n\nよろしくお願いします！\n\n参考文献\nhttps://drive.google.com/file/d/1fGKfn4AZ-7kTFWlIZNhW23qMnkBgvlXT/view?usp=sharing\nhttps://drive.google.com/drive/folders/1LTUHTG7r617efx0LzCyahWwnYZd6rb95?usp=drive_link\nhttps://drive.google.com/drive/folders/1f5jToqMrQTLsLpLN8qgEmi0Y--zsxtWa\nhttps://drive.google.com/drive/folders/1JlTA4DT7NCQWowSc3vpjEfnccsBvO3hr?usp=drive_link\n\nP.S.彼女が大きな胸を持っていることを考慮してください！", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Ars_RG0412/works/17", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1587816, "client_id": 1906551, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/b6a9d52e/uploads/origins/bfbf2b39-2ad0-418f-8331-502921ce606d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6d6165f601210f1d8075f719225442fd", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/b6a9d52e/uploads/origins/bfbf2b39-2ad0-418f-8331-502921ce606d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e1505fc1bbfaf9e06c33c731a8b81555", "src_set": ""}, "body": "Hello, I like your cute and cool style of the way you draw female characters.\nI am requesting an image of two Taekwondo girls.\n\nShion Aoyama: https://sta.sh/2fgrjkslirt\nMido Seo: https://sta.sh/2s12n4somkw\n\nThe girls will be practice fighting in a dojo.\nPose Reference: https://sta.sh/0w278uuqwqv\nShion will be on the left doing a kick while Mido will be on the right blocking Shion's kick.\nBoth girls will be in a happy and determined mood during the fight.\n\nBackground will be a martial arts dojo drawn in a simple style similar to this: https://sta.sh/0w09bbrv7va\n\nThank you for your time and I hope you enjoy drawing both of them!", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Ars_RG0412/works/16", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1587816, "client_id": 1516915, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/05907bc9/uploads/origins/cb5f5ea6-bc3e-4faf-86d4-960b990151a1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ba739adea9911ed30010f1267c847574", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/05907bc9/uploads/origins/cb5f5ea6-bc3e-4faf-86d4-960b990151a1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5f37f61f0f11a8915c61c40ebd8cc0a0", "src_set": ""}, "body": "また会ったね！\n\n前回の作品がとても気に入りました。またお願いしたいです。キャラクターは再びリトナです。\n\nhttps://skeb.jp/@Ars_RG0412/works/14\n\nシナリオは、彼女が結婚するというもので、長いベールをつけたエレガントなウエディングドレスを着ています。ドレスのデザインは、以下の画像にあるものと同じです。\n\nhttps://www.instagram.com/p/CVP-y2-vVSm/?igshid=MzRlODBiNWFlZA==\n\nポーズと表情は自由！具体的なリクエストは、ドレスとベールの長さとボリュームを強調してほしいということだけです。", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Ars_RG0412/works/15", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1587816, "client_id": 2047763, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/ecfa2703/uploads/origins/4368ce89-4e78-4ec7-a29e-b0d8e134d931?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=02b4b29d1300e0e9d00ebd04568a1cf3", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/ecfa2703/uploads/origins/4368ce89-4e78-4ec7-a29e-b0d8e134d931?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=52fabf09209dc32043bb478b195e873c", "src_set": ""}, "body": "トリニティセブンも気に入ってもらえたようで嬉しいです！\nまたミラ描いてください！https://imgur.com/a/QjU7K2p 、リヴァイ・カズマ https://imgur.com/a/lvl3jTm 。\n\n二人ともこんな感じのパーティードレスを着てほしいです！ https://imgur.com/a/kum9afA\n\n背景やポーズはお任せします！", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Ars_RG0412/works/14", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1587816, "client_id": 1516915, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/ae846ed3/uploads/origins/f70ca9c5-a0da-4d7a-9a3d-85b3fa8d91c7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b7caa89e965074e98f4c4dbc3e58101b", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/ae846ed3/uploads/origins/f70ca9c5-a0da-4d7a-9a3d-85b3fa8d91c7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200