ipped": false, "creator_id": 3347387, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/5253c859/uploads/origins/b2e50097-3453-4596-965c-6f6461122ccd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8ea14a822f4b1c65e36dc4a7cf892473", "srcset": "https://si.imgix.net/5253c859/uploads/origins/b2e50097-3453-4596-965c-6f6461122ccd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8ea14a822f4b1c65e36dc4a7cf892473, https://si.imgix.net/5253c859/uploads/origins/b2e50097-3453-4596-965c-6f6461122ccd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ba603f5d74a0b15344b17103d91e751d 2x, https://si.imgix.net/5253c859/uploads/origins/b2e50097-3453-4596-965c-6f6461122ccd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=cd9b34934a4ef29b11d1e12c908a5bcb 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/5253c859/uploads/origins/b2e50097-3453-4596-965c-6f6461122ccd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d8cb5afce8d4cbf43416d3e386c0bed7", "srcset": "https://si.imgix.net/5253c859/uploads/origins/b2e50097-3453-4596-965c-6f6461122ccd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d8cb5afce8d4cbf43416d3e386c0bed7, https://si.imgix.net/5253c859/uploads/origins/b2e50097-3453-4596-965c-6f6461122ccd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=b22808b5c831a83af15d31cd5018e3ef 2x, https://si.imgix.net/5253c859/uploads/origins/b2e50097-3453-4596-965c-6f6461122ccd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=e4a0254b7275bb46b682fdebb296293c 3x"}, "body": "古今先生、おはようございます！\n今回は新しいリクエストのために、徹夜で『孤島の鬼』の原作を読んできました。。。\n悲し。。。。悲しすぎるよ。。。。\n諸戸くん、あまりにも可哀想すぎる。。。。。。。。読んでいて胸がずっと痛かったです。。。。。\n\nせっかくのリクエストの機会なので、現実では絶対に見られないような構図をお願いしたいなあと思っています。。。\n諸戸くんには、思いきり甘やかされて、思いきり愛されていてほしい。。。。。。\nでも一方で、蓑浦くんのあの性格（特に『終灯』の蓑浦くん）を考えると、一生かかってもそんなふうに熱烈な愛情表現はしなさそうな気もして……！！\nどうお願いするのが一番いいのか、すごく悩んでいます。。。。。。\n少し考えたのですが、この蓑浦くん？さん？は、もう何十年も時を重ねた、とても余裕があって成熟した美しい大人になっているんですよね。（50歳以上……！？）\n古今先生の才能によって、『終灯』では奇跡的に年下になっているのが本当に天才だと思うので、この大人の蓑浦くん（さん？）が、余裕たっぷりに諸戸くんを翻弄して、諸戸くんだけが心をかき乱されてしまうような様子を見てみたいな……と思ってしまいました。\nそんな二人を見ることはできるのでしょうか……🥺\n猫ちゃんサインもお願いします", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@cocon_ew/works/4", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/239f9eb5/uploads/origins/b017bd7c-27be-489e-a6d4-33347f2c1380?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=653dfc0b178455999a65f4b8354c2f7b", "srcset": "https://si.imgix.net/239f9eb5/uploads/origins/b017bd7c-27be-489e-a6d4-33347f2c1380?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=653dfc0b178455999a65f4b8354c2f7b, https://si.imgix.net/239f9eb5/uploads/origins/b017bd7c-27be-489e-a6d4-33347f2c1380?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=4ce1ea12831db7b3f1e82e34bbd3918c 2x, https://si.imgix.net/239f9eb5/uploads/origins/b017bd7c-27be-489e-a6d4-33347f2c1380?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=6aa3c50de0a24567ec40298a216478a4 3x"}, "private": true, "genre": "art", "tipped": false, "creator_id": 3347387, "nc": 128}, {"path": "/@cocon_ew/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3347387, "client_id": 3112363, "vtt_url": null, "thumbnail_image_urls": {"src"