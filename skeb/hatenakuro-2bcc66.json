a74-9a74-ac81405344a6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=16d33629a3826403a89c65eb60b24be4, https://si.imgix.net/1523dcc5/uploads/origins/c24de3cd-39e0-4a74-9a74-ac81405344a6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=5d648d2505764410c9279397b5fe6025 2x, https://si.imgix.net/1523dcc5/uploads/origins/c24de3cd-39e0-4a74-9a74-ac81405344a6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=13c68437631f60ed83c4683f4269dcff 3x"}, "body": "私のOCである、エレガントな王子様のような風格を持つハンサムな女性の絵を描いてほしいです。彼女はアンドロイドのイクメンキャラクターのように見えます。できれば、仙術の修行僧の服か女神・神衣を身にまとっているのが望ましいです。色（または白黒）などは、あなたのセンスを信頼しているので、想像にお任せします！", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@hatenakuro/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 516349, "client_id": 21765, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/3969ab45/uploads/origins/94d63214-4e98-4c76-9489-d74a99a4c194?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=cc3e0ef46a02b3861e5fdff76dc094f2", "srcset": "https://si.imgix.net/3969ab45/uploads/origins/94d63214-4e98-4c76-9489-d74a99a4c194?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=cc3e0ef46a02b3861e5fdff76dc094f2, https://si.imgix.net/3969ab45/uploads/origins/94d63214-4e98-4c76-9489-d74a99a4c194?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=16e933c920705a368847bffedc0a08ca 2x, https://si.imgix.net/3969ab45/uploads/origins/94d63214-4e98-4c76-9489-d74a99a4c194?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d1ac600f8d4bf723891b457ed5c49589 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/3969ab45/uploads/origins/94d63214-4e98-4c76-9489-d74a99a4c194?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=dfc704db6c066eeefd59d06a79da9e2d", "srcset": "https://si.imgix.net/3969ab45/uploads/origins/94d63214-4e98-4c76-9489-d74a99a4c194?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=dfc704db6c066eeefd59d06a79da9e2d, https://si.imgix.net/3969ab45/uploads/origins/94d63214-4e98-4c76-9489-d74a99a4c194?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=ab06e365448449c944eb815c13a0105b 2x, https://si.imgix.net/3969ab45/uploads/origins/94d63214-4e98-4c76-9489-d74a99a4c194?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=9ff0f03e632e2e62f2f32f2c6d10d088 3x"}, "body": "こんにちは！オリジナルキャラクターをリクエストさせていただきたく、リクエストを送らせていただきました。\n概要は以下の通りです。\n・和風ファンタジー世界観の女性キャラクター\n・見た目年代20～26位の、お姉さん年代\n・衣装は和風、白基調（それ以外は全てお任せしたいです、エゾイ様のアレンジ和服が凄く好きなので…）\n・金髪青目、全般的に色素が薄い\n・髪型は、前髪あり、向かって右側のサイド部分に遊び毛あり、後ろで結っている。\n・「幸運とか良き運命を求めない人間はいないだろう」、という解釈で「運命の女神」を擬人化した「ぼくのかんがえたさいきょうのびじょ」的なキャラクターなので、可能な範囲で美女に描いていただきたいです。\n・顔・髪型・服の系統につきましては、以下参考アドレスを御確認いただければ幸いです！\nhttps://twitter.com/unteared/status/1388852623571259395/photo/1\n\n\n以下は依頼とは直接関係ございませんが、文字数に余裕があるのでご依頼までの経緯など記載させていただきます\n・「金髪美女大好き」「イケメンを得意とする方が描く美女からしか摂取できない栄養素がある」を口癖に生きています。エゾイ様を存じ上げたのは、グラブルのファンアートだったと記憶していますが、そのとき画像を遡って「金髪美女（キャサリンさん）が…おる……！！イケメン描きさんの金髪美女が…おる……！！ハレルヤ！！」というテンションになったことを覚えています。\n・その後の擬人化さんたちも皆美しく眼福だったのですが、個人的にはヘビクイワシさんを拝見したとき「エェン…美女（ではなく男性だと思いますが概念として）美女………！！！自分の美しさに自覚的で香りを『纏う』って使い方をするタイプの美女概念…！」と好みすぎて伏し拝みました。\n・フルカラーも華やかさもさることながら、、「灰色」や「線の掠れ・途切れ」でスクリーントーンのような豊かな表現をされるモノクロも、また最近の、「キーカラーを定めて、それ以外は白黒や模様で画面を構成する」洗練されたスタイルも本当にお洒落だな…とおもいます…。どの時期の作風も大好きなので、どうお引き受けいただいても間違いなく幸せになれるな、と思いリクエストに踏み切った次第です。（神絵師の顔のいい女見て健康になりたい…！）\n　乱文失礼いたしました。ぜひともご検討のほど、よろしくお願いいたします。", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@hatenakuro/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false,