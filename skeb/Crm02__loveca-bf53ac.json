t/b6c75f6d/uploads/origins/b0bfdffa-7c87-435a-bcba-5f16ff572757?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=43afb3c108afe03656ee720ba23bb30d, https://si.imgix.net/b6c75f6d/uploads/origins/b0bfdffa-7c87-435a-bcba-5f16ff572757?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=8fe217355b5784aadc5ae3ed6ca144e2 2x, https://si.imgix.net/b6c75f6d/uploads/origins/b0bfdffa-7c87-435a-bcba-5f16ff572757?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=5675f9c050045f730790abb6b1099b8e 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/b6c75f6d/uploads/origins/b0bfdffa-7c87-435a-bcba-5f16ff572757?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=fed9ace76fcbc3f49a6fbf149ea43c6a", "srcset": "https://si.imgix.net/b6c75f6d/uploads/origins/b0bfdffa-7c87-435a-bcba-5f16ff572757?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=fed9ace76fcbc3f49a6fbf149ea43c6a, https://si.imgix.net/b6c75f6d/uploads/origins/b0bfdffa-7c87-435a-bcba-5f16ff572757?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=7c2b3e55dece200c50e40a48961fbb2d 2x, https://si.imgix.net/b6c75f6d/uploads/origins/b0bfdffa-7c87-435a-bcba-5f16ff572757?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=69f966ab9c0fb1088e8a12bdf6b64b30 3x"}, "body": "はじめまして、個人Vtuberラヴカ・ラピスと申します。\n\nこの度1万人企画でリスナーの好きを詰め込んだイラストを依頼する企画を行おうと思い、絵師様を探していたのですがもぬけ様のとってもかわいいロリっ子がドタイプだったの絶対依頼したいと思いリクエスト送らせていただきました…！\n\n大変指定の細かいものにはなっていますが、もぬけさまの描きやすいように多少の改変などはおすきにしていただいて大丈夫です◎\n\n～詳細～\n・服装…地雷服(白黒ベース)\n・髪型…ふわふわツインテール\n・ヘアアクセ…リボン&ヘアピン2つほど＆小さいリボンちりばめ\n・表情…さげすみのまなざし又はメスガキ顔\n・ポーズ…おまかせ\n・その他…バチバチピアス/チョーカー/ネイル/リボン付きブーツ/ばんそうこう/ハーネス\n(ポーズによって見えないものはもちろんなくて大丈夫です！)\n・ちょこっとえっちにしてほしいです…！露出など！◎\n\nでもし可能であれば差分として、しずく型のアンダーリムメガネを付け外しできると大変うれしく思います。\n\n使用用途はサムネイル、Xでのポスト、ネットプリント等収益の発生しないもので多数使用予定です。\n\n納品はPSDだと大変助かります。可能でしたらグッズ化も許可していただけると大変うれしいです、可、不可等宛名と共に書いていただければ助かります…！\n\nラヴカ・ラピス参考資料はこちらになります。\n🔗https://lit.link/egBOtagIYme17fsL8nOOxRplLng1", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "similar_creators": [{"id": 478275, "creator": true, "nsfw_acceptable": false, "acceptable": false, "name": "ヲム", "screen_name": "wo1059mu", "avatar_url": "https://pbs.twimg.com/profile_images/2006351917174472704/FjYFKJEc.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1108604701287735296/1632407011/1500x500", "appeal_receivable": true, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "art"}], "nc": 160}, {"id": 556588, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "花畑しお", "screen_name": "flower_4o", "avatar_url": "https://pbs.twimg.com/profile_images/2042927814396329984/YBFobGcC.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1274329784034537473/1722061919/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 7, "complete_expiration_days": 30, "skills": [{"genre": "voice"}], "nc": 152}, {"id": 1937987, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "ゆずのじゃむ🍊Skeb募集中", "screen_name": "yuzunobin", "avatar_url": "https://pbs.twimg.com/profile_images/2040510450299990016/GWrfQ-I3.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1509550077353754630/1775330253/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 7, "complete_expiration_days": 120, "skills": [{"genre": "video"}, {"gen