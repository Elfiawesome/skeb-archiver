p&fit=crop&crop=top&w=200&h=200&s=cf01ef2532948bafe1db6a7612d89781, https://si.imgix.net/eec2a92c/uploads/origins/7ca6c591-8db9-42bb-857e-a7bb3285e15d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f98586c952aaa6bcd90adf2b63b52b4a 2x, https://si.imgix.net/eec2a92c/uploads/origins/7ca6c591-8db9-42bb-857e-a7bb3285e15d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ac875ba736cb855d0b7d39a19a92781b 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/eec2a92c/uploads/origins/7ca6c591-8db9-42bb-857e-a7bb3285e15d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3273dec02054cf7a74e500a5fe789fd6", "srcset": "https://si.imgix.net/eec2a92c/uploads/origins/7ca6c591-8db9-42bb-857e-a7bb3285e15d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3273dec02054cf7a74e500a5fe789fd6, https://si.imgix.net/eec2a92c/uploads/origins/7ca6c591-8db9-42bb-857e-a7bb3285e15d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=c7dfaaaa4649ee00118fde6df5ab99ac 2x, https://si.imgix.net/eec2a92c/uploads/origins/7ca6c591-8db9-42bb-857e-a7bb3285e15d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=811e908931e83ff56b0d96950e05faa5 3x"}, "body": "おはようございます、桜黒かりん先生\n\n先生の画風や、美しい少年たちや足を描かれる様子が大好きで、夫と私のオリジナルキャラクターのイラストをお願いしたいです。\n\nキツネはネズミに比べてとても小さく、背の高さは2cmほどです。\n\nネズミがキツネを愛情を込めていじめる様子を描いてください。絵の焦点は、ネズミの繊細な脚と美しい足に当ててください。絵のメインテーマは「サイズ差」で、遊び心のある、からかいながらの支配感を出してください。\n\n参考画像はこちらです：\n\nhttps://www.dropbox.com/scl/fi/93ec86kdgvzsngu5uc13f/cm-jayne-1FULL.png?rlkey=8iwe6lxzka436auxx71jm2wqc&st=te2a5oi8&dl=0\n\nhttps://www.dropbox.com/scl/fi/6e77fbp8sivka61nrb3x6/footsie-77uraxxx.png?rlkey=rinpy3zzb9n072vnoqfi059u0&st=0gkvfy4t&dl=0\n\n擬人化を描くのが苦手な場合は、このように動物の耳をつけたスタイルで描いてみてください：\n\nhttps://www.dropbox.com/scl/fi/2re2fibbkemtdi7ti0qnb/ek_tera-comm1-finished.png?rlkey=y6tiynzdi5s36i5j9w7gpp32y&st=7a5lksfd&dl=0\n\nキャラクターの服装は自由です\n\nよろしくお願いします！\n\nhttps://www.dropbox.com/scl/fi/2re2fibbkemtdi7ti0qnb/ek_tera-comm1-finished.png?rlkey=y6tiynzdi5s36i5j9w7gpp32y&st=7a5lksfd&dl=0", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@sakurokarin/works/15", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3443086, "client_id": 1047706, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/86b19fb4/uploads/origins/3697b39d-08da-46e4-b211-8fbabe484375?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c7145af9b67fe4a33c1eeec600000c8b", "srcset": "https://si.imgix.net/86b19fb4/uploads/origins/3697b39d-08da-46e4-b211-8fbabe484375?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c7145af9b67fe4a33c1eeec600000c8b, https://si.imgix.net/86b19fb4/uploads/origins/3697b39d-08da-46e4-b211-8fbabe484375?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e35e54609ef56d3aae51b39c625d42a0 2x, https://si.imgix.net/86b19fb4/uploads/origins/3697b39d-08da-46e4-b211-8fbabe484375?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e45e57e69a89600c4ab008a3efaf51a5 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/86b19fb4/uploads/origins/3697b39d-08da-46e4-b211-8fbabe484375?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c6d32b9881c2b16e6777d6010b2a682e", "srcset": "https://si.imgix.net/86b19fb4/uploads/origins/3697b39d-08da-46e4-b211-8fbabe484375?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c6d32b9881c2b16e6777d6010b2a682e, https://si.imgix.net/86b19fb4/uploads/origins/3697b39d-08da-46e4-b211-8fbabe484375?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur