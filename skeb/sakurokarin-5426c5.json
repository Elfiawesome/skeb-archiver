00&s=1b35e16ab57c57c88a2a9fbea83c4ef0, https://si.imgix.net/838a5bfb/uploads/origins/000f96df-78af-400d-8205-4e01f06c06af?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=d39f1dae9af245db517ebc019875336c 2x, https://si.imgix.net/838a5bfb/uploads/origins/000f96df-78af-400d-8205-4e01f06c06af?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=9b79bbde5aae7120ab729520b4d5b710 3x"}, "body": "初めまして、X (旧Twitter）で素敵なおみ足のイラストをお見かけしリクエストいたしました。 よろしければ、うちの子のイラストをお願いできますでしょうか。   \n\n容姿  \n銀髪を太い三つ編みにした青肌少年、頭部に短い角2本  \n資料URLに参考資料格納   \n\n希望  \n白手袋とハイソックス着用でお願いいたします。 \n靴下を履いた足が好きなので足裏が見えると嬉しいです。  \n靴下のつま先は、親指とその他四指に分かれた足袋ソックス形状でお願いします。\n\nhttps://drive.google.com/drive/folders/1w4BpxdckZso7IQoCg3e3g1ew4LVv0KMs?usp=share_link", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@sakurokarin/works/13", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3443086, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/cc65f103/uploads/origins/df2fe781-5b9c-42d0-a5b7-84a1f5be9a18?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=326b256bfc38cd494fc43fd9e9d432c3", "srcset": "https://si.imgix.net/cc65f103/uploads/origins/df2fe781-5b9c-42d0-a5b7-84a1f5be9a18?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=326b256bfc38cd494fc43fd9e9d432c3, https://si.imgix.net/cc65f103/uploads/origins/df2fe781-5b9c-42d0-a5b7-84a1f5be9a18?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=65e21f49538462bd4fc5a1c0d7675ad2 2x, https://si.imgix.net/cc65f103/uploads/origins/df2fe781-5b9c-42d0-a5b7-84a1f5be9a18?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a919d0dcc51d0614f8182a06490b4705 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/cc65f103/uploads/origins/df2fe781-5b9c-42d0-a5b7-84a1f5be9a18?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=77c345e1d036d0e3d304edfca85bfb9f", "srcset": "https://si.imgix.net/cc65f103/uploads/origins/df2fe781-5b9c-42d0-a5b7-84a1f5be9a18?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=77c345e1d036d0e3d304edfca85bfb9f, https://si.imgix.net/cc65f103/uploads/origins/df2fe781-5b9c-42d0-a5b7-84a1f5be9a18?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=b85a00377fc1ca19f894c1b53f37cdb7 2x, https://si.imgix.net/cc65f103/uploads/origins/df2fe781-5b9c-42d0-a5b7-84a1f5be9a18?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=86167a8304abfbe016bc849d785f9f0e 3x"}, "body": "桜黒かりん先生、こんにちは！前回のリクエストをキャンセルしてしまい申し訳ありませんでした。先生のスタイルに合うよう、詳細を再考したかったのです。再送を許可いただきありがとうございます！男の子をこんなにも魅力的で表情豊かに描かれる先生の手腕に心から憧れています！キャラクター：ヴェスター現代を舞台にした、いたずら好きでファッションを愛する肝臓。遊び心があり可愛らしく、女性的な服装を着ることに躊躇しない。\n\n【構図】コンセプト：ファンサービス的な「舞台裏」の瞬間。少しからかうような、プライベートな一面を見せる・指を唇に当てた（シーッというポーズ）遊び心のある笑顔・長時間の配信後、スニーカーを脱いで素足を露わにする途中の様子\n・衣装：調整可。ヘアクリップとチョーカーは必須 ・詳細：耳の黒いピアス、目の下のほくろ【使用用途】 ・YouTube/Twitch ・サムネイル ・SNS（投稿、アイコン、ヘッダー）\n\n・ファイル形式 : 可能であれば 人物やサインなどがレイヤー分けされたPDF.または背景透過PNGでの納品をお願いさせていただきたいです！ ・金額などが足りない場合はお手数ですが再送頂けますと幸いです ・不備等ございましたら申し訳ありません、ご検討よろしくお願いいたします…！https://imgur.com/a/vester-gfz2K2N", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@sakurokarin/works/12", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3443086, "client_id": 1385618, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/3c18fbdb/uploads/origins/b05e8bbd-c41c-48e8-a772-31278d0b67d1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=49f7c61918e72ce9fe48d7d108ac402f", "srcset": "https://si.imgix.net/3c18fbdb/uploads/origins/b05e8bbd-c41c-48e8-a772-31278d0b67d1?bg=%23fff&au