8oh6/view?usp=sharing", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@mynkaoi/works/26", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3267504, "client_id": 1004495, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/88ac3b9d/uploads/origins/0fba9258-924d-48b3-8096-40c97cb82a34?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3718de810fffa6ff14c13a62230489da", "srcset": "https://si.imgix.net/88ac3b9d/uploads/origins/0fba9258-924d-48b3-8096-40c97cb82a34?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3718de810fffa6ff14c13a62230489da, https://si.imgix.net/88ac3b9d/uploads/origins/0fba9258-924d-48b3-8096-40c97cb82a34?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=5e051f9a5efb5b3bdb16cf3144ccf9c0 2x, https://si.imgix.net/88ac3b9d/uploads/origins/0fba9258-924d-48b3-8096-40c97cb82a34?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=29dbf591af06b4eb1c7ee65e49c59f63 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/88ac3b9d/uploads/origins/0fba9258-924d-48b3-8096-40c97cb82a34?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=44269701e94d5528ca352b47eadf0882", "srcset": "https://si.imgix.net/88ac3b9d/uploads/origins/0fba9258-924d-48b3-8096-40c97cb82a34?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=44269701e94d5528ca352b47eadf0882, https://si.imgix.net/88ac3b9d/uploads/origins/0fba9258-924d-48b3-8096-40c97cb82a34?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=92308ffe0f4830bf708f2185075f9c3e 2x, https://si.imgix.net/88ac3b9d/uploads/origins/0fba9258-924d-48b3-8096-40c97cb82a34?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=23ee4ce39ddded1b714cfd8c672035a4 3x"}, "body": "お久しぶりです。出雲モニカです！\n前回の出雲モニカのミニキャラがとても好評で僕自身もとても好みのイラストでした！\nよく以前のイラストを見ては癒されております！\n\n今回はりょくちゃゆ様のイラストをぜひボカコレに出す予定のオリジナル楽曲に用いらせていただきたかったので、新規リクエストを送らせていただきました！\n\n1月29日にりょくちゃゆ様が投稿なされているミクちゃんイラストのようなイラストを出雲モニカで描いていただきたいです。\n\n以下希望いたします。\n・表情は＜目を瞑った微笑み＞と差分で＜ニッコリ笑顔＞をお願いいたしたいです。\n・顔の片方の左目の下あたりにバーコードが欲しいです。\n・衣装は白基調のだぼだぼパーカー、ホットパンツ、あとツインテの結び部分に初音ミクのツインテについている輪っかのピンク色バージョンが欲しいです。\n・それぞれの背景透過ファイルをいただきたいです。\n・その他指定のない部分、構図等はりょくちゃゆ様にぜひお任せいたしたいです！\n\n\n使用用途は私のオリジナル曲・SNS等への使用を主とします。\n\n資料は立ち絵と使用予定の楽曲のサンプルをお送りいたしますので参考にしていただければと思います。\nぜひよろしくお願いいたします！！\n\nhttps://drive.google.com/drive/folders/1yAgR0SUW8xDZcf9zi-dz6M17cltxCecy?usp=drive_link", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@o_nekomentaru/works/23", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3226958, "client_id": 1004495, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/9eb648b4/uploads/origins/a8ec31d7-81f5-4e95-b129-759c7f3603de?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=98d19a6fb714575dde5db37cb5c68deb", "srcset": "https://si.imgix.net/9eb648b4/uploads/origins/a8ec31d7-81f5-4e95-b129-759c7f3603de?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=98d19a6fb714575dde5db37cb5c68deb, https://si.imgix.net/9eb648b4/uploads/origins/a8ec31d7-81f5-4e95-b129-759c7f3603de?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=1f44bbd1162bbc32f5054578126c4d3b 2x, https://si.imgix.net/9eb648b4/uploads/origins/a8ec31d7-81f5-4e95-b129-759c7f3603de?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=0901be8e00d275746994a70b17a829fe 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/9eb648b4/uploads/origins/a8ec31d7-81f5-4e95-b129-759c7f3603de?bg=%23fff&auto=format%2Ccompr