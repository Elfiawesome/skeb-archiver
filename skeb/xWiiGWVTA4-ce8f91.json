": true}, {"path": "/@xWiiGWVTA4/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "comic", "tipped": false, "creator_id": 3728023, "client_id": 2755750, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/9a5f4655/uploads/origins/50422f5b-6d26-491f-b99a-e1b092b65670?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=80348ca73b027a2878ee41a622f7ac8f", "srcset": "https://si.imgix.net/9a5f4655/uploads/origins/50422f5b-6d26-491f-b99a-e1b092b65670?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=80348ca73b027a2878ee41a622f7ac8f, https://si.imgix.net/9a5f4655/uploads/origins/50422f5b-6d26-491f-b99a-e1b092b65670?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=0e6637869abaae359243d15151378215 2x, https://si.imgix.net/9a5f4655/uploads/origins/50422f5b-6d26-491f-b99a-e1b092b65670?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f9d8cd7b595385ce7b976b2846368b71 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/9a5f4655/uploads/origins/50422f5b-6d26-491f-b99a-e1b092b65670?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=15d8ba0ec063bb94885d5889238e13f3", "srcset": "https://si.imgix.net/9a5f4655/uploads/origins/50422f5b-6d26-491f-b99a-e1b092b65670?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=15d8ba0ec063bb94885d5889238e13f3, https://si.imgix.net/9a5f4655/uploads/origins/50422f5b-6d26-491f-b99a-e1b092b65670?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=ac60d39b3b98af61e9db5c006d42f29f 2x, https://si.imgix.net/9a5f4655/uploads/origins/50422f5b-6d26-491f-b99a-e1b092b65670?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=d105d035c8cacea3c851ccbd4fa40454 3x"}, "body": "か さま、はじめまして。\nキャラのタッチが可愛らしく、イラストとコミックどちらの依頼にするかとても迷ったのですが\nhttps://x.com/kakaka_62/status/1805543742491050146/photo/1\nこちらのコミックがとても素敵だったため、今回はコミックにてリクエストさせていただきます！\n依頼キャラは、TRPGで遊んでいるうちよそOCです。\n\n▽関係\n自由奔放な探偵と苦労人の助手/両片想いの幼馴染\n\n▽キャラクター\n【玉木 奈胡/たまき なこ】\n・探偵\n・161cm、29歳\n・ローテンションでマイペースだが、粘り強くタフな性格\n・感性が独特で、趣味は石碑的なオブジェやゆるキャラなどの置物収集\n・事務所の経費で趣味のものを買うので鏡に叱られている（が、なんだかんだ許されている）\n・幼少期の鏡を探偵助手ごっこに巻き込んだ延長線で鏡を頼った\n・中高時代には鏡を異性として意識していた時期もあったが、関係性を壊したくなくて適度な距離感を保っている\n・鏡と恋仲になったら、関係が終わったとき幼馴染にも戻れないのではと思い恋愛に前向きでない\n・鏡にももっと自分のことを頼ってほしい\n\n【鏡 遙真/かがみ とうま】\n・助手\n・174cm、30歳\n・兼業助手。本業は弁護士\n・主に経理や契約関係を請け負っているはずが、調査にも駆り出されている\n・外面は穏やかだが、気を許している玉木相手には自然体で軽口が多い\n・自分がエリートであることを自覚していて尊大\n・他人に弱みを見せたくない。玉木には猶更\n・幼少期に家族を亡くしており、玉木家にサポートしてもらったため一家に感謝している\n・玉木が恋愛関係を望んでいなさそうであるため、自分が恋情を抱いていることに罪悪感がある\n\n▽その他\n・付き合いが長くお互い無意識的に距離が近い\n\n▽盛り込んでほしいシチュエーション\n・悪天候が原因で玉木の自宅兼事務所に泊まることになる鏡\n・雷がなるたびにびくっとなりつつ、（今日鏡いてよかった〜…）という玉木\n\n服装やその他の詳細についてはお任せしたいです。\n\nいただいたコミックは個人利用のほか、友人間でのデータ共有、\nまたオンラインでTRPGにて遊ぶ際に、一部をトリミングして装飾として利用させていただくことがございます。（イメージについては資料内に格納しています）\n\nご縁がございましたら嬉しいです！どうぞよろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/1waBe39PO-NgR5Gjqil8nu4WQ2CehD4Vg?usp=sharing", "nc": 25, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@xWiiGWVTA4/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3728023, "client_id": 2799703, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/2a7ddbb3/uploads/origins/3a0ca0ea-26f6-4b1f-b070-c073195d9921?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6cdf5f8a5b56b093a2cf417eb40ebdae", "srcset": "https://si.imgix.net/2a7ddbb3/uploads/origins/3a0ca0ea-26f6-4b1f-b070-c073195d9921?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6cdf5f8a5b56b093a2cf417eb40ebdae, https://si.imgix.net/2a7ddbb3/uploads/origins/3a0ca0ea-26f6-4b1f-b070-c073195d9921?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=31cfb8261ab6c3f54304e8a990a991d