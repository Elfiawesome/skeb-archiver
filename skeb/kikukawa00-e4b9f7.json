clr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=fbc8f0910d38bc7c6e4c63603b2de9c5 3x"}, "private": true, "genre": "art", "tipped": false, "creator_id": 2020733, "nc": 48}, {"path": "/@kikukawa00/works/8", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2020733, "client_id": 1284442, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/6f220d5d/uploads/origins/6e2cc937-3711-4491-9a26-a2ca189d0ab8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c3c6cd149105bb4d9cbf993d77f232dd", "srcset": "https://si.imgix.net/6f220d5d/uploads/origins/6e2cc937-3711-4491-9a26-a2ca189d0ab8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c3c6cd149105bb4d9cbf993d77f232dd, https://si.imgix.net/6f220d5d/uploads/origins/6e2cc937-3711-4491-9a26-a2ca189d0ab8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=8bc0530455a2b074b881a1fc3fbba3ca 2x, https://si.imgix.net/6f220d5d/uploads/origins/6e2cc937-3711-4491-9a26-a2ca189d0ab8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=4dc89161f5120e98a806a32a34242d8e 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/6f220d5d/uploads/origins/6e2cc937-3711-4491-9a26-a2ca189d0ab8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=feb1b6de107f1559fbaa4a7924330036", "srcset": "https://si.imgix.net/6f220d5d/uploads/origins/6e2cc937-3711-4491-9a26-a2ca189d0ab8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=feb1b6de107f1559fbaa4a7924330036, https://si.imgix.net/6f220d5d/uploads/origins/6e2cc937-3711-4491-9a26-a2ca189d0ab8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=dcfa91b5f2ac6f99baf3a207b3520736 2x, https://si.imgix.net/6f220d5d/uploads/origins/6e2cc937-3711-4491-9a26-a2ca189d0ab8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=07fa6ce5464f2815597578a8fbfda26d 3x"}, "body": "きくかわ先生はじめまして\npixiv等でお見かけして凌辱描写に惹かれたのでリクエストさせて頂きます\n特に大室撫子ちゃんの作品とスローループの３人が集団輪姦されている作品がとても好みです\n\n今回、「私に天使が舞い降りた！」の星野ひなたちゃんの誘拐・凌辱シチュをお願いしたいです\n\n服装は私服（アニメ６話で大学に行った時のもの）で\n新聞紙や段ボールが敷かれた散らかった部屋に連れ込まれて凌辱されている\n両手は束ねるように頭の上で拘束され\n口にはガムテープ、両ひざも拘束されてＭ時開脚の状態にされ犯されている状況\n\n上は捲られて膨らみかけの胸が露出させられている\n脱がされたパンツは片足に引っかかって残っている\n若干で構いませんので破瓜の血があると嬉しいです\n\nひなた本人は自分が何をされてしまっているのかわかっておらず\n痛みと恐怖で涙を流している\nうめき声しか出せないが必死でみゃー姉に助けを求めている\n\n犯人の男は太った中年男性のイメージですが\n描写は最低限で構いません\n\n部屋にカッターナイフやガムテープ、\nこれから使われるであろう凶悪そうな器具\n（極太バイブやアナルビーズ、浣腸、クスコなど）\nが転がっていると絶望感が増して好みです\nひなたはそれらの器具がどういうものか全くわかっておらず\nただ恐怖を増幅させるものになっているイメージ\n\n差分がOKなら\n①男性器を局部に押し当てられて挿入寸前で青ざめている差分\n※男から「これがひなたちゃんの中に入るんだよ」というような声をかけられて\n「んー！」と拒絶のうめき声を上げている\n②中出し後に局部から精子が溢れてくる差分\n※表情は放心状態で、男から「まだまだこれからだよ。おもちゃもたくさんあるから一杯遊ぼうね」というようなことを言われ\n反応を楽しむために口のガムテープを剥がされていたひなたは「や、やだ…」と力無く呟いている感じ\nどちらか片方なら①を優先でお願いします\n\nまた、断面図描写は嫌いではないのですが\nどちらかというと外から見た図の方が好きなため\n描写を入れる場合は別差分か、メイン絵に重ねない形で別カット\n（断面図部分を別のコマなどで描写）にして頂きたいです\n\n要望が多いため多めの金額で依頼させて頂いていますが\n工数にあわないものや表現が難しい、好みに合わない部分等あれば先生のご判断で省略・変更して下さい\n\n以上、ご検討をお願いします", "nc": 40, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@kikukawa00/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2020733, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/2534bae9/uploads/origins/efc88e9f-95d7-4a42-ad21-24a14e2c9dfe?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=acae5af6a926003ab182c142e4702de8", "srcset": "https://si.imgix.net/2534bae9/uploads/origins/efc88e9f-95d7-4a42-ad21-24a14e2c9dfe?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=acae5af6a926003ab182c142e4702de8, https://si.imgix.net/2534bae9/uploads/origins/efc88e9f-95d7-4a42-ad21-24a14e2c9dfe?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=20