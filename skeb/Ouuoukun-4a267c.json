スのイラストです\n\nシチュエーションは二人が仲良くしているところが見たいと思っています\n例えばなのですが、二人で買い物であったり、おしゃれしていたり、お出かけしていたり、マフラーを共有してみたりのような…(漠然とお願いされりのも困るかと思ったので例を挙げてはみましたがこれに限らずになにかあればNSFWの加減含めてッビィ様の方で決めてしまって大丈夫です！)\n\n衣装に関しては二人ともリジェネレイト後の衣装か限定衣装あたりだと嬉しいです！が、シチュエーションや描きやすさ等問題ありましたらアレンジ等自由にお任せします…！\n\n資料URLには衣装の参考とゲームの画面のキャプチャを送らせてもらっています。\n\nお忙しいところ恐縮ですが可能であれば何卒よろしくお願いいたします…！\n\nhttps://www.dropbox.com/sh/nxd7wkfwpasgj61/AAA5aBb9OdUAu7UFf8B1VbRna?dl=0", "nc": 33, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@Ouuoukun/works/3", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/b69089ca/uploads/origins/8807ac63-602f-42b1-964f-acb4a6c425d0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=dace18cc3e566c9ce08315a5875d9456", "srcset": "https://si.imgix.net/b69089ca/uploads/origins/8807ac63-602f-42b1-964f-acb4a6c425d0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=dace18cc3e566c9ce08315a5875d9456, https://si.imgix.net/b69089ca/uploads/origins/8807ac63-602f-42b1-964f-acb4a6c425d0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=cdae9592d4d321d32ae4e8148971e5e2 2x, https://si.imgix.net/b69089ca/uploads/origins/8807ac63-602f-42b1-964f-acb4a6c425d0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=af8c7d4dca4abe2fe52d2d319fb2905c 3x"}, "private": true, "genre": "art", "tipped": false, "creator_id": 221660, "client_id": 65115, "nc": 0}, {"path": "/@Ouuoukun/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 221660, "clie