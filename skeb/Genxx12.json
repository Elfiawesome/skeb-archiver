isible": false, "total_appeals_count": 0, "received_works": [{"path": "/@Genxx12/works/18", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 820311, "client_id": 3536016, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/159c88d2/uploads/origins/59481789-5f3e-43a2-92c3-fab5ae7d9c85?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=eb1b53a2f5c12bc899e06f7938c04f57", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/159c88d2/uploads/origins/59481789-5f3e-43a2-92c3-fab5ae7d9c85?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=344e9087c0f10c37b42b7b7c176558f9", "src_set": ""}, "body": "こんにちは！タイムラインであなたのイラストを果南ちゃん枚拝見しました。どれも素晴らしいと思います。ボルトのイラストをお願いしたいです。ボルトはビキニ姿の女性に変身する技を持っています。その姿で描いていただけますか？\n\nもしよろしければ、ポーズと構図は腕を伸ばした感じ（チアリーダー風)で、胸は弾んでいる状態にしていただきたいです。そのポーズが不可能な場合は、お好みに合わせて自由に変更してください。胸がエマちゃんと同じサイズだったら最高だわ. 可能であれば、ビキニを少し小さくして肌をもっと見せてください。イラストはできれば膝上くらいの長さにしてください。背景は不要です。お時間をいただき、私のリクエストを検討していただきありがとうございました！\n\nボルト:\nhttps://drive.google.com/drive/folders/1r1UjvUSx7SJkEVJwMI-GSsLl-3zA7ZRC\n\nシーン:\nhttps://youtu.be/a1DEyfqxBsM?si=mbrXpGB8FnJcLizr\n\nhttps://youtu.be/i4hPL9SB71E?si=KpiChQxIO4xQc8HA", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Genxx12/works/17", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/211a1d54/uploads/origins/ec0921a6-db8e-4f18-ac26-1e88f24f0b0d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=cfc93f781291a20970ac1abe39c218c5", "src_set": ""}, "private": true, "genre": "art", "tipped": true, "creator_id": 820311, "client_id": 2222189, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_u