om/i/32978466315.html", "nc": 49, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@ichigain880/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 105041, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/8af67954/requests/217549_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2a021e74420d350d33f3ae61aa5da9b9", "srcset": "https://si.imgix.net/8af67954/requests/217549_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2a021e74420d350d33f3ae61aa5da9b9, https://si.imgix.net/8af67954/requests/217549_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a2c166621e8538ddd919a7351e7f55f9 2x, https://si.imgix.net/8af67954/requests/217549_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=3685c64df5c253980ed2b36a63ebad0d 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/8af67954/requests/217549_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6ced82c3e8e53bc2ee5c416d181d53d2", "srcset": "https://si.imgix.net/8af67954/requests/217549_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6ced82c3e8e53bc2ee5c416d181d53d2, https://si.imgix.net/8af67954/requests/217549_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=d35feb3079ec2cee927fd8f88908b339 2x, https://si.imgix.net/8af67954/requests/217549_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=e358c877da2bbfe92d57e43393b0734a 3x"}, "body": "初めまして、いつもICHIGAINさんの作品を拝見しています。\n毎回素晴らしい絵を描いてくださり、本当にありがとうございます。\n早速ですが、今回ICHIGAINさんに是非描いて頂きたい絵がありましたのでリクエストさせて頂きます。\n\n今回はアルカナハートシリーズのペトラ・ヨハンナ・ラーゲルクヴィストをお願いします。\n構図や細かい所はお任せしますが、可能であれば太ももを太くてむちむちに、おっぱいは大きめで、パンチラもしていただけると嬉しいです。\n\nご多忙中恐れ入りますが、ご検討よろ