フでレミリアが「フランって意外とお尻が大きいわね...私も縞パン履いてみようかな..」的なセリフでレミリアのセリフの吹き出しに可能であればデフォルメの頬を赤らめている顔だけのレミリアのイラストをお願いします。ご都合が合いましたらよろしくお願いします。\n\nhttps://www.pixiv.net/artworks/101064423", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@comic_fate/works/11", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 256997, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/ddbe68dd/uploads/origins/83c5c8e2-2b85-4937-8cfe-6534f81179b8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c258b2df04f5536712227b717cf09f07", "srcset": "https://si.imgix.net/ddbe68dd/uploads/origins/83c5c8e2-2b85-4937-8cfe-6534f81179b8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c258b2df04f5536712227b717cf09f07, https://si.imgix.net/ddbe68dd/uploads/origins/83c5c8e2-2b85-4937-8cfe-6534f81179b8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ad81da59c8604445ed24e4fbcb4fd511 2x, https://si.imgix.net/ddbe68dd/uploads/origins/83c5c8e2-2b85-4937-8cfe-6534f81179b8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=9a3b914850c0452889e0b6bf82cfec89 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/ddbe68dd/uploads/origins/83c5c8e2-2b85-4937-8cfe-6534f81179b8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=632d0edadfcbf40ad80c83208f4999e0", "srcset": "https://si.imgix.net/ddbe68dd/uploads/origins/83c5c8e2-2b85-4937-8cfe-6534f81179b8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=632d0edadfcbf40ad80c83208f4999e0, https://si.imgix.net/ddbe68dd/uploads/origins/83c5c8e2-2b85-4937-8cfe-6534f81179b8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=62f0e4a278aa942665d3715aeea17199 2x, https://si.imgix.net/ddbe68dd/uploads/o