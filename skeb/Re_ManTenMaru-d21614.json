ba-4c24-9064-bb5367d194b7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ee3f22d901ffe4085114dedd9bb5c0d7", "srcset": "https://si.imgix.net/aa0bd566/uploads/origins/1cc251f3-69ba-4c24-9064-bb5367d194b7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ee3f22d901ffe4085114dedd9bb5c0d7, https://si.imgix.net/aa0bd566/uploads/origins/1cc251f3-69ba-4c24-9064-bb5367d194b7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c4dfd388cfc777cfb5781622d19e99e1 2x, https://si.imgix.net/aa0bd566/uploads/origins/1cc251f3-69ba-4c24-9064-bb5367d194b7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=0d731b39750c81fa098fabe6c28a2722 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/aa0bd566/uploads/origins/1cc251f3-69ba-4c24-9064-bb5367d194b7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b5b5760bbe63ac5c14034921a55010c3", "srcset": "https://si.imgix.net/aa0bd566/uploads/origins/1cc251f3-69ba-4c24-9064-bb5367d194b7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b5b5760bbe63ac5c14034921a55010c3, https://si.imgix.net/aa0bd566/uploads/origins/1cc251f3-69ba-4c24-9064-bb5367d194b7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=9c440885ac2df693020810ebea1d357f 2x, https://si.imgix.net/aa0bd566/uploads/origins/1cc251f3-69ba-4c24-9064-bb5367d194b7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=279b30a9a87c9c8951f995b5c52209e8 3x"}, "body": "以前はありがとうございます、今回も失礼します\n\n作品:VOICEROID\nキャラクター:結月ゆかり・弦巻マキ\nシチュエーション:\n↓の続き\nhttps://skeb.jp/@Re_ManTenMaru/works/4\n\n叔父の世話をしに叔父の家に行くようになった二人。\n泊りがけの世話から帰ってきたゆかりと、入れ替わるように出ていくマキ。マスターは負担になってないか、手伝えることがあるなら何でも言って欲しいとゆかりを労う。\nゆかりは全く苦にはなってない、むしろ自分がお世話になっているくらいだと嬉しそうに話し、全く気にする必要は無いという。マキもきっと同じだと。\n面白くないマスターは叔父の愚痴を言うとゆかりは怒り、あんな素敵な叔父を悪く言ってはいけないと庇いたてる。らしくない事を言ったと反省するマスターをよそに、ゆかりは素敵な叔父との激しいセックスを思い返しうっとりとしていた。\n\nみたいな感じでお願いします。\n出来る範囲で構いませんので良ければご検討ください。", "nc": 176, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@Re_ManTenMaru/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 111951, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/a9088eb7/uploads/origins/a6e23f7b-de58-438b-8326-f4721508313e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5462a80c18aa96c2baa572d3b295467c", "srcset": "https://si.imgix.net/a9088eb7/uploads/origins/a6e23f7b-de58-438b-8326-f4721508313e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5462a80c18aa96c2baa572d3b295467c, https://si.imgix.net/a9088eb7/uploads/origins/a6e23f7b-de58-438b-8326-f4721508313e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a6309032dd8401b40124333ed32f3b4d 2x, https://si.imgix.net/a9088eb7/uploads/origins/a6e23f7b-de58-438b-8326-f4721508313e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=1d99005fa34aa5d356959b36d9e21e76 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/a9088eb7/uploads/origins/a6e23f7b-de58-438b-8326-f4721508313e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=55b1c6610c795dfd31dbcd199fee8ba7", "srcset": "https://si.imgix.net/a9088eb7/uploads/origins/a6e23f7b-de58-438b-8326-f4721508313e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=55b1c6610c795dfd31dbcd199fee8ba7, https://si.imgix.net/a9088eb7/uploads/origins/a6e23f7b-de58-438b-8326-f4721508313e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=d65bd506b6bf970f1dbb029f8040a57e 2x, https://si.imgix.net/a9088eb7/uploads/origins/a6e23f7b-de58-438b-8326-f4721508313e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=00dec6a341bff0fb550f088883cb062f 3x"}, "body": "初めまして、他の方の依頼したイラストがツボに嵌ったので依頼させていただきます。\n\n作品:VOICEROID\nキャラクター:結月ゆかり・弦巻マキ\nシチュエーション:\n↓の続き\nhttps://skeb.jp/@Re_ManTenMaru/works/3\n\nまた叔父がやってくる日、二人に急かされ叔父が来ない内に飲み始める酒をマスター。いつもよりも二人が酒を勧めてきてペースが上がり叔父が来る頃にはすっかり酔い潰れてしまう。\nやって来た叔父にマスターは酔い潰しておいたと二人でお出迎え。待ちきれなかった、楽しみにしていたとおねだりしながらパイズリやキスでご奉仕。大きなペニスや事前に酔い潰した事を褒めるなど「意外といいところ」を見せられながら朝まで可愛がってやるという言葉に期待を隠せない二人をお願いします。\n\n他の人のシチュに乗っかっての別シチュなので受けられないと思われたならキャンセルしてください。\n良ければお願い致します。", "nc": 177, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@Re_ManTenMaru/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 111951, "client_id": 126529, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/611a38fc/uploads/origins/74750da6-3074-4e56-b5c1-a2926e5403f3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=184fbc3690db2d9759b7606bdec216df", "srcset": "https://si.imgix.net/611a38fc/uploads/origins/74750da6-3074-4e56-b5c1-a2926e5403f3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=184fbc3690db2d9759b7606bdec216df, https://si.imgix.net/611a38fc/uploads/origins/74750da6-3074-4e56-b5c1-a2926e5403f3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=9dd883b4b92194c43b148c826f91d7f5 2x, https://si.imgix.net/611a38fc/uploads/origins/74750da6-3074-4e56-b5c1-a2926e5403f3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c5e91a80b69c6319bc89f364f1903743 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/611a38fc/uploads/origins/74750da6-3074-4e56-b5c1-a2926e5403f3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=dbca6a8f378999efac0d5602b05907c8", "srcset": "https://si.imgix.net/611a38fc/uploads/origins/74750da6-3074-4e56-b5c1-a2926e5403f3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=dbca6a8f378999efac0d5602b05907c8, https://si.imgix.net/611a38fc/uploads/origins/74750da6-3074-4e56-b5c1-a2926e5403f3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=5a9462cd94bf5b1bf29e07b29c416227 2x, https://si.imgix.net/611a38fc/uploads/origins/74750da6-3074-4e56-b5c1-a2926e5403f3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=f30609b24a79620931da072c2b8cbc5d 3x"}, "body": "前回はありがとうございました。\n非常にシコリティの高い絵を描いて頂けて、とても嬉しかったです。\n今回もお時間に余裕がございましたら、リクエストの方をお願いしたく思います。\n\n作品:VOICEROID\nキャラクター:結月ゆかり・弦巻マキ\nシチュエーション:マスターと会話しているシーン。\n『毎回付き合わせてしまって申し訳ない』等の謝罪の言葉を述べるマスターに対し笑って『別に気にしてない』『結構良いところもある人みたいだし』等々返すも、事後感を漂わせる状態(着衣や髪の乱れ・顔の紅潮・汗・口元への陰毛の付着・露出部分へのキスマーク・薄布をググッと持ち上げる勃起乳首・衣服の内側で『ギュゥ～ッ』と思い出し締まりしている膣等それっぽい要素をいくつか)になっている二人をお願いいたします。\n立ち・座り等のポーズ、場所については特に指定はありません。\n\n前回描いて頂いたWフェラの相手にお手付きにされてから数回目の二人、といった感じで考えておりました。\nご一考頂ければ幸いです！", "nc": 177, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@Re_ManTenMaru/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 111951, "client_id": 126529, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/4ccdf52a/uploads/origins/c9984de6-7ecc-4351-8932-f891340b6231?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2f2e50b5c3e2f38a22284dee8e7701b5", "srcset": "https://si.imgix.net/4ccdf52a/uploads/origins/c9984de6-7ecc-4351-8932-f891340b6231?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2f2e50b5c3e2f38a22284dee8e7701b5, https://si.imgix.net/4ccdf52a/uploads/origins/c9984de6-7ecc-4351-8932-f891340b6231?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=102fe6cffc303aeefb85d45cd135fabd 2x, https://si.imgix.net/4ccdf52a/uploads/origins/c9984de6-7ecc-4351-8932-f891340b6231?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=db7ed04a2167abf5f2a5179bd969e378 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/4ccdf52a/uploads/origins/c9984de6-7ecc-4351-8932-f891340b6231?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=7c50c56df8bd89526f70953dec66a0eb", "srcset": "https://si.imgix.net/4ccdf52a/uploads/origins/c9984de6-7ecc-4351-8932-f891340b6231?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=7c50c56df8bd89526f70953dec66a0eb, https://si.imgix.net/4ccdf52a/uploads/origins/c9984de6-7ecc-4351-8932-f891340b6231?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=a4318c4a5bbe664781b185a686a45daf 2x, https://si.imgix.net/4ccdf52a/uploads/origins/c9984de6-7ecc-4351-8932-f891340b6231?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=44e1404b8758853b9d1dd9b21834b740 3x"}, "body": "お疲れ様です。前々からそちらの描かれる絵に惹かれておりましたので、今回リクエストさせて頂きたく思います。\n\n作品:VOICEROID\nキャラクター:結月ゆかり・弦巻マキ\nシチュエーション:一本のぺニスに顔を寄せ、二人してカリをベロベロ舐めさせられているシーン\nバックグラウンド:背景として、両名ともマスターとは行為経験済みで男のモノについても実物を知っている状態。同棲しイチャラブハーレム状態であったのが、マスターの親戚であるセクハラ気質の下卑た中年親父の登場で事態が一転。マスターの手前無下に断る事も出来ないまま晩酌に付き合わされた結果、泥酔させられ撮られたあられもない姿の写真をネタに行為を要求されてしまい…まずは挨拶代わりにと奉仕を強要。舌でしっかりと確かめさせられるカリ段差の高さ深さ、金玉から立ち上る雄の臭いに「マスターでは雄として太刀打ち出来ないこと」「確実に穴の形を書き換えられてしまうこと」を悟ってしまう…というのをイメージしております。(シチュの発端を～とありましたので参考までに)\n\nご検討頂ければ幸いです！", "nc": 185, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@Re_ManTenMaru/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 111951, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/5299205c/uploads/origins/5b43556f-e47a-4fb3-af0d-b9bdd65fb0c8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=349d177203c512f6