%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=0398983a6df607802605fcb1afe886e6 3x"}, "body": "資料のアダルトゲーム『夜明け前より瑠璃色な』の制服姿のフィーナが、以前描かれたアズレンサラトガのように下からの突風で豪快にパンモロしている絵をお願いします。資料ではニーソを履いていますが生足にしてください。突然のいたずらな風でびっくりして、両脚をぴったり閉じて、両目を見開いて両手を胸の前できゅっと握ってる感じでお願いします。膝のあたりまで見えるように描いてほしいです。もし差分も可能でしたら、純白のパンティの他にピンクと水色のパンティを見せてほしいです。\n\nhttp://30calclub.sakura.ne.jp/august/fiena.html", "nc": 33, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Tobikaku0121/works/8", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2566839, "client_id": 1563590, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/baa00f67/uploads/origins/924ed367-05e3-4b91-90d0-7a94d1777843?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d892b921e52709b98bf60609a5c2ab17", "srcset": "https://si.imgix.net/baa00f67/uploads/origins/924ed367-05e3-4b91-90d0-7a94d1777843?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d892b921e52709b98bf60609a5c2ab17, https://si.imgix.net/baa00f67/uploads/origins/924ed367-05e3-4b91-90d0-7a94d1777843?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=11ae75b84d25c97f792ca3b32adf5d72 2x, https://si.imgix.net/baa00f67/uploads/origins/924ed367-05e3-4b91-90d0-7a94d1777843?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=0069da4f6bb8086daa1d7f0a9fa3a011 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/baa00f67/uploads/origins/924ed367-05e3-4b91-90d0-7a94d1777843?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d9f057f1122d578c842029b885750752", "srcset": "https://si.imgix.net/baa00f67/uploads/origins/924ed367-05e3-4b91-90d0-7a94d1777843?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d9f057f1122d578c842029b885750752, https://si.imgix.net/baa00f67/uploads/origins/924ed367-05e3-4b91-90d0-7a94d1777843?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=c0869857a5acc5843cc14649d7dfaed4 2x, https://si.imgix.net/baa00f67/uploads/origins/924ed367-05e3-4b91-90d0-7a94d1777843?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=dc2bce9f61a7eb7e109681e480bde878 3x"}, "body": "初めまして！初めて依頼させていただきます！\n以前からpixivでイラストを拝見させていただいておりました！\n今回は『バレットガールズ』というゲームに登場する『雪城瑠水』ちゃんが風のいたずらでパンモロしてるシーンをお願いします！\n\n【参考資料】\nhttps://i.imgur.com/ucdYxtE.png（『雪城瑠水』公式イラスト）\nhttps://i.imgur.com/KnaMoDy.jpg（バレットガールズ２のゲーム中でスカートを捲られてパンモロする瑠水ちゃん、デフォはいちごパンツ）\nhttps://i.imgur.com/wT8veyb.jpg（同上）\nhttps://www.d3p.co.jp/bulletgirls2/#/character.html（バレットガールズ２公式）\n\n【MMDで自主制作した参考構図】\nhttps://i.imgur.com/vJ3UFN5.png\n構図・表情・ポーズ・描写範囲は上記リンクと同じように描いていただきたいです。\n\n【シチュエーション等】\n・突然の爆風でスカートを背中が見えるくらい全開まで捲られ、顔を真っ赤にしながら内股気味に必死にスカートの前側を押さえる（スカートというよりも股間を押さえるようなイメージ）ものの、お尻側のぱんつが完全に丸見えになってしまっている。\n・必死にスカートを押さえようとするものの、風が強すぎて全くぱんつを隠せておらず、前からのアングルでもほぼ丸見え。（とにかくスカートを豪快に捲っていただいて、とにかくどのアングルからもぱんつが丸見えの状態にしていただきたい）\n・スカートの前側を押さえてる両腕に挟まれたおっぱいが強調される。\n・ぱんつは『水色しましま柄ぱんつ』でお願いします。（フロントリボンも見えてるとありがたいです！クロッチの描写もお願いします！）\n・もしよろしければ、『無地の純白ぱんつ（クロッチ・フロントリボン付き）』差分も頂ければ嬉しいです！\n\n何卒よろしくお願いします…！", "nc": 160, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Tobikaku0121/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2566839, "client_id": 90160, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/9158aa32/uploads/origins/80a7aabf-a56d-4bb7-b547-6f6b45a8a0a4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=afe75b6b1a04d64470b36f610e26a372", "srcset": "https://si.imgix.net/9158aa32/uploads/origins/80a7aabf-a56d-4bb7-b547-6f6b45a8a0a4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=afe75b6b1a04d64470b36f610e26a372, https://si