4f-19403386c3d3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=173fc4b4809b053a4d4780160b878590", "srcset": "https://si.imgix.net/bba4ca60/uploads/origins/eb400f4f-9c7c-4c7f-894f-19403386c3d3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=173fc4b4809b053a4d4780160b878590, https://si.imgix.net/bba4ca60/uploads/origins/eb400f4f-9c7c-4c7f-894f-19403386c3d3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=a49816f0c6be83779bddd9b7c051dd2b 2x, https://si.imgix.net/bba4ca60/uploads/origins/eb400f4f-9c7c-4c7f-894f-19403386c3d3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=304427253d4fdec30077534a80f69c96 3x"}, "body": "こんにちは、稲賀兎先生、私は中国大陸から来ましたFouChovと申します。先生が過去に描かれた一連の水星記念画に魅了されています！今回、水星記念画の注文をお願いしたいと思います！(skebの専属翻訳者が翻訳した文章は、中国語の原文と乖離している可能性がありますので、ご覧になっている日本語の文章がご存知の設定と異なる場合は、中国語の原文をご参照ください。🙏🏻)\n\n以下は画面の条件です。\n\n文字\nマーキュリーメモリアル、マーキュリーメモリアル-META\n\nコスチューム\nマーキュリーメモリアル - （イタズラセレクト!）\nマーキュリーメモリアル - META - (サクランボ・ブイ)\n\n背景\nマーキュリーメモリアルの寝室（実は、マーキュリーメモリアルが生放送をするときに使っている部屋なんですよ～。）\n\n写真\n寝室のソファに水星記念と水星記念-METAが足を揃えて座っている。\n右側が水星記念、左側が水星記念-META。\n水星記念と水星記念-METAは横向きで指を組み、太ももを写真の内側に向けている。\n水星記念と水星記念-METAの頭と目は写真の中央を向いている。\n水星記念の表情が小悪魔的。\n水星記念-METAは、高貴な雰囲気に似合わず可愛らしい衣装を着ているため、顔を赤らめて恥ずかしがっているが、自分を見つめる指揮官に対して高貴な人柄を保たなければならないため、笑顔のようで笑顔でない歪んだ表情を見せざるを得ない。\n\nテキストライン\nマーキュリーメモリアルの空いた左手が画面手前に向かって伸び、目の前の「あなた」に問いかける。「司令官、どのマーキュリーメモリアルを選びますか～❤️」（中国語版と日本語版があればいいのに）。\n\n要項をより理解しやすくするため、以下のURLに背景や下書き画像への参考リンクを載せておきます！🙏🏻\n\nhttps://drive.google.com/drive/u/0/folders/1HeUGybAC_GkdS9W9QX67R9ljQfdC3Byp?fd=true", "nc": 177, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@nissi15068624/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 331574, "client_id": 299338, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/b5338bd4/uploads/o