。\nリュックの肩紐にあるのはたまごっち、アライグマのぬいぐるみの中に匕首がある。\n\n外交的なぶりっ子、時々自分の名前で自称する。\n見た目はそう見えないけど、実は頼れるタイプ。\n\n戦場ではFN P90を使っていた。一人で軍隊を消滅した経験がある、「戦場のコロンビダエ（Columbidae／飛鳥）」と呼ばれている。\n\n弱い者は守れるべき、平和な日常が一番いいと思っている。\n日本に帰った後、人を怖がられないように今の格好をしている。\n体には傷跡がたくさん残っている。\n\nhttps://drive.google.com/drive/folders/1of2TnmjdKjeYL8UhdbCWmPt0FUAKVe4M\n\nhttps://drive.google.com/drive/folders/1of2TnmjdKjeYL8UhdbCWmPt0FUAKVe4M", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Tw8X_/works/10", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1992878, "client_id": 2056332, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/1968f0de/uploads/origins/512ef61f-b9f2-4e8d-b4d5-1b325f9cff55?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8fc97c2679f05fe3f55f79de1560b83c", "srcset": "https://si.imgix.net/1968f0de/uploads/origins/512ef61f-b9f2-4e8d-b4d5-1b325f9cff55?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8fc97c2679f05fe3f55f79de1560b83c, https://si.imgix.net/1968f0de/uploads/origins/512ef61f-b9f2-4e8d-b4d5-1b325f9cff55?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b14bdfb5e67d2c708e1200da084082ef 2x, https://si.imgix.net/1968f0de/uploads/origins/512ef61f-b9f2-4e8d-b4d5-1b325f9cff55?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=89841f259a439033c5ccbda14bc92eb2 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/1968f0de/uploads/origins/512ef61f-b9f2-4e8d-b4d5-1b325f9cff55?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=457bdbe20bda5218b7ab86ac0f93c2f7", "srcset": "https://si.imgix.net/1968f0de/uploads/origins/512ef61f-b9f2-4e8d-b4d5-1b325f9cff55?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=457bdbe20bda5218b7ab86ac0f93c2f7, http