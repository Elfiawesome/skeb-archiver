8-404e-a417-5b0e54df3a93?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c578e482737fcc5a04910d2269c7514e 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/0f06430a/uploads/origins/de635eaf-1168-404e-a417-5b0e54df3a93?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5fd510537d4d5e0e98519c4ad4427643", "srcset": "https://si.imgix.net/0f06430a/uploads/origins/de635eaf-1168-404e-a417-5b0e54df3a93?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5fd510537d4d5e0e98519c4ad4427643, https://si.imgix.net/0f06430a/uploads/origins/de635eaf-1168-404e-a417-5b0e54df3a93?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=d0f10df2f6b263db759879a26d032a9c 2x, https://si.imgix.net/0f06430a/uploads/origins/de635eaf-1168-404e-a417-5b0e54df3a93?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=5b3adbdd1da71d8e41bc35fec479cf5d 3x"}, "body": "びっけ様\n\nはじめまして！アピールありがとうございます。\nキャラクターを気に入っていただけてとてもうれしいです！\nびっけ様の物語を感じるイラスト、とても素敵です…！\n独特の温度や空気感がとても好きです。ぜひともリクエストをお願いいたします…！\n\n▼リクエスト内容\nリクエストの内容は私自身のイラストです。\n身長は155㎝程度で、物語を愛している水平線に棲む精霊です。\n資料につきましては、お手数ですがURLのドライブをご参考くださいませ。\n\n構図は『夜に本を読んでいる姿』か『夜の海に映る月を眺める姿』で、\n衣装は通常服かアンティーク、ご自由にアレンジしていただいてもかまいません。\n\n▼使用用途\n『睡眠用朗読』のYoutube配信用サムネイル、SNSアイコン等\nできれば背景とキャラクターのレイヤーをわけたPSDファイルを\nご作成いただけますと大変ありがたく存じます。\n(使用の際は必ずクレジットを表記させていただきます)\n\nお忙しい中恐縮ではございますが、\nご検討のほど何卒よろしくお願いいたします。\n\n彼方スミ\n\nhttps://drive.google.com/drive/folders/11hu3wXZtZ_S-IfoNmN7CiB8mWSccBq22", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@okowa_san_desu/works/14", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1501910, "client_id": 2007861, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/10d571da/uploads/origins/b25d9479-f050-44e5-9d2e-e8464c169eba?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ee36bbab30b41a443e9d8e840198a83a", "srcset": "https://si.imgix.net/10d571da/uploads/origins/b25d9479-f050-44e5-9d2e-e8464c169eba?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ee36bbab30b41a443e9d8e840198a83a, https://si.imgix.net/10d571da/uploads/origins/b25d9479-f050-44e5-9d2e-e8464c169eba?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=d188b04dba3a19e9ab868cdefa872c3b 2x, https://si.imgix.net/10d571da/uploads/origins/b25d9479-f050-44e5-9d2e-e8464c169eba?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e9779d243cb4978b47d7a739d6477a91 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/10d571da/uploads/origins/b25d9479-f050-44e5-9d2e-e8464c169eba?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3d158994d3dc282cb58facfbe57a6c1a", "srcset": "https://si.imgix.net/10d571da/uploads/origins/b25d9479-f050-44e5-9d2e-e8464c169eba?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3d158994d3dc282cb58facfbe57a6c1a, https://si.imgix.net/10d571da/uploads/origins/b25d9479-f050-44e5-9d2e-e8464c169eba?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=7866d4bda13c047ed2e80f808941dcf7 2x, https://si.imgix.net/10d571da/uploads/origins/b25d9479-f050-44e5-9d2e-e8464c169eba?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=79e862e81b8d65a9d6714f1c750014ac 3x"}, "body": "びっけさんアピールをありがとうございます私のキツネキャラを描いていただけるなら、こんなに嬉しいことはありません。ビッケさんの作品集を拝見させていただきましたが、キャラクターや風景に愛情がこもっていて素敵です。\n\nポーズや表情は自由に考えてください。あなたのセンスを全面的に信頼します。風景は、私は星空か海辺を連想することが多いですね。何でも結構です。\n\n説明\n性別は不詳ですが、顔立ちは男性的な傾向があります。全体的に落ち着きがあり、時々眠気を誘うようなオーラをまとっています。剣士であり、主にレイピアを武器とする。黄色い目は前髪で少し覆われており、黄色い目の下には美容マークがある。\n\nあなたの絵は、個人的な使用のみに使用したいと思います。\n改