ttps://si.imgix.net/4ee7ea96/uploads/origins/f81a51ed-0349-499b-a594-ed95d8206160?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=fe3ce516cfa55feaa627addc959139a1 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/4ee7ea96/uploads/origins/f81a51ed-0349-499b-a594-ed95d8206160?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=562f92b6f9a5f39a231b95968b7df1bc", "srcset": "https://si.imgix.net/4ee7ea96/uploads/origins/f81a51ed-0349-499b-a594-ed95d8206160?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=562f92b6f9a5f39a231b95968b7df1bc, https://si.imgix.net/4ee7ea96/uploads/origins/f81a51ed-0349-499b-a594-ed95d8206160?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=76e1b0aad1bc436c47e1f1bd44d4c8c2 2x, https://si.imgix.net/4ee7ea96/uploads/origins/f81a51ed-0349-499b-a594-ed95d8206160?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=e40d641fef680f34d58c406a6247c32a 3x"}, "body": "はじめまして！はちはじめさん！ミスデザのお仕事宣伝チャンネルでお見かけして絵本のような柔らかい塗りのタッチが素敵だなぁと思い一目でリクエストしたくなりはじめてリクエストを送りました。\n描いてほしいのは私のオリジナルキャラのフレールくんです。大人ぽっい気品のある雰囲気があるものの子供のような無邪気で元気な一面がある人外さんです。マンタをモチーフにしているので海や水ぽっい背景だと嬉しいです。構図はお任せします！また描いて頂いたイラストを私個人用に使うスマホカバーに使用したいと考えているため納品サイズはできるだけ縦長でお願いします。\nキャラクターデザイン資料を添付してありますのでご参照いただけると幸いです。\n\n\nもし引き受けていただけると嬉しいです！検討の程よろしくお願い致します。\n\nhttps://drive.google.com/drive/folders/1-aLTQY4su6wgFmUW6D1z3rsJ3U3hdk2V", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@yada__yoda/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3255552, "client_id": 1166577, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/123a51ec/uploads/origins/abcd37de-fb26-4d56-aed4-e05351164fd2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop