れない)、数名の出会った人と外へ出れるよう冒険中です\n・髪は一つに括っていて、かっこいいお姉さんのイメージです\n・武器はダガーを装備していますが、戦う時は動物に変身して戦うのであまり使用しません\n・簡単な魔法も使えます\n・年齢は20代を想像しています", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@yada__yoda/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3255552, "client_id": 2715476, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/463a820f/uploads/origins/e4b71731-ace0-4826-84fc-394cabf50e03?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ee24a1e0a9d04931b863e7c3491b7b59", "srcset": "https://si.imgix.net/463a820f/uploads/origins/e4b71731-ace0-4826-84fc-394cabf50e03?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ee24a1e0a9d04931b863e7c3491b7b59, https://si.imgix.net/463a820f/uploads/origins/e4b71731-ace0-4826-84fc-394cabf50e03?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=abcc035ad891df577fd27a1b8458aa27 2x, https://si.imgix.net/463a820f/uploads/origins/e4b71731-ace0-4826-84fc-394cabf50e03?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=82e8db886fe67071487bec05bf4eb405 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/463a820f/uploads/origins/e4b71731-ace0-4826-84fc-394cabf50e03?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=77b3b188f2c73c3f9e6125b697d4e583", "srcset": "https://si.imgix.net/463a820f/uploads/origins/e4b71731-ace0-4826-84fc-394cabf50e03?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=77b3b188f2c73c3f9e6125b697d4e583, https://si.imgix.net/463a820f/uploads/origins/e4b71731-ace0-4826-84fc-394cabf50e03?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=6bff94239f657e1e114ebfcd0dc900d7 2x, https://si.imgix.net/463a820f/uploads/origins/e4b71731-ace0