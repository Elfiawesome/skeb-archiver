f1-91a0-afc7d6efd7e9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=31c1c6ce33b6f29cbc44f58610017bcf 3x"}, "body": "こんにちは！ いつも作品楽しみにしてます★\n ご依頼内容は以下の感じでお願いしたいです★  \n・オリキャラ(自分をにろふぇんの住人に例えた姿を希望) \n・ベータ様のお得意な「闇」系のイラストを希望  \n・自分の自己紹介(参考になれば…！) 鬱病とPTSDを持ってます。お薬も飲んでいますがどちらかというとカフェイン(コーヒー)に依存して無理やり頑張ってる感じです。 \nとにかくどうとしてもむりやりでも体が動く限り学業や仕事、人間関係等頑張ってしまう傾向にあるけど報われてこなかった人生です。\n もし、にろふぇんのストーリー感を出すと頑張ることが正しいと信じて頑張ってきたけど止まるべきじゃないかなと悩んでるところにネク君が来て「よかった探し」の少しズレた発想をしてしまい、心身ボロボロなのに頑張り続ける様な感じでしょうか…！\n ・当方ジェンダーレスなので中性か少し女性寄りに描いていただけると幸いです！\n ・色合いは特に希望とまではいかないですがオレンジとか黄色とかブラウンとか好きです！  \nよろしくお願いします", "nc": 152, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@beeta/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3065069, "client_id": 1501094, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/2b1cf4f9/uploads/origins/dc91fc80-df96-4003-a9bf-cff6734108aa?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a6bdcf0a639539e7ec43b50f1828dcb6", "srcset": "https://si.imgix.net/2b1cf4f9/uploads/origins/dc91fc80-df96-4003-a9bf-cff6734108aa?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a6bdcf0a639539e7ec43b50f1828dcb6, https://si.imgix.net/2b1cf4f9/uploads/origins/dc91fc80-df96-4003-a9bf-cff6734108aa?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=4acb6bf357845543fce7a23a5342b120 2x, https://si.imgix.net/2b1cf4f9/uploads/origins/dc91fc80-df96-4003-a9bf-cff6734108aa?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c8cbf60fd9d2542fc3f699ef29b14738 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/2b1cf4f9/uploads/origins/dc91fc80-df96-4003-a9bf-cff6734108aa?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=39527bd6e6c321e3301a3bf0878712ad", "srcset": "https://si.imgix.net/2b1cf4f9/uploads/origins/dc91fc80-df96-4003-a9bf-cff6734108aa?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=39527bd6e6c321e3301a3bf0878712ad, https://si.imgix.net/2b1cf4f9/uploads/origins/dc91fc80-df96-4003-a9bf-cff6734108aa?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=df2500030d67fc8cb875a574c12d8adf 2x, https://si.imgix.net/2b1cf4f9/uploads/origins/dc91fc80-df96-4003-a9bf-cff6734108aa?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=b9495224392c5fbf150c96f49786c392 3x"}, "body": "初めまして！べーたさんがnoteに投稿されていたskebの記事からべーたさんを知り、そこからにろふぇんを拝読しました。\n可愛い絵柄と奥深くまで考えられた世界観、この先どうなるのかというハラハラ感に夢中になり、気付いたら全話一気読みしてしまいました！マルベリーちゃんが特に好きです。\n透明水彩の色合いや繊細さ、アナログならではの線のタッチ、心情や背景の描き込みも素敵で見入っています。\nskebで描かれたキャラクターさんに対しても、にろふぇんのみんなに対してもべーたさんの思いや愛情がこもっていて、ぜひ私のキャラクターもべーたさんに描いていただきたいと感じました。\n私のOC二人組を動物の姿でにろふぇん風に描いていただきたいです。\n\nバイオレンスミミくん（ミミくん）\n・うさぎの男の子\n・毛色は紫\n・耳は立たせることもできるが基本垂れ耳\n・くりっとした目で両方緑のオッドアイ\n・基本は明るく優しい常識人\n・ステラの奇行にのってあげたりツッコんだり\n\nすったもんだ・テラコッタ（ステラ）\n・柴犬の女の子\n・毛色は白に近いクリーム色\n・山吹色っぽいぱっちりアーモンドアイ\n・難しいことを考えず楽しいことをするのが好き\n・わりとなんでも表情に出る\n\n二人はかなり仲良しな親友（恋人ではない）といった関係です。\n身長差はステラ>ミミくんになっていれば問題ありません。\nその他構図やシチュエーションはべーたさんにお任せさせてください。\n服装もべーたさんのセンスでアレンジしていただけると嬉しいですが、そのままでも問題ありません。\n\n内容や金額などに不備がありましたらお気軽に再送ください。\nご検討いただけますと幸いです。\nよろしくお願いいたします。\n\n資料\nhttps://drive.google.com/drive/folders/17OzoB2rydSPEXQjLK6Yd3lLboIB6_yYj\n補足資料（二人の空気感の資料です。こちらのご確認はして頂かなくても問題ありません） \nhttps://drive.google.com/drive/folders/1mTjMZmrqK0JGvbXj4kVfieQqmwhXCiFC", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@beeta/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3065069, "client_id": 3081594, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/88294c6e/uploads/origins/dea85137-79bc-4710-9e40-b743cf321d7e?bg=%23fff&auto