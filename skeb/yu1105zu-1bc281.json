ぽく、どこか胡散臭くてイキリがちです。\n【ちよだかな】女\n一人称:私、ちよ  \n自称永遠の17歳を語る見た目の通り地雷系女子です。明るく元気いっぱいで、少し世間知らずでお嬢様な一面があります。\n\n構図は距離が近くイチャイチャした雰囲気のイラストだと嬉しいです...！\nお手数をおかけしてしまいますが、適正値段でなければ値段修正した後に再送をお願いします。\n\nhttps://drive.google.com/drive/folders/11u5Z9P9OhuPw5cvTr5yt2AFREAiqDVVy?usp=sharing", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@yu1105zu/works/13", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2983766, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/81fc79bd/uploads/origins/a7c33321-a9c6-4468-a222-d82b21876d34?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=dfc594fa8e15626b1e27708872e1b32f", "srcset": "https://si.imgix.net/81fc79bd/uploads/origins/a7c33321-a9c6-4468-a222-d82b21876d34?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=dfc594fa8e15626b1e27708872e1b32f, https://si.imgix.net/81fc79bd/uploads/origins/a7c33321-a9c6-4468-a222-d82b21876d34?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=5f05e2acced89179ddc091e0257bdf6a 2x, https://si.imgix.net/81fc79bd/uploads/origins/a7c33321-a9c6-4468-a222-d82b21876d34?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=420074c664969930bc05099e5db29cdd 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/81fc79bd/uploads/origins/a7c33321-a9c6-4468-a222-d82b21876d34?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=bd3319e0c6c9faf6f9e32dc2d7a567ca", "srcset": "https://si.imgix.net/81fc79bd/uploads/origins/a7c33321-a9c6-4468-a222-d82b21876d34?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=bd3319e0c6c9faf6f9e32dc2d7a567ca, https://si.imgix.net/81fc79bd/uploads/origins/a7c33321-a9c6-4468-a222-d82b21876d34?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=to