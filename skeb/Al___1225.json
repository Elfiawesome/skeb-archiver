364-b562-459d-a98c-6e596041e595?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=6b9defe0377176ddcd013a870ff481f3 2x, https://si.imgix.net/b6588eaf/uploads/origins/ff0c3364-b562-459d-a98c-6e596041e595?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=25ab945f34567781ceb9b67e01930805 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/b6588eaf/uploads/origins/ff0c3364-b562-459d-a98c-6e596041e595?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=cac4f1c552ff7d8ca6f1c34f71ec9c82", "srcset": "https://si.imgix.net/b6588eaf/uploads/origins/ff0c3364-b562-459d-a98c-6e596041e595?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=cac4f1c552ff7d8ca6f1c34f71ec9c82, https://si.imgix.net/b6588eaf/uploads/origins/ff0c3364-b562-459d-a98c-6e596041e595?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=9ff4796894fa78c4626278a94e177bbe 2x, https://si.imgix.net/b6588eaf/uploads/origins/ff0c3364-b562-459d-a98c-6e596041e595?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=a5b08c10865aa8bec3bc8611c00ecf63 3x"}, "body": "ある様。初めまして。\n素敵な絵師様に出会ってしまった！と思い今回依頼させて頂きました。\n是非ある様に私と相方のOCを描いて頂きたいと思っております。\n\n2人はCoC｢辜月のN｣で使用した探索者達です。\n\n①楠見　明海(くすみ　あみ)\n小説家志望の大学2年生\n書いているジャンルはミステリー\n執筆時は眼鏡をかけています\n相手の漫画のストーリーを考えています\n‣‣そろそろ自分で書けるようになって欲しいと思っている\n自分磨きが好きで身だしなみには気を使っています\n外見こそ整っているが生活面がだらしなく、部屋が汚い\n顔と声に感情があまり乗らないが相手が嫌いだとかそういうことでは無い\n無意識に細に依存している\n174cm\n\nhttps://drive.google.com/drive/folders/1qVOFdfmAti4U44QZrEjiz8msvMPxOBvr\n\n②光永　細(みつなが　ささめ)\n漫画家志望の大学2年生\n周りから見れば、適当なことを言いつつのらりくらりとしながらノリで生きているような、そんな男。何も考えていないようで、考えている時もあるし、本当に適当こいている時もある\n京都生まれ京都育ちではあるが、嫌味や皮肉などは口にしない正直者である\nあみに依存している\n170cm\n\nhttps://drive.google.com/drive/folders/1bE7tlmf4xUK1DTQFljjHed9x8U-uW8cJ\n\n\n【二人の関係性】\n大学の同級生\nお互いを親友だと思ってる\n\n【距離感】\n普通の友達よりは近いです\n付き合ってるとかではないです\nいつも一緒にいます\n\n詰め込みイラストでご依頼したいのですが可能でしょうか？\n\n\n【使用用途】\nSNSでの使用(アイコン、ヘッダー等)\n個人的なグッズの制作(商用利用等無し)\n‣‣背景透過済みのものを頂くことは可能でしょうか。\n\n\n金額が見合っていない等ありましたら、お手数お掛けしますが再送をお願い致します。\n\n長文となりましたが、最後までお読みいただきありがとうございます。\nよろしくお願いします。", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Al___1225/works/12", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/92c0f0e0/uploads/origins/1a5cdf10-efb0-4b44-89a2-30694c0b5b65?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=610984045daccd4297181fa48eb8f52a", "srcset": "https://si.imgix.net/92c0f0e0/uploads/origins/1a5cdf10-efb0-4b44-89a2-30694c0b5b65?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=610984045daccd4297181fa48eb8f52a, https://si.imgix.net/92c0f0e0/uploads/origins/1a5cdf10-efb0-4b44-89a2-30694c0b5b65?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=d856f6db79a2193aba5989c04c242eb3 2x, https://si.imgix.net/92c0f0e0/uploads/origins/1a5cdf10-efb0-4b44-89a2-30694c0b5b65?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=04be12f753a497e85454be903e9119bb 3x"}, "private": true, "genre": "art", "tipped": false, "creator_id": 2126467, "nc": 144}, {"path": "/@Al___1225/works/11", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2126467, "client_id": 3150728, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/3c0b4e62/uploads/origins/185c4433-b4df-4f6e-a063-898f7d11c3c1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h