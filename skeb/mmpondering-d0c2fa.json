31/uploads/origins/f292bda4-1dbb-4bcb-9d67-ff4c12f484e4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=93ffb74cc4fc9c704dd3f6a2dd00457b 2x, https://si.imgix.net/26095631/uploads/origins/f292bda4-1dbb-4bcb-9d67-ff4c12f484e4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=72c0c6fe74ddfb2668f34ad6111766d9 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/26095631/uploads/origins/f292bda4-1dbb-4bcb-9d67-ff4c12f484e4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=4bed55062edb9eb41ba6cb7e8973fac5", "srcset": "https://si.imgix.net/26095631/uploads/origins/f292bda4-1dbb-4bcb-9d67-ff4c12f484e4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=4bed55062edb9eb41ba6cb7e8973fac5, https://si.imgix.net/26095631/uploads/origins/f292bda4-1dbb-4bcb-9d67-ff4c12f484e4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=dc2eb89ca4f723c3c371c618b57bb959 2x, https://si.imgix.net/26095631/uploads/origins/f292bda4-1dbb-4bcb-9d67-ff4c12f484e4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=3607e1b9c23af1184bb22ada9ffa54c7 3x"}, "body": "はじめまして。motsu様の素敵なイラストに惹かれて、是非私のオリキャラを描いていただきたいと思います。ポーズや構図はお任せいたします。\n\n世界観：淡い青緑色に輝く小さなウサギの姿をした彼女は、森の風や鳥たちが運んでくる人間の忘れ物や願いごとに宿る物語を聞くことができ、それを楽しむのが大好き。やがて人間の世界に興味を持ち、森の力で人間の少女の姿に変わり、自らその感情や物語を体験するための旅に出ました。\n\n性格：人間の世界をよく知らず、好奇心が旺盛。かわいくて元気だけど、騒がしい感じではない。\n\n衣装：その中からお好きな1着を選んで描いていただければ大丈夫です。\n\n使用用途：\n個人観賞用\n可能であれば、PSDデータで人物、背景、サインが分かれていると嬉しいです。\n※人物の頭が切れない構図だとうれしいです。\nhttps://drive.google.com/drive/folders/1s10gsarTWoRCeX7V7mARCDO1u4Vsa5kG?usp=sharing\nキャラクターシートを参考にしてください。\n\nmotsu様のこの作品がとても素敵だと思います。このような雰囲気でお願いできれば幸いです。\nhttps://skeb.jp/@Padazn1/works/3", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@mmpondering/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3591485, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/c8682519/uploads/origins/faf0dfa9-3442-4111-bbfa-8ca83e04a1fb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d4aedd72aa214a12cc40328373e6f6dc", "srcset": "https://si.imgix.net/c8682519/uploads/origins/faf0dfa9-3442-4111-bbfa-8ca83e04a1fb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d4aedd72aa214a12cc40328373e6f6dc, https://si.imgix.net/c8682519/uploads/origins/faf0dfa9-3442-4111-bbfa-8ca83e04a1fb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=d2e6a1e0f5222754b3a651248aeef4ab 2x, https://si.imgix.net/c8682519/uploads/origins/faf0dfa9-3442-4111-bbfa-8ca83e04a1fb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=0f7692e6c002643ed1a738aa9b92c30c 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/c8682519/uploads/origins/faf0dfa9-3442-4111-bbfa-8ca83e04a1fb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=823979195e1888566415b46df9ecf398", "srcset": "https://si.imgix.net/c8682519/uploads/origins/faf0dfa9-3442-4111-bbfa-8ca83e04a1fb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=823979195e1888566415b46df9ecf398, https://si.imgix.net/c8682519/uploads/origins/faf0dfa9-3442-4111-bbfa-8ca83e04a1fb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=b0849ba0e067f7e96fbce2b58c074925 2x, https://si.imgix.net/c8682519/uploads/origins/faf0dfa9-3442-4111-bbfa-8ca83e04a1fb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=fa7aeaf5a3e373c30d6c7f07f8d69718 3x"}, "body": "はじめまして。マトと申します。\nTRPGのキャラクター達のイラストをお願いしたいと思いリクエストさせていただきました。\n資料用にキャラクター4人の簡単なキャラ説明と資料リンクを添付いたします。\n4人は子供だけで構成された特殊な組織に所属する一組のチームです。\n\n1⃣チームのリーダー的存在 男 15歳 165cm\n髪色:水色 目の色:水色 得意武器:銃 イギリス人\n・正義感が強く真面目だが柔軟で茶目っけもある少年。チーム内で最も組織所属年数が長い。\n・歳の割に落ち着きがあるが、悲しいことがあると人目のない場所を選んで涙を流す年相応の一面も\n・仲間のためなら真っ向から立ち向かえる強さもある\n・火が苦手\nイメージカラー:水色\n\n2️⃣天才科学者 女 13歳 148cm\n髪色:白と黒のツートン 目の色:白と黒のオッドアイ 得意な戦法:投擲 ギリシャ人\n・愛らしい見た目にそぐわぬマッドな思想を持つ天才科学者。\n・現在は人の心を知り仲間を顧みる少女になった\n・考え方の芯はしっかりしているが頑固者ではなく口調も朗らか。無邪気で無垢。\n・水が苦手\nイメージカラー:黄緑\n\n3️⃣コンピューター・機械類のプロ 男 16歳 166cm アメリカ人\n髪色:暗い紫 目の色:濃い紫(パンジー色) 武器:ドローン\n・チームで一番年上。笑みを絶やさず面倒見の良い、親しみやすい少年\n・穏やかで温厚だがしたたかな面もあり、計算高く己の立ち位置を維持する能力もある\n・コンピューターや機械類に精通しており、難解な機械類も難なく修理してしまう。\n・土が苦手\nイメージカラー:紫\n\n4️⃣戦闘要員 女 13歳 150cm 日本人\n髪色:白 目の色:赤 得意武器:大型ナイフ\n・勝ち気で負けず嫌い。所謂ツンデレだがチームのみんなが大好き。1️⃣には無意識だが淡い恋心を抱いている。\n・いじっぱりかつ褒められると調子に乗りやすく、本質的には甘えん坊の末っ子気質\n・戦闘能力が高く、チームの皆を守るための心構えも持っている。\n・強い風が苦手\nイメージカラー:赤\n\n・1️⃣は3️⃣のことを兄のようだと形容している\n・2️⃣と4️⃣は歳が同じこともあり、主に4️⃣が2️⃣にくっついている\n・仲が良く一緒に海に行ったり、食事を共にしたり、花火を楽しんだりもする。\n\nシチュエーションはなんでも大丈夫です！\nよろしくお願いします。\n\nhttps://drive.google.com/drive/folders/1gH74HMPpvbNWvsgZGLCULUKDlPgucEJb", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@mmpondering/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3591485, "client_id": 3548875, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/672ea448/uploads/origins/8a2df8fe-6364-4ed4-a69d-d0f9cc1ad6d0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d470be912e227eff613193fd3d453f37", "srcset": "https://si.imgix.net/672ea448/uploads/origins/8a2df8fe-6364-4ed4-a69d-d0f9cc1ad6d0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d470be912e227eff613193fd3d453f37, https://si.imgix.net/672ea448/uploads/origins/8a2df8fe-6364-4ed4-a69d-d0f9cc1ad6d0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ca9c717f09ea58ea4f47e9f9961719fd 2x, https://si.imgix.net/672ea448/uploads/origins/8a2df8fe-6364-4ed4-a69d-d0f9cc1ad6d0?bg=%23fff&auto=format%