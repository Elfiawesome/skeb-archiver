2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=c7a0d6baff9dab2d1c5846e065bc8316 3x"}, "body": "はじめまして！主にシブにて認知しております\nあなたのその塗りと体型を魅力に感じ依頼してみたいと思い至りました、早速ですが依頼の話をしていきます\n\n東方Projectの因幡てゐと封獣ぬえが扇風機の前でたくし上げて涼んでる絵をお願いしたいです\n\nてゐの方はだらしない顔で涼んでる、ぬえの方は未知の機械に目を輝かせながら涼んでる表情でお願いします\n下着を穿いてないバージョンも欲しいです、可能なら色んな場所に…\n\n２人は大変かもしれませんがご検討宜しくお願い致しますわ", "nc": 169, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@000aoiro/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3853343, "client_id": 3909297, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/8c096bda/uploads/origins/b7f507b1-4acd-4704-991b-4a4357076019?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=eb78f4b4ce7270a2c20d29f664793e2f", "srcset": "https://si.imgix.net/8c096bda/uploads/origins/b7f507b1-4acd-4704-991b-4a4357076019?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=eb78f4b4ce7270a2c20d29f664793e2f, https://si.imgix.net/8c096bda/uploads/origins/b7f507b1-4acd-4704-991b-4a4357076019?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c996b3f63d5e51f0cc208dd612ca8ffa 2x, https://si.imgix.net/8c096bda/uploads/origins/b7f507b1-4acd-4704-991b-4a4357076019?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=8ac2193d1c3585c906ce372a1a18e111 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/8c096bda/uploads/origins/b7f507b1-4acd-4704-991b-4a4357076019?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a719aa2b0c4efcc57e512eb343d6b180", "srcset": "https://si.imgix.net/8c096bda/uploads/origins/b7f507b1-4acd-4704-991b-4a4357076019?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a719aa2b0c4efcc57e512eb343d6b180, https://si.imgix.net/8c096bda/uploads/origi