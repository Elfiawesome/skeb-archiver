限りレイヤーが分かれた状態でのpsd納品をお願いします\n\n用途\n・私が見たいというだけなので、特にありません\n・(Skebの規約上定められていることではありますが)依頼絵であることを明示せずにpixiv等で公開していただいても全く構いません\n\nもし気乗りしないということであれば気兼ねなく不承認していただければと思います。\n\nご検討のほど、よろしくお願いいたします。\n\nhttps://www.pixiv.net/artworks/88123531", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@karado7777/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 972137, "client_id": 14782, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/7f8d7f56/requests/228208_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=dd7aa2761a983a740ca5a66dd18d059d", "srcset": "https://si.imgix.net/7f8d7f56/requests/228208_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=dd7aa2761a983a740ca5a66dd18d059d, https://si.imgix.net/7f8d7f56/requests/228208_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=83069c4cf6a90722d3de5ae73be15255 2x, https://si.imgix.net/7f8d7f56/requests/228208_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f268f4af4c0e1ddf66c6e6356348b029 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/7f8d7f56/requests/228208_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=00445ef7ad2ce0b2815f82458a518e8f", "srcset": "https://si.imgix.net/7f8d7f56/requests/228208_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=00445ef7ad2ce0b2815f82458a518e8f, https://si.imgix.net/7f8d7f56/requests/228208_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=c69f9213e82ed22232d30531c98f0eb9 2x, https://si.imgix.net/7f8d7f56/requests/228208_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=b7ea3028b00b0f46f89f9eaca3e7e2aa 3x"}, "body": "いつもお世話になっております\n