イアと天使のハーフです。詳しくは添付画像をご参照ください。\n(画面でみて左にコウモリに近い羽、右に天使の羽、天使の輪は歪んでいます。角はありません。ホクロは画面で見て左側目尻、胸元、下腹、うち太ももにあります。)\n・衣装はバニーガールでお願いしたいです\n頭上左右は見切れないようにしていただけますと嬉しいです。\n・背景ありの場合、人物のみの透過も頂けますと幸いです\n\n使用用途\n・SNSへの利用、サムネイルや動画など配信への活用、デジタルやリアルグッズへの使用(ネップリ、アイコンリング等)\n\nもしリクエスト額か足りないようでしたら再度お送りさせて頂きます。\n\n恐れ入りますがこちらの点ご確認よろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/1zi8fKjW_pBb3ttdMzTgJshHWE7fNATJ0", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@_yotomesui/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3885881, "client_id": 3495323, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/e185786b/uploads/origins/fbccc4bf-0631-4d8a-a25b-78679d313df7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bc3a838bf8aa0783700946a3d11430cb", "srcset": "https://si.imgix.net/e185786b/uploads/origins/fbccc4bf-0631-4d8a-a25b-78679d313df7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bc3a838bf8aa0783700946a3d11430cb, https://si.imgix.net/e185786b/uploads/origins/fbccc4bf-0631-4d8a-a25b-78679d313df7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=defde4ca38e4c6f066ef03b3106c03e5 2x, https://si.imgix.net/e185786b/uploads/origins/fbccc4bf-0631-4d8a-a25b-78679d313df7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f272debb0eb6e8756d8c2c900e217777 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/e185786b/uploads/origins/fbccc4bf-0631-4d8a-a25b-78679d313df7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f867b52e1517859d879cb307440daf9b", "srcset": "https://si.imgix.net/e185786b/uploads/origins/fbccc4bf-0631-4d8a-a25b-78679d313df7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f867b52e1517859d879cb307440daf