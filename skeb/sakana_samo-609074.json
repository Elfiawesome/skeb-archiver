1-4e8e-b07d-40c01ead6379?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=192dd8048d37b0160ec9a8af05b990c9", "srcset": "https://si.imgix.net/b100e9a8/uploads/origins/fa2dea0d-ed71-4e8e-b07d-40c01ead6379?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=192dd8048d37b0160ec9a8af05b990c9, https://si.imgix.net/b100e9a8/uploads/origins/fa2dea0d-ed71-4e8e-b07d-40c01ead6379?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=40c74c91d038b0188e57368c57b32176 2x, https://si.imgix.net/b100e9a8/uploads/origins/fa2dea0d-ed71-4e8e-b07d-40c01ead6379?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=551cbf0506ec3bad445185c668d3f091 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/b100e9a8/uploads/origins/fa2dea0d-ed71-4e8e-b07d-40c01ead6379?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=23b445991493db1cd789a7650b66aa1b", "srcset": "https://si.imgix.net/b100e9a8/uploads/origins/fa2dea0d-ed71-4e8e-b07d-40c01ead6379?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=23b445991493db1cd789a7650b66aa1b, https://si.imgix.net/b100e9a8/uploads/origins/fa2dea0d-ed71-4e8e-b07d-40c01ead6379?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=0aa3d5d173f8ca2856f6bddd3d13064c 2x, https://si.imgix.net/b100e9a8/uploads/origins/fa2dea0d-ed71-4e8e-b07d-40c01ead6379?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=369c0026d103c26efb9517efc75f3cd0 3x"}, "body": "はじめまして。\n怪盗見習いVtuberの水雲七海と申します。\n〇〇の様のイラストに一目惚れして、ぜひ描いていただきたく思いリクエストさせていただきました。\nお忙しいところ恐れ入りますが、お受けいただけたら幸いです。\nご検討よろしくお願いします。\n\n【キャラクター詳細】\n水雲七海\n・青いものを盗むために修行中の怪盗見習い 青系大好きVTuber\n・イメージカラー　水色、白、黒\n・目の色　水色\n・髪型　肩まであるポニーテール\n・髪色　水色\n・正面から見て右耳たぶにほくろあり\n・服  白の無地パーカー、ダボっとした黒の革ジャン、ツヤがある黒の巻きスカート、足首くらいまでのブーツ、右足に黒のレッグウォーマー  \n・装飾品  パーカーの上にハ