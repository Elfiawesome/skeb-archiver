2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=0499e58b6c8ceddc5bbfde694d90d3ff 3x"}, "body": "リクエスト再開、心待ちにしていました。\nつきましては、紲星あかりがゴブリンの苗床にされる異種姦凌辱をお願い致します。\n詳細を下記にまとめたので、ご検討の程よろしくお願い致します。\n\n\n■キャラクター\n紲星あかり\n・ケイさんの描く天子ちゃんや、ぬえちゃん並みの爆乳おっぱいでお願いします\n\n■衣装\n対魔忍衣装\n・色は黒がメインで、下半身はハイレグ風でお願いします\n・イメージとしては、対魔忍「水城不知火」の衣装\n\n■シチュエーション\n対魔忍あかりちゃんがゴブリン退治に向かうも捕らわれてしまい、ゴブリン専用苗床に堕とされる異種姦凌辱をお願いします。\n・おっぱい大好き星人なので、膣内に挿入しているゴブリンとは別に、おっぱいを揉みしだきながら吸い付いているゴブリンも加えてください\n\n■その他\n・ゴブリンはあかりちゃんより小柄にしてください。自分より小さいゴブリン達に凌辱されるシチュが大好物なので\n・台詞を加えてください", "nc": 41, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@keinoyounamono/works/7", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/11ca9fb6/uploads/origins/6bfbb85f-4fda-4a4d-b28e-ec10267d6dd4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=3095efac27488a4f6632d62a03727c3a", "srcset": "https://si.imgix.net/11ca9fb6/uploads/origins/6bfbb85f-4fda-4a4d-b28e-ec10267d6dd4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=3095efac27488a4f6632d62a03727c3a, https://si.imgix.net/11ca9fb6/uploads/origins/6bfbb85f-4fda-4a4d-b28e-ec10267d6dd4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=33ba77ba678eaacf760b416ff9265bb5 2x, https://si.imgix.net/11ca9fb6/uploads/origins/6bfbb85f-4fda-4a4d-b28e-ec10267d6dd4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=d5f149e3d85e5efd780d848109883642 3x"}, "private": true, "genre": "art", "tipped": true, "creator_id": 1835039, "nc": 160}, {"path": "/@keinoyounamono/works/6", 