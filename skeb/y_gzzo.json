si.imgix.net/7cfb696b/uploads/origins/a67cac94-dbc4-4a62-b1d3-0a3a8a7679ab?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f27e9de607c6ed59369447a589694fbf", "src_set": ""}, "body": "y様、はじめまして！\n以前お見かけしまして、とても好きな絵柄の絵師さんだなぁと思っておりました！\nぜひお願いしたいと思いリクエスト送らせていただきます！\n\n\n▽リクエスト内容/希望\nTRPGの私と友人のOCになります。\n※Googleドライブに立ち絵データ入っております。\n\n◾︎構図\nお任せしたいと思っております…！\n2人の距離感が近めだと嬉しいですが、描きやすいように描いていただければと思います。\n\nシチュエーションに困るようでしたら\n海/水族館など、海に関連するものでお願い致します。\n\n\n▽キャラクター詳細\nHO1：神の子\n女、132cm\n純粋、HO2のことが大好き。内気な性格。\n「大きくなったらHO2と結婚したい…」とよく言っている。\nHO2にからかわれてよく顔が赤くなる。\n\nHO2：誘拐犯\n男、175cm\n人を煽ったりすることが多々あるがHO1に対しては優しいし意外と紳士。\n「うん〜お嫁にもらってあげるね〜♡」と返答したり、のらりくらりしてる。\nHO1の手や髪によくキスしたりする。\n\n\n・関係性\n舞台はイタリアのミラノ。\n同じ新興宗教組織に所属しており、HO2がHO1を連れて逃げ出した過去を持つ。\n現在は2人で追っ手から逃げながら一緒に暮らしている。\n移動する時は手を握ったりお姫様抱っこしている。\n\n\n▽使用用途\n個人鑑賞用\nアイコン、ヘッダーなどに使用させていただくこともあります！\nまた、友人にも共有させていただきたく思います。\n（自作発言などは行いません）\n\n┈┈┈┈┈┈┈┈┈┈\n\nこちら受理可能か御検討いただいたけると幸いです！\n金額が足りないなどありましたら再送いただけると嬉しいです。\nご縁がありましたらよろしくお願い致します。\n\nhttps://drive.google.com/drive/folders/1-JgoyA12IDPHtcbAaGt9vdERS0GgHrju?usp=sharing", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@y_gzzo/works/13", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/3b511c8f/uploads/origins/474112d4-5522-4c61-bfec-bcc37038fde0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=262d6aad597d0dabc5f031c676bcaa1d", "src_set": ""}, "private": true, "genre": "art", "tipped": false, "creator_id": 3076971, "client_id": 0, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 129, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@y_gzzo/works/12", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/49368041/uploads/origins/d8a06f