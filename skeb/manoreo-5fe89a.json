-4384-8a2d-813ec857f93f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a560894d859c46d6bd0fc6ca46813b0d, https://si.imgix.net/319968e3/uploads/origins/3e2d43f4-7647-4384-8a2d-813ec857f93f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=73b156203b7fbd04e039662234841ab9 2x, https://si.imgix.net/319968e3/uploads/origins/3e2d43f4-7647-4384-8a2d-813ec857f93f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=329e1173fd5b3f96089e6ca03fc9a6b0 3x"}, "duration": null, "nsfw": true, "hardcore": true, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/319968e3/uploads/origins/3e2d43f4-7647-4384-8a2d-813ec857f93f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2b77363d13b8ab9fad09707a67bfda51", "srcset": "https://si.imgix.net/319968e3/uploads/origins/3e2d43f4-7647-4384-8a2d-813ec857f93f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2b77363d13b8ab9fad09707a67bfda51, https://si.imgix.net/319968e3/uploads/origins/3e2d43f4-7647-4384-8a2d-813ec857f93f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=97ca619a6819b0f9758079966cde8818 2x, https://si.imgix.net/319968e3/uploads/origins/3e2d43f4-7647-4384-8a2d-813ec857f93f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=2d2f55e39b2e0950c4e3359aefe7fa33 3x"}, "body": "中学生ぐらいのメガネかけた狼の子が不良に手を前側で拘束されてズボンを脱がされてパンツにうんちとおしっこをお漏らしするイラストをお願いしたいです。\n\n詳細ですが\n・足は開脚して前側が見える状態。\n・パンツは水色の縁で白地に水色の星柄のブリーフ\n・上半身はワイシャツの上に学ランで、学ランは前のボタンが全部空いていてワイシャツが見える状態\n・あとは、以下の差分とセリフを入れて欲しいです。\n\n1枚目\nズボンを脱がされてパンツが見える状態で\n狼「は、はなせ！パンツなら後で見せてやるから！なぁ！」\n不良「いつもクールな会長サマがこんなかわいらしいパンツ履いてるとはなぁ？」\n\n2枚目\nうんちとおしっこが出始めて、パンツの前におしっこのシミが少しできてお尻のほうが膨らみ始める\n狼「あっ……」\n\n3枚目\n恥ずかしいそうに涙目になりながらうんちとおしっこを漏らす\n不良「ハハッ！漏らしやがった！こんな歳でおもらしかよ、会長さんよぉ？」\n\n4枚目\n漏らし終えてパンツの中でちんちんが勃起している状態で\n不良「あ？なんか勃ってね？もらして興奮してんの？」\n狼「う、うるさい！」\n\n5枚目\n不良に手でうんちで膨らんだ部分を触れられて射精する\n狼「………ッ！」\n不良「おいおい、おもらしで興奮してイくとかとんだ変態じゃねぇか！」", "nc": 59, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@manoreo/works/1", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/062f1547/uploads/origins/16ed3549-86ee-4448-8a12-49cd57410e81?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=5b163a362cfaac6737f66af460e93e60", "srcset": "https://si.imgix.net/062f1547/uploads/origins/16ed3549-86ee-4448-8a12-49cd57410e81?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=5b163a362cfaac6737f66af460e93e60, https://si.imgix.net/062f1547/uploads/origins/16ed3549-86ee-4448-8a12-49cd57410e81?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=79e2834a657c7b019e1d9ad10302df93 2x, https://si.imgix.net/062f1547/uploads/origins/16ed3549-86ee-4448-8a12-49cd57410e81?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=a0a29f3a298a78de702b814dca597e83 3x"}, "private": true, "genre": "art", "tipped": false, "creator_id": 581526, "nc": 179}], "sent_works": [], "similar_creators": [{"id": 59316, "creator": true, "nsfw_acceptable": true, "acceptable": false, "name": "らくたぬ🐾関西けもケ J-03🐾", "screen_name": "ukkaritanuki", "avatar_url": "https://pbs.twimg.com/profile_images/2009299940682682368/GAkxDb-K.jpg", "header_url": "https://pbs.twimg.com/profile_banners/83356283/1692334418/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "c