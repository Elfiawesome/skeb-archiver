dpr=2&fit=crop&crop=top&w=200&h=200&s=14f9a32331600f861ac5c0ddfbf6f9de 2x, https://si.imgix.net/cac5dc33/uploads/origins/9a7c0f55-4920-4620-9a67-ebc431892746?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b5013a0a9bc1e626de23ba84c8ad63fe 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/cac5dc33/uploads/origins/9a7c0f55-4920-4620-9a67-ebc431892746?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e8e137618291980516dfc3e8283f2e99", "srcset": "https://si.imgix.net/cac5dc33/uploads/origins/9a7c0f55-4920-4620-9a67-ebc431892746?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e8e137618291980516dfc3e8283f2e99, https://si.imgix.net/cac5dc33/uploads/origins/9a7c0f55-4920-4620-9a67-ebc431892746?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=24fdbe60c4ccc1420b77c0eed540634c 2x, https://si.imgix.net/cac5dc33/uploads/origins/9a7c0f55-4920-4620-9a67-ebc431892746?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=1d09302e880b0b01f6f47915abb3f414 3x"}, "body": "こんにちは！あなたのこの作品が大好きです！https://skeb.jp/@matii_yuno/works/3 同じようなものを手に入れたいと思っていました。\n\nマルセル♂（180cm）・・・高貴な王。優しくて忍耐強く、笑顔で落ち着いていることが多い。氷の魔法を得意とし、レイピアを持つ。  普段は落ち着いているが、ビヤンは遊び心と表情豊かな一面を引き出す。モチーフは太陽、月、金属、氷、悲しみ、夜明け。そばかすとサークレットの冠が特徴。\n\nベイヤン ♂（178cm） - 若い頃はヒーローだったが、今は悪役として見られている少年。ずる賢く、自信家で、ドラマチック。火の魔法を持つ。三つ編みはオプション。マルセルをよくからかうが、彼に対してはとても優しい。モチーフは太陽、月、火、煙、星、金、裏切り。\n\n2人は幼なじみで、後に恋人同士になる。ふたりはとても温かく優しい愛で結ばれ、一緒に踊ったり笑ったりする。二人はお揃いの赤いクリスタルを持っている（マルセルの髪留めとビヤンの手）。\n\nhttps://drive.google.com/drive/folders/1ujpyXqWMb0xo-0zzdCnnL3tVMyZgtQeG", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@matii_yuno/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 913539, "vtt_url": null, "thumbnail_ima