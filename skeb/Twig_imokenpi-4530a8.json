0&h=200&blur=200&s=e9e82964ec990b03c37fe3220b25cfaa", "srcset": "https://si.imgix.net/d1709642/uploads/origins/0d05f7e0-02a2-4f12-8ccf-ced3d8d5f515?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e9e82964ec990b03c37fe3220b25cfaa, https://si.imgix.net/d1709642/uploads/origins/0d05f7e0-02a2-4f12-8ccf-ced3d8d5f515?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=e07ac6ff3e382016a34df05994f177bd 2x, https://si.imgix.net/d1709642/uploads/origins/0d05f7e0-02a2-4f12-8ccf-ced3d8d5f515?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=a056268a74b25a2b35353da34964c1c0 3x"}, "body": "はじめまして\nXなどで素敵な作品をたくさん見かけてskebも受けておられることに気付き、この度リクエストを送らせて頂きました｡\n\n依頼内容なのですがブルーアーカイブという作品に登場する生塩ノアちゃんがシャボン玉や風船を膨らませて遊んでいるといった内容でお願いします。\n細かい要望ですが\n・吹き棒で顔より一回り大きく球体のシャボンを膨らませている\n\n・周りにも大小様々な大きさのシャボンが複数飛んでいる\n\n・可能であれば膨らませているシャボン玉が絵に入るように描いて頂ければ幸いです\n\n・人が乗れるほど大きなシャボンの上に跨っている\n\n・可能であればシャボン玉は艶や質感を重視した描き方でお願い致します。\n\n・その他の細かな構図などはお任せいたします\n\n非常に細かい内容な上、拙い文面なのでもし不都合があればキャンセルして頂いても大丈夫ですので宜しければどうかご検討お願い致します。\n\nhttps://drive.google.com/file/d/1VBUKOYUnP-eHmKSInuaXB0IW_mWRugIk/view?usp=drivesdk", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Twig_imokenpi/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3679087, "client_id": 438366, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/e396db55/uploads/origins/2aeaff39-f537-4274-b451-da63ae59bc06?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b4bca88db575c659deea140239049485", "srcset": "https://si.imgix.net/e396db55/uploads/origins/2aeaff39-f537-4274-b451-da63ae59bc06?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b4bca88db575c659deea140239049485, https://si.imgix.net/e396db55/uploads/origins/2aeaff39-f537-4274-b451-da63ae59bc06?bg=%23fff&auto=format%2Ccompr