ボンを膨らませている\n\n・周りにも大小様々な大きさのシャボンが複数飛んでいる\n\n・可能であれば膨らませているシャボン玉が絵に入るように描いて頂ければ幸いです\n\n・人が乗れるほど大きなシャボンの上に跨っている\n\n・可能であればシャボン玉は艶や質感を重視した描き方でお願い致します。\n\n・その他の細かな構図などはお任せいたします\n\n非常に細かい内容な上、拙い文面なのでもし不都合があればキャンセルして頂いても大丈夫ですので宜しければどうかご検討お願い致します。\n\nhttps://drive.google.com/file/d/1VBUKOYUnP-eHmKSInuaXB0IW_mWRugIk/view?usp=drivesdk", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Twig_imokenpi/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3679087, "client_id": 438366, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/e396db55/uploads/origins/2aeaff39-f537-4274-b451-da63ae59bc06?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b4bca88db575c659deea140239049485", "srcset": "https://si.imgix.net/e396db55/uploads/origins/2aeaff39-f537-4274-b451-da63ae59bc06?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b4bca88db575c659deea140239049485, https://si.imgix.net/e396db55/uploads/origins/2aeaff39-f537-4274-b451-da63ae59bc06?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=64d7c70a11e8e18ee8e1b8c456031509 2x, https://si.imgix.net/e396db55/uploads/origins/2aeaff39-f537-4274-b451-da63ae59bc06?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=5717cd149cc9bc46a91871a6c36e9a25 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/e396db55/uploads/origins/2aeaff39-f537-4274-b451-da63ae59bc06?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=23b7b6d7fed5dd578889085845aec6b1", "srcset": "https://si.imgix.net/e396db55/uploads/origins/2aeaff39-f537-4274-b451-da63ae59bc06?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=23b7b6d7fed5dd578889085845aec6b1, https://si.imgix.net/e396db55/uploads/origins/2aeaff39-f537-4274-b