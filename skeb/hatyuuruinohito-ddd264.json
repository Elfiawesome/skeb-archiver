/uploads/origins/10313448-0826-49f3-a17f-897552fa868b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e2dadae5796759f2807fd4be8e83131d 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/78b5df26/uploads/origins/10313448-0826-49f3-a17f-897552fa868b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3a6e89389aa28857178dc381b625b6a3", "srcset": "https://si.imgix.net/78b5df26/uploads/origins/10313448-0826-49f3-a17f-897552fa868b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3a6e89389aa28857178dc381b625b6a3, https://si.imgix.net/78b5df26/uploads/origins/10313448-0826-49f3-a17f-897552fa868b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=385475f5f179367c413fe241253922fa 2x, https://si.imgix.net/78b5df26/uploads/origins/10313448-0826-49f3-a17f-897552fa868b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=3e1f263f15b0e72042b855ba425ec571 3x"}, "body": "にじ〇んじの雪〇眞尋ちゃんの催眠セックスシチュをお願いします！\n衣装、髪型はこちら\nhttps://twitter.com/MahiroYukishiro/status/1123583389397704704\n\n竿役は太ったバーコードハゲのおじさん\n三コマ漫画的な構図\n入れてほしいシチュエーション\n・催眠前\nバカにしたような表情で「はぁ？催眠とかかかるわけないじゃんｗ」\n五円玉の振り子で催眠をかけられている\n\n・キスした後、口を離した状態\n舌と舌が唾液でつながってる（唾液ブリッジ）\n女の子はとろーんとした表情\n真横からのアングルで顔部分だけのカットイン的な感じ\n\n・背面座位\nシャツをめくりあげておっぱい丸出し\nスカートもめくり上げていてパンツずらしハメ\nパンツは水色と白の縞模様\nおじさんの片方の手はおっぱいを鷲掴み、もう片方は乳首を指でくりくりして首筋をれろ～っと舐めている\nアヘ顔で瞳にハート\n大量に中田氏され精子があふれ出している\n\n三コマ同じ大きさではなく1・1・3ぐらいの比率\n背景は真っ白で大丈夫です\n\n注文が多くて申し訳ありませんが描いていただけたら嬉しいです！", "nc": 185, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@hatyuuruinohito/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 974415, "client_id": 427191, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/4475c6a7/uploads/origins/894ad38d-864a-4f98-bbed-a1f01efb422b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4f885efa2839df132d151fe6e9ee7e70", "srcset": "https://si.imgix.net/4475c6a7/uploads/origins/894ad38d-864a-4f98-bbed-a1f01efb422b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4f885efa2839df132d151fe6e9ee7e70, https://si.imgix.net/4475c6a7/uploads/origins/894ad38d-864a-4f98-bbed-a1f01efb422b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=4ff3c2bb0f8c3cee5d269f5a30323a5c 2x, https://si.imgix.net/4475c6a7/uploads/origins/894ad38d-864a-4f98-bbed-a1f01efb422b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=aaf362f32e7d2fb79e1d56c71c769bd2 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/4475c6a7/uploads/origins/894ad38d-864a-4f98-bbed-a1f01efb422b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5a13dfcecbed75703a41416faeabe79f", "srcset": "https://si.imgix.net/4475c6a7/uploads/origins/894ad38d-864a-4f98-bbed-a1f01efb422b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5a13dfcecbed75703a41416faeabe79f, https://si.imgix.net/4475c6a7/uploads/origins/894ad38d-864a-4f98-bbed-a1f01efb422b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=e195e6b2363b3cbf32f614986573ed5e 2x, https://si.imgix.net/4475c6a7/uploads/origins/894ad38d-864a-4f98-bbed-a1f01efb422b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=c0d86995672786cae21b6c3eaedd634f 3x"}, "body": "前回は素晴らしいクレアさんをありがとうございました。今回は竜胆尊さんをお願いします。\n衣装　新衣装　資料URLの一枚目のジャケットと尻尾無し\nシチュ\n罰ゲームでリモコンバイブを付けて目的地まで移動する事になった竜胆尊が電車に乗った所痴漢グループに遭遇してしまい、複数人に両手を掴まれ胸を揉まれたりお尻を触られたり股間を弄られローターの存在がバレて振動の強さを最大に上げられたりして何度も無理やり絶頂させられる所をお願します\n他\n・痴漢の男の描写は最低限の人影と手とセリフ等の最低限で大丈夫です。\n・痴漢グループは女性の絶頂する所が好きな集団という集まりでお願いします\n・ローターのリモコンは左足ふとももにあるベルトの所に設置してください\n・ローターがバレた際これは罰ゲーム中でっ！などのセリフをお願いします\n\nよろしくお願いします\n\nhttps://twitter.com/RindouMikoto/status/1429782881656655876", "nc": 168, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@hatyuuruinohito/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 974415, "client_id": 347662, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/b7cf13c1/uploads/origins/ea6febbe-fb1c-4c74-9349-d818cc6fc5f7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=40839d418c1663cf47ad8c626adf1417", "srcset": "https://si.imgix.net/b7cf13c1/uploads/origins/ea6febbe-fb1c-4c74-9349-d818cc6fc5f7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=40839d418c1663cf47ad8c626adf1417, https://si.imgix.net/b7cf13c1/uploads/origins/ea6febbe-fb1c-4c74-9349-d818cc6fc5f7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=52ba48218462e978ebaabaf946f32f25 2x, https://si.imgix.net/b7cf13c1/uploads/origins/ea6febbe-fb1c-4c74-9349-d818cc6fc5f7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=1275c33e164c4e3a2a0071cd5f82e8ff 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/b7cf13c1/uploads/origins/ea6febbe-fb1c-4c74-9349-d818cc6fc5f7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0daf0b3a60d7c0ff76c760ba3e8d11d5", "srcset": "https://si.imgix.net/b7cf13c1/uploads/origins/ea6febbe-fb1c-4c74-9349-d818cc6fc5f7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0daf0b3a60d7c0ff76c760ba3e8d11d5, https://si.imgix.net/b7cf13c1/uploads/origins/ea6febbe-fb1c-4c74-9349-d818cc6fc5f7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=af59686cb33f1aaaa7288d6bef7fb258 2x, https://si.imgix.net/b7cf13c1/uploads/origins/ea6febbe-fb1c-4c74-9349-d818cc6fc5f7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=923d4960111964765e30f02516f5db49 3x"}, "body": "こんにちは、はじめまして。\nいつも素晴らしいイラストでお世話になっております。\n\n以前描かれていたヴァルコネ衣装リゼ様がとってもえろかったのでリクエストをお願いしたいです。\n\n対象：戌亥とこ\n衣装：ヴァルキリーコネクトコラボ衣装（恐らく邪魔なので注連縄は不要です\n参考URL：https://twitter.com/inui_toko/status/1414208749275783169?s=20\n\nシチュエーションとしては\n過去絵で苗床にされたリゼ様を助けに来た戌亥だが\n苗床にされたリゼを見て発情し、少し楽しんでからでも大丈夫と考え\n余裕で倒せる相手にわざと敗北し、少しだけのつもりが苗床として完堕ちしてしまうような感じで。\n\n構図はお任せいたします。", "nc": 57, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@hatyuuruinohito/works/4", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/1b0a9069/uploads/origins/62dbc7d3-e750-40d4-aa29-644a28e546b3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=a1d439aca3d930a7d4dd7c8890b5d59f", "srcset": "https://si.imgix.net/1b0a9069/uploads/origins/62dbc7d3-e750-40d4-aa29-644a28e546b3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=a1d439aca3d930a7d4dd7c8890b5d59f, https://si.imgix.net/1b0a9069/uploads/origins/62dbc7d3-e750-40d4-aa29-644a28e546b3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=b796a39680d81683a103a6375e01e967 2x, https://si.imgix.net/1b0a9069/uploads/origins/62dbc7d3-e750-40d4-aa29-644a28e546b3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=82023aa07f3fed5d98f19f215e19dcc3 3x"}, "private": true, "genre": "art", "tipped": true, "creator_id": 974415, "client_id": 124783, "nc": 161}, {"path": "/@hatyuuruinohito/works/3", "private_thumbnail_image_urls": null, "private