ご注意頂きたい点:\n女の子はアホ毛が生えてます。とっても陽気な性格してます。\n男の子は少し天パで、片側のもみあげが長め。右目下にほくろあり。ひかえめな性格をしていて、いつも上の空。\n2人の身長差は17センチ。\n\n普段の付き合い方:\n猫系男子x犬系女子\n女の子はとってもパワフルな子。\n男の子普段は無口で無気力だが、時々女の子と痴話げんかをする。今の関係は恋人。\n\n以下の服装で好きなものを選んで描いてください！背景、構図は全部秋月かづ様にお任せします。\n\nどうぞご検討よろしくお願い致します！\n\nhttps://glowing-grey-386.notion.site/Daily-4aad5c75d1b84ebbae11958998115fb9", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [{"path": "/@cosmos211/works/45", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1213577, "client_id": 3207967, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/827fbce1/uploads/origins/7b21755f-f729-4da2-b543-767e70b69320?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=58ab18de3198db4783f7c4a7eac25e3d", "srcset": "https://si.imgix.net/827fbce1/uploads/origins/7b21755f-f729-4da2-b543-767e70b69320?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=58ab18de3198db4783f7c4a7eac25e3d, https://si.imgix.net/827fbce1/uploads/origins/7b21755f-f729-4da2-b543-767e70b69320?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=655503fa7925beb4576816e2015a1ded 2x, https://si.imgix.net/827fbce1/uploads/origins/7b21755f-f729-4da2-b543-767e70b69320?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=38ee1c7e0f5fa3deab59a235cf237b6c 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/827fbce1/uploads/origins/7b21755f-f729-4da2-b543-767e70b69320?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5db93cbf675f6bee419bc8330aa94125", "srcset": "https://si.imgix.net/827fbce1/uploads/origins/7b21755f-f729-4da2-b543-767e70b69320?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5db93cbf675f6bee419bc8330aa94125, https://si.imgix.net/827fbce1/uploads/or