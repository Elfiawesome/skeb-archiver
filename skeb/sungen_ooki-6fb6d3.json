レキシュガル（元は遠坂凛）、茶髪だがエヴァのアスカ・ラングレー等。\n\n●身体特徴\n大学2年、20歳。\n168cm、54kg、B92(F70)W63H90、やや痩せ型\n\n●印象や性格\n見た目清楚なお嬢様として猫を被って振る舞うが親しい友人との交遊はアクティブ。\n意中の男性には積極的に話しかけるも、若干のツンデレ気味な行動で機会逸することも…\n\nhttps://imgur.com/a/iXPBMwl", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 1137565, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "七月", "screen_name": "uuuusatama", "avatar_url": "https://pbs.twimg.com/profile_images/1750456735268298752/jzpUpkv-.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1382566100936781825/1706250438/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 10, "complete_expiration_days": 30, "skills": [{"genre": "art"}], "nc": 128}, {"id": 1250438, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "もちたろ。", "screen_name": "mothitarOO", "avatar_url": "https://pbs.twimg.com/profile_images/1926649534056124416/PPsrMsEm.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1356374408852500480/1762900062/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 5, "complete_expiration_days": 30, "skills": [{"genre": "art"}, {"genre": "correction"}], "nc": 0}, {"id": 2053638, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "🦊狐山 槻(ケヤキ)🦊", "screen_name": "keyki_izumo0426", "avatar_url": "https://pbs.twimg.com/profile_images/1376909209594261507/NRwIIG6Z.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1208670230467108864/1649571866/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "acce