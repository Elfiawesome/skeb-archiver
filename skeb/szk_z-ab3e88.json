lient_visible": false, "total_appeals_count": 0, "received_works": [{"path": "/@szk_z/works/11", "private_thumbnail_image_urls": null, "private": false, "genre": "comic", "tipped": false, "creator_id": 10772, "client_id": 727402, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/57a1f218/uploads/origins/f1efbff2-2584-4a22-850d-6b2798cc7952?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c737c293ec4ce539d3d5edaa3f277fa0", "srcset": "https://si.imgix.net/57a1f218/uploads/origins/f1efbff2-2584-4a22-850d-6b2798cc7952?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c737c293ec4ce539d3d5edaa3f277fa0, https://si.imgix.net/57a1f218/uploads/origins/f1efbff2-2584-4a22-850d-6b2798cc7952?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=d1aea8f64df52922a519cd87e9d0141e 2x, https://si.imgix.net/57a1f218/uploads/origins/f1efbff2-2584-4a22-850d-6b2798cc7952?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a14f5a758a3e951a0dd7239c6f9d4dc7 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/57a1f218/uploads/origins/f1efbff2-2584-4a22-850d-6b2798cc7952?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3a209bfda160f579ed52d19f8c1f9bd7", "srcset": "https://si.imgix.net/57a1f218/uploads/origins/f1efbff2-2584-4a22-850d-6b2798cc7952?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3a209bfda160f579ed52d19f8c1f9bd7, https://si.imgix.net/57a1f218/uploads/origins/f1efbff2-2584-4a22-850d-6b2798cc7952?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=e0b349ec8a0e96d60253945f837c7ced 2x, https://si.imgix.net/57a1f218/uploads/origins/f1efbff2-2584-4a22-850d-6b2798cc7952?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=e3f4c7006e1de6182f306d7e0caa350d 3x"}, "body": "こんにちは。ややこしくて申し訳ありません 。先生の漫画をTwitterで拝見して、本当に美しくて憧れます。詳細な世界観はコメント欄にています！\n依頼:\nマンガが欲しいです！\n内容の参考:\n覚の来歴が欲しいです。（コメント欄にています）\nキャラクターの性格に補足を加えたいと思います。\n白銀覚は一見すると明るく社交的で、誰とでもすぐに打ち解けられる「人たらし」な一面を持つ。\n困っている人には親身になって手を差し伸べる優しさもあり、周囲からの信頼も厚い。\nしかしその本質は、強い信仰心を持つ教団の執行者であり、\n「救済」のためには手段を選ばない冷酷さと計算高さを秘めている。\n薬学の知識を用いて、相手に気づかれないように精神をコントロールすることさえ可能。\n笑顔の裏には、静かで緻密な狂気が潜んでいる。\n（十字架や教会などのキリスト教的な要素は使わないでください。彼が属するのはそのような宗教ではなく、冥界神を信仰する教団です。イメージとしては、蛇、骨、彼岸花などが関連する要素です。）\n言葉遣い\nカラウド：丁寧な口調。一人称：私\nエンゴル:  一人称：俺\nお互いに名前の呼び方\n覚 →ラヴェル：劇団長\n覚 →エンゴル：エンゴルさん\nラヴェル→覚：覚君\nキャラのセリフに関しては、先生にお任せしようと思います。\n人物设计: \nhttps://x.com/liannaliang/status/1877266148208554169?s=46&t=YZaXLiwfVjeL4BItTrjUlQ\n\n何卒宜しくお願い致します。", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@szk_z/works/10", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/89b3087d/uploads/origins/3be42451-9cbe-400b-9e1e-495c2852a2bc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=e06dbd9e1cb078c99a2aa1f2094b61e1", "srcset": "https://si.imgix.net/89b3087d/uploads/origins/3be42451-9cbe-400b-9e1e-495c2852a2bc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=e06dbd9e1cb078c99a2aa1f2094b61e1, https://si.imgix.net/89b3087d/uploads/origins/3be42451-9cbe-400b-9e1e-495c2852a2bc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=373f389e75ad9f70cda5a7c81788ea0c 2x, https://si.imgix.net/89b3087d/uploads/origins/3be42451-9cbe-400b-9e1e-495c2852a2bc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=0e9707e3e8a21391326b3e07569a5457 3x"}, "private": true, "genre": "comic", "tipped": false, "creator_id": 10772, "nc": 144}, {"path": "/@szk_z/works/9", "private_thumbnail_image_urls": null, "private": false, "genre": "comic", "tipped": false, "creator_id": 10772, "client_id": 727402, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/2f62a6e4/uploads/origins/c03cd0cc-4eaf-429c-aafb-6f8e5402aa79?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=04c5b63ef5ce4b2455bcb21f85ab217c", "srcset": "https://si.imgix.net/2f62a6e4/uploads/origins/c03cd0cc-4eaf-429c-aafb-6f8e5402aa79?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=04c5b63ef5ce4b2455bcb21f85ab217c, https://si.imgix.net/2f62a6e4/uploads/origins/c03cd0cc-4eaf-429c-aafb-6f8e5402aa79?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=16550f5cbe72941a9e938ecf2ac69880 2x, https://si.imgix.net/2f62a6e4/uploads/origins/c03cd0cc-4eaf-429c-aafb-6f8e5402aa79?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=4281b33a00f7a2368b51725145273b92 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/2f62a6e4/uploads/origins/c03cd0cc-4eaf-429c-aafb-6f8e5402aa79?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=af2695c0cb9906e9b245578f423c82af", "srcset": "https://si.imgix.net/2f62a6e4/uploads/origins/c03cd0cc-4eaf-429c-aafb-6f8e5402aa79?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=af2695c0cb9906e9b245578f423c82af, https://si.imgix.net/2f62a6e4/uploads/origins/c03cd0cc-4eaf-429c-aafb-6f8e5402aa79?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=a4d3dec853c85836b56d2e29059606d4 2x, https://si.imgix.net/2f62a6e4/uploads/origins/c03cd0cc-4eaf-429c-aafb-6f8e5402aa79?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=cb90838a68a610935f26d1aa9c5f5aee 3x"}, "body": "こんにちは。ややこしくて申し訳ありません 。先生の漫画をTwitterで拝見して、本当に美しくて憧れます。詳細な世界観はコメント欄にています！前回の内容は漫画劇団編を読んでください。https://drive.google.com/drive/mobile/folders/1irAHqpUKI_NJUm7gWRWsxH1KsjZfmyJT\n依頼:\nマンガが欲しいです！\n内容の参考: \nーエンゴルの自白:\n「幼い時期」子供の時、村のみんなはいい子って褒めてくれた、厳しい父親と優しい母親を持ってて、毎日幸せに暮らしていた。あ、、、でもなぜ？みんな死んだんだろう？まぁいいや、思い出せないや、それより、その後ラヴェルに会ったんだ、あの星のような男に。  精神疾患を持ってるから操りやすいって、ラヴェルに思われたみたい、大丈夫、病があってもなくても、ラヴェルから離れないから。  \n成人後: 劇団の中の子供はみんな脆いな、ちょっと遊んであげただけなのに、知らぬ間に死んちゃったじゃん。ライスリーの指輪って、ラヴェルから貰った演出のお祝いプレゼントだっけ？僕にはあげてないのに。う、、、悔しい、、、奪い取ればいいよね。 エレナの薬をビタミンに変えただけで、幻覚を見て飛び降りたらしい。はは、面白いな。 なぜオルタはラヴェルにあんなに近いんだ？台本作家だからって言ってラヴェルといっぱい話せるなんて理不尽だろう！邪魔くさい、、、、 ラヴェル、ずっと君だけを追いかけてきた。星に近づこうとしてる影はみんな僕が取り除くよ、僕だけの星になってくれることをこんなに望んでるからさ。 「処刑される時」最後の最後で、君に裏切られた、僕は所詮この程度だってことだよな。こめんな、君に似合う存在になれなくて。待ってよ、なんなんだその表情は？ああ、、、そうか、、、僕は愛されていたんだ、、、ラヴェル、愛してる、ずっといるから、君の側に、、、、\n言葉遣い\nエンゴル：丁寧な口調。一人称：私\nラヴェル：チャラい口調。一人称：私\nお互いに名前の呼び方\nエンゴル→ラヴェル：ラヴェルさん\nラヴェル→エンゴル：エンちゃん\nキャラのセリフに関しては、先生にお任せしようと思います。\n人物设计: https://x.com/liannaliang/status/1725085990895890840?s=46&t=YZaXLiwfVjeL4BItTrjUlQ\n\n人物（幼年）设计:\nhttps://drive.google.com/drive/folders/1A5Z0BA_8E1wX8qEKEted0Nzi5kr4riZP\n\n※ほか以外は全部名前呼びです。\n何卒宜しくお願い致します。", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@szk_z/works/8", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 10772, "client_id": 326249, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/7275c49a/uploads/origins/dca286de-0b3a-4f85-b01f-866045ab906f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b70af741eb2577aa59a8861477b2631d", "srcset": "https://si.imgix.net/7275c49a/uploads/origins/dca286de-0b3a-4f85-b01f-866045ab906f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b70af741eb2577aa59a8861477b2631d, https://si.imgix.net/7275c49a/uploads/origins/dca286de-0b3a-4f85-b01f-866045ab906f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=376d35f9c427d54e9a088ab8988c4949 2x, https://si.imgix.net/7275c49a/uploads/origins/dca286de-0b3a-4f85-b01f-866045ab906f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=0a76d3d14dd0524d6685c3ec4ea3db93 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/7275c49a/uploads/origins/dca286de-0b3a-4f85-b01f-866045ab906f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=39c03ffe132426c92dc697ac8acd16de", "srcset": "https://si.imgix.net/7275c49a/uploads/origins/dca286de-0b3a-4f85-b01f-866045ab906f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=39c03ffe132426c92dc697ac8acd16de, https://si.imgix.net/7275c49a/uploads/origins/dca286de-0b3a-4f85-b01f-866045ab906f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=ee576dfa7fa174d9a2d867311a0bb0c2 2x, https://si.imgix.net/7275c49a/uploads/origins/dca286de-0b3a-4f85-b01f-866045ab906f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=62410ecd8597f6cecc2700cb612d9aec 3x"}, "body": "先生、こんにちは！Skebを再開されたとのことで、とても嬉しいです！ \n今回はノーマッドとアルタラのアートワークをお願いしてもいいですか？\n\n舞台はファンタジーの世界です。  \n\n* ノーマッド：18歳の少年。身長180cm。太い眉毛と素直で子犬のような目が特徴。自分に厳しく厳しいが、友人（特にアルタラ）には温かく優しい。アルタラとは幼なじみ。ノーマッドはアルタラへの想いが家族以上のものであることを知っている。アルタラがより大きな運命に執着していることを知っているため、ノーマッドは自分の気持ちをアルタラに告げず、アルタラのそばにいてアルタラのために身を捧げることに喜びを感じている。ノーマッドは過剰なまでの自己犠牲の美徳を持ち、強い道徳的良心も持っているが、アルタラが必要なときに他人の命を奪うことができないと知ったとき、この2つの特徴が最悪の結果を形成する。だからノーマッドが彼のために殺人を行う。このことが彼の内面を徐々に破壊していく。  \nノーマッドの最大の願いは、アルタラが幸せになるのを見ることだ。アルタラの笑顔を見るのが大好きなのだ。  \n\n*アルタラ：銀の髪、銀のまつげ、紫の瞳を持つ17歳の少年。アルタラの目は柔らかい形をしている。共感力があり、好奇心旺盛。身長は172cm。神話に登場する紫の瞳の魔道士だが、その力をコントロールするのが難しい。現在はエレメンタル・マジックの正しい使い方を学ぶ旅に出ている。子供のころはノーマッドに頼りきりだったが、次第に自立するようになった。  \n\nすみれ色の瞳の魔道士は常に極度の感情で動くが、アルタラも例外ではない。ノーマッドの存在は彼に多くの情緒的安定を与え、彼はノーマッドを家族、親友、家族、そしてその存在が呼吸をするように自然な人と見ている。しかし、ノーマッドの自滅願望を見抜くことはできなかった（おそらく、このように見るのは不本意だったのだろう）。 \n\n\n私の依頼：   \nアルタラがノーマッドの腕を持ち、彼の下腕の内側の皮膚に指を沿わせるのを見たい。アルタラは前傾姿勢で、唇にかすかな微笑みを浮かべている。「私があなたの命綱になりますよ 」と言っているかのようだ。 \n\nモノクロ（白黒）で描いていただけるとうれしいです。 \n\n\n自由に描いてください！ \nいつもながら、本当にありがとうございます> <♥。\n\nhttps://drive.google.com/drive/folders/1-_qZdBiVePV8nzgM3PQsl8YW2mZ7xrCF", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@szk_z/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 10772, "client_id": 727402, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/7967e0c5/uploads/origins/505b50de-b714-4aaa-a685-4deb79bceb90?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4cf2981889891ba01f2632c9c61b9c7f", "srcset": "https://si.imgix.net/7967e0c5/uploads/origins/505b50de-b714-4aaa-a685-4deb79bceb90?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4cf2981889891ba01f2632c9c61b9c7f, https://si.imgix.net/7967e0c5/uploads/origins/505b50de-b714-4aaa-a685-4deb79bceb90?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=8086a16cb702ea3f66f254b178b2da5f 2x, https://si.imgix.net/7967e0c5/uploads/origins/505b50de-b714-4aaa-a685-4deb79bceb90?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d2837cd25ac53783db9389efaa468323 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/7967e0c5/uploads/origins/505b50de-b714-4aaa-a685-4deb79bceb90?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d8e83bff266a2836f629d3109919e524", "srcset": "https://si.imgix.net/7967e0c5/uploads/origins/505b50de-b714-4aaa-a685-4deb79bceb90?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d8e83bff266a2836f629d3109919e524, https://si.imgix.net/7967e0c5/uploads/origins/505b50de-b714-4aaa-a685-4deb79bceb90?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=194f0e046e58a7c2d8c4bc0f0353866d 2x, https://si.imgix.net/7967e0c5/uploads/origins/505b50de-b714-4aaa-a685-4deb79bceb90?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=a2227b6bd75bed1dbabcbe73d637932a 3x"}, "body": "こんにちは。ややこしくて申し訳ありません 。Suzke先生の漫画が好きです！前回の内容が漫画5を読んでください。https://drive.google.com/drive/mobile/folders/1irAHqpUKI_NJUm7gWRWsxH1KsjZfmyJT\n依頼:\nマンガが欲しいです！\n内容の参考:\nラヴェルの注意で、ミカエルが自分の使命を思い出し、神様はまだ生きていると、自分を無理矢理に信じさせる。人々が失われた信仰を蘇るために、二人は天界に旅を立て、多くの人を支えていた。迷っている人間はミカエルの服を掴む。山ほどのストレスで、ミカエルはもはや限界になって、偏執の人になった。ある場所に着いたとき、「人間は神の手から運命を取り戻す」と言い、初代の魔王・ソリットを讃える人を見かけた。魔界を憎む天族の中で、これは相当珍しい行動だった。ミカエルがソリットの写真を見ると、過去の記憶が浮かんでいた。あれは「愛」という気持ちだ。だが、この気持ちはすぐ憎しみに圧倒された。「僕に全てを与えたのに、どうして全てを奪ったのか？ほら、神様がいなくても、人間は苦痛に堕ちて、永遠に救われなく、永遠に罪の中に生きる。人間の存在自身はそもそも汚いものだ。」ミカエルはすぐ、あの人の極刑を宣告した。神を裏切る人は絶滅される。ミカエルは刀をしっかり握って、憎しみの瞳に涙が流れている。「ソリット、あんたに歪められたものを全て、軌道に戻す！」日日に歪んでいくミカエルの様子を見て、ラヴェルが微笑んで涙を流して去った。三人の関係はもう過去に戻るな。\n言葉遣い\nミカエル：丁寧な口調。一人称：私\nラヴェル：チャラい口調。一人称：私\nお互いに名前の呼び方\nラヴェル→ミカエル：ミカ\nキャラのセリフに関しては、先生にお任せしようと思います。\n人物设计: https://twitter.com/liannaliang/status/1619970178372239360?s=46&t=IyZ-bZXC0Qa_DRtlAkMxRw\n※ほか以外は全部名前呼びです。\n何卒宜しくお願い致します。", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@szk_z/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 10772, "client_id": 326249, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/acd0fcc0/uploads/origins/9c7e7a73-bb2a-4c72-874c-c74ee6e5b921?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ddeb11e4625fd7fedf30d14dd96ea944", "srcset": "https://si.imgix.net/acd0fcc0/uploads/origins/9c7e7a73-bb2a-4c72-874c-c74ee6e5b921?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ddeb11e4625fd7fedf30d14dd96ea944, https://si.imgix.net/acd0fcc0/uploads/origins/9c7e7a73-bb2a-4c72-874c-c74ee6e5b921?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=9ee77f14453d16750ae3c729b1a98d41 2x, https://si.imgix.net/acd0fcc0/uploads/origins/9c7e7a73-bb2a-4c72-874c-c74ee6e5b921?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=cf5cb15d9b9bc0304919f710eef124dd 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/acd0fcc0/uploads/origins/9c7e7a73-bb2a-4c72-874c-c74ee6e5b921?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=62a4bc057185c54fa4061199cbd8d46d", "srcset": "https://si.imgix.net/acd0fcc0/uploads/origins/9c7e7a73-bb2a-4c72-874c-c74ee6e5b921?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=62a4bc057185c54fa4061199cbd8d46d, https://si.imgix.net/acd0fcc0/uploads/origins/9c7e7a73-bb2a-4c72-874c-c74ee6e5b921?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=bc6e633d1c787d5b57e818cbad8641c5 2x, https://si.imgix.net/acd0fcc0/uploads/origins/9c7e7a73-bb2a-4c72-874c-c74ee6e5b921?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=f7fd59361f85e78f4f5ca4e1a26c3686 3x"}, "body": "先生、こんにちは！また私のOCの絵をお願いすることは可能でしょうか？  \n\n舞台はファンタジーの世界です。  \n\n*\nノーマッド：17歳の少年。身長176cm。太い眉毛と素直で子犬のような目が特徴。自分に厳しく厳しいが、友人（特にアルタラ）には温かく優しい。アルタラとは幼なじみ。ノーマッドはアルタラに対する自分の気持ちが家族以上のものであることを知っており、罪悪感を感じている。アルタラがより大きな運命に執着していることを知っているため、ノーマッドは自分の気持ちをアルタラに告げず、アルタラのそばにいてアルタラのために身を捧げることに喜びを感じている。ノーマッドは自己破壊的な性格で、強い道徳的良心も持っているが、アルタラが必要なときに他人の命を奪うことができないと知ったとき、この2つの特徴が最悪の結果を生む。だからノーマッドが彼のために殺人を行う。このことが彼の内面を徐々に破壊していく。 \nノーマッドは19歳で死ぬ。アルタラは彼に別れを告げることができなかった。 \n\nアルタラ：銀色の髪、銀色のまつげ、紫色の瞳を持つ15歳の少年。身長は169cm。神話に登場するバイオレットアイの魔道士だが、その力をコントロールするのが難しい。エレメンタル・マジックの正しい使い方を学ぼうと、仲間とともに他の4種族が支配する王国を旅している。幼いころはノーマッドに頼りきりだったが、次第に自立するようになった。\nすみれ色の瞳の魔道士は常に極度の感情で動くが、アルタラも例外ではない。ノーマッドの存在は彼に多くの安らぎと感情の安定を与え、ノーマッドを家族のように思っている。しかし、ノーマッドの自己破壊願望を見ることはできなかった（このように見るのは不本意だったのかもしれない）。\n\n\n*\nノーマッドが初めてアルタラのために殺すところを見たい。城跡で仲間とはぐれ、敵に出くわした。敵は同じ年頃に見える人間の少年魔道士で、無慈悲に二人に襲いかかった。アルタラは彼が催眠術にかかっているのがわかり、解こうとしたが失敗した。ノーマッドとアルタラは反撃するしかなく、最後は魔道士を殺すしかなかった。アルタラは一歩前に進み、魔力を使って銀の刃を形成したが、両親のつらい死の記憶が脳裏をよぎり、手が抑えきれずに震え始めた。刃を持ち上げては下ろし、この動作を何度か繰り返したが、震えは止まらず、殺すことへの反発も止まらなかった。できなかったのだ。目を閉じ、手を下ろし、これで終わりにしようとしたとき、突然、心地よい温もりが彼の手を包んだ。ノーマッドは優しく、安心させるように微笑んでいた。「大丈夫だよ、アル。無理しなくていいんだ」。ノーマッドは優しく言った。魔法で作られた銀の刃が一瞬揺らぎ、消えた。アルタラはノーマッドが自分から背を向け、もがいている敵に向かって歩き、自分のナイフで最後の一撃を加えるのを見た。彼は名状しがたい感情に包まれた。ノーマッドが戻ってきて、「どうした、アル？アルタラは自分の顔に涙が流れていることに気づいた。しかし、自分のために泣いているのではなく、ノーマッドのために泣いていたのだ。彼の思いはただ一つ： 「私のために殺してくれてごめんなさい」。アルタラは力強く首を振ったが、何も言わなかった。ノーマッドは自分のしたことに動じる様子もなく、血のついていないほうの手でアルタラの涙をぬぐった。「行きましょう」と優しく言うと、アルタラはしびれを切らして彼に従った。\n\nその夜、森の中でキャンプを張ったノーマッドは、アルタラがすでに眠ったのを確認すると、よろよろとキャンプの外に出た。彼は一番近い川まで走り、涙と息苦しさの限りを尽くして嘔吐した。罪のない人を殺したというイメージがノーマッドの心に深く刻まれ、この先も多くの罪を背負うことになるだろうと予感した。彼の手はまだら模様もなくきれいだったが、とても汚く感じた。彼はとても汚く感じ、これまで以上に自分を卑下した。しかし、だからといってやめるつもりはなかった。アルタラにすべてを捧げる覚悟はできていたからだ。\n\n\nマンガの構成は先生にお任せします！自由に描いてください。いつも本当にありがとうございます> <♥!!\n\n報酬額が適切でない場合は、遠慮なく調整してください。\n\nhttps://drive.google.com/drive/folders/1-_qZdBiVePV8nzgM3PQsl8YW2mZ7xrCF", "nc": 137, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@szk_z/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 10772, "client_id": 1054063, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/5960aaf6/uploads/origins/4c2c2474-86e4-4bc2-9e18-eb55d979b8ff?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=70728c966552a7ab3f1dca95aa25304e", "srcset": "https://si.imgix.net/5960aaf6/uploads/origins/4c2c2474-86e4-4bc2-9e18-eb55d979b8ff?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=70728c966552a7ab3f1dca95aa25304e, https://si.imgix.net/5960aaf6/uploads/origins/4c2c2474-86e4-4bc2-9e18-eb55d979b8ff?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=4586939da6c8cdde468ec72b580665e6 2x, https://si.imgix.net/5960aaf6/uploads/origins/4c2c2474-86e4-4bc2-9e18-eb55d979b8ff?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=6ade9d796068e488dcd0ec7346157cf1 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/5960aaf6/uploads/origins/4c2c2474-86e4-4bc2-9e18-eb55d979b8ff?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=fcf27aafc7f177637972578e67751411", "srcset": "https://si.imgix.net/5960aaf6/uploads/origins/4c2c2474-86e4-4bc2-9e18-eb55d979b8ff?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=fcf27aafc7f177637972578e67751411, https://si.imgix.net/5960aaf6/uploads/origins/4c2c2474-86e4-4bc2-9e18-eb55d979b8ff?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=59992dbb90e83cde96819c972c36588d 2x, https://si.imgix.net/5960aaf6/uploads/origins/4c2c2474-86e4-4bc2-9e18-eb55d979b8ff?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=c6057588e4378c06f1d4e8aea390e5f9 3x"}, "body": "Hello ！！I really like your works so I want to commission these two characters together again！The background is doomsday.They are not a couple！！more like partners but actually they hate each other...the girl named Berry is 19 years old，as an escaping government weapon；the male named Vincent is 28 years old who retired from special troops and has ptsd.\n我想看到两人在安静的夜晚郊区聊电影。莓问文森特喜欢看什么电影，文森特回答是和小动物有关，却被莓嘲笑了。她一边随意地玩着蝴蝶刀一边听他继续说。文森特看向天空，说自己很喜欢忠犬八公这部电影，看一次就会哭一次。莓的表情没太大变化，看起来对文森特的真心话不太上心，接话道：可惜现在没电影院和动物给你看了。只能在回忆里看了。他们沉默了一会儿，文森特又开始擦拭枪械，说大概吧，不然我真想看你哭的样子，然后拍下来嘲笑你。莓反问，你就这么确定我会哭？文森耸肩，说不信拉倒。莓折叠好她的蝴蝶刀，以头枕进双手的放松姿势躺在地上。她准备睡了。与此同时，文森特露出了苦笑，转向不远处已经被感染的动物尸体。他对它合上双掌，同时对莓和它无声地说：晚安。\nyou can draw freely refer to above story！\nreference：  https://drive.google.com/drive/folders/1p2e7II6fC6bu3m1NWvmGpXNnlLeJ1Yzi", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_gen