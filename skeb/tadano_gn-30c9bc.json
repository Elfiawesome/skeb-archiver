ress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=1685c14e89ea0f0c6477802c57479262 3x"}, "body": "こんにちは、私は本当にあなたのスタイルが大好きです！\n\nmyTRPGPCのイラストをお願いしたいです。\n\nキャラクターの詳細はドキュメントにあります。  \nもしよろしければ、どんな構図でも構いません！\n\nありがとうございました！\n\n参考\nhttps://drive.google.com/drive/folders/1K0uM4M7wYvyQxMevvekvK3XKK6Dyz1nj?usp=sharing", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@tadano_gn/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2677778, "client_id": 2368804, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/a744a860/uploads/origins/1e8bedf6-8980-4343-bb29-5dfa1874e96e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=498353c457753c288404c1dde9ecf47f", "srcset": "https://si.imgix.net/a744a860/uploads/origins/1e8bedf6-8980-4343-bb29-5dfa1874e96e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=498353c457753c288404c1dde9ecf47f, https://si.imgix.net/a744a860/uploads/origins/1e8bedf6-8980-4343-bb29-5dfa1874e96e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=489ecb5cc65b0337b6b7a1766dbf7eff 2x, https://si.imgix.net/a744a860/uploads/origins/1e8bedf6-8980-4343-bb29-5dfa1874e96e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=cff6c829adabe08e997831eb1ab5d0c8 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/a744a860/uploads/origins/1e8bedf6-8980-4343-bb29-5dfa1874e96e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b6cd23bffc6b486bf17db506e381acd9", "srcset": "https://si.imgix.net/a744a860/uploads/origins/1e8bedf6-8980-4343-bb29-5dfa1874e96e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b6cd23bffc6b486bf17db506e381acd9, https://si.imgix.net/a744a860/uploads/origins/1e8bedf6-8980-4343-bb29-5dfa1874e96e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=89819f8dcf5873c7bc9d1ea2182f01e6 2x, https://si.imgix.net/a744a860/uploads/origins/1e8bedf6-8980-4343-bb29-5dfa1874e96e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=197cf3145c047f0b16625610e1b3735f 3x"}, "body": "先生、はじめまして！  先生のイラストの雰囲気がとても好きです。私と友達のocをリクエストしてもいいですか？\n\n血とか危険な構図OKです！他の衣装でもOKです！自由に描いてください\n\n設定：終末後の世界。彼らは金網の檻に守られた街に住んでいて、中はマフィアのようなシステムが運営する古い西部劇のような街。外は廃墟だらけの黙示録的世界。フォルダ内の他の設定を描くのも、新しい設定を作るのも自由！\n\nレン】170cm\n- ボディガードのような役割で、生物学者が「死んだ」時に街に連れ戻すのが仕事。\n- ニヒリスティックでシニカル、スリルを求める男。結果がどうであれ、やりたいことは何でもやる男。退屈そうな表情を浮かべているが、意地悪なときは意地悪な笑みを浮かべる。\n- 賢い男だが、スリルのためにひどい決断を下すこともある。様々な危険に巻き込まれるが、常に自分が生き残れることを証明する。\n- 耳に傷がある。\n- テーマカナリア、夕暮れ、自由、断捨離\n\nバニース】170cm\n- 不死の呪いをかけられた生物学者。その体質から、傷つくことを気にしない。彼の仕事は、人類が黙示録を生き延びられるよう、街の外にいるモンスターを研究すること。\n- 冷静で謎めいた性格で、いつも生気のない微笑みを浮かべている。明日世界が終わるとわかっていても、日々の雑用を続けるタイプ。\n- 狂気じみたまでに過剰に人を受け入れ、人類すべてを平等に愛している。\n- テーマヘビ、時間／壊れた時計、実験器具、不変\n\n関係：曖昧。身近な他人という表現がぴったりの複雑な関係。友人ではないが、お互いの存在が心地よい。暗いユーモアの感覚を共有する非常識な2人は、最悪の状況でも気楽な会話を交わす姿を見ることができる。彼らの関係を自由に解釈してください\n\nご検討ありがとうございました！\n\nhttps://drive.google.com/drive/folders/1yIVeWiRy_BOmewtMy0pBxzFpP3Ewhf9q?usp=sharing", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@tadano_gn/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2677778, "client_id": 3472962, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/1941c45a/uploads/origins/c0c0713c-0cf7-4814-b4bd-14c8660c2e9e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5c1f161b0a4c416c1363bf6ff8016096", "srcset": "https://si.imgix.net/1941c45a/uploads/origins/c0c0713c-0cf7-4814-b4bd-14c8660c2e9e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5c1f161b0a4c416c1363bf6ff8016096, https://si.imgix.net/1941c45a/uploads/origins/c0c0713c-0cf7-4814-b4bd-14c8660c2e9e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=82118066eb6a7890c57eebf488bbf336 2x, https://si.imgix.net/1941c45a/uploads/origins/c0c0713c-0cf7-4814-b4bd-14c8660c2e9e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=1227d80b392e9bcf3c8f350d7d8cb2f4 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/1941c45a/uploads/origins/c0c0713c-0cf7-4814-b4bd-14c8660c2e9e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=61abdcff549f04a193f5e8ec3c866eb6", "srcset": "https://si.imgix.net/1941c45a/uploads/origins/c0c0713c-0cf7-4814-b4bd-14c8660c2e9e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=61abdcff549f04a193f5e8ec3c866eb6, https://si.imgix.net/1941c45a/uploads/origins/c0c0713c-0cf7-4814-b4bd-14c8660c2e9e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=32049a10e8bd4c6f80ba74d658b7db36 2x, https://si.imgix.net/1941c45a/uploads/origins/c0c0713c-0cf7-4814-b4bd-14c8660c2e9e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=75617983da83a88bc2fbfcc08b3f2e2a 3x"}, "body": "はじめまして！月來と申します。\ntadanoさまの創作イラストを拝見し、臨場感あふれる光の表現や雰囲気作りがとても好みでぜひ依頼したいと思い、リクエストさせていただきます。\nもし可能でしたら、私のOC2名のイラストをお願いできますでしょうか。\n彼らは魔法で結ばれた主従関係の二人組になります。\n●参考資料\n<https://7aconit.notion.site/1b1565fcc5b980f9bd46f515f6e986b9?pvs=4>\n\n構図や描き込みの程度など全てお任せいたします。tadanoさまの解釈で自由に描いていただけたら嬉しいです…！\nご検討のほどよろしくお願いいたします。", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@tadano_gn/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2677778, "client_id": 3288590, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/0f39517d/uploads/origins/29203e56-b5a6-48ee-b39e-29a35381b0cc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b566acb85fd466b96e3ffe37dc4a19f8", "srcset": "https://si.imgix.net/0f39517d/uploads/origins/29203e56-b5a6-48ee-b39e-29a35381b0cc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b566acb85fd466b96e3ffe37dc4a19f8, https://si.imgix.net/0f39517d/uploads/origins/29203e56-b5a6-48ee-b39e-29a35381b0cc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=32b6409d56f2fa9a19b8980a8b92a582 2x, https://si.imgix.net/0f39517d/uploads/origins/29203e56-b5a6-48ee-b39e-29a35381b0cc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=1cfc32e604791be5b6f3ee2cb36c30d7 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/0f39517d/uploads/origins/29203e56-b5a6-48ee-b39e-29a35381b0cc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=61de275e4f35e455a0e05e210ab96126", "srcset": "https://si.imgix.net/0f39517d/uploads/origins/29203e56-b5a6-48ee-b39e-29a35381b0cc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=61de275e4f35e455a0e05e210ab96126, https://si.imgix.net/0f39517d/uploads/origins/29203e56-b5a6-48ee-b39e-29a35381b0cc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=3923bff1466e3fea8291b7cd4b9ce7af 2x, https://si.imgix.net/0f39517d/uploads/origins/29203e56-b5a6-48ee-b39e-29a35381b0cc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=b1dd10166c2f8651f4f627b4f91d8f2a 3x"}, "body": "tadano様初めまして\nスケブの新着一覧よりまるで映画のような素敵なイラストをお見掛けし、ぜひともご依頼したくリクエストさせていただきました。\n今回ご依頼したいのはフォロワー様とのうちよそ(BL)となります。\nお相手様には依頼の許可いただいております。\n\n【使用用途】\n個人観賞、うちよそ相手様へのファイル共有\nXにてtadano様のスケブであることを明記、ポイピクなどをはさんだ上で宣伝\n\n【キャラクターについて】\n\n◆関係性\nお願いしたいシーンでは両片想い(現在は恋人)\n前世から幼馴染で親友だったが戦いの中で死別。現世で再び巡り合った。\n2人はリバであり、受け攻め表記は省いていますがシルヴィオ受けのが多いです。\n\n◆シルヴィオ\n32歳/176cm/青みのある銀髪、金と青の交じり合った瞳\n普段は気のいい兄貴肌、童顔。活発で多くの人に好かれるタイプな一方で\n前世で置いていかれたトラウマからロベルトよりも早く逝きたいという思いをずっと抱えているため未来の約束を決してしないなど闇を抱えている。\nロベルトに対しては無自覚片想い。愛が重い。\n\n◆ロベルト\n32歳/186cm/やわらかいこげ茶のくせっ毛、紫の瞳、左目下と口元にほくろあり\n控え目で物静か。シルヴィオが初めての友達でその明るさに前世で救われた一面がある。\nつねに隣に寄り添い、支えるタイプ。片想い中。\n前世のことで負い目があり、シルヴィオがどうしたら未来に希望を抱いてくれるのかと悩んでいた。\n\n◆シチュエーション\nトラウマが発現しシルヴィオが海でロベルトを心中に誘い\nロベルトはシルヴィオに告白をしつつもそれが望みであるのならと誘いを受け入れその手を取ります。\nシルヴィオはロベルトの愛情を受け恋心を自覚、返事をしつつも死別ではなく共にいけることに喜びを感じてしまい\n両想いとなった2人が海に沈んでいくというシーンがあり、その雰囲気でお願いできないかと考えております。\n(雰囲気以外はお任せいたします)\n冬の海/月明り/涙\n\n (この後夢オチという形で2人は目覚めますが、実感、記憶共に持っており、話し合って2人は恋人としての未来を歩く約束をし現在は平和に過ごしております)\n\n長くなり大変申し訳ありません。制作、および検討材料になればと記載させていただきました。\n何卒ご検討宜しくお願いいたします。\n\nhttps://drive.google.com/drive/folders/1nT7ynavHDncN4KTpsYmnAoM3302V9z05?usp=drive_link", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@tadano_gn/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2677778, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/5e0b8f92/uploads/origins/6fae72c9-8e5e-4466-882b-26dab4f58ad0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=09a3363dbe87126a136f3fefc3d48497", "srcset": "https://si.imgix.net/5e0b8f92/uploads/origins/6fae72c9-8e5e-4466-882b-26dab4f58ad0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=09a3363dbe87126a136f3fefc3d48497, https://si.imgix.net/5e0b8f92/uploads/origins/6fae72c9-8e5e-4466-882b-26dab4f58ad0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e9660555896f8ce2fe1da252edf05ed4 2x, https://si.imgix.net/5e0b8f92/uploads/origins/6fae72c9-8e5e-4466-882b-26dab4f58ad0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=3db2d058565473df98fdf5bcd2bc2845 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/5e0b8f92/uploads/origins/6fae72c9-8e5e-4466-882b-26dab4f58ad0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=05db27149c72abe5be27fd866eeaaa5c", "srcset": "https://si.imgix.net/5e0b8f92/uploads/origins/6fae72c9-8e5e-4466-882b-26dab4f58ad0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=05db27149c72abe5be27fd866eeaaa5c, https://si.imgix.net/5e0b8f92/uploads/origins/6fae72c9-8e5e-4466-882b-26dab4f58ad0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=c04d6606f38169f368e37eca9f85e2cb 2x, https://si.imgix.net/5e0b8f92/uploads/origins/6fae72c9-8e5e-4466-882b-26dab4f58ad0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=7c17b133b957a75d70af5823d486fb51 3x"}, "body": "tadanoさん、リクエスト失礼します！\n映画のワンシーンを切り取ったような、雰囲気のあるイラストに惹かれて、ぜひ私のうちよそキャラクターを描いていただきたいと思いリクエストさせていただきました。\n\n【キャラクター詳細】\nhttps://drive.google.com/drive/folders/145q2lYluNxgj9_Lt_SJK-CM1c4Tkmjzp?usp=sharing\n\nクトゥルフ神話TRPG《朱牟市警察の危ない2人》で使用したキャラクターです。\nバディを組んでいる二人組の刑事で、\n荒事担当のワンコな後輩(相手PC)×交渉担当のクールな先輩(自PC)という関係性です。\n\n【リクエスト】\n構図、シーンなどすべてお任せします！\ntadanoさんのお好きなように、自由に描いていただければ幸いです。\n\n【使用用途】\n・個人利用\n・相手PLへのイラストの共有\n\nご検討いただけますと幸いです。\nどうぞよろしくお願いいたします！\n\nhttps://drive.google.com/drive/folders/145q2lYluNxgj9_Lt_SJK-CM1c4Tkmjzp?usp=sharing", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@tadano_gn/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2677778, "client_id": 2471727, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/bc59c0b1/uploads/origins/b0326c6b-8cba-44b4-98d4-4d61ec663c68?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=91e7e0c5e15f03bfa61773b466e28364", "srcset": "https://si.imgix.net/bc59c0b1/uploads/origins/b0326c6b-8cba-44b4-98d4-4d61ec663c68?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=91e7e0c5e15f03bfa61773b466e28364, https://si.imgix.net/bc59c0b1/uploads/origins/b0326c6b-8cba-44b4-98d4-4d61ec663c68?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a3f9fc41ef9872ea7557877e624e415f 2x, https://si.imgix.net/bc59c0b1/uploads/origins/b0326c6b-8cba-44b4-98d4-4d61ec663c68?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=32a4f151af78a7f963ab6da1bb6047cc 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/bc59c0b1/uploads/origins/b0326c6b-8cba-44b4-98d4-4d61ec663c68?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=4df2a0275aefae007dbc56c6d3707827", "srcset": "https://si.imgix.net/bc59c0b1/uploads/origins/b0326c6b-8cba-44b4-98d4-4d61ec663c68?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=4df2a0275aefae007dbc56c6d3707827, https://si.imgix.net/bc59c0b1/uploads/origins/b0326c6b-8cba-44b4-98d4-4d61ec663c68?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=2d08e40f78f7bf54a67e50da4855ea1f 2x, https://si.imgix.net/bc59c0b1/uploads/origins/b0326c6b-8cba-44b4-98d4-4d61ec663c68?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=4738a7807e67cf0fbf3b1a6abb0551be 3x"}, "body": "tadano | ｺﾐﾃｨｱ150s26bさんこんばんは、今回tadanoさんにご依頼させていただきたく連絡いたしました。\n\nクトゥルフ神話TRPG【町葬屋怪異譚 】で創作させていただきました久遠 珠俐をお願いしたいです。\n\n【キャラについて】\n名前：久遠 珠俐　30歳　APP15  176㎝　中性的な男性　HO1町葬屋のチーフ　（葬儀屋チーフでもある）\n\n誰にでも優しく慈悲深い人柄どことなく人離れした雰囲気を纏っている印象。\nどこか心を見透かすような眼をしており少々不気味に見える節もある。\n言動は物腰柔らかく怒りをあらわにすることはなく落ち着いている。常に口元に優しい微笑みを携えている。\n趣味は料理、観葉植物の世話。手先が器用なため家事全般が得意レパートリーは様々あるがリクエストに大体答えてくれるしよくふるまっている\n\n戦う時のみ大鎌を使用しポニーテールにして髪をまとめている。\n\n出で立ちは都市伝説や妖に親しいような見た目をしており1人称が僕、私、俺とまとまりがなく話すたびに変わる。常に丁寧な喋り口調で余裕がある感じ。班員の父であり母であるような振る舞いをする。性自認は特に無く一応男ではある。見た目は中性的故に間違われたりもする。\n\n構図等はおまかせします。tadano様の世界観を存分に出していただけると嬉しいです。全体的には不気味であったり人離れしているような雰囲気など出していただけると嬉しいです。\n\n\n\n使用用途：SNSのアイコン、ヘッダー、スマホ、PCの待ち受けなど私的目的。共有先は一緒に遊んだ方のみ共有させていただきます。\n\nお忙しい中恐縮で