ds/origins/c3d0dc5f-cfbd-44cb-9d46-e7f0679e3cf0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c40a430200f1a7aa7364a0a0886a36a2", "srcset": "https://si.imgix.net/7032b5a7/uploads/origins/c3d0dc5f-cfbd-44cb-9d46-e7f0679e3cf0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c40a430200f1a7aa7364a0a0886a36a2, https://si.imgix.net/7032b5a7/uploads/origins/c3d0dc5f-cfbd-44cb-9d46-e7f0679e3cf0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=abb7c6d735f8e26d5e78233e00c4d22f 2x, https://si.imgix.net/7032b5a7/uploads/origins/c3d0dc5f-cfbd-44cb-9d46-e7f0679e3cf0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c48653c3bcfc4068db4bff94f6169ac0 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/7032b5a7/uploads/origins/c3d0dc5f-cfbd-44cb-9d46-e7f0679e3cf0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=da0c9021dfe8a4ac876024d1deafed0d", "srcset": "https://si.imgix.net/7032b5a7/uploads/origins/c3d0dc5f-cfbd-44cb-9d46-e7f0679e3cf0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=da0c9021dfe8a4ac876024d1deafed0d, https://si.imgix.net/7032b5a7/uploads/origins/c3d0dc5f-cfbd-44cb-9d46-e7f0679e3cf0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=aedc3f31cb5a0257c6cacb621496e2e4 2x, https://si.imgix.net/7032b5a7/uploads/origins/c3d0dc5f-cfbd-44cb-9d46-e7f0679e3cf0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=0a80a77c0dc43f4a3a7374c8e532ebe3 3x"}, "body": "始めまして、pixivの1.5周年ヘリーさんのイラストを見て、エロさとかわいらしさを感じました。\nあなたの絵柄でもこのシチュエーションの絵が見たく、他の方にも同じリクエストしましたが、依頼しに来ました。普段描いていらっしゃるジャンルとは違うのですが、vチューバー事務所のホロライブのイラストを依頼したいのですが、よろしいでしょうか？\n描いてもらう人物はホロライブに所属する風真いろはとAZKiというタレントの二人でバニーガーデンというゲームに出てくるお店で働いている感じのイラストをお願いします。\n背景に酒の並んだ棚が置いてあって、衣装は二人ともバニーガールの衣装を着てほしいのですが、ゲームのバニーガーデンの衣装より露出を多くしてほしいです。服の色は風真いろはが緑色イメージで、AZKiがピンク色でお願いします。\nポーズも難しく\n風真いろはが後ろの棚から酒の瓶を取るポーズ（背面からこっちを振り向いてお尻を恥ずかしがりながら隠している姿）\nAZKiが正面のお客（姿は見えない）と接客しながら胸を両腕で隠しているポーズです\nまた文章に書くとキモイ感じになるのですが、過去にそらのおとしものというエロいアニメのグッズにすっぽんぽんストラップというとんでもない商品がありまして、そのストラップのニンフというキャラクターとイカロスというキャラクターのポーズをそれぞれ参考にしていただけるとわかりやすいと思います。\n（風真いろはがニンフのストラップの後ろのポーズ。AZKiがイカロスのストラップの表面のポーズをイメージしております。）\n表情もストラップの様に恥ずかしがっていてほしいです。\nバニーガーデン公式ホームページ　https://qureate.co.jp/bunnygarden/\nストラップのイメージ　https://www.moview.jp/81629181.html\nネットで『すっぽんぽん携帯ストラップ そらのおとしもの』で検索したら画像が出てきますが、サイズが小さかったため、Amazonの画像イメージが一番でかくて見やすかったです　\nまた、差分の余裕もあるようでしたら全裸差分もできたら欲しいです。", "nc": 33, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 624548, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "桃田ゆま", "screen_name": "yuma696", "avatar_url": "https://pbs.twimg.com/profile_images/2026639955502706688/jknmdjsY.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1926942742703161345/1765803077/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "art"}], "banned": false, "nc": 176}, {"id": 772791, "creator": true, "nsfw_acceptable": true, "acceptable": false, "name": "poruporu", "screen_name": "PoruporuR18", "avatar_url": "https://proxy.misskeyusercontent.jp/avatar.webp?url=https%3A%2F%2Fmedia.misskeyusercontent.jp%2Fmisskey%2F810f3c26-b762-4f71-b2c8-224c51d57f4d.png&avatar=1", "header_url": null, "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "art"}, {"genre": "comic"}], "banned": false, "nc": 161}, {"id": 2847665, "creator": true, "nsfw_accepta