webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=abdc60f742c3b409865890ef82b77d8d 3x"}, "duration": null, "nsfw": true, "hardcore": true, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/cbd3dc0b/uploads/origins/3103b937-d2f0-4448-97e2-7bc06ceb08ad?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=fff85d186243717c303da4d4e36ab34a", "srcset": "https://si.imgix.net/cbd3dc0b/uploads/origins/3103b937-d2f0-4448-97e2-7bc06ceb08ad?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=fff85d186243717c303da4d4e36ab34a, https://si.imgix.net/cbd3dc0b/uploads/origins/3103b937-d2f0-4448-97e2-7bc06ceb08ad?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=632965f887d1ff1e222dcd351cbe5c86 2x, https://si.imgix.net/cbd3dc0b/uploads/origins/3103b937-d2f0-4448-97e2-7bc06ceb08ad?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=3a3f5fd8e4d4d14603fb5c54f2727fc5 3x"}, "body": "例のたたら場モブキャラのイラストをお願いいたします!\nhttps://skeb.jp/requests/1768373\n・終盤シシ神がダイダラボッチ化して、放っている黒いドロドロ（触れたら死ぬ）から全速力で逃げている母ちゃん。（子どもをおんぶ紐で抱えており、子どもは恐怖で泣き叫んでいる状態。また、普通なら追いつかれる速度のドロドロからたたら場で鍛えた強靭な脚力を活用して逃げている母ちゃん）周囲は誰もおらず母ちゃんと子どもだけ。\n・水の中に飛び込み、平泳ぎで逃げているシーン（溺れないように子どもがいる背中を上にしている）\n・安全な場所（湖の真ん中あたり）に逃げ込み、たたら場が崩壊している様子をただ呆然とみている2人。\n・すべてが終わったあと、夫と再会。泣きながらハグしている。（夫はヒョロがりで背が小さい、160ｃｍくらい）\nまた、母ちゃんは袖まくりで脇が見えている状態の着物を着ている状態です。身長175ｃｍ、とても筋肉質で爆乳であり着物の胸元から谷間が出ています\nそれではお願いいたします。", "nc": 187, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@fetitaro23/works/9", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2618606, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/894dbde4/uploads/origins/c6a27aba-564b-43a9-b3e1-0c4cac15cb03?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=238e120e3425875ae905cdb5a7ef08ab", "srcset": "https://si.imgix.net/894dbde4/uploads/origins/c6a27aba-564b-43a9-b3e1-0c4cac15cb03?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=238e120e3425875ae905cdb5a7ef08ab, https://si.imgix.net/894dbde4/uploads/origins/c6a27aba-564b-43a9-b3e1-0c4cac15cb03?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=7ceba9a8e8253609cd86e6d7ff8b1ad2 2x, https://si.imgix.net/894dbde4/uploads/origins/c6a27aba-564b-43a9-b3e1-0c4cac15cb03?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a5a70e623563e72618e8932a799c2b71 3x"}, "duration": null, "nsfw": true, "hardcore": true, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/894dbde4/uploads/origins/c6a27aba-564b-43a9-b3e1-0c4cac15cb03?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=535b6d79013736e39a646995cf09b01a", "srcset": "https://si.imgix.net/894dbde4/uploads/origins/c6a27aba-564b-43a9-b3e1-0c4cac15cb03?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=535b6d79013736e39a646995cf09b01a, https://si.imgix.net/894dbde4/uploads/origins/c6a27aba-564b-43a9-b3e1-0c4cac15cb03?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=e256f10cb269643824b4315ce7689045 2x, https://si.imgix.net/894dbde4/uploads/origins/c6a27aba-564b-43a9-b3e1-0c4cac15cb03?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=b281f87e56667f8b0c0876e7fb6bc321 3x"}, "body": "連投失礼いたします。\nもののけ姫のたたら場モブキャラをリクエストさせていただいたものです。\n同じキャラでのリクエストをよろしいでしょうか？\n漫画形式で仕事終わりに息子と風呂→夕飯（あぐらをかいて食べており、息子に授乳も兼ねている）→就寝（息子と一緒の布団で寝ており、母ちゃんは放屁）\n以上です。\nなお母ちゃんの容姿はとても筋肉質で大柄（身長175ｃｍ）、またたたら場の女性特有に胸の大きさを非常に大きめでお願いいたします。\nよろしくお願いいたします。", "nc": 59, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@fetitaro23/works/8", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2618606, "vtt_url": null, "thumbnail_image_urls": {"src": "htt