200&s=5fde6bb17e7f84195cea680efb88e458, https://si.imgix.net/4c9b23cb/uploads/origins/0ff82fd6-a286-42f4-a03c-388580bb419c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=ca6f37ccce64cb5ef79fccebde3e1230 2x, https://si.imgix.net/4c9b23cb/uploads/origins/0ff82fd6-a286-42f4-a03c-388580bb419c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=5e3093ec3f431c409bc41c0b5a5c2dea 3x"}, "body": "月出里(すだち)様\n\n可愛くて綺麗なイラストを拝見しまして、お声がけさせていただきました。\n普段描かれているジャンルと異なりますので、合わなければキャンセルいただいても構いません。\nご検討いただけたらと思います。\n\n遊戯王OCGから、【倶利伽羅天童】を描いていただきたいです。\n湯けむり温泉でバスタオル一枚を纏っている姿になります。\nタオルの無しの差分も併せてお願いをしたいです。\n具体的な構図や表情など、詳細な点は先生にお任せをさせていただきます。\n\nよろしくお願いします。\n\nhttps://drive.google.com/drive/folders/1Oexb9Bgif9Qz3IbQCwQ18qVat3KIpYI6", "nc": 48, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@sudatineco/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3011330, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/1b937d23/uploads/origins/872c2138-b0ee-44f8-a5fc-91eff1a8d75c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c025d1cd9450426e2eb090f1b86a78b4", "srcset": "https://si.imgix.net/1b937d23/uploads/origins/872c2138-b0ee-44f8-a5fc-91eff1a8d75c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c025d1cd9450426e2eb090f1b86a78b4, https://si.imgix.net/1b937d23/uploads/origins/872c2138-b0ee-44f8-a5fc-91eff1a8d75c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=2cc23aad0bae22b6dff1a6437c1db180 2x, https://si.imgix.net/1b937d23/uploads/origins/872c2138-b0ee-44f8-a5fc-91eff1a8d75c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=3a5ab88cefc504a4a66fbecf08435512 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/1b937d23/uploa