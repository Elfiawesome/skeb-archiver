FFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=692b49128834e822c67413c8dc9ae479", "src_set": ""}, "private": true, "genre": "art", "tipped": false, "creator_id": 2947596, "client_id": 0, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 17, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@sleepsheepships/works/10", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2947596, "client_id": 2005835, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/21dfb18e/uploads/origins/9742c73f-428c-4dc6-896e-6b3c1fbc55ec?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9d912f4764cdd41ac2ba457b5248b54f", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/21dfb18e/uploads/origins/9742c73f-428c-4dc6-896e-6b3c1fbc55ec?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=339c840f544ae27b72ba06da1d84f5c5", "src_set": ""}, "body": "先生の絵が大好きです！私のOCを描いてくれませんか？\n\n喆红（招き猫）\n彼は神社の祈願石から変身した招き猫なので、神社から出ることができず、ずっと神社の近くにしかいられない。彼はしばしば子猫に変身し、いつも祈りを捧げている通行人に餌をねだる。マナが高いため、周囲のモンスターのボス的存在でもあり、コインをくれることを条件に、他のモンスターの不正を助けることも多い。\n構成はお任せします！服装は自由に変更してください。\n\nhttps://drive.google.com/drive/folders/1-TI4YExmz7prL1e_pceKCUDGoEqXsFzn", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@sleepsheepships/works/9", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2947596, "client_id": 3180621, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/0d92d109/uploads/origins/319858ca-3ee7-4fc1-85c3-e254a4d763a5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4b03526f2fbf8465d691993afe622d67", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/0d92d109/uploads/origins/319858ca-3ee7-4fc1-85c3-e254a4d763a5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b0543bd00c7ae9ec7635a8ca5d2adb0b", "src_set": ""}, "body": "こんにちは！ひみつ樣。\n\n私は長い間あなたが好きです、芸術のスタイルは本当にとてもかわいいです！私のために二人のキャラクターを描いてくれませんか？ 不器用な女の子（165cm）と、世話好きだけどちょっと不機嫌な男の子（175cm）のカップルです。\n\n男の子が女の子に金属製のスプーンでイチゴのカップケーキを食べさせているところを描いてほしい。女の子の表情はとても恥ずかしそうで、男の子は少し照れながら焦っている！\n\nキャラクターデザイン\nhttps://x.com/shhnzhng1014115/status/1779412495678972263\nhttps://x.com/shhnzhng1014115/status/1779411410985881883\n服装\nhttps://x.com/shhnzhng1014115/status/1779414417467224211\n\n私の依頼を受け入れてくれることを強く望んでいます！良い一日を！🖤🤍(。・ω・。)", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@sleepsheepships/works/8", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/ebd0bce9/uploads/origins/48d87dca-c90b-4ea1-9182-17c6e4369bfc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=cabab0ebca766e83c760c11b7db852df", "src_set": ""}, "private": true, "genre": "art", "tipped": false, "creator_id": 2947596, "client_id": 650977, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 16, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@sleepsheepships/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2947596, "client_id": 680666, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/e50d5849/uploads/origins/4a7f313f-32cc-4153-93e4-2fb773d04988?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3bbaf46ef6992a1dd2a4e7ebd3c80ac8", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/e50d5849/uploads/origins/4a7f313f-32cc-4153-93e4-2fb773d04988?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ef6eb1fe7b40c00c14db8241e384eb72", "src_set": ""}, "body": "こんにちは、前回は素敵なイラストを描いていただきありがとうございました！今回もオリジナルキャラクターのイラストを依頼したいと思っております。\n\n資料：https://drive.google.com/drive/folders/19gs-i_x1hvnul-y4pLKnNsZD_C4ZBhof\n\nキャラ設定：不死の古代人男性と千年前にタイムスリップした現代少女。世界が半壊状態になった破滅的な土地を舞台に、2人は旅をしながら世界中の生き残った人々の再建を助けていく。現代に戻った少女は記憶を失った状態で相方と再会し、彼と過去の記憶をたどる旅に出る。詳細は資料をご覧ください。\n性格：男は見た目は親切で優しいが、内面は意地悪で毒舌、少女は善良で無邪気で活発、自己奉仕的な一面を持つ。\nお互いに好意を抱いている関係ですが、男はそれを認めようとしませんし、少女も自分の気持ちに気づいていないため曖昧な状態です。\n\n時代や服装は自由にお選びください。特に構図やシーンなどの指定はありませんので、気軽に描いてください！\n依頼に応じられない場合はキャンセルしていただいても構いません。よろしくお願いします！", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@sleepsheepships/works/6", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/27a4642d/uploads/origins/77450510-b86c-45bb-9527-94e73b4fafbb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=51a36ae5958b7640d782e2f8a31c2d53", "src_set": ""}, "private": true, "genre": "art", "tipped": true, "creator_id": 2947596, "client_id": 1889033, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 145, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@sleepsheepships/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2947596, "client_id": 1342401, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/f8c6e7aa/uploads/origins/e3ec5e8f-53e8-4fc9-96b9-1798645dc28b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ee1f6bea062c98b30ea435ec1cbac85c", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/f8c6e7aa/uploads/origins/e3ec5e8f-53e8-4fc9-96b9-1798645dc28b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a457b087341cfaf3ec95eafdffb23c1c", "src_set": ""}, "body": "はじめまして、アメと申します。 今回skeb依頼受付中とのことでリクエストを送らせていただきました。大変お忙しいとは思いますがよろしければお願いいたします。  \n キャラクター： \n ① 人間の男の子、左に薄黄色の髪がある。左目の下に涙痣がある。性格は臆病で気が弱い。 体は15歳ぐらいけど実は19歳、時々大人っぽい \n②長生き、外見は若い者。顔が美しい男性。 妖精耳の魔法使い。左目の下にも涙痣がある。孤高な性格。めちゃん以外の人類が嫌い  (2人の血縁関係がないです、ただ見た目が似ている） \n テーマは誕生日 \n2人の誕生日が同じ日でした。  \n世界観は中世末\n背景はできれば冬の夜に雪の中で散歩もしくは暖かい部屋に食事する、イチャイチャするなど....どうぞ自由に描いてくださいm(_ _)m\n 2人の誕生日は同じですが妖精の寿命は長いので数十年後に二人の誕生日一緒に迎えることはありません。少し悲しいですが一応今のふたりは幸せです。だいたいその雰囲気です。\n\nモノクロでも構いませんが、よろしければ少しコマ割り付きなイラストでよろしいでしょうか？（2人の目線向かい合うなど）\nもし『happy birthday』付きますと幸いです、難しいならなくでも構いません🙇🏻‍♀️服装はファイルにて【教会服】お願いいたします。（冬っぽいほう）https://drive.google.com/drive/folders/1-_n2akbkj7zGV9vLk8rJFsbgBYhFxC0u  \n\n二人の世界観、設定など詳しくのことはファイルにてどうぞ参考してください！\n どうぞご検討よろしくお願い致します。\n\nhttps://drive.google.com/drive/folders/1-HW2ILj4DcIeEb05Scu3pg4leB3G_h_m", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@sleepsheepships/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2947596, "client_id": 680666, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/9265ddf6/uploads/origins/f9db1161-9cc5-4d55-b30e-aae3686f48ad?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4056b32633c35bff5d13c946c9703873", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/9265ddf6/uploads/origins/f9db1161-9cc5-4d55-b30e-aae3686f48ad?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ba042ca21208ff7e640632a1db03fd76", "src_set": ""}, "body": "はじめまして！ご多忙中申し訳ありません、素敵な絵を拝見したのでオリジナルキャラクター3人のイラストを依頼したいと思っております。\n\n資料：\nhttps://drive.google.com/drive/folders/15ckd8AHhzcWhCB-UWGkhp_nUAEEql8WC\n\nキャラ設定：3人とも幼馴染で、幼い頃からずっと一緒に政治と魔法の研究をしてきた。\n\nHill（赤）：人間と悪魔の混血の王子。明るく腹黒い性格で、サボったり友達をからかったりすることが好き。\nAve（茶）：王子の補佐官。理性的だがどこか素朴な性格で、最年少ながらも2人の王子の世話をしてきた苦労人。\nLand（青）：純血の悪魔王子。コミュニケーションが苦手な無口系で、人が騒ぐのを黙って見ているのが好き。\n\n関係性：赤と青は従兄弟だが、その後政見が合わずに別れ、現在は相続をめぐって争っている。赤は青を、自分の将来が暴走したときの保険だと考えていた。茶に関しては彼女を役に立つ部下として、唯一信頼できる存在として見ていた。\n青は赤のやり方が気に入らず、早く止めなかった自分に責任感を抱いている。同時に茶の年相応ではない強さに惹かれ、好意を抱いているが、立場上の理由で自分からは気持ちを明かしていない。\n茶は二人が別れた後も引き続き赤に従い、常に彼を尊敬し好きになっていたが、心の中では青派の方に傾いていた。青を大切な友達だと思っており、一緒に赤を守ってほしいと思っている。\n\n長文を送ってしまい申し訳ありません。特に構図やシーンなどの指定はありませんので、気軽に描いてください！\n依頼に応じられない場合はキャンセルしていただいても構いません。よろしくお願いします！", "nc": 8, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@sleepsheepships/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2947596, "client_id": 667554, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/ad2b05c0/uploads/origins/f50f7dbd-f2b5-460f-870f-5a371cb55ace?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2a8af0764c75383b0844dbf9a1240e41", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/ad2b05c0/uploads/origins/f50f7dbd-f2b5-460f-870f-5a371cb55ace?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=bd8258f64023250a0e92e8fcf6ca0ad2", "src_set": ""}, "body": "ひみつさん、こんにちは！私はあなたのイラストのスタイルがとても好きです。あなたの描く男の子のキャラクターはとても魅力的でかわいいです！だから、私の2人のOC（Little BlankeとSide）のために、モノクロの複数のインタラクションイラストを描いてくれることを願っています。\n\nキャラクターリファレンス：https://sta.sh/28owtgcra1w\n\nキャラクター\nリトル・ブランケは若いヴァンパイアで、サイドはヴァイオリニストです。詳しくはアルバム内の紹介文をご覧ください。\n\nお願い\nハロウィンをテーマにしたモノクロのマルチインタラクションイラスト（Sktechページ）をお願いします！キャラクターはハロウィンの仮装をします。サイドはしぶしぶリトル・ブランケに連れ出されます。一緒にハロウィンパレードに参加する二人の様々なやりとりを描いてください。\n\nキャラクターのハロウィン衣装は自由にデザインできます。リトル・ブランケは