omic", "default_amount": 15000}], "acceptable_only_public": false, "tip_acceptable": true, "yearly_report_client_visible": false, "total_appeals_count": 0, "received_works": [{"path": "/@Setzenbbys/works/23", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2966628, "client_id": 0, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/24666fee/uploads/origins/4be0c5da-c10e-4535-b56c-83129bf63449?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d136ebd51808b3645d36d1aeaf72a122", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/24666fee/uploads/origins/4be0c5da-c10e-4535-b56c-83129bf63449?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b8a15231e0327bd222aea5e0c6b95583", "src_set": ""}, "body": "初めまして。OVA「姦染５-レイプハーレム-」の差分付き二次創作イラストをお願いします。\n\n本編のあとも犯され続ける茜梨と夏都がバックからの中出しで受精するシーンと、その後のボテ腹差分をセリフ付きでお願いします\n茜梨は原作本編にも出た眼鏡でガリガリの竿役、夏都は原作本編にも出た色黒の竿役に犯されている形にしてください\n衣装は全裸、セリフ付き、女性キャラの全身が映る構図を意識しながらだと嬉しいです\n\n何卒よろしくお願いします", "nc": 57, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Setzenbbys/works/22", "private_thumbnail_image_urls": null, "private": false, "genre": "comic", "tipped": true, "creator_id": 2966628, "client_id": 598368, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/c845b339/uploads/origins/374a0b06-3aa3-44d3-8d52-f3e5ff21566f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=86677199835afd01f3300bbba48b158d", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/c845b339/uploads/origins/374a0b06-3aa3-44d3-8d52-f3e5ff21566f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=4cd3f73356e4b4e4c08fa263df0c7b42", "src_set": ""}, "body": "こんばんはです\n\n久々のコミックリクエストです\n\n閃乱カグラの紫ちゃんと温泉宿に来てるシチュで晩御飯後で部屋でくつろぐ2人、紫ちゃんが浴衣を着崩しデカ乳を見せて露天風呂へ入ろうと誘惑しそのまま風呂へ行く\n紫ちゃんが乳やムチムチの体を使って洗っていき最後は胸にボディーソープをかけパイズリで洗いデカチンでギリギリ先っぽが見える程度に、最中にイタズラで乳首を弾いたりするとオホ声を出し乳首までいっぱい調教された事を嬉々として話しながら射精する双方身体が洗い終わり風呂に入るが背後からデカパイを鷲掴みで揉まれ温泉の感想を言う最中にされてオホ声が混ざってしまい待ってをかけるも舌を絡まされて遮られる、紫ちゃんはとっておきのスケベ服を用意してると耳打ちで囁やかれ紫ちゃんのお尻を揉みながら一緒に脱衣場へ\n寝室で待っていると紫ちゃんは逆バニーに上からスリングショット水着を着て首輪を付け、ニーソックスを着た変態衣装で脱衣場から出てくる。すぐさまスリングショット水着は脱がされそのまま対面座位の体勢に、そこでマゾメス彼女から変態マゾメス嫁になれと言われ嬉しさのあまり軽イキし胸がキュンキュンし続ける紫ちゃんは片乳とまんこについたニプレスを外し嬉しさのあまりに軽イキしたのと結婚出来ると喜びこのドスケべな体も心も先生のものと宣言しそのまま紫ちゃんの手を掴んで正常位で交尾が始まり、舌を絡ませぶちゅキスしながら紫ちゃんは好き好きモードに入りつつそのまま中出しされる中出し中も舌を絡ませ合い、1回目の射精が終わるとそのまま押し倒され種付けプレスの体勢で今日は孕ませる気でやると言われキュンキュンしながら孕ませて欲しいと頼む、そこからダイジェストの一コマでそれぞれ種付けプレス、寝バック、立ちバックと朝までヤリまくる。最後に先っぽにちんキスををしちんぽがキスマだらけになりそのまま2人で寝そべる胸もまんこも精液でドロドロの中愛してると言いマゾメスちんぽ花嫁として愛してと良い相手をあなた呼びにすると同時に受精し、先生をあなた呼びしたところで終わる\n\n逆バニーの二プレスの形はハート型でスリングショット水着の色的にパープルメタリックなのでテカってる感じで首に首輪がされてる\nお風呂に入るシーンの最初に紫ちゃんはタオルをかけていて乳首が隠れてる感じに\n先生側のセリフはなし\n\nよろしくお願い致します", "nc": 56, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Setzenbbys/works/21", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/43440579/uploads/origins/4e6c76ad-a652-418e-88a2-7b3b6c62a283?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=131bfc0c6619a428e0b356ff8b186d43", "src_set": ""}, "private": true, "genre": "art", "tipped": true, "creator_id": 2966628, "client_id": 0, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 176, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@Setzenbbys/works/20", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/b7679029/uploads/origins/6e9db986-63e3-4ebc-8d89-5b0675220a47?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=