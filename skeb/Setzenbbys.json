んど裸でも大丈夫で、必要なのは耳、トゲのついたアクセサリーのついた尻尾、耳のピアス、黒いバラのアクセサリー、牙、コウモリの羽だけ。\n指なし手袋と網タイツは必須ではありませんが、お望みなら入れても構いません。\nリナは馬の下敷きになり、彼にフェラチオをします。\nライナが馬にフェラチオをするのがどれほど好きかを示すために、ライナの周りにハートを追加することができます。\n馬には大きなペニスと大きな睾丸があります。\n\n馬がリィナの口の中でイク別バージョンもあるとありがたい。\nこのバージョンでは、瞳孔がハート型になります。\n\n馬のペニスや精液でお腹が膨らんだリィナは描かないでください。バリエーションとして追加するのは構いませんが、お腹が膨らんでいないオリジナルを希望します。\n\nライナの吸血鬼の牙は、フェラチオをするので、おそらく見えないと理解しています。フェラチオをする前に、ライナがエロティックな笑みを浮かべて馬のペニスを見ているようなイメージのバリエーションを作れば、彼女の牙が描かれるかもしれません。しかし、そのバリエーションはオプションであり、必須ではありません。\n\n彼女の耳と尻尾を忘れずに描いてくれてありがとう！コウモリの羽、ピアス、黒いバラのアクセサリーも！\n\nありがとう！\n\nhttps://drive.google.com/file/d/1CKRp4iUrnrBONg2cJjFSuLKAF4APVzhi/view?usp=sharing", "nc": 169, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Setzenbbys/works/17", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/960d48af/uploads/origins/ac39bddc-42f0-4d4c-8e5f-97d9f0893a93?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=b1289bee38a084c53d276b6d5ee85342", "src_set": ""}, "private": true, "genre": "art", "tipped": false, "creator_id": 2966628, "client_id": 0, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 49, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@Setzenbbys/works/16", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/f902c2de/uploads/origins/8f36c6ce-f3da-403f-9fba-f57d7f5c0773?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=5615fdebd798bcd01959d4f96f86e51f", "src_set": ""}, "private": true, "genre": "art", "tipped": false, "creator_id": 2966628, "client_id": 0, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "co