。\nその振る舞いと性質とのギャップから勘違いが起きやすく、端的に言うと生きているだけで他人を狂わせることさえある「魔性の男」としての側面も持っている、少しあぶない人間です。\n\n長くなってしまいましたが、何卒よろしくお願いいたします！\n\nhttps://drive.google.com/drive/folders/1FzCLoZq3x47dDnCIiaOGpvJWsoLMHBvQ", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}], "similar_creators": [{"id": 18206, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "KVN", "screen_name": "kevinvnvn02", "avatar_url": "https://pbs.twimg.com/profile_images/1478714010665365514/oRZ7Vzm7.jpg", "header_url": "https://pbs.twimg.com/profile_banners/2328587203/1641296896/1500x500", "appeal_receivable": true, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 3, "complete_expiration_days": 90, "skills": [{"genre": "art"}, {"genre": "comic"}], "nc": 177}, {"id": 1030628, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "kittanke＠skeb募集中", "screen_name": "kittanke_illust", "avatar_url": "https://pbs.twimg.com/profile_images/2018534825775529984/KwcokEzD.jpg", "header_url": "https://pbs.twimg.com/profile_banners/2004138338157318147/1766659705/1500x500", "appeal_receivable": true, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 20, "complete_expiration_days": 50, "skills": [{"genre": "art"}], "nc": 160}, {"id": 1439932, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "✰⋆｡:日ﾟ月月･*☽", "screen_name": "aki0813tsukiii", "avatar_url": "https://pbs.twimg.com/profile_images/1659433373688025088/g7EGIya-.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1092619374568054786/1650269565/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 10, "com