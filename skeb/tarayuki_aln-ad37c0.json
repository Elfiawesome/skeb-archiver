//si.imgix.net/c3dbdc75/uploads/origins/141f3715-7c8a-4ad4-a131-0c14e010b7bd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=f539c2263f39710cfa06dd058f57f230 3x"}, "body": "たらゆき様\n\nはじめまして、紅廻にまと申します！\nたらゆき様のふわっとした素敵なイラストをSNSでお見かけしぜひリクエストしたいと思い、この度送らせていただきました。\n以下に内容をまとめたのでご検討していただけると幸いです。\n\n立ち絵の全体図はTwitterのメディア欄をご参照ください。→@Koukai_Nima\n\n【利用用途】\n・配信サムネイル\n・Twitterのアイコンやツイート\n\n【イラストのイメージ】\nASMRサムネに使用させていただきたいと思っておりますので口元に手をあてて囁いているようなポーズでお願いいたします...！\n【希望納品形式】\n・PSD\n・背景、人物、サインのレイヤーを分けたもの\n\n説明不足の箇所もあるかと思いますがご検討の程よろしくお願い致します。\n\n紅廻にま(@Koukai_Nima)", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@tarayuki_aln/works/9", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/100eb346/uploads/origins/a28244e4-ff1d-4770-9637-4e80d72afc75?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=a6db9055c27a21315df2ab9c9d09102f", "srcset": "https://si.imgix.net/100eb346/uploads/origins/a28244e4-ff1d-4770-9637-4e80d72afc75?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=a6db9055c27a21315df2ab9c9d09102f, https://si.imgix.net/100eb346/uploads/origins/a28244e4-ff1d-4770-9637-4e80d72afc75?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=75204ef30f4d34542df189e22928355a 2x, https://si.imgix.net/100eb346/uploads/origins/a28244e4-ff1d-4770-9637-4e80d72afc75?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=6187b4c3a613cc97b55d021af453062e 3x"}, "private": true, "genre": "art", "tipped": false, "creator_id": 1355070, "nc": 177}, {"path": "/@tarayuki_aln/works/8", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1355070, "client_id": 2360315, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/bd7f473e/uploads/origins/10e69774-db75-4d79-8250-10f4780f8dfd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=20620d909b81be1154d3f54ac7cfb360", "srcset": "https://si.imgix.net/bd7f473e/uploads/origins/10e69774-db75-4d79-8250-10f4780f8dfd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=20620d909b81be1154d3f54ac7cfb360, https://si.imgix.net/bd7f473e/uploads/origins/10e69774-db75-4d79-8250-10f4780f8dfd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=1ab264a80ecf94fb460a0b58d4303959 2x, https://si.imgix.net/bd7f473e/uploads/origins/10e69774-db75-4d79-8250-10f4780f8dfd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=4562544fb70bbc58771cf108e23465d3 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/bd7f473e/uploads/origins/10e69774-db75-4d79-8250-10f4780f8dfd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6ec540a301a71937fe08e6b8664c8ba4", "srcset": "https://si.imgix.net/bd7f473e/uploads/origins/10e69774-db75-4d79-8250-10f4780f8dfd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6ec540a301a71937fe08e6b8664c8ba4, https://si.imgix.net/bd7f473e/uploads/origins/10e69774-db75-4d79-8250-10f4780f8dfd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=492f0f74f07e76cdb1d1e2ab62540bea 2x, https://si.imgix.net/bd7f473e/uploads/origins/10e69774-db75-4d79-8250-10f4780f8dfd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=79da6f78e884a850e6b81ca65e36c60e 3x"}, "body": "はじめまして。\npixivでイラストをお見かけしましたときに\n魔法エフェクト・シチュエーションがお好みとのことで\nもしよろしければリクエストさせていただけないでしょうか？\n\nオリジナルキャラが魔法を詠唱中のシーンをお願いできないでしょうか？\n資料もいくつか提供いたします。\n\n\nキャラクター\n\nエルフの女の子（人間でいうところの外見16歳～18歳くらい）\n髪色は茶色で長髪、\nサイドの髪を両側三つ編みにしている\n瞳の色は緑色\n衣装は３面図の資料がありますので\nそちらを参照してください。\n（過去のskeb依頼でも確認できます)\n\nシチュエーション\n立ち位置は横向き。\n目は両目を閉じて集中しているようないるような雰囲気\n口は詠唱中のように少し開けている\n上半身は両腕に前に伸ばして両手を立てるように前に開き\n下半身は直立している状態。\n（資料を参照ください）\n伸ばした手の少し前あたりに水が集まっていくような\n水系の魔法エフェクトでお願いしたいです。\n\nもし可能であれば、詠唱が終わる直前の\n目を開いているような差分などがあるとうれしいです。\nその際はサインの表示・非表示含めて\nPSDでお願いさせていただければ幸いです。\n\nよろしければご検討ください。\n\nhttps://drive.google.com/drive/folders/1ECJ6a4QhOArnDDvDdvoUuZlwpIZVhnGD?usp=share_link", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@tarayuki_aln/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1355070, "client_id": 1027856, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/ab943474/uploads/origins/df40171f-24e2-4f13-b007-7c5274688464?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=79a88ab9f531310e155b02f6da41dd6b", "srcset": "https://si.imgix.net/ab943474/uploads/origins/df40171f-24e2-4f13-b007-7c5274688464?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=79a88ab9f531310e155b02f6da41dd6b, https://si.imgix.net/ab943474/uploads/origins/df40171f-24e2-4f13-b007-7c5274688464?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=994cd933467ec4738b08fa8da5af1bb1 2x, https://si.imgix.net/ab943474/uploads/origins/df40171f-24e2-4f13-b007-7c5274688464?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=565a09cfde241b643d5984252cdfe52f 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/ab943474/uploads/origins/df40171f-24e2-4f13-b007-7c5274688464?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3e314fe695827f66eceffc97a8d35