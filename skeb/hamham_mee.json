e-ade4-feb9340cddd0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a9ad5f421a3414ed7abf7a525fdf5f0f", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/22d98e5e/uploads/origins/143d9ef5-ec64-443e-ade4-feb9340cddd0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d6e683acb416ba7ef95e9b0858664a45", "src_set": ""}, "body": "初めまして、蜃気楼と申します。\n推しのvtuberさん(迷狗ろん さん)のサムネがとっても可愛くて気になって調べたところ、めえさんのイラストでしたので今回リクエストさせて頂きました！\n\n◆使用用途\n•収益化を予定しているYouTubeの配信サムネイル\n•SNSへの投稿　など\n\n◆構図\n弾き語りがとても魅力的な方なので、ギターを持っている構図にして頂けると嬉しいです！\n表情はお任せいたします。\n配信やサムネイルで使用できるように、顔や髪が見切れないように書いて頂けると助かります。\nまた、人物のみの透過画像も頂けると大変助かります。\n\nここから下は前回ろんさんが依頼された際のコピペになります。\nご参考まで。\n◆キャラクター\n参考資料よりご確認いただけますと幸いです。\n折れた耳の狼の女の子で、髪は紫から白のグラデーションになっております。\n描きづらい部分ありましたら、アレンジいただいて問題ございません。\nhttps://drive.google.com/drive/folders/1--lX7EjEosvE06t869r9dXKqUWsC_v4L\n何卒ご検討、よろしくお願いいたします。", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@hamham_mee/works/12", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3323537, "client_id": 3014958, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/ac281a08/uploads/origins/24c67e33-6095-479c-a2bc-d4cdc925aa2e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5f7584ba6c0c6872f60eda9f54c0970e", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/ac281a08/uploads/origins/24c67e33-6095-479c-a2bc-d4cdc925aa2e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0e02dab3fc82cc0cbfdd25a44c07cd21", "src_set": ""}, "body": "初めまして。VTuberのさくまゆずと申します。\nいつもかわいいイラストを拝見しております。\n\n今回は、さくまのことを描いていただきたく、リクエストをお送り致しました。\n\nさくまについて\n・アフタヌーンティーとソシャゲが好き\n・モチーフアイテムはテディベアといちご、チョコレート、紅茶\n\nこだわり\n・お団子をくまの耳に見立てている為、人間の耳が見えないようにサイドの髪の毛で徹底的に隠している\n・ハイライトは常に♡（ぐるぐる目やキラキラ目等の特殊ハイライトの場合を除く）\n・口を開けると向かって右→に八重歯1本\n・お揃いコーデに身を包んだテディベアを連れている\n・外見年齢は14歳くらい。小柄で細身だけど胸は大きい\nその他の要素につきましては、自由にアレンジしていただいて問題ありせん。\nお洋服のお着替えも大歓迎です。\n\n用途\n・X、Bluesky、Misskeyにてお披露目\n・配信や動画のサムネイルへ使用\n（収益化の条件を達成した場合にはチャンネルを収益化いたします）\n・各種SNSのアイコンやヘッダー\n・挨拶ポストへの添付\n\nその他\n・サムネイルへの使用も考えておりますので、不自然に見切れていない構図だと助かります\n・人物のみのレイヤー、または背景透過済のデータをいただけると嬉しいです\n\n表情や構図等はすべてお任せしますので、明るく可愛く元気なさくまを描いていただきたいです。\n\nhttps://x.com/sksk39o/status/1830216112010899511?s=46&t=mEf1nFSobG3HRcE-AkJAug", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@hamham_mee/works/11", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3323537, "client_id": 2500427, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/28ce0be8/uploads/origins/8571e199-da41-4d9f-b1cd-a97cbd9e2147?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=30d7e36994c75a642f355ca8bcbeabda", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/28ce0be8/uploads/origins/8571e199-da41-4d9f-b1cd-a97cbd9e2147?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c2397fc7e1175c898761ac7c9b7a99c5", "src_set": ""}, "body": "こんにちは、めえ！!\n\n私はあなたのアートが大好きです！\n\n私のりんりんの秋服を描いてほしいです！りんりんは143cmで、ぺったんこで、夜はいつも星を見て喜んでいます！\n\nhttps://hoshirin.carrd.co/#autumn\n\nりんりんのコンセプト： 流れ星／星に願いを／ミュージカル／子守唄／ラベンダー／藤\n\nこの作品に似た構図を描いてください！\nhttps://skeb.jp/@hamham_mee/works/5\n\nキャラクターと背景はPSDで分けてください！\n\nご確認ありがとうございました！", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@hamham_mee/works/10", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3323537, "client_id": 2496017, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/b27c1ef0/uploads/origins/cf3b26f9-6