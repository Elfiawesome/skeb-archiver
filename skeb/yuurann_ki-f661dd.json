左側を向く）で8弦(弦が8本)でさえあれば細かいディテール等は簡略化したり変えても問題ありません。ポーズや衣装のアレンジ等も自由にしていただいて構いません。\n\nダークで耽美的なヘヴィーメタル系統の合う邪悪で禍々しい感じの楽曲に合う様なイラストに仕上げて頂けると嬉しいです。\n\n添付資料に立ち絵、所有ギターの写真、オリジナル楽曲のサンプルを添付させて頂きました。\n\nhttps://www.dropbox.com/scl/fo/acqilmpqo86bexf308baw/AL7x9FxEAC6AvJFEa23Wys8?rlkey=zu2bpygtm9ispmpveed4f1z72&dl=0", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@yuurann_ki/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1380224, "client_id": 1627681, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/09ba2add/uploads/origins/e8fc50ab-5154-4d7d-b165-618cbddb112d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=abbc3dd152de3f3db57d6aeff1ed82b1", "srcset": "https://si.imgix.net/09ba2add/uploads/origins/e8fc50ab-5154-4d7d-b165-618cbddb112d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=abbc3dd152de3f3db57d6aeff1ed82b1, https://si.imgix.net/09ba2add/uploads/origins/e8fc50ab-5154-4d7d-b165-618cbddb112d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=eea07e8a1b6455eef9a2c49f22a2be45 2x, https://si.imgix.net/09ba2add/uploads/origins/e8fc50ab-5154-4d7d-b165-618cbddb112d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=4359bf5deb170c8d00560ab23a7da129 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/09ba2add/uploads/origins/e8fc50ab-5154-4d7d-b165-618cbddb112d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f5d21505990d8dbffe1c844b27bbd3bd", "srcset": "https://si.imgix.net/09ba2add/uploads/origins/e8fc50ab-5154-4d7d-b165-618cbddb112d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f5d21505990d8dbffe1c844b27bbd3bd, https://si.imgix.net/09ba2add/uploads/origins/e8fc50ab-5154-4d7d-b165-618cbddb112d?bg=%23fff&au