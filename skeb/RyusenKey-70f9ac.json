e5-4ad9-9154-ec074db65f42?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=9e44334fd496fbaa3e498b89ab15b597 3x"}, "body": "お世話になります。\n今回は艦これの白露改二をお願いします。\n服装は改二制服（前ジッパー開け＋ノーブラ）スカートはあってもなくても。\n身長は155くらいでおっぱいは盛ってください。\n相手の男はチャラい感じで。\n体勢は立ちバックかバックで、腕を掴まれていると良いです。\n激しいピストンではなく、デカチンで一番奥をぎゅーっと押され続けてイくのが止まらないような感じでお願いします。\n嗜好に合えばよろしくお願いします。\n\nhttps://wikiwiki.jp/kancolle/%E7%99%BD%E9%9C%B2%E6%94%B9%E4%BA%8C", "nc": 176, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@TtpTtpTtpTtpT/works/224", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1810764, "client_id": 53657, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/3d2c3fc3/uploads/origins/3a1e0b6f-cb15-4441-8156-5c779f55bdc0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a0b79002624c6b3d7591601b08de0541", "srcset": "https://si.imgix.net/3d2c3fc3/uploads/origins/3a1e0b6f-cb15-4441-8156-5c779f55bdc0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a0b79002624c6b3d7591601b08de0541, https://si.imgix.net/3d2c3fc3/uploads/origins/3a1e0b6f-cb15-4441-8156-5c779f55bdc0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=910909f66282146a112a7a80820e7f46 2x, https://si.imgix.net/3d2c3fc3/uploads/origins/3a1e0b6f-cb15-4441-8156-5c779f55bdc0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=5bec4983e5a79ca2fbd94b2624430cd7 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/3d2c3fc3/uploads/origins/3a1e0b6f-cb15-4441-8156-5c779f55bdc0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3b534bd45fec705473ad1e15ff3c1135", "srcset": "https://si.imgix.net/3d2c3fc3/uploads/origins/3a1e0b6f-cb15-4441-8156-5c779f55bdc0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3b534bd45fec705473ad1e15ff3c1135, https://si.imgix.net/3d2c3fc3/uploads/origins/3a1e0b6f-cb15-4441-8156-5c779f55bdc0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=d67ff4f66b05ef3d9eab446eb1ef10e0 2x, https://si.imgix.net/3d2c3fc3/uploads/origins/3a1e0b6f-cb15-4441-8156-5c779f55bdc0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=ff1cc0dd37988c981a19226a10e546ca 3x"}, "body": "お世話になっております。\n今回も艦これから、村雨をお願いします。\n村雨改二（https://wikiwiki.jp/kancolle/%E6%9D%91%E9%9B%A8%E6%94%B9%E4%BA%8C）が深海に捕まり、「姉妹達を捕らえた、逆らえば順に沈める」という嘘で言いなりにならざるを得なくなり、同一存在でふたなりの深海雨雲姫（https://wikiwiki.jp/kancolle/%E6%B7%B1%E6%B5%B7%E9%9B%A8%E9%9B%B2%E5%A7%AB）に自ら身体を捧げるシチュでお願いします。\n\n描いて頂きたいのは何度も調教された後の状態です。\n嫌々ながら自分からなので拘束の類は一切無し。\n最初だけ悪態をつきながらまだ心は折れてないように振る舞うも、身体は度重なる調教によって相性抜群の同一存在ふたなりちんちんを奥までハメられるとあっという間に感じてしまうようになっていて、一回の射精までの間にあっけなく何度もイかされ、最後に特濃深海精子での受精アクメまでキメさせられてしまう……といった具合です。\n行為中に深海雨雲姫に「最初はあんなに反抗的だったのに」みたいな感じで煽られてほしいです。\n村雨はおっぱい爆盛りで、体位は正常位だと嬉しいです。深海雨雲姫におっぱい揉まれたり弄られてたりすると最高です。\nまた喘ぎ声は大きめ、躾けられてイく時もイくイくと叫んでしまう癖がつけられているとなお良いです。\n\n嗜好に合えばよろしくお願いします。", "nc": 56, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@TtpTtpTtpTtpT/works/160", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1810764, "client_id": 53657, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/070bd35f/uploads/origins/c2dbfccb-5b16-4023-9c99-986719f4fa3b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b4f1506c9f2ca04d5996202dc2312b49", "srcset": "https://si.imgix.net/070bd35f/uploads/origins/c2dbfccb-5b16-4023-9c99-986719f4fa3b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b4f1506c9f2ca04d5996202dc2312b49, https://si.imgix.net/070bd35f/uploads/origins/c2dbfccb-5b16-4023-9c99-986719f4fa3b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=2294fdd6f00f5c8015718aed9b55be94 2x, https://si.imgix.net/070bd35f/uploads/origins/c2dbfccb-5b16-4023-9c99-986719f4fa3b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=1c68f30a943c9eba529680acb9528a8a 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/070bd35f/uploads/origins/c2dbfccb-5b16-4023-9c99-986719f4fa3b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=88df839a01bbefd2e40546d48b16ade0", "srcset": "https://si.imgix.net/070bd35f/uploads/origins/c2dbfccb-5b16-4023-9c99-986719f4fa3b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=88df839a01bbefd2e40546d48b16ade0, https://si.imgix.net/070bd35f/uploads/origins/c2dbfccb-5b16-4023-9c99-986719f4fa3b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=726dceb0dfdc4436b851ba744ccfb7e0 2x, https://si.imgix.net/070bd35f/uploads/origins/c2dbfccb-5b16-4023-9c99-986719f4fa3b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=67f4623636339e9a1bfbe15c99f8c732 3x"}, "body": "前回は色に溺れる春雨ちゃんをありがとうございました！\n今回も、同じく春雨ちゃんをお願いしたいと思います。\n春雨改二(https://wikiwiki.jp/kancolle/%E6%98%A5%E9%9B%A8%E6%94%B9%E4%BA%8C)がふたなり駆逐棲姫(https://wikiwiki.jp/kancolle/%E9%A7%86%E9%80%90%E6%A3%B2%E5%A7%AB)に鹵獲されてねっとり寝取られてしまう様子をお願いします。\n\n体位は春雨が両手を上で拘束された立ちバックで、駆逐棲姫に抱き締められながら犯される感じでお願いします。\n前回と同じく、服装はどちらも全裸。駆逐棲姫は設定上両足がありませんが、今回は足がないと成り立たないので足アリでお願いします。\n\n以下シチュ詳細になります。\n改二になり司令官とケッコンして幸せの中にいた春雨ちゃんが駆逐棲姫に敗れて鹵獲されてしまい、司令官より大きな深海ペニスで司令官では届かない一番奥を突かれてあっけなくイかされてしまいます。\n\"初めての敗北\"に\"初めての凌辱\"、こんなに感じるはずがないのにと困惑する春雨ちゃんに駆逐棲姫は\"今、何回目だと思ってるの？\"と嘲笑を浴びせ、春雨ちゃんの全身に刻まれていた無数の淫紋を可視化させます。\n実は初めてかと思いきや、これまで何度も鹵獲されては凌辱され、深海に孕まされていた春雨ちゃんはその度に記憶と記録を改竄されて「勝利して無事に帰った」ことにされていたのでした。\n徹底的に開発されてきた身体の記憶が蘇り、司令官とのえっちでは得られなかった暴力的な快楽になすすべもなく堕ちていきます。\n……といった具合です。\nこれまで何度も孕まされていたため、胸は大きめに盛ってください。腰回りも肉付きが良いと嬉しいです。駆逐棲姫による責めもおっぱいや乳首多めでお願いします。\nまた寝取られてしまうと書きましたが、その結果等についてはお任せします。\n\n大変長々と、また多数の指定となってしまいましたが、可能な範囲で結構です。ご嗜好に合いそうでしたらよろしくお願いします。", "nc": 57, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@frozen_oyu/works/217", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1314461, "client_id": 53657, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/ce000fba/uploads/origins/f025006b-ad71-45e1-9ecd-e0a5020ddfaf?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2189ef4baa88fa65d9329318a09ed01a", "srcset": "https://si.imgix.net/ce000fba/uploads/origins/f025006b-ad71-45e1-9ecd-e0a5020ddfaf?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2189ef4baa88fa65d9329318a09ed01a, https://si.imgix.net/ce000fba/uploads/origins/f025006b-ad71-45e1-9ecd-e0a5020ddfaf?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c629b80b692a97e7151a55992cfe6f85 2x, https://si.imgix.net/ce000fba/uploads/origins/f025006b-ad71-45e1-9ecd-e0a5020ddfaf?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e3cbe0ed35795d257d720804c44550d1 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/ce000fba/uploads/origins/f025006b-ad71-45e1-9ecd-e0a5020ddfaf?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c49e66bfad922263629bed410912e963", "srcset": "https://si.imgix.net/ce000fba/uploads/origins/f025006b-ad71-45e1-9ecd-e0a5020ddfaf?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c49e66bfad922263629bed410912e963, https://si.imgix.net/ce000fba/uploads/origins/f025006b-ad71-45e1-9ecd-e0a5020ddfaf?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=3db5bb6fcc3f87bc19a48e344ceb0645 2x, https://si.imgix.net/ce000fba/uploads/origins/f025006b-ad71-45e1-9ecd-e0a5020ddfaf?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=c0565c34b310899ece2e4e09e4021261 3x"}, "body": "毎度お世話になっております。\n前回の春雨ちゃんも非常に素晴らしく、期待通り予想以上のお仕事に感謝しております。\nさて、今回依頼したいのは同じく艦これより「涼風」です。\n以前お願いした五月雨のように、今より十年後の「若妻涼風さん」でお願いします。\n現役時代より少しだけ背が伸び、おっぱいもけっこう育ち、しかし元気なところは変わりません。\n\n舞台背景：戦争が終わりしばらくして民間人の旦那と結婚した涼風さん。カラッと気風の良い彼女は町内会でも評判の元気な奥さんですが、あまりに無防備な姿を晒すため度々町内会の男共の劣情を煽ってしまっており……。\nそんなある日、仕事で家を空けがちな旦那が不在の時に、家電の修理に来てくれた町内会の若者の前でも遠慮のない姿を晒し、ムラついた男に襲われてしまうのでした。\n\nお願いしたい絵：\n涼風さん：原作より少しだけ背が伸び、おっぱいも揉み応えがあるくらいに。（以前お受け頂いたif五月雨ちゃんくらい）\n体位は「上体を起こした立ちバック」で、服装はノーブラ＋白いタンクトップがおっぱいの上までたくし上げられた状態（健康的なおっぱいは片方男に乱暴気味に揉まれていると嬉しいです）。あくまで希望であって描きやすい体位でも大丈夫です。\n下は半脱ぎのショーツとジーンズ（お手間であれば全裸で充分です）。\n男は「ガタイの良いでかいあんちゃん」という感じで、涼風とはだいぶ身長差がある。具体的なイメージとしては、立ちバックで突かれている涼風が爪先立ちになっても足らずにデカチンで押し上げられ奥まで突かれてしまうくらいです。\n旦那とする時より何倍もイかされまくってそれでも心は耐えていたのに、とどめの膣内出しで子宮が堕ちてしまうシーンを描いていただければ幸いです。\n無許可膣内出しに「おいまて」「やめろばか」など罵倒するも自身のイキ声が勝ってしまう感じでお願いします。\n\nhttps://wikiwiki.jp/kancolle/%E6%B6%BC%E9%A2%A8", "nc": 160, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@frozen_oyu/works/193", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1314461, "client_id": 53657, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/3bcb91d0/uploads/origins/2951d76e-dead-4987-a06b-afdfe1dce4cb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4533efccc3b852a7d03d650e7e5bce64", "srcset": "https://si.imgix.net/3bcb91d0/uploads/origins/2951d76e-dead-4987-a06b-afdfe1dce4cb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4533efccc3b852a7d03d650e7e5bce64, https://si.imgix.net/3bcb91d0/uploads/origins/2951d76e-dead-4987-a06b-afdfe1dce4cb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c7c8276bbdcba2f7abcc52e6592fef9a 2x, https://si.imgix.net/3bcb91d0/uploads/origins/2951d76e-dead-4987-a06b-afdfe1dce4cb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f6fa8b1978031cffe7e8e9696ee8ce8c 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/3bcb91d0/uploads/origins/2951d76e-dead-4987-a06b-afdfe1dce4cb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=22e7802eccf65ae86926d40c59bc9e76", "srcset": "https://si.imgix.net/3bcb91d0/uploads/origins/2951d76e-dead-4987-a06b-afdfe1dce4cb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=22e7802eccf65ae86926d40c59bc9e76, https://si.imgix.net/3bcb91d0/uploads/origins/2951d76e-dead-4987-a06b-afdfe1dce4cb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=e32283f4f591baec73f385a5c370fb31 2x, https://si.imgix.net/3bcb91d0/uploads/origins/2951d76e-dead-4987-a06b-afdfe1dce4cb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=3d2ede8778b8583bfb4e0705df2a644c 3x"}, "body": "大変お世話になっております。\n今回依頼したいのは艦これから春雨改二です。\nhttps://wikiwiki.jp/kancolle/%E6%98%A5%E9%9B%A8%E6%94%B9%E4%BA%8C\n押しに弱い春雨ちゃん (ケッコン済)が街でナンパされてホテルに連れ込まれてハメ倒され、最初こそゴムありだったものの力が入らなくなるまでイかされてトロトロにされてしまい、生ハメの快感から逃げられないまま膣内出しされて絶頂してしまう、という感じでお願いします。\n描いて頂きたいのは「生ハメの～」のところからで、「イく」「だめ」などの絶頂に浸るものと「中だめです」「できちゃう」などの拒絶気味の台詞の両方を吐きながらも身体は気持ちよさを選んでしまって抵抗できない感じでお願いします。\n服装は全裸、おっぱいは本来より盛ったとはっきり分かるくらい盛って貰えると嬉しいです。\n体位や構図は描きやすいものでお任せします。\n\nhttps://wikiwiki.jp/kancolle/%E6%98%A5%E9%9B%A8%E6%94%B9%E4%BA%8C", "nc": 176, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@frozen_oyu/works/163", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1314461, "client_id": 53657, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/57b26603/uploads/origins/6876fc45-2910-44d4-8c09-1421656bf403?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6f381f178da840ce66c402d6ee21b314", "srcset": "https://si.imgix.net/57b26603/uploads/origins/6876fc45-2910-44d4-8c09-1421656bf403?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6f381f178da840ce66c402d6ee21b314, https://si.imgix.net/57b26603/uploads/origins/6876fc45-2910-44d4-8c09-1421656bf403?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=81dc69cf7174e3d62dcd81b708381386 2x, https://si.imgix.net/57b26603/uploads/origins/6876fc45-2910-44d4-8c09-1421656bf403?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=8e5fa588d12d86bbbf793867edecdd6f 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/57b26603/uploads/origins/6876fc45-2910-44d4-8c09-1421656bf403?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=479bed662b718b4f0e11d919e9964972", "srcset": "https://si.imgix.net/57b26603/uploads/origins/6876fc45-2910-44d4-8c09-1421656bf403?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=479bed662b718b4f0e11d919e9964972, https://si.imgix.net/57b26603/uploads/origins/6876fc45-2910-44d4-8c09-1421656bf403?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=f9860128e60095e7f8ff5e81a57b2458 2x, https://si.imgix.net/57b26603/uploads/origins/6876fc45-2910-44d4-8c09-1421656bf403?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=2562e6b41741c9232520f0139430649d 3x"}, "body": "こんにちは、先日の海風さんの際にはとても良い仕事をして頂きありがとうございました。\n今回リクエストしたいのは同じく艦これから五月雨ちゃんです。\nhttps://wikiwiki.jp/kancolle/%E4%BA%94%E6%9C%88%E9%9B%A8\n今回は原作そのものではなくIFで「10年後、大人になった五月雨さん」です。\n真面目で純朴さを失わずに育ちつつも、背が伸びおっぱいも姉さん達のようにたわわに。\n同じく生真面目な男性に求婚され３年前に結婚しました、という感じです。\nシチュとしては、人を疑わない性格が災いしてイケメンのナンパに強引に押されて流され、言葉巧みにホテルに連れ込まれてしまい体を許してしまいます。\n少しだけ、一回だけ、そんな操の綻びから、夫しか経験のない体の性感を引き出されてあっという間に快感に落とされてしまいました。ゴムありで３回の後、ゴムがないからと生で中出しまでされてしまいます。\n\n描いていただきたいのはその後のN回戦目、快感で貞操までとろけてしまった五月雨さんが正常位でまたイかされながら中出しされている瞬間です。\n「中でいいですから」という主旨のセリフなどあれば最高です。\n服装は全裸で、髪のグラデや目つきなど五月雨ちゃんだと分かればOKです。\n少し大人っぽく、胸は多めに盛って頂ければ嬉しいです。\n可能なら普段の状態の立ち絵を添えていただけるとなお嬉しいです。\n嗜好と教義に合うようでしたらよろしくお願いします。\n\nhttps://wikiwiki.jp/kancolle/%E4%BA%94%E6%9C%88%E9%9B%A8", "nc": 177, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@TtpTtpTtpTtpT/works/93", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1810764, "client_id": 53657, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/bc4d8531/uploads/origins/68fb5b85-4b82-4834-89b9-5173186f2661?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b77307280163e6527a91a73f571a4adc", "srcset": "https://si.imgix.net/bc4d8531/uploads/origins/68fb5b85-4b82-4834-89b9-5173186f2661?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b77307280163e6527a91a73f571a4adc, https://si.imgix.net/bc4d8531/uploads/origins/68fb5b85-4b82-4834-89b9-5173186f2661?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e1cbaba5eab1c4eb74cdf41d133e4f40 2x, https://si.imgix.net/bc4d8531/uploads/origins/68fb5b85-4b82-4834-89b9-5173186f2661?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=557dd96d99abe054abb5f1546c74dca5 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/bc4d8531/uploads/origins/68fb5b85-4b82-4834-89b9-5173186f2661?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5f701ec2baf256c8f0d1c900c49e067a", "srcset": "https://si.imgix.net/bc4d8531/uploads/origins/68fb5b85-4b82-4834-89b9-5173186f2661?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5f701ec2baf256c8f0d1c900c49e067a, https://si.imgix.net/bc4d8531/uploads/origins/68fb5b85-4b82-4834-89b9-5173186f2661?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=6374c991ade6d4f332150452870cdb15 2x, https://si.imgix.net/bc4d8531/uploads/origins/68fb5b85-4b82-4834-89b9-5173186f2661?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=f65a34f24efd81fe86649f327a83bb5a 3x"}, "body": "初めまして、TtptT先生の描かれる、快楽に落とされる女の子達が素敵なので、リクエストをお送りしようと思います。\n艦隊これくしょんの駆逐艦春雨(https://wikiwiki.jp/kancolle/%E6%98%A5%E9%9B%A8%E6%94%B9)が、自分と同じ見た目のふたなりの駆逐棲姫(https://wikiwiki.jp/kancolle/%E9%A7%86%E9%80%90%E6%A3%B2%E5%A7%AB)に深海の拠点に連れ去られ、ねっとり犯されている様子を見たいです。\n春雨はふたなりではなく女の子で、駆逐棲姫だけふたなりでお願いします。二人の体格は同程度。\n服装はどちらも全裸(服がある分には構いませんが春雨は全裸が良いです)。駆逐棲姫は設定上両足がありませんが、描きやすいよう改変していただいて結構です。\n体位は春雨が仰向けで腕を拘束され(拘束の方向は上でも横でも。方法もお任せします)、駆逐棲姫が両手で春雨のおっぱいを揉みながら正常位でじっくり犯している形。\n春雨の胸については鷲掴みにされて映える程度に盛ってください。大きい分には問題ないです。\n描いて頂きたいのは、一回戦二回戦辺りではなく、数え切れないほど犯されてもう気持ちよくなってしまって僅かな抵抗もできないでいるシーンでお願いします。\nもし、もし差分など許すようであれば「犯され続けて力を奪われ色素が薄くなってしまう春雨と、力を奪い取り対象的に血色が良くなる駆逐棲姫」のようなものも頂ければ僥倖です。\n性癖に見合うようであればぜひよろしくお願いします。", "nc": 33, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@frozen_oyu/works/124", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1314461, "client_id": 53657, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/51f1e064/uploads/origins/d29447bb-ec89-4e2c-8eb3-893a9293c18d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=43d5c6a0a9e6bb49b8ee7e001c7249a3", "srcset": "https://si.imgix.net/51f1e064/uploads/origins/d29447bb-ec89-4e2c-8eb3-893a9293c18d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=43d5c6a0a9e6bb49b8ee7e001c7249a3, https://si.imgix.net/51f1e064/uploads/origins/d29447bb-ec89-4e2c-8eb3-893a9293c18d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c77302e7f6ab4f02ed70ef3fdaecf679 2x, https://si.imgix.net/51f1e064/uploads/origins/d29447bb-ec89-4e2c-8eb3-893a9293c18d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a68ca58d9435145556e739c1e80b6cc1 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/51f1e064/uploads/origins/d29447bb-ec89-4e2c-8eb3-893a9293c18d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=14cc144e7b47e0f99121818b439e3f1d", "srcset": "https://si.imgix.net/51f1e064/uploads/origins/d29447bb-ec89-4e2c-8eb3-893a9293c18d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=14cc144e7b47e0f99121818b439e3f1d, https://si.imgix.net/51f1e064/uploads/origins/d29447bb-ec89-4e2c-8eb3-893a9293c18d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=4fe6b45280b087556fe428d82e131473 2x, https://si.imgix.net/51f1e064/uploads/origins/d29447bb-ec89-4e2c-8eb3-893a9293c18d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=9fdacfe3e7a3a403e0ce573eaaf9e50a 3x"}, "body": "はじめまして、いつも冷凍お風呂さんの質の高い絵にお世話になっております。\n今回リクエストしたいのは艦これの海風改二です。\n格好は裸もしくは花束Modeで、ケッコン済み。\nシチュとしては、心に決めた提督がいるのにナンパされ押しの強いチャラ男に流されて体許してしまい、何度もイかされて奥の気持ちよさを覚え込まされてしまいます。とどめに寝バックで奥をじっくりねっとりぐりぐりされて嬌声を必死に堪えるも我慢しきれずにあられもない声を上げて深イキしてしまう……という具合です。\nお願いしたいのは、上記の「とどめに～」からの部分で、その前は背景設定と思って頂ければ幸いです。\n竿役が激しく腰を打ち付けるのではなく、執拗に弱いところをぐりぐりされるような感じなら尚良いです。\n性癖に合うようでしたらよろしくお願いします。\n\nhttps://wikiwiki.jp/kancolle/%E6%B5%B7%E9%A2%A8%E6%94%B9%E4%BA%8C", "nc": 176, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@yokoshima_/works/25", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 5315, "client_id": 53657, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/ef67e6c5/uploads/origins/febf5205-92f5-4f11-a3ac-e8411efa48a6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=acd69328f9d220950d802438eb85dbfb", "srcset": "https://si.imgix.net/ef67e6c5/uploads/origins/febf5205-92f5-4f11-a3ac-e8411efa48a6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=acd69328f9d220950d802438eb85dbfb, https://si.imgix.net/ef67e6c5/uploads/origins/febf5205-92f5-4f11-a3ac-e8411efa48a6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=676608f6633941ccb8a7c1b9f6ac4425 2x, https://si.imgix.net/ef67e6c5/uploads/origins/febf5205-92f5-4f11-a3ac-e8411efa48a6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=57d86fad09ffd6272a9673c3e48e2332 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/ef67e6c5/uploads/origins/febf5205-92f5-4f11-a3ac-e8411efa48a6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=20493be210f310448568d910d2857a00", "srcset": "https://si.imgix.net/ef67e6c5/uploads/origins/febf5205-92f5-4f11-a3ac-e8411efa48a6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=20493be210f310448568d910d2857a00, https://si.imgix.net/ef67e6c5/uploads/origins/febf5205-92f5-4f11-a3ac-e8411efa48a6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=552765572f17b8daf0df367c1220de54 2x, https://si.imgix.net/ef67e6c5/uploads/origins/febf5205-92f5-4f11-a3ac-e8411efa48a6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=87e407a703638f0133fb45a96f3f1a57 3x"}, "body": "初めまして。\n艦これの涼風×五月雨ちゃんのイラストを依頼させて頂きたいです。\n構図としては、\n「ベッドか布団に仰向けに押し倒されているさみちゃんと、さみちゃんを押し倒して丹念にさみちゃんのおっぱいを吸い責めする涼風」\nの組み合わせでお願いします。服装は二人とも全裸で、吸われてない方の乳首も涼風が指でこりこりしてるとなお良いです。\n表情は涼風は目を閉じて丁寧に責めてる感じで、さみちゃんは気持ちよさにとろんとしてると良いと思います。\nもし時間経過差分など頂けるならば、差分前のさみちゃんは「くすぐったい＆気持ちいい」くらいで、差分後は何回もイカされてとろけた表情でされるがままになっていると嬉しいです。\nアングルはさみちゃんの頭側からだと最高ですが、煩雑になるようであれば問いません。\nもし性癖に見合うようでしたらよろしくお願いします。", "nc": 33, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "similar_creators": [{"id": 14430, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "笹松しいたけ🌉8/15コミ