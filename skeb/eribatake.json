仰向けに寝ている状態\n\n天音ちゃんに挿入しているものと朱音ちゃんに挿入しているものをそれぞれ描いていただきたいです\n\n可能でしたら、姉妹とも黒ずんだ乳輪とボテ腹になっている妊婦状態の差分をお願いしたいです\n\nえっちな効果音をつけていただき、その他はお任せでお願いします\n\n2キャラのご依頼でお手数をお掛けしますが、どうかご検討をよろしくお願い致します", "nc": 33, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@eribatake/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3674508, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/1a05330d/uploads/origins/2b4a26aa-8a23-45f7-bb7b-3a8104637423?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=193972bd52959660a134c062e141383d", "srcset": "https://si.imgix.net/1a05330d/uploads/origins/2b4a26aa-8a23-45f7-bb7b-3a8104637423?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=193972bd52959660a134c062e141383d, https://si.imgix.net/1a05330d/uploads/origins/2b4a26aa-8a23-45f7-bb7b-3a8104637423?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=d696e0c87465f61a97b65537e1d9ee1c 2x, https://si.imgix.net/1a05330d/uploads/origins/2b4a26aa-8a23-45f7-bb7b-3a8104637423?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=918c4a711aec6aa865fda165b886b76e 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/1a05330d/uploads/origins/2b4a26aa-8a23-45f7-bb7b-3a8104637423?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d0e6d57e97ff34c3c87697ef3afec73e", "srcset": "https://si.imgix.net/1a05330d/uploads/origins/2b4a26aa-8a23-45f7-bb7b-3a8104637423?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d0e6d57e97ff34c3c87697ef3afec73e, https://si.imgix.net/1a05330d/uploads/origins/2b4a26aa-8a23-45f7-bb7b-3a8104637423?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=679063b06addc4f452f20880ccb58633 2x, https://si.imgix.net/1a053