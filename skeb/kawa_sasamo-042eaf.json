6-0db5-4f06-84a0-1b4270eb5f28?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=79ef13cf2f41c6a66d79b0658a40388e", "srcset": "https://si.imgix.net/fe5b0303/uploads/origins/120fa0c6-0db5-4f06-84a0-1b4270eb5f28?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=79ef13cf2f41c6a66d79b0658a40388e, https://si.imgix.net/fe5b0303/uploads/origins/120fa0c6-0db5-4f06-84a0-1b4270eb5f28?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=42802d832b248e99f9bfe8c1fb39b058 2x, https://si.imgix.net/fe5b0303/uploads/origins/120fa0c6-0db5-4f06-84a0-1b4270eb5f28?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=089268a378495401b2f503b16a76378d 3x"}, "body": "はじめまして。TwitterのRTより河魚笹藻様のイラストを拝見し、可愛い絵柄でぜひ依頼させていただきたく、ご連絡致しました。\n初めて利用させていただくため、至らぬ点もあると思いますが、何卒よろしくお願いいたします。\n\n今回、男女2人を描いていただきたいです。\n関係性としては、双方片想いに近い感情を抱いていましたが表にはそれを出さず(男の子の方には妻がいます)、友達として仲がいい2人となります。\n\n■岸根蛍 (きしね けい)／画像：灰色カーディガンの女の子\n25歳/女/OL\n\n事務系のお仕事をしている女の子です。\n無気力系、といえばいいんでしょうか。夢や希望を大きく掲げているわけではなく、どちらかというと社畜寄りの子です。\nどこか冷めていて、人生あんまり楽しそうじゃないけど、自分の力で生きたい！という自立のニーズが強いので頑張って生きてます。\n物静かで自分から色々喋る方ではないのですが、もう1人、蒼くんといるときはいつもより笑っているイメージです。\n\n■氷室蒼(ひむろ あお)／画像：ベージュカーディガンの男の子\n25歳/男\n蛍とは対照的に、誰にでも優しく、誰とも隔たりなく会話するタイプの方です。完璧超人…？！\n公言していませんが名家の跡取りで、親に言われるまま生きてきたことが蒼の中でわだかまりとして存在しています。蛍のことは自立している姿を眩しく思いつつ、何かと心配してくれていて、息抜きに遊びに誘っているようなイメージです。\n\n構図等、友人2人で仲良さそうにしているものであればなんでも嬉しいです。\nもし指定が必要ということであれば、Twitterでツリーにございました、並んで歩いているお姿や、顔を見合わせて笑いあっているようなお姿が可愛いな、と思っています。\n\n一点だけお願いがございまして、2人とも「友人である」意識が強いので、手を繋ぐ、等のスキンシップや、ハートマークを避けていただけますと幸いです。\n\n表情差分等がなく、キャラ設定のみで伝わりにくいところもあり大変恐縮ですが、何卒よろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/15QVZBhaINU__zTpHpROESg9YPapIuPpn", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@kawa_sasamo/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 880741, "client_id