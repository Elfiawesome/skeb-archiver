ただきました。\n\n幸せそうに笑うご家族が見たい！！と思い、こういった構図でとは思いましたが、\n難しければ、描きやすいように描いていただければ幸いです。\n\n宜しくお願い致します。\n\nhttps://drive.google.com/drive/folders/1y_yQu6Rz7-O6AF9ERFASdSBTVJ4qJROk?usp=sharing", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@kawa_sasamo/works/2", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/2f771915/uploads/origins/be20dbdd-1ce3-4de2-9777-08872b60919b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=01ab8cb36946c1d3f228cf674d8dd4d9", "srcset": "https://si.imgix.net/2f771915/uploads/origins/be20dbdd-1ce3-4de2-9777-08872b60919b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=01ab8cb36946c1d3f228cf674d8dd4d9, https://si.imgix.net/2f771915/uploads/origins/be20dbdd-1ce3-4de2-9777-08872b60919b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=fbfbecf0aa6ea59173fd7c97aed0fe6d 2x, https://si.imgix.net/2f771915/uploads/origins/be20dbdd-1ce3-4de2-9777-08872b60919b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=4743880a54ad0a02e261054905325e34 3x"}, "private": true, "genre": "art", "tipped": false, "creator_id": 880741, "client_id": 2701365, "nc": 129}, {"path": "/@kawa_sasamo/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 880741, "client_id": 2452340, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/668be100/uploads/origins/225563d7-dd27-4613-94be-fee810202838?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fe42674ba