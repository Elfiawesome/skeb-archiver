ただけませんか？現代のSF設定です。\n\nアロイス\n180センチ。金髪の男性。\nエネルギッシュでいたずら好き、ずる賢い性格。普段の表情は満面の笑み。\n\nゲイブ\n186センチ。グレーヘアーの男性。\n普段の表情は笑顔。不遜でカジュアルな性格。クールでチャーミング。\nエイリアン・テクノロジーの研究開発会社を率いる悪役軍人。物作りが好きなエンジニアでもある。\n\n付き合っているラブラブカップル。\n\nポーズのアイデアは以下の通り：\n- ゲイブがアロイスに散髪をしている。\n- ゲイブとアロイスが果樹園で一緒にリンゴ狩りをしている。\n- ゲイブとアロイスが一緒に映画館にいる。アロイスがゲイブに寄り添っているが、ゲイブは眠っている。\n- その他、お好きなキュートでロマンチックなシーン\n\n使用目的SNS、OC活動、印刷など個人的な閲覧のみ\n\nありがとうございました！\n\nhttps://drive.google.com/drive/folders/1atjIzPqghGCslfuaHI8uE5rk5gzVuPSz?usp=sharing", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@ha_na_zu_ma_ri/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3758684, "client_id": 1988381, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/881bfe82/uploads/origins/59be12ed-6bbb-4564-8c40-2ed97759e473?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ff7a2d17a1e806733ee6c83239434d85", "srcset": "https://si.imgix.net/881bfe82/uploads/origins/59be12ed-6bbb-4564-8c40-2ed97759e473?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ff7a2d17a1e806733ee6c83239434d85, https://si.imgix.net/881bfe82/uploads/origins/59be12ed-6bbb-4564-8c40-2ed97759e473?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=97e1bf6845cc8df4b5e301cc8e52fbeb 2x, https://si.imgix.net/881bfe82/uploads/origins/59be12ed-6bbb-4564-8c40-2ed97759e473?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=45e006d512283f48326b000bb917bdb0 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/881bfe82/uploads/origins/59be12ed-6bbb-4564-8c40-2ed97759e473?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=4992ade72eb94c0c9ce34d9c6ca7a7fd", "srcset": "https://si.imgix.net/881bfe82/uploads/origins/59be12ed-6bbb-4564-8c40-2ed97759e473?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=4992ade72eb94c0c9ce34d9c6ca7a7fd, https://si.imgix.net/881bfe82/uploads/origins/59be12ed-6bbb-4564-8c40-2ed97759e473?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=92ed4483808108450c3341d503f518d8 2x, https://si.imgix.net/881bfe82/uploads/origins/59be12ed-6bbb-4564-8c40-2ed97759e473?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=a0003531158c0257fc7d561380d42e40 3x"}, "body": "こんにちは、\n\n 今日は僕のOCと僕の友達のOCの絵を描いてほしいんだ。彼らは海賊のふりをして一緒に楽しんでいる二人の少年です。彼らはカップルです！名前はセスとフック！\n\nセスは筋肉隆々の大男で、食べるのが大好きでよく笑う。気さくで陽気！\n\nフックは内気な少年で、海賊の格好をしているときは自信満々なふりをする。\n\n\n海賊の格好をしていないときにセスと一緒にいると、恥ずかしさを感じてしまう。\n\n作者には楽しんで描いてもらいたい！セスは210cm、フックは180cmです！よろしくお願いします！\n\n金額が足りなかったらアピールしてください\n\nhttps://drive.google.com/drive/folders/1semYggkuHfh46cNYK6m4AZmgbDOIKCVK", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@ha_na_zu_ma_ri/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3758684, "client_id": 187493, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/bf2f73e8/uploads/origins/e74e0822-982b-4709-9b37-751171554768?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=cda520788addf1236970fea5e3586f0f", "srcset": "https://si.imgix.net/bf2f73e8/uploads/origins/e74e0822-982b-4709-9b37-751171554768?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=cda520788addf1236970fea5e3586f0f, https://si.imgix.net/bf2f73e8/uploads/origins/e74e0822-982b-4709-9b37-751171554768?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=60f824f8682dc347b2e45b3c08618e43 2x, https://si.imgix.net/bf2f73e8/uploads/origins/e74e0822-982b-4709-9b37-751171554768?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=9a1cfda3a5ef5e57e85c361bfdb9c071 3x"}, "duration": null