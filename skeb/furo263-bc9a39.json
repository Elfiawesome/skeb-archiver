モンスターハンターをもてあそび、どれだけ彼女の神経を逆なでできるか試している。\n\n私が考えていたのは、ハンターが受けた戦いの傷を、ヴァンパイアが戯れに抱きしめたり舐めたりするシーンだ。天敵であることを禁じられた二人の奇妙な、敵対的な、時には愛情深い関係を示すような何か。\n\n服装やシーンの改変はご自由にどうぞ。どんなものが出来上がるか、ぜひ見てみたいです\n\nありがとうございました！", "nc": 176, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@furo263/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3814269, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/049e6b9f/uploads/origins/d35008da-3eb7-4986-bb70-a555dfbec20a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ba71ecfbc6b1977ac8d9a71e3f52c915", "srcset": "https://si.imgix.net/049e6b9f/uploads/origins/d35008da-3eb7-4986-bb70-a555dfbec20a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ba71ecfbc6b1977ac8d9a71e3f52c915, https://si.imgix.net/049e6b9f/uploads/origins/d35008da-3eb7-4986-bb70-a555dfbec20a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=67d794cce8c4ac80fb4006da507ab730 2x, https://si.imgix.net/049e6b9f/uploads/origins/d35008da-3eb7-4986-bb70-a555dfbec20a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=505c5eaee4b5076815685574cdcca912 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/049e6b9f/uploads/origins/d35008da-3eb7-4986-bb70-a555dfbec20a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=bc7a3eafb70d764d7b205728439a75d8", "srcset": "https://si.imgix.net/049e6b9f/uploads/origins/d35008da-3eb7-4986-bb70-a555dfbec20a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=bc7a3eafb70d764d7b205728439a75d8, https://si.imgix.net/049e6b9f/uploads/origins/d35008da-3eb7-4986-bb70-a555dfbec20a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=0caeed1e53c4e86f67e00de0c2ecb49a 2x, https://si.imgi