と重要な身体的特徴は添付のリンクにあります。\n\nこのリクエストを読んでいただき、本当にありがとうございます。\n\nhttps://drive.google.com/drive/folders/1-FbszAxkFD1S3fTpT-4KJyyhW2vvpFii", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@kanikumitoi/works/24", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1000726, "client_id": 1348387, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/b1cdb59d/uploads/origins/24b2aefc-4b79-4904-a81c-1d5c13136da4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=97143a4eba95c4e50b84155e104bd41c", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/b1cdb59d/uploads/origins/24b2aefc-4b79-4904-a81c-1d5c13136da4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f371085f04ff7291ee0e3cd8ab32355c", "src_set": ""}, "body": "こんにちは、私は長い間あなたの絵が大好きでした。私のキャラクターのアートを依頼したいです。\n\n私のキャラクターは、古いテレビやサイバー・グランジ・スタイルのようなレトロなテクノロジーがとても好きなんです。私のチャーターを使ったアートを作るために、あなたにクリエイティブな自由を与えたいと思います！\n\nそれではまた！\n\nhttps://drive.google.com/drive/folders/1LBJf3XjsJ9DE7gIywq7Ud-TS5mqjoAZb?usp=sharing", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@kanikumitoi/works/23", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1000726, "client_id": 2459698, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/445a3212/uploads/origins/4963ad11-393e-485a-a7c9-5cca125f1f64?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2d34acdd5959b13bd30ffcfeeb028a70", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/445a3212/uploads/origins/4963ad11-393e-485a-a7c9-5cca125f1f64?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b76e