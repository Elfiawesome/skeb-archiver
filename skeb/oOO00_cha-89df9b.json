ive.google.com/drive/folders/1-DgSfCj7oGTJ2tbky_5Ahbuntpp_riH4", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@oOO00_cha/works/7", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/6e064eb1/uploads/origins/fb810a9e-4801-4ca3-8c0d-94a775c01fbc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=967f6bd4029d980e700ee0022bc62276", "srcset": "https://si.imgix.net/6e064eb1/uploads/origins/fb810a9e-4801-4ca3-8c0d-94a775c01fbc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=967f6bd4029d980e700ee0022bc62276, https://si.imgix.net/6e064eb1/uploads/origins/fb810a9e-4801-4ca3-8c0d-94a775c01fbc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=63edc202c05d13fec51c465020ddbdff 2x, https://si.imgix.net/6e064eb1/uploads/origins/fb810a9e-4801-4ca3-8c0d-94a775c01fbc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=d5f35e443f498c3db95a845bf6737ecf 3x"}, "private": true, "genre": "art", "tipped": false, "creator_id": 2970483, "client_id": 2742309, "nc": 145}, {"path": "/@oOO00_cha/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2970483, "client_id": 2610475, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/291e817c/uploads/origins/951acc98-af37-454d-9c4d-8cc7d5a30f48?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b823492ce91c72e68506afecf5c998ad", "srcset": "https://si.imgix.net/291e817c/uploads/origins/951acc98-af37-454d-9c4d-8cc7d5a30f48?bg