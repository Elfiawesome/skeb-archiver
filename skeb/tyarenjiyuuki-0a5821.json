ki\n固定ツイートのツリーに三面図があります\n\nyoutube\nhttps://www.youtube.com/channel/UCRIBpzUpX_K4E4EefdDNWtw\n↓自己紹介動画として一問一答を紹介させていただきます\nhttps://www.youtube.com/watch?v=jonhjHB8Q3I\n\n何卒よろしくおねがいいたします…！", "nc": 17, "word_count": 0, "transcoder": "video", "creator_acceptable_same_genre": true}], "similar_creators": [{"id": 429786, "creator": true, "nsfw_acceptable": false, "acceptable": false, "name": "🍓PECO🍓", "screen_name": "_PECOROOM_", "avatar_url": "https://pbs.twimg.com/profile_images/2053812653144121344/c7_ez3w_.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1046155668833488896/1779097535/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "art"}], "banned": false, "nc": 177}, {"id": 1843330, "creator": true, "nsfw_acceptable": false, "acceptable": false, "name": "333", "screen_name": "dai210924", "avatar_url": "https://pbs.twimg.com/profile_images/1517161999523741701/7plkxBLL.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1390248900267708419/1747811102/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "art"}], "banned": false, "nc": 48}, {"id": 2610607, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "蓮/はす", "screen_name": "hasunohato_", "avatar_url": "https://pbs.twimg.com/profile_images/1799474768032444416/Pu61EYxF.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1418359247708901376/1777554569/1500x500", "appeal_receivable": false, "popular_creator_rank": 66, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 10, "complete_expir