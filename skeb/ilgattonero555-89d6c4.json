1dc9/uploads/origins/2cce2b87-3b96-48aa-ad46-4d2dd01f64cd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3e5df5fcf3b5c3261a358760422315ed", "srcset": "https://si.imgix.net/23df1dc9/uploads/origins/2cce2b87-3b96-48aa-ad46-4d2dd01f64cd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3e5df5fcf3b5c3261a358760422315ed, https://si.imgix.net/23df1dc9/uploads/origins/2cce2b87-3b96-48aa-ad46-4d2dd01f64cd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=671f44afdb7f58b977f0920b177cc60c 2x, https://si.imgix.net/23df1dc9/uploads/origins/2cce2b87-3b96-48aa-ad46-4d2dd01f64cd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=cf73b8f42d92364065bb300c833c5658 3x"}, "body": "こんにちは！\n是非色綺さんに私のイラストを描いてほしくリクエストをお送りしました！\n\n▼依頼内容\n5月に誕生日を迎えるので、自分へのご褒美で「いるがっとねろ（黒猫の姿）」の誕生日イラストを描いていただきたいです！\n期限はいつまででも大丈夫です！今年中にいただければ嬉しいなというくらいの緩い気持ちです\n\nデザインとしては黒～灰色の毛で毛先が少し緑がかっていて、べっ甲メガネをしています。耳毛があり、頬の横も毛がふさふさしています\nデフォルト衣装は青シャツに緑のセーターですが、こだわりはないので衣装はお任せいたします。\n以前他の方に描いていただいたことがあるのでそのURLを記載いたします\nhttps://x.com/nibiiroibushi/status/1948059375756791851\nこちらやアイコンを参考にしていただければわかりやすいかと思いますが、ほかに資料が必要であればお声かけ頂ければお送りいたします。\n\nどういう構図のイラストか等の指定はありません\n等身やデフォルメ具合などもすべてお任せします！\n丸投げで申し訳ありませんが、色綺さんが思うように描いていただければ嬉しいです\n\n▼用途\n・投稿やプロフィールアイコンなどSNSでの使用\n・自分用にステッカーやポスターにして楽しむ\n・時折眺めてにまにまする\n・もしかすると今後何かのサムネに使用するかもしれません", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@nibiiroibushi/works/69", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2213434, "client_id": 2529, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/167a7ec7/uploads/origins/963194ed-05fa-4780-8d7e-11d88a74f124?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=290ef9919eb8665038b5aa2d335a5a33", "srcset": "https://si.imgix.net/167a7ec7/uploads/origins/963194ed-05fa-478