bf9c/uploads/origins/6a07d984-5f74-41a1-ae5d-ac6ab76ab52b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=707bd44110102fb2be2750ebafeb0958", "srcset": "https://si.imgix.net/5a17bf9c/uploads/origins/6a07d984-5f74-41a1-ae5d-ac6ab76ab52b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=707bd44110102fb2be2750ebafeb0958, https://si.imgix.net/5a17bf9c/uploads/origins/6a07d984-5f74-41a1-ae5d-ac6ab76ab52b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=26ef863b1288a4c3726a095de51ee0fe 2x, https://si.imgix.net/5a17bf9c/uploads/origins/6a07d984-5f74-41a1-ae5d-ac6ab76ab52b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=1d5cf05f6ef4687e6817ce3d96863fda 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/5a17bf9c/uploads/origins/6a07d984-5f74-41a1-ae5d-ac6ab76ab52b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=17def583d7316dfdc6415bab2e183570", "srcset": "https://si.imgix.net/5a17bf9c/uploads/origins/6a07d984-5f74-41a1-ae5d-ac6ab76ab52b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=17def583d7316dfdc6415bab2e183570, https://si.imgix.net/5a17bf9c/uploads/origins/6a07d984-5f74-41a1-ae5d-ac6ab76ab52b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=c1d468adc1e9e76be4f975fc7c3ea869 2x, https://si.imgix.net/5a17bf9c/uploads/origins/6a07d984-5f74-41a1-ae5d-ac6ab76ab52b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=4d9ba63c52c83070092fd1d55bd6d843 3x"}, "body": "はじめまして！\nTwitterで拝見した、北崇先生の描かれる女の子のムチテカ感と煽情的な表情に一目惚れして\n今回メッセージを送らせていただきました！\nぜひ先生の作風で描いていただきたいキャラがいるので、\nもしお時間と作業量で可能でしたらイラストのご依頼をさせていただけると嬉しいです。\n\nリクエストですが\nメギド72のアスモデウス(資料url参照)のR18イラストになります。\n公式のキャラ設定に引っ張られず体型は盛りに盛って頂いて構いません。\n(アスモデウスのキャラ設定としては自分が絶対的な存在であると強く認識しており、\n実際それに見合った実力の持ち主で、強大な力と尊大な態度、\n美しく強靭な肉体を持ち合わせる、誇り高き性格の持ち主となります。）\n\nシチュとしては戦闘後の興奮で火照りが収まらないアスモデウスが、\n汗だくムレムレの発情状態で騎乗位でセックスしているところをお願いします。\n\nまた納品はPSD形式でお願いしたいです。\n\n衣装に関しては乳房や、陰部が見えるような衣装であれば\n原作衣装にとらわれず自由におまかせしたいと思います。裸でも構いません。\nその他の構図や体位などの詳細についても先生におまかせしたいです。\n\n以上が依頼内容になりますが、資料や原作設定にとらわれず\n筆が乗るように自由にやって頂いて構いません。\nヒールなしで186cmの態度も尻もデカい銀髪爆乳デカ乳筋肉質汗臭なアスモさんを題材に、\nえっちな雰囲気マシマシのイラストを描いていただきたい！\nという主旨のリクエストになります。\n衣装やシチュ、体位、構図など自由に変更していただいて結構ですし、\n要素が多すぎると思われたならオミットしていただいて構いません。\n先生の描きやすいように描いていただけると嬉しいです。アレンジ大歓迎です！\n\n最後になりますが是非ご検討の程よろしくお願いします。\n\nhttps://imgur.com/a/zALYlqL", "nc": 32, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 269285, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "ZEN", "screen_name": "ZEN_KAMURO", "avatar_url": "https://pbs.twimg.com/profile_images/1987162171860787201/KjMGbd29.jpg", "header_url": "https://pbs.twimg.com/profile_banners/115044354/1762611357/1500x500", "appeal_receivable": false, "popular_creator_rank": 5, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "art"}], "nc": 48}, {"id": 352305, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "おりがみ彩💚ご依頼受付中🎨", "screen_name": "origamisayah", "avatar_url": "https://pbs.twimg.com/profile_images/1998163791457230848/Keh9BnGM.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1196992873817706496/1742703431/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 2, "complete_expiration_days": 60, "skills": [{"genre": "art"}, {"genre": "comic"}, {"genre": "correction"}], "nc": 177}, {"id": 841856, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "塔ヶ崎💚", "screen_name": "t000_kas", "avatar_url": "h