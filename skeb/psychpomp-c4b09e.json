=top&w=200&h=200&s=a2d32f18028b2f2438b26376480cc606 2x, https://si.imgix.net/8389d91d/uploads/origins/5dbbcf2a-37cf-415c-9237-30f652a31d19?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=aa7d78d9e37eb5dd860c2132241f287e 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/8389d91d/uploads/origins/5dbbcf2a-37cf-415c-9237-30f652a31d19?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=dcdd30900e0825f226d921b6be2a8373", "srcset": "https://si.imgix.net/8389d91d/uploads/origins/5dbbcf2a-37cf-415c-9237-30f652a31d19?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=dcdd30900e0825f226d921b6be2a8373, https://si.imgix.net/8389d91d/uploads/origins/5dbbcf2a-37cf-415c-9237-30f652a31d19?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=09a56f0ffd576cffef45f689838cb83f 2x, https://si.imgix.net/8389d91d/uploads/origins/5dbbcf2a-37cf-415c-9237-30f652a31d19?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=9a54ac25092ddeaa8dd4bd13d639f892 3x"}, "body": "・名前：紫藤 聖（女性） \n・年齢：３０歳 \n・誕生日：１２月２４日 \n・外見：身長は163cm。ミルクティー色のショートヘア（学生時代は腰まで届くぬばたまの髪）、気怠げな花色の瞳、薔薇をかたどったラピスラズリのピアスを嵌めている。 \n・性格：人と関わるのを避ける一匹狼タイプ。冷静沈着だが、その心には激しい熱情を抱く。\n ・ファッション：仕事着はスーツ。普段着はエレガントなものを好み、よく着るのはワンピース。\n ・備考：幼い頃からピアノを習っていたが、小学校卒業を機にやめる。(師にピアノ留学を勧められるが、趣味に留めたい理由で断る) \nまた、学生の時から成績優秀で、薬学部を首席卒業する。 ２０歳に一番の親友(初恋の人でもある。神学部在籍の修道女見習い)が事件に巻き込まれて鬼籍になったことがきっかけで、薬剤師の道から警察官になることを志す。 \nお酒大好き、酒豪 \nイメージの花は白百合 \n\n 時子様、再度リクエストさせて頂きました。\n先程のは一旦キャンセルしております。\nお手数をお掛けしており、申し訳ございません。\nどうぞ宜しくお願いしますm(_ _)m", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@psychpomp/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 997247, "client_id": 1003909, "vtt_url": null, "thumbnail_image_urls": {"src": "https://