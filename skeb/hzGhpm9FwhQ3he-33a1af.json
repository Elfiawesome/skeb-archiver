aghostie）のVtuberキャラクターのアートワークをお願いしたいです！\n\n彼女のキャラクターは可愛くておちゃめで、時々ツンデレです。ゲーマーでもあります！\n\n構図はお任せするので、かわいいと思うものを描いてください！あと、できればサインは別レイヤーにしてもらえますか？\n\n自動翻訳でわかりやすいといいのですが。よろしくお願いします！\n\nhttps://drive.google.com/file/d/1DzzAzyUV5DvFRHqKioNeizMLNkVvYe65/view?usp=sharing", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@hzGhpm9FwhQ3he/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1973406, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/96087910/uploads/origins/5d5fad7d-d47d-404d-9742-20ea7d7d3cc1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=78e0e707922c3d4a02f990bf7560cc5a", "srcset": "https://si.imgix.net/96087910/uploads/origins/5d5fad7d-d47d-404d-9742-20ea7d7d3cc1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=78e0e707922c3d4a02f990bf7560cc5a, https://si.imgix.net/96087910/uploads/origins/5d5fad7d-d47d-404d-9742-20ea7d7d3cc1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=609ae40cd38b11372d250a286cd960cc 2x, https://si.imgix.net/96087910/uploads/origins/5d5fad7d-d47d-404d-9742-20ea7d7d3cc1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ab9ec155dc392672f28622d02debb726 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/96087910/uploads/origins/5d5fad7d-d47d-404d-9742-20ea7d7d3cc1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c4cc5a886f88604bf90aac0516bf3185", "srcset": "https://si.imgix.net/96087910/uploads/origins/5d5fad7d-d47d-404d-9742-20ea7d7d3cc1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c4cc5a886f88604bf90aac0516bf3185, https://si.imgix.net/96087910/uploads/origins/5d5fad7d-d47d-404d-9742-20ea7d7d3cc1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w