6-4cbd-b30e-7f6a9370928c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f74973b33417b9c17595e24020de15bb 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/70baf774/uploads/origins/68b31ace-7026-4cbd-b30e-7f6a9370928c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e7bc2a510065deb0ece4f0c833757588", "srcset": "https://si.imgix.net/70baf774/uploads/origins/68b31ace-7026-4cbd-b30e-7f6a9370928c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e7bc2a510065deb0ece4f0c833757588, https://si.imgix.net/70baf774/uploads/origins/68b31ace-7026-4cbd-b30e-7f6a9370928c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=35a352f04f5b2a2727f7db27b55cf05b 2x, https://si.imgix.net/70baf774/uploads/origins/68b31ace-7026-4cbd-b30e-7f6a9370928c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=8cec587f76c858fd8514263131bffd90 3x"}, "body": "はじめまして。沢山の素敵なイラストの掲載ありがとうございます。\n今回は私のSNS等のアイコンを制作して頂きたく、依頼をするに至りました。依頼を送るのは初めてで、不手際等がありましたらすみません。\n\n依頼の内容としては、「東方Projectの藤原妹紅が、maimaiシリーズのソルトに膝枕をする」という物になります。\nもこたんの膝の上にソルトちゃんが寝ている、という形でお願いします。\n\nソルトの衣装はFESTiVALで新たに登場した衣装でお願いします。以下のリンクに公式からの情報がありますので、こちらを参考にして下さい。\nhttps://maimai.sega.jp/area/hapifes/\n二人とも幸せそうに微笑んでいる表情でお願いします。\nその他の構図等お知らせできていない部分に関しましては、作者様にお任せ致します。\n\nまた、SNS等(TwitterやMisskey等)のアイコンに使用させて頂きたいため、画像サイズは正方形(に近いサイズ)での納品をお願い致します。\n\n長文になってしまいましたが、何卒よろしくお願い致します。\n\nhttps://youtu.be/kK8wxlnYyJI?si=tk6R9bbnz3o7g-wE", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Moneko_123/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2874897, "client_id": 31138, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/ce668a25/uploads/origins/7af7e77b-814d-4807-b01f-eb2b7277a2b6?b