c9c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=78165e6e09ab33a5b29bb1c0316c9d1e 3x"}, "body": "こんにちは、\n僕のリクエストに時間を割いてくれてありがとう！あなたの画風がとても好きなので、私のキャラクターを描いていただけたら光栄です。私はVtuberの受付嬢（新しいペルソナにリブランディング中）です。\n\n2枚目の衣装を着て、髪の色を明るくして、眠そうな感じか、仕事から起きたばかりのような感じで描いていただきたいです。絵の比率は16：9でお願いします。PSDファイルもいただけますか？\n\n余談ですが、私のキャラクターの髪の色は2色あります。暗い色がメインです。また、衣装も2種類あります。もし私が提案したコンセプトがお好みでなければ、ご自由にお好きなデザインを作ってください。\n\n私のモデル：https://drive.google.com/drive/folders/193jN_A4UAESLe5qT1Vv9AFQfQmDu-4Ge?usp=sharing\n\nご検討ありがとうございます。よろしくお願いいたします。", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@emamimu/works/15", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/e53bf08f/uploads/origins/f5f21f95-b1b3-46bb-86e0-635c4c928a6b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=0d3b994833527c6679032503798eb690", "srcset": "https://si.imgix.net/e53bf08f/uploads/origins/f5f21f95-b1b3-46bb-86e0-635c4c928a6b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=0d3b994833527c6679032503798eb690, https://si.imgix.net/e53bf08f/uploads/origins/f5f21f95-b1b3-46bb-86e0-635c4c928a6b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=c36859f9b728e0fb6d229558feaaaa2b 2x, https://si.imgix.net/e53bf08f/uploads/origins/f5f21f95-b1b3-46bb-86e0-635c4c928a6b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=fef9aa7f86f19d9d5368470348dcd8a6 3x"}, "private": true, "genre": "art", "tipped": true, "creator_id": 564881, "client_id": 2031991, "nc": 144}, {"pat