oogle.com/drive/folders/1023lwrqzvQYVtS5GVXKKkAbpm7YN-CiV", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@emamimu/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 564881, "client_id": 2031991, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/47cd55f0/uploads/origins/b028ea33-3ffa-47ff-a07b-3d9b58a4c95f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=db9c0d7961a1bef84a72b3083325d852", "srcset": "https://si.imgix.net/47cd55f0/uploads/origins/b028ea33-3ffa-47ff-a07b-3d9b58a4c95f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=db9c0d7961a1bef84a72b3083325d852, https://si.imgix.net/47cd55f0/uploads/origins/b028ea33-3ffa-47ff-a07b-3d9b58a4c95f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b978f472f984319c394ca64804e311ba 2x, https://si.imgix.net/47cd55f0/uploads/origins/b028ea33-3ffa-47ff-a07b-3d9b58a4c95f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=151c308f27a503a8a67b269c45d1088a 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/47cd55f0/uploads/origins/b028ea33-3ffa-47ff-a07b-3d9b58a4c95f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5f141629090c6dd01ffc69ebdb5fd5bf", "srcset": "https://si.imgix.net/47cd55f0/uploads/origins/b028ea33-3ffa-47ff-a07b-3d9b58a4c95f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5f141629090c6dd01ffc69ebdb5fd5bf, https://si.imgix.net/47cd55f0/uploads/origins/b028ea33-3ffa-47ff-a07b-3d9b58a4c95f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=0dd15c0645916f5a02108ed10d3c68bb 2x, https://si.imgix.net/47cd55f0/uploads/origins/b028ea33-3ffa-47ff-a07b-3d9b58a4c95f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit