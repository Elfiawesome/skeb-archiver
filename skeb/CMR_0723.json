coder": "image", "creator_acceptable_same_genre": true}, {"path": "/@CMR_0723/works/8", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1476706, "client_id": 3192977, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/95b981a2/uploads/origins/ac668efd-2901-48fc-82ac-594cb3b245a4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b5e6836c77d347adfe2131508cf5f0dd", "srcset": "https://si.imgix.net/95b981a2/uploads/origins/ac668efd-2901-48fc-82ac-594cb3b245a4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b5e6836c77d347adfe2131508cf5f0dd, https://si.imgix.net/95b981a2/uploads/origins/ac668efd-2901-48fc-82ac-594cb3b245a4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=89e02a06cf364ffef787efc7b52f0692 2x, https://si.imgix.net/95b981a2/uploads/origins/ac668efd-2901-48fc-82ac-594cb3b245a4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=4b042f7900b7d0e8867284818db5b125 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/95b981a2/uploads/origins/ac668efd-2901-48fc-82ac-594cb3b245a4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=44de9c5abdf483f9aa64477bc10d7afc", "srcset": "https://si.imgix.net/95b981a2/uploads/origins/ac668efd-2901-48fc-82ac-594cb3b245a4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=44de9c5abdf483f9aa64477bc10d7afc, https://si.imgix.net/95b981a2/uploads/origins/ac668efd-2901-48fc-82ac-594cb3b245a4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=ecd4d7726f349cd85f9a12059a3f0dbe 2x, https://si.imgix.net/95b981a2/uploads/origins/ac668efd-2901-48fc-82ac-594cb3b245a4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=22d2971c0c83ae38b99eca36dc15dc91 3x"}, "body": "ぱ〜くさん！こちらではお久しぶりです！🫶\n\n今回は久しぶりにラブ・ラドルさんを描いていただきたく、リクエストしにきました！\n以下、長文のキャラクター概要です。\n\n【ラブ・ラドルさん】\n夢にラブラドライト（鉱石）が出てきて、忘れられずお迎えした際、脳内に現れたキャラクターです。\n\n無性別でノンバイナリー。\n近いものはゼノジェンダー。\n目の色は髪の色と同じ感じ。\nイメージカラーは虹色、ピンク、オレンジ、青色などがあります。光に透けるとアンバー。色のないところは黒や灰色。\n\n彼は白く窓があり、カーテンがついており、照明がないのに明るい部屋で自由に過ごしています。\n小物はあるとするなら机、椅子、紅茶ポットとカップなど、花瓶に造花。窓の外も白い空間が広がっています。\nそこの他に、彼の絵だけが並んだギャラリーのような部屋もあります。\n他人の描いた自らを見た時、彼は愛おしそうにそれらを眺め、\"自分が本当に生きているようだ\"と感じています。\n\n彼はこちら（画面側にいる人）を理解しており、柔らかく微笑んでくれます。嫌いな相手はいません。合わない相手はいます。\n\n性格は、自分の意思がきちんとあり、相手に諭すように話す子です。\n譲れないところもありつつ、相手を尊重したい気持ちが強いです。\n〜なのかい？〜だね。〜だろう？〜かもしれないね。などをよく使います。\n自分がイマジナリーフレンド、架空の存在であることに気付いており、日常に生きている、存在する人間になりたい願望がありますが滅多に言葉にしません。\n三大欲求もありません。ですが、彼はどんなひとより知的欲求が強く、知りたい、体験したいとその日を待ち侘びています。\n\n最近はわたしの創作世界観の中の日常を体験し、とても楽しそうです。\nひとのこだわりに触れることや自分と違う考えに触れることも好きです。味覚はあまりないながらも食事を楽しんでいます。\n（見た目、食感、舌触りなど）\n\nイメージするものはモルフォ蝶などの蝶、青、宇宙、ひまわり、ラブラドライト。\n\n彼の好きなものは、ガラクタと言われるもの、不揃いなもの、たまご（見た目）、黄色（イチョウの葉のような……）、造花、頭のない球体関節人形、人間。\n好きじゃないものは、自らを偽るひと。\n\n\n【今回描いてほしいもの】\n以上のことから連想した絵を好きなように描いてほしいです。\n・わたしのアイコンの生物がいたら嬉しい\n・お洋服がデフォルトと違うと嬉しい\nと思っていますが、これら全てに従う必要はありません。\n\n【その他】\n金額が不相応、これは請けられない、などがあれば再送要請やキャンセルしていただいて構いません。\n\nどうぞよろしくお願いいたします！！\n\nhttps://drive.google.com/drive/folders/1X8FVNHd06g2ytm_8OZ7mZn9YGFIcdB28", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@CMR_0723/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1476706, "client_id": 439999, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/3ccee204/uploads/origins/04c8dfa0-0218-4dc2-b2a6-93fa4e9ab712?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=db1c742c4f21309ae8845c5dc99fb508", "srcset": "https://si.imgix.net/3ccee204/uploads/origins/04c8dfa0-0218-4dc2-b2a6-93fa4e9ab712?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=db1c742c4f21309ae8845c5dc99fb508, https://si.imgix.net/3ccee204/uploads/origins/04c8dfa0-0218-4