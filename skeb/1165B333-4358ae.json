なシーンをオマージュしたイラストをお願いします。シチュエーションとしては、大きな木の下でルゥリがエクセルにココリの実を手渡している場面にしてください。その際、ココリの実はリンゴに似た見た目にしていただき、蛇の代わりに小さなブラックウィルムを木の上に配置してください。二人の衣装については、エクセルとルゥリであるとハッキリ分かる範囲で、半裸にするか、または体を葉っぱなどの植物で隠しているような姿にしてください。また、キャラクターの片方、もしくは二人ともが恥ずかしがって顔を赤らめている表情にしていただけると嬉しいです。ご検討のほどよろしくお願いいたします。\n\nhttps://www.youtube.com/live/xuSb1cbA7yY?si=XYEy-RlLg102tl2A&t=3357", "nc": 48, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@1165B333/works/14", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/d9c96ff9/uploads/origins/5789d0ee-4a83-406f-9b62-ca25dc5bfb15?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=2e86959c734cab0d011a8ab3d0478bf1", "srcset": "https://si.imgix.net/d9c96ff9/uploads/origins/5789d0ee-4a83-406f-9b62-ca25dc5bfb15?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=2e86959c734cab0d011a8ab3d0478bf1, https://si.imgix.net/d9c96ff9/uploads/origins/5789d0ee-4a83-406f-9b62-ca25dc5bfb15?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=0a55b0fc97d944366759d4835eb9ad22 2x, https://si.imgix.net/d9c96ff9/uploads/origins/5789d0ee-4a83-406f-9b62-ca25dc5bfb15?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=2fcb84d276c645e877817f968e6e5d63 3x"}, "private": true, "genre": "art", "tipped": true, "creator_id": 1275057, "client_id": 3681842, "nc": 160}, {"path": "/@1165B333/works/13", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1275057, "client_id": 3695125, "vtt_url": null, "thumbnail_image_urls": {"src":