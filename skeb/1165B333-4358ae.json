ているような構図でも大丈夫です。おそらく横からの視点（サイドビュー）だと、二人の距離感や表情がより魅力的に見えると思います。もし他にもっと良く見える構図や演出があると思われる場合は、そちらに変更していただいても構いません。\n\nhttps://youtu.be/nHNSoHYOMNA?si=gQiXXABL3hgjCoqA&t=653", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@1165B333/works/12", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1275057, "client_id": 3010956, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/843b10a0/uploads/origins/6f83433b-3725-4dd6-95d1-5cc32a8d37d6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=238a117b7b28c86fb9c84cca6ae42ca4", "srcset": "https://si.imgix.net/843b10a0/uploads/origins/6f83433b-3725-4dd6-95d1-5cc32a8d37d6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=238a117b7b28c86fb9c84cca6ae42ca4, https://si.imgix.net/843b10a0/uploads/origins/6f83433b-3725-4dd6-95d1-5cc32a8d37d6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=20eb4f714ff079b6d4689f050adf6ae0 2x, https://si.imgix.net/843b10a0/uploads/origins/6f83433b-3725-4dd6-95d1-5cc32a8d37d6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=0bad09bfd034e2d842dc2d8550c5d6fb 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/843b10a0/uploads/origins/6f83433b-3725-4dd6-95d1-5cc32a8d37d6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c8eebba7577f00a63077e392117915ea", "srcset": "https://si.imgix.net/843b10a0/uploads/origins/6f83433b-3725-4dd6-95d1-5cc32a8d37d6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c8eebba7577f00a63077e392117915ea, https://si.imgix.net/843b10a0/uploads/origins/6f83433b-3725-4dd6-95d1-5cc32a8d37d6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=7af47d3696eaf01c72760dd50231f4fd 2x, https://si.imgix.net/843b10a0/uploads/origins/6f83433b-3725-4dd6-95d1-5cc32a8d37d6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=f2850aadf3bc0b1ad1f69e9cfd212799 3x"}, "body": "親愛なる十九角様、VTuber・ユノ・ナイチンゲール（https://x.com/yunonightingale/status/1764589168598855865）のイラストを依頼いたします。この上品な若き淑女でありレトロゲーム通である彼女は、私が深く愛するゲーム『リビエラ～約束の地～』を現在初めてプレイ中です。\n配信中、ナイチンゲールさんはフィアーのリボンをモデルに装着していますので、ぜひこれを描いていただけると嬉しいです。また、敵と対峙中にオーバードライブバーを誤って落として粉々にしたり、頭上にクイックタイムイベントのアイコンが降ってきて圧倒されている様子など、面白い描写を思いついたらお願いします。\nより日常的なシーンとして、ソアラの隣にある水晶洞窟で妖精と遊んだり本を読んでいる様子も素敵です。描く内容はご自由にお任せします。完成したイラストを、ミス・ナイチンゲールがYouTubeのサムネイルやTwitterのスケジュール・配信告知に使用できれば幸いです。\n\nご検討いただきありがとうございます。敬具 P.P.A. https://drive.google.com/drive/folders/10SsUbOpLjIeAn5QvrMR--yWfGEi661h7", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@1165B333/works/11", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/f5832a95/uploads/origins/9a153e5f-c445-47ca-aa29-b46f1f8ea324?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=e7232133268c2c5cefb0454d495378a9", "srcset": "https://si.imgix.net/f5832a95/uploads/origins/9a153e5f-c445-47ca-aa29-b46f1f8ea324?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=e7232133268c2c5cefb0454d495378a9, https://si.imgix.net/f5832a95/uploads/origins/9a153e5f-c445-47ca-aa29-b46f1f8ea324?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=39fca2d3ec7ac0b714d80746be301f3d 2x, https://si.imgix.net/f5832a95/uploads/origins/9a153e5f-c445-47ca-aa29-b46f1f8ea324?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=midd