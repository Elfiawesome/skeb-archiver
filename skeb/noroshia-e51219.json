性格。肩幅が広い。太い眉。暖かみのある褐色の肌色。\n青い服を着て描いてください。頭飾りは描かなくてよい。\nモチーフ：矢、地図、羊皮紙、暗い地平線。\n\nキャラクターB。旅と空を飛ぶのが好きな、かわいくて明るいエルフの女の子です！\n顔のマークと肌の色にご注目ください。\nモチーフ：星、星座、カラフルな鳥、自由\n\nファンタジーの世界に住む2人。\nキャラBは記憶を失ってしまった。2人は友達。\n\n残りの構図はお任せします！カラフルなものがいいです。何か問題があればお断りしてください。ありがとうございました！\n\n参考画像👇のリンク\n\nhttps://www.dropbox.com/sh/g55i53qxo2mzwp6/AACeggQlSEMUsaLxmIascnmYa?dl=0", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@noroshia/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3103589, "client_id": 1531284, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/bfe89df7/uploads/origins/5d94ee9f-200b-4190-97dc-f57d832f78fc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=327079da93391c536e5095cdf1cda3cc", "srcset": "https://si.imgix.net/bfe89df7/uploads/origins/5d94ee9f-200b-4190-97dc-f57d832f78fc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=327079da93391c536e5095cdf1cda3cc, https://si.imgix.net/bfe89df7/uploads/origins/5d94ee9f-200b-4190-97dc-f57d832f78fc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=dcad5cd7b36c33b5aeac22c2a24efbb1 2x, https://si.imgix.net/bfe89df7/uploads/origins/5d94ee9f-200b-4190-97dc-f57d832f78fc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=410701c2522886f6dc11835f80ba0655 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/bfe89df7/uploads/origins/5d94ee9f-200b-4190-97dc-f57d832f78fc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=78be63284f67d52219b792ea8307c688", "srcset": "https://si.imgix.net/bfe89df7/uploads/origins/5d94ee9f-200b-4190-97dc-f57d832f78fc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=78be63284f67d52219b792ea8307c688, https://si.imgix.net/bfe89df7/uploads/origin