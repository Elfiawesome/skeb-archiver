fd1f/uploads/origins/0c8d6ab0-5c59-4498-ab5b-fc01063a8ec6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=a28a0906ef2c394af5b1f01e6f50797b 2x, https://si.imgix.net/e685fd1f/uploads/origins/0c8d6ab0-5c59-4498-ab5b-fc01063a8ec6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=cf4a00ff18fc2ab4865932270b0933a4 3x"}, "body": "\u3053\u3093\u306b\u3061\u306f\u3001\n\u3042\u306a\u305f\u306e\u7d20\u6575\u306a\u30a4\u30e9\u30b9\u30c8\u306f\u3068\u3066\u3082\u597d\u304d\u3067\u3059\u3002\n\u79c1\u306e\u4e8c\u4ebaOC\u3092\u63cf\u3044\u3066\u304f\u308c\u307e\u305b\u3093\u304b\uff1f\n\u821e\u53f0\u306f\u30d5\u30a1\u30f3\u30bf\u30b8\u30fc\u306e\u9b54\u6cd5\u5b66\u6821\u30a2\u30ab\u30c7\u30df\u30fc\u98a8\u3001\n\u30ad\u30e3\u30e9\u53c2\u7167\u306f\u4e0b\u8a18\u306eURL\u3092\u3054\u89a7\u304f\u3060\u3055\u3044\u3002\n\n\u3010\u30ad\u30e3\u30e9\u30af\u30bf\u30fc\u306b\u3064\u3044\u3066\u3011\n(SORA) 18\u6b73/180cm\n\uff14\u8033\u4e9e\u4eba\u3001\u53f3\u306e\u72fc\u8033\u304c\u6b20\u3051\u3066\u304a\u308a\u3001\u53f3\u306e\u72fc\u306e\u8033\u3068\u5de6\u306e\u4eba\u9593\u306e\u8033\u304c\u8033\u98fe\u308a\u304c\u4ed8\u3044\u3066\u3044\u308b\u3002\n(\u8033\u98fe\u308a\u306f\u6c17\u5206\u306b\u3088\u3063\u3066\u5909\u3048\u308b\u3053\u3068\u3082\u3042\u308b\u3002)\n\u7d3a\u8272\u9aea\u306b\u91d1\u306e\u30e1\u30c3\u30b7\u30e5\u3001\u5c0f\u3055\u306a\u30dd\u30cb\u30fc\u30c6\u30fc\u30eb\u3001\u30ae\u30b6\u6b6f\u3001\u5065\u5eb7\u306a\u8910\u8272\u808c\u3002\n\u53f3\u76ee\u306f\u8d64\u304f\u3001\u5de6\u76ee\u306f\u7070\u8272\u3067\u3001\u5de6\u7709\u304b\u3089\u76ee\u3092\u8cab\u3044\u305f\u50b7\u304c\u3042\u308a\u3002\n\u4e0d\u826f\u751f\u5f92\u3001\u7559\u5e74\u751f\u3001\u30b5\u30dc\u308a\u9b54\u3001\u6821\u820e\u306e\u3042\u3061\u3053\u3061\u3067\u5c45\u7720\u308a\u3092\u3059\u308b\u3053\u3068\u304c\u591a\u3044\u3002\n\u4e71\u66b4\u306a\u898b\u305f\u76ee\u3051\u3069\u60c5\u306f\u539a\u304f\u3001\u30a2\u30cb\u30ad\u30e3\u30e9\u3001\u53ef\u611b\u304f\u5f31\u3044\u3082\u306e\u306b\u306f\u512a\u3057\u3044\u3002\n\n(SIMON) 13\u6b73/150cm\n\u5927\u304d\u306a\u30d5\u30ec\u30fc\u30e0\u306a\u3057\u4e38\u30e1\u30ac\u30cd\u3092\u304b\u3051\u3066\u3001\n\u8679\u8272\u30cf\u30a4\u30e9\u30a4\u30c8\u3092\u653e\u3064\u6c34\u8272\u306e\u76ee\u304c\u30ec\u30f3\u30ba\u306e\u4e0b\u306b\u96a0\u3055\u308c\u305f\u3002\n\u9280\u8272\u306e\u9aea\u304c\u6570\u672c\u306b\u9ed2\u3044\u6bdb\u5148\u3092\u6df7\u3058\u3063\u3066\u3044\u308b\u3002\n\u98db\u3073\u7d1a\u751f\u5f92\u3001\u77e5\u7684\u597d\u5947\u5fc3\u3044\u3063\u3071\u3044\u3001\u8aad\u66f8\u3068\u77e5\u898b\u3092\u5f97\u308b\u3053\u3068\u304c\u597d\u304d\u3001\n\u5e38\u306b\u5bdd\u4e0d\u8db3\u306e\u3088\u3046\u306b\u898b\u3048\u3001\u76ee\u306e\u4e0b\u306b\u30af\u30de\u304c\u3042\u308b\u3053\u3068\u304c\u591a\u3044\u3002\n\u5fc3\u304c\u901a\u3058\u308b\u306e\u5c0f\u3055\u306a\u30cf\u30ea\u30cd\u30ba\u30df\u3092\u98fc\u3046\u3002\n\n\u4e8c\u4eba\u306f\u65b0\u5165\u751f\u3068\u7559\u5e74\u751f\u306e\u95a2\u4fc2\u3002\nSIMON-->SORA: \u6016\u3044\u4e0d\u826f\u5148\u8f29\u3001\u306a\u305c\u50d5\u306b\u3088\u304f\u7d61\u307e\u308c\u308b\uff1f\nSORA-->SIMON: \u5c0f\u3055\u3044\u304b\u308f\u3044\u3044\u3001\u4e0d\u826f\u751f\u5f92\u304b\u3089\u5b88\u3063\u3066\u3042\u3052\u306a\u3044\u3068\uff01\n\n\u3010\u30c6\u30fc\u30de\u3011\n\u4e8c\u4eba\u3061\u3087\u3063\u3068\u3059\u308c\u9055\u3044\u611f\u3058\u306e\u4ef2\u7766\u307e\u3058\u3044\u3092\u63cf\u3044\u3066\u9802\u3051\u305f\u3089\u5b09\u3057\u3044\u3067\u3059\u3002\n\u69cb\u56f3\u7b49\u69d8\u3005\u306b\u95a2\u3057\u3066\u304a\u4efb\u305b\u81f4\u3057\u307e\u3059\u3002\n\u7d30\u304b\u3044\u8a2d\u5b9a\u306b\u3064\u3044\u3066\u306f\u304a\u597d\u307f\u3067\u8abf\u6574\u3057\u3066\u69cb\u3044\u307e\u305b\u3093\u3002\n\u4f9d\u983c\u5185\u5bb9\u306b\u306a\u306b\u304b\u554f\u984c\u304c\u3042\u308c\u3070\u518d\u9001\u8981\u8acb\u3057\u3066\u304f\u3060\u3055\u3044\u3002\n\n\u3010\u4f7f\u7528\u7528\u90