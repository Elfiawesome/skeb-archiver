t%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=cae197389afc3c5c525f831c4d3b6f2d 3x"}, "body": "はじめまして。先日、ひょんなことから、Twitterの検索機能にて「やま屋」（香川県高松市古馬場町にある焼肉店です。）のワードを検索したところ、貴方様の2017年12月01日のツイート（写真付き）に行き着きました。ツイート先のアカウントを拝見させていただき、私と同じ香川県にお住まいであること、とても魅力的なオリジナルのウマ娘をお描きになる絵師さんでいらっしゃること、これは何かの縁だと思い、イラストのリクエストをさせていただいた次第であります。（私自身、Skebでは初めてのリクエストです。）\n\n実在の競走馬の特徴をしっかりとらえられた貴方様の豊かな感性や高い画力、オリジナリティには、ウマ娘ファンのみならず競馬ファンをもうならすものがあります。もっとたくさんの人に貴方様の作品を見てもらいたい、香川県にはこんなにも素晴らしい絵師さんがいるということを知ってもらいたいと強く願うようになりました。\n\nさて、このたびリクエストさせていただきたいイラストは、昨年（2021年）のエリザベス女王杯（Ｇ１）の優勝馬、アカイイト（競走馬）をモデルにしたオリジナルのウマ娘です。ひょっとしたら、本馬は貴方様のお好きな競走馬ではないかもしれませんが、私にとりましてはデビュー前から応援している大変思い入れの強い一頭でございます。\n\nイラストは、実物の勝負服や毛色の印象に合わせて描いていただけると嬉しいです。ポーズや構図はお任せしますので何卒よろしくお願い申し上げます。\n\nご多忙とは存じますが、くれぐれもご無理をなさらぬよう、お体にお気をつけてお過ごしください。\n\nhttps://www.jra.go.jp/datafile/seiseki/g1/eliza/result/eliza2021.html", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 249338, "creator": true, "nsfw_acceptable": false, "acceptable": false, "name": "吉田", "screen_name": "yosida_org", "avatar_url": "https://pbs.twimg.com/profile_images/1986734679245070336/AyQb74Hf.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1228539766817247233/1701962676/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "art"}], "banned": false, "nc": 33}, {"id": 2761838, "creator": true, "nsfw_acceptable": false, "acceptable": false, "name": "zippy", "screen_name": "zippy_zippy_", "avatar_url": "https://pbs.twimg.com/profile_images/1661316178818793472/SZNgc0FG.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1645718497400623104/1736579474/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_re