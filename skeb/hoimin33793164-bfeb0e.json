イゴールドとハーツクライを申し込みたいと思います。\n\n\n各ウマ娘はこういう感じで描いてくださるとありがたいです。\n\n[ステイゴールド]\n傍若無人に気の強い社台家のお嬢様\n\nゴルシのように自信満々な表情と姿勢が特徴です。\n\n\n[ハーツクライ]\n冷静かつ孤高の社台家のお嬢様\n\n無表情の冷たい雰囲気が感じられるようにお願いします。\n\nキャラクターが1つずつあるパーツと文字がないバージョンもお願いします。\n\nそれぞれのキャラデザはurlにあります！\n\nありがとうございました！\n\nhttps://twitter.com/maruaru00/status/1543586040803655681?t=NdNeMYTY-C96LXg4NM96vw&s=19\n\nhttps://twitter.com/maruaru00/status/1545278428861300736?t=NdNeMYTY-C96LXg4NM96vw&s=19", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@hoimin33793164/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1176662, "client_id": 860341, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/2daeb026/uploads/origins/ab272624-9891-4d14-b717-13b1533924e5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=88387f6abb9a39a216fec725c7f89829", "srcset": "https://si.imgix.net/2daeb026/uploads/origins/ab272624-9891-4d14-b717-13b1533924e5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=88387f6abb9a39a216fec725c7f89829, https://si.imgix.net/2daeb026/uploads/origins/ab272624-9891-4d14-b717-13b1533924e5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=0f226daca86e0aa505c7fca3afe1508a 2x, https://si.imgix.net/2daeb026/uploads/origins/ab272624-9891-4d14-b717-13b1533924e5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=2af2d3bbf07db739b98f96440025bb1c 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/2daeb026/uploads/origins/ab272624-9891-4d14-b717-13b1533924e5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=661f9917969d821c1208bd3d206c12a9", "srcset": "https://si.imgix.net/2daeb026/uploads/origins/ab272624-9891-4d14-b717-13b1533924e5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200