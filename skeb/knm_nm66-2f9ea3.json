ます。\n・服装・アクセサリー等はキャラデザのものでなくても構いません。\n・髪型も自由に変更いただいてOKです！\n・宣伝等に使用予定のため、頭部や髪の毛、腕などが見切れていないと嬉しいです！（←構図的に椅子などで隠れたりする場合、気にしないでください！）\n\n【使用用途】\n・収益化をしているTwitch・Youtubeチャンネル等のサムネイル・配信バナー・動画\n・SNSのアイコン、ヘッダー、投稿等\n・PCデスクトップ壁紙\n\n・納品形式は可能であれば…人物・小物（←もしあれば）を分けたpsdデータもしくは透過画像での納品だと大変助かります。\n\n\n何卒、ご検討のほど宜しくお願い致します。", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@knm_nm66/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3971998, "client_id": 806358, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/7f58a07c/uploads/origins/e2963a0b-1abf-4d7c-9ed7-268fc331469f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bb58dc609e885f22d6c462c82cefd933", "srcset": "https://si.imgix.net/7f58a07c/uploads/origins/e2963a0b-1abf-4d7c-9ed7-268fc331469f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bb58dc609e885f22d6c462c82cefd933, https://si.imgix.net/7f58a07c/uploads/origins/e2963a0b-1abf-4d7c-9ed7-268fc331469f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=9ff333d2e12a2c258bc06b5327ebc9ae 2x, https://si.imgix.net/7f58a07c/uploads/origins/e2963a0b-1abf-4d7c-9ed7-268fc331469f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=1e5b38b8e458253772ca49d60406f5d9 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/7f58a07c/uploads/origins/e2963a0b-1abf-4d7c-9ed7-268fc331469f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=fbfb389db0063bdd2dfec3a708a8ae33", "srcset": "https://si.imgix.net/7f58a07c/uploads/origins/e2963a0b-1abf-4d7c-9ed7-268fc331469f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=fbfb389db0063bdd2dfec3a708a8ae33, https://si.imgix.net/7f58a07c/uploads/origins/e2963a0b-1abf-4d7c-9ed7-268fc331469f?bg=%23fff