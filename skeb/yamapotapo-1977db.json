=crop&crop=top&w=200&h=200&s=18e2491c0d814756e1533786ccee0936 2x, https://si.imgix.net/84e508d0/uploads/origins/d8dcc861-cd4e-41f1-98b3-6a9f6276a5bd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d4739fe7589a720c470b074180c0f632 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/84e508d0/uploads/origins/d8dcc861-cd4e-41f1-98b3-6a9f6276a5bd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=897b7ad332fd6550970ad22a76ac7f04", "srcset": "https://si.imgix.net/84e508d0/uploads/origins/d8dcc861-cd4e-41f1-98b3-6a9f6276a5bd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=897b7ad332fd6550970ad22a76ac7f04, https://si.imgix.net/84e508d0/uploads/origins/d8dcc861-cd4e-41f1-98b3-6a9f6276a5bd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=dbe92448222779d5dcbc1b71b02b8f72 2x, https://si.imgix.net/84e508d0/uploads/origins/d8dcc861-cd4e-41f1-98b3-6a9f6276a5bd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=0950ae436b32c6d66f7f980ee368ed36 3x"}, "body": "届様\n\nイラストを拝見しとても素敵だったので是非お願いしたいと思いリクエスト送信させていただきます。\n\n赤い髪の子\n国東久良。笑っていることが多い。楽しげに、けれどそれも自分が信じたいだけ。演技だった。家庭の事情が複雑で苗字がしょっちゅう変わっていたので今の苗字も偽名。彼の存在自体のように、たくさんあるもの。そして全て、どうでもいいもの。態度や人格を使い分けるのが上手く、周囲には演じた自分しか見せていない、うちに自分自身も見失っている。今は一人では全部、見失う。\n\n白い髪の子\n灰桜枝葉。前述の通りあやふやな久良を現実に連れ戻し、かつ自分を愛し自分がいなければ生きていられないほど愛してくれるように「躾けて」いる。痛めつける、しか有効な手立てがない——そう思っているけれど、久良は痛い時にも痛いと言わないので、その躾に本当に意味があるのかは、わからない。けれど、自分がやりたいから。その気持ちも無いわけじゃない。自分がやって楽しい。それで疑問には蓋をした。している。\n\n関係性\n愛し合っている。愛し合おうとしている。理解ができないことは、多分うっすら勘づいている。それでも、絶対にそばから離れない。好き、嫌い、そうじゃなくて——ある種の信頼。\n\n資料添付致します。\n\nイラスト自体にお願いしたい注意点のようなものが特に浮かばなかったので、彼らが纏う雰囲気について重点的に書かせていただきました。キャラクターデザインの細部も届様の描きやすいようにアレンジしていただいて問題ありません。服も立ち絵で着ているものと別でも構いません(もちろん立ち絵のままの服でも大丈夫です！描きやすいように、描きたいように描いていただければという思いで追記させていただきました。)。\n\nここまで目を通していただきありがとうございます。もし届様が描きたいと思っていただけて、ご都合がよろしければ是非お願いしたいです。ご検討よろしくお願い致します。\n\nhttps://drive.google.com/drive/folders/12khXBr_PxAVJkpv3GU4B_iAIE9ohPFbQ", "nc": 177, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@yamapotapo/works/8", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/3afaeebd/uploads/origins/acf95de1-b26e-43fb-8e56-626b9b073305?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=e8d038eada16aed68a1423a5b60eef7c", "srcset": "https://si.imgix.net/3afaeebd/uploads/origins/acf95de1-b26e-43fb-8e56-626b9b073305?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=e8d038eada16aed68a1423a5b60eef7c, https://si.imgix.net/3afaeebd/uploads/origins/acf95de1-b26e-43fb-8e56-626b9b073305?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=d259adc8b6393f26c6cfd45290334ebd 2x, https://si.imgix.net/3afaeebd/uploads/origins/acf95de1-b26e-43fb-8e56-626b9b073305?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=f6cbb07b15013a6a24c6f05cae2cd26d 3x"}, "private": true, "genre": "art", "tipped": false, "creator_id": 3959940, "client_id": 2642456, "nc": 178}, {"path": "/@yamapotapo/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3959940, "client_id": 3232033, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/0aa5b8ee/uploads/origins/111c3142-fe6d-4cd2-93e5-efa2ead079aa?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fe0af4d48e219c09de61accf178714a4", "srcset": "https://si.imgix.net/0aa5b8ee/uploads/or