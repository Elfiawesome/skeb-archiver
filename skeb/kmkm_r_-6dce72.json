げな少女で歳は14歳。身長は160cm\n眠ることが好きな少女です。\n紫苑の花と雪の結晶がモチーフです。\n\n紫苑の花言葉である「君を忘れない」という言葉と裏腹に、虐められていた友人を見捨ててしまった。その事実のことをただひたすら眠ることで忘れたいと願っている少女です。\n性格は内向的で人に寄り添う優しさを持っていた少女です。\n\n魔法は「コールドスリープ」という設定です。\n\n\n\nもちろん、どのように書いてくださっても構いません。\n衣装髪型、イメージの色、など全て変更、アレンジしていただいて結構です。\nあなたの好きなように書いて欲しいです。\nどうかよろしくお願いします。\n\nhttps://drive.google.com/drive/folders/1azhWdi6MrEBv2KntLmScWJ65mL2pSTBH", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@kmkm_r_/works/13", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3541416, "client_id": 3869099, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/89755506/uploads/origins/0ea64bb7-0fcd-411a-8d36-df8b7073ff93?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=72fed85734a842fb34f8036c3e7cce52", "srcset": "https://si.imgix.net/89755506/uploads/origins/0ea64bb7-0fcd-411a-8d36-df8b7073ff93?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=72fed85734a842fb34f8036c3e7cce52, https://si.imgix.net/89755506/uploads/origins/0ea64bb7-0fcd-411a-8d36-df8b7073ff93?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=cd84c6e2e31ef241218d3ab49cc51496 2x, https://si.imgix.net/89755506/uploads/origins/0ea64bb7-0fcd-411a-8d36-df8b7073ff93?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=52b9b4c1de23f2cba17212a1fb4aaf48 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/89755506/uploads/origins/0ea64bb7-0fcd-411a-8d36-df8b7073ff93?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6cd60f06721a13dade7f7549ff04c13f", "srcset": "https://si.imgix.net/89755506/uploads/origins/0ea64bb7-0fcd-411a-8d36-df8b7073ff93?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6cd60f06721a13dade7f7549ff04c13f, https://si.imgix.net/