無に関しても特に指定はありませんので、ディダさんの描きたいように描いていただければそれが一番嬉しいです。\n\n以上、もしよろしければご検討の程、よろしくお願いします。\n\nhttps://www.dropbox.com/scl/fo/g1p9fezui0lxukys5gh7q/h?rlkey=85ubej4vf8xn4t2k3oxzxo1by&dl=0", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@dyda5693/works/12", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2631382, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/a032dbcf/uploads/origins/a3efbddd-7634-433a-9f64-88814ae18eda?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=077096b18defdc02b02a0e75d5bae906", "srcset": "https://si.imgix.net/a032dbcf/uploads/origins/a3efbddd-7634-433a-9f64-88814ae18eda?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=077096b18defdc02b02a0e75d5bae906, https://si.imgix.net/a032dbcf/uploads/origins/a3efbddd-7634-433a-9f64-88814ae18eda?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=6d6f492c141d111e293d73f773f46074 2x, https://si.imgix.net/a032dbcf/uploads/origins/a3efbddd-7634-433a-9f64-88814ae18eda?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=7da46ae96b1365404d74ba0be9f3fbb7 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/a032dbcf/uploads/origins/a3efbddd-7634-433a-9f64-88814ae18eda?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=7f9eb5c5ca2d2bb0744156f8894f139d", "srcset": "https://si.imgix.net/a032dbcf/uploads/origins/a3efbddd-7634-433a-9f64-88814ae18eda?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=7f9eb5c5ca2d2bb0744156f8894f139d, https://si.imgix.net/a032dbcf/uploads/origins/a3efbddd-7634-433a-9f64-88814ae18eda?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=25d896775392563b2476472df87c8c21 2x, https://si.imgix.net/a032dbcf/