36c-80c9-d0d9c1e6a157?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=118178c7241e3b3a99a88e1f25410f34", "srcset": "https://si.imgix.net/0503eaa0/uploads/origins/8beb5844-8482-436c-80c9-d0d9c1e6a157?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=118178c7241e3b3a99a88e1f25410f34, https://si.imgix.net/0503eaa0/uploads/origins/8beb5844-8482-436c-80c9-d0d9c1e6a157?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=71efc3cf048206fc2a24775a51506191 2x, https://si.imgix.net/0503eaa0/uploads/origins/8beb5844-8482-436c-80c9-d0d9c1e6a157?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=037093a3ea644e0c4e331fea00f1edb1 3x"}, "body": "たま下駄さん\nいつもお世話になっております！前回は本当に素敵な作品をありがとうございました。またいつか たま下駄さんにリクエストできる日が来ればな、と思っていたのでskebを開いてくださりとても嬉しいです。今回も、ご無理のない範囲でオリジナルキャラクターの漫画をお願いいたします。\n\n▼キャラクター 【フェイス 】攻め \n27歳 / ♂ / 177cm / 茶髪 / タレ目緑目 / 歯科矯正器具 / そばかす / FBI捜査官 / キザ陽キャ \n・他者の長所も短所も愛する\n・相手に尽くす事が好き(全部オレがやりたい)\n・基本的に格好つけるが、全然ダサい所も見せる\n一人称 / オレ\n二人称 / クリード、君、お前\n三人称 / 彼、彼女、あいつ\n\n【クリード】受け\n28歳 / ♂ / 175cm / 赤髪 / ツリ目青眼 /犬歯 / ピアス / フリーター（今はバイク屋勤務） / ひたむき素直\n・前向きで、小学生マインド\n・カッコいいのが好きだが、恋人からはお姫様みたいに扱われたい乙女心もある\n・何事にも興味津々だがいざという時ちょっと逃げ腰\n・フェイスと行き着く答えが似ている\n一人称 / 俺\n二人称 / フェイス、お前\n三人称 / あの人、あいつ\n\n◎関係 \n・人生毎日楽しいことがしたい！という点でとても気が合う\n・元々セフレだったため、セックスは愛情表現でもあるが、スポーツ的な趣味として共有している所がある\n・己は攻め！とか受け！とかいうポジションを一番固定して楽しいんでいるかも\n・キャンプに一緒に行くのが好き\n ・クリードは、理詰めな自分の心を柔らかくしてくれる感情的な人だとフェイスは思っている\n ・クリードは、自分が一番じゃなくてもいいけど、ずっとフェイスの大切な人ではいたいと思っている\n\n▼資料URL\nGoogleドライブのURLです。 \nキャラクターの容姿の確認として基本的な立ち絵と、今まで描いた落書きが入っていますが、もちろん全て見なくても問題ございません。クトゥルフ神話TRPG「Paranormal Crime」というゲームのネタバレを一部含みます。フェイス・ドラブ・メリー・クリード(恋人関係にある人)の四人は好きに使用していただいて問題ございません。\n\n▼リクエスト \n解釈違いや口調ブレなどは気になりません！自由に描いていただけると嬉しいですし、料金範囲内でお任せいたします。ギャグでもシリアスでも大丈夫です。もし、フェイス×クリードが難しい、または、以前お願いした フェイス×ドラブで思いつくものがある！まだ描けるものがあった！などあれば後者でも嬉しいです。筆が乗る方で、以前の資料を参考にフェイス関連のCP漫画でお願いいたします。\n\n▼使用用途\n個人的に鑑賞して楽しませて頂きます。有償利用などは致しませんが個人用に紙面にプリントしたいので解像度350dpi〜だと助かります。こちらは難しければ構いません。 \n\n長文失礼いたしました。情報が不十分でしたら申し訳ございません。御一考、よろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/1-j0UCXaPp6JJj7xM3wpg4MeroG3Hio5a", "nc": 185, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@tamagetasan/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "comic", "tipped": false, "creator_id": 2555127, "client_id": 1234898, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/01037762/uploads/origins/d981a4dd-80d9-44ff-baf3-04a5dc7796aa?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5a8bcbbc030e8b2265662052be4a4e52", "srcset": "https://si.imgix.net/01037762/uploads/origins/d981a4dd-80d9-44ff-baf3-04a5dc7796aa?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5a8bcbbc030e8b2265662052be4a4e52, https://si.imgix.net/01037762/uploads/origins/d981a4dd-80d9-44ff-baf3-04a5dc7796aa?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=7f564e0eb7341f21b5a477c5c25737ef 2x, https://si.imgix.net/01037762/uploads/origins/d981a4dd-80d9-44ff-baf3-04a5dc7796aa?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d4a5b9e35b47af50000918f11711e734 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/01037762/uploads/origins/d981a4dd-80d9-44ff-baf3-04a5dc7796aa?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e680d9389689d3cb1623e4faf9380604", "srcset": "https://si.imgix.net/01037762/uploads/origins/d981a4dd-80d9-44ff-baf3-04a5dc7796aa?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e680d9389689d3cb1623e4faf9380604, https://si.imgix.net/01037762/uploads/origins/d981a4dd-80d9-44ff-baf3-04a5dc7796aa?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=e35b872ed91cec3d321e33bd6347e907 2x, https://si.i