10d53eec118367d82fb7ba 2x, https://si.imgix.net/fbfe6b52/uploads/origins/c0848c63-4cd2-45ec-b0a4-3e3f84978711?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=1c6e2b084425035c8b6f23482aac3e9b 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/fbfe6b52/uploads/origins/c0848c63-4cd2-45ec-b0a4-3e3f84978711?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b1055ba343c09bbd6d8c0795b004863a", "srcset": "https://si.imgix.net/fbfe6b52/uploads/origins/c0848c63-4cd2-45ec-b0a4-3e3f84978711?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b1055ba343c09bbd6d8c0795b004863a, https://si.imgix.net/fbfe6b52/uploads/origins/c0848c63-4cd2-45ec-b0a4-3e3f84978711?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=328bd6ee997010bf8a26e7064ca045ff 2x, https://si.imgix.net/fbfe6b52/uploads/origins/c0848c63-4cd2-45ec-b0a4-3e3f84978711?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=6eb86866a3e23497711f2b1babcedf28 3x"}, "body": "ルーパス・ウィスタリア様、こんにちは、お世話になっております。\n以前にもイラストを制作していただきましたが、とても素敵で、今でも私の宝物です。\n\n今回もルーパス・ウィスタリア様にまたイラストを描いていただきたいと強く思い、ご連絡させていただきました。\n\n○リクエスト\nこの度、新調したデスクトップPCで使う壁紙を描いていただきたいと思っています。\n\n○イメージ\nルーパス・ウィスタリア様ご本人が映っているイラストを希望します。\n構図やポーズ、背景などは全て先生がいちばん素敵だと思う描き方にお任せいたします。\n\n○使用用途\nPCの壁紙に使用させていただきます。\n※商用利用は致しません。\n\n○サイズ\nWQHDモニター(2560×1440)での使用を想定しています。\n16：9の横長のサイズで描いていただけると幸いです。\n\n丸投げ同然のリクエストになってしまいましたが、なんとかしていただけると信じています。\n是非とも、ご検討よろしくお願いいたします。", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@Lupus_Wistaria/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3547495, "client_id": 3474579, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/d705127c/uploads/origins/fea9c644-0b99-4dbe-b8b1-0d0e962cdb