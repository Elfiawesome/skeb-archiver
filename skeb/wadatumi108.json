lse, "tip_acceptable": true, "yearly_report_client_visible": false, "total_appeals_count": 0, "received_works": [{"path": "/@wadatumi108/works/24", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1921793, "client_id": 817275, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/fd4b3dce/uploads/origins/2f78de39-9538-4dd7-9c59-7d287814419e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6e010d546a9b91f99c0c0bb17feff02b", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/fd4b3dce/uploads/origins/2f78de39-9538-4dd7-9c59-7d287814419e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=547f16074e74d016564a4bbe66ccb339", "src_set": ""}, "body": "「お兄ちゃんはおしまい」のキャラクター\n・千川みなと\n・桜田ゆうた\n\nゆうた君とみなと君が体操着姿でシックスナインでフェラ、同時に口内射精をして美味しそうにごっくんしているイラストをお願いします。\nイラストは縦書きで、可能なら上下を反転しても見えるように擬音など反転バージョンもお願いします。\n余裕があれば顔面ぶっかけ差分もお願いします。\n\n資料URLは原作の体操着描写です。\n\nよろしくお願いします。\n\nhttps://www.pixiv.net/artworks/102315516", "nc": 184, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@wadatumi108/works/23", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1921793, "client_id": 817275, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/3cad941d/uploads/origins/0c8ababc-c559-4650-aff3-403a2689f709?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6e7703da8f9493ce5326a34e35868367", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/3cad941d/uploads/origins/0c8ababc-c559-4650-aff3-403a2689f709?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b251078f5fb01de9b197b007f5a9c79b", "src_set": ""}, "body": "「原神」のキャラクター\n・グゥオパァー\n\n原神のグゥオパァーがフェラをしているイラストをお願いします。\nフェラの後は口内射精をしてそのままごっくん、ちんちんが離れた後に美味しそうに舌なめずりさせてください。\n\nグゥオパァーのサイズ感は原作通りで目の中にハートを浮かべてください。\n竿役なしでグゥオパァーの全身ぶっかけ差分も可能ならお願いします。\n\nよろしくお願いします。", "nc": 32, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@wadatumi108/works/22", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1921793, "client_id": 817275, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/a572910c/uploads/origins/c5590863-081f-4a31-9563-d7b03abe2fc5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0866861827db9f5adfdaad8029488f24", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/a572910c/uploads/origins/c5590863-081f-4a31-9563-d7b03abe2fc5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c1eb2a9163b774d5a74af25ed77d6edf", "src_set": ""}, "body": "「原神」のキャラクター\n・ウサギ伯爵\n\n原神のアンバーが持っているウサギ伯爵でぬいぐるみ姦をしているイラストをお願いします。\n竿役視点の正常位でウサギ伯爵の腰を掴んで股間部分にちんこを押し付けて射精させてください。\n\nウサギ伯爵の全身にぶっかけている差分も可能ならお願いします。\nその際は竿役はなしで、ウサギ伯爵だけにして頂けるでしょうか。\n\nウサギ伯爵のサイズや表情は原作準拠にしてください。\n\nよろしくお願いします。", "nc": 177, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@wadatumi108/works/21", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1921793, "client_id": 817275, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/c90dbf08/uploads/origins/70e900a9-db29-4887-82b2-2dddc0a4bdfe?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=163a9dda680bbe20da66e4a570dcfc62", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/c90dbf08/uploads/origins/70e900a9-db29-4887-82b2-2dddc0a4bdfe?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6f9059c0728627c6860f3a4a51e7a929", "src_set": ""}, "body": "「お兄ちゃんはおしまい」のキャラクター\n・千川みなと\n・桜田ゆうた\n\nメイド服を着たゆうた君とみなと君がスカートをたくし上げ、テーブルに置かれているパンケーキとコーヒーカップに射精するイラストをお願いします。\nメイド喫茶というシチュエーションで、自分でしごいてパンケーキとコーヒーに精液をトッピングさせてください。\n綺麗に精液がかかっているのではなくテーブルや皿にもかかっていて、ぶっかけ感を強めにしてください。\n\n左右にゆうた君とみなと君、中央にパンケーキとコーヒーが置かれている注文者視点にしてほしいですが、注文者は描かなくても大丈夫です。\n\n精液をかけた後に「召し上がれ」と笑顔で二人に言わせて下さい。\nメイド服で女装をしていますがウィッグは付けずに通常の髪型でお願いします。\n\n余裕があればパンケーキとコーヒーが僅かに見えるくらい大量の精液がかかっている差分をお願いできるでしょうか。\n\n資料URLは原作でメイド服描写のあるリンクですが、メイド服であれば何でも構いません。\n\nhttps://www.pixiv.net/artworks/127524558", "nc": 32, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@wadatumi108/works/20", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1921793, "client_id": 0, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/76297ab6/uploads/origins/6eeb9db4-a843-4b18-874c-fc4ca43c344b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3fb4d4608285cd5ead6662d8eee806a8", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/76297ab6/uploads/origins/6eeb9db4-a843-4b18-874c-fc4ca43c344b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=385d9910e1d50783ec61e75e1e9db02d", "src_set": ""}, "body": "遊戯王OCGのお菓子の大精霊ウィーンと一対一ボテ腹中出しエッチ\nhttps://www.pixiv.net/artworks/125572531\nカラーイラスト\n\nイメージ\nhttps://www.pixiv.net/artworks/125045960\nhttps://www.pixiv.net/artworks/124689487\n顔、おっぱい、お腹、結合部が見える\nびゅーっと射精され結合部から精液溢れる、中出しの瞬間\nおしっこお漏らし\nボテ腹は大きい、臨月のお腹\n母乳出る\n\nお菓子の大精霊ウィーン\n頭にお菓子を指しているので注意\n体が細くガリガリで肋が浮く、イメージ\nhttps://www.pixiv.net/artworks/119355919\n胸の大きさ、形はこのように\nhttps://www.pixiv.net/artworks/126153805\n肌の色は緑が少し入った灰色\n\n表情\nイメージ\nhttps://www.pixiv.net/artworks/123740738\n怖さのあるキャラクターなので目にハートは入れない\n\nセリフはもっとザーメン食わせろとおねだりする\nセリフ無しバージョンもお願いします\n\n：ラブな感じ\n：男の顔は映らず誰かなど分からない\n：修正は黒線や精液などモザイク以外\n：色々な場所で色々な人に見てもらいたいです\n：紐づけ以外のツイッターアカウントで投稿許可願います", "nc": 41, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@wadatumi108/works/19", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1921793, "client_id": 0, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/7baa4cd5/uploads/origins/c885e83c-be77-47d9-acb6-c15cf994b7f2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=81119c65f6308ed942243237fbfad006", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/7baa4cd5/uploads/origins/c885e83c-be77-47d9-acb6-c15cf994b7f2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d4acc903989079c2844c3fc9e598d8e1", "src_set": ""}, "body": "遊戯王OCGのイタズラの大精霊ハロと一対一ボテ腹中出しエッチ\n左のキャラクター\nhttps://www.pixiv.net/artworks/123686523\nカラーイラスト\n\nイメージ\nhttps://www.pixiv.net/artworks/125045960\nhttps://www.pixiv.net/artworks/124689487\n顔、おっぱい、お腹、結合部が見える\nびゅーっと射精され結合部から精液溢れる、中出しの瞬間\nおしっこお漏らし\nボテ腹は大きい、臨月のお腹\n母乳出る\n\nイタズラの大精霊ハロ\n魔女の帽子を被っているので忘れない\n\n表情\nカードイラストと同じ\n\nセリフは可愛い感じ\nセリフ無しバージョンもお願いします\n\n：ラブな感じ\n：男の顔は映らず誰かなど分からない\n：修正は黒線や精液などモザイク以外\n：色々な場所で色々な人に見てもらいたいです\n：紐づけ以外のツイッターアカウントで投稿許可願います\n：難しい場合はキャンセル願います", "nc": 40, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@wadatumi108/works/18", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1921793, "client_id": 817275, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/f833ff4f/uploads/origins/b15b9f28-99f8-493b-af33-d4ba7e08b708?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8d4250cfbc42a5070f4cb0613c87393b", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/f833ff4f/uploads/origins/b15b9f28-99f8-493b-af33-d4ba7e08b708?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=8e4f9909da0c2085a3f91d79f3ee8100", "src_set": ""}, "body": "「お兄ちゃんはおしまい」のキャラクター\n・千川みなと\n・桜田ゆうた\n\nバニー服を着たみなと君とゆうた君を並ばせ、資料URL(pixivのリンク)のイラストのようなポーズ(エロ蹲踞)で腰を振りながら射精するイラストをお願いします。\n\n参考イラストから変更して欲しい点は以下の3点です\n\n1.首にはリボンではなくそれぞれの名前を書いたハート型のネームプレート\n2.胸部分がめくれて立っている乳首が見える\n3.ちんちん部分を露出\n\nできれば差分でお互いに精液をぶっかけ合い、地面にも精液が溜まっている描写をお願いします。\n\nhttps://www.pixiv.net/artworks/121157471", "nc": 185, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@wadatumi108/works/17", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1921793, "client_id": 0, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/5906551e/uploads/origins/50042533-27e2-4310-8b65-3f554b19ce7e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3fc22a3fe58864e15e42a4a0f6915f6a", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/5906551e/uploads/origins/50042533-27e2-4310-8b65-3f554b19ce7e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=05157e7c29494d603ace10018cab22ad", "src_set": ""}, "body": "はじめまして　リクエストお願いします\n年齢10歳前後の女の子みたいな蒼髪ロングヘアのオリジナルショタ\nきゅんショタメーカー\nhttps://cdn.picrew.me/shareImg/org/202410/338886_wmDYYqh8.png\n服装は昔（昭和晩期～平成初頭）の小学生男子体操服\n丈が股間の付け根あたりまでの\n超短めな社会の窓（チャック）付きの総ゴム型白短パン\nhttps://paypayfleamarket.yahoo.co.jp/item/z363068318\nhttps://aucfree.com/items/c643340020\nhttps://aucview.aucfan.com/yahoo/r141401983\nhttps://aucview.aucfan.com/yahoo/v1081395187\n個人的に白短パン左上にある企業ロゴの青いタグも入ってれば最高です\n白短パンはトランクスみたいな構造で\n前にボタンがなく、腰まわりのすべてをゴムで止める総ゴム式ながら\n独立して前のところにチャック（社会の窓）がついてる構造になってます\nhttps://img02.netsea.jp/ex14/20190627/6/12243076_6.jpg\nhttps://aucview.aucfan.com/yahoo/u1071545937\nhttps://aucview.aucfan.com/yahoo/1081163389\n体操服は一般的でシンプルな半袖の丸首体操服で襟や袖の縁取りは青色\nきゅんショタ画像のような名前ゼッケンはいりません\n構図は体育倉庫に連れ込まれて輪姦、陵辱レイプ、騎乗位＆両手に茎\n完全着衣、体操服も着たままでシャツも裾を短パンの中に入れている状態\n白短パンも脱がされず\n穿いたままの姿（ただしブリーフなしのノーパンを強要）で\n短パンずらし挿入\n社会の窓のところのチャックは全開にされて\n無毛短小包茎未成熟（未精通）おちんちんが窓からぽろんしてる状態\n竿役の男は（最低）三人\n一人は体操服短パン少年を上に乗せ、白短パンを横からずらし挿入\n根本まで騎乗位じゅっぽり\n他の二人は両側から巨根を突き出し、少年に手コキさせてる状態\n短パンの丈の際どいところを意識しつつ\nまたブルマでなく短パンなので裾まわりに余裕と隙間のある感じで\nお願いします", "nc": 57, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@wadatumi108/works/16", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1921793, "client_id": 1444851, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/f4eea546/uploads/origins/3ccfb309-0bfa-4dd1-9f09-5216b27b9a1d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=061e1995cb7921dd826d18dc583c87e0", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/f4eea546/uploads/origins/3ccfb309-0bfa-4dd1-9f09-5216b27b9a1d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ca4c1031621499fe91459d49ab0292df", "src_set": ""}, "body": "はじめまして。差分付きのイラストをリクエストします。\n\n■キャラクター\n｢先輩がうざい後輩の話｣の｢五十嵐双葉｣\n\n■シチュエーション\n知らないおじさんに捕まってフェラやごっくんをさせられるもの\n\n■リクエストしたい差分の流れ\n①双葉が背中で手首を縛られ、ちんぽを前に座らされて竿役を睨む\n②ちんぽを咥えてフェラ\n③根元まで咥えて上目遣いで苦しそうにフェラ\n④大量に口内射精\n⑤ちんぽを口から離してぐちゅぐちゅと咀嚼\n⑥目を瞑ってごくごくとごっくん\n⑦目にハートを浮かべて大きく口を開け舌を出し、満更でもなさそうに全部飲み込んだアピール\n⑧数時間後、大量に顔射されて口にもたっぷり精液を溜めた状態で放置されるオチ\n\n■備考\n·イラストの構図は下記のリクエストと同じような、竿役の主観視点で見下ろし、双葉が上目遣いをするものでお願いいたします。\nhttps://skeb.jp/@wadatumi108/works/13\n·双葉の服装は原作準拠のスーツでお願いします。\n\n以上、よろしくお願いいたします。", "nc": 185, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@wadatumi108/works/15", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1921793, "client_id": 817275, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/392ca27f/uploads/origins/3c53d9fb-6cfc-490d-85e7-3dadb8668ba0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=53b7e71ea34a73388cece5be4eabb47c", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/392ca27f/uploads/origins/3c53d9fb-6cfc-490d-85e7-3dadb8668ba0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=dc7ad7d12a28e580de351c671f5dd17b", "src_set": ""}, "body": "「お兄ちゃんはおしまい」のキャラクター\n・千川みなと\n・桜田ゆうた\n\n以前依頼したフェラのキャラ逆バージョンをお願いします。\nhttps://skeb.jp/@wadatumi108/works/13\n\nシチュエーションも同じで、学校のトイレの個室でみなと座っていて、ゆうたが膝をついてフェラしているイラストをお願いします。\n差分なども同一にしてもらいたいですが、ごっくんした後は目がハートのゆうたが上唇を舌で舐め、みなとに頭を撫でられて嬉しそうな表情をしているものにして頂けないでしょうか。\n\nよろしくお願いします。", "nc": 184, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@wadatumi108/works/14", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/28187a06/uploads/origins/4f0d0403-ac05-4571-91af-d7d02b37b945?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=f5df3498af5eeb7e34411165100b4cb1", "src_set": ""}, "private": true, "genre": "art", "tipped": true, "creator_id": 1921793, "client_id": 0, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 169, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@wadatumi108/works/13", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1921793, "client_id": 817275, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/f36b00cc/uploads/origins/e57a8cee-657b-426e-af46-478d72788bf6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3acbfb0d0c80bc39439c7c7708d3e06c", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/f36b00cc/uploads/origins/e57a8cee-657b-426e-af46-478d72788bf6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=125730ee987b8c1de60172599463de62", "src_set": ""}, "body": "「お兄ちゃんはおしまい」のキャラクター\n・千川みなと\n・桜田ゆうた\n\n学校のトイレの個室でゆうたがトイレに座っていて、みなとが膝をついてフェラしているイラストをお願いします。\nシチュエーションはみなとの表情をメインにしてほしいので、ゆうたの主観でゆうたの顔は出さず、服やセリフで分かる程度でお願いします。\n\nみなとは上目遣いでゆうたを見ながらフェラをして口内射精までさせてください。\n射精は全て口の中に出しますが大量射精しているため、口内が精液で満たされている感じでみなとの頬を膨らませ、鼻から精液を溢れさせてください。\n学校でバレないよう、精液は全て口の中に出すイメージです。\n\n\nみなとの口に出された精液は美味しそうな表情で咀嚼させてからごっくんさせてください。\nごっくんの場面はみなとの目がハートでお願いします。また、みなとの表情が見えるようにゆうたのチンコは描写しなくても構いません。\n余裕があれば口を開けて精液を全て飲んだアピールまでお願いします。\n\n\nよろしくお願いします。", "nc": 161, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@wadatumi108/works/12", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1921793, "client_id": 0, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/0c4cb1ff/uploads/origins/72c7ae14-dd9d-41b7-a3b8-195c3978895a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a9e0ad19462dfa7ba320c1f53ccb8d6e", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/0c4cb1ff/uploads/origins/72c7ae14-dd9d-41b7-a3b8-195c3978895a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=4699c8a01d11a04a4ba8d3d380b3eb01", "src_set": ""}, "body": "キャラ：\n「先輩がうざい後輩の話」の桜井優人\nhttps://x.com/shiromanta1020/status/1445690297028001798\nhttps://x.com/shiromanta1020/status/1342410605060222976\n\n内容：\n・学ラン上着と黄色パーカーを着ている。下にズボンやパンツを履いていない。\n・竿役にフェラしている。アングルや構図はお任せします。\n・彼はとても恥ずかしがっている。\n・ぶっかけ差分に顔も服も精液まみれをお願いします。優人くんも同じ時に射精するとエロい。\n\nご検討よろしくお願いします。", "nc": 168, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@wadatumi108/works/11", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1921793, "client_id": 817275, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/73d39251/uploads/origins/dc093237-12ed-4c70-a21a-660b8006133f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c16030bb4d6ed8285e7a301917070cde", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/73d39251/uploads/origins/dc093237-12ed-4c70-a21a-660b8006133f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=bd98e05e10477da7c0d712e252131cd5", "src_set": ""}, "body": "「お兄ちゃんはおしまい」のキャラクター\n・千川みなと\n・桜田ゆうた\n\nみなと君が受け、ゆうた君が攻め、背面座位でセックスしているイラストをお願いします。\n2人とも全裸で表情や胸が見える構図にしてほしいですが、背面座位なのでゆうた君の胸は見えなくても構いません。\n\nゆうた君はみなと君の乳首をいじりながら、興奮している表情で首筋を舐めている。\nみなと君は自分の乳首をいじりながら舌を出して、涎を垂らしながら気持ち良さそうの表情にしてください。\n激しいセックスをしている感じで2人とも全身汗だくでお願いします。\n\n射精差分もお願いしたいのですが、射精の瞬間は笑顔でゆうた君は中出し、みなと君も同時に大量射精させてください。\n\nよろしくお願いします。", "nc": 40, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@wadatumi108/works/10", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1921793, "client_id": 817275, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/c8789ec5/uploads/origins/baf99a46-f5d0-4ea1-9a39-7fb500ae3cdc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=29b1012fd066c147f667bd04457239c5", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/c8789ec5/uploads/origins/baf99a46-f5d0-4ea1-9a39-7fb500ae3cdc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3f696ec4c233672fc0e59017d5d41ae5", "src_set": ""}, "body": "「お兄ちゃんはおしまい」のキャラクター\n・千川みなと\n・桜田ゆうた\n\nゆうた君が受け、みなと君が攻め、松葉崩しの体位でセックスしているイラストをお願いします。\n2人とも全裸で表情や胸が見える構図にしてください。\n\nゆうた君は目がハートで舌を出して涎を垂らしながら気持ちよさそうな表情にしてください。\n射精差分もお願いしたいのですが、みなと君は中出し、ゆうた君は自分の顔と口の中までたっぷりと精液を飛ばしてください。\n\nよろしくお願いします。", "nc": 41, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@wadatumi108/works/9", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1921793, "client_id": 2436908, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/89739f29/uploads/origins/2215eace-5d34-4ee1-bc1e-45033381a29b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=412f58c029c78898ba7cecdbb259a302", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/89739f29/uploads/origins/2215eace-5d34-4ee1-bc1e-45033381a29b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0971bb093be098bbce747afee8dc017b", "src_set": ""}, "body": "初めまして\nわだつみさんの絵を見て心惹かれたのでリクエストいたします\n\n今回描いていただきたいのは私のキャラクターの日向湊（https://twitter.com/sakimi00/status/1770417133438320858）が、正常位で恋人繋ぎしながらセックスしている姿です\n服装は画像のような女性用下着で、ブラは上にずらして、パンツは横にずらしてペニスは露出で、皮が少し被って勃起している状態\n金額内であればアナル中だし＆湊の射精と湊の全身に精液がかかっている差分があれば助かります\n上記以外で加筆修正などがあればおまかせします\nよろしくお願いします", "nc": 169, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@wadatumi108/works/8", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/a04b7bd5/uploads/origins/4b245d10-afc0-4d84-8e45-219a75c586a7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=309c04a9c115e30f67b826a7337eab64", "src_set": ""}, "private": true, "genre": "art", "tipped": false, "creator_id": 1921793, "client_id": 2810245, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 176, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false},