rl": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/f3ca9b6f/uploads/origins/0c9c7754-816e-4d10-a81f-fb6c4fff6a4e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4527c078673cb5365f06d36208943990", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/f3ca9b6f/uploads/origins/0c9c7754-816e-4d10-a81f-fb6c4fff6a4e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3696d69b269d07f88f98f7814e384f4f", "src_set": ""}, "body": "イラストのリクエストをさせて頂きます。\n\n・前提\n島風くんと3号くんに口内射精した後の行為になります\n\n\n1.島風くんと3号くんが正面に向かって口を開け、口の中に溜まった精液を見せつけている\n2.2人がキスをしてお互いの口に溜まった精液を交換しながら飲み込んでいる。精液はキスしている間はお互いの口からこぼれさせて下さい。\n3.2人が1と同じ構図で口を開けて精液を全部飲んだことを舌を出しながらアピール\n\n\n口内射精された精液の量は多く、口いっぱいに溜まっている感じでお願いします。\n島風くんと3号くんは目にハートが浮かんでいて、恍惚の表情でお願いします。\n\n1と3は差分のようにお願いしたいですが、2の精液交換は異なる構図になると思います。\n時間や金額的に厳しい場合は2の精液交換のイラストのみでお願いします\n\n擬音などはお任せします。\n男性や局部の表示は必要ありません。島風くんと3号くん2人のみでお願いします。\n\n難しい点があると思いますが、よろしくお願いします。", "nc": 160, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "similar_creators": [{"id": 104254, "creator": true, "nsfw_acceptable": true, "acceptable": false, "name": "パンダィン＠C106合同誌ありまぁす！", "screen_name": "pandain95", "avatar_url": "https://pbs.twimg.com/profile_images/1875926066407321600/JhgXr0v8.jpg", "header_url": "https://pbs.twimg.com/profile_banners/166391703/1651322168/1500x500", "appeal_receivable": true, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "skills": [{"genre": "art"}], "nc": 48}, {"id": 263749, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "ゼブルン", "screen_name": "Zebulun_", "avatar_url": "https://pbs.twimg.com/profile_images/1384575541110472708/4ywxgI78.jpg", "header_url": "https://pbs.twimg.com/profile_banners/145643540/1740890688/1500x500", "appeal_receivable": fal