7c9-3cd2-485e-bfae-7906d92a9bbe?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=47803e01b93874006c0cc7bf95540804 2x, https://si.imgix.net/b0204c1d/uploads/origins/408b77c9-3cd2-485e-bfae-7906d92a9bbe?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=364f00945e782eaca62bbdf385c84980 3x"}, "body": "るにさんこんにちは！いつもお世話になっております。\nよろしければTRPGの自キャラ(北条武長)と相方(古舘樹)のイラストをお願いしたくリクエストを送らせていただきます！\n\n裏稼業を生業としている2人になり、お互いに家族愛を知らず相互依存の関係性です。\n同棲しており現在は寝床も同じにしている2人の、寄り添って眠る様子をお願いできればと思います。\nお手数でなければ過去を思い出して涙を浮かべながら目を閉じている樹と、それをもどかしげに見つめる表情にしていただけると幸いです…！(本当にお手数でなければなので、るにさんのイメージにお任せします！)\n\n・北条武長(男・30歳187cm)\n　銀の長髪、目の下に濃いクマ、無表情\n\n・古舘樹(男・21歳166cm)\n　ストレスで色素が抜けた髪、中性的な顔立ち・体格、手に細かい無数の傷\n\nるにさんの描かれる表情や動作など本当に大好きで、是非この2人を描いていただけたら嬉しいです！\nお忙しいところ恐れ入りますが、何卒ご検討のほどよろしくお願い申し上げます…！\n\nhttps://drive.google.com/drive/folders/1Jl2C6CtWtBsXfIFI_6OPAQHEIo-pI5iQ?usp=sharing", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@runichanman/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1942645, "client_id": 1095059, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/276df843/uploads/origins/5fa2dc23-7ca9-40a3-9065-4e47f17c229c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f6e0037cd9ec9d161e2c1ce7d74b525f", "srcset": "https://si.imgix.net/276df843/uploads/origins/5fa2dc23-7ca9-40a3-9065-4e47f17c229c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f6e0037cd9ec9d161e2c1ce7d74b525f, https://si.imgix.net/276df843/uploads/origins/5fa2dc23-7ca9-40a3-9065-4e47f17c229c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b9dbaa024420e4d5722764b0709d2b51 2x, https://si.imgix.net/276df843/uploads/origins/5fa2dc23-7ca9-40a3-9065-4e47f17c229c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=45369259fde