d-a317-0d46c8ad99a6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=49f64d3fb93770a88f2d7d2a9303c977, https://si.imgix.net/f84093ae/uploads/origins/30067ea4-0f05-4cbd-a317-0d46c8ad99a6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=e6fe5f42b46cdd3256b6db261982eb2a 2x, https://si.imgix.net/f84093ae/uploads/origins/30067ea4-0f05-4cbd-a317-0d46c8ad99a6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=549b9b1eafd370524a901829fd651b78 3x"}, "body": "貴殿の描かれるアズールレーンのイラストに惚れたのでリクエストします。\n推しキャラを描いて頂きたく依頼しました。\nアズールレーンのベニントンを描いて欲しいです。\nキャラ絵\nhttps://x.com/azurlane_staff/status/2086286343613850027\n\nベニントンの姿勢はがに股座り、以下の絵のような感じ\nhttps://x.com/azurlane_staff/status/1242383383801413632\n\n体勢と首は真っすぐに伸ばして、笑顔でダブルピースを披露している。\n\nダブルピースの位置はおヘソの両隣り\nピースの指先でおヘソ周りを広げるような仕草もついでにしている。\n\n以上の内容で\nベニントンを真正面から見た構図で\n膝関節の位置まで描いて欲しいです。\n\n他所のサイト、snsでの投稿は構いません、ドンドンやっちゃってください。", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@leroy_halladay/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 4065897, "client_id": 435662, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/36993637/uploads/origins/060edfe4-c479-440e-8ae1-df7f1ccfe85d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=eb4a45b1eecd41e8ee1fd15100fe8e8d", "srcset": "https://si.imgix.net/36993637/uploads/origins/060edfe4-c479-440e-8ae1-df7f1ccfe85d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=eb4a45b1eecd41e8ee1fd15100fe8e8d, https://si.imgix.net/36993637/uploads/origins/060edfe4-c479-440e-8ae1-df7f1ccfe85d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=958043d03260cdd3efce1be1a29a29a9 2x, https://si.imgix.net/36993637/uploads/origins/060edfe4-c479-440e-8ae1-df7f1ccfe85d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f2d717dc20de583af9a6a1597f574485 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/36993637/uploads/origins/060edfe4-c479-440e-8ae1-df7f1ccfe85d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5588cc15d615a96c089349f0ace6c445", "srcset": "https://si.imgix.net/36993637/uploads/origins/060edfe4-c479-440e-8ae1-df7f1ccfe85d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5588cc15d615a96c089349f0ace6c445, https://si.imgix.net/36993637/uploads/origins/060edfe4-c479-440e-8ae1-df7f1ccfe85d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=8efe6ede53293d6bcbeaffe962582516 2x, https://si.imgix.net/36993637/uploads/origins/060edfe4-c479-440e-8ae1-df7f1ccfe85d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=8bdb48fcc425ce533a788d1cd37a452c 3x"}, "body": "どうも、ハラディ先生。いつも作品を拝見しています。\n今回はSkebのリクエスト手数料無料キャンペーン実施中なので、もし先生興味があれば、アズレンより、インプラカブルのイラストをリクエストしたいです。\n予定はイラスト2枚形式。\n\nインプラカブル：誘惑で指揮官を挑発する受け、雑魚マン\n\n衣装：馨香靡く盃\n\n衣装参考（必要があるなら）：\nhttps://www.youtube.com/watch?v=QkMY6zNDuU8\n\n1枚目：\n範例図1～4のようなポーズ、横から見える視角（範例図5～6）。\n胸は衣装中央の紐がない、自然に地面を向かっている感じ（でか乳輪丸見え、乳首ほぼ見え）。\n差分は右手のフェラ素振り、舌出し、フェイスベール（範例図7～8、フェイスベール範例図1～3）。\n\n2枚目は範例図9～10のような事後感、中出しマンコと流れ乳強調。\n衣装は複雑すぎるなら、ストッキング＋ハイヒール+フェイスベールだけでも構いません。\n陰毛O\n\n指揮官のちんぽ描写が必要あるなら、歴戦ので淫水焼けちょっと黒い感じ。\n場合によってチンキス（範例図1と11）を入れるなら幸いです。\nオノマトペやテキストあるなら有り無し差分お願いします。\n\nリクエスト受けったら嬉しい限りです！ではよろしくお願いいたします！\n\nhttps://drive.google.com/drive/u/0/folders/1IbSHkNrpRz7WTJHh-XsQGFz_UmjSRnkW", "nc": 33, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@leroy_halladay/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 4065897, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/799eb3f8/uploads/origins/9a083a