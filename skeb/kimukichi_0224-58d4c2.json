4/status/1212339886423826437）。\n\nポーズや表情は自由です！\n\nよろしくお願いします！\n\nhttps://twitter.com/azurlane_staff/status/954206685815435265", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@kimukichi_0224/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2051749, "client_id": 1008404, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/df253e0f/uploads/origins/60067fe8-6c3e-42ea-8c61-2d4a4799d86a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8ad3fc34ba87b15c6dcf77159a64251b", "srcset": "https://si.imgix.net/df253e0f/uploads/origins/60067fe8-6c3e-42ea-8c61-2d4a4799d86a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8ad3fc34ba87b15c6dcf77159a64251b, https://si.imgix.net/df253e0f/uploads/origins/60067fe8-6c3e-42ea-8c61-2d4a4799d86a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=2ee3100857fa598976ed9c1cd577317c 2x, https://si.imgix.net/df253e0f/uploads/origins/60067fe8-6c3e-42ea-8c61-2d4a4799d86a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=9e9608db644ed3d9af28b0ab914a8124 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/df253e0f/uploads/origins/60067fe8-6c3e-42ea-8c61-2d4a4799d86a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=8f25650d8e0007260c9a732c2dc2266e", "srcset": "https://si.imgix.net/df253e0f/uploads/origins/60067fe8-6c3e-42ea-8c61-2d4a4799d86a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=8f25650d8e0007260c9a732c2dc2266e, https://si.imgix.net/df253e0f/uploads/origins/60067fe8-6c3e-42ea-8c61-2d4a4799d86a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=031b5a59c2699ed8fc6108a92f25ea9e 2x, https://si.imgix.net/df253e0f/uploads/origins/60067fe8-6c3