4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=58dfbbd2a25487a89f0719467fa6bcb6 2x, https://si.imgix.net/d2dca1f4/uploads/origins/6c9e128c-33d9-4549-8d89-39568a970304?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=8083c0090147ada4d8ac6c3a7d433984 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/d2dca1f4/uploads/origins/6c9e128c-33d9-4549-8d89-39568a970304?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=89a2b0a3db579d5051969ccc7af0af75", "srcset": "https://si.imgix.net/d2dca1f4/uploads/origins/6c9e128c-33d9-4549-8d89-39568a970304?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=89a2b0a3db579d5051969ccc7af0af75, https://si.imgix.net/d2dca1f4/uploads/origins/6c9e128c-33d9-4549-8d89-39568a970304?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=ff02a81a14c10eb36ddf5784157012d8 2x, https://si.imgix.net/d2dca1f4/uploads/origins/6c9e128c-33d9-4549-8d89-39568a970304?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=9b9571573668629c5492fbef6bc0cc65 3x"}, "body": "改めて依頼させていただきます。\nにこです。\n\n今回、TRPG「誰がロックを殺すのか」というシナリオをプレイするにあたり\nプレイヤーの立ち絵を描いていただきたく依頼させていただきます。\n\n各プレイヤーの楽器（バンドのシナリオなので）・イメージカラーと\n各々が別用途で既に使用している元立ち絵をお送りしますので\nそちらを参考にして描いていただければと思います。\n（服装などは元立ち絵と同じでなくても構いません。\n　むしろ、ねむさんがどういう服装にするのかを楽しみにしています。）\n\n形式としては背景なしの透過でお願いします。\n立ち絵の使用方法の参考として\n以前別のグループでプレイした時の画面も参考として\nお送りさせていただきます。\n\n①くりぃむそーだ\n　ギターボーカル・黄緑\n\n②タクティー\n　ベース・赤\n\n③たーみ\n　ドラム・紫\n　（ドラムは立ち絵に含めるのが難しいかと思うので\n　　無理そうであればドラムのスティックでも持たせてあげてください。）\n\n④めかぴよ\n　キーボード・青\n\n以上です。\n\n\n正式に絵のご依頼をするのが初めてなので\n依頼方法・情報不足等、至らないところもあるかと思いますが\nその際は仰っていただければ幸いです。\n\n宜しくお願い致します。\n\n参考画像ようURL\nhttps://drive.google.com/file/d/1VMBYFNwHNrcpyVIIMaUJRkhJfOE97yzm/view?usp=sharing", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@nemu0507/works/11", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 147714, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/ade2d559/uploads/origins/1579ec7a-7d46-4b90-b324-d0e1b741a352?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0f4c97368348ad0045e0721b5686ed0f", "srcset": "https://si.imgix.net/ade2d559/uploads/origins/1579ec7a-7d46-4b90-b324-d0e1b741a352?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0f4c97368348ad0045e0721b5686ed0f, https://si.imgix.net/ade2d559/uploads/origins/1579ec7a-7d46-4b90-b324-d0e1b741a352?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=932cff4e11bc3287169e338abbdc8936 2x, https://si.imgix.net/ade2d559/uploads/origins/1579ec7a-7d46-4b90-b324-d0e1b741a352?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=7acf56dd0f8f1ce6588cd59cd9bda446 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/ade2d559/uploads/origins/1579ec7a-7d46-4b90-b324-d0e1b741a352?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2bad056f4daa95a2c9bacea441cab0ab", "srcset": "https://si.imgix.net/ade2d559/uploads/origins/1579ec7a-7d46-4b90-b324-d0e1b741a352?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2bad056f4daa95a2c9bacea441cab0ab, https://si.imgix.net/ade2d559/uploads/origins/1579ec7a-7d46-4b90-b324-d0e1b741a352?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=6669872554ee0aca5f295b18f88bbe41 2x, https://si.imgix.net/ade2d559/uploads/origins/1579ec7a-7d46-4b90-b324-d0e1b741a352?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=176d01199d48f1c3def4c337134d444d 3x"}, "body": "またお願いします！\n\n犬耳、しっぽ生えた咲直が犬の本能で遠吠えしてるのがみたいです\n四つん這いでお尻を大きく強調して描いていただきたいです！\nしっぽでスカート上がってパンツが良く見えてる感じでお願いします！\n\n服装は制服姿で下着含めて着脱可能にして貰えると助かります。\n\n差分で、遠吠えしてるのがバレちゃった差分と、発情してアソコびしょびしょ(漏らしたように)で犬語混ざって誘惑する差分が見たいです\n\n要求多くてすいませんが、よろしくお願いします！", "nc": 160, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@nemu0507/works/10", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 147714, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/d2c0db9f/uploads/origins/ea1975d3-d13c-4510-8b3a-3712bd909e37?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c2639fc7909708887c3e649fed179924", "srcset": "https://si.imgix.net/d2c0db9f/uploads/origins/ea1975d3-d13c-4510-8b3a-3712bd909e37?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c2639fc7909708887c3e649fed179924, https://si.imgix.net/d2c0db9f/uploads/origins/ea1975d3-d13c-4510-8b3a-3712bd909e37?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=5dcfd3c31891aa282ae7320db5aaef63 2x, https://si.imgix.net/d2c0db9f/uploads/origins/ea1975d3-d13c-4510-8b3a-3712bd909e37?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=12af2a5b2de6d418240181ce4507bb73 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/d2c0db9f/uploads/origins/ea1975d3-d13c-4510-8b3a-3712bd909e37?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=42ac368c090baba4ad0405f400922c12", "srcset": "https://si.imgix.net/d2c0db9f/uploads/origins/ea1975d3-d13c-4510-8b3a-3712bd909e37?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=42ac368c090baba4ad0405f400922c12, https://si.imgix.net/d2c0db9f/uploads/origins/ea1975d3-d13c-4510-8b3a-3712bd909e37?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=26d72c91e390e2cfc8f20d2f2ddab638 2x, https://si.imgix.net/d2c0db9f/uploads/origins/ea1975d3-d13c-4510-8b3a-3712bd909e37?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=f3e5ed3f0e413eb84d3f16e6b05c1cfb 3x"}, "body": "またお願いします！\n\n今度は恨み恋の夏歩ちゃんでお願いします。服装は制服姿で猫耳としっぽ生えて首輪付きで！\n\n構図はおしりがよく見える感じで、尻尾のせいでパンチラしてる感じ(本人が気がついてない)がいいです。\nそして差分でパンツ見えてるの気がついて恥ずかしがってる差分(パンツは濡れてる)と、    \n\nさらに可能なら発情してしまって目がハートで全裸であそこ漏らしたかのようにビッショビショで猫語混ざりで誘ってる感じが見たいです笑    \n\nセリフとかはいい感じに任せます……\n\nよろしくお願いします！", "nc": 49, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@nemu0507/works/9", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 147714, "client_id": 448202, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/adcaf60f/uploads/origins/a4e3fe0a-9dba-4a44-a768-0b2117ad0d55?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=53596f5fbc0ee1e79e137c3879d055f4", "srcset": "https://si.imgix.net/adcaf60f/uploads/origins/a4e3fe0a-9dba-4a44-a768-0b2117ad0d55?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=53596f5fbc0ee1e79e137c3879d055f4, https://si.imgix.net/adcaf60f/uploads/origins/a4e3fe0a-9dba-4a44-a768-0b2117ad0d55?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c9a93ae7c4625255220dc0adaeb9bbae 2x, https://si.imgix.net/adcaf60f/uploads/origins/a4e3fe0a-9dba-4a44-a768-0b2117ad0d55?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=9fcacbea6b617e532174c8b9660b4a6b 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/adcaf60f/uploads/origins/a4e3fe0a-9dba-4a44-a768-0b2117ad0d55?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f76c5181b5577b4c18ef7601860b85cd", "srcset": "https://si.imgix.net/adcaf60f/uploads/origins/a4e3fe0a-9dba-4a44-a768-0b2117ad0d55?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f76c5181b5577b4c18ef7601860b85cd, https://si.imgix.net/adcaf60f/uploads/origins/a4e3fe0a-9dba-4a44-a768-0b2117ad0d55?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=82e94e645e8428447d94b1c5383e5902 2x, https://si.imgix.net/adcaf60f/uploads/origins/a4e3fe0a-9dba-4a44-a768-0b2117ad0d55?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=34cd92b3d39fb93adb6a4e7715d4b1a7 3x"}, "body": "書いて欲しいのができたんで依頼します！\n\n恨み恋の戌原咲直でお願いします。服装は制服姿で原作で被ってる帽子、リード付きの首輪のでお願いします。\nいつもより若干むっちり目だと嬉しいです(足とか胸とか)\n\n軽く発情して、犬の本能が出てしまった咲直が、恥ずかしがりながら、お散歩を誘ってるのがみたいです。\n\nその際、リードを持って渡そうとして、また黒パンツが見えちゃってるようにしてください。その際、パンツは愛液で濡れていて、パンツはレイヤー分けして脱げるようにしていただけると助かります(あそこの毛は生えてるようにお願いします)！\n\n誘ってるセリフはお任せします。犬の鳴き声混ざりだと嬉しいです笑\n\nまた、差分で\n・犬耳、しっぽ付きのやつ\n・完全に発情して、目がハートで全裸になって、尻尾振りながらおち○ぽを誘ってるシーン(その際、人語じゃなくて完全に犬の鳴き声で誘ってる)\nがあると嬉しいです。\n\n要求多くてすいません。\n可能ならよろしくお願いします！", "nc": 160, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@nemu0507/works/8", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 147714, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/0d6a792b/uploads/origins/4f5b810f-ea55-4d12-a282-79275e826ac5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9574b8e44afac887819fca42f9f34c30", "srcset": "https://si.imgix.net/0d6a792b/uploads/origins/4f5b810f-ea55-4d12-a282-79275e826ac5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9574b8e44afac887819fca42f9f34c30, https://si.imgix.net/0d6a792b/uploads/origins/4f5b810f-ea55-4d12-a282-79275e826ac5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a2c04e0661fdbbadd8c2a06ae086be43 2x, https://si.imgix.net/0d6a792b/uploads/origins/4f5b810f-ea55-4d12-a282-79275e826ac5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=469ef42fca39565375d0f904b8ee976d 3x"}, "duration": null, "nsfw": t