。キャラの性格や口調はRAI-MEIがくっ殺の似合う隠れマゾなお姉さん系、ノーブルエンジェルはドSでオラつきながらも言葉遣いが上品で、バブみを感じさせるお姉さんといったイメージです。\n\n細かく指定してしまいましたが何卒宜しくお願い致します。\n\nhttps://drive.google.com/drive/folders/1jUv87DsnPJO7pNY_UW8SRfyrto7lmJwm", "nc": 160, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@ShiMi_Mk_two/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2961809, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/d4fff497/uploads/origins/a57ea148-abba-4240-a135-83c0a3231d65?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2d0289c464b4a3e29d58878e7f9610e7", "srcset": "https://si.imgix.net/d4fff497/uploads/origins/a57ea148-abba-4240-a135-83c0a3231d65?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2d0289c464b4a3e29d58878e7f9610e7, https://si.imgix.net/d4fff497/uploads/origins/a57ea148-abba-4240-a135-83c0a3231d65?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c98307f3ff4f3cf99a13322fa215da67 2x, https://si.imgix.net/d4fff497/uploads/origins/a57ea148-abba-4240-a135-83c0a3231d65?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=040aad97f523d9e8fc4b68d086038080 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/d4fff497/uploads/origins/a57ea148-abba-4240-a135-83c0a3231d65?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b80d25a1c2ae4be4578cebf1564dc711", "srcset": "https://si.imgix.net/d4fff497/uploads/origins/a57ea148-abba-4240-a135-83c0a3231d65?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b80d25a1c2ae4be4578cebf1564dc711, https://si.imgix.net/d4fff497/uploads/origins/a57ea148-abba-4240-a135-83c0a3231d65?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=aa55dfe297dfa7e3e295b333bf80a57b 2x, https:/