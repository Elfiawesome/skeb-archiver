・メタリック感はより強調するような質感\n・アクセサリー等もアレンジ・変更はお任せします。\n・武装は水着ジャンヌオルタの物へ変更(脚の鞘のホルダーベルトに合わせてドレスのスリット方向は反対へ)\n・武装無しverもお願いします。\n\nシチュエーション：\n・ポーズはお任せします。\n・全身絵でお願いします。\n\n他指定のない事項はお任せします。\n何卒よろしくお願いします。", "nc": 177, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Dmmm103/works/10", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2896279, "client_id": 154813, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/4b91c155/uploads/origins/337305c6-f5a3-463b-b689-e5c429a960cd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bfb2a0f81d8eccc8084263f3afd35e0c", "srcset": "https://si.imgix.net/4b91c155/uploads/origins/337305c6-f5a3-463b-b689-e5c429a960cd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bfb2a0f81d8eccc8084263f3afd35e0c, https://si.imgix.net/4b91c155/uploads/origins/337305c6-f5a3-463b-b689-e5c429a960cd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e27c571c4afccd6a61153c45d3c5339d 2x, https://si.imgix.net/4b91c155/uploads/origins/337305c6-f5a3-463b-b689-e5c429a960cd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c124d4ef659ed340b8528bb8a5978772 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/4b91c155/uploads/origins/337305c6-f5a3-463b-b689-e5c429a960cd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a7b74de99bc0abf805c0c3414872c294", "srcset": "https://si.imgix.net/4b91c155/uploads/origins/337305c6-f5a3-463b-b689-e5c429a960cd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a7b74de99bc0abf805c0c3414872c294, https://si.imgix.net/4b91c155/uploads/origins/337305c6-f5a3-463b-b689-e5c429a960cd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=22e035abf0e022553b47bac9769200f6 2