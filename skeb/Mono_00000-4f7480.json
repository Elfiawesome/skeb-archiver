つもスタイリッシュなスーツを着ている。\n-威圧的でありながら、優しさを感じさせるハンサムな顔立ち。\n-人型天狗のため鼻が通常より大きく、眉毛が太く、顔には毛がない。\n-ダークグレイの目\n-天狗のため頑固でよく不機嫌になる。", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Mono_00000/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1909460, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/b5ec00ac/uploads/origins/4a7f0440-ada3-49d2-a4f0-59e5f837722c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=16e30318707996fcb726c64223a7c8d7", "srcset": "https://si.imgix.net/b5ec00ac/uploads/origins/4a7f0440-ada3-49d2-a4f0-59e5f837722c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=16e30318707996fcb726c64223a7c8d7, https://si.imgix.net/b5ec00ac/uploads/origins/4a7f0440-ada3-49d2-a4f0-59e5f837722c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a85f5e8719d2c83153719af2178f200c 2x, https://si.imgix.net/b5ec00ac/uploads/origins/4a7f0440-ada3-49d2-a4f0-59e5f837722c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=956241713cc51aedfb6b19bdddf7e4fd 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/b5ec00ac/uploads/origins/4a7f0440-ada3-49d2-a4f0-59e5f837722c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d9437ae92ab10b95d1db04a50205a293", "srcset": "https://si.imgix.net/b5ec00ac/uploads/origins/4a7f0440-ada3-49d2-a4f0-59e5f837722c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d9437ae92ab10b95d1db04a50205a293, https://si.imgix.net/b5ec00ac/uploads/origins/4a7f0440-ada3-49d2-a4f0-59e5f837722c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=5bbb1a8163fcb4f70d1bdfb1a9f5eec9 2x, https://si.imgix.net/b5ec00ac/uploads/origins/4a7f0440-ada3-49d2-a4f0-59e5f837722c?bg=%23fff&a