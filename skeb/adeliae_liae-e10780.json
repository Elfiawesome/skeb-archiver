れかが望ましいです。\n綾辻行人先生コスプレは基本的に焦げ茶色の帽子×黒色の上着×赤色のシャツ×黒色のスボンで宜しくお願いします。\nお花は“黄薔薇”・“白百合”・“黄菊”・“ピンク色のチューリップ”の四種類の.verで其々四枚のイラストをリクエストしたいです。\n更に可能でしたらスーモ×背景×お花と合う色且つ目立つ色で『Another』と作品名を描くか、或いはスーモが片手に『Another』と言う題名の描かれた“蒼色”の本を持っているポーズで描いて頂ければとても嬉しいです。\n又、構図や多少のアレンジについては全てお任せします。ご自由にどうぞ。\n宜しくお願いします！（ｷﾘｯ\n\nhttps://drive.google.com/drive/folders/1qQzUR9Nf_q99Sf8C1ZxOdChFp8KOXMZ5?usp=drive_link", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@adeliae_liae/works/9", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2663650, "client_id": 2616231, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/ff42ea82/uploads/origins/62893abf-4757-4fcb-9090-8f3804ac67be?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=86401c9889d48c8315256779dc3ead6b", "srcset": "https://si.imgix.net/ff42ea82/uploads/origins/62893abf-4757-4fcb-9090-8f3804ac67be?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=86401c9889d48c8315256779dc3ead6b, https://si.imgix.net/ff42ea82/uploads/origins/62893abf-4757-4fcb-9090-8f3804ac67be?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b9a35c48be8f2e61a912af96cb52acbe 2x, https://si.imgix.net/ff42ea82/uploads/origins/62893abf-4757-4fcb-9090-8f3804ac67be?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=7196a713bd547f125c1d430fbe31ff4a 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/ff42ea82/uploads/origins/62893abf-4757-4fcb-9090-8f3804ac67be?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a40499b58615f4890e724b1f1b6fccb0", "srcset": "https://si.imgix.net/ff42ea82/uploads/origins/62893abf-4757-4fcb-9090-8f3804ac67be?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a40499b58615f4890e724b1f1b6fccb0, https://si.