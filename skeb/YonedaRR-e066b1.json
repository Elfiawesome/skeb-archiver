60d/uploads/origins/477175ed-1ec4-4d51-b2ec-00825dc1385b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3804b1b98cb92d34248f9bace9b43395", "srcset": "https://si.imgix.net/a8c3360d/uploads/origins/477175ed-1ec4-4d51-b2ec-00825dc1385b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3804b1b98cb92d34248f9bace9b43395, https://si.imgix.net/a8c3360d/uploads/origins/477175ed-1ec4-4d51-b2ec-00825dc1385b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=9838a4bb9d4f714dddb2a83757d1c762 2x, https://si.imgix.net/a8c3360d/uploads/origins/477175ed-1ec4-4d51-b2ec-00825dc1385b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=1508f1edc0e2cfdc997604ece5eff5e6 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/a8c3360d/uploads/origins/477175ed-1ec4-4d51-b2ec-00825dc1385b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e495e4283691b0733bc905fa9118a0fc", "srcset": "https://si.imgix.net/a8c3360d/uploads/origins/477175ed-1ec4-4d51-b2ec-00825dc1385b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e495e4283691b0733bc905fa9118a0fc, https://si.imgix.net/a8c3360d/uploads/origins/477175ed-1ec4-4d51-b2ec-00825dc1385b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=839ec8df2c09c960a01bf12373ccc82e 2x, https://si.imgix.net/a8c3360d/uploads/origins/477175ed-1ec4-4d51-b2ec-00825dc1385b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=dd02ec0937fd24a0bd9eb7b22b35b83e 3x"}, "body": "こんにちは！長い間、あなたのアートアカウントを見てきました。あなたの作品の色彩と美学はとても美しく、とてもインスピレーションを受けます。いつもワクワクしながら拝見しています！私のOCを描いていただけませんか？\n\n[キャラクター説明] 私のOCの名前はラム（♂）で、以前は傲慢な魔法使いだったが、悪事を働いたために神父に罰せられ、魔法を失う呪いをかけられた。その呪いを解くために、今は懺悔として神父の教会で嫌々ながら奉仕している。彼はそれを嫌っている！彼はまだ知らないが、呪いを解くには眼球を摘出する必要がある。\n\nhttps://drive.google.com/drive/folders/1-R