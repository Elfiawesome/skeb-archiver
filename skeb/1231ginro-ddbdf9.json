バッジなどを腰付近に身に着けていますが外していただいて構いません。\nトランプの絵柄は可能であればクラブのAとスペードのAの２枚（２枚あって、１枚だけ絵柄が見えるような状態でも構いません）\n軽く背景塗り等可能であれば、カジノのようなところであればなお望ましいです。\nhttps://www.pixiv.net/artworks/111668072\n↑イメージとしてはこのような感じでお願いします。\n\nhttps://1drv.ms/f/s!Aq5BBWx_WZ6XgaYjxlD29u8ldMl5fQ?e=yVgIf2", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@1231ginro/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 201293, "client_id": 2906609, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/70c1ed93/uploads/origins/9d00271b-81d6-4a33-b8e5-4617ed2522f8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=14e77beaed3e23a96b05aa55ca701a67", "srcset": "https://si.imgix.net/70c1ed93/uploads/origins/9d00271b-81d6-4a33-b8e5-4617ed2522f8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=14e77beaed3e23a96b05aa55ca701a67, https://si.imgix.net/70c1ed93/uploads/origins/9d00271b-81d6-4a33-b8e5-4617ed2522f8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=714c47230fd7f8a82e396fff5a119084 2x, https://si.imgix.net/70c1ed93/uploads/origins/9d00271b-81d6-4a33-b8e5-4617ed2522f8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=8b17c2e5528910d860a1617d66f0d147 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/70c1ed93/uploads/origins/9d00271b-81d6-4a33-b8e5-4617ed2522f8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=679e28d5618bb096cab7bfebf293c6f1", "srcset": "https://si.imgix.net/70c1ed93/uploads/origins/9d00271b-81d6-4a33-b8e5-4617ed2522f8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=679e28d5618bb096cab7bfebf293c6f1, https://si.imgix.net/70c1ed93/uploads/origins/9d00271b-81d6-4a33-b8e5-4617ed2522f8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit