gle.com/drive/folders/1ML_brzGG7o5oMN2B29y6cDnQBshs-pmK\n\n\nskeb依頼がまだまだ慣れず至らないことばかりだとは思いますが、何か不備等ございましたら再送致します！\n改めて、今後のさいもに先生のご活躍を心の底から応援しております😭\n\nhttps://drive.google.com/drive/folders/1ML_brzGG7o5oMN2B29y6cDnQBshs-pmK", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@saimo_imoimo/works/1", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/b2240f95/uploads/origins/028bad42-bfff-42ca-954a-9dab7190c4ed?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=5142941c756d1fd3bc5c5c7cb71ef0dd", "srcset": "https://si.imgix.net/b2240f95/uploads/origins/028bad42-bfff-42ca-954a-9dab7190c4ed?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=5142941c756d1fd3bc5c5c7cb71ef0dd, https://si.imgix.net/b2240f95/uploads/origins/028bad42-bfff-42ca-954a-9dab7190c4ed?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=fa5dcc4e52edcf096715693654226bf9 2x, https://si.imgix.net/b2240f95/uploads/origins/028bad42-bfff-42ca-954a-9dab7190c4ed?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=2c558678af71503d0a85d453b10f78f7 3x"}, "private": true, "genre": "art", "tipped": true, "creator_id": 4078159, "client_id": 3534832, "nc": 17}], "sent_works": [], "similar_creators": [{"id": 566888, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "🚗aruku", "screen_name": "walking155", "avatar_url": "https://pbs.twimg.com/profile_images/1356956177960067072/ihVux3ot.jpg", "header_url": "https://pbs.twimg.com/profile_banners/710063201660960768/1590763697/1500x5