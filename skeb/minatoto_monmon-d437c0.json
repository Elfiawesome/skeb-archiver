出しワンピース姿 、9月は十五夜お月様とバニーガール制服姿 、で各先生が描いて下さってます。（現在4月〜9月分をアップしてます））\n\nどうかよろしくお願い致します(⁎ᴗ͈ˬᴗ͈⁎)", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@minatoto_monmon/works/11", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 594273, "client_id": 993561, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/eb87a99c/uploads/origins/a62bd0cd-3006-4f92-8638-2364ed233190?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=476fcb2aad31b87fc7d7e5872b2efc05", "srcset": "https://si.imgix.net/eb87a99c/uploads/origins/a62bd0cd-3006-4f92-8638-2364ed233190?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=476fcb2aad31b87fc7d7e5872b2efc05, https://si.imgix.net/eb87a99c/uploads/origins/a62bd0cd-3006-4f92-8638-2364ed233190?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=58a831335ec4d50bd5b50249dad94d08 2x, https://si.imgix.net/eb87a99c/uploads/origins/a62bd0cd-3006-4f92-8638-2364ed233190?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=622727bfa5dc851945e31b03c19edce7 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/eb87a99c/uploads/origins/a62bd0cd-3006-4f92-8638-2364ed233190?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3f2fafe4ab7e6763c7ab321ad5ec527b", "srcset": "https://si.imgix.net/eb87a99c/uploads/origins/a62bd0cd-3006-4f92-8638-2364ed233190?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3f2fafe4ab7e6763c7ab321ad5ec527b, https://si.imgix.net/eb87a99c/uploads/origins/a62bd0cd-3006-4f92-8638-2364ed233190?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=dc1758381393eba9a733f3636eaf2385 2x, https://si.imgix.net/eb87a99c/uploads/origins/a62bd0cd-3006-4f92-8638-2364ed233190?bg=%23