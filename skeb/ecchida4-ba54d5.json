続けられる。在学中に二人目を仕込もうとする痴漢達、危険日に中出しされ二人目の受精を感じ取る叶と八千穂だった…\n\nという流れでおねがいします。おま金は資料代と言う事で販売ページをURLに乗せておきます\n問題ないようでしたらお願いいたします\n\nhttps://www.dlsite.com/maniax/work/=/product_id/RJ409927.html", "nc": 169, "word_count": 5150, "transcoder": "text", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 9450, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "ナイン高橋", "screen_name": "takatakakusi", "avatar_url": "https://pbs.twimg.com/profile_images/1529374898409578496/VKnblWnZ.png", "header_url": "https://pbs.twimg.com/profile_banners/779507153480527872/1758109329/1500x500", "appeal_receivable": true, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 120, "skills": [{"genre": "novel"}, {"genre": "correction"}], "banned": false, "nc": 32}, {"id": 104517, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "棒の人@skeb募集中", "screen_name": "stickhuman", "avatar_url": "https://pbs.twimg.com/profile_images/1678401899257536513/W9SjkZWw.jpg", "header_url": "https://pbs.twimg.com/profile_banners/191059422/1688996191/1500x500", "appeal_receivable": true, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "novel"}, {"genre": "correction"}], "banned": false, "nc": 177}, {"id": 457085, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "ラクダエン", "screen_name": "catfist", "avatar_url": "https://pbs.twimg.com/profile_images/805429266082983936/Sjr3NKcC.jpg", "header_url": "https://pbs.twimg.com/profile_banners/4479861/1757126768/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "a