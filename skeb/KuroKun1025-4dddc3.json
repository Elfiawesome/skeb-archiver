ジナルのVTuberのイラストを依頼したいのですが。彼女は小柄なキツネの悪魔の女の子で、生意気で高慢な性格で、優越感に浸りがちです。ちょっといじめっ子なところもあります。大きなキツネの耳と、頭にコウモリの羽が生えています。 あごにはほくろもあります！\n\n日焼けした肌と、胸が小さい点にもご注目ください。\n\n参考資料として、私のSkebユーザーページもぜひご覧ください！（https://skeb.jp/@Tebr）\n\nポーズ、表情、背景、シチュエーションについては、お任せします！ あなたが適切だと思う、かわいい、クール、セクシーなど、どんなスタイルでも描いてください！ 衣装も、お好きなものを自由に選んでください！\n\n参考画像 1：https://imgur.com/gallery/tebr-reference-sheet-3-Zo40Hy5\n\n参考画像 2：https://imgur.com/gallery/tebr-outfit-2-ref-bmd3ryN", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@KuroKun1025/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 4043955, "client_id": 3564905, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/a3c3d3d6/uploads/origins/47bcfcf8-94f4-4d6c-8548-a87a1078f3f1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1282d965cec07ada7d21855c8d0f95d2", "srcset": "https://si.imgix.net/a3c3d3d6/uploads/origins/47bcfcf8-94f4-4d6c-8548-a87a1078f3f1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1282d965cec07ada7d21855c8d0f95d2, https://si.imgix.net/a3c3d3d6/uploads/origins/47bcfcf8-94f4-4d6c-8548-a87a1078f3f1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=fe6be9a2b424797507b8ff5227093725 2x, https://si.imgix.net/a3c3d3d6/uploads/origins/47bcfcf8-94f4-4d6c-8548-a87a1078f3f1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=cd1fdf91fd39dfc1f8a512e3cb102e83 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/a3c3d3d6/uploads/origins/47bcfcf8-94f4-4d6c-8548-a87a1078f3f1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f40287e6710bbbcab176073adea0df03", "srcset": "https://si.imgix.net/a3c3d3d6/uploads/origins/47bcfcf8-94f4-4d6c-8548-a87a1078f3f1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h