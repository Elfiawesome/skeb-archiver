eb8-40296ba9d3aa?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=42b327aa023542972d9b50cb7720c87d, https://si.imgix.net/d2273649/uploads/origins/c7577ac5-0f73-435f-8eb8-40296ba9d3aa?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=edd0a25d3dd93d372462674eee3cd671 2x, https://si.imgix.net/d2273649/uploads/origins/c7577ac5-0f73-435f-8eb8-40296ba9d3aa?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=9253c5a012319a431780866c99c55e22 3x"}, "body": "こんにちは。\narufaさんの描かれるお顔が好きです！\nデスクトップにしようするための人物と風景の絵を描いてほしいです。\n人物の詳細はURL添付画像にて確認お願いします。髪型と顔の雰囲気はそのままで洋服やポーズについてはお任せします。\nなにとぞよろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/1UbvyYIdJFwV7U9cUlj8N7Mt9RKOs8pK1?usp=sharing", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@arufasan_214/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1352773, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/b007a7e5/uploads/origins/6371cc6e-9b32-404a-add0-af4ff825f881?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=508a0466d4ee684b246f17e5c3a59175", "srcset": "https://si.imgix.net/b007a7e5/uploads/origins/6371cc6e-9b32-404a-add0-af4ff825f881?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=508a0466d4ee684b246f17e5c3a59175, https://si.imgix.net/b007a7e5/uploads/origins/6371cc6e-9b32-404a-add0-af4ff825f881?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=23fd731a12b8462b81a2fa137e5e0550 2x, https://si.imgix.net/b007a7e5/uploads/origins/6371cc6e-9b32-404a-add0-af4ff825f881?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ad6c4099adeeec9028b2347a3e6fef13 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/b007a7e5/uploads/origins/6371cc6e-9b32-404a-add0-af4ff825f881?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c32bfa96933faa01595432f431a797c6", "srcset": "https://si.imgix.net/b007a7e5/uploads/origins/6371cc6e-9b32-404a-add0-af4ff825f881?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c32bfa96933faa01595432f431a797c6, https://si.imgix.net/b007a7e5/uploads/origins/6371cc6e-9b32-404a-add0-af4ff825f881?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=addf5ffeb1038b341d2f31a07911a9df 2x, https://si.imgix.net/b007a7e5/uploads/origins/6371cc6e-9b32-404a-add0-af4ff825f881?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=26b42cd253c28a725e04c089a38b55ca 3x"}, "body": "結月ゆかりのイラストをお願いします。\n\n全体的に、静かで哀愁の漂う雰囲気をイメージしています。\n\n「主人を失った後の結月ゆかり」がテーマです。\nすでに存在しない主人に、まるで隣にいるかのように自然に話しかけながら、生前その主人が行きたがっていた場所を巡っている……という設定です。\n\n構図としては、巡っている最中にふと後ろを振り返り、誰もいない場所へ楽しそうに話しかけている瞬間を描いていただきたいです。\n視線や身体の向きから、「隣に誰かがいる前提で接している」感じが伝わると嬉しいです。\n\n表情は穏やかで柔らかい笑顔を希望します。\nただ、完全に明るい笑顔ではなく、「主人がもう居ないこと」や「自分のしていることの寂しさ」をどこか理解した上で、それでも自然に笑っているような、少し切なさの滲む表情だと嬉しいです。\n\nホラー寄りではなく、穏やかで静かな空気感を重視していただけると嬉しいです。\n\n納品いただいた作品は、SNSアイコンや動画作品内での使用を予定しています。\nまた、作品に音声を合わせた演出的な使用を行う場合があります。\n\nここまで長々と細かく書いてしまい申し訳ありません……！\nもし解釈や構図などで迷われましたら、「笑顔で可愛い結月ゆかり」を描いていただければそれだけでとても嬉しいです。\nあなたの描かれる絵が大好きです！", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@arufasan_214/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1352773, "client_id": 2188877, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/b7e9de34/uploads/origins/79b5f588-4f04-47ac-8e95-4526e04c874d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2f3047a28d3cef1c9160e95977de75c8", "srcset": "https://si.imgix.net/b7e9de34/uploads/origins/79b5f588-4f04-47ac-8e95-4526e04c874d?bg=%23fff&auto=f