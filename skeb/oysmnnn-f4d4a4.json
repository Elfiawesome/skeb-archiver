er準備中の私自身（天白こいろ）を描いていただきたく、リクエストさせていただきました\n\n【希望内容】\n・朝のおきがえ中イメージの私自身（天白こいろ）のイラストを希望します（詳細は資料URLをご確認いただきますようお願いいたします）\n・おきがえ中の衣装のイメージは、学校の制服でお願いいたします\n・米島様のむちむちとした質感のイラストが好きですので、お胸や太ももはむっちりした質感にしていただきたいです\n・可能でしたら、表情差分もいただけますとありがたいです\n・構図はお任せとさせていただきたいですが、色気を感じるイラストを希望いたします\n\n【使用用途】\n・SNSでの使用\n・YouTubeのサムネ等\n\nご検討のほど、どうぞよろしくお願い致します\n\nhttps://drive.google.com/drive/u/3/folders/1__XbB0je7_Dnk_7C0XntrJRjMboMG6XK", "nc": 33, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@oysmnnn/works/13", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3100532, "client_id": 3166503, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/44ca2b83/uploads/origins/3d758768-f5b1-44dd-97ee-fd5849d1e73d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9d75f8a0280aa9c83fdb17a87cc468de", "srcset": "https://si.imgix.net/44ca2b83/uploads/origins/3d758768-f5b1-44dd-97ee-fd5849d1e73d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9d75f8a0280aa9c83fdb17a87cc468de, https://si.imgix.net/44ca2b83/uploads/origins/3d758768-f5b1-44dd-97ee-fd5849d1e73d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=d0e09ea6158544cedc04e04e934c52b6 2x, https://si.imgix.net/44ca2b83/uploads/origins/3d758768-f5b1-44dd-97ee-fd5849d1e73d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=0a3d786432fa304a0a5aa7301d9a0c59 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/44ca2b83/uploads/origins/3d758768-f5b1-44dd-97ee-fd5849d1e73d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a9b2b67d6b0ec4c8e3abcef3f50c52e0", "srcset": "https://si.imgix.net/44ca2b83/uploads/origins/3d758768-f5b1-44dd-97ee-fd5849d1e73d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a9b2b67d6b0ec4c