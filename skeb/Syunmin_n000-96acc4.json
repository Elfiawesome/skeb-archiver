gで納品いただきたいです。\n\n・その他\n髪や頭など、見切れないように描写いただけますと幸いです。\n可能であれば、資料内にあるペンギンもどこかに描写いただきたいです。\n\n・好きなもの、モチーフ\n海系のもの（海、貝殻、ペンギン、海の生き物など）\nスイーツ（ケーキ・パフェ、フラッペなど）\n雲、絆創膏、ロリータ、かわいいもの\n\nなど\n何かお役にたてれば幸いです。\n┈┈┈┈┈\n\n何卒ご検討の程よろしくお願いいたします...！\n\nhttps://drive.google.com/drive/mobile/folders/1MP6YJ-WBAsw1Tis9BerD93_BasCMSraa?usp=forms_web&sort=13&direction=a&pli=1", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@Syunmin_n000/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3390083, "client_id": 2608964, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/cd9084d9/uploads/origins/927861b6-e40a-4804-bf53-4ec73fea8e73?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2149eefe8cdb58430c99200907e266c1", "srcset": "https://si.imgix.net/cd9084d9/uploads/origins/927861b6-e40a-4804-bf53-4ec73fea8e73?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2149eefe8cdb58430c99200907e266c1, https://si.imgix.net/cd9084d9/uploads/origins/927861b6-e40a-4804-bf53-4ec73fea8e73?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=9a108cda9ed58299f6ef56ba9c222d0e 2x, https://si.imgix.net/cd9084d9/uploads/origins/927861b6-e40a-4804-bf53-4ec73fea8e73?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=06603b0549f942b70988dbdeefe9d4ca 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/cd9084d9/uploads/origins/927861b6-e40a-4804-bf53-4ec73fea8e73?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=082a8a26bd2e1384fd08119e058a308f", "srcset": "https://si.imgix.net/cd9084d9/uploads/origins/927861b6-e40a-4804-bf53-4ec73fea8e73?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=082a8a26bd2e1384fd08119e058a308f, https://si.imgix.net/cd9084d9/uploads/origins