rop&crop=top&w=200&h=200&s=0c7268598ee883dddda869f2b8d98e87 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/a20ae2dd/uploads/origins/ff943015-2494-4e39-bb4d-0f2fc8be2ba3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a91c4d23954fd4fd052a27c76544f9bf", "srcset": "https://si.imgix.net/a20ae2dd/uploads/origins/ff943015-2494-4e39-bb4d-0f2fc8be2ba3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a91c4d23954fd4fd052a27c76544f9bf, https://si.imgix.net/a20ae2dd/uploads/origins/ff943015-2494-4e39-bb4d-0f2fc8be2ba3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=e3fb3d322e94a15d3b206d9de44685ea 2x, https://si.imgix.net/a20ae2dd/uploads/origins/ff943015-2494-4e39-bb4d-0f2fc8be2ba3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=47b76d93f32189b10ca19c08081f94aa 3x"}, "body": "> シリーズ\n「ランスシリーズ\n\n\n>登場人物\n女性：イージス・カラー\nhttps://i.imgur.com/rimAqtm.png\n\n男性：-ランス\nhttps://i.imgur.com/hL95aIu.png\n\n\n>シナリオ\n- このポーズ：https://www.pixiv.net/artworks/109317252 (手コキ＋キス)\n\n\n>衣装\n- メタリックゴールドのビキニ、フィンガーレスグローブ、サイハイブーツ。\n\n- 男性キャラクターは、口と髪がわかるようにしてください。\n\n\n>注意事項\n- その他はお任せします。\n\n\nありがとう！", "nc": 184, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@ITA_PPP/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 656548, "client_id": 3354435, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/921894c5/uploads/origins/787c72e2-e2b4-4bb0-9939-b091a60b4a85?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=982042686448a7a9deae93d3fec57d1d", "srcset": "https://si.imgix.net/921894c5/uploads/origins/787c72e2-e2b4-4bb0-9939-b091a60b4a85?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=982042686448a7a9deae93d3fec57d1d, h