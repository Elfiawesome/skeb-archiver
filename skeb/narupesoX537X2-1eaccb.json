向かって左）と、左耳（向かって右）の耳にホクロがあります\n・髪型はウルフヘアで、右側だけ長い毛束があります　外ハネ気味です\n・黒ネイルをしています\n・衣装はある程度簡略化して頂いても構いません\n・顔立ちは気持ち男性寄りですが、どちらとも取れるイメージです\n\n三面図はなく、正面のみになりまして申し訳ありません。\nポーズ、構図、表情はお任せ致します。\nまた、着彩の有無はお任せ致します。\n\n使用用途\nYouTube動画のサムネイルやXでの投稿等に使用させて頂きたいと思っております。活動に使用するにあたり、可能であれば透過PNGファイルも併せて納品いただけると幸いです。\n\nご検討の程よろしくお願いいたします。\n\nhttps://drive.google.com/file/d/1N7Iggp0aPtjRloMh5w_7uq9xAhXYv8Ln/view?usp=drivesdk", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@narupesoX537X2/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3710182, "client_id": 2330445, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/d18f7a9c/uploads/origins/bc4b177c-f2fe-4610-8e3a-2ebcf823c769?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d3055ca8d6aa1210fdfaa843e39df6ef", "srcset": "https://si.imgix.net/d18f7a9c/uploads/origins/bc4b177c-f2fe-4610-8e3a-2ebcf823c769?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d3055ca8d6aa1210fdfaa843e39df6ef, https://si.imgix.net/d18f7a9c/uploads/origins/bc4b177c-f2fe-4610-8e3a-2ebcf823c769?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=d24e2386a3d1ca1baa306f013b54a171 2x, https://si.imgix.net/d18f7a9c/uploads/origins/bc4b177c-f2fe-4610-8e3a-2ebcf823c769?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b12d5492fbff5a6b7c86d218eda10a7b 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/d18f7a9c/uploads/origins/bc4b177c-f2fe-4610-8e3a-2ebcf823c769?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=1a1cc99bcb34f42c0e5d558349567d43", "srcset": "https://si.imgix.net/d18f7a9c/uploads/origins/bc4b177c-f2fe-4610-8e3a-2ebcf823c769?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=1a1cc99bcb34f42c0e5