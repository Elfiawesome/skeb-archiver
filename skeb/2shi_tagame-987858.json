713-bc3b-c992d42ea6c8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b65de5a8c9feefad9d931b9d39f83d65 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/0e7e4736/uploads/origins/1cdc0b12-5f60-4713-bc3b-c992d42ea6c8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=fc9d31b78c6fcf72eaef7fb1a9450ea9", "srcset": "https://si.imgix.net/0e7e4736/uploads/origins/1cdc0b12-5f60-4713-bc3b-c992d42ea6c8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=fc9d31b78c6fcf72eaef7fb1a9450ea9, https://si.imgix.net/0e7e4736/uploads/origins/1cdc0b12-5f60-4713-bc3b-c992d42ea6c8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=e9df1b04117121109ed7568e6ba3eed0 2x, https://si.imgix.net/0e7e4736/uploads/origins/1cdc0b12-5f60-4713-bc3b-c992d42ea6c8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=9e9e7913a5f11f42cd190fba6e3ea90e 3x"}, "body": "昨日お送りしたリクエスト文は誤解を生む表現があったのでキャンセルして書き直しました。\n申し訳ありません。\n改めてリクエストお願い致します。\n\n================================\n\n\n西タガメさんのツンとしたキャラの顔つきが好きで\n是非とも好みのシチュエーションを描いてもらいたいと思いリクエスト致します。\n\n大まかにはドルフロ、カルカノM91がモブおっさんに催眠をかけられ棒立ち状態のまま悪戯をされるというシチュエーションです。\n\n\nカルカノM91はスカートのみ脱がされていてタイツとショーツが丸見えの状態で立っています。\n(マントやトップスの裾等は邪魔になるようでしたら変更お任せ致します。)\n(また、ショーツはストライプのデザインにアレンジして頂けると嬉しいです。)\n\nその状態のまま背後に立つモブおっさんに身体の前に手を回され股間をネチネチと触られます。\nカルカノは催眠状態の為、無表情で正面を見続けてはいますがそのおっさんに嫌悪感を抱いているので\nうっすら顔に敵意や焦りが漏れ出ていると最高です！\n\n\n基本お願いしたいイラストはこの様な内容なのですが\n西タガメさんのイラストは流れを感じられる作りで描かれる事が多いので\n贅沢を許して頂けるなら…\n\n強くなってくる刺激に耐えカタカタ震える様や\nモブおっさんの「ほーらほらほら、このままじゃ嫌いな男の手でいっちゃうんじゃないか」\n等の台詞付きで最後は盛大にいくカットがあると大変嬉しいです。\n\n是非ともよろしくお願いいたします。", "nc": 168, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@2shi_tagame/works/17", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 290915, "cli