g=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0de8b90bfe990c027131dd22517aef7c, https://si.imgix.net/85ce008d/uploads/origins/af588f64-ba6b-45c8-83e9-5a31d43c40f5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=b7ccae10e87e159b11f897f030d4e02c 2x, https://si.imgix.net/85ce008d/uploads/origins/af588f64-ba6b-45c8-83e9-5a31d43c40f5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=7d5731ccbade7d4bce500667bac278ef 3x"}, "body": "ソファに座るモンタギューの絵。周囲にはジョニの全3バージョン（ジョニ・ザ・レッド、ジョニ・ザ・スカーレット、レッド・ルイン・ジョニ）が取り囲み、モンタギューは有頂天で、興奮を抑えられるかどうかわからない様子。 各ジョニは異なる性格で、ジョニ・ザ・レッドはモンタギューの隣に座り非常に動揺して恥ずかしがっている。スカーレット・ジョニはより色っぽく、モンタギューに寄り添うように座っている。レッド・ルイン・ジョニは全員の後ろで「ブエェェェェ」といったことを言いながら、おバカなふざけた様子で振る舞っている。このニュアンスがうまく伝わるといいのだが。", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@uwannuchan/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3487977, "client_id": 3611502, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/1b925a86/uploads/origins/fb6619fc-be4a-46f2-b6c5-65cadb6433ff?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=95fcd9b3c6957af6980df3ae443a4a7c", "srcset": "https://si.imgix.net/1b925a86/uploads/origins/fb6619fc-be4a-46f2-b6c5-65cadb6433ff?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=95fcd9b3c6957af6980df3ae443a4a7c, https://si.imgix.net/1b925a86/uploads/origins/fb6619fc-be4a-46f2-b6c5-65cadb6433ff?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a0cd75a981d25cc9685148ce95da12dc 2x, https://si.imgix.net/1b925a86/uploads/origins/fb6619fc-be4a-46f2-b6c5-65cadb6433ff?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a874c243b919bfebc168b89f4a8e0f1d 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls":