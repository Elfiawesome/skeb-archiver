b5d-4915b3d8b5fd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=01b0a3c3bd0eaabaa7462de830aba0ca", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/fe399c4d/uploads/origins/12ed6884-4652-44da-ab5d-4915b3d8b5fd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b9e6b8c8fb19f6470a5a2f741a89e16f", "src_set": ""}, "body": "こんにちは、あなたのアピールを見て、あなたのアートスタイルがとても気に入りました。vtuberの高村貴子さんの絵をお願いしたいです。参考画像：https://drive.google.com/file/d/1DQNHsnzCRyoYX0feqS0vKkJmf4Y6lDke/view\n\n普段の服装はメイド服なのですが、夏らしいカジュアルな服装で描いてほしいです。白のトップスに黒のショートパンツ、サンダルという格好で描いていただけませんか？\n\nポーズや表情はお任せします。\n\nよろしくお願いします！\n\nhttps://drive.google.com/file/d/1DQNHsnzCRyoYX0feqS0vKkJmf4Y6lDke/view", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@kayumikomi/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2053370, "client_id": 745817, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/6f3fadb3/uploads/origins/57e942f3-35ec-4b41-bfa6-6b0016123de6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9f9ae4572aaed5bb076f1f1b84fccd14", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/6f3fadb3/uploads/origins/57e942f3-35ec-4b41-bfa6-6b0016123de6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=347926d775b19fd574f61ba5b0222141", "src_set": ""}, "body": "8/12にライブやるんですけど普段聴かない陽キャの音楽を演奏することになりバチゴリしんどいので自分へのご褒美としてライブで使うベースの擬人化イラストをおねがいします…\nキャラデザなどは壁打ちしときます…\n(2匹使うので依頼料足しときますね…)", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@kayumikomi/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2053370, "client_id": 954265, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/714d619c/uploads/origins/673a21e9-4bc0-449d-8645-9be747bac6b8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=45df207f5d1200943215b02c4c9ba1fa", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/714d619c/uploads/origins/673a21e9-4bc0-449d-8645-9be747bac6b8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ecd3b3379eb4cb826afe1ee8da2ccdf9", "src_set": ""}, "body": "みぎひださんの絵、いつも見てて肉感とか体格が特に好み！！！なので、\n両腕欠損ちゃんがもう少し大人に、高校生くらいになった絵をお願いしたいです。\n\n【リクエスト内容】\nこの欠損ちゃんが高校2年生くらいになって、\n部屋で足でギターを練習で楽しそうに弾いているシチュエーションをお願いしたいです。\nhttps://skeb.jp/@o0x0o0o/works/8\nhttps://skeb.jp/@o0x0o0o/works/5\n(元作品のクリエイター様からの許可は頂いています。)\n\n\n【両腕欠損ちゃんについて】\n体型は大体高校生相応に成長している感じですが、\n腕がないので脚は器用で、太めにむちっと発達しています。\n胸はイメージとしてはこのくらいでしょうか\nhttps://twitter.com/migihida_trpg/status/1676276781610070017\n\n結構いい体つきな感じで、みぎひださんらしい健康的な色気が感じられたら、とっても嬉しいです！\n\n服装は下記の参考のような、欠損してる肩の部分とおへそが見える動きやすそうな部屋着でお願いします。\n部屋着のショートパンツから下はギターを弾いているため裸足です。\nただし、左足首にはアンクレットをつけています。\n\n■欠損してる肩部分の実写参考\n両腕は肩からなく、欠損してる部分はこの方のようになっています。\nhttps://www.instagram.com/p/CuTKaxeLNwm/\nhttps://www.instagram.com/p/CjT3atppfJo/\n他の角度からの資料など、もっと見たいなどありましたらこの方が他に上げておられる写真のほうもたくさんあるのでご覧いただければと思います。\n\n■服装参考\n部屋着\nhttps://www.pixiv.net/artworks/100104425\nhttps://www.pixiv.net/artworks/105799610\n※茶髪の子のほうです。\n\n自分、ファッションセンス０なので、万が一色的に似合わなかったりした場合は色のほう変えてもらえれると助かります。\n\nアンクレット\nhttps://www.pixiv.net/artworks/77899109\nこの絵の足についているものです。\n\n\n【ギターを弾いているシチュエーションについて】\n以下の実写参考動画のように、\n欠損ちゃんが椅子などに座って足の指にピックを挟んで弾いている、という感じのシチュエーションです。\nギターは、ボディ部分(大きくて厚い部分)には薄い敷物を\nネック部分(細くて薄い部分)にはもう少し厚いクッションを敷いて安定するように置かれているという感じです。\n\n■足でのギターの弾き方と置き方の実写参考\nhttps://youtu.be/S6NKhyEezFY\n※17秒まで体全体、17秒から足とギター部のアップ\nhttps://youtu.be/mrn7Gw0_dOg\n※全編が体全体\n\n\n【その他の希望】\n◎目はつぶった状態ではなく、瞳が見える状態で描いてほしいです。\n\n◎構図は、絵の中に両足の先までは切れずに入っていてほしいのと、\n欠損部とおへそ周りは、髪や足や障害物などで隠れず、絵に映っている感じでお願いします。\n\n◎背景は適当でも大丈夫です。女の子重視でお願いします。\n\n以上、よろしくお願いします。\n承認してもらえたらとても嬉しいです！\n急ぎではないのでみぎひださんの都合のよいペースでまったりと描いていただければ、と思います。", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@kayumikomi/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2053370, "client_id": 2387042, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/c4cae0b6/uploads/origins/b86e78e4-7058-4d88-a652-ca470c46e3d9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=08719b339bb20d22d1de1955cf4ab289", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/c4cae0b6/uploads/origins/b86e78e4-7058-4d88-a652-ca470c46e3d9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ef09324202f8144414cbcf6b78e50122", "src_set": ""}, "body": "初めまして！\n絵柄が好みだったので、オリキャラを描いていただきたいです。\nまた、SNSでの公開、アイコン使用許可をいただきたいです！\n(依頼アカウントとは別に@moniumu_allのアカウントでもイラストをアップさせてください！)\n\nもしよろしければお任せで好きな服装を着せてください！\nカジュアルでもドレスでも、露出多めでも本当に何でも大丈夫です！\n(そのままの服装でも大丈夫です！)\nポーズや構図はお任せいたします！\n\n◆キャラ資料\nhttps://twitter.com/moniumu_all/status/1619665581191610369?s=20\nhttps://twitter.com/moniumu_all/status/1619665449410756609?s=20\n\n▼分かりづらい要素\n・耳について\n耳は人間の耳がついてます。\nケモの耳っぽいのは、髪の毛でやっております。\n\n・足について\n靴で隠れているため見えないですが、足も手と同様黒っぽくなって爪が鋭くなってます。\n\n以上、ご検討よろしくお願いいたします。", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "similar_creators": [{"id": 767714, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "やまおか", "screen_name": "gumi_gorira", "avatar_url": "https://pbs.twimg.com/profile_images/1965343467602935812/jvEC7IHm.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1314417471525253120/1755930155/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "delet