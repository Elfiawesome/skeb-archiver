2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=70c2917f43d11952b8ce7908541fcbf7 2x, https://si.imgix.net/037644f6/uploads/origins/78812b20-eca3-47f5-b142-5e7acead28ef?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=e74e26a4ea74fede82d90bea2e6aa9fb 3x"}, "body": "初めまして、和邇 すもも🦈🔞先生の描くイラストが好みで、OCを描いてもらいたく、リクエストさせていただきました。\n\nミア／174cm／真祖吸血鬼\nプラチナブロンドのロングヘアと眼鏡に柔らかな微笑みが印象的な温和で母性的な雰囲気の女性。\n秘書として完璧に職務をこなし、ボスや組織を影から支えているが、その正体は、儀式の暴走により覚醒した真祖の吸血鬼。お酒と温泉をこよなく愛し、オフの日の飲み歩きや夜の散歩が趣味。\n\n彼女の詳しい外見、設定は資料URLにあります。\n\n衣装、ポーズ、構図お任せいたします。\n体型はお好みに調整してもらっても大丈夫です。（彼女は陥没乳首です。）\n未指定の部分についてはお任せをしたいと思います。\n\nご検討いただけますと幸いです。\n\nhttps://drive.google.com/drive/folders/1nnjPDI-i4U0mg4VwgjhAZkzh55iDy3UX?usp=drive_link", "nc": 176, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@WANIsumomo/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3982054, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/9476b62c/uploads/origins/729b7a0d-bf87-4607-976f-a4b3d59288ee?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7f901e5df411c13349f585398a69751e", "srcset": "https://si.imgix.net/9476b62c/uploads/origins/729b7a0d-bf87-4607-976f-a4b3d59288ee?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7f901e5df411c13349f585398a69751e, https://si.imgix.net/9476b62c/uploads/origins/729b7a0d-bf87-4607-976f-a4b3d59288ee?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=024b402640a5725fde4495efed45c233 2x, https://si.imgix.net/9476b62c/uploads/origins/729b7a0d-bf87-4607-976f-a4b3d59288ee?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=0c7ccbbf85ab9d10ebd825a85f528904 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/9476b62c/uploads/origins/729b7a0d-bf87-4607-976f-a4b3d59288ee?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b3222825677bb4be79a1e7eda0ee89bb", "srcset": "https://si.imgix.net/9476b62c/uploads/origins/729b7a0d-bf87-4607-976f-a4b3d59288ee?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b3222825677bb4be79a1e7eda0ee89bb, https://si.imgix.net/9476b62c/uploads/origins/729b7a0d-bf87-4607-976f-a4b3d59288ee?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=72f14404d3613039a485a11e97e1ba7d 2x, https://si.imgix.net/9476b62c/uploads/origins/729b7a0d-bf87-4607-976f-a4b3d59288ee?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=2b3c7fa5ce3426c49df321b37c60c099 3x"}, "body": "こんにちは！私のリクエストをご検討いただき、ありがとうございます。\n\nこのオリジナルキャラクター（OC）を描いていただけませんか？ポーズや表情は、お好きなように自由に描いてください。\n\nhttps://drive.google.com/drive/folders/1CdmWtz9hf6VzgNdCSpavRT6VlPEdqDb7", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@WANIsumomo/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3982054, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/190c1ad3/uploads/origins/ac1a6e8b-3486-4a55-b0b9-e16e3836780d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e0ae80f7f994b2392f23381e4c4b553a", "srcset": "https://si.imgix.net/190c1ad3/uploads/origins/ac1a6e8b-3486-4a55-b0b9-e16e3836780d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e0ae80f7f994b2392f23381e4c4b553a, https://si.imgix.net/190c1ad3/uploads/origins/ac1a6e8b-3486-4a55-b0b9-e16e3836780d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=57ed7485e9eb81281dda5f2b74f310d5 2x, https://si.imgix.net/190c1ad3/uploads/origins/ac1a6e8b-3486-4a55-b0b9-e16e3836780d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=19fe72af4fc905a8047550ef92b6a12b 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/190c1ad3/uploads/origins/ac1a6e8b-3486-4a55-b0b9-e16e3836780d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f8ca4d89167fc7e46d67f5cfb2e731d7", "srcset": "https://si.imgix.net/190c1ad3/uploads/origins/ac1a6e8b-3486-4a55-b0b9-e16e3836780d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f8ca4d89167fc7e46d67f5cfb2e731d7, https://si.imgix.net/190c1ad3/uploads/origins/ac1a6e8b-3486-4a55-b0b9-e16e3836780d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=fd8b5b6d669409a459b4768c46621a8a 2x, https://si.imgix.net/190c1ad3/uploads/origins/ac1a6e8b-3486-4a55-b0b9-e16e3836780d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=823af2e27b266553230aa73f191a23d0 3x"}, "body": "先生、こんにちは\n\n私のキツネ娘2人による、エロティックなレズビアンバトル／キャットファイトのアートを依頼したいです。\n\n「ハナ」＆「ツキ」：https://catbox.moe/c/p4u8ae\n\n「ハナ」（ピンクのキツネ）： 彼女は色っぽく、ライバルをからかうのが好きですが、逆にからかわれると攻撃的になります。非常にプライドが高く、負けるのが大嫌いです。\n\n「ツキ」（青のキツネ）： 彼女はライバルをからかったり侮辱したりするのが好きですが、逆に侮辱されると腹を立てます。傲慢で、負けるのが大嫌いです。\n\n二人をフタナリとして描き、相手が敗北するまで激しく互いを愛撫し合う様子を描いてください。\n\n体位に関しては、個人的には69、相互手コキ、相互フェラなど、互いに攻め合うようなシチュエーションが好きです。\n\n衣装は自由に描いてください。セクシーなコスプレやランジェリーも大歓迎です！バトルはできるだけエロティックに描いてください。女の子たちを辱めたり、ポーズや動作を荒々しくしても構いません！構図や最終的な勝者については、あなたの裁量にお任せします。ダブルKOや引き分けでも構いません。", "nc": 41, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@WANIsumomo/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3982054, "client_id": 153686, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/a7e54052/uploads/origins/7a8ad8b6-d1e8-4427-be17-d70e8266cb85?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=78b1f435687d719ee4928e0f25b80d26", "srcset": "https://si.imgix.net/a7e54052/uploa