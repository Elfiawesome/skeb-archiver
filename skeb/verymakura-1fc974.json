2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=7ca917566d8afc39f19c4558a59dcda6, https://si.imgix.net/1bb64895/uploads/origins/fb1befc5-5da6-458a-80a2-606c8f4258f3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=9ddefa3135e757d4e1bf7576f6ee5325 2x, https://si.imgix.net/1bb64895/uploads/origins/fb1befc5-5da6-458a-80a2-606c8f4258f3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=cda832241a4654736af82709042c4741 3x"}, "body": "枕さん、こんにちは。\nだいぶ前になりますが、イラスト作成を依頼した者です。\nその節は素晴らしい作品をありがとうございました。\nまた作成いただきたいイメージがありますので、以下の通りリクエストいたします。\nお眼鏡に適えばご対応いただけると幸いです。\n\n＜依頼概要＞\n「貧乳で剛毛なお嬢様が、スケスケの服装で街を闊歩しているイラスト」を描いてください。\n\n＜キャラクター＞\n「両家のお嬢様」のイメージで、以下の特徴のキャラクターを作成してください。\n・整った顔立ちで、黒のロングヘア。前髪はぱっつんの姫カット。\n・年齢は10代。\n・胸は貧乳。乳首は小指の先ぐらいの大きさで、乳輪は乳首とほぼ同サイズの小ささ。乳首も乳輪も色は濃い目(小豆色)。\n・腋毛はそれなりに生えている。陰毛も濃い目で、肛門の周りにも生えている。\n・服装は「胸が丸出しの、シースルーの白いドレス(ベビードール)」を着ている。\n　ドレスの他に「つばが広い帽子」と「肘までの長さの手袋」を身に着けている。それ以外の下着などはなし。\n　当然、陰毛がドレス越しに透けて見えている。\n・靴、靴下のデザイン、有無はお任せします。\n\n＜構図など＞\n上記のキャラが、昼間の街中を歩いている、またはたたずんでいる様子を描いてください。\n少女の膝から上、または全身が画面に入る構図としてください。\n街中のイメージですが、少女以外の人は特に描かなくて大丈夫です。\n野外露出をしているという風ではなく、本人も周囲もあくまで日常的な光景、という想定で、少女の表情もそれに基づいてください。\n背景は金額の範囲内でご対応ください。簡素なものでも結構です。\n\nご検討いただけると幸いです。\nよろしくお願いします。", "nc": 187, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@verymakura/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1537704, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/40056c14/uploads/origins/9ea98452-adc7-4a23-a72e-5851390e4762?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=541243e5d00b8dc011ab1df9d823d289", "srcset": "https://si.imgix.net/40056c14/uploads/origins/9ea98452-adc7-4a23-a72e-5851390e4762?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=541243e5d00b8dc011ab1df9d823d289, https://si.imgix.net/40056c14/uploads/origins/9ea98452-adc7-4a23-a72e-5851390e4762?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ef45d649ae8682545dd7ad05ea1f65bb 2x, https://si.imgix.net/40056c14/uploads/origins/9ea98452-adc7-4a23-a72e-5851390e4762?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=bb7e77c6c0773b716a5085aa85fe5382 3x"}, "duration": null, "nsfw": true, "hardcore": true, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/40056c14/uploads/origins/9ea98452-adc7-4a23-a72e-5851390e4762?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3f86883e3ad04c5e6270d354a500833d", "srcset": "https://si.imgix.net/40056c14/uploads/origins/9ea98452-adc7-4a23-a72e-5851390e4762?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3f86883e3ad04c5e6270d354a500833d, https://si.imgix.net/40056c14/uploads/origins/9ea98452-adc7-4a23-a72e-5851390e4762?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=01bc02dd91433dc80bcc7ed24607e612 2x, https://si.imgix.net/40056c14/uploads/origins/9ea98452-adc7-4a23-a72e-5851390e4762?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=78360f495cab843f8756e6650de278ab 3x"}, "body": "はじめまして\nリクエストさせていただきます。\nキャラ　サムス・アラン\nシチュ\n裸で口とマンコにチンコ挿入、そして放尿される。\nマンコは流し込まれる断面図があると嬉しいです。\nサムス自身は驚いた様子で頬を膨らませて必死にこぼさないように飲み込む。\n最後に恍惚とした表情のアップで鼻から飲みきれない分逆流したりしながらおしっこ臭い息でゲップしちゃう。\n筋肉質に描いてもらえると助かります。\nその他細かいところはお任せします。\n以上、検討をお願いいたします。", "nc": 43, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@verymakura/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1537704, "client_id": 854183, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/c963761c/uploads/origins/2b85c999-1f0c-4e21-a5f6-c854a5569b1f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c77521638286332f02f05536f2c39a35", "srcset": "https://si.imgix.net/c963761c/uploads/origins/2b85c999-1f0c-4e21-a5f6-c854a5569b1f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c77521638286332f02f05536f2c39a35, https://si.imgix.net/c963761c/uploads/origins/2b85c999-1f0c-4e21-a5f6-c854a5569b1f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=9e426715257bb644e7e67696d080ebbc 2x, https://si.imgix.net/c963761c/uploads/origins/2b85c999-1f0c-4e21-a5f6-c854a5569b1f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c31101ace4b8a33945d3fff778afb5de 3x"}, "duration": null, "nsfw": true, "hardcore": true, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/c963761c/uploads/origins/2b85c999-1f0c-4e21-a5f6-c854a5569b1f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6b52c08d4797993fda377b27139feef0", "srcset": "https://si.imgix.net/c963761c/uploads/origins/2b85c999-1f0c-4e21-a5f6-c854a5569b1f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6b52c08d4797993fda377b27139feef0, https://si.imgix.net/c963761c/uploads/origins/2b85c999-1f0c-4e21-a5f6-c854a5569b1f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=beee4448b612b22f3342b1be9e88a7c9 2x, https://si.imgix.net/c963761c/uploads/origins/2b85c999-1f0c-4e21-a5f6-c854a5569b1f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=5e11fdb8253ab067b1ae8d3c208a132b 3x"}, "body": "枕さん、はじめまして。\n以下の内容でリクエストいたしますので、もしよろしければご対応いただけると幸いです。\n(悪趣味な内容を含むため、不快に思われましたら遠慮なくキャンセルしていただいて結構です。)\n\n＜依頼概要＞\n「左右でおっぱいの大きさが違う女の子の、自撮り画像がネットに流出」というテーマの作品をお願いします。\n\n＜登場人物＞\n・「左右でおっぱいの大きさが違う女子大生」を、枕さんのセンスで作成してください。\n　具体的には、右胸が資料URLの作品の女の子と同じぐらいの大きさで少し垂れ気味、左胸が右胸より二回り小さいぐらいでお願いします。\n\n※以下の要素は、可能であれば含めていただけると嬉しいです。\n　難しければ無視していただいても結構です。\n・ファッションに明るい感じの、少し派手な容姿。\n・下の毛の処理は甘く、肛門の周りまで毛が生えている。\n・モントゴメリー腺(乳輪のぶつぶつ)が多少目立つ状態。\n\n＜作品の流れ＞\n・初めて付き合うことになった大学の先輩にせがまれて、恥ずかしがりながらも女の子が胸やおしりの自撮り写真(ヌード)を彼氏に送る様子を、3カット程度描いてください。\n・そのうちの1カットは、顔と胸が正面から撮られたものを含めてください。\n\n・「画像がネットに流出し、一部のネットユーザーの間で拡散された」旨の文章をイラストの上に載せてください。\n\n・金額的に可能であれば、上記の自撮り写真の前に、女の子の日常生活のひとコマを描いていただけると嬉しいです。\n\n＜備考＞\n・「左右でおっぱいの大きさが違う女の子」の要素以外は、多少改変していただいても問題ありません。\n\nご検討いただけると幸いです。\nよろしくお願いします。\n\nhttps://www.pixiv.net/artworks/95180616", "nc": 187, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@verymakura/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1537704, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/d553fe8a/uploads/origins/becf48b1-8208-4362-bf19-39aa68de7d01?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2d71d1960a00a41d1ed3e49c67f71f34", "srcset": "https://si.imgix.net/d553fe8a/uploads/origins/becf48b1-8208-4362-bf19-39aa68de7d01?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2d71d1960a00a41d1ed3e49c67f71f34, https://si.imgix.net/d553fe8a/uploads/origins/becf48b1-8208-4362-bf19-39aa68de7d01?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=0d5575179ffff282704f1c9e945453a4 2x, https://si.imgix.net/d553fe8a/uploads/origins/becf48b1-8208-4362-bf19-39aa68de7d01?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=8981c32a2d490c495a75ef08ee3bb56e 3x"}, "duration": null, "nsfw": true, "hardcore": true, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/d553fe8a/uploads/origins/becf48b1-8208-4362-bf19-39aa68de7d01?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=54b53f3abc0fea3978dd8a2899832ad0", "srcset": "https://si.imgix.net/d553fe8a/uploads/origins/becf48b1-8208-4362-bf19-39aa68de7d01?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=54b53f3abc0fea3978dd8a2899832ad0, https://si.imgix.net/d553fe8a/uploads/origins/becf48b1-8208-4362-bf19-39aa68de