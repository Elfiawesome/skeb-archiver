_visible": false, "total_appeals_count": 0, "received_works": [{"path": "/@usanui_nuinui/works/14", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3005491, "client_id": 3260776, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/be3f0ee1/uploads/origins/83d13b7c-0ff2-4cf2-b224-3418a64c5272?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=36fd5bb219c48ff2468f46ab37cb510d", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/be3f0ee1/uploads/origins/83d13b7c-0ff2-4cf2-b224-3418a64c5272?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=457d68b8bb66a92412d73cd39624f7b3", "src_set": ""}, "body": "「アークナイツ」のキャラクター「ムエルシス」を描いていただけますか？\n\nもしテーマの設定が可能であれば、彼女の緑と水のコンセプトを取り入れていただけると嬉しいです。ゲーム内のように、彼女がエレガントで生意気な感じでお願いします！\n\nあなたの解釈による彼女のイラストを楽しみにしています。ありがとうございます！\n\n\n\n参考のために彼女のコンセプトビデオをこちらに添付します。\n\nhttps://youtu.be/vHUJ2cBT8SE?si=pGkqMA68eBF1g97s", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@usanui_nuinui/works/13", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3005491, "client_id": 103872, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/fe6b94d6/uploads/origins/72034750-6726-4669-b82f-ef133ea496f7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ad0d9aae16516336259cdea8477bb970", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/fe6b94d6/uploads/origins/72034750-6726-4669-b82f-ef133ea496f7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e655d75f30dce9dc093ca6dcdda9c7b6", "src_set": ""}, "body": "うさぬいさん、はじめまして\nX(Twitter)で拝見したエイヤフィヤトラやマドロックのイラストが大変素敵で可愛らしく、リクエストさせていただきました。\n\nよろしければアークナイツのロスモンティスを描いていただけないでしょうか。\nポーズやコーデの種類など細かい指定はございません。\n納品形式はpsdだと嬉しいです。\n\n以下の通りクライアントに紐付く各種SNS（TwitterやMisskey、Mastodon等）で利用させていただく場合がございます。\n\n・アイコン\n・ヘッダー\n・スマートフォン等の壁紙\n・上記各種SNSへの作品投稿（紹介目的に限定しSkebのURLを必ず併記します）\n・その他Skebの利用規約やガイドラインで許可されていること\n\nご検討くださいますよう、お願いいたします。\n\n※参考：「アークナイツ」二次創作・ゲーム実況配信及び動画投稿に関するガイドライン\nhttps://arknights.jp/fankit/guidelines", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@usanui_nuinui/works/12", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3005491, "client_id": 3155660, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/8fd0317a/uploads/origins/207f399e-fd65-447c-a14c-7e2d8b326c7f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=dac536954043d45fa7bb3293882bc818", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/8fd0317a/uploads/origins/207f399e-fd65-447c-a14c-7e2d8b326c7f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9044e8d903a6c2e2b007d968bb80eab8", "src_set": ""}, "body": "初めまして、いつも素敵なイラストを拝見させていただいております。\n書いていただきたい内容なのですが、アークナイツのマドロックをお願いしたいです。\n服装はオブシディアンのコーデを希望します。構図等は先生にお任せします。\n用途としては、Xのアイコンとして使用したいと考えております。\n何卒よろしくお願いいたします。", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@usanui_nuinui/works/11", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3005491, "client_id": 39140, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/04ce1b88/uploads/origins/c1d10c06-e92a-49d5-ac0a-a5f5bc38532d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=14dc037a681b90ec2265d72a7d08541e", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/04ce1b88/uploads/origins/c1d10c06-e92a-49d5-ac0a-a5f5bc38532d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=424c87b1015db4bc947575378eb155ca", "src_set": ""}, "body": "初めまして、うさぬいさんの絵柄が好みでリクエストを送らせていただきます。今回はアークナイツ のウィーディを描いていただきたいです。 服装、構図などはうさぬいさんにお願いしたいと思っております。 今回Skeb初利用なこともあり、記入、情報不足などがあったら申し訳ありませんが、お時間がありましたらよろしくお願いいたします。", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@usanui_nuinui/works/10", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3005491, "client_id": 3339782, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/b5fbe0d1/uploads/origins/a5e92d0b-34f9-4927-8729-c59c6bba346c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=befee800c3742c3b46520af124f7a29d", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/b5fbe0d1/uploads/origins/a5e92d0b-34f9-4927-8729-c59c6bba346c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d73179c1501fcd496da6cdad25e1a711", "src_set": ""}, "body": "うさぬい先生、こんにちは！\n以前の依頼では素敵な作品をありがとうございました。\n今回はBlueskyヘッダー用イラストを描いていただきたいと思い、ご連絡差し上げました。\n\n■希望のイラスト\nキャラクター：「しろうさぎちゃん」または「くろうさぎちゃん」\nシチュエーション：「暖かな冬」をテーマにお願いします。\n構図、ポーズ、衣装：おまかせ\nサイン：隅に先生のサインをいただきたいです。(宛名は不要です)\nもし可能であればヘッダー位置調整時にサインが入るよう動かしたいので、別レイヤーにしてPSDファイルに含めていただけますでしょうか。\n\n■使用用途\nBlueskyヘッダー画像、観賞用\n\n■サイズ\nアスペクト比、画像サイズ：おまかせ\n\n■その他\n納品物の扱いはお気遣いなく。\n\nいちファンとしてこれからも先生のご活躍を応援しています。\n体調を崩しやすい気候が続きますが御身体にはお気をつけて、どうかご自愛ください。\n最後までお読みいただき、ありがとうございます。\nどうぞよろしくお願いいたします。", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@usanui_nuinui/works/9", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3005491, "client_id": 933490, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/ba72684f/uploads/origins/7b4f8e1d-a471-4256-a031-f2aee9f5732b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c10013b8881f6414de6776a267c14a86", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/ba72684f/uploads/origins/7b4f8e1d-a471-4256-a031-f2aee9f5732b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=4ab052760b2c6338a6694fd18679e7af", "src_set": ""}, "body": "うさぬい先生はじめまして！ゆくちまと申します。\n先生の描かれるラ・プルマちゃんやうさぎちゃんが特に好きで、いつもイラスト拝見させていただいております。\n是非とも先生の絵柄で描かれたうちの子(VRSNSアバター)を見てみたく、リクエストをお送りさせて頂きました。以下箇条書きにはなってしまいますが、よろしくお願いいたします。\n\n【使用用途】\n・SNSのヘッダー、アイコンの他VRChatでの使用や、自宅で飾る用途で使いたいです\n\n【デザイン】\n・衣装については、基本的には資料として送らせて頂いている水着でお願いしたいのですが、アクセサリ類等の細かいディティール類に関しては必要に応じて省略・アレンジして頂いて構いません。\n・顔に「さめ」というタトゥーが入っているのですが、かなり小さいものなので拡大して描くか、省略して頂いてかも構いません。\n・ポーズや構図、表情については先生にお任せします。可愛く書いていただけると嬉しいです！\n\n【備考】\n・可能であれば、背景やサイン等が別レイヤーになったpsd形式でお渡しいただけると幸いです。\n\n【資料】\n・以下、資料画像をGoogleDriveに、3DモデルのビューをVroid Hubにて閲覧可能にさせていただきます。\nhttps://drive.google.com/drive/folders/1_dpu4dG-KO6QhM3HIbEtPvpcqhrluRpn?usp=sharing\nhttps://hub.vroid.com/characters/7623959922334547044/models/7960073042262409630\n\nどうぞよろしくお願いいたします！！", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@usanui_nuinui/works/8", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3005491, "client_id": 2426424, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/d7c0ab02/uploads/origins/8a45a856-d82b-4469-b323-51a8eda752fe?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6e21977e510174bdcf61dc84daee6f94", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/d7c0ab02/uploads/origins/8a45a856-d82b-4469-b323-51a8eda752fe?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=00330b893e783bbf8d73b999395df8fa", "src_set": ""}, "body": "すごい安くなったタイミングでリクエストするの金欠だと思われそうですがギルティギアストライブのラムレザルを描いて欲しいです。\nURLの動画に出てくる赤黒カラーでお願いします。\nアトリ可愛すぎたので期待してます。\n\nhttps://youtu.be/L59mu4Rackk?si=yaUvb4HLxsHmpKif", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@usanui_nuinui/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3005491, "client_id": 3414189, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/16e725cf/uploads/origins/be04569c-512f-4a61-b549-07e5cc075da8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=da36ae284ec8630aceb736ac647360bf", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/16e725cf/uploads/origins/be04569c-512f-4a61-b549-07e5cc075da8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a270ceffe1cae4bb80bf3be5c5112a68", "src_set": ""}, "body": "初めまして、いつもうさぬいさんの絵を見て元気をもらっている者です！\nうさぬいさんの絵柄でアークナイツのプラチナを描いてみてほしいな、と思って依頼の方をさせていただきました。\n服装、構図などは全てうさぬいさんにお任せしたいです！\n当方Skeb初利用なこともあり、失礼や抜けなどがあったら申し訳ありませんが、お時間がありましたらよろしくお願いいたします。", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@usanui_nuinui/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3005491, "client_id": 2845229, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/9f31959a/uploads/origins/99b9bd04-439a-4699-b3f9-0610a03b79af?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=dcbd596e8c79f3a6f50fa8957d38500a", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/9f31959a/uploads/origins/99b9bd04-439a-4699-b3f9-0610a03b79af?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a7831141567862cef3748572d1f12aa0", "src_set": ""}, "body": "うさぬい様\n\n初めまして、Vtuberのシャルエと申します。\nうさぬい様の素敵なイラストを拝見し、リクエストを送信させていただきました。\nもしご縁をいただけましたら、私シャルエのイラストをお願いいたします。\n\n【リクエスト内容】\nうさぬい様の絵柄で冬らしいイラストをよろしくお願いいたします。\n衣装は省略や装飾の少ない衣装に変更などうさぬい様の描きやすい形でお願いできますと大変ありがたく存じます。\n\nサムネイルなどに使用させていただきたいため、可能であれば帽子の左右どちらかのツバが見切れない構図、もしくは猫耳全体が入った構図を希望です。\n\n【使用用途】\nYoutube、SNS、FANBOX支援者様にネットプリント・壁紙の配布\n難しい内容がございましたら、別のレイヤーでお教えいただけますと大変ありがたく存じます。\n\n【納品形式】\n人物、背景、宛名等がレイヤー分けされたPSDもしくは背景透過のPNGを希望です\n\n【キャラクターについて】\n・魔法図書館で使い魔猫に囲まれて暮らす白猫\n・身長150センチ（耳を含まない）\n・猫耳としっぽがあり、人間の耳がありません\n\n【参考資料】\nhttps://drive.google.com/drive/folders/12YJ1-uparnq_s7hCfYaCiP4sSk9bZMpW?usp=sharing\n\nご検討いただけますと幸いでございます。\nどうぞよろしくお願いいたします。", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@usanui_nuinui/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3005491, "client_id": 0, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/50c3b9f9/uploads/origins/80debe30-6237-4e2f-943c-fb92ec14da4b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a862e64ab62aa4df543c219a3c942189", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/50c3b9f9/uploads/origins/80debe30-6237-4e2f-943c-fb92ec14da4b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=77ec0c691c540a91a1c27de8e6be81c4", "src_set": ""}, "body": "こんばんは。\nたくさんいいねしてリプ出来ずにマロ送ってる者です。\n\n本題ですが今回描いて頂きたいのは「ATRI-My Dear Moments-」というノベルゲーム作品のアトリというキャラです。\n構図はカニを頭上に持ち上げて喜んでるアトリを描いて頂きたいです。\n\nゲームをやっていればわかるネタですのでSteamで2200円、スマホで2900円と安くて15時間程度で終わるので1度クリアして見てください。\nルート分岐もhappyとbadだけなので悩む必要はほとんどないです。\nうさぬいさんの描くアトリ絶対かわいいので見てみたいです。\nよろしくお願いします。", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@usanui_nuinui/works/4", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/bd2befd5/uploads/origins/5e6f63a7-c583-45ea-8488-103dae79c550?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=7b2f534b0cd1a91c4f243e5e0b9635e1", "src_set": ""}, "private": true, "genre": "art", "tipped": true, "creator_id": 3005491, "client_id": 3269309, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 144, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@usanui_nuinui/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3005491, "client_id": 3243495, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/426d43da/uploads/origins/cfae4259-5fab-4894-ad0b-8c5662ba32ce?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7353b27cd4964a69caf5770b8344b7a5", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/426d43da/uploads/origins/cfae4259-5fab-4894-ad0b-8c5662ba32ce?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e77ff87ed2e1cd334f3880cdee4ec004", "src_set": ""}, "body": "はじめまして。\nうさぬい先生の可愛いイラストを拝見しまして、ぜひTwitterヘッダー用イラストを描いていただきたいと思い、ご連絡差し上げました。\n\n■希望のイラスト\nキャラクターの特徴：うさみみ、白髪ロング、青目\nシチュエーション：草原でピクニック中に木陰の下で休むキャラクター\n構図：おまかせ\nポーズ：おまかせ\n服装：おまかせ（可能であれば夏っぽい服のイメージでお願いします）\nその他：雰囲気としては、先生のTwitterポスト「しろうさぎちゃん」のイラストが好みです。\nhttps://twitter.com/usanui_nuinui/status/1770053450707161202?t=fI9rLi16kpFB4LGSGWANQA&s=19\nサイン：もし可能であれば右下隅に先生のサインいただければ幸いです。（宛名は不要です）\n\n■使用用途\nTwitterヘッダー画像、観賞用\n\n■サイズ\nアスペクト比： 横3×縦1\n画像サイズ： 横1500×縦500 等（アスペクト比さえ合えばどのサイズでも構いません）\n\n■その他\n先生の「しろうさぎちゃん」が可愛すぎて一目惚れしたので依頼させていただきました。\nこのような依頼がご無理のようであれば、気兼ねなくお断りいただければと思います。\n\n依頼の結果に関わらず、いちファンとしてこれからの先生のご活躍を応援しています。\n最後までお読みいただき、ありがとうございます。\nどうぞよろしくお願いいたします。\n\n※内容修正のため、リクエスト再送させていただきました。", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@usanui_nuinui/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3005491, "client_id": 3092286, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/433a1bb3/uploads/origins/8ec4b67b-2c1d-4d1f-be85-a9b8649229f5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=58ddfde02cc3c0c42b93662baef3c9be", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/433a1bb3/uploads/origins/8ec4b67b-2c1d-4d1f-be85-a9b8649229f5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=7784492e144729bc5f701521fa619fe1", "src_set": ""}, "body": "うさぬいさま\n\nはじめまして。面識も何もなく、Skebを拝見して絵柄に惹かれ、メッセージを送らせて戴いた不躾をご容赦ください。\nもしよろしければ、イラストをお願いしたく思います。\n\n内容ですが、ガールズ＆パンツァー最終章のヨウコです。\n学校帰りに友人と談笑しながら、道すがら買った甘いもの(鯛焼きとか御座候とか)にぱくついて嬉しそうに楽しそうにしている、そんな感じのイラストを希望しています。\n背景は描き込まなくて構いません。\nヨウコの表情は、SNSのアイコンにも使いたいと思っています。\n\nご検討のほどよろしくお願いいたします。\n\nhttps://girls-und-panzer-finale.jp/chara/youko/", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@usanui_nuinui/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3005491, "client_id": 2994167, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/9368a2ae/uploads/origins/051f9291-5a90-4d86-8c0f-4c8f97f05640?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d3d3e30d801fec26478caf2d04db5a68", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/9368a2ae/uploads/origins/051f9291-5a90-4d86-8c0f-4c8f97f05640?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=4101a25681890c6c024bc0f007fd921c", "src_set": ""}, "body": "前々から依頼したいなと思っておりました！\n私のコテキャラを描いていただけないでしょうか？\nうさぬい様の描かれる瞳が特に好きな為狼の耳〜胸までのイラストでお願いします。\n表情やポーズはお任せします。\n\n後ろ髪は肩甲骨あたりまであり、髪色はインナーカラーが下に行くにつれて水色から白っぽい銀色にグラデーションしています。外側の髪も下に行くにつれて薄くなっています。（資料URL先に参考としてカラーコードの記載あり）\n\n白い襟は前後共に同じ形をしています。\n\n耳や髪は見切れないようにしてください。\n\n使用用途は個人観賞用ですが、今後もしも配信活動を行うことになりましたらアイコンやヘッダー、サムネに使用するかもしれません。\n\n楽しみにお待ちしております。\nよろしくお願いいたします。\n\nhttps://ameblo.jp/haruharu-record/entry-12832620509.html", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "similar_creators": [{"id": 1196426, "creator": true, "nsfw_acceptable": false, "acceptable": false, "name": "海野うに", "screen_name": "_umino_uni_", "avatar_url": "https://pbs.twimg.com/profile_images/1909938899620929536/TdugLD36.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1382281329144786951/1744197312/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "skills": [{"genre": "art"}], "nc": 16}, {"id": 1381841, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "✏️@Skeb", "screen_name": "skeb1000", "avatar_url": "https://pbs.twimg.com/profile_images/1828085100653039616/UZAW7xEX.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1371682622330396674/1724684441/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 20, "skills": [{"genre": "art"}, {"genre": "comic"}], "nc": 17}, {"id": 2177354, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "うさ🍑みみ ☕️🍞⚙️", "screen_name": "usahana101", "avatar_url": "https://pbs.twimg.com/profile_images/1621891384004464642/fUuuWqbk.jpg", "header_url": null, "appeal_receivable": false, "popular_creator_rank": 59, "