et/34bfe977/uploads/origins/0b498c8e-d021-4b22-b8f9-b3ad9c99d32b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=05366f1678659a48422b458361942778, https://si.imgix.net/34bfe977/uploads/origins/0b498c8e-d021-4b22-b8f9-b3ad9c99d32b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=bb8f25c1bd799711169b348cded37186 2x, https://si.imgix.net/34bfe977/uploads/origins/0b498c8e-d021-4b22-b8f9-b3ad9c99d32b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=2d8f0a0f6fd7a3d285654b07a83aeca9 3x"}, "body": "ぐぐのじ様\n\nはじめまして。\nエンタメ吸血鬼VTuberの神崎妖琥と申します。\n\n3周年を記念して新衣装を公開したため、\nぜひ新衣装の神崎妖琥を、ぐぐのじ様に描いていただきたくリクエストをお送りしました。\n\nぐぐのじ様の、アニメのワンシーンのようなパキッとした塗りや、男性キャラクターを格好よく魅せる描き方がとても好きです！\n特にskebにある青髪剣士のイラストが、漫画の表紙のような格好よさでとても印象に残っており、ぐぐのじ様の絵柄で描かれる自分の姿を見てみたいと思い、今回ご依頼させていただきました。\n\n■ イラスト内容\n・新衣装の神崎妖琥（赤髪）\n・格好よさの中に、吸血鬼らしい妖しさや色気がある雰囲気\n・少し挑発的で、悪戯っぽい表情\n・牙の見えるいたずらっぽい笑みなども似合いそうだと思っています\n・構図やポーズ、演出については、ぐぐのじ様にお任せしたいです\n\n■ 使用用途\n・YouTubeのサムネイル\n・Xのアイコンや投稿画像\n　※画像として使用する際は、AI対策としてウォーターマークを重ねます\n・Discordのアイコン（自分用）\n・今後制作予定の神崎妖琥公式Webサイトに、本作品を掲載させていただく可能性がございます\n　掲載時には、ぐぐのじ様のお名前とXアカウントへのリンクをクレジットとして併記させていただきます\n　※元データの配布・販売は行いません\n\n■ その他\nサムネイルに使用したいため、可能でしたらキャラクターの髪の毛や左右が大きく見切れずに描いていただけると大変助かります。\n\n■ キャラクター参考\nX：https://x.com/kamiyouko\n参考：https://x.com/you_night/status/2085012660912103481?s=20\n\n以上です、よろしくお願いいたします！\n\nhttps://x.com/you_night/status/2085012660912103481?s=20", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@susk_orenji/works/9", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3432039, "client_id": 1806360, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/20d2aabd/uploads/origins/8c6a082d-3ccd-468d-8e79-5a79a8a4b435?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1fdbf8ad13d4e671e37f90704c0cedd1", "srcset": "https://si.imgix.net/20d2aabd/uploads/origins/8c6a082d-3ccd-468d-8e79-5a79a8a4b435?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1fdbf8ad13d4e671e37f90704c0cedd1, https://si.imgix.net/20d2aabd/uploads/origins/8c6a082d-3ccd-468d-8e79-5a79a8a4b435?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=3a1e9f36a73b37168dfc2654f3684fa7 2x, https://si.imgix.net/20d2aabd/uploads/origins/8c6a082d-3ccd-468d-8e79-5a79a8a4b435?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=6ddf31833157f27b22c63e007f9c675b 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/20d2aabd/uploads/origins/8c6a082d-3ccd-468d-8e79-5a79a8a4b435?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b8152be6cefeae81396eb122b7125403", "srcset": "https://si.imgix.net/20d2aabd/uploads/origins/8c6a082d-3ccd-468d-8e79-5a79a8a4b435?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b8152be6cefeae81396eb122b7125403, https://si.imgix.net/20d2aabd/uploads/origins/8c6a082d-3ccd-468d-8e79-5a79a8a4b435?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=32b41c9cab5dc8c9a4d9effc91f28713 2x, https://si.imgix.net/20d2aabd/uploads/origins/8c6a082d-3ccd-468d-8e79-5a79a8a4b435?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=abe4644fbefc53a1146fe0f88f1f5c73 3x"}, "body": "はじめまして！ぐぐのじさんのイラストに一目惚れした者です。\nぐぐのじさんの絵で私のキャラクター(探索者)を見てみたく、リクエスト送らせていただきます。\n\n以下、軽い設定です。\n\nーーーーーーーーーーーーーーーーーーー\n‣名前：加賀野井京(かがのい きょう)\n45歳/男性/177cm\n一人称：僕(素は俺)\n\n物腰柔らかな警視庁捜査一課の刑事。\n誰に対しても笑顔を向け、敬語で話す。\n本心を読み取ることは難しいが、強い正義感と責任感を持つ。\n右目に大きな傷があり、人相が悪くなっているものの元々の顔は整っており、スタイルも良い。髪は若白髪(元は黒髪)。右前腕をなくしていますが、義手もあるので腕の有無はお任せいたします。\n\n人並み外れた精神力を有しており、\n言動が大胆であったり距離感がバグっていたりする。\n人によっては気味悪がられているかもしれない。\nーーーーーーーーーーーーーーーーーーー\n\n強すぎる精神性を表情に乗せていただけると嬉しいです……！\n資料先にネタバレ等はございません。\n\n\nお忙しいところ大変恐縮ですが、ご検討の方よろしくお願いします。\n\nhttps://www.dropbox.com/scl/fo/qip44axr4y7ywpr0pizg6/AAhtWDX2H6yjNTmfk90rnfQ?rlkey=n964l0ildmxwrf6uymnxy1die&st=9y4broar&e=1&dl=0", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@susk_orenji/works/8", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/24ff08c5/uploads/origins/302a33e3-a064-4946-91d2-543a38f1a1d8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=4ac73c73b6df4f5c6991665431d521cf", "srcset": "https://si.imgix.net/24ff08c5/uploads/origins/302a33e3-a064-4946-91d2-543a38f1a1d8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=4ac73c73b6df4f5c6991665431d521cf, https://si.imgix.net/24ff08c5/uploads/origins/302a33e3-a064-4946-91d2-543a38f1a1d8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=7e88d42206b23e5cf113f96ea5a80fff 2x, https://si.imgix.net/24ff08c5/uploads/origins/302a33e3-a064-4946-91d2-543a38f1a1d8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=0f3721319e630c0c7af5404021da5019 3x"}, "private": true, "genre": "art", "tipped": true, "creator_id": 3432039, "client_id": 3901605, "nc": 145}, {"path": "/@susk_orenji/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3432039, "client_id": 1592963, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/bef02ff4/uploads/origins/6a450b2e-db80-4edf-8f9d-0e5b3f4a14d1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=47a4f4ecda9f9cf917e17a38e2154a33", "srcset": "https