3fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1b4b8fa7aa9f73dd036369318bf3bae9, https://si.imgix.net/801c62d4/uploads/origins/92aa9126-eedb-4c46-965b-a5722db898fc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f1fc8878212a15893822a2c23218e532 2x, https://si.imgix.net/801c62d4/uploads/origins/92aa9126-eedb-4c46-965b-a5722db898fc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=30b89582957ce41d321f50e5744bf01d 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/801c62d4/uploads/origins/92aa9126-eedb-4c46-965b-a5722db898fc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e0d7cc3e285a69504284ef9d2c3e4949", "srcset": "https://si.imgix.net/801c62d4/uploads/origins/92aa9126-eedb-4c46-965b-a5722db898fc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e0d7cc3e285a69504284ef9d2c3e4949, https://si.imgix.net/801c62d4/uploads/origins/92aa9126-eedb-4c46-965b-a5722db898fc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=e417bd4becff2f703e8165e77fc75186 2x, https://si.imgix.net/801c62d4/uploads/origins/92aa9126-eedb-4c46-965b-a5722db898fc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=508bff855770a148cac4a5166cb320b2 3x"}, "body": "とっても好みの可愛い絵柄だったのでコミックの作成をお願いしたいです。\n\n飼っているハムスターを擬人化した資料とキャラ設定です。\n\nちから\nhttps://x.com/divinecolor_ai7/status/1796523444437438965\n名家の血筋のサラブレッド。\n警戒心がとても強いが、一度懐に入るとめちゃくちゃ甘えてくる。\n食べ物が大好きで、好きな食べ物を食べている時だけ警戒心がゼロになる。\n運動神経抜群で、攻撃力が高い。\nとにかく男が嫌いでよくマウントを取る。隣の家の住人(たから)に勝ちたいといつも思っている。\n\nたから\nhttps://x.com/divinecolor_ai7/status/1796523406034415712\n病弱男子。アレルギー持ち。\n寝ること(と食べること)以外外界への全く興味がなく警戒心はゼロ。\nご飯もそこまで好きではないので手懐けるのが難しい。好き嫌いが激しく偏食。\n運動神経は皆無ですぐにエネルギー切れを起こす。\n隣に人(ちから)が住んでいることを忘れている。\n\nコミックの内容は、ちからがたからに喧嘩を売ったけど、そもそもたからはちからのことを憶えていなくてちからがショックを受けるという感じでお願いしたいです。\n\n資料はイラストメーカーで作ったのですが、ハムスターの耳がなかったのでクマ耳になっているのを少し直してほしいのと、背中の羽は無しでお願いしたいです。\n一応ハムスターの資料も送ります。\nちから\nhttps://x.com/divinecolor_ai7/status/1795342161967476777/photo/1\nたから\nhttps://x.com/divinecolor_ai7/status/1795341123453690259/photo/1\n\nよろしくお願いいたします。", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@masayo_00/works/2", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/fea18631/uploads/origins/76ef75ef-4da6-4bb2-93bf-47439f960bab?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=511d53da07b74451943a26f0e6c04825", "srcset": "https://si.imgix.net/fea18631/uploads/origins/76ef75ef-4da6-4bb2-93bf-47439f960bab?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=511d53da07b74451943a26f0e6c04825, https://si.imgix.net/fea18631/uploads/origins/76ef75ef-4da6-4bb2-93bf-47439f960bab?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=2f097a0a8a8f549f27d16f57b3b3f309 2x, https://si.imgix.net/fea18631/uploads/origins/76ef75ef-4da6-4bb2-93bf-47439f960bab?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=2c76b3ee3675175c3cbbf615ad6936d1 3x"}, "private": true, "genre": "comic", "tipped": true, "creator_id": 1545191, "client_id": 37489, "nc": 144}, {"path": "/@masayo_00/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "comic", "tipped": false, "creator_id": 1545191, "client_id": 693788, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/ff3d16ab/uploads/origins/6b58f00f-77ea-4ec4-8c43-39f579fea2a3?bg=%23fff&auto=for