った状態で、スライムを見下ろしている。（お腹をおさえながら）\n\n② しゃがみ込んで、嫌がるスライムを股間に押し付ける。\nパンツを履いたまま放尿。\n\n③ スライムの真上にお尻がくるように移動して、放屁する。\n（差分）そして排便する。「お尻をキレイにするのもヨロシクね」的なセリフがほしいです。\n\n可能でしたら、下着の有り無し差分をお願いします。\nまたセリフ付きをお願いします。\n\n【参考図】\nhttps://drive.google.com/drive/folders/1Ro1xNEnKS6-eBF865h8gzb54Rko6oGHk?usp=sharing", "nc": 176, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@ura_gano_kin/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1365454, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/26c5f086/uploads/origins/fa13d420-5c76-43a2-a4c5-3e1572a4e19c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bcbb07022f4c9b9987f09a048bdd3e8c", "srcset": "https://si.imgix.net/26c5f086/uploads/origins/fa13d420-5c76-43a2-a4c5-3e1572a4e19c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bcbb07022f4c9b9987f09a048bdd3e8c, https://si.imgix.net/26c5f086/uploads/origins/fa13d420-5c76-43a2-a4c5-3e1572a4e19c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b766e1f8557da2468baa90aa7c86483c 2x, https://si.imgix.net/26c5f086/uploads/origins/fa13d420-5c76-43a2-a4c5-3e1572a4e19c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=627a2460cba47552b882cecf5acca1d9 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/26c5f086/uploads/origins/fa13d420-5c76-43a2-a4c5-3e1572a4e19c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=dac38c2194aa9c94f685830ec1a9c7e5", "srcset": "https://si.imgix.net/26c5f086/uploads/origins/fa13d420-5c76-43a2-a4c5-3e1572a4e19c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=dac38c2194aa9c94f685830ec1a9c7e5, https://si.imgix.net/26c5f086/uploads/origins/fa13d420-5c76-43a2-a4c5-3e1572a4e19c?bg=%23fff&auto=format%2Ccompress&fm=webp