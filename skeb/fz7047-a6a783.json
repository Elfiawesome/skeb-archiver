t/c999d46a/uploads/origins/9040e623-7f27-4cca-87a0-e04319aa195d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=09b616ee4993b006133f370c88da09ab 3x"}, "body": "月城 様\n\n\nはじめまして、突然のリクエスト失礼いたします。\n\n以前より 崩壊:スターレイルのイラストを拝見しておりまして\nその美麗さ、儚さに大変惹かれました。\n\nつきましてはこの度、私の固定キャラをリクエストさせて頂きます。\n以下に内容記載しますので、是非ご検討ください！\n\n【依頼内容】\n・個人勢VTuber メリ・シエントのイラスト 1点\n・構図、ポージングは全て 月城様にお任せいたします。\n・背景がある場合、背景なし透過の差分も頂けますと大変ありがたいです。\n\n【参考URL】\nhttps://drive.google.com/drive/folders/1HZ_PdqI-JRwv8PaLtszlwZVQnJtO6rPr\n※眼鏡にはチェーンがついています。\n\n【使用用途】\nYouTubeチャンネル内やSNSなどの\n配信活動全般での使用を想定しています。\n\nこれからも月城様の創作活動を僭越ながら応援しています！\n以上、どうぞよろしくお願いいたします。\n\n\nメリ・シエント", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@fz7047/works/8", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3658043, "client_id": 2282841, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/a2f07fef/uploads/origins/053f0217-9757-480d-b779-3d4a20fd699e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ea080456ab5391493c46f5a38fd0720b", "srcset": "https://si.imgix.net/a2f07fef/uploads/origins/053f0217-9757-480d-b779-3d4a20fd699e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ea080456ab5391493c46f5a38fd0720b, https://si.imgix.net/a2f07fef/uploads/origins/053f0217-9757-480d-b779-3d4a20fd699e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f919f2917813b1a78ee95223b88f8211 2x, https://si.imgix.net/a2f07fef/uploads/origins/053f0217-9757-480d-b779-3d4a20fd699e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=6e70298e03226ee29ed30cf8ee0cd6a5 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/a2f07fef/uploads/origins/053f0217-9757-480d-b779-3d4a20fd699e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop