ins/ad8335cd-a8c1-4366-8e8b-1376a302fcdf?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=b186798603828f4cffc82b99385b68fb 3x"}, "body": "こんにちは！またリクエストしたいのKAMINAです、\n前回の作品は本当に素晴らしかったです！\nぜひまた絵を描いていただけると幸いです。\n【キャラクターについて】\n(サイモン) 150cm\n大きなフレームなし丸メガネをかけて、\n虹色ハイライトを放つ水色の目がレンズの下に隠された。\n銀色の髪が数本に黒い毛先を混じっている。\nとても小柄で繊細、色白で柔らかい体付きの男の娘っぽいイメージです。\n知的好奇心いっぱい、読書と知見を得ることが好き、\n常に寝不足のように見え、目の下にクマがあることが多い。\n心が通じるの小さなハリネズミを飼う。\n\nサイモンは魔法使いになるために魔法学校に通っています。\n魔法学校は中世のファンタジーがテーマのお城です。\nくわしいのキャラ参照は下記のURLをご覧ください。\n\n【依頼内容】\n構図等様々に関してお任せ致します、お好きな描いてください！\n細かい設定についてはお好みで調整して構いません。\n依頼内容になにか問題があれば再送要請してください。\n\n【使用用途】\n自分用の壁紙とアイコン、個人用な印刷などの使用、\n他の方への依頼の際に資料として使用させていただくことがあります。\nSNS、ネットで公開する時には、先生を注記してから投稿します。\n\nここまでお読み、私のリクエストを考慮していただければ幸いです、\n本当にありがとうございます。\n\nhttps://ibb.co/album/TYxQQN", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@7_77mg/works/14", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2050826, "client_id": 2044415, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/22b46d0b/uploads/origins/26c64004-93d8-46cb-b2a1-ec063dfc8bf7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=62ce2b64ca5518ea527cf7629add4e68", "srcset": "https://si.imgix.net/22b46d0b/uploads/origins/26c64004-93d8-46cb-b2a1-ec063dfc8bf7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=62ce2b64ca5518ea527cf7629add4e68, https://si.imgix.net/22b46d0b/uploads/origins/26c64004-93d8-46cb-b2a1-ec063dfc8bf7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=3641afb539614739a1440d2bbcec0eec 2x, https://si.imgix.net/22b46d0b/uploads/origins/26c64004-93d8-46cb-b2a1-ec063dfc8bf7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f3138df79f4653ebb97112155a83bf09 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/22b46d0b/uploads/origins/26c64004-93d8-46cb-b2a1-ec063dfc8bf7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6a0066eebb6ebaaa6b488461688a4d3c", "srcset": "https://si.imgix.net/22b46d0b/uploads/origins/26c64004-93d8-46cb-b2a1-ec063dfc8bf7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6a0066eebb6ebaaa6b488461688a4d3c, https://si.imgix.net/22b46d0b/uploads/origins/26c64004-93d8-46cb-b2a1-ec063dfc8bf7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=b66a283c9e7032cef647fa7a750328d6 2x, https://si.imgix.net/22b46d0b/uploads/origins/26c64004-93d8-46cb-b2a1-ec063dfc8bf7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=67d13bd32fe9dbe0039f2af855c67eaa 3x"}, "body": "心錠先生、はじめまして。風羽　翼と申します。\nXで先生の絵柄にとても惹かれました。\n今回イラストを描いていただきたくて依頼しました。\n\n自分のオリジナルキャラクター「風羽翼」と友達「黒曜」一緒にいるのイラストをお願いしたいです。\n風羽翼は、雪国（北海道みたいな感じ）に住む人間の世界に興味を持つ15歳のアカギツネ少年です。学校ではいつも成績優秀な生徒ですが、とてもやんちゃな一面も持っています。左目は水色、右目は紺色です。\n黒曜は、ハンサムでかわいい十代後半のパンダ少年です。 とても賢いけどナイーブでもあります。\n\nニーズについて、可愛いやりとりができればいいなと思います。\n\n具体的な構図とポーズなどはお任せします。\n先生のインスピレーションをすごく楽しみにしています。\n\nご検討のほど、よろしくお願いいたします。\n\n「風羽翼」https://drive.google.com/file/d/1Ds_PB566WRp6narHALLelIkK59IGUXNy/view?usp=drive_link\n「黒曜」https://drive.google.com/file/d/1JLe1dc9seEGhNIe8FferRcWKTtnKn6wC/view?usp=drive_link\n「黒曜２」https://drive.google.com/file/d/1VVo-9s5RQy96Dbshf1VPDUVbInBfsRTw/view?usp=drive_link", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@7_77mg/works/13", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2050826, "client_id": 39172, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/513d83bb/uploads/origins/44b8776c-ec80-498f-a320-a319571bc321?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=aafdc5984e28d12db8429395283501b7", "srcs