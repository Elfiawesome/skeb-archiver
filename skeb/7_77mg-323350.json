n密かに想いを寄せている友人と一緒に過ごしているような感覚で、うちの子を描いてください。自分の本当の気持ちを伝えるように、彼を見てください。見る人は、自分の気持ちを知っていながら、何も変わって欲しくないからとごまかす友人に、胸が痛むような密かな恋心を抱いているのです。\n\nお泊まり会やカジュアルなデートなど、思いついたままにカジュアルな服装に変えてもいい。お好みで彼にチャラチャラしたものを着せてもよいでしょう。彼のビューティマークも忘れずにお願いします。\n\nPSDで送っていただければ、こちらで調整させていただきます。SNS(twitterなど)での自己紹介に使わせていただきます。クレジットを入れさせていただきます。\n\nあなたの作品がとても好きです。またオープンしてくれて嬉しいです。ぜひご検討ください\n\nhttps://kainen.ceo/references", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@7_77mg/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2050826, "client_id": 1331232, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/b6226521/uploads/origins/5a3fa603-bf62-46d9-b8fe-a88506161604?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a605a9d85c6c7866f8e69f3c1f2239b0", "srcset": "https://si.imgix.net/b6226521/uploads/origins/5a3fa603-bf62-46d9-b8fe-a88506161604?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a605a9d85c6c7866f8e69f3c1f2239b0, https://si.imgix.net/b6226521/uploads/origins/5a3fa603-bf62-46d9-b8fe-a88506161604?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=8d7d381b0b2c3fc5bf3f7ccf3c4cf4f6 2x, https://si.imgix.net/b6226521/uploads/origins/5a3fa603-bf62-46d9-b8fe-a88506161604?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=67a055ad8863e839913799c8d6425d72 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/b6226521/uploads/origins/5a3fa603-bf62-46d9-b8fe-a88506161604?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5462b1563647a89a213d4fd4e5d376ff", "srcset": "https://si.imgix.net/b6226521/uploads/origins/5a3fa603-bf62-46d9-b8fe-a88506161604?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5462b1563647a89a213d4fd4e5d376ff, https