auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=619121a9a855e1b4bf0362dcb19ac01b", "srcset": "https://si.imgix.net/f227a18e/uploads/origins/44d0b26c-5793-4a11-8371-9e93fba2884f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=619121a9a855e1b4bf0362dcb19ac01b, https://si.imgix.net/f227a18e/uploads/origins/44d0b26c-5793-4a11-8371-9e93fba2884f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=8a81f095e5a8f111885f7f99fea7d3ce 2x, https://si.imgix.net/f227a18e/uploads/origins/44d0b26c-5793-4a11-8371-9e93fba2884f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=327496f0ddf4a6a8ba8e9d880a436b1b 3x"}, "body": "インパクトのあるイラストに惹かれました！\n良ければ下記内容が受理可能かご検討よろしくお願いします。\n\n●キャラ\n下記URLのウチの子。\nhttps://twitter.com/er114_k/status/1574650269266513920?s=46&t=U5U70r_HujfZ6NfO583czA\n\n●イラスト\n戦車の上に立ち、やや上向きに上がった砲に片足をかけて前を指差し指揮するマリカをお願いします。\n\n●補足\nマリカがパンチラしているイラストでお願いします、色は白。\n戦車は下記URLで色は灰色、ただ描写自体は殆どなくて構いません。\nhttps://pbs.twimg.com/media/ENQX9oOU0AAVAgN?format=jpg&name=large", "nc": 32, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@tikuryu/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 100011, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/6383476c/uploads/origins/1bfa4e09-2f7f-477a-a34c-5f802be1d54a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=86fad338a5d0d70b00edda28fb0b620a", "srcset": "https://si.imgix.net/6383476c/uploads/origins/1bfa4e09-2f7f-477a-a34c-5f802be1d54a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=86fad338a5d0d70b00edda28fb0b620a, https://si.imgix.net/6383476c/uploads/origins/1bfa4e09-2f7f-477a-a34c-5f802be1d54a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=71d1dcc2c66ba187314a444ca4b7383c 2x, https://si.imgix.net/6383476c/uploads/origins/1bfa4e09-2f7f-477a-a34c-5f802be1d54a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d80804f9a7ab7b23e26809f947945928 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/6383476c/uploads/origins/1bfa4e09-2f7f-477a-a34c-5f802be1d54a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3ec475e3f7d166b3fbdf0683a553a31d", "srcset": "https://si.imgix.net/6383476c/uploads/origins/1bfa4e09-2f7f-477a-a34c-5f802be1d54a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3ec475e3f7d166b3fbdf0683a553a31d, https://si.imgix.net/6383476c/uploads/origins/1bfa4e09-2f7f-477a-a34c-5f802be1d54a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=ac4d72cb09289fee21e0067065d782af 2x, https://si.imgix.net/6383476c/uploads/origins/1bfa4e09-2f7f-477a-a34c-5f802be1d54a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=add9b57173772adb9a31b370d838d3cb 3x"}, "body": "先日は最高にかっこいいアデューをありがとうございました！光に照らされる鎧の質感も筋肉感がわかる身体の描き方もピンチ感のある表情もすべてが最高でした…！\nもし可能なら再度同じくパラディンのアデューをリクエストしたいのですが大丈夫でしょうか…？\n\nお願いしたいのは炎を纏った精霊石の剣を勢いよく構えて、必殺技のメテオザッパーを撃とうとしているイメージのイラストです。\nなるべく全身に近い姿(脛の半分くらいまでは切れたり隠れたりしても大丈夫です)をいれてほしいです。\n精霊石の剣は盾と合体したメテオザッパーモードでお願いしたいですが、かなり大きな剣なので構図の邪魔になるようであれば通常時の剣でも大丈夫です(作中では片手剣モードでも撃っているので…)\n\n前回のイラストの躍動感が素晴らしかったので、迫力のある動的なポーズでもOKですし、逆にピシッと構えた静的なポーズでも大丈夫です。\n竹流さまの絵が本当に素晴らしかったのでおまかせします。\n\n可能であれば、前回のイラストのインナー越しの太ももの筋肉が本当にドストライクだったので、脚がしっかり入るアングルにしていただけると嬉しいですが、難しいようでしたら大丈夫です。\n熱くかっこいい雰囲気を最優先してほしいです。\n\nあと、前回お願いしたイラストのように鎧やインナーを破損させて、顔に傷や汗を入れてほしいです。\nめちゃくちゃ男らしくてかっこよかったので……\n\n色々とふわっとしたリクエストで申し訳ありません。\nお時間あれば描いていただけますと嬉しいです。\nどうぞよろしくお願いいたします。\n\nメテオザッパーモードの剣\nhttps://i.imgur.com/ARDEUbq.jpg\n\n参考画像\nhttps://i.imgur.com/KkYeBVZ.jpg\nhttps://i.imgur.com/gfmVtOe.jpg\nhttps://i.imgur.com/GPchrig.jpg\n\n参考ポーズ例(あくまで参考ポーズなので、全然違うポーズでも大丈夫です。)\nhttps://i.imgur.com/GY7AZOv.jpg\nhttps://i.imgur.com/4WwI6jg.jpg", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@tikuryu/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 100011, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/cbd077b7/uploads/origins/2502d7ff-5605-4225-bafb-9792105a4a1f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0006004788ffcd9e363dd5d812b70eab", "srcset": "https://si.imgix.net/cbd077b7/uploads/origins/2502d7ff-5605-4225-bafb-9792105a4a1f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0006004788ffcd9e363dd5d812b70eab, https://si.imgix.net/cbd077b7/uploads/origins/2502d7ff-5605-4225-bafb-9792105a4a1f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=47615d1bb65ece2607a1dae9a7920eca 2x, https://si.imgix.net/cbd077b7/uploads/origins/2502d7ff-5605-4225-bafb-9792105a4a1f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=afb38666850608c35015641e072b5ebc 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/cbd077b7/uploads/origins/2502d7ff-5605-4225-bafb-9792105a4a1f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=10ef44e56d61e5532128fde26a8f09b8", "srcset": "https://si.imgix.net/cbd077b7/uploads/origins/2502d7ff-5605-4225-bafb-9792105a4a1f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=10ef44e56d61e5532128fde26a8f09b8, https://si.imgix.net/cbd077b7/uploads/origins/2502d7ff-5605-4225-bafb-9792105a4a1f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=41058c6c39bcb46b5c09471d168061f0 2x, https://si.imgix.net/cbd077b7/uploads/origins/2502d7ff-5605-4225-bafb-9792105a4a1f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blu