=crop&crop=top&w=200&h=200&blur=200&s=f0f07a27c3e0c4463bde50cd3caf0b17, https://si.imgix.net/4094f42b/uploads/origins/f80f02c7-66db-424c-8499-701a84ac4afd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=3371bcfd589c66de15e8f66ac2a9f633 2x, https://si.imgix.net/4094f42b/uploads/origins/f80f02c7-66db-424c-8499-701a84ac4afd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=313ea73dbd25dfa2be2d05def9be41c9 3x"}, "body": "こんにちは、鹿山様！あなたの絵のスタイルが本当に大好きです！あなたの絵はまるでカラフルな漫画のようで、物語性が溢れています。私のオリジナルキャラクターを描いていただけないでしょうか？\n\n[兄]\n22歳、181cm。スタートアップ事業を営む大学生。\n計算高く、決断力がある。スイーツ中毒。\n弟の「後見人」であり、愛情のほとんどすべてを弟に注いでいる。\n注：左利き。\n\n[弟]\n16歳の学生、身長181cm。楽観的で、元気いっぱい、そして優しい。人の世話をするのが得意。\n兄の支えになりたいと思っている。しかし、兄から指導を受けると、時々照れてしまう。\n\n二人の日常を描いていただけると嬉しいです。例えば、兄が弟にネクタイの結び方を教えたり、弟が朝食を作ったりするシーンなど。\n特に指定がない場合は、自由に描いてください！\nお読みいただきありがとうございます！もしこのリクエストをお引き受けいただけたら、大変光栄です。\n\nhttps://drive.google.com/drive/folders/1VAa0rwXs__l5_xYg3PgR6sivlC-h_C-6?usp=sharing", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@triple_bambi/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3086993, "client_id": 505129, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/fdeb2984/uploads/origins/3e528465-31d5-442b-9805-e5d3cc0d89d8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f95cf9298479e3488326f99a2b31b0bd", "srcset": "https://si.imgix.net/fdeb2984/uploads/origins/3e528465-31d5-442b-9805-e5d3cc0d89d8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f95cf9298479e3488326f99a2b31b0bd, https://si.imgix.net/fdeb2984/uploads/origins/3e528465-31d5-442b-9805-e5d3cc0d89d8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=0f24213f7fc7f3f68bbb3ecde9872ef8 2x, https://si.imgix.net/fdeb2984/uploads/origins/3e528465-31d5-442b-9805-e5d3cc0d89d8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=322dda17dc1e291c27fbd744c098bcf4 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/fdeb2984/uploads/origins/3e528465-31d5-442b-9805-e5d3cc0d89d8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=7342e8fb5ab0d3abbcc2be05fc3dbd54", "srcset": "https://si.imgix.net/fdeb2984/uploads/origins/3e528465-31d5-442b-9805-e5d3cc0d89d8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=7342e8fb5ab0d3abbcc2be05fc3dbd54, https://si.imgix.net/fdeb2984/uploads/origins/3e528465-31d5-442b-9805-e5d3cc0d89d8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=eed9a257dc60f60bcb5da0f38167befa 2x, https://si.imgix.net/fdeb2984/uploads/origins/3e528465-31d5-442b-9805-e5d3cc0d89d8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=b0d38e324e6c26284fb1d98015da274b 3x"}, "body": "鹿山先生、こんにちは。\n以前ご制作いただいたイラスト、本当にありがとうございました！とても気に入っております。\n\n今回もぜひ、○○ちゃん、□□□くん、そして□□□くんの愛犬・たまごやきのイラストをお願いできればと思い、ご連絡いたしました。\n\nシチュエーションは、浴室で二人がたまごやきを洗っている場面です。たまごやきが体をぶるぶるっと振った勢いで水しぶきが飛び散り、二人の制服が濡れてしまいます。そこで、○○ちゃんのインナーがうっすら透けてしまい、それに気づいた□□□くんが思わず顔を真っ赤にしてしまう――そんな、少しドキッとするようなラッキースケベな雰囲気をイメージしています。\n\n全体的には、賑やかで微笑ましさの中にほんのりとしたときめきが感じられるような仕上がりだと嬉しいです。構図や細かい表現については、先生のご解釈にお任せいたします。\n\nお忙しいところ恐れ入りますが、ご検討いただけますと幸いです。どうぞよろしくお願いいたします！\n\nhttps://drive.google.com/drive/folders/1XOys4xlojFUxM2ulvGUH6xHPEd0j7rMD?usp=sharing", "nc": 32, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@triple_bambi/works/6", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/78312781/uploads/origins/c5cec86d-f5ab-4311-ac54-7f494a97cf2c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=78221b480f97a84a7fe498715