4-b128-3557af602ed7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=d99a232bb8926c3b2ea60a1fabc698d2 2x, https://si.imgix.net/b21debe2/uploads/origins/b631ee24-ee00-40e4-b128-3557af602ed7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=7a6c472e3a09e5b8a019dbf1f9188da5 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/b21debe2/uploads/origins/b631ee24-ee00-40e4-b128-3557af602ed7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=1a4aaa1850d45662dad5358d593efa81", "srcset": "https://si.imgix.net/b21debe2/uploads/origins/b631ee24-ee00-40e4-b128-3557af602ed7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=1a4aaa1850d45662dad5358d593efa81, https://si.imgix.net/b21debe2/uploads/origins/b631ee24-ee00-40e4-b128-3557af602ed7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=698f9f7806bacac7a075510f06df07be 2x, https://si.imgix.net/b21debe2/uploads/origins/b631ee24-ee00-40e4-b128-3557af602ed7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=0a85d68687bc1f043af62dfc65c82077 3x"}, "body": "こんにちは！\nナディーヌ様の小さな子達がとても素敵でしたので依頼させていただきます！\n\n東方Projectの橙が、後ろから突かれて出され、悦んでる顔になっている描写をお願いしたいです！\n\n可能なら叶えて欲しい程度の要望として\n・局部が覆われない程度に着衣(胸や局部はズラして揉みや挿入な感じ)\n・受精描写付き\nを要望させて頂きますが、ナディーヌ様判断でアレンジや、描きやすい程度に脱衣や描写を省いてる頂いて大丈夫です。\n\n上に挙げた事以外の、体位や体格等といった細部はナディーヌ様にお任せいたします。", "nc": 41, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@nemonadine/works/12", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1034313, "client_id": 437702, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/cc79be9a/uploads/origins/ec27829d-a0e2-4ae0-a8ad-03a03adb07a0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3299f4d