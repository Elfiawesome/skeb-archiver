を描いていただけないでしょうか。\n\nポーズや表情等は指定ありませんが、3人とも以前描いていただいたミニ氾月と同じ絵柄で描いていただけると嬉しいです…！\n\n- 資料\n〈都市伝説課〉\nhttps://drive.google.com/drive/folders/1n8vj4xpHNHuBou2vWySMHB0dYdugjAv9\n\n〈探索者 - 氾月桐絵〉\nhttps://drive.google.com/file/d/12CkobWBwXHXW_BViUpyJ5TSnyOlmncRT/view?usp=drivesdk\n\n- 用途\nTwitterでの共有、自陣への共有、アクスタ化（個人用ですが、大丈夫であれば都市伝説課の方を自陣にのみお渡ししたいと思っています🙇‍♂️）\n\nまだ勝手が分かっていない部分もあるため、何かしら修正点や不足、問題があれば再送依頼、拒否等していただいて構いません。よろしくお願いいたします。", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Andou_Honpo/works/103", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2875278, "client_id": 1467356, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/0bb31477/uploads/origins/cea905ae-3f84-4c30-893b-37c8be4e8715?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=932af010549aa57e4caf29b949ad2f8f", "srcset": "https://si.imgix.net/0bb31477/uploads/origins/cea905ae-3f84-4c30-893b-37c8be4e8715?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=932af010549aa57e4caf29b949ad2f8f, https://si.imgix.net/0bb31477/uploads/origins/cea905ae-3f84-4c30-893b-37c8be4e8715?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=822f4a224017fdfd1c90c37b43f4a554 2x, https://si.imgix.net/0bb31477/uploads/origins/cea905ae-3f84-4c30-893b-37c8be4e8715?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f2cdf368c596d887795bc29d70187c5b 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/0bb31477/uploads/origins/cea905ae-3f84-4c30-893b-37c8be4e8715?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=bd61fa8695a065535d0e3444cd1bc001", "srcset": "https://si.imgix.net/0bb31477/uploads/origins/cea905ae-3f84-4c30-893b-37c8be4e8715?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=