9-825c-23eb022d28ad?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=4f5f646c0678b8cd625ec0b496756b0f", "srcset": "https://si.imgix.net/aa52f6e0/uploads/origins/c67a74ba-eece-4f89-825c-23eb022d28ad?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=4f5f646c0678b8cd625ec0b496756b0f, https://si.imgix.net/aa52f6e0/uploads/origins/c67a74ba-eece-4f89-825c-23eb022d28ad?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=b82e1f5645de9741d2aaa748d4087b41 2x, https://si.imgix.net/aa52f6e0/uploads/origins/c67a74ba-eece-4f89-825c-23eb022d28ad?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=b908560504cc99db8844907e23e79a9b 3x"}, "body": "せんり様こんにちは。\n自創作二人のイラストを描いて頂きたくリクエストを送らせていただきました。\n※BL要素があるため苦手な場合はこのまま読まずにキャンセルしてください。\n\n\n【二人の関係】\n魔法使いと魔族(魔王の子)。\n師匠と師弟で育ての親と子のような関係。\n\n【キャラクター】\n★魔法使い★\n◾︎名前:セリオ・ラディアス\n◾︎種族:人間\n◾︎性別:男\n◾︎年齢:120くらい(容姿は20代で止まっている)\n◾︎身長:178\n◾︎概要\n穏やかで大人びた雰囲気の不老不死の呪いをかけられた天才魔法使い。\n解呪方法を探しつつ森の奥深くの小屋でまったり暮らしている。\n長命ゆえに達観しており、飄々とした性格。\n基本的には気まぐれで自由奔放だが、魔王に対しては保護者のような姿勢を見せている。\n私生活は意外とだらしなく現在は世話を焼かれている側かもしれない…\nダルヴァンの気持ちに気づきつつも上手くかわしている。\n\n\n★魔王(魔王の子)★\n◾︎名前:ダルヴァン・ノクタリア\n◾︎種族:魔族\n◾︎性別:男\n◾︎年前:60くらい(長命種)\n◾︎身長:188\n◾︎概要\n魔族の生き残り(魔王の子)\n幼少期セリオに拾われ、魔力制御や魔法を教わりつつセリオのもとで暮らす。\n魔族の血を引いているため潜在的な力は非常に強い。成長とともに欲望や魔力の制御が難しくなっている。基本大人しめで聞き分けがいい。\nセリオに片想いしている。\n\n【その他】\n■どの姿でも大丈夫です。(時系列)\n■衣装デザインがまだ決まっていないため自由に描いていただけると嬉しいです。\n\n【使用用途】\n▪️個人鑑賞\n\n\n最後までお読みいただきありがとうございました。金額や内容に問題がありましたら再送要請をお願い致します。\nお手数おかけしますがご検討のほど、よろしくお願いします。\n\nhttps://drive.google.com/drive/folders/169c_DP6rxl3ZRVEZ9h-qNxI3QFyFzKYQ", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@senri_tori/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2430626, "client_id": 3587185, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/45f5042d/uploads/origins/46b75dff-28da-4ac5-a349-6aa372981ff0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3669b122435e8f874bea9c48374b475f", "srcset": "https://si.imgix.net/45f5042d/uploads/origins/46b75dff-28da-4ac5-a349-6aa372981ff0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3669b122435e8f874bea9c48374b475f, https://si.imgix.net/45f5042d/uploads/origins/46b75dff-28da-4ac5-a349-6aa372981ff0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=4cf8e438c25bb1006b169c0b4d850c8b 2x, https://si.imgix.net/45f5042d/uploads/origins/46b75dff-28da-4ac5-a349-6aa372981ff0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=bf057665c6cd64bcfeb304d9f9f137a8 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/45f5042d/uploads/origins/46b75dff-28da-4ac5-a349-6aa372981ff0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=8b2bf27b11cceda56cd6df12ca8b3007", "srcset": "https://si.imgix.net/45f5042d/uploads/origins/46b75dff-28da-4ac5-a349-6aa372981ff0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=8b2bf27b11cceda56cd6df12ca8b3007, https://si.imgix.net/45f5042d/uploads/origins/46b75dff-28da-4ac5-a349-6aa372981ff0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=e27c92d5046498441e901f085c50acf4 2x, https://si.imgix.net/45f5042d/uploads/origins/46b75dff-28da-4ac5-a349-6aa372981ff0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=9080fa0ff991e067ed89fbd941236607 3x"}, "body": "こんにちは！あなたの作品が大好きで、私のOCであるツクヨミの絵をお願いしたいです。\n\n彼女は背が高く、浅黒い肌をした戦士の女性で、長い黒髪とエルフのような耳を持ち、強くも静かな美貌の持ち主です。\n\n主な特徴：異色症（左目が青、右目が茶）、左目の傷、唇の下の小さなほくろ、金のフープイヤリング。どうか、これらのディテールを忘れないでください。\n\n普段は冷静で威厳があるが、戦いになると血の渇きと悲しみの恍惚状態に陥ることがある。彼女の強さと痛みの両方が重要なのです。彼女は悲劇的で、力強く、魅惑的です。\n\nあなたの解釈で自由に描いてください。\n彼女の鎧姿も見てみたいし、あなたの創作した衣装を入