さに圧倒され現在ではKPとしてハンドスピナーをするほどこのシナリオが大好きです！！\n\nなので今回はVOYAGER be COMETEOSのシナリオを通過したPCのイラストをお願いしたいです。\n\n基本ですます口調で無表情がデフォルトの低身長(141㎝)の少年ですが、予測の出来ない事態に対しても基本平静でクールな対応をとる性格をしています。\n地球を外側から見られる機会には少しテンションが上がり目を爛爛とさせていた事もあり、好奇心は旺盛です。\n以下実際のログから台詞だけを抽出したふせを乗せますので性格の参考までに\nhttps://fusetter.com/tw/xmWyea1e\n\n\n構図については特に指定をしないので、コメテオスの空気を感じられるものであれば大変うれしいです。\nご縁を頂けましたら何卒宜しくお願い致します。\n\nhttps://drive.google.com/file/d/1Nsp9Eqlz8Rjle1Kj5iGIlHjjCI1UikQv/view?usp=drive_link", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@sachiwo33/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3322228, "client_id": 2778529, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/eca3a202/uploads/origins/ade4ddb2-4e27-4f52-9d65-10d19663c9d2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=13a74f9be2e68ec5f2c8c7668794c2b6", "srcset": "https://si.imgix.net/eca3a202/uploads/origins/ade4ddb2-4e27-4f52-9d65-10d19663c9d2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=13a74f9be2e68ec5f2c8c7668794c2b6, https://si.imgix.net/eca3a202/uploads/origins/ade4ddb2-4e27-4f52-9d65-10d19663c9d2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ff15d8667b0e01faca408571a57bbaed 2x, https://si.imgix.net/eca3a202/uploads/origins/ade4ddb2-4e27-4f52-9d65-10d19663c9d2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=11ca68680a723481f81fccaec6c4969c 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/eca3a202/uploads/origins/ade4ddb2-4e27-4f52-9d65-10d19663c9d2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9426d3af8a68630edde9cc8e9f1bb0ff", "srcset": "https://si.imgix.net/eca3a202/uploads/origins/ade4ddb2-4e27-4f52-9d65-10d19663c9d2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=cro