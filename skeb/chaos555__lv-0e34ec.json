文章コピーになります。\n依頼をする際には、このページへのリンクまたはFANBOXのリンクを共有したのち蓮希るいのTwitterや収益化されたYoutubeチャンネルで使用される可能性があること」を依頼文で必ず伝えてください。\n\n▼skebまたは依頼したイラスト\npsdファイル/背景透過ファイルがあると嬉しいです。\nイラストレーター様に依頼していただいたイラストは活動面（サムネイル）で使用できるのでとても嬉しいです！\n\nイラストレーター様にご依頼の際は、二次創作プログラム承認済みですので「蓮希るい」の名前を使用して許可済みだということをお伝えください。\n\n長くなってしまいましたがぜひご検討のほどよろしくお願い致します！\n\nhttps://lit.link/Hasukirui", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@chaos555__lv/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3993885, "client_id": 377196, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/905b73f3/uploads/origins/b93f9a2a-8c10-48ef-ad64-98c42c64741e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8139650f05b3dc7a6b0217a40a51208e", "srcset": "https://si.imgix.net/905b73f3/uploads/origins/b93f9a2a-8c10-48ef-ad64-98c42c64741e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8139650f05b3dc7a6b0217a40a51208e, https://si.imgix.net/905b73f3/uploads/origins/b93f9a2a-8c10-48ef-ad64-98c42c64741e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=96f7a1a668e3e0d27dfebc1a62583828 2x, https://si.imgix.net/905b73f3/uploads/origins/b93f9a2a-8c10-48ef-ad64-98c42c64741e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=df83ae9aab1dbb033fb1d605f5b8853e 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/905b73f3/uploads/origins/b93f9a2a-8c10-48ef-ad64-98c42c64741e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=aa4ecbaf2445919ccc2235efc97cbe15", "srcset": "https://si.imgix.net/905b73f3/uploads/origins/b93f9a2a-8c10-48ef-ad64-98c42c64741e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=aa4ecbaf2445919ccc2235efc97cbe15, https://si.imgix.net/905b73f3/uploads/orig