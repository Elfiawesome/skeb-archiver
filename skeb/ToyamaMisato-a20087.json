真似、ボーッとすること\n\n【使用用途】\n ・YouTubeのサムネイルや動画への使用 \n・各種SNSの投稿への使用   \n・エンディング画面に使わせていただく可能性\n\n条件等難しそうであれば、お手数ですが遠慮なくお戻し下さい。\n\nご検討いただけますと幸いです。\nよろしくお願いします。\n\nhttps://drive.google.com/drive/folders/1-HRkl0SXdqMY7_rmWAhCvil8T15KoTBG?usp=sharing", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@ToyamaMisato/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3785880, "client_id": 3754827, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/52c33f67/uploads/origins/3f8c7394-4cb1-4769-a2f7-52c216a348bf?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=54881cd55c639f90a8bf04a1c9a8bdcd", "srcset": "https://si.imgix.net/52c33f67/uploads/origins/3f8c7394-4cb1-4769-a2f7-52c216a348bf?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=54881cd55c639f90a8bf04a1c9a8bdcd, https://si.imgix.net/52c33f67/uploads/origins/3f8c7394-4cb1-4769-a2f7-52c216a348bf?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=438695a9ab3025af6aa221672b4b22a2 2x, https://si.imgix.net/52c33f67/uploads/origins/3f8c7394-4cb1-4769-a2f7-52c216a348bf?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=080d4e1a07531a0f1cbf350552f52f97 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/52c33f67/uploads/origins/3f8c7394-4cb1-4769-a2f7-52c216a348bf?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=41fe9a301deadeec5ab575c0889f7151", "srcset": "https://si.imgix.net/52c33f67/uploads/origins/3f8c7394-4cb1-4769-a2f7-52c216a348bf?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=41fe9a301deadeec5ab575c0889f7151, https://si.imgix.net/52c33f67/uploads/origins/3f8c7394-4cb1-4769-a2f7-52c216a348bf?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200