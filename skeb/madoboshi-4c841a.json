で楽しんでいます。\n水着のデザインはお任せします。\n\n使用目的は個人観賞、SNSへの表示です。ご検討よろしくお願いします。", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@madoboshi/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "voice", "tipped": true, "creator_id": 862593, "client_id": 1418065, "vtt_url": "https://fcdn.skeb.jp/uploads/outputs/f53e6024-ada9-4ec2-8219-c2e8c221d109?response-content-disposition=inline&Expires=1783062292&Signature=bmQ36f7SQKWN6vO0dsjRBtIYsA9rLA8HZLe7py4i1Q-6AV5z0FaCiOFCtXlNznHxW~DlXOlrt1BJeenyWtjKPMUeK-iDG1382EFMixdJYmKF~dqi~O2nHN1dy5omMdAboHZu~bhj4pMtQYzT-X2GcmcwIKXy~XhgJRVLfiq1Yue40e0OtMbLBeqUqJ8J1BY1TnZCr7Wc3DiApHgWEAnw3leybPTtkxMQ~CF9X5Zes0zPd9lVQBrZ56Ps~zEfVOGIZRQP~i0D7lQJujr~afzp2i-VJcBcTOYtBGWaM~Lg91t2kudvOpx5ejUHM8FXyQZi5KiOuRJLLb9rTs3txz3ilQ__&Key-Pair-Id=K1GS3H53SEO647", "thumbnail_image_urls": {"src": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1758409306146508800%2FPs_g_g2l.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f5d79a368dd0248ec47dcb943022c4c9", "srcset": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1758409306146508800%2FPs_g_g2l.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f5d79a368dd0248ec47dcb943022c4c9, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1758409306146508800%2FPs_g_g2l.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=4be651d70290ae4b3323193db23e80b5 2x, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1758409306146508800%2FPs_g_g2l.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f6aaafe8fd0b341615529f7af396f720 3x"}, "preview_url": "https://fcdn.skeb.jp/uploads/outputs/89d072c0-27c0-4c36-a647-566e18f5bbdb?response-content-disposition=inline&Expires=1783062292&Signature=mL-EVy~YvIQ~RlDPueF6WJPEESWnL6G~LGRTnzeLrDdqr5fmX9Kewy