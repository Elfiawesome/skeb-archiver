c11f9f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=20facf3bfa8fe7e579cd6f985df990d7, https://si.imgix.net/e1feb6fa/uploads/origins/b5a56c51-ccda-4139-a1e1-1702b8c11f9f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=a30edd456042d3cf5096d92053e79006 2x, https://si.imgix.net/e1feb6fa/uploads/origins/b5a56c51-ccda-4139-a1e1-1702b8c11f9f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=ef02868ff00f6019b08477f604c8c670 3x"}, "body": "お世話になっております。ミカのエッチ本や、商業誌のTS触手マンガでお世話になりました。（触手マンガ、一瞬で負けるさまがとても素晴らしかったです）\nこの度は私の依頼を受けていただきたく思い、依頼させていただきました。\n\n○キャラ\n私の精神擬人化［八香須 織戸音（はちかすおとね）］をお願いします。\n性格として\n[いい根性をしている・ちょっとクズ・雑魚]です。\n\n○構図・シチュなど\nマンガ依頼となります、以下のようなものが可能であればお願い致します。\n・ハメ撮りシチュ\n・半脱ぎ\n・流れとして、\n竿「お金欲しいなら、やることやらないとね」（半脱ぎ指示）\n織（我慢…我慢…♥）と、期待しているところからスタートしてください。\n合間合間はお任せ致しますが、以下のシチュはお願い致します。\n・挿入している姿をカメラによく見えるような、見せつけ構図な感じで激しく突かれている。（体位や構図はお任せ致します）\n・マゾなので言葉責めされると謝りながら喜びます。\n・マゾなのでちょろく、簡単にチン負けします。\n・絶頂を迎える。\n\nざっくりとこのような流れでお願いします。\n効果音や嬌声は激しめにお願いします。\n※セリフは関西弁が好ましいのですが、難しければ敬語っぽくしてくださればと思います。\n\n以上をお願い致します。\n\n※エロ妄想している体です。\nページ数はお任せいたします。コストに見合わないと判断されたら再送をいただけますと幸いです。\n\n〇用途\n使います。\n\n以上、宜しくお願い致します。\n\nhttps://imgur.com/a/gBSp4HV", "nc": 160, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Tsukushi_Haru_/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 177744, "client_id": 442252, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/86b98861/requests/109979_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=81c21c6abd978254909ad7e5f40a0216", "srcset": "https://si.imgix.net/86b98861/requests/109979_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=81c21c6abd978254909ad7e5f40a0216, https://si.imgix.net/86b98861/requests/109979_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top