こんばんは！ もう1回会いました！\nこのキャラクター（B.Cat）\nサワー系の服を着て、みんなにかっこよく挨拶したいです。\n内容まみれさんにお任せします！\nもう一度、よろしくお願いします！\n\nB.Cat:\nhttps://i.imgur.com/KSzuK1g.png\nhttps://i.imgur.com/u43Q9yC.jpg\nサワー:\nhttps://i.imgur.com/dwEpY97.jpg\nhttps://i.imgur.com/8uTfa7V.png", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@ekcdayo/works/16", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 362185, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/9ebdecf8/uploads/origins/f9e84e03-a179-43b9-b2ad-f34ab971d927?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ad12be45e7f887ade3f90c39ddccc101", "srcset": "https://si.imgix.net/9ebdecf8/uploads/origins/f9e84e03-a179-43b9-b2ad-f34ab971d927?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ad12be45e7f887ade3f90c39ddccc101, https://si.imgix.net/9ebdecf8/uploads/origins/f9e84e03-a179-43b9-b2ad-f34ab971d927?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c8ebd91b37ea069e35bd370dd41c6881 2x, https://si.imgix.net/9ebdecf8/uploads/origins/f9e84e03-a179-43b9-b2ad-f34ab971d927?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=fd54c0a2095fa3a2324edf510f6c303b 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/9ebdecf8/uploads/origins/f9e84e03-a179-43b9-b2ad-f34ab971d927?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=854dbcf2cff55ce0c0d0191c5ab65c5b", "srcset": "https://si.imgix.net/9ebdecf8/uploads/origins/f9e84e03-a179-43b9-b2ad-f34ab971d927?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=854dbcf2cff55ce0c0d0191c5ab65c5b, https://si.imgix.net/9ebdecf8/uploads/origins/f9e84e03-a179-43b9-b2ad-f34ab971d927?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=aa9d3f05ebc0a5c9c7c0b735fe8e9513 2x, https://si.imgix.net/9ebdecf8/uploads/origins/f9e84e03-a179-43b9-b2ad-f34ab971d927?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=3657bc41abf51ebbf548a79a252c83de 3x"}, "body": "こんにちは！\n\nバトルで重傷を負ったエースバーンと、そのエースバーンに絶望して膝をついているポケモンのザングスの全身イラストをお願いします。両キャラクターに傷をつけてください。\n表情や構図は左上と左下の画像を参考にしてください。エースバーン\n は口と目を少し開けて、ほとんど意識していないはずです。右上と右下の画像は、地面に膝をついて苦しそうな表情のザングースが参考になります。\n\nhttps://postimg.cc/SnWh12dM\n\n背景は何でもよい。\n\nありがとうございました！", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@ekcdayo/works/15", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 362185, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/d14fc661/uploads/origins/724c26a2-2408-4702-82ec-4b8bda1d838e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=385d62c42b6e98928a007d86a595015a", "srcset": "https://si.imgix.net/d14fc661/uploads/origins/724c26a2-2408-4702-82ec-4b8bda1d838e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=385d62c42b6e98928a007d86a595015a, https://si.imgix.net/d14fc661/uploads/origins/724c26a2-2408-4702-82ec-4b8bda1d838e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=0971d658063efde9f8acfd899eef7539 2x, https://si.imgix.net/d14fc661/uploads/origins/724c26a2-2408-4702-82ec-4b8bda1d838e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=4fb56bccd4dc3f712a64b5a6fb0cb17e 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/d14fc661/uploads/origins/724c26a2-2408-4702-82ec-4b8bda1d838e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=4fee76e4bd82661ea2ac557407e17892", "srcset": "https://si.imgix.net/d14fc661/uploads/origins/724c26a2-2408-4702-82ec-4b8bda1d838e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=4fee76e4bd82661ea2ac557407e17892, https://si.imgix.net/d14fc661/uploads/origins/724c26a2-2408-4702-82ec-4b8bda1d838e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=7231596e933d623c69961bdb750ad978 2x, https://si.imgix.net/d14fc661/uploads/origins/724c26a2-2408-4702-82ec-4b8bda1d838e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=c6e286c17d6676dde44135a6100282e7 3x"}, "body": "こんにちは！\nノイバーンからの攻撃をかわしながら地上にいるシンデレースの全身写真をお願いします。シンデレースは宇宙服のホロウェアを着てショックを受けているような表情で、ノイバーンの爪は力で地面を割っているような感じでお願いします。\n以下は、シンデレースとノイバーンの爪のポーズの参考例。シンデレースが攻撃をかわしているところを上から見たアングルで描いてほしい。\nシンデレースの脚を見せ、腰も参考と同じように見せてください。\nできれば傷もつけてください。\n\nhttps://postimg.cc/ppQBJwWg\n\nありがとうございました！", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@ekcdayo/works/14", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 362185, "client_id": 1855132, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/6e6bb005/uploads/origins/41c53ebf-4d41-4be4-96c7-0cb211a4c022?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b205bc29767df0c2aaef34fe917e687f", "srcset": "https://si.imgix.net/6e6bb005/uploads/origins/41c53ebf-4d41-4be4-96c7-0cb211a4c022?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b205bc29767df0c2aaef34fe917e687f, https://si.imgix.net/6e6bb005/uploads/origins/41c53ebf-4d41-4be4-96c7-0cb211a4c022?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=eba1af4ed54b2d6697ac5cbe193ccb34 2x, https://si.imgix.net/6e6bb005/uploads/origins/41c53ebf-4d41-4be4-96c7-0cb211a4c022?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b5124e44b2617715612dfaac08dce351 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si