&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=0fbbc5c3f2f129d76434ccef87b1603e 3x"}, "body": "無精髭に長髪の喫煙者30代男性\n鎖骨\n流し目で泣きぼくろがあるとぐー\n「あー、あの祠壊しちゃったの？それじゃもうダメだね。君、たぶん死ぬ」の台詞をいれりゅ\n\nその男性を見つめ鎖骨と一言呟くぽに妖精\n\n後は任せた", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@kouyanotouhu/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2429000, "client_id": 154780, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/9c068bee/uploads/origins/dd47e076-9eb2-4b17-885a-da1335795854?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=dbfa4216b66d397f9373ad2c9be15c34", "srcset": "https://si.imgix.net/9c068bee/uploads/origins/dd47e076-9eb2-4b17-885a-da1335795854?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=dbfa4216b66d397f9373ad2c9be15c34, https://si.imgix.net/9c068bee/uploads/origins/dd47e076-9eb2-4b17-885a-da1335795854?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=6209fb96aa9c643d9a97652e7af1ba99 2x, https://si.imgix.net/9c068bee/uploads/origins/dd47e076-9eb2-4b17-885a-da1335795854?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b872dfffe3d2a5030cd9bc80dbf16c33 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/9c068bee/uploads/origins/dd47e076-9eb2-4b17-885a-da1335795854?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3f433cddf4f804d3b030c1d78b9b3683", "srcset": "https://si.imgix.net/9c068bee/uploads/origins/dd47e076-9eb2-4b17-885a-da1335795854?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3f433cddf4f804d3b030c1d78b9b3683, https://si.imgix.net/9c068bee/uploads/origins/dd47e076-9eb2-4b17-885a-da1335795854?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=b72a9e3083832032efc71edad86cc7d1 2x, https://si.imgix.net/9c068bee/uploads/origins/dd47e076-9eb2-4b17-885a-da1335795854?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=d0f1102d19a4b6046adec29e6b899415 3x"}, "body": "今skeb大丈夫そうぽに？\n前回のskebで女子も素晴らしいと思ったのと、昔の衣装をアレンジして欲しいと思ったのでもしお願いできたらと思ったぽにっ\n一枚絵+設定ラフで\n\nまず一番したに薄い肌が透けて見える灰色のノースリーブ、ハイレグのインナーを着ています\n\nその上に下記のレオタード画像のレオタードのみを着ています\n\nそしてその上にベースの衣装の胸部のインナー以外を着せます\n絵面ではレオタードは胸部のみ見えています\n胸の先端は前回ぐらい浮いてます\nスカートはコンセプト参考のように赤いスカートを少し短くして白いヒラヒラなのを増やします\n\n\n腕の赤い部分は肘を隠す程度に短くしてその下に黒いロングの手袋をつけさらに白い手袋をつけています\n\n腰には背面に前回のskebと同じ黒い大きなリボン、ベルトとポーチ、2対の剣を追加します\nさらにロングスカート左右にカウベル付きの白いカウベルをつけます\n\nブーツは金の模様を履き口辺りにちょっと足して欲しいかもで\n\n全般的にひらひら感をました感にアレンジして欲しいです\n\n\n一枚絵\n上記の衣装で右手に画像の両手剣を画面左下にフラットに持ち、左足を一歩前にだし左手のひらを上に向けて差し出すようにして少し口を開いた笑顔を浮かべています\n\nラフ\n以前の依頼のような灰色のべたではなく線画のフラットな立ちポーズのぽにてに服に単色乗せた物みたいのは可能でしょうか\nぽにて本体はコピペで\n\n1、薄い灰色のインナーと胸元のカウベル付きリボン\n\n2、上記にレオタードを着せたもの\n\n3、ロングスカートとカウベル付き白いリボン以外\"ない\"状態の物\n\n4、今回の詳細のもの全て\n\n5、4の背面\n\n作業量多めぽにが是非力を貸して欲しいのでお願いいたします（ふかぶか\n\n参照画像ぽにてとベースの衣装\nhttps://twitter.com/arsisuponite/status/1570932840501760001?t=VNBpC9gO1nYuM_hOCzZU1A&s=19\nレオタード\nhttps://twitter.com/arsisuponite/status/1764206541459337412?t=Xj2ccsIxtQfhqavDxG8MqA&s=19", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@kouyanotouhu/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2429000, "client_id": 154780, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/b4782968/uploads/origins/27ef5686-caa7-4949-9f50-b78a6ae0165d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ea8d4ca6b6bc9bdf4d6a0d1df50db676", "srcset": "https://si.imgix.net/b4782968/uploads/origins/27ef5686-caa7-4949-9f50-b78a6ae0165d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ea8d4ca6b6bc9bdf4d6a0d1df50db676, https://si.imgix.net/b4782968/uploads/origins/27ef5686-caa7-4949-9f50-b78a6ae0165d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=0fe6638acc1214c16f62a0a4055c3ef9 2x, https://si.imgix.net/b4782968/uploads/origins/27ef5686-caa7-4949-9f50-b78a6ae0165d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b6edc3c644291a8a14e356d76d251331 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/b4782968/uploads/origins/27ef5686-caa7-4949-9f50-b78a6ae0165d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=bebc34a726d73089e6bc104af63b7480", "srcset": "https://si.imgix.net/b4782968/uploads/origins/27ef5686-caa7-4949-9f50-b78a6ae0165d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=bebc34a726d73089e6bc104af63b7480, https://si.imgix.net/b4782968/uploads/origins/27ef5686-caa7-4949-9f50-b78a6ae0165d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=80e02eb20190a9405dd7f79a7d56bf7f 2x, https://si.imgix.net/b4782968/uploads/origins/27ef5686-caa7-4949-9f50-b78a6ae0165d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=a2c20c57f90fc96c890c25878ad58a1a 3x"}, "body": "続け様でお願いします☆\n前回の依頼の服と武具を身に着けた水色ぽにての姿を見てみたいのでお願いします\n\n右半身を半歩位前に出して片手剣を構えてるポーズでお願いします\nポーズのイメージ参照\nhttps://twitter.com/arsisuponite/status/1686370143960784896?t=KNnVYLo66I9ENaLGB4yIxQ&s=19\n表情は真剣に正面の敵を見据えている表情でお願いします\nポーズの関係上左手の盾は裏右側が少し映るぐらいになると思います、左手は自然体に降ろしていて盾を握る手は力がこもってる感じで\n胸の先端は許容範囲で浮かせてください\nポーチを見せるために上記を参照にした場合右手をもう少し開く感じて\n左腰の短剣と剣の鞘が映る感じで\nではよろしくお願いします", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@kouyanotouhu/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2429000, "client_id": 154780, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/f73e2bfd/uploads/origins/8bab57a9-f347-45cb-8c4c-0d8220fb0257?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1487054301b35fcf3c4c06e12cda3f10", "srcset": "https://si.imgix.net/f73e2bfd/uploads/origins/8bab57a9-f347-45cb-8c4c-0d8220fb0257?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1487054301b35fcf3c4c06e12cda3f10, https://si.imgix.net/f73e2bfd/uploads/origins/8bab57a9-f347-45cb-8c4c-0d8220fb0257?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=faa84481aa7f2e2ef83bc032b1397beb 2x, https://si.imgix.net/f73e2bfd/uploads/origins/8bab57a9-f347-45cb-8c4c-0d8220fb0257?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=3214b4e900259bbc82ece2b9842f9c38 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/f73e2bfd/uploads/origins/8bab57a9-f347-45cb-8c4c-0d8220fb0257?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=cbb4d64ec2f44df7ba32d78c0444dc74", "srcset": "https://si.imgix.net/f73e2bfd/uploads/origins/8bab57a9-f347-45cb-8c4c-0d8220fb0257?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=cbb4d64ec2f44df7ba32d78c0444dc74, https://si.imgix.net/f73e2bfd/uploads/origins/8bab57a9-f347-45cb-8c4c-0d8220fb0257?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=b2367e09ab4c1a7baf78bc9bfe65d16d 2x, https://si.imgix.net/f73e2bfd/uploads/origins/8bab57a9-f347-45cb-8c4c-0d8220fb0257?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=68aaf0d09d91c412dc5066fbcbd707fb 3x"}, "body": "こんにちは友よ、手数料無料なのと兄に衣装の完成を助けてほしく参りましたぽに\n\n全身で前後の二面図で欲しいのと新規アイテムをお願いしたいので前回の依頼ぐらいの線画ないしラフでお願いしたいぽに\n\nhttps://twitter.com/arsisuponite/status/1562993030231392257?t=x1a12BUlLOaW53sPDNHTOQ&s=19\n上記の衣装で胸部のみ下記の衣装で大人しくした感じに（腹部は露出）\nhttps://twitter.com/arsisuponite/status/1637422457857671168?t=9XKxOOYi1vxPGIN0YLRPcw&s=19\n\n腰に画像を見本にした付け方でデザインを変えたベルトを2本、前から見たらX字になるように着けて欲しいです\n画像の瓶の代わりに左腰ベルトに鞘に収まった片刃の50cm位の剣と30cm位の片刃の短剣をマウントしてください\n右腰ベルトにお任せで皮のポーチをつけて下さい\n\n正面図には左手にやや大型の盾を持たせてください\n\nフラットな立ちポーズで前、後ろとその右に片刃剣とその鞘、短剣とその鞘、盾を並べて下さい\n\n短剣と片刃剣のデザインは姉妹剣のイメージで\n握り手、鍔、鞘はシンプルでお任せ\n刃は直刀片刃、全身黒刃で峰側に根元に赤い宝石がついた金の装飾がついています\nざっくりしたイメージ\nhttps://twitter.com/arsisuponite/status/1685588473175326720?t=VQSXJGvpU3_sG08M6GrxYQ&s=19\n\n盾大ざっぱな外枠の形状と比率参照\nhttps://twitter.com/arsisuponite/status/1685591071617843200?t=dgkUL_Gkkeg9qgzEQdADOg&s=19\n\n盾は黒い盾で左右に金の装飾で縁取られ中央に赤い大きめの宝石がある盾です\n\n上記の剣盾は下記の画像の鎧に持たせて違和感がない若しくはセット品のイメージでお任せでお願いいたします\n\nかなり細かく多いですが是非お力を貸して下さいお願いします＞＜", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@kouyanotouhu/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2429000, "client_id": 154780, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/d290fa9c/uploads/origins/1570da53-10ab-452e-a861-d6016ea77482?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2bf21c98920cfb799a1132375446a43f", "srcset": "https://si.imgix.net/d290fa9c/uploads/origins/1570da53-10ab-452e-a861-d6016ea77482?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2bf21c98920cfb799a1132375446a43f, https://si.imgix.net/d290fa9c/uploads/origins/1570da53-10ab-452e-a861-d6016ea77482?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=7c3faa16b1410e87d3d3fe97adc888e9 2x, https://si.imgix.net/d290fa9c/uploads/origins/1570da53-10ab-452e-a861-d6016ea77482?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f82e57519058bfe9ab21de7b1739e33e 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/d290fa9c/uploads/origins/1570da53-10ab-452e-a861-d6016ea77482?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=36083691689cb7123f3a8f64de0276b3", "srcset": "https://si.imgix.net/d290fa9c/uploads/origins/1570da53-10ab-452e-a861-d6016ea77482?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=36083691689cb7123f3a8f64de0276b3, https://si.imgix.net/d290fa9c/uploads/origins/1570da53-10ab-452e-a861-d6016ea77482?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=e168a82e2f829311db5ff6d40e9a0aa3 2x, https://si.imgix.net/d290fa9c/uploads/origins/1570da53-10ab-452e-a861-d6016ea77482?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=96993d45283fed41ba8f659bbda12fe5 3x"}, "body": "やあ友よ、少し大変かもだけどアイテム画と設定画をお願いしたいです・w）ノ\n\nお願いしたいのは天使が着ることを想定している鎧です\n\nhttps://twitter.com/arsisuponite/status/1630531545558831104?t=BbRZ2d6lDesYyns3fVCnUQ&s=19\n上記の鎧のバージョン違いを想定しているので、肩当ての模様色等は上記を参照にしてください\n\nhttps://twitter.com/arsisuponite/status/1647546009592147969?t=pW_iuO2XyY138vpXA-jOJg&s=19\n鎧のパーツ構成として、レオタードの上に胸当てと同素材でできた股間ガード？をつけています\nその上に布を垂らす為の金属を腰と肩当てにつけています\nレオタードには首と股間にチャックがついています\n\n\nhttps://twitter.com/arsisuponite/status/1647545973030424581?t=YzQrEEBqX-0wJVPnApruSA&s=19\n肩当てにつける金属は肩当てに窪みがありそこにはめて固定します\n\nhttps://twitter.com/arsisuponite/status/1647547544862605314?t=RoVuo1Ss-qLkX7gCMp9l4A&s=19\n肩のヒラヒラは上記の剣状の布が複数枚ついています\n色は薄い紫に濃い紫の模様が入っています\nベースになっている鎧についていたヒラヒラの形状違いのイメージです\n鎧についている時は輪っかの部分が何処かに消えていますが、鎧から分離すると右の様に捻れて剣もしくは魔力で飛翔させて攻撃できる設定です\n\n\n最終的に描いて頂きたいのは\n1、アイテム画としての鎧単品\nhttps://twitter.com/arsisuponite/status/1647545972791320577?t=ixW0xv78LqtS--bqjSuG9Q&s=19\n\n2、レオタード、胸当て、股間ガード？、布をつけるパーツ、分離した布と剣化した布を線画またはラフで他の方から見て解るぐらいに描いた物に1を足して一枚にした資料\n大変かもですが是非力を化して欲しいです、よろしくお願いします＞＜", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@kouyanotouhu/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2429000, "client_id": 154780, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/de3d7b83/uploads/origi