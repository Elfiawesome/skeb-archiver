用利用\n※上記にNGある場合はお手数ですが、リクエスト拒否をお願いします。\n\n【納品形式】\n人物、背景、文字でレイヤーを分けたPSD形式\nPSD納品が難しい場合は、背景透過人物画像(PNG)もいただきたいです。\n\nここまでお読みいただき、ありがとうございました。\nご検討のほどよろしくお願いします。", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@edake_toukou/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3879996, "client_id": 3595436, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/78b54243/uploads/origins/243a6cd4-e7d1-4aa1-a0cb-4ee63a2b4d6b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f054271557f32bd382ff7de8c21d1d0e", "srcset": "https://si.imgix.net/78b54243/uploads/origins/243a6cd4-e7d1-4aa1-a0cb-4ee63a2b4d6b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f054271557f32bd382ff7de8c21d1d0e, https://si.imgix.net/78b54243/uploads/origins/243a6cd4-e7d1-4aa1-a0cb-4ee63a2b4d6b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a836e6e38ea1508f431c901bcb2250f1 2x, https://si.imgix.net/78b54243/uploads/origins/243a6cd4-e7d1-4aa1-a0cb-4ee63a2b4d6b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=77acd68c262eb9da7ef797e68038b5f7 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/78b54243/uploads/origins/243a6cd4-e7d1-4aa1-a0cb-4ee63a2b4d6b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f8a1bc578372f1ce75d5e42683615067", "srcset": "https://si.imgix.net/78b54243/uploads/origins/243a6cd4-e7d1-4aa1-a0cb-4ee63a2b4d6b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f8a1bc578372f1ce75d5e42683615067, https://si.imgix.net/78b54243/uploads/origins/243a6cd4-e7d1-4aa1-a0cb-4ee63a2b4d6b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=dda38e28bf09cadd264a0f85682d1c8d 2x, https://si.imgix.net/78b54