ix.net/ef61e3e1/uploads/origins/fa5f4708-8865-42bb-ab02-16e382eca220?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=2395cc39b10e03e3ea2124042b3165b9 2x, https://si.imgix.net/ef61e3e1/uploads/origins/fa5f4708-8865-42bb-ab02-16e382eca220?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=657cbc27c33555bf37e0da378aa9882a 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/ef61e3e1/uploads/origins/fa5f4708-8865-42bb-ab02-16e382eca220?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3fae41afb4caefe89c273b29c286450a", "srcset": "https://si.imgix.net/ef61e3e1/uploads/origins/fa5f4708-8865-42bb-ab02-16e382eca220?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3fae41afb4caefe89c273b29c286450a, https://si.imgix.net/ef61e3e1/uploads/origins/fa5f4708-8865-42bb-ab02-16e382eca220?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=132ada6cc6ad08672f10a2e28b2ea96d 2x, https://si.imgix.net/ef61e3e1/uploads/origins/fa5f4708-8865-42bb-ab02-16e382eca220?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=12023ea00d4731428c1d3152ca211b2d 3x"}, "body": "こんにちは！初めて依頼を送信させていただきます。\n先日描かれていたもっちりしたさとり様が可愛かったので是非また描いていただければと思い\n依頼を送らせていただきました。\n内容としては【（先日体重計を踏みつぶしてしまったので）新しい体重計に乗ってみるもまたも踏みつぶしてしまうさとり様】のイラストをお願いできますでしょうか。\n体重計に乗ってるところでも踏みつぶした後でもどちらでも構いません。詳細はおまかせします。\nさとり様は白い鴉様が可愛いと思われる範囲でおデ…ぽっちゃりとした体型でお願いしたいです。\nソファーを潰してしまったりコミカルな感じが可愛くて依頼させていただきました。\nよろしくお願いします", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@syoboikarasu/works/9", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1927878, "client_id": 2616430, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/b92707ee/uploads/origins/28c16fbe-4052-422f-9