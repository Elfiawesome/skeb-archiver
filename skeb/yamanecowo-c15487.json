)\n・モテたくて高校デビュー、クラスではオタクなのを隠している\n・アニメとアイドルオタクでちょっと(だいぶ)ストーカー気質\n・好きな子のことはスマホでこっそり撮っちゃうくらい好き\n\nhttps://drive.google.com/drive/folders/1kuHWVO-sj0ANh-mPagT0WoAfZIYremo0?usp=sharing", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 1137565, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "七月", "screen_name": "uuuusatama", "avatar_url": "https://pbs.twimg.com/profile_images/1750456735268298752/jzpUpkv-.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1382566100936781825/1706250438/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 10, "complete_expiration_days": 30, "skills": [{"genre": "art"}], "nc": 128}, {"id": 1178680, "creator": true, "nsfw_acceptable": true, "acceptable": false, "name": "Lbf5n", "screen_name": "lbf5n", "avatar_url": "https://pbs.twimg.com/profile_images/1653275632334426112/_P6AiApd.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1252248297923678209/1709132659/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 120, "skills": [{"genre": "art"}], "nc": 33}, {"id": 1862278, "creator": true, "nsfw_acceptable": false, "acceptable": false, "name": "智@uki", "screen_name": "ukiukimeganeman", "avatar_url": "https://pbs.twimg.com/profile_images/1830123161360162817/sFdvrXOn.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1482628179948756993/1721052486/1500x500", "appeal_receivable": true, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 90, "sk