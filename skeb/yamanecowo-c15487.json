&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=dda7c4c9379e663e15a0eeed8d1395c2 3x"}, "body": "こんにちは！先生の作品がとても好きなので、私のオリジナルキャラクターの絵をお願いします7歳の小学生で、大人顔負けの落ち着いた子で、制服を着ています。\n\n ぜひぜひ、描いてください本来は11.15の誕生日用ですが、必要であれば後日お渡しすることも可能です!本当にありがとうございました!\n\n\nhttps://drive.google.com/drive/folders/1GPxZLN2_K01z0qldQXEa0NHsHaehQmcb?usp=sharing", "nc": 25, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@yamanecowo/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2144509, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/154130f7/uploads/origins/98d0a591-2896-4ca3-91cf-bf1d871bcba8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=03916b10ffdc9563189679480604a1a8", "srcset": "https://si.imgix.net/154130f7/uploads/origins/98d0a591-2896-4ca3-91cf-bf1d871bcba8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=03916b10ffdc9563189679480604a1a8, https://si.imgix.net/154130f7/uploads/origins/98d0a591-2896-4ca3-91cf-bf1d871bcba8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e9f2261608a66e90b5e0befb73079376 2x, https://si.imgix.net/154130f7/uploads/origins/98d0a591-2896-4ca3-91cf-bf1d871bcba8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a206b7b20799dbae3b1d14013cc327cc 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/154130f7/uploads/origins/98d0a591-2896-4ca3-91cf-bf1d871bcba8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c05f376e27c2078a24ca903c843deed7", "srcset": "https://si.imgix.net/154130f7/uploads/origins/98d0a591-2896-4ca3-91cf-bf1d871bcba8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c05f376e27c2078a24ca903c843deed7, https://si.imgix.net/154130f7/uploads/origins/98d0a591-2896-4ca3-91cf-bf1d871bcba8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=a67203883389b1e1f8aced1e2fd1f167 2x, https://si.imgix.net/154130f7/uploads/origins/98d0a591-2896-4ca3-91cf-bf1d871bcba8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=42fa6c7e4a433ca23db5db9a40e3aedf 3x"}, "body": "こんにちは。私はあなたのアートワークが大好きです。私のためにマーマンのキャラクターを描いていただけませんか？彼の名前はハルです。以下は彼の参考資料です（このページの下にあるギャラリーをご覧ください） - https://toyhou.se/1878373.haru-hosho\n\n海辺の岩の上に座っているようなかわいいシーンを描いていただけませんか？どんなポーズや雰囲気にするかは、以下のリファレンスを参照してください。\n\nhttps://safebooru.org/index.php?page=post&s=view&id=3811970\nhttps://safebooru.org/index.php?page=post&s=view&id=3091818\nhttps://safebooru.org/index.php?page=post&s=view&id=3912104\n\nポーズに特にこだわりはないので、どれを選んでもいいし、リファレンスを無視して他のものをやってもいい。\n\nありがとうございました!", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@yamanecowo/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2144509, "client_id": 410077, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/92d13b8b/uploads/origins/dd1fee59-06a9-4b1d-90b7-05d067d12fca?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=dd69c2bef0d8e0e42e7d85bbdf5890b5", "srcset": "https://si.imgix.net/92d13b8b/uploads/origins/dd1fee59-06a9-4b1d-90b7-05d067d12fca?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=dd69c2bef0d8e0e42e7d85bbdf5890b5, https://si.imgix.net/92d13b8b/uploads/origins/dd1fee59-06a9-4b1d-90b7-05d067d12fca?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=706b05da34a58fa7f2d4d6a3ed80b4ef 2x, https://si.imgix.net/92d13b8b/uploads/origins/dd1fee59-06a9-4b1d-90b7-05d067d12fca?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=621060ba6ceb13458ac76afd0de97a80 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/92d13b8b/uploads/origins/dd1fee59-06a9-4b1d-90b7-05d067d12fca?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ffd4cdd5dd155f761ce6f6620719d188", "srcset": "https://si.imgix.net/92d13b8b/uploads/origins/dd1fee59-06a9-4b1d-90b7-05d067d12fca?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ffd4cdd5dd155f761ce6f6620719d188, https://si.imgix.net/92d13b8b/uploads/origins/dd1fee59-06a9-4b1d-90b7-05d067d12fca?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=dfc6cce081f35467b0ff5c53a678e201 2x, https://si.imgix.net/92d13b8b/uploads/origins/dd1fee59-06a9-4b1d-90b7-05d067d12fca?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=aecf05bbc6e287498830f36772df1847 3x"}, "body": "yamanecowo様\n\n初めまして、白頭イワシと申します！\nyamanecowo様の素敵な画風に惹かれたのでリクエストさせて頂きます！\n\n早速リクエストですが、自作品のオリキャラ(金髪碧眼の女の子)をお願いしたいです。\n用途としましてはTwitterで紹介させて頂く他、SNS・掲示板等への掲載される可能性があります。\n\n彼女の名前はニーナと言い、好奇心旺盛な9歳の女の子です。\n何処へでも言ってしまうほど行動力に溢れており、冒険が大好きです。\n保護者の男性によく懐いており、いつも一緒に行動しています。\n構図等は全てお任せしますが、天真爛漫だと分かる雰囲気だととても嬉しいです。\n\n条件が良ければ、よろしくお願いします！\n\n参考ツイート\n\nhttps://twitter.com/hakuto_iwashi/status/1289010332157976576", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@yamanecowo/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2144509, "client_id": 1906853, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/2489d172/uploads/origins/f8513d08-a951-42b4-a9d1-e53c206e09c8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c6659cad6a280430ab3a58adee365566", "srcset": "https://si.imgix.net/2489d172/uploads/origins/f8513d08-a951-42b4-a9d1-e53c206e09c8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c6659cad6a280430ab3a58adee365566, https://si.imgix.net/2489d17