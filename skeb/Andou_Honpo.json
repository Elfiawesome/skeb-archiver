lient_id": 681884, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/90a0ed86/uploads/origins/7ce43897-8499-4ace-a5c7-8c1c0bae77f9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1c431af4609fadf308cc6ad0d6b96a57", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/90a0ed86/uploads/origins/7ce43897-8499-4ace-a5c7-8c1c0bae77f9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3646ca5a27f50ce05e013abc97046da2", "src_set": ""}, "body": "こんにちは、ご縁ありましたら幸いです。\n\n「アイラスの双眼」の自陣イラストをお願いしたいです。\n不明点などはすべてお任せします。\n両生還してずっと仲良く生きている二人です。\n\n【HO謎多き殺し屋】\n二十代前半、女\n\n黄緑系の短髪、褐色肌。白灰系の目。\n\nボーイッシュな見た目で童顔\n体型は女性的\n\nモチーフはクリームソーダ\n\nぼんやりした表情をすることが多く、でも結構お喋り\n情報屋のことがだいすき、この世のなによりも大事\nボケ担当、幼児っぽい\n\n【HO優秀な情報屋】\n二十代前半、男\n\n黒髪、赤い目。\n後ろ髪は刈り上げタトゥー\n\n年相応の顔立ちと体型\n\n口は悪いが世話焼きで賢く、身内を大事にする性格\n殺し屋をとても大切に想っている\nツッコミ担当、保護者感が強い\nが、殺し屋の無防備さに頭を抱えていて理性が可哀想\n\nhttps://drive.google.com/drive/folders/1Sja1T11azZwsarh9RBzdClxVGrJXpJIx?usp=sharing", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Andou_Honpo/works/106", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/02dbbe26/uploads/origins/5138c7e7-b5c8-45c6-b902-23739332f5e1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=50c64cc7d2c5acb01a7abb6ed2e1362b", "src_set": ""}, "private": true, "genre": "art", "tipped": false, "creator_id": 2875278, "client_id": 3008483, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 17, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@Andou_Honpo/works/105", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/4bff032e/uploads/origins/b23dfeec