お願いしたく、スーパーロボット大戦の「アイビス・ダグラス」のパイロットスーツを着用したウマ娘たちが、お互いにコックピットで通信し合っている感じのイラストをお願いいたします！\n\nhttps://www.pixiv.net/artworks/101583397\n過去、こちらの4枚目で描いていただきましたが、普通にあでぃにぃSFさんが描かれるアイビスパイスー良過ぎるなってなりまして…\n\nカット割りや描写範囲についてはお任せ出来ればと思いますが、自分の想像ではアニメや漫画である感じの、\n1枚のイラストに分割線が入り、それぞれバストアップで描かれている雰囲気を想像しています\n\nキャラはあでぃにぃSFさんが昨日の配信で好きと仰っていた娘から、エイシンフラッシュ、デュランダル、あとマチカネタンホイザ or アストンマーチャンのどちらかでお願いいたします！(4人は欲張りすぎるので一旦3人で…)\n\nご検討のほど、宜しくお願いいたします！", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@frompixiv/works/9", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2659228, "client_id": 3161, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/605d7576/uploads/origins/2f9f065c-ef10-4b40-9042-224e1c3517c3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e986a1ebfafe33ec6966044399ea5014", "srcset": "https://si.imgix.net/605d7576/uploads/origins/2f9f065c-ef10-4b40-9042-224e1c3517c3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e986a1ebfafe33ec6966044399ea5014, https://si.imgix.net/605d7576/uploads/origins/2f9f065c-ef10-4b40-9042-224e1c3517c3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=451fc4cf82360bd9a7b47dce5885b971 2x, https://si.imgix.net/605d7576/uploads/origins/2f9f065c-ef10-4b40-9042-224e1c3517c3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=fb97c22b6c1039cf3cfe10e6f93e1072 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/605d7576/uploads/origins/2f9f065c-ef10-4b40-9042-224e1c3517c3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=21f095fd1dd7c727bc2173d13e157ff5", "srcset": "https://si.imgix.net/605d7576/uploads/origins/2f9f065c-ef10-4b40-9042-224e1c3517c3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=21f095fd1dd7c727bc2173d13e157ff5, https://si.imgix.net/605d7576/uploads/origins/2f9f065c-ef10-4b40-9042-224e1c3517c3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=cb0cc9aa6618a5aeaee4f4ce6c96c344 2x, https://si.imgix.net/605d7576/uploads/origins/2f9f065c-ef10-4b40-9042-224e1c3517c3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=c01062617bd126f4ccefe6d298967da7 3x"}, "body": "https://x.com/frompixiv/status/1888230836073562115\nこちらの作品が凄くツボに来まして、こちらの素材をベースとした派生リクをお願いしてもよろしいでしょうか…？\n\n複座タイプが凄く好きで、操縦席が縦に3列並べる感じで、ウマ娘のヴ三姉妹をお願い出来ますでしょうか…？\n雰囲気的にはボディの素体ベースは顔だけ彼女たちに変えるイメージで、その際普通に配置すると後ろの娘は前の娘(の頭＆操縦席)に隠れる感じになってしまいますが、下記の簡略図みたいに顔ないし肩上まで見える感じに高低差付けて配置してもらえると…\n(色がそれぞれのキャラ、2つの丸は顔と胴体を表しています)\nhttps://x.com/kit_create/status/1888378159613313101\n\n背景はそのままでも、あるいは3人とも水兵みたいなビジュアルなので狭い潜水艇にして完全に外壁で覆われて薄暗い感じとかも…お任せします！\n出来れば表情は笑顔と言うよりは、長時間の操縦＆着用による緊張や蒸れ等で汗ばんでいる感じで見て見たいです\n\nご検討のほど、宜しくお願いいたします！", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@frompixiv/works/8", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2659228, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/0021389d/uploads/origins/5faf3666-6d06-4ffc-be82-fdf0fe40f96c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=cbfa503d124cccfc3832cfa669012e40", "srcset": "https://si.imgix.net/0021389d/uploads/origins/5faf3666-6d06-4ffc-be82-fdf0fe40f96c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=cbfa503d124cccfc3832cfa669012e40, https://si.imgix.net/0021389d/uploads/origins/5faf3666-6d06-4ffc-be82-fdf0fe40f96c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=7c0cd2bc0779623db1d25855bf465a42 2x, https://si.imgix.net/0021389d/uploads/origins/5faf3666-6d06-4ffc-be82-fdf0fe40f96c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&