7f-4f22-9802-a8f08dad37b4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=1f614c6971ea56ddbd9aecaa1112fc3b 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/a19dbe4f/uploads/origins/8f6e1367-9d7f-4f22-9802-a8f08dad37b4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9cb3dcedebc44172d8a059c7729990a2", "srcset": "https://si.imgix.net/a19dbe4f/uploads/origins/8f6e1367-9d7f-4f22-9802-a8f08dad37b4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9cb3dcedebc44172d8a059c7729990a2, https://si.imgix.net/a19dbe4f/uploads/origins/8f6e1367-9d7f-4f22-9802-a8f08dad37b4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=94a0bf2ebd296b4e7309fb063979e511 2x, https://si.imgix.net/a19dbe4f/uploads/origins/8f6e1367-9d7f-4f22-9802-a8f08dad37b4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=59e951d3683f14c1e7936e09941faf5f 3x"}, "body": "また依頼させてください。\nちょっと分量が多いですが、栞子とかすみんをお願いします。\n\n衣装は二人とも水着のブラとホットパンツで。\n（かすみはビーチパレー、栞子は水着で画像検索すると出ます）\n\nただし、ホットパンツの下はわざと水着無しのノーパン設定でお願いします。\n二人ともブラをずり上げられ、ホットパンツの前を大きく開けられて上下とも丸出しで。\n\nナンパしてきたチャラ男二人組とのビーチバレーで負け、\n罰ゲームを口実に人気の無い岩陰で頂かれている、という背景で。\n\n状況は、１枚目は両乳首責め、２枚目はそのまま挿入されている所で。\n構図や体位等はお任せします。\nおっぱいはなるべく見えてほしいですが、下は見えない構図でもOKです。\n台詞と表情だけは差分にして頂けると嬉しいです。\n（あと、セリフなしverも頂けると…！）\n\n１枚目\n栞子は、らしからぬ媚びた笑顔で、乳首攻めされるのに夢中になっている所を。\n「どう？乳首クリクリ気持ちいい？\n  おっぱい丸出しの栞子ちゃんｗ」\n「はい❤乳首クリクリ気持ち良いです❤」\n「そんじゃ胸だけでイッちまえｗ」\n「強いのだめぇ❤乳首気持ち良すぎますぅ❤」\n\nかすみんは前回の歩夢のようなスケベな表情で、もっと媚びた感じのにやけた口元で。\n「しお子はほんとスケベですねぇ❤\n  乳首だけでメロメロじゃないですかぁｗ」\n「かすみちゃんも乳首ビンビンなクセにｗ\n  同じようにシて欲しくないの？ｗ」\n「やぁん❤イジワルしないでくださいよぉ❤\n  かすみんのえっちな乳首、いーっぱいイジめてください❤」\n\n２枚目\n二人とも挿入されて、満面の笑みでセックスを満喫している感じで。\n「栞子ちゃんいただいちゃいました～ｗ」\n「はぁぁぁん❤長くて硬くて…最高です…❤」\n「何が良いのか言ってみｗ」\n「おちんちん！貴方のおちんちんです❤」\n\n「ちんぽ❤イケメンちんぽきたぁぁ❤」\n「かすみちゃん膣締め過ぎｗそんなに気に入った？ｗ」\n「このちんぽ好きぃ❤ヤリチンちんぽ最っ高ぉですぅ❤」\n\nキャラ崩壊気味ですが、えっちな女の子が大好きなもので…\n可能であれば、お願いします！", "nc": 160, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@gonta0417/works/6", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/92e13b37/uploads/origins/37af9359-4e79-4547-89cf-78abde0ca579?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=66858c4c74e85a5485d385d97eb989ed", "srcset": "https://si.imgix.net/92e13b37/uploads/origins/37af9359-4e79-4547-89cf-78abde0ca579?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=66858c4c74e85a5485d385d97eb989ed, https://si.imgix.net/92e13b37/uploads/origins/37af9359-4e79-4547-89cf-78abde0ca579?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=5588036826105b03ebc062d69cecce91 2x, https://si.imgix.net/92e13b37/uploads/origins/37af9359-4e79-4547-89cf-78abde0ca579?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=2431d51201ce8b2772b0f75dc6dd4431 3x"}, "private": true, "genre": "art", "tipped": false, "creator_id": 1523847, "client_id": 872994, "nc": 49}, {"path": "/@gonta0417/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1523847, "client_id": 735062, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/21e212cc/uploads/origins/71870de2-c247-4e8e-a845-bf46c4c4c196?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e57575f03da6a80a9bd47963c7953bbc", "srcset": "https://si.imgix.net/21e212cc/uploads/origins/71870de2-c247-4e8e-a845-bf46c4c4c196?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=cro