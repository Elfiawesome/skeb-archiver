。\nhttps://www.leagueoflegends.com/ja-jp/event/spirit-blossom/\n\n以上になります。\nイラストの用途としてはデスクトップの壁紙かDiscordのアイコンでの使用を考えています。\n普段描かれているジャンルとは全く違うものになり恐縮ですが、ご検討宜しくお願い致します。", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Arlcn_1115/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 63050, "client_id": 177871, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/ae6cc19c/uploads/origins/922c7390-5ca6-4246-842b-38d6c4afee83?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3cfa3a18c20208d585edfe0ab0e86548", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/ae6cc19c/uploads/origins/922c7390-5ca6-4246-842b-38d6c4afee83?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=1346315e6d638fa9101d7336a0120fef", "src_set": ""}, "body": "こんにちは！ドリームジャーニーと一緒にトレーナーとして私のオリジナルキャラクターを描いてください！身長差はありますが、恐怖は同じです！あなたのビジョンを信じて、気長に待っています！\n\nhttps://imgur.com/a/l9uvd8I\n\nhttps://umamusume.fandom.com/wiki/Dream_Journey", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Arlcn_1115/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 63050, "client_id": 473754, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/108d17df/uploads/origins/7ef9aaf4-ffd9-4aee-b99a-08f7c0ec1bb6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=52e05f74d2907b955d1ba563125dbdd7", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/108d17df/uploads/origins/7ef9aaf4-ffd9-4aee-b99a-08f7c0ec1bb6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5a04ff85bf1656edcb51821d2b7e9de9", "src_set": ""}, "body":