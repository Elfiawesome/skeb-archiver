、「まあ、運が悪かったね」と淡々と受け入れ、共存する。\n\n□使用用途\n個人での鑑賞、壁紙、SNSのアイコンなどに使用します。\n\n最後までお読みいただき、ありがとうございました。\nご検討のほど、よろしくお願いいたします！\n\nhttps://drive.google.com/drive/folders/147VgoMVtTC7DkWwvwAfp8WlpIn_b_FdZ", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@nocchan_chicchi/works/9", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/e9d7ea04/uploads/origins/034fff52-c5fe-488c-ba45-2fb7faeaf7aa?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=597c4bc2d88c559d2feedbcdb14656b0", "srcset": "https://si.imgix.net/e9d7ea04/uploads/origins/034fff52-c5fe-488c-ba45-2fb7faeaf7aa?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=597c4bc2d88c559d2feedbcdb14656b0, https://si.imgix.net/e9d7ea04/uploads/origins/034fff52-c5fe-488c-ba45-2fb7faeaf7aa?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=f6a535244e939cd64b87e9d9e598715d 2x, https://si.imgix.net/e9d7ea04/uploads/origins/034fff52-c5fe-488c-ba45-2fb7faeaf7aa?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=05cbefd84797be23c47ad1e3d2872bd7 3x"}, "private": true, "genre": "art", "tipped": false, "creator_id": 4049960, "nc": 128}, {"path": "/@nocchan_chicchi/works/8", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 4049960, "client_id": 3477358, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/9b10a066/uploads/origins/e0a23a18-0dc7-465c-b7c6-7262185c1035?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d6906a85cb