drive/folders/1MCfSSXYaPa-mhSRTWpSYv2CArHCNO9r0\n\nさらに、彼らの概要に関する参考資料はこちらです：\nhttps://drive.google.com/drive/folders/1-ZpPDG2rY5cLx9tztaf17QyNuW21iz6I\n\nどうもありがとうございます！", "nc": 56, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@nocchan_chicchi/works/7", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/800f86ab/uploads/origins/2dae90fb-42ee-4359-9dd2-b27595697d48?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=5f5a6df0e605791d54af92df6d14e434", "srcset": "https://si.imgix.net/800f86ab/uploads/origins/2dae90fb-42ee-4359-9dd2-b27595697d48?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=5f5a6df0e605791d54af92df6d14e434, https://si.imgix.net/800f86ab/uploads/origins/2dae90fb-42ee-4359-9dd2-b27595697d48?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=530267907e4f1b1d2771af148adbf5f5 2x, https://si.imgix.net/800f86ab/uploads/origins/2dae90fb-42ee-4359-9dd2-b27595697d48?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=7ce7ad0b025a6241efbe73ac3b6fe2ec 3x"}, "private": true, "genre": "art", "tipped": false, "creator_id": 4049960, "client_id": 3018714, "nc": 128}, {"path": "/@nocchan_chicchi/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 4049960, "client_id": 2572160, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/eb1d3485/uploads/origins/de88225a-370a-432c-91d4-ec62276048b8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=cca3f11952c17f29ec00bcd6a7648d23", "srcset": "https://si.imgix.net/eb1d3485/uploads/origins/de88225a-370a-432c-91d4-ec62276048b8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=cca3f11952c17f29ec00bcd6a7648d23, https://si.imgix.net/eb1d3485/uploads/origins/de88225a-370a-432c-91d4-ec62276048b8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=d0e50c3b26337e5b4ab29cbbb4ec5b07 2x, https://si.imgix.net/eb1d3485/uploads/origins/de88225a-370a-432c-91d4-ec62276048b8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ad92106b0d6bfdd8fedf76ee2a06c1e0 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/eb1d3485/uploads/origins/de88225a-370a-432c-91d4-ec62276048b8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=678386ddb05699ccc36305537507a576", "srcset": "https://si.imgix.net/eb1d3485/uploads/origins/de88225a-370a-432c-91d4-ec62276048b8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=678386ddb05699ccc36305537507a576, https://si.imgix.net/eb1d3485/uploads/origins/de88225a-370a-432c-91d4-ec62276048b8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=009112ad8ef4543af5ec381aeddb2cd7 2x, https://si.imgix.net/eb1d3485/uploads/origins/de88225a-370a-432c-91d4-ec62276048b8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=f324903073cc5909b2d85697b90a2f7d 3x"}, "body": "のち様はじめまして！\nこの度は私と友人のOCを描いていただきたくリクエストさせて頂きました。\n友人からは依頼許可取得済です。\n\nまた、今回依頼させていただくOCは『DERIVED』というCoCシナリオの出身OCになります。\nNPCと一緒の制服を着ておりますが、作者様には公式の制服を着せたまま有償依頼をさせて頂くことに許可を頂いております。\n\n金額が見合わなければ再送して頂けると幸いです。\n\n【キャラクター紹介】\n①メガネかけた黄眼の子\n性別：男\n年齢：21歳\n身長：173cm\n性格：まっすぐ、ほわほわ、よくすっとぼける\n特記：②の後輩\n\n②緑眼、目元に2つのホクロあり\n性別：男\n年齢：見た目20代後半\n身長：175cm\n性格：コツコツ仕事をこなすタイプ、温厚、内気な方\n特記：①の先輩\n\n\n2人の距離感\n一緒に仕事(電車の車掌)をしている先輩後輩。\n①がよくミスをするのでその尻拭いを②がよくやっている。\n2人ともまじめに毎日仕事をこなしている。\n\n【構図等】\n全てお任せ致します。\n\n【使用用途】\n個人観賞用、アイコンやヘッダーへの使用など。\n\n以上読んで頂きありがとうございます。\nのち様の素敵なイラストで2人を見られる機会があれば幸いです。\n\nhttps://drive.google.com/drive/folders/1eMrzLaBqirRczPGElIiQbYOMAsJOZvvn", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@nocchan_chicchi/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 4049960, "client_id": 3124663, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/a8441513/uploads/origins/4a1d987e-10ac-4350-a01b-d57e77d17685?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fabe833bafa7d47a1bfe206b5e565fac", "srcset": "https://si.imgix.net/a8441513/uploads/origins/4a1d987e-10ac-4350-a01b-d57e77d17685?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fabe833bafa7d47a1bfe206b5e565fac, https://si.imgix.net/a8441513/uploads/origins/4a1d987e-10ac-4350-a01b-d57e77d17685?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=757dbbdc928945876625257e52008f8b 2x, https://si.imgix.net/a8441513/uploads/origins/4a1d987e-10ac-4350-a01b-d57e77d17685?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=820915cb0c5aac2bb9372500bdf10407 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/a8441513/uploads/origins/4a1d987e-10ac-4350-a01b-d57e77d17685?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=71b0c2640a900561ef88759827e367e5", "srcset": "https://si.imgix.net/a8441513/uploads/origins/4a1d987e-10ac-4350-a01b-d57e77d17685?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=71b0c2640a900561ef88759827e367e5, https://si.imgix.net/a8441513/uploads/origins/4a1d987e-10ac-4350-a01b-d57e77d17685?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=0ceaabf1ce7fe4e18ef5436793ce2ba1 2x, https://si.imgix.net/a8441513/uploads/origins/4a1d987e-10ac-4350-a01b-d57e77d17685?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=db9225094e2cae25afc9eafe54ce2184 3x"}, "body": "オリジナルキャラクターを依頼させていただきます。\n描いていただきたいのは一次創作作品「落梅孤狼」の主人公の前世・宇津瀬十六夜の大人の姿になります。\nできたらで構いませんので、可能であれば紅花という白狼も隣に一緒に描いていただきたいです！\n転生もののお話なので相関が煩雑で申し訳ありません。\nストーリーとしては呪われた男女が生まれ変わって悪い蛇神と戦う物語です。\n\n下記のお願い事項以外は全て一任いたします。\n描きやすいように描いていただければと思います。\n使用用途は個人鑑賞となります。印刷してファイリングしたいと思っております。\n\n・宇津瀬十六夜ウヅセイザヨイ（23）\n衣装：和装着流し（舞台設定が江戸時代ごろのため。色、柄はお任せいたします。身振りには無頓着な性格ですので無地でも全然問題ありません）\n刀のデザインは決まってないので描かなくて大丈夫です。\n秋田県の男鹿半島・入道岬の枯れた草原がイメージです。お母さんが秋田美人の設定なので肌は色白だと嬉しいです。\n常に大狼を従えている浪人。かっこいいヒーローという感じではなく目つきの悪さが目立つタイプのキャラクターです。父親似の顔面がコンプレックスという設定があるため顔が隠れるほど前髪が長いです。\nカラーは目安でお使いください。\n詳細は資料ご参照下さい。\n\n顔面の傷と首の傷は必ず入れていただきたいです。（紅花とお揃いの傷で所有者の証です）\nすいませんそれ以外の傷は箇所が決まってないので、腕など見える位置に傷を入れていただきたいです。\n\n・紅花\n刀の付喪神の大狼\n刀の付喪神なので生き物のように鳴いたりはしません。体型はちょっと太っちょ（私の癖です）。性格は臆病で人懐こいです。\n\n\nhttps://drive.google.com/drive/folders/1nPND8a82ZrIKAQD_IVas4ucUL_awxaeE?usp=sharing\nhttps://drive.google.com/drive/folders/1VpzJI3n-Zv9NHT9UJvn_rPJxB-1uOayn?usp=sharing", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@nocchan_chicchi/works/4", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/8ab71ff4/uploads/origins/677c8fdd-e149-4bc6-80a9-3891b7c0c5cc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=4427795658f267729508c70f506096e6", "srcset": "https://si.imgix.net/8ab71ff4/uploads/origins/677c8fdd-e149-4bc6-80a9-3891b7c0c5cc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=4427795658f267729508c70f506096e6, https://si.imgix.net/8ab71ff4/uploads/origins/677c8fdd-e149-4bc6-80a9-3891b7c0c5cc?bg=%23fff&auto=forma