74a3c0364a6a 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/668ddacd/uploads/origins/42283013-b5f6-440e-855b-3ec15a487996?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2b71579cf69785b80864c5c68aca46ce", "srcset": "https://si.imgix.net/668ddacd/uploads/origins/42283013-b5f6-440e-855b-3ec15a487996?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2b71579cf69785b80864c5c68aca46ce, https://si.imgix.net/668ddacd/uploads/origins/42283013-b5f6-440e-855b-3ec15a487996?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=ffb0cb7fbd00040921f10a94d3f488aa 2x, https://si.imgix.net/668ddacd/uploads/origins/42283013-b5f6-440e-855b-3ec15a487996?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=f62f7910ccbd3d3eff3a7ff82318d522 3x"}, "body": "赤冑のゲマ様\nこんにちは。\nお初にお目にかかります。\n私のオリジナルキャラクター「海風シント」が甲冑のコスプレをしているイラストをリクエストします。\n【海風シント】\n資料：https://drive.google.com/file/d/1cilFfQrCqf--4IPOU169N97JKsjyvbTt/view?usp=drive_link\n性別：男性\n年齢：20代前半\n身長：170cm\n体型：スマートよりの中肉中背\n髪型：黒髪・少しボサボサ・左目が少し隠れている・襟足長め\n顔つき：つり目に上がり眉・猫口・黒目は小さめ\n\n【甲冑のデザイン】\n徳川家康が関ヶ原の戦いで着用したとされる歯朶具足(伊予札黒糸威胴丸具足)\n資料：https://www.touken-world.jp/search-armor/replica/55051/\n鎧直垂は無地の紺色\n面頬は有りと無しでレイヤー又はデータを分けて下さい。\n\n【イラストの構図】\n右手に火縄銃、左手に日本刀を持たせて下さい。\n全身が映るように描いて下さい。\nその他の構図はお任せします。\n\n金額に不足があればお手数ですが再送願います。\nご検討よろしくお願い申し上げます。", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@redarmor_gema/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1344854, "client_id": 3346450, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/4a5ddddf/uploads/origins/54ce31b3-d7f7-4a1d-a9a4-ae32cc6aba82?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f9810dab6060190c77682a63fc9288f9", "srcset"