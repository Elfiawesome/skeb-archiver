7-401b-97ae-b646752c3101?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c79134d26a8917eb9d14492065ed33f2", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/e13e0511/uploads/origins/b0ede52e-1ba7-401b-97ae-b646752c3101?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ebb3d5f790fd2fab8c16f4f964f2a96c", "src_set": ""}, "body": "お徳用さま\n\nはじめまして。お徳用さまのオリキャラのいちるちゃんが大好きで、リクエストの再開を心よりお待ちしておりました。\n以下のような内容でリクエストをお送りさせていただきます。\n内容はソープマット(URLをご参照いただけますと幸いです。)『https://drive.google.com/drive/folders/1o1JX8awkiNfKhGs6n1Iq7iSgrF9_MPuG』の上で全身をローションまみれにして、危険日にイチャラブしながらエッチをする『ぬるぬるいちる』ちゃんでお願い致します。\n画角は男性主観の正常位で、いちるちゃんと両手を恋人つなぎにしていて、いちるちゃんはマイクロビキニを着ている状態(ニーソは履いていない状態ですと幸いです。)でお願い致します。\n差し支えなければ、全裸差分もお願いして宜しいでしょうか。\nまた、男性の肌の色は黒すぎず、標準的なものでお願い致します。\nエッチの行程としては「素股→ゆっくりと挿入→ピストン→激しいピストン→膣内射精→うっとりしながら射精の余韻に浸る」というもので、始まりからおしまいまでいちるちゃんと見つめ合いながら恋人つなぎの状態でお願いしたく存じます。\nその際、いちるちゃんは沢山気持ちよくなって身体と子宮をビクつかせながら嬌声を響かせている様子を描いていただけますでしょうか。\n激しくピストンで突かれている時は『https://www.pixiv.net/artworks/114801755』の1枚目と同様の表情で、「なかだし」をおねだりしている描写をお願いしても宜しいでしょうか。\n差し支えなければ『https://nijie.info/view.php?id=189920』のような断面図を描いていただけますと幸いです。\n\n要求事項が細かい且つ多くなってしまいましたが、ご検討いただけますと幸いです。\nお手数おかけしますが、何卒宜しくお願い致します。", "nc": 48, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@otokuyou126a/works/63", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 78916, "client_id": 6210, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/d1444e49/uploads/origins/7159843d-e187-4067-b4b6-4afe67d487b7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a8d623754ff085d57cd75f6d62c05b62", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/d1444e49/uploads/origins/7159843d-e187-4067-b4b6-4afe67d487b7?bg=%23fff&aut