4cdfeae8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=0b87276aecbf449d7666587964698367 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/4acc4e9b/uploads/origins/f5467d9a-c499-4074-ab8f-c0314cdfeae8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d5fcf57ad2d2c690d2f5063417114c58", "srcset": "https://si.imgix.net/4acc4e9b/uploads/origins/f5467d9a-c499-4074-ab8f-c0314cdfeae8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d5fcf57ad2d2c690d2f5063417114c58, https://si.imgix.net/4acc4e9b/uploads/origins/f5467d9a-c499-4074-ab8f-c0314cdfeae8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=791cb4b8bd1f5c424fcb42ceaaf05325 2x, https://si.imgix.net/4acc4e9b/uploads/origins/f5467d9a-c499-4074-ab8f-c0314cdfeae8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=27f0042f438387d91c15a6d48d569af0 3x"}, "body": "こんにちは、怠仲と申します。\nMisskeyにて作品を拝見し、リクエストを送らせていただきました！\n\n◆依頼内容\nVRChat用アバターとして制作したオリジナルキャラクター用の衣装デザインをお願いしたいです。\n頂いたデザインを元に3Dモデルを制作し、販売する予定です。\n\n・下記キャラクターの中の誰かに合わせたデザインをお願いします。全て男性キャラクターです。\n昏\nhttps://misskey.design/gallery/9cxyz2du7a\n宵\nhttps://misskey.design/gallery/9cyounomkq\nなりゅ\nhttps://misskey.design/gallery/9dl82m6nkv\n械羅\nhttps://misskey.design/gallery/9hixwp1ue0\n黎\nhttps://misskey.design/gallery/9mlc4dzn81\n雛姫\nhttps://misskey.design/gallery/9s2o4seg7h\nメリオル\nhttps://misskey.design/gallery/a0hioeezuf1i1cig\n舂\nhttps://misskey.design/gallery/a1izmgkusrq55zem\n・特定の1人に合わせたものでも、色や装飾差分で何人かに合わせられるものでもどちらでも大丈夫です。\n・デザインの方向性についてはお任せします。和服でも洋服でも、カジュアル系でもフォーマル系でもそれ以外でもなんでも大丈夫です。ただし、過度な露出のないものでお願いします。\n・現実的、日常的な服ではなく、アイドル衣装や舞台衣装、ファンタジー創作系統で装飾が多めな衣装でお願いします。\n装飾の密度感参考\n下記リンクの男性衣装\n・https://pjsekai.sega.jp/news/archive/index.html?hash=6313633c830aef0a1f907c3cb0ce6e9253ca2208\n・https://pjsekai.sega.jp/news/archive/index.html?hash=549efd81699521b3fefcb0856fb8f156f580090d\n・正面、背面の二面図をお願いします。側面については二面図から予測が難しそうなところに補足説明があるとありがたいです。\n・衣装の構造、配色が明確であれば描き込みのあるイラストでなくても構いません。質感の補足(金属光沢がある、毛足の長いボア素材、など)があると嬉しいです。\n・Tポーズから制作するため、両腕を横に伸ばしたポーズで描いていただけるとありがたいです。\n・できれば衣装名も決めていただけると助かります。\n\n◆使用用途\n・頂いたデザインを元にした3Dモデル制作、制作したモデルの販売\n・SNSへの投稿や商品紹介ページへの掲載\n・自作のVRChatワールドへの展示\n\n◆頂いたデザインの取り扱いについて\n・衣装単品で制作するため、他のアバターが着用する可能性があります。\n・形状が不明瞭であったり、3D化するにあたり都合の悪い箇所は極力元の印象を崩さないようにこちらで改変します。\n・衣装モデルを購入したユーザーによって色変えや一部パーツのみの使用など、改変して使用される可能性があります。\n・以前デザインを提供頂いて制作した衣装の商品ページです。制作したモデルも同様の形式で販売予定です。\nhttps://tainaka.booth.pm/items/6613154\n・3D制作中に進捗報告として作業中データのスクショをSNSに投稿予定です。\n\n要望が多く申し訳ありませんが、問題なさそうであればよろしくお願いします……！\n金額はどのくらいか分からなかったので、不足であれば再送要請をお願いします！", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@8kaku_kei/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2065725, "client_id": 193145, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/f974dfb1/uploads/origins/be9ac0f2-595e-414d-af2e-37a6048f34f7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=805e83e7a89b0f9379ef58c5ff061ba6", "srcset": "https://si.imgix.net/f974dfb1/uploads/origins/be9ac0f2-595e-414d-af2e-37a6048f34f7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=805e83e7a89b0f9379ef58c5ff061ba6, https://si.imgix.net/f974dfb1/uploads/origins/be9ac0f2-595e-414d-af2e-37a6048f34f7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=0eb81eee868b96f2d8f8cb27225cdc54 2x, https://si.imgix.net/f974dfb1/uploads/origins/be9ac0f2-595e-414d-af2e-37a6048f34f7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=6a16482283648fde2652acf1f0a904ed 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/f974dfb1/uploads/origins/be9ac0f2-595e-414d-af2e-37a6048f34f7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ec2915664ade5eb0c8549d630a37297b", "srcset": "https://si.imgix.net/f974dfb1/uploads/origins/be9ac0f2-595e-414d-af2e-37a6048f34f7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ec2915664ade5eb0c8549d630a37297b, https://si.imgix.net/f974dfb1/uploads/origins/be9ac0f2-595e-414d-af2e-37a6048f34f7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=f5d13eb0f7304cc7dd441248b3667ca0 2x, https://si.imgix.net/f974dfb1/uploads/origins/be9ac0f2-595e-414d-af2e-37a6048f34f7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=ed621fc50db385c86b1ead4145586824 3x"}, "body": "はじめまして。あなたの作品をとても尊敬しているので、採用されたら嬉しいです！オリジナルキャラクター2体のイラストをお願いしたいです。\n\nキャラクターA 184cm。ハンター。弓が得意。クールで真面目。眉毛が濃い。めったに笑わない。肌の色に注意してください。服装は自由です。\n\n豆知識：彼は一度に3本の矢を射ることができる。\n\n🐰キャラクターB。貴族。穏やかな性格。首と両腕に包帯を巻いているため、その部分を隠す必要がある。月に縁がある。\n\nトリビア：詩を書く。\n\n🤝 関係：2人は同じ目的地に向かう途中で知り合った。赤の他人だが、友情が芽生えるかも？\n\n平安時代のような雰囲気のものを希望します。ポーズや表情はお任せします。何か問題があれば、遠慮なくお断りください。\n\nありがとうございました！\n\n以下リンク👇。\n\nhttps://www.dropbox.com/sh/oar6k52rzyaz2bs/AADWPTI85Bl3gBnStg_VpWJSa?e=1&dl=0", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@8kaku_kei/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2065725, "client_id": 2252949, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/800e23d0/uploads/origins/b464a90e-c691-4263-bfef-70632187dec6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=70534e5cecd46682306aa1b0ad38f67f", "srcset": "https://si.imgix.net/800e23d0/uploads/origins/b464a90e-c691-4263-bfef-70632187dec6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=70534e5cecd46682306aa1b0ad38f67f, https://si.imgix.net/800e23d0/uploads/origins/b464a90e-c691-4263-bfef-70632187dec6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=02bf76a8533511aab3e1155f1040d863 2x, https://si.imgix.net/800e23d0/uploads/origins/b464a90e-c691-4263-bfef-70632187dec6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b2bc72bfd915aa1694b21d730d55c668 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/800e23d0/uploads/origins/b464a90e-c691-4263-bfef-70632187dec6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=49f36e5cc954b4aec7c7eb90f1f4178b", "srcset": "https://si.imgix.net/800e23d0/uploads/origins/b464a90e-c691-4263-bfef-70632187dec6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=49f36e5cc954b4aec7c7eb90f1f4178b, https://si.imgix.net/800e23d0/uploads/origins/b464a90e-c691-4263-bfef-70632187dec6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=975ad207dd387ecb02293b3d79e823d9 2x, https://si.imgix.net/800e23d0/uploads/origins/b464a90e-c691-4263-bfef-70632187dec6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=d9ae8f57c2fd739cac8847263465df8d 3x"}, "body": "八角さんへ\nアピールありがとうございます！\n私擬似親子が好きでして…八角さんの龍神様と生贄の子の作品がイラストと台詞込み込みで大変好みでした…\nそして中華ファンタジー物も私も好きです😊私の作品の感想まで本当にありがとうございます…!!\n\n依頼内容なのですが、ダストと女士(にゅーしー)の2人組をお願いしたいです！\n2人の関係性をよく分かっていただけてそれだけでも大変嬉しいので構図等々は全てお任せしたいです。\n資料先の10枚目の等身絵の衣装が基本衣装になりますが、細かい所やよく分からないところ等ありましたらデザインを変更して頂いて構いませんが2人で共通の衣装を着ている設定でお願いしたいです🙇‍♀️\n\n※ここは省略して頂いて大丈夫です！※\n魔女の魔具(魔術の施されている武器)を使用するとその武器に施された能力で衣装が生成されるのですが、女士の武器を初めてであった時女士が譲渡した(正確にはダストが奪った)ので、女士と同じ衣装を身にまとっている設定が一応あります。)\n\n資料はリンク先のダストと女士の項目からお願いします🙏\n\nご検討よろしくお願いします！\n\nhttps://misskey.design/notes/9vpu63kfcm", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@8kaku_kei/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2065725, "client_id": 2823119, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/6ead5f80/uploads/origins/5e6ce34c-6837-4b25-8392-01e740ac52b9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6ddaabd2c1eff7d8733817af9eacab85", "srcset": "https://si.imgix.net/6ead5f80/uploads/origins/5e6ce34c-6837-4b25-8392-01e740ac52b9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6ddaabd2c1eff7d8733817af9eacab85, https://si.imgix.net/6ead5f80/uploads/origins/5e6ce34c-6837-4b25-8392-01e740ac52b9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=d603da3401122372e70e255c08bdbd0e 2x, https://si.imgix.net/6ead5f80/uploads/origins/5e6ce34c-6837-4b25-8392-01e740ac52b9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=3f55665f0d01fb14930998d3279e536c 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/6ead5f80/uploads/origins/5e6ce34c-6837-4b25-8392-01e740ac52b9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a6d7bdde315d6449004bedc2cbfdac87", "srcset": "https://si.imgix.net/6ead5f80/uploads/origins/5e6ce34c-6837-4b25-8392-01e740ac52b9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a6d7bdde315d6449004bedc2cbfdac87, https://si.imgix.net/6ead5f80/uploads/origins/5e6ce34c-6837-4b25-8392-01e740ac52b9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=236cbfa3fa41d7256b9d41892043e94f 2x, https://si.imgix.net/6ead5f80/uploads/origins/5e6ce34c-6837-4b25-8392-01e740ac52b9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=bc4a95f637a55e5e1f2ff10ca8a49ffe 3x"}, "body": "misskey.designから来ました！\n八角さんに、自キャラ達のペア画を想像で描いていただきたいです。バストアップでも全身でも構いません。服装や持ち物も設定は一応ありますが自由で大丈夫です。\n\n■キャラ名\n★クリウス（26歳、男）175cm\n緑髪ショートボブ、左側頭部にひと房金髪のメッシュが入っている。深い緑色の目、丸顔、均整の取れた体格。ウイニア国（モデル：スペイン）の第一王子。仕立ての良い青のマントと臙脂色の軍服を着ている。\n武術と魔術の両方を修める努力家。主人公であるワーネイア国（モデル：フランス）第一王女アンゼのことを利用しようと近づくが、やがて好きになる。神官に嫌われているため国内での人望は薄く、器用貧乏と評されている。笑顔が胡散臭い。ウイニアは宗教対立を起こしている海外の脅威に晒されており、近隣三国で争っている場合ではないと隣国ワーネイアの革命党を支援。ただしいずれは三国統一を目指す野心家でもある。\n\n★フィーアール（22歳、男）188cm\nイエローブロンドの短髪、浅い褐色の肌に海のような青い眼のワーネイア国海軍大将、筋肉質な槍遣い。灰色に赤いラインの入った軍服を着ている。\n庶民の出、次期女王の婚約者でありながら国家転覆を狙い、敵国ウイニアの王子クリウスの援助を得て革命党を興す。自信家で有能だが視野が狭く思い込みが激しいところがあり、婚約相手である自国の第一王女アンゼ姫のことを冷酷だと断じ敬遠する。一方で幼い頃から知っている第二王女エミューナ姫のことは大切にしており、革命が成立した暁には妃に迎えたいと思っている。フィーアールはクリウスのことを信用のおける友人だと思っているが、クリウスにとっては格下の相手。（だからこそクリウスは余裕をもって接することができているとも言える）\n\n■参考資料（必要に応じ参考にしてください。上記のみで描いていただいても構いません）\n小説〈Jewels of Werneia〉https://kakuyomu.jp/works/16817330656620434508\nカクヨム版「嵐の知らせ」\nhttps://kakuyomu.jp/works/16817330656620434508/episodes/16817330657778932384\nPixiv版「嵐の知らせ」\nhttps://www.pixiv.net/novel/show.php?id=20035743\n（掲載サイトが違うだけで内容の違いはありません）\n設定画\nhttps://misskey.design/notes/9hfteo84eh\n実際のゲームに使用したキャラグラフィック\nhttps://misskey.design/notes/9rrd28ac65\nhttps://misskey.design/notes/9rs01cnknn\n\n■その他\n納品物をPNG方式で保存した状態で、カクヨム・みすでざ・X等SNSでの宣伝に使用するかもしれないです。サインなど入れておいて頂けると助かります。\n\n以上になります、よろしくお願いいたします！\n\nhttps://www.pixiv.net/novel/series/10399983", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@8kaku_kei/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2065725, "client_id": 23744, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/5bdff6f0/uploads/origins/252d6b9e-e058-4ad1-a10f-770a2901b0c3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fc60801d202e5de74803ac3ec1b87a9a", "srcset": "https://si.imgix.net/5bdff6f0/uploads/origins/252d6b9e-e058-4ad1-a10f-770a2901b0c3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fc60801d202e5de74803ac3ec1b87a9a, https://si.imgix.net/5bdff6f0/uploads/origins/252d6b9e-e058-4ad1-a10f-770a2901b0c3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c90bfcfe125cebbc0a445d641596fa46 2x, https://si.imgix.net/5bdff6f0/uploads/origins/252d6b9e-e058-4ad1-a10f-770a2901b0c3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=9a2976d6ddba09b4971d03719e03e79f 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/5bdff6f0/uploads/origins/252d6b9e-e058-4ad1-a10f-770a2901b0c3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b8fbec1a8c79ef61d38bc60e365f538f", "srcset": "https://si.imgix.net/5bdff6f0/uploads/origins/252d6b9e-e058-4ad1-a10f-770a2901b0c3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b8fbec1a8c79ef61d38bc60e365f538f, https://si.imgix.net/5bdff6f0/uploads/origins/252d6b9e-e058-4ad1-a10f-770a2901b0c3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=85b91c7fc7c93c8c3f9f7ab7cecae474 2x, https://si.imgix.net/5bdff6f0/uploads/origins/252d6b9e-e058-4ad1-a10f-770a2901b0c3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=f58c3f87cd897a6769ca4e90cd202922 3x"}, "body": "いつもミスキーで作品拝見しています。拙作のOCを描いて頂きたくリクエストをお送りさせていただきます。\n\n・資料URL三人目のキャラクター「樋口少尉」をお願い致します。\n・タフで武骨な益荒男軍人男性です！！！\n・笑顔を見せることが稀な性格なので、笑顔以外の表情でお願いします。\n・着帽です\n・マント有無はおまかせします\n\n一応本編はあるのですが触れずに描いて頂いて大丈夫です。現時点での予想とか印象、もしくは原作未履修二次創作的なノリでも大丈夫です。ただし顔は良く描いてほしいです！！（あけすけですみません）\n性格というかキャラクター立ち位置的にはボーボボ人気投票2位で「フン」って言ってる感じのキャラです。\n\nご検討頂けますと幸いです。\n\nhttps://a-k-a-m-e.fanbox.cc/posts/2773714", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@8kaku_kei/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2065725, "client_id": 2573729, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/218c9ce8/uploads/origins/1e2a7356-f9fe-47af-b759-fba2e35d0069?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=30326c42ab1164b60373ad0875cfb9e1", "srcset": "https://si.imgix.net/218c9ce8/uploads/origins/1e2a7356-f9fe-47af-b759-fba2e35d0069?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=30326c42ab1164b60373ad0875cfb9e1, https://si.imgix.net/218c9ce8/uploads/origins/1e2a7356-f9fe-47af-b759-fba2e35d0069?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=7b9ff8af3c6c35ee53e9f37028d052fb 2x, https://si.imgix.net/218c9ce8/uploads/origins/1e2a7356-f9fe-47af-b759-fba2e35d0069?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e99737614df34fc9d09de0c3257f262f 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/218c9ce8/uploads/origins/1e2a7356-f9fe-47af-b759-fba2e35d0069?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=7c043997fa6df665043a50e16c513458", "srcset": "https://si.imgix.net/218c9ce8/uploads/origins/1e2a7356-f9fe-47af-b759-fba2e35d0069?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=7c043997fa6df665043a50e16c513458, https://si.imgix.net/218c9ce8/uploads/origins/1e2a7356-f9fe-47af-b759-fba2e35d0069?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=d57e716c3894815db80b0b8f619a6c2f 2x, https://si.imgix.net/218c9ce8/uploads/origins/1e2a7356-f9fe-47af-b759-fba2e35d0069?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=f7b3f90321c38c4328803c6a14c563e7 3x"}, "body": "八角さんこんにちは！misskey.designでお世話になっております、オオモトと申します。\n自創作キャラである『夷兵衛譚(いへえたん)( https://www.notion.so/alcheringa/eb170de8c6194f0c88c31ec57a4d5ce2 )のイラストをお願いしたく、リクエストを送らせていただきました。\n\n夷兵衛譚は刀の怪異であり、かつての刀の所有者(故人)の姿で現れます。過去に存在していた、とある武装組織に関わった者たちの記憶や思念の集合体でもあります。賊軍の烙印を押された組織の汚名返上を果たすため、歴史の真実を語り伝えるために世に留まりました。\n敗北者扱いされることを嫌うあまり(「勝てば官軍、負ければ賊軍」という思考になりがち)、戦闘時には狂人じみた言動を見せるものの、正々堂々とした勝負を好みます。\n\nシチュエーションにつきまして、青い炎の中で刀を手