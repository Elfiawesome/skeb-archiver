ix.net/19bfe367/uploads/origins/a8e2f3f2-771f-4e9d-aace-38fc7cd450e1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=aa60cddd9c680a3d338f6e27ce4a8051, https://si.imgix.net/19bfe367/uploads/origins/a8e2f3f2-771f-4e9d-aace-38fc7cd450e1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=59ea0355bf4ff7106ed524e7befdf8d8 2x, https://si.imgix.net/19bfe367/uploads/origins/a8e2f3f2-771f-4e9d-aace-38fc7cd450e1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=97bcb4b9e3eb5739826a455ac6916f07 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/19bfe367/uploads/origins/a8e2f3f2-771f-4e9d-aace-38fc7cd450e1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=16d2eaa347519245e6d1a6b57cc93a3b", "srcset": "https://si.imgix.net/19bfe367/uploads/origins/a8e2f3f2-771f-4e9d-aace-38fc7cd450e1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=16d2eaa347519245e6d1a6b57cc93a3b, https://si.imgix.net/19bfe367/uploads/origins/a8e2f3f2-771f-4e9d-aace-38fc7cd450e1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=621b8a250a1ca5ea0f5b2d9c9088fb44 2x, https://si.imgix.net/19bfe367/uploads/origins/a8e2f3f2-771f-4e9d-aace-38fc7cd450e1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=e2f92ab5c763d16d623f5386d7de55fd 3x"}, "body": "こんにちは\n続けてのリクエスト失礼致します。\n\nちゃけ様の描かれる女の子がかわいくて好きなので、是非先にリクエストさせて頂いた2人の女装アイドル姿も描いていただきたいと思いリクエスト致しました。\n\n連投になりますので不快に思われたらすみません。どちらか片方のリクエストだけでも構いません…。\n\n\n2人のアイドル姿でのアイドルらしい振る舞いをしているところを描いていただきたいです。距離感近く描いていただけると嬉しいです。\n構図やポーズ、衣装アレンジ等はおまかせします。\n\n\n以下キャラクター詳細を失礼致します。\n\n◾︎簡単なキャラ設定\n2人で女装百合地下アイドルユニット「Forabyss」を組んでいる。同棲中のカップル。\n\n・りおん(友人のキャラクター)\n21歳男。芸名は「りおな」。\n普段から女装男子。自分の顔が可愛いことを自覚していて、わがままな性格。\n最初はあすかのことが気に入らなかったが、今ではあすかに甘えたり甘やかしたりしている。\nアイドルとしてのファンサは多め。歌とダンスは下手だが愛嬌がある。\n\n・あすか(私のキャラクター)\n23歳男。芸名はそのまま「あすか」。\n普段は女装は全くしない。頭の回転が良く手先も器用なため、大抵のことはこなせる。\n何に対しても興味が薄く退屈な日々を送っていたが、最近はりおんといるのが楽しいと感じている。\nアイドルとしてのファンサは皆無で、舞台上では相方ばかりを見ている。歌とダンスは得意でパフォーマンスはちゃんとする。\n\n\n◾︎キャラデザ資料\n\nhttps://drive.google.com/drive/u/0/folders/1-9p4cH_2uoPDenn4hnCdJ7FcWQGLIAEv?ths=true\n\n\n◾︎使用用途\n・鑑賞\n・友人とのイラスト共有\n・ファイルサイズや構図によっては名前やIDを記載した上でTwitterのアイコンやヘッダーに使用する可能性がございます\n\n\nご多忙の中大変恐縮ですが、よろしければご一考いただけましたら幸いです。\nよろしくお願いいたします。", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@8equal0/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2578607, "client_id": 2358769, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/a7d7f24b/uploads/origins/4963f589-471d-453e-bf39-ccdcf56bcf50?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=246b9ecd6e9c1724011ae6847b7e8278", "srcset": "https://si.imgix.net/a7d7f24b/uploads/origins/4963f589-471d-453e-bf39-ccdcf56bcf50?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=246b9ecd6e9c1724011ae6847b7e8278, https://si.imgix.net/a7d7f24b/uploads/origins/4963f589-471d-453e-bf39-ccdcf56bcf50?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=8f374f91266eb8a774f5aeb83f216f60 2x, https://si.imgix.net/a7d7f24b/uploads/origins/4963f589-471d-453e-bf39-ccdcf56bcf50?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f824dec1348750537edfb186d28d8fe5 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/a7d7f24b/uploads/origins/4963f589-471d-453e-bf39-ccdcf56bcf50?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e82867b0e039bb56f936d25cbe421cef", "srcset": "https://si.imgix.net/a7d7f24b/uploads/origins/4963f589-471d-453e-bf39-ccdcf56bcf50?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e82867b0e039bb56f936d25cbe421cef, https://si.imgix.net/a7d7f24b/uploads/origins/4963f589-471d-453e-bf39-ccdcf56bcf50?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=c16faaa1d67e0001fda06a0fba0b8edf 2x, https://si.imgix.net/a7d7f24b/uploads/origins/4963f589-471d-453e-bf39-ccdcf56bcf50?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=c457ab65bb34686653e669974a44b0e9 3x"}, "body": "ちゃけ様\n\n初めまして。\nちゃけ様のイラストをskebの新着で見て、構図と雰囲気に一目惚れし、私と友人のキャラクターを是非様に描いていただきたいと思い依頼いたしました。(友人には許可をとっています。)\nTwitterの女の子のイラストもとてもかわいくて好きです…！\n\nかなり癖に寄ったキャラになりますので、地雷等ありましたらお断りくださいませ。\n\n\n以下の2人の私服姿を描いていただきたいと思います。服装のアレンジ・構図等は自由に描いていただけたら嬉しいです。\n\n\n◾︎簡単なキャラ設定\n2人で女装百合地下アイドルユニット「Forabyss」を組んでいる。同棲中のカップル。\n\n・りおん(友人のキャラクター)\n21歳男。芸名は「りおな」。\n普段から女装男子。自分の顔が可愛いことを自覚していて、わがままな性格。\n最初はあすかのことが気に入らなかったが、今ではあすかに甘えたり甘やかしたりしている。\n不器用で料理や細かいことが苦手。\n煽り耐性が低いのであすかにからかわれるとすぐに怒るが、単純であるためすぐに機嫌が直る。表情豊かでコロコロ表情が変わる。\n\n・あすか(私のキャラクター)\n23歳男。芸名はそのまま「あすか」。\n普段は女装は全くしない。頭の回転が良く手先も器用なため、大抵のことはこなせる。\n何に対しても興味が薄く退屈な日々を送っていたが、最近はりおんといるのが楽しいと感じている。\nりおんの世話をするのが好きでマニキュア・ペディキュアを塗ったり髪を整えたり風呂に入れたりご飯を作ったりするのが好き。甲斐甲斐しく世話をするが、性格の根本は構いたがりからかいたがりのためよくりおんを煽っている。\n\n\n◾︎キャラデザ資料\n\nhttps://drive.google.com/drive/u/0/folders/1-9p4cH_2uoPDenn4hnCdJ7FcWQGLIAEv?ths=true\n\n\n◾︎使用用途\n・鑑賞\n・友人とのイラスト共有\n・ファイルサイズや構図によっては名前やIDを記載した上でTwitterのアイコンやヘッダーに使用する可能性がございます\n\n\nご多忙の中大変恐縮ですが、よろしければご一考いただけましたら幸いです。\nよろしくお願いいたします。", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@8equal0/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2578607, "client_id": 12922, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/57b85261/uploads/origins/f1158bfb-856c-4311-addf-98d45316d60d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8a0faf3cf42342c906790deca6d33448", "srcset": "https://si.imgix.net/57b85261/uploads/origins/f1158bfb-856c-4311-ad