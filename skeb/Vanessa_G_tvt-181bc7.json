x.net/a3ab5d54/uploads/origins/cfa691b3-80ec-4598-a26b-36a407cf1927?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=92b2136b5d95c8aa1c71017141f5dd58 3x"}, "body": "ヴァネ姉様\n\n突然のSkebリクエスト失礼します。\nくまちゃんです。\nヴァネ姉様にトモコレで生まれた''僕の娘2人''を描いていただきたいです。\n\n〇キャラについて------------\n1人目：じゅこ (姉)\n・メインカラーは紫\n・瞳は緑\n・髪色は黒にところどころ紫がある\n・髪型は\n前髪：少しパラパラ気味のパッツン\n後ろ髪：トモコレの髪型でどんな髪か正直把握してないが、上の方で結んでその結んだ髪を広げている感じ(くせっ毛ありそう)\n・太眉\n・クール系無口女子、身内以外人を寄せつけないタイプ、お堅いところありだけど可愛らしい印象の子(主観)、背は小さめ\n\n2人目：詩 (妹)\n・メインカラーは青\n・瞳は青\n・髪色はグラデーションがあり、上が濃ゆい青(紺)、下が水色\n・髪型は\n前髪がパッツンで横に少し太めの触覚あり\n後ろ髪はウルフ寄りのボブ？\n・じゅこちゃんよりかは細めの太眉\n・ほわほわしてる天然ちゃん、みんなから好かれている、可愛いもあるがキレイめ、お姉ちゃんよりも背が高い\n\n2人ともトモコレの世界だと大人ですが、個人的には高校生～大学生辺りの学生イメージです。\n\n〇構図・シチュエーション等----------------\nただ2人を描いて頂くだけでもいいですし、学生っぽいシチュエーションで書いていただいても構いません。\n全身・胸上等も好きに描いていただきたいです。\n\n〇使用用途について----------------\n使用用途は、shorts動画と自分で愛でる用です。\n\n〇納品データ----------------\nPNG、JPEG、PSDどれでも構いません。\n\n〇資料----------------\n軽い資料はこちらにございます。\nhttps://drive.google.com/drive/folders/1dBgAXpcvW8A17ZyOr-eSZ53XSsM2_ZAI\n\n----------------\n\n長文失礼しました。\nご検討の程よろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/1dBgAXpcvW8A17ZyOr-eSZ53XSsM2_ZAI", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 52599, "creator": true, "nsfw_acceptable": false, "acceptable": false, "name": "ヒトこもる", "screen_name": "Hitoimim", "avatar_url": "https://pbs.twimg.com/profile_images/1760950169435328512/_6dHoc18.jpg", "header_url": "https://pbs.twimg.com/profile_banners/935775260082765824/1720671297/1500x500", "appeal_receivable": false, "popular_creator_rank": 14, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 120, "skills": [{"genre": "art"}], "banned": false, "nc": 0}, {"id": 176492, "creator": true, "nsfw_acceptable": false, "acceptable": false, "name": "アルセチカ", "screen_