: {"nsfw": true}}}, "acceptable_only_public": false, "tip_acceptable": true, "yearly_report_client_visible": false, "total_appeals_count": 0, "received_works": [{"path": "/@sirius1810405/works/8", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 462825, "client_id": 1972900, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/8b8d7d16/uploads/origins/152d2a31-30b5-459c-8f43-c036ae0e5394?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=041a19edddcdc211c20e9885c236e51f", "srcset": "https://si.imgix.net/8b8d7d16/uploads/origins/152d2a31-30b5-459c-8f43-c036ae0e5394?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=041a19edddcdc211c20e9885c236e51f, https://si.imgix.net/8b8d7d16/uploads/origins/152d2a31-30b5-459c-8f43-c036ae0e5394?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=09ef1ed7547871a2610d09a4ea9c1e8c 2x, https://si.imgix.net/8b8d7d16/uploads/origins/152d2a31-30b5-459c-8f43-c036ae0e5394?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a281233719b1e14ad9456e0a6d87da13 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/8b8d7d16/uploads/origins/152d2a31-30b5-459c-8f43-c036ae0e5394?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5792736e6857cbad48bbcfed78e73c90", "srcset": "https://si.imgix.net/8b8d7d16/uploads/origins/152d2a31-30b5-459c-8f43-c036ae0e5394?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5792736e6857cbad48bbcfed78e73c90, https://si.imgix.net/8b8d7d16/uploads/origins/152d2a31-30b5-459c-8f43-c036ae0e5394?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=75ab61a183f87c60a1e0c4b991594f8b 2x, https://si.imgix.net/8b8d7d16/uploads/origins/152d2a31-30b5-459c-8f43-c036ae0e5394?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=9fe10ef7bd176e247b8523297dbc5e6c 3x"}, "body": "Hello, sensei,\nこんにちは、先生、\n\nThank you for accepting so many of my requests and drawing Alma and Seth so much. I love your art style, and I'm honored that you've drawn my characters.\nIf it's not too much trouble, may I ask for one more illustration?\nたくさんのアルマとセトを描いて下さって、いつもありがとうございます。先生の絵柄が大好きで、うちの子達がその絵柄で描かれているのは光栄です。\nご迷惑でなければ、イラストをもう一枚頼んでもよろしいでしょうか？\n\nThis time, I'd like to request an illustration of Alma and Seth together.\nI'd like an illustration of the two of them as a couple, something tender and a bit romantic.\nA tranquil atmosphere a bit like on the cover of Umineko Chiru EP8 Volume 9.\n今回は、アルマとセトの二人でいるイラストをリクエストしたいのです。\nカップルイラストで、優しくてロマンチック的な絵がいいです。\nちょっと先生が描いたうみねこ散EP8の第９巻の表紙みたいな穏やかな雰囲気。\n\nAlma and Seth are the kind of people who support each other through difficult times and trust each other profoundly.\nアルマとセトは、困難な時期で互いに支え合い、深く信頼し合うタイプの人です。\n\nOf course, if the price doesn't match the request, I don't mind you raising it.\n勿論、値段がリクエストと合わないのなら、値段を上がっても構いません。\n\nリクエストを読んでくださってありがとうございました。\n\nhttps://imgur.com/a/8MXakPz", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@sirius1810405/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 462825, "client_id": 1972900, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/8f1cb298/uploads/origins/a6ef8f54-5e4b-4035-a0a3-3a83657dbdab?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d30619fd9e7b07b6240decda85916e0a", "srcset": "https://si.imgix.net/8f1cb298/uploads/origins/a6ef8f54-5e4b-4035-a0a3-3a83657dbdab?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d30619fd9e7b07b6240decda85916e0a, https://si.imgix.net/8f1cb298/uploads/origins/a6ef8f54-5e4b-4035-a0a3-3a83657dbdab?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=cb7aefd49a8f15b193acf547d8b2a18d 2x, https://si.imgix.net/8f1cb298/uploads/origins/a6ef8f54-5e4b-4035-a0a3-3a83657dbdab?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d6c28b8be45b3b6db967ae2056879aa0 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/8f1cb298/uploads/origins/a6ef8f54-5e4b-4035-a0a3-3a83657dbdab?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d247e1d825006e88b0b692f4eca94019", "srcset": "https://si.imgix.net/8f1cb298/uploads/origins/a6ef8f54-5e4b-4035-a0a3-3a83657dbdab?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d247e1d825006e88b0b692f4eca94019, https://si.imgix.net/8f1cb298/uploads/origins/a6ef8f54-5e4b-4035-a0a3-3a83657dbdab?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=804aed616080c25bf56ba8e88b23adc4 2x, https://si.imgix.net/8f1cb298/uploads/origins/a6ef8f54-5e4b-4035-a0a3-3a83657dbdab?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=8e63b85ac020b20b17ece3702447d463 3x"}, "body": "こんにちは、先生、\n\n前々回のリクエスト、本当にありがとうございました！\nもしご迷惑でなければ、もう一枚イラストをお願いしたいです。\n\n今回は、私のオリジナルキャラクター、アルマの周りにお花を飾ってほしいです。\nできれば、ほのぼのとしたイラストを希望します。\n\nコミックのリクエストで描いていただいたアルマは本当にかわいかったです。本当に大好きです！\n特に下の枠。彼女の笑顔は見るたびに心が温かくなります。\n\n楽しんで描いてくれたらうれしいです！\n\nリクエストを読んでくださってありがとうございました。\n\nhttps://imgur.com/a/Od4igbO", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@sirius1810405/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "comic", "tipped": true, "creator_id": 462825, "client_id": 151838, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/b293a957/uploads/origins/0d22415b-4cb9-4c44-ab53-b08ab2b71951?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=87ccbee1b028b004be6ec9b472e4dc2e", "srcset": "https://si.imgix.net/b293a957/uploads/origins/0d22415b-4cb9-4c44-ab53-b08ab2b71951?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=87ccbee1b028b004be6ec9b472e4dc2e, https://si.imgix.net/b293a957/uploads/origins/0d22415b-4cb9-4c44-ab53-b08ab2b71951?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=451465a7dc6a0c3dfb93379c000a1fd8 2x, https://si.imgix.net/b293a957/uploads/origins/0d22415b-4cb9-4c44-ab53-b08ab2b71951?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b52539a4325300679f902fc166bc18be 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/b293a957/uploads/origins/0d22415b-4cb9-4c44-ab53-b08ab2b71951?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2c17b4f696c9448d61b1b25373431068", "srcset": "https://si.imgix.net/b293a957/uploads/origins/0d22415b-4cb9-4c44-ab53-b08ab2b71951?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2c17b4f696c9448d61b1b25373431068, https://si.imgix.net/b293a957/uploads/origins/0d22415b-4cb9-4c44-ab53-b08ab2b71951?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=15060aa3d2dc0278e0a557ec0eba58d3 2x, https://si.imgix.net/b293a957/uploads/origins/0d22415b-4cb9-4c44-ab53-b08ab2b71951?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=358e65692e274a8a4f41e1ef2929ab18 3x"}, "body": "I would like a scene of the mother and the daughter in a one sided argument.\n母と娘の一方的な言い争いのシーンが欲しい。\n\nThe mother is shouting at the daughter.\nThe daughter does not shout back, her face is neutral, but that makes the mother angrier. \n母親が娘を怒鳴りつけている。\n娘は怒鳴り返さず、無表情だが、それが母親をより怒らせている。\n\nThe real daughter died long ago. The doll replaced her.\nThe mother's grief has turned to anger.\nThe fake daughter thinks she is real enough.\n本当の娘はとっくに死んでいる。人形がその代わりになったのです。\n母親の悲しみは怒りへと変わった。\n偽