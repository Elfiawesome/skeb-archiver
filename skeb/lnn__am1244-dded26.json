、体のみ機械です。アンドロイドのような……\n・ヤンデレ、かまってちゃん、甘えん坊です。糸鋸や鋸を好みます。\n・衣装のモチーフに骨や骸骨、またはひまわりを入れていただきたいです。ワンポイントのアクセサリーなどでも大丈夫です。\n・機械なので身長は100-152cmの間で自由に描いていただいて問題ありません。\n\nお忙しいなか最後まで読んでくださりありがとうございました。\nご検討よろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/10n3kc6DJK5iLvV68BLa_3-hOahkbfr0U", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}], "sent_works": [], "similar_creators": [{"id": 849545, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "ミーのん＠36ⅾ（skeb受付中）💯🦂", "screen_name": "menon", "avatar_url": "https://pbs.twimg.com/profile_images/1621841477537263621/s0EPecdp.jpg", "header_url": "https://pbs.twimg.com/profile_banners/3189876710/1695336625/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 7, "complete_expiration_days": 30, "skills": [{"genre": "art"}], "banned": false, "nc": 144}, {"id": 1929346, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "ふせんりょ", "screen_name": "fusenryo2", "avatar_url": "https://pbs.twimg.com/profile_images/1570380827116343297/3nAQlmbS.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1429384473171283969/1629629288/1500x500", "appeal_receivable": false, "popular_creator_rank": 46, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 3, "complete_expiration_days": 7, "skills": [{"genre": "art"}, {"genre": "comic"}], "banned": false, "nc": 129}, {"id": 2257463, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "米粒くん", "screen_name": "asoi002", "avatar_url": "https://pbs.twimg.com/profile_images/1556956455051599872/WgL49TSM.jpg", "header_url": null, "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by"