の精液(ぶっかけとか)表現NG\n・胸やふとももを盛らないように、なるべく華奢な体型で\n・瞳の中にハートを描く表現NG\n・ウエストの細さを意識してください\n\n以下は可能なら入れて欲しいもの\n・失禁差分\n・目を開けている表情差分\n\n\n以上です、よろしくお願いします", "nc": 41, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@Phosphorous921/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2032013, "client_id": 462930, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/23e8888a/uploads/origins/d7430167-d00f-4449-a411-a378b99fb108?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0a3bb014e8f4a497093b5267c8e0b3f5", "srcset": "https://si.imgix.net/23e8888a/uploads/origins/d7430167-d00f-4449-a411-a378b99fb108?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0a3bb014e8f4a497093b5267c8e0b3f5, https://si.imgix.net/23e8888a/uploads/origins/d7430167-d00f-4449-a411-a378b99fb108?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=51ede75d5188cbc6a404bd0980aeddaf 2x, https://si.imgix.net/23e8888a/uploads/origins/d7430167-d00f-4449-a411-a378b99fb108?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=8622dba189ddc3ec7133d9704781423f 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/23e8888a/uploads/origins/d7430167-d00f-4449-a411-a378b99fb108?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=df722762c82a6583b462dc7c459aa3b4", "srcset": "https://si.imgix.net/23e8888a/uploads/origins/d7430167-d00f-4449-a411-a378b99fb108?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=df722762c82a6583b462dc7c459aa3b4, https://si.imgix.net/23e8888a/uploads/origins/d7430167-d00f-4449-a411-a378b99fb108?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=c7baa2048c511f38535371c48d321c0a 2x, https://si.imgix.net/23e8888a/uploads/origin