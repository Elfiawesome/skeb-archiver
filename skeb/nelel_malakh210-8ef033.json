の大きな袖に、ハーネス、ストラップ、ガーターベルトがついたものがいいです。\n靴はこんな感じのブロック状のものを履かせたい。(https://pin.it/26h4nCw)\n髪にはヘアクリップやスターピンをたくさんつけて、こんなかわいい角もつけてほしいです。(https://www.pinterest.com/pin/822962531919093811/)のようなアンテナ的なものや、長いアホ毛もかわいいですね。\n白、ピンク、ブルー、パープル、イエローがメインカラーです。\n参考URLは、彼のオリジナル参考文献です。\n服のためのpinterestボードを作成しました： https://pin.it/2JnDlyP\n本当にありがとうございました。\n\nhttps://drive.google.com/drive/folders/1ZBXRxmMo7sD4-Lgtde8FgLhgl5n-1vvt?usp=sharing", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@nelel_malakh210/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1248890, "client_id": 833696, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/f1686d41/uploads/origins/92c47693-7f1e-4b62-8972-4c38ebc21fd2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2a16d466481622ef9d9a3fad326b116a", "srcset": "https://si.imgix.net/f1686d41/uploads/origins/92c47693-7f1e-4b62-8972-4c38ebc21fd2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2a16d466481622ef9d9a3fad326b116a, https://si.imgix.net/f1686d41/uploads/origins/92c47693-7f1e-4b62-8972-4c38ebc21fd2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=baa55edd01adb7e26811ec58ad9cd1ad 2x, https://si.imgix.net/f1686d41/uploads/origins/92c47693-7f1e-4b62-8972-4c38ebc21fd2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d37ace5edd7763364e26c026c0be8977 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/f1686d41/uploads/origins/92c47693-7f1e-4b62-8972-4c38ebc21fd2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=80f1db524c93d52287e94fd737f46d5b", "srcset": "https://si.imgix.net/f1686d41/uploads/origins/92c47693-7f1e-4b62-8972-4c38ebc21fd2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=80f1d