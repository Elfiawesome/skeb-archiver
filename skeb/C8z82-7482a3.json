\n- 二人のやり取りは明らかに普通の友人以上だが、関係を壊したくないため決定的な一歩を踏み出さない\n\n桓 時焕が「頼れる先輩」と言われるのは、彼自身の性格というより、良い先輩とはこうあるべきだという責任感から来るもの\n\n裁見 目司は「俺たちは相棒だ」と強調する。なぜなら、相棒でなければ他の関係にはなり得ないと思っているから\n自由にアレンジしていただいて構いません！\n読んでくださり、ありがとうございます。\n\nよろしくお願いします。\nhttps://drive.google.com/drive/folders/10oIaOTVA14blPk8lMpaXmaMd3DkujdtU", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@C8z82/works/12", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3791985, "client_id": 3750073, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/8aba9202/uploads/origins/fff9a874-36e8-4665-83b6-b27c9e4ea612?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a13d5ca7ef120aab1ff0dabf49dc4101", "srcset": "https://si.imgix.net/8aba9202/uploads/origins/fff9a874-36e8-4665-83b6-b27c9e4ea612?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a13d5ca7ef120aab1ff0dabf49dc4101, https://si.imgix.net/8aba9202/uploads/origins/fff9a874-36e8-4665-83b6-b27c9e4ea612?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=3b754bffd8d7c10b19e9927c1c4e112d 2x, https://si.imgix.net/8aba9202/uploads/origins/fff9a874-36e8-4665-83b6-b27c9e4ea612?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f05854d09816c920e3d4db14be90cde2 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/8aba9202/uploads/origins/fff9a874-36e8-4665-83b6-b27c9e4ea612?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=eb92b34eae4948d09e16198afe3e3b02", "srcset": "https://si.imgix.net/8aba9202/uploads/origins/fff9a874-36e8-4665-83b6-b27c9e4ea612?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=eb92b34eae4948d09e16198afe3e3b02, https://si.imgix.net/8aba9202/uploads/origins/fff9a874-36e8-4665-83b6-b27c9e4ea612?bg=%23fff&auto=f