=3&fit=crop&crop=top&w=200&h=200&s=6b71d39980b9fbe19619245cd34bc8fe 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/f2c5137e/uploads/origins/56412e21-0392-4f15-9673-4d6e32e84c19?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=488efc81c2a982b7b95e4dbdf1c8660d", "srcset": "https://si.imgix.net/f2c5137e/uploads/origins/56412e21-0392-4f15-9673-4d6e32e84c19?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=488efc81c2a982b7b95e4dbdf1c8660d, https://si.imgix.net/f2c5137e/uploads/origins/56412e21-0392-4f15-9673-4d6e32e84c19?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=1ac376745b6f0025632ec12140c85ac1 2x, https://si.imgix.net/f2c5137e/uploads/origins/56412e21-0392-4f15-9673-4d6e32e84c19?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=00a3721391e2d1f69c3e27c534e197d6 3x"}, "body": "こんにちは。いつもお世話になっています。\n今回もイラストの依頼をさせて頂きます。\nエゴミキサー（尋問時）の髪型が好きなので、その再現をして頂ければと思い依頼しました。\n\n【依頼内容】\n・ヘアセットした堂建進\n・衣装、アクセサリーはお任せで、本人が選んだ体でもスタイリストさんに着せてもらった体でも。\n（余裕があればどちらになったのか記載していただければ、より嬉しいです）\n・完全IFでも、何らかのきっかけで着ることになったなどでも経緯はお任せします。\n・雰囲気はカッコよさを前面に出していただければと思います。\n\nもしシチュエーション説明があればpsdのラフ内等に記載があれば幸いです。\n\n【希望サイズ】\nアイドルのチェキのようなレイアウトになっていたら嬉しいです。\nサイズや縦横比自体は1番描きやすいもので構いません。\nお好みでお願いします。\n\n【用途】\n画像を使用したチェキ風カードの作成\n待ち受け\n個人的に印刷してフォトフレームで飾る等", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@EgoMixer/works/69", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2935531, "client_id": 2704541, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/9a5b043c/uploads/origins/d6faad5e-c445-4b22-ab08-72affa7a3762?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=48d802b6900857e94de823b4bace7444", "srcset": "https://si.imgix.net/9a5b043c/uploads/origins/d6faad5e-c445-4b22-ab08-72affa7a3762?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=48d802b6900857e94de823b4bace7444, https://si.imgix.net/9a5b043c/uploads/origins/d6faad5e-c445-4b22-ab08-72affa7a3762?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e51b79cb02015c82d8b57d50bad61a0a 2x, https://si.imgix.net/9a5b043c/uploads/origins/d6faad5e-c445-4b22-ab08-72affa7a3762?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=6a0c437997f99284eb1047c6dfbd948f 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/9a5b043c/uploads/origins/d6faad5e-c445-4b22-ab08-72affa7a3762?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=4ea8c5d0eedd7f9328c45f6efd221ceb", "srcset": "https://si.imgix.net/9a5b043c/uploads/origins/d6faad5e-c445-4b22-ab08-72affa7a3762?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=4ea8c5d0eedd7f9328c45f6efd221ceb, https://si.imgix.net/9a5b043c/uploads/origins/d6faad5e-c445-4b22-ab08-72affa7a3762?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=f9ed199a018e494a753745439592810b 2x, https://si.imgix.net/9a5b043c/uploads/origins/d6faad5e-c445-4b22-ab08-72affa7a3762?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=7c3bea4f57e5ab5bde409e8cb5690a78 3x"}, "body": "こんにちは。いつもお世話になっています。\n今回もイラストの依頼をさせて頂きます。\n\n【依頼内容】\n・堂建進のラフな姿\n・ラフにしてる時の髪型はコレ！がなければハーフアップになっていたら嬉しいです\n・服装はシャツで腕まくりをしていたらいいなと思っていますが、全然ジャージとかでも嬉しかったりします。お好みでどうぞ！\n\n堂建のラフな姿や一面を見たいだけなので、何をしてるかの背景シチュエ ーションはお好みでお任せします。\nもしシチュエーション説明があればpsdのラフ内等に記載があれば幸いです。\n\n【希望サイズ】\n\n1番描きやすいサイズで構いません!比率も縦長、横長も特に考えていないのでお好みでお願いします。\n\n【用途】\n\n待ち受け\n個人的に印刷してフォトフレームで飾る等", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@EgoMixer/works/51", "private_thumbnail_image_urls": null, "priv