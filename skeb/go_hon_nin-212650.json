200&h=200&blur=200&s=47e946e15612007781ffa32b57abd526 3x"}, "body": "いつも楽しく拝見させて貰っています！\n早速ですが初雪のおと…ゲフンゲフン\n天霧くんが浜波♂沖波♂に徹底的に犯されメス落ちする様を見てみたいのです！\n天霧が元々好きなのですがまさかそういう出し方をするとは思わず\nその後のおと…天霧くんが二人によって落とされたりして慣れていく様を見る度に\nもっと！もっと弟くんが快楽に溺れていくえっちな所を見たい！！！！と思いまして…\n\nご本人さんももっちーが好きなのでもっちーも頼みたかったのですが\nそれよりも天霧くんの見たさが勝ってしまった…すまんもっちー…\n話が長くなってしまいましたが改めて\n\n天霧くん総受けホモセメス落ち\n相手は浜波と沖波…と言いたいのですが依頼額に対して3人はちょっと…となった場合はどちらか一人で構いません\n構図や服装、シチュエーションや場所についてもご本人さんにお任せします\n長くなってしまいましたがもしピンと来たらよろしくお願い致します", "nc": 57, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@go_hon_nin/works/2", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/63150ccc/uploads/origins/46374aa9-d7ae-4a33-a073-87cdc6c3cca7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=f14456af8ab4c1d672b66cc20bbcd64a", "srcset": "https://si.imgix.net/63150ccc/uploads/origins/46374aa9-d7ae-4a33-a073-87cdc6c3cca7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=f14456af8ab4c1d672b66cc20bbcd64a, https://si.imgix.net/63150ccc/uploads/origins/46374aa9-d7ae-4a33-a073-87cdc6c3cca7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=5dd5a793983af7e798fbd53447531d6d 2x, https://si.imgix.net/63150ccc/uploads/origins/46374aa9-d7ae-4a33-a073-87cdc6c3cca7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=a93988de51cadd64a74eb6f8355c95f7 3x"}, "private": true, "genre": "art", "tipped": false, "creator_id": 573072, "nc": 160}, {"path": "/@go_hon_nin/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 573072, "client_id": 534047, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/f1f46c5a/requests/127346_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8444ac81d92e000a2d7243afe32e0f8d", "srcset": "https://si.imgix.net/f1f46c5a/requests/127346_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8444ac81d92e000a2d7243afe32e0f8d, https://si.imgix.net/f1f46c5a/requests/127346_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=2454929b780339abec9dc31c3e4ce9f1 2x, https://si.imgix.net/f1f46c5a/requests/127346_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=9eaf8c72feb93754276e53b514659fec 3x"}, "duration": null, "nsfw": true, "hardcore": true, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/f1f46c5a/requests/127346_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=96e79c4adab13aac5ba7a35dfc99ab73", "srcset": "https://si.imgix.net/f1f46c5a/requests/127346_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=96e79c4adab13aac5ba7a35dfc99ab73, https://si.imgix.net/f1f46c5a/requests/127346_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=92b29fdccc8aed12978cecc4473b7dad 2x, https://si.imgix.net/f1f46c5a/requests/127346_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=9d38b5e788fd3041c0e924c92029b0b9 3x"}, "body": "カラー絵\nキャラクターオプション：\nダンまちのリリルカ・アーデ \n聖剣伝説3のアンジェラorリース\n食戟のソーマの田所恵（小さい胸）\nテイルズ オブ ヴェスペリアのリタ・モルディオ（小さい胸）\nワーキングの山田葵（小さい胸）\nけいおんの中野梓（小さい胸）\n（あなたが最も快適/自信のあるキャラクターを選択してください。上記のオプションが不可能な場合は、霧雨魔理沙を描くことができ）\n\n状況オプション：\n1. 産卵\n2. 触手\n3. 輪姦\n状況の好みは1（最も好ましい）から3（最も好ましくない）\n\n物語と対話と差分を含む\n\nCG集のように似たタイプの対話を行ってください（状況を説明する黒い文字、女の子の対話用のピンクの文字、男の対話用の青いの文字など）\n女の子の多くの対話。セックスしながら話をする女の子が好き\n\n私はアヘ顔が好きです。アヘ顔とハードファックをできるだけ含む\n\nできるだけ多くの差分を含む（可能であれば、少なくとも2差分とアヘ顔）\nラスト差分に含める：ダブルピースアヘ顔、笑顔、舌を出す\n\n続き（つづく）を書く想いで書いて。もしよろしければ、将来もこのリクエストの継続をお願いするかもしれません\n\n差分と文字/会話のレイヤーを分離したPSDを提供してください\n\n形式の参照：https://skeb.jp/works/103107", "nc": 43, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 50736, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "踊るロンドン🔞定期更新中", "screen_name": "odoru_london", "avatar_url": "https://pbs.twimg.com/profile_images/1570848348248346626/06LAH9AQ.jpg", "header_url": "https://pbs.twimg.com/profile_banners/972793398598844416/1664573483/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 120, "skills": [{"genre": "art"}], "nc": 56}, {"id": 374417, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "ナギスケ🎨skeb受付中", "screen_name": "Grin_Nagi38", "avatar_url": "https://pbs.twimg.com/profile_images/1609543767694147592/Qh3_fQ5v.jpg", "header_url": "https://pbs.twimg.com/profile_banners/391071141/1631354551/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "art"}], "nc": 48}, {"id": 451743, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "業禍out(ｺｯｼｮﾘ)", "screen_name": "goukaout", "avatar_url": "https://pbs.twimg.com/profile_images/1654854218518532097/mzSUujSa.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1085591629816156162/1613987690/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre":