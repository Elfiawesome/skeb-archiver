入れてもらい、カラーとして描いてもらえると嬉しいです。他はモノクロで構いません。\n可能でしたら絵柄は紋章1部の顔グラのような系統でお願いしたいです。\n\n補足として、(10)、(11)の部分をイメージしたものをVカツを利用して作成しましたので、ご覧ください。\nhttps://f.easyuploader.app/eu-prd/upload/20200704190001_54455a474e4e4b6c5856.jpg\n\n(10)は、ほぼそのままのポーズでお願いします。\n(11)は大体の向きをイメージしたものです。より魅力的と思われるポーズで描いてください。\nエロさ加減はお任せします。\n\n\n文字数制限で無骨な依頼文となり申し訳ないです。よろしくお願いいたします。", "nc": 32, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@omizu_knsn/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 114416, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/9695c728/requests/109899_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=88a4cc4206eac8eb42d1e1f4b8ba639c", "srcset": "https://si.imgix.net/9695c728/requests/109899_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=88a4cc4206eac8eb42d1e1f4b8ba639c, https://si.imgix.net/9695c728/requests/109899_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=bd7e5e6f2ff71bb114bba1a38d64e9e6 2x, https://si.imgix.net/9695c728/requests/109899_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=3e35fc0df8874820bd51087a759812b1 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/9695c728/requests/109899_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=17303c2444fbe729f13c56852c3a0e2a", "srcset": "https://si.imgix.net/9695c728/requests/109899_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=17303c2444fbe729f13c56852c3a0e2a, https://si.imgix.net/9695c728/requests/109899_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=0bea3552d6b750965f0ee8052dd9218c 2x, https://si.imgix.net/9695c728/requests/109899_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top