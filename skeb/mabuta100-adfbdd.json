。\n\nこの画像はyoutubeのサムネイルとして使用されますが、あなたがこの依頼を受け入れることを決定した場合、私はあなたにクレジットを与えるでしょう。読んでくれてありがとうございます、そして私はあなたが良い一日を過ごすことを願っています。", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 398613, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "九々丸さくまる", "screen_name": "souSakumaru", "avatar_url": "https://pbs.twimg.com/profile_images/1974390708284092417/LDp7uZeJ.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1496059601568993281/1646138040/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "art"}, {"genre": "comic"}, {"genre": "novel"}, {"genre": "correction"}], "nc": 128}, {"id": 694698, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "あまひこ", "screen_name": "hiko_amama", "avatar_url": "https://pbs.twimg.com/profile_images/2010944005174149121/NZyTZUJ4.jpg", "header_url": "https://pbs.twimg.com/profile_banners/396067875/1769876681/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "art"}, {"genre": "comic"}], "nc": 33}, {"id": 1781321, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "和三盆", "screen_name": "OBOCHAMANBOO", "avatar_url": "https://proxy.misskeyusercontent.jp/avatar.webp?url=https%3A%2F%2Fmedia.misskeyusercontent.jp%2Fio%2Fwebpublic-3786a929-8e4a-48be-96b2-836e8956e41a.png&avatar=1", "header_url": null, "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 2, "co