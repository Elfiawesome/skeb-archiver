6738577cf?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=4008d49eff833b251ff999128cacda82, https://si.imgix.net/eb751278/uploads/origins/f2fb1e38-032c-4ad1-bbd3-60b6738577cf?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=f1ce5b2640ee0fca743454529117e042 2x, https://si.imgix.net/eb751278/uploads/origins/f2fb1e38-032c-4ad1-bbd3-60b6738577cf?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=435fe5bc10031a67bbf5452f6d241b5d 3x"}, "body": "お疲れ様です！兵隊ゾンビのイラストでは度々お世話になりました！\n\nイラストの雰囲気、感染の様子、ゾンビのデザインがとても良かったので、バイオハザード発生時に帝国陸軍の兵士たちが苦しみながら感染して仮死状態に陥るイラストを描いていただけないでしょうか。\n\n陸軍兵士は帽子垂れの者を多めに、ヘルメットや感染後に帽子が脱げた坊主頭の者も少しいると嬉しいです！\n人数は描ける範囲で決めて構いません。\n顔のデザインもさばのすけさんの好きに描いて大丈夫です！\n\n・生物兵器爆弾が爆発したことでウイルスガスが雪崩のように兵隊のところまで迫り、ガスから必死に逃げている。顔は恐怖で引き攣っている。場所は戦地、拓けた場所かジャングルのような森の中イメージ。\n\n・追いつかれたガスに呑まれウイルスに身体を侵されて苦しむ。咳き込む者、呼吸できなくてえずく者、思わず首元を手で抑える者、地面をのたうち回る者、倒れて痙攣する者、救いを求めるように宙に手を伸ばす者、など様々な動きで苦悶を表している。身体の変異の影響か、血管が浮き上がり、口から涎か泡が溢れ、汗が流れている。イラストのメイン1。\n\n・ゾンビとして活動する前の仮死状態。苦悶で歪んだ顔、虚ろな顔をしている。目は光が無く瞳孔は開いている。目元は涙が溜まっていたり流れた痕がある。口からは涎か泡が溢れている。一部の人は舌もはみ出ている。\n余裕があればで背景の一部でも構いませんので色々な倒れ方をする兵士も描いてほしいです。イラストのメイン2。\n\n人口密度が増えそうなうえ似たり寄ったりのテーマばかりで恐れ多くありますが、ご検討よろしくお願いします！", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@kuv_0/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3475619, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/f9e92858/uploads/origins/aee54a28-3736-4442-a467-95f3d71ff98c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ef4af9a4f3e5b07269b294e080e330a2", "srcset": "https://si.imgix.net/f9e92858/uploads/origins/aee54a28-3736-4442-a467-95f3d71ff98c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ef4af9a4f3e5b07269b294e080e330a2, https://si.imgix.net/f9e92858/uploads/origins/aee54a28-3736-4442-a467-95f3d71ff98c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ab3b8ae4d6267d2ca037df70f544acef 2x, https://si.imgix.net/f9e92858/uploads/origins/aee54a28-3736-4442-a467-95f3d71ff98c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=8e47da33233c55ee5dd1485cbc031ebf 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/f9e92858/uploads/origins/aee54a28-3736-4442-a467-95f3d71ff98c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=56cfad18aba7fa94fc47fc51dda6d82f", "srcset": "https://si.imgix.net/f9e92858/uploads/origins/aee54a28-3736-4442-a467-95f3d71ff98c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=56cfad18aba7fa94fc47fc51dda6d82f, https://si.imgix.net/f9e92858/uploads/origins/aee54a28-3736-4442-a467-95f3d71ff98c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=7e84f479c89da4f8fc133ee800560c69 2x, https://si.imgix.net/f9e92858/uploads/origins/aee54a28-3736-4442-a467-95f3d71ff98c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=43a2d9c61b609a29fdf553e9165ac14c 3x"}, "body": "お疲れ様です！陸軍兵士ゾンビのイラストでは大変お世話になりました！\nもし可能でしたら、帝国海軍風の水兵がゾンビになるイラストもお願いできますでしょうか？\n\n白を基調にした大日本帝国海軍風の制服と軍帽のセットで顔はさばのすけさんにお任せします！\n\n設定として、生物兵器のガスを吸った人間が自軍の戦艦に乗船、あるいは一部の乗組員が回収した生物兵器から漏洩したウイルスガスを吸ったことで、感染が広がり艦内でバイオハザードが発生したという背景です。\n前回同様、ゾンビの特徴として、死者と同じく瞳孔が開いた目、血の気を失った肌、自我は崩壊して知能低下とエネルギー不足状態から生存する人間を本能的に捕食しようとします。\n\nガスを吸って苦しむ者は、襟元か喉元を抑えている、痙攣するように床をのたうち回る、涎を垂らしながらえずく姿を、感染してゾンビに成り果てた者は、基本的に前回と同じく死者のような目と肌でゆらりと立つ姿か徘徊する姿を描いてください！\n\n感染直後の血管が浮き出て汗だくの様子やゾンビ化して涎が溢れる様子もぜひお願いします！", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@kuv_0/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3475619, "vtt_url": null, "thumbnail_imag