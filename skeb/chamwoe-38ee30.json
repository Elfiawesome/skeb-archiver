dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=f2ea4745d4d60bf9377e91156e68276a 2x, https://si.imgix.net/fbcbc134/uploads/origins/1d0cac5c-37da-42e7-9298-15ef3967a901?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=1b6c59ad4475dd3074899f77f247b2e0 3x"}, "body": "にどさん、こんばんは！橘子（たちばな）です！\nSkebのリクエストを受け付けていらっしゃるのを拝見して、さっそく伺いました！\n\n以下のリンクは私の自創作キャラになります。\nぜひぜひ、彼女を描いていただけたら嬉しいです…！\nとても楽しみにしています🥺🥺\nhttps://drive.google.com/drive/folders/1vZTNgahqOgL4Ir9jyWlY7kTcohcl_zJa", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@chamwoe/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3166468, "client_id": 2764967, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/064d7e58/uploads/origins/a514fda9-8950-4da5-8cd3-e9a208541c32?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a8e8e9ab05b566e917d685e2ee1c92ea", "srcset": "https://si.imgix.net/064d7e58/uploads/origins/a514fda9-8950-4da5-8cd3-e9a208541c32?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a8e8e9ab05b566e917d685e2ee1c92ea, https://si.imgix.net/064d7e58/uploads/origins/a514fda9-8950-4da5-8cd3-e9a208541c32?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e9a9118cbcd53bc3daf2d26c3cc8baf1 2x, https://si.imgix.net/064d7e58/uploads/origins/a514fda9-8950-4da5-8cd3-e9a208541c32?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=7b95bc63e5ffd9fb3484f5e1b5214b1a 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/064d7e58/uploads/origins/a514fda9-8950-4da5-8cd3-e9a208541c32?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d7014a5b5e18ca89771f69586efe9a90", "srcset": "https://si.imgix.net/064d7e58/uploads/origins/a514fda9-8950-4da5-8cd3-e9a208541c32?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d7014a5b5e18ca89771f69586efe9a90, https://si.imgix.net/064d7e58/uploads/origins/a514fda9-8950-4da5-8cd3-e9a208541c32?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=a03b95f59a3987b32cf2bc222c9235ad 2x, https://si.imgix.net/064d7e58/uploads/origins/a514fda9-8950-4da5-8cd3-e9a208541c32?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=2bbefad84c8d59f98bd9b65994819f00 3x"}, "body": "初めまして。オボロゲ寧と申します。おぼつかドニーさんの描く線画や表情やキャラ同士の関係性の表現が大好きで依頼に参りました。\n\n【内容】\nTRPGキャラ同士のコミック。\n〝兄弟として執着〟しているリュウくんと〝恋愛,一人の人として執着〟しているシキの雰囲気漫画を希望します。\n\n◆ 空無　色\nCS\nhttps://iachara.com/view/2216584\n\n◆ 垂水 柳\nCS\nhttps://charasheet.vampire-blood.net/m708bfa07dcf4470a97488c66df83e466\n\n◆見た目や絡み（ドロップボックス）\nhttps://www.dropbox.com/scl/fo/erzjut4195cc8j1wih2st/AIlRWjjpxJxoQA5v_lnQawk?rlkey=y1ntibuacgavfr5m2jx2kmk1k&st=wj6l7jf9&dl=0\n\n◆設定等\n孤児院育ちの義兄弟。一度それぞれが引き取られバラバラになったが、再度シキが収集したことで自分合わせ6人の義兄弟が集まり、表面はクラブ経営、裏では始末屋を行なっている。舞台は大阪。二人は関西弁。\n互いに当たりは強め。\n\n現在、胸のうちを話し、表面今まで通りの兄弟をしているが互いにそれぞれの執着心が上がっている。ただ中身が兄弟愛と恋愛でいざこざしてる感じになります。\n\n◆構図等内容等全てお任せいたします！！おぼつかドニーさん節だと嬉しいです！描きやすいように細々変えていただいても構いません。\nコミックが難しければイラスト変更でも構いません。よろしくお願いいたします。\n\n【使用用途】\n・PCやスマホの背景\n・ヘッダー\n・友人への自慢\n・ポスターなど", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@chamwoe/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3166468, "client_id": 3251801, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/37fef508/uploads/origins/9484433d-e728-427d-8066-96104b3d0ffb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fb82d035f6a71f9571968c2293dce107", "srcset": "https://si.imgix.net/37fef508/uploads/origins/9484433d-e728-427d-8066-96104b3d0ffb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fb82d035f6a71f9571968c2293dce107, https://si.imgix.net/37fef508/uploads/origins/9484433d-e728-427d-8066-96104b3d0ffb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=15635a8ec614d492e984c48f2a6c36cc 2x, https://si.imgix.net/37fef508/uploads/origins/9484433d-e728-427d-8066-96104b3d0ffb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ec6cfaeada946352a950ade808da19b2 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/37fef508/uploads/origins/9484433d-e728-427d-8066-96104b3d0ffb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=88813c832a0de7d78a4b35369a769864", "srcset": "https://si.imgix.net/37fef508/uploads/origins/9484433d-e728-427d-8066-96104b3d0ffb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=88813c832a0de7d78a4b35369a769864, https://si.imgix.net/37fef508/uploads/origins/9484433d-e728-427d-8066-96104b3d0ffb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=99501a37a084105741d475f3c06d2f37 2x, https://si.imgix.net/37fef508/uploads/origins/9484433d-e728-427d-8066-96104b3d0ffb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=41ebf6ba578c12360036197f065b7a21 3x"}, "body": "おぼつかドニーさん、はじめまして。とみたと申します。\nおぼつかドニーさんの描く柔らかそうな髪の毛や男性の色っぽい目元が大好きで、私のTRPGの創作キャラを描いていただきたく依頼をさせていただきました。\n\n十二星座の『魚座』がモチーフのキャラクターとなっております。\n\n【基本情報】\n年齢は45歳、男性、189cm、細身の体型。髪は気分で染めるタイプ。\nお仕事は図書館司書の合間に探偵業をしています。\n生粋のアメリカ人なのですが、日本の文化に興味を持ち探偵の仕事をする時は和服（着物と袴）を着ています。\n\n【キャラクターの性格】\nおおらか、純粋、世間知らず、マイペース、真面目、我慢強い、自分に自信がない、本音を言うのが苦手、寂しがりや、大雑把、鈍感\n\n【キャラにまつわるエピソード】\n・物心つく前に母は病で亡くなり、父子家庭で育った。\n・父も、20歳になった頃に交通事故で亡くなっている。\n・「手のかからない子供」を父の前では演じていたため、愛情不足な子供時代を過ごす。\n・45歳になったころ、自分の寂しさに気づいてくれた女性（18歳年下）がいて、不器用ながらに告白をした。\n・告白をしてから2年経った頃、その女性からお返事をいただきお付き合いをはじめた。\n\n\n容姿についてはURL（Googleドライブ）に添付しております。\n\n構図や雰囲気については、おまかせにさせて頂きたいです。\n金額が足りない場合は遠慮なく変更してください。\n\nご検討のほどよろしくお願い致します。\n\nhttps://drive.google.com/drive/folders/1sx_1rn1PQmbn7r8vMWfGUlTBkBgq7l_V?usp=sharing", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@chamwoe/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3166468, "client_id": 2337083, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/9d2ff8c6/uploads/origins/7f1a12e9-06ed-421f-b853-dbd0f62832fb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6f14abab5a55fc350911200ec7e99047", "srcset": "https://si.imgix.net/9d2ff8c6/uploads/origins/7f1a12e9-06ed-421f-b853-dbd0f62832fb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6f14abab5a55fc350911200ec7e99047, https://si.imgix.net/9d2ff8c6/uploads/origins/7f1a12e9-06ed-421f-b853-dbd0f62832fb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a70e9928a4fee1b03edece33354e9dc1 2x, https://si.imgix.net/9d2ff8c6/uploads/origins/7f1a12e9-06ed-421f-b853-dbd0f62832fb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=26f3cae22f99fcf9d99eca3c5cbc1726 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/9d2ff8c6/uploads/origins/7f1a12e9-06ed-421f-b853-dbd0f62832fb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f4297f082f9a361fba2dc7b482978d24", "srcset": "https://si.imgix.net/9d2ff8c6/uploads/origins/7f1a12e9-06ed-421f-b853-dbd0f62832fb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f4297f082f9a361fba2dc7b482978d24, https://si.imgix.net/9d2ff8c6/uploads/origins/7f1a12e9-06ed-421f-b853-dbd0f62832fb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=22109d32f25836f5775d55aef5686587 2x, https://si.imgix.net/9d2ff8c6/uploads/origins/7f1a12e9-06ed-421f-b853-dbd0f62832fb?bg=%23fff&auto=format