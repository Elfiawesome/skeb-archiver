じます。\n『シチュエーション（？）』先生の描かれたホムラVSタブーの作品が私の心に直撃しましたので、「ディズィーが拘束され凌辱され、最終的に尻子玉を抜かれて破壊され廃人のようになる」ような作品を制作していただく事は可能でしょうか。\n『備考』ディズィーの戦闘服は最新ではなく、イグゼクスの頃のボンデージが個人的な好みですので検討いただけると助かります。\n\n私にはセンスがありませんので構図やシチュエーション、および言及不足や不明な点は全て咲珠しろ先生の御判断にお任せ致します。\n年末年始のお忙しい所に大変ご迷惑おかけしますがご検討いただければ幸いです。", "nc": 43, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@shichimiyabi/works/14", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2481768, "client_id": 605317, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/bcf58761/uploads/origins/6a9284b6-78a8-4145-8de0-80e938757fbc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8373e14ceef9f04c3a3e1326d4468fa1", "srcset": "https://si.imgix.net/bcf58761/uploads/origins/6a9284b6-78a8-4145-8de0-80e938757fbc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8373e14ceef9f04c3a3e1326d4468fa1, https://si.imgix.net/bcf58761/uploads/origins/6a9284b6-78a8-4145-8de0-80e938757fbc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=8d9fc344b2aa4404b7e7b49bd01fe79c 2x, https://si.imgix.net/bcf58761/uploads/origins/6a9284b6-78a8-4145-8de0-80e938757fbc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=6025ddb44168f84767dec7f1dfcb5545 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/bcf58761/uploads/origins/6a9284b6-78a8-4145-8de0-80e938757fbc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f5d44cbe8c24981bc748f244c17f9e71", "srcset": "https://si.imgix.net/bcf58761/uploads/origins/6a9284b6-78a8-4145-8de0-80e938757fbc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f5d44cbe8c24981bc748f244c17f9e71, https://si.imgix.net/bcf58761/uploads/origins/6a9284b6-78a8-4145-8de0-80e938757fbc?bg=%23fff&auto=format%2Ccompres