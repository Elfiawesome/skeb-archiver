p&fit=crop&crop=top&w=200&h=200&s=db9c9c520fdf5fe78dd8d6f07fba770f, https://si.imgix.net/3b91d687/uploads/origins/379ded83-523b-4af9-9fd7-2037f6a859e9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=316bbd8f9789f4a86482d82389c47409 2x, https://si.imgix.net/3b91d687/uploads/origins/379ded83-523b-4af9-9fd7-2037f6a859e9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e822dd7b5576bdacaaa6ae74e176132e 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/3b91d687/uploads/origins/379ded83-523b-4af9-9fd7-2037f6a859e9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=308f9ce9900b48986a28deb078ae26c8", "srcset": "https://si.imgix.net/3b91d687/uploads/origins/379ded83-523b-4af9-9fd7-2037f6a859e9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=308f9ce9900b48986a28deb078ae26c8, https://si.imgix.net/3b91d687/uploads/origins/379ded83-523b-4af9-9fd7-2037f6a859e9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=c99f5c8eb577d53321dad9049694232a 2x, https://si.imgix.net/3b91d687/uploads/origins/379ded83-523b-4af9-9fd7-2037f6a859e9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=626c2d87b3af90e218cd531ff49d6697 3x"}, "body": "はじめまして、先生!!!先生の画風が好きです!!!イラストをお願いしてもよろしいでしょうか？キャラクターは、堕天使の美男子です。  普段は穏やかそうですが、怒りに満ち溢れています。ダークな雰囲気でお願いします。羽が見えていて、剣を振り回しているような構図が希望です。\n\nテーマ（入れてもいいもの）：月、死、堕天使、黒い羽、怒り、血。\n\nテキストはPSDの別レイヤーにON/OFFできるように入れてください。\n\n私の要望を考慮していただき、本当にありがとうございました!!!(機械翻訳で全く失礼がなかったら大変申し訳ございません)\n\nhttps://imgur.com/a/loONsD3", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@kogami/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 14436, "client_id": 706929, "vtt_url": null, "thumbnail_image_urls": {"src"