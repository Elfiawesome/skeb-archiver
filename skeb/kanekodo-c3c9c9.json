と嬉しいです！\n\n【概念】\n桜の花びら、星あるいは石、白紙の進路希望調査票、逃避、穏やかな生活、追いつかない心/精神……など\n\n上記のどれかが参考になれば幸いです！\nまた、桜の花びらを採用する場合は赤色以外だと嬉しいです……！\n\n\n【使用用途】\nSNSへの掲載、友人間での鑑賞\n\n\n【資料】\nhttps://drive.google.com/drive/folders/1m-25EQjDfUpYBoz_vk7G3rc6eLwqZPsh?usp=drive_link\n\n資料に登場する兄や設定は友人との共同創作のものです。\nリクエストに関して友人から許可が出ておりますが、問題がございましたらキャンセルしていただいても構いません。\n\nその他に内容に不備などございましたらお手数ですが再送いただけますと幸いです。", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@kanekodo/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3687061, "client_id": 3753936, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/94115963/uploads/origins/fabbf0f7-9236-436c-84d7-80e5e5cb5066?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0229ca2cd43fefed86ec85cf97af2ec8", "srcset": "https://si.imgix.net/94115963/uploads/origins/fabbf0f7-9236-436c-84d7-80e5e5cb5066?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0229ca2cd43fefed86ec85cf97af2ec8, https://si.imgix.net/94115963/uploads/origins/fabbf0f7-9236-436c-84d7-80e5e5cb5066?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=4de59b645e56ff898ef954a2d5267c68 2x, https://si.imgix.net/94115963/uploads/origins/fabbf0f7-9236-436c-84d7-80e5e5cb5066?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=df89fb38e5c3d9b4f78e440ad23e744c 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/94115963/uploads/origins/fabbf0f7-9236-436c-84d7-80e5e5cb5066?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f013be6adf22e05b83f4da3680939ae4", "srcset": "https://si.imgix.net/94115963/uploads/origins/fabbf0f7-9236-436c-84d7-80e5e5cb5066?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f013be6adf22e05b83f4da3680939ae4, https://si.imgix.net