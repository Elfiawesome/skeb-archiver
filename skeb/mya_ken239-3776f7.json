60}, {"path": "/@mya_ken239/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2231887, "client_id": 71755, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/61131251/uploads/origins/ab83e80f-0f2b-4a10-8f98-0ca345de12e7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8001a98e73c96dd86488cb69c3a742a9", "srcset": "https://si.imgix.net/61131251/uploads/origins/ab83e80f-0f2b-4a10-8f98-0ca345de12e7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8001a98e73c96dd86488cb69c3a742a9, https://si.imgix.net/61131251/uploads/origins/ab83e80f-0f2b-4a10-8f98-0ca345de12e7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=8109d6ed0414c0110d6ebdbd78b99321 2x, https://si.imgix.net/61131251/uploads/origins/ab83e80f-0f2b-4a10-8f98-0ca345de12e7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c338de57dca1ceaf7a5723afc8fca81a 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/61131251/uploads/origins/ab83e80f-0f2b-4a10-8f98-0ca345de12e7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d7d135fcbc5ac0ea2aeff1f63aac5101", "srcset": "https://si.imgix.net/61131251/uploads/origins/ab83e80f-0f2b-4a10-8f98-0ca345de12e7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d7d135fcbc5ac0ea2aeff1f63aac5101, https://si.imgix.net/61131251/uploads/origins/ab83e80f-0f2b-4a10-8f98-0ca345de12e7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=eed3fb4cbe60ec2f4051637b48cd335c 2x, https://si.imgix.net/61131251/uploads/origins/ab83e80f-0f2b-4a10-8f98-0ca345de12e7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=9fe1e710952ac167fde854a6fb8368b7 3x"}, "body": "女の子が可愛かったので可能な範囲でお願いします！\n書くかも程度ですがドM小説の挿絵に利用したいです\n\n作品名：黒の召喚士\nキャラ名：エフィル&アンジェ\nシチュ：\nスライムに寄生・苗床にされた着衣超乳&着衣ボテ腹姿の二人に嫌悪・侮蔑されながら、二人がそれぞれ持っているスライム満タンの巨大注射器を見せつけられるドMホイホイシチュ。\n二人ともゴミを見るような冷めた目(顔の上部や目元まで影がかかる感じでハイライトなし)で、\n変態マゾへの嫌悪を一切隠すことない侮蔑の表情を希望します\n\n注射器内は高粘度の半透明スライム(エフィルは服の色に近い紫色・アンジェは服の色に近い緑色)で充填されており、注射器の先端からスライムが溢れている他、\n二人それぞれも耳の中やスカートの下からスライムが零れている寄生・洗脳要素を加えて頂ければ幸いです。\nまた背景は二色の半透明スライムに満たされた感じか、それが難しいようでしたら単色やグラデーションでも構いませんのでダーク系背景にして頂ければ幸いです。\n\n二人とも手が簡単に沈む程で上半身以上のサイズかつ服越しの勃起乳首がわかる感じの着衣超乳&特大着衣ボテ腹で、\n服に関しては超乳とボテ腹がギチギチに詰められたようなボテ腹用に調整して頂いて構いませんので、肌は服で隠れてしまっている完全着衣状態でお願いします。\nまた着衣ボテ腹内部は粘液まみれの大量のスライムを孕んだようなイメージで、下腹部に怪しく光る淫紋の描写を希望します。\nまたこちらは可能ならで構いませんが乳首の位置から母乳代わりにスライムが服越しに溢れているような描写が予算的に可能でしたらお願いします(優先度低で無視OK)。\n\nまた可能でしたらpsd形式でON/OFFで切り替えられる形式で、二人の瞳のハイライトの有無、二人の顔上部に掛かる影の有無、\n注射器内で蠢くスライムの水音やスカート下から零れているスライムが蠢く効果音の有無差分を入れて頂ければ幸いです。\n\nまた原作無視でいいのでON/OFF可能な感じでスライムに寄生された二人の姿に興奮し、あまつさえ自分も二人の手でスライム専用マゾ苗床に改造されそうなのに\n勃起するような変態マゾ男への二人の嫌悪・侮蔑・罵倒の台詞が可能そうであればお願い致します。無しでも全然かまいません。\n\n可能な範囲でよろしくお願いします\n\nキャラ、シチュ参考\n\nhttps://imgur.com/a/SwzV3ql", "nc": 184, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 42471, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "🔞かやまゆきひろ@skeb募集中", "screen_name": "Kayamayukihiro", "avatar_url": "https://pbs.twimg.com/profile_images/1441837674315141125/BnDshU8n.jpg", "header_url": "https://pbs.twimg.com/profile_banners/4846321999/1617134159/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 90, "skills": [{"genre": "art"}], "banned": false, "nc": 160}, {"id": 127392, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "ガニメデSkeb5件作業中(手一杯気味)", "screen_name": "ganimedevyt", "avatar_url": "https://pbs.twimg.com/profile_images/1112720426981982210/bDi57ldh.png", "header_url": "https://pbs.twimg.com/profile_banners/96