ult_amount": 500}], "acceptable_only_public": false, "tip_acceptable": true, "yearly_report_client_visible": false, "total_appeals_count": 0, "received_works": [{"path": "/@MOR30209564/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1392006, "client_id": 2938160, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/6548e414/uploads/origins/7f091b00-d6eb-4ee8-be8d-c6c935f50344?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c9ba5a79b80ba1bf03f25da608810115", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/6548e414/uploads/origins/7f091b00-d6eb-4ee8-be8d-c6c935f50344?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=8232b2ef96f307934f48883e5c302a06", "src_set": ""}, "body": "こんにちは、今回も素晴らしい作品をありがとう。\n\nもしよろしければ、またアーキタイプ・アース・サード・アセンションとグダオの依頼をお願いしたいのですが。\n\nアニバーサリー衣装のA.E。ロイヤルブランドのミスティックコードを着たぐだお。\n\n今回のアイデアは、雨が降っていて、片手にアンブレラを持っているぐだおがベンチに座っている。もう片方の手はA.E.に握られている。\n\nもしよろしければ、よろしくお願いします。", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@MOR30209564/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "comic", "tipped": false, "creator_id": 1392006, "client_id": 2938160, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/f3dd6956/uploads/origins/a568ce83-d3bf-4d63-ac37-a2b8e430dfbc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4a504e186deae19c690c0f42bff1566d", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/f3dd6956/uploads/origins/a568ce83-d3bf-4d63-ac37-a2b8e430dfbc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=00b66d7fea2767125ca33951d350694a", "src_set": ""}, "body": "また会ったね。\n\nもしよろしければ、A.E.ファースト・アセンションとA.E.サード・アセンションでの再依頼をお願いしたいのですが。\n\n衣装は、A.E.3回目のアセンションは10周年記念の衣装で、ぐだおはアニバーサリーの金髪ミスティックコーデでお願いします。\n\nでも、彼らが何をしているかは、正直なところ、完全にあなた次第です。ただ、健全で楽しいものを。もしそれに合うようなアイデアがあれば、他のキャラクターを追加することは大歓迎だけど、今回は自由にやっていいよ。\n\nもし引き受けてくれるなら、ありがとう。", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@MOR30209564/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1392006, "client_id": 2938160, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/cd119e80/uploads/origins/10ca33df-b460-4de9-9c19-92a11344ef01?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=952a1dfb47872e147973f7817761153f", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/cd119e80/uploads/origins/10ca33df-b460-4de9-9c19-92a11344ef01?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=267bec898d40831b945aaea32c40bb06", "src_set": ""}, "body": "また会ったね。\n\nもしよろしければ、A.E(ファーストアセンション)とグダオとハロウィンのロイヤルティのミスティックコードで、またコミッションをお願いしたいです。\n\n\n千年王城の外で、A.EがGudaoの肩にもたれかかり、手をつないで一緒に座っているというものです。\n空を見上げている。\n\nもし、あなたがこのコミットメントを受け入れてくれるなら、それはとてもありがたいことだ。", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@MOR30209564/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1392006, "client_id": 2938160, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/7cd7aa8b/uploads/origins/e104e5d2-d237-4dc5-acb0-f540db754d07?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5ef5ecb87c6d612ccf15b26c3305e82b", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/7cd7aa8b/uploads/origins/e104e5d2-d237-4dc5-acb0-f540db754d07?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&cro