0&h=200&blur=200&s=bf721ddc670021faf45af6a20957dbde 3x"}, "body": "ふるーつふるきゅーと！のルカムがセーラースターズで登場するスターシードを胸の前に出現させているイラストをお願いします\nスターシードは資料のような胸元に咲く金色の花の上に輝く結晶が現れる形で現れ、ルカムの場合は赤い結晶で、ルカムは現れた結晶を興味深く見つめています\n納品形式はPSDでスターシードの部分はレイヤー分けをお願いします\nよろしくお願いします\n\n・資料\nhttps://fruitsfulcute.wikiru.jp/index.php?%E3%83%AB%E3%82%AB%E3%83%A0\n\nhttps://i.gyazo.com/cc50132bcc82625f77a4c87986a69764.jpg\nhttps://i.gyazo.com/2c276b6796f04efb101b08180fbfece7.gif", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@kyoya225/works/9", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2852124, "client_id": 706365, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/b9f78575/uploads/origins/f863c69d-a0d7-43f8-b6af-318e5b964e21?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f34a4a82763853599dce57281fcc12da", "srcset": "https://si.imgix.net/b9f78575/uploads/origins/f863c69d-a0d7-43f8-b6af-318e5b964e21?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f34a4a82763853599dce57281fcc12da, https://si.imgix.net/b9f78575/uploads/origins/f863c69d-a0d7-43f8-b6af-318e5b964e21?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=9e5b98b0d8b20b19a7cd89a737fb4305 2x, https://si.imgix.net/b9f78575/uploads/origins/f863c69d-a0d7-43f8-b6af-318e5b964e21?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c3f95196b0c58d532dac6bdd6de93f1c 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/b9f78575/uploads/origins/f863c69d-a0d7-43f8-b6af-318e5b964e21?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f633600f443ebe7892c3d6ad715f4587", "srcset": "https://si.imgix.net/b9f78575/uploads/origins/f863c69d-a0d7-43f8-b6af-318e5b964e21?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&