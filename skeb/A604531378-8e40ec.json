ることが多く、暗黙のツンデレで迷走しやすい。ブランケの行動にはいつも渋い顔をしている。\n\nキーワード\n\"額縁 \"や \"鏡\"\nキーワードを元に、自由にイラストを描いてください。\n\nご検討いただき、ありがとうございました。不適切と感じたら、この依頼をキャンセルしてもかまいません。", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@A604531378/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2116451, "client_id": 1897461, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/786e74d9/uploads/origins/8c550eac-ca42-4332-9174-7cf9ada11910?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9ece8d3a68bbc222684198ffe96984c1", "srcset": "https://si.imgix.net/786e74d9/uploads/origins/8c550eac-ca42-4332-9174-7cf9ada11910?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9ece8d3a68bbc222684198ffe96984c1, https://si.imgix.net/786e74d9/uploads/origins/8c550eac-ca42-4332-9174-7cf9ada11910?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=64bf36643906cd27de132d362d224435 2x, https://si.imgix.net/786e74d9/uploads/origins/8c550eac-ca42-4332-9174-7cf9ada11910?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=81243f8082900633f7c324c88e8801b9 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/786e74d9/uploads/origins/8c550eac-ca42-4332-9174-7cf9ada11910?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=cde9f027e204ee72fad8781a74459487", "srcset": "https://si.imgix.net/786e74d9/uploads/origins/8c550eac-ca42-4332-9174-7cf9ada11910?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=cde9f027e204ee72fad8781a74459487, https://si.imgix.net/786e74d9/uploads/origins/8c550eac-ca42-4332-9174-7cf9ada11910?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=33668d037b4bc7a20ba3d3952794a5e6 2x, https://si.imgix.net/786e74d9/uploads