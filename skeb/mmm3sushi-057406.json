•\t催眠によって積極的になった少年が青年に迫る展開を希望（青年も催眠をかけられる場合は、お互い積極的に求め合う展開だと嬉しいです）\n\t•\t行為そのものの描写はあれば嬉しいですが、お値段次第で省いていただいても問題ありません\n\t•\t既に行為をしたことがあるか・初めてかはお任せします\n\n\n無理なお願いでしたらスルーしていただいて大丈夫です。\nご検討のほど、よろしくお願いいたします。", "nc": 40, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@mmm3sushi/works/7", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/f3d14e68/uploads/origins/a8ee28e1-ad5b-47b5-a8a8-7f11455b8a21?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=977a4fe4f60adb252255b8a5d41fd909", "srcset": "https://si.imgix.net/f3d14e68/uploads/origins/a8ee28e1-ad5b-47b5-a8a8-7f11455b8a21?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=977a4fe4f60adb252255b8a5d41fd909, https://si.imgix.net/f3d14e68/uploads/origins/a8ee28e1-ad5b-47b5-a8a8-7f11455b8a21?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=34940858cef41009a22018a58c0f57ff 2x, https://si.imgix.net/f3d14e68/uploads/origins/a8ee28e1-ad5b-47b5-a8a8-7f11455b8a21?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=17bb6bd117ed367da5988736faba7764 3x"}, "private": true, "genre": "art", "tipped": false, "creator_id": 3424764, "nc": 128}, {"path": "/@mmm3sushi/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3424764, "client_id": 246433, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/d7208162/uploads/origins/79a50323-edf2-4f25-b600-972ec0bc4e07?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=96d407ad93bdc7