です。\n\n人当たりが良く笑顔を絶やさない一面と、どこか冷めたような無気力な一面があり、二面性があります。(仲間意識が強いように見えて実のところそうでもない、といった雰囲気です)\n銃火器の扱いに長けており、仕事熱心なタイプです。\n\n良ければよろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/1-qypB9pWJAAjOknVQ_BhN1yf1tXoTAar", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 875520, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "🎴如月燐🐾", "screen_name": "Krin_trpg", "avatar_url": "https://pbs.twimg.com/profile_images/1985568692705640450/EC_IRxS0.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1277925822666387457/1719677876/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 7, "complete_expiration_days": 120, "skills": [{"genre": "art"}, {"genre": "voice"}], "banned": false, "nc": 145}, {"id": 2783845, "creator": true, "nsfw_acceptable": false, "acceptable": false, "name": "キナリ@CommsOpen❣Skeb&Vgen", "screen_name": "kinari963", "avatar_url": "https://pbs.twimg.com/profile_images/1750026687629438976/XNT4gYXy.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1668498122136522752/1700994424/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 3, "complete_expiration_days": 25, "skills": [{"genre": "art"}], "banned": false, "nc": 32}, {"id": 3605198, "creator": true, "nsfw_acceptable": false, "acceptable": false, "name": "大国てる🔞", "screen_name": "Orcniteru", "avatar_url": "https://pbs.twimg.com/profile_images/1960303074129625088/_QtK4U5q.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1651440828471197696/1757044612/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at