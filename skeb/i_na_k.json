report_client_visible": false, "total_appeals_count": 0, "received_works": [{"path": "/@i_na_k/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 344180, "client_id": 3016395, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/8f75ed73/uploads/origins/fd065f8c-d598-47a5-b411-2d9e12b3b597?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c544417fed913e892669f867143bf233", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/8f75ed73/uploads/origins/fd065f8c-d598-47a5-b411-2d9e12b3b597?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=377088900e3c4ad2aacafe68549b6d11", "src_set": ""}, "body": "初めまして！\nIRIAMで配信をしております。\n夜宵庵と申します。\nいな子様のイラストがとても素敵だと思い、リクエストさせて頂きたく送らせていただきます。\n\n悪魔ですが、シスターをさせて頂いております。\n目の中に十字架があるのと涙ボクロがチャームポイントです！\n服装が複数ありますので、いな子様が気になった服装で描いて頂けると幸いです！\n構図や表情もお任せでお願いいたします。\n\nもし、人物以外に背景等の描写がある場合は人物のみの透過データも頂けると幸いです。\n\n頂いたイラストはSNS掲載、サムネイル、配信での使用をさせて頂きます。\nもし可能であれば返礼品としてデジタルでのグッズ(待ち受けやヘッダー)の使用もさせて頂きたいです。\n金額不足や使用不可の場合はキャンセルしてください。\n\nよろしくお願いいたします。\n\nhttps://x.com/yayoi_iori_/status/1922407165651771793?s=46&t=aBAO6rVB0zJ7EREEKOCQrw", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@i_na_k/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 344180, "client_id": 3545401, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/ceb65bde/uploads/origins/d8f264cb-228b-4dfe-8258-ed76657b168d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b792b1044fde5f0789f5ba1d96ecc53e", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/ceb65bde/uploads/origins/d8f264cb-228b-4dfe-8258-ed76657b168d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6d6603b6ecb4ace04f8cc03b21ba08a7", "src_set": ""}, "body": "いな子様\n\n初めまして、猫柳すみと申します。\nこの度は、とあるゲームでいな子様の透明感ある可愛らしいデザインに惹かれ、ご連絡させていただきました。\n\n●描いていただきたいイラスト\n米津玄師さんの「アイネクライネ」という曲のイメージで、横を向いている「猫柳すみ」を描いていただきたいです。\n背景、服装等の構図はお任せいたします。\n\nまた、YouTubeにて投稿予定の歌ってみたに使用させていただきたいと思っておりますので、よろしければ16:9の比率で描いていただけますと幸いです。\n\n初めての歌ってみた、skeb利用で至らない点が多々あるかと存じますが、ご検討よろしくお願いいたします。", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@i_na_k/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 344180, "client_id": 3495977, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/60f8c3d1/uploads/origins/1033df53-5bc6-450d-a720-c885cb328ae6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ea74381894077c44444679113ddd84d7", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/60f8c3d1/uploads/origins/1033df53-5bc6-450d-a720-c885cb328ae6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=13bf58726f508fecfac568220493ff9f", "src_set": ""}, "body": "こんにちは、お世話になります。\nリクエストさせていただきます！\n\nピンク色のハーフツインお団子猫耳女の子。\nお口は猫のようで八重歯が見える。\nピンクと水色が好きです。\nお洋服はお任せいたします。\nカジュアルよりは可愛い感じが好きです…！\nどうぞよろしくお願いいたします。\n（リヴリーアイランド楽しんでいます！リヴクリとても可愛かったです）", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@i_na_k/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 344180, "client_id": 463814, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/67407c88/requests/81593_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1a99c8c686a69d6cf1c4faf18a5923f3", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/67407c88/requests/81593_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e6a157ca125abc96b1a195c84e9bae58", "src_set": ""}, "body": "リクエスト失礼いたします。\nいな子様の描かれる涼やかな青色に一目惚れいたしました…。\nもしよろしければ、ボカロ曲「イヤホンと蝉時雨」のような夏をイメージした背景の中にいる、夏のお洋服を着た「天月こよみ」をお願いいたします…！\n（服装・髪型・背景ともにシンプルなもので問題ございません。）\n\nまた、歌ってみた動画のイラストとして使用させていただきたいと考えております。\nそのため16:9の比率で描いていただけますと幸いです…！\n\nよろしくお願いいたします…！", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "similar_creators": [{"id": 17626, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "あわたちよ", "screen_name": "cheswida", "avatar_url": "https://pbs.twimg.com/profile_images/1609180779682177025/nO9i2NDR.jpg", "header_url": "https://pbs.twimg.com/profile_banners/555157756/1615293213/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "skills": [{"genre": "art"}], "nc": 177}, {"id": 26671, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "青野　祈［依頼受付中］", "screen_name": "aono_inori", "avatar_url": "https://pbs.twimg.com/profile_images/1733377706581213184/d3FRVEj0.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1037562688832860160/1536211668/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "skills": [{"genre": "art"}], "nc": 0}, {"id": 39523, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "ゆゆず", "screen_name": "yuyuzu11", "avatar_url": "https://pbs.twimg.com/profile_images/1879269464824561664/wDYcJmPu.jpg", "header_url": "https://pbs.twimg.com/profile_banners/943424228711284736/1740224123/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_reques