\n使用目的はSNS用のアイコン、個人用端末（スマホやPC等）の壁紙、他イラストレーター様への作画資料としての一時的な提供であり、商業目的の使用はいたしません。\n\n今回もどのような作品になるか楽しみにしております。\nご検討の程よろしくお願いいたします。", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@mg_glc/works/13", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3219898, "client_id": 3999268, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/4a841136/uploads/origins/6ebe76cd-a4e3-455f-9ca5-658b29db47b2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a2310751e4a0d1b89eaef26b7ee16a38", "srcset": "https://si.imgix.net/4a841136/uploads/origins/6ebe76cd-a4e3-455f-9ca5-658b29db47b2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a2310751e4a0d1b89eaef26b7ee16a38, https://si.imgix.net/4a841136/uploads/origins/6ebe76cd-a4e3-455f-9ca5-658b29db47b2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=dce2905dea5e96128e6f1206611e241a 2x, https://si.imgix.net/4a841136/uploads/origins/6ebe76cd-a4e3-455f-9ca5-658b29db47b2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=4d5b1be741904642ad8dc366e2ca59d3 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/4a841136/uploads/origins/6ebe76cd-a4e3-455f-9ca5-658b29db47b2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d347b107b1da50759cb1a97c31fe353e", "srcset": "https://si.imgix.net/4a841136/uploads/origins/6ebe76cd-a4e3-455f-9ca5-658b29db47b2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d347b107b1da50759cb1a97c31fe353e, https://si.imgix.net/4a841136/uploads/origins/6ebe76cd-a4e3-455f-9ca5-658b29db47b2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=b71221ddadee456e416773d327a00d88 2x, https://si.imgix.net/4a841136/uploads/origins/6ebe76cd-a4e3