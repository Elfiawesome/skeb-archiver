の資料としてツイッターのツイートを添付させていただきます。\nネクタイとリボンの二種類衣装があるのですが、ネクタイの方でお願いします。\nメガネの有無はどちらでも大丈夫です。\n\nSNSや配信活動で使用したいと思っています。\n乱文失礼いたしました。\nよろしくお願いいたします。\n\nhttps://twitter.com/Lumu_Lemu/status/1649795257574514688", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@suahh_31/works/3", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/25914224/uploads/origins/4a613018-e426-46f0-9c28-c3787d50d02f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=17b6151c5c7e791517a3264de8c40668", "srcset": "https://si.imgix.net/25914224/uploads/origins/4a613018-e426-46f0-9c28-c3787d50d02f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=17b6151c5c7e791517a3264de8c40668, https://si.imgix.net/25914224/uploads/origins/4a613018-e426-46f0-9c28-c3787d50d02f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=0ce114e70ab0ab8c4927a96411bc673b 2x, https://si.imgix.net/25914224/uploads/origins/4a613018-e426-46f0-9c28-c3787d50d02f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=70b2635f5159d811ea92a2d2b32ce921 3x"}, "private": true, "genre": "art", "tipped": false, "creator_id": 2813297, "client_id": 1646686, "nc": 161}, {"path": "/@suahh_31/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2813297, "client_id": 2665909, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/e66e9d8f/uploads/origins/530d6130-f942-43c4-9b24-1cd90d3d4e7f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&