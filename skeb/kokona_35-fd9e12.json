く。\n耳かき中に投稿されてる耳かきボイスのようにかく音も共にお願いします。\n耳掃除の手順は\n右耳の耳かき→ピンセット→綿棒→梵天→耳ふーで右耳が終わった後に左耳の耳掃除もしていく。\n左耳の掃除が終わった後に無反応なご主人を見ると眠っていたので起こさない様に静かにゆっくりと下ろす。\n最後に囁きながら、「また耳が痒くなったら言ってよね。ちゃんと耳掃除してあげるから」「私はご主人の専属メイドなんだからさ」と言って終了。", "nc": 17, "word_count": 0, "transcoder": "audio", "creator_acceptable_same_genre": false}], "sent_works": [], "similar_creators": [{"id": 478275, "creator": true, "nsfw_acceptable": false, "acceptable": false, "name": "ヲム", "screen_name": "wo1059mu", "avatar_url": "https://pbs.twimg.com/profile_images/2006351917174472704/FjYFKJEc.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1108604701287735296/1632407011/1500x500", "appeal_receivable": true, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "art"}], "banned": false, "nc": 49}, {"id": 1397781, "creator": true, "nsfw_acceptable": false, "acceptable": false, "name": "ナガサキ", "screen_name": "osushi_kome", "avatar_url": "https://pbs.twimg.com/profile_images/1726889238384570368/T4nw0-yZ.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1331503373980319747/1623168124/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 3, "complete_expiration_days": 90, "skills": [{"genre": "art"}], "banned": false, "nc": 144}, {"id": 2610607, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "蓮/はす", "screen_name": "hasunohato_", "avatar_url": "https://pbs.twimg.com/profile_images/1799474768032444416/Pu61EYxF.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1418359247708901376/1777554569/1500x500", "appeal_receivable": false, "popular_creator_rank": 66, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "acc