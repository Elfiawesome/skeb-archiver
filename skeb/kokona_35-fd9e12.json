掻いていく。\n耳かき中に投稿されてる耳かきボイスのようにかく音も共にお願いします。\n耳掃除の手順は\n右耳の耳かき→ピンセット→綿棒→梵天→耳ふーで右耳が終わった後に左耳の耳掃除もしていく。\n左耳の掃除が終わった後に無反応なご主人を見ると眠っていたので起こさない様に静かにゆっくりと下ろす。\n最後に囁きながら、「また耳が痒くなったら言ってよね。ちゃんと耳掃除してあげるから」「私はご主人の専属メイドなんだからさ」と言って終了。", "nc": 1, "word_count": 0, "transcoder": "audio", "creator_acceptable_same_genre": false}], "sent_works": [], "similar_creators": [{"id": 288248, "creator": true, "nsfw_acceptable": false, "acceptable": false, "name": "桜沢かなた", "screen_name": "ousawa", "avatar_url": "https://pbs.twimg.com/profile_images/1845642120415285248/AoDUy4PC.jpg", "header_url": "https://pbs.twimg.com/profile_banners/272290008/1669085626/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 7, "complete_expiration_days": 120, "skills": [{"genre": "art"}], "banned": false, "nc": 161}, {"id": 1242035, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "餠鳥", "screen_name": "motidori_46", "avatar_url": "https://pbs.twimg.com/profile_images/1457323991421833216/y4m7PipP.jpg", "header_url": "https://pbs.twimg.com/profile_banners/716533064311025664/1706610844/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 120, "skills": [{"genre": "art"}], "banned": false, "nc": 160}, {"id": 1780418, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "栓", "screen_name": "seeenfree", "avatar_url": "https://pbs.twimg.com/profile_images/1780989467475767296/k3dyvLI8.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1139912294685536262/1572541555/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expira