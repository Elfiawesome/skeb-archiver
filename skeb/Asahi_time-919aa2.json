ッパと同じになります)\n\n背景\n古民家の室内\n(背景は細部まで描き込んでなくても、ブルーシートに踏まれたうどんの生地とこれから踏む丸まったうどんの生地が置いてあれば大丈夫です)\n\n以上になりますが、スリッパを履いている女の子が好きで描いてもらえると嬉しいです", "nc": 58, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Asahi_time/works/9", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/0d02460d/uploads/origins/e3aa7264-421a-4133-a1f0-a763c0f2837a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=4b10963a7a6d0a912548755a38cd0f35", "srcset": "https://si.imgix.net/0d02460d/uploads/origins/e3aa7264-421a-4133-a1f0-a763c0f2837a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=4b10963a7a6d0a912548755a38cd0f35, https://si.imgix.net/0d02460d/uploads/origins/e3aa7264-421a-4133-a1f0-a763c0f2837a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=d2369d6cbf879209dd61e0d84a9d9492 2x, https://si.imgix.net/0d02460d/uploads/origins/e3aa7264-421a-4133-a1f0-a763c0f2837a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=5a9a614d151e1599ad03c9acbc0f33dd 3x"}, "private": true, "genre": "art", "tipped": true, "creator_id": 2725974, "nc": 32}, {"path": "/@Asahi_time/works/8", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2725974, "client_id": 595514, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/4fd0fb10/uploads/origins/dca80ed6-1537-4f81-bf24-f01deba47c5e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=32ecf846cb4a951f38955cf74a0cbbd1", "srcset": "https://si.imgix.net/4fd0fb10/upl