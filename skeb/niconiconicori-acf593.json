て大丈夫です。\n\n長文・駄文失礼しました。値段等が合わなければ再送依頼をお願いします。お忙しい中恐れ入りますが、ご検討よろしくお願いいたします。\n\n慰\nhttps://drive.google.com/drive/folders/1hqm4UyO6OmEZJyD1QRpm-KY9Fztgqa9W\n\n此方\nhttps://drive.google.com/drive/folders/1bgdx-8wiyJEaabS8JDqYnug37OVgedAW", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@niconiconicori/works/6", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/871fa142/uploads/origins/f72da4e4-b25b-4827-90d9-8c1ef8cd8818?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=ede309c5b2ff5e2494c7ce0943e21521", "srcset": "https://si.imgix.net/871fa142/uploads/origins/f72da4e4-b25b-4827-90d9-8c1ef8cd8818?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=ede309c5b2ff5e2494c7ce0943e21521, https://si.imgix.net/871fa142/uploads/origins/f72da4e4-b25b-4827-90d9-8c1ef8cd8818?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=31233a95a68ffae5e83506a94bd520c1 2x, https://si.imgix.net/871fa142/uploads/origins/f72da4e4-b25b-4827-90d9-8c1ef8cd8818?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=8b0bc58b959cb5e5dea0b57dc61653f9 3x"}, "private": true, "genre": "art", "tipped": false, "creator_id": 2881821, "client_id": 3603181, "nc": 16}, {"path": "/@niconiconicori/works/5", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/865cdde5/uploads/origins/ee7d73a2-62d1-48f3-ad10-fb3e4293ec86?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE