200&h=200&blur=200&s=6d2fab0a9028aae352fb1f0dc877f46c 2x, https://si.imgix.net/1fd5f65e/uploads/origins/a63d6ade-87b0-441b-9759-4e2a34532bcb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=1edc63d152cdd01f9b4686f90b3282eb 3x"}, "body": "雨水様こんにちは\n以前2回程依頼させて頂きました。\n雨水様の絵柄が本当に大好きなので\nまたお願いさせて頂きたいです\n資料URLを参考にお願い致します\n二種類ありますが、お好きな方で大丈夫です\n色彩や細かなデザイン等は雨水様にお任せ致します\nお忙しいと思いますのでお手隙のお時間に\nどうぞよろしくお願い致します\nこれからも影から応援しております。大好きです\n\nhttps://drive.google.com/drive/folders/15ogXynx6ZWDBQ10Kec1skOocOuoZKnT0", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@8soyasoya8/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 888265, "client_id": 612778, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/52cc86da/uploads/origins/e905a15c-c0aa-4b98-9740-fee15211cde7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=52e698913d1057a86e1d55165ac6a940", "srcset": "https://si.imgix.net/52cc86da/uploads/origins/e905a15c-c0aa-4b98-9740-fee15211cde7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=52e698913d1057a86e1d55165ac6a940, https://si.imgix.net/52cc86da/uploads/origins/e905a15c-c0aa-4b98-9740-fee15211cde7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=4fa8fe761cf2465318c4baa2ddb4e7f0 2x, https://si.imgix.net/52cc86da/uploads/origins/e905a15c-c0aa-4b98-9740-fee15211cde7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a166f02508688ea5f74ace1fa84ea461 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/52cc86da/uploads/origins/e905a15c-c0aa-4b98-9740-fee15211cde7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=8d2e31406493f666dca09dad898fb776", "srcset": "https://si.imgix.net/52cc86da/uploads/origins/e905a15c-c0aa-4b98-9740-fee15211cde7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=8d2e31406493f666dca09dad898fb776, https://si.imgix.net/52cc86da/uploads/origins/e905a15c-c0aa-4b98-9740-fee15211cde7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=6c7a1124ec1c093998b8730cf8e5cc7a 2x, https://si.imgix.net/52cc86da/uploads/origins/e905a15c-c0aa-4b98-9740-fee15211cde7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=80d0608a4b617811c9044f5a1d225607 3x"}, "body": "コンペの方ではご提案ありがとうございました。\n改めて別件の依頼として、一枚絵の依頼をさせていただきたく参りました。\n\nせっかくなので、コンペで雨水様が提案してくださった衣装のどれかで一枚描いて頂きたいなと思っています。\nほぼほぼお任せする形になって恐縮ですが、全体的な色合いや画面作りに関しては雨水様のセンスにお任せしたいなと。\n雨水様の好みで描いて頂けたら幸いです。\n\n【資料】\nツイッター上で昔あげた画像を参考画像としてURL張ります\nhttps://twitter.com/muro139/status/1366591592325206016?s=20\n髪色：黒/眼色：金\n\n【備考】\n・コンペの依頼の際にイメージカラーを赤紫と書きましたがこれに関しての意識はしないで問題なし\n（所属している寮が赤薔薇寮→赤系統の文字色を使いたい→同じ寮の同卓PCが赤を使っていたので赤紫…くらいの決め方だったので『しいて言えば』くらいの要素でした）\n・服装デザインの依頼の時は髪紐の色は赤固定でしたが、こちらも全体の色合いに合わせて色やデザインを変えてもOK\n・糸目キャラではありますが、イラストにおいて眼の描写というのは映える部分かなと思うので開眼具合はお任せします\n（私自身が描くときも結構気分で開眼させてる時が多いです）\n・コンペで提案頂いた衣装が指定ですが、雨水様がもっとこっちの方が良いというものがあればそちらに変更頂いて構いません\n\n\nリクエスト文として良いものが書けたか自信がありませんが、よければよろしくお願いいたします。\n\nhttps://twitter.com/muro139/status/1366591592325206016?s=20", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@8soyasoya8/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 888265, "client_id": 254448, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/c8b368c7/uploads/origins/4d9b3e04-a4b4-4fcf-8e26-448e4ed0abab?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=56ed9e892646fcebe63b23f6e3b57dfa", "srcset": "https://si.imgix.net/c8b368c7/uploads/origins/4d9b3e04-a4b4-4fcf-8e26-448e4ed0abab?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=56ed9e892646fce