ff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c5edda06dbf48dfd194f00af519d731d, https://si.imgix.net/d844447f/uploads/origins/ba803eae-01f0-4222-83c1-03bbfecfd3db?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=d858f41074e29628e3a12d8e18dbc6df 2x, https://si.imgix.net/d844447f/uploads/origins/ba803eae-01f0-4222-83c1-03bbfecfd3db?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=294af3dbdfb2a47d9abcaa33750871ba 3x"}, "body": "初めまして。\n以前からサクラブロッサムの素敵なイラストを拝見しております。アイマスエキスポで頒布されていたイラスト本も、衣装によって色々な雰囲気を纏っていて素敵でした。レトラの衣装も取り上げていただきありがとうございました。\n\n今回の依頼はヴイアライヴの灯里愛夏です。\nhttps://idolmaster-official.jp/va-liv/manaka\n\n彼女はアイドルを目指して高校入学のタイミングで福岡の田舎から上京しました。\n福岡には強い思い入れがあり、配信でも家族のことや地元のことをよく語っています。\nその一方、田舎ゆえアイドルを目指すことを周囲にからかわれたりしたこともあったようで、配信ではいつも明るい彼女ですが、地元の風景を無言で見つめているような瞬間もあったのかなと思ったりします。\nといったことを踏まえた依頼になります。\n\n・思い浮かんだモチーフは「地元の田舎風景を見つめる愛夏」ですが、千助さんのインスピレーションにお任せいたします\n・表情、ポーズ、服装等もお任せいたします\n・過去の作品のうち、下記のような絵本のようなタッチをイメージしております\nhttps://skeb.jp/@kagimaruchisuke/works/1\nhttps://skeb.jp/@kagimaruchisuke/works/2\n\nその他参考になりそうな資料はGoogle Driveに置いております。あくまで参考資料なのでご自由に描いていただければと思います。\n\n※本リクエストは下記公式ガイドラインに沿ったものになります。\n納品いただいたイラストが本人の配信サムネ等に使用される可能性があるため、NGの場合はお気兼ねなくキャンセルしていただければと思います。\nhttps://idolmaster-official.jp/va-liv/policy\n\nどうぞよろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/1seOSCPEfInhsfgm_gWjFlYz8S_rMKmJ1?usp=drive_link", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@kagimaruchisuke/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1194646, "client_id": 2858957, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/321c30a7/uploads/origins/8924caa5-909a-4209-ba92-7dafba1bc9ae?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d4bc6afe6722d9f7b6e51700a80edfbe", "srcset": "https://si.imgix.net/321c30a7/uploads/origins/8924caa5-909a-4209-ba92-7dafba1bc9ae?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d4bc6afe6722d9f7b6e51700a80edfbe, https://si.imgix.net/321c30a7/uploads/origins/8924caa5-909a-4209-ba92-7dafba1bc9ae?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=6bf26ee36fd87fe15feaaa1c244a0acb 2x, https://si.imgix.net/321c30a7/uploads/origins/8924caa5-909a-4209-ba92-7dafba1bc9ae?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=49de1a191a38a6ef93cb875239e48ce1 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/321c30a7/uploads/origins/8924caa5-909a-4209-ba92-7dafba1bc9ae?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c7adc6747bec6786728cd1ec84b717a0", "srcset": "https://si.imgix.net/321c30a7/uploads/origins/8924caa5-909a-4209-ba92-7dafba1bc9ae?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c7adc6747bec6786728cd1ec84b717a0, https://si.imgix.net/321c30a7/uploads/origins/8924caa5-909a-4209-ba92-7dafba1bc9ae?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=1010b29a1c05ceaaf961e9e4cffbb27b 2x, https://si.imgix.net/321c30a7/uploads/origins/8924caa5-909a-4209-ba92-7dafba1bc9ae?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=7da4a510ac16ec039ff48be30c6acdb5 3x"}, "body": "はじめまして。\nわたくしのオリジナルキャラクターを描いていただきたいです。\n・身⾧ 160 後半、体形は痩せ気味。\n・左目の下に泣きぼくろ、ギザ歯、髪色はエメラルドグリーンのメッシュ。\n・ピアスは細かい設定は無いので自由にお願いします。\nというのがキャラクター設定になります。\n服装はストリート系、オーバーサイズのものをよくイメージしていますが特に指定はしませんのでどのような服装でも構いません。\n使用用途は個人観賞用、SNS等への投稿になります。\n\n以下資料になります\nhttps://drive.google.com/drive/folders/1gTMtMvj5H7PqotYGUH-w-U_3NMcAwnZy?usp=sharing\nhttps://www.pixiv.net/artworks/94218330\nhttps://www.pixiv.net/artworks/112491946\n\nよろしくお願いいたします。", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@kagimaruchisuke/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1194646, "client_id": 277867, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/509f9ef0/uploads/origins/8c33f455-118a-401a-b30d-7e07e94b8db2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=014a777191f5690add75f6595ce051a6", "srcset": "https://si.imgix.net/509f9ef0/uploads/origins/8c33f455-118a-401a-b30d-7e07e94b8db2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=014a777191f5690add75f6595ce051a6, https://si.imgix.net/509f9ef0/uploads/origins/8c33f455-118a-401a-b30d-7e07e94b8db2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=d7000343267fa1ba04b102133dcda3fd 2x, https://si.imgix.net/509f9ef0/uploads/origins/8c33f455-118a-401a-b30d-7e07e94b8db2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=6021c780c07c80a1d663ae4d7045d150 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/509f9ef0/uploads/origins/8c33f455-118a-401a-b30d-7e07e94b8db2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=98ad9babd8f96af69e3614e9abff4dec", "srcset": "https://si.imgix.net/509f9ef0/uploads/origins/8c33f455-118a-401a-b30d-7e07e94b8db2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=98ad9babd8f96af69e3614e9abff4dec, https://si.imgix.net/509f9ef0/uploads/origins/8c33f455-118a-401a-b30d-7e07e94b8db2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=ec980f222f25d0dafbfe63fc3b954f7d 2x, https://si.imgix.net/509f9ef0/uploads/origins/8c33f455-118a-401a-b30d-7e07e94b8db2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=fcbc65c4092bcfcd7309101b970152f7 3x"}, "body": "千助さんのデザイン・イラストが大好きです！\n是非イラストを描いていただきたいと思い、この