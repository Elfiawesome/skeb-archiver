&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=babfacd91577e63d7a89a5e79c060a2b", "src_set": ""}, "private": true, "genre": "art", "tipped": false, "creator_id": 975921, "client_id": 1068618, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 0, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@_mariruIN/works/8", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 975921, "client_id": 3304401, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/ab7b7cf6/uploads/origins/070bd23a-e864-466b-bd73-a9f8eef0aad7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a1c72676d087c1505f1283561d8d4c2a", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/ab7b7cf6/uploads/origins/070bd23a-e864-466b-bd73-a9f8eef0aad7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9b80c6c43030ff4f37f3b7cb5d4dea34", "src_set": ""}, "body": "わたしのオリキャラをあなたの画風で描いてください。\n一応名前は「Soda」と言います。\n\n隻眼(左目のみ)で黒色の強い灰色の肌、明るい黄緑色の髪と虹彩のキャラクターです。\n髪型はツインテール、長い髪の途中から炭酸飲料のような模様があります。\n\n服装は、可能な限り淡い水色のワンピースですが変更しても大丈夫です。マスクは外さないでください。靴は深緑色のブーツです。左耳側にマイクのある、ヘッドバンドとスライダーのない赤紫色のヘッドホンを着せてください。\n\n具体的な配色や体型、飾りなどは資料をご覧ください。\nかっこかわいい感じでお願いします。\n\n小道具は持たせても持たせなくてもいいです。\n小道具を持たせる場合、資料内に描かれているもの以外は持たせないでください。\nよろしくお願いします。\n\nhttps://drive.google.com/drive/folders/1dIaSAL1H56pDtRrDaxsgIK1-kZVkTNQW", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@_mariruIN/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 975921, "client_id": 2015931, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/b979eb85/uploads/origins/dca24628-09a2-48f0-a0d1-e26da9fdf785?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ab409a02567140edd2035dc6d00ca830", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/b979eb85/uploads/origins/dca24628-09a2-48f0-a0d1-e26da9fdf785?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2d1f098da3c4a878268c2cba87372497", "src_set": ""}, "body": "はじめまして。リクエストします\n\n『まちカドまぞく』のシャミ子でイチャラブパイズリをお願いします\n\n服装は危機管理フォームで、生おっぱいや乳首が丸出しになるようにしてほしいです\n\n竿役：ふたなりでも肥満でもなく、健康的な肌なら多分大丈夫。亀頭は出してほしい\n\n恥ずかしがりながらちん○を挟み、照れ笑いで扱く内に、身体全体に精液がかかる程の大量射精が起きるも満更でもない\n\n宜しければ、差分として射精前の差分と精液まみれになった後に笑顔になる差分も(入れなくてもOK)\n\n\n以上です。検討の程よろしくお願いします", "nc": 161, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@_mariruIN/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 975921, "client_id": 2640761, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/7bea05e6/uploads/origins/f150e92a-514f-445e-9b35-568e9f18a512?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e5f1deeeb8cc83b2b226ac680b6ef495", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/7bea05e6/uploads/origins/f150e92a-514f-445e-9b35-568e9f18a512?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=1bd25edecabd0e9bd1463f848e0e3806", "src_set": ""}, "body": "白衣を着た小柄な女性がスパイダー騎乗位をしているイラストをお願いします。", "nc": 32, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@_mariruIN/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 975921, "client_id": 1543913, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/13def886/uploads/origins/5a043ea8-e896-4ef3-b5f6-f07e86cb23aa?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=49a421bac984229ad7cf969c48878285", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/13def886/uploads/origins/5a043ea8-e896-4ef3-b5f6-f07e86cb23aa?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f85842c942377dce5d730fcaa7ac1caa", "src_set": ""}, "body": "まりる院兄貴\n\nエフェ様のニプルファックをお願いします。\n詳細は以下の通りです。\n\nプレイ内容：ニプルファック（両乳首）\n登場人物　：エフェウル、竿役2人\n体位・体勢：\n　・エフェウル：地面と垂直（膝立ちや正座など）\n　・竿役　　　：エフェウルの両脇\n構図　　　：\n　・エフェウル：へそ辺りから頭の上まで\n　・竿役　　　：男性器のみ\n表情　　　：\n　・エフェウル：挿入されたことに対し驚く表情\n　・竿役　　　：（なし）\nセリフ　　：あり\n背景　　　：指定なし\n制約　　　：セリフに必ず「淫夢語録」を含む（語録の一部引用でも可）\n\nイラストは全体公開をお願いします。\nツイッターやファンボックスなどで積極的に公開していただきたいです。\nご検討のほどよろしくお願いいたします。", "nc": 33, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "similar_creators": [{"id": 43569, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "りよ☕️", "screen_name": "Liyocafe", "avatar_url": "https://pbs.twimg.com/profile_images/1910203683641647105/rB76lrWj.jpg", "header_url": "https://pbs.twimg.com/profile_banners/969535290636361728/1658187302/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "skills": [{"genre": "art"}, {"genre": "correction"}], "nc": 161}, {"id": 91119, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "tomi8tky", "screen_name": "tomi8tky", "avatar_url": "https://proxy.misskeyusercontent.jp/avatar/media.misskeyusercontent.jp%2Fio%2Fwebpublic-9dc7eb71-8eee-4557-8fa7-17eb4084cfe0.png?avatar=1", "header_url": "https://media.misskeyusercontent.jp/io/webpublic-4016a50d-0da7-4d64-b4b4-c6dd745a555d.png", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable