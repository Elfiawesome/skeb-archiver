インをお願いしたいのです。どんな服装でもOKです。シャボン玉やシャボン玉のような雰囲気と相性の高い服や小物であることだけが条件です。シャボン玉に関連するものであればなお良しです。髪型を変えることはOKです。\n\nオプション: シャボン玉の他に、最近は風船にも興味を持つようになったので、風船も持たせてあげるといいです。もし風船を入れるなら、風船を手に巻きつけて、複数の風船を持たせてあげたいです。\n例:https://skeb.jp/@SuwaP/works/8\n\n悠羽くんがもっとかわいくなるように、よろしくお願いします。\n\nhttps://drive.google.com/drive/folders/1zdlJopwpeO-YtqQHJbSls6HRbh_WjkoQ?usp=sharing", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@_Limuru/works/10", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 673620, "client_id": 1695090, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/a8761933/uploads/origins/2a249d0e-a945-4ec8-81af-963cdbfa25ea?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5bf3c32980d4a24f5d9ad97bab888711", "srcset": "https://si.imgix.net/a8761933/uploads/origins/2a249d0e-a945-4ec8-81af-963cdbfa25ea?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5bf3c32980d4a24f5d9ad97bab888711, https://si.imgix.net/a8761933/uploads/origins/2a249d0e-a945-4ec8-81af-963cdbfa25ea?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c0e0d7e33625e2e8d59e3c6542665fdd 2x, https://si.imgix.net/a8761933/uploads/origins/2a249d0e-a945-4ec8-81af-963cdbfa25ea?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e768771e3df5cfbe15fc11f9545066c4 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/a8761933/uploads/origins/2a249d0e-a945-4ec8-81af-963cdbfa25ea?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=7e9da9900d22e4d827b58247b7824acf", "srcset": "https://si.imgix.net/a8761933/uploads/origins/2a249d0e-a945-4ec8-81af-963cdbfa25ea?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=7e9da9900d22e4d827b58247b7824acf, https://si.imgix.net/a8761933/uploads/orig