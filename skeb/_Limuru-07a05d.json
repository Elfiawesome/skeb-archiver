igins/18ab6a59-bf8b-47b8-8c0c-14aaabb23d48?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=166bce0da26ab717b1a8a25028b0be84", "srcset": "https://si.imgix.net/1522e444/uploads/origins/18ab6a59-bf8b-47b8-8c0c-14aaabb23d48?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=166bce0da26ab717b1a8a25028b0be84, https://si.imgix.net/1522e444/uploads/origins/18ab6a59-bf8b-47b8-8c0c-14aaabb23d48?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=d7a335c27538009c92025029df481cb3 2x, https://si.imgix.net/1522e444/uploads/origins/18ab6a59-bf8b-47b8-8c0c-14aaabb23d48?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=e489d7ba1c0d414db6852e2005dab296 3x"}, "body": "あいすさんこんにちは！\n\nはづまこさんのイラストをリクエストさせていただきます\n\n背景:おまかせ\nポーズ:胸元の位置で親指から薬指で♡マーク\n表情:ウインク、赤面、スマイル\n服装:標準衣装で上着あり\n\n使用用途:\nプレゼントとして、はづまこさんご本人に限りの配信活動での使用許可を頂きたいです\n\nよろしくお願いします", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@_Limuru/works/13", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 673620, "client_id": 127734, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/bb44da3b/uploads/origins/929cecc8-407a-492c-978e-4ce08ad61803?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7ff69725c1828d9d31928b8be65c61a8", "srcset": "https://si.imgix.net/bb44da3b/uploads/origins/929cecc8-407a-492c-978e-4ce08ad61803?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7ff69725c1828d9d31928b8be65c61a8, https://si.imgix.net/bb44da3b/uploads/origins/929cecc8-407a-492c-978e-4ce08ad61803?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=3c58bf8807340a56b3b82a5452f6fb0f 2x, https://si.imgix.net/bb44da3b/uploads/origins/929cecc8-407a-492c-978e-4ce08ad61803?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f1a2ad36b8e1c03d1124790a87b9c052 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/bb44da3b/uploads/origins/929cecc8-407a-492c-978e-4ce08ad61803?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=69e6b2f2ddfe0a27ac063db5642a0bd8", "srcset": "https://si.imgix.net/bb44da3b/uploads/origins/929cecc8-407a-492c-978e-4ce08ad61803?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=69e6b2f2ddfe0a27ac063db5642a0bd8, https://si.imgix.net/bb44da3b/uploads/origins/929cecc8-407a-492c-978e-4ce08ad61803?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=57b45df951424a2a469d153894d88c4f 2x, https://si.imgix.net/bb44da3b/uploads/origins/929cecc8-407a-492c-978e-4ce08ad61803?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=386ecb91d4ab2ce7eb4c8bb077729eec 3x"}, "body": "こんばんは、水上あいすさん。また依頼させて頂きます！\n\n今回のリクエスト内容は、夏が近いので、悠羽くんのかわいい水着姿や水中での様子を描いてもらいたいと思います。どんな水着を描くかは、あなたにお任せします。\nできれば、背景を泡の海/泡沫の海のようにする、彼の周りに泡を付けてあげてください。\n參考: https://drive.google.com/drive/folders/1tjaXPYF7ZTmnd9lnub4VgSce-QIe7sZz?usp=share_link\nまた、浮き輪 (例: FGO - 水着アビー/夏) やインフレータブルトイ (例: ブルアカ - 水着ホシノ) など、遊べるものを与えてもよいです。\n\nよろしくお願いします！\n\nhttps://drive.google.com/drive/folders/1zdlJopwpeO-YtqQHJbSls6HRbh_WjkoQ?usp=sharing", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@_Limuru/works/12", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 673620, "client_id": 127734, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/0d598ba5/uploads/origins/2491e487-7ada-4ddd-b899-ce78c59947f8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c5210e2670938106dd2ce563c45133ae", "srcset": "https://si.imgix.net/0d598ba5/uploads/origins/2491e487-7ada-4ddd-b899-ce78c59947f8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c5210e2670938106dd2ce563c45133ae, https://si.imgix.net/0d598ba5/uploads/origins/2491e487-7ada-4ddd-b899-ce78c59947f8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=417da3e90e5d849a51e2c563d796342d 2x, https://si.imgix.net/0d598ba5/uploads/origins/2491e487-7ada-4ddd-b899-ce78c59947f8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a055cb1efe21552b1babcd883a1eb1bc 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/0d598ba5/uploads/origins/2491e487-7ada-4ddd-b899-ce78c59947f8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3012dbe1ddefe19df1b2834b14a8a668", "srcset": "https://si.imgix.net/0d598ba5/uploads/origins/2491e487-7ada-4ddd-b899-ce78c59947f8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3012dbe1ddefe19df1b2834b14a8a668, https://si.imgix.net/0d598ba5/uploads/origins/2491e487-7ada-4ddd-b899-ce78c59947f8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=5104ebc3914d059e8b57cf8c6564e1e7 2x, https://si.imgix.net/0d598ba5/uploads/origins/2491e487-7ada-4ddd-b899-ce78c59947f8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=363e0ec04e4172a8b64152f5a41be89d 3x"}, "body": "こんばんは、水上あいすさん。前回の衣装が素敵です。ありがとうございますm(_ _)m! また、もう一度あなたに依頼したいです!\n\nhttps://skeb.jp/@_Limuru/works/11\n\n今回のリクエスト内容は、悠羽くんがシャボン玉をしているという内容です。構図やポーズについてですが、シャボン玉に関連するものであれも基本的に自由です。(例: シャボン玉を作る、シャボン玉に乗る、シャボン玉の中に入る、etc.)\n\nよろしくお願い致します～\n\nhttps://drive.google.com/drive/folders/1zdlJopwpeO-YtqQHJbSls6HRbh_WjkoQ?usp=sharing", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@_Limuru/works/11", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 673620,