トのサイドにある🔔付きのリボンと同じで大丈夫です♩\n\n【関係性/世界観？】\n双子の羊ちゃんになります♩\n🤍🐏▶︎🖤に激重感情、🖤は何も知らなくていい的な重度の過保護、世界の全てを嫌っている\n🖤🐏▶︎無感情、重度の箱入り娘、常識すら知らない人形のような子\n基本🖤は🤍にされるがままです♩\nロリータ系でダークな雰囲気で描いていただきたいです🥲グロも大歓迎です❕💖\n2人の世界大展開な構図でお願いいたします❕(語彙力)\nその他細かい構図などは全てお任せいたしますので、基本お好きなようにお描きいただければ幸いでございます👾🤍\n\n描写範囲は胸上又は腰上、もし可能であれば縦長のキャンパスサイズで、画面いっぱいに描いていただければ…❕🙇🏻‍♀️‪‪\n\n使用用途につきましては、 SNSでの使用・参考資料・Twitterにて記載(#ユザネ を付けた上で記載いたします🙌🏻)・観賞用を主に考えております💭\n\nその他不明点・不備等々ございましたら、お手数お掛けしますが再送依頼お送りいただけますと幸いです😿\n\nhttps://drive.google.com/drive/folders/1-2DaHoIJls-TzTRV-dSjr_P8vqwGUAVd", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@mnxxx_xxxnm/works/10", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3447891, "client_id": 3727504, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/8cd65f59/uploads/origins/cdcb8cda-398f-472a-8f84-bd85de17b6f6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=65039cf70c3b67f7baeb737a74186ebb", "srcset": "https://si.imgix.net/8cd65f59/uploads/origins/cdcb8cda-398f-472a-8f84-bd85de17b6f6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=65039cf70c3b67f7baeb737a74186ebb, https://si.imgix.net/8cd65f59/uploads/origins/cdcb8cda-398f-472a-8f84-bd85de17b6f6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ff9abc89195d11e3f19210e701eec64f 2x, https://si.imgix.net/8cd65f59/uploads/origins/cdcb8cda-398f-472a-8f84-bd85de17b6f6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=514528411397c2f6304396b85256adaa 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/8cd65f59/uploads/origins/cdcb8cda-398f-472a-8f84-bd85de17b6f6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=19c7c839cd200c5e509e6ce42259c492", "srcset": "https://si.imgix.net/8cd65f59/uploads/origins/cdcb8cda