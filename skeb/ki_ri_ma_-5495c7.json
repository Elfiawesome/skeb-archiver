e61-048bf5b7cc6f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=fbba6c9f4761df7d967e9d613fd601e4", "srcset": "https://si.imgix.net/046d293c/uploads/origins/2ea2edd7-be74-4665-8e61-048bf5b7cc6f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=fbba6c9f4761df7d967e9d613fd601e4, https://si.imgix.net/046d293c/uploads/origins/2ea2edd7-be74-4665-8e61-048bf5b7cc6f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=3bbf6949af954912502450a9bc978859 2x, https://si.imgix.net/046d293c/uploads/origins/2ea2edd7-be74-4665-8e61-048bf5b7cc6f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=ad5c4cb3fe1554f72f69a070a292dbd4 3x"}, "body": "こんにちは。\n前回は元気いっぱいのリーリヤを描いていただき、本当にありがとうございました。\n冬コミで描かれていた制服姿のゆかりさんがとてもかわいく、ぜひゆかりさんと雫ちゃんの壁紙をお願いできればと思い、リクエストさせていただきました。\nPC用の壁紙として使用を考えておりますので、16:9比率・1920×1080px（フルHD）以上のサイズで制作していただけると嬉しいです。\n\n■キャラクター\n・結月ゆかり\n・結月ゆかり 雫\n\n■服装\n・制服姿\n・ゆかりさんの制服デザインはお任せいたします（2025年冬コミの本で着ていた制服姿はどちらもとてもかわいかったので、そちらのデザインでも大丈夫です。）\n・雫ちゃんは公式の制服姿でも、ゆかりさんの制服に合わせたデザインでも、どちらでも構いません。\n\n■構図・シチュエーション\n・夕暮れ時（夕日が二人をやわらかく照らしている雰囲気）\n・放課後学校帰りに二人並んでベンチなどに座り、アイス（ガリガリ君ソーダ味）を食べている（アイスを食べていますが半袖姿ではなく、カーディガンを着るなどある程度着こんでいる姿で大丈夫です。）\n\n■使用用途\nパソコンの壁紙や、X（旧Twitter）などのSNSヘッダーに使用させていただく可能性がございます。\n\n以上の内容でお願いいたします。\n指定していない部分はすべてお任せいたします。\nどうかご検討のほどよろしくお願いします。", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@ki_ri_ma_/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2814792, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/fe46fe43/uploads/origins/9d9e89c6-c365-45ed-abaa-5701dc26184f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=808f5dc5369c71b9069c14ae320f1fb4", "srcset": "https://si.imgix.net/fe46fe43/uploads/origins/9d9e89c6-c365-45ed-abaa-5701dc26184f?bg=%23fff&auto=format%2Ccompress&f