6fb4a0de26de00c", "srcset": "https://si.imgix.net/0a8586d8/uploads/origins/043b8918-97f2-40a9-99a4-975e708290f5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=01704771008ea732c6fb4a0de26de00c, https://si.imgix.net/0a8586d8/uploads/origins/043b8918-97f2-40a9-99a4-975e708290f5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=537b8f5540a795bdf9db8c7ee17aa184 2x, https://si.imgix.net/0a8586d8/uploads/origins/043b8918-97f2-40a9-99a4-975e708290f5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ca9a305b6968878f35b6e5a534e7f051 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/0a8586d8/uploads/origins/043b8918-97f2-40a9-99a4-975e708290f5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=26255a8495cfc35e4eae1fd74b927083", "srcset": "https://si.imgix.net/0a8586d8/uploads/origins/043b8918-97f2-40a9-99a4-975e708290f5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=26255a8495cfc35e4eae1fd74b927083, https://si.imgix.net/0a8586d8/uploads/origins/043b8918-97f2-40a9-99a4-975e708290f5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=d0748ad52a1275863d56dc854e3fe3fa 2x, https://si.imgix.net/0a8586d8/uploads/origins/043b8918-97f2-40a9-99a4-975e708290f5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=a9b2e67e95fcdb10ca845f5414ac9f07 3x"}, "body": "シロトン先生\nお誕生日おめでとうございます！\nお身体を大切により充実した一年になりますよう心から願っています\n\n\n『ハヤリガミガキタ！伍』の発行記念にイラストをお願いしたくリクエストいたしました（別のご本と一緒にアリスブックスさんで購入させていただきました！）。\n皆にいつでもどこでも会えるWeb版も素敵ですが、手に取った時のあの独特の高揚感を味わえる紙版は更にいいなと思いました。\nこの度はお忙しい中、新刊を出してくださりありがとうございました。大切にいたします。\n\n先生のお誕生日に大変恐縮ですが、よろしければWコンちゃんを描いていただけないでしょうか。\nどうかよろしくお願いいたします。\n\n【Wコンちゃんについて】\n・12話と繋がっている形で、普通の女の子のような夏服を着用（水着でも浴衣でも先生のお好みの服装で構いません）\n・本編が今とても切ない展開で何度拝見してもうるっと来てしまうので、イラストではWコンちゃんが笑顔で夏を満喫している感じだと嬉しいです\n\n【その他】\n・先生の右肘へのご負担が少ない画法とサイズを希望いたします（前回は本当に本当にありがとうございました…！）\n\n人物を二人描いていただく関係で金額的に承認が難しい場合は、お手数ですがキャンセルをお願いいたします。\n乱文、失礼いたしました。\n\n使用目的：個人鑑賞、ツイート、SNSのアイコン並びにヘッダー（カバー）、PC用壁紙など。\n※プロフィールに先生のお名前を明記の上、目的外の使用はいたしません。", "nc": 49, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@siro1000/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 381907, "client_id": 262123, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/5fe7c4ce/requests/217245_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f3e250835604ca3a04bb1c2813028709", "srcset": "https://si.imgix.net/5fe7c4ce/requests/217245_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f3e250835604ca3a04bb1c2813028709, https://si.imgix.net/5fe7c4ce/requests/217245_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=087b15ca5caa680aa3419fcc654e1cc1 2x, https://si.imgix.net/5fe7c4ce/requests/217245_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=760d801b0beeba1c3f06d91e98d70f47 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/5fe7c4ce/requests/217245_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=187afb2acabead948c282d84d4e9dd9d", "srcset": "https://si.imgix.net/5fe7c4ce/requests/217245_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=187afb2acabead948c282d84d4e9dd9d, https://si.imgix.net/5fe7c4ce/requests/217245_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=5fbeb7c8718367cb1dd0370639dd758e 2x, https://si.imgix.net/5fe7c4ce/requests/217245_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=f4019d2342dd98b6d3cb17ddf0959cb8 3x"}, "body": "寒中お見舞い申し上げます\n旧年中は大変お世話になりました\n本年もどうぞよろしくお願いいたします\n\n\nシロトン先生、こんにちは。\nご無沙汰しています。\n\n『ハヤリガミガキタ』12話脱稿、お疲れ様でした！\n今回のお話も楽しく、また切なく拝読いたしました。\n感想をと思いましたが本文内に収まらないことと、本題から逸れてしまうため割愛させていただきました。いつか別の機会に、送らせていただければ嬉しいです。\n\n殺し屋さんが素敵すぎてずっと妄想が止まらず、新規にイラストをお願いしたくリクエストいたしました。\n先生のご都合がよろしければ、殺し屋さんの視点で相棒の猫を描いていただけないでしょうか。\nどうかよろしくお願いいたします。\n\n【猫について】\n・被毛はブルー、瞳はエメラルドグリーンの1歳くらいの男の子で、きりっとした顔つき（「欲しいのさシ○バ」篇のCMのロシアンブルーの子がイメージに近いです）\n・右目に眼帯を着用（色は黒で、デザインは殺し屋さんと同じでも別でも構いません）\n・性格は温厚で見た目はクール、子猫時代に自分を助けてくれた殺し屋さんのことが大好きにも拘らず、シャイなせいでいつも素っ気ない態度を取ってしまう\n\n【シチュエーションについて】\n・ヨーロッパの古いアパートメント風の屋内\n・仕事を終え、帰宅した殺し屋さんが玄関に入ってきたところを、俯瞰の構図で相棒の猫が迎える\n・帰りが遅いのを直前まで心配していたのに、それをおくびにも出さずむしろ悠然と、「今日は随分遅かったな」と殺し屋さんを見上げる感じでお願いいたします\n\nあくまでイメージなので、背景は細かく描写していただかなくて大丈夫です。前回のリクエストでは、こちらの説明不足で大変失礼いたしました。\n殺し屋さんのイラストと対になるようA4（2894×4093）での制作を希望ですが、先生の手のご負担になる場合はサイズの変更、またはキャンセルしていただければ幸いです（完治されて安堵いたしましたが、これからもご無理なさらずお大事になさってください…！）。\n\n最後までお読みいただきありがとうございました。\n\n使用目的：個人鑑賞、自アカウントでのツイート（過去作品含む）、SNSのアイコン並びにヘッダー（カバー）、PC用壁紙など。\n※プロフィールに先生のお名前を明記の上、目的外の使用はいたしません。", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@siro1000/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 381907, "client_id": 335321, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/71d4c38c/requests/181204_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=054f3a093129659519fc2e3fbbf4cfc1", "srcset": "https://si.imgix.net/71d4c38c/requests/181204_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=054f3a093129659519fc2e3fbbf4cfc1, https://si.imgix.net/71d4c38c/requests/181204_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=9d87eb3ce3f32968c6552a38f0d20a57 2x, https://si.imgix.net/71d4c38c/requests/181204_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c6d030dfa2e4b382f46915f183d9fdea 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/71d4c38c/requests/181204_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e1f053deb59631bf8c8231d3d14d484d", "srcset": "https://si.imgix.net/71d4c38c/requests/181204_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e1f053deb59631bf8c8231d3d14d484d, https://si.imgix.net/71d4c38c/requests/181204_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=f55c6d76631062a131f7242d3a8f5b4f 2x, https://si.imgix.net/71d4c38c/requests/181204_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=b3fe62a574ea9c7526296fe1623d59de 3x"}, "body": "現在漫画の製作でお忙しいのは存じておりますが、キャンペーンでクリエイターの手数料が無料っぽいので（勘違いだったら恥ずかしい）とりあえず依頼だけ出しておきます。設定された製作期間を十分に考慮された上で承認可否をお願い致します。本来なら来年以降にお願いしようと思っていましたので、却下されたら出直します。\n\n私の中世ヨーロッパ風ファンタジーの一次創作ヒロインをお願いします。↓こちらのツイートの2枚目と3枚目の女の子です。\nhttps://twitter.com/kooky_armeniaca/status/1276672846467457024\n服は2枚目左か3枚目左でお願いします。\n\n絵に含めていない設定で、表情の参考になりそうなものは以下の通りです。\n・10歳で孤児院に入っているが、物語冒頭で突然孤児になったため悲壮感はあまりない。\n・明るくて天然気味。\n・絵を描くのが好きで、画家の元で手伝いをしている。\n・信念がしっかりとあって、歳の割に大人びた考え方をする。\n・未来少年コナンのラナやラピュタのシータみたいな？\n\n以下は構図の注文です。優先順位の高い順に書いています。可能な範囲までお願いします。\n・2020年のネズミの年賀絵みたいな構図とイメージ\n・イメージカラーは白・ベージュ・淡いピンク\n・丸い額縁っぽいモチーフの中にバストアップ～顔くらい\n・顔の向きは正面でも横でも斜めでもいいですが、カメラ目線でお願いします。\n・モチーフは植物でも幾何学模様でも素材でも大丈夫です。\n・以前依頼した絵に使ったスノードロップとかいいかもしれない…？\n・舞台がアイルランドイメージなので、それっぽい雰囲気だと嬉しいです。\n・シンプルで使い込んだスケッチブックを1冊持たせて下さい。\n\nよろしくお願いします！", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@siro1000/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 381907, "client_id": 262123, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/6963224d/requests/80305_1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=839d46faabcaa2c5bb62fd208fb97db2", "srcset": "https://si.imgix.net/6963224d/r