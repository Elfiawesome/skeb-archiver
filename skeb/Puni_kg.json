せいで標準体重をかなりオーバー\n\nアフター\n・マシュマロ系おっとり美女\n・ちょいぽちゃ\n・約20キロ増\n\n参考ストーリー\n冒険者になり、報酬のほとんどを食につぎ込んだらあれよあれよと言う間に爆乳になる。\n胸が重すぎて冒険者を引退し、自分のお店をつくる。\n運動量激減、お客を手玉に取りに毎日かなりの貢ぎ物をもらいぽっちゃり体型に。", "nc": 48, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Puni_kg/works/7", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/8d02871f/uploads/origins/693c83b1-d2cc-498d-8f04-d42a1a517d54?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=328e43e64160592375d08f4b0450b7ff", "srcset": "https://si.imgix.net/8d02871f/uploads/origins/693c83b1-d2cc-498d-8f04-d42a1a517d54?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=328e43e64160592375d08f4b0450b7ff, https://si.imgix.net/8d02871f/uploads/origins/693c83b1-d2cc-498d-8f04-d42a1a517d54?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=5d7ac18f1bc9a1162214978b56e7757f 2x, https://si.imgix.net/8d02871f/uploads/origins/693c83b1-d2cc-498d-8f04-d42a1a517d54?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=dcb02cf499efd4c79e56f8a5f375814f 3x"}, "private": true, "genre": "art", "tipped": false, "creator_id": 3570471, "client_id": 3594798, "nc": 48}, {"path": "/@Puni_kg/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3570471, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/9bfd1923/uploads/origins/4f6d53e5-eb53-44b4-8ca4-a8ea2a40620a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fb41d9159bbcb6c9d036532435e510a7", "srcset": 