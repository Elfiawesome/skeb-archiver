。\n重要な点として、ほとんどの陸生カタツムリと同様、この種も右巻き殻を持っています。そのため、画像を左右反転させてはいけません。反転させると左巻き殻になってしまいますが、自然界にはそのような個体は存在しないからです。\n\nhttps://www.dropbox.com/scl/fo/uv0fjcd9emnjt963zdcq8/ABVlL632Xp6QqJ1rwio7WZw?rlkey=o8i99mm3xepf55mzce6xitzuw&st=2xm7bjfq&dl=0", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@good_morning712/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3092925, "client_id": 1089271, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/582db871/uploads/origins/0f6ea63b-9c7f-4655-a303-886170188e7d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b7ba1e410bd3d494911b30b22ad439ec", "srcset": "https://si.imgix.net/582db871/uploads/origins/0f6ea63b-9c7f-4655-a303-886170188e7d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b7ba1e410bd3d494911b30b22ad439ec, https://si.imgix.net/582db871/uploads/origins/0f6ea63b-9c7f-4655-a303-886170188e7d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=0fc46812341b8cbaa5e538ed490b7d7a 2x, https://si.imgix.net/582db871/uploads/origins/0f6ea63b-9c7f-4655-a303-886170188e7d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d7d7d6221a4b76ca573139b75871d397 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/582db871/uploads/origins/0f6ea63b-9c7f-4655-a303-886170188e7d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=26d35cae09d7d6944dd97699f2a9bcdb", "srcset": "https://si.imgix.net/582db871/uploads/origins/0f6ea63b-9c7f-4655-a303-886170188e7d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=26d35cae09d7d6944dd97699f2a9bcdb, https://si.imgix.net/582db871/uploads/origins/0f6ea63b-9c7f-4655-a303-886170188e7d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=20