/1ec8a452-69b1-4229-afe2-48e21683efac?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=4130beeafd643d4a17d16757693c766e 3x"}, "body": "いつも素晴らしいイラスト拝見させていただいております。\nらき☆すたの柊かがみと泉こなたでサイズシチュをお願いしたいです。\n\n・シチュエーション\n泉こなたが柊かがみの膣に気付かれないように入り込んで、子宮口の前で自撮りした写真を柊かがみに送る。\n写真を受け取った柊かがみは顔を赤くしながら驚愕し、混乱している…\n\n・構図\n柊かがみが携帯端末を見て驚き赤面している姿を大きめに、ローアングルでスカートの中を覗き込みつつ顔も見えるようなアングルで描いていただきたいです。\nお腹のあたりから吹き出しのように小窓を出していただいて、泉こなたが子宮口を背に自撮りをしている様子も描いていただけると嬉しいです。\n\n・少しだけ要望…\n余裕がありましたら、かがみんが膣をギュッと締めてこなたを肉壁で抱きしめる差分があると嬉しいです。\n小窓の方で法悦とした表情で締め付けられるこなたを描いていただけると最高です。\n\n気が向かれましたらよろしくお願いいたします。", "nc": 41, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@hioriumu/works/11", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/b4115c8b/uploads/origins/b209230c-9055-4384-876f-87f5aaa3c60c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=6e6da10a3e032665a90e1d184af6f96b", "srcset": "https://si.imgix.net/b4115c8b/uploads/origins/b209230c-9055-4384-876f-87f5aaa3c60c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=6e6da10a3e032665a90e1d184af6f96b, https://si.imgix.net/b4115c8b/uploads/origins/b209230c-9055-4384-876f-87f5aaa3c60c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=5b27fdb50616860027f995d86db228c4 2x, https://si.imgix.net/b4115c8b/uploads/origins/b209230c-9055-4384-876f-87f5aaa3c60c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=dfd80897628ae802e1047250a0843fd0 3x"}, "private": true, "genre": "art", "tipped": true, "creator_id": 382031, "nc": 50}, {"path": "/@hioriumu/works/10", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 382031, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/b7aa14fd/uploads/origins/95992407-5996-4604-8ef3-fe0fa28b385d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a41500ceb2e0ff709395c54bff2d85bc", "srcset": "https://si.imgix.net/b7aa14fd/uploads/origins/95992407-5996-4604-8ef3-fe0fa28b385d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a41500ceb2e0ff709395c54bff2d85bc, https://si.imgix.net/b7aa14fd/uploads/origins/95992407-5996-4604-8ef3-fe0fa28b385d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=58acd066a95af8b1fe975c7e5f184339 2x, https://si.imgix.net/b7aa14fd/uploads/origins/95992407-5996-4604-8ef3-fe0fa28b385d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=6118d297332ed7fcf7dad94baecc0eb6 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/b7aa14fd/uploads/origins/95992407-5996-4604-8ef3-fe0fa28b385d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3b84d857512fc928ac2a2f1c7f7f3503", "srcset": "https://si.imgix.net/b7aa14fd/uploads/origins/95992407-5996-4604-8ef3-fe0fa28b385d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3b84d857512fc928ac2a2f1c7f7f3503, https://si.imgix.net/b7aa14fd/uploads/origins/95992407-5996-4604-8ef3-fe0fa28b385d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=4734b8d8dbdc7e73beae90d73f985248 2x, https://si.imgix.net/b7aa14fd/uploads/origins/95992407-5996-4604-8ef3-fe0fa28b385d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=5e25a6de6e7f2bdeb2bde6b22fcbf1bc 3x"}, "body": "ひおのんのよしのんが見たい…！　という事で依頼させて頂きます。\n\n【シチュ詳細】\n◆　服装・サイズ\n「水影のうなさか」というカードの水着芳乃(かき氷食べてて、紫パーカー着てる方)が、砂浜で小人と戯れているシーンをお願いします。サイズは小人側が100分の1です。\n自分は海水浴をしてきたばかりで、今度は小人を遊ばせてあげようというシチュですので、髪や水着がちょっぴり湿って肌にくっついたり、ちょっと乳首とか透けてると尚良いです…\nパーカーのジッパーの開き具合も、元絵レベルが丁度良いです。存分に胸元を見せつけていけ……俺はちっぱいが好きだ！！！\n\n◆　ポーズ・アングル\n正座している芳乃のお股の所に海水を溜めて、そこで小人達が泳いでいる様子を、口を閉じて文句も言わずに慈愛に満ちた顔で見下ろしてます。その様子をローアングルよりちょっと高め（※下記参照）で、ただ芳乃の顔は見えるように描いて欲しいです。せっかく正座しているので、後ろの方で裸足の足裏もチラリと見えると良いですね…！\n\n※アングルのイメージは、ここのピンク色の絵からもうちょっとハイアングルになったくらいです…\nhttps://ichi-up.net/2016/089\n\n腕は両方とも横に垂らして砂浜に手を付いてます。よしのんと海水浴を楽しむ為に、砂浜に居る小人達が手や脚からよじ登ろうとしている様子も欲しいですが、3人くらいで良いです（沢山居ると集合体恐怖症を発症しそうで…）\n\n◆　その他\nセリフは無しで大丈夫です。背景は砂浜と雲ひとつ無い青空。お昼時で太陽が真上から照ってます。\n下の方だけ水着無し差分があると嬉しいですが、それはよほど余裕があればという事で…\n\n以上、宜しくお願いします！　ご無理のない範囲で！", "nc": 161, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@hioriumu/works/9", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 382031, "client_id": 301794, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/5fe3449c/uploads/origins/ef1b613a-0523-4f4e-9438-7b5ca6a8db68?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=72ac2a5a71932adf0d1ec8dff1a3f631", "srcset": "https://si.imgix.net/5fe3449c/uploads/origins/ef1b613a-0523-4f4e-9438-7b5ca6a8db68?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=72ac2a5a71932adf0d1ec8dff1a3f631, https://si.imgix.net/5fe3449c/uploads/origins/ef1b613a-0523-4f4e-9438-7b5ca6a8db68?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=cc600113114fe94380d9aa0904e7fe41 2x, https://si.imgix.net/5fe3449c/uploads/origins/ef1b613a-0523-4f4e-9438-7b5ca6a8db68?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=71a6f0c9d381b8667da56896591662b5 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/5fe3449c/uploads/origins/ef1b613a-0523-4f4e-9438-7b5ca6a8db68?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=278772394a1d85adf188cac9cd0ab545", "srcset": "https://si.imgix.net/5fe3449c/uploads/origins/ef1b613a-0523-4f4e-9438-7b5ca6a8db68?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=278772394a1d85adf188cac9cd0ab545, https://si.imgix.net/5fe3449c/uploads/origins/ef1b613a-0523-4f4e-9438-7b5ca6a8db68?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=63ace1b57b22e1d7d6b6499a6133ed96 2x, https://si.imgix.net/5fe3449c/uploads/origins/ef1b613a-0523-4f4e-9438-7b5ca6a8db68?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=ddde6c379fd9454896a5385dd7e0a0b5 3x"}, "body": "・シュリのおしっこ＆胎内挿入シチュ。\n　幼女が和式トイレでおしっこをする体勢になってて、股間に縮小男性達が張り付いている。\n\n・イラストの視点は便器底の縮小男性視点。\n　縮小男の位置は、便器の排水部分奥の落ちるギリギリの位置。\n　イラストは水面から顔も含む。\n\n　イラストの向きは縦向き。上下でスクロールできる。\n\n・幼女\n　小学一年生。胸の膨らみは一切無し。あばら骨が浮き出るくらい痩せている。\n　服装は、全裸。\n\n\n・経緯\n　1cm位の縮小男性達が幼女のパンツに入って、蒸れた股間に張り付く。\n　幼女が和式トイレに入っておしっこ体勢になる。\n\n　縮小男達は無事にやり過ごす為にそれぞれ対応している。\n　例：膣内部に入ろうとする、股間外側に張り付いたままでいる、豆にしがみつく等\n　　　何人から対策が取れていない。尿道口に居る、便器に落下中等", "nc": 184, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@hioriumu/works/8", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 382031, "client_id": 129393, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/439bf611/uploads/origins/d5b449ed-e011-4707-86ab-4ab0fd04c8db?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d6808dbb7046f5b7c37d5ae93a7a1163", "srcset": "https://si.imgix.net/439bf611/uploads/origins/d5b449ed-e011-4707-86ab-4ab0fd04c8db?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d6808dbb7046f5b7c37d5ae93a7a1163, https://si.imgix.net/439bf611/uploads/origins/d5b449ed-e011-4707-86ab-4ab0fd04c8db?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=bf33532f42525c2a1e8202c