ン」の2点をお願いいたします。\n\nまた、参考画像では髪の横の部分を耳にかけるとピアスが見えるデザインになっています。\nもし構図的に入れられそうでしたら、ピアスも描いていただけると嬉しいです。\n\nどうぞよろしくお願いいたします！\n\nhttps://x.com/i/status/2085993158798877086", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@waboku2015/works/9", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 4057555, "client_id": 4063396, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/99698523/uploads/origins/251c89c7-2724-43f5-855a-fc6ac7790978?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bbab36754dfb1dbc3e1be5e5e95bf588", "srcset": "https://si.imgix.net/99698523/uploads/origins/251c89c7-2724-43f5-855a-fc6ac7790978?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bbab36754dfb1dbc3e1be5e5e95bf588, https://si.imgix.net/99698523/uploads/origins/251c89c7-2724-43f5-855a-fc6ac7790978?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=6a020ddb1b604773eeb5d741b092d54e 2x, https://si.imgix.net/99698523/uploads/origins/251c89c7-2724-43f5-855a-fc6ac7790978?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=9d94d82b6fe53f972cadff798a31be5d 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/99698523/uploads/origins/251c89c7-2724-43f5-855a-fc6ac7790978?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=38bd7ff078c5170fcd75a47839efdc46", "srcset": "https://si.imgix.net/99698523/uploads/origins/251c89c7-2724-43f5-855a-fc6ac7790978?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=38bd7ff078c5170fcd75a47839efdc46, https://si.imgix.net/99698523/uploads/origins/251c89c7-2724-43f5-855a-fc6ac7790978?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=87c40b4bf1f72a9aaf3e24322100388c 2x, https://si.imgix.net/99