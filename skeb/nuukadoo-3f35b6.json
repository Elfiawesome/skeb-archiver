-4312-9030-a5dc0ee4ba61?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=acccf20750218843def86b1465ba28e3", "srcset": "https://si.imgix.net/12ddb53c/uploads/origins/82c5a610-195a-4312-9030-a5dc0ee4ba61?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=acccf20750218843def86b1465ba28e3, https://si.imgix.net/12ddb53c/uploads/origins/82c5a610-195a-4312-9030-a5dc0ee4ba61?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=687bbd7115594966c9cea2f4c3a4049a 2x, https://si.imgix.net/12ddb53c/uploads/origins/82c5a610-195a-4312-9030-a5dc0ee4ba61?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d2263739d28186c1dd3d934a29b7b81e 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/12ddb53c/uploads/origins/82c5a610-195a-4312-9030-a5dc0ee4ba61?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5e8759157bf31613f81d0bb89cbc274a", "srcset": "https://si.imgix.net/12ddb53c/uploads/origins/82c5a610-195a-4312-9030-a5dc0ee4ba61?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5e8759157bf31613f81d0bb89cbc274a, https://si.imgix.net/12ddb53c/uploads/origins/82c5a610-195a-4312-9030-a5dc0ee4ba61?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=68455d3c69757218d42dc35fc2e789ef 2x, https://si.imgix.net/12ddb53c/uploads/origins/82c5a610-195a-4312-9030-a5dc0ee4ba61?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=ba7d02258eb4a511c85047ce58f6a19a 3x"}, "body": "Nuu様、はじめまして！\nskebで素敵な絵を拝見し、一目惚れをして依頼させていただきました！\n\n私と友人のOCをお願いしたいです！(友人からは許可を貰ってます)\n\n2人は学生時代からの仲で、犬猿の仲。\n十数年片想いを拗らせ、今はお付き合いしています。\n今でも喧嘩はよくしていますが、口喧嘩ばかりで仲は良いです。\n\n\n蛇目主水\n男/26歳/182cm\n目…黒目に赤の瞳孔(蛇のような目)ジト目 髪…白髪のストレート アクセサリー…首から下全身に刺青(花など綺麗なもの)\n極道者\n無愛想で口が悪い。あまり人付き合いは良くないが、舎弟には慕われている。\nぶっきらぼうで言葉が足りないが、愛情表現は全て行動で表すような不器用な男。\n態度は悪いが、相手のことを心から思っており相手には見えないところで優しい表情をして見てることがある。\n黒猫と白猫を飼っている。趣味は料理と掃除\n\n斑目 桔梗\n男/26歳/177cm\n目…右が黄色、左が赤のオッドアイ 髪…黒髪の少し癖っ毛 アクセサリー…右の耳に長めのピアスをしている\n落語家\n愛想が良く、人付き合いも上手い。\n好きなものにストイックで努力家。落語家の家系で兄や父が優秀なので負けず嫌いで日々努力を重ねている。\nそれ以外は不器用でポンコツ。\n恋愛に関しても不器用で中々素直になれないが、相手があまりにも言葉にしないため代わりに言葉を伝えている。\n相手のことがなんだかんだ放っておけない\n\n2人は恋人同士ですが、距離感の近い友人のような関係です。 口喧嘩はよくしますが仲良しです。\nお互い何気ない2人の時間を大切にしています。\n\n服装や構図などNuu様のお好きに描いていただけますと嬉しいです！\n不備や不足などありましたら、再送依頼もしくはキャンセルを頂ければと思います。\nご検討よろしくお願い致します！\n\nhttps://drive.google.com/drive/folders/1-ZHUiF43xmvI41TdAewPRdFFUa-z3Nv5\n\nhttps://drive.google.com/drive/folders/1-ZHUiF43xmvI41TdAewPRdFFUa-z3Nv5", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@nuukadoo/works/3", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/b3157c8f/uploads/origins/0b59a5f2-6dc6-418d-841b-3f2e09eda551?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=59ea53843c0c67b88227c47cd690671a", "srcset": "https://si.imgix.net/b3157c8f/uploads/origins/0b59a5f2-6dc6-418d-841b-3f2e09eda551?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=59ea53843c0c67b88227c47cd690671a, https://si.imgix.net/b3157c8f/uploads/origins/0b59a5f2-6dc6-418d-841b-3f2e09eda551?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=dacad0a5925db7611bb0dd7f15bcfbb5 2x, https://si.imgix.net/b3157c8f/uploads/origins/0b59a5f2-6dc6-418d-841b-3f2e09eda551?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=d42b1812632c75be09047cb3c7cf327b 3x"}, "private": true, "genre": "art", "tipped": false