髪型】\n3種ありますがどれでもお好きなものを描いて頂けますと幸いです。\n\n【表情差分】\n・微笑み（開口）\n・ぺろっと舌を出していたずらな笑みを浮かべている\nの【2種】を可能でしたらお願いしたいです。\n\n【背景】\nこちらはお任せいたします。\n\n【その他】\n可能でしたらXに上がっておりました詰め合わせイラストを希望したいです🙇‍♀️\n━━━━━━━━━━━━━━━━━\n\n最後まで読んでいただきありがとうございました...!\n以上、長くなりましたが詳細になります。\n\nお忙しい中恐縮ですが、ご検討いただけますと幸いです。\nどうぞよろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/1gbJ7ut5QmKqYNevFg2nG39qnVkSUErPr?usp=drive_link", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 398838, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "ヒヨヨ@skeb募集中（特殊な内容もOK！）", "screen_name": "kou_hiyoyo", "avatar_url": "https://pbs.twimg.com/profile_images/1820725109768003584/nFqwhAAN.png", "header_url": "https://pbs.twimg.com/profile_banners/105523086/1725285923/1500x500", "appeal_receivable": false, "popular_creator_rank": 6, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 10, "complete_expiration_days": 90, "skills": [{"genre": "art"}, {"genre": "comic"}], "banned": false, "nc": 160}, {"id": 1268584, "creator": true, "nsfw_acceptable": false, "acceptable": false, "name": "しゃけ", "screen_name": "noripasuta", "avatar_url": "https://pbs.twimg.com/profile_images/1405702394411765762/zejFjUQh.png", "header_url": "https://pbs.twimg.com/profile_banners/1071079376735764481/1623983959/1500x500", "appeal_receivable": false, "popular_creator_rank": 97, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "correction"}], "banned": false, "nc": 177}, {"id": 2672175, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "あんぜんロボ", "screen_name": "474zz", "avatar_url": "https://pbs.twimg.com/profile_images/1933729755058282497/sSOhUSX9.jpg", "header_url": "https://pbs.twimg.com/profile_banners/149819654