3%A5%E3%83%AC%E3%83%BC%E3%82%BC%E3%83%B3%E3%83%AD%E3%83%BC%E3%83%88/artworks\n\n予算内で時間に余裕がありましたら、クールめに真顔と、ニヤリと微笑むなどの、同じ構図内で簡単な表情差分をお願いします。\n\nヴィネット風ともちょっと異なってしまいますが、可能でしたらお受けいただければ嬉しいです！\n\nhttps://www.pixiv.net/artworks/80507014", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 256, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "筆禍＠ぴかすす（仮）制作中", "screen_name": "hikka06", "avatar_url": "https://pbs.twimg.com/profile_images/2006119699592142849/fJ43NdIe.jpg", "header_url": "https://pbs.twimg.com/profile_banners/85097065/1737786245/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 14, "complete_expiration_days": 90, "skills": [{"genre": "art"}, {"genre": "comic"}], "nc": 32}, {"id": 829716, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "如月 ノラ", "screen_name": "alleycat_zzZ", "avatar_url": "https://pbs.twimg.com/profile_images/2017324862654844934/RVMi87aA.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1571497837/1751651879/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "art"}, {"genre": "correction"}], "nc": 145}, {"id": 1782339, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "栗海", "screen_name": "kuri_umy", "avatar_url": "https://pbs.twimg.com/profile_images/1693628658563330048/u6wzyw9n.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1378710505796198403/1719500960/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "