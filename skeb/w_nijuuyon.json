がお風呂でロハナの胸を後ろから鷲掴みして驚かせる。ルフィーナはロハナの体が淫らだとからかう。\n次のコマでは、ロハナがルフィーナのアソコに指を急速に突っ込んでいる。ルフィーナは快感に打ちひしがれ、ロハナの胸に顔を押し付けて淫らなオーガズムの表情を作る。ロハナは、ルフィーナがロハナに構ってほしいなら、優しくお願いすればいいとたしなめる。\n\n台詞は日本語で結構です。セリフは自由に修正してください。\n背景は重要ではありませんが、参考資料に収録されているローマ風の風呂です。\n\n使用用途：sns、oc活動、個人的な閲覧のみを目的とした画像の印刷の可能性。\nいずれにせよ、このリクエストをお読みいただきありがとうございました！\n\nhttps://drive.google.com/drive/folders/18RS270HH4L6qnsT_gFo_jiG7U6s1QrEE?usp=drive_link", "nc": 184, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@w_nijuuyon/works/130", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/a5c09b79/uploads/origins/67abd0a2-6ca7-4137-90ba-2b9104160a9d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=a2d949137c6538885ee71ab715f892ae", "src_set": ""}, "private": true, "genre": "art", "tipped": false, "creator_id": 110383, "client_id": 2340587, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 32, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@w_nijuuyon/works/129", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 110383, "client_id": 254239, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/29ab01f2/uploads/origins/88d69d56-7f3f-42a1-8922-7bd4acdcd1fa?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=affcfe99494bed363266c899bbac6609", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/29ab01f2/uploads/origins/88d69d56-7f3f-42a1-8922-7bd4acdcd1fa?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=384de0aff284bc15d12ae68f3922b425", "src_set": ""}, "body": "はじめまして。ブラウンダスト2のエクリプスさんとのオネショタシーンをお願いしたいです！衣装やショタのデザイ