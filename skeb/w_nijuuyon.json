n": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/1dc07ba7/uploads/origins/d3c87dde-2cdc-4bb4-9da0-d7c7d93a8c24?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6df68c0681b1e90757c5ecfb37501029", "src_set": ""}, "body": "こんにちは、先生！(っ´꒳`)っノ\nイラストをお願いしたいです。\n\n都合が悪ければ遠慮なくお断りください。\nご検討いただけるとありがたいです。\n( ノ_ _)ノ\n\n\n📇 - [\"黒子\"] ：\n\nサキュバスとヴァンパイアの特徴を持つアンドロイド＆研究者。機械仕掛けの尻尾が特徴。\n🔗\nhttps://drive.google.com/file/d/1bV0MXX6PLezhXMT1CsOjJGSui87wnkcA\n\n時にはサディスティックで独りよがり。\nでも大抵は穏やかで優しい。懐かしき無敵のお姉さんのように。\n\nリクエスト】 📜 ：\nウテナちゃんの描き方がすごく好きでした！\nhttps://skeb.jp/@w_nijuuyon/works/96\n\nできれば、黒子とウテナが親密にぎゅっと抱き合っている、居心地のいい雰囲気で描いてください。黒子の方がややコントロールしやすい。\nもしよろしければ、黒子がウテナの血を噛んだり吸ったり、尻尾を巻きつけたりしているところも描いてください。\n\n細部、衣装、着せ替えは自由です。\nその他のシーンも自由に追加してください。\n台詞があれば日本語でも可。\n\nよろしくお願いします。\n良い一日を。\n\nhttps://drive.google.com/drive/folders/16bjQyGZzp-LwtnYRIBqC67mvlzDi32vg?usp=drive_link", "nc": 177, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "similar_creators": [{"id": 108749, "creator": true, "nsfw_acceptable": true, "acceptable": false, "name": "ES", "screen_name": "sokonuko", "avatar_url": "https://pbs.twimg.com/profile_images/1507158405529890818/sfCG2CVI.png", "header_url": "https://pbs.twimg.com/profile_banners/292132421/1648383932/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 7, "skills": [{"genre": "art"}], "nc": 33}, {"id": 124593, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "にょわわ@アリクイ", "screen_name": "cmaoyan", "avatar_url": "https://pbs.twimg.com/profile_images/1361251329272803329/waGkdxuY.jpg", "header_url": "https://pbs.twimg.com/profile_banners/874286340895940610/1698085742/1500x500", "appeal_receivable": true, "popular_creator_rank": null, "request_master_rank": null, "first_requester_r