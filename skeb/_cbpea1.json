%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=fa0786a04e07bec865432433948b95cb", "src_set": ""}, "body": "すももさん、こんにちは。Skebを使うのは3回目です。\n\n私のオリジナルキャラクター「ステラ」を描いてほしいです。明るく元気な女性です。私のキャラクターを自由に描いてください！\n\n個人的な使用のみとさせていただきます。よろしくお願いします！\n\nhttps://drive.google.com/drive/folders/1QrUYMLT1mHGF-Cifpb9KGqf0gHBbSmYv?usp=sharing", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@_cbpea1/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3402282, "client_id": 3346971, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/f47d2912/uploads/origins/8faa2d80-445a-4b2e-a5ce-86e4f280021a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=18acd0248dcd1f4140e922528316f43f", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/f47d2912/uploads/origins/8faa2d80-445a-4b2e-a5ce-86e4f280021a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c80ad5b552a1de40e7835b6ef575aecc", "src_set": ""}, "body": "いつもイラスト楽しく拝見しております。\nVtuberをやっている、白兎(はくと)ようと申します！\n\n今回、小桃田すもも様に配信等に使うサムネイル用の絵が欲しくて描いて頂きたいと思っています。\n\nいつも描いていらっしゃるイラストも、もちろん大好きなのですが、小桃田すもも様節が効いているイラストも結構好きで、下記リンクポストのような、ガタイの良い私を描いていただきたいと思っております。\nhttps://x.com/_cbpea1/status/1949488904803057715\n\nキャラデザについては、立ち絵・三面図を用意させていただきましたので資料の方確認していただければ幸いです\nhttps://drive.google.com/drive/folders/1NwvzRe7u933OYhT4ZZU6XNuh8GFmGaAQ?usp=sharing\n\n納品はPSDファイルでお願いしたいです。\nポーズや描写範囲等はおまかせします。\n\nhttps://drive.google.com/drive/folders/1NwvzRe7u933OYhT4ZZU6XNuh8GFmGaAQ?usp=sharing", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@_cbpea1/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3402282, "client_id": 2697319, "vtt_url": null, "thumbnail_image_url