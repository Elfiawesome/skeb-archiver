1/uploads/origins/0de4680e-1de7-4e58-80e2-4ca2388623ad?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=97ff81658be4e5cf63a2f0585bb76399 3x"}, "body": "お世話になっております。\n先程納品いただいてすぐになってしまうのですが、\n再度、ビートラスのラミルをリクエストお願いします。\nラミルのコスチュームは前回同様の乳首のラインが浮き出たスーツに透明バイザーのヘルメットを装着し(唇にルージュ有)、ポーズは作者様がセクシーと思うポーズをとってカメラ目線で優しく微笑んで誘っているようにしていただければと思います。\n以上、よろしくお願いします。", "nc": 161, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@ciao_oppai_ron/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 20235, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/af3698e7/uploads/origins/58771cf8-3740-44b9-ac3d-ccd84f7b1e86?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a90de49d6fa26fac422ac686fa9a9636", "srcset": "https://si.imgix.net/af3698e7/uploads/origins/58771cf8-3740-44b9-ac3d-ccd84f7b1e86?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a90de49d6fa26fac422ac686fa9a9636, https://si.imgix.net/af3698e7/uploads/origins/58771cf8-3740-44b9-ac3d-ccd84f7b1e86?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=fe9ef52ce92241f0761bbd91fecc4fea 2x, https://si.imgix.net/af3698e7/uploads/origins/58771cf8-3740-44b9-ac3d-ccd84f7b1e86?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=8acaa57423696ab5e5b0da276b08c7b4 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/af3698e7/uploads/origins/58771cf8-3740-44b9-ac3d-ccd84f7b1e86?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ee4bf7b12c6e464b737dd30c0f099ded", "srcset": "https://si.imgix.net/af3698e7/uploads/origins/58771cf8-3740-44b9-ac3d-ccd84f7b1e86?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ee4bf7b12c6e464b737dd30c0f099ded, https://si.imgix.net/af3698e7/uploads/origins/58771cf8-3740-44b9-ac3d-ccd84f7b1e86?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=cd11933aa54576e31fe0999a3a79f6d2 2x, https://si.imgix.net/af3698e7/uploads/origins/58771cf8-3740-44b9-ac3d-ccd84f7b1e86?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=afcd45685fb4cb88d6f7c72e0da8fc96 3x"}, "body": "初めまして。80sアニメのアートを描くとのコメントに惹かれましてリクエストさせていただきます。\n\nアニメではないのですがプラモデル化した作品で「機甲虫隊ビートラス」という作品に登場するヒロイン「ビート・ラミル」を描いていただきたいのです。\n\nシチュエーションとして資料の通りのコスチュームでヘルメットを装着しバイザーを無色透明でお願いします。\nまた、胸を若干大きめにして乳首のラインがスーツ越しでもわかるようにクッキリとさせてください。\nポーズはお任せしますが、カメラ目線で優しく微笑ませてください。可能であれば唇にうっすらとピンクのルージュを塗ってください。\nよろしくお願いします。\n\nhttp://diaclone.net/gattaioh/beet/story.html", "nc": 49, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@ciao_oppai_ron/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 20235, "client_id": 71184, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/a34781fd/uploads/origins/c297df94-d438-4719-a7d3-7f36a3997ec9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bf7035051e0f165cc5234f5ced1065f6", "srcset": "https://si.imgix.net/a34781fd/uploads/origins/c297df94-d438-4719-a7d3-7f36a3997ec9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bf7035051e0f165cc5234f5ced1065f6, https://si.imgix.net/a34781fd/uploads/origins/c297df94-d438-4719-a7d3-7f36a3997ec9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=654fa1c21ef2014764bc1a9a4965a701 2x, https://si.imgix.net/a34781fd/uploads/origins/c297df94-d438-4719-a7d3-7f36a3997ec9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d6d0b9e67d510e455c183679d2531377 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/a34781fd/uploads/origins/c297df94-d4