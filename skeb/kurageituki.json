-bb15-2e7c7076b2e8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=7ee25f1627c87de8be0548edc599b890 2x, https://si.imgix.net/344001bc/uploads/origins/bc0cf53a-86e2-4a6c-bb15-2e7c7076b2e8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=7052cedcda26e60f6f345ce529869289 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/344001bc/uploads/origins/bc0cf53a-86e2-4a6c-bb15-2e7c7076b2e8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=07d2a0d22bcb0347cca42577eda88082", "srcset": "https://si.imgix.net/344001bc/uploads/origins/bc0cf53a-86e2-4a6c-bb15-2e7c7076b2e8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=07d2a0d22bcb0347cca42577eda88082, https://si.imgix.net/344001bc/uploads/origins/bc0cf53a-86e2-4a6c-bb15-2e7c7076b2e8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=d1126c65af93db51e1c7158511c449ce 2x, https://si.imgix.net/344001bc/uploads/origins/bc0cf53a-86e2-4a6c-bb15-2e7c7076b2e8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=f7690a3341f4f41ecec04d4328982859 3x"}, "body": "はじめまして、Twitterいつも拝見しています。\n上げられているイラストか好みだったのでリクエストさせていただきます。\n\n『緊縛間宮さん』\n【キャラクター】\n艦隊これくしょん：間宮さん\n【衣装】\n公式衣装。下着は身に着けておらず、服の下で亀甲縛りされている。前後にバイブ挿入。\n【シチュエーション】\n『間宮』店舗内でスカートを捲り自分の下半身を露出する間宮さん\n【状況詳細】\n提督により縛られバイブ挿入したまま普通にお店に出されてる間宮さん。昼過ぎ、落ちついた頃に店に来た提督に促され「どうぞ…、ご覧になって下さい…」とお臍の辺りまでスカートを捲り上げて下半身を見せる。\nバイブは落ちないように縄で固定。愛液で太もも辺りまで濡れてる。陰毛は剃られててパイパンに。\n表情は羞恥と背徳間、バイブからもたらされる快楽で赤く蕩けている。\n昼過ぎの店内という事が分かれば背景に他の人は居なくて大丈夫です。\n\n以上となります。\n御一考して頂ければ幸いです。", "nc": 41, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@kurageituki/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 647645, "client_id": 1113717, "vtt_url": null, "thumbnail_image