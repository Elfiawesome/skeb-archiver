21d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=548faf309ce3ad45881d8d2751c6bc88 2x, https://si.imgix.net/4d26ee62/uploads/origins/402871f4-db9f-41bd-bc0f-64173c5dc21d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=879b4a573bcece83b19574abe815a944 3x"}, "body": "海月いつき先生いつもイラスト拝見しております。\nSkebを開始したとのことで早速リクさせていただきます。\n今回リクしたいのは\n\n艦これ　　牛ビキニ能代　です。\n構図は、前に描かれていた牛ビキニ神通のような感じ　\n恥じらっている。（大好きな提督の前なので嫌悪感等は無し。）\n\n牛ビキニ葛城の時のような牛柄長手袋も欲しいです。\n\n先生描かれるお胸・お尻のムチエロボディが大好きなので今回もそのように描いていただければと思います。\n\n背景は指定しません。白で良いです。\n\nほか細かいところは先生にお任せします。\n\n\nご検討何卒よろしくお願いします。", "nc": 176, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@kurageituki/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 647645, "client_id": 782298, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/8ad8cdc9/uploads/origins/20747c51-f553-48f7-aa17-edbfa8b18545?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=531ddfa6820680d56d2ff8755bf03f17", "srcset": "https://si.imgix.net/8ad8cdc9/uploads/origins/20747c51-f553-48f7-aa17-edbfa8b18545?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=531ddfa6820680d56d2ff8755bf03f17, https://si.imgix.net/8ad8cdc9/uploads/origins/20747c51-f553-48f7-aa17-edbfa8b18545?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=5a9bffb21cd114aa6c4484cc11a8104d 2x, https://si.imgix.net/8ad8cdc9/uploads/origins/20747c51-f553-48f7-aa17-edbfa8b18545?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=819c518c403cf96b109c3500eb0956b0 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/8ad8cdc9/uploads/origins/20747c51-f553-48f7-aa17-edbfa8b18545?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9d7a