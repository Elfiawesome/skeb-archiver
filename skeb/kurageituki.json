、より素敵に見えると思うのであれば、自由に変更してください！\n\nありがとうございました。\n\n参考文献\nhttps://twitter.com/JahMakoto/status/1401539380137787397?t=kNcj9asF2oArelbpS9izBw&s=19", "nc": 177, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@kurageituki/works/10", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 647645, "client_id": 1270370, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/bd6d3978/uploads/origins/7700103a-7f58-4e80-a452-d67824a91f50?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b3d4927bbe6994c74f228ea18984047a", "srcset": "https://si.imgix.net/bd6d3978/uploads/origins/7700103a-7f58-4e80-a452-d67824a91f50?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b3d4927bbe6994c74f228ea18984047a, https://si.imgix.net/bd6d3978/uploads/origins/7700103a-7f58-4e80-a452-d67824a91f50?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=d47cfccf8a5847c4b7df29bc4b0e0c96 2x, https://si.imgix.net/bd6d3978/uploads/origins/7700103a-7f58-4e80-a452-d67824a91f50?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=939da8f125c1504bd2a5b7cf4ddff052 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/bd6d3978/uploads/origins/7700103a-7f58-4e80-a452-d67824a91f50?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=920beed9845ed36fd609277c1dcbda8c", "srcset": "https://si.imgix.net/bd6d3978/uploads/origins/7700103a-7f58-4e80-a452-d67824a91f50?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=920beed9845ed36fd609277c1dcbda8c, https://si.imgix.net/bd6d3978/uploads/origins/7700103a-7f58-4e80-a452-d67824a91f50?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=9c3980e1a966de30a69932bdbdf56918 2x, https://si.imgix.net/bd6d3978/uploads/origi