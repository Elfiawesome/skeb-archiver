f94c416-4a48-455f-803a-76be6f94af89?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ae5d9ff47f23c6f12d1fdf3dd905ce86", "srcset": "https://si.imgix.net/11e47db7/uploads/origins/df94c416-4a48-455f-803a-76be6f94af89?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ae5d9ff47f23c6f12d1fdf3dd905ce86, https://si.imgix.net/11e47db7/uploads/origins/df94c416-4a48-455f-803a-76be6f94af89?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=aea0fbe528cf2cfbeba60bec45314713 2x, https://si.imgix.net/11e47db7/uploads/origins/df94c416-4a48-455f-803a-76be6f94af89?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=ba4fd63eeb3829993e943e9adc3c1b47 3x"}, "body": "初めまして！核座頭先生のおねショタが大変好みで今回リクエストを送らせていただきました\n悪の女幹部にヒーローのサポートをしている少年科学者が色仕掛けで骨抜きにされるシチュをお願いします\n\n女の容姿は爆乳褐色肌のショートヘア（色はピンクか銀色）のセクシーなお姉さん\n寒色系のリップをしていると好ましいです。\n衣装は胸周りが大きく開いてい谷間が見えて爆乳がこぼれそうなほどで、下は食い込みがえぐいハイレグのレオタード風の黒基調コスチューム\nそれにニーハイブーツとグローブにマント着用している女王様風な感じの見た目でお願いします。\n\n\nシチュは豊満な肉体を使いキス手コキやパイズリ等で味方の秘密を吐くまで焦らしながら誘惑するプレイでお願いします。\n相手のフェロモンに頭がクラクラになっている少年へ唇が触れそうなほど顔を近づけ、キスをしたら完全に落ちてしまうがそんなこと気にしないで私とキスをしないかと誘惑している構図があると嬉しいです。\n\n要望が多くなってしまいましたが可能な範囲でどうかお願いします。", "nc": 56, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@satousatotototo/works/16", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1277323, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/f0a989ba/uploads/origins/6373e7f7-9183-4a2f-82ff-1edcc38cdf1d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c99a024b6be8286b782918d95d5dd29f", "srcset": "https://si.imgix.net/f0a989ba/uploads/origins/6373e7f7-9183-4a2f-82ff-1edcc38cdf1d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c99a024b6be8286b782918d95d5dd29f, https://si.imgix.net/f0a989ba/uploads/origins/6373e7f7-9183-4a2f-82ff-1edcc38cdf1d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=895af2e43b9693cd066fd983c81dad63 2x, https://si.imgix.net/f0a989ba/uploads/origins/6373e7f7-9183-4a2f-82ff-1edcc38cdf1d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=5b96ff0eab253db11171eeaf773d1394 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/f0a989ba/uploads/origins/6373e7f7-9183-4a2f-82ff-1edcc38cdf1d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a8f14c1beff4d250949e83dfaf967b3c", "srcset": "https://si.imgix.net/f0a989ba/uploads/origins/6373e7f7-9183-4a2f-82ff-1edcc38cdf1d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a8f14c1beff4d250949e83dfaf967b3c, https://si.imgix.net/f0a989ba/uploads/origins/6373e7f7-9183-4a2f-82ff-1edcc38cdf1d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=40d62fb56969438ac2674e1aff0217ad 2x, https://si.imgix.net/f0a989ba/uploads/origins/6373e7f7-9183-4a2f-82ff-1edcc38cdf1d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=bc7bbd4f515f2416e768d56120e7ee34 3x"}, "body": "はじめまして、私は外国人ですが、先生の作品は大好きです、おねショタシチュのリクエストお願いしてもよろしいでしょうか？\n\nおね\nクール・ビューティー\n銀髪 ポニーテール \n\nショタ\n可愛い系 \n\nエロい服を着た女（ピアス 使用済みコンドーム）と激しいセックスをするショタ。\nしかし、実際にはショタは拘束され、VRマスクをつけている。\n女はオナホールで精液を絞り出し、最後はVRマスクをしたままのショタに貞操具を装着させる。\n\n金額の許す範囲で結構ですので、ご対応いただけますでしょうか。", "nc": 184, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@satousatotototo/works/15", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1277323, "client_id": 50573, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/f7283f7d/uploads/origins/6089276a-6262-4fa0-ac51-2818e8d535fb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=db5f49f7