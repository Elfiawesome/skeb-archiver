。\n二人の爆乳に合わせてデカブラで描いて頂きたいです。\n「汗、湯気、擬音」\n二人の爆乳が汗ばんだ状態にして頂きたいです、谷間のところに湯気と「ムワァ」と言う擬音を書き入れて頂きたいです。\n「台詞」\n二人がショタくんに「どっちのおっぱいが好き」かを聞いている的な台詞を入れて頂きたいです。\n初めてのリクエストで色々と細かい指定で申し訳ありません🙇\n核座頭先生のリクエスト開始を心待ちにしてました！\n何卒ご検討宜しくお願い致します🙇", "nc": 168, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@satousatotototo/works/11", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1277323, "client_id": 894433, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/8132cc78/uploads/origins/cea5fb6b-55b3-456b-a818-aba7edfef1d9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0cf69f796ddee348c2e287f1bfc647c6", "srcset": "https://si.imgix.net/8132cc78/uploads/origins/cea5fb6b-55b3-456b-a818-aba7edfef1d9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0cf69f796ddee348c2e287f1bfc647c6, https://si.imgix.net/8132cc78/uploads/origins/cea5fb6b-55b3-456b-a818-aba7edfef1d9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=274b23784cb58a30b6a519b057a52dc2 2x, https://si.imgix.net/8132cc78/uploads/origins/cea5fb6b-55b3-456b-a818-aba7edfef1d9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=7601d142a13df3dd45a4f0e186d40706 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/8132cc78/uploads/origins/cea5fb6b-55b3-456b-a818-aba7edfef1d9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b0bcdb8ac75110136938aa6c1c668e90", "srcset": "https://si.imgix.net/8132cc78/uploads/origins/cea5fb6b-55b3-456b-a818-aba7edfef1d9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b0bcdb8ac75110136938aa6c1c668e90, https://si.imgix.net/8132cc78/uploads/origins/cea5fb6b-55b3-456b-a818-aba7edfef1d9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=20