to=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4560ecad15807bec272e7dec6b655a95, https://si.imgix.net/30b49e40/uploads/origins/5512438b-9ed6-49ed-8e3a-9d8a38c2d23a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c846b265855b4b22b48eae86d8d035c6 2x, https://si.imgix.net/30b49e40/uploads/origins/5512438b-9ed6-49ed-8e3a-9d8a38c2d23a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=7cdb66de83b502341251daface0a694d 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/30b49e40/uploads/origins/5512438b-9ed6-49ed-8e3a-9d8a38c2d23a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=814a81927e92638e0d0e1344308c7d0f", "srcset": "https://si.imgix.net/30b49e40/uploads/origins/5512438b-9ed6-49ed-8e3a-9d8a38c2d23a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=814a81927e92638e0d0e1344308c7d0f, https://si.imgix.net/30b49e40/uploads/origins/5512438b-9ed6-49ed-8e3a-9d8a38c2d23a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=8c26025ade675d6473619cbeefc76f20 2x, https://si.imgix.net/30b49e40/uploads/origins/5512438b-9ed6-49ed-8e3a-9d8a38c2d23a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=ab1f533803c0d9a92f71f2e42d340bc0 3x"}, "body": "真昼ゆら様、初めまして\n真昼ゆら様の描かれていたイラストをpixivでお見かけしまして、とても美しい瞳と線、そして色遣いにとても惹かれました。\nもしよろしければご依頼させていただきたくリクエストさせていただきました。\n\n・リクエスト\nDate+Links所属のVtuber「朝比奈美夜」さんをお願いします。\n衣装、構図、シチュエーションなどはお任せ致します。\n可能であれば髪は青のインナーカラー入りであると嬉しいです。\n真昼ゆら様の描かれている世界観のテイストで美しく描いていただけるとありがたいです！\nもし可能であれば全身が切れないような形でありますと嬉しいです。\n\n・使用用途\nファンアートとして「朝比奈美夜」さんにプレゼントする予定です。\n私と「朝比奈美夜」さんに限りSNSへの投稿や配信、FANBOX等への使用許可を頂きたいです。\n\n・希望\n人物、背景、宛名等がレイヤー分け出来るPSDデータで頂けると有難いです。 \n\n・参考資料\nhttps://twitter.com/asahinamiya/status/1605870225437577217?s=46&t=JlWEstQdTo7cpvQaq_kFbA\nhttps://twitter.com/asahinamiya/status/1660214761412501504?s=46&t=JlWEstQdTo7cpvQaq_kFbA", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@mahiru_yura/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1081058, "client_id": 2185114, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/622f8513/uploads/origins/0dce251e-6b67-4baf-8769-f0ada407aa20?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=da845cec7c87ab7ac48902d241d20388", "srcset": "https://si.imgix.net/622f8513/uploads/origins/0dce251e-6b67-4baf-8769-f0ada407aa20?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=da845cec7c87ab7ac48902d241d20388, https://si.imgix.net/622f8513/uploads/origins/0dce251e-6b67-4baf-8769-f0ada407aa20?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=cd44548b39722cbde15e0f39529dd361 2x, https://si.imgix.net/622f8513/uploads/origins/0dce251e-6b67-4baf-8769-f0ada407aa20?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=438d30f3745fdcaf64fd4bc15e473d41 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/622f8513/uploads/origins/0dce251e-6b67-4baf-8769-f0ada407aa20?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b234dc51dacce22aa8eb6b75ff2c03da", "srcset": "https://si.imgix.net/622f8513/uploads/origins/0dce251e-6b67-4baf-8769-f0ada407aa20?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b234dc51dacce22aa8eb6b75ff2c03da, https://si.imgix.net/622f8513/uploads/origins/0dce251e-6b67-4baf-8769-f0ada407aa20?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=80d4acc6ac2d46c1acba55f3308cfc1a 2x, https://si.imgix.net/622f8513/uploads/origins/0dce251e-6b67-4baf-8769-f0ada407aa20?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=29d3aeb7c99116c8cda5c9c0d88068bc 3x"}, "body": "はじめまして、613(muimi)と申します。 可愛らしく素敵なイラストを拝見し、ぜひご依頼させていただきたいと思い失礼いたします……！\n\n自創作のうちの子(OC)「くろの」をお願いしたいです。\n【資料】URLの27枚目「七種くろの」とあるほうの右側立ち絵のほう\n\n真昼ゆら様の宝石のような瞳に強く惹かれたため、「瞳」にクローズアップしたイラストをお願いしたいです。\nどアップで大丈夫なので、目元でぐっと惹きこむようなイラストでお願いできませんでしょうか……！\n構図については、よそのイラストで恐縮ですがこちら(https://twitter.com/granbluefantasy/status/1629058824836644865)のようなイメージで、\n・少し見開き気味で黒目の輪郭があまり隠れないように\n・白目の球体感が出るような感じで\n・目(瞼)の輪郭がなるべく繋がっている\n感じでお願いしたいです……！\n「くろの」は自創作における女神のような存在で、並行世界の未来をすべて見渡すなどの強力な時の魔法を使うキャラクターです。\n力を行使するときに「左目(オレンジ色のほう)に文字盤が浮かぶ」特徴があるので、ぜひその様子をイラストにして頂きたいです……！\n文字盤模様のデザインはお任せしますが、資料にもあるようにローマ数字が書いてあるようなイメージです。\n\nもしよろしければ、ご検討いただけると幸いです。\nよろしくお願いいたします！\n\nhttps://www.pixiv.net/artworks/84561489", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@mahiru_yura/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1081058, "client_id": 2377067, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/4726ff60/uploads/origins/092e4273-0e88-4147-bab9-d2bd21ddd7a2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=52d476757f03629eafb704e531b51900", "srcset": "https://si.imgix.net/4726ff60/uploads/origins/092e4273-0e88-4147-bab9-d2bd21ddd7a2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=52d476757f03629eafb704e531b51900, https://si.imgix.net/4726ff60/uploads/origins/092e4273-0e88-4147-bab9-d2bd21ddd7a2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=41dbae7934cc0617e7595ba61d0b4188 2x, https://si.imgix.net/4726ff60/uploads/origins/092e4273-0e88-4147-bab9-d2bd21ddd7a2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=89e1085eba96bc8e8f1a79f4841d5ed4 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/4726ff60/uploads/origins/092