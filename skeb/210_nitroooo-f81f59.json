00560a3/uploads/origins/7787a174-708b-4f1d-878c-9e4443b330ea?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=427996feaea58d7dba72f1b151658cf3", "srcset": "https://si.imgix.net/f00560a3/uploads/origins/7787a174-708b-4f1d-878c-9e4443b330ea?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=427996feaea58d7dba72f1b151658cf3, https://si.imgix.net/f00560a3/uploads/origins/7787a174-708b-4f1d-878c-9e4443b330ea?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=2eeb46f4919d5e9eb16c010876a0d111 2x, https://si.imgix.net/f00560a3/uploads/origins/7787a174-708b-4f1d-878c-9e4443b330ea?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=c07a022f573e2976d42bb971ee947c37 3x"}, "body": "はじめまして…！\n二兎ニトロ様のかわいらしいイラストに心惹かれリクエストを送らせていただいております…！もしよろしければリクエストお引き受け頂けますと幸いです。よろしくお願いいたします。\n\nイラストの詳細 \n私合歓乃ねむを描いていただきたいです！\n白いフリル付きの水着でお願いしたいです!\n髪型は資料の通りになります。\n構図やポーズはお任せ致します…！\n\nYouTube等で使用したいため、頭や体が見切れていない状態でお願いしたいです🙇‍♀️また、人物のみのものも納品いただけますと幸いです。\n\n使用用途 \nYouTubeのサムネイル、動画内での使用（収益化予定あり） \nTwitterでの使用 \nネップリでの使用 \n文字入れ等の加工\nその他商用含む活動での使用 （不可能な用途がございましたら、別レイヤーに書いてお知らせいただけますと幸いです。）  \n\nお忙しい中申し訳ございませんが、お引き受けいただけましたら嬉しいです。 ご検討よろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/1-RfAfguJhuxFC543j4b_g-SOM90L4ZZJ", "nc": 137, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@210_nitroooo/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1864494, "client_id": 1360269, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/bacf3527/uploads/origins/a700bb1d-ec7b-4fd8-842b-d856d834f1db?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=83b81b6b12f93138490e83847acb52f2", "srcset": "https://si.imgix.net/bacf3527/uploads/origins/a700bb1d-ec7b-4fd8-842b-d856d834f1db?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=83b81b6b12f93138490e83847acb52f2, https://si.imgix.net/bacf3527/uploads/origins/a700bb1d-ec7b-4fd8-842b-d856d834f1db?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=0b196442ddfb426831e8e10bb770b6a1 2x, https://si.imgix.net/bacf3527/uploads/origins/a700bb1d-ec7b-4fd8-842b-d856d834f1db?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=3ebe85d1b28e54d6531721072d36f822 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/bacf3527/uploads/origins/a700bb1d-ec7b-4fd8-842b-d856d834f1db?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f42ffa4e67b963f723c62b8d30e17d4b", "srcset": "https://si.imgix.net/bacf3527/uploads/origins/a700bb1d-ec7b-4fd8-842b-d856d834f1db?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f42ffa4e67b963f723c62b8d30e17d4b, https://si.imgix.net/bacf3527/uploads/origins/a700bb1d-ec7b-4fd8-842b-d856d834f1db?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=833da7c50434ced799414c7eeb09c902 2x, https://si.imgix.net/bacf3527/uploads/origins/a700bb1d-ec7b-4fd8-842b-d856d834f1db?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=6fe2ce22d6a58c7e28841bad353a62b1 3x"}, "body": "お疲れ様です。リクエストさせて頂きます\n\n●作品\nフラワーナイトガール\n（FANZAより提供されているブラウザゲームです。二次創作の是非については「一般的に行われている二次創作、いわゆる同人活動による使用及び手段について基本的に自由」と公式ガイドラインにて示されています）\n\n●キャラ\nイソギク\nhttps://flowerknightgirl.game-info.wiki/d/%a5%a4%a5%bd%a5%ae%a5%af\nhttps://i.imgur.com/yIUYKDC.jpeg\n\n●シチュ・構図\nこちらのイラスト（https://livedoor.blogimg.jp/hole_of_springgarden/imgs/4/4/44bf4d88.jpg）から見られる様な、自分の腿をポンポンと叩いて膝枕に誘っている所をお願いします\n具体的な構図やアングルなどの細部はお任せしますが、可能であればイソギクがもう一方の腕を両胸の下に回し、胸を軽く持ち上げている様にお願いします（彼女は幼い体格に対し非常に胸が大きいキャラで、胴体が短い＋胸が大きすぎる為に、胸を持ち上げないと頭を入れる為の十分なスペースがない、という想定です）\n\n服装の希望は、前述キャラ資料下段にまとめた物の内、③⑥⑨のいずれか。胸元のインパクトをより強くして欲しいので、アングルが見下げ視点の場合は⑥、横から見た視点の場合は③、見上げ視点の場合は⑨を選び、胸元の露出面がドンと映り込む様にお願いします\n難しい場合はアングルに関わらず、好きな服装を選んで頂いて構いません\n\n彼女の様子としては、愛情に溢れた優しい眼差しで、柔らかく微笑んでいる様な感じでお願いします\n\n●補足事項・その他\n前述の通り、幼い体格に対し非常に胸が大きいキャラです。体は手足は幼めに、胸に関しては描き慣れないサイズ感かもしれませんが、思い切って大きくお願いします\nまた、可能であれば左手薬指に結婚指輪（ゲーム中の誓いの指輪というアイテム）を着けさせて下さい\n衣服の見えない部分の補完については先生にお任せします\nその他、以下の身体的特徴に留意して作画して下さい\n・泣きボクロ（特に忘れられがちです）\n・アホ毛\n\n以上です\nご検討頂けると幸いです", "nc": 9, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@210_nitroooo/works/1", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/fa733cf0/uploads/origins/cd76dd9e-019f-4e86-8eb5-019ce63a5ec9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=1494f375e60aae53d401e0488b167f88", "srcset": "https://si.imgix.net/fa733cf0/uploads/origins/cd76dd9e-019f-4e86-8eb5-019ce63a5ec9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=1494f375e60aae53d401e0488b167f88, https://si.imgix.net/fa733cf0/uploads/origins/cd76dd9e-019f-4e86-8eb5-019ce63a5ec9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=386e1c468df1822c709df054193a3b68 2x, https://si.imgix.net/fa733cf0/uploads/origins/cd76dd9e-019f-4e86-8eb5-019ce63a5ec9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=7764c974ff00001a8e0ac7b088c02439 3x"}, "private": true, "genre": "art", "tipped": false, "creator_id": 1864494, "client_id": 2549593, "nc": 144}], "sent_works": [], "similar_creators": [{"id": 21990, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "shie(しいちゃん)", "screen_name": "shiechyan", "avatar_url": "https://pbs.twimg.com/p