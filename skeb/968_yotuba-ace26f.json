w=200&h=200&s=3fd195018102e411d583b1c52138c7cd 2x, https://si.imgix.net/9461607d/uploads/origins/44ae09aa-31fb-4e30-94c3-b3706e033948?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f4ff0ec4499bfb5198cad99de0989cc8 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/9461607d/uploads/origins/44ae09aa-31fb-4e30-94c3-b3706e033948?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=cabdd7562f54476cf3bebbe1e124550d", "srcset": "https://si.imgix.net/9461607d/uploads/origins/44ae09aa-31fb-4e30-94c3-b3706e033948?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=cabdd7562f54476cf3bebbe1e124550d, https://si.imgix.net/9461607d/uploads/origins/44ae09aa-31fb-4e30-94c3-b3706e033948?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=e583fa073b19bd340a70360f9bc71af7 2x, https://si.imgix.net/9461607d/uploads/origins/44ae09aa-31fb-4e30-94c3-b3706e033948?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=68eb52b21ae74f8903c098a3bc1d0f82 3x"}, "body": "はじめまして。\n\nこの度は私のオリキャラの\"トキコ（止型５号）\"のイラストをお願いできればと思いリクエストさせていただきました。\n\n<トキコ（止型５号）>\n●ビジュアルの詳細は参考資料参照\n●外見年齢：約13歳の少女\n●役割：時空犯罪や歴史改変を防ぐ使命を持つ生体兵器（ヒト型Metalien）\n●身長・体型：身長155cm・華奢な体型\n●重さ・比重：675kg・15g/cm3\n●性格：軽い感じで飄々としている\n●運動能力：握力1t、垂直跳1m、走幅跳20m\n●特殊能力: 時空操作\n　例[\"凍結\"：触れた物体の時間の流れを停止できる。時間停止中の物体には、霜や氷のようなエフェクトが現れる]\n　　[\"燃焼\"：自分以外のあらゆるもの時間の流れを減速できる。減速中は、炎のようなエフェクトを全身に纏う]\n　　[\"荷電\"：左腕から電撃を放ち感電した対象の時間を加速させる]\n　　[\"暴風\"：首筋に薬物を注射して変身する。風のエフェクトが発生して周囲の時間の流れをでたらめにかき乱し、行動と結果の随伴性や因果関係をめちゃくちゃにする。薬物の作用で意識混濁を引き起こしてふらふら状態になり、「ぐるぐる……」としか言葉を発せなくなる]\n　　[\"暗転\"：触れた対象の時間の流れを巻き戻す。巻き戻している間、触れた部分から黒い波紋が生じ、目から黒ずんだ血の涙が溢れる。]\n\n構図やシチュエーションなどの詳細については、お任せいたします。\n\n使用用途：個人活動全般\n  ・動画配信：待機画面やエンディング画面などでの使用。\n  ・ウェブサイトおよびSNS：個人サイトやSNSでの小説の挿絵、キャラクター紹介、活動告知。\n  ・グラフィック要素：アイコン、ヘッダー、バナーとしての使用。バナー使用時には、サイト名やキャンペーン名を追加する場合があります（必要に応じてトリミング加工を行うこともあります）。\n  ・参考資料：他のイラストレーターへの依頼時における参考資料としての提示。\nこれらの用途において、無断使用防止のためにウォーターマークを適宜付けて、イラストを使用させていただく場合があるので、ウォーターマークについてもご提供いただけますと幸いです。\nなお、商業利用や第三者への再配布は行いません。\n\nご確認のほど、よろしくお願いいたします。\nご縁がありましたら、どうかよろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/1IhO160JfiDdTf-oK9KyA6J-NDO9u5fWj", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 22750, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "アオイロ", "screen_name": "t_aoiro123", "avatar_url": "https://pbs.twimg.com/profile_images/1273503516829421568/fL149tRk.jpg", "header_url": null, "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "art"}, {"genre": "correction"}], "banned": false, "nc": 48}, {"id": 2753997, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "豊島", "screen_name": "teshima2044", "avatar_url": "https://pbs.twimg.com/profile_images/1841428943460876288/ef1MFjZN.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1652249535601836032/1742637882/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "art"}], "banned": false, "nc": 16}, {"id": 2902611, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "いかわさ(skeb垢2)", "screen_name": "Midori_soumenn", "avatar_url": "https://pbs.twimg.com/profile_images/1698908446492590080/BUqIxfaD.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1057999758789230592/1585705928/1500x500", "appeal_receivable": true, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_