gins/ccbca562-ecfd-4180-8e98-3fe30d0bd02f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8222dcb472f4cdecaa9b40660d06e00c", "srcset": "https://si.imgix.net/b0255ef5/uploads/origins/ccbca562-ecfd-4180-8e98-3fe30d0bd02f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8222dcb472f4cdecaa9b40660d06e00c, https://si.imgix.net/b0255ef5/uploads/origins/ccbca562-ecfd-4180-8e98-3fe30d0bd02f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=931ffbe076652d4a3fc21b2c47ae3523 2x, https://si.imgix.net/b0255ef5/uploads/origins/ccbca562-ecfd-4180-8e98-3fe30d0bd02f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f16b0b19daed5e18da9a3ed489f0cdde 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/b0255ef5/uploads/origins/ccbca562-ecfd-4180-8e98-3fe30d0bd02f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=7d4b4fd49a2f56a294c73335c7936ae9", "srcset": "https://si.imgix.net/b0255ef5/uploads/origins/ccbca562-ecfd-4180-8e98-3fe30d0bd02f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=7d4b4fd49a2f56a294c73335c7936ae9, https://si.imgix.net/b0255ef5/uploads/origins/ccbca562-ecfd-4180-8e98-3fe30d0bd02f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=c4b91495aab8ba40ddb01ef87f087161 2x, https://si.imgix.net/b0255ef5/uploads/origins/ccbca562-ecfd-4180-8e98-3fe30d0bd02f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=99d71d68fce934b14ddca65dfb295f47 3x"}, "body": "はじめまして。\nいつも楽しく作品を見させてもらっています。初めてのリクエストなので間違いや失礼がありましたらすみません。\n\nリクエストしたいキャラクターは、TRPGで使用しているキャラクター2名です。\n\n1人目は「星飼 阿万多（ほしかい あまた）」というキャラクターです。黒髪、褐色で、左右で瞳の色が青と緑と違います。年齢は15歳の男で身長は168㎝、スラムのような街で暮らしておりガラクタを拾っては改造して売ったり自分のものにしたりしています。服装は和服を着崩したような服装で、数珠や宝戟を持ち歩いています。性格はのんびり屋でマイペース、少し自分勝手なところもあります。ナハトに興味を持っており、仲良くなりたいと思っています。\nキャラクターのモチーフは、数字と星と仏教などです。\n\n2人目は「ナハト」というキャラクターで、ほしのさんという方のキャラクターです（依頼や資料イラストの使用は許可していただいています）。白髪で一部が黒、褐色で、左右で瞳の色が黒と白と違います。年齢は17歳の男で身長は174㎝、富裕層のみが暮らすことができる白い塔のような形状の街に暮らしていますが、外の世界に出ることはほとんどありませんでした。服装は黒い柄シャツに黒い手袋をしており、全身に沢山の刺青やピアスあります。自身の辛い過去や境遇から幸せな人間を憎んでおり、笑顔で嫌味を言うような、かなり捻くれた性格をしています。阿万多に対しては憎悪の感情を向けていましたが、それでも関わってくる間に絆され弟のように接することもあります。\nキャラクターのモチーフは夜です。\n\n二人とも白と黒が基調のキャラクターですが、なぁ？さんの色使いが好きなのでお好きな色で描いていただけると嬉しいです。ポーズもお任せしたいと思いますが、阿万多の方が少しアクティブなポーズで、ナハトの方がクールなポーズだと嬉しいです。\n\n最後になりますが、御一考のよろしくお願いします。\n\nhttps://drive.google.com/drive/folders/1wmK0lsAq0Zacv-Y7tpp_8RHbfDUpMSxe?usp=share_link", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}], "similar_creators": [{"id": 844129, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "亀⑨", "screen_name": "kamemaru91", "avatar_url": "https://pbs.twimg.com/profile_images/1694465218368466944/pJLP_Joa.jpg", "header_url": "https://pbs.twimg.com/profile_banners/2425429339/1718826215/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 45, "skills": [{"genre": "art"}, {"genre": "novel"}, {"genre": "correction"}], "banned": false, "nc": 161}, {"id": 1364941, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "織", "screen_name": "o_r_i_124", "avatar_url": "https://pbs.twimg.com/profile_images/2071574529894469633/kj9QhP8P.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1869940816757829635/1781967766/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 10, "complete_expiration_days": 120, "skills": [{"genre": "art"}], "banned": false, "nc": 32}, {"id": 3305891, "creator": true, "nsfw_acceptable": false, "acceptable