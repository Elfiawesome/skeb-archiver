ずそれぞれの膝辺りに置かれている)\n台詞を書かれる場合は見つかった際に言い訳させてほしい事以外はお任せします。\n可能であれば隠れてから放尿までと発見は差分でわけてください。\n陰毛願います。", "nc": 170, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@smile435/works/22", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 41785, "client_id": 43689, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/d9266136/uploads/origins/d7e6ed59-af71-4383-87c5-0bcd86302db9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=450a191951594683dc6356b572c772b4", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": true, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/d9266136/uploads/origins/d7e6ed59-af71-4383-87c5-0bcd86302db9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f8f88d2919c039d0d538140ba5e45497", "src_set": ""}, "body": "下記の自キャラの立ち絵を一枚お願いします。\n\n体つきは絵師さんの金ビキニの美鈴くらいの感じであれば良いです。\n\n衣装に関しては特に指定はないですが、体付きが分かりやすいものであれば好きにしてもらって構いません。可能であればふたなりの差分もあると嬉しいです。\n\nhttps://x.com/mantis493/status/1908180831979589651", "nc": 43, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@smile435/works/21", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/d2fb0465/uploads/origins/3edb397b-11b5-4cd7-b2f5-7d320efef14f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=af22df50a69a62a7a5fc5e8ed9be794b", "src_set": ""}, "private": true, "genre": "art", "tipped": false, "creator_id": 41785, "client_id": 0, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 32, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@smile435/works/20", "private_thumbnail_image_urls": null, "private": false, "genre": "ar