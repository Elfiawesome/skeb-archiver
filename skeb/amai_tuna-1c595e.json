43b-44ce-a7f1-d394275e322d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2dd8a37bc1bc30b9dc8df230007e375e", "srcset": "https://si.imgix.net/ee2d87d1/uploads/origins/41cab545-e43b-44ce-a7f1-d394275e322d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2dd8a37bc1bc30b9dc8df230007e375e, https://si.imgix.net/ee2d87d1/uploads/origins/41cab545-e43b-44ce-a7f1-d394275e322d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=2e7f05777099748c3519c1ba006eb82f 2x, https://si.imgix.net/ee2d87d1/uploads/origins/41cab545-e43b-44ce-a7f1-d394275e322d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=dc5c7495a520fffd593445a6592411b9 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/ee2d87d1/uploads/origins/41cab545-e43b-44ce-a7f1-d394275e322d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=7ccbe38a5a912b3f1ad91e5836e74bfa", "srcset": "https://si.imgix.net/ee2d87d1/uploads/origins/41cab545-e43b-44ce-a7f1-d394275e322d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=7ccbe38a5a912b3f1ad91e5836e74bfa, https://si.imgix.net/ee2d87d1/uploads/origins/41cab545-e43b-44ce-a7f1-d394275e322d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=67197171e38d0b10d7c74a875b31e6b2 2x, https://si.imgix.net/ee2d87d1/uploads/origins/41cab545-e43b-44ce-a7f1-d394275e322d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=7887a1b3d85db4ef1d532d376832a55b 3x"}, "body": "おててやさん🐾様\n\n初めまして、Vtuber / Vsingerとして活動している 天愛つな（あまい つな）と申します。\nBoothから作品を拝見し、ぜひ素材をご制作いただけたらと思いリクエストいたしました。\n\n■内容\n・片手でマイクを持ち、もう一方は胸に手を当てているイラスト\n　（マイクデザインもお任せしたいです。）\n・両手でお供の羊キャラ「わたがし」を抱いているイラスト\n・片手で頬を指さす手のイラスト ※\n・胸前で両手を合わせているイラスト ※\n※参考 https://x.com/oteteyasan/status/1839233349615034672\n\n■使用モチーフ\n・ひし形のキラ✧マーク\n・画鋲(ファンマーク)\n・