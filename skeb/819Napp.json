=200&blur=200&s=5d0fd3eee6e5d4286a4b9d6e7cc23ce7", "src_set": ""}, "body": "今回創作キャラのイラストをお願いしたく依頼させていただきました！\nもし出来ましたらグレースケールかトーンなど白黒印刷できるものですと助かりますれよろしくお願いします！\n https://ncgay12429.wixstudio.com/mysite\nキャラクターこちらのサイトに記載しております！\nよろしくお願い申し上げます！\n\n\n\n\nこちらキャラクターデザインになります！よろしくお願い申し上げます！", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@819Napp/works/18", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3465479, "client_id": 1377136, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/3034d368/uploads/origins/3d92734b-bdc3-47f4-8fc1-5c9fa2af1f53?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d4f33d30eeec42442b120c4aea550857", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/3034d368/uploads/origins/3d92734b-bdc3-47f4-8fc1-5c9fa2af1f53?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=8911bef8b08849e9a4d0b1cde045186c", "src_set": ""}, "body": "napp先生、再びこんにちは！前回のSKEBがとても気に入ったので、ご迷惑でなければまたお願いしたいと思いました。今回は私のオリジナルキャラクター2人のショートマンガをお願いしたいと思います。\n\n参考までに：\n(1) https://toyhou.se/30319966.the-wych-fables-skeb?key=QiSyste6t68fJJ9#91739332\n(2) https://toyhou.se/30319966.the-wych-fables-skeb?key=QiSyste6t68fJJ9\n(衣装は簡略化しても大丈夫です！)\n\nマンガの内容：\n- オオカミが初めてオオカミの姿で少年の前に現れた。\n- 少年は冷ややかで感情のない顔で彼を見つめる。\n- オオカミは言う。「お前の恐怖の匂いを嗅ぎ分けることができるのに、お前は逃げない。私はお前を丸ごと食い尽くすことができるのに、お前は逃げない。なぜそうなんだ？\"\n- 少年は表情を変えずに言う。逃げる場所はどこにもない。この世界はすでに、あなたに食べられるよりはるかに残酷な運命なのです\"\n- 狼は炎で燃え、人型の姿に戻る。彼は鋭い歯で少年に笑いかける。\"お前はなんて奇妙な小さな人間なんだ\"\n\nプロンプトは自由に解釈してください。日本語のままでも、英語でもかまいません！量が足りない場合は、お気軽に再送してください！この度はご検討いただき、誠にありがとうございました！", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@819Napp/works/17", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3465479, "client_id": 2828685, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/19c59a1d/uploads/origins/9b9ba340-a593-4959-a4a7-acd7bcbe0e3f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1631810bcf54088757e4d8532ba5a739", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/19c59a1d/uploads/origins/9b9ba340-a593-4959-a4a7-acd7bcbe0e3f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d92a9b7ce8ac9f8fd25795638a37255d", "src_set": ""}, "body": "Hello sensei! I really love your art style and would like to request you to draw a illustration for a pair of my OCs \n妃螺：白原郷の神様、深海からきた、あるいは深海そのもの。イソギンチャク、浮遊生物、どんな貝殻でもその目になることができます。その化身、神の姿にして数千年の循環にわたり、全てを淡々とした目で見つめる。そんな妃螺は一体何を待っているのでしょうか？\n 明石鵼：赤髪に赤い瞳、不吉な兆しとされた子。供物として白原郷の神々に捧げられたが、その中で彼に興味を持つ神に救われ、そしてその傍に置いてくれた。感情豊かな子で、人としてあまりにも『人間』すぎるかもしれない… \nI put the detailed character settings and worldviews of them in the linked document ^^ Hope this will provide you with inspiration.\nBtw, Your Jujutsu Kaisen fanworks are masterpieces! They are stunning and amazing. I'd be absolutely thrilled if you could draw 禪院直哉 in that style.\nCould I commission:\n* One OC illustration\n* One quick 禪院直哉 sketch\nFeel free to interpret them your way! There are no specifics. Please choose any costumes or settings and draw as you like! If there are any drafts, I would like to keep them. If the amount is not enough please request a resend again :) \n\nhttps://drive.google.com/drive/folders/1-9GSFMXyIAbsZGq_urMulOOiZ8ZuRDG_", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@819Napp/works/16", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3465479, "client_id": 3670620, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/d22fb047/uploads/origins/7a8765a1-803e-4582-8e57-35ded2b3e2e0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a52153beee9bcba56b558c772dda048e", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/d22fb047/uploads/origins/7a8765a1-803e-4582-8e57-35ded2b3e2e0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=4a84ba82d7af511e4497516fc5da22c2", "src_set": ""}, "body": "あなたの絵のスタイルが大好きです。あなたの絵から物語が見えます。今の経済状況では予算が足りず、申し訳ありません。条件はありません！あなたが良いと思うものを描いてください。このキャラクターは魂の渡し守です。値段が気になるなら却下してください。でも、引き受けてくれたら本当にありがたいです。ありがとうございました。\n\nhttps://drive.google.com/file/d/1Ku1bhV77wWiRZKkKrFHa4KEgobJf9omW/view?usp=sharing", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@819Napp/works/15", "private_thumbnail_image_urls": null, "private": false, "genre": "comic", "tipped": true, "creator_id": 3465479, "client_id": 3542769, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/76d11c80/uploads/origins/63f7f701-4004-4fe2-aeaa-e1fac36b27a0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2ca38e47f4f04a9073f6e05e166d03e0", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/76d11c80/uploads/origins/63f7f701-4004-4fe2-aeaa-e1fac36b27a0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c45bd00925d7ce89c70db6aa2f589cf3", "src_set": ""}, "body": "napp様、はじめまして。\nXにてとても素敵なイラストを拝見し、リクエストを送信させていただきました。\n差し支えなければ私のOCでコミックを描いていただきたいです。\n\n【OC資料】\nhttps://drive.google.com/drive/folders/1iSfV8P9amqfwT9ZhgpWEY2xByPw8WcSF\n\nご多忙のところ誠に恐縮ではございますが、ご検討のほどよろしくお願い申し上げます。", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@819Napp/works/14", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3465479, "client_id": 1002723, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/9dc2aefd/uploads/origins/0b331ae4-7be0-424f-b9e6-897bace3faf0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d7cea800dd267eb234fdcb118ebee514", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/9dc2aefd/uploads/origins/0b331ae4-7be0-424f-b9e6-897bace3faf0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a65d825d8ee4694cd8409d4986a931f2", "src_set": ""}, "body": "こんにちは！\n私はあなたの絵がとても好きで、私の2人のキャラクター、ザンデラとレムゼイをあなたのスタイルで描いてほしいのです。ザンデラはカウボーイとサムライのミックスで、武器を持って戦います。\nザンデラはカウボーイとサムライのミックスで、リボルバーとカタナで戦います。また、雷を呼び出したり、自分に電気をチャージして素早く動いたりする魔法の力も持っている。普段は冷静沈着だが、その裏では情熱的で意志が強い。\nレムジーはデリンジャー銃を使うが、これは体に彫ったタトゥーから呼び出すことができる。彼は貴族の出身なので、少し傲慢だ。また、とてもエネルギッシュで情熱的で、おっちょこちょいなところもある。\nお好きなように描いてください。リクエストにお答えいただき、よろしくお願いします！\n\nhttps://imgur.com/a/kBMLe2E", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@819Napp/works/13", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/55898d9d/uploads/origins/8d2eb240-d310-4348-9cb7-37987d318653?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=40564396d57ccc0b33ebbbec299b7d3b", "src_set": ""}, "private": true, "genre": "art", "tipped": true, "creator_id": 3465479, "client_id": 1377136, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 1, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@819Napp/works/12", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/571a23b8/uploads/origins/5a7664d1-b118-4db1-921a-2da9283cd249?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=d31ec742bbe9752292c9aaccf5cef099", "src_set": ""}, "private": true, "genre": "art", "tipped": false, "creator_id": 3465479, "client_id": 792508, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 0, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@819Napp/works/11", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3465479, "client_id": 975662, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/05e1d903/uploads/origins/d635c4c2-576e-4734-87d5-3321792fd915?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a04470060357da66fd5c78aa9151a948", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/05e1d903/uploads/origins/d635c4c2-576e-4734-87d5-3321792fd915?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=05fb268f2ee0d7fa174a8203384fda3e", "src_set": ""}, "body": "Good evening! I wanted to request something with these two characters in your style. Anything you like!\n\nhttps://drive.google.com/drive/folders/1Ex0secCczZVkMpzJDpv_fuXd7BghROnq\n\nhttps://drive.google.com/drive/folders/1vRjnSEAS_edQLxEF0hwUR9II6_NOz09O", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@819Napp/works/10", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3465479, "client_id": 3562420, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/33cb2fa5/uploads/origins/6ece7889-302c-4b91-8564-b07b067d8fbb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bdbc094014028ed111962a98d10a5be8", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored