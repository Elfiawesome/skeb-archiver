あるとうれしいですが、なくてもかまいません。自由に描いてください。金額が足りない場合は、アピールを送ることができます！気に入らなければキャンセルも可能です。\nよろしくお願いします！♡\n\nhttps://drive.google.com/drive/folders/1XP8ThOPIQbi2P1mtrA8CutxI6VjmycRK?usp=sharing", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@mtn_imp/works/2", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/1bc2688a/uploads/origins/5cc4cef9-b6d5-45a6-bde7-4f7f4fe9b848?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=23fa8a161d09555f75cfc9a6c6aa167e", "srcset": "https://si.imgix.net/1bc2688a/uploads/origins/5cc4cef9-b6d5-45a6-bde7-4f7f4fe9b848?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=23fa8a161d09555f75cfc9a6c6aa167e, https://si.imgix.net/1bc2688a/uploads/origins/5cc4cef9-b6d5-45a6-bde7-4f7f4fe9b848?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=e2072139771fa37f7af13a9f0700728b 2x, https://si.imgix.net/1bc2688a/uploads/origins/5cc4cef9-b6d5-45a6-bde7-4f7f4fe9b848?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=b988e8ca43faff577ea74cd9cc76af07 3x"}, "private": true, "genre": "art", "tipped": false, "creator_id": 3249424, "client_id": 1500785, "nc": 177}, {"path": "/@mtn_imp/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3249424, "client_id": 1091848, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/7e542686/uploads/origins/f52c8346-2098-4cb4-85cc-f45123e45b6b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a4c6c4501e80267734958809350f3077", "srcset": "https://si.imgix.net/7e542686/uploads/origins/f52c8346-2098-4cb4-85cc-f45123e45b6b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a4c6c4501e80267734958809350f3077, https://si.imgix.net/7e542686/uploads/origins/f52c8346-2098-4cb4-85cc-f45123e45b6b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f21b6a1de9d93772c9e4bc59c41e3483 2x, https://si.imgix.net/7e542686/uploads/origins/f52c8346-2098-4cb4-85cc-f45123e45b6b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=36d695c140919222c908a0a526306962 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/7e542686/uploads/origins/f52c8346-2098-4cb4-85cc-f45123e45b6b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5e9484965d60b9ddf76ac8661ff92c19", "srcset": "https://si.imgix.net/7e542686/uploads/origins/f52c8346-2098-4cb4-85cc-f45123e45b6b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5e9484965d60b9ddf76ac8661ff92c19, https://si.imgix.net/7e542686/uploads/origins/f52c8346-2098-4cb4-85cc-f45123e45b6b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=9eb7d65be9d54f82d1dfee547c5ed30b 2x, https://si.imgix.net/7e542686/uploads/origins/f52c8346-2098-4cb4-85cc-f45123e45b6b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=7d562119f4a405296fab7712ec1ab171 3x"}, "body": "まとんさんこんにちわ！\n自創作のキャラクターを描いて頂きたく、リクエスト失礼いたします！\n描いて頂きたいイメージとしては、笑顔/楽しそうな雰囲気/お花が含まれたイラストを描いて頂きたいです！\n構図などは値段に見合ったもので仕上げて頂ければ問題ないです。お任せ致します！\n\nまともな資料が3枚ほどしかなく恐縮ですが一応URL添付させていただきます。\nまた、SDイラストで描いてる服が最終案で固まったものになるのですが、大きくデザイン変わらなければ多少の差異は全く気にしません！（なんならシスター服以外でもOKです◎ただ、世界観的に現代寄りではないのでそこだけ気を付けて頂けると…！）\n因みに、念のためですがSDイラスト右隣の男性キャラについてはよその子になるので念のため絵の中にいれないでいただければと思います…！\n\nキャラクターのバックボーンについては以下の通りです。\nかなり不要かもしれませんが、制作の一助になればと思ったので記載させていただきます。\n・名前はルチア\n・生まれながらに半陰陽だったため、親に捨てられてしまった。\n　∟身体は女性寄りです\n・それを見つけた竜が気まぐれで赤ん坊の彼女を助けて、自分の種族（竜）を信仰する修道院兼孤児院の院長をしている牧師（すごく良い人）に彼女を預けた。\n・そのため彼女もシスターとして暮らしていたが、彼女の育ての親でもある牧師が寿命により倒れてしまう。\n・その後送られてきた後見の牧師が裏界隈と繋がりのある腹黒い人間で、院の子に金持ち相手の売春をさせるようになる。\n・その後、ルチアの状況も危うくなるが赤ん坊の彼女を助けてくれた竜が助けてくれて事なきを得（修道院は燃えました）、なんやかんやで一緒に世界ぶらり旅を始めることになる。\n（竜については、ルチアといるときは基本的に資料のSDキャラ右隣りにいる人間の男性の姿をとってる設定です）\n・ルチアは竜に対して恋愛感情を持っているが、竜の方は保護対象として大切な存在と考えているのでよくすれ違っている。\n\nお忙しいかと思うのでゆっくりご対応いただければ大丈夫です。\n勿論難しい内容であればキャンセルでも…！\n楽しみにしています！\n\nhttps://drive.google.com/drive/folders/1MwtF3ZRWZqlw58Z0D0RbtcB1J-eK6JHS?usp=sharing", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 18302, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "ぬこさん。", "screen_name": "nukosan23", "avatar_url": "https://pbs.twimg.com/profile_images/1663461843250343937/0f0cQKg9.jpg", "header_url": "https://pbs.twimg.com/profile_banners/4687148173/1465914298/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 70, "skills": [{"genre": "art"}, {"genre": "comic"}], "banned": false, "nc": 177}, {"id": 131247, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "がいえん", "screen_name": "jin_morisono", "avatar_url": "https://pbs.twimg.com/profile_images/1699034047299850240/PqMwPw6w.jpg", "header_url": null, "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 6, "complete_expiration_days": 120, "skills": [{"genre": "art"}, {"genre": "correction"}], "banned": false, "nc": 49}, {"id": 246634, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "七市", "screen_name": "nanashi_nogi", "avatar_url": "https://pbs.tw