。\n甘いもの、辛いもの、どんな食べ物でも構いませんので幸せそうに頬張ってる様子を描いていただけたら幸いです！\n食べ物を描くのに時間をかけていただくのは忍びないので価格帯に見合ったラフな雰囲気で描いていただけたらと思います。\n\n資料は1枚のみになりますがこちらで参考になれば…！！シチュエーション以外では特にNGないので自由に楽しく描いていただけたら嬉しいです。どうぞよろしくお願いします🌷\n\nhttps://drive.google.com/file/d/1fl_6A-QBD6aRfyvjL6ukBhmCrlnSrjru/view?usp=drivesdk", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@mtn_imp/works/4", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/669e6025/uploads/origins/63782990-cfad-4d5c-a875-91163723356a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=cefdeaf2a5a02f3c2f6296546de3f5f9", "srcset": "https://si.imgix.net/669e6025/uploads/origins/63782990-cfad-4d5c-a875-91163723356a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=cefdeaf2a5a02f3c2f6296546de3f5f9, https://si.imgix.net/669e6025/uploads/origins/63782990-cfad-4d5c-a875-91163723356a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=47a8e4306b43e20dbe419cf44cbfa3d1 2x, https://si.imgix.net/669e6025/uploads/origins/63782990-cfad-4d5c-a875-91163723356a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=b9192dd357d75653ca3a0aec8873faac 3x"}, "private": true, "genre": "art", "tipped": false, "creator_id": 3249424, "client_id": 2807799, "nc": 48}, {"path": "/@mtn_imp/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3249424, "client_id": 2038044, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/0ca6e736/uploads/origins/a496c3a3-217d-4ddc-8