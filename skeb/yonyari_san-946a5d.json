描いていただければと思います。\n\n亀頭がうっすら透けて見えるローションガーゼを手に持つ豊姫様と\n縛られてベットに寝かされているペットくん\n流れとしては\n①\n豊姫）主人のパンツでオナニーするなんて悪いペットちゃんね❤\nこれはちょ～っとおちんちん躾けないと駄目かしら❤\nペット）あっあっ❤とよひめさまごめんなさいっ❤\n豊姫）すーりすーり❤\nペット）はあああっ❤\nとよひめさまぁ❤\n射精るっ射精ちゃいますぅぅ～❤\n②\nガーゼ越しに剥きっ❤って半被りの包茎が全部剥けて\n敏感な亀頭が全部あらわになると同時に\nびゅるるっどくっどぷっと濃い射精とビクッビクッと痙攣\n\n豊姫）あん❤\n\nペット）～～～～！！！！♥❤\n\n③\nペット）はあっはあっ❤\n\n豊姫）じゃあ続きね❤\nペット）えっ！？！\n豊姫）躾って言ったでしょう？\nペットちゃんがもうオナニーしたくなくなるぐらい\nおちんちん躾けちゃうんだから❤\n④\n豊姫）そ～れ❤カリ首ずりずり～❤\n\nペット）とよひめさまっ❤\nこれっ無理っ無理ぃ～っ！！！\n\n豊姫）だぁめっ❤\nイキたておちんちんじゃないと躾にならないでしょう？\n\nペット）あっあっ！ちんちんこわれるっ❤\n⑤\nぷしゃああああと潮吹きしてガクガクと痙攣\n\nペット）～～～～～～！！！！\n\n豊姫）あらあら❤\nビクビク震えて可愛い❤\nこのままおちんちんの悪い穢れ全部出しちゃいましょうね❤\n\n～～～～～！！！\nちんちん無理っ！無理ですぅぅ～！！❤\nゆるひてくらはい～～❤❤", "nc": 41, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}], "sent_works": [], "similar_creators": [{"id": 22964, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "すずしろなずな/蘿蔔なずな🔞 4 in progress", "screen_name": "szsr_nzn", "avatar_url": "https://proxy.misskeyusercontent.jp/avatar/media.misskeyusercontent.jp%2Fio%2Fwebpublic-2daafccc-ee79-4279-bd33-73abad822788.png%3Fsensitive%3Dtrue?avatar=1", "header_url": "https://media.misskeyusercontent.jp/io/webpublic-82766f31-5888-42d7-8778-80a462f11a3f.webp?sensitive=true", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 120, "skills": [{"genre": "comic"}, {"genre": "art"}, {"genre": "correction"}], "banned": false, "nc": 48}, {"id": 26229, "creator": true, "nsfw_acceptable": true, "acceptable": false, "name": "ハコジマアカネ", "screen_name": "haco0o000", "avatar_url": "https://pbs.twimg.com/profile_images/1643597468607860738/5OUqMxsl.jpg", "header_url": "https://pbs.twimg.com/profile_banners/2829062113/1583634784/1500x500", "appeal_receivable": true, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "de