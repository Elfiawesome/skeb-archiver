れに荒れた。\nしかし暫くして、姉と過ごした神有の街が、姉との思い出ばかりのこの街が大切だと再確認し、満身創痍ではあるがやっとの思いで失意から立ち直る。気にかけてくれるNPCや慕ってくれるNPCの存在が心の支えになっていたお陰でもある。\n\n\n【参考資料URL】\nhttps://drive.google.com/drive/folders/1ULXBNHLOqsTUgeNXwlZxa4OlFHdVRmGX?usp=sharing\n\n\n以上になります。\nご検討の程よろしくお願い致します。\n\nhttps://drive.google.com/drive/folders/1ULXBNHLOqsTUgeNXwlZxa4OlFHdVRmGX?usp=sharing", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [{"path": "/@tamagoDX1414/works/279", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 583942, "client_id": 2876790, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/21d61ecd/uploads/origins/ea9edcd2-c9e2-4ad5-880a-6b4b9396cf7c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f968ce3dc409e33ac74914a3ea4420eb", "srcset": "https://si.imgix.net/21d61ecd/uploads/origins/ea9edcd2-c9e2-4ad5-880a-6b4b9396cf7c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f968ce3dc409e33ac74914a3ea4420eb, https://si.imgix.net/21d61ecd/uploads/origins/ea9edcd2-c9e2-4ad5-880a-6b4b9396cf7c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=fd8f43dcf32fc741e1aaccbe11420162 2x, https://si.imgix.net/21d61ecd/uploads/origins/ea9edcd2-c9e2-4ad5-880a-6b4b9396cf7c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=2b150f0e28b9f8000d97771a6019bd1c 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/21d61ecd/uploads/origins/ea9edcd2-c9e2-4ad5-880a-6b4b9396cf7c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5da48510301da8e15bd1151270b8479a", "srcset": "https://si.imgix.net/21d61ecd/uploads/origins/ea9edcd2-c9e2-4ad5-880a-6b4b9396cf7c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5da48510301da8e15bd1151270b8479a, https://si.imgix.net/21d61ecd/uploa