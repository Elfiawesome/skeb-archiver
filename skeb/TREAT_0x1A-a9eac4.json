下に彼女たちの簡単な紹介を記載します↓  \n\nヒルダ：栗色の長い髪で、静かで大人しく、お利口で美しい。少し変わり者なところがあり、リリアナの姉。人工的に生み出された魔女。性格は少し淡々としているが、家族を大切にし、リリアナをとても大切にしている。（外見の参考画像：17～18） \n\n リリアナ：金色のロングヘア。可愛くて活発な「アメリカン・スウィートハート」。想像を超える無邪気さと明るい性格の持ち主で、創造された魔女です。豊かな人間の感情を持ち、家族を深く愛し、姉もとても大切に思っています。（外見の参考画像：19～21）   \n\nどのようなやり取りでも自由に描いていただいて構いません！（別々に描いていただいても全く問題ありません！）リンク先に詳細な設定や資料を用意しています。もし金額が合わない場合は、再度リクエストを送っていただければ大変助かります！もし今回の依頼を引き受けていただけたら、本当に感謝いたします！   \n\nhttps://drive.google.com/drive/folders/13qC9JytxXwQ2G-X7q6VxWOe2oXlCbqke?usp=share_link", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@TREAT_0x1A/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 4023008, "client_id": 2401873, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/01ffc080/uploads/origins/2c67f96c-09ea-4abb-87cd-a7823245a2a4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1700d1beb8730d5baa8407f2e83c7d22", "srcset": "https://si.imgix.net/01ffc080/uploads/origins/2c67f96c-09ea-4abb-87cd-a7823245a2a4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1700d1beb8730d5baa8407f2e83c7d22, https://si.imgix.net/01ffc080/uploads/origins/2c67f96c-09ea-4abb-87cd-a7823245a2a4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=1e27aa661dcf9e564e7c61190ce95cb5 2x, https://si.imgix.net/01ffc080/uploads/origins/2c67f96c-09ea-4abb-87cd-a7823245a2a4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=2def6dfd3d40fcc3510a8c46d116a364 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/01ffc080/uploads/origins/2c67f96c-09ea-4abb-87cd-a7823245a2a4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6c8d7c4fa269c584ecfd8272b5857dce", "srcset": "https://si.imgix.net/01ffc080/uploads/origins/2c67f96c-09ea-4abb-87cd-a7823245a2a4