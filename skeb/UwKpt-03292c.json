nail_image_urls": {"src": "https://si.imgix.net/4b9ae297/uploads/origins/c4ea069f-bce3-441c-ad36-6990fa34ea75?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=4849882b23222b183faf3e29c61b5fb0", "srcset": "https://si.imgix.net/4b9ae297/uploads/origins/c4ea069f-bce3-441c-ad36-6990fa34ea75?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=4849882b23222b183faf3e29c61b5fb0, https://si.imgix.net/4b9ae297/uploads/origins/c4ea069f-bce3-441c-ad36-6990fa34ea75?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=027223acfb98e3119b6c50675ff0595c 2x, https://si.imgix.net/4b9ae297/uploads/origins/c4ea069f-bce3-441c-ad36-6990fa34ea75?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=cbe7b302b8ed7b63155b4c38f1c83416 3x"}, "body": "初めてのご依頼失礼します。\n野々原茜さんのイラストをお願いしたいです。\n\n・プロデューサー（女P）の方を見て話している表情の茜（女Pはイラストに写っていなくても大丈夫です。写っている場合は女Pの一部分で、服は黒かネイビーのパンツスーツでお願いします。）\n・衣装はプライベートドレスの緑の方でお願いします。\n・髪型はSHSでお願いします。\n・短めのセリフが吹き出しであると有難いです（敬告さんの解釈の野々原茜が本当に大好きなので、セリフはお任せしたいです💦、難しい場合は「プロちゃん」でお願いします。）\n・背景は夕日が出ている海でお願いします。\n・2人で海に来ているイメージです。\n・ちょっと重ための茜だと嬉しいです。\n\nアイマス垢のヘッダーに一部分を使わせて頂きたいのですが、可能でしょうか？\n拙い文章ですみません。よろしくお願いします。", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@UwKpt/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 104176, "client_id": 567938, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/85842177/uploads/origins/7b8ce01d-1833-4acf-a346-e3dfae027869?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d9421eebf2d3d8b58e74c64a91e055fb", "srcset": "https://si.imgix.net/85842177/uploads/origins/7b8ce01d-1833-4acf-a346-e3dfae027869?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d9421eebf2d3d8b58e74c64a91e055fb, https://si.imgix.net/85842177/uploads/origins/7b8ce01d-1833-