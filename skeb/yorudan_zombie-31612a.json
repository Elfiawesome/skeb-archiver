txt=PRIVATE&s=41350d6159c4f8f34fa0bc70e9ec3fca 3x"}, "private": true, "genre": "art", "tipped": false, "creator_id": 508651, "nc": 32}, {"path": "/@yorudan_zombie/works/16", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 508651, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/7f7e673d/uploads/origins/2d27ae0d-19b0-4c28-a51f-e9964cd3a141?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ad59d05d7e18de5452c3764e13b7210b", "srcset": "https://si.imgix.net/7f7e673d/uploads/origins/2d27ae0d-19b0-4c28-a51f-e9964cd3a141?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ad59d05d7e18de5452c3764e13b7210b, https://si.imgix.net/7f7e673d/uploads/origins/2d27ae0d-19b0-4c28-a51f-e9964cd3a141?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=4e80d2aa26b647a4616a663db19cb0d0 2x, https://si.imgix.net/7f7e673d/uploads/origins/2d27ae0d-19b0-4c28-a51f-e9964cd3a141?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=3b1764510a5079428d01edf08bc91b8e 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/7f7e673d/uploads/origins/2d27ae0d-19b0-4c28-a51f-e9964cd3a141?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=53d60591ecfd3690adc7e06d4b87b7d4", "srcset": "https://si.imgix.net/7f7e673d/uploads/origins/2d27ae0d-19b0-4c28-a51f-e9964cd3a141?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=53d60591ecfd3690adc7e06d4b87b7d4, https://si.imgix.net/7f7e673d/uploads/origins/2d27ae0d-19b0-4c28-a51f-e9964cd3a141?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=bd88f0b3211cdb6741bc93874d0b2287 2x, https://si.imgix.net/7f7e673d/uploads/origins/2d27ae0d-19b0-4c28-a51f-e9964cd3a141?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=125c812ce0b0c9a6965682dcf179a8e2 3x"}, "body": "いつもお世話になっています\nR18イラストのリクエストです。  \n以前依頼したエリュティマさんヴィラン堕ちの続きで\nキャラクターは夜だんさん宅のエリュティマさん、ナリアさんをお願いします。\n\n■シチュエーション  \nヴィラン堕ちしたエリュティマさんに敗北したナリアさんが、エリュティマさんと同じように洗脳のセンブランスで調教され、ビッチな性悪ヴィランに変えられる\n\n■コマの流れと構図等、()内urlは体位の参考イメージ\n\n1.「エリュティマに敗北したナリアさんが、秘部をエリュティマさんの両手に開かれ、竿役の竿を受け入れる様な姿勢にされている」\n\n・全裸orはだけた服\n・ナリアさんは抵抗の表情、エリュティマさんは早くナリアさんを食べてもらいたい嗜虐的な笑み\n\n(https://www.pixiv.net/artworks/101565695)\n\n2.「エリュティマさんがヴィランからコピーしたセンブランスでナリアさんを洗脳しながら、エリュティマさんはペニバンで後ろから、竿役は下から挿入している」\n\n・エリュティマさんからセンブランスを流し込まれ、ハート目を散らしながら2人に突かれるナリアさん\n・ハート目笑顔の屈服差分があるとありがたいです\n\n(https://www.pixiv.net/artworks/103776972)\n\n3.「ヴィランの一員になったナリアちゃんがハンターを倒し足蹴にして、中指を立てている※エリュティマちゃんヴィラン堕ち3枚目のような感じ」\n\n・黒ギャル\n・髪は少し伸ばして毛先がウェーブでサイドテールにしている、グラデーション(色はおまかせ)\n・ネイル、タトゥー、カラーのメイクあり\n・服装はビッチヴィランらしい肌面積が多い淫らで悪そうな物\n・嗜虐的笑みで暴力を楽しんでいる\n\n\n4.「ソファーに座るヴィランの左右にナリアちゃんとエリュティマが侍らされており、連れてこられたハンターを見下し踏みつけている」\n\n・どちらも最後の黒ギャルデザイン\n・エリュティマさんは胸を、ナリアさんは尻を揉まれている\n\n(https://www.pixiv.net/artworks/104017023)\n\n\n5.「ヴィランとのイチャラブえっちを、ビデオ撮影で見せつけている」\n\n・並べられ、エリュティマさんは事後で、ナリアさんが挿入されている\n・二人共カメラにピースをしている\n\n(https://www.pixiv.net/artworks/103098864)\n\n\n■補足\n・複数のシチュを漫画形式の様に並べてくださるとありがたいです(複数ページになっても問題ないです)\n・竿役は浅黒の体格の良い巨根の男性でお願いします\n・夜だんさんの入れたい構図、性格の悪い女やヴィランの所作があれば増やしていただいても大丈夫です\n\n\n以上になります、人数が多く大変と思いますがご検討よろしくお願いします", "nc": 184, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@yorudan_zombie/works/15", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/0601e956/uploads/origins/31fa9cc2-1df4-4d1b-a3cf-8a70f7c1b37f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=7d4311a31a4566545b29c486cf6ff985", "srcset": "https://si.imgix.net/0601e956/uploads/origins/31fa9cc2-1df4-4d1b-a3cf-8a70f7c1b37f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=mid