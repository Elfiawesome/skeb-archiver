いんだけど、その場合、角と尻尾はなくしてもいいよ。髪型は、ユベルの髪型を真似てもいいし、僕のOCの髪型のままでもいい。\n表情は、彼女は見る人を威嚇するように見ているはずだ。\n\nもし望むなら、アイデアを破棄して普段着の彼女を描くこともできる。あなたが描く絵はきっと素晴らしいものになると思うわ！\n\nご検討ありがとうございました！\n\nhttps://imgur.com/a/GJwFx95", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@shou3_2/works/15", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3119601, "client_id": 211553, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/609f6136/uploads/origins/213dcc67-c8db-4e5b-a1bd-5b2976451b62?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6dbe9a32381bc4c063062b7274d0aaf1", "srcset": "https://si.imgix.net/609f6136/uploads/origins/213dcc67-c8db-4e5b-a1bd-5b2976451b62?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6dbe9a32381bc4c063062b7274d0aaf1, https://si.imgix.net/609f6136/uploads/origins/213dcc67-c8db-4e5b-a1bd-5b2976451b62?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=782e47eb6d9f1330f624299539e3b82b 2x, https://si.imgix.net/609f6136/uploads/origins/213dcc67-c8db-4e5b-a1bd-5b2976451b62?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=cf3a3dea66123c098af81f0ccdab3a80 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/609f6136/uploads/origins/213dcc67-c8db-4e5b-a1bd-5b2976451b62?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2f517b34abc4d6c7133fcff11fc29be4", "srcset": "https://si.imgix.net/609f6136/uploads/origins/213dcc67-c8db-4e5b-a1bd-5b2976451b62?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2f517b34abc4d6c7133fcff11fc29be4, https://si.imgix.net/609f6136/uploads/origins/213dcc67-c8db-4e5b-a1bd-5b2976451b62?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=f2641e9aad775c079e14ff764