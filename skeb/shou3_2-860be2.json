リッパー\n・必ず親友や師匠など親しい間柄の者に殺されてしまうのがトリガー(回避不可)\n\n［使用用途］\n・SNS(X(旧Twitter)など)へ投稿､アイコンなど\n・YouTubeやTwitchなど配信時のサムネイル使用など\n魚座の魔法使いとしての活動全般で使用させていただきます\n☆使用する際は必ずクレジットを記載させていただきます\n\n［希望］\n・ケモ耳と左右は切れないようにお願いしたいです……！\n・人物･宛名などを別レイヤーにしたPSDデータ､もしくは透過データをいただきたいです\n・もし可能でしたら表情差分をいただければ嬉しいです…！\n\n長々と大変失礼致しました\n最後まで御一読頂けましてありがとうございます\nご検討の程よろしくお願いします！\n\nhttps://x.com/pisceswizard/status/1672620829870530560?s=46&t=ptbVd-lrKBTRaZHsojZjZg", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@shou3_2/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3119601, "client_id": 13351, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/86ab22df/uploads/origins/51008524-0e55-4dde-80c9-1eee082f94e8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=da835066d1c073f1b344a7ea3d19cc2a", "srcset": "https://si.imgix.net/86ab22df/uploads/origins/51008524-0e55-4dde-80c9-1eee082f94e8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=da835066d1c073f1b344a7ea3d19cc2a, https://si.imgix.net/86ab22df/uploads/origins/51008524-0e55-4dde-80c9-1eee082f94e8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=166e68f7ab538153b418bc75332697bb 2x, https://si.imgix.net/86ab22df/uploads/origins/51008524-0e55-4dde-80c9-1eee082f94e8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=81d0e0b8ddbd636477715400bfd9d4ad 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/86ab22df/uploads/origins/51008524-0e55-4dde-80c9-1eee082f94e8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=85bf9ea8696b59b0e31004c67fa07a62", "srcset": "https://si.imgix.net/86ab22df/uploads/origins/51008524-0e55-4dde-80c9-1eee082f94e8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=85bf9e