レンジの左目側の髪の毛には紫色の髪の房が2つあります。\n★襟の部分、ズボン、帽子のリボンの濃い青色の部分は牛柄\n\n【要望】\n構図や表情はお任せします、頭部は切らないように納めて頂けたらと思います。\nPNGもしくはPSD形式で、背景を透過したキャラクターのみのデータもいただけますと幸いです。\n\n【モチーフ】\n牛柄、星、薔薇(赤と青のグラデーション)\n\nご検討いただけますと幸いです。宜しくお願いいたします！\n\nhttps://drive.google.com/drive/u/0/folders/1e4yNNAixXk5L9qsgUFTH1cm7dFK34ni5?hl=ja", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@rinne_nekozzz/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3752190, "client_id": 3462721, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/e4026304/uploads/origins/d5b6f650-2a9b-4a5b-b221-412575df8193?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=50ce85519dfb8b43dc1e5a7151fba274", "srcset": "https://si.imgix.net/e4026304/uploads/origins/d5b6f650-2a9b-4a5b-b221-412575df8193?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=50ce85519dfb8b43dc1e5a7151fba274, https://si.imgix.net/e4026304/uploads/origins/d5b6f650-2a9b-4a5b-b221-412575df8193?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=d31110fd15053e759c14553c832e2f89 2x, https://si.imgix.net/e4026304/uploads/origins/d5b6f650-2a9b-4a5b-b221-412575df8193?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=5389f65cbe5060cf2b2ed0b51710c73b 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/e4026304/uploads/origins/d5b6f650-2a9b-4a5b-b221-412575df8193?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=4600651e1a4ce89c8571f1cb19cf3ac7", "srcset": "https://si.imgix.net/e4026304/uploads/origins/d5b6f650-2a9b-4a5b-b221-412575df8193?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=4600651e1a4ce89c8571f1cb19cf3ac7, https://si.imgix.net/e4026304/uploads/origins/d5b6f650-2a9b-4a5b-b221-412575df8193?bg=%23ff