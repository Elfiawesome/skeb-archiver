c90?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fc4fac8e5fe8a727a87a9ac66314abdd", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/5b93b6d1/uploads/origins/046bd596-544a-4120-bef3-989e9c612c90?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=eec3e36e8c101dcf48a56eef867ea217", "src_set": ""}, "body": "ずばちゃん様\n\nリクエストをお願いします。\n\n・僕の所持するVアバター「乙羽衣 乃音」がパイズリフェラしているイラストを描いていただきたいです。\n・金額内で可能であればぶっかけ差分もお願いします。(差分は出来ればで大丈夫です)\n・胸は大きめに盛っていただきたいです。\n・構図等はお任せします。\n・描いていただいたイラストはSNSでの使用等個人利用の範疇で使用させていただきたいです。\n\n何卒ご検討の程よろしくお願いします。\n\nhttps://drive.google.com/file/d/1PQsIBur3pousfL17Na7Vt4oXPq5N2vlM/view?usp=drivesdk", "nc": 33, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@ripfalo245/works/20", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2504199, "client_id": 0, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/f7f9e282/uploads/origins/d71a67c8-cd38-4ca1-887a-5bcaad293b5e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7d02ea5db67056cd8c22b958a5396bb8", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/f7f9e282/uploads/origins/d71a67c8-cd38-4ca1-887a-5bcaad293b5e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b15d4c64b454491531c5fab7f5bd1d95", "src_set": ""}, "body": "ポケモンのミヅキとリーリエ\n\n胸が小さいのが嫌なリーリエは、胸を大きくするマッサージ法を発見し、友人のミヅキに助けを求めた。マッサージはとても効果的で、強烈な快感を与えてくれる。\n\nリーリエがミヅキの膝の上に座り、ミヅキが後ろから胸を大きくするマッサージをしているところを描いてください。  リーリエの胸は彼女の頭と同じくらい大きい。彼女は目を閉じ、喜びで顔を赤らめる。彼女はもっと大きくなりたいと思い、「もっと...」と呻く。ミヅキは拗ねたように微笑み、リーリエを成長させ続けることを喜んでいる。\n\nポーズ例：https://www.pixiv.net/en/artworks/110946262\nリーリエの表情例：https://www.pixiv.net/en/artworks/112166030\n\nどんな衣装でもOK。女性二人ともトップレスにすることをお勧めします。\n\n詳細は自由です！ポーズを調整したり、私がリクエストしたよりもさらに大きな胸のリーリエを描いたりするのもご自由に。彼女はその気持ちよさを知ってしまったので、とんでもなく巨大な胸を育てるというアイデアが好きなのです。成長する感覚を楽しんでいる、とてもバストアップしたリーリエが見たいです！\n\nhttps://www.deviantart.com/64smashmaster3ds/art/Pokemon-Sun-and-Moon-Lillie-and-Selene-825850853", "nc": 49, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@ripfalo245/works/19", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2504199, "client_id": 517193, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/7d7f44c1/uploads/origins/8d21fca5-ad64-483b-9af2-d023a569a107?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9e2f50ce5628fcaa8cc6efcf9470cc12", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/7d7f44c1/uploads/origins/8d21fca5-ad64-483b-9af2-d023a569a107?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f350704515f00601915c8c93d1f93c9f", "src_set": ""}, "body": "ずばちゃんさんこんにちは！\nいつもスピーディな納品で大変助かっております…！🥰\nパイズリするあれぐろもるとを描いていただきたくリクエストしました！\n\n■構図・ポーズ\nちんちんにパイズリをするあれぐろもるとを描いていただきたいです。服は着たままでも構いませんし、完全に脱いでいても構いません。（着たままだと服の構造的に難しいかも…？パイズリしやすそうな服の構造に改造して描くというのでもOKです。）\n\n竿役は、男性リスナーを想定しておりまして、顔が画面にうつらないように描いていただきますと助かります。\n\nなお、おっぱいやふともものサイズは自由に盛っていただいて構いません。また、服のディテールなど、デザインの細かい部分について多少アレンジが入る分には構いません。\n\n■対象年齢\nR-18\n\n■用途\n次の用途でイラストを使用させていただく場合があります。\n* クレジット表記の上でのSNSでの投稿\n* クレジット表記の上での動画・LIVE配信・サムネへの使用\n※イラストの一部のみトリミングする場合があります\n\n■ファイル形式\n背景とキャラクターのレイヤーが別になっているPSDファイルを含めていただけると助かります。\n\n■参考資料\n資料としてXの固定ポストのリンクを添付しました。\nリプ欄には各メディアへのリンクもございますので、必要に応じて参考にしていただければと思います。\n\n以上となります。\nお手数おかけしますがご検討のほどよろしくお願いします！\n\nhttps://twitter.com/AllegroMoltoV/status/1700397595036877227", "nc": 32, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@ripfalo245/works/18", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creat