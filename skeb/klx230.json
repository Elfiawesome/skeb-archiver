_count": 0, "received_works": [{"path": "/@klx230/works/24", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 387215, "client_id": 0, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/78178658/uploads/origins/2c91d0d8-3d50-45c2-a6f9-59633e77d256?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=09e52a4fc8522300e1e5e07028fd17c3", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/78178658/uploads/origins/2c91d0d8-3d50-45c2-a6f9-59633e77d256?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=cc1d79c642cbfe258da1ca36af1b2bdb", "src_set": ""}, "body": "ウマ娘のダイイチルビーとトニビアンカが勝負服かドレス着て親しげに社交ダンスしているイラストください！！\nトニービン産駒の娘はいてもトニービン本人と接点がある娘がいない中で貴重な史実夫婦です！しかも産駒二人いてしかも両方勝ち上がってる！えらい！\n乗るしかないシングレ2期のビッグウェーブに！！", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@klx230/works/23", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 387215, "client_id": 347107, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/cc11a3ab/uploads/origins/c75c6751-7421-4eb9-82bc-e07564c51f57?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=54c0415600c1ff000f7e31bc884739e2", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": true, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/cc11a3ab/uploads/origins/c75c6751-7421-4eb9-82bc-e07564c51f57?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f59df543dbaa2d46faddfd7303704f56", "src_set": ""}, "body": "いつも拝見させていただいています。依頼させてください。\n\n以前イメージして描いていただいた\nhttps://twitter.com/klx230/status/1443781899026006016/photo/1\nhttps://skeb.jp/@klx230/works/11\nのイイ女の資料用の三面図をお願いしたいです。\n身長とスリーサイズもイメージして設定していただければ\n\n衣装は体のラインがわかる様にぴったりとしたハイレグの競泳水着をお願いします\n水着のデザインは以前お願いした水着と似た同じで大丈夫です。\n\n他のイラストレーターに資料として参照してもらう事を予定しています。\nえっちな事もする予定です。\n\n以上となりますがよろしくお願いします。", "nc": 162, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@klx230/works/22", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 387215, "client_id": 405731, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/a0a4a696/uploads/origins/effbd141-ef06-4c1a-889d-d57f49f42bf6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5155b324f4124e0125a0f3f17e722ac2", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/a0a4a696/uploads/origins/effbd141-ef06-4c1a-889d-d57f49f42bf6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=851fde4a69c00fb319e445a5abffec49", "src_set": ""}, "body": "以前クリスエス×ハート×ギムレットのイラストを依頼した者です。その節はありがとうございました。\nメインストーリーでハートが登場した時、頂いた作品のことをふと思い出していました。\n\n今回のリクエストですが、大学生になったキタサンブラックとラッキーライラックが鴨川のほとりで語り合っている様子をお願いします。\n\nラッキーライラックの雰囲気とつかささんの絵柄は絶対に合う！と思ったのですが、まだお目にかかれていないのでこの機会にと思い依頼しました。\nご存知とは思いますが、キタサンブラックとラッキーライラックは今年産駒が誕生したリアルタイム史実夫婦です。\n現役を引退した2人がターフの外で出会った様子を見たいと思いこのリクエストにしています。\n\nぜひご承認のほどよろしくお願いします！", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@klx230/works/21", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 387215, "client_id": 0, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/a2613a6c/uploads/origins/9e7a6078-97ea-4cdf-815d-01667f79f4fe?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6b4ede18ea66ecd4565d1fec49218816", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/a2613a6c/uploads/origins/9e7a6078-97ea-4cdf-815d-01667f79f4fe?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e72b27b0bb2f7dc3a7d76c04ce4d9ff3", "src_set": ""}, "body": "ウマ娘の奈瀬トレーナーとスーパークリークが初詣してるイラストをお願いします！着物姿だとなお嬉しいです！", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@klx230/works/20", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 387215, "client_id": 530945, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/e41d0fdd/uploads/origins/ffa1c223-267b-445e-b5e5-e1011d064cdc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e1fd4b65c3f423aa22871947d422ecc1", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/e41d0fdd/uploads/origins/ffa1c223-267b-445e-b5e5-e1011d064cdc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=4d023582df557494093274993aa087e7", "src_set": ""}, "body": "いつも素敵なイラストの数々を拝見しております！\nその中でも黄金世代の面々――特にツルちゃんの絵が本当に大好きで、\n今回は、ツルちゃんのイラストをお願いしたく、リクエストをお送りさせていただきました。\nお願いしたいリクエストの内容ですが、以下のようになります。\n\n・成長し医者になっているツルマルツヨシ(白衣着用)　です。\n生来身体が弱かったからこそ、「同じく悔しい想いをしているウマ娘を助けられるように」と考えて、スポーツドクターのような職を目指してほしいなと、個人的な解釈ですがそのように思っています。\n構図としては、診察されている子供目線から見上げたようなツルちゃんをお願いしたいです。病院に掛かった子が不安に思わないよう、優しい笑顔を向けてくれていると嬉しいです。\n\nカラー・モノクロに加え、背景の有無は問いません。\nただ、可能であればスマホの壁紙に使用させていただければと考えております。\n（※必ずしも縦長の画像を要望することでもございません）\n\n構図やその他指定など、曖昧過ぎてしまっている場合は申し訳ございません。\nイラストについての、ほとんどのご判断を委ねてしまうことになっておりますが、\nよろしければご検討のほどをいただけますと幸いです。\nそれでは、よろしくお願いいたします。", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@klx230/works/19", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 387215, "client_id": 405731, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/838567ea/uploads/origins/edcbdc3a-50dd-4713-839f-f108dacc08f7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=403c7a1c2c151551b16a66f69848ef0c", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/838567ea/uploads/origins/edcbdc3a-50dd-4713-839f-f108dacc08f7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2c03cde58f033a36eaeac12b9243847e", "src_set": ""}, "body": "いつも素敵なイラストを拝ませていただいています！\n透明感があって鮮やかな塗り、複数キャラ絵で表情豊かにわちゃわちゃしているところがとても好きです。\nかつデアリングハートを描かれていらっしゃったので、今回の依頼をすることにしました。\n\nリクエストですが、デアリングハートがシンボリクリスエス＆タニノギムレットとレジャーを楽しんでいるカラーイラストをお願いします。\nシチュエーションはお任せしたいのですが、楽しそうなハートを中心としてギムクリ二人がwith Bのように寄り添っている構図にしてください。\n\nモデルとなったデアリングハートは本人もGIII 3勝の名馬ですが、現役引退後もデアリングタクトへの血筋を繋いだ名牝でもあります。\nそんなデアリングハートの初交配相手がシンボリクリスエス、不受胎のため三週間後に交配されたのがタニノギムレットです。\nこれをウマ娘で考えたときの関係はとても美味しいんじゃないか…？と思い依頼することにしました。\n\n長々書いてしまいましたが、ぜひご承認のほどよろしくお願いします！", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@klx230/works/18", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/d4ad6d0c/uploads/origins/e361b8a5-acba-4b09-949c-7a3eede93f23?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=9e10ac25482c91a1df110cd09cc2dea3", "src_set": ""}, "private": true, "genre": "art", "tipped": false, "creator_id": 387215, "client_id": 211812, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 161, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@klx230/works/17", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 387215, "client_id": 2129226, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/7b9c43ea/uploads/origins/a5f2e1ba-2473-4746-b304-93393dbf1102?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e458faa0c4c6bd1a4fa