db1a3606f91a8541e9ce73e, https://si.imgix.net/7d08f6cd/uploads/origins/2f570e5b-ea7c-4ffa-ae28-f17090bb4472?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=904474c119ce49b4d44aeb44ba6666ef 2x, https://si.imgix.net/7d08f6cd/uploads/origins/2f570e5b-ea7c-4ffa-ae28-f17090bb4472?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=afd5531344e925e85f84c538e1b7e80c 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/7d08f6cd/uploads/origins/2f570e5b-ea7c-4ffa-ae28-f17090bb4472?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a14c4baf97728b8ee29046af87683abc", "srcset": "https://si.imgix.net/7d08f6cd/uploads/origins/2f570e5b-ea7c-4ffa-ae28-f17090bb4472?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a14c4baf97728b8ee29046af87683abc, https://si.imgix.net/7d08f6cd/uploads/origins/2f570e5b-ea7c-4ffa-ae28-f17090bb4472?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=96555c4f10033a7f0d12ac6f69835427 2x, https://si.imgix.net/7d08f6cd/uploads/origins/2f570e5b-ea7c-4ffa-ae28-f17090bb4472?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=ad3515b6072bc71660cc673aa8ec521b 3x"}, "body": "モのしんでんさん、初めまして！モのしんでんさんのツイッターのイラストがとても好きで、映画のワンシーンのようなストーリー性が膨らんでいて、いつも見入ってしまいます！もしよかったら、うちのオリジナルキャラクターを描いていただけないでしょうか！\nキャラクターの大まかな紹介文を下に載せました。カップル未満的な二人です。具体的な構図や内容はお任せします！できれば二人一緒に出てる絵が見たいですが、一人だけの構図でももちろん大丈夫です！\nキャラクターの外見はGoogle driveに上げました。こちらからご覧頂けると幸いです！\nhttps://drive.google.com/file/d/1nRW2X5gFPs7DUGJvzL_kcsUV1vyysSkX/view?usp=sharing\nよろしくお願いします！\n\n----\n長い黒髪のお兄さん\n前ヤのつく職業。犬（ドーベルマンの子犬）と中身入れ替わってしまって、体だけ親友の家で居候中。中身の行方は不明。親友の努力により二足歩行できるようになったけど、やっぱりしゃがんでいる方が好き。服着るのを嫌がる。まだ言葉をしゃべることができない。\n入れ替わる前はてきぱきの性格でよく笑うよく食べる。筋肉がつきにくい体質で、力では勝てにくいと考え、小刀やワイヤーを武器にしてる。指先、腕、脇腹に切り傷の跡残っている。\n\nプリン頭のお兄さん\n前ヤのつく職業。考える事は苦手で、性格は見た目ほど凶暴ではない。親友が犬と入れ替わってからフリーターになって親友の世話をしながら中身を捜索中。親友のサラツヤ黒髪を維持するために石鹸洗髪からシャンプー、トリートメント、リンスの違いがわかるようになった。犬（親友）の風呂と散歩（主に他人からの視線）が悩み。人の体にフィットするリードがなかなか見つからない。\n----", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@mozame_mo/works/4", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/29ade85e/uploads/origins/7dfa1f93-b324-4236-b063-3cc79e7adb63?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=df44a0074a68b6f84cbdcf8ed09d44c6", "srcset": "https://si.imgix.net/29ade85e/uploads/origins/7dfa1f93-b324-4236-b063-3cc79e7adb63?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=df44a0074a68b6f84cbdcf8ed09d44c6, https://si.imgix.net/29ade85e/uploads/origins/7dfa1f93-b324-4236-b063-3cc79e7adb63?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=aeebe69286e865cd8fb76b8dc97a0f3b 2x, https://si.imgix.net/29ade85e/uploads/origins/7dfa1f93-b324-4236-b063-3cc79e7adb63?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=423dd16d5ff4ec4c337eeb0243314a9d 3x"}, "private": true, "genre": "art", "tipped": true, "creator_id": 2056134, "client_id": 187493, "nc": 32}, {"path": "/@mozame_mo/works/3", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/2b9edd81/uploads/origins/5e4c24c8-7ede-4fec-8e43-d3b77fb61d08?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=5cd4d88000c275c64f8e50d4873aab7b", "srcset": "https://si.imgix.net/2b9edd81/uploads/origins/5e4c24c8-7ede