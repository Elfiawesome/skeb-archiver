: null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/d2e2a0b5/uploads/origins/fc6d6420-2eed-4d8f-b789-d88657585634?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e5c5d33f1c70e3e282366893cebf938e", "srcset": "https://si.imgix.net/d2e2a0b5/uploads/origins/fc6d6420-2eed-4d8f-b789-d88657585634?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e5c5d33f1c70e3e282366893cebf938e, https://si.imgix.net/d2e2a0b5/uploads/origins/fc6d6420-2eed-4d8f-b789-d88657585634?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=2fa93a64f833f14fb5b8d2348146a3a5 2x, https://si.imgix.net/d2e2a0b5/uploads/origins/fc6d6420-2eed-4d8f-b789-d88657585634?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=928653425f1a50fbff79a708f824fc9d 3x"}, "body": "はじめまして！個人でVTuberをやっているkurenaifと申します。\n村紗船長の日頃の可愛い一面と、妖怪的な一面ギャップに惹かれてリクエストをさせていただきました！\n村紗でなくて大変恐縮なのですが、私kurenaifのイラストを一枚描いていただけますでしょうか\n\n衣装は3種類あるので、お好きに描いていただいて大丈夫です！\nhttps://drive.google.com/drive/folders/1cN2QLVxKmvUDfwWZ2enyMYzd9LsoP35B\n\nもし叶うのであれば、以下の要望を聞いていただけると嬉しいです！\n-----\n種族: 魔女（専門は暗号）\n能力: 基本的な魔法は使える。万物を暗号化し、正体をわからなくする（ぬえみたいなイメージ）特殊な魔法を得意とする。暗号化したものは他人には解読不可能になるが、自分だけはもとに戻せる。\n性格: 明るくて教え上手。人の気持ちを理解をして、人にあわせた教育をする先生をやっている。生徒からの評判もいい。\n表には出さないがかなり性格が悪く、相手が苦しむ様子を見ると嬉しくなってしまう。戦闘では相手の嫌がることばかりをし、苦しんでる様子を見ると、ニコニコしてしまう。\n\n☝もしよろしければ、相手視点でニコニコしてるkurenaifを描いていただけると嬉しいです！\n東方でありがちな、人間の形をしているけど人間じゃないんだぁ…みたいな雰囲気の絵だと特に嬉しいです！\nもし他にこういうシチュエーション描きたい！みたいなものがあればお好きに描いていただけるとと思います🙏！\n\nhttps://drive.google.com/drive/folders/1cN2QLVxKmvUDfwWZ2enyMYzd9LsoP35B", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@remyaruku65/works/14", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3662290, "client_id": 250442, "vtt_url": null, "thumbnail_image_urls": {"src": "https://