yocool/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2189883, "client_id": 2477368, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/c29f1e80/uploads/origins/a9e3140a-30d2-48ba-acc7-033b01f45a63?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=44a8c238eb7a70e5c775a4da2ac3dc55", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/c29f1e80/uploads/origins/a9e3140a-30d2-48ba-acc7-033b01f45a63?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=58ee7cb0b7468e3fade7672e93c2393d", "src_set": ""}, "body": "以前私が描いたマント姿のミュウツー (https://twitter.com/LuuMew/status/1565884828964503552?s=20&t=JN5yEB1_ynPfEeEkYweGcg) を蔵清さんにカッコよく描いていただきたいです！\n\n私のと同じく、表が白地で裏が赤地のマントでお願いします。\n絵の中に全身もマントもすべて入っているといいですね。\nシチュエーションとしては、月夜をバックにマントをなびかせながら浮遊している、というのはいかがでしょうか。(厳しければ背景はベタ1色でもいいですし、構図も描きやすいものでかまいません)", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "similar_creators": [{"id": 407778, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "かるき", "screen_name": "Kalk427", "avatar_url": "https://pbs.twimg.com/profile_images/1890518170265640960/DA48S_ql.jpg", "header_url": "https://pbs.twimg.com/profile_banners/932913367/1692754738/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "skills": [{"genre": "art"}], "nc": 129}, {"id": 786180, "creator": true, "nsfw_acceptable": false, "acceptable": false, "name": "wawa", "screen_name": "wawatiku", "avatar_url": "https://pbs.twimg.com/profile_images/1930047406810509316/scWjWE-1.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1316976623724318720/1729758706/1500x500", "appeal_receivable": false, "popular_creator_