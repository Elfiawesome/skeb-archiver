85f-21b2-4d62-bfe7-4ead2ff2cfef?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=12e0b51a3015cb456e77b2b34ad6ca0b, https://si.imgix.net/44805021/uploads/origins/6c8ee85f-21b2-4d62-bfe7-4ead2ff2cfef?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=74e23b5ae3f9b3f298d7dcd600d1f417 2x, https://si.imgix.net/44805021/uploads/origins/6c8ee85f-21b2-4d62-bfe7-4ead2ff2cfef?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=8e49faeea882c3ceca9297a62c7628a2 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/44805021/uploads/origins/6c8ee85f-21b2-4d62-bfe7-4ead2ff2cfef?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=78cd7d7559c460e1d4d7cf0230824679", "srcset": "https://si.imgix.net/44805021/uploads/origins/6c8ee85f-21b2-4d62-bfe7-4ead2ff2cfef?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=78cd7d7559c460e1d4d7cf0230824679, https://si.imgix.net/44805021/uploads/origins/6c8ee85f-21b2-4d62-bfe7-4ead2ff2cfef?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=6bc9c939b7269bc86582233da217a899 2x, https://si.imgix.net/44805021/uploads/origins/6c8ee85f-21b2-4d62-bfe7-4ead2ff2cfef?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=9cb79272cc38d54bd735445184237728 3x"}, "body": "双子系リバップルとﾈｺﾁｬﾝでいつもお世話になっております。\n暑い日が続いておりますが沖さんはお元気でしょうか。\n\nもし気が向かれましたらいつもの二人組＆ﾈｺﾁｬﾝで下記の依頼をお願い致します。\n\n「男性二人（どちらでも大丈夫です）の尻に刺さるﾈｺﾁｬﾝ」\nﾈｺﾁｬﾝはお尻の匂いを嗅いでいるだけすが、ゼロ距離ゆえに角度によっては刺さっているように見えています。\n服は着ていても着ていなくても大丈夫です。\n\nご検討宜しくお願い致します。", "nc": 161, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@oki_ts/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 161963, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net