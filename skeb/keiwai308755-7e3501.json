igins/975646b8-ff3b-4098-bdaa-acb1304daac7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5d31731ae9cd58752be0ff3f03cf434b", "srcset": "https://si.imgix.net/82505bc0/uploads/origins/975646b8-ff3b-4098-bdaa-acb1304daac7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5d31731ae9cd58752be0ff3f03cf434b, https://si.imgix.net/82505bc0/uploads/origins/975646b8-ff3b-4098-bdaa-acb1304daac7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=7e8b7606cb999c5615511408e8287cf2 2x, https://si.imgix.net/82505bc0/uploads/origins/975646b8-ff3b-4098-bdaa-acb1304daac7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d7843f2355ed26ca03d098257ca1c2df 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/82505bc0/uploads/origins/975646b8-ff3b-4098-bdaa-acb1304daac7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=efad76c2ba86e14438d288375695ac65", "srcset": "https://si.imgix.net/82505bc0/uploads/origins/975646b8-ff3b-4098-bdaa-acb1304daac7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=efad76c2ba86e14438d288375695ac65, https://si.imgix.net/82505bc0/uploads/origins/975646b8-ff3b-4098-bdaa-acb1304daac7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=2780255ccbb69ec92adca70ba2fca82c 2x, https://si.imgix.net/82505bc0/uploads/origins/975646b8-ff3b-4098-bdaa-acb1304daac7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=586a8eb78f9865d7f10acfb2d31f8dc1 3x"}, "body": "オリジナルロリのイラストをリクエストさせていただきます！\n\n・キャラ\n2~3歳位の幼女。オムツを履いていたら見た目はお任せします。\n\n・竿役\n幼女の母親。ふたなりであれば見た目はお任せします。竿や手だけでも可。\n\n・シチュエーション\nおしっこしちゃった娘のオムツを交換している母親。アナル好きな母親は娘のアナルで興奮しないように我慢してオムツを交換しようとする。\nすると無邪気な娘は母親が喜ぶと思ってアナルに入れたスーパーボールをひり出す遊びを見せる。肛門期の為か気持ちよさそうにエロい仕草を見せつける娘に我慢できず母親は一線を超える。\n\n以下の流れを差分で表現いただけますでしょうか。\nセリフや擬音は出来ればつけていただけると嬉しいです。\n\n①お尻におしっこが入ったから洗ってあげると嘘をつき指でアナルを広げている。娘は何をされているか分かっておらず笑顔。\n②デカチンポを見せつけた後娘の処女アナルをレイプ。しっかり拡張したので痛がってはおらずウンチをしているかの様に気持ちよさそうにしている。\n③射精しペニスが抜かれ、拡張したアナルからザーメンが溢れてくる。おしゃぶりの代わりにチンポをしゃぶらせた母親は汚れたからお風呂で続きをするねと娘に話している。\n\n要望は以上となります。\n\n色々お願いする形となり恐縮ですが、\nご検討よろしくお願いたします。", "nc": 168, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@keiwai308755/works/5", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/77b07893/uploads/origins/3fb7f4e9-ea5f-45c0-863f-58cc4a4791e0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=557ce06250921e7467d3245823cfb170", "srcset": "https://si.imgix.net/77b07893/uploads/origins/3fb7f4e9-ea5f-45c0-863f-58cc4a4791e0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=557ce06250921e7467d3245823cfb170, https://si.imgix.net/77b07893/uploads/origins/3fb7f4e9-ea5f-45c0-863f-58cc4a4791e0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=befb104182c09fc43f1af8a7af35eadc 2x, https://si.imgix.net/77b07893/uploads/origins/3fb7f4e9-ea5f-45c0-863f-58cc4a4791e0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=b97035f86eec287308a11e5180f73f7f 3x"}, "private": true, "genre": "art", "tipped": true, "creator_id": 3098747, "client_id": 118291, "nc": 32}, {"path": "/@keiwai308755/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3098747, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/1c4eddf1/uploads/origins/6d4aea3f-c85f-4b41-b618-b4df70ebd4ed?bg