_id": 0, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/a1e4cb62/uploads/origins/309a1ea9-0591-4644-b8df-830dc7ef828e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=651e9344c2b106cf00cf61e8ebf56193", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/a1e4cb62/uploads/origins/309a1ea9-0591-4644-b8df-830dc7ef828e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a91423f87c331e8a8beba9ec58df2d79", "src_set": ""}, "body": "少しカートゥーンチックな可愛らしい絵柄でいつも応援させていただいております。\n\nもしよろしければ、遊戯王のエクレシアちゃんが罠カード\"イタチの大暴発\"級のおならでたくさんの敵を吹き飛ばしているところが見たいです。敵については図形に目をつけた程度の極めて簡素なデザインで構いません。\nエクレシアちゃんの表情は恥ずかしさのあまり少し泣きそうな感じだと嬉しいです。ポーズは罠カードのイタチのような四つん這いで、お尻からガスが漏れ始めた直後のお尻とおならだけを描いたカットインがあると大変うれしいです。\n個人的な性癖として下は何か履かせていただけると幸いです\n\n本文・内容に不備や不足等があったりご都合が悪ければキャンセルや再送機能をご活用いただければ幸いです。\nご検討のほどよろしくお願いいたします。", "nc": 176, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@shiriudo3/works/46", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/a7c9175f/uploads/origins/899cf230-4b60-4df0-80c4-152e1760d6b8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=ad74c5f766aa36f23ee25ec36577ad2c", "src_set": ""}, "private": true, "genre": "art", "tipped": false, "creator_id": 502386, "client_id": 0, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 163, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@shiriudo3/works/45", "private_thumbnail_image_urls": null, "private": false, "genre": "comic", "tipped": false, "creator_id": 502386, "client_id": 0, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/a5598d2c/uploads/origins/f9e3f34d-4210-4893-9757-4dfedfd2937d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a1df1b19fa307697a7f765e74f3e1f46", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/a5598d2c/uploads/origins/f9e3f34d-4210-4893-9757-4dfedfd2937d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=863cce5509309e06d78658a9c61d5c3a", "src_set": ""}, "body": "前回依頼したルビサファ漫画が最高だったので再度先生に漫画形式で依頼したいです。\n今回もポケットモンスターSPECIALでキャラクターはゴールドとクリスタルの二人。\nシチュエーションは二人でオーキド博士からの依頼中、休憩がてら公園のベンチに並んで座りタンバ名物ほかほかやきイモ食べている。\nその時ゴールドが片尻上げてクリスの方におならをする\nゴールドは「よくあるこった。気にすんな。」と全く悪びれない。\nそんなゴールドにクリスはあり得ない、信じられない、デリカシーが無いなどボロクソにいい立ち上がりそっぽを向く（ゴールドにお尻が向いている状態、内心では私だって我慢してるのに…と思っている）\nあまりにもボロクソ言われた事でゴールドもイライラし目の前のクリスのお尻を見てニヤついて仕返ししてやると考える。\nクリスにバレないよう静かにしゃがみ込みニヤニヤしながらカンチョーをする。\n「きゃああ！！」と悲鳴を上げるがいきなりのカンチョーのせいでゴールドの顔面に爆音のおならをしてしまうクリス。\n顔面におならされたゴールドが「くっせ〜な！ちょっとした悪戯に屁で反撃することないだろ！」とクリスを罵る。\nおならしてしまい恥ずかしく真っ赤になりながら「ゴ、ゴールドがカ、カ、カンチョーなんてするからいけないんでしょ💦デリカシーないんだから💦」とゴールドと言い争いをして終わり。\nこんな流れでお願いしたいです。\n衣装はハートゴールド編のでお願いします。", "nc": 32, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@shiriudo3/works/44", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/a16c9ba4/uploads/origins/5dd7161d-41d4-47b0-8796-eae78b62849e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=eedf29277b554405ca843c9bc092bfc0", "src_set": ""}, "private": true, "genre": "comic", "tipped": true, "creator_id": 502386, "client_id": 2827056, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 179, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@shiriudo3/works/42", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 502386, "client_id": 0, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/95104be1/uploads/origins/2617f0c1-2e2b-43f9-a27f-b3025268b21b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3c4da5532d050ef7e64492b86458fee9", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": true, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/95104be1/uploads/origins/2617f0c1-2e2b-43f9-a27f-b3025268b21b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2354776422e44ce92a1ffa050bf27e47", "src_set": ""}, "body": "またシロちゃんのリクエストをお願いします\nあのア〇ルセックスの後、定期的にプロデューサーを誘い便秘になる度ア〇ルセックスをしてもらい便秘解消をしていたシロちゃん。\nある日のア〇ルセックスの事後いつも通り黒いビニール袋に脱糞していたシロちゃんがプロデューサーが少し痩せているのを見て1つプロデューサーに提案をしました。\nちなみにプロデューサーが痩せている原因ですが誘われる頻度が多くなり体力的にも精力的にも限界が来ていたのです\nそして後日シロちゃんはマスクを被ったリスナー3名と一緒に裏配信をしていました。\nプロデューサーに提案したのは、SNSでリスナー参加型の配信を告知し参加者を集めてア〇ルセックス配信をするというものでした\nリスナーと1人1回ずつア〇ルセックスをして、当たりを引いた＝脱糞させたリスナーは1ヶ月間シロちゃんの便秘解消の竿役としてシロちゃんとア〇ルセックス出来るという何とも変態な配信でした\nそして1人目とするもピストンするごとに少しオナラが盛れるもハズレ\n2人目には先ほどより激しいピストンをされ激しくオナラを繰り返し中出しされた後にもオナラを漏らし散らすもハズレ\nそして3人目、プロデューサーよりも圧倒的巨根で長い竿のリスナーがシロちゃんのア〇ルにぶち込み早々シロちゃんはイッてしまいます。更には激しいピストンによりシロちゃんはアヘ顔やオホ顔を晒してしまいながらオナラを幾度となくしてしまいます\n更にピストン中に「ギュルルルゥゥウ！」というお腹の音が、実はこの日までシロちゃん2週間以上も出ていなかったのです。\n今までの中で最大級の波を感じたシロちゃんは「でりゅ！出る出る！でちゃううう！」とアヘ顔を晒しながら叫びます。しかし最後のリスナーは少々乱暴な言葉をいいながらシロちゃんのア〇ルを犯し続けます。そして最後にはプロデューサーや2人のリスナーよりも圧倒的な量を射精します(追い打ちで肛内放尿もお願いします)その射精量にシロちゃんはまたもやオホ顔を晒してしまいます\nそして最後は「で、出る出る！でりゅぅうう！」とオナラを漏らし、2週間以上溜まっていた便秘グソを盛大に漏らし、裏配信は終了。最後のリスナーは永遠にシロちゃんの便秘解消の竿役としてシロちゃんと過ごすのでした。という形になります。ちなみに視点に関しては以前のリクエストの時と同じで大丈夫です今回も長文になりすいません", "nc": 162, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@shiriudo3/works/43", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/e2d6b7ec/uploads/origins/4beb63a8-e7d6-4572-819f-dfc1310a3eab?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=732e7a582d1d5bd1528db51664842cc0", "src_set": ""}, "private": true, "genre": "comic", "tipped": true, "creator_id": 502386, "client_id": 1287423, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 178, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@shiriudo3/works/41", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 502386, "client_id": 0, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/51877d08/uploads/origins/abb504f7-e912-49e2-8940-702c083a2c50?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b2cce73df9d6ec1e4f41ab5b27c2d7dd", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": true, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/51877d08/uploads/origins/abb504f7-e912-49e2-8940-702c083a2c50?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=84e43c4e4f4c97e797952816a4fb4fad", "src_set": ""}, "body": "ティアキンのゼルダ、パーヤ、プルアの三人で誰のオナラが一番臭いかを決めるをイラストを漫画方式でリクエストします。\n1.最初にプルアがオナラ(汚らしい音で)をしてパーヤとゼルダが臭いを嗅ぐ。\n・ゼルダ…吐きそうになり頬を膨らまし鼻を摘む→激しく咳き込む\n・パーヤ…青ざめた表情で鼻を摘む→鼻と口を押さえてうずくまる\n2.次にゼルダがオナラ(豪快な音で)をする\n・プルア…目を細め鼻を摘み匂いを手でパタパタと散らす→激しく嗚咽混じりに咳き込む\n・パーヤ…プルアとは比べ物にならない臭いに嘔吐寸前になり鼻水と吐瀉物が少し吐き出す。→鼻と口を押さえ頬を大きく膨らますも飲み込んでなんとか堪える\n3.最後に恥ずかしそうに涙目で赤面しながら顔を手で覆いパーヤがオナラ(すかしっぺ)をする。オナラが止まらなくなってしまい自分のおならの臭いに鼻を摘みながら気絶した2人に泣きながら謝る。\n・ゼルダ…あまりの悪臭に頬を膨らまし鼻水と吐瀉物が吹き出し嘔吐寸前→耐えきれず嘔吐した後気絶。\n・プルア…両手で鼻と口を押さえ激しく咳き込み、喚起しようと窓を開けようとする。\n→直前で耐えきれず嘔吐し気絶してしまう。\n\n ・オナラをしている時のポーズ \n三人とも四つん這いでお尻を突き出した体勢でお願いします。\n・外見\nゼルダ…ティアキン序盤の青い服、ショートヘアで眉毛は太めでお尻は大きめ。。\nプルア…ティアキンの成長した姿。\nパーヤ…ティアキンの衣装から笠を外した状態。三人とも下半身だけ裸の状態でお願いします。\n・臭いの順番\nパーヤ(生まれ付き)>ゼルダ(ケモノ肉丼の食べ過ぎ)>プルア(不摂生のため)の順でお願いします。\n・表情\nオナラをしている時は三人とも恥ずかしそうに赤面しながら、\n臭いを嗅がされている時は常に目に涙を浮かべ、臭いのせいで気分が悪くなっていき徐々に顔が青ざめていく描写が欲しいです。\n・遠慮してほしい表現\n白目のみの表情、ギャグ顔\n・セリフ\n何を食べたらこんな臭いに的なセリフがあると嬉しいです。又セリフ、擬音がない状態の差分があると嬉しいです。\nかなり長くなってしまいましたがよろしくお願いします。", "nc": 162, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@shiriudo3/works/40", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 502386, "client_id": 0, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/bcbac398/uploads/origins/e461ee7d-e270-4934-bd23-a0145decf455?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b09846edf354a4168fef1ef8ecbf3cad", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": true, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/bcbac398/uploads/origins/e461ee7d-e270-4934-bd23-a0145decf455?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=037654aea9911a4113b265b742bf7113", "src_set": ""}, "body": "ポケットモンスターSPECIALのサファイアのうっかりおならを漫画形式でお願いしたいです。\nシチュは特技の木登りで木の枝に座って景色を見ながらおやつの焼き芋を食べている時に下の道を歩くルビーを発見。\n話しかけるとミクリとナギに会いに行くと言うのでいっしょについていくと言うサファイア。\n焼き芋を飲み込み木の上から飛び降りルビーの目の前に着地。（イメージ幅跳びの着地のようなポーズで）\nところが着地の衝撃で爆音のおならをしてしまい恥ずかしさから真っ赤になり慌てふためくサファイア。\nルビーにこの音と匂いはBeautifulじゃないよと言われ手で顔を覆いながら更に恥ずかしがるという流れでお願いします。\n衣装はエメラルド編のものでお願いしたいです。", "nc": 34, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "similar_creators": [{"id": 3738, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "ダンナ　Skebやっています", "screen_name": "karatekikku", "avatar_url": "https://pbs.twimg.com/profile_images/1927355721521262592/BOsppe7v.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1615921440766955520/1748319769/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "skills": [{"genre": "art"}], "nc": 32}, {"id": 183935, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name