イ！ケダモノ！あん❤️ちょっと今抜かれたら！」\n\n⑥\n目を見開いてちょっとオナラが出て\n「あ❤️」\n\n⑦\n照れて片目閉じ、凄い精液の混じったうんちを出しながらおしっこもする\n「ヤダ！見ないでぇぇぇ❤️うんち止まらないわ！！！❤️」\n\n⑧\n柔らかい固形うんちの上に残りを出す様に下痢がビュルビュルッと出す\n「うぅぅぅぅぅぅ❤️」\n⑨\n恥ずかしそうな顔ではぁはぁなしがら、\n「もう無理、お嫁に行けないわ、こんな目の前でうんちするなんて❤️」\n\n「もの凄くエロかったって、アホバカ死ね、責任取って付き合いなさいよ！！」\n\n⑩前のつむぎみたいなミニキャラで\n「前でもしたいって本当に節操無しね！一回家帰ってからね、そしたら全部してあげるから、もう」\n\n金額に問題無ければお願いします！", "nc": 186, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@shiriudo3/works/51", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/449c99b1/uploads/origins/8ef2038f-8065-403f-90a5-b99b9060d770?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=44a7e09f0b844a94b1aa9ac9616efa63", "src_set": ""}, "private": true, "genre": "art", "tipped": false, "creator_id": 502386, "client_id": 0, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 160, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@shiriudo3/works/50", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 502386, "client_id": 69148, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/7a186e17/uploads/origins/5105a05b-d777-4ead-8594-4afa7fc7ea18?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ed8703558008251a9cce2254bf9844ac", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/7a186e17/uploads/origins/5105a05b-d777-4ead-8594-4afa7fc7ea18?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9f29213b210c39ebc7f7ea05defa26ba", "src_set": ""}, "body": "https://drive.google.com/file/d/1J07OG0xyrG5sGBM4BjzDCefMMySLtBE9/view?usp=drivesdk このキャラクターは私が整備している鉄道車両を擬人化し