と考えております。\n〈構図〉\n基本的にはふたば໒꒱· ﾟ様におまかせします。人外のアンドロイドではありますが、見た目はほとんど人間と違いはないので同じように書いていただいて問題ありません。\n\n長文失礼いたしました。拙い点がありましたら申し訳ありません。ご検討よろしくお願いします。\n\nhttps://drive.google.com/drive/folders/1-g8_VoVCqxCScN-ReZK-HonAjbjzAFnZ", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@futaba2328/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3102134, "client_id": 2986862, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/fa8cad94/uploads/origins/5a4d9505-cc8e-4e8e-90cd-6d6aa9ad6368?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d1dbbd09d9d957ae044e1321bf2a173d", "srcset": "https://si.imgix.net/fa8cad94/uploads/origins/5a4d9505-cc8e-4e8e-90cd-6d6aa9ad6368?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d1dbbd09d9d957ae044e1321bf2a173d, https://si.imgix.net/fa8cad94/uploads/origins/5a4d9505-cc8e-4e8e-90cd-6d6aa9ad6368?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=139b3f603d227de1d632c8dc45bb2bf1 2x, https://si.imgix.net/fa8cad94/uploads/origins/5a4d9505-cc8e-4e8e-90cd-6d6aa9ad6368?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=27a00861da430b840ce4d25b18a66aa4 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/fa8cad94/uploads/origins/5a4d9505-cc8e-4e8e-90cd-6d6aa9ad6368?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0071af812509897b3d6b0095617ed174", "srcset": "https://si.imgix.net/fa8cad94/uploads/origins/5a4d9505-cc8e-4e8e-90cd-6d6aa9ad6368?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0071af812509897b3d6b0095617ed174, https://si.imgix.net/fa8cad94/uploads/origins/5a4d9505-cc8e-4e8e-90cd-6d6aa9ad6368?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=0477