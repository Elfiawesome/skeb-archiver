からない箇所は適当で構いません。\n\n髪色：ベースが白、ニュートラルな灰色が影色の銀髪\n(黒髪に染めていたので、毛先が黒で描いている場合がある)\n目：銀色のような、金色のようなキラキラ。プリズムが散っている感じで少し色が入っていると嬉しい。\nその他：色白です。口を開くと八重歯が見えます。\n150cmあるかどうかくらいのちびちゃんです。年齢は高校生くらい。\n\n相方から譲り受けたオーバーサイズの上着(オーバーサイズパーカー？ジャンパー？裾とか袖とかにベルトがぶらんとしているようなデザイン)を着ている元気で中性的な少年風(性別不詳)です。\n\n描きやすいサイズ・構図で構いません。顔だけでもOK。\nよろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/12TWgQRyKLshr6aPRj44iNG13_Kc_oLA_?usp=drive_link", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "similar_creators": [{"id": 766992, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "モグモグラ🦔", "screen_name": "G3itK", "avatar_url": "https://pbs.twimg.com/profile_images/2031223178509656064/LtzL0k2i.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1084838626473791488/1777479017/1500x500", "appeal_receivable": true, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 120, "skills": [{"genre": "art"}, {"genre": "comic"}, {"genre": "novel"}, {"genre": "video"}, {"genre": "correction"}], "banned": false, "nc": 177}, {"id": 2746909, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "天宮 凜💟お仕事用", "screen_name": "rin_amemiya88", "avatar_url": "https://pbs.twimg.com/profile_images/1926867451528007681/GSPT_luO.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1509370114059112463/1748235987/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "art"}], "banned": false, "nc": 129}, {"id": 2812049, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "キネタム-skeb募集中", "screen_name": "kinetamu", "avatar_url": "https://pbs.twimg.com/profile_images/1733137866791018496/