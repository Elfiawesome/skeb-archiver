ix.net/a00aed64/uploads/origins/1267a776-37e0-49d2-afe5-c3b3175d32c0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=05ea489b2729f0a305e2c3665e49a669, https://si.imgix.net/a00aed64/uploads/origins/1267a776-37e0-49d2-afe5-c3b3175d32c0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=02d7f0e31127971ae70f205f74dfd264 2x, https://si.imgix.net/a00aed64/uploads/origins/1267a776-37e0-49d2-afe5-c3b3175d32c0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=1568bc5b62759223537004c18df4e275 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/a00aed64/uploads/origins/1267a776-37e0-49d2-afe5-c3b3175d32c0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b573507c6b946488d668b0592cc6672b", "srcset": "https://si.imgix.net/a00aed64/uploads/origins/1267a776-37e0-49d2-afe5-c3b3175d32c0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b573507c6b946488d668b0592cc6672b, https://si.imgix.net/a00aed64/uploads/origins/1267a776-37e0-49d2-afe5-c3b3175d32c0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=4b6cd50540791ed245b655ad3cd1c4c1 2x, https://si.imgix.net/a00aed64/uploads/origins/1267a776-37e0-49d2-afe5-c3b3175d32c0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=f2016423bea4dccd6bed8b5fa53e1ab2 3x"}, "body": "お疲れさまです。お忙しいところ恐縮ですが、またリクエストを思いつきましたので、もし作成を検討していただければ幸いです。\n以前、カドックとコヤンスカヤの作品、ありがとうございました。とても描かれたシチュエーションが素敵でした。以前作成されていたスミアの作品をもとに、その続きを考えましたので、検討をお願いします。\n\n登場人物\n・コヤンスカヤ（inカドック）以下A\n皮に取り込まれて洗脳されたカドック。キャットスーツ姿のコヤンスカヤになっていて、ぐだ男にご奉仕中。\n・ぐだ男\n藤丸立香の男バージョン。カルデアのマスター。カドックを探している時にコヤンスカヤ達に捕まって、拘束されている。\n・コヤンスカヤ（オリジナル）以下B\nカドックを洗脳したコヤンスカヤ。戯れに変化させたカドックを使って、更に悪趣味なことを画策している。\n\nシチュエーション\n「ぐだ男、Aに捕まり拘束されている。Aはぐだ男に対して、ぴっちりとしたキャットスーツの胸を押し付けて誘惑している。興奮しつつ、カドックの行方を問うぐだ男→後ろからBが出現。コヤンスカヤが２人いるので困惑するぐだ男。Bは、惚けているAの顔に手をかける→剥がれたAの顔の下から、惚けた顔のカドックの顔が出現。驚愕するぐだ男。ニヤけるB→Bが合図すると、惚けていたカドックの顔が正気に戻る。ぐだ男に対してスキンシップをとっていたことに混乱しつつ、首から下をコヤンスカヤの姿にされていて驚愕するカドック。→必死に脱ごうとするカドックに対し、BがAの顔を再び被せる。当初はカドックのように険しい顔つきをして脱ごうとしていたAだが、次第にまた皮による洗脳が進み、惚けた顔になるA→洗脳が進みくだ男を組み伏せて奉仕しだすА、必死に呼びかけるぐだ男の唇を自身の唇を併せて黙らせるA。イカされるぐだ男。ニヤけるB」\n\n\nオリジナルのコヤンスカヤ【　https://www.wicurio.com/grand_order/index.php?plugin=ref&page=%E9%97%87%E3%81%AE%E3%82%B3%E3%83%A4%E3%83%B3%E3%82%B9%E3%82%AB%E3%83%A4&src=33400.jpg　】\nカドックinコヤンスカヤ【　https://www.wicurio.com/grand_order/index.php?plugin=ref&page=%E5%85%89%E3%81%AE%E3%82%B3%E3%83%A4%E3%83%B3%E3%82%B9%E3%82%AB%E3%83%A4&src=31401.jpg　】\nぐだ男【 https://static.wikia.nocookie.net/typemoon/images/1/11/Arctic_Region_Chaldea_Uniform.png/revision/latest?cb=20180522063744 】\n\n嫌いなやつへの強制皮モノと洗脳の尊厳破壊ですね。。\nカドックが絶対にしないような女性らしい誘惑を行ったあとに正気に一度戻して、絶望と混乱するカドックをもう一度洗脳し直してしまう感じです。ぐだ男に対して、コヤンスカヤとして妖艶な表情やハニートラップを仕掛ける感じですね。可能であれば、顔が見えて惚けたカドックや正気に戻って絶望した表情、再洗脳されてエロいことしか考えられないコヤンスカヤ（inカドック）等、見せていただければ嬉しいです。\n検討をよろしくおねがいします。", "nc": 41, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@beriberi114/works/9", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/ec49f608/uploads/origins/c8d0793a-e0cc-42a0-90db-2f35b8459ead?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=a9a09298b515910c46bcfd21bfbb4180", "srcset": "https://si.imgix.net/ec49f608/uploads/origins/c8d0793a-e0cc-42a0-90db-2f35b8459ead?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=a9a09298b515910c46bcfd21bfbb4180, https://si.imgix.net/ec49f608/uploads/origins/c8d0793a-e0cc-42a0-90db-2f35b8459ead?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=f3dc700