://si.imgix.net/a3e9a2e6/uploads/origins/2558d33f-181b-408a-8234-d9c30d05e3e6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=4485c6c5345e59132214fdd78ace33c5 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/a3e9a2e6/uploads/origins/2558d33f-181b-408a-8234-d9c30d05e3e6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=4748e1e51ca4cd73120464767745a766", "srcset": "https://si.imgix.net/a3e9a2e6/uploads/origins/2558d33f-181b-408a-8234-d9c30d05e3e6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=4748e1e51ca4cd73120464767745a766, https://si.imgix.net/a3e9a2e6/uploads/origins/2558d33f-181b-408a-8234-d9c30d05e3e6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=0ffdcce8a14ed1f95399b4985992cf86 2x, https://si.imgix.net/a3e9a2e6/uploads/origins/2558d33f-181b-408a-8234-d9c30d05e3e6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=070bca571ed5a86f6beef6e9d36d1a84 3x"}, "body": "こんにちは、紅酒さん！はじめまして。\nあなたのアピールを受け取りました。クロエに興味を持っていただきありがとうございます！\n\nクロエは、魔法分野の発展で有名な一族の娘です。クロエ自身、魔法を使うときに使用者の潜在能力を助けたり、妨げたりする魔法のアイテムの経験があります。\n\nその上、年齢の割に背が高いため、不要な注目を浴びることが多く、できる限り人目に触れないようにしている。一族の後継者としてふさわしい人物にならなければならないというプレッシャーが、彼女の自尊心を低下させている。\nクールで少年のような外見と霊媒の知識にもかかわらず、彼女は自分自身をあまり信じていない。\n\n余計な注目を浴びるのがあまり好きではなかったため、クロエは腕輪を隠すために、普段はだぶだぶの服を着ている。また、ネックレスを自分のスタイルに合うものに作り直そうとしたが、理想的な仕上がりにはならず、もう一度試す価値はないと判断した。\n\nお時間とご配慮をありがとうございました。\n\nhttps://imgur.com/a/chloe-sch-sameyer-character-reference-XGt1RUb", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@osyake_0125/works/8", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 920606, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/8472cc69/uploads/origins/587a085a-fa68-4bee-8227-1c5d872d5