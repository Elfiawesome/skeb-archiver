at%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ddd453956ffeaf037d56bc049f7a84c1, https://si.imgix.net/0f25c18c/uploads/origins/18b82a0e-9aa7-43a2-9ef8-d5433b68de96?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=3e3be1b70e9883da54515e75796395ee 2x, https://si.imgix.net/0f25c18c/uploads/origins/18b82a0e-9aa7-43a2-9ef8-d5433b68de96?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=6761399aa1f436c887651bd600b8acc9 3x"}, "duration": null, "nsfw": true, "hardcore": true, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/0f25c18c/uploads/origins/18b82a0e-9aa7-43a2-9ef8-d5433b68de96?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=631a424b0f64b2a50fca5745d6972bca", "srcset": "https://si.imgix.net/0f25c18c/uploads/origins/18b82a0e-9aa7-43a2-9ef8-d5433b68de96?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=631a424b0f64b2a50fca5745d6972bca, https://si.imgix.net/0f25c18c/uploads/origins/18b82a0e-9aa7-43a2-9ef8-d5433b68de96?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=f358224dbbc11e1be089738ec7b3f67c 2x, https://si.imgix.net/0f25c18c/uploads/origins/18b82a0e-9aa7-43a2-9ef8-d5433b68de96?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=ec17ed90ee63423699d40b44eccc848a 3x"}, "body": "はじめまして、リクエスト失礼します。\nもしよければ、衛士強化装備を着用した子がひどい目に合うイラストを描いていただけないでしょうか。\n\nキャラ：中学１～２年くらいで軍属、訓練を受けるにはまだ幼い女の子をお願いします。\n小柄でロングヘアー、誰にでも優しく接する性格だが押しに弱い子をお願いします。\n\n衣装：零式衛士強化装備をお願いします。脱がしたり破いたりはせず、しっかり着せたままにしてください。\n\nシチュ：校外学習で軍事施設に来た子が運悪く敵襲に巻き込まれるシチュをお願いします。\n学習の一環としてせっかくなのでとパイロットスーツ（衛士強化装備）を着用させてもらって基地内を見て回っていたが、そのタイミングで施設ごと敵に襲撃される。\n避難中に迷子になってしまい、運悪く敵兵と鉢合わせ、逃げる暇もなく捕まり、意識が途切れる。\n気が付くと知らない場所で大の字になるように立ったまま機械で拘束されていた。\n訓練生用ではない衛士強化装備を着用していたため正規兵と勘違いされ、情報を吐かせるための拷問が始まる。\nしかし、ただの一般人でもちろん情報などもっているはずもなく、誤解を解こうとしても話を聞いてもらえず、ただただいたずらに物理的に、性的にも痛めつけられて泣き叫んでいる、\nというシチュでお願いします。\n\n\n・口からフェラさせられたあとの精液があふれて、血といっしょに胸元にこぼれている様子をお願いします。\n・下腹部に注射痕をいくつも作ってください。\n・また、よければ衛士強化装備が一切破れたり脱がされたりしていないパターンと、股間部だけが破られて血と精液が溢れているパターンの差分をお願いします。\n\n細かくなってしまいましたが、よろしくお願いいたします。", "nc": 43, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 38360, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "川邑司@COMITIA156/東3/に50a めでぃかるカンパニー", "screen_name": "SusonoDiary", "avatar_url": "https://pbs.twimg.com/profile_images/1064376615029768192/nq4ZItJ3.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1064369639315058688/1666002371/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 120, "skills": [{"genre": "art"}, {"genre": "comic"}], "banned": false, "nc": 49}, {"id": 196913, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "ぎょろたん＠ncpの社畜絵師", "screen_name": "ncp38220860", "avatar_url": "https://pbs.twimg.com/profile_images/1194697087385866240/D6W3VnWN.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1194696402678341632/1574295754/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "art"}, {"genre": "correction"}], "banned": false, "nc": 49}, {"id": 412651, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "あいらん（skeb受付中）", "screen_name": "islan_d_lagoon", "avatar_url": "https://pbs.twimg.com/profile_images/1802946021812793344/x2UbVQat.jpg", "header_url": "https://pbs.twimg.com/profile_banners/912916135103860736/1718690814/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "dele