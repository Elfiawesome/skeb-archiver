9-20663d3b12c8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=724d269abbf1cf5e62a898bfcdf7c53b, https://si.imgix.net/69be6c9c/uploads/origins/f879b116-3eb0-4866-83b9-20663d3b12c8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=2ca9ffedebd3eb7ada0cc2ed63366ad4 2x, https://si.imgix.net/69be6c9c/uploads/origins/f879b116-3eb0-4866-83b9-20663d3b12c8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=3dbb0b002ad2c79f9eb3f4678edfa7d6 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/69be6c9c/uploads/origins/f879b116-3eb0-4866-83b9-20663d3b12c8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=973927b9b661d1f25057fdd15ec602ba", "srcset": "https://si.imgix.net/69be6c9c/uploads/origins/f879b116-3eb0-4866-83b9-20663d3b12c8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=973927b9b661d1f25057fdd15ec602ba, https://si.imgix.net/69be6c9c/uploads/origins/f879b116-3eb0-4866-83b9-20663d3b12c8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=124104519ba82cd68b342694c65572d9 2x, https://si.imgix.net/69be6c9c/uploads/origins/f879b116-3eb0-4866-83b9-20663d3b12c8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=3c565a29345b5144438c90dde740cdd7 3x"}, "body": "こんにちは。よろしければリクエストお願いします。\nキャラクター：ブローサーワン様のオリジナルキャラクターの委員長ちゃん\nシチュエーション：宇宙人に洗脳された委員長ちゃんがモブジを逆レイプ後、正気に戻るシチュ\n容姿：委員長ちゃんの衣装はイレイザークイーンの衣装で差し色は赤色で（緑色の部分を赤色に変更）\n　　　基本はバイザー有で。胸のサイズは大きめでお願いします。\n詳細\n・モブジは描かなくて大丈夫です。\n・モブジが委員長ちゃんに再会するも委員長ちゃんがモブジに堕とされたことを報告。導入時構図は立ち絵のような感じで。表情は口元に指を添え、冷酷な笑みを浮かべている。\n・恋人のよしみで最後にヤらせてあげるとモブジを騎乗位乳首攻めで逆レイプ。\n　胸の部分の服がはだけ、露出している状態。表情は涎を垂らしつつ、Sっ気ある表情で。\n・絶頂後、瞳のハイライトが戻り、困惑しながらも改造の影響で快楽が止まらないからと二回戦目に突入する感じのセリフのピロートークで終了\n\n要望\n・バイザーはレイヤー分けでバイザー無しにできるような構成でお願いします。困難な場合、バイザー無し差分という形でも大丈夫です。\n\nhttps://drive.google.com/drive/folder