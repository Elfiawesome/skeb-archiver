お好きなように描いて頂ければと思います。\nただ、浅葱小緑様の描かれるカラーが本当に大好きなので、カラーだと嬉しいです\n\n\n 【用途】 \n頂いたイラストは個人での鑑賞、浅葱小緑様のお名前を記載させて頂いた上で、趣味の範囲でSNSのヘッダーやアイコン、個人利用のグッズに使用する等をさせて頂ければと思います。 \n有償利用や配布、販売、AI学習などは致しません。  \n\n宜しければご検討ください。 \n金額の訂正、依頼の不足がありましたら、キャンセルもしくは再要請をお願いします🙇‍♀️", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [{"path": "/@nekomelonRURU/works/13", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1099731, "client_id": 3081123, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/357676b7/uploads/origins/d22efc0f-5e35-4aa5-b57c-74123fe6681e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f3ec60780efde48a8c0120db7b982664", "srcset": "https://si.imgix.net/357676b7/uploads/origins/d22efc0f-5e35-4aa5-b57c-74123fe6681e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f3ec60780efde48a8c0120db7b982664, https://si.imgix.net/357676b7/uploads/origins/d22efc0f-5e35-4aa5-b57c-74123fe6681e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=83dcd35ebf53664a420d6f2ba8f4d32d 2x, https://si.imgix.net/357676b7/uploads/origins/d22efc0f-5e35-4aa5-b57c-74123fe6681e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=160f4c6208263bbd5e375f101359265c 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/357676b7/uploads/origins/d22efc0f-5e35-4aa5-b57c-74123fe6681e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=20f68ab1435fe77d30704614761dc3c0", "srcset": "https://si.imgix.net/357676b7/uploads/origins/d22efc0f-5e35-4aa5-b57c-74123fe6681e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=20f68ab1435fe77d30704614761dc3c0, https://si.imgix.net/357676b7/uploads/origins/d22efc0f-5e35-4aa5-b57c-74123fe6681e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr