on": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/70827a12/uploads/origins/1cafb50c-750f-4ff7-b06a-8abb9e228412?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=7de8a9293ebfe1d36b576bb6ad8de976", "srcset": "https://si.imgix.net/70827a12/uploads/origins/1cafb50c-750f-4ff7-b06a-8abb9e228412?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=7de8a9293ebfe1d36b576bb6ad8de976, https://si.imgix.net/70827a12/uploads/origins/1cafb50c-750f-4ff7-b06a-8abb9e228412?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=86845f6080a39bbadaad7b8a134d938a 2x, https://si.imgix.net/70827a12/uploads/origins/1cafb50c-750f-4ff7-b06a-8abb9e228412?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=95758efee372c6ce495965cf09d53d6d 3x"}, "body": "はじめまして！あなたの絵が好きです！\n\nこの二人のオリジナルキャラクターのシーンを描いていただけませんか？ヴィクトリア朝（1890年代）のTRPG「コール・オブ・クトゥルフ（CoC）」の設定です。家を持たず、一緒に路上生活をしている親友です。カルト教団の一員で怖い子供たちです。\n\n茶髪の少年シェイは物静かで、普段は無表情か、小さく謎めいた笑みを浮かべている。アロイスをとてもかわいがっている。\n金髪の少年アロイスは大胆でおしゃべり。表情はいつも満面の笑み。シェイをとても愛している。\n\n彼らが冬を暖かく過ごすためにどこかに隠れているシーンを描いていただけますか？穏やかで平和な雰囲気です。\n\nポーズや構図はお任せします。\n\nいずれにせよ、リクエストを読んでいただき、本当にありがとうございました！\n\nhttps://drive.google.com/drive/folders/1uV4UtcsimuwnNtJvnj3WmLZ-heBRzsN9?usp=sharing", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 1068592, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "364ing(多忙)", "screen_name": "364ing01", "avatar_url": "https://pbs.twimg.com/profile_images/1887917803405238272/cID8bDBv.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1363152561675493383/1632964948/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_day