https://si.imgix.net/6bdfd835/uploads/origins/ae107903-fd7c-4613-80d1-17d7d0f81403?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=774382ecd81145d6961f3dac18f61b92 3x"}, "body": "いまこさんが描いた夕美の可愛いパジャマ姿を見てリクエストをしました。\n\nシンデレラガールズ劇場わいど☆ 266話に出た相葉夕美と塩見周子の黒髪姿をお願いしたいです。\n\n夕美と周子の衣装は[夜の一輪] ,[うつつの華模様] 二人共特訓前の服で頼みます。\n\nシチューは二人が変装記念に一緒で写真をとる内容でお願いします。", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@iMAKOOO5/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 555378, "client_id": 483069, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/ba1709ad/uploads/origins/9f3b6b81-dabc-435e-8e67-d101d87a4390?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=08d214beb59192f26b24b1a40ff38921", "srcset": "https://si.imgix.net/ba1709ad/uploads/origins/9f3b6b81-dabc-435e-8e67-d101d87a4390?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=08d214beb59192f26b24b1a40ff38921, https://si.imgix.net/ba1709ad/uploads/origins/9f3b6b81-dabc-435e-8e67-d101d87a4390?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=746b03702c34222a584ec89174d187bb 2x, https://si.imgix.net/ba1709ad/uploads/origins/9f3b6b81-dabc-435e-8e67-d101d87a4390?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=1042a1c396a4851500aebdaa197120ab 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/ba1709ad/uploads/origins/9f3b6b81-dabc-435e-8e67-d101d87a4390?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=1ad69193e16118a67739982b6383b5b0", "srcset": "https://si.imgix.net/ba1709ad/uploads/origins/9f3b6b81-dabc-435e-8e67-d101d87a4390?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=1ad69193e16118a67739982b6383b5b0, https://si.im