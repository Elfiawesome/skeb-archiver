ration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/9325b858/uploads/origins/ebf7dff6-96e1-403e-9233-cf41ffb5ed22?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=56b74addc85a9e18770bf1d45a597f11", "srcset": "https://si.imgix.net/9325b858/uploads/origins/ebf7dff6-96e1-403e-9233-cf41ffb5ed22?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=56b74addc85a9e18770bf1d45a597f11, https://si.imgix.net/9325b858/uploads/origins/ebf7dff6-96e1-403e-9233-cf41ffb5ed22?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=448a319f47ec97ac83a721299a00d9ef 2x, https://si.imgix.net/9325b858/uploads/origins/ebf7dff6-96e1-403e-9233-cf41ffb5ed22?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=52e40e9c636556965d747d30fa6ca4c5 3x"}, "body": "はじめまして！いつも塊肉しかさんの立ち絵素材をセッションで使用させていただいております。\nSkebをされているのを最近知り、この機会にとリクエストをさせていただきました！金額等の不足あれば再送の要請いただけると嬉しいです。\n\n【リクエストについて】\n「アイラスの双眼」というシナリオの自陣の一枚絵を描いていただきたいです。\n\n・使用目的は個人的な観賞のみ\n・構図はおまかせしますが、資料1枚目の服装で、戦闘前や戦闘、戦闘後のどれかっぽいかっこいい雰囲気が希望としてあります\n・戦闘立ち絵はないのですが、白い髪の女の子（刺青が目立つ子）は脇差を二刀流で、黒い髪の男の子（ディスプレイサングラスで外すと目元に刺青がある子）は拳銃を使います。\n・黒い髪の男の子のサングラスは👀や⁉️マークなどいろんな感情がディスプレイに反映するようなものですが、真っ黒の画面でも、そもそもサングラスがありでもなしでも大丈夫です！\n\n【資料】\n「アイラスの双眼」\nネタバレなし　自陣資料集 https://fse.tw/6bpkJxWu\n\nご検討のほどよろしくお願いします。", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@5oma_3Do/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2660761, "client_id": 3338515, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/4a25a064/uploads/origins/0abba37f-fdbf-4858-bf64-aecfa09a2397?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1f7885fac6734bf816588310422d3ce9", "srcset": "https://si.imgix.net/4a25a064/uploads/origins/0abba37f-fdbf-4858-bf64-a