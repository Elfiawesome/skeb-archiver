c5-4719-aa62-ad1a9f671d76?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=8407c924727243bcc8d1658d9f269d5b, https://si.imgix.net/76b12c12/uploads/origins/9d7aefa5-35c5-4719-aa62-ad1a9f671d76?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=651a260000f2a51e61475974a290c7e3 2x, https://si.imgix.net/76b12c12/uploads/origins/9d7aefa5-35c5-4719-aa62-ad1a9f671d76?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=fa7a6af2c3896cad9f5301046e9fa72b 3x"}, "body": "お世話になっております。夜鴉と申します。\n先日は素敵な立ち絵をありがとうございました…！おかげさまで、無事四季送り通過することが出来ました…！！🥲\n今回は通過後のHO秋の立ち絵をご依頼させていただきたく、ご連絡いたしました。\n改めて簡易PCの情報と通過を経て変わったことの補足等をお送りいたします。\n下記内容には四季送りのネタバレが含まれております。\n\n\n┈┈┈┈┈┈┈┈┈┈\n\n【情報】\n・HO秋(四季送り通過後も一人だけ殺し屋を続けている)\n・能力値STR16/CON12/POW15/DEX10/APP16/SIZ12/INT14/EDU13\n・武器は毒ネイルから、血がたくさん出る殺し方を選ぶようになりヤークトコマンドナイフに持ち替えている\n・祝からもらったクマのぬいぐるみをどこへ行くにも持ち歩いている\n・ギャル\n\n┈┈┈┈┈┈┈┈┈┈\n\n【補足】（四季送り本編ネタバレあり）\n・殺し自体に罪悪はないが、スジを通すために続けている。巻き込まないようにあびとはなるべく距離を置くように。\n・ラストの戦闘シーンで血に濡れた紅葉に魅入られてから、血が出る殺し方に拘るようになった。\n・元の武器でもあったネイル自体は嫌いではないが、ギャルになった理由が両親からの虐待でそれが偽りの記憶だったと知り、ギャルにこだわる理由もなくなってしまってからはなんとなく気が向かず今はネイルはしていない。ギャルムーブは続けている。\n\n┈┈┈┈┈┈┈┈┈┈\n\nさっくりとですが、上記の内容が通過後の情報になります…！！基本はあまり大きく変わってないのですが、簡単に言うと一人殺し屋を続けて、闇落ちしていく道に足を踏み入れました…！！\n前回同様、髪型や衣装等塩素さまのセンスにお任せでお好きなようにデザインしていただき、継続差分の立ち絵をお願いさせていただけたらと思います……！！\n喜怒哀楽と戦闘差分もいただけますと幸いです…！！\nもしかしたら動画化や配信等で使用する可能性もあります。その際はクレジットにて記載をさせていたけたらと思います。\nまた、ココフォリアにて使用予定のため、透過素材もいただけますと嬉しく思います……！！\n\nなにか不足等ありましたら、再送またはキャンセルしていただいて構いません。\nお忙しいところ恐れ入りますが、何卒ご検討のほどよろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/1rESiAaEeGlXeihsgmiG1BEboYkUMDXgh?usp=sharing", "nc": 152, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@enSo_098/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3832336, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/1f5ec952/uploads/origins/003b7554-1f1a-4808-9e2c-709c74676aa7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=79f931996bd9acd90cc513a8baad3111", "srcset": "https://si.imgix.net/1f5ec952/uploads/origins/003b7554-1f1a-4808-9e2c-709c74676aa7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=79f931996bd9acd90cc513a8baad3111, https://si.imgix.net/1f5ec952/uploads/origins/003b7554-1f1a-4808-9e2c-709c74676aa7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=786c9ea69af29289523829393f85cdf2 2x, https://si.imgix.net/1f5ec952/uploads/origins/003b7554-1f1a-4808-9e2c-709c74676aa7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=06adf5a567ccc594cf81d4ab5a60fd89 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/1f5ec952/uploads/origins/003b7554-1f1a-4808-9e2c-709c74676aa7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3a8abd2aa925ef33a7aebe48c944b8b0", "srcset": "https://si.imgix.net/1f5ec952/uploads/origins/003b7554-1f1a-4808-9e2c-709c74676aa7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3a8abd2aa925ef33a7aebe48c944b8b0, https://si.imgix.net/1f5ec952/uploads/origins/003b7554-1f1a-4808-9e2c-709c74676aa7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=f0d57faa0cff3df70b72cc574715841e 2x, https://si.imgix.net/1f5ec952/uploads/origins/003b7554-1f1a-4808-9e2c-709c74676aa7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=792d97ffa08aa780ed80dfcb0d857754 3x"}, "body": "初めまして。\nいつもかわいいイラストを拝見させていただいております。\nSNSで塩素様がskebを開設されたと見かけまして、この度ぜひ依頼させていただきたくご連絡させていただきました。\n\n\n▽ご依頼内容\nTRPGオリジナルキャラクターの立ち絵イラスト制作\n\n▽キャラクター詳細\n海月くらげ(くらげ-)\n女性／20歳／159cm／超心理学専攻の大学生\n外見 ・髪：紫。毛先に青グラデーション。クラゲヘアー ・瞳：青(目の中に蝶々がいます) ・体格：平均よりは小柄 ・備考：そそっかしく落ち着きがないため生傷が絶えない\n生物学的には女だが、中性的\n\n◆人物像\nこの世にある不思議な超常的な現象に目がなく、見境なく探究しに行く。\n後先考えずに、基本うるさい。ずっと喋っている。\n人を巻き込む天才。\n「あ、そういえば不眠症治ったかもしれない健康〜」\n突拍子もないことを毎秒やり始める。\n通過シナリオとしては、クラシックよりなシナリオやギャグシに行くことが多いです。\n\n▽構図　\n構図や衣装、立ち絵などは塩素様にお任せできましたら幸いです。\n出来ましたら、差分として右目にお花が咲いている差分と\nそれを隠すようにサングラスをかけている差分がありましたら幸いです。\n\n▽使用用途\n・個人鑑賞 ・SNSアイコンへの使用 ・TRPGセッション用立ち絵 ・キャラクターのお相手とのデータ共有 ・個人利用の範囲でのグッズ作成\n※商用利用はございません。\n\n\nお手数ですが、金額や資料の不備等ありましたら再送/キャンセルのしていただけたらと思います。\n長くなりましたが、ご検討のほどよろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/1cXd3NS_ge1rk53BedHUnssKqAbJeOWFH?usp=sharing", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@enSo_098/works/1", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/f4fee3c1/uploads/origins/2587aea5-ca1b-48de-82be-9a8483c4887a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=9447cd60d0688919f4f99383e0ac5759", "srcset": "https://si.imgix.net/f4fee3c1/uploads/origins/2587aea5-ca1b-48de-82be-9a8483c4887a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=9447cd60d0688919f4f99383e0ac5759, https://si.imgix.net/f4fee3c1/uploads/origins/2587aea5-ca1b-48de-82be-9a8483c4887a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=035dd3daa743629eb0d9179ed6588433 2x, https://si.imgix.net/f4fee3c1/uploads/origins/2587aea5-ca1b-48de-82be-9a8483c4887a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=9ffe34320b28f77602be45723e6819c0 3x"}, "private": true, "genre": "art", "tipped": false, "creator_id": 3832336, "client_id": 3695118, "nc": 145}], "sent_works": [], "similar_creators": [{"id": 2160932, "creator": true