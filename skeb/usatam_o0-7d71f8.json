Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=abe7db74c4dadcc329791cf3952fc82f", "srcset": "https://si.imgix.net/293917b3/uploads/origins/a576630c-27d6-43fe-b6ed-08c496db0008?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=abe7db74c4dadcc329791cf3952fc82f, https://si.imgix.net/293917b3/uploads/origins/a576630c-27d6-43fe-b6ed-08c496db0008?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ff20d6962651706a6ed08405b580ac5a 2x, https://si.imgix.net/293917b3/uploads/origins/a576630c-27d6-43fe-b6ed-08c496db0008?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e29a5f2abdc0a2a59087716667c031e2 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/293917b3/uploads/origins/a576630c-27d6-43fe-b6ed-08c496db0008?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=af482276c49eaacd33fd08bbb7f5e3aa", "srcset": "https://si.imgix.net/293917b3/uploads/origins/a576630c-27d6-43fe-b6ed-08c496db0008?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=af482276c49eaacd33fd08bbb7f5e3aa, https://si.imgix.net/293917b3/uploads/origins/a576630c-27d6-43fe-b6ed-08c496db0008?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=7700a9bbb407e8c2f37a9c0bdc58b549 2x, https://si.imgix.net/293917b3/uploads/origins/a576630c-27d6-43fe-b6ed-08c496db0008?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=3ff422441a3a9a6bbf5ccf089869075b 3x"}, "body": "甘崎雨夢 様\n\nお世話になっております。\n個人でVtuber活動を行っております橘花るい(たちばな るい)と申します。\n\n先日、甘崎さんの手がけられたVtuberの皆さまや、以前甘崎さんがお描きになったイラストの数々をTwitterにて拝見いたしました。\n\nその際、繊細で美しい絵柄、感情が目元から伝わってくるような、眼力や色気のある綺麗な瞳、そこから感じるイラスト全体の雰囲気に惹かれ、「なんて素敵な絵を描かれる方なんだろう」と思い、ぜひ自分のイラストをお願いしたくリクエストをお送りさせていただきました。\n\n大変お忙しいところ恐れ入りますが、ご一読いただけますと幸いです。\n\n以下、詳細でございます。\nお手すきの際にご確認いただければと思います。何卒よろしくお願いいたします。\n---\n●イラストをお願いしたい人物\n橘花るい\n\n●イラストの使用用途\nTwitterでの掲載、配信サムネイル、配信や動画での使用\n\n●描画範囲\n胸上あたりまでをお願いしたいです。\n\n●背景(縦横比率)\n透過(比率はおまかせいたします)\n\n●画像サイズ\n最短辺1200px以上でお願いしたいです。\n\n●詳細資料\n立ち絵やポージング等の資料は、リンクよりご確認いただけますと幸いです。\nなお、資料はあくまで参考でございます。\n\n厳密に“完全にこの通りにして欲しい”といったようなご指示ではございませんので、\n細部についてはどうか甘崎さんの描きやすいようにお描きいただければと思っております。\n\n---\n\nお忙しいところ最後までお目を通していただき誠にありがとうございました。\nご都合がよろしければ、何卒ご検討の程よろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/1RuQKcjjqemDC0UOiRpzVVmeG98H9_arS?usp=sharing", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@usatam_o0/works/12", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 618180, "client_id": 1361466, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/4987cb75/uploads/origins/11bde696-01db-403c-8517-1c446bdb5726?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1206cd542401df15c49df17d25cea339", "srcset": "https://si.imgix.net/4987cb75/uploads/origins/11bde696-01db-403c-8517-1c446bdb5726?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1206cd542401df15c49df17d25cea339, https://si.imgix.net/4987cb75/uploads/origins/11bde696-01db-403c-8517-1c446bdb5726?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=d2e468b918b4e9037b60769d876bfa3d 2x, https://si.imgix.net/4987cb75/uploads/origins/11bde696-01db-403c-8517-1c446bdb5726?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=9977a9128e0822253dd8c842f5257cff 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/4987cb75/uploads/origins/11bde696-01db-403c-8517-1c446bdb5726?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=457a14a08ac300780f8d29c95e97943d", "srcset": "https://si.imgix.net/4987cb75/uploads/origins/11bde696-01db-403c-8517-1c446bdb5726?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=to