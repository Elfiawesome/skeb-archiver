rmat%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=84f3a6cb388a7aafbe6c5aea59ddd745 3x"}, "body": "初めまして、素敵なイラストいつも拝見させていただいております。\nあなたの描く絵が好きで、今回リクエストしたく思いました。\nTRPGにて使用したキャラクターの一枚絵をお願いしたいです。中学校の体育教師で、好きな人に一途で重い女という設定です。重すぎて相手を刺そうとするタイプですので、出来れば包丁を持たせて欲しいですがなくても構いません。他はすべてお任せします。\n容姿は資料が少なくて申し訳ないのですが以下のリンクを参照していただけると幸いです。よろしくお願いします。\n\nhttps://drive.google.com/file/d/1j74IuvodT4jzVN_b4jePMIQ_4iTf5JxF/view?usp=drive_link", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@usatam_o0/works/15", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 618180, "client_id": 2806212, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/81390d27/uploads/origins/5c1c5a5a-a86e-4800-a4e2-da97d110936b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4e3f01a2c841a61cd006c7a23f80d84a", "srcset": "https://si.imgix.net/81390d27/uploads/origins/5c1c5a5a-a86e-4800-a4e2-da97d110936b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4e3f01a2c841a61cd006c7a23f80d84a, https://si.imgix.net/81390d27/uploads/origins/5c1c5a5a-a86e-4800-a4e2-da97d110936b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=00f24b75b95650c28364ad538f0b6e2c 2x, https://si.imgix.net/81390d27/uploads/origins/5c1c5a5a-a86e-4800-a4e2-da97d110936b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ade9d7f1b293bf6ec16689f3658d4ad9 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/81390d27/uploads/origins/5c1c5a5a-a86e-4800-a4e2-da97d110936b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a418877f8dfcc7b5334c4aaaf0af3be6", "srcset": "https://si.imgix.net/81390d27/uploads/origins/5c1c5a5a-a86e-4800-a4e2-da97d110936b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a418877f8dfcc7b5334c4aaaf0af3be6, https://si.imgix.net/81390d27/uploads/origins/5c1c5a5a-a86e-4800-a4e2-da97d110936b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=24641dd0cf99f7f7c2b8612f383fa60d 2x, https://si.imgix.net/81390d27/uploads/origins/5c1c5a5a-a86e-4800-a4e2-da97d110936b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=e485cae01786b27209bf550364f88755 3x"}, "body": "甘崎雨夢 様\n\n初めまして！\n繊細なタッチで細部まで拘られている\nイラストスタイルがすごく素敵で惹かれました！\n\n応援しているVtuber【不二花ヨルマ】さんの\nイラストを描いていただけないでしょうか？\n\n【リクエスト】\n●ジャージメイド服を着た不二花ヨルマさん\n●一見治安悪そうだけどただのダウナーギャル感があると嬉しいです\n●使用用途の関係で頭、髪の毛、服装など、上・左右切れないようにしてもらえると幸いです。\n●背景がある場合、背景・人物のみと分けていただけると幸いです。\n\n【使用用途】\n●不二花ヨルマさんのVtuber活動全般の利用をお許しいただけると幸いです。\n\nご検討よろしくお願い致します。", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@usatam_o0/works/14", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 618180, "client_id": 1386349, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/363ccdb6/uploads/origins/449601c7-cc59-425b-bd06-cb47f546fd04?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ae573a5f27e3e7fe8e61624f46c9771c", "srcset": "https://si.imgix.net/363ccdb6/uploads/origins/449601c7-cc59-425b-bd06-cb47f546fd04?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ae573a5f27e3e7fe8e61624f46c9771c, https://si.imgix.net/363ccdb6/uploads/origins/449601c7-cc59-425b-bd06-cb47f546fd04?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b26107418bec0776690dfedc02c0a1f6 2x, https://si.imgix.net/363ccdb6/uploads/origins/449601c7-cc59-425b-bd06-cb47f546fd04?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=cb49713766e78988ba40574afb27acb7 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://s