を突かれたようだが、まだドヤ顔で生意気な表情を浮かべている。\n彼女の頭上には、大人びたランジェリーと並んでシャープなビジネススーツが吊るされている。\n\nちょっと面白いのは、彼女の靴がタンスの外にきちんと置いてあることで、隠れようとしているのが不器用でかわいく見える。\nナオミは外に立ち、Var54に堂々とした大きな影を落としている。\n\nVar54の目線でナオミを見上げる感じは、カットインシーンや別のクローズアップでも伝わると思いますが、構図のアレンジはご自由にどうぞ。\n\nVar54の視点：\nシャワーから出たばかりのナオミはバスタオル一枚で、髪はまだ濡れたままで、冷たく支配的なまなざしで見下ろしている。\n\n全体的に薄暗いムードで、緊迫した対決とぎこちない親密さが混在しているように感じられれば最高だ。\n\n使用用途：SNS、個人的な閲覧のみ。\n\nご検討ありがとうございました！\n\nhttps://drive.google.com/drive/folders/14UP3yDg7TV9rEp4g_oSPLhcHpragL9o1?usp=sharing", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@izumi_whale/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1762195, "client_id": 153686, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/a7bfca13/uploads/origins/937a0125-53ad-4066-879a-4d81513ef782?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bbcda6f0fb6fad0f389ac3e630d613b2", "srcset": "https://si.imgix.net/a7bfca13/uploads/origins/937a0125-53ad-4066-879a-4d81513ef782?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bbcda6f0fb6fad0f389ac3e630d613b2, https://si.imgix.net/a7bfca13/uploads/origins/937a0125-53ad-4066-879a-4d81513ef782?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=d633c99dc2c5f8e2dc4379d6d9234436 2x, https://si.imgix.net/a7bfca13/uploads/origins/937a0125-53ad-4066-879a-4d81513ef782?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=525528fde67190b73da9ba9090694a34 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/a7bfca13/uploads/origins/937a0125-53ad-4066-879a-4d81513ef782?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a55ea7198935abc3b62a152fe7e7d1f8", "srcset": "https://si.imgix.net/a7bfca13/uploads/origins/937a0125-53ad-4066-879a-4d81513ef782?bg=%23fff&auto=forma