届く長さ\n・腹が見える位の超乳(乳のサイズを維持しつつ頭身を高くするイメージです)\n・淫語を連発する下品で口の悪いセリフ付き\n・マスターを誘うように挑発する→挿入されるも余裕ありげに調子に乗る→反撃に会い即堕ち→トドメの思い切り白目を剥いたほぼ変顔のアへ顔アクメ\nといった構成\n\n以上の要素を加味しつつ描いて欲しいです。よろしくお願いします！\n\nhttps://drive.google.com/drive/folders/1jUv87DsnPJO7pNY_UW8SRfyrto7lmJwm", "nc": 32, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@expellee896/works/7", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/980f776c/uploads/origins/2dbe3b4c-9b3d-420d-8f89-026a727902f8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=a7f34ae62330c25eb11a224233fcc554", "srcset": "https://si.imgix.net/980f776c/uploads/origins/2dbe3b4c-9b3d-420d-8f89-026a727902f8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=a7f34ae62330c25eb11a224233fcc554, https://si.imgix.net/980f776c/uploads/origins/2dbe3b4c-9b3d-420d-8f89-026a727902f8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=bfddd711ff398c259fd5f8ea4f8fd311 2x, https://si.imgix.net/980f776c/uploads/origins/2dbe3b4c-9b3d-420d-8f89-026a727902f8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=071888437f02ea5a80b099de13e2a8f6 3x"}, "private": true, "genre": "art", "tipped": false, "creator_id": 92880, "client_id": 1327345, "nc": 49}, {"path": "/@expellee896/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 92880, "client_id": 1446099, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/1984a04e/uploads/origins/ca33ba7f-9626-4a41-990c-546b1598ce63?bg=%23fff&aut