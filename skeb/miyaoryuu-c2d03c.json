34d5-4aae-a463-204c46c5a7c0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=3d09746f93c960edb9e3570168b22aaa 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/4cfec203/uploads/origins/e4740fb7-34d5-4aae-a463-204c46c5a7c0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=19eb417edff487a15f1b838266ef8650", "srcset": "https://si.imgix.net/4cfec203/uploads/origins/e4740fb7-34d5-4aae-a463-204c46c5a7c0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=19eb417edff487a15f1b838266ef8650, https://si.imgix.net/4cfec203/uploads/origins/e4740fb7-34d5-4aae-a463-204c46c5a7c0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=d648ff110e8d3eb1ea950a1907e0d8bb 2x, https://si.imgix.net/4cfec203/uploads/origins/e4740fb7-34d5-4aae-a463-204c46c5a7c0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=9c0941a87323d5b82d72c9d97caf31d7 3x"}, "body": "今回もアーボックと時津風でお願いします。構図は参考URL（https://skeb.jp/@utbutb/works/105 )のように、3~4巻で全体を巻き付けている部分は変わりませんが、横から時津風を睨みつける感じお願いします。 \n\n状況としてはアーボックと時津風は仲が良い設定ですが、時津風がちょっかいを出しすぎて、アーボックが怒って時津風を巻き付けている場面です。\n\nアーボックは舌を出しながら、時津風を睨みつけて威嚇しています。口は閉じてください。また、尻尾は首を絞めていない差分としている差分（どちらかの場合はしていない差分）を頂きたいのですが、締め付けていない場合は時津風の後ろでいつでも追加で巻き付けられるように待機しているような感じでお願いします。また、更に大丈夫でしたら色違いの差分もお願いします。\n\n時津風の表情は（全てが無理でしたら④と③を優先的にお願いします）\n①「うう・・・巻き付かれちゃった・・・」という感じでアーボックから目線を背けるようにしている。\n②アーボックの方を見ながら「ねえ・・・許してよ・・・」という感じでアーボックの方に目線を向ける。\n③しかし、アーボックの締め付けが始まり、いつもより強く長い時間締め付けられて気絶しそうになる。力尽きそうになり必死に意識を保とうとするが、ボーっとしたような表情になっている。\n④力尽きて寝ているように気絶してしまう。\n\n④のみ目を閉じて、①〜③は目を開けて下さい。表情差分が更に頂けるようなら④に赤面差分と青ざめている差分をお願いします。", "nc": 161, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@miyaoryuu/works/14", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 165680, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/038dd7e6/uploads/origins/fae98337-1228-4ba6-82f9-cf11998d5a76?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f79cfe631188f28943de6676be790fca", "srcset": "https://si.imgix.net/038dd7e6/uploads/origins/fae98337-1228-4ba6-82f9-cf11998d5a76?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f79cfe631188f28943de6676be790fca, https://si.imgix.net/038dd7e6/uploads/origins/fae98337-1228-4ba6-82f9-cf11998d5a76?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=7cc4cc73048378312f78f6acfb3a8ce0 2x, https://si.imgix.net/038dd7e6/uploads/origins/fae98337-1228-4ba6-82f9-cf11998d5a76?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d2a2fc50f13f0dbf3add18a5464bd516 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/038dd7e6/uploads/origins/fae98337-1228-4ba6-82f9-cf11998d5a76?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d5f8c5a54203911ff4fcfacd4bc3d927", "srcset": "https://si.imgix.net/038dd7e6/uploads/origins/fae98337-1228-4ba6-82f9-cf11998d5a76?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d5f8c5a54203911ff4fcfacd4bc3d927, https://si.imgix.net/038dd7e6/uploads/origins/fae98337-1228-4ba6-82f9-cf11998d5a76?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=a2c8b41f93638137ff12f9b04fa5bacb 2x, https://si.imgix.net/038dd7e6/uploads/origins/fae98337-1228-4ba6-82f9-cf11998d5a76?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=50288d8ac128e8891cb17e0466ddc762 3x"}, "body": "アーボックに巻き付かれている東方Projectの橙をお願いします。\n\n構図はデビラさんのように3〜4巻で全体を巻き付けて、橙の頭の上から口を閉じて、舌を出して下さい。又、アーボックの尻尾で橙の尻尾を束ねるように2〜3巻して下さい。その為、尻尾でなく、胴体で首を締め付けている差分といない差分(どちらかでしたらしていない差分)をお願いします。\n\n橙の表情は\n①恐怖で涙目になっている。\n②締め付けが強くなりやめて・・・！と暴れるが全体を締め付けられているので全く意味がない\n③ついに限界で「嫌あ！」と叫ぶ。\n④それにビックリしたのか締め付けが弱くなり、橙の呼吸は荒いが、赤面状態で感じているよいになっている。\n⑤癖になってしまい、ぽわーんと感じている表情で「もう一回やって」アーボックにおねだりする。\n\n①②⑤は目を開け、③④は目を閉じて下さい。\n\nもし大丈夫でしたら、アーボックの色違いもお願いします。", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@miyaoryuu/works/13", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/5c50da55/uploads/origins/f560607b-0474-4be7-b925-f6266a69d12f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=2647307f4f50d0a834b0d6c29efddf09", "srcset": "https://si.imgix.net/5c50da55/uploads/origins/f560607b-0474-4be7-b925-f6266a69d12f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=2647307f4f50d0a834b0d6c29efddf09, https://si.imgix.net/5c50da55/uploads/origins/f560607b-0474-4be7-b925-f6266a69d12f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=d7087c49ef1706a19e1a9f4633d7cc10 2x, https://si.imgix.net/5c50da55/uploads/origins/f560607b-0474-4be7-b925-f6266a69d12f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=7d080bdea0f182e8549bb97fea859f69 3x"}, "private": true, "genre": "art", "tipped": true, "creator_id": 165680, "nc": 176}, {"path": "/@miyaoryuu/works/12", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 165680, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/1212ddf4/uploads/origins/3065d8d8-4405-44c2-a4cd-96621cb70bb2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ec156641469985946c3edd811c3be221", "srcset": "https://si.imgix.net/1212ddf4/uploads/origins/3065d8d8-4405-44c2-a4cd-96621cb70bb2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ec156641469985946c3edd811c3be221, https://si.imgix.net/1212ddf4/uploads/origins/3065d8d8-4405-44c2-a4cd-96621cb70bb2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=6b9708ffcaf0f5890aea66a9f0569fd8 2x, https://si.imgix.net/1212ddf4/uploads/origins/3065d8d8-4405-44c2-a4cd-96621cb70bb2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b8efb7dda6ea7a3f1bac6ec12337597c 3x"}, "duration": null, "nsfw": true, "hardcore": true, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/1212ddf4/uploads/origins/3065d8d8-4405-44c2-a4cd-96621cb70bb2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f0872769ad9dd2d75f5991d7231e176e", "srcset": "https://si.imgix.net/1212ddf4/uploads/origins/3065d8d8-4405-44c2-a4cd-96621cb70bb2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f0872769ad9dd2d75f5991d7231e176e, https://si.imgix.net/1212ddf4/uploads/origins/3065d8d8-4405-44c2-a4cd-96621cb70bb2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=30a1471e310221de22ca558e21ab9a03 2x, https://si.imgix.net/1212ddf4/uploads/origins/3065d8d8-4405-44c2-a4cd-96621cb70bb2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=3a2500b4477c2409edd9a4db3ad93d31 3x"}, "body": "絵柄が好みであったため、リクエストさせていただきました！\n灼眼のシャナという作品の、カムシンというキャラをお願いしたいです。\n上半身は裸か胸元まで服がたくし上げられていて、下半身は膝下までズボンや下着がずり下ろされている状態で、乳首や男性器を弄られているといった感じでお願いします。\n可能であれば射精や中出し済みの差分があるとありがたいです。\nリクエストの詳細は描きやすいように変更していただいて大丈夫です\nご都合よろしければお願いいたします。", "nc": 171, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@miyaoryuu/works/11", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 165680, "client_id": 2021089, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/90bad306/uploads/origins/7ff1f016-7a44-4396-ad26-0776bdee55ff?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9c855dd474c6e581e4c9ec753726cc8e", "srcset": "https://si.imgix.net/90bad306/uploads/origins/7ff1f016-7a44-4396-ad26-0776bdee55ff?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9c855dd474c6e581e4c9ec753726cc8e, https://si.imgix.net/90bad306/uploads/origins/7ff1f016-7a44-4396-ad26-0776bdee55ff?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e1a813b426dba23b15bf9f441808210f 2x, https://si.imgix.net/90bad306/uploads/origins/7ff1f016-7a44-4396-ad26-0776bdee55ff?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=0b1c157fd9109ad525d74ab2ccea6e38 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/90bad306/uploads/origins/7ff1f016-7a44-4396-ad26-0776bdee55ff?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=84a6b25f8fb94b74398c16364c39c724", "srcset": "https://si.imgix.net/90bad306/uploads/origins/7ff1f016-7a44-4396-ad26-0776bdee55ff?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=84a6b25f8fb94b74398c16364c39c724, https://si.imgix.net/90bad306/uploads/origins/7ff1f016-7a44-4396-ad26-0776bdee55ff?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=06f2686132c41d26698d29b49a7ae01a 2x, https://si.imgix.net/90bad306/uploads/origins/7ff1f016-7a44-4396-ad26-0776bdee55ff?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=ab59180285f43caeb8ee6f3b79777bf5 3x"}, "body": "はじめまして、マスクonマスクと申します。\n今回、はじめましてskebの依頼をしますので、至らない点がありましたら申し訳ありません。\n私自身、元天文部ということもあり、作者様のメテオノーツはとても楽しく読ませていただけました。\n話が逸れてしまい申し訳ありません。さて、依頼なのですがTwitterのアイコンやヘッダー、スマホの壁紙等に使用する目的で\nホロライブの『ロボ子さん』とそのファン『ろぼさー』を描いていただきたいです。\n構図としては、ロボ子さんの口元辺りでマスクを付けたろぼさーを手に持ってるような感じでお願いします。\nロボ子さんの服装は\nピンクパーカーを着てポニーテール、眼鏡とツノやケモミミ等は無しでお願いします。\nまた、可能であれば背景を星空にしてもらえたら幸いです。\n下にURLを記載しますので、参考にしてください。\n\nロボ子さん参考画像①\nhttps://mobile.twitter.com/robocosan/status/1512333218522943489\nロボ子さん参考画像②\nhttps://mobile.twitter.com/kuromaru9/status/1264187171855929344\nろほさー参考画像\nhttps://mobile.twitter.com/robocosan/status/1021373664309067777\nロボ子さん参考動画\nhttps://youtu.be/Lw3sBpkC3Rw\n星空参考画像(これの2枚目以外)\nhttps://mobile.twitter.com/on79820877/status/1521837107568078848", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@miyaoryuu/works/10", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 165680, "client_id": 443917, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/bc1e1d5e/uploads/origins/675b7851-5f53-4edf-bbd9-d3a49a48d78a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=08116967773bb34c492152a019f8f9d0", "srcset": "https://si.imgix.net/bc1e1d5e/uploads/origins/675b7851-5f53-4edf-bbd9-d3a49a48d78a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=08116967773bb34c492152a019f8f9d0, https://si.imgix.net/bc1e1d5e/uploads/origins/675b7851-5f53-4edf-bbd9-d3a49a48d78a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=9ecc4561cfa7b8f8c3b98f6fd3676c94 2x, https://si.imgix.net/bc1e1d5e/uploads/origins/675b7851-5f53-4edf-bbd9-d3a49a48d78a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ed98fca896633949220ae08f4cec3b5c 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/bc1e1d5e/uploads/origins/675b7851-5f53-4edf-bbd9-d3a49a48d78a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b7c2763825c148839b518a904d968bc5", "srcset": "https://si.imgix.net/bc1e1d5e/uploads/origins/675b7851-5f53-4edf-bbd9-d3a49a48d78a?bg=%23fff&auto=form