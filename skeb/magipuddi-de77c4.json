9a6d7-d38c-4174-ab7a-7558cb8e2b1e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ebc5d3b3d2f0b6a980a846dbf680e898, https://si.imgix.net/13829179/uploads/origins/dd09a6d7-d38c-4174-ab7a-7558cb8e2b1e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=3e7a6afae5f51b72cf51e75580775a67 2x, https://si.imgix.net/13829179/uploads/origins/dd09a6d7-d38c-4174-ab7a-7558cb8e2b1e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=5db2826993682d8b96b80249ee5ea692 3x"}, "body": "はじめまして\n\nバンドリの丸山彩のセリフ付きイラストをお願いします。\n\nhttps://skeb.jp/@magipuddi/works/9のリサ姉を見て、是非依頼したいと思っていました。\n\n内容は同様に丸山彩が男を貢がせ奴隷に調教する内容でお願いします。\n貢ぎ奴隷に落とした他の男の話をしながら調教する感じでお願いします。（枕営業で男を落とした後に男を手玉に取ることが簡単だということに気づいた悪い彩ちゃんのイメージ）\n\nまた、調教の仕方はパンスト足で調教する感じでお願いします。\n足の匂いを嗅がせる、足コキするなどのイメージです。\n\n衣装はライブ衣装ではなく、大学生の服装（エンジョイ☆大学生）に黒パンストを履かせてください。髪は下ろした状態でお願いします。\n資料URLの右側に表示される＃89で表示される服装になります。\n　　\n以上になります。\n\nご検討をお願いいたします。\n\nhttps://bangdream.gamedbs.jp/chara/show/5/1512", "nc": 57, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@magipuddi/works/9", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1278328, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/11cb74e3/uploads/origins/75232e84-b109-4576-af8e-36d8cab13d51?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=defd03b4201a0a8135faf7dbc53b3dcd", "srcset": "https://si.imgix.net/11cb74e3/uploads/origins/75232e84-b109-4576-af8e-36d8cab13d51?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=defd03b4201a0a8135faf7dbc53b3dcd, https://si.imgix.net/11cb74e3/uploads/origins/75232e84-b109-4576-af8e-36d8cab13d51?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ad8a337c45fddb027d4406be5158e759 2x, https://si.imgix.net/11cb74e3/uploads/origins/75232e84-b109-4576-af8e-36d8cab13d51?bg=%2