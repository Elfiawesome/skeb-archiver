\n内面は穏やかでかわいいものやお花が好きなふつうの女性です\nhttps://privatter.me/page/68221ce9d07a4\n\n後ろ髪は腰までの長さ　ヘアアレンジOKです\n今回は眼鏡は外してください\n\n前世、別の世界では軍人として戦っていました\nタロットカードのⅦ戦車がモチーフ\nずっと眉間に皺を寄せて戦いに明け暮れていましたが、世界を救って殉職\n重荷から解放されて、転生後は穏やかに笑えるようになりました\nhttps://privatter.me/page/67c5c947542b2\n\n\n他、不明点は全てお任せ\n用途は個人観賞、SNS掲載予定\n金額等不足ございましたら、差し戻していただければ再考致します\n\nよろしくお願い致します！\n\nhttps://privatter.me/page/68221ce9d07a4", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@ekawata_kiw/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3590991, "client_id": 3648808, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/e88b07ba/uploads/origins/ca9b38d4-d37c-4add-bf1d-78ddf5cff16e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3911f9ab44d361e09b39225061fef89b", "srcset": "https://si.imgix.net/e88b07ba/uploads/origins/ca9b38d4-d37c-4add-bf1d-78ddf5cff16e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3911f9ab44d361e09b39225061fef89b, https://si.imgix.net/e88b07ba/uploads/origins/ca9b38d4-d37c-4add-bf1d-78ddf5cff16e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=013937b30fa15f6b81b9f74f037bc68f 2x, https://si.imgix.net/e88b07ba/uploads/origins/ca9b38d4-d37c-4add-bf1d-78ddf5cff16e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=db53d5efd6c25b91b46ab8290c2d0682 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/e88b07ba/uploads/origins/ca9b38d4-d37c-4add-bf1d-78ddf5cff16e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=babf0557e88efe09f489a853c09e1492", "srcset": "https://si.imgix.net/e88b07ba/uploads/origins/ca9b38d4-d37c-4add-bf1d-78ddf5cff16e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=babf0557e88efe09f489a853c09e1492, https://