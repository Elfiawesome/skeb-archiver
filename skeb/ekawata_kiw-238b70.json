たします！\n・笛を持たせてください。\n・顔の向きや髪型、鳥の足を描くかどうかはお任せで。\n・このskebのカバー（蝶の羽の女の子）や「妖精」の藤野さんのように、「かわいい」ベースに大人っぽさが入っていると嬉しいです。\n\n●使用用途\n個人観賞、およびSNSのアイコンまたはヘッダー\n\nどうぞよろしくお願いいたします。", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@ekawata_kiw/works/8", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/781c676e/uploads/origins/6ba700d1-e9bb-4bd7-bf7f-42d5ba4d793c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=75b1e140e7e8b99f896f2b1592f83a31", "srcset": "https://si.imgix.net/781c676e/uploads/origins/6ba700d1-e9bb-4bd7-bf7f-42d5ba4d793c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=75b1e140e7e8b99f896f2b1592f83a31, https://si.imgix.net/781c676e/uploads/origins/6ba700d1-e9bb-4bd7-bf7f-42d5ba4d793c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=c10f11d84a09fbb197a4e911a5f82285 2x, https://si.imgix.net/781c676e/uploads/origins/6ba700d1-e9bb-4bd7-bf7f-42d5ba4d793c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=69c82c1e79572eebcd955b21a5b6c39a 3x"}, "private": true, "genre": "art", "tipped": true, "creator_id": 3590991, "nc": 0}, {"path": "/@ekawata_kiw/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3590991, "client_id": 248142, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/13a034ef/uploads/origins/1b400c1d-9c3f-446b-8009-546d274f2a3d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b6858ced12c405e517f0f70884f3c104", "srcset": "http