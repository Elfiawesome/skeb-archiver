: false, "tip_acceptable": true, "yearly_report_client_visible": false, "total_appeals_count": 0, "received_works": [{"path": "/@Z07603533/works/13", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2272630, "client_id": 55086, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/414c790f/uploads/origins/20bc69ce-4a4d-45d0-9939-abeae5851123?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e0e0c724c7a41c15426eec59c672d8b0", "srcset": "https://si.imgix.net/414c790f/uploads/origins/20bc69ce-4a4d-45d0-9939-abeae5851123?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e0e0c724c7a41c15426eec59c672d8b0, https://si.imgix.net/414c790f/uploads/origins/20bc69ce-4a4d-45d0-9939-abeae5851123?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=50f765930a24282ffdfd2eaa9b5e3f89 2x, https://si.imgix.net/414c790f/uploads/origins/20bc69ce-4a4d-45d0-9939-abeae5851123?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=233def47e5f28b59c562d92f21f48186 3x"}, "duration": null, "nsfw": true, "hardcore": true, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/414c790f/uploads/origins/20bc69ce-4a4d-45d0-9939-abeae5851123?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0221988a3f60f6eedd5a11c2c730bae3", "srcset": "https://si.imgix.net/414c790f/uploads/origins/20bc69ce-4a4d-45d0-9939-abeae5851123?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0221988a3f60f6eedd5a11c2c730bae3, https://si.imgix.net/414c790f/uploads/origins/20bc69ce-4a4d-45d0-9939-abeae5851123?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=3d57d65c3bf1610514f7658eb31cbd48 2x, https://si.imgix.net/414c790f/uploads/origins/20bc69ce-4a4d-45d0-9939-abeae5851123?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=8c06018931545c88992dd427fade43c5 3x"}, "body": "前回依頼させて頂いた妖夢ちゃんのハードこちょこちょ責めが本当の本当に最高でした…連続で申し訳ないのですが、あまりにも好きすぎて我慢できなくなったので、それの続編という事でまたご依頼をお願いしたいです！\n\nキャラ：魂魄妖夢\n\n●シチュ＆ストーリー●\n\n肉壁くすぐり触手妖怪に捕らわれてから数年間、地下深くの誰も助けに来れない触手の巣で毎日毎日気絶するまでハードにくすぐられ体液を貪られ続け完全に心が折れてしまった妖夢ちゃん\n\nそしてとある日、触手は妖夢ちゃんのとある体液が自分の一番好みの味であることに気付く。触手は彼女の分泌する”汗”が本当に最高に美味であると…\n\nそこで触手は妖夢ちゃんから汗を効率よく摂取するため、肉壁空間をサウナのように暑くする\n\nそこから妖夢は※先端が人の唇のような形状になったレロレロと舌を蠢かす大量の触手に全身をベロベロぺろぺろじゅるじゅると舐めむしゃぶり付かれ、汗を貪られ号泣しながら大爆笑して許しを乞いながら地獄の日々を過ごす…気絶しようがくすぐりで叩き起こされながら…\n\n※（https://www.pixiv.net/artworks/105875346）唇触手はこちらの不二子ちゃんのようにして頂きたいです！\n\n～以下詳細～\n\n1.場所はまた同じく粘液滴る肉壁空間で、汗を分泌させるためにそこはサウナのように暑くなっている\n\n2.妖夢ちゃんは全裸で全身汗だくに加え憔悴しきってる感じで。すでに数年間の責めにより媚薬粘液が身体中に浸透しきっており、くすぐったさはもう1万倍以上になっている…\n\n3.（https://www.pixiv.net/artworks/102696108）拘束ポーズはこんな感じで触手に拘束され、構図は正面からでお願いします！（難しければ変更してok！）\n\n4.※腋・太腿・お腹・脇腹・足裏・お尻の穴に至るまでetc…様々な部位を唇触手に舐めしゃぶりあげられあまりのくすぐったさに鼻水を吹き出しながらブンブン首を振って笑い悶える様をお願いしたいです♡\n\n※触手は特に腋汗が一番美味しかったようで、腋窩は念入りに責められるようにお願いします♡\n\n5.表情は前回のように、もしくはそれ以上にハードにハードに顔面クシャクシャになるまで笑わせてあげてください♡\n\n以上になります！超長文本当に申し訳ございません…どうかご検討をお願い致します…！", "nc": 186, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@Z07603533/works/12", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2272630, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/fdc21ccc/uploads/origins/16c00ade-111f-4be0-9393-b97860b9ab1f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0e89cf0e07ea96fa599eb057a59e79a6", "srcset": "https://si.imgix.net/fdc21ccc/uploads/origins/16c00ade-111f-4be0-9393-b97860b9ab1f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0e89cf0e07ea96fa599eb057a59e79a6, https://si.imgix.net/fdc21ccc/uploads/origins/16c00ade-111f-4be0-9393-b97860b9ab1f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=fe9389438e70444a41c098830e20deff 2x, https://si.imgix.net/fdc21ccc/uploads/