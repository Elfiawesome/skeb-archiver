ロールツインテール、ピンクのインテークとメッシュ。水色のジャンスカ。純粋な狂気を持ったサディスト。見た目からは想像できないほどの怪力で、ルーフスを軽々持ち上げるし縛り上げる。ルーフスをペットのように思っているが遊び方が恐ろしい。\n\nルーフス:赤い肌の道化師。いつも怯えて震えている。片ツノはティアに折られた（服で見えないけど翼ももがれている）。しっぽはとげ付き。とらわれの悪魔、今はティアのおもちゃ。認めたくないけど、自分はもうティアがいないとダメだと感じ始めている。\n\nご都合に合えばで大丈夫ですので、ご検討よろしくお願いします🙇‍♀️\n\nhttps://www.dropbox.com/scl/fo/y4spzmh5elcg5b7w597q3/AD91QjAZJpPfFz0f_j1mvMo?rlkey=p0c0e0u3nmtbh94z37v141a0n&st=dgbgrbx2&dl=0", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@PK_terror/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3870033, "client_id": 1228854, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/fec257ab/uploads/origins/60eb57b0-7cb3-49ba-bedf-b3870556ddb9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bbd4fb4217adf6aa956fb1544c433db9", "srcset": "https://si.imgix.net/fec257ab/uploads/origins/60eb57b0-7cb3-49ba-bedf-b3870556ddb9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bbd4fb4217adf6aa956fb1544c433db9, https://si.imgix.net/fec257ab/uploads/origins/60eb57b0-7cb3-49ba-bedf-b3870556ddb9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=6e625ff1025c0bcdf99d0ff18b4f1998 2x, https://si.imgix.net/fec257ab/uploads/origins/60eb57b0-7cb3-49ba-bedf-b3870556ddb9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=9a9e7afbd02aedc6ad44af3a808298e0 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/fec257ab/uploads/origins/60eb57b0-7cb3-49ba-bedf-b3870556ddb9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=58217417b6f7895299ce7c1dac128a62", "srcset": "https://si.imgix.net/fec257ab/uploads/origins/60eb57b0-7cb3-49ba-bedf-b3870556ddb9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=58217417b6f7895299ce7c1dac1