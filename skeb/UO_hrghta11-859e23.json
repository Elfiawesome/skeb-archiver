-85d6-b5cb8d7c6ca7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=389f0d12beb02f881ac98d916c67b9e4, https://si.imgix.net/a01d84e4/uploads/origins/d3c0be9e-3c66-4f39-85d6-b5cb8d7c6ca7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=7907fd04385e421db2f1d710ee8b4bed 2x, https://si.imgix.net/a01d84e4/uploads/origins/d3c0be9e-3c66-4f39-85d6-b5cb8d7c6ca7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=db105919734ac127ebff5d0ea435384f 3x"}, "body": "依頼させていただきます。\n\n以下に箇条書きで記載する特徴のオリキャラの立ち絵をお願いいたします。\n\n・竜人の女性イメージ（顔・身体のフォルム、顔のパーツの位置等見た目はほぼ人間）\n・高身長、バストＢ～Ｃくらい\n・細身だが腹筋バキバキ\n・シュッとして鼻も高めのイケメン系の顔だが、片目には眼球が無く黒い穴がぽっかり空いている\n・左右のこめかみから目の下のくまあたりまでにかけて鱗がある\n・タバコを吸っている\n・ショートでツンツンした髪型で短めの細い角が生えている（角の片方は途中で折れて失われている）\n【色】肌：薄い赤　眼：白（瞳孔無し）　唇：グレー　髪：黄緑　角と爪：黒\n【服装】上：素肌に黒のレザージャケット（前は はだけている）　下：黒のレザーのハーフパンツ　靴：なし（素足）\n【装飾品】左手薬指にシンプルな銀色の指輪を２つつけている。\n\n自分の作品として発表等するつもりは全くする気はありませんが、足首あたりに重なるように作者サインをお願いします。\n\n以上の条件で大丈夫でしたら、お願いいたします。", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@UO_hrghta11/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 291153, "client_id": 583235, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/2587fd6b/uploads/origins/cffcbdf8-8f5b-4259-9d28-270ef385231c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a82775d87cadaf9d6cdecd76455e353a", "srcset": "https://si.imgix.net/2587fd6b/uploads/origins/cffcbdf8-8f5b-4259-9d28-270ef385231c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a82775d87cadaf9d6cdecd76455e353a, https://si.imgix.net/2587fd6b/uploads/origins/cffcbdf8-8f5b-4259-9d28-270ef385231c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=8b415c08cf9bd38ce8bff8c9a56839f2 2x, https://si.imgix.net/2587fd6b/uploads/origins/cffcbdf8-8f5b-4259-9d2