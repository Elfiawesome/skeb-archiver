=200&blur=200&s=9a943a15c5ce2d24fcecc9aa10effe27 3x"}, "body": "玖石様初めまして！\nskebにてお見かけし絵柄にとても惹かれ、ぜひリクエストをさせて欲しいと思い送らせて頂きました❤️‍🔥\n宜しければ友人とのOCを描いて欲しいです🎶🍒\n\n【使用用途】\nTwitterのヘッダーやSNSアイコン使用\n個人内での利益のないグッズ制作\n\n以下添付リンクにてキャラデザの詳細や関係性等ございますので、其方を見ていただければと思います🎀☕️\n\n玖石様のイラストの儚い雰囲気がとても好きなので、よろしければ邦ロック風のジャケ写(またはMVのサムネ)を描いて頂きたいです😭\n(雰囲気例:セカンドバッカー、ヤングスキニー)\n\n服装等はお好きに変えていただいて構いませんので、描きやすいようなものにして頂いて大丈夫です！！\nぜひよろしくお願い致します。\n\nhttps://www.dropbox.com/scl/fo/o3luvjuxpca25cgokhyuf/ABVU4W2rBPma97DWM_la8EI?rlkey=f187ezerev5gjdbs1bw4nw6m8&st=jehj2e4a&dl=0", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@solelL10/works/17", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3228091, "client_id": 1985230, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/21a068d9/uploads/origins/c78d7f93-051b-425e-b262-5d91780f12e3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2d18d08ccb8a034e42ab30f56b7434bf", "srcset": "https://si.imgix.net/21a068d9/uploads/origins/c78d7f93-051b-425e-b262-5d91780f12e3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2d18d08ccb8a034e42ab30f56b7434bf, https://si.imgix.net/21a068d9/uploads/origins/c78d7f93-051b-425e-b262-5d91780f12e3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=7c47fea2272bcc21e501b18bb159bed8 2x, https://si.imgix.net/21a068d9/uploads/origins/c78d7f93-051b-425e-b262-5d91780f12e3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=5cb9ee079cd727d07c1341d0faac7e09 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/21a068d9/uploads/origins/c78d7f93-051b-425e-b262-5d91780f12e3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=dd29bc036290036c6dd09786860b44f2", "srcset": "https://si.imgix.net/21a068d9/uploads/origins/c78d7f93-051b-425e-b262-5d91780f12e3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=dd29bc036290036c6dd09786860b44f2, https://si.imgix.net/21a068d9/uploads/origins/c78d7f93-051b-425e-b262-5d91780f12e3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=b26c34e9b848ecbd4d5cbe9e5541850e 2x, https://si.imgix.net/21a068d9/uploads/origins/c78d7f93-051b-425e-b262-5d91780f12e3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=65e092873de57262babef861001bbc46 3x"}, "body": "はじめまして、玖石様。ツイッターとskebであなたの作品を拝見致しました。本当に素晴らしいです。色の使い方がとても好きです。\nご都合が合えば、私のオリジナルキャラクター二人を描いてもらいたいと思い、試しにリクエストを送ります。\n\n【角色】\n①男性\n右の口角にほくろがある。\n②と向き合うと優しい笑顔になり、②をとても好きでした、何でもさせてくれる。 ②と自分以外には無関心。\n\n②短髪の男性\n①をいじめるのが好きで、パニックになっている①を見てると喜んでします。\n基本笑えない。無関心や不快な表情が多い。でも悠馬に対して常にツンテレな感じ。\n\n現在、二人はすでに同棲している恋人関係です。手をつないだり、ハグしたり、キスしたり、親密に交流してもいいのではと思います。\n\n【要求】\n服装については【衣装_和服】を参考にして、具体的なやり取りや動きは先生にお任せします。\n\nキャラクター詳細は下のDriveでご覧ください。\n\nありがとうございます。ご検討宜しくお願い致します。\n\nhttps://drive.google.com/drive/folders/1u1FZDVM_c_fVF7d6Yh5j5q8xCcfmuVcK?usp=sharing", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@solelL10/works/16", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3228091, "client_id": 2178819, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/5adb218e/uploads/origins/909ec014-7ea9-4818-976f-843e8d03d570?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=34bd60db3e74bc611bc8789fae92b90e", "srcset": "https://si.imgix.net/5adb218e/uploads/origins/909ec014-7ea9-4818-976f-843e8d03d570?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=34bd60db3e74bc611bc8789fae92b90e, https://si.imgix.net/5adb218e/uploads/origins/909ec014-7ea9-4818-976f-843e8d03d570?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=6a6b84b399266ee58