2-ae6f-88cf32d58338?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=16f42b5d57d320de97be3ba59f48804c", "src_set": ""}, "body": "【作品】遊戯王OCG\n【キャラクター】教導の聖女エクレシア（または白の聖女エクレシア）と教導の死徒（またはデスピアの凶劇）\n腹ペコなエクレシアちゃんが死徒（凶劇）の髪を見て、そうめんやしらたきなど、\n白くて長くてつるつるの麺類を食べたくなる可愛らしいイラストを拝見したく存じます。\nその他細かい指定はありません。もしよろしければご検討くだされば幸いです。\nよろしくお願いいたします。", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@himuro11/works/133", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/210091e9/uploads/origins/baa22358-c105-4656-94f2-5a2de5b0d38a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=4709adf76ae099dfb44a924a25ee977b", "src_set": ""}, "private": true, "genre": "art", "tipped": false, "creator_id": 616482, "client_id": 0, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 176, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@himuro11/works/132", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 616482, "client_id": 784488, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/d4a16c48/uploads/origins/00994e38-7383-4091-9308-71cfa11920cd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0a81fa116ae0d184f0679b00ed9e594f", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/d4a16c48/uploads/origins/00994e38-7383-4091-9308-71cfa11920cd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b98fd944bb616df7585d42cae5c58229", "src_set": ""}, "body": "はじめまして。\n\nシャドバのクオンのイラスト拝見して、依頼したく筆を執りました。\n\n少々、特殊な趣向になるのですが、おねしょをしたクオンがおねしょ布団を干す現場を見られ、あたふた慌てふためくイラストを依頼できますでしょうか？\n\n構図としては、物干し竿におねしょ布団を干された近くにいるクオンが、こちらに向かって「ざ、ざこは見るなよ！　お、おねしょじゃないから！　飲み物こぼしただけだから！　ざこはすぐ勘違いして、頭もざぁ〜こ、ざぁ〜こ！」と赤面涙目で捲し立てている様子。\n服装はいつもの装束ですが、おねしょで股間周りが濡れている。\nおねしょ布団のシミは薄黄色で、かなり派手におねしょをしてしまった特大サイズで、この干されたおねしょ布団は見切れないようお願いします。\n\n上記以外は、作者様の裁量にお任せします。\n少々、特殊な趣向の依頼ですが、ご一考いただけますと幸いです。", "nc": 160, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@himuro11/works/131", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 616482, "client_id": 3506573, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/8f5ae7ac/uploads/origins/610e06b6-1d0a-490d-931e-7bbb46d5127a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=85e2a3c4f13994b1a600e50fdb1ef191", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/8f5ae7ac/uploads/origins/610e06b6-1d0a-490d-931e-7bbb46d5127a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b37a46ad4685ea64920071a4244fb0c6", "src_set": ""}, "body": "氷室様はじめまして\nVTuberの「ミラ・ルプス」さんのイラストをお願いします。\n\n衣装は下記参考の三面図にある制服で、元気に笑っている表情で構図はお任せいたします。\nよろしくお願いします\n\nXのアカウント\nhttps://x.com/MiraLupus\n\n三面図\nhttps://x.com/MiraLupus/status/1916481008196784185\n\nhttps://x.com/MiraLupus/status/1916481008196784185", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@himuro11/works/130", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 616482, "client_id": 709035, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/4b7e247a/uploads/origins/381cbc48-5941-43ad-8655-5edbed147315?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5ceb0ffc45e08efa583f4938285b8937", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/4b