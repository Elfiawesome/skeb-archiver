がRPしやすいように長々と書いてるだけなので、どんな方向性になっても大丈夫です。\n知らない一面が知れたらそれも楽しい、となるので。\n\n\nふわっとしてしまったのですが、どうぞよろしくお願いします。\nこれからも鷲尾に対して色々と思ってます。\n\n鷲尾好きなんだけど……本当に好きではあるんだけど……。鷲尾ってさ！！\n\n\n正イデ大好きです！！\n\nhttps://iachara.com/char/3254202/view", "nc": 129, "word_count": 4348, "transcoder": "text", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 1193523, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "あえん", "screen_name": "TRPG10392661", "avatar_url": "https://pbs.twimg.com/profile_images/1938863605027348480/kfWfzDsH.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1338485520972668928/1661699078/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "art"}, {"genre": "voice"}, {"genre": "novel"}, {"genre": "correction"}], "nc": 161}, {"id": 1230164, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "ふき@煮物", "screen_name": "hayashi_fuki", "avatar_url": "https://pbs.twimg.com/profile_images/1377446595004755973/iizD-ZiS.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1630613306/1632594262/1500x500", "appeal_receivable": true, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 120, "skills": [{"genre": "voice"}, {"genre": "novel"}], "nc": 161}, {"id": 1268863, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "望月", "screen_name": "kotannv", "avatar_url": "https://pbs.twimg.com/profile_images/1067459853457666048/oHZEr2Ei.jpg", "header_url": "https://pbs.twimg.com/profile_banners/310253962/1570249673/1500x500", "appeal_receivable": true, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_