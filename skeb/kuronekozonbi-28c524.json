umbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 70213, "client_id": 952778, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/9c134183/uploads/origins/e163eae9-a680-4e9b-8363-1147f41c10b3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4e8968a6ef11a033f0b643df8912d6ce", "srcset": "https://si.imgix.net/9c134183/uploads/origins/e163eae9-a680-4e9b-8363-1147f41c10b3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4e8968a6ef11a033f0b643df8912d6ce, https://si.imgix.net/9c134183/uploads/origins/e163eae9-a680-4e9b-8363-1147f41c10b3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b3290455fa171f6ca45fc1d7e953ba12 2x, https://si.imgix.net/9c134183/uploads/origins/e163eae9-a680-4e9b-8363-1147f41c10b3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=57051383b367fe82786df98e51051146 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/9c134183/uploads/origins/e163eae9-a680-4e9b-8363-1147f41c10b3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=02c706b270d5a7686e6382f6b986baf4", "srcset": "https://si.imgix.net/9c134183/uploads/origins/e163eae9-a680-4e9b-8363-1147f41c10b3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=02c706b270d5a7686e6382f6b986baf4, https://si.imgix.net/9c134183/uploads/origins/e163eae9-a680-4e9b-8363-1147f41c10b3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=d8eb6ea31afbad9d0d62389c0fa498c8 2x, https://si.imgix.net/9c134183/uploads/origins/e163eae9-a680-4e9b-8363-1147f41c10b3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=4e99bb4bff3bdb3468eda7c290c059c1 3x"}, "body": "こんにちは。\n貴方の絵柄でうちの子「にぷら」を描いて頂きたいです。\n\n【にぷら　設定】\n黒長髪、黒尻尾、黒い服（あと黒しまぱん）を好んで着る猫耳少女。服はおへその見える短い上着、ミニスカート。背は低いが、カーテンができるくらい胸が大きい。ややツリ目。鈴の付いた首輪をしている。アホ毛がある。\n\n好奇心旺盛でいつも元気で優しくニコニコ。ご主人（飼い主）大好き。\n\n【描いて頂きたいもの】\n縞パン一枚姿。\nhttps://www.pixiv.net/artworks/120754436\nこれと同じように股間に迫った構図でパンツをずらしてくぱぁさせてほしいです。\n発情した表情。クリ勃起と勃起乳首をお願いします。\n\n【参考資料】\n私は絵描きではないので自作資料はありません。\n他の方に描いて頂いたうちの子がいくつかありますので\nよろしければユーザーページを参考にしてください。\n最近の作品に多いです。\nhttps://skeb.jp/@Cat_A_nipla1\n\nかわいくエッチに描いていただけると嬉しいです。\n気が向きましたらよろしくお願いいたします。", "nc": 48, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@kuronekozonbi/works/10", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 70213, "client_id": 2901468, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/aeb1807f/uploads/origins/feaf2d65-3712-4ef9-b4a8-01b45c1eedbe?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=da400163f2f03283ea60dfc8665b7cce", "srcset": "https://si.imgix.net/aeb1807f/uploads/origins/feaf2d65-3712-4ef9-b4a8-01b45c1eedbe?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=da400163f2f03283ea60dfc8665b7cce, https://si.imgix.net/aeb1807f/uploads/origins/feaf2d65-3712-4ef9-b4a8-01b45c1eedbe?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=62568f573271bac9f0a8db5954cd6d5a 2x, https://si.imgix.net/aeb1807f/uploads/origins/feaf2d65-3712-4ef9-b4a8-01b45c1eedbe?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=4e718d14556afe42efe619cd5d8ef362 3x"}, "duration": null, "nsfw": true, "hardcore": true, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/aeb1807f/uploads/origins/feaf2d65-3712-4ef9-b4a8-01b45c1eedbe?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2206f59bcdc70eba8dc789b256039a9d", "srcset": "https://si.imgix.net/aeb1807f/uploads/origins/feaf2d65-3712-4ef9-b4a8-01b45c1eedbe?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2206f59bcdc70eba8dc789b256039a9d, https:/