　全く違う衣装にしていただいてもOKです。ただし、眼鏡だけは必ずつけて下さい。\n\n【使用用途】\n・これから活動予定のVTuber活動で(前世姿を出す時に)使用させていただきます。\n　具体的には、SNS上や配信サムネイル画像など。\n・FANBOX有償プラン特典グッズにさせて頂きたいです。\n\n【納品形式】\n・背景無しの透過png形式またはpsd形式。\n\n以上です。長々と失礼いたしました。\nご検討のほど、よろしくお願いいたします。\n\nこれからも、茜屋先生のご活躍を応援しています！！！\n\nhttps://www.dropbox.com/scl/fo/7y4robl8zsod416u2tysd/AK5UaFDWsKCNWUKPMm5MLi0?rlkey=zod888r8hsgpbaxbe8csdu1n7&st=x9osuod0&dl=0", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@kuno_on/works/70", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 394700, "client_id": 2805655, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/7b089686/uploads/origins/98d4f890-960f-4182-9990-80551bd07b1e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e60c5e110c169e2aacc321b48a944ccb", "srcset": "https://si.imgix.net/7b089686/uploads/origins/98d4f890-960f-4182-9990-80551bd07b1e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e60c5e110c169e2aacc321b48a944ccb, https://si.imgix.net/7b089686/uploads/origins/98d4f890-960f-4182-9990-80551bd07b1e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=4fa91c1cc6f500ab684c175aa4e36609 2x, https://si.imgix.net/7b089686/uploads/origins/98d4f890-960f-4182-9990-80551bd07b1e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=4ced8bd3a2609c3d0ccd805c04ea2bb3 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/7b089686/uploads/origins/98d4f890-960f-4182-9990-80551bd07b1e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c87c56f98d8b6769fca7b1338437ec6f", "srcset": "https://si.imgix.net/7b089686/uploads/origins/98d4f890-960f-4182-9990-80551bd07b1e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c87c56f98d8b6769fca7b1338437ec6f, https://si.imgi