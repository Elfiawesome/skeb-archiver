0-8f5fdb0bdc7b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=bb4b425a9f8b1f7c1502e14cab688600", "srcset": "https://si.imgix.net/260152be/uploads/origins/d5c0608d-22ba-4f9a-98a0-8f5fdb0bdc7b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=bb4b425a9f8b1f7c1502e14cab688600, https://si.imgix.net/260152be/uploads/origins/d5c0608d-22ba-4f9a-98a0-8f5fdb0bdc7b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=ad7f52596d5b7ea92932b465839cd9ad 2x, https://si.imgix.net/260152be/uploads/origins/d5c0608d-22ba-4f9a-98a0-8f5fdb0bdc7b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=1f2a7a3984b659184f4fc66c2014fede 3x"}, "body": "初めまして。\n以前からイラストを拝見しておりました。\nリクエストしたいことがありますので、可能でしたら宜しくお願い致します。\n\n■キャラ\n八月のシンデレラナインの河北智恵\n\n■要望\n横浜DeNAベイスターズとコラボした有原の応援で『有原翼』の名前が入ったタオルを掲げるともっちのイラストをお願いします。\n服装は横浜DeNAベイスターズのホームユニフォームでお願いします。\n\n以上、宜しくお願い致します。", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@yukimatihinata/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1049236, "client_id": 381375, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/1556dc36/uploads/origins/f4f1d5e4-984e-446b-8440-8cb413537442?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=40c985a88457dc7fed6ad904a12ea6eb", "srcset": "https://si.imgix.net/1556dc36/uploads/origins/f4f1d5e4-984e-446b-8440-8cb413537442?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=40c985a88457dc7fed6ad904a12ea6eb, https://si.imgix.net/1556dc36/uploads/origins/f4f1d5e4-984e-446b-8440-8cb413537442?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=5c4628edfb12dedd780d3f81b9cdd703 2x, https://si.imgix.net/1556dc36/uploads/origins/f4f1d5e4-984e-446b-8440-8cb413537442?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=936d7787a6ab10495c0628b1f8816dd1 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/1556dc36/uploads/origins/f4f1d5e4-984e-446b-8440-8cb413537442?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=763ad8b41a8994af96683832c0f6a1aa", "srcset": "https://si.imgix.net/1556dc36/uploads/origins/f4f1d5e4-984e-446b-8440-8cb413537442?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=763ad8b41a8994af96683832c0f6a1aa, https://si.imgix.net/1556dc36/uploads/origins/f4f1d5e4-984e-446b-8440-8cb413537442?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=c674e827056635058e738cadab699bee 2x, https://si.imgix.net/1556dc36/uploads/origins/f4f1d5e4-984e-446b-8440-8cb413537442?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=7e5131f07c39cb4b4cc51258a15c5d3e 3x"}, "body": "日向ゆう様\nはじめまして、私はベイスターズファン歴20年で、ベイスターズファンの傍ら一級建築士として建築の仕事をしております「おっちー」と申します。（Xアカウント：@miz_otty）\nまた私は現在オリジナルキャラクターを用いた静止画のアニメーションの解説動画ch「おっちー一級建築士事務所」を運営、建築にまつわる動画を投稿しております。\n（現時点でyoutubeチャンネル登録者数4800人程度）\nそして本業としてベイスターズの応援していく中で毎年ペナントシーズンでベイスターズが勝利した際は動画の登場人物が横浜の勝利を祝うイラストを投稿して、横浜優勝を祈願しております。\n例：https://x.com/miz_otty/status/1671129195404218368?s=20\nこれまではスキマやココナラといった依頼サイトでベイスの布教活動も兼ねてイラスト依頼をし、様々なイラストレータさんに横浜優勝イラストを描いていただいておりました。\nそして2024年シーズンはぜひ日向先生に横浜優勝イラストを描いていただきたくご依頼させていただきました。\n以下概要です。\n\n・動画内に登場する主要キャラクター「セン君」「ハル姉さん」と日向先生のキャラ「大鯨ちゃん」を交えたイラストをお願いします。（詳細は動画チャンネルを確認願います。）\n\n・「横浜優勝」を祝うためベイスターズの勝利を喜ぶようなイラストをお願いします。\n\n・背景は無くても良いです。ない場合はこちらで背景を入れて使用することがございます。\n　参考の画像の様にセンターに「横浜優勝！！」の文字を入れますのでそのスペースは確保してください。\n\n・サイズは１９２０＊１０８０　２００dpi程度でお願いします。\n\nhttps://www.youtube.com/channel/UCRokwf08xJr3Pj2Qay__gnQ", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@yukimatihinata/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1049236, "client_id": 1060576, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/f985e69c/uploads/origins/5b1e83cd-a59e-466d-a3be-2418eca35eda?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6d744eec9f6caf6d872ed44af3d71f65", "srcset": "https://si.imgix.net/f985e69c/uploads/origins/5b1e83cd-a59e-466d-a3be-2418eca35eda?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6d744eec9f6caf6d872ed44af3d71f65, https://si.imgix.net/f985e69c/uploads/origins/5b1e83cd-a59e-466d-a3be-2418eca35eda?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=22dea5c3e5872e648128de98566b9675 2x, https://si.imgix.net/f985e69c/uploads/origins/5b1e83cd-a59e-466d-a3be-2418eca35eda?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=78d8b1d0470126859ce754ca4e667cb3 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/f985e69c/uploads/origins/5b1e83cd-a59e-466d-a3be-2418eca35eda?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=bd87dce8536dd8e36eff6bc9cbfc3587", "srcset": "https://si.imgix.net/f985e69c/uploads/origins/5b1e83cd-a59e-466d-a3be-2418eca35eda?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=bd87dce8536dd8e36eff6bc9cbfc3587, https://si.imgix.net/f985e69c/uploads/origins/5b1e83cd-a59e-466d-a3be-2418eca35eda?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=a88d4a31d606b91fd8701e9dbfa35579 2x, https://si.imgix.net/f985e69c/uploads/origins/5b1e83cd-a59e-466d-a3be-2418eca35eda?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=1b8cdf5b2f5e78f1612d270365043faa 3x"}, "body": "こんばんは。二回目のリクエストを今回させて頂きます。\n\n先生に前回リクエストをさせて頂きあれから二年が経ちました。大鯨ちゃんにユニフォームを着てもらった神奈川の牧君は応援歌がつき、二年目のジンクスも跳ね返し、世界の牧君になりました。\n正直ポジポジが溢れて水たまりができています。\n\nということで今回もDeNAの牧君関連でお願い致します。また、前回と同様ツイッターのヘッダーに使用する予定です。\n\nシチュエーションとしては、\n\n中央でデスターシャのパフォーマンスをしている佐野選手、牧選手、桑原選手（順番はこの通りで）\n\nでお願い致します。\n先生はベイスターズ選手も描かれておりますが故に選手のイラストをリクエストさせて頂きますが、諸々でNGとなってしまった場合は、\n同じシチュエーションで、ガンビアベイちゃん、大鯨ちゃん、山城さんをお願いしたいです。（順番この通り\n\nこちらとしてはどちらのバージョンでも大変嬉しいので、先生にお任せします。\n\nそれではご検討宜しくお願い致します。", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@yukimatihinata/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1049236, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/53b0f155/requests/282588_1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=75275536abd37a9414208c90e848390a", "srcset": "https://si.imgix.net/53b0f155/requests/282588_1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=75275536abd37a9414208c90e848390a, https://si.imgix.net/53b0f155/requests/282588_1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=7d244efc9110478872033e36e4781c6e 2x, https://si.imgix.net/53b0f155/requests/282588_1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=984747a70c6e4726184e1a65bba0fb10 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/53b0f155/requests/282588_1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=708427e2ac2f186f86141f446c0ae037", "srcset": "https://si.imgix.net/53b0f155/requests/282588_1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=708427e2ac2f186f86141f446c0ae037, https://si.imgix.net/53b0f155/requests/282588_1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=5897dccb7f088bd14bd47dcd889d8ac7 2x, https://si.imgix.net/53b0f155/requests/282588_1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&b