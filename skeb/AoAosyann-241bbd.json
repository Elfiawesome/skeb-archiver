rmat%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=161dee52210341137a3df55254de2ff8, https://si.imgix.net/a2bf4bc4/uploads/origins/f3cc5e68-b797-4940-8a00-4253eb07f8c2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=33b0aad6226580cf70b2f65086948db0 2x, https://si.imgix.net/a2bf4bc4/uploads/origins/f3cc5e68-b797-4940-8a00-4253eb07f8c2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=f3d994f3a5cc78f3629c70cf5b6b40bc 3x"}, "body": "初めまして、この度はアピールありがとうございます‼️\n\n穿つ弌さんの描く柔らかな線が好きなので\nこの機会にリクエストさせていただきます。\n\nぜひ、うちの子の「夜ヲ紡來」を描いて欲しいです。\n\n\n■夜ヲ紡來は夜と密接な関係がありますので、雰囲気やテーマは夜にしてほしいです。\n\n■その他構図背景などはおまかせしますが、小さな鳥さんも夜ヲ紡來の大切な友達なので描写をお願いします。手に乗っていても肩に乗っていても良いです。\n\n\n設定┈┈┈┈┈┈┈┈┈┈\n\n夜ヲ紡來(ヨルヲツムグ)🌃\n\n年齢 ？歳\n身長 172cm\n種族 ファントム\n\n「夜にだけ現れる幻想。明るく澄んだ声で詩や物語を眠る者に読み聞かせる。」\n\n┈┈┈┈┈┈┈┈┈┈\n\n立ち絵などの資料はURLにあります\n(URLが読み込めないなどありましたら、リクエストの再送をお願いします。)\n\nよろしくお願いします！\n\nhttps://drive.google.com/drive/folders/16Ym7DNJWF7iOXFKVVPHTpsPlGiXmd6J7", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@AoAosyann/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3723700, "client_id": 3607348, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/115cc674/uploads/origins/4d21a911-c645-4864-a5b7-69f96d47be55?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=db33fe4eb7d0d369334e8809904bbf50", "srcset": "https://si.imgix.net/115cc674/uploads/origins/4d21a911-c645-4864-a5b7-69f96d47be55?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=db33fe4eb7d0d369334e8809904bbf50, https://si.imgix.net/115cc674/uploads/origins/4d21a911-c645-4864-a5b7-69f96d47be55?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=89a46799fb3336574e96f98c76b3643f 2x, https://si.imgix.net/115cc674/uploads/origins/4d21a911-c645-4864-a5b7-69f96d47be55?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=6f245ed1a8104cf5e8d903d98fe3e018 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/115cc674/uploads/origins/4d21a911-c645-4864-a5b7-69f96d47be55?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=676f48f525af80bbd88e6e4f7ed18db9", "srcset": "https://si.imgix.net/115cc674/uploads/origins/4d21a911-c645-4864-a5b7-69f96d47be55?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=676f48f525af80bbd88e6e4f7ed18db9, https://si.imgix.net/115cc674/uploads/origins/4d21a911-c645-4864-a5b7-69f96d47be55?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=e02438125eee1ddc8a5350e057a72a01 2x, https://si.imgix.net/115cc674/uploads/origins/4d21a911-c645-4864-a5b7-69f96d47be55?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=44e2d787abcbcdd01f4f77419ee9a9af 3x"}, "body": "穿つ弌様初めまして！\nアピール募集中ポストへ反応いただきありがとうございます。\n\n◆依頼内容◆\n私のocのアルシェを是非穿つ弌様に描いていただきたいです！\n\n◆使用用途◆\n・SNSアイコン、ヘッダー\n・スマートフォンやPCの壁紙\n・納品していただいた絵を資料として他の方への依頼に添付使用\n\n◆納品形式◆\n・PSD\nキャラと背景と宛名を分けれるようにしたデータ。\nまた、もしよろしければ描く際に線画や塗りでレイヤーを分けていたら結合せずフォルダ等でまとめて残しておいてくださると嬉しいです！こちらに関しては難しければ大丈夫です！\n\n・PNG　1枚\n宛名と穿つ弌様のサインと穿つ弌様が一番良いと思う表示の仕方で書き出した1枚をお願いします！\n\n◆イラストイメージ◆\n･穿つ弌様のお目目の描き方がとても好みでしたのでお顔がよく見えるイラストをお願い致します。\n･ポーズやシチュエーションはお任せいたします！\n･衣装は基本資料通りでお願い致します。細かい箇所や、資料少なく分からない部分は改変していただいて構いません💓\nマントは着脱ご自由にしてください。\n\n◆世界観◆\n旋律者(メロディア)と呼ばれる信託を受けた者のみつかえる浄化の力がある。\n\n普通の魔物とは別に魔禍(マガ)と呼ばれる普通の力では倒せない魔物が存在する。\nメロディアに力を分け与えられたものしか倒すことはできない。\n魔禍はメロディアに力を与えられた者が常通り戦い、結晶を破壊した後、メロディアと共に葬送の音を奏でることで完全に浄化することができる。\n魔禍の登場頻度は一国に一体現れている間は他には現れないといった程度だが、ごく稀に二国同時に現れることもある。\n\n―メロディアに力を与えられし者―\n各国の騎士の中から数名選ばれる\n選ばれた者は体のいずれかの場所にメロディアに与えられた力の証が浮かび上がる(例:アルシェの目の下のト音記号🎼。カイルの項の♭フラット)\n\n◆OC詳細◆\n名前 アルシェ\n年齢 19歳\n所属国 ❤赤の国(情熱と愛の国)\n楽器 ギター\n武器 長剣\n\n元傭兵の騎士団の特攻役\n強い相手を求めて日々戦いに身を置いていたが、メロディアに力を与えられる前に魔禍と戦い敗れ、目に傷を負った。\nその戦いの中、窮地を救ってくれた赤の騎士団に能力を買われ一員となった。\n魔禍との戦いを常に望んでいる。強者の言うことは聞く。\n野良犬のように日々を過ごしている。\n普段は騎士団のメンバーと手合わせをして過ごすか、街の酒場で傭兵時代の仲間と酒を飲みかわしている。\n葬送の音を奏でる為に渋々ギターを習い始めたが意外と楽しくセンスもあった為戦闘以外の趣味が増えた。\n戦いが関わらなければ基本面倒見の良い兄ちゃん。\n\nご検討のほどどうぞよろしくお願い致します！！\n\nhttps://drive.google.com/drive/folders/16zKot2VjDgs6aip5VoeGKiBrqr0HtOiy", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@AoAosyann/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3723700, "client_id": 2784390, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/6b3c9bae/uploads/origins/a72b94a1-4353-418d-97eb-367b7d92ee90?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e675a37933bac3e122182a482653f33a", "srcset": "https://si.imgix.net/6b3c9bae/uploads/origins/a72b94a1-4353-418d-97eb-367b7d92ee90?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e675a37933bac3e122182a482653f33a, https://si.imgix.net/6b3c9bae/uploads/origins/a72b94a1-4353-418d-97eb-367b7d92ee90?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=3097805384b72e50b93b2f19dee75caa 2x, https://si.imgix.net/6b3c9bae/uploads/origins/a72b94a1-4353-418d-97eb-367b7d92ee90?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=999d899d809a9e24b79cfb8368e939c4 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/6b3c9bae/uploads/origins/a72b94a1-4353-418d-97eb-367b7d92ee90?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b84af45a61993bef8910de2a607c3a11", "srcset": "https://si.imgix.net/6b3c9bae/uploads/origins/a72b94a1-4353-418d-97eb-367b7d92ee90?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b84af45a61993bef8910de2a607c3a11, https://si.imgix.net/6b3c9bae/uploads/origins/a72b94a1-4353-418d