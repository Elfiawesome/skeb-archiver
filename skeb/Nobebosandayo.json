"hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/cf6a8510/uploads/origins/542af39b-b203-421c-b52e-49e33908d945?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=43d1aa16aad770fba1db2ebca980de2d", "srcset": "https://si.imgix.net/cf6a8510/uploads/origins/542af39b-b203-421c-b52e-49e33908d945?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=43d1aa16aad770fba1db2ebca980de2d, https://si.imgix.net/cf6a8510/uploads/origins/542af39b-b203-421c-b52e-49e33908d945?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=f83241c16d5c1b0aaa14e578060274f0 2x, https://si.imgix.net/cf6a8510/uploads/origins/542af39b-b203-421c-b52e-49e33908d945?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=fe692164b2b71b771caf2635e6f86c93 3x"}, "body": "こんにちは！イラストを沢山見させてもらっております！\nあなたのOCキャラがすごく可愛かったので、特に自分が好きなキキちゃんとヨミくんのイラストを依頼したいなと思います。\n\n1枚目は、キキちゃんが「長い舌見ていい？」ってお願いして、ヨミくんが快くOKしてすごく長い舌を勢いよく出す感じです。\n2枚目はキキちゃんが長い舌を遠慮なくぷにぷに触りまくって、ヨミくんが笑いながらもちょっとだけ恥ずかしそうにしてる感じでお願いします。\n長い間舌を出してるので、舌の先からはよだれがちょっとずつ垂れちゃってる感じだと嬉しいです。\n\nよろしくお願いいたします！", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Nobebosandayo/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2555638, "client_id": 629765, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/773e4e4a/uploads/origins/83da2889-fc74-430d-bde4-bb9de8ae9915?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=06be6abd37233db9395260daba873caa", "srcset": "https://si.imgix.net/773e4e4a/uploads/origins/83da2889-fc74-430d-bde4-bb9de8ae9915?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=06be6abd37233db9395260daba873caa, https://si.imgix.net/773e4e4a/uploads/origins/83da2889-fc74-430d-bde4-bb9de8ae9915?bg=%23fff&auto=format%2Ccompress&fm=