f&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=585aed1f954d507e5718c12f584d3f4a 2x, https://si.imgix.net/e67bc6b9/uploads/origins/32c06ba0-d3a2-40c5-9777-c60229f4123d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=fb146b9ddad6fbed4783fd6b89605a6a 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/e67bc6b9/uploads/origins/32c06ba0-d3a2-40c5-9777-c60229f4123d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a3940dc0e8a783f7ca56463127afade7", "srcset": "https://si.imgix.net/e67bc6b9/uploads/origins/32c06ba0-d3a2-40c5-9777-c60229f4123d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a3940dc0e8a783f7ca56463127afade7, https://si.imgix.net/e67bc6b9/uploads/origins/32c06ba0-d3a2-40c5-9777-c60229f4123d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=d02653c5559832ef98ba45ca9a265f0c 2x, https://si.imgix.net/e67bc6b9/uploads/origins/32c06ba0-d3a2-40c5-9777-c60229f4123d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=e49405d117b3ed6c499b74124a7dcec7 3x"}, "body": "先生、こんにちは。先生の作品が大好きなので、ぜひ描いていただきたいのですが、今回は「マリアンヌ・マーサー」というオリジナルキャラクターを主人公にしたNTRものを、2人のBBCのガキたちと描いていただけないでしょうか。詳細は次のリンクに記載しています。\nhttps://drive.google.com/drive/folders/1gpzJtyFO-HXzE4ScUjWdmRd6436wW-l9\n彼女の娘、ヴァネッサは学校で2人の新しい友達ができ、マリアンヌの夫が留守の間に泊まり会いをしたいと言っています。彼女たちは外国人なので、日本語はあまり話せません \n彼女たちは服を着たままでいてほしいですが、ガキたちは完全に勃起し、いたずらっぽい笑みを浮かべながらマリアンヌを触り回してください。マリアンヌを赤面させ、怒らせ、胸や太ももを揉まれることで汗をかかせ、彼女の手がガキたちの頭の上にあるような描写にしてください\n娘がガキたちのしていることに気づかず、マリアンヌが徐々に彼らの誘惑に心を奪われていく、といったNTR作品のような台詞をぜひ入れてください\n長文で申し訳ありませんが、今後さらに展開を計画しているため、状況の全容を詳しく伝えたかったのです", "nc": 168, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@famikiholiday/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id"