をテーマにお願いできたらと思っているのですが、くるぶし様のイメージで、自由に描いていただければと思っております。\n\nつい毎回おまかせになってしまって申し訳ございません……！\nくるぶし様の世界観が本当に大好きで、自由に描いていただけるのが一番嬉しいです。\n\n前回のタッチが本当に想像を超える可愛さで……同じような雰囲気で描いていただけたら、とてもとてもHAPPYです！\n\nご都合が合わない場合や、料金が不足している場合などは、無理なさらずご遠慮なくキャンセルしてくださいね。\n\n最近また冷え込む日が増えてきましたので、どうかご自愛ください。\n100日チャレンジでくるぶし様の作品をたくさん拝見できて、本当に幸せです！\n\nこれからも応援しております！\n\nhttps://drive.google.com/drive/folders/1dAC6yrRV8XWRAb13vky9LYQv_u1r1Z_y", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@kurubushi_8/works/11", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2364218, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/f4650e0f/uploads/origins/e62b713c-fc1b-4c2e-b3b5-6dc4f7df54a8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=909ab879ed48083798d8f2960b681985", "srcset": "https://si.imgix.net/f4650e0f/uploads/origins/e62b713c-fc1b-4c2e-b3b5-6dc4f7df54a8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=909ab879ed48083798d8f2960b681985, https://si.imgix.net/f4650e0f/uploads/origins/e62b713c-fc1b-4c2e-b3b5-6dc4f7df54a8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=3588631376853e7dd9c81f2e348960a8 2x, https://si.imgix.net/f4650e0f/uploads/origins/e62b713c-fc1b-4c2e-b3b5-6dc4f7df54a8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=2f97db96a8eb0df2acbe6faeff576267 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/f4650e0f/uploads/origins/e62b713c-fc1b-4c2e-b3b5-6dc4f7df54a8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=96b0792b917e62ab738ebbefedf61644", "srcset": "https://si.imgix.net/f4650e0f/uploads/origins/e62b713c-fc1b-4c2e-b3b5-6dc4f7df54a8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=96b0792b917e62ab738ebbefedf61644, htt