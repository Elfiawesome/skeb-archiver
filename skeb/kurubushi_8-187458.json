se, "total_appeals_count": 0, "received_works": [{"path": "/@kurubushi_8/works/18", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2364218, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/23f980ba/uploads/origins/f5fa8161-fdff-4fda-9ec6-318a3b4f95ef?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=dee7d76daff823c0c643bf823914c50a", "srcset": "https://si.imgix.net/23f980ba/uploads/origins/f5fa8161-fdff-4fda-9ec6-318a3b4f95ef?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=dee7d76daff823c0c643bf823914c50a, https://si.imgix.net/23f980ba/uploads/origins/f5fa8161-fdff-4fda-9ec6-318a3b4f95ef?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=62e01401509a97b4353c99e6335e8e41 2x, https://si.imgix.net/23f980ba/uploads/origins/f5fa8161-fdff-4fda-9ec6-318a3b4f95ef?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b2c482c33ba74be93157a732cdca2205 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/23f980ba/uploads/origins/f5fa8161-fdff-4fda-9ec6-318a3b4f95ef?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=551d90a0669d6127889a8fd45d0a2ed9", "srcset": "https://si.imgix.net/23f980ba/uploads/origins/f5fa8161-fdff-4fda-9ec6-318a3b4f95ef?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=551d90a0669d6127889a8fd45d0a2ed9, https://si.imgix.net/23f980ba/uploads/origins/f5fa8161-fdff-4fda-9ec6-318a3b4f95ef?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=660bb68d7cf5db2e60c09d7f11001d98 2x, https://si.imgix.net/23f980ba/uploads/origins/f5fa8161-fdff-4fda-9ec6-318a3b4f95ef?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=84a035d3aa3bc5c4305eb3d8bd2e0f6f 3x"}, "body": "2度目のリクエスト失礼致します！\n以前こちらのリクエストをさせていただいたものです。(https://skeb.jp/@kurubushi_8/works/15)\n\nくるぶし様の素敵な絵柄が本当に大好きで、描いていただいたイラストは大切に保存させていただいています。\n\n  可能であれば、また同じような雰囲気でオリキャラを描いて頂きたいです。   \n\nオリキャラ2人の関係性は兄妹です。\n恋愛感情ではなく、お互いの間に深い親愛があります。\n\n兄は妹の事を何よりも大切にしています。\n兄は闇属性、妹は光か闇かすら決まっていない、純粋無垢という感じです。\n\n5枚目に以前のリクエストの際に描いていただいたキャラの設定画も入っておりますが、補足説明のようなものですので、無視して頂いても構いません。\n\n  イラストの内容はくるぶし様にお任せします。\nシリアスでも日常イラストでも何でも嬉しいです。  \n\nご検討の程よろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/1spsphjtvr8APB9YFTOJ8Rwy3URQheK_n?usp=sharing", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@kurubushi_8/works/17", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2364218, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/cbb57d8d/uploads/origins/136d7b93-e35d-4fe7-9f48-414d4d439dbb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6e2c01e3911da7e4ba9d6ab1d6d4dfa7", "srcset": "https://si.imgix.net/cbb57d8d/uploads/origins/136d7b93-e35d-4fe7-9f48-414d4d439dbb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6e2c01e3911da7e4ba9d6ab1d6d4dfa7, https://si.imgix.net/cbb57d8d/uploads/origins/136d7b93-e35d-4fe7-9f48-414d4d439dbb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c60b219decf9f185891a70d2a99fd504 2x, https://si.imgix.net/cbb57d8d/uploads/origins/136d7b93-e35d-4fe7-9f48-414d4d439dbb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d56064d250da5bfcfd2d6b5af8de8b64 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/cbb57d8d/uploads/origins/136d7b93-e35d-4fe7-9f48-414d4d439dbb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=83c67eb42aaa24c4b9d084ed2a5d888a", "srcset": "https://si.imgix.net/cbb57d8d/uploads/origins/136d7b93-e35d-4fe7-9f48-414d4d439dbb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=83c67eb42aaa24c4b9d084ed2a5d888a, https://si.imgix.net/cbb57d8d/uploads/origins/136d7b93-e35d-4fe7-9f48-414d4d439dbb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=c4a16af252abd96f1390af69bea663f1 2x, https://si.imgix.net/cbb57d8d/uploads/origins/136d7b93-e35d-4fe7-9f48-414d4d439dbb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=2559cc2109a5b20397055afe1aa66bac 3x"}, "body": "はじめまして。\nくるぶし様の素敵なイラストを拝見し、是非うちの子たちも描いていただけたらと思い、メッセージしております。TRPG「SSS.S」の自陣４人をお願いしたいです。\n\n可能であれば、キャラ透過済みを別途いただけると嬉しいです。\n（さらに可能であればそれぞれ１人ずつ別けて）\n\n以下、キャラ詳細です。\n▼ベテラン捜査官(ドレッドヘアーの方)「ドニー」\n37歳/184cm/俺/お前\n長年FBIの職に就いているベテラン捜査官。\nゆるっとした態度と話し方だが着眼点は鋭く、足で情報を集めるベテランらしい捜査スタイル。\n料理が得意で、手料理を並べてホームパーティを開くのが好き。\n\n▼新人捜査官(金髪の方)「エミリオ」\n26歳/182cm/俺/貴方\nFBIになったばかりの新人捜査官。\n明るくハキハキと話し、人懐こい笑顔で初対面の相手とでも積極的にコミュニケーションを取ることができる。\n職場に差し入れとして購入するほどドーナツが好き。\n\n▼先輩捜査官(女の子)「ペネロペ」\n27歳/156㎝/アタシ/アンタ\n頭脳派担当。生意気な言動が多く、独占欲が強くて子供っぽい。\n貧乳なのを気にしている。\n基本的に空気をかなり読むが、気を許したい相手にはわがまま放題。子供っぽく振舞うことが多い。\n\n▼先輩捜査官(黒髪)「魅音」\n31歳/183㎝/僕/貴方\n攻撃担当（物理）。中国系アメリカ人。\n気難しく、人付き合いがあまり得意でない。素っ気ない態度が多く見られるが本人的には気をつかっているらしい。\n友人が多くないためぼっち飯をすることが多い。\nドーナツや甘いものが好き。\nホクロの位置【左目の下】【唇右下】\n\nシチュエーションは「コーヒーショップで休憩中」か「捜査中」であると嬉しいです。\n\n【使用用途】\n個人観賞用/個人用グッズ（有償配布はしません。あくまでも個人観賞の範囲内で作ります）\n\nご検討、よろしくお願いします。\n\nhttps://drive.google.com/drive/folders/1WLk0flae0-IgjobqZ55wlk4o3VfsgNuQ?usp=drive_link", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@kurubushi_8/works/16", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2364218, "client_id": 1031168, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/a4018245/uploads/origins/8aaf35e6-e52f-4ab6-8171-8f4eec8daf1f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fac8bc5968e2926d046788c96710dc59", "srcset": "https://si.imgix.net/a4018245/uploads/origins/8aaf35e6-e52f-4ab6-8171-8f4eec8daf1f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fac8bc5968e2926d046788c96710dc59, https://si.imgix.net/a4018245/uploads/origins/8aaf35e6-e52f-4ab6-8171-8f4eec8daf1f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f550a9954a5796957c759a741ee934ec 2x, https://si.imgix.net/a4018245/uploads/origins/8aaf35e6-e52f-4ab6-8171-8f4eec8daf1f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c0d8c4d686f92a56b4bbbd1ab54ee65b 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/a4018245/uploads/origins/8aaf35e6-e52f-4ab6-8171-8f4eec8daf1f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=51c7563c76fe2fda58ccbb2a1efc4255", "srcset": "https://si.imgix.net/a4018245/uploads/origins/8aaf35e6-e52f-4ab6-8171-8f4eec8daf1f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=51c7563c76fe2fda58ccbb2a1efc4255, https://si.imgix.net/a4018245/uploads/origins/8aaf35e6-e52f-4ab6-8171-8f4eec8daf1f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=0c53f09aaba357df65827673682f6f0e 2x, https://si.imgix.net/a4018245/uploads/origins/8aaf35e6-e52f-4ab6-8171-8f4eec8daf1f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=9f27a174c3221790c269e5dcbda5f245 3x"}, "body": "Nice to meet you くるぶし-san, I like your art so much that I would like to submit a personal request to you for my oc.\nあなたが描いたキャラクターはとても生命力があって好きです！\n複数の黑白インタラクティブのイラストをお願いしたいと思います。\n\n■キャラ\nLink: https://sta.sh/212egacz4b2j\n\n■内容\nあなたに彼らの【He If】を描いてほしい。\n私はあなたが描いたインタラクティブな関係性が大好きです！そのぼんやりした雰囲気に私はとても心が動いて、もっとあなたの独得理解の彼らの付き合いを見たいです！\n\n\nとはいえ最終的には資料やキャラクター性などを元にあなたのお好みでご自由に描いて頂ければ幸いです。\n没ラフや下描きなどがあれば残したままにしていただけると嬉しいです、個人的な解読があればもとても嬉しいです！画像データはpngもしくはpsdだと助かります！\n以上、私の依頼を考慮していただき、ありがとうございました！*ᴗ ᴗ)⁾⁾", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@kurubushi_8/works/15", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2364218, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/421b8155/uploads/origins/1b36a2ef-ed9b-4b0f-96ea-55ebb78bd0b2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=77a459f499b7d6bd225ef471243e8c5a", "srcset": "https://si.imgix.net/421b8155/uploads/origins/1b36a2ef-ed9b-4b0f-96ea-55ebb78bd0b2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=77a459f499b7d6bd225ef471243e8c5a, https://si.imgix.net/421b8155/uploads/origins/1b36a2ef-ed9b-4b0f-96ea-55ebb78bd0b2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e8d7433581950a09f783871651ba893a 2x, https://si.imgix.net/421b8155/uploads/origins/1b36a2ef-ed9b-4b0f-96ea-55ebb78bd0b2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=74a8fecd6033d8399c809c074b6adbc4 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/421b8155/uploads/origins/1b36a2ef-ed9b-4b0f-96ea-55ebb78bd0b2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c987219dc9a74b1029d398c5b528346b", "srcset": "https://si.imgix.net/421b8155/uploads/origins/1b36a2ef-ed9b-4b0f-96ea-55ebb78bd0b2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c987219dc9a74b1029d398c5b528346b, https://si.imgix.net/421b8155/uploads/origins/1b36a2ef-ed9b-4b0f-96ea-55ebb78bd0b2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=942875401b34bd09cf435491e64da283 2x, https://si.imgix.net/421b8155/uploads/origins/1b36a2ef-ed9b-4b0f-96ea-55ebb78bd0b2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=fa476e17032cfef974919edc2f13836e 3x"}, "body": "はじめまして！ \nくるぶし様の素敵な絵柄に一目惚れをし依頼させていただきました。\n\n  どのイラストも魅力的ですが、特に有償依頼で受けられていた、カップルのモノクロのイラストがとても刺さりました。\n\n  可能であれば、同じような雰囲気でオリキャラを描いて頂きたいです。   \n\n\nオリキャラ2人の関係性は相棒で、恋愛感情はありませんが、2人の間には決して揺るがない深い信頼があります。\n 男性は闇属性、女の子は光属性です。\n\n  イラストの内容はくるぶし様にお任せします。\n\n シリアスでもほのぼのした日常のイラストでも何でも嬉しいです。  \n\nご検討の程よろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/189TRRR1loT9fYvoT14u2dfFhxhHt_DIB?usp=drive_link", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@kurubushi_8/works/14", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2364218, "client_id": 3439041, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/4c8e9a12/uploads/origins/a32401c7-2fa7-4707-9284-ac1df9d3c41a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=141494ef67cac91e45068168000c7d84", "srcset": "https://si.imgix.net/4c8e9a12/uploads/origins/a32401c7-2fa7-4707-9284-ac1df9d3c41a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=141494ef67cac91e45068168000c7d84, https://si.imgix.net/4c8e9a12/uploads/origins/a32401c7-2fa7-4707-9284-ac1df9d3c41a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=dcb703cd25b897351a1df55b16c60512 2x, https://si.imgix.net/4c8e9a12/uploads/origins/a32401c7-2fa7-4707-9284-ac1df9d3c41a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=bf04a6f31fc20fafee4b1479e81fda3d 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/4c8e9a12/uploads/origins/a32401c7-2fa7-4707-9284-ac1df9d3c41a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=33a930585bb7eda18c3d13a553a54a80", "srcset": "https://si.imgix.net/4c8e9a12/uploads/origins/a32401c7-2fa7-4707-9284-ac1df9d3c41a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=33a930585bb7eda18c3d13a553a54a80, https://si.imgix.net/4c8e9a12/uploads/origins/a32401c7-2fa7-4707-9284-ac1df9d3c41a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=e7e581d381ed818b18ff3af4842f9629 2x, https://si.imgix.net/4c8e9a12/uploads/origins/a32401c7-2fa7-4707-9284-ac1df9d3c41a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=85ed7ec73c17ff2ab0f06affea358708 3x"}, "body": "先生、こんにちは！\n偶然先生の作品を拝見し、その魅力に惹かれて今回ご依頼させていただきました。\n特に、先生が以前制作されたモノクロの作品や、シャープなラインが際立つフルフレームの構図がとても好きです。\nもし可能でしたら、ぜひ今回のリクエストをお受けいただければ幸いです。\n以下、私のキャラクターについての詳細になります。四人組のバンドメンバーです。\nボーカル / ギター1 - 今井 秋\n「19歳、186cm、男性。バンドメンバーをまるで母親のように気遣う、優しく包容力のある大人。」\nギター2 - 浅野 葵\n「17歳、160cm、女性。人見知りで打ち解けるのに時間がかかるが、実は情に厚い少女。猫が好きで、バンドのマスコット的存在。」\nベース - 江澤 脩\n「17歳、180cm、男性。普段は不機嫌そうな顔をしており、口も悪いが、根は優しい性格。メンダコが好きで、いつもドラマーにいじられている。」\nドラム - 響谷 律\n「17歳、168cm、男性。いつも笑顔で、イタズラ好き。バンドメンバーの黒歴史を撮影するのが趣味の小悪魔タイプで、特にベーシストをからかうのが楽しい。」\n-\nもし内容に不備や問題がございましたら、ご返金の上で再度ご依頼を送らせていただくことは可能でしょうか？\n何卒よろしくお願いいたします！\n\nhttps://drive.google.com/drive/folders/1-1EdsbgKb8rQVHN7AVMeNOa7G7qaF6tH", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@kurubushi_8/works/13", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2364218, "client_id": 286109, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/174c92bc/uploads/origins/50bc5f60-b650-45bb-ba1b-a4e7fbfb9b96?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=49472ab17c25ad67407d599c6c89fb30", "srcset": "https://si.imgix.net/174c92bc/uploads/origins/50bc5f60-b650-45bb-ba1b-a4e7fbfb9b96?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=49472ab17c25ad67407d599c6c89fb30, https://si.imgix.net/174c92bc/uploads/origins/50bc5f60-b650-45bb-ba1b-a4e7fbfb9b96?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=88a9569262b716113351bdd66e3708a0 2x, https://si.imgix.net/174c92bc/uploads/origins/50bc5f60-b650-45bb-ba1b-a4e7fbfb9b96?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d19e74fb9c378b454f9306670a813459 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/174c92bc/uploads/origins/50bc5f60-b650-45bb-ba1b-a4e7fbfb9b96?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=78ac126c4377868f48c0d192de0472c5", "srcset": "https://si.imgix.net/174c92bc/uploads/origins/50bc5f60-b650-45bb-ba1b-a4e7fbfb9b96?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=78ac126c4377868f48c0d192de0472c5, https://si.imgix.net/174c92bc/uploads/origins/50bc5f60-b650-45bb-ba1b-a4e7fbfb9b96?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=af86592e4efcf920b57b4fbd62be67ce 2x, https://si.imgix.net/174c92bc/uploads/origins/50bc5f60-b650-45bb-ba1b-a4e7fbfb9b96?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=6ba42fc6e9ceec0ceb16c1deb17ef3e5 3x"}, "body": "はじめまして。\nこちら(https://skeb.jp/@yakinikupanda_8/works/10)のイラストがすっごく良かったので、もしよろしければ自キャラ2人を同じ感じのモノクロ詰め合わせで描いて頂きたいです。\n\n2人は幼馴染で、お互いの事が大好きな男の子です。\nCPですが付き合ってるかどうかは定まってないので普通に仲の良い友達として描いて頂いても大丈夫です。\n\n攻め：授(黒髪の方)\n成績優秀、高身長、無口でクールな印象だけど受けが関わってると全然そんな事はない。\n受けに対する感情がデカすぎてどす黒いものも抱えているがそれを受けには見せないように必死。\n受けに嫌われたくはないけど、受けの全てが好きなので、自分の事を嫌っている受けすら見てみたくはある、といった感じ。\n\n受け：乃々(グラデ髪の方)\n顔がかわいい、天真爛漫、ぽやぽやしている、攻めの事をからかいがち。\n攻めの事が大好きなので攻めになら何されても許す。嫌いになる事もない。\n攻めのどす黒い感情については全く気付いていない、勝手に病んでる時あるのもおれの事大好きでかわい～と思っている。\n\n資料は表面にある物、資料になりそうな物フォルダ以外は参考になればと思い置いているものですので、見ても見なくても大丈夫です。\nまた、身長差は攻めの方がでかければ適当で大丈夫です。\n服装など描きやすいようにアレンジ/省略して頂いて構いません。\n\nよろしくお願いします。\n\nhttps://drive.google.com/drive/folders/1wMm6owqq3ztEcSLnaGjaNDhOijpZbrip?usp=sharing", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@kurubushi_8/works/12", "private_thumbnail_image_urls": nul