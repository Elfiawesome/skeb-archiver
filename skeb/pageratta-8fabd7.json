ている」\nでお願いします。\nですが、一番は、先生の思った通りに描いて頂ければ嬉しいです！\n\n※もしかしたら、動画作成時に若干イラストが動くかもしれません。（髪が揺れる等）\n\n資料URL：https://drive.google.com/drive/folders/1lrnoFZKGWUB2NBtfnkUbHiM9r0d4XTGG?usp=sharing\n※分かりづらいと思いますが、男です。(神見習いなので人ではないです)\n\n\nぜひ引き受けて下さると嬉しいです。\n\nご検討下さい。\n\nhttps://drive.google.com/drive/folders/1lrnoFZKGWUB2NBtfnkUbHiM9r0d4XTGG?usp=sharing", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@pageratta/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 124181, "client_id": 162466, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/73c761c0/uploads/origins/3bc58884-2e7e-4a76-b27f-279fd4fb7de7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2b2902f4c1b5540604b4919c2181904d", "srcset": "https://si.imgix.net/73c761c0/uploads/origins/3bc58884-2e7e-4a76-b27f-279fd4fb7de7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2b2902f4c1b5540604b4919c2181904d, https://si.imgix.net/73c761c0/uploads/origins/3bc58884-2e7e-4a76-b27f-279fd4fb7de7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=d358577481a867633e6d9d3e2e66a9bf 2x, https://si.imgix.net/73c761c0/uploads/origins/3bc58884-2e7e-4a76-b27f-279fd4fb7de7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=830f586659b2db3b1fdaf0ed4f7b7528 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/73c761c0/uploads/origins/3bc58884-2e7e-4a76-b27f-279fd4fb7de7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=12f88658ce390a28e2f205eb4cd96fa3", "srcset": "https://si.imgix.net/73c761c0/uploads/origins/3bc58884-2e7e-4a76-b27f-279fd4fb7de7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=12f88658ce390a28e2f205eb4cd96fa3, https://si.imgix.net/73c761c0/uploads/origins/3bc58884-2e