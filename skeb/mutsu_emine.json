mage_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2701416, "client_id": 1768183, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/f1190bfc/uploads/origins/80047eb0-ec43-423f-8eff-d5b028acbab2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a684939b98a6a9e6f6ad9ad20617b911", "srcset": "https://si.imgix.net/f1190bfc/uploads/origins/80047eb0-ec43-423f-8eff-d5b028acbab2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a684939b98a6a9e6f6ad9ad20617b911, https://si.imgix.net/f1190bfc/uploads/origins/80047eb0-ec43-423f-8eff-d5b028acbab2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=5768eb33f2858b18cdc77bc540f9bc4d 2x, https://si.imgix.net/f1190bfc/uploads/origins/80047eb0-ec43-423f-8eff-d5b028acbab2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=21da4b20f79504ef075da920a2272fce 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/f1190bfc/uploads/origins/80047eb0-ec43-423f-8eff-d5b028acbab2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9ad1d14b7ed35af4c7956a41e33cd2e6", "srcset": "https://si.imgix.net/f1190bfc/uploads/origins/80047eb0-ec43-423f-8eff-d5b028acbab2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9ad1d14b7ed35af4c7956a41e33cd2e6, https://si.imgix.net/f1190bfc/uploads/origins/80047eb0-ec43-423f-8eff-d5b028acbab2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=bc86098211c9f9b0d65ab9630e3f2266 2x, https://si.imgix.net/f1190bfc/uploads/origins/80047eb0-ec43-423f-8eff-d5b028acbab2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=45d336d454b2084c1e6835f8e3d7d674 3x"}, "body": "初めまして。ムツさんのカイゼリンとエルレインの絵を見て惹かれましたので依頼致します。\n「わんだふるぷりきゅあ！」の悟といろは、こむぎと大福のペット同伴デートの絵を描いて頂きたいです。(こむぎと大福は動物体)\n詳細を書きますと…\n\n・メインシチュエーションは「松島にある「円通院」の庭園の屋根付きベンチにて、4人がたわむれている」(円通院の庭園の写真は資料URL参照)\n・悟といろはの服装は、プリティストアのシリーズ商品「おでかけ！～紅葉～」の服装。\n・ベンチに悟は左、いろはは右に隣同士で座っている。\n・こむぎと大福はそれぞれ悟、いろはの膝の上に乗っている。大福は紅葉を拾って「どうだ？」とばかりにこむぎに見せていて、こむぎはそれに目を輝かせている。\n・悟といろははそれを微笑ましく見つめている。悟の左手、いろはの右手はベンチに沿って下で繋がれている。\n・天気は円通院の写真同様快晴。\n・円通院の写真は後ろの紅葉の木を全部映したかった為引き気味になってますが、もう少し屋根付きベンチ側にクローズアップしても構いません。\n\n「おでかけ！～紅葉～」での服装(いろはは右から4番目、悟は右端)→https://imgur.com/qoi0U7T\nこむぎと大福の全身→https://imgur.com/CPgEe2E\n\n後、僕は納品して頂いた絵については許可を頂いた場合のみ感想記事を絵を添付した上でブログに投稿しているのですが、許可できない場合は非表示設定にしてのリクエストの再送をして頂いても構いません。\nちなみに円通院は「縁結び」のご利益が大きいお寺なんだそうです。\n\n以上となります。悟いろが無事成就しましたので、そのファンアートとして依頼しています。検討宜しくお願い致します。\n\nhttps://imgur.com/VY15ZSl", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 8734, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "シロ9じらスケブ募集中", "screen_name": "siro90414", "avatar_url": "https://pbs.twimg.com/profile_images/2023464762668113920/uDOI9OFo.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1498108778/1607947973/1500x500", "appeal_receivable": false, "popular_creator_rank": 23, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 120, "skills": [{"genre": "art"}, {"genre": "comic"}, {"genre": "correction"}], "nc": 160}, {"id": 26671, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "青野　祈［依頼受付中］", "screen_name": "aono_inori", "avatar_url": "https://pbs.twimg.com/profile_images/1733377706581213184/d3FRVEj0.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1037562688832860160/1536211668/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "art"}], "nc": 17}, {"