　APP：14　年齢：28\nアイドルのマネージャーです🎶\n派手なアクションを好み、ジークンドーを嗜みます\n血の気が多く、台パンしたりメガネを割ったりしています👓\n普段は仕事のよくできる男性です\n\n\n💙使用用途\n・相方と共有し、幸せを分かち合う\n・skeb等で依頼する際の参考資料\n・SNSのアイコンやヘッダー\n・個人観賞用のグッズ作成\n・継続シナリオのココフォリアに飾る\n\n\n💙資料\n以下にまとめてあります\nhttps://drive.google.com/drive/folders/1n3rUkrOsAOzewZtK82DuzH1xCPwCa_1H", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@uzu_mizu2/works/4", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/f1b9d5fb/uploads/origins/dd49f21c-7503-40ec-8554-48ab7f699f6b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=df18aefb0d95e233bde9070b777d23be", "srcset": "https://si.imgix.net/f1b9d5fb/uploads/origins/dd49f21c-7503-40ec-8554-48ab7f699f6b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=df18aefb0d95e233bde9070b777d23be, https://si.imgix.net/f1b9d5fb/uploads/origins/dd49f21c-7503-40ec-8554-48ab7f699f6b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=9808a8b7fa86b11884dbb03911f3f2d0 2x, https://si.imgix.net/f1b9d5fb/uploads/origins/dd49f21c-7503-40ec-8554-48ab7f699f6b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=87dd6d24612be8b9686440877287834c 3x"}, "private": true, "genre": "art", "tipped": false, "creator_id": 3854286, "nc": 129}, {"path": "/@uzu_mizu2/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3854286, "client_id": 3908884, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/0fb55961/uploads/origins/77679ae9-abbe-46fc-bbc1-936c6