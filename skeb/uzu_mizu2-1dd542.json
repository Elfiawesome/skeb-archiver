キャンセルしていただいて構いません！\nよろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/1rDa9dTrhcBidJWGSP8rrIU_Q4IpMG_2c\n\nhttps://drive.google.com/drive/folders/1zNguLGlF5K6VGFDI_MgR8rVsqmfF0fHJ", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@uzu_mizu2/works/11", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3854286, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/fb2a16ff/uploads/origins/dcce362d-16a6-4459-b28e-f7cb1ade8de0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3ebc715c8ee1019123ed10b53b3624b0", "srcset": "https://si.imgix.net/fb2a16ff/uploads/origins/dcce362d-16a6-4459-b28e-f7cb1ade8de0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3ebc715c8ee1019123ed10b53b3624b0, https://si.imgix.net/fb2a16ff/uploads/origins/dcce362d-16a6-4459-b28e-f7cb1ade8de0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=d0883cae95138cddd71be04ebd0bc74e 2x, https://si.imgix.net/fb2a16ff/uploads/origins/dcce362d-16a6-4459-b28e-f7cb1ade8de0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b71d83d343d08860ef17e28cf8ac16a8 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/fb2a16ff/uploads/origins/dcce362d-16a6-4459-b28e-f7cb1ade8de0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=8e885738bd2e557edbb829fbea1ace63", "srcset": "https://si.imgix.net/fb2a16ff/uploads/origins/dcce362d-16a6-4459-b28e-f7cb1ade8de0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=8e885738bd2e557edbb829fbea1ace63, https://si.imgix.net/fb2a16ff/uploads/origins/dcce362d-16a6-4459-b28e-f7cb1ade8de0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=b83fe2de4c5cd131a0d4cc54b6ccf9c3 2x, https://si.imgix.net/fb2a16ff/uploads/origins/dcce362d-16a6-4459-b28e-f7cb1ade8de0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=492b2b6445ec3c0d9a40d1fcfe5a7c64 3x"}, "body": "はじめまして\nこの度、skebでイラストを拝見し、ご依頼させていただきたいと思いました。\n\n描いていただきたいのは、\nSOLEILプロダクション(@SOLEIL_Vliver)所属のVライバー黒須クメルさん(@kumerucross)です。(雑談好きなゲーマーライバーさんです)\n\n事務所のガイドライン的に二次創作は問題ありません。\n\n【目的】\n黒須クメルさんが、サムネイルやXなどでの、VTuber活動で使用できるように許可をいただきたいです。また、配信サイトでの返礼品としても、使用させていただきたいです。\nそのため、頭が見切れないようになっていると助かります。\nまた、自分の観賞用のためです。\n\nこちら黒須クメルさんのHPです。\nhttps://soleil-production.com/liver/メンバー5/\n\n【内容】\n構図や内容はおまかせいたします。\n活動に使用できるように、文字なし、背景なしなどレイヤーを分けたPSDファイルで納品だと大変ありがたいです。", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@uzu_mizu2/works/10", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3854286, "client_id": 3716064, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/fb284cc9/uploads/origins/a06a516f-31cc-4cbe-be48-a0eba98a126a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9ea055de3338c40e5fe432b7ba807dbc", "srcset": "https://si.imgix.net/fb284cc9/uploads/origins/a06a516f-31cc-4cbe-be48-a0eba98a126a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9ea055de3338c40e5fe432b7ba807dbc, https://si.imgix.net/fb284cc9/uploads/origins/a06a516f-31cc-4cbe-be48-a0eba98a126a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=07bdf213b20b02406c23f566e33a574f 2x, https://si.imgix.net/fb284cc9/uploads/origins/a06a516f-31cc-4cbe-be48-a0eba98a126a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e00ec09577371c3ad11f0377a457d6b3 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/fb284cc9/uploads/origins/a06a516f-31cc-4cbe-be48-a0eba98a126a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=619268eb7141a592b4069ae153984dce", "srcset": "https://si.imgix.net/fb284cc9/uploads/origins/a06a516f-31cc-4cbe-be48-a0eba98a126a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=619268eb7141a592b4069ae153984dce, https://si.imgix.net/fb284cc9/uploads/origins/a06a516f-31cc-4cbe-be48-a0eba98a126a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=18926fa0859a7061c88d7f07c4b80570 2x, https://si.imgix.net/fb284cc9/uploads/origins/a06a516f-31cc-4cbe-be48-a0eba98a126a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=952be963097fef50d54de4795f7d4eed 3x"}, "body": "初めまして、個人Vtuberの恵蕩ルクと申します。\n\nXで作品を拝見し、大変素敵なイラストに惹かれぜひ私恵蕩ルクを描いていただきたいと思いリクエストをお送りいたしました！\n\nーーーーーーーーーー\n\n【使用用途】\n・Youtubeサムネイル\n・動画投稿素材\n・SNS投稿\n・他素材と組み合わせてのSNS投稿(おはV等)\nなどに使用予定となっております。\n\n【描写内容】\n同じ構図・ポーズで「通常顔」と「表情差分」の2種類をお願いしたいです。\n（体や構図はそのままで、顔のみ変化するイメージです）\n\n■ポーズ・構図・背景\n偶然様のセンスにおまかせいたします！\n女性らしさというよりは性別が曖昧な雰囲気、中性感のあるポーズだと嬉しいです。\n\n全体的に中性を意識しており、女性らしい体のラインがないが男性ほど骨格がしっかりとしているわけではない体つきが特徴です。\n女性というより、「綺麗な人」というイメージです。\n\n■通常顔\n・柔らかく自然な微笑み\n・相手をまっすぐ見ている視線\n・優しさや安心感のある表情\n\n■表情差分（少し特殊です）\n同じように微笑んでいるのに、どこか違和感がある表情をお願いしたいです。\n\n具体的には\n・口角が通常顔よりも少し上がっておりどこか愉楽的な雰囲気を感じるような表情\n・目元や頬の動きを減らし、目だけを見るとやや無機質な雰囲気\n・瞳の色を赤系に変更（鮮やかすぎず、やや深みのある赤）\n・瞳のハイライトは通常より控えめで、生気が少し薄い印象\n\n怖い顔や怒っている表情ではなく、目だけを見ると「人に期待することをやめている」ような印象があるととても嬉しいです…！\n\n■服装、ヘアセット\n立ち絵準拠でお願いいたします！\n\n■補足\nゲーム「グノーシア」の世界に入った恵蕩ルクをイメージしており、通常顔／グノーシア顔をお願いしたいと考えております。\n※グノーシア顔は、「人ではない、どこか違和感のある顔」ととらえていただければ問題ございません。\n\n作品をご存じでしたら、雰囲気の参考にしていただけますと幸いです。\n資料内にも参考画像をお入れしております！\n\n簡単にキャラクター設定も記載いたしますので、あわせてご参照ください。\n\n□キャラクター設定\n性格は基本的に穏やかで優しく、誰に対しても分け隔てなく接するタイプです。\n人との距離はやや近く、自然と相手に寄り添うような雰囲気があります。\n\n一方で、内面的には「他人に過度な期待をしない」考え方を持っており、\n状況に応じて冷静に判断・割り切る一面もあります。\n\nそのため、優しい印象のままどこか客観的で、\n“感情と判断が少し分離しているような雰囲気”を持っているイメージです。\n\n【その他】\n可能であれば背景、宛名なしの人物のみ透過データもしくはpsdファイルも合わせて頂戴できますと幸いです。\nなお、その際頭部や髪、手や肩などの見切れがないととてもありがたいです！\n\nーーーーーーーーーー\n\n使用用途、依頼内容による金額に問題がございましたらお手数おかけいたしますが再送依頼をいただけますと幸いです。\n\nご検討のほどよろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/1gi1DZNL6CxW5mGPqDXmYyUWH7QsQyVRl?usp=sharing", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@uzu_mizu2/works/9", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3854286, "client_id": 3001251, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/ab810f4c/uploads/origins/747618b4-680a-407b-8db5-6827f2479476?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=eb15db851070c2534f98a1ea063ee52f", "srcset": "https://si.imgix.net/ab810f4c/uploads/origins/747618b4-680a-407b-8db5-6827f2479476?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=eb15db851070c2534f98a1ea063ee52f, https://si.imgix.net/ab810f4c/uploads/origins/747618b4-680a-407b-8db5-6827f2479476?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=40720086a31ebfd21790b090bdbce524 2x, https://si.imgix.net/ab810f4c/uploads/origins/747618b4-680a-407b-8db5-6827f2479476?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ae94610e482ba8cc7a2c1d854e9e287e 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/ab810f4c/uploads/origins/747618b4-680a-407b-8db5-6827f2479476?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9c4755b2786e3f08ac654d535638d66f", "srcset": "https://si.imgix.net/ab810f4c/uploads/origins/747618b4-680a-407b-8db5-6827f2479476?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9c4755b2786e3f08ac654d535638d66f, https://si.imgix.net/ab810f4c/uploads/origins/747618b4-680a-407b-8db5-6827f2479476?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=e1e3a9175121ce2b33dce5b069b626ff 2x, https://si.imgix.net/ab810f4c/uploads/origins/747618b4-680a-407b-8db5-6827f2479476?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=1373115ac5bab868be79b6ea9b3d6b95 3x"}, "body": "はじめまして！偶然様のイラストが新着作品にあり、あまりにも素敵だったためリクエストを送らせていただきました。よかったら私のOCを描いてもらいたいです！\n\n詳細は下記に記載しますが、 立ち絵などを用意した資料はGoogle Driveにて共有させていただきます。\n基本的には構図や雰囲気など全てお任せでお願いできればと思います^^\n服装について資料以外のものを着せていただいても大丈夫です\n自由に描いてください！^^\n\nキャラ▶︎Ｑ\n彼は以前死んだことがあったが、どういうわけか戻ってきた(?)\n多分今は普通のサラリーマンです^^\n･赤いメガネ\n･真っ黒な瞳\n･右目の下ほくろ二つ\n･唇の下ほくろに一つ、首に一つ\n･左眉に小さな傷跡がある\n\n▶︎性格\n陰キャで、神経質で、唇や爪を噛む癖がある、独占欲がかなり強めです。\n好きな人には大型犬みたいに懐いて甘えるタイプです。\n\n使用目的として、SNSアイコン、印刷して個人鑑賞等を予定しています。\n日本语があまり得意ではない…以上の文章は流暢ではないかもしれません、ご容赦ください。\nもし金額が不足している、または内容に問題等ございましたら、お手数ですが、再送をしていただけますと幸いです。\nご検討よろしくお願いします！！\n\nhttps://drive.google.com/drive/folders/1ZOaA5L-bPA31ajrqO3RRYUCZyWLf-WlS", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@uzu_mizu2/works/8", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/decbbeee/uploads/origins/c8134ab7-d150-40cb-8776-74ad8ebeffa2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=d515694ab1ab49e941c62c8f0948d3a9", "srcset": "https://si.imgix.net/decbbeee/uploads/origins/c8134ab7-d150-40cb-8776-74ad8ebeffa2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=d515694ab1ab49e941c62c8f0948d3a9, https://si.imgix.net/decbbeee/uploads/origins/c8134ab7-d150-40cb-8776-74ad8ebeffa2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=dafdd1aa39ff175d655110dfcf827cf6 2x, https://si.imgix.net/decbbeee/uploads/origins/c8134ab7-d150-40cb-8776-74ad8ebeffa2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=