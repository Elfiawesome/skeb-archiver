=top&w=200&h=200&s=40ddc61f20c36ab5c2a29091e1e758a8", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/0ffdc7b5/uploads/origins/b1510e65-7abc-4a8e-b7fc-4711b1d35363?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e4d37a3c04e03d7a4d3b48eb625bc3eb", "src_set": ""}, "body": "Hello! \n\nI love the last art piece you made me, and would love to work with you again.\nWould you be willing to draw 2 characters for me?\nThey are both dragon girls, and their designs are similar last characters you drew.\n\nThey would be in a Christmas setting.\nCould you draw them inside sitting in front of a fire place?\nThey would be drinking hot chocolate and enjoying each others company.\nWould you draw them wearing cute winter clothes or pajamas? \n\nThank you!\n\nCharacters - https://imgur.com/a/40OW6Jp\nSetting/Inspiration - https://imgur.com/a/vctmotk", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@icccch/works/21", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 190217, "client_id": 2143525, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/67f6957f/uploads/origins/5bdf7e62-cb7b-4eb8-bf3f-7a032fff2982?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7fb6bbbb3c360efc5edaf3d59d8b6c90", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/67f6957f/uploads/origins/5bdf7e62-cb7b-4eb8-bf3f-7a032fff2982?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e7476b5ae5460839d10b0fd7e7eb464b", "src_set": ""}, "body": "ich.さま  \n\nはじめまして。\n Vtuberとして活動しております「くまのりんご」と申します。 https://twitter.com/kumakumaringogo  \n\nich.さまの描くイラストが可愛らしく、構図も素敵で、\nぜひ私を描いて頂きたいと思い、リクエストさせて頂きました。  \n\nシチュエーションは「ケーキを一生懸命作っているところ」でお願いしたいです。\n料理は下手くそなので、生クリームが顔についてしまっていて、\nそれでも頑張って作っている！という感じだと嬉しいです。\nまた、ケーキに使うフルーツは「ブドウ」がメインだと幸いです。\n可愛いエプロンをつけていて、その他細かい衣装や髪型などはお任せいたします。\n\n配信活動で使用させて頂きたいので、 \n人物のみの透過データもあると大変助かります。  \n\n参考資料はこちらです。 https://drive.google.com/drive/folders/1SzhSppMPbflbEutKC8bnwZ4BlalbG8fW?usp=sharing \n目の中にハートがあります。\n\nご検討、よろしくお願いいたします。", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@icccch/works/20", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 190217, "client_id": 628323, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/2835663b/uploads/origins/4470ef1b-e75b-4de6-8274-e62ed6accde1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9297ac5715d30abe5278adc6adaf243a", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/2835663b/uploads/origins/4470ef1b-e75b-4de6-8274-e62ed6accde1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=4f7e23bcdb778bc6af9231ef1768990e", "src_set": ""}, "body": "こんにちは、あなたの絵はとても素敵ですね、私のために作品を描いていただけませんか？\n竜の女の子2人のキャラクターでお願いします。\n\n農作業をしているところを描いていただけませんか？\n彼らは土地を探検したり、作物を集めたりしているはずです。\n彼らは仕事を終わらせるために一生懸命働いています。\n二人は一緒に働くことを楽しんでいます。\n\n彼らはまた、彼らのペットのいくつかを持っています。\n彼らのペットを描いてください。\n\n服装は簡略化してもかまいません。\n\nキャラクター - https://imgur.com/a/QzgHQae\nペット（描きたいものを選んでください）- https://imgur.com/a/Q5nFuL8\n設定- https://imgur.com/a/lv3eUga", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@icccch/works/19", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 190217, "client_id": 781457, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/5eed3cc8/uploads/origins/9302e930-ec4d-41ad-a7ba-ce2d8821dcb2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e9d17f868a7dce86136b76e0ca7a219f", "src_set": 