psdファイルをいただければありがたいです。\n\nご多忙のところ誠に恐縮ではございますが、ご検討のほどよろしくお願い申し上げます。これからも活動応援しています。\n\nhttps://twitter.com/hojurura/status/1551769260632211456", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@owantogohan/works/8", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1153188, "client_id": 1374559, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/7b11928a/uploads/origins/88313387-660d-4a3b-a717-fdc78d1857cf?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2f2362bc1bba55ede466f4f66c98754c", "srcset": "https://si.imgix.net/7b11928a/uploads/origins/88313387-660d-4a3b-a717-fdc78d1857cf?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2f2362bc1bba55ede466f4f66c98754c, https://si.imgix.net/7b11928a/uploads/origins/88313387-660d-4a3b-a717-fdc78d1857cf?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=25b3d92e7f62b49700ed9297ba69b30f 2x, https://si.imgix.net/7b11928a/uploads/origins/88313387-660d-4a3b-a717-fdc78d1857cf?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=9f4ea918e0065fe54bc8ddf4cd5de4a4 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/7b11928a/uploads/origins/88313387-660d-4a3b-a717-fdc78d1857cf?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=1e06b84de3a8ff745f85e93c204518e6", "srcset": "https://si.imgix.net/7b11928a/uploads/origins/88313387-660d-4a3b-a717-fdc78d1857cf?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=1e06b84de3a8ff745f85e93c204518e6, https://si.imgix.net/7b11928a/uploads/origins/88313387-660d-4a3b-a717-fdc78d1857cf?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=1b354c6b168fa3b0261fb5caf1179696 2x, https://si.imgix.net/7b11928a/uploads/origins