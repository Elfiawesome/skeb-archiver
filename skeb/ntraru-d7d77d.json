てたり、液体が垂れていないもの(パンツが膨らんでいるだけのものです)\n5　3のアンダースコートが茶色に染まってたり、液体が垂れていないもの(アンダースコートが膨らんでいるだけのものです)\n\nまた、2〜5に「お願い、嫌いにならないで…」と涙目で言わせてください\n\n指定事項が多くて申し訳ありませんが、割に合わない依頼だと判断されましたら、即キャンセルして構いませんのでよろしくお願いたします", "nc": 49, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@ntraru/works/14", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/5febbe64/uploads/origins/1a523239-61d0-499c-96b1-5a6a50012c4f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=486d97ca9e99a672076e967af4771366", "srcset": "https://si.imgix.net/5febbe64/uploads/origins/1a523239-61d0-499c-96b1-5a6a50012c4f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=486d97ca9e99a672076e967af4771366, https://si.imgix.net/5febbe64/uploads/origins/1a523239-61d0-499c-96b1-5a6a50012c4f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=fcf7c9670b5e042e800e7b967dd0b089 2x, https://si.imgix.net/5febbe64/uploads/origins/1a523239-61d0-499c-96b1-5a6a50012c4f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=f50c78de35931b83db4b4710a04e8ca0 3x"}, "private": true, "genre": "comic", "tipped": false, "creator_id": 752381, "nc": 48}, {"path": "/@ntraru/works/13", "private_thumbnail_image_urls": null, "private": false, "genre": "comic", "tipped": true, "creator_id": 752381, "client_id": 384685, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/716a59ec/uploads/origins/61a20514-aaee-4118-bc57-345e58e8f2e0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1893d855ae45f1ff01