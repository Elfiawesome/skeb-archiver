x.net/b509c1bc/uploads/origins/53ec6ad0-c9f2-4f7d-b15d-d277fcd4f654?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3e2442db213a4dc2d99fc9e67f61238d", "srcset": "https://si.imgix.net/b509c1bc/uploads/origins/53ec6ad0-c9f2-4f7d-b15d-d277fcd4f654?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3e2442db213a4dc2d99fc9e67f61238d, https://si.imgix.net/b509c1bc/uploads/origins/53ec6ad0-c9f2-4f7d-b15d-d277fcd4f654?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=485f2a1480f96f53b705d0c98d815219 2x, https://si.imgix.net/b509c1bc/uploads/origins/53ec6ad0-c9f2-4f7d-b15d-d277fcd4f654?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=cd3c4662e2efb166d880101ec03d2f07 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/b509c1bc/uploads/origins/53ec6ad0-c9f2-4f7d-b15d-d277fcd4f654?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=99b73b4713fef0216c6c3833b8edafcd", "srcset": "https://si.imgix.net/b509c1bc/uploads/origins/53ec6ad0-c9f2-4f7d-b15d-d277fcd4f654?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=99b73b4713fef0216c6c3833b8edafcd, https://si.imgix.net/b509c1bc/uploads/origins/53ec6ad0-c9f2-4f7d-b15d-d277fcd4f654?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=adaaaceb6063aa8fc1e45f37e65b9190 2x, https://si.imgix.net/b509c1bc/uploads/origins/53ec6ad0-c9f2-4f7d-b15d-d277fcd4f654?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=bc023f40575d3a3f97fdef39c6393272 3x"}, "body": "はじめまして、この度skebを再開したと知ってリクエストさせていただきます。\n先生が以前描かれていた「勇者見習いタケシ」シリーズより、若かりし頃(作中のタケシやエイミーと同年代)のタケシのお爺さんとおばあちゃんが魔王討伐の旅をしている道中の様子を描いていただけないでしょうか。\n\n・キャラクター(名前はお任せします)\n女剣士(若かりし頃のおばあちゃん)はエイミーにそっくりな容姿の勝気な少女だが、魔王や魔物たちのせいで食糧事情が作中より良くないためか体つきはエイミーより華奢な感じ。作中のエイミーと同じビキニアーマーを着用しており、腰から剣を提げている。\n勇者(若かりし頃のお爺さん)は銀髪の少年で、性格は実直で今のようなスケベさは見られないが、年相応に異性を意識する一面もある。\n\n・シチュエーション\n①山や森の中を歩いている道中で日が傾き始め、女剣士が地図を手にして勇者の方を向いて「宿も遠いし、今日はここらへんで野宿にしよう」と提案してくる。\n②岩の上にあぐらをかくように座り込み、たき火の傍らで食事をとる女剣士。ガサツで開けっ広げな格好でこちらに話しかけてくる女剣士に対し、勇者は他愛もない会話をしながらも内心どぎまぎしている。\n\n①の構図は「勇者見習いタケシ」1話(資料URL参照)に近い感じで、②の構図は勇者の一人称視点で女剣士の足元まで見えるような感じでお願いします。また、2人以外に旅の仲間がいても構いませんが、いずれも画面外で台詞のみにしてください。\n\nご検討のほどよろしくお願いいたします。\n\nhttps://www.pixiv.net/artworks/89134333", "nc": 49, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@ntraru/works/11", "private_thumbnail_image_urls": null, "private": false, "genre": "comic", "tipped": false, "creator_id": 752381, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/290369e8/uploads/origins/8774cbfe-c79c-4c42-9104-c7e77a828805?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7140d3eabb0e66274f3c2988226c303d", "srcset": "https://si.imgix.net/290369e8/uploads/origins/8774cbfe-c79c-4c42-9104-c7e77a828805?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7140d3eabb0e66274f3c2988226c303d, https://si.imgix.net/290369e8/uploads/origins/8774cbfe-c79c-4c42-9104-c7e77a828805?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=0a8917066b909d45db202fc0c405f181 2x, https://si.imgix.net/290369e8/uploads/origins/8774cbfe-c79c-4c42-9104-c7e77a828805?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=8fabae77bea480aa483d8ef4a3a088da 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/290369e8/uploads/origins/8774cbfe-c79c-4c42-9104-c7e77a828805?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=7b133b151cf73f24b0444d1aa37d75ff", "srcset": "https://si.imgix.net/290369e8/uploads/origins/8774cbfe-c79c-4c42-9104-c7e77a828805?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=7b133b151cf73f24b0444d1aa37d75ff, 