身長→158cm 年齢→18歳 職業→高校3年生\n見た目→\n・茶髪巻き髪、黄緑目\n・八重歯あり（左右自由）\n・黄緑色の花の装飾が散らばるように髪についている。\n多少のヘアアレンジは可ですが、髪の花の装飾・顔周りの毛は変えないでいただきたいです。\n\n\n◆キャラB（銀髪の男性）\n\n周防 聖（すおう ひじり）\n性別→男  身長→173cm 年齢→17歳 職業→高校3年生\n見た目→\n・銀髪ハーフアップ、水色目\n表情→\n・雛が唐突なことを言い出すことも多いので立ち絵通りの困り顔\n・好意を伝える時や甘やかす時の安堵や優しい表情（表情参考.png）\n\n\n〈使用用途〉 \n\n 一緒に遊んだ方への共有、個人鑑賞のための印刷、SNSのヘッダーやアイコン、デスクトップ画面への使用、個人的なグッズ化（販売はしません）\n\n\n詳細は以上になります。\nご都合がよろしければ何卒よろしくお願いいたします🙏\n\nhttps://drive.google.com/drive/folders/1lDkKA3EJ47aTtrW1me2VnzHd31Na3DC0?usp=sharing", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@V9iQx_/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3373190, "client_id": 3373225, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/71fd89b8/uploads/origins/4aa4399e-5110-4738-80d8-01f380e43c86?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6f58b59a06c3f7677180af966d9d6770", "srcset": "https://si.imgix.net/71fd89b8/uploads/origins/4aa4399e-5110-4738-80d8-01f380e43c86?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6f58b59a06c3f7677180af966d9d6770, https://si.imgix.net/71fd89b8/uploads/origins/4aa4399e-5110-4738-80d8-01f380e43c86?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=4c5e1db0390fffca7ee7ee996edb69cd 2x, https://si.imgix.net/71fd89b8/uploads/origins/4aa4399e-5110-4738-80d8-01f380e43c86?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c9eed9fce341d65306926637f8af52d6 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/71fd89b8/uploads/origins/4aa4399e-5110-4738-80d8-01f380e43c86?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=58dab8974d2fd297bd17b8976a1be8e1", "srcset": "https://si.imgix.net/71fd89b8/uploads/origins/4aa4399e-5110-4738-80d8-01f380e43c86?bg=%23fff&au