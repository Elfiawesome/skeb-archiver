ャラクターは自信なさげな控えめの女の子です。可能であれば、冷や汗あり、ハイライト無しでお願いいたします。\n\nまた、可能であれば添付資料にいる黄色いひよこのようなものをどこかに入れていただけると嬉しいです。（アクセサリーやぬいぐるみ等）\nhttps://drive.google.com/drive/folders/1dz7lYcAqQY3hLEZnqh0MqMYTYkDwfSlt\n\n今後依頼する際に使用したいので透過イラストも貰えますと幸いです。\n金額等足りなければ再送やキャンセルして頂いて構いません！よろしくお願いしますꪔ̤̮ ♡\n\nhttps://drive.google.com/drive/folders/1dz7lYcAqQY3hLEZnqh0MqMYTYkDwfSlt", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@oooomuretu00/works/313", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3139707, "client_id": 3348368, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/e0793935/uploads/origins/0969c33b-3845-4db9-b535-34ee6aabecce?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d17368bee3e32cd2be3e6214b89e2c08", "srcset": "https://si.imgix.net/e0793935/uploads/origins/0969c33b-3845-4db9-b535-34ee6aabecce?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d17368bee3e32cd2be3e6214b89e2c08, https://si.imgix.net/e0793935/uploads/origins/0969c33b-3845-4db9-b535-34ee6aabecce?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f672ec8796559431bcc04a039baa11be 2x, https://si.imgix.net/e0793935/uploads/origins/0969c33b-3845-4db9-b535-34ee6aabecce?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=68363ba68243fb38cf485d40b9b8cfdb 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/e0793935/uploads/origins/0969c33b-3845-4db9-b535-34ee6aabecce?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=400ff9529cb552917856972afcf4e0f4", "srcset": "https://si.imgix.net/e0793935/uploads/origins/0969c33b-3845-4db9-b535-34ee6aabecce?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=400ff9529cb552917856972afcf4e0f4, https://si.imgix.net/e0793935/uploads/o