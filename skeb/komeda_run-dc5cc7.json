る内容はズバリ！「らんちゃんとワイ」です。\nワイの姿はＸのアイコンのような猫、もしくはＸのトップページのイラストの左に居るボックスティッシュを持った猫を参考にして頂ければと思います！\nらんちゃんが昔描いたテフちゃんとらんちゃんでうさ耳を合わせた絵のように猫耳のイラスト（ねこめだちゃん？）もよし、らんちゃんがワイを抱きかかえるのもよし、お菓子が大好きなワイですので一緒にお茶会してるのもよし、らんちゃんがワイに乗ってるのもよし、それ以外でもよし、イラストの内容はおまかせします！\nただ一つ、ワイのイラスト部分はトリミングしてＸのアイコンにも使えればと思っていますので、お顔部分が何かに隠れていなければ嬉しいです。\nＸのアイコンはワイのアイコンなんですけど、実はイラストを広げた時、らんちゃんと戯れるワイのイラストになる！そんな風にエモくなれば嬉しいなと思います！\nワイからのリクエストは急ぎとかではありませんので、睡眠時間削ったりしちゃダメですよ！他のお作業があればそちらを優先して大丈夫です！\n以上になります。長文失礼しました。よろしくお願いします！\n\nhttps://x.com/seimin2525/header_photo", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@komeda_run/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3579496, "client_id": 3685790, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/fdf4381b/uploads/origins/2e220917-8285-43d5-ab7c-49de51e10345?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b82e27273f56ab67f526b07a27274e93", "srcset": "https://si.imgix.net/fdf4381b/uploads/origins/2e220917-8285-43d5-ab7c-49de51e10345?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b82e27273f56ab67f526b07a27274e93, https://si.imgix.net/fdf4381b/uploads/origins/2e220917-8285-43d5-ab7c-49de51e10345?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=d63b7e81eddf487b37497d37c41bbcf0 2x, https://si.imgix.net/fdf4381b/uploads/origins/2e220917-8285-43d5-ab7c-49de51e10345?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=54a0994a87943f6cb65d820ae088ea5c 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/fdf4381b/uploads/origins/2e220917-8285-43d5-ab7c-49de51e10345?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6702631d737efe89b7f6149a8a8509c9", "srcset": "https://si.imgix.net/fdf4381b/uploads/origins/2e220917-8285-43d5-ab7c-