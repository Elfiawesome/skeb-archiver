/1zG9l-btdNWAGfOL9UKRAda1_zU5cuzll?usp=sharing\n\nhttps://skeb.jp/@downfallwinter/works/37。\n\nメナスはほとんど裸であってほしいが、首輪とメイドの頭飾りはつけたままで描いてほしい。彼女の胸、乳首、アソコがはっきり見える限り、残りの服をどうするかはあなたが決めてください。完全に取り除くか、邪魔にならないようにしてください。\n\n彼女の陰毛と尻毛も濃くて手入れされていない黒で描いてください。興奮したような表情で、片方の手でアソコを触ってほしい。彼女はオナニーをしている。\n\nリクエストに応えてくれてありがとう！", "nc": 59, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}], "similar_creators": [{"id": 91124, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "🐯", "screen_name": "HHy9i", "avatar_url": "https://pbs.twimg.com/profile_images/1296362373305884673/rpa-pf9m.png", "header_url": "https://pbs.twimg.com/profile_banners/1032758458997567489/1697084529/1500x500", "appeal_receivable": true, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "skills": [{"genre": "art"}], "nc": 176}, {"id": 114716, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "KKR", "screen_name": "kukuru100", "avatar_url": "https://pbs.twimg.com/profile_images/1799747706669375488/XGtMG0aL.jpg", "header_url": "https://pbs.twimg.com/profile_banners/2187994933/1650603092/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "skills": [{"genre": "art"}, {"genre": "comic"}], "nc": 48}, {"id": 371206, "creator": true, "nsfw_acceptable": true, "acceptable": false, "name": "ホンダラニャ4世", "screen_name": "hondaranya2", "avatar_url": "https://pbs.twimg.com/profile_images/1732437113818472448/nc_xLZ3z.jpg", "header_url": null, "appeal_receivable": true, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 1, "skills": [{"genre": "art"}], "nc": 49}, {"id": 445479, "creator": true