290916d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=340d4e0539c4ac397d5879ebd8fbe5a9, https://si.imgix.net/911f731a/uploads/origins/692115b3-525f-4373-a336-dedd9290916d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=3a68f94a1b84b7dbe4ca19307d8a809a 2x, https://si.imgix.net/911f731a/uploads/origins/692115b3-525f-4373-a336-dedd9290916d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=70e8ef55b6a6a19f05a2e13793f18563 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/911f731a/uploads/origins/692115b3-525f-4373-a336-dedd9290916d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d6c044653a6dc27cb370daf7d64cb40f", "srcset": "https://si.imgix.net/911f731a/uploads/origins/692115b3-525f-4373-a336-dedd9290916d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d6c044653a6dc27cb370daf7d64cb40f, https://si.imgix.net/911f731a/uploads/origins/692115b3-525f-4373-a336-dedd9290916d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=5e2e4bb6e064929f7106d0960303396f 2x, https://si.imgix.net/911f731a/uploads/origins/692115b3-525f-4373-a336-dedd9290916d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=23c39eb3cfa09abfb5925c54a9b09f51 3x"}, "body": "こんにちは！㸍㖠粉（きなこ）という者です。いつも素敵な作品をありがとうございます✨✨\nねねひめちゃん、こよりちゃんやあくあちゃん、ライスちゃんのイラストが本当に好きで、毎日眺めているほどです！！\nフォロワーさんが1000人くらいの頃からずーっと応援していて、いつかイラストを依頼しようと思っていました。\n\n今回はぜひ、私のオリキャラを描いて頂きたいと思い、リクエストを送っております。（お小遣いがピンチなのでこんな金額で本当にごめんなさい泣泣）\n\n絵師様に依頼をするのは初めてなので、色々不手際があって、お手数をお掛けするかもしれませんが、依頼の内容で分からない部分がありましたら、おねねさんなりに解釈して、自由に描いて頂ければ幸いです。よろしくお願いしますm(_ _)m\n\nでは、リクエストの内容ですが、\n・オリキャラのキナコを描いていただきたいです。URL先に参考画像を貼っています。\n・私のプロフィールに記載してある別のアカウント等のアイコンに使用する予定です。アイコンなので正方形でお願いします。正方形であればサイズの指定はありません。\n・服は基本水色で、白い襟に赤いリボンをつけていますが、おねねさんの判断でデザインを変更したり、他の服にするのも大歓迎です。おねねさんが可愛いと思った感じでお願いします(*^^*)\n・髪の毛に関しては金髪のショートボブ？ですが、おねねさんは髪の毛が長い女の子のほうが得意そうに思います。（違ったらごめんなさい💦）もし、長さを足した方がいいと判断した場合は、ロングにしても大丈夫です。\n・赤い眼鏡は差分として取り外し可能だと有難いですが、金額に見合ってないと感じるようであれば、眼鏡そのものをなしにしてしまって構いません。\n・おめめはいつも通りキラキラで！おねねさんのおめめ大好きです♡\n・リクありがとうの文字＆名前もできれば別レイヤーでお願いしたいです！が、㸍㖠粉という書くのが大変な名前なのでひらがなでも全然OKです（むしろ難しい名前でごめんなさい😂）\n・また、おねねさんのサインもお願いします(´˘`＊)\n・その他、構図などはお任せします。おねねさんの描きたいように、描きやすいように描いちゃってください✨\n\n以上です！もし描いてくださったら、ぜひ宣伝としてイラストを使うアカウントの方でプロフィールに記載させてください♪また、ツイートの方もさせてください🙇‍♀️これからも素敵な作品を楽しみにしています✨よろしくお願いしますm(_ _)m\n\nhttps://twitter.com/kinako_drawing/status/1469508359712030720?s=21", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@OneneChan/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 537399, "client_id": 1709785, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/4e6c6a57/uploads/origins/8173b4a9-80e8-49c0-8156-75fd531cf245?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d2b333a7c99d3c23590408d759b744b7", "srcset": "https://si.imgix.net/4e6c6a57/uploads/origins/8173b4a9-80e8-49c0-8156-75fd531cf245?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d2b333a7c99d3c23590408d759b744b7, https://si.imgix.net/4e6c6a57/uploads/origins/8173b4a9-80e8-49c0-8156-75fd531cf245?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=796a59724a5e1c3c56345b8aebf92df9 2x, https://si.imgix.net/4e6c6a57/uploads/origins/8173b4a9-80e8-49c0-8156-75fd531cf245?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=699668166890aa5aa03f73760d98830e 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/4e6c6a57/uploads/origins/8173b4a9-80e8-49c0-8156-75fd531cf245?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d26d7d985f3ab51ef23e214adf2f9526", "srcset": "https://si.imgi