": 2339483, "client_id": 2994934, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 145, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@melange_yako/works/29", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2339483, "client_id": 3195763, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/143a8f85/uploads/origins/a51175b4-d893-43b0-ba65-416fc65034b1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4b4c2fe6e73d1bcadb3344fb90b21c88", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/143a8f85/uploads/origins/a51175b4-d893-43b0-ba65-416fc65034b1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f246a24f4fdf0a6a71c51a22f76fe0cb", "src_set": ""}, "body": "やこ様、はじめまして！イラストを拝見して素敵な絵柄に惹かれました。\n当方の創作キャラ二人をリクエストさせていただきたいです！女の子が主導権を握っている、少女と青年のコンビです。\n資料のように二人がくっついていたり首輪を引いている構図でお願いしたいですが、描きやすいように描いていただければ幸いですので、違う構図でも大丈夫です。服装の指定はありません(長袖の服が基本衣装になります！)。\n使用用途としましては、個人鑑賞用のグッズなどを想定しております。\n受けるのが難しい場合や、不備・金額不足などありましたら、遠慮なくキャンセルまたは再送要請してください。ご検討よろしくお願いいたします！\n\nhttps://drive.google.com/drive/folders/17Z07_uPzTVtPneXVacGSHxZkGz1VBzdE", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@melange_yako/works/28", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2339483, "client_id": 1204429, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/005eaf3c/uploads/origins/0f5dbaf4-9de5-4b80-9e7b-e8f52b227748?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e7036fa8d4f37859688dcb316afc18db", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": 