mpress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=49af845c5f12f38981af3711b45703d1", "src_set": ""}, "body": "まれ先生はじめまして。\n依頼させてください。\n\nライスシャワーが今よりも大人に成長したら…というIFの姿を描いていただけませんか？\n服装やその他のシチュエーションはまれ先生にお任せします。\n\n以上でよろしくお願いします。", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@mare_ma_/works/91", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2480395, "client_id": 3499561, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/4d28419a/uploads/origins/b739ed44-acba-4093-8ac2-1aef0f3b0bf8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b8249fd8cd3ca0a3e68dc9d573312c4e", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/4d28419a/uploads/origins/b739ed44-acba-4093-8ac2-1aef0f3b0bf8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9727b709c6e5696fe698685e81c4d646", "src_set": ""}, "body": "まれ様\n\n初めまして、skebでまれ様の描かれる様々な構図や可愛いお顔のイラストを拝見し、とても魅力的で素敵でしたのでぜひ私のキャラクターも描いていただきたく思いリクエストを送らせていただきました！\n\n\n◇キャラクター雰囲気参考資料\nhttps://drive.google.com/drive/folders/1lmX-j8PewWmzPDEahMNJW-LvbW2JCYxi?usp=sharing\n\n・鎖骨の下にハートの模様があります\n・胸はDカップ程度\n\n\n【リクエスト内容】\n・バニーガール衣装を描いていただきたいです。\n　(網タイツ希望です)\n・構図やポーズなどはお任せいたします。\n・髪型は雰囲気に合うようにアレンジしていただけると嬉しいです。\n\n配信画面やサムネイル画像に使用したいので、頭や髪、上半身が見切れないように描いていただけますと助かります。\n\n\n\n【使用用途】\n・配信画面やアーカイブ\n・SNS(Xなどのアイコンやポスト等)\n・支援サイト(アイコンやサムネイル等)\n・ネットプリント\n\n\n可能でしたら、人物のみのレイヤーを分けたデータをお送りいただけますと幸いです。\n\nご検討のほどよろしくお願いいたします。", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@mare_ma_/works/90", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/c2ba8f7f/uploads/origins/a5c30847-db4b-49bb-9136-1959b4cd82b0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=a1a76659390bd66454ff063b3f78ca0d", "src_set": ""}, "private": true, "genre": "art", "tipped": false, "creator_id": 2480395, "client_id": 3353429, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 145, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@mare_ma_/works/89", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2480395, "client_id": 143592, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/5370e61f/uploads/origins/b2fa42f4-98bd-44ad-bc0b-958a6b5e15b1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=919f35142c0ff6ce93fcc320aa611e2a", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/5370e61f/uploads/origins/b2fa42f4-98bd-44ad-bc0b-958a6b5e15b1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=06aa0db8f6c1b41ed4e0fe7ee856b8d2", "src_set": ""}, "body": "募集再開を心待ちにしておりました。\n\n資料URLのうちの子、ニュクスのイラストをお願いします。\nコミッション用のオリジナルキャラクターです。\n表情や構図はお任せでお願いします。\n\n■キャラ設定\n名前：ニュクス\n年齢：17歳　\n職業：冒険者\n種族：魔族ハーフ\n体型：身長150-155cm前後\n性格：物静かでクール系\n見た目に反して身体は頑強だが魔力はそれなり\n\n以上となります。\nご検討の程、宜しくお願いいたします。\n\nhttps://drive.google.com/drive/folders/1DYnmz4KF_-sVx7GK8Ufb6-hjagL0vUDN?usp=sharing", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@mare_ma_/works/88", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2480395, "client_id": 2723888, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/02a6d994/uploads/origins/b408a4c1-af03-4396-8593-fccb3fc6813f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=80cc38f3b0e9233bb424835d93e42ef0", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/02a6d994/uploads/origins/b408a4c1-af03-4396-8593-fccb3fc6813f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=561c4574919b22b191bd61318f8b98b3", "src_set": ""}, "body": "はじめまして。\n\n個人勢Vtuberの雲丹ゐくらと申します。\n\nまれ様のイラストを新着画像にてお見かけし、とても素敵でぜひご依頼させていただきたいと考えておりましたので、 今回リクエストをお送りさせていただきました。\n\n【使用用途 】\n・配信活動全般\n・X等SNS全般への投稿(※オリジナルの透かしを使用して投稿)\n・サムネイル、配信画面内、動画内での使用(使用の際にトリミング等加工をさせて頂く可能性がありますが、原型を留めない程の加工は致しません)\n・メンバーシップ加入者への壁紙配布\n\n想定している使用用途は上記になります。\n\n【希望のポーズ/服装】\n日本海出身のVtuberという設定なので通常の衣装は、マリンセーラーとなっていますが、今回は下記の衣装『着物』スタイルでお願いできればと思います。\n主に飲酒雑談のサムネイルで使用させていただくことになると思うのですが、ポーズなどはお任せ致します。\nhttps://x.com/uniikura_uta/status/1825897868399698379\n\n【構図/差分に関して】\n・サムネイルに使用する可能性があるため、髪の毛と顔周りは見切れていない構図だととても助かります！\n・もし可能であれば表情差分もいただけますと幸いです。\n※サイズ指定が可能であればYouTubeのサムネイルに使用できるものでお願いいたします。\n・納品時にPSDデータにて背景透過されているデータもいただけますと幸いです。\n\n【衣装参考用】\nhttps://x.com/uniikura_uta/status/1889283446541001122\nhttps://x.com/uniikura_uta/status/1823298552623493408\n描写は必須ではないですが、ウニの体にイクラの目をしたサブキャラクターもいます。\n\n【キャラクターテンプレート】\n名前:雲丹ゐくら\n髪色:金髪ハイトーン\nヘアースタイル:前髪重めストレートロング\n目の色:青(海の色)\n通常服装:マリンセーラー\nサブキャラクター:ウニの体にイクラの目をした生き物", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@mare_ma_/works/87", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2480395, "client_id": 3389390, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/2785284e/uploads/origins/4a9012b5-2b63-4714-a91a-66421ca0e782?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a5857e7ad413c1b5b8e916a91288015e", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/2785284e/uploads/origins/4a9012b5-2b63-4714-a91a-66421ca0e782?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur