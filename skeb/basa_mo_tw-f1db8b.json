かさが大好きです。TWSTの絵もハズビンのミニキャラもかわいいですね。\n\nできれば、私のキャラのイービー（♀、白髪、172cm、考古学者）、ソル（♀、茶髪、168cm、パイロット）、アリスター（♂、金髪、190cm、弁護士）を依頼したいです。\n\n私はあなたのシーンイラストがとても好きです。だからこそ、この3人の関係性をあなたの解釈で描いてほしい。ポーズも構図も表情も衣装も自由です！彼らのダイナミックさについての解釈を見てみたいですね。彼らはオクタヴィネルの寮に少し似ています：アリスターは \"ボス \"または \"リーダー\"、イヴィーは \"ブレーン \"または \"アドバイザー\"、そしてソルは \"ワイルドカード\"。彼らはアリスターの法律事務所で一緒に暮らしている。イヴィはアリスターの幼なじみ。ソルは彼らと楽しく過ごしている。\n\nこのリクエストにそぐわなかったり、わかりにくかったりした場合は、遠慮なく却下してください！\n\n本当にありがとうございました。\n\nhttps://drive.google.com/drive/folders/15VbgG5cR2aXoz3CeOlNZA8tCdDLRRHQI", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@basa_mo_tw/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2778573, "client_id": 1377136, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/d264132c/uploads/origins/fd54e997-c6a1-4a70-8b79-a6f8fa13ae8e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9981bc5b04f32bb63b92c598e023cf9a", "srcset": "https://si.imgix.net/d264132c/uploads/origins/fd54e997-c6a1-4a70-8b79-a6f8fa13ae8e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9981bc5b04f32bb63b92c598e023cf9a, https://si.imgix.net/d264132c/uploads/origins/fd54e997-c6a1-4a70-8b79-a6f8fa13ae8e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f6aa3ee23357c3bfb8aa52cb014b6e96 2x, https://si.imgix.net/d264132c/uploads/origins/fd54e997-c6a1-4a70-8b79-a6f8fa13ae8e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=bca13a78963e38cc45366a269792b099 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/d264132c/uploads/origins/fd54e997-c6a1-4a70-8b79-a6f8fa13ae8e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=23a632b74c28737c5c9e4e4b4fd35dcc", "srcset": "https://si.imgix.net/d264132c/uploads/origins/fd54e997-c6a1-4a70-8b79-a6f8