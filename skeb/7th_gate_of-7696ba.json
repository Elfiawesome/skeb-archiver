t%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fcda90fd22406ca3f240e13e78fba564", "srcset": "https://si.imgix.net/5d938d51/uploads/origins/ca7203e8-08c5-47bb-9409-e7c6240da412?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fcda90fd22406ca3f240e13e78fba564, https://si.imgix.net/5d938d51/uploads/origins/ca7203e8-08c5-47bb-9409-e7c6240da412?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=78f3411132c3907977214e924f368e48 2x, https://si.imgix.net/5d938d51/uploads/origins/ca7203e8-08c5-47bb-9409-e7c6240da412?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=756e95f369502722a198cb232f840b0a 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/5d938d51/uploads/origins/ca7203e8-08c5-47bb-9409-e7c6240da412?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f97993f88471792b52981e1fcaf1b4c7", "srcset": "https://si.imgix.net/5d938d51/uploads/origins/ca7203e8-08c5-47bb-9409-e7c6240da412?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f97993f88471792b52981e1fcaf1b4c7, https://si.imgix.net/5d938d51/uploads/origins/ca7203e8-08c5-47bb-9409-e7c6240da412?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=30ada2927d41a7e89cf89473e109f8aa 2x, https://si.imgix.net/5d938d51/uploads/origins/ca7203e8-08c5-47bb-9409-e7c6240da412?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=57455d573e899fd0e3c4c574559e5c65 3x"}, "body": "こんにちは、セブンスゲート！お元気ですか？\n\n他のスケブも拝見しましたが、いつ見ても私の心を溶かしてくれます。とても愛らしく、子供の頃の無邪気さを完璧に表現しています。\nもし無理だったら、遠慮なく断ってください。\n\n私のドラゴンガール https://imgur.com/CVWnVwL を描いていただけませんか？\n年齢は幼児くらいです。\nシチュエーションとしては、寝室で、小さな机に座ってクレヨンで絵を描いているところをお願いします。\n彼女の表情は、純粋に喜んでいるようなもので、 https://skeb.jp/@7th_gate_of/works/2 のようなものです。\n彼女が何を描いているかというと、家族の棒人間を描いている。これらのキャラクターはhttps://files.catbox.moe/noyr04.png。例えば、最終的にはこのようになるhttps://files.catbox.moe/k5tltv.png。\nティールスキンのキャラクターが一番背が高く、馬の女の子が二番目に背が高く、タヌキの女の子が三番目に背が高く、ドラゴンの女の子自身が一番背が低い。\nもし可能であれば、各キャラクターを指す矢印を付けてもらえますか？絵の中のティールスキンのキャラクターは、\"お母さん\"（お母さんでも可）という言葉で彼女を指す矢印を、他の2人は \"姉妹 \"という言葉で彼らを指す矢印を、そして最後に \"私 \"という言葉で自分を指す矢印を。\n\n以上、ご検討のほど、よろしくお願いいたします！", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@7th_gate_of/works/8", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 482946, "client_id": 400854, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/938573cf/uploads/origins/329736e0-1c46-48fb-8f7b-7cbf8d5612f6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=90d6a95d16824fd8afa8de84963cbb00", "srcset": "https://si.imgix.net/938573cf/uploads/origins/329736e0-1c46-48fb-8f7b-7cbf8d5612f6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=90d6a95d16824fd8afa8de84963cbb00, https://si.imgix.net/938573cf/uploads/origins/329736e0-1c46-48fb-8f7b-7cbf8d5612f6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=38f192f46f1948abe9d0b26dbbfd7702 2x, https://si.imgix.net/938573cf/uploads/origins/329736e0-1c46-48fb-8f7b-7cbf8d5612f6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a71750f83d4122b3f90f0f6350c52929 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/938573cf/uploads/origins/329736e0-1c46-48fb-8f7b-7cbf8d5612f6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b60460131373509629b20376c3db9f55", "srcset": "https://si.imgix.net/938573cf/uploads/origins/329736e0-1c46-48fb-8f7b-7cbf8d5612f6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b60460131373509629b20376c3db9f55, https://si.imgix.net/938573cf/uploads/origins/329736e0-1c46-48fb-8f7b-7cbf8d5612f6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=2dddeacc335336e9603c71120e2f8873 2x, https://si.imgix.net/938573cf/uploads/origins/329736e0-1c46-48fb-8f7b-7cbf8d5612f6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=1dd64c6088f3450517b2d2b88470c215 3x"}, "body": "再びリクエストさせて頂きます。\n\n以前描いて頂いたものと同じシリーズで、「料理を作るお母さんの手際の良さを眺める赤毛の女の子」をお願い致します。\n\n大まかな状況としては、「キッチンカウンターの向こうで料理を作るお母さんと、それをカウンター越しに椅子に乗って眺めている女の子」です。\nお母さんは部屋着にエプロン、女の子も同様に可愛らしい部屋着を身に着けており、得意げなお母さんに対し女の子は感心して「わぁ……」と綺麗なものを見るような表情を浮かべる、そんな状況です。\n構図的に難しいかも知れませんが、可能であればクマのぬいぐるみを女の子がおんぶしていて一緒に眺めている（もしくは並んで椅子に乗り女の子に支えられている）……と言った感じでお願いします。\n女の子の表情がメインで、お母さんの髪型などのデザインや表情が見えないような構図でも問題ありません。お母さんは料理中ですので髪の毛を纏めているなども良いと思います。\n\n細かなところはお任せ致します。「料理を作るお母さんの手際の良さを眺める赤毛の女の子」を思い描いた情景で描いて頂ければなと思います。\n\n宜しくお願い致します。", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@7th_gate_of/works/7", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/0f5670d3/uploads/origins/07c845ab-d50c-48e9-ad00-90d1428b1712?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=c7cc3a2568bb0cd4be7ed3876b3244b8", "srcset": "https://si.imgix.net/0f5670d3/uploads/origins/07c845ab-d50c-48e9-ad00-90d1428b1712?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=c7cc3a2568bb0cd4be7ed3876b3244b8, https://si.imgix.net/0f5670d3/uploads/origins/07c845ab-d50c-48e9-ad00-90d1428b1712?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=2a43ea94eeca9f2f1f3d38b826e548b7 2x, https://si.imgix.net/0f5670d3/uploads/origins/07c845ab-d50c-48e9-ad00-90d1428b1712?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=to