24258304%2FfVePk3HB.jpg?blend64=aHR0cHM6Ly9za2ViLWF2YXRhci5pbWdpeC5uZXQvfnRleHQ_&blendalpha=100&blendalign=center&blendmode=normal&blendsize=inherit&bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=813a7b32b817b6188ef03475b4cecd03", "srcset": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1601461588124258304%2FfVePk3HB.jpg?blend64=aHR0cHM6Ly9za2ViLWF2YXRhci5pbWdpeC5uZXQvfnRleHQ_&blendalpha=100&blendalign=center&blendmode=normal&blendsize=inherit&bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=813a7b32b817b6188ef03475b4cecd03, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1601461588124258304%2FfVePk3HB.jpg?blend64=aHR0cHM6Ly9za2ViLWF2YXRhci5pbWdpeC5uZXQvfnRleHQ_&blendalpha=100&blendalign=center&blendmode=normal&blendsize=inherit&bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=37ad7582834e563a99b3d8ccab26d840 2x, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1601461588124258304%2FfVePk3HB.jpg?blend64=aHR0cHM6Ly9za2ViLWF2YXRhci5pbWdpeC5uZXQvfnRleHQ_&blendalpha=100&blendalign=center&blendmode=normal&blendsize=inherit&bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=fd182381a49b0632bcd94d7a902d4ab4 3x"}, "body": "ななきそ様\n\nこんにちは。skebが開いているのを見てどこまでリクエストしていいのか分からず、でもリクエストせずに閉じることができなかったのでメッセージ送らせていただきます。\n\n【短歌】を詠んでいただきたいです。私が短歌の事を学んでないままのリクエストなので失礼があったらすみません。\n以下、リクエスト内容です。\n\n==========\n\n▼リクエスト内容\n短歌をお願いしたいです。\nお題？として、【BL】でお願いしたいです。\n日常であったり特別な場面であったり、無意識・自覚・片思い・付き合ってる・別れた後・幸せなものなどどんなものでも構いません。\n\nもし複数の歌を詠んでいただけたらとても嬉しいですが、一つ(数え方が分からずすみません)でも構いません。\n\n▼使用用途\n・個人鑑賞\n・その短歌で個人的に色々妄想想像したい\n・その短歌を元に、絵や話を金銭の発生しない個人的なものとして書きたい(元になった短歌は自作ではない事を記載します)\n\n==========\n\n偶然ななきそさんのskebが開かれているのを見つけたので、現在募集していなければすみません。依頼内容もあまりに見たいという願望を抑えきれずにお願いしました、無理であればキャンセルしていただいて構いません。\n\n\nななきそさんの短歌が大好きです、シナリオも本当にファンとして大好きです。これからも応援しています。\n\n読んでいただきありがとうございました、良ければよろしくお願いします。", "nc": 129, "word_count": 518, "transcoder": "text", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 23611, "creator": true, "nsfw_acceptable": false, "acceptable": false, "name": "空色ヒカリ🌟", "screen_name": "sukui_hikari", "avatar_url": "https://pbs.twimg.com/profile_images/2029850878052872193/QUtAzeiH.jpg", "header_url": "https://pbs.twimg.com/profile_banners/980886146384248833/1664436674/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 120, "skills": [{"genre": "art"}], "banned": false, "nc": 17}, {"id": 205470, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "吉井徹", "screen_name": "5legDog", "avatar_url": "https://pbs.twimg.com/profile_images/1986395876957573120/05jQ5nHM.jpg", "header_url": "https://pbs.twimg.com/profile_banners/43503173/1737862814/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 15, "complete_expiration_days": 30, "skills": [{"genre": "art"}], "banned": false, "nc": 160}, {"id": 1241182, "creator": true, "nsfw_acceptable": false, "acceptable": false, "name": "井上", "screen_name": "color_ino", "avatar_url": "https://proxy.misskeyusercontent.jp/avatar.webp?url=https%3A%2F%2Fmedia.misskeyusercontent.jp%2Fio%2Fwebpublic-74bf422f-b3be-476a-9e7d-8fccef55b2d6.png%3Fsensitive%3Dtrue&avatar=1", "header_url": "https://media.misskeyusercontent.jp/io/webpublic-38587cf5-4113-47db-a0ff-49a3f09e1c3c.png?sensitive=true", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 120, "skills": [