自由に選んでください）\nhttps://app.box.com/s/8wchmlnu8mmz9308xg3g3big0u7sz642\n\n描いていただいたイラストは、Youtubeの配信用のサムネイルや各種SNS等で使用させていただけると幸いです。\n可能であれば背景とキャラは分けて納品頂けることをお願いしたいです！\n以上、よろしくお願いします！", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@larugo23/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 574224, "client_id": 2358407, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/b0b16e86/uploads/origins/03bb7208-0028-467a-909a-ce8a37e4833c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=104b07c81586eb5eee95846bfdefb51b", "srcset": "https://si.imgix.net/b0b16e86/uploads/origins/03bb7208-0028-467a-909a-ce8a37e4833c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=104b07c81586eb5eee95846bfdefb51b, https://si.imgix.net/b0b16e86/uploads/origins/03bb7208-0028-467a-909a-ce8a37e4833c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=6f6fc224fa1d9e8086f12f8b51f23ded 2x, https://si.imgix.net/b0b16e86/uploads/origins/03bb7208-0028-467a-909a-ce8a37e4833c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=6d8bfbefdfb0888acf5ca2d25169bbd0 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/b0b16e86/uploads/origins/03bb7208-0028-467a-909a-ce8a37e4833c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=1ed87b05f9ea9bed882f78dc78f20dbd", "srcset": "https://si.imgix.net/b0b16e86/uploads/origins/03bb7208-0028-467a-909a-ce8a37e4833c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=1ed87b05f9ea9bed882f78dc78f20dbd, https://si.imgix.net/b0b16e86/uploads/origins/03bb7208-0028-467a-909a-ce8a37e4833c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=60e9727ffb16f787af24d79ab2ae8bb1 2x, https://si.imgix.net/b0b16e86/uploads/origins/03bb7208-0028-467a-909a-ce8a37e4833c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=2c4af31050c1360651b4e58461adc397 3x"}, "body": "はじめまして、アマネと申します。オルセインさんのイラストが世界一好きな者です！！お忙しいところ依頼すみません。\nリクエスト内容は当方の夢主の1枚絵です。何か不都合無ければ画像の形は正方形でお願いします！インスタグラムへの投稿や、アイコンとしての使用をしたいのですがよろしいでしょうか...？\nコテキャシートの都合上御相手様も描かれていますが気にしないでください。誕生日ということで誕生日らしいアイテムを追加してくださると嬉しいです！（そして欲を言えば御相手様のイメージアイテム(葉巻や海軍のマークなど...)も入っていると嬉しいですが版権ではあるので可能な限りで...！）また、コテシにはちょっと笑ったような画像が多いが、普段はあまり笑わない子なので笑わせない、照れさせないで頂けると...！\n色味詳細も沢山書いてますが、オルセインさんの色味が大好きなのでアレンジ自由にしていただいて結構です。服装と構図、背景はおまかせという形でよろしいでしょうか？服装迷われましたら画像参照のもので大丈夫です！！)\nまた、夢主ののイメージカラーがマリンブルーなので、背景など青系統の色を多めに使ってくださると嬉しいです。初めてのスケブ依頼なので何かと不手際ありましたら申し訳ございません。楽しみにしています...！\n\nhttps://photos.app.goo.gl/X49h8dJvPpkRDiTz9", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@larugo23/works/3", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/107cc2af/uploads/origins/e2805a39-ad3e-4e30-a340-3702cebf5047?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=79e9fa741d3339b24584b8afa128b2a3", "srcset": "https://si.imgix.net/107cc2af/uploads/origins/e2805a39-ad3e-4e30-a340-3702cebf5047?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=79e9fa741d3339b24584b8afa128b2a3, https://si.imgix.net/107cc2af/uploads/origins/e2805a39-ad3e-4e30-a340-3702cebf5047?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=e632a1b394f521a2e75c344b20ec10a8 2x, https://si.imgix.net/107cc2af/uploads/origins/e2805a39-ad3e-4e30-a340-3702cebf5047?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&