でペニスも大きく描いてください。\n\nシーン全体を通して、挿入に必要な部分以外はほぼ服を着た状態を維持させてください。\n\n最終コマでは正常位で横たわる姿を描く。恥じらいで顔を覆い、客の精液が長い糸を引いて服を汚している。犬少年自身のペニスからも少量の精液が滴る様子も描写してください。ブリーフとショーツは片足にずり落ちている状態に。\n\n大変お世話になりました。\n\nhttps://drive.google.com/drive/folders/1Um6R4bGUKdi19_I__9M4_V5RRssuEHU8", "nc": 168, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@mayprimavera/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3486135, "client_id": 450719, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/5e72af3d/uploads/origins/382621d5-9374-4e27-aa40-1856bb6c1984?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4af2f1782ae91b2842ced1d27151733f", "srcset": "https://si.imgix.net/5e72af3d/uploads/origins/382621d5-9374-4e27-aa40-1856bb6c1984?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4af2f1782ae91b2842ced1d27151733f, https://si.imgix.net/5e72af3d/uploads/origins/382621d5-9374-4e27-aa40-1856bb6c1984?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=8f6a291f0b2657de6ea5fcf6da477d5a 2x, https://si.imgix.net/5e72af3d/uploads/origins/382621d5-9374-4e27-aa40-1856bb6c1984?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ffdcfe9224b17775eabfd3d501f1be1e 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/5e72af3d/uploads/origins/382621d5-9374-4e27-aa40-1856bb6c1984?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=bffb62c473ac375111ea3f29b3c027d3", "srcset": "https://si.imgix.net/5e72af3d/uploads/origins/382621d5-9374-4e27-aa40-1856bb6c1984?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=bffb62c473ac375111ea3f29b3c027d3, https://si.imgix.net/5e72af3d/uploads/origins/382621d5-9374-4e27-aa40-1856bb6c1984?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit