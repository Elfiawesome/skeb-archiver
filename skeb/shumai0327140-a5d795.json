ge", "creator_acceptable_same_genre": true}, {"path": "/@shumai0327140/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3317176, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/95a8687e/uploads/origins/45da1ab4-da78-4b2e-8232-7b2768d355a9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a27e82232d5988fcf64a557a083b21fc", "srcset": "https://si.imgix.net/95a8687e/uploads/origins/45da1ab4-da78-4b2e-8232-7b2768d355a9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a27e82232d5988fcf64a557a083b21fc, https://si.imgix.net/95a8687e/uploads/origins/45da1ab4-da78-4b2e-8232-7b2768d355a9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=7398851fdbaee6c434334b6e9d8adb10 2x, https://si.imgix.net/95a8687e/uploads/origins/45da1ab4-da78-4b2e-8232-7b2768d355a9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=df23919ed5d555852cb7a7d4c16ce0d1 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/95a8687e/uploads/origins/45da1ab4-da78-4b2e-8232-7b2768d355a9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0fdda628f417283238fb8b4507f68de5", "srcset": "https://si.imgix.net/95a8687e/uploads/origins/45da1ab4-da78-4b2e-8232-7b2768d355a9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0fdda628f417283238fb8b4507f68de5, https://si.imgix.net/95a8687e/uploads/origins/45da1ab4-da78-4b2e-8232-7b2768d355a9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=87b8a6b35934177f4c51bd121f3af0e7 2x, https://si.imgix.net/95a8687e/uploads/origins/45da1ab4-da78-4b2e-8232-7b2768d355a9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=45270a36b8f0ea08289f00592cdf3c6b 3x"}, "body": "こんにちは\nウマ娘プリティーダービーのヒシミラクルちゃんとヴィルシーナちゃんとミホノブルボンちゃん3人の絵をお願いします。\n\n3人の衣装はミホノブルボンちゃんの勝負服ベースのバニーガールの衣装でお願いします。 ただストッキングはオリジナルの勝負服のようにオーバーニーソックスストッキングにしてください\nhttps://imgur.com/qBmOiBK\n\n設定は3人は仲の良い姿で一緒にいて、一人はこちらを見ながら後ろ姿が見える設定にしてください\nhttps://imgur.com/V2enQdN\nhttps://i.imgur.com/kgiitW5.jpg\nhttps://imgur.com/HI6JTV1\n\n3人はお互いに近くにいる構図でお願いし、両側にいる2人の体の方向は真ん中にいる人を向くようにお願いします。\nhttps://imgur.com/kJnrKIt\nhttps://imgur.com/kI0S8Yq\n\nできれば絵の視点は3人を正面から眺めている視点でお願いします。\nhttps://imgur.com/lJfMyjD\nhttps://imgur.com/thlvvmN\n\n3人の体型は可能であればむちむち体型にしてください。\nhttps://imgur.com/NDmPF4G\nhttps://imgur.com/1spO7Aq\n\n背景はなくてもいいです。\n先生の絵が素敵で膝の上とかお尻までは見たいです!", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 37646, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "へびつけぇ", "screen_name": "xyzlvx", "avatar_url": "https://proxy.misskeyusercontent.jp/avatar.webp?url=https%3A%2F%2Fmedia.misskeyusercontent.jp%2Fmisskey%2F3b2449a8-6c21-48fa-85be-b473dc334169.png&avatar=1", "header_url": null, "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "art"}], "banned": false, "nc": 16}, {"id": 723304, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "DENO", "screen_name": "denomina0", "avatar_url": "https://pbs.twimg.com/profile_images/2004221870011568128/WCrF5uoJ.png", "header_url": "https://pbs.twimg.com/profile_banners/108261456/1752332526/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "art"}], "banned": false, "nc": 160}, {"id": 1086907, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name