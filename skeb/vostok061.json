syは柔らかい微笑みでジンを見つめます。また、キッツィーはジンのリュックを抱え、二人ともこちらを向いている。\n\nhttps://drive.google.com/file/d/1nttCcAlwv9MN45gkgikpRzp0UM75BrTK/view?usp=sharing", "nc": 136, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@vostok061/works/13", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/bc2e12a5/uploads/origins/1482e552-db85-49c2-96df-0a3674a886d4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=4d06ce5b59dd6b4b22d859aef2cb65da", "src_set": ""}, "private": true, "genre": "comic", "tipped": true, "creator_id": 2968937, "client_id": 1238441, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 161, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@vostok061/works/12", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/0161ae60/uploads/origins/c4c9f56d-0cc0-4333-a890-cafb5de9026e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=e3f1860ef32a3b5cd50b20c25bfb45d8", "src_set": ""}, "private": true, "genre": "art", "tipped": true, "creator_id": 2968937, "client_id": 1884066, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 50, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@vostok061/works/11", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2968937, "client_id": 0, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/7b5f2dfd/uploads/origins/7fccbea1-65e5-428e-b6bb-74a7a9e09643?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=32a6e55c165d6d731e351c00eeb94b79", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/7b5f2dfd/uploads/origins/7fccbea1-65e5-428e-b6bb-74a7a9e09643?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=038692a128c6042206797afd22c4485a", "src_set": ""}, "body": "ぴちぴちピッチ」のるちあが大きな海蛇に食われるところを描いていただけませんか？まず尻尾から食べられて、尻尾の大部分は口の中に入っていてほしい。大蛇の尻尾が彼女の腕と口に巻き付いていて、彼女がもがいているようにしてください。正確な構図は自由です！\n\n参考文献\nルシア - https://imgur.com/a/zxU81Gu\nウミヘビ - https://imgur.com/a/OrVLPdg", "nc": 32, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@vostok061/works/10", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2968937, "client_id": 3288348, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/3bac6965/uploads/origins/fb65ea20-a704-4adc-8343-35f59a605ad0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d51e5bd82933de9efa5e037bf4394320", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/3bac6965/uploads/origins/fb65ea20-a704-4adc-8343-35f59a605ad0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=76c6dfcb23d7e7ef83e17ba5ea4be832", "src_set": ""}, "body": "こんにちは、私のOCであるキッツィー・キツネにギン（シルバーフォックス）が抱きついているところをお願いします。キッツィーはギンより背が高く、ギンはキッツィーを両腕で包み込み、キッツィーの胸に頭の側面を預けている。ジンは目を閉じ、微笑みを浮かべている。Kitsyは柔らかな愛に満ちた笑みを浮かべながらGinを見下ろしており、Ginの頭を撫でている。\n\nhttps://x.com/KitsyKitsune_VT/status/1852241907071504716", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@vostok061/works/9", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2968937, "client_id": 708359, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/eeadb78d/uploads/origins/