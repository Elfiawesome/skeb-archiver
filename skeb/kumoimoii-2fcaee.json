スをしている。\n服装は基本スーツを着ており、底が厚めの革靴やブーツを履くことが多い。胸元は普段からさらしでつぶしている。自分の過去を知っている人間にバレないための男装。\n\n------\n\n記載URLにキャラクターデザインや詳細資料を貼っております。\nシチュエーションや服装、表情などに関してはお好きに描いていただいて構いません！\n\n情報や金額が足りなければ遠慮なくキャンセル、再送依頼してください。ご検討よろしくお願いします！\n\nhttps://drive.google.com/drive/folders/1Y3Roixg41RXUGxEClNrcB-f6dnAfM1xc?usp=drive_link", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@kumoimoii/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3889509, "client_id": 3977780, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/69495466/uploads/origins/6248d2b0-0de5-47e3-ae23-0db38cb99cfe?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=cc65f53ae7ef1db799e7f2e80c4717d5", "srcset": "https://si.imgix.net/69495466/uploads/origins/6248d2b0-0de5-47e3-ae23-0db38cb99cfe?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=cc65f53ae7ef1db799e7f2e80c4717d5, https://si.imgix.net/69495466/uploads/origins/6248d2b0-0de5-47e3-ae23-0db38cb99cfe?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=791748bf149ccfb866351bb1ae7399bb 2x, https://si.imgix.net/69495466/uploads/origins/6248d2b0-0de5-47e3-ae23-0db38cb99cfe?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a1852543a705e38b7421ea25a0317794 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/69495466/uploads/origins/6248d2b0-0de5-47e3-ae23-0db38cb99cfe?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b8ee657449da2929932ec2db87105c8a", "srcset": "https://si.imgix.net/69495466/uploads/origins/6248d2b0-0de5-47e3-ae23-0db38cb99cfe?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b8ee657449da2929932ec2db87105c8a, https://si.imgix.net/69495466/uploads/origins/6248d2b0-0de5-47e3-ae23-0db38cb99cfe?b