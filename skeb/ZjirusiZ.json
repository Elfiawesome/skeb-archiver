&crop=top&w=200&h=200&s=e07be825703d608330d200523780ebbf", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/0f9744ca/uploads/origins/bbad2a15-010b-465e-ac59-3fa357b4023e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=89ad6c62bc53113242cf5276bcc162a0", "src_set": ""}, "body": "キャラ]\n私のキャラクター\n\n[シチュ]    食肉市場の肉になってしまった。\n[コスチューム] 全裸\n[内容]\n\n私のキャラクターは完全に敗北し、食肉市場に連れて行かれ、肉として売られることになりました。\nこの後のプロセスでは、私のキャラクターが生きているか死んでいるかは、あなたにお任せします。\n1.\n彼女は現在、自分の柔らかさと柔軟性を示すために、強制的に自慰行為をさせられています。\n\n2.\nクライマックスに達した後、または肉質の柔らかくする過程が終わると、彼女はまな板の上に置かれ、切り分けられて販売される準備が整います。人々は彼女が肉の一部として扱われ、触られる中、異なる部位に対して様々な価格を叫んでいます。\n\nhttps://drive.google.com/file/d/1F0T78xNAVmeKPJGOLcZx9RDSShuVX1GK/view?usp=sharing", "nc": 169, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@ZjirusiZ/works/227", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1038506, "client_id": 41021, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/8fec6234/uploads/origins/937f849e-3a04-459f-990c-05c4148d00e2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=aa3e362174000e469af7bbe37af43f65", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/8fec6234/uploads/origins/937f849e-3a04-459f-990c-05c4148d00e2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=fe89a50fcf930a741ceeff03c6dd426d", "src_set": ""}, "body": "キャラ]\n私のPSO2キャラクター\n[シチュ]     敗北剥製\n[コスチューム] 全裸\n[内容]\n1.\n私のチャラの死体が町に持ち帰られた。\n尻尾を掴まれ、体は裸で汗と精液にまみれ、淫らな表情で舌を出している。\n彼女の足と腕は完全にぐったりしている。\n2.\n通行人が観察できるように公共エリアに設置\n彼女の体は剥製として展示され、隣には膣や尻子玉などの器官も展示されています。\n\n淫らな体勢にされて、一般の人が彼女の臓器や体を弄ることができる。\n\n看板には彼女が犯罪者であることなどが書かれていますが、これは彼女が新しいタイプの半人前や怪物であることや、他の理由によるものである可能性もあります。\n彼女の横には衣装や武器が展示され、\n\nhttps://drive.google.com/file/d/12X3vd_FJ6sPtjrUg1PAD-I50lSPUXRD1/view?usp=sharing", "nc": 40, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@ZjirusiZ/works/226", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/e3ba1466/uploads/origins/9fb9b2aa-9ca5-44bd-8585-6ca6b4a1b046?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=2d13186efc77aa17a45b445f9434a818", "src_set": ""}, "private": true, "genre": "art", "tipped": true, "creator_id": 1038506, "client_id": 0, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 57, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@ZjirusiZ/works/225", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1038506, "client_id": 32543, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/b66b88dd/uploads/origins/73c82c4f-36f6-4497-a9ff-df0de5116bd1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2945533af59e272f3b1c2b70d46988c3", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/b66b88dd/uploads/origins/73c82c4f-36f6-4497-a9ff-df0de5116bd1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=42fe882f7aa42304ea4270b6e92c37ef", "src_set": ""}, "body": "https://skeb.jp/@ZjirusiZ/works/215\nこちらのクリスマスリュールちゃんのイラストで差分の追加をリクエストします。\n行為中の男達とリュールちゃん、ストロークの激化、中出し・一斉射精する男達と絶頂を迎えるリュールちゃん、事後の4場面の会話並びに表情と射精差分の追加をお願いします。男達からは神竜サマ呼びでお願いします。\n「初めての冬祭りを楽しむリュールちゃんが一人になった所を男達に襲われる。神竜リュールであると分かり一層喜び勇んで白濁をプレゼントする」という趣旨のあらすじの追加をしてください。\nまたリュールちゃんの胸を更に大きく盛ってください(これまで描いて頂いた大人ベルちゃん並みに)。", "nc": 40, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@ZjirusiZ/works/224", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1038506, "client_id": 41021, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/95ad8c68/uploads/origins/81b17458-3cf8-4ca1-a92d-3fb9cc37a95a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c8ac07a27f1b69e52da87dfb4ea294ff", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/95ad8c68/uploads/origins/81b17458-3cf8-4ca1-a92d-3fb9cc37a95a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a2a0c501d0613eec7713a76fcfd4bd49", "src_set": ""}, "body": "私のチャラは町に帰ろうとするが、門の検査官に止められ、公衆の面前で裸の検査を受けることを強要される。\n\n彼女の体には何もなく、体内にも何も見つからなかったので、彼らは彼女を街に解放するが、装備も衣服も何もなく、今は朦朧とした淫らな発情状態にある。\n\n彼女は見つからずに家に戻らなければならず、物の陰に隠れているところを偶然友人たちに呼び止められ、話をするように強要された。\n\nそこで彼女の裸が発見され、レイプされた。\n\nそしてあっさり捕まって逮捕され、公然わいせつ罪で、彼女は一定時間裸体を晒す刑を言い渡された。\n今後の判決は未定。\n\nhttps://drive.google.com/file/d/1Z9S2wCWwkeBWn_eHiEeTFJcffcYN7VPQ/view?usp=sharing", "nc": 40, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@ZjirusiZ/works/223", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1038506, "client_id": 32543, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/41511829/uploads/origins/1dd50f1e-6b96-47c5-b831-a20a6e27a243?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c2069e3d243510b5a79461eff3a60fc9", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/41511829/uploads/origins/1dd50f1e-6b96-47c5-b831-a20a6e27a243?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=197c32ba6e3ba614b3227ccc9a129b09", "src_set": ""}, "body": "ファイアーエムブレムifからサクラを上級職の戦巫女の衣装でリクエストします。\nhttps://guide.fire-emblem-heroes.com/11002012001213-2/\nhttps://static.wikia.nocookie.net/feheroes_gamepedia_en/images/f/f2/Sakura_In_Full_Bloom_BtlFace_D.webp/revision/latest?cb=20250228050458\n女の子座りの騎乗位で、背後から男に両胸を揉まれながら両手に別々の男の竿を握り片方の竿を咥えてる構図にしてください。\n胸元を破いて元絵よりも二回り大きく立派に成長した胸を晒してください。またスカート部分は結合部がよく見えるように破き、マントは腰辺りまで破いてください。\n巫女服・長手袋・マントを別々のレイヤーに分けて頂けると嬉しいです。\nシチュエーションは白夜王国の第二王女サクラを捕虜にした暗夜王国のマクベス側の兵たちはカムイやマークスらの丁重な扱いの命令を無視し制圧した白夜王国の広場で衆目に晒されながらの陵辱を執り行うという内容でお願いします。\n\nhttps://pbs.twimg.com/media/GkxO7smbgAAAkai?format=jpg&name=4096x4096", "nc": 184, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@ZjirusiZ/works/222", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1038506, "client_id": 128585, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/775d232c/uploads/origins/317fcc97-8ea9-4bda-b733-94b2e0e0ba42?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bb192641db67125a244c1cfc0a643d8f", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/775d232c/uploads/origins/317fcc97-8ea9-4bda-b733-94b2e0e0ba42?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=905a86a27bfa9af4e3bb2583bfcb212a", "src_set": ""}, "body": "連続なりますがまたリクエストを送らせていただきます。\n\nドラゴンクエスト 蒼天のソウラのアズリアで、\nシチュ：第26話で問題を解決後、勇者パーティー達と旅館で温泉に入るというシーツがあるのですが、そのIFでアズリアが一人で温泉に入ると、互いに体を洗いあうのがマナーと言われて体中を揉みしだかれいる。\n\n希望差分：\n展開：1.胸を揉まれる2.乳首を弄られる3.胸と乳首を同時に弄られる4.股を開かされる5.股を弄られる6.甘イキ7.潮吹き\n表情：1.笑顔2.驚き3.発情4.悦び5.トロ顔\n衣装：1.体にタオルを巻いている2.体中泡まみれ3.泡が流されて少なくなっている4.全裸\n\nアズリアの体を弄る相手ですが、作中に登場する5種族でお願いします。\nまた顔の書き込み等はあまり無くて問題ありません。ただ女性的なシルエットでお願いします。\n\n\nよろしくお願いします。", "nc": 56, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "similar_creators": [{"id": 55364, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "きんしゃち", "screen_name": "Q_kinsyachi", "avatar_url": "https:/