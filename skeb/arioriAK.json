886-b34a-77ddb62a0814?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=492dd137a84be47b641d9b22cf820726", "src_set": ""}, "body": "あやさん、こんばんは！Skeb募集再開ありがとうございます。もしよければ、またうちの子のイラストをお願いさせていただけますでしょうか…？\n\n今回はお願いさせていただきたいキャラはオオカミの「ネミィ」です。彼女は警察官で、時々ナイトクラブや牧場でバイトを働いています。性格はちょっと根暗・ドジっ子です。\n\nもしよければ、三つの衣装を着てほしいです。あやさんが描いたこの作品の構図が好きなにで、同じような構図をお願いさせていただきたいです：\n\nhttps://skeb.jp/@arioriAK/works/114\n\nキャラ画像は参考フォルダに添付されています。その他はこの金額で可能な限り全てあやさんにお任せします。\n\nご検討のほどよろしくお願いします！\n\nhttps://drive.google.com/drive/folders/14rOh8TFtMLv1ky3I3qL9luCl0lsr7yHV?usp=sharing", "nc": 176, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@arioriAK/works/124", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/72c30963/uploads/origins/620630bf-776b-4e5a-9dbd-1b0ea9ae76ab?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=725f6b8428bee382e2affa448e7da8c1", "src_set": ""}, "private": true, "genre": "art", "tipped": true, "creator_id": 2720375, "client_id": 0, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 177, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@arioriAK/works/123", "private_thumbnail_image_urls": null, "private": false, "genre": "comic", "tipped": false, "creator_id": 2720375, "client_id": 475186, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/94317bfe/uploads/origins/a576611a-22a6-461a-8185-733f08c0bf5a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b33805f4160969772b6d7e896f432617", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/94317bfe/uploads/origins/a576611a-22a6-461a-8185-733f08c0bf5a?bg=%23fff&auto=for