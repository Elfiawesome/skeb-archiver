のロボ娘（？）の戦い姿です！\n金額に見合わない場合は再送要請か範囲内でして頂ければ幸いです！\n\n【キャラクター】\n「終のステラ」より\nフィリア\n参考画像　https://imgur.com/a/B8JwKz7\n公式サイト　https://key.visualarts.gr.jp/kinetic/stella/#character\n\n「プリマドール」シリーズ　より\n箒星\n参考画像　https://imgur.com/a/miTQOYk\n（無名典礼）公式サイト　https://primadoll.jp/kineticnovel/02/#character\n\n【内容】\n・背中合わせ\n・フィリアは成長した姿で銃を構えている\n・箒星は口元で無線機に向かい、砲撃準備をしている\n・二人とも戦闘服\n・背景は焼け野原（「無名典礼」のメインビジュアルのような町）\n\nご検討のほど、よろしくお願い致します。", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@1230_mochi/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3102679, "client_id": 3188436, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/8aa3a60a/uploads/origins/b741ec55-72df-489e-9252-77495a3acc5d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=641f9068877077e01a1392ed3b82869b", "srcset": "https://si.imgix.net/8aa3a60a/uploads/origins/b741ec55-72df-489e-9252-77495a3acc5d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=641f9068877077e01a1392ed3b82869b, https://si.imgix.net/8aa3a60a/uploads/origins/b741ec55-72df-489e-9252-77495a3acc5d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=380bca6b5b7494a34a8cb146742f6765 2x, https://si.imgix.net/8aa3a60a/uploads/origins/b741ec55-72df-489e-9252-77495a3acc5d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=5cfed2b7c9acb985edee149b0a0ae333 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/8aa3a60a/uploads/origins/b741ec55-72df-489e-9252-77495a3acc5d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a7f112d16d55d972a34b4211c665d6c7", "srcset": "https://si.imgix.net/8aa3a60a/uploads/origins/b741ec55-72df-489e-9252-77495a3acc5d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a7f112d16d5