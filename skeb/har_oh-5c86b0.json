e2f-8a0e-ea44bd6e9307?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=185b5f3ca305b223c53c667938ba95cf, https://si.imgix.net/96aca117/uploads/origins/fce8400c-e2b0-4e2f-8a0e-ea44bd6e9307?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=47948066cd46616d91c47cc61e0b0eb7 2x, https://si.imgix.net/96aca117/uploads/origins/fce8400c-e2b0-4e2f-8a0e-ea44bd6e9307?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ec6e48cb41f71e6aeb4a042eef172937 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/96aca117/uploads/origins/fce8400c-e2b0-4e2f-8a0e-ea44bd6e9307?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=8e792056657d02ad9ed73144850180c3", "srcset": "https://si.imgix.net/96aca117/uploads/origins/fce8400c-e2b0-4e2f-8a0e-ea44bd6e9307?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=8e792056657d02ad9ed73144850180c3, https://si.imgix.net/96aca117/uploads/origins/fce8400c-e2b0-4e2f-8a0e-ea44bd6e9307?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=28e5f8a70c0e785d6cd160980dd620aa 2x, https://si.imgix.net/96aca117/uploads/origins/fce8400c-e2b0-4e2f-8a0e-ea44bd6e9307?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=8c6a90c1de7d3aedfc0ae7d5123e330e 3x"}, "body": "私の忍者少年キャラ、ミストとレイヴンを描いていただけませんか？参考資料は下記リンク先のフォルダに添付しています。\nオレンジ色のミストは比較的穏やかで口数の少ない性格で、青色のレイヴンは外向的でやややんちゃな性格です。二人は幼い頃からバトルパートナーです。\nそんな彼らがお互いに射精我慢の練習をしている様子を、短いカラー漫画で描いていただけたらと思います。手コキ、フェラチオ、チンコ揉み（兜合わせ）、アナルセックスが含まれるかもしれません。\nありがとうございました。\n\nhttps://drive.google.com/drive/folders/1QBrm3u6P2jLlAwK3lKpkJ57MRLH-T4zf?usp=share_link", "nc": 56, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@har_oh/works/10", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2084344, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/7ef65a25/uploads/origins/d05aae35-67f2-4817-bd2b-4cd6bf94eecc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9db8d2a8d45acc44efa489adef559b90", "srcset": "https://si.imgix.net/7ef65a25/uploads/origins/d05aae35-67f2-4817-bd2b-4cd6bf94eecc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9db8d2a8d45acc44efa489adef559b90, https://si.imgix.net/7ef65a25/uploads/origins/d05aae35-67f2-4817-bd2b-4cd6bf94eecc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=4dd679424d1ea55374ce1c3d434a6bd3 2x, https://si.imgix.net/7ef65a25/uploads/origins/d05aae35-67f2-4817-bd2b-4cd6bf94eecc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=2c2af2592cf877a6bf6f77bef1da23be 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/7ef65a25/uploads/origins/d05aae35-67f2-4817-bd2b-4cd6bf94eecc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b9ad6b614bddce9f6736ff0ca0b885bb", "srcset": "https://si.imgix.net/7ef65a25/uploads/origins/d05aae35-67f2-4817-bd2b-4cd6bf94eecc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b9ad6b614bddce9f6736ff0ca0b885bb, https://si.imgix.net/7ef65a25/uploads/origins/d05aae35-67f2-4817-bd2b-4cd6bf94eecc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=de8083f3a7fe6dff24dae8ca9ab4b5b6 2x, https://si.imgix.net/7ef65a25/uploads/origins/d05aae35-67f2-4817-bd2b-4cd6bf94eecc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=1e0179021dccf8c09d7434f9efa948a5 3x"}, "body": "ドラゴン×少年+青年でリクエストをお願いします。\n街で少年や青年を肉鎧にしたドラゴン達が平和に暮らしてる。\n少年や青年達は何か叫んだり喘いだり声を上げてるけど全部「■■■！」や「■■■■？！」でドラゴン達には全く通じてないし、気にもしてない。\nドラゴンのデザインは二足歩行で翼があり、体格が良く筋肉質。\n\n設定としてはドラゴン達は成人すると肉鎧を着ける風習がある。\n肉鎧にする人間は街で購入したり、街の外で捕まえたり。\n裕福なドラゴンは肉鎧に装飾品を着けたり複数持ってたりする。", "nc": 169, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@har_oh/works/9", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2084344, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/104af38b/uploads/origins/e6abfd3d-322a-444b-a21b-10450a053bae?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6ffaa83b83ce6e1ee6868a5c92ecd357", "srcset": "https://si.imgix.net/104af38b/uploads/origins/e6abfd3d-322a-444b-a21b-10450a053bae?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6ffaa83b83ce6e1ee6868a5c92ecd357, https://si.imgix.net/104af38b/uploads/origins/e6abfd3d-322a-444b-a21b-10450a053bae?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c141ffc50f7e645243f95f2744f6509d 2x, https://si.imgix.net/104af38b/uploads/origins/e6abfd3d-322a-444b-a21b-10450a053bae?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=7e60e013d9438866a6d24041c50d9cc4 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/104af38b/uploads/origins/e6abfd3d-322a-444b-a21b-10450a053bae?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=4c601a882399aa458bd0b967bf102554", "srcset": "https://si.imgix.net/104af38b/uploads/origins/e6abfd3d-322a-444b-a21b-10450a053bae?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=4c601a882399aa458bd0b967bf102554, https://si.imgix.net/104af38b/uploads/origins/e6abfd3d-322a-444b-a21b-10450a053bae?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=4fa2cdacf91ab0500ce07b9d003f6004 2x, https://si.imgix.net/104af38b/uploads/origins/e6abfd3d-322a-444b-a21b-10450a053bae?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=e86d6cd69a26739f06c90aa77f7f10d7 3x"}, "body": "前回も素敵な作品をありがとうございました！\n続いてリクエスト致します\nご検討のほどよろしくお願いします\n\nキャラ\n同人誌「教育（済）」のリョウくん（自我を失う前の元気な姿）\n\n大まかな流れ\n父親の会社の経営難で資金援助のおじさんの家へ\nそこのおじさんの息子（リョウくんと同い年、セリフのみ描写）\n彼はへそ好きでリョウくんのおへそを調教します\n\n\n構図\n今回は希望の形式としてモノクロで構いませんので漫画形式だと嬉しいです\n\nストーリーに可能であれば入れてほしいポイント\n・へそ調教によるリョウくん（奴隷役）とおじさんの息子（ご主人様役）という主従関係\n・リョウくんの服装はマイクロビキニ\n・へそはちょっとでべそ気味（リョウくんはでべそ気味なへそはかっこよくないと思っているのでご主人様に謝るシーン）\n・ピンセットで、でべそを引っ張ったりして検査するシーン\n\n父親のために同級生の無茶な変態遊びに懸命にエロく応えるリョウくんを期待します\nリョウくんのセリフにへそやでべそ発言多めだと嬉しいです\n\n今回もご検討宜しくお願い致します", "nc": 57, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@har_oh/works/8", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2084344, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/e4d72ed5/uploads/origins/b5380db7-756a-440a-b53f-5077ca0d8f8c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1d818b65b1205d224ffd51ecf291f6ed", "srcset": "https://si.imgix.net/e4d72ed5/uploads/origins/b5380db7-756a-440a-b53f-5077ca0d8f8c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1d818b65b1205d224ffd51ecf291f6ed, https://si.imgix.net/e4d72ed5/uploads/origins/b5380db7-756a-440a-b53f-5077ca0d8f8c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=df5fdf74ff1d8ba1873f855c9dc8a3fb 2x, https://si.imgix.net/e4d72ed5/uploads/origins/b5380db7-756a-440a-b53f-5077ca0d8f8c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=0833cfc6d813aed366941ad5d82265a2 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/e4d72ed5/uploads/origins/b5380db7-756a-440a-b53f-5077ca0d8f8c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9a9998e9306966a912b49f7b03ca5245", "srcset": "https://si.imgix.net/e4d72ed5/uploads/origins/b5380db7-756a-440a-b53f-5077ca0d8f8c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9a9998e9306966a912b49f7b03ca5245, https://si.imgix.net/e4d72ed5/uploads/origins/b5380db7-756a-440a-b53f-5077ca0d8f8c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=1c0dd3bbbd64629102c69a9550fe0f63 2x, https://si.imgix.net/e4d72ed5/uploads/origins/b5380db7-756a-440a-b53f-5077ca0d8f8c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=88cd68775daf12c70e939d141583a7af 3x"}, "body": "こんにちは\nOCの蘇芳巴くんがとても可愛く、下記リクエストをお受けいただけましたら幸いです。\n公園のトイレで用を足そうとしている同年代位のショタの隣で暑がり汗を拭うような素振りでシャツを上げ、大きな乳首と乳輪を凝視されてドキドキしながら下半身が反応してしまう巴くん。\nとっくに用を足し終えたのにその反応とぷっくりとした胸から目が離せずつられて大きくなってしまった男の子を見て、少し躊躇いながらも服を脱ぎ、乳首と乳輪を触りながら痛いくらいに勃起したモノを扱き始め、見られながら果ててしまう巴くん\nといったイメージでお願いできますでしょうか。\n\n描いていただくキャラクターは巴くんだけでも問題ございません。\n\nご一考いただけますと幸いです。", "nc": 41, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@har_oh/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2084344, "client_id": 75041, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/b20cb11b/uploads/origins/d7451818-21ed-4224-8346-91d72e57060f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ab9d38a4eaa7dc8c283e8912190b9d7c", "srcset": "https://si.imgix.net/b20cb11b/uploads/origins/d7451818-21ed-4224-8346-91d72e57060f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ab9d38a4eaa7dc8c283e8912190b9d7c, https://si.imgix.net/b20cb11b/uploads/origins/d7451818-21ed-4224-8346-91d72e57060f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=022af7b8bad970513e6c4d70d8e65330 2x, https://si.imgix.net/b20cb11b/uploads/origins/d7451818-21ed-4224-8346-91d72e57060f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=4e472be14b9f93475596498322032dbd 3x"}, "duration": null, "nsfw": true, "har