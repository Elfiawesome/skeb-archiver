00x900  \n \nhttps://pbs.twimg.com/media/GSCWJ-vawAAFDSG?format=jpg&name=900x900\n\n\n突然すみません、何卒ご検討のほどお願いします…。", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@imazine_1720/works/5", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/917c17c4/uploads/origins/9ca013b1-4dc8-4131-807f-37f46e88f023?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=a434de7a6102e00ea729e79bf3ce47ae", "src_set": ""}, "private": true, "genre": "art", "tipped": false, "creator_id": 410734, "client_id": 1663506, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 16, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@imazine_1720/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 410734, "client_id": 2368246, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/221e7c61/uploads/origins/57c29ada-3be7-4d94-aa3a-8d4891a869cc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=295f6b1bc9b774cf338163a9a54989b8", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/221e7c61/uploads/origins/57c29ada-3be7-4d94-aa3a-8d4891a869cc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=634bca07d05f2872e0065db023555446", "src_set": ""}, "body": "チキンです！\n以下、希望内容です！\nキャラクターの年齢層　20歳前後の若者\n性別　男\n髪型　オルショートっぽい感じで\n髪色　黒髪でメッシュで茶を少し入れ\n身長　165くらい\n\n服装　カジュアルな雰囲気のパーカーファッション\n上は大きめのダボっとしたネイビーのパーカー、下が薄めのベージュのパンツ\n靴はグリーンのスニーカー、靴下は白\n\n備考　パーカーの背中と左袖口にマークをつけてもらいたいです\n背中にはチキンから取って鳥のマーク、左袖口はマキオンでセブソ使いなので剣が複数本刺さってるマーク", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@imazine_1720/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 410734, "client_id": 1092473, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/773ebba6/uploads/origins/227f0007-9199-40fb-80ec-fff73aa13b5b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8fff428dd0da154c7bf329e6055d6567", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/773ebba6/uploads/origins/227f0007-9199-40fb-80ec-fff73aa13b5b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a7cdd0bb4f91f7af3900bf5ed6981d45", "src_set": ""}, "body": "今回お願いしたいのは、Vtuber（個人＆チャンネル収益化済）の紅翠きいろさんです。\n\n【使用用途】\n紅翠きいろさんへのプレゼントとなります。\nご本人がTwitterアイコン、ヘッダーや配信前のFA紹介といったVtuber活動で使用する可能性がございます。\n\n【詳細】\n・赤と緑のオッドアイにアホ髪が特徴のVtuberさんです。\n・妹系、中二病、ふわふわといったイメージのキャラクターとなります。\n・構図等はお任せとなります。\n・Twitter上にツイートする際は、「#紅翠きいろ」、「#きいろちゃん描いたばい」のタグを付けて頂けると嬉しいです。\n・お絵描き配信をよくされているので、お絵描きしているきいろちゃんをお願いします。\n・宛名と人物のレイヤーが分かれている状態のPSDで頂きたいです。\n\n【参考資料】\n紅翠きいろさん\nhttps://twitter.com/aka_sui_kiiro/status/1390767105067290625\n\nお忙しいところ大変恐縮ですが、ご検討のほどよろしくお願いいたします。", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@imazine_1720/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 410734, "client_id": 425230, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/a4ca1d31/requests/189809_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7f681eea3554d7c43f24a31e36b5cd4f", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/a4ca1d31/requests/189809_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3f75817146bc7aeae3649e9b050a46a6", "src_set": ""}, "body": "初めまして。\n私がゲームで使用しているキャラを描いていただきたく依頼しました。\n\n・怪異(吸血鬼など)を滅ぼす存在\n・武器は斧などの重量武器(武器は自由)\n・図書館、遺跡などの歴史がありそうな場所\n・辛い過去がある存在なのですが、ドジなので料理を失敗したりします(オマケ設定)\n上記のイメージを元にして、怪異ハンターぽいイラストを描いていただけたらと思います。\n\nhttps://drive.google.com/drive/folders/1dqZrqfQph4bRUhwo6JgnRFO6tbW0KKbt?usp=sharing", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@imazine_1720/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 410734, "client_id": 81118, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/f2ec972a/requests/171391_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=09e323da7c8a6627e632f5fcd4435288", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/f2ec972a/requests/171391_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b1a0e686874164b0aaf033ea66a4ed2f", "src_set": ""}, "body": "初めまして！pixivで作品をお見掛けし、可愛らしい画風が好みだったのでリクエストさせていただきたく思います！\n\napexの武器、「ウィングマン」を片手に持ってドヤ顔を決めているシンフォギアのクリスちゃんをお願いしたいです。\n胸の大きさは大き目にで、強調された形に描いていただけると嬉しいです。\n\n是非ご検討よろしくお願いいたします！", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "similar_creators": [{"id": 1228629, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "メ・バヂス・バ名言bot", "screen_name": "GRONGIKBTIT", "avatar_url": "https://pbs.twimg.com/profile_images/1779803760140955648/6JwJposC.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1736000677133119488/1732719093/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "skills": [{"genre": "art"}], "nc": 128}, {"id": 1546706, "creator": true, "nsfw_acceptable": false, "acceptable": false, "name": "Lead", "screen_name": "osanpogakari", "ava