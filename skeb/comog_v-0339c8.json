をされてしまう感じになります\n美柑は「リトなの！？リトだよね！？」と必死で声をあげるも\n男は無言で、そのまま挿入・中出しされてしまう流れでお願いします\n\n男はリトかも知れませんし\n謎の侵入者かも知れません\nそこらへんはどっちとも取れる感じの描写をお願いします\n\nシチュエーション等、好みに合わない場合は依頼内容再検討しますのでキャンセルしてしまって大丈夫です\n\n以上、ご検討お願い致します", "nc": 169, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@comog_v/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2865658, "client_id": 1620492, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/f9ab9f3d/uploads/origins/89e07008-5aea-4a85-959a-f5164edb8b1b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f4042058b62f9ee7a8056248806c2ba3", "srcset": "https://si.imgix.net/f9ab9f3d/uploads/origins/89e07008-5aea-4a85-959a-f5164edb8b1b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f4042058b62f9ee7a8056248806c2ba3, https://si.imgix.net/f9ab9f3d/uploads/origins/89e07008-5aea-4a85-959a-f5164edb8b1b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=0776b5caba7b0e81010913b7883488cb 2x, https://si.imgix.net/f9ab9f3d/uploads/origins/89e07008-5aea-4a85-959a-f5164edb8b1b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=5b4346c9b9f086829b4309b2cd1d7a58 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/f9ab9f3d/uploads/origins/89e07008-5aea-4a85-959a-f5164edb8b1b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e419772808d9597bf0b05c8aa3a0c6d0", "srcset": "https://si.imgix.net/f9ab9f3d/uploads/origins/89e07008-5aea-4a85-959a-f5164edb8b1b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e419772808d9597bf0b05c8aa3a0c6d0, https://si.imgix.net/f9ab9f3d/uploads/origins/89e07008-5aea-4a85-959a-f5164edb8b1b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=62468b146b34217c38f4b