c0-4a08-4c3f-8f8e-a18e3350c19c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=4da2fbe3f1c0bd1278c48ee28c58ff1a", "srcset": "https://si.imgix.net/453dd89c/uploads/origins/80adaac0-4a08-4c3f-8f8e-a18e3350c19c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=4da2fbe3f1c0bd1278c48ee28c58ff1a, https://si.imgix.net/453dd89c/uploads/origins/80adaac0-4a08-4c3f-8f8e-a18e3350c19c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=da81c57f6871e7b85420e03fc9b3b439 2x, https://si.imgix.net/453dd89c/uploads/origins/80adaac0-4a08-4c3f-8f8e-a18e3350c19c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=9d12e045166df5a50dcc8927423bcff3 3x"}, "body": "Hello, thank you for your appeal. My character is a nekomimi female with rose pink hair and light teal eyes. Feel free to draw her any way you like.", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@eokakusakana/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2570217, "client_id": 1383730, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/7aa1a4db/uploads/origins/f19bca16-deec-4f37-9090-4767af9f13e7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=45190e2ab9164713f283ba629cfc5395", "srcset": "https://si.imgix.net/7aa1a4db/uploads/origins/f19bca16-deec-4f37-9090-4767af9f13e7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=45190e2ab9164713f283ba629cfc5395, https://si.imgix.net/7aa1a4db/uploads/origins/f19bca16-deec-4f37-9090-4767af9f13e7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=183e12dc95e9e007923732fbaf6d4628 2x, https://si.imgix.net/7aa1a4db/uploads/origins/f19bca16-deec-4f37-9090-4767af9f13e7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=4f6ec1ac8b5f6b51461abb45650a43dd 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/7aa1a4db/uploads/origins/f19bca16-deec-4f37-9090-4767af9f13e7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6bbecf444b48cadd7c59b3c4bcfe7621", "srcset": "https://si.imgix.net/7aa1a4db/uploads/origins/f19bca16-deec-4f37-9090-4767af9f13e7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6bbecf444b48cadd7c59b3c4bcfe7621, https://si.imgix.net/7aa1a4db/uploads/origins/f19bca16-deec-4f37-9090-4767af9f13e7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=7c1bb8c0350de5f26538aea8be07d789 2x, https://si.imgix.net/7aa1a4db/uploads/origins/f19bca16-deec-4f37-9090-4767af9f13e7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=7ab80ef7d56be1b57633f19728c64bd4 3x"}, "body": "Hello, Mr. Ryomori.\nI am Jasuma, the person who greeted you.\n\nThank you for liking my self-created character, Haofi!\n\nI have seen your past pictures, Ryoumori-sama. I found your illustrations of the Star Rail character, the ghost child, and the girl with the eye patch very cute and attractive in their patterns, so I would like to make a request for them!\n\nAs you suggested in your message, I would like to leave the costume design to Mr. Ryoumori this time..!\n\nThe material of Haofi is here.\nhttps://note.com/psyan75_17_ra/n/n2199d76dc144\n\n\u25a0Character Introduction\nHaofi is a former human zombie and necromancer.\nHe chose to become immortal by his own self-discipline in order to be close to the ghost of his best friend, who was no longer able to go to heaven or hell.\nSince he became a zombie by his own will, his heart is still alive and spiritual energy is circulating in his body instead of blood. This is why he is so hot-blooded that it is hard to believe that he is a zombie.\n\nHe uses frying pans and ladles heated with Hitodama, which are always floating around him, as weapons and has a fighting style that combines Hakkyoken (sometimes Drunken Fist) and also uses the sacred talismans on his thighs to control Kyongshi.\n\nHis favorite food is fried rice, which he punishingly stir-fries with a stranger's human head, but otherwise he is a hot-blooded but sensible person.\n\n\u25a0Exterior Characteristics\nHe has white hair in a bun, with seven colors of light reflecting in his hair. In the current design, he has two aphids.\n\nShe has expressive type of jitters, and her eyes are golden by default, but they turn into odd eyes when the tension is high. There is pink makeup on the corner of her eyes.\n\nShe has blue skin with stitches on her cheeks, left arm and right leg. Her right leg is a little darker.\n\nBased on the above character description, I would be happy if you could draw Haofi in the new outfit that Ryoumori-sama has in mind!\n\nIf there are no flaws in your request, please let us know!", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@eokakusakana/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2570217, "client_id": 2609965, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/fd9d8f2f/uploads/origins/22aa4eaa-908b-4163-a413-f0b0157f29dc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c4285d35c19d929f045c2eae497d0afb", "srcset": "https://si.imgix.net/fd9d8f2f/uploads/origins/22aa4eaa-908b-4163-a413-f0b0157f29dc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c4285d35c19d929f045c2eae497d0afb, https://si.imgix.net/fd9d8f2f/uploads/origins/22aa4eaa-908b-4163-a413-f0b0157f29dc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=5912436f2100b70773c67959515241fe 2x, https://si.imgix.net/fd9d8f2f/uploads/origins/22aa4eaa-908b-4163-a413-f0b0157f29dc?bg