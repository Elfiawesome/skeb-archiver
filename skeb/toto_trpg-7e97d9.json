の絵を描いて欲しいです。\n\nHO2は銭形ルゥ\n・髪は青～水色～黄色のグラデ（星空のようにハイライトがキラキラしている）\n・目は満月のような金、真ん中にうさぎのシルエット有\n・警察官、元気で色々と奔放\n\nHO4のはウォルト・サンタマリア\n・髪の毛は赤紫(グラデーション)\n・ピアスは十字架\n・瞳は黄色で瞳孔は縦長(猫のような)\n・大きく口を開けて笑う\n\nビジュアルに関してはURLから参考にしてください\n\nサンルゥをどうぞよろしくお願いいたします！\n\nhttps://drive.google.com/drive/folders/1COht8NrE4knRmIRCBGn5GJZtit2U332q?usp=sharing", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@toto_trpg/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 618541, "client_id": 1082248, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/c13e9c3c/uploads/origins/f371f8ab-3c95-4ee3-a874-3d5336262846?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6db99816bf1bac41bcbf5fceb5aed0d4", "srcset": "https://si.imgix.net/c13e9c3c/uploads/origins/f371f8ab-3c95-4ee3-a874-3d5336262846?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6db99816bf1bac41bcbf5fceb5aed0d4, https://si.imgix.net/c13e9c3c/uploads/origins/f371f8ab-3c95-4ee3-a874-3d5336262846?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=efd508fa66cbcd07208d47c5deb9430f 2x, https://si.imgix.net/c13e9c3c/uploads/origins/f371f8ab-3c95-4ee3-a874-3d5336262846?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=21ea07d73a3213e27c203d930d283320 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/c13e9c3c/uploads/origins/f371f8ab-3c95-4ee3-a874-3d5336262846?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=cac9526ac7b2ebce73b7f1b71655d183", "srcset": "https://si.imgix.net/c13e9c3c/uploads/origins/f371f8ab-3c95-4ee3-a874-3d5336262846?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=cac9526ac7b2ebce73b7f1b71655d183, https://si.imgix.net/c13e9c3c/uploads/origins/f371f8ab-3c95-4ee3-a874-3d