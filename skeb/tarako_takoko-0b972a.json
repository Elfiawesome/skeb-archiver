小さな鎧を見せているのと同じようなもの、彼女の体のラインをセクシーに包み込み、露出度の高い素敵なラテックスがいいでしょう（参考資料6ゼスト）。でも、彼女のお腹が見えるようにしてください。でも、彼女の布については自由に創造してください^^。\n\n- また、女の子の尖った耳をつけてください（参考資料4）。\n\n- ドローイングは、彼女の全身を前と後ろから描いたキャラクタープロフィールで、下にはいくつかの顔の参考資料を入れてください。\n\nhttps://imgur.com/a/QM3sf9h", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@tarako_takoko/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1668759, "client_id": 1805021, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/5375a47e/uploads/origins/61cb13ef-c97a-48e3-86fd-e5fb0c840910?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=818a4bfdac5c3e0b967abfe3452faaba", "srcset": "https://si.imgix.net/5375a47e/uploads/origins/61cb13ef-c97a-48e3-86fd-e5fb0c840910?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=818a4bfdac5c3e0b967abfe3452faaba, https://si.imgix.net/5375a47e/uploads/origins/61cb13ef-c97a-48e3-86fd-e5fb0c840910?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=bfd6e1ad81961ab34c9627110281ba6c 2x, https://si.imgix.net/5375a47e/uploads/origins/61cb13ef-c97a-48e3-86fd-e5fb0c840910?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=70519c75a54d8ed3e297b2bcbf4f17a7 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/5375a47e/uploads/origins/61cb13ef-c97a-48e3-86fd-e5fb0c840910?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=00962339ff90baa33d1c70414e331f6d", "srcset": "https://si.imgix.net/5375a47e/uploads/origins/61cb13ef-c97a-48e3-86fd-e5fb0c840910?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=00962339ff90baa33d1c70414e331f6d, https://si.imgix.net/5375a47e/uploads/origins/61cb13ef-c97a-48e3-86fd-e5fb0c840910?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&c