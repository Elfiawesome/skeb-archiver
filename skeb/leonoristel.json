生\n\n先日はうちの娘をえっちに描いていただきありがとうございました！！！！\n差分もいただけてたくさん楽しませていただきました！\n今回もまたくろむ先生にヴェールちゃんを描いていただきたいと思いご依頼させていただきました。\n\n\n〈キャラクター〉\nケモ改変ヴェールちゃん\nhttps://drive.google.com/drive/folders/1fNBcxXHKXYLtzD2KbvusSG_4oOxVesTe\n\n〈内容〉\n・交尾結合で動物に犯されてるシチュエーション\n・動物側の描写は、犯しているのが動物と分かれば大丈夫なので下半身だけとかでも大丈夫です。\n・ちんぽは、亀頭球のある犬ちんぽでお願いします。\n・アングルは、真横ではなくやや斜め前からでお願いします。下記の資料のようなアングルをイメージしてます。\nhttps://drive.google.com/file/d/1v2LaCIJII4OJHi876mQpNzuNj9iaiLj_/view?usp=drivesdk\n\n・可能であれば、射精前と射精後(お腹はボテ腹にして、床に水溜まりができる程度に精液が溢れている)の差分を描いていただきたいです。厳しい場合は、射精後の描写を優先して欲しいです。\n・断面図も描いていただきたいですが、結合部に透かす形ではなく別スペースに描く形で描いていただきたいです。\n\n・それ以外の服装や構図の細かい部分はお任せいたします。\n\nやや複雑なご依頼になってしまいましたが、ご検討のほどよろしくお願いします！", "nc": 169, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@leonoristel/works/102", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/0642416e/uploads/origins/c5217513-dc78-42e7-a622-c2ccb0505625?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=343113e88ad49b291af7eff494187cb1", "src_set": ""}, "private": true, "genre": "art", "tipped": true, "creator_id": 22541, "client_id": 3452353, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 176, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@leonoristel/works/101", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 22541, "client_id": 2387244, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/59162575/uploads/origins/80c95da3-36d6-4bd7-b989-f26792aced07?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=aa59f26ea21e4dc7ff2c8f8e9b3dffde", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.