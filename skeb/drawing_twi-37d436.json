様なイメージです。\n\nベッドの上におまたを広げて仰向けになっている感じで手は力なくバンザイしている様なポーズでお願いします。\n服装は普段の黒いフレンズ服から手袋と靴下だけ付けていて、表情は嫌がりながらも真っ赤に紅潮して涙目になりながら快感に歪んでいる感じを希望します。\n過去に描かれているカワラバトちゃんの依頼の様なアングルで、竿役も下半身と手だけ見えているイメージでお願いします。\n竿役の手はブラックサーバルちゃんの手首をつかんでベッドに押し付けている感じでお願いします。\n\n細かい指定は可能な範囲で大丈夫です、よろしくお願い致します。", "nc": 49, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@drawing_twi/works/10", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1253232, "client_id": 966991, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/7fe791a6/uploads/origins/13f888dc-77c2-43cc-b38e-bd5fb7275098?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0f031910b512fa9db8bc51a3182c9c1d", "srcset": "https://si.imgix.net/7fe791a6/uploads/origins/13f888dc-77c2-43cc-b38e-bd5fb7275098?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0f031910b512fa9db8bc51a3182c9c1d, https://si.imgix.net/7fe791a6/uploads/origins/13f888dc-77c2-43cc-b38e-bd5fb7275098?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=abeede41a4ea616ef1c30085d7140156 2x, https://si.imgix.net/7fe791a6/uploads/origins/13f888dc-77c2-43cc-b38e-bd5fb7275098?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=0553f81e7c6a0bcf1191057925af69cd 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/7fe791a6/uploads/origins/13f888dc-77c2-43cc-b38e-bd5fb7275098?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=29a5c5e4a103753edd8681ee13cca2c9", "srcset": "https://si.imgix.net/7fe791a6/uploads/origins/13f888dc-77c2-43cc-b38e-bd5fb7275098?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=29a5c5e4a103753edd8681ee13cca2c9, https://si.imgix.net/7fe791a6/uploads/origins/13f888dc-77c2-43cc-b38e-bd5fb7275098?bg=%23fff&auto=format%2Ccompress&fm=