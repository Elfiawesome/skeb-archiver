c39ec6361c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ded6cf819f6c1d56c8a8ddddf5b9711b 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/d842d821/uploads/origins/2dcc6357-d5af-4bd6-baf5-e4c39ec6361c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=90edc783619fda6321a87549d5e18911", "srcset": "https://si.imgix.net/d842d821/uploads/origins/2dcc6357-d5af-4bd6-baf5-e4c39ec6361c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=90edc783619fda6321a87549d5e18911, https://si.imgix.net/d842d821/uploads/origins/2dcc6357-d5af-4bd6-baf5-e4c39ec6361c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=bc3e555e13f8258a86d59820325dfe2a 2x, https://si.imgix.net/d842d821/uploads/origins/2dcc6357-d5af-4bd6-baf5-e4c39ec6361c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=ad56a572d308465ae448bc3f8c082fdf 3x"}, "body": "前回は越前の依頼ありがとうございました…。\n今回はコミックの方でお願いしたく依頼をさせて頂きました。\n内容は以下のようになります（一応NSFWで依頼しましたので股間が見えたり見えなかったりについてはお任せします）。\n\n\n玲君と安房お兄さんが入浴中誰のお尻が好みかの話題になり、お兄さんが玲君に聞くと食いぎみに備後と即答し穏やかなトーンで熱弁し、お兄さんは真剣に耳を傾ける。\n\nその最中、備後が入浴しに来てちょうどお尻が見える構図になる（二人に気づかず、まだ脱衣所にいる他の男児を早く来るよう呼んでいるような感じ）。\n\nその備後の様子を尊い物を見る目で見守る玲君とスイッチが入ってスキンシップ（意味深）をしようと近づくお兄さん。\nそして二人に気づいた備後が二人の目が色々な意味で怖いと怯える。 \n\n\n\nもし可能であればよろしくお願いします。", "nc": 33, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@umazurra_/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3263690, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/c8669993/uploads/origins/7f63a285-7f27-4e54-830d-3f277eefcdc1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=abf65559b75ace4830b4a15fcc70a06d", "srcset": "https://si.imgix.net/c8669993/uploads/origins/7f63a285-7f27-4e54-830d-