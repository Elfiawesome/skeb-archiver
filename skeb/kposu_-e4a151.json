fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=9553c26699a3888ee113695240abb586 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/ee144c6e/uploads/origins/d6f57565-551d-48b2-9df4-da9af126cffa?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=338b094e15cd93e9383a2f8d47c25199", "srcset": "https://si.imgix.net/ee144c6e/uploads/origins/d6f57565-551d-48b2-9df4-da9af126cffa?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=338b094e15cd93e9383a2f8d47c25199, https://si.imgix.net/ee144c6e/uploads/origins/d6f57565-551d-48b2-9df4-da9af126cffa?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=9f9ecea77906cd304e5070e5b169894a 2x, https://si.imgix.net/ee144c6e/uploads/origins/d6f57565-551d-48b2-9df4-da9af126cffa?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=fde50cbf77c958110bbbb4ff03cf2639 3x"}, "body": "かぽす様初めまして。\n\nかぽす様のイラストがすごく素敵で今回リクエスト送らせていただきました。\nぜひ活動垢で活動している姿をお願いしたいです。\n\n◆資料について\n→まだ三面図がありませんのでキャラクターデザイン資料と立ち絵、表情、キービジュアルとなります。\n(性別は女の子です)\n\n◆構図\n可能であれば横長でゲーム部屋っぽい感じだと嬉しいです。\n服装や髪型はかぽす様のお好みの感じでお願い出来れば幸いです！\n\n◆使用用途について\nVTuber活動（XやDiscordのアイコン、サブ限鯖での公開、スタンプ）で使用します。\nその旨をご了承いただけましたら幸いです。\n\n◆その他\n可能であればレイヤー別にしたPSD形式でお願いできれば幸いです。\n難しい場合はPNG形式での納品をお願い致します。\n\nよろしくお願いいたします。\n\nhttps://drive.google.com/drive/u/1/folders/1ZtzHOFiPa8SVhtKKeLW2kzCyGvtHKeiU", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@kposu_/works/9", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3573920, "client_id": 990790, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/71276736/uploads/origins/c9cd9cbe-0dc3-4ebb-a104-fa4b7adf7e11?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3d84ff91c334500324c2754647f03a9a", "