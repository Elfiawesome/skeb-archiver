子なのですが、後ろの壁に天使の翼の影が映っているときに、唇の前に人差し指を立てて「ささやく」ような動作をしているところを描いていただけたら嬉しいです！もしお望みなら、視点を変えて、影にする代わりに、その花の形を一対の翼にすることもできます！\n\nまた、赤い目を閉じて、青い目を開いてカメラを見つめて、ウィンクしているように描いてもらえるとうれしいです！\n\nSNSやストリーミングでの使用もお願いします！ありがとうございました！\n\nhttps://drive.google.com/drive/folders/1HMAdVccqKO1G53stQ1Hhjm8G75OQHQEm?usp=sharing", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@kposu_/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3573920, "client_id": 1176883, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/ab3affc7/uploads/origins/d7ccbd7a-e7bd-4a7d-aecb-34aaea56388a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=35e5a608f2b9586449297236774117e8", "srcset": "https://si.imgix.net/ab3affc7/uploads/origins/d7ccbd7a-e7bd-4a7d-aecb-34aaea56388a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=35e5a608f2b9586449297236774117e8, https://si.imgix.net/ab3affc7/uploads/origins/d7ccbd7a-e7bd-4a7d-aecb-34aaea56388a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=5336df93387e6226dc677132b5629bc6 2x, https://si.imgix.net/ab3affc7/uploads/origins/d7ccbd7a-e7bd-4a7d-aecb-34aaea56388a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=5c7532cc25a469d0587a5f17e9d8808c 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/ab3affc7/uploads/origins/d7ccbd7a-e7bd-4a7d-aecb-34aaea56388a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b3f41ee09d4a632d7130fa2c6d2d3200", "srcset": "https://si.imgix.net/ab3affc7/uploads/origins/d7ccbd7a-e7bd-4a7d-aecb-34aaea56388a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b3f41ee09d4a632d7130fa2c6d2d3200, https://si.imgix.net/ab3affc7/uploads/origins/d7ccbd7a-e7bd-4a7d-aecb-34aaea56388a?bg=%23fff&