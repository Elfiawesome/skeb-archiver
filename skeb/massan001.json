igins/80bf8f8d-b280-49c9-8812-81a3a1500042?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0e0ce47e5937a9eeb3032acaeb4aae34", "src_set": ""}, "body": "はじめまして！ファイアーエムブレムのリンのR18イラストが欲しいです！R18のシーンで、リンは盗賊団に捕まっていて、盗賊団に輪姦されています！\n\nリンのデザインはこちらを参考にしてください。-> https://x.com/athrowaway117/status/1941304526717476876\n\n盗賊団のリファレンスはこちらです。-> https://x.com/athrowaway117/status/1941304055944577234\n\nこのR18のシーンでは、リンは裸にされ、裸足になり、妊娠したお腹になります。\n\nこのR18シーンの背景は、石だらけの地下牢エリアです。\n\nこれは、一人の盗賊がリンの口を犯し、もう一人の盗賊がリンの膣を犯しているこのシーンのポーズリファレンスです。このシーンの構図では、リンの脚と裸足が見えるように、カメラのフレームを下方向に広げたいと考えています。-> https://x.com/athrowaway117/status/1941304370018279553\n\nリンの口を犯している盗賊は右手でリンのポニーテールを強く引っ張り、左手でリンの胸を弄る。リンの後ろにいる盗賊は、リンの腰を両手で強く掴み、ペニスをリンの膣の中に押し込む。両方の盗賊はリンの体内に精液を射精する。\n\nリンの目はこの参考写真のように目隠しされている。-> https://skeb.jp/@massan001/works/276\n\nリンはこのリングギャグを口にくわえている。-> https://x.com/athrowaway117/status/1898458928117371165\n\n最後に、リンは首にこの首輪をしている。-> https://x.com/athrowaway117/status/1941304133786665182\n\nリンは涙を流しながら、手と足でもがきながら泣き、顔を赤らめるだろう。", "nc": 184, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@massan001/works/278", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/dd6f59af/uploads/origins/c082fd52-cfb8-460c-ae3b-7bcd2cb326d1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=b8af6a7c6898ecdf023558f045683cec", "src_set": ""}, "private": true, "genre": "art", "tipped": false, "creator_id": 1313737, "client_id": 761455, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 176, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@massan001/works/277", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1313737, "client_id": 2187065, "v