4-4d38-b104-75a529ae832e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=32b5f3c7ab244efd7dbb24fed7e6912e", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/86f0bce4/uploads/origins/05a88573-ef84-4d38-b104-75a529ae832e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e24f3dfd82caa6307c4e58e51dcc8a7b", "src_set": ""}, "body": "こんにちは。\n私のOCがスライムの集団に襲われて犯されるところを、https://www.deviantart.com/stash/21pzkpx2a96h。彼女の手足をスライムたちに拘束してほしい。スライムたちは彼女の胸を吸ったり包んだり、何匹かは彼女の口や喉に入ってほしい。また、彼女は服を着ているが、破れたり溶けたりして欲しい。\nありがとう。\n\nhttps://www.deviantart.com/stash/21zpdot259qh 彼女の髪の毛は赤い方です。", "nc": 57, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@massan001/works/266", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/8ae25933/uploads/origins/782df789-faca-4352-9e86-2807fffc112c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=a90fdea0daa1054634a92479235c0553", "src_set": ""}, "private": true, "genre": "art", "tipped": true, "creator_id": 1313737, "client_id": 0, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 176, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@massan001/works/265", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/ad055b69/uploads/origins/a385e6e8-08ae-4c40-8ca2-a83a31eae1ca?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=ebd1c0576c2b9e004947c7fb774ba7be", "src_set": ""}, "private": true, "genre": "art", "tipped": true, "creator_id": 1313737, "client_id": 2235683, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 176, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@massan001/works/264", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/15b1aaaa/uploads/origins/939e64f2-4bd2-431a-9ad8-4aa817603a00?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=c17566c5fd3e6b448a28cd9107756c4f", "src_set": ""}, "private": true, "genre": "art", "tipped": true, "creator_id": 1313737, "client_id": 0, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 33, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@massan001/works/263", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1313737, "client_id": 0, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/54a04955/uploads/origins/ae358f80-8bc0-4501-835e-4e0578602fd8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fb6f6db7589554b94d02f2f70b09e582", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/54a04955/uploads/origins/ae358f80-8bc0-4501-835e-4e0578602fd8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=10caf7cc7ecd0a7fc227a64c0fc817ad", "src_set": ""}, "body": "こんにちは\n過去にエルフの遺作のイラストを製作しておられたので依頼します\n\nキャラは遺作の浅川琴未になります\n彼女が遺作に処女を散らされた場面を描いてください\n\n手足を縄で拘束され、大股開きにされて正常位で犯されています\n服装ははだけた制服で、胸と性器が丸見えです\n胸は巨乳で目立たせます\n\n男根が挿入された結合部からは、純潔の証である破瓜の血が流れています\n琴未の視線はその結合部に向けられています\n表情は初体験の痛みと、大切にしていた処女を奪われたショックに声を上げて泣いています\n\n遺作の体の描き方はお任せします\nメインはあくまで琴未の体なので詳細に描写する必要はなく、必要な部分(男根や手など)だけで大丈夫です（顔などはいりません）\n\nもし可能であれば、処女膜が亀頭に破られる瞬間の様子を描くコマを入れていただけると嬉しいです\n\n以上、ご検討頂けると幸いです\n宜しくお願いします", "nc": 168, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@massan001/works/262", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1313737, "client_id": 698483, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/699218a5/uploads/origins/62d9a523-f75b-4e0d-ad88-5f7196d26b8e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f6485732ec2d48508809bf379a72f099", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/699218a5/uploads/origins/62d9a523-f75b-4e0d-ad88-5f7196d26b8e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=1259f07d1d0ede8374a4c71b62c9f4b2", "src_set": ""}, "body": "またまたこんにちは。  僕と友達のOCが一緒にセックスしているところを描いてほしいんだ。https://www.deviantart.com/stash/04tp4w4uexw のような体位で、友達のOCが私のOCの脚の間に入っていてほしい。私のOCの両腕を後ろ手に縛って、すべてを楽しんでほしい。また、友人のOCの口と私のOCのアソコから唾液やジュースが出るようにしたい。\n\n私のOC: https://sta.sh/22d4xtfod13a\n友達のOC: https://drive.google.com/drive/folders/1IBmhH5qpQHN3xHfD5BdPk9d895TGZrva?usp=drive_link\n\nまたよろしくお願いします。", "nc": 169, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@massan001/works/261", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/16161793/uploads/origins/1463e177-9768-4415-bc11-4893cfe2f004?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=1f869135b913f5a845e515bfcc9e7f38", "src_set": ""}, "private": true, "genre": "art", "tipped": false, "creator_id": 1313737, "client_id": 0, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 160, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@massan001/works/260", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1313737, "client_id": 761455, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/8c8796fc/uploads/origins/73a8933f-4a65-4683-8149-493ad234e386?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d0f6157cdf8e67365350a517493c571f", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/8c8796fc/uploads/origins/73a8933f-4a65-4683-8149-493ad234e386?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=90b718d4b107ea20334f3446af70dfeb", "src_set": ""}, "body": "まっさんさん、こんにちは。\n前回のイラストありがとうございました。\n今回はオリキャラのイラストをお願いします。  \n\nキャラクター\n・オリキャラ（名無しの冒険者、資料URLを参照)\n\n表情\n・目は虚ろ目\n\nシチュエーション\n・ パイプ椅子にテープで縛られている\n・相手の片手の指を口の中に突っ込まれ、口を拡げられながら顔を持ち上げられる\n・相手の服は防護服（参考資料のURLを参照)\n\nよろしくお願いします。\n\n参考資料\n防護服：https://catbox.moe/c/tsqtqc\n名無しの冒険者：https://imgur.com/a/EV3mewG\n\nhttps://imgur.com/a/EV3mewG", "nc": 57, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@massan001/works/259", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1313737, "client_id": 2990634, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/85673a23/uploads/origins/4cd2bdb1-4e12-4034-8966-cb52143b98e2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=93fc409a3555b6e5e51eff49f39c76c6", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/85673a23/uploads/origins/4cd2bdb1-4e12-4034-8966-cb52143b98e2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=8ba1ec20e940b2010b771375017b6006", "src_set": ""}, "body": "改めましてこんにちは！前回のブーディカのイラストありがとうございました！素晴らしかったです！もしよろしければ、またリクエストさせていただいてもよろしいでしょうか？\n\n源頼光のイラストをもう一枚お願いできますか？\n\nキャラ素材：（お好きな衣装でお願いします）\nバーサーカー：https://imgur.com/a/height-175cm-5ufj34y\nランサー：https://imgur.com/a/reXSzeQ\n源頼光の衣装は、脱いでも、破いても、そのままでも、全裸でも、ご自由にどうぞ。\n\nシチュエーションやポーズは、あなたが一番いいと思うもの、使いたいものを選んでください。表情も自由にしてください。\n\n読んでくださってありがとうございます。そして、いつも素敵な一日を、素敵な一週間をお過ごしください！", "nc": 41, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@massan001/works/258", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1313737, "client_id": 1973998, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/c6798e88/uploads/origins/d9b49fad-558a-4db0-8868-c308c7bad730?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=43066c355f5e320d03d8e3e7e60d3a35", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/c6798e88/uploads/origins/d9b49fad-558a-4db0-8868-c308c7bad730?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=40e1ce324adf83b9639e1a820fe5457e", "src_set": ""}, "body": "こんにちは！\n\nNIKKEからシンデレラのアートワークをお願いしたいのですが - https://nikke-goddess-of-victory-international.fandom.com/wiki/Cinderella/Story\n\nシナリオ\n普通のシンデレラが、フタナリに堕とされた／普通のシンデレラに犯されている。\n\nシーン：\n普通のシンデレラは、悪のシンデレラに後ろから首を絞められ、ペニスをマンコに挿入されている。これに似ている：https://www.pixiv.net/en/artworks/127175999。\n\nシンデレラのようなニッケは呼吸に空気を必要としないので、悪の自分に犯される快感だけでなく、彼女が首絞めから逃れようともがくようにしてください。\n\nどちらか一方がヌードでもかまわないが、デフォルトの衣装を着たほうがセクシーに見えると思う。\n\nこのリクエストを受け入れてもらえると嬉しいです", "nc": 168, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@massan001/works/257", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1313737, "client_id": 698483, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/c5cdc2d3/uploads/origins/ae4a0cc6-c2cc-421d-aca2-3961a509b131?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=868c2dcd532e5fae7172e459faba5c1b", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/c5cdc2d3/uploads/origins/ae4a0cc6-c2cc-421d-aca2-3961a509b131?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=4b9a43da1982be32e54381f6a98a65f0", "src_set": ""}, "body": "こんにちは、お元気ですか？\nhttps://www.deviantart.com/stash/04y2loy5tns のように、私のOCのボンデージ前とボンデージ後を描いていただけませんか？彼女にまたオフィス服(https://sta.sh/2e5g4c6cl3n)を着せて、ヒール(https://sta.sh/2250oeg3dod5)を履かせたい。後ろから犯されながら、https://sta.sh/215r2qlipt8t のように縛られてほしい。他にも何でも追加してください。\nありがとう。\n\nhttps://www.deviantart.com/stash/2mju3srmdfu", "nc": 168, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@massan001/works/256", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1313737, "client_id": 1798313, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/dd37f437/uploads/origins/c372a1fe-28cd-48fe-8b30-0bd4fe1b016f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=12620e943e77653d0efa80aa819f652d", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/dd37f437/uploads/origins/c372a1fe-28cd-48fe-8b30-0bd4fe1b016f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=fe92de3882150f211c3c06e2ab4fb717", "src_set": ""}, "body": "こんばんは、オリジナルキャラクターを描いてほしいです。https://www.notion.so/tacocatpatron/Autumn-ee9b273eea5d459ebaf3ccc2949f6010。\n \nこれらのリンクのようなバッドエンド、捕獲、敗北の状況。\nhttps://www.pixiv.net/en/artworks/119037200\nhttps://skeb.jp/@massan001/works/225\n\nボンデージのポーズ。首輪と鎖をつけている。足の裏が見えている。\nhttps://skeb.jp/@massan001/works/179\nhttps://skeb.jp/@massan001/works/243\nhttps://skeb.jp/@massan001/works/211\n\n表情はこんな感じ。\nhttps://skeb.jp/@massan001/works/1\nhttps://skeb.jp/@massan001/works/19", "nc": 41, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@massan001/works/255", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/a5644fab/uploads/origins/fb311b4a-e574-4d1b-9bd1-983353acb4a6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=9595bd2432a70e63160dd29bf6bb8d02", "src_set": ""}, "private": true, "genre": "art", "tipped": false, "creator_id": 1313737, "client_id": 1516190, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 160, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@massan001/works/254", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1313737, "client_id": 2990634, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/d0a43f44/uploads/origins/ddb6010c-2eab-4235-9448-3fbb3cb18d6a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9982992bf66af01d0ffe4a8435c6aa0a", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/d0a43f44/uploads/origins/ddb6010c-2eab-4235-9448-3fbb3cb18d6a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=1d20b7eee4be6a25870f86e06ba3cb79", "src_set": ""}, "body": "改めてこんにちは！前回のスカディのイラストありがとうございました！素晴らしかったです！もしよろしければ、またリクエストさせていただいてもよろしいでしょうか？\n\nFGOのブドゥカのイラストをもう一枚お願いできますか？\n素材：https://imgur.com/a/riVc1Ep いつものように、彼女の衣装の好きな部分を削除したり、破いたり、そのままにしたり、ご自由にどうぞ。\n\nシチュエーションやポーズは、あなたが一番いいと思うもの、使いたいものを選んでください。表情もお好きなものでお願いします。\n\n読んでくださってありがとうございました。そしていつも、素敵な一日、素敵な一週間をお過ごしください！", "nc": 56, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@massan001/works/253", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1313737, "client_id": 2118981, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/df1f6df8/uploads/origins/6e50bcd1-7372-452d-81af-cffe914cbec6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ae043a128e7523a4cd0817004e7e6aee", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/df1f6df8/uploads/origins/6e50bcd1-7372-452d-81af-cffe914cbec6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=8989fb2363f5ce1fa0030b19c81af554", "src_set": ""}, "body": "こんにちは、massanです。\nイゼンドラ（DiabloII Sorceress）のR-18作品をまた作ってください。\n今回はActVのボスNihlathakに捕らわれています。\nhttps://diablo.fandom.com/wiki/Nihlathak\n\nNihlathakはゲームに登場する蛮族の長老です。\n彼は邪悪な魔法を使ってヒロインを倒し、拷問する。\nイゼンドラを毒や邪悪な魔法で操りながら、指を動かすニヒラタクの姿が見たい。そしてニヒラタクがイゼンドラを鎖でつないで犯す。好きな位置とアングルを選んでください。\n背景は灰色の石の祭壇（ゲーム内ではHalls of painというマップです。）\nhttps://diablo.fandom.com/wiki/Halls_of_Pain\n\nヒロインのイゼンドラはふんどし（というか骨盤カーテンというか......意味はわかりますよね）だけでノーパンです。\nありがとうございました！\n\nhttps://diablo.fandom.com/wiki/Nihlathak", "nc": 56, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@massan001/works/252", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1313737, "client_id": 1440837, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/cf4bc5f9/uploads/origins/c107c1ac-403c-429c-804c-56c38cc96580?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b2a7188d48f517831b5acefe0a82b04d", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/cf4bc5f9/uploads/origins/c107c1ac-403c-429c-804c-56c38cc96580?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=26e406bc94eb43f3741e5f17ed207f6a", "src_set": ""}, "body": "こんにちは！\n\n前作の続きです：\n\nhttps://skeb.jp/@massan001/works/172\n\nhttps://x.com/dummy070088/status/1847231400656740707?t=lQWxDd9ZXTB9wRWg9INqqQ&s=19\n\n21の目には黒い強膜と赤い虹彩を使ってください。彼女は本当に狂った顔をしていて、18の耳元で囁いているはずです。18のアヘ顔パネルもお願いします！\n\n触手が18のケツに入るダブル挿入。たくさんのザーメンをお願いします！\n\nありがとうございました！\n\n\n\nありがとう", "nc": 56, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@massan001/works/251", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/c1bde313/uploads/origins/9bb3d47b-1a4f-48ec-8a9b-9b290aacf1ef?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=82d0ddb0bf6228f8355848cd1767c104", "src_set": ""}, "private": true, "genre": "art", "tipped": false, "creator_id": 1313737, "client_id": 0, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 41, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}], "similar_creators": [{"id": 117490, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "マツダユウスケ100,8", "screen_name": "mazdanakanohito", "avatar_url": "https://pbs.twimg.com/profile_images/786789466178334720/fb3OWJLB.jpg", "header_url": "https://pbs.twimg.com/profile_banners/132448728/1630668258/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "skills": [{"genre": "art"}, {"genre": "comic"}], "nc": 48}, {"id": 187735, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "ment@C106土曜 南h36a", "screen_name": "ment50", "avatar_url": "https://pbs.twimg.com/profile_images/1948404810518339584/ncPjkeH7.jpg", "header_url": "https://pbs.twimg.com/profile_banners/18899641/1753370945/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request