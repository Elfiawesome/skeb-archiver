構いません。\n\nキャラクター詳細クラージュは180cm、カリカは170cm。エメラルドの瞳を持つが、戦闘になると虹彩が真紅に輝く。彼のカタナの刃はオニキス色をしており、戦闘時には黒とラベンダー色の稲妻のようなエネルギーがクライジとカタナの両方から放たれる。  クライジは愛する者を非常に大切にする。\n\nカリカはとても自信家で、感情面では警戒心が強い。彼女は親しい仲間や愛する人にしか心を開かない。戦闘中であれば、彼女のカタナの柄にある青いバラが、鞘を抜いたときに光る。カリカの表情は典型的な集中型で、時には生意気でさえある。   バストは大きめに描いてください。\n\nよろしくお願いします！\n\nhttps://drive.google.com/drive/folders/1jGqckBVSsf40NrTvj69li95j5pkYZMyy?usp=drive_link", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@kuroko_lock6/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3084085, "client_id": 2753127, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/b5ec00b2/uploads/origins/dd99ac1c-b156-44ab-806a-dc4f0a1fff89?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d2f03ecfad15508bba764d32ad28340e", "srcset": "https://si.imgix.net/b5ec00b2/uploads/origins/dd99ac1c-b156-44ab-806a-dc4f0a1fff89?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d2f03ecfad15508bba764d32ad28340e, https://si.imgix.net/b5ec00b2/uploads/origins/dd99ac1c-b156-44ab-806a-dc4f0a1fff89?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=887dce8ffb24970916e3d22f8cca71b8 2x, https://si.imgix.net/b5ec00b2/uploads/origins/dd99ac1c-b156-44ab-806a-dc4f0a1fff89?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=2999c90012a8b34a6f3780c8302c0d8e 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/b5ec00b2/uploads/origins/dd99ac1c-b156-44ab-806a-dc4f0a1fff89?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f7ea2cc961c95b7a4a37c986151c1d35", "srcset": "https://si.imgix.net/b5ec00b2/uploads/origins/dd99ac1c-b156-44ab-806a-dc4f0a1fff89?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f7ea2cc961c95b7a4a37c986151c1d35, 