 "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@nameko_hachikou/works/491", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/64883494/uploads/origins/2a7323de-0c11-4ed0-ac5f-ef9cc27d07df?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=b854f5a171cb450ee32bd9bb11b88064", "src_set": ""}, "private": true, "genre": "art", "tipped": false, "creator_id": 1487547, "client_id": 2187330, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 144, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@nameko_hachikou/works/490", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1487547, "client_id": 1713283, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/1417bbcc/uploads/origins/15246f12-ae17-4205-ab50-49cc9c0f7052?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6f6084ae785e6594dec7cf0903ea2bef", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/1417bbcc/uploads/origins/15246f12-ae17-4205-ab50-49cc9c0f7052?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f7a92619f9e15f1a4569563fab39fb35", "src_set": ""}, "body": "超過してしまったのですがどうしてもなめこさんの素敵な絵柄のエイクスルニルさんとのイラストを見たいので再度送らせて頂きます。お忙しい中申し訳ありません;\n\n資料を少し更新しました。こちらの衣装のふたりをお願いします。\nエイクスルニルさんが小さい私を抱っこしてエイクスルニルさんが優しい笑みを浮かべ小さい私を見つめています。小さい私も幸せそうにエイクスルニルさんを見つめています。\n同じく色を塗ってくださると嬉しいです。小さい私のリボンの色は黄色でお願いします。\n\nなめこさんの描くエイクスルニルさんと小さい私が大好きなのでこちらの衣装でぜひ見たいです。\n\nhttps://drive.google.com/drive/folders/1HXMsE0WxXYJnOGE8dRfpoJzoQYvYKisR\n\nもし良ければご検討の程よろしくお願いいたします。", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@nameko_hachikou/works/489", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/b99bf9e5/uploads/origins/2449e652-62e2-4229-bd10-34d2ccc76972?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=efff1d7a73f7445ea3b5d1a54cefced8", "src_set": ""}, "private": true, "genre": "art", "tipped": false, "creator_id": 1487547, "client_id": 0, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 128, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@nameko_hachikou/works/488", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1487547, "client_id": 606768, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/2849b2bf/uploads/origins/227b7865-7b28-4908-b8a8-3c57fcfaafd2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=aaed3378e118d84c1c2fbde88afe13bf", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/2849b2bf/uploads/origins/227b7865-7b28-4908-b8a8-3c57fcfaafd2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=1d9e59ef7fe698b67c84051fda4cf3bf", "src_set": ""}, "body": "Namekoさん、こんにちは！あなたの絵が大好きです！私のサメキャラのファンタジー猫服を着たかわいいイラストをリクエストしてもいいですか？好きなように描いてください！ありがとうございます！<3\n\nhttps://drive.google.com/file/d/1AZ0RHWfnWfVEqCbBM3jegYXynkd_8gNB/view?usp=sharing", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@nameko_hachikou/works/487", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1487547, "client_id": 250834, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/78155ff