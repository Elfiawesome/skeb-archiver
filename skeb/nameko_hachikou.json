mgix.net/a7c53de3/uploads/origins/960a1622-afc6-4dc2-8149-51f047d61bf1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0ff00c21dc413742cbb3310f01b7d743", "src_set": ""}, "body": "なめこさんこんばんは！\n\nまた余裕が有ればナルト君をお願いしたいです！\n滝に打たれる筋ショタナルト君とそれを見張るモクローとか良ければお願いします！", "nc": 9, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@nameko_hachikou/works/472", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1487547, "client_id": 2743897, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/19cfcf1b/uploads/origins/824159aa-470f-4768-b429-4b4bf5060fd7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=cee61e9d835a40eb8707b862a728cf63", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/19cfcf1b/uploads/origins/824159aa-470f-4768-b429-4b4bf5060fd7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3e73bdd167c01f9dd184e8b6117fb9b4", "src_set": ""}, "body": "こんにちは！お元気ですか？\n\nポータル2」のOC「テランス」と「チェル」のアートワークをお願いしたいです。\n\n「テランス」は身長165cm。\n「チェル」は身長190cmです。\n\n2人は「アパーチャサイエンス」の廃墟で一緒に暮らしている。\n\n「テランス」は元科学者で、植物学や植物に造詣が深い。慌てん坊。\n「チェル」は元被験者で、普段はストイックだが、「テランス」と過ごす時間は楽しい。\n\n好きなようにポーズを決めてください！\n\nリクエストに応えてくれてありがとう！\n\nhttps://drive.google.com/drive/folders/1vY9yF1iAfwEWy1XXDFvexAxr2YZ4Er3x?usp=drive_link", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@nameko_hachikou/works/471", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/63be90dc/uploads/origins/1bec2e6b-dbdf-4a95-b7b7-38748a37f536?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=e89f302d5c2cd33d3902fe7136b56bdb", "src_set": ""}, "private": true, "genre": "art", "tipped": false, "creator_id": 1487547, "client_id": 1946676, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 128, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@nameko_hachikou/works/470", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/ee15a4e3/uploads/origins/73cbe96d-e490-4f51-b685-9ca2ae512eb5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=f059c4319967e23a7131c68f0caa7dde", "src_set": ""}, "private": true, "genre": "art", "tipped": false, "creator_id": 1487547, "client_id": 2187330, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 145, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@nameko_hachikou/works/469", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1487547, "client_id": 3554167, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/1d35049e/uploads/origins/3b28f5dd-5665-4312-924f-7802f03bd1b1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=557608fa65bc186217a42d93887d5c18", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/1d35049e/uploads/origins/3b28f5dd-5665-4312-924f-7802f03bd1b1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=543fb696b70f527856652fbe1691ccda", "src_set": ""}, "body": "こんにちは、私はソフィアです。はじめまして、なめこさん。日本語が苦手なので、英語で書いてごめんなさい。\n\nなめこさんの絵はすごいですね。私のアイデアもなめこさんのアートワークで見てみたいです。\n\n〇リクエストです：ジュリ（性転換）の男性バージョンのイラストをお願いしたいです。♂️ キャラクターがとても好きなので、男性バージョンをデザインしました。また、OCのソフィは若い巫女です。キャラクターの参考画像を以下に添付します。\n\nポーズ両キャラクターがデートしているようなロマンチックなシーンが希望です。ポーズや設定はお任せします。参考画像の衣装でお願いします。\n\n性格\n- 男性のジュリはセクシーなバッドボーイ。\n- ソフィはシャイでキュート。\n\n予算内であれば、カラーイラストだとありがたいですが、カラーの価格基準がわからないので、基準に満たない場合は白黒でも構いません。\n\nイラストは個人使用のみで、配布や販売はいたしません。  \n\nよろしくお願いします！\n\nhttps://drive.google.com/drive/folders/1srKuGXrzWo-qBHkEgGBuR8uvsxj3FNqX?usp=sharing", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@nameko_hachikou/works/468", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/103a9158/uploads/origins/9a8bb0d8-4419-4373-b2d7-1fb9bb02546c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=545d7574d804de28967fdf180c73253f", "src_set": ""}, "private": true, "genre": "art", "tipped": false, "creator_id": 1487547, "client_id": 0, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 1, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@nameko_hachikou/works/467", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/132275a4/uploads/origins/a2205253-e354-443f-9ce7-6f4df12971be?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=372935d89e7a3dae18805c616cdaba37", "src_set": ""}, "private": true, "genre": "art", "tipped": false, "creator_id": 1487547, "client_id": 2187330, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 128, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@nameko_hachikou/works/466", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/d95f7c2f/uploads/origins/fe12fd0d-f5ac-4153-b6c1-8b663dbbfe3c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=