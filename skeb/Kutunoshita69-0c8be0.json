54-4371-805f-c34c4a2078a3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f4597737e46c4708516eb4601e163c19, https://si.imgix.net/24adf9bd/uploads/origins/c53d99aa-2c54-4371-805f-c34c4a2078a3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=4b72cea13148b7972c02f0e99ad6b03a 2x, https://si.imgix.net/24adf9bd/uploads/origins/c53d99aa-2c54-4371-805f-c34c4a2078a3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=b6965c73d6c77b15b1f8ca136d279729 3x"}, "body": "リクエスト失礼します\nアズールレーンの赤城が指揮官に金蹴りしているシチュをリクエストさせていただきたいです\n\n視点は蹴られている指揮官視点、\n指揮官は全裸でペニスは先端が少し剥けているくらいの包茎で大きさは通常くらい\n赤城の服装は全裸で左手の薬指に指輪をつけている状態でお願いします\n赤城は全体的に愛がある言葉責めをしているような感じでお願いします\n\n足を下げている状態と蹴っている状態の差分を作っていただきたいです\n\nシチュ\n指揮官に金蹴りして欲しいと頼み込まれ困惑するも\n大好きな指揮官のためにマゾ性癖に付き合ってあげる赤城\n↓\n二人とも立った状態で赤城が膝で金蹴り\n指揮官は片手で赤城の胸を揉みながら\nもう片方の手でオナニーをする\n↓\n最初は優しく蹴るが少しずつ強さを上げていき\nそれに応じて指揮官も痛がる\n痛がる指揮官をみて赤城の加虐心が煽られ\nさらに蹴りを強める\n↓\n一番強く蹴るのと同時に指揮官が大量に射精し赤城にぶっかける\n↓\n指揮官が満足してオナニーを辞めようとするも赤城が指揮官の手を上から\n握り、無理やりしごかせながら再び金蹴り\n↓\n指揮官は抵抗するも無理やりしごかれ\n射精させられた後、潮吹きまでさせられる\n\n以上のような流れでお願いします！\nご検討いただけますと幸いです！", "nc": 40, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@Kutunoshita69/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2789061, "client_id": 2485674, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/8efdfa72/uploads/origins/0b6ab095-fc98-4d36-83b1-076741eea2d6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0d36c34e6b00f377b5c27db0fa2fb115", "srcset": "https://si.imgix.net/8efdfa72/uploads/origins/0b6ab095-fc98-4d36-83b1-076741eea2d6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0d36c34e6b00f377b5c27db0fa2fb115, https://si.imgix.net/8efdfa72/uploads/origins/0b6ab095-fc98-4d36-83b1-076741eea2d6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=to