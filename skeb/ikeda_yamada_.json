RIVATE&s=576d46ae1d1dc65ba752f26c67f48fe6", "src_set": ""}, "private": true, "genre": "art", "tipped": false, "creator_id": 83297, "client_id": 389700, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 161, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@ikeda_yamada_/works/26", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 83297, "client_id": 0, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/e89e159c/uploads/origins/ec6a287b-0824-45e3-b9b5-bc28a1a2bcee?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6ad1ad8a4444e194817c3cc22f7247d7", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/e89e159c/uploads/origins/ec6a287b-0824-45e3-b9b5-bc28a1a2bcee?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=89de5a2ce30cb0b84b2e824edb3da051", "src_set": ""}, "body": "前回は最高なイラストありがとうございました！\n\n続けてで申し訳ないのですが、またリクエストさせて頂きます。\n\nキャラクター：リルトット\n①見抜き\n腋見せで見抜き→腋射される。\nドン引きしてるか呆れてるかのような表情。\n②襲われる\nこっちにも付き合って貰う、あるいは射精されてスイッチが入って、的な流れでリルトットに襲われる。内容はお任せします。\n\n竿役はモブで、顔を描写しないような形でお願いします。\n構成など、その他の部分は全てお任せします。\n\nそれではよろしくお願いいたします。", "nc": 49, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@ikeda_yamada_/works/25", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/e35465c7/uploads/origins/bc1b6c2b-fa55-4f11-9133-f340062e6cef?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=763788e30b05cef113f383b4c716bfd1", "src_set": ""}, "private": true, "genre": "art", "tipped": false, "creator_id": 83297, "client_id": 389700, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 161, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@ikeda_yamada_/works/24", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/a8920c2a/uploads/origins/c262a49c-c243-4426-8229-30fdb6412613?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=e8f3870c7727979b008f5d7c5f1ed1af", "src_set": ""}, "private": true, "genre": "art", "tipped": true, "creator_id": 83297, "client_id": 115811, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 49, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@ikeda_yamada_/works/23", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 83297, "client_id": 0, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/50a95126/uploads/origins/26c5aad5-daaa-4e6d-b61e-65ad745beff0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ee1287a4b0b1efa5b43e7c2f94b59015", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/50a95126/uploads/origins/26c5aad5-daaa-4e6d-b61e-65ad745beff0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0298d566a6a4094a0cd73ce4bf5a3ad6", "src_set": ""}, "body": "砕蜂隊長と夕四郎くんのセックスを見たい気持ちと、\n即落ち2コマする砕蜂隊長を見たい気持ちが戦っているので、\n夕四郎くん相手にリードしようとして普通に負けてしまう砕蜂隊長をお願いし〼。\n\n解釈違いでしたら石田さんの好きな解釈で大丈夫です。", "nc": 177, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@ikeda_yamada_/works/22", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 83297, "client_id": 446356, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/82aa46bf/uploads/origins/d51d9392-0006-4488-be74-92f1e7145c08?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=536a402636813f82c7bdf6bdc78fb489", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": true, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/82aa46bf/uploads/origins/d51d9392-0006-4488-be74-92f1e7145c08?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=58b854bfbd871de33722129089f4d421", "src_set": ""}, "body": "はじめまして、四肢切断表現のある作品を拝見し、手数料無料キャンペーンギリギリで申し訳ありませんがリクエストさせて頂きました。\n\nキャラクター・東方紺珠伝の稀神サグメ\n・左の手足を根本から切断されている\n(断面は縫合処置済みで皮膚で覆われて流血等は無しでお願いします。)\n\n・右の手首と足首を縄か皮手錠でまとめて縛られて上から縄で一点吊りされている\n\n・すすり泣きなが敬語で許しを乞いている\n\n・陰毛・腋毛ありでお願いします。\n\n・可能でしたらグリップ付きディルドで激しく責められ悶絶している様子をお願いします。\n\nご検討の程宜しくお願い致します。", "nc": 187, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@ikeda_yamada_/works/21", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 83297, "client_id": 0, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/9de4ef39/uploads/origins/514cc013-d3a0-4c4f-86bb-143624c5cbdb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2b6c757474c365a3b4f3f1701be647c6", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": true, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/9de4ef39/uploads/origins/514cc013-d3a0-4c4f-86bb-143624c5cbdb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=249ede761826597324602ac5e33eaa3e", "src_set": ""}, "body": "初めまして、リクエストをお願いさせて頂きたいです。\nキャラ：ニニム・ラーレイ(天才王子の赤字国家再生術)\nニニムは四肢を切断され、道端の汚水溝に捨てられた。四肢の断面は鉄カップに包まれ、鎖で溝の両側に固定されている。\n裸で首に首輪をつけ、乳首とクリトリスにピアスをつけられている。\n差分：\n■彼女はこのような凄惨な姿で、昼間ホームレスに輪姦された。\n■精液を全身に浴びた後、また複数の野良犬にレイプされ、夕暮れまで続いた。\n■最後に彼女は全身汚濁し、2穴が開き、大量の精液が流出し、アク目をむいて溝の中で気絶する。通行人たちは彼女の体に小便をした。\n四肢断面を描かないでください，流血、グロNG。\nありがとうございます！", "nc": 171, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@ikeda_yamada_/works/20", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/080cd809/uploads/origins/d7c9b501-f104-4810-9f93-ff25fe164517?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=95d1504165c6a84caefde6c28441edd7", "src_set": ""}, "private": true, "genre": "art", "tipped": true, "creator_id": 83297, "client_id": 8595, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 161, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@ikeda_yamada_/works/19", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/67d1fd04/uploads/origins/691988cf-7fc7-40ac-afe6-42cd4ad4bd80?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=204d395fd185140994ab45bb8528f20a", "src_set": ""}, "private": true, "genre": "art", "tipped": false, "creator_id": 83297, "client_id": 0, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 33, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@ikeda_yamada_/works/18", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 83297, "client_id": 0, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/7d222dfb/uploads/origins/3a3a06a7-9a47-4f62-97f0-c8c9f0d74853?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=50dd0f58a57aa24d8567c97f5744c16e", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": true, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/7d222dfb/uploads/origins/3a3a06a7-9a47-4f62-97f0-c8c9f0d74853?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=7ee03fe6a7cb16a70d3d4128c19f9b23", "src_set": ""}, "body": "東方鬼形獣の吉弔八千慧をお願いします。\n手足を肘、膝の位置で切断されてひっくり返されて甲羅が重く起き上がれず亀のようにもがいているところをお願いしたいです。\n可能であればはじめは催眠あるいは錯乱状態で手足のない今は心地良い状態だと誤認し恍惚の表示を浮かべている。\nそのあと痛みや時間経過で現実に引き戻され手足のないことに呆然とし、また自分のあられもない姿に気付いて必死に抵抗しようと無駄な足掻きをしだす流れにしてほしいです。\n胸は平坦、陰毛は未処理でお願いしたいです。", "nc": 43, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@ikeda_yamada_/works/17", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 83297, "client_id": 462930, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/28d98012/uploads/origins/c94c0722-868f-45d8-abe2-fc8713a72efa?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3161c0df4dff37694336262ca1b2d18f", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/28d98012/uploads/origins/c94c0722-868f-45d8-abe2-fc8713a72efa?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=73a813e2a093c48e2ae8cb231318b045", "src_set": ""}, "body": "また依頼します。\n\n過去に依頼しました東方Projectの影狼と椛の二人が\n二人並んで腋見せポーズを取っているイラストをお願いします。\n\n他の方の以下の依頼絵のように\n二人が並んで両腋を見せてこちらを誘惑しており\n二人とも発情期で私たちと交尾しましょと誘っている表情です。\n\nhttps://skeb.jp/@ikeda_yamada_/works/11\n\n過去依頼絵と同じく二人のアソコは陰毛が生えており\n全身ムレムレでメスのフェロモンをムンムンと漂わせ\n二人とも腋はとても匂っていそうな感じでお願いします。\n\n二人の過去依頼絵\nhttps://skeb.jp/@ikeda_yamada_/works/6　影狼\nhttps://skeb.jp/@ikeda_yamada_/works/9　椛\n\n服は全裸でＯＫですが二人とも尻尾を生やしてください。\n\nまた、二人揃って交尾して中出しされたようで\nとても満足気なメスの表情とアソコから白い液体が零れている\n事後的な差分をお願いします。\n\n以上、ご検討ください。", "nc": 49, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@ikeda_yamada_/works/16", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/fb70b38b/uploads/origins/3c856159-31a7-4b7c-b486-1ef2743c5649?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=f75b6eedf3025ed3e0f3111520229ba1", "src_set": ""}, "private": true, "genre": "art", "tipped": true, "creator_id": 83297, "client_id": 0, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 49, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@ikeda_yamada_/works/15", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 83297, "client_id": 0, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/34b82317/uploads/origins/a11a2c2c-b45e-444b-824c-f42b0d2d1a12?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=27eb8e7903dd89df8c264d850113095b", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": true, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/34b82317/uploads/origins/a11a2c2c-b45e-444b-824c-f42b0d2d1a12?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b0505610dc40e75aa6f0c91363cf175c", "src_set": ""}, "body": "東方の射命丸文をお願いします。\n危険な組織の秘密を探ろうとして捕まったような感じのシチュエーションで四肢切断されて達磨状態になっているところをお願いできませんか。\n可能であれば精液ボテや暴行の痕があると嬉しいです。\n体型などは以前pixivにあげられていたものを基準にされていると助かります。", "nc": 59, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@ikeda_yamada_/works/14", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 83297, "client_id": 8595, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/ff17ad88/uploads/origins/3d13c593-5897-4864-a2ea-f1246c519108?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a3328847476b9a13cddded09c007e569", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/ff17ad88/uploads/origins/3d13c593-5897-4864-a2ea-f1246c519108?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a15c926891549efd51767c8e0943b757", "src_set": ""}, "body": "Skeb開くの心待ちにしていました！\n早速リクエストさせて頂きます。\n\nキャラクターは世壊＆壊世で、陰毛の描写をお願いします。\n髪の毛はいつもよりモジャっとした感じに描いてくれると嬉しいです。\n\nポーズ・シチュエーションはお任せします。（念のため本文の後にNGなことを書いておきます）\nまた、予算・時間的に厳しい場合は世壊のみで大丈夫です。\n\nそれでは、よろしくお願い致します。\n\nhttps://drive.google.com/drive/folders/1pbUsKqS5Fn2t83z3Q-ktjLNCLU-9_4c8?usp=sharing", "nc": 161, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@ikeda_yamada_/works/13", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 83297, "client_id": 1221412, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/1697eb3b/uploads/origins/08f61e79-a623-4b9d-a932-2aa5722700f0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=240197f8e46aa0ab729b487d5ca2a349", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/1697eb3b/uploads/origins/08f61e79-a623-4b9d-a932-2aa5722700f0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=bdfa8297e2b566627c14c21ebafd4031", "src_set": ""}, "body": "たまたま見かけた水着武蔵ちゃんの立ちバックなどの過去絵が非常に良かったのでリクエストさせてください🙏\n\nキャラクター：デビィ・ザ・コルシファ\n角とヒール抜きで身長149cmのロリ巨乳キャラなので、武蔵ちゃんとは対照的に足がギリギリ浮き上がるような姿勢で男性上位の立ちバックでお願いします。\n衣装は乳首と乳輪の周りだけ切り裂いたような感じの着衣でお願いします。\n\n差分は無しで以下のシチュエーションを盛り込んだ一枚絵にしてください。\n・何度も犯された感じの蒸れ蒸れ感がある汗\n・背中や髪に世壊ちゃんの事後絵のような外出し精液\n・口と股から溢れ精液。口からはフェラで付いた竿役の陰毛も\n・快楽堕ちした表情\n\nhttps://shonenjumpplus.com/episode/3269754496630500952", "nc": 169, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@ikeda_yamada_/works/12", "private_thumbnail_image_urls": null, "private": false, "genre": "art",