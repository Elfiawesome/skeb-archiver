1b8c110fc89?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9ec62302a14af6c2d926e3033cc9ee54, https://si.imgix.net/a0d14f6e/uploads/origins/71bb6e58-942e-499b-b540-31b8c110fc89?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=8ff362e4ea258c48fc8e1b84947c03a7 2x, https://si.imgix.net/a0d14f6e/uploads/origins/71bb6e58-942e-499b-b540-31b8c110fc89?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=66440363b6e43a0a441f7237a0be377c 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/a0d14f6e/uploads/origins/71bb6e58-942e-499b-b540-31b8c110fc89?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5a8bb079f5eef410995accbdec9d1c0a", "srcset": "https://si.imgix.net/a0d14f6e/uploads/origins/71bb6e58-942e-499b-b540-31b8c110fc89?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5a8bb079f5eef410995accbdec9d1c0a, https://si.imgix.net/a0d14f6e/uploads/origins/71bb6e58-942e-499b-b540-31b8c110fc89?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=d4d18fc046e0c927136d6d0a11192f24 2x, https://si.imgix.net/a0d14f6e/uploads/origins/71bb6e58-942e-499b-b540-31b8c110fc89?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=6968bd5dc4510374d915f9665d998432 3x"}, "body": "匿名で失礼します。\nミリオンライブの劇中特撮劇「アイドルヒーローズ」より白石紬(ジェネシス紬)がデストルドーに改造されふたなりになったダークセーラー高坂海美と伊吹翼に敗北し2穴されるイラストをお願いしたいです。\n\nシチュエーション\n参考\nhttps://momikocu.fanbox.cc/posts/2226127\n↑以前描かれたマイティセーラー百合子のように身体を持ち上げられ動けない所を輪姦される\n前が海美、後ろが翼になるようお願いします\n\n服装\n・紬\nソックスとグローブは少々破れあり、マント、セーラー服は腕部分とリボン以外はほぼ破れ、下半身はスカートがほとんどウエスト部分しか残ってない状態、体にダメージ描写はなし\nアミュレットは奪われるかヒビが入って力を引き出せない様子\n\n・海美、翼\n服は少々ダメージを受けている程度、下半身は露出\n\n表情\n海美と翼は勝ち誇った表情、紬は快楽に堕ちまいと必死に耐えようとする(難しければ昴のように翼は頭だけ映っているのでも大丈夫です)\n\n差分\n1.見せ槍(「お願いです2人とも、目を覚ましてください！」と必死に訴える)\n2.同時に挿入される\n3.ピストン(2人の激しい責めに耐えきれず喘ぎ声が漏れてしまう)\n4.中出し\n5.事後(何度も中出しされて快楽堕ち)\n\n色々指定があり申し訳ありませんが、ご検討よろしくお願いします。", "nc": 184, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@momikocu/works/16", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/bd2578c8/uploads/origins/d12d4a32-9c5c-4fdb-acf2-a664b79c598b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=31971a7afd132a1dfdf2fb2548b8d885", "srcset": "https://si.imgix.net/bd2578c8/uploads/origins/d12d4a32-9c5c-4fdb-acf2-a664b79c598b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=31971a7afd132a1dfdf2fb2548b8d885, https://si.imgix.net/bd2578c8/uploads/origins/d12d4a32-9c5c-4fdb-acf2-a664b79c598b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=b5664d1aee008fe6350d8e9da099ab5c 2x, https://si.imgix.net/bd2578c8/uploads/origins/d12d4a32-9c5c-4fdb-acf2-a664b79c598b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=93ddb348ff93d58b0951f5c8f69fc804 3x"}, "private": true, "genre": "art", "tipped": false, "creator_id": 160892, "nc": 177}, {"path": "/@momikocu/works/15", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/b7d34ccc/uploads/origins/61762d29-886b-4fca-9f59-ed3b15947085?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=b759c4d7d2e796ef2bbf96a763925998", "srcset": "https://si.imgix.net/b7d34ccc/uploads/origins/61762d29-886b-4fca-9f59-ed3b15947085?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&