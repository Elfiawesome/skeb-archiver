.net/f0f5b415/uploads/origins/951f3ba5-76f0-4416-9234-7a496ff092a1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d2681b4c387ada09c7c5627cd97589f0", "srcset": "https://si.imgix.net/f0f5b415/uploads/origins/951f3ba5-76f0-4416-9234-7a496ff092a1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d2681b4c387ada09c7c5627cd97589f0, https://si.imgix.net/f0f5b415/uploads/origins/951f3ba5-76f0-4416-9234-7a496ff092a1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=49fbd2a9ffe2d629bfd6776aad29ae24 2x, https://si.imgix.net/f0f5b415/uploads/origins/951f3ba5-76f0-4416-9234-7a496ff092a1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=39879511b1d14f71399c4682aa27ce00 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/f0f5b415/uploads/origins/951f3ba5-76f0-4416-9234-7a496ff092a1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=31879b4ec3cadb3b44ab876e7b749925", "srcset": "https://si.imgix.net/f0f5b415/uploads/origins/951f3ba5-76f0-4416-9234-7a496ff092a1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=31879b4ec3cadb3b44ab876e7b749925, https://si.imgix.net/f0f5b415/uploads/origins/951f3ba5-76f0-4416-9234-7a496ff092a1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=54b311762f163977dfb1c0bd079f50b8 2x, https://si.imgix.net/f0f5b415/uploads/origins/951f3ba5-76f0-4416-9234-7a496ff092a1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=f5ebc9e14e7366e8897881d2575b5dc3 3x"}, "body": "初めまして、マキと申します。\n以前Twitterでこのはらさんのグッズイラストを拝見し、細部まで拘られたイラストが印象に残り、今回依頼させていただきます。\n\n<要望>\n　参考資料に記載した女の子がお酒を飲みながら、クラブで音楽を聴いてるイラストを描いていただきたいです。\n　このはらさんのグッズイラストやロビンソンのイラストのような構図にしていただけると嬉しいです。\n\n<参考資料>\n　https://drive.google.com/drive/folders/1-_PaWJ_Bbsx3l7wtUPWROwEolpAsTt9N\n\n<参考資料フォルダ詳細>\n・キ