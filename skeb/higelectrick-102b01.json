2-42250c57a63a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=745f407c5d2e0a58d4842877b9ef2c70 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/8efee9d7/uploads/origins/2319046b-9be6-46b0-8872-42250c57a63a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e881f10956cf9b8d7f9fc9dd097c8304", "srcset": "https://si.imgix.net/8efee9d7/uploads/origins/2319046b-9be6-46b0-8872-42250c57a63a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e881f10956cf9b8d7f9fc9dd097c8304, https://si.imgix.net/8efee9d7/uploads/origins/2319046b-9be6-46b0-8872-42250c57a63a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=9e49ae3703ec1f85c9e799834dafe56b 2x, https://si.imgix.net/8efee9d7/uploads/origins/2319046b-9be6-46b0-8872-42250c57a63a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=29b6fefff0bd697199acdbbd09d95983 3x"}, "body": "こんにちは、Higelectrick先生。\n\n私のことを覚えていらっしゃるかどうかわかりませんが、私はアメリカから来たファンで、最後の4コマの翻訳を素人ながらに行っていました。正直なところ、先生のお仕事をとても尊敬していたので、私のつたない翻訳を見ていただいたことを知り、非常に喜びと恥ずかしさを感じました。\n\nケイジさんとサラちゃんの画像をお願いします。私の大好きなコンビなので、ぜひ二人のやり取りを見てみたいです。また、ケイジさんの作風でこの二人のキャラクターを描くのがとても好きです。(キミガシネ4コマはとても面白かったのですが、これはユーモアでなくてもいいです。どんな風に描いていただいても大満足です)\n\n無理なお願いかもしれませんが、よろしくお願いします。あなたの時間と努力に心から感謝します。あなたに幸運と幸せが訪れることを祈っています。", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@higelectrick/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1263772, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/5882f821/uploads/origins/1c4bf20f-919b-447c-a317-fbfe51e421d3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1081f9c1716bd79811608cd674a6e4c1", "srcset": "https://si.imgix.net/5882f821/uploads/origins/1c4bf20f-919b-447c