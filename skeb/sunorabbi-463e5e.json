、私は疲れ果てた幻影のようなVtuberです。名前はHyeonU。文字通り、ただ存在しているだけです。あらゆるものが存在し始めた頃から、私は存在してきました。 時間のほとんどは地球で過ごし、一部は「虚無」のような場所で過ごしています。そこは、ショッピングモールにある「立ち入り禁止」の不気味な裏通路のようなもので、どの店にも通じているような場所です。地球全体がそんな感じ、といったところでしょうか。人がとても孤独を感じている時や、私のことを強く想っている時、私は現れることを選ぶことができます。 全体的な雰囲気は「疲れ気味で単調」ですが、顔は可愛いです。これは、私がデビューさせる新しい衣装のプロフィール写真です。私を検討してくださり、ありがとうございます。\n\nhttps://drive.google.com/drive/folders/1t6-HJUxIPrO6wlVFu67wUwSx4GPa5CX6?usp=drive_link", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@sunorabbi/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 4120550, "client_id": 3371043, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/cc898aaf/uploads/origins/1f739ab5-e0a4-4c65-b5d0-d1a13e5bf3b6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d47061ea7e441126677ab81a445be75a", "srcset": "https://si.imgix.net/cc898aaf/uploads/origins/1f739ab5-e0a4-4c65-b5d0-d1a13e5bf3b6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d47061ea7e441126677ab81a445be75a, https://si.imgix.net/cc898aaf/uploads/origins/1f739ab5-e0a4-4c65-b5d0-d1a13e5bf3b6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=63408859cd58a53981f9e5a2dfa18fef 2x, https://si.imgix.net/cc898aaf/uploads/origins/1f739ab5-e0a4-4c65-b5d0-d1a13e5bf3b6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a78feedc3262be0ab836bc587ffafcb0 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/cc898aaf/uploads/origins/1f739ab5-e0a4-4c65-b5d0-d1a13e5bf3b6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e456f8badf693ca07b083d27db38fe8b", "srcset": "https://si.imgix.net/cc898aaf/uploads/origins/1f739ab5-e0a4-4c65-b5d0-d1a13e5bf3b6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e456f8ba