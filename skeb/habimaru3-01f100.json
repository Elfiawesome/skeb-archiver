乳首NGな為！）\n\n私の代理キャラの立ち絵など\nhttps://x.com/utaugarakuta16/status/1703814020854317518?s=20\n\n\nもし条件や値段的に難しい場合、再送を要請して欲しいです！\n\n長文失礼しました！", "nc": 33, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}], "sent_works": [], "similar_creators": [{"id": 556371, "creator": true, "nsfw_acceptable": false, "acceptable": false, "name": "chiva", "screen_name": "wonderworldwood", "avatar_url": "https://pbs.twimg.com/profile_images/1126050025505562624/fkAwAsqp.png", "header_url": "https://pbs.twimg.com/profile_banners/1474375729/1751803884/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 10, "complete_expiration_days": 100, "skills": [{"genre": "art"}], "banned": false, "nc": 177}, {"id": 1209903, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "さえき", "screen_name": "hill_yoll", "avatar_url": "https://pbs.twimg.com/profile_images/2048821674838249472/itZcNpGG.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1205813486128730112/1718105560/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 5, "complete_expiration_days": 50, "skills": [{"genre": "art"}], "banned": false, "nc": 160}, {"id": 3495418, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "Rine@サブ", "screen_name": "Rine_mini", "avatar_url": "https://pbs.twimg.com/profile_images/1879881579914563584/B4H6ET1c.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1879766495464710144/1737036369/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre