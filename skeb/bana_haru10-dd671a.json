わない！良薬は口に苦しみたいなことだからアレは！！」\n「こっちかな。おいで、黒柴」\n\nhttps://drive.google.com/drive/folders/1tvL4yMxQdiQg9rk9lfd4DZkRIe7KgutW", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@bana_haru10/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 40340, "client_id": 1750102, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/d73ccfba/uploads/origins/24b4af1a-cf70-4450-87d7-bf13fe72fd06?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5f223ac6d943d2aff40e5589de37889f", "srcset": "https://si.imgix.net/d73ccfba/uploads/origins/24b4af1a-cf70-4450-87d7-bf13fe72fd06?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5f223ac6d943d2aff40e5589de37889f, https://si.imgix.net/d73ccfba/uploads/origins/24b4af1a-cf70-4450-87d7-bf13fe72fd06?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=645a7e0bcaf3278605b9c5ed9bd1f644 2x, https://si.imgix.net/d73ccfba/uploads/origins/24b4af1a-cf70-4450-87d7-bf13fe72fd06?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=773ca93f422ee3c27042ba006b9d35fc 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/d73ccfba/uploads/origins/24b4af1a-cf70-4450-87d7-bf13fe72fd06?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=54dd7284f3b081c1270536e1bdaf213e", "srcset": "https://si.imgix.net/d73ccfba/uploads/origins/24b4af1a-cf70-4450-87d7-bf13fe72fd06?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=54dd7284f3b081c1270536e1bdaf213e, https://si.imgix.net/d73ccfba/uploads/origins/24b4af1a-cf70-4450-87d7-bf13fe72fd06?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=f3abdbb4b4f9c197a554f19b5d2b223f 2x, https://si.imgix.net/d73ccfba/uploads/origins/24b4af1a-cf70-4450-87d7