yearly_report_client_visible": false, "total_appeals_count": 0, "received_works": [{"path": "/@fullheal_666/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3976507, "client_id": 1609299, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/752fe27d/uploads/origins/4a031889-9155-4aab-ba80-53c1023e7320?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=533286b85b6d689a23c9e51c4955551b", "srcset": "https://si.imgix.net/752fe27d/uploads/origins/4a031889-9155-4aab-ba80-53c1023e7320?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=533286b85b6d689a23c9e51c4955551b, https://si.imgix.net/752fe27d/uploads/origins/4a031889-9155-4aab-ba80-53c1023e7320?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=fe6d53bd7223eda53d579268a5c3599e 2x, https://si.imgix.net/752fe27d/uploads/origins/4a031889-9155-4aab-ba80-53c1023e7320?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=2184bbd6c5ec681650bd228100115d0c 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/752fe27d/uploads/origins/4a031889-9155-4aab-ba80-53c1023e7320?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=1a0f4825128da250c2ca1ef14fc55eec", "srcset": "https://si.imgix.net/752fe27d/uploads/origins/4a031889-9155-4aab-ba80-53c1023e7320?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=1a0f4825128da250c2ca1ef14fc55eec, https://si.imgix.net/752fe27d/uploads/origins/4a031889-9155-4aab-ba80-53c1023e7320?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=e9000477d424660dd61498808b10b947 2x, https://si.imgix.net/752fe27d/uploads/origins/4a031889-9155-4aab-ba80-53c1023e7320?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=b73583527e2fbfd0f61145d631b0e97b 3x"}, "body": "木村さん、こんにちは！今回の依頼も楽しんでいただけたら嬉しいです。\n\nまた僕のキャラクターを描いていただきたいです：https://drive.google.com/file/d/1dnJXeGfVbyd8oTvpEZ02xyG5RnzdK_eO/view?usp=drivesdk\nhttps://drive.google.com/file/d/10Yn19CU23PhCeSBo7z1M-s0KaEMmsWbY/view?usp=drivesdk\nhttps://drive.google.com/file/d/1-ncVHwQzVZnNrHnp_4_zs0I5epO6rwlg/view?usp=drivesdk\nhttps://drive.google.com/file/d/1xcegjDRFGOCfOUbLwSxeqrvdvmEpPecK/view?usp=drivesdk\n\n\n【今回のアイデア】\nスマホの壁紙（待ち受け画像）をお願いしたいです。僕のスマホは折りたたみ式なので、「正方形に近いサイズ」と「縦長のサイズ」の2バージョンを希望しています。\n\nイメージが伝わりやすいように、参考となる例のリンクを添付します：\nhttps://skeb.jp/@wool_bl/works/78\n\nいつも通り、手（手のひら）や足が見える構図が大好きなので、木村さんの好みに合わせてうまく取り入れていただけると嬉しいです。\n\n【差分について】\n追加で「着衣版」と「全裸（ヌード）版」の2つのバージョンをお願いすることは可能でしょうか？両方の差分が見られたら絶対に楽しいなと思っています。\n\n【衣装・その他】\n衣装は以前のパンダの服が最高だったので、ぜひまた着せてあげてください！\nもし、壁紙をより賑やかで魅力的にするために、アイコンや小物、エフェクトなどのオブジェクトを追加したくなったら、木村さんのクリエイティブな自由にお任せします。\n\n【PSDファイルと制作プロセスについて（もし可能であれば）】\n必須ではないのですが、もしよろしければ、PSDファイルの中に制作プロセスの各工程や、簡単なメモ・解説などを残していただけると非常に嬉しいです。\n実は、イラストレーターをしている私の友人が、前回の木村さんの作品を見て「色遣いや線画の技術がとても勉強になった」と話していました。木村先輩からのアートのアドバイスやコツのようなメモがあれば、友人にとって素晴らしい学びになると思います。\n\n今回も楽しんで描いていただければ幸いです！いつも素敵な才能をありがとうございます。よろしくお願いいたします。\n\nhttps://drive.google.com/file/d/10Yn19CU23PhCeSBo7z1M-s0KaEMmsWbY/view", "nc": 176, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@fullheal_666/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3976507, "client_id": 453319, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/342d18ae/uploads/origins/344d5caa-9d41-4f67-8056-6803e71d3e64?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=637245ff4e0eefa98d97bdd7bc99a9b1", "srcset": "https://si.imgix.net/342d18ae/uploads/origins/344d5caa-9d41-4f67-8056-6803e71d3e64?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=637245ff4e0eefa98d97bdd7bc99a9b1, https://si.imgix.net/342d18ae/uploads/origins/344d5caa-9d41-4f67-8056-6803e71d3e64?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=97a210321a7cb06e141ef886c3ba82f4 2x, https://si.imgix.net/342d18ae/uploads/origins/344d5caa-9d41-4f67-8056-6803e71d3e64?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=acf4462f5682013de2b5bca1f90651c5 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/342d18ae/uploads/origins/344d5caa-9d41-4f67-8056-6803e71d3e64?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=8d069a411c8701d9be7a5606074fa243", "srcset": "https://si.imgix.net/342d18ae/uploads/origins/344d5caa-9d41-4f67-8056-6803e71d3e64?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=8d069a411c8701d9be7a5606074fa243, https://si.imgix.net/342d18ae/uploads/origins/344d5caa-9d41-4f67-8056-6803e71d3e64?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=c9d43eb85d968e4927e1b63c156b7d17 2x, https://si.imgix.net/342d18ae/uploads/origins/344d5caa-9d41-4f67-8056-6803e71d3e64?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=52ccf0da721f392e56bee02365e6046f 3x"}, "body": "きむらさん、こんにちは\n\nお久しぶりです！またイラストをお願いしたいのですが、暑い夏の日、扇風機の前に座っているような私のキャラクターを描いていただけませんか？タンクトップとショートパンツを着て、少し日焼けした跡があり、涼をとろうとしているような感じです。 \n\n服装：タンクトップ\nポーズ：扇風機の前に座っている\n\nSNSのサムネイルに使いたいので、可能であれば背景透明版も添付していただけると助かります。ご検討いただき、本当にありがとうございます！\n\nhttps://drive.google.com/drive/folders/1CHNL5xKKG6s0AGx2OdQwXM9vm1Y9nbJe?usp=sharing", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@fullheal_666/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3976507, "client_id": 1609299, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/8f9e5052/uploads/origins/c251649d-82d5-48b2-b8ae-d6bb8d5b6739?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6f2371081f13069bb668accc1e4e5b16", "srcset": "https://si.imgix.net/8f9e5052/uploads/origins/c251649d-82d5-48b2-b8ae-d6bb8d5b6739?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6f2371081f13069bb668accc1e4e5b16, https://si.imgix.net/8f9e5052/uploads/origins/c251649d-82d5-48b2-b8ae-d6bb8d5b6739?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=d6c0bdd26817189d66dabedf6d707458 2x, https://si.imgix.net/8f9e5052/uploads/origins/c251649d-82d5-48b2-b8ae-d6bb8d5b6739?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=caa309a6800df19e06f8991541f02ac5 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/8f9e5052/uploads/origins/c251649d-82d5-48b2-b8ae-d6bb8d5b6739?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9ab299f2581d9464aef205e92b481b02", "srcset": "https://si.imgix.net/8f9e5052/uploads/origins/c251649d-82d5-48b2-b8ae-d6bb8d5b6739?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9ab299f2581d9464aef205e92b481b02, https://si.imgix.net/8f9e5052/uploads/origins/c251649d-82d5-48b2-b8ae-d6bb8d5b6739?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=eaf96f41bc9a487c48788472d6c0277f 2x, https://si.imgix.net/8f9e5052/uploads/origins/c251649d-82d5-48b2-b8ae-d6bb8d5b6739?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=94347585463b7766d49c5fb2720b1f2d 3x"}, "body": "木村さん、また私です OwO\n何度もご依頼してしまってすみません。今回のアイデアにも興味を持っていただけたら嬉しいです。\nこちらの参考画像をご覧ください [※AI生成画像なのでご注意ください]\nhttps://www.dropbox.com/scl/fo/gsfpx0dre40xde0ylwyfr/AFNYfV_khM8aSZc8K9dUtC0?rlkey=nxutcs7v8l41z3py1kg96a8xu&st=t1n5k14z&dl=0\n\nまた私のうちの子（オリジナルキャラクター）を描いていただきたいです。\nhttps://drive.google.com/file/d/1dnJXeGfVbyd8oTvpEZ02xyG5RnzdK_eO/view?usp=drivesdk\nhttps://drive.google.com/file/d/10Yn19CU23PhCeSBo7z1M-s0KaEMmsWbY/view?usp=drivesdk\nhttps://drive.google.com/file/d/1-ncVHwQzVZnNrHnp_4_zs0I5epO6rwlg/view?usp=drivesdk\nhttps://drive.google.com/file/d/1xcegjDRFGOCfOUbLwSxeqrvdvmEpPecK/view?usp=drivesdk\n参考画像の構図はハーフボディ（上半身）ですが、今回のイラストは全身（フルボディ）で描いていただきたいです。\n彼が寝ぼけつつ、驚き、そして少しイラッとしているような表情を見たいです。自分の部屋で寝ていたところ、お尻に手が触れられて目を覚ましたというシチュエーションでお願いします。\n（可能であれば、下着ありのバージョンと、下着なしでお尻が露出しているバージョンの2種類の差分をお願いできないでしょうか？）\n今回も、そばかすや、手のひらと足の裏の細かい描写を忘れないでくださいね！前回のイラストが本当に例外的に素晴らしかったので、また依頼に来てしまいました。\n改めて、ありがとうございます！木村さんは本当に素晴らしいです！", "nc": 40, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@fullheal_666/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3976507, "client_id": 1609299, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/7b8a7e5a/uploads/origins/134e6f9f-0c3b-416c-a79e-43a621fa1d7b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=76a6b579cebc16a3e5eeffb74182a0cd", "srcset": "https://si.imgix.net/7b8a7e5a/uploads/origins/134e6f9f-0c3b-416c-a79e-43a621fa1d7b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=76a6b579cebc16a3e5eeffb74182a0cd, https://si.imgix.net/7b8a7e5a/uploads/origins/134e6f9f-0c3b-416c-a79e-43a621fa1d7b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=80f5206df01c18166f94177817bd47e1 2x, https://si.imgix.net/7b8a7e5a/uploads/origins/134e6f9f-0c3b-416c-a79e-43a621fa1d7b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=3999e209343d3cacea5b1a55c6411022 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/7b8a7e5a/uploads/origins/134e6f9f-0c3b-416c-a79e-43a621fa1d7b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=158f700b932555d067f7ff747e788bcc", "srcset": "https://si.imgix.net/7b8a7e5a/uploads/origins/134e6f9f-0c3b-416c-a79e-43a621fa1d7b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=158f700b932555d067f7ff747e788bcc, https://si.imgix.net/7b8a7e5a/uploads/origins/134e6f9f-0c3b-416c-a79e-43a621fa1d7b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=205a78c3b3e61d4959fb4ebc9f2a4d9f 2x, https://si.imgix.net/7b8a7e5a/uploads/origins/134e6f9f-0c3b-416c-a79e-43a621fa1d7b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=f74659bcbe17047bf77ce6a1c9a5bd40 3x"}, "body": "木村さん！\n​お戻りになられてとても嬉しいです！私のことを覚えていらっしゃるかわかりませんが、Johlusです。またよろしくお願いします。\n​今回は復帰の歓迎イラストをリクエストさせていただきたいです。イメージとしては以下のような感じです：\nhttps://www.pixiv.net/en/artworks/143092072#big_0\n​リンク先のイラストのように、足の裏と手のひらが見える構図と、あのかわいらしい視線がとても好きです。もし可能であれば、表情差分もいくつか追加していただけると大変ありがたいです。\n​シチュエーションとしては、ベッドの上で漫画を読んでいるか、ただスマホを見ている姿でお願いします。\n​私のキャラクター（うちの子）の資料は以下の通りです：\nhttps://drive.google.com/file/d/1dnJXeGfVbyd8oTvpEZ02xyG5RnzdK_eO/view?usp=drivesdk\nhttps://drive.google.com/file/d/10Yn19CU23PhCeSBo7z1M-s0KaEMmsWbY/view?usp=drivesdk\nhttps://drive.google.com/file/d/1-ncVHwQzVZnNrHnp_4_zs0I5epO6rwlg/view?usp=drivesdk\n【詳細について】\n表情： 自由に楽しく描いてみてください！\n服装： 1枚目の資料にあるパンダの服でお願いします。\n足元： トレンカ（stirrups）、または資料のような靴下を描いてください。\n特徴： 手のひらと足の裏の色の違いを描写するのが好きなので、ぜひお願いします。そして、「そばかす」を絶対に忘れないでくださいね！\n追加の差分（もし可能であれば）： お尻が露出している（素っ裸の）差分もお願いできないでしょうか？彼の「生意気な悪ガキ」というテーマにぴったり合うと思うからです。\nその他の部分はお任せします。また木村さんにお会いできて本当に幸せです！\n再び私の大切な「息子（うちの子）」を木村さんにお預けします。可愛く、そして少し「生意気な悪ガキ」っぽく描いてください。\nどうぞよろしくお願いいたします！", "nc": 56, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}], "sent_works": [], "similar_creators": [{"id": 394253, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "うなぎねこ’", "screen_name": "unagineco", "avatar_url": "https://pbs.twimg.com/profile_images/1863148017945067521/_WNtoVGp.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1560536874103734272/1677774012/1500x500", "appeal_receivable": false, "pop