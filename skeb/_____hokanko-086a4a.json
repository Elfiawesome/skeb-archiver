cceptable_only_public": false, "tip_acceptable": true, "yearly_report_client_visible": false, "total_appeals_count": 0, "received_works": [{"path": "/@_____hokanko/works/11", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3747021, "client_id": 3531834, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/a4daffcb/uploads/origins/badfd773-501f-4ae4-ad65-46c1fa921226?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e8286970a697dbb675468d841b95c8d7", "srcset": "https://si.imgix.net/a4daffcb/uploads/origins/badfd773-501f-4ae4-ad65-46c1fa921226?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e8286970a697dbb675468d841b95c8d7, https://si.imgix.net/a4daffcb/uploads/origins/badfd773-501f-4ae4-ad65-46c1fa921226?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=572d6f8c935fa4a4ffad7e991b8ca786 2x, https://si.imgix.net/a4daffcb/uploads/origins/badfd773-501f-4ae4-ad65-46c1fa921226?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=0029683622d46f1824c3fcce4468cb7c 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/a4daffcb/uploads/origins/badfd773-501f-4ae4-ad65-46c1fa921226?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=1a2c7f8fbd100e8a66700d9ac1ef981e", "srcset": "https://si.imgix.net/a4daffcb/uploads/origins/badfd773-501f-4ae4-ad65-46c1fa921226?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=1a2c7f8fbd100e8a66700d9ac1ef981e, https://si.imgix.net/a4daffcb/uploads/origins/badfd773-501f-4ae4-ad65-46c1fa921226?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=e608d9b205eb3b5199ac6c1b43c406e5 2x, https://si.imgix.net/a4daffcb/uploads/origins/badfd773-501f-4ae4-ad65-46c1fa921226?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=e5d5e259508d8805f34c7036adc1bc22 3x"}, "body": "柘榴酒さん こんばんは\nいつも素敵なイラスト拝見しております。\n\nもしよろしければ、私のOC二人を描いていただきたくリクエスト失礼いたします。\n\n【OC資料】\nhttps://drive.google.com/drive/folders/1S5FDYv6jT3FOSk75Hg8zi_81iV5VSxz8\n\n【内容】\n拷問器具、血表現などグロテスクさを感じられる雰囲気ですと嬉しいです。NG等はございませんので構図等はおまかせいたします。\n\n【用途】\n個人観賞用 ツイート\nSNSアイコン・ヘッダー等\n\n\nお忙しい中恐れ入りますが、是非ご検討いただけますと幸いです。また不備や金額の不足等ありましたらお気軽に再送ください。何卒よろしくお願いいたします。", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@_____hokanko/works/10", "private_thumbnail_image_urls": null, "private": false, "genre": "video", "tipped": false, "creator_id": 3747021, "client_id": 3393163, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/7c696904/uploads/outputs/31e98aee-7d32-449c-8693-0cf7c76aa38c?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&s=07eb4f05775cc0b9d9671d1ba55166b7", "srcset": "https://si.imgix.net/7c696904/uploads/outputs/31e98aee-7d32-449c-8693-0cf7c76aa38c?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&s=07eb4f05775cc0b9d9671d1ba55166b7, https://si.imgix.net/7c696904/uploads/outputs/31e98aee-7d32-449c-8693-0cf7c76aa38c?bg=%23fff&fm=webp&auto=compress&dpr=2&fit=crop&crop=top&w=200&h=200&s=983d4c64c7a762650ec98526806733f3 2x, https://si.imgix.net/7c696904/uploads/outputs/31e98aee-7d32-449c-8693-0cf7c76aa38c?bg=%23fff&fm=webp&auto=compress&dpr=3&fit=crop&crop=top&w=200&h=200&s=fc973853077a710cc748235fad050c6b 3x"}, "duration": 3, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/7c696904/uploads/outputs/31e98aee-7d32-449c-8693-0cf7c76aa38c?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&blur=200&s=acf6ff2e1b85868c25df3ccdf5f7ab30", "srcset": "https://si.imgix.net/7c696904/uploads/outputs/31e98aee-7d32-449c-8693-0cf7c76aa38c?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&blur=200&s=acf6ff2e1b85868c25df3ccdf5f7ab30, https://si.imgix.net/7c696904/uploads/outputs/31e98aee-7d32-449c-8693-0cf7c76aa38c?bg=%23fff&fm=webp&auto=compress&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=1311579ba27808d1e0e2124f080c5042 2x, https://si.imgix.net/7c696904/uploads/outputs/31e98aee-7d32-449c-8693-0cf7c76aa38c?bg=%23fff&fm=webp&auto=compress&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=050008d6a90dce01a42b0622812432c6 3x"}, "body": "お世話になっております。青野と申します。\n柘榴酒さんの絵柄や、アニメーションの動かし方がとても好みで、今回は柘榴酒さんにアニメーションを描いていただきたく依頼させていただきました。\n\n・要望\nOCのスリーピー・クリスマスを描いていただきたいです。\n構図、ポーズなどは柘榴酒さんにおまかせします。\nホラーっぽい雰囲気だと嬉しいです。\n\n・スリーピー・クリスマス\nイーサンというキャラクターのペットです。森のお屋敷に二人で住んでいます。\n常に無気力、面倒くさがり屋で言葉を発することは滅多にありません。\nイーサンを酷く嫌っており、ほとんどの場合イーサンを無視したり、一人の時間を作ろうとイーサンを無理やり寝かしつけたりします。\n\n彼の趣味はイーサンが寝た後、一人でパソコンを使って都市伝説サイトの怖い話を読み漁ることです。そしてオカルトの知見が深いからか、イーサンが呼び出した霊や悪霊が取り憑いたぬいぐるみ、ドールなどと一緒に、屋敷に肝試しで入り込んできた子供を追い返したり、人柱にしたりします。\n\nスリーピーは基本的に廊下やリビングの床で寝転がっていたりしますが、様々な方法で自殺をするときがあります。その時は決まってイーサンが人柱を使った儀式でスリーピーを蘇らせています。\n\n・資料\nスリーピー・クリスマス\nhttps://drive.google.com/drive/folders/1PVZElMcu6oIuFgmUeJVRLPWnXAyS9D5-\n\n柘榴酒さんのイラストが本当に大好きです。\nぜひご検討のほどよろしくお願いします。", "nc": 17, "word_count": 0, "transcoder": "video", "creator_acceptable_same_genre": false}, {"path": "/@_____hokanko/works/9", "private_thumbnail_image_urls": null, "private": false, "genre": "comic", "tipped": false, "creator_id": 3747021, "client_id": 1116701, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/03409f79/uploads/origins/bc37114b-1d22-440e-9dda-6cc7fba61a97?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9e34ac7d87fca0aa22858cc6045011cf", "srcset": "https://si.imgix.net/03409f79/uploads/origins/bc37114b-1d22-440e-9dda-6cc7fba61a97?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9e34ac7d87fca0aa22858cc6045011cf, https://si.imgix.net/03409f79/uploads/origins/bc37114b-1d22-440e-9dda-6cc7fba61a97?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=4e2bee26c76e7559b63a7ecf268d039b 2x, https://si.imgix.net/03409f79/uploads/origins/bc37114b-1d22-440e-9dda-6cc7fba61a97?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e0ef2d278bf7655b8672a0c9cd20d8d5 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/03409f79/uploads/origins/bc37114b-1d22-440e-9dda-6cc7fba61a97?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3001d31c14b8d4a42b44782cb18c686d", "srcset": "https://si.imgix.net/03409f79/uploads/origins/bc37114b-1d22-440e-9dda-6cc7fba61a97?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3001d31c14b8d4a42b44782cb18c686d, https://si.imgix.net/03409f79/uploads/origins/bc37114b-1d22-440e-9dda-6cc7fba61a97?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=4d7405477b2ba4bdea060bb87c76a809 2x, https://si.imgix.net/03409f79/uploads/origins/bc37114b-1d22-440e-9dda-6cc7fba61a97?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=0c88efb5521e2111ebd47a5137902c52 3x"}, "body": "こんにちは、柘榴酒🌺さん！あなたの画風や過去の作品がとても気に入っています。また私のオリジナルキャラクターを描いていただけないでしょうか？今回は、漫画形式で描いていただきたいです。\n\n登場人物は、人生の異なる段階にある同一人物です。雰囲気は、心理的な独白のようなものです。 若い頃の自分が作り出した精神病院の独房で、若い頃の自分が年老いた自分を世話しているという設定です。\n\nテーマとしては、自己抑制、予言、『コヘレトの言葉』、舌の切除、知識と行動などがあります。\n\nもしPSDファイルのレイヤーに下書きや練習用データが含まれていれば、大変ありがたいです。\n\nリクエストをお読みいただきありがとうございます。良い一日をお過ごしください。\n\nhttps://drive.google.com/drive/folders/1qdZ2Hag_W-_cCom6B9_v4CZojuyiX-Aa?usp=sharing", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@_____hokanko/works/8", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3747021, "client_id": 3273138, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/a034db79/uploads/origins/61937ced-2099-4501-a47f-a77e73b78c1f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=12a3d663103d3f1855a0bfb3f6b2f580", "srcset": "https://si.imgix.net/a034db79/uploads/origins/61937ced-2099-4501-a47f-a77e73b78c1f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=12a3d663103d3f1855a0bfb3f6b2f580, https://si.imgix.net/a034db79/uploads/origins/61937ced-2099-4501-a47f-a77e73b78c1f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e12e4ce1c012d1432a11f1322f99f8d4 2x, https://si.imgix.net/a034db79/uploads/origins/61937ced-2099-4501-a47f-a77e73b78c1f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=4c6e05882c350cd7160267b340217d99 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/a034db79/uploads/origins/61937ced-2099-4501-a47f-a77e73b78c1f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=8f63e0d0c473b4f1e43ece4b84804d57", "srcset": "https://si.imgix.net/a034db79/uploads/origins/61937ced-2099-4501-a47f-a77e73b78c1f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=8f63e0d0c473b4f1e43ece4b84804d57, https://si.imgix.net/a034db79/uploads/origins/61937ced-2099-4501-a47f-a77e73b78c1f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=09aa0e7fe989ba9a2833a166060c5b33 2x, https://si.imgix.net/a034db79/uploads/origins/61937ced-2099-4501-a47f-a77e73b78c1f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=814f4c5ceef801ba08b6b06aab1b3f70 3x"}, "body": "柘榴酒先生、こんにちは！先生の、物語を紡ぐような豊かな世界観が大好きです。うちの子をお願いしたいです。\n\n振り返るたびに場所が変わる、3つのエリアに分かれた謎めいたテーマパーク。テーマパークの中央には、夜だけに回転し、ライトアップされるメリーゴーランドがあります。\n\nそのうちの1つのエリアは、睡蓮が咲き乱れる湖で、空はいつも曇っています。湖の中央にはティーテーブルがあり、その周囲には、眼球やパックンフラワーのように見える、まだ咲いていない芍薬が並んでいます。来園者は、誰かにじっと見られているような感覚を覚えます。この湖を司る「メリーゴーランドの馬」は、性別が定まらないノッケン（水の馬の姿）です。この湖に完全に咲いている芍薬は、ノッケンの帽子の上と襟の周りにあるものだけです。\n\nノッケンちゃんは、来園者に（汚くて濁った沼の水のような）お茶と、美味しいお菓子（実際には昆虫や、妖精の魔法でスイーツのように見せかけられた内臓や体の部位といった、気持ち悪い食べ物）を振る舞います。客が何をしようとも、その運命は決まっている。逃れる唯一の方法は、そもそもテーブルに座らないことです（妖精の贈り物を拒むことも、客に呪いをもたらす）。ノッケンちゃんが魂を食べてたびに、ジャケットの青い部分に、もう一つの蓮のつぼみや葉が現れる。\n\nティーガーデンには、さまざまな動物たちが暮らしています。アヒルたちはティーテーブルの上や下、その周囲をぶらぶらと歩き回っています。鳥たちは人間の言葉を理解し、使用人として働いています。客が日没まで生き残れば、メリーゴーランドで行われるワニ調教ショーの共演者になるチャンスが与えられます。その後どうなるかは不明です。\n\n睡蓮の湖は、モネの絵画をモチーフにしており、あの象徴的な橋もあります。ティーテーブルや茶器については、特に決まったデザインはありません。\n\n構図は先生にお任せします。没ラフや下描きなどがあればPSDに残したままにしていただけると嬉しいです。長いお願いをお読みいただき、またご検討いただきありがとうございます。\n\nhttps://drive.google.com/drive/folders/17GmMCbsME4vr91NLT5L0KHEMDYMZnWUs?usp=sharing", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@_____hokanko/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3747021, "client_id": 1116701, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/fc6d9f02/uploads/origins/0238c7a3-afcf-4565-aafa-418f71dffc61?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0a9c9e1c3f201d5534fc5947e3b183c5", "srcset": "https://si.imgix.net/fc6d9f02/uploads/origins/0238c7a3-afcf-4565-aafa-418f71dffc61?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0a9c9e1c3f201d5534fc5947e3b183c5, https://si.imgix.net/fc6d9f02/uploads/origins/0238c7a3-afcf-4565-aafa-418f71dffc61?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=4617c5ddb459dba5334a32f170fe6c1f 2x, https://si.imgix.net/fc6d9f02/uploads/origins/0238c7a3-afcf-4565-aafa-418f71dffc61?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=5838535240f192be36eba364b627be29 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/fc6d9f02/uploads/origins/0238c7a3-afcf-4565-aafa-418f71dffc61?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=8bd2f39a7b411044fe5ac1a65df10c5d", "srcset": "https://si.imgix.net/fc6d9f02/uploads/origins/0238c7a3-afcf-4565-aafa-418f71dffc61?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=8bd2f39a7b411044fe5ac1a65df10c5d, https://si.imgix.net/fc6d9f02/uploads/origins/0238c7a3-afcf-4565-aafa-418f71dffc61?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=0fcc3e4d6a0774724df6e7bf1c87a74e 2x, https://si.imgix.net/fc6d9f02/uploads/origins/0238c7a3-afcf-4565-aafa-418f71dffc61?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=465565d5779a82d1c1507deef29272c3 3x"}, "body": "こんにちは、柘榴酒さん！あなたの画風がとても気に入っています。私のオリジナルキャラクターを描いていただけないでしょうか？\n\nキャラクターは、人生の異なる段階にある同一人物です。雰囲気は、心理的な独白のようなものです。若い頃の自分が作り出した精神病院の独房の中で、若い頃の自分が年老いた自分を世話しているという設定です。\n\nテーマとしては、自己抑制、予言、『コヘレトの言葉』、舌の切除、知識と行動などです。\n\nもしPSDファイルのレイヤーに下書きや練習用データが含まれていたら、大変ありがたいです。\n\nリクエストをお読みいただきありがとうございます。素敵な一日をお過ごしください。\n\nhttps://drive.google.com/drive/folders/1sZk9SZwFSXz_AwEk1yJKI49Qs7qJrnSO", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@_____hokanko/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3747021, "client_id": 1179131, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/f054867b/uploads/origins/20157858-fa26-4d37-96cb-867811ef46cd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9b34758187e1f3d0c77e2e205c9557e4", "srcset": "https://si.imgix.net/f054867b/uploads/origins/20157858-fa26-4d37-96cb-867811ef46cd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9b34758187e1f3d0c77e2e205c9557e4, https://si.imgix.net/f054867b/uploads/origins/20157858-fa26-4d37-96cb-867811ef46cd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=cbbd7828812b0e7737bbc3044d5b56d0 2x, https://si.imgix.net/f054867b/uploads/origins/20157858-fa26-4d37-96cb-867811ef46cd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=7a0aa05ec880e55e41bf886383645c29 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/f054867b/uploads/origins/20157858-fa26-4d37-96cb-867811ef46cd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5c9f9863ac4a7bf2a810b7de4849c24b", "srcset": "https://si.imgix.net/f054867b/uploads/origins/20157858-fa26-4d37-96cb-867811ef46cd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5c9f9863ac4a7bf2a810b7de4849c24b, https://si.imgix.net/f054867b/uploads/origins/20157858-fa26-4d37-96cb-867811ef46cd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=a556a5750c9a8e4c9613aae1deec85d6 2x, https://si.imgix.net/f054867b/uploads/origins/20157858-fa26-4d37-96cb-867811ef46cd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=52d6e6d7f3c6aaf8515e8a2a7a72b66d 3x"}, "body": "はじめまして、先生の作品は超素晴らしいです！\n先生の描かれる、繊細で緻密かつクラシカルな作風がとても大好きです！もしよろしければ、私のOCのイラストを描いていただけないでしょうか？\n\n先生の描かれる水中シーンがとても大好きです！もしよろしければ、彼が水中に沈んだ船の船室や、墜落した戦闘機のコックピットのような場所（あるいはそれに近いシチュエーション）で、床に散らばった映画フィルムのリールを整理している場面を描いていただけないでしょうか？\nここは、アーカイブや収蔵室のような場所です、フィルムは友人の運命の神から彼への贈り物です。彼が訪れるたびに、二人で一緒に運命の神が撮った映画を観るのです。\n（運命の神は、様々な奇妙な筋書きの映画を撮影することに熱心な監督です……正直言って、センスはなかなか評価しづらいのですが。ただ、今のところまだ彼のビジュアルは決まっていないので、今回は登場させなくても大丈夫です。）\n船室内の計器盤や、周囲を泳ぐ水中生物、珊瑚なども、もしご興味がありましたらご自由に描いていただけますと嬉しいです。\n具体的な衣装デザインにつきましては、フォルダ内のものからご自由にお選びください。シーンに合わせて、先生のお好みで新たにアレンジ・再デザインしていただいても大歓迎です！\n\n可能であれば、別レイヤーにサインを入れたpsdファイルをご提供ください。また、先生が下書きや未使用のrkgkなどを作品に残しておいてくださると、アイデアの変遷を見ることができるのでありがたいです！\n\nご依頼をお読みいただき、ご検討くださり誠にありがとうございます！お気に召さない場合は、遠慮なく直接キャンセルしてください。\n\nhttps://drive.google.com/drive/folders/1PYkZmltyHjisP3W_lmm7TlD3Ey5VoM68?usp=sharing", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@_____hokanko/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3747021, "client_id": 204344, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/8f1b2fbc/uploads/origins/eda6f085-6408-4efe-89ef-47e3644006dd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bc7fbf5c09028d7cf5ac920e51faa73a", "srcset": "https://si.imgix.net/8f1b2fbc/uploads/origins/eda6f085-6408-4efe-89ef-47e3644006dd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bc7fbf5c09028d7cf5ac920e51faa73a, https://si.imgix.net/8f1b2fbc/uploads/origins/eda6f085-6408-4efe-89ef-47e3644006dd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=3aff39733eb07db39a9b87b120275ecf 2x, https://si.imgix.net/8f1b2fbc/uploads/origins/eda6f085-6408-4efe-89ef-47e3644006dd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c246a283d345e5345a95f7b92fa1554a 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/8f1b2fbc/uploads/origins/eda6f085-6408-4efe-89ef-47e3644006dd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f498ac0d08d15c847f39ee476b437557", "srcset": "https://si.imgix.net/8f1b2fbc/uploads/origins/eda6f085-6408-4efe-89ef-47e3644006dd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f498ac0d08d15c847f39ee476b437557, https://si.imgix.net/8f1b2fbc/uploads/origins/eda6f085-6408-4efe-89ef-47e3644006dd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=65cbee46726576a520a5ab5cdad8fd5d 2x, https://si.imgix.net/8f1b2fbc/uploads/origins/eda6f085-6408-4efe-89ef-47e3644006dd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=9a65ff9f107b402286c263fcea30b13d 3x"}, "body": "Hello, I really love the atmosphere of your art! Can I request my OC in a tea party? She is a gloomy undead rose girl around 10 years old. https://toyhou.se/1266678.emrys\nThe tea party is in my OC's dreams, so I would like elements indicating that it is not reality. Being at a tea party in cute lolita clothing has always been her dreams, but she is stuck eternally in a haunted forest. I would like her to look happy with a gentle smile.\nFeel free to design a lolita dress for her. If you prefer not to, you can use this outfit instead.\nhttps://drive.google.com/file/d/1qL07-0FQx3xsgJdT2byA_euIaLYbNqJR/view?usp=sharing\nIf you have any unused drafts, I would be grateful if you can also include it in the PDF.\nThank you for considering!", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@_____hokanko/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3747021, "client_id": 3840857, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/9dc533b1/uploads/origins/c3e4a4f9-e3f2-4586-915b-a008caf16a41?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8630686e00e8b2cfddcf5259a3fa20a3", "srcset": "https://si.imgix.net/9dc533b1/uploads/origins/c3e4a4f9-e3f2-4586-915b-a008caf16a41?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8630686e00e8b2cfddcf5259a3fa20a3, https://si.imgix.net/9dc533b1/uploads/origins/c3e4a4f9-e3f2-4586-915b-a008caf16a41?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=42878e3581648a22897c5ca2298f8694 2x, https://si.imgix.net/9dc533b1/uploads/origins/c3e4a4f9-e3f2-4586-915b-a008caf16a41?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=30970dca39e36d65dd0bba9c948202f1 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/9dc533b1/uploads/origins/c3e4a4f9-e3f2-4586-915b-a008caf16a41?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e635d4a83986ccb6cef20abbea6ae792", "srcset": "https://si.i