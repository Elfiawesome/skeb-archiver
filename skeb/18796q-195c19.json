のSNS、HP等での活動全般\n・収益化の通っているYouTubeのサムネイル ( 収益化の可能性)\n・FCメンバー向けネットプリント\n\n【希望デザイン】\n愛莉・ラヴレースの世界観に合ったイラストを描いていただきたいです。\n\n【雰囲気が好きイラスト】\n\nhttps://skeb.jp/@18796q/works/8\nhttps://skeb.jp/@18796q/works/2\n\n\n【その他の要望】\n・PSD(文字・人物・背景)で分けていただけますと幸いです。\n・350DPI\n・16:9 \n\n頭や髪、手が途切れないようにして頂けると嬉しいです。\nご検討いただけましたら幸いです。\nどうぞよろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/1SxBDKgVV8hj_J1WhJcgbP0QRZbVdEyjb?usp=sharing", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@18796q/works/13", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3951257, "client_id": 897326, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/4beae7d2/uploads/origins/7b7072f6-2a49-4dca-a27c-40fa791a0e23?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8a3fc316e33a090d7994c04ea6daef96", "srcset": "https://si.imgix.net/4beae7d2/uploads/origins/7b7072f6-2a49-4dca-a27c-40fa791a0e23?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8a3fc316e33a090d7994c04ea6daef96, https://si.imgix.net/4beae7d2/uploads/origins/7b7072f6-2a49-4dca-a27c-40fa791a0e23?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=eefb38b818061febe29af441871dc582 2x, https://si.imgix.net/4beae7d2/uploads/origins/7b7072f6-2a49-4dca-a27c-40fa791a0e23?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=213fb31ef48f17ae44c3a62d897ea74b 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/4beae7d2/uploads/origins/7b7072f6-2a49-4dca-a27c-40fa791a0e23?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6f87f9ea337a90e725da9117e1ace485", "srcset": "https://si.imgix.net/4beae7d2/uploads/origins/7b7072f6-2a49-4dca-a27c-40fa791a0e23?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6f87f9ea337a90e7