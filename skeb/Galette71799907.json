ble_same_genre": false}, {"path": "/@Galette71799907/works/128", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 269780, "client_id": 0, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/3e1869ae/uploads/origins/3e1e8ee4-0191-4e13-b65b-18b694ab0b2c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ada35c3f4057076df936973ec66349d6", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/3e1869ae/uploads/origins/3e1e8ee4-0191-4e13-b65b-18b694ab0b2c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2e47212b1289d1846a3b0312f17fa555", "src_set": ""}, "body": "初めまして、失礼致します。\n巨大なコディアックヒグマさんが一口で頬張れるサイズの獲物さんを長い舌で舐め回したり呑み込んでお腹を膨らませているイラストをお願いします！\n\n構図としましては\n・肘を付いてクロスさせた腕の中に獲物を抑えながら乱暴に舐め回してる\n・どっしり座り込んだ姿勢でモゴモゴ蠢くお腹を悪そうな顔で見下ろしている\n\n食べられちゃう子は作者さんにお任せしまして、全体的な雰囲気としてはモンハンの拘束攻撃みたいな荒々しい感じでお願いします！", "nc": 176, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@Galette71799907/works/127", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/94db039c/uploads/origins/95fcb3be-44fc-407d-b887-67b411254cff?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=dda4cff84c00f2e480e802c64cea2826", "src_set": ""}, "private": true, "genre": "art", "tipped": false, "creator_id": 269780, "client_id": 25467, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 161, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@Galette71799907/works/126", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 269780, "client_id": 421066, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/f01a0b92/uploads/origins/37772b2e-7527-47b0-b986-cde9d3d63810?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=74ea52ab1ea5d0ce4ce4a128853a4eae", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/f01a0b92/uploads/origins/37772b2e-7527-47b0-b986-cde9d3d63810?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b09101c8a2039effcc8394b5fa378fd8", "src_set": ""}, "body": "初めまして。きれいなお姉さんを描かれるのを見て今回送らせていただきました。\nよろしければこちらの青い狼さんをがれっとさんの思った姿で描いて頂けましたらと思います。\n以下資料です。\n\nhttps://www.dropbox.com/scl/fi/mf70qydt371962fzc1u7u/blue-wolf.zip?rlkey=2z5gefwogifgwxywyb60nlouw&st=mh0kcxtr&dl=0", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@Galette71799907/works/125", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 269780, "client_id": 2550500, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/fcae36f1/uploads/origins/53b5ed63-ff56-4b52-8b64-59c796abd92c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4b57aa2b0239362e18b85df16df7f4b9", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/fcae36f1/uploads/origins/53b5ed63-ff56-4b52-8b64-59c796abd92c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=7d87e015202413e00e2f8b56309c3295", "src_set": ""}, "body": "初めまして、Xで見かけた百合OC集がすごくすごく良かったので、うちのこの百合イラストをお願いしたいです。\n値段に不足があれば再送をお願いしたいです。\n【キャラクター】\n2人でヒーローをやっている。表向きは健全だが、2人きりのときは2人ともとってもイチャイチャしている。\n【狐】\n優しくてとっても強い九尾の狐のお姉さん。３０歳くらい。元人間。むっちりしている。\n耳まで含めて１７０センチメートルくらい。\n兎の先輩であり師匠だが、とってもドMで兎にいじめられるのがすき。\n【兎】\n内気でむっつりすけべな兎のお姉さん。\n２０歳くらい。\nピンとたった耳含めて狐とおなじくらいの身長（抱き締めあうと目線が上になる）。\n元人間で、兎になったときにすごく発情しやすくなってしまい、狐にいつもなんとかしてもらってる。\n参考資料ではむっちりしてるが、すらっとした感じでお願いしたいです（胸は大きく）。\n【シチュエーション】\n2人とも裸で、見つめあってるイラスト。\nお互いの手で相手の身体を触れている（orいじっている）。\n狐は首輪をつけており、リードを兎に持たれている。\nお互い顔をあからめ興奮し、息を切らしている。特に狐は、胸から液体がでたり、汗だくで凄く興奮している。\nいつも描いてるケモノがとっても凄く好きなので、依頼したいと思いました。描いていただけたら嬉しいです。\n\nhttps://drive.google.com/drive/folders/1-58XmmO9Z5-9CKg0O4MFKWF1oQoPvWIB", "nc": 160, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@Galette71799907/works/124", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 269780, "client_id": 205904, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/2a102ffd/uploads/origins/95a21256-ea55-41bc-aae1-0a1afd6fc978?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3532593cfd22486dc5cb0af1448bbe6b", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/2a102ffd/uploads/origins/95a21256-ea55-41bc-aae1-0a1afd6fc978?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=447aadf8c9523b89b40da4740460850c", "src_set": ""}, "body": "再びこんにちは！私のクマのラキエル（https://drive.google.com/drive/u/1/folders/1du6EIFZNtyenw6al-JDfpyqY-GUZl7lK）が、あなたの以前の作品と同じような横向きポーズで横たわっている画像をリクエストしたいのですが: https://skeb.jp/@Galette71799907/works/53\n\nこのリクエストを検討していただきありがとうございます！\n\nhttps://drive.google.com/drive/u/1/folders/1du6EIFZNtyenw6al-JDfpyqY-GUZl7lK", "nc": 161, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@Galette71799907/works/123", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 269780, "client_id": 1096122, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/b89a2371/uploads/origins/7d5644ac-620b-4762-a917-d34cfe0e7c03?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=982a11eed0711f4d0481f758e3ace63a", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_t