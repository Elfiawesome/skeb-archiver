7ca/uploads/origins/45b010f4-f7f3-4575-807d-89157394a415?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=629bf63d1255053478ab6261f6ef723c", "srcset": "https://si.imgix.net/595207ca/uploads/origins/45b010f4-f7f3-4575-807d-89157394a415?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=629bf63d1255053478ab6261f6ef723c, https://si.imgix.net/595207ca/uploads/origins/45b010f4-f7f3-4575-807d-89157394a415?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f7e019e5bea099734a199f0e300f462f 2x, https://si.imgix.net/595207ca/uploads/origins/45b010f4-f7f3-4575-807d-89157394a415?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=98922a296db099500b3a9d9e741b1eca 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/595207ca/uploads/origins/45b010f4-f7f3-4575-807d-89157394a415?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=49fbe8312980b1a4c093cc8d3c16b850", "srcset": "https://si.imgix.net/595207ca/uploads/origins/45b010f4-f7f3-4575-807d-89157394a415?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=49fbe8312980b1a4c093cc8d3c16b850, https://si.imgix.net/595207ca/uploads/origins/45b010f4-f7f3-4575-807d-89157394a415?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=f49699c8032a6983d5a8fab289fcacfb 2x, https://si.imgix.net/595207ca/uploads/origins/45b010f4-f7f3-4575-807d-89157394a415?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=4e003b3c408f508f64f0172d36a07949 3x"}, "body": "こんばんは、キラキラ可憐で素敵なイラストを拝見して、今回うちの子たちを描いていただきたくリクエスト致します。\n変身ヒロインの『メーテライト・ルミエーラ』と相棒マスコットの『ウィル』で、下記デザイン資料はリクエストへの使用許可済です。\n【デザイン説明】\n主なデザインは最下部の資料URLをご参照ください。\n以下特徴的な要素です。\n▼ルミエーラ\n・性格や雰囲気は「人懐っこい・優しい・可愛らしい・清楚」のモチーフ。高校生くらいの純粋でまっすぐな女の子。\n・顔立ちはまつ毛がすらっと長い、少女から少し大人びた雰囲気。\n・瞳には黄色い星のハイライト。\n・頭部の髪飾りやティアラ、白いもふもふ装飾はそれぞれ独立してついている。\n・後髪は首元で内側にまとまってから、背中辺りから分け目が外側にふわっと広がる。後髪半ばのシルエットが天使の羽根のようにも見える意図。\n・胴のドレスと二の腕のフリルとはそれぞれ独立した装飾。脇下は繋がっていません。\n▼ウィル\n・まんまる子竜。口は開かず目の表現や身体の動きで感情表現する。\n・額の宝石の他に、おしりの辺りの赤色も同じ宝石。目元の赤色の方は模様。\n不明点や衣装・装飾の省略・簡易化などはすべておまかせ致します。\n\n【構図など希望】\n普段のイラストの雰囲気がとても素敵だったので、特に指定はせず可愛らしさや凛とした雰囲気でおまかせします！\nウィル(マスコット)の方は傍に浮かせたり頬を寄せたり、両手の平や肩などに乗せたり自由にお願い致します。\n\n【使用用途】\nTwitter含むSNSでのアイコン、ヘッダー使用・イラスト紹介・紹介ツイートをtogetter(min.t)などの自身のまとめへ追加。\nリクエストする際に上記まとめのURLを引用する場合があります。\n\n【その他】\nPSD形式希望で、恐縮ですが宛名とそれぞれのキャラと背景のレイヤー分けをお願い致します。分離不可の場合は統合状態を問いません。\n以上、検討のお時間をいただき恐縮ですが、どうぞよろしくお願いします！\n\n●まとめ一覧\nhttps://min.togetter.com/FfDRT8U\n\n●資料URL\nhttps://drive.google.com/drive/folders/1BQq76eifAKcR-5nOzMmRwB8Koi4axmss?usp=sharing\n\nhttps://drive.google.com/drive/folders/1BQq76eifAKcR-5nOzMmRwB8Koi4axmss?usp=sharing", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 13987, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "ブラニン", "screen_name": "buraninn", "avatar_url": "https://pbs.twimg.com/profile_images/1381521033379733504/EzJcJtjq.jpg", "header_url": "https://pbs.twimg.com/profile_banners/525039013/1732346355/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "art"}], "banned": false, "nc": 1}, {"id": 394581, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "ユタリビャク🌳", "screen_name": "byaku_yutari", "avatar_url": "https://pbs.twimg.com/profile_images/1352468317638823938/tbO0sm_8.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1129765432267661312/1559660936/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expira