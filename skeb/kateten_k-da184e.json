イラスト内に一言頂ければ嬉しいと思います。\n「守護輝士の世界ではこれが殿方への正式なご挨拶のポーズなのでしょうか…？なんだか、その…私、恥ずかしさの余り、蒸れてしまって…」\nみたいなセリフを！\n\nご検討くださいませ。", "nc": 49, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [{"path": "/@kakitaran/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 90595, "client_id": 420966, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/61781cb6/uploads/origins/ff18663f-3325-462d-8934-2850483fa3a5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9ceddbd8eac19026531c3bd584be6537", "srcset": "https://si.imgix.net/61781cb6/uploads/origins/ff18663f-3325-462d-8934-2850483fa3a5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9ceddbd8eac19026531c3bd584be6537, https://si.imgix.net/61781cb6/uploads/origins/ff18663f-3325-462d-8934-2850483fa3a5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=dca6964fba243ddd6d5d706728f8dc20 2x, https://si.imgix.net/61781cb6/uploads/origins/ff18663f-3325-462d-8934-2850483fa3a5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=8ba81b30a32235f89813f68d0a61afe2 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/61781cb6/uploads/origins/ff18663f-3325-462d-8934-2850483fa3a5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=07bc0119078b7ed4114112c193c4e645", "srcset": "https://si.imgix.net/61781cb6/uploads/origins/ff18663f-3325-462d-8934-2850483fa3a5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=07bc0119078b7ed4114112c193c4e645, https://si.imgix.net/61781cb6/uploads/origins/ff18663f-3325-462d-8934-2850483fa3a5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=899f0ea66917f68dccf505e3bd7aa649 2x, https://si.imgix.net/61781cb6/uploads/origins/ff18663f-3325-46