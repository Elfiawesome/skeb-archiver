e8059ff9-f426-4d5b-b27e-2a0fd0f6f407?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&s=55b5914cabf0d731f4296b8a78b67a0e, https://si.imgix.net/1e2f3643/uploads/origins/e8059ff9-f426-4d5b-b27e-2a0fd0f6f407?bg=%23fff&fm=webp&auto=compress&dpr=2&fit=crop&crop=top&w=200&h=200&s=214bd6eed4660643ff0af2ceed29ab6b 2x, https://si.imgix.net/1e2f3643/uploads/origins/e8059ff9-f426-4d5b-b27e-2a0fd0f6f407?bg=%23fff&fm=webp&auto=compress&dpr=3&fit=crop&crop=top&w=200&h=200&s=38e31b1f5c21d5dcff48659760bcc47d 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/1e2f3643/uploads/origins/e8059ff9-f426-4d5b-b27e-2a0fd0f6f407?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&blur=200&s=6365cc7cd621890cb9d79990232dacfe", "srcset": "https://si.imgix.net/1e2f3643/uploads/origins/e8059ff9-f426-4d5b-b27e-2a0fd0f6f407?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&blur=200&s=6365cc7cd621890cb9d79990232dacfe, https://si.imgix.net/1e2f3643/uploads/origins/e8059ff9-f426-4d5b-b27e-2a0fd0f6f407?bg=%23fff&fm=webp&auto=compress&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=8099409900d1420890dc32fc6f6dbbfe 2x, https://si.imgix.net/1e2f3643/uploads/origins/e8059ff9-f426-4d5b-b27e-2a0fd0f6f407?bg=%23fff&fm=webp&auto=compress&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=a77f3be57d3df7625d130387ddf190e4 3x"}, "body": "るーく様\n\n初めまして、享年Vtuberの戦場武人(ｲｸｻﾊﾞ ﾀｹﾋﾄ)と申します。\n突然のご連絡を失礼いたします。\n\n名前は伏せますが以前、友人のVtuberの方のイラストを拝見させていただいておりました。その際に他にもデジモンや主人公のイラストも描かれており、自身もいつか描いていただきたいと思い今回ご連絡をさせていただきました。\n\n１．衣装について\nデジモン用の専用衣装にてイラストをお願いしたく存じます。\n\n２．構図について\n構図はお任せにてお願いいたします。\n描いていただいたイラストを「BOX開封」もしくは「カードゲームプレイ」の配信にて使わせていただきたいです。\nそのため、大雑把とはなりますがカードを手に持っているような構図ですと幸いです。(お任せですのでるーく様の思うままで大丈夫です。)\nデジモンを描いてくださるのであれば、よろしければギルモンもしくはドルモンをお願いいたします。(高火力デッキの主軸としてよく使うので)\n\n３．利用用途について\n2の上記よりカード開封配信時のサムネイル、Live2d利用不可の際に使わせていただきたいです。また、XのSNS投稿時に使わせていただく可能性もございます。\n\n４．その他要望\n利用用途において、イラストをいただく際には\n背景透過をしていただけますと幸いです。\n\nVtuber活動が現在3月末ほどまでは仕事の都合にてXへの投稿頻度は少ないですが、4月からの復帰配信に向けて是非お力添えをいただければと思います。\n\nご検討のほどよろしくお願い致します。\nX：https://twitter.com/Ikusaba_1938\nYoutube：https://www.youtube.com/channel/UC1V5BUxhvB_pw0IEYJRxOxg?view_as=subscriber\n\nhttps://twitter.com/Ikusaba_1938/status/1720074381861523568", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@ruuku000/works/2", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/d0d63903/uploads/origins/34676937-be94-41b7-b113-8ef8b9e8fe5e?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=1844784255cc15b0364cb69640d35820", "srcset": "https://si.imgix.net/d0d63903/uploads/origins/34676937-be94-41b7-b113-8ef8b9e8fe5e?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=1844784255cc15b0364cb69640d35820, https://si.imgix.net/d0d63903/uploads/origins/34676937-be94-41b7-b113-8ef8b9e8fe5e?bg=%23fff&fm=webp&auto=compress&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=68e07deb8f1285aa0d1a50d6e7b86f6d 2x, https://si.imgix.net/d0d63903/uploads/origins/34676937-be94-41b7-b113-8ef8b9e8fe5e?bg=%23fff&fm=webp&auto=compress&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=7b611adf12fc763c6f1013e77e9da03b 3x"}, "private": true, "genre": "art", "tipped": false, "creator_id": 797510, "client_id": 649630, "nc": 33}, {"path": "/@ruuku000/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 797510, "client_id": 2299828, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/49a10bd5/uploads/origins/2a24e797-8a99-4621-bf08-9a26e69d4da1?bg=%23fff&fm=webp&auto=comp