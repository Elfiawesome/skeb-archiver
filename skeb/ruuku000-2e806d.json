は分けた形のデータ(背景透過)で納品していただけると助かります。\n\n以上、ご検討のほどよろしくお願いいたします。\n\nTwitter：https://twitter.com/dejidejii\nYouTube：https://www.youtube.com/@kimayori\n身長：164cm\n体形：細身に見えて脱ぐと意外と筋肉がある締まった身体つき\n性別：男\n\nhttps://drive.google.com/file/d/1DIYq3HiJD4LiW_rh6Jc7aSbz3aozktcv/view?usp=sharing", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 40450, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "姉崎🔞", "screen_name": "yuanei", "avatar_url": "https://pbs.twimg.com/profile_images/1986743400503422976/lCKsW4i3.jpg", "header_url": null, "appeal_receivable": true, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 3, "complete_expiration_days": 20, "skills": [{"genre": "art"}], "banned": false, "nc": 176}, {"id": 686789, "creator": true, "nsfw_acceptable": true, "acceptable": false, "name": "おおき", "screen_name": "oh_ki_ik", "avatar_url": "https://pbs.twimg.com/profile_images/1610932690890690560/ELSAScDP.jpg", "header_url": null, "appeal_receivable": true, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 120, "skills": [{"genre": "art"}, {"genre": "comic"}], "banned": false, "nc": 49}, {"id": 831286, "creator": true, "nsfw_acceptable": true, "acceptable": false, "name": "葛生", "screen_name": "saio5410", "avatar_url": "https://pbs.twimg.com/profile_images/1526585584839725056/WWpybnx-.jpg", "header_url": null, "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "art"}], "banned": false, "nc": 176}, {"id": 1209926, "creator": true, "nsfw_ac