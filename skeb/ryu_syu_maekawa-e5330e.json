ges%2F1878815183130484736%2Fc9Clt-BN.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9759f3d411366e8de50c5cdf12c5517a, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1878815183130484736%2Fc9Clt-BN.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=fb64a520baecde3358fcda3554186939 2x, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1878815183130484736%2Fc9Clt-BN.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=7884983e9a4a3a154ca6f8ee14812b18 3x"}, "preview_url": "https://fcdn.skeb.jp/uploads/outputs/12560462-f793-49b4-bf65-95265b728e41?response-content-disposition=inline&Expires=1781877868&Signature=kOpZN6m36mzksZzqycTQuPAupUcC3JZX60kN-3Ga2PRAOFc01mQNC4rAVcsIrIeSpuPv1-vGwiAiX9ndS-8QyCEFdkiQhWaVEwly-wxNJa0dgcjvRZvKzB8WkncRgnR5HUvsFmf5rpu4i-yL5Cg1kFFVhykUrrPa~Iea3kaapW-gGAq6-gZGKIlUVWPsNr0FI~K1DMZ4sLuGbjw0lah-l-MqWv64t4K4UQlmNU2BFOs-3Frn7Igpqj7PYJOvtebDq-B8siZA7PwYE3KJlgBKCKsLr9kmUmvBlPm52wdIdOl8h1TQRKFTRWVe01LMhCRVqAwRgZjWELonkIn9pKXxlA__&Key-Pair-Id=K1GS3H53SEO647", "duration": 264, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1878815183130484736%2Fc9Clt-BN.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0b9d9acee0dd2c7fd68e97a28e05c2c7", "srcset": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1878815183130484736%2Fc9Clt-BN.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0b9d9acee0dd2c7fd68e97a28e05c2c7, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1878815183130484736%2Fc9Clt-BN.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=d75b09a24e5d9e2b1908552357528848 2x, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1878815183130484736%2Fc9Clt-BN.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=c84ddd0205b2feebee4f6e8c7c71f1d0 3x"}, "body": "こんにちは、現在自分が好きなゲームのプレイ人口を増やしたく紹介動画を製作しています。今回はナレーションを依頼したくリクエストを送らせて頂きました。完成した動画はYoutubeに投稿させていただきたいです。詳しくは資料URLをご覧ください。(動画は制作中のものであり変更される場合があります。動画内の字幕はあくまで目安としてお考え下さい)\n以下台本になります。\n\nTeamFortress2とは\nvalve softwareが開発し\n2007年10月10日に配信が開始された\n基本プレイ無料のスポーツ系カジュアルFPSゲームです\n\n10年以上前のゲームでありながら\nアップデートで新要素が追加されたり\n連日10万人超のプレイヤーがオンラインの\nスチームが誇る人気タイトルの一つです\nこの動画は\nTeamFortress2というゲームを\nやったことがない\nもしくは、これから始めようとしている方へ向けた\n初心者向け解説動画となっております\nFPSを経験したことのない方にも\nはじめの一歩を踏み出してもらえるように\nわかりやすく紹介しますので\nよろしくお願いいたします。\n\nFPSは大きく2つに分類することができます\nそれがリアル系とスポーツ系です\nリアル系FPSとは\nタルコフやバトルフィールドなどに代表される\nリーンや偏差射撃といった、現実的な挙動を再現したFPSです\n次にスポーツ系FPSとは\n別名“アリーナシューター”とも呼ばれ\nキャラクターはスキルやアイテムを駆使して\nビュンビュン移動しながらド派手な武器をぽこじゃか撃ち合う\n代表的なゲームとしてオーバーウォッチや(コールオブデューティー)インフェニットウォーフェアなどがあります\nそんな感じで、TeamFortress2はスポーツ的な明快さや爽快感を重視したFPSの中でもかなり「ユルい」部類のゲームとなっております\n初めてのFPSにもぴったりというわけですね\n\nとりあえずゲームを起動したら\nゲームを検索\nカジュアルマッチのモードをすべて選択して\n検索開始しましょう\n\nTeamFortress2ではプレイヤーがレッドとブルーそれぞれのチームに分かれて勝利を目指します\n公式サーバーでは1チーム12人最大24人でプレイします\n勝利条件ですが大きく分けて\nコントロールポイントの制圧、防衛\n機密情報の奪取\nペイロードの運搬、阻止\nの3種類になります\nここでピーンときた方もいると思いますが\nこのゲームキルデスが直接勝敗には関係しません、キャラクターが倒れてもリスポーンルームから無限復活できるので遠慮なく死にながら覚えましょう\n\nさて、マッチに参加できましたね\nマップとゲームモードを確認したら\nクラスを選びましょう\n性能の違うキャラクターは全部で9種類\nみんな一癖も二癖もあります\nデザインにも顕著に表れていますね\n各キャラの紹介は動画一本作れるほどなので\n今回は簡単に説明しましょう\n\nTF2のスピードスター\nお前の弾より俺のが速いぜ\nスカウト\n\n攻めるも守るも自由自在\nロケットジャンプで空から爆撃\nソルジャー\n\n出会い頭で着火しよう\nフレンドリー\"ファイア\"はこのゲームの挨拶\nパイロ\n\n放物線を描く爆弾で死角から攻撃\nデモマン\n\nミニガンの弾幕は前線にて最強\n他を圧倒する体力と火力\nヘビー\n\n建築物で味方をサポート\nセントリーは狙いを外さない\nエンジニア\n\n前線医療はビームでおまかせ\nユーバーチャージで流れを変えよう\nメディック\n\nスコープ覗いてフルチャージ\n超遠距離から頭をブチ抜く\nスナイパー\n\n変装と透明化で敵を欺く\n背後からの一撃はヘルス無視の一撃必殺\nスパイ\n\nこんな感じで性能の違う9人から使いたいクラスを選びましょう\nちなみに、チームメイトの選んだクラスは画面右下で確認できます\nチームのバランスを考える事も勝利へのポイントです\nどのクラスを選べばいいかわからない、そんなときは\nソルジャーやデモマン、メディックなどがおすすめです\n多くてもあまり問題になりませんし最前線で戦っているうちにマップを覚え、自然と上達に繋がるでしょう\n\nさて、ここまでご視聴いただきありがとうございました\nTF2はマルチプレイFPSの中でも気軽にプレイできるゲームと言えます\nこの動画をご覧になって気になった方、少しでも興味を持っていただけた方是非プレイしてみてください\nあなたにぴったりのプレイスタイルがきっと見つかるはずです。\n\n次に会うときはゲームの中かもしれません。それか、次の紹介動画で・・・\n\nhttps://youtu.be/Wh0Aed8seyA", "nc": 25, "word_count": 0, "transcoder": "audio", "creator_acceptable_same_genre": true}, {"path": "/@ryu_syu_maekawa/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "voice", "tipped": false, "creator_id": 35517, "client_id": 494100, "vtt_url": "https://fcdn.skeb.jp/uploads/169459/0/vtt/0.vtt?response-content-disposition=inline&Expires=1781877868&Signature=pRAuTvx03cJjka8xbZMciRUwG6k~qz1VRCBW9bJIAoi1Hkon61Lng7p0cj3APu7LAed3n8nTlYJahqH7ggcT~hEN9Cb8CKRfOrvrzIk52Akgz5PQJiIRg~HoGYdsBZfOEhHQWVd5nKPi08Bov3-lp0wpEnrvbGKWcYjX2wPKIyi6awrJh4K9HCxem7vhsIphRmVh4fjYEJmpxkV2n2a~75TsjudUZiaiTq~PKisfZn1gZJ4cIkzE0xpWPseKHCZJ6t~F5uoCZMTOD6l5V-ThdkgZNOEicneQBX1yxNLb0K8b39xut~PNLEPMMm9~cz5-LYlUECW7-mqtzSX1K5orvw__&Key-Pair-Id=K1GS3H53SEO647", "thumbnail_image_urls": {"src": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1878815183130484736%2Fc9Clt-BN.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9759f3d411366e8de50c5cdf12c5517a", "srcset": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1878815183130484736%2Fc9Clt-BN.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9759f3d411366e8de50c5cdf12c5517a, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1878815183130484736%2Fc9Clt-BN.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=fb64a520baecde3358fcda3554186939 2x, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1878815183130484736%2Fc9Clt-BN.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=7884983e9a4a3a154ca6f8ee14812b18 3x"}, "preview_url": "https://fcdn.skeb.jp/uploads/169459/0/mp3_128k/0?response-content-dispositio