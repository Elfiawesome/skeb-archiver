d0/uploads/origins/1afdefa1-75cd-4c71-a71c-c0872881a921?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=1c01a7f0f7c457376dc1924de7999086", "srcset": "https://si.imgix.net/ed662ad0/uploads/origins/1afdefa1-75cd-4c71-a71c-c0872881a921?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=1c01a7f0f7c457376dc1924de7999086, https://si.imgix.net/ed662ad0/uploads/origins/1afdefa1-75cd-4c71-a71c-c0872881a921?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=f9bbdef9289003c3f438f1148f7135e5 2x, https://si.imgix.net/ed662ad0/uploads/origins/1afdefa1-75cd-4c71-a71c-c0872881a921?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=5b3e345034b8569267dee3ab2c77f8eb 3x"}, "body": "こんにちは、びゅーぽいんとさん！\n先生の可愛い女子高生のイラストがとても好きで、ぜひ自分のオリキャラを描いていただきたいです！\n\n彼女は一見普通の可愛い女の子ですが、実は夜になると悪党と戦う裏の傭兵です。\n性格はあまり可愛くなく、無愛想で攻撃的、すぐ調子に乗ってトラブルを起こすこともあります。\n\n参考資料はこちらにまとめてあります：\nhttps://drive.google.com/drive/folders/1Um2qI8y0AJBLVGkpu2jhNQuXk6hNw_hO?usp=sharing\n\nもしよければ、びゅーぽいんとさんが似合うと思う冬服のセーラー服の実在制服を彼女を着せて描いていただけませんか？\nイラストの構図や雰囲気などの細かい部分は、すべておまかせします！\n\nお時間をいただきありがとうございます。どうぞよろしくお願いします！", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@__viewpoint__/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2538961, "client_id": 2829683, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/a049482c/uploads/origins/0809fa54-7646-4ceb-9488-a3855d02ccb7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d160848a3811c26775ddbd71b4c4982c", "srcset": "https://si.imgix.net/a049482c/uploads/origins/0809fa54-7646-4ceb-9488-a3855d02ccb7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d160848a3811c26775ddbd71b4c4982c, https://si.imgix.net/a049482c/uploads/origins/0809fa54-7646-4ceb-9488-a3855d02ccb7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=deac5a33ae4d2914c2dae7cc1803d46f 2x, https://si.imgix.net/a049482c/uploads/origins/0809fa54-7646-4ceb-9488-a3855d02ccb7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=127975de0526ba90c7efd343146804cf 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/a049482c/uploads/origins/0809fa54-7646-4ceb-9488-a3855d02ccb7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=221068226352ee6a764a25aab29b83c0", "srcset": "https://si.imgix.net/a049482c/uploads/origins/0809fa54-7646-4ceb-9488-a3855d02ccb7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=221068226352ee6a764a25aab29b83c0, https://si.imgix.net/a049482c/uploads/origins/0809fa54-7646-4ceb-9488-a3855d02ccb7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=10b7b64af50a9c9becb8c3a3c6c1a6bf 2x, https://si.imgix.net/a049482c/uploads/origins/0809fa54-7646-4ceb-9488-a3855d02ccb7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=9e24d31ae39eaffad56c82449316f2d8 3x"}, "body": "お世話になっております。\n以下仕様です（顔はこれでもかって言うくらいかわいく）\n・テーマは「理系女子高校生とギャル女子高生の融合」です。\n・制服女子（リボンは色をピンク色に変更しておおきく。ブラウスを着用。首元のボタンは開いている。リボンはゆるゆるで、首元のボタンは開いている。）実験用の白衣を着ていて、ボタンはしていない。（開放状態）\n・丸眼鏡（はっきりわかるように、）\n・手は腕を伸ばしてピース（左手）\n・右手には英語の論文集を抱えている。\n・髪の毛の色（茶髪）\n・髪型（ツインテールで出来れば結び目にリボンのアクセントが欲しいです）\n・スカートは青色でチェック柄で短め\n…作図範囲は頭頂部から膝下くらい。女の子を大きく。\n・上下左右見切れがないようにお願いします。\n・サイズは横1920*縦1080ピクセル（16対9）でお願いします(サイズ・方向の間違えにご注意下さい。）納品ファイル形式は、psd（レイヤー未結合状態）、jpgでお願いします。", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@__viewpoint__/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2538961, "client_id": 2819492, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/17b860a2/uploads/origins/efef748f-ce45-4816-bf80-ea0e7a6e1890?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=197fc023e9cc4f521e8ee58869ef9b77", "srcset": "https://si.imgix.net/17b860a2/uploads/origins/efef748f-ce45-4816-bf80-ea0e7a6e1890?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=197fc023e9cc4f521e8ee58869ef9b77, https://si.imgix.net/17b860a2/uploads/origins/efef748f-ce45-4816-bf80-ea0e7a6e1890?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=d2b3189a0197e2b1402d5cbabfd3f97c 2x, https://si.imgix.net/17b860a2/uploads/origins/efef748f-ce45-4816-bf80-ea0e7a6e1890?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a669acf0221319367e0dccc0a243db8c 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/17b860a2/uploads/origins/efef748f-ce45-4816-bf80-ea0e7a6e1890?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=68059ac53069292dedb37dcb34497eac", "srcset": "https://si.imgix.net/17b860a2/uploads/origins/efef748f-ce45-4816-bf80-ea0e7a6e1890?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=68059ac53069292dedb37dcb34497eac, https://si.imgix.net/17b860a2/uploads/origins/efef748f-ce45-4816-bf80-ea0e7a6e1890?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=f96ab95a07b0de71a036974753e85cf8 2x, https://si.imgix.net/17b860a2/uploads/origins/efef748f-ce45-4816-bf80-ea0e7a6e1890?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=15fbc72d251b51e21a305049f24fffa2 3x"}, "body": "はじめまして。十三月 白と申します。\nアイコンになるイラストを描いていただきたいです。\n\nイメージは大人びた高校生女子で、希望の要件は以下のような感じです。\n\n・ボルドーワインの髪色、ロングヘアー\n・Nikon FA,Micro-NIKKOR 55mm F2.8をモチーフとしたカメラを手にしている\n・カメラのフィルム(パトローネ)風の髪飾り\n・バストアップ、もし予算内で可能なら全身(この場合ブレザー制服の夏服を着せてほしいです)\n・背景は白または透過\n・可能なら眼鏡差分\n\n優先順位は上の方ほど高い(特に上3つ)です。\nあと、クール美人が好きなのでその方向