の色は明るい茶色です\n・最も大きな特徴は、頭から大きなスモモの花が咲いているところです\n・外見イメージは資料にまとめます\n\n※服装\n・特徴として、中華系の民族衣装に近い服の上に、袖の余るくらい大きな白衣を羽織っています\n・漢服、胡服、チャイナドレスなど、モデルにするイメージはおまかせします\n\n※性格\n・天真爛漫で好奇心旺盛です\n\n※その他\n・全身絵でお願いします\n・ポーズや構図はおまかせで！\n・常世学園の名簿アドレスも載せます\n　http://guest-land.sakura.ne.jp/tokoyo/pclist/list.cgi?id=574\n\nhttps://drive.google.com/drive/folders/17HnIRIDrgPgGpeiUPVjwMIeJvyJ41au4", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@testesmyland/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 110617, "client_id": 461760, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/0f992eb6/uploads/origins/07c90bdd-a0ee-421d-82be-dd6b13162be9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a0902f9516e0c700cbe6a4ca165dd5f5", "srcset": "https://si.imgix.net/0f992eb6/uploads/origins/07c90bdd-a0ee-421d-82be-dd6b13162be9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a0902f9516e0c700cbe6a4ca165dd5f5, https://si.imgix.net/0f992eb6/uploads/origins/07c90bdd-a0ee-421d-82be-dd6b13162be9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=7ca3fe55bc1538f6a1fb5bbc18af21c7 2x, https://si.imgix.net/0f992eb6/uploads/origins/07c90bdd-a0ee-421d-82be-dd6b13162be9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=fbf7f263a6a4cf6e677cf0d9bb58a6b8 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/0f992eb6/uploads/origins/07c90bdd-a0ee-421d-82be-dd6b13162be9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=54ad8b3e07383a1b6f8fc5cd9a21ca83", "srcset": "https://si.imgix.net/0f992eb6/uploads/origins/07c90bdd-a0ee-421d-82be-dd6b13162be9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=54ad8b3e07383a1b6f8fc5cd9a21ca83, https://si.imgix.net/0f992