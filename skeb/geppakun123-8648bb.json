9-f21cec52b897?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=7c9fbe5037ae5c41c8e08d8587dd6097", "srcset": "https://si.imgix.net/05c05509/uploads/origins/f134f7c1-48de-4844-b139-f21cec52b897?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=7c9fbe5037ae5c41c8e08d8587dd6097, https://si.imgix.net/05c05509/uploads/origins/f134f7c1-48de-4844-b139-f21cec52b897?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=e1445e050169263af99589cee92a840d 2x, https://si.imgix.net/05c05509/uploads/origins/f134f7c1-48de-4844-b139-f21cec52b897?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=2272258b59456ec9596506bbe1c46422 3x"}, "body": "こんにちは。こちらのアウラ（https://x.com/geppakun123/status/2056949586049356157?s=20）のイラスト、本当に素晴らしいと思いました。\n\n私のアウラを、ダンサーの衣装を着た姿で描いていただけないでしょうか。バストの大きさは、上記のイラストと同じくらいにしてください。また、色気のある表情にしてほしいです。\n\n私のアウラの参考画像はこちらです：\nhttps://drive.google.com/drive/folders/1MNa7t2BBI1rau-JaskaQf1-mKuQqcd3v?usp=drive_link\n\nご検討いただきありがとうございます。", "nc": 32, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@geppakun123/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3887666, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/46948fad/uploads/origins/b095d743-c935-4a0d-8b1c-f9cb3d4a90dc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5732564a089c2833d73cb9e798d786c3", "srcset": "https://si.imgix.net/46948fad/uploads/origins/b095d743-c935-4a0d-8b1c-f9cb3d4a90dc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5732564a089c2833d73cb9e798d786c3, https://si.imgix.net/46948fad/uploads/origins/b095d743-c935-4a0d-8b1c-f9cb3d4a90dc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f03959ab89c261fdfc8e9d8d90c8582e 2x, https://si.imgix.net/46948fad/uploads/origins/b095d743-c935-4a0d-8b1c-f9cb3d4a90dc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=6538e982757441b90d52df9165eb406a 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/46948fad/uploads/origins/b095d743-c935-4a0d-8b1c-f9cb3d4a90dc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5e6321468446e6f3dcb79d8e6a51ea4e", "srcset": "https://si.imgix.net/46948fad/uploads/origins/b095d743-c935-4a0d-8b1c-f9cb3d4a90dc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5e6321468446e6f3dcb79d8e6a51ea4e, https://si.imgix.net/46948fad/uploads/origins/b095d743-c935-4a0d-8b1c-f9cb3d4a90dc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=81cf7083ece9e417069ad87ca38f48b6 2x, https://si.imgix.net/46948fad/uploads/origins/b095d743-c935-4a0d-8b1c-f9cb3d4a90dc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=127720574201bf996d1be93c78cc7780 3x"}, "body": "月白先生のイラスト淡い儚さでていて素敵だな、といつも拝見しております。\nそんな月白先生にイラストを描いていただきたく依頼いたします。\n\n【使用用途】\nSNS掲載とアイコンにする可能性がございます。\nその他壁紙、鑑賞程度にさせていただくかと。\n\n【依頼内容】\n長乳さんでおしりも大っきいメスラちゃんが顔赤らめて恥ずかしがりながら甘える様子……？\n上記は1案ですが月白先生のお気に召すままに誘惑してる様いただけたら！幸いです！\n\n【キャラクター】\n大まかなイメージは資料をご参考ください。\n身長は中から下(154～148cm)\n\n第一印象ではおどおど気味、小動物系なメスラちゃん\nでも実は寂しがりな甘えたさん、という設定です。\n好きな人にはお淑やかなに見せる一面を持ちつつ、実は子どもっぽさもあるような……\n\nセリフ\nこんばんは〜……\nいいですねっ！\n\nジョブは占星or学者さんイメージでお願いします(武器必須ではないです)\n\nよろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/1yi5pl4LpG7F--inlE834Zn7OnVAuGjJ5?usp=drive_link", "nc": 48, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@geppakun123/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3887666, "client_id": 795724, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/d0088bd7/uploads/origins/01c88472-06a