a8cc41efa7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5f0b2e9fa229af8a65ae4242e48d06dd, https://si.imgix.net/2030b4e3/uploads/origins/b291f8c4-6eb7-440c-8f18-a6a8cc41efa7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=314e86a3758218bf4b6ab97353bc6067 2x, https://si.imgix.net/2030b4e3/uploads/origins/b291f8c4-6eb7-440c-8f18-a6a8cc41efa7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c460f717b39134ebe88b4a3ec743550a 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/2030b4e3/uploads/origins/b291f8c4-6eb7-440c-8f18-a6a8cc41efa7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9bdf2f12744f79c1c309be410d62a0d0", "srcset": "https://si.imgix.net/2030b4e3/uploads/origins/b291f8c4-6eb7-440c-8f18-a6a8cc41efa7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9bdf2f12744f79c1c309be410d62a0d0, https://si.imgix.net/2030b4e3/uploads/origins/b291f8c4-6eb7-440c-8f18-a6a8cc41efa7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=5816f5a3b0a8679cc20de511e62ef5b6 2x, https://si.imgix.net/2030b4e3/uploads/origins/b291f8c4-6eb7-440c-8f18-a6a8cc41efa7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=92490a7993baa53d152d3ab10c38f9b8 3x"}, "body": "こんにちは！　また依頼させていただきます。\n\n　今回は前回の小説に載っていた別のキャラ「ヴァレリィ」と「シエル」をお願いしたいと思い、送らせていただきました。依頼内容としてはキャラが違うだけで前回と同じです。\n　以下に簡単な容姿をまとめておきます。\n\n・ヴァレリィ　魔法使い＋魔物学者、ローブを着ているイメージですが、ある程度旅ができるよう、旅装に近い形でお願いします。\n\n本文抜粋容姿\n　ぼさぼさの焦げ茶色をした髪に、ヒビの入った丸眼鏡、その奥にある眼は深い青色をしている。目鼻立ちは整っているものの、猫背でよれた白衣を羽織っている姿は、どう頑張っても色男とは言えなかった。\n\n　ぼさぼさだった髪には丁寧に櫛が通り、センターパートにきっちりとセットしてあり、よれて皴だらけだった白衣から滑らかなローブ姿に着替えている。眼鏡の奥にある顔はさっきと同じものの、やる気のない表情からしっかりとした意志を感じられるキリっとした表情になっていた。\n\n・シエル　正体がドラゴンの女の子＋和装、単純に和服ではなく、ある程度アレンジを加えても大丈夫です。\n本文抜粋容姿\n　光が収まると、銀髪と紅瞳がまず目を引いた。肌の色は薄く、色素が少しも無いように見える。そして、手に伝わる感触は、頼りなさを感じるほどに柔らかだ。それは目を細めて微笑むと、愛らしい声で言葉を話した。\n\n　彼女には、母親と呪術師の形見である倭服を着せてある。その姿は、余計に母親と重なった。\n\nよろしくお願いします。", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@tokmei_pegasas/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3195398, "client_id": 1595916, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/10c0a8d6/uploads/origins/47e77fbd-c1f8-452e-97be-20d7fbeb3f3a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b3bb882519c893f890e8f0f19dcfcf59", "srcset": "https://si.imgix.net/10c0a8d6/uploads/origins/47e77fbd-c1f8-452e-97be-20d7fbeb3f3a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b3bb882519c893f890e8f0f19dcfcf59, https://si.imgix.net/10c0a8d6/uploads/origins/47e77fbd-c1f8-452e-97be-20d7fbeb3f3a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=62c2ee63b3968230edbdc145ac8893a8 2x, https://si.imgix.net/10c0a8d6/uploads/origins/47e77fbd-c1f8-452e-97be-20d7fbeb3f3a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a4909298b7f62a71d003561f9c176fec 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/10c0a8d6/uploads/origins/47e77fbd-c1f8-452e-97be-20d7fbeb3f3a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3b9e02d13117455d58a0052dbfeb2f7e", "srcset": "https://si.imgix.net/10c0a8d6/uploads/origins/47e77fbd-c1f8-452e-97be-20d7fbeb3f3a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3b9e02d13117455d58a0052dbfeb2f7e, https://si.imgix.net/10c0a8d6/uploads/origins/47e77fbd-c1f8-452e-97be-20d7fbeb3f3a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=5e05d883e79540280181a4aa686d5044 2x, https://si.imgix.net/10c0a8d6/uploads/origins/47e77fbd-c1f8-452e-97be-20d7fbeb3f3a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=ce98d3a43993082013fdede4c818f4d4 3x"}, "body": "初めまして！　素敵なイラスト描かれているなと思ってリクエスト送らせていただきます！\n自作小説「蒼き燐光の剣士」（カクヨムURL：https://kakuyomu.jp/my/works/16818093074104795450）の登場人物主人公の白閃とキサラをお願いいたします。ポーズ等は指定なく、可能ならば全身が映っているとうれしいです。\n簡単な容姿\n白閃：\n　黒髪蒼眼＋両手剣を扱う剣士\n　寡黙な感じ＋全体的にダークな色調の外套＋軽鎧\n\nキサラ：\n　黒髪琥珀瞳＋ビキニ＋ホットパンツ＋コート\n　いわゆるメスガキ＋職業は盗賊（スカウト）\n\n本文より一部容姿の引用\n白閃\n＞　黒髪碧眼、仏頂面で年齢より年を取って見られるが、俺自身は二十四歳だ。\n\n＞　そう呟いて、俺は背負った両手剣を手にする。長大すぎるため、鞘ではなく革のバンデージで包んでいるそれは、大体俺の身長と同程度の刃渡りを持っていた。\n\n＞　勢いよく金具が跳ねて、ベルトのようなバンデージが地面に落ちる。手に残ったのは直線だけで構成された無骨な両手剣だ。神銀（ミスリル）を惜しげもなく使い、強度を高めるために波紋状の酸化被膜――ダマスカス加工を施したそれは、強度と切れ味、継戦能力すべてにおいて最高峰の武器だった。\n\nキサラ\n＞　視線を向けると、にやにやと嘲笑を浮かべる細身の女が居た。起伏の少ない身体をビキニトップとホットパンツで着飾っている。何とも防御力の低そうな衣服だが、彼女の職業的に重装備をするわけにもいかない。\n\n＞　盗賊女が隣の席で、カウンターによりかかってニヤニヤと笑みを浮かべている。ホットパンツにビキニトップといういつもの格好は変わらないが、その上から先日買ってやったコートを羽織っているので、シルエットはかなり変わっていた。\n\n最後に別の人に書いていただいたキサラ（画像左）も参考として資料URLに貼っておきます。\n\nhttps://img.syosetu.org/img/user/399341/107230.png", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@tokmei_pegasas/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3195398, "client_id": 3308908, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/5c869219/uploads/origins/d6eeedeb-e482-4d79-9751-34c661f8641c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ee744a3e583b1f1d67ca274e0b29581d", "srcset": "https://si.imgix.net/5c869219/uploads/origins/d6eeedeb-e482-4d79-9751-34c661f8641c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ee744a3e583b1f1d67ca274e0b29581d, https://si.imgix.net/5c869219/uploads/origins/d6eeedeb-e482-4d79-9751-34c661f8641c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=cb6ebe8d0da596eb6b510014eda6bb1f 2x, https://si.imgix.net/5c869219/uploads/origins/d6eeedeb-e482-4d79-9751-34c661f86