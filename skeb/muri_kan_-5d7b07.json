ロ:口元の左側に1つ\nイメージカラー:淡い青緑 \n\n【2人目】\n性別:男性\n性格:外では頼れる優しい大人で、好きな人に対しては大きなわんこのように甘える激重お兄ちゃん。愛ゆえにスキンシップが多く、妹に対してデレデレとした顔をすることも。\n髪型:黒髪、センターパート寄りに分けたやや長めの髪型。\n目:深いグレーがかったダークブラウンのタレ目\nホクロ:首の左側に1つ。\nイメージカラー:ミルキーホワイト\n\n関係性:共依存の義兄妹。\n\n使用用途 \n・個人鑑賞としてのグッズ制作\n・今後のキャラクター資料としての使用\n\n内容が合わなければキャンセルしていただいて大丈夫です。\n お忙しいなか恐れ入りますが、ご検討よろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/1H3V8HcjofX8hgFTbO5fNTpJ7XiP0WBTN", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@muri_kan_/works/76", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/9c3eea42/uploads/origins/115db7a8-81e3-4f9b-a915-b36f9d2e1ec6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=4ce21cd3b271bd00a24aba43c2483639", "srcset": "https://si.imgix.net/9c3eea42/uploads/origins/115db7a8-81e3-4f9b-a915-b36f9d2e1ec6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=4ce21cd3b271bd00a24aba43c2483639, https://si.imgix.net/9c3eea42/uploads/origins/115db7a8-81e3-4f9b-a915-b36f9d2e1ec6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=ede344c76472699d562cfabf84ced46a 2x, https://si.imgix.net/9c3eea42/uploads/origins/115db7a8-81e3-4f9b-a915-b36f9d2e1ec6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=86c5c2b702275d1d4476ece377cbb4db 3x"}, "private": true, "genre": "art", "tipped": false, "creator_id": 1532268, "client_id": 3702729, "nc": 16}, {"path": "/@muri_kan_/works/75", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1532268, "client_