fit=crop&crop=top&w=200&h=200&s=9a48b1535c4061715b135d7364b42e2b", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/de2a80c5/uploads/origins/45c4e330-3867-436e-b2cf-71153d54df54?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=13d7bc28ced735c4834a1084c2aaf9b3", "src_set": ""}, "body": "お世話になっております。\n夜勤中の眠そうな三鷹さんをお願いできますでしょうか。\n仮眠の後で、すこし制服が着崩れてしまっている感じですと嬉しいです。\nご検討よろしくお願いいたします！", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@1021G/works/47", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 286118, "client_id": 129339, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/ff66afb6/uploads/origins/f13f2cc3-00de-42b2-a933-d8506c463941?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8a4d75ab34da2d538c4a9795bbfb6286", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/ff66afb6/uploads/origins/f13f2cc3-00de-42b2-a933-d8506c463941?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f6e34e1ca95cae78e60adf7a6eb6c21e", "src_set": ""}, "body": "はい　こんにちは　焼き膝枕です（名乗り）\n前回同様依頼したいのでよろしければお願いします。\n\n・シチュ\n「三鷹さんにくすぐられる石和さん（くすぐりに強い）、くすぐり後腋汗で染みた白手袋を見せられ恥ずかしい石和さん」\n\n・服装\n石和さん→腋が見えるシャツ\n三鷹さん→制服白手袋\n\n・構図\n2コマ形式（縦か横おまかせ）\n石和さん万歳拘束、後ろから腋の下（くぼみ）をこちょこちょしている三鷹さんの図。\n\n汗が染みた白手袋を見せつけている三鷹さん、照れる石和さんの図。（拘束中）\n見せつけている図は正面から手袋装着中の手のみ、左右どちらかの手のひら部分を見せている。\n\n・表情\n石和さん→【くすぐり図】くすぐったくてケラケラと笑うが余裕がある\n　　　　　【見せられ図】アハハ…と横目で照れる\n\n三鷹さん→【くすぐり図】予想してたより反応が弱くてつまらない\n　　　　　【見せられ図】腋汗がすごくて困惑（汗マーク）\n\n・その他\n例のごとく白手袋はリアルな感じでお願いします。\n汗が染みた手袋は全体が染みており、指先はほぼ濡れている状態がいいです。\n\n今回癖を詰め込みました。ご検討よろしくお願いします。", "nc": 49, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@1021G/works/46", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 286118, "client_id": 1449674, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/429cf877/uploads/origins/4aee167d-e9ab-4f13-ab27-0ad4363c1f9a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d700083d021d9637305277e05c7dd4cd", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/429cf877/uploads/origins/4aee167d-e9ab-4f13-ab27-0ad4363c1f9a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b07b0951a2e1cacf37e3a470be7fb818", "src_set": ""}, "body": "この度イラストを依頼させていただきます、殺菌消毒と申します。\n以前よりXにて、三鷹さんをはじめとても可愛らしいオリキャラさん達のイラストを拝見させていただいており、1021Gさんの絵柄でぜひ私のオリキャラ絵を依頼したくご連絡させていただきました。\n　\n彼女は魔法使いの植物学者で、中世ファンタジー系の世界をあちこち旅しています。\nキャラクターの外見につきましては下記URLよりご参照下さいませ。\n　\n構図としては特に指定ありませんが、全身が入る構図でお願いします。\nまた、模様などの簡単な物でもいいので何か背景を入れていただけると嬉しいです。\nそれではどうぞ、ご検討の程よろしくお願い申し上げます。\n\nhttps://x.com/Snusmumriken12/status/1747686329646014563", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@1021G/works/45", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/7c439223/uploads/origins/321e9d72-8b8c-41a7-b68a-0138ea5b67ab?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=4f2c0ee2e29b22979d0d96f54e7d04e6", "src_set": ""}, "private": true, "genre": "art", "tipped": true, "creator_id": 286118, "client_id": 2174242, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 128, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@1021G/works/44", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 286118, "client_id": 3153371, "v