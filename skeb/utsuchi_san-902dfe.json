.net/484a55b8/uploads/origins/b02b4eb5-e0f4-4c4a-ad8e-32e19c49403e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=cbfde59760a3969dd68c8c1e2edca500, https://si.imgix.net/484a55b8/uploads/origins/b02b4eb5-e0f4-4c4a-ad8e-32e19c49403e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=8322e05a88f047e82c0dc8a0893f37fe 2x, https://si.imgix.net/484a55b8/uploads/origins/b02b4eb5-e0f4-4c4a-ad8e-32e19c49403e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=b593c1c0bc548c7831d61414b001f519 3x"}, "body": "うっちー様何時も氏が描く怪獣、クリーチャーのイラストを楽しく拝見しています。\n今回は自分のsnsのアイコンで使うイラストを依頼させて頂います。\n描いて欲しいイラストはコンゴの怪物キリム（資料: https://dic.pixiv.net/a/キリム）を氏が描くリアル調の怪獣風に描いて貰いたいです\nデザイン上の要望は体と頭のベースはサバクツノトカゲで体表はドラクエのガルマッゾの様に毒々しい雰囲気のある赤系の色。角はオリックスの様な角が後ろ向きに真っ直ぐ長短様々に７本ずつ生えている。目は深い緑で蜘蛛の様に小さく丸い目（ただ目の数は7で目の位置は規則性のない配置で全ての頭でバラバラにして下さい）トカゲの尻尾は生えてなく、蓑引鶏の様な尾羽が生えている（資料と変えました）MARVELのヴェノムの様な鋭く細長い牙がびっしり生えている\n可能ならこのイラストの様に（https://www.pixiv.net/artworks/119499098）二つのアングルの差分を描いて欲しいです。\nもし、アイコン利用が不可な場合、もしくは難しい場合はキャンセルして頂いても問題ありません\nご一考の程よろしくお願いします", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@utsuchi_san/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2143970, "client_id": 2805429, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/40fd072f/uploads/origins/0154df79-58b8-4777-ae77-6898212f35f9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4f68c3442dc945770e80f1de9b117215", "srcset": "https://si.imgix.net/40fd072f/uploads/origins/0154df79-58b8-4777-ae77-6898212f35f9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4f68c3442dc945770e80f1de9b117215, https://si.imgix.net/40fd072f/uploads/origins/0154df79-58b8-4777-ae77-6898212f35f9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b8470f74acf349b887ec0ce1511c130b 2x, https://si.imgix.net/40fd072f/uploads/origins/0154df79-58b8-4777-ae77-6898212f35f9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ac5d2d3d2867fca8b221b16463519123 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/40fd072f/uploads/origins/0154df79-58b8-4777-ae77-6898212f35f9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=772006d7ad691810b8cbcd75d4d6455c", "srcset": "https://si.imgix.net/40fd072f/uploads/origins/0154df79-58b8-4777-ae77-6898212f35f9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=772006d7ad691810b8cbcd75d4d6455c, https://si.imgix.net/40fd072f/uploads/origins/0154df79-58b8-4777-ae77-6898212f35f9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=0139c2d3b4ce35c6b8d5d39aae40c01f 2x, https://si.imgix.net/40fd072f/uploads/origins/0154df79-58b8-4777-ae77-6898212f35f9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=1b814649b76392c9c58a81980bc527c7 3x"}, "body": "はじめまして。\nリアルなタッチの怪獣のデザインに心魅かれてリクエストをしたいと思います。\n私カクヨムで『アンダーザ怪獣フィート~最強怪獣倒すため少女はバーサーカー帰還兵と旅をする~』という作品を執筆しているのですが、その作品内に登場する怪獣『ゲムバ』のイラストをお願いします。タッチはリアル名感じでお願いします。\n ポーズや背景、シチュエーション等はうっちーさんのお好きな感じのシチュエーションで大丈夫です。\n　お受けいただけると幸いです、是非ご検討をお願いします。\nアンダーザ怪獣フィート本文（https://kakuyomu.jp/works/16818093091302285270）\nゲムバのイラスト（https://kakuyomu.jp/users/otonasime/news/16818622175580902417 ）", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@utsuchi_san/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2143970, "client_id": 3081462, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/76a9a367/uploads/origins/3abe7151-b3ed-4b18-a904-32666426d67b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=42946018