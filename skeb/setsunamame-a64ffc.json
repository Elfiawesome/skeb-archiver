ます。どちらかというと白髪が黒髪を諌めることの方が多い。\n\nhttps://drive.google.com/drive/folders/1u_gdtZV1pj1JkzAxF9-L6D_i28Q1w6Fj?usp=sharing\n\nhttps://drive.google.com/drive/folders/1u_gdtZV1pj1JkzAxF9-L6D_i28Q1w6Fj?usp=sharing", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@setsunamame/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 4033794, "client_id": 4055561, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/772b5812/uploads/origins/d2089cfd-35b3-4d60-9819-522762840cb4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b480d3bc5227248ba4affcdca8aa20bc", "srcset": "https://si.imgix.net/772b5812/uploads/origins/d2089cfd-35b3-4d60-9819-522762840cb4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b480d3bc5227248ba4affcdca8aa20bc, https://si.imgix.net/772b5812/uploads/origins/d2089cfd-35b3-4d60-9819-522762840cb4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=2b4058788d2f40023667bd0363bbd0a7 2x, https://si.imgix.net/772b5812/uploads/origins/d2089cfd-35b3-4d60-9819-522762840cb4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=4f84b88d6f3665d05798a703dabe7220 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/772b5812/uploads/origins/d2089cfd-35b3-4d60-9819-522762840cb4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9d1beee1f5ae4c668cc4894ea0ccdcba", "srcset": "https://si.imgix.net/772b5812/uploads/origins/d2089cfd-35b3-4d60-9819-522762840cb4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9d1beee1f5ae4c668cc4894ea0ccdcba, https://si.imgix.net/772b5812/uploads/origins/d2089cfd-35b3-4d60-9819-522762840cb4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=eb13214ebf16737561f