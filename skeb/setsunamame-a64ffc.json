Bは、一時的に精神に異常をきたし発狂、植物状態だったのですが、快復し現在A宅で療養しています\n・AがBの介護を現在しています\n・Aはとにかく明るいですが、Bはツンツンしています(なかなか素の表情を表すことができない)\n\n資料URLには、参考画像を添付しております。\n\n以上、依頼内容になります。\n厳しければキャンセル或いは再送のほど、よろしくお願い申し上げます。\n\nアオ\n\nhttps://drive.google.com/drive/folders/1mSy56XiUrzJKfUw5RAYNmdPFU2rB03xN", "nc": 184, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 264113, "creator": true, "nsfw_acceptable": false, "acceptable": false, "name": "くるみゆう", "screen_name": "kurumiyuu51", "avatar_url": "https://pbs.twimg.com/profile_images/1792605480994652161/5giIBJI7.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1026491228643155968/1767201040/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 70, "skills": [{"genre": "art"}, {"genre": "correction"}], "banned": false, "nc": 49}, {"id": 1770659, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "ねれね~", "screen_name": "nere_nee", "avatar_url": "https://pbs.twimg.com/profile_images/2070070774309048320/mNpWbmnp.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1483803132513890304/1782377627/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 120, "skills": [{"genre": "art"}], "banned": false, "nc": 161}, {"id": 2820881, "creator": true, "nsfw_acceptable": false, "acceptable": false, "name": "笹古みとも", "screen_name": "sasakomitomo", "avatar_url": "https://pbs.twimg.com/profile_images/1548569528820326401/WA3whrfa.jpg", "header_url": "https://pbs.twimg.com/profile_banners/489519459/1648820590/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, 