oo/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 558012, "client_id": 116395, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/d98154a3/uploads/origins/6247a5b8-6f88-47a9-8b2e-01f2a6d0a704?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=95ed04b8f71f4c0bf52760a976c05b93", "srcset": "https://si.imgix.net/d98154a3/uploads/origins/6247a5b8-6f88-47a9-8b2e-01f2a6d0a704?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=95ed04b8f71f4c0bf52760a976c05b93, https://si.imgix.net/d98154a3/uploads/origins/6247a5b8-6f88-47a9-8b2e-01f2a6d0a704?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ab31d7d062e8e3f677433aada7a64f20 2x, https://si.imgix.net/d98154a3/uploads/origins/6247a5b8-6f88-47a9-8b2e-01f2a6d0a704?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d7c390de0c73021e5b2565eb7c220fbd 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/d98154a3/uploads/origins/6247a5b8-6f88-47a9-8b2e-01f2a6d0a704?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=33f20b36557a2d5739be6a6fcdd43fe4", "srcset": "https://si.imgix.net/d98154a3/uploads/origins/6247a5b8-6f88-47a9-8b2e-01f2a6d0a704?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=33f20b36557a2d5739be6a6fcdd43fe4, https://si.imgix.net/d98154a3/uploads/origins/6247a5b8-6f88-47a9-8b2e-01f2a6d0a704?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=9630aa0d20d72af784f528fa55e94950 2x, https://si.imgix.net/d98154a3/uploads/origins/6247a5b8-6f88-47a9-8b2e-01f2a6d0a704?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=00e23a28d660240295fa840013dba925 3x"}, "body": "先生、いつも素晴らしいイラストをありがとうございます。\n今回もお願いできればと思いご依頼させていただきました。\n\nふだん描かれておられないキャラかもしれませんが、もし可能であればご検討いただければ幸いに存じます。\n描いて頂きたいのは「幼女戦記」という作品に登場する「ターニャ・フォン・デグレチャフ」になります。\n\n幼女でありながら中身はおっさんなキャラクターなのですが、非常に表情（顔芸）が豊かで魅力的なキャラクターです。\nそんな彼女がよく見せる口を大きく歪ませた邪悪な笑顔（何か良いことを思いついた時に見せる表情）を描いて頂きたいです。\n何か敵を罠に嵌める策略を思いついて、それを思い描いて笑みを浮かべるというようなシチュエーションでお願い致します。\nコミカライズや原作ではなく、アニメのキャラクターデザインに準拠していただければと思います。\n服装は軍服でお願いできればと思います。\nまた、前回描いていただいたチャーリーの時の塗り方や雰囲気が非常に素晴らしく好みでしたので\n先生のご負担にならなければ、似た様な色合いや雰囲気のにしていただけるとありがたいです。\n\nややこしく、注文の多い依頼で申し訳ございませんが、ご検討いただけましたら幸いに存じます。\nそれでは、よろしくお願い致します。\n\nhttp://youjo-senki.jp/", "nc": 8, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@unimagurooo/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 558012, "client_id": 1067428, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/b2c1e564/requests/290911_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=40fd0452707deeba52564eac9a2f1fa7", "srcset": "https://si.imgix.net/b2c1e564/requests/290911_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=40fd0452707deeba52564eac9a2f1fa7, https://si.imgix.net/b2c1e564/requests/290911_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f125b2b9db27e41fe30ae170f72766c5 2x, https://si.imgix.net/b2c1e564/requests/290911_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=52ed93b5ae177620ce1c3be45083da6d 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/b2c1e564/requests/290911_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=dbc507e4fd7ebe04e0e55c107748f591", "srcset": "https://si.imgix.net/b2c1e564/requests/290911_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=dbc507e4fd7ebe04e0e55c107748f591, https://si.imgix.net/b2c1e564/requests/290911_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop