l)\n解像度: 300dpi\nカラー:CMYK\nデータ:PSD", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "similar_creators": []}, "price_history": {"art": [{"amount": 9000, "recorded_at": 1774275630.931647}, {"amount": 12000, "recorded_at": 1779858469.398418}, {"amount": 10000, "recorded_at": 1780403111.05169}, {"amount": 9000, "recorded_at": 1781337835.28538}, {"amount": 12000, "recorded_at": 1781849087.462713}, {"amount": 8000, "recorded_at": 1783228222.377544}]}, "custom": {}}