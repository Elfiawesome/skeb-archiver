再送要請をお願い致します。\nお手数おかけしますが、ご検討のほどよろしくお願いします。\n\nhttps://drive.google.com/drive/folders/1V9-BcDEtIkrWl5TYJzkmVWPAys0nAdad", "nc": 1, "word_count": 20483, "transcoder": "text", "creator_acceptable_same_genre": true}, {"path": "/@kake_hika/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "novel", "tipped": false, "creator_id": 542752, "client_id": 449558, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/283e1f72/uploads/origins/cf2766ad-0444-4cba-941c-5d442501690f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3c358291f69d713bfae5660598bb402f", "srcset": "https://si.imgix.net/283e1f72/uploads/origins/cf2766ad-0444-4cba-941c-5d442501690f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3c358291f69d713bfae5660598bb402f, https://si.imgix.net/283e1f72/uploads/origins/cf2766ad-0444-4cba-941c-5d442501690f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=495d670d245433d34cd0515ef3b83ded 2x, https://si.imgix.net/283e1f72/uploads/origins/cf2766ad-0444-4cba-941c-5d442501690f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=7c45b1e2322b16d3ba8e40a543bd70ce 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/283e1f72/uploads/origins/cf2766ad-0444-4cba-941c-5d442501690f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=42d96c7db50a4143329b3bb246252126", "srcset": "https://si.imgix.net/283e1f72/uploads/origins/cf2766ad-0444-4cba-941c-5d442501690f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=42d96c7db50a4143329b3bb246252126, https://si.imgix.net/283e1f72/uploads/origins/cf2766ad-0444-4cba-941c-5d442501690f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=36851fc3ddfe2175d71de71977603d57 2x, https://si.imgix.net/283e1f72/uploads/origins/cf2766ad-0444-4cba-9