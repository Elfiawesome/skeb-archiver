8-ca79d3e25558?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5fdccebd8271042911c14fd0471f3929, https://si.imgix.net/6568667e/uploads/origins/f019b88d-0f79-4a5a-b068-ca79d3e25558?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=412073c426622d1971a66274bb1bf6ae 2x, https://si.imgix.net/6568667e/uploads/origins/f019b88d-0f79-4a5a-b068-ca79d3e25558?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=4e9f3f2e2ba54d43515af6c56bd3a182 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/6568667e/uploads/origins/f019b88d-0f79-4a5a-b068-ca79d3e25558?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=724eb346ebe1cb4f5110e3d0a48ad443", "srcset": "https://si.imgix.net/6568667e/uploads/origins/f019b88d-0f79-4a5a-b068-ca79d3e25558?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=724eb346ebe1cb4f5110e3d0a48ad443, https://si.imgix.net/6568667e/uploads/origins/f019b88d-0f79-4a5a-b068-ca79d3e25558?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=e56b1ff207d2219dc9afeba442df7d60 2x, https://si.imgix.net/6568667e/uploads/origins/f019b88d-0f79-4a5a-b068-ca79d3e25558?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=7d2ca907fa49a302f3aaebeb5a58330d 3x"}, "body": "はじめまして。\n素敵な甲冑のイラストに惹かれてリクエストを送らせていただきました。\n資料URLにあります当方オリジナルキャラクターが槍を振るって魔物なり敵兵士なりとバトルしている感じのイラストを描いていただけないでしょうか。\n資料がこの1枚絵しかなく恐縮ですが、装備は手甲、足鎧つきの黒塗り金属鎧＋鎖帷子、裏地がモーブカラーのキルティング素材、表地が黒布の襟付きマント、マントは黒地に紫のパイピングが施されたベルトで胸当てと繋いでいます。\nマントの表地は無地で、特に紋章等はありません。\n胸当てにある白いロゴは企画で参加していたギルドのものなので省略していただいて大丈夫です。\n描いていただいたイラストは、兜屋MELTさまに描いていただいた旨とコミッションURLを明記して当方のioのアカウントに掲載させていただきたく思います。\n大雑把なリクエストで申し訳ございませんが、ご検討いただけますと幸いです。\nよろしくお願いいたします。\n\nhttps://www.pixiv.net/artworks/103001193", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_ge