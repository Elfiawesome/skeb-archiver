が…もしよろしければ…！\n\n\n\nどうかよろしくお願いします！\n\n\n\nかなココに幸あれ！\nかなココに栄光あれ！\n\nそして子を成せ。", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 391310, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "みず commission open‼︎", "screen_name": "mizugiri_584", "avatar_url": "https://pbs.twimg.com/profile_images/2066142160291020800/NcNJuPWM.jpg", "header_url": "https://pbs.twimg.com/profile_banners/275527060/1655619118/1500x500", "appeal_receivable": true, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "art"}, {"genre": "correction"}], "banned": false, "nc": 176}, {"id": 871975, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "健康❣️", "screen_name": "pakipakiiishi", "avatar_url": "https://pbs.twimg.com/profile_images/1704723129929736192/R_51ZIhE.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1318460478893428741/1738250584/1500x500", "appeal_receivable": true, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 70, "skills": [{"genre": "art"}, {"genre": "correction"}], "banned": false, "nc": 0}, {"id": 963356, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "バリケード643(リク受付再開)", "screen_name": "SSS_SGRID", "avatar_url": "https://pbs.twimg.com/profile_images/2065754810771771392/02XFsEL8.jpg", "header_url": "https://pbs.twimg.com/profile_banners/875112172518465536/1680499247/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 80, "skills": [{"