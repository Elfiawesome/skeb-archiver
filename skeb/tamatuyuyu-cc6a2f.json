core": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/2f65a5ff/uploads/origins/83ece1c4-43cd-4eae-b0a1-422c961c32c0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=de49ff00de29ef5109983289b73e04ec", "srcset": "https://si.imgix.net/2f65a5ff/uploads/origins/83ece1c4-43cd-4eae-b0a1-422c961c32c0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=de49ff00de29ef5109983289b73e04ec, https://si.imgix.net/2f65a5ff/uploads/origins/83ece1c4-43cd-4eae-b0a1-422c961c32c0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=bd2c9ebe025b1e654a743133fb3f7fdc 2x, https://si.imgix.net/2f65a5ff/uploads/origins/83ece1c4-43cd-4eae-b0a1-422c961c32c0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=127d62fc4467ae340318fd4ba68b71b7 3x"}, "body": "初めまして、偶然つゆたま様が目に入り\nイラストが素敵でリクエストさせて頂きました。\n\n灼熱カバディの緒方蒼介\nをお願い致します。\n\nキャラの好きな色が浅葱色\nですので何処かに使っていただければ幸いです。\n\n好きな季節が冬なので冬っぽく？\nと思ったのですが…\n服装、構図お任せ致します\n\nご検討よろしくお願い致します", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@tamatuyuyu/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1173091, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/652ec050/uploads/origins/ca38f2a7-70d8-4410-b8ed-58a29b576212?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f7eeb87ce21e37d482d586d5e466faec", "srcset": "https://si.imgix.net/652ec050/uploads/origins/ca38f2a7-70d8-4410-b8ed-58a29b576212?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f7eeb87ce21e37d482d586d5e466faec, https://si.imgix.net/652ec050/uploads/origins/ca38f2a7-70d8-4410-b8ed-58a29b576212?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ea8b06de06126d355c85bbc0760240e9 2x, https://si.imgix.net/652ec050/uploads/origins/ca38f2a7-70d