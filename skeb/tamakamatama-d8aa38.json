ble": true, "yearly_report_client_visible": false, "total_appeals_count": 0, "received_works": [{"path": "/@tamakamatama/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2688414, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/d31069e0/uploads/origins/c4df1a1c-849d-42b0-aa96-3fa17426a6fb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ed9b5e00d87c3353ccb628c8fb5deabe", "srcset": "https://si.imgix.net/d31069e0/uploads/origins/c4df1a1c-849d-42b0-aa96-3fa17426a6fb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ed9b5e00d87c3353ccb628c8fb5deabe, https://si.imgix.net/d31069e0/uploads/origins/c4df1a1c-849d-42b0-aa96-3fa17426a6fb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=8347230a475ea4cc17553fd736d4b6e6 2x, https://si.imgix.net/d31069e0/uploads/origins/c4df1a1c-849d-42b0-aa96-3fa17426a6fb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=710952793fcfd505a04aad4d199fcdbf 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/d31069e0/uploads/origins/c4df1a1c-849d-42b0-aa96-3fa17426a6fb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=53c16c0b34ac5f387effc4c4ff3b2bbb", "srcset": "https://si.imgix.net/d31069e0/uploads/origins/c4df1a1c-849d-42b0-aa96-3fa17426a6fb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=53c16c0b34ac5f387effc4c4ff3b2bbb, https://si.imgix.net/d31069e0/uploads/origins/c4df1a1c-849d-42b0-aa96-3fa17426a6fb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=00c5004653e44833545112ad1a6e11f0 2x, https://si.imgix.net/d31069e0/uploads/origins/c4df1a1c-849d-42b0-aa96-3fa17426a6fb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=8abd758ab86ec32f33c1a13d22ef9301 3x"}, "body": "こんにちは。初めて依頼させていただきます。\n\n絵柄のかわいさと色合いのかわいらしさ（skebの唯ちゃん、レイナサマ梨沙ちゃんのイラスト、恒常SSR衣装志希ちゃんのイラストの色の雰囲気が特に好きです）に惹かれました。\n\n今回、シンデレラガールズから黒埼ちとせと白雪千夜（ちと千夜）をお願いしたいです。\n\nまた、イラストをP名刺に使用させていただければと思うのですがよろしいでしょうか？その際、かまたたまお様のお名前を明記させていただきます。\n\n【服装】\n千夜ちゃん\nSSR 「巡る朝、夏の夢」特訓後衣装\n\nちとせお嬢さま\nSSR 「此岸の逢瀬」特訓後衣装\nなお、キバ（八重歯）が見える表情をお願いしたいです…！\n\n【イメージ】\nいくつか候補があり、案を複数書かせていただきました。いずれかピンとくるものがありましたら、ぜひお願いしたいです。\n\n・2人がさりげなく手を繋いでる構図、またはお嬢さまが千夜ちゃんに軽く腕を絡めて楽しそうな感じ\n（千夜ちゃんは過度に照れず、楽しそうなお嬢さまを見て柔らかい表情になってる感じがいいです）\n\n・ちとせお嬢さまが、千夜ちゃんの髪をなおしてあげてる\nまたは、髪飾りの花をきれいだねと言って髪（髪飾り）に優しく触れている感じ\n\n・2人とも七夕の時期のガシャ衣装のため、星空やゆめかわっぽい背景・小物で全体的にかわいらしい感じ\n\nバストアップ、全身等の指定はありません。\nイラストのイメージに合わせて衣装の手袋を外したり、装飾の一部を簡略化いただいても大丈夫です。\n\n衣装の参考になればと思い、リンク先に資料を格納しております。\n\n以上、ご検討お願いできますと幸いです。\nよろしくお願い致します。\n\nhttps://drive.google.com/drive/folders/1eLMAxHrf9trwqYDsRtp5C6FOqEF5Lo9G", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@tamakamatama/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2688414, "client_id": 2848953, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/eb3a95da/uploads/origins/3864d91c-6197-457f-8528-e93f4183ecd9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9e39c3c02dd4c0c71c38ed3f7ff9b6fc", "srcset": "https://si.imgix.net/eb3a95da/uploads/origins/3864d91c-6197-457f-8528-e93f4183ecd9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9e39c3c02dd4c0c71c38ed3f7ff9b6fc, https://si.imgix.net/eb3a95da/uploads/origins/3864d91c-6197-457f-8528-e93f4183ecd9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c39ab0d29653812592e061c4babefc49 2x, https://si.imgix.net/eb3a95da/uploads/origins/3864d91c-6197-457f-8528-e93f4183ecd9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b08a12d179cc1626381f34ed803219df 3x"}, "duration": null, "nsfw": false, "hardcore": false, "conso