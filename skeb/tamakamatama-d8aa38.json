rop=top&w=200&h=200&s=cbde64fc3a6437251e9f026f2662b214, https://si.imgix.net/918e362c/uploads/origins/ac2298ea-c962-47f2-8151-c217eba4cf67?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e6d91252b27f77b630a938eacddf8ef2 2x, https://si.imgix.net/918e362c/uploads/origins/ac2298ea-c962-47f2-8151-c217eba4cf67?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=dece615901d9e383ca1d2fe4c205d9be 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/918e362c/uploads/origins/ac2298ea-c962-47f2-8151-c217eba4cf67?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0d40797b727ad526cc56f320e75a817e", "srcset": "https://si.imgix.net/918e362c/uploads/origins/ac2298ea-c962-47f2-8151-c217eba4cf67?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0d40797b727ad526cc56f320e75a817e, https://si.imgix.net/918e362c/uploads/origins/ac2298ea-c962-47f2-8151-c217eba4cf67?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=5fa4d2211340fa93cd6ed0fdc66e38aa 2x, https://si.imgix.net/918e362c/uploads/origins/ac2298ea-c962-47f2-8151-c217eba4cf67?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=3d9a6413cfb168a857842dc29c77fc30 3x"}, "body": "初めまして！\nRTで回ってきたイラストに一目惚れし、更に過去絵もとても素敵だと感じたので依頼失礼します…！\n\n梨沙やフレデリカのカバー曲をモチーフにしたイラストを描いてたのを見て思いついたのですが、カバー曲「全力☆Summer!」をモチーフにした棟方愛海を描いていただけないでしょうか？\n\n衣装はOPに使われてたアニメ「アホガール」の制服で。(公式サイトのURLを送ります)\nあと、背景のどこかに「全力☆Summer!」のロゴを入れてほしいです。\n\nポーズや表情等はお任せします。\n是非とも検討、よろしくお願いします…！\n\nhttp://ahogirl.jp/", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@tamakamatama/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2688414, "client_id": 2985770, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si