nt=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=cd0f9c7513c81ef2be53e87683602db9 3x"}, "private": true, "genre": "art", "tipped": false, "creator_id": 2326744, "nc": 32}, {"path": "/@kinkan0_5/works/9", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2326744, "client_id": 3187891, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/bc39c782/uploads/origins/76453e80-524d-4c8e-89f4-9368c41f475a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9c2cc3b2b8450e9b940d12ef267da462", "srcset": "https://si.imgix.net/bc39c782/uploads/origins/76453e80-524d-4c8e-89f4-9368c41f475a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9c2cc3b2b8450e9b940d12ef267da462, https://si.imgix.net/bc39c782/uploads/origins/76453e80-524d-4c8e-89f4-9368c41f475a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=3e9c24f7c3f76d3a6c0f33d1bd7545f3 2x, https://si.imgix.net/bc39c782/uploads/origins/76453e80-524d-4c8e-89f4-9368c41f475a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c10df4a45491edcfcd5035ff1f181b30 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/bc39c782/uploads/origins/76453e80-524d-4c8e-89f4-9368c41f475a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=625c0498fbe498b6330d3bb45262207d", "srcset": "https://si.imgix.net/bc39c782/uploads/origins/76453e80-524d-4c8e-89f4-9368c41f475a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=625c0498fbe498b6330d3bb45262207d, https://si.imgix.net/bc39c782/uploads/origins/76453e80-524d-4c8e-89f4-9368c41f475a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=83946b2bfca959360d35173af453e307 2x, https://si.imgix.net/bc39c782/uploads/origins/76453e80-524d-4c8e-89f4-9368c41f475a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=73c739b0c88cb3c67d06f91b8b5895cb 3x"}, "body": "先日の依頼では素敵な百合キスフェラをありがとうございました。\nあまりにエロくて発射シーンも拝みたくてリクエストさせていただきました。\n先日の構図とほぼ同じような構図で二人が亀頭を咥え込みながら百合キスを交わして合わさる唇の中で盛大に発射してるシーンを拝みたいです。\n\n二人が身を乗り出しながら唇を開いたまま互いの唇を交錯させて唇の中で熱烈ディープキスして咥え込んだ亀頭に舌を絡み合わせてるイメージです。\n密着する二人の唇の中に亀頭を突っ込んで特濃ドロドロザーメンを炸裂させてほしいです。発射の勢いで二人の唇の周りで爆発したように精液が飛び散ってる瞬間を切り取った構図で、発射の瞬間も二人は唇をガッツリ密着させた状態でお願いします。\n\n目線は頬を染め妖艶な笑顔で発射の瞬間を見つめてる感じにしてほしいです。\n手は恋人繋ぎを更にガッシリ握り合って、乳首は擦り合わせてビクンッとした感じにしてもらえると嬉しいです。\n\nもしも可能であれば発射後の唇の周りや顔に精液がこびりついた状態でうっとり目を閉じてそのまま交錯ディープキッスを続けてる様も差分として描いてほしいです。こちらは可能であればで構いません。\n\n以上になります。ご検討の程よろしくお願いいたします。", "nc": 161, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@kinkan0_5/works/8", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2326744, "client_id": 3187891, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/7b77365c/uploads/origins/71c5ce88-64b4-4b43-a952-ce729903303d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f2fa14d7ffcebb17940c3e5ab635e1ed", "srcset": "https://si.imgix.net/7b77365c/uploads/origins/71c5ce88-64b4-4b43-a952-ce729903303d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f2fa14d7ffcebb17940c3e5ab635e1ed, https://si.imgix.net/7b77365c/uploads/origins/71c5ce88-64b4-4b43-a952-ce729903303d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=30b8b7cd032984c8a7ff1de35121f1a8 2x, https://si.imgix.net/7b77365c/uploads/origins/71c5ce88-64b4-4b43-a952-ce729903303d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=11e7c5b87faf67212220cc6207b89a94 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/7b77365c/uploads/origins/71c5ce88-64b4-4b43-a952-ce729903303d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0b58c404c7e52b0696796a62410e196b", "srcset": "https://si.imgix.net/7b77365c/uploads/origins/71c5ce88-64b4-4b43-a952-ce729903303d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0b58c404c7e52b0696796a62410e196b, https://si.imgix.net/7b77365c/uploads/origins/71c5ce88-64b4-4b43-a952-ce729903303d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=d85c5d18a9fb708dfd933b74f0c3cb47 2x, https://si.imgix.net/7b77365c/uploads/origins/71c5ce88-64b4-4b43-a952-ce729903303d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=722d90c56940d76205afba576310a356 3x"}, "body": "リクエストさせていただきます。\n艦隊これくしょんの神風と春風が向かい合ってチンコを両側から咥えてチンコを挟んだまま百合キスしてるシーンをお願いします。\n\n\n二人の百合キスに横からチンコを捻じ込んで合わさる二人の唇から亀頭が顔を出しているイメージです。\n男の腰辺りを映して亀頭をカメラに向けたアングルで、二人がチンコの両側から唇で竿をすっぽり包み込んで、そのままチンコを覆いながら互いの唇をガッツリ合わせて熱烈濃厚な百合キスしてほしいです。\n画面上の左側が神風、右側が春風でお願いします。\n二人の唇が合わさる部分がしっかり見えるようチンコの修正は黒線でお願いします。\n\n\n服装は二人の通常和装衣装をはだけてブラジャーをずらして乳首が見えてる状態で、頭からおっぱいくらいまでを枠におさめた構図にしてほしいです。\nブラジャーのイメージはこちらの参考資料でお願いします。\nhttps://twitter.com/shirorokitsune/status/919524131934052352\n神風は赤色、春風は桜色、おっぱいのサイズはＦカップくらいにしてもらえると嬉しいです。\n視線や表情は頬を赤らめた蠱惑的な笑みのカメラ目線で、手は恋人繋ぎでお願いします。\n\n\n以上になります。ご検討の程よろしくお願いいたします。", "nc": 33, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@kinkan0_5/works/7", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/75777b6a/uploads/origins/68e21fc5-e125-463a-89cc-8afb42d00a13?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=6a92d741a05308fbb94a2182b94cd0fe", "srcset": "https://si.imgix.net/75777b6a/uploads/origins/68e21fc5-e125-463a-89cc-8afb42d00a13?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=6a92d7