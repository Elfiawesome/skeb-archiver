ads/origins/d1f51aa0-fa57-47f4-bc97-7b2b7e517f90?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=fdcaa6296459627e4a3c48d43953a407", "srcset": "https://si.imgix.net/12028f28/uploads/origins/d1f51aa0-fa57-47f4-bc97-7b2b7e517f90?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=fdcaa6296459627e4a3c48d43953a407, https://si.imgix.net/12028f28/uploads/origins/d1f51aa0-fa57-47f4-bc97-7b2b7e517f90?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=e83dcc5a4779f9f68f4c513c30fd9d42 2x, https://si.imgix.net/12028f28/uploads/origins/d1f51aa0-fa57-47f4-bc97-7b2b7e517f90?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=bf2fd54673fb4f44fcbd721467c48b34 3x"}, "body": "早速ですがリクエストします。\n　ウマ娘の我が贔屓　シンボリルドルフ＆サイレンススズカをお願いします。\n　画風としてはうまゆる・うまよんでお馴染みのちびキャラタイプも良いのですが、等身大も捨て難いです。何方にするかはお任せします。表情やポージングも委任します。左にスズカ　右にルドルフを配置して頂くと大歓喜です。\n　衣装は勝負服。背景は以前セブンイレブンで配布された黒地が良いかと思います。そこに筆記体で二人の名前を記して頂ければ。あと宛名は不要です。\n　事実上のアプリリリース三周年記念になる一枚。そちらのペースで構いません。何卒宜しくお頼み致します。\n　\n　資料（セブンイレブン　クリアファイル）https://www.famitsu.com/news/202211/16282927.html", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@allitell/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 421268, "client_id": 2971792, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/e4af7e99/uploads/origins/c2933673-8af6-4051-bc54-dcd46599dfcd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=54de89796f57915f6a363efef97e7deb", "srcset": "https://si.imgix.net/e4af7e99/uploads/origins/c2933673-8af6-4051-bc54-dcd46599dfcd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=54de89796f57915f6a363efef97e7deb, https://si.imgix.net/e4af7e99/uploads/origins/c2933673-8af6-4051-bc54-dcd46599dfcd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=1d5d59335bdc0e6544490d421acda342 2x, https://si.imgix.net/e4af7e99/uploads/origins/c2933673-8af6-4051-bc54-dcd46599dfcd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=8b029abcc1747a5846399c105641f778 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/e4af7e99/uploads/origins/c2933673-8af6-4051-bc54-dcd46599dfcd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e74a3e707f6d0332324f9284702499db", "srcset": "https://si.imgix.net/e4af7e99/uploads/origins/c2933673-8af6-4051-bc54-dcd46599dfcd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e74a3e707f6d0332324f9284702499db, https://si.imgix.net/e4af7e99/uploads/origins/c2933673-8af6-4051-bc54-dcd46599dfcd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=e52c806ca1e251df6433880f121974e7 2x, https://si.imgix.net/e4af7e99/uploads/origins/c2933673-8af6-4051-bc54-dcd46599dfcd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=18609de395d91a0a77c8721c896d46fe 3x"}, "body": "はじめまして！配信活動をしております、柊柊と申します。以前からTwitterのイラストにとても魅力を感じており、勇気を出してリクエストを送信させていただきました。\nイラストの使用用途は、VALORANTというFPSゲームの配信で使用する予定です。\n\n・ご依頼したいシチュエーション\nVALORANTはヘッドショットのダメージがとても高く、ヘッドショット1発で敵を倒すことができるシーンが多いのですが、ゲーム内に登場するファントムという武器で長距離の撃ち合いをした時に、距離減衰によって威力が落ち、ヘッドショットした時のダメージがMAX体力の150を下回る140となり、1発で相手を倒しきれず逆に自分が倒されてしまった…というあるあるなシチュエーションになります。\n\n・描いていただきたい構図\n今回描いていただきたい大まかな構図として、「柊の脳内イメージ」を画像として添付させていただきます。その際に少しでも具体的にイメージをお伝えしようと、 誠に勝手ながらallitell様のイラストを用いて図解させていただいております。申し訳ございません。\nフォルダ内、柊の脳内イメージの画像2枚のご確認をよろしくお願いします。\n\n脳内イメージのキタサンのような表情とポーズを柊柊のキャラクターにとらせて欲しいです。キャラクターが汗をかいて、震えていると嬉しいです。\nキャラクターはフォルダ内、三面図の画像をご確認よろしくお願いします。\n\n脳内イメージの右側に位置する表はフォルダ内、VALORANTリザルト資料をイメージしております。\n今回のイラストには、暗い灰色の長方形の中に頭、上半身、脚にパーツ分けされたピクトグラムのような人間を描いてください。その上半身と脚を明るい灰色で描き、頭だけを完全な白で描いて欲しいです。\nここでのピクトグラムはトイレの男性マークの上半身と脚が繋げて描かれていない、程度の簡単なものと考えてください。\nまた、ピクトグラム状の人間の下には140という数字を白で入れておいてください。\n\n今回が初めての依頼となります。失礼な点がありましたら申し訳ございません。ご確認よろしくお願いします。\n\nallitell様 依頼フォルダ\nhttps://drive.google.com/drive/folders/1RN4XoIRNfntQrc4hRdOKN_0nt_Lhyz65", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@allitell/works/2", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/038527fb/uploads/origins/3736c648-c11a-467d-a75c-fac565a4d9ab?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=f39449d5503f4d1b4cf847473e662d42", "srcset": "https://si.imgix.net/038527fb/uploads/origins/3736c648-c11a-467d-a75c-fac565a4d9ab?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=f39449d5503f4d1b4cf847473e662d42, https://si.imgix.net/038527fb/uploads/origins/3736c648-c11a-467d-a75c-fac565a4d9ab?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=ab6a380133584a944633e06cee1e16a8 2x, https://si.imgix.net/038527fb/uploads/origins/3736c648-c11a-467d-a75c-fac565a4d9ab?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=240a7d76816c54c9b082c07c43a116f2 3x"}, "private": true, "genre": "art", "tipped": true, "creator_id": 421268, "nc": 129}, {"path": "/@allitell/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 421268, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/22d164ba/uploads/origins/9a49ff44-6491-4b92-98d4-710a4e09841d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f706b0238493c613b00f1bee7fd7b627", "src