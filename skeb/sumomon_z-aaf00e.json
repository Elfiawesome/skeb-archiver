7-49a3-a957-b1a58de29d7f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=f9d513e0615b9f5a5f34c805905c5031 3x"}, "body": "こんにちは、マンガ形式（白黒）のストーリーをお願いします。\n\n主人公は、35歳の主婦です。曲線的で母性的な体つきをしています。広いお尻と大きなお尻。アニメの古典的なセクシーマザーです。\n\n彼女はフタナリである（睾丸はやめてください）。\n勃起したペニスを隠すために奴隷用のふんどしを着用している。\n\n彼女は12歳のロリ系サキュバスのカップルに捕獲されました。二人の少女は彼女に性的なトレーニングを始めます。彼らは女性のペニスと肛門を様々な方法で遊びます。例えば、一人の女の子がペニスの世話をしている間に、もう一人の女の子が女性の後ろにしゃがんで、長い舌で彼女の肛門に侵入し、彼女の中を舐めています。\n\n彼女がイクまで、様々な方法でトレーニングを続けていきます。\n\nすべてのシチュエーションで、女性のペニスをふんどしで隠してください。ふんどしの下にできたペニスの形だけを見たいのです。排卵時には、ふんどしから精液が垂れてくる。また、膣は見えません。肛門だけが見えている。\n\nありがとうございます。", "nc": 41, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@sumomon_z/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1204405, "client_id": 41021, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/769813fc/uploads/origins/d1414fba-5f2d-4de1-bcc8-5f897b995d26?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=303471003f38bdd222f07a66f7fce91d", "srcset": "https://si.imgix.net/769813fc/uploads/origins/d1414fba-5f2d-4de1-bcc8-5f897b995d26?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=303471003f38bdd222f07a66f7fce91d, https://si.imgix.net/769813fc/uploads/origins/d1414fba-5f2d-4de1-bcc8-5f897b995d26?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=31e8cf20a037a754534743353dffb23d 2x, https://si.imgix.net/769813fc/uploads/origins/d1414fba-5f2d-4de1-bcc8-5f897b995d26?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=6f51b19132c1a425aeb55c3b4f0444f9 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/769813fc/uploads/origins/d1414fba-5f2d-4de1-bcc8-5f897b995d26?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2af6a61e8029efc68e9319146c938d8f", "srcset": "https://si.imgix.net/769813fc/uploads/origins/d1414fba-5f2d-4de1-bcc8-5f897b995d26?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2af6a61e8029efc68e9319146c938d8f, https://si.imgix.net/769813fc/uploads/origins/d1414fba-5f2d-4de1-bcc8-5f897b995d26?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=872564416db12f1f79f1d3d646d8cfa7 2x, https://si.imgix.net/769813fc/uploads/origins/d1414fba-5f2d-4de1-bcc8-5f897b995d26?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=3ee222b89b2860ece0e22ab01b151093 3x"}, "body": "[キャラ]\n私のPSO2-NGSキャラクター\nhttps://imgur.com/a/6TqwnRM\n[シチュ]   敗北罰ゲーム+全裸晒し - モノクロ漫画風 \n[コスチューム] 全裸\n[内容]\n子供とゲームをして全てを失い、人前で裸になることに恥ずかしさと興奮を覚える。\nカードゲームやその他の似たようなタイプのゲームでもよい。\nhttps://i.imgur.com/4wPxnQz.jpg\nhttps://i.imgur.com/pIbB1Jw.jpg\n\n彼らは私のキャラクターを犬のように裸で歩かせ、彼女はさらに恥ずかしさと興奮を覚えます。\nhttps://i.imgur.com/p9UO0dL.jpg\nhttps://i.imgur.com/WLArttV.png\n\nそして、彼女は自分自身で遊び始めた。\nhttps://i.imgur.com/DeqfVUi.jpg\nhttps://i.imgur.com/7Azylk7.png\n\nそして最後には、子供たちに飽きられて道の真ん中に放置された。\nhttps://imgur.com/yKYsHPs", "nc": 185, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@sumomon_z/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1204405, "client_id": 1202773, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/796c33f5/uploads/origins/8c4b2b22-a5c0-4676-8b0f-1d11527c8a83?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=50b117d5442b314c3ff026905d814f82", "srcset": "https://si.imgix.net/796c33f5/uploads/origins/8c4b2b22-a5c0-4676-8b0f-1d11527c8a83?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=50b117d5442b314c3ff026905d814f82, https://si.imgix.net/796c33f5/uploads/origins/8c4b2b22-a5c0-4676-8b0f-1d11527c8a83?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ba8ed1dfbd8cf2d9ecc2e9ab2edcbdc5 2x, https://si.imgix.net/796c33f5/uploads/origins/8c4b2b22-a5c0-4676-8b0f-1d11527c8a83?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=20ed557459ecd8e52a87fa1de355a897 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/796c33f5/uploads/origins/8c4b2b22-a5c0-4676-8b0f-1d11527c8a83?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9dee51e3fe810b360b56b4c2a7e86940", "srcset": "https://si.imgix.net/796c33f5/uploads/origins/8c4b2b22-a5c0-4676-8b0f-1d11527c8a83?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9dee51e3fe810b360b56b4c2a7e86940, https://si.imgix.net/796c33f5/uploads/origins/8c4b2b22-a5c0-4676-8b0f-1d11527c8a83?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=1d0c6300e54d88b62911a42c75553f64 2x, https://si.imgix.net/796c33f5/uploads/origins/8c4b2b22-a5c0-4676-8b0f-1d11527c8a83?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=7bbc745773e009d8ea8b882eb0880e3e 3x"}, "body": "こんにちは。ひげひろの荻原さゆさんと結城 あさみさんにお願いしたいと思います。さゆとゆうきあさみは、吉田さんの家にいます。全員が布団に寝ている。さゆが矢口恭也にバキュームフェラチオをしている。。 視点は矢口恭也からです。矢口恭也がさゆを撮影している。矢口さんの右腕は携帯電話を持っています。さゆの顔を録画しています。荻原 沙優はカメラを恥ずかしがって、片手を目の前に置いています。 矢口の左隣には結城 あさみ。矢口さんの左腕は、結城あさみさんのお尻をギュッと握っています。彼女の顔は視点に近く、さゆは少し離れています。結城 あさみは矢口恭也の胸にオパイを押し付けている。片手でさゆの頭を押さえている。もう片方の手で矢口恭也の乳首を揉んでいます。 さゆとゆうきあさみは、ミニビキニを着ています。紐だけで作られているので、乳首が見えています。さゆのオッパイが矢口恭也の股間に乗っている。彼女の足は戯れに宙に浮いている。さゆは首輪をつけています。部屋の中には小さな窓があります。そこから吉田さんの怒った顔が見えます。\n\nまた、さゆがフェラチオをしているバージョンを2つ作っていただけますか？\nVariant 1: さゆは普通にフェラチオをしていて、可愛くて恥ずかしそうです。カメラを見られるのが恥ずかしいのか、片手を目の前に出しています。あさみさんは、さゆさんの頭を少し下に押しています。あさみさんはとても淫らな笑顔をしています。\nVariant 2: 結城 あさみが、さゆの頭を矢口恭也の陰毛まで押し下げています。さゆは矢口恭也をディープスロートし、矢口恭也はさゆの口の中で射精します。沙優が少し苦戦している様子が伺えます。さゆはダブルピースサイン、あさみは矢口恭也にウィンクします。\n\nまた、これらの画像に文字を入れていただけますか？テキストバージョンとテキストレスバージョンです。\n優木あさ美：さゆのズルズルのお口は気持ちいいですか？そろそろイキそうですか？\n矢口恭也さん:ああ、すっごくきもちいね。さゆさんの新しいスマホで全部録画しますよ。おら、もっとしゃぶれよ、この浮気性の豚野郎！」。吉田さんにチンポを吸う売春婦の顔を見せてあげてね。荻原さゆ:（フェラチオの音を出している)\n\nフェラとディープスロート、どちらもテキスト/テキストレスバージョンがあります。どうもありがとうございました。", "nc": 33, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@sumomon_z/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1204405, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/88508870/uploads/origins/1ca8898d-eb58-441d-987c-b85554893ec6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=dcc3244cb6695979bbd82731e6339020", "srcset": "https://si.imgix.net/88508870/uploads/origins/1ca8898d-eb58-441d-987c-b85554893ec6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=dcc3244cb6695979bbd82731e6339020, https://si.imgix.net/88508870/uploads/origins/1ca8898d-eb58-441d-987c-b85554893ec6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=d1dd0a99611b136b7bdf1e096fba0a8a 2x, https://si.imgix.net/88508870/uploads/origins/1ca8898d-eb58-441d-987c-b85554893ec6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=39d96b57d0678f33af259c089240ad06 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/88508870/uploads/origins/1ca8898d-eb58-441d-987c-b85554893ec6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ca6ccc29d531a5ab73eecc173d64e5df", "srcset": "https://si.imgix.net/88508870/uploads/origins/1ca8898d-eb58-441d-987c-b85554893ec6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ca6ccc29d531a5ab73eecc173d64e5df, https://si.imgix.net/88508870/uploads/origins/1ca8898d-eb58-441d-987c-b85554893ec6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=7ec375f59e6e119fe8e2f7f68a2e2fdb 2x, https://si.imgix.net/88