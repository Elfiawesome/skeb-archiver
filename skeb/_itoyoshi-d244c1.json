4eeac/uploads/origins/844d637c-3a5f-464c-8cd2-1c57c1e7d139?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=410e1ed3e5a1e2044f421691a8a48304", "srcset": "https://si.imgix.net/3994eeac/uploads/origins/844d637c-3a5f-464c-8cd2-1c57c1e7d139?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=410e1ed3e5a1e2044f421691a8a48304, https://si.imgix.net/3994eeac/uploads/origins/844d637c-3a5f-464c-8cd2-1c57c1e7d139?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=0c4890794a318fb354415756de48b506 2x, https://si.imgix.net/3994eeac/uploads/origins/844d637c-3a5f-464c-8cd2-1c57c1e7d139?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=727c729d57228c21d4044b468001f284 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/3994eeac/uploads/origins/844d637c-3a5f-464c-8cd2-1c57c1e7d139?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9dd05d016eac33074ae4d35d6e51b5b9", "srcset": "https://si.imgix.net/3994eeac/uploads/origins/844d637c-3a5f-464c-8cd2-1c57c1e7d139?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9dd05d016eac33074ae4d35d6e51b5b9, https://si.imgix.net/3994eeac/uploads/origins/844d637c-3a5f-464c-8cd2-1c57c1e7d139?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=785657b323ad9683e4e5bb7c7b9e8939 2x, https://si.imgix.net/3994eeac/uploads/origins/844d637c-3a5f-464c-8cd2-1c57c1e7d139?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=7555183603babf7757b13cd7c1acb7e9 3x"}, "body": "いとよしさんこんにちは！\nリスナーとして度々イラスト拝見させて頂いています！柚木そると言います！\nいつも素晴らしいイラストを拝見させて頂き元気貰ってます！！\n\n今回もしご縁がありましたら、もちふぃさんのイラストをご依頼させて頂きたいと思いました！\nもちふぃさんにはいつもお世話になっており、御神体ちゃんというキャラクターまで生み出していただきました！\n日頃の感謝に、本人がいつも好きと言っているいとよしさんのイラストをファンアートとして送りたいと思いました！\n\nイラストを描いてるような？イメージのもちふぃさんともっちぃを描いて頂けたら！嬉しく思います！\nいつか御神体ちゃんもご依頼し