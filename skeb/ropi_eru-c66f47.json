372-405c-986c-5a20242c289d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e0213bf879b4958b49dfc4a29da39cd0", "srcset": "https://si.imgix.net/adef86c6/uploads/origins/d4697ed5-8372-405c-986c-5a20242c289d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e0213bf879b4958b49dfc4a29da39cd0, https://si.imgix.net/adef86c6/uploads/origins/d4697ed5-8372-405c-986c-5a20242c289d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=28b7ba006d92d78adeee9cf0892bb1b4 2x, https://si.imgix.net/adef86c6/uploads/origins/d4697ed5-8372-405c-986c-5a20242c289d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=55a6466cf708835c6c6a443d0788c78b 3x"}, "body": "この度は、「あやまたず、催花雨」を回して頂きありがとうございました……！\nろぴさんの素晴らしいキーパリングあってこそ、あの世界観の美しさを余すところなく味わわせていただき、心が夢幻の彼方から帰れなくなってしまったので筆を取りました。\n\n何もかもが筆舌に尽くしがたいほど愛おしく、過ぎ去った全てが花の散るような儚さと寂しさを伴って身を滅ぼしかねないくらい、本当に本当に良いセッションでした！\n\nよろしければ、あや催自陣を是非描いていただきたく思います。\nリクエスト内容は二人のツーショットです。\n構図やその他条件については、以下の通りでお願いしたく存じます。\n\n\n▼リクエスト\nHO1  柊 智秋（ひいらぎ ちあき）\nHO2  巻有 彩春（まくあ いろは）\n\n▼構図など\n・セッションで印象的だったシーン\n・二人の関係性からイメージできるもの\n・その他、描きやすいもの\nからお任せでお願いできればと思います。\n\n\n作成いただいたイラストは個人鑑賞のほか、Twitter（X）のヘッダーやアイコンに使用したいと考えています。\nまた、個人利用の範疇として、お相手さんにもお渡しできればと思っております。\nご検討のほどよろしくお願いいたします。", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@ropi_eru/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 87027, "client_id": 263006, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/28ff1d41/uploads/origins/e4028f8f-c294-4d38-ac41-c803a67f2245?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=327a737d04560b549b9ba89441654aa6", "srcset": "https://si.imgix.net/28ff1d41/uploads/origins/e4028f8f-c294-4d38-ac41-c803a67f2245?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=327a737d04560b