したが、絶対にこうしてほしいという意図はなく、どの衣装もあくまで陣内さん好みのデザインで描いて大丈夫です！\nぜひよろしくお願いします！\n\n①軍服\n赤いベレー帽タイプの軍帽とベージュか白系統の軍服\n普通に迷彩柄の軍服でもあり\n\nイメージ元：こちらの作品から主人公（前世）の軍服\n\nhttps://comic.pixiv.net/works/7626\n\n②水兵服\n白生地に青の襟や袖のマリンセーラー\n\nイメージ元：キャラクターグッズに出てきたりするマリンセーラー衣装\n\n③雪国風軍服\n耳当て付き帽子、風除けのマント、ダウンコートの上にベルト、長靴、手袋\n\nイメージ元：作中のキャラクターの雪国風軍服衣装\n\nhttps://www.pixiv.net/user/1492354/series/31703", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@zin_naxend/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1055170, "client_id": 2437718, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/0967d74f/uploads/origins/e747ecba-22a9-4e6f-9ae2-5649647369a4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d5347569cbb0ae51ffee1e7f86137844", "srcset": "https://si.imgix.net/0967d74f/uploads/origins/e747ecba-22a9-4e6f-9ae2-5649647369a4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d5347569cbb0ae51ffee1e7f86137844, https://si.imgix.net/0967d74f/uploads/origins/e747ecba-22a9-4e6f-9ae2-5649647369a4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=68d95c53481f4392ed90e511367ee7e6 2x, https://si.imgix.net/0967d74f/uploads/origins/e747ecba-22a9-4e6f-9ae2-5649647369a4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b8022589d9bf0015e43171db59342556 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/0967d74f/uploads/origins/e747ecba-22a9-4e6f-9ae2-5649647369a4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9d03afaaecfe3767b746b43bf34aba7f", "srcset": "https://si.imgix.net/0967d74f/uploads/origins/e747ecba-22a9-4e6f-9ae2-5649647369a4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9d03afaaecfe3767b746b43bf34aba7f, https://si.imgix.net/0967d74f/uploads/origins/e747ecba-22a9-4e6f-9ae2-5649647369a4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=d1bb4092d03568cf5075490b2b32b5e8 2x, https://si.imgix.net/0967d74f/uploads/origins/e747ecba-22a9-4e6f-9ae2-5649647369a4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=1554841ca6be7d4daf8b9c675d2c4f78 3x"}, "body": "お久しぶりです！仔羊くんのリクエストではお世話になりました！\n過去漫画でお披露目された私服姿の仔羊くんのカラーイラストを描いてほしいです。\n全身が見える構図で 、街中を歩いていたり学校に通っていたりなど、Dクラス職員になる前の日常生活を過ごす仔羊くんを見たいです！\n\nもし余裕がありましたら春夏秋冬の私服姿を着る仔羊くんを全身が見える構図かつ季節を感じられる背景とともに描いてほしいです。\n\nさらなる余裕があればDクラス職員の仔羊くんを全身が見える構図かつ財団施設の内部のどこか（通路、自室、実験部屋などお任せします）を背景とともに描いてほしいです。\n\nもちろん描けるところまでで大丈夫です！\nよろしくお願いします！", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@zin_naxend/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "comic", "tipped": true, "creator_id": 1055170, "client_id": 2437718, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/74781dc6/uploads/origins/2c779b84-6c21-4e7f-a18e-50f774707b2b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a774f0478fc3d39b24234e22bb2eabd2", "srcset": "https://si.imgix.net/74781dc6/uploads/origins/2c779b84-6c21-4e7f-a18e-50f774707b2b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a774f0478fc3d39b24234e22bb2eabd2, https://si.imgix.net/74781dc6/uploads/origins/2c779b84-6c21-4e7f-a18e-50f774707b2b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ad3972c5a3a582d621dae7e3eb9c72ab 2x, https://si.imgix.net/74781dc6/uploads/origins/2c779b84-6c21-4e7f-a18e-50f774707b2b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c0e7c570780566fc19d3539eec6463be 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/74781dc6/uploads/origins/2c779b84-6c21-4e7f-a18e-50f774707b2b?