mU9ODAmdHh0c2hhZD0xMCZmbT1wbmcmdz0xMjAw&marky=415&txt64=6Zmj5YaF&txtclr=fff&txtfont64=QXZlbmlyLUJsYWNr&txtfit=max&txtalign=middle%2Ccenter&txtsize=60&txtshad=10&auto=format%2Ccompress&fit=crop&crop=top&w=1200&h=630&s=1265eac1dd779752fd5daf5171d5a176", "skills": [{"genre": "comic", "default_amount": 12000}, {"genre": "art", "default_amount": 12000}, {"genre": "video", "default_amount": 12000}], "payment_methods": {"credit_cards": {"jcb": {"nsfw": true}, "master_card": {"nsfw": true}, "visa": {"nsfw": true}, "discover": {"nsfw": true}, "american_express": {"nsfw": true}}}, "acceptable_only_public": false, "tip_acceptable": true, "yearly_report_client_visible": false, "total_appeals_count": 0, "received_works": [{"path": "/@zin_naxend/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "comic", "tipped": false, "creator_id": 1055170, "client_id": 2437718, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/7e38eacc/uploads/origins/83bd1255-b941-42a5-9b46-d979be4ced00?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=39c062775ededadf2ba56cb810288b95", "srcset": "https://si.imgix.net/7e38eacc/uploads/origins/83bd1255-b941-42a5-9b46-d979be4ced00?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=39c062775ededadf2ba56cb810288b95, https://si.imgix.net/7e38eacc/uploads/origins/83bd1255-b941-42a5-9b46-d979be4ced00?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=097bcb4a59159ac478504d909ecf53c6 2x, https://si.imgix.net/7e38eacc/uploads/origins/83bd1255-b941-42a5-9b46-d979be4ced00?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=1868a9c9c298c6421dfeef6c25f897f6 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/7e38eacc/uploads/origins/83bd1255-b941-42a5-9b46-d979be4ced00?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=51db967feb64b1a4b053603314f21004", "srcset": "https://si.imgix.net/7e38eacc/uploads/origins/83bd1255-b941-42a5-9b46-d979be4ced00?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=51db967feb64b1a4b053603314f21004, https://si.imgix.net/7e38eacc/uploads/origins/83bd1255-b941-42a5-9b46-d979be4ced00?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=eff7f12cfb587f62a69c2bae5dfd9b81 2x, https://si.imgix.net/7e38eacc/uploads/origins/83bd1255-b941-42a5-9b46-d979be4ced00?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=34c7677e730df25d7d5dd4b049cc9a86 3x"}, "body": "最近ぶりでございます！\n先日は沢山の魅力的なモブキャラが登場する漫画を快く描いてくださり本当にありがとうございました！！\n\n前回の漫画の続きとして、モブDクラス職員たちが「最後の晩餐」の餌食になりΩ-7が「裏切り者のユダ」を特定して事態を収束させる漫画を描いていただけないでしようか。\n\n漫画の内容は考えましたが今回も陣内さんにお任せしますので遠慮なく描きたい物語にしてください！\n\n「その食事、食べない方がいいかもです」\nアベルに手を引かれたままブロンドのDクラス職員が相席した俺たちに意味深な言葉を残した。\nどういうことか理解できず困惑していると、食堂の空気が変わったことを肌で感じた。\nその直後に誰かの悲鳴が食堂に轟いた。\n　ギャアアアア　何だ　ヒイイイイ\n殺戮が始まり次々に同僚が「終了」していく。\n瀕死の褐色肌とそばかすが俺たちに助けを求めてきた。\n　「たすけて…」「しに…たくない…」\nその言葉を残して2人は力尽きた。\n涙が溢れて開いたまま目が生命活動の停止を告げていた。顔は寂しげに見えた。\n　食事をしなかった俺たちは地獄と化した食堂の惨劇を見ていることしかできなかった。\n　現場に到着したΩ-7は「裏切り者のユダ」をDクラス職員の中から特定し制圧した。（深く考えてはいませんが裏切り者を見分けられるヒントのようなものが存在するとかどうでしょう）\n　倒れた裏切り者が消滅すると殺戮によって息絶えたはずの同僚たちが無傷の状態になって蘇生した。\n事態が終結したことに安堵したら空腹を感じたが今はまともに食事できそうにないな。\n\n黒髪か赤茶髪の視点で内容を考えました。\n必要に応じて改変して構いません。\nお気に入りのDクラス職員を今後のリクエストで登場させやすくしたい、という超個人的な理由ですが「裏切り者を特定すれば全員助かる」という救済ルートを設けてもよろしいでしょうか？\nもちろん考案者である陣内さんの「こうあってほしいという考え」を一番に尊重します！\n\n他の思いついたアイデアも漫画に組み込めそうなものを選んでいただけたら幸いです。\n・アベルと仔羊もΩ-7とともに登場し事態を収束させる\n・現場に居合わせたことで黒髪くんと赤茶髪くんも命の危機に陥る\n◯ 「最後の晩餐」について\n・操り系。自身の意思に関係なく体が勝手に動いて他人や自分を攻撃する\n・精神作用系か幻覚系。例えば自分以外が敵に見える、攻撃性が増幅するなど。影響力は個人差がある\n・呪い系。苦しみだして叫びながら目、口、鼻、耳から赤い液体が溢れ出す\n・ポルターガイスト系。人間の体を浮かせて叩きつける、ナイフやフォークが攻撃するなど\n・念動力系。じわじわと関節がありえない方向に曲がる、首をゴキっとするなど\n・変身系。裏切り者が正体を表して物理的に暴れ回る\n\nモブDクラス職員たちが翻弄された末にやられるところとΩ-7の見せ場を見れたら嬉しいです。\nよろしければぜひお願いします！", "nc": 161, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@zin_naxend/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "comic", "tipped": true, "creator_id": 1055170, "client_id": 2437718, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/de590366/uploads/origins/c37d4054-16e7-4651-bc88-c3a0e8e479c3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d1704b0a5ba82b56447926aa29e71ad0", "srcset": "https://si.imgix.net/de590366/uploads/origins/c37d4054-16e7-4651-bc88-c3a0e8e479c3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d1704b0a5ba82b56447926aa29e71ad0, https://si.imgix.net/de590366/uploads/origins/c37d4054-16e7-4651-bc88-c3a0e8e479c3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=221f5cfca2ab03582863ce9d80dd72e9 2x, https://si.imgix.net/de590366/uploads/origins/c37d4054-16e7-4651-bc88-c3a0e8e479c3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=bd9d3f8c86923e15277c33497204c9c6 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/de590366/uploads/origins/c37d4054-16e7-4651-bc88-c3a0e8e479c3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=73e82a0b252299a51ed0641592af9e22", "srcset": "https://si.imgix.net/de590366/uploads/origins/c37d4054-16e7-4651-bc88-c3a0e8e479c3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=73e82a0b252299a51ed0641592af9e22, https://si.imgix.net/de590366/uploads/origins/c37d4054-16e7-4651-bc88-c3a0e8e479c3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=00750cf314d78466ca4198ed9b4948c8 2x, https://si.imgix.net/de590366/uploads/origins/c37d4054-16e7-4651-bc88-c3a0e8e479c3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=16c403b86311e40f8ba61c21d4bcba2a 3x"}, "body": "いつもお世話になっています！\n可能でしたらモブDクラス職員たちと仔羊くんが交流する漫画を描いてほしいです！\n\n仔羊くんや機動部隊Ω-7隊員のキャラクターデザインが本当に格好良くて素敵で、オリジナルのDクラス職員も見たくなってリクエストしました！\n外見の特徴候補も書いていますが、基本的にモブDクラス職員のキャラクターデザインもお任せします。\n仔羊くんと同じくらいの年齢の若い男性をイメージしています。\n余談ですが彼らがDクラス職員になった経緯は、身寄りもなく社会的に孤立している（仔羊くんのように奪われた側の末路）ゆえに財団に利用されたか、犯罪者が無罪及び釈放を条件に取引してか、と想像しています。\n\n2人ほど優先的に描いてほしいキャラがいます。\n\n・黒髪とハイライトの無い又は薄い黒目\n・短い髪を後ろで結んでいるツンツン赤茶髪\n\nそして、こちらはあくまで余裕があれば描いてほしいキャラです。\n全員は難しいと思いますので陣内さんが描きたい特徴のキャラだけで大丈夫です。\nここに書いていない特徴のキャラを描いて大歓迎です。\n\n・癖毛の茶髪\n・そばかす顔\n・口の下だけに生えている縦線顎鬚のおっさん風キャラ（仔羊くんより上の世代）\n・センターパート\n・上がっている前髪、デコ出し\n・ウェーブ髪\n・おかっぱ頭、マッシュヘア\n・短い後ろ髪が左右に広がる感じの外ハネ髪\n・ウルフヘア\n・褐色肌\n\n漫画としては、\n・食堂でグループで会話しながら食事する\n・大人数のDクラス職員が参加するSCPの実験（オリジナルSCPでもOK）\n参考用候補： SCP-855 - 映画館、SCP-1475-JP - 標的はノースカロライナ、SCP-2439:[スロット割り当てなし]、etc\n・アベルを前にほとんどがプレッシャーに呑まれる中、仔羊くんだけ普通に話しかけて周りから「お前すげえな」と一目置かれる\n\nあくまで描ける範囲の人数で構いませんのでよろしければぜひお願いします！", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@zin_naxend/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "comic", "tipped": true, "creator_id": 1055170, "client_id": 2437718, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/49b93b7e/uploads/origins/9a0d293e-aa88-4de6-9643-a5f3ff3efca9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e86c9c82490d850b9f02bc97cf0702b6", "srcset": "https://si.imgix.net/49b93b7e/uploads/origins/9a0d293e-aa88-4de6-9643-a5f3ff3efca9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e86c9c82490d850b9f02bc97cf0702b6, https://si.imgix.net/49b93b7e/uploads/origins/9a0d293e-aa88-4de6-9643-a5f3ff3efca9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=9c658988abc39c09aee6154464cfaa8a 2x, https://si.imgix.net/49b93b7e/uploads/origins/9a0d293e-aa88-4de6-9643-a5f3ff3efca9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=cf1e47ec7558e1bb0e29f8bab54bad07 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/49b93b7e/uploads/origins/9a0d293e-aa88-4de6-9643-a5f3ff3efca9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=7642ba66fe25406c2ec6c321f9cafc7a", "srcset": "https://si.imgix.net/49b93b7e/uploads/origins/9a0d293e-aa88-4de6-9643-a5f3ff3efca9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=7642ba66fe25406c2ec6c321f9cafc7a, https://si.imgix.net/49b93b7e/uploads/origins/9a0d293e-aa88-4de6-9643-a5f3ff3efca9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=60b419fdc2319d3be681d5ae1ae85d7a 2x, https://si.imgix.net/49b93b7e/uploads/origins/9a0d293e-aa88-4de6-9643-a5f3ff3efca9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=e8c17963c9896c1accba0ec806e7e396 3x"}, "body": "お疲れ様です！いつもお世話になっています！\n癖全開のリクエストで恐れ多いのですが、仔羊くんが吸血される漫画を描いてほしいです！\n\nなんちゃってSCPの実験の一環か餌を与えるというお話を考えていますがシチュエーションは一任します。\n吸血生物の外見は、吸血鬼のような人型でも、ヒルや獣などの人型以外でも、自由に決めてください。\n吸血生物の唾液などの退役には獲物を麻痺させる神経毒のような成分があるため、噛まれたり体内に注入されたりした対象は神経麻痺により徐々に動けなくなります。\n\n騙されて自身の血液を与えることになった仔羊くんが囚人服の襟口を相手に剥がされ首まわりに牙などを突き立てられて吸血される。\n\n吸血される恐怖で引き攣った表情で思わず相手を引き離そうとする仔羊くん。\n最初は相手の体を掴んだり叩いたり足をばたつかせたりするが、だんだん力が入らなくなり両手がストンと落ちてぶら下がり、麻痺した身体がピクッピクッと弱々しく痙攣を起こす。\n涙が溢れる目も霞んでいき、意識も朦朧として声もか細くなっていく。\n最終的にガクッと意識を喪失し、顔と吸血の傷跡が見えるようにその場でバタッと倒れるかクタァと座り込む。\n\n一応、命は助かるつもりで考えていますが最後はどうなるかも含めてお任せします！\n薄々気づいているかもしれませんが、当方は吸血される恐怖に染まったまま力尽きるというシチュエーションが大の好物でございます。\n陣内さんの漫画で描いてもらえないかと考えた時に真っ先に思い浮かんだ歩く不憫こと仔羊くんが主役に相応しいと考え彼に白羽の矢を立てました！（おい）\n\n仔羊くんには、「はなせ、いやだ、たすけて」などの必死な声を叫ばせてほしいです。\n吸血される時の苦悶の表情や恐怖で悶絶する時の悲鳴や喘ぎも見てみたいです。\n\n以上のような、吸血によって徐々に衰弱していく姿をぜひ描いてください！\n\nもちろん無理を言うつもりはありませんのでご検討をよろしくお願いします。", "nc": 161, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@zin_naxend/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1055170, "client_id": 2437718, "vtt_url": null, "thumbnail_image_