-4e7f-a18e-50f774707b2b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a774f0478fc3d39b24234e22bb2eabd2", "srcset": "https://si.imgix.net/74781dc6/uploads/origins/2c779b84-6c21-4e7f-a18e-50f774707b2b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a774f0478fc3d39b24234e22bb2eabd2, https://si.imgix.net/74781dc6/uploads/origins/2c779b84-6c21-4e7f-a18e-50f774707b2b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ad3972c5a3a582d621dae7e3eb9c72ab 2x, https://si.imgix.net/74781dc6/uploads/origins/2c779b84-6c21-4e7f-a18e-50f774707b2b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c0e7c570780566fc19d3539eec6463be 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/74781dc6/uploads/origins/2c779b84-6c21-4e7f-a18e-50f774707b2b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=44c6b281f93307704f876881d26d19be", "srcset": "https://si.imgix.net/74781dc6/uploads/origins/2c779b84-6c21-4e7f-a18e-50f774707b2b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=44c6b281f93307704f876881d26d19be, https://si.imgix.net/74781dc6/uploads/origins/2c779b84-6c21-4e7f-a18e-50f774707b2b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=88c080b5e975a01969e188b95ef5253a 2x, https://si.imgix.net/74781dc6/uploads/origins/2c779b84-6c21-4e7f-a18e-50f774707b2b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=049602a62d4bf5b850177ee618cf41a1 3x"}, "body": "お疲れ様です！仔羊くんことDクラスくんの過去漫画を描いてくださり本当にありがとうございました！半死半生の人生をどうにか食い繋いで生きている仔羊くんをますます好きになりました！！(*⁰▿⁰*)\n\n仔羊くんがSCP-2521「●●|●●●●●|●●|●」に実験を通して執着されるという内容の漫画を描くことは可能でしょうか。\n仔羊くんの立場上、ロストやフェードアウトは望ましくないかもしれないので、その辺の塩梅も込みでストーリーの流れは陣内さんにお任せします！\n\n難しくなければ、仔羊くんがSCP-2521のヒラヒラで全身を絡みつかれている姿、欲を言えば口にヒラヒラを入れられ粘液を飲ませられる様子を入れていただけますか…？\n無理なら絡みつく姿だけで構いません！\n