https://x.com/dark_ishihara/status/1205516811455696896?s=46&t=rjAnPsSG6thqGUob-2d95g）の画像の様に彼女が胸元にアイスクリームを付けられてしまっているシチュエーションで、\n\n彼女は資料の画像の様に驚いた表情でアイスの付いた胸元に目をやる感じにお願いします。\n\n以上の内容のシーンを描いてほしいです！ もしお引き受けいただけるならとても嬉しいです！\n\nお忙しいかと思いますがどうかご一考下さいます様よろしくお願い致します。\n\n私のメッセージを最後まで読んで頂きありがとうございました！\n感謝します。", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@hayuha1203/works/9", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3168723, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/359b1676/uploads/origins/bb19fef0-b318-4492-967d-b6eb714ca52f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=aabceb63c061069712fd7240cc77c83a", "srcset": "https://si.imgix.net/359b1676/uploads/origins/bb19fef0-b318-4492-967d-b6eb714ca52f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=aabceb63c061069712fd7240cc77c83a, https://si.imgix.net/359b1676/uploads/origins/bb19fef0-b318-4492-967d-b6eb714ca52f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=49ba2ae2b861b436a43e8b04849453de 2x, https://si.imgix.net/359b1676/uploads/origins/bb19fef0-b318-4492-967d-b6eb714ca52f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=1a9f80c3f307787729996d3b5f5353ab 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/359b1676/uploads/origins/bb19fef0-b318-4492-967d-b6eb714ca52f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=de692a84105988ece5dba8abd9b99c58", "srcset": "https://si.imgix.net/359b1676/uploads/origins/bb19fef0-b318-4492-967d-b6eb714ca52f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=de692a84105988ece5dba8abd9b99c58, https://si.imgix.net/359b1676/uploads/origins/bb19fef0-b318-4492-967d-b6eb714ca52f?bg=%23fff&auto=format%2Ccompress&f