dpr=3&fit=crop&crop=top&w=200&h=200&s=be5edd332ad8f86ea615f422f0aa2780 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/365046a3/uploads/origins/a32268e8-ddc6-4a15-93bb-adf83511daed?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=04068f4461fce4c0e923286018f7f1ed", "srcset": "https://si.imgix.net/365046a3/uploads/origins/a32268e8-ddc6-4a15-93bb-adf83511daed?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=04068f4461fce4c0e923286018f7f1ed, https://si.imgix.net/365046a3/uploads/origins/a32268e8-ddc6-4a15-93bb-adf83511daed?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=c5f601745e7b52f6f38d80ce96d31e78 2x, https://si.imgix.net/365046a3/uploads/origins/a32268e8-ddc6-4a15-93bb-adf83511daed?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=26badb1870424dd48fa67ca93cb0dd78 3x"}, "body": "ゆっきぃと申します。先日はスケブ依頼ありがとうございました。\nまた改めてですが、リクエストさせていただきます。\nお願いしたいイラストですが、初瀬ヌイくんという、男の娘VTuberです。\n《参考URL》\nhttps://twitter.com/Nui_nanoda/status/1435415653125537795?t=dVCR1mi7s_4FNQLzNMrWlw&s=19\nドーナツが好きでもぐもぐ食べてる所をお願いしたいです。\nドーナツはミスドのゴールデンチョコレートで、背景や構図はお任せいたします。\n\n使用用途はファンアートとプレゼントで使用したいと思いますので、よろしくお願いします。", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Holmesheaven__/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2881541, "client_id": 3161323, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/bc3f869b/uploads/origins/2e3d87cc-f5d6-4d9a-a3db-01e39700c07e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2c5ec1c450bf30da8a7081a6c75b7ea5", "srcset": "https://si.imgix.net/bc3f869b/uploads/origins/2e3d87cc-f5d6-4d9a-a3db-01e39700c07e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2c5ec1c450bf30da8a7081a6c75b7ea5, https://si.imgix.net/bc3f869b/uploads/origins/2e3d87cc-f5d6-4d9a-a3db-01e39700c07e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=0937b70a9d63b11ed43df415cbd42087 2x, https://si.imgix.net/bc3f869b/uploads/origins/2e3d87cc-f5d6-4d9a-a3db-01e39700c07e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=664a017f71ef8874b6d50617e1c48448 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/bc3f869b/uploads/origins/2e3d87cc-f5d6-4d9a-a3db-01e39700c07e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=eb2451f1d1ca4a1156226d8e68d7718d", "srcset": "https://si.imgix.net/bc3f869b/uploads/origins/2e3d87cc-f5d6-4d9a-a3db-01e39700c07e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=eb2451f1d1ca4a1156226d8e68d7718d, https://si.imgix.net/bc3f869b/uploads/origins/2e3d87cc-f5d6-4d9a-a3db-01e39700c07e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=1cb4585e4cdeb99f4ed5507755390ec4 2x, https://si.imgix.net/bc3f869b/uploads/origins/2e3d87cc-f5d6-4d9a-a3db-01e39700c07e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=2f55e72155f1d4a159f6570fd6855aaf 3x"}, "body": "はじめまして。ゆっきぃと申します。\nホームズさんのイラストを拝見して、リクエストさせていただきました。\n描いていただきたいのは、あおいつきね(@aoitukine)さんという、ショタボの狐のVTuberです。\n《参考URL》https://x.com/aoitukine?t=VCSuODcEhta2M0fpabe2Jg&s=09\n\n構図は自信満々に歌うのと、脚フェチなので見えるように。それ以外は、おまかせでお願いします。\n\n使用用途は、ファンアートとしてプレゼントさせていただきたいです。あとは自分がTwitterで上げる程度と、相手様が使用する許可をいただきたいです。\n\nこちらに打ち込むのは初めてですので、稚拙な文章で申し訳ありませんが、なにとぞよろしくお願いします。", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Holmesheaven__/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2881541, "client_id": 3111717, "vtt_url": null, "thumbnail_image_urls"