ます。\n\nセシルのイラストは以下URLより公式サイトより『幸せ依存症』をダウンロードして確認をお願いします。\n\nよろしくお願いします。\n賛同頂けましたら、幸いです。", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 1955, "creator": true, "nsfw_acceptable": false, "acceptable": false, "name": "宮沢", "screen_name": "urn_k", "avatar_url": "https://pbs.twimg.com/profile_images/1245309129947660289/M44vm7Fs.png", "header_url": "https://pbs.twimg.com/profile_banners/4754615412/1763506586/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 120, "skills": [{"genre": "art"}, {"genre": "comic"}], "banned": false, "nc": 145}, {"id": 237164, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "茅ヶ崎ゆかり", "screen_name": "chigasaki_y", "avatar_url": "https://pbs.twimg.com/profile_images/1750480417613070336/O1cahfbm.jpg", "header_url": "https://pbs.twimg.com/profile_banners/890217501790842880/1695894152/1500x500", "appeal_receivable": true, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "art"}], "banned": false, "nc": 48}, {"id": 639236, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "空雀(そらすずめ)", "screen_name": "cw_evening", "avatar_url": "https://pbs.twimg.com/profile_images/1363059588757512196/PMC7NPRY.png", "header_url": "https://pbs.twimg.com/profile_banners/1908331812/1536244180/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "art"}, {"genre": "video"}], "banned": false