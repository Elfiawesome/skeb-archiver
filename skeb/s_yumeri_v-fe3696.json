すけど、そのような感じで読んでほしくは無いです。\nここまで読み方指定してアレなんですけど、えなさんが感じたままを自由に読んでほしいのが僕としては1番大切なところです。\n無理はなさらずに。\nゆっくりでいいので完成待ってます✨\n\n金額は応援も込めて少し多めにしたのですが、何か問題があったら申し訳ないです…", "nc": 1, "word_count": 0, "transcoder": "audio", "creator_acceptable_same_genre": true}, {"path": "/@s_yumeri_v/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "voice", "tipped": false, "creator_id": 262241, "client_id": 500466, "vtt_url": "https://fcdn.skeb.jp/uploads/276865/0/vtt/0.vtt?response-content-disposition=inline&Expires=1784407221&Signature=dEdHiqxkOJWt7V4vowVgqW2aljSS7U62InT3XXQasMODiL0CVaMex4zk-vY5QTI1lAZDxligdhRCl3MpNFsdwSJvJ3o8vyBOh7E5qchX~Zj2VVbaTf4pjEyWigYfL1sF7LoKPPqptNkJl1wrB1Ozh4XCnToFjXTZM0cJWLLq8L2skcvFyRVz5~4YIIIyb56gUFjbNH0FVgGZRVL8QVj3ng4EyYE0PebIrkc3LmdJdV2lyGBWVHPlt5mdj6FRmG6lnDWO~vY0sLpXWkRQdQbXF-sIJDokH2m9nlBmCwcq5neB2gZKYbTCNBROpFd1Avkw0pp19z1Q-x5m9B7WC-co6w__&Key-Pair-Id=K1GS3H53SEO647", "thumbnail_image_urls": {"src": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1774778957457661952%2FYL1-uN2d.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=80474aba734a59aac8fcbfd128d34a88", "srcset": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1774778957457661952%2FYL1-uN2d.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=80474aba734a59aac8fcbfd128d34a88, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1774778957457661952%2FYL1-uN2d.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e18d4a13f20cf816a393a4f03a326077 2x, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1774778957457661952%2FYL1-uN2d.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=958aa942f0a0366c53935ef643c126c0 3x"}, "preview_url": "https://fcdn.skeb.jp/uploads/276865/0/mp3_128k/0?response-content-disposition=inline&Expires=1784407221&Signature=E0MelREB5GOp4Qp