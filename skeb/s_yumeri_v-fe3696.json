ど、そのような感じで読んでほしくは無いです。\nここまで読み方指定してアレなんですけど、えなさんが感じたままを自由に読んでほしいのが僕としては1番大切なところです。\n無理はなさらずに。\nゆっくりでいいので完成待ってます✨\n\n金額は応援も込めて少し多めにしたのですが、何か問題があったら申し訳ないです…", "nc": 0, "word_count": 0, "transcoder": "audio", "creator_acceptable_same_genre": true}, {"path": "/@s_yumeri_v/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "voice", "tipped": false, "creator_id": 262241, "client_id": 500466, "vtt_url": "https://fcdn.skeb.jp/uploads/276865/0/vtt/0.vtt?response-content-disposition=inline&Expires=1783516212&Signature=hBB3AArDNmDeGeybMzJN6OoR5REznPkIyP1StqOSMocoAy5JjHzfm7HYViAaAYk1I7Fhy3QodIMNCW1FU0UV9StMlROfJLUOC1u9UQ-z9dIQuw-~SWYcQLJ3YDQIWnYLQTIkRQyOkrrugIQYZ8ZmSSlRV1djtr0yAJ0bBIFFKvS8RIavFO3lSgYPFleU5sYZ6hKeRDAKxfUPMLOFqt0hByJJ4SmnWDsq15Z0PMS~HxY~mAP6X~zpMCauERIFq1bP-L13PZLwr5--q-3bSfbqjOcYn~IPDtMPpYGRtzLuniUj4e6zffyc7bsTR~rD4TtudU7Mqzz3VK9h74LVBUVyFQ__&Key-Pair-Id=K1GS3H53SEO647", "thumbnail_image_urls": {"src": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1774778957457661952%2FYL1-uN2d.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=80474aba734a59aac8fcbfd128d34a88", "srcset": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1774778957457661952%2FYL1-uN2d.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=80474aba734a59aac8fcbfd128d34a88, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1774778957457661952%2FYL1-uN2d.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e18d4a13f20cf816a393a4f03a326077 2x, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1774778957457661952%2FYL1-uN2d.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=958aa942f0a0366c53935ef643c126c0 3x"}, "preview_url": "https://fcdn.skeb.jp/uploads/276865/0/mp3_128k/0?response-content-disposition=inline&Expires=1783516212&Signature=cZ2x4wjL6~RzUYPq9