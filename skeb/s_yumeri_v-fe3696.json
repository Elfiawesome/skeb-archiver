かな,と考えています.\n左透さんが以降,それを宣伝しても全く構いません.\nただ,イベント自体はクローズドなので外に拡がるようなものでは無いです.\n\n以上,よろしくお願いします！", "nc": 17, "word_count": 0, "transcoder": "audio", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 16246, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "愛守ノユリ☃🦇", "screen_name": "ice_noyuri", "avatar_url": "https://pbs.twimg.com/profile_images/1620718587748163585/9M2dNB50.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1014898228951638021/1680390630/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "voice"}, {"genre": "art"}, {"genre": "novel"}], "banned": false, "nc": 49}, {"id": 383543, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "桃雛なの🎀✨父ノ背中🍑", "screen_name": "momohina_nano", "avatar_url": "https://pbs.twimg.com/profile_images/2063057186843185152/l58PFoIa.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1197735349021106178/1695496872/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "voice"}, {"genre": "art"}], "banned": false, "nc": 184}, {"id": 1005172, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "アライネコ🐱🧪イラストレーターvtuber", "screen_name": "arainekozz", "avatar_url": "https://pbs.twimg.com/profile_images/1816817858489503744/CKrnKG0-.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1338497245897867267/1729338602/1500x500", "appeal_receivable": true, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "comple