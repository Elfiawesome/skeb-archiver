たものもいただきたいです。\n無理でしたら大丈夫です。\n\n・見た目　\nピンク髪の子は男の子です。\n目の右下にハートがあります。\n\n参考\nhttps://lit.link/fusaku\n\nhttps://lit.link/fusaku", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 899508, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "よしお", "screen_name": "scomsio", "avatar_url": "https://proxy.misskeyusercontent.jp/avatar/media.misskeyusercontent.jp%2Fio%2F1643ff31-9fe7-49c5-a8d6-74e745d202d0.png%3Fsensitive%3Dtrue?avatar=1", "header_url": "https://media.misskeyusercontent.jp/io/a2332b22-d895-43ee-8c7f-713a5d903a09.png", "appeal_receivable": true, "popular_creator_rank": 78, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 3, "complete_expiration_days": 14, "skills": [{"genre": "art"}], "banned": false, "nc": 32}, {"id": 1184415, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "あざらし太郎", "screen_name": "azatarou_h", "avatar_url": "https://pbs.twimg.com/profile_images/1717793820426039296/g5TWM8Ph.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1278682253166391299/1651937046/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 10, "complete_expiration_days": 10, "skills": [{"genre": "art"}], "banned": false, "nc": 177}, {"id": 2620286, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "いかわさ🦑(チゲ味)", "screen_name": "Midori_annte23", "avatar_url": "https://pbs.twimg.com/profile_images/1772462509385269248/3WO5dS3i.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1288136668696809473/1711452276/1500x500", "appeal_receivable": true, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_e