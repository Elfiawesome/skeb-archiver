2&fit=crop&crop=top&w=200&h=200&s=343fb8a9ab3cad7625bf8f8ba662af75 2x, https://si.imgix.net/de3b3124/uploads/origins/5f46ce83-91b2-4f18-96e1-89de0254d7a2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=1fffeea65c73464fd40516c81e228145 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/de3b3124/uploads/origins/5f46ce83-91b2-4f18-96e1-89de0254d7a2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=58cff6ea99bb6d42f694c45ea063650b", "srcset": "https://si.imgix.net/de3b3124/uploads/origins/5f46ce83-91b2-4f18-96e1-89de0254d7a2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=58cff6ea99bb6d42f694c45ea063650b, https://si.imgix.net/de3b3124/uploads/origins/5f46ce83-91b2-4f18-96e1-89de0254d7a2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=2e41fea4594fd44f838795aa4650cb1d 2x, https://si.imgix.net/de3b3124/uploads/origins/5f46ce83-91b2-4f18-96e1-89de0254d7a2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=e7def8855f59cb5262465bae1cff2255 3x"}, "body": "こんにちは、あなたの作品が大好きです！私のオリジナルキャラクターを描いていただけないでしょうか。\nhttps://toyhou.se/1854871.willow\n彼女は、青い炎の魔法を使えるいたずら好きな女の子で、新しい魔法を学ぶために魔法の本を読むのが大好きです。また、スナイパーでもあります。\n\nデザインに関するメモ：\n- 目の下に濃いマスカラを塗っています。\n- 髪型についてはこちらをご参照ください https://gyazo.com/3ad20a79ff322502455c3fe97485c190\n\n可能であれば、魔法の図書館にいる姿を描いていただけると嬉しいです。あなたの作品のファンタジーな雰囲気が大好きです！\nご検討いただきありがとうございます！", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Shirotsuchi2/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3797407, "client_id": 3273138, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/007e1b98/uploads/origins/0556355c-172f-40d7-96e9-c0f020060321?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=517b1309147d9acee5c747531532945b", "srcset": "https://si.imgix.net/007e1b98/uploads/origins/0556355c-172f-40d7-96e9-c0f020060321?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=517b1309147d9acee5c747531532945b, https://si.imgix.net/007e1b98/uploads/origins/0556355c-172f-40d7-96e9-c0f020060321?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=401568122aff59d2de0b62bb9341fe48 2x, https://si.imgix.net/007e1b98/uploads/origins/0556355c-172f-40d7-96e9-c0f020060321?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=015daa5b7f98dcd1973de41bafdba749 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/007e1b98/uploads/origins/0556355c-172f-40d7-96e9-c0f020060321?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=215b4807fcd710ff6b57c59a87e674de", "srcset": "https://si.imgix.net/007e1b98/uploads/origins/0556355c-172f-40d7-96e9-c0f020060321?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=215b4807fcd710ff6b57c59a87e674de, https://si.imgix.net/007e1b98/uploads/origins/0556355c-172f-40d7-96e9-c0f020060321?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=c4d834908390387c4415f11a1f0f6758 2x, https://si.imgix.net/007e1b98/uploads/origins/0556355c-172f-40d7-96e9-c0f020060321?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=91e6ec098150bf3e30aec5568596c301 3x"}, "body": "こんにちは！白土蛍先生の作品の雰囲気が大好きです。作品が醸し出す、夢のような幻想的なゴシックな雰囲気にすっかり魅了されてしまいました…！私のOCをリクエストおねがいしたいです。\n\nメインテーマは月と深海。従順で真面目な子供で、厳格な母親から完璧な娘、リーダーになるよう教育されている。彼女の世界では、学校は軍隊のようなもので、子供たちを戦争の兵士として訓練する。彼女は生徒会長で、生徒を使った実験（ロボトミー手術）を行っている。彼女の見た目のせいで、人々は彼女を実際よりも年上だと勘違いしがちです。生徒が使い物にならなくなると、冷酷なやり方で几帳面に処分し、自ら死体を埋める。\n\n彼女が本当のやりたいことは、毎日おとぎ話を読んだり、森で妖精を探したりすることだ。人魚も好き。科学的好奇心は残酷なほど強い。子供の頃から蝶の羽を紙にとめ、真ん中で妖精の姿をスケッチする。部屋には、その「妖精」の絵、額に入れて壁に飾られた。クラゲやピラニアが入った水槽も飾られている。\n\n先生の絵で蝶のテーマ好きですので、可能であれば、「妖精」の絵を構図に取り入れたいのですが、 構図は先生にお任せします！今回届いた作品に描かれている魚と海のモーチフもすごく気に入りました…！衣装を自由にアレンジしてもかまいません。\n\n没ラフや下描きなどがあればPSDに残したままにしていただけると嬉しいです。ご検討ありがとうございます。\n\nhttps://drive.google.com/drive/folders/1zEtVCA3j7dLaA6jZhn6tVgRxjMFWVd3N?usp=drive_link", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Shirotsuchi2/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3797407, "client_id": 4067911, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/75087a28/uploads/origins/361b96da-afc1-42c3-aa1a-e5d25af45bb2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c0451b7da997f02d2923e3588050cf85", "srcset": "https://si.imgix.net/75087a28/uploads/origins/361b96da-afc1-42c3-aa1a-e5d25af45bb2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c0451b7da997f02d2923e3588050cf85, https://si.imgix.net/75087a28/uploads/origins/361b96da-afc1-42c3-aa1a-e5d25af45bb2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=7b405e5b163d1ad3950c700b3d1d50a1 2x, https://si.imgix.net/75087a28/uploads/origins/361b96da-afc1-42c3-aa1a-e5d25af45bb2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f9a809433752366894fff93b8fdbf290 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/75087a28/uploads/origins/361b96da-afc1-42c3-aa1a-e5d25af45bb2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=4bd60101bd64de35ae7a317d099f529c", "srcset": "https://si.imgix.net/75087a28/uploads/origins/361b96da-afc1-42c3-aa1a-e5d25af45bb2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=4bd60101bd64de35ae7a317d099f529c, https://si.imgix.net/75087a28/uploads/origins/361b96da-afc1-42c3-aa1a-e5d25af45bb2?bg=%23fff&auto=format%2Ccompres