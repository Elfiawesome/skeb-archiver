n現在、天体のメソッド公式サイトは閉鎖なのか不具合なのかわかりませんが閲覧できない状態です。参考URLにノエルちゃんの画像を載せておきます。\nちょうど前述のアロナのような構図で、笑顔で椅子や公園のベンチもしくはブランコのようなところに座って、無邪気に足を動かしているような感じをお願いしたいです。\nその他細かい部分はお任せします。\n\nマニアックなリクエストとなり恐縮ですが、引き受けてくださると幸いです。よろしくお願いします。\n\nhttps://drive.google.com/drive/folders/1L_hb3fBgNPSRQJ7uekVEsRiGNcq_ok1_?usp=sharing", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@aYatama950/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2413110, "client_id": 1250821, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/2afe4cc3/uploads/origins/76edccec-55f6-47a3-87ee-0f1842f85a65?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e2db1f65f62b583821f73713c1d37c29", "srcset": "https://si.imgix.net/2afe4cc3/uploads/origins/76edccec-55f6-47a3-87ee-0f1842f85a65?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e2db1f65f62b583821f73713c1d37c29, https://si.imgix.net/2afe4cc3/uploads/origins/76edccec-55f6-47a3-87ee-0f1842f85a65?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=643b665821f4e9f92347d6fe943bdc8f 2x, https://si.imgix.net/2afe4cc3/uploads/origins/76edccec-55f6-47a3-87ee-0f1842f85a65?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=1d4fd2fce3f2518b4c46891fb73ef2ca 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/2afe4cc3/uploads/origins/76edccec-55f6-47a3-87ee-0f1842f85a65?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c1a4ea9c6a537515d579d956f32e5f5e", "srcset": "https://si.imgix.net/2afe4cc3/uploads/origins/76edccec-55f6-47a3-87ee-0f1842f85a65?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c1a4ea9c6a537515d579d956f32e5f5e, https://si.imgix.net/2afe4cc3/uploads/origins/76edccec-55f6-47a3-87ee-0f1842f85a65?bg=%2