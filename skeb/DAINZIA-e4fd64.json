58-bf5a-ea3d832c2694?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5d8d59165f32c6ed31e8367dbfe1319f", "srcset": "https://si.imgix.net/82c82506/uploads/origins/ae4c3590-ae1a-4458-bf5a-ea3d832c2694?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5d8d59165f32c6ed31e8367dbfe1319f, https://si.imgix.net/82c82506/uploads/origins/ae4c3590-ae1a-4458-bf5a-ea3d832c2694?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=222927016e49427ce9f64cd5435ba54e 2x, https://si.imgix.net/82c82506/uploads/origins/ae4c3590-ae1a-4458-bf5a-ea3d832c2694?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=f85bf21402aeb601abcaa4babd3573e7 3x"}, "body": "いつも応援しております！\n「ふたなり×ショタのハッピー子作りウェディング」が特に大好きで、そこに登場するふたなり後輩君をメインに、イラストor漫画のモノクロ作品をお願いしたいです。\n\n「先輩ショタにムラムラしたふたなり君が、抑えつけて無理やり抱いてメス堕ちさせる」というシチュが希望になります…。\nふたなり君は↑の作品同様に、可愛い系イケメン、褐色、筋肉質、極太デカチン、陰毛あり、身長や手が大きくて逞しいというキャラで、性欲旺盛なヤリチンだと嬉しいです。\nショタは先輩ですが、ふたなり君より体が小さく、粗チンで中性的なキャラだとありがたいです。", "nc": 41, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@DAINZIA/works/14", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 277825, "client_id": 447819, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/6fae225c/uploads/origins/befeece4-634a-4ec3-aef9-9b76db798f3d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d162bbbb7952d8be8825dde2fad675c5", "srcset": "https://si.imgix.net/6fae225c/uploads/origins/befeece4-634a-4ec3-aef9-9b76db798f3d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d162bbbb7952d8be8825dde2fad675c5, https://si.imgix.net/6fae225c/uploads/origins/befeece4-634a-4ec3-aef9-9b76db798f3d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=bd5ad0d6dc2bfc8bcb6c3de0f6a50cf5 2x, https://si.imgix.net/6fae225c/uploads/origins/befeece4-634a-4ec3-aef9-9b76db798f3d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c3ffae402f5651db8b8e1a5cb2611cdc 3x"}, "duration": null, "nsfw": true, "hardcore": true, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/6fae225c/uploads/origins/befeece4-634a-4ec3-aef9-9b76db798f3d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e6833137386262f0af4a15abc1107e9b", "srcset": "https://si.imgix.net/6fae225c/uploads/origins/befeece4-634a-4ec3-aef9-9b76db798f3d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e6833137386262f0af4a15abc1107e9b, https://si.imgix.net/6fae225c/uploads/origins/befeece4-634a-4ec3-aef9-9b76db798f3d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=6ce3887f7f4d925f72b1615b68fb5c79 2x, https://si.imgix.net/6fae225c/uploads/origins/befeece4-634a-4ec3-aef9-9b76db798f3d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=64a3899fad0e4da4eca174e001d3d7b6 3x"}, "body": "以前リクエストした作品(https://skeb.jp/@DAINZIA/works/12)と同じ男の子でまたお願いします。\n今回も特殊で、学校のクラスで「ゴミ箱係」的な係にさせられ、クラスで出たゴミをお腹に詰め込んでいく……というシチュです。\n\n昼食が終わる頃、残飯やプラゴミ、紙パック等でお腹を膨らませている、という場面をお願いします。\n\n細かくなりますが、\n・お腹に、ゴミ箱であることを表す表示(タトゥーや焼印のような消せないものだとそそります)\n・お腹はまんまるではなく、ゴミの形が浮かぶようなボコッとした膨らみ\n・人の手ではなく、自分の手で無理矢理詰め込む\nという感じでお願いしたいです。", "nc": 43, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@DAINZIA/works/13", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 277825, "client_id": 1186474, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/945ef67e/uploads/origins/3fd89bc4-e3e9-4a9f-abda-bec999a93975?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=494822b06b1f1d0cb39376e58b6883de", "srcset": "https://si.imgix.net/945ef67e/uploads/origins/3fd89bc4-e3e9-4a9f-abda-bec999a93975?bg=%23fff&auto=forma