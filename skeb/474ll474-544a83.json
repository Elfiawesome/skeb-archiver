ったりちょっとお節介な一面もある子です。\n\nこの子の立ち絵を手掛けて頂けないでしょうか？\n構図やポーズ、雰囲気や服装など、全てお任せできると嬉しいです！\n良ければ彼女の高身長ぶりや頭身の高さ、色々とでっかい点など表現して頂けますと一層嬉しいです。\n\nまた、お願いしたい差分の内容なのですが、彼女のお腹をどっしりとぽんぽんに膨らましてあげて頂けませんか？\n重く丸々と、大きければ大きいほど嬉しいです、ぜひAo2様の筆の乗るように手掛けて頂けますと大変嬉しいです。\n\nぜひご検討をお願い申し上げます。\n\nご参考(立ち絵)\nhttps://x.com/kuitirakasi/status/1489948727586717696\n\nご参考(三面図)\n\nhttps://x.com/kuitirakasi/status/1607377880086118400", "nc": 32, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@474ll474/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3029176, "client_id": 103982, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/0c0d7116/uploads/origins/30567b33-38c7-47ba-90ce-b195c965ed8a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5eb87718dfc9bc5b33f6862a0513f6f7", "srcset": "https://si.imgix.net/0c0d7116/uploads/origins/30567b33-38c7-47ba-90ce-b195c965ed8a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5eb87718dfc9bc5b33f6862a0513f6f7, https://si.imgix.net/0c0d7116/uploads/origins/30567b33-38c7-47ba-90ce-b195c965ed8a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=83395d8fe2b6366d1616934eb71aa714 2x, https://si.imgix.net/0c0d7116/uploads/origins/30567b33-38c7-47ba-90ce-b195c965ed8a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=eeaecff0dbebacb8f69bcc6efcad53b9 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/0c0d7116/uploads/origins/30567b33-38c7-47ba-90ce-b195c965ed8a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=265d9d2d4fbe71118b33494efe32dbac", "srcset": "https://si.imgix.net/0c0d7116/uploads/origins/30567b33-38c7-47ba-90ce-b195c965ed8a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=265d9d2d4fbe71118b33494efe32dbac, https://