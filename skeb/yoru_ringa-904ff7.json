ゃま\n\n魔王として孤独に生きてきたアルファルドと、長年使っていたトランプが人の姿となった従者フェスト。\nフェストは表では軽快で社交的、けれどアルファルドを想う心は深く強く、全てをかけて支え続けています。\n対してアルファルドは、フェストが人の姿として出会った頃は、感情をあまり表に出しませんが不器用ながらもフェストに心を開き、互いの存在を唯一無二のものとしている恋人同士です。\nシチュエーション等お任せします！\n\n主従であり、恋人関係でもある2人のお話が見たいです〜！！\n\n資料少ないかもですがURLを参考にしてください！\nもし資料不足、金額不足でしたら再送依頼を送っていただけると助かります！\n\nhttps://drive.google.com/drive/folders/1jbLM6Eh21ol9vzB8CvaT2e5BNMwFdSXS", "nc": 160, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@yoru_ringa/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1080736, "client_id": 638822, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/c08642e5/uploads/origins/2b7c4969-5699-4538-9ae0-06e42cbe0d8b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e478241e8767cb13763ef1d115fa0fd9", "srcset": "https://si.imgix.net/c08642e5/uploads/origins/2b7c4969-5699-4538-9ae0-06e42cbe0d8b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e478241e8767cb13763ef1d115fa0fd9, https://si.imgix.net/c08642e5/uploads/origins/2b7c4969-5699-4538-9ae0-06e42cbe0d8b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=48d1f3d679b6d0374c7c81c500af391f 2x, https://si.imgix.net/c08642e5/uploads/origins/2b7c4969-5699-4538-9ae0-06e42cbe0d8b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=3b55b68959bc086a1a74da00b7adcb27 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/c08642e5/uploads/origins/2b7c4969-5699-4538-9ae0-06e42cbe0d8b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=8879d4e77418b00b400816e219b0c096", "srcset": "https://si.imgix.net/c08642e5/uploads/origins/2b7c4969-5699-4538-9ae0-06e42cbe0d8b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=8879d4e77418b00b400816e219b0c096, https://si.im