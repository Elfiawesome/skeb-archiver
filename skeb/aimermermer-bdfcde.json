-96db-f09f2d3b547c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1202003e747fe70ecb1cd9cb4de066cf", "srcset": "https://si.imgix.net/d4a8e988/uploads/origins/5f8a409b-ad0c-40be-96db-f09f2d3b547c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1202003e747fe70ecb1cd9cb4de066cf, https://si.imgix.net/d4a8e988/uploads/origins/5f8a409b-ad0c-40be-96db-f09f2d3b547c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a94b62c32b70d8179794c934a52c4908 2x, https://si.imgix.net/d4a8e988/uploads/origins/5f8a409b-ad0c-40be-96db-f09f2d3b547c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=054c73de2d64766ebaad4dba06a29aee 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/d4a8e988/uploads/origins/5f8a409b-ad0c-40be-96db-f09f2d3b547c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d0e81132020766af4799d4287f6ac191", "srcset": "https://si.imgix.net/d4a8e988/uploads/origins/5f8a409b-ad0c-40be-96db-f09f2d3b547c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d0e81132020766af4799d4287f6ac191, https://si.imgix.net/d4a8e988/uploads/origins/5f8a409b-ad0c-40be-96db-f09f2d3b547c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=5233eee84e767a77ce1439c12006771c 2x, https://si.imgix.net/d4a8e988/uploads/origins/5f8a409b-ad0c-40be-96db-f09f2d3b547c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=e3190a9c2280899e0008f49efab32abb 3x"}, "body": "リクエスト失礼します。\n\nキャラクター：ゼノブレイド2よりミクマリ\n\n衣装：インナー姿（参考資料①のような形です）\nミクマリの衣装は、水色と紺色のインナーの上に長袖の白のアウターを羽織っている形になっています。\n胸部下や背面を見ていただけるとわかるのですが、紺色のインナーの上で交差してる紐で、アウターを固定しています。\nそこで、その紐で繋がれた白のアウターのみを脱いだ、インナー状態の姿を書いて頂きたいです。\n\n・上半身の服装\n詳しい形は参考資料を見て頂きたいのですが、文字に起こすとホルターネックで背中が開いており腰回りまでの服の丈でお臍がばっちり見えてるような形です。\n腰回りや胸部についた目玉状の装甲など、コアクリスタル周辺の造形を除いた硬そうなパーツは外してください。\n\n・下半身の服装\n参考資料②の方だと元の衣装の白いストッキングのようなものをほどいた形になっていますが、そこのみを省いて長めの紺色のスパッツのような形にしてください。\n脚の付け根にある水色の水風船のような部位は残したままで結構です。\nお尻のマリマリはスパッツに開いた隙間から生えてる形でお願いします。\n\n・エーテルラインについて\nエーテルラインは、目玉のような装甲の発光を覗き概ね体表に書き込んでもらえるとありがたいです。参考資料②とそのツリーに確認しやすい画像を載せておきます。\n\nポーズ：立ったまま腕を上げて背伸びをしているポーズ\n左脇が見える形で、後頭部のマリマリが腕に押されて変形している形でお願いします。\n\n表情：気持ちよさそうに伸びをしている表情（参考資料③のような表情）\n差分でカメラに気づく表情もあると嬉しいです。\nまた、眼帯無しバージョンの2つと、参考資料①のようにウィンクしてる表情も入れて頂けると幸いです。\n\n参考資料①：https://x.com/i/status/1536337650323697664\n参考資料②：https://x.com/i/status/2076267071785332907\n参考資料③：https://www.pixiv.net/artworks/87240513\n\n\n何卒よろしくお願い致します。", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@aimermermer/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3753575, "client_id": 3869697, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/04fa388b/uploads/origins/2ab7cb8a-e40b-49ce-87a5-9a989fca26a3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=740ff2f5cbe5630cf53e46eed6805a87", "srcset": "https://si.imgix.net/04fa388b/uploads/origins/2ab7cb8a-e40b-49ce-87a5-9a989fca26a3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=740ff2f5cbe5630cf53e46eed6805a87, https://si.imgix.net/04fa388b/uploads/origins/2ab7cb8a-e40b-49ce-87a5-9a989fca26a3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ea7b5a7503582a5661d533e44403b1bf 2x, https://si.imgix.net/04fa388b/uploads/origins/2ab7cb8a-e40b-49ce-87a5-9a989fca26a3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=fa854ca36e108a82d9fbfe47fd6102f5 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/04fa388b/uploads/origins/2ab7cb8a-e40b-49ce-87a5-9a989fca26a3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=40f9caaa97663d04fcb3b6f1132f94e