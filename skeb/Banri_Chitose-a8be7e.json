なお、アヘ顔系の表情はNGでお願いします！\n\n今回責めるのは乳首のみで、挿入されている描写などもNGでお願いします！\n\n以上、ご検討のほどよろしくお願いいたします！", "nc": 49, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Banri_Chitose/works/11", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/2b41a94d/uploads/origins/0fe62c3d-d820-4c14-b2a4-04b4784fea24?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=c53b8326544d9c107c87dae07d5e340a", "srcset": "https://si.imgix.net/2b41a94d/uploads/origins/0fe62c3d-d820-4c14-b2a4-04b4784fea24?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=c53b8326544d9c107c87dae07d5e340a, https://si.imgix.net/2b41a94d/uploads/origins/0fe62c3d-d820-4c14-b2a4-04b4784fea24?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=2dd64feff1e043ef2f39aa97e252d1cc 2x, https://si.imgix.net/2b41a94d/uploads/origins/0fe62c3d-d820-4c14-b2a4-04b4784fea24?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=f70a0b5568c8eb108417ccfea70fc331 3x"}, "private": true, "genre": "art", "tipped": true, "creator_id": 2054435, "client_id": 189976, "nc": 33}, {"path": "/@Banri_Chitose/works/10", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/625c71ec/uploads/origins/2c0288bb-9c84-4602-9d74-a39a1d35c469?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=94bb375cbbb1fa3be175f807315a2253", "srcset": "https://si.imgix.net/625c71ec/uploads/origins/2c0288bb-9c84-4602-9d74-a39a1d35c469?bg=%23fff&auto=form