てしまって、パンツが丸見えになっている。\n表情、目を広げて、顔を赤く染め驚き恥じらっている。\n\n絵２：差分（予算不足なら無し）\n構図：ポーズなどは１と一致。両手を広げたポーズ。\nスカートが捲れる前でパンツは見えない。\n春ですよ～とにこやかな笑顔で言ってるイメージ。\nズーム具合によってはスカートに隠れて足が見えなくて大丈夫です。\n\nURL先に、捲れた感じとパンツとニーソのイメージを稚拙ですが図形で表現しました。\n角の数とかリボンの角度とかこだわってるわけではなくて、何となくのイメージなのであなたの表現の仕方で描いて頂ければ大丈夫です。\n\n注文多く申し訳ないですが、よろしければお願いいたします。\n\nhttps://photos.app.goo.gl/H38my7ohVuooPyCZ8", "nc": 48, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Banri_Chitose/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2054435, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/03008c2c/uploads/origins/f8e8b9e7-c98f-414b-84e0-62d1c6f39487?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=940b39c27d6aa5f7ff3df0a9368ef348", "srcset": "https://si.imgix.net/03008c2c/uploads/origins/f8e8b9e7-c98f-414b-84e0-62d1c6f39487?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=940b39c27d6aa5f7ff3df0a9368ef348, https://si.imgix.net/03008c2c/uploads/origins/f8e8b9e7-c98f-414b-84e0-62d1c6f39487?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=29b0e342e333982708d2464eb30586dc 2x, https://si.imgix.net/03008c2c/uploads/origins/f8e8b9e7-c98f-414b-84e0-62d1c6f39487?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=1d152bd3fa47289c1a83d9b03e71c8c3 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/03008c2c/uploads/origins/f8e8b9e7-c98f-414b-84e0-62d1c6f39487?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=41ce72e112df87be86126b325e50630d", "srcset": "https://si.imgix.net/03008c2c/uploads/origins/f8e8b9e7-c98f-414b-84e0-62d1c6f39487?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=41ce72e112df87be86126b325e50630d, https://si.imgix.net/03008c2c/uploads/origins/f8e8b9e7-c9