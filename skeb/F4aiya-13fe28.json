543-7927d8dd0970?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=145c4926075b4dc3fa56a3c574d2621d, https://si.imgix.net/ae116934/uploads/origins/3ff254e2-4aa3-42fd-b543-7927d8dd0970?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=8e982d64dc4df406b341f8ba6cdf0118 2x, https://si.imgix.net/ae116934/uploads/origins/3ff254e2-4aa3-42fd-b543-7927d8dd0970?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=85ccb5259da8e227116b85ea7fae1926 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/ae116934/uploads/origins/3ff254e2-4aa3-42fd-b543-7927d8dd0970?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=7fcbce59cee780737da153ffdb907a9e", "srcset": "https://si.imgix.net/ae116934/uploads/origins/3ff254e2-4aa3-42fd-b543-7927d8dd0970?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=7fcbce59cee780737da153ffdb907a9e, https://si.imgix.net/ae116934/uploads/origins/3ff254e2-4aa3-42fd-b543-7927d8dd0970?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=3aa22cfebde5b50aab742f0e0c66a5a5 2x, https://si.imgix.net/ae116934/uploads/origins/3ff254e2-4aa3-42fd-b543-7927d8dd0970?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=975491984b6b750a77c83b2b7712156b 3x"}, "body": "またまたこんにちは！\nこんなに立て続けにお願いをすることになりますが、お気になさらないでください！\n手数料無料キャンペーンが終わる前にリクエストを送りたかったのです。遅かったらすみません！\n他のメインキャラの参考資料がまだ満足に描けていません。\nしかし、私のサイドキャラクターを一人描いていただきたいです！\n私のOC「クロイガー少佐」を描いてください。\n\n今回は急ぎのため、リクエストや資料が行き当たりばったりになってしまうかもしれません。\nまた、クロイガーの服装のファイルが壊れてしまったので、今回は服装の参考になる古い画像に限らせていただきます。申し訳ありません！\n\nクロイガーは、長袖、赤い腕章、腰に大きなベルト、腰から肩にかけて小さなベルト、複数のスリットが入った分割されたスカート、鎧のグリーブ／ブーツ、鋭い爪のついた大きな長方形のガントレットを備えたドレススタイルの軍服を着ている。\n\nトップとスカートのデザインは、画像にもっと忠実に解釈してください。\nhttps://imgur.com/a/WABrD0N\n\nありがとうございました。\n\nhttps://drive.google.com/drive/folders/1yAuzr6o83kWY