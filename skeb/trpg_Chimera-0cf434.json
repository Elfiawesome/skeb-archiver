踏み込んでるのは①のみ。 \n小食だが、甘い物が好き。   \n\n\n▮関係性 \nお互い刑事で相棒+友人以上恋人未満の関係。\n②の家に①が頻繁に泊まりに行っている。\n②が極度の方向音痴のため、①が手をひっぱって移動するのがデフォになりつつある。  \n\n\n以上となります。 \nお手数をおかけしますが、金額が低すぎて難しいという場合は再送依頼をいただければと思います。 \nお忙しいところ恐縮ですが、ご検討いただけますと嬉しいです。 \n何卒よろしくお願い致します。 \n\nまた最後にはなりましたが、最近寒暖差の激しい日々が続いておりますので、お身体にはご自愛くださいませ。\n\nhttps://drive.google.com/drive/folders/16Ebmfx0-zbJIKq_33erqbmfOjJA_SDvV?usp=sharing", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}], "sent_works": [], "similar_creators": [{"id": 1352031, "creator": true, "nsfw_acceptable": true, "acceptable": false, "name": "ぽたて", "screen_name": "plz_g_i_b", "avatar_url": "https://pbs.twimg.com/profile_images/1371101900330782722/16t6XhSs.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1355751603802828804/1663679976/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 90, "skills": [{"genre": "art"}], "nc": 176}, {"id": 2423617, "creator": true, "nsfw_acceptable": false, "acceptable": false, "name": "チドリ", "screen_name": "gg_suyari", "avatar_url": "https://pbs.twimg.com/profile_images/1833082943058939904/u3OCNPlQ.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1351535956952641537/1716525975/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 10, "complete_expiration_days": 60, "skills": [{"genre": "art"}], "nc": 128}, {"id": 2484923, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "街田", "screen_name": "machida_0906", "avatar_url": "https://pbs.twimg.com/profile_images/2008441213742182403/qA0RgCuF.jpg", "header_url": "https://pbs.twimg.com/profile_banners/936942193633247232/1759333662/1500x500", "appeal_receivable": true, "pop