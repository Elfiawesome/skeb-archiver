 true}, "discover": {"nsfw": true}, "american_express": {"nsfw": true}}}, "acceptable_only_public": false, "tip_acceptable": true, "yearly_report_client_visible": false, "total_appeals_count": 0, "received_works": [{"path": "/@mokotiger/works/9", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 37511, "client_id": 1388897, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/15dbe1ae/uploads/origins/4b8e1342-5016-4512-b921-5727537e3c20?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=524dfb18598f4cda4e4fc3179f47d656", "srcset": "https://si.imgix.net/15dbe1ae/uploads/origins/4b8e1342-5016-4512-b921-5727537e3c20?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=524dfb18598f4cda4e4fc3179f47d656, https://si.imgix.net/15dbe1ae/uploads/origins/4b8e1342-5016-4512-b921-5727537e3c20?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=5a32957813479ab43c45fe744224ea75 2x, https://si.imgix.net/15dbe1ae/uploads/origins/4b8e1342-5016-4512-b921-5727537e3c20?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d35e555738e81f55903a5aca75dd6065 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/15dbe1ae/uploads/origins/4b8e1342-5016-4512-b921-5727537e3c20?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f6b6d5fab9cfe418df84251d48e8e137", "srcset": "https://si.imgix.net/15dbe1ae/uploads/origins/4b8e1342-5016-4512-b921-5727537e3c20?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f6b6d5fab9cfe418df84251d48e8e137, https://si.imgix.net/15dbe1ae/uploads/origins/4b8e1342-5016-4512-b921-5727537e3c20?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=86989d0e661b4175611f1cb90b9733ea 2x, https://si.imgix.net/15dbe1ae/uploads/origins/4b8e1342-5016-4512-b921-5727537e3c20?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=9dd58389971d1e4ba36f711e5e3381df 3x"}, "body": "久しぶりに依頼します。\n今回もまた早苗でお願いします。\n\n内容\n前回私が依頼した全裸でプール掃除する早苗のその後で、掃除を終えた後でレイプされてしまった早苗の様子をお願いします。\n絵としましては前作の背景に見えていたフェンスにもたれかかるように座る早苗の図（掃除後なので出来れば裸足だと解る座り方と視点及びアングルで）\n既にレイプされた後で呼吸は荒く、全身精液まみれになっている状態です。\nここからはストーリー的な台詞と少々の差分になりますので問題なければ可能な限りお願いします。\nまた今更ですが設定として、\n『この日は授業半日で掃除は授業全て終えた後、生徒はほとんど帰宅してる』\nと言う状況でお願いします。\n\n・早苗を犯してスッキリした男子達と、散々犯されて疲れ果ててる早苗（表情は性的快楽と疲れが混じったような感じで）\n・掃除も終わったからと全裸の早苗を置き去りにさっさと帰る男子（制服はフェンスにかけて置いて行ってる）\n・自分も帰ろうとするも疲れてまだ動けそうにない早苗\n・そこに四つ目の依頼の女子グループがやってくる\n・偶然早苗の姿が見えたので見に来たと言う女子達に付着してる精液から無理矢理とは言えＳＥＸしてた事が知られる。\n・言い訳をしようとする早苗だが女子達は聞かず、精液まみれの早苗を汚いと言って洗おうと言い出す。\n・何をするつもりか解らない早苗に他の女子がホースを持ってきて早苗に放水する。\n・執拗に放水されて精液を洗い流された早苗だが更に体力を奪われてしまう。\n・追い打ちをかけるように女子達は「洗った後は干さないと」と言い何かを企み、早苗はそれを聞いてどんな目に遭うか不安を抱く。\n\nこんな感じで宜しければお願いします。", "nc": 56, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@mokotiger/works/8", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 37511, "client_id": 620865, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/a08bac37/uploads/origins/36a17ff2-a233-42b9-8091-90dd296267c2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7f1b84df3eaed5ce832be88bf5ba6a85", "srcset": "https://si.imgix.net/a08bac37/uploads/origins/36a17ff2-a233-42b9-8091-90dd296267c2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7f1b84df3eaed5ce832be88bf5ba6a85, https://si.imgix.net/a08bac37/uploads/origins/36a17ff2-a233-42b9-8091-90dd296267c2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=6a8d7590ed56981412a40ccd6911aab5 2x, https://si.imgix.net/a08bac37/uploads/origins/36a17ff2-a233-42b9-8091-90dd296267c2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=3f744b269369abbf52799a01cb2abb6f 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/a08bac37/uploads/origins/36a17ff2-a233-42b9-8091-90dd296267c2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3d3ca8e4cf14dee3fe16226547333f79", "srcset": "https://si.imgix.net/a08bac37/uploads/origins/36a17ff2-a233-42b9-8091-90dd296267c2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3d3ca8e4cf14dee3fe16226547333f79, https://si.imgix.net/a08bac37/uploads/origins/36a17ff2-a233-42b9-8091-90dd296267c2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=702ad4bba4bdaa55a2484989f0043d2d 2x, https://si.imgix.net/a08bac37/uploads/origins/36a17ff2-a233-42b9-8091-90dd296267c2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=c5951c0309f2abf508043ffd85f18b83 3x"}, "body": "女教師　風見幽香のイラストお願いします。\n教頭の命令で「https://www.pixiv.net/artworks/85984532」と同じ衣装を着て乳首が見える位胸元を開け、ミニスカートの両側にスリットを入れ裾を掴んでパタパタする様子を、生徒から不審な目で見られるシチュエーションお願いします。", "nc": 33, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@mokotiger/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 37511, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/da678f2e/uploads/origins/7a0ec3fd-2922-4f4a-9a1f-b2df7972cac3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3d0e91fa53d69a8b491b7a9a48a62380", "srcset": "https://si.imgix.net/da678f2e/uploads/origins/7a0ec3fd-2922-4f4a-9a1f-b2df7972cac3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3d0e91fa53d69a8b491b7a9a48a62380, https://si.imgix.net/da678f2e/uploads/origins/7a0ec3fd-2922-4f4a-9a1f-b2df7972cac3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=859d462f3964a407c4ffd64f403f1742 2x, https://si.imgix.net/da678f2e/uploads/origins/7a0ec3fd-2922-4f4a-9a1f-b2df7972cac3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=451156f199c7f2664a2d8cd06577ad80 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/da678f2e/uploads/origins/7a0ec3fd-2922-4f4a-9a1f-b2df7972cac3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f3f6020e54f00296f53c4502792ef259", "srcset": "https://si.imgix.net/da678f2e/uploads/origins/7a0ec3fd-2922-4f4a-9a1f-b2df7972cac3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f3f6020e54f00296f53c4502792ef259, https://si.imgix.net/da678f2e/uploads/origins/7a0ec3fd-2922-4f4a-9a1f-b2df7972cac3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=a3e4b9959d5df2dbf31d4573410b64fc 2x, https://si.imgix.net/da678f2e/uploads/origins/7a0ec3fd-2922-4f4a-9a1f-b2df7972cac3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=d9af013e20db3f96051d29e0e3547cfd 3x"}, "body": "こんにちは、お願いがあってリクエストを送ります。\n東方projectの 東風谷早苗が おしっこ我慢できないとパンツにちびる姿をお願いします。\n\n早苗の服装はこの服装でお願いします。-> https://ibb.co/g93GDhZ\nそして下着はこれでお願いします。https://ibb.co/VMDPdhZ\n複数枚差分ごとにパンツの状態が現れるといいですね,\nそして. 複数枚差分をお願いしたく、それぞれの希望差分を書かせて頂きます。\n\n1. お茶をたくさん飲んだのでちょっとした尿意を感じ始めた東風谷早苗, まだ我慢できるのか、もじもじしています\n\n2. 尿意が限界間近に迫り、大事なところをぎゅっと押さえ息を荒くしながら、がくがくと身体を震わせながら必死に我慢しています。\nこの時、少しずつ出してしまえば大丈夫だと思ってしまいます。\n\n3. ついに我慢しきれなくなったおしっこが、ショーツに少しずつ滲んでいきます。(服の表面にまではまだ濡れてない感じ）\n\n4. 少しよくなる感じで効果があると思うのか、ほっとした表情をします。\n\n5. またおしっこを少しずつ流します。 濡れた部分が少しずつ広がります。\n\n6. このとき、止められなかったのか水の流れが強くなってスカートや床も濡れていきます、思ったより強い幹に少し驚いた表情です。\n\n7. ついに気力が尽きてしまい、おもらしをしてしまいます。水の流れがとても強くて下着の前部と端がほとんど濡れてしまいます。\n\n8. おもらしが終わり, 恥ずかしさとともに解放感で興奮した感じもするようです。\n\n加えて、ちょっとしたセリフもあったらいいなと思います。 どんなセリフを入れるかはお任せします。\nよろしければお願いします。 お忙しいところありがとうございます！", "nc": 176, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@mokotiger/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 37511, "client_id": 1388897, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/97405102/uploads/origins/6a22d415-3db2-4596-ae69-754a3c0d9c64?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d7bde6c8080f6cf6920990b5016c5a03", "srcset": "https://si.imgix.net/97405102/uploads/origins/6a22d415-3db2-4596-ae69-754a3c0d9c64?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d7bde6c8080f6cf6920990b5016c5a03, https://si.imgix.net/97405102/uploads/origins/6a22d415-3db2-4596-ae69-754a3c0d9c64?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=87bc29ddbd8e71c2a6d94997cd551689 2x, https://si.imgix.net/97405102/uploads/origins/6a22d415-3db2-4596-ae69-754a3c0d9c64?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=42d7fa45c703f4ae6d9c3f1dfe4e9c99 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/97405102/uploads/origins/6a22d415-3db2-4596-ae69-754a3c0d9c64?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=399e11096051eca49fdba1a702a64eb8", "srcset": "https://si.imgix.net/97405102/uploads/origins/6a22d415-3db2-4596-ae69-754a3c0d9c64?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=399e11096051eca49fdba1a702a64eb8, https://si.imgix.net/97405102/uploads/origins/6a22d415-3db2-4596-ae69-754a3c0d9c64?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=d051cc64c072ec5fa8044870b6375c19 2x, https://si.imgix.net/97405102/uploads/origins/6a22d415-3db2-4596-ae69-754a3c0d9c64?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=f984787bbf8ce9dd1fc4a84624a935f7 3x"}, "body": "久しぶりに依頼します。\nいつも通り早苗でお願いします。\n\n差分無しの一枚絵のみでいいので、\n「全裸（今回はソックスも無し）でプール掃除をする早苗」\nをお願いしたいのですが、全裸にされた経緯を複数浮かんだので、どれか好きなの選んでお願いします。\n\n1、早苗以外男子（三回目の依頼した時に出た男子と同じ）でプール掃除してる最中、男子達がサボってたので掃除して欲しいと言った所、それが生意気だと言われて制服を脱がされてしまった早苗。\n「返してほしかったらそのまま掃除しろ」と言われて男子に見られながら一人で掃除する早苗。\n2、1と途中まで同じで、「早苗が裸になってくれたらやる」と半ば脅しに近い感じに言ってきたので仕方なく自分から脱いだ。\nただし男子は掃除するでなく裸の早苗をいやらしい目で眺めていた。\n3、早苗以外は四回目の依頼で出てきた女子達で、1の男子と女子を入れ換えた仕様。\n4、3の女子達の2に近い感じで、早苗の弱味（四回目の依頼での事）で脅してきて、バラされたく無かったら裸になって一人でやれと言われ、仕方なく自分から脱ぎ。\n女子達はそれを見て早苗がやはり露出好きだと嘲笑って眺めている仕様。\n\n絵の構図としては、早苗は全裸でデッキブラシを持ってプール床を擦ってる様子。\n周囲は上記の4案次第で男子か女子かになりますが、1と3なら早苗の制服を持ってる生徒もお願いします。\nカメラワークと言いますかアングルについてはお任せします。\nこんな感じで宜しければお願いします。", "nc": 168, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@mokotiger/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 37511, "client_id": 1388897, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/b374bad0/uploads/origins/17652f3d-9ee9-4279-a8c4-6e1383a1f0b0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3ef003b3921714f3ff7fd429d00bb342", "srcset": "https://si.imgix.net/b374bad0/uploads/origins/17652f3d-9ee9-4279-a8c4-6e1383a1f0b0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3ef003b3921714f3ff7fd429d00bb342, https://si.imgix.net/b374bad0/uploads/origins/17652f3d-9ee9-4279-a8c4-6e1383a1f0b0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=728060af33e8bff0e5f7ef3331020ea5 2x, https://si.imgix.net/b374bad0/uploads/origins/17652f3d-9ee9-4279-a8c4-6e1383a1f0b0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=dea9589fc2110d709553e715781a2c50 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/b374bad0/uploads/origins/17652f3d-9ee9-4279-a8c4-6e1383a1f0b0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=daf5ac721dc4671f72528ae11301a959", "srcset": "https://si.imgix.net/b374bad0/uploads/origins/17652f3d-9ee9-4279-a8c4-6e1383a1f0b0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=daf5ac721dc4671f72528ae11301a959, https://si.imgix.net/b374bad0/uploads/origins/17652f3d-9ee9-4279-a8c4-6e1383a1f0b0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=b6016d41c3dd3d9f979028d1e8a4c105 2x, https://si.imgix.net/b374bad0/uploads/origins/17652f3d-9ee9-4279-a8c4-6e1383a1f0b0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=956e725ad854da996a3a18e38ecf4923 3x"}, "body": "今月も依頼させて頂きます。\n\nキャラ：早苗、（台詞だけ文）\n内容\n前回の屋上置き去りのその後と言う設定で、宜しければ早苗の心情と文の心情それぞれを差分扱いでお願いします。\nあらすじ\n「全裸で置き去りにされた早苗の所へ来て助けた文だったが、お仕置きだと言って早苗に手錠をかけて連れ回す事に」\nと言う感じで、絵の構図としては\n「全裸のまま両手首にロープ付き手錠をかけられ、画面外から文に引っ張られている早苗。時間は夕方、場所は人通りのほとんどない路地等」\nでお願いします。\n\n早苗の心情は裸のまま連れ回されてる事に恥ずかしがってこの後何されるか不安な感じに。\n文の心情は前々回の男子生徒に弱みを握られた件と今回の事について少々怒っていて、「あなたは私のオモチャなのに」と言った感じの台詞をお願いしたいです。\nこんな感じで宜しければまたお願いします。", "nc": 49, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@mokotiger/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 37511, "client_id": 1388897, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/a6443681/uploads/origins/4cef4ddd-f7d6-4b81-a8ac-893586ba38c4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=498fe7237986514c19449f57fdd6697e", "srcset": "https://si.imgix.net/a6443681/uploads/origins/4cef4ddd-f7d6-4b81-a8ac-893586ba38c4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=498fe7237986514c19449f57fdd6697e, https://si.imgix.net/a6443681/uploads/origins/4cef4ddd-f7d6-4b81-a8ac-893586ba38c4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b50b6aba2dc4f196e9a09d61262b40ff 2x, https://si.imgix.net/a6443681/uploads/origins/4cef4ddd-f7d6-4b81-a8ac-893586ba38c4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=0d9212bfdef4678383682d6bcbf322c8 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/a6443681/uploads/origins/4cef4ddd-f7d6-4b81-a8ac-893586ba38c4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c3079cf3ceb1e473c9954a48058a3ec3", "srcset": "https://si.imgix.net/a6443681/uploads/origins/4cef4ddd-f7d6-4b81-a8ac-893586ba38c4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c3079cf3ceb1e473c9954a48058a3ec3, https://si.imgix.net/a6443681/uploads/origins/4cef4ddd-f7d6-4b81-a8ac-893586ba38c4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=1232fcc83b316897ecd67ad2a75b1ac1 2x, https://si.imgix.net/a6443681/uploads/origins/4cef4ddd-f7d6-4b81-a8ac-893586ba38c4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=de558ac8f4a0f6f4c971f79fcfa54b67 3x"}, "body": "また依頼します。\n今回はややイジメよりな内容になるので問題なければ。\nキャラ、早苗\n内容\nどこかの建物の非常階段（資料に載せたようなタイプで、出来れば階は上の方）に親しくない女子のグループに無理矢理連れて来られた早苗が裸にされる様子を、最初は制服を着た状態と差分で裸の状態の二種をお願いします。\n図としては早苗が非常階段の端に追い詰められて、女子グループに囲まれている（暴れないように腕を捕まれてたり、「ここから落とす」と脅している）感じで。\nストーリーは\n「最近男子が専ら早苗の話題ばかり（前回の依頼の事で、次はどう犯そうかと言う話だけど、女子達はその事を知らない）してるので、ムカついたからと呼び出されて、抵抗するも無理矢理脱がされてしまった早苗。」\nと言う感じです。\nまたラストに次回への布石としたいので、裸にした後で次はどうするかと言う話になり、一人の女子が「ここに縛って放置しよう」と提案する台詞を入れて欲しいです。\nそれ以外の抵抗してたり脱がされた後の早苗や女子グループの台詞や、女子グループを何人にするかはお任せします。\nこんな感じで宜しければ。\n\nhttps://search.yahoo.co.jp/image/search?p=%E9%9D%9E%E5%B8%B8%E9%9A%8E%E6%AE%B5&x=nl&aq=0&oq=%E3%81%B2%E3%81%98%E3%82%87%E3%81%86%E3%81%8B%E3%81%84%E3%81%A0%E3%82%93&ai=d066a880-f1b4-4200-b905-1a9ea36f103b&at=s&ts=11960&iau=1&ei=UTF-8&fr=top_smf#0cb6e582ae6", "nc": 168, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@mokotiger/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 37511, "client_id": 1388897, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/787b115e/uploads/origins/f40b47ec-e28f-407a-aa89-383414df8759?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ec57fde945bece75f5063517bb5a261f", "srcset": "https://si.imgix.net/787b115e/uploads/origins/f40b47ec-e28f-407a-aa89-383414df8759?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ec57fde945bece75f5063517bb5a261f, https://si.imgix.net/787b115e/uploads/origins/f40b47ec-e28f-407a-aa89-383414df8759?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=05fe63f12bb508d4ab636e0f94b026f6 2x, https://si.imgix.net/787b115e/uploads/origins/f40b47ec-e28f-407a-aa89-383414df8759?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=6517d3552dca7f464266bafe8216554c 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/787b115e/uploads/origins/f40b47ec-e28f-407a-aa89-383414df8759?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a553eac8fc20716b55082ec9a43e58bb", "srcset": "https://si.imgix.net/787b115e/uploads/origins/f40b47ec-e28f-407a-aa89-383414df8759?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a553eac8fc20716b55082ec9a43e58bb, https://si.imgix.net/787b115e/uploads/origins/f40b47ec-e28f-407a-aa89-383414df8759?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=b3f08ee340a3218c9b5d0ce096b40c64 2x, https://si.imgix.net/787b115e/uploads/origins/f40b47ec-e28f-407a-aa89-383414df8759?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=b2f0cf2f654aef09ef65b360553e9252 3x"}, "body": "また依頼させていただきます。\nキャラ　東風谷早苗\n内容\n「前回のハイエースレイプの後の全裸帰宅を男子グループに見られていて、放課後に校舎裏へ呼び出された早苗」\nと言う話をお願いしたいのですが。\n差分ではない全く別の絵を二種、この金額で問題なければＡを。\n厳しければＢでお願いします。\n\nＡ１\n地面に倒され服を脱がされてる早苗の絵で。\n前回の全裸帰宅を広められたくなかったらやらせろと迫られ、どうする事も出来ずに承諾した所、その場に倒され服を脱がされてしまうと言うストーリー。\nＡ２\n男子生徒達によるレイプ後、全裸でその場に座り込んでる早苗の絵で。\nレイプが終わったもののまだ脅しは継続していて、これから男子達に犯され続ける日々が始まった事に絶望する早苗と言うストーリー。\n\nＢ\n全裸でその場に座り込む早苗（こちらはレイプ寸前で出来れば胸を隠してるポーズを）と早苗を取り囲む男子生徒達の絵で。\nＡ１と同様に全裸帰宅を広められたくなかったらと脅され、無理矢理全裸にされてその場に座り込み、これからレイプされる事に怯えていると言うストーリー\n\nＡの方の細かなポーズ等は全てお任せしますし、\nＢも男子は全身映さずとも「取り囲んでる」ように見えればお任せします。\nまたそれぞれ、上記のストーリーが見る人に伝わる感じであれば、台詞差分無しの一枚ずつで大丈夫です。\n\n要望多くなりましたが、これで宜しければお願い致します。", "nc": 56, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@mokotiger/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 37511, "client_id": 1388897, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/e841e535/uploads/origins/b4a2a0a6-67be-4588-859d-e46ca018e01f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8d45271d74f1f125762494dce16846c9", "srcset": "https://si.imgix.net/e841e535/uploads/origins/b4a2a0a6-67be-4588-859d-e46ca018e01f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8d45271d74f1f125762494dce16846c9, https://si.imgix.net/e841e535/uploads/origins/b4a2a0a6-67be-4588-859d-e46ca018e01f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b909ac2f0f94446ee94d05380321a4d9 2x, https://si.imgix.net/e841e535/uploads/origins/b4a2a0a6-67be-4588-859d-e46ca018e01f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=576b90a7b286382964a858e167bd6750 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/e841e535/uploads/origins/b4a2a0a6-67be-4588-859d-e46ca018e01f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0abe23691461ef6872fb5c0ba308efd0", "srcset": "https://si.imgix.net/e841e535/uploads/origins/b4a2a0a6-67be-4588-859d-e46ca018e01f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0abe23691461ef6872fb5c0ba308efd0, htt