6/uploads/origins/f9dd474c-e74c-468a-968e-75ba11fa7c1f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=8290e44ad8f8287fd660c9f1550a595c 2x, https://si.imgix.net/790145b6/uploads/origins/f9dd474c-e74c-468a-968e-75ba11fa7c1f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=09722dd1b5102fbdccff265601dbef43 3x"}, "body": "初めまして。\n右払いさんのイラストに一目ぼれし依頼させていただきました！\n\nオリジナルキャラクターを書いていただきたいです。\n見本がなく文章のみになりますが、右払いさんの色使いが好きなので\n自由に書いていただきたいと思っています。\n\n完成品はSNSのアイコンとして使用させていただく予定です。\n\nーーー\n\n【概要】\n怠惰なメイド\n仕事をさぼって携帯をいじったりする性格です。\n\n【顔】\n少し垂れ目・眠そうな表情\n\n【ピアス】\n左耳\nヘリックス・輪っかが3連でついています\nピアスはシルバーです\n\n【髪】\n前髪ぱっつん\n鎖骨くらいの長さでハーフツイン\n面倒くさがりでいつも寝ぐせがついています。\n髪色は黒や紺のような暗め、襟足メッシュで赤を入れてほしいです。\n\n【髪飾り】\n￥マークのピンをしています。\n色・場所の指定は特にありません。\n\n【服】\nメイド服\nスカートは短め。\n\n【靴】\nヒールのないブーツ\n\n【構図】\nだるそうな姿勢\n全身書いていただきたいです。\n\nーーー\n\n初めての依頼のため不手際があれば申し訳ないです。。\n希望は記載していますが全体的に右払いさんの好みに描いていただければ嬉しいです！\n完成を心待ちにしています。よろしくお願いいたします！", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Migi_harai/works/8", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2824401, "client_id": 1624325, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/eb92e346/uploads/origins/89b2639c-c27d-447d-ab42-fd5fc480f895?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ecebe679ff41e4fdd8728fdae95240e2", "srcset": "https://si.imgix.net/eb92e346/uploads/origins/89b2639c-c27d-447d-ab42-fd5fc480f895?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ecebe679ff41e4fdd8728fdae95240e2, https://si.imgix.net/eb92e346/uploads/origins/89b2639c-c27d-447d-ab42-fd5fc480f895?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=5c9784a132340ffcff387f35244ea1e7 2x, https://si.imgix.net/eb92e346/uploads/origins/89b2639c-c27d-447d-ab42-fd5fc480f895?bg=%23fff&auto=format%2Ccompress&fm=web