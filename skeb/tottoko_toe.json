/1yPS23c7E6l3vKeeFNSltYlDIiOtXDf9r?usp=sharing", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@tottoko_toe/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3399488, "client_id": 1460138, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/cd9ae6a1/uploads/origins/b119e836-4c84-4a08-9961-a9a3a57bcb1e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1cbc41e66029e03092c795cb9256a890", "srcset": "https://si.imgix.net/cd9ae6a1/uploads/origins/b119e836-4c84-4a08-9961-a9a3a57bcb1e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1cbc41e66029e03092c795cb9256a890, https://si.imgix.net/cd9ae6a1/uploads/origins/b119e836-4c84-4a08-9961-a9a3a57bcb1e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=45522b6efcb78edc34b08451a4f7d6c2 2x, https://si.imgix.net/cd9ae6a1/uploads/origins/b119e836-4c84-4a08-9961-a9a3a57bcb1e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=7c81d9a78f50fb10a1c9ccadc16f8aa0 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/cd9ae6a1/uploads/origins/b119e836-4c84-4a08-9961-a9a3a57bcb1e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=aba3c0e10789dfa8ba33e2d8423267d3", "srcset": "https://si.imgix.net/cd9ae6a1/uploads/origins/b119e836-4c84-4a08-9961-a9a3a57bcb1e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=aba3c0e10789dfa8ba33e2d8423267d3, https://si.imgix.net/cd9ae6a1/uploads/origins/b119e836-4c84-4a08-9961-a9a3a57bcb1e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=29aac88c8d94cbd70509ea1dcfde8955 2x, https://si.imgix.net/cd9ae6a1/uploads/origins/b119e836-4c84-4a08-9961-a9a3a57bcb1e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=618c9f169ae84e8ab4df9429662e8377 3x"}, "body": "こんにちは、私はあなたの絵が大好きで、私の友人のOCの作品を依頼したいと思っています。彼女は眠そうでふわふわした狐の女の子で、甘いものが大好きなんだ。もし彼女が森の中で、たぶん木の下にいるのなら、私はそれが大好きです。近いうちにあなたの作品を拝見できることを楽しみにしています。\n\nhttps://drive.google.com/drive/folders/1JHulVUTRyPqR8U-coszxDNhfYE5Ganc9?usp=sharing\n\nhttps://drive.google.com/drive/folders/1JHulVUTRyPqR8U-coszxDNhfYE5Ganc9?usp=sharing", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@tottoko_toe/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3399488, "client_id": 2774851, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/5b75d2d0/uploads/origins/fd414620-ff8a-4e2f-a40f-6b2ae7446c75?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=579a4b163de12b10d8a8dda4dbe384e1", "srcset": "https://si.imgix.net/5b75d2d0/uploads/origins/fd414620-ff8a-4e2f-a40f-6b2ae7446c75?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=579a4b163de12b10d8a8dda4dbe384e1, https://si.imgix.net/5b75d2d0/uploads/origins/fd414620-ff8a-4e2f-a40f-6b2ae7446c75?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ed27b6509ae4cfdb182fc34dccfa8c90 2x, https://si.imgix.net/5b75d2d0/uploads/origins/fd414620-ff8a-4e2f-a40f-6b2ae7446c75?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=3f760d623bc5beb2d9ea752bf65c5c7f 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/5b75d2d0/uploads/origins/fd414620-ff8a-4e2f-a40f-6b2ae7446c75?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2bf16c350d011132d6766d52972124b3", "srcset": "https://si.imgix.net/5b75d2d0/uploads/origins/fd414620-ff8a-4e2f-a40f-6b2ae7446c75?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2bf16c350d011132d6766d52972124b3, https://si.imgix.net/5b75d2d0/uploads/origins/fd414620-ff8a-4e2f-a40f-6b2ae7446c75?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=da44b042ce26cf6ff4f2fc7ea1c02c7b 2x, https://si.imgix.net/5b75d2d0/uploads/origins/fd414620-ff8a-4e2f-a40f-6b2ae7446c75?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=821a1d064ce27ae158aab6a0d8be72e1 3x"}, "body": "はじめまして！Skeb内で拝見したイラストがとても好みだったので依頼させていただきました！\n\n今回依頼したいのは私の自作ゲーム『カツカツStudents!』の登場キャラである貴栴京香(きせん　きょうか)です。文芸部の擬人化的存在で、知的で少し気難しい感じの文学少女です。\n\n本に囲まれた、落ち着いた雰囲気のイラストをお願いします。具体的な内容やファイル形式などはお任せします。\n\n\nキャラクターの性格・バックグラウンドなど\n・物静かで落ち着いているが、こだわりが強く毒舌なところも\n・警戒心が強く、1人でいることが多い\n・知的で芯がある孤高の存在として後輩たちからは憧れられている\n・実年齢は100歳近く日々を退屈そうに過ごしているが、心の中では再び色鮮やかな世界を見せてくれる存在を待っている\n・昔は好奇心旺盛なおてんば少女だった\n\n\n以上です。ご検討のほどよろしくお願いします！\n\n資料(GoogleDriveに複数枚入ってます)\nhttps://drive.google.com/drive/folders/1Rnp6Qf_zmyDCYfRm_sEbvuAArmDguDfa?usp=drive_link", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@tottoko_toe/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3399488, "client_id": 2333635, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/acf3c79d/uploads/origins/f8e995a0-ce04-4a3f-9944-254c75113b16?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e8711503bec141551fecdb06cb292c17", "srcset": "https://si.imgix.net/acf3c79d/uploads/origins/f8e995a0-ce04-4a3f-9944-254c75113b16?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e8711503bec141551fecdb06cb292c17, https://si.imgix.net/acf3c79d/uploads/origins/f8e995a0-ce04-4a3f-9944-254c75113b16?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=eec9793bbaa071cd5c7d66745e237233 2x, https://si.imgix.net/acf3c79d/uploads/origins/f8e995a0-ce04-4a3f-9944-254c75113b16?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=1f967c4882b44e008181a7fa1b4f04fa 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/acf3c79d/uploads/origins/f8e995a0-ce04-4a3f-9944-254c75113b16?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5d7c9b3ec8184017416cb58a73c462d7", "srcset": "https://si.imgix.net/acf3c79d/uploads/origins/f8e995a0-ce04-4a3f-9944-254c75113b16?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5d7c9b3ec8184017416cb58a73c462d7, https://si.imgix.net/acf3c79d/uploads/origins/f8e995a0-ce04-4a3f-9944-254c75113b16?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=ab2a43cde0db85fb95b8d941f0650f1e 2x, https://si.imgix.net/acf3c79d/uploads/origins/f8e995a0-ce04-4a3f-9944-254c75113b16?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=2867c3554f61fe699c914af8209bdfd3 3x"}, "body": "トーエ様、こんにちは！前回描いていただいた素晴らしいイラストに感謝しています。とても気に入りました！今回は、別のOCのイラストをお願いしたいです。\n\n【キャラクター設定】彼女は、素直で明るい性格の冒険者です。遠くの小さな村で生まれ育ちました。\n【シチュエーション】彼女はコーヒーを飲むとき、カップのソーサーにコーヒーを注ぎ、そこから飲みます。周りの人々がなぜそうするのかと不思議がると、彼女も同じくらい驚きます。なぜなら、家族からそうするように教わっていたからです。\n【背景】シンプルなカフェ\n【服装】「服装.jpg」を参考にしてください。細部は自由に追加や修正していただいて構いません。\n【具体的なポーズや構図】シチュエーションの説明を基に描いていただければと思います。特に細かい要求はありません。\n\n【「コーヒーをソーサーに注いで飲む」ことについて】コーヒーがヨーロッパに伝わった当初、取っ手のないカップを使っており、コーヒーが熱すぎて飲みづらかったため、この方法で飲んでいたそうです。今ではこの方法は時代遅れで無作法とされ、限られた地域のご高齢の方々のみが行っています。参考資料：https://smithcorp.jp/coffee/2014/03/530/\n\nこのように複雑な依頼をして申し訳ありません。もし描いていただけたら本当に嬉しいです！\n依頼内容と金額が見合わない・その他不備などがあれば、お気軽に再送要請してください。 \nご検討いただき、ありがとうございます！\n\nhttps://drive.google.com/drive/folders/18muKPnNYVRIpOJ9gdrj0OL0wjDLLMgx2?usp=drive_link", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@tottoko_toe/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3399488, "client_id": 2333635, "vtt_url":