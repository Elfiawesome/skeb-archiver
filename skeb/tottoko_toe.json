g=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=7f8010597407875676789d0a85ecf1c3 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/1339468a/uploads/origins/30466d2b-0af6-4151-95cd-aabd2b394b9c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5e0a84d9b293d8800429eb9dcfca8e0a", "srcset": "https://si.imgix.net/1339468a/uploads/origins/30466d2b-0af6-4151-95cd-aabd2b394b9c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5e0a84d9b293d8800429eb9dcfca8e0a, https://si.imgix.net/1339468a/uploads/origins/30466d2b-0af6-4151-95cd-aabd2b394b9c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=09f8dd5f4a923a71d8556f060f34a8b4 2x, https://si.imgix.net/1339468a/uploads/origins/30466d2b-0af6-4151-95cd-aabd2b394b9c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=ada583c0c75546e72623d39edbbb942b 3x"}, "body": "トーエ様、はじめまして。\n素敵な世界観と色使いのイラストを拝見いたしまして、リクエストを受け付けていらっしゃるとのことで是非私のキャラクターを描いていただけないかと思いメッセージさせていただきました。\n描いていただきたいのは私がTRPGで作成したオリジナルキャラクターです。\n\nキャラクター設定\n・ギリシャ近辺をモチーフに取り入れた架空の国の王子\n・15歳前後、年の割に大人びてしっかりとした性格\n・剣術と演劇が好き\n\n用途\n・SNSのアイコンやヘッダーとしての使用\n\n資料に参考となる立ち絵を入れておりますが、衣装デザインなどは描きやすいように自由にアレンジしてください。\n背景の有無もお任せしますが、もし描かれる場合は屋内であれば玉座（ひとりっ子で現王は体が弱く、遠からず王位を継ぐことが定められています）、屋外であれば静かな森や明るい青空がイメージです。\n\nご検討いただけると幸いです、よろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/1CZb8y1xlTOL3-Qg0CavB5tRinyYhTTfg?usp=drive_link", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@tottoko_toe/works/8", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3399488, "client_id": 3719531, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/4789c018/uploads/origins/1c68b333-6a73-4ad3-8b71-4230bc0ad2fb?bg=%23fff&auto=format%2Ccompress&fm=webp&fi