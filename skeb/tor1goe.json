きめ美乳（ノーブラでもハリが凄いですhttps://skeb.jp/@one_emblem/works/40）\n・腹筋はうっすら割れてる\n・太ももはしっかりむっちり\n・「美人さん」というよりは「美少女」です!!\n・お酒も飲めますが、たまに年齢確認されちゃいます\n・個人的に「年齢感は下に、胸は大きめに」ブレる方が「ストライクゾーンが広い」ので、描くときに迷ったらそちら寄りでお願いします\n……超・個人的に過ぎるこだわりを、ここまで読んでいただいてありがとうございました。", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@tor1goe/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2730005, "client_id": 639858, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/f1caad1a/uploads/origins/c3d7ff29-af6a-4f45-b874-68f08c8e1f0c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=154d09d9df90e1b2b22eddb7c2ef11f7", "srcset": "https://si.imgix.net/f1caad1a/uploads/origins/c3d7ff29-af6a-4f45-b874-68f08c8e1f0c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=154d09d9df90e1b2b22eddb7c2ef11f7, https://si.imgix.net/f1caad1a/uploads/origins/c3d7ff29-af6a-4f45-b874-68f08c8e1f0c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=07b93582a48ca2d2ed4816e269304884 2x, https://si.imgix.net/f1caad1a/uploads/origins/c3d7ff29-af6a-4f45-b874-68f08c8e1f0c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=4dafba7b15f8ae694819ea66e50d04ef 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/f1caad1a/uploads/origins/c3d7ff29-af6a-4f45-b874-68f08c8e1f0c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=4a3b586a249d6e248cc0e1aa4e3840d2", "srcset": "https://si.imgix.net/f1caad1a/uploads/origins/c3d7ff29-af6a-4f45-b874-68f08c8e1f0c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=4a3b586a249d6e248cc0e1aa4e3840d2, https://si.imgix.net/f1caad1a/uploads/origins/c3d7ff29-af6a-4f45-b874-68f08c8e1f0c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=