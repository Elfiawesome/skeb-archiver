るアニメーションがすごく好きです！本当にカッコいい！\n\n私と友人のオリジナルキャラクター（OC）のイラストを依頼したいのですが！\n\nパルティメント [162 cm] とCXI [196 cm] は複雑な関係ですが、最終的にはいつも恋に落ちます！ロボットとして描いても、ダイバーとマーマンとして描いても構いません。どちらのバージョンが魅力的だと思うか、お任せします！\n\n不気味でロマンチックな雰囲気があれば嬉しいです。 構図は先生にお任せします！\n\n依頼料金が足りない場合は、アピールをお送りください。よろしくお願いします！！\n\nhttps://drive.google.com/drive/folders/13vqCTBECoCSWJ6Kc_Ex_5YfBQ2bivcIc", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@a_k2068/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3530599, "client_id": 3528869, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/5814fcea/uploads/origins/9299cb5a-4712-408b-b015-61238e264ee1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=18d4b0a1f89053d833349f557572691e", "srcset": "https://si.imgix.net/5814fcea/uploads/origins/9299cb5a-4712-408b-b015-61238e264ee1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=18d4b0a1f89053d833349f557572691e, https://si.imgix.net/5814fcea/uploads/origins/9299cb5a-4712-408b-b015-61238e264ee1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=9adafaf671f87a7e0a7835d8f7f849d3 2x, https://si.imgix.net/5814fcea/uploads/origins/9299cb5a-4712-408b-b015-61238e264ee1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=82cacf58ce53bf130d5a3cf80c27e3da 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/5814fcea/uploads/origins/9299cb5a-4712-408b-b015-61238e264ee1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=8efa1e22bf7ab6b0364f2f56580bc521", "srcset": "https://si.imgix.net/5814fcea/uploads/origins/9299cb5a-4712-408b-b015-61238e264ee1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=8efa1e22bf7ab6b0364f2f56580bc521, https://si.imgix.net/5814fcea/uploads/origins/9299