56348?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5707adf41f2e9b03e6984ff2a93fbe91, https://si.imgix.net/0623f1bb/uploads/origins/f0bee619-e0b6-42bf-84e1-3e06b3b56348?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=bf417d6f9c52cb5da4477710a135f38e 2x, https://si.imgix.net/0623f1bb/uploads/origins/f0bee619-e0b6-42bf-84e1-3e06b3b56348?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=6326b2defd7fefc753658c9ede53024a 3x"}, "body": "初めまして､vtuberの宿木サキと申します。\n餅暮いを様の可愛いSDキャライラストを拝見し是非､描いて頂けたらと思いリクエストさせて頂きました。\n\n〇希望内容\n·ミニキャラの自分の姿(全身)\n·構図や背景はお任せ致します。\n·可能でしたら背景が透過された人物のみのデータを頂けると嬉しいです!!\n\n〇使用用途\n·Youtube内の動画､配信(サムネイル等)\n·Xでのvtuber活動。\n·収益化を目指している為､将来的に収益化されたチャンネルでの使用になる可能性がありますが収益化以外の商用利用は致しません。\n\nご検討のほどよろしくお願い致します。\n\nhttps://x.com/ydrgi_sakigame/status/1867156422905229805?t=wMAduKcs_FrZMH6A-ut6YQ&s=19", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@yutta_5910/works/11", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 601194, "client_id": 3345781, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/1aa4a2f6/uploads/origins/6b9ace71-7950-4642-a964-4771bfd4a230?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b8a555e72887d31687a873b98a34928f", "srcset": "https://si.imgix.net/1aa4a2f6/uploads/origins/6b9ace71-7950-4642-a964-4771bfd4a230?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b8a555e72887d31687a873b98a34928f, https://si.imgix.net/1aa4a2f6/uploads/origins/6b9ace71-7950-4642-a964-4771bfd4a230?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=647250a9d2cf0d49903ec82db98a370e 2x, https://si.imgix.net/1aa4a2f6/uploads/origins/6b9ace71-7950-4642-a964-4771bfd4a230?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c956f1747c73c3206d648dfceefd5e9b 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/1aa4a2f6/uploads/origins/6b9ace71-7950-4642-a964-4771bfd4a230?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=dc78e17729d860481fbed903646bca3f", "srcset": "https://si.imgix.net/1aa4a2f6/uploads/origins/6b9ace71-7950-4642-a964-4771bfd4a230?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=dc78e17729d860481fbed903646bca3f, https://si.imgix.net/1aa4a2f6/uploads/origins/6b9ace71-7950-4642-a964-4771bfd4a230?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=42231c100d266f437ceb7335b32d4ac3 2x, https://si.imgix.net/1aa4a2f6/uploads/origins/6b9ace71-7950-4642-a964-4771bfd4a230?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=6d67a4aa553b47e8fea50223be40f14d 3x"}, "body": "はじめまして、リクエスト失礼します！\n\n甘楽ひな(@kanra_hina)をお祝いする企画で使用するSDイラストを描いていただきたいです！\n\n\n  ~使用用途~ \nフラスタに立てるパネル \nメッセージカード \nケーキ  \n\n\n2種類イラストを描いていただきたく、ポーズは片手、反対の片足を上げて歓迎してるような感じで、髪型は黒髪ツインテールでお願いしたいです。\n上げる手足の向きは別方向でお願いいたします。 \n服装は資料URLを参考にお願いします。\nご検討頂けますと幸いです。\n\n\nhttps://x.com/kanra_hina/status/1843993801423233161?s=53&t=kLH3yLaYIOloaj79gelJ7w\n\n\nhttps://x.com/kanra_hina/status/1714222218358775907?s=53&t=kLH3yLaYIOloaj79gelJ7w\n\nhttps://x.com/kanra_hina/status/1713932818139787458?s=53&t=kLH3yLaYIOloaj79gelJ7w", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@yutta_5910/works/10", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 601194, "client_id": 3456154, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/048bb881/uploads/origins/03521f89-c25a-4b5e-ae2a-c2d4fc8bad8e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c2faa4305ee2f5b16a658488f728c503", "srcset": "https://si.imgix.ne