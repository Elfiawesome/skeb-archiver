p=top&w=200&h=200&blur=200&s=8909da939a8b7fc48c823dea6cb595b2 3x"}, "body": "超特急すぎる納品、ありがとうございます……！\n本当に素敵で可愛らしかったので更にお願いさせて頂きたく……！\n\n小林さつたろうの男性バージョンのちみちゃい命をお願いいたします。\n具体的には添付させていただいているツイートの4枚目のいちばん治安が悪そうなビジュアルでお願いしたいです🙇‍♀️\n\n下半身は黒スキニーに黒い靴でお願い致します。\n\n治安の悪い感じでもおちゃめな感じでもギャルい感じでも問題ありませんのでお好きなように制作していただけたらと思います！\n迷われましたらギャルピースか指ハートで大丈夫です\n\nよろしくお願いいたします。\n\nhttps://x.com/satutaro_bayasi/status/1891275912169025813?s=46", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@yutta_5910/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 601194, "client_id": 841817, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/8fceee4e/uploads/origins/a490c4b7-4481-4512-9ea5-b22dafe8ee65?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ab17a0ef6f7cf13775e9b058f20c42ab", "srcset": "https://si.imgix.net/8fceee4e/uploads/origins/a490c4b7-4481-4512-9ea5-b22dafe8ee65?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ab17a0ef6f7cf13775e9b058f20c42ab, https://si.imgix.net/8fceee4e/uploads/origins/a490c4b7-4481-4512-9ea5-b22dafe8ee65?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=aedc28cdf2f607f11c33c1337f46a93d 2x, https://si.imgix.net/8fceee4e/uploads/origins/a490c4b7-4481-4512-9ea5-b22dafe8ee65?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c92cfa6017c0c37afca1b12d2ae0b8d8 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/8fceee4e/uploads/origins/a490c4b7-4481-4512-9ea5-b22dafe8ee65?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=49e5a2b9d23b41ddadbc637b5675299d", "srcset": "https://si.imgix.net/8fceee4e/uploads/origins/a490c4b7-4481-4512-9ea5-b22dafe8ee65?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=49e5a2b9d2