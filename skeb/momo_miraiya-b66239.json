51-8fac-1786e1ce9f98?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=0321d973541faf1997f17c2a6958f8a6 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/48f53c72/uploads/origins/52e8b705-8e44-4b51-8fac-1786e1ce9f98?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6b7144cf623f5f57fc3712415d6d33c4", "srcset": "https://si.imgix.net/48f53c72/uploads/origins/52e8b705-8e44-4b51-8fac-1786e1ce9f98?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6b7144cf623f5f57fc3712415d6d33c4, https://si.imgix.net/48f53c72/uploads/origins/52e8b705-8e44-4b51-8fac-1786e1ce9f98?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=ed498e40f005b9fcb1051bb3f74045f7 2x, https://si.imgix.net/48f53c72/uploads/origins/52e8b705-8e44-4b51-8fac-1786e1ce9f98?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=b677f34ccc5d19279f2c77732bee1b6a 3x"}, "body": "前回は素敵なイラストありがとうございました！\n今回はヘッダー用のイラストをお願いしたいと思い、リクエストさせていただきました。\n\nファイナルファンタジー14の自機のカイラ(女性キャラクターです)と、テイルズオブアライズのテュオハリム、遊戯王5D'sのブルーノの３名で夢絵をお願いします。\n\n衣装等の要望についてですが、カイラとテュオハリムにつきましては、以下のリンク先スレッドの衣装等を参考に描いていただけると嬉しいです。\nブルーノは、以前のリクエスト同様のビジュアル(髪型はアンチノミー、それ以外はブルーノ)でお願いします。\nなお、衣装等で細かすぎる部分は省略して頂いて大丈夫です。\n\n構図の要望ですが、左からブルーノ、カイラ、テュオハリムの順に並び、両側２人がカイラを抱き上げている、というような構図でお願いします。\nまた顔の距離は二人ともカイラに近めで、表情は全員楽しそうに笑っていると嬉しいです。\nイチャイチャしてるような、ほっこりするような雰囲気だとなお嬉しいです。\n構図につきましても、描きやすいように修正していただいて大丈夫です。\n\n要望が多くなってしまいましたが、お時間がある時等に受けていただけますと幸いです。\nぜひよろしくお願いします！\n\nカイラ　参考SS\nhttps://twitter.com/rioza187/status/1438788145550532610?s=20\n\nテュオハリム　参考SS\nhttps://twitter.com/rioza187/status/1438789501074100225?s=20", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@momo_miraiya/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 4043