umbnail_image_urls": {"src": "https://si.imgix.net/49359054/uploads/origins/f7bcd0f3-af65-4d07-a0e0-f5074cf83023?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=486fd9306ad21d2f36616d253d54d538", "src_set": ""}, "body": "skeb再開いただきありがとうございます！\ncedar様の描かれる太ももや鼠蹊部が柔らかそうでとても良かったのでリクエストをさせていただきました。\n\n東方Projectの蓬莱山輝夜の着衣スク水イラストをお願いしたいです。\n紺色旧スク水着用で股と太ももの間のスペースに日本酒を溜めているシーンをお願いします。(いわゆるワカメ酒)\n上のピンク色の服は、前開きにしてはだけさせた状態でお願いいたします。赤いスカートは脱ぎ去っているか、脱げかけの状態です。\nワカメ酒をする際に、正座か、腰掛けているか、脚を伸ばしているかは、お任せします。盃からこぼしている、一升瓶から注いでいる、といった細かなシチュについてもお任せします。素敵な鼠蹊部・恥丘・股布が強調されるようなアングル・ポーズでお願いしたいです。表情は少し恥ずかしげな笑みです。\n\n可能な範囲で以下の差分をお願いしたいです。\n・旧スク水は脱いでピンク色の服だけを羽織り、半裸になっている差分\n・ハート目あるいはぐるぐる目で、透明な酒の代わりに白濁した\"どぶろく\"を溜めている差分(スク水ver、半裸ver)\n\nご検討のほどよろしくお願い申し上げます。", "nc": 185, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@cedar_japonica/works/211", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/e8d7757f/uploads/origins/9dc31325-a78e-4c1c-9619-9664ab413b6b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=74f65490060ab5192437b47a51b12da2", "src_set": ""}, "private": true, "genre": "art", "tipped": false, "creator_id": 491599, "client_id": 0, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 32, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@cedar_japonica/works/210", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 491599, "client_id": 751755, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/a534b363/uploads/origins/73aa4644-1de7-4ea8-b68a-1bb5a1b45a86?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d81f86d7cd1baa929f119d43c57af003", "src_set": ""}, "duratio