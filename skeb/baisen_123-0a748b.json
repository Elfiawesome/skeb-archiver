わした茶色のたてがみと太い眉毛も特徴です。\n\nhttps://drive.google.com/drive/folders/1jbcEHfCj2yTtXBcPYA3mXNr24WxKU51g?usp=sharing", "nc": 49, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@baisen_123/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3673858, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/f6671cbe/uploads/origins/579a04b7-3ee5-473f-b39a-38fd53d2bf69?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b53e42c8468348336c73a248b96f4ee9", "srcset": "https://si.imgix.net/f6671cbe/uploads/origins/579a04b7-3ee5-473f-b39a-38fd53d2bf69?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b53e42c8468348336c73a248b96f4ee9, https://si.imgix.net/f6671cbe/uploads/origins/579a04b7-3ee5-473f-b39a-38fd53d2bf69?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c007a42fa817e0a891f3ba47330ba4ef 2x, https://si.imgix.net/f6671cbe/uploads/origins/579a04b7-3ee5-473f-b39a-38fd53d2bf69?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=8665e4118fdd84429004fe879cee7098 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/f6671cbe/uploads/origins/579a04b7-3ee5-473f-b39a-38fd53d2bf69?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=385978ce0002a85e0833b7fcd601dab3", "srcset": "https://si.imgix.net/f6671cbe/uploads/origins/579a04b7-3ee5-473f-b39a-38fd53d2bf69?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=385978ce0002a85e0833b7fcd601dab3, https://si.imgix.net/f6671cbe/uploads/origins/579a04b7-3ee5-473f-b39a-38fd53d2bf69?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=9a033b26db58dfa85836edf6bf7e3f7f 2x, https://si.imgix.net/f6671cbe/uploads/origins/579a04b7-3ee5-473f-b39a-38fd53d2bf69?bg=%23fff&auto=f