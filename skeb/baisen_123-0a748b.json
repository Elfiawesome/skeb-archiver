ございます。良い一日をお過ごしください！\n\nhttps://drive.google.com/drive/folders/1beGkSm05ouRV9Gc10mNhY6LZni6lsBxw?usp=sharing", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@baisen_123/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3673858, "client_id": 3478144, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/ef52c8b5/uploads/origins/abdbb9e7-018b-4468-81ff-9c6337bd4aeb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ee7715f1f47ea51e7bd87bf9d8591661", "srcset": "https://si.imgix.net/ef52c8b5/uploads/origins/abdbb9e7-018b-4468-81ff-9c6337bd4aeb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ee7715f1f47ea51e7bd87bf9d8591661, https://si.imgix.net/ef52c8b5/uploads/origins/abdbb9e7-018b-4468-81ff-9c6337bd4aeb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b0afc4bf711800ac375f50063fb95d50 2x, https://si.imgix.net/ef52c8b5/uploads/origins/abdbb9e7-018b-4468-81ff-9c6337bd4aeb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=8ab1f2d9819311f4f0f21838612075f4 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/ef52c8b5/uploads/origins/abdbb9e7-018b-4468-81ff-9c6337bd4aeb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=85b1e74249c275249f9f30e3b49e8c1c", "srcset": "https://si.imgix.net/ef52c8b5/uploads/origins/abdbb9e7-018b-4468-81ff-9c6337bd4aeb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=85b1e74249c275249f9f30e3b49e8c1c, https://si.imgix.net/ef52c8b5/uploads/origins/abdbb9e7-018b-4468-81ff-9c6337bd4aeb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=41774ed5d5c0beaa06c06805469622c9 2x, https://si.imgix.net/ef52c8b5/uploads/origins/abdbb9e7-018b-4468-81ff-9c6337bd4aeb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=6ddcb912850d910e12c94027ccac2e4b 3x"}, "body": "こんにちは！あなたの画風が本当に大好きです。キャラクターがとても魅力的で、衣装の描き込みも素晴らしいですね！\n\n私のキャラクターを描いていただけませんか？ \nテーマはお任せでも、ジムをテーマにしてもいいです！\nというのも、あなたのこの作品を見て、衣装がすごく素敵だったからです！（笑　私のキャラはよく半裸で、ジムで筋肉を誇示しているような感じかもしれませんが（笑））：\nhttps://x.com/baisen_123/status/2034249895016845395/\n\nでも、テーマや表情、衣装は自由に選んでください！\n\n私のキャラクターは、角のある筋肉質のライオンです（角の形はお好きなように描いてください）。トゲのある骨の尾、金色の模様、そして額に黒い十字があります。また、ふわふわした茶色のたてがみと太い眉毛も特徴です。\n\nhttps://drive.google.com/drive/folders/1jbcEHfCj2yTtXBcPYA3mXNr24WxKU51g?usp=sharing", "nc": 33, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@baisen_123/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3673858, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/f6671cbe/uploads/origins/579a04b7-3ee5-473f-b39a-38fd53d2bf69?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b53e42c8468348336c73a248b96f4ee9", "srcset": "https://si.imgix.net/f6671cbe/uploads/origins/579a04b7-3ee5-473f-b39a-38fd53d2bf69?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b53e42c8468348336c73a248b96f4ee9, https://si.imgix.net/f6671cbe/uploads/origins/579a04b7-3ee5-473f-b39a-38fd53d2bf69?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c007a42fa817e0a891f3ba47330ba4ef 2x, https://si.imgix.net/f6671cbe/uploads/origins/579a04b7-3ee5-473f-b39a-38fd53d2bf69?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=8665e4118fdd84429004fe879cee7098 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/f6671cbe/uploads/origins/579a04b7-3ee5-473f-b39a-38fd53d2bf69?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=385978ce0002a85e0833b7fcd601dab3", "srcset": "https://si.