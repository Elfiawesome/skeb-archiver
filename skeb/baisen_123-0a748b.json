=3&fit=crop&crop=top&w=200&h=200&s=4a21648426c46ca7bb9d7db5b0a69a5e 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/fec8cd5d/uploads/origins/6f459e72-6e40-46cf-b7b5-486a0cee1176?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c552577d5f805c72e31d3dc6eb65b9af", "srcset": "https://si.imgix.net/fec8cd5d/uploads/origins/6f459e72-6e40-46cf-b7b5-486a0cee1176?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c552577d5f805c72e31d3dc6eb65b9af, https://si.imgix.net/fec8cd5d/uploads/origins/6f459e72-6e40-46cf-b7b5-486a0cee1176?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=7d2ed8cd51c22b4fb4ea36f7e52fed59 2x, https://si.imgix.net/fec8cd5d/uploads/origins/6f459e72-6e40-46cf-b7b5-486a0cee1176?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=8aa2272768c95598904336bde06bb69a 3x"}, "body": "こんにちは、ばいせんさん！ ふとあなたの作品を見かけて、すごく素敵だと思いました！\n\n私のキャラクター、ジュール・ベラミーのカラーイラストをお願いしたいです。彼はベルギー出身のヨーロッパマツテンで、1970年代のレーシングドライバーです！ キャラクター情報は以下から確認できます：https://toyhou.se/30425569.jules-bellamy\n\n身長：約167.5cm\n\nイラストの雰囲気としては、ペンで個人的な日記に何かを書いているところを、まるでスナップ写真のように描いていただけると嬉しいです。表情は、物思いにふけっているか、決意に満ちたような感じにしてください。細かいディテールについては、ご自由にアレンジしていただければと思います！背景もレトロな1970年代風にしていただくと、さらに素敵だと思います！\n\n可能であれば、参考資料にある「Everyday Outfit」をモチーフにした服装のバージョンと、「Palmer Systems Racing Suit」のレーシングスーツを着たバージョンの2種類を作成していただけますか？\n\nご検討いただきありがとうございます。良い一日をお過ごしください！\n\nhttps://drive.google.com/drive/folders/1beGkSm05ouRV9Gc10mNhY6LZni6lsBxw?usp=sharing", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@baisen_123/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3673858, "client_id": 3478144, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/ef52c8b5/uploads/origins/abdbb9e7-018b-4468-81ff-9c6337b