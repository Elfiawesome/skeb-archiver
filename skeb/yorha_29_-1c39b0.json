f204/uploads/origins/ae349912-81dc-4073-8d92-627c2bdf0fb0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=62c177f0a674acf77a70ad0659b01e1c", "srcset": "https://si.imgix.net/8907f204/uploads/origins/ae349912-81dc-4073-8d92-627c2bdf0fb0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=62c177f0a674acf77a70ad0659b01e1c, https://si.imgix.net/8907f204/uploads/origins/ae349912-81dc-4073-8d92-627c2bdf0fb0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=9ef962806521899474f7b78fc70f7682 2x, https://si.imgix.net/8907f204/uploads/origins/ae349912-81dc-4073-8d92-627c2bdf0fb0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=8ddd45d48bad502fff7825fa68736095 3x"}, "body": "寄葉さん、はじめまして！あなたのイラストがとても好きです！もしよろしければ私のocの絵をお願いしたいです。\n戦争で両親を亡くし、生活のために麻薬の密輸に手を染めた。一見か弱そうな青年で、額、左肩、腕に火傷を負い、いつまでも冷たい表情を浮かべている。父のようなパイロットになるというかつての夢は、戦争とサバイバルの厳しい現実に直面するにつれて消えていった。生きていくためには手段を選ばないことを信条とする彼は、一度も命を奪ったことがなく、友情を深く大切にしている。彼が最も大切にしているものは、父親からもらったゴーグルである。\n考慮すべきシーン廃墟の中、空を飛ぶ戦闘機を見つめる／貧しい街を歩く／ビルの影で銃を拭く......。\nご自由にお描きください！ありがとうございました！\n\nhttps://drive.google.com/drive/folders/18j9H-Oy1KZxGbKbVlFICPsD7wSKHkUKn", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@yorha_29_/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3031680, "client_id": 1571955, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/048cd6d3/uploads/origins/99786bf7-f47f-4993-8964-22e437189422?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2d71ad8e8de5c5eb3b3dd9e9f508aa60", "srcset": "https://si.imgix.net/048cd6d3/uploads/origins/99786bf7-f47f-4993-8964-22e437189422?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2d71ad8e8de5c5eb3b3dd9e9f508aa60, https://si.imgix.net/048cd6d3/uploads/origins/99786bf7-f47f-4993-896