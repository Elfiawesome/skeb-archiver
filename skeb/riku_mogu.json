=38a8a1e89760a9462c1fb187e589c174", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/becc1115/uploads/origins/2fcb8eb2-18f9-4780-b3bc-b7fb4cf962d4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=422ae4b66bff924c1f3bf59af3262590", "src_set": ""}, "body": "新しい依頼です!お願いします!羊飼いテーマです~\nこの型を参考にして描きます\nhttps://drive.google.com/file/d/1s_cC-4W-T4CYeJJHIrs3MvAqo8C0RHVE/view?usp=sharing\n\n今回はちびキャラのみ描いていただきたいです。\n\n子羊を抱いて眠りながら数えている様子です\n\n花に水をやる少女です\n\n羊に埋もれていたのです\n\n災厄に取りつかれている様子です\n\n羊の上に座っている姿です\n\nお願いします~", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@riku_mogu/works/57", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3240676, "client_id": 3067291, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/df15ba19/uploads/origins/3ee9ae26-1864-4661-bcce-7db2486c4823?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=83ba88972a28fc9f1e7508cafb926878", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/df15ba19/uploads/origins/3ee9ae26-1864-4661-bcce-7db2486c4823?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=31ffada9266a508161c2215a4051db36", "src_set": ""}, "body": "招待状の内容は、キャラクターの衣装を3セット使って描いた新年のご挨拶シールと対句飾りです。あとは先生が自由にデザインしてくださいました。", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@riku_mogu/works/56", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3240676, "client_id": 3067291, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/a2ff685c/uploads/origins/b0eafaa3-1fc7-4c97-92a6-ec903e4d1ccb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1a9d3f481c2