25-43f4-8d91-5f6bbc4b92de?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=07fb6fcaa9c0decd0a00e344a074a86b", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/68697b1a/uploads/origins/30316e43-2525-43f4-8d91-5f6bbc4b92de?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=bed4ab664645df901a78a9f147ee1a4b", "src_set": ""}, "body": "お久しぶりです!新しい依頼です!\nこれは私の友達です!彼女はあなたの作品が大好きです!彼女のために新しい依頼を申し込みたいのですが\n\n屋外の小さい庭園のシーン、ティーパーティーのテーブルの上で誕生日のケーキといくつかの小さいデザート(マカロン、クッキーなど)と一緒にお祝いします。\n\n小さい切手なら欲しいですね。トランプの塔をビスケットでたたんでいる姿と、ケーキにクリームを絞っている姿。\nではお願いします!\n\n使用範囲:ファンへのプレゼントです。\n\nこれは彼女のイメージです：\nhttps://drive.google.com/file/d/1Z4a6JgidpCxzkw_jRk0tYE8vMXsmzQl3/view?usp=sharing", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@riku_mogu/works/46", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3240676, "client_id": 42956, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/889a961b/uploads/origins/762254ab-3202-4992-aa77-88f255ad631b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b55e536482ae51687d32c46d5237fb7d", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/889a961b/uploads/origins/762254ab-3202-4992-aa77-88f255ad631b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b8a4c98538925ff2e78fe0704648c3a9", "src_set": ""}, "body": "こんにちは！！！！！\n今回はうちの子のひとりであり、私の代理役になってくれたりもしてる『依代(ｲﾖ)』ちゃんの日常の景色をお願いしたいです！！✨🌺📱✨\n\nシチュエーションなのですが、\n・ひだまり町のコ達が写った写真を眺めて幸せそうに笑っている姿\n・傍らには紙パックのいちごミルクが置いてある\n\nこんな感じでお願いしますです！！\n\nそれと、もしよければちびちゃんで\n・幸ちゃんと並んでいちごのかき氷を持ってるおめめきらきらな依代ちゃん\n・誤爆した朱里ちゃんの炎で黒コゲになっちゃっておめめまんまるにしてる依代ちゃん\n\nというのも見てみたいですです…！！\n\n今回もなにとぞよろしくお願いしますですっ…！！！！\n\nhttps://x.com/usaki_otome/status/1845471167957913626?t=Bv3tItOhXxfKgcViUTnFgg&s=19", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@riku_mogu/works/45", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3240676, "client_id": 3067291, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/14b4780f/uploads/origins/31c774f6-9ac1-4f84-b761-513aaefd1b68?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6923d681b064dfc23b85e4f561721419", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/14b4780f/uploads/origins/31c774f6-9ac1-4f84-b761-513aaefd1b68?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=1375627b73578c6188641ed6e438fe26", "src_set": ""}, "body": "こんにちは、また私です。今回は、アリアに4ポケのエースカードをお願いしたいと思います。\n\n素晴らしいアートをありがとう！", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@riku_mogu/works/44", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3240676, "client_id": 3067291, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/9d3447e0/uploads/origins/05bbb3e9-0d4d-43cf-bb0a-3482c0b94765?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b0335af27de64bc8986bd7253ab278d7", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/9d3447e0/uploads/origins/05bbb3e9-0d4d-43cf-bb0a-3482c0b94765?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5f8ad41add20733ffcde78c754639314", "src_set": ""}, "body": "こんにちは。\n\n今日はアリアのチビを3体お願いします。スペードJ/Q/Kとしてポケカードに使う予定です。\n\nサイズは普通のポケと同じで、カードの周りに黒いボンダーをつけたいです。\n\n3枚のカードは、以前とは違う姿勢になることを願っています。\n\nhttps://drive.google.com/drive/folders/1QqJOw33vcEV2RpYnK2zRdzQ_jNVYiEin?usp=drive_link", "nc":