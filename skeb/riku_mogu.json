VA7I92K6388laCLOQ22vWbRdv?usp=sharing\n\n見えにくい箇所の省略、アレンジ等はしていただいて構いません。\n色々と注文はございますが、引き受けていただけそうなら再びお願いしたいです。\n\n金額が前より少ないので、金額に応じて構図を削っていただいても構いません。\n絵はフレンドさんにプレゼント予定です。\nご検討のほう、よろしくお願いします。", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@riku_mogu/works/41", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3240676, "client_id": 3067291, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/6a5491df/uploads/origins/bf6ab4d4-0f87-4663-8a42-88e9fa2e6203?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c751a6e2d13745485e05d066e54eb2e5", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/6a5491df/uploads/origins/bf6ab4d4-0f87-4663-8a42-88e9fa2e6203?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=556669082760173a8639f52efa739ed6", "src_set": ""}, "body": "こんにちは。\n\n今日はアリアのチビを3体お願いします。クラブJ/Q/Kとしてポケカードに使う予定です。\n\nサイズは普通のポケと同じで、カードの周りに黒いボンダーをつけたいです。\n\n3枚とも以前とは違うポーズで、新しい髪型にも注目してほしい。\n\nhttps://drive.google.com/drive/folders/1QqJOw33vcEV2RpYnK2zRdzQ_jNVYiEin?usp=drive_link", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@riku_mogu/works/40", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3240676, "client_id": 3067291, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/6119fae2/uploads/origins/a8f33753-8693-40ca-8a38-58a5b739e998?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=33dfa6451fbe703911ab8e4499ebe305", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/6119fae2/uploads/origins/a8f33753-8693-40ca-8a38-58a5b739e998?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=