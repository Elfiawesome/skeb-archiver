bc02feb4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=06dfdb5364d15b537af392777dc61862, https://si.imgix.net/7461a519/uploads/origins/fbd5ecb8-18f2-4a2b-aeab-c09abc02feb4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=ccf09f1a0f9b9a330e8144b09dbf1839 2x, https://si.imgix.net/7461a519/uploads/origins/fbd5ecb8-18f2-4a2b-aeab-c09abc02feb4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=7ed16aef02ce8d6c0b136eb05853e0ac 3x"}, "body": "やきたか様、はじめまして。\nやきたか様の描かれるキャラクターイラストの構成や世界観、全体的な質感などがとても素敵で、強く惹かれてしまいました。是非私のお気に入りのTRPGのOCをやきたか様に描いては頂けないでしょうか。\n\n《キャラクター設定》\n25歳女性のシカゴ生まれシカゴ育ちのアメリカ人です。元々はハッカーでしたが、現在ではFBIに所属し大切な仲間とともに事件捜査にあたっています。\n自己顕示欲が強く、自分を天才ハッカーと呼んで憚りません。気が強く言葉も強いが面倒見は良く、気分屋ではありますがおだてられれば大抵は機嫌は治すなど、扱いさえ分かれば親しみやすいタイプです。行動原理のルーツとして他人への奉仕に喜びを覚えるというものがあります。\n背が低いので、人に舐められないように黒い衣装を着がちですが、本来は色んな着こなしができるタイプの子です。\n目が弱いため、目を守るために遮光性の強いグラスを特に外出時には掛けています。\n\n《イラストについて》\n全体的には日陰ながらも、陰鬱さは無いさっぱりとした雰囲気のイメージです。日が部分的に差し込むイメージかもしれません。\n街角や路地裏など、ありきたりなアメリカの街（シカゴの中心から少し離れた住宅地のイメージ）の一角で、OCが壁に背をもたれていたり、リラックスしていたりする、なんてことのない穏やかな日常をカメラで切り取ったようなイラストがみたいです。\n遠景というよりは、家一軒程度の壁あるいは窓、塀といった何かが映るくらいの画角で、OCが画面に占める大きさも大きくは無いながらもしっかりと存在感があると良いです。写真集の1ページとしてカメラマンがフレームに収めたくなるような構図、と言えば良いでしょうか。\n風景や構図、季節、OCの服装のアレンジは全てお任せいたします。上記と全く異なっていても構いません。むしろ、服装についてはアレンジをいただけたらとても嬉しいです！\n\nhttps://drive.google.com/drive/folders/1c8H7fwrq5RBkSyTj0k3IBgq4pPiNSInX?usp=sharing", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Yakitaka_riza/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2731682, "client_id": 3428684, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/0eb24daa/uploads/origins/9e10da04-9346-4743-9715-51aff03d7604?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=63d31fd964172de3104807930a67559c", "srcset": "https://si.imgix.net/0eb24daa/uploads/origins/9e10da04-9346-4743-9715-51aff03d7604?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=63d31fd964172de3104807930a67559c, https://si.imgix.net/0eb24daa/uploads/origins/9e10da04-9346-4743-9715-51aff03d7604?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=2a13a43bedbe265097dd5155933d2fd3 2x, https://si.imgix.net/0eb24daa/uploads/origins/9e10da04-9346-4743-9715-51aff03d7604?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=6612f34c57b82b409b87b7ed34a2b1e0 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/0eb24daa/uploads/origins/9e10da04-9346-4743-9715-51aff03d7604?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=374137ca568d8bf1eeb2f0f22f2d8bbb", "srcset": "https://si.imgix.net/0eb24daa/uploads/origins/9e10da04-9346-4743-9715-51aff03d7604?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=374137ca568d8bf1eeb2f0f22f2d8bbb, https://si.imgix.net/0eb24daa/uploads/origins/9e10da04-9346-4743-9715-51aff03d7604?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=ec7e9305ee7ce2e0fe141a22107adff2 2x, https://si.imgix.net/0eb24daa/uploads/origins/9e10da04-9346-4743-9715-51aff03d7604?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=cc46e8f28978299aee8ac7047bbbc755 3x"}, "body": "こんにちは。やめとーく(X: @yametork)です。\n\nXとYoutubeのアイコン用のイラストをお願いしたいです。\n\n【内容】\n1人の少女が一輪の花を手に持って、こちらに向かって振り向いている。\n背景は草原で、澄んだ湖か川がある。\nその奥には切り立った山が並んでいて、雪がまだらに積もっている。\n昼間で、空は晴れている。全体としてアルプス山脈や北欧のイメージです。\n\n少女は16歳ぐらいで、髪は黒のロング、目は細めでお願いします。\n自分にファッションの知識がないので服装はお任せしたいですが、何か指定が必要ということでしたら白と黒のシンプルなセーラー服でお願いします。\n\n手に持っている花は、桃色で花弁が6枚あるものをお願いします。\nグラシデアの花のイメージです。\n\n全ての内容について、何か不都合がありましたら自由にアレンジしていただいても大丈夫です。\n\nどうぞよろしくお願いします。", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": tr