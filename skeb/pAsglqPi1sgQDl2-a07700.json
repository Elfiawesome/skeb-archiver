", "creator_acceptable_same_genre": false}, {"path": "/@pAsglqPi1sgQDl2/works/12", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 942138, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/3aa6fe20/uploads/origins/8b4323da-1ade-4ffc-a453-5b40606cc000?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ca85836efd195fba8c056d76314ff8de", "srcset": "https://si.imgix.net/3aa6fe20/uploads/origins/8b4323da-1ade-4ffc-a453-5b40606cc000?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ca85836efd195fba8c056d76314ff8de, https://si.imgix.net/3aa6fe20/uploads/origins/8b4323da-1ade-4ffc-a453-5b40606cc000?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=3267483f7ce2e0312c477275942ba0f5 2x, https://si.imgix.net/3aa6fe20/uploads/origins/8b4323da-1ade-4ffc-a453-5b40606cc000?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=5577dec25eec4241f22741e9ea1fbc6d 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/3aa6fe20/uploads/origins/8b4323da-1ade-4ffc-a453-5b40606cc000?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9ae02c2890f6fd13a4ee0ff1db409918", "srcset": "https://si.imgix.net/3aa6fe20/uploads/origins/8b4323da-1ade-4ffc-a453-5b40606cc000?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9ae02c2890f6fd13a4ee0ff1db409918, https://si.imgix.net/3aa6fe20/uploads/origins/8b4323da-1ade-4ffc-a453-5b40606cc000?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=cfb507e8212826e28041f19c5e321290 2x, https://si.imgix.net/3aa6fe20/uploads/origins/8b4323da-1ade-4ffc-a453-5b40606cc000?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=216c5da22c079c6cff97de3f86827684 3x"}, "body": "はじめまして。食脳で依頼させてください。\n\n①https://tetsudou-musume.net/contents/chara/chara.php?cid=PL07\n②https://tetsudou-musume.net/contents/chara/chara.php?cid=TM38\n\n①と②は職場の先輩後輩の関係です。\n①は後輩で先輩の②に憧れ、②のようになりたいと思って勉強中です。\nそんな中、①は食べ物で頭が良くなるという話を知り、②の頭を食べれば自分も先輩のように頭が良くなると考えて②の頭を開いて脳ミソを食するという絵をお願いします。\n②はまだギリギリ生きてますが全裸で椅子に拘束されて「やめて…」「何でもするから…」と命乞いしてます。\n\n宜しくお願いします。", "nc": 185, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@pAsglqPi1sgQDl2/works/11", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/2de07d70/uploads/origins/0aa79186-f2f4-4642-9ce5-c47c41c07b7f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=b3883529660f7611fa9d11f02d1ad474", "srcset": "https://si.imgix.net/2de07d70/uploads/origins/0aa79186-f2f4-4642-9ce5-c47c41c07b7f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=b3883529660f7611fa9d11f02d1ad474, https://si.imgix.net/2de07d70/uploads/origins/0aa79186-f2f4-4642-9ce5-c47c41c07b7f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=04ff3eed6024def290e054b442c54320 2x, https://si.imgix.net/2de07d70/uploads/origins/0aa79186-f2f4-4642-9ce5-c47c41c07b7f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=e9105f7b04d2f6cd04cf9adda4d523e2 3x"}, "private": true, "genre": "art", "tipped": false, "creator_id": 942138, "nc": 177}, {"path": "/@pAsglqPi1sgQDl2/works/10", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/26f7beac/uploads/origins/1ee3f9f1-b80c-44a8-b826-ace3fcc7c1d0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad