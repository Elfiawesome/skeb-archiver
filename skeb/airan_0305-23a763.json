しくは女の子座りで 全身が映るように描いていただきたく存じます。\nかわいく、あざとい女の子らしい雰囲気に仕上げていただけましたら幸いです。\n\n人物の全身絵と、キャラクタービジュアルをURLに添付いたしました。\nご縁がございましたら、何とぞよろしくお願い申し上げます。\n\nhttps://twitter.com/elika_oo/status/1534300137425469440?s=21", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@airan_0305/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1850837, "client_id": 79045, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/6cf9d8f8/uploads/origins/33df9d98-0d7a-469f-82b2-5684160c686e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=cba5a9849bf439b23529d5722e0e62eb", "srcset": "https://si.imgix.net/6cf9d8f8/uploads/origins/33df9d98-0d7a-469f-82b2-5684160c686e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=cba5a9849bf439b23529d5722e0e62eb, https://si.imgix.net/6cf9d8f8/uploads/origins/33df9d98-0d7a-469f-82b2-5684160c686e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=8326a9d7a5524d2f2c4bd97d0fc911e3 2x, https://si.imgix.net/6cf9d8f8/uploads/origins/33df9d98-0d7a-469f-82b2-5684160c686e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b34b1bf1d36df54c5519a719a6705fa6 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/6cf9d8f8/uploads/origins/33df9d98-0d7a-469f-82b2-5684160c686e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6f52651223b9722be85bbb52beac483b", "srcset": "https://si.imgix.net/6cf9d8f8/uploads/origins/33df9d98-0d7a-469f-82b2-5684160c686e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6f52651223b9722be85bbb52beac483b, https://si.imgix.net/6cf9d8f8/uploads/origins/33df9d98-0d7a-469f-82b2-5684160c686e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=9c02959a5cfd3bd2492783f72e