=top&w=200&h=200&s=1d3d99dad45f38f24c9b83350d6e1f3c 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/e811aca9/uploads/origins/e31307d1-7c83-4b29-99a7-a48785987799?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=31bd0f80e55ae8bae0a618395544de3c", "srcset": "https://si.imgix.net/e811aca9/uploads/origins/e31307d1-7c83-4b29-99a7-a48785987799?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=31bd0f80e55ae8bae0a618395544de3c, https://si.imgix.net/e811aca9/uploads/origins/e31307d1-7c83-4b29-99a7-a48785987799?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=a2c2ce976b4fd2549d8e0f905089b65c 2x, https://si.imgix.net/e811aca9/uploads/origins/e31307d1-7c83-4b29-99a7-a48785987799?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=92d70f9dc8a7c3e32e03567f61c051d5 3x"}, "body": "こんにちは。Loulis様のイラストが大変気になったのでリクエストさせていただきました。\n\n・キャラクター\n東雲絵名\n\n・衣装\nワンダーランズ×ショウタイムのデフォルトユニット衣装(鳳えむのPAST衣装)\nhttps://pjsekai.sega.jp/character/unite04/emu/index.html?year=past\n\n・表情\n頬を赤くせず恥ずかしくもなくドヤ顔。\n\n・構図\n構図は正面向きの全身絵でお願いします。(立ち絵のような構図)\n両足は地についた構図。\n髪型は変えないで髪飾り等もつけて欲しいです。\n胸はやや大きめで谷間が見える感じでお願いします。\n\n・シチュエーション\nえむの代役でえむの衣装を着こなしている様子。\n\nご検討よろしくお願いします。", "nc": 161, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Loulis0115/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2273500, "client_id": 3287778, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/484e2f3c/uploads/origins/8b39d7e8-df4a-49da-b990-6d34103bc801?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=47b3b655b092f8ba36a01537b2c1b059", "srcset": "https://si.imgix.net/484e2f3c/uploads/origins/8b39d7e8-df4a-49da-b990-6d34103bc801?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=47b3b655b092f8ba36a01537b2c1b059, https://si.imgix.net/484e2f3c/uploads/origins/8b39d7e8-df4a-49da-b990-6d34103bc801?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=0439738a93a7eb2703958d821b2e6a4f 2x, https://si.imgix.net/484e2f3c/uploads/origins/8b39d7e8-df4a-49da-b990-6d34103bc801?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d4e37203d2c703b66dc0f2a95e69f9f2 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/484e2f3c/uploads/origins/8b39d7e8-df4a-49da-b990-6d34103bc801?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=bde88467e63b3c4908f96afcf7f5fbac", "srcset": "https://si.imgix.net/484e2f3c/uploads/origins/8b39d7e8-df4a-49da-b990-6d34103bc801?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=bde88467e63b3c4908f96afcf7f5fbac, https://si.imgix.net/484e2f3c/uploads/origins/8b39d7e8-df4a-49da-b990-6d34103bc801?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=10013f3ae4d37a224714f0f84dbb473f 2x, https://si.imgix.net/484e2f3c/uploads/origins/8b39d7e8-df4a-49da-b990-6d34103bc801?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=f34f04131f0df18b7637128b9caa152e 3x"}, "body": "Loulis先生skeb依頼お願いします！\n今回もえななんをお願いしたいです\n内容としてはコミケ105本の温泉回に出てくるまふゆさんを前にそだてと言う絵名のイラストが面白かったのでそれを参考に考えてみました。\n\nシチュエーション（設定）\nコミケで売り子をすることになった絵名\n当日にコスプレ衣装を着て欲しいと言われて紙袋に入った衣装を受け取る\n衣装はニーゴのルカお姉さんの衣装\n衣装を着てみると、、、隙間が\n※衣装の胸元ががぶかぶかだった\n\nという感じで服の隙間を見ながら同じ感じで「そだて」の時のポーズお願いしたいです\n\nさらに後ろの方でニーゴのルカお姉さんがスマホから絵名を見てからかっているのもお願いしたいです\n\n•キャラクター\nメイン　東雲絵名\nサブ　誰もいないセカイの巡音ルカ\n\n•衣装\n絵名　ニーゴのルカ衣装\nルカ　おまかせ\n\n•ポーズ\n絵名　コミケ105（温泉）のそだて絵名の感じ\nルカ　プロセカ内スタンプ「おもしろそうね♪」のルカお姉さん\n\n•状況\n絵名　ニゴルカ衣装を着たら胸元に遊びがあった（イメージとしては貧乳キャラがバニー衣装着た感じを普通と大きいに置き換えた感じ）\nルカ　上記の絵名をスマホから覗いてからかっている\n\n•台詞\n絵名　おまかせ\nルカ　おまかせ\n\nという感じになります\nルカお姉さんに関してのキャラデザはお任せします（温泉絵名みたく簡易的でもSDキャラでもおまかせ。ニーゴルカがからかっているのが分かれば）\n\n\n結論\n【参考】そだて絵名　温泉回　byまふゆ\n↓\n【今回】そだて絵名　コスプレ回　byニゴルカ\n\nそだて絵名シリーズな感じです。\n上記達は自分の妄想なので\nそだて絵名シリーズになれば他はLoulis先生におまかせで大丈夫です。\nまた素敵なイラストを楽しみにしています\n御検討よろしくお願いします。\n\nhttps://x.com/loulis0115/status/1872918562282840365?s=46&t=PFPPRgZiwc6fyytFqFgm4Q", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Loulis0115/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2273500, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/463cd784/uploads/origins/00c2595d-f147-4b2c-8909-37f171103dea?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=201d1c8588303edb30ac9880250e85b2", "srcset": "https://si.imgix.net/463cd784/uploads/origins/00c2595d-f147-4b2c-8909-37f171103dea?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=201d1c8588303edb30ac9880250e85b2, https://si.imgix.net/463cd784/uploads/origins/00c2595d-f147-4b2c-8909-37f171103dea?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=8a98424224fd1038507eb205b45925e1 2x, https://si.imgix.net/463cd784/uploads/origins/00c2595d-f147-4b2c-8909-37f171103dea?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f2abfb275d996364e036567828af1c3c 3x"}, "duration": null, "nsfw": true, "hardcore": true, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/463cd784/uploads/origins/00c2595d-f147-4b2c-8909-37f171103dea?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e5548b50474d3e8033be79a5602cf3bc", "srcset": "https://si.imgix.net/463cd784/uploads/origins/00c2595d-f147-4b2c-8909-37f171103dea?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e5548b50474d3e8033be79a5602cf3bc, https://si.imgix.net/463cd784/uploads/origins/00c2595d-f147-4b2c-8909-37f171103dea?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=e5b2efbe593a5388b8af175e573dcd13 2x, https://si.imgix.net/463cd784/uploads/origins/00c2595d-f147-4b2c-8909-37f171103dea?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=441e7b15670bc3b14ed42145e466dd8a 3x"}, "body": "こんばんは\n氷沼悠理という子をお願いします\n元お嬢様で常時敬語、読書が趣味のおっとりとした子です\n華奢で胸はわずかにふくらみがある程度(AAカップ)\n乳首は淡い桃色で乳輪乳頭小さめ\n陰毛なし\n\n\n・服装等\nセーラーワンピースの上をはだけ胸露出(腕部分のみ脱がないイメージ、資料参照)\nスカート部そのまま\n膝下の黒ハイソックス(不要な情報ですが念のため)\n下着なし\n\n\n・シチュ等\n真正面(頭部の向きも正面)からの主観視点(表情変化あり)\n足を大きく広げ、膝から先が画面外になるくらいの距離感\n見つめ合いながら両手を恋人繋ぎ\n開いた膣口から愛液を溢れさせ処女膜が見えている状態で挿入待ち\n↓\n和姦正常位処女喪失(根元まで挿入して流血)\n↓\nピストン(白く泡立った愛液=本気汁が竿に絡みついている)\n↓\n根元まで押し込んで下半身を密着させ、子宮口に押し付けながら破瓜中出しと同時に絶頂\n腹部〜スカート→大量に中出しされた精液が溢れて細かく飛び散っている\n結合部及び周辺→破瓜の血・本気汁・精液\nお尻の下のスカート裏→血・本気汁・精液が混じり合いながら結合部から流れ落ちて溜まっている\n感じでお願いします\n(血・本気汁・精液をそれぞれオンオフ可能にして頂けると捗ります)\n表情は目を細めず、\n眉を八の字にせず、\n口を「あ」の形に大きく開いて舌は出さないトロトロで幸せそうなかわいい顔\n↓\n膣内射精後に引き抜かれ、血・本気汁・精液がべっとり絡みついたモノとアソコとでザーメンブリッジ、\n開いたままの膣口から血と本気汁混じりの精液が溢れて、お尻の下のスカート裏に溜まっている描写(モノが服や体に被らないと嬉しいです)\n↓\nその後も致して髪・顔・口内(舌)・服・ふとももなどもうかける場所がないくらい全身精液まみれな状態\n\n擬音や喘ぎ声もあると助かります\n喘ぎ声は基本的に「あ」を使用し、絶頂時は「あ、あ、あ、あぁぁぁぁぁぁぁぁっ!!」\n\nレイヤーは可能な限り細かく残し、いろいろなパターンが作れると大変捗ります\n\n修正は細い白線\n\n\n・背景\n自室想定で白いシーツのベッド上\n\n\n・男性\n同年代想定の特徴がない普通の男性(全裸)\n手と下半身程度\n\n\n何卒ご検討下さい。\n\nhttps://drive.google.com/drive/folders/1IwML5k39fvT-axqqDQd9sn5Ym7GOIG2q", "nc": 42, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Loulis0115/works/3", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/74246c5a/uploads/origins/fca944a5-1406-4761-8c24-969e124ea6e4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=ccb7718fb7ff6e5c7e73d599e34cbc91", "srcset": "https://si.imgix.net/74246c5a/uploads/origins/fca944a5-1406-4761-8c24-969e124ea6e4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad