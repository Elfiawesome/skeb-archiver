のデザインはお任せします\n\nそして、2枚目のイラストは立ち絵の参考に、とのことで1枚目の子に着せて欲しいです\n前のチャックは全開で、小物は全装着でお願いします！\n\nズボンに関してはスーツのズボンです\nシャツの袖と胴体部分の色が違うのは使用したピクルーの仕様なので実際は同じ色で白シャツです\n\nあと、親指にリングを嵌めてほしいです。\n\nあとはもうお好きにお願いします！\n刀が使えるということでこのHOを選んだので！本当に楽しく書いてもらえるとこちらも嬉しいです\n\nhttps://lit.link/harutrpgdayo", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@u0ygebi/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3086400, "client_id": 3173009, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/db985cd9/uploads/origins/5ee529cb-3fde-4971-aaee-412db5b31d48?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=14b1f53c8b17ada56f405556948f5f2b", "srcset": "https://si.imgix.net/db985cd9/uploads/origins/5ee529cb-3fde-4971-aaee-412db5b31d48?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=14b1f53c8b17ada56f405556948f5f2b, https://si.imgix.net/db985cd9/uploads/origins/5ee529cb-3fde-4971-aaee-412db5b31d48?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=dde8fbf3c9e67ba7ce033884c54cb9cc 2x, https://si.imgix.net/db985cd9/uploads/origins/5ee529cb-3fde-4971-aaee-412db5b31d48?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=4b2a5c73a670be2a02fc4ea969698277 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/db985cd9/uploads/origins/5ee529cb-3fde-4971-aaee-412db5b31d48?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=92fe0f568a9f3601603a56429b17510b", "srcset": "https://si.imgix.net/db985cd9/uploads/origins/5ee529cb-3fde-4971-aaee-412db5b31d48?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=92fe0f568a9f3601603a56429b17510b, https://si.imgix.net/db985cd9/uploads/origins/5ee529cb-3fde-4971-aaee-412db5b31d48?bg=%23fff&auto=format%2Ccompress&fm=webp&