！私のオリジナルキャラクター「天升（ティエンシェン）」のイラストを依頼したいのですが。彼は『原神』のリーユエ出身のオリジナルキャラクターで、コウモリの仙人です。彼の「神の目」は「風」です。\nデザインテーマは中国の「五福」です。戦闘時には、それぞれ異なる元素（雷、水、氷、火。ただし、風が彼のメインの元素です）を操る4体の分身を召喚することができます。\n彼は規律正しく武術に長けた戦士で、厳格で独善的な態度を持っています。責任感が強く、人間は弱い存在だと考えてはいますが、それでも人類を守らなければならないと感じています。真剣な表情や厳粛な表情が彼に最も似合うと思います！\n剣を持った姿やコウモリの姿で描く必要はありません。細部はご自由に描いてください。\n\n参考資料：https://imgur.com/a/UX2JCGG", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@suzumi_dog/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 4058242, "client_id": 2000315, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/d15b0524/uploads/origins/4a3c415a-b948-4d36-95c8-a13871d6c01f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8b7e9d53761f3a32182349b4881c9623", "srcset": "https://si.imgix.net/d15b0524/uploads/origins/4a3c415a-b948-4d36-95c8-a13871d6c01f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8b7e9d53761f3a32182349b4881c9623, https://si.imgix.net/d15b0524/uploads/origins/4a3c415a-b948-4d36-95c8-a13871d6c01f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a8c896d8c694844fae020b64c08fe290 2x, https://si.imgix.net/d15b0524/uploads/origins/4a3c415a-b948-4d36-95c8-a13871d6c01f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=caefb7438687a72c67a16b3aaac67018 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/d15b0524/uploads/origins/4a3c415a-b948-4d36-95c8-a13871d6c01f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=55c07f9574a736567edb9135135dc394", "srcset": "https://si.imgix.net/d15b0524/uploads/origins/4a3c415a-b948-4d36-95c8-a13871d6c01f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=55c07f9574a736567edb9135135dc394, https://si.imgix.net/d15b0524