eator_acceptable_same_genre": false}, {"path": "/@madaragi926/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 421832, "client_id": 8144, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/31e1597f/uploads/origins/2b48a354-6622-4c7f-b9e9-48c4321a127e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0ee5abf91924cff8b36585b2e13a0fdb", "srcset": "https://si.imgix.net/31e1597f/uploads/origins/2b48a354-6622-4c7f-b9e9-48c4321a127e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0ee5abf91924cff8b36585b2e13a0fdb, https://si.imgix.net/31e1597f/uploads/origins/2b48a354-6622-4c7f-b9e9-48c4321a127e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=92cf1de273e6eb6ffa241951820cfeea 2x, https://si.imgix.net/31e1597f/uploads/origins/2b48a354-6622-4c7f-b9e9-48c4321a127e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=22e6f9fab223fa30ed76795de1d6ccfd 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/31e1597f/uploads/origins/2b48a354-6622-4c7f-b9e9-48c4321a127e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=77360abedc74bae0725bfcc24bb0f5db", "srcset": "https://si.imgix.net/31e1597f/uploads/origins/2b48a354-6622-4c7f-b9e9-48c4321a127e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=77360abedc74bae0725bfcc24bb0f5db, https://si.imgix.net/31e1597f/uploads/origins/2b48a354-6622-4c7f-b9e9-48c4321a127e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=6e5eba8295ab7756d67d487011e1d4bd 2x, https://si.imgix.net/31e1597f/uploads/origins/2b48a354-6622-4c7f-b9e9-48c4321a127e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=ae51959e318b9a4199186586e23af595 3x"}, "body": "こんにちは！\n描かれている素敵なイラストに魅了されてしまったため、リクエストさせてください！！\nキャラクターはうちの子で、内容は完全におまかせいたします！！\nこの子にさせたいポーズだとか服装だとか自由にしてください！！\nオリジナルな服を着せていただいても良いです！！（例えば現代服などの、記載した世界設定の雰囲気から離れたものであっても大歓迎です！！）\n\n●キャラクター設定\nバイコーンとユニコーンの血が混じったややこしい血筋の娘。\n純潔を司るユニコーンと不純を司るバイコーン両方の血が入った結果、純潔も不純も感知できない普通の女の子になった。\nそんなことは関係なく、家族に大事な娘・妹として可愛がられて育てられた。\n最近、お里から都会に進学してきた。\n\n《幻獣の隠れ里（ド田舎）》から進学のために出てきた《高貴なる幻獣の血を引きし存在（田舎もん）》。\n\n本人は「幻獣の血筋なんだから里の威厳を守らないと！」と思っている。\n中身は、ほわほわなおこちゃまなので、色気のある何かをみただけで「不純！」って言いがち。\n周囲の人に可愛がられて、いじわるされがち。\n\n「～だなっ！　～ぞっ！」みたいな断定の言葉だと強くて威厳がありそうって思ってる。\n実際の発言は\n「次は外で魔術の授業だなっ！　早めに着替える必要があるぞっ！」\n「今日はクレープがお得な日だぞっ！　私は前回悩んで辞めたイチゴチョコにしようかなぁ」\nみたいな。\n作ってる口調なので、すぐボロが出て普通の話し方になる。\n「ええっ、一口食べたいの？　あ、食べたいの……だな！　し、仕方ない、わ、分けて、やろう！」（しょんぼり）\n\n作っていない素の口調は「～だよね？　～かな？　～だよ」の普通な少女。\n\n頭に生えている角は、それぞれの血によるもの。\nバイコーンの角はねじれて伸び、生活するうえで邪魔くさいので切り、断面そのままだとかっこ悪いので整えた。\n（魔力を帯びた特別な琥珀をイメージ）\n身長は角を除いて142cm。\n\nhttps://www.dropbox.com/home/Pictures/%E3%83%9A%E3%83%AB%E3%83%AB/bcc_ref", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@madaragi926/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 421832, "client_id": 169953, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/c4661b6a/uploads/origins/ed0eb3a4-1215-4ac2-98d8-9b40f5de4c3e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=580beed1d69b60071e3364656f6ad6db", "srcset": "https://si.imgix.net/c4661b6a/uploads/origins/ed0eb3a4-1215-4ac2-98d8-9b40f5de4c3e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=580beed1d69b60071e3364656f6ad6db, https://si.imgix.net/c4661b6a/uploads/origins/ed0eb3a4-1215-4ac2-98d8-9b40f5de4c3e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=eb7cfbe982920bde66984a6b4bc6c6e4 2x, https://si.imgix.net/c4661b6a/uploads/origins/ed0eb3a4-1215-4ac2-98d8-9b40f5de4c3e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e8835149436002aa2557d8a