ーションやメッシュを加えていただきたいです。\n・左目の下に「126」という数字のステッカーを付けてください。\n・全体の印象は、少しボーイッシュなギャルをイメージしています。\n・表情とポーズは先生にお任せいです、ちょいやんちゃなギャルって感じでいい～\n\n【用途】\nX（旧Twitter）のアイコン、画像、YouTubeチャンネルのサムネイル、配信中に使用するイラストとして利用させていただきたいと考えております。\n\nもし可能でしたら、人物と背景が分かれたPSDファイル、または人物のみの透過PNGファイルをご提供いただけますと大変ありがたいです。\n\nお忙しいところ恐れ入りますが、ご確認のほど何卒よろしくお願い申し上げます。\nもしご依頼内容に対して金額が合わない場合は再送要請・キャンセル対応等いただいて構いませんので、ご検討いただけますと幸いです\n\nhttps://drive.google.com/file/d/1-tntsABIx-WprdLtxONG-Z8lFnID4MKo/view?usp=drive_link", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@3hatiti/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3404498, "client_id": 3645356, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/dce8b7fb/uploads/origins/dd114a66-b36c-456c-ae77-6e2a040b6844?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f08f459771b256b75d32a92fb28abc73", "srcset": "https://si.imgix.net/dce8b7fb/uploads/origins/dd114a66-b36c-456c-ae77-6e2a040b6844?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f08f459771b256b75d32a92fb28abc73, https://si.imgix.net/dce8b7fb/uploads/origins/dd114a66-b36c-456c-ae77-6e2a040b6844?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=26aa77a6898edb68461dad6a81f1bca2 2x, https://si.imgix.net/dce8b7fb/uploads/origins/dd114a66-b36c-456c-ae77-6e2a040b6844?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=89ca196ae684c3c63b0802f7fae02ba0 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/dce8b7fb/uploads/origins/dd114a66-b36c-456c-ae77-6e2a040b6844?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6777e3532b4f6d6fb59427d42bbd7efb", "srcset": "https://si.imgix.net/dce8b7fb/uploads/origins/dd114a66-b36c-456c-ae77-6e2a040b6844?bg=%23fff&auto=format%2Ccompress&fm=webp