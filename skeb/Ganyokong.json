7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2617466b04f0a5648eec1be9e9bcccb0", "srcset": "https://si.imgix.net/ad91e223/uploads/origins/f5f04f77-e724-4801-ad33-b37723702297?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2617466b04f0a5648eec1be9e9bcccb0, https://si.imgix.net/ad91e223/uploads/origins/f5f04f77-e724-4801-ad33-b37723702297?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=c55dd80f4a843d542306de108aa64428 2x, https://si.imgix.net/ad91e223/uploads/origins/f5f04f77-e724-4801-ad33-b37723702297?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=56c90def6ab6debfdb5d09508e3d8fb1 3x"}, "body": "Skebやpixivでお描きになった作品のぽっかりアナルが大変に好みであったためNSFWなイラストをお願いしたくリクエスト差し上げました。\n\n以下、リクエスト内容です。\n\nキャラクター\nアイドル○スターシンデレ○ガールズ/櫻○桃華\n\n概要\n\"芸能界の闇”に堕ちきって枕営業慣れするどころか、悪いスポンサーに調教されてマゾ奴隷として仕上がってしまった桃華が自分の拳よりも大きなアナルプラグを飲み込んだ調教済みアナルを見せつけているところ+可能ならアナルプラグを引き抜いてぬらぬらとしたぽっかりアナルを見せつけている差分\n\n状態\n・表向きはアイドルを続けながら、超大物スポンサーを”ご主人様”として、マゾメス奴隷に堕ちきっている\n・全身調教済み\n・乳首、クリトリスも調教で肥大化。リングピアスを付けられている\n・特にアナル拡張済み。もはやアナルプラグ無しには日常生活を送れない\n・自分の身体の取り返しのつかなさには自覚的で、それ自体に甘美な快楽を感じてしまうほどのマゾ\n\n衣装：赤の猫耳ボンデージ衣装\n・つけ猫耳\n・赤いボンデージ衣装\n→首輪、長手袋、ボディーハーネス、ハイサイブーツ（ピンヒール）、その他ベルトパーツ等\n・アナルプラグに猫尻尾\n\n構図、ポージング等\n・詳細お任せで、限界拡張されたアナルを思う存分見せつけるようなポージング・構図をお願いしたく\n\n以上です。\n欲望全部乗せみたいなリクになってしまっておりますが、可能な範囲でご検討いただければ幸いです。", "nc": 168, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Ganyokong/works/5", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/c78b25fe/uploads/origins/59902a26-d0f6-4be8-84a7-50e9a64c0ad5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=d0274384158282711f167499cd55bd96", "srcset": "https://si.imgix.net/c78b25fe/uploads/origins/59902a26-d0f6-4be8-84a7-50e9a64c0ad5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=d0274384158282711f167499cd55bd96, https://si.imgix.net/c78b25fe/uploads/origins/59902a26-d0f6-4be8-84a7-50e9a64c0ad5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=a1adcda4e518ef3d93c55c571bbbad61 2x, https://si.imgix.net/c78b25fe/uploads/origins/59902a26-d0f6-4be8-84a7-50e9a64c0ad5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=1862b466f2e4a8d64206b8b250a0171b 3x"}, "private": true, "genre": "art", "tipped": true, "creator_id": 3724027, "client_id": 3596463, "nc": 32}, {"path": "/@Ganyokong/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3724027, "client_id": 82839, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/d1593515/uploads/origins/d4ab1b3d-476d-463c-b3a0-6bb845eaa8d2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2567f061df8cc404505be84b79e541a4", "srcset": "https://si.imgix.net/d1593515/uploads/origins/d4ab1b3d-476d-463c-b3a0-6bb845eaa8d2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2567f061df8cc404505be84b79e541a4, https://si.imgix.net/d1593515/uploads/origins/d4ab1b3d-476d-463c-b3a0-6bb845eaa8d2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=887e9a03595ce8b614679500ec640f40 2x, https://si.imgix.net/d1593515/uploads/origins/d4ab1b3d-476d-463c-b3a0-6bb845eaa8d2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a7106849c742420d7dee99c1e1e2cfce 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/d1593515/uploads/origins/d4ab1b3d-476d-463c-b3a0-6bb845eaa8d2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c7ae2688da598123d4872c6d7eb2890e", "srcset": "https://si.imgix.net/d1593515/uploads/origins/d4ab1b3d-476d-463c-b3a0-6bb845eaa8d2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c7ae2688da598123d4872c6d7eb2890e, https://si.imgix.net/d1593515/uploads/origins/d4ab1b3d-476d-463c-b3a0-6bb845eaa8d2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=53e67824e064e3e1fca0f3ef118f0358 2x, https://si.imgix.net/d1593515/uploads/origins/d4ab1b3d-476d-463c-b3a0-6bb845eaa8d2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=85a348cf84a90f562c99f106d4083b5c 3x"}, "body": "がにょこ様、前回のリクエストでは大変お世話になりました。\nがにょこ様の描かれる性癖と見事に合致いたしまして、この度もリクエストさせていただきました。\n以下リクエスト内容です。\n\nキャラクター：橘　ノゾミ(ブルーアーカイブ)\n　　　　　　　橘　ヒカリ(ブルーアーカイブ)\n\nコスチューム：\n通常立絵のコスチュームを下記のように改変したもの\n・ノーブラノーパン、リュック類無し\n・トップスの丈は胸より上までで胸丸出し(ボレロパーカーのようなイメージ)\n　質感はピッチリ艶テカ質感へ変更\n・手袋とタイツはピッチリ艶テカ透明シースルー素材へ変更\n・ブーツも艶テカ質感に変更し、靴底を厚底高背ピンヒール形状に変更(参考：https://item.rakuten.co.jp/sadisticaction/s0000000000000000000000000001745/ )\n・乳首ピアス装着\n\nシチュエーション：\n先生によるおしおきアナルぶっ壊し調教\n\n・コチラに尻と前穴が見えるように尻を向けながら両手で広げつつ、上半身は胸が見えるようにしっかり振り返っているポーズ\n　リンク内画像の下列中央の写真のポーズ参考(https://x.com/143xxxerika/status/1976094290083488179?s=46&t=HLREpzYaC7QiLr5yd12ZQg )\n　ヒカリとノゾミに対照にポーズをとらせ、振り返った上半身の間には乳首ピアスをチェーンで連結してピンッと張り、お互いの乳首と乳房が引っ張り合いギッチギチに伸びた状態\n　全身絵でお願いします。\n\n上記ベースに下記差分と表情変化をお願いします。\n最初は舐め腐った態度から、余裕を崩さないように努めつつも徐々に余裕がなくなって行き、終盤は泣き叫んで許しを請うも無慈悲にアナルをぶっ壊されるイメージでお願いします。(身動き取れないのは大人のカードあたりの万能グッズで対応)\n\n・尻と透明タイツの間にホースを滑り込ませアナルに挿入 → 大量半固形ゼリー浣腸\n・タイツ内にゼリー脱糞\n・タイツ股間部のみをくり抜いた状態で再び大量半固形ゼリー浣腸とゼリー脱糞\n・アナルと前穴をそれぞれファックと中出し\n・2人同時にアナルフィストファック(拳をあてがうところから挿入開始〜途中〜強烈ピストン〜肘まで挿入)\n・アナルバルーン挿入〜徐々に膨張〜骨盤の限界まで膨張+腹圧に押し出された膣や子宮が前穴から覗く状態\n・限界膨張したアナルバルーンを無理やり引っ張り、凄まじい勢いで抜ける様子\n・奥まで丸見え超ポッカリアナル状態\n・盛大に脱肛\n・脱肛部をアナル吸引機で更に引き摺り出し\n・脱肛から尻尾のように引き摺り出された腸へ芯となる極太双頭ロングディルドを捩じ込み、脱肛アナルが戻らないように脱肛アナル根本と腸先端付近をディルドにゴムバンドで締め付け脱肛アナル擬似チ○ポに仕上げられていく様子 ・(参考：https://skeb.jp/@oji_dokozono/works/59 )\n　擬似チンポ完成後に無理やり笑顔を強制され、泣きながら引き攣った笑みの表情もお願いします。\n\n・もし可能でしたら別シチュエーション・アングルでお互いの脱肛アナル擬似チンポをお互いの前穴に挿入させ合わさられる様子や、どちらかがどちらかの擬似チンポをフェラさせられている様子をお願いします。\n\n先生の描写は手やチンポといった局部的で構いません。\n指定無き事項はお任せいたします。\n以上、マニアックなリクエストですが何卒よろしくお願いいたします。", "nc": 169, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Ganyokong/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3724027, "client_id": 3743915, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/194f0d28/uploads/origins/1b7f23b5-e939-430e-8643-de7ae9b1a5c8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=121c345e380007f9975b01a7e92c3a3a", "srcset": "https://si.imgix.net/194f0d28/uploads/origins/1b7f23b5-e939-430e-8643-de7ae9b1a5c8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=121c345e380007f9975b01a7e92c3a3a, https://si.imgix.net/194f0d28/uploads/origins/1b7f23b5-e939-430e-8643-de7ae9b1a5c8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=78e764c0f90c7a33935ac04223b70ac1 2x, https://si.imgix.net/194f0d28/uploads/origins/1b7f23b5-e939-430e-8643-de7ae9b1a5c8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=9490d830e0c1cff13df0c0ed6c34984d 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/194f0d28/uploads/origins/1b7f23b5-e939-430e-8643-de7ae9b1a5c8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a740bf0fd0dc68cfdcf963630398ee4e", "srcset": "https://si.imgix.net/194f0d28/uploads/origins/1b7f23b5-e939-430e-8643-de7ae9b1a5c8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a740bf0fd0dc68cfdcf963630398ee4e, https://si.imgix.net/194f0d28/uploads/origins/1b7f23b5-e939-430e-8643-de7ae9b1a5c8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=0ca5776a1a7ff44c10e2d20e224fbe3e 2x, https://si.imgix.net/194f0d28/uploads/origins/1b7f23b5-e939-430e-8643-de7ae9b1a5c8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=63e5b977bc2e876cbabe1199d95a64ca 3x"}, "body": "ハローティーチャー\nキャラクター：シロフクロウ（あしたの方舟）\n衣装：白いシルクのみ\nシロフクロウはゲーム内では表情が乏しく、AIのような喋り方をするキャラクターなので、コントラストでシロフクロウの可愛らしさを際立たせたいと思いました。\nシロフクロウの脚はM字に広げられ、両手は脚を押さえ、顔は穏やかだ。\nドクターは指でシロフクロウの肛門をマッサージしてから挿入するが、シロフクロウの顔は紅潮するだけで無表情のまま。\nここでドクターはワーファリンの謎の薬を取り出し、シロフクロウの肛門に塗る。\nしばらくすると、シロフクロウのアソコと肛門は滴り落ち、肛門は腫れ上がって突出し、表情がおかしくなり、瞳孔がラブハートに変わった。\nドクターはシロフクロウに、柔らかい触手と潤滑油が滴り落ちる特殊な手袋をはめた手を見せる。 シロフクロウは手首で口を覆いながら手袋を見つめ、少し期待したような、少し不安そうな表情を浮かべる。\nドクターはシロフクロウの肛門に手を当て、撫でる。\nシロフクロウは軽いオーガズムを感じ、両手で口を覆う。\nこの時、ドクターは手を子宮の方に押しやり、お腹を膨らませる。 最後に、シロフクロウは足を上に伸ばし、両腕を膝に巻きつけ、頭を後ろに傾けながら絶頂を迎える。\nドクターが手を抜くと、白面梟は脱力した状態でベッドに横たわり、肛門は閉じなくなり、手袋からは腸液が滴り落ちる。\n（シロフクロウの側を映して、腹部の出っ張りを見せてほしい)\nありがとうございます", "nc": 49, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Ganyokong/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3724027, "client_id": 3596463, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/1dce4caa/uploads/origins/ae55f308-f1e1-433f-963b-779aec8e5a58?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bcfe7ffaa73d480d8aa6c991c208a5ac", "srcset": "https://si.imgix.net/1dce4caa/uploads/origins/ae55f308-f1e1-433f-963b-779aec8e5a58?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bcfe7ffaa73d480d8aa6c991c208a5ac, https://si.imgix.net/1dce4caa/uploads/origins/ae55f308-f1e1-433f-963b-779aec8e5a58?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=da7265199603ef8417c5a46f5a7958df 2x, https://si.imgix.net/1dce4caa/uploads/origins/ae55f308-f1e1-433f-963b-779aec8e5a58?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a858061cfd8f95d66b267e7b2d15f935 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/1dce4caa/uploads/origins/ae55f308-f1e1-433f-963b-779aec8e5a58?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=25cf15f667d16e2ffb0a3ac3ce7f3442", "srcset": "https://si.imgix.net/1dce4caa/uploads/origins/ae55f308-f1e1-433f-963b-779aec8e5a58?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=25cf15f667d16e2ffb0a3ac3ce7f3442, https://si.imgix.net/1dce4caa/uploads/origins/ae55f308-f1e1-433f-963b-779aec8e5a58?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=ccf623f261fe78c3f690d81d7e1e38ed 2x, https://si.imgix.net/1dce4caa/uploads/origins/ae55f308-f1e1-433f-963b-779aec8e5a58?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=96d08b081bcd0178dd5b05a657c81b84 3x"}, "body": "アークナイツのMon3trがアナニーするイラストをお願いします\nアナルゼリー浣腸から始まり、大きめのアナルビーズで遊んだ後1度引き抜きぼっかりあなるを晒し、1m近くあるロングディルドを入れて大腸の奥まで入れてください。その際腹ボコでどこまで入ってるか見えるようにお願いします。\n最後に引き抜いた後脱肛してる様子もお願いします\nシュチュエーションはベッドの上で寝っ転がりながらアナニーを楽しむようにしてください\nアナニーの途中で潮吹きや放尿を繰り返し、最初に排泄したアナルゼリーと混ざり合いアナニーが進む事にベッドのシーツがぐちゃぐちゃになって行く様子もお願いします。", "nc": 41, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Ganyokong/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3724027, "client_id": 82839, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/04848bf0/uploads/origins/521b55c4-88f3-4355-925d-332c01416f92?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9fbc050d774e23ecca6849e0eacdf557", "srcset": "https://si.imgix.net/04848bf0/uploads/origins/521b55c4-88f3-4355-925d-332c01416f92?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9fbc050d774e23ecca6849e