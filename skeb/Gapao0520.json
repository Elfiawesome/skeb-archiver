状態のゴブリン達にドヤ顔をします。\n\n\nちょっと恥ずかしいですけど、いつもこっそりR18のイラストを依頼します。(〃ω〃) \n\nよろしくお願いいたします！\n\nhttps://drive.google.com/drive/folders/1OrPYsEZcTBejnaeI14u6T4xF6AuAOjr4?usp=sharing", "nc": 33, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Gapao0520/works/120", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/90e8eb1a/uploads/origins/5cd34ff5-7151-4277-a5cc-7ee9ae804989?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=c351553720353077c0d0aa819abbceed", "src_set": ""}, "private": true, "genre": "art", "tipped": false, "creator_id": 774038, "client_id": 0, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 49, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@Gapao0520/works/119", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/63a495ab/uploads/origins/e1383527-0722-4f37-b6a1-705c61b9e732?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=6fd90ce26e7bce6f1d56b14f4ee575bc", "src_set": ""}, "private": true, "genre": "art", "tipped": false, "creator_id": 774038, "client_id": 0, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 49, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@Gapao0520/works/118", "private_thumbnail_image_urls": null, "private": false, "genre": "comic", "tipped": true, "creator_id": 774038, "client_id": 0, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/b6b4fa0b/uploads/origins/14f020bd-5715-4e05-975d-00629030b3f5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7b5d1e6f623b76bf4dcb316a9b97c5b2", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/b6b4fa0b/uploads/origins/14f020bd-5715-4e05-975d-00629030b3f5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f95bca17e828448fa72fc85b787249e9", "src_set": ""}, "body": "ガパオさんこんにちは、突然のメッセージで失礼します。\nガパオさんに描いて頂きたいオカz...もといイラストがあるのでリクエストをします。\n\n描いて頂きたいのはR18の西部劇風コミックで、ノンケで未経験な賞金稼ぎのガンマンと、町中の男を(性的な意味で)貪るのが趣味の賞金首のならず者の屋内での絡みです。\n\nシチュエーションは、町の住人から噂を聞きつけ、ならず者を捕まえようとねぐらとなっている廃屋に着いたガンマン。\nしかし扉を開けて突撃するも、中には誰もおらず、代わりに後頭部を殴られてガンマンは気絶してしまう。\nガンマンが目が覚めると、両手は後手に縛られて布の猿轡を噛まされ、上半身は服を着たままだが下半身は全て脱がされた状態だった。\nふと横を見ると、噂のならず者が上半身着衣でズボンを降ろしてニヤついて経っている...そしてならず者の股間のピストルは既に熱り立ち、ガンマンに標準を合わせていた。\n逃げる事も助けを呼ぶ事も出来ないガンマンに、ならず者は自身のピストルをガンマンの穴に突っ込み、腰を振って犯していく。\n猿轡越しに叫ぶガンマン、穴を堪能してニヤニヤするならず者、そして長い行為の末に中出しされ、最後に「ねぐらを変える」と言い残してならず者はガンマンをそのまま廃屋に置き去りにする。\nガンマンは疲れ果て、ならず者が去った後はただ廃屋の中で放心していた。\n\n...っという内容です。\n行為中は上半身だけ服を着た着衣セッ◯スで、特にガンマンとならず者の首には必ず三角スカーフを巻いて下さい。\nスカーフ付き(←ここは特に好き)の着衣セックスが大好物なので、お願いします。\nガンマンとならず者の種族は、ガパオさんの描きやすいキャラで大丈夫です。\n\n時間が掛かるとは思いますが、空いた時にでも描いて頂ければ幸いです、よろしくお願いします。", "nc": 57, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Gapao0520/works/117", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/8066ec8d/uploads/outputs/34f1150e-2a15-4816-9226-7d8b091c29e3?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=87a6532e25504304fe26e454448632b5", "src_set": ""}, "private": true, "genre": "video", "tipped": true, "creator_id": 774038, "client_id": 3191749, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 177, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@Gapao0520/works/11