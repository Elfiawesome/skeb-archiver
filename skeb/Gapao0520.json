rop&crop=top&w=200&h=200&blur=200&s=52e27ae3cc4a5cc9eeedae44603fda6b", "src_set": ""}, "body": "東京放課後サモナーズのゴルムが、ウェンカムイの飼い犬となり主人の気が済むまで乳首開発され、初々しかった乳首は見るも無惨に変わり果て、\n逞しい大胸筋を痙攣させてパイパンデカ魔羅から汁を豪快に噴き、しかし汁を噴いても乳首責めは止めて貰えず勃起したまま白目まで剥いてしまう、という内容でイラストをリクエストします。\n地面に横たわったウェンカムイの上に仰向けで寝かされ乳首を弄られる構図です。\n何卒お願い致します", "nc": 32, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Gapao0520/works/114", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/a44cea32/uploads/origins/6715bd6a-fa64-4288-9cda-0f998832bc38?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=ade7ff78e05ddddbff9c732fc548564b", "src_set": ""}, "private": true, "genre": "art", "tipped": false, "creator_id": 774038, "client_id": 0, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 33, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@Gapao0520/works/113", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/c79e3578/uploads/origins/03bb7f64-d88a-41df-bbd6-e08944e44a7e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=c1392939f47edcf8929fd439d242f376", "src_set": ""}, "private": true, "genre": "art", "tipped": false, "creator_id": 774038, "client_id": 0, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 32, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@Gapao0520/works/112", "private_thumbnail_image_urls": null, "private": false, "genre": "comic", "tipped": false, "creator_id": 774038, "client_id": 266626, "vtt_url": null, "thumbnail_image_urls": {"s