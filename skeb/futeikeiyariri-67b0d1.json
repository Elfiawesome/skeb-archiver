う着せ替えゲームのスクショです。規約確認済)\n彼女は現役女子高生ビートメイカーで、一人称は「オレ」です。\n\n画像ではグラマラスな体型ですが、幼めの、起伏の少ない体型に描いて頂けると助かります。\nまた、シャツの下にタートルネックのインナーを着ていると嬉しいです。\n\n髪のメッシュには固定色がないので、自由な色でお描きください。\n衣装もアレンジして頂いて構いません。\n\n以前アップされていた人魚リリさんの画像が素敵だったので、あのような等身でお願い出来れば嬉しいですが、お好きなように描いて頂ければこんなに嬉しいことはありません。\n\n難しいリクエストですが、ぜひご検討ください。ありがとうございます！\n\nhttps://drive.google.com/file/d/1toA5sEj_IhpxVBROZPR635XhXTqWZ5S2/view?usp=drivesdk", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@futeikeiyariri/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 383012, "client_id": 134973, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/b64c2c95/requests/76984_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=09888e15c72d285a71ecc5380a2708b8", "srcset": "https://si.imgix.net/b64c2c95/requests/76984_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=09888e15c72d285a71ecc5380a2708b8, https://si.imgix.net/b64c2c95/requests/76984_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=5bd47a97ab1d56a5ea986904ac5c3829 2x, https://si.imgix.net/b64c2c95/requests/76984_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=03bc67e2dec4d4707b1b3fc754c1b829 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/b64c2c95/requests/76984_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3e98bd089487ebdc65a1729d8b82ad71", "srcset": "https://si.imgix.net/b64c2c95/requests/76984_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3e98bd089487ebdc65a1729d8b82ad71, https://si.imgix.net/b64c2c95/requests/76984_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=cfe66c9333cf1b4349baed6b7771fab2 2x, https://si.imgix.net/b64c2c95/requests/7