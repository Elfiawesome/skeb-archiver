00&s=a95b51fc2373685a76246348da5df930", "srcset": "https://si.imgix.net/948bdeb4/uploads/origins/f1ee348e-c6d7-4412-bc2e-c257050df7a3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a95b51fc2373685a76246348da5df930, https://si.imgix.net/948bdeb4/uploads/origins/f1ee348e-c6d7-4412-bc2e-c257050df7a3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=4806f42995b067a8afc048a167be3a9a 2x, https://si.imgix.net/948bdeb4/uploads/origins/f1ee348e-c6d7-4412-bc2e-c257050df7a3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=da055083b8d851246c33e26290511540 3x"}, "body": "こんにちは。わたしの創作キャラクターの橘ななみと佐倉さきのイラストをご依頼したく、メッセージを送らせていただきました。\n\n2人がぬいぐるみの海にきて、生きているぬいぐるみさんたちを観察しているイラストを描いていただきたいです。ぬいぐるみのうみのイメージもつきうさぎさんの思いついたものを描きていただければ幸いです。\n\n構図、服装や色味、ぬいぐるみさんの種類はお任せいたします。よろしくお願いします🙇\n\nhttps://photos.app.goo.gl/zzW8XaZqXNGLiHUf7", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@tsukiusagi_uxu/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3258760, "client_id": 3071235, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/12e9ee32/uploads/origins/65a8b8b8-331f-4409-a943-3ab9b63c951e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f3515ee3a339a345c69e939c9a8b1c1f", "srcset": "https://si.imgix.net/12e9ee32/uploads/origins/65a8b8b8-331f-4409-a943-3ab9b63c951e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f3515ee3a339a345c69e939c9a8b1c1f, https://si.imgix.net/12e9ee32/uploads/origins/65a8b8b8-331f-4409-a943-3ab9b63c951e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=18c0648ebc705d3b62beebd8f89ace06 2x, https://si.imgix.net/12e9ee32/uploads/origins/65a8b8b8-331f-4409-a943-3ab9b63c951e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e62a