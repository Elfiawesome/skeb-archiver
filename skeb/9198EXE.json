&w=200&h=200&s=f6c15a32138e292c0fd5ba2218b51378", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/362b7887/uploads/origins/b92c3013-ccfc-4cd2-8259-619dafbebb50?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3b24f843927392733cd0b3668c6b8b5a", "src_set": ""}, "body": "私のオリジナル・キャラクター( https://imgur.com/a/Uz9UwfU )を、小さな人間( https://imgur.com/a/IeCBRB3 )を食べる巨女としてリクエストする。\n\nhttps://imgur.com/a/Uz9UwfU", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@9198EXE/works/28", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2673683, "client_id": 1194437, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/67d6e133/uploads/origins/03560594-178d-42eb-8965-fcdce142e9c1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=30188fc0e909d39cdb8c1cd8075b24fe", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/67d6e133/uploads/origins/03560594-178d-42eb-8965-fcdce142e9c1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=4f1815c885b8ab01af33e224f9176dac", "src_set": ""}, "body": "こんにちは、HrouZhe。少し前からあなたのことをフォローしています。あなたのスケブのイラストは本当にかわいいです！ペアのキャラクターをリクエストさせてください：\n\nシルトリス：https://drive.google.com/file/d/1oaSxbM502OdlmzhtmrHNfHBWSkCowuYQ/view?usp=drive_link\nそして\nクラリッサ：https://imgur.com/a/clarissaart-k98kzTB\n\n体格差と食欲をフィーチャーしたイラストが見たい。シルトリスが小さなクラリッサを食べている。もし可能なら、クラリッサがシルトリスの胃の中で心配そうにしているところを描いてください。\n\nよろしくお願いします。\n\nhttps://drive.google.com/drive/folders/1YNRdkQUuI7tpDrbdNLAhaKRNswbl_MmB?usp=sharing", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@9198EXE/works/27", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/835fd8ca/uploads/origins/b2bbf176-d128-45c8-9ced-1b61cc59d99d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=9493f2f8a7d0ac31323115257038759a", "src_set": ""}, "private": true, "genre": "art", "tipped": false, "creator_id": 2673683, "client_id": 0, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 145, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@9198EXE/works/26", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2673683, "client_id": 1238441, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/9800c6ff/uploads/origins/31298eca-7caa-461b-91f5-ab6bb30e8d78?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=edb5c506c441ff7b9b6c3d1f79cb4494", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/9800c6ff/uploads/origins/31298eca-7caa-461b-91f5-ab6bb30e8d78?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e5932e2af983b68069bef678dedeaf9d", "src_set": ""}, "body": "またまたこんにちは！またまたリクエストです！\n\n前回の依頼と同じ友人と私のキャラクターとのシークエンスをお願いしたいです！(友達は少し服装が変わったので、新しい参考画像を見てください！)\n\nひつじさん(Pred): https://drive.google.com/drive/folders/1ZtyRV9pCHCDHAji9YdonKcFK_k3k--Tc?usp=sharing\n羊さんの服装はこちらを参考にしてください：https://drive.google.com/drive/folders/1lhi89suU9Q6BrODMFD9iTj_gFCa9T4gK?usp=sharing\n\nカナ（タイニー）: https://drive.google.com/drive/folders/1j0WcLYINcFaw_QmIA0nKRm5VLIGeIQAH?usp=sharing\n\n今回はもっとかわいく、ラブラブなシチュエーションでお願いします！羊ぴーがちっちゃな加奈ちゃんを抱いて、頭を撫でながら、加奈ちゃんはとっても嬉しそうです。\nさらに嬉しそうな佳奈に、羊飼いはキスをする！\nそしてカナは羊平の口の中に入り始める。\n佳奈の足が口からぶら下がっている間、羊美はショックを受けているように見える。\nシーピーは目を丸くし、舌でカナを口の中に引き込む。\n羊平は佳奈を飲み込む。佳奈は顔を赤らめながらも、とても興奮しているように見える。\nラストは、枕に抱きつきながら眠る羊美がいい。お腹の中の佳奈は壁に抱きつき、とろけだしてとても嬉しそうだ。\n\n細かいところですが、伝われば幸いです。\nリクエストを読んでいただき、ありがとうございました！\n\n(Skebがリンクを検出するのに問題があったので、参考リンクをリクエストの一番下に一つにまとめました)\n\nhttps://drive.google.com/drive/folders/1ok9kl3DXP0mxv9KVvaSxwPU5kDM1KFr4?usp=sharing", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@9198EXE/works/25", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/078769d3/uploads/origins/a60402d5-dbdb-42f2-a0b1-9a7cae897ec2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=a4024b917e7daa4e1beb6d4af0778186", "src_set": ""}, "private": true, "genre": "art", "tipped": true, "creator_id": 2673683, "client_id": 888, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 128, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@9198EXE/works/24", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2673683, "client_id": 47683, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/c5c2bc08/uploads/origins/34f11516-4cd7-41de-8833-596ef2ee5d2a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5817afcafd0131f3e9dabbf2546af8de", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/c5c2bc08/uploads/origins/34f11516-4cd7-41de-8833-596ef2ee5d2a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=989e5f0201cc58ea58b5e6425d292053", "src_set": ""}, "body": "私のツイッターアイコン(https://pbs.twimg.com/profile_images/1073575089671593985/QWzE7sh_.jpg)のキャラが、一口サイズくらいにされて、ケモミミしっぽのかわいい男の子に丸呑みにされてしまい、生きたままお尻から出されてしまう作品をお願いします\n丸呑みは、翼を摘まれて持ち上げられて口に運ばれている様子\n口に入れてしまいもぐもぐな様子\n飲み込まれてしまう様子\nお腹に入れられてしまった様子をお腹の中の様子を吹き出しで…といった形でお願いしたいと思います\nお尻から出すところは捕食者さんがお腹が鳴って排泄が近い様子\n捕食者さんが踏ん張って排泄している様子\n排泄を終えてすっきりな捕食者さんと排泄されてぐったりなルークという感じでお願いしたいです\nお尻から出されるまでにたっぷり時間を掛けたような描写があると嬉しいです(数日後…と書く等)\n\nまた、ツイートでの投稿を許可お願いします\n\nよろしくお願いします", "nc": 176, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@9198EXE/works/23", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/40ccd90d/uploads/origins/45a7dc77-fb18-4cbc-9b66-ebb2c870e673?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=99298138371a2af399d570214bb6af2a", "src_set": ""}, "private": true, "genre": "art", "tipped": true, "creator_id": 2673683, "client_id": 3086109, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 17, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@9198EXE/works/22", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2673683, "client_id": 168140, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/87a62e17/uploads/origins/093be259-acac-40ce-ab3c-58efe6a2ccbc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=851f05606b3caa9f2748361c44811d98", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/87a62e17/uploads/origins/093be259-acac-40ce-ab3c-58efe6a2ccbc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=33babafb906eb449d11a700e8f492d19", "src_set": ""}, "body": "はじめまして。\n今回はうちのこがケモミミ系の女の子に丸呑みにされているイラストをお願いしたいです。\n\n●うちのこ\nhttps://drive.google.com/drive/folders/11ECMcj3Dj9-lH6SeU5e4r38ovfwaZJ2R\n身長5〜10cm程度の少年です。\n終始抵抗はしますが、全く敵わず蠕動で愛でられるままです。\n\n●女の子\nデザインをお願いします。\n基本的にお任せしますが、仮に方向性が必要な場合は性格の湿度が高そうな感じにしてください。\n\n●流れ\n女の子にうちのこが捕まる\n↓\n咥え込まれて丸呑みにされる\n↓\n女の子が愛おしそうにお腹を撫でているなか、お腹の中でうちのこが肉壁に揉み込まれる\nという流れでお願いします。\n\n不明点はお任せします。\nよろしくお願いします。", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@9198EXE/works/21", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2673683, "client_id": 80179, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/34d29fe4/uploads/origins/37a72d1c-b111-426f-98ed-170d01a8cf21?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e1a9a5247cbf19dd2c96b5bfd705e365", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/34d29fe4/uploads/origins/37a72d1c-b111-426f-98ed-170d01a8cf21?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a5b1e41cb062852acc865ca6072ebd05", "src_set": ""}, "body": "Hello. Love your work. Please forgive me for multiple requests.\n\nI'd like to request Jahy sama from the great jahy\nwill not be defeated manga and anime eating a tiny person. Mainly, the big version. \n\n\nhttps://the-great-jahy.fandom.com/wiki/Jahy\nhttps://i.redd.it/38n7gubs52j91.jpg\nhttps://encrypted-tbn0.gstatic.com/images?q=tbn:ANd9GcSkN8GgVf699I0ZsHXV3ynA9GMN8gaVaqR6xw&s\nhttps://absoluteterritory.moe/wp-content/uploads/2021/11/261675.jpg\nhttps://takamakijoker.files.wordpress.com/2023/01/jahy0301-1.jpg?w=640\n\nfor the sequence, \n\nPanel 1: have the tiny person fearful of big jahy as big jahy licks\nher lips or berates the tiny person. Have big jahy with a mean glare or look.\n\n\nPanel 2: Big jahy drops the tiny person in her mouth\n\nPanel 3: Big jahy swallows the tiny person\n\nPanel 4: Big jahy sighs in annoyance as the tiny person\nis in her stomach.\n\nUltimately I leave the details to you.\n\nhttps://blogger.googleusercontent.com/img/b/R29vZ2xl/AVvXsEjU-xMyorSGzekbkeB2q0X0WXHepot9wYRi9Pc7tOGSQfZrpYsD2h_EBa_mCMEz6gxX3wmBy47Pud_bmxxY2DLVfupp34k7hSFRIV3_WaENx1xv_nP3llDDFJkZKLMQdu1RZ6oHWw/s0/The+Great+Jahy+Will+Not+Be+Defeated%2521+-+Episode+4+-+Saurva+Watches+Jahy+with+Minions.jpg\n\nfor the tiny person, you can have it be salwa from the great jahy won't be defeated or one of the snake people. Please choose whichever tiny is best.\n\nhttps://the-great-jahy.fandom.com/wiki/Jahy", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@9198EXE/works/20", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2673683, "client_id": 80179, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/1984056c/uploads/origins/63bae5f0-6532-43e2-aa0e-56abea4e3040?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8204918c24af50272969d220055f7e06", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/1984056c/uploads/origins/63bae5f0-6532-43e2-aa0e-56abea4e3040?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=44fbf120f08e8bc42f4039fc92ef91d2", "src_set": ""}, "body": "Hello there.\n\nI'd like to request android 21 majin form from the dragon ball fighterz video game. The good version with blue eyes eating a tiny. Pick any tiny you wish. Maybe a tiny yamcha from dragonball z but ultimately I leave it to you. Pick any tiny you wish. Maybe have her eat her evil side.\n\nGood android 21\n\nhttps://i.redd.it/yhhfqbtju7o61.jpg\nhttps://static.wikia.nocookie.net/dragonball/images/4/43/Android_21_%28Good%29_Majin_Form_Hero_DBF.png/revision/latest?cb=20180226063120\n\n\nFor the sequence, \n\nPanel 1: have the tiny being held by good 21 as good 21 licks\nher lips\n\nPanel 2: Have good android 21 put the tiny in her mouth\nwith the tiny's head dangling from her mouth\n\nPanel 3: Have her swallow the tiny with a panel\nof her swallowing or gulping\n\nPanel 4: Have her gushing or happy over having eaten the tiny. I want to be jealous of the tiny to get swallowed by a cute woman. \n\n\n\nEvil 21 below could be the tiny one that gets eaten by the good version.\nhttps://static1.cbrimages.com/wordpress/wp-content/uploads/2018/02/Dragon-Ball-Android-21-Evil.jpg\nhttps://64.media.tumblr.com/5bebb81b2a06ab52734a11492bb0b988/tumblr_inline_p6oxr67McR1tpezks_1280.jpg\n\nhttps://i.redd.it/yhhfqbtju7o61.jpg", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@9198EXE/works/19", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/63ee014f/uploads/origins/2dd27153-42bb-4b8a-91b4-692cfc7d8871?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=ae65a833b1f396c89c4defa1ab45b2ec", "src_set": ""}, "private": true, "genre": "art", "tipped": false, "creator_id": 2673683, "client_id": 80179, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 0, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@9198EXE/works/18", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2673683, "client_id": 1238441, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/15a3c50e/uploads/origins/74a0e192-0b6d-4f14-8108-708659f016f0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3a2baffc7232e96265fda756db747f8f", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/15a3c50e/uploads/origins/74a0e192-0b6d-4f14-8108-708659f016f0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=fe0e158e1ac8d86e8c9db4ce954853f0", "src_set": ""}, "body": "再びこんにちは！あなたはすぐに私のお気に入りのアーティストの一人になりました！またリクエストしてもいいですか？\n\n僕のOCの羊ちゃんがVtuberの猫又おかゆに食べられるシークエンスをお願いしたいです。具体的には、参考資料の衣装で。\n\nSheepi: https://drive.google.com/drive/u/1/folders/1Cb5bzAZDX-Ud5n6Z61xJWscYrVT13dpw\n\nおかゆ：https://drive.google.com/drive/folders/118fzQrdwu8NQHBN1RsyxvwxDJqJHjRFQ\n\nシーピーを抱きながら、唇を舐めてほしい。シエピは最初、オカユに会えて興奮しているようだ。\n\nそして岡佑は羊美を口の上にぶら下げる。羊ぴはおどおどしている！\n\nツバメが入るはずだ。\n\nつばめの後、あくびをするおかゆが見たい。眠り始めている。羊は胃の中でとても動揺している。\n\nずっと後、寝ている岡湯を見てみたい。おなかの横にドクロ。ほとんど液体と羊ぴの服の切れ端で胃の中を見ることもできるのだろうか。\n\n細かいことですが、よろしくお願いします。\nリクエストを読んでいただき、ありがとうございました！", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@9198EXE/works/17", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/2a76b94c/uploads/origins/01a99449-e972-42db-8750-d6cdea970902?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=cebfeb71d7ba5ed0239a77f7ca635479", "src_set": ""}, "private": true, "genre": "art", "tipped": true, "creator_id": 2673683, "client_id": 0, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 1, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@9198EXE/works/16", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2673683, "client_id": 1994141, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/9d28d327/uploads/origins/cb900750-3dd6-498f-a506-0ad5f3f9402a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3c08d1f5fed49cd3efe1eb2d6504d7b1", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/9d28d327/uploads/origins/cb900750-3dd6-498f-a506-0ad5f3f9402a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=320afd61113aeac413f860e5bd826810", "src_set": ""}, "body": "こんにちは！あなたの絵はとてもかわいいですね。体格差と \"ボア \"も大好きです！もしよろしければ、私のねずみ男の子のキャラクターを描いていただけませんか？名前は「ミュンスター」です。\n\n好きなキャラに食べられるミュンスターを描いてください。好きなように食べられているところを描いてください。量に余裕があれば、飲み込まれた後、肉食獣キャラの胃の中で丸まっている姿も描いていただけませんか？ミュンスター」は心配そうな表情をしていてほしいです。\n\nご配慮ありがとうございました！\n\nhttps://drive.google.com/drive/folders/13EE4uG2XwZd6eY0Hj0KUCJjE_7wt96Wz?usp=sharing", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@9198EXE/works/15", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/3c6efed4/uploads/origins/eb06d676-fc2d-4307-87d0-ffc541cfdc8b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=b4ee2e285f5eb6fc809dcd9238bd7d95", "src_set": ""}, "private": true, "genre": "art", "tipped": true, "creator_id": 2673683, "client_id": 2198225, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 129, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@9198EXE/works/14", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2673683, "client_id": 80179, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/f96126d1/uploads/origins/55cbeccf-51c8-48d6-85a1-7d5305e4b84f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a1c7c38f19ce65ca7f3671e69d10e2b5", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/f96126d1/uploads/origins/55cbeccf-51c8-48d6-85a1-7d5305e4b84f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=594ec9706b188fb9d9fbc24854722ba6", "src_set": ""}, "body": "Hello,\n\nI'd like to request Chiya from the manga series Urara Meirochou eating a tiny person.\n\n\nFirst image is where she has a tiny person in her