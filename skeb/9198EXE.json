si.imgix.net/f04d61fa/uploads/origins/f563c21c-18e2-4d34-b635-18837491a8a3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=bfba685581f192787d93da0b9ab2ca29", "src_set": ""}, "body": "Hello I enjoy your work immensely. If it is appropriate I would like one of my office girl being giant paired with a tiny boy. She eats and swallows him and I'd like internals as well with the blushing boy in the stomach/throat. Thank you!\n\nhttps://imgur.com/a/2Is1o4m", "nc": 152, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@9198EXE/works/11", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2673683, "client_id": 1238441, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/572ca9cb/uploads/origins/4060ef65-9c64-4b7c-aa81-c06d28b6172c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c1e7a3c27b7dfeefa0f504b016240add", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/572ca9cb/uploads/origins/4060ef65-9c64-4b7c-aa81-c06d28b6172c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=4a76ebe8e42c263daa66e5a6116325c0", "src_set": ""}, "body": "またまたこんにちは！前回のリクエストがとても気に入ったので、今回もお願いしたい！\n\n友人と私のキャラクターとのシークエンスをお願いしたいです！\n\nしーぴさん / ひつじさん: https://drive.google.com/drive/u/1/folders/1Cb5bzAZDX-Ud5n6Z61xJWscYrVT13dpw\n\nカナ: https://drive.google.com/drive/folders/1j0WcLYINcFaw_QmIA0nKRm5VLIGeIQAH?usp=sharing\n\n2人の女の子に食べさせ合ってほしい！かなさんがひつじさんにちっちゃいのをあげる。そして、シーピーがカナにちっちゃいのを食べさせてあげる。二人ともツバメを見ながら楽しんでいるはずだ。\nちっちゃな人たちは、最小限のディテールでも、ベーシックなデザインでも構いません。\n\n最後には、羊ぴと佳奈が一緒に座っているようにしたい。とてもかわいく見えるはずだ！羊ぴは佳奈の肩に頭を乗せて眠っているように見える。二人ともお腹の中でもがくのを楽しんでいる。もしよろしければ、この部分のお腹が空っぽのバージョンも入れていただけると嬉しいです！それぞれの胃の横に小さなドクロを描いてもいいかもしれない。\n\n二人だし、細かいリクエストなので多めにしました！\n\n詳細が伝われば幸いです。\nリクエスト読んでくださってありがとうございました！", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@9198EXE/works/10", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2673683, "client_id": 2909529, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/2aadfb0b/uploads/origins/ec81f0fc-6cac-4e69-bd1e-77bf24db85eb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3a192fe069f7145bc2b00844a6e1af96", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/2aadfb0b/uploads/origins/ec81f0fc-6cac-4e69-bd1e-77bf24db85eb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2fd298f15131889411672f7b9718ab0b", "src_set": ""}, "body": "Hi I would like to request a piece form you using 2 original characters Ruru and Noah \n\nFirst I would like to see Ruru on all fours  looking extremely smug licking her lips, with her hands ontop of Noah pinning him down as he struggles\n\nSecondly I would then like to see  Ruru with her mouth open full of saliva and tongue sticking out with Noah laying on her tongue panicking \n\nThirdly I would like to see Ruru gulp Noah, with an internal of Noah going down her throat, blushing and being squished \n\nLastly I would like to see Ruru looking at her tummy and burping, with an internal of Noah sitting in her gut pouting \n\nReference for Ruru\n\nhttps://drive.google.com/drive/folders/1-bWZmT4QYKyDRpa1AfUB1RWc1b8vcbTP\n\nReference for Noah\n\nhttps://drive.google.com/drive/folders/1-euQbtyF0GIGT53Ius3yzwaFnk-KowMB\n\nhttps://drive.google.com/drive/folders/1-bBLdOjzjD-lRmMBO95y8iMhpaYc0KFT", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@9198EXE/works/9", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2673683, "client_id": 2909529, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.