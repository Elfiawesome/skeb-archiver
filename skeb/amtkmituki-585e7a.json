4-d1bca59f47d7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=fffe7583cc3c48d944af8524b2bc6b43 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/39719ff8/uploads/origins/619e5319-3ec2-4442-be24-d1bca59f47d7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=bff0eb38727fe2535b7a122fccca92eb", "srcset": "https://si.imgix.net/39719ff8/uploads/origins/619e5319-3ec2-4442-be24-d1bca59f47d7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=bff0eb38727fe2535b7a122fccca92eb, https://si.imgix.net/39719ff8/uploads/origins/619e5319-3ec2-4442-be24-d1bca59f47d7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=bbc5f54ab5eb8bca6795b7641f0d314f 2x, https://si.imgix.net/39719ff8/uploads/origins/619e5319-3ec2-4442-be24-d1bca59f47d7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=bd1d0391cfd5ebb7ea6566bd369784fd 3x"}, "body": "はじめまして、今回初めてのリクエストをお願いします！\n先日Xに上がっていたティーパーティーの漫画を拝見しまして、是非こちらもティーパーティーの面々で漫画のリクエストをお願いしたいです！\n\n「ドカ食いミカ」\n①シャーレでの手伝いを終えてトリニティへ戻るミカはティーパーティーのお茶会まで時間がある事に気付く\n②トリニティへの道中、ミカは食べ歩きに夢中になって何軒もハシゴした結果、トリニティに着く頃には食べ過ぎでお腹が丸くなってしまう\n③少し遅れてお茶会の場所へ着いたがお菓子と紅茶を見た瞬間、満腹の苦しさから思わずゲップするミカ\n④ナギサは気付かずにどうしたのか疑問に思ったがなんでもないとごまかしてお菓子とお茶を無理矢理食べるミカ\n⑤ナギサは急用で一時席を外し、安堵するミカ\nしかしセイアには気付かれていた上に丸々と大きくなったお腹を見られ、「後でこっそり美味しかったお店を教えてくれるなら黙っていよう」と言われ取引に乗るミカ\n⑥戻ってきたナギサはお菓子を追加してお茶会を続行し、満腹で苦しい中ナギサにバレないように必死に食べるミカを見て笑いを堪えるセイアであった\n\n以上です。\n是非ご検討よろしくお願いします！", "nc": 41, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@amtkmituki/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "comic", "tipped": false, "creator_id": 114182, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/76900942/uploads/origins/3502105c-1de0-4c7a-9d13-3676a5dffbb4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1240fcc9693063c1469681ed7315fb89", "srcset": "https://si.imgix.net/76900942/uploads/origins/3502105c-1de0-4c7a-9d13-3676a5dffbb4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1240fcc9693063c1469681ed7315fb89, https://si.imgix.net/76900942/uploads/origins/3502105c-1de0-4c7a-9d13-3676a5dffbb4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=8880933fe5ae676e58b07019ce0e64a3 2x, https://si.imgix.net/76900942/uploads/origins/3502105c-1de0-4c7a-9d13-3676a5dffbb4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=91d0406c3b07f51d8452781e22fa553e 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/76900942/uploads/origins/3502105c-1de0-4c7a-9d13-3676a5dffbb4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=8108eec0ee006a096e9ac6439f79acf3", "srcset": "https://si.imgix.net/76900942/uploads/origins/3502105c-1de0-4c7a-9d13-3676a5dffbb4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=8108eec0ee006a096e9ac6439f79acf3, https://si.imgix.net/76900942/uploads/origins/3502105c-1de0-4c7a-9d13-3676a5dffbb4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=36ea4dfbb87a3c2156c1e20a9923beac 2x, https://si.imgix.net/76900942/uploads/origins/3502105c-1de0-4c7a-9d13-3676a5dffbb4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=89f4606821c2d8cad7d515d07182efd0 3x"}, "body": "こんにちは！『ティーパーティートリコロール！！！』をすごく楽しませていただきました。第二話に基づいた別の結末なシナリオをリクエストしたいと思います。\n\nナギサさんはミカちゃんが元のサイズに戻ってもまだベッドに使い続けている。一方、セイアちゃんは巨大な彼女から降りていた。しかし、このためナギサはミカと共に小さくなってしまい、今は小さな体になってしまった。ミカは慌てふためき、心配そうに掌にナギサを持ってる。セイアは小さなナギサを観察しようと身を乗り出す。レーザービームでこんな現象が起こったことはなく、驚きと困惑が入り混じっている。縮小効果を相殺できるかもしれないと、ナギサにレーザービームを当てて元のサイズに戻すことを提案する。\n\nしかし、ビームが当たった時、巨大化効果の典型的な不安定性がこれまで以上に増幅し、そして小さなナギサは巨大化する。まだ疲れたナギサは嬉しそうにセイアとミカの姿を見下ろすと、二人をすくい上げた。ナギサの巨大な手でもがきながら逃げようとするが、巨大な彼女はただ頬に押し当てて抱きしめるだけだった。\n\n３分の限界が経過し、巨大なナギサは小さくなる。もちろん、そもそもビームを受けた時は小さかったため、再び小さな体に戻ってしまう…しかも、更に小さくなったミカとセイアをまだ手に抱えたまま。超小さな二人は以前よりも激しくパニックに陥っているｗ。「巨大化レーザービーム」はナギサの隣の地面にあり、彼女の全身よりも大きい。\n\nありがとうございました！少し長めのシナリオですが、お受けいただけたらとっても嬉しいです！シナリオはご自由に調整や描写してください。（念のためＮＳＦＷに設定しましたが、特に露骨な描写は望んでいません。自分の原作と同じ感じで。）", "nc": 24, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@amtkmituki/works/3", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/6487107f/uploads/origins/4feee007-065a-432d-84e5-1b8264397d32?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=d48fddf07a7dbbdd596b0757c9ee41fd", "srcset": "https://si.imgix.net/6487107f/uploads/origins/4feee007-065a-432d-84e5-1b8264397d32?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=d48fddf07a7dbbdd596b0757c9ee41fd, https://si.imgix.net/6487107f/uploads/origins/4feee007-065a-432d-84e5-1b8264397d32?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=b62c8848038152eabb0bf4372a18e7cb 2x, https://si.imgix.net/6487107f/uploads/origins/4feee007-065a-432d-84e5-1b8264397d32?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=53bf90dfe0004bb181019f142ab29f6a 3x"}, "private": true, "genre": "art", "tipped": true, "creator_id": 114182, "nc": 144}, {"path": "/@amtkmituki/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 114182, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/bb892016/uploads/origins/3d0ec0c3