&w=200&h=200&s=f02f01336b21c2b22ffe042d048642f2", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/d10958ad/uploads/origins/bd0aca01-985e-4a0c-a8c6-b8b84258b09b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6c80aba1ca39f745a1f53764f6df9978", "src_set": ""}, "body": "作品：私がモテないのはどう考えてもお前らが悪い!＋僕の心のヤバイやつ＋ガールズ＆パンツァー\nキャラクター：黒木智子・田村ゆり・市川京太郎・山田杏奈・西住みほ・秋山優花里\nシチュエーション：\nわたモテの智子とゆり・僕ヤバの京太郎と杏奈が茨城県大洗町にガルパン聖地巡礼ダブルデートに出かける\n色んな場所を巡り美味しいものを食べ歩き四人同じ宿の同じ部屋に宿泊する\n翌朝楽しかったねと帰路に着く\nふとそういえばガルパンの連中に全く会わなかったなと思う智子\n実はみほと秋山殿はあえて姿を見せて案内などせず陰で四人の巡礼を見守っていた\n\n智子とゆり・京太郎と杏奈は恋人同士で四人は気の置けない友人同士という設定\n巡る場所・食べ物・宿等全てお任せしますので見ると自分も行きたくなるような楽しい話に仕上げて頂きたいです\n宜しくお願いします。", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@omatiosake/works/3", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/2e09962f/uploads/origins/c5cf4098-a67f-4e19-a433-964e350baffe?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=ca7a9fffe1c4507df30b1363386bbb2d", "src_set": ""}, "private": true, "genre": "art", "tipped": false, "creator_id": 3534174, "client_id": 316915, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 128, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@omatiosake/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3534174, "client_id": 3158585, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/e9b20c60/uploads/origins/f9154966-3807-4265-996a-ba605191ff9d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f270a1d1547386b492e9dcc4d3e8a420", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/e9b20c60/uploads/origins/f9154966-3807-4265-996a-ba605191ff9d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a38afdc5109bfa760828f36757bcdc23", "src_set": ""}, "body": "イラストの依頼をさせていただきます。\nガールズアンドパンツァーのダージリン様が、ケイさんに長崎観光で案内されているイラストをお願いしたいです。\n個人的なイメージでは、サンダース大学附属高校は長崎でも佐世保市にあるイメージ(米軍オマージュより)ですが、あえてケイさんが長崎市の港が一望できる長崎市内南山手のグラバー園で、一緒に(実際にある有料サービス　https://glover-garden.jp/activity-and-shop/retro-photo/)洋装コスプレしながら楽しんでいるシーンを見たくなりました。\n必要な資料などございましたら提供いたしますので、ご検討のほどよろしくお願いいたします！\n金額は分かりませんのでデフォルトのまま依頼かけさせていただきます。\n\nhttps://glover-garden.jp/", "nc": 24, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@omatiosake/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3534174, "client_id": 605317, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/5cd6af5e/uploads/origins/7a0d974c-ed52-47b9-954d-e46147349efe?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=463c51043368517424bd25b21293b7f9", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/5cd6af5e/uploads/origins/7a0d974c-ed52-47b9-954d-e46147349efe?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2df70b400e33f6a3c6dd5e2c11d71a4b", "src_set": ""}, "body": "おまち様、この度はSkeb開設おめでとうございます。早速ですがリクエストしたいと思います。\n\nガルパンのダージリンが大洗の絶景スポット\n磯浜海防陣屋跡をジョギングしてるシーンをお願いします。\nhttps://drive.google.com/drive/folders/1DvcbaNisdpHwFONiFVVSBeYHg2r7j_Y-?usp=sharing\n\nダージリンの服装は聖グロリアーナのＰＪみたいな赤黒の配色のスポーツパーカー\n↓参考資料、アレンジ可です。\nhttps://drive.google.com/drive/folders/16Uorq5FZGQZPj40_0SVi4nqUDYAVGSn-?usp=sharing\n\nダージリンは汗をかきリラックスしてる表情で「はっ　はっ」と呼吸している。\nまた、ダージリンは股間部から上の大きく映ってる構図でお願いしたいです。\n\nよろしければお願いします。", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_sam