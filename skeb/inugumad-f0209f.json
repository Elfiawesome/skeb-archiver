aa7ba16/uploads/origins/dc6d7a41-99bc-454f-ba68-8ca64c0376a1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=674e83ae374f50f8ba3ad9f7115f99c2 3x"}, "body": "こんにちは。私はこのポーズで、同じ服を着て、彼女の乳首を見せている私のオークが好きです。また、彼女はホリ・ウッドのコスプレをする予定なので、この同じヘアスタイルの私のオークが好きですシーンとホリ・ウッドはこちら https://x.com/trinitymul53186/status/1918664544748032280 私のオークはこちら https://x.com/Tninity_/status/1895986849568735447", "nc": 48, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@inugumad/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3034762, "client_id": 560233, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/6c4c1dcf/uploads/origins/45c6755b-8ff6-440f-bb62-ec70929e24a9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b72db42fe77bdb0fcb5488e1d6c9a22f", "srcset": "https://si.imgix.net/6c4c1dcf/uploads/origins/45c6755b-8ff6-440f-bb62-ec70929e24a9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b72db42fe77bdb0fcb5488e1d6c9a22f, https://si.imgix.net/6c4c1dcf/uploads/origins/45c6755b-8ff6-440f-bb62-ec70929e24a9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f22b4e9a5105e1951c0f852b61ef27af 2x, https://si.imgix.net/6c4c1dcf/uploads/origins/45c6755b-8ff6-440f-bb62-ec70929e24a9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=8ef0180a053ccdb844b8e48c37678dca 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/6c4c1dcf/uploads/origins/45c6755b-8ff6-440f-bb62-ec70929e24a9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=30aa270967bbe4d93355ac9762ec11c9", "srcset": "https://si.imgix.net/6c4c1dcf/uploads/origins/45c6755b-8ff6-440f-bb62-ec70929e24a9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=30aa270967bbe4d93355ac9762ec11c9, https://si.imgix.net/6c4c1dcf/uploads/origins/45c6755b-8ff6-440f-bb62-ec70929e24a9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=089b1802673b6f40b52470c3a7b2788d 2x, https://si.imgix.net/6c4c1dcf/uploads/origins/45c6755b-8ff6-440f-bb62-ec70929e24a9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=a1be832521659e7dbcd60da9cf67c0d6 3x"}, "body": "こんにちは！私のキャラクターを特定のシーンでお願いしたいのですが。私のキャラクター、ビビアンはロボットの手足を持つ潜入捜査官で、汚職を根絶するためにストリップクラブで働いています。この作品では、客が彼女の下着の写真を撮ろうとしています。彼女の下着の写真を撮っている携帯電話を持った腕が見える。スマホの画面では、彼女が黒いTバックをはいているのがわかる。ビビアンは驚きと恥ずかしさで反応している。\n\n彼女の膝から頭までが見える。\n\nもし許されるなら、彼女のセカンドレイヤーをお願いしたい。このバージョンでは、彼女は経験豊富な売春婦になっている。(リンク先に参考文献を載せました）今回は、彼女は下着をつけていません。彼女の膣からは、まだ外していない精液と使用済みのコンドームが出ているのが見える。恥ずかしいどころか、彼女は今、気にしておらず、少し苛立ちさえ感じている。\n\n本当に大丈夫なのかしら。でも、もしあなたがしたくないのなら、私は理解しています。\n\nリクエストを読んでくれてありがとう！\n\nhttps://drive.google.com/drive/folders/1xzYMi6FFhttGItPEkOpfy7SB3dD3Vwrw?usp=sharing", "nc": 176, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@inugumad/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3034762, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/897839f1/uploads/origins/c6669c55-59ce-412d-9c70-a0ba848d3765?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8edbe18a472652bd5b000fbb037f8bf5", "srcset": "https://si.imgix.net/897839f1/uploads/origins/c6669c55-59ce-412d-9c70-a0ba848d3765?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8edbe18a472652bd5b000fbb037f8bf5, https://si.imgix.net/897839f1/uploads/origins/c6669c55-59ce-412d-9c70-a0ba848d3765?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=02170c60ff4e7e9be380d328200c6ef0 2x, https://si.imgix.net/897839f1/uploads/origins/c6669c55-59ce-412d-9c70-a0ba848d3765?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=