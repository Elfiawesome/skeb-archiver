uto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=bc56146b9a709e8f22529689110690af 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/203c6257/uploads/origins/c308d524-639c-427e-833c-4752f2f401e3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e860bdf959b92f6eacccb9cdf23061a8", "srcset": "https://si.imgix.net/203c6257/uploads/origins/c308d524-639c-427e-833c-4752f2f401e3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e860bdf959b92f6eacccb9cdf23061a8, https://si.imgix.net/203c6257/uploads/origins/c308d524-639c-427e-833c-4752f2f401e3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=63e1c74ebb712f15675d5867631e22bb 2x, https://si.imgix.net/203c6257/uploads/origins/c308d524-639c-427e-833c-4752f2f401e3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=86873b66e5822b546c8859248a7f640b 3x"}, "body": "長尾しん(Skeb)様こんにちは\nこーほく(古山)と申します\n\nURLの様なキャラのフィギュアを販売中で、新作モチーフを必要としています\n絵柄が好みの方でしたのでリクエストさせていただきました\n\n南国の無邪気な薄着少女のキャラを、等身は12歳くらい、裸足の全身画をお願いします\nhttps://drive.google.com/file/d/1nwJ55U55jM8KS5ACtXndjRf7x9bagzGA/view?usp=sharing\n\nキャラデザ的なリクエストなのですが\nもしよろしければご検討下さい。\n\n着衣は下記イラストくらいの、裸に布をまとって結んだくらいのごくシンプルな感じでお願いします\nイメージとしては奴隷服とか原始人服くらいのざっくりしたデザインで。\n完全な水着やズボン形状は避けて下さい\n\nhttps://skeb.jp/@TN_D75/works/11\nhttps://skeb.jp/@hommakai910/works/29\nhttps://skeb.jp/@tibiMALINO/works/11\nhttps://skeb.jp/@173_trpg/works/1\nhttps://skeb.jp/@natou3wari/works/2\nhttps://skeb.jp/@heibonkaeru/works/5\nhttps://skeb.jp/@e_crsm/works/5\nhttps://skeb.jp/@miyakon22/works/27\nhttps://skeb.jp/@618kazeman/works/7\n\n10cmくらいのフィギュアを予定しており、細かいディテールは再現できないので全体のシルエット・表情・ポーズ等でキャラクターが表現されているとありがたい感じです\n\nシチュやポーズで「はいてない」「腋乳」等フェチポイントを表現してくれるとうれしいです\n\n衣服とフェチポイント以外の、キャラそのものはお任せします。\n迷ったらお好み・お得意なもの・マイキャラ等を当てはめて下さい\n\n背景はありでもなしでもOK\n\n衣装や髪の見えない方向(背中等)からのごく簡単なラフ画もあると嬉しいです\n\nよろしければご検討お願い致します\n\nhttps://drive.google.com/file/d/1nwJ55U55jM8KS5ACtXndjRf7x9bagzGA/view?usp=sharing", "nc": 24, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@mituru_nagawo/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1979097, "client_id": 834745, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/d5220c11/uploads/origins/3a0b9ab7-f792-47e5-9633-c1f95c4bd188?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=49a1089b9b17b6f76343c604c4b476c6", "srcset": "https://si.imgix.net/d5220c11/uploads/origins/3a0b9ab7-f792-47e5-9633-c1f95c4bd188?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=49a1089b9b17b6f76343c604c4b476c6, https://si.imgix.net/d5220c11/uploads/origins/3a0b9ab7-f792-47e5-9633-c1f95c4bd188?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=9adde3af8600192d2dafcda2e5dce5ae 2x, https://si.imgix.net/d5220c11/uploads/origins/3a0b9ab7-f792-47e5-9633-c1f95c4bd188?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=709f364dd007bf10065bc5c284fc0bea 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/d5220c11/uploads/origins/3a0b9ab7-f792-47e5-9633-c1f95c4bd188?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2eedca520a5edf8fcae90c0e46038db4", "srcset": "https://si.imgix.net/d5220c11/uploads/origins/3a0b9ab7-f792-47e5-9633-c1f95c4bd188?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2eedca520a5edf8fcae90c0e46038db4, https://si.imgix.net/d5220c11/uploads/origins/3a0b9ab7-f792-47e5-9633-c1f95c4bd188?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=5ec9ab5e8a8361211dc1cea121fd4a99 2x, https://si.imgix.net/d5220c11/uploads/origins/3a0b9ab7-f792-47e5-9633-c1f95c4bd188?bg=%23