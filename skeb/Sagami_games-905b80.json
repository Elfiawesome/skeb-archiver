その全容を解き明かすのは容易ではない。\n宗教的観念に基いた説もあれば数学的理論に基いた説もある、多様なんだよ、哲学というものは。\nだからこそ俺は哲学を好んでいる。\n理論として破綻しているものでさえ、俺の知と成り得るのだから。」\n\n「君の為ならどうなったって良かったよ。」\n\n参考程度にしていただければ、と思います！\n人ならざる美しさをもつ、孤独な天才。\nというイメージで創作していただけると嬉しいです。\nビジュアルに関しては資料を貼付させていただきますのでそちらをご確認いただければ幸いです！\n不備などございましたらお気兼ねなくキャンセルしていただければと思います。\nよろしくお願いします。\n\nhttps://drive.google.com/drive/folders/1-J-KhvB5wRBSsN45wPpEG291TuJBxvDM", "nc": 24, "word_count": 0, "transcoder": "audio", "creator_acceptable_same_genre": true}, {"path": "/@modiodal100mg/works/154", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 336482, "client_id": 2772830, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/bc0dd720/uploads/origins/04a01abd-8375-4a8a-8fd5-1c85f261e6a6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c4fb38239e360c16b8b6256881d7c203", "srcset": "https://si.imgix.net/bc0dd720/uploads/origins/04a01abd-8375-4a8a-8fd5-1c85f261e6a6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c4fb38239e360c16b8b6256881d7c203, https://si.imgix.net/bc0dd720/uploads/origins/04a01abd-8375-4a8a-8fd5-1c85f261e6a6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=5ddd5cbecde945a8bdd8fad4917b90d9 2x, https://si.imgix.net/bc0dd720/uploads/origins/04a01abd-8375-4a8a-8fd5-1c85f261e6a6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=51c8e14781e5f1d99ab235e2f2649da2 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/bc0dd720/uploads/origins/04a01abd-8375-4a8a-8fd5-1c85f261e6a6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=62cdcd249514cf260e2fbed84565bbec", "srcset": "https://si.imgix.net/bc0dd720/uploads/origins/04a01abd-8375-4a8a-8fd5-1c85f261e6a6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=62cdcd249514cf260e2fbed84565bbec, https://s