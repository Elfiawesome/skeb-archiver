せん。\nお読みいただき、ご検討いただけますと幸いです。\n\nhttps://drive.google.com/drive/folders/1H3mf6-DZOOfahb2YFd6kh6WZCd6dz7HS", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 15822, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "サトメセツコ", "screen_name": "setsu_ika", "avatar_url": "https://pbs.twimg.com/profile_images/1400502200325984264/ixYCrX9C.jpg", "header_url": "https://pbs.twimg.com/profile_banners/3321229206/1620399982/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 30, "skills": [{"genre": "art"}], "banned": false, "nc": 1}, {"id": 1089518, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "さめあ", "screen_name": "Sa_me_a", "avatar_url": "https://pbs.twimg.com/profile_images/1853014262303879168/Vqn_vDIr.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1339873134321651714/1723891298/1500x500", "appeal_receivable": true, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "art"}, {"genre": "correction"}], "banned": false, "nc": 144}, {"id": 3046478, "creator": true, "nsfw_acceptable": false, "acceptable": false, "name": "そう介", "screen_name": "mochi_sousuke", "avatar_url": "https://pbs.twimg.com/profile_images/2005572006595751936/zCvjVrAz.png", "header_url": "https://pbs.twimg.com/profile_banners/1738471698620702720/1773749190/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 5, "complete_expiration_days": 90, "skills": [{"genre": "art"}], "bann