o=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=dc276925dd3849108d8ae6edf4f62f00 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/7a3cc20f/uploads/origins/d8339bc0-3380-43b3-8b07-13087bd07b36?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=1c45cc25b3fcd10dc8d6dda645a4a86d", "srcset": "https://si.imgix.net/7a3cc20f/uploads/origins/d8339bc0-3380-43b3-8b07-13087bd07b36?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=1c45cc25b3fcd10dc8d6dda645a4a86d, https://si.imgix.net/7a3cc20f/uploads/origins/d8339bc0-3380-43b3-8b07-13087bd07b36?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=13400bddbef6f4ead7e78dea3cb48722 2x, https://si.imgix.net/7a3cc20f/uploads/origins/d8339bc0-3380-43b3-8b07-13087bd07b36?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=218ca3d4d7c6bede6758e94de9e4a489 3x"}, "body": "こんにちは！お忙しいところ申し訳ありません！今回のご依頼について、もしよろしければ、私のオリジナルキャラクター（OC）たちの交流シーンのイラストを描いていただけないでしょうか。↓以下に、彼らの簡単な性格紹介と要望を記載します。\n\n二人が生きる時代はどちらも20世紀です。\n（ボトム）コンスタンティン：24歳、金髪・赤瞳、身長182cm、背が高く痩せており、体格は華奢で、物腰は優雅です。コンスタンティンは貴族で、一族は非常に裕福であり、両親や兄から溺愛されています。彼は聡明で優秀ですが、貴族らしい気性があり、高慢で自尊心が強い一面も持っています。人当たりは良いものの、どこか距離感を感じさせる人物です。大学を早期卒業した後、文学の道に進み、執筆活動やジャーナリズムの分野で重要な地位を築いています。その聡明さから、時折警察から事件の捜査協力を依頼されることもあります。彼はヴィラカスを高く評価しており、後に二人が共通の秘密を持つようになったことで、その評価は好意へと変わっていった。\n\n（Top）ヴィラカス：21歳、186cm、茶色の軽くウェーブのかかった髪、緑の瞳、標準的な体格、穏やかで礼儀正しい。ヴィラカスは比較的裕福な平民の出身で、コンスタンティンの助手である。コンスタンティンを崇拝していたため、彼の新聞社に応募し、助手として採用された。コンスタンティンの身の回りの世話をし、従順で、まるで忠犬のようなキャラクターであり、コンスタンティンに強く依存している。\n\n描いてみたい衣装は、お好きなものを自由に選んでください！（もしファンタジー風の設定がお好きなら、画像28の衣装を選んでみてください！もちろん、それ以外の衣装もすべて選択可能です！）\n\nもし金額が合わない場合は、再度リクエストを送っていただけると大変助かります！もしお手数であれば、そのままキャンセルしていただいても構いません。もし今回の依頼を引き受けていただけたら、本当に感謝します！\n\nhttps://drive.google.com/drive/folders/1mP_-_aYjvuPUdyoPB12Sek3bUxpMOry1?usp=share_link", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@E_GREENverde/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3899884, "client_id": 3616655, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/2111240f/uploads/origins/0789af7f-1d97-48bc-9ab6-186929840c8a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=02291588ba98b571a46463acbd18579f", "srcset": "https://si.imgix.net/2111240f/uploads/origins/0789af7f-1d97-48bc-9ab6-186929840c8a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=02291588ba98b571a46463acbd18579f, https://si.imgix.net/2111240f/uploads/origins/0789af7f-1d97-48bc-9ab6-186929840c8a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=368a6825fa70c168a715569e17c432fd 2x, https://si.imgix.net/2111240f/uploads/origins/0789af7f-1d97-48bc-9ab6-186929840c8a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c7104292381f83575aed6cecdd2ed5c8 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/2111240f/uploads/origins/0789af7f-1d97-48bc-9ab6-186929840c8a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=1f25248622e9da990e57470f2078b568", "srcset": "https://si.imgix.net/2111240f/uploads/origins/0789af7f-1d97-48bc-9ab6-186929840c8a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=1f25248622e9da990e57470f2078b568, https://si.imgix.net/2111240f/uploads/origins/0789af7f-1d97-48bc-9ab6-186929840c8a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=59c242bf40d4a71f6ee16817f532635b 2x, https://si.imgix.net/2111240f/uploads/origins/0789af7f-1d97-48bc-9ab6-186929840c8a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=f39b84928a712677af32f4a1c7f940a5 3x"}, "body": "先生、こんにちは。\n私は小紅書で先生の作品を拝見し、とても感動しました。\nそこで、恐れ入りますが、私の4人のオリジナルキャラクターのイラストを描いていただけないかと思い、申請させていただきました。\n彼らは終末的な平行世界の探検チームです：\n🦊 男性 / 176cm\n本来は絶滅すべき古代種の子孫で、滅亡前の記憶を失っています。\n現在はこの荒廃した世界を離れ、憧れの本来の世界へ向かうことを目的に旅をしています。\n🦈 男性 / 187cm\n🦊の最初の仲間で、本来の世界から来た忠実なパートナーです。\n🪽 女性 / 154cm\n同じく本来の世界から来た、優しく博識な人物ですが、旅の途中で姿を消してしまいました。\n🦉 男性 / 172cm\n🦊が記憶を失える前の友人で、同じく古代種の特徴を持っています。\nしかしその関係を隠してチームに加わり、目的は不明です。\nキャラクターの外見や詳細な要望はフォルダ内でご覧いただけます。\nまた、キャラクターの固有色に厳密に従う必要はありません。\nもし金額が合わない場合は、遠慮なく再提示していただいて構いません。\nお読みいただき、ご検討いただけますと幸いです。\n\nhttps://drive.google.com/drive/folders/1H3mf6-DZOOfahb2YFd6kh6WZCd6dz7HS", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 672778, "creator": true, "nsfw_acceptable": false, "acceptable": false, "name": "souma🌴", "screen_name": "log_souma", "avatar_url": "https://pbs.twimg.com/profile_images/1300271157891850240/F5hpI26C.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1299620695417131013/1656774680/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 10, "complete_expiration_days": 60, "skills": [{"genre": "art"}, {"genre": "correction"}], "banned": false, "nc": 0}, {"id": 1057632, "creator": true, "nsfw_acceptable": false, "acceptable": false, "name": "07", "screen_name": "sobakonattou07", "avatar_url": "https://pbs.twimg.com/profile_images/1844812683226619904/4AKjeuiK.jpg", "header_url": "https://pbs.twimg.com/profile_banners/2552540090/1728678149/1500x500", "appeal_receivable": true, "popular_creator_rank": 14, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "art"}], "banned": false, "nc": 176}, {"id": 1519306, "creator": true, "nsfw_acceptable": true, "acceptable": true, "n