ss&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=3e136a7dd483cff2cd637db9dbca4c13 3x"}, "private": true, "genre": "art", "tipped": false, "creator_id": 2789311, "nc": 128}, {"path": "/@yaruhu_keki/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2789311, "client_id": 1427325, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/7c813878/uploads/origins/f53ddd19-f491-4607-b0bc-b3969dcd439c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5644b80751c483250fe16c43e164fd60", "srcset": "https://si.imgix.net/7c813878/uploads/origins/f53ddd19-f491-4607-b0bc-b3969dcd439c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5644b80751c483250fe16c43e164fd60, https://si.imgix.net/7c813878/uploads/origins/f53ddd19-f491-4607-b0bc-b3969dcd439c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=951b5a0520ac70360ad0c751d0fe8493 2x, https://si.imgix.net/7c813878/uploads/origins/f53ddd19-f491-4607-b0bc-b3969dcd439c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=1fe6891c8bca8daf9cc37bdd3a9699a0 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/7c813878/uploads/origins/f53ddd19-f491-4607-b0bc-b3969dcd439c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=21bcf120d5ddc8f13c1f9befb16d9724", "srcset": "https://si.imgix.net/7c813878/uploads/origins/f53ddd19-f491-4607-b0bc-b3969dcd439c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=21bcf120d5ddc8f13c1f9befb16d9724, https://si.imgix.net/7c813878/uploads/origins/f53ddd19-f491-4607-b0bc-b3969dcd439c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=782b1257d04c8d7515901f260c5dca19 2x, https://si.imgix.net/7c813878/uploads/origins/f53ddd19-f491-4607-b0bc-b3969dcd439c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=2ef01c047293320ee79ae6148168d60e 3x"}, "body": "怪文書失礼します。カスタムキャストで作成したオリジナルキャラクターのイラストを描いていただけますととても喜びます。\n\n名前:秕(しいな、シイナ)\nうまく実らないで萎びた種のない果実、中身がなく意味のない籾という意味です。\n\n性別:女\n年齢:たぶん10代\n概要:どこかの偉い人(モブ俺)が飼育している、獣人の女の子です。太めの眉毛・ふわふわの髪の毛・光があんまりない目・丸いフェイスライン・茶色い犬の尻尾が特徴的です。\n耳は邪魔なので切り落とされました。\n\n飼育の鑑別票として、おへそにはピアスが開けられています。また、黒い首輪を付けられています。\n痩せ型の体型ですが、栄養失調気味のためお腹が少しふっくらしています。\n\n人間と同等の知能を持っていますが、喋ると飼い主にとても怒られるので、基本的には静かに過ごしています。普段は脱走防止のため黒い下着以外の衣類は与えられていません。時々散歩と称して、どこかへ連れて行かれます。\n犬小屋と呼ばれる半地下室で暮らしており、天井の模様を見ること、風の音を聞くことで暇を潰して生きています。\n\n学校という場所があって、そこはとても楽しいと聞いたことがあります。ぼんやりと「学校ってところに行ってみたいなあ」と憧れています。\n\nイラストのシチュエーション:飼い主の会食(裏社会っぽい会合、立食パーティー、晩餐会、舞踏会的な… 獣人とか家畜とか人権のない生命を連れていってても「良いペットですね〜笑」で済む感じのやつ)\nに連れて行かれた秕が、誰かとお話ししている飼い主の近くで壁を背にしてじっとしている・ぼんやりしている・少し俯いている姿を描いて欲しいです。椅子に座っていても立っていてもどちらでも良いです。\n\n普段すごす犬小屋できせられている黒い下着とは異なり、ドレスなどの綺麗なお洋服を着せられていて、会食のような場面に相応しい見た目をしていてほしいです。\nアクセサリーをつけられていたり、頭にボンネットが載っていても良いです。\n首輪は付けていますが、服やリボンなどで隠れていても構いません。\n\n表情は参考資料のような気だるげ・諦めの表情でお願いしたいです…！\n\n飼い主の顔は映さないでほしい(画面に登場してなくても良いぐらい、なぜならモブ俺が飼い主だから)です…！\n\nhttps://drive.google.com/drive/folders/1--XMVQToswuS4VDvtg9mKjzOlODyC15N", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@yaruhu_keki/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2789311, "client_id": 2069665, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/7fa076d2/uploads/origins/34a859d4-07a5-4861-b809-c742fa593814?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2a5f21e6b3d38dbe829fc40429071ad4", "srcset": "https://si.imgix.net/7fa076d2/uploads/origins/34a859d4-07a5-4861-b809-c742fa593814?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2a5f21e6b3d38dbe829fc40429071ad4, https://si.imgix.net/7fa076d2/uploa