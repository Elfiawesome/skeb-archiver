88-2c88f9f0819e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f5a79450baf81008b5748694aef0b516, https://si.imgix.net/d2c43c34/uploads/origins/380ceb4a-8252-4100-b988-2c88f9f0819e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=419f671d15543acc875dddb2144c04f4 2x, https://si.imgix.net/d2c43c34/uploads/origins/380ceb4a-8252-4100-b988-2c88f9f0819e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=16e26a80924b2cfb065d070e75d4ba18 3x"}, "body": "運動会などの「用意ドン」のピストルを撃つ女子の絵をお願いしたいです。\n大きな音が怖くて必死に耳をふさぎ、泣きながらピストルを「バン！」と鳴らすイメージです。\n以下、参考画像です。\ntps://twitter.com/restartk1006/status/1535393799316570112\n（左の画像がベストです）\n衣装はブルマを希望ですが、体育系の書描きやすいものでOKです。\n金額的に厳しければ背景は不要か、適当なものでよいです。\nピストル本体もフレームアウトせず描いてください。\n\n女子は特に指定のキャラはありませんので、描きやすいキャラでOKです。\nもし指定が必要であれば、エヴァの真希波マリにしてほしいです。\n\nhttps://twitter.com/restartk1006/status/1535393799316570112", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Dasuku8/works/10", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 613677, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/290ba781/uploads/origins/8493f15f-3b4c-4276-9662-cc121093dc3b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=513e566f860f03f715a1f380d4af07f9", "srcset": "https://si.imgix.net/290ba781/uploads/origins/8493f15f-3b4c-4276-9662-cc121093dc3b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=513e566f860f03f715a1f380d4af07f9, https://si.imgix.net/290ba781/uploads/origins/8493f15f-3b4c-4276-9662-cc121093dc3b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=585911b36c3ff43f8d88c7d54fe2ded4 2x, https://si.imgix.net/290ba781/uploads/origins/8493f15f-3b4c-4276-9662-cc121093dc3b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d898fe41b0a4f11e62cf399b2cdea923 3x"}, "duration": null, "nsfw": true, "hardcore": true, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/290ba781/uploads/origins/8493f15f-3b4c-4276-9662-cc121093dc3b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9be91f1fd1a9e0d8ca22b3904186f927", "srcset": "https://si.imgix.net/290ba781/uploads/origins/8493f15f-3b4c-4276-9662-cc121093dc3b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9be91f1fd1a9e0d8ca22b3904186f927, https://si.imgix.net/290ba781/uploads/origins/8493f15f-3b4c-4276-9662-cc121093dc3b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=3ad3f91234b35269079ef2f5d67890b1 2x, https://si.imgix.net/290ba781/uploads/origins/8493f15f-3b4c-4276-9662-cc121093dc3b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=a8ea4520639e11471f9dbefabadeb5e8 3x"}, "body": "https://skeb.jp/@Dasuku8/works/8\n\nこちらのシチュエーションのイラストを少女☆歌劇レヴュースタァライトの天堂真矢(https://revuestarlight.boom-app.wiki/entry/chara-4)　で描いてほしいです。\n内容は一部変更して、靴下と靴のみ履いた全裸姿で拘束。脱がされた制服は足元に散乱。下着は金網に引っ掛けて標本のように飾られている。下着の色は白か黒にして下さい。\n\n以上です。\nご検討のほどよろしくお願いします。", "nc": 58, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Dasuku8/works/9", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 613677, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/13d67cf9/uploads/origins/c99b7f17-ed3d-4728-9d74-831429a3d8b5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5e151e25cebfec9088e3f03d5666bbbb", "srcset": "https://si.imgix.net/13d67cf9/uploads/origins/c99b7f17-ed3d-4728-9d74-831429a3d8b5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5e151e25cebfec9088e3f03d5666bbbb, https://si.imgix.net/13d67cf9/uploads/origins/c99b7f17-ed3d-4728-9d74-831429a3d8b5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=0346aa5ac41ebf8a086786f730663b10 2x, https://si.imgix.net/13d67cf9/uploads/origins/c99b7f17-ed3d-4728-9d74-831429a3d8b5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=71231677bc52abbc284f032833371003 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/13d67cf9/uploads/origins/c99b7f17-ed3d-4728-9d74-831429a3d8b5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c397009db8104ba34b951c87e65582c5", "srcset": "https://si.imgix.net/13d67cf9/uploads/origins/c99b7f17-ed3d-4728-9d74-831429a3d8b5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c397009db8104ba34b951c87e65582c5, https://si.imgix.net/13d67cf9/uploads/origins/c99b7f17-ed3d-4728-9d74-831429a3d8b5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=a5d681b1f16c15be6417da2a589ab360 2x, https://si.imgix.net/13d67cf9/uploads/origins/c99b7f17-ed3d-4728-9d74-831429a3d8b5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=b9db86aacf9749da509e2d8886b770b0 3x"}, "body": "昔のアニメの『獣神ライガー』30話のゲストキャラ、アキさんの絵をリクエストします。シチュは『強風で初登場時の半袖テニスウェアのスカートが舞い上がって、前面にフリルの無いシンプルなデザインの白アンスコが丸見えになっているけど、気にせずに両手を後ろにまわして両目を開けた笑顔をこちらに向けている』でお願いします。膝のあたりまで見えるように描いてほしいです。背景は屋外だと分かるごく簡易な物で結構です。獣神ライガーはバンダイチャンネル等で視聴できるので、よろしければご覧になってください。", "nc": 161, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Dasuku8/works/8", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 613677, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/40bd58ec/uploads/origins/4d196dd5-9472-490d-ba32-d50f54db0958?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d90069dc64f85c6f4dd335979616dbbb", "srcset": "https://si.imgix.net/40bd58ec/uploads/origins/4d196dd5-9472-490d-ba32-d50f54db0958?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d90069dc64f85c6f4dd335979616dbbb, https://si.imgix.net/40bd58ec/uploads/origins/4d196dd5-9472-490d-ba32-d50f54db0958?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=15262149dafc841fb1363e6d439c9f1f 2x, https://si.imgix.net/40bd58ec/uploads/origins/4d196dd5-9472-490d-ba32-d50f54db0958?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d3fc1aa9fd939476e305accb5c6cd6d7 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/40bd58ec/uploads/origins/4d196dd5-9472-490d-ba32-d50f54db0958?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=92b82cd600d806becc4a1272c3b569f9", "srcset": "https://si.imgix.net/40bd58ec/uploads/origins/4d196dd5-9472-490d-ba32-d50f54db0958?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=92b82cd600d806becc4a1272c3b569f9, https://si.imgix.net/40bd58ec/uploads/origins/4d196dd5-9472-490d-ba32-d50f54db0958?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=9b0a9d6dfa7f1bad37d5136bd68b2b6d 2x, https://si.imgix.net/40bd58ec/uploads/origins/4d196dd5-9472-490d-ba32-d50f54db0958?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=ee5296b2bc25415b145380566b4f3a80 3x"}, "body": "かぐや様は告らせたいの早坂愛が、人気が無い金網フェンスのところを歩いていたら暴漢が現れて、制服とパンツ、腰巻き(コート)を奪われて股間のアソコが丸見えになり、両手に手錠(大人のおもちゃ)をかけてその隙間に自転車のチェーンロックを潜らせて金網フェンスの高いところに固定されてしまったイラストをお願いします。\n早坂の髪型はサイドテール版とショートカット版両方をお願いします。\n早坂は上半身は服(Yシャツ)一枚(勿論ブラはしてます)着ていますが下半身がアソコが丸見えの状態です。\nショートカット版は制服を奪ったあとYシャツを着せられてボタンも全部もきっちり止められている設定です。サイドテール版のYシャツをショートカット版が全く同じで着ているものと思ってもらっていいです。\nチェーンロックが高いところに固定されたため早坂はしゃがむことは出来ません。カバンは下に置かれました。\n因みに暴漢はパンツを奪った後早坂のその様子をビデオカメラ(高画質)で撮影してますが、暴漢は描かなくていいです。暴漢がいても需要ないから(というか不快)\n早坂は股間のアソコを隠せず、ワレメから蜜(ガマン汁？)がたらたらと出てくるところを見られてとても恥ずかしくて泣いてしまった表情もお願いします。この時のワレメはほんの僅かに綻び(開いている)感じでお願いします。\n早坂の姿は全身写っているのを希望。脚はほんの少しだけ開いています。\n股間はツルツルではなく年相応に生えている感じでお願いします。\nまた股間の修正はモザイク処理でお願いします。修正箇所(恐らくワレメ)以外はモザイク処理しないようギリギリのところまでお願いします。\n差分で風のいたずらの時に描いた純白パンツを履いているものもお願いします。パンツは股間のワレメに食い込んでいて、ほんの僅かに蜜(ガマン汁)でパンツが濡れています。\nサイドテール版とショートカット版両方の股間のアソコが丸見えと純白パンツの差分。合計4枚お願いします。", "nc": 185, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Dasuku8/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 613677, "client_id": 32701, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/b149a77e/uploads/origins/b9b008ae-22ea-447d-8377-84600879ba4a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=602e4a0ec3b2f18d35db1b63c28f0220", "srcset": "https://si.imgix.net/b149a77e/uploads/origins/b9b008ae-22ea-447d-8377-84600879ba4a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=602e4a0ec3b2f18d35db1b63c28f0220, https://si.imgix.net/b149a77e/uploads/origins/b9b008ae-22ea-447d-8377-84600879ba4a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=fb948eaf0dba40bcd87bf9df241e1a51 2x, https://si.imgix.net/b149a77e/uploads/origins/b9b008ae-22ea-447d-8377-84600879ba4a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=6ba76f5f026f51c95061b07faf029623 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/b149a77e/uploads/origins/b9b008ae-22ea-447d-8377-84600879ba4a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=221be6fdd8910ccb209d765ff54e7754", "srcset": "https://si.imgix.net/b149a77e/uploads/origins/b9b008ae-22ea-447d-8377-84600879ba4a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=221be6fdd8910ccb209d765ff54e7754, https://si.imgix.net/b149a77e/uploads/origins/b9b008ae-22ea-447d-8377-84600879ba4a?bg=%23fff&auto=format%2Ccomp