&w=200&h=200&blur=200&s=7c3bd8e8a6d692248a8ba97abf1d4a62 3x"}, "body": "初めまして。いつも切り抜き等楽しみに拝見しております。\n\nリクエストなのですが、にじさんじのアンジュ・カトリーナさんのイラストをお願いしたいです。\n\n使用用途としては、twitterのヘッダーとして使いたいと考えています。使用できるようなイラストであれば嬉しく思います。\n\n衣装や髪型、ポージングや等身などについてはお任せします。\nリクエスト自体に慣れていないため、入力事項に不備等あったら申し訳ございません。\nご検討よろしくお願いします。", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@starbowhalo/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 551313, "client_id": 1448920, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/1e9880ee/uploads/origins/7e2371bb-610e-45a8-af3c-160369559b13?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3d9d302f0c7a1561634d310823af1a27", "srcset": "https://si.imgix.net/1e9880ee/uploads/origins/7e2371bb-610e-45a8-af3c-160369559b13?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3d9d302f0c7a1561634d310823af1a27, https://si.imgix.net/1e9880ee/uploads/origins/7e2371bb-610e-45a8-af3c-160369559b13?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=bc5621b9b20ff3d56088c6b41f986afc 2x, https://si.imgix.net/1e9880ee/uploads/origins/7e2371bb-610e-45a8-af3c-160369559b13?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c31cfbeeea6929218e61c4d6e0853059 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/1e9880ee/uploads/origins/7e2371bb-610e-45a8-af3c-160369559b13?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e5d43518ce9c87fd586d7c1cdfa688b1", "srcset": "https://si.imgix.net/1e9880ee/uploads/origins/7e2371bb-610e-45a8-af3c-160369559b13?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e5d43518ce9c87fd586d7c1cdfa688b1, https://si.imgix.net/1e9880ee/uploads/origins/7e2371bb-610e-45a8-af3c-160369559b13?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=2b83edc1763abe85dbd97f61c894c4aa 2x, https://si.imgix.net/1e9880ee/uploads/origins/7e2371bb-610e-45a8-af3c-160369559b13?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=46e9ffbe97463e41e05f4459cb5fd242 3x"}, "body": "はじめまして。いつも切り抜き楽しませていただいています。\nリクエストですが、フォニイをイメージしたアンジュ・カトリーナさんのイラストをお願いします。\nイラストはTwitterおよびYouTubeで使用させていただきたいです。\n\nツキミさんの曲フォニイのポーズをしているアンジュのイラストをお願いします。\n仮面はポケモンアルセウス内でアンジュが使用しているのろいぎつねのお面、\n衣装はゲーム内の服ではなく、アンジュの通常衣装・夏服・ドレス・白衣のどれかで、Sさんが雰囲気に合っていると思われるものでお願いします。\n仮面をつけている状態とつけていない状態の差分をお願いしたいのですが、\n差分がない場合は、仮面を持って顔を半分隠しているようなイメージでお願いします。\nアンジュのかわいさとかっこよさがわかるイラストをお願いします。\n\nのろいぎつねの面のシーン\nhttps://youtu.be/5n1XE_KHeu0?t=9661\n\ntwitterのヘッダーおよびアイコンとyoutubeのアイコンとして使用させていただきます。\nアイコンとして使う際には顔が大きく表示されるように切り抜かせていただくと思います。\nもちろんSさんが書かれたことを明記いたします。\n\nよろしくお願いします。", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@starbowhalo/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 551313, "client_id": 181518, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/9dfaf3cf/requests/232792_1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=085417478c27a896a4d8e968bbc7dd48", "srcset": "https://si.imgix.net/9dfaf3cf/requests/232792_1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=085417478c27a896a4d8e968bbc7dd48, https://si.imgix.net/9dfaf3cf/requests/232792_1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ab586cb16002d498c586a7b858e0e625 2x, https://si.imgix.net/9dfaf3cf/requests/232792_1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=48689caec86ac277543a1c3b5a70f63b 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/9dfaf3cf/requests/232792_1?bg=%