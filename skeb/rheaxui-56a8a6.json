eptable_same_genre": true}, {"path": "/@rheaxui/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 4059340, "client_id": 3420752, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/b5d23114/uploads/origins/49af581d-9de4-41b0-9b5c-80bacded1d81?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1d1a4444c9310facdf0a460e1239684e", "srcset": "https://si.imgix.net/b5d23114/uploads/origins/49af581d-9de4-41b0-9b5c-80bacded1d81?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1d1a4444c9310facdf0a460e1239684e, https://si.imgix.net/b5d23114/uploads/origins/49af581d-9de4-41b0-9b5c-80bacded1d81?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=d8c5ddd7603f184d564a7524d0f9a31e 2x, https://si.imgix.net/b5d23114/uploads/origins/49af581d-9de4-41b0-9b5c-80bacded1d81?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=94b648c2b07db277cffc66a49dae27ac 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/b5d23114/uploads/origins/49af581d-9de4-41b0-9b5c-80bacded1d81?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d61afa4ca70e017e8381dd2be66a940e", "srcset": "https://si.imgix.net/b5d23114/uploads/origins/49af581d-9de4-41b0-9b5c-80bacded1d81?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d61afa4ca70e017e8381dd2be66a940e, https://si.imgix.net/b5d23114/uploads/origins/49af581d-9de4-41b0-9b5c-80bacded1d81?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=97a80a6e631ae0a6cd5d00940d9228e8 2x, https://si.imgix.net/b5d23114/uploads/origins/49af581d-9de4-41b0-9b5c-80bacded1d81?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=7db4fa6d07579d213e70e408aa3748d8 3x"}, "body": "初めまして\nVTuberをしております、雨路ちゃぷと申します。\n\nXにてrhea様のイラストを拝見させて頂きました。\nスク水の質感に一目惚れし、是非わたしのキャラクターのイラストを描いて頂きたく、この度リクエストさせていただきました。\n\n依頼内容\nわたし、雨路ちゃぷのイラストをお願いいたします。\n構図はお任せします。\nセーラースク水を着せてもらえると嬉しいです。\n\n資料に加え、詳細設定を箇条書きにて補足します。\n・インナーは旧スクール水着\n・オーバーサイズのレインコートで、水の波紋のような模様がある\n（多少簡略化していただいても問題ありません）\n・スカートの質感は通常の布から徐々に水(液体)になっていっている\n・身長は142cmで、脚はむっちりしている\n\n以上です。\n\n\n使用用途\n・Youtube活動（サムネイルや配信内、アイコンヘッダー等）\n・X等SNS活動（投稿、アイコン、ヘッダー等）\n上記二つとも収益化予定です。\n・グッズ作成での利用\n（不可の場合はリクエストキャンセルください）\n\n\nそれでは、お忙しいところ恐れ入りますが、どうぞご検討お願いいたします。\n\nhttps://drive.google.com/drive/folders/117L53H3GiQRhQAoqLeLls5DeWUUik6Wj", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@rheaxui/works/5", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/f922ae37/uploads/origins/3e8b9f93-c84d-4d41-8213-889432d1a3d3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=0d1ffe493d9581ef745cbd0d51da9fcb", "srcset": "https://si.imgix.net/f922ae37/uploads/origins/3e8b9f93-c84d-4d41-8213-889432d1a3d3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=0d1ffe493d9581ef745cbd0d51da9fcb, https://si.imgix.net/f922ae37/uploads/origins/3e8b9f93-c84d-4d41-8213-889432d1a3d3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=3b6f89752aedcff99535a595c312f243 2x, https://si.imgix.net/f922ae37/uploads/origins/3e8b9f93-c84d-4d41-8213-889432d1a3d3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=030dcae57ca241add00a79db408490a4 3x"}, "private": true, "genre": "art", "tipped": true, "creator_id": 4059340, "client_id": 3869043, "nc": 1}, {"path": "