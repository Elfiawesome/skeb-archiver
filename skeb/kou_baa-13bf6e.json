tube.com/watch?v=cOeQiUmjsmE", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@kou_baa/works/30", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 269249, "client_id": 1621777, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/336c8656/uploads/origins/9ecb616d-e351-46d7-a52e-c88af7f82dd7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=880f2fdae63614e9cc7969ced0cff5f8", "srcset": "https://si.imgix.net/336c8656/uploads/origins/9ecb616d-e351-46d7-a52e-c88af7f82dd7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=880f2fdae63614e9cc7969ced0cff5f8, https://si.imgix.net/336c8656/uploads/origins/9ecb616d-e351-46d7-a52e-c88af7f82dd7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=803eae86efb409739c57bfb3e60ef65c 2x, https://si.imgix.net/336c8656/uploads/origins/9ecb616d-e351-46d7-a52e-c88af7f82dd7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=09fe6d2e6fdc10a601a36d4ea427e19d 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/336c8656/uploads/origins/9ecb616d-e351-46d7-a52e-c88af7f82dd7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0a529426d93801e9f780a0b8a63e1c51", "srcset": "https://si.imgix.net/336c8656/uploads/origins/9ecb616d-e351-46d7-a52e-c88af7f82dd7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0a529426d93801e9f780a0b8a63e1c51, https://si.imgix.net/336c8656/uploads/origins/9ecb616d-e351-46d7-a52e-c88af7f82dd7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=e7a0c98fa1c1ca9e36591c5da9968912 2x, https://si.imgix.net/336c8656/uploads/origins/9ecb616d-e351-46d7-a52e-c88af7f82dd7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=1b576484a91753009731676a03f3553a 3x"}, "body": "こんばんは。\n先日は素敵なイラストをありがとうございました。\n再びリクエストさせていただきます。\n\nこうば様が８月３日に描かれたオリジナルキャラクター(フタマキさんで合ってますでしょうか)がかわいかったので、その子をお願いします。\nhttp://ffkaiura.sakura.ne.jp/202383a.jpg\n服装は、オーバーオールを着せてほしいです。\nケモ度は上記８月３日のイラストと同じくらいで、その他の構図等はお任せします。\n\n以上です。よろしくお願いいたします。", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@kou_baa/works/29", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 269249, "client_id": 2055516, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/e3faeef4/uploads/origins/9a787e5e-ce32-4722-b084-70eda78aa2c3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8bad44ffa07d21ef0b2e2ab7e23e4cf6", "srcset": "https://si.imgix.net/e3faeef4/uploads/origins/9a787e5e-ce32-4722-b084-70eda78aa2c3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8bad44ffa07d21ef0b2e2ab7e23e4cf6, https://si.imgix.net/e3faeef4/uploads/origins/9a787e5e-ce32-4722-b084-70eda78aa2c3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=616f09937e487fe7eaff67ae3ff23121 2x, https://si.imgix.net/e3faeef4/uploads/origins/9a787e5e-ce32-4722-b084-70eda78aa2c3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=36bb138489747d76c57d31fa989f26c3 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/e3faeef4/uploads/origins/9a787e5e-ce32-4722-b084-70eda78aa2c3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=bca228eb2230ee4e7e53615b6fdbfd77", "srcset": "https://si.imgix.net/e3faeef4/uploads/origins/9a787e5e-ce32-4722-b084-70eda78aa2c3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=bca228eb2230ee4e7e53615b6fdbfd77, https://si.imgix.net/e3faeef4/uploads/origins/9a787e5e-ce32-4722-b084-70eda78aa2c3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=92a5ac31b27c974ea9c33b9f2497b072 2x, https://si.imgix.net/e3faeef4/uploads/origins/9a787e5e-ce32-4722-b084-70eda78aa2c3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=2ceb195c22a5538f4c6ac022db5e94b5 3x"}, "body": "こうば先生　はじめまして\nTwitterにて先生の素敵なイラストを拝見し、是非ご依頼したいと思いリクエストをお送りしました\n\nご依頼したいイラストですが、個人勢Vtuberのブールド＝ネージュ・モカ＝ブランシェさんのファンアートを描いて頂きたいです\n\nガイドラインより、Skebで依頼しても良いことを確認しています\nhttps://mokablanche511.wixsite.com/moka-blanche/%E3%82%AC%E3%82%A4%E3%83%89%E3%83%A9%E3%82%A4%E3%83%B3\n\nイラストの内容ですが\nふわふわ優しい性格の方で異世界出身という設定なので、のどかな場所でティータイムを過ごしているイラストをお願いします\n\n詳細については\n・ポーズや背景その他については、全てお任せいたします\n・可能であれば、肩に乗っているハリネズミのキャラ(使い魔のラテくん)もイラストに取り込んでいただけると嬉しいです\n・本人が活動で使用出来るように通常のイラストに加えて、サイン、コメントがないバージョンの作成又は、レイヤーを分けていただけると幸いです\n・納品後Skebの「印刷してお届け」を使用することを考えています。システムの仕様上、納品されたイラストのみ印刷可能なので、お手数ですがPSD内差分だけではなくメッセージなどがないイラストの納品もお願いします\n\n※ファンアートは本人の配信のサムネイルなど、活動で使用される可能性があります※\n使用される場合、本人にクレジット表記(著作者名,TwitterID)などを明記するように申し伝えます\n\n上記についてご留意いただき、ご判断よろしくお願いします\n\n本人イラスト\nhttps://twitter.com/moka_blanche/status/1426820747100524545\nhttps://twitter.com/moka_blanche/status/1430859933524836354\n\nGoogleドライブ(内容は上記リンクと同じものです、Twitterの不具合に備えてお送りします)\nhttps://drive.google.com/drive/folders/1kxloBVuWAVZSB3pWx6_hODPaeTPChxAu?usp=sharing", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@kou_baa/works/28", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 269249, "client_id": 1765701, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/9586fa9c/uploads/origins/ed12ad57-2518-4220-974e-e4abf9fe19b7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5ec95147101c777efc35853276c4d1c2", "srcset": "https://si.imgix.net/9586fa9c/uploads/origins/ed12ad57-2518-4220-974e-e4abf9fe19b7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=