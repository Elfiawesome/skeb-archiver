crop&crop=top&w=200&h=200&s=6bcfcfa92370213ad5fdb9c5a1ff913b, https://si.imgix.net/7c574eea/uploads/origins/82cae8a9-cee0-43fa-9376-4afdc3c84e0b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=39a10008f4f97b59d71981f15c574ec0 2x, https://si.imgix.net/7c574eea/uploads/origins/82cae8a9-cee0-43fa-9376-4afdc3c84e0b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=05aa8f11a10593c739705c39df7a2138 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/7c574eea/uploads/origins/82cae8a9-cee0-43fa-9376-4afdc3c84e0b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6ac76af246cc6c7135ebc2dc2439461a", "srcset": "https://si.imgix.net/7c574eea/uploads/origins/82cae8a9-cee0-43fa-9376-4afdc3c84e0b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6ac76af246cc6c7135ebc2dc2439461a, https://si.imgix.net/7c574eea/uploads/origins/82cae8a9-cee0-43fa-9376-4afdc3c84e0b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=850d2d09ec74bf8d30bd7914e5eddc4e 2x, https://si.imgix.net/7c574eea/uploads/origins/82cae8a9-cee0-43fa-9376-4afdc3c84e0b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=433e7f030d2163720f6defcf4f5f0328 3x"}, "body": "はじめまして。\nいつもXにてイラストを拝見しております。\nリクエストは、デュエル・マスターズプレイスより、リュミエのイラストとなります。\nリュミエが光文明のマスター候補生として凛々しく戦っている場面を描いてください。\n具体的な構図などはお任せ致します。マバユキをはじめとしたメタリカ達をしている場面でも、カードを構えている姿でも構いません。リュミエをメインとしたイラストをお願い致します。\nPCの壁紙として使用したいと思いますので、16:9で描いていただけるとありがたいです。\nなお資料にある衣装設定画や表情集は、先日のデュエプレフェス2026にて公開されていた資料の直撮りのため見づらいかと思いますが、ご了承ください。\n恐れ入りますが、ご検討のほど、宜しくお願い致します。\n\nhttps://imgur.com/a/xK0yU5z", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@sudooou8160/works/10", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 33