mat%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=cb326d2c8d2997bebde23486679a77ef", "srcset": "https://si.imgix.net/4cff10f8/uploads/origins/75803dd0-b626-434c-acd0-3962d6648519?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=cb326d2c8d2997bebde23486679a77ef, https://si.imgix.net/4cff10f8/uploads/origins/75803dd0-b626-434c-acd0-3962d6648519?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=3d29daade610526bc22a0de38f0ec981 2x, https://si.imgix.net/4cff10f8/uploads/origins/75803dd0-b626-434c-acd0-3962d6648519?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=e6865caef94f0fd68f763edebce36ba9 3x"}, "body": "こんにちは、ツナマヨ先生。\n\n今回も相葉夕美の漫画をお願いしたいです。\n\n申し込もうとしている漫画の内容は夕美の1カット劇場である『夢の一つに』から取って、大企業の資本の違いを感じる夕美の漫画をリクエストします。\n\n漫画の流れとしては\n\n1. 夢見ていた花屋を開業できて喜んでいる夕美（花瓶を持っている）\n\n2. 「大変だ！」 叫びながら慌てて駆け寄るプロデューサーと周子\n\n3.反対側の道路にそれぞれ西園寺グループと櫻井グループ系列の花屋が入っているのを目撃\n\n(持っていた花瓶を落とす後ろ姿の夕美)\n(背景には桃華と琴歌の邪悪に笑う顔)\n\n4. 悲鳴を上げて目を覚ます夕美\n（Sレア『さやけき花の生命に』で着たパジャマ姿）", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@tsunamayoneez/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3617601, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/c28acefd/uploads/origins/ed5e57ab-380d-4105-ae78-153830c3786d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ba96637e5036243ea0efe4d3903d6996", "srcset": "https://si.imgix.net/c28acefd/uploads/origins/ed5e57ab-380d-4105-ae78-153830c3786d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ba96637e5036243ea0efe4d3903d6996, https://si.imgix.net/c28acefd/uploads/origins/ed5e57ab-380d-4105-ae78-153830c3786d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=dd983d8c405effcaa14c8acc1c333b72 2x, https://si.imgix.net/c28acefd/uploads/origins/ed5e57ab-380d-4105-ae78-153830c3786d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=7743a46cf4bfe5b2e12308444223e6e5 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/c28acefd/uploads/origins/ed5e57ab-380d-4105-ae78-153830c3786d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=150929defcec53649af547a87f2e30da", "srcset": "https://si.imgix.net/c28acefd/uploads/origins/ed5e57ab-380d-4105-ae78-153830c3786d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=150929defcec53649af547a87f2e30da, https://si.imgix.net/c28acefd/uploads/origins/ed5e57ab-380d-4105-ae78-153830c3786d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=2da6f18716ea6a501b32a31c493d0a96 2x, https://si.imgix.net/c28acefd/uploads/origins/ed5e57ab-380d-4105-ae78-153830c3786d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=e3c5e1d37b27a8f621e13bb5b32efe93 3x"}, "body": "ツナマヨ先生、いつも楽しくイラストを拝見させていただいています。\n\n僭越ながらリクエストをさせていただきます。\n\nデレマスの二宮飛鳥、多田李衣菜、輿水幸子、神谷奈緒、赤城みりあのイラストをお願いします。\n\n・Pが撮ってきた仕事で写真撮影をしている。\n・ポーズは何故か「北斗の拳イチゴ味」に登場する南斗DE5MENの決めポーズ。下に参考画像があるツイートのURLを添付しておりますが、見れない場合は、本文下のURLのサイトの一番下の画像が参考画像になります。\n・飛鳥がサウザーの立ち位置、ポーズ（参考画像の真ん中）\n・李衣奈がシンの立ち位置、ポーズ（飛鳥の左手側）\n・奈緒がレイの立ち位置、ポーズ（飛鳥の右手側、宙返りしてるポーズ）\n・みりあがシュウの立ち位置、ポーズ（奈緒の右手側、端）\n・幸子がユダの立ち位置、ポーズ（李衣奈の左手側、端）\n・ツナマヨ先生のいつものイラストの等身で、5人とも跳躍してポーズをとり写真を撮っている。仕事なので5人ともノリノリでポーズをとっている。\n・その後、イラストの下の方で5人とも困惑しながら、Pに対して飛鳥を中心に「この仕事何？」と聞いている。Pはとぼけて答えない。\n\nご一考いただけますと幸いです。何卒よろしくお願いします。\n\n（参考画像のあるサイトのURL）\nhttps://hokutosite.sakura.ne.jp/log/2015/log20151130.html\n\nhttps://x.com/anicobin/status/669246791368310784", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@tsunamayoneez/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "comic", "tipped": true, "creator_id": 3617601, "client_id": 2038243, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/902d79f5/uploads/origins/78fdd8c9-9c1e-475b-a4ab-ebf9f6ffe179?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=16a55262ab9cacebf293d109c17b07ea", "srcset": "https://si.imgix.net/902d79f5/uploads/origins/78fdd8c9-9c1e-475b-a4ab-ebf9f6ffe179?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=16a55262ab9cacebf293d109c17b07ea, https://si.imgix.net/902d79f5/uploads/origins/78fdd8c9-9c1e-475b-a4ab-ebf9f6ffe179?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=d3e4d9fa219be81049e047ccc0cfd0ce 2x, https://si.imgix.net/902d79f5/uploads/origins/78fdd8c9-9c1e-475b-a4ab-ebf9f6ffe179?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f3b829dd10b2ee38685b91803b02de6c 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/902d79f5/uploads/origins/78fdd8c9-9c1e-475b-a4ab-ebf9f6ffe179?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a0953ff0095bb18cb40a03e7ab1fd982", "srcset": "https://si.imgix.net/902d79f5/uploads/origins/78fdd8c9-9c1e-475b-a4ab-ebf9f6ffe179?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a0953ff0095bb18cb40a03e7ab1fd982, https://si.imgix.net/902d79f5/uploads/origins/78fdd8c9-9c1e-475b-a4ab-ebf9f6ffe179?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=7ea97d0c8dcccec46d79606b170066f5 2x, https://si.imgix.net/902d79f5/uploads/origins/78fdd8c9-9c1e-475b-a4ab-ebf9f6ffe179?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=56dacf507f97b356269d35c90ee141cd 3x"}, "body": "こんにちは。 \n\n相葉夕美の漫画をリクエストしたいです。\n\n内容としては、数日間続くスケジュール、事務所で夕美が大事にしていた花瓶を誰かが割るなどの理由でストレスゲージが溜まり続ける夕美だが、ずっとニコニコ笑っている様子。\n\nそんな数多くの吹き出しとともにどんどん積み重なっていく夕美のゲージ。\n\n夕美の限界ゲージが最後まで積もり、結局爆発して電灯を狂ったようにカチカチと鳴らしたり、ベッドの