ix.net/bc5615cb/uploads/origins/25631875-e5af-4fdf-b4e6-1e742bd3b867?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ef7f925b3de7ecf37a690d93bdae0b7f, https://si.imgix.net/bc5615cb/uploads/origins/25631875-e5af-4fdf-b4e6-1e742bd3b867?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=905b43537b00558d061d523689db00f3 2x, https://si.imgix.net/bc5615cb/uploads/origins/25631875-e5af-4fdf-b4e6-1e742bd3b867?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=5b0ff954d031156c7616580eadd850d7 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/bc5615cb/uploads/origins/25631875-e5af-4fdf-b4e6-1e742bd3b867?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=fc7ddb640966d3e2ff7ed987b9e91265", "srcset": "https://si.imgix.net/bc5615cb/uploads/origins/25631875-e5af-4fdf-b4e6-1e742bd3b867?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=fc7ddb640966d3e2ff7ed987b9e91265, https://si.imgix.net/bc5615cb/uploads/origins/25631875-e5af-4fdf-b4e6-1e742bd3b867?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=5a29f3122520fa0257c0b2c1acfbe6fc 2x, https://si.imgix.net/bc5615cb/uploads/origins/25631875-e5af-4fdf-b4e6-1e742bd3b867?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=ff8bb3208d500208b920cece83ed220e 3x"}, "body": "こんにちは。\n\nこの女の子(https://imgur.com/a/KgsA4i0)の姉にあたる新しいOCを描いていただきたいと思います。名前は「アリア」です。\n\n姉と同じ髪型をしていますが、青ではなく紫がかった髪をしています。\n彼女の目はクリムゾン色です。\n彼女の胸には光沢のある赤いダイヤモンド型のコアが埋め込まれています。そのコアは、側面を黒く覆っており、正面だけが露出しています。\n彼女は黒いロングケープのブレザーを着ており、その下には胸の谷間が見える白いシャツを着ています。\nまた、黒のタイトなレギンスに茶色のドレスシューズを履いています。\n\nクローン実験を行っている主要な科学者の多くと同様に、アリアも人間をこの世から消し去りたいと思うようになり、狂ってしまった。少なくとも、彼女は会話を維持することができる。\n彼女は自分が究極の存在であると信じており、超人的な強さを持ち、腕や足を変形させることができる。\n彼女は信じられないほど賢く、周囲の環境に適応することができる。\nそして何よりも、彼女はこの物語の究極の悪役なのです。彼女に悪役のような笑顔を見せてあげてください。\n\nありがとう", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@3walktoriatama/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 578666, "client_id": 505894, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/658ec48f/uploads/origins/7d2447f2-65bc-49f2-b8b2-ea62aa110407?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0a9cd0e979ec7214de8688630f142204", "srcset": "https://si.imgix.net/658ec48f/uploads/origins/7d2447f2-65bc-49f2-b8b2-ea62aa110407?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0a9cd0e979ec7214de8688630f142204, https://si.imgix.net/658ec48f/uploads/origins/7d2447f2-65bc-49f2-b8b2-ea62aa110407?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e54082717e3cf89ddf030237f60ca73f 2x, https://si.imgix.net/658ec48f/uploads/origins/7d2447f2-65bc-49f2-b8b2-ea62aa110407?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f45c8ba05ca1503fb5f16dcd73cfa643 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/658ec48f/uploads/origins/7d2447f2-65bc-49f2-b8b2-ea62aa110407?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b439d590ef844ce5a46115a296c83d0d", "srcset": "https://si.imgix.net/658ec48f/uploads/origins/7d2447f2-65bc-49f2-b8b2-ea62aa110407?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b439d590ef844ce5a46115a296c83d0d, https://si.imgix.net/658ec48f/uploads/origins/7d2447f2-65bc-49f2-b8b2-ea62aa110407?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=f31d5fb2b680074e3c6c6d379f9bfb87 2x, https://si.imgix.net/658ec48f/uploads/origins/7d2447f2-65bc-49f2-b8b2-ea62aa110407?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blu