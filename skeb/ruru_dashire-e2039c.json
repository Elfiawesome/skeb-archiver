l_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2919183, "client_id": 335424, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/85a78739/uploads/origins/3e1af13c-1d57-467e-aa59-b955287c01f8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8c6fe6e95e71420a6561f6b4cf296f93", "srcset": "https://si.imgix.net/85a78739/uploads/origins/3e1af13c-1d57-467e-aa59-b955287c01f8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8c6fe6e95e71420a6561f6b4cf296f93, https://si.imgix.net/85a78739/uploads/origins/3e1af13c-1d57-467e-aa59-b955287c01f8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=14ed3a4eb8e55f005d4d08c8b162d93d 2x, https://si.imgix.net/85a78739/uploads/origins/3e1af13c-1d57-467e-aa59-b955287c01f8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=33f22535e1aebf34f16b725ec80c2eda 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/85a78739/uploads/origins/3e1af13c-1d57-467e-aa59-b955287c01f8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f50cb33f672cc7f2ea179316f9b27528", "srcset": "https://si.imgix.net/85a78739/uploads/origins/3e1af13c-1d57-467e-aa59-b955287c01f8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f50cb33f672cc7f2ea179316f9b27528, https://si.imgix.net/85a78739/uploads/origins/3e1af13c-1d57-467e-aa59-b955287c01f8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=34bb1a07aeb6be181e766146507de70a 2x, https://si.imgix.net/85a78739/uploads/origins/3e1af13c-1d57-467e-aa59-b955287c01f8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=2d6cbb32b7f611e635aa1b9b92131841 3x"}, "body": "お世話になります\nシチュ一点勝負と言っておきながら恐縮ですが、\n前回の作品が大変素晴らしかったので、続き物としてまたお願いします！！ \n\n●概要\nhttps://skeb.jp/@ruru_dashire/works/9 \nこちらの巨女怪異「お母ちゃん（自称）」と、\n「坊ん」の「母子相姦」をお願いします \n\n●構図・背景\n基本的に前回と同じイメージ\n(髑髏は省略して頂いて構いません)\n\n前回と同じ様に射精時の断面図描写と、\nボテ腹が良く見える様に「坊ん」無しの構図差分があると嬉しいです\n\n●内容\n妊娠してボテ腹の「お母ちゃん」に中出し\n※中出しシーンが複数回あると嬉しいです\n\n前回の「魔封じの四つ玉」設定が大変刺さったので、\n今回は「鎮護国家」の「鎮」の封印が解けるターンでお願いします \n（さらにあと３回引っ張れそうな布石ということで）\n\n  「坊んの精力でお母ちゃんの力が強まる」\n 「封印の力を胎児に吸い取らせて排除する」\n「『鎮』の力を吸い取らせとるから、腹の子は命名『鎮子(ちんこ)』やなガハハ！！(怪異ジョーク)」\nなどなど、 \n封印解除と坊んの中出し・妊娠が設定的に関連付けられ、\n「母子相姦」がお母ちゃんの利益・目論見に繋がるような展開だとなお嬉しいです\n※上記設定はあくまでも一例なので、\n細かい内容や台詞回しはロストロン様にお任せします\n\n●巨女怪異「お母ちゃん」\n妊娠ボテ腹です\n妊娠しているので乳首の色はさらに濃い目に、\n乳輪も大きめに、母乳も出させて下さい\nそれ以外は基本的に前回と同じ\n\n●坊ん\n容姿や性器のサイズは前回と同じですが、\n性欲や射精量・回復力は強くなっています\n\n「お母ちゃん」の言葉を信じ切っており、\n祠に通い詰めて「母子相姦」漬けの毎日です\n完全に篭絡されています", "nc": 56, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@ruru_dashire/works/9", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2919183, "client_id": 335424, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/f0dce7f1/uploads/origins/52b027cf-0e72-4f16-a9bb-a7ac9e8ffa1c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=67defa2813b940afce39cd597038faaa", "srcset": "https://si.imgix.net/f0dce7f1/uploads/origins/52b027cf-0e72-4f16-a9bb-a7ac9e8ffa1c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=67defa2813b940afce39cd597038faaa, https://si.imgix.net/f0dce7f1/uploads/origins/52b027cf-0e72-4f16-a9bb-a7ac9e8ffa1c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ecbce84ce683c0d15025a2c50758d4a3 2x, https://si.imgix.net/f0dce7f1/uploads/origins/52b027cf-0e72-4f16-a9bb-a7ac9e8ffa1c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=42968568ab06d1ba89511f2f9ba75222 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/f0dce7f1/uploads/origins/52b027cf-0e72-4f16-a9bb-a7ac9e8ffa1c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=7f3031b3d5e9256f1c260525742615d1", "srcset": "https://si.imgix.net/f0dce7f1/uploads/origins/52b027cf-0e72-4f16-a9bb-a7ac9e8ffa1c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=7f3031b3d5e9256f1c260525742615d1, https://si.imgix.net/f0dce7f1/uploads/origins/52b027cf-0e72-4f16-a9bb-a7ac9e8ffa1c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=d5d7f77f36297a4b8ba0010344cbb9bb 2x, https://si.imgix.net/f0dce7f1/uploads/origins/52b027cf-0e72-4f16-a9bb-a7ac9e8ffa1c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=6a5e6b54dc0265e6f6f553111fa149b2 3x"}, "body": "お世話になります\n今回は妄想シチュ１点勝負でお願いします\n\n●概要\n・巨女怪異\n・精通\n・「お前あの祠に入ったんか！？」\n\n村の祠に封印されている巨女怪異に誘惑され、精通を捧げてしまうショタ\n\n●構図\nhttps://skeb.jp/@dokukasa/works/52\n\n他の方へのリクエストでの例示で恐縮ですが、こんな感じのイメージです\n\n・巨女怪異\n両手両足を広げ、M字開脚の大股開きで高速固定されています\n\n・少年\n正面からしがみつき、膣に挿入・精通射精している\n\n●巨女怪異\n・外見\n和風の衣装を半脱ぎにした巨女\n身長２～３ｍくらい\n\n参照では爪が映えた人外ですが、\nもっと普通の人体寄りにして下さい\n\n黒髪のロング\n顔立ちは目を細めに、ニヤニヤ笑い\n左目尻に泣きボクロ\n\n体型はだらしない感じで\n少し垂れ気味の爆乳にして下さい\n\n・設定\n何らかの理由で祠に封印されている怪異\n少年が母性に飢えている事を見抜き、\n「お母ちゃん」を自称して精気を搾り取ろうとしている\n\n関西弁で少年を誘惑している感じです\n\n「坊ん（ぼん）のおちんちん気持ちいいわあ」\n「はじめてぴゅっぴゅ頂くで」\n「お母ちゃんの膣内にいっぱい出してな」\n「いっぱい出してくれたらおっぱいあげようなあ」\n\nなどなど、精通を搾り取っていることを強調して下さい\n\n●少年\n巨女怪異との体格差を強調して下さい\n挿入されているので見えませんが、年相応の短小包茎子供性器です\n顔立ちも見えませんが、小柄で可愛い系のショタと言う設定です\n\n「おかあさんっ」\n「なんかくるっ　おしっこでちゃうっ」\n\n・設定\nモブ少年\n母性に飢えており、巨女怪異の爆乳に吸い寄せられてしまった", "nc": 169, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@ruru_dashire/works/8", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/9fccdbd0/uploads/origins/5a54ca83-68a7-4439-971e-3afb8b9811bc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=1fe1c34310ec613d310ad6aea3fea70a", "srcset": "https://si.imgix.net/9fccdbd0/uploads/origins/5a54ca83-68a7-4439-971e-3afb8b9811bc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=1fe1c34310ec613d310ad6aea3fea70a, https://si.imgix.net/9fccdbd0/uploads/origins/5a54ca83-68a7-4439-971e-3afb8b9811bc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=ce94ab102f3c3ff2142dc7c0ff26728c 2x, https://si.imgix.net/9fccdbd0/uploads/origins/5a54ca83-68a7-4439-971e-3afb8b9811bc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=09160e740e18c437d391f5773cf3a5e9 3x"}, "private": true, "genre": "art", "tipped": true, "creator_id": 2919183, "client_id": 2574338, "nc": 48}, {"path": "/@ruru_dashire/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "comic", "tipped": true, "creator_id": 2919183, "client_id": 335424, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/747d7740/uploads/origins/74de9533-1124-4fbd-ae03-067656e66222?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fe0db5b030bd11a73cf14a585e50f7d7", "srcset": "https://si.imgix.net/747d7740/uploads/origins/74de9533-1124-4fbd-ae03-067656e66222?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fe0db5b030bd11a73cf14a585e50f7d7, https://si.imgix.net/747d7740/uploads/origins/74de9533-1124-4fbd-ae03-067656e66222?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=d73f317fe8fd35beb99a2c8c9a5bef51 2x, https://si.imgix.net/747d7740/uploads/origins/74de9533-1124-4fbd-ae03-067656e66222?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a8961f10952b87547080220378eaef1b 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/747d7740/uploads/origins/74de9533-1124-4fbd-ae03-067656e66222?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a14cb32493d63152e8ec979d58625798", "srcset": "https://si.imgix.net/747d7740/uploads/origins/74de9533-1124-4fbd-ae03-067656e66222?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a14cb32493d63152e8ec979d58625798, https://si.imgix.net/747d7740/uploads/origins/74de9533-1124-4fbd-ae03-067656e66222?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=723d15f12c5f934b45fb3dab28c181f9 2x, https://si.imgix.net/747d7740/uploads/origins/74de9533-1124-4fbd-ae03-067656e66222?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=e852d0efe4795fb650e37a5633e9661e 3x"}, "body": "お待ちしておりました！\n\n●導入\n「自らダロ書の教えを実践し、\n以て臣民に範を示すワカルカ・ナ帝と皇子」\n\nかつて高貴な身分の結婚に於いては、\n初夜の営みがその始まりから終わりまで公開されたという\n事が終わった暁には、\n花嫁の純潔と花婿の射精機能を証明すべく、\n破瓜の血と白濁で汚れたベッドまで衆目に晒したとも……\n\n高貴な血という物は、かように正統性を誇示する必要があるのだ\nダローナ皇国に於いてもそれは例外ではない\n\n「ダローナの男児たるもの、\n精通の白き血は、\nその母の膣をもって迎えるべし」\n\n「ダローナの母たるもの、\n臨月には耕運の膣をもって、\n息子の門出に白濁の花を添えるべし」\n\n●シチュ\n実子を膣内で精通させる儀式と、\n臨月ボテ腹で交わる儀式を、\n完全生中継で国内外に発信する母帝\n\n1.\nまずは皇子の幼茎を口淫と手技で２回ドライ絶頂させる\nこれは「まだ精通していない」という事の証明である\n\n2.\n次に、母帝の膣内で精通させる\n精通が完了したら一旦性器を抜き、\n実子の白濁が溢れる実母の膣口をドアップで映し出す\n\nその後は皇子の精力が尽きるまで交わりを続ける\nこの際、皇子の射精回数が多ければ多いほど吉祥とされ、\n実際に精通直後の初体験とは思えないほどに精力絶倫な射精が続くという\nまた、「不思議な事に」この精通で母帝が懐妊する場合も多い\n(勿論、それらは服薬・投薬による調整の賜物である)\n\n3.\n儀式より10ヶ月の間、皇子は徹底的に母帝とのセックス漬けにされ、\nその母子姦シーンは育ってゆく妊娠ボテ腹と共に、\n「今日のお床入り」と称して、\nその射精回数に至るまで詳細に毎日生中継される\n\nまた、「ダローナの祖神の霊験により」\nその性器は驚異的な成長を遂げてゆく\n(これも服薬による)\n\n4.\n出産予定日、皇子によるお迎えセックス儀式の生中継\n分娩ギリギリまで何度も膣内射精\n最後は母のアナルを犯して出産を手助けする\n\n※\n「ダローナの妊婦たるもの、出産は息子のお迎え棒で」\n的な聖句を新たにお願いします\n\n産後は大量の白濁にまみれた赤子に母帝が初乳を与え、\n一連の儀式は完成する\n\n●概要\n作品形式は全てお任せ\n膣内射精を多めに\n前回ラストの様に強調があると嬉しいです\n\n●キャラ\n・ワカルカ・ナ帝\n前回と同じ\n\n・皇子\n名前や設定はお任せ\n容姿は母似、褐色肌の可愛い系ショタ\n\nhttps://skeb.jp/@ruru_dashire/works/4", "nc": 57, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@ruru_dashire/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2919183, "client_id": 30227, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/a519248a/uploads/origins/0d2f42c9-7c49-421c-b979-fa96373ca13b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=faf1148c23cb0dd6b89fc79eda3c2e6f", "srcset": "https://si.imgix.net/a519248a/uploads/origins/0d2f42c9-7c49-421c-b979-fa96373ca13b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=faf1148c23cb0dd6b89fc79eda3c2e6f, https://si.imgix.net/a519248a/uploads/origins/0d2f42c9-7c49-421c-b979-fa96373ca13b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f9b7a7358e4d64e173abe5e98fc4714f 2x, https://si.imgix.net/a519248a/uploads/origins/0d2f42c9-7c49-421c-b979-fa96373ca13b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=8d05f31a59abe2f2eb56ba33baa68ee1 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/a519248a/uploads/origins/0d2f42c9-7c49-421c-b979-fa96373ca13b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b189b798f3827e7b81285fa2563a72b6", "srcset": "https://si.imgix.net/a519248a/uploads/origins/0d2f42c9-7c49-421c-b979-fa96373ca13b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b189b798f3827e7b81285fa2563a72b6, https://si.imgix.net/a519248a/uploads/origins/0d2f42c9-7c49-421c-b979-fa96373ca13b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=cc467286f187a794966a8c4b84fad5e4 2x, https://si.imgix.net/a519248a/uploads/origins/0d2f42c9-7c49-421c-b979-fa96373ca13b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=9c4ddc30c7d2aeb5240d4