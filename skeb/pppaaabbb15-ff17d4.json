iv.net/artworks/102592873　が気になりまして…、是非こちらのキャラクターで１枚イラストを描いて頂けないかと思い、リクエストさせて頂いた次第です。\n\nもし出来る事ならそのキャラクターが髪型をポニーテールにしている所を見てみたいと思っています。※それが難しい、拘りがあってヘアスタイルは変えないという場合は無理強いはいたしません。\nキャラクターとヘアースタイル以外は特にこちらからは指定はありませんので\nこの枠を使い、パリボーさんがご自由にお描き頂ければと思っています。\nご検討の程、宜しくお願いいたします。", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@pppaaabbb15/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2184934, "client_id": 2271849, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/c07db672/uploads/origins/b81a38a2-1a2d-4fff-8662-5d364607eece?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=268a57339870259989a8b90d62cda2cd", "srcset": "https://si.imgix.net/c07db672/uploads/origins/b81a38a2-1a2d-4fff-8662-5d364607eece?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=268a57339870259989a8b90d62cda2cd, https://si.imgix.net/c07db672/uploads/origins/b81a38a2-1a2d-4fff-8662-5d364607eece?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=6a173f622bb7bdb3cf795c2afb794b09 2x, https://si.imgix.net/c07db672/uploads/origins/b81a38a2-1a2d-4fff-8662-5d364607eece?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=54e4ddcc51200903eeb59d0d51b8f0b9 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/c07db672/uploads/origins/b81a38a2-1a2d-4fff-8662-5d364607eece?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9d9a66b51753f84ff0755273e34cffc0", "srcset": "https://si.imgix.net/c07db672/uploads/origins/b81a38a2-1a2d-4fff-8662-5d364607eece?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9d9a66b51753f84ff0755273e34cffc0, https://si.imgix.net/c07db672/uploads/origins/b81a38a2-1a2d-4fff-8662-5d364607eece?bg=%23fff&auto=format%2Ccompress&fm=webp&