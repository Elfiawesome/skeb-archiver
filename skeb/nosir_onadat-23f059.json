が希望ですが、もし難しければどのようなコントローラーでも大丈夫です。\n服装は資料の通りではなく、部屋着っぽい服装でのーさー様におまかせできればと思います。イメージはジェラートピケのような…女の子らしく可愛い部屋着だと嬉しいです。\nまたお部屋の内装や小物もできれば描いていただけると嬉しいです。そちらもおまかせしたいのですが、資料にありますうさぎのぬいぐるみ(ほっぷちゃん)をイラスト内に入れていただけないでしょうか。\n\nスマホのロック画面やパソコンの壁紙として、またゲーム配信でのサムネイルに使用したいなと思っております。\nご縁がありましたらどうぞよろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/1-fL8zvEPyQFcssw7WdoF8cNXGJ1-oUfb", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@nosir_onadat/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 4088, "client_id": 1515297, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/1eaacf23/uploads/origins/af7a0214-b0e0-47f1-98d9-cb0aa56532be?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e722879f32a2c763de4bd2207f5f2fae", "srcset": "https://si.imgix.net/1eaacf23/uploads/origins/af7a0214-b0e0-47f1-98d9-cb0aa56532be?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e722879f32a2c763de4bd2207f5f2fae, https://si.imgix.net/1eaacf23/uploads/origins/af7a0214-b0e0-47f1-98d9-cb0aa56532be?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=6abacb3f7f1629f86d42c641cf6699e6 2x, https://si.imgix.net/1eaacf23/uploads/origins/af7a0214-b0e0-47f1-98d9-cb0aa56532be?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=2c180cfe151ae2782bff663ee4232b95 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/1eaacf23/uploads/origins/af7a0214-b0e0-47f1-98d9-cb0aa56532be?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2f64d70f60f7c9112bd5e71cd705e6e0", "srcset": "https://si.imgix.net/1eaacf23/uploads/origins/af7a0214-b0e0-47f1-98d9-cb0aa56532be?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2f64d70f60f7c9112bd5e71cd705e6e0, https://si.imgix.net/1eaac