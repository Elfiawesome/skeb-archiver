n▶︎Xのアカウントです。\nhttps://x.com/HoshiyumeGutara\n▶︎YouTubeのチャンネルです。\nhttp://www.youtube.com/@Hoshiyume_Gutara\n\nご検討よろしくお願い致します。\n\nhttps://drive.google.com/drive/folders/1v10n9_7qHgRnWQjcaohhFRm9jnA9MWNK?usp=sharing", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@hinano___p/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3919017, "client_id": 2703578, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/f8a467ef/uploads/origins/a424b54c-9e59-4bd7-9d5b-d32a6e738a8f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a34d2ae6f91b703cfb752a8b91adf24e", "srcset": "https://si.imgix.net/f8a467ef/uploads/origins/a424b54c-9e59-4bd7-9d5b-d32a6e738a8f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a34d2ae6f91b703cfb752a8b91adf24e, https://si.imgix.net/f8a467ef/uploads/origins/a424b54c-9e59-4bd7-9d5b-d32a6e738a8f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=231b61475b6ed054ab18bfd23ce9857c 2x, https://si.imgix.net/f8a467ef/uploads/origins/a424b54c-9e59-4bd7-9d5b-d32a6e738a8f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d7642ee520c109780073c6d87d2abce9 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/f8a467ef/uploads/origins/a424b54c-9e59-4bd7-9d5b-d32a6e738a8f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=7cd1a301cf8768c1be34bdf42af66b2b", "srcset": "https://si.imgix.net/f8a467ef/uploads/origins/a424b54c-9e59-4bd7-9d5b-d32a6e738a8f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=7cd1a301cf8768c1be34bdf42af66b2b, https://si.imgix.net/f8a467ef/uploads/origins/a424b54c-9e59-4bd7-9d5b-d32a6e738a8f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=42dd6ae972