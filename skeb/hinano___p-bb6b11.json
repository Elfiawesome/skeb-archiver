キャラクターのみのデータもいただきたいので、PSDデータで納品していただけると大変嬉しいです。\n\nサムネなど使用するため顔や耳、髪の毛などが見切れていないとありがたいです..！\n\n普段は雑談配信や、ASMR、飲酒や料理配信、作業枠などをしております。\n\nお忙しいところ恐れ入りますが、よろしくお願いします。\n\nhttps://lit.link/mirei111", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@hinano___p/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3919017, "client_id": 3466338, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/c7c25ea8/uploads/origins/7500d173-6694-41b2-bbd7-5dfc8c7da671?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bb7059d0efc5c418e5f417a31d1aac95", "srcset": "https://si.imgix.net/c7c25ea8/uploads/origins/7500d173-6694-41b2-bbd7-5dfc8c7da671?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bb7059d0efc5c418e5f417a31d1aac95, https://si.imgix.net/c7c25ea8/uploads/origins/7500d173-6694-41b2-bbd7-5dfc8c7da671?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=8b75cf9261fe5e782ce2b28ce4f01b97 2x, https://si.imgix.net/c7c25ea8/uploads/origins/7500d173-6694-41b2-bbd7-5dfc8c7da671?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c943cd19570e2adc359e1289ec0fe83c 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/c7c25ea8/uploads/origins/7500d173-6694-41b2-bbd7-5dfc8c7da671?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=abce0e431a6fb1d3b5c2ff016599922c", "srcset": "https://si.imgix.net/c7c25ea8/uploads/origins/7500d173-6694-41b2-bbd7-5dfc8c7da671?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=abce0e431a6fb1d3b5c2ff016599922c, https://si.imgix.net/c7c25ea8/uploads/origins/7500d173-6694-41b2-bbd7-5dfc8c7da671?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=96facfae2d59e180d769128445162f93 2x