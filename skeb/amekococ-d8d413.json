m=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=d82dd1f931f67ec2c2f3ea410dd2eabd 3x"}, "body": "あめこさん\nお世話になっております。\nいつもTLにて大変素敵なイラストを拝見させていただいております！色気があってかっこいい絵がいっぱいでまさに眼福ですね…\n\n今回はあめこさんにぜひTRPG自キャラクターのイラストを描いていただきたく、ご依頼いたしました。\nポーズや構図などは全てお任せいたします。お好きに描いていただければ幸いです！\n\n初めてのskeb依頼のため何か不備ございましたら申し訳ございません…。\nご検討いただけますと幸いです。よろしくお願いいたします。\n\n■キャラクター情報■（以下シナリオのネタバレは含まれません）\n○キャラクター名：「ノル・マリッツァ」\n○出身シナリオ：CoC「NapFrappe（HO Star）」\n○キャラ概要：国家警察（ファンタジー職ですが、描いていただく上では一般的に想像される警察イメージで大丈夫です）の男性。黒髪青目で目つきが悪い。\n○性格：基本仕事に真面目な男であり、猫をかぶって丁寧なキャラを演じようとしているが、沸点が低くカッとなりやすいためすぐに口調や態度が荒くなってしまう。なんだかんだ情に厚いタイプ。\n○外見参考資料：\n（資料URLにて記載）\n\n■使用用途■\n個人利用（自分のSNSアイコン・ヘッダー等含む）\n\nhttps://www.dropbox.com/scl/fo/jlazddzpcwmdqx7clcmin/ABgs-voPepMSlabWmZ8iAVo?rlkey=n0v0zq58fptolktgcjs99czad&st=se6huzm7&dl=0", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@amekococ/works/11", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2676647, "client_id": 1634285, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/c0d33925/uploads/origins/e09d0de7-facc-4126-9bb4-8e93047a2556?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=88aaec24228864bd4a6adc539e1b651d", "srcset": "https://si.imgix.net/c0d33925/uploads/origins/e09d0de7-facc-4126-9bb4-8e93047a2556?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=88aaec24228864bd4a6adc539e1b651d, https://si.imgix.net/c0d33925/uploads/origins/e09d0de7-facc-4126-9bb4-8e93047a2556?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=2fc2116e8f365952c4378afcfcddb587 2x, https://si.imgix.net/c0d33925/uploads/origins/e09d0de7-facc-4126-9bb4-8e93047a2556?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=03ad44c8b739c5e583e2a43fcede3f20 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net