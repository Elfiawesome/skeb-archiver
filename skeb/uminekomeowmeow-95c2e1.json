ive/folders/1U7uD9l4i3K2XXExYsZpChwFGQBo9tFei?usp=share_link", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 4004, "creator": true, "nsfw_acceptable": false, "acceptable": false, "name": "ちなみに｜Chinami", "screen_name": "tmicoi9", "avatar_url": "https://pbs.twimg.com/profile_images/1663799582026006530/25lLU4fn.jpg", "header_url": "https://pbs.twimg.com/profile_banners/784748868831289345/1716893502/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 120, "skills": [{"genre": "art"}], "banned": false, "nc": 144}, {"id": 48988, "creator": true, "nsfw_acceptable": false, "acceptable": false, "name": "RM", "screen_name": "RM_TSS", "avatar_url": "https://pbs.twimg.com/profile_images/675978671367188480/Zzl_yRcq.png", "header_url": null, "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 120, "skills": [{"genre": "art"}], "banned": false, "nc": 49}, {"id": 924767, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "めとろ☘️skeb_OPEN🌜", "screen_name": "melai_mm", "avatar_url": "https://pbs.twimg.com/profile_images/1902598837820350464/qVUW62na.jpg", "header_url": "https://pbs.twimg.com/profile_banners/897827792775032832/1707543630/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "art"}], "banned": false, "nc": 176}, {"id": 2365570, "creator": true, "nsfw_acceptable": false, "acceptable": false, "name": "0_xxqo", "scree