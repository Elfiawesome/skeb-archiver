RUIをからかうのも好き。RUIは愛情表現が苦手で無表情なことが多いが、内心ではKEIに甘えられるのが好き。ちょっと \"老夫婦 \"っぽいところがある。\n\n参考資料：https://drive.google.com/drive/u/1/folders/12CFRqB0PS9HWkiQ6J-93EzVBfwrjxGcX\n\n[リクエスト］\nmimio様の衣装デザインがとても好きです！KEIとRUIにまた新しい服を着せて描いてほしいです！テーマは中国っぽいおしゃれな服がいいです！参考までに、mimio様が描かれた服がとても好きです。\n\nhttps://skeb.jp/@mimio_tachibana/works/93\n\n細かいことは自由に決めていただいて結構です。お任せします！ご検討よろしくお願いします。\n\nhttps://drive.google.com/drive/u/1/folders/12CFRqB0PS9HWkiQ6J-93EzVBfwrjxGcX", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@mimio_tachibana/works/133", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/aadc2e73/uploads/origins/60bbd6e3-461b-4cf8-9e03-1b62437a771c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=b0a260e9fdadd8c231e490c82ed717f9", "src_set": ""}, "private": true, "genre": "art", "tipped": false, "creator_id": 2094177, "client_id": 2129712, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 128, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@mimio_tachibana/works/132", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2094177, "client_id": 2006829, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/b3fd8124/uploads/origins/9a738dfe-6dea-4118-94d4-695e5da2e53c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=264085a7f6a6b4d4b8d2c24b9962223e", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/b3fd8124/uploads/origins/9a738dfe-6dea-4118-94d4-695e5da2e53c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2e39c2bed7d4b3ffb24434db6095351f", "src_set": ""}, "body": "mi