ろ大変恐縮なのですが、できれば私のオリジナルキャラクター2人の掛け合いの絵もお願いしたいです！URLの画像31の二人の服装を描いて欲しいです！\n\n以下、西洋ファンタジーの設定で私のocを簡単に説明します↓。\nドラゴン×魔女\n龍之介：公爵家の跡継ぎとして変装して使われている黒髪緑目の邪龍で、普段は冷静沈着だが、椎名に対してはやや意地悪な態度をとり、椎名を怖がらせながらおとなしく言うことを聞き、要求を満たすことを好む。元は公爵家に飼育されていたドラゴンで、跡継ぎとして公爵家に残り、椎名はその使命感から「継母」となった。公爵家を継いだ後、彼は魔女を探し始め、やがて姿を消した椎名を見つける。椎名が当時の自分を可愛がってくれた \"母親 \"であることを知ってからは、椎名に対して過剰な行動を取ることが多くなるが、本人に悪気はなく、ただ椎名が自分を好いてくれている姿が好きで、怖くて、相手をとても可愛いと思っている。\n椎名：黒髪、赤目、男魔術師、元は宮廷魔術師だったが、公爵夫人に化けて公爵邸に忍び込み、龍の痕跡を探すという任務のため、龍之介の正体を探ることに着手せず、任務失敗のためついに姿を消し、最近になって龍之介が回収された。やや常識に欠け、魔術を嗜む。一時期、龍之介の面倒を見ており、彼のことが好きだった。\n\n西洋ファンタジー系が苦手という人は、普段着系で全然OK！\nどんなやり取りを描いても、その人の個性の範囲内であればOKです！ 金額に満たない場合は、再度リクエストを送っていただけると助かります！この度はご依頼をお受けいただき、誠にありがとうございました！\n\nhttps://drive.google.com/drive/folders/1si0qXG7Z7HBkuJkpGrP4VP42MaZHP5zr?usp=share_link", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@mimio_tachibana/works/142", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/bf2d3005/uploads/origins/766ec795-d9c2-4e35-9daf-6f9b8b2fd431?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=2c2b4d094aed0f36d0cd58cbc79eeded", "src_set": ""}, "private": true, "genre": "art", "tipped": true, "creator_id": 2094177, "client_id": 0, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 144, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@mimio_tachibana/works/141", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2094177, "client_id": 249523, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/03df2ba0/uploads/origins/2d1c1043-768b-41f8-ad27-e199f4e21980?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e1b3556b19e42af1bfdb80956b8bfc0e", "src_s