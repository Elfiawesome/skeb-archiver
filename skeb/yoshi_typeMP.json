n\n◆服装\nモンスターに剥ぎ取られたイメージで、装備の残骸が体に張り付いているような感じ。\n手間でしたら全裸でも大丈夫です。\n\n◆シチュエーション・構図\n\nファンタジー世界の女性冒険者が、モンスターに敗北して凌辱を受けるといったシチュエーションです。\n\nhttps://www.pixiv.net/artworks/135973349\n\nこちらの作品のようなスタイルで、体格差のある相手に背後から拘束され胸を鷲掴みにされながら無遠慮に貪られているシーンをお願いします。\n相手はお任せでお願いします。\n\n◆その他\n母乳体質ということで、母乳が噴き出していると嬉しいです。\n\n\nご検討よろしくお願いします。\n\nhttps://drive.google.com/drive/folders/1C8pkNqpTm_a0ww55W2IkeybXTe7evhOn?usp=sharing", "nc": 57, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@yoshi_typeMP/works/12", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 835386, "client_id": 49386, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/05a2f661/uploads/origins/e78f87b7-8bb0-41b0-b380-b11db048c2ae?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=80e8d95efab2e4ddc1e59038d355e845", "srcset": "https://si.imgix.net/05a2f661/uploads/origins/e78f87b7-8bb0-41b0-b380-b11db048c2ae?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=80e8d95efab2e4ddc1e59038d355e845, https://si.imgix.net/05a2f661/uploads/origins/e78f87b7-8bb0-41b0-b380-b11db048c2ae?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ac66b4675e2f169cdaab19e32c917de0 2x, https://si.imgix.net/05a2f661/uploads/origins/e78f87b7-8bb0-41b0-b380-b11db048c2ae?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=3baf1d34286489c2eb7ff452a8af2905 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/05a2f661/uploads/origins/e78f87b7-8bb0-41b0-b380-b11db048c2ae?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=8d7ea7aed564a580c262cc1394ca42ec", "srcset": "https://si.imgix.net/05a2f661/uploads/origins/e78f87b7-8bb0-41b0-b380-b11db048c2ae?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=8d7ea7aed564a580c262c