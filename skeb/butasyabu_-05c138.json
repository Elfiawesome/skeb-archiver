=top&w=200&h=200&s=c3c75e8f6f2bac6f5b70a45eaf757be7, https://si.imgix.net/a2052731/uploads/origins/a9e0a980-f58e-44cc-8e63-5865e5a81416?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=070597718fa937453ba2282f9dc046f9 2x, https://si.imgix.net/a2052731/uploads/origins/a9e0a980-f58e-44cc-8e63-5865e5a81416?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e9791166ecef54cea78c9c86a11f6439 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/a2052731/uploads/origins/a9e0a980-f58e-44cc-8e63-5865e5a81416?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9b73881223b1f14a78bb3423f412a395", "srcset": "https://si.imgix.net/a2052731/uploads/origins/a9e0a980-f58e-44cc-8e63-5865e5a81416?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9b73881223b1f14a78bb3423f412a395, https://si.imgix.net/a2052731/uploads/origins/a9e0a980-f58e-44cc-8e63-5865e5a81416?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=a5eb7a662672937f9886aee273e9532b 2x, https://si.imgix.net/a2052731/uploads/origins/a9e0a980-f58e-44cc-8e63-5865e5a81416?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=4332ba5b4982ae4212de30fef133a7b1 3x"}, "body": "先生、こんにちは。\nいつも素晴らしい作品を拝見し、どの一枚もとても美しいと感じております。\n大変恐れ入りますが、私のオリジナルキャラクターのイラストを一枚、お描きいただけないでしょうか。\nお好きなほうの衣装デザインをお選びいただいて構いません。\n\nキャラクター名：温梣（Windsrim）\n· 軍装バージョン：17歳\n· クトゥルフ系礼服バージョン：20歳\n  種族：異形の存在と融合した人間\n\n外見の特徴：\n· 髪は黒色。M字前髪。\n· 瞳は赤く、赤いアイシャドウを施している。\n· 左目の目頭に泣きぼくろがある。\n· 左手は包帯で完全に巻かれ、右手は手袋を着用。\n· 首に「0922」の刻印／番号がある。\n関連モチーフ／要素：\n戦闘 / 屍骸 / 十字架 / カラス / 白鳩 / 猫 / ポピー（ケシの花） / 死 / 眼球 / 蛇\n\n人物設定（世界観含む）：\n· 本作は西洋ファンタジーとクトゥルフ神話的要素が融合した世界観です。\n· 温梣は表向きは明るく朗らかな少年で、人に警戒心を抱かせず、自然と油断させてしまう雰囲気を持っています。\n· しかしその裏では、冷淡で人間離れした陰湿な性格であり、狂気を秘めた人物でもあります。\n· 基本的な言動は非常に礼儀正しく節度をわきまえていますが、正気を失い発狂した際にはその異質な側面が露わになります。\n\nご一読いただき、誠にありがとうございます。\nもし機会がございましたら、ぜひ先生に描いていただけますと幸いです。\nhttps://drive.google.com/drive/folders/1aiYbL9sxpyqhtVlc67FmrnzSQfjaLnCH\n\nhttps://drive.google.com/drive/folders/1qNBGV-o-T5qFbBmJphu3aSKeeiilGbhq", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@butasyabu_/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 4049642, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/ffb8d67e/uploads/origins/579ae50c-4b24-48e4-9e76-61837caa2cde?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fd0a6be32138fe7f9dc38538acb2e80c", "srcset": "https://si.imgix.net/ffb8d67e/uploads/origins/579ae50c-4b24-48e4-9e76-61837caa2cde?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fd0a6be32138fe7f9dc38538acb2e80c, https://si.imgix.net/ffb8d67e/uploads/origins/579ae50c-4b24-48e4-9e76-61837caa2cde?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=8734054025a54a32b411e7dd01543468 2x, https://si.imgix.net/ffb8d67e/uploads/origins/579ae50c-4b24-48e4-9e76-61837caa2cde?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=de7c8af0847b507d0e94856965c4f70e 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/ffb8d67e/uploads/origins/579ae50c-4b24-48e4-9e76-61837caa2cde?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=1d924ba051eaf8177f8ab1f1af789d50", "srcset": "https://si.imgix.net/ffb8d67e/uploads/origins/579ae50c-4b24-48e4-9e76-61837caa2cde?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=1d924ba051eaf8177f8ab1f1af789d50, https://si.imgix.net/ffb8d67e/uploads/origins/579ae50c-4b24-48e4-9e76-61837caa2cde?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=fe5c0b3f40bdeb3da6bd04aca229ed9e 2x, https://si.imgix.net/ffb8d67e/uploads/origins/579ae50c-4b24-48e4-9e76-61837caa2cde?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=90d01b5798003325650eca2f1c357e3e 3x"}, "body": "こんにちは！\n\n初めて拝見した時から、あなたの画風にすっかり魅了されてしまいました！その筆遣いはとても繊細でユニークで、本当に素晴らしい作品だと思います。\n\nもしご都合がよろしければ、私のオリジナルキャラクターの全身イラスト（立ち絵）を依頼させていただきたいのですが。\n\n今回の作品では、彼に新しい衣装を着せていただけると嬉しいです。可能であれば、地雷系（ジライケイ）のスタイルで描いていただけると最高ですが、衣装については、ぜひご自身の創造性を活かして自由に解釈・デザインしていただければと思います！ポーズや表情など、それ以外の部分はすべてお任せします。\n\nまた、もしこのテーマがご自身にとってやりがいを感じられないものであれば、遠慮なく依頼をキャンセルしてください。料金がご自身の通常の料金と合わない場合は、別の条件で再度お送りさせていただきます。\n\nお時間を割いてご検討いただき、誠にありがとうございます！\n\nhttps://drive.google.com/file/d/1RIIONh015ZfFQGvOVM5ktUUAZAvfqcU9/view?usp=drivesdk", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@butasyabu_/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 4049642, "client_id": 350097, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/1ccf11c2/uploads/origins/7ae12611-b508-4a38-9333-87648c27addd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8accfa5642df12b581a171b946ba004d", "srcset": "https://si.imgix.net/1ccf11c2/uploads/origins/7ae12611-b508-4a38-9333-87648c27addd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8accfa5642df12b581a171b946ba004d, https://si.imgix.net/1ccf11c2/uploads/origins/7ae12611-b508-4a38-9333-87648c27addd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=69961c47ef168e9b526fabf630abe308 2x, https://si.imgix.net/1ccf11c2/uploads/origins/7ae12611-b508-4a38-9333-87648c27addd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=892bafa7b217f9cd9d25f31a0bd68252 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/1ccf11c2/uploads/origins/7ae12611-b508-4a38-9333-87648c27addd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=25d0f0968f8241b211fd0c4a670199f7", "srcset": "https://si.imgix.net/1ccf11c2/uploads/origins/7ae12611-b508-4a38-9333-87648c27addd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=25d0f0968f8241b211fd0c4a670199f7, https://si.imgix.net/1ccf11c2/uploads/origins/7ae12611-b508-4a38-9333-87648c27addd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=45b75d889585da207667576f4ebc7e54 2x, https://si.imgix.net/1ccf11c2/uploads/origins/7ae12611-b508-4a38-9333-87648c27addd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=403dcaba2f7cf982e35532e9b51a57d5 3x"}, "body": "ᴀʙᴏᴋᴀɴɪさん、よければリンク先のキャラクターを描いていただけないでしょか。ポーズや服装はお任せいたします。\n\n無口で人付き合いが苦手な孤独な数学Ph.D.。 普段は無表情で他人との距離を置き、視線を合わせることを避けるため長い前髪で目元を隠している。しかし実際には観察力が鋭く、無意識に周囲の人間を分析してしまう。\n数学研究では天才的な才能を持つが、本人は「勉強が好きなのではなく、研究中だけ別世界に没頭できるから続けている」と語る。完璧主義で、他人にも自分にも厳しい。\n物欲がないように見えるが、実際は強いこだわりと潔癖な一面を持つ。服装には独自の美学があり、趣味は神秘学と天文学。 身体はあまり丈夫ではないがバイクを愛用しており、ストレスが溜まると夜の街を走る。\n雰囲気： 孤独／知的／神経質／ミステリアス／夜が似合う\nキャラクターの特徴・注意点：\n・瞳孔の外側に光輪があります。\n・ネイルは黒と紫です。\n・左手に指輪を着けています。\n\n解釈違いや描きにくい点などがあれば、適宜アレンジしていただいて大丈夫です。\nどうぞよろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/1wx7t9WXMIsSkA1Zhi9MxJW_At29KltIS", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@butasyabu_/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 4049642, "client_id": 3254798, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/5697dfaa/uploads/origins/c9ef6c5f-e751-4872-8065-c2b57a6c93a6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f1fd3924242a498cc5d7d5481b9a2aad", "srcset": "https://si.imgix.net/5697dfaa/uploads/origins/c9ef6c5f-e751-4872-8065-c2b57a6c93a6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f1fd3924242a498cc5d7d5481b9