104/uploads/origins/55c6c4dc-b921-496f-a9dc-f6c6ad9f0db5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=5bec819c3f2f5e986c14fa3a2f5de9f5 3x"}, "duration": null, "nsfw": true, "hardcore": true, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/55def104/uploads/origins/55c6c4dc-b921-496f-a9dc-f6c6ad9f0db5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=dd27c3c4f6ba5df611f37f2fca66ad6d", "srcset": "https://si.imgix.net/55def104/uploads/origins/55c6c4dc-b921-496f-a9dc-f6c6ad9f0db5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=dd27c3c4f6ba5df611f37f2fca66ad6d, https://si.imgix.net/55def104/uploads/origins/55c6c4dc-b921-496f-a9dc-f6c6ad9f0db5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=c90ebf18e48f11a39870bdf18167c1a2 2x, https://si.imgix.net/55def104/uploads/origins/55c6c4dc-b921-496f-a9dc-f6c6ad9f0db5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=ab518ffc9225dee2eb66344ef1eb088c 3x"}, "body": "シャイネスレディがひたすらショタを暴行して最後には首を絞めて絞殺するお話をカラーの漫画でお願いしたいです。\n\n前回の鞭打ちショタの続きでも新たに拉致したショタでも構いません。\nシャイネスレディは前回同様にムチムチ体型。\nショタに腹パン、倒れたところをブーツを履いた脚で何度も蹴り、踏みつけ。みるみるアザだらけになるショタ。\nショタの腕や手のひら、足首などを何度も踏みつけ骨折させ身体の自由を徐々に奪っていく。骨折した部分はどす黒く変色。\n\nまともに身体が動かせないショタに全体重をかけてマウントポジションをとり顔面に唾を吐き捨てながら何度もパンチ。ボコボコになる顔面。\n最後に興奮してヨダレを垂らしながら両手で首を絞め絞殺するシャイネスレディ。\nセリフなどはお任せします！\n余裕があればいちごさんのオリジナルの逆リョナ要素を加えてもらっても大丈夫です！\nとっても残酷な内容ですが、お願いしたいです！", "nc": 170, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@hakuba1go/works/7", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/d562b6e7/uploads/origins/185feed8-67d3-4be0-88d1-02106d7022c4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=5f524afeb5cb02f7f660c7d36d5907aa", "srcset": "https://si.imgix.net/d56