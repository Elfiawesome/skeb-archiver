65-4461-99f8-941788073ff3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=83afd778602e40f01c4ab3ded5df5af6 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/3f0403fc/uploads/origins/8fc12bde-6365-4461-99f8-941788073ff3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f2647cb186ecf8cc65a175ea99c5dbfd", "srcset": "https://si.imgix.net/3f0403fc/uploads/origins/8fc12bde-6365-4461-99f8-941788073ff3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f2647cb186ecf8cc65a175ea99c5dbfd, https://si.imgix.net/3f0403fc/uploads/origins/8fc12bde-6365-4461-99f8-941788073ff3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=94b0a981e4656a62b0faba2392514d20 2x, https://si.imgix.net/3f0403fc/uploads/origins/8fc12bde-6365-4461-99f8-941788073ff3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=bd83a5740b75f49ffd5855c4f326354a 3x"}, "body": "初めまして！わい様のイラストが好きで、いつもTikTokやXの投稿を楽しみに拝見させていただいております(˶'ᵕ'˶ )‪︎♡この度は白黒skebを期間限定で解放されるとのことで、折角の貴重な機会にぜひ私と友人のOCを描いていただきたくリクエストいたしました！詳細は以下に一部箇条書きにて失礼いたします。\n\n【描写人数】2名\n【使用用途】個人SNSアカウントでのアイコン使用・掲載、依頼資料\n\n\n【キャラクター】\nA：身長178cm、16歳。灰色の髪と、深みのある水色の瞳を持つ青年です。頭脳明晰かつ運動神経抜群な人気者ですが、人に心を開いておらず、どこか周りとは一線を引いています。しかし、好きな女の子の前では周りの目からも明らかなほど態度が変わるようです。\n\nB：身長175cm、17歳。銀髪と、青～紫色のグラデーションになった瞳を持つ青年です。大抵のことは平均以上にこなせる高スペック人間ですが、表情筋が殆ど機能しておらず、感情を顔に表すのが苦手です。好きな人の前では全肯定botになる欠点があります。\n\n\n【衣装】執事服・眼鏡・手袋を身に着けた、パロディ衣装のような形を希望しています。詳細なデザインはお任せさせていただけたらと考えております！\n\n【資料URL】https://drive.google.com/drive/folders/1SHTI3Xu1UkT8Mj_8QGJHanMHThBPyANR\n\n以上になります。ご確認ありがとうございました！もし条件が合いましたら是非よろしくお願いします(⋆ᴗ͈ˬᴗ͈)”", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@ouddG2gcDh/works/3", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/98a96065/uploads/origins/67d84a63-06ed-40f8-8d16-54c629c