ぜて描いても構いません。\n※服飾は資料に添付しましたが、特に指定は無いので、服飾の簡略化やアレンジ、 変更など自由にしていただいて大丈夫です。\n\n表情、ポーズなどの解釈、イラストの構図、不明点も全てお任せ致します。\n\n▼【使用用途】\n・個人利用です。\n・SNSのアイコン、ヘッダーへの使用や投稿\n・個人鑑賞目的での印刷や非商用グッズ化等、営利利用は一切いたしません。\n\nまた、ご依頼内容が難しいと感じられた場合は、キャンセルしていただいても構いません。\n\nお忙しいところ恐縮ですが、ご検討いただけますと幸いです。\n何卒よろしくお願い申し上げます。", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}], "sent_works": [], "similar_creators": [{"id": 179744, "creator": true, "nsfw_acceptable": false, "acceptable": false, "name": "てかとり", "screen_name": "tktk_tori", "avatar_url": "https://pbs.twimg.com/profile_images/1342822049786470401/gL0aZPui.png", "header_url": "https://pbs.twimg.com/profile_banners/1193107349134643200/1626785480/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 14, "complete_expiration_days": 35, "skills": [{"genre": "art"}], "banned": false, "nc": 0}, {"id": 263850, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "えんがわ🍣skeb open!", "screen_name": "engawa110", "avatar_url": "https://proxy.misskeyusercontent.jp/avatar.webp?url=https%3A%2F%2Fmedia.misskeyusercontent.jp%2Fio%2F8f728b08-19a2-4105-829a-adbe7b98fa1f.gif&avatar=1", "header_url": "https://media.misskeyusercontent.jp/io/fabc4d71-23dc-476a-8210-af0e559474b3.webp", "appeal_receivable": false, "popular_creator_rank": 10, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 5, "complete_expiration_days": 60, "skills": [{"genre": "art"}], "banned": false, "nc": 176}, {"id": 2215455, "creator": true, "nsfw_acceptable": false, "acceptable": false, "name": "しなさび", "screen_name": "sa_ttgr", "avatar_url": "https://pbs.twimg.com/profile_images/1728744922247987200/JV04PVmb.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1170530287337369601/1756033147/1500x500", "app