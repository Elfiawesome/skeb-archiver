auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=d1b6daf09ece5303bc0c4bb61e507f3c", "src_set": ""}, "private": true, "genre": "art", "tipped": false, "creator_id": 1979231, "client_id": 680548, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 128, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@melcham_15/works/135", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1979231, "client_id": 562334, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/fe076897/uploads/origins/f2cfef8f-a2e5-46e5-a7ed-1b9abdfa67cf?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e88053d1ad411d94375d7714315d7251", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/fe076897/uploads/origins/f2cfef8f-a2e5-46e5-a7ed-1b9abdfa67cf?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d227e8e91e015462e5821af55047a1c7", "src_set": ""}, "body": "める様、こんにちは、初めまして！\n主にASMR動画を投稿しております、個人Vtuberの桜音のんと申します。\nこの度Skeb内で、とても素敵なイラストを拝見し、\nぜひとも自分自身も描いて頂けたらと思いリクエストを送信させていただきました。\n\n━━━━━━━━━━━━━━━━━\n\n【使用用途】\n動画のサムネイルや日常ポストの投稿等に使用\n(音声作品のサムネイルに使用する可能性もございます)\n\n【人物】\n桜音のん(こちら参考画像を下記にて共有させていただきます)\nhttps://drive.google.com/drive/folders/1gbJ7ut5QmKqYNevFg2nG39qnVkSUErPr?usp=drive_link\n\n【描写範囲】\n顔アップ～バストアップ\n\n【構図】\n前かがみになり、口元に手を当てて(片手)、息をふぅ～っと吹いている様子をお願いしたいです。\n\n【服装】\n共有したドライブ内にある、ルームウエアでお願いいたします。\n\n【髪型】\nロングヘアの方を基準に描いて頂けますと幸いです。\n\n【表情差分】\n・微笑み\n・罵り顔\n・んべぇ...と舌を出しているもの\nの【3種】を可能でしたらお願いしたいです。\n\n【背景】\nこちらはお任せいたします。\n━━━━━━━━━━━━━━━━━\n\n最後まで読んでいただきありがとうございました...!\n以上、長くなりましたが詳細になります。\n\nお忙しい中恐縮ですが、ご検討いただけますと幸いです。\nどうぞよろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/1gbJ7ut5QmKqYNevFg2nG39qnVkSUErPr?usp=drive_link", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@melcham_15/works/134", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/79366d78/uploads/origins/0c26ff0f-a2b5-4487-998b-0e23be211d73?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=da1c29a640aa49d96f3ddea05faf0e78", "src_set": ""}, "private": true, "genre": "art", "tipped": false, "creator_id": 1979231, "client_id": 0, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 32, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@melcham_15/works/133", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1979231, "client_id": 2288144, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/f852a074/uploads/origins/c0989605-949f-4770-9210-68e58bda4e82?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f75a14d103af882dd84a98c97f53df61", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/f852a074/uploads/origins/c0989605-949f-4770-9210-68e58bda4e82?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=23ad372b7ec415b7370b840cfd10ce63", "src_set": ""}, "body": "める様  \n\nはじめまして！ 現在IRIAMというプラットフォームでVliverとして活動準備をしております、きゅー。と申します。  \n\n新着でめる様のイラストを拝見して居てもたってもいられず、める様にわたくしの一枚絵を描いて頂きたいと思いリクエストさせて頂きます！ \n\n .𖥔 ݁希望の構図.𖥔 ݁ \n保健室のベッドの上で四つ這いになり、こちら(見てる側)に手を差し伸べておでこの熱を手で測るetc.看病している図を希望します！ \n表情は心配そうな顔の他に、める様といえば、な少し頬を赤らめた表情の差分もありますととても幸いです……！  \n\nこちら私の立ち絵になりますので、キャラクターの細かい服装や装飾などはこちらから参照してください。 ↓ https://x.com/__p___pchan/status/1917413612169355572?s=46&t=UKJMkui_3WVycwalqOmDhA  \n\n.𖥔 ݁使用用途.𖥔 ݁\n ・IRIAMというアプリでのサムネイル使用(投げ銭機能があります) \n・各種SNSでのアイコン使用 \n・リスナー様へのデジタル(ヘッダーetc.)・リアル(アクキーetc.)でのグッズ化  を想定しておりますため、商用利用が含まれることご理解ください。\nもし商用利用不可の場合はお手数お掛けしますがリクエストのキャンセル、または再送要請にてお知らせ頂けますと幸いです。 \n\n 最後に納品形式についてなのですが、イラストそれぞれ背景透過されたもので分けての納品でお願いしたいです。 ぜひご縁がありましたら、よろしくお願い致します！", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@melcham_15/works/132", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1979231, "client_id": 3576566, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/3a53418c/uploads/origins/b0df3511-ffd6-4c47-9b36-d2944a37cdfb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=46a4dea0ea72ecf67b08116e7dda1e26", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/3a53418c/uploads/origins/b0df3511-ffd6-4c47-9b36-d2944a37cdfb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=7d857a0ed62accb54d813aed27aa9a4d", "src_set": ""}, "body": "める様　こんばんは！\n\nskebでたくさんのカワイイ素敵なイラストが目に留まり、リクエストをさせて頂きました。\n今回リクエストさせて頂きたいのはオンラインゲームの自作アバターになります。\n資料URLにスクリーンショットを用意させて頂きましたので参考にしていただければと思います。\n\n表情、ポーズ、構図などは全てお任せいたします！\n\n使用用途としては、SNSのアイコンやヘッダー、PCやスマホの壁紙など\n作品のサイズや構図で使い分けようと思っております。\n\n何卒、よろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/1I9wu_KAAjuM26ofudnMpypFXZBJKxDWC?usp=drive_link", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@melcham_15/works/131", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1979231, "client_id": 2160394, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/0524d8b5/uploads/origins/6692e048-e9aa-4ce1-acfc-3635428621a8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5b97967be5e3513f47bd49b07d3232d0", "src_set": ""},