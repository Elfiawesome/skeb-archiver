人生の異なる段階にある同一人物です。雰囲気は、心理的な独白のようなものです。若い頃の自分が作り出した精神病院の独房で、若い頃の自分が年老いた自分を見守っているという設定です。\n\nテーマとしては、自己抑制、予言、『コヘレトの言葉』、舌の切除、知識と行動などです。\n\nもしPSDファイルのレイヤーに下書きや練習用データが含まれていたら、大変ありがたいです。\n\nリクエストをお読みいただきありがとうございます。良い一日をお過ごしください。\n\nhttps://drive.google.com/drive/folders/1BX13FF2_5MZrHsRGB3qrLn6cfCHabtYu", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@hamabichan/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 4040060, "client_id": 3544704, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/e6bdc61a/uploads/origins/f31488a1-7dd0-439b-9acf-b82e7f6729c1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=731dc861f4865718f21a740c0fad55dd", "srcset": "https://si.imgix.net/e6bdc61a/uploads/origins/f31488a1-7dd0-439b-9acf-b82e7f6729c1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=731dc861f4865718f21a740c0fad55dd, https://si.imgix.net/e6bdc61a/uploads/origins/f31488a1-7dd0-439b-9acf-b82e7f6729c1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ed5202a545f5ec3b4e5edc142742759d 2x, https://si.imgix.net/e6bdc61a/uploads/origins/f31488a1-7dd0-439b-9acf-b82e7f6729c1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=68982318f6cfa2031a763904332aac2c 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/e6bdc61a/uploads/origins/f31488a1-7dd0-439b-9acf-b82e7f6729c1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=05b720da41ec5e71d35c06b57d574bbc", "srcset": "https://si.imgix.net/e6bdc61a/uploads/origins/f31488a1-7dd0-439b-9acf-b82e7f6729c1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=05b720da41ec5e71d35c06b57d574bbc, https://si.imgix.net/e6bdc61a/uploads/origins/f31488a1-7dd0-439b-9acf-b82e7f6729c1?bg=%23fff&auto