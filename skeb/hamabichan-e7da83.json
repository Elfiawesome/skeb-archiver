-b2e4-663b281383fb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3df88845e9277c3553dba0b96240e60a, https://si.imgix.net/f0174c1f/uploads/origins/3b3f7b0a-0a9c-4c1d-b2e4-663b281383fb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=9aac209ae74d4b15505a7aa363116cd9 2x, https://si.imgix.net/f0174c1f/uploads/origins/3b3f7b0a-0a9c-4c1d-b2e4-663b281383fb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=05f343cb047c9c15d591ef508053131d 3x"}, "body": "はまびさんこんにちは！\nいつもはまびさんの素敵なタッチのイラスト・漫画を楽しく拝見しております。\nはまびさんがスケブを開設されていると知り、ぜひとも私が友人たちとグループで創作しているキャラクターを描いていただきたく、ご依頼いたしました。\n（友人達にskebでの依頼許可はもらっています。）\n\nキャラクターの概要は以下のとおりです。\n【赤いマントを羽織った紫髪の女の子】\n名前：桔梗\n元気で無邪気な女子高生。少し泣き虫なところがある。\n身長が小さいことを気にしている。（150ｃｍ）\n\n【和服の片メカクレの男性】\n名前：藤袴\nのんびりとした成人男性。猫が好きで猫からも好かれている。\nおばあちゃんっ子で穏やかな性格。180ｃｍです。\n\n二人の関係は遊び相手です。\n年の離れた親友以上兄妹未満という感じです。\n\n金額が依頼内容に見合わない場合は再送申請をしてください。ご縁がありましたら、ぜひよろしくお願いいたします。\n最後になりますが、はまびさんのこれからの創作活動も楽しみにしております！\n\nhttps://drive.google.com/drive/u/0/folders/1xyu11SDJnQ5vQWI9TpfBwtWxXlsPoYDJ", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@hamabichan/works/12", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 4040060, "client_id": 2957690, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/8e0a3000/uploads/origins/4f6ab5fb-46e5-4841-97fd-297038c76517?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=34fce0210d4c7dac25428216cf20705f", "srcset": "https://si.imgix.net/8e0a3000/uploads/origins/4f6ab5fb-46e5-4841-97fd-297038c76517?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=34fce0210d4c7dac25428216cf20705f, https://si.imgix.net/8e0a3000/uploads/origins/4f6ab5fb-46e5-4841-97fd-297038c76517?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=9ff71439edffceed2ce7e9cd9bedb5ea 2x, https://si.imgix.net/8e0a3000/uploads/origins/4f6ab5fb-46e5-4841-97fd-297038c76517?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=9dc777de0903312cc8cb13dd314606c6 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/8e0a3000/uploads/origins/4f6ab5fb-46e5-4841-97fd-297038c76517?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5c15c2fe523a8370b16db878eb0cf170", "srcset": "https://si.imgix.net/8e0a3000/uploads/origins/4f6ab5fb-46e5-4841-97fd-297038c76517?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5c15c2fe523a8370b16db878eb0cf170, https://si.imgix.net/8e0a3000/uploads/origins/4f6ab5fb-46e5-4841-97fd-297038c76517?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=6f8ed1f9d4d60812f03c8cea83f372fd 2x, https://si.imgix.net/8e0a3000/uploads/origins/4f6ab5fb-46e5-4841-97fd-297038c76517?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=02182b83d2ebaefc4ca6b4cfe5e11e08 3x"}, "body": "初めましてこんにちは。\nはまびさんの描かれる作品の作風に惹かれ是非、私と友人のOC2体を描いていただきたいと思いご依頼しました！\n\n【依頼詳細】\nフォルダ内の2人のカラーイラストを描いていただきたいです。\n両名とも高校生なので青春の一幕を切り取ったような季節感のある明るいイラストだと嬉しいです。\nその他、具体的な季節やそのほかのシチュエーション、服装などはお任せします！\n\n【プロフィール】\nhttps://drive.google.com/drive/folders/1OrKj6tlBxDgkKAap2fLFqC75-NtNmLDY?usp=sharing\n\n■使用用途\n・個人鑑賞目的での印刷（ネットプリント等）\n・友人への共有\n・SNSのアイコンやヘッダーへの使用の可能性\n\n要望、金額等難しいようでしたらキャンセル/再送して頂ければと思います。\nご検討のほど、何卒宜しくお願いいたします。", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@hamabichan/works/11", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 4040060, "client_id": 3544704, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/bc080c97/uploads/origins/236f77b5-2dd2-4626-96d1-0bf3f66e8d46?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d6c56129e0332a110c1d44c3612dee0b", "srcset": "https://si.imgix.net/bc080c97/uploads/origins/236f77b5-2dd2-4626-96d1-0bf3f66e8d46?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d6c56129e0332a110c1d44c3612dee0b, https://si.imgix.net/bc080c97/uploads/origins/236f77b5-2dd2-4626-96d1-0bf3f66e8d46?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b7fa834888bc6359521eb25151d160de 2x, https://si.imgix.net/bc080c97/uploads/origins/236f77b5-2dd2-4626-96d1-0bf3f66e8d46?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=15fb67a2af6bf17e178e292d8cb7d951 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/bc080c97/uploads/origins/236f77b5-2dd2-4626-96d1-0bf3f66e8d46?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e07e899ebe0edf42996ffc3c3c1342b6", "srcset": "https://si.imgix.net/bc080c97/uploads/origins/236f77b5-2dd2-4626-96d1-0bf3f66e8d46?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e07e899ebe0edf42996ffc3c3c1342b6, https://si.imgix.net/bc080c97/uploads/origins/236f77b5-2dd2-4626-96d1-0bf3f66e8d46?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=6f5b281eb6d955f6991d80ce8f1c38bc 2x, https://si.imgix.net/bc080c97/uploads/origins/236f77b5-2dd2-4626-96d1-0bf3f66e8d46?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=8ff4365e86811eb41ccae042a7e1358b 3x"}, "body": "はまび先生、お世話になります。\n前回は素敵なイラストを本当にありがとうございました。\nおかげで最高の夏を過ごせました…！\nもしよろしければ、今回もうちのPCを描いていただきたいです！\n以下キャラクター設定です。\n\n四辻怜央（26）／探偵／比良坂機関\n\n・愛想よく笑って喋る、少し押しの強い陽キャ\n・自分の可愛さをちゃんと武器にしてる\n・仕事中は手段を選ばず、笑顔のまま物騒なことができるタイプ\n・攻撃を外すと露骨に焦るし、子供っぽくムキになる\n\n【戦闘】\n指鉄砲のように人差し指で狙い、複数方向から攻撃するスタイル\n神格を自身の肉体に接続して力を使うため、眼・鼻・口など、身体の内側からダメージが出る\n\n【イラストについて】\n構図、ポーズ、表情、ぜひ自由にお任せしたいです！\n軽めの落書き詰めだと、さらにさらに嬉しいです…！\nどうぞよろしくお願いします！\n\nhttps:/