ャラ\n・『悪魔のリドル』の「首藤涼」と「神長香子」\n○シチュ・構図\n・資料URLの構図のフォルダ内にあるラフ画及び写真のような構図でお願いします\n…腕を上げて敬礼のようなポーズをする涼と、眼鏡を指で押し上げるポーズをする香子\n・百合っぽい感じの雰囲気でお願いします\n・いぬしまさんのイラストで例えるとこちらが近いです\nhttps://www.pixiv.net/artworks/109672233\n\n○衣装\n・資料URLのフォルダに入っている水着\n・黒い水着を涼、白い水着を香子に着せてください\n\n以上です。\nいぬしまさんの『僕の夏』というイラストに感銘を受け、今回のリクエストをさせていただきました。\n細かい注文が多くなってしまい申し訳ありません。お忙しいとは思いますが、何卒よろしくお願いします。\n\nhttps://drive.google.com/drive/folders/1z4IALczYlTn9oRNd0VpqU2N9TaZZVLYD?usp=sharing", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@inushima__0000/works/8", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/a2d0ba27/uploads/origins/bc49860c-7c2c-4a32-a38c-2a40e63918ec?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=7eaf54f16c1f7d471ddf4038f0771750", "src_set": ""}, "private": true, "genre": "art", "tipped": false, "creator_id": 186376, "client_id": 126448, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 49, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@inushima__0000/works/7", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/0aa2e718/uploads/origins/69737c41-35c7-4dbb-8cfe-21638799eb1a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=a973f7e460d89fc777565418b1a913b0", "src_set": ""}, "private": true, "genre": "art", "tipped": false, "creator_id": 186376, "client_id": 515208, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 128, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@inushima__0000/works/6", "priv