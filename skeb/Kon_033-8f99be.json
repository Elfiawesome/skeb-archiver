200&h=200&s=8e4632f513655d0a39ca44b91857f5a5, https://si.imgix.net/d8bb7814/uploads/origins/7da09987-b866-4002-8e0b-15a5346d6940?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=78462fd72b0e076fcae1e4dadfbbd164 2x, https://si.imgix.net/d8bb7814/uploads/origins/7da09987-b866-4002-8e0b-15a5346d6940?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=57b67c75401fb643bc2580b11e803650 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/d8bb7814/uploads/origins/7da09987-b866-4002-8e0b-15a5346d6940?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=7a63cc60ba2e121b89b30e37a80495f3", "srcset": "https://si.imgix.net/d8bb7814/uploads/origins/7da09987-b866-4002-8e0b-15a5346d6940?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=7a63cc60ba2e121b89b30e37a80495f3, https://si.imgix.net/d8bb7814/uploads/origins/7da09987-b866-4002-8e0b-15a5346d6940?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=5b24bee0e8d535fb4e1e80c9b36cf96e 2x, https://si.imgix.net/d8bb7814/uploads/origins/7da09987-b866-4002-8e0b-15a5346d6940?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=59085267626440ea1284724d5f7c0d1e 3x"}, "body": "・状況\n　ブルアカのヒナタが簡易トイレで踏ん張って大きなおならを出しているシーン。傍らにはハナコがいます。\n\n・環境\n　砂浜近くの木陰に設置した簡易トイレの中。\n　参考写真を添付します。テント外観はこだわりませんが、座る椅子はぶらさげたゴミ袋が見えるタイプが望ましいです。\n　参考ページ[https://www.scrio.co.jp/fs/kaigo/12868]\n　テント内には入れ替え用のゴミ袋やトイレットペーパー、着替え置きがある設定ですが省きます。\n\n・服装\n　水着ヒナタの着用している水着です。\n　排尿ならともかく排便に適した格好ではないので、白いワンピース部分は全て脱いでいます（イラスト内に脱いだものがなくてもよいです）\n　下に着用している黒い水着はビキニタイプだと推測できますので、ブラトップだけ着用のままでパンツ部分は脱がせます。\n　ブラトップの布面積はわかりませんが、バストを大きく覆うものがよいかと（水着ウイよりは間違いなく広いでしょう）\n　帽子は外しています。\n　参考ページ[https://shop-list.com/women/dengding/kf1824/]\n\n・姿勢\n　排泄用の椅子に腰掛け、重心を落として思いっきり踏ん張っています。\n　脚は膝より下が開いている（地に足をつけて踏ん張っている）形であれば、太ももは閉じても開いていても問題ないです。\n　背をまっすぐ伸ばし、両手をみぞおち辺りでグーにしてお腹に力を込めている姿勢です。\n\n・表情\n　ぎゅっと目をつむり、顔を赤くして全力で踏ん張っている健気なヒナタがほしいです。\n　口元は「う～～～んっ！」と声に出して息んでいるイメージです。\n\n◇排泄物\n　お腹に溜まっていたガスが一気に噴出し、テント内に満ちています（見どころ）\n　臀部下の排泄袋に収まるはずがなく、太ももの間や椅子とお尻の隙間からあふれるイメージです（別レイヤであれば擬音歓迎します）\n　爆発するようなでっかい屁を楽しみにしています。排泄袋は不透明の黒だと思いますが、透けさせても大丈夫です。\n\n◇その他\n　陰部が見えても大丈夫です。モザイクや海苔がつく場合があります。毛は好みあると思うのでおまかせします。", "nc": 177, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Kon_033/works/8", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2522122, "client_id": 69148, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/d18ec7e7/uploads/origins/3f0c8bff-1a68-4b00-b3f5-511610b123f9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6ab5ad9de77b758d8b15023da456914d", "srcset": "https://si.imgix.net/d18ec7e7/uploads/origins/3f0c8bff-1a68-4b00-b3f5-511610b123f9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6ab5ad9de77b758d8b15023da456914d, https://si.imgix.net/d18ec7e7/uploads/origins/3f0c8bff-1a68-4b00-b3f5-511610b123f9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b5c8adc9d6a7e9f6355e1bd17f94630b 2x, https://si.imgix.net/d18ec7e7/uploads/origins/3f0c8bff-1a68-4b00-b3f5-511610b123f9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=eb2dd20c937e5586b89dc8018587322f 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/d18ec7e7/uploads/origins/3f0c8bff-1a68-4b00-b3f5-511610b123f9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c10a33e8cf636f1d45b4c4cd69270f66", "srcset": "https://si.imgix.net/d18ec7e7/uploads/origins/3f0c8bff-1a68-4b00-b3f5-511610b123f9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c10a33e8cf636f1d45b4c4cd69270f66, https://si.imgix.net/d18ec7e7/uploads/origins/3f0c8bff-1a68-4