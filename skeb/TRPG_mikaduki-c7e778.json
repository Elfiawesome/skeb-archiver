igins/e75f2c87-ed23-4694-ae75-bf067efb7d13?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=77a17d155adcf36eea58227b2478e7a6, https://si.imgix.net/e2bc48c0/uploads/origins/e75f2c87-ed23-4694-ae75-bf067efb7d13?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=88d4bca2d32851158a5d78be2c020ae4 2x, https://si.imgix.net/e2bc48c0/uploads/origins/e75f2c87-ed23-4694-ae75-bf067efb7d13?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c13fde558c9170ae8964006b730ab151 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/e2bc48c0/uploads/origins/e75f2c87-ed23-4694-ae75-bf067efb7d13?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=8fbee7f9c67c44d8e08f84cc9a1be65d", "srcset": "https://si.imgix.net/e2bc48c0/uploads/origins/e75f2c87-ed23-4694-ae75-bf067efb7d13?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=8fbee7f9c67c44d8e08f84cc9a1be65d, https://si.imgix.net/e2bc48c0/uploads/origins/e75f2c87-ed23-4694-ae75-bf067efb7d13?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=4cc63878f419e36745e333b808b7d5f4 2x, https://si.imgix.net/e2bc48c0/uploads/origins/e75f2c87-ed23-4694-ae75-bf067efb7d13?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=1d28e82d50a8da9a7083faf865b9499c 3x"}, "body": "三日月様\nはじめまして\nvtuberをしております四樹恵(しきめぐみ)といいます\n\n\nXのタイムラインに流れてきた目のイラストがとても魅力的で以前いいねをしていたのですが、先ほど流れてきた女の子の髪の毛のイラストも可愛かったです！\n依頼できたらいいな～とおもってプロフィール見に行ったらスケブのリンクがあったので依頼しにきました...！\n\n依頼内容：\nわたし(四樹恵)の立ち絵をおねがいします\n振り向いているよう構図だと嬉しいです\n飲み物飲んでいる、先を指差している等\nもちろん他の構図でも問題ありません\n(食べ物や景色とイラストを合わせて写真を撮るイメージ)\n服は三面図のものでも、違うものでも構いません\n三面図で帽子かぶっていますがデフォルトはなしでお願いします\n\n\n可能であれば全身を描いていただきたいのですが\nお値段見合わない場合は再送リクエストいただけるか金額内で書ける範囲で構いません\nまた表情差分や眼鏡差分等あると嬉しいのですが、上記同様、金額が見合わない場合は再送リクエストもしくは金額内で描いていただけると嬉しいです\n\nXでの投稿やユーチューブのサムネ等にも使用したいため\n頭と肩が切れていないと嬉しいです\n\n\n\n※胸は小さめでお願いいたします\n※上記わかりにくかったり描きにくい場合は全部おまかせでお好きにかいていただけたらと思います\n\n\n\nお手数お掛けしますが人物のみの透過データもおねがいします\n\n参考：　https://x.com/Shiki_Meg/status/1696134832114618480?t=Zv7lrGxkLAqnRyotRZJEog&s=19\n三面図：https://drive.google.com/drive/folders/1Okteq_gkcw_BHrHVchkUGq30hEViYWvn\n\n\n\n使用用途:\nX、YouTube(サムネ、配信中に見せる)、ネップリ、グッズ(個人使用、問題なければ商用利用)やファンボックス(無料公開)等活動にて使用\n(念のため可能性のある用途は全て記載しております)\n\n\n\nたくさん書いてしまい内容わかりにくかったら申し訳ありません\n\nご検討よろしくお願いします！", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 675318, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "花遊つばき🌷ヒカセンVTuber", "screen_name": "Tsubaki19113", "avatar_url": "https://pbs.twimg.com/profile_images/2027720628011470853/t7jEqhPx.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1190784458732867585/1777299179/1500x500", "appeal_receivable": true, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "art"}, {"genre": "voice"}], "banned": false, "nc": 145}, {"id": 967783, "creator": true, "nsfw_acceptable": false, "acceptable": false, "name": "悠ちとせ", "screen_name": "cts_yu", "avatar_url": "https://pbs.twimg.com/profile_images/887266326879780865/hhHyX0J2.jpg", "header_url": "https://pbs.twimg.com/profile_banners/886581075568283648/1736754792/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 90, "skills": [{"genre": "art"}], "banned": false, "nc": 176}, {"id": 1487547, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "なめこ", "screen_name": "nameko_hachikou", "avatar_url": "https://pbs.twimg.com/profile_images/2028514255126089728/vpV