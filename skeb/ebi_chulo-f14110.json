h=200&blur=200&s=ec5719610ed91b6d0c0fe44fe43589a6 3x"}, "body": "えびちゅろ様、初めまして！個人Vtuberの浅羽和紗と申します。\nskebで可愛らしいイラストを拝見し、リクエストをさせていただきたいです。\n\n・依頼内容\n‐かわいいアイドルっぽいの感じにしていただけると嬉しいです。\n‐服装や髪型などは任せします\n\n・使用用途\n‐壁紙や個人用な印刷\n‐YouTube配信やTwitterなどのSNSで使用\n\nキャラ、文字などが分けていただけるデータを納品していただけると幸いです。\n\nキャラ詳細は下記に参考にしてください。\nhttps://twitter.com/asaba_kazusa/status/1410959126260162567?s=21\nhttps://drive.google.com/drive/folders/1cG_FMXBu_vijaXH3SV0zuE5K_H-fOc6i?usp=sharing\n\nご検討よろしくお願いいたします。", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@ebi_chulo/works/12", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 886599, "client_id": 663177, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/633bb519/uploads/origins/c36ce4b5-60e2-410a-b5fe-0082050bb8d1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=603052265fb7dde18ead14d8adc0dc44", "srcset": "https://si.imgix.net/633bb519/uploads/origins/c36ce4b5-60e2-410a-b5fe-0082050bb8d1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=603052265fb7dde18ead14d8adc0dc44, https://si.imgix.net/633bb519/uploads/origins/c36ce4b5-60e2-410a-b5fe-0082050bb8d1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=205fa641f9750db1640a37ed2dd4fae4 2x, https://si.imgix.net/633bb519/uploads/origins/c36ce4b5-60e2-410a-b5fe-0082050bb8d1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=eff0cdb60fe96465183f6b34a00f90a6 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/633bb519/uploads/origins/c36ce4b5-60e2-410a-b5fe-0082050bb8d1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a5e8af6541b0cd2c4076096cf01dc405", "srcset": "https://si.imgix.net/633bb519/uploads/origins/c36ce4b5-60e2-410a-b5fe-0082050bb8d1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a5e8af6541b0cd2c4076096cf01dc405, https://si.imgix.net/633bb519/uploads/origins/c36ce4b5-60e2-410a-b5fe-0082050bb8d1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=3587a809afeafd5a5fa7319db0304257 2x, https://si.imgix.net/633bb519/uploads/origins/c36ce4b5-60e2-410a-b5fe-0082050bb8d1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=de5f35c117469eb86d380d1d67c7fd2f 3x"}, "body": "えびちゅろ様、はじめまして。\nイラストを度々拝見しておりまして、えびちゅろ様のかわいい絵柄でぜひうちの子を描いていただきたいと思い、リクエストを送らせていただきます。\n\n◆依頼内容\n・名前　宝生 つぼみ(ほうしょう つぼみ)\n・161cm  B81 W53 H81\n・服は資料内の『衣装参考資料』のような地雷・量産系のお洋服を着せていただきたいです。ぶかぶかのパーカーはぜひ着せていただきたいのですが、妙子先生がこの子に似合うような衣装をデザインしていただけるととっても幸いです…！\n・とびきりかわいく描いてくださると嬉しいです。あざとめに描いていただいて大丈夫です。\n・ポーズは、ほっぺハートのような、ほっぺの近くに片手を持っていくかわいいポーズをお願いします。\n・金額内でもしも可能であればSDも描いていただけると嬉しいです\n・度々資料に載っている、ピンクの宇宙生物も一緒に描いていただきたいです。\n\n◆備考\n・可能であれば、笑顔の口が開いているのと閉じているもの等、簡易的な表情差分をいただきたいです\n・キャラ、文字、背景などのレイヤーが分かれたpsd形式での納品を希望します\n・もし可能であればラフもいただきたいです…！\n・使用用途:SNS等でのアイコン使用\n\nお忙しい中大変恐縮ではありますが、ご検討よろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/1Vvu6frRHu6G-5gjlclHppHSiwi47nZsF?usp=sharing", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@ebi_chulo/works/11", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 886599, "client_id": 2971542, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/243ded15/uploads/origins/c8b9eaee-dd47-42c4-8fa2-5585d8f8004c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8f1048c3cba816b150f8ee4b8a2d44ec", "srcset": "https://si.imgix.net/243ded15/uploads/origins/c8b9eaee-dd47-42c4-8fa2-5585d8f8004c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8f1048c3cba816b150f8ee4b8a2d44ec, https://si.imgix.net/243ded15/uploads/origins/c8b9eaee-dd47-42c4-8fa2-5585d8f8004c?bg=%23fff&auto=format%2Ccompress&f