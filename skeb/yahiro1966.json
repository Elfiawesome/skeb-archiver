op=top&w=200&h=200&s=1141ae0ecd563be18f510c4103a0540d 2x, https://si.imgix.net/60e62350/uploads/origins/38669c33-5011-455b-a66b-f50bc2109ddb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=7f86f37492660d4005bb442ed443ec91 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/60e62350/uploads/origins/38669c33-5011-455b-a66b-f50bc2109ddb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=cad4879436f8e414d19a61dba9059f6a", "srcset": "https://si.imgix.net/60e62350/uploads/origins/38669c33-5011-455b-a66b-f50bc2109ddb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=cad4879436f8e414d19a61dba9059f6a, https://si.imgix.net/60e62350/uploads/origins/38669c33-5011-455b-a66b-f50bc2109ddb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=ebc300147a55c521aedd0add63707800 2x, https://si.imgix.net/60e62350/uploads/origins/38669c33-5011-455b-a66b-f50bc2109ddb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=e9c22dd88e9fedcb5b6efa8411be2bd9 3x"}, "body": "こんにちはです。\n新作発売おめでとうございます‼️\nリクエストですがまたアキちゃんハルちゃんのＷパイズリを描いて欲しいです。\nシチュがパイズリ大好きであるアキハルの2人がこの僕くろをWパイズリをするシチュでお願いします。\n構図は資料と同じ感じで。\nくろはハルちゃんと同じ同級生にして下さい。\nもし台詞付けてくださるのならハルちゃんが呼び捨てアキちゃんが敬語で。\n射精はCG集と同じくらい出して欲しいです。\n最後にCG集と同じアキハルの2人で「パ・イ・ズ・リ 」🩷を言って欲しいです。\n\nhttps://www.pixiv.net/artworks/119165241#big_0", "nc": 32, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@yahiro1966/works/10", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 595537, "client_id": 182552, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/db2450f8/uploads/origins/f6a3c6e1-009a-419f-861a-0f272b03948f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=315da75fe81161be75956a64a192fc06", "srcset": "https://si.imgix.net/db2450f8/uploads/origins/f6a3c6e1-009a-419f-861a-0f272b03948f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=315da75fe81161be75956a64a192fc06, https://si.imgix.net/db2450f8/uploads/origins/f6a3c6e1-009a-419f-861a-0f272b03948f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f3dbd27d799513ebec8520b8ba1b6896 2x, https://si.imgix.net/db2450f8/uploads/origins/f6a3c6e1-009a-419f-861a-0f272b03948f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=33aa5c7bf2213829805c8453846dbf27 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/db2450f8/uploads/origins/f6a3c6e1-009a-419f-861a-0f272b03948f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=15331667136a551c9327642ffc032f1b", "srcset": "https://si.imgix.net/db2450f8/uploads/origins/f6a3c6e1-009a-419f-861a-0f272b03948f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=15331667136a551c9327642ffc032f1b, https://si.imgix.net/db2450f8/uploads/origins/f6a3c6e1-009a-419f-861a-0f272b03948f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=7de8cffd3789852a5b4039d497c062cd 2x, https://si.imgix.net/db2450f8/uploads/origins/f6a3c6e1-009a-419f-861a-0f272b03948f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=f5dd810af61068f67d6386a0d061ac96 3x"}, "body": "初めまして。\n下記の通り依頼させて頂きます。\n\n登場人物\n・八尺様\n・男の子①\n・男の子②\n(※デザインはお任せします)\n\nシチュエーション\n概要\n八尺様が男の子2人を連れ去り、その内1人を騎乗位で搾りながら、もう1人にその様子を披露して欲情させている。\n\n詳細\nまず、八尺様が男の子①に対して、背を向けた状態で騎乗位SEXをしています。\nそして彼女の目先には男の子②が地べたに座っており、男の子①との騎乗位SEXの様子を見せつけています。更に彼女は、騎乗位の上下運動でブルンブルン揺れている爆乳おっぱいに両手を添えて、まるでパイズリをしているかの様に見せかけています。男の子②は、男の子①が搾られている様子と、彼女のエアパイズリを見せられて興奮し、オナニーをします。更に途中で男の子①が絶頂して八尺様に中出した事で、男の子②は更に興奮。そして今度は男の子2人が同時に射精し、男の子②が放った精液が、彼女に引っ掛かります。\nそして最後、八尺様は男の子②に対して艶かしく微笑みながら、次は君の番だね♡と言って終わります。\n\nその他要望\n・イラストは男の子②の一人称視点でお願いします。\n・台詞付きでお願いしたく、内容は基本的にお任せします。但し八尺様の発する台詞は「ぽ」だけで、その横に( )で意訳された台詞を書いて頂きたいです。(因みに男の子2人には意訳の内容は伝わってないです)\n\n以上、ご検討頂きますと幸いです。", "nc": 40, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@yahiro1966/works/9", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/8360b424/uploads/origins/a67ee169-db5a-4cea-8094-ee6cd3e137f8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=033f10fcda55f2c248c2005cc46f1652", "srcset": "https://si.imgix.net/8360b424/uploads/origins/a67ee169-db5a-4cea-8094-ee6cd3e137f8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=033f10fcda55f2c248c2005cc46f1652, https://si.imgix.net/8360b424/uploads/origins/a67ee169-db5a-4cea-8094-ee6cd3e137f8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=9e210c1c87950c017e234ce5ef132f4e 2x, https://si.imgix.net/8360b424/uploads/origins/a67ee169-db5a-4cea-8094-ee6cd3e137f8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=010f139250f0c1e8e88849a8bcccacf6 3x"}, "private": true, "genre": "art", "tipped": false, "creator_id": 595537, "nc": 33}, {"path": "/@yahiro1966/works/8", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 595537, "client_id": 120407, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/9bcd0090/uploads/origins/45566a92-6913-4f24-8c74-b38f8780a6b8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=460538a269ec9991a86616459286c24d", "srcset": "https://si.imgix.ne