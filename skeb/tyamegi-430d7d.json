tor_id": 1821576, "client_id": 1759355, "nc": 48}, {"path": "/@tyamegi/works/14", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1821576, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/1f91d54c/uploads/origins/e1fd3644-9c33-4292-9429-3c04b6507b4e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b83c79f4a76652799153e43fe3d009c1", "srcset": "https://si.imgix.net/1f91d54c/uploads/origins/e1fd3644-9c33-4292-9429-3c04b6507b4e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b83c79f4a76652799153e43fe3d009c1, https://si.imgix.net/1f91d54c/uploads/origins/e1fd3644-9c33-4292-9429-3c04b6507b4e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c79f3c4e0b88034682c591ddcc2f8a0b 2x, https://si.imgix.net/1f91d54c/uploads/origins/e1fd3644-9c33-4292-9429-3c04b6507b4e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ba92f7cbac34ba570e1a74c3b962bcd5 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/1f91d54c/uploads/origins/e1fd3644-9c33-4292-9429-3c04b6507b4e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=1f72e75646c2ed4a65d90322fe665011", "srcset": "https://si.imgix.net/1f91d54c/uploads/origins/e1fd3644-9c33-4292-9429-3c04b6507b4e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=1f72e75646c2ed4a65d90322fe665011, https://si.imgix.net/1f91d54c/uploads/origins/e1fd3644-9c33-4292-9429-3c04b6507b4e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=cadbbb1330ec50d6eac59134757dad2f 2x, https://si.imgix.net/1f91d54c/uploads/origins/e1fd3644-9c33-4292-9429-3c04b6507b4e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=8acc3683b9f14de8ac7ded91d4c92240 3x"}, "body": "『魔法少女まどか☆マギカ』の暁美ほむら×鹿目まどかをリクエスト致します。\n\n【詳細】\nhttps://skeb.jp/@tyamegi/works/3\nこちらの作品と同様、ほむまどのセックス。体位は背面駅弁。\n\n映画『叛逆の物語』の悪魔ほむらとアルティメットまどかの姿。\n背景も設定に合わせて明るい宇宙空間のようなイメージ。\n\nほむらはふたなり。腕より太く胸に届く長さの巨根と、頭より大きい巨玉。\n竿も玉も血管が浮き、更に使い込まれて黒ずみ、陰毛も濃くなっている。\nまどかを完全に堕として支配している。\n\nまどかは普通の女体。体型や性器は変化なし。\n前作と同様、胸と結合部が見えるように衣装の布面積が減っている。\n鼠径部に悪魔ほむらの紋章が淫紋のように浮かび上がっている。\n\n【差分】\n◆挿入前\nほむらは我慢汁を垂れ流し、まどかも愛液が溢れている。\n\n◆挿入\n生で膣に挿入。まどかは前作よりも大きく腹ボコ状態になり、甘く絶頂。\n\n◆中出し①\nほむらの射精（中出し）と同時にまどかも潮噴き絶頂。\nリットル単位の精液が流し込まれ、まどかは一発で精液ボテ状態になる。\n\n◆中出し②\nほむらは抜かずに射精し続け、更に大量の精液を流し込む。\nまどかの腹が①より大きく膨らみ、結合部から精液が溢れる。\n\n◆余韻\nほむらは射精し続けながら汁まみれの竿を引き抜く。\nまどかは全く萎える様子の無いそれを見つめ、恍惚の表情で余韻に浸っている。\n\n以上の内容でよろしくお願い致します。", "nc": 48, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@tyamegi/works/13", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1821576, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/5772d8f5/uploads/origins/2e474f85-2c52-4950-9dcf-5010c5bc8480?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=cedc7d977a23dcb3f6d8c7e02649b5cf", "srcset": "https://si.imgix.net/5772d8f5/uploads/origins/2e474f85-2c52-4950-9dcf-5010c5bc8480?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=cedc7d977a23dcb3f6d8c7e02649b5cf, https://si.imgix.net/5772d8f5/uploads/origins/2e474f85-2c52-4950-9dcf-5010c5bc8480?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a57aea966872fa0cd1eb4052a6efc3bd 2x, https://si.imgix.net/5772d8f5/uploads/origins/2e474f85-2c52-4950-9dcf-5010c5bc8480?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=4149b2e194d96d2ac82ddcd316939c13 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/5772d8f5/uploads/origins/2e474f85-2c52-4950-9dcf-5010c5bc8480?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ca6ade4e13f1e7600b0aa9edf7d4bd00", "srcset": "https://si.imgix.net/5772d8f5/uploads/origins/2e474f85-2c52-4950-9dcf-5010c5bc8480?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ca6ade4e13f1e7600b0aa9edf7d4bd00, https://si.imgix.net/5772d8f5/uploads/origins/2e474f85-2c52-4950-9dcf-5010c5bc8480?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=5331604c3f2e4780aaff333b6cd6ac2d 2x, https://si.imgix.net/5772d8f5/uploads/origins/2e474f85-2c52-4950-9dcf-5010c5bc8480?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=e73f85bb5f07d57133981fbdd51d7de2 3x"}, "body": "こんにちは。このキャラクターを同じ服装でもう一度描きますか？\nhttps://imgur.com/a/hCeRaCi\n\nこのパターンで尻尾のトゲを描いていただけませんか？\nhttps://imgur.com/a/gnTKE5X\n\n1：この画像のように、彼女にお金を渡す手と、空の大きなグラスを渡す手を描いてください。https://imgur.com/a/dUBtgnV\n\n嫌なことを頼まれたような、ショックを受けた表情で描いてください。\nhttps://imgur.com/a/yzpc5er\n\n2：下着を脱いでグラスに放尿し、尻尾で体を隠しているところを描いてください。とても恥ずかしそうにしています。\nhttps://imgur.com/a/wKLng3V\n\n3：両手でグラスを差し出し、目に涙を浮かべながら怒っている様子を描きます。\nhttps://imgur.com/a/H2GrlCb\n\n4: 誰かが、ごく少量の液体が残っている空になったグラスを返す。彼女は顔を背けて、恥ずかしそうに顔を覆っています。\nhttps://imgur.com/a/t4NmBbI\n\nどのようなポーズでも構いません。作品をありがとうございました。", "nc": 48, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@tyamegi/works/12", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/ae56b8de/uploads/origins/ef4c5b3d-9673-4da3-ab50-8f0455dfe3ce?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=ac3a33fbddad047a47b3a10ace682531", "srcset": "https://si.imgix.net/ae56b8de/uploads/origins/ef4c5b3d-9673-4da3-ab50-8f0455dfe3ce?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=ac3a33fbddad047a47b3a10ace682531, https://si.imgix.net/ae56b8de/uploads/origins/ef4c5b3d-9673-4da3-ab50-8f0455df