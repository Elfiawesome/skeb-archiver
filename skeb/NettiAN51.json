mat%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7cd4de8918ea1b7672f5e7fcef9e2d14", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/71a37ad0/uploads/origins/a5a6c8eb-2b66-4d86-9279-0c2e447f60d8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=8f4000a77ae00609496f5f6924e2d73a", "src_set": ""}, "body": "こんにちは！以前お願いしたアート作品がとても気に入ったので、またお願いしたいと思っています！\n\n前回の作品と同じようなもので、この服に合わせたものをお願いできますか？\n\n参考：https://imgur.com/blWqA2w\nペットリファレンス：https://imgur.com/IqAATUd\n\nキャラクターとサインは背景と分けてください。\n\nTwitter、Twitch、YouTube、Discord、グッズに使いたいです。この作品をアニメ化し、クレジットを記載します。\n\nこの度は本当にありがとうございました！❤️", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@NettiAN51/works/60", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 998459, "client_id": 1556780, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/43b1cc65/uploads/origins/7ee72df7-3ad1-4d53-801a-61d42ff6bd26?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3dcd661f372f026790fb95a5298ea753", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/43b1cc65/uploads/origins/7ee72df7-3ad1-4d53-801a-61d42ff6bd26?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=72349e54bcb0ff1bd816866c6a91509c", "src_set": ""}, "body": "前回は本当にありがとうございました。できればまたお願いしたいです。\n\nhttps://imgur.com/OBAwVHH。\n\nポーズはなんでもいいのですが、全身が見える方がいいです。背景も冷たく氷のようなものがいいです。\n\nよろしくお願いします！", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@NettiAN51/works/59", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/daee52ea/uploads/origins/935dcf39-6157-45e1-81b3-1cae84b1e0cd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=194711f65c47426ba870e7732793fb47", "src_set": ""}, "private": true, "genre": "art", "tipped": false, "creator_id": 998459, "client_id": 2408766, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 145, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@NettiAN51/works/58", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 998459, "client_id": 108099, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/862242bd/uploads/origins/534382a2-88cd-470b-af40-bc16253e7717?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a7c176d415a916ef64127ec51ab623c2", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/862242bd/uploads/origins/534382a2-88cd-470b-af40-bc16253e7717?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a993d6a80a6b3bbafa4b82ecee206504", "src_set": ""}, "body": "はじめまして！\n素敵な作品を見て、是非描いて貰いたいと思いリクエストさせていただきました！\nうちの子の「リリ・アルメリア」のイラストをお願いしたいです！\nデザインに興味を持って頂けたら描いていただけると嬉しいです。\n使用用途としてはPCやスマホの壁紙、SNS等でアイコンや紹介に使用させていただきたいです。\n服は好きなようにアレンジ、もしくは別の服を着せていただいても構いません。\n構図、背景等はおまかせしますが、左手を描かれる場合は指輪は嵌めたままでお願いします！\nリリの性格は感情の起伏が少ない子で、ふわっと穏やかな雰囲気でお願いします！\nまた可能でしたらPSDでキャラと背景のレイヤーを分けていただけますと幸いです。\nよろしくお願いいたします！\n\nhttps://twitter.com/Ohwashi_FDAM_SZ/status/1737290836222857482", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@NettiAN51/works/57", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 998459, "client_id": 2819429, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/2266d2a3/uploads/origins/2b382ca5-6b36-4e9b-ab4b-a19a98a4c8c5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=79ccb49c6bf6b80b4249a2d1881a8654", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/2266d2a3/uploads/origins/2b382ca5-6b36-4e9b-ab4b-a19a98a4c8c5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c2d9258539ae8c7679742c773e844528", "src_set": ""}, "body": "こんにちは！あなたの絵はとてもきれいですね！\n私のウサギのキャラクターのアートを期待していました。彼はオスなので、胸は平らなはずです。ビーチに座っていてほしいです。あなたが彼と一緒に座っているように、彼が見る人を見るようにしてください。ロマンチックな夜の雰囲気にしてください。背景には夕日と星をお願いします！ありがとうございました！\n\nhttps://sta.sh/21ox0cg1f85q", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@NettiAN51/works/56", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 998459, "client_id": 1556780, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/8d1c93d3/uploads/origins/e6f8f078-4b8d-4dfe-b8ea-56cffb4d63e5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1552ed15d454079d19125894c1af01b8", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/8d1c93d3/uploads/origins/e6f8f078-4b8d-4dfe-b8ea-56cffb4d63e5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=61c78b0b5bbc64581235ac9b0ddfbfad", "src_set": ""}, "body": "はじめまして、こんにちは。あなたの画風に惚れましたので、ぜひ依頼をさせていただきたいと思います。\n\nhttps://imgur.com/xRdXLqA。\n\nポーズや表情は上品に見えれば何でもOKです。耳、尻尾、角は必ず描いてください。\n\n背景は、氷の宮殿のような、凍った結晶のようなものを希望します。\n\nご検討のほど、よろしくお願いいたします！", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@NettiAN51/works/55", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 998459, "client_id": 300416, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/43f705ed/uploads/origins/1fe8e32a-a12c-472b-9972-4be345557485?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e5cb062f2437aa18a27453ad45bf1b5e", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/43f705ed/uploads/origins/1fe8e32a-a12c-472b-9972-4be345557485?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=719a061cf03f90e2bbf2e46d1c7fdc84", "src_set": ""}, "body": "こんにちは！東方の久田巻司の絵をお願いしたいです。舞台は東方18ステージ5の雪バージョンです。夜です。その雰囲気に合うように、空はとてもきれいであってほしいです。司は、とてもかわいらしい表情で、見る人の方を見ていてほしい。また、司はその環境にふさわしい服を着ている。リンク先に例があります。\nhttps://www.pixiv.net/en/artworks/97493325#big_3", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@NettiAN51/works/54", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 998459, "client_id": 1800319, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/55c70c38/uploads/origins/3c413cbb-ecb7-45b9-8137-3c7b9e76bdbb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1fcbf1e7e6a3615b694fceb9c23bccec", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/55c70c38/uploads/origins/3c413cbb-ecb7-45b9-8137-3c7b9e76bdbb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=482c4cca234f7184e80904d5ef7d53e3", "src_set": ""}, "body": "hello! I love your art style!\n\nI want to have a drawing together with me (https://imgur.com/a/KkGNWNQ), and my friend (https://imgur.com/a/0kMVjRq)\n\nThis is for a halloween theme if that's alright!\n\n-I want it to be something similar like this (https://imgur.com/a/GKPmA9l)\n\n-the background can be a cave, haunted house, or anything scary is fine!\n\n-can you have the boy hold a flashlight instead of a candle? \n\n-both the boy and the girl have a scared expression.\n\n-both the boy and the girl are shaking from being scared.\n\n-The boy should be in a dinosaur costume like this (https://imgur.com/a/Lpqy5Lu). Can use the same colors as in the picture.\n\n-The girl should be in a witch costume like this (https://imgur.com/a/0vs7sir). Please use the original color of the girl's outfit on her reference sheet.\n\nEverything else I leave up to you!\n\nThank you!", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@NettiAN51/works/53", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 998459, "client_id": 2618862, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/1b90f86b/uploads/origins/0591f8d0-49bf-4cd3-97bb-73dae27a7f50?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3cd6d325fae508c1dbc3c0a92b59f8a1", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/1b90f86b/uploads/origins/0591f8d0-49bf-4cd3-97bb-73dae27a7f50?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=dc72370c85e6cb7a7692246cc4350487", "src_set": ""}, "body": "こんにちは、ねちー先生！\n\nギャラリーを拝見し、あなたの作品と色使いがとても気に入りました！キャラクターも背景もとても美しいです！もしよろしければ、私のVtuberのキャラクターにリクエストをして、Twitter、Twitch、ウェブサイトでアートを使用したいです！\n\n彼女は遊び好きで、よく笑い、きれいな景色を見るために旅行するのが好きです！花柄の袴を着てほしいです！具体的なデザインや柄はお任せしますが、デザインに興味がなければ、参考にあるもので大丈夫です！テーマは夏くらいがいいです！背景の時間帯や天気は、午後くらいで、青空と雲があるような感じ！海沿いの崖の上とか、素敵だと思います！ポーズについては、あなたの判断を信じます！可能であれば、キャンバスは風景でお願いします！\n\n本当にありがとうございます！よろしくお願いします！\n\nhttps://drive.google.com/drive/u/1/folders/1EhppDOWX40JDKs4Yf9AvQRkD4RMRLNX4", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@NettiAN51/works/52", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 998459, "client_id": 2078451, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/222f8eb2/uploads/origins/b144c5e8-97a3-4ff4-824e-355ba606aff3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=19141d930335349f4379b4eb857e98e0", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/222f8eb2/uploads/origins/b144c5e8-97a3-4ff4-824e-355ba606aff3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=48e5820de0c01e9694aed8c065ae862e", "src_set": ""}, "body": "先生、こんにちは！私のOCであるセレスティーヌをリクエストさせてください。\n彼女の星空をリクエストさせていただけませんでしょうか？もしよければ、背景はこれ（https://imgur.com/bX5Mlv7）かこれ（https://imgur.com/EsY38Fh）のようなものにしてほしいです。\n\n使い方は、今後の依頼の参考にさせていただくかもしれません。\n\nこのリクエストで大丈夫でしょうか？\n\nお忙しい中、ご対応いただきありがとうございました！\n\nhttps://imgur.com/a/7KGq8fe", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@NettiAN51/works/51", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 998459, "client_id": 1108616, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/b27e93aa/uploads/origins/5bbee49f-d31f-4249-bd55-60bcd81f36a3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=83de5162fa717f8714602048e8f4a589", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/b27e93aa/uploads/origins/5bbee49f-d31f-4249-bd55-60bcd81f36a3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d1f2c37588887f8635cf56c1e1b34c5b", "src_set": ""}, "body": "ハイハイ～♪」と言いながら\n\n私はvtuber～エクセルです。\n\nこれは私の前と後ろの衣装です\n\nfront; https://media.discordapp.net/attachments/922461334036152321/1018389552865493042/20220724-035144-1-VSeeFace.png\n\n\n私（性別：男性、身長：187cm）と、近々デビューする友人（女性、身長：150cm）のアートをお願いしたいのですが。\n\nこちらは私の友人です。https://twitter.com/nuggetayame/status/1668809901450354688?s=46&t=712IltYHsOaPuebMRDB91Q\n\nあなたの作品をいくつか見ましたが、美しい背景のデザインがとても気に入りました。私が彼女をいじめているアートをお願いしたいです。ポーズ、設定、背景はお任せします。\n\nありがとうございました。", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@NettiAN51/works/50", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 998459, "client_id": 2126422, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/5ad15dbd/uploads/origins/1eed4fad-d6ac-4222-b82c-fac42a7a71fd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=eac6ee499e3edf6353ca436476bbae58", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/5ad15dbd/uploads/origins/1eed4fad-d6ac-4222-b82c-fac42a7a71fd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=8903a7b56db6c0d3d37a8f8b47544e9f", "src_set": ""}, "body": "こんにちは、あなたの絵はとても可愛いです！！私のvtuberを描いていただけませんか？\n\n背景なし、サインなしの透明バージョンを入手することは可能でしょうか？\n\nSNS用や配信用に使いたいのですが、クレジットも入ります！\n\nポーズなど全てお任せします。\n\nお忙しい中、ご依頼をご検討いただき、誠にありがとうございました！\n\nhttps://drive.google.com/drive/folders/1wn8-zrZpHODpZyA0D2XqmYMcsBAgQqyf?usp=sharing", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@NettiAN51/works/49", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 998459, "client_id": 1790722, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/73c3a676/uploads/origins/0f1353f1-3b47-4f7f-9033-0d4ba7f76ef6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4b8d0da9d7ce3d4519bf51311e1b339b", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/73c3a676/uploads/origins/0f1353f1-3b47-4f7f-9033-0d4ba7f76ef6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6cc6419c39d832c69f8c3e434aa45936", "src_set": ""}, "body": "こんにちは、あなたの絵は本当に美しいです、もしあ