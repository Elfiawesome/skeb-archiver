h=200&blur=200&s=c685b629d19cdacac6ad1f646ef2156c 2x, https://si.imgix.net/ece97f65/uploads/origins/ee06f060-b30c-446c-b271-398ebc8aaebe?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=e93952f23b7d25b03628566451d789c6 3x"}, "body": "こんにちは。\n\n今回、ポケモンのニャスパーとエルレイドの2体を書いて頂きたいと思いリクエストをお送りしました。\n\n【リクエスト内容】\nポケモンのニャスパーをエルレイドが抱えているイラストをリクエストします。\n\n画像の解像度\n　・画面比率は3:4(縦向き)ぐらいで、可能であれば高解像度(1920 x 1080 px以上)を希望です。\n\nポーズ・表情\n　・ニャスパーをエルレイドが抱きかかえている構図です。\n　・個人的にニャスパーは何気なくぼうっと空を見上げているような感じだとありがたいです。\n　・エルレイドは、ニャスパーの子守り兼ボディーガード的な感じがあるとありがたいです。\n　・もし可能であれば、表情差分として通常と笑顔の2種類を希望します。　\n\n　・絵的に書くのが難しかったり餅田さんの解釈違いなどあれば、上記のポーズ・表情希望は無視してもらって構いません。\n\n背景\n　・特に希望はありません。白背景でも可です。\n　\n画像の枚数\n　・可能であれば、通常差分と笑顔差分の2枚を希望します。難しそうであれば、1枚でお願いします。\n【補足】\nリクエストのイラストは、おもにLINEの背景として使用予定です。\nもし、引き受けられない場合でしたらキャンセルしていただいて構いません。\n\n以上、長文となりましたがご検討の程よろしくお願い致します。\n\nhttps://twitter.com/Yume_no_Kankoro", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Mochida_0703/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1454568, "client_id": 649433, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/01d08c4a/uploads/origins/eda77c9d-2947-4655-985f-f5fb689e5af6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=11088b35234150afbaef36ed191b9eb8", "srcset": "https://si.imgix.net/01d08c4a/uploads/origins/eda77c9d-2947-4655-985f-f5fb689e5af6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=11088b35234150afbaef36ed191b9eb8, https://si.imgix.net/01d08c4a/uploads/origins/eda77c9d-2947-4655-985f-f5fb689e5af6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a871f091cd37467c0a216af017283cd8 2x, https://si.imgix.net/01d08c4a/uploads/origins/eda77c9d-2947-4655-985f-f5fb689e5af6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=743b4e2651a5b2b30f1a9d5de14a7897 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/01d08c4a/uploads/origins/eda77c9d-2947-4655-985f-f5fb689e5af6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0ca2bd6479cee52867965592f584b423", "srcset": "https://si.imgix.net/01d08c4a/uploads/origins/eda77c9d-2947-4655-985f-f5fb689e5af6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0ca2bd6479cee52867965592f584b423, https://si.imgix.net/01d08c4a/uploads/origins/eda77c9d-2947-4655-985f-f5fb689e5af6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=eb21f73ae864661337edd7be15cd37a9 2x, https://si.imgix.net/01d08c4a/uploads/origins/eda77c9d-2947-4655-985f-f5fb689e5af6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=53a6e1873737de082be0659a8ebc5570 3x"}, "body": "こんにちは。\n\n今回、鬼人正邪と少名針妙丸を書いて頂きたいと思いリクエストをお送りしました。\n\n【リクエスト内容】\n東方輝針城に登場する鬼人正邪と少名針妙丸のイラストを書いていただきたいです。\n指示内容といたしましては以下の通りとなります。\n\n画像の解像度\n　・画面比率は16:9(横向き)ぐらいで、可能であれば高解像度(1920 x 1080 px以上)を希望したい\n\nポーズ・配置\n　・画面中央で、正邪と針妙丸がしゃがみ・体操座りしているようなポーズで背合わせをしているイラスト\n　　→参考リンク先画像１：https://twitter.com/Yume_no_Kankoro/status/1117086271132712960?s=20\n　・座っているキャラの全身が映っているような感じでお願いします。\n\n表情\n　・正邪は無関心な感じの表情で、首をちょっと傾けているような感じでお願いします。(上記リンク先画像に近い)\n　・針妙丸は正邪に対して一方的な感情・好意がにじみ出ている感じの表情（照れ、頬が赤くなるなど、）でお願いします。また、正邪の方を気にしているような視線でお願いします。\n\n背景\n　・無理にとは言いませんが、下記参考リンク画像のような城の天守閣の背景と白無地の背景２種類をいただければと思います。\n　　→参考リンク先画像２：https://amanaimages.com/info/infoRM.aspx?SearchKey=25516049281\n　\n　・もし天守閣の背景を描くことが難しい場合は白無地の背景のみでお願いします。\n　\n画像の枚数\n　・合計４枚(背景描いたり色々するのが難しければ1枚目のみ)でお願いします。各画像は下記のような状態でお願いします。\n　　１枚目：正邪と針妙丸が背合わせしている、白無地の背景のイラスト\n　　２枚目：正邪のみを映したイラスト\n　　３枚目：針妙丸のみを映したイラスト\n　　４枚目：背景が城の天守閣になっているイラスト（背景描くのが難しい場合は無視してもよい）\n\t\n【補足】\n本画像は、おもにPCの壁紙もしくはiPadの壁紙として使用予定です。\nもし、引き受けられない場合でしたらキャンセルしていただいて構いません。\n\n以上、長文となりましたがご検討の程よろしくお願い致します。\n\nhttps://twitter.com/Yume_no_Kankoro/status/1117086271132712960?s=20", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 396318, "creator": true, "nsfw_acceptable": false, "acceptable": false, "name": "海源", "screen_name": "KTx3rl8o", "avatar_url": "https://pbs.twimg.com/profile_images/1592125081735819264/wKcwJgjV.jpg", "header_url": "https://pbs.twimg.com/profile_banners/4654062925/1612843444/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "art"}, {"genre": "music"}], "banned": false, "nc": 144}, {"id": 625731, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "湯山 優", "screen_name": "elezumahaisan", "avatar_url": "https://pbs.twimg.com/profile_images/1877372775268315136/K8zyuY6o.jpg", "header_url": "https://pbs.twimg.com/profile_banners/901277660302540802/1767971596/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 2, "complete_expiration_days": 7, "skills": [{"genre": "art"}, {"genre": "comic"}], "banned": false, "nc": 129}, {"id": 1817833, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "carrot＠commission open!", "screen_name": "ButtPurun", "avatar_url": "https://pbs.twimg.com/profile_images/1967363976381235201/kXvKbSvx.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1184223317533675520/1757908837/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "art"}, {"genre": "correction"}], "banned": false, "nc": 33}, 