 be changed or depending on you, too! You can feel free to draw whatever you want, We're looking forward to seeing your creative ideas!\n\nIf there are any problems, please feel free to decline. Thank you for your consideration and wish you happy everyday!\n\nhttps://drive.google.com/drive/folders/1yx9vY9mXEFvjdgxHKVXk9Xr94L_NX6Jk", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@teretteeen_za/works/5", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/c7b193cd/uploads/origins/f60002f2-4b37-4940-a44e-bb0de64560c5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=46fcbc2b8e23ffae3bca61c5479a7c5e", "srcset": "https://si.imgix.net/c7b193cd/uploads/origins/f60002f2-4b37-4940-a44e-bb0de64560c5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=46fcbc2b8e23ffae3bca61c5479a7c5e, https://si.imgix.net/c7b193cd/uploads/origins/f60002f2-4b37-4940-a44e-bb0de64560c5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=a262dd0ffa310863d98320be92384f97 2x, https://si.imgix.net/c7b193cd/uploads/origins/f60002f2-4b37-4940-a44e-bb0de64560c5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=0f1140a4b1af427aa0aa1292b08764d0 3x"}, "private": true, "genre": "comic", "tipped": true, "creator_id": 3202743, "client_id": 1848222, "nc": 144}, {"path": "/@teretteeen_za/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "comic", "tipped": false, "creator_id": 3202743, "client_id": 1981191, "vtt_url": null, "thumbnail_image_urls": {"src": "ht