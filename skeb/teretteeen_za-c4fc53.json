ースな軽口をたたくが、実際とても冷静の人。\n\n*金額が足りない場合は、適切な金額をご提案ください。 宜しければご検討よろしくお願いいたします!\nhttps://indigo-waste-bfb.notion.site/1d504ae0d0f680148c4df6041ed257d3?pvs=4", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@teretteeen_za/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "comic", "tipped": false, "creator_id": 3202743, "client_id": 1840831, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/511a6674/uploads/origins/dea32ce9-33ca-4d8c-a901-9d4be73a71b5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b0b72418552ea4befa59dab50447cee8", "srcset": "https://si.imgix.net/511a6674/uploads/origins/dea32ce9-33ca-4d8c-a901-9d4be73a71b5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b0b72418552ea4befa59dab50447cee8, https://si.imgix.net/511a6674/uploads/origins/dea32ce9-33ca-4d8c-a901-9d4be73a71b5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=5c70017a1996a35e5ae82036c3c79f03 2x, https://si.imgix.net/511a6674/uploads/origins/dea32ce9-33ca-4d8c-a901-9d4be73a71b5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=acea1a0c5e37b1b8859d290a4b3cf0ab 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/511a6674/uploads/origins/dea32ce9-33ca-4d8c-a901-9d4be73a71b5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5759f2cd3ca85549250a25196f520a1c", "srcset": "https://si.imgix.net/511a6674/uploads/origins/dea32ce9-33ca-4d8c-a901-9d4be73a71b5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5759f2cd3ca85549250a25196f520a1c, https://si.imgix.net/511a6674/uploads/origins/dea32ce9-33ca-4d8c-a901-9d4be73a71b5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=d97c2b73d30fd976ade6ae026fc5de7e 2x, https://si.imgix.net/511a6674/