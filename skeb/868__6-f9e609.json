le.com/drive/mobile/folders/1A13rq5XP0AxCCGtb4sVqM36UIwdN_p9O", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [{"path": "/@Kaicho339/works/36", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1223853, "client_id": 3576129, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/6ee4f863/uploads/origins/5f3670d4-0d0a-493e-b0fc-d58354dc5de7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ba44fcb34216155bc19101f027aad78d", "srcset": "https://si.imgix.net/6ee4f863/uploads/origins/5f3670d4-0d0a-493e-b0fc-d58354dc5de7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ba44fcb34216155bc19101f027aad78d, https://si.imgix.net/6ee4f863/uploads/origins/5f3670d4-0d0a-493e-b0fc-d58354dc5de7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=3d8ba1f3cef51f69939269ca930f8342 2x, https://si.imgix.net/6ee4f863/uploads/origins/5f3670d4-0d0a-493e-b0fc-d58354dc5de7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=5b6524d92a71719d7b65318eb03047b4 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/6ee4f863/uploads/origins/5f3670d4-0d0a-493e-b0fc-d58354dc5de7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=da9fd467479a0aa542689bc7b3be01b8", "srcset": "https://si.imgix.net/6ee4f863/uploads/origins/5f3670d4-0d0a-493e-b0fc-d58354dc5de7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=da9fd467479a0aa542689bc7b3be01b8, https://si.imgix.net/6ee4f863/uploads/origins/5f3670d4-0d0a-493e-b0fc-d58354dc5de7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=8786264ae4a9414ede725ca3a132f3fe 2x, https://si.imgix.net/6ee4f863/uploads/origins/5f3670d4-0d0a-493e-b0fc-d58354dc5de7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=a38d2e86d692ad26fdbc5448a9b87366 3x"}, "body": "かいちょう様\n\nお世話になっております！春春です。\n前回は素敵なイラストをありがとうございました！\n今回も私と相方がTRPGで使用している探索者のイラストを作成していただきたく、リクエストしました。\n(相手からの許可は得ております。)  \n\n衣装は制服ではなく適当な服を着せていただき、お手間でなければ二人の詰め合わせイラストが見たいです…！\n\n以下、キャラクターの詳細を記載しますのでご確認ください。\n\n 【詳細】\n一卵性双生児の兄弟。\n学園内でもとりわけ目立つグループの内の二人として持て囃されており、頭脳の弟と運動の兄として有名な双子。兄弟仲はかなり良く、特に弟の朝槻は兄の夕槻にべったりである。夕槻の方も朝槻を甘やかしまくっている。\n\nお互いに足りないところを補い合い、支え合って今まで生きてきた。これから先も二人で一緒にいるのだろうと信じて疑っていない。\n\n▼各キャラクター詳細\n①三星 朝槻(みつぼし さつき)\n※目の色が青と黄色の方\n性別：男性\n年齢：18歳\n職業：高校生(家庭科部)\n身長：174cm\n趣味：勉強、料理、食べること\n好きなもの：双子の兄、プリン、お菓子全般\n苦手なもの：整理整頓\n備考：空腹になりやすく常にお菓子を食べている\nイメージモチーフ：星、朝焼け\nイメージカラー：青\n\n一人称「俺」\n二人称「君」\n\n性格：\n入学時から主席の座を譲ったことがない優等生。\n優秀であるが人当たりの良い穏やかな性格をしており、友人も多いが、実際は引っ込み思案で目立つのがあまり得意ではない人物。\n優等生らしくしているがかなりの天然ボケであり、言っていることが理解されていないこともしばしば。\nまた、ドジで忘れ物や怪我が多い。運動神経はそこまで悪くないはずなのだが……。\n人と話すときは双子の兄のように話すことを心掛けている。自分にとって、人から好かれる存在のイメージが兄そのものだからだ。\n\n小さいころからお兄ちゃん子で、破天荒な兄の後ろを一生懸命ついて行っていた。\n昔は兄が世界のすべてだった。今でも、心の大部分を兄が占めている。憧れも劣等感も、友情も家族愛も全部抱いていた。\n\nサンプルボイス：\n「これ、うちの部活で作ってるロシアンルーレットクッキー。90種類くらい？のスパイスを使い分けてるんだって。食べる？」\n「それやったの夕槻だよ〜？」\n「みんな有名ですごいよねぇ」\n\n－\n\n②三星 夕槻(みつぼし ゆづき)\n※目の色が青とピンクの方\n性別：男性\n年齢：18歳\n職業：高校生(サッカー部)\n身長：174cm\n趣味：サッカー、料理\n好きなもの：運動全般、プリン\n苦手なもの：じっとしていること\n備考：かなりの味音痴\nイメージモチーフ：星、夕焼け\nイメージカラー：青\n\n一人称「俺」\n二人称「お前」\n\n性格：\n元気で明るく、いつでも人の輪の中心にいるような人物。ちょっとお調子者なところもある。\n優秀だが優等生という雰囲気ではなく、悪ふざけをして怒られるようなことも多かった。しかし、そこも好感に代わるような求心力のある人。\n運動神経抜群で、学園にはサッカーのスポーツ推薦で入学した。頭の回転も速く、試合では司令塔のような役割もこなしている。\nただし、あまり勉強は好きではなかった。決してひどい成績というわけでもないのだが、良いとは到底言えないものだった。\n\n何においても（たいていは）優秀な兄の弱点、それは「料理」だ。\n兄はあまりにも料理が下手だった。\n兄の作る料理は、ゲテモノが可愛く見えるほどにグロテスクなものだった。\nなんらかの毒物でも混ざっているのかと言うほどの不味さで、実際に家族以外の人が食せば卒倒することすらあった。\n\nサンプルボイス：\n「三星 夕槻、お兄ちゃんの方！」\n「朝槻と俺、二人いれば最強なんだ。駄目なところは補い合えるしさ」\n「困った時はいつでも頼ってくれていいからな」\n\n 【用途】 \n個人使用(スマホやPCの壁紙、SNSのアイコン・ヘッダー、グッズ作成等) \n\n資料不備・金額不足等ございましたら、御手数ですが再送していただけますと幸いです。\nお目に留まりましたらぜひご検討の程、よろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/16HafIJj3Ff6HyDXDzsUAyNrMbx3o400s", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@umaneko/works/196", "private_thumbnail_image_urls": null, "private": false, "genre": "music", "tipped": false, "creator_id": 1445727, "client_id": 3576129, "vtt_url": null, "thumbnail_image_urls": {"src": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1529482323187470337%2FDw3BLmwB.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5788d8bbc7b63661f54d908823c3d211", "srcset": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1529482323187470337%2FDw3BLmwB.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5788d8bbc7b63661f54d908823c3d211, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1529482323187470337%2FDw3BLmwB.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=bdfe962e3e57a6b818bf02d32470745e 2x, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1529482323187470337%2FDw3BLmwB.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b4921c32a937a1a9581bdcc828324d21 3x"}, "preview_url": "https://fcdn.skeb.jp/uploads/outputs/ee51be22-a9b6-453a-80ee-583408070af0?response-content-disposition=inline&Expires=1792481591&Signature=T4NndsYLTwNvBM9N5y1x1XLzaPqWTk~OUXEtXFkRGwGUIRYfTVmvl7xm4ko-wGEks2HRU88BYNR-nW55qkOINO7Ng42YC-gXCr8d6lnIb0zambV9MgPggY~wQPPxMAmVPFXTskPIz95bA3Wrrl2VONaBmSOU5Wu9d6lHePpJrTwC65iCQDlNb8Kgd3oFU4qFoo2ZbdLAmkS8okTkeMceu7X8Ne3zD3hyYunCZPCmH~FqxREH0~2ad2st1z~JkWmuUHAD-hGy5YZuD7rjmzwzPBVMbVCazfx-hUz2pn7QBy2bmJdRh~V6FyufxeXNbRzXvYxMvifXayulgxg8m2fu6A__&Key-Pair-Id=K1GS3H53SEO647", "duration": 135, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1529482323187470337%2FDw3BLmwB.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&f