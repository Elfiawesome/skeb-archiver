=200&s=55b6e7775d1e276c8b20f55f2851e0fa", "srcset": "https://si.imgix.net/fcaa5514/uploads/origins/f52af91d-5705-4769-9384-2ccb578d95ac?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=55b6e7775d1e276c8b20f55f2851e0fa, https://si.imgix.net/fcaa5514/uploads/origins/f52af91d-5705-4769-9384-2ccb578d95ac?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=28d76eb4884989082bc7ae26191d3a1e 2x, https://si.imgix.net/fcaa5514/uploads/origins/f52af91d-5705-4769-9384-2ccb578d95ac?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f99fdc4303d3086d8bac22eb2798d2a9 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/fcaa5514/uploads/origins/f52af91d-5705-4769-9384-2ccb578d95ac?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5cb0e9e6448223c4c4181c9d2a2f0b43", "srcset": "https://si.imgix.net/fcaa5514/uploads/origins/f52af91d-5705-4769-9384-2ccb578d95ac?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5cb0e9e6448223c4c4181c9d2a2f0b43, https://si.imgix.net/fcaa5514/uploads/origins/f52af91d-5705-4769-9384-2ccb578d95ac?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=aa72880604cef749b5db1e8c368e4e92 2x, https://si.imgix.net/fcaa5514/uploads/origins/f52af91d-5705-4769-9384-2ccb578d95ac?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=1f3678ce9eaf505b2fcf38488b8f6acd 3x"}, "body": "かいちょう様\n\nお世話になっております！春春です。\nいつも素敵なイラスト拝見しております。ぜひ私と相方がTRPGで使用している探索者のイラストを作成していただきたく、リクエストしました。\n(相手からの許可は得ております。)  \n\n構図や服装、シチュエーションなどは特に指定しませんので、おまかせでお願いします。とにかく幸せそうな2人であればなんでも大丈夫です。\n\n以下、キャラクターの詳細を記載しますのでご確認ください。\n\n 【詳細】\n2人とも大学生で、同い年で血の繋がりのない義理の兄弟(連れ子同士)。スキンシップを取りたがる心珠と、それに応える緑葉はいつだって距離が近かった。そして、いつもお互いを最優先に考えている、そんな家族であり親友の2人組。\n\n2人は家族になる前から家族ぐるみで付き合いがある友人であった。ギフテッド故に周囲に理解されない緑葉を、心珠は唯一受け入れ、理解し、共に遊ぶ仲になり、いつしか親友になっていった。\n双方が小学校高学年になった頃、緑葉の母が難病で亡くなってしまい、片親同士になった父と母が再婚。元々親友であった2人は家族となり、なお親交を深めていく。\n大学生になった現在。2人の間には可愛い妹ができ、充実した毎日を送っている。家族になる前から淡く浮かんでいた恋心に近い、あるいはそれ以上の愛情を抱えながら。\n\n▼各キャラクター詳細\n①速水 緑葉(はやみ ろくば)\n性別：男性\n年齢：21歳\n身長：178cm\n趣味：読書、植物\n好きなもの：本、静かな場所\nイメージモチーフ：カプセル(薬)、葉\nイメージカラー：緑\n\n一人称「僕」\n二人称「君」\n\n性格：\n薬学の新星と謳われ、学生の身でありながら期待を寄せられている青年。将来は日本最高峰の研究室で、新薬の開発に携わることが約束されている。そんな噂が飛び交う天才薬学者は、いつだって義理の兄の後ろに隠れてばかりいる内気な男だ。\n\n内気で根暗で目立つことが大の苦手。\nさらに吃音があり、特に大人数の前ではどもってなにも言えなくなってしまう。\nそんな性格で友人ができるはずもなく、家と大学を一人往復するだけの日々を送っている。\nなるべく話さないように生活しているため、無口でミステリアスな人だと誤解されており、根も葉もない噂が学校内で飛び交っている。\n\nサンプルボイス：\n「あ、あ…え、えっと…は、速水、ろ…緑葉……」\n「…僕には、心珠しかいないから」\n\n－\n\n②速水 心珠(はやみ しんじゅ)\n性別：男性\n年齢：21歳\n職業：大学生\n身長：177cm\nイメージモチーフ：真珠(宝石)\nイメージカラー：水色/白(サブ)\n\n一人称「オレ」\n二人称「君、アンタ/お前」\n\n性格：\nアルビノの美しい青年。ふと目を離したら消えてしまいそうな、儚くミステリアスな雰囲気を纏っている。……が、実際は外見とは相反するパッションを宿し、天真爛漫で人懐っこく、フレンドリーな性格。この世の生物全てを愛する勢いで性善説を信じ、慈しみと愛を抱いており、色んな人と仲良くなる事を生き甲斐としている。最近はSNSに動画を投稿したり、モデルのアルバイトをしたりと、積極的に顔を出して活動をしている。\n\nそんな彼にも、特段深い愛情を持つ相手がいる。家族たちだ。義理の父に義理の弟、そして半分血の繋がった妹と、産みの母をこの世で何よりも大事に思っている。\n\nサンプルボイス：\n「速水 心珠、21歳！ こっちは相棒のろく！」\n「なーんかさ、オレ思うんだよね。ろくなら、きっとなんにでもなれるって。自慢の片割れだもん」\n\n 【用途】 \n個人使用(スマホやPCの壁紙、SNSのアイコン・ヘッダー、グッズ作成等) \n\n資料不備・金額不足等ございましたら、御手数ですが再送していただけますと幸いです。\nお目に留まりましたらぜひご検討の程、よろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/1ke4xfYbzpREx9V_Q9Xq4dzUtSZzDfqRc", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@sentakuso/works/18", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1829018, "client_id": 3576129, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/c4cb31da/uploads/origins/d59aa42f-20fb-4ebf-a65b-51df6c3cbba8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6379f45423e6411f9bfea393606e21b0", "srcset": "https://si.imgix.net/c4cb31da/uploads/origins/d59aa42f-20fb-4ebf-a65b-51df6c3cbba8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6379f45423e6411