嬉しいです！（←構図的に椅子などで隠れたりする場合、気にしないでください！）\n\n【使用用途】\n・収益化をしているTwitch・Youtubeチャンネル等のサムネイル・配信バナー・動画\n・SNSのアイコン、ヘッダー、投稿等\n・PCデスクトップ壁紙\n\n・納品形式は可能であれば…人物・小物（←もしあれば）を分けたpsdデータもしくは透過画像での納品だと大変助かります。\n\n\n何卒、ご検討のほど宜しくお願い致します。", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@nagi__hibi___/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3679924, "client_id": 967173, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/f12e68b9/uploads/origins/711b10b8-e29d-494b-a6c5-da26d7b923a5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3aac98572da8fbcbd32cc23d792dd15c", "srcset": "https://si.imgix.net/f12e68b9/uploads/origins/711b10b8-e29d-494b-a6c5-da26d7b923a5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3aac98572da8fbcbd32cc23d792dd15c, https://si.imgix.net/f12e68b9/uploads/origins/711b10b8-e29d-494b-a6c5-da26d7b923a5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=8b6e63fcf4ecf2e20a2a583ec555f7d1 2x, https://si.imgix.net/f12e68b9/uploads/origins/711b10b8-e29d-494b-a6c5-da26d7b923a5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=1fedfeac95fe4a35203f1ffa3975ec76 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/f12e68b9/uploads/origins/711b10b8-e29d-494b-a6c5-da26d7b923a5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d547743ea0da8c9ef6cc1d50b94489a9", "srcset": "https://si.imgix.net/f12e68b9/uploads/origins/711b10b8-e29d-494b-a6c5-da26d7b923a5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d547743ea0da8c9ef6cc1d50b94489a9, https://si.imgix.net/f12e68b9/uploads/origins/711b10b8-e29d-494b-a6c5-da26d7b923a5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=5c6e52