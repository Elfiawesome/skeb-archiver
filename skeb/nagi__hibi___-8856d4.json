メインに配信しています。\n\nゆうなぎ様の作品を拝見し、是非イラストを描いていただきたいと思いリクエストいたしました。\n\n【依頼内容】\nしゃちくさくの1枚絵\n構図やシチュエーションはおまかせします！\n\n【特徴】\n目の色、髪型、髪の色等の身体の特徴は立ち絵を参考にいただきたいです。\n人物・背景・メッセージは分けていただけますと大変助かります。\n\n【サイズ】\nサイズは問いません。\n人物の頭と左右が見切れないように描いていただけると助かります。\n\n以上、お忙しいところ恐縮ですが、ご確認の程宜しくお願いいたします。\nこれからも応援しています！\n\nしゃちくさく\n\nhttps://drive.google.com/drive/folders/1GYqFc7fUWvXwkaoP8masiho6-h4NCcPU", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@nagi__hibi___/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3679924, "client_id": 3895868, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/a5c951b1/uploads/origins/02c07702-736a-4fae-8c93-08a557649d45?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7fefa9af0399e5ae73e45060580c0ff1", "srcset": "https://si.imgix.net/a5c951b1/uploads/origins/02c07702-736a-4fae-8c93-08a557649d45?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7fefa9af0399e5ae73e45060580c0ff1, https://si.imgix.net/a5c951b1/uploads/origins/02c07702-736a-4fae-8c93-08a557649d45?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=0e79ab12f086634ece869119de9a3836 2x, https://si.imgix.net/a5c951b1/uploads/origins/02c07702-736a-4fae-8c93-08a557649d45?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=8f512ca57fac4ed8eb9e1d4f0970a2b1 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/a5c951b1/uploads/origins/02c07702-736a-4fae-8c93-08a557649d45?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=72cf95637f891792b649e6131e93df98", "srcset": "https://si.imgix.net/a5c951b1/uploads/origins/02c07702-736a-4fae-8c93-08a557649d45?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=72cf95637f891792b649e6131e93df98, https://si.imgix.