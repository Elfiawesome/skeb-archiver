たします。\n\n■キャラクター\n　虹野ゆめ・七倉小春\n■シチュエーション\n　夜の寮室で百合エッチ（小春攻め）\n　二人ともパジャマ姿で、ゆめは下半身が脱がされた状態で上も大胆にめくれている\n　pixivのファンサ（https://www.pixiv.net/artworks/100687126）のような構図で、ゆめは椅子に座って開脚\n　小春はゆめの股間に顔を寄せてクリ舐め＆手マン（隠れてもOKです）\n　とても上手な小春にナカとクリを同時に攻められてゆめはイかされ、椅子の背もたれへ体を預けて小刻みに体を震わせる\n\nご検討よろしくお願いいたします。", "nc": 49, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@yumerola_man/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1368646, "client_id": 798412, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/aee3f8dc/uploads/origins/cc016884-d433-4ce6-8b5e-00caa3c89d50?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=085d24356f2a4af1e220b98cef619204", "srcset": "https://si.imgix.net/aee3f8dc/uploads/origins/cc016884-d433-4ce6-8b5e-00caa3c89d50?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=085d24356f2a4af1e220b98cef619204, https://si.imgix.net/aee3f8dc/uploads/origins/cc016884-d433-4ce6-8b5e-00caa3c89d50?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=75807c38b3252a3fa13f8aeae81b2e43 2x, https://si.imgix.net/aee3f8dc/uploads/origins/cc016884-d433-4ce6-8b5e-00caa3c89d50?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=2d15536ee94733a5a4870ae8bec8a077 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/aee3f8dc/uploads/origins/cc016884-d433-4ce6-8b5e-00caa3c89d50?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3dba7e1bc384672567a9527f70f863b9", "srcset": "https://si.imgix.net/aee3f8dc/uploads/origins/cc016884-d433-4ce6-8b5e-00caa3c89d50?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3dba7e1bc384672567a9527f70f863b9, https://si.imgix.net/aee3f8dc/uploads/origins/cc016884-d433-4ce6-8b5e-00caa3c89d50?bg=%23fff&auto=format%2Ccomp