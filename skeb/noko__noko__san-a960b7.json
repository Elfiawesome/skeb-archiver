folders/1prYq4wCVntQRLdfUWvow13PH1JgJHY_t?usp=sharing\n\n\n※期限超過の際は再送してほしいとの旨、blueskyにて拝見しております。年明けでも構いませんので、よろしくお願い致します。", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@noko__noko__san/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3378879, "client_id": 2403555, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/234f053d/uploads/origins/d8a27f7b-5183-4aac-aa9b-c55e7c28b799?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2173df2857281823c0a662f00718e582", "srcset": "https://si.imgix.net/234f053d/uploads/origins/d8a27f7b-5183-4aac-aa9b-c55e7c28b799?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2173df2857281823c0a662f00718e582, https://si.imgix.net/234f053d/uploads/origins/d8a27f7b-5183-4aac-aa9b-c55e7c28b799?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=08dd74ce48beea9dd09fc2f3a16d4f74 2x, https://si.imgix.net/234f053d/uploads/origins/d8a27f7b-5183-4aac-aa9b-c55e7c28b799?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=3dd3d76fe5e873289267af365d792a75 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/234f053d/uploads/origins/d8a27f7b-5183-4aac-aa9b-c55e7c28b799?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=4a04ebd765ba859abf79f9bd8b4f7d32", "srcset": "https://si.imgix.net/234f053d/uploads/origins/d8a27f7b-5183-4aac-aa9b-c55e7c28b799?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=4a04ebd765ba859abf79f9bd8b4f7d32, https://si.imgix.net/234f053d/uploads/origins/d8a27f7b-5183-4aac-aa9b-c55e7c28b799?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=05e06c26e690b3f4d8287dbf21c9b4d9 2x, https://si.imgix.net/234f053d/uploads/origins/d8a27f7b-5183-4aac-aa9b-c55e7c28b799?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=2c48c66d0b436373e9889eee73e441c8 3x"}, "body": "初めまして、 https://skeb.jp/@noko__noko__san/works/2 こちらのアクションのイラストが本当に素敵で、同じようなものをお願いしたく、リクエストさせて頂きました。\n金額不足などは再送要請頂ければと思います。\nご確認ご検討お願いします。\n\n■キャラ\n以下の２名をお願いしたいです。自作ゲーム（ファンタジーRPG）のキャラクターです。\n\n・関係性\n長年コンビを組んでいる相棒同士。互いの腹の内を知り尽くしていて、良くも悪くも遠慮がなく、阿吽の呼吸で戦えます。\nまた、２人共護るべき家族がいる保護者です。\n\n・ペリドット\n外見25歳、実年齢36歳の男性。薬師＆高火力な植物魔法を得意とする魔導師。仲間内で最も火力が高い。\n美人寄り。所作は上品。素の表情は吊り目＆吊り眉で冷徹な印象があり、それを緩和するために、意識して眉を下げ、わざと女性のような髪型をして温厚感を出している。\n穏やかさは作っていて、根は苛烈。怒ると怒声をあらげ表情も険しくなるタイプ。本気で怒ったときの口癖は「黙れ殺すぞ」。\n\n・銀髪\n気怠げな様子がデフォルトのダウナーな男性。歳の離れた弟の親代わりだった兄。\n仕事はしっかりしているが、その反動で家では怠惰。親しい相手の前だと特に露骨。\n弟のことは大事だが、ダウナーな性格のため態度に出にくい。その結果、弟と擦れ違っていた時期があり、解消後は過保護になった。\n教師ですが、戦うことも出来る。投げナイフと氷魔法を使用。機動で先陣を切るが、他のステータスも平均以上のオールラウンダー。\n静かに怒るタイプ。\n\n・他の方へのリクエストですが、以下も参考になるかと思います。\nhttps://skeb.jp/@blanclait_you/works/4\nhttps://skeb.jp/@Cassia_1fall5/works/28\nhttps://skeb.jp/@Cassia_1fall5/works/35\nhttps://skeb.jp/@naokimineta026/works/712\n\n■シチュエーションなど\n先のリクエストと同じで恐縮ですが、同じく共闘の様子をお願いしたいです。\n\n■利用用途\n個人鑑賞です。\n他、SNS（BlueSky）での紹介、アイコン・ヘッダー利用をする場合があります。\n\n以上、ご検討お願いいたします。\n\nhttps://drive.google.com/drive/folders/1kGBo5VIGY2b2zOSNnvNKrkm1MfCuBu3L?usp=drive_link", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@noko__noko__san/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3378879, "client_id": 203995, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/c700971b/uploads/origins/9318f919-7242-45e6-9287-14fdfed2b2f8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=822d51e2acb526d91b7b8b35d4839cf8", "srcset": "https://si.imgix.net/c700971b/uploads/origins/9318f919-7242-45e6-9287-14fdfed2b2f8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=822d51e2acb526d91b7b8b35d4839cf8, https://si.imgix.net/c700971b/uploads/origins/9318f919-7242-45e6-9287-14fdfed2b2f8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ba0f5ee28fe7767ce5ca7332b261ae54 2x, https://si.imgix.net/c700971b/uploads/origins/9318f919-7242-45e6-9287-14fdfed2b2f8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d08b7b275ec9ceae6c560239b756046e 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/c700971b/uploads/origins/9318f919-7242-45e6-9287-14fdfed2b2f8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=433f3e79d9afcd4f40aef08d7044174c", "srcset": "https://si.imgix.net/c700971b/uploads/origins/9318f919-7242-45e6-9287-14fdfed2b2f8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=433f3e79d9afcd4f40aef08d7044174c, https://si.imgix.net/c700971b/uploads/origins/9318f919-7242-45e6-9287-14fdfed2b2f8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=07a7875aa4b4564bec0d973c7a332f15 2x, https://si.imgix.net/c700971b/uploads/origins/9318f919-7242-45e6-9287-14fdfed2b2f8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=82429b1311ea4751d55b072dd1dc9125 3x"}, "body": "のこ様、はじめまして！\nスタイリッシュかつ温かみもある洗練された絵柄と臨場感あるアングルやエフェクトの素晴らしさに惹かれ、リクエストをお送りいたしました。\n\n以下、今回お願いしたいキャラクターの詳細になります。SW2.5というファンタジー系TRPGで使用しているキャラクターになります。\n\n【キャラクター詳細】\n◆男性、身長187cm、不老(外見年齢は30歳前後)\n◆服装は全身立ち絵のほうでお願いしたいです。\n◆色白、銀髪、青色の瞳、薄く整った顎髭、体格は良い、額に2本の小さな角があります。\n◆世界観の上では最上位ランクの冒険者です。\n◆戦闘中は「異貌」という状態になり肌が青く、角が大きくなります。瞳孔も赤のラインが入って少し変化します。\n◆慇懃な冷血漢、野心家、軍師でもあり学問に精通した後衛魔法使いです。魔法は多属性を扱えますが、主に水氷による攻撃を得意とします。\n◆杖は持たずに、軍師として周囲を指揮する目印をつけた盾を持っています(盾は省いても構いません)。\n◆参考までにキャラクターシートを添付します。良ければ参考までにどうぞ。\n→https://yutorize.2-d.jp/ytsheet/sw2.5/?id=j7aj2u\n\n【用途・希望】\n◆戦闘中の決めシーンに使うカットインのようなイメージでお願いしたいです。\n◆「異貌」状態で、周囲を氷魔法のようなエフェクトが走っていると嬉しいです。\n◆表情は攻撃的な冷笑を浮かべている、あるいは威圧的に敵を睨んで険しい顔をしているような感じでお願いしたいです。戦闘中という雰囲気が伝わってくれば上記以外の表情でも構いません。\n◆できれば縦長の画像だと嬉しいですが、先生の描きやすさ優先で構いません。\n◆問題なければ、実際にセッション中に使用させていただいたり、製作者様を明記の上でSNSなどにご依頼品として掲載したりさせていただきたいです。\n◆可能ならば、人物と背景やエフェクト、文字などを分けたPSD形式で納品していただきたいです。\n\n最終的には、先生のセンスやイメージにお任せいたします。服装なども簡略化やアレンジをして構いません。\nお忙しいところリクエストを読んでいただきありがとうございました！\nご縁がありましたらよろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/1M1hTMUbWxkPLZD0hIwA978AS2bT4UIB6", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@noko__noko__san/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3378879, "client_id": 203884, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/3239c70d/uploads/origins/458973e4-d0c0-4fb4-91f0-4aed5b9348bf?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=11274b23d3e03d2e676bfdb770763e8b", "srcset": "https://si.imgix.net/3239c70d/uploads/origins/458973e4-d0c0-4fb4-91f0-4aed5b9348bf?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=11274b23d3e03d2e676bfdb770763e8b, https://si.imgix.net/3239c70d/uploads/origins/458973e4-d0c0-4fb4-91f0-4aed5b9348bf?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a33bdec5f7bbfe6fa0b611aa7fef9f56 2x, https://si.imgix.net/3239c70d/uploads/origins/458973e4-d0c0-4fb4-91f0-4aed5b9348bf?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=9940e9184c64a8d15aab87ad7f5dec1f 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/3239c70d/uploads/origins/458973e4-d0c0-4fb4-91f0-4aed5b9348bf?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2401f21dbf9f0327802683743e7059b4", "srcset": "https://si.imgix.net/3239c70d/uploads/origins/458973e4-d0c0-4fb4-91f0-4aed5b9348bf?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2401f21dbf9f0327802683743e7059b4, https://si.imgix.net/3239c70d/uploads/origins/458973e4-d0c0-4fb4-91f0-4aed5b9348bf?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=123186bc33e5027ca57d466a65aafa81 2x, https://si.imgix.net/3239c70d/uploads/origins/458973e4-d0c0-4fb4-91f0-4aed5b9348bf?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=e8bf55689c22885c09cabf304e104d64 3x"}, "body": "のこ様\n\nはじめまして、KIRIsame.RW（TRPG名義：あめふり）と申します。\nいつも素晴らしいNARUTOファンアートありがとうございます…！1ファンとして幸せです🍀\n現在Skeb開設中とのことで、今回はぜひハイファンタジーTRPGのOC2人をリクエストさせて頂ければと思います。\n\n■キャラクター①：ルファ\n┗1代半ば、160㎝前後、細身\n┗黒髪、金の瞳、やや色白\n┗年の割に童顔で整った顔立ち\n┗表情を作ることが苦手で基本クール\n┗警戒心が強い反面認めた相手には情が深い\n┗氷槍の使い手で身軽。斥候としても優秀\n┗右手が呪いで濃紫に変色しているため基本腕は長袖や手袋で隠している\n\n■キャラクター②：ホノビ\n┗30代後半、185㎝、筋肉質\n┗紫の短髪、濃青の瞳、日焼けした肌\n┗いわゆる糸目。開眼時は鋭い目付き\n┗平時は笑みを絶やさず飄々とした態度\n┗本性は好戦的かつ享楽的。好色でもある\n┗本業は薬師だが一流の拳闘士（特に蹴り技が得意）\n\n■イラストの希望\n┗上記のOC2人が共闘している場面をイメージしたイラストを描いて頂きたいです\n┗ルファは真剣に戦闘に臨んでいる様子、ホノビは戦闘で昂った様子＆好戦的な笑みをたたえていると嬉しいです\n┗2人とも負傷（軽度の流血）表現があるとなお良く…！（服が破れる等でルファの変色した右腕が露出していても構いません）\n┗服装は適宜変更したり簡略化してくださって大丈夫です\n\n関係性について補足すると、｢ホノビが幼いルファを森で拾った｣ことで出逢い、ルファはホノビの元で人社会での暮らしを学んでいます。\nルファにとってホノビは特別な存在ですが、ホノビはルファの将来を思って自分から遠ざけようとする節もあります。\n\nその他構図やポーズはのこ様のお好みでお任せ致します。\nもしリクエストに不備等ありましたら遠慮なくキャンセルや再送お願いいたします…！\n\n以上、ご検討だけでも宜しくお願いいたします！*ᴗ ᴗ)⁾⁾\n\nあめふり\n\nhttps://drive.google.com/drive/folders/1v6_0AwapQahrkWq-Ba1yNLWuYnstyZyD", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@noko__noko__san/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3378879, "client_id": 2718728, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/de72b079/uploads/origins/611253ba-fd96-4137-8d85-03be0f83854c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9a92062813b38c5d944d6e2cb6ce9bf6", "srcset": "https://si.imgix.net/de72b079/uploads/origins/611253ba-fd96-4137-8d85-03be0f83854c?bg=%23fff&auto=format%2Ccompress&fm=webp