43e4-b690-87a57a3110bb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=27a65c276b026fdfb98fb75a903e9317", "srcset": "https://si.imgix.net/438dc0f3/uploads/origins/a4ae0358-55c8-43e4-b690-87a57a3110bb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=27a65c276b026fdfb98fb75a903e9317, https://si.imgix.net/438dc0f3/uploads/origins/a4ae0358-55c8-43e4-b690-87a57a3110bb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=a7153e6959f337067a5fc923263be270 2x, https://si.imgix.net/438dc0f3/uploads/origins/a4ae0358-55c8-43e4-b690-87a57a3110bb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=57c8318e83edbb68eff85e2c4e5d2c17 3x"}, "body": "こんにちは。\n▽▲TRiNITY▲▽のお三方のイラストをお願いいたします。\n\n●体型\n3人ともバストは(元から大きいですが)爆乳かつ長乳、ヒップ、ウエスト、太もももむちむちにお願いします\n\n●髪型\n全員、初期髪型でOKです\n\n●服装(3人共通)\n白いノースリーブブラウスに黒or濃紺のマイクロミニタイトスカート\nベージュのニーハイストッキング(筒口は簡略化OKです)と黒いハイヒールパンプスを履いています\nブラウスは薄手なのでブラが透けています\n下着デザインは資料URLのものを参考に、ブラをフロントホックにしてください\n下着の色はそれぞれ以下をベースにお願いします\nフレンさん⇒R:236 G:29 B:47\n葉加瀬さん⇒R:238 G:255 B:255\nリオン様⇒R:204 G:61 B:123\n\n●シチュエーション\n男性チーフから見た後輩OLの3人\n\n●詳細\n※男性チーフ主観なのでチーフの描写は不要\n①休憩スペースで立ち話して談笑する3人\n\n②周囲の目を盗み揃ってチーフに背を向けてお尻を露出させ、尻肉に指を食い込ませて挑発しています\n(この段階で3人とも1度したチーフとのセックスが忘れられず、どハマりしています)\nお尻にはチーフを煽る下品な落書き入り\n鼻息を荒くして振り向きながら、フェラ素振りや手コキ素振りをしています\n\n③3人とも発情したメス顔で脚をがに股に開き、腰を激しく前後させて交尾懇願\n3人に下品な淫語だらけのセリフで必死にチン媚びさせてください\nスカートがずり上がりショーツ丸出しなのに加え、自らの手でTフロントの形にしてパイパンにぐいぐい食い込ませ、ギリギリ割れ目が見えていないだけのハミマンにしています\n秘部から愛液がどんどん溢れ、床に水たまりを作っています\nブラウスのボタン、ブラのホックが外れ3人の爆乳が露わになっています\n各々、空いた手で勃起した乳首や乳輪を愛撫しています\n\n④3人がひっくり返ったカエルのような無様な姿勢で、ばっくり開いた膣と尻穴から精液を垂れ流してベッドに転がされています\n体中精液まみれで、使用済みコンドームが体の上やベッドに散乱\nアダルトグッズも周りに乱雑に置かれています\n3人とも鼻フックで美貌が台無しです\n犯し尽くされた余韻に浸りながら、汚い低音おほ声で呻いています\n\n要望、以上です。\nご検討のほど、よろしくお願いいたします。\n\nhttps://share.evernote.com/note/7b3535a5-249f-b441-d8e0-edf5af188b5d", "nc": 168, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@nipenipesusu/works/10", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/f2973202/uploads/origins/7e2b8c55-d976-4560-ad16-faf0c6542d5d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=8e37b9013fcf108a1a111c2f30674614", "srcset": "https://si.imgix.net/f2973202/uploads/origins/7e2b8c55-d976-4560-ad16-faf0c6542d5d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=8e37b9013fcf108a1a111c2f30674614, https://si.imgix.net/f2973202/uploads/origins/7e2b8c55-d976-4560-ad16-faf0c6542d5d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=a71d2f118a3f59333ac7762b602d1f5b 2x, https://si.imgix.net/f2973202/uploads/origins/7e2b8c55-d976-4560-ad16-faf0c6542d5d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=59b21990bc7c2da84bcc019b9b80259a 3x"}, "private": true, "genre": "art", "tipped": true, "creator_id": 3618840, "client_id": 1639501, "nc": 160}, {"path": "/@nipenipesusu/works/9", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3618840, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/087fbd66/uploads/origins/955c8351-38ec-4a85-938b-bddb5fef459f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0082d5df0e37fe6cc33878e07c49e9a2", "srcset": "https://si.imgix.net/087fbd66/uploads/origins/955c8351-38ec-4a85-938b-bddb5fef459f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0082d5df0e37fe6cc33878e07c49e9a2, https://si.imgix.net/087fbd66/uploads/origins/955c8351-38ec-4a85-938b-bddb5fef459f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=5b4f9af71c6cb1dd8076df7af58acf3c 2x, https://si.imgix.net/087fbd66/uploads/origins/955c8351-38ec-4a85-938b-bddb5fef459f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=3bb1163a5d3bc93045192eecc8228cf5 3x"}, "duration": null, "nsfw": true, "hardcore": true, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/087fbd66/uploads/origins/955c8351-38ec-4a85-938b-bddb5fef459f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=7db8c7cb4d6577a78469c97088a0bf82", "srcset": "https://si.imgix.net/087fbd66/uploads/origins/955c8351-38ec-4a85-938b-bddb5fef459f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=7db8c7cb4d6577a78469c97088a0bf82, https://si.imgix.net/087fbd66/uploads/origins/955c8351-38ec-4a85-938b-bddb5fef459f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=650a9050ab8489148b4a29b1f1042b33 2x, https://si.imgix.net/087fbd66/uploads/origins/955c8351-38ec-4a85-938b-bddb5fef459f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=73055658870e82f25a350f0a1271b26b 3x"}, "body": "竜胆尊の無様エロを描いて頂けないでしょうか\n\n以下はこういうのが好きという参考程度で大丈夫です\n\nお金に困って立ちんぼやデリヘル的な性商売やっててほしいです\n買ってもらうために必死で下品な誘い方や何人でもどんなプレイでもアリで客集めをしてほしいです\n「ちゃんとやんないと金払わねえぞ」的な事言われて要求された事はなんでも必死にひょっとこフェラしたりアナル舐めなどしてほしいです\n最終的に騙されて輪されたりお金を払われないとか巡回中の警察にレイプされるとか可哀想なことになってほしいです\n\n\n体はだらしない感じで胸はかなり巨乳か長乳　陰毛や腋毛はジョリジョリかボサボサだと嬉しいですがどちらでも大丈夫です\nエロ蹲踞、体に落書きされる、髪の毛がっつり引っ張られる、ヘッドロック首絞め、イラマチオ、ブスや豚、オナホ等の暴言、腹ボコや喉ボコ、殴打、チンカス掃除、タバコの灰皿にされる、開口機や全頭マスク鼻フック、子宮潰れるぅ的な描写等の尊厳破壊するような無様なことされるのが好きです\n胸や乳首を乱暴に扱う描写が好きなのでねじったり抓ったりビンタ、洗濯バサミやリング等の道具、握り潰したり噛み跡つけたり痛そうな事があると嬉しいです\nエグいアへ顔、白目向きそうなイキ顔、食いしばって痛がる、ブサイクなグポグポ必死なフェラ顔、無様にンホ声オホ声等の表情が崩れるのも大好きです\n\nNGないので無様でハードな内容だと嬉しいです\n\n欲望を書きなぐってしまいすみません\n上記は本当に参考程度なので無視でも問題ないです\n気に入らない場合全く関係なくても大丈夫ですのでおまかせで自由に描いて頂けるとありがたいです\nもし金額的に大丈夫なら数ページの漫画のような形で描いて頂けないでしょうか", "nc": 58, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@nipenipesusu/works/8", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3618840, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/b5bea93b/uploads/origins/2cf23a0d-daf9-419f-a3f8-52a711152735?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ce35a7d8a1cb7c177915dbc6f9c9b99e", "srcset": "https://si.imgix.net/b5bea93b/uploads/origins/2cf23a0d-daf9-419f-a3f8-52a711152735?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ce35a7d8a1cb7c177915dbc6f9c9b99e, https://si.imgix.net/b5bea93b/uploads/origins/2cf23a0d-daf9-419f-a3f8-52a711152735?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=d8d7954599261bd4758b181219f4cc11 2x, https://si.imgix.net/b5bea93b/uploads/origins/2cf23a0d-daf9-419f-a3f8-52a711152735?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=9128db4441439fab5cb670677806ccaa 3x"}, "duration": null, "nsfw": true, "hardcore": true, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/b5bea93b/uploads/origins/2cf23a0d-daf9-419f-a3f8-52a711152735?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=eea8dcae4a4ac4872e439751b2a93aec", "srcset": "https://si.imgix.net/b5bea93b/uploads/origins/2cf23a0d-daf9-419f-a3f8-52a711152735?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=eea8dcae4a4ac4872e439751b2a93aec, https://si.imgix.net/b5bea93b/uploads/origins/2cf23a0d-daf9-419f-a3f8-52a711152735?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=fb448367bae691f86a65ae798cf91203 2x, https://si.imgix.net/b5bea93b/uploads/origins/2cf23a0d-daf9-419f-a3f8-52a711152735?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=fe0b3e50b69ee95d912bff66a97843ff 3x"}, "body": "はじめまして。\n女の子にひたすらオシッコを浴びせかけて飲尿させるイラストは可能でしょうか？\n描いていただきたいのはこの娘です。多少ロリ化しても大丈夫です。\n\nhttps://www.pixiv.net/artworks/129276975\nhttps://www.pixiv.net/artworks/136262100\nhttps://www.pixiv.net/artworks/127696094\n\nプレイ内容ですが、\n女の子を拘束し、小便器をくり抜いたモノを被せて人間便器にしてほしいです。\nイメージはこちらです。\n\nhttps://www.pixiv.net/artworks/115548353\nhttps://www.pixiv.net/artworks/131541510\n\n画角・構図は縦長比で、女の子の真正面少し上からが理想です。\n放尿している男が見ている景色を拡大した感じ。男はペニス周辺のみで大丈夫です。\n\nストーリーですが、\n女の子はご主人様から便器プレイを調教されます。\nご主人様の小便器となり、ご主人様を楽しませなければなりません。\nまた、小便器に排水口はありません。便女の口という排水口があるので不要なのです。\nご主人様は便女の顔面や頭の上を狙って放尿します。口元を狙う必要はありません。来る時が来れば自然と排水されるので、狙う必要がないのです。\n\nまた、便女は笑顔を強要されます。\n「はい！笑顔笑顔www」と命令されながら小便器としての仕事をこなします。\n小便器にされた美少女が黄色い汚水にマミレ、溺れ、涙を流しながらも笑顔でご主人様の尿を受け入れるのです。\n\n最初のうちは髪と顔が汚れる程度です。しかしながら尿はどんどん溜まっていきます。\n水位が上がってくると顔にかけられる尿、じょぼじょぼと溜まり跳ねる尿により放尿中は呼吸が難しくなります。\n\n水位が鼻を越えるとお楽しみの時間です。\n放尿中は一切呼吸ができません。そしてそれは放尿が終わっても同じです。\nいよいよ便女は出された小便を全て排水しなければなりません。\nそんな中でも笑顔を求められます。\nご主人様の目の前には、便器にされた美少女が、自らが浴びせかけている小便に溺れながら、涙を流し、必死に飲尿し続ける光景が広がっているのです。\n\nこんな感じでお願いいたします。\nアヘ顔や白目をむいている描写は不要です。", "nc": 170, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@nipenipesusu/works/7", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/e957697c/uploads/origins/d0c885f8-d4eb-4816-80ff-0266fad8b27e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=4afd1f18d41ff740bc936386ce5fa8e4", "srcset": "https://si.imgix.net/e957697c/uploads/origins/d0c885f8-d4eb-4816-80ff-0266fad8b27e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=4afd1f18d41ff740bc936386ce5fa8e4, https://si.imgix.net/e957697c/uploads/origins/d0c885f8-d4eb-4816-80ff-0266fad8b27e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFF