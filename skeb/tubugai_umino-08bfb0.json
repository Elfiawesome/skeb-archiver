: [{"path": "/@tsuyu_tsuyuri06/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3644864, "client_id": 3763364, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/d568e254/uploads/origins/85474c3b-409b-474e-9ef9-f1d8efede8af?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=17eb284421c290c1c8856e7a991a4e96", "srcset": "https://si.imgix.net/d568e254/uploads/origins/85474c3b-409b-474e-9ef9-f1d8efede8af?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=17eb284421c290c1c8856e7a991a4e96, https://si.imgix.net/d568e254/uploads/origins/85474c3b-409b-474e-9ef9-f1d8efede8af?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=98672c191f6e2def36fa72393ef6a39e 2x, https://si.imgix.net/d568e254/uploads/origins/85474c3b-409b-474e-9ef9-f1d8efede8af?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=7b56acc0fad723fe7c45010405318dd4 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/d568e254/uploads/origins/85474c3b-409b-474e-9ef9-f1d8efede8af?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=4cf5e14ec9ac02b2e74f716b6f7e72c3", "srcset": "https://si.imgix.net/d568e254/uploads/origins/85474c3b-409b-474e-9ef9-f1d8efede8af?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=4cf5e14ec9ac02b2e74f716b6f7e72c3, https://si.imgix.net/d568e254/uploads/origins/85474c3b-409b-474e-9ef9-f1d8efede8af?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=c1b54c458744eaa0d4cf594bc642fca5 2x, https://si.imgix.net/d568e254/uploads/origins/85474c3b-409b-474e-9ef9-f1d8efede8af?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=a4e6ac7ce3ce67ca6b9151dad32b8279 3x"}, "body": "こんにちは！\n\n前回、林葉を描いて頂いた春ウララです。再度、栗花落ツユ様のイラストでウチのコを見たい！と思いリピート依頼させていただきます。\n\n描いていただきたいのは、以前配信で行われていた「皆のオリキャラ募集」に応募させていただいたキャラクターの、私が元々デザインしていたオリジナル版です。\n\n企画に応募した際のバージョンとは、髪型などのデザインが少し異なっていますが、性格やキャラクター設定は基本的に同じです。\n\n今回のご依頼では、添付している三面図のデザインを元に描いていただければと思います。\n\n[三面図]\nhttps://drive.google.com/file/d/13yKtdI0nyXsBLohJ3bxkG3X0H62QHKAi/view?usp=drivesdk\n\n以前にも一度依頼させていただき、その際もとても素敵に描いていただいたので、今回もお願いできたら嬉しいです！\n\n【キャラクター】\n桜井おはぎ（さくらい おはぎ）\n・和菓子屋の娘で、中学2年生の女の子です。\n・よく食べ、よく走り、よく眠る、とにかく元気いっぱいな子です。\n・生き物が大好きで、何でもかんでも生き物なら好きになってしまう子です。\n※恋愛感情ではありません。\n\n【お願いしたいこと】\n・絵柄や等身感は、栗花落ツユ様の普段の絵柄でお願いいたします。\n・ポーズは「桜井おはぎに似合いそう」と思ったものを自由に描いていただけると嬉しいです。\n・衣装も多少のアレンジは大歓迎です。\n\n【残していただきたい要素】\n・髪の紫のメッシュ\n・タレ目＋吊り眉（マロ眉）の要素\n\n【使用用途】\n・SNSのアイコン\n・個人で楽しむ範囲でのグッズ化\n使用する際は、栗花落ツユ様に描いていただいた作品であることを明記いたします。\n\nなお、今回の三面図をお送りすることで、配信で使用されているキャラクターデザインを変更するかどうかについては、お任せいたします。\n\nもし難しい場合や、依頼内容に添えないと感じられた場合は、キャンセルしていただいて問題ありません。\n長文になってしまいましたが、ご検討いただけますと幸いです。\nよろしくお願いいたします。\n\nhttps://drive.google.com/file/d/13yKtdI0nyXsBLohJ3bxkG3X0H62QHKAi/view?usp=drivesdk", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@tsuyu_tsuyuri06/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3644864, "client_id": 3763364, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/a8677cb6/uploads/origins/df9b51b6-89d7-447b-8489-44064e418deb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=813c7588bc310ce56e1a03ab6297e0d5", "srcset": "https://si.imgix.net/a8677cb6/uploads/origins/df9b51b6-89d7-447b-8489-44064e418deb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=813c7588bc310ce56e1a03ab6297e0d5, https://si.imgix.net/a8677cb6/uploads/origins/df9b51b6-89d7-447b-8489-44064e418deb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=89b6d0c293b023b5f05cbc9106ec0edc 2x, https://si.imgix.net/a8677cb6/uploads/origins/df9b51b6-89d7-447b-8489-44064e418deb?bg=%23fff&auto=format%2Ccompre