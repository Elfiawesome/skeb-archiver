d358/uploads/origins/90f358e7-8cb2-4563-96fa-f04c86b51b49?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d5f47fe1dfe500d85ad4ba7c9bdfb939 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/245cd358/uploads/origins/90f358e7-8cb2-4563-96fa-f04c86b51b49?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a5194fdb80512b574d66894831c2d657", "srcset": "https://si.imgix.net/245cd358/uploads/origins/90f358e7-8cb2-4563-96fa-f04c86b51b49?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a5194fdb80512b574d66894831c2d657, https://si.imgix.net/245cd358/uploads/origins/90f358e7-8cb2-4563-96fa-f04c86b51b49?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=5274ba162506144b7ca9fb0ec1e15d89 2x, https://si.imgix.net/245cd358/uploads/origins/90f358e7-8cb2-4563-96fa-f04c86b51b49?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=6e33faace2211e4a153ce1f6db272a34 3x"}, "body": "お世話になります。新しいイラストを描き下ろしていただきたく\n依頼をさせていただきたいと思います。\n\n今回はクラシック（吹奏楽）の曲を聴いていただいて、\n先生が思い浮かべる情景を思う存分表現していただければと思います。\nただし、条件を一つつけさせてください。\n\nテーマは「海！（浜辺・海岸・港等場所は先生のイメージにお任せします）」\n先生が素直に思った風景（海という条件付きですが）表現してください。\n\n曲のタイトルは「エアーズ」（4分くらい）\n参考音源（音量注意）最初音小さいです。\nhttps://www.youtube.com/watch?v=3_jt7W1ylFI\n\n女の子の仕様です。（これでもかっていうくらい「かわいく」←最重要）\n・丸眼鏡（はっきりわかるように、下方向に少しずれるとなお可）\n・制服はブレザー（今までにない斬新なデザインを期待します。但し、リボンはピンク色 \n・目は大きく\n・髪の毛の色（茶髪）\n・髪型（ツインテールで出来れば結び目に黄色リボンのアクセントが欲しいです）\n・スカートの色は水色でチェック柄で短め\n・靴はローファー\n・サイズは横1920*縦1080ピクセルでお願いします。納品ファイル形式は、psd、jpgでお願いします。\n\nご検討の程、よろしくお願いいたします。(\n（条件が折り合わなければキャンセルしてください。）", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@kagamon2/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 4202, "client_id": 544647, "vtt_url": null, "thumbnail_image_