aae/uploads/origins/20a1c912-d57f-41a8-bae6-65d6bdb8be21?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5a95df0745fe15c4a9d705625a1e22ca, https://si.imgix.net/32db4aae/uploads/origins/20a1c912-d57f-41a8-bae6-65d6bdb8be21?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=8b28293fc3b120206e233a3660a5742c 2x, https://si.imgix.net/32db4aae/uploads/origins/20a1c912-d57f-41a8-bae6-65d6bdb8be21?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=d52998e48d60fbec1a5df18825aa363c 3x"}, "body": "ホラ、アミーゴ......私たちのビッグママ2人のクロスオーバー作品に興味があるんだけど、今回は他の若い男と3Pするんだ。ママレッドはその大きなお尻で男の顔を覆い隠し、マグランドラはその大きな胸で男におっぱいを与え、パイズリをしてほしい。2人のママは衣装参考写真のような体操服を着て、魅惑的なドヤ顔をしてほしい。マグランドラの胸は、スポーツブラで引き締まった巨乳にし、その下から乳首を覗かせるようにする。ママレッドのポーズとサイズは、2枚目の参考画像と同様にして、ショーツがとてもタイトに見えるようにしてください。もし、2枚目の写真のように太ったママを描くことに抵抗があるのであれば、以前依頼したSkebのように大きくすることも可能です。2つのアルトが欲しいです。1つは前述したようにすべてが正常で、もう1つは、男がマグランドラの胸の中に大量に膿んで、彼女の胸の谷間からはじけるようなものです。\n https://drive.google.com/drive/folders/1CH25ODyHNIfwwVECGFWVu6re7Wu11VES?usp=share_link\n\nhttps://drive.google.com/drive/folders/1CH25ODyHNIfwwVECGFWVu6re7Wu11VES?usp=share_link", "nc": 33, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@rusedy400Nm/works/8", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 80400, "client_id": 802079, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/f01e2783/uploads/origins/1dcab2ae-5bb8-4725-aca2-043c4683629d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a535d6a46f366235cb034d7ca77d659a", "srcset": "https://si.imgix.net/f01e2783/uploads/origins/1dcab2ae-5bb8-4725-aca2-043c4683629d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a535d6a46f366235cb034d7ca77d659a, https://si.imgix.net/f01e2783/uploads/origins/1dcab2ae-5bb8-4725-aca2-043c4683629d?bg=%23fff&auto=format%2Ccompress&fm=web