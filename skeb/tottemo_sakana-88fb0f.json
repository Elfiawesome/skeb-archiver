おります！\n🐡さんの衣装デザインや装飾無機物が大好きで…よければ🐡さんに衣装デザインおまかせで自探を着せ替えて描いて頂けないかなと思ってる次第です…！ \n縛りのようなものが多いため幅がとりにくいかと思うのですがご検討いただけたら幸いです！\n\n\n───\n\n・白基調×黄色/薄茶×水色差し色\nが多いですがこの限りでは無いので色増やしたり減らしたりして頂いても大丈夫です！\n\n・目は隠れています。「見ないようにしている」方なので資料のようなベールじゃなくても大丈夫なのですが透ける素材は避けて頂けたらと思います🙇‍♂️\n\n・かなり露出が少ないです。一応資料の方に髪型も載せていますが基本見えないものとしていただければ…\n\n・男ですが仕草はだいぶ女性的で控えめです。\n\n・杖持ったり等完全ファンタジー世界線にして頂いても大丈夫です！\n\nhttps://www.evernote.com/shard/s617/sh/60ae6e4b-5bb2-89f3-6af8-41d8dedc6f3b/BHS3bBUTRUovEWjtQgFBqP54fiJ6-qjvzjtrCi10YXVxsKqLcHJ0ucZHxQ", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@tottemo_sakana/works/19", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1374066, "client_id": 938496, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/7cca3c71/uploads/origins/c65ec20f-61ed-4124-814d-6c9a987edd1e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e02f594577bbd895c16b34747c6ab9e8", "srcset": "https://si.imgix.net/7cca3c71/uploads/origins/c65ec20f-61ed-4124-814d-6c9a987edd1e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e02f594577bbd895c16b34747c6ab9e8, https://si.imgix.net/7cca3c71/uploads/origins/c65ec20f-61ed-4124-814d-6c9a987edd1e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=7b6cd5b530f49c8848d7d07c8dbce79c 2x, https://si.imgix.net/7cca3c71/uploads/origins/c65ec20f-61ed-4124-814d-6c9a987edd1e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=393ba6b496b5424f2b3a5f8f207b6219 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/7cca3c71/uploads/origins/c65ec20f-61ed-4124-814d-6c9a987edd1e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=74c86fb731c2ae4c6bcde18f119f47ba", "srcset": "https://si.imgix.net/7cca3c71/uploads/origins/c65ec20f-61ed-4124-814d-6