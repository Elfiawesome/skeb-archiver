て擦り合わせるのを少し早くなりフィニッシュ→終わった後「まだ時間ある？時間までシようぜ」と竿役はいい再び開始(ここからもし可能であればで言いですが、4コマにて２つは見えない描写で正常位にて兜合わせしてる所、もう２つは中の構造が薄く見えるようにして、男の娘がお互いの竿を兜合わせ手コキしたりお互いの竿を持って亀頭部を擦り合わせてる描写があると🙏)\n→玄関にて「またシようぜ」と竿役は言って男の娘が出た後入り口前にて(気持ち良かった)と男の娘は心の中で言って終わり。\n\n所々のセリフはお任せいたします。\n\n長文となり、申し訳ございません、何卒ご検討の方お願いします！！！", "nc": 49, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@blkawaiiero/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2487454, "client_id": 393776, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/aa6e7937/uploads/origins/a0047d41-a69d-4126-83f1-06fce1a94253?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e3fac91203f6b172d644c0978736fa58", "srcset": "https://si.imgix.net/aa6e7937/uploads/origins/a0047d41-a69d-4126-83f1-06fce1a94253?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e3fac91203f6b172d644c0978736fa58, https://si.imgix.net/aa6e7937/uploads/origins/a0047d41-a69d-4126-83f1-06fce1a94253?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=5d96c10d3fc93e8ceffeb314d2eea58f 2x, https://si.imgix.net/aa6e7937/uploads/origins/a0047d41-a69d-4126-83f1-06fce1a94253?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=0e8a74d7d66275bfd8c98270f590c6dd 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/aa6e7937/uploads/origins/a0047d41-a69d-4126-83f1-06fce1a94253?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ab7187bb366892147d079a3e4341dbb5", "srcset": "https://si.imgix.net/aa6e7937/uploads/origins/a0047d41-a69d-4126-83f1-06fce1a94253?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ab7187bb366892147d079a3e4341dbb5, https://si.imgix.net/aa6e7937/uploads/origins/a0047d41-a69d-4126-83f1-06fce1a94253?bg=%23fff&auto=format%2