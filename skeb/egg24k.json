33-49c0-9849-0ae37bbc557d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e5dbaf5f91bf1bb5ee8fa3ebc38bb7bb", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/f709ee83/uploads/origins/42d4ce31-4533-49c0-9849-0ae37bbc557d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6720253468f7a35da37e248f00043625", "src_set": ""}, "body": "こんにちは！\n\n私はあなたのアートワーク・スタイルをとても楽しんでいます......私はリクエストを出したいと思います。\n\nリクエストは、この2人のキャラクターを使ったイメージでしょうか：\n\nシュウジ： https://drive.google.com/drive/u/1/folders/1djL8lAIO_T10WLh-WgM43EupKCra8N0G\n\nキヨ： https://drive.google.com/drive/u/1/folders/15akmGdQmlTUYQy4wcICYpcbzNh1DJQug\n\n二人は交際中です。修二は、キヨのネクタイを直しながら、少し赤面して立っていることでしょう。この画像のような感じでしょうか。また、二人の身長差の画像をここに入れ、背景を追加する場合は、https://drive.google.com/drive/folders/11KsRejOJVxUpry5E9rVTriBPBRqcVJrR?usp=sharing。\n\nキヨは微笑みながら、シュウジのどちらかを見ているか、携帯電話を持っているはずです。キヨはまた、非常に微妙にシュウジのお尻をつかむでしょう。\n\n私の要望を考慮していただき、本当にありがとうございました！", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@egg24k/works/11", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 490431, "client_id": 896623, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/3552e504/uploads/origins/1cf803a9-207d-43ec-a415-d9af985f1b0a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b6f6d52ca0db5f321c3eaf56a3215b8f", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/3552e504/uploads/origins/1cf803a9-207d-43ec-a415-d9af985f1b0a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b9e34efcd4a88a5250ee64baed182303", "src_set": ""}, "body": "先日は素晴らしいイラストをありがとうございました。二人の距離感や関係性、日々の生活が滲み出た素敵なイラストで、思わず目から汗が出ました…\nもしかして、拙作にも目を通していただけたのでしょうか。主とレギオン二人の纏う空気が本当に良かったです。\n\nリピートで恐縮なのですが、イオギオスとオルメロスもどうしても拝見したくなり、お願いしに参りました。\n\n小説本編\nhttps://estar.jp/novels/26081775\nキャラ設定ページ\nhttps://estar.jp/novels/26085138/viewer?page=1\n\nよろしくお願い致します。", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@egg24k/works/10", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 490431, "client_id": 896623, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/5213e1cb/uploads/origins/f8fc47c3-edd8-43b3-b05e-095456766051?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a1fd1be2918c67ced120aad987574e22", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/5213e1cb/uploads/origins/f8fc47c3-edd8-43b3-b05e-095456766051?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=8135656457273549874b084690e71a7a", "src_set": ""}, "body": "はじめまして。柔らかな色合いと美しい線に一目惚れしてしまいまして、是非オリジナルキャラのイラストをお願いしたくリクエストさせていただきます。\n小説本編\nhttps://estar.jp/novels/26081775\nキャラ設定ページ\nhttps://estar.jp/novels/26085138/viewer?page=1\n\n主要人物のうち「主」と「レギオン」のイラストをお願い致します。\n世界観としては中世ヨーロッパをイメージした架空の剣と魔法の世界です。\nよろしくお願い致します。", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@egg24k/works/9", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 490431, "client_id": 2617526, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/f2f99413/uploads/origins/06d2bcee-0995-4688-855a-be77747150d4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e81e301dbe7452fed6b23739de7c67a3", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/f2f99413/uploads/origins/06d2bcee-0995-4688-855a-be77747150d4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d241b3a44a9639df236ed3c6cdf07da4", "src_set": ""}, "body": "初めまして！\nVtuber準備中の緑鳥乃ういと申します！\nたまこ先生の描く馬や人物のイラストにとても惹かれましたので今回リクエスト送らせて頂きます！\n\n私は、和風の花魁衣装を着て森で暮らしているキジです。\n\n【使用用途】\n・Twitterでの使用\n\n【要望】\n馬とおでこを合わせていて幸せに見えるような構図でお願いしたいです！\n目をつぶっていても開いていてもかまいません！\n先生の描きやすい方法で大丈夫です！\n\n・PSDデータで納品いただけると幸いです。\nもしメッセージなどがあれば分けてもらえると嬉しいです！\n\n【画像】\nこちらに私の参考資料を貼らせて頂きますので、ご確認ください。\nhttps://drive.google.com/drive/folders/1SLjlxViW8OCKLAi8v1es_lo85CnuIM5y?usp=sharing\n\nご縁がありますことを、心より願っております。", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@egg24k/works/8", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 490431, "client_id": 195625, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/4e0397f9/uploads/origins/b6f8c381-aeb9-4100-b2d0-bf3877a98ac2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=97fd414060f4025fd3067e6648299d59", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/4e0397f9/uploads/origins/b6f8c381-aeb9-4100-b2d0-bf3877a98ac2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=800f1b0539e2b309747de4457a3b60ce", "src_set": ""}, "body": "たまこ先生、はじめまして！\nフォローしている方がリクエストした作品でたまこ先生のイラストを拝見させていただきました。\n\nたまこ先生のコラージュがとっても好きです。\n描いてほしいキャラクターほこの二人です！\nhttps://www.pixiv.net/en/artworks/79213638\nマントの下の設定\nhttps://www.pixiv.net/en/artworks/79794009\n\n二人の関係の概要：\nコミカルとくだらないな喧嘩（夫婦喧嘩？）みたいと思います。命の恩人と唯一、化け物化の体の治療しかできない博士に中世を誓ったけど、博士の振り回し、社交障害やちょっと変わっている思考に時々限界を突破して喧嘩になるときがあります。例えばせっかく服を整理してもなんで色違い靴下を履くなど。普通の関係ではないです。\n\n服装、ポーズ、表情、構図などはたまこ先生にお任せいたします。むしろセーラー服っぽいマントを外していただければ幸いです。\nサインを別レイヤーでお願いいたします。\n\nよろしくお願いいたします。", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@egg24k/works/7", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/61d802d1/uploads/origins/e2049848-d6c1-467a-b362-7b07b8980427?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=db7c06027229e9fb70c970ac245eb8da", "src_set": ""}, "private": true, "genre": "art", "tipped": false, "creator_id": 490431, "client_id": 2238883, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 144, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@egg24k/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 490431, "client_id": 1909688, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/c7a538c3/uploads/origins/3f2478ee-0dfa-4bae-9b34-1d7daf9396e2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1f9200c1c781cea89e070638b52e7275", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/c7a538c3/uploads/origins/3f2478ee-0dfa-4bae-9b34-1d7daf9396e2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=daf5e1e51e17386134debf891e7ad858", "src_set": ""}, "body": "I love your artworks and would like to request an illustration for these 2^^\n\n◇https://toyhou.se/15104352.heka\n◇https://toyhou.se/15485032.kousa\n\nPlease draw Heka in a similar outfit:\n◇https://pin.it/71S4AJ2\n◇https://pin.it/78CvE1b\n◇https://pin.it/5h2RYIV\n\nFor Kousa, I'd like something similar here:\n◇https://pin.it/75TLNlb\n◇https://pin.it/19OqG9a\n◇https://pin.it/gt8eiMJ\n\nFeel free to redesign however you see fit^^\n\nHeka is a genius and heir to his family. He has noble blood and has a reserved, logical and calculative mindset. \n\nThey're best friends! Kousa is a lesser noble that runs a postal service^^ He is very popular, charismatic and sociable. He's training to be a knight for Heka. They're a very scary and powerful duo. When Kousa is off duty he likes to make sure Heka has fun too so they don't lose sight of who they are.\n\nThey are both 15 here, composition and poses are up to you! Please don't draw Kousa's wing and Heka's hat. Please include Heka's pocketwatch!\n\nThank you!!", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@egg24k/works/5", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/88d116d9/uploads/origins/ca0e7631-3f27-4f1a-a010-0e5f1524092a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=5c172e200a53d8178e32a91ac1136fa7", "src_set": ""}, "private": true, "genre": "art", "tipped": false, "creator_id": 490431, "client_id": 0, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 17, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@egg24k/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 490431, "client_id": 1219396, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/dde495e9/uploads/origins/2b4bb6d8-120b-453c-8121-76db4648db4d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=daa11b569eebf4dd7853976d308cf808", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/dde495e9/uploads/origins/2b4bb6d8-120b-453c-8121-76db4648db4d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=734ab2b55c0b54c057815b97a3898e68", "src_set": ""}, "body": "Hello sensei! I really like the first skeb you drew! May I request a similar one with 2 characters? \n\nCharacter 1 (Jade Crow): A boy who used to live on the streets before getting hired by Yingfei (2). He is very cynical and reserved because he saw how cruel humans are. He is polite on the surface and smiles easily, but is a short-tempered man inside. You can choose either clothes A and B.\n\nCharacter 2 (Yingfei): A wealthy and beautiful young man who is always smiling. He is very clever and selfish even though he looks polite. He is also very spoiled and lazy too because of his upbringing. \n\nMore information about their relationship and themes can be found in the link.\n\nI will leave the composition to sensei!\n\nFeel free to raise the price or cancel if it is not appropriate! Thank you so much!!\n\nhttps://sta.sh/2nhff2do55?edit=1", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@egg24k/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 490431, "client_id": 0, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/4aa5be4e/uploads/origins/4d009064-280d-4781-aea9-e21b12843e9e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c7468f49b7916f3b8c5f83c1705cc587", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/4aa5be4e/uploads/origins/4d009064-280d-4781-aea9-e21b12843e9e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=4547e96a14410e3ab2575e2df754c3ce", "src_set": ""}, "body": "こんにちは！たまこ様の描かれるイラストはとてもかわいらしく、色使いも素敵で、お馬さんもとっても可愛いですね！\n是非私のオリジナルキャラクターのBLカップルがお馬さんに乗っているところを描いていただけないかと思いリクエストさせていただきました！\n\n世界観　中世ヨーロッパ風ファンタジー\n\nキャラクター\n・名前　リカルド（攻）\n・32歳くらい\n・男\n・茶髪・くせ毛・少し褐色の肌、緑の眼・隻眼\n・189Cmくらいで筋肉質\n・某国の将軍。貴族父と奴隷の母の間に生まれる。体格を生かした格闘や剣術が得意。性格は誰にでも優しくおおらかで天然人たらし、恋愛事にはちょっと鈍い\n\n・名前　ノクス（受）\n・32歳くらい\n・男・金髪・碧眼・切れ長の目\n・178ｃｍくらい\n・あまり筋肉はない\n・某国の将軍。貴族の次男。頭が切れ、士官学校を首席で卒業。性格は計算高く野心家で口も悪い。プライドが高く素直になれないツンデレ。リカルドに対して激重感情を持っている。お酒には弱く酔うと素直になる。\n\n\n二人は士官学校からの同級生でライバルであり、親友であり、恋人同士という関係です。\n基本的にはノクス(受）の方が激重感情を持っていて、プライドの高さからなかなか素直になれなくて冷たくあたってしまいますが、そんなところもリカルド(攻）は可愛いなと思っていて、二人は付き合って10年くらいの熟年カップルのようです。\n\n是非お馬さんに乗った二人のちびキャラをお願いできませんでしょうか？リカルドの馬は青毛か黒鹿毛で、ノクスの馬は葦毛か白毛でお願いしたいです。\n下記にキャラクターのメモと参考画像をＵPしておりますが、たまこ様のほうで衣装や髪形など自由にアレンジしていただいて大丈夫です！\n\n好みに合わなかったり、料金に見合わない場合はキャンセルしていただいて大丈夫です。\n\n是非たまこ様に私うちの子を描いていただけるととても嬉しいので、何卒ご検討のほど、宜しくお願い致します！！\n\nhttps://www.dropbox.com/sh/uz3t5xvcvmldkb6/AAAv_GkTynW4xPOknVfzR8-ra?dl=0", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@egg24k/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 490431, "client_id": 0, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/b1b9f1a9/uploads/origins/596a7229-8104-4b36-af85-0e4fc6ce75bc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=898abb1cfcdfca2f4e4c18eb7da0bdc9", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/b1b9f1a9/uploads/origins/596a7229-8104-4b36-af85-0e4fc6ce75bc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=fd121d2e316b49a0f0d7f5cd1ab3a658", "src_set": ""}, "body": "初めまして。たまこ様の描かれるイラストはとてもかわいらしく美しいですね！是非私のオリジナルキャラクターのBLカップルを描いていただけないかと思いリクエストさせていただきました！LOVE要素はあってもなくても大丈夫です！\n\n世界観　アラビアンファンタジー風\n\nキャラクター\n・名前　ユリウス（攻）\n・28歳くらい\n・男\n・金髪・少しウェーブのかかった長髪\n・碧眼、まつげ長め\n・185Cmくらいで少し筋肉質、肩幅は広くて腰は細い\n・某国の皇太子。性格は俺様で横柄、少しS気がある\n\n\n・名前　アサド（受）\n・25歳くらい\n・黒髪\n・目は紫\n・178ｃｍくらい\n・褐色の肌、筋肉質（ソフトマッチョくらい、ユリウスよりはある）\n・元奴隷の剣闘士、性格はクールで真面目、不愛想、ストイック\n\n\n元々はユリウス(攻）の命をアサド(受）が狙って、その時に今まで感じたことのないスリルと興奮を感じて、それからアサドが気に入り、そばに置くようになったという関係です。\n基本的にはのユリウスの方が押しまくっていて、アサドの方は最初は拒否っていましたがだんだん絆されてきた感じですが、まだ素直にはなれない感じです。(ツンデレ）\n\nポーズやシチュエーションですが、たまこ様がこの二人から思いつくイメージで自由に書いていただければと思います。\n\n下記にキャラクターのメモと参考画像をＵPしておりますが、たまこ様のほうで衣装や髪形など自由にアレンジしていただいて大丈夫です！\n\n好みに合わなかったり、料金に見合わない場合はキャンセルしていただいて大丈夫です。\n\n是非たまこ様に私うちの子を描いていただけるととっても嬉しいので、ご検討のほど、何卒宜しくお願い致します。\n\n(リクエストを受けていただけるようでしたら可能でしたら納品時サインは別レイヤーにしていただけると嬉しいです！）\n\nhttps://www.dropbox.com/sh/278jrzplu33r99b/AADMogZwXfk9AyiL7NwaiiTQa?dl=0", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@egg24k/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 490431, "client_id": 350566, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/9751b3cb/uploads/origins/27e6cc2c-72c0-4a75-a1f7-1d21635c7fcc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6ab77a5bd11cce23aad0631105a4d6be", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/9751b3cb/uploads/origins/27e6cc2c-72c0-4a75-a1f7-1d21635c7fcc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=bfb03418ada4a92fcfee06ff0f088c85", "src_set": ""}, "body": "たまこ様、はじめまして！ツイッターでイラストをとても楽しく拝見させて頂きました。素敵な絵柄に惹かれて、可能ならば自キャラ2人を依頼したいと思っております。\n\n【依頼内容】\nキャラ参照は下記のURLをご覧ください。中華風ファンタジー世界に一緒に旅をしている「ライバル」関係の2人で、相手に負けたくないけど何故か微妙に距離が近くて、相手のことも気が掛かっています。\n\n【🦢1】雅楽師の子。身長は178㎝。冬の凍った湖の様に、優雅で冷たい性格。自分に厳しくて不器用なため、素直に気持ちを伝えるには慣れていません。背中に鶴の様な翼が生えてます。【2】に対してツンデレの様な態度を取ってます。\n\n【🐯2】武術家の子。身長は185cm。虎に育ってられた野生児。子供っぽくて直単な性格。素直すぎるところもあり、鈍感で自分が【1】のことが好きだとまだ気づいていませんので、相手に対していつも挑戦的です。\n\n可能ならば、「流浪者」のテーマの一枚をお願い致します。竹林か山道、または他の中華風モチーフを入れて頂ければ大変嬉しいです。衣装を簡略化・アレンジしても全然構いません。ポーズや構図は何でも大丈夫ですので、お気軽に描いてください！\n\n依頼内容に何か難しいか問題点があれば、是非断ってください。ご検討のほど、何卒宜しくお願い致します。\n\nhttps://sta.sh/2zvn336o2b3", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "similar_creators": [{"id": 7997, "creator": true, "nsfw_acceptable": true, "acceptable": false, "name": "壱松ウロ⍤", "screen_name": "uro_odr", "avatar_url": "https://pbs.twimg.com/profile_images/1334381936874164225/As113tZd.jpg", "header_url": "https://pbs.twimg.com/profile_banners/216473126/1537036776/1500x50