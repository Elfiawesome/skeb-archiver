txt=PRIVATE&s=04b3afd9588bcc613e3dd746bc076d1b", "src_set": ""}, "private": true, "genre": "art", "tipped": false, "creator_id": 1280557, "client_id": 42184, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 144, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@bkyuuocha/works/148", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1280557, "client_id": 625515, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/c5b088bc/uploads/origins/1c8b939f-2d4d-450a-beed-20f66aec2f66?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=017a7421509193a5d882cc83cc87465c", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/c5b088bc/uploads/origins/1c8b939f-2d4d-450a-beed-20f66aec2f66?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f4145d11230710d18a8b04fea17ce7e3", "src_set": ""}, "body": "こんにちは。\nB茶先生の描かれるミリ姫ジューコフさんを摂取したくなったのでリクエストお願いします！\n\n【キャラ】ミリ姫大戦のジューコフ\n\n【服装】金ビキニ\n\n【ポーズ】お任せします\n\n【そのほか】でっかい長乳おっぱいに描いていただけると嬉しいです！", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@bkyuuocha/works/147", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1280557, "client_id": 0, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/10541b2f/uploads/origins/61626aef-cec7-48a5-a1e3-f802282e3946?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3f8858a81b44d2825d3397e166fef52b", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/10541b2f/uploads/origins/61626aef-cec7-48a5-a1e3-f802282e3946?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5ebf49b1b44cfc403db01f26ab532d6c", "src_set": ""}, "body": "初めまして。\n「邪神ちゃんドロップキック」に登場した歩きスマホのお姉さんをリクエストさせていただきます。\nカラーで登場している場面はありませんが、画像05、06のような感じの色合いでお任せいたします。また、「…」のような無言の吹き出しもなくて大丈夫です。\n\n①：膝から上のカットで、作中のノースリーブ縦セタ姿でスマホを見ている。バッグはなくてOKです。ポーズはお任せしますが、腕で胸元が隠れないようにお願いいたします。\n\n②：①の差分で、こちらの作品（https://skeb.jp/@bkyuuocha/works/136）のような牛柄ビキニ姿。\n\n③：すし詰めの満員電車で、正面を向き合って男と密着した状態。男視点のアングルで胸が大きく潰れているが、お姉さんは横を向いてスマホを見て男に全く無関心。\n周囲の様子と男の体は、ぎゅうぎゅう詰めなのが何となく分かればあまり描き込んでいただかなくて大丈夫です。\n（状況のイメージとしては、電車の運行中に一時的に密着しているのではなく、台風等で電車が止まってぎゅうぎゅう詰めで長時間密着状態という感じです。）\n\nお引き受けいただけるようでしたら、よろしくお願いいたします。\n\nhttps://drive.google.com/file/d/1Vb3L_Vo5wwqBpA8D4Ci2bphVjGEFquKJ/view?usp=sharing", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@bkyuuocha/works/146", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1280557, "client_id": 9863, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/97f4ecf8/uploads/origins/70e2c9d9-1c59-442a-abf0-299d76a33461?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5a3a0c81b7efda411614c76ed944d0e5", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/97f4ecf8/uploads/origins/70e2c9d9-1c59-442a-abf0-299d76a33461?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=037e974990ab1e5899aedea15ab23758", "src_set": ""}, "body": "遥かなる円形世界に登場するお好きなキャラをセレクトしていただいてビキニイラストをお願いしたいです。\nシチュエーション、構成等はすべてお任せします。\nご検討の程、宜しくお願いします。", "nc": 176, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@bkyuuocha/works/145", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1280557, "client_id": 295265, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/b0be93e8/uploads/origins/cb8efff0-5710-4090-9754-09e5047e9e2a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d7d26cf70a80e7ca9511f5b53bfd9009", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/b0be93e8/uploads/origins/cb8efff0-5710-4090-9754-09e5047e9e2a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ca22ff3f6d92144750e4713cdb3042ae", "src_set": ""}, "body": "資料URLのオリジナルキャラ「MOMO」をお願いします！\n\n黒い肌の質感はエナメルやゴムのような光沢のある感じでお願いします\n瞳、髪の毛、眉、睫毛、その他身体や衣服の白い箇所は発光しているような感じでお願いします\n目は強膜が黒く、瞳はカメラのレンズのようになっています\nキャラの色は極力白っぽい色と黒っぽい色以外は使わないで頂けると嬉しいです\n口内を描く場合はモノクロでお願いします\n\nお好みで好きなコスチュームを着せて頂いても大丈夫です\nその場合黒を基調に、白い部分はワンポイントやライン程度に抑えて発光させてください\n\nその他、デザインは難しいと感じられた部分は簡略化したり、そうでなくとも好みでアレンジして頂いて大丈夫です\nおっぱいやお尻、太ももなどお好みで盛ってもいいですよ！\n\nhttps://x.com/tukumo81/status/1519269578316034048", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@bkyuuocha/works/144", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1280557, "client_id": 0, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/ceab7ee5/uploads/origins/79137b3d-5426-4509-914a-53bd8593d4ac?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fa6a669e6f9f886e6080dbc964bf20e9", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/ceab7ee5/uploads/origins/79137b3d-5426-4509-914a-53bd8593d4ac?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=fca740efc24af58aef6ee2b8eb99c3a9", "src_set": ""}, "body": "東方の小野塚小町で青いビキニを着ており、\nhttps://skeb.jp/@bkyuuocha/works/134\nこちらの幽々子様のようなすごい大きな長い垂れ軟乳を水着で持ち上げているイメージで、\n横向きでちょっと前屈みの姿勢になっていて、おっぱいがぶら〜んと垂れ下がっており、おっぱいが重すぎて今にも水着の紐がちぎれそうな感じのものをお願いできないでしょうか。\n\nhttps://dic.pixiv.net/a/%E5%B0%8F%E9%87%8E%E5%A1%9A%E5%B0%8F%E7%94%BA", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@bkyuuocha/works/143", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1280557, "client_id": 3003459, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/69a917b6/uploads/origins/be7f946b-b7f5-402f-986b-691b55fedba7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f9c7622301a24909248f8219e84c27b4", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/69a917b6/uploads/origins/be7f946b-b7f5-402f-986b-691b55fedba7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2e0604264fd571c4be95e3a6903af959", "src_set": ""}, "body": "こんにちは。うちの子イラストをお願いできますでしょうか。\n\nキャラと服装は下記URL\nhttps://drive.google.com/drive/folders/11wDNt79woy_KZVqdM93_fOmKkEmI5_UZ\n\n外見\n・身長165cm前後、肌の色は明るい\n・スレンダーボディで巨乳(Iカップ)、長乳、巨尻、太ももはムチムチ。\n・おっぱいは垂れ乳な感じ\n\n\n構図は下記URLのようなイメージ、胸の谷間を強調した構図お願いします\nhttps://skeb.jp/@bkyuuocha/works/136\nhttps://skeb.jp/@bkyuuocha/works/106\n・挑発的な表情\n\n他の細かな点はお任せします。\n\n以上がリクエスト内容です\n不都合などございませんでしたらご検討よろしくお願いします", "nc": 32, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@bkyuuocha/works/142", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1280557, "client_id": 35829, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/fc94fdf1/uploads/origins/01588415-78a2-4f6e-af81-7ebfdb793a53?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=30e2bddad6984d66ad532e950a2fce44", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/fc94fdf1/uploads/origins/01588415-78a2-4f6e-af81-7ebfdb793a53?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f95a0ac39ec567029409dd21a04892eb", "src_set": ""}, "body": "以前はとてもムチムチなフローラルミント制服姿のド・グラースさんの絵を有難うございました。\n今回は、星の欠片の物語というゲームの女の子の依頼です。(無名ですが台詞から、のじゃ子さんと呼んでます)\n\n・参考1:https://x.com/planetarian1981/status/1599321007562846209\n　参考2(星の欠片の物語関係):https://www.pixiv.net/users/2912745\n　参考3: https://skeb.jp/@ikejun_now/works/13\n　参考4: https://x.com/planetarian1981/status/1858109173814485171?s=46&t=uJMmlOUvE7nMv7nNm7Frtw\n\n　スカートは公式より短いのが希望。\n　具体的には参考3と同じかそれより少し短いくらい。\n\n体型\n・公式よりお胸とお尻は大きいのが希望。\n　具体的には参考3より少し大きいくらい。（ただ、以前依頼したド・グラースさんよりは確実に小さくして下さい）\nポーズ,構図\n・斜め前からの構図で前屈みでこちらを見てる全体絵。なお、その時はキューブをお胸の下に抱え込んで胸が変形してる状態。\n・前屈み状態でキューブをお胸の下に抱え込んで胸が変形してる状態を、少し斜め後ろから見た状態の背後絵。また、その状態だとお尻が突き出されている状態になってますが、パンモロしてる状態を希望。\nそれらは基本的に参考3の状態ですが、背後絵の方は参考3の背後後とは異なり、多少角度を付けてキューブに乗ったお胸が見える状態にして下さい。\n背後絵の描画範囲は、少なくとも参考3の背後絵の描画範囲ですが、出来れば頭の上から太もも全部の範囲を希望します。\nまた、背後絵は以前依頼した下記フローラルミント制服姿のグラースさんの様に、分割配置した一枚絵にしてもOkです。\nhttps://skeb.jp/@bkyuuocha/works/109\n\n\n以上、検討宜しくお願い致します。", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@bkyuuocha/works/141", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1280557, "client_id": 0, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/0619c77f/uploads/origins/e872f2c1-409d-4161-b854-ebb8439a3718?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=20f743004a9a5ed32eee123f9faf0e66", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/0619c77f/uploads/origins/e872f2c1-409d-4161-b854-ebb8439a3718?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=dfa27c657ea3e2f0ee8ddac51a5c9623", "src_set": ""}, "body": "ブリーチ・ネム\n隊服\n無表情\n汗蒸れ\nクソデカ爆乳\n\n構図イメージ\nhttps://x.com/SrBready/status/1816287407182131263?t=tPDJEUWQWOco-SOSfdRV2g&s=19\n\nおっぱいイメージ\n上向き爆乳\nhttps://skeb.jp/@izanagi_oto/works/40    \n\n無表情で汗蒸れしながら爆乳突き出してくるイメージです。\n隊服はﾊﾟﾂﾝﾊﾟﾂﾝではちきれそうです。\nよろしくお願い致します。", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@bkyuuocha/works/140", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1280557, "client_id": 0, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/2aa6c77d/uploads/origins/c0fe11a9-9920-4b15-9b82-dac792df246b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d74908d08d1317f7ba09e3f4c0bc7b91", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/2aa6c77d/uploads/origins/c0fe11a9-9920-4b15-9b82-dac792df246b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=52130f9333ad00cea0396561893ebca5", "src_set": ""}, "body": "初めまして、いつも素晴らしいイラストをお描きになるので依頼させて頂きました。 以下がその内容となります。  \nキャラクター　ドラセナ（ゴシックは魔法乙女）  \n表情　誘っているようなほほ笑み  \n体型　盛ってください、程度としては過去イラストのヤワラギ・ヒヨリ（ビキニ）くらいでお願いします  \n肌　いつものイラストのようにテカテカ光っている感じ\n衣装　アメスク、白いワイシャツ、中はメタリックパープルのビキニ、スカートは黒と紫色のチェックでベリーショート、太ももが8割くらい見えるタイツ  \n装飾　首には参考資料2の蝙蝠姫ドラセナと同じチョーカー、耳に参考資料2の蝙蝠姫ドラセナと同じイヤリング、両腕に金色の腕輪 \nポーズ　参考資料5をベースに左手を下げ、右手を上げている状態と学校机にたいして軽く腰を掛けている感じに変更 \n背景　昼間の学校  \nアングル・描写範囲　顔と体が真正面を向き頭から膝あたりまで描いてください  \n参考資料１　https://www.pixiv.net/artworks/56415839　 参考資料2　https://www.pixiv.net/artworks/79066424 参考資料3　https://www.pixiv.net/artworks/81049084 参考資料4　https://www.pixiv.net/artworks/89689674 参考資料5　https://www.apex-toy.com/productinfo/2285289.html  \n以上となります。 長くなりましたが、どうぞよろしくお願い致します。", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@bkyuuocha/works/139", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1280557, "client_id": 284832, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/e9f0e704/uploads/origins/871cb26c-70f7-4ca5-9a9a-5e43ad1eb895?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=84ecbf0f13e34795e201f0d89ba95eac", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/e9f0e704/uploads/origins/871cb26c-70f7-4ca5-9a9a-5e43ad1eb895?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=1539a5f65b4d904d718b4528a3a8d4d1", "src_set": ""}, "body": "こんばんは！\n\n久しぶりにM2HBのイラストをリクエストします。\n\nM2HBが「乳牛ビキニの代わりに」と言って、シマウマ柄のビキニを着ている姿を見たいです。\n同柄のグローブやストッキング、シマウマ耳やしっぽのアクセサリーも着けて、乳牛ビキニの違うタイプのような感じでお願いします！", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@bkyuuocha/works/138", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1280557, "client_id": 0, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/988a750a/uploads/origins/532593e4-7d4e-435d-b46f-6fa53c03f510?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=13025aac7b3e2f5dccc9c96539a20668", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/988a750a/uploads/origins/532593e4-7d4e-435d-b46f-6fa53c03f510?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=7a3ceb65fa835354af1e7d31063a3df9", "src_set": ""}, "body": "東方の八雲紫で、\nhttps://skeb.jp/@bkyuuocha/works/134\nこちらの幽々子様と同様のサイズの軟乳垂れ乳で\n幽々子様と比較すると、おっぱいを水着で持ち上げていないような、自由に長く伸びているところにビキニをふわっと被せて紐を縛り、体にぎゅっと押し付けるように着ているような着こなし\n水着の位置がとても低く、あぁとても長乳だなぁ、というようなものをお願いできないでしょうか。", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@bkyuuocha/works/137", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1280557, "client_id": 319441, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/631d83d1/uploads/origins/cb9f159a-fb29-43ad-819c-c0512e36cb7a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4275b66c73ced27729d8b612c231c72f", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/631d83d1/uploads/origins/cb9f159a-fb29-43ad-819c-c0512e36cb7a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d0e2989399a61f7746803d6904fe2f59", "src_set": ""}, "body": "リクエスト失礼します\n\nキャラ：\nミリ姫大戦のジロー\n\nシチュ：\nハニートラップ発動中のジロー。お酒に酔ったフリをして、体温上がってきたのか服を着崩して、顔を赤らめ意味ありげにニマァと笑みを浮かべながらヨコシマな視線をこちらに投げかけています。\n\n指定：\n・兵装は省略願います\n・服装などは自由、簡略化やアレンジもＯＫです\n・なお、この依頼において肌露出の重要度は低いです。最優先は表情で、全年齢の範囲内で下心満載のスーパー不健全な表情でお願いします\n\n指定以外の部分についてはそちらにお任せ致します\n以上、ご検討頂けると幸いです\n宜しくお願いします", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@bkyuuocha/works/136", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1280557, "client_id": 111376, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/1809fdce/uploads/origins/8094b830-7fd3-47a9-9f84-a957363a4f20?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d88ed8adb3a5b800e705b95c910f3db9", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/1809fdce/uploads/origins/8094b830-7fd3-47a9-9f84-a957363a4f20?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9feb392ff3fc288b1989c1e0484990bb", "src_set": ""}, "body": "いつもお世話になっております。\n前回依頼した金屋あざみさんの絵が大変素晴らしかったので再度依頼をいたしました。\n今回は牛柄ビキニでのあざみさんを希望いたします。\nポーズや構図に関しましてはB茶様にお任せいたします。\n\n何卒、よろしくお願いいたします。", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}], "similar_creators": [{"id": 518176, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "５５５５", "screen_name": "matsudai_d", "avatar_url": "https://pbs.twimg.com/profile_images/1968994610279268352/XokLbEwf.jpg", "header_url": "https://pbs.twimg.com/