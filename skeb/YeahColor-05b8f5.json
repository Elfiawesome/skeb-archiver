ます）\n\n【構図など】\n・薄く微笑んでる\n・バストアップ\n・正面を向いている（立ち絵的な感じ）\n・背景は透過版と黒江の時のような四角で色付きのものが欲しい\n\n【用途】\n・Youtubeでのチャンネルのアイコン\n・配信時に掲載する立ち絵\n・サムネイルなどにのせる画像\nなどを想定しています。\n\n元となるものがなくふわっとした依頼になってしまいますが、難しく考えずに気楽に想像を形にしてほしいです。\n是非、ご健闘のほどよろしくお願いいたします。", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@YeahColor/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 902199, "client_id": 342351, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/368a5920/uploads/origins/4e9d1986-d841-413d-ab05-9a9d36845566?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8a3309cdc7bd59e325f1a60f04865fcd", "srcset": "https://si.imgix.net/368a5920/uploads/origins/4e9d1986-d841-413d-ab05-9a9d36845566?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8a3309cdc7bd59e325f1a60f04865fcd, https://si.imgix.net/368a5920/uploads/origins/4e9d1986-d841-413d-ab05-9a9d36845566?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=743f1ca7f9946b8c0214d8dd4e5b6cfc 2x, https://si.imgix.net/368a5920/uploads/origins/4e9d1986-d841-413d-ab05-9a9d36845566?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=6bc376cded57cc87432b0c4729e773c4 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/368a5920/uploads/origins/4e9d1986-d841-413d-ab05-9a9d36845566?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=efe428d3d1c2e6aaefee045aad6c5f9b", "srcset": "https://si.imgix.net/368a5920/uploads/origins/4e9d1986-d841-413d-ab05-9a9d36845566?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=efe428d3d1c2e6aaefee045aad6c5f9b, https://si.imgix.net/368a5920/uploads/origins/4e9d1986-d841-413d-ab05-9a9d36845566?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&bl