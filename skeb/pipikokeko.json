db-9f9e6a919ede?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=45c8404fa85bf5104235fd6ec9c25f21 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/96472a7b/uploads/origins/c7fb8971-98c4-48ca-89db-9f9e6a919ede?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6e09dfb3785d8217af69971b482bb7d0", "srcset": "https://si.imgix.net/96472a7b/uploads/origins/c7fb8971-98c4-48ca-89db-9f9e6a919ede?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6e09dfb3785d8217af69971b482bb7d0, https://si.imgix.net/96472a7b/uploads/origins/c7fb8971-98c4-48ca-89db-9f9e6a919ede?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=9ee4417462977ac121b6832be9af03ee 2x, https://si.imgix.net/96472a7b/uploads/origins/c7fb8971-98c4-48ca-89db-9f9e6a919ede?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=f0c80038b7eddcde8455be35ae714e85 3x"}, "body": "リクエスト失礼します。\nアリス・マーガトロイドちゃんが永江衣玖さんとの弾幕勝負に負けてしまい、「アリスさんをたっぷり可愛がりたい」と空気を読み取った衣玖さんがアリスを羽衣で縛り上げ、背後から乳首を摘み電流を流すイラストをお願いします。\nアリスは両目を閉じて感じながら悲鳴を上げ、衣玖さんはニッコリ笑顔でお願いします。\n構図や台詞等はお任せします。どうぞよろしくお願いします。", "nc": 32, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@pipikokeko/works/8", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2610783, "client_id": 180981, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/b25eeb21/uploads/origins/c60d993a-aca1-4dc2-b6b9-c5ee45446264?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=589115da1de73938d26ce5967221cc0a", "srcset": "https://si.imgix.net/b25eeb21/uploads/origins/c60d993a-aca1-4dc2-b6b9-c5ee45446264?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=589115da1de73938d26ce5967221cc0a, https://si.imgix.net/b25eeb21/uploads/origins/c60d993a-aca1-4dc2-b6b9-c5ee45446264?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=8a606223a3f90291362ba85fd1ca4871 2x, https://si.imgix.net/b25eeb21/uploads/origins/c60d993a-aca1-4dc2-b6b9-c5ee45446264?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=1fc398cb4a65a188524672993595eb99 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/b25eeb21/uploads/origins/c60d993a-aca1-4dc2-b6b9-c5ee45446264?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d754b3c623bc6c6529609f0953d21222", "srcset": "https://si.imgix.net/b25eeb21/uploads/origins/c60d993a-aca1-4dc2-b6b9-c5ee45446264?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d754b3c623bc6c6529609f0953d21222, https://si.imgix.net/b25eeb21/uploads/origins/c60d993a-aca1-4dc2-b6b9-c5ee45446264?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=aa9120765e2e5d6f613d8d9ea5d5fec4 2x, https://si.imgix.net/b25eeb21/uploads/origins/c60d993a-aca1-4dc2-b6b9-c5ee45446264?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=2b979007ee21dc60576149ca1b5c6e47 3x"}, "body": "今回も艦これの時津風がポケモンのアーボックに巻き付かれている絵をお願いします。\n\nアーボックに巻き付かれる前からで\n①アーボックが目の前に現れ「大きな蛇さんだー」みたいな表情で危機感がない。\n②巻き付かれ初めて？みたいになっている。\n③半分ぐらい巻き付かれて「やめてよ～」みたいになっている。\n④全身巻き付かれて「は、離せ～」みたいになっている。その時アーボックの頭は時津風の頭の上にあり舌を出している(前回の絵のような感じです)\n⑤締め付けが始まり「嫌！」みたいになっている。\n⑥だが全力ではなく気持ちよくて感じてしまっている。\nをベースにして頂けると嬉しいです（書きやすいようでしたらセリフやシーンを追加して頂いても大丈夫です）　\n\n又、大丈夫ならアーボックの通常色と色違いのをお願いします。\n一枚（又は複数枚）でまとめて頂くか、一枚づつかはご負担が少ない方で(同じなら一枚づつ)お願いします。", "nc": 49, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@pipikokeko/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2610783, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.