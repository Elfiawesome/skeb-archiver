auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e041fa41b0bb3ee09002a27859e63cb2", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/2156fcec/uploads/origins/27dc04d3-9312-47a1-8556-063551a13f57?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=eada3a78a4762563e461a99da852b83d", "src_set": ""}, "body": "お世話になっております。\n前回は素敵なにとりちゃんのイラストありがとうございました。\n\n今回は河城にとりと山城たかねの百合えっちをお願いします。\nシチュエーション：\n　・にとりちゃん受け・たかねちゃん攻め\n\n構図：\n　・たかねちゃんがにとりちゃんを愛撫しています。\n　・にとりちゃんの体系は前回依頼時と変わらず、たかねちゃんについては先生にお任せします。\n　・にとりちゃんの胸が見えている構図でお願いします。\n　・たかねちゃんの表情はSっ気がある感じでお願いします。\n　・もしよろしければ、にとりちゃんの両手が縛られていると幸いです。\n　　（もし縛っていただけるなら縛り方はお任せします。）\n\nその他の構図やポーズ、台詞などはお任せ致します。\nもし内容が難しいのであればキャンセルしていただいても構いません。\n\nご検討よろしくお願いいたします。", "nc": 161, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@pipikokeko/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2610783, "client_id": 180981, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/388aa9a3/uploads/origins/89ccda34-77f3-4536-bd8b-d9099166f615?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f0fb16fd45d842bdc7dff92f41acd386", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/388aa9a3/uploads/origins/89ccda34-77f3-4536-bd8b-d9099166f615?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3c30a51b56479940680be19cfbf57b04", "src_set": ""}, "body": "かなり特殊なリクエストになります。無理な場合はキャンセルを、非表示をご希望の場合は再送要請ををお願いします。\n\n艦これの時津風がポケモンのアーボックに巻き付かれている絵をお願いします\n\nアーボックは時津風の首から下を４巻程で隙間なく巻き付け、時津風の頭の上に頭を乗せ鼻の付近まで舌を出して下さい。アーボックの口は閉じてください。\n全身巻き付かれている事を強調する為、時津風の全身（しつこくて申し訳ございませんが首から下は足も見えないぐらい隙間なく全身巻き付けて下さい）を描いて頂けるとうれしいです。\n又、できればアーボックは通常色と色違いをお願いします。\n又、さらに大丈夫ならアーボックの尻尾で首を巻き付けているパターンと巻き付けていないパターン(どちらかでしたら巻き付けていないパターン)をお願いします。\n\n時津風の表情ですが、大丈夫でしたら以下の通り（無理なようでしたら①と④を優先でお願いします）又、できればどの表情もアーボックは通常色と色違いをお願いします。\n①締め付けられて涙目で苦しんでいる（目は閉じています）\n②苦しんでいるけど若干感じていて赤面になっている（目は閉じています）\n③苦しいけど若干気持ちよくて恥ずかしがっている（目は開けています）\n④嬉しくて締め付けられているのに笑っている（目は開けています）", "nc": 33, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@pipikokeko/works/5", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/98989dfd/uploads/origins/6cf79d1f-e687-47de-bc89-6c71ff9d8c33?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=2f23b8b46f9efd441e12376998399392", "src_set": ""}, "private": true, "genre": "art", "tipped": true, "creator_id": 2610783, "client_id": 383443, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 161, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@pipikokeko/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2610783, "client_id": 0, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/fd77e2db/uploads/origins/33777e47-3f5f-4592-9eab-5ec9eeb3f726?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d8fc5ac1d2493fdfe5579fcadafc6765", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/fd77e2db/uploads/origins/33777e47-3f5f-4592-9eab-5ec9eeb3f726?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5cea9675acf34143e8d81ba97ed9ca73", "src_set": ""}, "body": "前回のにとりちゃんはありがとうございました。\n\n今回も東方projectの河城にとりちゃんのイラストをお願いします。\n\n・ベットの上でローターを使ってオナニーをしています。\n・服装は黒のタンクトップで、スカートやパンツは履いていない状態でお願いします。\n・乳首がはだけている状態で、片手ではだけた乳首を弄りながら、\n　もう片方の手でローターを性器に押し当てています。\n・おっぱいのサイズは前回のにとりちゃんと同様のサイズでお願いします。\n・下の毛はなしでお願