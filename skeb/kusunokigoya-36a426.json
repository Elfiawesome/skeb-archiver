m=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=72afd1b375d3a51d3ee7d154bf2df76d 2x, https://si.imgix.net/9d2a4edb/uploads/origins/4ddfdbf6-40bd-4b30-a78a-f43f4f39ac5e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=59b1d19d6d11f1bc46a0256b3862015a 3x"}, "body": "クスノキ様、初めまして。\nskebからおすすめで紹介を受けて、絵柄が可愛かったのでリクエストさせてください。\n\n内容ですが、うちの子（FF14のミコッテという種族です）のパンチライラストをお願いしたいです。\n\nJK風の制服（夏服）着用。\nパンツは薄い水色の縞パンでお願いします。\n\n横向きの4:3くらいの比率のキャンバスに\nいわゆるMtUウィルスのような構図で\n左手前に、体育座りのように膝を立てて座り内股ぎみに左右に足を開いたところを、正面から見た時の足の間にパンチラ（パンツがスカートで隠れておらず、むしろこちらにパンツ越しのまん肉を見せつけてるような感じで）。\n右背景に、立った状態から落ちてる物を拾うように前屈みになったところを、後方ローアングルから見た時のパンチラ（こちらが覗いているのをわかっていて敢えてお尻とまん肉をプリっと見せてるような感じで）をお願いします。\n\nいずれのパンチラも、ぷっくりとしたおまんまんの肉の膨らみや、パンツ表面に浮かぶスジ、シワなどに注力して戴けると幸いです。\n上半身の方も見える場合はうっすらと透けブラしてる感じでお願いします。\n\n手前と背景はそれぞれレイヤーを分けて戴きたいです。\nまた宛名等についても別レイヤーでお願いします。\n\n体育座りの方は全身がキャンバスに入り、相対的にあまり小さくならない程度の大きさで描いてください。\nローアングルの方は膝裏から上くらいが入る、お尻がアップになるような感じでお願いします。\n\nミコッテはいわゆる猫耳系のキャラとなりますが、耳の形状が一般的な猫耳とは少々趣が異なっておりますので、うまく汲み取って頂ければ幸いです。\n\nご検討よろしくお願いします。\n\nhttps://drive.google.com/drive/u/0/folders/1oPSkN9zZi_L1TtENpPGedCiZ3dUF_M2o", "nc": 48, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}], "sent_works": [], "similar_creators": [{"id": 29464, "creator": true, "nsfw_acceptable": true, "acceptable": false, "name": "アカマ輝", "screen_name": "bb_m0024", "avatar_url": "https://pbs.twimg.com/profile_images/1965791785403469824/NIKNgGnU.jpg", "header_url": "https://pbs.twimg.com/profile_banners/899675326095040512/1757653941/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 120, "skills": [{"genre": "art"}], "banned": false, "nc": 176}, {"id": 30163, "creator": true, "nsfw_acceptable": true, "acceptable": false, "name": "瀬戸内", "screen_name": "blackse", "avatar_url": "https://pbs.twi