4I9roZJiCNlFWYXqlqZ5aBUtywNA__&Key-Pair-Id=K1GS3H53SEO647", "duration": 230, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1509908789088071682%2FcyPTeFBI.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e8a112f96cafdf1ac57c12353cafad27", "srcset": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1509908789088071682%2FcyPTeFBI.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e8a112f96cafdf1ac57c12353cafad27, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1509908789088071682%2FcyPTeFBI.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=4246c572c9b5bf15f8f4ad98d5318f68 2x, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1509908789088071682%2FcyPTeFBI.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=317b243082e346fd8340d6df0d95b802 3x"}, "body": "リクエスト失礼いたします！\n以前お送りしたシチュボがすごく良かったので再度リクエストさせていただきました！少し長めですがもしよければ是非よろしくお願いいたします🙇‍♂️\n内容的には捕らえた男スパイを調教する女拷問官でド見下す感じでお願いしたいです🙇\n男はガチガチに拘束されており女拷問にくすぐりなどの調教を受けるシチュで最後に少し逆転あり。といった形です！\n\n以下が台本になります！\n目が覚めたか。スパイ男。\n動けないか？。気をつけの姿勢で体中をベルトでベッドに固定しているからな。ぴくりとも動けないだろう。足の指まで結束バンドで拘束しているからな。無駄な抵抗はやめろ。\nああ、何か言いたそうだが目隠しとボールギャグは外さないからな。今日から1週間、おまえの乳首と足の裏を徹底的に調教する。\nその間ボールギャグは絶対に外さないから、お前は1週間後に情報を吐くか決めろ。\nでは、まずは乳首責めからだな。\n…ビクッとしたな。女に拘束されて無抵抗に乳首を責められて感じてるのか？この変態め。\nおいおい。もう乳首も下もビンビンだな。\n乳首だけでここまでになるとは思ったよりもマゾだな。\nなら次は足の裏だな。\n指まで拘束されたお前の足の裏を今から徹底的にくすぐってやる。\nああ、その間乳首もさびしくならないようにニップルドームを付けてやろう。\nどうだ？休むことなく乳首を責められて苦しいか？\nこの状態で足の裏をくすぐったらどうなるんだろうな？\nほら、こちょこちょこちょ〜。\n…なんて情けない姿だ。\nボールギャグから涎をこぼしながら叫んで、惨めだなw\nっておいおい？まさか乳首と足の裏の刺激だけでイクのか？本当に気持ちが悪いな…\n\n…ほら、イケよ。乳首と足の裏でイケ。\n全身をガチガチに拘束されて、ボールギャグまで噛まされて情けなく喘ぎながら乳首と足裏でイケ。\n\n【ここで場面切り替わり】\n\nん…私は…スパイを拷問していてそれからって動けない…？手足が縛られてる。なっ！？…キサマあんなガチガチな拘束から抜け出すなんて…\nくそっ…私をどうする気だ？\n…それはボールギャグ か？まさかキサマ私にそれを…んむっ！(ここからボールギャグをつけられて足の裏をくすぐられる。口枷越しのくぐもった感じで『足の裏はやめろ』とかボールギャグ を外せとかをお願いしたいです！", "nc": 56, "word_count": 0, "transcoder": "audio", "creator_acceptable_same_genre": false}, {"path": "/@grisugram/works/8", "private_thumbnail_image_urls": null, "private": false, "genre": "voice", "tipped": true, "creator_id": 2858068, "client_id": 335764, "vtt_url": "https://fcdn.skeb.jp/uploads/outputs/e39f80ce-8293-4677-b03e-0b041b37714d?response-content-disposition=inline&Expires=1788017643&Signature=rE1AVsYv2zfzp0OcN3SSTRbkZU-m~LGtANgkZpVvs2KIbAnc9MbhK0QX7P71Lbkro5hyIei6uTmIa6a7KSW3MbpcTTGOaLkzq-Au~TMug~7UTzO0P3avQSifcxdqrpdz3A9G6iH~tZOsXCwp~kpYwoupUuijP1G~vfSd1mdp~bOyYWpT-961RvRklKIceQIipHu4oYPTKswvOTtwa5dgQMZKt0AYSZjfFnxMqJD5mQjIFqzUBa4n5qvH8XX7L6dIFDZNnJwTrPb3KFYD0vrQdILuwFy-d5dpG1S4yZm3Hjh5EaFKtthw~7m34i3kT2MZF0V63Ff8-uqOkUt8DP-uMw__&Key-Pair-Id=K1GS3H53SEO647", "thumbnail_image_urls": {"src": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1509908789088071682%2FcyPTeFBI.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=59ababfe6082f3225895784cbf86d6cd", "srcset": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1509908789088071682%2FcyPTeFBI.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=59ababfe6082f3225895784cbf86d6cd, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1509908789088071682%2FcyPTeFBI.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=8df4bb6afe67fe4e928834697f2b9d3e 2x, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1509908789088071682%2FcyPTeFBI.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b8e2abdcd2adb3bf22791b89a868c5b9 3x"}, "preview_url": "https://fcdn.skeb.jp/uploads/outputs/fa4c7045-f3ba-4488-bf2e-22c465dbb736?response-content-disposition=inline&Expires=1788017643&Signature=Yw5zNYWiwN2