構図はすべてお任せいたします。腰より上から描写されているとサムネイルとして使いやすいのでとても助かります。\n活動に使用したいのでもし背景が存在する場合、人物と背景で分かれているPSDファイルをいただければと思っております。髪の毛や服等も一枚絵では見切れている場合でもPSDファイル内では見切れていない状態でいただければとても助かります。\n\n\nご縁がありましたらよろしくお願いいたします。", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Niii777_/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3465707, "client_id": 297356, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/a32e02a3/uploads/origins/98e5717e-4b44-48f8-bc0c-08a0014c2367?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4e4b956f7720e6af663b4d85d23ca7f4", "srcset": "https://si.imgix.net/a32e02a3/uploads/origins/98e5717e-4b44-48f8-bc0c-08a0014c2367?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4e4b956f7720e6af663b4d85d23ca7f4, https://si.imgix.net/a32e02a3/uploads/origins/98e5717e-4b44-48f8-bc0c-08a0014c2367?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=40ae582a57ad4958c60dc108f6a74ca5 2x, https://si.imgix.net/a32e02a3/uploads/origins/98e5717e-4b44-48f8-bc0c-08a0014c2367?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=26c4f3d0e03399e4e6b08864ce8f7e5e 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/a32e02a3/uploads/origins/98e5717e-4b44-48f8-bc0c-08a0014c2367?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a9631926e1da3e206a4599492df41224", "srcset": "https://si.imgix.net/a32e02a3/uploads/origins/98e5717e-4b44-48f8-bc0c-08a0014c2367?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a9631926e1da3e206a4599492df41224, https://si.imgix.net/a32e02a3/uploads/origins/98e5717e-4b44-48f8-bc0c-08a0014c2367?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=244d8c5321ac0b451f28b5954cdea