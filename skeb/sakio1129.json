f84b6c6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5b204d141a8c53ca3500705b96d3e62e, https://si.imgix.net/65ac5a74/uploads/origins/8ca99953-cfab-4d78-a087-0da6bf84b6c6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=0fa75533b1dbbdac1cf7de03859499f7 2x, https://si.imgix.net/65ac5a74/uploads/origins/8ca99953-cfab-4d78-a087-0da6bf84b6c6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=39f8b96e19b36d9fc13462f10dadd397 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/65ac5a74/uploads/origins/8ca99953-cfab-4d78-a087-0da6bf84b6c6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2285edd51c88a3321ae53c6ff1a46b44", "srcset": "https://si.imgix.net/65ac5a74/uploads/origins/8ca99953-cfab-4d78-a087-0da6bf84b6c6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2285edd51c88a3321ae53c6ff1a46b44, https://si.imgix.net/65ac5a74/uploads/origins/8ca99953-cfab-4d78-a087-0da6bf84b6c6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=02d4174d3fe6ae3eaa431afcb5cd98f7 2x, https://si.imgix.net/65ac5a74/uploads/origins/8ca99953-cfab-4d78-a087-0da6bf84b6c6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=c2ecf6dc1653341cfcedada0e8224a85 3x"}, "body": "初めまして。\nいつも素敵なイラストを拝見しております\n私は台湾人です。文法に間違いあるかもしれませんが、ご容赦ください。\n\n天狗+天狐\n陽キャで健氣の天然ボケ、笑うと八重歯が見える、\n時折見せる冗談のような振る舞い\nメッシュの色は気分によって色が変わる 。\n一般アクアマリンのメッシュ（恥ずかしい時はピンク色になり、感情が高ぶると赤色になります）\n現在のイメージは白髪で白い尻尾です。参考資料にある黒髪の柴犬耳の亜人イメージは以前のものです\n\n4.0大正學生衣裝\n構図はおまかせします！\n髪型はM字前髪に変更したバージョンを見てみたいです。\n\n髪型は、添付に記載した説明のようなM字前髪にしていただきたいです。\nもし可能であれば、2種類の差分をご用意いただけると大変嬉しいです！\n\n楽しみにお待ちしております！\nありがとうございました！\n\n希望納品形式：\nキャラの背景透過と未統合PSDファイルの提供が可能でしたらお願いします。\nできれば人物の透過やサインなどは別レイヤーに分けていただけると助かります。\nその他、細かいリクエストはございません。\nよろしくお願いします！\n\n【使用用途】\n・SNSのアイコンやPR画像、Youtube等の配信、そのサムネイルでの使用などを考えております。\n・個人用な印刷などの使用\n・他の方への依頼の際に資料として使用させていただくことがあります。\n・SNS、ネットで公開する時には、先生を注記してから投稿します。\n\nhttps://drive.google.com/drive/folders/14kvsaFybSkRbx5AMpIdMcI2Vaiz6OBKE", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 478275, "creator": true, "nsfw_acceptable": false, "acceptable": false, "name": "ヲム", "screen_name": "wo1059mu", "avatar_url": "https://pbs.twimg.com/profile_images/2006351917174472704/FjYFKJEc.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1108604701287735296/1632407011/1500x500", "appeal_receivable": true, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "art"}], "nc": 49}, {"id": 1825019, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "とのじ", "screen_name": "TOTOTOTO_TK", "avatar_url": "https://pbs.twimg.com/profile_images/1834564169791922176/k_MHE-ds.png", "header_url": "https://pbs.twimg.com/profile_banners/362002239/1739467323/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "art"}], "nc": 129}, {"id": 2391721, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "星月 信乃🌟🌙", "screen_name": "shino_ice071", "avatar_url": "https://pbs.twimg.com/profile_images/1965653762833620992/RTw23ikO.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1175387021109366784/1739138978/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 120, "skills": [{"genre"