どちらでも構いません。\n\nイラストは、梅ちゃんが真とまつりの小さなヌイグルミをそれぞれ2つずつ持っているところを描いていただければ。\n\nヌイグルミは、リュミエールパピヨンの服でも、ドリームプレリュードの服でも構いません。佑芽ちゃんは普段の制服でもいいです。Google driveのリンクに、サンプルアイデアと参考画像を用意しました。ご自由に使っていただいてもいいですし、もっといいアイデアがあれば捨ててびっくりさせてください。できればインパクトのあるものを希望します。\n\nhttps://drive.google.com/drive/folders/1cdVC6gbXvs5aVQbjKYRhi4dBZMZxLGar?usp=drive_link", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@nagian/works/11", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 5762, "client_id": 148618, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/504ce72d/uploads/origins/acadcc15-6c15-4694-a8a0-1e8e72a29087?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4bd79089ab2064e3e03e080f701013ec", "srcset": "https://si.imgix.net/504ce72d/uploads/origins/acadcc15-6c15-4694-a8a0-1e8e72a29087?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4bd79089ab2064e3e03e080f701013ec, https://si.imgix.net/504ce72d/uploads/origins/acadcc15-6c15-4694-a8a0-1e8e72a29087?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c34190758f9e733f37630e5718a92146 2x, https://si.imgix.net/504ce72d/uploads/origins/acadcc15-6c15-4694-a8a0-1e8e72a29087?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=cab1be3f3ee08ecaa5b313da9522b384 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/504ce72d/uploads/origins/acadcc15-6c15-4694-a8a0-1e8e72a29087?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=765b253eb6feec0d13546db8d6c73806", "srcset": "https://si.imgix.net/504ce72d/uploads/origins/acadcc15-6c15-4694-a8a0-1e8e72a29087?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=765b253eb6feec0d13546db8d6c73806, https://si.imgix.net/504ce72d/uploads/origins/acadcc15-6c15-4694-a8a0-1e8