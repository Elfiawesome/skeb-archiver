srcset": "https://si.imgix.net/55337e3c/uploads/origins/0e10ab22-966e-4451-9f4c-f07f0ec114a5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ea641e29405001244b1ce923ec667af0, https://si.imgix.net/55337e3c/uploads/origins/0e10ab22-966e-4451-9f4c-f07f0ec114a5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=22e7d9e7ac2915c26b2c06ea7ea1e6d7 2x, https://si.imgix.net/55337e3c/uploads/origins/0e10ab22-966e-4451-9f4c-f07f0ec114a5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=7c84a4baec157068369f857488a9a641 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/55337e3c/uploads/origins/0e10ab22-966e-4451-9f4c-f07f0ec114a5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3bc8374474783112edb1142a9966c441", "srcset": "https://si.imgix.net/55337e3c/uploads/origins/0e10ab22-966e-4451-9f4c-f07f0ec114a5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3bc8374474783112edb1142a9966c441, https://si.imgix.net/55337e3c/uploads/origins/0e10ab22-966e-4451-9f4c-f07f0ec114a5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=e3f02b199e6d55a98c3ad768c48c1120 2x, https://si.imgix.net/55337e3c/uploads/origins/0e10ab22-966e-4451-9f4c-f07f0ec114a5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=8ef7fd5dfeccce232ca395d276d5aab3 3x"}, "body": "凪庵先生、こんにちは！以前はかわいいイラストをありがとうございました！とても喜んで頂けました！\n\n実は今回リクエストをしたいのは、ヴイアラの灯里愛夏さんなんです。\nライバーアイドルとして、配信やアイドル活動を日々頑張って僕達Pに心を灯してくれている彼女。そんな彼女に灯され隊の１人として彼女の心も灯せればと思い、そして彼女に御礼がしたく先生の力をお借りしたく依頼したいのです。\n\nよろしくお願いします。", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@nagian/works/12", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 5762, "client_id": 1251856, "vtt_url"