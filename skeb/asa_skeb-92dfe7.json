ddc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ce6c9f62b580331f6fc0540f87eda9c9, https://si.imgix.net/80079ee2/uploads/origins/92bf9ca3-63dd-4d28-8723-c98348368ddc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=317dd81d63760d61a57ae35c13c4eaf6 2x, https://si.imgix.net/80079ee2/uploads/origins/92bf9ca3-63dd-4d28-8723-c98348368ddc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=70e0e961740353e38da4569693c259b9 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/80079ee2/uploads/origins/92bf9ca3-63dd-4d28-8723-c98348368ddc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=93820add281ff9f7d49fff7eaf3ae7b5", "srcset": "https://si.imgix.net/80079ee2/uploads/origins/92bf9ca3-63dd-4d28-8723-c98348368ddc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=93820add281ff9f7d49fff7eaf3ae7b5, https://si.imgix.net/80079ee2/uploads/origins/92bf9ca3-63dd-4d28-8723-c98348368ddc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=58eb681a03597d803cdcb2fa574d0206 2x, https://si.imgix.net/80079ee2/uploads/origins/92bf9ca3-63dd-4d28-8723-c98348368ddc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=b35727da3b77a1fbb35fe5561c46c201 3x"}, "body": "ASA様  \n\n初めまして、個人Vtuberの小豆ゆりかと申します。\n素敵な作品に惹かれ、ぜひ先生にお写真をお願いさせていただければと思っております。 \n\n  ■ 基本設定  \n名前（ふりがな）: 小豆ゆりか（あずき ゆりか）  \n性別: ねこ娘  \n年齢: 外見は17〜19歳くらい  \n身長/体型: 細身・しなやか・猫っぽい柔らかさ  \n性格（キーワード）:  ①お茶目　②元気　③ドジっ子　④情緒豊か　⑤ミステリアス（祭事時）  \n口調/一人称:「ゆりか」  \n活動内容: ゲーム配信、歌枠、雑談など   \n世界観/物語: \nにゃこ星から来た森の司祭ねこ娘  \n\nにゃこ星から地球へ降りてきた、精霊司祭見習いのねこ娘。\n精霊司祭の卒業試験として「人間界に癒しをもたらすこと」を課せられているが、 まだ歌も未熟で力も足りず、そのまま地球に滞在することになった。 \nゲームや食べ物、アニメに強く惹かれ、今ではインターネットを拠点に活動している。 普段は元気でお茶目、ちょっとドジな引きこもり猫だが、ゲームになると情緒変化が激しく、喜怒哀楽がすぐ顔に出るタイプ。 \n本来の姿は森の精霊を導く司祭（巫女）で、歌を祈りとして捧げ、人の心や世界をそっと癒やす存在でもある。\n小さな精霊「ゆら」を連れて、友だちみたいな距離感で癒しを届けながら、 今日も修行を兼ねてゲームや歌を楽しみつつ、のんびり地球生活を満喫している。  \n\n⬛︎使用用途 \nSNS宣伝\nサムネ\n収益化済みのyoutubeチャンネルでの使用\nファンへの返礼品（メン限壁紙など。）\nASMR配信で使用\n\n⬛︎構図 \n構図やポーズは全部ASA様にお任せします。\nお顔が際立つような構図だと幸いです。\n髪型、外見は資料のものでお願い致します。\n\n⬛︎納品 \n人物は左右・上に見切れていない、psdファイルデータの納品だと助かります。 \n\nご金額に不備がございましたら再送も可能です。\nご縁がございましたら、ぜひお願い致します！\n\nhttps://drive.google.com/drive/folders/1l9BcGzvm8ahCn-O8--jdi0RkXIDC9A3u", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@asa_skeb/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3702526, "client_id": 3661978, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/4b9845ea/uploads/origins/b0b63e7a-2253-4ddb-844c-43407a1f6a4a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ecd482e72c7d7ed1bc9a306eee425068", "srcset": "https://si.imgix.net/4b9845ea/uploads/origins/b0b63e7a-2253-4ddb-844c-43407a1f6a4a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ecd482e72c7d7ed1bc9a306eee425068, https://si.imgix.net/4b9845ea/uploads/origins/b0b63e7a-2253-4ddb-844c-43407a1f6a4a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=32905d7835627de68bb2bdbc21f04054 2x, https://si.imgix.net/4b9845ea/uploads/origins/b0b63e7a-2253-4ddb-844c-43407a1f6a4a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=4c3af7f4b3a8d9df0b3e01516bd9d781 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/4b9845ea/uploads/origins/b0b63e7a-2253-4ddb-844c-43407a1f6a4a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=7fd002a395efae88ee6f069aaeda0d75", "srcset": "https://si.imgix.net/4b9845ea/uploads/origins/b0b63e7a-2253-4ddb-844c-43407a1f6a4a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=7fd002a395efae88ee6f069aaeda0d75, 