db-844c-43407a1f6a4a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=7fd002a395efae88ee6f069aaeda0d75, https://si.imgix.net/4b9845ea/uploads/origins/b0b63e7a-2253-4ddb-844c-43407a1f6a4a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=fa925fbf15da2f0b6c22cb5a02dd4859 2x, https://si.imgix.net/4b9845ea/uploads/origins/b0b63e7a-2253-4ddb-844c-43407a1f6a4a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=09c2c36ce9a4250e33148170179fb7d0 3x"}, "body": "初めまして。私VARiSE所属のVtuber、結栞そまりと申します。\n\nASA様の美しくて繊細なイラストに心惹かれ、受付再開を心待ちにしておりました。この度、ぜひ私を描いていただきたいなと思いご連絡させて頂きました。\n下記、詳細を記載いたしますのでご検討いただけましたら幸いです。\n\n【使用用途】\n・SNSでの投稿\n・YouTube（収益化済みです）のサムネイル、動画内での使用\n・グッズなどへの使用（商用）\n✳︎上記使用不可のものがある場合は恐れ入りますがご再送ください。\n\n【結栞そまりについて】\n・天使と魔法使いのハーフの女の子。\n・声の表現の魔法（お芝居、お歌など）を日々研究している。\n・声優さんに憧れている。\n・くらげが大好き。\n・ラベンダーと水色のオッドアイがチャームポイント。\n・メインのイメージカラーはラベンダー、ホワイト、水色。サブカラーとしてピンク。グラデーションカラーがたくさん取り入れられている。\n\n【希望内容】\n結栞そまりの一枚絵。\n「休日の結栞そまり」をテーマにおまかせで私服をデザインして頂きたいです。冬服だと嬉しいですがお任せいたします！\n全身を描写して頂けますと嬉しいです。\nASA様のセンスが好きなので構図やポーズ、表情などは全てお任せさせてください…！\n髪色は銀髪の方でお願いしたいです。\n髪型に関しては、資料内のものではなく服装に合わせて自由にアレンジしていただいても構いません。可能であればオトモキャラも一緒に描いていただけたら嬉しいです。\n\n【参考資料】\nこちらのドライブ内データをご参照ください。\nhttps://drive.google.com/drive/folders/1fnbV6JJf3JVtGE4UfG9esnPo9oHtaZxp\n\n【お願い事項】\n・サムネイルなどへの使用を考えているため、頭部や髪の毛が見切れていない構成でお願いいたします。\n・もし背景やサイン、メッセージも描いていただける場合には、人物イラストと分けられるようpsdファイルで納品していただくか、別途人物イラストのみの透過データを一緒に納品していただきますようよろしくお願いいたします。\n\nお忙しいところ恐れ入りますが、ご検討のほどよろしくお願いいたします。", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@asa_skeb/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3702526, "client_id": 2800855, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/ccf2d564/uploads/origins/429ec62b-15e3-4f50-9344-2a49cde8fe44?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h