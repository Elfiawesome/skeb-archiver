7b28150d43a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e6148b7f78f48c1017b70f94e0ef26e3", "srcset": "https://si.imgix.net/67d116ea/uploads/origins/03349535-8001-4186-96be-d7b28150d43a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e6148b7f78f48c1017b70f94e0ef26e3, https://si.imgix.net/67d116ea/uploads/origins/03349535-8001-4186-96be-d7b28150d43a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=2adb0938cadf06f48f32c14abd6d6290 2x, https://si.imgix.net/67d116ea/uploads/origins/03349535-8001-4186-96be-d7b28150d43a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=452b11d0a0aa834bd99a988a3f68829a 3x"}, "body": "いつも更新楽しみにしてます。\ntokorotさんのイラストが好きでリクエスト致します。\n\n■キャラクター\n「我が家のもう一つの便器」の「絵里」\n\n歴代の女児で絵里ちゃんが一番好きです！\n\n■シチュエーション\n・叔父さんとのセックス後のイラストをお願い致します。\n\n　絵里ちゃんは頭から足まで全体が見える正面アングルで、汗だく全裸状態で股を開いて両手でオマンコ広げて大量の精液が溢れ出ている。\n　髪型はツインテほどいたストレートで、表情は涙、鼻水、涎でベチョベチョになって全力でセックスしたって感じにしてください。\n　絵里ちゃんの後ろに叔父さんを配置してください。（叔父さんは見切れてもOKです）\n\n　部屋は熱気ムワムワで布団もすごく汚してください。\n\n　また、ハメ撮りしている設定でセリフもいくつか付けてください。（息切れしながらカメラに向かって大人を射精させました的なこと言ってほしいです）\n\n■表情差分もお願いします。\n・まだ余裕があった頃の表情ver.\n　セリフも変えてください。\n\n■その他\n・消しは海苔希望、難しければモザイクでOKです\n・カラー絵\n・ファイル形式はpsd\n\n要望が多くて恐縮ですが、ご検討の程よろしくお願い致します。", "nc": 185, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@tokor10/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2319669, "client_id": 544085, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/36538099/uploads/origins/f68ba116-67bb-4d18-9127-2fe4966ffff4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5734f25fc397055b6562d9c13035f8a5", "srcset": "https://si.imgix.net/36538099/uploads/origins/f68ba116-67bb-4d18-9127-2fe4966ffff4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5734f25fc397055b656