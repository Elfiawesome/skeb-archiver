b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=07f4540018f94c846397e3725c503c49, https://si.imgix.net/bd29f253/uploads/origins/7c1eaf1f-a9ef-4dbb-b0a3-d11d3074a41b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=97441edfd46e886b1883537c12f57cc7 2x, https://si.imgix.net/bd29f253/uploads/origins/7c1eaf1f-a9ef-4dbb-b0a3-d11d3074a41b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=f776dc25f381770b0868a8d136aeca68 3x"}, "body": "ぺろりさん素敵なイラストいつもありがとうございます！Skebを始められたようなので是非リクエスト送らせていただきたいと思います！\n\nキャラクター:桜守歌織\n\nシチュエーション:高速道路で移動中におしっこを我慢できなくなってしまい窓からお尻を出して気持ちよさそうな表情で目を❤️にして「幸せ・・・」と言いながら放尿(割とお尻がガッツリ見える画角だと嬉しいです)\n\n服装:あなたを知るたびに(https://mltd.matsurihi.me/cards/2037)\n\nミリシタは始めて日が浅いのでもし違和感があってもご容赦いただけると幸いです…\n何卒ご検討のほどよろしくお願い致します！", "nc": 33, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Peroperokun3/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3928196, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/228dbb8c/uploads/origins/188c92bf-55c8-49a7-86bb-90f0791f7782?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7b20392e5e9bac02b37d59b3ccbadfed", "srcset": "https://si.imgix.net/228dbb8c/uploads/origins/188c92bf-55c8-49a7-86bb-90f0791f7782?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7b20392e5e9bac02b37d59b3ccbadfed, https://si.imgix.net/228dbb8c/uploads/origins/188c92bf-55c8-49a7-86bb-90f0791f7782?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=bdcf56df86a2d56cdf7b24acddd8f5fa 2x, https://si.imgix.net/228dbb8c/uploads/origins/188c92bf-55c8-49a7-86bb-90f0791f7782?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d9596ccab48451880b8929dd56b82887 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/228dbb8c/uploads/origins/188c92bf-55c8-49a7-86bb-90f0791f7782?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b72790307047f3e9728cf97ceb5a2603", "srcset": "https://si.imgix.net/228dbb8c/uploads/origins/188c92bf-55c8-49a7-86bb-90f0791f7782?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b72790307047f3e9728cf97ceb5a2603, https://si.imgix.net/228dbb8c/uploads/origins/188c92bf-55c8-49a7-86bb-90f0791f7782?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=6c25030c96a061b75adac6ce533207ba 2x, https://si.imgix.net/228dbb8c/uploads/origins/188c92bf-55c8-49a7-86bb-90f0791f7782?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=be331eea8fd0070d23e462f828e92748 3x"}, "body": "skeb開設おめでとうございます。\n私もさっそくリクエストさせて頂きます。\n\n◎キャラ\n\nケロロ軍曹より日向秋(剛毛もケツ毛も尻の割れ目からはみ出る程もっさり生えている。膀胱も尿でパンパンな状態)\n\n◎衣装\n\nhttps://www.pixiv.net/artworks/144114384\n水着(2026新劇場版)\n\n◎シチュエーション\n\nある海岸の林の中、海で遊んでいる最中に尿意を催した水着姿の日向秋がやって来ます。\n林の奥に来た日向秋は周りをキョロキョロと見回し、誰もいないことを確認すると水着の下部分を脱ぎ下ろし、片足に引っ掛けたまま立った状態でお股が剛毛で覆われた状態のマ◯コを手で広げると勢いよくおしっこをし始めます。林の中に長く響くおしっこの音、秋は(ああ･･･気持ちいい･･･､こうゆうの･･･癖になりそう)とうっとりとした気分になります。\nおしっこをし始めて数分が経ち、勢いよく出ていたおしっこもようやく落ち着き始め、秋は近くにある葉っぱを取るとおしっこの水滴がまだポタポタと垂れてる状態のマ◯コを拭くという感じで\n\nおしっこは破裂した水道管から水が勢いよく出る感じのと、真後ろからのアングルシーンも可能だったらお願いしたいです。", "nc": 56, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Peroperokun3/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3928196, "client_id": 1033947, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/e378876a/uploads/origins/57443d60-4af9-4a7e-8513-95432838e5cf?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4a414e5e10f50712bc3e8c214d44f698", "srcset": "https://si.imgix.net/e378876a/uploads/origins/57443d60-4af9-4a7e-8513-95432838e5cf?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4a414e5e10f50712bc3e8c214d44f698, https://si.imgix.net/e378876a/uploads/origins/57443d60-4af9-4a7e-8513-95432838e5cf?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=40f64e1b7b75d7d862f55df7da6095a8 2x, https://si.imgix.net/e378876a/uploads/origins/57443d60-4af9-4a7e-8513-95432838e5cf?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=1b9276b386d8be984b77449d3be84773 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/e378876a/uploads/origins/57443d60-4af9-4a7e-8513-95432838e5cf?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=8034331eca14ab2323014d0cb289d799", "srcset": "https://si.imgix.net/e378876a/uploads/origins/57443d60-4af9-4a7e-8513-95432838e5cf?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=8034331eca14ab2323014d0cb289d799, https://si.imgix.net/e378876a/uploads/origins/57443d60-4af9-4a7e-8513-95432838e5cf?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=1c021e9020d8534fced5bfe49cd22214 2x, https://si.imgix.net/e378876a/uploads/origins/57443d60-4af9-4a7e-8513-95432838e5cf?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=1c0736683d9be9511a8c9c45e7e9cd6a 3x"}, "body": "【おっとり女の子の放尿プレイ（＋事故おしがま）】\n\nXで拝見させていただき、大変好みでしたので依頼させていただきます。\n\n■キャラ\n黒髪でおっとりした感じの女の子。\n顔のタイプは可愛い系。\n見た目は清楚系だがえっちなことが好き。\n性欲が強いとかではなく性におおらかで、夜の食事を終えた後「え～っと……。折角だし、ホテルとか行っちゃう？」などと言うタイプ。\n年齢は20歳ぐらい（童顔なので未成年に見えなくもない）。\n服装は丈が短めのTシャツにジーンズとラフめ。\n\n■シチュエーション\n◆概要\n恋人（性別不詳、描画不要※恋人視点で描くイメージだと嬉しいです）に「トイレでおしっこしているところが見たい」と言われ、トイレまで来たものの恥ずかしさが勝り抵抗するが、我慢できずに見られながらおしっこする。\n場所は恋人の家（独り暮らし）とか、ホテルとか、2人きりの一室。\nセリフは適宜改変してください。\n\n◆導入\n困惑半分、好奇心半分で「え～？おトイレ見たい、の……？う～～～～ん、じゃあ、1回だけね」とOKする。\n\n◆尿意\nモジモジしながら「アハハ……。見られると思ったら、言い出せなくって」と照れ笑い。\n\n◆冗談交じり\nトイレの個室で顔を赤らめながら、怒り笑いの表情で「言っとくけど、1回だけだからね！」と一応拒絶。\n\n◆我に返る\nズボンに手をかけたところで一気に羞恥心が高まる。\n顔を真っ赤、汗をかきながら心の中で「（え？どうしよ！？すっごい恥ずかしくなってきた！だっておトイレ見られるんだよね！？）」と狼狽。\n\n◆キャンセル希望\nズボンを下ろし、Tシャツを少したくし上げてパンツを見せながら「ごめ、やっぱなし！なんかすっごい恥ずかしくなってきた！ね？ね！パンツだけで許して～～～！」と懇願。\n涙をためたぐるぐる目だとなお嬉しい。\n\n◆5秒前\nパンツを脱いでトイレに座り、丈の短いTシャツを伸ばして必死に股間を隠しながら「お願い！ホントに！もう、もう、おしっこしちゃうからぁ！」と訴える。\n半べそで息は荒い。\n\n◆解放\n限界を迎えて放尿。\n解放感を感じて緩んだ表情。\n「はぁ～♡」など、溜息。\n\n◆抗議\n恥ずかしさから、Tシャツを上げて顔を少し隠して「もぉ～！おトイレ出てってって言ったじゃん～」と赤らめた顔で抗議。\n感情は羞恥100%で怒りや悲嘆はない。\n無意識だが、Tシャツを持ち上げているので股間もおへそも丸見え。\n---------------------------------------------------\n\nよろしくお願いいたします。", "nc": 160, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Peroperokun3/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3928196, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/b8b013d5/uploads/origins/03f56325-c15d-4819-8e57-aa62d0147f9e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5b9b24e55abb13401c3ba977eb67b874", "srcset": "https://si.imgix.net/b8b013d5/uploads/origins/03f56325-c15d-4819-8e57-aa62d0147f9e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5b9b24e55abb13401c3ba977eb67b874, https://si.imgix.net/b8b013d5/uploads/origins/03f56325-c15d-4819-8e57-aa62d0147f9e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=cc127bcd6eddce49450cea54c9728d32 2x, https://si.imgix.net/b8b013d5/uploads/origins/03f56325-c15d-4819-8e57-aa62d0147f9e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=384992ad4d5bb5a4a48dc3f601960563 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/b8b013d5/uploads/origins/03f56325-c15d-4819-8e57-aa62d0147f9e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2adebda826601795177ecb28361343c4", "srcset": "https://si.imgix.net/b8b013d5/uploads/origins/03f56325-