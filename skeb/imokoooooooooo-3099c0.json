c-469a-8f90-d622398e1348?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ab3fc7ef7aa9f17ecb1d322d471a69d4", "srcset": "https://si.imgix.net/3984609c/uploads/origins/5d1e6310-d06c-469a-8f90-d622398e1348?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ab3fc7ef7aa9f17ecb1d322d471a69d4, https://si.imgix.net/3984609c/uploads/origins/5d1e6310-d06c-469a-8f90-d622398e1348?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=22d9502cee9d9dec9a5456057853d594 2x, https://si.imgix.net/3984609c/uploads/origins/5d1e6310-d06c-469a-8f90-d622398e1348?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=0e7122fc30ff3b97d6a62101dc2873ac 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/3984609c/uploads/origins/5d1e6310-d06c-469a-8f90-d622398e1348?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=aa6299d851259204a78adfb3b9f9c935", "srcset": "https://si.imgix.net/3984609c/uploads/origins/5d1e6310-d06c-469a-8f90-d622398e1348?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=aa6299d851259204a78adfb3b9f9c935, https://si.imgix.net/3984609c/uploads/origins/5d1e6310-d06c-469a-8f90-d622398e1348?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=896a6fbdda86f5102eb2e0b40dec9875 2x, https://si.imgix.net/3984609c/uploads/origins/5d1e6310-d06c-469a-8f90-d622398e1348?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=35bdf3933d2bb88ba679bec2fdfb8fe1 3x"}, "body": "ちる様\n\n\nいつもお世話になっております。\nXにてイラストを拝見し、素敵な作風に感銘を受け、このたびご依頼させていただきました。\n\n依頼内容は、私の探索者「霏々 雨夜（ひひ-あまや）」の新規立ち絵制作です。\n彼は『イザナミの棺』のHO1として作成しました。\n\n彼は自分の感情に疎く、思考＝感情だと考えるような人間です。\nAPPが60あるため、見目は良いという設定にしています。\nまた、仕事に対しては前向きで、鬼を祓うことに躊躇のない人物です。\n表情は基本的に落ち着いて、柔らかくにこやかに微笑んでおり、感情が表に出にくい印象を想定しています。\n\n立ち絵につきましては、通常立ち絵と戦闘立ち絵の二種類をご依頼できればと考えております。\n通常立ち絵は穏やかで静かな印象、戦闘立ち絵では覚悟や鋭さが感じられる雰囲気だと嬉しいです。通常・戦闘立ち絵両方ともポーズにつきましては、ちる様のお任せで問題ありません。\n\n服装のイメージとしては「スーツ＋和装」のような制服を考えています。\nスーツをベースに、羽織・振り袖など和装要素を取り入れたデザインを想定しています。\n参考資料にAI作成のイメージ画像がございますので、ご参考程度にご覧いただけますと幸いです。\nあくまで参考ですので、ちる様にアレンジしていただいて問題ありません。\n\n武器は刃渡り25cmほどの短剣を二本使用しており、普段は腰に携帯しています。\n可能でしたら立ち絵に反映していただけますと幸いです。\n\n\n\n\n【探索者情報】\n・『イザナミの棺』HO1：陰通過予定探索者\n・名前：霏々 雨夜（ひひ-あまや）\n・性別：男性 / 年齢：23歳 / 身長：185cm\n・性格：感情を理解していない自覚がないまま、結果と合理性で人を大切にしようとする、不器用で静かな優しさの人。\n・イメージカラー：#D5DA70\n\n【依頼内容】\n・新規立ち絵（通常立ち絵・戦闘差分）\n\n【資料】\n・キャラシート：https://iachara.com/view/13343498\n・参考資料：https://drive.google.com/drive/folders/1pFzJDDTblSPt3xSfWj1_ZvOs5BRLDACk?usp=drive_link\n\n\n\n【使用用途】\n・個人鑑賞、TRPGセッションなど個人範囲での使用\n\n\nお忙しいところ恐れ入りますが、ご検討いただけますと幸いです。\nどうぞよろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/1pFzJDDTblSPt3xSfWj1_ZvOs5BRLDACk?usp=drive_link", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@osatosaku/works/20", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 850421, "client_id": 3339113, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/687262d6/uploads/origins/58c95e7b-9d5f-4dcb-a621-82a5c10f4532?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e79eb1d242369309e54451c04835e5f4", "srcset": "https://si.imgix.net/687262d6/uploads/origins/58c95e7b-9d5f-4dcb-a621-82a5c10f4532?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e79eb1d242369309e54451c04835e5f4, https://si.imgix.net/687262d6/uploads/origins/58c95e7b-9d5f-4dcb-a621-82a5c10f4532?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=7192688266ce6020b7e2352539b55866 2x, https://si.imgix.net/687262d6/uploads/origins/58c95e7b-9d5f-4dcb-a621-82a5c10f4532?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=29843da0e889a9371ad352f9f093b592 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_