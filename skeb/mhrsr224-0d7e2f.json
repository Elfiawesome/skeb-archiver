w=200&h=200&s=9330660b282bb0f883a3bdf3361f8e52, https://si.imgix.net/3fa23946/uploads/origins/03f0a1a6-c182-42d3-86ae-a262df295828?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=d6a6d060d5318f8c9af30af57b8a76db 2x, https://si.imgix.net/3fa23946/uploads/origins/03f0a1a6-c182-42d3-86ae-a262df295828?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=2d9af4f2f5f2b6f0f47e45f169a79172 3x"}, "duration": null, "nsfw": true, "hardcore": true, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/3fa23946/uploads/origins/03f0a1a6-c182-42d3-86ae-a262df295828?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9ae06033d070747d91594a8c07d75ba1", "srcset": "https://si.imgix.net/3fa23946/uploads/origins/03f0a1a6-c182-42d3-86ae-a262df295828?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9ae06033d070747d91594a8c07d75ba1, https://si.imgix.net/3fa23946/uploads/origins/03f0a1a6-c182-42d3-86ae-a262df295828?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=7a6ef8e8b56359d17c792143dd40c0bf 2x, https://si.imgix.net/3fa23946/uploads/origins/03f0a1a6-c182-42d3-86ae-a262df295828?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=204a5c7409f070e2c161c0681fb49d55 3x"}, "body": "『おね●ょたお腹の音遊び』の続編の形になりますが、300kg以上に太ったお姉さんが、少年を自身の腹部にもたれかかせて、空腹音を聴かせるイラストを描いてくれませんか？\n\n絵の構図は、少年は半身をクッションにもたれかかせる様に、お姉さんの腹部に身を預け、お姉さんは腹を中心に贅肉が付き、彼女の全体像が分かるように斜めに向いてる状態でお願いします。可能であれば、二人とも地べたに尻を着いて座っている状態で描いてください。\n\nお姉さんの服装は、腹部が丸出しの状態なら特に指定はありません。少年の服装もお任せします。\n加えて、お姉さんは少年に空腹音を聴かせるために、丸一日何も食べてないので腹が張っておらず、少年が腹部に若干埋まっている状態であれば面白いです。\n肝心の空腹音は、身を預けている少年が振動する程に強烈にしてください。\n\nR-18の絵になってしまうかもしれませんが、よろしくお願いします。", "nc": 42, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@mhrsr224/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creato