る）といったストーリーをマンガ、もしくはイラストで見たいです！\nわ～いさんのぱつぱつに張り詰めたお肉の描写や放屁描写が大好きなので出来たらその辺をマシマシで見たいです！よろしくお願いいたします！", "nc": 59, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@mhrsr224/works/8", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/67514c05/uploads/origins/0d1bf69c-3978-4b77-ad4d-d433ab913807?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=8517ba2df61d197fc6a221eb6bfa9da1", "srcset": "https://si.imgix.net/67514c05/uploads/origins/0d1bf69c-3978-4b77-ad4d-d433ab913807?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=8517ba2df61d197fc6a221eb6bfa9da1, https://si.imgix.net/67514c05/uploads/origins/0d1bf69c-3978-4b77-ad4d-d433ab913807?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=88d70105210928d3e1f2eec7bca40fd3 2x, https://si.imgix.net/67514c05/uploads/origins/0d1bf69c-3978-4b77-ad4d-d433ab913807?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=0e1bd031ea1ad3dd1297659b6a15e65c 3x"}, "private": true, "genre": "art", "tipped": false, "creator_id": 2343700, "client_id": 3594798, "nc": 50}, {"path": "/@mhrsr224/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "comic", "tipped": false, "creator_id": 2343700, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/8ef4b829/uploads/origins/53f37485-fc40-44b9-876f-950e4b61e4a5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9ab6a00ccf6abb7d172cea1aea552f9a", "srcset": "https://si.imgix.net/8ef4b829/uploads/origins/53f37485-fc40-44b9-876f-