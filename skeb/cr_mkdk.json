8b5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=6788c357fd0bfd79befe58de1e26e80e 2x, https://si.imgix.net/20b5955f/uploads/origins/f4c83fc6-5bb8-4dd4-a545-248aef91a8b5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=c26095d074be2af9cab49cdedd4fd3d8 3x"}, "body": "お世話になっております\nそちらのシェアワールド「タクティカル祓魔師」に参加させていただいているナナガツです。\n本日ご依頼したいのはうちの子「文月龍彦」https://x.com/nanagatu77777/status/1886056165676908847?s=46\nです。\nポーズなどはお任せします！\n\nhttps://x.com/nanagatu77777/status/1886056165676908847?s=46", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@cr_mkdk/works/13", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2167496, "client_id": 3843625, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/cdb2ca1a/uploads/origins/08e5d686-338d-4426-8f5d-c63a30d57fc8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5a951ba45229765d17e04bda838957fe", "srcset": "https://si.imgix.net/cdb2ca1a/uploads/origins/08e5d686-338d-4426-8f5d-c63a30d57fc8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5a951ba45229765d17e04bda838957fe, https://si.imgix.net/cdb2ca1a/uploads/origins/08e5d686-338d-4426-8f5d-c63a30d57fc8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=48270e21741e02be12b4211bd772619d 2x, https://si.imgix.net/cdb2ca1a/uploads/origins/08e5d686-338d-4426-8f5d-c63a30d57fc8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=7f97a900a8e713e63721362b954dddf6 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/cdb2ca1a/uploads/origins/08e5d686-338d-4426-8f5d-c63a30d57fc8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=7eda5551f35f38c3836075d5618179e2", "srcset": "https://si.imgix.net/cdb2ca1a/uploads/origins/08e5d686-338d-4426-8f5d-c63a30d57fc8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=7eda5551f35f38c3836075d5618179e2, https://si.imgix.net/cdb2ca1a/uploads/origins/08e5d686-338d-4426-8f5d-c63a30d57fc8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=4a0d77b5583635d24556c23f856a25bc 2x, https://si.imgix.net/cdb2ca1a/uploads/origins/08e5d686-338d-4426-8f5d-c63a30d57fc8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=608c1b13200d21ce4f751143e2cdfde8 3x"}, "body": "大変お世話になっております。\nタクティカル祓魔師に参加させていただいており、いつも楽しく遊ばせて頂いております。\n同時に、イラストを始めとした世界観も楽しみにさせて頂いております。\n\nさて、早速のお話となり恐縮ではございますが同世界観にて作成しておりますキャラクター「楼」のイラストをお願いしたく存じます。\n\n構図は可能であれば全身と口内と舌が見えていると嬉しく思いますが、難しければ御伽月様のお任せにてお願いできればと思います。\n\nまたこちらはわたくしの技術不足で表現できておらず大変恐縮なのですが、目は鋭く、身体は肋骨や腰骨が浮く程度に細くお願いできますと幸いです。\n\n使用目的と致しましては主に鑑賞と、自身が等身イラストを描く際のお手本にさせて頂ければと考えております。\n\nサンプルとしてwikiのURLを転載致します。\n他に良さそうな資料がなく…申し訳ございません。\n\nお忙しい中でのご依頼且つ、初めてのskeb依頼で不手際があるかもしれず誠に恐れ入りますが、ご一考頂けますと幸いです。\n\nhttps://w.atwiki.jp/nandayo/pages/714.html", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@cr_mkdk/works/12", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2167496, "client_id": 2509393, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/cab37cd8/uploads/origins/7d824bdb-95c2-49e5-953d-d745897cb1fe?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=28d9b86c183383af2fb20b903649ace3", "srcset": "https://si.imgix.net/cab37cd8/uploads/origins/7d824bdb-95c2-49e5-953d-d745897cb1fe?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=28d9b86c183383af2fb20b903649ace3, https://si.imgix.net/cab37cd8/uploads/origins/7d824bdb-95c2-49e5-953d-d745897cb1fe?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a4cef11b5f5abe932464d5786ceb86a0 2x, https://si.imgix.net/cab37cd8/uploads/origins/7d824bdb-95c2-49e5-953d-d745897cb1fe?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e0963f6115dbbea9e16263c140260088 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/cab37cd8/uploads/origins/7d824bdb-95c2-49e5-953d-d745897cb1fe?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=810b6c089284ec74ac26d8773769e775", "srcset": "https://si.imgix.net/cab37cd8/uploads/origins/7d824bdb-95c2-49e5-953d-d745897cb1fe?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=810b6c089284ec74ac26d8773769e775, https://si.imgix.net/cab37cd8/uploads/origins/7d824bdb-95c2-49e5-953d-d745897cb1fe?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=0b52c17a88eabed4a3a2ce90684223eb 2x, https://si.imgix.net/cab37cd8/uploads/origins/7d824bdb-95c2-49e5-953d-d745897cb1fe?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=946f066ce30c78731110f0a103021bc5 3x"}, "body": "タクティカル祓魔師にてお世話になっております、妖識です。いつもタクティカル祓魔師の世界を楽しませてもらっております。\n本日はタクティカル祓魔師のwikiに登録させていただいたうちの子「ラビシス・セレニギア」のイラストをご依頼させていただきます。タクティカル祓魔師といいつつ西洋祓魔師の騎士だしバニー服だしで申し訳ありません。\n\nバニー服を着ている、白の長髪に赤い目、褐色肌で巨乳、武器を持っている場合は先端が平たい処刑剣であること、以外の指定はシチュなども含めて特にありません。\nまた、健全イラストかNSFWイラストかの指定もありません。欲を言えばどちらも欲しいですが、御伽月さんが描きたい方をお願い致します。\n\nhttps://w.atwiki.jp/nandayo/pages/801.html", "nc": 177, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@cr_mkdk/works/11", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2167496, "client_id": 1817895, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/79ff61d0/uploads/origins/91e418f2-b902-4566-be4c-6296f249a169?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=593b03f690bc2074bab83ee46a8b94ba", "srcset