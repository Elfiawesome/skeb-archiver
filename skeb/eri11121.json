_Utakata/status/1543060847203078145?s=20&t=TB_0kLKO83AaQVl1rbV0pw\n\nhttps://drive.google.com/file/d/1urt74BpLypCQk6Y-L5EAWV1JKM6BG8hV/view?usp=sharing", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@eri11121/works/51", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3425515, "client_id": 3385357, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/c24b7acf/uploads/origins/9fee0c4b-5458-4b5e-a110-d09d99af5df6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9880af15efd19a6bde59337662aa9610", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/c24b7acf/uploads/origins/9fee0c4b-5458-4b5e-a110-d09d99af5df6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=1becccbbd76ae032503448705e02f11d", "src_set": ""}, "body": "こんにちは、\n線も色もとてもきれいで、あなたの絵が大好きです！僕のOCであるVtuberのinsandioを描いてもらいたいんだ！\n彼女は \"Iris \"という小さなマジックショップを経営している魔術師です。\n超可愛く描いてくれませんか？服はフォルダから好きなものを選んでください！\ninsandioは背景とは別のレイヤーにしてもらえると嬉しいです！\nありがとうございました！\n\nhttps://drive.google.com/drive/folders/1gflmUdr6PdkeKlBEyJFockCjzkrdeC5H?usp=drive_link", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@eri11121/works/50", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3425515, "client_id": 2971535, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/c8668501/uploads/origins/dbe3dfe6-50a1-47c2-a02b-67db6d43b55a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3841e27737c331c860a53987a0c6f6ec", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/c8668501/uploads/origins/dbe3dfe6-50a1-47c2-a02b-67db6d43b55a?bg=%23fff&auto=format%2Ccompress&fm