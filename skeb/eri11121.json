=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e6c8336446612a4a5cb54fd13fe9352d", "src_set": ""}, "body": "可愛イラストいつもありがとうございます\n\n個人Vtuberの鈴木ゆらちゃんをお願いしたいです\n@suzukiyura_asmr 構造どれも可愛かったのでおまかせでよろしくお願いします✨💕\nシチュエーションボイスなどで使用しやすいものだと嬉しいです", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@eri11121/works/54", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3425515, "client_id": 3057720, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/41f605d7/uploads/origins/fe9f0703-e273-4496-a6f9-b61d5c20d2f9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=62886788a08fb439e9c9f80e7e72c953", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/41f605d7/uploads/origins/fe9f0703-e273-4496-a6f9-b61d5c20d2f9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f60bfae3e76ea3a238cd86d2c5cf1d5d", "src_set": ""}, "body": "こんにちは！あなたの作品が大好きです！とてもかわいいです！私のVtuberモデルのために、あなたのアート作品を依頼したいです！彼女は普段は穏やかでエレガントな表情をしている女神のようなプリンセスです。この作品（https://skeb.jp/@eri11121/works/22）のように空白の看板を持っていてほしいです。\nキャンバスは横でも縦でも構いません！お任せします！\n\n髪型、表情、ポーズ、その他はお任せします！\nよろしくお願いします！\n\nhttps://drive.google.com/drive/folders/1OiB0cyhNR8mDHDnFt46QcrYKuI7DO_8d?usp=sharing", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@eri11121/works/53", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3425515, "client_id": 2067516, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/6fa2bd6d/uploads/origins/02342e81-5124-49d2-bff7-28f013a62820?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4f1781b9fc228922aa93c791154098dd", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https:/