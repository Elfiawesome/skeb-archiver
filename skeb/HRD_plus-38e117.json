2-f293-4c16-9c00-86b2deabf12d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9e80ae6a3271dc76de33caf8937ac5f9", "srcset": "https://si.imgix.net/9c0eac37/uploads/origins/6cb05692-f293-4c16-9c00-86b2deabf12d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9e80ae6a3271dc76de33caf8937ac5f9, https://si.imgix.net/9c0eac37/uploads/origins/6cb05692-f293-4c16-9c00-86b2deabf12d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=e3e93d2f5f2b1468aef488474f907997 2x, https://si.imgix.net/9c0eac37/uploads/origins/6cb05692-f293-4c16-9c00-86b2deabf12d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=024cbabc62a234420a9eb9d93eb471dd 3x"}, "body": "HRD様\n\nこんばんは、HRD様！ゼッダルです。\nイラストも漫画も、それにちょっと長いお付き合いも本当にありがとうございます！\nHRD様の描く日常系の表現が好きです！ツイッターの１枚ネタのイラストとか、面白くて大好きです…！それと逆に、「スカイフォール」などで見せてくださるセンスのあふれる表現もまた好きです！\nお忙しい中恐縮ですが、そんなHRD様のイラストで私のオリキャラを描くという依頼を、どうかご検討おねがいします。\n\nお願い申し上げたいのは私のツイッターのプロフ絵とヘッダーにいるオリキャラ狐娘の万里香（まりか）という子です。\n狐耳と尻尾・赤メガネ・アホ毛、そしてちょっぴりツリ目な目つきが特徴的な、160cmくらいの身長の高校生です。\n本とか、動物や花、星空のような自然をぼーっと見るのが大好きな子です。\n性格的には、ちょっと人見知りで照れ屋ですので外では余計にクールっぷりしてるけどまた寂しがり屋のちょっと面倒くさい感じです。知り合いの前では表情が緩めてちょっと豊かになる感じです。\nこれだけではちょっと説明が足りないかもしれませんので設定画と他の方々からもらったイラストなどを下のURLにつけます。\n\nもしよろしければ、HRD様の絵柄でのこの娘のイラストをお願いしてもよろしいでしょうか？\n今の季節もそうですし、彼女の色合い的にも秋が一番似合うと勝手に思っておりますので、秋をテーマにお願いします！\nもしよろしければ、ちょっとハイセンスに、秋が出てくるようなイラストを依頼しようと思います。\n構図などはすべておまかせします！\n\n要件のみで申し訳ありません。\n応援しております！\n\nhttps://drive.google.com/drive/folders/1kVcp6B8dzGYFGpFb9spMTyDnz0TzyM7Q?usp=sharing", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@HRD_plus/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1484, "client_id": 54283, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/efda165a/requests/6055_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200