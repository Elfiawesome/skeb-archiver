shop-pro.jp/PA01127/336/product/151359781_o2.jpg?cmsp_timestamp=20210312015728\n【重要】ブルーハワイは星空のように煌かせ、宇宙を飲んでるイメージとして下さい。\n\n背景、構図はお任せしますが、夏らしさがあると嬉しいです。\n\n●利用方法\nnoteやpixiv小説等のサムネイルとして利用する許可をいただきたいです。\n\nよろしくお願いいたします。\n\nhttps://pbs.twimg.com/media/Ex9nfjWUcAQx1fx?format=jpg&name=4096x4096", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@shion_citrus/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 680318, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/2618b321/uploads/origins/5a31a38b-72d4-49c4-ae47-abcc3d302fc0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6f3345990b800913d055005bcae9f631", "srcset": "https://si.imgix.net/2618b321/uploads/origins/5a31a38b-72d4-49c4-ae47-abcc3d302fc0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6f3345990b800913d055005bcae9f631, https://si.imgix.net/2618b321/uploads/origins/5a31a38b-72d4-49c4-ae47-abcc3d302fc0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c4fda1f2db84f935cb7920e2241aefc7 2x, https://si.imgix.net/2618b321/uploads/origins/5a31a38b-72d4-49c4-ae47-abcc3d302fc0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b4230c865659aa2c0e2426a2a05540cb 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/2618b321/uploads/origins/5a31a38b-72d4-49c4-ae47-abcc3d302fc0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d6a2106da7b9f49519e36f11a33babe6", "srcset": "https://si.imgix.net/2618b321/uploads/origins/5a31a38b-72d4-49c4-ae47-abcc3d302fc0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d6a2106da7b9f49519e36f11a33babe6, https://si.imgix.net/2618b321/uploads/origins/5a31a38b-72d4-49c4-ae47-abcc3d302fc0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr