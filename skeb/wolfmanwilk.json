txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=0ff1e23f59aecaac3676116ad9472d81", "src_set": ""}, "private": true, "genre": "art", "tipped": false, "creator_id": 1682576, "client_id": 3549981, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 48, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@wolfmanwilk/works/42", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1682576, "client_id": 0, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/2070821f/uploads/origins/00fd4ef0-19bf-441c-b297-d7472a6d0fd1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=32b00a18e81beed10b88fbe784ba5330", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": true, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/2070821f/uploads/origins/00fd4ef0-19bf-441c-b297-d7472a6d0fd1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=97705dae6c2a6b80b287634c2dc1d7de", "src_set": ""}, "body": "ゼンゼロのライカンのイラストをお願いします。\n◎シチュエーション\nプロキシを守るために圧倒的な実力を持つ人型モブ敵と戦い、敗れ気絶したライカンが後頭部を鷲掴みにされて持ち上げられ、画面外にいるプロキシに見せつけられる形で金的拷問を受ける。\n下記の様なミニストーリーを感じられる差分形式だと好ましい\n1.白目を剥いて口から涎と舌を垂らし、全身から力が抜けた様子で失神\n2.後頭部を掴んでいる敵により、股下から股間に向かって勢いよく足蹴りをくらい、急所を蹴られた痛みで意識を覚醒させ、絶叫\n3.その後も金的を受け続けた結果、あまりの痛みに気を失うこともできず、泣きながら虚な瞳で虚空を見つめ、口からは泡と舌を垂らし、失禁してズボンを濡らす\n・ライカン補足\n衣服着用、所々ダメージを受け、破けている部分があるが性器の露出はなし\n全身に土煙や打撲跡がついて薄汚れている\n足の義足はダメージの蓄積で所々に亀裂が入って武器としては使え無さそうな状態\n・構図、角度イメージ\nhttps://www.pixiv.net/artworks/87113968\n\nhttps://1drv.ms/f/c/0b63e87e2050d586/Ekusxp54q49Cs0HYCsn2X-kB8Fls7uWM4G64fWB9ll7NMw", "nc": 58, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@wolfmanwilk/works/41", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/c5282a7c/uploads/origins/08c30d01-3fbd-42a6-adf8-5384e2c2df55