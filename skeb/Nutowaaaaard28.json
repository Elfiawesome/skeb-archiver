巨乳で自分が普通なのがコンプレックス。その割にオシャレのためなら胸をアピールすることも忘れない。姉がコスプレ好きで、それに付き合っていろんな服を着させられたりしている。髪が短いのは姉にアレンジさせられまくるのを回避するため。\n髪にインナーカラーが入っている（三面図参照）目の色はインナーカラーと同じで緑ではないです（AIで資料を制作しているためややこしいですが、三面図参考でお願いします）\n※三つ目の資料は無駄に多いので見なくても大丈夫です。\n\nもしご縁がありましたら、よろしくお願いします。\nhttps://drive.google.com/drive/folders/1ldnQ85FiD2bewf2m3tZyI8EBekVtrdmj\nhttps://drive.google.com/drive/folders/1vEsUUbtBMMe0u8itbaKtlOKZw4UYNphw\nhttps://drive.google.com/drive/folders/1umL6bP_qJsYGhPLdkkSpP8bRMCBOUqkK", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Nutowaaaaard28/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3739584, "client_id": 2223302, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/2e0f6337/uploads/origins/cbfa28da-1352-4519-9e07-2605121458e7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f2a490ebad76ed894653f7858a64f846", "srcset": "https://si.imgix.net/2e0f6337/uploads/origins/cbfa28da-1352-4519-9e07-2605121458e7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f2a490ebad76ed894653f7858a64f846, https://si.imgix.net/2e0f6337/uploads/origins/cbfa28da-1352-4519-9e07-2605121458e7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=13e1c85ce629047ddcd516baaf1629c5 2x, https://si.imgix.net/2e0f6337/uploads/origins/cbfa28da-1352-4519-9e07-2605121458e7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=23d68ce0ea2287c6e13b3016bca63a5c 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/2e0f6337/uploads/origins/cbfa28da-1352-4519-9e07-2605121458e7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=4ca4c34d337889dee3a0d99fc9869192", "srcset": "https://si.imgix.net/2e0f6337/uploads/origins/cbfa28da-1352-4519-9e07-2605121458e7?bg=%23fff&auto=format%2Ccompress&fm