り屋だったりします。90年代（1990年代）のレトロな雰囲気、ファストフード、そして『ポケモン』のようなかわいいビデオゲームがテーマになっています。\n\n🎨 キュートでチャーミング、あるいはちょっとセクシーなイラストをいただけると嬉しいです！ 服装が複雑な場合は、ジャケットを着ている状態でも脱いでいる状態でも、自由に簡略化していただいて構いません。オレンジ色のアイメイク、フォーク、首元の黄色い髪、そしてトラの縞模様はぜひ描いてください！体の作りは細身でも筋肉質でも、お任せします！可能であれば、PNGまたはPSD形式で、背景が透明な状態でキャラクターをいただけると嬉しいです。\n\n🔗 デザインシートはこのGoogleドライブにあります：https://drive.google.com/drive/folders/1FaYt6Px4gFoySrIxBBYUn-Vycgx70yzM?usp=sharing \n\n使用目的は、XなどのSNS（投稿、アイコン、グラフィック）です。ご依頼をご検討いただき、ありがとうございます！", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@mojuke_/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1198879, "client_id": 3988469, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/1dc9568b/uploads/origins/6fe106c6-91a0-4303-a3ac-98c4d52066c3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5176fd78d49bd7602d08c5098b35b8fe", "srcset": "https://si.imgix.net/1dc9568b/uploads/origins/6fe106c6-91a0-4303-a3ac-98c4d52066c3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5176fd78d49bd7602d08c5098b35b8fe, https://si.imgix.net/1dc9568b/uploads/origins/6fe106c6-91a0-4303-a3ac-98c4d52066c3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=d89d1d2591157ddb105a4303459fc263 2x, https://si.imgix.net/1dc9568b/uploads/origins/6fe106c6-91a0-4303-a3ac-98c4d52066c3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=49b84d343b23711123da4a4eb126d873 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/1dc9568b/uploads/origins/6fe106c6-91a0-4303-a3ac-98c4d52066c3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=7db1c92f59a54d2300f48a19af0e4b32", "srcset": "https://si.imgix.net/1dc9568b/uploads/origins/6fe106c6-91a0-4303-a3ac-98c4d52066c3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=cr