いる。常に敵の数歩先を行く鋭い頭脳で支配し、政治を複雑なチェスゲームのように扱う。\n\n彼女の衣装の中からお好きなものをお選びいただき、その威厳と狡猾さを表現した表情やポーズ、あるいはあなたのインスピレーションで自由にお描きください！\nお忙しい中、ありがとうございました。あなたの美しいオーレリアンの解釈を楽しみにしています！\n\nhttps://drive.google.com/drive/folders/1h48SCEZS5gW3cF1RYNCuQ9RqIJ6fgqae?usp=sharing", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@tome_2150/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2848602, "client_id": 936713, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/6a52b972/uploads/origins/338bdd83-b978-4b5b-aadb-95bf8aad7636?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=cd3fda683c87ccb3774f278bffb8e3ab", "srcset": "https://si.imgix.net/6a52b972/uploads/origins/338bdd83-b978-4b5b-aadb-95bf8aad7636?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=cd3fda683c87ccb3774f278bffb8e3ab, https://si.imgix.net/6a52b972/uploads/origins/338bdd83-b978-4b5b-aadb-95bf8aad7636?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=cc7800760b8aa636f72c7ba34970dd59 2x, https://si.imgix.net/6a52b972/uploads/origins/338bdd83-b978-4b5b-aadb-95bf8aad7636?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=0f3a82d0bcf302af29b9460def10e15e 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/6a52b972/uploads/origins/338bdd83-b978-4b5b-aadb-95bf8aad7636?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=53e743dc9eeafd4e13af200fdcebeda8", "srcset": "https://si.imgix.net/6a52b972/uploads/origins/338bdd83-b978-4b5b-aadb-95bf8aad7636?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=53e743dc9eeafd4e13af200fdcebeda8, https://si.imgix.net/6a52b972/uploads/origins/338bdd83-b978-4b5b-aadb-95bf8aad7636?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&cro