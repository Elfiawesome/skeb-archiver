やすいようにお願いできたらと思います!\n（バスタイムを連想させるものであれば背景は簡素なもので構いません）\n\n最後に自キャラの詳細などを下記に添付させていただきます。\nご検討よろしくお願いいたします!!\nhttps://xfolio.jp/portfolio/tanigawara/works/747383\nhttps://xfolio.jp/portfolio/tanigawara/works/4137344", "nc": 41, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@TsOOy18PJWdw21h/works/9", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2292372, "client_id": 2570630, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/13b487c7/uploads/origins/94a05265-14e1-4f6d-b602-df1aee603aa0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=74c226884d2e1bcb33cf1421877ee2dc", "srcset": "https://si.imgix.net/13b487c7/uploads/origins/94a05265-14e1-4f6d-b602-df1aee603aa0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=74c226884d2e1bcb33cf1421877ee2dc, https://si.imgix.net/13b487c7/uploads/origins/94a05265-14e1-4f6d-b602-df1aee603aa0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b8840a2aa05d1cb013c021947295e054 2x, https://si.imgix.net/13b487c7/uploads/origins/94a05265-14e1-4f6d-b602-df1aee603aa0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=0ce98acb50faab7c2d7744ab23373266 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/13b487c7/uploads/origins/94a05265-14e1-4f6d-b602-df1aee603aa0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a2e39653e5cf2e09fb13bffde2b71535", "srcset": "https://si.imgix.net/13b487c7/uploads/origins/94a05265-14e1-4f6d-b602-df1aee603aa0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a2e39653e5cf2e09fb13bffde2b71535, https://si.imgix.net/13b487c7/uploads/origins/94a05265-14e1-4f6d-b602-df1aee603aa0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=c3e3e69