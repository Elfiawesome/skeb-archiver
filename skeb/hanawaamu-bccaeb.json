したりしているイラストがほしいです。 彼女も私も『ミスティック・メッセンジャー』という乙女ゲームが大好きで、スマホからそれぞれの好きなキャラクターのちびキャラのセリフ吹き出しが出てくるとかわいいと思います。彼女はサエラン（白髪の男の子）というキャラクターが大好きで、私はジェヒ（茶髪のメガネをかけた女の子）というキャラクターが大好きです。 まるでスマホでゲームをしているように見えて、キャラクターからメッセージが届き、スマホの上に小さなちびキャラの顔が現れるようなものが、すごくかわいいと思います！\nよろしくお願いします！\n\nhttps://drive.google.com/drive/folders/11OaW6SNTX9ts5hS91SEts6gOE-khfnqt?usp=sharing", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@hanawaamu/works/13", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1414829, "client_id": 1576583, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/1d74c32e/uploads/origins/60e3f8bc-27ad-48dc-87c9-dfc7e7461178?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b7362f4996373ee2f9950d5732d37704", "srcset": "https://si.imgix.net/1d74c32e/uploads/origins/60e3f8bc-27ad-48dc-87c9-dfc7e7461178?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b7362f4996373ee2f9950d5732d37704, https://si.imgix.net/1d74c32e/uploads/origins/60e3f8bc-27ad-48dc-87c9-dfc7e7461178?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=33e6188b0c3c44f1c0cdd5716120dc78 2x, https://si.imgix.net/1d74c32e/uploads/origins/60e3f8bc-27ad-48dc-87c9-dfc7e7461178?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=3e3520b971735400a7495b7d9411e474 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/1d74c32e/uploads/origins/60e3f8bc-27ad-48dc-87c9-dfc7e7461178?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f0d74eda776f05f4728abd92ae1a0905", "srcset": "https://si.imgix.net/1d74c32e/uploads/origins/60e3f8bc-27ad-48dc-87c9-dfc7e7461178?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f0d74eda776f05f4728abd92ae1a0905, https://si.imgix.net/1d74c32e/uploads/origins