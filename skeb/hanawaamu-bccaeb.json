: 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@hanawaamu/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1414829, "client_id": 1576583, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/124abf3e/uploads/origins/7b8f9d4e-75d4-43fe-84ec-afe502eedfb0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=cfd7b4c2dd1cfacff98fd297a4dd06e1", "srcset": "https://si.imgix.net/124abf3e/uploads/origins/7b8f9d4e-75d4-43fe-84ec-afe502eedfb0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=cfd7b4c2dd1cfacff98fd297a4dd06e1, https://si.imgix.net/124abf3e/uploads/origins/7b8f9d4e-75d4-43fe-84ec-afe502eedfb0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=6120d208f895e8748b8ddfb117c69f8f 2x, https://si.imgix.net/124abf3e/uploads/origins/7b8f9d4e-75d4-43fe-84ec-afe502eedfb0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b99ad4f9dada460139b1544d27438b8f 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/124abf3e/uploads/origins/7b8f9d4e-75d4-43fe-84ec-afe502eedfb0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=180d099284d471d2310f7374e5c2e827", "srcset": "https://si.imgix.net/124abf3e/uploads/origins/7b8f9d4e-75d4-43fe-84ec-afe502eedfb0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=180d099284d471d2310f7374e5c2e827, https://si.imgix.net/124abf3e/uploads/origins/7b8f9d4e-75d4-43fe-84ec-afe502eedfb0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=1c8544cad95bfc767f16d7ee8b6b82dc 2x, https://si.imgix.net/124abf3e/uploads/origins/7b8f9d4e-75d4-43fe-84ec-afe502eedfb0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=d581d06f1d8c57894240bd51559610b0 3x"}, "body": "Characters: Yu Takasaki (高咲 侑), Shioriko Mifune (三船 栞子), Setsuna Yuki (優木 せつ菜)\nRequest Details:\nPlease draw a joyful \"L! L! L! (Love the Life We Live)\" performance scene with Yu, Shioriko, and Setsuna!\nThe Scene:\nThey are performing on a bright live stage in front of a cheering audience which is same background as the L L L stage from All Star .\nShioriko is clinging tightly to Yu’s right arm with a happy, beaming smile.\nSetsuna is standing on Yu's left side, Yuu and setsuna holding hand together  .\nAll three are looking at the audience and doing a V-shape (peace sign) posetogether.\nCostumes:\nShioriko Yuu and Setsuna are wearing their official \"L! L! L!\"outfits.\nPlease draw Yuu Takesaki L! L! L!\" Dress which is same as Yuki Setsuna like this   https://jmp.sh/ftzlpEid ).\nPlease make the atmosphere extremely \"Tokimeki\" and full of idol energy!\nReferences: https://jmp.sh/ftzlpEid https://jmp.sh/rZdmJ116\nThank you!", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@hanawaamu/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1414829, "client_id": 502288, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/3682c452/uploads/origins/99fbeaa0-71f6-41dc-866c-27bc249daf0e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d7e8b43d96f4efefca7f497be6984997", "srcset": "https://si.imgix.net/3682c452/uploads/origins/99fbeaa0-71f6-41dc-866c-27bc249daf0e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d7e8b43d96f4efefca7f497be6984997, https://si.imgix.net/3682c452/uploads/origins/99fbeaa0-71f6-41dc-866c-27bc249daf0e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=06575e8689d5571e86f793febd7dde66 2x, https://si.imgix.net/3682c452/uploads/origins/99fbeaa0-71f6-41dc-866c-27bc249daf0e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=2