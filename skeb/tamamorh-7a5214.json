racter materials.\n We would like to use them for the following purposes.\n We would like to use the illustration for the following purposes\nUse in distribution, use in videos, and thumbnail images.\nWe would like the illustration to look like a heart made with the middle and index fingers of both hands and smiling at us. (Composition as shown in the third reference material.) We would like to leave the rest to you. We would also appreciate it if you could provide us with a transparent background so that we can easily use it as a thumbnail.   We are sure you have many requests, but we look forward to working with you!\n\nhttps://drive.google.com/drive/folders/1D9YTU4yAoLnAA5fGZPgbc-DFqN_XhOBG", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@tamamorh/works/10", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1730767, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/806e2969/uploads/origins/2e52701b-4fc9-4a67-adcb-92eaaf45729b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=31f006a199866625fa30b3095ba96692", "srcset": "https://si.imgix.net/806e2969/uploads/origins/2e52701b-4fc9-4a67-adcb-92eaaf45729b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=31f006a199866625fa30b3095ba96692, https://si.imgix.net/806e2969/uploads/origins/2e52701b-4fc9-4a67-adcb-92eaaf45729b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c6eaf1aa800a5b88d22b506870fad912 2x, https://si.imgix.net/806e2969/uploads/origins/2e52701b-4fc9-4a67-adcb-92eaaf45729b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=227c0206de09bab1b22e4c65b8b77492 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/806e2969/uploads/origins/2e52701b-4fc9-4a67-adcb-92eaaf45729b?bg=%23fff&auto=format%2Ccompress&fm=webp&f