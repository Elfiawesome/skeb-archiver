skeb.\n　　https://lit.link/richieru\n　　＞About fan art\n　　＞ We are also very happy to receive requests via Skeb, etc.\n\n⬛︎Standing picture material\nhttps://drive.google.com/drive/folders/1RmMtn70PGbTCMQlVt6YzwC7ViSm2kxIH\n\nI know you are busy, but thank you very much for your cooperation.\n\nhttps://drive.google.com/drive/folders/1RmMtn70PGbTCMQlVt6YzwC7ViSm2kxIH", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@tamamorh/works/12", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/5b6b8168/uploads/origins/650fc795-4cbd-4c0c-b7bf-bf8526f0c797?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=2a4fe6f2de33ee01562660814f6a102d", "srcset": "https://si.imgix.net/5b6b8168/uploads/origins/650fc795-4cbd-4c0c-b7bf-bf8526f0c797?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=2a4fe6f2de33ee01562660814f6a102d, https://si.imgix.net/5b6b8168/uploads/origins/650fc795-4cbd-4c0c-b7bf-bf8526f0c797?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=f8b2ceb3cc7843863a056359361f35bf 2x, https://si.imgix.net/5b6b8168/uploads/origins/650fc795-4cbd-4c0c-b7bf-bf8526f0c797?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=b39da511ea8ff47b6c46d9b08f559d66 3x"}, "private": true, "genre": "art", "tipped": false, "creator_id": 1730767, "nc": 129}, {"path": "/@tamamorh/works/11", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1730767, "client_id": 3078908, "vtt_url": null, "thumbnail_image_urls": {"src": "h