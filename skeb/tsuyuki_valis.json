せていただく場合があります\n・大切に使わせていただきます\n\nご検討いただけますと幸いです。\nどうぞよろしくお願いいたします…！", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@tsuyuki_valis/works/39", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/c0e5196b/uploads/origins/1c190497-1ca1-4939-9c3e-b1d5d3c6fbec?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=13603764b6feed4706e6584b23f6ffb4", "src_set": ""}, "private": true, "genre": "art", "tipped": true, "creator_id": 728166, "client_id": 43564, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 128, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@tsuyuki_valis/works/38", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 728166, "client_id": 162245, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/68ff03b0/uploads/origins/42582476-10bd-4e6a-969a-00c1b80e9973?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ecb1ca85d024a4b9277494d41d7e0269", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/68ff03b0/uploads/origins/42582476-10bd-4e6a-969a-00c1b80e9973?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=bf87ccdea082ae1657fd0f811ddd47bf", "src_set": ""}, "body": "こんにちわ \nオリジナルキャラクターの新しい衣装をリクエストしたい\n\nhttps://www.dropbox.com/scl/fi/u5zv5bh4a45gle5y24bxw/Sinner-Swimsuit-1-Char-Sheet.jpg?rlkey=23htpjiouut2k6l7pkgu78ewi&dl=0\nポーズ :おまかせください。\n背景  : おまかせください。\n\nご検討のほど、よろしくお願いいたします。", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@tsuyuki_valis/works/37", "private_thumbnail_image_urls": {"src": "ht