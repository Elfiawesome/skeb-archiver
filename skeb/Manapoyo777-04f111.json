は自分の足で会いに行くことを信条とします。\n歩く練習も欠かさず、想い人である主人公には勇気を出して積極的にアプローチしていきます。\nその中で青薔薇の花言葉を知り、自身の才能として開花させていきます。\n\n▪︎外見の特徴\n・植物ゆえの緑肌\n・片三つ編みの先端が青薔薇\n・髪が硬化したピンクの4本ツノ(トゲ)\n・青い爪\n・エルフ耳\n\n衣装や構図はたけだ様にお任せします。\n内容に差し支えなければよろしくお願いします！", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 2639418, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "等星", "screen_name": "arudireo", "avatar_url": "https://pbs.twimg.com/profile_images/1809285255301591044/inoviv5m.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1270218666861195265/1775639528/1500x500", "appeal_receivable": true, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "art"}, {"genre": "video"}], "banned": false, "nc": 1}, {"id": 2685408, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "薄明薄暮", "screen_name": "Hakumei_twi", "avatar_url": "https://pbs.twimg.com/profile_images/1638212526960934913/nBV01X_L.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1609439935014260736/1679415278/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 7, "complete_expiration_days": 30, "skills": [{"genre": "art"}], "banned": false, "nc": 145}, {"id": 2899059, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "尾滸ネ れのぃ", "screen_name": "renoi_i", "avatar_url": "https://pbs.twimg.com/profile_images/1688778903543050240/SPmyLoxc.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1115951438071341056/1708414149/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_accept