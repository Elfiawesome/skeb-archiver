46da-95ca-8dab86d6b384?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=36b76c0f47a9cbdae2b1e3dd10a6527b 2x, https://si.imgix.net/9e9a911b/uploads/origins/467e16de-5455-46da-95ca-8dab86d6b384?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=0e6bdcdd65a89c3d8306422e37941f3f 3x"}, "duration": null, "nsfw": true, "hardcore": true, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/9e9a911b/uploads/origins/467e16de-5455-46da-95ca-8dab86d6b384?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c485ff8ead997c8723fe706c5e72ae5a", "srcset": "https://si.imgix.net/9e9a911b/uploads/origins/467e16de-5455-46da-95ca-8dab86d6b384?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c485ff8ead997c8723fe706c5e72ae5a, https://si.imgix.net/9e9a911b/uploads/origins/467e16de-5455-46da-95ca-8dab86d6b384?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=af1d12ec68b2c9f667797d1409c38d8b 2x, https://si.imgix.net/9e9a911b/uploads/origins/467e16de-5455-46da-95ca-8dab86d6b384?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=d69fdaf605ac27c97e7946a80f9a8c4c 3x"}, "body": "こんにちは！いつもとくめいさんの素敵な作品を楽しませて頂いております。先日は一希の雄堕ち小説ありがとうございました！とくめいさんの書くアイドルのエロ小説もっと読みたいのでリクエスト失礼致します！\n以下リクエストの詳細になりますが とくめいさんの任意でストーリーの付け加え、シチュエーション、内容の調整などして頂いて構いません◎\n\n【リクエスト内容】\n匂いフェチでマゾ気味の九十九一希が誰にも言えない欲求をプロデューサーに満たして貰うイチャラブPつくエロ小説\n\n【登場人物】\n●プロデューサー\n・太ったおじさんP。包茎巨根で毛深い。\n・体臭と口臭がきつく、清潔感はあまり無い。\n・一希のフェチに付き合わされ定期的に性行為を行っていくうちに、一希から交際を申し込まれ次第にセックスするまでの関係に。\n・アブノーマルな性癖の一希に困惑していたがすっかり受け入れており、自分の前でしか見せない変態で淫乱なマゾメスの一希に寧ろ興奮している。\n☆プロデューサーはしっかり一希を責めるものの、強い言葉などは使わずほんのりイチャイチャした雰囲気があると嬉しいです。\n\n●九十九一希(公式設定改ざん)\n・知的で大人しく品のある雰囲気なので、周囲からは性欲が無いと勝手に思われているが 実はかなりの淫乱で性欲が強いメス男。\n・妄想癖のある匂いフェチで濃ゆく蒸れた雄の匂いを非常に好んでおり、清潔感のない男性ファンに好き勝手される妄想でオナニーしている。\n・普段は決して欲求を表にすることはなく、プロデューサー以外の誰にも本当の姿を知られていないが、レッスン後やライブ後などふとした時に汗の匂いでむらむらしてしまう。\n・マゾ気味でじっくり時間を掛けて焦らされるようなプレイが好み。乳首が弱点で弱く優しくいじめられるのがお気に入り。\n・限界まで焦らされると甘えだし、口調も幼い子供のように。一人称が〝かずき〟になりちんぽをおねだりしたり唸ったりしてしまうが、ちんぽを与えられたりアクメしたりするとむらむらが落ち着いて正気になるのか口調など普段通りに戻る。\n・フェチの相手をしてくれたり、何より自分の素顔を受け入れてくれるプロデューサーの事が大好きでとても信頼している。また、性的な関係を持った相手はプロデューサーのみ。\n\n【シチュエーション】\n(小説で読みたいシーン･ストーリーです)\n\n①：プロデューサーとのキス＋乳首責め･匂い責め\n・口臭がきついプロデューサーと抱き合う様に密着いちゃいちゃベロキス\n・乳首をすりすりされながらキス、プロデューサーのベトベト唾液と一希の唾液を交換\n・キスの最中にいきなり一希の鼻をかぶり付き鼻を舐め回す、同時に乳首カリカリ引っ掻かれて驚き･強い快感･口臭等の様々な情報に混乱しながら乳首責めと匂い責めでアクメ。\n\n②：ちん嗅ぎ、チンカス舐め、フェラ＋ちん舐め、飲精＋ザーメンゲップ\n・プロデューサーの蒸れた下着の上から布越しちん嗅ぎ、皮の下にチンカスがたっぷり溜まった包茎ちんぽを嗅ぐ。\n・皮の中の粘着質で不潔なチンカスを舐め取る、チンカスを吟味する(くちゅくちゅとチンカスを噛む音が鳴る)、口で溶かしたチンカスを音を立て飲み込む。\n・舌を這わせるだけの焦らしちん舐め(一希の熱い鼻息がかかる)、ねっとりしつこくフェラチオ。\n・口の中いっぱい溜まったどろどろ粘っこい大量の精子を時間を掛けて飲み込む(少しもたつきながら懸命･幸せそうに飲み込む様子で)、自分の出したゲップのザーメン臭でアクメ。\n《補足》\n・ちん嗅ぎ･フェラ中は興奮を抑えれない様子で情けなく腰ヘコ。\n・フェラ音は〝れるれる〟〝ちゅぽちゅぽ〟等、複数。\n・舌を出したり舐める際は〝へっ へっ〟口を閉じていたりしゃぶる際は〝ふっ ふっ〟といった一希の口の形に合わせた息遣いで、息をたくさん感じれる描写をよろしくお願いします！\n\n③：射精後のちんぽを嗅ぎながら手マンされる\n・プロデューサーが服を脱ぎ一希の顔面の上に跨り逆顔面騎乗。\n・身動きを取れないまま濃い匂いがする射精後のちんぽ･キンタマの裏側を嗅がされながらプロデューサーの太い指で手マンされ、おほ声を上げながら深めのアクメを決める。(焦れ込んだアナルを手マンされ快感の強さに驚き間抜けな喘ぎ声が漏れる)\n《補足》\n・逆顔面騎乗ではハード過ぎない程度の一希に配慮した柔らかいSM描写で。\n\n④：大好きなプロデューサーの匂いを嗅ぎながら挿入お預けされた後寝バックで責められる\n・うつ伏せの一希にのしかかるプロデューサー、一希はプロデューサーの汗や体臭がたっぷり染み込んだ枕に顔が押し付けられる体制に。\n・一希のアナルにちんぽを当てアナルがヒクつく感覚を亀頭で楽しむ。やっと挿入して貰えると思っていた一希は焦らされすぎて情けなくちんぽを強請り唸りだす。\n・プロデューサーにのしかかりされ圧迫されつつゆっくり挿入。腰を密着されぐりぐりぞりぞりしたじっくり寝バックでネチネチとお腹の裏側をカリで擦られる。\n\n⑤：抱き合いながら正常位らぶらぶキスハメセックス\n・息をする度プロデューサーの体臭を吸い込み、ベロキスをしながらどちゅどちゅと勢いよく犯され一希の口からとびきり下品なおほ声が漏れる。\n・ 中出し後は死んだカエルの様な無様な格好でぴくぴくと痙攣しつつ失神、おしりからはブピッと下品な音のマン屁をし中出しされた精子が溢れ出てくる。\n\n【追記】\n・一希の喘ぎは声量控えめ気味でくぐもった呻きと喘ぎが混ざった様な低音おほ声。段々と獣の様な声に。\n・プロデューサーの射精音は〝ぶりゅぶりゅ〟〝びゅく、びゅぶっ〟等、下品な音がするものをよろしくお願いします。\n・時間かけてじっくり責められるドロドロな描写、特に息を感じられる描写をお願いします！\n・下品なオノマトペや露骨な表現、下品な単語や淫語、喘ぎは濁点とハート多めでお願いします！\n・一希がプロデューサーにマーキングされ一希自身それを喜ぶ様子や台詞、美形クールアイドルの一希がプロデューサーと共に汚れていくイメージの下品で卑猥な作品にして頂きたいです。\n\n以上の内容が入った作品をお願いしたいです。リクエストが大変細かくなってしまい、申し訳ございません。書きやすい場面のみ拾って頂いても問題ありません。\nとくめいさんの作品大好きです！いつも本当にありがとうございます！", "nc": 187, "word_count": 20768, "transcoder": "text", "creator_acceptable_same_genre": false}], "sent_works": [], "similar_creators": [{"id": 171829, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "十二屋月蝕", "screen_name": "twelveth_moon", "avatar_url": "https://pbs.twimg.com/profile_images/378800000369333903/68b63b84187cef418d6056eb2eebb2f5.png", "header_url": null, "appeal_receivable": true, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 90, "skills": [{"genre": "novel"}, {"genre": "correction"}], "nc": 160}, {"id": 504753, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "風音", "screen_name": "kazanenooto", "avatar_url": "https://pbs.twimg.com/profile_images/1504711719364730883/cKkLGkRK.jpg", "header_url": null, "appeal_receivable": true, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 120, "skills": [{"genre": "novel"}], "nc": 168}, {"id": 1412849, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "雪頂点🔞@依頼募集中", "screen_name": "o3ycJe9N2NMVLp4", "avatar_url": "https://pbs.twimg.com/profile_images/1429314490625974275/X-5TdrQQ.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1373257232603783168/1629610106/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "correction"}, {"genre": "novel"}], "nc": 33}, {"id": 1576935, "creator": true, "nsfw_acceptable": true, "acceptable": false, "name": "えちひろ", "screen_name": "skhr_cv", "avatar_url": "https://pbs.twimg.com/profile_images/1740156380135522304/ZAq5yncQ.jpg", "header_url": "https://pbs.twimg.com/prof