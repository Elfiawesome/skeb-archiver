com%2Fprofile_images%2F2036024288042688512%2FcYK7O0GI.jpg?blend64=aHR0cHM6Ly9za2ViLWF2YXRhci5pbWdpeC5uZXQvfnRleHQ_&blendalpha=100&blendalign=center&blendmode=normal&blendsize=inherit&bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=be4ad51e0be43dc1a1d0eaef5d895fcc", "srcset": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F2036024288042688512%2FcYK7O0GI.jpg?blend64=aHR0cHM6Ly9za2ViLWF2YXRhci5pbWdpeC5uZXQvfnRleHQ_&blendalpha=100&blendalign=center&blendmode=normal&blendsize=inherit&bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=be4ad51e0be43dc1a1d0eaef5d895fcc, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F2036024288042688512%2FcYK7O0GI.jpg?blend64=aHR0cHM6Ly9za2ViLWF2YXRhci5pbWdpeC5uZXQvfnRleHQ_&blendalpha=100&blendalign=center&blendmode=normal&blendsize=inherit&bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=ab40999a08a6bb65904e7de2f4f75b5e 2x, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F2036024288042688512%2FcYK7O0GI.jpg?blend64=aHR0cHM6Ly9za2ViLWF2YXRhci5pbWdpeC5uZXQvfnRleHQ_&blendalpha=100&blendalign=center&blendmode=normal&blendsize=inherit&bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=ffb23de5ab0fe184773cfa8c03a6d2a8 3x"}, "body": "Pixivリクエストの続編をお願いいたします。\n\n〇ヒロイン\n二条桜子 \n〇内容\n「二条にラブホへ呼び出され、欲求不満解消のためエッチする」\n〇シチュエーション\n①\t夏休み学校で仕事中の主人公に二条から「助けて」のメッセージとラブホの住所が送られてきて、急いで向かう主人公。ラブホには援交後、相手が逃げて満足できていない二条が待っていた。 \n②\t援交相手に満足できなかったため、主人公を呼び、主人公を誘惑してエッチに入る。\n③\tエッチの最中に近衛から電話がかかってくる。近衛も援交をしていて終了後、二条に感想を話すために電話してきた。二条と主人公がエッチ中だと分かると、主人公を煽るためにさっきまでのエッチを話して興奮させる。\n④\tラブホから出た後、車の中でも主人公を弄りながら興奮させ、他のラブホに行くか、主人公の家、又は夜の学校でのエッチを提案する。 \n〇希望プレイ\n・ホテル内でのタイツでの足コキ\n・正常位最中のキスハメ\n・主人公とほかの男性（援交等の相手等）の男性器比較（大きさや主人公の仮性包茎のからかい）プレイ中の二条からと電話越しの近衛の二人からお願いします。\n〇寸止め等の有無\n・足コキと車の中での誘惑の際にお願いします。\n\n内容、金額的に難しいであればキャンセルや再送等していただいて結構です。\nお願い事が多く申し訳ありませんが、ご検討の程よろしくお願いいたします。\n\nhttps://www.pixiv.net/novel/show.php?id=18684652", "nc": 176, "word_count": 13756, "transcoder": "text", "creator_acceptable_same_genre": false}, {"path": "/@ahiru_past/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "novel", "tipped": false, "creator_id": 1756959, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/906182b5/uploads/origins/fe0c24bb-82f6-4f47-86dc-99ac34f63099?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b7f1754197378f39aed3563f22a0ec87", "srcset": "https://si.imgix.net/906182b5/uploads/origins/fe0c24bb-82f6-4f47-86dc-99ac34f63099?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b7f1754197378f39aed3563f22a0ec87, https://si.imgix.net/906182b5/uploads/origins/fe0c24bb-82f6-4f47-86dc-99ac34f63099?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=7f9fc3fcf9755e47250b59511623b525 2x, https://si.imgix.net/906182b5/uploads/origins/fe0c24bb-82f6-4f47-86dc-99ac34f63099?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=3ef005d467333b0fd3889b4f45a2cb18 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/906182b5/uploads/origins/fe0c24bb-82f6-4f47-86dc-99ac34f63099?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0bc00a2b37fdaa9a68f5e5b32377552a", "srcset": "https://si.imgix.net/906182b5/uploads/origins/fe0c24bb-82f6-4f47-86dc-99ac34f63099?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0bc00a2b37fdaa9a68f5e5b32377552a, https://si.imgix.net/906182b5/uploads/origins/fe0c24bb-82f6-4f47-86dc-99ac34f63099?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=d0a17d991c5ee40eb9ab649a27069d48 2x, https://si.imgix.net/906182b5/uploads/origins/fe0c24bb-82f6-4f47-86dc-99ac34f63099?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=41f1ce1341430e41854d3e443072c368 3x"}, "body": "アイドルマスターシンデレラガールズの鷹富士茄子の女性上位をください。\n設定は自分のシチュで変身ヒロインという設定を入れますがただの女性上位責めで大丈夫です。\n設定登場人物　鷹富士茄子　変身ヒロイン。変身コスチュームはミニスカートレースクイーンのようなもので紫色のブルマを履いている。\n\nプロデューサー　変身ヒロインの補助をしている。\n\nシチュ\n①まず茄子は変身ヒロインとして日々戦っていた。その際に尻が大きくなってきたためプロデューサーに頼んでコスチュームの新調をたのむことにする。ジャージをきてプロデューサーの前に巨尻を突き出し尻のサイズを測ってもらう。その時に茄子がイタズラでわざと顔に尻をあてる。\n\n②それからプロデューサーは茄子の尻を意識してしまいストレッチをするときなど茄子の尻をガン見してしまうようになる。茄子もそれを分かってわざとパツパツのジーンズを着たりパンツを見せてくるようになる。\n\n③徐々にその行為がエスカレートしてわざと股間に尻を当ててきたりするようになり、ある日プロデューサーがソファで寝ていて起きると目の前に茄子のジャージに包まれたデカい尻があり茄子が尻を突き出している光景があった。そこから尻コキ、顔面騎乗をされてプロデューサーは射精してしまう。\n\n④新調されたコスチュームをみせて「こんなケツが大きいならヒップアタックで敵を倒すか」と茄子が冗談で言ってきて変身コスチュームのまままたら顔面騎乗される。\n\n\n\n補足　\n巨尻描写満載でお願いします。\n③や④ではジャージや変身コスチュームは脱がないでそのままでお願いします。\n書きにくい箇所があったら好きに書いてください。", "nc": 48, "word_count": 52354, "transcoder": "text", "creator_acceptable_same_genre": false}, {"path": "/@ahiru_past/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "novel", "tipped": false, "creator_id": 1756959, "client_id": 1594172, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/8de06919/uploads/origins/962e4504-2163-45af-ab2a-b9d7ede1e9e4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4fe5efd062d09ad27c72260d6cde8396", "srcset": "https://si.imgix.net/8de06919/uploads/origins/962e4504-2163-45af-ab2a-b9d7ede1e9e4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4fe5efd062d09ad27c72260d6cde8396, https://si.imgix.net/8de06919/uploads/origins/962e4504-2163-45af-ab2a-b9d7ede1e9e4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a2a458042ba680d30df990e4415c2bf8 2x, https://si.imgix.net/8de06919/uploads/origins/962e4504-2163-45af-ab2a-b9d7ede1e9e4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f42fa015f0675424e45583c2d32fc005 3x"}, "duration": null, "nsfw": true, "hardcore": true, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/8de06919/uploads/origins/962e4504-2163-45af-ab2a-b9d7ede1e9e4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ba1204434cf91723e2f222ca0864ac1d", "srcset": "https://si.imgix.net/8de06919/uploads/origins/962e4504-2163-45af-ab2a-b9d7ede1e9e4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ba1204434cf91723e2f222ca0864ac1d, https://si.imgix.net/8de06919/uploads/origins/962e4504-2163-45af-ab2a-b9d7ede1e9e4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=598951f6b5622489c5e1c535a4858ca5 2x, https://si.imgix.net/8de06919/uploads/origins/962e4504-2163-45af-ab2a-b9d7ede1e9e4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=204329a5183c4d6779934c87446c1b3c 3x"}, "body": "リクエスト失礼します！\n今回はサイズフェチの話を書いてただきたいです！\n\nひょんなことから突然、異世界に飛ばされてしまった男子中学生たち。\nあたりを見回すと、そこは巨大な魔物娘に支配された世界。\nその世界では、人間は小人（1cm程度の大きさ）であり、巨大な魔物娘たちに見つかれば、彼女たちの餌やおやつ、おもちゃにされてしまう。\nそんな危険すぎる世界で、彼らは生き残り、無事、元の世界に戻ることができるのか！？\n（もちろん、全員が魔物娘たちのおもちゃ兼おやつにされてしまう全滅エンドです）\nみたいな話でお願いします！\n\n■シチュエーション\n大きく分けて二つのシチュエーションを書いて頂きたいです！\n\n①\tメスガキスライム二人組のおやつ（前半）\n突然、異世界ワープに、訳も分からず、混乱し、あげく喧嘩までしてしまう男子中学生たち。\n「何喧嘩してるのー…？」「小人同士仲良くしないと、だめでちゅよー？ｗ」\nそんなところを巨大なスライム娘の二人組に見つかってしまい、喧嘩していた二人が真っ先に捕まってしまう。残りの中学生たちは、あまりの恐怖に二人を置き去りにし逃げ出す。\n「みんなぁ～置いてかないでぇ～！」という声も届かず、置き去りにされてしまった二人。\n「仲間割れー……？かわいそ……♡」「喧嘩なんかしてるから、見捨てられちゃうんでちゅよ～？♡ばぁ～か♡」\nみたいな感じで煽られ、スライム二人のお家にお持ち帰りされて、捕食スタート。\n\nまずは、明るく生意気なメスガキスライムが小人君一人を捕食。\n口内で飴玉のように転がして、射精させて味見してから、丸呑み。\n（https://www.pixiv.net/novel/show.php?id=18290189）\n（https://www.pixiv.net/artworks/101966432）\n↑のイラストと小説のように、体内で小人君を搾精。\n腸内のイボイボヒダヒダやスライムもっちりとしたお肉などで、何度も射精させ、精子を搾り取る。\nもう一人の小人君はお腹に当てて、食べられちゃった小人君の悲鳴や喘ぎ声を聞かせながら、スライム二人が実況解説。\n中でどんな風に搾り取られているのか、中の小人君の様子など、「次はお前がこんな風に搾り取られるんだぞー♡喰われちまうんだぞー♡」と言わんばかりに、恐怖を煽るようにいじめる。\nそして、精子をぜーんぶ搾り取られたら、消化吸収の時間。\nスライムのお肉に取り込まれ、吸収されてしまう。\n\n次は、ダウナー系の気だるげなスライム娘。\n最初は生意気だったが、恐怖で震える小人を摘まみ上げると、巨大な唇でちっちゃなペニスを挟み込み、ちゅーちゅー♡と味見フェラ。\n小人君の抵抗もむなしく、凶悪なえげつないフェラで、精子を搾り取られる。\n「うっまー…♡」と味見が終わったら、本当のおやつタイム。\n（https://www.pixiv.net/artworks/98159737）\n↑のイラストのように、スライムの核の部分で本気の捕食。\n大きなお口のような核で、小人をフェラしたり、丸呑みにしてもぐもぐと咀嚼して搾精。\n二人でバカにしながら、美味しそうに精子を搾り続ける。\n搾り切ったら、もちろん吸収。核の中でゆっくりと消化して吸収してしまう。\n最後は、満足したスライム娘二人が、また新たなおやつ（小人）を探しに行くところで終了。\n\n②\tフットサキュバスJKたちのおやつ（後半）\n前半、やんちゃな生徒たちが、ギャルJKたちに襲われるシチュ。\n後半、大人しめの性格の生徒たちが、JKの足ペットにされてしまい、授業の教材にされてしまうシチュ。\n\n必死に逃げているうちに、とある学校に迷いこんでしまった男子中学生たち。\n同じ仲間を見捨てたことで、意見が分かれ、また仲間割れが起きてしまい、２グループぐらいに散り散りになってしまう。\n「みんな一致団結した方がいい」という意見も、もう一つのやんちゃな生徒たちのグループには無視され、取り残されてしまった大人しい性格の男子中学生3人のグループ。\nみんなの後を追うように、学校を探索することに。\nその学校は、足での吸収が得意なフットサキュバスたちの高校。\n自分たちとは同い年ぐらいの多くの小人たちが、サキュバスJKたちの、おもちゃ、おやつとして消費されていた。\nもちろん、それは自分たちも例外ではなく……\nさきほど、仲間割れしてしまったやんちゃな学生たちのグループが、サキュバスのギャルＪＫたちに襲われているとこを目撃してしまう。\n（https://www.pixiv.net/novel/show.php?id=15809315）\n（https://www.pixiv.net/novel/show.php?id=16272372#2）\n↑の小説のように、いじわるなサキュバスギャルたちに、足キスしながらオナニーを強要されたり、ハイソックスの足裏に全身をむぎゅむぎゅ♡と押し付けられながら搾り取られたり、ハイソ足裏でサンドイッチにされたり、足指とセックスを強要されたり…\n生意気でやんちゃな生徒たちも、「やぁ～ん♡ごめんなさい♡許してぇ～♡」と謝ってしまうほどの凶悪なギャルたちの遊び。\nもちろん、彼女たちに容赦はなく、搾り尽くされたら、捕食タイム。\n（https://www.pixiv.net/novel/show.php?id=17295400）\nの小説のように、ハイソックス足やタイツ脚に監禁させられて、奥に残ったトロトロのミルクも根こそぎ搾り取られたのちに、吸収されてしまう。\n\nそんな残酷な光景に、恐怖し絶望する中、ほかのサキュバスJKたちに見つかってしまい捕獲されてしまう。\nそれから一週間後、舞台は変わってとある教室。\nそこでは、「小人の飼育方法」という、JKたちの授業が行われていた。\n「我が校には、学校指定の制服、靴、サンダル……そして、靴下が指定になっているが……\n理由は分かるか？」\n「そうだ、捕まえた小人を閉じ込めやすくするダメだな」\n「これが我が校指定のソックスとタイツだ」\n「種類は様々だが……主にタイツ、ハイソックス、ニーハイソックスは、厚手のリブ生地でできていて、縁のゴムがキツくなっている。そのため、ぴちっと締め付けも良くなって、\n中に入れられた小人は、もう逃げられない♡」\n「それじゃあ、実際にその様子を、見てみようか♡」\nと先生が、見本として生徒を指名し、教壇に呼ぶ。\n呼ばれた生徒は、1週間前に学生グループを襲ったJKグループの一人。\n兎のワンポイントが可愛い紺のハイソックス足。その足のつま先部部に、大人しめの学生3人のうち一人が捕まって、足ペットにされてしまっていた。\n「まずは、ハイソックスだ。元々リブの厚手の生地なのだが、その上、縁が靴下を折り返したようになって、より厚くなっているのが特徴的だな♡」\n「小人はちっちゃすぎますからな♡よく見えないだろ？ハイソックスの中で小人がどうなっているか、近くでじっくりと観察するぞ♡」\nと他の生徒も前に呼び出し、見本のJKを取り囲むように、至近距離で小人の観察を始める。\n「あっ♡せんせー♡つま先見てよっ！親指と人差し指の間…小人が逃げようとしてるー♡」\n「あら、本当だな♡どうせ無駄だというのに……可愛いもんだ♡我が校は、上履きがサンダルだからな、つま先も観察しやすいのがポイントだ♡」\n「出してっ♡ここから出してっ♡♡」\n「あーあ」\n「うわぁ」\n「あははwなにこいつw」\n「やっばwウケるーw」\n「つま先に張り付いて、必死にもがいて…逃げられると思ってるわけぇ？おバカさん♡」\n当然、逃げることもできず、何度も搾精されてしまう小人君。\n「逃げるどころか、射精しちゃってるじゃん♡」\n「あはは出た出た～♡こんな近くで見られたのラッキー♪」\n「はやっ♡もう2回目かぁ～♡小人ってやっぱり早漏なんだー♡」\n「ハイソックスの厚手感が気に入っちゃったのかなぁ？それとも、みんなに見られながらで興奮してるのかなぁ～♡」\n「もー♡また勝手に射精してー♡先生も…みんなも見てるのにー♡何で言うこと聞いてくれないのー！？もー怒った！君みたいな悪い子は…えいっ♡」\n※参考（https://www.pixiv.net/artworks/98338100）\n「ふぎゅっ─！？！？♡♡♡」\n「生意気な悪ガキの小人君には、足指パックンの刑だっ♡」\n「あーあ♡食べられちゃった♡」\n「あれは、もう助からないね♡ご愁傷様♡」\n「あ♡それいいかも♡今足裏にいる、うちの子にも、今度やってあげよー♡」\n「指の間でぱっくんって食べられちゃった♡小人にはお似合いね♡」\n「バカすぎ♡あはは♡」\n「ずっともぐもぐ食べられていなさいっ♡反省するまで、出してあげないんだからっ♡」\nみたいに、大勢いの生徒に観察＆バカにされながら、ハイソックス足の中でお仕置きされてしまう。\n「このように、逃げようなんて悪あがきをするような、バカな小人には、お仕置きも大事だ♡小人は女の子様に絶対勝てないんだぞー♡逃げられないんだぞー♡って分からせあげるんだぞ♡いいか？みんな？」\n「「「はーーーーいっ！」」」\n「では、次に行くぞ♡」\nと別の生徒に見本を頼む。\n次の生徒も、捕獲したJKのうちの一人。金髪ツインテのお嬢様っぽいJK。\nふちにラインが入った可愛らしい赤の厚手のリブハイソックスには、やはり学生の一人が足ペットとして監禁されていた。\n「ほら、みんなに見てもらえるんだよ♡まずは、ご挨拶のぴゅー♡でしょ♡早くしなさい♡」\n「抵抗してるー♡諦めが悪いねぇ♡」\n「お前らチビたちは、女の子の靴下にも勝てないんでちゅよー♡」\n「弱くて可愛いー♡もっといじめたくなっちゃう♡」\n「ハイソックスの足裏と愛し合ってるんだぁ♡ラブラブすぎ♡エッチだね♡」\n「邪魔しちゃ悪いからね♡続きはサンダルの中で♡ごゆっくりー♡」\nみたいに、足裏とのセックスやキスを強要されて、観察され、バカにされ、何度も精液を搾り取らてしまう。\nそして、最後は、先生がお手本になって小人の調教。\nもちろん、相手は、捕まっていた学生3人組の最後の一人。\n先生の足は、柄が入ったラメタイツ。\n（https://www.pixiv.net/novel/show.php?id=15809315）\n（https://www.pixiv.net/novel/show.php?id=16272372#2）\n（https://skeb.jp/@chinbotsu_tower/works/12）\n↑の小説とイラストのように、ふともものレールで小人を引きづり回したり、射精している小人の腰をトントンたたいて追撃射精させたり、足とセックスさせたり、凶悪なラメタイツのふとももと足で、小人君を根こそぎ搾り取る。\n最後は、小人君を気に入ってしまい、足ペット決定。\nタイツのふとももに監禁して、お持ち帰りしてしまう。\n\n結果、異世界に飛ばされた学生たちは実質全滅のBADEND。\n\n\n■キャラ設定\n\n・男子中学生たち。\n全員で10人ぐらい。\nよく喧嘩はするが、仲良しな二人組。（スライム相手）\nやんちゃで生意気なグループ。（ギャルJK相手）\n大人しめの3人組。（最後の授業）\n最終的に全滅してしまった。\n\n・スライム二人組\n明るく赤ちゃん言葉を多用してバカにする生意気なメスガキスライム娘。\nダウナー気味で気だるげだが生意気なメスガキスライム娘。\nメスガキだが、容姿はロリではなく、ＪＫぐらいの感じ。\n服は着ておらず、ちゃんとスライムのような身体をしている。\n\n・ギャルJK集団\nヤンキー系からダウナー系まで、それぞれ個性的な性格をしている。4人ぐらいのグループ。\n\n・サキュバス先生\n背が高い。教官みたいな口調。すごくいじわる。\n\n・クラスのJKたち\n普段は成績優秀でいい子たちだが、小人に対しては別。\nみんないじわるで容赦がない。\nちなみに、クラス全員が、足に小人を飼っている。\n\n■その他\n・指定がない、各キャラクターの見た目、また名前についてはお任せします。\n・上記に書いたセリフはあくまで参考です。自由に変更してもらって大丈夫です。\n・多くの台詞で構成された、台詞主体の小説にして欲しいです。\n（もちろん、台詞以外の描写も入れてもらって大丈夫です。）\nモン娘たちのいじわるな台詞はもちろん、\n喘ぎ声など、小人の台詞も沢山あれば嬉しいです！\nまた、射精する描写もたくさんあれば嬉しいです！\n\n以上、長文になってしまい申し訳ございません。\nお忙しいところ恐れ入りますが、よろしくお願いします！", "nc": 186, "word_count": 110152, "transcoder": "text", "creator_acceptable_same_genre": false}, {"path": "/@ahiru_past/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "novel", "tipped": true, "creator_id": 1756959, "client_id": 199793, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/a6be9ded/uploads/origins/0cbd700d-43ad-4d1c-abd5-298a1a773811?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=23ffcc2a1c3b3db70c01e2eca6ea60f7", "srcset": "https://si.imgix.net/a6be9ded/uploads/origins/0cbd700d-43ad-4d1c-abd5-298a1a773811?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=23ffcc2a1c3b3db70c01e2eca6ea60f7, https://si.imgix.net/a6be9ded/uploads/origins/0cbd700d-43ad-4d1c-abd5-298a1a773811?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=9e310e8ead10a328edcd0fdc3d434103 2x, https://si.imgix.net/a6be9ded/uploads/origins/0cbd700d-43ad-4d1c-abd5-298a1a773811?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=fc450a47f4574c627494b066241d5719 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/a6be9ded/uploads/origins/0cbd700d-43ad-4d1c-abd5-298a1a773811?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d0f7740de894dcb295663d5301cf54c1", "srcset": "https://si.imgix.net/a6be9ded/uploads/origins/0cbd700d-43ad-4d1c-abd5-298a1a773811?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d0f7740de894dcb295663d5301cf54c1, https://si.imgix.net/a6be9ded/uploads/origins/0cbd700d-43ad-4d1c-abd5-298a1a773811?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=70a25a5048a70763e010469936b1198d 2x, https://si.imgix.net/a6be9ded/uploads/origins/0cbd700d-43ad-4d1c-abd5-298a1a773811?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=b82a348859fa185e2bbdb706e0aac1d3 3x"}, "body": "艦これのあきつ丸が提督を篭絡するssをお願いします。\n容姿、口調など参考資料(改の黒い制服)\nhttps://wikiwiki.jp/kancolle/%E3%81%82%E3%81%8D%E3%81%A4%E4%B8%B8%E6%94%B9\n色白な感じで、身長は提督と同じくらいで女性としては高め、メートル越えのJカップ爆乳、口調は敬語をつかっても提督をおちょくってバカにしている感じで書いてください\n提督は奥手で童貞、ヘタレな感じ\n冒頭\n陸軍から出向してきたあきつ丸が着任挨拶、提督は制服越しの爆乳にムラムラしている\nあきつ丸、スパイ目的で提督の私室にこっそり侵入、大量のマゾ向けエロ本を発見し提督の弱みを握る\n数日後、急に提督を呼び出し、私室から持ち出したエロ本を何冊か差し出して「提督殿がマゾのド変態だったとは失望でありますなぁｗ」みたいな感じでおちょくり、土下座してボーナス全額を差し出せば本の内容のようなことをしてあげると誘惑\n土下座した提督の頭を踏みつけ、仰向けにしてニーソ足の臭いを嗅がせたり顔面騎乗したりニーソで足コキ射精させて、床にぶちまけた精子を踏み潰して「マゾの劣等遺伝子は抹殺しないといけないでありますな♡」と罵倒して提督を骨抜きに\n海軍の新装備の図面コピーと引き換えにパイズリをもちかける\n目の前で乳揺れさせ、エロ本にパイズリものが多かったことを持ち出してもっと気持ちよくしてあげる、と誘惑、提督を屈服させてパイズリ開始、\n制服を着たままズリ穴に乳内射精(1回目)制服をはだけて乳首が見える状態でパイズリ、顔や髪にぶっかけ(2回目)ズリ事後くぱぁをして谷間のザーメンブリッジを見せつけ「部下を裏切ってする射精はそんなに気持ちよかったでありますか?ｗ」と挑発\nその後もたびたびエロ自撮りを送って提督を呼び出し、靴下オナホや足舐め、ふとももコキなどで調教、そのたびに新しい機密情報を受けとる\nある日あきつ丸が、今まで提督で遊んできたが提督ばかり気持ちよくなってずるい、今度は自分に奉仕してほしいと押し倒してくる\n無理矢理ディープキスし、爆乳でぱふぱふや授乳した後で顔面騎乗し強制クンニ\n騎乗位でガンガン腰を振ってブチ犯し、提督がもう出ないと喘ぐ中、2発搾り取って提督が気絶\nエピローグであきつ丸が陸軍司令部に篭絡任務完了の報告をした後、提督とケッコンしたので死ぬまで搾り取ってやるであります、みたいな独り言を呟いて終わり(ハッピーエンド?)\n追伸：ぜひpixiv等で公開してください", "nc": 169, "word_count": 50805, "transcoder": "text", "creator_acceptable_same_genre": false}, {"path": "/@ahiru_past/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "novel", "tipped": false, "creator_id": 1756959, "vtt_url": null, "thumbnail_image_urls": {"src": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F2036024288042688512%2FcYK7O0GI.jpg?blend64=aHR0cHM6Ly9za2ViLWF2YXRhci5pbWdpeC5uZXQvfnRleHQ_&blendalpha=100&blendalign=center&blendmode=normal&blendsize=inherit&bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4a1c63fd8ffff156f6f35c2baa7a51d1", "srcset": "https://skeb-avatar.imgix.net/https%3A%2F%