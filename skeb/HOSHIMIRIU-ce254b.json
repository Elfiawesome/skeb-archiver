gle.com/drive/folders/13hBddiIoeDENY54mA6j5BUIWfRfg--3A\n\nご自由に描いてください。先生にとってかっこいいシーンであればうれしいです。\n\nご検討よろしくお願いします。\n\nhttps://drive.google.com/drive/folders/1o5wVZm2_d96skaWohudJzxVatK2kXtGI", "nc": 145, "word_count": 0, "transcoder": "video", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 2132955, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "きゅうた🥒", "screen_name": "4ki_10ma", "avatar_url": "https://pbs.twimg.com/profile_images/2062613315818528768/RWR5wTUM.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1268449563091714048/1767638633/1500x500", "appeal_receivable": true, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "art"}], "banned": false, "nc": 128}, {"id": 2844958, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "nyaco", "screen_name": "__nyancham__", "avatar_url": "https://pbs.twimg.com/profile_images/1887838777458245632/heliPiDn.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1672289379094790144/1757492088/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "art"}], "banned": false, "nc": 0}, {"id": 3019108, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "お2", "screen_name": "_onymki2", "avatar_url": "https://pbs.twimg.com/profile_images/2029120959173804032/PeYasDiI.jpg", "header_url": null, "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 120, "skills": [{"genre": "art"}, {"genre":