-b4d9-11f5f9a5c0e2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5fb4b24eba4f7c89e4635d1fe9fa94f8, https://si.imgix.net/5bf13d60/uploads/origins/b89588e2-d3d7-4c27-b4d9-11f5f9a5c0e2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=4d8baf0913b624fcff4d4fc147e2ae9f 2x, https://si.imgix.net/5bf13d60/uploads/origins/b89588e2-d3d7-4c27-b4d9-11f5f9a5c0e2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=b7d4a75114362e52cfb4f0b69726bbab 3x"}, "body": "初めまして。\nお忙しいところ大変恐れ入りますが、下記内容のリクエストをさせて頂きたく存じます。\n\n・概要\nうちの子の部族化ビフォーアフターが希望です。ざっくりしたイメージとしては、ロピ岡様の前々回納品されている作品のように、ビフォーとアフターが隣に並んだ全身立ち姿です。\n\n・キャラクター\n資料のうちの子、レイラ・ハリスをお願い致します。資料をベースに、ロピ岡様の絵柄へ合わせて頂ければ幸いです。\n\n・内容\nビフォーの姿ですが、資料2枚目の衣装を着たレイラで、明るく可愛く自信ありげな雰囲気の立ち姿をお願い致します。ポーズや表情は前途のイメージに合わせて頂ければ、細かいところはお任せしたいです。\n\nアフターですが、全体的なイメージは9月20日にpixivに投稿されていた部族ちゃんのような肌色、タトゥー、髪色、乳首色でお願いしたいです。性を崇める部族に拾われて数年後といったイメージで、胸や尻、太ももをビフォーよりしっかり大きくして頂ければ幸いです。また、濃いめの陰毛や乳首とへそへのピアスの追加もお願い致します。\n髪型は9月20日の部族ちゃんの右側の子のような前髪と、真ん中の子の様な編んだ後ろ髪に変えて頂きたいです。\n\nまた、もし可能であれば、妊娠した状態の差分も頂ければ幸いです。お腹の大きさは臨月のパンパンな状態が希望です。\n\n\n以上で御座います。\nお忙しいところ大変恐縮では御座いますが、ご検討頂ければ幸いです。\n\nhttps://www.pixiv.net/artworks/136310351#manga", "nc": 49, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@ropioka/works/15", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/5ca340a8/uploads/origins/881d4ce2-8070-459b-9665-e083120c888b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=bf3cc4e1593f23f4523f15f9c184a5fb", "srcset": "https://si.imgix.net/5ca340a8/uploads/origins/881d4ce2-8070-459b-9665-e083120c888b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=bf3cc4e1593f23f4523f15f9c184a5fb, https://si.img