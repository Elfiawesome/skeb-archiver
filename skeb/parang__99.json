ix.net/25eb66bc/uploads/origins/1d73138c-7812-48d2-8dc0-399ceef7c4dc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=00cc4e0cf498caebf236dedee3e4a57b", "srcset": "https://si.imgix.net/25eb66bc/uploads/origins/1d73138c-7812-48d2-8dc0-399ceef7c4dc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=00cc4e0cf498caebf236dedee3e4a57b, https://si.imgix.net/25eb66bc/uploads/origins/1d73138c-7812-48d2-8dc0-399ceef7c4dc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=24b6774cd49bad53c068c5cdfa7f276e 2x, https://si.imgix.net/25eb66bc/uploads/origins/1d73138c-7812-48d2-8dc0-399ceef7c4dc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=fa7a133c03e25579b84199fcc4250954 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/25eb66bc/uploads/origins/1d73138c-7812-48d2-8dc0-399ceef7c4dc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0ba7ee990447a1cc743908eeafeea963", "srcset": "https://si.imgix.net/25eb66bc/uploads/origins/1d73138c-7812-48d2-8dc0-399ceef7c4dc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0ba7ee990447a1cc743908eeafeea963, https://si.imgix.net/25eb66bc/uploads/origins/1d73138c-7812-48d2-8dc0-399ceef7c4dc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=2e0f6aa3f6fe2f99b519562c8d850cdf 2x, https://si.imgix.net/25eb66bc/uploads/origins/1d73138c-7812-48d2-8dc0-399ceef7c4dc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=bda5bb3ddd4af22a086fb61f93584ee4 3x"}, "body": "こんにちは、青鳥パラン！\n\nこちらの巡音ルカさんのデザインが大好きなので、その衣装を着た巡音ルカさんのイラストをお願いしたいです。ポーズや背景は問いません。ルカが増えると嬉しいです。\n\n衣装の参考\nhttps://x.com/parang__99/status/1900964461248475644\n\nご検討ありがとうございました！", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@parang__99/wo