DARCA」の探索者2名になります。\n\nキャラクター1 (HO正義)男性 190cm \n普段は明るく元気！でもちょっと死にたがり。顔にやけどの跡があるのが特徴。ごはんが好き！\n\nキャラクター2 (HO星)女性 160cm\nふわふわマイペース。こちらも明るいが抜けている所がある。大きいインテークが特徴。記憶喪失。\n\nタロットカードがモチーフの作品になっています。2人は元々軍で隊長を勤めていました。過去にトラウマがあり、お互いに火が苦手です。現在は両思いになり、恋人の関係になっています。\n\n使用用途:個人鑑賞、一緒に遊ぶ友人との共有、SNSでのアイコン使用\n\nシチュエーションや構図は問いません。\n自由に描いていただければと思います！\nよろしくお願いいたします！🙏\n\nhttps://drive.google.com/drive/folders/1xZoH-hcamMut3vHyKnXNunGebaFtCae5?usp=sharing", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@takita_mashi818/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3582314, "client_id": 3731249, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/06ea164e/uploads/origins/a1589650-aac2-4c7e-81d9-1650aa9bf5cd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=56a1f5cb324e94077ef6eace42efa175", "srcset": "https://si.imgix.net/06ea164e/uploads/origins/a1589650-aac2-4c7e-81d9-1650aa9bf5cd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=56a1f5cb324e94077ef6eace42efa175, https://si.imgix.net/06ea164e/uploads/origins/a1589650-aac2-4c7e-81d9-1650aa9bf5cd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=40decf9a06f1e0440013ddae9dcbe155 2x, https://si.imgix.net/06ea164e/uploads/origins/a1589650-aac2-4c7e-81d9-1650aa9bf5cd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=95c73890aab2a4e4b7761df39a1d33a2 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/06ea164e/uploads/origins/a1589650-aac2-4c7e-81d9-1650aa9bf5cd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=8d7853c3642d02be4ad945782fb4325a", "srcset": "https://si.imgix.net/06ea164e/uploads/origins/a1589650-aac2-4c7e-81d9-1650aa9bf5cd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=20