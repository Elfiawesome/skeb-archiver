何でもOKです！\n\n以上３点をお願いしたく考えています。\n\n■\nもともと東方等でのモス先生のキャラアレンジ力に舌を巻いていますので\nいかなる解釈やアレンジをいただいてもかまいません。\nなんならモス先生にキャラの新たな味付けをしていただきたいくらいですので\nほんと、自由に描いていただけましたら幸いです。\n\n■可能であれば～\n\n・いろいろ活用しますので\n　PSDでの背景とのレイヤー分けや、口や目などの差分があると、なお嬉しくはありますが\n　作業のついでにできる範囲内で作れれば、程度でかまいません。\n　また３点のイラストすべてに対しての希望でもありません。\n　あくまで余地があれば加味していただければという感じです。\n\n・作業の工程で試し書き、ラフ、落書き等がもし出ましたら、\n　私にとってはお宝ですので\n　全部頂戴できればと幸いです。\n\n三面図\nhttps://x.com/yukinadare/status/1957999674847023195\n\nYouTubeチャンネル【ご参考までに】https://www.youtube.com/@%E9%9B%AA%E9%9B%AA%E5%B4%A9%E6%B8%85%E9%9A%86", "nc": 160, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "similar_creators": [{"id": 155, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "缶詰ヤマネ", "screen_name": "kanzumezzz", "avatar_url": "https://pbs.twimg.com/profile_images/1969732281469468672/ssuvRA5w.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1947287723099963392/1753780095/1500x500", "appeal_receivable": true, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "none", "accept_expiration_days": 7, "complete_expiration_days": 60, "skills": [{"genre": "art"}], "nc": 49}, {"id": 1515164, "creator": true, "nsfw_acceptable": false, "acceptable": false, "name": "**nayuta/なゆた", "screen_name": "na_na_yu_ta", "avatar_url": "https://pbs.twimg.com/profile_images/1958059343942950912/8hmlEFVT.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1363285620320215043/1626405047/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 2, "complete_expiration_days": 15, "skills": [{"genre": "art"}], "nc": 145}, {"id": 2659354, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "つなしゃけ", "screen_name": "tyuna_24", "avatar_url": "https://pbs.twimg.com/profile_images/17820790261376