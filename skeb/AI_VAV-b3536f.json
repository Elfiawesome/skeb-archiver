humbnail_image_urls": {"src": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1508326053382541316%2FP-jeuphY.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d4e3de00ecf111c420d0ae5fc1d6c6f3", "srcset": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1508326053382541316%2FP-jeuphY.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d4e3de00ecf111c420d0ae5fc1d6c6f3, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1508326053382541316%2FP-jeuphY.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b531432d57ada9e2559bfce2febbd677 2x, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1508326053382541316%2FP-jeuphY.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=8fab12f2c83ae01fdd94fcb90b2c30ee 3x"}, "preview_url": "https://fcdn.skeb.jp/uploads/107030/0/mp3_128k/0?response-content-disposition=inline&Expires=1780411675&Signature=PaAGBx7sMKeDXYXGLvWCC-JTbcoo4GE92TwPg2-pW7nc1C3LR8IHIRBYHpURQCbEd96QgOmlG34rOx5UIBsMxQm1hkX5DEksytxKU3RUcGDLgS-PonxsR207PKd-Ox0x6REBbAe7fucIT8sOA7XO6K1zD5akjiB3TPRQzrrjwvhe3qnJsYYbDLQmMdKyB5rlDVv1YJRaD6HlSWu3VviDYtES5mm1S0YAl8~zvieBnYFQOIsAggoYhHN~Gn-9S776yzuFmV7~0AdjaNDgYAdpQlykb1hyZyV-uxJdpRuApfT25YwgRwLn3r8l66CA6mB9zsFFgYWv3ucYSJrkTMKJLA__&Key-Pair-Id=K1GS3H53SEO647", "duration": 300, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1508326053382541316%2FP-jeuphY.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=dc9e7632041c1aeec018893367fe1c99", "srcset": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1508326053382541316%2FP-jeuphY.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=dc9e7632041c1aeec018893367fe1c99, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1508326053382541316%2FP-jeuphY.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=eda9963fc36410b1efa5e8405f418f49 2x, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1508326053382541316%2FP-jeuphY.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=0e80395567e87ce0463912a9ccb214c1 3x"}, "body": "お家に遊びに来てダラダラしたり、ゲームする間柄の、距離が近い女の子がいる生活を感じさせてください！いろんなミニゲームが詰まったゲームを隣に座って一緒にしてくれるばぶかすちゃんが感じたいんです！\n\n\n「おーう。遊びに来てやったぞぉー。\nジュース冷えてる？充電ケーブルの準備も良いか？よし！ではこのプリンを食べる権利をやろう。冷蔵庫に入れとくからあとで食べようぜ。\n\nお、何やってんの？あーそれ買ったんだ。面白い？へぇー…対戦できんでしょそれ？じゃ、対戦しよっか！\nなんか色々あるんだよね。簡単でわかりやすいやつどれ？へ～、買ったばっかりなんだ。じゃあ、チュートリアルも一緒に見ようぜ。\nんー、どれにしよっかー？\n…あ、これにしよコレ！ＣＭで見たやつ。ルールとか多分簡単でしょ？ボタン押すだけっぽいし。\nほら、ちょとそっちよって！ばぶちゃんが座る場所開けて！\n\nこの説明さぁ、あんまりちゃんと説明してないよね。まあでもなんとなくわかるからいっかー。\nじゃあ早速。\n\nん？これどっち？青い車がばぶね。よっしゃー、ぶっちぎってやるぜー。\n\nさーん、にー、いーち、ゴー！\n\nよっしゃいい感じ！ほれほれー、追い抜いてみなよぉー。このままあ゛あ゛あああああー！！！！\nなんでだよぉー！それくらい耐えろよー！あ、ちょっと待て待て待て！\nおいおいおいおい、そういうことする？マジぃ？そういうとこだぞ！ばぶちゃんが困っているときに手を差し伸べるのが、優しさってもんだろぅー。\n\nちっくしょー絶対追い抜いてやる。コツはもう掴んだ！\n\nよっしコースアウトしたな！よしよしヨシヨシこのタイミングで追い抜けよっしゃ！いえーいおっそーい！\nほらほらここまでおいでー。もうばぶちゃんは完全にマスターしたもんねー。カーブもこうやって簡単にあぁぁーー！！なんでだよー！\n\nま、まだ大丈夫。追い抜かれてない。イケイケいけいけそのまま…よっしゃー！勝ちぃー！ばぶちゃんの、優勝でーす！\n\nはい、優勝したばぶちゃんには報酬として～…何くれる？なにしてくれます～？\n\n（ささやき声）\nばぶちゃんがしてほしいことは、なんでしょーかぁー。３秒以内に答えてくださーい。はい、さん、にー、いち…。ふふ。時間切れ。\n\n正解は…発表しませーん。まだ教えてあげませーん。\nじゃ、もう１回やろうぜ。別のゲームやろうぜ！」", "nc": 145, "word_count": 0, "transcoder": "audio", "creator_acceptable_same_genre": true}, {"path": "/@AI_VAV/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "voice", "tipped": false, "creator_id": 309426, "vtt_url": "https://fcdn.skeb.jp/uploads/99178/0/vtt/0.vtt?response-content-disposition=inline&Expires=1780411675&Signature=mBCEthiVklED85N51Td0n-4gioK9RClJgV9vISuQD0K-6t24Io1DwkB-WSj6eHp-eXftSPW-yXNHaRW7mHSGVDLfC1BnujMiJbUWhzOmdOJBn40BknfnSeg4SAWUbb9Vim979Gl