る　\n資料「表情」のような不敵な上目遣いでこちらを見ている\n\nリクエスト内容は以上となります。ご検討よろしくお願い致します。\n\nhttps://drive.google.com/drive/folders/1JsdreSnM1HHUoqq3xjbzj47fbAp8bskT?usp=sharing", "nc": 161, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@karamiyama/works/5", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/7b2d2e4e/uploads/origins/14ce0d67-f14b-4cd0-9766-ac63ef6eb3aa?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=6683903ee8c3090cba3d80ba955d5019", "src_set": ""}, "private": true, "genre": "art", "tipped": true, "creator_id": 3724747, "client_id": 3616533, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 32, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@karamiyama/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3724747, "client_id": 268693, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/3060fd88/uploads/origins/7a2a716f-a5e8-426c-bfa8-75a140dcc94d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f35735467897af7301be320062998cb0", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/3060fd88/uploads/origins/7a2a716f-a5e8-426c-bfa8-75a140dcc94d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=36d809b6b5ac3acb3f35005d8faf1a64", "src_set": ""}, "body": "こんにちは、\n\n私のオリジナルキャラクター（OC）のジセウルとリリーに関するリクエストをさせていただきます。  \n\nジセウルは「スニーキング・スーツ」を着用し、リリーは「スパイ・スーツ」を着用しています。武器は任意です。  \n\n彼らは互いに敵対する任務中のライバルですが、媚薬ガスに曝露され、捕まらないようにしながら互いに性行為に及ぶことになります。\n\n残りの詳細はご自由に決めてください。  \n\nありがとうございます！  \n\nジセウル  \nhttps://imgchest.com/p/vj4jevd978m  \n\nリリー  \nhttps://imgchest.com/p/m9yxqqz