ますが、難しい部分については考慮せず作業いたければと思います！\n\n🤍納品形式\n可能であればキャラと背景のレイヤーを分けたPSDデータでお願いいたします。\n\n🤍使用用途\nSNSなどでの個人利用になります。動画投稿もしているため、動画/配信などで使用させていただく予定でもあります。\n\nもし金額が足りないようでしたら、お手数ですが指定の後再送要請を送っていただければと思います。\nお忙しい中大変恐縮ですが、ご確認よろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/1ytoiu5-noCB2IEvy48EtQ__4eEHwQ4WB?usp=drive_link", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@dononosabuichi/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 4002711, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/fc15a6f4/uploads/origins/3f1d26fe-66ee-4936-b4e4-173b554df097?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=37b65ca2fc0783dfcdabc511a49f811a", "srcset": "https://si.imgix.net/fc15a6f4/uploads/origins/3f1d26fe-66ee-4936-b4e4-173b554df097?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=37b65ca2fc0783dfcdabc511a49f811a, https://si.imgix.net/fc15a6f4/uploads/origins/3f1d26fe-66ee-4936-b4e4-173b554df097?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=0a41ff91ffe5907940c9d52b1aaae17b 2x, https://si.imgix.net/fc15a6f4/uploads/origins/3f1d26fe-66ee-4936-b4e4-173b554df097?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d83dd9dad338bb1cea4fef6c18d271ab 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/fc15a6f4/uploads/origins/3f1d26fe-66ee-4936-b4e4-173b554df097?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b01fb924d8f67fe58fb9c5f1cfdaaaea", "srcset": "https://si.imgix.net/fc15a6f4/uploads/origins/3f1d26fe-66ee-4936-b4e4-173b554df097?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b01fb924d8f67fe58fb9c5f1cfdaaaea, https://si.imgix.net/fc15a6f4/uploads/origins/3f1d26fe-66ee-4936-b4e4-173b554df097?bg=%23fff&aut