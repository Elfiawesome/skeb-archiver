1mu7N3HAFxkIUbjO8MevyPU_RCpuT_aQt?usp=sharing", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@dononosabuichi/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 4002711, "client_id": 1205508, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/5e17758b/uploads/origins/30d83bdd-90ac-4884-8592-e71f859d3298?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5119b799c47c0bd275e34f1fcbabab15", "srcset": "https://si.imgix.net/5e17758b/uploads/origins/30d83bdd-90ac-4884-8592-e71f859d3298?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5119b799c47c0bd275e34f1fcbabab15, https://si.imgix.net/5e17758b/uploads/origins/30d83bdd-90ac-4884-8592-e71f859d3298?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=de49c1f98442a7226240b0c58c9d6286 2x, https://si.imgix.net/5e17758b/uploads/origins/30d83bdd-90ac-4884-8592-e71f859d3298?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f1f9e0c151c4ced8f78c7639f139a7a6 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/5e17758b/uploads/origins/30d83bdd-90ac-4884-8592-e71f859d3298?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=70cae5eecff1c003420467b9459ba429", "srcset": "https://si.imgix.net/5e17758b/uploads/origins/30d83bdd-90ac-4884-8592-e71f859d3298?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=70cae5eecff1c003420467b9459ba429, https://si.imgix.net/5e17758b/uploads/origins/30d83bdd-90ac-4884-8592-e71f859d3298?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=008661c998a1456946ac77dbd9abe706 2x, https://si.imgix.net/5e17758b/uploads/origins/30d83bdd-90ac-4884-8592-e71f859d3298?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=5848e52aac021c5b385c293c241574b6 3x"}, "body": "こんにちは、先生、はじめまして！ 個人的な鑑賞用に、私のオリジナルキャラクターを描いていただけないでしょうか。\n\n参考画像：https://sta.sh/21xsny1g2omk?edit=1\n彼女の髪は濃い青色で、白いハイライトが入っています。\n\n彼女は元気でかわいい女の子で、ファッションやメイクにとても力を入れていますが、少し浅はかで物質主義的です。自分はとてもかわいいと思っており、その点については謙虚ではありません。彼女はすぐに恋に落ちるタイプですが、真剣な交際そのものよりも、恋に落ちた時に感じる感情に夢中になってしまう傾向があります。 彼女の夢は、将来の白馬の王子様の花嫁になることです。\n\nミユは人気アイドルでもあります。注目を浴びたり、様々な形の愛情を受けたりするのが大好きで、ステージで歌ったり踊ったりしながら多くの人々の心を掴んでいます。少し甘やかされて育ったところがあり、わがままな面もありますが、全体的には魅力的で愛らしい性格です。 彼女のモットーは、「恋をしている時、女の子は一番かわいい！」です。\n\nお好みで、彼女の服のコーディネートを変えてみてください！\n\nお時間を割いてご検討いただき、ありがとうございます！", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@dononosabuichi/works/4", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/c23cf0b5/uploads/origins/6813f4c4-2dc1-488c-b6ef-ae392f4fb786?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=cf036502aab2444ed947e49e6312255d", "srcset": "https://si.imgix.net/c23cf0b5/uploads/origins/6813f4c4-2dc1-488c-b6ef-ae392f4fb786?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=cf036502aab2444ed947e49e6312255d, https://si.imgix.net/c23cf0b5/uploads/origins/6813f4c4-2dc1-488c-b6ef-ae392f4fb786?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=a57fb1e36ba2c1e5a924bf371401a35d 2x, https://si.imgix.net/c23cf0b5/uploads/origins/6813f4c4-2dc1-488c-b6ef-ae392f4fb786?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=4126c2cf754f709c67de83ac6354df32 3x"}, "private": true, "genre": "art", "tipped": true, "