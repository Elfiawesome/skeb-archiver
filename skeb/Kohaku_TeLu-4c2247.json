」の姿で、ちょっと微笑みながら友達に手をふってる姿はどうでしょうか？\nもしよろしければちょっと照れてる差分もほしいです。\nご検討お願いします。\n\nお忙しい中、要件のみで申し訳ありません。\nいつも応援しております！\n\nhttps://drive.google.com/drive/folders/1kVcp6B8dzGYFGpFb9spMTyDnz0TzyM7Q?usp=sharing", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@Kohaku_TeLu/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1949240, "client_id": 1485456, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/48ae4d51/uploads/origins/12e807db-79aa-4cb0-b4e5-dc85207c2cd8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d4c13704bb93dc12260c68a519c33f7e", "srcset": "https://si.imgix.net/48ae4d51/uploads/origins/12e807db-79aa-4cb0-b4e5-dc85207c2cd8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d4c13704bb93dc12260c68a519c33f7e, https://si.imgix.net/48ae4d51/uploads/origins/12e807db-79aa-4cb0-b4e5-dc85207c2cd8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=738d143e9718ccc8f4ba7186ba45c581 2x, https://si.imgix.net/48ae4d51/uploads/origins/12e807db-79aa-4cb0-b4e5-dc85207c2cd8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=fba29fa12349b5e8d98da7f6827ed960 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/48ae4d51/uploads/origins/12e807db-79aa-4cb0-b4e5-dc85207c2cd8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b7323c476c2603c6237f93d4b68b81df", "srcset": "https://si.imgix.net/48ae4d51/uploads/origins/12e807db-79aa-4cb0-b4e5-dc85207c2cd8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b7323c476c2603c6237f93d4b68b81df, https://si.imgix.net/48ae4d51/uploads/origins/12e807db-79aa-4cb0-b4e5-dc85207c2cd8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=20a0090ec76db7689b718