)\u3068\u7533\u3057\u307e\u3059\u3002  \n\u67d4\u3089\u304b\u3067\u53ef\u611b\u3089\u3057\u3044\u7d75\u67c4\u306b\u60f9\u304b\u308c\u3001\u30ea\u30af\u30a8\u30b9\u30c8\u5931\u793c\u81f4\u3057\u307e\u3057\u305f\u2728\ufe0f\n\n\u79c1\u306e\u30b3\u30c6\u30ad\u30e3\u30e9(OC)\u306e\u30a4\u30e9\u30b9\u30c8\u3092\u304a\u9858\u3044\u3044\u305f\u3057\u307e\u3059\u3002\n\n\u3010\u30ad\u30e3\u30e9\u30af\u30bf\u30fc\u8a73\u7d30\u3011 \n\u30fb\u6dfb\u4ed8\u30ea\u30f3\u30af\u53c2\u7167\u9802\u3051\u307e\u3059\u3068\u5e78\u3044\u3067\u3059\u3002 \n\n\u3010\u670d\u88c5\u30fb\u9aea\u578b\u3011\n\u30fb\u30b9\u30c6\u30fc\u30b8\u8863\u88c5\u306e\u65b9\u3067\u304a\u9858\u3044\u3044\u305f\u3057\u307e\u3059\u3002\n\n\u3010\u69cb\u56f3\u3011\n\u30fb\u53ef\u80fd\u3067\u3042\u308c\u3070\u4e0a\u3001\u5de6\u53f3\u898b\u5207\u308c\u306a\u3044\u3088\u3046\u53ce\u3081\u3066\u9802\u3051\u308b\u3068\u6709\u96e3\u3044\u3067\u3059\u3002\n\u30fb\u4e0a\u8a18\u4ee5\u5916\u306f\u304a\u4efb\u305b\u3067\u304a\u9858\u3044\u3057\u305f\u3044\u3067\u3059\uff01\n\n \u3010\u4f7f\u7528\u7528\u9014\u3011 \n\u30fb\u81ea\u8eab\u306e\u30c1\u30e3\u30f3\u30cd\u30eb\u3067\u306e\u4f7f\u7528\n(\u30b5\u30e0\u30cd\u30a4\u30eb\u3001\u30b7\u30e7\u30fc\u30c8\u52d5\u753b\u7b49)\n\u30fbX\u3067\u306e\u6295\u7a3f  \n\u30fb\u500b\u4eba\u306e\u7bc4\u56f2\u3067\u306e\u30b0\u30c3\u30ba\u3001\u30cd\u30c3\u30c8\u30d7\u30ea\u30f3\u30c8\u3067\u306e\u4f7f\u7528  \n\n\u3044\u305a\u308c\u3082\u975e\u55b6\u5229\u3067\u3059\u3002\n\n\u3010\u305d\u306e\u4ed6\u3011\n\u53ef\u80fd\u3067\u3042\u308c\u3070\u3001\u4eba\u7269\u3068\u80cc\u666f\u3001\u30b5\u30a4\u30f3\u306e\u30ec\u30a4\u30e4\u30fc\u3092\u5206\u3051\u305f\u30d5\u30a1\u30a4\u30eb(PSD\u7b49)\u3067\u9802\u3051\u308b\u3068\u3042\u308a\u304c\u305f\u3044\u3067\u3059\ud83d\ude4f  \n\u3082\u3057\u4e0d\u53ef\u306e\u3082\u306e\u3084\u4e0d\u5099\u7b49\u3054\u3056\u3044\u307e\u3057\u305f\u3089\u3001\u304a\u624b\u6570\u3067\u3059\u304c\u518d\u9001\u9802\u3051\u307e\u3059\u3068\u5e78\u3044\u3067\u305