。常世と現の間にある遊園地の中を徘徊し、様々なアトラクションを楽しんではどこかへ消えていく神出鬼没な存在。\n備考：夢邸童心（ユメヤシキドウシン）が父親であり、件の遊園地を管理している園長。\n\n\nご多忙な中恐れ入りますが、よろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/1gVfab8_IheqALc185eVio1R5PDnjbdXN?usp=drive_link", "nc": 152, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@humiichi_kun/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1398008, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/978c77ba/uploads/origins/f3a3aeab-4aee-4824-b0b0-71e9b63bc14c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3dc19b34afa9dcda935608b3303f15b4", "srcset": "https://si.imgix.net/978c77ba/uploads/origins/f3a3aeab-4aee-4824-b0b0-71e9b63bc14c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3dc19b34afa9dcda935608b3303f15b4, https://si.imgix.net/978c77ba/uploads/origins/f3a3aeab-4aee-4824-b0b0-71e9b63bc14c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=1d003677f9164a351c8e36fdda6888d6 2x, https://si.imgix.net/978c77ba/uploads/origins/f3a3aeab-4aee-4824-b0b0-71e9b63bc14c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=7a390c81a5e1b4b4aa9d2f67c529da3d 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/978c77ba/uploads/origins/f3a3aeab-4aee-4824-b0b0-71e9b63bc14c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=21d328839f46e359c19c08325ee5f457", "srcset": "https://si.imgix.net/978c77ba/uploads/origins/f3a3aeab-4aee-4824-b0b0-71e9b63bc14c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=21d328839f46e359c19c08325ee5f457, https://si.imgix.net/978c77ba/uploads/origins/f3a3aeab-4aee-4824-b0b0-71e9b63bc14c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=3a980d194bb640dd1825c6819