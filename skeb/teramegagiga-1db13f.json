s&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=48d16f5d34142eb4dbba10723c89c41f 3x"}, "private": true, "genre": "comic", "tipped": true, "creator_id": 3649247, "nc": 176}, {"path": "/@teramegagiga/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "comic", "tipped": false, "creator_id": 3649247, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/cad2c063/uploads/origins/daf31bff-7536-405d-85a9-f3834493a1ce?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4c156f5413e0609868e34488604170f3", "srcset": "https://si.imgix.net/cad2c063/uploads/origins/daf31bff-7536-405d-85a9-f3834493a1ce?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4c156f5413e0609868e34488604170f3, https://si.imgix.net/cad2c063/uploads/origins/daf31bff-7536-405d-85a9-f3834493a1ce?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=8ae8f78d530a5a5a8a8ac8f5c50ffaa8 2x, https://si.imgix.net/cad2c063/uploads/origins/daf31bff-7536-405d-85a9-f3834493a1ce?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=be308bd715a79e07bee87fe2c1f250ad 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/cad2c063/uploads/origins/daf31bff-7536-405d-85a9-f3834493a1ce?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ca756f465538c801a87d7bad1a99f7b1", "srcset": "https://si.imgix.net/cad2c063/uploads/origins/daf31bff-7536-405d-85a9-f3834493a1ce?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ca756f465538c801a87d7bad1a99f7b1, https://si.imgix.net/cad2c063/uploads/origins/daf31bff-7536-405d-85a9-f3834493a1ce?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=4cb74f893b5f159924fc17f845445089 2x, https://si.imgix.net/cad2c063/uploads/origins/daf31bff-7536-405d-85a9-f3834493a1ce?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=5353b1ed8039c6be58ed2d76db595532 3x"}, "body": "内容\n リミ×ヴェール の百合セックス\n\n細かい内容\n 本編とはパラレルの「ヴェールに彼氏ができなかった世界線」\n大筋があっていたら細かい描写や台詞等は作者様の裁量で変更しても構いません。\n\nいつまでもトレーニングばかりで彼氏ができないヴェールを見かねたリミが「女の悦び」を教える。\n\nリミ「それじゃまずは…キスから♡」\n\nヴェールに顔を近づけて唇を奪うリミ\n\nヴェール「んんっ！？」\n\nヴェールが驚いて飛び退いたあと口元をぬぐう\n\nヴェール「い、いきなりなにしやがんだ！？」\nリミ「キスは初めて？」\nヴェール「ほっとけ…」\nリミ「フルルちゃんのファーストキス貰っちゃった♡」\n\nその後リミが片手でヴェールの胸を揉みしだき、もう片方の手をスカートの中に滑り込ませる。\n\nリミ「フルルちゃん、十分おっぱい大きいと思うけどねぇ」\nヴェール「そんなデカ乳の持ち主に言われてもな…」\nリミ「相変わらずパンツ可愛いね」\nヴェール「うっせ…あっ、ちょっ、どこ触って…んんっ！」\n\nリミの愛撫に思わず声が漏れるヴェール\n再び唇を重ね開いた口にすかさず舌を入れるリミ\nディープキスをしながらヴェールの胸と女性器を責め続けるリミ\n\nヴェール「うっ…んぐっ…それ以上は…アタシ…」\nリミ「いいよ、一回イっちゃおうか」\n\nその後絶頂を迎えるヴェール\n\nリミ「いい感じにほぐれてきたから…このまま本番行っちゃおうか」\n\n二人とも服を脱ぎ、リミはヴェールのアソコを広げ中を確認する\n\nリミ「あっスゴーイ！ちゃんと処女膜が残ってる！激しい運動とか足広げたりしたらエッチしなくても膜無くなるって聞いたけど…良かったねフルルちゃん♡」\n\nリミはペニバンを取り出し装着する。　\n\nヴェール「なっ…そんなもんどこで手に入れたんだよ！？」\nリミ「それじゃ行くよ」\n\nペニバンを装着したリミに正常位で挿入されて処女膜を破られ出血するヴェール。\n破瓜の血が太ももにつたいながらも「痛くない」と言い張るヴェール\n\nその後ヴェールが絶頂を迎える\nリミ「どう？」\nヴェール「ヤバかった…頭の中真っ白になった…」\nリミ「でしょ？これだけ気持ちいいんだから早く彼氏つくったら？そしたらエッチしほーだいだよ♡」\nヴェール「ああ…そうだな…」\n\nペニバンはリンク先のようなデザインで\n\nよろしくお願いいたします。\n\nhttps://www.nobunaga-toys.com/?pid=180408308", "nc": 185, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@teramegagiga/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "comic", "tipped": true, "creator_id": 3649247, "client_id": 134098, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/b1c9739f/uploads/origins/a90f9549-bffb-401f-bf40-831a02132448?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=42593fc4f521d634f715a66c9817f25b", "srcset": "https://si.imgix.net/b1c9739f/uploads/origins/a90f9549-bffb-401f-bf40-831a02132448?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=42593fc4f521d634f715a66c9817f25b, https://si.imgix.net/b