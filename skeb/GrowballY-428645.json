らを後ろから抱きしめ、腕で覆っている。\n\nさくらはいつもの無表情。  髪は下ろされ、一部は肩の上で前方に落ちている。  マゼンタの花のヘアバンド以外は裸だ。  敏感な部分は咲耶の手で覆われている。\n\nサクヤはドヤ顔かいたずらっぽい表情をしている。  いつもの髪型。青い花のヘアバンド以外は裸。さくらの後ろにいるため、体はほとんど見えない。\n\nhttps://imgur.com/a/QjH0wUn", "nc": 50, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@GrowballY/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1293460, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/62f65566/uploads/origins/7dd4fc72-0c7a-4a81-be14-4ff1fe83afef?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5183585468f1bea8a7d3ece5aac6247b", "srcset": "https://si.imgix.net/62f65566/uploads/origins/7dd4fc72-0c7a-4a81-be14-4ff1fe83afef?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5183585468f1bea8a7d3ece5aac6247b, https://si.imgix.net/62f65566/uploads/origins/7dd4fc72-0c7a-4a81-be14-4ff1fe83afef?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=8345cc486302f94a2d72df2dc8abc818 2x, https://si.imgix.net/62f65566/uploads/origins/7dd4fc72-0c7a-4a81-be14-4ff1fe83afef?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=95506a21ae1fc8038f61870dbdf12ff1 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/62f65566/uploads/origins/7dd4fc72-0c7a-4a81-be14-4ff1fe83afef?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=69e82439b56545a017c21c6b752cd337", "srcset": "https://si.imgix.net/62f65566/uploads/origins/7dd4fc72-0c7a-4a81-be14-4ff1fe83afef?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=69e82439b56545a017c21c6b752cd337, https://si.imgix.net/62f65566/uploads/origins/7dd4fc72-0c7a-4a81-be14-4ff1fe83afef?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=5237a96bae754e35477470632e0bd1e8 2x, https: