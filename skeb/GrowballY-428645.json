ecb4741/uploads/origins/07203eec-aaba-48ea-8d22-67c952841591?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a930e0206abf04027c647e69192ac1ec 2x, https://si.imgix.net/cecb4741/uploads/origins/07203eec-aaba-48ea-8d22-67c952841591?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ddf7a666afaea806ae4e2c7ed0bae8a3 3x"}, "duration": null, "nsfw": true, "hardcore": true, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/cecb4741/uploads/origins/07203eec-aaba-48ea-8d22-67c952841591?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=000a098271c8105bab6a56b1bb243a85", "srcset": "https://si.imgix.net/cecb4741/uploads/origins/07203eec-aaba-48ea-8d22-67c952841591?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=000a098271c8105bab6a56b1bb243a85, https://si.imgix.net/cecb4741/uploads/origins/07203eec-aaba-48ea-8d22-67c952841591?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=1981d657ecc12b72b76225578725e8c5 2x, https://si.imgix.net/cecb4741/uploads/origins/07203eec-aaba-48ea-8d22-67c952841591?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=19a950fbe06140fb2d77aba3bde420c4 3x"}, "body": "いつもスクフェス組を筆頭に素敵な虹ちゃんのイラストをありがとうございます。めちゃくちゃ癒されてます\n\nせっかくの機会＆自分はかなエマが虹ちゃんCPで2番目に好きなオタクなのでリクエスト送らせていただきます。\n\n今回先生に送りたいのは、彼方ちゃんにおへそぺろぺろされてしまうエマちゃんです。\n\n以下要望を箇条書きまとめます\n  表情\n・エマちゃんは泣き目or赤面or困り眉といった恥ずかしく感じているような感じ\n・彼方ちゃんはSぽい感じか優しく語りかける感じ\n\n 服装\n・エマちゃんはおへそが見える服装ならばなんでも可。彼方ちゃんも服装指定はなく描きやすいもので大丈夫です\n(迷ったら、くじ引き堂水着でお願いします)\nただし、乳首・女性器・_陰毛が見えるものは❌です\n\n構図\n・エマちゃんのおへその形は縦でも横でも大丈夫\n・エマちゃんのおへそに彼方ちゃんで舌がはっきり入っていることが1枚絵でわかる構図\n(例)：https://www.pixiv.net/artworks/132966422\nの1枚目が❌、2枚目が️⭕️です。\nまたへそ舐め吹き出し窓(アップを)使わずに1枚絵\n\n\n 背景\n・あってもなくても大丈夫です。\n\n台詞(入れるなら)\n・エマちゃんはおへそ舐められていることを(遠回し含む)嫌と伝える表現をするが、彼方ちゃんに自身が好きということor感じてることを見透かされてキュンとしてしまう\n\n(例1)\n「彼方ちゃん、おへそなんて汚いよぉ」\n\n「でも、エマちゃんはおへそ探検隊辞めなかったよね？」\n\n「それに大好きなエマちゃんに汚いところなんてないんだよ」\n\n「か、か…彼方ちゃん♡」\n\n(例2)\n「彼方ちゃん、もう辞めて私変になっちゃ…」\n\n「でも、エマちゃん気持ちいいよね？」\n\n「おへそヌルヌルコリコリしちゃうから堕ちちゃえ～」\n\n「もう、彼方ちゃん…」\n\nみたいな感じでお願いします。\n\n要望としては以上で、そこさえ厳守してもらえれば擬音表現といった他の項目は先生の好きにして貰って大丈夫です\n\n\n自分の癖全開のニッチなシチュエーション＋R18項目なのかよく分からないお題ですが、先生の描くえっちなかなエマを見たいんで何卒よろしくお願いします", "nc": 59, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@GrowballY/works/8", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1293460, "client_id": 3699210, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/ab14e7e5/uploads/origins/3d635cd7-8c94-4958-a9a4-d715d321cdcb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6c31cfe6e830c11894dbe97a9f8ccd84", "srcset": "https://si.imgix.net/ab14e7e5/uploads/origins/3d635cd7-8c94-4958-a9a4-d715d321cdcb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6c31cfe6e830c11894dbe97a9f8ccd84, https://si.imgix.net/ab14e7e5/uploads/origins/3d635cd7-8c94-4958-a9a4-d715d321cdcb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=6f850fa958cdd5f8319818aae12fdcb2 2x, https://si.imgix.net/ab14e7e5/uploads/origins/3d635cd7-8c94-4958-a9a4-d715d321cdcb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=6cbf8842befdab4836056ba449081297 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/ab14e7e5/uploads/origins/3d635cd7-8c94-4958-a9a4-d715d321cdcb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a3824117c63e7db4b2eb76ffc9c844db", "srcset": "https://si.imgix.net/ab14e7e5/uploads/origins/3d635cd7-8c94-4958-a9a4-d715d321cdcb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a3824117c63e7db4b2eb76ffc9c844db, https://si.imgix.net/ab14e7e5/uploads/origins/3d635cd7-8c94-4958-a9a4-d715d321cdcb?bg=%23fff&auto=format%2