ただけないでしょうか。\n彼女は水竜の冒険家で、探検や歴史・遺物の発見、そして宝探しが大好きです。元気で自信に満ち、遊び心のあるキャラクターにしてください。\n\n表情やポーズは先生にお任せします。髪型は、ポーズに合わせてショートでもロングでも構いません！ \n\n重要なデザイン上の注意点：口の中と舌の色はピンクではなくシアンです\n\nhttps://drive.google.com/drive/folders/1Po9C498sfakMX5Z9lgNm-yAaS3pRmQqQ?usp=sharing", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@harusamsrd/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3961861, "client_id": 1704089, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/9409bc3a/uploads/origins/7da33291-d2cf-4fa9-9011-a0c9d4871730?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d8dc5e1357b58e511465bc5d34f2750e", "srcset": "https://si.imgix.net/9409bc3a/uploads/origins/7da33291-d2cf-4fa9-9011-a0c9d4871730?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d8dc5e1357b58e511465bc5d34f2750e, https://si.imgix.net/9409bc3a/uploads/origins/7da33291-d2cf-4fa9-9011-a0c9d4871730?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=dcd0cc77e91ea2ba8e31c94f433383ab 2x, https://si.imgix.net/9409bc3a/uploads/origins/7da33291-d2cf-4fa9-9011-a0c9d4871730?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d75bd32daf51eb3272081569eb67f5f5 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/9409bc3a/uploads/origins/7da33291-d2cf-4fa9-9011-a0c9d4871730?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=82f1707c607aa75f20599bbd07f62e6b", "srcset": "https://si.imgix.net/9409bc3a/uploads/origins/7da33291-d2cf-4fa9-9011-a0c9d4871730?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=82f1707c607aa75f20599bbd07f62e6b, https://si.imgix.net/9409bc3a/uploads/origins/7da33291-d2cf-4fa9-9011-a0c9d4871730?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&c