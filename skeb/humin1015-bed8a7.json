5b92b1-77ab-4a5a-9e96-ba70e5bfd8dc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=be8c218a6ac24b08090300dcdb1cb134, https://si.imgix.net/7e521773/uploads/origins/9c5b92b1-77ab-4a5a-9e96-ba70e5bfd8dc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=9d5ec34e0534ad7266c25ce0d15ff987 2x, https://si.imgix.net/7e521773/uploads/origins/9c5b92b1-77ab-4a5a-9e96-ba70e5bfd8dc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=08676cb71363cca69c07f64d1b154f6f 3x"}, "body": "はじめまして！\nSNSにてかわいいデフォルメイラストをお見掛けいたしまして、\nとてもとても素敵だなと思いましたので、\nよろしければ、私と友人のTRPGの探索者（OC）の二人を描いていただければ幸いです…！\n\n＝＝＝\n\n▼リクエスト\n資料を見て思いついたものや、描きやすいテイストで問題ありません！\n可能でしたら、服装や髪のアレンジがあると嬉しいですが\nデフォルトの服装でも問題ございません！\n\n▼関係性\n異能警察の同僚。日々異能力で怪物や怪異と戦い、市民を守っている。\n現在恋人同士であり、お互いを大事に思い慈しみあっている。\n男性の方が恋愛慣れしており、女性側が照れたり焦ったりすることが多いです。\n\n▼キャラ\n▎雷電一二三（メッシュの男性）\n男/25歳/200cm/イメージカラー：紫/モチーフ:雷\n\nナルシストで自信家、超ポジティブ人間。賢く優秀。\n態度がチャラチャラしているが、いざという時は頼りになる兄貴的存在。\nエミリに対して好意を抱いており、毎日のように口説いている。告白は一二三から。\n彼女に対しては甘えたり弱みを見せることもある。\n\n▎朽木エミリ（カチューシャの女性）\n女/25歳/164cm/イメージカラー：緑/モチーフ:花(カンパニュラ)\n\nクールな印象で物静か。真面目で努力家。目立つのが苦手。\n周りに一線引いており距離をとっているが、仲間思いで優しい女性。\nとても照れ屋で一二三に口説かれるたび戸惑いつつ赤面して口ごもってしまう。\n信頼していると同時に尊敬もしており、心を許している。\n\n▼想定される使用用途\n友人への共有・SNSアイコンとしての使用（友人含む）\n個人での鑑賞目的の印刷・グッズ作成\n\n＝＝＝＝＝\n何卒よろしくお願いいたします。\n\nhttps://drive.google.com/drive/u/1/folders/1YGeDDz0d7bXZHUpMOlorjPk2I2V8Yom6", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@humin1015/works/12", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/4b427ba6/uploads/origins/3005159b-4c67-4e79-9f3e-0c6a86151b21?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=6864e0ac1f511917b493826cb249a85e", "srcset": "https://si.imgix.net/4b427ba6/uploads/origins/3005159b-4c67-4e79-9f3e-0c6a86151b21?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=6864e0ac1f511917b493826cb249a85e, https://si.imgix.net/4b427ba6/uploads/origins/3005159b-4c67-4e79-9f3e-0c6a86151b21?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=bb7e12c8dd7955f057f5f360d81ec810 2x, https://si.imgix.net/4b427ba6/uploads/origins/3005159b-4c67-4e79-9f3e-0c6a86151b21?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=f733f366cc29a64c285d3cc74213c369 3x"}, "private": true, "genre": "art", "tipped": false, "creator_id": 4015582, "client_id": 3053093, "nc": 129}, {"path": "/@humin1015/works/11", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 4015582, "client_id": 3402487, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/3c8236bb/uploads/origins/f4c98efb-8be3-4a25-b508-32d06fe20be5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e6eaaacb3a3245acf0eede3db3fac28d", "srcset": "https://si.imgix.net/3c8236bb/uploads/origins/f4c98efb-8be3-4a25-b508-32d06fe20be5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e6eaaacb3a3245acf0eede3db3fac28d, https://si.imgix.net/3c8236bb/uploads/origins/f4c98efb-8be3-4a25-b508-32d06fe20be5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=bce0bf8d4ec58120a1742fe47854ef96 2x, https://si.imgix.net/3c8236bb/uploads/origins/f4c98efb-8be3-4a25-b508-32d06fe20be5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=1b0cd744286df467ebd81d00526b9540 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/3c8236bb/uploads/origins/f4c98efb-8be3-4a25-b508-32d06fe20be5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2b31a1e665d2cd2ad64324890eebd5d2", "srcset": "https://si.imgix.net/3c8236bb/uploads/origins/f4c98efb-8be3-4a25-b508-32d06fe20be5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2b31a1e665d2cd2ad64324890eebd5d2, https://si.imgix.net/3c8236bb/uploads/origins/f4c98efb-8be3-4a25-b508-32d06fe20be5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=1788be1a2dd879bf4c931ba47f607637 2x, https://si.imgix.net/3c8236bb/uploads/origins/f4c98efb-8be3-4a25-b508-32d06fe20be5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=5b737014f1dc2a2e916bc03bc769b339 3x"}, "body": "こんにちは！SDイラストのskeb開設ありがとうございます。描かれるイラストが大好きで、いつも拝見しております。\n今回は2人組のOCを描いていただきたく、リクエストさせていただきました。\n\n▶︎資料　https://drive.google.com/drive/folders/1F5lBhxQ0ozdKqD9yenHxXJKk0Eu2N5tc?usp=drive_link\n\nこちらの資料にある、ミナトと乾風太を描いていただきたいと思っております。\n▶︎ミナト\n金髪／碧眼／26歳／178cm\n王子様のようなルックスの超人気アイドル。元々ソロだった。容姿通り優しく穏やかで、ファンへの神対応も有名だが、マネージャー溺愛を公表している天然ドジ。ぽやぽやしている。\n▶︎乾風太\n黒髪／ピンク目／23歳／180cm\nワイルド系&兄貴系のアイドル。突如ミナトの相方としてデビューした。強気な顔と裏腹に、世話焼きでツッコミ担当の常識人。隠れアイドルオタク。\n▶︎関係性\n老若男女に愛される王子様天才型アイドル×ワイルドと真面目のギャップ萌え新人努力型アイドルのユニット。CPなし。\n\n資料より、ミナトは白スーツ、乾風太は黒スーツの衣装で描いていただきたいと思っております。下半身はジャケットと同じ色のスーツズボンと黒い革靴です。構図はお任せします。\n\n▶︎使用用途\n個人鑑賞、SNSに掲載、アイコン使用、個人鑑賞用のグッズ制作\n\n可能であれば、キャラクターと背景と文字を分けた状態のpsdファイルにしていただきたいです。\n依頼に不慣れであるため、不備や金額不足等ありましたら再送いただけますと幸いです。\n\nhttps://drive.google.com/drive/folders/1F5lBhxQ0ozdKqD9yenHxXJKk0Eu2N5tc?usp=drive_link", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@humin1015/works/10", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/f7a75c76/uploads/origins/cb7cd3a0-ab04-43ab-ab6d-6bbbc6555ee3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=midd