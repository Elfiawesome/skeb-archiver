。私のオリジナルキャラクターを描いていただけないでしょうか？\n\nキャラクターは、人生の異なる段階にある同一人物です。雰囲気は、心理的な独白のような感じです。若い頃の自分が作り出した精神病院の独房で、若い頃の自分が年老いた自分を見守っているような設定です。\n\nテーマとしては、自己抑制、予言、『コヘレトの言葉』、舌の切除、知識と行動などです。\n\nもしPSDレイヤーに下書きや練習用データが含まれていれば、大変ありがたいです。\n\nリクエストをお読みいただきありがとうございます。良い一日をお過ごしください。\n\nhttps://drive.google.com/drive/folders/12Gh69J3KvWB88DeLuf2EkP5iMtf5ZWIX", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@menmenmennma/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3953557, "client_id": 350566, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/8b13433f/uploads/origins/cbd435e5-b883-4994-b4ad-aa94f619ef3b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e2316ac73eb8bfdd55ea353fc19c2354", "srcset": "https://si.imgix.net/8b13433f/uploads/origins/cbd435e5-b883-4994-b4ad-aa94f619ef3b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e2316ac73eb8bfdd55ea353fc19c2354, https://si.imgix.net/8b13433f/uploads/origins/cbd435e5-b883-4994-b4ad-aa94f619ef3b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=368e2e47d322f990ffe80c5b3a89ee8b 2x, https://si.imgix.net/8b13433f/uploads/origins/cbd435e5-b883-4994-b4ad-aa94f619ef3b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=af4076c4bd9a81e05926cf213db22c4e 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/8b13433f/uploads/origins/cbd435e5-b883-4994-b4ad-aa94f619ef3b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a03640b28957dbd2d04903376ba690c0", "srcset": "https://si.imgix.net/8b13433f/uploads/origins/cbd435e5-b883-4994-b4ad-aa94f619ef3b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a03640b28957dbd2d04903376ba690c0, https://si.imgix.net/8b13433f/uploads/origins/cbd435e5-b883