45a8-ab23-38bdf4704743?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=fac86cd6a6b16cf47c778ffd555a6e40, https://si.imgix.net/98031ca6/uploads/origins/b9e3fc69-c9ea-45a8-ab23-38bdf4704743?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=f9ccadba8b2e4d081df43669b2681157 2x, https://si.imgix.net/98031ca6/uploads/origins/b9e3fc69-c9ea-45a8-ab23-38bdf4704743?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=859dd23416b916ba7c5362a7821ff72d 3x"}, "body": "今回もおさげちゃんを依頼させていただきます。\nもしよければお願いします。\n\n●キャラクター\n・スポットレイトおさげちゃん\n・服や靴は全てあり 下着なし\n\n●内容\n・寝バックで中出し\n・挿入され、恥ずかしそうに赤面→ピストンが始まり感じる→中出しで絶頂。大きく口を開けて喘ぐ…の流れでお願いします。\n\n・おさげちゃんはうつ伏せで横になっている。腰はあまり上げないようにお願いします\n・男性は後ろからおさげちゃんに覆いかぶさっている\n・こういった構図のイメージでお願いします。（https://www.pixiv.net/artworks/125996792）\n・おさげちゃんの赤くなった耳が見えるようにお願いします。", "nc": 177, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@honeycombtyan/works/12", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3228945, "client_id": 26739, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/7f033b9a/uploads/origins/0c076d86-904a-4dca-b2ce-7c469d3a3fd4?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&s=61c6e1a59fc36876f61e2e8f2fecc510", "srcset": "https://si.imgix.net/7f033b9a/uploads/origins/0c076d86-904a-4dca-b2ce-7c469d3a3fd4?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&s=61c6e1a59fc36876f61e2e8f2fecc510, https://si.imgix.net/7f033b9a/uploads/origins/0c076d86-904a-4dca-b2ce-7c469d3a3fd4?bg=%23fff&fm=webp&auto=compress&dpr=2&fit=crop&crop=top&w=200&h=200&s=05c4a20fe14fd37bce6a2b2b8a575fbc 2x, https://si.imgix.net/7f033b9a/uploads/origins/0c076d86-904a-4dca-b2ce-7c469d3a3fd4?bg=%23fff&fm=webp&auto=compress&dpr=3&fit=crop&crop=top&w=200&h=200&s=1034b08c0ab8ec74c9e1904bdd51f029 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/7f033b9a/uploads/origins/0c076d86-904a-4dca-b2ce-7c469d3a3fd4?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&blur=200&s=794444dbb6400c9cdff271c6e636cb7e", "srcset": "https://si.imgix.net/7f033b9a/uploads/origins/0c076d86-904a-4dca-b2ce-7c469d3a3fd4?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&blur=200&s=794444dbb6400c9cdff271c6e636cb7e, https://si.imgix.net/7f033b9a/uploads/origins/0c076d86-904a-4dca-b2ce-7c469d3a3fd4?bg=%23fff&fm=webp&auto=compress&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=260fae49fc60ca8259a8830a3e01e2f6 2x, https://si.imgix.net/7f033b9a/uploads/origins/0c076d86-904a-4dca-b2ce-7c469d3a3fd4?bg=%23fff&fm=webp&auto=compress&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=28e5653279e0ea0e2a35f36158f8a9bc 3x"}, "body": "はにかむのびのび様！お久しぶりでございます！またお代わりができてうれしいです！\n前回の輪姦絵がとても可愛くて素晴らしく、さらに前のおさげちゃんのエッチアニメーションがとってもめちゃシコなので！！\n次は私からも「アニメーション」の絵をでお願いしたいと思います！よろしくお願い致します！\n\n次回も「おさげちゃん」と「エメリア・プリスちゃん」でございます！\n・二人は恋人のような手繋ぎ(片手or両手)ながら、電車内で輪姦・乱交・肉便器風のエッチやられている感じの雰囲気をお願いします！（なお二人はキスしたあとにエッチってわかるように唾液ブリッジみたいなのもお願いします）\n・おさげちゃん＆エメリア：ニーソ以外の裸です\n・二人は全身に描かれて、可愛いエッチなマ〇コ、足の裏、ちっぱいと乳首はこちらに見える状態でお願い致します！\n・（もし可能でＯＫでしたら！）本番エッチだけじゃなく、片足コキもペ〇スをゴシゴシもお願い致します！\n※アニメーション的に難しいなら、無理しなくても大丈夫です！！\n・二人はパコパコして、その次は中出しして、ペ〇ス抜いて、射精垂れているところも見たいです！！\n・背景はシンプルな電車内で大丈夫です！（痴漢やられ的な？）\n・カラーで描いてくださるととっても嬉しいでございます！！\n\n・「おさげちゃん」ぬくぬくにぎりめしから\nhttps://www.pixiv.net/artworks/117656795\n・「エメリア・プリス」ポップアップストーリーから\nhttps://imgur.com/a/NkmpOf4\n\nポーズについてわからなかった場合、このリンクの大体似たような感じで大丈夫です！\n※なお、竿役・男は浮いているペ〇スだけで大丈夫です！\nhttps://x.com/Azalanz/status/1958846958941958568\n\n一応NG：体に落書き、おしっこぶっかけ（ザーメンぶっかけはOK）でございます\n\nアニメーションで描くの大変かもしれませんが、はにかむのびのび様の可愛い＆エロの絵をまた二人の好きなキャラが見られるの凄く楽しみにしていますので、よろしくお願い致します！\n\nどうぞよろしくお願い致します！！！", "nc": 185, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@honeycombtyan/works/11", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3228945, "client_id": 812555, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/7341bfba/uploads/origins/00261cb8-815a-478d-9349-035a663cee05?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&s=4839c17ce9a7a103ba89482a538f7ffc", "srcset": "https://si.imgix.net/7341bfba/uploads/origins/00261cb8-815a-478d-9349-035a663cee05?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&s=4839c17ce9a7a103ba89482a538f7ffc, https://si.imgix.net/7341bfba/uploads/origins/00261cb8-815a-478d-9349-035a663cee05?bg=%23fff&fm=webp&auto=compress&dpr=2&fit=crop&crop=top&w=200&h=200&s=425e8e264a87a006d73b3de147d43acc 2x, https://si.imgix.net/7341bfba/uploads/origins/00261cb8-815a-478d-9349-035a663cee05?bg=%23fff&fm=webp&auto=compress&dpr=3&fit=crop&crop=top&w=200&h=200&s=29029d94a3fb6c15a116ffaf9806f523 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/7341bfba/uploads/origins/00261cb8-815a-478d-9349-035a663cee05?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&blur=200&s=4773117c7d29612f59be60d78f57dc25", "srcset": "https://si.imgix.net/7341bfba/uploads/origins/00261cb8-815a-478d-9349-035a663cee05?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&blur=200&s=4773117c7d29612f59be60d78f57dc25, https://si.imgix.net/7341bfba/uploads/origins/00261cb8-815a-478d-9349-035a663cee05?bg=%23fff&fm=webp&auto=compress&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=5615ddf0d90292a734958ed3a56c8fae 2x, https://si.imgix.net/7341bfba/uploads/origins/00261cb8-815a-478d-9349-035a663cee05?bg=%23fff&fm=webp&auto=compress&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=e7900aa6bc0020425b0519c64f574161 3x"}, "body": "初めまして！　https://www.pixiv.net/artworks/112137028\nこちらの作品に惹かれてリクエストさせて頂きました。\n悶々ふぁんもおらんの麺ちゃんが輪姦されているイラストをお願いします。\n\nキャラクター\n悶々ふぁんもおらん　麺ちゃん\n\n服装\n可能であれば着衣えっちで上は着たまま下を脱がしてみたいな感じでお願いします\nMVで見えない部分はお好きに描いて下さい難しければ裸でも大丈夫です！\n\nシチュエーション\n複数の男にハメられている輪姦シチュ\n\n体位や構図\nバック＋フェラの串刺しファック\n構図はお任せします\n複数の男の相手をさせられて不満げな雰囲気でお願いします\n\nまた事後に至るまでの過程差分をお願いします。\n怒りマークの表情好きなのでどこかお好きなタイミングで入れて頂きたいです\n可能であれば射精シーンを2カット描いて頂けると嬉しいです\n勢いよく射精してるシーンに続いてそのまま弱々しく射精していて\n最後の一滴まで注ぎ込まれてる感じの麺ちゃんを見てみたいです\n\nご検討よろしくお願いします！", "nc": 57, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@honeycombtyan/works/10", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3228945, "client_id": 326513, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/24446f98/uploads/origins/fbdabc40-bd1c-4044-852a-93941d9019dd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e6435e99d6c8c2bbe811db65bb8a845a", "srcset": "https://si.imgix.net/24446f98/uploads/origins/fbdabc40-bd1c-4044-852a-93941d9019dd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e6435e99d6c8c2bbe811db65bb8a845a, https://si.imgix.net/24446f98/uploads/origins/fbdabc40-bd1c-4044-852a-93941d9019dd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=3cf000e0ff6bc4ab6417646f4478e4e9 2x, https://si.imgix.net/24446f98/uploads/origins/fbdabc40-bd1c-4044-852a-93941d9019dd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=630cdffb2fbfda4bf2ce594d1eb6303d 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/24446f98/uploads/origins/fbdabc40-bd1c-4044-852a-93941d9019dd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=884a2dda36da11170412a5d37ad4dca9", "srcset": "https://si.imgix.net/24446f98/uploads/origins/fbdabc40-bd1c-4044-852a-93941d9019dd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=884a2dda36da11170412a5d37ad4dca9, https://si.imgix.net/24446f98/uploads/origins/fbdabc40-bd1c-4044-852a-93941d9019dd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=fb8793e4a68e61f6c4377617bf4360af 2x, https://si.imgix.net/24446f98/uploads/origins/fbdabc40-bd1c-4044-852a-93941d9019dd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=8dddfeda2acb52c9bf65eb96070f9023 3x"}, "body": "今回もおさげちゃんを依頼させていただきます。よろしければお願いします。\n\n●キャラクター\n・おさげちゃん（ラグトレイン）\n・ラグトレインの無地パーカー+絶対領域ニーソ、下着なし\n\n●内容\n・いちゃらぶ正常位で中出し\n・挿入前、恥ずかしそうにジト目でむすっとしている→浅く挿入してゆっくり抽挿、赤面に涙目→突然根元まで挿入されて大きくのけ反る→深く激しい抽挿に涙を流しながら喘ぐ→最奥に中出しされて絶頂、子宮に入りきらない精液が溢れている　の流れでお願いします\n・パーカーはへそのあたりまでめくれている\n・男性は両手でおさげちゃんの腰を掴んでいる、パーカーの上からでなく素肌を掴むようにお願いします\n・おさげちゃんの赤くなった耳が見えるようにお願いします", "nc": 49, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@honeycombtyan/works/9", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3228945, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/b8a3ead1/uploads/origins/424b2a50-dbfe-46a2-aeec-eec75ee488f0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e3c805a4cafe14d6cb248fcf8d93806c", "srcset": "https://si.imgix.net/b8a3ead1/uploads/origins/424b2a50-dbfe-46a2-aeec-eec75ee488f0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e3c805a4cafe14d6cb248fcf8d93806c, https://si.imgix.net/b8a3ead1/uploads/origins/424b2a50-dbfe-46a2-aeec-eec75ee488f0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=991439c802f988a8e4479730f41a1fb8 2x, https://si.imgix.net/b8a3ead1/uploads/origins/424b2a50-dbfe-46a2-aeec-eec75ee488f0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f62528e80b590c2a2ff6aba416fe1c1b 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/b8a3ead1/uploads/origins/424b2a50-dbfe-46a2-aeec-eec75ee488f0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9e61db64aa8a2286fb600504877f9879", 