aXgubmV0L350ZXh0P3R4dDY0PU1UQXNNREF3SUVwUVdRJnR4dGNscj1mZmYmdHh0Zm9udDY0PVFYWmxibWx5TFVKc1lXTnImdHh0YWxpZ249Y2VudGVyJnR4dHNpemU9ODAmdHh0c2hhZD0xMCZmbT1wbmcmdz0xMjAw&marky=415&txt64=44Om44Km44OQ44Oq&txtclr=fff&txtfont64=QXZlbmlyLUJsYWNr&txtfit=max&txtalign=middle%2Ccenter&txtsize=60&txtshad=10&auto=format%2Ccompress&fit=crop&crop=top&w=1200&h=630&s=f4107f7eaadd70286167e5d92962a46f", "skills": [{"genre": "art", "default_amount": 10000}, {"genre": "comic", "default_amount": 10000}], "payment_methods": {"credit_cards": {"jcb": {"nsfw": true}, "master_card": {"nsfw": true}, "visa": {"nsfw": true}, "discover": {"nsfw": true}, "american_express": {"nsfw": true}}}, "acceptable_only_public": false, "tip_acceptable": true, "yearly_report_client_visible": false, "total_appeals_count": 0, "received_works": [{"path": "/@kama_boko20/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "comic", "tipped": false, "creator_id": 2471521, "client_id": 2370346, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/7d3641a5/uploads/origins/753f5ab7-6fc9-475b-b5b0-a48f49f3a852?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7b01a58f5c464d1e62112496deca3098", "srcset": "https://si.imgix.net/7d3641a5/uploads/origins/753f5ab7-6fc9-475b-b5b0-a48f49f3a852?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7b01a58f5c464d1e62112496deca3098, https://si.imgix.net/7d3641a5/uploads/origins/753f5ab7-6fc9-475b-b5b0-a48f49f3a852?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=cc1e64197fa5880cfc61c1bd14c29138 2x, https://si.imgix.net/7d3641a5/uploads/origins/753f5ab7-6fc9-475b-b5b0-a48f49f3a852?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=4fc240d8363972c923df7cd448f1fc6a 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/7d3641a5/uploads/origins/753f5ab7-6fc9-475b-b5b0-a48f49f3a852?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c0fae4419cc58111087f5767fad80e6c", "srcset": "https://si.imgix.net/7d3641a5/uploads/origins/753f5ab7-6fc9-475b-b5b0-a48f49f3a852?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c0fae4419cc58111087f5767fad80e6c, https://si.imgix.net/7d3641a5/uploads/origins/753f5ab7-6fc9-475b-b5b0-a48f49f3a852?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=ccbccd25d2bb186b32c30a330f9d47f5 2x, https://si.imgix.net/7d3641a5/uploads/origins/753f5ab7-6fc9-475b-b5b0-a48f49f3a852?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=f890815960f020719fe85f2bfefa2d82 3x"}, "body": "こんにちは！特殊性癖となりますが、首の挿げ替えのコミックをお願いします。\n内容：原神のナヒーダが森の中で首から下を中年男の身体に挿げ替えて、手コキオナニーをして射精する。それをニィロウに目撃される。ナヒーダはニィロウとパイズリ射精と中出しセックスをする。その後ナヒーダはニィロウを元自分の体と挿げ替え、手コキと中出しセックスする。\n挿げ替える男の身体は、40代後半で身長170cmほど、体重150kgぐらいで太り気味。チンポは長さ30cmの巨根、玉も大きく絶倫。1回に100mlの精液を射精して、10回以上セックスできる体力がある。\nこの身体はナヒーダが作ったもので、他にも首から下の体があり、人のいないところで挿げ替えて遊んでるという設定です。\n細かな流れは以下の通り。\n①ナヒーダが自分の首を挿げ替えるシーン。\nナヒーダは直立している首なし男ボディ（首なしでも生きており、我慢汁を流しながら勃起してる、首断面に草元素のマークが書いてある）を持ってくる。\nナヒーダはボディの玉袋を握ると、ボディは少しびくっと反応する。次にナヒーダは自分の首元で円状になぞる。すると、首元が光りナヒーダが頭を持ち上げると首が外れる。ナヒーダの首なしボディにも草元素マークが描いてある。首なしでも生きており、興奮して愛液が垂れている。\n②ナヒーダは自分の頭を男ボディの首元に持っていき、押さえながら置く。すると首元の光が消えて完全に癒着する。ナヒーダはくっついた男ボディの手足を動かして、成功を確認。ナヒーダはガニ股になり、勃起したチンコを手コキし始めて、大量の精液を射精し賢者モードとなる。\n③その一部始終を見ていたニィロウに気づいたナヒーダ。ナヒーダは驚き取り繕うとしたが、ニィロウはナヒーダが好きと告白しナヒーダのチンポをおっぱいで挟む。そのままパイズリをしてナヒーダはニィロウに顔射する。ニィロウは自分の顔に着いた精液を舐めてナヒーダとキスする。\n④2人はダブルベッドに行き正常位でセックスする。ナヒーダはニィロウのおっぱいを揉みながら腰を突き、ボテ腹になるほど射精する。⑤ナヒーダはニィロウの首元をなぞりニィロウの首を外す。そして元自分の体にニィロウの首をくっつける。そして2回戦がはじまり、今度は騎乗位でニィロウがピストン運動する。ナヒーダは締め付けが気持ちよすぎて、再度ボテ腹になるほどになるほど中だし射精する。\n最後にニィロウはナヒーダと抱き合ってキスをする。\n流れとしてはこんな感じてお願いします。\n細かな点としては、\n・修正は黒海苔でお願いします。\n・中出し後は受精した描写も欲しいです。\n・差分で膣の断面が分かるようにお願いします。余裕があったらでいいのですが、着衣verの差分も欲しいです。\nよろしくお願いします。", "nc": 168, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@kama_boko20/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "comic", "tipped": true, "creator_id": 2471521, "client_id": 586774, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/6c5dafd4/uploads/origins/422a62ec-f7dc-4cd5-b238-6f3b0f94292a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b15955608dd74dc415b36837e2e5a702", "srcset": "https://si.imgix.net/6c5dafd4/uploads/origins/422a62ec-f7dc-4cd5-b238-6f3b0f94292a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b15955608dd74dc415b36837e2e5a702, https://si.imgix.net/6c5dafd4/uploads/origins/422a62ec-f7dc-4cd5-b238-6f3b0f94292a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=929f556af5d9ca4ea24bdb0cfa1df9aa 2x, https://si.imgix.net/6c5dafd4/uploads/origins/422a62ec-f7dc-4cd5-b238-6f3b0f94292a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=33af0f0475462f524460878c36b0ca25 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/6c5dafd4/uploads/origins/422a62ec-f7dc-4cd5-b238-6f3b0f94292a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=dda941a99f13afe9ef39fdedc18800e1", "srcset": "https://si.imgix.net/6c5dafd4/uploads/origins/422a62ec-f7dc-4cd5-b238-6f3b0f94292a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=dda941a99f13afe9ef39fdedc18800e1, https://si.imgix.net/6c5dafd4/uploads/origins/422a62ec-f7dc-4cd5-b238-6f3b0f94292a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=4d26f6d17e9bb3b6252dcb927fcba533 2x, https://si.imgix.net/6c5dafd4/uploads/origins/422a62ec-f7dc-4cd5-b238-6f3b0f94292a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=2305009d99fb8e9852b4645ccc2648f8 3x"}, "body": "こんにちは！\n久しぶりにリクエストお願いします！\n今回は食欲の秋なミカをお願いしたいと思います。\n\n「買い食いし過ぎてお腹いっぱいになったミカ」\n①シャーレでの仕事が早く終わり、ナギサとのお茶会まで時間があったので色々なスイーツを見つけては買い食いするミカ\n②少し遅れてナギサの元に着いたミカだったが、夢中で沢山食べてしまったのでお腹がまん丸に膨れてしまっていた(ここでは苦しそうにゲップをしていると嬉しいです)\n③ナギサに問い詰められるミカだが、「今度連れて行ってあげるから許してー！」と許しを乞うのだった\nそしてセイアが「私の分も奢ってくれたら許そうじゃないか」と横槍を入れて、「セイアさんは黙っててください！」と呆れるナギサだった\n\n以上です。\nミカとナギサのやりとりと首を突っ込むセイアのわちゃわちゃしている様子を是非よろしくお願いします！\n(あとミカのまん丸お腹がみたいので...w)", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@kama_boko20/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2471521, "client_id": 1320878, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/5b9bb8f0/uploads/origins/fbb11fc0-2692-4f56-9348-b70027a2f840?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e425b8861b3ee6c4f3b61d99c4e32132", "srcset": "https://si.imgix.net/5b9bb8f0/uploads/origins/fbb11fc0-2692-4f56-9348-b70027a2f840?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e425b8861b3ee6c4f3b61d99c4e32132, https://si.imgix.net/5b9bb8f0/uploads/origins/fbb11fc0-2692-4f56-9348-b70027a2f840?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=420ec56c68ccd06f5c0a2b02afd59531 2x, https://si.imgix.net/5b9bb8f0/uploads/origins/fbb11fc0-2692-4f56-9348-b70027a2f840?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=46496a0a6a7320df7f5cda7597a85581 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/5b9bb8f0/uploads/origins/fbb11fc0-2692-4f56-9348-b70027a2f840?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e8040dc1505ac7d8acc67a3eda4c08dc", "srcset": "https://si.imgix.net/5b9bb8f0/uploads/origins/fbb11fc0-2692-4f56-9348-b70027a2f840?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e8040dc1505ac7d8acc67a3eda4c08dc, https://si.imgix.net/5b9bb8f0/uploads/origins/fbb11fc0-2692-4f56-9348-b70027a2f840?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=c147c7926c2c40669dd78d810a726473 2x, https://si.imgix.net/5b9bb8f0/uploads/origins/fbb11fc0-2692-4f56-9348-b70027a2f840?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=9785e5249901e90feced99d560ec2284 3x"}, "body": "環星党です。前回はありがとうございました。\n\n拙作『ブルーアーカイブ　双翼のレクイエム（https://syosetu.org/novel/347936/）』に登場するミカの双子の姉『聖園サナ』のイラストを依頼しても良いでしょうか？\n以下の設定を参考にした上で、詳細な内容はユウバリさんにお任せします。\n\n学園：トリニティ総合学園\n部活：ティーパーティー（パテル分派の前トップ）\n学年：3年\n年齢：17歳\n誕生日：5月8日（ミカと同じ）\n身長：160cm\n趣味：ミカ、掃除\nイメージCV：生天目仁美\n保有神秘：ルシフェル／サマエル／サタナエル\n\n固有武器\nSMG『Matutinus Puella』ランチェスター短機関銃（聖園ミカの『Quis ut Deus』と同型）\nSR『Mistress Therion』AX50\nHG『フルーティーミックス』ワルサーPPK（桐藤ナギサの『ロイヤルブレンド』と同型）\n\n一人称：私／お姉ちゃん\n二人称：あなた\n三人称：他人は基本的に『～ちゃん』『～さん』付け　ミカは呼び捨て\n\n人物像\nトリニティ総合学園の生徒会『ティーパーティー』の元ホストであり、現在はパテル分派の裏のフィクサーとして暗躍する少女。\nその頭脳はトリニティ随一と謳われ、1年生の時点で3学年全ての試験を満点合格するほどの天才。冷静沈着かつ実力主義者で、常に理知的に振る舞うが、その根幹は妹のミカ同様に割と感覚で行動している節があり、周囲からは『似た者姉妹』と見なされている。\nホストを退いた後もそのカリスマ性は健在で、パテル分派に限らず彼女を慕う生徒は数多い。誰にでも分け隔てなくフレンドリーに接し、妹のミカを溺愛する優しいお姉ちゃんだが、その愛情は極めて重いようで、ミカ成分を定期的に摂取しなければ理性が保てなくなるらしい。\n趣味の『掃除』は文字通りの清掃だけでなく、目に付く・目に入る・目に余る悪意や不純物を物理的に排除することを指す。特にティーパーティー内部の権力争いに明け暮れる生徒たちを『イナゴ』と呼び、激しく嫌悪している。彼女にとってこの『掃除』は正義の執行というより、むしろ日々のストレス発散に近い側面を持つ。\n紅茶やコーヒーが飲めないお子様舌で、普段はリンゴジュースやブドウジュースばかり飲んでいる。完璧超人な彼女の数少ない弱点であり、微笑ましい一面でもある。\n\n戦闘能力\n双子の妹・ミカや『トリニティの戦略兵器』剣先ツルギと並び立つ、キヴォトス最強格の一人。前衛のSMG、後衛のSRを使い分ける万能型アタッカー。\n10kgを超える対物ライフルを片手で軽々と振り回し、スコープを覗かずに敵の気配や悪意を感知して撃ち抜く『クイックドロー型スナイパー』という、常識外れの戦闘スタイルを確立している。自分を狙う敵スナイパーの殺気を感じ取り、弾道を見切ってカウンター狙撃で返り討ちにすることなど朝飯前。\nその本質は『気に入らないことは何でも暴力で解決する』という極めて攻撃的なものであり、闇組織や腹黒企業にとってはまさに悪夢そのもの。彼女の『掃除』によって受けた被害は、これまでも、そしてこれからも計り知れない。\n\n外見的特徴\nヘイロー：銀河や星雲を思わせる紫のグラデーション。ミカと酷似した形状だが、渦の回転は逆向き。\n髪：紫のグラデーションがかかったロングヘア。左側にお団子を結っており、ミカとは逆。細長いアホ毛が特徴。\n瞳： 深紅の瞳に、縦長の瞳孔。ミカよりも鋭く、冷徹な印象を与える。\n翼：白から黒へとグラデーションがかかった天使系の翼。左の翼にのみ装飾が施されている。\n服装：妹とお揃いの改造制服。右手首にシュシュを着用しており、これもミカとは逆になっている。\n体型：ミカよりもグラマラスで、胸は最低でもFカップ以上ある。\n\n台詞サンプル\n「私は聖園サナ、見ての通りミカのお姉ちゃんよ。もし困ったコトがあれば、お姉ちゃんに何でも任せなさい♪」\n「もちろん平和が何よりだけど、少し刺激が足りない気がするわね」\n「ミカのいない楽園で満足するほど、私は馬鹿でも無欲でも薄情でもないってコトよ」\n「現在（いま）を生きる生命（いのち）に、未来を語ることはできるのか？　……なんてね♪」\n「どこまで行っても、全てはただ虚しいだけ……だからこそ、私は今この瞬間を生き続けるのよ」\n「寄ってたかって誰かの足を引っ張るコトしか考えてないイナゴ共に、ティーパーティーを上手くまとめられるハズがないもの」\n「―――とりあえず、全員まとめて地獄に堕ちなさい」\n「それでもあなたを無能だなんて思ったコトは一度もないわよ、マコト様♪」\n「残念だったわね、ハナコちゃん。ツルちゃん（＝剣先ツルギ）を呼べなかった時点で、あなたは最初から詰んでたのよ」\n「マダムの思想が間違ってるだなんて、私は思わない。だから……徹底的に搾り取らせて貰うわよ、ベアトリーチェ！」\n「Dies irae, dies illa, solvet saeclum in favilla……」\n\nよろしくお願いします。\n\nhttps://drive.google.com/drive/folders/1eVdHca2aO8HHMJ6CwiAfFWuVRtXH0L53", "nc": 24, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@kama_boko20/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "comic", "tipped": false, "creator_id": 2471521, "client_id": 586774, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/68bb44a6/uploads/origins/18c27258-107c-4d04-87fc-1bfdc0885aa9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=30f9e914760bd5170b026d0196cd3e73", "srcset": "https://si.imgix.net/68bb44a6/uploads/origins/18c27258-107c-4d04-87fc-1bfdc0885aa9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=30f9e914760bd5170b026d0196cd3e73, https://si.imgix.net/68bb44a6/uploads/origins/18c27258-107c-4d04-87fc-1bfdc0885aa9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c4769d553be8c2ccdd12d289b4b2822b 2x, https://si.imgix.net/68bb44a6/uploads/origins/18c27258-107c-4d04-87fc-1bfdc0885aa9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=1a4d21e6eab79d09090cb6ff00ffb0c5 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/68bb44a6/uploads/origins/18c27258-107c-4d04-87fc-1bfdc0885aa9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=61d63450065846811a4adb74b60d5416", "srcset": "https://si.imgix.net/68bb44a6/uploads/origins/18c27258-107c-4d04-87fc-1bfdc0885aa9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=61d63450065846811a4adb74b60d5416, https://si.imgix.net/68bb44a6/uploads/origins/18c27258-107c-4d04-87fc-1bfdc0885aa9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=edfbcab63d28decae1770d8594cd2ed0 2x, https://si.imgix.net/68bb44a6/uploads/origins/18c27258-107c-4d04-87fc-1bfdc0885aa9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=23d06422ebcbd0bbc5e754dd3ff68af1 3x"}, "body": "こんにちは、ちょっと考えるのに時間かかってしまい、遅くなって申し訳ないです！\n先日はお腹いっぱい食べ過ぎたミカの依頼ありがとうございました...！\n今回、その続き？を考えてきたので、是非お願いしたいと思います！\n今回はティーパーティーの2人も出したいと考えました！\n\n「もしもミカと先生の誕生日が近かったら」\n\n①先生の誕生日パーティで食べ過ぎてしまいお腹が膨れたミカ\n\n②同じくお腹が膨れたナギサとセイアだが、セイアは持ち前の勘でまた沢山食べることになるだろうと予測\n\n③ナギサはそんな頻繁に沢山食べることにはならないと考えていたが、先生の誕生日のすぐ近くにミカの誕生日がある事に気付いた\n\n④ミカへのプレゼントを考えながら身体を少しでも絞らないとまずいと悩むナギサ\n\n⑤そして迎えたミカの誕生日、セイアの勘は的中し先生の誕生日の時よりも大量のご馳走が用意されていて、ミカは喜んでいるがまた太ってしまうと内心不安なナギサ\n\n⑥ご馳走を食べ尽くしてお腹いっぱいな3人だったが、誕生日ケーキまで食べて満腹に\n\n⑦翌日、お腹が出てしまい制服がキツくなったナギサとセイアだったが、ミカだけはいつも通りの体型に戻っていた\n\n【詳細】\n・ほぼ全編通して3人のお腹は膨れたままにしていただけると嬉しいです！\n・若干面倒かと思われますが、3人の服装は制服が望ましいです(あくまで望ましいだけなので、ユウバリさんの塩梅で全く問題ありません！)\n\n以上です。\n前回ミカのお話を考えてみましたが、今回はやっぱり全員出してみたいと考えてナギサ側の視点を少し多めに入れてみました...\nイベントが立て続けに起こってお腹が満タンになるティーパーティーの面々が見たくなり、ちょっと長くなりましたが是非ご検討よろしくお願いします！", "nc": 49, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@kama_boko20/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2471521, "client_id": 2370346, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/9db80340/uploads/origins/274ed5d8-30b7-47e9-994b-dadeda12947f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=de67b2dc365b07ee7466284635aa0c35", "srcset": "https://si.imgix.net/9db80340/uploads/origins/274ed5d8-30b7-47e9-994b-dadeda12947f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=de67b2dc365b07ee7466284635aa0c35, https://si.imgix.net/9db80340/uploads/origins/274ed5d8-30b7-47e9-994b-dadeda12947f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=84030c4ec6c3d02baae73e231ec8d221 2x, https://si.imgix.net/9db80340/uploads/origins/274ed5d8-30b7-47e9-994b-dadeda12947f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=58b0409419dc0a62e059116d574a57d4 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/9db80340/uploads/origins/274ed5d8-30b7-47e9-994b-dadeda12947f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=67299de795fe3c56a7be3ffa37d748c7", "srcset": "https://si.imgix.net/9db80340/uploads/origins/274ed5d8-30b7-47e9-994b-dadeda12947f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=67299de795fe3c56a7be3ffa37d748c7, https://si.imgix.net/9db80340/uploads/origins/274ed5d8-30b7-47e9-994b-dadeda12947f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=c62ac8aaaf515d4a875f47ccdb958232 2x, https://si.imgix.net/9db80340/uploads/origins/274ed5d8-30b7-47e9-994b-dadeda12947f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=5cbe68395645be25b231b7bd5e82faae 3x"}, "body": "はじめまして。Pixivでメイドがどんどん人面犬になっていくイラストを拝見したので、もし宜しければこの内容でイラストを描いていただければと思います。\n内容はご注文はうさぎですか？のココアとリゼが不思議な薬を飲んでふたなりスフィンクス（スフィンクスの容姿はhttps://www.pixiv.net/artworks/118191962のような人面獣スタイル。タウル型ではありません）になり、チンポを勃起させながらパイズリや兜合わせ、なか出しセックスします。\n全身がわかるよう1枚絵で、薬を飲んで変身するシーン、パイズリと兜合わせで1枚～2枚、セックスはココア攻めリゼ受けで1枚、リゼ攻めココア受けで1枚ずつお願いします。なか出し差分の断面と着床表現もお願いします。\nカラーイラストで、修正は黒海苔でお願いします。", "nc": 32, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@kama_boko20/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "comic", "tipped": false, "creator_id": 2471521, "client_id": 586774, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/f308f3c4/uploads/origins/146e9d63-e9d9-4ac1-85c2-efb080995974?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=25c7ac74c6fb7ebe83970c25fa8fcc05", "srcset": "https://si.imgix.net/f308f3c4/uploads/origins/146e9d63-e9d9-4ac1-85c2-efb080995974?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=25c7ac74c6fb7ebe83970c25fa8fcc05, https://si.imgix.net/f308f3c4/uploads/origins/146e9d63-e9d9-4ac1-85c2-efb080995974?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=73b583aecc40c9ebbcfc51f38f758202 2x, https://si.imgix.net/f308f3c4/uploads/origins/146e9d63-e9d9-4ac1-85c2-efb080995974?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c4d9e029c3d1ae11543e99fc4d194774 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/f308f3c4/uploads/origins/146e9d63-e9d9-4ac1-85c2-efb080995974?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d84fd97431f07ddd18c8845491f970d7", "srcset": "https://si.imgix.net/f308f3c4/uploads/origins/146e9d63-e9d9-4ac1-85c2-efb080995974?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d84fd97431f07ddd18c8845491f970d7, https://si.imgix.net/f308f3c4/uploads/origins/146e9d63-e9d9-4ac1-85c2-efb080995974?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=19533e91f7259320c020ee959dc58c63 2x, https://si.imgix.net/f308f3c4/uploads/origins/146e9d63-e9d9-4ac1-85c2-efb080995974?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=9cef77572951844b8149cbc1e802363e 3x"}, "body": "はじめまして、今回初めてリクエストを送らせていただきます、星夢と申します。\n先日の作品「ミカが太らない理由」を見て、こういう続きになったら面白いかなぁと続きを考えてみましたので、今回はそちらの内容でリクエストをお願いします！\n\n【構成】\n基本的には地続きなので先生と会った後からになります。\n①先生から日々の任務で活躍してくれているお礼として沢山のスイーツをご馳走される\n②先生からのお礼でとても嬉しいものの、お腹がいっぱいなのは変わらず、食べられないミカ\n③先生からお腹が空いていないか疑問に持たれるが、そんな事ないよと応えてパクパク食べていく\n④結局全部食べてお腹が更にいっぱいになり前よりもお腹が膨れてしまうミカ\n⑤流石に今日だけでだいぶ食べてしまったのでお腹を見ながら体重の事が不安になるミカだった(結局後にそれも全てパワーに変換はされたので杞憂に終わる)\n\n\nこのような形でお願いします。\nユウバリさんの食べ過ぎたのを圧倒的なパワー(？)で隠してるミカが可愛いと思い、是非続きを見てみたいと考えました！\n是非ご検討をよろしくお願いします！", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@kama_boko20/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "comic", "tipped": false, "creator_id": 2471521, "client_id": 1320878, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/b7e7c300/uploads/origins/02c1d6d0-d925-4a46-8e10-4a6f8e6c42d2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=810ac4b4e7526fa04d47120c3c3d29be", "srcset": "https://si.imgix.net/b7e7c300/uploads/origins/02c1d6d0-d925-4a46-8e10-4a6f8e6c42d2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=810ac4b4e7526fa04d47120c3c3d29be, https://si.imgix.net/b7e7c300/uploads/origins/02c1d6d0-d925-4a46-8e10-4a6f8e6c42d2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=6e23e8ee124c6a2c3c5d1beeb24dc5e6 2x, https://si.imgix.net/b7e7c300/uploads/origins/02c1d6d0-d925-4a46-8e10-4a6f8e6c42d2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=25f6d6345343ef58dd5d42df1c743e42 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/b7e7c300/uploads/origins/02c1d6d0-d925-4a46-8e10-4a6f8e6c42d2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=738bddc4c9c750f4eceb45e2c5e4131c", "srcset": "https://si.imgix.net/b7e7c300/uploads/origins/02c1d6d0-d925-4a46-8e10-4a6f8e6c42d2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=738bddc4c9c750f4eceb45e2c5e4131c, https://si.imgix.net/b7e7c300/uploads/origins/02c1d6d0-d925-4a46-8e10-4a6f8e6c42d2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=ab1b82e73f7747d517d3672d1674b703 2x, https://si.imgix.net/b7e7c300/uploads/origins/02c1d6d0-d925-4a46-8e10-4a6f8e6c42d2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=dda8763059df9e4a32c1de67356336fa 3x"}, "body": "どうもはじめまして、ユウバリさん。環星党です。\n\n拙作『ブルーアーカイブ　双翼のレクイエム（https://syosetu.org/novel/347936/）』に登場するミカの双子の姉『聖園サナ』の漫画を依頼しても良いでしょうか？\n以下の設定を参考にした上で、詳細な内容はユウバリさんにお任せします。\n\n学園：トリニティ総合学園\n部活：ティーパーティー（パテル分派の前トップ）\n学年：3年\n年齢：17歳\n身長：160cm\n趣味：ミカ\n固有武器：SMG『Matutinus Puella（ランチェスター短機関銃）』／MG『Judas Iscariot（FN EVOLYS 7.62mm軽機関銃）』\nイメージCV：生天目仁美\n\n胸：最低でもF　ミカより大きめ\n性格：頭脳明晰で冷静沈着　割と上から目線　嘘や隠し事が滅茶苦茶上手い　ミカにクール要素とお姉ちゃん成分をプラスした感じ　実は重度のシスコン\n戦闘力：ミカと同等\n頭脳：ハナコ相手に頭脳戦で渡り合える程度\n味覚：お子様レベル　紅茶もロクに飲めない\n一人称：私／お姉ちゃん\n二人称：あなた\n三人称：他人は基本的に『～ちゃん』『～さん』付け　ミカは呼び捨て\n\n「私は聖園サナ、見ての通りミカのお姉ちゃんよ。もし困ったコトがあれば、お姉ちゃんに何でも任せなさい！」\n「もちろん平和が何よりだけど、少し刺激が足りない気がするわね」\n「ふふっ♪」\n「あのイナゴ共がパテル分派を上手くまとめられるだなんて、私には到底思えないのよ」\n「―――全員まとめて地獄に堕ちなさい」\n「Dies irae, dies illa, solvet saeclum in favilla……」\n\nよろしくお願いします。\n\nhttps://drive.google.com/drive/folders/1eVdHca2aO8HHMJ6CwiAfFWuVRtXH0L53", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 34718, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "モロコシ@お仕事募集中", "screen_name": "silver_corn", "avatar_url": "https://pbs.twimg.com/profile_images/1203531615005106176/a94zB1QU.png", "header_url": "https://pbs.twimg.com/profile_banners/2888441072/1709314447/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "art"}, {"genre": "correction"}], "banned": false, "nc": 177}, {"id": 55577, "creator": true, "nsfw_a