子たちが集まって、\n机いっぱいに手芸道具やノート、画材などを思い思いに広げ、\nジュースやお菓子を食べながら楽しく、\nわいわい作業してる雰囲気の配信にしたいと思っています。\n\n具体的な構図や小物の配置等はお任せいたしますので、\nイメージに合わせて、あおしろた様のセンスで自由に描いていただけますと幸いです。\n\n【キャンバスサイズ】\n1920×1080px\n\nご検討のほど、何卒よろしくお願いいたします。", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@fwfw6o6/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3539006, "client_id": 3326648, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/6ff4c310/uploads/origins/1ea4c46c-4918-4ea2-8609-423b02a1d02c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=79327bb7d8cf04af0f9da3425db4a2a0", "srcset": "https://si.imgix.net/6ff4c310/uploads/origins/1ea4c46c-4918-4ea2-8609-423b02a1d02c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=79327bb7d8cf04af0f9da3425db4a2a0, https://si.imgix.net/6ff4c310/uploads/origins/1ea4c46c-4918-4ea2-8609-423b02a1d02c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=8678847688c4123ceed448b1901615f6 2x, https://si.imgix.net/6ff4c310/uploads/origins/1ea4c46c-4918-4ea2-8609-423b02a1d02c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=7edda6f1a10dc55bdbba31c7140d9c3a 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/6ff4c310/uploads/origins/1ea4c46c-4918-4ea2-8609-423b02a1d02c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=bde6b6f67fd340223be9f2ded3195597", "srcset": "https://si.imgix.net/6ff4c310/uploads/origins/1ea4c46c-4918-4ea2-8609-423b02a1d02c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=bde6b6f67fd340223be9f2ded3195597, https://si.imgix.net/6ff4c310/uploads/origins/1ea4c46c-4918-4ea2-8609-423b02a1d02c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=71fc6e72787cd62