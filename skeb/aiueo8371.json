リリも覚悟を決めて応戦してるのと、雨降らしの中での戦いなので、お互いに傷や泥汚れが付いてる感じです。\n\n(画像のようにリリが馬乗りにされていると好ましいです)\nhttps://encrypted-tbn0.gstatic.com/images?q=tbn:ANd9GcSLZq6OiEnTD6GkBTHVPlObAm43BGu3d_jcjfhCER9ZpIM0-XRCbbRQZMNo&s=10\n\n念のためNSFW設定としました。\n仕上がりは阿井先生にお任せします。", "nc": 160, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@aiueo8371/works/63", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1827408, "client_id": 0, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/80321b70/uploads/origins/a81b8d47-e5a2-40fb-a5de-bc7fa13af557?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=feb4289faedcf7ad716cea5a26960b57", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/80321b70/uploads/origins/a81b8d47-e5a2-40fb-a5de-bc7fa13af557?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=cf9ac31554cf75f859b41c362f7caee7", "src_set": ""}, "body": "以前、ガラオンの笑気ガスの被害に遭ってしまう、\nリリとロロのイラストをリクエストした者です。\n大変お世話になりました。\n\nこの度は、\nガラオンに笑気ガスを吸わされたアサヒ（グリージョ）が、\n気絶するほど大爆笑させられてしまうイラストを、\nお願いできないでしょうか。\n\n困り眉で可愛らしく大爆笑している表情をメインに、\n可能であれば、\n笑いが強くなり見開いてゲラゲラと笑い転げ、\n疲れ果てて意識が朦朧としてしまう流れがわかる表情差分や、\n台詞の有無を用意していただけるとありがたいです。\n\nご検討、よろしくお願いします。", "nc": 169, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@aiueo8371/works/62", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1827408, "client_id": 1788408, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/b47827d7/uploads/origins/ce6b3cd1-e5a3-4c0f-b127-f68fbe39b3ee?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=96d303ace8d266835d39f530cee0f340", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/b47827d7/uploads/origins/ce6b3cd1-e5a3-4c0f-b127-f68fbe39b3ee?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=82e1eeb3f4d385b9c79d3e3c3f798026", "src_set": ""}, "body": "お世話になります！\nhttps://skeb.jp/@aiueo8371/works/58\n↑先生の変身前カルミラが性癖に刺さりすぎました、リクエストさせて下さい！\n\n【キャラ】\n変身前のカルミラ\n\n【シーン】\n何らかの理由でわざと捕まり、取り調べ室で椅子に手錠をかけられ尋問を受ける情景。\n布で目隠し、足は椅子に、手は手首と親指を結束バンドで拘束する厳重さ。\n\n○椅子拘束の全身を描いていただきたいです。\n拘束参考URL：\nhttps://x.com/katielotta/status/1561159583397474309\nhttps://x.com/AmuosNemesis/status/1631906753440026624/photo/1\n○目隠しは無しの差分、カルミラの表情、冷めた視線を向や侮蔑の表情を希望します。\n○結束バンド手錠+親指の絵コンテ\n○シズマ・ユナに後ろから布で目隠しの絵コンテ\n参考URL\nhttps://www.pixiv.net/artworks/110255819\n\n以上：\n構図の詳細はお任せします、自由に調整してください。\n金額が足りない場合、条件付き再送要請をお送りいただけますと幸いです。\nご検討のほどよろしくお願いします。", "nc": 177, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@aiueo8371/works/61", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/4b124615/uploads/origins/34a9b5f9-3370-4045-81fa-e1912f049f07?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=39d2decb597a03324bde840abcb96e95", "src_set": ""}, "private": true, "genre": "art", "tipped": false, "creator_id": 1827408, "client_id": 473379, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 49, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@aiueo8371/works/60", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1827408, "client_id": 1592990, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/1b874797/uploads/origins/254c9c00-460d-4620-86d4-2970d7aa4270?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a32874d80a519e83d865f46306b28810", "src_set": ""}, "duration": null, "nsfw": true, "hardc