6-4483-8436-2c66270c14f8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=3f156d333255994fbf50d53acfa7dd11 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/044b57ef/uploads/origins/a1d446d9-4b36-4483-8436-2c66270c14f8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=909d6a0dab72097de678d0dbeebcbef2", "srcset": "https://si.imgix.net/044b57ef/uploads/origins/a1d446d9-4b36-4483-8436-2c66270c14f8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=909d6a0dab72097de678d0dbeebcbef2, https://si.imgix.net/044b57ef/uploads/origins/a1d446d9-4b36-4483-8436-2c66270c14f8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=c42acaacc8bdb0ac5f086f1b72fd92d8 2x, https://si.imgix.net/044b57ef/uploads/origins/a1d446d9-4b36-4483-8436-2c66270c14f8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=bf8fc6733e7182404abe735243d955b1 3x"}, "body": "当方のオリジナルキャラクターをminawaさんの絵柄で拝見したく思い、リクエストいたします。\n\n［キャラクター］\n名前：ドー（どー、Dough）\n当方が制作・管理するUTAU音源のイメージキャラクターであり、オリジナルキャラクターです。ちょっとぼんやりしていますが、基本的には元気な犬のようなキャラクターです。ドーナツが好物です。\n元々いたPCから分散して、いろいろな「おともだち（ユーザー）」のところに行って歌を歌って遊んでいます。\n\n［画像資料］\nGoogleドライブ：https://drive.google.com/drive/folders/15MC-9_vZIDCf-kROl_Q9O5Q9ppIXMGt8?usp=drive_link\nドライブ内の三面図（上着あり／なし）がデフォルト衣装の正式な資料です。\n\n［キャラクター情報］\n身長：160cm（耳を除く）\n年齢：可変（デフォルトでは15歳～20歳くらい）\n体重：ある\n性別：可変\n​​性格：いろいろ\n​好きなもの：歌うこと、ドーナツ\n詳細情報（音源配布用サイト内のページ）：https://pourquoisaltfish.wixsite.com/doughnut-daisuki/%E8%A9%B3%E7%B4%B0%E8%A8%AD%E5%AE%9A\n\n［キャラクターデザインについて］\n獣耳が生えていますが、人間の耳はないという設定があるため、髪の毛などでその辺りが隠れるように描いてください。\nまた、獣耳・尻尾・目の色・髪の色などの着脱不可能なものの改変は不可ですが、それ以外の衣装・髪型・爪の色（マニキュア）などの改変は自由にしていただいて構いません。ヘッドフォン・マイクなども外した状態でも構いません。\nデフォルメによってデザインが省略されるのは問題ありません。\n\n［作品の使用用途］\n個人観賞用のグッズ（アクリルグッズ、シャツなどのアパレル、ポストカードやポスターなど、印刷物）に使用したいと考えています。その際、色味の微調整、分版作業などを経る可能性があります。\n\nminawaさんのオリジナルキャラクターである「マンドレイク」のようなタッチのドーが見られたらいいな、と思っています。\nよろしくお願いします。\n\nhttps://drive.google.com/drive/folders/15MC-9_vZIDCf-kROl_Q9O5Q9ppIXMGt8?usp=drive_link", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@17_pond_flag/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 50003, "client_id": 120402, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/3209b26a/uploads/origins/1bc05ba9-d9dd-4958-945b-bef67c5093e8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=54bbe1cdc10949272cd62dadd4072414", "srcset": "https://si.imgix.net/3209b26a/uploads/origins/1bc05ba9-d9dd-4958-945b-bef67c5093e8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=54bbe1cdc10949272cd62dadd4072414, https://si.imgix.net/3209b26a/uploads/origins/1bc05ba9-d9dd-4958-945b-bef67c5093e8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=5eeb24ea3219433a3fd0f248733bdfdd 2x, https://si.imgix.net/3209b26a/uploads/origins/1bc05ba9-d9dd-4958-945b-bef67c5093e8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=190b0ad530392265cebf2e17d15e5efd 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/3209b26a/uploads/origins/1bc05ba9-d9dd-4958-945b-bef67c5093e8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e20c1c409de996c86a905854c5ccd057", "srcset": "https://si.imgix.net/3209b26a/uploads/origins/1bc05ba9-d9dd-4958-945b-bef67c5093e8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e20c1c409de996c86a905854c5ccd057, https://si.imgix.net/3209b26a/uploads/origins/1bc05ba9-d9dd-4958-945b-bef67c5093e8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=2c36a846d77dd39ceff962c1bf79b29b 2x, https://si.imgix.net/3209b26a/uploads/origins/1bc05ba9-d9dd-4958-945b-bef67c5093e8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=ad4a92d7a60825b0f8e5364ccbe0303b 3x"}, "body": "こんにちは。いつも作品を興味深く拝見しています。Skeb開設ありがとうございます。\nこの機会に、ぜひ『アンサマライズド』のキャラクターの設定画的なものが見たいと思っています。（ネタバレにならない範囲で）キャラクターデザインにあたって必須だった要素やこだわり、目の色や身体的特徴、装飾品の傾向など、情報の細かさや量はお任せいたします。また、人数やキャラクターについてもお任せしたいです。回察252の方だと特に喜びます。\nもし同様のものが既にある（公開済みでしたらすみません）場合には、ラーメンを食べてる振弦さんなどをお願いいたします。\n以上、何卒ご検討ください。", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@tkd_SF/works/29", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2410139, "client_id": 120402, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/f0d31aa9/uploads/origins/7b82cbc0-f9d7-457d-a38b-66c82dd8d360?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5578782529c98bf38e40d6cba36a6031", "srcset": "https://si.imgix.net/f0d31aa9/uploads/origins/7b82cbc0-f9d7-457d-a38b-66c82dd8d360?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5578782529c98bf38e40d6cba36a6031, https://si.imgix.net/f0d31aa9/uploads/origins/7b82cbc0-f9d7-457d-a38b-66c82dd8d360?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=0e2386556dd800087c823d66263537b2 2x, https://si.imgix.net/f0d31aa9/uploads/origins/7b82cbc0-f9d7-457d-a38b-66c82dd8d360?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=1dcf7f7c4d021a5d2e5c3a3c27a366a1 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/f0d31aa9/uploads/origins/7b82cbc0-f9d7-457d-a38b-66c82dd8d360?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=da635dfe7e3cf4745af90e1d0f8b5188", "srcset": "https://si.imgix.net/f0d31aa9/uploads/origins/7b82cbc0-f9d7-457d-a38b-66c82dd8d360?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top