/78dd7636-c4bd-4642-9430-ea23f19e66db?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=97153d06f6b5d609265e71b38e40b1f9 3x"}, "body": "私のキャラクター、アニーシャを描いてほしい。彼は女装したメイドで名誉騎士。理想は2つの作品。\n\nシチュエーション1：メイド姿で、年老いた主人（父親）が後ろから彼を犯している。テーブルの上に押しつけられているのが想像できる。\nOutfit 1:https://x.com/JackthePro4/status/2004816712034865516?s=20\n\nシチュエーション2：戦闘服のまま、片足を上げ、若旦那（息子）に自由に挿入させている。\nOutfit 2: https://x.com/JackthePro4/status/2004821607387377758?s=20\n腰にレイピアやダガーがあれば望ましい。\n\n老師（父）と若師（息子）は顔を完全に出す必要はないが、年齢はそれぞれ40歳と20歳くらい。", "nc": 40, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@MiyashiroKiyu/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2960925, "client_id": 842721, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/a70dd378/uploads/origins/64555787-813e-488f-b442-8145898664f9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7c30b6c87ec66c45cece1af2aab5548f", "srcset": "https://si.imgix.net/a70dd378/uploads/origins/64555787-813e-488f-b442-8145898664f9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7c30b6c87ec66c45cece1af2aab5548f, https://si.imgix.net/a70dd378/uploads/origins/64555787-813e-488f-b442-8145898664f9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=5a6d4ec736f0f85b8b2577baf8bf5498 2x, https://si.imgix.net/a70dd378/uploads/origins/64555787-813e-488f-b442-8145898664f9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=6af5732288f77dbde11ad8e8ce4142b7 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/a70dd378/uploads/origins/64555787-813e-488f-b442-8145898664f9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3794885422c4da2ab362cc9d8600c1c8", "srcset": "https://si.imgix.net/a70dd378/uploads/origins/64555787-813e-488f-b442-8145898664f9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3794885422c4da2ab362cc9d8600c1c8, https://si.imgix.net/a70dd378/uploads/origins/64555787-813e-488f-b442-8145898664f9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=7b1a15cd5cc819557a944d00e38ea280 2x, https://si.imgix.net/a70dd378/uploads/origins/64555787-813e-488f-b442-8145898664f9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=a460081e00b69768afa00de7d56f64f1 3x"}, "body": "宮白樹由様に初めてリクエストさせていただきます。\n以前宮白様が描かれていた甘雨ちゃんの誕生日イラストや「えちちな甘雨　その１～３」に惹かれて依頼させていただきました。\nもしよろしければ、現代パロのレースクイーン甘雨お姉様のイラストを描いていただけないでしょうか！\n\n◆希望シチュエーション：\n・レースクイーンの衣装デザインはお任せしますが、テカテカロングブーツを履いて欲しいことと、全体的に衣装はテカり感強めを希望します。\n・おっぱい、太ももなどはゲームオリジナルより多少むっちり肉感的に❤\n・露出している肌は汗でじんわりテカっていると嬉しい。\n・アズールレーンのレースクイーン衣装は結構どれもお気に入りですので、もし参考にするものが何か必要な場合はアズレンRQ衣装を参考にしていただけると嬉しいです。\n\n◆希望差分\n・レースクイーンというにはかなり布が減らされたバージョン（↑で描いていただいた衣装の布を削る感じ）\n・羞恥の表情差分\n\n\n資料\nhttps://www.pixiv.net/artworks/135063596\nhttps://x.com/azurlane_staff/status/1573517359411007488\nhttps://www.pixiv.net/artworks/119782522\nhttps://www.pixiv.net/artworks/138386006\n\n\nNSFWを有効にしていますが、直接的に大事な秘部は見えない程度にえっちな描写をお願いしたいです。\nもしご条件に合いましたらよろしくお願いします。\n\nhttps://x.com/azurlane_staff/status/1573517359411007488", "nc": 33, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@MiyashiroKiyu/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2960925, "client_id": 3825111, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/bb05aecf/uploads/origins/79a864bd-5663-4ea4-bab4-7ff6db96ac02?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=90653318c2ab293c27576688d29b57b3", "srcset": "https://si.imgix.net/bb05aecf/uploads/origins/79a864bd-5663-4ea4-bab4-7ff6db96ac02?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=90653318c2ab293c27576688d29b57b3, https://si.imgix.net/bb05aecf/uploads/origins/79a864bd-5663-4ea4-bab4-7ff6db96ac02?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=0959add2b13215c795b145ef7fa42396 2x, https://si.imgix.net/bb05aecf/uploads/origins/79a864bd-5663-4ea4-bab4-7ff6db96ac02?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=edbfda7f039fee7d0a0c99462ac97812 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/bb05aecf/uploads/origins/79a864bd-5663-4ea4-bab4-7ff6db96ac02?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=be2d02e5c9c24b2ab3af381b161a7b86", "srcset": "https://si.imgix.net/bb05aecf/uploads/origins/79a864bd-5663-4ea4-bab4-7ff6db96ac02?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=be2d02e5c9c24b2ab3af381b161a7b86, https://si.imgix.net/bb05aecf/uploads/origins/79a864bd-5663-4ea4-bab4-7ff6db96ac02?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=50bf0c1dd12594660be67d34964c9db3 2x, https://si.imgix.net/bb05aecf/uploads/origins/79a864bd-5663-4ea4-bab4-7ff6db96ac02?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=e591d4cc8a4e2a1f0804adb52c64eea9 3x"}, "body": "こんにちは！\n\n私はあなたの絵の中の女性らしさの描き方がとても好きです。\n\n私のOCの画像を希望していました。作品は露骨ではありませんが、示唆的です。あなたがそれをしたくないなら、私は理解しています！\n\n私のOCは男性ですが、女性的な特徴と曲線を持っています。キラキラと輝くひげ（無精ひげで、ふさふさではない）を生やしており、それがOCのブランドになっています。OCは女性キャラクターと同じように描いてほしいのですが、胸は平らで、無精ひげはキラキラしています。\n\n彼は社会が考える女装や男装にこだわらず、何を着ても平気。また、他人が自分の外見に戸惑うのを楽しんでいる。\n\n私は彼に短いドレスかスカートを着てほしい。流れるような長い髪をしてほしい。いちゃつくような、欲望に満ちた表情で肩の後ろを見てほしい。スカートを少し持ち上げてほしい（下着やペニスの膨らみを見せるのはオプション。下着やペニスの膨らみを見せるのは任意。）OCを後ろから見たときに女性だと思ったであろう視聴者を混乱させることに喜びを見出すキャラクターであってほしい。OCはウインクしているかも？あなた次第です！\n\nきらびやかなひげを残すことは重要だ。\n\nポーズの参考はこちら。\nhttps://www.pixiv.net/en/artworks/129196798\n\nお尻の形は、8番か12番を参考にしてください。\nhttps://x.com/GanyazJr/status/1489509033375457282/photo/1\n\nお断りしたい気持ちはよくわかります！不快に感じるならこのイラストは作らないでください。\n\n参考画像（OCは劇場で私の舞台演技の一部として使われています）、OCについての詳細情報、OCの他の依頼についてはGoogle Disk-linkを参照してください。\n\nお読みいただき、またご検討いただき、本当にありがとうございました！\n\nhttps://drive.google.com/drive/folders/1cn-Cli83XP2h5aoHZB86Q4_wjYNbaDYM", "nc": 160, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@MiyashiroKiyu/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2960925, "client_id": 2981194, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/40b3be80/uploads/origins/460718de-b446-45c4-882d-bc0f96b2bd57?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8f89ec0d49f6d81c04cacfcd75a6ff47", "srcset": "https://si.imgix.net/40b3be80/uploads/origins/460718de-b446-45c4-882d-bc0f96b2bd57?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8f89ec0d49f6d81c04cacfcd75a6ff47, https://si.imgix.net/40b3be80/uploads/origins/460718de-b446-45c4-882d-bc0f96b2bd57?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=4dbafbd3e5ec30b0ae78bcfc10419d42 2x, https://si.imgix.net/40b3be80/uploads/origins/460718de-b446-45c4-882d-bc0f96b2bd57?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b7802ee3210fda4d00d1fd638d6908e5 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/40b3be80/uploads/origins/460718de-b446-45c4-882d-bc0f96b2bd57?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0ccea7662e404eb260e77ceaaef76264", "srcset": "https://si.imgix.net/40b3be80/uploads/origins/460718de-b446-45c4-882d-bc0f96b2bd57?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0ccea7662e404eb260e77ceaaef76264, https://si.imgix.net/40b3be80/uploads/origins/460718de-b446-45c4-882d-bc0f96b2bd57?bg=%23fff&auto=format%2Ccom