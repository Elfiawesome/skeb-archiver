オリジナルデザイン通り指は手足ともに3本ずつにしてください。胸は白いままにしてください。スーツのディテールはタイトに、股間にはキャメルトーを表現してください。 色っぽい笑みを浮かべて、頬を赤らめ、少し興奮した様子で自分自身を見つめている姿です。\n\nフードありとフードなしのバージョンをリクエストしたいです。フードは通常のレナモンの頭の形に合わせてデザインしていただけますか。また、可能であれば、3つ目のバリエーションとして、紫色の瞳に黒いスクラコン（白目用コンタクトレンズ）を装着したリカの頭に、レナモンの顔の模様を加えたものもお願いできますか。 \n\n野中リカ - https://www.deviantart.com/hibotancreations/art/Rika-Digimon-Tamers-reference-sheet-877244000\nレナモン - https://www.deviantart.com/hibotancreations/art/Renamon-Digimon-Tamers-reference-sheet-875776732", "nc": 161, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@kmrmur3/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 922099, "client_id": 1085928, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/83f73bdb/uploads/origins/67b39867-ea99-4349-8563-5dd8b0d4ba55?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8c661d9411d430432c45bfc2ed0f141d", "srcset": "https://si.imgix.net/83f73bdb/uploads/origins/67b39867-ea99-4349-8563-5dd8b0d4ba55?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8c661d9411d430432c45bfc2ed0f141d, https://si.imgix.net/83f73bdb/uploads/origins/67b39867-ea99-4349-8563-5dd8b0d4ba55?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ef9c17dc7aff1a93e5ecf02b0ba9c858 2x, https://si.imgix.net/83f73bdb/uploads/origins/67b39867-ea99-4349-8563-5dd8b0d4ba55?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=461e15cb5374e9e6f3a91a7cff812ca3 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/83f73bdb/uploads/origins/67b39867-ea99-4349-8563-5dd8b0d4ba55?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=fea54cd7e595daab5b562abd6f63c295", "srcset": "https://si.imgix.net/83f73bdb/uploads/origins/67b39867-ea99-4349-8563-5dd8b0d4ba55?bg=%23fff&auto=format%2Ccompr