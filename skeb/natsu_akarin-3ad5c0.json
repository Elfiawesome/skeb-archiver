=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d93814aed3804cb200292d6b501a33a1, https://si.imgix.net/a8270535/uploads/origins/488b3690-3c32-4f6f-8a1f-aea40058c383?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=4c7b3a837b0996e10e968280c00fea2e 2x, https://si.imgix.net/a8270535/uploads/origins/488b3690-3c32-4f6f-8a1f-aea40058c383?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=115b8071e763f0bd54005bf1d758c809 3x"}, "body": "なつあかり様、はじめまして。いつも素敵なイラストを拝見しております。今回はイラストをお願いしたいと思います。\n\nキャラクター ・霍青娥（「東方Project」）\n\n全てお任せにします、ご自由に描いてください。ご検討お願いいたします｡", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@natsu_akarin/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3377866, "client_id": 2700042, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/30d77e65/uploads/origins/d322363a-3385-4e21-8090-0d63584cd9cc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3befd955d34c39e8bf4ac9c9178f9160", "srcset": "https://si.imgix.net/30d77e65/uploads/origins/d322363a-3385-4e21-8090-0d63584cd9cc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3befd955d34c39e8bf4ac9c9178f9160, https://si.imgix.net/30d77e65/uploads/origins/d322363a-3385-4e21-8090-0d63584cd9cc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=be614ac4951c6b2e7b55e89ecd4c46d7 2x, https://si.imgix.net/30d77e65/uploads/origins/d322363a-3385-4e21-8090-0d63584cd9cc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=dfad6a2831e669b79ad8bbc55289b1fb 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/30d77e65/uploads/origins/d322363a-3385-4e21-8090-0d63584cd9cc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=082654f236847b0c13dd735290ee47d1", "srcset": "https://si.imgix.net/30d77e65/uploads/origins/d322363a-3385-4e21-8090-0d63584cd9cc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=082654f236847b0c13dd735290ee47d1, https://si.imgix.net/30d77e65/uploads/origins/d322363a-3385-4e21-8090-0d63584cd9cc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=62fcdcfea905305bf6c3026cd52afe31 2x, https://si.imgix.net/30d77e65/uploads/origins/d322363a-3385-4e21-8090-0d63584cd9cc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=b4fa2303053eaa09f0a77dcc6e0b1102 3x"}, "body": "こんにちは。\nskebで作品を色々探していたところ、なつあかり様の最新のskebのイラストを拝見し、塗りや表情、背景などの雰囲気がとても素敵で、考えていた構想にバッチリとハマりそうで、是非にとお願いしたく今回ご依頼させていただきました。\n\nさて、今回の依頼ですが、個人Vtuberの神代れいん様のFAを依頼したいです。\n出来上がった作品はご本人様にプレゼント予定です。\nまた神代れいん様のFAをご依頼する事に関してですが、ご本人様より許可が出ております。\n\nさて、描いて欲しい内容ですが、背景付き一枚絵をになります。\n構図について、ポーズや位置などについてはお任せしますが、内容にいくつか希望がありますので、以下の内容でお願いいたします。\n\n・室内\n・窓が一つあり、外は雨である\n・テーブルがあり、上にパーティのような料理が置いてある\n・神代れいん様の表情は無表情に近い物憂げな表情\n・全体的に暖かそうだが物静かそうな雰囲気\n\n以下、可能であれば\n・通常の神代れいん様の衣装では無く冬服そうな暖かい服(デザインお任せします)\n(冬服のデザインに詳しく無く、お任せとしていますが、難しい希望だと思ってますので、やっていただければ嬉しいですが、可能であればで大丈夫です。)\n\n以上になります。\n要望を色々挙げましたが、\nクリスマスっぽい雰囲気の室内の、\n(ただしクリスマスに限定するとイラストが使いにくそうなのであくまでパーティっぽい雰囲気)\n冬用の神代れいん様のFAが欲しいという内容になります。\n(雨なのは、ご本人様が雨の国に住んでるため)\n\n参考資料については自己紹介サイトとリットリンクを貼っておきますので、そちらをご確認お願いいたします。\n1点注意点があるとするならば、後ろの茶色の触手のようなものは、髪の毛という事になってますので、後頭部の普通の髪の下から生えていますのでお気をつけください。\n\nhttps://eclatatant.wixsite.com/eclatatant/神代れいん\n\nhttps://lit.link/rainkamishiro\n\n納品の際は、背景透過の差分も、PSD形式のレイヤー分けまたは複数の個別ファイルでいただきたいです。\nまた、神代れいん様のご本人の活動内での使用許可(収益化含む)も併せてお願いいたします。\n\n是非ご検討のほど、よろしくお願いいたします。", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@natsu_akarin/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3377866, "client_id": 3010956, "vtt_