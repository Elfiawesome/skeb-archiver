と返事と確認をしている。\n\n「ハンターネーム、パラノイア:スノー……です。……はい、依頼の内容には目を通してあります。……問題ありません。一つ確認ですが……この犯人というのは、捕らえたら殺してしまっても構わないん、ですね？」", "nc": 145, "word_count": 0, "transcoder": "audio", "creator_acceptable_same_genre": false}, {"path": "/@suterus_s/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1475829, "client_id": 1680031, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/9b814879/uploads/origins/a0465ebd-0c19-4d18-98df-68a435a5744a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=cf2d374ce0aeccf5a8f789b34a3124ae", "srcset": "https://si.imgix.net/9b814879/uploads/origins/a0465ebd-0c19-4d18-98df-68a435a5744a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=cf2d374ce0aeccf5a8f789b34a3124ae, https://si.imgix.net/9b814879/uploads/origins/a0465ebd-0c19-4d18-98df-68a435a5744a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=4060f82834cd68676de2029d3cf16cdb 2x, https://si.imgix.net/9b814879/uploads/origins/a0465ebd-0c19-4d18-98df-68a435a5744a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=29ed55e33405d21c245f001cb2e2dfde 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/9b814879/uploads/origins/a0465ebd-0c19-4d18-98df-68a435a5744a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3020f55d93fa4414b7b519b71aa79e92", "srcset": "https://si.imgix.net/9b814879/uploads/origins/a0465ebd-0c19-4d18-98df-68a435a5744a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3020f55d93fa4414b7b519b71aa79e92, https://si.imgix.net/9b814879/uploads/origins/a0465ebd-0c19-4d18-98df-68a435a5744a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=a37169ad0748e6092079080fe95815df 2x, https://si.imgix.net/9b814879/uploads/origins/a0465ebd-0c19-4d18-98df-6