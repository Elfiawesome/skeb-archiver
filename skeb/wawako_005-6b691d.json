んでおります。\n\n\n如月勇の！！幸専用寝かしつけボイスを！！！ください！！！\nシチュエーションや想定される年齢はお任せいたしますが、例としていくつか妄想を置いていくので必要に応じてレンジでチンしていただけたら幸いです。\n\n・寝られないと駄々をこねていたのに数匹ひつじを数えてやったら寝落ちした幸に呆れる勇\n・悪夢を見て起きてきた幸をなだめる勇\n\n気が向いたときにでもいただけたら活力になります！！！！！\n\n\n寒い日々が続きますが、どうか美味しいものをたくさん食べてご自愛ください。楽しい日々が送れますように〜！\n乱文失礼いたしました！！！", "nc": 145, "word_count": 0, "transcoder": "audio", "creator_acceptable_same_genre": true}, {"path": "/@ao_kzr/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2862284, "client_id": 2862295, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/406470fa/uploads/origins/8f47e900-35df-4fc9-baa1-b88b688e70b6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2180d7c5bdce66aa45a0920368b87e79", "srcset": "https://si.imgix.net/406470fa/uploads/origins/8f47e900-35df-4fc9-baa1-b88b688e70b6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2180d7c5bdce66aa45a0920368b87e79, https://si.imgix.net/406470fa/uploads/origins/8f47e900-35df-4fc9-baa1-b88b688e70b6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a32ba04841445b458cab38458db96157 2x, https://si.imgix.net/406470fa/uploads/origins/8f47e900-35df-4fc9-baa1-b88b688e70b6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=985daf59eb9b287aba2630e1fcc6ffcd 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/406470fa/uploads/origins/8f47e900-35df-4fc9-baa1-b88b688e70b6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=859850c6922f2e38ab66e46c3e1e7d6c", "srcset": "https://si.imgix.net/406470fa/uploads/origins/8f47e900-35df-4fc9-baa1-b88b688e70b6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=859850c6922f2e38ab66e46c3e1e7d6c, https://si.imgix.net/406470fa/uploads/origins/8f47e900-35df-4fc9-baa1-b88b688e70b6?bg=%23fff&auto=format%2Ccompress