しいです。ただ、流血やバイオレンスな描写、あまりに痛そう辛そうなのはナシの方向でお願いします…この部分は難しければ省いても構いません。\n\n急ぎませんので、お時間のある時に描いていただければ幸いです。", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@aoi_0529/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 442013, "client_id": 92175, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/18bb5ee9/uploads/origins/ba37e1fa-e831-44b3-b8b3-ba33fb75f8df?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=adbbd21fd9882aca8fd51b65ff7ed7d4", "srcset": "https://si.imgix.net/18bb5ee9/uploads/origins/ba37e1fa-e831-44b3-b8b3-ba33fb75f8df?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=adbbd21fd9882aca8fd51b65ff7ed7d4, https://si.imgix.net/18bb5ee9/uploads/origins/ba37e1fa-e831-44b3-b8b3-ba33fb75f8df?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c77917b5dfaf23f9863672273ad0abcb 2x, https://si.imgix.net/18bb5ee9/uploads/origins/ba37e1fa-e831-44b3-b8b3-ba33fb75f8df?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=eb6c54ebf61012915f065d5bfc5466e6 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/18bb5ee9/uploads/origins/ba37e1fa-e831-44b3-b8b3-ba33fb75f8df?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=aef7d4bac5c63762c217ad1296061c0d", "srcset": "https://si.imgix.net/18bb5ee9/uploads/origins/ba37e1fa-e831-44b3-b8b3-ba33fb75f8df?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=aef7d4bac5c63762c217ad1296061c0d, https://si.imgix.net/18bb5ee9/uploads/origins/ba37e1fa-e831-44b3-b8b3-ba33fb75f8df?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=f0e1c049e010e228cbe3d501c9339c3a 2x, https://si.imgix.net/18bb5ee9/uploads/origins/ba37e1fa-e831-44b3-b8b3-ba33fb75f8df?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=6fa1d8dfda4c6fe7d960dc2c60021baf 3x"}, "body": "自分の持ちキャラクターのイラストをお願いしたいです。\n桜の木と鳥居を背景に、動きのあるようなポーズでお願いできますと幸いです。\n\nhttps://drive.google.com/file/d/1SCUpo3GvalKFMA0K2Uc4lsiDDmZXj-Rv/view?usp=drivesdk", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@aoi_0529/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 442013, "client_id": 419605, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/f8e83592/uploads/origins/5b19bc2b-19c5-47b0-b16b-8857bbbe8b07?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8453a47c318476b897d9df94326cd1c9", "srcset": "https://si.imgix.net/f8e83592/uploads/origins/5b19bc2b-19c5-47b0-b16b-8857bbbe8b07?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8453a47c318476b897d9df94326cd1c9, https://si.imgix.net/f8e83592/uploads/origins/5b19bc2b-19c5-47b0-b16b-8857bbbe8b07?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=1e5810a7bd45e372497beb92d9efa842 2x, https://si.imgix.net/f8e83592/uploads/origins/5b19bc2b-19c5-47b0-b16b-8857bbbe8b07?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=7f5572664313799c36d63da1e4d9fe56 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/f8e83592/uploads/origins/5b19bc2b-19c5-47b0-b16b-8857bbbe8b07?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e899e9da4ab2bd4077be188cdb231bf0", "srcset": "https://si.imgix.net/f8e83592/uploads/origins/5b19bc2b-19c5-47b0-b16b-8857bbbe8b07?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e899e9da4ab2bd4077be188cdb231bf0, https://si.imgix.net/f8e83592/uploads/origins/5b19bc2b-19c5-47b0-b16b-8857bbbe8b07?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=0731b60c9fdd723c588c8bfeae512f7c 2x, https://si.imgix.net/f8e83592/uploads/origins/5b19bc2b-19c5-47b0-b16b-8857bbbe8b07?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=ea5fb8ea811b3b06f8135df1de442605 3x"}, "body": "こんにちは。いつも素敵なイラストや漫画を拝見してます。Skeb開設を楽しみにしておりましたので嬉しいです。どうぞ宜しくお願いします。\n今回は、碧さんの作品「狐と猫と縁結び」からアオ様・みしお・小雪ちゃんをリクエスト致します。\n小川の浅瀬の中で3人が水遊びをしている光景をお願いします。水中に魚を見つけたのか勢い良く水面にダイブしたみしお、みしおが立てた水飛沫に襲われるアオ様、そんな2人を見て小雪ちゃんは笑顔を浮かべています。\nアオ様と小雪ちゃんは袴や着物が水に濡れてしまわぬ様、股立を取ったり尻端折ったりしている姿だと嬉しいです。(本編では着崩してる姿が無かったので見てみたいです)\n細かなリクエストですが、ご検討いただけますと幸いです。", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@aoi_0529/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 442013, "client_id": 155969, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/f73cef78/uploads/origins/b4a630ef-b9fc-49c3-ae25-3b3a0bf1e566?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d4fa9bba596e832c5721f6666c18b17b", "srcset": "https://si.imgix.net/f73cef78/uploads/origins/b4a630ef-b9fc-49c3-ae25-3b3a0bf1e566?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d4fa9bba596e832c5721f6666c18b17b, https://si.imgix.net/f73cef78/uploads/origins/b4a630ef-b9fc-49c3-ae25-3b3a0bf1e566?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=194ed0611e03f15f44da444c30de5507 2x, https://si.imgix.net/f73cef78/uploads/origins/b4a630ef-b9fc-49c3-ae25-3b3a0bf1e566?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f86b551f3b89155587a21df7b5e86428 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/f73cef78/uploads/origins/b4a630ef-b9fc-49c3-ae25-3b3a0bf1e566?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=4cb7f2c1e03