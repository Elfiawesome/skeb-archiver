3803-f8ce-4a95-b8cb-0fd01babc473?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=74995aae095d72b7c7097ff0805ea10a 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/a61fefb8/uploads/origins/b4303803-f8ce-4a95-b8cb-0fd01babc473?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0e2c5bd565e663f83e3ae24c6a4866db", "srcset": "https://si.imgix.net/a61fefb8/uploads/origins/b4303803-f8ce-4a95-b8cb-0fd01babc473?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0e2c5bd565e663f83e3ae24c6a4866db, https://si.imgix.net/a61fefb8/uploads/origins/b4303803-f8ce-4a95-b8cb-0fd01babc473?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=3da930d0078ee6795d95fcad4056bf43 2x, https://si.imgix.net/a61fefb8/uploads/origins/b4303803-f8ce-4a95-b8cb-0fd01babc473?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=ab048bab52fee2c41e8d8c0397157319 3x"}, "body": "初めまして♪\n良かったらVTuberである私のモデルを描いていただきたいです。\n\nキャラの設定↓↓↓\n\nキャラ名:陽渚レモン(ひなぎされもん)\n性別:♂(♀になることも可能)\n性格:明るく元気\n一人称:僕、二人称:君\n属種:猫と狐のハーフ(猫寄り)\n特技？:未熟ではあるが変化ができる(頭に葉っぱを乗せるタイプ)\nチャーム･ウィークポイント:おへそ(お腹の模様はレモンの葉をイメージ)\n服装:フード付きの着物。袖口などに彼岸花の模様があしらわれている\n\nイラストの内容としましては、\n寝起きの感じをお願いできればなと思います！\nちょっとだらしない感じで｢ふぁ〜…｣とあくびしてる様子。\n服はこの一着しかないため、この服装でお願いします。寝起きのためフードを外しても可です。\nこの子のチャームポイントがおへそなので、ちょっと大きめにするやほんのり赤っぽくするなどで目立つようにしてもらえると嬉しいです♪\n背景はちょと可愛めのお部屋の雰囲気だと嬉しいです♪\n\n商用利用はしませんが、サムネイル等に使いたいとも思ってますので、背景白か透過してもらえると嬉しいです。\n\nぜひ検討よろしくお願いします。", "nc": 48, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@aoi_0529/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 442013, "client_id": 1014024, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/f03b3124/uploads/origins/badc116a-f53d-4555-b0c0-b8d5534126c0?bg=%23fff&a