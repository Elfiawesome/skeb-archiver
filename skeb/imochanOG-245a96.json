: {"nsfw": true}}}, "acceptable_only_public": false, "tip_acceptable": true, "yearly_report_client_visible": false, "total_appeals_count": 0, "received_works": [{"path": "/@imochanOG/works/10", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3223630, "client_id": 2159622, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/f2169dcf/uploads/origins/2bc9c53b-5835-49c8-8a08-527fd625d2b1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0d3be5c32636c1207380c6f72e12c68d", "srcset": "https://si.imgix.net/f2169dcf/uploads/origins/2bc9c53b-5835-49c8-8a08-527fd625d2b1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0d3be5c32636c1207380c6f72e12c68d, https://si.imgix.net/f2169dcf/uploads/origins/2bc9c53b-5835-49c8-8a08-527fd625d2b1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=2209e1c5267c8eab1cb051948f71bf26 2x, https://si.imgix.net/f2169dcf/uploads/origins/2bc9c53b-5835-49c8-8a08-527fd625d2b1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=36af9ccc19191920fe87a7220a6b84a3 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/f2169dcf/uploads/origins/2bc9c53b-5835-49c8-8a08-527fd625d2b1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f4bcb9f5704835b3e07a5f2d712c9663", "srcset": "https://si.imgix.net/f2169dcf/uploads/origins/2bc9c53b-5835-49c8-8a08-527fd625d2b1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f4bcb9f5704835b3e07a5f2d712c9663, https://si.imgix.net/f2169dcf/uploads/origins/2bc9c53b-5835-49c8-8a08-527fd625d2b1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=86b326dca0166c1bf8ccbb77f8ae444c 2x, https://si.imgix.net/f2169dcf/uploads/origins/2bc9c53b-5835-49c8-8a08-527fd625d2b1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=8a5d3754a4508245e7576b385eec6f8b 3x"}, "body": "はじめまして。\n\nおねしょをして膝の上からお尻を叩かれるアニメキャラのイラストを描いていただきたいです。\n想定しているキャラクターは、\"おとなりの天使様にお願い人間になってみた \"の椎名まひるです。\nまひるの服装は着心地のいいパジャマで、パンティはシンプルだけどかわいいものを予定しています(https://drive.google.com/file/d/1-NxEaPJCwb_yi76vOxeajNahxFbDJHEW/view?usp=sharing)。\n\nシナリオとしては、天音さんとホラー映画を見ていて、トイレに行くのが怖くて、天音さんのソファーでおねしょをしてしまう。彼女はそれをとても後悔し、あまねさんにお仕置きを頼む。お仕置きの後、あまねさんはまひるを慰める。まひるのお尻はお仕置きで真っ赤だ。\n\n以上、よろしければご検討ください。", "nc": 49, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@imochanOG/works/9", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3223630, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/cd495d3b/uploads/origins/cc24712d-df89-407a-ba83-0807adfc4bf3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1e431f1c5d76a4ea48b948c60395ae1b", "srcset": "https://si.imgix.net/cd495d3b/uploads/origins/cc24712d-df89-407a-ba83-0807adfc4bf3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1e431f1c5d76a4ea48b948c60395ae1b, https://si.imgix.net/cd495d3b/uploads/origins/cc24712d-df89-407a-ba83-0807adfc4bf3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f7306f6481027409ee1446c59fc7f56e 2x, https://si.imgix.net/cd495d3b/uploads/origins/cc24712d-df89-407a-ba83-0807adfc4bf3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=df9d53538d60a5878d49c4051ba903ec 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/cd495d3b/uploads/origins/cc24712d-df89-407a-ba83-0807adfc4bf3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e9b300bdc24fa7120e7be222f597a85b", "srcset": "https://si.imgix.net/cd495d3b/uploads/origins/cc24712d-df89-407a-ba83-0807adfc4bf3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e9b300bdc24fa7120e7be222f597a85b, https://si.imgix.net/cd495d3b/uploads/origins/cc24712d-df89-407a-ba83-0807adfc4bf3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=a8b4b555a182e10ec02b742f02e019de 2x, https://si.imgix.net/cd495d3b/uploads/origins/cc24712d-df89-407a-ba83-0807adfc4bf3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=ce459cae4e39e22624a60d8ad700b63b 3x"}, "body": "度々失礼します。8枚組のJKのおもらしイラストをお願いしている者ですが、再度おもらししてしまう女の子の日常イラストをお願いしたく、リクエストさせていただきました。今回は1枚です。\n\n朝の教室での様子\n【シチュエーション】\n自分の席に座り、片手でハンカチをもって汗を拭きながら、もう片方の手で自分をあおいで、隣の子に「毎日暑いよね～」と話しかけている\n【詳細について】\n・おもらし当日の朝なので服装は同じ\n・外が暑かったので結構な汗をかいている\n・もっているハンカチはおもらしの後始末で使うものと同じ\n\n変更・省略全く構いません。ご検討よろしくお願いします！", "nc": 32, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@imochanOG/works/8", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3223630, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/c4bd18ff/uploads/origins/ec0b7978-57e8-436a-ae89-aff628e693e8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=79444e393512a1e14ca05f75db4b2568", "srcset": "https://si.imgix.net/c4bd18ff/uploads/origins/ec0b7978-57e8-436a-ae89-aff628e693e8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=79444e393512a1e14ca05f75db4b2568, https://si.imgix.net/c4bd18ff/uploads/origins/ec0b7978-57e8-436a-ae89-aff628e693e8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=77209c8d4df713b05b3afbc29486fc09 2x, https://si.imgix.net/c4bd18ff/uploads/origins/ec0b7978-57e8-436a-ae89-aff628e693e8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=1d3cce0a824c856f8294609795dc6a7e 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/c4bd18ff/uploads/origins/ec0b7978-57e8-436a-ae89-aff628e693e8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=23e3a7cc39dd66dc1dd69d8de277923f", "srcset": "https://si.imgix.net/c4bd18ff/uploads/origins/ec0b7978-57e8-436a-ae89-aff628e693e8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=23e3a7cc39dd66dc1dd69d8de277923f, https://si.imgix.net/c4bd18ff/uploads/origins/ec0b7978-57e8-436a-ae89-aff628e693e8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=c905b8e6be187eb8f38558d919f0fb52 2x, https://si.imgix.net/c4bd18ff/uploads/origins/ec0b7978-57e8-436a-ae89-aff628e693e8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=2c497cb1737ddc893e1596c47934c0e3 3x"}, "body": "先日8枚組のJKのおもらしイラストをお願いした者ですが、その女の子の普段の様子が伺えるような健全イラストを3枚お願いできますか？\n\n1枚目…入学時の記念撮影\n【シチュエーション】\n満開の桜を背景に少し照れながら笑っている\n【詳細について】\n・髪型は同様ながら冬服で、冬服はセーラーブレザーで紺の上着の下に白いブラウス、リボンの色は同じ(青)でスカートも同じデザイン\n・黒タイツを履き、黒のストラップシューズを履いている\n・通学カバンにはまだ何も付けられていない\n※直接関係はないがブラウスや夏服の下には白いキャミソールを着ている\n\n2枚目…私服で歩いている\n【シチュエーション】\n夏の休日に近所の図書館へお出掛け中、幼馴染の子と会って軽く挨拶をしている\n【詳細について】\n・幼馴染の子からみたような視点\n・髪は結んでおらず下ろしている\n・服装は少し垢抜けないよつな私服で、白い半袖のシャツに水色のキャミチュニック、ベージュの7分丈のややタイトなズボンに白いスニーカーソックスに黒いマジックテープのスニーカー(おもらし時と同じスニーカー)を履き、勉強用具の入ったクリーム色のトートバッグを持っている\n\n\n3枚目…おもらし当日の朝\n【シチュエーション】\n玄関で軽く手を振って女の子とそれを優しく見送るお母さん\n【詳細について】\nおもらし後のイラストと対照的なくらいに健全な感じでお願います。\n\n省略・変更一切構いません！ご検討よろしくお願いします。", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@imochanOG/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "comic", "tipped": true, "creator_id": 3223630, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/ca6cab1e/uploads/origins/c3d3d6cb-3796-4460-b723-8e83d051f9a4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=15e72678a475c05bfea5e0a0c0fe5e86", "srcset": "https://si.imgix.net/ca6cab1e/uploads/origins/c3d3d6cb-3796-4460-b723-8e83d051f9a4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=15e72678a475c05bfea5e0a0c0fe5e86, https://si.imgix.net/ca6cab1e/uploads/origins/c3d3d6cb-3796-4460-b723-8e83d051f9a4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=1a8ff5243e7ca633da9d37f8ad66dd9f 2x, https://si.imgix.net/ca6cab1e/uploads/origins/c3d3d6cb-3796-4460-b723-8e83d051f9a4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=9ec0afaa25312fbc8178c630b4f73d92 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/ca6cab1e/uploads/origins/c3d3d6cb-3796-4460-b723-8e83d051f9a4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=1df4e2c2671a970ff7316bb70000a58d", "srcset": "https://si.imgix.net/ca6cab1e/uploads/origins/c3d3d6cb-3796-4460-b723-8e83d051f9a4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=1df4e2c2671a970ff7316bb70000a58d, https://si.imgix.net/ca6cab1e/uploads/origins/c3d3d6cb-3796-4460-b723-8e83d051f9a4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=b7692a13ba1c8fc194802716c6a0c862 2x, https://si.imgix.net/ca6cab1e/uploads/origins/c3d3d6cb-3796-4460-b723-8e83d051f9a4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=0c928815fbd59fcef8313268a66b8c4d 3x"}, "body": "ある夏の日の午後、学校帰りのJKが最寄り駅から自宅まで我慢できずに途中の公衆トイレに駆け込むも間に合わずにおもらし（セウト）してしまい、後始末をしてとぼとぼと家に帰り、玄関でお母さんに慰められながら大泣きしている作品をお願いします。\n構成は以下の通りで1枚目と8枚目が1枚絵で、２～７枚目が漫画でお願いしたいと考えております。あくまでも目安で多少の違いは全く構いません。\n\n1.キャラデザ\n2.我慢・おちびり\n3.決壊①\n4.決壊②\n5.後始末①\n6.後始末②\n7.後始末後\n8.エピローグ（1枚絵で自宅の玄関で女の子が大泣きしてお母さんに慰めてもらっている）\n\n【おもらしについて】\n本当にギリギリで間に合わなかった感じで、片手でスカートをまくり、もう片方の手でスパッツを下ろしながら便座にすわろうとしていた。しかし、全て裏目に出て、便器の周りは水たまりができ、便座はびしょびしょ、スカート、スパッツやパンツはもちろん制服上着の袖口や手もおしっこでびしょびしょに濡れている。おまけにスクールバッグも直前に放り投げたためにおしっこの水たまりで濡れている。\n\n【後始末について】\n靴下やスパッツやパンツを脱ぐ場面、またトイレットペーパーが切れていたという設定で、自分のハンカチで足を拭く場面、靴のマジックテープを外し、靴の中に入ったおしっこを捨てる場面があると嬉しいです。\n\n【後始末後について】\nトイレから自宅に帰る道中といった感じでトイレットペーパー代わりの自分のノートの切れ端の入った靴を裸足で履いて、足元から「ぐしゅ」と音が出ており、濡れたスカートをカバンで隠し、今にも泣きそうになっている描写があると嬉しいです。\n\n【女の子について】\n小柄な可愛らしい子で、髪型は一つ結び、服装は白基調、襟も白で、襟や袖口には紺のラインの入り、水色のリボンのついた夏服のセーラー服（長袖）で、スカートは紺でひざ丈くらいでスカート下にはスパッツを履いており、靴下は白で靴は下記のような黒いマジックテープのスニーカーでお願いします。\nhttps://item.rakuten.co.jp/shoe-chiyoda/340142570/?variantId=340142570255\nまた紺色基調で定期入れとぬいぐるみの付いたスクールバッグをもっているという設定でお願いします。\n\nご検討よろしくお願いします！", "nc": 177, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@imochanOG/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "comic", "tipped": false, "creator_id": 3223630, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/e73f0271/uploads/origins/6e17447e-8e7f-4e5a-b7c8-3d09d27fafd6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7303b9c054faa1da4347c9e2fe71236b", "srcset": "https://si.imgix.net/e73f0271/uploads/origins/6e17447e-8e7f-4e5a-b7c8-3d09d27fafd6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7303b9c054faa1da4347c9e2fe71236b, https://si.imgix.net/e73f0271/uploads/origins/6e17447e-8e7f-4e5a-b7c8-3d09d27fafd6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=df07de5fd08dca685b161e88f0b5d74c 2x, https://si.imgix.net/e73f0271/uploads/origins/6e17447e-8e7f-4e5a-b7c8-3d09d27fafd6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=88cc93f65ccde5436a95f120ef73c361 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/e73f0271/uploads/origins/6e17447e-8e7f-4e5a-b7c8-3d09d27fafd6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=37be126c058b6fa1cf8258ec889f98ba", "srcset": "https://si.imgix.net/e73f0271/uploads/origins/6e17447e-8e7f-4e5a-b7c8-3d09d27fafd6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=37be126c058b6fa1cf8258ec889f98ba, https://si.imgix.net/e73f0271/uploads/origins/6e17447e-8e7f-4e5a-b7c8-3d09d27fafd6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=8dc7e9f209b258938d0c9b8bc15eddca 2x, https://si.imgix.net/e73f0271/uploads/origins/6e17447e-8e7f-4e5a-b7c8-3d09d27fafd6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=c97de2722e66585453d8daa6ebf7a2d5 3x"}, "body": "昔からお世話になっています。\nいもちゃん(山中野いもこ)ちゃんが我慢するやつをお願いします。流れは下記の通り:\n・ジュースごくごく\n・お腹たぷたぷ\n・トイレ行きたいの？→だいじょうぶ！\n\n自業自得ですね！よろしくお願い致します！", "nc": 176, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@imochanOG/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3223630, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/027de2ed/uploads/origins/9fe8d015-02e9-44cc-af3f-9d483afe741f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=beebad4c79b31fe36f0740aae6476218", "srcset": "https://si.imgix.net/027de2ed/uploads/origins/9fe8d015-02e9-44cc-af3f-9d483afe741f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=beebad4c79b31fe36f0740aae6476218, https://si.imgix.net/027de2ed/uploads/origins/9fe8d015-02e9-44cc-af3f-9d483afe741f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=31f79dd15c9e412b1679d88dfc7d6bc6 2x, https://si.imgix.net/027de2ed/uploads/origins/9fe8d015-02e9-44cc-af3f-9d483afe741f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=5a2c6ff79c683083f3f49e20b76050a8 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/027de2ed/uploads/origins/9fe8d015-02e9-44cc-af3f-9d483afe741f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b5ad98447fdc1fba66aa3076d3163fa3", "srcset": "https://si.imgix.net/027de2ed/uploads/origins/9fe8d015-02e9-44cc-af3f-9d483afe741f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b5ad98447fdc1fba66aa3076d3163fa3, https://si.imgix.net/027de2ed/uploads/origins/9fe8d015-02e9-44cc-af3f-9d483afe741f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=9295730c7b49d5be05c53ab0fc4290f9 2x, https://si.imgix.net/027de2ed/uploads/origins/9fe8d015-02e9-44cc-af3f-9d483afe741f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=d0da8fbb59a4d97f9ada46a580e64fe8 3x"}, "body": "初めまして。昔からよくイラストを楽しませていただきました。\n今回、宜しければ以前描かれておりましたナースの女の子キャラのおもらしイラストを改めて描いて頂きたく依頼させていただきます。\nキャラクターの服装の雰囲気としては、以前描かれていたもの及びそのリメイク版(https://twitter.com/imochanOG/status/1634402280366829568/photo/1)と同じようなものをイメージしています。\nただ、場面の設定として、設備更新が遅めの病院の職員用トイレをイメージし、和式便器とトイレ用サンダル(トイレ入り口で履き替えて使うような物です)を反映していただきたいと思っています。\nまた、もし可能であればおもらし後のショーツ・タイツをクローズアップして描写していただきたいです。\nイメージとしては以前描かれていたこれ(https://twitter.com/imochanOG/status/1666505439717257216/)となります。\n下着の柄については、あまり派手過ぎない(単色と小さめのリボンぐらい)ものであれば嬉しいです。\n以上、宜しければご検討ください。", "nc": 33, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@imochanOG/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3223630, "client_id": 784488, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/d5b36db5/uploads/origins/647f1a52-b488-484d-acb7-05d1d8a86aba?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ecf4efcaed464523ac40eb727c3af054", "srcset": "https://si.imgix.net/d5b36db5/uploads/origins/647f1a52-b488-484d-acb7-05d1d8a86aba?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ecf4efcaed464523ac40eb727c3af054, https://si.imgix.net/d5b36db5/uploads/origins/647f1a52-b488-484d-acb7-05d1d8a86aba?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=1d5f6c8d155daeb032b93977d063bfe0 2x, https://si.imgix.net/d5b36db5/uploads/origins/647f1a52-b488-484d-acb7-05d1d8a86aba?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d1bfe6fdec1360cc0478b30003d3d340 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/d5b36db5/uploads/origins/647f1a52-b488-484d-acb7-05d1d8a86aba?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=16a9cbea1d95980368a30356ee5f51bf", "srcset": "https://si.imgix.net/d5b36db5/uploads/origins/647f1a52-b488-484d-acb7-05d1d8a86aba?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=16a9cbea1d95980368a30356ee5f51bf, https://si.imgix.net/d5b36db5/uploads/origins/647f1a52-b488-484d-acb7-05d1d8a86aba?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=1e115c0f59293b3a8acb997686b5b442 2x, https://si.imgix.net/d5b36db5/uploads/origins/647f1a52-b488-484d-acb7-05d1d8a86aba?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=56d6318454b4f7e289e1419e3e9e9c90 3x"}, "body": "いつもイラスト拝見しております。  \n\n\n前回は「ハヤテのごとく！」という作品に登場するキャラ、「桂ヒナギク」のおねしょ布団干しイラストをありがとうございます。\n\n今回は同じくハヤテのごとく！」に登場するキャラ、「天王洲アテネ」で、おねしょ布団干しイラストをお願いしたいです。\n\n構図は前回と同じで、物干し竿に干したおねしょ布団と寝巻きの横で、黒を基調としたドレスっぽい服で反省のために立っている。\n 表情は赤面、ジト目で横に干してあるおねしょ布団を見やっている。\n シミは薄黄色で布団に対して横長の歪な楕円形。 彼女はおねしょがまだ治っていないという設定で、布団には他の日の失敗の跡が複数残る常習犯風のおねしょ布団で、この布団は見切れないようお願いします。  \n\nそれ以外の仔細につきましては、作者様の裁量にお任せします。何卒ご検討お願い申し上げます", "nc": 176, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@imochanOG/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3223630, "client_id": 542628, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/b50e0ee2/uploads/origins/44021d7d-de9d-4bf7-a305-079e510bf1ce?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=20