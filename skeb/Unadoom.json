s&fm=webp&fit=crop&crop=top&w=200&h=200&s=abd46aa70e6090a039c95d8f20f5e0ba", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/45c9e36c/uploads/origins/8c688f73-a65d-48a4-afac-a0e347f87eff?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=07ed2b3f882b7383732d768cf22d369f", "src_set": ""}, "body": "はじめまして。\nマントフェチの濁酒と申します。\n栗村アイリでエッチなイラストをお願いします。\n\n1.栗村アイリにマントを羽織らせて全身マント姿の立ち絵をお願いします。\nマントで足元まで全身を完全にすっぽり包み隠した状態で立っている姿を全身立ち絵でお願いします。\nマントの長さは巨大な引き摺る長さで、前をぴったり閉じて中身が全く分からない、裾が足元に丸く広がる感じ（以下のURL「巨大マントのイメージ」を参考にしてください。）でお願いします。\nマントの色は緑色でお願いします。\nマントの留め具はリボンでお願いします。\n（巨大マントのイメージ）→ヤフオク、この4枚目から9枚目みたいな感じでお願いします。\nhttps://page.auctions.yahoo.co.jp/jp/auction/x1067930914\n\n2.栗村アイリがマントに包まれた状態で自身のマンコを手コキしている姿をお願いします。\n　（マントに隠れているので実際の手コキの描写はいりません。）\n　表情は涙目で感じちゃっている状態でお願いします。\n\n3.栗村アイリがマントに包まれた状態で潮を吹いてイッちゃった姿をお願いします。\n　（マントに隠れているので実際の潮吹きの描写はいりません。）\n　表情はアへ顔で、体は痙攣していると嬉しいです。\n\n4.栗村アイリがマントに包まれた状態で余韻に浸っている姿をお願いします。\n　表情はおまかせします。\n\nよろしくお願いします。", "nc": 56, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Unadoom/works/6", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/9ddf0d58/uploads/origins/c508fec2-6e18-4f51-8bc0-b0ff9459aa64?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=661ce4f96141dc1af62df23b48b105c2", "src_set": ""}, "private": true, "genre": "art", "tipped": true, "creator_id": 653199, "client_id": 47014, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 184, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@Unadoom/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 653199, "client_id": 0, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/10c2d3ef/uploads/origins/49d1f428-e80e-4985-a088-4d3b966db379?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0f55f25acd72222ebe904de8135d9eef", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/10c2d3ef/uploads/origins/49d1f428-e80e-4985-a088-4d3b966db379?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e4d59f98c28c5b163a9f5fd8a13da4f8", "src_set": ""}, "body": "以前アイリの騎乗位の絵をリクエストをしたものです。\n今回は対面座位で先生とエッチをするアイリをお願いします。\n\n[人物]\n・ブルーアーカイブの栗村アイリ\n\n[内容]\n・対面座位で腰をぐりぐりと動かすアイリ\n・アイリが絶頂し、先生が射精する差分（可能であれば）\n\n[服装など]\n・セーラー服とニーソを着たまま\n・スカートとパンツは脱いでいる\n・セーラー服の胸当てだけが外れ、胸元が見える状態\n・リボンが緩んでいる\n・ふとももにくい込むニーソ\n・コンドーム使用\n\n[演出など]\n・腰をぐりぐりとさせている動きや音\n・アイリの気持ちよさそうな表情\n・アイリが積極的に動く\n\nその他の演出などはお任せします。よろしくお願いします。", "nc": 169, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Unadoom/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 653199, "client_id": 0, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/2f034e71/uploads/origins/7e03b607-1e1b-4724-b3b3-f39d37ee7cd7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1def38df52ac8fad3d1248ee7ef2fe43", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/2f034e71/uploads/origins/7e03b607-1e1b-4724-b3b3-f39d37ee7cd7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=de2a0441199668780a71af1c7d756e50", "src_set": ""}, "body": "こんにちは！\n\nアイリちゃんのＥＸスキルに着想を得てリクエストしたい。動画の中でアイスを落とすと、それは巨大な障害物としてフィールドに落ちる。そこで、巨大なアイリちゃんをリクエストします。\n\n巨大化したアイリちゃんが恥ずかしがる姿を見てみたい。もしかしたら、他のスイーツ部員は巨大なアイリに反応するとか。詳細はお任せしますので、ご自由に。照れているアイリのイラストがとってもかわいいから、きっといい納品になると思います！\n\nありがとうございました！", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Unadoom/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 653199, "client_id": 2685081, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/3a5a52ca/uploads/origins/de5aa556-f8b0-47fb-999f-2a1ad41bb25b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ec7b72f7fa749680266004cace4e44f6", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/3a5a52ca/uploads/origins/de5aa556-f8b0-47fb-999f-2a1ad41bb25b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e16029ecb87843988a76506a038d887f", "src_set": ""}, "body": "こんにちは！私のキャラクター、ルマを描いてくれませんか？彼女は気取った猫娘で、エレガントで大人っぽく見せようとするのですが、そのあまりの未熟さに恥をかいてしまうことがよくあります。大人っぽく見せようと派手な服を着て、恥ずかしい思いをすることもしばしば。\n\nルマがビーチでツーピースの水着を着ている写真に興味を持った。彼女は自分の魅力をアピールしたくて、自信たっぷりに振る舞おうとしているが、そんな露出度の高い服を着ていることが恥ずかしいのだ。彼女は恥ずかしさのあまり目に渦を巻いており、この写真と似ている。https://x.com/Unadoom/status/1693279312223580369/photo/1\n\nルマの水着はあなたの好きなようにデザインできます。彼女の猫耳と尻尾は本物で、人間の耳はありません。ポーズや髪型も自由です。楽しんで描いてください。\n\nhttps://imgur.com/a/luma-references-MpsHs4a", "nc": 152, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Unadoom/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 653199, "client_id": 504509, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/25030bba/uploads/origins/fc590ba5-8658-44d7-90f7-9c996224baf5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fcc9e6dac459db99ee27ae48b0ffe508", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/25030bba/uploads/origins/fc590ba5-8658-44d7-90f7-9c996224baf5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f1db145158a80af56bc85550d53d92f4", "src_set": ""}, "body": "うなどん先生、はじめまして。\n\n突然ですみませんが、ブルーアーカイブの栗村アイリ（バンド）のえっちな絵を依頼したくお願いいたします。\n\nシチュエーションは、アイリちゃんにちんちんをおくちで気持ちよくされて、先生のちんちんを咥えずに亀頭の穴、尿道口を舌先をつぷつぷと尿道口に挿れたまま優しくぐにぐにと尿道の中をほじくって射精を促すような尿道責めフェラをしてくれるえっちな絵をお願い致します。\n\n◆希望\n・アイリちゃんの衣服は着服\n・コマ割で亀頭の中の断面図\n・フルカラー\n・射精差分（可能であれば）\n・イラストの構図はこちらのリンクを参考にお願いいたします。\nhttps://www.pixiv.net/artworks/113650428\n\nその他の細かい部分はお任せいたします。\n\nお気に召さなかった場合はキャンセルしても構いません。\n\n誠に勝手な依頼ではございますがご検討の程、\nよろしくお願いいたします。\n\nhttps://x.com/Blue_ArchiveJP/status/1781925860293087463?t=OM0gkY4R6iKhZjv6THPO5g&s=19", "nc": 169, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Unadoom/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 653199, "client_id": 0, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/7ebc843d/uploads/origins/de460daa-f755-4f00-93d2-194fc93bb68a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=76299b4e76313e2c2c61e9b553ceb9db", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/7ebc843d/uploads/origins/de460daa-f755-4f00-93d2-194fc93bb68a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2fdf5187afa89e661d41cb74b17cc36c", "src_set": ""}, "body": "いつもイラストなどを見させております。\nうなどんさんが描かれるアイリの絵がとても好きなので、今回リクエストをしました。\n\n内容\n・先生に脱ぎかけの状態でグラインド騎乗位をするアイリ\n\n人物\n・ブルーアーカイブの栗村アイリ\n\n服装\n・セーラー服とニーソを着たまま\n・スカートとパンツは脱いでいる\n・セーラー服のリボンが緩み、胸当ての留め具が外れてめくれている（以前描かれた同人誌の表紙に近い状態）\n・ふとももにくい込むニーソ\n\n演出など\n・上下でなく前後に腰を振るグラインド騎乗位\n・アイリの積極的な腰振り\n\nその他の表現はお任せします。\nよろしくお願いします。", "nc": 41, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "from_archive": true}