Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=abff03cd81a4e51b88df249d8ef0fbea 2x, https://si.imgix.net/3a5a52ca/uploads/origins/de5aa556-f8b0-47fb-999f-2a1ad41bb25b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=e152ba367d69a23289b7abaf9bb2dfc4 3x"}, "body": "こんにちは！私のキャラクター、ルマを描いてくれませんか？彼女は気取った猫娘で、エレガントで大人っぽく見せようとするのですが、そのあまりの未熟さに恥をかいてしまうことがよくあります。大人っぽく見せようと派手な服を着て、恥ずかしい思いをすることもしばしば。\n\nルマがビーチでツーピースの水着を着ている写真に興味を持った。彼女は自分の魅力をアピールしたくて、自信たっぷりに振る舞おうとしているが、そんな露出度の高い服を着ていることが恥ずかしいのだ。彼女は恥ずかしさのあまり目に渦を巻いており、この写真と似ている。https://x.com/Unadoom/status/1693279312223580369/photo/1\n\nルマの水着はあなたの好きなようにデザインできます。彼女の猫耳と尻尾は本物で、人間の耳はありません。ポーズや髪型も自由です。楽しんで描いてください。\n\nhttps://imgur.com/a/luma-references-MpsHs4a", "nc": 9, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Unadoom/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 653199, "client_id": 504509, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/25030bba/uploads/origins/fc590ba5-8658-44d7-90f7-9c996224baf5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fcc9e6dac459db99ee27ae48b0ffe508", "srcset": "https://si.imgix.net/25030bba/uploads/origins/fc590ba5-8658-44d7-90f7-9c996224baf5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fcc9e6dac459db99ee27ae48b0ffe508, https://si.imgix.net/25030bba/uploads/origins/fc590ba5-8658-44d7-90f7-9c996224baf5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f57eef6f0e16636a03fe5c86df9c1682 2x, https://si.imgix.net/25030bba/uploads/origins/fc590ba5-8658-44d7-90f7-9c996224baf5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=84917467e4767d2728072e5ab0d58923 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/25030bba/uploads/origins/fc590ba5-8658-44d7-90f7-9c996224baf5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f1db145158a80af56bc85550d53d92f4", "srcset": "https://si.imgix.net/25030bba/uploads/origins/fc590ba5-8658-44d7-90f7-9c996224baf5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f1db145158a80af56bc85550d53d92f4, https://si.imgix.net/25030bba/uploads/origins/fc590ba5-8658-44d7-90f7-9c996224baf5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=acf213382acd0224b216d79096cd502c 2x, https://si.imgix.net/25030bba/uploads/origins/fc590ba5-8658-44d7-90f7-9c996224baf5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=5e5be0923d92eeb8ce3328041d53c4c6 3x"}, "body": "うなどん先生、はじめまして。\n\n突然ですみませんが、ブルーアーカイブの栗村アイリ（バンド）のえっちな絵を依頼したくお願いいたします。\n\nシチュエーションは、アイリちゃんにちんちんをおくちで気持ちよくされて、先生のちんちんを咥えずに亀頭の穴、尿道口を舌先をつぷつぷと尿道口に挿れたまま優しくぐにぐにと尿道の中をほじくって射精を促すような尿道責めフェラをしてくれるえっちな絵をお願い致します。\n\n◆希望\n・アイリちゃんの衣服は着服\n・コマ割で亀頭の中の断面図\n・フルカラー\n・射精差分（可能であれば）\n・イラストの構図はこちらのリンクを参考にお願いいたします。\nhttps://www.pixiv.net/artworks/113650428\n\nその他の細かい部分はお任せいたします。\n\nお気に召さなかった場合はキャンセルしても構いません。\n\n誠に勝手な依頼ではございますがご検討の程、\nよろしくお願いいたします。\n\nhttps://x.com/Blue_ArchiveJP/status/1781925860293087463?t=OM0gkY4R6iKhZjv6THPO5g&s=19", "nc": 40, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Unadoom/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 653199, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/7ebc843d/uploads/origins/de460daa-f755-4f00-93d2-194fc93bb68a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=76299b4e76313e2c2c61e9b553ceb9db", "srcset": "https://si.imgix.net/7ebc843d/uploads/origins/de460daa-f755-4f00-93d2-194fc93bb68a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=76299b4e76313e2c2c61e9b553ceb9db, https://si.imgix.net/7ebc843d/u