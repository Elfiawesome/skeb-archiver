す。\n\n身長：168cm\nイメージカラー：黄色・青\n\n優しくてマイペースなふんわりとした性格。\n多くの名声と共にこの世を去った親の背中を追い続けてきたが、父と同じ景色を見ることなく早々にレースを引退。\nその後は自分が自分らしくあれる場所を見つけ、仲間と新たな夢に向かって走り続けている。\n同居人の少女に振り回されつつも楽しい日々を過ごしている。\n\n✤髪の毛について\nボブではなく後ろでお団子にしています。\nヘアアレンジのイメージ画像をドライブに保存しているのでご参考ください。\n\n✤衣装について\n複数種類ございますのでお好みのものをお選びください。\n\n✤耳・尻尾について\n耳は馬耳のみで、人耳はありません⚠️\n服に隠れていますが髪色と同じ、馬のしっぽが生えています。\n\n\nキャラクターシートもドライブに同梱しておりますので、こちらもご参考下さい。\n\n\nよろしくお願い致します🍒\n\nhttps://drive.google.com/drive/mobile/folders/1i-CKhuokPUaatw2ZHQyxMn4KD4ihcarX", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}], "sent_works": [{"path": "/@yumemiya_saya/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3655065, "client_id": 3757830, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/dc915dd1/uploads/origins/643e3b68-3bd5-4c25-a128-4b4166bff503?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fb61a8935d0a298b115069f4cab25552", "srcset": "https://si.imgix.net/dc915dd1/uploads/origins/643e3b68-3bd5-4c25-a128-4b4166bff503?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fb61a8935d0a298b115069f4cab25552, https://si.imgix.net/dc915dd1/uploads/origins/643e3b68-3bd5-4c25-a128-4b4166bff503?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=babc20127a06fedda89c314d50c8c687 2x, https://si.imgix.net/dc915dd1/uploads/origins/643e3b68-3bd5-4c25-a128-4b4166bff503?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d20badcb2b1b838fe3d324485e75b660 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/dc915dd1/uploads/origins/643e3b68-3bd5-4c25-a128-4b4166bff503?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c5dbddbb6b6544f1bfb92edc867acd02", "srcset": "https://si.imgix.net/dc915dd1/uploads/origins/643e3b68-3bd5-4c25-a128-4b4166bff