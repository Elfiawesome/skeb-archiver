て販売させていただきたいです。\n・配信や動画のサムネイル（Twitch、Youtube）\n・メンバー用テーブルクロスダウンロード\n・SNS上での宣伝\n(トリミングや文字の被せなど、イメージを損なわない範囲での加工をお許しいただけますと幸いです❤)\n\n✔その他\n・背景透過あり、または背景から分離されたPSDファイル\n\n✔キャラクターデザイン：https://drive.google.com/drive/folders/1TXrABO7bd7OmQBEpWr-q27EOIjuZIa0C?usp=drive_link\n＊Nonosaはコーデが自由自在の普通の学生です。先生が要素を思いつかない場合は、他の服からインスピレーションを得ても構いません。\n＊黒髪を保つのであれば問題ございません。他は自由に変更してください。\n\n先生が楽しんで描いていただけると嬉しいです✧*｡٩(ˊᗜˋ*)و✧*｡\n\n🎀\n\nスケジュールが合わなく場合は、\n遠慮なくキャンセルして頂いて構いませんので、是非ご検討の程よろしくお願い致します！\n何があってもお疲れ様でした！", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@dancing_ebiten/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3833447, "client_id": 3497651, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/ee8c7cfb/uploads/origins/51c6c1f5-f160-43e2-bb8d-70dc6bcacf60?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7a9050e82be4ac6f44e14ff1cbe57f03", "srcset": "https://si.imgix.net/ee8c7cfb/uploads/origins/51c6c1f5-f160-43e2-bb8d-70dc6bcacf60?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7a9050e82be4ac6f44e14ff1cbe57f03, https://si.imgix.net/ee8c7cfb/uploads/origins/51c6c1f5-f160-43e2-bb8d-70dc6bcacf60?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c6e6c28c13faf0f80deb28ec7bdb5165 2x, https://si.imgix.net/ee8c7cfb/uploads/origins/51c6c1f5-f160-43e2-bb8d-70dc6bcacf60?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=adddca6385c5169d476f110efa43e3b8 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/ee8c7cfb/uploads/origins/51c6c1f5-f160-43e2-bb8d-70dc6bcacf60?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=28f4422de09f7b7a9c40b68019c7c43c", "srcset": "https://si.imgix.net/ee8c7cfb/uploads/origins/51c6c1f5-f160-43e2-bb8d-70dc6bcacf60?bg=%23fff&au