ください。\n\n2. シママ\n\n【シーン】\nパート1：\nトウコは後ろからシママに尾行されていることに気づきます。トウコは苛立った表情をしています。\nシママはトウコの体に魅了され、勃起しています。\n\nパート2：\nトウコはシママと激しいセックスをしています。 シママはトウコを妊娠させようと必死になっている。\nトウコは苛立ちながらも快楽に浸った表情をしている。\n\nパート3：\nセックスの後、トウコはシママに「お掃除フェラ」をしている。\nトウコの表情はよりリラックスし、愛おしそうな表情になっている。\n\n参考画像をいくつか添付しましたが、厳密に再現する必要はありません。 \n描く際の負担を軽減するため、ポーズや表情など、自由に変更して構いません。\n\nありがとうございます\n\nhttps://drive.google.com/drive/folders/1adonYoGsDgXgyIwv3sA_u20YOJQFzalN?usp=sharing", "nc": 48, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@hamo03_X/works/3", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/c9027665/uploads/origins/53868057-befd-488a-871a-87972b1264c3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=b186b09cf942f252c04ae67677aefc4f", "srcset": "https://si.imgix.net/c9027665/uploads/origins/53868057-befd-488a-871a-87972b1264c3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=b186b09cf942f252c04ae67677aefc4f, https://si.imgix.net/c9027665/uploads/origins/53868057-befd-488a-871a-87972b1264c3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=9b1dc7d701af42a8b53aff6ece4bac9c 2x, https://si.imgix.net/c9027665/uploads/origins/53868057-befd-488a-871a-87972b1264c3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=29420cacf05328680ad1d733b0e7e1bf 3x"}, "private": true, "genre": "art", "tipped": true, "creator_id": 3669615, "nc": 32}, {"path": "/@hamo03_X/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3669615, "clien