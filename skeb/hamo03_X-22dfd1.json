自信家なタイプです。\n\n彼らは、背が高く、巨乳で、力強そうな2人のアマゾネスに出会います。1人は荒々しい風貌の日焼けした筋肉質の女性、もう1人は穏やかなアルビノの女性です。\n\n彼らはフェロモンの匂いを嗅ぎ取り、互いに興味を抱く。一方、2人の女性も彼らの長い青いペニスに興奮する。\n\n交尾が行われ、2人のアマゾンは妊娠し、満足した様子で、垂れ下がったペニスを握りしめながらパートナーを身ごもる。\n\n--- 参考：\nhttps://drive.google.com/drive/u/0/mobile/folders/13FKxamHS8citywZBYU2CautAbfm_DQcV?sort=13&direction=a\n\nhttps://drive.google.com/drive/u/0/mobile/folders/13FKxamHS8citywZBYU2CautAbfm_DQcV?sort=13&direction=a", "nc": 49, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@hamo03_X/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3669615, "client_id": 335424, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/fadb22e4/uploads/origins/f2ac9a84-be42-4808-84ae-9e5ff4d1879b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e7be36a7ea47ca7c122d07c54c6e1aca", "srcset": "https://si.imgix.net/fadb22e4/uploads/origins/f2ac9a84-be42-4808-84ae-9e5ff4d1879b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e7be36a7ea47ca7c122d07c54c6e1aca, https://si.imgix.net/fadb22e4/uploads/origins/f2ac9a84-be42-4808-84ae-9e5ff4d1879b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=7df360adba7be847b403cbeecbe88b49 2x, https://si.imgix.net/fadb22e4/uploads/origins/f2ac9a84-be42-4808-84ae-9e5ff4d1879b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=07a74367be10a6738bde95d7eb2fd57f 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/fadb22e4/uploads/origins/f2ac9a84-be42-4808-84ae-9e5ff4d1879b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=aa7d5c1fb31cb9bfe27451d7e8d2eb78", "srcset": "https://si.imgix.net/fadb22e4/uploads/origins/f2ac9a84-be42-4808-84ae-9e5ff4d1879b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=aa7d5c1f