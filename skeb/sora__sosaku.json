=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2e17141fd42a8759b2e7bca5c4b1feab", "src_set": ""}, "body": "こんにちは、そら！\n\n今度Vtuberになるのですが、SNSで使うプロフィール画像に興味があります。まだ初心者なので、vTube Studioのvtuberのイメージしかないので、大丈夫だと思います！\n( https://imgur.com/a/DFklKT2 )\n\n彼はほとんどエルフですが、少量のコボルドを持っています。彼は支配的な性格で、一般的にとても口がうまいと思われている。小鬼の一面を考えると、少しやんちゃでもある。誰かを慌てさせ、その瞬間を大切にしているような、にやにやした笑みを浮かべてほしい。\n\nお時間をいただきありがとうございました！", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@sora__sosaku/works/22", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3069169, "client_id": 2011777, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/2be3c262/uploads/origins/08b375d5-e6fa-4ec0-90db-97a46996ea9e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7b9ccd1ed0762e90cbdcf93318306f05", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/2be3c262/uploads/origins/08b375d5-e6fa-4ec0-90db-97a46996ea9e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=8e430e69470d9d545d75fc25eb207314", "src_set": ""}, "body": "ソラ 様\n\n先日はありがとうございます。甕下星辰です。\n\n今回は拙宅の榮美里のイラストをお願いしたいと思います。\n\n希望と致しましては母性が深く包みこむような感じ＆情が深すぎてヤンデレ的になっているような表情で描いて頂けたらありがたく思います。\n(可能ならば以前にお願いした六連のイラストと対になるようにお願いします)\n\n納品後は前回と同じくXなど他サイトにてSKEBでの依頼を明記・ソラ様のIDを記載の上で紹介させて頂きたく思います。\n\nよろしくお願い致します。\n\nhttps://www.pixiv.net/artworks/112849275", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@sora__sosaku/works/21", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3069169, "client_id": 2735288, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/5191c6e7/uploads/origins/9d44df9c-b6eb-4e69-a777-eb07617eb392?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c24d3df2ecfb334c3d0237599f227ed6", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/5191c6e7/uploads/origins/9d44df9c-b6eb-4e69-a777-eb07617eb392?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=39c39a2bf4f91167f94f8c67c6064132", "src_set": ""}, "body": "空さん、こんにちは。私のキャラクターの名前はルーシー。ヤギとヘビの要素を持つ陽気な女の子です。  大きなヤギの耳と毛むくじゃらの腕。尻尾はガラガラヘビ。尻尾は実際のヘビに変形することもできる。好きなほうを使ってください。参考資料1の代わりに、赤いクロップトップを着てほしい。クロップトップの上に小さなフェニックスを描いてください。参考2は彼女の角です。木でできています。満面の笑みを浮かべてほしい。歯がとがっている。また、片方の手でピースサインをしてほしい。背景は、できれば街の夜明かりがいい。そうでなければ、どんな背景でも構いません。リクエストを読んでくれてありがとう。あなたの絵はかわいいです。\n\nhttps://drive.google.com/drive/folders/1EC3dDzBn6V4ft1X5MO83m7ElrmeAflK4", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@sora__sosaku/works/20", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3069169, "client_id": 3182594, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/6265dbc2/uploads/origins/296903d4-76ed-48c2-a76c-b349a7c30b02?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0826afdc231e0fa581b2042ebbf446f2", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/6265dbc2/uploads/origins/296903d4-76ed-48c2-a76c-b349a7c30b02?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e35fca95f7fd2636491ed059b449c261", "src_set": ""}, "body": "こんにちは！リクエストを読んでくれてありがとう！<3\n\n私のキャラクター、ケーキを描いてくれたら嬉しいです！彼女は宇宙を旅する精神科の看護師です！彼女の宇宙船はパン屋、カフェ、治療センターです。\nケーキの好きなもの：ストリートファッション、ピンクの化粧品と美容製品、デザート、絵を描くこと、ホラー映画、ビデオゲーム、猫と犬！\n性格：生意気、気立てがいい、皮肉屋、カリスマ、サポート役\n\nリップグロスを塗りながら、コンパクトミラーキットを持っていたら最高！\n\n背景付きと背景なし（透過pngファイル）のファイルをいただけますか？ありがとうございます！^-^\n\nhttps://drive.google.com/file/d/19nDIs4YNxknt1AQydl36yMCyDJMN-j4B/view?usp=sharing\n\nhttps://drive.google.com/file/d/19nDIs4YNxknt1AQydl3