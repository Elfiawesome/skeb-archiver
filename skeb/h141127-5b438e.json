b2a9-a0e8975d8cfb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=7777437ba2cd5aefc7e83d9b40d032bc 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/1e9d3dd5/uploads/origins/75de8f95-71c0-4295-b2a9-a0e8975d8cfb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e730dde9fb4ecc88d73c658a252bd9f9", "srcset": "https://si.imgix.net/1e9d3dd5/uploads/origins/75de8f95-71c0-4295-b2a9-a0e8975d8cfb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e730dde9fb4ecc88d73c658a252bd9f9, https://si.imgix.net/1e9d3dd5/uploads/origins/75de8f95-71c0-4295-b2a9-a0e8975d8cfb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=26472a7dc848f47205988d167d92d0ee 2x, https://si.imgix.net/1e9d3dd5/uploads/origins/75de8f95-71c0-4295-b2a9-a0e8975d8cfb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=0f8935333187c08bb9b22fe703533ef1 3x"}, "body": "天野シロ様\n \nはじめまして。天野シロ先生の一ファンのGと申します。 スケブのご依頼が募集中になっておりましたので思い切ってリクエスト送らせて頂きました。\n\n私は中学生のころ「聖剣伝説レジェンドオブマナ」を兄から貸り、あまりに好きな絵柄とシリアス展開に挟まれる癒しのギャグに衝撃を受けてからから一番好きな漫画家を聞かれたら必ず　天野シロ先生です　と答えております。\n\n先生の描く絵にはいらない線が一つもなく、スッキリとしていながらもキャラクターの喜怒哀楽が心にダイレクトに飛び込んでくる表現力があり魅力的でずっと憧れです。\n\n私は趣味で絵を描いておりますが、大好きな天野先生の漫画や絵を見るたび「これが私の好きな世界だ！」と感じ元気をもらい、先生のような生きいきとしたキャラクターを描く事を目指して今日まで楽しく絵を描いてきました。 \nいつかこの思いを伝えたいと思っておりましたのでこの場を借りて伝えさせていただきました。本題前に私情の長文を送り申し訳ございません。 \n\nリクエストですが、もし可能であれば某漫画に出演されている「薄田　士鳶」さんをお願いしたいです。\n私は天野先生の描く、不思議キャラ・ボケキャラ・金髪キャラ（もし金髪でなければ先走ってしまいすいません…）が大好きなのですが、まさか更に私の個人的爆萌ポイント「眼鏡」「作業着（を、着るであろう職種）」の方が先生のキャラで現れるとは思ってもみませんでした。(萌という言葉はLOMで知りました)  \n\n完全に一目惚れをしてしまい、次の登場を待たずにこのようにリクエストを送っております。 \nまだ薄田さんにつきましては巨大なふ菓子を持ち歩いている方という情報しかないため、こちらは私の勝手な妄想になりますが、もしお願いできるのであれば\n  「作業着を着て汗を流し頬などに少し埃汚れがある薄田さんが、休憩中にふ菓子又は不思議な食べ物を食べこちらを見て笑っている」 \n姿をリクエストしたいです。\n私自身作業場で働く職種についておりますので、叶うのであれば薄田さんのイラストを待ち受けにして仕事を頑張りたいと思います。 \n\n某漫画は先生名義では発表されていないので、もし難しいようでしたら「SCRATH！」のキャラクターをお願いしたいです。 乾賢くんかわいいです…！\n\nどうぞよろしくお願い致します。\n\nG", "nc": 152, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@h141127/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3129213, "client_id": 2376, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/8f4fc565/uploads/origins/06a9b298-de94-478e-a873-afde0df12906?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c3fb3317484ec17ce0bf12ab61897c31", "srcset": "https://si.imgix.net/8f4fc565/uploads/origins/06a9b298-de94-478e-a873-afde0df12906?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c3fb3317484ec17ce0bf12ab61897c31, https://si.imgix.net/8f4fc565/uploads/origins/06a9b298-de94-478e-a873-afde0df12906?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=19bd64372ca98457d21b91fe4e34a4bf 2x, https://si.imgix.net/8f4fc565/uploads/origins/06a9b298-de94-478e-a873-afde0df12906?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a32a84a57bad1be2f43ae401a6383e9b 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/8f4fc565/uploads/origins/06a9b298-de94-478e-a873-afde0df12906?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=44005fe7beec1d06535c74e5d7869098", "srcset": "https://si.imgix.net/8f4fc565/uploads/origins/06a9b298-de94-478e-a873-afde0df12906?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=44005fe7beec1d06535c74e5d7869098, https://si.imgix.net/8f4fc565/uploads/origins/06a9b298-de94-478e-a873-afde0df12906?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=ecdec70828f3b8eeac88b3b0b5e396fe 2x, https://si.imgix.net/8f4fc565/uploads/origins/06a9b298-de94-478e-a873-afde0df12906?bg=%23fff&auto=format%2Ccompress&fm=w