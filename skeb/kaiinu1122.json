ve.google.com/drive/folders/12YJ1-uparnq_s7hCfYaCiP4sSk9bZMpW?usp=sharing\n\nご検討いただけますと幸いでございます。\nどうぞよろしくお願いいたします。", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@kaiinu1122/works/71", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2807241, "client_id": 2741499, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/a225b25a/uploads/origins/2b80ca10-01cd-4568-8831-c9702bcc089a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fcb2d721b5085fb8361de053443fe383", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/a225b25a/uploads/origins/2b80ca10-01cd-4568-8831-c9702bcc089a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=643a311f6d52fb6faff420eec63d4cf3", "src_set": ""}, "body": "こんにちは！アピールしてくれてありがとう！\n私のOC、ラッキーに興味を持ってくれてとても嬉しかったです！\nどうぞ、ご自由にお描きください！\n\nhttps://drive.google.com/drive/folders/1Ct3Z5b-3OV9UMUd1wYo-vEUdQs151YI6?usp=sharing", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@kaiinu1122/works/70", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2807241, "client_id": 0, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/86bd9959/uploads/origins/652c2596-4f1b-40d9-bc72-05a127832b8f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8054a6a7216cf7eb02020d2a0af91401", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/86bd9959/uploads/origins/652c2596-4f1b-40d9-bc72-05a127832b8f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=86d0edd833bc6f078048a621c5d0e54b", "src_set": ""}, "body": "アピールありがとうございます。\nキャラクターに興味をもっていただきありがとうございます。\n\nアピール元と同様の女