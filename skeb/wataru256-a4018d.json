長さがあるストレートの長髪で肌は白色です。目は右が黒色の義眼、左が赤色で右目は前髪で隠しています。\n口にスクランパーのピアスをしていて牙のようになっています。\nシーンの時間帯的には夜、ナイフを持っていて戦闘中で返り血を浴びているようなイメージでお願いしたいです！\n表情に乏しいキャラなのであまり表情がない感じだと嬉しいです。\n\n※資料はリンク先をご参照くださいますと幸いです。服装や小物などデザインはアレンジいただいて大丈夫です！\n\nお忙しいところ失礼しますがご検討くださいますと幸いです。よろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/1LbGSmiQmdNRA5mPULMr3SMtubrfhFMvy", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@10den/works/117", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 15236, "client_id": 543103, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/a2c042c5/uploads/origins/676d5ca7-0d78-409e-a0cb-26414b83e51f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9bc920df1bb584efb453a8f5aa42e532", "srcset": "https://si.imgix.net/a2c042c5/uploads/origins/676d5ca7-0d78-409e-a0cb-26414b83e51f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9bc920df1bb584efb453a8f5aa42e532, https://si.imgix.net/a2c042c5/uploads/origins/676d5ca7-0d78-409e-a0cb-26414b83e51f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=dea0ab0f421d4322683a16e30d7e94f9 2x, https://si.imgix.net/a2c042c5/uploads/origins/676d5ca7-0d78-409e-a0cb-26414b83e51f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f101eeb71869a43973261af3ebc84dfd 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/a2c042c5/uploads/origins/676d5ca7-0d78-409e-a0cb-26414b83e51f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=8736449b183f3312cfe4f29d1b3351c5", "srcset": "https://si.imgix.net/a2c042c5/uploads/origins/676d5ca7-0d78-409e-a0cb-26414b83e51f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=8736449b183f3312cfe4f29d1b3351c5, https://si.imgix.net/a2c042c5/uploads/origins/676d5ca7-0d78