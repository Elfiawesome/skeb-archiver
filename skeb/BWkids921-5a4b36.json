pplies and support.\nHideto, Shakuto, and Hideto are cheerful and friendly,\nMametou is timid and runs away,\nLing Dou is moody, but he wants to get the job done quickly, so he will concentrate on it.\nI would like to ask for your help if you have extra power within the range of the amount.\n\nI am attaching the documents for your review.\nI look forward to working with you.\n\nhttps://www.dropbox.com/scl/fo/jv06k03mo0yfuhk2mfots/ABbUS_ZXwvH8UnqImEa-6EM?rlkey=hhrmpdagu070thergsg953fok&st=j88wm4d6&dl=0", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@kuro96ya/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3414646, "client_id": 1543266, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/ad530db0/uploads/origins/d4dfbc4e-ae32-4409-8bdb-2595075a1247?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0437aa0a6ba0bbe6dbeabbbd7ba09095", "srcset": "https://si.imgix.net/ad530db0/uploads/origins/d4dfbc4e-ae32-4409-8bdb-2595075a1247?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0437aa0a6ba0bbe6dbeabbbd7ba09095, https://si.imgix.net/ad530db0/uploads/origins/d4dfbc4e-ae32-4409-8bdb-2595075a1247?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=48fcdc5e3dd55a12c165a7552219bd9e 2x, https://si.imgix.net/ad530db0/uploads/origins/d4dfbc4e-ae32-4409-8bdb-2595075a1247?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=32801c9192dd51d3c978340ae64bbfc8 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/ad530db0/uploads/origins/d4dfbc4e-ae32-4409-8bdb-2595075a1247?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f6b67a789c1e0f0ade2e23dcad003afb", "srcset": "https://si.imgix.net/ad530db0/uploads/origins/d4dfbc4e-ae32-4409-8bdb-2595075a1247?bg=%23