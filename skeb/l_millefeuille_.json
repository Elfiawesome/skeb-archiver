f&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a45fad89c39bfd6a2c5b017b88fa7aa8", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/cb860b60/uploads/origins/947eece3-a605-49b8-a175-0dfc69d12140?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=dbea64a7df13a4e6e4003f605a4a0fbe", "src_set": ""}, "body": "please draw my character, ill leave clothing, pose and expression up to you\n服装は自由に変えてください。\n※イラストはSNSへの掲載・ツイッターでの利用を考えています\n\nhttps://imgur.com/a/piQxjM3", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@l_millefeuille_/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3606116, "client_id": 3069567, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/7ec4908a/uploads/origins/611b570f-85e9-495d-b25d-2ddeba13c212?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6eef12d97532c2886a88bc7af659258f", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/7ec4908a/uploads/origins/611b570f-85e9-495d-b25d-2ddeba13c212?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a48ed3c8230d67b7da07b9a2039b9167", "src_set": ""}, "body": "先生へ\n突然のご連絡失礼いたします。先生の作風が大変素敵で、ツイッターで募集を見かけた瞬間、すぐに駆けつけました。\nお願いしたいのは私のオリジナルキャラクターで、いたずら好きでずる賢い食いしん坊の狐娘です。大人の知性を持ちながら、あえて子供っぽい振りをするのが特徴です。\n可能であれば「微笑み」と「穏やか」の2種類の表情バリエーションを追加していただき、最終納品はPSD形式でお願いできれば幸いです。\nhttps://drive.google.com/drive/folders/1ysOV-7llhOEfP7y26zhp8fhocP-_UNw8?usp=sharing", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@l_millefeuille_/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3606116, "client_id": 846811, "vtt_url": null,