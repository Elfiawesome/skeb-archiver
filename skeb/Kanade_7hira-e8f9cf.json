本人様サイトからの注意点やお願い＞\n以下ご本人様サイトからの文章コピーになります。\n依頼をする際には、このページへのリンクまたはFANBOXのリンクを共有したのち蓮希るいのTwitterや収益化されたYoutubeチャンネルで使用される可能性があること」を依頼文で必ず伝えてください。\n\n▼skebまたは依頼したイラスト\npsdファイル/背景透過ファイルがあると嬉しいです。\nイラストレーター様に依頼していただいたイラストは活動面（サムネイル）で使用できるのでとても嬉しいです！\n\nイラストレーター様にご依頼の際は、二次創作プログラム承認済みですので「蓮希るい」の名前を使用して許可済みだということをお伝えください。\n\n長くなってしまいましたがぜひご検討のほどよろしくお願い致します！\n\nhttps://lit.link/Hasukirui", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Kanade_7hira/works/8", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3745571, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/2d91c70f/uploads/origins/8ab84f8f-557a-44b6-b9ba-d47dd2768e5b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=836a80cdbd476777ae38cfb03d0c5779", "srcset": "https://si.imgix.net/2d91c70f/uploads/origins/8ab84f8f-557a-44b6-b9ba-d47dd2768e5b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=836a80cdbd476777ae38cfb03d0c5779, https://si.imgix.net/2d91c70f/uploads/origins/8ab84f8f-557a-44b6-b9ba-d47dd2768e5b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=99910f71583baefb1df2af21e4232ac6 2x, https://si.imgix.net/2d91c70f/uploads/origins/8ab84f8f-557a-44b6-b9ba-d47dd2768e5b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=90b2c6e9372f4ee0a3db996e9da54194 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/2d91c70f/uploads/origins/8ab84f8f-557a-44b6-b9ba-d47dd2768e5b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c9708a9e9c06b0155a22cddfb8b49964", "srcset": "https://si.imgix.net/2d91c70f/uploads/origins/8ab84f8f-557a-44b6-b9ba-d47dd2768e5b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c9708a9e9c06b0155a22cddfb8b49964, https://si.imgix.net/2d91c70f/u