す出産の擬音、射精等の効果音や各キャラの瞳のハイライトと顔上部に掛かる影の有無差分と\n優先度低OKで女性キャラ出産後とは別に出産途中として、M男のアナルから魔神化イプシロン(イリア)の片腕だけ這い出す切替可能差分及び射精の有無切替差分希望\n更に可能なら快楽のために擬態肉塊妖魔を孕み産み落とすだけの苗床として自らアナルを捧げ、男の癖に妊娠した挙句マゾ出産射精し、次の肉塊卵に射精して受精させる設定&内容で、イプシロンはマゾ男のことを主様呼びで丁寧口調、イリアは母親っぽい口調希望で、出産した娘たちにより最終的に全世界の男はアナルで女体を出産する苗床へ変貌するという説明に興奮するM男を侮蔑し、老いも死も赦されず苗床として大好きな超乳&ボテ腹美少女ばかり永遠に孕ませてあげます、と変態マゾ男を嫌悪感MAXで罵倒・侮蔑する内容の台詞有無差分\n\nhttps://drive.google.com/drive/folders/1pikNQX0vCKyVFjM-GaZGXbPZojD6z7_Y?usp=sharing", "nc": 186, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 4422, "creator": true, "nsfw_acceptable": true, "acceptable": false, "name": "p_grgk__", "screen_name": "_grgk", "avatar_url": "https://abs.twimg.com/sticky/default_profile_images/default_profile.png", "header_url": null, "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 120, "skills": [{"genre": "art"}, {"genre": "correction"}], "banned": false, "nc": 48}, {"id": 53179, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "照井聖", "screen_name": "teruihijiri", "avatar_url": "https://proxy.misskeyusercontent.jp/avatar.webp?url=https%3A%2F%2Fmedia.misskeyusercontent.jp%2Fio%2Ffe84a6ed-f0df-4883-bd07-1d8464c096a2.png&avatar=1", "header_url": null, "appeal_receivable": true, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "none", "accept_expiration_days": 7, "complete_expiration_days": 77, "skills": [{"genre": "art"}], "banned": false, "nc": 49}, {"id": 67321, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "雅　海　藻🔞🗿💀", "screen_name": "miyabinori07", "avatar_url": "https://pbs.twimg.com/profile_images/1610074633725956096/q6qaSc2g.jpg", "header_url": "https://pbs.twimg.com/profile_banners/86852573