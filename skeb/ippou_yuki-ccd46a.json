緋色ではなく、青色系や黄色辺りでお願いします。\n構図等はお任せいたします。\n\n可能でしたら、髪や体の一部、衣装などが途中で横に切れないように描いていただきたいです。\n\n立ち絵にあるように私の髪が白くてとても長く、毛量が多いのでその辺りを意識していただけると幸いです。\n※身長は140cmです。\n\n\n【使用用途】\nTwitterへの掲載、アイコンとしての使用、YouTube活動におけるサムネなどを考えております。\nまた、サムネ等へ使用できるように背景透過のデータ(レイヤー分けされたpsdファイルなど)もいただけると幸いです。\n\nご検討よろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/14O3evcYwc7AewEPeyJwDsgUNS6QXiSCx?usp=drive_link", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@ippou_yuki/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2428401, "client_id": 1872024, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/cdc27576/uploads/origins/9843529c-d67f-4116-985a-a2b4ff6148d9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=de960557be64ddfcc5d148adacd9fc91", "srcset": "https://si.imgix.net/cdc27576/uploads/origins/9843529c-d67f-4116-985a-a2b4ff6148d9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=de960557be64ddfcc5d148adacd9fc91, https://si.imgix.net/cdc27576/uploads/origins/9843529c-d67f-4116-985a-a2b4ff6148d9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=bb4347719f246caf4cb3050ce0cd62e8 2x, https://si.imgix.net/cdc27576/uploads/origins/9843529c-d67f-4116-985a-a2b4ff6148d9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=9078d120d8435883e9250161efcd89a0 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/cdc27576/uploads/origins/9843529c-d67f-4116-985a-a2b4ff6148d9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=760fa6322b029d5603a9549296a10b20", "srcset": "https://si.imgix.net/cdc27576/uploads/origins/9843529c-d67f-4116-985a-a2b4ff6148d9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=760fa6322b029d5603a9549296a10b20, https://