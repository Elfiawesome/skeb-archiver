origins/49a91df2-778b-48ba-ac61-5ce924721620?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c5ae1311833be6be1a66a3bc2380775f, https://si.imgix.net/74e47490/uploads/origins/49a91df2-778b-48ba-ac61-5ce924721620?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=26b8b8dc58ff408cfa6a9ef7e037da39 2x, https://si.imgix.net/74e47490/uploads/origins/49a91df2-778b-48ba-ac61-5ce924721620?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=7d17f1a0972092d53226b26833227adb 3x"}, "body": "こんにちは、前回の太り気味ホムラちゃんありがとうございました！\nとってもむちむちになってて可愛かったです...！\n今回ですが、そんなホムラちゃんの続きというシチュエーションでもう一枚リクエストをお願いします！\n\n「まんまるおなかのホムラ」\n・その後夕飯やデザートを夢中で沢山食べ過ぎてお腹がまん丸に膨らんでしまうホムラ\n・両手でパンパンに丸く膨らんだお腹をさすり、「げふぅっ、明日からダイエットしなくちゃ...」とついゲップしながら満腹で苦しそうにしている\n・元々太っていたお腹周りが大きくなり、服装が限界になっている(前回ギチギチだったのが、お腹が丸くなってよりみちみちに...というイメージです)\n\n以上です。\n前回ぷにぷにに太ってしまったホムラちゃんですが、今回はいっぱい食べてお腹パンパンな彼女を描いていただきたいです！", "nc": 49, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@otama_ladle23/works/8", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3467991, "client_id": 3194157, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/ced466ed/uploads/origins/a80d2f16-1c3d-439f-8579-4c3cbf7dcb79?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=21eb8b78fa5862ff7081f5afd3454f67", "srcset": "https://si.imgix.net/ced466ed/uploads/origins/a80d2f16-1c3d-439f-8579-4c3cbf7dcb79?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=21eb8b78fa5862ff7081f5afd3454f67, https://si.imgix.net/ced466ed/uploads/origins/a80d2f16-1c3d-439f-8579-4c3cbf7dcb79?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c06b1c5715701e820b71f8aec3aad59e 2x, https://si.imgix.net/ced466ed/uploads/origins/a80d2f16-1c3d-439f-8579-4c3cbf7dcb79?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=309af0aca77d2b6ad0491de412be4928 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/ced466ed/uploads/origins/a80d2f16-1c3d-439f-8579-4c3cbf7dcb79?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d7f739dcdf5f2805d8de3e1a7c6b5b51", "srcset": "https://si.imgix.net/ced466ed/uploads/origins/a80d2f16-1c3d-439f-8579-4c3cbf7dcb79?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d7f739dcdf5f2805d8de3e1a7c6b5b51, https://si.imgix.net/ced466ed/uploads/origins/a80d2f16-1c3d-439f-8579-4c3cbf7dcb79?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=b6a6b16cae48d3cbce8edd1aba95c189 2x, https://si.imgix.net/ced466ed/uploads/origins/a80d2f16-1c3d-439f-8579-4c3cbf7dcb79?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=938d93af4291f2bf51660da79c5ffa31 3x"}, "body": "こんにちは！『ゼルダの伝説』シリーズのキャラクター、リンクルを描いていただけませんか？彼女は養鶏場で暮らす、元気いっぱいのヒロインです。リンクルはブロンドの髪に青い瞳、そしてツインテールが特徴です。\n草むらで横向きに寝転がっているリンクルを、後ろから描いていただけると嬉しいです。青い「チャンピオンのチュニック」を着ていて、ズボンやブーツは履いていない状態で、シャツからは大きなお尻がのぞいているようにしてください。また、視聴者の方を振り返り、遊び心のある表情を浮かべている様子にしてください。\n\nリンクルの参考画像はこちらです：\nhttps://drive.google.com/drive/folders/10U3YiZWDgXATT3iT9svNu9G7oCVSfU9E\n\nそして、彼女の青い「チャンピオンズ・チュニック」の衣装の参考画像はこちらです：\nhttps://drive.google.com/drive/folders/19us-xOCitcZSkReq3e9pfgXdqgWkyuhv\n\nご検討いただきありがとうございます！\n\nhttps://drive.google.com/drive/folders/10U3YiZWDgXATT3iT9svNu9G7oCVSfU9E", "nc": 176, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@otama_ladle23/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3467991, "client_id": 586774, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/4acfcf44/uploads/origins/fa455f1a-c959-4d98-a473-660e7fad783e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=dc367a9f92d0d2fa6fa54d9afc28f5ff", "srcset": "https://si.imgix.net/4acfcf44/uploads/origins/fa455f1a-c959-4d98-a473-660e7fad783e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=dc367a9f92d0d2fa6fa54d9afc28f5ff, https://si.imgix.net/4acfcf44/uploads/origins/fa455f1a-c959-4d98-a473-660e7fad783e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=962159407a488397381463b8c542d4d7 2x, https://si.imgix.net/4acfcf44/uploads/origins/fa455f1a-c959-4d98-a473-660e7fad783e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=23b1732684457d4102889ca3e2e0dbfd 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/4acfcf44/uploads/origins/fa455f1a-c959-4d98-a473-660e7fad783e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=80b2c40999c52a30cbd9c98a687a3a48", "srcset": "https://si.imgix.net/4acfcf44/uploads/origins/fa455f1a-c959-4d98-a473-660e7fad783e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=80b2c40999c52a30cbd9c98a687a3a48, https://si.imgix.net/4acfcf44/uploads/origins/fa455f1a-c959-4d98-a473-660e7fad783e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=15622275e5c1eb47ffa92d5977a63501 2x, https://si.imgix.net/4acfcf44/uploads/origins/fa455f1a-c959-4d98-a473-660e7fad783e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=9bd43a40d793890b9f24b023987ae929 3x"}, "body": "こんにちは、今回初めてのリクエストをお願いします！\n先日から貴方の可愛いホムラちゃんのイラストを拝見しておりまして、是非彼女でみたいシチュエーションを思いつきましたので、今回はそちらをリクエストさせていただきたいです。\n\n・衣装は2の通常衣装でお願いします\n・最近少し食べ過ぎてしまい、お腹と太ももがむっちりとなる程太ってしまったホムラ\n・ぷにぷにに膨らんだお腹を摘んで、危機感を募らせている様子\n・頰にもちょっとお肉がついてふっくらしている顔つきで\n・贅肉で衣装がキツそうになっていると嬉しいです\n\n以上です。\n是非ご検討よろしくお願いします！", "nc": 48, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@otama_ladle23/works/6", 