=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8f9b7ee5109f5bc46e951e67e7f6d20c, https://si.imgix.net/06e44c1e/uploads/origins/d6b0aa42-f5e5-40aa-8f70-365f95dde8ba?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=56b881f80e1ea46e32b998ea2678d2a5 2x, https://si.imgix.net/06e44c1e/uploads/origins/d6b0aa42-f5e5-40aa-8f70-365f95dde8ba?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=fe31766afb074631fa6dc13c74b4cc22 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/06e44c1e/uploads/origins/d6b0aa42-f5e5-40aa-8f70-365f95dde8ba?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=4436503c3f6be85bec4e667f09cb3931", "srcset": "https://si.imgix.net/06e44c1e/uploads/origins/d6b0aa42-f5e5-40aa-8f70-365f95dde8ba?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=4436503c3f6be85bec4e667f09cb3931, https://si.imgix.net/06e44c1e/uploads/origins/d6b0aa42-f5e5-40aa-8f70-365f95dde8ba?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=15b25b3122ad385829c9ca75499ead32 2x, https://si.imgix.net/06e44c1e/uploads/origins/d6b0aa42-f5e5-40aa-8f70-365f95dde8ba?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=bdd8a75254f00ec497d75541ba55f18b 3x"}, "body": "こんにちは！私はあなたのアートワークが大好きで、あなたに依頼したいです。私のオークはこちら：https://imgur.com/a/rDruu5J 彼女の名前はmochiで、彼女はとてもかわいくて軽薄な女の子です。私はこのような写真で彼女を見たい： https://imgur.com/a/a8SGK8C あなたのアートスタイルで。私は可能であれば、解像度を（1920×1080）でお願いします。ありがとうございます\n\nhttps://imgur.com/a/rDruu5J", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@as_sa_a_a/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2569678, "client_id": 2168110, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/904205f4/uploads/origins/225eaf0b-89ac-4db2-92fe-5d05a6fab177?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ffa92e3d9f851ddcbc7bd8a1c1251ce0", "srcset": "https://si.imgix.net/904205f4/uploads/origins/225eaf0b-89ac-4db2-92fe-5d05a6fab177?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ffa92e3d9f851ddcbc7bd8a1c1251ce0, https://si.imgix.net/904205f4/uploads/origins/225eaf0b-89ac-4db2-92fe-5d05a6fab177?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=7927d894fdec65487e4eb5a478e7249f 2x, https://si.imgix.net/904205f4/uploads/origins/225eaf0b-89ac-4db2-92fe-5d05a6fab177?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=cf8b870d49097292ff94496833e7a5ca 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/904205f4/uploads/origins/225eaf0b-89ac-4db2-92fe-5d05a6fab177?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e5b0b352804333caf3821def030dda9e", "srcset": "https://si.imgix.net/904205f4/uploads/origins/225eaf0b-89ac-4db2-92fe-5d05a6fab177?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e5b0b352804333caf3821def030dda9e, https://si.imgix.net/904205f4/uploads/origins/225eaf0b-89ac-4db2-92fe-5d05a6fab177?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=41549a50afb3eea15e9ea15810e3b7d8 2x, https://si.imgix.net/904205f4/uploads/origins/225eaf0b-89ac-4db2-92fe-5d05a6fab177?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=366d75a092a670ed234ee24525e1a396 3x"}, "body": "絵柄が素敵だったのでご依頼しました。\nダークなテイストで遊戯をテーマにうちのOCの「鮫氷しゃち」をお願いすることは可能でしょうか？ \n参考までに設定は以下のとおりですが、自由に描いていただいて構いません。\n███\n鮫氷 しゃち（さめすが しゃち）\n細身かつ色白の黒髪ロングストレート。\n白と黒を基調にしたセーラー服にセーラーキャップを着こなす。\nアイドル的な元気さと明るさに加え、清楚で可憐な容姿をしている。 \n好奇心旺盛で趣味はテーマパーク巡りと人間観察。\nかなりの偏食家で、気に入ったものはヘビロテする。その一方で飽きるのも早い。  \n親しい間柄の相手でさえ巧みに感情を操って都合よく利用する。\nその言動はどこか演技的で大げさ。\n先天的に共感性が欠落しており、一見感情のように見えるものは人間観察の結果身に着けたものでしかない。\n███\n宛名・背景はpsdでon/offできると幸いです。\n使用用途は個人活動全般(小説の挿絵等、SNSや個人サイト等でのキャラクター紹介・個人活動の告知等、コミッションでのリクエストのための参考資料等)を考えています。\nもしご都合が合えばよろしくお願いします。\n\nhttps://drive.google.com/drive/folders/15QcfblJ6ABjLUrKZ3ijKi-ncxD6c6GKd", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@as_sa_a_a/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2569678, "client_id": 2081447, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/6cc9dcce/uploads/origins/27f1363d-d7ae-4522-8bd3-07dde59621a5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=95f6da8f33ac0b68fa4820bbd0ddf263", "srcset": "https://si.imgix.net/6cc9dcce/uploads/origins/27f1363d-d7ae-4522-8bd3-07dde59621a5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=95f6da8f33ac0b68fa4820bbd0ddf263, https://si.imgix.net/6cc9dcce/uploads/origins/27f1363d-d7ae-4522-8bd3-07dde59621a5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=78b48ed8736c030d94c63301a6ca9d89 2x, https://si.imgix.net/6cc9dcce/uploads/origins/27f1363d-d7ae-4522-8bd3-07dde59621a5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=0bce44e85b94f3834412d0d63675a266 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/6cc9dcce/uploads/origins/27f1363d-d7ae-4522-8bd3-07dde59621a5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b90865e279bd17d8d069d0fe7304267a", "srcset": "https://si.imgix.net/6cc9dcce/uploads/origins/27f1363d-d7ae-4522-8bd3-07dde59621a5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b90865e279bd17d8d069d0fe7304267a, https://si.imgix.net/6cc9dcce/uploads/origins/27f1363d-d7ae-4522-8bd3-07dde59621a5?bg=%23fff&auto=format%2Ccompr