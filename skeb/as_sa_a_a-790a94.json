%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ca0d50e93936eaa0e18c4b24f9cec9e5", "srcset": "https://si.imgix.net/085fe4f9/uploads/origins/7d4207f8-31b4-4f49-a7cb-07ed9211f1db?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ca0d50e93936eaa0e18c4b24f9cec9e5, https://si.imgix.net/085fe4f9/uploads/origins/7d4207f8-31b4-4f49-a7cb-07ed9211f1db?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=a9d1c22a8712f94356eee7648ba996f2 2x, https://si.imgix.net/085fe4f9/uploads/origins/7d4207f8-31b4-4f49-a7cb-07ed9211f1db?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=c5f4a5ecce60b3caffca810790f3ed80 3x"}, "body": "Hello! Your artwork is very pretty. I particularly love your work for 黒いチューリップ. I would love if you draw my vtuber, Riri. She is a clumsy ghost girl. I would like her in a white bunny suit. Please do not include her triangle hat. Otherwise, you can choose the pose. I would like her to look a little sensual or flirty, though! You can also change her hairstyle if you want, but please keep the bangs the same as the reference picture. Also, please include a separate png of only Riri without a background, so I can use your art for my streaming promotions. Thank you so much!! <3\n\nhttps://drive.google.com/file/d/1st7oSSqu6ZEzVM-RBbPdPrVokP126gez/view?usp=drive_link", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@as_sa_a_a/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2569678, "client_id": 2081447, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/1ae85df8/uploads/origins/545d7823-89f2-4b51-9ec7-b114920b9039?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0d821b8e8bca4aa36284e83c76d88386", "srcset": "https://si.imgix.net/1ae85df8/uploads/origins/545d7823-89f2-4b51-9ec7-b114920b9039?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0d821b8e8bca4aa36284e83c76d88386, https://si.imgix.net/1ae85df8/uploads/origins/545d7823-89f2-4b51-9ec7-b114920b9039?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=0e70bcab7a01c42c5f82e1562b11b4ed 2x, https://si.imgix.net/1ae85df8/uploads/origins/545d7823-89f2-4b51-9ec7-b114920b9039?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=2e372a15a75126a18a73211de12efd4e 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/1ae85df8/uploads/origins/545d7823-89f2-4b51-9ec7-b114920b9039?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ba27ec4f7683546fb64b660d58b944d9", "srcset": "https://si.imgix.net/1ae85df8/uploads/origins/545d7823-89f2-4b51-9ec7-b114920b9039?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ba27ec4f7683546fb64b660d58b944d9, https://si.imgix.net/1ae85df8/uploads/origins/545d7823-89f2-4b51-9ec7-b114920b9039?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=3a1a81775b5032eedf0043f8a47e7312 2x, https://si.imgix.net/1ae85df8/uploads/origins/545d7823-89f2-4b51-9ec7-b114920b9039?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=5f026b1b484b063959d19db91fce1169 3x"}, "body": "あっさー様\nお久しぶりです。\n前回はとても素敵なイラストをありがとうございました。\n絵柄が本当に好みで素敵でしたので、是非またあっさー様に描いて頂きたいと思いリクエスト致しました。\n\n資料はGoogleドライブにて添付致します。\nhttps://drive.google.com/drive/folders/1BckkJ2w9rDFnaHxhoHXi1weNbK-8xcvP?usp=sharing\n\n【依頼内容】\n夏なので水着のイラストをお願いしたいと思っております。\nYoutubeのサムネイルや、メンバー限定などでスマホ壁紙配布を検討しておりますので、\n今回は縦のイラストでお願いしたいです。\n可能であれば腰上もしくは太もも上くらいのイラストで、髪の毛や手などが切れていないと助かります。\n\n【服装・構図】\n服装のイメージなどを添付することが難しかったため、\n水着やポージングはあっさー様にお任せしたいです。\n希望としては、おへそが出ているタイプ（ビキニ、ホルターネックなど）ですと嬉しいです。\n可愛い系もかっこいい系もどちらでも大丈夫です。\n元気なイメージが出ていると助かります。\n\n【背景】\n海っぽい背景、もしくは簡易的な背景、お任せ致します。\n\n【使用用途】\nVtuberとしての活動で使用致します。\n\n収益化済みのYoutubeのサムネイル、動画、コミュニティ等での使用。\nTwitterなどのSNSへの投稿等。\nメンバー限定などでの壁紙配布。\n可能であればグッズなどの商用利用。\n\n【サイズ】\nお任せ致します。\n\n【納品データ】\nキャラクターのみの透過データ（PSDでも可能）\nサインなしVerも頂けると助かります。\n\n難しい場合はリクエストをキャンセルしていただいて構いません。\n\n以上、お忙しいとは思いますがご確認のほど宜しくお願いいたします。", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@as_sa_a_a/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2569678, "client_id": 894861, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/7e60ef4e/uploads/origins/acfca9ee-e274-45fc-9222-32707d0f3994?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=18ff142c3c2ccf23741bfbb6de207f11", "srcset": "https://si.imgix.net/7e60ef4e/uploads/origins/acfca9ee-e274-45fc-9222-32707d0f3994?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=18ff142c3c2ccf23741bfbb6de207f11, https://si.imgix.net/7e60ef4e/uploads/origins/acfca9ee-e274-45fc-9222-32707d0f3994?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=bcc49ff53f1fb08497c192093c822a09 2x, https://si.imgix.net/7e60ef4e/uploads/origins/acfca9ee-e274-45fc-9222-32707d0f3994?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=050fe0a99a0da5124d9defd53394302f 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/7e60ef4e/uploads/origins/acfca9ee-e274-45fc-9222-32707d0f3994?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=85f0e87768c5e3bdeedcef2340031c0c", "srcset": "https://si.imgix.net/7e60ef4e/uploads/origins/acfca9ee-e274-45fc-9222-32707d0f3994?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=85f0e87768c5e3bdeedcef2340031c0c, https://si.imgix.net/7e60ef4e/uploads/origins/acfca9ee-e274-45fc-9222-32707d0f3994?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=ec78296a04eee918373011f343dbaa4a 2x, https://si.imgix.net/7e60ef4e/uploads/origins/acfca9ee-e274-45fc-9222-32707d0f3994?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=7cf985db4108e5f00f46790cdd545c7d 3x"}, "body": "あっさー様\n初めまして、個人Vtuberの白夜よると申します。\nお友達のイラストからあっさー様を知りました！\n構図や表情、構図がとても素敵で一目惚れし依頼したくリクエストさせていただきました！\n\n⬛︎使用用途\n・YouTubeのサムネイル(収益化済)\n・Twitter等の各種SNS\n\n⬛︎希望納品形式\n・人物(透過)と背景のデータも差分としていただけると嬉しいです。その際にサインのなしverもいただけると有難いです。\n・サムネイル等で使用させていただきたいと思っております。そのため、髪の毛や腕などが欠けないよう描いていただけると幸いです。\n\n⬛︎参考ビジュアル\n下記のURLにて参考資料を送らせていただきます。\nご確認お願い致します！\nhttps://drive.google.com/drive/folders/1-3GlYghDZOf-xd6PPW9tQe8YguVinSfP\n\n⬛︎内容\nYouTubeやTwitter等のSNSを中心にVtuber活動に使用させていただきたいと思っております！\nポーズや表情の指定は特にないのですが、八重歯・お腹・足が見えるような構図で描いていただけたらとても嬉しいです！\n背景はあっさー様のお任せでお願いできたらなと思っております！\nよろしくお願い致します。", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@as_sa_a_a/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2569678, "client_id": 2263183, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/45d94f4d/uploads/origins/321cae89-41d5-4a93-85e6-deaa4059ed42?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b13521c24a264f4b32bc3b22ee43bd92", "srcset": "https://si.imgix.net/45d94f4d/uploads/origins/321cae89-41d5-4a93-85e6-deaa4059ed42?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b13521c24a264f4b32bc3b22ee43bd92, https://si.imgix.net/45d94f4d/uploads/origins/321cae89-41d5-4a93-85e6-deaa4059ed42?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=2a36d4c5efcdc3f83e3c24d21e5d5793 2x, https://si.imgix.net/45d94f4d/uploads/origins/321cae89-41d5-4a93-85e6-deaa4059ed42?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=022c2be81d18098147e402aa5d0fa90a 3x"}, "duration": null, "nsfw": false, "hardcor