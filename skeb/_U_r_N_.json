ix.net/153b4896/uploads/origins/2bec24b4-55e3-4b21-9b6c-af05449683c3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c1db3d5f1297a24ac26ca33f72da5913 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/153b4896/uploads/origins/2bec24b4-55e3-4b21-9b6c-af05449683c3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=1e1081e7c6af210969fea8217680cf21", "srcset": "https://si.imgix.net/153b4896/uploads/origins/2bec24b4-55e3-4b21-9b6c-af05449683c3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=1e1081e7c6af210969fea8217680cf21, https://si.imgix.net/153b4896/uploads/origins/2bec24b4-55e3-4b21-9b6c-af05449683c3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=c004dd7aefabd034ab36d9d136ebaf1f 2x, https://si.imgix.net/153b4896/uploads/origins/2bec24b4-55e3-4b21-9b6c-af05449683c3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=14ab7e106aa0dbe42c16179c4d0ece57 3x"}, "body": "はじめまして！\nskebを開かれたということで飛んできました！\nいつもうらん様のイラストを拝見させていただいてます！\nよく片目が隠れているocの子を描かれていると思うのですが、どの子もすごくカッコ良かったり可愛かったりして超好きです！\n他にも、うらん様のイラストでレッシングくんを拝見した時、癖に刺さりすぎてしばらくそのイラストを眺める時間がありました！その節はありがとうございました...🙇\nぜひうらん様にうちの子を描いていただきたいです！\nどの子がうらん様の好みに合う子たちかわからないため、2人ほど候補を送らせていただきます。\nどちらでも好きな子を描いてください！\n\n・1人目\n千春(ちはる)\nあざとく人懐っこい性格で、誰とでもすぐに距離を縮めてしまう。\nただし賑やかな場よりも、少人数でゆったり過ごす時間を好むタイプ。\n気まぐれで少しいたずら好きな一面もあり、無自覚のうちに周囲を振り回してしまう小悪魔気質。\n甘いものが好きで、特に洋菓子を好む。\n\n⭐︎外見の特徴  \n＊目:右目が赤と左目が青のオッドアイ\n＊髪:水色\n＊左目の下にほくろ\n\n・2人目\n名前未定\n人間界に紛れて暮らす悪魔。普段は角を隠し、人に溶け込んでいる。\n天邪鬼な性格で裏表が激しく、人当たりは軽いが、本心はなかなか明かさない。\n生まれつき、人の心を読み取る超能力を持っている。\n言葉にされない本音や醜い感情まで見えてしまうその力のせいで、人間の偽善や打算を嫌というほど知ってしまった。\nそのため、人間に対しては強い嫌悪感を抱いている。\n一方で、嘘も打算も持たない動物と触れ合う時間だけは、心を許せるひとときとなっている。\n\n⭐︎外見の特徴  \n＊目:瞳が紫色で、色素が薄めの黒目  \n＊髪:黒髪に紫のインナーカラー  \n＊口元と左目の下にほくろ\n\n2人とも決まった服や髪型がないため、資料に添付させていただいた中から組み合わせていただいてもいいですし、その他でこれが合いそうだなやこんな感じで描きたいというものがあれば変更していただいて構いません！むしろ大歓迎です！\nその他のことも全てうらん様にお任せさせていただきたいです！当方、何一つNGや地雷がないです！うらん様の癖を詰め込んでいただきたいです！\n\nもしこのリクエストが難しかったり、気乗りしない場合は遠慮なく金額の再送やキャンセルなどの対応をして下さい！\n\nhttps://drive.google.com/drive/folders/1QJBlVnAKQ8njSFt055X6ot9z6n0IEm6u", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 2851282, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "⚰️", "screen_name": "fumei404", "avatar_url": "https://pbs.twimg.com/profile_images/1764369474743119872/4m1IufKJ.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1764367531404570624/1709493347/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 10, "complete_expiration_days": 45, "skills": [{"genre": "art"}], "nc": 144}, {"id": 3290776, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "BonBon", "screen_name": "HK__BB", "avatar_url": "https://pbs.twimg.com/profile_images/1169091181046681600/HLs2ZMV_.jpg", "header_url": "https://pbs.twimg.com/profile_banners/903086473544531968/1581001779/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "art"}, {"genre": "correction"}], "nc": 49}, {"id": 3306323, "creator": true, "nsfw_acceptable": false, "acceptable": false, "name": "縫", "screen_name": "nuihapotato", "avatar_url": "https://pbs.twimg.com/profile_images/1957096556114628610/BW-o-zDH.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1525499640451584000/1766297943/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "none", "a