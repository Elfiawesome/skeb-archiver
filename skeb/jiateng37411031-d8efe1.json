-977d-f0eebf989cef?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=03d25c74cd069b15d3d5693b53822a22 2x, https://si.imgix.net/ea012880/uploads/origins/8fc79fab-d6dd-40d6-977d-f0eebf989cef?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c731c34e14122536dbb984c198f29770 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/ea012880/uploads/origins/8fc79fab-d6dd-40d6-977d-f0eebf989cef?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=cc2eb094d9a2e9a507b93b0587ea5a8c", "srcset": "https://si.imgix.net/ea012880/uploads/origins/8fc79fab-d6dd-40d6-977d-f0eebf989cef?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=cc2eb094d9a2e9a507b93b0587ea5a8c, https://si.imgix.net/ea012880/uploads/origins/8fc79fab-d6dd-40d6-977d-f0eebf989cef?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=f0435f6fde5d2b645818aa5c0422fac9 2x, https://si.imgix.net/ea012880/uploads/origins/8fc79fab-d6dd-40d6-977d-f0eebf989cef?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=7e8aa02dbcb6a91b5bf052d0ffddceb7 3x"}, "body": "初めまして、梅干しのタネさん。\n新着作品で惹き込まれるような画力をお見かけし、その生き生きした躍動感、圧倒的質感、表現力の作品の数々に強く惚れ込みました。\nもし無茶を承知で私の願望をご依頼をさせて頂ければと思い、ダメ元でご依頼させてください。\n\nよろしければ「ウマ娘のメジロアルダンに、FGOの源頼光／丑御前（アヴェンジャー）・第一再臨のコスプレ」したイラストをお願いできるでしょうか。\n\n参考\n・キャラ：メジロアルダン（ウマ娘）\nhttps://umamusume.jp/character/mejiroardan\n\n・衣装：源頼光／丑御前（FGO）\nhttps://fgogamemeister.com/archives/39506333.html\n（第一再臨はぴっちりタイツのものです）\n\n発想に至った経緯としましては、ゲーム内のイベントにてメジロアルダンが「源頼光になった空想をする」というエピソードがあったこと。また彼女の衣装が、黒ベースにグリーンをあしらった丑御前（＝源頼光）を彷彿するカラーリングであったなどなど、こじつけるに足る理由に個人的に盛り上がって、そのまま組み合わせにハマってしまったためです……。\n\n梅干しのタネさんにはどちらのジャンルも縁遠いとは思いますが、圧倒的な画力と生命力で、ハマってしまったこのお題目を描いて欲しいと強く思わされましたため、正直完全にダメ元でお願いさせて頂ければ、とても嬉し思います。\n\nあくまで「着せ替えしたメジロアルダンさん」を拝みたいので、アルダンさんにはコスプレ元になりきって描いて頂く必要はないです。（というか衣装元に寄せて暗く病んだ感じになるのは本意ではないです……ｗ）\n本来ならご自身のキャライメージ通りにとお願いする所ですが、初めて見るキャラとは存じますので、そのまま梅干しのタネさんの感じた印象を信じて託します……！\nキャラの備考として、深窓の令嬢を思わせる雰囲気から、ちょっとお茶目な面があったり、勝負（レース）に関しては覚悟が決まった芯の強さなどを持った子でもあります。（個人的主観ですｗ）\n\n一応、コスプレ（衣装）がメインなので、なるべくなら全身の衣装姿を堪能できる構図であれば特に嬉しく思います……！\n\nどちらもノータッチだろう作品を依頼する無茶は百も承知ですが、それでもよろしければ何卒お願いいたします……！\n\nhttps://www.pixiv.net/artworks/115999216", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@jiateng37411031/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3486658, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/d1e89b46/uploads/origins/94f72f09-5a34-42eb-92c4-c34cdbe6a703?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b942d0d8c776112c834b661da3a4c1c5", "srcset": "https://si.imgix.net/d1e89b46/uploads/origins/94f72f09-5a34-42eb-92c4-c34cdbe6a703?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b942d0d8c776112c834b661da3a4c1c5, https://si.imgix.net/d1e89b46/uploads/origins/94f72f09-5a34-42eb-92c4-c34cdbe6a703?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=df65197eb37e52ef3f32aaf53f75547b 2x, https://si.imgix.net/d1e89b46/uploads/origins/94f72f09-5a34-42eb-92c4-c34cdbe6a703?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=4618aa3a19b866c7935ba824bb5bf061 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/d1e89b46/uploads/origins/94f72f09-5a34-42eb-92c4-c34cdbe6a703?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=741942212608ec28ab056ad8f37e2e1f", "srcset": "https://si.imgix.net/d1e89b46/uploads/origins/94f72f09-5a34-42eb-92c4-c34cdbe6a703?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=741942212608ec28ab056ad8f37e2e1f, https://si.imgix.net/d1e89b46/uploads/origins/94f72f09-5a34-42eb-92c4-c34cdbe6a70