c8590/uploads/origins/5d640770-5e4b-434d-8bcc-bbf35ae50a05?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e3d224cb82517bfa7c07769812b672f8, https://si.imgix.net/330c8590/uploads/origins/5d640770-5e4b-434d-8bcc-bbf35ae50a05?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=a212a0ee21dd0765c21194f074f864d4 2x, https://si.imgix.net/330c8590/uploads/origins/5d640770-5e4b-434d-8bcc-bbf35ae50a05?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=accd5bf0ec2c283ed0f6a97f8e631ccb 3x"}, "body": "こんにちは！Skebであなたの作品を見つけ、その描き方や色使いがとても気に入りました。特に以下の作品が気に入っています。\n- https://skeb.jp/@jahopotto/works/9\n- https://skeb.jp/@jahopotto/works/7\n\n私のゲーム『UNIVERSAL』のキャラクターを描いていただけたら嬉しいです。\n\n【ユニバーサル / UNIVERSAL】\n年齢：19歳 / 身長：177cm\n性格：体が弱い。鬱々としていて、孤独で、よく疲れている。\n設定：誤って故郷の世界を破壊してしまった。現在は放浪の旅人として、紫色の結晶の破片を操り、次元のポータルを作り出している。\n参考画像：https://2100438g.github.io/cw-oc-codex/#universal\n\n髪型や表情などは、お好きなように変更していただいて構いません。構図や細部の描き方は、お任せします。\n※横向き（ランドスケープ）でお願いします。\n\nお時間を割いてご検討いただき、誠にありがとうございます。ご連絡を楽しみにしています :)\n\nhttps://drive.google.com/drive/folders/11GU7Cem8ZCVX5yWyuzu2DwJKyGcdhguR?usp=drive_link", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@jahopotto/works/13", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1915981, "client_id": 187973, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/ecae454e/uploads/origins/05acf80b-a2a6-4490-a2c1-f61420d0e963?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1357661177ddd325c0e0dad5f84a1d00", "srcset": "https://si.imgix.net/ecae454e/uploads/origins/05acf80b-a2a6-4490-a2c1-f61420d0e963?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1357661177ddd325c0e0dad5f84a1d00, https://si.imgix.net/ecae454e/uploads/origins/05acf80b-a2a6-4490-a2c1-f61420d0e963?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=38db50dbdee706c4ff5b9848f7a765af 2x, https://si.imgix.net/ecae454e/uploads/origins/05acf80b-a2a6-4490-a2c1-f61420d0e963?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=0700cc4dea24dc76128fe7bc9b0df0e1 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/ecae454e/uploads/origins/05acf80b-a2a6-4490-a2c1-f61420d0e963?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=26fe0e80cd21f9139e588072990e0796", "srcset": "https://si.imgix.net/ecae454e/uploads/origins/05acf80b-a2a6-4490-a2c1-f61420d0e963?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=26fe0e80cd21f9139e588072990e0796, https://si.imgix.net/ecae454e/uploads/origins/05acf80b-a2a6-4490-a2c1-f61420d0e963?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=36cc494d9783b9bb6e66739bfc0d5c2b 2x, https://si.imgix.net/ecae454e/uploads/origins/05acf80b-a2a6-4490-a2c1-f61420d0e963?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=561346b0f2e2e39f6951a92c6c20c29a 3x"}, "body": "よろしくお願いします！\n\nこの2人のオリジナルキャラクターが登場するシーンを描いていただけませんか？ヴィクトリア朝（1890年代）のTRPG「Call of Cthulhu（CoC）」の設定に登場する2人です。家を持たず、一緒に路上で生活している親友です。カルト教団に所属する怖い子たちです。\n\n茶髪の少年シェイは物静かで、普段は中性的な表情か、小さく謎めいた笑みを浮かべている。アロイスのことをとても大切にしている。\n金髪の少年アロイスは、大胆でおしゃべりな性格。表情はいつも満面の笑みを浮かべている。シェイをとても愛している。\n\n想定されるシーンとしては、以下のようなものがあります（描きたくなければ描く必要はありません）：\n- 安全な場所に隠れて、盗んだ食料を分け合っている平和なシーン。\n- 廃墟となった教会をみんなで探検する\n- ロウソクやナイフ、血を使った怖いカルトの儀式を行っています\n- 怖いモンスターと戦ったり隠れたりしようとする\n- お好きなシーン\n\nいずれにせよ、このリクエストを読んでいただき、本当にありがとうございました！\n\nhttps://drive.google.com/drive/folders/1uV4UtcsimuwnNtJvnj3WmLZ-heBRzsN9?usp=sharing", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@jahopotto/works/12", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tip