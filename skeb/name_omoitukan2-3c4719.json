g=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fdc9ef9fb334828c762c5f78ac08f083, https://si.imgix.net/dce9f4fa/uploads/origins/451868df-055c-40ac-bb3c-f39915448b9b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=22f75333faec0978e940d50d73e8f1ee 2x, https://si.imgix.net/dce9f4fa/uploads/origins/451868df-055c-40ac-bb3c-f39915448b9b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=1822e4db62fb7c263563976bc9402c51 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/dce9f4fa/uploads/origins/451868df-055c-40ac-bb3c-f39915448b9b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=8cc92f1740719f6b7c5d1f40cddc33ae", "srcset": "https://si.imgix.net/dce9f4fa/uploads/origins/451868df-055c-40ac-bb3c-f39915448b9b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=8cc92f1740719f6b7c5d1f40cddc33ae, https://si.imgix.net/dce9f4fa/uploads/origins/451868df-055c-40ac-bb3c-f39915448b9b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=3061d5d6433a2dcc7a42c8c434679ff8 2x, https://si.imgix.net/dce9f4fa/uploads/origins/451868df-055c-40ac-bb3c-f39915448b9b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=5ebc824e2cf920c5ca2e1767b23b4f8b 3x"}, "body": "こんにちは、イラストの依頼をさせていただきたいのですが。\n\nイカとタコの2体のキャラクターを描いていただきたいです。どちらも大きな胸を持っており、ビキニを着用します。ビキニの色はそれぞれのインクの色と同じにしてください。また、被り物もそのままにしてください。\n\nポーズについて：\nミカ（水色のイカ）は、主に大きな胸を強調したポーズにしてください。\nエミ（青いタコ）は、その大きなヒップを可愛らしく表現してください。\n具体的な表現方法は、お任せします。\n\nよろしくお願いします！\n\nhttps://drive.google.com/drive/folders/1RV_R0M6FY27gzPionS-1LWeiK6T-w71C", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@name_omoitukan2/works/13", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 156767