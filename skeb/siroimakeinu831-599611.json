をお願いします\n\n･立ち絵のポーズと表情は元絵と同じ、メスガキっぽく煽りながらしゃがみパンチラしているところを正面から見たもの\n･背景のパンツは正面から見たもので、脚を開いてパンツがはっきり見えるようにする(他の絵師様の絵となりますが、開き具合はhttps://skeb.jp/@seavalog/works/11のような感じでお願いします)\n･可能であれば差分として\n　･白地に水色の星柄のパンツを着用したもの\n　･赤面しながら驚いた表情のもの(パンツを見られていることに気づいたイメージです)\n をいただきたいです\n･psd形式での納品を希望します\n\nその他\n立ち絵は元絵のものがとても好みなので、同じものを使用していただきたいです(作業データが既に存在しない等、対応が困難な場合は無視してください)\n\nもしも描くのが困難だったり割に合わないと判断されましたら、即キャンセルしていただいて構いませんので改めてよろしくお願いいたします", "nc": 41, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@siroimakeinu831/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 948495, "client_id": 461653, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/6a040484/uploads/origins/1a08b07f-5962-4ca7-a89a-88b7bcb4d994?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9a6adf992ed48cdd80f6941d8d3eaabe", "srcset": "https://si.imgix.net/6a040484/uploads/origins/1a08b07f-5962-4ca7-a89a-88b7bcb4d994?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9a6adf992ed48cdd80f6941d8d3eaabe, https://si.imgix.net/6a040484/uploads/origins/1a08b07f-5962-4ca7-a89a-88b7bcb4d994?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=5586342b4477a2f54c65058b05d5888d 2x, https://si.imgix.net/6a040484/uploads/origins/1a08b07f-5962-4ca7-a89a-88b7bcb4d994?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=61d4a90cc2ea76c22387267af065c88e 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/6a040484/uploads/origins/1a08b07f-5962-4ca7-a89a-88b7bcb4d994?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e1d33d262deaceffa90a1126c7199107", "srcset": "https://si.imgix.net/6a040484/uploads/origins/1a08b07f-5962-4ca7-a89a-88b7bcb4d994?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=