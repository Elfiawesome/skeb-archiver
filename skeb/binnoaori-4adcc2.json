5e-c0976729a028?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=2dc41ac0418bc5fbcf1eae55310799a4 2x, https://si.imgix.net/9def44b0/uploads/origins/06b986aa-0947-4358-965e-c0976729a028?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=02f67fb9506737affd6370adf7ea361c 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/9def44b0/uploads/origins/06b986aa-0947-4358-965e-c0976729a028?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ef9cca1ad9209a04d46af8b0f7de8861", "srcset": "https://si.imgix.net/9def44b0/uploads/origins/06b986aa-0947-4358-965e-c0976729a028?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ef9cca1ad9209a04d46af8b0f7de8861, https://si.imgix.net/9def44b0/uploads/origins/06b986aa-0947-4358-965e-c0976729a028?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=c06d62098871c44d06542fc9ca24a2e5 2x, https://si.imgix.net/9def44b0/uploads/origins/06b986aa-0947-4358-965e-c0976729a028?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=f4bcc076436be476afb6310e42a8ffba 3x"}, "body": "白子(青アーカイブ)の参考URLを添付します。\n\n背景は街並みでお願いします。\n\n朝から運動で汗だく、汗で体に張り付く白いシャツにタイトなスパッツ姿。\n\n片手を腰に当て、もう片方の手で冷たい水を飲む。\n\nシャツは彼女の胸と体のラインを強調している。\n\nあるバージョンでは、シャツが濡れすぎて透けそうになり、彼女のお腹（フォーカス）と黒いスポーツブラが見えるようにした。\n\n別のバージョンでは、彼女はノーブラで、シャツ越しに胸と乳首が見える。\n\n3つのバージョン。それぞれのバージョンで表情が異なるかどうかはアーティストにお任せします。\n\nもちろん、それぞれのバージョンに追加料金を支払います。\n\nよろしくお願いします！\n\nhttps://hero.fandom.com/wiki/Shiroko_Sunaookami", "nc": 161, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@binnoaori/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1896836, "client_id": 1982059, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/2689dfe7/uploads/origins/f471