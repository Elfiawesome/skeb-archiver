ins/e9625ece-521f-4600-8af7-8dff2eb6b251?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c93dd182d8a33ad1b791a11903c61416", "srcset": "https://si.imgix.net/51d9fe52/uploads/origins/e9625ece-521f-4600-8af7-8dff2eb6b251?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c93dd182d8a33ad1b791a11903c61416, https://si.imgix.net/51d9fe52/uploads/origins/e9625ece-521f-4600-8af7-8dff2eb6b251?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=f1c2920fa729299b7ef7d5b687319608 2x, https://si.imgix.net/51d9fe52/uploads/origins/e9625ece-521f-4600-8af7-8dff2eb6b251?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=c534a20b4bb77891c16554364cef526e 3x"}, "body": "夜乃まにさま\n\nお世話になっております！\n前回リクエストさせていただいたぜろくん・ぜろりの二人をまたお願いしたいなと思っております！\n\n◇リクエスト内容\nお家でノートパソコンをいじるぜろくんと、隣で漫画を読むぜろりのイラストをお願いしたいです。\n構図や服装はまにさんにお任せ出来ますでしょうか？\n\n◇人物\n・ぜろくん\n身長165cm\n黒髪\nつり目\nイメージカラー：赤み寄りのオレンジ\nモチーフ：オレンジ（果物）\n動物：黒猫\nその他：妹に頼られるとうれしい。妹ファースト。\n\n・ぜろり\n身長130cm\nぱっつん前髪・黒髪\nまるっこい目\nイメージカラー：黄色寄りのオレンジ\nモチーフ：ひまわり\n動物：ポメラニアン\nその他：兄のことは好きだがツンデレ。たまに強く言い過ぎたことを後悔している。\n\n◇使用用途\n配信のサムネやぜろくん配信の際に画面上に出したいなと思っております。\nまた、いつかタイピング音や本をめくる音に関する動画をだしたいなと思っており、その際にも使用出来たらなと思っております。\n人物のレイヤーがわかれていると嬉しいですが、難しかったら一枚絵のみで大丈夫です。", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@yorunomani/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1724292, "client_id": 1120260, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/4b91fa17/uploads/origins/ea6bc891-ea40-431b-ad6e-599c767051ef?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0395e7857a271f2f55e94b70df2fcbe5", "srcset": "https://si.imgix.net/4b91fa17/uploads/origins/ea6bc891-ea40-431b-ad6e-599c767051ef?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0395e7857a271f2f55e94b70df2fcbe5, https://si.imgix.net/4b91fa17/uploads/origins/ea6bc891-ea40-431b-ad6e-599c767051ef?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b6a62f4905c5b2751e6ad631946921a4 2x, https://si.imgix.net/4b91fa17/uploads/origins/ea6bc891-ea40-431b-ad6e-599c767051ef?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=57cc507624ac786c567716d2c788e339 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/4b91fa17/uploads/origins/ea6bc891-ea40-431b-ad6e-599c767051ef?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d50575ff0fb673aef542800c9f6fef3d", "srcset": "https://si.imgix.net/4b91fa17/uploads/origins/ea6bc891-ea40-431b-ad6e-599c767051ef?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d50575ff0fb673aef542800c9f6fef3d, https://si.imgix.net/4b91fa17/uploads/origins/ea6bc891-ea40-431b-ad6e-599c767051ef?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=b71c9cc5a9b69da29d6649ab62cc85d7 2x, https://si.imgix.net/4b91fa17/uploads/origins/ea6bc891-ea40-431b-ad6e-599c767051ef?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=c895c241c060c325186be5a7cff9e48c 3x"}, "body": "はじめまして！\nクトゥルフ神話TRPGのオリジナルシナリオ公開にあたり、配布素材用の【立ち絵１人分】と【エンディングの絵１枚】を作成して頂きたいのですが可能でしょうか？\n\n■用途\nクトゥルフ神話TRPGのオリジナルシナリオの素材として使用します。\n\n素材はpixivで無料配布予定で、素材提供元として「夜乃まに」さんの名前記載、（pixiv的に可能なら）夜乃まにさんのXへのURLも記載致します。\nまた（配布者に対して）再配布を禁止する文面も記載いたします。\n\n※動画、配信使用もOKにします。\n\n■キャラクター\n【神代　アオイ】\n性転換の呪いにより男性となった元女性の高校生。\n呪いを解く方法を求めて、さまざまな怪事件に首を突っ込もうとする。\n今シナリオでは性転換の呪いを解く薬があると言う町へ行き、行方不明になる。\n\nご近所さん同士が仲が良かった関係でご近所さんの子供達の世話をしたり、よく遊んでいた。（ちなみにほとんど男の子）\nなので、世話をする内に身についた【応急手当】【精神分析】【説得】【目星】【聞き耳】が歳の割に高い。\nまた、追いかけっこやドッヂボール、キャッチボールで遊ぶ子が多かったので【回避】【投擲】も高め。\n\n性転換前よりも逆に小さくなっており、力も弱くなっている事にガッカリしている。\n服は性展開前で男が着ても違和感がない服を着ており、軽くお化粧もしている。\n中性的な顔立ち。\n\n■立ち絵\n基本１枚に表情差分が５種ほどを希望。（多い分には問題ありません。）\n※【笑顔】×２種類、【困り顔】×２種類、【救出時のはにかんだテレ顔】を想定。\n※差分パーツは使いまわしても大丈夫です。（笑顔とテレ顔の口パーツを同じにするなど。）\n\n■エンディングの絵\n1枚。\n季節は６月末。場所はアオイの部屋。\n救出後、アオイは今回の出来事をパソコンでレポートにまとめる。\nだが、提出する相手が普通の人なので憂鬱になってるシーン。\n\nイメージとしては下記２つのどちらかを選んでください。\n（どちらでも大丈夫です）\n\n・出来上がったレポートを映したモニターを前に「…これ…どうしよ？」とつぶやき、\n　こんなレポートを普通の人に見せたらどうなるのかを想像して居た堪れない気持ちでいっぱいになっている様子。\n\n・「はぁーーー…もーーーどーーーしよーーーー…。」\n　と机に突っ伏してぐだーとした様な状態。", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@yorunomani/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1724292, "client_id": 1820975, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/1dc7be3b/uploads/origins/666554ad-f27d-46f6-a4d4-f83aaf953839?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=59570891b71719e8e30eb41b0fc3625b", "srcset": "https://si.imgix.net/1dc7be3b/uploads/origins/666554ad-f27d-46f6-a4d4-f83aaf953839?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=59570891b71719e8e30eb41b0fc3625b, https://si.imgix.net/1dc7be3b/uploads/origins/666554ad-f27d-46f6-a4d4-f83aaf953839?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e47131e0a37499227c6aa47d47a46317 2x, https://si.imgix.net/1dc7be3b/uploads/origins/666554ad-f27d-46f6-a4d4-f83aaf953839?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=989a1252405ddccfa16fe86adc4671a6 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/1dc7be3b/uploads/origins/666554ad-f27d-46f6-a4d4-f83aaf953839?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=1eba013eab2ac3a155a7d8de046fa216", "srcset": "https://si.imgix.net/1dc7be3b/uploads/origins/666554ad-f27d-46f6-a4d4-f83aaf953839?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=1eba013eab2ac3a155a7d8de046fa216, https://si