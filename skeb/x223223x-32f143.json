ストをお願いしたいです\nまた、どこでもいいので愛猫が近くで寝ててほしいです\n横長16:9の比率で頭部、髪、左右の見切れがないようにしていただけたら嬉しいです\n\n 【使用用途】\n収益化済みYouTube・twitchでの配信や動画内での使用\n配信のマッチング中や離席中時などで表示させたいです\n4月から普段の配信はtwitch、朝の配信とメンバー限定のみyoutubeというスタイルをとっています\n\n【納品形式】\n背景や人物のレイヤーを分けたPSD、または人物のみの透過png別納での納品でお願いします。\n\nお忙しい中恐縮ですが、何卒よろしくお願い申し上げます。\n\nhttps://drive.google.com/drive/folders/1ijC0lCoj00-7uU092L12ySiPfCDc1UNT?usp=drive_link", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "similar_creators": [{"id": 256, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "筆禍＠デカケツフォトコン開催中", "screen_name": "hikka06", "avatar_url": "https://pbs.twimg.com/profile_images/2062499802882232320/REN7JKt9.jpg", "header_url": "https://pbs.twimg.com/profile_banners/85097065/1737786245/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 14, "complete_expiration_days": 90, "skills": [{"genre": "art"}], "banned": false, "nc": 176}, {"id": 2616033, "creator": true, "nsfw_acceptable": false, "acceptable": false, "name": "鯔背わや", "screen_name": "hu_nhey", "avatar_url": "https://proxy.misskeyusercontent.jp/avatar.webp?url=https%3A%2F%2Fmedia.misskeyusercontent.jp%2Fio%2Fc6bee8c4-a14b-4c84-8654-fc681dd01c4b.png&avatar=1", "header_url": "https://media.misskeyusercontent.jp/io/e386596e-44c0-401c-a2b3-52d64770b39c.webp", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 120, "skills": [{"genre": "art"}], "banned": false, "nc": 48}, {"id": 3445598, "creator": true, "nsfw_acceptable": false, "acceptable": false, "name": "𝐌𝐢𝐥𝐢", "screen_name": "3359QQ", "avatar_url": "https://pbs.twimg.com/profile_images/1888303193182081024/Gom25kan.jpg", "header_url": "https://pbs.twimg.com