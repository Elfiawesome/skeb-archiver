23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0bb57c4201ba2b49e560369cbf742c3c", "src_set": ""}, "body": "こんにちは、私は少し前にあなたの作品を発見し、私はあなたの天地無用アートワークが本当に好きです。私はこのシリーズの大ファンなんです。\n\n天地無用に登場する涼子と鷲羽をスケバン/助平な不良少女に見立てて、全身で描いて欲しいです。背景自体は1980年代をテーマにした色でも構いません。腕組みのポーズでも、バットや木刀のような武器を持った姿でもOKです。表情は中性的なものから、少し怒ったようなものまであります。服装は、鷲羽の服は白、リョーコは黒でお願いします。\n\nhttps://drive.google.com/drive/folders/13lS7v4HNLb7K2pI1MBiTDpbT_WRz_hex?usp=share_link\n\nお忙しい中、どうもありがとうございました。", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@mamekko/works/19", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 240813, "client_id": 2741214, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/7494b294/uploads/origins/adc92fe7-69e7-478f-b7d5-71cba404bdd1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f4e0e17a57ef0e3608f4d561596160a6", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/7494b294/uploads/origins/adc92fe7-69e7-478f-b7d5-71cba404bdd1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=cf4b475b44c420bd374debeb5d88f3cb", "src_set": ""}, "body": "5円玉で見る人に催眠術をかけるノースリーブ姿のNARUTOの春野サクラを描いていただけませんか？\n\n@@ 目で邪悪な笑顔を追加するだけです。\n\nマシューより Twitter", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@mamekko/works/18", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 240813, "client_id": 545884, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/9059336c/uploads/origins/db6e3ea7-a23f-4660-a233-874f4b0e303d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=cd7fcc5fa6fde4ce21392934705add18", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_url