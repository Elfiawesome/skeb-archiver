 true, "creator_id": 3563833, "client_id": 2462364, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/68b40369/uploads/origins/824f339d-4c17-41b3-9f9a-2df8978f996c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4a79757ac35b3ff477a2dc3e0910f5a3", "srcset": "https://si.imgix.net/68b40369/uploads/origins/824f339d-4c17-41b3-9f9a-2df8978f996c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4a79757ac35b3ff477a2dc3e0910f5a3, https://si.imgix.net/68b40369/uploads/origins/824f339d-4c17-41b3-9f9a-2df8978f996c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a2228c72b0859ee31b94bb92dc2386d5 2x, https://si.imgix.net/68b40369/uploads/origins/824f339d-4c17-41b3-9f9a-2df8978f996c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c25cdb7bb00a8776cdeeecb4e8b80c9c 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/68b40369/uploads/origins/824f339d-4c17-41b3-9f9a-2df8978f996c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e5d11e3231e581dd50df3974f159ad67", "srcset": "https://si.imgix.net/68b40369/uploads/origins/824f339d-4c17-41b3-9f9a-2df8978f996c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e5d11e3231e581dd50df3974f159ad67, https://si.imgix.net/68b40369/uploads/origins/824f339d-4c17-41b3-9f9a-2df8978f996c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=dde66c479addaeb2cdaba9d5d3984416 2x, https://si.imgix.net/68b40369/uploads/origins/824f339d-4c17-41b3-9f9a-2df8978f996c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=94f86f072497ec9e21ae562b176ee532 3x"}, "body": "こんにちは！お忙しいところ大変申し訳ありません！今回の依頼についてなのですが、もし可能であれば私のocの漫画を描いて頂きたいです↓以下、簡単なキャラの説明と要望です！\n\n二人とも20世紀の人です。\n(下) コンスタンティン：24歳、金髪、赤い瞳孔、182cm、長身痩躯、上品な物腰。コンスタンティンは貴族で、家はとても裕福、両親と兄は彼をとても愛している。貴族気質でプライドが高く、自尊心が高いが、非常に頭が良く優秀で、人に優しく接するが、人を遠ざけることもある。大学を早々に卒業し、文学の道に進んだ彼は、文筆業でもジャーナリズムでも中心的な存在であり、その頭の良さから警察から事件の捜査協力を依頼されることもある。ヴィラカスに憧れ、その憧れは後に秘密を共有したことで好意を抱くようになる。\n\n(上）ヴィラカス：21歳、186cm、茶色の少しカールした髪、緑の目、標準的な体格、穏やかで礼儀正しい。ヴィラカスは裕福な家庭の平民で、コンスタンティンの助手である。コンスタンティンに憧れ、相手の通信社に応募に来たところ、アシスタントに抜擢された。コンスタンチンの日常生活や生活の世話をし、非常に従順で、忠犬のような性格に見え、コンスタンチンをとても頼りにしている。\n\nコスチュームや描く内容は自由です！(西洋ファンタジーの設定が好きなら、西洋ファンタジーの設定でマンガを描いて、写真28のコスチュームを選ぶこともできます）。\n\n金額に満たない場合は、再度リクエストを送っていただけると助かります！めんどくさいと思ったらキャンセルしていただいて構いません。この度はご依頼をお受けいただき、誠にありがとうございました！\n\nhttps://drive.google.com/drive/folders/1mP_-_aYjvuPUdyoPB12Sek3bUxpMOry1?usp=share_link", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@wantetsusima/works/13", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3563833, "client_id": 3280149, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/668ac823/uploads/origins/22ba6e4d-119f-4a62-bd54-6d0b172554ac?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=edcc87f0c1284a4c93f04f810ede917b", "srcset": "https://si.imgix.net/668ac823/uploads/origins/22ba6e4d-119f-4a62-bd54-6d0b172554ac?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=edcc87f0c1284a4c93f04f810ede917b, https://si.imgix.net/668ac823/uploads/origins/22ba6e4d-119f-4a62-bd54-6d0b172554ac?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c00eb682bae587fa840a994b155e1943 2x, https://si.imgix.net/668ac823/uploads/origins/22ba6e4d-119f-4a62-bd54-6d0b172554ac?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=86e8cb98c0884d383e54da5db9bdd618 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/668ac823/uploads/origins/22ba6e4d-119f-4a62-bd54-6d0b172554ac?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=1ce42e4