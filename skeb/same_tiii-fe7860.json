23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=0fe038503706a83cf5dcbd36860f20fc 2x, https://si.imgix.net/fdf8537d/uploads/origins/1c5dba0b-4b67-49ce-8bae-990ed31443dc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=aa83496708ce2d4c86ef173921aca156 3x"}, "body": "こんにちは。凄く細かいアートですね!カラーリングも素敵ですね。\n\n100%オレンジジュース」の諜報員アーネルのクールでセクシーな立ち姿をぜひ描いてほしいです。\n\nアーネルはサキュバスのようなスパイです。彼女は新しい獲物を捕らえて、（様々な方法で）彼から搾り取ろうとしているところです。\n\nArnelleは視聴者の方を向き、威圧的な目つきで下を見つめ、自分自身に満足しているように見えます。彼女は、拘束された男性の上に立っているように、足を軽く分けてまっすぐに立っている。彼女は現在、裸になっている。大きな胸はすでにあらわになっていて、片手でネクタイを外しています。彼女がまだセクシーな下着を身につけるかどうかは、あなたにお任せします。お腹にはハート型の子宮のタトゥーが光っています。\n\n自信に満ちたセクシーな女性になってほしいですね。\n\n楽しみにしています。\n\nhttps://www.dropbox.com/sh/ie8pw9fex8jzfme/AAD0Zn7tWxWg-AwK_4iF1PdSa?dl=0", "nc": 186, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@same_tiii/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1108516, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/dff3fe84/requests/283620_1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f1c622a9756db0eaa6321bb4a4e5aa90", "srcset": "https://si.imgix.net/dff3fe84/requests/283620_1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f1c622a9756db0eaa6321bb4a4e5aa90, https://si.imgix.net/dff3fe84/requests/283620_1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b833b0d05c4bd8f4763e69638de13dd8 2x, https://si.imgix.net/dff3fe84/requests/283620_1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=dd5d699f2c447e391581f63a067cd2e9 3x"}, "duration": null, "nsfw": true, "hardcore": true, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/dff3fe84/requests/283620_1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2dc5a19566faf73b16ee4d16c831b6d3"