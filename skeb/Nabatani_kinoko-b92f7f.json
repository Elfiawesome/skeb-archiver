には異空間にあった目が映っている\n・注釈にて、少女と内包してる怪異は別物であり勝手に宿主とされている的な事を書いていただけると嬉しいです。\n\n……的な感じでお願いしたいのですが、可能でしょうか？\n慣れないので、分かりにくい部分が多々あるかと思いますが、描いていただけたら幸いです。\nこれからも応援してます。\n\n資料として、3面図のイラストを添付します。\n\nhttps://www.dropbox.com/s/aaso96mtftyw898/18519.png?dl=0", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@Nabatani_kinoko/works/11", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/d6d313f6/requests/193991_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=c16dad9195a9f8062c48e069d7a33a9c", "srcset": "https://si.imgix.net/d6d313f6/requests/193991_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=c16dad9195a9f8062c48e069d7a33a9c, https://si.imgix.net/d6d313f6/requests/193991_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=16e28baa61522624fa97a4b41c7a9efc 2x, https://si.imgix.net/d6d313f6/requests/193991_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=93953488e7a33645b5872f841d0f2ec0 3x"}, "private": true, "genre": "art", "tipped": false, "creator_id": 394449, "client_id": 880815, "nc": 33}, {"path": "/@Nabatani_kinoko/works/10", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/1971e57f/requests/119028_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=a8a5014d4e601df3381fed613912e161", "srcset": "https://si.imgix.net/1971e57f/requests/119028_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=2