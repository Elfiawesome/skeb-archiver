si.imgix.net/19217e25/uploads/origins/91423d4d-9e00-4fd3-be72-5b859aa8a1f4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c131ed26410bbaf06371e1df08dfd68b, https://si.imgix.net/19217e25/uploads/origins/91423d4d-9e00-4fd3-be72-5b859aa8a1f4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=65bb156e8ecae90652b339c5316482d1 2x, https://si.imgix.net/19217e25/uploads/origins/91423d4d-9e00-4fd3-be72-5b859aa8a1f4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=3f8109973f5477aaabd8658393a51527 3x"}, "body": "2度目の依頼を失礼致します。以前描いてもらいました立ち絵に愛着が湧きまくり、単純な考えながら差分の多い立ち絵を少しお願いしたいなと思い、再び連絡しました。\n\n「要望」\n・髪型は資料のような髪型で、大きいアホ毛をつけてもらえると助かります。また、資料とは違い、前髪を両目目隠れにして欲しいというのと、大きなインテークを付けて貰えると助かります。\n（目隠れではあるんですけど隙間から目が見えてる感じにしてください！）\n\n・資料とは少し異なりますが、黒に近い灰色なロングダッフルコートで、かなりロングにしてもらえると助かります。中にシャツを着ています。スカートは靴の全体が見える程の長さでお願いします。また、ベルトを着けています。\n\n・資料通りのグローブを常に身に付けています。\n\n・性別は女性で、身長は172cm程です。\n\n・胸が大きく、シャツのサイズがキツくなっている程に大きいです。\n\n・性格は弱気です。ポーズもそれに合わせて、人と話すのが慣れてい無さそうな陰湿な感じでお願いします。\n\n「差分」\n・喜怒哀楽と泣・赤面・怯えの表情差分をお願いしたいです。\n\n・ぶん殴ってる戦闘差分のような物をお願いします。簡易的な物でも構いません。\n\n「用途」\nTRPGや、動画での利用です。\n\n「ファイル」\nPNGとPSDの2つをお願いしたいです。\n\nhttps://drive.google.com/drive/folders/1J2BTOLwgbx5LFdNtVr_z1LmjPKI4K1q0", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@sawa09214/works/9", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2385855, "client_id": 3564905, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/e81f262a/uploads/origins/66deef83-c169-40a4-b446-a540103ba38e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ac5126872ef0213c4236342dd9528f76", "srcset": "https://si.imgix.net/e81f262a/uploads/origins/66deef83-c169-40a4-b446-a540103ba38e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ac5126872ef0213c4236342dd9528f76, https://si.imgix.net/e81f262a/uploads/origins/66deef83-c169-40a4-b446-a540103ba38e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=3a106945f58ddf8313753ff523d883c4 2x, https://si.imgix.net/e81f262a/uploads/origins/66deef83-c169-40a4-b446-a540103ba38e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=74de8a1244fac908198c469d4627e0d1 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/e81f262a/uploads/origins/66deef83-c169-40a4-b446-a540103ba38e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e9ba8ffd531a08c25195f8313888613d", "srcset": "https://si.imgix.net/e81f262a/uploads/origins/66deef83-c169-40a4-b446-a540103ba38e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e9ba8ffd531a08c25195f8313888613d, https://si.imgix.net/e81f262a/uploads/origins/66deef83-c169-40a4-b446-a540103ba38e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=8bb83666c3ab4763be415112df7d33be 2x, https://si.imgix.net/e81f262a/uploads/origins/66deef83-c169-40a4-b446-a540103ba38e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=98741a2a9fbde09c9c3bbf367369f144 3x"}, "body": "こんにちは、\n\n以前からあなたの作品に注目していたのですが、今回の最新作を見て、思い切って連絡してみようと思いました！\nデザインやスタイルがとても素敵なので、もしよろしければ私のキャラクターのイラストをお願いしたいです^^！\n\n彼女はかなり明るく気さくで、少しいたずら好きで、音楽とギターが大好きです！\nそれ以外では、普段はサポート役を好むタイプです（特に戦術重視の作品では）。\n\nテーマや衣装（参考画像通りにする必要はありません）、ポーズなどは、お好きなものや、そのキャラクターに合うと思うもの、あるいは描いていて楽しそうなものを自由に選んでください\n\nキャラクターの参考画像／過去の作品：\nhttps://drive.google.com/drive/folders/1W82ZBeEXTXJy-37leGWmt55WmlhW5hTf?usp=sharing\n\nご依頼をご検討いただきありがとうございます ^~^", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@sawa09214/works/8", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2385855, "client_id": 61032, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/105a0448/uploads/origins/231f59dc-b2a9-42a1-b908-a79a85d51198?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=db0785e9361bef0acceb0e9fdef29f8d", "srcset": "https://si.imgix.net/105a0448/uploads/origins/231f59dc-b2a9-42a1-b908-a79a85d51198?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=db0785e9361bef0acceb0e9fdef29f8d, https://si.imgix.net/105a0448/uploads/origins/231f59dc-b2a9-42a1-b908-a79a85d51198?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e558b6776153d81a1d5f5d91e73849e8 2x, https://si.imgix.net/105a0448/uploads/origins/231f59dc-b2a9-42a1-b908-a79a85d51198?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=1733aee1bef5b3ddd808b9c95a1e7243 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/105a0448/uploads/origins/231f59dc-b2a9-42a1-b908-a79a85d51198?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=007abb52060c24a5dcf3c8b97ebfd179", "srcset": "https://si.imgix.net/105a0448/uploads/origins/231f59dc-b2a9-42a1-b908-a79a85d51198?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=007abb52060c24a5dcf3c8b97ebfd179, https://si.imgix.net/105a0448/uploads/origins/231f59dc-b2a9-42a1-b908-a79a85d51198?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=94fac9585a370b4ec3cc1d064dd49f05 2x, https://si.imgix.net/105a0448/uploads/origins/231f59dc-b2a9-42a1-b908-a79a85d51198?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=46e43e51a6fa7a388bd088db25aa8943 3x"}, "body": "澤さま、はじめまして！\nTLに流れてきた虚無僧の女の子のキャラデザがめちゃくちゃかっこ可愛かったのでリクエストさせていただきました。\n\n今回お願いしたいのは愛用している折り畳み自転車の美少女化キャラデザになります。\n要素としましては、\n\n・キャラ:深圳生まれのボーイッシュでマイペースなドラゴン(東洋系)娘。体力がめちゃくちゃ低いので自転車のくせに電車移動を好む。\n・体型:低身長でお胸はぺったんこ、太い尻尾(爬虫類タイプ)が生えている。\n・髪型:ぼさっとした白髪セミショート、メカニカルな龍の角が生えている。また、ベルの形を模したヘアアクセを装着。\n・ベースウェア:尻尾を含め全身を覆う半透明のピチスー(インナーにはストラップレスのブラとローレグのショーツ)。脚部分にはフロントフォークのドット模様、尻尾には「neo」のプリント。\n・アウターウェア:オーバーサイズ気味な防水生地の黒色テックウェアジャケット。肩部分に反射材プリント。\n\nURLに実車の写真を添付しております(ALTあり)。\n\n可能であれば、アウターは着脱可能にしていただけるととても嬉しいです。また、ポージングや細部のデザイン、マーキング等は澤さまにお任せしたいと思います。\n\n用途としては個人鑑賞になりますが、アクスタ化したりするかもしれないので全身が収まった背景透過のデータを同封していただけるととても助かります。\n\n少々クセ強な内容になってしまいましたが、ご検討いただければ幸いです！\n\nhttps://x.com/jp_lox/status/2068498521230352472?s=46&t=mh8mrqDI3C2B8ymvWeOM2g", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@sawa09214/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2385855, "client_id": 3766535, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/7de4efba/uploads/origins/6c3cd22f-d592-4fa1-9c40-c44eb14f3b4e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=366201f9c2bf81fccb5168b1e3a44c37", "srcset": "https://si.imgix.net/7de4efba/uploads/origins/6c3cd22f-d592-4fa1-9c40-c44eb14f3b4e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=366201f9c2bf81fccb5168b1e3a44c37, https://si.imgix.net/7de4efba/uploads/origins/6c3cd22f-d592-4fa1-9c40-c44eb14f3b4e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b44b164a89d5b14b5fd656ba8c1ea70e 2x, https://si.imgix.net/7de4efba/uploads/origins/6c3cd22f-d592-4fa1-9c40-c44eb14f3b4e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a0610619ddd6f5ac3593df020812145e 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/7de4efba/uploads/origins/6c3cd22f-d592-4fa1-9c40-c44eb14f3b4e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ff7aa3f77e8492c0541124f90d8f9c9f", "srcset": "https://si.imgix.net/7de4efba/uploads/origins/6c3cd22f-d592-4fa1-9c40-c44eb14f3b4e?bg=%23fff&aut