くお願いいたします……！！🤍✨", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Kyuru_Kyururin_/works/5", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/59669f57/uploads/origins/337845e3-c048-41ea-8c08-00427aadef08?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=720e9648abaae8d0f6e8da8f8f098812", "src_set": ""}, "private": true, "genre": "art", "tipped": false, "creator_id": 3439161, "client_id": 0, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 129, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@Kyuru_Kyururin_/works/4", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/5aeb786e/uploads/origins/249a9775-4a0d-422e-b183-f0e608b1bb1d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=99630c650ed924b3a70e641933c75716", "src_set": ""}, "private": true, "genre": "art", "tipped": false, "creator_id": 3439161, "client_id": 0, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 128, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@Kyuru_Kyururin_/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3439161, "client_id": 0, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/cec68197/uploads/origins/71c9f3cc-0e40-425f-a474-c90352c3163b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0cbe6eee1495d1b7d0b329e456a136f2", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thu