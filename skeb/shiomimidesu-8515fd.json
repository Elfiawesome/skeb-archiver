r=200&s=04d62adb29d37197b6b2d6212113b79b", "srcset": "https://si.imgix.net/5f92bae0/uploads/origins/b9d7acf9-99bd-42fd-a3de-6edba5708d8f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=04d62adb29d37197b6b2d6212113b79b, https://si.imgix.net/5f92bae0/uploads/origins/b9d7acf9-99bd-42fd-a3de-6edba5708d8f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=685a38e8bdc7853f74b54fe39ddbe0f9 2x, https://si.imgix.net/5f92bae0/uploads/origins/b9d7acf9-99bd-42fd-a3de-6edba5708d8f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=4a52ce2c30786d6a542963df3461011f 3x"}, "body": "しおみみさんこんにちは！リクエスト失礼致します。田中まねねと申します。\n\n宜しければ、TRPGで使用しているPCとその家族とのイラストを描いていただきたいです！\n以下、キャラクター情報になります。\n\nアリストテレス:父親。穏やかで理知的。常に思考をしており、理屈や現実性を重んじる性格。\n娘には大変甘く大抵のお願い事は聞き、表情が柔らかくなる。頭につけている冠は娘からの贈り物。身長176cm/体重64kg。\n\nピュティアス:アリストテレスの娘。13歳ほどの見た目。快活で明るく、周りをよく見ている聡い女の子。父親のことが大好きで、非常によく懐いている。髪の2つ結びは父親が毎日結んでおり気に入っている。\n\n2人の幸せな家族絵を描いていただけたらとても嬉しいです！\nしおみみさんのイメージで構いません。SDでもイラスト、詰め込みでも、構図は描きやすいようにお任せ致します。\n\n頂いたイラストは主に個人観賞用、場合によってはSNSでの使用やグッズにする可能性があります！\nグッズ化する際は同卓者、身内へ共有する可能性がありますのでご考慮頂けますと幸いです✨️\n\n不備などありましたら再送頂けますと助かります。\n是非リクエスの方受けてくださると嬉しいです✨️\n\nhttps://drive.google.com/drive/folders/1-UjPj7PsurLUn6YbFBZ5iOPWPF26w54O", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@shiomimidesu/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 4035721, "client_id": 3416124, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/2cddafb9/uploads/origins/cbf95814-282d-4180-a0ef-816176b4d175?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b15aaddc3d4a047202185143dee7abdb", "srcset": "https://si.imgix.net/2cddafb9/uploads/origins/cbf95814-282d-4180-a0ef-816176b4d175?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b15aaddc3d4a047202185143dee7abd