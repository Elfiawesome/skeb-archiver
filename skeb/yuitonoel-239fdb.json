像將您的計算機或智能手機恢復出廠設置一樣。即使有初始設置和操作所需的東西，感覺我個人保存的所有數據都消失了。 ---- 如果可能的話，如果交付的是 PSD，地址、人員和紙張（白色背景）有單獨的圖層，我會很高興。感謝您在準備好時考慮...！\n\nhttps://drive.google.com/drive/folders/1R_KakccoNGOLH54cKDBkmJULwM2_HjS9?usp=share_link", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@yuitonoel/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1787158, "client_id": 563014, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/5792ac65/uploads/origins/da1dfe08-3e64-46d9-bac6-25ec4cb8d5b9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ef0688c3ad0322bdbcdd377d7a594d25", "srcset": "https://si.imgix.net/5792ac65/uploads/origins/da1dfe08-3e64-46d9-bac6-25ec4cb8d5b9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ef0688c3ad0322bdbcdd377d7a594d25, https://si.imgix.net/5792ac65/uploads/origins/da1dfe08-3e64-46d9-bac6-25ec4cb8d5b9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=60c93db5c47ae416362eba151aa69ff5 2x, https://si.imgix.net/5792ac65/uploads/origins/da1dfe08-3e64-46d9-bac6-25ec4cb8d5b9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c55a1eccb5ea7d9f9305fa780050a4ca 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/5792ac65/uploads/origins/da1dfe08-3e64-46d9-bac6-25ec4cb8d5b9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=7c1050d00fb0421e337f54e9c55a38dc", "srcset": "https://si.imgix.net/5792ac65/uploads/origins/da1dfe08-3e64-46d9-bac6-25ec4cb8d5b9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=7c1050d00fb0421e337f54e9c55a38dc, https://si.imgix.net/5792ac65/uploads/origins/da1dfe08-3e64-46d9-bac6-25ec4cb8d5b9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=3d1cbed289b52