す)\n\n関係性：\n小さな事務所でひっそりと活動をする探偵と探偵助手。事務所の１階部分が住居スペースとなっており同居している。住居スペースでは大型犬（ゴールデンレトリバー）も飼っている。家事などは全般助手がする。\n基本的には事件解決に勤しむ探偵＆サポートをする助手。家では基本的に探偵の言動が発端で軽い喧嘩はしつつも仲のいい2人。\n\n構図や服装などご自由に書いていただいて大丈夫です！\n日常的な部分の切り抜きや、想像できる二次創作的なものを描いていただけると嬉しいです！金額や資料などが足りないようでしたら、再送やキャンセルしていただければと思います！\n\nまた、画像資料に一部、「【CoC】Ⅶ・peccata」のネタバレがございます\nTRPGをされる場合は画像のファイルは分けておりますが、お気を付けください。\n\n使用用途\n⬛︎個人鑑賞\n⬛︎個人で楽しむ範囲のグッズ作成\n⬛︎友人への共有\n\n\nよろしくお願いいたします！\n\nhttps://www.notion.so/291886ab6bf680f9b320c4f6f7d6e570", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 431593, "creator": true, "nsfw_acceptable": false, "acceptable": false, "name": "レノン🌱", "screen_name": "Lennon_0533", "avatar_url": "https://pbs.twimg.com/profile_images/1949016811296661504/ct_X9sM-.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1318087483347750917/1754475276/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 14, "complete_expiration_days": 90, "skills": [{"genre": "art"}, {"genre": "comic"}], "banned": false, "nc": 48}, {"id": 731969, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "二土", "screen_name": "fudotuti", "avatar_url": "https://pbs.twimg.com/profile_images/1775749254684024832/EhCq4lrC.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1458324559493726209/1715996813/1500x500", "appeal_receivable": true, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 120, "skills": [{"genre": "art"}], "banned": false, "nc": 49}, {"id": 1218908, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "℃iel", "screen_name": "Ciel_sus", "avatar_url": "https://pbs.twimg.com/profile_images/8981213676