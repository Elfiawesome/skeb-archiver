3fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=719a3773958b03aeeeb3b1b65024a506, https://si.imgix.net/861d3fe5/uploads/origins/39cb78a3-1b10-43ed-bcc5-af856a21f15f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=9a9e295689850fa4b12a9b659d604c5b 2x, https://si.imgix.net/861d3fe5/uploads/origins/39cb78a3-1b10-43ed-bcc5-af856a21f15f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=507b2a2251ff9a26a602b9d3078ae5dd 3x"}, "body": "名塚小早太様、初めまして！\nアピールしていただいた触角と申します！\nこの度は拙作に触れていただきありがとうございました…！名塚様の作品をいくつか拝見し、是非とも名塚様が書く『Author』の世界観を読んでみたいと感じたため、リクエストを送らせていたただきます…！\n\n始めに断っておきますが、この本文も資料も中々の量です。全てを遵守してほしいとは申しませんので、検討だけでもしていただければ幸いです。\n\n\n◆概要\nハイファンタジーです。魔導具と呼ばれる道具さえあれば、自らの魔力を用いて誰でも魔法が使える世界です。国々が存在していますが、全面的には唯一神・天人様と彼に従う教会の天使たちによって、平和的に統治されています。\nオーサー一行は旅人として、巡礼の果てにあるとされる理想郷・最果ての地を目指しています。\n\n\n◆内容\nお任せします。モブを見繕っていただいても構いません。ただ、主役はオーサー一行もしくは一行の中の誰かにしていただけると嬉しいです。\nシチュエーションも問いませんので、日常でもホラーでもお好きなようにしていただければ…！\n\n\n◆キャラクター\nオーサー一行の概要です。一行への加入順となっています。詳細は「資料」の項にある添付資料をご確認ください。\n\n【オーサー】\n無性(元女性)、1466歳。\n堕天した元第8の大天使。凶悪犯罪の罰として何ものにも認識されなくなったが、一行の4人はその例外。4人が何よりも大切。自己中で大袈裟だが、何だかんだ頼りになる魔法の大天才。「普通」になりたがっている。美人。\n人称「俺」「お前たち」「あいつら、彼ら、彼女たち」\n「一応言っておくが、俺は今来たばかりだぞ」「わかったよ話題を変えれば良いんだろ！」\n\n【アデレン】\n男性、23歳。\n元はクラーク王族だったが、オーサーと出会い、その身分をなかったことにして旅人をしている。一行最古参。オーサーが何よりも大切。面倒見の良い秀才だが短気で、キレるとすぐに足が出る。火にトラウマがある。\n人称「俺」「お前ら」「あいつら」\n「おい、信じてねえな？」「ま、俺もそれには同感だぜ」\n\n【ジャックス】\n男性、21歳。\n地元の村が新興宗教に乗っ取られそうになっていたところをオーサーに助けられた。魔法を使えないものの槍術に長けている。ふわふわ生きている楽天的なお調子者かつ皮肉屋だが、その実自己肯定感が低い。\n人称「僕」「○○(名前)」「あいつら、あの人たち」\n「言っとくけど僕は手加減してたからね！」「僕を何だと思ってたわけ？」\n\n【トゥーレ】\n女性、16歳。\n神格魔獣の父(故人)に育てられた。天使になろうと学業に励んでいたが、暴力事件の被害者になったことで自主退学した。女性、特によく知らない人が苦手。臆病で泣き虫だが、仲間意識は特に強い。動物と会話できる。\n人称「私」「○○さん」「あの方たち」\n「けけけ決してうるさいとかそういうわけじゃ……！！」「わぁ……！　ひんやりしてますね」\n\n【キュリオ】\n女性、26歳。\n魔楽団で指揮者をしていたが、演奏の際に黒魔術を行使した。オーサーの助力で脱獄を果たす。常に無表情で、歯に衣着せない物言いをする。掴みどころがなく、計り知れないポテンシャルをもっている。美人。\n人称「私」「お前たち」「彼ら、彼女ら」\n「いつまで黙っているつもりだ？」「私はどこで話しても構わないぞ？」\n\n人称につきましては、厳密に従う必要はありません。\n\n(サンプルボイスは拙作から引用しています。もし口調を忠実に再現したいのであれば、以下から当該作品を閲覧できます。不要であれば無視してください)\nhttps://www.pixiv.net/novel/show.php?id=25127088\n\n\n◆用語\nわかりづらい以下2つのみここで特記しておきます。\n・魔導具：魔法を行使する際に必須である道具。\n・魔具：魔法のかけられた道具。(※添付資料内では「魔道具」と表記されていますが、誤りです)\n\n\n◆注意していただきたい点\n・全年齢対象でお願いします。\n・匂わせ程度であれば許容できますが、メタ的な描写はなるべく避けていただきたいです。\n・オーサーの体質上、彼と一行以外を会話させる際は一行の誰かに仲介させてください。\n・アデレンに火魔法を使わせないでください。理由もなく一行の誰かが彼の前で火を扱うこともあまり好ましくありません。火が必要な場合は、代わりとして光魔法を用いていただきたいです。(例：焚き火の代わりに光魔法による照明)\n\n\n◆資料\n下記にて『Author』の概要、世界観、魔法、キャラクター、地理情報、年表についての資料を添付してあります(更新日順にすると整頓されるかと……)。量が量なので、全てにくまなく目を通す必要はありません。ただ、世界観とキャラクターの項にはお目通しいただけると幸いです。\n不明な点は好きに捏造していただいて構いません。\n\n(※キャラクターの個別の資料に関しましては、世界観上6進法が現代の数法のため、主に6進法が用いられています。10進法での各々の年齢は先述の概要から参照していただければと思います。\n10進法の方がわかりやすいかと思いますので、執筆の際は無理に6進数を用いずとも全く問題ありません…！)\n\n(※世界観資料1枚目にある[魔法法制定とその歴史]という表ですが、こちらは古い情報なので無視してください)\n(※先述の通り、「魔道具」という単語は誤りです。正しくは「魔具」となります)\n\nhttps://drive.google.com/drive/folders/1ONw63hH12FJGALwwtkF-K7DEHDDz11zS\n\n\n◆使用用途\n個人鑑賞\n(加えて、一部を抜粋したり絵に描き起こすなどして個人SNSに掲載する可能性、シチュエーションの逆輸入をする可能性があります。後者につきましては、丸々拙作の中に取り入れることはせず、軽い回想や「こんなことがあった」と話す程度に留まらせます)\n\n\n大変長くなってしまいましたが、最後までお目通しいただきありがとうございました…！\n設定や要望を何がなんでも厳守してほしいというわけではありませんので、執筆してくださるのであれば、名塚様の足枷にならないよう適宜調整していただければと思います。\nお手数をおかけしてしまいますが、何卒よろしくお願いいたします…！", "nc": 136, "word_count": 5688, "transcoder": "text", "creator_acceptable_same_genre": true}, {"path": "/@_wwww_ww_/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3272002, "client_id": 3272003, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/db9ac876/uploads/origins/aeee9c19-9d4c-4a0a-8be2-3a491870aa75?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8e020be64fef5f5ad902270413620e6e", "srcset": "https://si.imgix.net/db9ac876/uploads/origins/aeee9c19-9d4c-4a0a-8be2-3a491870aa75?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8e020be64fef5f5ad902270413620e6e, https://si.imgix.net/db9ac876/uploads/origins/aeee9c19-9d4c-4a0a-8be2-3a491870aa75?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=575e839b0c61a98d5b8026850d174310 2x, https://si.imgix.net/db9ac876/uploads/origins/aeee9c19-9d4c-4a0a-8be2-3a491870aa75?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=709e64758e2ae4b46115bd5b89e0ef76 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/db9ac876/uploads/origins/aeee9c19-9d4c-4a0a-8be2-3a491870aa75?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=bc2ff01bbdfa4b70566cb5df2248181e", "srcset": "https://si.imgix.net/db9ac876/uploads/origins/aeee9c19-9d4c-4a0a-8be2-3a491870aa75?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=bc2ff01bbdfa4b70566cb5df2248181e, https://si.imgix.net/db9ac876/uploads/origins/aeee9c19-9d4c-4a0a-8be2-3a491870aa75?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=ccf1141df0ed57f6a2c235f9717c43cd 2x, https://si.imgix.net/db9ac876/uploads/origins/aeee9c19-9d4c-4a0a-8be2-3a491870aa75?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=257ca89a678200bf287d9114fba34b73 3x"}, "body": "こんにちは！\n雑草さんの描かれる、ステンドグラスのように輝いているのに絵画のように滑らかなイラストが本当に大好きで、今回リクエストを送らせていただきました！\n\n描いていただきたいのは、ocのニケです！\nとにかくかっこいい感じで、思わずついていきたくなるような印象をお願いしたいです。その他(構図や背景など)はお任せします。\n\n(キャラクターの詳細です)\n神に次ぐ尊い位である大天使でありながら、神をも凌ぐほどの魔法を扱える大天才です。\n自信家で口調が荒く粗暴な行動も多い反面、根は真面目で人間の善性を信じており、それに従って生きています。強いカリスマ性と数々の偉業で、人々からの支持は絶大です。\n\n(他にも参考になりそうな要素をいくつか挙げておきます)\n・魔法を司っている\n・あらゆる魔法が使えるが火魔法、光魔法が特に得意\n・太陽の化身として見られる\n\n(使用用途：個人鑑賞、壁紙・プロフィール画像への設定)\n\n長くなってしまいましたが、何卒よろしくお願いします……！\n\nhttps://drive.google.com/file/d/14pNnpIZqVP49bgbbx6iH8sgkcxU4ruMq/view?usp=drivesdk", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@chocolate__Sn/works/50", "private_thumbnail_image_urls": 