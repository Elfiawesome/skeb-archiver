の毛はほとんどが黒で、ごく一部が大きく赤い色をしており、本人は自然発生したものだと説明しているが、真偽を保証するのは難しい。\n好きな食べ物はふわふわの肉松パン。\n現在の職業は編集者で、普段はお金を稼ぐためにちょっとしたものを書いているが、作家や作家予備軍を名乗るつもりはない。\n口を開かなければその顔で女好きな顔だけど、口を開くと残念系男子のになるだけだ。\n\n以下の服、自由で選んでオーケー。他のはあなた好きなままに。女性の方は貧乳です。\nもし金額は少なら、調整してお願いします。\n\n公式服：https://imgur.com/a/WvROHmn\n大正：https://imgur.com/a/U1PHAA2\n地雷系：https://imgur.com/a/drgNByE", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@krkr_9Nosee_/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3353091, "client_id": 2959888, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/54386479/uploads/origins/33db75f9-3086-4fee-9111-198a2dbbaa5b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=05f72f6d501d215901583281ba48884c", "srcset": "https://si.imgix.net/54386479/uploads/origins/33db75f9-3086-4fee-9111-198a2dbbaa5b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=05f72f6d501d215901583281ba48884c, https://si.imgix.net/54386479/uploads/origins/33db75f9-3086-4fee-9111-198a2dbbaa5b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=67de4616b9818ee31bb94f1fbe55425d 2x, https://si.imgix.net/54386479/uploads/origins/33db75f9-3086-4fee-9111-198a2dbbaa5b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=de227968fd85aed4df18240d42c319cd 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/54386479/uploads/origins/33db75f9-3086-4fee-9111-198a2dbbaa5b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f178b43c6dcad13b456dc5e667e6fba2", "srcset": "https://si.imgix.net/54386479/uploads/origins/33db75f9-3086-4fee-9111-198a2dbbaa5b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f178b43c6dcad13b456dc5e667e6fba2, https://si.imgix.net/54386479/uploads/origins