/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3538537, "client_id": 1960223, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/ce44b674/uploads/origins/a96d2bee-dfa9-45bc-8c14-9860114d20d6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1b37a1aceedeefe1347f3ff98e5a6dad", "srcset": "https://si.imgix.net/ce44b674/uploads/origins/a96d2bee-dfa9-45bc-8c14-9860114d20d6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1b37a1aceedeefe1347f3ff98e5a6dad, https://si.imgix.net/ce44b674/uploads/origins/a96d2bee-dfa9-45bc-8c14-9860114d20d6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c164b9b97c365414cce2d2665257b1db 2x, https://si.imgix.net/ce44b674/uploads/origins/a96d2bee-dfa9-45bc-8c14-9860114d20d6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=0e93ab5387cef3aeab9983293b48e35a 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/ce44b674/uploads/origins/a96d2bee-dfa9-45bc-8c14-9860114d20d6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f5d7b47fdbd2b278ad8458d03d817689", "srcset": "https://si.imgix.net/ce44b674/uploads/origins/a96d2bee-dfa9-45bc-8c14-9860114d20d6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f5d7b47fdbd2b278ad8458d03d817689, https://si.imgix.net/ce44b674/uploads/origins/a96d2bee-dfa9-45bc-8c14-9860114d20d6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=3d096c9593b22447eaa1a4e9d544a5be 2x, https://si.imgix.net/ce44b674/uploads/origins/a96d2bee-dfa9-45bc-8c14-9860114d20d6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=c420db29d8e7b04ad1f157d62b8548fb 3x"}, "body": "初めまして、そばぼーろさん。\nFGOでご依頼を掛けられそうな方を探してた所、そばぼーろさんのことを見つけさせて頂きました。\nもしろよろしければFGOから、「清少納言ちゃん」に「セミラミスの最終再臨の衣装をコスプレ」をさせたイラストをお願いできるでしょうか……！？\n\n個人的にハマってしまった謎の組み合わせのため、ご理解に苦しむ組み合わせとは百も承知ですが、そばぼーろさんがFGOに精通していることや、明るく可愛らしい絵柄がなぎこちゃんに合うと思いましたことから、自分が描いて欲しいお題の中から、このお題をお願いさせて頂きたい所存です。\nそばぼーろさんの推してるキャラたちとはかけ離れてしまい大変恐縮ですが、この個人的な願望を叶えて頂ければ幸いです……！\n\nコスプレがメインとなりますので、なるべく衣装姿を拝める全身絵で描いてくだされば非常にありがたいです。それ以外の表情や構図・ポーズなどについても、そばぼーろさんのセンスをそのまま光らせて頂ければOKです。\nまた、清少納言ちゃんの髪は第一再臨のもの（青・赤・黒のマーブルのやつ）を希望いたしますが、もっとセンスを光らせる直感が下りてくださったのなら、その限りではなくてもOKです。\n\n細かいディティールにつきましては、フィギュアの写真にてご確認いただければと存じます。\nhttps://www.goodsmile.info/ja/product/10713/%E3%82%A2%E3%82%B5%E3%82%B7%E3%83%B3+%E3%82%BB%E3%83%9F%E3%83%A9%E3%83%9F%E3%82%B9.html\n\n色んな意味で相当難易度が高いお題とは存じますが、それでもそばぼーろさんの明るく可愛さの溢れる絵柄を期待して、お願いさせて頂ければ嬉しいです……！\n\nhttps://www.pixiv.net/artworks/88419852", "nc": 152, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@umeboshi_disk/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3538537, "client_id": 2483628, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/9ae58e5e/uploads/origins/d6cc9772-262c-4c13-bd54-c37c040e0ad4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b906fe41a62a7cf1d4de98aa186a5c06", "srcset": "https://si.imgix.net/9ae58e5e/uploads/origins/d6cc9772-262c-4c13-bd54-c37c040e0ad4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b906fe41a62a7cf1d4de98aa186a5c06, https://si.imgix.net/9ae58e5e/uploads/origins/d6cc9772-262c-4c13-bd54-c37c040e0ad4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e91e8760bab9a5570be608054d9ab47c 2x, https://si.imgix.net/9ae58e5e/uploads/origins/d6cc9772-262c-4c13-bd54-c37c040e0ad4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=8a5d372aec59397742f42f05d2f743a4 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/9ae58e5e/uploads/origins/d6cc9772-262c-4