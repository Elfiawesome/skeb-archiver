髪男)とゆき(白髪女)の2人をお願いします。\n資料は下記リンクを参照してください。\n\nhttps://www.dropbox.com/sh/jejdgkz5w0054mt/AADLjVZ4hnTG7aTD-9zoGE6Wa?dl=0\n\n描写範囲は資料に写っている範囲内で、服装は資料のままでも、お好きにアレンジして頂いても構いません。\n\nポーズはお任せしたいのですが、2人の距離感が近いと嬉しいです…！\n\n■背景\n特に指定は無いので、お任せします。\n白背景か、単色の背景などでも構いません。\n\n\n■使用用途/サイズ\niPhoneXの壁紙に使用させて頂きたいので、\nポストカード～A5サイズの縦長でお願いします。\n\nお忙しいと思いますが、よろしくお願い致します。\n\nhttps://www.dropbox.com/sh/jejdgkz5w0054mt/AADLjVZ4hnTG7aTD-9zoGE6Wa?dl=0", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@garan_co/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 871494, "client_id": 57309, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/1cccb1e0/uploads/origins/33bc4279-cc0b-44a9-ad4c-32772856cff2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c9959aed1205311bc64ca6455af14f05", "srcset": "https://si.imgix.net/1cccb1e0/uploads/origins/33bc4279-cc0b-44a9-ad4c-32772856cff2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c9959aed1205311bc64ca6455af14f05, https://si.imgix.net/1cccb1e0/uploads/origins/33bc4279-cc0b-44a9-ad4c-32772856cff2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=652ec977adb90dc9712cf1ba2a45ddaa 2x, https://si.imgix.net/1cccb1e0/uploads/origins/33bc4279-cc0b-44a9-ad4c-32772856cff2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=cdb2e13ef926dfc990871abe2e418bc4 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/1cccb1e0/uploads/origins/33bc4279-cc0b-44a9-ad4c-32772856cff2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=8bb1f2a4e9b0719f87c8359d70aa374f", "srcset": "https://si.imgix.net/1cccb1e0/uploads/origins/33bc4279-cc0b-44a9-ad4c-32772856cff2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=8bb1f2a