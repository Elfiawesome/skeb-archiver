」（泣）\n↓\nシーン5\nいもみちゃんが励ます\n「ふふふ、そうだね。｣\n\n－－－－－－－－－－－－－\n\nもし可能であれば、文字や吹き出しが無いイラストも頂けると幸いです…！\n色々工数とかもかかると思うので、簡易化できる所は簡易化して描いて頂けると幸いです🙇‍♀️\n\nご多忙の中だと思いますので、\nスケジュール等ご無理のない範囲でご検討頂けますと幸いです…！\n\nよろしくお願いします🙇‍♀️\n\n▼土台のモデル:土野おいも＆いもみ▼ \n･ https://lit.link/tuchinooimo  \n･ https://drive.google.com/drive/folders/1IlH-b-rOh9lc3NFTx9fJFGx-kDWf34IF", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@g1qY26VDDI/works/9", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3607719, "client_id": 586774, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/df5dc3cd/uploads/origins/c20cfbff-3a8f-4a60-bfc1-b73826e52de3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8f05d16051f916ee12f3da3b6e4f7c00", "srcset": "https://si.imgix.net/df5dc3cd/uploads/origins/c20cfbff-3a8f-4a60-bfc1-b73826e52de3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8f05d16051f916ee12f3da3b6e4f7c00, https://si.imgix.net/df5dc3cd/uploads/origins/c20cfbff-3a8f-4a60-bfc1-b73826e52de3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c03fbb90e6bd286873c0544452a6815c 2x, https://si.imgix.net/df5dc3cd/uploads/origins/c20cfbff-3a8f-4a60-bfc1-b73826e52de3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=7bb7a21526c9e82002769816e936d427 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/df5dc3cd/uploads/origins/c20cfbff-3a8f-4a60-bfc1-b73826e52de3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=1bb3279bca64431239419176be74c0e8", "srcset": "https://si.imgix.net/df5dc3cd/uploads/origins/c20cfbff-3a8f-4a60-bfc1-b73826e52de3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=1bb3279bca64431239419176be74c0e8, https://si.imgix.net/df5dc3cd/uploads/origins/c20cfbff-3a