&w=200&h=200&s=cc87a0d025104c81e93afde8cd42e499", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/b6ebe275/uploads/origins/364060ad-3f13-4e89-8156-9ae289b89f2c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ff0a58cedb2562821608d7a50517daec", "src_set": ""}, "body": "こんにちは！お世話になっております。\n前から諸星さんに依頼したい…！と思っていたのでリクエストさせていただきます！\n\n依頼したいのはCoCシナリオである「Vll・peccata」を通過した2人です。\nまた、絵の構図、雰囲気等はお任せになってしまうのですが、お好きな雰囲気で描いて頂ければと思います。\n\n可能でしたらよろしくお願いします！\n\n【キャラクター詳細】\n1人目\n名前：神々廻千隼\n性別：男(普段は非公開)\n身長：178(+7cmヒール)\n性格：高慢、横暴\nAPP：18\n職業：探偵\nモチーフ：天使、蝶\n基本上から目線でクソデカ態度の人当たり終わりな探偵。助手にはデレデレ。この間助手と結婚した。\n助手には何かあるとキスをしたり頭を撫でたりなどのスキンシップが多い。\n\n2人目\n名前：黒鉄一真\n性別：男\n身長：184\n性格：控えめ、嫉妬深い\nAPP：6\n職業：探偵助手、大学生\nモチーフ：蛇\n探偵のことを先生と呼び慕っている。人当たり最悪な探偵に代わり依頼人への対応などを行なっている。\n基本探偵に甘く、家では家事担当。辛いものが好き。\n\nhttps://drive.google.com/drive/folders/1-ZuDlfXsJtRX736PCf_tW9lOaeqaa0Q6", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@morohosi_trpg/works/7", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/cb881cc6/uploads/origins/c7ae3e73-eb72-49e7-9772-af168dd788a1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=b464f49f58b80c445f62021d3aa8bfc3", "src_set": ""}, "private": true, "genre": "art", "tipped": false, "creator_id": 2319729, "client_id": 0, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 17, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@morohosi_trpg/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2319729, "client_id": 2451706, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/907d537f/uploads/origins/c7d8dd70-c82d-43db-a4ef-1aa9300548a4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b89c05a3c738072f520d4076806e0ca8", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/907d537f/uploads/origins/c7d8dd70-c82d-43db-a4ef-1aa9300548a4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ad544d16f207005a79e5a8aded003fe2", "src_set": ""}, "body": "こんにちは！お世話になっております。絵柄が大好きです！よければ、わたしのキャラクターを描いて頂けないでしょうか？\n\nアルカナの塔をモチーフにしたキャラクター\n\n冷静で真面目な男\n高身長（178cm）\nおおきなポニーテールとアホ毛とインテーク、ジト目気味でハイライトのないオッドアイが特徴\n持っている杖で魔法を使ったり、敵を殴打する\n実家がパン屋でパンを作る事が得意\n表情は少なめです！\n\nご検討、よろしくお願いします！\n\nhttps://drive.google.com/drive/folders/13h8f-Ea6mhy-wtXMa3Inkotna5Ia_TRf", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@morohosi_trpg/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2319729, "client_id": 2757396, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/c4c5339e/uploads/origins/2873bd9e-c608-4d44-ad01-bd7c483625d0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a3dc9f7b491afafdb3aa36dd8090c03f", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/c4c5339e/uploads/origins/2873bd9e-c608-4d44-ad01-bd7c483625d0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=686013fde1fc100c7eb8588edf208553", "src_set": ""}, "body": "絵柄がとても大好きなのでcocで使用している私のキャラを描いていただければと思い、リクエストを送らせていただきました。\n\n\n資料が2枚あるのですが、パーカーの方でもスーツの方でも構いません。どちらか描いていただければと思います。\n構図や表情なのですが、このキャラが芸人としての仕事中とプライベートとでキャラ変のようなことを行うため、\nパーカーの方→大人しめの表情(微笑むなど)、動きもやや小さめ\nスーツの方→元気な表情(にぱっとした満面の笑みなど)\nといった感じでお願いしたいです。詳細はおまかせしますので、描きやすいように描いていただければと思います。\n装飾などは省略していただいて構いません。髪や目の色が同じであれば髪型や服装なども描きやすいように変えていただいて大丈夫です。\n\nこちらのリクエストはお時間あればで構いませんので…！\n\nhttps://drive.google.com/drive/folders/1ELlbvsheLSB15DToWCzMlcq2YQUkrHzU", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@morohosi_trpg/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2319729, "client_id": 925451, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/4901a9a9/uploads/origins/b5c79ab6-d872-4e01-9d66-13790e8f1bec?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d119ff40d7a4a973fa8d1f078b9b851a", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/4901a9a9/uploads/origins/b5c79ab6-d872-4e01-9d66-13790e8f1bec?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=fd0f66099ddd7a29a310caadb6f98e60", "src_set": ""}, "body": "ぽち🥫さま\nいつもありがとうございます！\nよければまた私のキャラクターを描いて頂けないでしょうか？\n\n成人男性で、いつも優しい神父です！！\nご検討、よろしくお願いします！！！\n\nhttps://drive.google.com/drive/folders/1qz7HelENYyBo8ChSCW5vIeZlz3fdH_Hj", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@morohosi_trpg/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2319729, "client_id": 2437495, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/6819504c/uploads/origins/0044d7ea-7c0e-4b78-a56a-f51095d3495c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=62deb9291ca2082c322d10bbf1092438", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/6819504c/uploads/origins/0044d7ea-7c0e-4b78-a56a-f51095d3495c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=33e2f8620b5e860a86556ef05dcfafdf", "src_set": ""}, "body": "もろほし様はじめまして。\n黒瀬さとと申します。\n絵柄がすごく好みだったためリクエストさせていただきました。\nご検討宜しくお願い致します。\n\n◇依頼内容\nオリジナルキャラクターの全身イラスト\n\n◇キャラクターの設定\n可愛めの中性的な女の子のため胸などはあまりいりません。\n\n服などの詳しい詳細は資料URLに張らせて頂きます。\n\n◇使用用途\nTwitter等のSNSアイコン・広報\nYouTubeやツイキャス配信サイトでのサムネイル\n\n◇構図\nもろほし様に全てお任せ致します。\n\n◇その他\nPNG形式のファイルで送って頂きたいです。\n配信サムネイルでの使用もあるため、透過差分等も頂けると幸いです。\n\n\nSkeb依頼が初めてのため文面での失礼がありましたら申し訳ございません。\nご縁がありましたらよろしくお願いいたします。\n\nhttps://sites.google.com/view/kurosesato/%E3%83%9B%E3%83%BC%E3%83%A0", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@morohosi_trpg/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2319729, "client_id": 2031432, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/2fd2d563/uploads/origins/6e3ed829-4aa3-4f41-b3be-aebe54bcc8c7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=83f1d17aedd00c898543da4f48e61b70", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/2fd2d563/uploads/origins/6e3ed829-4aa3-4f41-b3be-aebe54bcc8c7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9204b3c96388a63e5858bdfc01ce07c2", "src_set": ""}, "body": "こんにちはこんにちは!skebを見ていて、あなたの作品に出会いました!私は本当にその外観が好きで、それは私が興味をそそられました!私のモデルを描くことが可能かどうか疑問に思っていました。\n\n私はペルソナやシャドウの力を操る猫又妖怪です。ベルベットアシスタントのエリザベス、マーガレット、テオドール、ラヴェンツァの兄弟で、ベルベットアシスタントのジュニアです。普段はとても気さくでのんびりしているのですが、会話や戦闘の時には、とても見下したような、生意気な、少し悪人らしい態度をとることがあります。\n\n髪は白で、前髪の左側だけが黒です。また、とても乱れた髪型で、とても長いです。たまにポニーテールにするのが好きなので、好きな人はそうしてください。\n\n左目は鮮やかな紫、右目は明るい黄色です。どちらも光らせることができます。\n\n参考フォルダには、私の衣装もあります参考になれば幸いです\n\nありがとうございました!!!\n\n参考資料です。\nhttps://drive.google.com/drive/folders/1mJWxD2A-METuaaD-mKCP0KAl-lUGKjlY?usp=sharing", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@morohosi_trpg/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2319729, "client_id": 925451, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/ad708485/uploads/origins/b7150671-9e03-4217-a9a9-90491b9a054b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f3e1bc038b51135aafc6d0ee684dc5d9", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/ad708485/uploads/origins/b7150671-9e03-4217-a9a9-90491b9a054b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2c6f9d57c48ab44f64dec199a26af248", "src_set": ""}, "body": "こんにちは！先日はありがとうございました。頂いたイラスト、大切にしております……………！！！！！絵柄がとても好きです。\nもしよければ、また私のオリジナルキャラクターを描いて頂けないでしょうか？\n\nイラスト1枚と、デフォルメイラストも頂けると嬉しいです。\n\n赤髪青インナーカラー、黒のリボンをつけた男の子です。\nヘアアレンジが好きで、ツーサイドアップ、ポニーテールやハーフアップにしている日もあります。髪型は思いつくものを自由に描いて頂きたいです。\n服は髪の毛を引き立てるように黒いものを選んでいます、かわいい感じの服も着ます。資料にあるものや、思いついたものを描いてください。\n\n人には素っ気ない感じに接します。\nジト目や、むっとした表情をしたり、腕を組んでツン、としてる事が多いです。\nデザインの仕事をしていて、普段はカフェに通ってノートパソコンで作業をしているような人です。\n\n\n赤い上に青いです…難しければ断って頂いて問題ございません。\n\nよろしくお願いします！\n\nhttps://drive.google.com/drive/folders/1GY0hCWnGCg3vD2EU8DLdkx9FUvvm7owv", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "similar_creators": [{"id": 1088177, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "睡眠先生", "screen_name": "inemuri_teacher", "avatar_url": "https://pbs.twimg.com/profile_images/1964203483097346048/yPpRKN8n.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1088550485374554112/1750869790/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "skills": [{"genre": "art"}], "nc": 129}, {"id": 1511079, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "古津ふる", "screen_name": "fruit_fulful", "avatar_url": "https://pbs.twimg.com/profile_images/1931426902604193792/2aME8nn5.jpg", "header_url": "https