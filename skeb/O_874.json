: ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/dcb486be/uploads/origins/595a34e6-a5aa-45c2-8395-1379e2f57f11?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=108e21a5a69776428d3a6a47d16902e3", "src_set": ""}, "body": "こんにちは！数日前、あなたのページであなたの絵を見つけました！また、私の青い猫を描いてくれたら嬉しいです😺💙。\n\n彼は電子音楽を作っている猫で（黄色いヘッドホンを描いてもいいです、任意です🎧）、普段は水中に住んでいます🫧。猫のポーズは自由です！\n\n背景は何でも構いません、シンプルでも構いません（真っ白でなければ） 🙂‍↕️\n\nありがとうございました！\n\nhttps://drive.google.com/drive/folders/1VF7WItKctSQAQ_qEcdiDZ7LmXuMqCQEg", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "similar_creators": [{"id": 4021, "creator": true, "nsfw_acceptable": false, "acceptable": false, "name": "宇月まいと ■ Bluesky", "screen_name": "zenimakitchen", "avatar_url": "https://pbs.twimg.com/profile_images/1591958161912741888/qBWs-Hu3.png", "header_url": "https://pbs.twimg.com/profile_banners/518156245/1590907252/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "skills": [{"genre": "art"}], "nc": 176}, {"id": 865871, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "仮量産@紙の本通販有", "screen_name": "robo_mane", "avatar_url": "https://pbs.twimg.com/profile_images/1487371605412294659/iP5GoSo6.jpg", "header_url": "https://pbs.twimg.com/profile_banners/952580101580800000/1738670888/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "skills": [{"genre": "art"}, {"genre": "comic"}], "nc": 16}, {"id": 1169672, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "依命-ｲﾒｲ-", "screen_name": "basue0327", "avatar_url": "https://pbs.twimg.com/profile_images/1918901408100