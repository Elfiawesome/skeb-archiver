2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=0db6bffa9e7a234ea78c32d15a8de4d1 2x, https://si.imgix.net/e6933916/uploads/origins/a8814e35-d43a-44fa-8bca-ba09257fe44d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=4f1a945279307e4281cf08ac843ae841 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/e6933916/uploads/origins/a8814e35-d43a-44fa-8bca-ba09257fe44d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=90c5265420a02d14b078df3de52860f1", "srcset": "https://si.imgix.net/e6933916/uploads/origins/a8814e35-d43a-44fa-8bca-ba09257fe44d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=90c5265420a02d14b078df3de52860f1, https://si.imgix.net/e6933916/uploads/origins/a8814e35-d43a-44fa-8bca-ba09257fe44d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=d1cce5c8b8cdf2eba324e39d2755bd5b 2x, https://si.imgix.net/e6933916/uploads/origins/a8814e35-d43a-44fa-8bca-ba09257fe44d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=7744b22c0b4f82b694f5a08795fa3bbf 3x"}, "body": "粗越し粗茶様、リクエスト失礼します。\nXにて募集ツイートを拝見し、首無しお姉さんの表現と雰囲気に惹かれてご依頼に至りました。\n\nお題は「ロングヘアのデュラハンの女の子」という内容です。\n以下詳細を記しておりますので、内容ご確認の上でご検討・ご対応頂ければ幸いです。\n色んなクリエイターの方の発想力・想像力・創作力にお任せしたいので、詳細文のほとんどは他の方と同じ内容になっております。その点ご容赦くださいませ。\nニッチな内容となっておりますので、ご都合が悪い等の理由がありましたら遠慮なくキャンセルしてください。\n\n【詳細】\n・髪の長さは頭３つ分かそれ以上の長さが好ましいです。綺麗で長い髪を表現して頂きたいためご負担がかかると思いますが宜しくお願いします。\n\n・ヘアアレンジに関しては、お団子やシニヨンなどの長さが分かりにくくなるまとめ髪系は避けてください。\n　髪の長さが分かる状態であれば、一部分や全体を結ぶ・巻く・編み込むなどのアレンジはOKです。\n\n・服装に関してはキャラに合った衣装をお好みでお願いします。\n\n・首の表現に関しては\n　①肌色で塗る\n　②タートルネックのような首元が隠れる・襟のある服装で見えなくする\n　③アクセサリーやチョーカー等による着飾りで隠す\n　などの方法を用いたマイルドな表現をお願いします。別アイデアでも構いません。\n　ただし、性的表現や猟奇的表現・「首から炎や煙が出ている」という表現は避けてください。\n\n・分離した頭や首の扱い・構図・ポーズについて\n　過去に私がリクエストして描いて頂いた作品やSkebの該当キーワードの検索のURLを記載するので、そちらを参考にして頂くか、「こういうのもアリでは…？」と思えばそちらでも構いません。お好みで決めてください。\n　首部分に関しては頭側と体側に半々に分かれるように描かれていると嬉しいです。\n\n・可能であれば書いて頂いた際の没ラフや、創作時のコンセプト等を書いて頂けると嬉しいです！\n　表情やポーズなどの差分に関してはあればあるほど嬉しいですが、その分負担になると思いますのでご判断お任せします。\n\n・納品はPSDでお願いします。\n　差分などはファイル内に同梱して頂けると幸いです。\n\n・ご不明点等があった際はお好みで判断して描いて下さい。\n\n長文になりましたが、内容以上になります。ご検討くださいませ。\n\nhttps://skeb.jp/search?q=%22%E3%83%87%E3%83%A5%E3%83%A9%E3%83%8F%E3%83%B3%22&t=works&menu=1&artwork=1", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Asatukisocha/works/13", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2562821, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/d3178740/uploads/origins/ef681a2a-2ffc-4b2a-a64b-15595f609505?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7c0aa1e63dd03e57e3b1294706204d8f", "srcset": "https://si.imgix.net/d3178740/uploads/origins/ef681a2a-2ffc-4b2a-a64b-15595f609505?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7c0aa1e63dd03e57e3b1294706204d8f, https://si.imgix.net/d3178740/uploads/origins/ef681a2a-2ffc-4b2a-a64b-15595f609505?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=929cde21b9b3e078c1b79a557165f7c7 2x, https://si.imgix.net/d3178740/uploads/origins/ef681a2a-2ffc-4b2a-a64b-15595f609505?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=46c54a2af962f1373188c35a75968f3a 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/d3178740/uploads/origins/ef681a2a-2ffc-4b2a-a64b-15595f609505?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0c75ca5165b1ce4be745392c5faf57d0", "srcset": "https://si.imgix.net/d3178740/uploads/origins/ef681a2a-2ffc-4b2a-a64b-15595f609505?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0c75ca5165b1ce4be745392c5faf57d0, https://si.imgix.net/d3178740/uploads/origins/ef681a2a-