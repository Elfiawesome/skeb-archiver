ました！\n\n文章化するのが苦手なので箇条書きで書いていきます\n・背景は前回の様な暗い森の中\n・正面の正常位でモブ魔法使いがうちの子(アンヘルと言います)の腰を両手で掴んでる\n・うちの子の上着は捲られて勃起した乳首が見えてる\n・結合部から精液が溢れ出てる\n・うちの子の両腕はだらんと地面に置いている\n・表情は筋肉膨張叔父さんにお任せします！(エッチ度マシマシで)\n・うちの子の眼鏡は耳から少しズレている\n※前回の断面図がとてもエッチだったので、余裕があれば入れて下さい！(可能であれば中で陰経と精液が絡んでるのを！)\n\n以上になります！\n\n前回と同じ資料のURLを載せてます\n難しい内容かもしれませんが、ご検討よろしくお願いします！\n\nhttps://drive.google.com/drive/folders/1as7mbo7WY_db_FmhrhsDUpNWxPW2hEt5", "nc": 160, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@Sf2Fg3/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2691400, "client_id": 601604, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/7e39899e/uploads/origins/3d488b4b-944d-427d-ade6-fd40f899aa09?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d12647e30323cffba24e79c890eff873", "srcset": "https://si.imgix.net/7e39899e/uploads/origins/3d488b4b-944d-427d-ade6-fd40f899aa09?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d12647e30323cffba24e79c890eff873, https://si.imgix.net/7e39899e/uploads/origins/3d488b4b-944d-427d-ade6-fd40f899aa09?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=35e1eb53380402261ccfa9d00928ec32 2x, https://si.imgix.net/7e39899e/uploads/origins/3d488b4b-944d-427d-ade6-fd40f899aa09?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=84d8a149f0f273e0ec7cdd3cf3a51c8b 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/7e39899e/uploads/origins/3d488b4b-944d-427d-ade6-fd40f899aa09?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=33149ee6daacf81f62d848042b9afbc1", "srcset": "https://si.imgix.net/7e39899e/uploads/origins/3d488b4b-944d-427d-ade6-fd40f899aa09?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=33149ee6daacf81f62d848042b9