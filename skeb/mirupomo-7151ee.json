7tNN_PE?si=v4rPv5h8A_AHgMkP", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 25360, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "よこえだったもの", "screen_name": "nn_yke", "avatar_url": "https://pbs.twimg.com/profile_images/1390921254014570498/EiRt1syf.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1319810368345010176/1641654844/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 120, "skills": [{"genre": "art"}, {"genre": "novel"}, {"genre": "correction"}], "banned": false, "nc": 33}, {"id": 444660, "creator": true, "nsfw_acceptable": false, "acceptable": false, "name": "兎鷺ぬい🎀ご依頼受付中", "screen_name": "u3g1n", "avatar_url": "https://pbs.twimg.com/profile_images/2084237088954974208/ws3WIYbw.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1218847864282963968/1785756021/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 120, "skills": [{"genre": "art"}], "banned": false, "nc": 145}, {"id": 745639, "creator": true, "nsfw_acceptable": false, "acceptable": false, "name": "🍙やまももぽんすけ🐁", "screen_name": "pnsk_yamamomo", "avatar_url": "https://pbs.twimg.com/profile_images/2063598578820640768/sXbtuDvh.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1533567853/1752246534/1500x500", "appeal_receivable": true, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "art"}], "banned": false, "nc": 128}, {"id": 2045509, "c