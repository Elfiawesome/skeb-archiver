er": "image", "creator_acceptable_same_genre": true}, {"path": "/@hobo_90do/works/18", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3676560, "client_id": 0, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/3af754fc/uploads/origins/755e1141-10f7-45bc-8281-7e87ea58059f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d3fca870657361a467d449e154f7a7cb", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/3af754fc/uploads/origins/755e1141-10f7-45bc-8281-7e87ea58059f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=cbd2a7394e7add51afba120a82d195a1", "src_set": ""}, "body": "ほぼ直角様のポストを拝見し、メディア欄のイラストがとても魅力的だったので\nリクエストをさせていただきました！\n個人Vtuberの「よわこ」さんのファンアートをお願い出来ないでしょうか。\n※第三者へのFA依頼は本人が許可をしております。\n\n資料は下記よりご確認いただけます。\nhttps://drive.google.com/drive/folders/1phNXG0kglVG7r80R0BXMJgHoLFoRoHIp\n\n衣装はドライブ内にある３面図の衣装にてお願い出来ればと思います。\nその他の構図等はおまかせいたします。\n\n使用用途はファンアートとして本人へ差し上げることですが\n本人がYouTubeの動画サムネイルやSNSの広報ポストに使用する場合もありますので\n可能であれば、背景透過済み人物のみのデータもいただけますとありがたいです。\n\nお忙しいところ恐れ入りますが、ご検討のほどよろしくお願いいたします。", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@hobo_90do/works/17", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3676560, "client_id": 3678253, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/4183b2f9/uploads/origins/3bedc939-5c9c-4eb0-abbf-797663dbc72d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f27acd8a8f076c0425f132fbcd5b1cc7", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/4183b2f9/uploads/origins/3bedc939-5c9c-4eb0-abbf-797663dbc72d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3345f91209